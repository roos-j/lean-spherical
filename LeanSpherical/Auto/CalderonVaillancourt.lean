            (Lp.memLp G).1 (sqMass_ne_top_of_memLp (Lp.memLp G))
      _ =ᵐ[μ]
          ((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp F)) : Lp ℂ 2 μ) : α → ℂ) +
          ((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp G)) : Lp ℂ 2 μ) : α → ℂ) :=
          ((MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp F))).symm.add
            (MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp G))).symm)
      _ =ᵐ[μ] (((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp F)) +
          MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp G)) : Lp ℂ 2 μ)) : α → ℂ) :=
          (Lp.coeFn_add _ _).symm
  map_smul' c F := by
    refine Lp.ext ?_
    have hc : ((c • F : Lp ℂ 2 μ) : α → ℂ) =ᵐ[μ] c • (F : α → ℂ) := Lp.coeFn_smul c F
    calc ((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp (c • F))) : Lp ℂ 2 μ) : α → ℂ)
        =ᵐ[μ] kernelApply μ K ((c • F : Lp ℂ 2 μ) : α → ℂ) :=
          MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp (c • F)))
      _ = kernelApply μ K (c • (F : α → ℂ)) := kernelApply_congr_ae K hc
      _ = c • kernelApply μ K (F : α → ℂ) := kernelApply_smul K c _
      _ =ᵐ[μ] c •
          ((MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp F)) : Lp ℂ 2 μ) : α → ℂ) :=
          (MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp F))).symm.const_smul c
      _ =ᵐ[μ] ((c • (MemLp.toLp _ (memLp_kernelApply_of_good hK (Lp.memLp F))) :
          Lp ℂ 2 μ) : α → ℂ) := (Lp.coeFn_smul c _).symm

theorem coeFn_goodLinearMap (hK : IsGoodKernel μ K) (F : Lp ℂ 2 μ) :
    ((goodLinearMap μ K hK F : Lp ℂ 2 μ) : α → ℂ) =ᵐ[μ] kernelApply μ K (F : α → ℂ) :=
  MemLp.coeFn_toLp (memLp_kernelApply_of_good hK (Lp.memLp F))

theorem norm_goodLinearMap_apply_le (hK : IsGoodKernel μ K) {C : ℝ≥0∞} (hC : C ≠ ⊤)
    (h₁ : ∀ x, ∫⁻ y, ‖K x y‖ₑ ∂μ ≤ C) (h₂ : ∀ y, ∫⁻ x, ‖K x y‖ₑ ∂μ ≤ C) (F : Lp ℂ 2 μ) :
    ‖goodLinearMap μ K hK F‖ ≤ C.toReal * ‖F‖ := by
  rw [Lp.norm_def, Lp.norm_def, eLpNorm_congr_ae (coeFn_goodLinearMap μ K hK F)]
  have hb := eLpNorm_kernelApply_le hK.meas h₁ h₂ (Lp.memLp F).1.aemeasurable
  have hfin : C * eLpNorm (F : α → ℂ) 2 μ ≠ ⊤ :=
    (ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hC) (Lp.memLp F).2).ne
  calc (eLpNorm (kernelApply μ K (F : α → ℂ)) 2 μ).toReal
      ≤ (C * eLpNorm (F : α → ℂ) 2 μ).toReal :=
        ENNReal.toReal_le_toReal (lt_of_le_of_lt hb (lt_top_iff_ne_top.mpr hfin)).ne hfin |>.mpr hb
    _ = C.toReal * (eLpNorm (F : α → ℂ) 2 μ).toReal := ENNReal.toReal_mul

/-- The `L²` operator attached to a good kernel. -/
def goodCLM (hK : IsGoodKernel μ K) : Lp ℂ 2 μ →L[ℂ] Lp ℂ 2 μ :=
  LinearMap.mkContinuousOfExistsBound (goodLinearMap μ K hK) (by
    obtain ⟨C, hC, h₁, h₂⟩ := hK.exists_schur
    exact ⟨C.toReal, norm_goodLinearMap_apply_le μ K hK hC h₁ h₂⟩)

@[simp] theorem goodCLM_apply (hK : IsGoodKernel μ K) (F : Lp ℂ 2 μ) :
    goodCLM μ K hK F = goodLinearMap μ K hK F := rfl

theorem coeFn_goodCLM (hK : IsGoodKernel μ K) (F : Lp ℂ 2 μ) :
    ((goodCLM μ K hK F : Lp ℂ 2 μ) : α → ℂ) =ᵐ[μ] kernelApply μ K (F : α → ℂ) :=
  coeFn_goodLinearMap μ K hK F

theorem norm_goodCLM_le (hK : IsGoodKernel μ K) {C : ℝ≥0∞} (hC : C ≠ ⊤)
    (h₁ : ∀ x, ∫⁻ y, ‖K x y‖ₑ ∂μ ≤ C) (h₂ : ∀ y, ∫⁻ x, ‖K x y‖ₑ ∂μ ≤ C) :
    ‖goodCLM μ K hK‖ ≤ C.toReal :=
  ContinuousLinearMap.opNorm_le_bound _ ENNReal.toReal_nonneg
    (norm_goodLinearMap_apply_le μ K hK hC h₁ h₂)

/-! ### Product integrability -/

/-- Cauchy--Schwarz bound for the `L¹` mass of an `L²` function over a finite-measure set. -/
theorem lintegral_indicator_enorm_le {μ : Measure α} {S : Set α} (hS : MeasurableSet S)
    {v : α → ℂ} (hv : AEMeasurable v μ) :
    (∫⁻ x, S.indicator (fun _ => (1 : ℝ≥0∞)) x * ‖v x‖ₑ ∂μ)
      ≤ (μ S) ^ (2⁻¹ : ℝ) * (sqMass μ v) ^ (2⁻¹ : ℝ) := by
  have hconj : Real.HolderConjugate 2 2 := by
    rw [Real.holderConjugate_iff]; norm_num
  have hmi : AEMeasurable (fun x => S.indicator (fun _ => (1 : ℝ≥0∞)) x) μ :=
    (measurable_const.indicator hS).aemeasurable
  have hh := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hconj hmi hv.enorm
  have hsq : ∀ x, (S.indicator (fun _ => (1 : ℝ≥0∞)) x) ^ (2 : ℝ)
      = S.indicator (fun _ => (1 : ℝ≥0∞)) x := by
    intro x
    by_cases hx : x ∈ S
    · simp [Set.indicator_of_mem hx]
    · simp [Set.indicator_of_notMem hx, ENNReal.zero_rpow_of_pos]
  simp only [Pi.mul_apply] at hh
  refine le_trans hh (le_of_eq ?_)
  congr 1
  · rw [show (∫⁻ x, (S.indicator (fun _ => (1 : ℝ≥0∞)) x) ^ (2 : ℝ) ∂μ) = μ S from by
      simp only [hsq]
      rw [lintegral_indicator_const hS, one_mul]]
    norm_num
  · rw [sqMass]
    norm_num

/-- The product-integrability estimate underlying the Fubini manipulations for good kernels. -/
theorem integrable_prod_of_good {μ : Measure α} [SFinite μ] {K : α → α → ℂ}
    (hK : IsGoodKernel μ K) {u v : α → ℂ}
    (hu : AEStronglyMeasurable u μ) (hv : AEStronglyMeasurable v μ)
    (hu2 : sqMass μ u ≠ ⊤) (hv2 : sqMass μ v ≠ ⊤)
    {g : α → α → ℂ} (hg : AEStronglyMeasurable (Function.uncurry g) (μ.prod μ))
    (hgle : ∀ x y, ‖g x y‖ₑ ≤ ‖K x y‖ₑ * ‖u y‖ₑ * ‖v x‖ₑ) :
    Integrable (Function.uncurry g) (μ.prod μ) := by
  obtain ⟨B, S, hB, hS, hSfin, hbdd, hsupp⟩ := hK.exists_data
  refine ⟨hg, ?_⟩
  have hfac : ∀ p : α × α, ‖(Function.uncurry g) p‖ₑ
      ≤ B * (S.indicator (fun _ => (1 : ℝ≥0∞)) p.1 * ‖v p.1‖ₑ) *
        (S.indicator (fun _ => (1 : ℝ≥0∞)) p.2 * ‖u p.2‖ₑ) := by
    intro p
    refine le_trans (hgle p.1 p.2) ?_
    by_cases hx : p.1 ∈ S
    · by_cases hy : p.2 ∈ S
      · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hy, one_mul, one_mul]
        calc ‖K p.1 p.2‖ₑ * ‖u p.2‖ₑ * ‖v p.1‖ₑ
            ≤ B * ‖u p.2‖ₑ * ‖v p.1‖ₑ :=
              mul_le_mul' (mul_le_mul' (hbdd p.1 p.2) (le_refl _)) (le_refl _)
          _ = B * ‖v p.1‖ₑ * ‖u p.2‖ₑ := by ring
      · have hz : K p.1 p.2 = 0 := by
          by_contra hne
          exact hy (hsupp p.1 p.2 hne).2
        simp [hz]
    · have hz : K p.1 p.2 = 0 := by
        by_contra hne
        exact hx (hsupp p.1 p.2 hne).1
      simp [hz]
  have hmv : AEMeasurable (fun x => S.indicator (fun _ => (1 : ℝ≥0∞)) x * ‖v x‖ₑ) μ :=
    ((measurable_const.indicator hS).aemeasurable).mul hv.aemeasurable.enorm
  have hmu : AEMeasurable (fun y => S.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖u y‖ₑ) μ :=
    ((measurable_const.indicator hS).aemeasurable).mul hu.aemeasurable.enorm
  have hsplit : (∫⁻ p : α × α, B *
      (S.indicator (fun _ => (1 : ℝ≥0∞)) p.1 * ‖v p.1‖ₑ) *
      (S.indicator (fun _ => (1 : ℝ≥0∞)) p.2 * ‖u p.2‖ₑ) ∂(μ.prod μ))
      = B * ((∫⁻ x, S.indicator (fun _ => (1 : ℝ≥0∞)) x * ‖v x‖ₑ ∂μ) *
        ∫⁻ y, S.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖u y‖ₑ ∂μ) := by
    rw [show (fun p : α × α => B *
        (S.indicator (fun _ => (1 : ℝ≥0∞)) p.1 * ‖v p.1‖ₑ) *
        (S.indicator (fun _ => (1 : ℝ≥0∞)) p.2 * ‖u p.2‖ₑ))
        = (fun p : α × α => B *
          ((fun x => S.indicator (fun _ => (1 : ℝ≥0∞)) x * ‖v x‖ₑ) p.1 *
           (fun y => S.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖u y‖ₑ) p.2)) from by
      funext p; ring]
    rw [lintegral_const_mul' _ _ hB, lintegral_prod_mul hmv hmu]
  have hfinv : (∫⁻ x, S.indicator (fun _ => (1 : ℝ≥0∞)) x * ‖v x‖ₑ ∂μ) ≠ ⊤ := by
    refine ne_top_of_le_ne_top ?_ (lintegral_indicator_enorm_le hS hv.aemeasurable)
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hSfin)
      (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hv2)
  have hfinu : (∫⁻ y, S.indicator (fun _ => (1 : ℝ≥0∞)) y * ‖u y‖ₑ ∂μ) ≠ ⊤ := by
    refine ne_top_of_le_ne_top ?_ (lintegral_indicator_enorm_le hS hu.aemeasurable)
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hSfin)
      (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hu2)
  have hlt : (∫⁻ p : α × α, ‖(Function.uncurry g) p‖ₑ ∂(μ.prod μ)) < ⊤ := by
    refine lt_of_le_of_lt (lintegral_mono hfac) ?_
    rw [hsplit]
    exact lt_top_iff_ne_top.mpr
      (ENNReal.mul_ne_top hB (ENNReal.mul_ne_top hfinv hfinu))
  simpa [HasFiniteIntegral] using hlt

/-! ### Adjoints of good kernels -/

/-- The adjoint kernel. -/
def adjKernel (K : α → α → ℂ) : α → α → ℂ := fun x y => (starRingEnd ℂ) (K y x)

theorem isGoodKernel_adjKernel {μ : Measure α} {K : α → α → ℂ} (hK : IsGoodKernel μ K) :
    IsGoodKernel μ (adjKernel K) := by
  obtain ⟨B, S, hB, hS, hSfin, hbdd, hsupp⟩ := hK.exists_data
  refine ⟨?_, ⟨B, S, hB, hS, hSfin, ?_, ?_⟩⟩
  · exact (Complex.continuous_conj.measurable).comp (hK.meas.comp measurable_swap)
  · intro x y
    simpa [adjKernel] using hbdd y x
  · intro x y hne
    have hne' : K y x ≠ 0 := by
      intro h
      simp [adjKernel, h] at hne
    exact ⟨(hsupp y x hne').2, (hsupp y x hne').1⟩

theorem adjoint_goodCLM {μ : Measure α} [SFinite μ] {K : α → α → ℂ} (hK : IsGoodKernel μ K) :
    ContinuousLinearMap.adjoint (goodCLM μ K hK)
      = goodCLM μ (adjKernel K) (isGoodKernel_adjKernel hK) := by
  symm
  rw [ContinuousLinearMap.eq_adjoint_iff]
  intro u v
  have hu2 := sqMass_ne_top_of_memLp (Lp.memLp u)
  have hv2 := sqMass_ne_top_of_memLp (Lp.memLp v)
  have hum := (Lp.memLp u).1
  have hvm := (Lp.memLp v).1
  have hleft : (inner ℂ (goodCLM μ (adjKernel K) (isGoodKernel_adjKernel hK) u) v)
      = ∫ x, ∫ y, K y x * (starRingEnd ℂ) ((u : α → ℂ) y) * (v : α → ℂ) x ∂μ ∂μ := by
    rw [MeasureTheory.L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [coeFn_goodCLM μ (adjKernel K) (isGoodKernel_adjKernel hK) u] with x hx
    rw [RCLike.inner_apply, hx, kernelApply, ← integral_conj, ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only [adjKernel, map_mul, Complex.conj_conj]
    ring
  have hright : (inner ℂ u (goodCLM μ K hK v))
      = ∫ y, ∫ x, K y x * (starRingEnd ℂ) ((u : α → ℂ) y) * (v : α → ℂ) x ∂μ ∂μ := by
    rw [MeasureTheory.L2.inner_def]
    refine integral_congr_ae ?_
    filter_upwards [coeFn_goodCLM μ K hK v] with y hy
    rw [RCLike.inner_apply, hy, kernelApply, ← integral_mul_const]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    ring
  rw [hleft, hright]
  refine integral_integral_swap ?_
  refine integrable_prod_of_good (isGoodKernel_adjKernel hK) hum hvm hu2 hv2
    (g := fun x y => K y x * (starRingEnd ℂ) ((u : α → ℂ) y) * (v : α → ℂ) x) ?_ ?_
  · refine AEStronglyMeasurable.mul (AEStronglyMeasurable.mul ?_ ?_) ?_
    · exact ((hK.meas.comp measurable_swap).stronglyMeasurable).aestronglyMeasurable
    · exact (Complex.continuous_conj.comp_aestronglyMeasurable hum).comp_snd
    · exact hvm.comp_fst
  · intro x y
    simp [adjKernel, enorm_mul]

/-! ### Composition of good kernels -/

/-- The composition of two kernels. -/
def compKernel (μ : Measure α) (K₁ K₂ : α → α → ℂ) : α → α → ℂ :=
  fun x z => ∫ y, K₁ x y * K₂ y z ∂μ

theorem measurable_compKernel {μ : Measure α} [SFinite μ] {K₁ K₂ : α → α → ℂ}
    (h₁ : Measurable (Function.uncurry K₁)) (h₂ : Measurable (Function.uncurry K₂)) :
    Measurable (Function.uncurry (compKernel μ K₁ K₂)) := by
  have hf : StronglyMeasurable (fun q : (α × α) × α => K₁ q.1.1 q.2 * K₂ q.2 q.1.2) := by
    refine Measurable.stronglyMeasurable (Measurable.mul ?_ ?_)
    · exact h₁.comp ((measurable_fst.comp measurable_fst).prodMk measurable_snd)
    · exact h₂.comp (measurable_snd.prodMk (measurable_snd.comp measurable_fst))
  exact (hf.integral_prod_right').measurable

theorem isGoodKernel_compKernel {μ : Measure α} [SFinite μ] {K₁ K₂ : α → α → ℂ}
    (h₁ : IsGoodKernel μ K₁) (h₂ : IsGoodKernel μ K₂) :
    IsGoodKernel μ (compKernel μ K₁ K₂) := by
  obtain ⟨B₁, S₁, hB₁, hS₁, hS₁fin, hbdd₁, hsupp₁⟩ := h₁.exists_data
  obtain ⟨B₂, S₂, hB₂, hS₂, hS₂fin, hbdd₂, hsupp₂⟩ := h₂.exists_data
  refine ⟨measurable_compKernel h₁.meas h₂.meas,
    ⟨B₁ * B₂ * μ S₂, S₁ ∪ S₂, ENNReal.mul_ne_top (ENNReal.mul_ne_top hB₁ hB₂) hS₂fin,
      hS₁.union hS₂, ?_, ?_, ?_⟩⟩
  · exact ne_top_of_le_ne_top (ENNReal.add_ne_top.mpr ⟨hS₁fin, hS₂fin⟩) (measure_union_le _ _)
  · intro x z
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hle : ∀ y, ‖K₁ x y * K₂ y z‖ₑ ≤ S₂.indicator (fun _ => B₁ * B₂) y := by
      intro y
      by_cases hy : y ∈ S₂
      · rw [Set.indicator_of_mem hy, enorm_mul]
        exact mul_le_mul' (hbdd₁ x y) (hbdd₂ y z)
      · have hz : K₂ y z = 0 := by
          by_contra hne
          exact hy (hsupp₂ y z hne).1
        simp [Set.indicator_of_notMem hy, hz]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS₂]
  · intro x z hne
    refine ⟨Or.inl ?_, Or.inr ?_⟩
    · by_contra hx
      apply hne
      simp only [compKernel]
      have : ∀ y, K₁ x y * K₂ y z = 0 := by
        intro y
        by_cases hK : K₁ x y = 0
        · simp [hK]
        · exact absurd (hsupp₁ x y hK).1 hx
      simp [this]
    · by_contra hz
      apply hne
      simp only [compKernel]
      have : ∀ y, K₁ x y * K₂ y z = 0 := by
        intro y
        by_cases hK : K₂ y z = 0
        · simp [hK]
        · exact absurd (hsupp₂ y z hK).2 hz
      simp [this]

theorem kernelApply_comp {μ : Measure α} [SFinite μ] {K₁ K₂ : α → α → ℂ}
    (h₁ : IsGoodKernel μ K₁) (h₂ : IsGoodKernel μ K₂) {f : α → ℂ}
    (hfm : AEStronglyMeasurable f μ) (hf2 : sqMass μ f ≠ ⊤) :
    kernelApply μ K₁ (kernelApply μ K₂ f) = kernelApply μ (compKernel μ K₁ K₂) f := by
  funext x
  have hint : Integrable (Function.uncurry
      (fun y z => K₁ x y * K₂ y z * f z)) (μ.prod μ) := by
    refine integrable_prod_of_good h₂ hfm (h₁.row_meas x).aestronglyMeasurable hf2
      (h₁.sqMass_row_ne_top x) ?_ ?_
    · refine AEStronglyMeasurable.mul (AEStronglyMeasurable.mul ?_ ?_) ?_
      · exact ((h₁.row_meas x).comp measurable_fst).stronglyMeasurable.aestronglyMeasurable
      · exact h₂.meas.stronglyMeasurable.aestronglyMeasurable
      · exact hfm.comp_snd
    · intro y z
      simp only [enorm_mul]
      ring_nf
      rfl
  have hswap := integral_integral_swap hint
  simp only [kernelApply, compKernel]
  have hL : (∫ y, K₁ x y * ∫ z, K₂ y z * f z ∂μ ∂μ)
      = ∫ y, ∫ z, K₁ x y * K₂ y z * f z ∂μ ∂μ := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    simp only
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
    ring
  have hR : (∫ z, (∫ y, K₁ x y * K₂ y z ∂μ) * f z ∂μ)
      = ∫ z, ∫ y, K₁ x y * K₂ y z * f z ∂μ ∂μ := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun z => ?_)
    simp only
    rw [← integral_mul_const]
  rw [hL, hR]
  exact hswap

theorem goodCLM_comp {μ : Measure α} [SFinite μ] {K₁ K₂ : α → α → ℂ}
    (h₁ : IsGoodKernel μ K₁) (h₂ : IsGoodKernel μ K₂) :
    (goodCLM μ K₁ h₁) ∘L (goodCLM μ K₂ h₂)
      = goodCLM μ (compKernel μ K₁ K₂) (isGoodKernel_compKernel h₁ h₂) := by
  refine ContinuousLinearMap.ext fun F => ?_
  refine Lp.ext ?_
  have hstep : ((goodCLM μ K₁ h₁ (goodCLM μ K₂ h₂ F) : Lp ℂ 2 μ) : α → ℂ)
      =ᵐ[μ] kernelApply μ K₁ (kernelApply μ K₂ (F : α → ℂ)) := by
    refine (coeFn_goodCLM μ K₁ h₁ (goodCLM μ K₂ h₂ F)).trans ?_
    exact Filter.Eventually.of_forall (fun x => by
      rw [kernelApply_congr_ae K₁ (coeFn_goodCLM μ K₂ h₂ F)])
  refine hstep.trans ?_
  rw [kernelApply_comp h₁ h₂ (Lp.memLp F).1 (sqMass_ne_top_of_memLp (Lp.memLp F))]
  exact (coeFn_goodCLM μ (compKernel μ K₁ K₂) (isGoodKernel_compKernel h₁ h₂) F).symm

end Kernel

/-! ## A lattice partition of unity -/

section Bump

open Real

/-- The one-dimensional building block of the partition of unity: a smooth function supported
in `[-1, 1]` whose integer translates sum to one. -/
def bump1 (t : ℝ) : ℝ := smoothTransition (t + 1) - smoothTransition t

theorem bump1_contDiff : ContDiff ℝ (↑(⊤ : ℕ∞)) bump1 := by
  exact (Real.smoothTransition.contDiff.comp (contDiff_id.add contDiff_const)).sub
    Real.smoothTransition.contDiff

theorem abs_bump1_le_one (t : ℝ) : |bump1 t| ≤ 1 := by
  have h1 := Real.smoothTransition.nonneg (t + 1)
  have h2 := Real.smoothTransition.le_one (t + 1)
  have h3 := Real.smoothTransition.nonneg t
  have h4 := Real.smoothTransition.le_one t
  rw [abs_le, bump1]
  constructor <;> linarith

theorem bump1_eq_zero_of_le (t : ℝ) (h : t ≤ -1) : bump1 t = 0 := by
  rw [bump1, Real.smoothTransition.zero_of_nonpos (by linarith),
    Real.smoothTransition.zero_of_nonpos (by linarith), sub_zero]

theorem bump1_eq_zero_of_ge (t : ℝ) (h : 1 ≤ t) : bump1 t = 0 := by
  rw [bump1, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le h, sub_self]

theorem bump1_eq_zero_of_one_lt_abs (t : ℝ) (h : 1 ≤ |t|) : bump1 t = 0 := by
  rcases abs_cases t with ⟨he, _⟩ | ⟨he, _⟩
  · exact bump1_eq_zero_of_ge t (by rw [he] at h; exact h)
  · exact bump1_eq_zero_of_le t (by rw [he] at h; linarith)

/-- Telescoping over a symmetric integer interval. -/
theorem sum_Icc_telescope (F : ℤ → ℝ) (M : ℕ) :
    ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), (F (n - 1) - F n) = F (-(M : ℤ) - 1) - F (M : ℤ) := by
  induction M with
  | zero => simp
  | succ M ih =>
      have hset : Finset.Icc (-((M : ℤ) + 1)) ((M : ℤ) + 1)
          = insert (-((M : ℤ) + 1)) (insert ((M : ℤ) + 1) (Finset.Icc (-(M : ℤ)) (M : ℤ))) := by
        ext n
        simp only [Finset.mem_Icc, Finset.mem_insert]
        omega
      have hnot1 : ((M : ℤ) + 1) ∉ Finset.Icc (-(M : ℤ)) (M : ℤ) := by
        simp only [Finset.mem_Icc]
        omega
      have hnot2 : (-((M : ℤ) + 1)) ∉
          insert ((M : ℤ) + 1) (Finset.Icc (-(M : ℤ)) (M : ℤ)) := by
        simp only [Finset.mem_insert, Finset.mem_Icc]
        omega
      have hcast : ((M + 1 : ℕ) : ℤ) = (M : ℤ) + 1 := by push_cast; ring
      rw [hcast, hset, Finset.sum_insert hnot2, Finset.sum_insert hnot1, ih,
        show ((M : ℤ) + 1) - 1 = (M : ℤ) from by ring,
        show -((M : ℤ) + 1) = -(M : ℤ) - 1 from by ring]
      ring

theorem sum_bump1 (t : ℝ) (M : ℕ) (h : |t| ≤ (M : ℝ)) :
    ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), bump1 (t - (n : ℝ)) = 1 := by
  set F : ℤ → ℝ := fun m => smoothTransition (t - (m : ℝ)) with hFdef
  have hrw : ∀ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), bump1 (t - (n : ℝ)) = F (n - 1) - F n := by
    intro n _
    rw [hFdef]
    simp only [bump1]
    congr 2
    push_cast
    ring
  rw [Finset.sum_congr rfl hrw, sum_Icc_telescope F M, hFdef]
  have habs := abs_le.mp h
  have h1 : smoothTransition (t - ((-(M : ℤ) - 1 : ℤ) : ℝ)) = 1 := by
    refine Real.smoothTransition.one_of_one_le ?_
    push_cast
    linarith [habs.1]
  have h2 : smoothTransition (t - ((M : ℤ) : ℝ)) = 0 := by
    refine Real.smoothTransition.zero_of_nonpos ?_
    push_cast
    linarith [habs.2]
  simp only
  rw [h1, h2, sub_zero]

end Bump

/-! ## The `d`-dimensional bump and the lattice partition of unity -/

section BumpD

open Real

/-- The `d`-dimensional bump, a product of one-dimensional bumps in the coordinates. -/
def bumpD (d : ℕ) (x : EuclideanSpace ℝ (Fin d)) : ℝ := ∏ i, bump1 (x i)

/-- The lattice `ℤ ^ d` inside `ℝ ^ d`. -/
def latt (d : ℕ) (k : Fin d → ℤ) : EuclideanSpace ℝ (Fin d) :=
  WithLp.toLp 2 (fun i => (k i : ℝ))

@[simp] theorem latt_apply (d : ℕ) (k : Fin d → ℤ) (i : Fin d) :
    latt d k i = (k i : ℝ) := rfl

theorem abs_apply_le_norm {d : ℕ} (x : EuclideanSpace ℝ (Fin d)) (i : Fin d) :
    |x i| ≤ ‖x‖ := by
  have h : |x i| ^ 2 ≤ ‖x‖ ^ 2 := by
    rw [EuclideanSpace.real_norm_sq_eq, sq_abs]
    exact Finset.single_le_sum (f := fun j => (x j) ^ 2) (fun j _ => sq_nonneg _)
      (Finset.mem_univ i)
  exact (pow_le_pow_iff_left₀ (abs_nonneg _) (norm_nonneg _) (by norm_num)).mp h

theorem contDiff_bumpD (d : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (bumpD d) := by
  refine contDiff_prod (fun i _ => ?_)
  exact bump1_contDiff.comp ((EuclideanSpace.proj (𝕜 := ℝ) i).contDiff)

theorem abs_bumpD_le_one (d : ℕ) (x : EuclideanSpace ℝ (Fin d)) : |bumpD d x| ≤ 1 := by
  rw [bumpD, Finset.abs_prod]
  calc ∏ i, |bump1 (x i)| ≤ ∏ _i : Fin d, (1 : ℝ) :=
        Finset.prod_le_prod (fun i _ => abs_nonneg _) (fun i _ => abs_bump1_le_one _)
    _ = 1 := by simp

theorem bumpD_eq_zero_of_norm_lt {d : ℕ} {x : EuclideanSpace ℝ (Fin d)}
    (h : Real.sqrt d < ‖x‖) : bumpD d x = 0 := by
  by_contra hne
  rw [bumpD] at hne
  have hne' := Finset.prod_ne_zero_iff.mp hne
  have hlt : ∀ i, |x i| < 1 := by
    intro i
    by_contra hge
    exact hne' i (Finset.mem_univ i) (bump1_eq_zero_of_one_lt_abs _ (not_lt.mp hge))
  have hsq : ‖x‖ ^ 2 ≤ (d : ℝ) := by
    rw [EuclideanSpace.real_norm_sq_eq]
    calc ∑ i, (x i) ^ 2 ≤ ∑ _i : Fin d, (1 : ℝ) := by
          refine Finset.sum_le_sum (fun i _ => ?_)
          rw [← sq_abs]
          nlinarith [hlt i, abs_nonneg (x i)]
      _ = (d : ℝ) := by simp
  have hnn : (0 : ℝ) ≤ ‖x‖ := norm_nonneg _
  have : ‖x‖ ≤ Real.sqrt d := by
    rw [show (d : ℝ) = Real.sqrt d ^ 2 from (Real.sq_sqrt (by positivity)).symm] at hsq
    nlinarith [Real.sqrt_nonneg (d : ℝ)]
  linarith

theorem hasCompactSupport_bumpD (d : ℕ) : HasCompactSupport (bumpD d) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : EuclideanSpace ℝ (Fin d))
    (Real.sqrt d)) ?_
  intro x hx
  refine bumpD_eq_zero_of_norm_lt ?_
  simpa [Metric.mem_closedBall, dist_zero_right] using hx

theorem exists_bumpD_bound (d N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ C := by
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ C := by
    intro n
    exact ((hasCompactSupport_bumpD d).iteratedFDeriv n).exists_bound_of_continuous
      ((contDiff_bumpD d).continuous_iteratedFDeriv (by exact_mod_cast le_top))
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg (fun n _ => abs_nonneg _)
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn x
  refine le_trans (hC n x) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ m ∈ Finset.range (N + 1), |C m| :=
    Finset.single_le_sum (f := fun m => |C m|) (fun m _ => abs_nonneg _) hmem
  have : C n ≤ |C n| := le_abs_self _
  linarith

/-- The lattice box of radius `M`. -/
def latticeBox (d M : ℕ) : Finset (Fin d → ℤ) :=
  Fintype.piFinset (fun _ : Fin d => Finset.Icc (-(M : ℤ)) (M : ℤ))

/-- The lattice translates of `bumpD` form a partition of unity. -/
theorem sum_bumpD (d M : ℕ) (x : EuclideanSpace ℝ (Fin d)) (hx : ‖x‖ ≤ (M : ℝ)) :
    ∑ k ∈ latticeBox d M, bumpD d (x - latt d k) = 1 := by
  have hcoord : ∀ (k : Fin d → ℤ) (i : Fin d), (x - latt d k) i = x i - (k i : ℝ) := by
    intro k i
    rw [PiLp.sub_apply, latt_apply]
  have hsum : ∀ i : Fin d, ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), bump1 (x i - (n : ℝ)) = 1 := by
    intro i
    exact sum_bump1 (x i) M (le_trans (abs_apply_le_norm x i) hx)
  calc ∑ k ∈ latticeBox d M, bumpD d (x - latt d k)
      = ∑ k ∈ Fintype.piFinset (fun _ : Fin d => Finset.Icc (-(M : ℤ)) (M : ℤ)),
          ∏ i, bump1 (x i - ((k i : ℤ) : ℝ)) := by
        refine Finset.sum_congr rfl (fun k _ => ?_)
        rw [bumpD]
        exact Finset.prod_congr rfl (fun i _ => by rw [hcoord k i])
    _ = ∏ i : Fin d, ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), bump1 (x i - (n : ℝ)) :=
        (Finset.prod_univ_sum (fun _ : Fin d => Finset.Icc (-(M : ℤ)) (M : ℤ))
          (fun (i : Fin d) (n : ℤ) => bump1 (x i - (n : ℝ)))).symm
    _ = 1 := by
        rw [Finset.prod_congr rfl (fun i _ => hsum i), Finset.prod_const_one]

end BumpD

/-! ## Fourier decay of smooth compactly supported functions -/

section FourierDecay

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V] [FiniteDimensional ℝ V]
  [MeasurableSpace V] [BorelSpace V]

/-- The `L¹` norm of a continuous function supported in a set of finite measure is at most
the sup bound times the measure of the set. -/
theorem integral_norm_le_of_support {E : Type*} [NormedAddCommGroup E]
    {f : V → E} {C : ℝ} {S : Set V}
    (hf : Integrable f) (hS : MeasurableSet S) (hSfin : volume S ≠ ⊤) (hC : 0 ≤ C)
    (hbd : ∀ x, ‖f x‖ ≤ C) (hsupp : ∀ x, x ∉ S → f x = 0) :
    (∫ v, ‖f v‖) ≤ C * (volume S).toReal := by
  have hlt : (∫⁻ v, ‖f v‖ₑ) ≤ ENNReal.ofReal C * volume S := by
    have hle : ∀ v, ‖f v‖ₑ ≤ S.indicator (fun _ => ENNReal.ofReal C) v := by
      intro v
      by_cases hv : v ∈ S
      · rw [Set.indicator_of_mem hv, ← ofReal_norm_eq_enorm]
        exact ENNReal.ofReal_le_ofReal (hbd v)
      · simp [Set.indicator_of_notMem hv, hsupp v hv]
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const hS]
  rw [← ENNReal.ofReal_le_ofReal_iff (by positivity),
    ofReal_integral_norm_eq_lintegral_enorm hf]
  refine le_trans hlt (le_of_eq ?_)
  rw [ENNReal.ofReal_mul hC, ENNReal.ofReal_toReal hSfin]

/-- The Fourier transform of a smooth compactly supported function decays like
`(1 + ‖w‖) ^ (-N)`, with a constant controlled by the `L¹` norms of the derivatives. -/
theorem pow_mul_norm_fourier_le {Ψ : V → ℂ} {M : ℝ} {N : ℕ}
    (hsm : ContDiff ℝ (↑(⊤ : ℕ∞)) Ψ) (hcs : HasCompactSupport Ψ)
    (hint : ∀ n ≤ N, (∫ v, ‖iteratedFDeriv ℝ n Ψ v‖) ≤ M) (w : V) :
    ‖w‖ ^ N * ‖𝓕 Ψ w‖ ≤ 2 ^ N * ((N : ℝ) + 1) * M := by
  have hMnn : 0 ≤ M := by
    refine le_trans ?_ (hint 0 (Nat.zero_le N))
    exact integral_nonneg (fun v => norm_nonneg _)
  have hintbl : ∀ (k n : ℕ), k ≤ (0 : ℕ∞) → (n : ℕ∞) ≤ (⊤ : ℕ∞) →
      Integrable (fun v => ‖v‖ ^ k * ‖iteratedFDeriv ℝ n Ψ v‖) := by
    intro k n hk _
    have hk0 : k = 0 := by simpa using hk
    subst hk0
    simp only [pow_zero, one_mul]
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (hsm.continuous_iteratedFDeriv (by exact_mod_cast le_top)).norm
    · exact (hcs.iteratedFDeriv n).norm
  have hmain := Real.pow_mul_norm_iteratedFDeriv_fourier_le (f := Ψ) (K := (0 : ℕ∞))
    (N := (⊤ : ℕ∞)) hsm hintbl (k := 0) (n := N) (le_refl _) le_top w
  rw [norm_iteratedFDeriv_zero] at hmain
  refine le_trans hmain ?_
  · have hsum : (∑ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
        ∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖) ≤ ((N : ℝ) + 1) * M := by
      have hcard : (Finset.range (0 + 1) ×ˢ Finset.range (N + 1)).card = N + 1 := by
        simp
      have hterm : ∀ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
          (∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖) ≤ M := by
        intro p hp
        rw [Finset.mem_product, Finset.mem_range, Finset.mem_range] at hp
        have hp1 : p.1 = 0 := by omega
        rw [hp1]
        simp only [pow_zero, one_mul]
        exact hint p.2 (by omega)
      calc (∑ p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1),
            ∫ v, ‖v‖ ^ p.1 * ‖iteratedFDeriv ℝ p.2 Ψ v‖)
          ≤ ∑ _p ∈ Finset.range (0 + 1) ×ˢ Finset.range (N + 1), M :=
            Finset.sum_le_sum hterm
        _ = ((N : ℝ) + 1) * M := by
            rw [Finset.sum_const, hcard, nsmul_eq_mul]
            push_cast
            ring
    refine le_trans (mul_le_mul_of_nonneg_left hsum (by positivity)) (le_of_eq ?_)
    norm_num
    ring

/-- The combined decay estimate in the form used below. -/
theorem one_add_pow_mul_norm_fourier_le {Ψ : V → ℂ} {M : ℝ} {N : ℕ}
    (hsm : ContDiff ℝ (↑(⊤ : ℕ∞)) Ψ) (hcs : HasCompactSupport Ψ)
    (hint : ∀ n ≤ N, (∫ v, ‖iteratedFDeriv ℝ n Ψ v‖) ≤ M) (w : V) :
    (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 4 ^ N * ((N : ℝ) + 1) * M := by
  have hMnn : 0 ≤ M := by
    refine le_trans ?_ (hint 0 (Nat.zero_le N))
    exact integral_nonneg (fun v => norm_nonneg _)
  have hzero : ‖𝓕 Ψ w‖ ≤ M := by
    have h := pow_mul_norm_fourier_le (N := 0) hsm hcs (fun n hn => hint n (by omega)) w
    simpa using h
  have hbig := pow_mul_norm_fourier_le (N := N) hsm hcs hint w
  have hkey : (max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖ ≤ 2 ^ N * ((N : ℝ) + 1) * M := by
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw, one_pow, one_mul]
      have h2 : (1 : ℝ) ≤ 2 ^ N * ((N : ℝ) + 1) := by
        have : (1 : ℝ) ≤ 2 ^ N := one_le_pow₀ (by norm_num)
        nlinarith [Nat.cast_nonneg (α := ℝ) N]
      nlinarith
    · rw [max_eq_right hw]
      exact hbig
  have hone : (1 + ‖w‖) ^ N ≤ 2 ^ N * (max 1 ‖w‖) ^ N := by
    rw [← mul_pow]
    refine pow_le_pow_left₀ (by positivity) ?_ N
    rcases le_total ‖w‖ 1 with hw | hw
    · rw [max_eq_left hw]; linarith
    · rw [max_eq_right hw]; linarith [norm_nonneg w]
  calc (1 + ‖w‖) ^ N * ‖𝓕 Ψ w‖
      ≤ (2 ^ N * (max 1 ‖w‖) ^ N) * ‖𝓕 Ψ w‖ :=
        mul_le_mul_of_nonneg_right hone (norm_nonneg _)
    _ = 2 ^ N * ((max 1 ‖w‖) ^ N * ‖𝓕 Ψ w‖) := by ring
    _ ≤ 2 ^ N * (2 ^ N * ((N : ℝ) + 1) * M) := by
        refine mul_le_mul_of_nonneg_left hkey (by positivity)
    _ = 4 ^ N * ((N : ℝ) + 1) * M := by
        rw [show (4 : ℝ) = 2 * 2 from by norm_num, mul_pow]
        ring

end FourierDecay

/-! ## Summation over the lattice -/

section LatticeSum

/-- The elementary one-dimensional lattice sum. -/
theorem sum_Icc_inv_sq_le (M : ℕ) :
    ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), (((1 : ℝ) + |(n : ℝ)|) ^ 2)⁻¹
      ≤ 3 - 2 / ((M : ℝ) + 1) := by
  induction M with
  | zero => norm_num
  | succ M ih =>
      have hset : Finset.Icc (-((M : ℤ) + 1)) ((M : ℤ) + 1)
          = insert (-((M : ℤ) + 1)) (insert ((M : ℤ) + 1) (Finset.Icc (-(M : ℤ)) (M : ℤ))) := by
        ext n
        simp only [Finset.mem_Icc, Finset.mem_insert]
        omega
      have hnot1 : ((M : ℤ) + 1) ∉ Finset.Icc (-(M : ℤ)) (M : ℤ) := by
        simp only [Finset.mem_Icc]; omega
      have hnot2 : (-((M : ℤ) + 1)) ∉
          insert ((M : ℤ) + 1) (Finset.Icc (-(M : ℤ)) (M : ℤ)) := by
        simp only [Finset.mem_insert, Finset.mem_Icc]; omega
      have hcast : ((M + 1 : ℕ) : ℤ) = (M : ℤ) + 1 := by push_cast; ring
      have habs1 : |((((M : ℤ) + 1 : ℤ)) : ℝ)| = (M : ℝ) + 1 := by
        push_cast
        rw [abs_of_nonneg (by positivity)]
      have habs2 : |((-((M : ℤ) + 1) : ℤ) : ℝ)| = (M : ℝ) + 1 := by
        push_cast
        rw [abs_of_nonpos (by linarith [Nat.cast_nonneg (α := ℝ) M])]
        ring
      have hMp : (0 : ℝ) < (M : ℝ) + 1 := by positivity
      have hMp2 : (0 : ℝ) < (M : ℝ) + 2 := by positivity
      have he : (1 : ℝ) + ((M : ℝ) + 1) = (M : ℝ) + 2 := by ring
      have hkey : (((1 : ℝ) + ((M : ℝ) + 1)) ^ 2)⁻¹ + (((1 : ℝ) + ((M : ℝ) + 1)) ^ 2)⁻¹
          ≤ 2 / ((M : ℝ) + 1) - 2 / ((M : ℝ) + 2) := by
        rw [he]
        have h1 : 2 / ((M : ℝ) + 1) - 2 / ((M : ℝ) + 2)
            = 2 / (((M : ℝ) + 1) * ((M : ℝ) + 2)) := by
          field_simp
          ring
        have h2 : (((M : ℝ) + 2) ^ 2)⁻¹ + (((M : ℝ) + 2) ^ 2)⁻¹
            = 2 / ((M : ℝ) + 2) ^ 2 := by
          field_simp
          ring
        rw [h1, h2, div_le_div_iff₀ (by positivity) (by positivity)]
        nlinarith [hMp, hMp2]
      rw [hcast, hset, Finset.sum_insert hnot2, Finset.sum_insert hnot1, habs1, habs2]
      have hgoal : ((M + 1 : ℕ) : ℝ) + 1 = (M : ℝ) + 2 := by push_cast; ring
      rw [hgoal]
      linarith [ih, hkey]

theorem sum_finset_int_inv_sq_le (t : Finset ℤ) :
    ∑ n ∈ t, (((1 : ℝ) + |(n : ℝ)|) ^ 2)⁻¹ ≤ 3 := by
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ n ∈ t, n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ) := by
    refine ⟨(t.image Int.natAbs).sup id, fun n hn => ?_⟩
    have h1 : n.natAbs ≤ (t.image Int.natAbs).sup id :=
      Finset.le_sup (f := id) (Finset.mem_image_of_mem Int.natAbs hn)
    simp only [Finset.mem_Icc]
    omega
  have hsub : t ⊆ Finset.Icc (-(M : ℤ)) (M : ℤ) := fun n hn => hM n hn
  refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg hsub
    (fun n _ _ => by positivity)) ?_
  refine le_trans (sum_Icc_inv_sq_le M) ?_
  have : (0 : ℝ) < (M : ℝ) + 1 := by positivity
  have h2 : (0 : ℝ) ≤ 2 / ((M : ℝ) + 1) := by positivity
  linarith

/-- The key lattice decay sum: an isotropic decay of order `2 d` is summable over `ℤ ^ d`. -/
theorem sum_lattice_inv_pow_le (d : ℕ) (s : Finset (Fin d → ℤ)) :
    ∑ m ∈ s, (((1 : ℝ) + ‖latt d m‖) ^ (2 * d))⁻¹ ≤ 3 ^ d := by
  classical
  -- pointwise comparison with a product
  have hpt : ∀ m : Fin d → ℤ, (((1 : ℝ) + ‖latt d m‖) ^ (2 * d))⁻¹
      ≤ ∏ i, (((1 : ℝ) + |((m i : ℤ) : ℝ)|) ^ 2)⁻¹ := by
    intro m
    have hprodle : (∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|)) ≤ ((1 : ℝ) + ‖latt d m‖) ^ d := by
      calc (∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|))
          ≤ ∏ _i : Fin d, ((1 : ℝ) + ‖latt d m‖) := by
            refine Finset.prod_le_prod (fun i _ => by positivity) (fun i _ => ?_)
            have := abs_apply_le_norm (latt d m) i
            rw [latt_apply] at this
            linarith
        _ = ((1 : ℝ) + ‖latt d m‖) ^ d := by
            rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
    have hpos : (0 : ℝ) < ∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|) := by
      refine Finset.prod_pos (fun i _ => by positivity)
    have hsq : (∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|)) ^ 2 ≤ ((1 : ℝ) + ‖latt d m‖) ^ (2 * d) := by
      have h1 : ((1 : ℝ) + ‖latt d m‖) ^ (2 * d) = (((1 : ℝ) + ‖latt d m‖) ^ d) ^ 2 := by
        rw [mul_comm, pow_mul]
      rw [h1]
      exact pow_le_pow_left₀ (le_of_lt hpos) hprodle 2
    have hrw : (∏ i, (((1 : ℝ) + |((m i : ℤ) : ℝ)|) ^ 2)⁻¹)
        = ((∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|)) ^ 2)⁻¹ := by
      rw [Finset.prod_inv_distrib, Finset.prod_pow]
    rw [hrw]
    have hone := one_div_le_one_div_of_le
      (show (0 : ℝ) < (∏ i, ((1 : ℝ) + |((m i : ℤ) : ℝ)|)) ^ 2 by positivity) hsq
    rw [inv_eq_one_div, inv_eq_one_div]
    exact hone
  refine le_trans (Finset.sum_le_sum (fun m _ => hpt m)) ?_
  -- enlarge to a product box
  obtain ⟨M, hM⟩ : ∃ M : ℕ, ∀ m ∈ s, ∀ i, m i ∈ Finset.Icc (-(M : ℤ)) (M : ℤ) := by
    refine ⟨(s.biUnion (fun m => Finset.univ.image (fun i => (m i).natAbs))).sup id,
      fun m hm i => ?_⟩
    have hmem : (m i).natAbs ∈
        s.biUnion (fun m => Finset.univ.image (fun i => (m i).natAbs)) := by
      refine Finset.mem_biUnion.mpr ⟨m, hm, ?_⟩
      exact Finset.mem_image_of_mem _ (Finset.mem_univ i)
    have h1 : (m i).natAbs ≤ (s.biUnion
        (fun m => Finset.univ.image (fun i => (m i).natAbs))).sup id :=
      Finset.le_sup (f := id) hmem
    simp only [Finset.mem_Icc]
    omega
  have hsub : s ⊆ Fintype.piFinset (fun _ : Fin d => Finset.Icc (-(M : ℤ)) (M : ℤ)) := by
    intro m hm
    exact Fintype.mem_piFinset.mpr (fun i => hM m hm i)
  refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg hsub (fun m _ _ => by positivity)) ?_
  rw [← Finset.prod_univ_sum (fun _ : Fin d => Finset.Icc (-(M : ℤ)) (M : ℤ))
    (fun (_ : Fin d) (n : ℤ) => (((1 : ℝ) + |(n : ℝ)|) ^ 2)⁻¹)]
  calc (∏ _i : Fin d, ∑ n ∈ Finset.Icc (-(M : ℤ)) (M : ℤ), (((1 : ℝ) + |(n : ℝ)|) ^ 2)⁻¹)
      ≤ ∏ _i : Fin d, (3 : ℝ) := by
        refine Finset.prod_le_prod (fun i _ => Finset.sum_nonneg (fun n _ => by positivity))
          (fun i _ => sum_finset_int_inv_sq_le _)
    _ = 3 ^ d := by rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]

end LatticeSum

/-! ## Derivative bounds for products -/

section DerivBounds

variable {V : Type*} [NormedAddCommGroup V] [InnerProductSpace ℝ V]

/-- Leibniz bound: the derivatives of a product of two functions with bounded derivatives are
bounded. -/
theorem norm_iteratedFDeriv_mul_le' {f g : V → ℂ} {Cf Cg : ℝ} {N : ℕ}
    (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g)
    (hCf : 0 ≤ Cf) (hCg : 0 ≤ Cg)
    (hfb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n f x‖ ≤ Cf)
    (hgb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n g x‖ ≤ Cg) :
    ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (fun y => f y * g y) x‖ ≤ 2 ^ N * (Cf * Cg) := by
  intro n hn x
  refine le_trans (norm_iteratedFDeriv_mul_le hf hg x (by exact_mod_cast le_top)) ?_
  have hstep : ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ *
        ‖iteratedFDeriv ℝ (n - i) g x‖
      ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ) * (Cf * Cg) := by
    refine Finset.sum_le_sum (fun i hi => ?_)
    have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
    calc (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i f x‖ * ‖iteratedFDeriv ℝ (n - i) g x‖
        ≤ (n.choose i : ℝ) * Cf * Cg := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left (hfb i (by omega) x) (by positivity))
            (hgb (n - i) (by omega) x) (norm_nonneg _) (by positivity)
      _ = (n.choose i : ℝ) * (Cf * Cg) := by ring
  refine le_trans hstep ?_
  rw [← Finset.sum_mul]
  have hchoose : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = (2 : ℝ) ^ n := by
    rw [← Nat.cast_sum, Nat.sum_range_choose]
    push_cast
    ring
  rw [hchoose]
  refine mul_le_mul_of_nonneg_right (pow_le_pow_right₀ (by norm_num) hn) (by positivity)

theorem norm_iteratedFDeriv_conj {f : V → ℂ} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (n : ℕ) (x : V) :
    ‖iteratedFDeriv ℝ n (fun y => (starRingEnd ℂ) (f y)) x‖ = ‖iteratedFDeriv ℝ n f x‖ :=
  Complex.conjLIE.toLinearIsometry.norm_iteratedFDeriv_comp_left hf.contDiffAt
    (i := n) (by exact_mod_cast le_top)

theorem norm_iteratedFDeriv_ofReal {f : V → ℝ} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (n : ℕ) (x : V) :
    ‖iteratedFDeriv ℝ n (fun y => ((f y : ℝ) : ℂ)) x‖ = ‖iteratedFDeriv ℝ n f x‖ :=
  (RCLike.ofRealLI (K := ℂ)).norm_iteratedFDeriv_comp_left hf.contDiffAt
    (i := n) (by exact_mod_cast le_top)

theorem contDiff_conj {f : V → ℂ} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun y => (starRingEnd ℂ) (f y)) :=
  Complex.conjLIE.toLinearIsometry.toContinuousLinearMap.contDiff.comp hf

theorem contDiff_ofReal {f : V → ℝ} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun y => ((f y : ℝ) : ℂ)) :=
  (RCLike.ofRealLI (K := ℂ)).toContinuousLinearMap.contDiff.comp hf

end DerivBounds

/-! ## Translated bumps -/

section TranslatedBump

/-- The complex-valued translated bump. -/
def cbump (d : ℕ) (p : Fin d → ℤ) (x : EuclideanSpace ℝ (Fin d)) : ℂ :=
  ((bumpD d (x - latt d p) : ℝ) : ℂ)

theorem contDiff_bumpD_translate (d : ℕ) (p : Fin d → ℤ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun y : EuclideanSpace ℝ (Fin d) => bumpD d (y - latt d p)) :=
  (contDiff_bumpD d).comp (contDiff_id.sub contDiff_const)

theorem contDiff_cbump (d : ℕ) (p : Fin d → ℤ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cbump d p) :=
  contDiff_ofReal (contDiff_bumpD_translate d p)

theorem norm_cbump_le_one (d : ℕ) (p : Fin d → ℤ) (x : EuclideanSpace ℝ (Fin d)) :
    ‖cbump d p x‖ ≤ 1 := by
  show ‖((bumpD d (x - latt d p) : ℝ) : ℂ)‖ ≤ 1
  rw [Complex.norm_real, Real.norm_eq_abs]
  exact abs_bumpD_le_one d _

theorem cbump_eq_zero (d : ℕ) (p : Fin d → ℤ) {x : EuclideanSpace ℝ (Fin d)}
    (h : Real.sqrt d < ‖x - latt d p‖) : cbump d p x = 0 := by
  show ((bumpD d (x - latt d p) : ℝ) : ℂ) = 0
  rw [bumpD_eq_zero_of_norm_lt h]
  simp

theorem norm_iteratedFDeriv_cbump_le {d N : ℕ} {Cφ : ℝ}
    (hCφ : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (p : Fin d → ℤ) :
    ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (cbump d p) x‖ ≤ Cφ := by
  intro n hn x
  have h1 : ‖iteratedFDeriv ℝ n (cbump d p) x‖
      = ‖iteratedFDeriv ℝ n (fun y : EuclideanSpace ℝ (Fin d) => bumpD d (y - latt d p)) x‖ :=
    norm_iteratedFDeriv_ofReal (contDiff_bumpD_translate d p) n x
  have h2 : iteratedFDeriv ℝ n (fun y : EuclideanSpace ℝ (Fin d) => bumpD d (y - latt d p)) x
      = iteratedFDeriv ℝ n (bumpD d) (x - latt d p) := by
    have h := iteratedFDeriv_comp_add_right (𝕜 := ℝ) (f := bumpD d) n (-latt d p) x
    simpa [sub_eq_add_neg] using h
  rw [h1, h2]
  exact hCφ n hn (x - latt d p)

end TranslatedBump

/-! ## The oscillatory integral operator and its localizations -/

section CVOp

/-- The Fourier character `t ↦ e ^ (2 π i t)`. -/
def cvChar (t : ℝ) : ℂ := Complex.exp ((2 * Real.pi * t : ℝ) * Complex.I)

@[simp] theorem norm_cvChar (t : ℝ) : ‖cvChar t‖ = 1 := by
  rw [cvChar, Complex.norm_exp]
  simp

theorem cvChar_add (s t : ℝ) : cvChar (s + t) = cvChar s * cvChar t := by
  rw [cvChar, cvChar, cvChar, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem conj_cvChar (t : ℝ) : (starRingEnd ℂ) (cvChar t) = cvChar (-t) := by
  rw [cvChar, cvChar, ← Complex.exp_conj]
  congr 1
  rw [map_mul, Complex.conj_I, Complex.conj_ofReal]
  push_cast
  ring

theorem continuous_cvChar : Continuous cvChar := by
  refine Complex.continuous_exp.comp ?_
  exact (Complex.continuous_ofReal.comp (by continuity)).mul continuous_const

/-- The oscillatory integral against the character identifies with the Fourier transform. -/
theorem integral_cvChar_mul_eq_fourier {V : Type*} [NormedAddCommGroup V]
    [InnerProductSpace ℝ V] [FiniteDimensional ℝ V] [MeasurableSpace V] [BorelSpace V]
    (Ψ : V → ℂ) (ζ : V) :
    (∫ x, cvChar (inner ℝ x ζ) * Ψ x) = 𝓕 Ψ (-ζ) := by
  rw [Real.fourier_eq']
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  simp only [smul_eq_mul]
  congr 2
  rw [inner_neg_right, cvChar]
  push_cast
  ring

/-- The symbol class `S⁰_{0,0}`: all pure derivatives in each variable separately are bounded
by `A`. -/
structure IsCVSymbol (d N : ℕ)
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ) (A : ℝ) : Prop where
  meas : Measurable (Function.uncurry a)
  smoothx : ∀ ξ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fun x => a x ξ)
  smoothξ : ∀ x, ContDiff ℝ (↑(⊤ : ℕ∞)) (fun ξ => a x ξ)
  boundx : ∀ ξ, ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (fun x => a x ξ) x‖ ≤ A
  boundξ : ∀ x, ∀ n ≤ N, ∀ ξ, ‖iteratedFDeriv ℝ n (fun ξ => a x ξ) ξ‖ ≤ A

namespace IsCVSymbol

variable {d N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}

theorem norm_le (ha : IsCVSymbol d N a A) (x ξ : EuclideanSpace ℝ (Fin d)) : ‖a x ξ‖ ≤ A := by
  have h := ha.boundx ξ 0 (Nat.zero_le _) x
  rwa [norm_iteratedFDeriv_zero] at h

theorem nonneg (ha : IsCVSymbol d N a A) : 0 ≤ A :=
  le_trans (norm_nonneg _) (ha.norm_le 0 0)

end IsCVSymbol

/-- The oscillatory integral operator attached to a symbol. -/
def cvOp {d : ℕ} (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ)
    (f : EuclideanSpace ℝ (Fin d) → ℂ) (x : EuclideanSpace ℝ (Fin d)) : ℂ :=
  ∫ ξ, cvChar (inner ℝ x ξ) * a x ξ * f ξ

/-- The kernel of the `(k, l)`-localization of `cvOp a`. -/
def cvK {d : ℕ} (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ)
    (k l : Fin d → ℤ) : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ :=
  fun x ξ => cbump d k x * cbump d l ξ * cvChar (inner ℝ x ξ) * a x ξ

theorem measurable_cvK {d N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    {A : ℝ} (ha : IsCVSymbol d N a A) (k l : Fin d → ℤ) :
    Measurable (Function.uncurry (cvK a k l)) := by
  have h1 : Measurable (fun q : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) =>
      cbump d k q.1) := ((contDiff_cbump d k).continuous.comp continuous_fst).measurable
  have h2 : Measurable (fun q : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) =>
      cbump d l q.2) := ((contDiff_cbump d l).continuous.comp continuous_snd).measurable
  have h3 : Measurable (fun q : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) =>
      cvChar (inner ℝ q.1 q.2)) := by
    refine (continuous_cvChar.comp ?_).measurable
    exact continuous_inner
  exact ((h1.mul h2).mul h3).mul ha.meas

theorem norm_cvK_le {d N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    {A : ℝ} (ha : IsCVSymbol d N a A) (k l : Fin d → ℤ)
    (x ξ : EuclideanSpace ℝ (Fin d)) : ‖cvK a k l x ξ‖ ≤ A := by
  rw [cvK]
  simp only [norm_mul, norm_cvChar, mul_one]
  calc ‖cbump d k x‖ * ‖cbump d l ξ‖ * ‖a x ξ‖
      ≤ 1 * 1 * A := by
        refine mul_le_mul (mul_le_mul (norm_cbump_le_one d k x) (norm_cbump_le_one d l ξ)
          (norm_nonneg _) (by norm_num)) (ha.norm_le x ξ) (norm_nonneg _) (by norm_num)
    _ = A := by ring

theorem cvK_eq_zero_left {d : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    (k l : Fin d → ℤ) {x ξ : EuclideanSpace ℝ (Fin d)}
    (h : Real.sqrt d < ‖x - latt d k‖) : cvK a k l x ξ = 0 := by
  rw [cvK, cbump_eq_zero d k h]
  ring

theorem cvK_eq_zero_right {d : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    (k l : Fin d → ℤ) {x ξ : EuclideanSpace ℝ (Fin d)}
    (h : Real.sqrt d < ‖ξ - latt d l‖) : cvK a k l x ξ = 0 := by
  rw [cvK, cbump_eq_zero d l h]
  ring

theorem isGoodKernel_cvK {d N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    {A : ℝ} (ha : IsCVSymbol d N a A) (k l : Fin d → ℤ) :
    IsGoodKernel (volume : Measure (EuclideanSpace ℝ (Fin d))) (cvK a k l) := by
  refine ⟨measurable_cvK ha k l,
    ⟨ENNReal.ofReal A,
      Metric.closedBall (latt d k) (Real.sqrt d) ∪ Metric.closedBall (latt d l) (Real.sqrt d),
      ENNReal.ofReal_ne_top, ?_, ?_, ?_, ?_⟩⟩
  · exact (Metric.isClosed_closedBall.measurableSet).union
      Metric.isClosed_closedBall.measurableSet
  · refine ne_top_of_le_ne_top ?_ (measure_union_le _ _)
    exact ENNReal.add_ne_top.mpr ⟨measure_closedBall_lt_top.ne, measure_closedBall_lt_top.ne⟩
  · intro x ξ
    rw [← ofReal_norm_eq_enorm]
    exact ENNReal.ofReal_le_ofReal (norm_cvK_le ha k l x ξ)
  · intro x ξ hne
    constructor
    · refine Or.inl ?_
      rw [Metric.mem_closedBall, dist_eq_norm]
      by_contra hx
      exact hne (cvK_eq_zero_left k l (not_le.mp hx))
    · refine Or.inr ?_
      rw [Metric.mem_closedBall, dist_eq_norm]
      by_contra hx
      exact hne (cvK_eq_zero_right k l (not_le.mp hx))

end CVOp

/-! ## The core oscillatory estimate -/

section Osc

variable {d : ℕ}

theorem hasCompactSupport_cbump (d : ℕ) (p : Fin d → ℤ) : HasCompactSupport (cbump d p) := by
  refine HasCompactSupport.intro (isCompact_closedBall (latt d p) (Real.sqrt d)) ?_
  intro x hx
  refine cbump_eq_zero d p ?_
  rw [Metric.mem_closedBall, dist_eq_norm] at hx
  exact not_le.mp hx

/-- The localized product appearing in the two Cotlar--Stein estimates. -/
def cvProd (d : ℕ) (p q : Fin d → ℤ) (u v : EuclideanSpace ℝ (Fin d) → ℂ) :
    EuclideanSpace ℝ (Fin d) → ℂ :=
  fun y => cbump d p y * cbump d q y * u y * v y

theorem contDiff_cvProd {u v : EuclideanSpace ℝ (Fin d) → ℂ}
    (hu : ContDiff ℝ (↑(⊤ : ℕ∞)) u) (hv : ContDiff ℝ (↑(⊤ : ℕ∞)) v) (p q : Fin d → ℤ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cvProd d p q u v) :=
  (((contDiff_cbump d p).mul (contDiff_cbump d q)).mul hu).mul hv

theorem cvProd_eq_zero {u v : EuclideanSpace ℝ (Fin d) → ℂ} (p q : Fin d → ℤ)
    {y : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖y - latt d p‖) :
    cvProd d p q u v y = 0 := by
  show cbump d p y * cbump d q y * u y * v y = 0
  rw [cbump_eq_zero d p h]
  ring

theorem hasCompactSupport_cvProd (u v : EuclideanSpace ℝ (Fin d) → ℂ) (p q : Fin d → ℤ) :
    HasCompactSupport (cvProd d p q u v) := by
  refine HasCompactSupport.intro (isCompact_closedBall (latt d p) (Real.sqrt d)) ?_
  intro x hx
  rw [Metric.mem_closedBall, dist_eq_norm] at hx
  exact cvProd_eq_zero p q (not_le.mp hx)

theorem tsupport_cvProd_subset (u v : EuclideanSpace ℝ (Fin d) → ℂ) (p q : Fin d → ℤ) :
    tsupport (cvProd d p q u v) ⊆ Metric.closedBall (latt d p) (Real.sqrt d) := by
  refine closure_minimal (fun y hy => ?_) Metric.isClosed_closedBall
  rw [Metric.mem_closedBall, dist_eq_norm]
  by_contra hyy
  exact hy (cvProd_eq_zero p q (not_le.mp hyy))

theorem norm_iteratedFDeriv_cvProd_le {N : ℕ} {Cφ A : ℝ}
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ) (hA : 0 ≤ A)
    {u v : EuclideanSpace ℝ (Fin d) → ℂ}
    (hu : ContDiff ℝ (↑(⊤ : ℕ∞)) u) (hv : ContDiff ℝ (↑(⊤ : ℕ∞)) v)
    (hub : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n u x‖ ≤ A)
    (hvb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n v x‖ ≤ A)
    (p q : Fin d → ℤ) :
    ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (cvProd d p q u v) x‖
      ≤ 8 ^ N * (Cφ * Cφ) * (A * A) := by
  have hb1 : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (fun y : EuclideanSpace ℝ (Fin d) =>
      cbump d p y * cbump d q y) x‖ ≤ 2 ^ N * (Cφ * Cφ) :=
    norm_iteratedFDeriv_mul_le' (contDiff_cbump d p) (contDiff_cbump d q) hCφ hCφ
      (norm_iteratedFDeriv_cbump_le hCφb p) (norm_iteratedFDeriv_cbump_le hCφb q)
  have hb2 : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (fun y : EuclideanSpace ℝ (Fin d) =>
      cbump d p y * cbump d q y * u y) x‖ ≤ 2 ^ N * ((2 ^ N * (Cφ * Cφ)) * A) :=
    norm_iteratedFDeriv_mul_le' ((contDiff_cbump d p).mul (contDiff_cbump d q)) hu
      (by positivity) hA hb1 hub
  have hbΨ : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (cvProd d p q u v) x‖
      ≤ 2 ^ N * ((2 ^ N * ((2 ^ N * (Cφ * Cφ)) * A)) * A) :=
    norm_iteratedFDeriv_mul_le' (((contDiff_cbump d p).mul (contDiff_cbump d q)).mul hu) hv
      (by positivity) hA hb2 hvb
  intro n hn x
  refine le_trans (hbΨ n hn x) (le_of_eq ?_)
  rw [show (8 : ℝ) = 2 * 2 * 2 from by norm_num, mul_pow, mul_pow]
  ring

/-- The `L¹` bound for the derivatives of the localized product. -/
theorem integral_norm_iteratedFDeriv_cvProd_le {N : ℕ} {Cφ A : ℝ}
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ) (hA : 0 ≤ A)
    {u v : EuclideanSpace ℝ (Fin d) → ℂ}
    (hu : ContDiff ℝ (↑(⊤ : ℕ∞)) u) (hv : ContDiff ℝ (↑(⊤ : ℕ∞)) v)
    (hub : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n u x‖ ≤ A)
    (hvb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n v x‖ ≤ A)
    (p q : Fin d → ℤ) :
    ∀ n ≤ N, (∫ x, ‖iteratedFDeriv ℝ n (cvProd d p q u v) x‖)
      ≤ (8 ^ N * (Cφ * Cφ) * (A * A)) *
        (volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d))).toReal := by
  intro n hn
  have hbd := norm_iteratedFDeriv_cvProd_le hCφb hCφ hA hu hv hub hvb p q n hn
  have hball : volume (Metric.closedBall (latt d p) (Real.sqrt d))
      = volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d)) :=
    Measure.addHaar_closedBall_center volume _ _
  have hsupp : ∀ x, x ∉ Metric.closedBall (latt d p) (Real.sqrt d) →
      iteratedFDeriv ℝ n (cvProd d p q u v) x = 0 := by
    intro x hx
    have hxn : x ∉ tsupport (iteratedFDeriv ℝ n (cvProd d p q u v)) := fun hc =>
      hx (tsupport_cvProd_subset u v p q (tsupport_iteratedFDeriv_subset n hc))
    by_contra hne
    exact hxn (subset_closure hne)
  have hintg : Integrable (iteratedFDeriv ℝ n (cvProd d p q u v)) := by
    refine Continuous.integrable_of_hasCompactSupport ?_
      ((hasCompactSupport_cvProd u v p q).iteratedFDeriv n)
    exact (contDiff_cvProd hu hv p q).continuous_iteratedFDeriv (by exact_mod_cast le_top)
  have h := integral_norm_le_of_support hintg (Metric.isClosed_closedBall.measurableSet)
    measure_closedBall_lt_top.ne (by positivity) hbd hsupp
  rwa [hball] at h

/-- The core oscillatory estimate: the Fourier transform of the localized product decays. -/
theorem osc_estimate {N : ℕ} {Cφ A : ℝ}
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ) (hA : 0 ≤ A)
    {u v : EuclideanSpace ℝ (Fin d) → ℂ}
    (hu : ContDiff ℝ (↑(⊤ : ℕ∞)) u) (hv : ContDiff ℝ (↑(⊤ : ℕ∞)) v)
    (hub : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n u x‖ ≤ A)
    (hvb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n v x‖ ≤ A)
    (p q : Fin d → ℤ) (ζ : EuclideanSpace ℝ (Fin d)) :
    (1 + ‖ζ‖) ^ N * ‖∫ x, cvChar (inner ℝ x ζ) * cvProd d p q u v x‖
      ≤ 4 ^ N * ((N : ℝ) + 1) * ((8 ^ N * (Cφ * Cφ) * (A * A)) *
          (volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d))).toReal) := by
  have hint := integral_norm_iteratedFDeriv_cvProd_le hCφb hCφ hA hu hv hub hvb p q
  have heq : (∫ x, cvChar (inner ℝ x ζ) * cvProd d p q u v x) = 𝓕 (cvProd d p q u v) (-ζ) :=
    integral_cvChar_mul_eq_fourier _ ζ
  rw [heq]
  have hdecay := one_add_pow_mul_norm_fourier_le (N := N) (contDiff_cvProd hu hv p q)
    (hasCompactSupport_cvProd u v p q) hint (-ζ)
  rwa [norm_neg] at hdecay

end Osc

/-! ## The two Cotlar--Stein conditions -/

section Conditions

variable {d : ℕ}

theorem mul_mul_le_of_le_one {x y z : ℝ} (hx0 : 0 ≤ x) (hx : x ≤ 1) (hy0 : 0 ≤ y) (hy : y ≤ 1)
    (hz : 0 ≤ z) : x * y * z ≤ z := by
  have hxy : x * y ≤ 1 := by nlinarith
  have h := mul_le_mul_of_nonneg_right hxy hz
  linarith [h]

theorem conj_cbump (d : ℕ) (p : Fin d → ℤ) (x : EuclideanSpace ℝ (Fin d)) :
    (starRingEnd ℂ) (cbump d p x) = cbump d p x := by
  show (starRingEnd ℂ) ((bumpD d (x - latt d p) : ℝ) : ℂ) = ((bumpD d (x - latt d p) : ℝ) : ℂ)
  exact Complex.conj_ofReal _

theorem latt_sub (d : ℕ) (k k' : Fin d → ℤ) : latt d k - latt d k' = latt d (k - k') := by
  refine PiLp.ext (fun i => ?_)
  rw [PiLp.sub_apply, latt_apply, latt_apply, latt_apply, Pi.sub_apply]
  push_cast
  ring

theorem cvProd_eq_zero' {u v : EuclideanSpace ℝ (Fin d) → ℂ} (p q : Fin d → ℤ)
    {y : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖y - latt d q‖) :
    cvProd d p q u v y = 0 := by
  show cbump d p y * cbump d q y * u y * v y = 0
  rw [cbump_eq_zero d q h]
  ring

/-- If the two bump centres are far apart, the localized product vanishes identically. -/
theorem cvProd_eq_zero_of_far {u v : EuclideanSpace ℝ (Fin d) → ℂ} (p q : Fin d → ℤ)
    (h : 2 * Real.sqrt d < ‖latt d (p - q)‖) (y : EuclideanSpace ℝ (Fin d)) :
    cvProd d p q u v y = 0 := by
  by_cases hy : Real.sqrt d < ‖y - latt d p‖
  · exact cvProd_eq_zero p q hy
  · refine cvProd_eq_zero' p q ?_
    by_contra hy'
    push_neg at hy hy'
    have htri : ‖latt d (p - q)‖ ≤ ‖y - latt d p‖ + ‖y - latt d q‖ := by
      rw [← latt_sub]
      calc ‖latt d p - latt d q‖ = ‖-(y - latt d p) + (y - latt d q)‖ := by
            congr 1
            abel
        _ ≤ ‖-(y - latt d p)‖ + ‖y - latt d q‖ := norm_add_le _ _
        _ = ‖y - latt d p‖ + ‖y - latt d q‖ := by rw [norm_neg]
    linarith

/-- The composed kernel appearing in the first Cotlar--Stein condition. -/
theorem compKernel_adj_cvK {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    {A : ℝ} (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    (ξ ξ' : EuclideanSpace ℝ (Fin d)) :
    compKernel volume (adjKernel (cvK a k l)) (cvK a k' l') ξ ξ'
      = cbump d l ξ * cbump d l' ξ' *
        ∫ x, cvChar (inner ℝ x (ξ' - ξ)) *
          cvProd d k k' (fun y => (starRingEnd ℂ) (a y ξ)) (fun y => a y ξ') x := by
  rw [compKernel, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  show (starRingEnd ℂ) (cvK a k l x ξ) * cvK a k' l' x ξ'
      = cbump d l ξ * cbump d l' ξ' *
        (cvChar (inner ℝ x (ξ' - ξ)) *
          (cbump d k x * cbump d k' x * (starRingEnd ℂ) (a x ξ) * a x ξ'))
  rw [cvK, cvK]
  simp only [map_mul, conj_cbump, conj_cvChar]
  rw [inner_sub_right, show (inner ℝ x ξ' - inner ℝ x ξ : ℝ) = inner ℝ x ξ' + -(inner ℝ x ξ) from
    by ring, cvChar_add]
  ring

theorem norm_compKernel_adj_cvK_le
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A Cφ : ℝ}
    (ha : IsCVSymbol d N a A) (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ)
    (hCφ : 0 ≤ Cφ) (k l k' l' : Fin d → ℤ) (ξ ξ' : EuclideanSpace ℝ (Fin d)) :
    (1 + ‖ξ - ξ'‖) ^ N * ‖compKernel volume (adjKernel (cvK a k l)) (cvK a k' l') ξ ξ'‖
      ≤ 4 ^ N * ((N : ℝ) + 1) * ((8 ^ N * (Cφ * Cφ) * (A * A)) *
          (volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d))).toReal) := by
  rw [compKernel_adj_cvK ha k l k' l' ξ ξ']
  have hosc := osc_estimate (d := d) hCφb hCφ ha.nonneg
    (u := fun y => (starRingEnd ℂ) (a y ξ)) (v := fun y => a y ξ')
    (contDiff_conj (ha.smoothx ξ)) (ha.smoothx ξ')
    (fun n hn x => by
      rw [norm_iteratedFDeriv_conj (ha.smoothx ξ) n x]
      exact ha.boundx ξ n hn x)
    (fun n hn x => ha.boundx ξ' n hn x) k k' (ξ' - ξ)
  have hnormeq : ‖ξ' - ξ‖ = ‖ξ - ξ'‖ := by rw [← norm_neg]; congr 1; abel
  rw [hnormeq] at hosc
  refine le_trans ?_ hosc
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [norm_mul, norm_mul]
  exact mul_mul_le_of_le_one (norm_nonneg _) (norm_cbump_le_one d l ξ)
    (norm_nonneg _) (norm_cbump_le_one d l' ξ') (norm_nonneg _)

theorem compKernel_adj_cvK_eq_zero_left
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    {ξ ξ' : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖ξ - latt d l‖) :
    compKernel volume (adjKernel (cvK a k l)) (cvK a k' l') ξ ξ' = 0 := by
  rw [compKernel_adj_cvK ha k l k' l' ξ ξ', cbump_eq_zero d l h]
  ring

theorem compKernel_adj_cvK_eq_zero_right
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    {ξ ξ' : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖ξ' - latt d l'‖) :
    compKernel volume (adjKernel (cvK a k l)) (cvK a k' l') ξ ξ' = 0 := by
  rw [compKernel_adj_cvK ha k l k' l' ξ ξ', cbump_eq_zero d l' h]
  ring

theorem compKernel_adj_cvK_eq_zero_far
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    (h : 2 * Real.sqrt d < ‖latt d (k - k')‖) (ξ ξ' : EuclideanSpace ℝ (Fin d)) :
    compKernel volume (adjKernel (cvK a k l)) (cvK a k' l') ξ ξ' = 0 := by
  rw [compKernel_adj_cvK ha k l k' l' ξ ξ']
  have hz : ∀ x, cvChar (inner ℝ x (ξ' - ξ)) *
      cvProd d k k' (fun y => (starRingEnd ℂ) (a y ξ)) (fun y => a y ξ') x = 0 := by
    intro x
    rw [cvProd_eq_zero_of_far k k' h x]
    ring
  simp only [hz, integral_zero, mul_zero]

/-- The composed kernel appearing in the second Cotlar--Stein condition. -/
theorem compKernel_cvK_adj {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    {A : ℝ} (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    (x x' : EuclideanSpace ℝ (Fin d)) :
    compKernel volume (cvK a k l) (adjKernel (cvK a k' l')) x x'
      = cbump d k x * cbump d k' x' *
        ∫ ξ, cvChar (inner ℝ ξ (x - x')) *
          cvProd d l l' (fun η => a x η) (fun η => (starRingEnd ℂ) (a x' η)) ξ := by
  rw [compKernel, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  show cvK a k l x ξ * (starRingEnd ℂ) (cvK a k' l' x' ξ)
      = cbump d k x * cbump d k' x' *
        (cvChar (inner ℝ ξ (x - x')) *
          (cbump d l ξ * cbump d l' ξ * a x ξ * (starRingEnd ℂ) (a x' ξ)))
  rw [cvK, cvK]
  simp only [map_mul, conj_cbump, conj_cvChar]
  have hinn : (inner ℝ ξ (x - x') : ℝ) = inner ℝ x ξ + -(inner ℝ x' ξ) := by
    have h1 : (inner ℝ ξ (x - x') : ℝ) = inner ℝ (x - x') ξ := real_inner_comm _ _
    rw [h1, inner_sub_left]
    ring
  rw [hinn, cvChar_add]
  ring

theorem norm_compKernel_cvK_adj_le
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A Cφ : ℝ}
    (ha : IsCVSymbol d N a A) (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ)
    (hCφ : 0 ≤ Cφ) (k l k' l' : Fin d → ℤ) (x x' : EuclideanSpace ℝ (Fin d)) :
    (1 + ‖x - x'‖) ^ N * ‖compKernel volume (cvK a k l) (adjKernel (cvK a k' l')) x x'‖
      ≤ 4 ^ N * ((N : ℝ) + 1) * ((8 ^ N * (Cφ * Cφ) * (A * A)) *
          (volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d))).toReal) := by
  rw [compKernel_cvK_adj ha k l k' l' x x']
  have hosc := osc_estimate (d := d) hCφb hCφ ha.nonneg
    (u := fun η => a x η) (v := fun η => (starRingEnd ℂ) (a x' η))
    (ha.smoothξ x) (contDiff_conj (ha.smoothξ x'))
    (fun n hn ξ => ha.boundξ x n hn ξ)
    (fun n hn ξ => by
      rw [norm_iteratedFDeriv_conj (ha.smoothξ x') n ξ]
      exact ha.boundξ x' n hn ξ) l l' (x - x')
  refine le_trans ?_ hosc
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  rw [norm_mul, norm_mul]
  exact mul_mul_le_of_le_one (norm_nonneg _) (norm_cbump_le_one d k x)
    (norm_nonneg _) (norm_cbump_le_one d k' x') (norm_nonneg _)

theorem compKernel_cvK_adj_eq_zero_left
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    {x x' : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖x - latt d k‖) :
    compKernel volume (cvK a k l) (adjKernel (cvK a k' l')) x x' = 0 := by
  rw [compKernel_cvK_adj ha k l k' l' x x', cbump_eq_zero d k h]
  ring

theorem compKernel_cvK_adj_eq_zero_right
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    {x x' : EuclideanSpace ℝ (Fin d)} (h : Real.sqrt d < ‖x' - latt d k'‖) :
    compKernel volume (cvK a k l) (adjKernel (cvK a k' l')) x x' = 0 := by
  rw [compKernel_cvK_adj ha k l k' l' x x', cbump_eq_zero d k' h]
  ring

theorem compKernel_cvK_adj_eq_zero_far
    {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A : ℝ}
    (ha : IsCVSymbol d N a A) (k l k' l' : Fin d → ℤ)
    (h : 2 * Real.sqrt d < ‖latt d (l - l')‖) (x x' : EuclideanSpace ℝ (Fin d)) :
    compKernel volume (cvK a k l) (adjKernel (cvK a k' l')) x x' = 0 := by
  rw [compKernel_cvK_adj ha k l k' l' x x']
  have hz : ∀ ξ, cvChar (inner ℝ ξ (x - x')) *
      cvProd d l l' (fun η => a x η) (fun η => (starRingEnd ℂ) (a x' η)) ξ = 0 := by
    intro ξ
    rw [cvProd_eq_zero_of_far l l' h ξ]
    ring
  simp only [hz, integral_zero, mul_zero]

end Conditions

/-! ## Schur bounds for the composed kernels -/

section Assembly

variable {d N : ℕ}

/-- The measure of the reference ball. -/
def volBallE (d : ℕ) : ℝ≥0∞ :=
  volume (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (Real.sqrt d))

theorem volBallE_ne_top (d : ℕ) : volBallE d ≠ ⊤ := measure_closedBall_lt_top.ne

/-- The oscillatory constant. -/
def cvD (d N : ℕ) (Cφ A : ℝ) : ℝ :=
  4 ^ N * ((N : ℝ) + 1) * ((8 ^ N * (Cφ * Cφ) * (A * A)) * (volBallE d).toReal)

theorem cvD_nonneg (d N : ℕ) (Cφ A : ℝ) : 0 ≤ cvD d N Cφ A := by
  rw [cvD]
  have h1 : (0 : ℝ) ≤ (volBallE d).toReal := ENNReal.toReal_nonneg
  have h2 : (0 : ℝ) ≤ 8 ^ N * (Cφ * Cφ) * (A * A) :=
    mul_nonneg (mul_nonneg (by positivity) (mul_self_nonneg Cφ)) (mul_self_nonneg A)
  have h3 : (0 : ℝ) ≤ 4 ^ N * ((N : ℝ) + 1) := by positivity
  exact mul_nonneg h3 (mul_nonneg h2 h1)

/-- The lattice decay factor with the shift built in. -/
def cvRho (d N : ℕ) (m : Fin d → ℤ) : ℝ :=
  ((1 + max 0 (‖latt d m‖ - 2 * Real.sqrt d)) ^ N)⁻¹

theorem cvRho_pos (d N : ℕ) (m : Fin d → ℤ) : 0 < cvRho d N m := by
  rw [cvRho]
  refine inv_pos.mpr (pow_pos ?_ N)
  have : (0 : ℝ) ≤ max 0 (‖latt d m‖ - 2 * Real.sqrt d) := le_max_left _ _
  linarith

/-- The inverse power weight on the lattice. -/
def cvInvPow (d N : ℕ) (m : Fin d → ℤ) : ℝ := ((1 + ‖latt d m‖) ^ N)⁻¹

theorem cvInvPow_pos (d N : ℕ) (m : Fin d → ℤ) : 0 < cvInvPow d N m := by
  rw [cvInvPow]
  exact inv_pos.mpr (pow_pos (by positivity) N)

theorem cvRho_le_cvInvPow (d N : ℕ) (m : Fin d → ℤ) :
    cvRho d N m ≤ (1 + 2 * Real.sqrt d) ^ N * cvInvPow d N m := by
  rw [cvRho, cvInvPow]
  set t : ℝ := ‖latt d m‖ with ht
  set c : ℝ := 2 * Real.sqrt d with hc
  have ht0 : 0 ≤ t := norm_nonneg _
  have hc0 : 0 ≤ c := by rw [hc]; positivity
  have hkey : (1 + t) ≤ (1 + c) * (1 + max 0 (t - c)) := by
    rcases le_total t c with h | h
    · rw [max_eq_left (by linarith)]
      nlinarith
    · rw [max_eq_right (by linarith)]
      nlinarith
  have hpow : (1 + t) ^ N ≤ ((1 + c) * (1 + max 0 (t - c))) ^ N :=
    pow_le_pow_left₀ (by linarith) hkey N
  rw [mul_pow] at hpow
  have hpos1 : (0 : ℝ) < (1 + max 0 (t - c)) ^ N := by
    refine pow_pos ?_ N
    have : (0 : ℝ) ≤ max 0 (t - c) := le_max_left _ _
    linarith
  have hpos2 : (0 : ℝ) < (1 + t) ^ N := pow_pos (by linarith) N
  rw [inv_eq_one_div, inv_eq_one_div, mul_one_div, div_le_div_iff₀ hpos1 hpos2, one_mul]
  exact hpow

/-- Schur bounds for a kernel with lattice-localized support and isotropic decay. -/
theorem schur_of_decay {K : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {D : ℝ}
    (hD : 0 ≤ D) (r r' : Fin d → ℤ)
    (h1 : ∀ p q, (1 + ‖p - q‖) ^ N * ‖K p q‖ ≤ D)
    (h2 : ∀ p q, Real.sqrt d < ‖p - latt d r‖ → K p q = 0)
    (h3 : ∀ p q, Real.sqrt d < ‖q - latt d r'‖ → K p q = 0) :
    (∀ p, (∫⁻ q, ‖K p q‖ₑ) ≤ ENNReal.ofReal (D * cvRho d N (r - r')) * volBallE d) ∧
      (∀ q, (∫⁻ p, ‖K p q‖ₑ) ≤ ENNReal.ofReal (D * cvRho d N (r - r')) * volBallE d) := by
  have hkey : ∀ p q, Real.sqrt d < ‖p - latt d r‖ ∨ Real.sqrt d < ‖q - latt d r'‖ ∨
      ‖K p q‖ ≤ D * cvRho d N (r - r') := by
    intro p q
    by_cases hp : Real.sqrt d < ‖p - latt d r‖
    · exact Or.inl hp
    by_cases hq : Real.sqrt d < ‖q - latt d r'‖
    · exact Or.inr (Or.inl hq)
    push_neg at hp hq
    refine Or.inr (Or.inr ?_)
    have hsep : ‖latt d (r - r')‖ - 2 * Real.sqrt d ≤ ‖p - q‖ := by
      have htri : ‖latt d (r - r')‖ ≤ ‖p - latt d r‖ + ‖p - q‖ + ‖q - latt d r'‖ := by
        rw [← latt_sub]
        calc ‖latt d r - latt d r'‖
            = ‖-(p - latt d r) + (p - q) + (q - latt d r')‖ := by
              congr 1
              abel
          _ ≤ ‖-(p - latt d r) + (p - q)‖ + ‖q - latt d r'‖ := norm_add_le _ _
          _ ≤ ‖-(p - latt d r)‖ + ‖p - q‖ + ‖q - latt d r'‖ := by
              have := norm_add_le (-(p - latt d r)) (p - q)
              linarith
          _ = ‖p - latt d r‖ + ‖p - q‖ + ‖q - latt d r'‖ := by rw [norm_neg]
      linarith
    have hlow : (1 + max 0 (‖latt d (r - r')‖ - 2 * Real.sqrt d)) ≤ 1 + ‖p - q‖ := by
      rcases le_total (‖latt d (r - r')‖ - 2 * Real.sqrt d) 0 with h | h
      · rw [max_eq_left h]
        linarith [norm_nonneg (p - q)]
      · rw [max_eq_right h]
        linarith
    have hpospow : (0 : ℝ) < (1 + max 0 (‖latt d (r - r')‖ - 2 * Real.sqrt d)) ^ N := by
      refine pow_pos ?_ N
      have : (0 : ℝ) ≤ max 0 (‖latt d (r - r')‖ - 2 * Real.sqrt d) := le_max_left _ _
      linarith
    have hstep : (1 + max 0 (‖latt d (r - r')‖ - 2 * Real.sqrt d)) ^ N * ‖K p q‖ ≤ D := by
      refine le_trans ?_ (h1 p q)
      refine mul_le_mul_of_nonneg_right (pow_le_pow_left₀ ?_ hlow N) (norm_nonneg _)
      have : (0 : ℝ) ≤ max 0 (‖latt d (r - r')‖ - 2 * Real.sqrt d) := le_max_left _ _
      linarith
    rw [cvRho, mul_comm D, ← div_eq_inv_mul, le_div_iff₀ hpospow, mul_comm]
    exact hstep
  constructor
  · intro p
    have hle : ∀ q, ‖K p q‖ₑ ≤ (Metric.closedBall (latt d r') (Real.sqrt d)).indicator
        (fun _ => ENNReal.ofReal (D * cvRho d N (r - r'))) q := by
      intro q
      by_cases hq : q ∈ Metric.closedBall (latt d r') (Real.sqrt d)
      · rw [Set.indicator_of_mem hq, ← ofReal_norm_eq_enorm]
        rcases hkey p q with hc | hc | hc
        · rw [h2 p q hc]
          simp
        · rw [Metric.mem_closedBall, dist_eq_norm] at hq
          exact absurd hq (not_le.mpr hc)
        · exact ENNReal.ofReal_le_ofReal hc
      · rw [Metric.mem_closedBall, dist_eq_norm] at hq
        rw [h3 p q (not_le.mp hq)]
        simp
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet]
    rw [show volume (Metric.closedBall (latt d r') (Real.sqrt d)) = volBallE d from
      Measure.addHaar_closedBall_center volume _ _]
  · intro q
    have hle : ∀ p, ‖K p q‖ₑ ≤ (Metric.closedBall (latt d r) (Real.sqrt d)).indicator
        (fun _ => ENNReal.ofReal (D * cvRho d N (r - r'))) p := by
      intro p
      by_cases hp : p ∈ Metric.closedBall (latt d r) (Real.sqrt d)
      · rw [Set.indicator_of_mem hp, ← ofReal_norm_eq_enorm]
        rcases hkey p q with hc | hc | hc
        · rw [Metric.mem_closedBall, dist_eq_norm] at hp
          exact absurd hp (not_le.mpr hc)
        · rw [h3 p q hc]
          simp
        · exact ENNReal.ofReal_le_ofReal hc
      · rw [Metric.mem_closedBall, dist_eq_norm] at hp
        rw [h2 p q (not_le.mp hp)]
        simp
    refine le_trans (lintegral_mono hle) ?_
    rw [lintegral_indicator_const Metric.isClosed_closedBall.measurableSet]
    rw [show volume (Metric.closedBall (latt d r) (Real.sqrt d)) = volBallE d from
      Measure.addHaar_closedBall_center volume _ _]

end Assembly

attribute [irreducible] goodCLM

/-! ## The Cotlar--Stein bound for the localized pieces -/

section CotlarSteinStep

variable {d N : ℕ}

/-- The Cotlar--Stein entry bound. -/
def cvQ (d N : ℕ) (Cφ A : ℝ) : ℝ :=
  cvD d N Cφ A * (volBallE d).toReal *
    ((1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N)

theorem cvQ_nonneg (d N : ℕ) (Cφ A : ℝ) : 0 ≤ cvQ d N Cφ A := by
  rw [cvQ]
  have h1 : (0 : ℝ) ≤ (volBallE d).toReal := ENNReal.toReal_nonneg
  have h2 : (0 : ℝ) ≤ (1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N := by positivity
  exact mul_nonneg (mul_nonneg (cvD_nonneg d N Cφ A) h1) h2

theorem norm_goodCLM_le_zero {K : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    (hgood : IsGoodKernel volume K) (hK : ∀ x y, K x y = 0) :
    ‖goodCLM volume K hgood‖ ≤ 0 := by
  have h := norm_goodCLM_le volume K hgood (C := 0) (by norm_num)
    (fun x => by simp [hK]) (fun y => by simp [hK])
  simpa using h

/-- The operator norm bound coming from the Schur test together with the lattice separation. -/
theorem norm_goodCLM_le_of_data
    {K : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ}
    (hgood : IsGoodKernel volume K) {D : ℝ} (hD : 0 ≤ D)
    (r r' m m' : Fin d → ℤ)
    (h1 : ∀ p q, (1 + ‖p - q‖) ^ N * ‖K p q‖ ≤ D)
    (h2 : ∀ p q, Real.sqrt d < ‖p - latt d r‖ → K p q = 0)
    (h3 : ∀ p q, Real.sqrt d < ‖q - latt d r'‖ → K p q = 0)
    (h4 : 2 * Real.sqrt d < ‖latt d (m - m')‖ → ∀ p q, K p q = 0) :
    ‖goodCLM volume K hgood‖
      ≤ (D * (volBallE d).toReal *
          ((1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N))
        * cvInvPow d N (m - m') * cvInvPow d N (r - r') := by
  have hvol : (0 : ℝ) ≤ (volBallE d).toReal := ENNReal.toReal_nonneg
  have hRHSnn : (0 : ℝ) ≤ (D * (volBallE d).toReal *
      ((1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N))
        * cvInvPow d N (m - m') * cvInvPow d N (r - r') := by
    have hp : (0 : ℝ) ≤ (1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N := by positivity
    exact mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hD hvol) hp)
      (cvInvPow_pos d N _).le) (cvInvPow_pos d N _).le
  by_cases hfar : 2 * Real.sqrt d < ‖latt d (m - m')‖
  · exact le_trans (norm_goodCLM_le_zero hgood (h4 hfar)) hRHSnn
  push_neg at hfar
  obtain ⟨hrow, hcol⟩ := schur_of_decay (N := N) hD r r' h1 h2 h3
  have hCne : ENNReal.ofReal (D * cvRho d N (r - r')) * volBallE d ≠ ⊤ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (volBallE_ne_top d)
  have hbound := norm_goodCLM_le volume K hgood hCne hrow hcol
  have htoReal : (ENNReal.ofReal (D * cvRho d N (r - r')) * volBallE d).toReal
      = D * cvRho d N (r - r') * (volBallE d).toReal := by
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal
      (mul_nonneg hD (cvRho_pos d N _).le)]
  rw [htoReal] at hbound
  refine le_trans hbound ?_
  -- `1 ≤ (1 + 2 √d) ^ N * cvInvPow d N (m - m')`
  have hone : (1 : ℝ) ≤ (1 + 2 * Real.sqrt d) ^ N * cvInvPow d N (m - m') := by
    rw [cvInvPow]
    have hpos : (0 : ℝ) < (1 + ‖latt d (m - m')‖) ^ N :=
      pow_pos (by positivity) N
    rw [inv_eq_one_div, mul_one_div, le_div_iff₀ hpos, one_mul]
    exact pow_le_pow_left₀ (by positivity) (by linarith) N
  have hrho := cvRho_le_cvInvPow d N (r - r')
  have hDvol : (0 : ℝ) ≤ D * (volBallE d).toReal := mul_nonneg hD hvol
  calc D * cvRho d N (r - r') * (volBallE d).toReal
      = (D * (volBallE d).toReal) * cvRho d N (r - r') := by ring
    _ ≤ (D * (volBallE d).toReal) * ((1 + 2 * Real.sqrt d) ^ N * cvInvPow d N (r - r')) :=
        mul_le_mul_of_nonneg_left hrho hDvol
    _ ≤ (D * (volBallE d).toReal) * ((1 + 2 * Real.sqrt d) ^ N * cvInvPow d N (r - r')) *
        ((1 + 2 * Real.sqrt d) ^ N * cvInvPow d N (m - m')) := by
        refine le_mul_of_one_le_right ?_ hone
        refine mul_nonneg hDvol (mul_nonneg (by positivity) (cvInvPow_pos d N _).le)
    _ = (D * (volBallE d).toReal *
          ((1 + 2 * Real.sqrt d) ^ N * (1 + 2 * Real.sqrt d) ^ N))
        * cvInvPow d N (m - m') * cvInvPow d N (r - r') := by ring

variable {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A Cφ : ℝ}

/-- The `(k, l)`-localized piece of the operator. -/
def cvT (ha : IsCVSymbol d N a A) (k l : Fin d → ℤ) :
    Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin d))) →L[ℂ]
      Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin d))) :=
  goodCLM volume (cvK a k l) (isGoodKernel_cvK ha k l)

theorem norm_adjoint_comp_cvT_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (k l k' l' : Fin d → ℤ) :
    ‖ContinuousLinearMap.adjoint (cvT ha k l) ∘L cvT ha k' l'‖
      ≤ cvQ d N Cφ A * cvInvPow d N (k - k') * cvInvPow d N (l - l') := by
  rw [cvT, cvT, adjoint_goodCLM, goodCLM_comp]
  exact norm_goodCLM_le_of_data _ (cvD_nonneg d N Cφ A) l l' k k'
    (norm_compKernel_adj_cvK_le ha hCφb hCφ k l k' l')
    (fun p q h => compKernel_adj_cvK_eq_zero_left ha k l k' l' h)
    (fun p q h => compKernel_adj_cvK_eq_zero_right ha k l k' l' h)
    (fun h p q => compKernel_adj_cvK_eq_zero_far ha k l k' l' h p q)

theorem norm_comp_adjoint_cvT_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (k l k' l' : Fin d → ℤ) :
    ‖cvT ha k l ∘L ContinuousLinearMap.adjoint (cvT ha k' l')‖
      ≤ cvQ d N Cφ A * cvInvPow d N (l - l') * cvInvPow d N (k - k') := by
  rw [cvT, cvT, adjoint_goodCLM, goodCLM_comp]
  exact norm_goodCLM_le_of_data _ (cvD_nonneg d N Cφ A) k k' l l'
    (norm_compKernel_cvK_adj_le ha hCφb hCφ k l k' l')
    (fun p q h => compKernel_cvK_adj_eq_zero_left ha k l k' l' h)
    (fun p q h => compKernel_cvK_adj_eq_zero_right ha k l k' l' h)
    (fun h p q => compKernel_cvK_adj_eq_zero_far ha k l k' l' h p q)

end CotlarSteinStep

/-! ## The Calderón--Vaillancourt theorem -/

section Main

variable {d N : ℕ}

theorem sqrt_cvInvPow (d n : ℕ) (m : Fin d → ℤ) :
    Real.sqrt (cvInvPow d (2 * n) m) = cvInvPow d n m := by
  rw [cvInvPow, cvInvPow]
  have h : ((1 : ℝ) + ‖latt d m‖) ^ (2 * n) = (((1 : ℝ) + ‖latt d m‖) ^ n) ^ 2 := by
    rw [← pow_mul, mul_comm]
  rw [h, ← inv_pow, Real.sqrt_sq (by positivity)]

theorem sum_shift_cvInvPow_le (d : ℕ) (k : Fin d → ℤ) (t : Finset (Fin d → ℤ)) :
    ∑ k' ∈ t, cvInvPow d (2 * d) (k - k') ≤ 3 ^ d := by
  classical
  have hinj : ∀ x ∈ t, ∀ y ∈ t, k - x = k - y → x = y := by
    intro x _ y _ h
    have := congrArg (fun z => k - z) h
    simpa using h
  rw [← Finset.sum_image hinj]
  simp only [cvInvPow]
  exact sum_lattice_inv_pow_le d _

variable {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A Cφ : ℝ}

theorem sum_sqrt_norm_adjoint_comp_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (hN : N = 2 * (2 * d)) (s : Finset ((Fin d → ℤ) × (Fin d → ℤ)))
    (p : (Fin d → ℤ) × (Fin d → ℤ)) :
    ∑ p' ∈ s, Real.sqrt ‖ContinuousLinearMap.adjoint (cvT ha p.1 p.2) ∘L cvT ha p'.1 p'.2‖
      ≤ Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) := by
  classical
  have hterm : ∀ p' ∈ s,
      Real.sqrt ‖ContinuousLinearMap.adjoint (cvT ha p.1 p.2) ∘L cvT ha p'.1 p'.2‖
        ≤ Real.sqrt (cvQ d N Cφ A) *
          (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2)) := by
    intro p' _
    refine le_trans (Real.sqrt_le_sqrt (norm_adjoint_comp_cvT_le ha hCφb hCφ p.1 p.2 p'.1 p'.2))
      (le_of_eq ?_)
    rw [Real.sqrt_mul (mul_nonneg (cvQ_nonneg d N Cφ A) (cvInvPow_pos d N _).le),
      Real.sqrt_mul (cvQ_nonneg d N Cφ A)]
    subst hN
    rw [sqrt_cvInvPow, sqrt_cvInvPow]
    ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.mul_sum]
  refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
  have hsub : s ⊆ (s.image Prod.fst) ×ˢ (s.image Prod.snd) := by
    intro p' hp'
    rw [Finset.mem_product]
    exact ⟨Finset.mem_image_of_mem _ hp', Finset.mem_image_of_mem _ hp'⟩
  calc ∑ p' ∈ s, (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2))
      ≤ ∑ p' ∈ (s.image Prod.fst) ×ˢ (s.image Prod.snd),
          (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2)) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ =>
          mul_nonneg (cvInvPow_pos d _ _).le (cvInvPow_pos d _ _).le)
    _ = (∑ k' ∈ s.image Prod.fst, cvInvPow d (2 * d) (p.1 - k')) *
        (∑ l' ∈ s.image Prod.snd, cvInvPow d (2 * d) (p.2 - l')) := by
        rw [Finset.sum_product, Finset.sum_mul_sum]
    _ ≤ (3 : ℝ) ^ d * (3 : ℝ) ^ d :=
        mul_le_mul (sum_shift_cvInvPow_le d _ _) (sum_shift_cvInvPow_le d _ _)
          (Finset.sum_nonneg fun _ _ => (cvInvPow_pos d _ _).le) (by positivity)

theorem sum_sqrt_norm_comp_adjoint_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (hN : N = 2 * (2 * d)) (s : Finset ((Fin d → ℤ) × (Fin d → ℤ)))
    (p : (Fin d → ℤ) × (Fin d → ℤ)) :
    ∑ p' ∈ s, Real.sqrt ‖cvT ha p.1 p.2 ∘L ContinuousLinearMap.adjoint (cvT ha p'.1 p'.2)‖
      ≤ Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) := by
  classical
  have hterm : ∀ p' ∈ s,
      Real.sqrt ‖cvT ha p.1 p.2 ∘L ContinuousLinearMap.adjoint (cvT ha p'.1 p'.2)‖
        ≤ Real.sqrt (cvQ d N Cφ A) *
          (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2)) := by
    intro p' _
    refine le_trans (Real.sqrt_le_sqrt (norm_comp_adjoint_cvT_le ha hCφb hCφ p.1 p.2 p'.1 p'.2))
      (le_of_eq ?_)
    rw [Real.sqrt_mul (mul_nonneg (cvQ_nonneg d N Cφ A) (cvInvPow_pos d N _).le),
      Real.sqrt_mul (cvQ_nonneg d N Cφ A)]
    subst hN
    rw [sqrt_cvInvPow, sqrt_cvInvPow]
    ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.mul_sum]
  refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
  have hsub : s ⊆ (s.image Prod.fst) ×ˢ (s.image Prod.snd) := by
    intro p' hp'
    rw [Finset.mem_product]
    exact ⟨Finset.mem_image_of_mem _ hp', Finset.mem_image_of_mem _ hp'⟩
  calc ∑ p' ∈ s, (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2))
      ≤ ∑ p' ∈ (s.image Prod.fst) ×ˢ (s.image Prod.snd),
          (cvInvPow d (2 * d) (p.1 - p'.1) * cvInvPow d (2 * d) (p.2 - p'.2)) :=
        Finset.sum_le_sum_of_subset_of_nonneg hsub (fun _ _ _ =>
          mul_nonneg (cvInvPow_pos d _ _).le (cvInvPow_pos d _ _).le)
    _ = (∑ k' ∈ s.image Prod.fst, cvInvPow d (2 * d) (p.1 - k')) *
        (∑ l' ∈ s.image Prod.snd, cvInvPow d (2 * d) (p.2 - l')) := by
        rw [Finset.sum_product, Finset.sum_mul_sum]
    _ ≤ (3 : ℝ) ^ d * (3 : ℝ) ^ d :=
        mul_le_mul (sum_shift_cvInvPow_le d _ _) (sum_shift_cvInvPow_le d _ _)
          (Finset.sum_nonneg fun _ _ => (cvInvPow_pos d _ _).le) (by positivity)

set_option maxHeartbeats 1000000 in
theorem norm_sum_cvT_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (hN : N = 2 * (2 * d)) (s : Finset ((Fin d → ℤ) × (Fin d → ℤ))) :
    ‖∑ p ∈ s, cvT ha p.1 p.2‖ ≤ Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) := by
  have hnn : (0 : ℝ) ≤ Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) :=
    mul_nonneg (Real.sqrt_nonneg _) (by positivity)
  have hcol := fun (p : (Fin d → ℤ) × (Fin d → ℤ)) (_ : p ∈ s) =>
    sum_sqrt_norm_adjoint_comp_le ha hCφb hCφ hN s p
  have hrow := fun (p : (Fin d → ℤ) × (Fin d → ℤ)) (_ : p ∈ s) =>
    sum_sqrt_norm_comp_adjoint_le ha hCφb hCφ hN s p
  exact Auto.CotlarStein.norm_sum_le_of_cotlar_stein
    (fun p : (Fin d → ℤ) × (Fin d → ℤ) => cvT ha p.1 p.2) hnn hcol hrow

theorem sum_cbump (d M : ℕ) (x : EuclideanSpace ℝ (Fin d)) (hx : ‖x‖ ≤ (M : ℝ)) :
    ∑ k ∈ latticeBox d M, cbump d k x = 1 := by
  have h := sum_bumpD d M x hx
  have hc : ∑ k ∈ latticeBox d M, cbump d k x
      = ((∑ k ∈ latticeBox d M, bumpD d (x - latt d k) : ℝ) : ℂ) := by
    rw [Complex.ofReal_sum]
    rfl
  rw [hc, h, Complex.ofReal_one]

theorem measurable_cvOp (ha : IsCVSymbol d N a A) {f : EuclideanSpace ℝ (Fin d) → ℂ}
    (hfm : Measurable f) : Measurable (cvOp a f) := by
  have hchar : Measurable (fun q : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) =>
      cvChar (inner ℝ q.1 q.2)) := (continuous_cvChar.comp continuous_inner).measurable
  have hprod : StronglyMeasurable (fun q : EuclideanSpace ℝ (Fin d) ×
      EuclideanSpace ℝ (Fin d) => cvChar (inner ℝ q.1 q.2) * a q.1 q.2 * f q.2) :=
    ((hchar.mul ha.meas).mul (hfm.comp measurable_snd)).stronglyMeasurable
  exact (hprod.integral_prod_right').measurable

theorem integrable_cvOp_integrand (ha : IsCVSymbol d N a A)
    {f : EuclideanSpace ℝ (Fin d) → ℂ} (hfm : Measurable f) (hfi : Integrable f)
    (x : EuclideanSpace ℝ (Fin d)) :
    Integrable (fun ξ => cvChar (inner ℝ x ξ) * a x ξ * f ξ) := by
  have hmeas : AEStronglyMeasurable (fun ξ => cvChar (inner ℝ x ξ) * a x ξ) volume := by
    refine (Measurable.mul ?_ ?_).stronglyMeasurable.aestronglyMeasurable
    · exact (continuous_cvChar.comp (continuous_const.inner continuous_id)).measurable
    · exact ha.meas.comp measurable_prodMk_left
  refine Integrable.mono' (hfi.norm.const_mul A) (hmeas.mul hfi.1)
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [norm_mul, norm_mul, norm_cvChar, one_mul]
  exact mul_le_mul_of_nonneg_right (ha.norm_le x ξ) (norm_nonneg _)

theorem integrable_cvK_integrand (ha : IsCVSymbol d N a A)
    {f : EuclideanSpace ℝ (Fin d) → ℂ} (hfi : Integrable f) (k l : Fin d → ℤ)
    (x : EuclideanSpace ℝ (Fin d)) :
    Integrable (fun ξ => cvK a k l x ξ * f ξ) := by
  have hm : Measurable (cvK a k l x) := (isGoodKernel_cvK ha k l).row_meas x
  refine Integrable.mono' (hfi.norm.const_mul A)
    (hm.stronglyMeasurable.aestronglyMeasurable.mul hfi.1)
    (Filter.Eventually.of_forall fun ξ => ?_)
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right (norm_cvK_le ha k l x ξ) (norm_nonneg _)

/-- On a large ball the operator agrees with the finite sum of its localizations. -/
theorem cvOp_eq_sum (ha : IsCVSymbol d N a A) {f : EuclideanSpace ℝ (Fin d) → ℂ}
    (hfm : Measurable f) (hfi : Integrable f) (M : ℕ)
    (hfsupp : ∀ ξ, (M : ℝ) < ‖ξ‖ → f ξ = 0)
    {x : EuclideanSpace ℝ (Fin d)} (hx : ‖x‖ ≤ (M : ℝ)) :
    cvOp a f x = ∑ p ∈ latticeBox d M ×ˢ latticeBox d M,
      kernelApply volume (cvK a p.1 p.2) f x := by
  have hpt : ∀ ξ, cvChar (inner ℝ x ξ) * a x ξ * f ξ
      = ∑ p ∈ latticeBox d M ×ˢ latticeBox d M, cvK a p.1 p.2 x ξ * f ξ := by
    intro ξ
    have hfac : ∀ p : (Fin d → ℤ) × (Fin d → ℤ), cvK a p.1 p.2 x ξ * f ξ
        = (cbump d p.1 x * cbump d p.2 ξ) * (cvChar (inner ℝ x ξ) * a x ξ * f ξ) := by
      intro p
      rw [cvK]
      ring
    have hsplit : (∑ p ∈ latticeBox d M ×ˢ latticeBox d M, cbump d p.1 x * cbump d p.2 ξ)
        = (∑ k ∈ latticeBox d M, cbump d k x) * (∑ l ∈ latticeBox d M, cbump d l ξ) := by
      rw [Finset.sum_product, Finset.sum_mul_sum]
    rw [Finset.sum_congr rfl (fun p _ => hfac p), ← Finset.sum_mul, hsplit,
      sum_cbump d M x hx]
    by_cases hξ : ‖ξ‖ ≤ (M : ℝ)
    · rw [sum_cbump d M ξ hξ]
      ring
    · rw [hfsupp ξ (not_le.mp hξ)]
      ring
  have hswap : (∑ p ∈ latticeBox d M ×ˢ latticeBox d M,
      kernelApply volume (cvK a p.1 p.2) f x)
      = ∫ ξ, ∑ p ∈ latticeBox d M ×ˢ latticeBox d M, cvK a p.1 p.2 x ξ * f ξ :=
    (integral_finsetSum _ (fun p _ => integrable_cvK_integrand ha hfi p.1 p.2 x)).symm
  rw [cvOp, hswap]
  exact integral_congr_ae (Filter.Eventually.of_forall hpt)

end Main

/-! ### The main theorem -/

section Theorem

variable {d N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A Cφ : ℝ}

theorem coeFn_sum_cvT (ha : IsCVSymbol d N a A) (s : Finset ((Fin d → ℤ) × (Fin d → ℤ)))
    (F : Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin d)))) :
    (((∑ p ∈ s, cvT ha p.1 p.2) F : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ)
      =ᵐ[volume] ∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) (F : EuclideanSpace ℝ (Fin d) → ℂ) := by
  classical
  induction s using Finset.cons_induction with
  | empty =>
      simp only [Finset.sum_empty, ContinuousLinearMap.zero_apply]
      exact Lp.coeFn_zero ℂ 2 volume
  | cons q t hq ih =>
      rw [Finset.sum_cons, Finset.sum_cons, ContinuousLinearMap.add_apply]
      refine (Lp.coeFn_add _ _).trans ?_
      exact ((coeFn_goodCLM volume (cvK a q.1 q.2) (isGoodKernel_cvK ha q.1 q.2) F).add ih)

/-- **The Calderón--Vaillancourt theorem** in the `S⁰_{0,0}` form.  The `L²` operator norm of
the oscillatory integral operator with symbol `a` is controlled by a dimensional constant times
the uniform bound `A` on the derivatives of `a`. -/
theorem eLpNorm_cvOp_le (ha : IsCVSymbol d N a A)
    (hCφb : ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (bumpD d) x‖ ≤ Cφ) (hCφ : 0 ≤ Cφ)
    (hN : N = 2 * (2 * d)) {f : EuclideanSpace ℝ (Fin d) → ℂ}
    (hfcont : Continuous f) (hfcs : HasCompactSupport f) :
    eLpNorm (cvOp a f) 2 volume
      ≤ ENNReal.ofReal (Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d)) *
        eLpNorm f 2 volume := by
  classical
  set ACS : ℝ := Real.sqrt (cvQ d N Cφ A) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) with hACSdef
  have hACS : 0 ≤ ACS := by rw [hACSdef]; positivity
  have hfm : Measurable f := hfcont.measurable
  have hfi : Integrable f := hfcont.integrable_of_hasCompactSupport hfcs
  have hfL2 : MemLp f 2 (volume : Measure (EuclideanSpace ℝ (Fin d))) :=
    hfcont.memLp_of_hasCompactSupport hfcs
  set F : Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin d))) := hfL2.toLp f with hFdef
  -- a radius containing the support of `f`
  obtain ⟨r, hr⟩ := (hfcs.isCompact.isBounded).subset_closedBall (0 : EuclideanSpace ℝ (Fin d))
  set M₀ : ℕ := ⌈r⌉₊ with hM₀
  have hfsupp : ∀ (M : ℕ), M₀ ≤ M → ∀ ξ, (M : ℝ) < ‖ξ‖ → f ξ = 0 := by
    intro M hM ξ hξ
    have hrle : r ≤ (M : ℝ) := by
      refine le_trans (Nat.le_ceil r) ?_
      exact_mod_cast hM
    by_contra hne
    have hmem : ξ ∈ tsupport f := subset_closure hne
    have := hr hmem
    rw [Metric.mem_closedBall, dist_zero_right] at this
    linarith
  set B : ℝ≥0∞ := ENNReal.ofReal ACS * eLpNorm f 2 volume with hBdef
  -- the truncated bound
  have hFnorm : ‖F‖ = (eLpNorm f 2 (volume : Measure (EuclideanSpace ℝ (Fin d)))).toReal := by
    rw [hFdef, Lp.norm_def, eLpNorm_congr_ae (MemLp.coeFn_toLp hfL2)]
  have htrunc : ∀ M : ℕ, M₀ ≤ M →
      (∫⁻ x in Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (M : ℝ),
        ‖cvOp a f x‖ₑ ^ (2 : ℝ)) ≤ B ^ (2 : ℝ) := by
    intro M hM
    set s : Finset ((Fin d → ℤ) × (Fin d → ℤ)) := latticeBox d M ×ˢ latticeBox d M with hs
    set G : Lp ℂ 2 (volume : Measure (EuclideanSpace ℝ (Fin d))) :=
      (∑ p ∈ s, cvT ha p.1 p.2) F with hG
    have hfun : (∑ p ∈ s, kernelApply volume (cvK a p.1 p.2)
          ((F : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ))
        = ∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f :=
      Finset.sum_congr rfl (fun p _ =>
        kernelApply_congr_ae (cvK a p.1 p.2) (MemLp.coeFn_toLp hfL2))
    have hGcoe : ((G : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ)
        =ᵐ[volume] ∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f :=
      (coeFn_sum_cvT ha s F).trans (Filter.Eventually.of_forall (fun x => congrFun hfun x))
    have heq : ∀ x ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (M : ℝ),
        ‖cvOp a f x‖ₑ ^ (2 : ℝ)
          = ‖(∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f) x‖ₑ ^ (2 : ℝ) := by
      intro x hx
      rw [Metric.mem_closedBall, dist_zero_right] at hx
      have h1 : cvOp a f x = (∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f) x := by
        rw [Finset.sum_apply, hs]
        exact cvOp_eq_sum ha hfm hfi M (hfsupp M hM) hx
      rw [h1]
    calc (∫⁻ x in Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (M : ℝ),
          ‖cvOp a f x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x in Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) (M : ℝ),
            ‖(∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f) x‖ₑ ^ (2 : ℝ) :=
          setLIntegral_congr_fun Metric.isClosed_closedBall.measurableSet heq
      _ ≤ ∫⁻ x, ‖(∑ p ∈ s, kernelApply volume (cvK a p.1 p.2) f) x‖ₑ ^ (2 : ℝ) :=
          setLIntegral_le_lintegral _ _
      _ = sqMass volume ((G : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ) :=
          (sqMass_congr_ae hGcoe).symm
      _ = (eLpNorm ((G : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ) 2 volume) ^ (2 : ℝ) :=
          sqMass_eq_eLpNorm_rpow _ _
      _ ≤ B ^ (2 : ℝ) := by
          refine ENNReal.rpow_le_rpow ?_ (by norm_num)
          have hGle : ‖G‖ ≤ ACS * ‖F‖ := by
            rw [hG]
            refine le_trans (ContinuousLinearMap.le_opNorm _ _) ?_
            exact mul_le_mul_of_nonneg_right (norm_sum_cvT_le ha hCφb hCφ hN s) (norm_nonneg _)
          have hEq : eLpNorm ((G : Lp ℂ 2 volume) : EuclideanSpace ℝ (Fin d) → ℂ) 2 volume
              = ENNReal.ofReal ‖G‖ := by
            rw [Lp.norm_def, ENNReal.ofReal_toReal (Lp.memLp G).2.ne]
          rw [hEq, hBdef]
          refine le_trans (ENNReal.ofReal_le_ofReal hGle) (le_of_eq ?_)
          rw [ENNReal.ofReal_mul hACS, hFnorm,
            ENNReal.ofReal_toReal (hfL2.2.ne)]
  -- pass to the limit
  have hmeasg : Measurable (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ)) :=
    ((measurable_cvOp ha hfm).enorm).pow_const _
  have hsq : sqMass volume (cvOp a f) ≤ B ^ (2 : ℝ) := by
    have hind : ∀ M : ℕ, Measurable
        ((Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) ((M + M₀ : ℕ) : ℝ)).indicator
          (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ))) := fun M =>
      hmeasg.indicator Metric.isClosed_closedBall.measurableSet
    have hmono : Monotone (fun M : ℕ =>
        (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) ((M + M₀ : ℕ) : ℝ)).indicator
          (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ))) := by
      intro M M' hMM' x
      refine Set.indicator_le_indicator_of_subset ?_ (fun _ => zero_le) x
      refine Metric.closedBall_subset_closedBall ?_
      have : (M + M₀ : ℕ) ≤ (M' + M₀ : ℕ) := by omega
      exact_mod_cast this
    have hpt : ∀ x, (⨆ M : ℕ,
        (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) ((M + M₀ : ℕ) : ℝ)).indicator
          (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ)) x) = ‖cvOp a f x‖ₑ ^ (2 : ℝ) := by
      intro x
      refine le_antisymm (iSup_le fun M => ?_) ?_
      · exact Set.indicator_le_self _ _ x
      · obtain ⟨M, hMx⟩ := exists_nat_ge ‖x‖
        refine le_trans (le_of_eq ?_) (le_iSup _ M)
        have hmem : x ∈ Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) ((M + M₀ : ℕ) : ℝ) := by
          rw [Metric.mem_closedBall, dist_zero_right]
          refine le_trans hMx ?_
          have : (M : ℕ) ≤ (M + M₀ : ℕ) := by omega
          exact_mod_cast this
        rw [Set.indicator_of_mem hmem]
    rw [sqMass]
    rw [show (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ)) = fun x => ⨆ M : ℕ,
        (Metric.closedBall (0 : EuclideanSpace ℝ (Fin d)) ((M + M₀ : ℕ) : ℝ)).indicator
          (fun x => ‖cvOp a f x‖ₑ ^ (2 : ℝ)) x from by
      funext x; exact (hpt x).symm]
    rw [lintegral_iSup hind hmono]
    refine iSup_le fun M => ?_
    rw [lintegral_indicator Metric.isClosed_closedBall.measurableSet]
    exact htrunc (M + M₀) (by omega)
  rw [eLpNorm_two_eq_sqMass_rpow]
  refine le_trans (ENNReal.rpow_le_rpow hsq (by norm_num)) (le_of_eq ?_)
  rw [← ENNReal.rpow_mul, hBdef]
  norm_num

/-- The Calderón--Vaillancourt bound with a constant depending only on the dimension. -/
theorem exists_cv_bound (d : ℕ) :
    ∃ c : ℝ, 0 < c ∧ ∀ (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ) (A : ℝ),
      IsCVSymbol d (2 * (2 * d)) a A →
      ∀ f : EuclideanSpace ℝ (Fin d) → ℂ, Continuous f → HasCompactSupport f →
        eLpNorm (cvOp a f) 2 volume ≤ ENNReal.ofReal (c * A) * eLpNorm f 2 volume := by
  obtain ⟨Cφ, hCφ1, hCφb⟩ := exists_bumpD_bound d (2 * (2 * d))
  refine ⟨Real.sqrt (cvQ d (2 * (2 * d)) Cφ 1) * ((3 : ℝ) ^ d * (3 : ℝ) ^ d) + 1, by positivity,
    ?_⟩
  intro a A ha f hfcont hfcs
  have hAnn : 0 ≤ A := ha.nonneg
  have hmain := eLpNorm_cvOp_le ha hCφb (by linarith) rfl hfcont hfcs
  refine le_trans hmain ?_
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
  have hQ : cvQ d (2 * (2 * d)) Cφ A = cvQ d (2 * (2 * d)) Cφ 1 * (A * A) := by
    rw [cvQ, cvQ, cvD, cvD]
    ring
  rw [hQ, Real.sqrt_mul (cvQ_nonneg d (2 * (2 * d)) Cφ 1),
    show Real.sqrt (A * A) = A from Real.sqrt_mul_self hAnn]
  nlinarith [Real.sqrt_nonneg (cvQ d (2 * (2 * d)) Cφ 1), hAnn,
    pow_pos (show (0:ℝ) < 3 from by norm_num) d]

end Theorem














/-! ## The anisotropic Calderón--Vaillancourt theorem

The form in which the theorem is actually used: the symbol is allowed to satisfy anisotropic
derivative bounds `‖∂_x^n a(·, ξ)‖ ≤ A σ ^ n` and `‖∂_ξ^n a(x, ·)‖ ≤ A τ ^ n` with `σ τ ≤ 1`.
This is the class the exotic symbols of Roos--Seeger belong to, and the `L²` bound is still
`c A` with `c` independent of `σ` and `τ`.  The reduction to the isotropic case is the dilation
`x ↦ σ⁻¹ x`, `ξ ↦ σ ξ`, under which the operator is conjugated by an `L²`-isometry up to
scalars.
-/

section Aniso

variable {d : ℕ}

theorem lintegral_comp_const_smul (F : EuclideanSpace ℝ (Fin d) → ℝ≥0∞) {r : ℝ} (hr : r ≠ 0) :
    (∫⁻ x, F (r • x) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))))
      = ENNReal.ofReal |(r ^ d)⁻¹| *
          ∫⁻ x, F x ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) := by
  have hu : IsUnit r := isUnit_iff_ne_zero.2 hr
  have h1 : (∫⁻ y, F y ∂(Measure.map (fun x : EuclideanSpace ℝ (Fin d) => r • x) volume))
      = ∫⁻ x, F (r • x) ∂(volume : Measure (EuclideanSpace ℝ (Fin d))) :=
    lintegral_map_equiv F (Homeomorph.smul hu.unit).toMeasurableEquiv
  rw [← h1, Measure.map_addHaar_smul volume hr, lintegral_smul_measure,
    finrank_euclideanSpace_fin, smul_eq_mul]

theorem sqMass_comp_const_smul (F : EuclideanSpace ℝ (Fin d) → ℂ) {r : ℝ} (hr : 0 < r) :
    sqMass volume (fun x => F (r • x))
      = ENNReal.ofReal ((r ^ d)⁻¹) * sqMass volume F := by
  have h := lintegral_comp_const_smul (d := d) (fun x => ‖F x‖ₑ ^ (2 : ℝ)) hr.ne'
  rw [sqMass, sqMass, h, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (r ^ d)⁻¹)]

theorem eLpNorm_comp_const_smul (F : EuclideanSpace ℝ (Fin d) → ℂ) {r : ℝ} (hr : 0 < r) :
    eLpNorm (fun x => F (r • x)) 2 volume
      = ENNReal.ofReal ((r ^ d)⁻¹) ^ (2⁻¹ : ℝ) * eLpNorm F 2 volume := by
  rw [eLpNorm_two_eq_sqMass_rpow, eLpNorm_two_eq_sqMass_rpow, sqMass_comp_const_smul F hr,
    ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]

/-- Anisotropic symbol class: `‖∂_x^n a(·, ξ)‖ ≤ A σ ^ n` and `‖∂_ξ^n a(x, ·)‖ ≤ A τ ^ n`
for `n ≤ N`.  Only pure derivatives in each of the two variables separately are required. -/
structure IsCVSymbolAniso (d N : ℕ)
    (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ) (A σ τ : ℝ) : Prop where
  meas : Measurable (Function.uncurry a)
  smoothx : ∀ ξ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fun x => a x ξ)
  smoothξ : ∀ x, ContDiff ℝ (↑(⊤ : ℕ∞)) (fun ξ => a x ξ)
  boundx : ∀ ξ, ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n (fun x => a x ξ) x‖ ≤ A * σ ^ n
  boundξ : ∀ x, ∀ n ≤ N, ∀ ξ, ‖iteratedFDeriv ℝ n (fun ξ => a x ξ) ξ‖ ≤ A * τ ^ n

namespace IsCVSymbolAniso

variable {N : ℕ} {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A σ τ : ℝ}

theorem nonneg (ha : IsCVSymbolAniso d N a A σ τ) : 0 ≤ A := by
  have h := ha.boundx 0 0 (Nat.zero_le _) 0
  rw [norm_iteratedFDeriv_zero, pow_zero, mul_one] at h
  exact le_trans (norm_nonneg _) h

end IsCVSymbolAniso

/-- The rescaled symbol `a (σ⁻¹ x, σ ξ)`. -/
def cvRescale (σ : ℝ) (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ) :
    EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ :=
  fun x ξ => a (σ⁻¹ • x) (σ • ξ)

theorem isCVSymbol_cvRescale {N : ℕ}
    {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {A σ τ : ℝ}
    (hσ : 0 < σ) (hτ : 0 ≤ τ) (hστ : σ * τ ≤ 1)
    (ha : IsCVSymbolAniso d N a A σ τ) :
    IsCVSymbol d N (cvRescale σ a) A := by
  have hA : 0 ≤ A := ha.nonneg
  have hσ0 : σ ≠ 0 := hσ.ne'
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have h : Measurable (fun q : EuclideanSpace ℝ (Fin d) × EuclideanSpace ℝ (Fin d) =>
        ((σ⁻¹ • q.1 : EuclideanSpace ℝ (Fin d)), (σ • q.2 : EuclideanSpace ℝ (Fin d)))) :=
      (measurable_fst.const_smul σ⁻¹).prodMk (measurable_snd.const_smul σ)
    exact ha.meas.comp h
  · exact fun ξ => (ha.smoothx (σ • ξ)).comp (contDiff_const_smul σ⁻¹)
  · exact fun x => (ha.smoothξ (σ⁻¹ • x)).comp (contDiff_const_smul σ)
  · intro ξ n hn x
    have hcd : ContDiff ℝ (n : ℕ) (fun z => a z (σ • ξ)) :=
      (ha.smoothx (σ • ξ)).of_le (by exact_mod_cast le_top)
    have heq : iteratedFDeriv ℝ n (fun x => cvRescale σ a x ξ) x
        = σ⁻¹ ^ n • iteratedFDeriv ℝ n (fun z => a z (σ • ξ)) (σ⁻¹ • x) :=
      congrFun (iteratedFDeriv_comp_const_smul (i := n) (f := fun z => a z (σ • ξ)) σ⁻¹ hcd) x
    rw [heq, norm_smul, Real.norm_eq_abs, abs_pow, abs_of_pos (inv_pos.mpr hσ)]
    calc σ⁻¹ ^ n * ‖iteratedFDeriv ℝ n (fun z => a z (σ • ξ)) (σ⁻¹ • x)‖
        ≤ σ⁻¹ ^ n * (A * σ ^ n) :=
          mul_le_mul_of_nonneg_left (ha.boundx (σ • ξ) n hn (σ⁻¹ • x)) (by positivity)
      _ = A := by
          rw [inv_pow]
          field_simp
  · intro x n hn ξ
    have hcd : ContDiff ℝ (n : ℕ) (fun z => a (σ⁻¹ • x) z) :=
      (ha.smoothξ (σ⁻¹ • x)).of_le (by exact_mod_cast le_top)
    have heq : iteratedFDeriv ℝ n (fun ξ => cvRescale σ a x ξ) ξ
        = σ ^ n • iteratedFDeriv ℝ n (fun z => a (σ⁻¹ • x) z) (σ • ξ) :=
      congrFun (iteratedFDeriv_comp_const_smul (i := n) (f := fun z => a (σ⁻¹ • x) z) σ hcd) ξ
    rw [heq, norm_smul, Real.norm_eq_abs, abs_pow, abs_of_pos hσ]
    calc σ ^ n * ‖iteratedFDeriv ℝ n (fun z => a (σ⁻¹ • x) z) (σ • ξ)‖
        ≤ σ ^ n * (A * τ ^ n) :=
          mul_le_mul_of_nonneg_left (ha.boundξ (σ⁻¹ • x) n hn (σ • ξ)) (by positivity)
      _ = A * (σ * τ) ^ n := by rw [mul_pow]; ring
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left (pow_le_one₀ (by positivity) hστ) hA
      _ = A := mul_one A

/-- The operator attached to the rescaled symbol, evaluated at the rescaled point. -/
theorem cvOp_cvRescale {a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ} {σ : ℝ}
    (hσ : 0 < σ) (f : EuclideanSpace ℝ (Fin d) → ℂ) (y : EuclideanSpace ℝ (Fin d)) :
    cvOp (cvRescale σ a) (fun ξ => f (σ • ξ)) (σ • y)
      = (σ ^ d)⁻¹ • cvOp a f y := by
  have hstep : ∀ ξ : EuclideanSpace ℝ (Fin d),
      cvChar (inner ℝ (σ • y) ξ) * cvRescale σ a (σ • y) ξ * f (σ • ξ)
        = (fun η => cvChar (inner ℝ y η) * a y η * f η) (σ • ξ) := by
    intro ξ
    have h1 : σ⁻¹ • (σ • y) = y := by
      rw [smul_smul, inv_mul_cancel₀ hσ.ne', one_smul]
    have h2 : (inner ℝ (σ • y) ξ : ℝ) = inner ℝ y (σ • ξ) := by
      rw [real_inner_smul_left, real_inner_smul_right]
    rw [cvRescale, h1, h2]
  have hint : cvOp (cvRescale σ a) (fun ξ => f (σ • ξ)) (σ • y)
      = ∫ ξ, (fun η => cvChar (inner ℝ y η) * a y η * f η) (σ • ξ) := by
    rw [cvOp]
    exact integral_congr_ae (Filter.Eventually.of_forall hstep)
  rw [hint,
    Measure.integral_comp_smul volume (fun η => cvChar (inner ℝ y η) * a y η * f η) σ,
    finrank_euclideanSpace_fin, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (σ ^ d)⁻¹)]
  rfl

theorem hasCompactSupport_comp_const_smul {f : EuclideanSpace ℝ (Fin d) → ℂ}
    (hf : HasCompactSupport f) {σ : ℝ} (hσ : 0 < σ) :
    HasCompactSupport (fun ξ => f (σ • ξ)) := by
  set g : EuclideanSpace ℝ (Fin d) → ℂ := fun ξ => f (σ • ξ) with hg
  have hKc : IsCompact ((fun z : EuclideanSpace ℝ (Fin d) => σ⁻¹ • z) '' tsupport f) :=
    hf.isCompact.image (continuous_const_smul σ⁻¹)
  have hsupp :
      Function.support g ⊆ (fun z : EuclideanSpace ℝ (Fin d) => σ⁻¹ • z) '' tsupport f := by
    intro ξ hξ
    refine ⟨σ • ξ, subset_tsupport f (by exact hξ), ?_⟩
    show σ⁻¹ • (σ • ξ) = ξ
    rw [smul_smul, inv_mul_cancel₀ hσ.ne', one_smul]
  exact hKc.of_isClosed_subset (isClosed_tsupport g) (closure_minimal hsupp hKc.isClosed)

/-- **Calderón--Vaillancourt, anisotropic form.**  If the symbol satisfies
`‖∂_x^n a(·, ξ)‖ ≤ A σ ^ n` and `‖∂_ξ^n a(x, ·)‖ ≤ A τ ^ n` for `n ≤ 4 d`, with `σ τ ≤ 1`,
then `P a` is bounded on `L²` with norm at most `c A`, where `c` depends only on `d`. -/
theorem exists_cv_bound_aniso (d : ℕ) :
    ∃ c : ℝ, 0 < c ∧ ∀ (a : EuclideanSpace ℝ (Fin d) → EuclideanSpace ℝ (Fin d) → ℂ)
      (A σ τ : ℝ), 0 < σ → 0 ≤ τ → σ * τ ≤ 1 →
      IsCVSymbolAniso d (2 * (2 * d)) a A σ τ →
      ∀ f : EuclideanSpace ℝ (Fin d) → ℂ, Continuous f → HasCompactSupport f →
        eLpNorm (cvOp a f) 2 volume ≤ ENNReal.ofReal (c * A) * eLpNorm f 2 volume := by
  obtain ⟨c, hc, hbound⟩ := exists_cv_bound d
  refine ⟨c, hc, ?_⟩
  intro a A σ τ hσ hτ hστ ha f hfcont hfcs
  have hbsym : IsCVSymbol d (2 * (2 * d)) (cvRescale σ a) A :=
    isCVSymbol_cvRescale hσ hτ hστ ha
  have hgcont : Continuous (fun ξ => f (σ • ξ)) := hfcont.comp (continuous_const_smul σ)
  have hgcs : HasCompactSupport (fun ξ => f (σ • ξ)) :=
    hasCompactSupport_comp_const_smul hfcs hσ
  have hkey := hbound (cvRescale σ a) A hbsym (fun ξ => f (σ • ξ)) hgcont hgcs
  have hpt : cvOp a f
      = (σ ^ d : ℝ) • (fun y => cvOp (cvRescale σ a) (fun ξ => f (σ • ξ)) (σ • y)) := by
    funext y
    rw [Pi.smul_apply, cvOp_cvRescale hσ f y, smul_smul,
      mul_inv_cancel₀ (by positivity : (σ : ℝ) ^ d ≠ 0), one_smul]
  set P : ℝ≥0∞ := ENNReal.ofReal ((σ ^ d)⁻¹) ^ (2⁻¹ : ℝ) with hP
  have hPP : ENNReal.ofReal ((σ : ℝ) ^ d) * (P * P) = 1 := by
    have h0 : ENNReal.ofReal ((σ ^ d : ℝ)⁻¹) ≠ 0 := by
      simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
      positivity
    rw [hP, ← ENNReal.rpow_add _ _ h0 ENNReal.ofReal_ne_top]
    norm_num
    rw [← ENNReal.ofReal_mul (by positivity), mul_inv_cancel₀ (by positivity : (σ : ℝ) ^ d ≠ 0),
      ENNReal.ofReal_one]
  have h1 : eLpNorm (cvOp a f) 2 volume
      = ENNReal.ofReal ((σ : ℝ) ^ d) *
        eLpNorm (fun y => cvOp (cvRescale σ a) (fun ξ => f (σ • ξ)) (σ • y)) 2 volume := by
    rw [hpt, eLpNorm_const_smul, ← ofReal_norm, Real.norm_eq_abs,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ (σ : ℝ) ^ d)]
  have h2 : eLpNorm (fun y => cvOp (cvRescale σ a) (fun ξ => f (σ • ξ)) (σ • y)) 2 volume
      = P * eLpNorm (cvOp (cvRescale σ a) (fun ξ => f (σ • ξ))) 2 volume :=
    eLpNorm_comp_const_smul _ hσ
  have h3 : eLpNorm (fun ξ => f (σ • ξ)) 2 volume = P * eLpNorm f 2 volume :=
    eLpNorm_comp_const_smul _ hσ
  calc eLpNorm (cvOp a f) 2 volume
      = ENNReal.ofReal ((σ : ℝ) ^ d) *
          (P * eLpNorm (cvOp (cvRescale σ a) (fun ξ => f (σ • ξ))) 2 volume) := by rw [h1, h2]
    _ ≤ ENNReal.ofReal ((σ : ℝ) ^ d) *
          (P * (ENNReal.ofReal (c * A) * eLpNorm (fun ξ => f (σ • ξ)) 2 volume)) :=
        mul_le_mul' (le_refl _) (mul_le_mul' (le_refl _) hkey)
    _ = ENNReal.ofReal (c * A) *
          ((ENNReal.ofReal ((σ : ℝ) ^ d) * (P * P)) * eLpNorm f 2 volume) := by
        rw [h3]; ring
    _ = ENNReal.ofReal (c * A) * eLpNorm f 2 volume := by rw [hPP, one_mul]

end Aniso


end

end Auto.CalderonVaillancourt
