section

namespace Auto.Spherical.MSS.ScratchKakeyaReflectedSourceEnergy

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaFiniteCoreLowpassEnergy
open Auto.Spherical.MSS.KakeyaShiftedCappedFiberLobeEnergy
open Auto.Spherical.MSS.KakeyaScaledSectorEnergyOverlap
open Auto.Spherical.MSS.ScratchKakeyaReflectedTubeTensorBridge
open scoped BigOperators EuclideanSpace

noncomputable section

/-- Multiplying every spatial profile by the same reflected multiplier
factors that multiplier out of the literal time fibre. -/
theorem scratch_finiteTensorTimeData_reflectedTubeProfile_eq
    {iota : Type*} (m : SchwartzMap (Euclidean 2) Complex)
    (s : Finset iota) (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) (t : Real) :
    scratch_finiteTensorTimeData s (fun l => reflectedTubeProfile m (q l)) a xi t =
      m (-xi) * scratch_finiteTensorTimeData s q a xi t := by
  unfold scratch_finiteTensorTimeData
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l hl
  rw [reflectedTubeProfile_apply]
  ring

/-- The source-time square energy of reflected profiles is exactly the
squared reflected multiplier times the original fibre energy. -/
theorem shiftedFiberSourceEnergy_reflectedTubeProfile_eq
    {iota : Type*} (m : SchwartzMap (Euclidean 2) Complex)
    (s : Finset iota) (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    shiftedFiberSourceEnergy s (fun l => reflectedTubeProfile m (q l)) a xi =
      ‖m (-xi)‖ ^ (2 : Nat) * shiftedFiberSourceEnergy s q a xi := by
  unfold shiftedFiberSourceEnergy
  have hpoint : (fun t : Real =>
      ‖scratch_finiteTensorTimeData s (fun l => reflectedTubeProfile m (q l)) a xi t‖ ^
        (2 : Nat)) =
      fun t : Real => ‖m (-xi)‖ ^ (2 : Nat) •
        ‖scratch_finiteTensorTimeData s q a xi t‖ ^ (2 : Nat) := by
    funext t
    rw [scratch_finiteTensorTimeData_reflectedTubeProfile_eq]
    rw [norm_mul, mul_pow]
    simp only [smul_eq_mul]
  rw [hpoint, MeasureTheory.integral_smul]
  simp only [smul_eq_mul]

/-- The canonical compact multiplier contracts the reflected source fibre
energy by its fixed Schwartz `L∞` bound. -/
theorem shiftedFiberSourceEnergy_reflectedCanonicalTubeProfile_le
    {rho : Real} (hrho : 0 < rho)
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (xi : Euclidean 2) :
    shiftedFiberSourceEnergy s
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi <=
      canonicalTubeMultiplierUniformBound ^ (2 : Nat) *
        shiftedFiberSourceEnergy s q a xi := by
  rw [shiftedFiberSourceEnergy_reflectedTubeProfile_eq]
  have hnorm := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound
    hrho (-xi)
  have hnonneg : 0 <= canonicalTubeMultiplierUniformBound := by
    dsimp [canonicalTubeMultiplierUniformBound]
    positivity
  have hsq : ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho (-xi)‖ ^
      (2 : Nat) <= canonicalTubeMultiplierUniformBound ^ (2 : Nat) := by
    nlinarith [norm_nonneg (scratch_canonicalBandlimitedTubeMultiplier rho hrho (-xi))]
  exact mul_le_mul_of_nonneg_right hsq
    (shiftedFiberSourceEnergy_nonneg s q a xi)

/-- Integrating the preceding contraction gives the source-energy form used
by the canonical radial closure. -/
theorem integral_shiftedFiberSourceEnergy_reflectedCanonicalTubeProfile_le
    {rho : Real} (hrho : 0 < rho)
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) :
    (∫ xi : Euclidean 2, shiftedFiberSourceEnergy s
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi) <=
      canonicalTubeMultiplierUniformBound ^ (2 : Nat) *
        ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s q a xi := by
  rw [← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_mono
  · exact integrable_shiftedFiberSourceEnergy s
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a
  · exact (integrable_shiftedFiberSourceEnergy s q a).const_mul _
  · intro xi
    exact shiftedFiberSourceEnergy_reflectedCanonicalTubeProfile_le hrho s q a xi

/-- The reflected post-canonical profiles retain the literal canonical
frequency support.  This is the support hypothesis for radial reassembly. -/
theorem reflectedCanonicalTubeProfile_support_subset_closedBall
    {rho : Real} (hrho : 0 < rho)
    (q : SchwartzMap (Euclidean 2) Complex) :
    Set.Subset (Function.support
      (reflectedTubeProfile (scratch_canonicalBandlimitedTubeMultiplier rho hrho) q :
        Euclidean 2 -> Complex))
      (Metric.closedBall 0 (4 / rho)) := by
  intro xi hxi
  have hprod : scratch_canonicalBandlimitedTubeMultiplier rho hrho (-xi) * q xi ≠ 0 := by
    simpa only [reflectedTubeProfile_apply] using Function.mem_support.mp hxi
  have hm : scratch_canonicalBandlimitedTubeMultiplier rho hrho (-xi) ≠ 0 := by
    intro hzero
    exact hprod (by rw [hzero, zero_mul])
  have hmSupport : -xi ∈ Function.support
      (scratch_canonicalBandlimitedTubeMultiplier rho hrho :
        Euclidean 2 -> Complex) := Function.mem_support.mpr hm
  have hbound := support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho hmSupport
  rw [Metric.mem_closedBall, dist_zero_right] at hbound ⊢
  simpa only [norm_neg] using hbound

end

end Auto.Spherical.MSS.ScratchKakeyaReflectedSourceEnergy
end
-- END ScratchKakeyaReflectedSourceEnergy

-- BEGIN ScratchKakeyaReflectedEnergyNorm
section

namespace Auto.Spherical.MSS.ScratchKakeyaReflectedEnergyNorm

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaFiniteCoreLowpassEnergy
open Auto.Spherical.MSS.KakeyaShiftedCappedFiberLobeEnergy
open Auto.Spherical.MSS.ScratchKakeyaReflectedSourceEnergy
open Auto.Spherical.MSS.ScratchKakeyaReflectedTubeTensorBridge
open Auto.Spherical.MSS.KakeyaFiniteCoreNorm
open scoped BigOperators ENNReal EuclideanSpace

noncomputable section

/-- The full source fibre energy of a post-canonical reflected finite tensor
is controlled by the physical square `L²` energy of its unfiltered core. -/
theorem ENNReal_ofReal_integral_shiftedFiberSourceEnergy_reflectedCanonical_le_coreNorm_sq
    {rho : Real} (hrho : 0 < rho)
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex) :
    ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy Finset.univ
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi) <=
      ENNReal.ofReal (canonicalTubeMultiplierUniformBound ^ (2 : Nat)) *
        (eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) ^ 2 := by
  have hraw := integral_shiftedFiberSourceEnergy_reflectedCanonicalTubeProfile_le
    hrho Finset.univ q a
  have hbound : 0 <= canonicalTubeMultiplierUniformBound ^ (2 : Nat) := sq_nonneg _
  calc
    ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy Finset.univ
        (fun l => reflectedTubeProfile
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi) <=
        ENNReal.ofReal (canonicalTubeMultiplierUniformBound ^ (2 : Nat) *
          ∫ xi : Euclidean 2, shiftedFiberSourceEnergy Finset.univ q a xi) :=
      ENNReal.ofReal_le_ofReal hraw
    _ = ENNReal.ofReal (canonicalTubeMultiplierUniformBound ^ (2 : Nat)) *
        ENNReal.ofReal (∫ xi : Euclidean 2,
          shiftedFiberSourceEnergy Finset.univ q a xi) := by
      rw [ENNReal.ofReal_mul hbound]
    _ = ENNReal.ofReal (canonicalTubeMultiplierUniformBound ^ (2 : Nat)) *
        ENNReal.ofReal (finiteTensorFrequencyTimeEnergy Finset.univ q a) := by
      rw [integral_shiftedFiberSourceEnergy_eq_frequencyTimeEnergy]
    _ = ENNReal.ofReal (canonicalTubeMultiplierUniformBound ^ (2 : Nat)) *
        (eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume) ^ 2 := by
      rw [← eLpNorm_sq_innerSlabCompactFrequencyTensor_eq_frequencyTimeEnergy]

end

end Auto.Spherical.MSS.ScratchKakeyaReflectedEnergyNorm
end
-- END ScratchKakeyaReflectedEnergyNorm

