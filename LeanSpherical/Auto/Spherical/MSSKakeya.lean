section

namespace Auto.Spherical.MSS.KakeyaFiniteCoreLowpassEnergy

open Filter MeasureTheory Metric Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.LittlewoodPaley
open Auto.Spherical.MSS.KakeyaCompactTimeWeight
open Auto.Spherical.MSS.KakeyaFiniteTensorCompactTime
open Auto.Spherical.MSS.KakeyaAngularDerivativeTransport
open Auto.Spherical.MSS.KakeyaLowFrequencyCompanion
open Auto.Spherical.MSS.KakeyaFiniteRadialFrequencyDecomposition
open Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

/-- The fixed time interval containing every strict inner-slab tensor
profile.  Its Lebesgue measure is exactly two. -/
def finiteCoreTimeSlab : Set Real := Icc (1 / 2 : Real) (5 / 2 : Real)

theorem closedBall_innerSlab_subset_finiteCoreTimeSlab
    {r : Real} (hr : r < 1) :
    closedBall (3 / 2 : Real) r ⊆ finiteCoreTimeSlab := by
  intro t ht
  change dist t (3 / 2 : Real) ≤ r at ht
  rw [Real.dist_eq] at ht
  have hlt : |t - 3 / 2| < 1 := lt_of_le_of_lt ht hr
  have hparts := (abs_lt.mp hlt)
  constructor <;> linarith

/-- Cauchy--Schwarz on the fixed inner time slab.  This is the elementary
time-trace estimate used by the low-frequency energy closure. -/
theorem norm_sq_integral_le_two_mul_integral_norm_sq_of_support_finiteCoreTimeSlab
    (H : Real → Complex)
    (hHmeas : AEStronglyMeasurable H volume)
    (hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume)
    (hsupp : Function.support H ⊆ finiteCoreTimeSlab) :
    ‖∫ t : Real, H t‖ ^ 2 ≤ 2 * ∫ t : Real, ‖H t‖ ^ 2 := by
  let S : Set Real := finiteCoreTimeSlab
  let μ : Measure Real := volume.restrict S
  letI : IsFiniteMeasure μ := by
    dsimp [μ, S, finiteCoreTimeSlab]
    infer_instance
  have hHsqR : Integrable (fun t : Real => ‖H t‖ ^ 2) μ := hHsq.restrict
  have hHmeasR : AEStronglyMeasurable H μ := hHmeas.restrict
  have hHmem : MemLp H 2 μ :=
    (memLp_two_iff_integrable_sq_norm hHmeasR).mpr hHsqR
  have hone : MemLp (fun _ : Real => (1 : Complex)) 2 μ := memLp_const _
  have hHmem' : MemLp H (ENNReal.ofReal (2 : Real)) μ := by
    convert hHmem using 1 <;> norm_num
  have hone' : MemLp (fun _ : Real => (1 : Complex))
      (ENNReal.ofReal (2 : Real)) μ := by
    convert hone using 1 <;> norm_num
  have hhold : (2 : Real).HolderConjugate 2 := by
    rw [Real.holderConjugate_iff]
    norm_num
  have hcs := integral_mul_norm_le_Lp_mul_Lq hhold hone' hHmem'
  have hleft : (∫ t : Real, ‖(1 : Complex)‖ * ‖H t‖ ∂μ) =
      ∫ t : Real, ‖H t‖ ∂μ := by simp
  have honeint : (∫ t : Real, ‖(1 : Complex)‖ ^ (2 : Real) ∂μ) = 2 := by
    norm_num [μ, S, finiteCoreTimeSlab]
  have hHpow : (∫ t : Real, ‖H t‖ ^ (2 : Real) ∂μ) =
      ∫ t : Real, ‖H t‖ ^ 2 ∂μ := by
    apply integral_congr_ae
    filter_upwards with t
    rw [show (2 : Real) = (↑(2 : Nat) : Real) by norm_num,
      Real.rpow_natCast]
  have hHroot : (∫ t : Real, ‖H t‖ ^ 2 ∂μ) ^ (1 / 2 : Real) =
      Real.sqrt (∫ t : Real, ‖H t‖ ^ 2 ∂μ) :=
    (Real.sqrt_eq_rpow _).symm
  rw [hleft, honeint, hHpow, ← Real.sqrt_eq_rpow 2, hHroot] at hcs
  have hnonneg : 0 ≤ ∫ t : Real, ‖H t‖ ^ 2 ∂μ :=
    integral_nonneg fun _ => sq_nonneg _
  have hbound : ‖∫ t : Real, H t ∂μ‖ ≤
      Real.sqrt 2 * Real.sqrt (∫ t : Real, ‖H t‖ ^ 2 ∂μ) :=
    (norm_integral_le_integral_norm _).trans hcs
  have hrightnonneg : 0 ≤ Real.sqrt 2 *
      Real.sqrt (∫ t : Real, ‖H t‖ ^ 2 ∂μ) := by positivity
  have hsq := (sq_le_sq₀ (norm_nonneg _) hrightnonneg).mpr hbound
  have hsqrhs : (Real.sqrt 2 *
      Real.sqrt (∫ t : Real, ‖H t‖ ^ 2 ∂μ)) ^ 2 =
      2 * ∫ t : Real, ‖H t‖ ^ 2 ∂μ := by
    rw [mul_pow, Real.sq_sqrt (by norm_num), Real.sq_sqrt hnonneg]
  rw [hsqrhs] at hsq
  have hrestrict : (∫ t : Real, H t) = ∫ t : Real, H t ∂μ := by
    change (∫ t : Real, H t) = ∫ t : Real in S, H t
    rw [← integral_indicator (by dsimp [S, finiteCoreTimeSlab]; exact measurableSet_Icc)]
    apply integral_congr_ae
    filter_upwards with t
    by_cases ht : t ∈ S
    · simp [Set.indicator, ht]
    · have hzero : H t = 0 := by
        by_contra hne
        dsimp [S] at ht
        exact ht (hsupp (Function.mem_support.mpr hne))
      simp [Set.indicator, ht, hzero]
  have hrestrictSq : (∫ t : Real, ‖H t‖ ^ 2) =
      ∫ t : Real, ‖H t‖ ^ 2 ∂μ := by
    change (∫ t : Real, ‖H t‖ ^ 2) = ∫ t : Real in S, ‖H t‖ ^ 2
    rw [← integral_indicator (by dsimp [S, finiteCoreTimeSlab]; exact measurableSet_Icc)]
    apply integral_congr_ae
    filter_upwards with t
    by_cases ht : t ∈ S
    · simp [Set.indicator, ht]
    · have hzero : H t = 0 := by
        by_contra hne
        dsimp [S] at ht
        exact ht (hsupp (Function.mem_support.mpr hne))
      simp [Set.indicator, ht, hzero]
  rw [hrestrict, hrestrictSq]
  exact hsq

theorem support_scratch_finiteTensorTimeData_subset_finiteCoreTimeSlab
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r) :
    Function.support (scratch_finiteTensorTimeData s q a xi) ⊆
      finiteCoreTimeSlab := by
  exact (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi ha).trans
    (closedBall_innerSlab_subset_finiteCoreTimeSlab hr)

theorem continuous_scratch_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) :
    Continuous (scratch_finiteTensorTimeData s q a xi) := by
  unfold scratch_finiteTensorTimeData
  exact continuous_finsetSum _ fun i hi =>
    continuous_const.mul (a i).continuous

theorem integrable_sq_scratch_finiteTensorTimeData
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2) :
    Integrable (fun t : Real => ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2)
      volume := by
  apply (memLp_two_iff_integrable_sq_norm
    (continuous_scratch_finiteTensorTimeData s q a xi).aestronglyMeasurable).mp
  unfold scratch_finiteTensorTimeData
  exact memLp_finsetSum s fun i hi =>
    ((a i).memLp 2 volume).const_mul (q i xi)

/-- The literal time-Fourier trace of a finite inner-slab tensor costs only
the fixed time length two. -/
theorem norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_timeEnergy
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (omega xi : Euclidean 2) :
    ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ ^ 2 ≤
      2 * ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
  let H : Real → Complex := fun t =>
    scratch_lightRayTimePhase omega xi t * scratch_finiteTensorTimeData s q a xi t
  have hHcont : Continuous H := by
    dsimp [H]
    have hphase : Continuous (scratch_lightRayTimePhase omega xi) := by
      unfold scratch_lightRayTimePhase
      fun_prop
    exact hphase.mul (continuous_scratch_finiteTensorTimeData s q a xi)
  have hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume := by
    apply (integrable_sq_scratch_finiteTensorTimeData s q a xi).congr
    filter_upwards with t
    dsimp [H]
    unfold scratch_lightRayTimePhase
    simp only [norm_mul, Circle.norm_coe, one_mul]
  have hHsupp : Function.support H ⊆ finiteCoreTimeSlab := by
    intro t ht
    apply support_scratch_finiteTensorTimeData_subset_finiteCoreTimeSlab
      s q a xi hr ha
    by_contra hdata
    have hzero : scratch_finiteTensorTimeData s q a xi t = 0 := by
      by_contra hne
      exact hdata (Function.mem_support.mpr hne)
    exact ht (by simp [H, hzero])
  have htrace :=
    norm_sq_integral_le_two_mul_integral_norm_sq_of_support_finiteCoreTimeSlab
      H hHcont.aestronglyMeasurable hHsq hHsupp
  have htime : scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi =
      ∫ t : Real, H t := by
    calc
      scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi =
          ∑ i ∈ s, q i xi *
            (FourierTransform.fourier (a i) : SchwartzMap Real Complex)
              (inner Real omega xi) :=
        scratch_finiteTensorTubeMultiplier_apply s q hqcompact a omega xi
      _ = ∫ t : Real, H t :=
        scratch_finiteTensor_timeFourier_eq_timeIntegral s q a omega xi
  rw [htime]
  calc
    ‖∫ t : Real, H t‖ ^ 2 ≤ 2 * ∫ t : Real, ‖H t‖ ^ 2 := htrace
    _ = 2 * ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
      congr 1
      apply integral_congr_ae
      filter_upwards with t
      dsimp [H]
      unfold scratch_lightRayTimePhase
      simp only [norm_mul, Circle.norm_coe, one_mul]

/-- The joint spatial-frequency/time energy of a finite tensor.  Spatial
Plancherel identifies this with the physical tensor energy once the standard
finite-tensor product Plancherel helper is supplied. -/
noncomputable def finiteTensorFrequencyTimeEnergy
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) : Real :=
  ∫ p : Euclidean 2 × Real,
    ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2 ∂(volume.prod volume)

theorem integral_norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_frequencyTimeEnergy
    {ι : Type*} (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (henergy : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume))
    (omega : Euclidean 2) :
    (∫ xi : Euclidean 2,
      ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ ^ 2) ≤
      2 * finiteTensorFrequencyTimeEnergy s q a := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scratch_finiteTensorTubeMultiplier s q hqcompact a omega
  have hm : Integrable (fun xi : Euclidean 2 => ‖m xi‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm m.continuous.aestronglyMeasurable).mp
      (m.memLp 2 volume)
  have hinter : Integrable (fun xi : Euclidean 2 =>
      ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2) volume :=
    henergy.integral_prod_left
  have hright : Integrable (fun xi : Euclidean 2 =>
      2 * ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2) volume :=
    hinter.const_mul 2
  have hpoint (xi : Euclidean 2) : ‖m xi‖ ^ 2 ≤
      2 * ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 := by
    dsimp [m]
    exact norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_timeEnergy
      s q hqcompact a hr ha omega xi
  calc
    (∫ xi : Euclidean 2, ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ ^ 2) =
        ∫ xi : Euclidean 2, ‖m xi‖ ^ 2 := by rfl
    _ ≤ ∫ xi : Euclidean 2,
        2 * ∫ t : Real, ‖scratch_finiteTensorTimeData s q a xi t‖ ^ 2 :=
      integral_mono hm hright hpoint
    _ = 2 * finiteTensorFrequencyTimeEnergy s q a := by
      rw [integral_const_mul]
      unfold finiteTensorFrequencyTimeEnergy
      rw [integral_prod _ henergy]

/-- The rho-independent `L∞` bound for the canonical tube multiplier. -/
noncomputable def canonicalTubeMultiplierUniformBound : Real :=
  (SchwartzMap.seminorm Complex 0 0) canonicalPositiveCoreMultiplier

theorem norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound
    {rho : Real} (hrho : 0 < rho) (xi : Euclidean 2) :
    ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ ≤
      canonicalTubeMultiplierUniformBound := by
  unfold scratch_canonicalBandlimitedTubeMultiplier canonicalTubeMultiplierUniformBound
  rw [canonicalBandlimitedDyadicMultiplier_apply]
  exact SchwartzMap.norm_le_seminorm Complex canonicalPositiveCoreMultiplier _

theorem norm_intDyadicLowpassMultiplier_zero_le_one
    (C : lpCutoffs 2) (xi : Euclidean 2) :
    ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ ≤ 1 := by
  rw [intDyadicLowpassMultiplier_apply]
  simpa using C.norm_le_one xi

/-- Canonical-tube modulation followed by the literal radial lowpass
projection, for one finite tensor multiplier slice. -/
noncomputable def canonicalLowpassFiniteTensorMultiplier
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (omega : Euclidean 2) : SchwartzMap (Euclidean 2) Complex :=
  kakeyaRadialLowpassPiece C
    (SchwartzMap.smulLeftCLM Complex
      (scratch_canonicalBandlimitedTubeMultiplier rho hrho : Euclidean 2 → Complex)
      (scratch_finiteTensorTubeMultiplier s q hqcompact a omega))

theorem canonicalLowpassFiniteTensorMultiplier_apply
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (omega xi : Euclidean 2) :
    canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi =
      intDyadicLowpassMultiplier C.cutoff 0 xi *
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
          scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi) := by
  unfold canonicalLowpassFiniteTensorMultiplier
  rw [kakeyaRadialLowpassPiece_apply,
    SchwartzMap.smulLeftCLM_apply_apply
      (scratch_canonicalBandlimitedTubeMultiplier rho hrho).hasTemperateGrowth]
  simp only [smul_eq_mul]

theorem norm_sq_canonicalLowpassFiniteTensorMultiplier_le_uniformBound_mul
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    (omega xi : Euclidean 2) :
    ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2 ≤
      canonicalTubeMultiplierUniformBound ^ 2 *
        ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ ^ 2 := by
  have hcut := norm_intDyadicLowpassMultiplier_zero_le_one C xi
  have hcan := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound hrho xi
  have hprod : ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ≤
      canonicalTubeMultiplierUniformBound *
        ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ := by
    rw [canonicalLowpassFiniteTensorMultiplier_apply, norm_mul, norm_mul]
    calc
      ‖intDyadicLowpassMultiplier C.cutoff 0 xi‖ *
          (‖scratch_canonicalBandlimitedTubeMultiplier rho hrho xi‖ *
            ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖) ≤
          1 * (canonicalTubeMultiplierUniformBound *
            ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖) := by
        gcongr
      _ = canonicalTubeMultiplierUniformBound *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ := by ring
  have hright : 0 ≤ canonicalTubeMultiplierUniformBound *
      ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ := by
    exact mul_nonneg (by
      dsimp [canonicalTubeMultiplierUniformBound]
      positivity) (norm_nonneg _)
  have hsq := (sq_le_sq₀ (norm_nonneg _) hright).mpr hprod
  calc
    ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2 ≤
        (canonicalTubeMultiplierUniformBound *
          ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖) ^ 2 := hsq
    _ = canonicalTubeMultiplierUniformBound ^ 2 *
        ‖scratch_finiteTensorTubeMultiplier s q hqcompact a omega xi‖ ^ 2 := by ring

/-- The actual finite-core lowpass `E₀` closure.  Its constant is independent
of the tube width `rho`; the only input energy is the joint frequency/time
energy of the compact tensor. -/
theorem integral_norm_sq_canonicalLowpassFiniteTensorMultiplier_le
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (henergy : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume))
    (omega : Euclidean 2) :
    (∫ xi : Euclidean 2,
      ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2) ≤
      canonicalTubeMultiplierUniformBound ^ 2 *
        (2 * finiteTensorFrequencyTimeEnergy s q a) := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    scratch_finiteTensorTubeMultiplier s q hqcompact a omega
  let mLow : SchwartzMap (Euclidean 2) Complex :=
    canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega
  have hm : Integrable (fun xi : Euclidean 2 => ‖m xi‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm m.continuous.aestronglyMeasurable).mp
      (m.memLp 2 volume)
  have hmLow : Integrable (fun xi : Euclidean 2 => ‖mLow xi‖ ^ 2) volume :=
    (memLp_two_iff_integrable_sq_norm mLow.continuous.aestronglyMeasurable).mp
      (mLow.memLp 2 volume)
  have hscaled : Integrable (fun xi : Euclidean 2 =>
      canonicalTubeMultiplierUniformBound ^ 2 * ‖m xi‖ ^ 2) volume :=
    hm.const_mul _
  have hpoint (xi : Euclidean 2) : ‖mLow xi‖ ^ 2 ≤
      canonicalTubeMultiplierUniformBound ^ 2 * ‖m xi‖ ^ 2 := by
    dsimp [mLow, m]
    exact norm_sq_canonicalLowpassFiniteTensorMultiplier_le_uniformBound_mul
      C rho hrho s q hqcompact a omega xi
  have hraw :=
    integral_norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_frequencyTimeEnergy
      s q hqcompact a hr ha henergy omega
  calc
    (∫ xi : Euclidean 2,
      ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2) =
        ∫ xi : Euclidean 2, ‖mLow xi‖ ^ 2 := by rfl
    _ ≤ ∫ xi : Euclidean 2,
        canonicalTubeMultiplierUniformBound ^ 2 * ‖m xi‖ ^ 2 :=
      integral_mono hmLow hscaled hpoint
    _ = canonicalTubeMultiplierUniformBound ^ 2 *
        ∫ xi : Euclidean 2, ‖m xi‖ ^ 2 := integral_const_mul _ _
    _ ≤ canonicalTubeMultiplierUniformBound ^ 2 *
        (2 * finiteTensorFrequencyTimeEnergy s q a) :=
      mul_le_mul_of_nonneg_left hraw (sq_nonneg _)

/-- The `E₀` closure with an externally supplied physical/tensor Plancherel
comparison.  Taking `E` to be the physical finite-core `L²` energy gives
the form consumed by the global lowpass companion. -/
theorem integral_norm_sq_canonicalLowpassFiniteTensorMultiplier_le_of_frequencyTimeEnergy_le
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ i, HasCompactSupport (q i : Euclidean 2 → Complex))
    (a : ι → SchwartzMap Real Complex)
    {r E : Real} (hr : r < 1)
    (ha : ∀ i, Function.support (a i : Real → Complex) ⊆
      closedBall (3 / 2 : Real) r)
    (henergy : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s q a p.1 p.2‖ ^ 2) (volume.prod volume))
    (hinput : finiteTensorFrequencyTimeEnergy s q a ≤ E)
    (omega : Euclidean 2) :
    (∫ xi : Euclidean 2,
      ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2) ≤
      canonicalTubeMultiplierUniformBound ^ 2 * (2 * E) := by
  have hbase := integral_norm_sq_canonicalLowpassFiniteTensorMultiplier_le
    C rho hrho s q hqcompact a hr ha henergy omega
  calc
    (∫ xi : Euclidean 2,
      ‖canonicalLowpassFiniteTensorMultiplier C rho hrho s q hqcompact a omega xi‖ ^ 2) ≤
        canonicalTubeMultiplierUniformBound ^ 2 *
          (2 * finiteTensorFrequencyTimeEnergy s q a) := hbase
    _ ≤ canonicalTubeMultiplierUniformBound ^ 2 * (2 * E) := by
      gcongr

/-- Exact interface still needed for the angular `E₁` closure.  The
preceding theorem proves the base energy directly.  This predicate isolates
only the missing compact-time identity/trace estimate for the literal
Fourier-side angular derivative after the fixed lowpass. -/
def HasFiniteCoreLowpassAngularTraceEnergy
    {ι : Type*} (C : lpCutoffs 2)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (E : Real) : Prop :=
  Integrable (fun p : Real × Euclidean 2 =>
    ‖intDyadicLowpassMultiplier C.cutoff 0 p.2 *
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) ∧
    (∫ p : Real × Euclidean 2,
      ‖intDyadicLowpassMultiplier C.cutoff 0 p.2 *
        finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2‖ ^ 2 ∂
        ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ E

/-- Canonical multiplication turns the exact lowpass angular-trace helper
into the `E₁` frequency bound needed by the lowpass `H¹` estimate.  The
derivative family itself is deliberately supplied: packaging it as a
Schwartz family is a regularity task independent of this energy argument. -/
theorem integral_norm_sq_canonicalLowpassAngularDerivative_le_of_traceEnergy
    {ι : Type*} (C : lpCutoffs 2) (rho : Real) (hrho : 0 < rho)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (dm : Real → SchwartzMap (Euclidean 2) Complex) (E : Real)
    (hfactor : ∀ theta xi, dm theta xi =
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi *
        (intDyadicLowpassMultiplier C.cutoff 0 xi *
          finiteTensorTubeMultiplierAngularDeriv s q a theta xi))
    (hdmint : Integrable (fun p : Real × Euclidean 2 => ‖dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    (htrace : HasFiniteCoreLowpassAngularTraceEnergy C s q a E) :
    (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤
      canonicalTubeMultiplierUniformBound ^ 2 * E := by
  let μ : Measure (Real × Euclidean 2) :=
    (volume.restrict (Icc (-Real.pi) Real.pi)).prod volume
  let d0 : Real × Euclidean 2 → Complex := fun p =>
    intDyadicLowpassMultiplier C.cutoff 0 p.2 *
      finiteTensorTubeMultiplierAngularDeriv s q a p.1 p.2
  have hd0 : Integrable (fun p : Real × Euclidean 2 => ‖d0 p‖ ^ 2) μ := by
    simpa only [d0, μ] using htrace.1
  have hscaled : Integrable (fun p : Real × Euclidean 2 =>
      canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2) μ :=
    hd0.const_mul _
  have hpoint (p : Real × Euclidean 2) : ‖dm p.1 p.2‖ ^ 2 ≤
      canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 := by
    rw [hfactor]
    have hcan := norm_scratch_canonicalBandlimitedTubeMultiplier_le_uniformBound
      hrho p.2
    have hnonneg : 0 ≤ canonicalTubeMultiplierUniformBound * ‖d0 p‖ := by
      exact mul_nonneg (by
        dsimp [canonicalTubeMultiplierUniformBound]
        positivity) (norm_nonneg _)
    have hmul : ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 * d0 p‖ ≤
        canonicalTubeMultiplierUniformBound * ‖d0 p‖ := by
      rw [norm_mul]
      exact mul_le_mul_of_nonneg_right hcan (norm_nonneg _)
    have hsq := (sq_le_sq₀ (norm_nonneg _) hnonneg).mpr hmul
    calc
      ‖scratch_canonicalBandlimitedTubeMultiplier rho hrho p.2 * d0 p‖ ^ 2 ≤
          (canonicalTubeMultiplierUniformBound * ‖d0 p‖) ^ 2 := hsq
      _ = canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 := by ring
  calc
    (∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) =
        ∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂μ := by rfl
    _ ≤ ∫ p : Real × Euclidean 2,
        canonicalTubeMultiplierUniformBound ^ 2 * ‖d0 p‖ ^ 2 ∂μ :=
      integral_mono hdmint hscaled hpoint
    _ = canonicalTubeMultiplierUniformBound ^ 2 *
        ∫ p : Real × Euclidean 2, ‖d0 p‖ ^ 2 ∂μ := integral_const_mul _ _
    _ ≤ canonicalTubeMultiplierUniformBound ^ 2 * E :=
      mul_le_mul_of_nonneg_left (by simpa only [d0, μ] using htrace.2) (sq_nonneg _)

/-- The expected compact-time phase-trace helper has a completely explicit
uniform target constant.  It is recorded separately so no unsigned-kernel
or raw signed-field domination is hidden in the lowpass argument. -/
def HasFiniteCoreLowpassAngularTraceEnergyBound
    {ι : Type*} (C : lpCutoffs 2)
    (s : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) : Prop :=
  HasFiniteCoreLowpassAngularTraceEnergy C s q a
    (400 * Real.pi ^ 3 * finiteTensorFrequencyTimeEnergy s q a)

end

