theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_eq_zero_off_lobes
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps ratio r : Real} (K n : Nat) (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    (xi : Euclidean 2) (u : Real)
    (hu : u ∉ Icc (1 / 2 : Real) 2)
    (hnu : -u ∉ Icc (1 / 2 : Real) 2) :
    shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1)
      (C.angle j xi + stationaryShift n + r * u) xi = 0 := by
  have hpos : shiftedCappedTerminalPositiveProfile n ratio (r, u) = 0 :=
    shiftedCappedTerminalPositiveProfile_eq_zero_of_not_mem_Icc n ratio r u hratio hu
  have hposderiv : deriv (fun v : Real => shiftedCappedTerminalPositiveProfile n ratio (r, v)) u = 0 := by
    apply deriv_slice_eq_zero_of_not_mem_Icc (shiftedCappedTerminalPositiveProfile n ratio) r u
    · intro v hv
      exact shiftedCappedTerminalPositiveProfile_eq_zero_of_not_mem_Icc n ratio r v hratio hv
    · exact hu
  have hneg : shiftedCappedTerminalNegativeProfile n ratio (r, u) = 0 := by
    calc
      shiftedCappedTerminalNegativeProfile n ratio (r, u) =
          shiftedCappedTerminalReflectedNegativeProfile n ratio (r, -u) := by
            simpa using (shiftedCappedTerminalNegativeProfile_reflect n ratio r (-u))
      _ = 0 := shiftedCappedTerminalReflectedNegativeProfile_eq_zero_of_not_mem_Icc
        n ratio r (-u) hratio hnu
  have hnegderiv : deriv (fun v : Real => shiftedCappedTerminalNegativeProfile n ratio (r, v)) u = 0 :=
    deriv_shiftedCappedTerminalNegativeProfile_eq_zero_of_neg_not_mem_Icc n ratio r u hratio hnu
  rw [shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_global_lobe_split
    C j s q hqcompact a K n hratio hratioDef hr u xi]
  rw [hpos, hposderiv, hneg, hnegderiv]
  simp

/-- Exact global four-analysis form of the capped terminal derivative. -/
theorem shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_eq_four_analysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps ratio r : Real} (K n : Nat) (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7) :
    ∀ theta : Real,
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1)
        theta xi =
        (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi
            ((theta - (C.angle j xi + stationaryShift n)) / r) +
          shiftedTerminalE1CutoffMinus C j s q a n ratio r xi
            ((C.angle j xi + stationaryShift n - theta) / r)) +
        (shiftedTerminalE1PhasePlus C j s q a n ratio r xi
            ((theta - (C.angle j xi + stationaryShift n)) / r) +
          shiftedTerminalE1PhaseMinus C j s q a n ratio r xi
            ((C.angle j xi + stationaryShift n - theta) / r)) := by
  have hrne : r ≠ 0 := by
    rw [hr]
    positivity
  apply affine_four_lobes_global_eq
    (fun theta => shiftedChartedCappedTelescopingMultiplierDerivRaw
      C j s q hqcompact a eps K n (K + 1) theta xi)
    (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi)
    (shiftedTerminalE1CutoffMinus C j s q a n ratio r xi)
    (shiftedTerminalE1PhasePlus C j s q a n ratio r xi)
    (shiftedTerminalE1PhaseMinus C j s q a n ratio r xi)
    r (C.angle j xi + stationaryShift n) hrne
  · exact shiftedTerminalE1CutoffPlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi
  · exact shiftedTerminalE1CutoffMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi
  · exact shiftedTerminalE1PhasePlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi
  · exact shiftedTerminalE1PhaseMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi
  · intro u hu
    have hderiv :
        deriv (fun v : Real => shiftedCappedTerminalPositiveProfile n ratio (r, v)) u =
          shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio (r, u) := by
      simpa [shiftedCappedTerminalPositiveProfile,
        shiftedCappedTerminalPositiveCutoffDerivativeProfile] using
        (deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv n
          (safeCappedTerminalPositiveLobe ratio)
          (contDiff_safeCappedTerminalPositiveLobe ratio) r u)
    have hscaled :
        (fun p : Real × Real => shiftedCappedTerminalPositiveProfile n ratio p *
          outerCircleScaledDerivative p.1 p.2) =
          shiftedCappedTerminalPositiveScaledPhaseProfile n ratio := by
      funext p
      rfl
    simpa [shiftedTerminalE1CutoffPlus, shiftedTerminalE1PhasePlus] using
      (shiftedChartedCappedTelescopingMultiplierDerivRaw_positive_E1_of_profile
        C j s q hqcompact a eps K n (K + 1)
        (shiftedCappedTerminalPositiveProfile n ratio)
        (shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio)
        (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio)
        hrne xi hpolar hn u
        (shiftedCappedTelescopingCutoffProfile_terminal_positive_eventuallyEq
          K n hratio hratioDef hr hu)
        hderiv hscaled)
  · intro u hu
    have hderiv :
        deriv (fun v : Real => shiftedCappedTerminalReflectedNegativeProfile n ratio (r, v)) u =
          shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio (r, u) := by
      simpa [shiftedCappedTerminalReflectedNegativeProfile,
        shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile] using
        (deriv_slice_shiftedReflectedOuterProfile_eq_sndDeriv n
          (safeCappedTerminalReflectedNegativeLobe ratio)
          (contDiff_safeCappedTerminalReflectedNegativeLobe ratio) r u)
    have hscaled :
        (fun p : Real × Real => shiftedCappedTerminalReflectedNegativeProfile n ratio p *
          outerCircleScaledDerivative p.1 p.2) =
          shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio := by
      funext p
      rfl
    simpa [shiftedTerminalE1CutoffMinus, shiftedTerminalE1PhaseMinus] using
      (shiftedChartedCappedTelescopingMultiplierDerivRaw_reflected_E1_of_profile
        C j s q hqcompact a eps K n (K + 1)
        (shiftedCappedTerminalReflectedNegativeProfile n ratio)
        (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio)
        (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio)
        hrne xi hpolar hn u
        (shiftedCappedTelescopingCutoffProfile_terminal_reflectedNegative_eventuallyEq
          K n hratio hratioDef hr hu)
        hderiv hscaled)
  · intro u hu hnu
    exact shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_eq_zero_off_lobes
      C j s q hqcompact a K n hratio hratioDef hr xi u hu hnu

/-- The literal terminal raw derivative has the four affine TT* lobe
energies required for E1. -/
theorem shellFrequencyEnergy_shiftedCharted_terminal_deriv_le_four_analysis
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    {eps ratio r : Real} (K n : Nat) (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2))
    (lo hi : Real) (xi : Euclidean 2)
    (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
    (hn : n < 7)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    shellFrequencyEnergy
      (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1))
      lo hi xi ≤
      2 * (
        2 * (r * (∫ u : Real, ‖shiftedTerminalE1CutoffPlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedTerminalE1CutoffMinus C j s q a n ratio r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2)))) +
        2 * (r * (∫ u : Real, ‖shiftedTerminalE1PhasePlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))) +
          r * (∫ u : Real, ‖shiftedTerminalE1PhaseMinus C j s q a n ratio r xi u‖ ^ (2 : Nat)
            ∂(volume.restrict (Icc (1 / 2 : Real) 2))))) := by
  let H : Real → Complex := scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi
  have hHcont : Continuous H := by
    dsimp [H]
    exact continuous_scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    dsimp [H]
    exact (support_scratch_finiteTensorTimeData_subset_innerSlab
      s (C.chartProfiles j q) a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  let W : Real → Complex := timeWeighted H
  have hWcont : Continuous W := by
    dsimp [W]
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hWsupport : Function.support W ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hzero
    have hHt : H t = 0 := by
      by_contra hne
      exact hzero (Function.mem_support.mpr hne)
    exact ht (by simp [W, timeWeighted, hHt])
  have hcpcont : Continuous (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1CutoffPlus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio)
      (contDiff_shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hcmcont : Continuous (shiftedTerminalE1CutoffMinus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1CutoffMinus
    apply continuous_const.mul
    exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
      (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio)
      (contDiff_shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio).continuous
      r (stationaryRadialSign n * ‖xi‖) H hHcont (by norm_num) hHsupport
  have hppgcont : Continuous (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) := by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedCappedTerminalPositiveScaledPhaseProfile n ratio 0)
  have hpmgcont : Continuous (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) := by
    simpa [HasJointSndSmooth] using
      (hasJointSndSmooth_shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio 0)
  have hppcont : Continuous (shiftedTerminalE1PhasePlus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1PhasePlus
    change Continuous (fun u : Real =>
      (-Complex.I) * (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) W u)
    let F : Real → Complex := fun u => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
        (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)) W u
    have hFcont : Continuous F := by
      dsimp [F]
      exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
        (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) hppgcont
        r (stationaryRadialSign n * ‖xi‖) W hWcont (by norm_num) hWsupport
    have hscale : Continuous (fun u : Real =>
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u) :=
      continuous_const.mul hFcont
    have hsign : Continuous (fun u : Real => (-Complex.I) *
        ((((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u)) :=
      continuous_const.mul hscale
    convert hsign using 1
    ext u
    dsimp [F]
    ring
  have hpmcont : Continuous (shiftedTerminalE1PhaseMinus C j s q a n ratio r xi) := by
    unfold shiftedTerminalE1PhaseMinus
    change Continuous (fun u : Real =>
      Complex.I * (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) *
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) W u)
    let F : Real → Complex := fun u => ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
        (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)) W u
    have hFcont : Continuous F := by
      dsimp [F]
      exact continuous_ttstarAnalysis_parametricProfile_of_compact_time_support
        (shiftedCappedTerminalReflectedNegativeScaledPhaseProfile n ratio) hpmgcont
        r (stationaryRadialSign n * ‖xi‖) W hWcont (by norm_num) hWsupport
    have hscale : Continuous (fun u : Real =>
        (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u) :=
      continuous_const.mul hFcont
    have hsign : Continuous (fun u : Real => Complex.I *
        ((((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r : Real) : Complex) * F u)) :=
      continuous_const.mul hscale
    convert hsign using 1
    ext u
    dsimp [F]
    ring
  exact shellFrequencyEnergy_affine_four_lobes_restrict_le
    (fun theta => shiftedChartedCappedTelescopingMultiplierDerivRaw
      C j s q hqcompact a eps K n (K + 1) theta xi)
    (shiftedTerminalE1CutoffPlus C j s q a n ratio r xi)
    (shiftedTerminalE1CutoffMinus C j s q a n ratio r xi)
    (shiftedTerminalE1PhasePlus C j s q a n ratio r xi)
    (shiftedTerminalE1PhaseMinus C j s q a n ratio r xi)
    r (C.angle j xi + stationaryShift n) lo hi xi (by rw [hr]; positivity)
    hcpcont hcmcont hppcont hpmcont
    (shiftedTerminalE1CutoffPlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1CutoffMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1PhasePlus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedTerminalE1PhaseMinus_eq_zero_of_not_mem_Icc C j s q a n ratio r hratio xi)
    (shiftedChartedCappedTelescopingMultiplierDerivRaw_terminal_eq_four_analysis
      C j s q hqcompact a K n hratio hratioDef hr xi hpolar hn)

theorem terminalE1_cutoffPlus_affine_energy_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota) (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (n : Nat) (ratio r : Real)
    (xi : Euclidean 2) :
    r * (∫ u : Real, ‖shiftedTerminalE1CutoffPlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      (r ^ 2)⁻¹ * shiftedFiberLobeEnergy
        (shiftedCappedTerminalPositiveCutoffDerivativeProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)
        (scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi) := by
  unfold shiftedTerminalE1CutoffPlus shiftedFiberLobeEnergy
  rw [integral_norm_sq_const_mul]
  rw [Complex.norm_real, Real.norm_eq_abs, abs_inv, inv_pow, sq_abs]
  ring

theorem terminalE1_cutoffMinus_affine_energy_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota) (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (n : Nat) (ratio r : Real)
    (xi : Euclidean 2) :
    r * (∫ u : Real, ‖shiftedTerminalE1CutoffMinus C j s q a n ratio r xi u‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      (r ^ 2)⁻¹ * shiftedFiberLobeEnergy
        (shiftedCappedTerminalReflectedNegativeCutoffDerivativeProfile n ratio) r
        (stationaryRadialSign n * ‖xi‖)
        (scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi) := by
  unfold shiftedTerminalE1CutoffMinus shiftedFiberLobeEnergy
  rw [integral_norm_sq_const_mul]
  rw [Complex.norm_real, Real.norm_eq_abs, abs_inv, abs_neg, inv_pow, sq_abs]
  ring

theorem terminalE1_phasePlus_affine_energy_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota) (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (n : Nat) (ratio r : Real)
    (xi : Euclidean 2) :
    r * (∫ u : Real, ‖shiftedTerminalE1PhasePlus C j s q a n ratio r xi u‖ ^ (2 : Nat)
      ∂(volume.restrict (Icc (1 / 2 : Real) 2))) =
      (((2 * Real.pi) * (stationaryRadialSign n * ‖xi‖) * r) ^ 2) *
        shiftedFiberLobeEnergy
          (shiftedCappedTerminalPositiveScaledPhaseProfile n ratio) r
          (stationaryRadialSign n * ‖xi‖)
          (timeWeighted (scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi)) := by
  unfold shiftedTerminalE1PhasePlus shiftedFiberLobeEnergy
  rw [integral_norm_sq_const_mul]
  rw [norm_mul]
  simp only [norm_neg, Complex.norm_I, one_mul]
  rw [Complex.norm_real, Real.norm_eq_abs, sq_abs]
  ring

theorem terminalE1_phaseMinus_affine_energy_eq
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota) (q : iota → SchwartzMap (Euclidean 2) Complex)
    (a : iota → SchwartzMap Real Complex) (n : Nat) (ratio r : Real)
