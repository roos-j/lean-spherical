/-- The compact-time signed Schur bound for a parametric real profile only
needs the finite joint smoothness actually consumed by the kernel proof.
This variant is for normalized phase profiles involving the removable sinc
factor, for which a global `ContDiff` statement is deliberately unavailable. -/
theorem exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc_of_hasJoint
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real -> Real)
    (hg0 : HasJointSndSmooth 0 g) (hg2 : HasJointSndSmooth 2 g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 ->
      ∀ t0 t1 : Real, ∀ H : Real -> Complex, Continuous H ->
      t0 <= t1 -> Function.support H ⊆ Ioc t0 t1 ->
      ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ <=
        (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  let A : Real × Real -> Complex := outerCircleParametricRealProfileProductAmplitude g
  have hA0 : HasJointSndSmooth 0 A :=
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint hg0
  have hA2 : HasJointSndSmooth 2 A :=
    hasJointSndSmooth_outerCircleParametricRealProfileProductAmplitude_of_hasJoint hg2
  have hAleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0 := by
    intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_left hleft rho
  have hAright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0 := by
    intro rho _
    exact outerCircleParametricRealProfileProductAmplitude_eventuallyEq_zero_right hright rho
  have hAstar : ∀ p, starRingEnd Complex (A p) = A p := by
    intro p
    exact star_outerCircleParametricRealProfileProductAmplitude g p
  rcases exists_outerCircleProfileFourierCharProductKernel_quadratic_E0_abs_restrict_Icc
      hrhoMax hrhoMax_small A hA0 hA2 hAleft hAright hAstar with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont htime hHsupport
  have hgcont : Continuous g := by
    simpa [HasJointSndSmooth] using hg0
  have hlocal := hbound rho hrho lambda hlambda t0 t1 H hHcont
  rw [← outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization_restrict_Icc
    g rho lambda t0 t1 hgcont H hHcont] at hlocal
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc t0 t1))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
      H htime hHsupport u
  rw [integral_norm_sq_restrict_Icc_eq_volume_of_support_subset_Ioc H htime hHsupport] at hlocal
  simpa only [hAnalysis] using hlocal

/-- The phase-coordinate `E₁` real-energy estimate corresponding to the
preceding finite-joint-smoothness Schur theorem. -/
theorem exists_outerCircleParametricRealProfile_realEnergy_scaled_E1_of_hasJoint
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real -> Real)
    (hg0 : HasJointSndSmooth 0 g) (hg2 : HasJointSndSmooth 2 g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0)
    (scale : Real) (hscale : 0 <= scale) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 ->
      ∀ t0 t1 : Real, ∀ H : Real -> Complex, Continuous H ->
      t0 <= t1 -> Function.support H ⊆ Ioc t0 t1 ->
      scale *
        (rho * ∫ u : Real,
          ‖ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
            H u‖ ^ (2 : Nat) ∂(volume.restrict (Icc (1 / 2 : Real) 2))) <=
        scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc_of_hasJoint
      hrhoMax hrhoMax_small g hg0 hg2 hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hH htime hHsupport
  have hgcont : Continuous g := by
    simpa [HasJointSndSmooth] using hg0
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hA : Continuous (Function.uncurry A) := by
    change Continuous (fun p : Real × Real =>
      (g (rho, p.1) : Complex) *
        (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex))
    have hg' : Continuous (fun p : Real × Real => g (rho, p.1)) :=
      hgcont.comp (continuous_const.prodMk continuous_fst)
    apply (Complex.continuous_ofReal.comp hg').mul
    fun_prop
  have hreal := realEnergy_eq_norm_ttstarAnalysis_of_continuous_support
    A hA H hH htime hHsupport (le_of_lt hrho.1)
  have hbase := hbound rho hrho lambda hlambda t0 t1 H hH htime hHsupport
  rw [hreal]
  dsimp only [A]
  calc
    scale * ‖(rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
            H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2))‖ <=
        scale * ((B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hbase hscale
    _ = scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖H t‖ ^ (2 : Nat) := by ring

end

