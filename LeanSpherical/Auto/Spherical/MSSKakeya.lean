section

namespace Auto.Spherical.MSS.KakeyaPositiveLinearBridge

open MeasureTheory
open Auto.Spherical.SurfaceCore
open ScratchKakeyaBandlimitedCore
open scoped BigOperators

noncomputable section

/-- A nonnegative real kernel that is the real part of a compact-frequency
complex kernel is controlled by the norm of the corresponding linear
operator on a real-valued input.  This is the precise bridge needed after
the canonical positive-core majorization: it does not incorrectly replace a
positive convolution of `|f|` by the absolute value of a convolution of an
arbitrary signed `f`. -/
theorem integral_re_mul_ofReal_le_norm_integral
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (K : X -> Complex) (F : X -> Real)
    (hK : Integrable (fun x => K x * (F x : Complex)) mu) :
    (∫ x, (K x).re * F x ∂mu) <=
      ‖∫ x, K x * (F x : Complex) ∂mu‖ := by
  have hpoint : (fun x => (K x).re * F x) =
      fun x => (K x * (F x : Complex)).re := by
    funext x
    simp [Complex.mul_re]
  rw [hpoint]
  have hre :
      (∫ x, (K x * (F x : Complex)).re ∂mu) =
        (∫ x, K x * (F x : Complex) ∂mu).re := by
    simpa using (integral_re hK)
  rw [hre]
  exact (le_abs_self _).trans (Complex.abs_re_le_norm _)

/-- The canonical positive tube core is the real part of the inverse Fourier
transform of its compact multiplier.  Hence its linear average on a
nonnegative real input is bounded by the norm of the compact-frequency tube
average.  The integrability assumption is intentionally literal so it can
be discharged by the finite inner-slab tensor model. -/
theorem canonicalTubePositiveAverage_le_norm_linearAverage
    {rho : Real} (hrho : 0 < rho)
    (F : WaveSpaceTime -> Real) (omega y : Euclidean 2)
    (hInt : Integrable (fun z : WaveSpaceTime =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (F z : Complex))
        (volume.restrict (Set.univ ×ˢ lightRayTimeInterval))) :
    (∫ z : WaveSpaceTime,
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z * F z
        ∂(volume.restrict (Set.univ ×ˢ lightRayTimeInterval))) <=
      ‖∫ z : WaveSpaceTime,
        scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y) * (F z : Complex)
        ∂(volume.restrict (Set.univ ×ˢ lightRayTimeInterval))‖ := by
  have hcore (z : WaveSpaceTime) :
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z =
        (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y)).re := by
    rw [scratch_canonicalBandlimitedTubePhysicalCore_re_eq hrho]
    unfold scratch_smoothTubeCore
    ring
  have hrewrite : (fun z : WaveSpaceTime =>
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re) rho omega y z * F z) =
      fun z =>
        (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y)).re * F z := by
    funext z
    rw [hcore]
  rw [hrewrite]
  exact integral_re_mul_ofReal_le_norm_integral _ _ _ hInt

end

end Auto.Spherical.MSS.KakeyaPositiveLinearBridge
end
