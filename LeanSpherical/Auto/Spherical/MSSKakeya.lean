/-- Density-safe reflected-profile version of the concrete low-three block.
The reflected spatial factor supplies compact support before radialization. -/
theorem reflected_finiteTensorRadialLowThree_sourceEnergy_band_bounds
    {iota : Type*} (L : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    (hm : HasCompactSupport (m : Euclidean 2 -> Complex))
    (s : Finset iota) (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∀ i ∈ Finset.range 3,
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Real, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (finiteTensorCircleRadialMultiplier s
              (fun l => reflectedTubeProfile m (q l))
