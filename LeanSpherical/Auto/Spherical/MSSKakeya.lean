/-- Joint continuity of the literal Fourier-character product kernel.  This
is the compact-time regularity input for the local symmetric-Schur lemma. -/
theorem continuous_outerCircleProfileFourierCharProductKernel
    (A : Real × Real → Complex) (hA : Continuous A) (rho lambda : Real) :
    Continuous (Function.uncurry
      (outerCircleProfileFourierCharProductKernel A rho lambda)) := by
  let f : (Real × Real) → Real → Complex := fun p u =>
    A (rho, u) *
      (Real.fourierChar (-(p.1 - p.2) * lambda * Real.cos (rho * u)) : Complex)
  have hamp : Continuous (fun u : Real => A (rho, u)) :=
    hA.comp (continuous_const.prodMk continuous_id)
  have hf : Continuous (Function.uncurry f) := by
    dsimp [f]
    apply (hamp.comp continuous_snd).mul
    fun_prop
  have hparam : Continuous (fun p : Real × Real =>
      ∫ u in Icc (1 / 2 : Real) 2, f p u) :=
    continuous_parametric_integral_of_continuous (μ := volume) hf isCompact_Icc
  have heq : (fun p : Real × Real => ∫ u in (1 / 2 : Real)..2, f p u) =
      fun p : Real × Real => ∫ u in Icc (1 / 2 : Real) 2, f p u := by
    funext p
    rw [intervalIntegral.integral_of_le (by norm_num : (1 / 2 : Real) ≤ 2),
      ← integral_Icc_eq_integral_Ioc]
  unfold outerCircleProfileFourierCharProductKernel
  change Continuous (fun p : Real × Real => (rho : Complex) *
    ∫ u in (1 / 2 : Real)..2, f p u)
  apply continuous_const.mul
  rw [heq]
  exact hparam

/-- The signed whole-line Schur envelope restricts without loss to an
arbitrary compact time interval.  All quadratic/Fubini hypotheses are
discharged by continuity and compactness. -/
theorem exists_outerCircleProfileFourierCharProductKernel_quadratic_E0_abs_restrict_Icc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (A : Real × Real → Complex) (hA0 : HasJointSndSmooth 0 A)
    (hA2 : HasJointSndSmooth 2 A)
    (hleft : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho ∈ Ioc (0 : Real) rhoMax,
      (fun u : Real => A (rho, u)) =ᶠ[nhds 2] 0)
    (hstar : ∀ p, starRingEnd Complex (A p) = A p) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ t0 t1 : Real, ∀ H : Real → Complex, Continuous H →
      ‖∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel A rho lambda t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1))‖ ≤
        (B / (|lambda| * rho)) *
          ∫ t : Real, ‖H t‖ ^ (2 : Nat) ∂(volume.restrict (Icc t0 t1)) := by
  rcases exists_outerCircleProfileFourierCharProductKernel_global_row_column_schur_abs
      hrhoMax hrhoMax_small A hA0 hA2 hleft hright hstar with ⟨B, hB, hrows⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda t0 t1 H hHcont
  let μT : Measure Real := volume.restrict (Icc t0 t1)
  have hAcont : Continuous A := by
    simpa [HasJointSndSmooth] using hA0
  have hKcont : Continuous (Function.uncurry
      (outerCircleProfileFourierCharProductKernel A rho lambda)) :=
    continuous_outerCircleProfileFourierCharProductKernel A hAcont rho lambda
  have hsymm : ∀ t s : Real,
      ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ =
        ‖outerCircleProfileFourierCharProductKernel A rho lambda s t‖ := by
    intro t s
    exact norm_outerCircleProfileFourierCharProductKernel_symm A hstar rho lambda t s
  rcases hrows rho hrho lambda hlambda with ⟨hrowAll, _⟩
  let R : Real := (2 * B) * rho *
    (Real.pi / (((2 * Real.pi) * |lambda|) * rho ^ 2))
  have hrowbound : ∀ t : Real,
      (∫ s : Real,
        ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ ∂μT) ≤ R := by
    intro t
    have hrow := hrowAll t
    calc
      (∫ s : Real,
        ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ ∂μT) ≤
          ∫ s : Real,
            ‖outerCircleProfileFourierCharProductKernel A rho lambda t s‖ :=
        integral_mono_measure Measure.restrict_le_self
          (Filter.Eventually.of_forall fun s => norm_nonneg _) hrow.1
      _ ≤ R := hrow.2
  have hschur := norm_integral_integral_restrict_Icc_le_of_symmetricSchur
    (a := t0) (b := t1)
    (outerCircleProfileFourierCharProductKernel A rho lambda) hKcont hsymm hrowbound H hHcont
  have hrho_pos : 0 < rho := hrho.1
  have habs_pos : 0 < |lambda| := abs_pos.mpr hlambda
  have hR : R = B / (|lambda| * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt habs_pos, ne_of_gt hrho_pos]
  simpa only [μT, hR] using hschur

/-- Exact compact-time `TT*` factorization for the literal parametric real
lobe.  Unlike the earlier whole-line theorem, no abstract Fubini record is
required. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization_restrict_Icc
    (g : Real × Real → Real) (rho lambda t0 t1 : Real)
    (hg : Continuous g) (H : Real → Complex) (hHcont : Continuous H) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis (volume.restrict (Icc t0 t1))
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis (volume.restrict (Icc t0 t1))
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂(volume.restrict (Icc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
  let AU : Real → Real → Complex :=
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hAUcont : Continuous (Function.uncurry AU) := by
    change Continuous (fun p : Real × Real =>
      (g (rho, p.1) : Complex) *
        (Real.fourierChar (-p.2 * lambda * Real.cos (rho * p.1)) : Complex))
    have hg' : Continuous (fun p : Real × Real => g (rho, p.1)) :=
      hg.comp (continuous_const.prodMk continuous_fst)
    apply (Complex.continuous_ofReal.comp hg').mul
    fun_prop
  have hbase := ttstar_factorization_restrict_Icc_of_continuous
    (u0 := (1 / 2 : Real)) (u1 := 2) (t0 := t0) (t1 := t1) AU hAUcont H hHcont
  have hkernel (t s : Real) :
      (rho : Complex) *
        ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s =
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
    calc
      (rho : Complex) *
          ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s =
          (rho : Complex) *
            ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2)) AU t s := by
              unfold ttstarKernel
              rw [integral_Icc_eq_integral_Ioc]
      _ = outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
            exact outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq
              g rho lambda t s
  calc
    (rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis (volume.restrict (Icc t0 t1)) AU H u *
            starRingEnd Complex
              (ttstarAnalysis (volume.restrict (Icc t0 t1)) AU H u)
          ∂(volume.restrict (Icc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ t : Real, ∫ s : Real,
            ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s * H t *
              starRingEnd Complex (H s)
            ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          rw [hbase]
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) *
          ttstarKernel (volume.restrict (Icc (1 / 2 : Real) 2)) AU t s) * H t *
          starRingEnd Complex (H s)
        ∂(volume.restrict (Icc t0 t1)) ∂(volume.restrict (Icc t0 t1)) := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with t
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with s
          ring
    _ = _ := by
      apply integral_congr_ae
      filter_upwards with t
      apply integral_congr_ae
      filter_upwards with s
      rw [hkernel]

/-- Compact-time, signed-frequency `E₀` for a parametric real lobe.  This is
the source-ready TT* fibre statement used by the inner-slab finite tensor;
all time Fubini conditions are now automatic. -/
theorem exists_outerCircleParametricRealProfile_quadratic_E0_abs_restrict_Icc
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real) (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
