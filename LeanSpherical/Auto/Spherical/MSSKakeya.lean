noncomputable section

private theorem shiftedCappedShellGlobalCommonLeft_le_pi :
    shiftedCappedShellGlobalCommonLeft <= Real.pi := by
  unfold shiftedCappedShellGlobalCommonLeft
  unfold Auto.Spherical.MSS.KakeyaCappedAngularShellReassembly.cappedShellCommonLeft
  nlinarith [Real.pi_gt_three]

/-- Direct dyadic physical hpiece estimate.  The fibre witness is selected
with its literal source-energy identity, so the output no longer contains an
abstract witness field. -/
theorem exists_shifted_dyadic_physical_hpiece_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (hj : j ∈ charts) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        {eps r lambda : Real} (heps : 0 < eps) (hlambda : 0 < lambda)
        (K k : Nat) (hk : k < K)
        (hqann : ∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda)
        (hn : n < 7)
        (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
        (hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (houter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
          1 <= ‖xi‖ * r ^ 2)
        (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
        {rTime : Real} (hrTime : rTime < 1)
        (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
          closedBall (3 / 2 : Real) rTime),
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
          ENNReal.ofReal
            (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n (k + 1)
              theta.1 y‖ ^ 2)) ∧
        (∫⁻ y : Euclidean 2,
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n (k + 1)
                theta.1 y‖ ^ 2)) <=
          ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  rcases exists_concreteAnnularShellFiberEnergyWitness_shifted_dyadic
      hrhoMax hrhoMax_small n with ⟨B, hB, hW⟩
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a eps r lambda heps hlambda
    K k hk hqann hn hr hrmem houter hscale rTime hrTime hsupport
  have hi : k + 1 ∈ Finset.range (K + 2) := by
    simp only [Finset.mem_range]
    omega
  rcases hW C j hj s q hqcompact a heps hlambda K k hk
      shiftedCappedShellGlobalCommonLeft Real.pi hqann hn hr hrmem houter
      (rTime := rTime) hrTime hsupport with ⟨W, hWh⟩
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n (k + 1)
      shiftedCappedShellGlobalCommonLeft Real.pi
  have hpiece :=
    shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_concrete_annular_witness
      C j s q hqcompact a heps K n (k + 1) hi hn hj hscale
      (hiAngle := Real.pi) (lambda := lambda) (rho := r) (B := B)
      shiftedCappedShellGlobalCommonLeft_le_pi S W hlambda hrmem.1 hB.le
  constructor
  · exact hpiece.1
  · simpa only [hWh] using hpiece.2

/-- Direct capped-terminal physical hpiece estimate, retaining the genuine
bounded terminal-ratio hypothesis rather than treating the final shell as an
unanalysed remainder. -/
theorem exists_shifted_terminal_physical_hpiece_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat)
    {ratio : Real} (hratio : ratio ∈ Icc (1 / 2 : Real) 1) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (hj : j ∈ charts) (s : Finset iota)
        (q : iota -> SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
        (a : iota -> SchwartzMap Real Complex)
        {eps r lambda : Real} (heps : 0 < eps) (hlambda : 0 < lambda)
        (K : Nat)
        (hqann : ∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda)
        (hn : n < 7)
        (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
        (hr : r = (4 / 5 : Real) * (Real.pi / 2))
        (hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (houter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
          1 <= ‖xi‖ * r ^ 2)
        (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
        {rTime : Real} (hrTime : rTime < 1)
        (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
          closedBall (3 / 2 : Real) rTime),
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
          ENNReal.ofReal
            (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n (K + 1)
              theta.1 y‖ ^ 2)) ∧
        (∫⁻ y : Euclidean 2,
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n (K + 1)
                theta.1 y‖ ^ 2)) <=
          ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  rcases exists_concreteAnnularShellFiberEnergyWitness_shifted_terminal
      hrhoMax hrhoMax_small n hratio with ⟨B, hB, hW⟩
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a eps r lambda heps hlambda K
    hqann hn hratioDef hr hrmem houter hscale rTime hrTime hsupport
  have hi : K + 1 ∈ Finset.range (K + 2) := by
    simp only [Finset.mem_range]
    omega
  rcases hW C j hj s q hqcompact a hlambda K
      shiftedCappedShellGlobalCommonLeft Real.pi hqann hn hratioDef hr hrmem houter
      (rTime := rTime) hrTime hsupport with ⟨W, hWh⟩
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n (K + 1)
      shiftedCappedShellGlobalCommonLeft Real.pi
  have hpiece :=
    shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_concrete_annular_witness
      C j s q hqcompact a heps K n (K + 1) hi hn hj hscale
      (hiAngle := Real.pi) (lambda := lambda) (rho := r) (B := B)
      shiftedCappedShellGlobalCommonLeft_le_pi S W hlambda hrmem.1 hB.le
  constructor
  · exact hpiece.1
  · simpa only [hWh] using hpiece.2

/-- Direct central (`i=0`) physical hpiece estimate.  This is deliberately
separate from the outer packages because its critical window has reciprocal
scale `4*eps`. -/
theorem exists_shifted_central_physical_hpiece_bound
    {rhoMax : Real} (hrhoMax : 0 <= rhoMax)
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (hj : j ∈ charts) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    (K n : Nat) (hn : n < 7) :
    ∃ B : Real, 0 < B ∧
      ∀ {eps lambda : Real}, 0 < eps -> 0 < lambda ->
        (4 * eps ∈ Icc (0 : Real) rhoMax) ->
        (∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda) ->
        (∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
          1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32) ->
        ((2 : Real) ^ K * eps <= Real.pi / 2) ->
        ∀ {rTime : Real}, rTime < 1 ->
          (∀ l, Function.support (a l : Real -> Complex) ⊆
            closedBall (3 / 2 : Real) rTime) ->
          Measurable (fun y : Euclidean 2 =>
            ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
              ENNReal.ofReal
                (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n 0
                  theta.1 y‖ ^ 2)) ∧
            (∫⁻ y : Euclidean 2,
              ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
                ENNReal.ofReal
                  (‖shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n 0
                    theta.1 y‖ ^ 2)) <=
              ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
                shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi ∂
                  (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  rcases exists_concreteAnnularShellFiberEnergyWitness_shifted_central
      hrhoMax C j hj s q hqcompact a K n hn
      shiftedCappedShellGlobalCommonLeft Real.pi with ⟨B, hB, hW⟩
  refine ⟨B, hB, ?_⟩
  intro eps lambda heps hlambda hrmem hqann hcritical hscale rTime hrTime hsupport
  have hi : 0 ∈ Finset.range (K + 2) := by
    simp only [Finset.mem_range]
    omega
  rcases hW heps hlambda hrmem hqann hcritical (rTime := rTime)
      hrTime hsupport with ⟨W, hWh⟩
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n 0
      shiftedCappedShellGlobalCommonLeft Real.pi
  have hpiece :=
    shiftedChartedCappedTelescopingField_endpointZeroSobolev_of_concrete_annular_witness
      C j s q hqcompact a heps K n 0 hi hn hj hscale
      (hiAngle := Real.pi) (lambda := lambda) (rho := 4 * eps) (B := B)
      shiftedCappedShellGlobalCommonLeft_le_pi S W hlambda (by positivity) hB.le
  constructor
  · exact hpiece.1
  · simpa only [hWh] using hpiece.2

end

end Auto.Spherical.MSS.KakeyaConcreteAnnularHpieceCorollaries
