section

namespace Auto.Spherical.MSS.KakeyaEnvelopeReassembly

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaAngularChartReassembly
open scoped BigOperators ENNReal

noncomputable section

/-- Finite complex-shell reassembly against pre-existing measurable
envelopes.  The angular parameters of the field and of the envelopes may
live in different types; this is the form needed when a compact endpoint-GN
interval contains the physical fundamental interval strictly. -/
theorem lintegral_iSup_sq_finite_shell_sum_le_of_envelopes
    {Theta ThetaBig X iota : Type*} [MeasurableSpace X]
    (mu : Measure X) (shells : Finset iota)
    (F : Theta -> X -> Complex) (piece : iota -> ThetaBig -> X -> Complex)
    (embed : Theta -> ThetaBig) (Q : iota -> X -> ENNReal) (B : iota -> ENNReal)
    (hdecomp : forall theta x, F theta x = ∑ i ∈ shells, piece i (embed theta) x)
    (hlocal : forall i, i ∈ shells -> forall theta x,
      ENNReal.ofReal (norm (piece i (embed theta) x) ^ 2) <= Q i x)
    (hQmeas : forall i, i ∈ shells -> Measurable (Q i))
    (hQbound : forall i, i ∈ shells -> (∫⁻ x : X, Q i x ∂mu) <= B i) :
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (norm (F theta x) ^ 2) ∂mu) <=
      (shells.card : ENNReal) * ∑ i ∈ shells, B i := by
  classical
  have hsumMeas : Measurable (fun x : X => ∑ i ∈ shells, Q i x) := by
    apply Finset.measurable_sum
    intro i hi
    exact hQmeas i hi
  have hpoint : forall x : X, (⨆ theta : Theta,
      ENNReal.ofReal (norm (F theta x) ^ 2)) <=
      (shells.card : ENNReal) * ∑ i ∈ shells, Q i x := by
    intro x
    apply iSup_le
    intro theta
    have hnorm : norm (F theta x) ^ 2 <=
        (shells.card : Real) * ∑ i ∈ shells, norm (piece i (embed theta) x) ^ 2 := by
      rw [hdecomp]
      calc
        norm (∑ i ∈ shells, piece i (embed theta) x) ^ 2 <=
            (∑ i ∈ shells, norm (piece i (embed theta) x)) ^ 2 := by
          exact pow_le_pow_left₀ (norm_nonneg _) (norm_sum_le _ _) 2
        _ <= (shells.card : Real) * ∑ i ∈ shells, norm (piece i (embed theta) x) ^ 2 := by
          exact sq_sum_le_card_mul_sum_sq
    have hnorm' : ENNReal.ofReal (norm (F theta x) ^ 2) <=
        (shells.card : ENNReal) * ∑ i ∈ shells,
          ENNReal.ofReal (norm (piece i (embed theta) x) ^ 2) := by
      calc
        ENNReal.ofReal (norm (F theta x) ^ 2) <=
            ENNReal.ofReal ((shells.card : Real) *
              ∑ i ∈ shells, norm (piece i (embed theta) x) ^ 2) :=
          ENNReal.ofReal_le_ofReal hnorm
        _ = (shells.card : ENNReal) * ∑ i ∈ shells,
            ENNReal.ofReal (norm (piece i (embed theta) x) ^ 2) := by
          rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_natCast,
            ENNReal.ofReal_sum_of_nonneg]
          intro i hi
          exact sq_nonneg _
    have hlocalSum : (∑ i ∈ shells,
        ENNReal.ofReal (norm (piece i (embed theta) x) ^ 2)) <=
        ∑ i ∈ shells, Q i x := by
      apply Finset.sum_le_sum
      intro i hi
      exact hlocal i hi theta x
    calc
      ENNReal.ofReal (norm (F theta x) ^ 2) <=
          (shells.card : ENNReal) * ∑ i ∈ shells,
            ENNReal.ofReal (norm (piece i (embed theta) x) ^ 2) := hnorm'
      _ <= (shells.card : ENNReal) * ∑ i ∈ shells, Q i x :=
        mul_le_mul' le_rfl hlocalSum
  calc
    (∫⁻ x : X, ⨆ theta : Theta,
      ENNReal.ofReal (norm (F theta x) ^ 2) ∂mu) <=
        ∫⁻ x : X, (shells.card : ENNReal) * ∑ i ∈ shells, Q i x ∂mu :=
      lintegral_mono hpoint
    _ = (shells.card : ENNReal) * (∫⁻ x : X, ∑ i ∈ shells, Q i x ∂mu) := by
      rw [lintegral_const_mul _ hsumMeas]
    _ = (shells.card : ENNReal) * ∑ i ∈ shells, ∫⁻ x : X, Q i x ∂mu := by
      rw [lintegral_finsetSum shells (fun i hi => hQmeas i hi)]
    _ <= (shells.card : ENNReal) * ∑ i ∈ shells, B i := by
      apply mul_le_mul' le_rfl
      apply Finset.sum_le_sum
      intro i hi
      exact hQbound i hi

end

end Auto.Spherical.MSS.KakeyaEnvelopeReassembly
end
