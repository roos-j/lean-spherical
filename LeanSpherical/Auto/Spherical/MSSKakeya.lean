            (inner Real (circleDirection theta) xi) by
        funext xi
        unfold shiftedChartedCappedTelescopingMultiplier
        change (↑(shiftedCappedTelescopingCutoff eps K n i (C.angle j xi) theta) : Complex) * _ = _
        rw [
