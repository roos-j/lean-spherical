noncomputable section

/-- Collapse the finite shifted-shell/chart source-energy sum using the
literal scaled four-sector overlap.  This is deliberately independent of
the physical field, so it can be applied to the exact radial-band bound
below without changing any inverse-Fourier normalization. -/
theorem le_shiftedCappedShell_scaleCost_of_raw_bound
    {iota : Type*} {lambda : Real} (hlambda : 0 < lambda) (K : Nat)
    (cost : Fin 4 × (Nat × Nat) -> Real)
    (hcost : ∀ jni ∈
      shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        0 <= cost jni)
    (s : Finset iota) (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (a : iota -> SchwartzMap Real Complex) (X : ENNReal)
    (hraw : X <=
      ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
        ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
          ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s
              ((scaledDyadicFourChartFamily lambda hlambda).chartProfiles jni.1 q) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) :
    X <=
      ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
        ((∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
          ENNReal.ofReal (4 * cost jni)) *
          (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s q a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda))))) := by
  refine hraw.trans ?_
  simpa only [mul_comm] using
    (mul_le_mul_left
      (sum_ENNReal_ofReal_shiftedCappedShell_hpieceCosts_le_four
        hlambda K cost hcost s q a)
      ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal))

/-- A literal radial-band version of the capped shifted-shell estimate.  The
only remaining inputs are scalar shell geometry for the annular carrier;
the radial multiplier, scaled four-chart family, compact slice data, and
physical field identification are all discharged here. -/
theorem exists_kakeyaRadialBandPhysicalField_shiftedCapped_annular_max_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    {rhoMax eps ratio rTerminal : Real}
    (hrhoMax : 0 <= rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (heps : 0 < eps) (K : Nat)
    (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
    (hcentralMem : 4 * eps ∈ Icc (0 : Real) rhoMax)
    (hcentralCritical : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32)
    (hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈ Ioc (0 : Real) rhoMax)
    (hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2)
    (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2))
    (hrTerminalMem : rTerminal ∈ Ioc (0 : Real) rhoMax)
    (hterminalOuter : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) ->
      1 <= ‖xi‖ * rTerminal ^ 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
            ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s
                ((scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
                  (kakeyaRadialBandScale_pos i)).chartProfiles jni.1
                  (finiteTensorRadialBandProfiles L q i)) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))) := by
  let C := scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
    (kakeyaRadialBandScale_pos i)
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport (qBand l : Euclidean 2 -> Complex) := by
    exact finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hqBandActive : ∀ l, C.SupportedOnActive (qBand l) := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  have hqBandAnn : ∀ l, Function.support (qBand l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) := by
    intro l xi hxi
    change kakeyaRadialBandPiece L (q l) i xi ≠ 0 at hxi
    exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus L (q l) i xi hxi
  rcases exists_shiftedCapped_annular_max_bound C s qBand hqBandCompact hqBandActive a
      hrhoMax hrhoMax_small heps (kakeyaRadialBandScale_pos i) K hscale hqBandAnn
      hcentralMem hcentralCritical hdyadicMem hdyadicOuter hratio hratioDef hrTerminal
      hrTerminalMem hterminalOuter hrTime hsupport
      (fun j xi => scaledChartAngle_lt_six (kakeyaRadialBandScale i) j xi) with
    ⟨cost, hcost, hbound⟩
  refine ⟨cost, ?_, ?_⟩
  · simpa only [C] using hcost
  · let F : Real -> Euclidean 2 -> Complex := fun theta y =>
      finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y
    let G : Real -> Euclidean 2 -> Complex := fun theta y =>
      kakeyaRadialBandPhysicalField L
        (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
          (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
        i theta y
    have hFG : F = G := by
      funext theta y
      dsimp only [F, G, qBand]
      exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
    change (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal (‖F theta y‖ ^ 2)) <= _ at hbound
    rw [hFG] at hbound
    simpa only [C, G] using hbound

/-- The actual radial-band estimate after the four-chart source-energy
overlap has been applied.  This turns any literal capped-shell maximum
bound into a single per-band scale cost while retaining the exact finite
chart/shift/shell coefficient sum. -/
theorem exists_kakeyaRadialBandPhysicalField_scaleCost_of_max_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i K : Nat)
    (hmax : ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
            ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s
                ((scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
                  (kakeyaRadialBandScale_pos i)).chartProfiles jni.1
                  (finiteTensorRadialBandProfiles L q i)) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i))))) :
    ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
        0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K).card : ENNReal) *
          ((∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4)) K,
            ENNReal.ofReal (4 * cost jni)) *
            (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))))) := by
  rcases hmax with ⟨cost, hcost, hbound⟩
  refine ⟨cost, hcost, ?_⟩
  exact le_shiftedCappedShell_scaleCost_of_raw_bound
    (kakeyaRadialBandScale_pos i) K cost
    (fun jni hjni => (hcost jni hjni).le)
    s (finiteTensorRadialBandProfiles L q i) a _ hbound

end

end Auto.Spherical.MSS.KakeyaConcreteRadialBandAnnular
end
