section

namespace Auto.Spherical.MSS.ScratchKakeyaReflectedEnergyRoot

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaFiniteCoreLowpassEnergy
open Auto.Spherical.MSS.KakeyaShiftedCappedFiberLobeEnergy
open Auto.Spherical.MSS.ScratchKakeyaReflectedEnergyNorm
open Auto.Spherical.MSS.ScratchKakeyaReflectedTubeTensorBridge
open scoped BigOperators ENNReal EuclideanSpace

noncomputable section

/-- Taking the square root of the reflected source-energy contraction gives
the exact `L²` normalization used by the radial narrow estimate. -/
theorem rpow_half_ENNReal_ofReal_integral_shiftedFiberSourceEnergy_reflectedCanonical_le_coreNorm
    {rho : Real} (hrho : 0 < rho)
    {ι : Type*} [Fintype ι]
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex) :
    (ENNReal.ofReal (∫ xi : Euclidean 2, shiftedFiberSourceEnergy Finset.univ
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi)) ^
        ((2 : Real)⁻¹) ≤
      ENNReal.ofReal canonicalTubeMultiplierUniformBound *
        eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume := by
  let E : ENNReal := ENNReal.ofReal (∫ xi : Euclidean 2,
    shiftedFiberSourceEnergy Finset.univ
      (fun l => reflectedTubeProfile
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) (q l)) a xi)
  let U : Real := canonicalTubeMultiplierUniformBound
  let F : ENNReal := eLpNorm (scratch_innerSlabCompactFrequencyTensor q a) 2 volume
  have hbase : E ≤ ENNReal.ofReal (U ^ (2 : Nat)) * F ^ (2 : Nat) := by
    dsimp only [E, U, F]
    exact ENNReal_ofReal_integral_shiftedFiberSourceEnergy_reflectedCanonical_le_coreNorm_sq
      hrho q a
  have hroot := ENNReal.rpow_le_rpow hbase
    (show (0 : Real) ≤ (2 : Real)⁻¹ by norm_num)
  have hU : 0 ≤ U := by
    dsimp only [U, canonicalTubeMultiplierUniformBound]
    positivity
  have hUroot : (ENNReal.ofReal (U ^ (2 : Nat))) ^ ((2 : Real)⁻¹) =
      ENNReal.ofReal U := by
    rw [ENNReal.ofReal_pow hU 2]
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  have hFroot : (F ^ (2 : Nat)) ^ ((2 : Real)⁻¹) = F := by
    rw [← ENNReal.rpow_natCast, ← ENNReal.rpow_mul]
    norm_num
  change E ^ ((2 : Real)⁻¹) ≤ ENNReal.ofReal U * F
  calc
    E ^ ((2 : Real)⁻¹) ≤
        (ENNReal.ofReal (U ^ (2 : Nat)) * F ^ (2 : Nat)) ^ ((2 : Real)⁻¹) := hroot
    _ = (ENNReal.ofReal (U ^ (2 : Nat))) ^ ((2 : Real)⁻¹) *
          (F ^ (2 : Nat)) ^ ((2 : Real)⁻¹) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : 0 ≤ (2 : Real)⁻¹)]
    _ = ENNReal.ofReal U * F := by rw [hUroot, hFroot]

end

end Auto.Spherical.MSS.ScratchKakeyaReflectedEnergyRoot
end
-- END ScratchKakeyaReflectedEnergyRoot

