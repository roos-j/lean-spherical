      finiteTensorPhysicalTimeData] using
      (integrable_sq_finiteTensorPhysicalTimeData Finset.univ q a)
  have henergy : finiteTensorFrequencyTimeEnergy Finset.univ q a =
      ∫ z : Euclidean 2 × Real, ‖f z‖ ^ 2 ∂(volume.prod volume) := by
    simpa only [f, scratch_innerSlabCompactFrequencyTensor,
      finiteTensorPhysicalTimeData] using
      finiteTensorFrequencyTimeEnergy_eq_integral_norm_sq_physical
        Finset.univ q a
