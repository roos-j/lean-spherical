section

namespace ScratchKakeyaCircleGlobalTimeSchur

open MeasureTheory Set
open ScratchKakeyaTimeEnvelope ScratchKakeyaGlobalTimeEnvelope
open ScratchKakeyaCircleTimeKernel

noncomputable section

/-- The literal smooth outer-circle product kernel has globally integrable
rows and columns with the exact all-time Schur mass.  This is the all-`ℝ`
version of the finite-interval estimate: it is tailored to the Schwartz time
profiles in the fixed-frequency finite-tensor Fourier identity. -/
theorem exists_outerCircleTTStarProductTimeKernel_global_row_column_schur
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable
            (fun s : Real => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume ∧
          (∫ s : Real, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable
            (fun t : Real => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume ∧
          (∫ t : Real, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2)) ) := by
  rcases exists_outerCircleTTStarProductTimeKernel_outer_quadratic
      hrhoMax hrhoMax_small with ⟨A, hA, houter⟩
  let B : Real := max (3 / 2 : Real) A
  have hBcentral : (3 / 2 : Real) ≤ B := le_max_left _ _
  have hBouter : A ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hA hBouter
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have hrho_pos : 0 < rho := hrho.1
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho_pos)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho_pos.le
  have hTwoBrho : 0 ≤ (2 * B) * rho := by
    exact mul_nonneg (mul_nonneg (by norm_num) hB.le) hrho_pos.le
  have hpoint : ∀ t s : Real,
      ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
        (2 * B) * rho * quadraticTimeEnvelope (lambda * rho ^ 2) t s := by
    intro t s
    apply norm_le_quadraticTimeEnvelope_of_central_outer hBrho hLambda.le
      (outerCircleTTStarProductTimeKernel rho lambda)
    · calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarProductTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro hscale
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)
  have hright_integrable : ∀ t : Real,
      Integrable
        (fun s : Real => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume := by
    intro t
    apply Integrable.mono'
    · exact (integrable_quadraticTimeEnvelope_univ (t := t) hLambda).const_mul
        ((2 * B) * rho)
    · exact (continuous_outerCircleTTStarProductTimeKernel_right rho lambda t).norm.aestronglyMeasurable
    · filter_upwards with s
      simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hpoint t s
  have hleft_integrable : ∀ s : Real,
      Integrable
        (fun t : Real => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume := by
    intro s
    apply (hright_integrable s).congr
    filter_upwards with t
    rw [norm_outerCircleTTStarProductTimeKernel_symm]
  constructor
  · intro t
    refine ⟨hright_integrable t, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hTwoBrho
      (outerCircleTTStarProductTimeKernel rho lambda) (hright_integrable t)
    intro s
    exact hpoint t s
  · intro s
    refine ⟨hleft_integrable s, ?_⟩
    apply integral_norm_le_of_quadraticTimeEnvelope_univ_column hLambda hTwoBrho
      (outerCircleTTStarProductTimeKernel rho lambda) (hleft_integrable s)
    intro t
    exact hpoint t s

end

end ScratchKakeyaCircleGlobalTimeSchur
end
-- END ScratchKakeyaCircleGlobalTimeSchur

