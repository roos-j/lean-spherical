/-- The normalized cutoff-coordinate derivative of the frozen positive
terminal family. -/
noncomputable def terminalPositiveFrozenCutoffProfile (n : Nat) :
    Real × Real → Real :=
  partialDerivSnd (fun p : Real × Real =>
    terminalPositiveFrozenProfile n p.1 p.2)

noncomputable def terminalPositiveFrozenCutoffAmplitude (n : Nat) :
    Real × Real → Complex :=
  fun p => ((terminalPositiveFrozenCutoffProfile n p) ^ 2 : Real)

theorem contDiff_terminalPositiveFrozenProfile (n : Nat) :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => terminalPositiveFrozenProfile n p.1 p.2) := by
  unfold terminalPositiveFrozenProfile shiftedCappedTerminalPositiveProfile
    shiftedOuterParametricProfile
  exact ((contDiff_shiftedStationaryPreweightProfile n).comp
    (contDiff_const.mul contDiff_snd)).mul
      contDiff_safeCappedTerminalPositiveLobe_joint

theorem contDiff_terminalPositiveFrozenCutoffAmplitude (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (terminalPositiveFrozenCutoffAmplitude n) := by
  unfold terminalPositiveFrozenCutoffAmplitude
  apply Complex.ofRealCLM.contDiff.comp
  apply ContDiff.pow
  exact contDiff_partialDerivSnd _ (contDiff_terminalPositiveFrozenProfile n)

theorem terminalPositiveFrozenCutoffProfile_eq_actual
    (n : Nat) (c u : Real) :
    terminalPositiveFrozenCutoffProfile n (c, u) =
      shiftedCappedTerminalPositiveCutoffDerivativeProfile n c
        (cappedTerminalCarrier, u) := by
  unfold terminalPositiveFrozenCutoffProfile
  rw [← deriv_slice_eq_partialDerivSnd
    (fun p : Real × Real => terminalPositiveFrozenProfile n p.1 p.2)
    ((contDiff_terminalPositiveFrozenProfile n).differentiable (by simp)) c u]
  simpa [terminalPositiveFrozenProfile,
    shiftedCappedTerminalPositiveProfile,
    shiftedCappedTerminalPositiveCutoffDerivativeProfile] using
    (deriv_slice_shiftedOuterParametricProfile_eq_sndDeriv n
      (safeCappedTerminalPositiveLobe c)
      (contDiff_safeCappedTerminalPositiveLobe c)
      cappedTerminalCarrier u)

theorem terminalPositiveFrozenCutoffAmplitude_star
    (n : Nat) (p : Real × Real) :
    starRingEnd Complex (terminalPositiveFrozenCutoffAmplitude n p) =
      terminalPositiveFrozenCutoffAmplitude n p := by
  simp [terminalPositiveFrozenCutoffAmplitude]

theorem terminalPositiveFrozenCutoffAmplitude_eventuallyEq_zero_left
    (n : Nat) {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => terminalPositiveFrozenCutoffAmplitude n (c, u)) =ᶠ[
