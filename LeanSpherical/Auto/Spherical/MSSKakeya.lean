noncomputable section

/-- The canonical `j`th physical width is a fixed rescaling of the usual
dyadic width.  This is the exact normalization needed to import the existing
broad-width start lemma. -/
theorem canonicalBandlimitedDyadic_width_eq
    {delta r : Real} (hr : 0 < r) (j : Nat) :
    delta / canonicalBandlimitedDyadicScale r j =
      (2 * delta / r) * (2 : Real) ^ j := by
  unfold canonicalBandlimitedDyadicScale
  field_simp [hr.ne']

/-- The canonical dyadic family has a literal broad tail: every scale from
`k0` onward has physical width at least `1/2`, while the preceding indices are
the finite narrow block. -/
theorem exists_canonicalBandlimitedDyadic_broadWidthStart
    {delta r : Real} (hdelta : 0 < delta) (hr : 0 < r) :
    exists k0 : Nat,
      (forall j, k0 <= j ->
        (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j) /\
      (forall j, j < k0 ->
        delta / canonicalBandlimitedDyadicScale r j < 1 / 2) := by
  have hdelta' : 0 < 2 * delta / r := by positivity
  obtain ⟨k0, hk0, hnarrow⟩ :=
    scratch_exists_dyadic_broadWidthStart (delta := 2 * delta / r) hdelta'
  refine ⟨k0, ?_, ?_⟩
  · intro j hj
    rw [canonicalBandlimitedDyadic_width_eq hr j]
    calc
      (1 / 2 : Real) <= (2 * delta / r) * (2 : Real) ^ k0 := hk0
      _ <= (2 * delta / r) * (2 : Real) ^ j := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_right₀ (by norm_num) hj
        · positivity
  · intro j hj
    rw [canonicalBandlimitedDyadic_width_eq hr j]
    exact hnarrow j hj

/-- Concrete broad-tail use of the canonical positive core at a literal unit
direction.  This is the kernel-side contribution to the unit model: it is
uniform in `omega : aux_lightRayDirection`, but is intentionally not asserted
as a bound for the signed reflected FIO envelope. -/
theorem exists_canonicalDyadic_broadPositiveEnvelope_unit
    {delta r : Real}
    (j : Nat)
    (hj : (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j)
    (K : Nat) (omega : aux_lightRayDirection) (y x : E2) (t : Real)
    (ht : t ∈ lightRayTimeInterval) :
    exists A : Real, 0 <= A /\
      HasCompactSupport
        (FourierTransform.fourier canonicalPositiveCore : E2 -> Complex) /\
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
          (delta / canonicalBandlimitedDyadicScale r j) omega.1 y (x, t) <=
        ((6 : Real) ^ K * A) *
          lightRayKernel (delta / canonicalBandlimitedDyadicScale r j) K 0 x (y, 0) := by
  have homega : ‖omega.1‖ <= 1 := by
    exact (mem_unitLightRayDirections_iff omega.1).mp omega.2 |>.le
  exact Auto.Spherical.MSS.scratch_exists_broadWidth_envelope_canonicalPositiveCore
    K hj omega.1 y x t homega ht

/-- The precise missing signed broad-width bridge.  Unlike the preceding
positive kernel theorem, this controls the actual reflected FIO scale
envelope on arbitrary signed finite tensors.  It is stated separately so the
positive broad tail is never silently substituted for it. -/
def HasCanonicalDyadicUnitSignedBroadScaleL2Estimate
    {c r : Real} (w : CanonicalReflectedScalePositiveUnitWiring c r) : Prop :=
  forall N : Nat, 3 < N -> exists B : Real, 0 <= B /\
    forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      exists k0 : Nat,
        (forall j, k0 <= j ->
          (1 / 2 : Real) <= delta / canonicalBandlimitedDyadicScale r j) /\
        forall f : WaveSpaceTime -> Complex, InnerSlabSchwartzTensorCore f ->
          forall j, k0 <= j ->
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * B) *
                eLpNorm f 2 volume

/-- Finite Minkowski packaging for the literal unit-direction canonical
envelope.  It is deliberately phrased in terms of already coefficient-weighted
one-scale estimates, so a broad-width argument can be supplied independently
of the narrow radial analysis. -/
theorem eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (delta : Real) (N : Nat) (f : WaveSpaceTime -> Complex)
    (hf : InnerSlabSchwartzTensorCore f) (M : Nat) (cost : Nat -> Real)
    (hcost : forall j, j ∈ Finset.range M -> 0 <= cost j)
    (hbound : forall j, j ∈ Finset.range M ->
      eLpNorm (fun y =>
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
          canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume) :
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume <=
      ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
        eLpNorm f 2 volume := by
  have hcoeff : forall j : Nat, 0 <= canonicalBandlimitedDyadicCoefficient N c r j := by
    intro j
    unfold canonicalBandlimitedDyadicCoefficient
    positivity
  calc
    eLpNorm (canonicalReflectedUnitFiniteEnvelope c r w.S delta N f M) 2 volume =
        eLpNorm (∑ j ∈ Finset.range M, fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply congrArg (fun h => eLpNorm h 2 volume)
          funext y
          simp only [canonicalReflectedUnitFiniteEnvelope, Finset.sum_apply]
    _ <= ∑ j ∈ Finset.range M,
        eLpNorm (fun y =>
          ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
            canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume := by
          apply eLpNorm_sum_le
          · intro j hj
            exact (measurable_const.mul (w.hScaleMeas delta N f j hf)).aestronglyMeasurable
          · norm_num
    _ <= ∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          apply Finset.sum_le_sum
          intro j hj
          exact hbound j hj
    _ = (∑ j ∈ Finset.range M,
        ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j * cost j)) *
          eLpNorm f 2 volume := by
          rw [Finset.sum_mul]
    _ = ENNReal.ofReal (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := by
          congr 1
          symm
          apply ENNReal.ofReal_sum_of_nonneg
          intro j hj
          exact mul_nonneg (hcoeff j) (hcost j hj)

/-- A one-scale narrow/broad input sufficient for the finite-envelope premise.
The broad clause is exactly the remaining signed broad-width estimate: it has
the literal `aux_lightRayDirection` supremum and no supremum over all of
`Euclidean 2`. -/
def HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate
    (w : CanonicalReflectedScalePositiveUnitWiring c r) : Prop :=
  forall N : Nat, 3 < N -> exists A B : Real,
    0 < A /\ 0 <= B /\
    forall delta : Real, 0 < delta -> delta < 1 / 2 ->
      exists k0 : Nat, exists cost : Nat -> Real,
        (forall j, 0 <= cost j) /\
        (forall j, j < k0 ->
          cost j <= A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) /\
        (forall j, k0 <= j -> cost j <= B) /\
        forall f : WaveSpaceTime -> Complex, InnerSlabSchwartzTensorCore f ->
          forall M j, j ∈ Finset.range M ->
            eLpNorm (fun y =>
              ENNReal.ofReal (canonicalBandlimitedDyadicCoefficient N c r j) *
                canonicalReflectedUnitScaleEnvelope w.S delta N f j y) 2 volume <=
              ENNReal.ofReal
                (canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                  eLpNorm f 2 volume

/-- Per-scale narrow/broad estimates assemble into the exact finite
unit-envelope premise consumed by the positive-square Fatou closure. -/
theorem hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate_of_weightedScale
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hscale : HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate w) :
    HasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate (w.toUnitModel hc hr) := by
  intro N hN
  obtain ⟨A, B, hA, hB, hdelta⟩ := hscale N hN
  refine ⟨c, r, A, B, hc, hr, hA, hB, ?_⟩
  intro delta hdeltaPos hdeltaSmall
  obtain ⟨k0, cost, hcost, hnarrow, hbroad, hscaleBound⟩ :=
    hdelta delta hdeltaPos hdeltaSmall
  refine ⟨k0, cost, hnarrow, hbroad, ?_⟩
  intro f hf M
  exact eLpNorm_canonicalReflectedUnitFiniteEnvelope_le_of_weightedScaleBounds
    hc hr w delta N f hf M cost
    (fun j hj => hcost j)
    (fun j hj => hscaleBound f hf M j hj)

/-- Direct terminal wrapper for the literal unit-direction reflected-square
wiring.  The only remaining analytic assumption is the stated one-scale
narrow/broad signed-envelope estimate. -/
theorem hasLightRayMaximalEstimate_of_canonicalReflectedSquareUnitWeightedScale
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (w : CanonicalReflectedScalePositiveUnitWiring c r)
    (hscale : HasCanonicalDyadicUnitWeightedScaleNarrowBroadL2Estimate w) :
    HasLightRayMaximalEstimate :=
  hasLightRayMaximalEstimate_of_canonicalDyadicUnitNarrowBroadFiniteEnvelope
    (w.toUnitModel hc hr)
    (hasCanonicalDyadicUnitNarrowBroadFiniteEnvelopeL2Estimate_of_weightedScale
      hc hr w hscale)

end

end Auto.Spherical.MSS.ScratchKakeyaCanonicalReflectedSquareUnitWiring
end
-- END ScratchKakeyaUnitFiniteEnvelopeScaleAdapter

-- BEGIN ScratchKakeyaCanonicalAbsoluteBroadBridge
section

namespace Auto.Spherical.MSS.ScratchKakeyaCanonicalAbsoluteBroadBridge

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
open Auto.Spherical.MSS.BandlimitedPositiveCore
open Auto.Spherical.MSS.ScratchKakeyaCanonicalReflectedSquareUnitWiring
open scoped BigOperators ENNReal EuclideanSpace FourierTransform

noncomputable section

abbrev E2 := Euclidean 2

/-- The fixed nonnegative Schwartz profile which is the absolute value of the
complex canonical physical core.  This is the correct broad-width profile for
a signed tube field; using only the real part would lose the required norm
domination. -/
noncomputable def canonicalAbsoluteCore : SchwartzMap E2 Real :=
  BandlimitedPositiveCore.scratch_positiveSchwartzCore
    (FourierTransform.fourierInv canonicalFrequencyBump)

theorem canonicalAbsoluteCore_apply (u : E2) :
    canonicalAbsoluteCore u = ‖canonicalPositiveCore u‖ := by
  unfold canonicalAbsoluteCore
  rw [canonicalPositiveCore_apply_eq_normSq,
    BandlimitedPositiveCore.scratch_positiveSchwartzCore_apply]
  rw [Complex.norm_real]
  exact (abs_of_nonneg (Complex.normSq_nonneg _)).symm

/-- Exact absolute-value scaling for the complex canonical tube kernel. -/
theorem norm_scratch_canonicalBandlimitedTubePhysicalCore_eq
    {rho : Real} (hrho : 0 < rho) (u : E2) :
    ‖Auto.Spherical.MSS.scratch_canonicalBandlimitedTubePhysicalCore rho hrho u‖ =
      (rho⁻¹) ^ 2 * canonicalAbsoluteCore (rho⁻¹ • u) := by
  have hscale : canonicalBandlimitedDyadicScale (2 / rho) 0 = rho⁻¹ := by
    unfold canonicalBandlimitedDyadicScale
    field_simp [hrho.ne']
  change ‖canonicalBandlimitedDyadicPhysicalCore (2 / rho) (by positivity) 0 u‖ = _
  rw [canonicalBandlimitedDyadicPhysicalCore_apply]
  rw [hscale]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
  rw [← canonicalAbsoluteCore_apply]

/-- The absolute value of the literal canonical convolution kernel is exactly
the positive smooth tube core associated to `canonicalAbsoluteCore`. -/
theorem norm_canonicalTubeKernel_eq_smoothTubeCore
    {rho : Real} (hrho : 0 < rho)
    (omega y x : E2) (t : Real) :
    ‖FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
          E2 -> Complex)
        (x + t • omega - y)‖ =
      scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) := by
  rw [← SchwartzMap.fourierInv_coe]
  change ‖Auto.Spherical.MSS.scratch_canonicalBandlimitedTubePhysicalCore rho hrho
      (x + t • omega - y)‖ = _
  rw [norm_scratch_canonicalBandlimitedTubePhysicalCore_eq hrho]
  rfl

/-- The absolute canonical profile has the required arbitrary-order broad
Schwartz-decay certificate. -/
theorem exists_canonicalAbsoluteCore_le_lightRayDecayProfile (K : Nat) :
    exists A : Real, 0 <= A /\
      forall u : E2,
        canonicalAbsoluteCore u <= A * lightRayDecayProfile K u :=
  Auto.Spherical.MSS.scratch_schwartz_le_lightRayDecayProfile
    canonicalAbsoluteCore K

/-- The literal signed convolution by the canonical multiplier, before the
positive broad-width domination is applied. -/
noncomputable def canonicalTubeSignedAverage
    (rho : Real) (hrho : 0 < rho) (omega y : E2)
    (f : WaveSpaceTime -> Complex) : Complex :=
  ∫ t in lightRayTimeInterval, ∫ x : E2,
    FourierTransform.fourierInv
      (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
        E2 -> Complex)
      (x + t • omega - y) * f (x, t)

/-- Absolute-value domination of a signed canonical tube convolution by the
positive smooth-tube average with `canonicalAbsoluteCore`.  The two outer
integrability assumptions are precisely what is needed to
pass the two norm-of-integral inequalities. -/
theorem norm_canonicalTubeSignedAverage_le_positiveSmoothTubeAverage
    {rho : Real} (hrho : 0 < rho) (omega y : E2)
    (f : WaveSpaceTime -> Complex)
    (houter : Integrable (fun t : Real => ∫ x : E2,
      FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
          E2 -> Complex)
        (x + t • omega - y) * f (x, t))
      (volume.restrict lightRayTimeInterval))
    (habsOuter : Integrable (fun t : Real => ∫ x : E2,
      ‖FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
          E2 -> Complex)
        (x + t • omega - y) * f (x, t)‖)
      (volume.restrict lightRayTimeInterval)) :
    ‖canonicalTubeSignedAverage rho hrho omega y f‖ <=
      scratch_positiveSmoothTubeAverage canonicalAbsoluteCore rho omega y
        (fun x t => ‖f (x, t)‖) := by
  unfold canonicalTubeSignedAverage
  calc
    ‖∫ t in lightRayTimeInterval, ∫ x : E2,
        FourierTransform.fourierInv
          (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
            E2 -> Complex)
          (x + t • omega - y) * f (x, t)‖ <=
        ∫ t in lightRayTimeInterval, ‖∫ x : E2,
          FourierTransform.fourierInv
            (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
              E2 -> Complex)
            (x + t • omega - y) * f (x, t)‖ :=
      norm_integral_le_integral_norm _
    _ <= ∫ t in lightRayTimeInterval, ∫ x : E2,
        ‖FourierTransform.fourierInv
          (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho hrho :
            E2 -> Complex)
          (x + t • omega - y) * f (x, t)‖ := by
        apply integral_mono houter.norm habsOuter
        intro t
        exact norm_integral_le_integral_norm _
    _ = scratch_positiveSmoothTubeAverage canonicalAbsoluteCore rho omega y
        (fun x t => ‖f (x, t)‖) := by
        unfold scratch_positiveSmoothTubeAverage
        apply integral_congr_ae
        filter_upwards with t
        apply integral_congr_ae
        filter_upwards with x
        rw [norm_mul, norm_canonicalTubeKernel_eq_smoothTubeCore hrho]

/-- Broad-width domination with a prescribed Schwartz-decay constant.  Keeping
`A` explicit is important when the estimate is assembled over all broad
dyadic scales: one constant is chosen once for a fixed decay order. -/
theorem norm_canonicalTubeSignedAverage_le_zeroDirectionPositiveEnvelope_of_decay
    (K : Nat) (A : Real) (hA : 0 <= A)
    (hdecay : forall u : E2,
      canonicalAbsoluteCore u <= A * lightRayDecayProfile K u)
    {rho : Real} (hrho : (1 / 2 : Real) <= rho)
    (omega y : E2) (homega : ‖omega‖ <= 1)
    (f : WaveSpaceTime -> Complex)
    (houter : Integrable (fun t : Real => ∫ x : E2,
      FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho
          (lt_of_lt_of_le (by norm_num) hrho) : E2 -> Complex)
        (x + t • omega - y) * f (x, t))
      (volume.restrict lightRayTimeInterval))
    (habsOuter : Integrable (fun t : Real => ∫ x : E2,
      ‖FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho
          (lt_of_lt_of_le (by norm_num) hrho) : E2 -> Complex)
        (x + t • omega - y) * f (x, t)‖)
      (volume.restrict lightRayTimeInterval))
    (hcoreSlice : forall t, Integrable (fun x : E2 =>
      scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
        ‖f (x, t)‖) volume)
    (henvSlice : forall t, Integrable (fun x : E2 =>
      lightRayKernel rho K 0 x (y, 0) * ‖f (x, t)‖) volume)
    (hcoreTime : Integrable (fun t : Real => ∫ x : E2,
      scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
        ‖f (x, t)‖) (volume.restrict lightRayTimeInterval))
    (henvTime : Integrable (fun t : Real => ∫ x : E2,
      lightRayKernel rho K 0 x (y, 0) * ‖f (x, t)‖)
      (volume.restrict lightRayTimeInterval)) :
    ‖canonicalTubeSignedAverage rho (lt_of_lt_of_le (by norm_num) hrho)
      omega y f‖ <=
      ((6 : Real) ^ K * A) *
        scratch_zeroDirectionPositiveEnvelope rho K y (fun x t => ‖f (x, t)‖) := by
  let hrho' : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  calc
    ‖canonicalTubeSignedAverage rho hrho' omega y f‖ <=
        scratch_positiveSmoothTubeAverage canonicalAbsoluteCore rho omega y
          (fun x t => ‖f (x, t)‖) := by
      exact norm_canonicalTubeSignedAverage_le_positiveSmoothTubeAverage
        hrho' omega y f houter habsOuter
    _ <= ((6 : Real) ^ K * A) *
        scratch_zeroDirectionPositiveEnvelope rho K y (fun x t => ‖f (x, t)‖) := by
      exact Auto.Spherical.MSS.scratch_positiveSmoothTubeAverage_le_zeroDirectionPositiveEnvelope_of_decay
        canonicalAbsoluteCore K hA hdecay hrho omega y homega
          (fun x t => ‖f (x, t)‖)
          (fun x t => norm_nonneg _) hcoreSlice henvSlice hcoreTime henvTime

/-- Broad-width domination for the actual signed canonical convolution.  The
constant depends only on the fixed absolute core and on `K`, never on the
physical width, direction, or input tensor. -/
theorem exists_norm_canonicalTubeSignedAverage_le_zeroDirectionPositiveEnvelope
    (K : Nat) {rho : Real} (hrho : (1 / 2 : Real) <= rho)
    (omega y : E2) (homega : ‖omega‖ <= 1)
    (f : WaveSpaceTime -> Complex)
    (houter : Integrable (fun t : Real => ∫ x : E2,
      FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho
          (lt_of_lt_of_le (by norm_num) hrho) : E2 -> Complex)
        (x + t • omega - y) * f (x, t))
      (volume.restrict lightRayTimeInterval))
    (habsOuter : Integrable (fun t : Real => ∫ x : E2,
      ‖FourierTransform.fourierInv
        (Auto.Spherical.MSS.scratch_canonicalBandlimitedTubeMultiplier rho
          (lt_of_lt_of_le (by norm_num) hrho) : E2 -> Complex)
        (x + t • omega - y) * f (x, t)‖)
      (volume.restrict lightRayTimeInterval))
    (hcoreSlice : forall t, Integrable (fun x : E2 =>
      scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
        ‖f (x, t)‖) volume)
    (henvSlice : forall t, Integrable (fun x : E2 =>
      lightRayKernel rho K 0 x (y, 0) * ‖f (x, t)‖) volume)
    (hcoreTime : Integrable (fun t : Real => ∫ x : E2,
      scratch_smoothTubeCore canonicalAbsoluteCore rho omega y (x, t) *
        ‖f (x, t)‖) (volume.restrict lightRayTimeInterval))
    (henvTime : Integrable (fun t : Real => ∫ x : E2,
      lightRayKernel rho K 0 x (y, 0) * ‖f (x, t)‖)
      (volume.restrict lightRayTimeInterval)) :
    exists A : Real, 0 <= A /\
      ‖canonicalTubeSignedAverage rho (lt_of_lt_of_le (by norm_num) hrho)
        omega y f‖ <=
        ((6 : Real) ^ K * A) *
          scratch_zeroDirectionPositiveEnvelope rho K y (fun x t => ‖f (x, t)‖) := by
  let hrho' : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  obtain ⟨A, hA, hdecay⟩ :=
    exists_canonicalAbsoluteCore_le_lightRayDecayProfile K
  refine ⟨A, hA, ?_⟩
  exact norm_canonicalTubeSignedAverage_le_zeroDirectionPositiveEnvelope_of_decay
    K A hA hdecay hrho omega y homega f
    houter habsOuter hcoreSlice henvSlice hcoreTime henvTime

/-- A pointwise `ENNReal` majorant by a nonnegative real function transfers
to the literal `L²` seminorm with the expected scalar factor. -/
theorem eLpNorm_ennreal_le_ofReal_mul_real
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (F : X -> ENNReal) (Z : X -> Real) (C : Real)
    (hC : 0 <= C) (hZ : forall x, 0 <= Z x)
    (hpoint : forall x, F x <= ENNReal.ofReal (C * Z x)) :
    eLpNorm F 2 mu <= ENNReal.ofReal C * eLpNorm Z 2 mu := by
  calc
    eLpNorm F 2 mu <= eLpNorm (fun x => C * Z x) 2 mu := by
      apply eLpNorm_mono_enorm
      intro x
      simp only [enorm_eq_self, enorm_eq_nnnorm]
      rw [Real.nnnorm_of_nonneg (mul_nonneg hC (hZ x))]
      rw [← ENNReal.ofReal_eq_coe_nnreal (mul_nonneg hC (hZ x))]
      exact hpoint x
    _ = ENNReal.ofReal C * eLpNorm Z 2 mu := by
      change eLpNorm (C • Z) 2 mu = _
      rw [eLpNorm_const_smul]
      rw [← ofReal_norm C, Real.norm_eq_abs, abs_of_nonneg hC]

/-- The literal compact unit-direction supremum is bounded by any uniform
per-direction majorant, with no choice of maximizing direction. -/
theorem canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise
    (S : Real -> Nat -> (WaveSpaceTime -> Complex) -> Nat -> E2 -> E2 -> Complex)
    (delta : Real) (N : Nat) (f : WaveSpaceTime -> Complex) (j : Nat) (y : E2)
    (H : ENNReal)
    (hpoint : forall omega : aux_lightRayDirection,
      ENNReal.ofReal ‖S delta N f j omega.1 y‖ <= H) :
    canonicalReflectedUnitScaleEnvelope S delta N f j y <= H := by
  unfold canonicalReflectedUnitScaleEnvelope
  exact iSup_le hpoint

/-- The preceding supremum bound together with a real positive majorant gives
the one-scale `L²` inequality required by the finite-envelope model. -/
theorem eLpNorm_canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise_real
    (S : Real -> Nat -> (WaveSpaceTime -> Complex) -> Nat -> E2 -> E2 -> Complex)
    (delta : Real) (N : Nat) (f : WaveSpaceTime -> Complex) (j : Nat)
    (Z : E2 -> Real) (C : Real) (hC : 0 <= C) (hZ : forall y, 0 <= Z y)
    (hpoint : forall (omega : aux_lightRayDirection) y,
      ENNReal.ofReal ‖S delta N f j omega.1 y‖ <= ENNReal.ofReal (C * Z y)) :
    eLpNorm (canonicalReflectedUnitScaleEnvelope S delta N f j) 2 volume <=
      ENNReal.ofReal C * eLpNorm Z 2 volume := by
  apply eLpNorm_ennreal_le_ofReal_mul_real volume
    (canonicalReflectedUnitScaleEnvelope S delta N f j) Z C hC hZ
  intro y
  apply canonicalReflectedUnitScaleEnvelope_le_of_unit_pointwise
  intro omega
  exact hpoint omega y

end

end Auto.Spherical.MSS.ScratchKakeyaCanonicalAbsoluteBroadBridge
end
-- END ScratchKakeyaCanonicalAbsoluteBroadBridge

