/-- Product measure corresponding exactly to the finite time slab in a
literal light-ray average. -/
noncomputable def scratchLightRayMeasure : Measure WaveSpaceTime :=
  (volume : Measure (Euclidean 2)).prod
    ((volume : Measure Real).restrict lightRayTimeInterval)

theorem scratchLightRayMeasure_le_volume :
    scratchLightRayMeasure <= (volume : Measure WaveSpaceTime) := by
  unfold scratchLightRayMeasure
  change (volume : Measure (Euclidean 2)).prod
      ((volume : Measure Real).restrict lightRayTimeInterval) <=
    (volume : Measure (Euclidean 2)).prod (volume : Measure Real)
  exact Measure.prod_mono le_rfl Measure.restrict_le_self

theorem scratch_lightRayKernel_sq_eq_scale_mul_double
    {delta : Real} (N : Nat) (omega y x : Euclidean 2) (t : Real) :
    lightRayKernel delta N omega y (x, t) ^ 2 =
      (delta⁻¹) ^ 2 * lightRayKernel delta (2 * N) omega y (x, t) := by
  unfold lightRayKernel
  ring

theorem scratch_integrable_sq_lightRayKernel_spatial
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : Euclidean 2) (t : Real) :
    Integrable (fun x : Euclidean 2 =>
      lightRayKernel delta N omega y (x, t) ^ 2) volume := by
  have hdouble : 2 < 2 * N := by omega
  have hbase := integrable_lightRayKernel_spatial hdelta (2 * N) hdouble omega y t
  rw [show (fun x : Euclidean 2 =>
      lightRayKernel delta N omega y (x, t) ^ 2) =
      fun x : Euclidean 2 => (delta⁻¹) ^ 2 *
        lightRayKernel delta (2 * N) omega y (x, t) by
    funext x
    exact scratch_lightRayKernel_sq_eq_scale_mul_double N omega y x t]
  exact hbase.const_mul _

theorem scratch_integrable_sq_lightRayKernel_spaceTime
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : Euclidean 2) :
    Integrable (fun z : WaveSpaceTime =>
      lightRayKernel delta N omega y (z.1, z.2) ^ 2)
      scratchLightRayMeasure := by
  let F : WaveSpaceTime -> Real := fun z =>
    lightRayKernel delta N omega y (z.1, z.2) ^ 2
  have hFcont : Continuous F := by
    dsimp only [F]
    unfold lightRayKernel
    have hline : Continuous (fun z : WaveSpaceTime =>
        z.1 + z.2 • omega - y) := by fun_prop
    have hne : forall z : WaveSpaceTime,
        1 + delta⁻¹ * norm (z.1 + z.2 • omega - y) ≠ 0 := by
      intro z
      positivity
    have hinv : Continuous (fun z : WaveSpaceTime =>
        (1 + delta⁻¹ * norm (z.1 + z.2 • omega - y))⁻¹) :=
      (continuous_const.add (hline.norm.const_mul delta⁻¹)).inv₀ hne
    exact (continuous_const.mul (hinv.pow N)).pow 2
  unfold scratchLightRayMeasure
  apply (integrable_prod_iff' hFcont.aestronglyMeasurable).mpr
  constructor
  · filter_upwards with t
    exact scratch_integrable_sq_lightRayKernel_spatial hdelta N hN omega y t
  · let C : Real := (delta⁻¹) ^ 2 * ∫ u : Euclidean 2,
      lightRayDecayProfile (2 * N) u
    have htime : (fun t : Real => ∫ x : Euclidean 2, norm (F (x, t))) =
        fun _ : Real => C := by
      funext t
      dsimp only [F, C]
      calc
        (∫ x : Euclidean 2,
            norm (lightRayKernel delta N omega y (x, t) ^ 2)) =
            ∫ x : Euclidean 2, lightRayKernel delta N omega y (x, t) ^ 2 := by
              apply integral_congr_ae
              filter_upwards with x
              rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        _ = (delta⁻¹) ^ 2 * ∫ u : Euclidean 2,
            lightRayDecayProfile (2 * N) u := by
              rw [show (fun x : Euclidean 2 =>
                lightRayKernel delta N omega y (x, t) ^ 2) =
                fun x : Euclidean 2 => (delta⁻¹) ^ 2 *
                  lightRayKernel delta (2 * N) omega y (x, t) by
                funext x
                exact scratch_lightRayKernel_sq_eq_scale_mul_double N omega y x t,
                integral_const_mul,
                integral_lightRayKernel_spatial_eq_decayProfile hdelta (2 * N) omega y t]
    rw [htime]
    letI : IsFiniteMeasure ((volume : Measure Real).restrict lightRayTimeInterval) := by
      unfold lightRayTimeInterval
      infer_instance
    exact integrable_const _

theorem scratch_memLp_two_lightRayKernel_spaceTime
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : Euclidean 2) :
    MemLp (fun z : WaveSpaceTime => lightRayKernel delta N omega y z) 2
      scratchLightRayMeasure := by
  have hmeas : AEStronglyMeasurable
      (fun z : WaveSpaceTime => lightRayKernel delta N omega y z)
      scratchLightRayMeasure := by
    simpa using
      (aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
        scratchLightRayMeasure delta N (fun _ : Euclidean 2 => omega)
        (fun _ : WaveSpaceTime => y) Prod.fst Prod.snd
        aestronglyMeasurable_const aemeasurable_const
        measurable_fst.aemeasurable measurable_snd.aemeasurable)
  apply (memLp_two_iff_integrable_sq hmeas).2
  exact scratch_integrable_sq_lightRayKernel_spaceTime hdelta N hN omega y

theorem scratch_integrable_lightRayKernel_mul_norm_of_memLp
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (omega y : Euclidean 2) (g : WaveSpaceTime -> Complex)
    (hg : MemLp g 2 volume) :
    Integrable (fun z : WaveSpaceTime =>
      lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure := by
  have hgslab : MemLp g 2 scratchLightRayMeasure :=
    hg.mono_measure scratchLightRayMeasure_le_volume
  change Integrable
    ((fun z : WaveSpaceTime => lightRayKernel delta N omega y z) *
      fun z : WaveSpaceTime => norm (g z)) scratchLightRayMeasure
  exact (scratch_memLp_two_lightRayKernel_spaceTime hdelta N hN omega y).integrable_mul
    hgslab.norm

theorem scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
    (delta : Real) (N : Nat) (omega y : Euclidean 2)
    (g : WaveSpaceTime -> Complex)
    (hprod : Integrable (fun z : WaveSpaceTime =>
      lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      lightRayKernel delta N omega y z * norm (g z) ∂scratchLightRayMeasure) =
      lightRayAverage delta N omega y g := by
  unfold scratchLightRayMeasure
  calc
    (∫ z : WaveSpaceTime,
        lightRayKernel delta N omega y z * norm (g z)
        ∂(volume : Measure (Euclidean 2)).prod
          ((volume : Measure Real).restrict lightRayTimeInterval)) =
      ∫ x : Euclidean 2, ∫ t : Real in lightRayTimeInterval,
        lightRayKernel delta N omega y (x, t) * norm (g (x, t)) :=
      integral_prod _ hprod
    _ = ∫ t : Real in lightRayTimeInterval, ∫ x : Euclidean 2,
        lightRayKernel delta N omega y (x, t) * norm (g (x, t)) :=
      integral_integral_swap hprod
    _ = lightRayAverage delta N omega y g := rfl

/-- A null modification of the space-time input leaves every literal tube
integral unchanged, once the displayed product integrals are defined.  This
is much simpler here than for spherical averages because the input is not
pulled back to a lower-dimensional fibre. -/
theorem scratch_lightRayAverage_eq_of_ae_eq_of_integrable
    (delta : Real) (N : Nat) {g h : WaveSpaceTime -> Complex}
    (hgh : g =ᵐ[volume] h)
    (hg : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure)
    (hh : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (h z)) scratchLightRayMeasure)
    (omega y : Euclidean 2) :
    lightRayAverage delta N omega y g = lightRayAverage delta N omega y h := by
  have hghslab : g =ᵐ[scratchLightRayMeasure] h :=
    (ae_mono scratchLightRayMeasure_le_volume) hgh
  have hintegral :
      (∫ z : WaveSpaceTime,
        lightRayKernel delta N omega y z * norm (g z) ∂scratchLightRayMeasure) =
      ∫ z : WaveSpaceTime,
        lightRayKernel delta N omega y z * norm (h z) ∂scratchLightRayMeasure := by
    apply integral_congr_ae
    filter_upwards [hghslab] with z hz
    rw [hz]
  rw [← scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
      delta N omega y g (hg omega y),
    ← scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
      delta N omega y h (hh omega y)]
  exact hintegral

/-- Under the same full-slab integrability hypothesis, the literal continuum
supremum is representative-safe pointwise (not merely almost everywhere). -/
theorem scratch_lightRayMaximal_eq_of_ae_eq_of_integrable
    (delta : Real) (N : Nat) {g h : WaveSpaceTime -> Complex}
    (hgh : g =ᵐ[volume] h)
    (hg : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure)
    (hh : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (h z)) scratchLightRayMeasure) :
    lightRayMaximal delta N g = lightRayMaximal delta N h := by
  funext y
  unfold lightRayMaximal
  congr 1
  ext r
  constructor
  · rintro ⟨omega, homega, hr⟩
    refine ⟨omega, homega, ?_⟩
    rw [← hr]
    exact (scratch_lightRayAverage_eq_of_ae_eq_of_integrable delta N hgh hg hh omega y).symm
  · rintro ⟨omega, homega, hr⟩
    refine ⟨omega, homega, ?_⟩
    rw [← hr]
    exact scratch_lightRayAverage_eq_of_ae_eq_of_integrable delta N hgh hg hh omega y

theorem scratch_lightRayAverage_eq_of_ae_eq_slab_of_integrable
    (delta : Real) (N : Nat) {g h : WaveSpaceTime -> Complex}
    (hgh : g =ᵐ[scratchLightRayMeasure] h)
    (hg : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure)
    (hh : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (h z)) scratchLightRayMeasure)
    (omega y : Euclidean 2) :
    lightRayAverage delta N omega y g = lightRayAverage delta N omega y h := by
  have hintegral :
      (∫ z : WaveSpaceTime,
        lightRayKernel delta N omega y z * norm (g z) ∂scratchLightRayMeasure) =
      ∫ z : WaveSpaceTime,
        lightRayKernel delta N omega y z * norm (h z) ∂scratchLightRayMeasure := by
    apply integral_congr_ae
    filter_upwards [hgh] with z hz
    rw [hz]
  rw [← scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
      delta N omega y g (hg omega y),
    ← scratch_integral_lightRayKernel_mul_norm_eq_lightRayAverage
      delta N omega y h (hh omega y)]
  exact hintegral

theorem scratch_lightRayMaximal_eq_of_ae_eq_slab_of_integrable
    (delta : Real) (N : Nat) {g h : WaveSpaceTime -> Complex}
    (hgh : g =ᵐ[scratchLightRayMeasure] h)
    (hg : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (g z)) scratchLightRayMeasure)
    (hh : forall omega y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * norm (h z)) scratchLightRayMeasure) :
    lightRayMaximal delta N g = lightRayMaximal delta N h := by
  funext y
  unfold lightRayMaximal
  congr 1
  ext r
  constructor
  · rintro ⟨omega, homega, hr⟩
    refine ⟨omega, homega, ?_⟩
    rw [← hr]
    exact (scratch_lightRayAverage_eq_of_ae_eq_slab_of_integrable
      delta N hgh hg hh omega y).symm
  · rintro ⟨omega, homega, hr⟩
    refine ⟨omega, homega, ?_⟩
    rw [← hr]
    exact scratch_lightRayAverage_eq_of_ae_eq_slab_of_integrable
      delta N hgh hg hh omega y

noncomputable def scratch_lightRayTimeRestriction
    (g : WaveSpaceTime -> Complex) : WaveSpaceTime -> Complex :=
  {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval}.indicator g

theorem scratch_measurableSet_lightRayTimeSlab :
    MeasurableSet {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval} := by
  exact measurableSet_preimage measurable_snd (by
    unfold lightRayTimeInterval
    exact measurableSet_Icc)

theorem scratch_ae_mem_lightRayTimeInterval :
    ∀ᵐ z : WaveSpaceTime ∂scratchLightRayMeasure,
      z.2 ∈ lightRayTimeInterval := by
  unfold scratchLightRayMeasure
  apply (Measure.ae_prod_iff_ae_ae ?_).2
  · filter_upwards with x
    exact ae_restrict_mem (by
      unfold lightRayTimeInterval
      exact measurableSet_Icc)
  · change MeasurableSet {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval}
    exact scratch_measurableSet_lightRayTimeSlab

theorem scratch_ae_eq_lightRayTimeRestriction_slab
    (g : WaveSpaceTime -> Complex) :
    g =ᵐ[scratchLightRayMeasure] scratch_lightRayTimeRestriction g := by
  filter_upwards [scratch_ae_mem_lightRayTimeInterval] with z hz
  change g z = {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval}.indicator g z
  have hz' : z ∈ {w : WaveSpaceTime | w.2 ∈ lightRayTimeInterval} := hz
  exact (Set.indicator_of_mem hz' g).symm

theorem scratch_memLp_lightRayTimeRestriction
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume) :
    MemLp (scratch_lightRayTimeRestriction g) 2 volume := by
  simpa only [scratch_lightRayTimeRestriction] using
    MemLp.indicator scratch_measurableSet_lightRayTimeSlab hg

theorem scratch_eLpNorm_lightRayTimeRestriction_le
    (g : WaveSpaceTime -> Complex) :
    eLpNorm (scratch_lightRayTimeRestriction g) 2 volume <= eLpNorm g 2 volume :=
  by
    simpa only [scratch_lightRayTimeRestriction] using
      (eLpNorm_indicator_le (s := {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval}) g)

theorem scratch_lightRayMaximal_eq_lightRayTimeRestriction
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime -> Complex) (hg : MemLp g 2 volume) :
    lightRayMaximal delta N g =
      lightRayMaximal delta N (scratch_lightRayTimeRestriction g) := by
  apply scratch_lightRayMaximal_eq_of_ae_eq_slab_of_integrable delta N
    (scratch_ae_eq_lightRayTimeRestriction_slab g)
  · intro omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN omega y g hg
  · intro omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN omega y
      (scratch_lightRayTimeRestriction g) (scratch_memLp_lightRayTimeRestriction g hg)

theorem scratch_lightRayMaximal_zero (delta : Real) (N : Nat) :
    lightRayMaximal delta N (fun _ : WaveSpaceTime => (0 : Complex)) = 0 := by
  funext y
  unfold lightRayMaximal
  simp only [lightRayAverage, norm_zero, mul_zero, integral_zero]
  have hset : (fun _ : Euclidean 2 => (0 : Real)) '' unitLightRayDirections = {0} := by
    ext r
    constructor
    · rintro ⟨omega, homega, hr⟩
      simpa only [hr, mem_singleton_iff]
    · intro hr
      have hr0 : r = 0 := by simpa only [mem_singleton_iff] using hr
      subst r
      exact ⟨aux_defaultLightRayDirection.1, aux_defaultLightRayDirection.2, rfl⟩
  rw [hset]
  simp

theorem scratch_lightRayMaximal_eq_of_ae_eq_of_memLp
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 1 < N)
    {g h : WaveSpaceTime -> Complex} (hg : MemLp g 2 volume)
    (hh : MemLp h 2 volume) (hgh : g =ᵐ[volume] h) :
    lightRayMaximal delta N g = lightRayMaximal delta N h := by
  apply scratch_lightRayMaximal_eq_of_ae_eq_of_integrable delta N hgh
  · intro omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN omega y g hg
  · intro omega y
    exact scratch_integrable_lightRayKernel_mul_norm_of_memLp hdelta N hN omega y h hh

theorem scratch_jointSchwartzRaw_memLp_two
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    MemLp (jointSchwartzRaw G) 2 volume := by
  let e : WaveSpaceTime -> JointWaveSpaceTime := WithLp.toLp 2
  have hpres : MeasurePreserving e volume volume := by
    simpa only [e] using
      (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have hmem := (G.memLp 2 volume).comp_measurePreserving hpres
  change MemLp (fun z : WaveSpaceTime => G (WithLp.toLp 2 z)) 2 volume
  simpa only [Function.comp_def, e] using hmem

