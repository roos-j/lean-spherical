-- BEGIN ScratchKakeyaGenericTTStarFactorization
section

namespace ScratchKakeyaGenericTTStarFactorization

open MeasureTheory

noncomputable section

/-- The angular analysis map at one frequency, written over arbitrary source
and time measures. -/
noncomputable def ttstarAnalysis
    {U T : Type*} [MeasurableSpace T] (nu : Measure T)
    (A : U → T → Complex) (f : T → Complex) (u : U) : Complex :=
  ∫ t, A u t * f t ∂nu

/-- The time `TT*` kernel associated to an angular analysis amplitude. -/
noncomputable def ttstarKernel
    {U T : Type*} [MeasurableSpace U] (mu : Measure U)
    (A : U → T → Complex) (t s : T) : Complex :=
  ∫ u, A u t * starRingEnd Complex (A u s) ∂mu

/-- Exact continuous `TT*` factorization.  The hypotheses are only the
Fubini/integrability statements needed to legitimately rearrange the three
integrals; in the finite-tensor Schwartz model they are supplied by compact
time localization and joint continuity. -/
theorem ttstar_factorization
    {U T : Type*} [MeasurableSpace U] [MeasurableSpace T]
    (mu : Measure U) (nu : Measure T) [SFinite mu] [SFinite nu]
    (A : U → T → Complex) (f : T → Complex)
    (hpoint : ∀ u, Integrable (fun t => A u t * f t) nu)
    (hpointStar : ∀ u, Integrable
      (fun s => starRingEnd Complex (A u s * f s)) nu)
    (htriple : Integrable (Function.uncurry fun u (p : T × T) =>
      (A u p.1 * f p.1) * starRingEnd Complex (A u p.2 * f p.2))
      (mu.prod (nu.prod nu)))
    (hkernel : ∀ t s, Integrable
      (fun u => A u t * starRingEnd Complex (A u s)) mu)
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel mu A t s * f t * starRingEnd Complex (f s))
      (nu.prod nu)) :
    (∫ u, ttstarAnalysis nu A f u *
      starRingEnd Complex (ttstarAnalysis nu A f u) ∂mu) =
      ∫ t, ∫ s, ttstarKernel mu A t s * f t *
        starRingEnd Complex (f s) ∂nu ∂nu := by
  let H : U → T × T → Complex := fun u p =>
    (A u p.1 * f p.1) * starRingEnd Complex (A u p.2 * f p.2)
  have hpointwise (u : U) :
      ttstarAnalysis nu A f u *
        starRingEnd Complex (ttstarAnalysis nu A f u) =
        ∫ p, H u p ∂(nu.prod nu) := by
    unfold ttstarAnalysis H
    rw [← integral_conj]
    symm
    simpa only [ContinuousLinearMap.mul_apply'] using
      (integral_prod_bilin (ContinuousLinearMap.mul Complex Complex)
        (hpoint u) (hpointStar u))
  have hinner (t s : T) :
      (∫ u, H u (t, s) ∂mu) =
        ttstarKernel mu A t s * f t * starRingEnd Complex (f s) := by
    unfold H ttstarKernel
    calc
      (∫ u, (A u t * f t) * starRingEnd Complex (A u s * f s) ∂mu) =
          ∫ u, (A u t * starRingEnd Complex (A u s)) *
            (f t * starRingEnd Complex (f s)) ∂mu := by
              apply integral_congr_ae
              filter_upwards with u
              simp only [starRingEnd_apply, star_mul]
              ring
      _ = (∫ u, A u t * starRingEnd Complex (A u s) ∂mu) *
            (f t * starRingEnd Complex (f s)) := by
              rw [integral_mul_const_of_integrable (hkernel t s)]
      _ = ttstarKernel mu A t s * f t * starRingEnd Complex (f s) := by
              unfold ttstarKernel
              ring
  calc
    (∫ u, ttstarAnalysis nu A f u *
        starRingEnd Complex (ttstarAnalysis nu A f u) ∂mu) =
        ∫ u, ∫ p, H u p ∂(nu.prod nu) ∂mu := by
          apply integral_congr_ae
          filter_upwards with u
          exact hpointwise u
    _ = ∫ p, ∫ u, H u p ∂mu ∂(nu.prod nu) :=
      integral_integral_swap htriple
    _ = ∫ p, ttstarKernel mu A p.1 p.2 * f p.1 *
          starRingEnd Complex (f p.2) ∂(nu.prod nu) := by
      apply integral_congr_ae
      filter_upwards with p
      exact hinner p.1 p.2
    _ = ∫ t, ∫ s, ttstarKernel mu A t s * f t *
          starRingEnd Complex (f s) ∂nu ∂nu :=
      (integral_integral hrhs).symm

end

end ScratchKakeyaGenericTTStarFactorization
end
-- END ScratchKakeyaGenericTTStarFactorization

