section

namespace ScratchKakeyaFiniteTensorOuterShell

open Filter MeasureTheory FourierTransform Set
open scoped BigOperators Convolution FourierTransform EuclideanSpace
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS
open Auto.Spherical.MSS.KakeyaCircleDirection
open Auto.Spherical.MSS.KakeyaCirclePhaseAlignment
open ScratchKakeyaCircleTimeKernel
open ScratchKakeyaCircleGlobalTimeSchur
open ScratchKakeyaGlobalComplexSchur
open ScratchKakeyaGenericTTStarFactorization
open ScratchKakeyaTTStarAngular

noncomputable section

/-- The spatial frequency centered at the circle direction `alpha`. -/
noncomputable def centeredCircleFrequency (alpha lambda : Real) : Euclidean 2 :=
  lambda • circleDirection alpha

/-- The exact time profile at a fixed spatial frequency for a finite
separated Schwartz tensor. -/
noncomputable def outerShellFiniteTensorTimeData
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (alpha lambda : Real) : Real → Complex :=
  scratch_finiteTensorTimeData s0 q a (centeredCircleFrequency alpha lambda)

/-- The time Fourier integral seen at the literal circle point
`alpha + rho*u`. -/
noncomputable def outerShellFiniteTensorAnalysis
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (alpha rho lambda u : Real) : Complex :=
  ∫ t : Real,
    scratch_lightRayTimePhase (circleDirection (alpha + rho * u))
      (centeredCircleFrequency alpha lambda) t *
      outerShellFiniteTensorTimeData s0 q a alpha lambda t

/-- Pointwise exact finite-tensor `TT*` expansion at a centered outer-circle
shell point.  The Fourier phase has already been rewritten to the literal
rescaled cosine phase, so it matches the circle product kernel used by the
whole-line Schur theorem. -/
theorem outerShellFiniteTensorAnalysis_ttstar
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (alpha rho lambda u : Real) :
    outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u *
        starRingEnd Complex (outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) =
      ∫ z : Real × Real,
        (Real.fourierChar (-(z.1 - z.2) * lambda * Real.cos (rho * u)) : Complex) *
          (outerShellFiniteTensorTimeData s0 q a alpha lambda z.1 *
            starRingEnd Complex (outerShellFiniteTensorTimeData s0 q a alpha lambda z.2)) := by
  unfold outerShellFiniteTensorAnalysis outerShellFiniteTensorTimeData
    centeredCircleFrequency
  rw [scratch_finiteTensor_timeTTStar_eq_productIntegral]
  apply integral_congr_ae
  filter_upwards with z
  rw [scratch_phased_finiteTensorTimeData_ttstar_integrand]
  congr 1
  apply congrArg (fun x : Real => (Real.fourierChar x : Complex))
  rw [Real.inner_apply,
    circle_phase_centered_shell alpha rho u lambda z.1 z.2]
  ring

/-- The literal product `TT*` kernel in the library Fourier-character
normalization.  It is the kernel obtained after integrating the pointwise
finite-tensor identity over the rescaled outer shell. -/
noncomputable def outerCircleFourierCharProductKernel
    (rho lambda t s : Real) : Complex :=
  (rho : Complex) * ∫ u in (1 / 2 : Real)..2,
    outerCircleTTStarProductAmplitude u *
      (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)

/-- The rescaled outer-shell analysis amplitude in the library Fourier
convention, stripped of the temporal profile. -/
noncomputable def outerCircleFourierCharAnalysisAmplitude
    (rho lambda u t : Real) : Complex :=
  fixedOuterCircleUnitShellAmplitude u *
    (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)

/-- The library light-ray Fourier character at the centered physical circle
point is exactly the scalar cosine character used by the shell amplitude. -/
theorem outerShellFiniteTensor_timePhase_eq
    (alpha rho lambda u t : Real) :
    scratch_lightRayTimePhase (circleDirection (alpha + rho * u))
      (centeredCircleFrequency alpha lambda) t =
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) := by
  unfold scratch_lightRayTimePhase centeredCircleFrequency
  apply congrArg (fun x : Real => (Real.fourierChar x : Complex))
  rw [Real.inner_apply, inner_circleDirection_add_smul_circleDirection]
  ring

/-- The generic cutoff analysis amplitude is exactly the cutoff times the
finite-tensor Fourier integral at the corresponding physical circle point. -/
theorem ttstarAnalysis_outerCircleFourierChar_eq_localizedFiniteTensor
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (alpha rho lambda u : Real) :
    ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda)
      (outerShellFiniteTensorTimeData s0 q a alpha lambda) u =
      fixedOuterCircleUnitShellAmplitude u *
        outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u := by
  unfold ttstarAnalysis outerCircleFourierCharAnalysisAmplitude
    outerShellFiniteTensorAnalysis
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with t
  rw [outerShellFiniteTensor_timePhase_eq]
  ring

/-- Multiplying the analysis amplitude by its conjugate gives exactly the
literal product cutoff and the time-difference Fourier character. -/
theorem outerCircleFourierCharAnalysisAmplitude_ttstar_integrand
    (rho lambda u t s : Real) :
    outerCircleFourierCharAnalysisAmplitude rho lambda u t *
        starRingEnd Complex (outerCircleFourierCharAnalysisAmplitude rho lambda u s) =
      outerCircleTTStarProductAmplitude u *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
  unfold outerCircleFourierCharAnalysisAmplitude
  change
    (fixedOuterCircleUnitShellAmplitude u *
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        star (fixedOuterCircleUnitShellAmplitude u *
          (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) = _
  rw [star_mul]
  have hphase :
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) =
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_conj]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    (fixedOuterCircleUnitShellAmplitude u *
        (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        (starRingEnd Complex
          (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) *
          starRingEnd Complex (fixedOuterCircleUnitShellAmplitude u)) =
        (fixedOuterCircleUnitShellAmplitude u *
          starRingEnd Complex (fixedOuterCircleUnitShellAmplitude u)) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          ring
    _ = outerCircleTTStarProductAmplitude u *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          rw [← outerCircleTTStarProductAmplitude_eq_cutoff_mul_conj]
    _ = _ := by rw [hphase]

/-- The angular kernel of the Fourier-character analysis amplitude is the
literal product time kernel, including the shell Jacobian `rho`. -/
theorem outerCircleFourierCharAnalysis_ttstarKernel_eq
    (rho lambda t s : Real) :
    (rho : Complex) *
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleFourierCharAnalysisAmplitude rho lambda) t s =
      outerCircleFourierCharProductKernel rho lambda t s := by
  unfold ttstarKernel outerCircleFourierCharProductKernel
  rw [intervalIntegral.integral_of_le (by norm_num : (1 / 2 : Real) ≤ 2)]
  congr 1
  apply integral_congr_ae
  filter_upwards with u
  exact outerCircleFourierCharAnalysisAmplitude_ttstar_integrand rho lambda u t s

/-- Exact all-time continuous `TT*` factorization for the literal
Fourier-character outer shell.  It takes the precise Fubini data used by the
generic factorization theorem and returns the actual product time kernel,
with no phase normalization left implicit. -/
theorem outerCircleFourierCharAnalysis_ttstar_factorization
    (rho lambda : Real) (H : Real → Complex)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleFourierCharAnalysisAmplitude rho lambda u t * H t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleFourierCharAnalysisAmplitude rho lambda u s * H s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleFourierCharAnalysisAmplitude rho lambda u p.1 * H p.1) *
        starRingEnd Complex
          (outerCircleFourierCharAnalysisAmplitude rho lambda u p.2 * H p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleFourierCharAnalysisAmplitude rho lambda u t *
        starRingEnd Complex (outerCircleFourierCharAnalysisAmplitude rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleFourierCharAnalysisAmplitude rho lambda) t s * H t *
          starRingEnd Complex (H s)) (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda) H u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleFourierCharProductKernel rho lambda t s * H t *
          starRingEnd Complex (H s) := by
  have hbase := ttstar_factorization
    (volume.restrict (Ioc (1 / 2 : Real) 2)) volume
    (outerCircleFourierCharAnalysisAmplitude rho lambda) H
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda) H u)
            ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ t : Real, ∫ s : Real,
            ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
              (outerCircleFourierCharAnalysisAmplitude rho lambda) t s * H t *
                starRingEnd Complex (H s) := by rw [hbase]
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) *
          ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
            (outerCircleFourierCharAnalysisAmplitude rho lambda) t s) * H t *
              starRingEnd Complex (H s) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with t
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with s
        ring
    _ = ∫ t : Real, ∫ s : Real,
        outerCircleFourierCharProductKernel rho lambda t s * H t *
          starRingEnd Complex (H s) := by
        apply integral_congr_ae
        filter_upwards with t
        apply integral_congr_ae
        filter_upwards with s
        rw [outerCircleFourierCharAnalysis_ttstarKernel_eq]

/-- The preceding continuous factorization expressed in the exact finite
Schwartz-tensor notation and the literal cutoff localized circle analysis. -/
theorem outerShellFiniteTensor_localized_ttstar_factorization
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    (alpha rho lambda : Real)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleFourierCharAnalysisAmplitude rho lambda u t *
        outerShellFiniteTensorTimeData s0 q a alpha lambda t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleFourierCharAnalysisAmplitude rho lambda u s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleFourierCharAnalysisAmplitude rho lambda u p.1 *
        outerShellFiniteTensorTimeData s0 q a alpha lambda p.1) *
        starRingEnd Complex
          (outerCircleFourierCharAnalysisAmplitude rho lambda u p.2 *
            outerShellFiniteTensorTimeData s0 q a alpha lambda p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleFourierCharAnalysisAmplitude rho lambda u t *
        starRingEnd Complex (outerCircleFourierCharAnalysisAmplitude rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleFourierCharAnalysisAmplitude rho lambda) t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s))
      (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        (fixedOuterCircleUnitShellAmplitude u *
          outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
          starRingEnd Complex
            (fixedOuterCircleUnitShellAmplitude u *
              outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleFourierCharProductKernel rho lambda t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s) := by
  have hbase := outerCircleFourierCharAnalysis_ttstar_factorization rho lambda
    (outerShellFiniteTensorTimeData s0 q a alpha lambda)
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          (fixedOuterCircleUnitShellAmplitude u *
            outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
            starRingEnd Complex
              (fixedOuterCircleUnitShellAmplitude u *
                outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda)
              (outerShellFiniteTensorTimeData s0 q a alpha lambda) u *
              starRingEnd Complex
                (ttstarAnalysis volume (outerCircleFourierCharAnalysisAmplitude rho lambda)
                  (outerShellFiniteTensorTimeData s0 q a alpha lambda) u)
            ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with u
          rw [ttstarAnalysis_outerCircleFourierChar_eq_localizedFiniteTensor]
    _ = _ := hbase

/-- Exact (not merely norm-level) normalization bridge for the product
kernel.  The `-2*pi` is forced by the library Fourier character. -/
theorem outerCircleFourierCharProductKernel_eq
    (rho lambda t s : Real) :
    outerCircleFourierCharProductKernel rho lambda t s =
      outerCircleTTStarProductTimeKernel rho (-(2 * Real.pi) * lambda) t s := by
  unfold outerCircleFourierCharProductKernel outerCircleTTStarProductTimeKernel
  congr 1
  apply intervalIntegral.integral_congr
  intro u hu
  simp only [Real.fourierChar_apply]
  congr 1
  push_cast
  ring_nf

/-- The Fourier-character kernel has the same norm as the positive-frequency
Airy-convention product kernel.  This is the precise sign bridge used by the
global Schur estimate. -/
theorem norm_outerCircleFourierCharProductKernel_eq_positive
    (rho lambda t s : Real) :
    ‖outerCircleFourierCharProductKernel rho lambda t s‖ =
      ‖outerCircleTTStarProductTimeKernel rho ((2 * Real.pi) * lambda) t s‖ := by
  rw [outerCircleFourierCharProductKernel_eq]
  convert norm_outerCircleTTStarProductTimeKernel_neg_frequency rho
    ((2 * Real.pi) * lambda) t s using 1 <;> ring

/-- Global all-time Schur rows/columns in the library Fourier normalization.
The conclusion retains the exact `2*pi` parameter, so no normalization is
hidden when this is inserted into the fixed-frequency TT* energy. -/
theorem exists_outerCircleFourierCharProductKernel_global_row_column_schur
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          Integrable (fun s : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
            volume ∧
          (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) ∧
        (∀ s : Real,
          Integrable (fun t : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
            volume ∧
          (∫ t : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))) := by
  rcases exists_outerCircleTTStarProductTimeKernel_global_row_column_schur
      hrhoMax hrhoMax_small with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have htwopi_lambda : 0 < (2 * Real.pi) * lambda :=
    mul_pos (mul_pos (by norm_num) Real.pi_pos) hlambda
  rcases hbound rho hrho ((2 * Real.pi) * lambda) htwopi_lambda with
    ⟨hright, hleft⟩
  constructor
  · intro t
    rcases hright t with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with s
      rw [← norm_outerCircleFourierCharProductKernel_eq_positive]
    · calc
        (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) =
            ∫ s : Real, ‖outerCircleTTStarProductTimeKernel rho
              ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with s
              rw [norm_outerCircleFourierCharProductKernel_eq_positive]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass
  · intro s
    rcases hleft s with ⟨hint, hmass⟩
    refine ⟨?_, ?_⟩
    · apply hint.congr
      filter_upwards with t
      rw [← norm_outerCircleFourierCharProductKernel_eq_positive]
    · calc
        (∫ t : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) =
            ∫ t : Real, ‖outerCircleTTStarProductTimeKernel rho
              ((2 * Real.pi) * lambda) t s‖ := by
              apply integral_congr_ae
              filter_upwards with t
              rw [norm_outerCircleFourierCharProductKernel_eq_positive]
        _ ≤ (2 * B) * rho *
            (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2)) := hmass

/-- Fixed-frequency `E₀` Schur bound for the exact Fourier-character outer
circle product kernel.  All product-integrability inputs are exposed rather
than inferred: the finite Schwartz-tensor application supplies them through
its concrete Fubini calculation. -/
theorem exists_outerCircleFourierCharProductKernel_quadratic_E0
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
      ∀ H : Real → Complex,
        Integrable (fun t : Real => ‖H t‖ ^ 2) volume →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
            ‖H p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
            starRingEnd Complex (H p.2)) (volume.prod volume) →
        ‖∫ t : Real, ∫ s : Real,
          outerCircleFourierCharProductKernel rho lambda t s * H t *
            starRingEnd Complex (H s)‖ ≤
          (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFourierCharProductKernel_global_row_column_schur
      hrhoMax hrhoMax_small with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda H hHsq hquad hleft hright hcomplex
  have hrho_pos : 0 < rho := hrho.1
  rcases hbound rho hrho lambda hlambda with ⟨hrows, _⟩
  let R : Real := (2 * B) * rho *
    (Real.pi / (((2 * Real.pi) * lambda) * rho ^ 2))
  have hsymm : ∀ t s : Real,
      ‖outerCircleFourierCharProductKernel rho lambda t s‖ =
        ‖outerCircleFourierCharProductKernel rho lambda s t‖ := by
    intro t s
    calc
      ‖outerCircleFourierCharProductKernel rho lambda t s‖ =
          ‖outerCircleTTStarProductTimeKernel rho ((2 * Real.pi) * lambda) t s‖ :=
        norm_outerCircleFourierCharProductKernel_eq_positive rho lambda t s
      _ = ‖outerCircleTTStarProductTimeKernel rho ((2 * Real.pi) * lambda) s t‖ :=
        norm_outerCircleTTStarProductTimeKernel_symm rho ((2 * Real.pi) * lambda) t s
      _ = ‖outerCircleFourierCharProductKernel rho lambda s t‖ :=
        (norm_outerCircleFourierCharProductKernel_eq_positive rho lambda s t).symm
  have hrow : ∀ t : Real,
      Integrable (fun s : Real => ‖outerCircleFourierCharProductKernel rho lambda t s‖)
        volume := by
    intro t
    exact (hrows t).1
  have hrowbound : ∀ t : Real,
      (∫ s : Real, ‖outerCircleFourierCharProductKernel rho lambda t s‖) ≤ R := by
    intro t
    exact (hrows t).2
  have hschur := norm_integral_integral_le_of_symmetricSchur
    (outerCircleFourierCharProductKernel rho lambda) R hsymm hrow hrowbound
    H hHsq hquad hleft hright hcomplex
  have hR : R = B / (lambda * rho) := by
    dsimp [R]
    field_simp [Real.pi_ne_zero, ne_of_gt hlambda, ne_of_gt hrho_pos]
  rw [hR] at hschur
  exact hschur

/-- The preceding `E₀` estimate instantiated at the actual finite
Schwartz-tensor time datum.  This is the clean fixed-frequency API intended
for the subsequent integration in `xi`; its four displayed Fubini premises
are the only remaining analytic bookkeeping, not hidden assumptions. -/
theorem exists_outerShellFiniteTensor_quadratic_E0
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ alpha lambda : Real, 0 < lambda →
        let H : Real → Complex := outerShellFiniteTensorTimeData s0 q a alpha lambda
        ∀ hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume,
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.1‖ ^ 2) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.2‖ ^ 2) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
              starRingEnd Complex (H p.2)) (volume.prod volume) →
          ‖∫ t : Real, ∫ s : Real,
            outerCircleFourierCharProductKernel rho lambda t s * H t *
              starRingEnd Complex (H s)‖ ≤
            (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerCircleFourierCharProductKernel_quadratic_E0
      hrhoMax hrhoMax_small with ⟨B, hB, hmain⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho alpha lambda hlambda H hHsq hquad hleft hright hcomplex
  exact hmain rho hrho lambda hlambda H hHsq hquad hleft hright hcomplex

/-- Actual fixed-frequency outer-shell `E₀`: the left side is the literal
cutoff angular energy written as a complex positive quadratic form.  The
preceding factorization theorem discharges its displayed equality from the
finite-tensor Fubini hypotheses; the remaining four integrability inputs are
exactly those required by the global complex Schur wrapper. -/
theorem exists_outerShellFiniteTensor_localized_E0
    {ι : Type*} (s0 : Finset ι)
    (q : ι → SchwartzMap (Euclidean 2) Complex)
    (a : ι → SchwartzMap Real Complex)
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ alpha lambda : Real, 0 < lambda →
        let H : Real → Complex := outerShellFiniteTensorTimeData s0 q a alpha lambda
        ∀ hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume,
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.1‖ * ‖H p.2‖) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.1‖ ^ 2) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            ‖outerCircleFourierCharProductKernel rho lambda p.1 p.2‖ *
              ‖H p.2‖ ^ 2) (volume.prod volume) →
          Integrable (fun p : Real × Real =>
            outerCircleFourierCharProductKernel rho lambda p.1 p.2 * H p.1 *
              starRingEnd Complex (H p.2)) (volume.prod volume) →
          ((rho : Complex) *
            ∫ u : Real,
              (fixedOuterCircleUnitShellAmplitude u *
                outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
                starRingEnd Complex
                  (fixedOuterCircleUnitShellAmplitude u *
                    outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
              ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
            ∫ t : Real, ∫ s : Real,
              outerCircleFourierCharProductKernel rho lambda t s * H t *
                starRingEnd Complex (H s)) →
          ‖(rho : Complex) *
            ∫ u : Real,
              (fixedOuterCircleUnitShellAmplitude u *
                outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
                starRingEnd Complex
                  (fixedOuterCircleUnitShellAmplitude u *
                    outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
              ∂(volume.restrict (Ioc (1 / 2 : Real) 2))‖ ≤
            (B / (lambda * rho)) * ∫ t : Real, ‖H t‖ ^ 2 := by
  rcases exists_outerShellFiniteTensor_quadratic_E0 s0 q a
      hrhoMax hrhoMax_small with ⟨B, hB, hmain⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho alpha lambda hlambda H hHsq hquad hleft hright hcomplex hfactor
  rw [hfactor]
  exact hmain rho hrho alpha lambda hlambda hHsq hquad hleft hright hcomplex

end

