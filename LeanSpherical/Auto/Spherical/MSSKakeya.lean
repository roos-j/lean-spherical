-- BEGIN ScratchKakeyaTimeEnvelope
section

namespace ScratchKakeyaTimeEnvelope

open MeasureTheory Set

noncomputable section

/-- The integrable time-difference envelope naturally produced by a central
bound plus two integrations by parts on an outer circle shell. -/
def quadraticTimeEnvelope (Lambda t s : Real) : Real :=
  (1 + (Lambda * (t - s)) ^ 2)⁻¹

theorem quadraticTimeEnvelope_symm (Lambda t s : Real) :
    quadraticTimeEnvelope Lambda t s = quadraticTimeEnvelope Lambda s t := by
  unfold quadraticTimeEnvelope
  congr 2
  ring

/-- The elementary central/outer splice: a uniform central bound together
with second-order nonstationary decay away from the diagonal is dominated by
the integrable quadratic envelope. -/
theorem le_two_mul_inv_one_add_sq_of_central_outer
    {C x r : Real} (hC : 0 ≤ C) (hx : 0 ≤ x)
    (hcentral : r ≤ C)
    (houter : x ≠ 0 → r ≤ C * (x ^ 2)⁻¹) :
    r ≤ (2 * C) * (1 + x ^ 2)⁻¹ := by
  have hden_pos : 0 < 1 + x ^ 2 := by positivity
  by_cases hx_one : x ≤ 1
  · have hx_sq : x ^ 2 ≤ 1 := by
      simpa using
        (sq_le_sq₀ hx (by norm_num : (0 : Real) ≤ 1)).mpr hx_one
    have hC_sq : C * x ^ 2 ≤ C := by
      calc
        C * x ^ 2 ≤ C * 1 := mul_le_mul_of_nonneg_left hx_sq hC
        _ = C := by ring
    calc
      r ≤ C := hcentral
      _ ≤ (2 * C) * (1 + x ^ 2)⁻¹ := by
        rw [show (2 * C) * (1 + x ^ 2)⁻¹ = (2 * C) / (1 + x ^ 2) by
          rw [div_eq_mul_inv]]
        apply (le_div_iff₀ hden_pos).mpr
        nlinarith
  · have hx_one' : 1 ≤ x := le_of_not_ge hx_one
    have hx_pos : 0 < x := lt_of_lt_of_le (by norm_num) hx_one'
    have hx_sq_pos : 0 < x ^ 2 := sq_pos_of_pos hx_pos
    have houter' : r ≤ C * (x ^ 2)⁻¹ := houter (ne_of_gt hx_pos)
    have hden_le : 1 + x ^ 2 ≤ 2 * x ^ 2 := by
      have hx_sq : 1 ≤ x ^ 2 := by
        simpa using
          (sq_le_sq₀ (by norm_num : (0 : Real) ≤ 1) hx).mpr hx_one'
      nlinarith
    have hinv : (x ^ 2)⁻¹ ≤ 2 * (1 + x ^ 2)⁻¹ := by
      rw [show (x ^ 2)⁻¹ = 1 / (x ^ 2) by rw [one_div],
        show 2 * (1 + x ^ 2)⁻¹ = 2 / (1 + x ^ 2) by rw [div_eq_mul_inv]]
      exact (div_le_div_iff₀ hx_sq_pos hden_pos).mpr (by simpa using hden_le)
    calc
      r ≤ C * (x ^ 2)⁻¹ := houter'
      _ ≤ C * (2 * (1 + x ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_left hinv hC
      _ = (2 * C) * (1 + x ^ 2)⁻¹ := by ring

/-- A literal time-kernel version of the central/outer splice.  The outer
hypothesis is exactly the order-two circle IBP decay with
`x = Λ * |t - s|`. -/
theorem norm_le_quadraticTimeEnvelope_of_central_outer
    {A rho Lambda t s : Real} (hArho : 0 ≤ A * rho) (hLambda : 0 ≤ Lambda)
    (L : Real → Real → Complex)
    (hcentral : ‖L t s‖ ≤ A * rho)
    (houter : Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    ‖L t s‖ ≤ (2 * A) * rho * quadraticTimeEnvelope Lambda t s := by
  have hx : 0 ≤ Lambda * |t - s| :=
    mul_nonneg hLambda (abs_nonneg _)
  have hsplice := le_two_mul_inv_one_add_sq_of_central_outer
    hArho hx hcentral houter
  calc
    ‖L t s‖ ≤ (2 * (A * rho)) *
        (1 + (Lambda * |t - s|) ^ 2)⁻¹ := hsplice
    _ = (2 * A) * rho * quadraticTimeEnvelope Lambda t s := by
      unfold quadraticTimeEnvelope
      have habs_sq : (Lambda * |t - s|) ^ 2 =
          (Lambda * (t - s)) ^ 2 := by
        calc
          (Lambda * |t - s|) ^ 2 = Lambda ^ 2 * |t - s| ^ 2 := by
            rw [mul_pow]
          _ = Lambda ^ 2 * (t - s) ^ 2 := by rw [sq_abs]
          _ = (Lambda * (t - s)) ^ 2 := by rw [mul_pow]
      rw [habs_sq]
      ring

/-- Its mass on any oriented finite interval is at most `π / Λ`.  This is the
row/column estimate that converts a second-order circle-shell envelope into
a continuous Schur bound. -/
theorem intervalIntegral_quadraticTimeEnvelope_le_pi_div
    {a b Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s in a..b, quadraticTimeEnvelope Lambda t s) ≤ Real.pi / Lambda := by
  have hchange : Lambda * (∫ s in a..b, quadraticTimeEnvelope Lambda t s) =
      ∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹ := by
    convert intervalIntegral.mul_integral_comp_sub_mul
      (f := fun u : Real => (1 + u ^ 2)⁻¹)
      (a := a) (b := b) (c := Lambda) (d := Lambda * t) using 1;
      simp only [quadraticTimeEnvelope]
    all_goals ring_nf
  have hbound :
      (∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹) ≤ Real.pi := by
    rw [integral_inv_one_add_sq]
    linarith [Real.arctan_lt_pi_div_two (Lambda * t - Lambda * a),
      Real.neg_pi_div_two_lt_arctan (Lambda * t - Lambda * b)]
  apply (le_div_iff₀ hLambda).mpr
  calc
    (∫ s in a..b, quadraticTimeEnvelope Lambda t s) * Lambda =
        Lambda * (∫ s in a..b, quadraticTimeEnvelope Lambda t s) := by ring
    _ = ∫ u in (Lambda * t - Lambda * b)..(Lambda * t - Lambda * a),
        (1 + u ^ 2)⁻¹ := hchange
    _ ≤ Real.pi := hbound

/-- A continuous signed kernel with the quadratic time envelope has the
displayed Schur row bound.  The input `hL_integrable` is the ordinary Fubini
datum supplied by the literal smooth time kernel; the estimate itself uses
only its norm majorant. -/
theorem intervalIntegral_norm_le_of_quadraticTimeEnvelope
    {a b A rho Lambda t : Real} (hab : a ≤ b)
    (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : IntervalIntegrable (fun s => ‖L t s‖) volume a b)
    (hbound : ∀ s ∈ Icc a b,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ s in a..b, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  have henv_cont : Continuous (fun s : Real =>
      quadraticTimeEnvelope Lambda t s) := by
    unfold quadraticTimeEnvelope
    apply Continuous.inv₀
    · fun_prop
    · intro s
      positivity
  have henv_full_cont : Continuous (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) :=
    (continuous_const : Continuous (fun _ : Real => A * rho)).mul henv_cont
  have henv_integrable : IntervalIntegrable (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) volume a b :=
    henv_full_cont.intervalIntegrable (μ := volume) a b
  calc
    (∫ s in a..b, ‖L t s‖) ≤
        ∫ s in a..b, A * rho * quadraticTimeEnvelope Lambda t s :=
      intervalIntegral.integral_mono_on hab hL_integrable henv_integrable hbound
    _ = A * rho * (∫ s in a..b, quadraticTimeEnvelope Lambda t s) := by
      have hrewrite : (fun s : Real =>
          A * rho * quadraticTimeEnvelope Lambda t s) =
          fun s => (A * rho) * quadraticTimeEnvelope Lambda t s := by
        funext s
        ring
      rw [hrewrite, intervalIntegral.integral_const_mul]
    _ ≤ A * rho * (Real.pi / Lambda) :=
      mul_le_mul_of_nonneg_left
        (intervalIntegral_quadraticTimeEnvelope_le_pi_div hLambda) hArho

/-- The matching column estimate.  It is the row theorem applied to the
transposed kernel, using the symmetry of the time-difference envelope. -/
theorem intervalIntegral_norm_le_of_quadraticTimeEnvelope_column
    {a b A rho Lambda s : Real} (hab : a ≤ b)
    (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : IntervalIntegrable (fun t => ‖L t s‖) volume a b)
    (hbound : ∀ t ∈ Icc a b,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ t in a..b, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  apply intervalIntegral_norm_le_of_quadraticTimeEnvelope hab hLambda hArho
    (fun t u => L u t)
  · simpa using hL_integrable
  · intro u hu
    rw [quadraticTimeEnvelope_symm]
    exact hbound u hu

/-- The source-ready outer-circle Schur row estimate.  A central width bound
and order-two circle IBP off the time diagonal produce the exact
`O((λρ)⁻¹)` row mass when `Λ = λρ²`. -/
theorem intervalIntegral_norm_le_of_central_outer
    {a b A rho Lambda t : Real} (hab : a ≤ b)
    (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : IntervalIntegrable (fun s => ‖L t s‖) volume a b)
    (hcentral : ∀ s ∈ Icc a b, ‖L t s‖ ≤ A * rho)
    (houter : ∀ s ∈ Icc a b, Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    (∫ s in a..b, ‖L t s‖) ≤ (2 * A) * rho * (Real.pi / Lambda) := by
  have hTwoArho : 0 ≤ (2 * A) * rho := by
    calc
      0 ≤ 2 * (A * rho) := mul_nonneg (by norm_num) hArho
      _ = (2 * A) * rho := by ring
  apply intervalIntegral_norm_le_of_quadraticTimeEnvelope
    hab hLambda hTwoArho L hL_integrable
  intro s hs
  exact norm_le_quadraticTimeEnvelope_of_central_outer hArho hLambda.le L
    (hcentral s hs) (houter s hs)

/-- The matching source-ready column estimate. -/
theorem intervalIntegral_norm_le_of_central_outer_column
    {a b A rho Lambda s : Real} (hab : a ≤ b)
    (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : IntervalIntegrable (fun t => ‖L t s‖) volume a b)
    (hcentral : ∀ t ∈ Icc a b, ‖L t s‖ ≤ A * rho)
    (houter : ∀ t ∈ Icc a b, Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    (∫ t in a..b, ‖L t s‖) ≤ (2 * A) * rho * (Real.pi / Lambda) := by
  have hTwoArho : 0 ≤ (2 * A) * rho := by
    calc
      0 ≤ 2 * (A * rho) := mul_nonneg (by norm_num) hArho
      _ = (2 * A) * rho := by ring
  apply intervalIntegral_norm_le_of_quadraticTimeEnvelope_column
    hab hLambda hTwoArho L hL_integrable
  intro t ht
  exact norm_le_quadraticTimeEnvelope_of_central_outer hArho hLambda.le L
    (hcentral t ht) (houter t ht)

end

end ScratchKakeyaTimeEnvelope
end
-- END ScratchKakeyaTimeEnvelope

-- BEGIN ScratchKakeyaGlobalTimeEnvelope
section

namespace ScratchKakeyaGlobalTimeEnvelope

open MeasureTheory Set
open ScratchKakeyaTimeEnvelope

noncomputable section

/-- The quadratic time-difference envelope has its exact whole-line mass.
This is the all-time version of the finite-interval `pi / Lambda` bound and
is the common interface for Schwartz temporal tensor data. -/
theorem integral_quadraticTimeEnvelope_univ_eq_pi_div
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    (∫ s : Real, quadraticTimeEnvelope Lambda t s) = Real.pi / Lambda := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hfcont : Continuous f := by
    dsimp [f]
    apply Continuous.inv₀
    · fun_prop
    · intro u
      positivity
  have hrewrite : (fun s : Real => quadraticTimeEnvelope Lambda t s) =
      fun s => f (Lambda * (s - t)) := by
    funext s
    unfold quadraticTimeEnvelope
    dsimp [f]
    congr 2
    ring
  rw [hrewrite]
  have htranslation :
      (∫ s : Real, f (Lambda * (s - t))) =
        ∫ x : Real, f (Lambda * x) := by
    let g : Real → Real := fun x => f (Lambda * x)
    have hgcont : Continuous g :=
      hfcont.comp (continuous_const.mul continuous_id)
    have hmap : Measure.map (fun x : Real => x + (-t)) volume = volume :=
      map_add_right_eq_self volume (-t)
    have hphi : AEMeasurable (fun x : Real => x + (-t)) volume :=
      (continuous_id.add continuous_const).aemeasurable
    calc
      (∫ s : Real, f (Lambda * (s - t))) =
          ∫ s : Real, g (s + (-t)) := by
            apply integral_congr_ae
            filter_upwards with s
            simp only [g, sub_eq_add_neg]
      _ = ∫ x : Real, g x := by
        calc
          (∫ s : Real, g (s + (-t))) =
              ∫ x : Real, g x ∂Measure.map (fun x : Real => x + (-t)) volume :=
            (integral_map hphi hgcont.aestronglyMeasurable).symm
          _ = ∫ x : Real, g x := by rw [hmap]
      _ = ∫ x : Real, f (Lambda * x) := rfl
  rw [htranslation, Measure.integral_comp_mul_left]
  have hbase : (∫ x : Real, f x) = Real.pi := by
    simpa only [f] using integral_univ_inv_one_add_sq
  rw [hbase, smul_eq_mul, abs_of_pos (inv_pos.mpr hLambda)]
  rw [div_eq_mul_inv]
  ring

/-- The same whole-line quadratic envelope is integrable.  This deliberately
keeps the translation and dilation steps separate so subsequent Schur bounds
can use it as an ordinary Bochner-integrable majorant. -/
theorem integrable_quadraticTimeEnvelope_univ
    {Lambda t : Real} (hLambda : 0 < Lambda) :
    Integrable (fun s : Real => quadraticTimeEnvelope Lambda t s) volume := by
  let f : Real → Real := fun u => (1 + u ^ 2)⁻¹
  have hf : Integrable f volume := by
    simpa only [f] using integrable_inv_one_add_sq
  have hscale : Integrable (fun x : Real => f (Lambda * x)) volume :=
    hf.comp_mul_left' hLambda.ne'
  have htranslate : Integrable (fun s : Real => f (Lambda * (s - t))) volume := by
    simpa only [sub_eq_add_neg] using hscale.comp_sub_right t
  refine htranslate.congr ?_
  filter_upwards with s
  unfold quadraticTimeEnvelope
  dsimp only [f]
  congr 2
  ring

/-- Whole-line row Schur estimate for a complex time kernel dominated by the
quadratic central/outer envelope.  The ordinary integrability hypothesis is
kept explicit, which is exactly what the later Fubini/TT* layer supplies. -/
theorem integral_norm_le_of_quadraticTimeEnvelope_univ
    {A rho Lambda t : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun s : Real => ‖L t s‖) volume)
    (hbound : ∀ s : Real,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ s : Real, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  have henv_integrable : Integrable (fun s : Real =>
      A * rho * quadraticTimeEnvelope Lambda t s) volume :=
    (integrable_quadraticTimeEnvelope_univ hLambda).const_mul (A * rho)
  calc
    (∫ s : Real, ‖L t s‖) ≤
        ∫ s : Real, A * rho * quadraticTimeEnvelope Lambda t s :=
      integral_mono hL_integrable henv_integrable hbound
    _ = A * rho * (∫ s : Real, quadraticTimeEnvelope Lambda t s) := by
      rw [integral_const_mul]
    _ = A * rho * (Real.pi / Lambda) := by
      rw [integral_quadraticTimeEnvelope_univ_eq_pi_div hLambda]

/-- The matching whole-line column estimate, by transposition and the exact
symmetry of the time-difference envelope. -/
theorem integral_norm_le_of_quadraticTimeEnvelope_univ_column
    {A rho Lambda s : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun t : Real => ‖L t s‖) volume)
    (hbound : ∀ t : Real,
      ‖L t s‖ ≤ A * rho * quadraticTimeEnvelope Lambda t s) :
    (∫ t : Real, ‖L t s‖) ≤ A * rho * (Real.pi / Lambda) := by
  apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hArho
    (fun t u => L u t)
  · simpa using hL_integrable
  · intro u
    rw [quadraticTimeEnvelope_symm]
    exact hbound u

/-- Whole-line row mass obtained directly from a central `A*rho` bound and
order-two off-diagonal decay at scale `Lambda`. -/
theorem integral_norm_le_of_central_outer_univ
    {A rho Lambda t : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun s : Real => ‖L t s‖) volume)
    (hcentral : ∀ s : Real, ‖L t s‖ ≤ A * rho)
    (houter : ∀ s : Real, Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    (∫ s : Real, ‖L t s‖) ≤ (2 * A) * rho * (Real.pi / Lambda) := by
  have hTwoArho : 0 ≤ (2 * A) * rho := by
    calc
      0 ≤ 2 * (A * rho) := mul_nonneg (by norm_num) hArho
      _ = (2 * A) * rho := by ring
  apply integral_norm_le_of_quadraticTimeEnvelope_univ hLambda hTwoArho L
    hL_integrable
  intro s
  exact norm_le_quadraticTimeEnvelope_of_central_outer hArho hLambda.le L
    (hcentral s) (houter s)

/-- Matching whole-line column mass for the central/outer kernel package. -/
theorem integral_norm_le_of_central_outer_univ_column
    {A rho Lambda s : Real} (hLambda : 0 < Lambda) (hArho : 0 ≤ A * rho)
    (L : Real → Real → Complex)
    (hL_integrable : Integrable (fun t : Real => ‖L t s‖) volume)
    (hcentral : ∀ t : Real, ‖L t s‖ ≤ A * rho)
    (houter : ∀ t : Real, Lambda * |t - s| ≠ 0 →
      ‖L t s‖ ≤ A * rho * ((Lambda * |t - s|) ^ 2)⁻¹) :
    (∫ t : Real, ‖L t s‖) ≤ (2 * A) * rho * (Real.pi / Lambda) := by
  have hTwoArho : 0 ≤ (2 * A) * rho := by
    calc
      0 ≤ 2 * (A * rho) := mul_nonneg (by norm_num) hArho
      _ = (2 * A) * rho := by ring
  apply integral_norm_le_of_quadraticTimeEnvelope_univ_column hLambda hTwoArho L
    hL_integrable
  intro t
  exact norm_le_quadraticTimeEnvelope_of_central_outer hArho hLambda.le L
    (hcentral t) (houter t)

end

end ScratchKakeyaGlobalTimeEnvelope
end
-- END ScratchKakeyaGlobalTimeEnvelope

-- BEGIN ScratchKakeyaGlobalComplexSchur
section

namespace ScratchKakeyaGlobalComplexSchur

open MeasureTheory Set
open Auto.Spherical.MSS

noncomputable section

/-- Complex-valued whole-line quadratic Schur, reduced to the existing
nonnegative symmetric-kernel theorem.  The three product-integrability
hypotheses are deliberately explicit: they are precisely the Fubini facts
that must be supplied by a concrete time profile and kernel. -/
theorem norm_integral_integral_le_of_symmetricSchur
    (L : Real → Real → Complex) (R : Real)
    (hLsymm : ∀ t s : Real, ‖L t s‖ = ‖L s t‖)
    (hrow : ∀ t : Real, Integrable (fun s : Real => ‖L t s‖) volume)
    (hrowbound : ∀ t : Real, (∫ s : Real, ‖L t s‖) ≤ R)
    (H : Real → Complex)
    (hHsq : Integrable (fun t : Real => ‖H t‖ ^ 2) volume)
    (hquad : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖) (volume.prod volume))
    (hleft : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.1‖ ^ 2) (volume.prod volume))
    (hright : Integrable (fun p : Real × Real =>
      ‖L p.1 p.2‖ * ‖H p.2‖ ^ 2) (volume.prod volume))
    (hcomplex : Integrable (fun p : Real × Real =>
      L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)) (volume.prod volume)) :
    ‖∫ t : Real, ∫ s : Real,
      L t s * H t * starRingEnd Complex (H s)‖ ≤
        R * ∫ t : Real, ‖H t‖ ^ 2 := by
  have hschur := aux_kernelQuadratic_le_of_symmetricSchur volume
    (fun t s : Real => ‖L t s‖) R
    (by intro t s; exact norm_nonneg _)
    hLsymm hrow hrowbound
    (fun t : Real => ‖H t‖) hHsq hquad hleft hright
  calc
    ‖∫ t : Real, ∫ s : Real,
        L t s * H t * starRingEnd Complex (H s)‖ =
        ‖∫ p : Real × Real,
          L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)‖ := by
      rw [integral_integral hcomplex, Measure.volume_eq_prod]
    _ ≤ ∫ p : Real × Real,
        ‖L p.1 p.2 * H p.1 * starRingEnd Complex (H p.2)‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ p : Real × Real,
        ‖L p.1 p.2‖ * ‖H p.1‖ * ‖H p.2‖ := by
      apply integral_congr_ae
      filter_upwards with p
      rw [norm_mul, norm_mul, starRingEnd_apply, norm_star]
    _ = ∫ t : Real, ∫ s : Real,
        ‖L t s‖ * ‖H t‖ * ‖H s‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ hquad
    _ ≤ R * ∫ t : Real, ‖H t‖ ^ 2 := hschur

end

end ScratchKakeyaGlobalComplexSchur
end
-- END ScratchKakeyaGlobalComplexSchur

