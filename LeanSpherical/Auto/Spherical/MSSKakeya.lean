section

namespace Auto.Spherical.MSS.ScratchKakeyaCanonicalWidthLogTransfer

open Filter MeasureTheory Set
open Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
open Auto.Spherical.MSS.KakeyaWidthLogTransfer

noncomputable section

/-- A canonical dyadic physical width has at most a fixed (core-radius
dependent) multiple of the base logarithmic loss. -/
theorem canonicalWidth_log_threeHalves_le
    {delta r : Real} (hdelta : 0 < delta) (hdeltaOne : delta <= 1)
    (hr : 0 < r) (j : Nat)
    (hrhoOne : delta / canonicalBandlimitedDyadicScale r j <= 1) :
    (1 + |Real.log (delta / canonicalBandlimitedDyadicScale r j)|) ^
        (3 / 2 : Real) <=
      (1 + |Real.log (2 / r)|) ^ (3 / 2 : Real) *
        (1 + |Real.log delta|) ^ (3 / 2 : Real) := by
  let s : Real := canonicalBandlimitedDyadicScale r j
  have hs : 0 < s := canonicalBandlimitedDyadicScale_pos hr j
  have hscale : s <= r / 2 := canonicalBandlimitedDyadicScale_le_half_radius hr j
  have htwos : 2 * s <= r := by linarith
  have hratio : 2 / r <= 1 / s := by
    exact (div_le_div_iff₀ hr hs).2 (by simpa only [one_mul] using htwos)
  have hbelow : (2 / r) * delta <= delta / s := by
    calc
      (2 / r) * delta <= (1 / s) * delta :=
        mul_le_mul_of_nonneg_right hratio hdelta.le
      _ = delta / s := by ring
  have hrho : 0 < delta / s := div_pos hdelta hs
  have hlog : 1 + |Real.log (delta / s)| <=
      (1 + |Real.log (2 / r)|) * (1 + |Real.log delta|) := by
    exact one_add_abs_log_width_le_of_mul_le
      (by positivity : 0 < 2 / r) hdelta hdeltaOne hrho hrhoOne
      (by simpa only using hbelow)
  have hleft : 0 <= 1 + |Real.log (delta / s)| := by positivity
  have hfac : 0 <= 1 + |Real.log (2 / r)| := by positivity
  have hdeltaLog : 0 <= 1 + |Real.log delta| := by positivity
  have hpow := Real.rpow_le_rpow hleft hlog (by norm_num : 0 <= (3 / 2 : Real))
  calc
    (1 + |Real.log (delta / canonicalBandlimitedDyadicScale r j)|) ^
        (3 / 2 : Real) =
        (1 + |Real.log (delta / s)|) ^ (3 / 2 : Real) := by rfl
    _ <= ((1 + |Real.log (2 / r)|) *
        (1 + |Real.log delta|)) ^ (3 / 2 : Real) := hpow
    _ = (1 + |Real.log (2 / r)|) ^ (3 / 2 : Real) *
        (1 + |Real.log delta|) ^ (3 / 2 : Real) :=
      Real.mul_rpow hfac hdeltaLog

end

end Auto.Spherical.MSS.ScratchKakeyaCanonicalWidthLogTransfer
end
-- END ScratchKakeyaCanonicalWidthLogTransfer

