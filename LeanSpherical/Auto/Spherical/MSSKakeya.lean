continuous TT* analysis map integrable automatically. -/
theorem integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous
    {u0 u1 t0 t1 : Real} (A : Real → Real → Complex)
    (hA : Continuous (Function.uncurry A))
    (H : Real → Complex) (hH : Continuous H) :
    Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u‖ ^ (2 : Nat))
      (volume.restrict (Icc u0 u1)) := by
  let G : Real × Real → Complex := fun p => A p.1 p.2 * H p.2
  have hG : Continuous G := by
    dsimp [G]
    exact hA.mul (hH.comp continuous_snd)
  have hF : Continuous (fun u : Real =>
      ttstarAnalysis (volume.restrict (Icc t0 t1)) A H u) := by
    unfold ttstarAnalysis
    change Continuous (fun u : Real => ∫ t in Icc t0 t1, G (u, t))
    exact continuous_parametric_integral_of_continuous (μ := volume) hG isCompact_Icc
  exact integrable_restrict_Icc_of_continuous _ (hF.norm.pow _)

