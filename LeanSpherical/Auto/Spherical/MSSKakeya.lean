noncomputable section

/-- The literal time derivative in the circle phase sends the finite tensor
time profile `H` to `tH`.  On the inner slab this costs only `25/4` in the
source energy.  This is the source-ready phase-E1 version of the generic
joint-smooth Schur estimate; unlike the unweighted lobe package, its left
side is exactly the datum occurring in the angular product rule. -/
theorem exists_timeWeighted_shiftedFiberLobeEnergy_scaled_E1_of_hasJoint
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (g : Real × Real → Real)
    (hg0 : HasJointSndSmooth 0 g) (hg2 : HasJointSndSmooth 2 g)
    (hleft : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds (1 / 2 : Real)] 0)
    (hright : ∀ rho : Real,
      (fun u : Real => g (rho, u)) =ᶠ[nhds 2] 0) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, lambda ≠ 0 →
      ∀ scale : Real, 0 ≤ scale →
      ∀ {ι : Type*} (s : Finset ι)
        (q : ι → SchwartzMap (Euclidean 2) Complex)
        (a : ι → SchwartzMap Real Complex) (xi : Euclidean 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      scale * shiftedFiberLobeEnergy g rho lambda
        (timeWeighted (scratch_finiteTensorTimeData s q a xi)) ≤
        scale * (B / (|lambda| * rho)) * shiftedFiberSourceEnergy s q a xi := by
  rcases exists_outerCircleParametricRealProfile_quadratic_E0_abs_of_support_subset_Ioc_of_hasJoint
      hrhoMax hrhoMax_small g hg0 hg2 hleft hright with ⟨B, hB, hbound⟩
  refine ⟨((5 / 2 : Real) ^ (2 : Nat)) * B, by positivity, ?_⟩
  intro rho hrho lambda hlambda scale hscale ι s q a xi rTime hrTime hsupport
  let H : Real → Complex := scratch_finiteTensorTimeData s q a xi
  let W : Real → Complex := timeWeighted H
  let A := outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda
  have hHcont : Continuous H := continuous_scratch_finiteTensorTimeData s q a xi
  have hHsupport : Function.support H ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) :=
    (support_scratch_finiteTensorTimeData_subset_innerSlab s q a xi hsupport).trans
      (closedBall_innerSlab_subset_Ioc hrTime)
  have hWcont : Continuous W := by
    dsimp [W]
    unfold timeWeighted
    exact (Complex.continuous_ofReal.comp continuous_id).mul hHcont
  have hWsupport : Function.support W ⊆ Ioc (1 / 2 : Real) (5 / 2 : Real) := by
    intro t ht
    apply hHsupport
    by_contra hdata
    have hz : H t = 0 := by
      exact not_ne_iff.mp (by simpa only [Function.mem_support] using hdata)
    exact ht (by simp [W, timeWeighted, hz])
  have hraw := hbound rho hrho lambda hlambda
    (1 / 2 : Real) (5 / 2 : Real) W hWcont (by norm_num) hWsupport
  have hgcont : Continuous g := by
    simpa [HasJointSndSmooth] using hg0
  have hAcont : Continuous (Function.uncurry A) :=
    continuous_uncurry_outerCircleParametricAnalysis_of_continuous g hgcont rho lambda
  have hFrestrict : Integrable (fun u : Real =>
      ‖ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A W u‖ ^
        (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) :=
    integrable_norm_sq_ttstarAnalysis_restrict_Icc_of_continuous A hAcont W hWcont
  have hAnalysis (u : Real) :
      ttstarAnalysis (volume.restrict (Icc (1 / 2 : Real) (5 / 2 : Real))) A W u =
        ttstarAnalysis volume A W u :=
    ttstarAnalysis_restrict_Icc_eq_volume_of_support_subset_Ioc
      A W (by norm_num) hWsupport u
  have hF : Integrable (fun u : Real =>
      ‖ttstarAnalysis volume A W u‖ ^ (2 : Nat))
      (volume.restrict (Icc (1 / 2 : Real) 2)) := by
    apply hFrestrict.congr
    filter_upwards with u
    rw [hAnalysis]
  have hreal := norm_real_smul_integral_mul_star_eq
    (volume.restrict (Icc (1 / 2 : Real) 2)) rho (le_of_lt hrho.1)
    (fun u : Real => ttstarAnalysis volume A W u) hF
  have hweighted := integrable_norm_sq_timeWeighted_scratch_finiteTensorTimeData_and_integral_le
    s q a xi hrTime hsupport (integrable_sq_scratch_finiteTensorTimeData s q a xi)
  have hfactor : 0 ≤ scale * (B / (|lambda| * rho)) := by
    have hden : 0 < |lambda| * rho :=
      mul_pos (abs_pos.mpr hlambda) hrho.1
    positivity
  have hraw' :
      scale * shiftedFiberLobeEnergy g rho lambda W ≤
        scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖W t‖ ^ (2 : Nat) := by
    change scale * shiftedFiberLobeEnergy g rho lambda W ≤ _
    unfold shiftedFiberLobeEnergy
    rw [← hreal]
    simpa only [A, hAnalysis, mul_assoc] using
      (mul_le_mul_of_nonneg_left hraw hscale)
  calc
    scale * shiftedFiberLobeEnergy g rho lambda W ≤
        scale * (B / (|lambda| * rho)) * ∫ t : Real, ‖W t‖ ^ (2 : Nat) := hraw'
    _ ≤ scale * (B / (|lambda| * rho)) *
        ((5 / 2 : Real) ^ (2 : Nat) * ∫ t : Real, ‖H t‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_left hweighted.2 hfactor
    _ = scale * ((((5 / 2 : Real) ^ (2 : Nat)) * B / (|lambda| * rho))) *
        shiftedFiberSourceEnergy s q a xi := by
      simp only [H, shiftedFiberSourceEnergy]
      ring

end

end Auto.Spherical.MSS.KakeyaTimeWeightedPhaseEnergy
end
-- END ScratchKakeyaTimeWeightedPhaseEnergy

