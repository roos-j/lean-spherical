namespace Auto.Spherical.MSS.KakeyaRadialBandLevel

open Filter MeasureTheory Set

noncomputable section

/-- The last dyadic frequency level needed to cover a compact spatial
multiplier whose support is contained in the ball of radius `4 / rho`. -/
noncomputable def kakeyaRadialBandLevel (rho : Real) : Nat :=
  ⌈Real.logb 2 (8 / rho)⌉₊

/-- The chosen last level really contains the compact multiplier support,
with harmless room for the Littlewood--Paley endpoint cutoff. -/
theorem four_div_rho_le_two_pow_kakeyaRadialBandLevel
    {rho : Real} (hrho : 0 < rho) :
    4 / rho ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho) := by
  have hu : 0 < 8 / rho := by positivity
  have hlog : Real.logb 2 (8 / rho) ≤ (kakeyaRadialBandLevel rho : Real) := by
    exact Nat.le_ceil _
  have hpow : 8 / rho ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho : Real) :=
    (Real.logb_le_iff_le_rpow one_lt_two hu).mp hlog
  have hpow' : 8 / rho ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho) := by
    simpa only [Real.rpow_natCast] using hpow
  have hfour : 4 / rho ≤ 8 / rho := by
    apply div_le_div_of_nonneg_right
    · norm_num
    · exact hrho.le
  exact hfour.trans hpow'

/-- The radial-band count is logarithmic in the reciprocal tube width. -/
theorem exists_kakeyaRadialBandLevel_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      ((kakeyaRadialBandLevel rho : Real) + 1) ≤
        A * (1 + |Real.log rho|) := by
  let B : Real := 2 + Real.log 8 / Real.log 2
  let D : Real := (Real.log 2)⁻¹
  let A : Real := B + D
  have hlogTwo : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hB : 0 < B := by
    dsimp [B]
    have : 0 ≤ Real.log 8 / Real.log 2 :=
      div_nonneg (Real.log_nonneg (by norm_num)) hlogTwo.le
    linarith
  have hD : 0 < D := by
    dsimp [D]
    positivity
  refine ⟨A, by dsimp [A]; linarith, ?_⟩
  intro rho hrho hrhoOne
  let L := kakeyaRadialBandLevel rho
  have hu : 1 ≤ 8 / rho := by
    apply (le_div_iff₀ hrho).mpr
    nlinarith
  have hlogNonneg : 0 ≤ Real.logb 2 (8 / rho) :=
    Real.logb_nonneg one_lt_two hu
  have hceil : (L : Real) < Real.logb 2 (8 / rho) + 1 := by
    dsimp only [L, kakeyaRadialBandLevel]
    exact Nat.ceil_lt_add_one hlogNonneg
  have hlogrho : Real.log rho ≤ 0 := Real.log_nonpos hrho.le hrhoOne
  have habs : |Real.log rho| = -Real.log rho := abs_of_nonpos hlogrho
  have hlogExpand : Real.logb 2 (8 / rho) =
      Real.log 8 / Real.log 2 - Real.log rho / Real.log 2 := by
    rw [← Real.log_div_log, Real.log_div (by norm_num) hrho.ne', sub_div]
  have hmain : (L : Real) + 1 ≤ B + D * |Real.log rho| := by
    apply le_of_lt
    calc
      (L : Real) + 1 < Real.logb 2 (8 / rho) + 2 := by linarith
      _ = B + D * |Real.log rho| := by
        dsimp [B, D]
        rw [hlogExpand, habs]
        field_simp [hlogTwo.ne']
        ring
  change (L : Real) + 1 ≤ A * (1 + |Real.log rho|)
  calc
    (L : Real) + 1 ≤ B + D * |Real.log rho| := hmain
    _ ≤ (B + D) * (1 + |Real.log rho|) := by
      have habsNonneg : 0 ≤ |Real.log rho| := abs_nonneg _
      nlinarith [mul_nonneg hB.le habsNonneg, mul_nonneg hD.le habsNonneg]
    _ = A * (1 + |Real.log rho|) := by rfl

end

end Auto.Spherical.MSS.KakeyaRadialBandLevel
end
-- END ScratchKakeyaRadialBandLevel

