section

namespace Auto.Spherical.MSS.KakeyaFiniteRadialFrequencyDecomposition

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.LittlewoodPaley
open Auto.Spherical.MSS.KakeyaRadialBandLevel
open Auto.Spherical.MSS.KakeyaAngularChartReassembly
open Auto.Spherical.MSS.KakeyaAngularChartReassembly.SmoothAngularFrequencyChartFamily
open Auto.Spherical.MSS.KakeyaScaledSectorPartition
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

/-- The retained central low-frequency contribution in the finite radial
decomposition.  It is kept separate because a ball-supported multiplier need
not vanish at the origin. -/
noncomputable def kakeyaRadialLowpassPiece
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (intDyadicLowpassMultiplier C.cutoff 0 : Euclidean 2 → Complex) m

/-- The `i`th positive integer homogeneous radial frequency piece. -/
noncomputable def kakeyaRadialBandPiece
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) :
      Euclidean 2 → Complex) m

theorem kakeyaRadialLowpassPiece_apply
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    (xi : Euclidean 2) :
    kakeyaRadialLowpassPiece C m xi =
      intDyadicLowpassMultiplier C.cutoff 0 xi * m xi := by
  unfold kakeyaRadialLowpassPiece
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (intDyadicLowpassMultiplier C.cutoff 0).hasTemperateGrowth]
  simp only [smul_eq_mul]

theorem kakeyaRadialBandPiece_apply
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat)
    (xi : Euclidean 2) :
    kakeyaRadialBandPiece C m i xi =
      intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi * m xi := by
  unfold kakeyaRadialBandPiece
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i)).hasTemperateGrowth]
  simp only [smul_eq_mul]

/-- The radial carrier frequency associated with the `i`th band.  Its active
annulus is `[lambda / 2, 2 lambda] = [2^i, 2^(i+2)]`. -/
noncomputable def kakeyaRadialBandScale (i : Nat) : Real :=
  (2 : Real) ^ (i + 1)

theorem kakeyaRadialBandScale_pos (i : Nat) :
    0 < kakeyaRadialBandScale i := by
  unfold kakeyaRadialBandScale
  positivity

/-- The finite homogeneous family has exactly the prescribed logarithmic
number of bands; the lowpass residual is an additional single piece. -/
theorem kakeyaRadialBand_count (rho : Real) :
    (Finset.range (kakeyaRadialBandLevel rho)).card =
      kakeyaRadialBandLevel rho := by
  exact Finset.card_range _

theorem kakeyaRadialBandScale_half (i : Nat) :
    kakeyaRadialBandScale i / 2 = (2 : Real) ^ i := by
  unfold kakeyaRadialBandScale
  rw [pow_succ]
  ring

theorem two_mul_kakeyaRadialBandScale (i : Nat) :
    2 * kakeyaRadialBandScale i = (2 : Real) ^ (i + 2) := by
  unfold kakeyaRadialBandScale
  have h : i + 2 = (i + 1) + 1 := by omega
  rw [h, pow_succ]
  ring

/-- A compact multiplier supported in the ball `|xi| <= 4 / rho` has an
exact finite radial Littlewood--Paley decomposition at the explicit
logarithmic level `kakeyaRadialBandLevel rho`. -/
theorem kakeyaRadialMultiplier_reassembly
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho)))
    (xi : Euclidean 2) :
    m xi = kakeyaRadialLowpassPiece C m xi +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C m i xi := by
  have hsuppLevel : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 ((2 : Real) ^
        ((0 : Int) + kakeyaRadialBandLevel rho))) := by
    intro z hz
    rw [Metric.mem_closedBall, dist_zero_right]
    have hsupport := hsupp hz
    rw [Metric.mem_closedBall, dist_zero_right] at hsupport
    calc
      ‖z‖ ≤ 4 / rho := hsupport
      _ ≤ (2 : Real) ^ (kakeyaRadialBandLevel rho) :=
        four_div_rho_le_two_pow_kakeyaRadialBandLevel hrho
      _ = (2 : Real) ^ ((0 : Int) + kakeyaRadialBandLevel rho) := by norm_num
  simpa only [kakeyaRadialLowpassPiece_apply, kakeyaRadialBandPiece_apply] using
    (scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands C m 0
      (kakeyaRadialBandLevel rho) hsuppLevel xi)

/-- Schwartz-map form of the finite radial multiplier reassembly. -/
theorem kakeyaRadialMultiplier_reassembly_schwartz
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho))) :
    m = kakeyaRadialLowpassPiece C m +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C m i := by
  ext xi
  rw [add_apply, sum_apply]
  exact kakeyaRadialMultiplier_reassembly C m hrho hsupp xi

/-- The corresponding physical-space inverse-Fourier reassembly, still as
an equality of Schwartz maps. -/
theorem kakeyaRadialPhysical_reassembly_schwartz
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho))) :
    FourierTransform.fourierInv m =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C m) +
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
          FourierTransform.fourierInv (kakeyaRadialBandPiece C m i) := by
  calc
    FourierTransform.fourierInv m =
        FourierTransform.fourierInv
          (kakeyaRadialLowpassPiece C m +
            ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
              kakeyaRadialBandPiece C m i) :=
      congrArg FourierTransform.fourierInv
        (kakeyaRadialMultiplier_reassembly_schwartz C m hrho hsupp)
    _ = _ := by
      rw [FourierTransform.fourierInv_add, FourierTransform.fourierInv_sum]

/-- Pointwise physical-space version of the inverse-Fourier reassembly. -/
theorem kakeyaRadialPhysical_reassembly
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho)))
    (x : Euclidean 2) :
    FourierTransform.fourierInv m x =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C m) x +
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
          FourierTransform.fourierInv (kakeyaRadialBandPiece C m i) x := by
  have h := congrArg (fun q : SchwartzMap (Euclidean 2) Complex => q x)
    (kakeyaRadialPhysical_reassembly_schwartz C m hrho hsupp)
  simpa only [add_apply, sum_apply] using h

/-- The canonical compact tube multiplier has the generic finite radial
reassembly without any extra support argument. -/
theorem scratch_canonicalBandlimitedTube_kakeyaRadial_reassembly
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho)
    (xi : Euclidean 2) :
    scratch_canonicalBandlimitedTubeMultiplier rho hrho xi =
      kakeyaRadialLowpassPiece C
        (scratch_canonicalBandlimitedTubeMultiplier rho hrho) xi +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        kakeyaRadialBandPiece C
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho) i xi := by
  exact kakeyaRadialMultiplier_reassembly C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) hrho
    (support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho) xi

/-- Physical inverse-Fourier form of the canonical multiplier’s finite
radial reassembly. -/
theorem scratch_canonicalBandlimitedTube_kakeyaRadialPhysical_reassembly
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho)
    (x : Euclidean 2) :
    FourierTransform.fourierInv (scratch_canonicalBandlimitedTubeMultiplier rho hrho) x =
      FourierTransform.fourierInv
        (kakeyaRadialLowpassPiece C
          (scratch_canonicalBandlimitedTubeMultiplier rho hrho)) x +
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho),
        FourierTransform.fourierInv
          (kakeyaRadialBandPiece C
            (scratch_canonicalBandlimitedTubeMultiplier rho hrho) i) x := by
  exact kakeyaRadialPhysical_reassembly C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) hrho
    (support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho) x

/-- The low residual is confined to the fixed central ball of radius two. -/
theorem support_kakeyaRadialLowpassPiece_subset_closedBall_two
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) :
    Set.Subset (Function.support (kakeyaRadialLowpassPiece C m :
      Euclidean 2 → Complex)) (Metric.closedBall 0 2) := by
  intro xi hxi
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra hnot
  have htwo : 2 ≤ ‖xi‖ := le_of_not_ge hnot
  have hzero : intDyadicLowpassMultiplier C.cutoff 0 xi = 0 := by
    apply intDyadicLowpass_eq_zero_of_le_norm C
    norm_num
    exact htwo
  exact hxi (by rw [kakeyaRadialLowpassPiece_apply, hzero, zero_mul])

/-- Every positive dyadic radial piece is supported in the annulus carried by
the scaled four-chart family at its own frequency scale. -/
theorem kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    ∀ xi : Euclidean 2, kakeyaRadialBandPiece C m i xi ≠ 0 →
      xi ∈ scaledDyadicFrequencyAnnulus (kakeyaRadialBandScale i) := by
  intro xi hxi
  have hband : intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi ≠ 0 := by
    intro hzero
    exact hxi (by rw [kakeyaRadialBandPiece_apply, hzero, zero_mul])
  have hbounds := intDyadicBandpass_norm_bounds_of_ne_zero C hband
  change kakeyaRadialBandScale i / 2 ≤ ‖xi‖ ∧ ‖xi‖ ≤
    2 * kakeyaRadialBandScale i
  constructor
  · rw [kakeyaRadialBandScale_half]
    have hleft : (2 : Real) ^ i < ‖xi‖ := by
      simpa only [zero_add, zpow_natCast] using hbounds.1
    exact hleft.le
  · rw [two_mul_kakeyaRadialBandScale]
    have hrightInt : ‖xi‖ < (2 : Real) ^ ((i : Int) + 2) := by
      simpa only [zero_add] using hbounds.2
    have hcast : (i : Int) + 2 = ((i + 2 : Nat) : Int) := by omega
    rw [hcast, zpow_natCast] at hrightInt
    have hright : ‖xi‖ < (2 : Real) ^ (i + 2) := hrightInt
    exact hright.le

/-- Direct compatibility datum for the scaled four-chart partition. -/
theorem kakeyaRadialBandPiece_supportedOn_scaledDyadicFourChartFamily
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
      (kakeyaRadialBandScale_pos i)).SupportedOnActive
        (kakeyaRadialBandPiece C m i) := by
  exact kakeyaRadialBandPiece_supportedOn_scaledDyadicFrequencyAnnulus C m i

/-- The four scaled angular charts reassemble each radial band exactly. -/
theorem kakeyaRadialBandPiece_reassembly_by_scaledCharts
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    kakeyaRadialBandPiece C m i =
      ∑ j ∈ Finset.univ,
        (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
          (kakeyaRadialBandScale_pos i)).chartProfile j
          (kakeyaRadialBandPiece C m i) := by
  symm
  ext xi
  exact (scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
    (kakeyaRadialBandScale_pos i)).sum_chartProfile_eq
      (kakeyaRadialBandPiece C m i)
      (kakeyaRadialBandPiece_supportedOn_scaledDyadicFourChartFamily C m i) xi

end

end Auto.Spherical.MSS.KakeyaFiniteRadialFrequencyDecomposition
end
-- END ScratchKakeyaFiniteRadialFrequencyDecomposition

-- BEGIN ScratchKakeyaFiniteRadialPhysicalMaxReassembly
section

namespace Auto.Spherical.MSS.KakeyaFiniteRadialPhysicalMaxReassembly

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.LittlewoodPaley
open Auto.Spherical.MSS.KakeyaRadialBandLevel
open Auto.Spherical.MSS.KakeyaAngularChartReassembly
open Auto.Spherical.MSS.KakeyaFiniteRadialFrequencyDecomposition
open scoped BigOperators Convolution FourierTransform ENNReal EuclideanSpace Pointwise

noncomputable section

/-- The literal physical field obtained by inverse Fourier transform of a
parameterized compact multiplier. -/
noncomputable def kakeyaRadialPhysicalField
    {Theta : Type*} (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (m theta) x

/-- The physical low-frequency residual. -/
noncomputable def kakeyaRadialLowpassPhysicalField
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x

/-- The physical field of the `i`th homogeneous positive radial band. -/
noncomputable def kakeyaRadialBandPhysicalField
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (i : Nat) (theta : Theta) (x : Euclidean 2) : Complex :=
  FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x

/-- A single finite index family: the last index stores the lowpass
residual, and all prior indices store the corresponding homogeneous band. -/
noncomputable def kakeyaRadialPhysicalIndexedPiece
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    (rho : Real) (i : Nat) (theta : Theta) (x : Euclidean 2) : Complex :=
  if i = kakeyaRadialBandLevel rho then
    kakeyaRadialLowpassPhysicalField C m theta x
  else
    kakeyaRadialBandPhysicalField C m i theta x

/-- Exact physical reassembly into the `L + 1` indexed radial family, where
`L = kakeyaRadialBandLevel rho`. -/
theorem kakeyaRadialPhysicalField_reassembly_indexed
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (theta : Theta) (x : Euclidean 2) :
    kakeyaRadialPhysicalField m theta x =
      ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
        kakeyaRadialPhysicalIndexedPiece C m rho i theta x := by
  let L := kakeyaRadialBandLevel rho
  have hphysical := kakeyaRadialPhysical_reassembly C (m theta) hrho
    (hsupp theta) x
  change FourierTransform.fourierInv (m theta) x = _
  rw [hphysical]
  have hsum : ∑ i ∈ Finset.range L,
      kakeyaRadialPhysicalIndexedPiece C m rho i theta x =
      ∑ i ∈ Finset.range L,
        FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x := by
    apply Finset.sum_congr rfl
    intro i hi
    unfold kakeyaRadialPhysicalIndexedPiece
    rw [if_neg (ne_of_lt (Finset.mem_range.mp hi))]
    rfl
  have hlast : kakeyaRadialPhysicalIndexedPiece C m rho L theta x =
      FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x := by
    unfold kakeyaRadialPhysicalIndexedPiece
    rw [if_pos rfl]
    rfl
  calc
    FourierTransform.fourierInv (kakeyaRadialLowpassPiece C (m theta)) x +
        ∑ i ∈ Finset.range L,
          FourierTransform.fourierInv (kakeyaRadialBandPiece C (m theta) i) x =
        (∑ i ∈ Finset.range L,
          kakeyaRadialPhysicalIndexedPiece C m rho i theta x) +
          kakeyaRadialPhysicalIndexedPiece C m rho L theta x := by
      rw [hsum, hlast]
      exact add_comm _ _
    _ = ∑ i ∈ Finset.range (L + 1),
        kakeyaRadialPhysicalIndexedPiece C m rho i theta x := by
      rw [Finset.sum_range_succ]

/-- Finite Cauchy--Schwarz/Tonelli for the exact radial physical
reassembly.  This theorem deliberately leaves every indexed local maximal
estimate as an explicit hypothesis. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_of_indexed_bounds
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B : Nat → ENNReal)
    (hpieceMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)))
    (hpieceBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) ≤ B i) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i := by
  have h := lintegral_iSup_sq_finite_shell_sum_le_of_bounds
    (Theta := Theta) (X := Euclidean 2) volume
    (Finset.range (kakeyaRadialBandLevel rho + 1))
    (fun theta x => kakeyaRadialPhysicalField m theta x)
    (fun i theta x => kakeyaRadialPhysicalIndexedPiece C m rho i theta x)
    B
    (fun theta x =>
      kakeyaRadialPhysicalField_reassembly_indexed C m hrho hsupp theta x)
    hpieceMeas hpieceBound
  simpa only [Finset.card_range] using h

/-- The energy label for the indexed family: the terminal index is the
lowpass residual and every preceding label is the matching homogeneous-band
energy. -/
noncomputable def kakeyaRadialLowpassBandEnergyBound
    (rho : Real) (B0 : ENNReal) (Bband : Nat → ENNReal) (i : Nat) : ENNReal :=
  if i = kakeyaRadialBandLevel rho then B0 else Bband i

theorem sum_kakeyaRadialLowpassBandEnergyBound
    (rho : Real) (B0 : ENNReal) (Bband : Nat → ENNReal) :
    ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1),
      kakeyaRadialLowpassBandEnergyBound rho B0 Bband i =
        (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) + B0 := by
  rw [Finset.sum_range_succ]
  congr 1
  · apply Finset.sum_congr rfl
    intro i hi
    unfold kakeyaRadialLowpassBandEnergyBound
    rw [if_neg (ne_of_lt (Finset.mem_range.mp hi))]
  · unfold kakeyaRadialLowpassBandEnergyBound
    rw [if_pos rfl]

/-- The concrete lowpass-plus-bands form of finite radial maximal
reassembly.  The only analytic input is a supplied maximal-square bound for
the low residual and for every active homogeneous band. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_lowpass_and_band_bounds
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B0 : ENNReal) (Bband : Nat → ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B0)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ Bband i) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        (B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) := by
  let L := kakeyaRadialBandLevel rho
  let B := kakeyaRadialLowpassBandEnergyBound rho B0 Bband
  have hmeas : ∀ i ∈ Finset.range (L + 1),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) := by
    intro i hi
    by_cases hlast : i = L
    · subst i
      simpa only [L, kakeyaRadialPhysicalIndexedPiece, if_pos,
        kakeyaRadialLowpassPhysicalField] using hlowMeas
    · have hlt : i < L := by
        have hle := Finset.mem_range.mp hi
        omega
      simpa only [L, kakeyaRadialPhysicalIndexedPiece, if_neg hlast,
        kakeyaRadialBandPhysicalField] using
        hbandMeas i (Finset.mem_range.mpr hlt)
  have hbound : ∀ i ∈ Finset.range (L + 1),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialPhysicalIndexedPiece C m rho i theta x‖ ^ 2)) ≤ B i := by
    intro i hi
    by_cases hlast : i = L
    · subst i
      simpa only [B, L, kakeyaRadialLowpassBandEnergyBound,
        kakeyaRadialPhysicalIndexedPiece, if_pos,
        kakeyaRadialLowpassPhysicalField] using hlowBound
    · have hlt : i < L := by
        have hle := Finset.mem_range.mp hi
        omega
      simpa only [B, L, kakeyaRadialLowpassBandEnergyBound,
        kakeyaRadialPhysicalIndexedPiece, if_neg hlast,
        kakeyaRadialBandPhysicalField] using
        hbandBound i (Finset.mem_range.mpr hlt)
  have h := lintegral_iSup_sq_kakeyaRadialPhysicalField_le_of_indexed_bounds
    C m hrho hsupp B (by simpa only [L] using hmeas)
    (by simpa only [L] using hbound)
  calc
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
        ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
          ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i := h
    _ = ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
        (B0 + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) := by
      rw [show (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho + 1), B i) =
          (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) + B0 by
        simpa only [B] using sum_kakeyaRadialLowpassBandEnergyBound rho B0 Bband]
      rw [add_comm (∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), Bband i) B0]

/-- With one common analytic maximal-square bound for the low residual and
every band, finite reassembly costs the square of the number of physical
pieces. -/
theorem lintegral_iSup_sq_kakeyaRadialPhysicalField_le_uniform
    {Theta : Type*} (C : lpCutoffs 2)
    (m : Theta → SchwartzMap (Euclidean 2) Complex)
    {rho : Real} (hrho : 0 < rho)
    (hsupp : ∀ theta, Set.Subset (Function.support (m theta :
      Euclidean 2 → Complex)) (Metric.closedBall 0 (4 / rho)))
    (B : ENNReal)
    (hlowMeas : Measurable (fun x : Euclidean 2 =>
      ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)))
    (hbandMeas : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      Measurable (fun x : Euclidean 2 =>
        ⨆ theta : Theta, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)))
    (hlowBound :
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialLowpassPhysicalField C m theta x‖ ^ 2)) ≤ B)
    (hbandBound : ∀ i ∈ Finset.range (kakeyaRadialBandLevel rho),
      (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField C m i theta x‖ ^ 2)) ≤ B) :
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
      ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * B := by
  have h := lintegral_iSup_sq_kakeyaRadialPhysicalField_le_lowpass_and_band_bounds
    C m hrho hsupp B (fun _ => B) hlowMeas hbandMeas hlowBound
    (by
      intro i hi
      exact hbandBound i hi)
  calc
    (∫⁻ x : Euclidean 2, ⨆ theta : Theta, ENNReal.ofReal
      (‖kakeyaRadialPhysicalField m theta x‖ ^ 2)) ≤
        ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) *
          (B + ∑ i ∈ Finset.range (kakeyaRadialBandLevel rho), B) := h
    _ = ((kakeyaRadialBandLevel rho + 1 : Nat) : ENNReal) ^ 2 * B := by
      simp [pow_two, mul_assoc]
      ring

/-- The cardinality of the radial lowpass-plus-bands family is logarithmic
in the reciprocal width. -/
theorem exists_kakeyaRadialPhysicalPieces_card_log_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      ((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) ≤
        A * (1 + |Real.log rho|) := by
  rcases exists_kakeyaRadialBandLevel_log_bound with ⟨A, hApos, hA⟩
  refine ⟨A, hApos, ?_⟩
  intro rho hrho hrhoOne
  simpa only [Finset.card_range, Nat.cast_add, Nat.cast_one] using
    hA rho hrho hrhoOne

/-- Consequently the square loss in the uniform Cauchy/Tonelli estimate is
at worst quadratic logarithmic in the reciprocal width. -/
theorem exists_kakeyaRadialPhysicalPieces_card_sq_log_sq_bound :
    ∃ A : Real, 0 < A ∧ ∀ rho : Real, 0 < rho → rho ≤ 1 →
      (((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) ^ 2) ≤
        A * (1 + |Real.log rho|) ^ 2 := by
  rcases exists_kakeyaRadialPhysicalPieces_card_log_bound with ⟨A, hApos, hA⟩
  refine ⟨A ^ 2, sq_pos_of_pos hApos, ?_⟩
  intro rho hrho hrhoOne
  have hcard := hA rho hrho hrhoOne
  have hlog : 0 ≤ 1 + |Real.log rho| := by positivity
  have hcardNonneg : 0 ≤
      ((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) := by
    positivity
  nlinarith [sq_nonneg
    (((Finset.range (kakeyaRadialBandLevel rho + 1)).card : Real) -
      A * (1 + |Real.log rho|))]

end

end Auto.Spherical.MSS.KakeyaFiniteRadialPhysicalMaxReassembly
