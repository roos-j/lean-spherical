noncomputable section

/-- Apply the `i`th radial cutoff to every spatial tensor profile.  The
finite-tensor multiplier then commutes exactly with the same cutoff. -/
noncomputable def finiteTensorRadialBandProfiles
    {iota : Type*} (C : lpCutoffs 2)
    (q : iota -> SchwartzMap (Euclidean 2) Complex) (i : Nat) :
    iota -> SchwartzMap (Euclidean 2) Complex :=
  fun l => kakeyaRadialBandPiece C (q l) i

theorem finiteTensorRadialBandProfiles_apply
    {iota : Type*} (C : lpCutoffs 2)
    (q : iota -> SchwartzMap (Euclidean 2) Complex) (i : Nat)
    (l : iota) (xi : Euclidean 2) :
    finiteTensorRadialBandProfiles C q i l xi =
      intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi * q l xi := by
  unfold finiteTensorRadialBandProfiles
  exact kakeyaRadialBandPiece_apply C (q l) i xi

theorem finiteTensorRadialBandProfiles_compact
    {iota : Type*} (C : lpCutoffs 2)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (i : Nat) :
    forall l, HasCompactSupport
      (finiteTensorRadialBandProfiles C q i l : Euclidean 2 -> Complex) := by
  intro l
  rw [show (finiteTensorRadialBandProfiles C q i l : Euclidean 2 -> Complex) =
      fun xi => intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi * q l xi by
        funext xi
        exact finiteTensorRadialBandProfiles_apply C q i l xi]
  exact (hqcompact l).mul_left

/-- Radial localization commutes with the complete finite time-tensor
multiplier; all temporal cross terms are retained. -/
theorem scratch_finiteTensorTubeMultiplier_radialBand_eq
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) (omega : Euclidean 2) :
    scratch_finiteTensorTubeMultiplier s (finiteTensorRadialBandProfiles C q i)
      (finiteTensorRadialBandProfiles_compact C q hqcompact i) a omega =
      kakeyaRadialBandPiece C
        (scratch_finiteTensorTubeMultiplier s q hqcompact a omega) i := by
  ext xi
  rw [scratch_finiteTensorTubeMultiplier_apply,
    kakeyaRadialBandPiece_apply,
    scratch_finiteTensorTubeMultiplier_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro l hl
  rw [finiteTensorRadialBandProfiles_apply]
  ring

/-- The literal physical finite-tensor field of the radialized profiles is
definitionally the physical `i`th radial band. -/
theorem finiteTensorCircleMultiplierField_radialBand_eq
    {iota : Type*} (C : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    (theta : Real) (x : Euclidean 2) :
    finiteTensorCircleMultiplierField s (finiteTensorRadialBandProfiles C q i)
      (finiteTensorRadialBandProfiles_compact C q hqcompact i) a theta x =
      kakeyaRadialBandPhysicalField C
        (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
          (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
        i theta x := by
  unfold finiteTensorCircleMultiplierField kakeyaRadialBandPhysicalField
  rw [show (fun xi => scratch_finiteTensorTubeMultiplier s
      (finiteTensorRadialBandProfiles C q i)
      (finiteTensorRadialBandProfiles_compact C q hqcompact i) a
      (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta) xi) =
      fun xi => kakeyaRadialBandPiece C
        (scratch_finiteTensorTubeMultiplier s q hqcompact a
          (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta)) i xi by
    funext xi
    exact congrArg (fun z : SchwartzMap (Euclidean 2) Complex => z xi)
      (scratch_finiteTensorTubeMultiplier_radialBand_eq C s q hqcompact a i
        (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))]
  rw [SchwartzMap.fourierInv_coe]

end

end Auto.Spherical.MSS.KakeyaFiniteTensorRadialBandBridge
