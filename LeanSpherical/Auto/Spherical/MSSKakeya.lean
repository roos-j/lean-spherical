        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) *
        (‖xi‖ * (4 * eps)) * shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
  let B1 : Real := 4 * Mcut ^ (2 : Nat) +
    800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)
  let H : Real := shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi
  have hr : 0 < 4 * eps := by positivity
  have hnorm : 0 < ‖xi‖ := norm_pos_iff.mpr hxi
  have hden : 0 < ‖xi‖ * (4 * eps) := mul_pos hnorm hr
  have hH : 0 ≤ H := by
    dsimp only [H]
    exact shiftedFiberSourceEnergy_nonneg s (C.chartProfiles j q) a xi
  have hB1 : 0 ≤ B1 := by
    dsimp only [B1]
    positivity
  have hE0 := shellFrequencyEnergy_shiftedCharted_central_le_source_of_critical_upper
    C j s q hqcompact a heps K n lo hi xi hpolar hn hrTime hsupport hxi hhigh
    (A := 32)
  have hE1 := shellFrequencyEnergy_shiftedCharted_central_deriv_le_source_of_critical_window
    C j s q hqcompact a heps K n lo hi xi hpolar hn
    Mcut Mphase hMcut hMphase hcutBound hphaseBound hrTime hsupport hxi hlow hhigh
  norm_num at hE0
  constructor
  · have hcoef : (64 : Real) / (‖xi‖ * (4 * eps)) ≤
        (64 + B1) / (‖xi‖ * (4 * eps)) := by
      apply (div_le_div_iff_of_pos_right hden).mpr
      linarith
    calc
      shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
          lo hi xi ≤ (64 / (‖xi‖ * (4 * eps))) * H := by
        simpa only [H] using hE0
      _ ≤ ((64 + B1) / (‖xi‖ * (4 * eps))) * H :=
        mul_le_mul_of_nonneg_right hcoef hH
      _ = ((64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) /
          (‖xi‖ * (4 * eps))) *
          shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
        dsimp only [B1, H]
        ring
  · calc
      shellFrequencyEnergy
          (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
          lo hi xi ≤ B1 * (‖xi‖ * (4 * eps)) * H := by
        simpa only [B1, H] using hE1
      _ = (B1 * (‖xi‖ * (4 * eps))) * H := by ring
      _ ≤ ((64 + B1) * (‖xi‖ * (4 * eps))) * H := by
        apply mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right (by linarith : B1 ≤ 64 + B1) hden.le) hH
      _ = (64 + B1) * (‖xi‖ * (4 * eps)) * H := by ring
      _ = (64 + 4 * Mcut ^ (2 : Nat) +
        800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)) *
          (‖xi‖ * (4 * eps)) * shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
        dsimp only [B1, H]
        ring

set_option maxHeartbeats 1200000 in
/-- Uniform compact-carrier extraction for the actual central shell.  This
is the no-auxiliary-constant form intended for the concrete annular witness:
the returned `B` is independent of `eps`, `xi`, and the finite tensor. -/
theorem exists_shiftedCharted_central_i0_E0_E1_source_constant
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
    (s : Finset iota)
    (q : iota → SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
    (a : iota → SchwartzMap Real Complex)
    (K n : Nat) (hn : n < 7) (lo hi : Real) :
    ∃ B : Real, 0 < B ∧
      ∀ {eps : Real}, 0 < eps → 4 * eps ∈ Icc (0 : Real) rhoMax →
      ∀ xi : Euclidean 2,
      xi = ‖xi‖ • circleDirection (C.angle j xi) →
      ∀ {rTime : Real}, rTime < 1 →
      (∀ l, Function.support (a l : Real → Complex) ⊆
        closedBall (3 / 2 : Real) rTime) →
      xi ≠ 0 →
      1 ≤ ‖xi‖ * (4 * eps) ^ (2 : Nat) →
      ‖xi‖ * (4 * eps) ^ (2 : Nat) ≤ 32 →
      shellFrequencyEnergy
        (shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n 0)
        lo hi xi ≤
        (B / (‖xi‖ * (4 * eps))) *
          shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi ∧
      shellFrequencyEnergy
        (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n 0)
        lo hi xi ≤
        B * (‖xi‖ * (4 * eps)) *
          shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
  rcases exists_uniform_abs_bound_shiftedCentralCutoffDerivative n hrhoMax with
    ⟨Mcut, hMcut, hcut⟩
  rcases exists_uniform_abs_bound_shiftedCentralScaledPhase n hrhoMax with
    ⟨Mphase, hMphase, hphase⟩
  let B : Real := 64 + 4 * Mcut ^ (2 : Nat) +
    800 * (2 * Real.pi) ^ (2 : Nat) * Mphase ^ (2 : Nat)
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro eps heps hrmem xi hpolar rTime hrTime hsupport hxi hlow hhigh
  have hcutBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricCutoffDerivativeProfile n (4 * eps, u)| ≤ Mcut := by
    intro u hu
    exact hcut (4 * eps) hrmem u hu
  have hphaseBound : ∀ u ∈ Icc (-(1 / 2 : Real)) (1 / 2 : Real),
      |shiftedCentralParametricScaledPhaseProfile n (4 * eps, u)| ≤ Mphase := by
    intro u hu
    exact hphase (4 * eps) hrmem u hu
  have hpairs := shiftedCharted_central_i0_E0_E1_source_bounds_of_critical_window
    C j s q hqcompact a heps K n lo hi xi hpolar hn
    Mcut Mphase hMcut.le hMphase.le hcutBound hphaseBound
    hrTime hsupport hxi hlow hhigh
  simpa only [B] using hpairs

end

