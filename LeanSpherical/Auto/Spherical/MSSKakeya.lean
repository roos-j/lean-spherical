theorem shiftedCappedTerminalNegativeProfile_reflect
    (n : Nat) (c rho u : Real) :
    shiftedCappedTerminalNegativeProfile n c (rho, -u) =
      shiftedCappedTerminalReflectedNegativeProfile n c (rho, u) := by
  unfold shiftedCappedTerminalNegativeProfile
    shiftedCappedTerminalReflectedNegativeProfile shiftedReflectedOuterProfile
    shiftedOuterParametricProfile safeCappedTerminalReflectedNegativeLobe
  have harg : rho * -u = -rho * u := by ring
  rw [harg]

/-- At the fixed terminal cap `R = π/2`, the last capped shell has the same
two-lobe form as an ordinary dyadic shell.  The only additional datum is the
compact ratio `c ∈ [1/2,1]`; the safe ratio extension makes this a genuinely
jointly smooth amplitude family before it is restricted to that interval. -/
theorem shiftedCappedTelescopingCutoff_terminal_local_eq_lobes
    {eps c r : Real} (K n : Nat) (alpha u : Real)
    (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hcdef : c = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hr : r = (4 / 5 : Real) * (Real.pi / 2)) :
    shiftedCappedTelescopingCutoff eps K n (K + 1) alpha
      (alpha + stationaryShift n + r * u) =
        shiftedCappedTerminalPositiveProfile n c (r, u) +
          shiftedCappedTerminalNegativeProfile n c (r, u) := by
  rw [shiftedCappedTelescopingCutoff_local_coordinate]
  rw [cappedTelescopingCutoff_eq_terminal]
  rw [cappedTerminalShellCutoff_eq_rescaledUnitProfile (by positivity) K (r * u)]
  rw [← hcdef]
  have hratio : (r * u) / ((4 / 5 : Real) * (Real.pi / 2)) = u := by
    rw [hr]
    field_simp [Real.pi_ne_zero]
  rw [hratio]
  rw [← safeCappedTerminalUnitProfile_eq_cappedTerminalUnitProfile hc]
  rw [safeCappedTerminalUnitProfile_eq_positive_add_negative]
  unfold shiftedCappedTerminalPositiveProfile shiftedCappedTerminalNegativeProfile
    shiftedOuterParametricProfile
  ring

end

