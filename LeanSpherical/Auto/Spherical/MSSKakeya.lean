      (fun t => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) volume a b :=
  (continuous_outerCircleTTStarProductTimeKernel_left rho lambda s).norm.intervalIntegrable
    (μ := volume) a b

/-- Continuous Schur rows and columns for the genuine `chi * conj chi`
circle shell kernel.  This is the precise scalar kernel estimate required by
the fixed-frequency `TT*` step. -/
theorem exists_outerCircleTTStarProductTimeKernel_row_column_schur
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (hab : a ≤ b) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        (∀ t : Real,
          (∫ s in a..b, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) ∧
        (∀ s : Real,
          (∫ t in a..b, ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
            (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) := by
  rcases exists_outerCircleTTStarProductTimeKernel_outer_quadratic
      hrhoMax hrhoMax_small with ⟨A, hA, houter⟩
  let B : Real := max (3 / 2 : Real) A
  have hBcentral : (3 / 2 : Real) ≤ B := le_max_left _ _
  have hBouter : A ≤ B := le_max_right _ _
  have hB : 0 < B := lt_of_lt_of_le hA hBouter
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda
  have hrho_pos : 0 < rho := hrho.1
  have hLambda : 0 < lambda * rho ^ 2 :=
    mul_pos hlambda (sq_pos_of_pos hrho_pos)
  have hBrho : 0 ≤ B * rho := mul_nonneg hB.le hrho_pos.le
  constructor
  · intro t
    apply intervalIntegral_norm_le_of_central_outer
      hab hLambda hBrho (outerCircleTTStarProductTimeKernel rho lambda)
      (intervalIntegrable_outerCircleTTStarProductTimeKernel_right rho lambda t a b)
    · intro s hs
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarProductTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro s hs hscale
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)

  · intro s
    apply intervalIntegral_norm_le_of_central_outer_column
      hab hLambda hBrho (outerCircleTTStarProductTimeKernel rho lambda)
      (intervalIntegrable_outerCircleTTStarProductTimeKernel_left rho lambda s a b)
    · intro t ht
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            rho * (3 / 2 : Real) :=
          norm_outerCircleTTStarProductTimeKernel_le_central hrho_pos.le
        _ = (3 / 2 : Real) * rho := by ring
        _ ≤ B * rho := mul_le_mul_of_nonneg_right hBcentral hrho_pos.le
    · intro t ht hscale
      calc
        ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ ≤
            A * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ :=
          houter rho hrho lambda hlambda t s hscale
        _ ≤ B * rho * ((lambda * rho ^ 2 * |t - s|) ^ 2)⁻¹ := by
          apply mul_le_mul_of_nonneg_right
          · exact mul_le_mul_of_nonneg_right hBouter hrho_pos.le
          · exact inv_nonneg.mpr (sq_nonneg _)

theorem star_outerCircleTTStarProductAmplitude (u : Real) :
    starRingEnd Complex (outerCircleTTStarProductAmplitude u) =
      outerCircleTTStarProductAmplitude u := by
  unfold outerCircleTTStarProductAmplitude fixedOuterCircleUnitShellAmplitude
  simp

/-- The exact complex `TT*` kernel is Hermitian.  Consequently its norm
majorant is a symmetric nonnegative real kernel. -/
theorem outerCircleTTStarProductTimeKernel_swap_eq_star
    (rho lambda t s : Real) :
    outerCircleTTStarProductTimeKernel rho lambda s t =
      starRingEnd Complex (outerCircleTTStarProductTimeKernel rho lambda t s) := by
  unfold outerCircleTTStarProductTimeKernel
  rw [map_mul, Complex.conj_ofReal, ← intervalIntegral.intervalIntegral_conj]
  congr 1
  apply intervalIntegral.integral_congr_ae
  filter_upwards with u
  intro hu
  have hphase :
      (((s - t) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I =
        starRingEnd Complex
          ((((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I) := by
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    push_cast
    ring
  rw [hphase, Complex.exp_conj]
  let z : Complex :=
    (((t - s) * lambda * Real.cos (rho * u) : Real) : Complex) * Complex.I
  change outerCircleTTStarProductAmplitude u * star (Complex.exp z) =
    star (outerCircleTTStarProductAmplitude u * Complex.exp z)
  rw [star_mul, ← starRingEnd_apply (outerCircleTTStarProductAmplitude u),
    star_outerCircleTTStarProductAmplitude]
  ring

theorem norm_outerCircleTTStarProductTimeKernel_symm
    (rho lambda t s : Real) :
    ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ =
      ‖outerCircleTTStarProductTimeKernel rho lambda s t‖ := by
  rw [outerCircleTTStarProductTimeKernel_swap_eq_star]
  exact Complex.norm_conj _

/-- Reversing the frequency sign is the same as swapping the two time
variables for this difference kernel. -/
theorem outerCircleTTStarProductTimeKernel_neg_frequency_eq_swap
    (rho lambda t s : Real) :
    outerCircleTTStarProductTimeKernel rho (-lambda) t s =
      outerCircleTTStarProductTimeKernel rho lambda s t := by
  unfold outerCircleTTStarProductTimeKernel
  congr 1
  apply intervalIntegral.integral_congr_ae
  filter_upwards with u
  intro hu
  congr 2
  ring

/-- The literal shell Schur envelope depends on frequency only through its
absolute value.  This is the normalization bridge for the library Fourier
phase, whose convention has the opposite sign. -/
theorem norm_outerCircleTTStarProductTimeKernel_neg_frequency
    (rho lambda t s : Real) :
    ‖outerCircleTTStarProductTimeKernel rho (-lambda) t s‖ =
      ‖outerCircleTTStarProductTimeKernel rho lambda t s‖ := by
  rw [outerCircleTTStarProductTimeKernel_neg_frequency_eq_swap,
    norm_outerCircleTTStarProductTimeKernel_symm]

/-- The finite time measure used by the scalar fixed-frequency Schur step. -/
noncomputable def outerCircleTimeIntervalMeasure (a b : Real) : Measure Real :=
  volume.restrict (Ioc a b)

/-- The nonnegative symmetric majorant of the exact complex time `TT*`
kernel. -/
noncomputable def outerCircleTTStarProductNormKernel
    (rho lambda : Real) : Real → Real → Real :=
  fun t s => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖

/-- The source-level symmetric Schur calculation applied to the literal
circle shell.  The three displayed product-integrability hypotheses are the
ordinary Fubini data for the finite-tensor spectral input; the row mass itself
is furnished unconditionally by the circle IBP shell estimate. -/
theorem exists_outerCircleTTStarProductTimeKernel_quadratic_norm_schur
    {rhoMax a b : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (hab : a ≤ b) :
    ∃ B : Real, 0 < B ∧
      ∀ rho ∈ Ioc (0 : Real) rhoMax, ∀ lambda : Real, 0 < lambda →
        ∀ h : Real → Real,
          Integrable (fun t => h t ^ 2) (outerCircleTimeIntervalMeasure a b) →
          Integrable (fun p : Real × Real =>
            outerCircleTTStarProductNormKernel rho lambda p.1 p.2 * h p.1 * h p.2)
            ((outerCircleTimeIntervalMeasure a b).prod
              (outerCircleTimeIntervalMeasure a b)) →
          Integrable (fun p : Real × Real =>
            outerCircleTTStarProductNormKernel rho lambda p.1 p.2 * h p.1 ^ 2)
            ((outerCircleTimeIntervalMeasure a b).prod
              (outerCircleTimeIntervalMeasure a b)) →
          Integrable (fun p : Real × Real =>
            outerCircleTTStarProductNormKernel rho lambda p.1 p.2 * h p.2 ^ 2)
            ((outerCircleTimeIntervalMeasure a b).prod
              (outerCircleTimeIntervalMeasure a b)) →
          (∫ t, ∫ s,
            outerCircleTTStarProductNormKernel rho lambda t s * h t * h s
              ∂(outerCircleTimeIntervalMeasure a b)
            ∂(outerCircleTimeIntervalMeasure a b)) ≤
            ((2 * B) * rho * (Real.pi / (lambda * rho ^ 2))) *
              ∫ t, h t ^ 2 ∂(outerCircleTimeIntervalMeasure a b) := by
  rcases exists_outerCircleTTStarProductTimeKernel_row_column_schur
      hrhoMax hrhoMax_small hab with ⟨B, hB, hschur⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda h hsq hquad hleft hright
  letI : IsFiniteMeasure (outerCircleTimeIntervalMeasure a b) := by
    unfold outerCircleTimeIntervalMeasure
    infer_instance
  apply Auto.Spherical.MSS.aux_kernelQuadratic_le_of_symmetricSchur
    (μ := outerCircleTimeIntervalMeasure a b)
    (K := outerCircleTTStarProductNormKernel rho lambda)
    ((2 * B) * rho * (Real.pi / (lambda * rho ^ 2)))
  · intro t s
    exact norm_nonneg _
  · intro t s
    exact norm_outerCircleTTStarProductTimeKernel_symm rho lambda t s
  · intro t
    change Integrable
      (fun s => ‖outerCircleTTStarProductTimeKernel rho lambda t s‖)
      (volume.restrict (Ioc a b))
    exact (intervalIntegrable_outerCircleTTStarProductTimeKernel_right
      rho lambda t a b).1
  · intro t
    change (∫ s in Ioc a b,
      ‖outerCircleTTStarProductTimeKernel rho lambda t s‖) ≤
        (2 * B) * rho * (Real.pi / (lambda * rho ^ 2))
    simpa only [intervalIntegral.integral_of_le hab] using
      (hschur rho hrho lambda hlambda).1 t
  · exact hsq
  · exact hquad
  · exact hleft
  · exact hright

end

end ScratchKakeyaCircleTimeKernel
end
-- END ScratchKakeyaCircleTimeKernel

