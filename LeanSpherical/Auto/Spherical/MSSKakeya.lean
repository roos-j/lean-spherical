section

namespace Auto.Spherical.MSS.KakeyaWidthLogTransfer

open Filter MeasureTheory Set

noncomputable section

/-- A width bounded below by a fixed multiple of the base scale has no worse
logarithmic loss.  This is the elementary transfer used for the narrow
members of the positive dyadic core decomposition. -/
theorem one_add_abs_log_width_le_of_mul_le
    {c delta rho : Real} (hc : 0 < c) (hdelta : 0 < delta) (hdeltaOne : delta ≤ 1)
    (hrho : 0 < rho) (hrhoOne : rho ≤ 1) (hbelow : c * delta ≤ rho) :
    1 + |Real.log rho| ≤ (1 + |Real.log c|) * (1 + |Real.log delta|) := by
  have hlogdelta : Real.log delta ≤ 0 := Real.log_nonpos hdelta.le hdeltaOne
  have hlogrho : Real.log rho ≤ 0 := Real.log_nonpos hrho.le hrhoOne
  have hloglower := Real.log_le_log (mul_pos hc hdelta) hbelow
  rw [Real.log_mul hc.ne' hdelta.ne'] at hloglower
  have habsdelta : |Real.log delta| = -Real.log delta := abs_of_nonpos hlogdelta
  have habsrho : |Real.log rho| = -Real.log rho := abs_of_nonpos hlogrho
  have habsc : -Real.log c ≤ |Real.log c| := neg_le_abs _
  have habscNonneg : 0 ≤ |Real.log c| := abs_nonneg _
  have habsdeltaNonneg : 0 ≤ |Real.log delta| := abs_nonneg _
  rw [habsrho, habsdelta]
  nlinarith [mul_nonneg habscNonneg habsdeltaNonneg]

end

end Auto.Spherical.MSS.KakeyaWidthLogTransfer
end
-- END ScratchKakeyaWidthLogTransfer

-- BEGIN ScratchKakeyaBandlimitedDyadicBridge
section

namespace Auto.Spherical.MSS

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaSmoothDomination
open Auto.Spherical.SmoothDyadicPhysicalCore
open Auto.Spherical.LittlewoodPaley
open ScratchKakeyaBandlimitedCore
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

/-- The compact multiplier whose inverse transform is the canonical positive
core at physical tube width `rho`.  It is the `j = 0` member of the
canonical dyadic family after choosing the base radius `2 / rho`. -/
noncomputable def scratch_canonicalBandlimitedTubeMultiplier
    (rho : Real) (hrho : 0 < rho) : SchwartzMap (Euclidean 2) Complex :=
  canonicalBandlimitedDyadicMultiplier (2 / rho) (by positivity) 0

noncomputable def scratch_canonicalBandlimitedTubePhysicalCore
    (rho : Real) (hrho : 0 < rho) : SchwartzMap (Euclidean 2) Complex :=
  FourierTransform.fourierInv (scratch_canonicalBandlimitedTubeMultiplier rho hrho)

private theorem scratch_canonicalBandlimitedTube_scale_eq_inv
    {rho : Real} (hrho : 0 < rho) :
    canonicalBandlimitedDyadicScale (2 / rho) 0 = rho⁻¹ := by
  unfold canonicalBandlimitedDyadicScale
  field_simp [hrho.ne']

/-- The canonical tube multiplier has exactly the expected compact frequency
support `|xi| <= 4/rho`. -/
theorem support_scratch_canonicalBandlimitedTubeMultiplier_subset
    {rho : Real} (hrho : 0 < rho) :
    Set.Subset (Function.support
      (scratch_canonicalBandlimitedTubeMultiplier rho hrho :
        Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 / rho)) := by
  intro xi hxi
  have hbase := support_canonicalBandlimitedDyadicMultiplier_subset
    (r := 2 / rho) (by positivity) 0 hxi
  rw [Metric.mem_closedBall, dist_zero_right] at hbase ⊢
  have hscale : canonicalBandlimitedDyadicScale (2 / rho) 0 = rho⁻¹ :=
    scratch_canonicalBandlimitedTube_scale_eq_inv hrho
  calc
    ‖xi‖ ≤ 4 * canonicalBandlimitedDyadicScale (2 / rho) 0 := hbase
    _ = 4 / rho := by rw [hscale, div_eq_mul_inv]

/-- Its physical kernel is the nonnegative canonical core at width `rho`. -/
theorem scratch_canonicalBandlimitedTubePhysicalCore_re_eq
    {rho : Real} (hrho : 0 < rho) (u : Euclidean 2) :
    (scratch_canonicalBandlimitedTubePhysicalCore rho hrho u).re =
      (rho⁻¹) ^ 2 * (canonicalPositiveCore (rho⁻¹ • u)).re := by
  change (canonicalBandlimitedDyadicPhysicalCore (2 / rho) (by positivity) 0 u).re = _
  rw [canonicalBandlimitedDyadicPhysicalCore_re_eq]
  unfold canonicalBandlimitedDyadicCore
  rw [scratch_canonicalBandlimitedTube_scale_eq_inv hrho]

/-- After the original light-ray scale `delta` is pulled through the `j`th
canonical dyadic core, its physical width is exactly
`delta / canonicalBandlimitedDyadicScale r j`. -/
theorem scratch_rescaledCanonicalDyadicCore_eq_smoothTubeCore
    {delta r : Real} (hdelta : 0 < delta) (hr : 0 < r)
    (j : Nat) (omega y : Euclidean 2) (z : WaveSpaceTime) :
    (delta⁻¹) ^ 2 * canonicalBandlimitedDyadicCore r j
        (delta⁻¹ • (z.1 + z.2 • omega - y)) =
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        (delta / canonicalBandlimitedDyadicScale r j) omega y z := by
  let s : Real := canonicalBandlimitedDyadicScale r j
  have hs : 0 < s := canonicalBandlimitedDyadicScale_pos hr j
  have hdelta_ne : delta ≠ 0 := hdelta.ne'
  have hs_ne : s ≠ 0 := hs.ne'
  have hscale : (delta / s)⁻¹ = s * delta⁻¹ := by
    field_simp
  unfold canonicalBandlimitedDyadicCore scratch_smoothTubeCore
  change (delta⁻¹) ^ 2 *
      (s ^ 2 * (canonicalPositiveCore
        (s • (delta⁻¹ • (z.1 + z.2 • omega - y)))).re) = _
  rw [hscale, ← smul_smul]
  ring

/-- The literal polynomial light-ray kernel is pointwise dominated by
positive canonical bandlimited tube cores.  The `j`th term has physical
width `delta / canonicalBandlimitedDyadicScale r j`; this is the form that
splits into finitely many narrow scales and a broad tail. -/
theorem lightRayKernel_le_tsum_canonicalBandlimitedTubeCore
    {delta : Real} (hdelta : 0 < delta) (N : Nat) (hN : 2 < N)
    {c r : Real} (hc : 0 < c) (hr : 0 < r)
    (hcore : ∀ u : Euclidean 2, ‖u‖ ≤ r → c ≤ (canonicalPositiveCore u).re)
    (omega y : Euclidean 2) (z : WaveSpaceTime) :
    lightRayKernel delta N omega y z ≤
      ∑' j : Nat,
        canonicalBandlimitedDyadicCoefficient N c r j *
          scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
            (delta / canonicalBandlimitedDyadicScale r j) omega y z := by
  let u : Euclidean 2 := delta⁻¹ • (z.1 + z.2 • omega - y)
  have hprofile := lightRayDecayProfile_le_tsum_canonicalBandlimitedDyadicCore
    N hN hc hr hcore u
  have hscale : 0 ≤ (delta⁻¹) ^ 2 := pow_nonneg (inv_nonneg.mpr hdelta.le) _
  calc
    lightRayKernel delta N omega y z =
        (delta⁻¹) ^ 2 * lightRayDecayProfile N u := by
      simpa only [u] using
        lightRayKernel_eq_scaled_decayProfile hdelta N omega y z.1 z.2
    _ ≤ (delta⁻¹) ^ 2 *
        ∑' j : Nat, canonicalBandlimitedDyadicCoefficient N c r j *
          canonicalBandlimitedDyadicCore r j u :=
      mul_le_mul_of_nonneg_left hprofile hscale
    _ = ∑' j : Nat,
        canonicalBandlimitedDyadicCoefficient N c r j *
          scratch_smoothTubeCore (fun v => (canonicalPositiveCore v).re)
            (delta / canonicalBandlimitedDyadicScale r j) omega y z := by
      rw [← tsum_mul_left]
      apply tsum_congr
      intro j
      calc
        (delta⁻¹) ^ 2 *
            (canonicalBandlimitedDyadicCoefficient N c r j *
              canonicalBandlimitedDyadicCore r j u) =
            canonicalBandlimitedDyadicCoefficient N c r j *
              ((delta⁻¹) ^ 2 * canonicalBandlimitedDyadicCore r j u) := by ring
        _ = canonicalBandlimitedDyadicCoefficient N c r j *
            scratch_smoothTubeCore (fun v => (canonicalPositiveCore v).re)
              (delta / canonicalBandlimitedDyadicScale r j) omega y z := by
          rw [show u = delta⁻¹ • (z.1 + z.2 • omega - y) by rfl,
            scratch_rescaledCanonicalDyadicCore_eq_smoothTubeCore hdelta hr]

/-- A compact frequency multiplier is a *finite* radial sum: one low
frequency piece plus finitely many homogeneous bands.  The low piece is
essential, since a ball-supported multiplier need not vanish at frequency
zero. -/
theorem scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands
    (C : lpCutoffs 2) (m : SchwartzMap (Euclidean 2) Complex)
    (m0 : Int) (n : Nat)
    (hsupp : Set.Subset (Function.support (m : Euclidean 2 → Complex))
      (Metric.closedBall 0 ((2 : Real) ^ (m0 + n))))
    (xi : Euclidean 2) :
    m xi =
      intDyadicLowpassMultiplier C.cutoff m0 xi * m xi +
        ∑ i ∈ Finset.range n,
          intDyadicBandpassMultiplier C.cutoff (m0 + i) xi * m xi := by
  have htop :
      intDyadicLowpassMultiplier C.cutoff (m0 + n) xi * m xi = m xi := by
    by_cases hzero : m xi = 0
    · simp [hzero]
    · have hxi : xi ∈ Function.support (m : Euclidean 2 → Complex) :=
        Function.mem_support.mpr hzero
      have hnorm : ‖xi‖ ≤ (2 : Real) ^ (m0 + n) := by
        simpa only [Metric.mem_closedBall, dist_zero_right] using hsupp hxi
      rw [intDyadicLowpass_eq_one_of_norm_le C hnorm]
      ring
  calc
    m xi = intDyadicLowpassMultiplier C.cutoff (m0 + n) xi * m xi := htop.symm
    _ = intDyadicLowpassMultiplier C.cutoff m0 xi * m xi +
        (intDyadicLowpassMultiplier C.cutoff (m0 + n) xi -
          intDyadicLowpassMultiplier C.cutoff m0 xi) * m xi := by ring
    _ = _ := by
      rw [← finiteIntegerDyadicMultiplierResolution]

/-- There is always a finite upper radial cutoff covering the compact
canonical tube multiplier.  This deliberately makes no claim that the
homogeneous bands alone reconstruct the multiplier at zero frequency. -/
theorem scratch_exists_canonicalBandlimitedTube_finiteRadialResolution
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho) :
    ∃ n : Nat, ∀ xi : Euclidean 2,
      scratch_canonicalBandlimitedTubeMultiplier rho hrho xi =
        intDyadicLowpassMultiplier C.cutoff 0 xi *
          scratch_canonicalBandlimitedTubeMultiplier rho hrho xi +
        ∑ i ∈ Finset.range n,
          intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi *
            scratch_canonicalBandlimitedTubeMultiplier rho hrho xi := by
  have hpow : Filter.Tendsto (fun n : Nat => (2 : Real) ^ n)
      Filter.atTop Filter.atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨n, hn⟩ := Filter.eventually_atTop.1
    (hpow.eventually_gt_atTop (4 / rho))
  refine ⟨n, ?_⟩
  intro xi
  apply scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) 0 n
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  have hsupport := support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho hz
  rw [Metric.mem_closedBall, dist_zero_right] at hsupport
  exact (calc
    ‖z‖ ≤ 4 / rho := hsupport
    _ < (2 : Real) ^ n := hn n le_rfl
    _ = (2 : Real) ^ ((0 : Int) + n) := by norm_num).le

/-- Source-ready finite radial resolution at the canonical logarithmic band
level.  There is a central lowpass term and exactly
`kakeyaRadialBandLevel rho` homogeneous terms. -/
theorem scratch_canonicalBandlimitedTube_finiteRadialResolution_at_level
    (C : lpCutoffs 2) {rho : Real} (hrho : 0 < rho)
    (xi : Euclidean 2) :
    scratch_canonicalBandlimitedTubeMultiplier rho hrho xi =
      intDyadicLowpassMultiplier C.cutoff 0 xi *
        scratch_canonicalBandlimitedTubeMultiplier rho hrho xi +
      ∑ i ∈ Finset.range (KakeyaRadialBandLevel.kakeyaRadialBandLevel rho),
        intDyadicBandpassMultiplier C.cutoff ((0 : Int) + i) xi *
          scratch_canonicalBandlimitedTubeMultiplier rho hrho xi := by
  apply scratch_bandlimitedMultiplier_eq_lowpass_add_finiteBands C
    (scratch_canonicalBandlimitedTubeMultiplier rho hrho) 0
    (KakeyaRadialBandLevel.kakeyaRadialBandLevel rho)
  intro z hz
  rw [Metric.mem_closedBall, dist_zero_right]
  have hsupport := support_scratch_canonicalBandlimitedTubeMultiplier_subset hrho hz
  rw [Metric.mem_closedBall, dist_zero_right] at hsupport
  calc
    ‖z‖ ≤ 4 / rho := hsupport
    _ ≤ (2 : Real) ^ (KakeyaRadialBandLevel.kakeyaRadialBandLevel rho) :=
      KakeyaRadialBandLevel.four_div_rho_le_two_pow_kakeyaRadialBandLevel hrho
    _ = (2 : Real) ^ ((0 : Int) +
        KakeyaRadialBandLevel.kakeyaRadialBandLevel rho) := by norm_num

/-- The canonical positive physical core is exactly the squared-modulus
bandlimited core used by the broad-width artifact. -/
theorem scratch_canonicalPositiveCore_eq_normSqBandlimitedCore :
    canonicalPositiveCore =
      BandlimitedPositiveCore.scratch_normSqSchwartz
        (FourierTransform.fourierInv canonicalFrequencyBump) := by
  ext u
  rw [canonicalPositiveCore_apply_eq_normSq,
    BandlimitedPositiveCore.scratch_normSqSchwartz_apply]

theorem scratch_canonicalPositiveCore_re_eq_positiveBandlimitedCore
    (u : Euclidean 2) :
    (canonicalPositiveCore u).re =
      BandlimitedPositiveCore.scratch_positiveSchwartzCore
        (FourierTransform.fourierInv canonicalFrequencyBump) u := by
  rw [canonicalPositiveCore_apply_eq_normSq,
    BandlimitedPositiveCore.scratch_positiveSchwartzCore_apply]
  simp

theorem scratch_canonicalFrequencyBump_hasCompactSupport :
    HasCompactSupport (canonicalFrequencyBump : Euclidean 2 → Complex) := by
  apply HasCompactSupport.of_support_subset_isCompact
    (isCompact_closedBall (0 : Euclidean 2) 2)
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right]
  by_contra hnot
  have htwo : 2 ≤ ‖x‖ := (lt_of_not_ge hnot).le
  exact (Function.mem_support.mp hx)
    (canonicalFrequencyBump_zero_of_two_le_norm x htwo)

/-- The entire broad tail can use the existing positive-bandlimited
broad-width reduction with the canonical frequency bump.  In particular it
does not require a signed full-band estimate. -/
theorem scratch_exists_broadWidth_envelope_canonicalPositiveCore
    (K : Nat) {rho : Real} (hrho : (1 / 2 : Real) ≤ rho)
    (omega y x : Euclidean 2) (t : Real)
    (homega : ‖omega‖ ≤ 1) (ht : t ∈ lightRayTimeInterval) :
    ∃ A : Real, 0 ≤ A ∧
      HasCompactSupport
        (FourierTransform.fourier canonicalPositiveCore :
          Euclidean 2 → Complex) ∧
      scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y (x, t) ≤
          ((6 : Real) ^ K * A) * lightRayKernel rho K 0 x (y, 0) := by
  obtain ⟨A, hA, hcompact, hpoint⟩ :=
    scratch_exists_broadWidth_envelope_positiveBandlimitedCore
      canonicalFrequencyBump scratch_canonicalFrequencyBump_hasCompactSupport
      K hrho omega y x t homega ht
  refine ⟨A, hA, ?_, ?_⟩
  · rw [scratch_canonicalPositiveCore_eq_normSqBandlimitedCore]
    exact hcompact
  · simpa only [scratch_canonicalPositiveCore_re_eq_positiveBandlimitedCore] using hpoint

/-- On every narrow canonical tube width, the number of required radial
frequency bands has the same logarithmic size as the original width
`delta`.  This combines the compact multiplier support radius `4/rho`, the
canonical scale relation, and the fixed-multiple log transfer. -/
theorem scratch_exists_canonicalNarrowRadialBandCount_log_delta_bound
    {delta r : Real} (hdelta : 0 < delta) (hdeltaOne : delta ≤ 1)
    (hr : 0 < r) (j : Nat)
    (hrhoOne : delta / canonicalBandlimitedDyadicScale r j ≤ 1) :
    ∃ A : Real, 0 < A ∧
      ((KakeyaRadialBandLevel.kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1) ≤
        A * (1 + |Real.log delta|) := by
  let s : Real := canonicalBandlimitedDyadicScale r j
  have hs : 0 < s := canonicalBandlimitedDyadicScale_pos hr j
  have hscale : s ≤ r / 2 := canonicalBandlimitedDyadicScale_le_half_radius hr j
  have htwos : 2 * s ≤ r := by linarith
  have hratio : 2 / r ≤ 1 / s := by
    exact (div_le_div_iff₀ hr hs).2 (by simpa only [one_mul] using htwos)
  have hbelow : (2 / r) * delta ≤ delta / s := by
    calc
      (2 / r) * delta ≤ (1 / s) * delta :=
        mul_le_mul_of_nonneg_right hratio hdelta.le
      _ = delta / s := by ring
  have hrho : 0 < delta / s := div_pos hdelta hs
  obtain ⟨A0, hA0, hA0bound⟩ :=
    KakeyaRadialBandLevel.exists_kakeyaRadialBandLevel_log_bound
  let c : Real := 2 / r
  have hc : 0 < c := by dsimp [c]; positivity
  have hlog : 1 + |Real.log (delta / s)| ≤
      (1 + |Real.log c|) * (1 + |Real.log delta|) := by
    exact KakeyaWidthLogTransfer.one_add_abs_log_width_le_of_mul_le
      hc hdelta hdeltaOne hrho hrhoOne (by simpa only [c] using hbelow)
  refine ⟨A0 * (1 + |Real.log c|),
    mul_pos hA0 (by positivity), ?_⟩
  calc
    (KakeyaRadialBandLevel.kakeyaRadialBandLevel (delta / s) : Real) + 1 ≤
        A0 * (1 + |Real.log (delta / s)|) := hA0bound _ hrho hrhoOne
    _ ≤ A0 * ((1 + |Real.log c|) * (1 + |Real.log delta|)) :=
      mul_le_mul_of_nonneg_left hlog hA0.le
    _ = (A0 * (1 + |Real.log c|)) * (1 + |Real.log delta|) := by ring

/-- The preceding count is also bounded by the final `log^(3/2)` loss.  This
is useful when a finite radial-band estimate is inserted into the endpoint
envelope with the target exponent already fixed. -/
theorem scratch_exists_canonicalNarrowRadialBandCount_log_threeHalves_bound
    {delta r : Real} (hdelta : 0 < delta) (hdeltaOne : delta ≤ 1)
    (hr : 0 < r) (j : Nat)
    (hrhoOne : delta / canonicalBandlimitedDyadicScale r j ≤ 1) :
    ∃ A : Real, 0 < A ∧
      ((KakeyaRadialBandLevel.kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1) ≤
        A * (1 + |Real.log delta|) ^ (3 / 2 : Real) := by
  obtain ⟨A, hA, hbound⟩ :=
    scratch_exists_canonicalNarrowRadialBandCount_log_delta_bound
      hdelta hdeltaOne hr j hrhoOne
  refine ⟨A, hA, ?_⟩
  have hbase : 1 ≤ 1 + |Real.log delta| := by linarith [abs_nonneg (Real.log delta)]
  have hpow : 1 + |Real.log delta| ≤
      (1 + |Real.log delta|) ^ (3 / 2 : Real) := by
    exact Real.self_le_rpow_of_one_le hbase (by norm_num)
  calc
    (KakeyaRadialBandLevel.kakeyaRadialBandLevel
        (delta / canonicalBandlimitedDyadicScale r j) : Real) + 1 ≤
        A * (1 + |Real.log delta|) := hbound
    _ ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real) :=
      mul_le_mul_of_nonneg_left hpow hA.le

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaBandlimitedDyadicBridge

-- BEGIN ScratchKakeyaPositiveReBridge
section

namespace Auto.Spherical.MSS.ScratchKakeyaPositiveReBridge

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaSmoothDomination
open Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
open scoped BigOperators ENNReal EuclideanSpace FourierTransform

noncomputable section

/-- At width `rho`, the positive real tube kernel is exactly the real part
of the inverse Fourier transform of the compact canonical multiplier. -/
theorem scratch_smoothTubeCore_eq_re_canonicalBandlimitedTubePhysicalCore
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) (z : WaveSpaceTime) :
    scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
        rho omega y z =
      (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y)).re := by
  unfold scratch_smoothTubeCore
  symm
  exact scratch_canonicalBandlimitedTubePhysicalCore_re_eq hrho _

/-- The positive canonical tube average of a real-valued input is the real
part of the corresponding compact-frequency signed tube field.  The measure
is left generic so this applies both to the literal slab integral and to any
finite-tensor localization. -/
theorem integral_smoothTubeCore_eq_re_integral_canonicalBandlimitedTube
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) {μ : Measure WaveSpaceTime}
    (G : WaveSpaceTime → Real)
    (hG : Integrable (fun z =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex)) μ) :
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) =
      (∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ).re := by
  calc
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) =
        ∫ z, (scratch_canonicalBandlimitedTubePhysicalCore rho hrho
          (z.1 + z.2 • omega - y) * (G z : Complex)).re ∂μ := by
          apply integral_congr_ae
          filter_upwards with z
          rw [Complex.mul_re]
          simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
          rw [← scratch_smoothTubeCore_eq_re_canonicalBandlimitedTubePhysicalCore
            hrho omega y z]
    _ = (∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
      (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ).re :=
        integral_re hG

/-- Hence the literal positive canonical tube average is bounded by the
norm of its signed compact-frequency tube field.  Crucially this uses only
the real-part identity, not a false assertion that the complex kernel itself
is real-valued. -/
theorem integral_smoothTubeCore_le_norm_integral_canonicalBandlimitedTube
    {rho : Real} (hrho : 0 < rho)
    (omega y : Euclidean 2) {μ : Measure WaveSpaceTime}
    (G : WaveSpaceTime → Real)
    (hG : Integrable (fun z =>
      scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex)) μ) :
    (∫ z, scratch_smoothTubeCore (fun u => (canonicalPositiveCore u).re)
      rho omega y z * G z ∂μ) ≤
      ‖∫ z, scratch_canonicalBandlimitedTubePhysicalCore rho hrho
        (z.1 + z.2 • omega - y) * (G z : Complex) ∂μ‖ := by
  rw [integral_smoothTubeCore_eq_re_integral_canonicalBandlimitedTube
    hrho omega y G hG]
  exact Complex.re_le_norm _

end

end Auto.Spherical.MSS.ScratchKakeyaPositiveReBridge
end
-- END ScratchKakeyaPositiveReBridge

-- BEGIN ScratchKakeyaNonnegativeSquareCore
section

namespace Auto.Spherical.MSS.ScratchKakeyaNonnegativeSquareCore

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
open scoped BigOperators ENNReal EuclideanSpace FourierTransform Pointwise

noncomputable section

abbrev E2 := Euclidean 2

/-- The compact frequency profile of the physical square of `𝓕⁻ ψ`. -/
noncomputable def squareFrequencyMultiplier
    (psi : SchwartzMap E2 Complex) : SchwartzMap E2 Complex :=
  FourierTransform.fourier (testProduct (FourierTransform.fourierInv psi))

theorem squareFrequencyMultiplier_eq_bandlimitedPositiveCoreMultiplier
    (psi : SchwartzMap E2 Complex) :
    squareFrequencyMultiplier psi = bandlimitedPositiveCoreMultiplier psi := by
  rfl

/-- Compact frequency support is stable under taking a physical norm square.
The symmetric compact set `K ∪ (-K)` avoids any unjustified assumption that
the original profile itself has symmetric support. -/
theorem squareFrequencyMultiplier_hasCompactSupport
    (psi : SchwartzMap E2 Complex)
    (hpsi : HasCompactSupport (psi : E2 -> Complex)) :
    HasCompactSupport (squareFrequencyMultiplier psi : E2 -> Complex) := by
  let S : Set E2 := tsupport (psi : E2 -> Complex) ∪ -tsupport (psi : E2 -> Complex)
  have hScompact : IsCompact S := by
    dsimp only [S]
    exact hpsi.isCompact.union hpsi.isCompact.neg
  have hpsiS : Set.Subset (Function.support (psi : E2 -> Complex)) S := by
    intro x hx
    exact Or.inl (subset_tsupport _ hx)
  have hneg : ∀ x : E2, S (-x) -> S x := by
    intro x hx
    rcases hx with hx | hx
    · exact Or.inr (Set.mem_neg.mpr hx)
    · exact Or.inl (by simpa only [neg_neg] using Set.mem_neg.mp hx)
  have hsupp := support_fourier_testProduct_fourierInv_subset_self_add psi S hpsiS hneg
  apply HasCompactSupport.of_support_subset_isCompact (hScompact.add hScompact)
  change Set.Subset
    (Function.support (FourierTransform.fourier
      (testProduct (FourierTransform.fourierInv psi)) : E2 -> Complex)) (S + S)
  exact hsupp

theorem fourierInv_squareFrequencyMultiplier_eq_testProduct
    (psi : SchwartzMap E2 Complex) :
    FourierTransform.fourierInv (squareFrequencyMultiplier psi) =
      testProduct (FourierTransform.fourierInv psi) := by
  unfold squareFrequencyMultiplier
  exact FourierTransform.fourierInv_fourier_eq _

theorem fourierInv_squareFrequencyMultiplier_apply_eq_normSq
    (psi : SchwartzMap E2 Complex) (x : E2) :
    (FourierTransform.fourierInv (squareFrequencyMultiplier psi) :
      SchwartzMap E2 Complex) x =
        (Complex.normSq ((FourierTransform.fourierInv psi :
          SchwartzMap E2 Complex) x) : Complex) := by
  rw [fourierInv_squareFrequencyMultiplier_eq_testProduct]
  exact testProduct_apply_eq_normSq _ _

/-- The sesquilinear physical product used for the off-diagonal terms in a
square of a finite tensor. -/
noncomputable def crossProduct
    (f g : SchwartzMap E2 Complex) : SchwartzMap E2 Complex :=
  SchwartzMap.smulLeftCLM Complex (f : E2 -> Complex) (testConj g)

theorem crossProduct_apply
    (f g : SchwartzMap E2 Complex) (x : E2) :
    crossProduct f g x = f x * star (g x) := by
  unfold crossProduct
  rw [SchwartzMap.smulLeftCLM_apply_apply f.hasTemperateGrowth]
  rfl

theorem fourier_crossProduct_eq_convolution
    (f g : SchwartzMap E2 Complex) :
    FourierTransform.fourier (crossProduct f g) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier f))
        (FourierTransform.fourier (testConj g)) := by
  let C : SchwartzMap E2 Complex :=
    (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (FourierTransform.fourier f)) (FourierTransform.fourier (testConj g))
  have hC : FourierTransform.fourierInv C = crossProduct f g := by
    ext z
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
    change (FourierTransform.fourier C : SchwartzMap E2 Complex) (-z) = _
    rw [show C =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier f)) (FourierTransform.fourier (testConj g)) by rfl]
    rw [SchwartzMap.fourier_convolution, SchwartzMap.pairing_apply_apply]
    rw [crossProduct_apply]
    have hf :
        (FourierTransform.fourier (FourierTransform.fourier f) :
          SchwartzMap E2 Complex) (-z) = f z := by
      have h0 : FourierTransform.fourierInv (FourierTransform.fourier f) = f :=
        FourierTransform.fourierInv_fourier_eq f
      have h1 := congrArg (fun R : SchwartzMap E2 Complex => R z) h0
      change (FourierTransform.fourier (FourierTransform.fourier f) :
        SchwartzMap E2 Complex) (-z) = f z at h1
      exact h1
    have hg :
        (FourierTransform.fourier (FourierTransform.fourier (testConj g)) :
          SchwartzMap E2 Complex) (-z) = testConj g z := by
      have h0 : FourierTransform.fourierInv (FourierTransform.fourier (testConj g)) =
          testConj g := FourierTransform.fourierInv_fourier_eq (testConj g)
      have h1 := congrArg (fun R : SchwartzMap E2 Complex => R z) h0
      change (FourierTransform.fourier (FourierTransform.fourier (testConj g)) :
        SchwartzMap E2 Complex) (-z) = testConj g z at h1
      exact h1
    rw [hf, hg, testConj_apply]
    rfl
  calc
    FourierTransform.fourier (crossProduct f g) =
        FourierTransform.fourier (FourierTransform.fourierInv C) := by rw [hC]
    _ = C := FourierTransform.fourier_fourierInv_eq C
    _ = _ := rfl

/-- The compact frequency profile of the physical product
`(𝓕⁻ q) * conj (𝓕⁻ r)`. -/
noncomputable def crossFrequencyMultiplier
    (q r : SchwartzMap E2 Complex) : SchwartzMap E2 Complex :=
  FourierTransform.fourier
    (crossProduct (FourierTransform.fourierInv q) (FourierTransform.fourierInv r))

theorem crossFrequencyMultiplier_eq_convolution
    (q r : SchwartzMap E2 Complex) :
    crossFrequencyMultiplier q r =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) q)
        (testNeg (testConj r)) := by
  unfold crossFrequencyMultiplier
  rw [fourier_crossProduct_eq_convolution,
    FourierTransform.fourier_fourierInv_eq,
    fourier_testConj_fourierInv]

theorem hasCompactSupport_testNeg_testConj
    (q : SchwartzMap E2 Complex)
    (hq : HasCompactSupport (q : E2 -> Complex)) :
    HasCompactSupport (testNeg (testConj q) : E2 -> Complex) := by
  apply HasCompactSupport.of_support_subset_isCompact hq.isCompact.neg
  intro x hx
  apply Set.mem_neg.mpr
  apply subset_tsupport _
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp hx
  rw [testNeg_apply, testConj_apply, hzero]
  exact map_zero (starRingEnd Complex)

theorem crossFrequencyMultiplier_hasCompactSupport
    (q r : SchwartzMap E2 Complex)
    (hq : HasCompactSupport (q : E2 -> Complex))
    (hr : HasCompactSupport (r : E2 -> Complex)) :
    HasCompactSupport (crossFrequencyMultiplier q r : E2 -> Complex) := by
  rw [crossFrequencyMultiplier_eq_convolution]
  apply HasCompactSupport.of_support_subset_isCompact
    (hq.isCompact.add hr.isCompact.neg)
  intro z hz
  have hraw : Set.Mem (Function.support (MeasureTheory.convolution
      (q : E2 -> Complex) (testNeg (testConj r) : E2 -> Complex)
      (ContinuousLinearMap.mul Complex Complex) volume)) z := by
    apply Function.mem_support.mpr
    have hz0 := Function.mem_support.mp hz
    simpa only [SchwartzMap.convolution_apply] using hz0
  have hqsub : Set.Subset (Function.support (q : E2 -> Complex))
      (tsupport (q : E2 -> Complex)) := subset_tsupport _
  have hrsub : Set.Subset (Function.support (testNeg (testConj r) : E2 -> Complex))
      (-tsupport (r : E2 -> Complex)) := by
    intro x hx
    apply Set.mem_neg.mpr
    apply subset_tsupport _
    apply Function.mem_support.mpr
    intro hzero
    apply Function.mem_support.mp hx
    rw [testNeg_apply, testConj_apply, hzero]
    exact map_zero (starRingEnd Complex)
  exact (Set.add_subset_add hqsub hrsub)
    (MeasureTheory.support_convolution_subset
      (ContinuousLinearMap.mul Complex Complex) hraw)

theorem fourierInv_crossFrequencyMultiplier_eq_crossProduct
    (q r : SchwartzMap E2 Complex) :
    FourierTransform.fourierInv (crossFrequencyMultiplier q r) =
      crossProduct (FourierTransform.fourierInv q) (FourierTransform.fourierInv r) := by
  unfold crossFrequencyMultiplier
  exact FourierTransform.fourierInv_fourier_eq _

/-- The time-side analogue of `crossProduct`; it retains Schwartz regularity
and the common compact-time support of the original factors. -/
noncomputable def timeCrossProduct
    (a b : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (a : Real -> Complex)
    (b.postcompCLM Complex.conjCLE.toContinuousLinearMap)

theorem timeCrossProduct_apply
    (a b : SchwartzMap Real Complex) (t : Real) :
    timeCrossProduct a b t = a t * star (b t) := by
  unfold timeCrossProduct
  rw [SchwartzMap.smulLeftCLM_apply_apply a.hasTemperateGrowth]
  rfl

theorem support_timeCrossProduct_subset_left
    (a b : SchwartzMap Real Complex) :
    Function.support (timeCrossProduct a b : Real -> Complex) ⊆
      Function.support (a : Real -> Complex) := by
  intro t ht
  apply Function.mem_support.mpr
  intro hzero
  apply Function.mem_support.mp ht
  rw [timeCrossProduct_apply, hzero, zero_mul]

/-- The literal nonnegative core generated by a finite compact-frequency
tensor. -/
noncomputable def nonnegativeSquareInnerSlabTensor
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) : WaveSpaceTime -> Complex :=
  fun z => (Complex.normSq (scratch_innerSlabCompactFrequencyTensor q a z) : Complex)

/-- Reassemble a square as a finite tensor indexed by pairs.  Its spatial
profiles are the compact-frequency cross multipliers. -/
noncomputable def reassembledSquareInnerSlabTensor
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) : WaveSpaceTime -> Complex :=
  scratch_innerSlabCompactFrequencyTensor
    (fun ij : ι × ι => crossFrequencyMultiplier (q ij.1) (q ij.2))
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2))

theorem nonnegativeSquareInnerSlabTensor_eq_reassembled
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) :
    nonnegativeSquareInnerSlabTensor q a =
      reassembledSquareInnerSlabTensor q a := by
  classical
  funext z
  unfold nonnegativeSquareInnerSlabTensor reassembledSquareInnerSlabTensor
    scratch_innerSlabCompactFrequencyTensor
  simp_rw [fourierInv_crossFrequencyMultiplier_eq_crossProduct,
    crossProduct_apply, timeCrossProduct_apply]
  rw [← Complex.mul_conj]
  rw [map_sum]
  rw [Finset.sum_mul_sum]
  simp_rw [map_mul]
  rw [← Finset.sum_product']
  rw [Finset.univ_product_univ]
  apply Finset.sum_congr rfl
  intro ij hij
  simp only [starRingEnd_apply]
  ring

/-- Squares retain the exact compact-frequency, common-inner-slab tensor
shape required by the finite signed-envelope theorem. -/
theorem reassembledSquareInnerSlabTensor_mem_innerSlabCompactFrequencyTensorCore
    {ι : Type} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex)
    (r : Real)
    (hq : ∀ i, HasCompactSupport (q i : E2 -> Complex))
    (hrpos : 0 < r) (hrlt : r < 1)
    (ha : ∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) :
    scratch_InnerSlabCompactFrequencyTensorCore
      (reassembledSquareInnerSlabTensor q a) := by
  refine ⟨ι × ι, inferInstance,
    (fun ij : ι × ι => crossFrequencyMultiplier (q ij.1) (q ij.2)),
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2)),
    r, ?_, hrpos, hrlt, ?_, rfl⟩
  · intro ij
    exact crossFrequencyMultiplier_hasCompactSupport (q ij.1) (q ij.2)
      (hq ij.1) (hq ij.2)
  · intro ij
    exact (support_timeCrossProduct_subset_left (a ij.1) (a ij.2)).trans (ha ij.1)

/-- The nonnegative square of any finite compact-frequency inner-slab tensor
is itself an admissible finite compact-frequency inner-slab tensor. -/
theorem nonnegativeSquareInnerSlabTensor_mem_innerSlabCompactFrequencyTensorCore
    {ι : Type} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex)
    (r : Real)
    (hq : ∀ i, HasCompactSupport (q i : E2 -> Complex))
    (hrpos : 0 < r) (hrlt : r < 1)
    (ha : ∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) :
    scratch_InnerSlabCompactFrequencyTensorCore
      (nonnegativeSquareInnerSlabTensor q a) := by
  rw [nonnegativeSquareInnerSlabTensor_eq_reassembled]
  exact reassembledSquareInnerSlabTensor_mem_innerSlabCompactFrequencyTensorCore
    q a r hq hrpos hrlt ha

theorem nonnegativeSquareInnerSlabTensor_re_nonneg
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) (z : WaveSpaceTime) :
    0 ≤ (nonnegativeSquareInnerSlabTensor q a z).re := by
  unfold nonnegativeSquareInnerSlabTensor
  exact Complex.normSq_nonneg _

theorem nonnegativeSquareInnerSlabTensor_eq_ofReal_normSq
    {ι : Type*} [Fintype ι]
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) :
    nonnegativeSquareInnerSlabTensor q a =
      fun z => (Complex.normSq (scratch_innerSlabCompactFrequencyTensor q a z) : Complex) := by
  rfl

/-- The square root of the norm of an `L²` complex datum belongs to `L⁴`.
This is the exact exponent change needed before squaring an approximation. -/
theorem memLp_four_sqrt_norm
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (F : X -> Complex) (hF : MemLp F 2 μ) :
    MemLp (fun x => Real.sqrt ‖F x‖) 4 μ := by
  have h := hF.norm_rpow_div ((2 : ENNReal)⁻¹)
  convert h using 1
  · ext x
    norm_num [Real.sqrt_eq_rpow]
  · rw [div_eq_mul_inv, inv_inv]
    norm_num

end

