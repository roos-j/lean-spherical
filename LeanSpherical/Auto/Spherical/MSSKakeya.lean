section

namespace Auto.Spherical.MSS.KakeyaShiftedCappedEnvelopeReassembly

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaAngularChartReassembly
open Auto.Spherical.MSS.KakeyaAngularChartReassembly.SmoothAngularFrequencyChartFamily
open Auto.Spherical.MSS.KakeyaCappedAngularMaxReassembly
open Auto.Spherical.MSS.KakeyaCenteredFundamentalMax
open Auto.Spherical.MSS.KakeyaEnvelopeReassembly
open Auto.Spherical.MSS.KakeyaShiftedChartReassembly
open scoped BigOperators Convolution FourierTransform EuclideanSpace

noncomputable section

/-- The literal finite chart/shift/shell index family for an arbitrary finite
smooth angular chart atlas. -/
noncomputable def shiftedCappedShellIndicesGeneric
    {kappa : Type*} (charts : Finset kappa) (K : Nat) :
    Finset (kappa × (Nat × Nat)) :=
  charts.product ((Finset.range 7).product (Finset.range (K + 2)))

/-- One literal inverse-Fourier summand of the generic shifted capped atlas. -/
noncomputable def shiftedCappedShellPieceGeneric
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (eps : Real) (K : Nat)
    (jni : kappa × (Nat × Nat)) (theta : Real) (y : Euclidean 2) : Complex :=
  shiftedChartedCappedTelescopingField C jni.1 s q hqcompact a eps K
    jni.2.1 jni.2.2 theta y

/-- The inclusion of the centred physical fundamental interval into a larger
compact endpoint-zero interval. -/
noncomputable def centeredFundamentalEmbed (lo : Real) (hlo : lo <= -Real.pi) :
    Ico (-Real.pi) Real.pi -> Icc lo Real.pi := fun theta =>
  ⟨theta.1, ⟨hlo.trans theta.2.1, theta.2.2.le⟩⟩

/-- Physical finite reassembly against containing endpoint-GN envelopes.
Unlike the older same-domain reassembly lemma, this permits local estimates
on `Icc lo π` while the exact stationary partition is used only on the
centred fundamental interval `Ico (-π) π`. -/
theorem lintegral_iSup_sq_finiteTensorCircleMultiplierField_le_shiftedCapped_envelopes
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : ∀ l, C.SupportedOnActive (q l))
    (a : iota -> SchwartzMap Real Complex)
    (eps : Real) (K : Nat) {lo : Real} (hlo : lo <= -Real.pi)
    (hintegrable : ∀ theta j n i,
      Integrable (fun xi => shiftedChartedCappedTelescopingMultiplier C j
        s q hqcompact a eps K n i theta xi))
    (hangleUpper : ∀ j xi, C.angle j xi < 6)
    (B : kappa × (Nat × Nat) -> ENNReal)
    (hpieceMeas : ∀ jni ∈ shiftedCappedShellIndicesGeneric charts K,
      Measurable (fun y : Euclidean 2 =>
        ⨆ theta : Icc lo Real.pi, ENNReal.ofReal
          (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)))
    (hpieceBound : ∀ jni ∈ shiftedCappedShellIndicesGeneric charts K,
      (∫⁻ y : Euclidean 2,
        ⨆ theta : Icc lo Real.pi, ENNReal.ofReal
          (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) <=
        B jni) :
    (∫⁻ y : Euclidean 2, ⨆ theta : Real,
      ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) <=
      ((shiftedCappedShellIndicesGeneric charts K).card : ENNReal) *
        ∑ jni ∈ shiftedCappedShellIndicesGeneric charts K, B jni := by
  let shells := shiftedCappedShellIndicesGeneric charts K
  let piece := shiftedCappedShellPieceGeneric C s q hqcompact a eps K
  let embed := centeredFundamentalEmbed lo hlo
  let pieceBig : (kappa × (Nat × Nat)) -> Icc lo Real.pi -> Euclidean 2 -> Complex :=
    fun jni theta y => piece jni theta.1 y
  let Q : (kappa × (Nat × Nat)) -> Euclidean 2 -> ENNReal := fun jni y =>
    ⨆ theta : Icc lo Real.pi, ENNReal.ofReal (‖pieceBig jni theta y‖ ^ 2)
  have hdecompRaw : ∀ theta : Ico (-Real.pi) Real.pi, ∀ y : Euclidean 2,
      finiteTensorCircleMultiplierField s q hqcompact a theta.1 y =
        ∑ jni ∈ shells, piece jni theta.1 y := by
    intro theta y
    have hfield := sum_shiftedChartedCappedTelescopingField_eq C s q hqcompact
      hqactive a eps K theta.1 y
      (fun j n i => hintegrable theta.1 j n i)
      (centeredFundamental_mem_closed theta.2) hangleUpper
    change finiteTensorCircleMultiplierField s q hqcompact a theta.1 y = _
    calc
      finiteTensorCircleMultiplierField s q hqcompact a theta.1 y =
          ∑ j ∈ charts, ∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
            shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y :=
        hfield.symm
      _ = ∑ jni ∈ shells, piece jni theta.1 y := by
        simp only [shells, shiftedCappedShellIndicesGeneric, piece,
          shiftedCappedShellPieceGeneric]
        calc
          ∑ j ∈ charts, ∑ n ∈ Finset.range 7, ∑ i ∈ Finset.range (K + 2),
              shiftedChartedCappedTelescopingField C j s q hqcompact a eps K n i theta.1 y =
              ∑ j ∈ charts, ∑ ni ∈ (Finset.range 7).product (Finset.range (K + 2)),
                shiftedChartedCappedTelescopingField C j s q hqcompact a eps K ni.1 ni.2 theta.1 y := by
            apply Finset.sum_congr rfl
            intro j hj
            exact (Finset.sum_product (Finset.range 7)
              (Finset.range (K + 2))
              (fun ni : Nat × Nat =>
                shiftedChartedCappedTelescopingField C j s q hqcompact a eps K
                  ni.1 ni.2 theta.1 y)).symm
          _ = ∑ jni ∈ charts.product
              ((Finset.range 7).product (Finset.range (K + 2))),
              shiftedChartedCappedTelescopingField C jni.1 s q hqcompact a eps K
                jni.2.1 jni.2.2 theta.1 y := by
