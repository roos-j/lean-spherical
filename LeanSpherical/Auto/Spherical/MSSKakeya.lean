-- BEGIN ScratchInnerSlabTensorL4Density
section

namespace ScratchInnerSlabTensorL4Density

open Filter MeasureTheory Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS
open scoped ENNReal EuclideanSpace ContDiff FourierTransform

open ScratchInnerSlabTensorDensityIntegration

noncomputable section

/-- Uniform approximation on a finite-measure support converts to an `L⁴`
bound.  This is the sole exponent-specific replacement needed in the
Stone--Weierstrass inner-slab tensor argument. -/
theorem eLpNorm_four_sub_le_of_support_subset_and_uniform_complex
    {X : Type*} [MeasurableSpace X] (μ : Measure X)
    (S : Set X) (hSmeas : MeasurableSet S) (hSfinite : μ S ≠ (⊤ : ENNReal))
    (f g : X -> Complex)
    (hfsupp : Function.support f ⊆ S)
    (hgsupp : Function.support g ⊆ S)
    {epsilon : Real} (huniform : ∀ x, dist (g x) (f x) ≤ epsilon) :
    eLpNorm (g - f) 4 μ ≤
      (μ S) ^ ((4 : ENNReal).toReal)⁻¹ * ENNReal.ofReal epsilon := by
  have hsubsupp : Function.support (g - f) ⊆ S := by
    intro x hx
    by_contra hxS
    have hfzero : f x = 0 := by
      by_contra hzero
      apply hxS
      apply hfsupp
      rwa [Function.mem_support]
    have hgzero : g x = 0 := by
      by_contra hzero
      apply hxS
      apply hgsupp
      rwa [Function.mem_support]
    exact hx (by simp [hfzero, hgzero])
  letI : IsFiniteMeasure (μ.restrict S) := isFiniteMeasure_restrict.2 hSfinite
  rw [← eLpNorm_restrict_eq_of_support_subset hsubsupp]
  have hbound : ∀ᵐ x ∂μ.restrict S, ‖(g - f) x‖ ≤ epsilon := by
    filter_upwards [ae_restrict_mem hSmeas] with x hx
    simpa only [Pi.sub_apply, dist_eq_norm] using huniform x
  simpa only [Measure.restrict_apply_univ, Set.univ_inter] using
    (eLpNorm_le_of_ae_bound (μ := μ.restrict S) (p := (4 : ENNReal)) hbound)

/-- Allocate a positive uniform error whose finite-measure `L⁴` cost is
below a prescribed tolerance. -/
theorem exists_uniform_l4_budget
    (S : Set WaveSpaceTime) (hSfinite : volume S ≠ (⊤ : ENNReal))
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ alpha : Real, 0 < alpha ∧
      (volume S) ^ ((4 : ENNReal).toReal)⁻¹ * ENNReal.ofReal alpha <
        ENNReal.ofReal epsilon := by
  let D : ENNReal := (volume S) ^ ((4 : ENNReal).toReal)⁻¹
  have hDfinite : D ≠ (⊤ : ENNReal) := by
    apply ENNReal.rpow_ne_top_of_nonneg
    · positivity
    · exact hSfinite
  let d : Real := D.toReal
  let alpha : Real := epsilon / (d + 1)
  have hdnonneg : 0 ≤ d := ENNReal.toReal_nonneg
  have halpha : 0 < alpha := by
    dsimp [alpha]
    positivity
  refine ⟨alpha, halpha, ?_⟩
  have hfrac : d / (d + 1) < 1 := by
    rw [div_lt_one (by positivity)]
    linarith
  calc
    (volume S) ^ ((4 : ENNReal).toReal)⁻¹ * ENNReal.ofReal alpha =
        D * ENNReal.ofReal alpha := by rfl
    _ = ENNReal.ofReal d * ENNReal.ofReal alpha := by
      rw [ENNReal.ofReal_toReal hDfinite]
    _ = ENNReal.ofReal (d * alpha) := by
      rw [ENNReal.ofReal_mul hdnonneg]
    _ < ENNReal.ofReal epsilon := by
      rw [ENNReal.ofReal_lt_ofReal_iff hepsilon]
      dsimp [alpha]
      calc
        d * (epsilon / (d + 1)) = epsilon * (d / (d + 1)) := by
          field_simp
        _ < epsilon * 1 :=
          mul_lt_mul_of_pos_left hfrac hepsilon
        _ = epsilon := by ring

/-- A compactly supported joint smooth function in a strict time slab has a
finite smooth separated tensor approximation in `L⁴`, preserving a common
strict temporal margin. -/
theorem exists_finite_smooth_separated_innerSlab_eLpNorm_four_sub_lt
    {rE RE r RF : Real}
    (hrE : 0 < rE) (hrERE : rE < RE)
    (hr : 0 < r) (hrRF : r < RF) (hRF : RF < 1)
    (u : WaveSpaceTime -> Complex) (hucont : Continuous u)
    (husupport : Function.support u ⊆
      Metric.closedBall (0 : Euclidean 2) rE ×ˢ
        Metric.closedBall (3 / 2 : Real) r)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι)
      (U : ι -> Euclidean 2 -> Complex) (a : ι -> Real -> Complex),
      (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
      (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
        Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) RF) ∧
      MemLp (ScratchSlabTensor.smoothSpatialTensor U a) 4 volume ∧
      eLpNorm (u - ScratchSlabTensor.smoothSpatialTensor U a) 4 volume <
        ENNReal.ofReal epsilon := by
  let S : Set WaveSpaceTime :=
    Metric.closedBall (0 : Euclidean 2) RE ×ˢ
      Metric.closedBall (3 / 2 : Real) RF
  have hScompact : IsCompact S := by
    dsimp only [S]
    apply IsCompact.prod
    · exact isCompact_closedBall _ _
    · exact isCompact_closedBall _ _
  have hSmeas : MeasurableSet S := by
    dsimp only [S]
    exact (Metric.isClosed_closedBall.measurableSet.prod
      Metric.isClosed_closedBall.measurableSet)
  have hSfinite : volume S ≠ (⊤ : ENNReal) := hScompact.measure_ne_top
  obtain ⟨alpha, halphapos, halpha⟩ :=
    exists_uniform_l4_budget S hSfinite hepsilon
  obtain ⟨ι, hι, U, a, hU, ha, huniform⟩ :=
    ScratchTensor.exists_finite_smooth_compact_separated_uniform_close_complex
      (Euclidean 2) Real (0 : Euclidean 2) (3 / 2 : Real)
      hrE hrERE hr hrRF u hucont husupport halphapos
  letI : Fintype ι := hι
  have hUSupport : ∀ i, Function.support (U i) ⊆
      Metric.closedBall (0 : Euclidean 2) RE := fun i => (hU i).2.2
  have haSupport : ∀ i, Function.support (a i) ⊆
      Metric.closedBall (3 / 2 : Real) RF := fun i => (ha i).2.2
  have hvSupport : Function.support (ScratchSlabTensor.smoothSpatialTensor U a) ⊆ S := by
    simpa only [S] using support_smoothSpatialTensor_subset_prod U a
      (Metric.closedBall (0 : Euclidean 2) RE)
      (Metric.closedBall (3 / 2 : Real) RF) hUSupport haSupport
  have huSupportS : Function.support u ⊆ S := by
    intro z hz
    have hz' := husupport hz
    exact ⟨Metric.closedBall_subset_closedBall hrERE.le hz'.1,
      Metric.closedBall_subset_closedBall hrRF.le hz'.2⟩
  have huniform' : ∀ z : WaveSpaceTime,
      dist (ScratchSlabTensor.smoothSpatialTensor U a z) (u z) ≤ alpha := by
    intro z
    exact (huniform z).le
  have hL4le := eLpNorm_four_sub_le_of_support_subset_and_uniform_complex
    volume S hSmeas hSfinite u (ScratchSlabTensor.smoothSpatialTensor U a)
    huSupportS hvSupport huniform'
  have hcont : Continuous (ScratchSlabTensor.smoothSpatialTensor U a) :=
    continuous_smoothSpatialTensor U a
      (fun i => (hU i).1.continuous) (fun i => (ha i).1.continuous)
  have hvcompact : HasCompactSupport (ScratchSlabTensor.smoothSpatialTensor U a) :=
    HasCompactSupport.of_support_subset_isCompact hScompact hvSupport
  refine ⟨ι, inferInstance, U, a, ?_, ?_,
    hcont.memLp_of_hasCompactSupport hvcompact, ?_⟩
  · intro i
    exact ⟨(hU i).2.1, (hU i).1⟩
  · intro i
    exact ⟨(ha i).2.1, (ha i).1, (ha i).2.2⟩
  · simpa only [eLpNorm_sub_comm] using hL4le.trans_lt halpha

/-- The `L⁴` version of the inner-slab separated-tensor density statement.
It is intentionally parameterized by a slab-supported function, so it can
be applied to the square root of a positive `L²` datum. -/
theorem exists_smoothSeparated_innerSlabTensor_near_slabSupported_four
    (v : WaveSpaceTime -> Complex) (hv : MemLp v 4 volume)
    (hzero : ∀ z : WaveSpaceTime, z ∈ ScratchInnerSlab.outsideTimeSlab → v z = 0)
    {epsilon : Real} (hepsilon : 0 < epsilon) :
    ∃ (ι : Type) (_ : Fintype ι)
      (U : ι → Euclidean 2 → Complex) (a : ι → Real → Complex) (r : Real),
      0 < r ∧ r < 1 ∧
      (∀ i, HasCompactSupport (U i) ∧ ContDiff Real ∞ (U i)) ∧
      (∀ i, HasCompactSupport (a i) ∧ ContDiff Real ∞ (a i) ∧
        Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) r) ∧
      MemLp (ScratchSlabTensor.smoothSpatialTensor U a) 4 volume ∧
      eLpNorm (v - ScratchSlabTensor.smoothSpatialTensor U a) 4 volume <
        ENNReal.ofReal epsilon := by
  have hepshalf : 0 < epsilon / 2 := by positivity
  obtain ⟨r0, hr0pos, hr0lt, u, hucompact, hucont, husupport, huerr⟩ :=
    ScratchInnerSlab.exists_innerSlab_smoothCompact_eLpNorm_four_sub_lt_with_radius
      v hv hzero hepshalf
  change Function.support u ⊆
    {z : WaveSpaceTime | z.2 ∈ Metric.closedBall (3 / 2 : Real) r0} at husupport
  obtain ⟨B, hB⟩ :=
    (Metric.isBounded_iff_subset_closedBall (0 : WaveSpaceTime)).mp
      hucompact.isCompact.isBounded
  let rE : Real := |B| + 1
  let RE : Real := rE + 1
  have hrEpos : 0 < rE := by
    dsimp only [rE]
    positivity
  have hrERE : rE < RE := by
    dsimp only [RE]
    linarith
  have huSpatial : ∀ z : WaveSpaceTime, z ∈ Function.support u →
      z.1 ∈ Metric.closedBall (0 : Euclidean 2) rE := by
    intro z hz
    have hztsupport : z ∈ tsupport u := subset_closure hz
    have hzB := hB hztsupport
    change dist z (0 : WaveSpaceTime) ≤ B at hzB
    rw [Prod.dist_eq] at hzB
    change dist z.1 (0 : Euclidean 2) ≤ rE
    calc
      dist z.1 (0 : Euclidean 2) ≤
          max (dist z.1 (0 : Euclidean 2)) (dist z.2 (0 : Real)) := le_max_left _ _
      _ ≤ B := hzB
      _ ≤ |B| + 1 := by linarith [le_abs_self B]
      _ = rE := by rfl
  have huProdSupport : Function.support u ⊆
      Metric.closedBall (0 : Euclidean 2) rE ×ˢ
        Metric.closedBall (3 / 2 : Real) r0 := by
    intro z hz
    exact ⟨huSpatial z hz, husupport hz⟩
  let r : Real := (r0 + 1) / 2
  have hr0r : r0 < r := by
    dsimp only [r]
    linarith
  have hrlt : r < 1 := by
    dsimp only [r]
    linarith
  obtain ⟨ι, hι, U, a, hU, ha, hvmem, hverr⟩ :=
    exists_finite_smooth_separated_innerSlab_eLpNorm_four_sub_lt
      hrEpos hrERE hr0pos hr0r hrlt u hucont.continuous huProdSupport hepshalf
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, U, a, r, ?_, hrlt, hU, ha, hvmem, ?_⟩
  · dsimp only [r]
    positivity
  · have huMem : MemLp u 4 volume :=
      hucont.continuous.memLp_of_hasCompactSupport hucompact
    have hfirstMem : MemLp (v - u) 4 volume := hv.sub huMem
    have hsecondMem : MemLp (u - ScratchSlabTensor.smoothSpatialTensor U a) 4 volume :=
      huMem.sub hvmem
    calc
      eLpNorm (v - ScratchSlabTensor.smoothSpatialTensor U a) 4 volume =
          eLpNorm ((v - u) +
            (u - ScratchSlabTensor.smoothSpatialTensor U a)) 4 volume := by
              congr 1
              funext z
              simp only [Pi.sub_apply, Pi.add_apply]
              abel
      _ ≤ eLpNorm (v - u) 4 volume +
          eLpNorm (u - ScratchSlabTensor.smoothSpatialTensor U a) 4 volume :=
        eLpNorm_add_le hfirstMem.aestronglyMeasurable hsecondMem.aestronglyMeasurable
          (by norm_num)
      _ < ENNReal.ofReal (epsilon / 2) + ENNReal.ofReal (epsilon / 2) :=
        ENNReal.add_lt_add huerr hverr
      _ = ENNReal.ofReal epsilon := by
        rw [← ENNReal.ofReal_add hepshalf.le hepshalf.le]
        ring

end

end ScratchInnerSlabTensorL4Density
end
-- END ScratchInnerSlabTensorL4Density

-- BEGIN ScratchKakeyaSchwartzSquareCoreDensity
section

namespace Auto.Spherical.MSS.ScratchKakeyaSchwartzSquareCoreDensity

open Filter MeasureTheory Set FourierTransform
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.ScratchKakeyaNonnegativeSquareCore
open Auto.Spherical.MSS.ScratchKakeyaPositiveSquareClosure
open Auto.Spherical.MSS.ScratchKakeyaPositiveSquareDensity
open ScratchInnerSlabTensorL4Density
open scoped BigOperators ENNReal EuclideanSpace FourierTransform ContDiff

noncomputable section

abbrev E2 := Euclidean 2

/-- A finite inner-slab tensor with merely Schwartz spatial frequency
profiles.  This is the density-safe core: the canonical tube multiplier,
not the datum, supplies compact frequency support to every later FIO slice. -/
def InnerSlabSchwartzTensorCore
    (f : WaveSpaceTime -> Complex) : Prop :=
  ∃ (ι : Type) (_ : Fintype ι)
    (q : ι -> SchwartzMap E2 Complex)
    (a : ι -> SchwartzMap Real Complex) (r : Real),
    0 < r ∧ r < 1 ∧
    (∀ i, Function.support (a i : Real -> Complex) ⊆
      Metric.closedBall (3 / 2 : Real) r) ∧
    f = scratch_innerSlabCompactFrequencyTensor q a

/-- Passing to the physical norm square turns the signed Schwartz tensor
core into the positive square core used by the canonical-kernel majorization. -/
theorem pointwiseNormSquare_mem_nonnegativeSquareInnerSlabSchwartzTensorCore
    {u : WaveSpaceTime -> Complex}
    (hu : InnerSlabSchwartzTensorCore u) :
    NonnegativeSquareInnerSlabSchwartzTensorCore (pointwiseNormSquare u) := by
  rcases hu with ⟨ι, hι, q, a, r, hrpos, hrlt, ha, hu⟩
  letI : Fintype ι := hι
  refine ⟨ι, inferInstance, q, a, r, hrpos, hrlt, ha, ?_⟩
  funext z
  rw [Auto.Spherical.MSS.ScratchKakeyaPositiveSquareDensity.pointwiseNormSquare_apply,
    hu]
  rfl

/-- The pointwise norm square maps `L⁴` inputs to `L²` inputs. -/
theorem memLp_two_pointwiseNormSquare
    {X : Type*} [MeasurableSpace X] {μ : Measure X}
    (u : X → Complex) (hu : MemLp u 4 μ) :
    MemLp (pointwiseNormSquare u) 2 μ := by
  refine ⟨?_, ?_⟩
  · unfold pointwiseNormSquare
    exact hu.aestronglyMeasurable.mul hu.star.aestronglyMeasurable
  · unfold pointwiseNormSquare
    calc
      eLpNorm (u * star u) 2 μ ≤ eLpNorm u 4 μ * eLpNorm (star u) 4 μ :=
        eLpNorm_mul_le_four_four_two u (star u)
          hu.aestronglyMeasurable hu.star.aestronglyMeasurable
      _ = eLpNorm u 4 μ * eLpNorm u 4 μ := by rw [eLpNorm_star]
      _ < ⊤ := ENNReal.mul_lt_top
        (lt_top_iff_ne_top.mpr hu.eLpNorm_ne_top)
        (lt_top_iff_ne_top.mpr hu.eLpNorm_ne_top)

/-- A positive square core is also an admissible signed Schwartz tensor after
retaining every off-diagonal physical product.  Unlike the old version, no
compactness assumption on the original spatial profiles occurs here. -/
theorem nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore
    {f : WaveSpaceTime → Complex}
    (hf : NonnegativeSquareInnerSlabSchwartzTensorCore f) :
    InnerSlabSchwartzTensorCore f := by
  rcases hf with ⟨ι, hι, q, a, r, hrpos, hrlt, ha, rfl⟩
  letI : Fintype ι := hι
  refine ⟨ι × ι, inferInstance,
    (fun ij : ι × ι => crossFrequencyMultiplier (q ij.1) (q ij.2)),
    (fun ij : ι × ι => timeCrossProduct (a ij.1) (a ij.2)),
    r, hrpos, hrlt, ?_, ?_⟩
  · intro ij
    exact (support_timeCrossProduct_subset_left (a ij.1) (a ij.2)).trans (ha ij.1)
  · rw [nonnegativeSquareInnerSlabTensor_eq_reassembled]
    rfl

/-- A finite smooth physical tensor is literally a Schwartz-frequency tensor
after Fourier transforming each spatial factor and packaging its time factor
as a Schwartz map. -/
theorem smoothSpatialTensor_eq_innerSlabSchwartzTensor
    {ι : Type} [Fintype ι]
    (U : ι -> E2 -> Complex) (a : ι -> Real -> Complex)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (hacompact : ∀ i, HasCompactSupport (a i))
    (hasmooth : ∀ i, ContDiff Real ∞ (a i)) :
    ScratchSlabTensor.smoothSpatialTensor U a =
      scratch_innerSlabCompactFrequencyTensor
        (fun i => FourierTransform.fourier
          ((hUcompact i).toSchwartzMap (hUsmooth i)))
        (fun i => (hacompact i).toSchwartzMap (hasmooth i)) := by
  funext z
  simp only [ScratchSlabTensor.smoothSpatialTensor,
    scratch_innerSlabCompactFrequencyTensor]
  apply Finset.sum_congr rfl
  intro i hi
  rw [FourierTransform.fourierInv_fourier_eq]
  rfl

/-- The preceding equality also gives the exact strict-inner-slab core
membership. -/
theorem smoothSpatialTensor_mem_innerSlabSchwartzTensorCore
    {ι : Type} [Fintype ι]
    (U : ι -> E2 -> Complex) (a : ι -> Real -> Complex) (r : Real)
    (hUcompact : ∀ i, HasCompactSupport (U i))
    (hUsmooth : ∀ i, ContDiff Real ∞ (U i))
    (hacompact : ∀ i, HasCompactSupport (a i))
    (hasmooth : ∀ i, ContDiff Real ∞ (a i))
    (hrpos : 0 < r) (hrlt : r < 1)
    (hasupport : ∀ i, Function.support (a i) ⊆
      Metric.closedBall (3 / 2 : Real) r) :
    InnerSlabSchwartzTensorCore (ScratchSlabTensor.smoothSpatialTensor U a) := by
  refine ⟨ι, inferInstance,
    (fun i => FourierTransform.fourier
      ((hUcompact i).toSchwartzMap (hUsmooth i))),
    (fun i => (hacompact i).toSchwartzMap (hasmooth i)), r,
    hrpos, hrlt, ?_, ?_⟩
  · intro i
    change Function.support (a i) ⊆ Metric.closedBall (3 / 2 : Real) r
    exact hasupport i
  · exact smoothSpatialTensor_eq_innerSlabSchwartzTensor U a
      hUcompact hUsmooth hacompact hasmooth

/-- Nonnegative inner-slab data are `L²`-dense in squares of finite
Schwartz-frequency tensors.  The spatial factors here need not be compactly
frequency-supported: a later canonical multiplier makes every actual tube
profile compact. -/
theorem hasPositiveSlabL2DenseCore_nonnegativeSquareInnerSlabSchwartzTensor :
    HasPositiveSlabL2DenseCore NonnegativeSquareInnerSlabSchwartzTensorCore := by
  intro h hh epsilon hepsilon
  let v : WaveSpaceTime → Complex := positiveSlabSquareRoot h
  have hv : MemLp v 4 volume := by
    dsimp only [v]
    exact positiveSlabSquareRoot_memLp_four h hh
  have hvzero : ∀ z : WaveSpaceTime,
      z ∈ ScratchInnerSlab.outsideTimeSlab → v z = 0 := by
    intro z hz
    dsimp only [v, positiveSlabSquareRoot, positiveSlabDatum]
    simp only [ScratchInnerSlab.outsideTimeSlab, Set.mem_setOf_eq] at hz
    simp [scratch_lightRayTimeRestriction, hz]
  let D : ENNReal := 1 + 2 * eLpNorm v 4 volume
  have hDtop : D ≠ ⊤ := by
    dsimp only [D]
    rw [ENNReal.add_ne_top]
    constructor
    · norm_num
    · exact ENNReal.mul_ne_top (by norm_num) hv.eLpNorm_ne_top
  obtain ⟨b, hbpos, hbudget⟩ :=
    ScratchSlabTensor.exists_positive_real_budgets
      (fun _ : Unit => D) (fun _ => hDtop) hepsilon
  have hbudget' : ENNReal.ofReal (b ()) * D < ENNReal.ofReal epsilon := by
    simpa using hbudget
  let eta : Real := min (b ()) (1 / 2)
  have hetapos : 0 < eta := by
    dsimp only [eta]
    exact lt_min (hbpos ()) (by norm_num)
  obtain ⟨ι, hι, U, a, r, hrpos, hrlt, hU, ha, hu, huerr⟩ :=
    exists_smoothSeparated_innerSlabTensor_near_slabSupported_four
      v hv hvzero hetapos
  letI : Fintype ι := hι
  let u : WaveSpaceTime → Complex := ScratchSlabTensor.smoothSpatialTensor U a
  have hucore : InnerSlabSchwartzTensorCore u := by
    dsimp only [u]
    exact smoothSpatialTensor_mem_innerSlabSchwartzTensorCore U a r
      (fun i => (hU i).1) (fun i => (hU i).2)
      (fun i => (ha i).1) (fun i => (ha i).2.1)
      hrpos hrlt (fun i => (ha i).2.2)
  let f : WaveSpaceTime → Complex := pointwiseNormSquare u
  have hfcore : NonnegativeSquareInnerSlabSchwartzTensorCore f := by
    dsimp only [f]
    exact pointwiseNormSquare_mem_nonnegativeSquareInnerSlabSchwartzTensorCore hucore
  have hfmem : MemLp f 2 volume := by
    dsimp only [f]
    exact memLp_two_pointwiseNormSquare u (by simpa only [u] using hu)
  refine ⟨f, hfcore, hfmem, ?_⟩
  have herr : eLpNorm (u - v) 4 volume < ENNReal.ofReal eta := by
    simpa only [u, eLpNorm_sub_comm] using huerr
  have herrone : eLpNorm (u - v) 4 volume ≤ 1 := by
    calc
      eLpNorm (u - v) 4 volume ≤ ENNReal.ofReal eta := herr.le
      _ ≤ ENNReal.ofReal (1 / 2 : Real) :=
        ENNReal.ofReal_le_ofReal (min_le_right _ _)
      _ ≤ 1 := by norm_num
  have hsq := eLpNorm_pointwiseNormSquare_sub_le_linear_of_error_le_one
    u v (by simpa only [u] using hu) hv herrone
  change eLpNorm (positiveSlabDatum h - f) 2 volume < ENNReal.ofReal epsilon
  rw [← pointwiseNormSquare_positiveSlabSquareRoot h]
  change eLpNorm (pointwiseNormSquare v - pointwiseNormSquare u) 2 volume < _
  calc
    eLpNorm (pointwiseNormSquare v - pointwiseNormSquare u) 2 volume =
        eLpNorm (pointwiseNormSquare u - pointwiseNormSquare v) 2 volume :=
          by simpa only [eLpNorm_sub_comm]
    _ ≤ D * eLpNorm (u - v) 4 volume := by
      simpa only [D] using hsq
    _ ≤ D * ENNReal.ofReal eta :=
      by simpa only [mul_comm] using mul_le_mul_left herr.le D
    _ ≤ D * ENNReal.ofReal (b ()) := by
      simpa only [mul_comm] using
        mul_le_mul_left (ENNReal.ofReal_le_ofReal (min_le_left _ _)) D
    _ = ENNReal.ofReal (b ()) * D := mul_comm _ _
    _ < ENNReal.ofReal epsilon := hbudget'

/-- Final density-side adapter for the canonical signed-envelope argument.
The finite analytic estimate is stated on signed inner-slab Schwartz tensors;
the positive kernel domination is required only on their nonnegative norm
squares.  Thus no false domination of a positive tube average by a signed
envelope is assumed for arbitrary complex inputs. -/
theorem hasLightRayMaximalEstimate_of_nonnegativeSquareInnerSlabSchwartzCore
    (T : Real → Nat → (WaveSpaceTime → Complex) →
      E2 → E2 → Complex)
    (P : Real → Nat → (WaveSpaceTime → Complex) → E2 → ENNReal)
    (hPmeas : ∀ delta N f, InnerSlabSchwartzTensorCore f →
      Measurable (P delta N f))
    (hstrong : ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
      ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∀ f : WaveSpaceTime → Complex, InnerSlabSchwartzTensorCore f →
        eLpNorm (P delta N f) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume)
    (hidentify : ∀ delta N (h : WaveSpaceTime → Complex)
      (omega y : E2),
      T delta N
          (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
        (lightRayAverage delta N omega y h : Complex))
    (hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
      (core : Nat → WaveSpaceTime → Complex),
      MemLp F 2 volume →
      (∀ n, MemLp (core n) 2 volume) →
      (∀ n, eLpNorm (F - core n) 2 volume ≤
        eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
      ∀ omega y,
        Tendsto (fun n => T delta N (core n) omega y) atTop
          (nhds (T delta N F omega y)))
    (hdom : ∀ delta N f,
      NonnegativeSquareInnerSlabSchwartzTensorCore f →
      ∀ omega y, ENNReal.ofReal ‖T delta N f omega y‖ ≤ P delta N f y) :
    HasLightRayMaximalEstimate := by
  apply hasLightRayMaximalEstimate_of_positiveSlabDenseSignedEnvelope
    NonnegativeSquareInnerSlabSchwartzTensorCore
    hasPositiveSlabL2DenseCore_nonnegativeSquareInnerSlabSchwartzTensor T P
  · intro delta N f hf
    exact hPmeas delta N f
      (nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf)
  · intro N hN
    obtain ⟨C, hC, hbound⟩ := hstrong N hN
    refine ⟨C, hC, ?_⟩
    intro delta hdelta hdeltaSmall f hf
    exact hbound delta hdelta hdeltaSmall f
      (nonnegativeSquareInnerSlabSchwartzTensorCore_to_signedCore hf)
  · exact hidentify
  · exact hTgeom
  · exact hdom

end

end Auto.Spherical.MSS.ScratchKakeyaSchwartzSquareCoreDensity
end
-- END ScratchKakeyaSchwartzSquareCoreDensity

-- BEGIN ScratchKakeyaPositiveEnvelopeFatou
section

namespace Auto.Spherical.MSS

open Filter MeasureTheory Set
open scoped BigOperators ENNReal

noncomputable section

/-- The positive directional integral of the full countable kernel family. -/
noncomputable def scratch_positiveKernelTsum
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (d : D) (x : X) : ENNReal :=
  ∫⁻ z, (∑' j : Nat, K j d x z) * G z ∂mu

/-- Its finite positive truncation.  This is deliberately an integral of a
finite sum, rather than a pre-emptive interchange with a directional sup. -/
noncomputable def scratch_positiveKernelFinitePartial
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (M : Nat) (d : D) (x : X) : ENNReal :=
  ∫⁻ z, ∑ j ∈ Finset.range M, K j d x z * G z ∂mu

/-- Positive Tonelli followed by the monotone finite-truncation limit.  This
is the safe replacement for an invalid direct exchange of `sup` and `tsum`. -/
theorem scratch_positiveKernelTsum_eq_liminf_finitePartial
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (d : D) (x : X) :
    scratch_positiveKernelTsum mu K G d x =
      atTop.liminf (fun M => scratch_positiveKernelFinitePartial mu K G M d x) := by
  unfold scratch_positiveKernelTsum scratch_positiveKernelFinitePartial
  calc
    (∫⁻ z, (∑' j : Nat, K j d x z) * G z ∂mu) =
        ∫⁻ z, ∑' j : Nat, K j d x z * G z ∂mu := by
      apply lintegral_congr
      intro z
      rw [ENNReal.tsum_mul_right]
    _ = ∑' j : Nat, ∫⁻ z, K j d x z * G z ∂mu :=
      MeasureTheory.lintegral_tsum (fun j => hmeas j d x)
    _ = atTop.liminf (fun M =>
        ∑ j ∈ Finset.range M, ∫⁻ z, K j d x z * G z ∂mu) :=
      ENNReal.tsum_eq_liminf_sum_nat
    _ = atTop.liminf (fun M =>
        ∫⁻ z, ∑ j ∈ Finset.range M, K j d x z * G z ∂mu) := by
      apply congrArg atTop.liminf
      funext M
      rw [MeasureTheory.lintegral_finsetSum' (Finset.range M)
        (fun j _ => hmeas j d x)]

/-- Each finite positive directional truncation is bounded by the finite sum
of its individual endpoint envelopes.  This is the finite triangle step;
only after it is established do we take a directional supremum or a limit. -/
theorem scratch_positiveKernelFinitePartial_le_sum_envelopes
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (M : Nat) (d : D) (x : X) :
    scratch_positiveKernelFinitePartial mu K G M d x ≤
      ∑ j ∈ Finset.range M, P j x := by
  unfold scratch_positiveKernelFinitePartial
  rw [MeasureTheory.lintegral_finsetSum' (Finset.range M)
    (fun j _ => hmeas j d x)]
  exact Finset.sum_le_sum (fun j _ => hdom j d x)

/-- A direction supremum is controlled by the Fatou limit of finite envelope
sums.  The hypotheses retain the order of operations required for the
canonical dyadic light-ray expansion: Tonelli at fixed direction, finite
triangle, then `iSup`, then Fatou. -/
theorem scratch_iSup_directional_le_liminf_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (directional : D → X → ENNReal) (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum mu K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (x : X) :
    (⨆ d : D, directional d x) ≤
      atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) := by
  apply iSup_le
  intro d
  calc
    directional d x ≤ scratch_positiveKernelTsum mu K G d x := hdir d x
    _ = atTop.liminf (fun M =>
        scratch_positiveKernelFinitePartial mu K G M d x) :=
      scratch_positiveKernelTsum_eq_liminf_finitePartial mu K G hmeas d x
    _ ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) := by
      apply Filter.liminf_le_liminf
      · exact Filter.Eventually.of_forall (fun M =>
          scratch_positiveKernelFinitePartial_le_sum_envelopes
            mu K G P hmeas hdom M d x)
      · exact by isBoundedDefault
      · exact by isBoundedDefault

/-- The raw envelope may be any function dominated by the directional
supremum; this avoids baking a particular supremum representation into the
Tonelli package. -/
theorem scratch_rawEnvelope_le_liminf_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] (mu : Measure Z)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (raw : X → ENNReal) (directional : D → X → ENNReal)
    (P : Nat → X → ENNReal)
    (hmeas : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) mu)
    (hraw : ∀ x, raw x ≤ ⨆ d : D, directional d x)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum mu K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂mu ≤ P j x)
    (x : X) :
    raw x ≤ atTop.liminf (fun M => ∑ j ∈ Finset.range M, P j x) :=
  (hraw x).trans
    (scratch_iSup_directional_le_liminf_finiteEnvelope
      mu K G directional P hmeas hdir hdom x)

/-- `L²` Fatou closure for the finite positive envelope sums.  Once a finite
signed-band theorem supplies the uniform right-hand side for these sums,
this returns the literal raw envelope estimate without a `sup`/`tsum`
interchange. -/
theorem scratch_eLpNorm_rawEnvelope_le_of_uniform_finiteEnvelope
    {Z D X : Type*} [MeasurableSpace Z] [MeasurableSpace X]
    (muZ : Measure Z) (muX : Measure X)
    (K : Nat → D → X → Z → ENNReal) (G : Z → ENNReal)
    (raw : X → ENNReal) (directional : D → X → ENNReal)
    (P : Nat → X → ENNReal) (B : ENNReal)
    (hmeasK : ∀ j d x, AEMeasurable (fun z => K j d x z * G z) muZ)
    (hraw : ∀ x, raw x ≤ ⨆ d : D, directional d x)
    (hdir : ∀ d x,
      directional d x ≤ scratch_positiveKernelTsum muZ K G d x)
    (hdom : ∀ j d x, ∫⁻ z, K j d x z * G z ∂muZ ≤ P j x)
    (hmeasP : ∀ M, Measurable (fun x => ∑ j ∈ Finset.range M, P j x))
    (hbound : ∀ M,
      eLpNorm (fun x => ∑ j ∈ Finset.range M, P j x) 2 muX ≤ B) :
    eLpNorm raw 2 muX ≤ B := by
  apply scratch_eLpNorm_le_of_ae_le_liminf_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num)
  · filter_upwards with x
    exact scratch_rawEnvelope_le_liminf_finiteEnvelope
      muZ K G raw directional P hmeasK hraw hdir hdom x
  · exact hmeasP
  · exact hbound

end

end Auto.Spherical.MSS
end
-- END ScratchKakeyaPositiveEnvelopeFatou

-- BEGIN ScratchKakeyaCanonicalDyadicClosure
section

namespace Auto.Spherical.MSS.ScratchKakeyaCanonicalDyadicClosure

open Filter MeasureTheory Set
open scoped BigOperators ENNReal Topology EuclideanSpace

open Auto.Spherical.SurfaceCore
open ScratchKakeyaBandlimitedCore
open ScratchInnerSlabTensorDensityIntegration

noncomputable section

/-- The Fatou limit of finite canonical dyadic endpoint envelopes.  The
finite terms are where the narrow radial-band argument and broad-tail
argument live; this definition contains no illicit infinite triangle step. -/
noncomputable def canonicalDyadicFiniteEnvelopeLimit
    (E : Real → Nat → (WaveSpaceTime → Complex) → Nat → Euclidean 2 → ENNReal)
    (delta : Real) (N : Nat) (f : WaveSpaceTime → Complex) :
    Euclidean 2 → ENNReal :=
  fun y => atTop.liminf (fun M => E delta N f M y)

/-- Data left after the canonical positive-kernel decomposition has been
reduced to finite endpoint envelopes.  `E delta N f M` is intended to be the
finite sum through the first `M` canonical scales, with each narrow scale
resolved into its central lowpass and finitely many radial bands. -/
structure CanonicalDyadicFiniteEnvelopeSignedModel where
  T : Real → Nat → (WaveSpaceTime → Complex) →
    Euclidean 2 → Euclidean 2 → Complex
  E : Real → Nat → (WaveSpaceTime → Complex) → Nat → Euclidean 2 → ENNReal
  hEmeas : ∀ delta N f M,
    scratch_InnerSlabCompactFrequencyTensorCore f → Measurable (E delta N f M)
  hLimitMeas : ∀ delta N f,
    scratch_InnerSlabCompactFrequencyTensorCore f →
      Measurable (canonicalDyadicFiniteEnvelopeLimit E delta N f)
  hidentify : ∀ delta N (h : WaveSpaceTime → Complex)
    (omega y : Euclidean 2),
    T delta N
        (scratch_lightRayTimeRestriction (fun z => (‖h z‖ : Complex))) omega y =
      (lightRayAverage delta N omega y h : Complex)
  hTgeom : ∀ delta N (F : WaveSpaceTime → Complex)
    (core : Nat → WaveSpaceTime → Complex),
    MemLp F 2 volume →
    (∀ n, MemLp (core n) 2 volume) →
    (∀ n, eLpNorm (F - core n) 2 volume ≤
      eLpNorm F 2 volume * ENNReal.ofReal ((2 : Real)⁻¹ ^ n)) →
    ∀ omega y,
      Tendsto (fun n => T delta N (core n) omega y) atTop
        (nhds (T delta N F omega y))
  /-- This is precisely the output of
  `scratch_rawEnvelope_le_liminf_finiteEnvelope` after instantiating the
  canonical kernel majorant. -/
  hcanonicalDom : ∀ delta N f omega y,
    ENNReal.ofReal ‖T delta N f omega y‖ ≤
      canonicalDyadicFiniteEnvelopeLimit E delta N f y

/-- The sole finite analytic premise: every finite canonical partial envelope
obeys the target bound uniformly in the truncation.  It is here, and only
here, that the central lowpass, finite radial bands, narrow estimate, and
broad tail have to be proved. -/
def HasCanonicalDyadicFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
    ∀ f : WaveSpaceTime → Complex,
      scratch_InnerSlabCompactFrequencyTensorCore f →
      ∀ M : Nat,
        eLpNorm (model.E delta N f M) 2 volume ≤
          ENNReal.ofReal (C * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
            eLpNorm f 2 volume

/-- Geometric canonical coefficients turn uniform narrow/broad per-scale
costs into one uniform finite-truncation cost.  The broad estimate need only
be width-independent: the final logarithmic factor is at least one and so
absorbs it. -/
theorem scratch_sum_range_canonicalCoefficient_mul_cost_le
    (M k0 N : Nat) (c r A B L : Real)
    (hN : 2 < N) (hc : 0 < c) (hr : 0 < r)
    (hA : 0 < A) (hB : 0 ≤ B) (hL : 0 ≤ L) (hLone : 1 ≤ L)
    (cost : Nat → Real)
    (hnarrow : ∀ j, j < k0 → cost j ≤ A * L)
    (hbroad : ∀ j, k0 ≤ j → cost j ≤ B) :
    (∑ j ∈ Finset.range M,
      canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
      ((A + B) * (((2 : Real) ^ N / c) * (2 / r) ^ 2) /
        (1 - ((2 : Real)⁻¹) ^ (N - 2))) * L := by
  let C : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  have hC : 0 < C := by
    dsimp [C]
    positivity
  have hq : 0 ≤ q := by
    dsimp [q]
    positivity
  have hqlt : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (by positivity) (by norm_num)
    exact Nat.ne_of_gt (Nat.sub_pos_of_lt hN)
  have hcost : ∀ j, cost j ≤ (A + B) * L := by
    intro j
    by_cases hj : j < k0
    · calc
        cost j ≤ A * L := hnarrow j hj
        _ ≤ (A + B) * L :=
          mul_le_mul_of_nonneg_right (by linarith) hL
    · have hj' : k0 ≤ j := le_of_not_gt hj
      calc
        cost j ≤ B := hbroad j hj'
        _ = B * 1 := by ring
        _ ≤ B * L := mul_le_mul_of_nonneg_left hLone hB
        _ ≤ (A + B) * L :=
          mul_le_mul_of_nonneg_right (by linarith) hL
  have hcoeff (j : Nat) :
      canonicalBandlimitedDyadicCoefficient N c r j = C * q ^ j := by
    dsimp [C, q]
    exact scratch_canonicalBandlimitedDyadicCoefficient_eq_geometric N c r j
  have hcoeffnonneg (j : Nat) :
      0 ≤ canonicalBandlimitedDyadicCoefficient N c r j := by
    rw [hcoeff]
    exact mul_nonneg hC.le (pow_nonneg hq _)
  have hpoint :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        ∑ j ∈ Finset.range M,
          canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L) := by
    apply Finset.sum_le_sum
    intro j _
    exact mul_le_mul_of_nonneg_left (hcost j) (hcoeffnonneg j)
  have hgeom : Summable (fun j : Nat => q ^ j) :=
    summable_geometric_of_lt_one hq hqlt
  have hgeomfin : (∑ j ∈ Finset.range M, q ^ j) ≤ (1 - q)⁻¹ := by
    calc
      (∑ j ∈ Finset.range M, q ^ j) ≤ ∑' j : Nat, q ^ j :=
        hgeom.sum_le_tsum (Finset.range M) (fun j _ => pow_nonneg hq j)
      _ = (1 - q)⁻¹ := tsum_geometric_of_lt_one hq hqlt
  have hrewrite :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L)) =
        C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := by
    calc
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L)) =
          ∑ j ∈ Finset.range M, (C * ((A + B) * L)) * q ^ j := by
            apply Finset.sum_congr rfl
            intro j _
            rw [hcoeff]
            ring
      _ = C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := by
        rw [Finset.mul_sum]
  have hfactor : 0 ≤ C * ((A + B) * L) := by
    apply mul_nonneg hC.le
    apply mul_nonneg
    · linarith
    · exact hL
  calc
    (∑ j ∈ Finset.range M,
      canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        ∑ j ∈ Finset.range M,
          canonicalBandlimitedDyadicCoefficient N c r j * ((A + B) * L) := hpoint
    _ = C * ((A + B) * L) * (∑ j ∈ Finset.range M, q ^ j) := hrewrite
    _ ≤ C * ((A + B) * L) * (1 - q)⁻¹ :=
      mul_le_mul_of_nonneg_left hgeomfin hfactor
    _ = ((A + B) * (((2 : Real) ^ N / c) * (2 / r) ^ 2) /
        (1 - ((2 : Real)⁻¹) ^ (N - 2))) * L := by
      dsimp [C, q]
      rw [div_eq_mul_inv]
      ring

/-- A narrow/broad formulation of the only finite analytic estimate still
needed.  `cost j` is allowed to contain the central lowpass and the finite
radial-band count at scale `j`; the canonical coefficient arithmetic below
is responsible for turning it into the target global logarithmic loss. -/
def HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) : Prop :=
  ∀ N : Nat, 3 < N → ∃ c r A B : Real,
    0 < c ∧ 0 < r ∧ 0 < A ∧ 0 ≤ B ∧
    ∀ delta : Real, 0 < delta → delta < 1 / 2 →
      ∃ k0 : Nat, ∃ cost : Nat → Real,
        (∀ j, j < k0 →
          cost j ≤ A * (1 + |Real.log delta|) ^ (3 / 2 : Real)) ∧
        (∀ j, k0 ≤ j → cost j ≤ B) ∧
        ∀ f : WaveSpaceTime → Complex,
          scratch_InnerSlabCompactFrequencyTensorCore f →
          ∀ M : Nat,
            eLpNorm (model.E delta N f M) 2 volume ≤
              ENNReal.ofReal
                (∑ j ∈ Finset.range M,
                  canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
                eLpNorm f 2 volume

/-- The geometric canonical coefficient sum absorbs the finite narrow block
and the broad tail uniformly in its truncation.  Thus a narrow/broad finite
envelope theorem is exactly enough for the finite-envelope premise consumed
by the density endpoint. -/
theorem hasCanonicalDyadicFiniteEnvelopeL2Estimate_of_narrowBroad
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasCanonicalDyadicFiniteEnvelopeL2Estimate model := by
  intro N hN
  obtain ⟨c, r, A, B, hc, hr, hA, hB, hscales⟩ := hfinite N hN
  let q : Real := ((2 : Real)⁻¹) ^ (N - 2)
  let Cgeo : Real := ((2 : Real) ^ N / c) * (2 / r) ^ 2
  let Cfinal : Real := (A + B) * Cgeo / (1 - q)
  have hq : q < 1 := by
    dsimp [q]
    apply pow_lt_one₀ (by positivity) (by norm_num)
    exact Nat.ne_of_gt (Nat.sub_pos_of_lt (by omega : 2 < N))
  have hCgeo : 0 < Cgeo := by
    dsimp [Cgeo]
    positivity
  have hCfinal : 0 < Cfinal := by
    dsimp [Cfinal]
    positivity
  refine ⟨Cfinal, hCfinal, ?_⟩
  intro delta hdelta hdeltaSmall
  obtain ⟨k0, cost, hnarrow, hbroad, hbound⟩ :=
    hscales delta hdelta hdeltaSmall
  let L : Real := (1 + |Real.log delta|) ^ (3 / 2 : Real)
  have hbase : 1 ≤ 1 + |Real.log delta| := by
    linarith [abs_nonneg (Real.log delta)]
  have hLone : 1 ≤ L := by
    dsimp [L]
    exact Real.one_le_rpow hbase (by norm_num)
  have hL : 0 ≤ L := (by norm_num : (0 : Real) ≤ 1).trans hLone
  intro f hf M
  have hsum :
      (∑ j ∈ Finset.range M,
        canonicalBandlimitedDyadicCoefficient N c r j * cost j) ≤
        Cfinal * L := by
    simpa only [Cfinal, Cgeo, q, L] using
      (scratch_sum_range_canonicalCoefficient_mul_cost_le
        M k0 N c r A B L (by omega) hc hr hA hB hL hLone cost
        (by simpa only [L] using hnarrow)
        hbroad)
  calc
    eLpNorm (model.E delta N f M) 2 volume ≤
        ENNReal.ofReal
          (∑ j ∈ Finset.range M,
            canonicalBandlimitedDyadicCoefficient N c r j * cost j) *
          eLpNorm f 2 volume := hbound f hf M
    _ ≤ ENNReal.ofReal (Cfinal * L) * eLpNorm f 2 volume :=
      mul_le_mul_left (ENNReal.ofReal_le_ofReal hsum) _
    _ = ENNReal.ofReal
        (Cfinal * (1 + abs (Real.log delta)) ^ (3 / 2 : Real)) *
          eLpNorm f 2 volume := by
      rfl

/-- The finite-envelope Fatou limit is a valid signed-envelope model for the
literal inner-slab tensor density theorem. -/
noncomputable def CanonicalDyadicFiniteEnvelopeSignedModel.toInnerSlabModel
    (model : CanonicalDyadicFiniteEnvelopeSignedModel) :
    InnerSlabFiniteTensorSignedEnvelopeModel where
  T := model.T
  P := canonicalDyadicFiniteEnvelopeLimit model.E
  hPmeas := model.hLimitMeas
  hidentify := model.hidentify
  hTgeom := model.hTgeom
  hdom := model.hcanonicalDom

/-- Uniform finite canonical envelope bounds pass by Fatou to the limit
envelope required by the signed-core density endpoint. -/
theorem hasInnerSlabFiniteTensorSignedEnvelopeL2Estimate_of_canonicalDyadicFinite
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicFiniteEnvelopeL2Estimate model) :
    HasInnerSlabFiniteTensorSignedEnvelopeL2Estimate model.toInnerSlabModel := by
  intro N hN
  obtain ⟨C, hC, hbound⟩ := hfinite N hN
  refine ⟨C, hC, ?_⟩
  intro delta hdelta hdeltaSmall f hf
  exact scratch_eLpNorm_liminf_le_of_uniform
    (p := (2 : ENNReal)) (by norm_num) (by norm_num)
    (fun M => model.hEmeas delta N f M hf)
    (fun M => hbound delta hdelta hdeltaSmall f hf M)

/-- Final literal conclusion from the finite canonical dyadic envelope
estimate.  This applies the actual inner-slab compact-frequency tensor
density endpoint; no additional completion or positivity argument remains. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  exact hasLightRayMaximalEstimate_of_innerSlabFiniteTensorSignedEnvelope
    model.toInnerSlabModel
    (hasInnerSlabFiniteTensorSignedEnvelopeL2Estimate_of_canonicalDyadicFinite
      model hfinite)

/-- Final source-facing form: after the finite narrow radial-band/central
lowpass estimate and the broad-tail estimate are supplied in the explicit
`HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate` premise, the literal
`HasLightRayMaximalEstimate` follows. -/
theorem hasLightRayMaximalEstimate_of_canonicalDyadicNarrowBroadFiniteEnvelope
    (model : CanonicalDyadicFiniteEnvelopeSignedModel)
    (hfinite : HasCanonicalDyadicNarrowBroadFiniteEnvelopeL2Estimate model) :
    HasLightRayMaximalEstimate := by
  exact hasLightRayMaximalEstimate_of_canonicalDyadicFiniteEnvelope model
    (hasCanonicalDyadicFiniteEnvelopeL2Estimate_of_narrowBroad model hfinite)

end

end Auto.Spherical.MSS.ScratchKakeyaCanonicalDyadicClosure
end
-- END ScratchKakeyaCanonicalDyadicClosure

