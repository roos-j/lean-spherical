          ‖outerCircleRealProfileFourierCharProductKernel f rho lambda p.1 p.2‖ *
            ‖W p.1‖ * ‖W p.2‖) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleRealProfileFourierCharProductKernel f rho lambda p.1 p.2‖ *
            ‖W p.1‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          ‖outerCircleRealProfileFourierCharProductKernel f rho lambda p.1 p.2‖ *
            ‖W p.2‖ ^ 2) (volume.prod volume) →
        Integrable (fun p : Real × Real =>
          outerCircleRealProfileFourierCharProductKernel f rho lambda p.1 p.2 * W p.1 *
            starRingEnd Complex (W p.2)) (volume.prod volume) →
        ‖((((2 * Real.pi) * lambda * rho) ^ 2 : Real) : Complex) *
          ∫ t : Real, ∫ s : Real,
            outerCircleRealProfileFourierCharProductKernel f rho lambda t s * W t *
              starRingEnd Complex (W s)‖ ≤
          (((2 * Real.pi) * lambda * rho) ^ 2) * (B / (lambda * rho)) *
            ∫ t : Real, ‖W t‖ ^ 2 := by
  rcases exists_outerCircleRealProfileFourierCharProductKernel_quadratic_E0
      hrhoMax hrhoMax_small f hf hleft hright with ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro rho hrho lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hbase := hbound rho hrho lambda hlambda W hWsq hquad hleftInt hrightInt hcomplex
  have hfactor_nonneg : 0 ≤ ((2 * Real.pi) * lambda * rho) ^ 2 := sq_nonneg _
  calc
    ‖((((2 * Real.pi) * lambda * rho) ^ 2 : Real) : Complex) *
        ∫ t : Real, ∫ s : Real,
