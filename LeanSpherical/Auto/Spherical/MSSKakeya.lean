namespace Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore

open Filter MeasureTheory FourierTransform Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaSmoothDomination
open Auto.Spherical.SmoothDyadicPhysicalCore
open scoped BigOperators Convolution FourierTransform EuclideanSpace Pointwise

noncomputable section

theorem support_canonicalPositiveCoreMultiplier_subset_closedBall_four :
    Set.Subset (Function.support
      (canonicalPositiveCoreMultiplier : Euclidean 2 → Complex))
      (Metric.closedBall 0 4) := by
  intro xi hxi
  unfold canonicalPositiveCoreMultiplier canonicalPositiveCore at hxi
  apply ball_two_add_subset_closedBall_four
  apply support_fourier_testProduct_fourierInv_subset_self_add canonicalFrequencyBump
    (Metric.ball (0 : Euclidean 2) 2)
  · exact support_subset_ball_of_zero_outside_two canonicalFrequencyBump
      canonicalFrequencyBump_zero_of_two_le_norm
  · exact ball_two_neg_closed
  exact hxi

noncomputable def canonicalBandlimitedDyadicMultiplier
    (r : Real) (hr : 0 < r) (j : Nat) : SchwartzMap (Euclidean 2) Complex :=
  translatedDilatedSchwartzCutoff canonicalPositiveCoreMultiplier 0
    (canonicalBandlimitedDyadicScale r j)
    (canonicalBandlimitedDyadicScale_pos hr j).ne'

theorem canonicalBandlimitedDyadicMultiplier_apply
    {r : Real} (hr : 0 < r) (j : Nat) (xi : Euclidean 2) :
    canonicalBandlimitedDyadicMultiplier r hr j xi =
      canonicalPositiveCoreMultiplier
        ((canonicalBandlimitedDyadicScale r j)⁻¹ • xi) := by
  unfold canonicalBandlimitedDyadicMultiplier
  rw [translatedDilatedSchwartzCutoff_apply]
  simp

theorem support_canonicalBandlimitedDyadicMultiplier_subset
    {r : Real} (hr : 0 < r) (j : Nat) :
    Set.Subset (Function.support
      (canonicalBandlimitedDyadicMultiplier r hr j : Euclidean 2 → Complex))
      (Metric.closedBall 0 (4 * canonicalBandlimitedDyadicScale r j)) := by
  intro xi hxi
  have hs : 0 < canonicalBandlimitedDyadicScale r j :=
    canonicalBandlimitedDyadicScale_pos hr j
  have hbase : (canonicalBandlimitedDyadicScale r j)⁻¹ • xi ∈
      Metric.closedBall (0 : Euclidean 2) 4 := by
    apply support_canonicalPositiveCoreMultiplier_subset_closedBall_four
    apply Function.mem_support.mpr
    intro hzero
    apply Function.mem_support.mp hxi
    rw [canonicalBandlimitedDyadicMultiplier_apply hr j xi, hzero]
  rw [Metric.mem_closedBall, dist_zero_right] at hbase ⊢
  have hnorm : ‖(canonicalBandlimitedDyadicScale r j)⁻¹ • xi‖ =
      (canonicalBandlimitedDyadicScale r j)⁻¹ * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hs)]
  rw [hnorm] at hbase
  have hscale : ‖xi‖ = canonicalBandlimitedDyadicScale r j *
      ((canonicalBandlimitedDyadicScale r j)⁻¹ * ‖xi‖) := by
    field_simp
  rw [hscale]
  calc
    canonicalBandlimitedDyadicScale r j *
        ((canonicalBandlimitedDyadicScale r j)⁻¹ * ‖xi‖) ≤
      canonicalBandlimitedDyadicScale r j * 4 :=
      mul_le_mul_of_nonneg_left hbase hs.le
    _ = 4 * canonicalBandlimitedDyadicScale r j := by ring

noncomputable def canonicalBandlimitedDyadicPhysicalCore
    (r : Real) (hr : 0 < r) (j : Nat) : SchwartzMap (Euclidean 2) Complex :=
  FourierTransform.fourierInv (canonicalBandlimitedDyadicMultiplier r hr j)

private theorem raw_fourierInv_canonicalPositiveCoreMultiplier_apply
    (u : Euclidean 2) :
    FourierTransform.fourierInv
      (canonicalPositiveCoreMultiplier : Euclidean 2 → Complex) u =
      canonicalPositiveCore u := by
  rw [← SchwartzMap.fourierInv_coe]
  exact congrArg (fun S : SchwartzMap (Euclidean 2) Complex => S u)
    fourierInv_canonicalPositiveCoreMultiplier_eq_core

theorem canonicalBandlimitedDyadicPhysicalCore_apply
    {r : Real} (hr : 0 < r) (j : Nat) (u : Euclidean 2) :
    canonicalBandlimitedDyadicPhysicalCore r hr j u =
      (canonicalBandlimitedDyadicScale r j) ^ 2 •
        canonicalPositiveCore (canonicalBandlimitedDyadicScale r j • u) := by
  have hs : 0 < canonicalBandlimitedDyadicScale r j :=
    canonicalBandlimitedDyadicScale_pos hr j
  unfold canonicalBandlimitedDyadicPhysicalCore
  rw [SchwartzMap.fourierInv_coe]
  rw [show (canonicalBandlimitedDyadicMultiplier r hr j : Euclidean 2 → Complex) =
      fun xi => canonicalPositiveCoreMultiplier
        ((canonicalBandlimitedDyadicScale r j)⁻¹ • xi) by
    funext xi
    exact canonicalBandlimitedDyadicMultiplier_apply hr j xi]
  rw [Auto.Spherical.FourierRadius.fourierInv_comp_inv_smul
    (canonicalPositiveCoreMultiplier : Euclidean 2 → Complex) hs u]
  rw [show Module.finrank Real (Euclidean 2) = 2 by norm_num]
  rw [raw_fourierInv_canonicalPositiveCoreMultiplier_apply]

theorem canonicalBandlimitedDyadicPhysicalCore_re_eq
    {r : Real} (hr : 0 < r) (j : Nat) (u : Euclidean 2) :
    (canonicalBandlimitedDyadicPhysicalCore r hr j u).re =
      canonicalBandlimitedDyadicCore r j u := by
  rw [canonicalBandlimitedDyadicPhysicalCore_apply hr j u]
  unfold canonicalBandlimitedDyadicCore
  change ((↑((canonicalBandlimitedDyadicScale r j) ^ 2) : Complex) *
      canonicalPositiveCore (canonicalBandlimitedDyadicScale r j • u)).re = _
  rw [Complex.mul_re]
  simp [pow_two, Complex.mul_re]

theorem canonicalBandlimitedDyadicPhysicalCore_re_nonneg
    {r : Real} (hr : 0 < r) (j : Nat) (u : Euclidean 2) :
    0 ≤ (canonicalBandlimitedDyadicPhysicalCore r hr j u).re := by
  rw [canonicalBandlimitedDyadicPhysicalCore_re_eq hr j u]
  exact canonicalBandlimitedDyadicCore_nonneg r j u

theorem canonicalBandlimitedDyadicPhysicalCore_re_lower_of_norm_le
    {c r : Real} (hr : 0 < r)
    (hcore : ∀ x : Euclidean 2, ‖x‖ ≤ r → c ≤ (canonicalPositiveCore x).re)
    (j : Nat) (u : Euclidean 2)
    (hu : ‖u‖ ≤ 2 * (2 : Real) ^ j) :
    (canonicalBandlimitedDyadicScale r j) ^ 2 * c ≤
      (canonicalBandlimitedDyadicPhysicalCore r hr j u).re := by
  rw [canonicalBandlimitedDyadicPhysicalCore_re_eq hr j u]
  exact canonicalBandlimitedDyadicCore_lower_of_norm_le hr hcore j u hu

end
end Auto.Spherical.MSS.ScratchKakeyaBandlimitedCore
end
