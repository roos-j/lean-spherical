open Auto.Spherical.MSS.KakeyaCircleDirection
open Auto.Spherical.MSS.KakeyaGenericAmplitudeFourierSchur
open ScratchKakeyaFiniteTensorOuterShell
open ScratchKakeyaGenericTTStarFactorization

noncomputable section

/-- A real lobe profile jointly depending on the shell carrier and normalized
coordinate produces this literal Fourier-character analysis amplitude. -/
noncomputable def outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    (g : Real × Real -> Real) (rho lambda u t : Real) : Complex :=
  (g (rho, u) : Complex) *
    (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)

/-- The associated self-conjugate joint product amplitude. -/
noncomputable def outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (p : Real × Real) : Complex :=
  ((g p) ^ 2 : Real)

theorem star_outerCircleParametricRealProfileProductAmplitude
    (g : Real × Real -> Real) (p : Real × Real) :
    starRingEnd Complex (outerCircleParametricRealProfileProductAmplitude g p) =
      outerCircleParametricRealProfileProductAmplitude g p := by
  simp [outerCircleParametricRealProfileProductAmplitude]

/-- The parametric analysis map is the local real lobe times the literal
finite-tensor time Fourier integral at the centred circle point. -/
theorem ttstarAnalysis_outerCircleParametricRealProfileFourierChar_eq_localizedFiniteTensor
    {ι : Type*} (s0 : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex)
    (g : Real × Real -> Real) (alpha rho lambda u : Real) :
    ttstarAnalysis volume
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
      (outerShellFiniteTensorTimeData s0 q a alpha lambda) u =
      (g (rho, u) : Complex) *
        outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u := by
  unfold ttstarAnalysis outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    outerShellFiniteTensorAnalysis
  rw [← integral_const_mul]
  apply integral_congr_ae
  filter_upwards with t
  rw [outerShellFiniteTensor_timePhase_eq]
  ring

/-- Exact factorization of the parametric analysis amplitude at one angular
coordinate. -/
theorem outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    (g : Real × Real -> Real) (rho lambda u t s : Real) :
    outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s) =
      outerCircleParametricRealProfileProductAmplitude g (rho, u) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
  unfold outerCircleParametricRealProfileFourierCharAnalysisAmplitude
    outerCircleParametricRealProfileProductAmplitude
  change
    ((g (rho, u) : Complex) *
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        starRingEnd Complex
          ((g (rho, u) : Complex) *
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
      ((g (rho, u)) ^ 2 : Real) *
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex)
  have hstar :
      starRingEnd Complex
          ((g (rho, u) : Complex) *
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
        starRingEnd Complex (g (rho, u) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) := by
    exact (starRingEnd Complex).map_mul _ _
  rw [hstar]
  have hphase :
      (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex) =
        (Real.fourierChar (-(t - s) * lambda * Real.cos (rho * u)) : Complex) := by
    simp only [Real.fourierChar_apply]
    rw [← Complex.exp_conj]
    simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
    rw [← Complex.exp_add]
    congr 1
    push_cast
    ring
  calc
    ((g (rho, u) : Complex) *
        (Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex)) *
        (starRingEnd Complex (g (rho, u) : Complex) *
          starRingEnd Complex
            (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) =
        ((g (rho, u) : Complex) * starRingEnd Complex (g (rho, u) : Complex)) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          ring
    _ = ((g (rho, u)) ^ 2 : Real) *
          ((Real.fourierChar (-t * lambda * Real.cos (rho * u)) : Complex) *
            starRingEnd Complex
              (Real.fourierChar (-s * lambda * Real.cos (rho * u)) : Complex)) := by
          simp only [Complex.conj_ofReal]
          push_cast
          ring
    _ = _ := by rw [hphase]

/-- The angular kernel of the parametric real-lobe analysis map is exactly
the generic joint-amplitude Fourier-character kernel. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq
    (g : Real × Real -> Real) (rho lambda t s : Real) :
    (rho : Complex) *
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s =
      outerCircleProfileFourierCharProductKernel
        (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s := by
  unfold ttstarKernel outerCircleProfileFourierCharProductKernel
  rw [intervalIntegral.integral_of_le (by norm_num : (1 / 2 : Real) ≤ 2)]
  congr 1
  apply integral_congr_ae
  filter_upwards with u
  exact outerCircleParametricRealProfileFourierCharAnalysisAmplitude_ttstar_integrand
    g rho lambda u t s

/-- Exact all-time `TT*` factorization for a joint carrier/coordinate lobe
profile.  This is the direct analytic interface for a shifted smooth
partition preweight. -/
theorem outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization
    (g : Real × Real -> Real) (rho lambda : Real) (H : Real -> Complex)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t * H t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s * H s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.1 * H p.1) *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.2 * H p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s * H t *
          starRingEnd Complex (H s)) (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
          starRingEnd Complex
            (ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s) := by
  have hbase := ttstar_factorization
    (volume.restrict (Ioc (1 / 2 : Real) 2)) volume
    (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          ttstarAnalysis volume
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u *
            starRingEnd Complex
              (ttstarAnalysis volume
                (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) H u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ t : Real, ∫ s : Real,
            ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s * H t *
                starRingEnd Complex (H s) := by rw [hbase]
    _ = ∫ t : Real, ∫ s : Real,
        ((rho : Complex) *
          ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
            (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s) * H t *
              starRingEnd Complex (H s) := by
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with t
        rw [← integral_const_mul]
        apply integral_congr_ae
        filter_upwards with s
        ring
    _ = ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s * H t *
          starRingEnd Complex (H s) := by
        apply integral_congr_ae
        filter_upwards with t
        apply integral_congr_ae
        filter_upwards with s
        rw [outerCircleParametricRealProfileFourierCharAnalysis_ttstarKernel_eq]

/-- Finite Schwartz-tensor form of the parametric lobe `TT*` identity. -/
theorem outerShellFiniteTensor_parametricRealProfile_localized_ttstar_factorization
    {ι : Type*} (s0 : Finset ι)
    (q : ι -> SchwartzMap (Euclidean 2) Complex)
    (a : ι -> SchwartzMap Real Complex)
    (g : Real × Real -> Real) (alpha rho lambda : Real)
    (hpoint : ∀ u : Real, Integrable (fun t : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        outerShellFiniteTensorTimeData s0 q a alpha lambda t) volume)
    (hpointStar : ∀ u : Real, Integrable (fun s : Real =>
      starRingEnd Complex
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda s)) volume)
    (htriple : Integrable (Function.uncurry fun u (p : Real × Real) =>
      (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.1 *
        outerShellFiniteTensorTimeData s0 q a alpha lambda p.1) *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u p.2 *
            outerShellFiniteTensorTimeData s0 q a alpha lambda p.2))
      ((volume.restrict (Ioc (1 / 2 : Real) 2)).prod (volume.prod volume)))
    (hkernel : ∀ t s : Real, Integrable (fun u : Real =>
      outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u t *
        starRingEnd Complex
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda u s))
      (volume.restrict (Ioc (1 / 2 : Real) 2)))
    (hrhs : Integrable (Function.uncurry fun t s =>
      ttstarKernel (volume.restrict (Ioc (1 / 2 : Real) 2))
        (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda) t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s))
      (volume.prod volume)) :
    (rho : Complex) *
      ∫ u : Real,
        ((g (rho, u) : Complex) *
          outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
          starRingEnd Complex
            ((g (rho, u) : Complex) *
              outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
        ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
      ∫ t : Real, ∫ s : Real,
        outerCircleProfileFourierCharProductKernel
          (outerCircleParametricRealProfileProductAmplitude g) rho lambda t s *
          outerShellFiniteTensorTimeData s0 q a alpha lambda t *
            starRingEnd Complex
              (outerShellFiniteTensorTimeData s0 q a alpha lambda s) := by
  have hbase := outerCircleParametricRealProfileFourierCharAnalysis_ttstar_factorization
    g rho lambda (outerShellFiniteTensorTimeData s0 q a alpha lambda)
    hpoint hpointStar htriple hkernel hrhs
  calc
    (rho : Complex) *
        ∫ u : Real,
          ((g (rho, u) : Complex) *
            outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u) *
            starRingEnd Complex
              ((g (rho, u) : Complex) *
                outerShellFiniteTensorAnalysis s0 q a alpha rho lambda u)
          ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) =
        (rho : Complex) *
          ∫ u : Real,
            ttstarAnalysis volume
              (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
              (outerShellFiniteTensorTimeData s0 q a alpha lambda) u *
              starRingEnd Complex
                (ttstarAnalysis volume
                  (outerCircleParametricRealProfileFourierCharAnalysisAmplitude g rho lambda)
                  (outerShellFiniteTensorTimeData s0 q a alpha lambda) u)
            ∂(volume.restrict (Ioc (1 / 2 : Real) 2)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with u
          rw [ttstarAnalysis_outerCircleParametricRealProfileFourierChar_eq_localizedFiniteTensor]
    _ = _ := hbase

end

end Auto.Spherical.MSS.KakeyaParametricProfileFiniteTensor
end
-- END ScratchKakeyaParametricProfileFiniteTensor

