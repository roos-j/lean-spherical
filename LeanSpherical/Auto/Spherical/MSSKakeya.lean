/-- The finite family of literal endpoint-GN envelopes for one annular
frequency tensor.  The hypotheses are only scalar shell geometry: central,
dyadic, and capped-terminal cases are all consumed below. -/
theorem exists_shiftedCapped_annular_piece_hpiece_bounds
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex)
    {rhoMax eps lambda ratio rTerminal : Real}
    (hrhoMax : 0 <= rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (heps : 0 < eps) (hlambda : 0 < lambda) (K : Nat)
    (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
    (hqann : ∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus lambda)
    (hcentralMem : 4 * eps ∈ Icc (0 : Real) rhoMax)
    (hcentralCritical : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32)
    (hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈ Ioc (0 : Real) rhoMax)
    (hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2)
    (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2))
    (hrTerminalMem : rTerminal ∈ Ioc (0 : Real) rhoMax)
    (hterminalOuter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * rTerminal ^ 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ cost : kappa × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric charts K, 0 < cost jni) ∧
      ∀ jni ∈ shiftedCappedShellIndicesGeneric charts K,
        Measurable (fun y : Euclidean 2 =>
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) ∧
        (∫⁻ y : Euclidean 2,
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) <=
          ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (C.chartProfiles jni.1 q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  classical
  let shells := shiftedCappedShellIndicesGeneric charts K
  have hlocal : ∀ jni : kappa × (Nat × Nat), jni ∈ shells ->
      ∃ B : Real, 0 < B ∧
        Measurable (fun y : Euclidean 2 =>
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) ∧
        (∫⁻ y : Euclidean 2,
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) <=
          ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (C.chartProfiles jni.1 q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
    rintro ⟨j, n, i⟩ hjni
    have hjni' : j ∈ charts ∧ n ∈ Finset.range 7 ∧
        i ∈ Finset.range (K + 2) := by
      simpa [shells, shiftedCappedShellIndicesGeneric] using hjni
    rcases hjni' with ⟨hj, hn, hi⟩
    have hnlt : n < 7 := Finset.mem_range.mp hn
    by_cases hzero : i = 0
    · subst i
      rcases exists_shifted_central_physical_hpiece_bound hrhoMax
          C j hj s q hqcompact a K n hnlt with ⟨B, hB, hbound⟩
      refine ⟨B, hB, ?_⟩
      simpa only [shiftedCappedShellPieceGeneric] using
        (hbound heps hlambda hcentralMem hqann hcentralCritical hscale
          (rTime := rTime) hrTime hsupport)
    · by_cases hterminal : i = K + 1
      · subst i
        rcases exists_shifted_terminal_physical_hpiece_bound
            hrhoMax hrhoMax_small n hratio with ⟨B, hB, hbound⟩
        refine ⟨B, hB, ?_⟩
        simpa only [shiftedCappedShellPieceGeneric] using
          (hbound (C := C) j hj s q hqcompact a heps hlambda K hqann hnlt
            hratioDef hrTerminal hrTerminalMem hterminalOuter hscale
            (rTime := rTime) hrTime hsupport)
      · have hlt : i < K + 1 := by
          have hilim := Finset.mem_range.mp hi
          omega
        obtain ⟨k, hk, hki⟩ : ∃ k, k < K ∧ i = k + 1 := by
          refine ⟨i - 1, ?_, ?_⟩
          · omega
          · omega
        subst i
        rcases exists_shifted_dyadic_physical_hpiece_bound
            hrhoMax hrhoMax_small n with ⟨B, hB, hbound⟩
        refine ⟨B, hB, ?_⟩
        simpa only [shiftedCappedShellPieceGeneric] using
          (hbound (C := C) j hj s q hqcompact a heps hlambda K k hk hqann hnlt
            rfl (hdyadicMem k hk) (hdyadicOuter k hk) hscale
            (rTime := rTime) hrTime hsupport)
  have hlocalAll : ∀ jni : kappa × (Nat × Nat), ∃ B : Real, 0 < B ∧
      (jni ∈ shells ->
        Measurable (fun y : Euclidean 2 =>
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) ∧
        (∫⁻ y : Euclidean 2,
          ⨆ theta : Icc shiftedCappedShellGlobalCommonLeft Real.pi,
            ENNReal.ofReal
              (‖shiftedCappedShellPieceGeneric C s q hqcompact a eps K jni theta.1 y‖ ^ 2)) <=
          ENNReal.ofReal (4 * B * ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (C.chartProfiles jni.1 q) a xi ∂
              (volume.restrict (scaledDyadicFrequencyAnnulus lambda)))) := by
    intro jni
    by_cases hjni : jni ∈ shells
    · rcases hlocal jni hjni with ⟨B, hB, hlocalB⟩
      exact ⟨B, hB, fun _ => hlocalB⟩
    · exact ⟨1, by norm_num, fun h => (hjni h).elim⟩
  choose cost hcostpos hcost using hlocalAll
  refine ⟨cost, ?_, ?_⟩
  · intro jni hjni
    exact hcostpos jni
  · intro jni hjni
    exact hcost jni hjni

/-- Exact finite chart/shift/shell reassembly of the concrete annular
endpoint estimates.  The result exposes the literal finite cost sum; no
uniformity or Littlewood--Paley overlap is silently assumed. -/
theorem exists_shiftedCapped_annular_max_bound
    {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
    (C : SmoothAngularFrequencyChartFamily kappa charts active)
    (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (hqactive : ∀ l, C.SupportedOnActive (q l))
    (a : iota -> SchwartzMap Real Complex)
    {rhoMax eps lambda ratio rTerminal : Real}
    (hrhoMax : 0 <= rhoMax) (hrhoMax_small : 9 * rhoMax / 4 < Real.pi)
    (heps : 0 < eps) (hlambda : 0 < lambda) (K : Nat)
    (hscale : (2 : Real) ^ K * eps <= Real.pi / 2)
    (hqann : ∀ l, Function.support (q l : Euclidean 2 -> Complex) ⊆
      scaledDyadicFrequencyAnnulus lambda)
    (hcentralMem : 4 * eps ∈ Icc (0 : Real) rhoMax)
    (hcentralCritical : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32)
    (hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈ Ioc (0 : Real) rhoMax)
    (hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2)
    (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
    (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
    (hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2))
    (hrTerminalMem : rTerminal ∈ Ioc (0 : Real) rhoMax)
    (hterminalOuter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * rTerminal ^ 2)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime)
    (hangleUpper : ∀ j xi, C.angle j xi < 6) :
    ∃ cost : kappa × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric charts K, 0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric charts K).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric charts K,
            ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (C.chartProfiles jni.1 q) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus lambda))) := by
  rcases exists_shiftedCapped_annular_piece_hpiece_bounds C s q hqcompact a
      hrhoMax hrhoMax_small heps hlambda K hscale hqann hcentralMem hcentralCritical
      hdyadicMem hdyadicOuter hratio hratioDef hrTerminal hrTerminalMem hterminalOuter
      hrTime hsupport with ⟨cost, hcostpos, hpiece⟩
  refine ⟨cost, hcostpos, ?_⟩
  apply lintegral_iSup_sq_finiteTensorCircleMultiplierField_le_shiftedCapped_envelopes
    C s q hqcompact hqactive a eps K
    (lo := shiftedCappedShellGlobalCommonLeft)
    (by
      unfold shiftedCappedShellGlobalCommonLeft
      unfold Auto.Spherical.MSS.KakeyaCappedAngularShellReassembly.cappedShellCommonLeft
      nlinarith [Real.pi_gt_three])
  · intro theta j n i
    exact (contDiff_shiftedChartedCappedTelescopingMultiplier_slice
      C j s q hqcompact a eps K n i theta).continuous.integrable_of_hasCompactSupport
        (hasCompactSupport_shiftedChartedCappedTelescopingMultiplier_slice
          C j s q hqcompact a eps K n i theta)
  · exact hangleUpper
  · intro jni hjni
    exact (hpiece jni hjni).1
  · intro jni hjni
    exact (hpiece jni hjni).2

end

