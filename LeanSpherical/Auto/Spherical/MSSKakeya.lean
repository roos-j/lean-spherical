/-- Ratio-uniform terminal derivative source estimate.  The cutoff and phase
constants are selected once from the frozen fixed-width families, before the
actual cap ratio, chart, or finite tensor is introduced. -/
theorem exists_shellFrequencyEnergy_shiftedCharted_terminal_deriv_le_source_uniform
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa iota : Type*} {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (s : Finset iota)
        (q : iota → SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
        (a : iota → SchwartzMap Real Complex)
        {eps r ratio : Real} (K : Nat)
        (hratio : ratio ∈ Icc (1 / 2 : Real) 1)
        (hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2))
        (hr : r = cappedTerminalCarrier)
        (lo hi : Real) (xi : Euclidean 2)
        (hpolar : xi = ‖xi‖ • circleDirection (C.angle j xi))
        (hn : n < 7) (hxi : ‖xi‖ ≠ 0)
        (hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (houter : 1 ≤ ‖xi‖ * r ^ 2)
        {rTime : Real}, rTime < 1 →
        (∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime) →
      shellFrequencyEnergy
        (shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (K + 1))
        lo hi xi ≤ B * (‖xi‖ * r) *
          shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
  rcases exists_shiftedCappedTerminalPositiveFiberEnergy_cutoff_E1_uniform n with
    ⟨Bcutplus, hBcutplus, hcutplus⟩
  rcases exists_shiftedCappedTerminalReflectedNegativeFiberEnergy_cutoff_E1_uniform n with
    ⟨Bcutminus, hBcutminus, hcutminus⟩
