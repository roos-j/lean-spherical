section

namespace Auto.Spherical.MSS.KakeyaRadialBandCappedGeometry

open Filter MeasureTheory Metric Set
open Auto.Spherical.SurfaceCore
open Auto.Spherical.LittlewoodPaley
open Auto.Spherical.MSS.KakeyaAngularShellPartition
open Auto.Spherical.MSS.KakeyaCappedShellLevel
open Auto.Spherical.MSS.KakeyaConcreteRadialBandAnnular
open Auto.Spherical.MSS.KakeyaFiniteTensorRadialBandBridge
open Auto.Spherical.MSS.KakeyaFiniteRadialFrequencyDecomposition
open Auto.Spherical.MSS.KakeyaFiniteRadialPhysicalMaxReassembly
open Auto.Spherical.MSS.KakeyaScaledSectorPartition
open Auto.Spherical.MSS.KakeyaShiftedCappedEnvelopeReassembly
open Auto.Spherical.MSS.KakeyaShiftedCappedFiberLobeEnergy
open scoped BigOperators EuclideanSpace

noncomputable section

private theorem radialBandScale_ge_sixteen (i : Nat) (hi : 3 <= i) :
    16 <= kakeyaRadialBandScale i := by
  unfold kakeyaRadialBandScale
  have hpow : (2 : Real) ^ 4 <= (2 : Real) ^ (i + 1) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  norm_num at hpow ⊢
  exact hpow

private theorem centeredCriticalWidth_le_quarter
    {lambda : Real} (hlambda : 16 <= lambda) :
    centeredCriticalWidth lambda <= 1 / 4 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos hlambdaPos
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  nlinarith [sq_nonneg (centeredCriticalWidth lambda - (1 / 4 : Real))]

/-- The fixed carrier used by every capped near-stationary outer lobe. -/
noncomputable def radialBandOuterRhoMax : Real := 2 * Real.pi / 5

/-- The critical angular width at the `i`th positive radial carrier. -/
noncomputable def radialBandAngularEps (i : Nat) : Real :=
  centeredCriticalWidth (kakeyaRadialBandScale i)

/-- The capped dyadic angular level at the `i`th positive radial carrier. -/
noncomputable def radialBandAngularLevel (i : Nat) : Nat :=
  kakeyaCappedShellLevel (kakeyaRadialBandScale i)

/-- The literal terminal width/cap ratio at the `i`th radial carrier. -/
noncomputable def radialBandTerminalRatio (i : Nat) : Real :=
  ((2 : Real) ^ (radialBandAngularLevel i) * radialBandAngularEps i) /
    (Real.pi / 2)

theorem radialBandOuterRhoMax_nonneg : 0 <= radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  positivity

theorem radialBandOuterRhoMax_small :
    9 * radialBandOuterRhoMax / 4 < Real.pi := by
  unfold radialBandOuterRhoMax
  nlinarith [Real.pi_pos]

theorem one_le_radialBandOuterRhoMax : 1 <= radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  nlinarith [Real.pi_gt_three]

private theorem radialBand_central_mem
    {lambda : Real} (hlambda : 16 <= lambda) :
    4 * centeredCriticalWidth lambda ∈ Icc (0 : Real) radialBandOuterRhoMax := by
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos (by linarith)
  constructor
  · positivity
  · calc
      4 * centeredCriticalWidth lambda <= 4 * (1 / 4 : Real) :=
        mul_le_mul_of_nonneg_left (centeredCriticalWidth_le_quarter hlambda) (by norm_num)
      _ = 1 := by norm_num
      _ <= radialBandOuterRhoMax := one_le_radialBandOuterRhoMax

private theorem radialBand_central_critical
    {lambda : Real} (hlambda : 16 <= lambda) (xi : Euclidean 2)
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 ∧
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <= 32 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  have hepsSqNonneg : 0 <= centeredCriticalWidth lambda ^ 2 := sq_nonneg _
  have hlo := mul_le_mul_of_nonneg_right hxi.1 hepsSqNonneg
  have hhi := mul_le_mul_of_nonneg_right hxi.2 hepsSqNonneg
  constructor
  · calc
      1 = lambda * centeredCriticalWidth lambda ^ 2 := hepsSq.symm
      _ <= ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 := by
        nlinarith
  · calc
      ‖xi‖ * (4 * centeredCriticalWidth lambda) ^ 2 <=
          32 * (lambda * centeredCriticalWidth lambda ^ 2) := by
            nlinarith
      _ = 32 := by rw [hepsSq]; ring

private theorem radialBand_dyadic_mem
    {lambda : Real} (hlambda : 16 <= lambda) (k : Nat)
    (hk : k < kakeyaCappedShellLevel lambda) :
    (4 / 5 : Real) *
        ((2 : Real) ^ (k + 1) * centeredCriticalWidth lambda) ∈
      Ioc (0 : Real) radialBandOuterRhoMax := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsPos : 0 < centeredCriticalWidth lambda :=
    centeredCriticalWidth_pos hlambdaPos
  have hK := (kakeyaCappedShellLevel_radius_bounds (by linarith : 1 <= lambda)).1
  have hpow : (2 : Real) ^ (k + 1) <=
      (2 : Real) ^ (kakeyaCappedShellLevel lambda) :=
    pow_le_pow_right₀ (by norm_num) (by omega)
  have hscale : (2 : Real) ^ (k + 1) * centeredCriticalWidth lambda <=
      (2 : Real) ^ (kakeyaCappedShellLevel lambda) * centeredCriticalWidth lambda :=
    mul_le_mul_of_nonneg_right hpow hepsPos.le
  constructor
  · positivity
  · unfold kakeyaAngularRadiusCap at hK
    unfold radialBandOuterRhoMax
    nlinarith

private theorem radialBand_dyadic_outer
    {lambda : Real} (hlambda : 16 <= lambda) (k : Nat)
    (xi : Euclidean 2) (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ *
      ((4 / 5 : Real) *
        ((2 : Real) ^ (k + 1) * centeredCriticalWidth lambda)) ^ 2 := by
  have hlambdaPos : 0 < lambda := by linarith
  have hepsSq : lambda * centeredCriticalWidth lambda ^ 2 = 1 :=
    centeredCriticalWidth_sq hlambdaPos
  let u : Real := (2 : Real) ^ (k + 1)
  have hu : 2 <= u := by
    dsimp only [u]
    have hpow : (2 : Real) ^ 1 <= (2 : Real) ^ (k + 1) :=
      pow_le_pow_right₀ (by norm_num) (by omega)
    norm_num at hpow ⊢
    exact hpow
  have huSq : 4 <= u ^ 2 := by
    nlinarith [sq_nonneg (u - 2)]
  have hcarrier : 1 <= (lambda / 2) *
      ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 := by
    have hrewrite : (lambda / 2) *
        ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 =
        (8 / 25 : Real) * u ^ 2 *
          (lambda * centeredCriticalWidth lambda ^ 2) := by ring
    rw [hrewrite, hepsSq]
    nlinarith
  have hmul := mul_le_mul_of_nonneg_right hxi.1
    (sq_nonneg ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)))
  calc
    1 <= (lambda / 2) *
        ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 := hcarrier
    _ <= ‖xi‖ *
        ((4 / 5 : Real) * (u * centeredCriticalWidth lambda)) ^ 2 := hmul

private theorem radialBand_terminal_mem :
    (4 / 5 : Real) * (Real.pi / 2) ∈ Ioc (0 : Real) radialBandOuterRhoMax := by
  unfold radialBandOuterRhoMax
  constructor
  · positivity
  · ring_nf
    exact le_rfl

private theorem radialBand_terminal_outer
    {lambda : Real} (hlambda : 16 <= lambda) (xi : Euclidean 2)
    (hxi : xi ∈ scaledDyadicFrequencyAnnulus lambda) :
    1 <= ‖xi‖ * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := by
  have hhalf : 8 <= lambda / 2 := by linarith
  have hrho : 1 <= (2 * Real.pi / 5) := by
    nlinarith [Real.pi_gt_three]
  have hrhoSq : 1 <= (2 * Real.pi / 5) ^ 2 := by
    nlinarith [sq_nonneg (2 * Real.pi / 5 - 1)]
  have hcarrier : 1 <= (lambda / 2) * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := by
    have hrewrite : (4 / 5 : Real) * (Real.pi / 2) = 2 * Real.pi / 5 := by ring
    rw [hrewrite]
    calc
      1 <= 8 * 1 := by norm_num
      _ <= (lambda / 2) * (2 * Real.pi / 5) ^ 2 := by
        exact mul_le_mul hhalf hrhoSq (by norm_num) (by linarith)
  have hmul := mul_le_mul_of_nonneg_right hxi.1
    (sq_nonneg ((4 / 5 : Real) * (Real.pi / 2)))
  calc
    1 <= (lambda / 2) * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := hcarrier
    _ <= ‖xi‖ * ((4 / 5 : Real) * (Real.pi / 2)) ^ 2 := hmul

/-- The fully literal narrow radial-band bound.  It uses the capped shell
level and the critical width canonically associated to the band carrier,
so no dyadic/terminal geometry is left as a premise. -/
theorem exists_kakeyaRadialBandPhysicalField_narrow_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) (hi : 3 <= i)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i), 0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) *
          ∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i),
            ENNReal.ofReal (4 * cost jni * ∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s
                ((scaledDyadicFourChartFamily (kakeyaRadialBandScale i)
                  (kakeyaRadialBandScale_pos i)).chartProfiles jni.1
                  (finiteTensorRadialBandProfiles L q i)) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))) := by
  let lambda : Real := kakeyaRadialBandScale i
  let eps : Real := centeredCriticalWidth lambda
  let K : Nat := kakeyaCappedShellLevel lambda
  let ratio : Real := ((2 : Real) ^ K * eps) / (Real.pi / 2)
  let rTerminal : Real := (4 / 5 : Real) * (Real.pi / 2)
  have hlambda16 : 16 <= lambda := by
    simpa only [lambda] using radialBandScale_ge_sixteen i hi
  have hlambdaPos : 0 < lambda := by linarith
  have hlambdaOne : 1 <= lambda := by linarith
  have heps : 0 < eps := by
    dsimp only [eps]
    exact centeredCriticalWidth_pos hlambdaPos
  have hscale : (2 : Real) ^ K * eps <= Real.pi / 2 := by
    simpa only [K, eps, lambda, kakeyaAngularRadiusCap] using
      (kakeyaCappedShellLevel_radius_bounds hlambdaOne).1
  have hcentralMem : 4 * eps ∈ Icc (0 : Real) radialBandOuterRhoMax := by
    simpa only [eps, lambda] using radialBand_central_mem hlambda16
  have hcentralCritical : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * (4 * eps) ^ 2 ∧ ‖xi‖ * (4 * eps) ^ 2 <= 32 := by
    intro xi hxi
    simpa only [eps] using radialBand_central_critical hlambda16 xi hxi
  have hdyadicMem : ∀ k, k < K ->
      (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps) ∈
        Ioc (0 : Real) radialBandOuterRhoMax := by
    intro k hk
    simpa only [K, eps, lambda] using radialBand_dyadic_mem hlambda16 k hk
  have hdyadicOuter : ∀ k, k < K -> ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * ((4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) ^ 2 := by
    intro k hk xi hxi
    simpa only [eps] using radialBand_dyadic_outer hlambda16 k xi hxi
  have hratio : ratio ∈ Icc (1 / 2 : Real) 1 := by
    change 1 / 2 <= ratio ∧ ratio <= 1
    simpa only [ratio, K, eps, lambda, kakeyaAngularRadiusCap] using
      kakeyaCappedShellLevel_ratio_bounds hlambdaOne
  have hratioDef : ratio = ((2 : Real) ^ K * eps) / (Real.pi / 2) := rfl
  have hrTerminal : rTerminal = (4 / 5 : Real) * (Real.pi / 2) := rfl
  have hrTerminalMem : rTerminal ∈ Ioc (0 : Real) radialBandOuterRhoMax := by
    simpa only [rTerminal] using radialBand_terminal_mem
  have hterminalOuter : ∀ xi,
      xi ∈ scaledDyadicFrequencyAnnulus lambda ->
      1 <= ‖xi‖ * rTerminal ^ 2 := by
    intro xi hxi
    simpa only [rTerminal] using radialBand_terminal_outer hlambda16 xi hxi
  rcases exists_kakeyaRadialBandPhysicalField_shiftedCapped_annular_max_bound
      L s q hqcompact a i radialBandOuterRhoMax_nonneg radialBandOuterRhoMax_small
      heps K hscale hcentralMem hcentralCritical hdyadicMem hdyadicOuter hratio
      hratioDef hrTerminal hrTerminalMem hterminalOuter hrTime hsupport with
    ⟨cost, hcost, hbound⟩
  refine ⟨cost, ?_, ?_⟩
  · simpa only [radialBandAngularLevel, K, lambda] using hcost
  · simpa only [radialBandAngularLevel, radialBandAngularEps,
      radialBandTerminalRatio, K, eps, ratio, rTerminal, lambda] using hbound

/-- The narrow radial-band theorem in its scale-cost form: the physical
maximum has already summed the four charts, seven stationary shifts, and
all capped shells, and the remaining RHS is one uncharted source-energy
integral with an explicit finite coefficient sum. -/
theorem exists_kakeyaRadialBandPhysicalField_narrow_scaleCost_bound
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat) (hi : 3 <= i)
    {rTime : Real} (hrTime : rTime < 1)
    (hsupport : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    ∃ cost : Fin 4 × (Nat × Nat) -> Real,
      (∀ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i), 0 < cost jni) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real,
        ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (fun theta => scratch_finiteTensorTubeMultiplier s q hqcompact a
              (Auto.Spherical.MSS.KakeyaCircleDirection.circleDirection theta))
            i theta y‖ ^ 2)) <=
        ((shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
          (radialBandAngularLevel i)).card : ENNReal) *
          ((∑ jni ∈ shiftedCappedShellIndicesGeneric (Finset.univ : Finset (Fin 4))
              (radialBandAngularLevel i), ENNReal.ofReal (4 * cost jni)) *
            (4 * ENNReal.ofReal (∫ xi : Euclidean 2,
              shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi ∂
                (volume.restrict (scaledDyadicFrequencyAnnulus
                  (kakeyaRadialBandScale i)))))) := by
  exact exists_kakeyaRadialBandPhysicalField_scaleCost_of_max_bound
    L s q hqcompact a i (radialBandAngularLevel i)
    (exists_kakeyaRadialBandPhysicalField_narrow_bound
      L s q hqcompact a i hi hrTime hsupport)

end

