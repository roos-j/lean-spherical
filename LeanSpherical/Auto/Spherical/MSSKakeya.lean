  have hm : Continuous (Function.uncurry m) := by
    change Continuous (fun p : Real × Euclidean 2 =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection p.1) p.2)
    exact continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle s q hqcompact a
  change Continuous (Function.uncurry (fun theta y =>
    FourierTransform.fourierInv (m theta) y))
  apply continuous_uncurry_fourierInv_of_dominated m
    (bound := finiteTensorTubeMultiplierBound s q a)
  · intro xi
    have hphase : Continuous (fun p : Real × Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun p : Real × Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun p : Real × Euclidean 2 => (p.1, xi)) by fun_prop)
    exact hphase.smul hmxi
  · intro p
    have hphase : Continuous (fun xi : Euclidean 2 =>
        (Real.fourierChar (inner Real xi p.2) : Complex)) := by fun_prop
    have hmxi : Continuous (fun xi : Euclidean 2 => m p.1 xi) :=
      hm.comp (show Continuous (fun xi : Euclidean 2 => (p.1, xi)) by fun_prop)
    exact (hphase.smul hmxi).aestronglyMeasurable
  · intro p xi
    rw [norm_smul, lowBand_norm_fourierChar_eq_one, one_mul]
    exact norm_scratch_finiteTensorTubeMultiplier_circle_le_bound
      s q hqcompact a p.1 xi
  · exact integrable_finiteTensorTubeMultiplierBound s q a

/-- A fixed radial band of a compact-time finite tensor is controlled by the
ordinary global angular `H¹` maximal inequality.  This is the low-band
alternative to the capped stationary-shell argument; no annular largeness is
required. -/
theorem measurable_and_lintegral_iSup_sq_finiteTensorRadialBandPhysicalField_le_globalH1
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (i : Nat)
    (D : Real -> Euclidean 2 -> Complex)
    (hFcont : Continuous (Function.uncurry (fun theta y =>
      kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y)))
    (hDcont : Continuous (Function.uncurry D))
    (hderiv : ∀ theta y, HasDerivAt
      (fun r => kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i r y)
      (D theta y) theta)
    (hleft : Integrable (fun y : Euclidean 2 =>
      ‖kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i (-Real.pi) y‖ ^ 2) volume)
    (hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume))
    {E0 E1 : Real}
    (hE0 : (∫ y : Euclidean 2,
      ‖kakeyaRadialBandPhysicalField L
        (finiteTensorCircleRadialMultiplier s q hqcompact a) i (-Real.pi) y‖ ^ 2) ≤ E0)
    (hE1 : (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
      ‖D theta y‖ ^ 2) ≤ E1) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ≤
        ENNReal.ofReal (2 * E0 + 4 * Real.pi * E1) := by
  let F : Real -> Euclidean 2 -> Complex := fun theta y =>
    kakeyaRadialBandPhysicalField L
      (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport (qBand l : Euclidean 2 -> Complex) := by
    exact finiteTensorRadialBandProfiles_compact L q hqcompact i
  have hFcircle : F = fun theta y =>
      finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y := by
    funext theta y
    dsimp only [F, qBand, finiteTensorCircleRadialMultiplier]
    symm
    exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
  have hperiodic : ∀ y, Function.Periodic (fun theta => F theta y)
      (2 * Real.pi) := by
    intro y
    rw [hFcircle]
    exact periodic_finiteTensorCircleMultiplierField s qBand hqBandCompact a y
  have hlocal := measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_of_hasDerivAt
    (d := 2) (a := -Real.pi) (b := Real.pi) (by linarith [Real.pi_pos])
    (by simpa only [F] using hFcont) hDcont
    (by
      intro theta y
      simpa only [F] using hderiv theta y)
    (by simpa only [F] using hleft) hDprod
  have hEq : (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2)) =
      fun y : Euclidean 2 =>
        ⨆ theta : Icc (-Real.pi) Real.pi,
          ENNReal.ofReal (‖F theta.1 y‖ ^ 2) := by
    funext y
    exact iSup_sq_periodic_parametricField_eq_fundamental F hperiodic y
  constructor
  · rw [show (fun y : Euclidean 2 =>
        ⨆ theta : Real, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) =
        fun y : Euclidean 2 => ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2) by
          rfl, hEq]
    exact hlocal.1
  · rw [show (fun y : Euclidean 2 =>
        ⨆ theta : Real, ENNReal.ofReal
          (‖kakeyaRadialBandPhysicalField L
            (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) =
        fun y : Euclidean 2 => ⨆ theta : Real, ENNReal.ofReal (‖F theta y‖ ^ 2) by
          rfl, hEq]
    refine hlocal.2.trans ?_
    apply ENNReal.ofReal_le_ofReal
    have hlength : Real.pi - -Real.pi = 2 * Real.pi := by ring
    rw [hlength]
    have hDnonneg : 0 <= (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
        ‖D theta y‖ ^ 2) := by
      apply intervalIntegral.integral_nonneg
      · linarith [Real.pi_pos]
      · intro theta htheta
        exact integral_nonneg fun y => sq_nonneg _
    have hE1nonneg : 0 <= E1 := hDnonneg.trans hE1
    have hcoef : 0 <= 4 * Real.pi := by positivity
    exact add_le_add
      (mul_le_mul_of_nonneg_left hE0 (by norm_num))
      (calc
        2 * (2 * Real.pi) * (∫ theta in (-Real.pi)..Real.pi,
            ∫ y : Euclidean 2, ‖D theta y‖ ^ 2) =
            4 * Real.pi * (∫ theta in (-Real.pi)..Real.pi,
              ∫ y : Euclidean 2, ‖D theta y‖ ^ 2) := by ring
        _ <= 4 * Real.pi * E1 := mul_le_mul_of_nonneg_left hE1 hcoef)

/-- The energy label produced by the fixed-width angular `H¹` argument. -/
/- Concrete compact-time closure for one of the three pre-narrow radial
bands.  Both endpoint energy and angular trace reduce to the literal
radialized source-time energy. -/
theorem measurable_and_lintegral_iSup_sq_finiteTensorRadialBandPhysicalField_le_lowThree_sourceEnergy
    {iota : Type*} (L : lpCutoffs 2) (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) {i : Nat} (hi : i < 3)
    {rTime : Real} (hrTime : rTime < 1)
    (ha : ∀ l, Function.support (a l : Real -> Complex) ⊆
      closedBall (3 / 2 : Real) rTime) :
    Measurable (fun y : Euclidean 2 =>
      ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ∧
      (∫⁻ y : Euclidean 2, ⨆ theta : Real, ENNReal.ofReal
        (‖kakeyaRadialBandPhysicalField L
          (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y‖ ^ 2)) ≤
        ENNReal.ofReal ((4 + 102400 * Real.pi ^ 4) *
          ∫ xi : Euclidean 2,
            shiftedFiberSourceEnergy s (finiteTensorRadialBandProfiles L q i) a xi) := by
  let qBand := finiteTensorRadialBandProfiles L q i
  have hqBandCompact : ∀ l, HasCompactSupport
      (qBand l : Euclidean 2 -> Complex) :=
    finiteTensorRadialBandProfiles_compact L q hqcompact i
  let F : Real -> Euclidean 2 -> Complex := fun theta y =>
    kakeyaRadialBandPhysicalField L
      (finiteTensorCircleRadialMultiplier s q hqcompact a) i theta y
  let dm : Real -> SchwartzMap (Euclidean 2) Complex := fun theta =>
    finiteTensorTubeMultiplierAngularDerivSlice s qBand hqBandCompact a theta
  have hFcircle : F = fun theta y =>
      finiteTensorCircleMultiplierField s qBand hqBandCompact a theta y := by
    funext theta y
    dsimp only [F, qBand, finiteTensorCircleRadialMultiplier]
    symm
    exact finiteTensorCircleMultiplierField_radialBand_eq L s q hqcompact a i theta y
  have hFcont : Continuous (Function.uncurry F) := by
    rw [hFcircle]
    exact lowBand_continuous_uncurry_finiteTensorCircleMultiplierField
      s qBand hqBandCompact a
  have hDcont : Continuous (Function.uncurry (fourierInvParametricField dm)) := by
    change Continuous (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv
        (fun xi => finiteTensorTubeMultiplierAngularDeriv s qBand a theta xi) y))
    exact lowBand_continuous_uncurry_fourierInv_finiteTensorAngularDeriv s qBand a
  have hderiv : ∀ theta y, HasDerivAt (fun r => F r y)
      (fourierInvParametricField dm theta y) theta := by
    intro theta y
    rw [hFcircle]
    change HasDerivAt (fun r =>
      FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s qBand hqBandCompact a
          (circleDirection r) : Euclidean 2 -> Complex) y)
      (FourierTransform.fourierInv
        (finiteTensorTubeMultiplierAngularDeriv s qBand a theta :
          Euclidean 2 -> Complex) y) theta
    exact hasDerivAt_fourierInv_scratch_finiteTensorTubeMultiplier_circle
      s qBand hqBandCompact a theta y
  have htrace :=
    integral_norm_sq_finiteTensorRadialBandAngularDeriv_le_low_source
      L s q hqcompact a hi hrTime ha
  have hDfrequency : Integrable (fun p : Real × Euclidean 2 =>
      ‖dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) := by
    change Integrable (fun p : Real × Euclidean 2 =>
      ‖finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)
    simpa only [qBand] using htrace.1
  have hDphysical : Integrable (fun p : Real × Euclidean 2 =>
      ‖fourierInvParametricField dm p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) :=
    integrable_sq_fourierInvParametricField_of_continuous_frequency dm
      (-Real.pi) Real.pi hDcont hDfrequency
  have hleft : Integrable (fun y : Euclidean 2 => ‖F (-Real.pi) y‖ ^ 2) volume := by
    rw [hFcircle]
    let M : SchwartzMap (Euclidean 2) Complex :=
      FourierTransform.fourierInv
        (scratch_finiteTensorTubeMultiplier s qBand hqBandCompact a
          (circleDirection (-Real.pi)))
    have hM : MemLp (M : Euclidean 2 -> Complex) 2 volume := M.memLp 2 volume
    have hMint : Integrable (fun y : Euclidean 2 => ‖M y‖ ^ 2) volume :=
      (memLp_two_iff_integrable_sq_norm M.continuous.aestronglyMeasurable).mp hM
    simpa only [finiteTensorCircleMultiplierField, M, SchwartzMap.fourierInv_coe]
      using hMint
  have hfreq : Integrable (fun p : Euclidean 2 × Real =>
      ‖scratch_finiteTensorTimeData s qBand a p.1 p.2‖ ^ 2)
      (volume.prod volume) :=
    integrable_sq_scratch_finiteTensorTimeData_product s qBand a
  have hE0 : (∫ y : Euclidean 2, ‖F (-Real.pi) y‖ ^ 2) ≤
      2 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi := by
    calc
      (∫ y : Euclidean 2, ‖F (-Real.pi) y‖ ^ 2) =
          ∫ xi : Euclidean 2,
            ‖scratch_finiteTensorTubeMultiplier s qBand hqBandCompact a
              (circleDirection (-Real.pi)) xi‖ ^ 2 := by
            rw [hFcircle]
            simpa only [finiteTensorCircleMultiplierField, fourierInvParametricField] using
              (integral_norm_sq_fourierInvParametricField_eq_frequency
                (fun _ : Real => scratch_finiteTensorTubeMultiplier s qBand
                  hqBandCompact a (circleDirection (-Real.pi))) (-Real.pi))
      _ ≤ 2 * finiteTensorFrequencyTimeEnergy s qBand a :=
        integral_norm_sq_scratch_finiteTensorTubeMultiplier_le_two_mul_frequencyTimeEnergy
          s qBand hqBandCompact a hrTime ha hfreq (circleDirection (-Real.pi))
      _ = 2 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi := by
        rw [finiteTensorFrequencyTimeEnergy_eq_integral_shiftedFiberSourceEnergy]
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hE1 : (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
      ‖fourierInvParametricField dm theta y‖ ^ 2) ≤
      25600 * Real.pi ^ 3 *
        ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi := by
    calc
      (∫ theta in (-Real.pi)..Real.pi, ∫ y : Euclidean 2,
        ‖fourierInvParametricField dm theta y‖ ^ 2) =
          ∫ p : Real × Euclidean 2,
            ‖fourierInvParametricField dm p.1 p.2‖ ^ 2 ∂
              ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) := by
            exact ScratchKakeyaContinuousShell.intervalIntegral_integral_eq_integral_productShell
              hpi (fun theta y => ‖fourierInvParametricField dm theta y‖ ^ 2)
              hDphysical
      _ = ∫ p : Real × Euclidean 2, ‖dm p.1 p.2‖ ^ 2 ∂
          ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume) :=
            integral_product_Icc_spatial_sq_fourierInvParametricField_eq_frequency
              dm (-Real.pi) Real.pi hDphysical hDfrequency
      _ ≤ 25600 * Real.pi ^ 3 *
          ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi := by
            change (∫ p : Real × Euclidean 2,
              ‖finiteTensorTubeMultiplierAngularDeriv s qBand a p.1 p.2‖ ^ 2 ∂
                ((volume.restrict (Icc (-Real.pi) Real.pi)).prod volume)) ≤ _
            simpa only [qBand] using htrace.2
  have hmain :=
    measurable_and_lintegral_iSup_sq_finiteTensorRadialBandPhysicalField_le_globalH1
      L s q hqcompact a i (fun theta y => fourierInvParametricField dm theta y)
      (by simpa only [F] using hFcont) hDcont
      (by
        intro theta y
        simpa only [F] using hderiv theta y)
      (by simpa only [F] using hleft) hDphysical
      (by simpa only [F] using hE0) hE1
  have hconst :
      2 * (2 * ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi) +
          4 * Real.pi *
            (25600 * Real.pi ^ 3 *
              ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi) =
        (4 + 102400 * Real.pi ^ 4) *
          ∫ xi : Euclidean 2, shiftedFiberSourceEnergy s qBand a xi := by
    ring
  simpa only [qBand, hconst] using hmain

/-- The literal `i = 0,1,2` compact-time block, in exactly the bandwise
