section

namespace Auto.Spherical.MSS.KakeyaSectorEnergyOverlap

open Finset
open Auto.Spherical.SurfaceCore
open Auto.Spherical.MSS.KakeyaSectorPartition
open scoped BigOperators EuclideanSpace

noncomputable section

/-- The radial annular cutoff used by the concrete four-chart family is a
real contraction. -/
theorem sectorAnnularCutoff_nonneg (xi : Euclidean 2) :
    0 ≤ sectorAnnularCutoff xi := by
  unfold sectorAnnularCutoff
  exact mul_nonneg (outerSectorRadialBump.nonneg' xi)
    (sub_nonneg.mpr innerSectorRadialBump.le_one)

theorem sectorAnnularCutoff_le_one (xi : Euclidean 2) :
    sectorAnnularCutoff xi ≤ 1 := by
  unfold sectorAnnularCutoff
  apply mul_le_one₀ outerSectorRadialBump.le_one
  · exact sub_nonneg.mpr innerSectorRadialBump.le_one
  · exact sub_le_self _ (innerSectorRadialBump.nonneg' xi)

theorem chartBufferedBump_nonneg (j : Fin 4) (xi : Euclidean 2) :
    0 ≤ chartBufferedBump j xi := by
  unfold chartBufferedBump bufferedSectorBump
  exact Real.smoothTransition.nonneg _

theorem chartBufferedBump_le_one (j : Fin 4) (xi : Euclidean 2) :
    chartBufferedBump j xi ≤ 1 := by
  unfold chartBufferedBump bufferedSectorBump
  exact Real.smoothTransition.le_one _

theorem one_sub_chartBufferedBump_nonneg (j : Fin 4) (xi : Euclidean 2) :
    0 ≤ 1 - chartBufferedBump j xi :=
  sub_nonneg.mpr (chartBufferedBump_le_one j xi)

theorem one_sub_chartBufferedBump_le_one (j : Fin 4) (xi : Euclidean 2) :
    1 - chartBufferedBump j xi ≤ 1 :=
  sub_le_self _ (chartBufferedBump_nonneg j xi)

/-- Ordered sector weights retain the elementary `[0,1]` bounds of the
underlying smooth transition factors. -/
theorem chartOrderedWeight_nonneg (j : Fin 4) (xi : Euclidean 2) :
    0 ≤ chartOrderedWeight j xi := by
  fin_cases j
  · simpa [chartOrderedWeight] using chartBufferedBump_nonneg 0 xi
  · exact mul_nonneg (one_sub_chartBufferedBump_nonneg 0 xi)
      (chartBufferedBump_nonneg 1 xi)
  · exact mul_nonneg
      (mul_nonneg (one_sub_chartBufferedBump_nonneg 0 xi)
        (one_sub_chartBufferedBump_nonneg 1 xi))
      (chartBufferedBump_nonneg 2 xi)
  · exact mul_nonneg
      (mul_nonneg
        (mul_nonneg (one_sub_chartBufferedBump_nonneg 0 xi)
          (one_sub_chartBufferedBump_nonneg 1 xi))
        (one_sub_chartBufferedBump_nonneg 2 xi))
      (chartBufferedBump_nonneg 3 xi)

theorem chartOrderedWeight_le_one (j : Fin 4) (xi : Euclidean 2) :
    chartOrderedWeight j xi ≤ 1 := by
  fin_cases j
  · simpa [chartOrderedWeight] using chartBufferedBump_le_one 0 xi
  · exact mul_le_one₀ (one_sub_chartBufferedBump_le_one 0 xi)
      (chartBufferedBump_nonneg 1 xi) (chartBufferedBump_le_one 1 xi)
  · apply mul_le_one₀
    · exact mul_le_one₀ (one_sub_chartBufferedBump_le_one 0 xi)
        (one_sub_chartBufferedBump_nonneg 1 xi)
        (one_sub_chartBufferedBump_le_one 1 xi)
    · exact chartBufferedBump_nonneg 2 xi
    · exact chartBufferedBump_le_one 2 xi
  · apply mul_le_one₀
    · apply mul_le_one₀
      · exact mul_le_one₀ (one_sub_chartBufferedBump_le_one 0 xi)
          (one_sub_chartBufferedBump_nonneg 1 xi)
          (one_sub_chartBufferedBump_le_one 1 xi)
      · exact one_sub_chartBufferedBump_nonneg 2 xi
      · exact one_sub_chartBufferedBump_le_one 2 xi
    · exact chartBufferedBump_nonneg 3 xi
    · exact chartBufferedBump_le_one 3 xi

theorem norm_chartAnnularMultiplier_le_one (j : Fin 4) (xi : Euclidean 2) :
    ‖chartAnnularMultiplier j xi‖ ≤ 1 := by
  unfold chartAnnularMultiplier
  rw [norm_mul, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg (sectorAnnularCutoff_nonneg xi),
    Real.norm_of_nonneg (chartOrderedWeight_nonneg j xi)]
  exact mul_le_one₀ (sectorAnnularCutoff_le_one xi)
    (chartOrderedWeight_nonneg j xi) (chartOrderedWeight_le_one j xi)

theorem norm_chartAnnularMultiplierSchwartz_le_one (j : Fin 4) (xi : Euclidean 2) :
    ‖chartAnnularMultiplierSchwartz j xi‖ ≤ 1 := by
  rw [chartAnnularMultiplierSchwartz_apply]
  exact norm_chartAnnularMultiplier_le_one j xi

/-- The four concrete chart multipliers have a uniform pointwise square
overlap bound.  This is the frequency-side input for summing chart E0/E1
energies after Plancherel. -/
theorem sum_norm_sq_chartAnnularMultiplierSchwartz_le_four (xi : Euclidean 2) :
    ∑ j : Fin 4, ‖chartAnnularMultiplierSchwartz j xi‖ ^ 2 ≤ 4 := by
  calc
    ∑ j : Fin 4, ‖chartAnnularMultiplierSchwartz j xi‖ ^ 2 ≤
        ∑ _j : Fin 4, (1 : Real) := by
          apply Finset.sum_le_sum
          intro j _
          have hj := norm_chartAnnularMultiplierSchwartz_le_one j xi
          nlinarith [norm_nonneg (chartAnnularMultiplierSchwartz j xi)]
    _ = 4 := by norm_num

/-- Pointwise energy form of finite chart overlap. -/
theorem sum_norm_sq_chartAnnularMultiplierSchwartz_mul_le_four
    (xi : Euclidean 2) (z : Complex) :
    ∑ j : Fin 4, ‖chartAnnularMultiplierSchwartz j xi * z‖ ^ 2 ≤
      4 * ‖z‖ ^ 2 := by
  calc
    ∑ j : Fin 4, ‖chartAnnularMultiplierSchwartz j xi * z‖ ^ 2 =
        (∑ j : Fin 4, ‖chartAnnularMultiplierSchwartz j xi‖ ^ 2) * ‖z‖ ^ 2 := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro j _
          rw [norm_mul, mul_pow]
    _ ≤ 4 * ‖z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right
        (sum_norm_sq_chartAnnularMultiplierSchwartz_le_four xi) (sq_nonneg _)

end

end Auto.Spherical.MSS.KakeyaSectorEnergyOverlap
end
-- END ScratchKakeyaSectorEnergyOverlap

