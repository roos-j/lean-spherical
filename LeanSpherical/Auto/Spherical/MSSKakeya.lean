namespace Auto.Spherical.MSS.KakeyaNormalizedTelescopingLobes

open Filter Set
open Auto.Spherical.MSS.KakeyaTelescopingOuterNormalization
open Auto.Spherical.MSS.KakeyaTelescopingShellPartition
open Auto.Spherical.MSS.KakeyaGenericOuterProfileSchur

noncomputable section

/-- The smooth sign gate changes only on `[-5/8,5/8]`, where the normalized
telescoping profile is already zero. -/
noncomputable def normalizedTelescopingPositiveGate (v : Real) : Real :=
  Real.smoothTransition ((4 / 5 : Real) * (v + 5 / 8))

noncomputable def normalizedTelescopingPositiveLobe (v : Real) : Real :=
  normalizedTelescopingPositiveGate v * normalizedTelescopingOuterProfile v

noncomputable def normalizedTelescopingNegativeLobe (v : Real) : Real :=
  (1 - normalizedTelescopingPositiveGate v) * normalizedTelescopingOuterProfile v

/-- The negative lobe transported to the positive standard outer interval.
It is the form to which the existing positive-shell circle IBP machinery is
applied after reflecting the angular coordinate. -/
noncomputable def normalizedTelescopingReflectedNegativeLobe (v : Real) : Real :=
  normalizedTelescopingNegativeLobe (-v)

theorem normalizedTelescopingPositiveGate_eq_zero_of_le_neg_five_eighth
    {v : Real} (hv : v ≤ -(5 / 8 : Real)) :
    normalizedTelescopingPositiveGate v = 0 := by
  unfold normalizedTelescopingPositiveGate
  rw [Real.smoothTransition.zero_of_nonpos]
  nlinarith

theorem normalizedTelescopingPositiveGate_eq_one_of_five_eighth_le
    {v : Real} (hv : (5 / 8 : Real) ≤ v) :
    normalizedTelescopingPositiveGate v = 1 := by
  unfold normalizedTelescopingPositiveGate
  rw [Real.smoothTransition.one_of_one_le]
  nlinarith

theorem contDiff_normalizedTelescopingPositiveGate :
    ContDiff Real (⊤ : ℕ∞) normalizedTelescopingPositiveGate := by
  unfold normalizedTelescopingPositiveGate
  exact Real.smoothTransition.contDiff.comp
    (contDiff_const.mul (contDiff_id.add contDiff_const))

theorem normalizedTelescopingOuterProfile_eq_positive_add_negative (v : Real) :
    normalizedTelescopingOuterProfile v =
      normalizedTelescopingPositiveLobe v + normalizedTelescopingNegativeLobe v := by
  unfold normalizedTelescopingPositiveLobe normalizedTelescopingNegativeLobe
  ring

theorem contDiff_normalizedTelescopingPositiveLobe :
    ContDiff Real (⊤ : ℕ∞) normalizedTelescopingPositiveLobe := by
  unfold normalizedTelescopingPositiveLobe
  exact contDiff_normalizedTelescopingPositiveGate.mul
    contDiff_normalizedTelescopingOuterProfile

theorem contDiff_normalizedTelescopingNegativeLobe :
    ContDiff Real (⊤ : ℕ∞) normalizedTelescopingNegativeLobe := by
  unfold normalizedTelescopingNegativeLobe
  exact (contDiff_const.sub contDiff_normalizedTelescopingPositiveGate).mul
    contDiff_normalizedTelescopingOuterProfile

theorem contDiff_normalizedTelescopingReflectedNegativeLobe :
    ContDiff Real (⊤ : ℕ∞) normalizedTelescopingReflectedNegativeLobe := by
  unfold normalizedTelescopingReflectedNegativeLobe
  exact contDiff_normalizedTelescopingNegativeLobe.comp contDiff_neg

theorem normalizedTelescopingPositiveLobe_eq_zero_of_le_five_eighth
    {v : Real} (hv : v ≤ (5 / 8 : Real)) :
    normalizedTelescopingPositiveLobe v = 0 := by
  by_cases hneg : v ≤ -(5 / 8 : Real)
  · unfold normalizedTelescopingPositiveLobe
    rw [normalizedTelescopingPositiveGate_eq_zero_of_le_neg_five_eighth hneg]
    ring
  · have habs : |v| ≤ (5 / 8 : Real) := by
      rw [abs_le]
      constructor <;> linarith
    unfold normalizedTelescopingPositiveLobe
    rw [normalizedTelescopingOuterProfile_eq_zero_of_abs_le_five_eighth habs]
    ring

theorem normalizedTelescopingPositiveLobe_eq_zero_of_fifteen_eighth_le
    {v : Real} (hv : (15 / 8 : Real) ≤ v) :
    normalizedTelescopingPositiveLobe v = 0 := by
  unfold normalizedTelescopingPositiveLobe
  rw [normalizedTelescopingOuterProfile_eq_zero_of_fifteen_eighth_le]
  · ring
  · rw [abs_of_nonneg]
    · exact hv
    · linarith

theorem normalizedTelescopingNegativeLobe_eq_zero_of_le_neg_fifteen_eighth
    {v : Real} (hv : v ≤ -(15 / 8 : Real)) :
    normalizedTelescopingNegativeLobe v = 0 := by
  unfold normalizedTelescopingNegativeLobe
  rw [normalizedTelescopingOuterProfile_eq_zero_of_fifteen_eighth_le]
  · ring
  · rw [abs_of_nonpos]
    · linarith
    · linarith

theorem normalizedTelescopingNegativeLobe_eq_zero_of_neg_five_eighth_le
    {v : Real} (hv : -(5 / 8 : Real) ≤ v) :
    normalizedTelescopingNegativeLobe v = 0 := by
  by_cases hlarge : (5 / 8 : Real) ≤ v
  · unfold normalizedTelescopingNegativeLobe
    rw [normalizedTelescopingPositiveGate_eq_one_of_five_eighth_le hlarge]
    ring
  · have habs : |v| ≤ (5 / 8 : Real) := by
      rw [abs_le]
      constructor <;> linarith
    unfold normalizedTelescopingNegativeLobe
    rw [normalizedTelescopingOuterProfile_eq_zero_of_abs_le_five_eighth habs]
    ring

theorem normalizedTelescopingReflectedNegativeLobe_eq_zero_of_le_five_eighth
    {v : Real} (hv : v ≤ (5 / 8 : Real)) :
    normalizedTelescopingReflectedNegativeLobe v = 0 := by
  unfold normalizedTelescopingReflectedNegativeLobe
  apply normalizedTelescopingNegativeLobe_eq_zero_of_neg_five_eighth_le
  linarith

theorem normalizedTelescopingReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le
    {v : Real} (hv : (15 / 8 : Real) ≤ v) :
    normalizedTelescopingReflectedNegativeLobe v = 0 := by
  unfold normalizedTelescopingReflectedNegativeLobe
  apply normalizedTelescopingNegativeLobe_eq_zero_of_le_neg_fifteen_eighth
  linarith

theorem normalizedTelescopingPositiveLobe_eventuallyEq_zero_left :
    normalizedTelescopingPositiveLobe =ᶠ[nhds (1 / 2 : Real)] 0 := by
  filter_upwards [Iio_mem_nhds (by norm_num : (1 / 2 : Real) < 5 / 8)] with v hv
  exact normalizedTelescopingPositiveLobe_eq_zero_of_le_five_eighth hv.le

theorem normalizedTelescopingPositiveLobe_eventuallyEq_zero_right :
    normalizedTelescopingPositiveLobe =ᶠ[nhds 2] 0 := by
  filter_upwards [Ioi_mem_nhds (by norm_num : (15 / 8 : Real) < 2)] with v hv
  exact normalizedTelescopingPositiveLobe_eq_zero_of_fifteen_eighth_le hv.le

theorem normalizedTelescopingReflectedNegativeLobe_eventuallyEq_zero_left :
    normalizedTelescopingReflectedNegativeLobe =ᶠ[nhds (1 / 2 : Real)] 0 := by
  filter_upwards [Iio_mem_nhds (by norm_num : (1 / 2 : Real) < 5 / 8)] with v hv
  exact normalizedTelescopingReflectedNegativeLobe_eq_zero_of_le_five_eighth hv.le

theorem normalizedTelescopingReflectedNegativeLobe_eventuallyEq_zero_right :
    normalizedTelescopingReflectedNegativeLobe =ᶠ[nhds 2] 0 := by
  filter_upwards [Ioi_mem_nhds (by norm_num : (15 / 8 : Real) < 2)] with v hv
  exact normalizedTelescopingReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le hv.le

theorem hasCompactSupport_normalizedTelescopingPositiveLobe :
    HasCompactSupport normalizedTelescopingPositiveLobe := by
  apply HasCompactSupport.intro
    (isCompact_Icc : IsCompact (Icc (5 / 8 : Real) (15 / 8 : Real)))
  intro v hv
  by_cases hleft : v ≤ (5 / 8 : Real)
  · exact normalizedTelescopingPositiveLobe_eq_zero_of_le_five_eighth hleft
  · apply normalizedTelescopingPositiveLobe_eq_zero_of_fifteen_eighth_le
    apply le_of_not_gt
    intro hright
    apply hv
    exact ⟨le_of_not_ge hleft, hright.le⟩

theorem hasCompactSupport_normalizedTelescopingReflectedNegativeLobe :
    HasCompactSupport normalizedTelescopingReflectedNegativeLobe := by
  apply HasCompactSupport.intro
    (isCompact_Icc : IsCompact (Icc (5 / 8 : Real) (15 / 8 : Real)))
  intro v hv
  by_cases hleft : v ≤ (5 / 8 : Real)
  · exact normalizedTelescopingReflectedNegativeLobe_eq_zero_of_le_five_eighth hleft
  · apply normalizedTelescopingReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le
    apply le_of_not_gt
    intro hright
    apply hv
    exact ⟨le_of_not_ge hleft, hright.le⟩

/-- The actual normalized telescope shell is a sum of the two signed lobes.
The second lobe may equivalently be read through its positive reflection. -/
theorem telescopingShellCutoff_succ_eq_normalizedLobes
    (eps : Real) (k : Nat) {r : Real}
    (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps)) (u : Real) :
    telescopingShellCutoff eps (k + 1) u =
      normalizedTelescopingPositiveLobe (u / r) +
        normalizedTelescopingNegativeLobe (u / r) := by
  rw [telescopingShellCutoff_succ_eq_normalizedOuterProfile eps k hr u]
  exact normalizedTelescopingOuterProfile_eq_positive_add_negative (u / r)

end

end Auto.Spherical.MSS.KakeyaNormalizedTelescopingLobes
end
-- END ScratchKakeyaNormalizedTelescopingLobes

-- BEGIN ScratchKakeyaCappedTelescopingLobes
section

namespace Auto.Spherical.MSS.KakeyaCappedTelescopingLobes

open Filter Set
open Auto.Spherical.MSS.KakeyaSmoothShellPartition
open Auto.Spherical.MSS.KakeyaCappedTelescopingPartition
open Auto.Spherical.MSS.KakeyaGenericOuterProfileSchur
open ScratchKakeyaTTStarAngular

noncomputable section

/-- A smooth cutoff equal to one throughout the admissible capped-ratio
interval `[1/2,1]`, and supported inside the positive half-line. -/
noncomputable def cappedRatioGuard : ContDiffBump (3 / 4 : Real) :=
  ⟨(1 : Real) / 4, (3 : Real) / 8, by norm_num, by norm_num⟩

/-- A globally smooth positive extension of the ratio parameter.  It agrees
with the actual ratio on `[1/2,1]`, while avoiding a fake singularity at
`c = 0` outside the only range used by the cap. -/
noncomputable def safeCappedRatio (c : Real) : Real :=
  cappedRatioGuard c * c + (1 - cappedRatioGuard c) * 1

theorem contDiff_safeCappedRatio :
    ContDiff Real (⊤ : ℕ∞) safeCappedRatio := by
  unfold safeCappedRatio
  exact (cappedRatioGuard.contDiff.mul contDiff_id).add
    ((contDiff_const.sub cappedRatioGuard.contDiff).mul contDiff_const)

theorem safeCappedRatio_eq_of_mem_Icc {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    safeCappedRatio c = c := by
  have hmem : c ∈ Metric.closedBall (3 / 4 : Real) (1 / 4 : Real) := by
    rw [Metric.mem_closedBall, Real.dist_eq, abs_le]
    constructor <;> linarith [hc.1, hc.2]
  have hguard : cappedRatioGuard c = 1 :=
    cappedRatioGuard.one_of_mem_closedBall hmem
  simp [safeCappedRatio, hguard]

theorem safeCappedRatio_pos (c : Real) : 0 < safeCappedRatio c := by
  by_cases hzero : cappedRatioGuard c = 0
  · simp [safeCappedRatio, hzero]
  · have hdist : dist c (3 / 4 : Real) < 3 / 8 := by
      apply lt_of_not_ge
      intro hdist
      exact hzero (cappedRatioGuard.zero_of_le_dist hdist)
    rw [Real.dist_eq, abs_lt] at hdist
    have hcpos : 0 < c := by linarith [hdist.1]
    have hgpos : 0 < cappedRatioGuard c :=
      lt_of_le_of_ne cappedRatioGuard.nonneg (Ne.symm hzero)
    have hfirst : 0 < cappedRatioGuard c * c := mul_pos hgpos hcpos
    have hsecond : 0 ≤ (1 - cappedRatioGuard c) * 1 :=
      mul_nonneg (sub_nonneg.mpr cappedRatioGuard.le_one) (by norm_num)
    unfold safeCappedRatio
    linarith

theorem safeCappedRatio_ne_zero (c : Real) : safeCappedRatio c ≠ 0 :=
  (safeCappedRatio_pos c).ne'

/-- The cap profile extended smoothly in the compact ratio parameter. -/
noncomputable def safeCappedTerminalUnitProfile (c v : Real) : Real :=
  smoothCentralShellBump (v / 5) -
    smoothCentralShellBump (v / (5 * safeCappedRatio c))

theorem safeCappedTerminalUnitProfile_eq_cappedTerminalUnitProfile
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    safeCappedTerminalUnitProfile c v = cappedTerminalUnitProfile c v := by
  unfold safeCappedTerminalUnitProfile cappedTerminalUnitProfile
  rw [safeCappedRatio_eq_of_mem_Icc hc]

theorem contDiff_safeCappedTerminalUnitProfile_joint :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => safeCappedTerminalUnitProfile p.1 p.2) := by
  unfold safeCappedTerminalUnitProfile
  have hden : ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => 5 * safeCappedRatio p.1) :=
    contDiff_const.mul (contDiff_safeCappedRatio.comp contDiff_fst)
  have hdenne : ∀ p : Real × Real, 5 * safeCappedRatio p.1 ≠ 0 := by
    intro p
    exact mul_ne_zero (by norm_num) (safeCappedRatio_ne_zero p.1)
  exact (smoothCentralShellBump.contDiff.comp (contDiff_snd.div_const 5)).sub
    (smoothCentralShellBump.contDiff.comp (contDiff_snd.div hden hdenne))

theorem hasJointSndSmooth_safeCappedTerminalUnitProfile (n : Nat) :
    HasJointSndSmooth n
      (fun p : Real × Real => (safeCappedTerminalUnitProfile p.1 p.2 : Complex)) := by
  apply hasJointSndSmooth_of_contDiff
  change ContDiff Real (⊤ : ℕ∞)
    (Complex.ofRealCLM ∘ fun p : Real × Real => safeCappedTerminalUnitProfile p.1 p.2)
  exact Complex.ofRealCLM.contDiff.comp contDiff_safeCappedTerminalUnitProfile_joint

theorem safeCappedTerminalUnitProfile_eq_zero_of_abs_le_five_eighth
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : |v| ≤ 5 / 8) : safeCappedTerminalUnitProfile c v = 0 := by
  rw [safeCappedTerminalUnitProfile_eq_cappedTerminalUnitProfile hc]
  exact cappedTerminalUnitProfile_eq_zero_of_abs_le_five_eighth hc.1 hv

/-- The outer endpoint is uniform over the whole bounded ratio family. -/
theorem safeCappedTerminalUnitProfile_eq_zero_of_fifteen_eighth_le
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : 15 / 8 ≤ |v|) : safeCappedTerminalUnitProfile c v = 0 := by
  rw [safeCappedTerminalUnitProfile_eq_cappedTerminalUnitProfile hc]
  unfold cappedTerminalUnitProfile
  have hfirst : (3 / 8 : Real) ≤ dist (v / 5) 0 := by
    rw [Real.dist_eq, sub_zero, abs_div]
    norm_num
    nlinarith
  have hsecond : (3 / 8 : Real) ≤ dist (v / (5 * c)) 0 := by
    have hden : 0 < 5 * c := by nlinarith [hc.1]
    rw [Real.dist_eq, sub_zero, abs_div, abs_of_nonneg hden.le]
    rw [le_div_iff₀ hden]
    nlinarith [hc.2]
  rw [smoothCentralShellBump.zero_of_le_dist hfirst,
    smoothCentralShellBump.zero_of_le_dist hsecond]
  ring

/-- The fixed smooth sign gate changes only where every permitted capped
profile is already zero. -/
noncomputable def cappedTerminalPositiveGate (v : Real) : Real :=
  Real.smoothTransition ((4 / 5 : Real) * (v + 5 / 8))

noncomputable def safeCappedTerminalPositiveLobe (c v : Real) : Real :=
  cappedTerminalPositiveGate v * safeCappedTerminalUnitProfile c v

noncomputable def safeCappedTerminalNegativeLobe (c v : Real) : Real :=
  (1 - cappedTerminalPositiveGate v) * safeCappedTerminalUnitProfile c v

noncomputable def safeCappedTerminalReflectedNegativeLobe (c v : Real) : Real :=
  safeCappedTerminalNegativeLobe c (-v)

theorem cappedTerminalPositiveGate_eq_zero_of_le_neg_five_eighth
    {v : Real} (hv : v ≤ -(5 / 8 : Real)) : cappedTerminalPositiveGate v = 0 := by
  unfold cappedTerminalPositiveGate
  rw [Real.smoothTransition.zero_of_nonpos]
  nlinarith

theorem cappedTerminalPositiveGate_eq_one_of_five_eighth_le
    {v : Real} (hv : (5 / 8 : Real) ≤ v) : cappedTerminalPositiveGate v = 1 := by
  unfold cappedTerminalPositiveGate
  rw [Real.smoothTransition.one_of_one_le]
  nlinarith

theorem contDiff_cappedTerminalPositiveGate :
    ContDiff Real (⊤ : ℕ∞) cappedTerminalPositiveGate := by
  unfold cappedTerminalPositiveGate
  exact Real.smoothTransition.contDiff.comp
    (contDiff_const.mul (contDiff_id.add contDiff_const))

theorem contDiff_safeCappedTerminalPositiveLobe_joint :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => safeCappedTerminalPositiveLobe p.1 p.2) := by
  unfold safeCappedTerminalPositiveLobe
  exact (contDiff_cappedTerminalPositiveGate.comp contDiff_snd).mul
    contDiff_safeCappedTerminalUnitProfile_joint

theorem contDiff_safeCappedTerminalNegativeLobe_joint :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => safeCappedTerminalNegativeLobe p.1 p.2) := by
  unfold safeCappedTerminalNegativeLobe
  exact (contDiff_const.sub
    (contDiff_cappedTerminalPositiveGate.comp contDiff_snd)).mul
      contDiff_safeCappedTerminalUnitProfile_joint

theorem contDiff_safeCappedTerminalReflectedNegativeLobe_joint :
    ContDiff Real (⊤ : ℕ∞)
      (fun p : Real × Real => safeCappedTerminalReflectedNegativeLobe p.1 p.2) := by
  unfold safeCappedTerminalReflectedNegativeLobe
  exact contDiff_safeCappedTerminalNegativeLobe_joint.comp
    (contDiff_fst.prodMk (contDiff_neg.comp contDiff_snd))

theorem safeCappedTerminalUnitProfile_eq_positive_add_negative
    (c v : Real) :
    safeCappedTerminalUnitProfile c v =
      safeCappedTerminalPositiveLobe c v + safeCappedTerminalNegativeLobe c v := by
  unfold safeCappedTerminalPositiveLobe safeCappedTerminalNegativeLobe
  ring

theorem safeCappedTerminalPositiveLobe_eq_zero_of_le_five_eighth
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : v ≤ 5 / 8) : safeCappedTerminalPositiveLobe c v = 0 := by
  by_cases hneg : v ≤ -(5 / 8 : Real)
  · unfold safeCappedTerminalPositiveLobe
    rw [cappedTerminalPositiveGate_eq_zero_of_le_neg_five_eighth hneg]
    ring
  · have habs : |v| ≤ 5 / 8 := by
      rw [abs_le]
      constructor <;> linarith
    unfold safeCappedTerminalPositiveLobe
    rw [safeCappedTerminalUnitProfile_eq_zero_of_abs_le_five_eighth hc habs]
    ring

theorem safeCappedTerminalPositiveLobe_eq_zero_of_fifteen_eighth_le
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : 15 / 8 ≤ v) : safeCappedTerminalPositiveLobe c v = 0 := by
  unfold safeCappedTerminalPositiveLobe
  rw [safeCappedTerminalUnitProfile_eq_zero_of_fifteen_eighth_le hc]
  · ring
  · rw [abs_of_nonneg]
    · exact hv
    · linarith

theorem safeCappedTerminalReflectedNegativeLobe_eq_zero_of_le_five_eighth
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : v ≤ 5 / 8) : safeCappedTerminalReflectedNegativeLobe c v = 0 := by
  unfold safeCappedTerminalReflectedNegativeLobe safeCappedTerminalNegativeLobe
  by_cases hlarge : (5 / 8 : Real) ≤ -v
  · rw [cappedTerminalPositiveGate_eq_one_of_five_eighth_le hlarge]
    ring
  · have habs : |-v| ≤ 5 / 8 := by
      rw [abs_le]
      constructor <;> linarith
    rw [safeCappedTerminalUnitProfile_eq_zero_of_abs_le_five_eighth hc habs]
    ring

theorem safeCappedTerminalReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le
    {c v : Real} (hc : c ∈ Icc (1 / 2 : Real) 1)
    (hv : 15 / 8 ≤ v) : safeCappedTerminalReflectedNegativeLobe c v = 0 := by
  unfold safeCappedTerminalReflectedNegativeLobe
  unfold safeCappedTerminalNegativeLobe
  rw [safeCappedTerminalUnitProfile_eq_zero_of_fifteen_eighth_le hc]
  · ring
  · rw [abs_of_nonpos]
    · linarith
    · linarith

/-- The self-conjugate product amplitude consumed by the generic fixed-shell
Schur package for the positive capped lobe. -/
noncomputable def safeCappedTerminalPositiveProductAmplitude
    (p : Real × Real) : Complex :=
  ((safeCappedTerminalPositiveLobe p.1 p.2) ^ 2 : Real)

noncomputable def safeCappedTerminalReflectedNegativeProductAmplitude
    (p : Real × Real) : Complex :=
  ((safeCappedTerminalReflectedNegativeLobe p.1 p.2) ^ 2 : Real)

theorem contDiff_safeCappedTerminalPositiveProductAmplitude :
    ContDiff Real (⊤ : ℕ∞) safeCappedTerminalPositiveProductAmplitude := by
  unfold safeCappedTerminalPositiveProductAmplitude
  exact Complex.ofRealCLM.contDiff.comp
    (contDiff_safeCappedTerminalPositiveLobe_joint.pow 2)

theorem contDiff_safeCappedTerminalReflectedNegativeProductAmplitude :
    ContDiff Real (⊤ : ℕ∞) safeCappedTerminalReflectedNegativeProductAmplitude := by
  unfold safeCappedTerminalReflectedNegativeProductAmplitude
  exact Complex.ofRealCLM.contDiff.comp
    (contDiff_safeCappedTerminalReflectedNegativeLobe_joint.pow 2)

theorem hasJointSndSmooth_safeCappedTerminalPositiveProductAmplitude (n : Nat) :
    HasJointSndSmooth n safeCappedTerminalPositiveProductAmplitude := by
  apply hasJointSndSmooth_of_contDiff
  exact contDiff_safeCappedTerminalPositiveProductAmplitude

theorem hasJointSndSmooth_safeCappedTerminalReflectedNegativeProductAmplitude
    (n : Nat) :
    HasJointSndSmooth n safeCappedTerminalReflectedNegativeProductAmplitude := by
  apply hasJointSndSmooth_of_contDiff
  exact contDiff_safeCappedTerminalReflectedNegativeProductAmplitude

theorem star_safeCappedTerminalPositiveProductAmplitude (p : Real × Real) :
    starRingEnd Complex (safeCappedTerminalPositiveProductAmplitude p) =
      safeCappedTerminalPositiveProductAmplitude p := by
  simp [safeCappedTerminalPositiveProductAmplitude]

theorem star_safeCappedTerminalReflectedNegativeProductAmplitude
    (p : Real × Real) :
    starRingEnd Complex (safeCappedTerminalReflectedNegativeProductAmplitude p) =
      safeCappedTerminalReflectedNegativeProductAmplitude p := by
  simp [safeCappedTerminalReflectedNegativeProductAmplitude]

theorem safeCappedTerminalPositiveProductAmplitude_eventuallyEq_zero_left
    {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => safeCappedTerminalPositiveProductAmplitude (c, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [Iio_mem_nhds (by norm_num : (1 / 2 : Real) < 5 / 8)] with u hu
  simp [safeCappedTerminalPositiveProductAmplitude,
    safeCappedTerminalPositiveLobe_eq_zero_of_le_five_eighth hc hu.le]

theorem safeCappedTerminalPositiveProductAmplitude_eventuallyEq_zero_right
    {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => safeCappedTerminalPositiveProductAmplitude (c, u)) =ᶠ[nhds 2] 0 := by
  filter_upwards [Ioi_mem_nhds (by norm_num : (15 / 8 : Real) < 2)] with u hu
  simp [safeCappedTerminalPositiveProductAmplitude,
    safeCappedTerminalPositiveLobe_eq_zero_of_fifteen_eighth_le hc hu.le]

theorem safeCappedTerminalReflectedNegativeProductAmplitude_eventuallyEq_zero_left
    {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => safeCappedTerminalReflectedNegativeProductAmplitude (c, u)) =ᶠ[
      nhds (1 / 2 : Real)] 0 := by
  filter_upwards [Iio_mem_nhds (by norm_num : (1 / 2 : Real) < 5 / 8)] with u hu
  simp [safeCappedTerminalReflectedNegativeProductAmplitude,
    safeCappedTerminalReflectedNegativeLobe_eq_zero_of_le_five_eighth hc hu.le]

theorem safeCappedTerminalReflectedNegativeProductAmplitude_eventuallyEq_zero_right
    {c : Real} (hc : c ∈ Icc (1 / 2 : Real) 1) :
    (fun u : Real => safeCappedTerminalReflectedNegativeProductAmplitude (c, u)) =ᶠ[nhds 2] 0 := by
  filter_upwards [Ioi_mem_nhds (by norm_num : (15 / 8 : Real) < 2)] with u hu
  simp [safeCappedTerminalReflectedNegativeProductAmplitude,
    safeCappedTerminalReflectedNegativeLobe_eq_zero_of_fifteen_eighth_le hc hu.le]

end

end Auto.Spherical.MSS.KakeyaCappedTelescopingLobes
end
-- END ScratchKakeyaCappedTelescopingLobes

