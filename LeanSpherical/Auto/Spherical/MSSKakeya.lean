  let M : Real -> Complex := fun theta =>
    scratch_finiteTensorTubeMultiplier s (C.chartProfiles j q)
      (C.chartProfiles_compact j q hqcompact) a (circleDirection theta) xi
  let H : Real -> Complex := scratch_finiteTensorTimeData s (C.chartProfiles j q) a xi
  have hrpos : 0 < r := by
    rw [hr]
    have : 0 < Real.pi := Real.pi_pos
    positivity
  have hMcont : Continuous M := by
    let F : Real × Euclidean 2 -> Complex := fun p =>
      scratch_finiteTensorTubeMultiplier s (C.chartProfiles j q)
        (C.chartProfiles_compact j q hqcompact) a (circleDirection p.1) p.2
    have hF : Continuous F :=
      continuous_uncurry_scratch_finiteTensorTubeMultiplier_circle
        s (C.chartProfiles j q) (C.chartProfiles_compact j q hqcompact) a
    have hmap : Continuous (fun theta : Real => (theta, xi)) :=
      continuous_id.prodMk continuous_const
    change Continuous (fun theta : Real => F (theta, xi))
    exact (hF.comp hmap).congr (by intro theta; rfl)
  have hraw (theta : Real) :
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (K + 1)
        theta xi =
        (shiftedCappedTerminalPositiveProfile n ratio
          (r, (theta - c) / r) : Complex) * M theta +
        (shiftedCappedTerminalReflectedNegativeProfile n ratio
          (r, (c - theta) / r) : Complex) * M theta := by
    simpa only [c, M] using
      (shiftedCharted_terminalMultiplier_eq_affine_plus_reflected
        C j s q hqcompact a K n theta xi hratio hratioDef hr)
  have hplus (u : Real) :
      (shiftedCappedTerminalPositiveProfile n ratio (r, u) : Complex) * M (c + r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalPositiveProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) H u := by
    simpa only [c, M, H] using
      (shiftedCharted_lobeMultiplier_eq_parametricAnalysis
        C j s q hqcompact a xi (C.angle j xi) hpolar n hn
        (shiftedCappedTerminalPositiveProfile n ratio) r u)
  have hminus (u : Real) :
      (shiftedCappedTerminalReflectedNegativeProfile n ratio (r, u) : Complex) *
        M (c - r * u) =
        ttstarAnalysis volume
          (outerCircleParametricRealProfileFourierCharAnalysisAmplitude
            (shiftedCappedTerminalReflectedNegativeProfile n ratio) r
            (stationaryRadialSign n * ‖xi‖)) H u := by
    simpa only [c, M, H] using
      (shiftedCharted_reflectedLobeMultiplier_eq_parametricAnalysis
        C j s q hqcompact a xi (C.angle j xi) hpolar n hn
        (shiftedCappedTerminalReflectedNegativeProfile n ratio) r u)
  have hgeneric := shellFrequencyEnergy_le_two_affine_ttstar_lobes
    (fun theta => shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n
      (K + 1) theta xi) M H
    (shiftedCappedTerminalPositiveProfile n ratio)
    (shiftedCappedTerminalReflectedNegativeProfile n ratio)
    r c lo hi (stationaryRadialSign n * ‖xi‖) hrpos hMcont
    (contDiff_shiftedCappedTerminalPositiveProfile n ratio).continuous
    (contDiff_shiftedCappedTerminalReflectedNegativeProfile n ratio).continuous
    (fun u hu => shiftedCappedTerminalPositiveProfile_eq_zero_of_not_mem_Icc
      n ratio r u hratio hu)
    (fun u hu => shiftedCappedTerminalReflectedNegativeProfile_eq_zero_of_not_mem_Icc
      n ratio r u hratio hu)
