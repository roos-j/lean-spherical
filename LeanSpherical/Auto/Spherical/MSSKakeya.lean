/-- The literal central telescope is the fixed central TT* bump after the
natural angular rescaling `v = 4 * eps * u`. -/
theorem smoothCentralShellCutoff_rescaled_eq_fixedCentralAmplitude
    {eps : Real} (heps : eps ≠ 0) (u : Real) :
    (smoothCentralShellCutoff eps (4 * eps * u) : Complex) =
      fixedCentralCircleUnitShellAmplitude u := by
  have hratio : (4 * eps * u) / (4 * eps) = u := by
    field_simp [heps]
  unfold smoothCentralShellCutoff fixedCentralCircleUnitShellAmplitude
  rw [hratio]
  rfl

/-- Real-valued version of the central rescaling identity. -/
theorem smoothCentralShellCutoff_rescaled_eq_fixedCentralBump
    {eps : Real} (heps : eps ≠ 0) (u : Real) :
    smoothCentralShellCutoff eps (4 * eps * u) =
      (fixedCentralCircleUnitShellBump u : Real) := by
  have hratio : (4 * eps * u) / (4 * eps) = u := by
    field_simp [heps]
  unfold smoothCentralShellCutoff
  rw [hratio]
  rfl

end

