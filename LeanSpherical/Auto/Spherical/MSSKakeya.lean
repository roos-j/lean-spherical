theorem periodic_finiteTensorCircleMultiplierField
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (y : Euclidean 2) :
    Function.Periodic
  (fun theta => finiteTensorCircleMultiplierField s q hqcompact a theta y)
      (2 * Real.pi) := by
  intro theta
  change FourierTransform.fourierInv (fun xi =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a
        (circleDirection (theta + 2 * Real.pi)) xi) y =
    FourierTransform.fourierInv (fun xi =>
      scratch_finiteTensorTubeMultiplier s q hqcompact a (circleDirection theta) xi) y
  rw [circleDirection_periodic]

/-- The literal circle supremum of a finite tensor is controlled by its
centred fundamental interval.  This is the form consumed by the seven-shift
stationary cover. -/
theorem iSup_sq_finiteTensorCircleMultiplierField_le_centeredFundamental
    {iota : Type*} (s : Finset iota)
    (q : iota -> SchwartzMap (Euclidean 2) Complex)
    (hqcompact : forall i, HasCompactSupport (q i : Euclidean 2 -> Complex))
    (a : iota -> SchwartzMap Real Complex) (y : Euclidean 2) :
    (⨆ theta : Real, ENNReal.ofReal
      (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2)) ≤
      ⨆ theta : {r : Real // r ∈ Ico (-Real.pi) Real.pi}, ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a theta.1 y‖ ^ 2) := by
  apply iSup_le
  intro theta
  rcases Function.Periodic.exists_mem_Ico
      (periodic_finiteTensorCircleMultiplierField s q hqcompact a y)
      Real.two_pi_pos theta (-Real.pi) with ⟨beta, hbeta, hEq⟩
  have hbeta' : beta ∈ Ico (-Real.pi) Real.pi := by
    rw [show -Real.pi + 2 * Real.pi = Real.pi by ring] at hbeta
    exact hbeta
  calc
    ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a theta y‖ ^ 2) =
        ENNReal.ofReal (‖finiteTensorCircleMultiplierField s q hqcompact a beta y‖ ^ 2) := by
          rw [hEq]
    _ ≤ ⨆ beta : {r : Real // r ∈ Ico (-Real.pi) Real.pi}, ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a beta.1 y‖ ^ 2) :=
      le_iSup (fun beta : {r : Real // r ∈ Ico (-Real.pi) Real.pi} => ENNReal.ofReal
        (‖finiteTensorCircleMultiplierField s q hqcompact a beta.1 y‖ ^ 2)) ⟨beta, hbeta'⟩

theorem centeredFundamental_mem_closed
    {theta : Real} (htheta : theta ∈ Ico (-Real.pi) Real.pi) :
    theta ∈ Icc (-Real.pi) Real.pi :=
  ⟨htheta.1, htheta.2.le⟩

