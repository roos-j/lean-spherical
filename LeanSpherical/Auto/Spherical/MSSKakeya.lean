/-- The dyadic outer shell has a fully concrete annular fibre witness.  The
constant is selected once for the stationary shift; all Fubini, physical
slice, sector-zero, and source-energy obligations are discharged. -/
theorem exists_concreteAnnularShellFiberEnergyWitness_shifted_dyadic
    {rhoMax : Real} (hrhoMax : 0 ≤ rhoMax)
    (hrhoMax_small : 9 * rhoMax / 4 < Real.pi) (n : Nat) :
    ∃ B : Real, 0 < B ∧
      ∀ {kappa : Type uK} {iota : Type uI}
        {charts : Finset kappa} {active : Set (Euclidean 2)}
        (C : SmoothAngularFrequencyChartFamily kappa charts active) (j : kappa)
        (hj : j ∈ charts) (s : Finset iota)
        (q : iota → SchwartzMap (Euclidean 2) Complex)
        (hqcompact : ∀ l, HasCompactSupport (q l : Euclidean 2 → Complex))
        (a : iota → SchwartzMap Real Complex)
        {eps r lambda : Real} (heps : 0 < eps) (hlambda : 0 < lambda)
        (K k : Nat) (hk : k < K) (lo hi : Real)
        (hqann : ∀ l, Function.support (q l : Euclidean 2 → Complex) ⊆
          scaledDyadicFrequencyAnnulus lambda)
        (hn : n < 7)
        (hr : r = (4 / 5 : Real) * ((2 : Real) ^ (k + 1) * eps))
        (hrmem : r ∈ Ioc (0 : Real) rhoMax)
        (houter : ∀ xi, xi ∈ scaledDyadicFrequencyAnnulus lambda →
          1 ≤ ‖xi‖ * r ^ 2)
        {rTime : Real} (hrTime : rTime < 1)
        (hsupport : ∀ l, Function.support (a l : Real → Complex) ⊆
          closedBall (3 / 2 : Real) rTime),
      ∃ W : AnnularShellFiberEnergyWitness C j s q hqcompact a eps K n (k + 1)
        lo hi lambda r B
        (shiftedChartedCappedTelescopingSchwartzSlices_concrete
          C j s q hqcompact a eps K n (k + 1) lo hi),
        ∀ xi, W.h xi = shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi := by
  rcases nonempty_shiftedDyadicFiberLobeEnergyBounds.{uI}
      hrhoMax hrhoMax_small n with ⟨D⟩
  rcases exists_shellFrequencyEnergy_shiftedCharted_dyadic_deriv_le_source_of_sectorCases
      hrhoMax hrhoMax_small n with ⟨B1, hB1, hE1⟩
  let B0 : Real := 2 * (D.B0plus + D.B0minus)
  let B : Real := B0 + B1 + 1
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg (by norm_num)
      (add_nonneg D.e0plus.1.le D.e0minus.1.le)
  have hB : 0 < B := by
    dsimp only [B]
    linarith
  refine ⟨B, hB, ?_⟩
  intro kappa iota charts active C j hj s q hqcompact a eps r lambda heps hlambda K k hk lo hi
    hqann hn hr hrmem houter rTime hrTime htime
  let S := shiftedChartedCappedTelescopingSchwartzSlices_concrete
    C j s q hqcompact a eps K n (k + 1) lo hi
  have hSmult : (fun theta xi => S.multiplier theta xi) =
      shiftedChartedCappedTelescopingMultiplier C j s q hqcompact a eps K n (k + 1) := by
    rfl
  have hSderiv : (fun theta xi => S.multiplierDeriv theta xi) =
      shiftedChartedCappedTelescopingMultiplierDerivRaw C j s q hqcompact a eps K n (k + 1) := by
    rfl
  have hsupp := shiftedChartedCappedTelescopingMultiplier_support_on_of_profiles_supportedOn
    C j s q hqcompact a eps K n (k + 1) (scaledDyadicFrequencyAnnulus lambda) hqann
  refine ⟨concreteAnnularShellFiberEnergyWitness C j s q hqcompact a eps K n (k + 1)
    lo hi lambda r B S hsupp.1 hsupp.2 ?_ ?_, ?_⟩
  · intro xi hxi
    have hnormlo : lambda / 2 ≤ ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hnorm : ‖xi‖ ≠ 0 := norm_ne_zero_iff.mpr hxine
    have hbase := shellFrequencyEnergy_shiftedCharted_dyadic_le_source_of_sectorCases
      C j hj s q hqcompact a heps K n k hk lo hi xi hn hnorm hr hrmem D hrTime htime
    have hsourceNonneg : 0 ≤ shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi :=
      shiftedFiberSourceEnergy_nonneg s (C.chartProfiles j q) a xi
    have hden : 0 < ‖xi‖ * r :=
      mul_pos (norm_pos_iff.mpr hxine) hrmem.1
    have hcoef : B0 / (‖xi‖ * r) ≤ B / (‖xi‖ * r) := by
      apply (div_le_div_iff_of_pos_right hden).mpr
      dsimp only [B]
      linarith
    have hraise := mul_le_mul_of_nonneg_right hcoef hsourceNonneg
    rw [hSmult]
    exact hbase.trans hraise
  · intro xi hxi
    have hnormlo : lambda / 2 ≤ ‖xi‖ := hxi.1
    have hxine : xi ≠ 0 := by
      intro hzero
      rw [hzero] at hnormlo
      simp at hnormlo
      linarith
    have hnorm : ‖xi‖ ≠ 0 := norm_ne_zero_iff.mpr hxine
    have hbase := hE1 C j hj s q hqcompact a heps K k hk lo hi xi hn hnorm
      hr hrmem (houter xi hxi) hrTime htime
    have hsourceNonneg : 0 ≤ shiftedFiberSourceEnergy s (C.chartProfiles j q) a xi :=
      shiftedFiberSourceEnergy_nonneg s (C.chartProfiles j q) a xi
    have hfactor : 0 ≤ ‖xi‖ * r := mul_nonneg (norm_nonneg _) hrmem.1.le
    have hcoef : B1 * (‖xi‖ * r) ≤ B * (‖xi‖ * r) := by
      apply mul_le_mul_of_nonneg_right
      · dsimp only [B]
        linarith
      · exact hfactor
    have hraise := mul_le_mul_of_nonneg_right hcoef hsourceNonneg
    rw [hSderiv]
    exact hbase.trans hraise
  · intro xi
    rfl

