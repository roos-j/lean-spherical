noncomputable section

/-- Joint continuity of a literal inverse spatial Fourier integral from a
pointwise jointly continuous integrand and one global integrable majorant.
The hypotheses are deliberately stated after the Fourier character, which is
the form produced by compact smooth chart multipliers. -/
theorem continuous_uncurry_fourierInv_of_dominated
    (m : Real → Euclidean 2 → Complex)
    (hcont : ∀ xi : Euclidean 2, Continuous (fun p : Real × Euclidean 2 =>
      (Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi))
    (hmeas : ∀ p : Real × Euclidean 2, AEStronglyMeasurable (fun xi =>
      (Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi))
    (bound : Euclidean 2 → Real)
    (hbound : ∀ p : Real × Euclidean 2, ∀ xi : Euclidean 2,
      ‖(Real.fourierChar (inner Real xi p.2) : Complex) • m p.1 xi‖ ≤ bound xi)
    (hboundint : Integrable bound) :
    Continuous (Function.uncurry (fun theta y =>
      FourierTransform.fourierInv (m theta) y)) := by
  rw [continuous_iff_continuousAt]
  rintro ⟨theta, y⟩
  simp only [Real.fourierInv_eq]
  apply tendsto_integral_filter_of_dominated_convergence bound
  · filter_upwards with p
    exact hmeas p
  · filter_upwards with p
    exact Filter.Eventually.of_forall (fun xi => hbound p xi)
  · exact hboundint
  · filter_upwards with xi
    exact (hcont xi).continuousAt

end

end Auto.Spherical.MSS.KakeyaInverseFourierContinuity
