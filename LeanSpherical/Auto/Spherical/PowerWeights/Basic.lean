    (∫⁻ x, G x ∂ν) = ∫⁻ x, A.indicator G x ∂ν := by rw [hindicator]
    _ = ∫⁻ x, G x ∂ν.restrict A := by rw [lintegral_indicator hA]

/-- Hölder on one annular support set.  This retains the measure of that
annulus, rather than replacing it with the volume of a fixed containing
ball; the thin-radial tail argument needs exactly this factor. -/
theorem eLpNorm_one_volume_le_eLpNorm_mul_annulus_volume_of_annular_support
    {d : Nat} {p r R : Real} (hp : 1 < p)
    (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ x : Euclidean d, x ∉ euclideanAnnulus d r R → f x = 0) :
    eLpNorm (f : Euclidean d → Complex) 1 volume ≤
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
        (volume (euclideanAnnulus d r R)) ^ (1 - p⁻¹) := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hf_indicator : A.indicator (f : Euclidean d → Complex) =
      (f : Euclidean d → Complex) := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hfsupport x hx]
  have hone_restrict :
      eLpNorm (f : Euclidean d → Complex) 1 volume =
        eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) := by
    calc
      eLpNorm (f : Euclidean d → Complex) 1 volume =
          eLpNorm (A.indicator (f : Euclidean d → Complex)) 1 volume :=
        congrArg (fun g : Euclidean d → Complex => eLpNorm g 1 volume)
          hf_indicator |>.symm
      _ = eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) :=
        eLpNorm_indicator_eq_eLpNorm_restrict hA
  have hp_restrict :
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume =
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) := by
    calc
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume =
          eLpNorm (A.indicator (f : Euclidean d → Complex))
            (ENNReal.ofReal p) volume :=
        congrArg (fun g : Euclidean d → Complex =>
          eLpNorm g (ENNReal.ofReal p) volume) hf_indicator |>.symm
      _ = eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) := eLpNorm_indicator_eq_eLpNorm_restrict hA
  have hholder := eLpNorm_le_eLpNorm_mul_rpow_measure_univ
    (μ := volume.restrict A) (f := (f : Euclidean d → Complex))
    (show (1 : ENNReal) ≤ ENNReal.ofReal p by
      rw [← ENNReal.ofReal_one]
      exact ENNReal.ofReal_le_ofReal hp.le)
    f.continuous.aestronglyMeasurable
  have hholder' :
      eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) ≤
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) *
          (volume A) ^ (1 - p⁻¹) := by
    simpa [Measure.restrict_apply, hA, ENNReal.toReal_ofReal hp0.le] using hholder
  calc
    eLpNorm (f : Euclidean d → Complex) 1 volume =
        eLpNorm (f : Euclidean d → Complex) 1 (volume.restrict A) := hone_restrict
    _ ≤ eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p)
          (volume.restrict A) * (volume A) ^ (1 - p⁻¹) := hholder'
    _ = eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          (volume (euclideanAnnulus d r R)) ^ (1 - p⁻¹) := by
      rw [← hp_restrict]

/-- The raw `L¹` moment of annularly supported input is bounded by its
weighted `Lᵖ` moment with the sharp annulus-volume factor. -/
theorem lintegral_enorm_rpow_le_annulus_volume_mul_powerWeighted_of_annular_support
    {d : Nat} {p α r R : Real} (hp : 1 < p) (hα : α ≤ 0)
    (hr : 0 < r) (hrR : r ≤ R)
    (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ x : Euclidean d, x ∉ euclideanAnnulus d r R → f x = 0) :
    (∫⁻ x, ‖f x‖ₑ) ^ p ≤
      (volume (euclideanAnnulus d r R)) ^ (p - 1) *
        ((ENNReal.ofReal R) ^ α)⁻¹ *
          ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let I : ENNReal := ∫⁻ x, ‖f x‖ₑ
  let J : ENNReal := ∫⁻ x, ‖f x‖ₑ ^ p ∂volume
  let K : ENNReal := ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α
  let V : ENNReal := volume A
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpnn : 0 ≤ p := hp0.le
  have hholder := eLpNorm_one_volume_le_eLpNorm_mul_annulus_volume_of_annular_support
    hp f hfsupport
  have hholder' : I ≤
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
        V ^ (1 - p⁻¹) := by
    simpa only [I, V, A, eLpNorm_one_eq_lintegral_enorm] using hholder
  have hGmeas : Measurable (fun x : Euclidean d => ‖f x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp f.continuous.enorm.measurable
  have hGsupport : ∀ x : Euclidean d, x ∉ A → ‖f x‖ₑ ^ p = 0 := by
    intro x hx
    simp [hfsupport x hx, ENNReal.zero_rpow_of_pos hp0]
  have hinput : J ≤ w⁻¹ * K := by
    dsimp only [J, K, w, A]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  have hPpow :
      (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p = J := by
    dsimp only [J]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpnn]
    rw [← ENNReal.rpow_mul]
    field_simp
    rw [ENNReal.rpow_one]
  have hraised := ENNReal.rpow_le_rpow hholder' hpnn
  calc
    (∫⁻ x, ‖f x‖ₑ) ^ p = I ^ p := by rfl
    _ ≤ (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          V ^ (1 - p⁻¹)) ^ p := hraised
    _ = (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p *
          (V ^ (1 - p⁻¹)) ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hpnn]
    _ = J * V ^ (p - 1) := by
          rw [hPpow, ← ENNReal.rpow_mul]
          congr 1
          field_simp
    _ = V ^ (p - 1) * J := by ring
    _ ≤ V ^ (p - 1) * (w⁻¹ * K) := mul_le_mul_right hinput _
    _ = (volume (euclideanAnnulus d r R)) ^ (p - 1) *
          ((ENNReal.ofReal R) ^ α)⁻¹ *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂powerWeightedVolume d α := by
          dsimp only [V, w, K, A]
          ring

/-- The radius-restricted raw spherical maximal norm is subadditive on
continuous inputs.  Unlike the compact-interval helper in `SphericalAverages`,
this keeps an arbitrary subset of radii visible. -/
theorem restricted_iSup_ennreal_norm_sphericalAverage_add_le
    {d : Nat} (E : Set ℝ) (f g : Euclidean d → ℂ)
    (hf : Continuous f) (hg : Continuous g) (x : Euclidean d) :
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
      ENNReal.ofReal ‖sphericalAverage d (f + g) r.1 x‖) ≤
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d f r.1 x‖) +
        ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d g r.1 x‖ := by
  apply iSup_le
  intro r
  have hint (h : Euclidean d → ℂ) (hh : Continuous h) : Integrable
      (fun ω : sphere (0 : Euclidean d) 1 => h (x + r.1 • (ω : Euclidean d)))
      (unitSurfaceMeasure d) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact hh.comp
        ((continuous_const : Continuous fun _ : sphere (0 : Euclidean d) 1 => x).add
          ((continuous_const : Continuous fun _ : sphere (0 : Euclidean d) 1 => r.1).smul
            continuous_subtype_val))
    · exact HasCompactSupport.of_compactSpace _
  have havg : sphericalAverage d (f + g) r.1 x =
      sphericalAverage d f r.1 x + sphericalAverage d g r.1 x := by
    unfold sphericalAverage
    change (∫ ω : sphere (0 : Euclidean d) 1,
      (f (x + r.1 • (ω : Euclidean d)) + g (x + r.1 • (ω : Euclidean d)))
      ∂unitSurfaceMeasure d) = _
    rw [MeasureTheory.integral_add (hint f hf) (hint g hg)]
  rw [havg]
  calc
    ENNReal.ofReal ‖sphericalAverage d f r.1 x + sphericalAverage d g r.1 x‖ ≤
        ENNReal.ofReal (‖sphericalAverage d f r.1 x‖ +
          ‖sphericalAverage d g r.1 x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖sphericalAverage d f r.1 x‖ +
          ENNReal.ofReal ‖sphericalAverage d g r.1 x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ (⨆ s : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d f s.1 x‖) +
        ⨆ s : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d g s.1 x‖ := by
      gcongr
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
          ENNReal.ofReal ‖sphericalAverage d f s.1 x‖) r
      · exact le_iSup (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
          ENNReal.ofReal ‖sphericalAverage d g s.1 x‖) r

/-- The literal restricted smooth dyadic maximal norm is finite when the
available radii lie in `[1,2]`. -/
theorem restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top
    {d : Nat} (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (psi g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖) ≠ ⊤ := by
  let Pg : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g))
  have hfull :
      (⨆ r : Icc (1 : ℝ) 2,
        ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖) ≠ ⊤ :=
    iSup_ennreal_norm_sphericalAverage_ne_top
      (Pg : Euclidean d → ℂ) Pg.continuous (by norm_num) x
  apply ne_top_of_le_ne_top hfull
  apply iSup_le
  intro r
  exact le_iSup
    (fun s : Icc (1 : ℝ) 2 =>
      ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) s.1 x‖)
    ⟨r.1, hE r.2.1⟩

/-- The real-valued restricted smooth dyadic maximal output is subadditive on
Schwartz inputs. -/
theorem restricted_smooth_dyadic_sphericalMaximal_add_le
    {d : Nat} (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (psi f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal ≤
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 f)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal +
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
          ‖sphericalAverage d
            ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal := by
  let Pf : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 f))
  let Pg : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g))
  have hPadd :
      (𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
        SchwartzMap (Euclidean d) ℂ) = Pf + Pg := by
    rw [fourier_add f g]
    rw [(SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ)).map_add]
    rw [fourierInv_add]
  have hfin_f :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi f x
  have hfin_g :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi g x
  have hfin_fg :=
    restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top E hE psi (f + g) x
  have hfin_fg' :
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d ((Pf + Pg : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r.1 x‖) ≠ ⊤ := by
    simpa only [hPadd] using hfin_fg
  have hsumfin :
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖) +
          ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖ ≠ ⊤ :=
    ENNReal.add_ne_top.mpr ⟨hfin_f, hfin_g⟩
  calc
    (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 (f + g))) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal =
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d ((Pf + Pg : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) r.1 x‖).toReal := by rw [hPadd]
    _ ≤
        ((⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖) +
          ⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖).toReal :=
      (ENNReal.toReal_le_toReal hfin_fg' hsumfin).2
        (restricted_iSup_ennreal_norm_sphericalAverage_add_le E
          (Pf : Euclidean d → ℂ) (Pg : Euclidean d → ℂ) Pf.continuous Pg.continuous x)
    _ = (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pf : Euclidean d → ℂ) r.1 x‖).toReal +
        (⨆ r : ↥(E ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖).toReal :=
      ENNReal.toReal_add hfin_f hfin_g

/-- Measurability of the literal restricted smooth dyadic maximal output. -/
theorem measurable_restricted_smooth_dyadic_sphericalMaximal
    {d : Nat} (E : Set ℝ) (psi g : SchwartzMap (Euclidean d) ℂ) :
    Measurable (fun x : Euclidean d =>
      (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) r.1 x‖).toReal) := by
  let Pg : SchwartzMap (Euclidean d) ℂ :=
    𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g))
  let G : ℝ × Euclidean d → ℂ := fun z =>
    sphericalAverage d (Pg : Euclidean d → ℂ) z.1 z.2
  have hG : Continuous G := by
    dsimp only [G]
    exact continuous_sphericalAverage (Pg : Euclidean d → ℂ) Pg.continuous
  have hMeas : Measurable (⨆ r : ↥(E ∩ Ioi (0 : ℝ)), fun x : Euclidean d =>
      ENNReal.ofReal ‖G (r.1, x)‖) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro r
      exact (ENNReal.continuous_ofReal.comp
        ((hG.comp (continuous_const.prodMk continuous_id)).norm)).measurable
    · intro x
      exact (ENNReal.continuous_ofReal.comp
        ((hG.comp (continuous_subtype_val.prodMk continuous_const)).norm)).lowerSemicontinuous
  have hEq : (fun x : Euclidean d =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖) =
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), fun x : Euclidean d =>
        ENNReal.ofReal ‖G (r.1, x)‖ := by
    funext x
    exact (iSup_apply
      (f := fun r : ↥(E ∩ Ioi (0 : ℝ)) => fun x : Euclidean d =>
        ENNReal.ofReal ‖G (r.1, x)‖) (a := x)).symm
  have hbase : Measurable (fun x : Euclidean d =>
      ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d (Pg : Euclidean d → ℂ) r.1 x‖) := by
    rw [hEq]
    exact hMeas
  exact ENNReal.measurable_toReal.comp hbase

/-- Squaring commutes with the supremum of nonnegative extended-real values
over a nonempty radius set. -/
theorem iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
    {ι : Type*} [Nonempty ι] (F : ι → ℂ) :
    (⨆ i : ι, ENNReal.ofReal (‖F i‖ ^ (2 : ℕ))) =
      (⨆ i : ι, ENNReal.ofReal ‖F i‖) ^ (2 : ℕ) := by
  rw [ENNReal.iSup_pow]
  apply iSup_congr
  intro i
  rw [ENNReal.ofReal_pow (norm_nonneg _)]

/-- The finite entropy cover has a uniform square-function coefficient.  The
two terms retain respectively the frequency decay and the short-radius
derivative gain. -/
theorem entropy_interval_coefficient_sum_le
    (T : Finset (ℝ × ℝ)) (N : ℕ)
    (B C L : ℝ) (hcard : T.card ≤ N) (hordered : ∀ q ∈ T, q.1 ≤ q.2)
    (hlength : ∀ q ∈ T, q.2 - q.1 ≤ L) (hL : 0 ≤ L) :
    (∑ q ∈ T, ENNReal.ofReal
      (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) ≤
      (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
  have hterm (q : ℝ × ℝ) (hq : q ∈ T) :
      ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) ≤
        ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
    apply ENNReal.ofReal_le_ofReal
    have hq0 : 0 ≤ q.2 - q.1 := sub_nonneg.mpr (hordered q hq)
    have hql : q.2 - q.1 ≤ L := hlength q hq
    have hsq : (q.2 - q.1) ^ (2 : ℕ) ≤ L ^ (2 : ℕ) := by
      nlinarith [mul_nonneg (show 0 ≤ L - (q.2 - q.1) by linarith)
        (show 0 ≤ L + (q.2 - q.1) by linarith)]
    gcongr
  calc
    (∑ q ∈ T, ENNReal.ofReal
      (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) ≤
        ∑ q ∈ T, ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
      apply Finset.sum_le_sum
      intro q hq
      exact hterm q hq
    _ = (T.card : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by simp
    _ ≤ (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) := by
      gcongr

/-- The physical endpoint, restricted to a spatial annulus, as a lower
integral estimate for the literal smooth dyadic maximal piece.  The input
support hypothesis is exactly where the lower annular weight comparison is
used. -/
theorem smooth_dyadic_annular_lintegral_one_le_of_pointwise
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (j : Nat) (psi : SchwartzMap (Euclidean d) ℂ)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖) ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let μ : Measure (Euclidean d) := powerWeightedVolume d α
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * μ A * w⁻¹ *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let M : Euclidean d → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖
  let T : Euclidean d → ℝ := A.indicator (fun x => (M x).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂volume
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hDpow : 0 ≤ D * (2 : ℝ) ^ j := by positivity
  have hI : I = ENNReal.ofReal (∫ x : Euclidean d, ‖g x‖) := by
    dsimp only [I]
    symm
    simpa only [ofReal_norm] using
      ofReal_integral_norm_eq_lintegral_enorm (μ := volume) g.integrable
  have hMpoint (x : Euclidean d) : M x ≤ c * I := by
    calc
      M x ≤ ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖) :=
        hpointwise g x
      _ = c * I := by
        rw [ENNReal.ofReal_mul hDpow, ← hI]
  have hMfin (x : Euclidean d) : M x ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (by rw [hI]; exact ENNReal.ofReal_ne_top)) (hMpoint x)
  have hTpoint (x : Euclidean d) :
      ENNReal.ofReal (T x) ≤ A.indicator (fun _ : Euclidean d => c * I) x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx]
      rw [ENNReal.ofReal_toReal (hMfin x)]
      exact hMpoint x
    · simp only [T, Set.indicator_of_notMem hx]
      simp
  have hGmeas : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) :=
    g.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hinput : I ≤ w⁻¹ * J := by
    dsimp only [I, J, w, μ]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
        ∫⁻ x, A.indicator (fun _ : Euclidean d => c * I) x ∂μ :=
      lintegral_mono hTpoint
    _ = c * I * μ A := by
      rw [lintegral_indicator hA, setLIntegral_const]
    _ = c * μ A * I := by ring
    _ ≤ c * μ A * (w⁻¹ * J) := mul_le_mul_right hinput _
    _ = c * μ A * w⁻¹ * J := by ring

/-- The preceding annular physical endpoint in the finite restricted measure
needed by the interpolation core. -/
theorem smooth_dyadic_annular_lintegral_one_le_of_pointwise_restrict
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (j : Nat) (psi : SchwartzMap (Euclidean d) ℂ)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖) ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let ν : Measure (Euclidean d) := powerWeightedVolume d α
    let μ : Measure (Euclidean d) := ν.restrict A
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage d
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * ν A * w⁻¹ *
        ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let μ : Measure (Euclidean d) := ν.restrict A
  let T : Euclidean d → ℝ := A.indicator (fun x =>
    (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage d
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (psi : Euclidean d → ℂ) (𝓕 g)) :
          SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) s.1 x‖).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hglobal : (∫⁻ x, ENNReal.ofReal (T x) ∂ν) ≤
      c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := by
    simpa only [A, ν, T, c, w] using
      (smooth_dyadic_annular_lintegral_one_le_of_pointwise
        hα hr hrR D hD j psi E hpointwise g hgsupport)
  have hTout : ∀ x, x ∉ A → ENNReal.ofReal (T x) = 0 := by
    intro x hx
    simp [T, hx]
  have hGin : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hout_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal (T x)) hTout (ν := ν)
  have hin_eq := lintegral_eq_lintegral_restrict_of_support A hA
    (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) hGin (ν := ν)
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) = ∫⁻ x, ENNReal.ofReal (T x) ∂ν := by
      exact hout_eq.symm
    _ ≤ c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂ν := hglobal
    _ = c * ν A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by rw [hin_eq]

/-- The entropy `L²` endpoint on a spatial annulus, converted to the same
power-weighted input measure as the physical endpoint.  The displayed
coefficient keeps both the entropy cardinality and short-interval gain. -/
theorem smooth_dyadic_annular_lintegral_two_le_of_sharp
    {d : Nat} (hd : 2 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ ξ : Euclidean (d + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (d + 1) ξ‖ ≤ C0 / ‖ξ‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (d + 1), ∀ u : ℝ, 1 ≤ ‖ξ‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • ξ)) u‖ ≤
        C1 / ‖ξ‖ ^ ((d : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    (hpsi : ∀ ξ : Euclidean (d + 1),
      psi ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (d + 1) → ℂ))
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : ℝ≥0) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus (d + 1) r R → g x = 0) :
    let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
    let μ : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
    let T : Euclidean (d + 1) → ℝ := A.indicator (fun x =>
      (⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
        ‖sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          s.1 x‖).toReal)
    let B : ℝ := (2 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((d : ℝ) / 2)
    let C : ℝ := (2 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((d : ℝ) / 2 - 1)
    let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
    let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
    let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) ≤
      wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ := by
  dsimp only
  let A : Set (Euclidean (d + 1)) := euclideanAnnulus (d + 1) r R
  let μ : Measure (Euclidean (d + 1)) := powerWeightedVolume (d + 1) α
  let M₁ : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      ‖sphericalAverage (d + 1)
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
          (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
        s.1 x‖
  let M₂ : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ s : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      (‖sphericalAverage (d + 1)
        ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
          (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
            SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
        s.1 x‖ ^ (2 : ℕ))
  let T : Euclidean (d + 1) → ℝ := A.indicator (fun x => (M₁ x).toReal)
  let B : ℝ := (2 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((d : ℝ) / 2)
  let C : ℝ := (2 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let wᵢ : ENNReal := (ENNReal.ofReal r) ^ α
  let wₒ : ENNReal := (ENNReal.ofReal R) ^ α
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂μ
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hIintegrable : Integrable (fun x : Euclidean (d + 1) =>
      ‖g x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm g.continuous.aestronglyMeasurable).mp
      (g.memLp 2 volume)
  have hI : I = ENNReal.ofReal (∫ x : Euclidean (d + 1), ‖g x‖ ^ (2 : ℕ)) := by
    dsimp only [I]
    exact (ofReal_integral_eq_lintegral_ofReal hIintegrable
      (Filter.Eventually.of_forall fun x => sq_nonneg (‖g x‖))).symm
  have hposE : ∀ t ∈ E, 0 < t := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  rcases hEne with ⟨t₀, ht₀⟩
  letI : Nonempty ↥(E ∩ Ioi (0 : ℝ)) := ⟨⟨t₀, ht₀, hposE t₀ ht₀⟩⟩
  have hMfin (x : Euclidean (d + 1)) : M₁ x ≠ ⊤ := by
    dsimp only [M₁]
    exact restricted_iSup_ennreal_norm_smooth_dyadic_sphericalAverage_ne_top
      E hE psi g x
  have hM₂_eq (x : Euclidean (d + 1)) : M₂ x = (M₁ x) ^ (2 : ℕ) := by
    dsimp only [M₂, M₁]
    exact iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
      (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
        sphericalAverage (d + 1)
          ((𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
            (psi : Euclidean (d + 1) → ℂ) (𝓕 g)) :
              SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ)
          s.1 x)
  have hT_sq (x : Euclidean (d + 1)) :
      ENNReal.ofReal ((T x) ^ (2 : ℕ)) = A.indicator M₂ x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx, M₂]
      rw [ENNReal.ofReal_pow ENNReal.toReal_nonneg,
        ENNReal.ofReal_toReal (hMfin x), ← hM₂_eq]
    · simp [T, hx]
  obtain ⟨S, hScard, hSordered, _hSends, hSlength, hSbound⟩ :=
    exists_entropy_interval_lintegral_iSup_ennreal_norm_sq_smooth_dyadic_on_annulus_of_sharp
      hd C0 C1 hC0 hC1 hdecay hderiv phi g psi hphi_one hphi_zero hphi_norm
      j hpsi hpsi_compact E hE ⟨t₀, ht₀⟩ δ N hN hδ hα hr (R := R)
  have hLnonneg : 0 ≤ L := by
    dsimp only [L]
    positivity
  have hSsum := entropy_interval_coefficient_sum_le S N B C L
    hScard hSordered hSlength hLnonneg
  have hSbound' :
      (∫⁻ x in A, M₂ x ∂μ) ≤
        wᵢ *
          (∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
    calc
      (∫⁻ x in A, M₂ x ∂μ) ≤
          wᵢ *
            (∑ q ∈ S, ENNReal.ofReal
              ((2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) *
                ∫ x : Euclidean (d + 1), ‖g x‖ ^ (2 : ℕ))) := by
        simpa only [A, μ, M₂, B, C, wᵢ] using hSbound
      _ = wᵢ *
          (∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
        congr 2
        funext q
        rw [ENNReal.ofReal_mul (by positivity), ← hI]
  have hbound :
      (∫⁻ x in A, M₂ x ∂μ) ≤
        wᵢ * (N : ENNReal) * ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := by
    calc
      (∫⁻ x in A, M₂ x ∂μ) ≤
          wᵢ *
            (∑ q ∈ S, ENNReal.ofReal
              (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ)) * I) := by
        exact hSbound'
      _ = wᵢ *
          ((∑ q ∈ S, ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by
        rw [← Finset.sum_mul]
      _ ≤ wᵢ *
          (((N : ENNReal) * ENNReal.ofReal
            (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by
        calc
          wᵢ *
              ((∑ q ∈ S, ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) =
              wᵢ *
                (I * ∑ q ∈ S, ENNReal.ofReal
                  (2 * B ^ (2 : ℕ) + 2 * (q.2 - q.1) ^ (2 : ℕ) * C ^ (2 : ℕ))) := by ring
          _ ≤ wᵢ *
              (I * ((N : ENNReal) * ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)))) :=
            mul_le_mul_right (mul_le_mul_right hSsum I) wᵢ
          _ = wᵢ *
              (((N : ENNReal) * ENNReal.ofReal
                (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ))) * I) := by ring
      _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
          (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := by ring
  have hGmeas : Measurable (fun x : Euclidean (d + 1) =>
      ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) :=
    (g.continuous.norm.pow 2).measurable.ennreal_ofReal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hinput : I ≤ wₒ⁻¹ * J := by
    dsimp only [I, J, wₒ, μ]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  calc
    (∫⁻ x, ENNReal.ofReal ((T x) ^ (2 : ℕ)) ∂μ) = ∫⁻ x in A, M₂ x ∂μ := by
      rw [show (fun x : Euclidean (d + 1) => ENNReal.ofReal ((T x) ^ (2 : ℕ))) =
          A.indicator M₂ by
        funext x
        exact hT_sq x,
        lintegral_indicator hA]
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * I := hbound
    _ ≤ wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * (wₒ⁻¹ * J) :=
      mul_le_mul_right hinput _
    _ = wᵢ * (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * L ^ (2 : ℕ) * C ^ (2 : ℕ)) * wₒ⁻¹ * J := by ring

