    (hhemisphere : ∀ r ∈ T, 2 * ρ ≤ (r : ℝ))
    (hppos : 0 < p) (hα : α < 0)
    (hApos : 0 < A) (hBpos : 0 < B)
    (hh : 0 < h) (hquarter : h ≤ 1 / 4)
    (hcapHorizontal : ∀ r ∈ T, (r : ℝ) * h < A)
