/-- Multiplication by a smooth Bessel weight preserves Schwartz functions. -/
def besselSchwartzMultiplier {d : ℕ} (a : ℝ) :
    SchwartzMap (Euclidean d) ℂ →L[ℂ] SchwartzMap (Euclidean d) ℂ :=
  SchwartzMap.smulLeftCLM ℂ
    (fun x : Euclidean d => (besselPowerWeight a x : ℂ))

theorem besselSchwartzMultiplier_apply {d : ℕ} (a : ℝ)
