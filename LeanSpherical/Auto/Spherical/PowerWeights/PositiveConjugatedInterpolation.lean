    besselSchwartzMultiplier a f x = (besselPowerWeight a x : ℂ) * f x := by
  have hm : Function.HasTemperateGrowth
      (fun y : Euclidean d => (besselPowerWeight a y : ℂ)) := by
    have hcoe : Function.HasTemperateGrowth (fun t : ℝ => (t : ℂ)) := by fun_prop
    exact hcoe.comp (besselPowerWeight_hasTemperateGrowth a)
  rw [besselSchwartzMultiplier, SchwartzMap.smulLeftCLM_apply_apply hm]
  simp [smul_eq_mul]

