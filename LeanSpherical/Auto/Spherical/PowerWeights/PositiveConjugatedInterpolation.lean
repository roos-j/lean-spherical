/-- Interpolate a diagonal strong estimate and a supplied conjugated `L∞`
endpoint on one measure. -/
theorem exists_conjugated_schwartz_strong_type_of_q_and_top
    {d : ℕ} {μ : Measure (Euclidean d)} [SFinite μ]
    (T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ)
    (hTmeas : ∀ f, AEStronglyMeasurable (T f) μ)
    (hTnonneg : ∀ f x, 0 ≤ T f x)
    (hTsubadd : ∀ f g x, T (f + g) x ≤ T f x + T g x)
    {q p C Ctop : ℝ} (hq : 0 < q) (hqp : q < p)
    (hC : 0 < C) (hCtop : 0 < Ctop)
    (hstrong : ∀ f,
      eLpNorm (T f) (ENNReal.ofReal q) μ ≤
        ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal q) μ)
    (htop : ∀ f a, 0 ≤ a → (∀ x, ‖f x‖ ≤ a) → ∀ x, T f x ≤ Ctop * a) :
    ∃ D : ℝ, 0 < D ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ →
        MemLp (T f) (ENNReal.ofReal p) μ ∧
          eLpNorm (T f) (ENNReal.ofReal p) μ ≤
            ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) μ := by
  have hp : 0 < p := hq.trans hqp
  let Atail : ℝ := (p - q)⁻¹ * (4 : ℝ) ^ (p - q)
  let B : ℝ := p * (2 : ℝ) ^ q * C ^ q * Atail * Ctop ^ (p - q)
  let D : ℝ := B ^ p⁻¹
  have hAtail : 0 < Atail := by
    dsimp only [Atail]
    positivity
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  have hD : 0 < D := Real.rpow_pos_of_pos hB _
  refine ⟨D, hD, ?_⟩
  simpa only [D, B, Atail] using
    conjugated_schwartz_strong_type_of_q_and_top_with_constant
      T hTmeas hTnonneg hTsubadd hq hqp hC hCtop hstrong htop

/-- Bessel-weight specialization of the conjugated interpolation bridge.

The two hypotheses are exactly the analytic inputs still needed in the
positive branch: a diagonal bound for the Bessel-conjugated operator and its
weighted `L∞` endpoint.  The reference measure is the natural
`w_a^{-q}` Bessel measure.  To recover literal power weights, one needs a
scale-uniform version of these hypotheses for the rescaled Bessel weights,
together with convergence of the resulting weighted norms as the smoothing
scale tends to zero. -/
theorem exists_besselConjugatedRestrictedNormalizedSphericalMaximal_strong_type_of_q_and_top
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) {a q p C Ctop : ℝ}
    (hq : 0 < q) (hqp : q < p) (hC : 0 < C) (hCtop : 0 < Ctop)
    (hdiagonal : ∀ f : SchwartzMap (Euclidean d) ℂ,
      eLpNorm (besselConjugatedRestrictedNormalizedSphericalMaximal a E f)
          (ENNReal.ofReal q) (besselWeightedVolume (-a * q)) ≤
        ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
          (ENNReal.ofReal q) (besselWeightedVolume (-a * q)))
    (htop : ∀ (f : SchwartzMap (Euclidean d) ℂ) (u : ℝ), 0 ≤ u →
      (∀ x, ‖f x‖ ≤ u) → ∀ x,
        besselConjugatedRestrictedNormalizedSphericalMaximal a E f x ≤ Ctop * u) :
    ∃ D : ℝ, 0 < D ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (besselWeightedVolume (-a * q)) →
        MemLp (besselConjugatedRestrictedNormalizedSphericalMaximal a E f)
            (ENNReal.ofReal p) (besselWeightedVolume (-a * q)) ∧
          eLpNorm (besselConjugatedRestrictedNormalizedSphericalMaximal a E f)
              (ENNReal.ofReal p) (besselWeightedVolume (-a * q)) ≤
            ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ)
              (ENNReal.ofReal p) (besselWeightedVolume (-a * q)) := by
  letI : SFinite (besselWeightedVolume (d := d) (-a * q)) :=
    besselWeightedVolume_sfinite (-a * q)
  exact exists_conjugated_schwartz_strong_type_of_q_and_top
    (besselConjugatedRestrictedNormalizedSphericalMaximal a E)
    (fun f =>
      (measurable_besselConjugatedRestrictedNormalizedSphericalMaximal a E f).aestronglyMeasurable)
    (fun f x => besselConjugatedRestrictedNormalizedSphericalMaximal_nonneg a E f x)
    (fun f g x =>
      besselConjugatedRestrictedNormalizedSphericalMaximal_add_le hd a E f g x)
    hq hqp hC hCtop hdiagonal htop

end

