  have hgfun : (g : Euclidean d → ℂ) = fun y => f (ε • y) := by
    funext y
    change f (D y) = f (ε • y)
    simp [D]
  let z : Euclidean d := ε⁻¹ • x
  have hx : ε • z = x := by
    dsimp [z]
    simp [smul_smul, hε.ne']
  have hgBound (y : Euclidean d) : ‖g y‖ ≤ u := by
    rw [hgfun]
    exact hfu _
  let H : Euclidean d → ℂ :=
    (scaledBesselSchwartzMultiplier ε (-a) f : Euclidean d → ℂ)
  let G : Euclidean d → ℂ :=
    (besselSchwartzMultiplier (-a) g : Euclidean d → ℂ)
  have hinput : (fun y : Euclidean d => H (ε • y)) =
      ((ε ^ (-a) : ℝ) : ℂ) • G := by
    funext y
    dsimp [H, G]
    rw [scaledBesselSchwartzMultiplier_apply hε,
      besselSchwartzMultiplier_apply, scaledBesselPowerWeight_dilate hε (-a), hgfun]
    push_cast
    ring
  have hcoeffpos : 0 < ε ^ (-a) := Real.rpow_pos_of_pos hε _
  have hcoeffnorm : ‖((ε ^ (-a) : ℝ) : ℂ)‖ = ε ^ (-a) := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hcoeffpos]
  have hmax :
      restrictedNormalizedSphericalMaximal d E H (ε • z) =
        ENNReal.ofReal (ε ^ (-a)) *
          restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z := by
    calc
      restrictedNormalizedSphericalMaximal d E H (ε • z) =
          restrictedNormalizedSphericalMaximal d
            (dilateRadiusSet ε (dilateRadiusSet ε⁻¹ E)) H (ε • z) := by
              rw [dilateRadiusSet_inv_dilateRadiusSet E hε]
      _ = restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E)
          (fun y => H (ε • y)) z := by
            symm
            exact restrictedNormalizedSphericalMaximal_dilate (dilateRadiusSet ε⁻¹ E) H hε z
      _ = restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E)
          (((ε ^ (-a) : ℝ) : ℂ) • G) z := by rw [hinput]
      _ = ENNReal.ofReal (ε ^ (-a)) *
          restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z := by
            rw [restrictedNormalizedSphericalMaximal_const_smul, hcoeffnorm]
  have hident :
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f (ε • z) =
        besselConjugatedRestrictedNormalizedSphericalMaximal a
          (dilateRadiusSet ε⁻¹ E) g z := by
    change scaledBesselPowerWeight ε a (ε • z) *
        (restrictedNormalizedSphericalMaximal d E H (ε • z)).toReal =
      besselPowerWeight a z *
        (restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z).toReal
    rw [scaledBesselPowerWeight_dilate hε a, hmax,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal hcoeffpos.le]
    have hcancel : ε ^ a * ε ^ (-a) = 1 := by
      rw [← Real.rpow_add hε]
      norm_num
    calc
      (ε ^ a * besselPowerWeight a z) *
          (ε ^ (-a) *
            (restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z).toReal) =
          (ε ^ a * ε ^ (-a)) *
            (besselPowerWeight a z *
              (restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z).toReal) := by
            ring
      _ = _ := by rw [hcancel]; ring
  calc
    scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f x =
        scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f (ε • z) := by
          rw [hx]
    _ = besselConjugatedRestrictedNormalizedSphericalMaximal a
        (dilateRadiusSet ε⁻¹ E) g z := hident
    _ ≤ K * u := hunit (dilateRadiusSet ε⁻¹ E) g u hu hgBound z

/-- A global unweighted `L^q` estimate and the codimension-one Bessel
endpoint give a strong estimate at exponent `p` for every smooth scale,
with one constant for all positive scales. -/
theorem exists_uniform_scaledBesselRestrictedNormalizedSphericalMaximal_bound_of_unweighted
    {d : ℕ} (hd : 2 ≤ d) (E : Set ℝ) {a q p : ℝ}
    (ha : 0 ≤ a) (ha_lt : a < (d : ℝ) - 1)
    (hq : 0 < q) (hqp : q < p)
    (hunweighted : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E q 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (ε : ℝ), 0 < ε →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
            (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (a * (p - q))) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
            (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (a * (p - q))) := by
  have hp : 0 < p := hq.trans hqp
  obtain ⟨Cq, hCq, hdiagonal⟩ :=
    exists_scaledBesselConjugated_diagonal_of_unweighted
      (show 0 < d by omega) E hq hunweighted
  obtain ⟨Ctop, hCtop, htop⟩ :=
    exists_scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_top_endpoint
      hd ha ha_lt E
  let C : ℝ :=
    (p * (2 : ℝ) ^ q * Cq ^ q *
      ((p - q)⁻¹ * (4 : ℝ) ^ (p - q)) * Ctop ^ (p - q)) ^ p⁻¹
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro ε hε f
  letI : SFinite (scaledBesselWeightedVolume (d := d) ε (-a * q)) :=
    scaledBesselWeightedVolume_sfinite hε
  letI : (scaledBesselWeightedVolume (d := d) ε (-a * q)).HasTemperateGrowth :=
    scaledBesselWeightedVolume_hasTemperateGrowth hε
  let T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ :=
    scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E
  have hTmeas (g : SchwartzMap (Euclidean d) ℂ) :
      AEStronglyMeasurable (T g) (scaledBesselWeightedVolume ε (-a * q)) := by
    change AEStronglyMeasurable
      (scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E g)
      (scaledBesselWeightedVolume ε (-a * q))
    exact (measurable_scaledBesselConjugatedRestrictedNormalizedSphericalMaximal
      hε a E g).aestronglyMeasurable
  have hTstrong := conjugated_schwartz_strong_type_of_q_and_top_with_constant
    T
    hTmeas
    (fun g x =>
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_nonneg hε a E g x)
    (fun g h x =>
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_add_le
        (show 0 < d by omega) hε a E g h x)
    hq hqp hCq hCtop (hdiagonal ε hε) (htop ε hε)
  have hinputMem : MemLp (scaledBesselSchwartzMultiplier ε a f : Euclidean d → ℂ)
      (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (-a * q)) := by
    exact (scaledBesselSchwartzMultiplier ε a f).memLp (ENNReal.ofReal p)
      (scaledBesselWeightedVolume ε (-a * q))
  obtain ⟨_hTmem, hTbound⟩ := hTstrong
    (scaledBesselSchwartzMultiplier ε a f) hinputMem
  let M : Euclidean d → ENNReal :=
    restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ)
  have hMmeas : Measurable M := by
    dsimp [M]
    exact measurable_restrictedNormalizedSphericalMaximal E
      (f : Euclidean d → ℂ) f.continuous
  have hMtop (x : Euclidean d) : M x ≠ ∞ := by
    dsimp [M]
    exact restrictedNormalizedSphericalMaximal_ne_top_schwartz (show 0 < d by omega) E f x
  have hMnorm : eLpNorm M (ENNReal.ofReal p)
      (scaledBesselWeightedVolume ε (a * (p - q))) =
      eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal p)
        (scaledBesselWeightedVolume ε (a * (p - q))) := by
    apply eLpNorm_congr_enorm_ae
    filter_upwards with x
    rw [enorm_eq_self, Real.enorm_toReal (hMtop x)]
  have hinputNorm :
      eLpNorm (scaledBesselSchwartzMultiplier ε a f : Euclidean d → ℂ)
          (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (-a * q)) =
        eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (a * (p - q))) := by
    rw [show a * (p - q) = a * p + -a * q by ring]
    exact eLpNorm_scaledBesselSchwartzMultiplier_eq hε a (-a * q) p hp f
  have houtputNorm :
      eLpNorm (T (scaledBesselSchwartzMultiplier ε a f)) (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (-a * q)) =
        eLpNorm M (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (a * (p - q))) := by
    have hpoint : T (scaledBesselSchwartzMultiplier ε a f) =
        fun x => scaledBesselPowerWeight ε a x * (M x).toReal := by
      funext x
      dsimp [T, M]
      exact scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_multiplier hε a E f x
    rw [hpoint]
    calc
      eLpNorm (fun x => scaledBesselPowerWeight ε a x * (M x).toReal)
          (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (-a * q)) =
          eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal p)
            (scaledBesselWeightedVolume ε (a * p + -a * q)) :=
        eLpNorm_scaledBessel_weighted_real_mul_eq hε a (-a * q) p hp
          (fun x => (M x).toReal) hMmeas.ennreal_toReal (fun _ => ENNReal.toReal_nonneg)
      _ = eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (a * (p - q))) := by
            congr 3
            ring
      _ = eLpNorm M (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (a * (p - q))) := hMnorm.symm
  rw [houtputNorm, hinputNorm] at hTbound
  simpa only [C] using hTbound

end

