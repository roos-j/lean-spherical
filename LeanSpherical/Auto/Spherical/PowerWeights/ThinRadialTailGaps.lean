        ∀ m ∈ Finset.range (j - 3), m < j - k - 1 →
          b + ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) + s ≤
            s * ((r : Real) - 1 / 4)) ∧
      (∀ r ∈ M.filter (fun r : Nat => (r : Int) ≤ mu - 8),
        ∀ m ∈ Finset.range (j - 3), m < j - k - 1 →
          s * ((r : Real) + 5 / 4) + s +
              ((b - a) + b * (2 : Real) ^ (m + 1) / ((2 : Real) ^ j)) ≤ b) := by
  dsimp
  rcases hne with ⟨x, hxE, hxwindow⟩
  have hxE' : x ∈ Icc (1 : Real) 2 := hE hxE
  have hxa : max 1 (s * ((mu : Real) - 1)) ≤ x :=
    max_le hxE'.1 hxwindow.1
  have hxb : x ≤ min 2 (s * ((mu : Real) + 2)) :=
    le_min hxE'.2 hxwindow.2
  have hab : max 1 (s * ((mu : Real) - 1)) ≤
      min 2 (s * ((mu : Real) + 2)) := hxa.trans hxb
  have hwidth : min 2 (s * ((mu : Real) + 2)) -
      max 1 (s * ((mu : Real) - 1)) ≤ 3 * s := by
    calc
      min 2 (s * ((mu : Real) + 2)) -
          max 1 (s * ((mu : Real) - 1)) ≤
          s * ((mu : Real) + 2) - s * ((mu : Real) - 1) := by
            gcongr
            exact min_le_right _ _
            exact le_max_right _ _
      _ = 3 * s := by ring
  have hspos : 0 < s := by
    rw [hs]
    positivity
  have hsubset : E ∩ thinRadiusWindow s mu ⊆
      Icc (max 1 (s * ((mu : Real) - 1)))
        (min 2 (s * ((mu : Real) + 2))) := by
    intro y hy
    have hyE : y ∈ Icc (1 : Real) 2 := hE hy.1
    exact ⟨max_le hyE.1 hy.2.1, le_min hyE.2 hy.2.2⟩
  refine ⟨hsubset, hab, le_max_left _ _, min_le_left _ _, hwidth,
    min_le_right _ _, hxwindow.1.trans hxb, ?_, ?_⟩
  · intro r hr m hm hmcut
    have hrsep : (mu : Real) + 8 ≤ (r : Real) :=
      thinRadial_upper_tail_gap_of_int_ge (Finset.mem_filter.mp hr).2
    have hscale : min 2 (s * ((mu : Real) + 2)) * (2 : Real) ^ (m + 1) /
        ((2 : Real) ^ j) ≤ s :=
      dyadic_relative_cap_scale_le_spatial_scale j k m (min_le_left _ _) hs hmcut
    exact lower_gap_of_thin_window_index_separation hspos hwidth
      (min_le_right _ _) hscale hrsep
  · intro r hr m hm hmcut
    have hrsep : (r : Real) + 8 ≤ (mu : Real) :=
      thinRadial_lower_tail_gap_of_int_le (Finset.mem_filter.mp hr).2
    have hscale : min 2 (s * ((mu : Real) + 2)) * (2 : Real) ^ (m + 1) /
        ((2 : Real) ^ j) ≤ s :=
      dyadic_relative_cap_scale_le_spatial_scale j k m (min_le_left _ _) hs hmcut
    exact upper_gap_of_thin_window_index_separation hspos hwidth
      (hxwindow.1.trans hxb) hscale hrsep

end

