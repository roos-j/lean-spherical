    {x : Euclidean d} (hx : x ∈ Metric.closedBall (0 : Euclidean d) R) :
    (ENNReal.ofReal R) ^ α ≤ radialPowerWeight d α x := by
  by_cases hx0 : x = 0
  · subst x
    by_cases hα0 : α = 0
    · simp [hα0]
    · have hαneg : α < 0 := lt_of_le_of_ne hα hα0
      rw [radialPowerWeight, norm_zero, ENNReal.ofReal_zero,
        ENNReal.zero_rpow_of_neg hαneg]
      exact le_top
  · have hnormpos : 0 < ‖x‖ := norm_pos_iff.mpr hx0
    have hnormle : ‖x‖ ≤ R := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hx
    rw [radialPowerWeight, ENNReal.ofReal_rpow_of_pos hR,
      ENNReal.ofReal_rpow_of_pos hnormpos]
    exact ENNReal.ofReal_le_ofReal
      (Real.rpow_le_rpow_of_nonpos hnormpos hnormle hα)

