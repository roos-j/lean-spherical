  unfold restrictedNormalizedSphericalMaximal
  exact le_iSup
    (fun s : ↥(E ∩ Ioi (0 : ℝ)) =>
      ENNReal.ofReal ‖normalizedSphericalAverage d f s.1 x‖)
    ⟨r, hr, hr_pos⟩

/-- The constant-sphere test as a lower bound for the restricted maximal
operator. -/
theorem ennreal_norm_const_le_restrictedNormalizedSphericalMaximal_of_eq_on_sphere
    {d : ℕ} {E : Set ℝ} (hd : 0 < d) (f : Euclidean d → ℂ) (c : ℂ)
    {r : ℝ} (hr : r ∈ E) (hr_pos : 0 < r) (x : Euclidean d)
    (h : ∀ w : sphere (0 : Euclidean d) 1, f (x + r • (w : Euclidean d)) = c) :
