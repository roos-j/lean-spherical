/-- If an input is constant on one sampling sphere, its normalized spherical
average is that constant. -/
theorem normalizedSphericalAverage_eq_of_eq_on_sphere
    {d : ℕ} (hd : 0 < d) (f : Euclidean d → ℂ) (c : ℂ) (r : ℝ)
    (x : Euclidean d)
    (h : ∀ w : sphere (0 : Euclidean d) 1, f (x + r • (w : Euclidean d)) = c) :
    normalizedSphericalAverage d f r x = c := by
  rw [show normalizedSphericalAverage d f r x =
      normalizedSphericalAverage d (fun _ : Euclidean d => c) r x by
    unfold normalizedSphericalAverage sphericalAverage
    congr 1
    apply integral_congr_ae
    filter_upwards with w
    exact h w]
  exact normalizedSphericalAverage_const hd c r x

