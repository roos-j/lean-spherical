  rw [← normalizedSphericalAverage_eq_of_eq_on_sphere hd f c r x h]
  exact ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
    f hr hr_pos x

/-- If the input is one on a ball containing a sampling sphere, the
restricted maximal function is at least one at the centre of that sphere. -/
theorem one_le_restrictedNormalizedSphericalMaximal_of_eq_one_on_ball
    {d : ℕ} {E : Set ℝ} (hd : 0 < d) (f : Euclidean d → ℂ) {R r : ℝ}
    (hr : r ∈ E) (hr_pos : 0 < r) (x : Euclidean d)
    (hf : ∀ y : Euclidean d, ‖y‖ ≤ R → f y = 1)
    (hxr : ‖x‖ + |r| ≤ R) :
    1 ≤ restrictedNormalizedSphericalMaximal d E f x := by
  have hsphere : ∀ w : sphere (0 : Euclidean d) 1,
      f (x + r • (w : Euclidean d)) = 1 := by
    intro w
    apply hf
    calc
      ‖x + r • (w : Euclidean d)‖ ≤ ‖x‖ + ‖r • (w : Euclidean d)‖ := norm_add_le _ _
      _ = ‖x‖ + |r| := by
        have hw : ‖(w : Euclidean d)‖ = 1 :=
          mem_sphere_zero_iff_norm.mp w.property
        rw [norm_smul, Real.norm_eq_abs, hw, mul_one]
      _ ≤ R := hxr
  simpa using
    (ennreal_norm_const_le_restrictedNormalizedSphericalMaximal_of_eq_on_sphere
      hd f (1 : ℂ) hr hr_pos x hsphere)

/-- A smooth compactly supported test input which is one on the ball of
radius `R` and bounded by one everywhere. -/
theorem exists_schwartz_ball_test
    (d : ℕ) {R : ℝ} (hR : 0 < R) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, ‖x‖ ≤ R → f x = 1) ∧
      (∀ x, 2 * R ≤ ‖x‖ → f x = 0) ∧
      (∀ x, ‖f x‖ ≤ 1) := by
  let b : ContDiffBump (0 : Euclidean d) := ⟨R, 2 * R, hR, by linarith⟩
  let g : Euclidean d → ℂ := Complex.ofRealCLM ∘ b
  have hcompact : HasCompactSupport g := by
    exact b.hasCompactSupport.comp_left (by rfl)
  have hsmooth : ContDiff ℝ ∞ g := by
    exact Complex.ofRealCLM.contDiff.comp b.contDiff
  refine ⟨hcompact.toSchwartzMap hsmooth, ?_, ?_, ?_⟩
  · intro x hx
    change (b x : ℂ) = 1
    have hmem : x ∈ Metric.closedBall (0 : Euclidean d) b.rIn := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hx
    rw [b.one_of_mem_closedBall hmem]
    norm_num
  · intro x hx
    change (b x : ℂ) = 0
    have hdist : b.rOut ≤ dist x (0 : Euclidean d) := by
      simpa only [dist_zero_right] using hx
    rw [b.zero_of_le_dist hdist]
    norm_num
  · intro x
    change ‖(b x : ℂ)‖ ≤ 1
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg b.nonneg]
    exact b.le_one

/-- A real-valued nonnegative version of the smooth ball cutoff.  Keeping the
underlying real bump explicit lets cap lower bounds use positivity without a
cancellation argument. -/
theorem exists_schwartz_nonnegative_ball_test
    (d : ℕ) {R : ℝ} (hR : 0 < R) :
    ∃ g : Euclidean d → ℝ, ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ x, f x = (g x : ℂ)) ∧
      Continuous g ∧
      (∀ x, 0 ≤ g x) ∧
      (∀ x, g x ≤ 1) ∧
      (∀ x, ‖x‖ ≤ R → g x = 1) ∧
      (∀ x, 2 * R ≤ ‖x‖ → g x = 0) := by
  let b : ContDiffBump (0 : Euclidean d) := ⟨R, 2 * R, hR, by linarith⟩
  let g : Euclidean d → ℝ := fun x => b x
  let q : Euclidean d → ℂ := fun x => (b x : ℂ)
  have hcompact : HasCompactSupport q := by
    change HasCompactSupport (Complex.ofRealCLM ∘ b)
    exact b.hasCompactSupport.comp_left (by rfl)
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) q := by
    change ContDiff ℝ (⊤ : ℕ∞) (Complex.ofRealCLM ∘ b)
    exact Complex.ofRealCLM.contDiff.comp b.contDiff
  let f : SchwartzMap (Euclidean d) ℂ := hcompact.toSchwartzMap hsmooth
  have hgcont : Continuous g := by
    change Continuous (b : Euclidean d → ℝ)
    exact (b.contDiff (n := (⊤ : ℕ∞))).continuous
  refine ⟨g, f, ?_, hgcont, ?_, ?_, ?_, ?_⟩
  · intro x
    change q x = (g x : ℂ)
    rfl
  · intro x
    exact b.nonneg
  · intro x
    exact b.le_one
  · intro x hx
    change b x = 1
    apply b.one_of_mem_closedBall
    simpa only [Metric.mem_closedBall, dist_zero_right] using hx
  · intro x hx
    change b x = 0
    apply b.zero_of_le_dist
    simpa only [dist_zero_right] using hx

/-- A single available radius and a compact Schwartz ball test force the
restricted maximal function to be at least one throughout the smaller ball
of radius `R - r`. -/
theorem exists_schwartz_ball_test_lower_bound_on_closedBall
    {d : ℕ} {E : Set ℝ} (hd : 0 < d) {R r : ℝ}
    (hr : r ∈ E) (hr_pos : 0 < r) (hrR : r < R) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, ‖y‖ ≤ R → f y = 1) ∧
      (∀ y, 2 * R ≤ ‖y‖ → f y = 0) ∧
      (∀ x ∈ Metric.closedBall (0 : Euclidean d) (R - r),
        1 ≤ restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) := by
  rcases exists_schwartz_ball_test d (lt_trans hr_pos hrR) with
    ⟨f, hf_one, hf_zero, hf_bound⟩
  refine ⟨f, hf_one, hf_zero, ?_⟩
  intro x hx
  apply one_le_restrictedNormalizedSphericalMaximal_of_eq_one_on_ball
    hd f hr hr_pos x hf_one
  rw [Metric.mem_closedBall, dist_zero_right] at hx
  rw [abs_of_pos hr_pos]
  linarith

/-- Any weighted strong-type estimate has the following lower-testing
consequence.  This is the form used to turn geometric pointwise tests into
necessary conditions once the weighted size of the test ball is computed. -/
theorem lower_test_inequality_of_strongType
    {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α)
    (f : SchwartzMap (Euclidean d) ℂ)
    (hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p) (powerWeightedVolume d α))
    (A : Set (Euclidean d))
    (hA : ∀ x ∈ A,
      1 ≤ restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) :
    ∃ C : ℝ, 0 < C ∧
      eLpNorm (A.indicator (fun _ : Euclidean d => (1 : ENNReal)))
          (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume d α) := by
  rcases hstrong with ⟨C, hC, hstrong⟩
  refine ⟨C, hC, ?_⟩
  calc
    eLpNorm (A.indicator (fun _ : Euclidean d => (1 : ENNReal)))
        (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      apply eLpNorm_mono_enorm
      intro x
      by_cases hx : x ∈ A
      · rw [indicator_of_mem hx]
        simpa using hA x hx
      · rw [indicator_of_notMem hx]
        simp
    _ ≤ ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
        (ENNReal.ofReal p) (powerWeightedVolume d α) :=
      (hstrong f hf).2

/-- A separated finite (or infinite) collection of logarithmic radii forces
the corresponding multiplicative covering number to be at least its
cardinality.  The separation is at exactly the entropy diameter `δ`. -/
theorem encard_le_multiplicativeEntropy_of_logRadiusSet_isSeparated
    {E : Set ℝ} {S : Set ℝ} (δ : ℝ≥0)
    (hS : S ⊆ logRadiusSet E)
    (hsep : Metric.IsSeparated (δ : ENNReal) S) :
    S.encard ≤ multiplicativeEntropy E δ := by
  have htwo : 2 * (δ / 2) = δ := by
    apply NNReal.eq
    ring_nf
  calc
    S.encard ≤ Metric.packingNumber (2 * (δ / 2)) (logRadiusSet E) := by
      rw [htwo]
      exact hsep.encard_le_packingNumber hS
    _ ≤ Metric.externalCoveringNumber (δ / 2) (logRadiusSet E) :=
      Metric.packingNumber_two_mul_le_externalCoveringNumber (δ / 2) (logRadiusSet E)
    _ = multiplicativeEntropy E δ := rfl

/-- The logarithmic radius coordinate is injective on positive radii. -/
theorem logRadius_injective : Function.Injective logRadius := by
  intro r s hrs
  apply Subtype.ext
  apply Real.log_injOn_pos r.2 s.2
  change Real.log r.1 / Real.log 2 = Real.log s.1 / Real.log 2 at hrs
  exact (div_left_inj' (Real.log_pos one_lt_two).ne').mp hrs

