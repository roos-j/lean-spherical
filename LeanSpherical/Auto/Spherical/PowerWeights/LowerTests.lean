lower bound by its individual normalized average. -/
theorem ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
    {d : ℕ} {E : Set ℝ} (f : Euclidean d → ℂ) {r : ℝ}
    (hr : r ∈ E) (hr_pos : 0 < r) (x : Euclidean d) :
    ENNReal.ofReal ‖normalizedSphericalAverage d f r x‖ ≤
