/-- A compact smooth shell which is one on a prescribed radial shell and
vanishes both near the origin and outside a slightly larger shell. -/
theorem exists_schwartz_shell_test
    (d : ℕ) {r ε : ℝ} (hε : 0 < ε) (hrinner : 0 < r - 2 * ε) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, r - ε ≤ ‖y‖ → ‖y‖ ≤ r + ε → f y = 1) ∧
      (∀ y, ‖y‖ ≤ r - 2 * ε → f y = 0) ∧
      (∀ y, r + 2 * ε ≤ ‖y‖ → f y = 0) ∧
      (∀ y, ‖f y‖ ≤ 2) := by
  let bOut : ContDiffBump (0 : Euclidean d) :=
    ⟨r + ε, r + 2 * ε, by linarith, by linarith⟩
  let bIn : ContDiffBump (0 : Euclidean d) :=
    ⟨r - 2 * ε, r - ε, hrinner, by linarith⟩
  let hOut : Euclidean d → ℂ := fun y => (bOut y : ℂ)
  let hIn : Euclidean d → ℂ := fun y => (bIn y : ℂ)
  let g : Euclidean d → ℂ := fun y => hOut y * (1 - hIn y)
  have hOutcompact : HasCompactSupport hOut := by
    change HasCompactSupport (Complex.ofRealCLM ∘ bOut)
    exact bOut.hasCompactSupport.comp_left (by rfl)
  have hOutsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) hOut := by
    change ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Complex.ofRealCLM ∘ bOut)
    exact Complex.ofRealCLM.contDiff.comp bOut.contDiff
  have hInsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) hIn := by
    change ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (Complex.ofRealCLM ∘ bIn)
    exact Complex.ofRealCLM.contDiff.comp bIn.contDiff
  have hcompact : HasCompactSupport g := by
    change HasCompactSupport (fun y => hOut y * (1 - hIn y))
    exact hOutcompact.mul_right
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g := by
    change ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun y => hOut y * (1 - hIn y))
    exact hOutsmooth.mul (contDiff_const.sub hInsmooth)
  refine ⟨hcompact.toSchwartzMap hsmooth, ?_, ?_, ?_, ?_⟩
  · intro y hlow hupp
    change (bOut y : ℂ) * (1 - (bIn y : ℂ)) = 1
    have hout : y ∈ Metric.closedBall (0 : Euclidean d) bOut.rIn := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hupp
    have hin : bIn.rOut ≤ dist y (0 : Euclidean d) := by
      simpa only [dist_zero_right] using hlow
    rw [bOut.one_of_mem_closedBall hout, bIn.zero_of_le_dist hin]
    norm_num
  · intro y hy
    change (bOut y : ℂ) * (1 - (bIn y : ℂ)) = 0
    have hin : y ∈ Metric.closedBall (0 : Euclidean d) bIn.rIn := by
      simpa only [Metric.mem_closedBall, dist_zero_right] using hy
    rw [bIn.one_of_mem_closedBall hin]
    norm_num
  · intro y hy
    change (bOut y : ℂ) * (1 - (bIn y : ℂ)) = 0
    have hout : bOut.rOut ≤ dist y (0 : Euclidean d) := by
      simpa only [dist_zero_right] using hy
    rw [bOut.zero_of_le_dist hout]
    norm_num
  · intro y
    change ‖(bOut y : ℂ) * (1 - (bIn y : ℂ))‖ ≤ 2
    have houtnorm : ‖(bOut y : ℂ)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs]
      have hnon : 0 ≤ bOut y := bOut.nonneg
      have hone : bOut y ≤ 1 := bOut.le_one
      apply abs_le.2
      constructor
      · linarith
      · exact hone
    have hinnorm : ‖(bIn y : ℂ)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs]
      have hnon : 0 ≤ bIn y := bIn.nonneg
      have hone : bIn y ≤ 1 := bIn.le_one
      apply abs_le.2
      constructor
      · linarith
      · exact hone
    have hdiffnorm : ‖1 - (bIn y : ℂ)‖ ≤ 2 := by
      calc
        ‖1 - (bIn y : ℂ)‖ ≤ ‖(1 : ℂ)‖ + ‖(bIn y : ℂ)‖ := norm_sub_le _ _
        _ ≤ 1 + 1 := add_le_add (by norm_num) hinnorm
        _ = 2 := by norm_num
    calc
      ‖(bOut y : ℂ) * (1 - (bIn y : ℂ))‖ ≤
          ‖(bOut y : ℂ)‖ * ‖1 - (bIn y : ℂ)‖ := norm_mul_le _ _
      _ ≤ 1 * 2 := mul_le_mul houtnorm hdiffnorm (norm_nonneg _) (by norm_num)
      _ = 2 := by norm_num

/-- The shell test is detected with value at least one throughout the ball of
radius `ε` by the average at its central radius. -/
theorem exists_schwartz_shell_test_lower_bound_on_closedBall
    {d : ℕ} {E : Set ℝ} (hd : 0 < d) {r ε : ℝ}
    (hr : r ∈ E) (hε : 0 < ε) (hrinner : 0 < r - 2 * ε) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, r - ε ≤ ‖y‖ → ‖y‖ ≤ r + ε → f y = 1) ∧
      (∀ y, ‖y‖ ≤ r - 2 * ε → f y = 0) ∧
      (∀ y, r + 2 * ε ≤ ‖y‖ → f y = 0) ∧
      (∀ y, ‖f y‖ ≤ 2) ∧
      (∀ x ∈ Metric.closedBall (0 : Euclidean d) ε,
        1 ≤ restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) := by
  rcases exists_schwartz_shell_test d hε hrinner with
    ⟨f, hf_shell, hf_inner, hf_outer, hf_bound⟩
  refine ⟨f, hf_shell, hf_inner, hf_outer, hf_bound, ?_⟩
  have hrpos : 0 < r := by linarith
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right] at hx
  have hsphere : ∀ w : sphere (0 : Euclidean d) 1,
      f (x + r • (w : Euclidean d)) = 1 := by
    intro w
    apply hf_shell
    · have hw : ‖(w : Euclidean d)‖ = 1 :=
        mem_sphere_zero_iff_norm.mp w.property
      have htri : ‖r • (w : Euclidean d)‖ ≤
          ‖x + r • (w : Euclidean d)‖ + ‖x‖ := by
        calc
          ‖r • (w : Euclidean d)‖ = ‖(x + r • (w : Euclidean d)) - x‖ := by
            congr 1
            abel
          _ ≤ ‖x + r • (w : Euclidean d)‖ + ‖x‖ := norm_sub_le _ _
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos, hw, mul_one] at htri
      linarith
    · have hw : ‖(w : Euclidean d)‖ = 1 :=
        mem_sphere_zero_iff_norm.mp w.property
      calc
        ‖x + r • (w : Euclidean d)‖ ≤ ‖x‖ + ‖r • (w : Euclidean d)‖ := norm_add_le _ _
        _ = ‖x‖ + r := by
          rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos, hw, mul_one]
        _ ≤ r + ε := by linarith
  simpa using
    (ennreal_norm_const_le_restrictedNormalizedSphericalMaximal_of_eq_on_sphere
      hd f (1 : ℂ) hr hrpos x hsphere)

/-- A bounded Schwartz function supported in a shell bounded away from zero
belongs to every weighted `Lᵖ` space for a power weight. -/
theorem schwartz_memLp_of_shell_support
    {d : ℕ} {p α r ε : ℝ} (f : SchwartzMap (Euclidean d) ℂ)
    (hrinner : 0 < r - 2 * ε)
    (hf_inner : ∀ y, ‖y‖ ≤ r - 2 * ε → f y = 0)
    (hf_outer : ∀ y, r + 2 * ε ≤ ‖y‖ → f y = 0)
    (hf_bound : ∀ y, ‖f y‖ ≤ 2) :
    MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p) (powerWeightedVolume d α) := by
  let A : Set (Euclidean d) := euclideanAnnulus d (r - 2 * ε) (r + 2 * ε)
  have hAmeas : MeasurableSet A :=
    measurableSet_closedBall.diff measurableSet_ball
  have hAfin : powerWeightedVolume d α A < ∞ :=
    powerWeightedVolume_euclideanAnnulus_lt_top_any hrinner
  letI : IsFiniteMeasure ((powerWeightedVolume d α).restrict A) :=
    ⟨by simpa only [Measure.restrict_apply_univ] using hAfin⟩
  have hmem_restrict : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      ((powerWeightedVolume d α).restrict A) := by
    apply MemLp.of_bound (f.continuous.aestronglyMeasurable.restrict) 2
    filter_upwards with x
    exact hf_bound x
  have hmem_indicator : MemLp (A.indicator (f : Euclidean d → ℂ)) (ENNReal.ofReal p)
      (powerWeightedVolume d α) :=
    (memLp_indicator_iff_restrict hAmeas).mpr hmem_restrict
  apply (memLp_congr_ae ?_).mp hmem_indicator
  filter_upwards with x
  by_cases hx : x ∈ A
  · rw [Set.indicator_of_mem hx]
  · rw [Set.indicator_of_notMem hx]
    by_cases hxinner : x ∈ Metric.ball (0 : Euclidean d) (r - 2 * ε)
    · have hnorm : ‖x‖ ≤ r - 2 * ε := by
        rw [Metric.mem_ball, dist_zero_right] at hxinner
        exact le_of_lt hxinner
      exact (hf_inner x hnorm).symm
    · have hxouter : x ∉ Metric.closedBall (0 : Euclidean d) (r + 2 * ε) := by
        intro hclosed
        exact hx ⟨hclosed, hxinner⟩
      have hnot : ¬ ‖x‖ ≤ r + 2 * ε := by
        simpa only [Metric.mem_closedBall, dist_zero_right] using hxouter
      have hnorm : r + 2 * ε ≤ ‖x‖ := le_of_lt (lt_of_not_ge hnot)
      exact (hf_outer x hnorm).symm

/-- A nontrivial restricted spherical maximal estimate cannot use a power
weight which is non-locally finite at the origin. -/
theorem neg_dim_lt_alpha_of_restrictedStrongType
    {d : ℕ} {E : Set ℝ} {p α : ℝ} (hd : 0 < d)
    (hE : ∃ r : ℝ, r ∈ E ∧ 0 < r) (hp : 1 ≤ p)
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α) :
    -(d : ℝ) < α := by
  rcases hE with ⟨r, hrE, hrpos⟩
  by_contra hnot
  have hα : α ≤ -(d : ℝ) := le_of_not_gt hnot
  let ε : ℝ := r / 4
  have hε : 0 < ε := by
    dsimp only [ε]
    positivity
  have hrinner : 0 < r - 2 * ε := by
    dsimp only [ε]
    linarith
  rcases exists_schwartz_shell_test_lower_bound_on_closedBall
      hd hrE hε hrinner with
    ⟨f, hf_shell, hf_inner, hf_outer, hf_bound, hMf⟩
  have hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α) :=
    schwartz_memLp_of_shell_support f hrinner hf_inner hf_outer hf_bound
  rcases hstrong with ⟨C, hC, hstrong⟩
  have hMmem : MemLp (restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ)) (ENNReal.ofReal p) (powerWeightedVolume d α) :=
    (hstrong f hf).1
  have hμball : powerWeightedVolume d α
      (Metric.closedBall (0 : Euclidean d) ε) = ∞ := by
    apply top_unique
    rw [← powerWeightedVolume_ball_eq_top_of_le_neg_dim hd hα hε]
    exact measure_mono Metric.ball_subset_closedBall
  have hppos : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hpnz : ENNReal.ofReal p ≠ 0 :=
    ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hpexp : 0 < 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hindicator : eLpNorm
      ((Metric.closedBall (0 : Euclidean d) ε).indicator
        (fun _ : Euclidean d => (1 : ENNReal)))
      (ENNReal.ofReal p) (powerWeightedVolume d α) = ∞ := by
    rw [eLpNorm_indicator_const measurableSet_closedBall hpnz ENNReal.ofReal_ne_top,
      hμball, ENNReal.top_rpow_of_pos hpexp]
    simp
  have hlower : ∞ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ)) (ENNReal.ofReal p) (powerWeightedVolume d α) := by
    rw [← hindicator]
    apply eLpNorm_mono_enorm
    intro x
    by_cases hx : x ∈ Metric.closedBall (0 : Euclidean d) ε
    · rw [Set.indicator_of_mem hx]
      exact hMf x hx
    · rw [Set.indicator_of_notMem hx]
      simp
  exact (not_lt_of_ge hlower hMmem.2)

/-- The exact testing inequality used by the sharp Knapp construction.

To apply it at a dyadic entropy scale, `A` is the union of the disjoint
output tubes, `a` is their common average lower bound, `B` is the input
`Lᵖ` bound, and a geometric volume calculation supplies a lower bound for
`powerWeightedVolume d α A`.  No analytic estimate is hidden here: the three
hypotheses `hf`, `hpoint`, and `hinput` are precisely the required input,
pointwise-output, and input-size assertions. -/
theorem restrictedStrongType_knapp_test_bound
    {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α)
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α))
    {A : Set (Euclidean d)} (hAmeas : MeasurableSet A)
    {a B : ENNReal}
    (hpoint : ∀ x ∈ A, a ≤ restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x)
    (hinput : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α) ≤ B)
    (hp0 : ENNReal.ofReal p ≠ 0) :
    ∃ C : ℝ, 0 < C ∧
      a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C * B := by
  rcases hstrong with ⟨C, hC, hstrong⟩
  refine ⟨C, hC, ?_⟩
  calc
    a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) =
        eLpNorm (A.indicator (fun _ : Euclidean d => a))
          (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      rw [eLpNorm_indicator_const hAmeas hp0 ENNReal.ofReal_ne_top]
      simp
    _ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d E
        (f : Euclidean d → ℂ)) (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      apply eLpNorm_mono_enorm
      intro x
      by_cases hx : x ∈ A
      · rw [Set.indicator_of_mem hx]
        exact hpoint x hx
      · rw [Set.indicator_of_notMem hx]
        exact bot_le
    _ ≤ ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
        (ENNReal.ofReal p) (powerWeightedVolume d α) :=
      (hstrong f hf).2
    _ ≤ ENNReal.ofReal C * B := by
      simpa only [mul_comm] using mul_le_mul_left hinput (ENNReal.ofReal C)

/-- Entropy-ready form of `restrictedStrongType_knapp_test_bound`.

For a sharp dyadic construction, `N` is the cardinality of a separated set
of radii and `m` is the common weighted volume lower bound of its disjoint
output tubes.  Thus `hvolume` is exactly the finite packing and tube-volume
part of the Knapp geometry; the pointwise spherical-average computation is
still the hypothesis `hpoint`. -/
theorem restrictedStrongType_knapp_entropy_test_bound
    {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α)
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α))
    {A : Set (Euclidean d)} (hAmeas : MeasurableSet A)
    {a B N m : ENNReal}
    (hpoint : ∀ x ∈ A, a ≤ restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x)
    (hinput : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α) ≤ B)
    (hvolume : N * m ≤ powerWeightedVolume d α A)
    (hppos : 0 < p) :
    ∃ C : ℝ, 0 < C ∧
      a * (N * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤ ENNReal.ofReal C * B := by
  have hp0 : ENNReal.ofReal p ≠ 0 :=
    ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  rcases restrictedStrongType_knapp_test_bound hstrong hf hAmeas hpoint hinput hp0 with
    ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  calc
    a * (N * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) := by
      simpa only [mul_comm] using
        mul_le_mul_left (ENNReal.rpow_le_rpow hvolume hq) a
    _ ≤ ENNReal.ofReal C * B := hbound

/-- The entropy-ready Knapp test with a prescribed strong-type constant.
This is the form used when a family of test configurations must retain one
constant uniformly across all of its geometric centres. -/
theorem restrictedStrongType_knapp_entropy_test_bound_of_bound
    {d : ℕ} {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume d α) →
        MemLp (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume d α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume d α))
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α))
    {A : Set (Euclidean d)} (hAmeas : MeasurableSet A)
    {a B N m : ENNReal}
    (hpoint : ∀ x ∈ A, a ≤ restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x)
    (hinput : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α) ≤ B)
    (hvolume : N * m ≤ powerWeightedVolume d α A)
    (hppos : 0 < p) :
    a * (N * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤ ENNReal.ofReal C * B := by
  have hp0 : ENNReal.ofReal p ≠ 0 :=
    ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hmax := (hstrong f hf).2
  calc
    a * (N * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) := by
      simpa only [mul_comm] using
        mul_le_mul_left (ENNReal.rpow_le_rpow hvolume hq) a
    _ = eLpNorm (A.indicator (fun _ : Euclidean d => a))
        (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      rw [eLpNorm_indicator_const hAmeas hp0 ENNReal.ofReal_ne_top]
      simp
    _ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d E
        (f : Euclidean d → ℂ)) (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      apply eLpNorm_mono_enorm
      intro x
      by_cases hx : x ∈ A
      · rw [Set.indicator_of_mem hx]
        exact hpoint x hx
      · rw [Set.indicator_of_notMem hx]
        exact bot_le
    _ ≤ ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
        (ENNReal.ofReal p) (powerWeightedVolume d α) := hmax
    _ ≤ ENNReal.ofReal C * B := by
      simpa only [mul_comm] using mul_le_mul_left hinput (ENNReal.ofReal C)

end Auto.Spherical.PowerWeights.NecessaryConditions