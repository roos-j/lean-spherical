        (C ^ p * input / (cap ^ p * output)) *
          t ^ (-((n : ℝ) * (p - 1))) * D ^ (-α - n) := by
    have htscaleInv : t ^ ((n + 1 : ℕ) : ℝ) *
        (t ^ ((n : ℝ) * p + 1))⁻¹ =
        t ^ (-((n : ℝ) * (p - 1))) := by
      calc
        t ^ ((n + 1 : ℕ) : ℝ) * (t ^ ((n : ℝ) * p + 1))⁻¹ =
            t ^ ((n + 1 : ℕ) : ℝ) / t ^ ((n : ℝ) * p + 1) := by
              rw [ENNReal.div_eq_inv_mul]
              ring
        _ = t ^ (-((n : ℝ) * (p - 1))) := htscale
    have hDscaleInv : D * (D ^ (α + (n + 1 : ℕ)))⁻¹ =
        D ^ (-α - n) := by
      calc
        D * (D ^ (α + (n + 1 : ℕ)))⁻¹ =
            D / D ^ (α + (n + 1 : ℕ)) := by
              rw [ENNReal.div_eq_inv_mul]
              ring
        _ = D ^ (-α - n) := hDscale
    calc
      (C ^ p * (input * t ^ (n + 1) * D)) /
          ((cap * t ^ n) ^ p * (output * t * D ^ (α + (n + 1 : ℕ)))) =
          (C ^ p * input * (cap ^ p * output)⁻¹) *
            (t ^ ((n + 1 : ℕ) : ℝ) *
              (t ^ ((n : ℝ) * p + 1))⁻¹) *
            (D * (D ^ (α + (n + 1 : ℕ)))⁻¹) := by
              rw [hden, ← ENNReal.rpow_natCast t (n + 1),
                ENNReal.div_eq_inv_mul,
                ENNReal.mul_inv (Or.inl hconst0) (Or.inl hconstTop),
                ENNReal.mul_inv (Or.inl (htpow0 _)) (Or.inl (htpowTop _))]
              ring
      _ = (C ^ p * input * (cap ^ p * output)⁻¹) *
          t ^ (-((n : ℝ) * (p - 1))) * D ^ (-α - n) := by
            rw [htscaleInv, hDscaleInv]
      _ = (C ^ p * input / (cap ^ p * output)) *
          t ^ (-((n : ℝ) * (p - 1))) * D ^ (-α - n) := by
            rw [ENNReal.div_eq_inv_mul]
            ring
  exact hraw.trans_eq hquotient

/-- The homogeneous local bound becomes a pure inverse-`δ` power after the
Legendre--Assouad profile contributes its diameter factor. -/
private theorem profile_scale_identity
    {δ D p α : ℝ} {n : ℕ} (hδ : 0 < δ) (hD : 0 < D) :
    (ENNReal.ofReal D) ^ (-((n : ℝ) * (p - 2) - α)) *
        (ENNReal.ofReal (δ / D)) ^ (-((n : ℝ) * (p - 1))) *
        (ENNReal.ofReal D) ^ (-α - n) =
      (ENNReal.ofReal δ) ^ (-((n : ℝ) * (p - 1))) := by
  let x : ℝ≥0∞ := ENNReal.ofReal δ
  let y : ℝ≥0∞ := ENNReal.ofReal D
  let ρ : ℝ := (n : ℝ) * (p - 2) - α
  let T : ℝ := (n : ℝ) * (p - 1)
  have hx0 : x ≠ 0 := by
    dsimp only [x]
    exact (ENNReal.ofReal_pos.mpr hδ).ne'
  have hy0 : y ≠ 0 := by
    dsimp only [y]
    exact (ENNReal.ofReal_pos.mpr hD).ne'
  have hxTop : x ≠ (∞ : ℝ≥0∞) := by
    dsimp only [x]
    exact ENNReal.ofReal_ne_top
  have hyTop : y ≠ (∞ : ℝ≥0∞) := by
    dsimp only [y]
    exact ENNReal.ofReal_ne_top
  have hratio : ENNReal.ofReal (δ / D) = x * y⁻¹ := by
    dsimp only [x, y]
    rw [ENNReal.ofReal_div_of_pos hD, ENNReal.div_eq_inv_mul]
    ring
  have hratioPower : ENNReal.ofReal (δ / D) ^ (-T) =
      x ^ (-T) * (y ^ (-T))⁻¹ := by
    rw [hratio, ENNReal.mul_rpow_of_ne_zero hx0 (ENNReal.inv_ne_zero.mpr hyTop),
      ENNReal.inv_rpow]
  have hycancel : y ^ (-ρ) * (y ^ (-T))⁻¹ * y ^ (-α - n) = 1 := by
    have hnegT : (y ^ (-T))⁻¹ = y ^ T := by
      simpa only [ENNReal.rpow_neg, inv_inv]
    rw [hnegT]
    calc
      y ^ (-ρ) * y ^ T * y ^ (-α - n) =
          y ^ ((-ρ) + T) * y ^ (-α - n) := by
            rw [← ENNReal.rpow_add _ _ hy0 hyTop]
      _ = y ^ ((-ρ) + T + (-α - n)) := by
            rw [← ENNReal.rpow_add _ _ hy0 hyTop]
      _ = 1 := by
            have hexp : (-ρ) + T + (-α - n) = 0 := by
              dsimp only [ρ, T]
              push_cast
              ring
            rw [hexp, ENNReal.rpow_zero]
  change y ^ (-ρ) * ENNReal.ofReal (δ / D) ^ (-T) * y ^ (-α - n) = x ^ (-T)
  rw [hratioPower]
  calc
    y ^ (-ρ) * (x ^ (-T) * (y ^ (-T))⁻¹) * y ^ (-α - n) =
        x ^ (-T) * (y ^ (-ρ) * (y ^ (-T))⁻¹ * y ^ (-α - n)) := by ring
    _ = x ^ (-T) := by rw [hycancel, mul_one]

private theorem profile_bound_of_local_bound
    {N K : ℝ≥0∞} {δ D p α : ℝ} {n : ℕ}
    (hδ : 0 < δ) (hD : 0 < D)
    (hN : N ≤ K * (ENNReal.ofReal (δ / D)) ^ (-((n : ℝ) * (p - 1))) *
      (ENNReal.ofReal D) ^ (-α - n)) :
    (ENNReal.ofReal D) ^ (-((n : ℝ) * (p - 2) - α)) * N ≤
      K * (ENNReal.ofReal δ) ^ (-((n : ℝ) * (p - 1))) := by
  calc
    (ENNReal.ofReal D) ^ (-((n : ℝ) * (p - 2) - α)) * N ≤
        (ENNReal.ofReal D) ^ (-((n : ℝ) * (p - 2) - α)) *
          (K * (ENNReal.ofReal (δ / D)) ^ (-((n : ℝ) * (p - 1))) *
            (ENNReal.ofReal D) ^ (-α - n)) := by
              gcongr
    _ = K * ((ENNReal.ofReal D) ^ (-((n : ℝ) * (p - 2) - α)) *
          (ENNReal.ofReal (δ / D)) ^ (-((n : ℝ) * (p - 1))) *
          (ENNReal.ofReal D) ^ (-α - n)) := by ring
    _ = K * (ENNReal.ofReal δ) ^ (-((n : ℝ) * (p - 1))) := by
          rw [profile_scale_identity hδ hD]

/-- The cap factor for the two normalized lower tests, with the scale
`h = t / 128` removed. -/
private def negativeCapConstant (n : ℕ) : ℝ≥0∞ :=
  (ENNReal.ofReal (surfaceMass n) *
      ((ENNReal.ofReal ((1 : ℝ) / 256)) ^ (n - 2) *
        ENNReal.ofReal ((1 : ℝ) / 65536))) /
    ENNReal.ofReal (surfaceMass (n + 1))

/-- The scale-free planar cap coefficient at the lower-test radius
`h = t / 128`. -/
private def planarNegativeCapConstant (κ : ℝ≥0∞) : ℝ≥0∞ :=
  κ * ENNReal.ofReal ((1 : ℝ) / 128) / ENNReal.ofReal (surfaceMass 2)

/-- The common output slab mass after extracting its `t` and `D` powers. -/
private def negativeOutputConstant (n : ℕ) (α : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal (2 : ℝ)) ^ α *
    ((ENNReal.ofReal ((1 : ℝ) / 128)) ^ n *
      volume (ball (0 : Euclidean n) 1) *
        ENNReal.ofReal (Real.log 2 / 512))

/-- The fixed input constant in the radial-cap (subparabolic) regime. -/
private def negativeSmallInputConstant (n : ℕ) (α : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
    ((ENNReal.ofReal ((3 : ℝ) / 16)) ^ n *
      volume (ball (0 : Euclidean n) 1) * ENNReal.ofReal (12 : ℝ))

/-- The fixed input constant in the graph-tube regime. -/
private def negativeLargeInputConstant (n : ℕ) (α : ℝ) : ℝ≥0∞ :=
  (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
    ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
      volume (ball (0 : Euclidean n) 1))

private theorem negative_cap_factor_scale
    (n : ℕ) (hn : 2 ≤ n) {t : ℝ} (ht : 0 < t) :
    (ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal ((t / 128) / 2)) ^ (n - 2) *
          ENNReal.ofReal ((t / 128) ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1)) =
      negativeCapConstant n * (ENNReal.ofReal t) ^ n := by
  have ht0 : ENNReal.ofReal t ≠ 0 := (ENNReal.ofReal_pos.mpr ht).ne'
  have htTop : ENNReal.ofReal t ≠ (∞ : ℝ≥0∞) := ENNReal.ofReal_ne_top
  have hfirst : ENNReal.ofReal ((t / 128) / 2) =
      ENNReal.ofReal t * ENNReal.ofReal ((1 : ℝ) / 256) := by
    rw [show (t / 128) / 2 = t * ((1 : ℝ) / 256) by ring,
      ENNReal.ofReal_mul ht.le]
  have hsecond : ENNReal.ofReal ((t / 128) ^ 2 / 4) =
      (ENNReal.ofReal t) ^ 2 * ENNReal.ofReal ((1 : ℝ) / 65536) := by
    rw [show (t / 128) ^ 2 / 4 = t ^ 2 * ((1 : ℝ) / 65536) by ring,
      ENNReal.ofReal_mul (sq_nonneg _), ENNReal.ofReal_pow ht.le]
  rw [hfirst, hsecond, mul_pow]
  have hpow : (ENNReal.ofReal t) ^ (n - 2) * (ENNReal.ofReal t) ^ 2 =
      (ENNReal.ofReal t) ^ n := by
    rw [← pow_add, Nat.sub_add_cancel hn]
  unfold negativeCapConstant
  rw [show ENNReal.ofReal (surfaceMass n) *
      (((ENNReal.ofReal t) ^ (n - 2) *
        ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2)) *
        ((ENNReal.ofReal t) ^ 2 * ENNReal.ofReal ((1 : ℝ) / 65536))) =
      (ENNReal.ofReal (surfaceMass n) *
        (ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2) *
          ENNReal.ofReal ((1 : ℝ) / 65536))) *
        ((ENNReal.ofReal t) ^ (n - 2) * (ENNReal.ofReal t) ^ 2) by ring,
    hpow]
  simp only [div_eq_mul_inv]
  ring

private theorem planar_negative_cap_factor_scale
    (κ : ℝ≥0∞) {t : ℝ} (ht : 0 < t) :
    κ * ENNReal.ofReal (t / 128) / ENNReal.ofReal (surfaceMass 2) =
      planarNegativeCapConstant κ * ENNReal.ofReal t := by
  unfold planarNegativeCapConstant
  rw [show t / 128 = t * ((1 : ℝ) / 128) by ring,
    ENNReal.ofReal_mul ht.le]
  simp only [ENNReal.div_eq_inv_mul]
  ac_rfl

private theorem negative_output_mass_scale
    (n : ℕ) (hn : 0 < n) {α t D : ℝ}
    (ht : 0 < t) (hD : 0 < D) :
    (ENNReal.ofReal (2 * D)) ^ α *
        (volume (ball (0 : Euclidean n) (D / 128)) *
          ENNReal.ofReal (Real.log 2 * (t * D) / 512)) =
      negativeOutputConstant n α * ENNReal.ofReal t *
        (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)) := by
  have hD0 : ENNReal.ofReal D ≠ 0 := (ENNReal.ofReal_pos.mpr hD).ne'
  have hDTop : ENNReal.ofReal D ≠ (∞ : ℝ≥0∞) := ENNReal.ofReal_ne_top
  have hweight : (ENNReal.ofReal (2 * D)) ^ α =
      (ENNReal.ofReal (2 : ℝ)) ^ α * (ENNReal.ofReal D) ^ α := by
    rw [show 2 * D = (2 : ℝ) * D by ring,
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
    exact ENNReal.mul_rpow_of_ne_top ENNReal.ofReal_ne_top
      ENNReal.ofReal_ne_top α
  have hvolbase : ENNReal.ofReal (D / 128) =
      ENNReal.ofReal D * ENNReal.ofReal ((1 : ℝ) / 128) := by
    rw [show D / 128 = D * ((1 : ℝ) / 128) by ring,
      ENNReal.ofReal_mul hD.le]
  have hvol : volume (ball (0 : Euclidean n) (D / 128)) =
      (ENNReal.ofReal D) ^ n *
        ((ENNReal.ofReal ((1 : ℝ) / 128)) ^ n *
          volume (ball (0 : Euclidean n) 1)) := by
    rw [volume_ball_scale hn, hvolbase, mul_pow]
    ring
  have hlog : 0 < Real.log 2 / 512 := by positivity
  have hthick : ENNReal.ofReal (Real.log 2 * (t * D) / 512) =
      ENNReal.ofReal (Real.log 2 / 512) * ENNReal.ofReal t * ENNReal.ofReal D := by
    rw [show Real.log 2 * (t * D) / 512 = (Real.log 2 / 512) * t * D by ring,
      ENNReal.ofReal_mul (mul_nonneg hlog.le ht.le), ENNReal.ofReal_mul hlog.le]
  have hDpow : (ENNReal.ofReal D) ^ α * (ENNReal.ofReal D) ^ n *
      ENNReal.ofReal D = (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)) := by
    calc
      (ENNReal.ofReal D) ^ α * (ENNReal.ofReal D) ^ n * ENNReal.ofReal D =
          (ENNReal.ofReal D) ^ α * (ENNReal.ofReal D) ^ (n : ℝ) *
            (ENNReal.ofReal D) ^ (1 : ℝ) := by
              rw [ENNReal.rpow_natCast, ENNReal.rpow_one]
      _ = (ENNReal.ofReal D) ^ (α + (n : ℝ)) *
          (ENNReal.ofReal D) ^ (1 : ℝ) := by
            rw [ENNReal.rpow_add _ _ hD0 hDTop]
      _ = (ENNReal.ofReal D) ^ (α + (n : ℝ) + 1) := by
            rw [← ENNReal.rpow_add _ _ hD0 hDTop]
      _ = (ENNReal.ofReal D) ^ (α + (n + 1 : ℕ)) := by
            congr 1
            push_cast
            ring
  unfold negativeOutputConstant
  rw [hweight, hvol, hthick]
  calc
    ENNReal.ofReal 2 ^ α * ENNReal.ofReal D ^ α *
          (ENNReal.ofReal D ^ n *
          (ENNReal.ofReal (1 / 128) ^ n * volume (ball (0 : Euclidean n) 1)) *
            (ENNReal.ofReal (Real.log 2 / 512) * ENNReal.ofReal t * ENNReal.ofReal D)) =
        (ENNReal.ofReal 2 ^ α *
          (ENNReal.ofReal (1 / 128) ^ n * volume (ball (0 : Euclidean n) 1) *
            ENNReal.ofReal (Real.log 2 / 512))) * ENNReal.ofReal t *
          (ENNReal.ofReal D ^ α * ENNReal.ofReal D ^ n * ENNReal.ofReal D) := by
            ring
    _ = (ENNReal.ofReal 2 ^ α *
          (ENNReal.ofReal (1 / 128) ^ n * volume (ball (0 : Euclidean n) 1) *
            ENNReal.ofReal (Real.log 2 / 512))) * ENNReal.ofReal t *
          ENNReal.ofReal D ^ (α + (n + 1 : ℕ)) := by rw [hDpow]

private theorem negative_small_input_mass_upper
    (n : ℕ) (hn : 0 < n) {α t D : ℝ}
    (hα : α < 0) (ht : 0 < t) (hD : 0 < D)
    (hsmall : t * D ≤ (1 : ℝ) / 4) :
    (ENNReal.ofReal (1 - 2 * (t * D))) ^ α *
        (volume (ball (0 : Euclidean n) (6 * (t / 32))) *
          ENNReal.ofReal (12 * (t * D))) ≤
      negativeSmallInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
        ENNReal.ofReal D := by
  have hbase : (1 : ℝ) / 2 ≤ 1 - 2 * (t * D) := by linarith
  have hbasepos : 0 < 1 - 2 * (t * D) := lt_of_lt_of_le (by norm_num) hbase
  have hweightReal : (1 - 2 * (t * D)) ^ α ≤ ((1 : ℝ) / 2) ^ α :=
    Real.rpow_le_rpow_of_nonpos (by norm_num) hbase hα.le
  have hweight : (ENNReal.ofReal (1 - 2 * (t * D))) ^ α ≤
      (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α := by
    rw [ENNReal.ofReal_rpow_of_pos hbasepos,
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    exact ENNReal.ofReal_le_ofReal hweightReal
  have hvolbase : ENNReal.ofReal (6 * (t / 32)) =
      ENNReal.ofReal t * ENNReal.ofReal ((3 : ℝ) / 16) := by
    rw [show 6 * (t / 32) = t * ((3 : ℝ) / 16) by ring,
      ENNReal.ofReal_mul ht.le]
  have hvol : volume (ball (0 : Euclidean n) (6 * (t / 32))) =
      (ENNReal.ofReal t) ^ n *
        ((ENNReal.ofReal ((3 : ℝ) / 16)) ^ n *
          volume (ball (0 : Euclidean n) 1)) := by
    rw [volume_ball_scale hn, hvolbase, mul_pow]
    ring
  have hthick : ENNReal.ofReal (12 * (t * D)) =
      ENNReal.ofReal (12 : ℝ) * ENNReal.ofReal t * ENNReal.ofReal D := by
    rw [show 12 * (t * D) = (12 : ℝ) * t * D by ring,
      ENNReal.ofReal_mul (mul_nonneg (by norm_num) ht.le),
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 12)]
  have htpow : (ENNReal.ofReal t) ^ n * ENNReal.ofReal t =
      (ENNReal.ofReal t) ^ (n + 1) := by
    rw [← pow_succ]
  unfold negativeSmallInputConstant
  calc
    (ENNReal.ofReal (1 - 2 * (t * D))) ^ α *
        (volume (ball (0 : Euclidean n) (6 * (t / 32))) *
          ENNReal.ofReal (12 * (t * D))) ≤
        (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          (volume (ball (0 : Euclidean n) (6 * (t / 32))) *
            ENNReal.ofReal (12 * (t * D))) := by gcongr
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((3 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1) * ENNReal.ofReal (12 : ℝ)) *
          ((ENNReal.ofReal t) ^ n * ENNReal.ofReal t) * ENNReal.ofReal D := by
            rw [hvol, hthick]
            ring
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((3 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1) * ENNReal.ofReal (12 : ℝ)) *
          (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D := by rw [htpow]

private theorem negative_large_input_mass_upper
    (n : ℕ) (hn : 0 < n) {α t D : ℝ}
    (hα : α < 0) (ht : 0 < t) (hD : 0 < D)
    (hsmall : t * D ≤ (1 : ℝ)) :
    (ENNReal.ofReal (1 - t * D / 2)) ^ α *
        (volume (ball (0 : Euclidean n) (t / 16)) *
          ENNReal.ofReal (t * D)) ≤
      negativeLargeInputConstant n α * (ENNReal.ofReal t) ^ (n + 1) *
        ENNReal.ofReal D := by
  have hbase : (1 : ℝ) / 2 ≤ 1 - t * D / 2 := by linarith
  have hbasepos : 0 < 1 - t * D / 2 := lt_of_lt_of_le (by norm_num) hbase
  have hweightReal : (1 - t * D / 2) ^ α ≤ ((1 : ℝ) / 2) ^ α :=
    Real.rpow_le_rpow_of_nonpos (by norm_num) hbase hα.le
  have hweight : (ENNReal.ofReal (1 - t * D / 2)) ^ α ≤
      (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α := by
    rw [ENNReal.ofReal_rpow_of_pos hbasepos,
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    exact ENNReal.ofReal_le_ofReal hweightReal
  have hvolbase : ENNReal.ofReal (t / 16) =
      ENNReal.ofReal t * ENNReal.ofReal ((1 : ℝ) / 16) := by
    rw [show t / 16 = t * ((1 : ℝ) / 16) by ring,
      ENNReal.ofReal_mul ht.le]
  have hvol : volume (ball (0 : Euclidean n) (t / 16)) =
      (ENNReal.ofReal t) ^ n *
        ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
          volume (ball (0 : Euclidean n) 1)) := by
    rw [volume_ball_scale hn, hvolbase, mul_pow]
    ring
  have hthick : ENNReal.ofReal (t * D) =
      ENNReal.ofReal t * ENNReal.ofReal D :=
    ENNReal.ofReal_mul ht.le
  have htpow : (ENNReal.ofReal t) ^ n * ENNReal.ofReal t =
      (ENNReal.ofReal t) ^ (n + 1) := by
    rw [← pow_succ]
  unfold negativeLargeInputConstant
  calc
    (ENNReal.ofReal (1 - t * D / 2)) ^ α *
        (volume (ball (0 : Euclidean n) (t / 16)) *
          ENNReal.ofReal (t * D)) ≤
        (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          (volume (ball (0 : Euclidean n) (t / 16)) *
            ENNReal.ofReal (t * D)) := by gcongr
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1)) *
          ((ENNReal.ofReal t) ^ n * ENNReal.ofReal t) * ENNReal.ofReal D := by
            rw [hvol, hthick]
            ring
    _ = (ENNReal.ofReal ((1 : ℝ) / 2)) ^ α *
          ((ENNReal.ofReal ((1 : ℝ) / 16)) ^ n *
            volume (ball (0 : Euclidean n) 1)) *
          (ENNReal.ofReal t) ^ (n + 1) * ENNReal.ofReal D := by rw [htpow]

private theorem negativeCapConstant_pos (n : ℕ) (hn : 2 ≤ n) :
    0 < negativeCapConstant n := by
  unfold negativeCapConstant
  have hnum : 0 < ENNReal.ofReal (surfaceMass n) *
      (ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2) *
        ENNReal.ofReal ((1 : ℝ) / 65536)) := by
    apply ENNReal.mul_pos
    · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by omega))).ne'
    · have hsub : 0 < ENNReal.ofReal ((1 : ℝ) / 256) ^ (n - 2) *
          ENNReal.ofReal ((1 : ℝ) / 65536) := by
        apply ENNReal.mul_pos
        · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _).ne'
        · exact (ENNReal.ofReal_pos.mpr (by norm_num)).ne'
      exact hsub.ne'
  apply ENNReal.div_pos
  · exact hnum.ne'
  · exact ENNReal.ofReal_ne_top

private theorem negativeCapConstant_ne_top (n : ℕ) :
    negativeCapConstant n ≠ (∞ : ℝ≥0∞) := by
  unfold negativeCapConstant
  apply ENNReal.div_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.ofReal_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      · exact ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr
      (surfaceMass_pos (show 0 < n + 1 by omega))).ne'

private theorem planarNegativeCapConstant_pos {κ : ℝ≥0∞} (hκ : 0 < κ) :
    0 < planarNegativeCapConstant κ := by
  unfold planarNegativeCapConstant
  apply ENNReal.div_pos
  · exact (ENNReal.mul_pos (ne_of_gt hκ)
      (ENNReal.ofReal_pos.mpr (by norm_num : 0 < (1 : ℝ) / 128)).ne').ne'
  · exact ENNReal.ofReal_ne_top

private theorem planarNegativeCapConstant_ne_top {κ : ℝ≥0∞}
    (hκtop : κ ≠ (∞ : ℝ≥0∞)) :
    planarNegativeCapConstant κ ≠ (∞ : ℝ≥0∞) := by
  unfold planarNegativeCapConstant
  apply ENNReal.div_ne_top
  · exact ENNReal.mul_ne_top hκtop ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by norm_num))).ne'

private theorem negativeOutputConstant_pos (n : ℕ) (hn : 0 < n) (α : ℝ) :
    0 < negativeOutputConstant n α := by
  unfold negativeOutputConstant
  have hfirst : (ENNReal.ofReal (2 : ℝ)) ^ α ≠ 0 :=
    (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr (by norm_num))
      ENNReal.ofReal_ne_top).ne'
  have hsecond : ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
      volume (ball (0 : Euclidean n) 1) *
        ENNReal.ofReal (Real.log 2 / 512) ≠ 0 := by
    have hpos : 0 < ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
        volume (ball (0 : Euclidean n) 1) *
          ENNReal.ofReal (Real.log 2 / 512) := by
      apply ENNReal.mul_pos
      · have hsub : 0 < ENNReal.ofReal ((1 : ℝ) / 128) ^ n *
            volume (ball (0 : Euclidean n) 1) := by
          apply ENNReal.mul_pos
          · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _).ne'
          · exact (Metric.measure_ball_pos volume (0 : Euclidean n) (by norm_num)).ne'
        exact hsub.ne'
      · exact (ENNReal.ofReal_pos.mpr
          (show 0 < Real.log 2 / 512 by positivity)).ne'
    exact hpos.ne'
  apply ENNReal.mul_pos
  · exact hfirst
  · exact hsecond

private theorem negativeOutputConstant_ne_top (n : ℕ) (α : ℝ) :
