/-- The explicit cap majorant for a moving radius interval.  Its shell
thickness has one interval-width term and one ordinary dyadic term. -/
def relativeIntervalTailMajorant (n : Nat) (y : Euclidean (n + 1))
    (a b s : ℝ) (j : Nat) (A q : ENNReal) (x : Euclidean (n + 1)) : ENNReal :=
  (∑ m ∈ Finset.range (j - 3),
    A * q ^ m *
      (relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m).indicator
        (fun _ => (1 : ENNReal)) x) +
    A * q ^ (j - 3) * (ball (0 : Euclidean (n + 1)) s).indicator
      (fun _ => (1 : ENNReal)) x

