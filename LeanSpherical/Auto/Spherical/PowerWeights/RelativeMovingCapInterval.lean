    have hout_eq := lintegral_add_restrict_eq_lintegral_of_support_left_interval
      hA hB hAB (fun x : Euclidean (n + 1) => ENNReal.ofReal (Op g x)) hTout (ν := ν)
    have hin_eq := lintegral_add_restrict_eq_lintegral_of_support_right_interval
