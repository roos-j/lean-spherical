theorem restrictedRelativeBandpass_cap_shell_lintegral_two_le_of_entropy_nonneg
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
