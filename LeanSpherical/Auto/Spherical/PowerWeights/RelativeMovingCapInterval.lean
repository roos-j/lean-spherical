    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^
        (2 : ℕ)) ∂powerWeightedVolume (n + 1) α) ≤
      (ENNReal.ofReal (s / 2)) ^ α *
        ((N : ENNReal) * ENNReal.ofReal
