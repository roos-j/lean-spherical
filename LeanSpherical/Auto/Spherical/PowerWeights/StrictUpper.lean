/-- The raw local relative-band estimate needed by the strict negative
endpoint.  The constant is uniform in the normalized radius block and the
frequency band. -/
theorem exists_strictNegative_raw_band_rate
    {d : Nat} (hd : 2 ≤ d) (E : Set Real) (hE : E.Nonempty)
    (hEpos : E ⊆ Ioi (0 : Real)) {p alpha : Real}
    (hp : 1 < p) (hp2 : p < 2) (halphaLower : 1 - (d : Real) < alpha)
    (halpha : alpha < 0)
    (hstrict :
      max ((alpha : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            (((d : Real) - 1) * (p - 2) - alpha)) <
        ((((d : Real) - 1) * (p - 1) : Real) : EReal))
    (C0 C1 : Real) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean d, 1 ≤ ‖xi‖ →
      ‖surfaceFourier d xi‖ ≤ C0 / ‖xi‖ ^ (((d - 1 : Nat) : Real) / 2))
    (hderiv : ∀ xi : Euclidean d, ∀ u : Real, 1 ≤ ‖xi‖ →
      u ∈ Icc (1 : Real) 2 →
      ‖deriv (fun z : Real => surfaceFourier d (z • xi)) u‖ ≤
        C1 / ‖xi‖ ^ (((d - 1 : Nat) : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1) :
    ∃ (epsilon : Real) (K : ENNReal), 0 < epsilon ∧ K ≠ ∞ ∧
      ∀ R : Real, 0 < R → ∀ (j : Nat) (f : SchwartzMap (Euclidean d) Complex),
        (∀ x : Euclidean d,
          x ∉ euclideanAnnulus d (1 / 4 : Real) 8 → f x = 0) →
        (∫⁻ x in closedBall (0 : Euclidean d) (1 / 32 : Real),
          (restrictedRelativeBandpassSphericalMaximal d
            (normalizedRadiusBlock E R) phi j f x) ^ p ∂
            powerWeightedVolume d alpha) ≤
          (K * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) *
            (dyadicMultiplicativeScale j : ENNReal) ^ epsilon) *
            ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p ∂
              powerWeightedVolume d alpha := by
  classical
  cases d with
  | zero => omega
  | succ n =>
    have hn : 1 ≤ n := by omega
    have hdim : ((Nat.succ n : Nat) : Real) - 1 = (n : Real) := by
      rw [Nat.cast_succ]
      ring
    have halphaN : -(n : Real) < alpha := by
      have htmp : 1 - ((Nat.succ n : Nat) : Real) < alpha := halphaLower
      rw [show 1 - ((Nat.succ n : Nat) : Real) = -(n : Real) by
        rw [Nat.cast_succ]
        ring] at htmp
      exact htmp
    have hnalpha : 0 < (n : Real) + alpha := by linarith
    have hstrictN :
        max ((alpha : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
              ((n : Real) * (p - 2) - alpha)) <
          (((n : Real) * (p - 1) : Real) : EReal) := by
      simpa only [hdim] using hstrict
    have hdecayN : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
        ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : Real) / 2) := by
      simpa only [Nat.cast_succ, Nat.succ_sub_one] using hdecay
    have hderivN : ∀ xi : Euclidean (n + 1), ∀ u : Real, 1 ≤ ‖xi‖ →
        u ∈ Icc (1 : Real) 2 →
        ‖deriv (fun z : Real => surfaceFourier (n + 1) (z • xi)) u‖ ≤
          C1 / ‖xi‖ ^ ((n : Real) / 2 - 1) := by
      simpa only [Nat.cast_succ, Nat.succ_sub_one] using hderiv
    have hstrictEntropy :
        max ((alpha : EReal) + multiplicativeMinkowskiExponent E)
          (multiplicativeLegendreAssouadExponent E
            ((((Nat.succ n : Nat) : Real) - 1) * (p - 2) - alpha)) <
          (((((Nat.succ n : Nat) : Real) - 1) * (p - 1) : Real) : EReal) := by
      simpa only [hdim] using hstrictN
    obtain ⟨epsilon0, hepsilon0, hepsilon0lt, j0, hentropy⟩ :=
      exists_tail_small_scale_normalized_thinRadiusWindow_entropy_nat_bound_of_strict_implicit
        (d := Nat.succ n) (E := E) (p := p) (α := alpha)
        (by omega) hp hstrictEntropy
    let epsilon : Real := min epsilon0 (((n : Real) + alpha) / 2)
    have hepsilon : 0 < epsilon := by
      dsimp only [epsilon]
      exact lt_min hepsilon0 (by linarith)
    have hepsilon_le : epsilon ≤ epsilon0 := min_le_left _ _
    have hepsilonN : epsilon ≤ (n : Real) + alpha := by
      calc
        epsilon ≤ ((n : Real) + alpha) / 2 := min_le_right _ _
        _ ≤ (n : Real) + alpha := by linarith
    obtain ⟨Cap, hCaptop, hcap⟩ :=
      exists_strictNegative_cap_piece_raw_rate hn E hp hp2 halpha hepsilon
        hepsilon_le j0 (by simpa only [hdim] using hentropy) C0 C1 hC0 hC1 hdecayN hderivN phi
        hphiOne hphiZero hphiNorm
    have halphaShell : -((n + 1 : Nat) : Real) < alpha := by
      norm_num only [Nat.cast_add, Nat.cast_one]
      linarith
    obtain ⟨CLower, CUpper, hCLower, hCUpper, V, hVtop, hshell⟩ :=
      exists_bufferedThinRadialShell_raw_reassembly_from_two_short_of_central
        n hn phi hp halphaShell halpha.le hphiOne hphiZero
    obtain ⟨Kdeep, hKdeepTop, hdeep⟩ :=
      exists_restrictedRelativeBandpass_centralBall_lintegral_rpow_le_dyadic_annular
        n hn phi hphiOne hphiZero hphiNorm
        (a := (1 / 4 : Real)) (b := 8) (by norm_num) (by norm_num)
        halphaLower.le halpha.le hp (lt_trans hp2 (by norm_num))
    obtain ⟨Dhead, hDhead, hhead⟩ :=
      exists_restrictedRelativeBandpass_buffered_raw_central_moment
        (d := n + 1) (by omega) phi hp halpha.le
    letI : IsFiniteMeasureOnCompacts (powerWeightedVolume (n + 1) alpha) :=
      powerWeightedVolume_isFiniteMeasureOnCompacts (by omega) halphaShell
    let J0 : Nat := max 6 j0
    let Aouter : ENNReal :=
      (2 : ENNReal) ^ (p - 1) * (2 : ENNReal) ^ (p - 1)
    let Bpiece : ENNReal := (ENNReal.ofReal 2) ^ p * 2
    obtain ⟨Ktail, hKtailTop, htail⟩ :=
      exists_thinRadialShellTail_two_raw_band_rate
        (n := n) (p := p) (alpha := alpha) (epsilon := epsilon)
        V hVtop CLower CUpper hCLower hCUpper hp halpha.le
        hepsilon.le hepsilonN
    let Kcentral : ENNReal :=
      (15 : ENNReal) ^ (p - 1) * 15 * Cap * Bpiece
    let Khigh : ENNReal := Kdeep + Aouter * (Kcentral + Ktail)
    have hAouterTop : Aouter ≠ ∞ := by
      dsimp only [Aouter]
      apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) (by norm_num)
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) (by norm_num)
    have hBpieceTop : Bpiece ≠ ∞ := by
      dsimp only [Bpiece]
      apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · norm_num
    have hKcentralTop : Kcentral ≠ ∞ := by
      dsimp only [Kcentral]
      apply ENNReal.mul_ne_top
      · apply ENNReal.mul_ne_top
        · apply ENNReal.mul_ne_top
          · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) (by norm_num)
          · norm_num
        · exact hCaptop
      · exact hBpieceTop
    have hKhighTop : Khigh ≠ ∞ := by
      dsimp only [Khigh]
      apply ENNReal.add_ne_top.mpr
      constructor
      · exact ne_of_lt hKdeepTop
      · apply ENNReal.mul_ne_top hAouterTop
        exact ENNReal.add_ne_top.mpr ⟨hKcentralTop, hKtailTop⟩
    let H : Nat → ENNReal := fun l =>
      (ENNReal.ofReal (Dhead * (2 : Real) ^ l)) ^ p *
        powerWeightedVolume (n + 1) alpha
          (closedBall (0 : Euclidean (n + 1)) (1 / 32 : Real)) *
        (volume (euclideanAnnulus (n + 1) (1 / 4 : Real) 8)) ^ (p - 1) *
        ((ENNReal.ofReal (8 : Real)) ^ alpha)⁻¹
    have hballTop :
        powerWeightedVolume (n + 1) alpha
          (closedBall (0 : Euclidean (n + 1)) (1 / 32 : Real)) < ∞ := by
      exact measure_closedBall_lt_top
    have hannulusTop : volume (euclideanAnnulus (n + 1) (1 / 4 : Real) 8) ≠ ∞ := by
      have hsub : euclideanAnnulus (n + 1) (1 / 4 : Real) 8 ⊆
          closedBall (0 : Euclidean (n + 1)) (8 : Real) := by
        intro x hx
        exact hx.1
      apply ne_of_lt
      exact (measure_mono hsub).trans_lt
        (measure_closedBall_lt_top :
          volume (closedBall (0 : Euclidean (n + 1)) (8 : Real)) < ∞)
    have hHtop (l : Nat) : H l ≠ ∞ := by
      dsimp only [H]
      apply ENNReal.mul_ne_top
      · apply ENNReal.mul_ne_top
        · apply ENNReal.mul_ne_top
          · exact ENNReal.rpow_ne_top_of_nonneg (lt_trans zero_lt_one hp).le
              ENNReal.ofReal_ne_top
