  have hmoment (mu : Int) (hmu : mu ∈ U) :
      (∫⁻ x in B,
        (restrictedRelativeBandpassSphericalMaximal (n + 1)
          (E ∩ thinRadiusWindow s mu) phi j
          (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x) ^ p ∂
          powerWeightedVolume (n + 1) α) ≤
        (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p *
          powerWeightedVolume (n + 1) α B := by
    let P : Euclidean (n + 1) → ENNReal := fun x =>
      restrictedRelativeBandpassSphericalMaximal (n + 1)
        (E ∩ thinRadiusWindow s mu) phi j
        (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
          SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x
    calc
      (∫⁻ x in B, (P x) ^ p ∂powerWeightedVolume (n + 1) α) =
          ∫⁻ x, B.indicator (fun x => (P x) ^ p) x ∂
            powerWeightedVolume (n + 1) α := by
              rw [lintegral_indicator hB]
      _ ≤ ∫⁻ x, B.indicator (fun _ : Euclidean (n + 1) =>
          (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p) x ∂
            powerWeightedVolume (n + 1) α := by
              apply lintegral_mono
              intro x
              by_cases hx : x ∈ B
              · simp only [Set.indicator_of_mem hx]
                exact ENNReal.rpow_le_rpow (hpoint mu hmu x hx)
                  (lt_trans zero_lt_one hp).le
              · simp [hx]
      _ = ∫⁻ _x in B, (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p ∂
          powerWeightedVolume (n + 1) α := by
            rw [lintegral_indicator hB]
      _ = (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p *
          powerWeightedVolume (n + 1) α B := setLIntegral_const _ _
  have hmass := finset_scaled_thinRadialPartition_tail_mass_rpow_le
    (d := n + 1) (by omega) hp hα hs f hfsupport M U
      (fun mu => thinRadialUpperDistanceBlock M mu q) Q (2 ^ (q + 1))
      (by positivity)
      (fun mu hmu => thinRadialUpperDistanceBlock_card_le M mu q)
      (fun r hr => thinRadialUpperDistanceBlock_column_card_le M U r q)
      (by
        intro mu hmu r hr
        exact (Finset.mem_filter.mp hr).1)
      hMpositive
  calc
    (∑ mu ∈ U, ∫⁻ x in B,
      (restrictedRelativeBandpassSphericalMaximal (n + 1)
        (E ∩ thinRadiusWindow s mu) phi j
        (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
          SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x) ^ p ∂
          powerWeightedVolume (n + 1) α) ≤
        ∑ mu ∈ U, (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p *
          powerWeightedVolume (n + 1) α B := by
            gcongr with mu hmu
            exact hmoment mu hmu
    _ = (∑ mu ∈ U,
        (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p) *
          powerWeightedVolume (n + 1) α B := by
          rw [Finset.sum_mul]
    _ ≤
        (Q ^ p * ((2 ^ (q + 1) : Nat) : ENNReal) ^ p *
          ((ENNReal.ofReal (surfaceMass (n + 1)) *
              (ENNReal.ofReal (8 : Real)) ^ ((n + 1) - 1) *
              ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
            ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
              ((ENNReal.ofReal 2) ^ p * 2) *
                ∫⁻ y : Euclidean (n + 1), ‖f y‖ₑ ^ p ∂
                  powerWeightedVolume (n + 1) α) *
          powerWeightedVolume (n + 1) α B := by
            simpa only [mul_comm] using mul_le_mul_left hmass
              (powerWeightedVolume (n + 1) α B)
    _ = _ := by
      dsimp only [Q, ell]
      ring

