                SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
                  (thinRadialPartition (n + 1) s hs r)) x := by rw [zero_add]
      _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1)
            (E ∩ thinRadiusWindow s mu) phi j
            (0 : SchwartzMap (Euclidean (n + 1)) Complex) x +
