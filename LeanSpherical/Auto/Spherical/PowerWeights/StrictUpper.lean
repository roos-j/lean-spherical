/-- The upper off-window tails in one actual dyadic distance block have a
summed weighted moment.  Unlike the older common-tail estimate, this keeps
the individual thin input masses through the finite row/column convolution. -/
theorem exists_upperDistanceBlock_tail_lintegral_rpow_sum_le
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j k q : Nat)
      (f : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      (M : Finset Nat) (U : Finset Int) {s α p : Real}
      (a b : Int → Real) (B : Set (Euclidean (n + 1))),
      4 ≤ j → k + 1 ≤ j → 1 < p → α ≤ 0 → (hs : 0 < s) →
      (hscale : s = ((2 : Real) ^ k)⁻¹) →
      (∀ y : Euclidean (n + 1),
        y ∉ euclideanAnnulus (n + 1) (1 / 4) 8 → f y = 0) →
      (∀ r ∈ M, 0 < s * ((r : Real) - 1 / 4)) →
      (∀ mu ∈ U,
        (E ∩ thinRadiusWindow s mu) ⊆ Icc (a mu) (b mu) ∧
          a mu ≤ b mu ∧ 1 ≤ a mu ∧ b mu ≤ 2 ∧
          b mu - a mu ≤ 3 * s ∧ b mu ≤ s * ((mu : Real) + 2)) →
      MeasurableSet B → B ⊆ ball 0 s →
      (∑ mu ∈ U, ∫⁻ x in B,
        (restrictedRelativeBandpassSphericalMaximal (n + 1)
          (E ∩ thinRadiusWindow s mu) phi j
          (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
               (thinRadialPartition (n + 1) s hs r)) x) ^ p ∂
          powerWeightedVolume (n + 1) α) ≤
        powerWeightedVolume (n + 1) α B *
          (((j : ENNReal) *
              (ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^
                  thinRadialDistanceCutoff j k q) +
            ENNReal.ofReal (C * (2 : Real) ^ j) *
              (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) ^ p *
          ((2 ^ (q + 1) : Nat) : ENNReal) ^ p *
          ((ENNReal.ofReal (surfaceMass (n + 1)) *
              (ENNReal.ofReal (8 : Real)) ^ ((n + 1) - 1) *
              ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
            ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
              ((ENNReal.ofReal 2) ^ p * 2) *
                 ∫⁻ y : Euclidean (n + 1), ‖f y‖ₑ ^ p ∂
                   powerWeightedVolume (n + 1) α) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j k q f E M U s α p a b B hj hk hp hα hs hscale hfsupport hMpositive hwindow hB hBball
  let ell : Nat := thinRadialDistanceCutoff j k q
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : Real) ^ j) *
          (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : Real) ^ j) *
        (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  let A : Nat → ENNReal := fun r =>
    ∫⁻ y : Euclidean (n + 1),
      ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
        (thinRadialPartition (n + 1) s hs r)) y‖ₑ
  have hpositive (r : Nat) (hr : r ∈ M) :
      0 < s * ((r : Real) - 1 / 4) := by
    exact hMpositive r hr
  have hpoint (mu : Int) (hmu : mu ∈ U) (x : Euclidean (n + 1))
      (hx : x ∈ B) :
      restrictedRelativeBandpassSphericalMaximal (n + 1)
        (E ∩ thinRadiusWindow s mu) phi j
        (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
          SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x ≤
        Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r := by
    obtain ⟨hEsub, hab, ha, hb, hwidth, hbwindow⟩ := hwindow mu hmu
    have hraw := htail j f (0 : SchwartzMap (Euclidean (n + 1)) Complex)
      (E ∩ thinRadiusWindow s mu) (a := a mu) (b := b mu) (s := s)
