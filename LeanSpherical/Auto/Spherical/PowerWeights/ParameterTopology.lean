    Tendsto (fun k => (q k).2 / (q k).1) atTop (𝓝 (z.2 / z.1)) := by
  exact ((continuous_snd.tendsto z).comp hq).div
    ((continuous_fst.tendsto z).comp hq) hz

/-- The finite-exponent coordinates determine the exponent and weight once
the first coordinate is positive. -/
theorem exponent_weight_eq_coordinates
    {p α x y : ℝ} (hp : 0 < p) (hx : x = p⁻¹) (hy : y = α / p) :
    p = x⁻¹ ∧ α = y / x := by
  constructor
  · rw [hx, inv_inv]
  · rw [hx, hy]
    field_simp

/-- A finite admissible point obeys the two coordinate bounds that converge
