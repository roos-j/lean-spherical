/-- The implicit parameter region, including its limiting vertical face, is
closed.  The proof uses the affine bounds for the zero-axis case and the
Lipschitz entropy representative at positive first coordinate. -/
theorem isClosed_powerWeightAdmissibleRegion
    {d : ℕ} {E : Set ℝ}
    (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ)) :
    IsClosed (powerWeightAdmissibleRegion d E) := by
  apply IsSeqClosed.isClosed
  intro q z hq hqz
  have hfst : Tendsto (fun k => (q k).1) atTop (𝓝 z.1) :=
    (continuous_fst.tendsto z).comp hqz
  have hnonnegSeq : ∀ᶠ k in atTop, (0 : ℝ) ≤ (q k).1 :=
    Filter.Eventually.of_forall fun k =>
      powerWeightAdmissible_first_nonneg (d := d) (E := E) (q := q k) (hq k)
  have hnonneg : 0 ≤ z.1 :=
    ge_of_tendsto hfst hnonnegSeq
  by_cases hzzero : z.1 = 0
  · exact Or.inl <|
      mem_verticalFace_of_tendsto_of_coordinate_bounds hqz
        (fun k => powerWeightAdmissible_coordinate_bounds hE hEpos (hq k)) hzzero
  have hzpos : 0 < z.1 := lt_of_le_of_ne hnonneg (Ne.symm hzzero)
  have hpos_event : ∀ᶠ k in atTop, 0 < (q k).1 :=
    hfst.eventually (eventually_gt_nhds hzpos)
  rcases eventually_atTop.1 hpos_event with ⟨K, hK⟩
  have hKfinite :
      ∃ p α : ℝ, 1 ≤ p ∧ (q K).1 = p⁻¹ ∧ (q K).2 = α / p ∧
        powerWeightEntropyImplicitCondition d E p α := by
    rcases hq K with hvertical | hfinite
    · exfalso
      change (q K).1 = 0 ∧ (q K).2 ∈ Icc (0 : ℝ) ((d : ℝ) - 1) at hvertical
      have hposK := hK K le_rfl
      rw [hvertical.1] at hposK
      exact (lt_irrefl (0 : ℝ)) hposK
    · exact hfinite
  rcases hKfinite with ⟨p₀, α₀, hp₀, hK1, hK2, hbase⟩
  let q' : ℕ → ℝ × ℝ := fun k => q (k + K)
  have hq' : Tendsto q' atTop (𝓝 z) :=
    hqz.comp (tendsto_add_atTop_nat K)
  have hq'pos (k : ℕ) : 0 < (q' k).1 := hK (k + K) (Nat.le_add_left K k)
  have hq'finite (k : ℕ) :
      ∃ p α : ℝ, 1 ≤ p ∧ (q' k).1 = p⁻¹ ∧ (q' k).2 = α / p ∧
        powerWeightEntropyImplicitCondition d E p α := by
    rcases hq (k + K) with hvertical | hfinite
    · exfalso
      change (q (k + K)).1 = 0 ∧
        (q (k + K)).2 ∈ Icc (0 : ℝ) ((d : ℝ) - 1) at hvertical
      have hpos := hq'pos k
      change 0 < (q (k + K)).1 at hpos
      rw [hvertical.1] at hpos
      exact (lt_irrefl (0 : ℝ)) hpos
    · exact hfinite
  let u : ℕ → ℝ := fun k => (q' k).1⁻¹
  let v : ℕ → ℝ := fun k => (q' k).2 / (q' k).1
  have hu : Tendsto u atTop (𝓝 z.1⁻¹) := by
    simpa only [u] using tendsto_fst_inv_of_tendsto_prod hq' hzzero
  have hv : Tendsto v atTop (𝓝 (z.2 / z.1)) := by
    simpa only [v] using tendsto_snd_div_fst_of_tendsto_prod hq' hzzero
  have hu_one (k : ℕ) : 1 ≤ u k := by
    rcases hq'finite k with ⟨pk, ak, hpk, hk1, hk2, hkcondition⟩
    have hpk0 : 0 < pk := lt_of_lt_of_le zero_lt_one hpk
    have hcoord := exponent_weight_eq_coordinates hpk0 hk1 hk2
    simpa only [u, hcoord.1] using hpk
  have hcondition (k : ℕ) :
      powerWeightEntropyImplicitCondition d E (u k) (v k) := by
    rcases hq'finite k with ⟨pk, ak, hpk, hk1, hk2, hkcondition⟩
    have hpk0 : 0 < pk := lt_of_lt_of_le zero_lt_one hpk
    have hcoord := exponent_weight_eq_coordinates hpk0 hk1 hk2
    simpa only [u, v, hcoord.1, hcoord.2] using hkcondition
  have hlimit :
      powerWeightEntropyImplicitCondition d E z.1⁻¹ (z.2 / z.1) :=
    powerWeightEntropyImplicitCondition_of_tendsto hE hEpos hbase hu hv hcondition
  have hp_limit : 1 ≤ z.1⁻¹ :=
    ge_of_tendsto hu (Filter.Eventually.of_forall hu_one)
  refine Or.inr ⟨z.1⁻¹, z.2 / z.1, hp_limit, ?_, ?_, hlimit⟩
  · simp only [inv_inv]
  · field_simp

/-- The analytic necessary condition gives the easy inclusion of the
closure of the strong-type set into the closed admissible region. -/
theorem closure_typeSet_subset_powerWeightAdmissibleRegion_of_necessary
    {d : ℕ} {E : Set ℝ}
    (hE : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (hnecessary : ∀ ⦃p α : ℝ⦄, 1 ≤ p →
      HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α →
        powerWeightEntropyImplicitCondition d E p α) :
    closure (restrictedNormalizedSphericalMaximalPowerWeightTypeSet d E) ⊆
      powerWeightAdmissibleRegion d E := by
  apply closure_minimal
  · intro q hq
    rcases hq with ⟨p, α, hp, hq1, hq2, hstrong⟩
    exact Or.inr ⟨p, α, hp, hq1, hq2, hnecessary hp hstrong⟩
  · exact isClosed_powerWeightAdmissibleRegion hE hEpos

