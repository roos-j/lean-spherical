/-- Taking reciprocal of the first coordinate is continuous along a sequence
whose limit has positive first coordinate. -/
theorem tendsto_fst_inv_of_tendsto_prod
    {q : ℕ → ℝ × ℝ} {z : ℝ × ℝ}
    (hq : Tendsto q atTop (𝓝 z)) (hz : z.1 ≠ 0) :
    Tendsto (fun k => (q k).1⁻¹) atTop (𝓝 z.1⁻¹) := by
  exact ((continuous_fst.tendsto z).comp hq).inv₀ hz

/-- Dividing the second coordinate by the first is continuous along a
sequence whose limiting first coordinate is nonzero. -/
theorem tendsto_snd_div_fst_of_tendsto_prod
    {q : ℕ → ℝ × ℝ} {z : ℝ × ℝ}
