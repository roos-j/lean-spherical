      ENNReal.ofReal s * volume {x | ENNReal.ofReal s <
        lacunaryRelativeBandpassPhysicalMaximalAll psi j r f x} ≤ C * J := by
  let u : ℤ → Euclidean d → ℝ := fun k x =>
    ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ) f x‖
  have hbound : ∀ (S : Finset ℤ) (hS : S.Nonempty) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x | s < S.sup' hS (fun k => u k x)} ≤ C * J := by
    intro S hS s hs
    simpa only [u, lacunaryRelativeBandpassFinitePhysicalMaximal] using
      hfinite S hS hs
  intro s hs
  have h := weak_one_iSup_int_exhaustion u C J hbound (s := s) hs
  simpa only [u, lacunaryRelativeBandpassPhysicalMaximalAll] using h

/-- The finite physical lacunary maximum has the strong intermediate
`Lᵖ` moment supplied by its weak-one and weak-two endpoints.  The rational
height split stays in the Schwartz class, which is why this can be applied
directly to the literal finite C--Z operator. -/
theorem lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_weak_one_two
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C₁ C₂ : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (g : Euclidean d → ℂ) x} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hweak_two : ∀ (g : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal (s ^ (2 : ℕ)) * volume {x |
        s < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (g : Euclidean d → ℂ) x} ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)))
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x, ENNReal.ofReal
      ((lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x) ^ p)) ≤
      ENNReal.ofReal p *
        (4 * C₂ *
            (((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) +
          2 * C₁ *
            (((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) := by
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hprofiles :=
    measurable_rational_low_high_profile_lintegrals f low high hlow hhigh (μ := volume)
  have htail2 :=
    rational_schwartz_low_weighted_tail f low high hlow hhigh hp1 hp2
  have htail1 :=
    rational_schwartz_high_weighted_tail f low high hlow hhigh hp1 hp2
  let A₂ : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  let A₁ : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ +
      (ENNReal.ofReal (3 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  have hinterp := marcinkiewicz_weak_one_two_on_additive_split
    (Set.univ : Set (SchwartzMap (Euclidean d) ℂ))
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ))
    (fun g x => lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
      (g : Euclidean d → ℂ) x)
    (fun g x => lacunaryRelativeBandpassFinitePhysicalMaximal_nonneg psi j r S hS
      (g : Euclidean d → ℂ) x)
    (by
      intro g h _ _
      filter_upwards with x
      exact lacunaryRelativeBandpassFinitePhysicalMaximal_add_schwartz_le
        psi j r S hS g h x)
    C₁ C₂
    (by
      intro g _ s hs
      exact hweak_one g hs)
    (by
      intro g _ s hs
      exact hweak_two g hs)
    hp1 hp2 f
    (aemeasurable_lacunaryRelativeBandpassFinitePhysicalMaximal_schwartz
      psi j r S hS f)
    low high
    (by intro t; simp) (by intro t; simp)
    (by
      intro t
      ext x
      exact hsplit t x)
    hprofiles.1 hprofiles.2
    A₂ A₁
    htail2 htail1
  simpa only [A₂, A₁] using hinterp

/-- The scaled form of the finite physical lacunary interpolation estimate.
The freely chosen splitting scale is recorded explicitly, since balancing it
against the frequency scale is what produces the summable high-frequency
bound. -/
theorem lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_weak_one_two_scaled
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C₁ C₂ : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean d) ℂ) {t : ℝ}, 0 < t →
      ENNReal.ofReal t * volume {x |
        t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (g : Euclidean d → ℂ) x} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hweak_two : ∀ (g : SchwartzMap (Euclidean d) ℂ) {t : ℝ}, 0 < t →
      ENNReal.ofReal (t ^ (2 : ℕ)) * volume {x |
        t < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (g : Euclidean d → ℂ) x} ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)))
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) ℂ) (s : ℝ) (hs : 0 < s) :
    (∫⁻ x, ENNReal.ofReal
      ((lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x) ^ p)) ≤
      ENNReal.ofReal p *
        (4 * C₂ *
            ((ENNReal.ofReal s) ^ (2 - p) *
              ((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) +
          2 * C₁ *
            ((ENNReal.ofReal s) ^ (1 - p) *
              (((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p))) := by
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hprofiles :=
    measurable_rational_low_high_profile_lintegrals f low high hlow hhigh (μ := volume)
  have htail2 :=
    rational_schwartz_low_weighted_tail f low high hlow hhigh hp1 hp2
  have htail1 :=
    rational_schwartz_high_weighted_tail f low high hlow hhigh hp1 hp2
  let A₂ : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  let A₁ : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ +
      (ENNReal.ofReal (3 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  have hinterp := marcinkiewicz_weak_one_two_on_additive_split_scaled
    (Set.univ : Set (SchwartzMap (Euclidean d) ℂ))
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ))
    (fun g x => lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
      (g : Euclidean d → ℂ) x)
    (fun g x => lacunaryRelativeBandpassFinitePhysicalMaximal_nonneg psi j r S hS
      (g : Euclidean d → ℂ) x)
    (by
      intro g h _ _
      filter_upwards with x
      exact lacunaryRelativeBandpassFinitePhysicalMaximal_add_schwartz_le
        psi j r S hS g h x)
    C₁ C₂
    (by
      intro g _ t ht
      exact hweak_one g ht)
    (by
      intro g _ t ht
      exact hweak_two g ht)
    hp1 hp2 f
    (aemeasurable_lacunaryRelativeBandpassFinitePhysicalMaximal_schwartz
      psi j r S hS f)
    low high
    (by intro t; simp) (by intro t; simp)
    (by
      intro t
      ext x
      exact hsplit t x)
    hprofiles.1 hprofiles.2
    A₂ A₁
    htail2 htail1 s hs
  simpa only [A₂, A₁] using hinterp

private theorem lacunaryRelativeBandpassFinitePhysical_raw_le_lacunary
    {d : Nat} (phi psi f : SchwartzMap (Euclidean d) ℂ)
    (hpsi : ∀ ξ : Euclidean d, psi ξ = phi ((2 : ℝ)⁻¹ • ξ) - phi ξ)
    (j : Nat) (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (x : Euclidean d) :
    ENNReal.ofReal
      (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x) ≤
      lacunaryRelativeBandpassSphericalMaximal d r phi j f x := by
  obtain ⟨k, hk, hmax⟩ := S.exists_mem_eq_sup' hS (fun k =>
    ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
      (f : Euclidean d → ℂ) x‖)
  rw [show lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
      (f : Euclidean d → ℂ) x = S.sup' hS (fun k =>
        ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
          (f : Euclidean d → ℂ) x‖) by rfl,
    hmax]
  rw [lacunaryRelativeBandpassPhysicalTerm_eq_relative_bandpass
    phi psi f hpsi j (r k).2]
  unfold lacunaryRelativeBandpassSphericalMaximal
  exact le_iSup (fun k : ℤ => ENNReal.ofReal
    ‖𝓕⁻ (fun ξ : Euclidean d =>
      surfaceFourier d (-(r k : ℝ) • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • ((r k : ℝ) • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • ((r k : ℝ) • ξ))) *
        𝓕 (f : Euclidean d → ℂ) ξ) x‖) k

/-- The square-function estimate for a dyadic radius selector gives the
Schwartz-core `L²` bound required by the finite physical C--Z endpoint.
The comparison is made before taking `toReal`, and the all-radius square
estimate supplies the necessary almost-everywhere finiteness. -/
theorem exists_lacunaryRelativeBpFinitePhysical_core_bound_of_isDyLacunaryRadSelector
    {n : Nat} (hn : 1 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ s : ℝ, 1 ≤ ‖xi‖ →
      s ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun t : ℝ => surfaceFourier (n + 1) (t • xi)) s‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ ξ : Euclidean (n + 1),
      psi ξ = phi ((2 : ℝ)⁻¹ • ξ) - phi ξ)
    (j : Nat) (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (S : Finset ℤ) (hS : S.Nonempty) :
    ∃ hcoreMem : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
        MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean (n + 1) → ℂ)) 2 volume,
      ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
        ‖(hcoreMem f).toLp
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean (n + 1) → ℂ))‖ ≤
          (12 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))) *
            ‖f.toLp 2 volume‖ := by
  let A : ℝ := (4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)
  let C : ℝ := 12 * A
  have hApos : 0 < A := by
    dsimp only [A]
    exact div_pos (mul_pos (by norm_num) hC0)
      (Real.rpow_pos_of_pos (Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j) _)
  have hdata (f : SchwartzMap (Euclidean (n + 1)) ℂ) :
      ∃ hcoreMem : MemLp
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean (n + 1) → ℂ)) 2 volume,
        ‖hcoreMem.toLp
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean (n + 1) → ℂ))‖ ≤ C * ‖f.toLp 2 volume‖ := by
    let L : Euclidean (n + 1) → ENNReal :=
      lacunaryRelativeBandpassSphericalMaximal (n + 1) r phi j f
    let G : Euclidean (n + 1) → ENNReal := fun x =>
      ⨆ s : Ioi (0 : ℝ), ENNReal.ofReal
        ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-s.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • ξ))) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖
    have hLtwo := memLp_two_lacunaryRelativeBandpass_global_of_isDyadicLacunaryRadiusSelector
      hn C0 C1 hC0 hC1 hdecay hderiv phi hphi_one hphi_zero hphi_norm j r hr f
    have hGfinite : ∀ᵐ x : Euclidean (n + 1) ∂volume, G x < ⊤ := by
      simpa only [G] using
        ae_lt_top_iSup_relative_dyadic_moving_bandpass_global_of_sharp
          hn C0 C1 hC0 hC1 hdecay hderiv phi f hphi_one hphi_zero hphi_norm j
    have hLleG (x : Euclidean (n + 1)) : L x ≤ G x := by
      unfold L G lacunaryRelativeBandpassSphericalMaximal
      apply iSup_le
      intro k
      exact le_iSup
        (fun s : Ioi (0 : ℝ) => ENNReal.ofReal
          ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
            surfaceFourier (n + 1) (-s.1 • ξ) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • ξ)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖)
        ⟨r k, (r k).2⟩
    have hfiniteL (x : Euclidean (n + 1)) :
        ENNReal.ofReal
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean (n + 1) → ℂ) x) ≤ L x := by
      simpa only [L] using
        lacunaryRelativeBandpassFinitePhysical_raw_le_lacunary
          phi psi f hpsi j r S hS x
    have hcoreMem : MemLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean (n + 1) → ℂ)) 2 volume := by
      refine MemLp.of_enorm_le_mul (c := (1 : NNReal)) hLtwo.1
        (aemeasurable_lacunaryRelativeBandpassFinitePhysicalMaximal_schwartz
          psi j r S hS f).aestronglyMeasurable ?_
      filter_upwards [hGfinite] with x hx
      have hGtop : G x ≠ ⊤ := ne_of_lt hx
      have hLtop : L x ≠ ⊤ := ne_top_of_le_ne_top hGtop (hLleG x)
      have hreal : lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean (n + 1) → ℂ) x ≤ (L x).toReal :=
        (ENNReal.ofReal_le_iff_le_toReal hLtop).mp (hfiniteL x)
      rw [Real.enorm_of_nonneg
        (lacunaryRelativeBandpassFinitePhysicalMaximal_nonneg psi j r S hS
          (f : Euclidean (n + 1) → ℂ) x),
        Real.enorm_of_nonneg ENNReal.toReal_nonneg]
      simpa using ENNReal.ofReal_le_ofReal hreal
    have hpoint : ∀ᵐ x : Euclidean (n + 1) ∂volume,
        ‖hcoreMem.toLp
            (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
              (f : Euclidean (n + 1) → ℂ)) x‖ ≤
          ‖(hLtwo.1).toLp (fun x => (L x).toReal) x‖ := by
      filter_upwards [hcoreMem.coeFn_toLp, hLtwo.1.coeFn_toLp, hGfinite]
        with x hP hL hx
      have hGtop : G x ≠ ⊤ := ne_of_lt hx
      have hLtop : L x ≠ ⊤ := ne_top_of_le_ne_top hGtop (hLleG x)
      have hreal : lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean (n + 1) → ℂ) x ≤ (L x).toReal :=
        (ENNReal.ofReal_le_iff_le_toReal hLtop).mp (hfiniteL x)
      rw [hP, hL, Real.norm_of_nonneg
        (lacunaryRelativeBandpassFinitePhysicalMaximal_nonneg psi j r S hS
          (f : Euclidean (n + 1) → ℂ) x),
        Real.norm_of_nonneg ENNReal.toReal_nonneg]
      exact hreal
    have hphysicalNorm : ‖hcoreMem.toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean (n + 1) → ℂ))‖ ≤
        ‖(hLtwo.1).toLp (fun x => (L x).toReal)‖ :=
      Lp.norm_le_norm_of_ae_le hpoint
    have hselectorNorm : ‖(hLtwo.1).toLp (fun x => (L x).toReal)‖ ≤
        C * ‖f.toLp 2 volume‖ := by
      have hLnorm : ‖(hLtwo.1).toLp (fun x => (L x).toReal)‖ =
          √(∫ x : Euclidean (n + 1), ‖(L x).toReal‖ ^ 2) :=
        norm_toLp_two_eq_sqrt_integral_norm_sq_general volume
          (fun x => (L x).toReal) hLtwo.1
      have hfnorm : ‖f.toLp 2 volume‖ =
          √(∫ x : Euclidean (n + 1), ‖f x‖ ^ 2) :=
        norm_toLp_two_eq_sqrt_integral_norm_sq_general volume
          (f : Euclidean (n + 1) → ℂ) (f.memLp 2 volume)
      rw [hLnorm, hfnorm]
      have hbound : (∫ x : Euclidean (n + 1), ‖(L x).toReal‖ ^ 2) ≤
          144 * A ^ 2 * ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2 := by
        simpa only [L, A] using hLtwo.2
      calc
        √(∫ x : Euclidean (n + 1), ‖(L x).toReal‖ ^ 2) ≤
            √(144 * A ^ 2 * ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2) :=
          Real.sqrt_le_sqrt hbound
        _ = (12 * A) * √(∫ x : Euclidean (n + 1), ‖f x‖ ^ 2) := by
          rw [show 144 * A ^ 2 * ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2 =
              (12 * A) ^ 2 * ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2 by ring,
            Real.sqrt_mul (sq_nonneg (12 * A)), Real.sqrt_sq_eq_abs,
            abs_of_nonneg (by positivity)]
        _ = C * √(∫ x : Euclidean (n + 1), ‖f x‖ ^ 2) := by rfl
    exact ⟨hcoreMem, hphysicalNorm.trans hselectorNorm⟩
  choose hcoreMem hcoreBound using hdata
  simpa only [C, A] using ⟨hcoreMem, hcoreBound⟩

/-- Combining the literal finite C--Z weak-one estimate with the selector
square estimate gives a uniform strong intermediate moment for every finite
truncation.  The constant is independent of the truncation `S`; this is the
form needed for countable-scale exhaustion. -/
theorem lacunaryRelativeBpFinitePhysical_lintegral_rpow_of_isDyLacunaryRadSelector
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ s : ℝ, 1 ≤ ‖xi‖ →
      s ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun t : ℝ => surfaceFourier (n + 1) (t • xi)) s‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ ξ : Euclidean (n + 1),
      psi ξ = phi ((2 : ℝ)⁻¹ • ξ) - phi ξ)
    (j : Nat) (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (S : Finset ℤ) (hS : S.Nonempty)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ) :
    let C : ℝ := 12 *
        ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))
    let I : ENNReal := ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p
    let A₂ : ENNReal :=
      (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
        (ENNReal.ofReal (2 - p))⁻¹) * I
    let A₁ : ENNReal :=
      ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) * I
    (∫⁻ x, ENNReal.ofReal
      ((lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean (n + 1) → ℂ) x) ^ p)) ≤
      ENNReal.ofReal p *
        (4 * ENNReal.ofReal (C ^ (2 : ℕ)) * A₂ +
          2 * lacunaryRelativeBandpassFinitePhysicalWeakOneConstant psi j C * A₁) := by
  dsimp only
  let C : ℝ := 12 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))
  have hCpos : 0 < C := by
    dsimp only [C]
    exact mul_pos (by norm_num) (div_pos (mul_pos (by norm_num) hC0)
      (Real.rpow_pos_of_pos (Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j) _))
  obtain ⟨hcoreMem, hcoreBound⟩ :=
    exists_lacunaryRelativeBpFinitePhysical_core_bound_of_isDyLacunaryRadSelector
      (by omega) C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm hpsi
      j r hr S hS
  apply lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_weak_one_two
    psi j r S hS
