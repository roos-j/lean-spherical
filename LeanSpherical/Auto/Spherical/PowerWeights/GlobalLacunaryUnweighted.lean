split. -/
theorem setIntegral_lacunaryRelativeBandpassPhysicalThreeWayTail_le
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (j : ℕ) (K : ℤ) (Sminus Splus : Finset ℕ)
    {ρ : ℝ} (hρ : 0 < ρ)
    (hsmall : ∀ n ∈ Sminus, (r (K - (n : ℤ)) : ℝ) ≤ ρ)
    (c : Euclidean d) (b : Euclidean d → ℂ) (hb : Integrable b)
    (hzero : (∫ y : Euclidean d, b y) = 0)
    (hbsupp : ∀ y, b y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
      lacunaryRelativeBandpassPhysicalThreeWayTail psi j r K Sminus Splus b x) ≤
      (((((2 : ℝ) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) *
          ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) *
          surfaceMass d * (∫ y : Euclidean d, ‖b y‖)) *
        (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2))) +
      (j : ℝ) * ((∫ y : Euclidean d, ‖b y‖) *
        (surfaceMass d * ∫ x : Euclidean d,
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖)) +
      (surfaceMass d * ρ *
        (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ (K + (j : ℤ)))⁻¹) *
          (∫ x : Euclidean d,
            ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
              Euclidean d → ℂ) x‖) *
          (∫ y : Euclidean d, ‖b y‖))) := by
  have hminus : Integrable (fun x : Euclidean d =>
      ∑ n ∈ Sminus,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K - (n : ℤ)) : ℝ) b x‖) volume :=
    integrable_finsetSum Sminus fun n _ =>
      (integrable_lacunaryRelativeBandpassPhysicalTerm psi j
        (r (K - (n : ℤ))).2 b hb).norm
  have hmid : Integrable (fun x : Euclidean d =>
      ∑ n ∈ Finset.range j,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K + 1 + (n : ℤ)) : ℝ) b x‖) volume :=
    integrable_finsetSum (Finset.range j) fun n _ =>
      (integrable_lacunaryRelativeBandpassPhysicalTerm psi j
        (r (K + 1 + (n : ℤ))).2 b hb).norm
  have hplus : Integrable (fun x : Euclidean d =>
      ∑ n ∈ Splus,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K + (j : ℤ) + (n : ℤ) : ℤ) : ℝ) b x‖) volume :=
    integrable_finsetSum Splus fun n _ =>
      (integrable_lacunaryRelativeBandpassPhysicalTerm psi j
        (r (K + (j : ℤ) + (n : ℤ) : ℤ)).2 b hb).norm
  have hpast := setIntegral_dyadic_lacunary_past_small_radius_atom_signed_tail_le
    hd psi r hr j K Sminus hρ hsmall c b hb hbsupp
  have hfuture := setIntegral_dyadic_lacunary_future_atom_tail_le
    psi r hr j (K + (j : ℤ)) Splus b hb hzero hρ.le hbsupp
  have hmiddle := setIntegral_lacunaryRelativeBandpassPhysical_middle_tail_le psi j r K b hb
    ((Metric.closedBall c (3 * ρ))ᶜ)
  unfold lacunaryRelativeBandpassPhysicalThreeWayTail
  change (∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
      (fun z : Euclidean d => ∑ n ∈ Sminus,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K - (n : ℤ)) : ℝ) b z‖) x +
      ((fun z : Euclidean d => ∑ n ∈ Finset.range j,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K + 1 + (n : ℤ)) : ℝ) b z‖) +
        fun z : Euclidean d => ∑ n ∈ Splus,
          ‖lacunaryRelativeBandpassPhysicalTerm psi j
            (r (K + (j : ℤ) + (n : ℤ) : ℤ) : ℝ) b z‖) x) ≤ _
  rw [integral_add hminus.integrableOn (hmid.add hplus).integrableOn]
  have hmidplus :
      (∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
        ((fun z : Euclidean d => ∑ n ∈ Finset.range j,
          ‖lacunaryRelativeBandpassPhysicalTerm psi j
            (r (K + 1 + (n : ℤ)) : ℝ) b z‖) +
          fun z : Euclidean d => ∑ n ∈ Splus,
            ‖lacunaryRelativeBandpassPhysicalTerm psi j
              (r (K + (j : ℤ) + (n : ℤ) : ℤ) : ℝ) b z‖) x) =
        (∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
          ∑ n ∈ Finset.range j,
            ‖lacunaryRelativeBandpassPhysicalTerm psi j
              (r (K + 1 + (n : ℤ)) : ℝ) b x‖) +
        ∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
          ∑ n ∈ Splus,
            ‖lacunaryRelativeBandpassPhysicalTerm psi j
              (r (K + (j : ℤ) + (n : ℤ) : ℤ) : ℝ) b x‖ := by
    exact integral_add hmid.integrableOn hplus.integrableOn
  rw [hmidplus]
  calc
    (∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
      ∑ n ∈ Sminus,
        ‖lacunaryRelativeBandpassPhysicalTerm psi j
          (r (K - (n : ℤ)) : ℝ) b x‖) +
      ((∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
        ∑ n ∈ Finset.range j,
          ‖lacunaryRelativeBandpassPhysicalTerm psi j
            (r (K + 1 + (n : ℤ)) : ℝ) b x‖) +
      ∫ x : Euclidean d in (Metric.closedBall c (3 * ρ))ᶜ,
        ∑ n ∈ Splus,
          ‖lacunaryRelativeBandpassPhysicalTerm psi j
            (r (K + (j : ℤ) + (n : ℤ) : ℤ) : ℝ) b x‖) ≤
        (((((2 : ℝ) ^ j)⁻¹ ^ 2 *
            SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) *
            ((16 / 3 : ℝ) * ((2 : ℝ) ^ K) ^ 2) *
            surfaceMass d * (∫ y : Euclidean d, ‖b y‖)) *
          (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2))) +
        (j : ℝ) * ((∫ y : Euclidean d, ‖b y‖) *
          (surfaceMass d * ∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖)) +
        (surfaceMass d * ρ *
          (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ (K + (j : ℤ)))⁻¹) *
            (∫ x : Euclidean d,
              ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
                Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖b y‖))) := by
      simp only [lacunaryRelativeBandpassPhysicalTerm,
        lacunaryRelativeBandpassPhysicalKernel] at hmiddle ⊢
      linarith [hpast, hmiddle, hfuture]
    _ = _ := by ring

/-- The scale-independent coefficient of the three-way atom tail.  Its only
growing term is the explicit factor `j` from the middle radii. -/
def lacunaryCZDyadicCubeThreeWayTailConstant
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) : ℝ :=
  ((((2 : ℝ) ^ j)⁻¹ ^ 2 *
      SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) * (16 / 3 : ℝ) *
        surfaceMass d) *
      (surfaceMass d * (3 : ℝ) ^ d / (2 * (d : ℝ) ^ 2))) +
    (j : ℝ) *
      (surfaceMass d * ∫ x : Euclidean d,
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) +
    (surfaceMass d * (d : ℝ) * 2 *
      ∫ x : Euclidean d,
        ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) x‖)

theorem lacunaryCZDyadicCubeThreeWayTailConstant_nonneg
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) :
    0 ≤ lacunaryCZDyadicCubeThreeWayTailConstant psi j := by
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hinv : 0 ≤ ((2 : ℝ) ^ j)⁻¹ ^ 2 := sq_nonneg _
  have hsphere : 0 ≤ surfaceMass d := measureReal_nonneg
  have hthree : 0 ≤ (3 : ℝ) ^ d := pow_nonneg (by norm_num) _
  have hden : 0 ≤ 2 * (d : ℝ) ^ 2 :=
    mul_nonneg (by norm_num) (sq_nonneg _)
  have hfirstLeft : 0 ≤ ((2 : ℝ) ^ j)⁻¹ ^ 2 *
      SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) * (16 / 3 : ℝ) *
        surfaceMass d := by
    positivity
  have hfirstRight : 0 ≤ surfaceMass d * (3 : ℝ) ^ d /
      (2 * (d : ℝ) ^ 2) :=
    div_nonneg (mul_nonneg hsphere hthree) hden
  have hmid : 0 ≤ (j : ℝ) *
      (surfaceMass d * ∫ x : Euclidean d,
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) := by
    exact mul_nonneg (Nat.cast_nonneg j)
      (mul_nonneg hsphere (integral_nonneg fun _ => norm_nonneg _))
  have hfuture : 0 ≤ surfaceMass d * (d : ℝ) * 2 *
      ∫ x : Euclidean d,
        ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) x‖ := by
    positivity
  unfold lacunaryCZDyadicCubeThreeWayTailConstant
  exact add_nonneg (add_nonneg (mul_nonneg hfirstLeft hfirstRight) hmid) hfuture

theorem lacunaryCZDyadicCube_threeWayTail_rhs_eq
    {d : Nat} (hd : 0 < d) (psi : SchwartzMap (Euclidean d) ℂ) (j : ℕ)
    (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d → ℂ) :
    (((((2 : ℝ) ^ j)⁻¹ ^ 2 *
        SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) *
        ((16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2) *
        surfaceMass d * (∫ y : Euclidean d, ‖b y‖)) *
      (surfaceMass d * (3 : ℝ) ^ d /
        (2 * (lacunaryCZDyadicCubeRadius q) ^ 2))) +
    (j : ℝ) * ((∫ y : Euclidean d, ‖b y‖) *
      (surfaceMass d * ∫ x : Euclidean d,
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖)) +
    (surfaceMass d * lacunaryCZDyadicCubeRadius q *
      (2 * (2 : ℝ) ^ j * ((2 : ℝ) ^ (q.scale + (j : ℤ)))⁻¹) *
        (∫ x : Euclidean d,
          ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) x‖) *
        (∫ y : Euclidean d, ‖b y‖))) =
      lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        (∫ y : Euclidean d, ‖b y‖) := by
  unfold lacunaryCZDyadicCubeRadius lacunaryCZDyadicCubeThreeWayTailConstant
  have hd0 : (d : ℝ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt hd)
  have hq0 : (2 : ℝ) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
  rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0) q.scale (j : ℤ)]
  norm_num [zpow_natCast]
  field_simp

/-- The finite sum of the three-way bad-atom tails. -/
def lacunaryCZDyadicCubeThreeWayBadTail
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (f : Euclidean d → ℂ)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (S : Finset ℤ) :
    Euclidean d → ℝ :=
  fun x => ∑ q ∈ U,
    lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
      (lacunaryCZDyadicCubePastIndices S q)
      (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
      (lacunaryCZDyadicCubeBadAtom f q) x

theorem integrable_lacunaryCZDyadicCubeThreeWayBadTail
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (f : Euclidean d → ℂ)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (S : Finset ℤ)
    (hf : Integrable f volume) :
    Integrable (lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S) volume := by
  unfold lacunaryCZDyadicCubeThreeWayBadTail
  apply integrable_finsetSum U
  intro q hq
  exact integrable_lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
    (lacunaryCZDyadicCubePastIndices S q)
    (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
    (lacunaryCZDyadicCubeBadAtom f q)
    (integrable_lacunaryCZDyadicCubeBadAtom f q hf)

theorem lacunaryCZDyadicCubeThreeWayBadTail_nonneg
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (f : Euclidean d → ℂ)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (S : Finset ℤ)
    (x : Euclidean d) :
    0 ≤ lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x := by
  unfold lacunaryCZDyadicCubeThreeWayBadTail
  exact Finset.sum_nonneg fun q hq =>
    lacunaryRelativeBandpassPhysicalThreeWayTail_nonneg psi j r q.scale
      (lacunaryCZDyadicCubePastIndices S q)
      (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
      (lacunaryCZDyadicCubeBadAtom f q) x

/-- The three-way analytic atom estimate summed over a finite stopping
family. -/
theorem setIntegral_lacunaryCZDyadicCubeThreeWayBadTail_le
    {d : Nat} [NeZero d] (hd : 2 ≤ d) (psi : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (f : Euclidean d → ℂ) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (S : Finset ℤ) (hf : Integrable f volume) :
    (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x) ≤
      lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        ∑ q ∈ U, ∫ x : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q x‖ := by
  have hdpos : 0 < d := by omega
  have hterm (q : LacunaryCZDyadicCubeIndex d) (hq : q ∈ U) :
      Integrable (lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
        (lacunaryCZDyadicCubePastIndices S q)
        (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
        (lacunaryCZDyadicCubeBadAtom f q)) volume :=
    integrable_lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
      (lacunaryCZDyadicCubePastIndices S q)
      (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
      (lacunaryCZDyadicCubeBadAtom f q)
      (integrable_lacunaryCZDyadicCubeBadAtom f q hf)
  unfold lacunaryCZDyadicCubeThreeWayBadTail
  rw [integral_finsetSum U fun q hq => (hterm q hq).integrableOn]
  calc
    (∑ q ∈ U,
      ∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
        lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
          (lacunaryCZDyadicCubePastIndices S q)
          (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
          (lacunaryCZDyadicCubeBadAtom f q) x) ≤
        ∑ q ∈ U, lacunaryCZDyadicCubeThreeWayTailConstant psi j *
          ∫ x : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q x‖ := by
      apply Finset.sum_le_sum
      intro q hq
      have hsubset : (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ ⊆
          (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
            (3 * lacunaryCZDyadicCubeRadius q))ᶜ := by
        intro x hx hball
        apply hx
        exact Set.mem_iUnion₂.mpr ⟨q, hq, hball⟩
      have hmono :
          (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
            lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
              (lacunaryCZDyadicCubePastIndices S q)
              (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
              (lacunaryCZDyadicCubeBadAtom f q) x) ≤
          ∫ x : Euclidean d in
            (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
              (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
            lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
              (lacunaryCZDyadicCubePastIndices S q)
              (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
              (lacunaryCZDyadicCubeBadAtom f q) x := by
        exact integral_mono_measure (Measure.restrict_mono hsubset le_rfl)
          (Filter.Eventually.of_forall fun x =>
            lacunaryRelativeBandpassPhysicalThreeWayTail_nonneg psi j r q.scale
              (lacunaryCZDyadicCubePastIndices S q)
              (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
              (lacunaryCZDyadicCubeBadAtom f q) x)
          ((hterm q hq).mono_measure Measure.restrict_le_self)
      have htail := setIntegral_lacunaryRelativeBandpassPhysicalThreeWayTail_le
        hdpos psi r hr j q.scale
        (lacunaryCZDyadicCubePastIndices S q)
        (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
        (lacunaryCZDyadicCubeRadius_pos q)
        (fun n hn =>
          dyadic_lacunary_past_radius_le_lacunaryCZDyadicCubeRadius hd r hr q n)
        (lacunaryCZDyadicCubeCenter q) (lacunaryCZDyadicCubeBadAtom f q)
        (integrable_lacunaryCZDyadicCubeBadAtom f q hf)
        (integral_lacunaryCZDyadicCubeBadAtom_eq_zero f q hf)
        (fun y hy => lacunaryCZDyadicCubeBadAtom_dist_center_le_radius f q hy)
      calc
        (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
          lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
            (lacunaryCZDyadicCubePastIndices S q)
            (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
            (lacunaryCZDyadicCubeBadAtom f q) x) ≤
          ∫ x : Euclidean d in
            (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
              (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
            lacunaryRelativeBandpassPhysicalThreeWayTail psi j r q.scale
              (lacunaryCZDyadicCubePastIndices S q)
              (lacunaryCZDyadicCubeShiftedFutureIndices S j q)
              (lacunaryCZDyadicCubeBadAtom f q) x := hmono
        _ ≤ (((((2 : ℝ) ^ j)⁻¹ ^ 2 *
            SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) *
            ((16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2) *
            surfaceMass d * (∫ y : Euclidean d,
              ‖lacunaryCZDyadicCubeBadAtom f q y‖)) *
          (surfaceMass d * (3 : ℝ) ^ d /
            (2 * (lacunaryCZDyadicCubeRadius q) ^ 2))) +
          (j : ℝ) * ((∫ y : Euclidean d,
            ‖lacunaryCZDyadicCubeBadAtom f q y‖) *
            (surfaceMass d * ∫ x : Euclidean d,
              ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖)) +
          (surfaceMass d * lacunaryCZDyadicCubeRadius q *
            (2 * (2 : ℝ) ^ j *
              ((2 : ℝ) ^ (q.scale + (j : ℤ)))⁻¹) *
              (∫ x : Euclidean d,
                ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) :
                  Euclidean d → ℂ) x‖) *
              (∫ y : Euclidean d,
                ‖lacunaryCZDyadicCubeBadAtom f q y‖))) := by
          simpa only [mul_assoc] using htail
        _ = lacunaryCZDyadicCubeThreeWayTailConstant psi j *
            ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ :=
          lacunaryCZDyadicCube_threeWayTail_rhs_eq hdpos psi j q
            (lacunaryCZDyadicCubeBadAtom f q)
    _ = lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        ∑ q ∈ U, ∫ x : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q x‖ := by
      rw [Finset.mul_sum]

theorem setIntegral_lacunaryCZDyadicCubeThreeWayBadTail_le_two_mul
    {d : Nat} [NeZero d] (hd : 2 ≤ d) (psi : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (f : Euclidean d → ℂ) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (S : Finset ℤ) (hf : Integrable f volume)
    (hdisj : (↑U : Set (LacunaryCZDyadicCubeIndex d)).PairwiseDisjoint
      lacunaryCZDyadicCube) :
    (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x) ≤
      2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        ∫ x : Euclidean d, ‖f x‖ := by
  have htail := setIntegral_lacunaryCZDyadicCubeThreeWayBadTail_le
    hd psi j r hr f U S hf
  have hbad := sum_integral_norm_lacunaryCZDyadicCubeBadAtom_le_two_mul_integral_norm
    f U hdisj hf
  have hC := lacunaryCZDyadicCubeThreeWayTailConstant_nonneg psi j
  calc
    (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x) ≤
      lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        ∑ q ∈ U, ∫ x : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q x‖ := htail
    _ ≤ lacunaryCZDyadicCubeThreeWayTailConstant psi j *
        (2 * ∫ x : Euclidean d, ‖f x‖) :=
      mul_le_mul_of_nonneg_left hbad hC
    _ = _ := by ring

/-- The literal finite physical maximum splits into its good part and the
three-way bad-atom tail. -/
theorem lacunaryRelativeBandpassFinitePhysicalMaximal_le_good_add_threeWayBadTail
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (f : Euclidean d → ℂ) (hf : Integrable f volume)
    (U : Finset (LacunaryCZDyadicCubeIndex d))
    (x : Euclidean d) :
    lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS f x ≤
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (lacunaryCZDyadicCubeGoodPart f U) x +
      lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x := by
  classical
  unfold lacunaryRelativeBandpassFinitePhysicalMaximal
  apply Finset.sup'_le hS
  intro k hk
  have hdecomp := lacunaryCZDyadicCube_kernel_integral_decomposition
    (lacunaryRelativeBandpassPhysicalKernel psi j (r k : ℝ))
    (continuous_lacunaryRelativeBandpassPhysicalKernel psi j (r k).2)
    (norm_lacunaryRelativeBandpassPhysicalKernel_le psi j (r k).2)
    f hf U x
  have hdecomp' :
      lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ) f x =
        lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
          (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ q ∈ U, lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
            (lacunaryCZDyadicCubeBadAtom f q) x := by
    simpa only [lacunaryRelativeBandpassPhysicalTerm] using hdecomp
  rw [hdecomp']
  calc
    ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
        (lacunaryCZDyadicCubeGoodPart f U) x +
        ∑ q ∈ U, lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
          (lacunaryCZDyadicCubeBadAtom f q) x‖ ≤
        ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
          (lacunaryCZDyadicCubeGoodPart f U) x‖ +
        ∑ q ∈ U, ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
          (lacunaryCZDyadicCubeBadAtom f q) x‖ := by
      exact (norm_add_le _ _).trans
        (add_le_add_right (norm_sum_le U fun q =>
          lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
            (lacunaryCZDyadicCubeBadAtom f q) x) _)
    _ ≤ S.sup' hS (fun k =>
          ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
            (lacunaryCZDyadicCubeGoodPart f U) x‖) +
        lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x := by
      apply add_le_add
      · exact Finset.le_sup' (fun k =>
          ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ)
            (lacunaryCZDyadicCubeGoodPart f U) x‖) hk
      · unfold lacunaryCZDyadicCubeThreeWayBadTail
        apply Finset.sum_le_sum
        intro q hq
        rcases lacunaryCZDyadicCube_threeWay_indices_cover S j q hk with
          hsmall | hmiddle | hlarge
        · rcases hsmall with ⟨n, hn, hkn⟩
          rw [hkn]
          unfold lacunaryRelativeBandpassPhysicalThreeWayTail
          have hsingle :
              ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale - (n : ℤ)) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖ ≤
                ∑ m ∈ lacunaryCZDyadicCubePastIndices S q,
                  ‖lacunaryRelativeBandpassPhysicalTerm psi j
                    (r (q.scale - (m : ℤ)) : ℝ)
                    (lacunaryCZDyadicCubeBadAtom f q) x‖ :=
            Finset.single_le_sum
              (s := lacunaryCZDyadicCubePastIndices S q)
              (f := fun m : ℕ => ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale - (m : ℤ)) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖)
              (fun m _ => norm_nonneg _) hn
          have hrest : 0 ≤
              (∑ m ∈ Finset.range j,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale + 1 + (m : ℤ)) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖) +
              ∑ m ∈ lacunaryCZDyadicCubeShiftedFutureIndices S j q,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale + (j : ℤ) + (m : ℤ) : ℤ) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖ := by positivity
          linarith
        · rcases hmiddle with ⟨n, hn, hkn⟩
          rw [hkn]
          unfold lacunaryRelativeBandpassPhysicalThreeWayTail
          have hsingle :
              ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale + 1 + (n : ℤ)) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖ ≤
                ∑ m ∈ Finset.range j,
                  ‖lacunaryRelativeBandpassPhysicalTerm psi j
                    (r (q.scale + 1 + (m : ℤ)) : ℝ)
                    (lacunaryCZDyadicCubeBadAtom f q) x‖ :=
            Finset.single_le_sum
              (s := Finset.range j)
              (f := fun m : ℕ => ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale + 1 + (m : ℤ)) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖)
              (fun m _ => norm_nonneg _) hn
          have hrest : 0 ≤
              (∑ m ∈ lacunaryCZDyadicCubePastIndices S q,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale - (m : ℤ)) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖) +
              ∑ m ∈ lacunaryCZDyadicCubeShiftedFutureIndices S j q,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale + (j : ℤ) + (m : ℤ) : ℤ) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖ := by positivity
          linarith
        · rcases hlarge with ⟨n, hn, hkn⟩
          rw [hkn]
          unfold lacunaryRelativeBandpassPhysicalThreeWayTail
          have hsingle :
              ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale + (j : ℤ) + (n : ℤ) : ℤ) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖ ≤
                ∑ m ∈ lacunaryCZDyadicCubeShiftedFutureIndices S j q,
                  ‖lacunaryRelativeBandpassPhysicalTerm psi j
                    (r (q.scale + (j : ℤ) + (m : ℤ) : ℤ) : ℝ)
                    (lacunaryCZDyadicCubeBadAtom f q) x‖ :=
            Finset.single_le_sum
              (s := lacunaryCZDyadicCubeShiftedFutureIndices S j q)
              (f := fun m : ℕ => ‖lacunaryRelativeBandpassPhysicalTerm psi j
                (r (q.scale + (j : ℤ) + (m : ℤ) : ℤ) : ℝ)
                (lacunaryCZDyadicCubeBadAtom f q) x‖)
              (fun m _ => norm_nonneg _) hn
          have hrest : 0 ≤
              (∑ m ∈ lacunaryCZDyadicCubePastIndices S q,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale - (m : ℤ)) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖) +
              ∑ m ∈ Finset.range j,
                ‖lacunaryRelativeBandpassPhysicalTerm psi j
                  (r (q.scale + 1 + (m : ℤ)) : ℝ)
                  (lacunaryCZDyadicCubeBadAtom f q) x‖ := by positivity
          linarith

private theorem threeWay_weak_two_scaled_to_weak_one
    {a A C G F : ENNReal} (ha : a ≠ 0) (hatop : a ≠ ∞)
    (h : a ^ (2 : ℕ) * G ≤ C ^ (2 : ℕ) * (A * a * F)) :
    (2 * a) * G ≤ (2 * A * C ^ (2 : ℕ)) * F := by
  rw [← ENNReal.mul_le_mul_iff_right ha hatop]
  calc
    a * ((2 * a) * G) = 2 * (a ^ (2 : ℕ) * G) := by ring
    _ ≤ 2 * (C ^ (2 : ℕ) * (A * a * F)) :=
      mul_le_mul_right h _
    _ = a * ((2 * A * C ^ (2 : ℕ)) * F) := by ring

private theorem threeWay_weak_one_scaled_double
    {a B K F : ENNReal} (h : a * B ≤ K * F) :
    (2 * a) * B ≤ (2 * K) * F := by
  calc
    (2 * a) * B = 2 * (a * B) := by ring
    _ ≤ 2 * (K * F) := mul_le_mul_right h _
    _ = (2 * K) * F := by ring

private theorem threeWay_exceptional_scaled_double
    {a D E F : ENNReal} (ha : a ≠ 0) (hatop : a ≠ ∞)
    (h : E ≤ D * a⁻¹ * F) :
    (2 * a) * E ≤ (2 * D) * F := by
  calc
    (2 * a) * E ≤ (2 * a) * (D * a⁻¹ * F) :=
      mul_le_mul_right h _
    _ = (2 * D) * F := by
      rw [show 2 * a * (D * a⁻¹ * F) = (2 * D) * (a * a⁻¹) * F by ring]
      rw [ENNReal.mul_inv_cancel ha hatop, mul_one]

private theorem threeWay_memLp_two_of_integrable_of_norm_le
    {d : Nat} (g : Euclidean d → ℂ) (hg : Integrable g volume)
    (B : ℝ) (_hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B) : MemLp g 2 volume := by
  apply (memLp_two_iff_integrable_sq_norm hg.aestronglyMeasurable).2
  refine (hg.norm.const_mul B).mono' ?_ (Filter.Eventually.of_forall fun x => ?_)
  · exact hg.aestronglyMeasurable.norm.pow 2
  · have hpoint : ‖g x‖ ^ (2 : ℕ) ≤ B * ‖g x‖ := by
      calc
        ‖g x‖ ^ (2 : ℕ) = ‖g x‖ * ‖g x‖ := by ring
        _ ≤ B * ‖g x‖ := mul_le_mul_of_nonneg_right (hgB x) (norm_nonneg _)
    simpa [Real.norm_eq_abs] using hpoint

private theorem threeWay_measure_le_of_real_bound
    {α : Type*} [MeasurableSpace α] (μ : Measure α) (E : Set α)
    {K : ℝ} (hEtop : μ E ≠ ∞) (hK : 0 ≤ K)
    (h : μ.real E ≤ K) : μ E ≤ ENNReal.ofReal K := by
  apply (ENNReal.toReal_le_toReal hEtop ENNReal.ofReal_ne_top).mp
  simpa only [Measure.real, ENNReal.toReal_ofReal hK] using h

private theorem threeWay_exceptional_lt_top
    {d : Nat} [NeZero d] (U : Finset (LacunaryCZDyadicCubeIndex d)) :
    volume (lacunaryCZDyadicCubeExceptionalTriple U) < ∞ := by
  let B : LacunaryCZDyadicCubeIndex d → Set (Euclidean d) := fun q =>
    Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q)
  have hmeasure : volume (lacunaryCZDyadicCubeExceptionalTriple U) ≤
      ∑ q ∈ U, volume (B q) := by
    simpa only [lacunaryCZDyadicCubeExceptionalTriple, B] using
      (measure_biUnion_finset_le (μ := volume) U B)
  have hsumlt : (∑ q ∈ U, volume (B q)) < ∞ :=
    ENNReal.sum_lt_top.mpr fun q hq => measure_closedBall_lt_top
  exact lt_of_le_of_lt hmeasure hsumlt

private theorem threeWay_bad_tail_ennreal
    {d : Nat} [NeZero d] (hd : 2 ≤ d) (psi : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (f : Euclidean d → ℂ) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (S : Finset ℤ) (hf : Integrable f volume)
    (hdisj : (↑U : Set (LacunaryCZDyadicCubeIndex d)).PairwiseDisjoint
      lacunaryCZDyadicCube)
    {lambda : ℝ} (_hlambda : 0 < lambda) :
    ENNReal.ofReal (lambda / 2) * volume
        ({x | lambda / 2 < lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S x} ∩
          (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ) ≤
      ENNReal.ofReal (2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j) *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  let E : Set (Euclidean d) := lacunaryCZDyadicCubeExceptionalTriple U
  let T : Euclidean d → ℝ := lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S
  have hTint : Integrable T volume := by
    simpa only [T] using integrable_lacunaryCZDyadicCubeThreeWayBadTail psi j r f U S hf
  have hTintE : Integrable T (volume.restrict Eᶜ) :=
    hTint.mono_measure Measure.restrict_le_self
  have hmarkov := mul_meas_ge_le_lintegral₀ hTintE.1.aemeasurable.ennreal_ofReal
    (ENNReal.ofReal (lambda / 2))
  have htail := setIntegral_lacunaryCZDyadicCubeThreeWayBadTail_le_two_mul
    hd psi j r hr f U S hf hdisj
  have hCtail : 0 ≤ lacunaryCZDyadicCubeThreeWayTailConstant psi j :=
    lacunaryCZDyadicCubeThreeWayTailConstant_nonneg psi j
  have hTnon : 0 ≤ᵐ[volume.restrict Eᶜ] T :=
    Filter.Eventually.of_forall fun x => lacunaryCZDyadicCubeThreeWayBadTail_nonneg
      psi j r f U S x
  have htailE : (∫⁻ x in Eᶜ, ENNReal.ofReal (T x)) ≤
      ENNReal.ofReal (2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j) *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
    calc
      (∫⁻ x in Eᶜ, ENNReal.ofReal (T x)) =
          ENNReal.ofReal (∫ x in Eᶜ, T x) :=
        (ofReal_integral_eq_lintegral_ofReal hTintE hTnon).symm
      _ ≤ ENNReal.ofReal (2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j *
          ∫ x, ‖f x‖) := ENNReal.ofReal_le_ofReal (by simpa only [E, T] using htail)
      _ = ENNReal.ofReal (2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j) *
          ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
        rw [ENNReal.ofReal_mul]
        · rw [ofReal_integral_eq_lintegral_ofReal hf.norm
            (Filter.Eventually.of_forall fun x => norm_nonneg _)]
        · exact mul_nonneg (by norm_num) hCtail
  have hsub :
      ({x | lambda / 2 < T x} ∩ Eᶜ) ⊆
        {x | ENNReal.ofReal (lambda / 2) ≤ ENNReal.ofReal (T x)} ∩ Eᶜ := by
    intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal hx.1.le, hx.2⟩
  calc
    ENNReal.ofReal (lambda / 2) * volume ({x | lambda / 2 < T x} ∩ Eᶜ) ≤
        ENNReal.ofReal (lambda / 2) *
          (volume.restrict Eᶜ) {x | ENNReal.ofReal (lambda / 2) ≤ ENNReal.ofReal (T x)} := by
      apply mul_le_mul_right
      exact (measure_mono hsub).trans (Measure.le_restrict_apply Eᶜ _)
    _ ≤ ∫⁻ x, ENNReal.ofReal (T x) ∂(volume.restrict Eᶜ) := hmarkov
    _ = ∫⁻ x in Eᶜ, ENNReal.ofReal (T x) := rfl
    _ ≤ _ := htailE

private theorem threeWay_good_level_ennreal
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C : ℝ) (hC : 0 ≤ C)
    (hcoreMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ)) 2 volume)
    (hcoreBound : ∀ f : SchwartzMap (Euclidean d) ℂ,
      ‖(hcoreMem f).toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ))‖ ≤ C * ‖f.toLp 2 volume‖)
    (g : Euclidean d → ℂ) (hg : Integrable g volume) (hg2 : MemLp g 2 volume)
    (B : ℝ) (hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B)
    (a A : ENNReal) (ha : a ≠ 0) (hatop : a ≠ ∞) (F : ENNReal)
    (hlin : (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) ≤ A * a * F) :
    (2 * a) * volume {x | a.toReal <
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x} ≤
      (2 * A * (ENNReal.ofReal C) ^ (2 : ℕ)) * F := by
  obtain ⟨hMg, hMgbound⟩ :=
    memLp_two_lacunaryRelativeBandpassFinitePhysicalMaximal_of_core_bound
      psi j r S hS C hC hcoreMem hcoreBound g hg hg2 B hB hgB
  have hweak := weak_two_of_memLp_toLp_bound volume
    (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS)
    (fun u x => lacunaryRelativeBandpassFinitePhysicalMaximal_nonneg
      psi j r S hS u x)
    C hC g hg2 hMg hMgbound (show 0 < a.toReal by
      exact ENNReal.toReal_pos ha hatop)
  have haPow : a ^ (2 : ℕ) = ENNReal.ofReal ((a.toReal) ^ (2 : ℕ)) := by
    rw [ENNReal.ofReal_pow ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hatop]
  have hCPow : (ENNReal.ofReal C) ^ (2 : ℕ) = ENNReal.ofReal (C ^ (2 : ℕ)) := by
    rw [ENNReal.ofReal_pow hC]
  have hmain : a ^ (2 : ℕ) * volume {x | a.toReal <
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x} ≤
      (ENNReal.ofReal C) ^ (2 : ℕ) * (A * a * F) := by
    calc
      a ^ (2 : ℕ) * volume {x | a.toReal <
          lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x} =
          ENNReal.ofReal ((a.toReal) ^ (2 : ℕ)) * volume {x | a.toReal <
            lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g x} := by
            rw [haPow]
      _ ≤ (ENNReal.ofReal C) ^ (2 : ℕ) *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := by
            rw [hCPow]
            exact hweak
      _ ≤ (ENNReal.ofReal C) ^ (2 : ℕ) * (A * a * F) :=
        mul_le_mul_right hlin _
  exact threeWay_weak_two_scaled_to_weak_one (A := A) (C := ENNReal.ofReal C)
    ha hatop hmain

/-- The weak-one constant obtained from the three-way frequency-shifted
Calderón--Zygmund decomposition. -/
def lacunaryRelativeBandpassFinitePhysicalThreeWayWeakOneConstant {d : Nat}
    (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) (C : ℝ) : ENNReal :=
  2 * ENNReal.ofReal
      ((volume (Metric.ball (0 : Euclidean d) 1)).toReal * (3 : ℝ) ^ d * (d : ℝ) ^ d) +
    (2 * ENNReal.ofReal (3 * (2 : ℝ) ^ d) * (ENNReal.ofReal C) ^ (2 : ℕ)) +
      2 * ENNReal.ofReal (2 * lacunaryCZDyadicCubeThreeWayTailConstant psi j)

/-- The literal finite relative-band physical maximum has weak type `(1,1)`
with a constant growing only linearly in the relative-frequency index. -/
theorem weak_one_lacunaryRelativeBandpassFinitePhysicalMaximal_of_core_bound_threeWay
    {d : Nat} [NeZero d] (hd : 2 ≤ d)
    (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (hr : IsDyadicLacunaryRadiusSelector r)
    (S : Finset ℤ) (hS : S.Nonempty) (C : ℝ) (hC : 0 ≤ C)
    (hcoreMem : ∀ g : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (g : Euclidean d → ℂ)) 2 volume)
    (hcoreBound : ∀ g : SchwartzMap (Euclidean d) ℂ,
      ‖(hcoreMem g).toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (g : Euclidean d → ℂ))‖ ≤ C * ‖g.toLp 2 volume‖)
    (f : SchwartzMap (Euclidean d) ℂ) {lambda : ℝ} (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x |
      lambda < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x} ≤
      lacunaryRelativeBandpassFinitePhysicalThreeWayWeakOneConstant psi j C *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  have hf : Integrable (f : Euclidean d → ℂ) volume := f.integrable
  obtain ⟨U, hdisj, hbadCube, houtside, havg, hgoodBound, hatomint, hzero, hsupp,
    hsum, hgoodInt, hgoodL2, hL1, hside, hradius⟩ :=
    exists_lacunaryCZDyadicCube_continuous_decay_decomposition
      (f : Euclidean d → ℂ) lambda hlambda f.continuous hf f.tendsto_cocompact
  have hsplit : ∀ x : Euclidean d,
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ) x ≤
        lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U) x +
          lacunaryCZDyadicCubeThreeWayBadTail psi j r (f : Euclidean d → ℂ) U S x := by
    intro x
    exact lacunaryRelativeBandpassFinitePhysicalMaximal_le_good_add_threeWayBadTail
      psi j r S hS (f : Euclidean d → ℂ) hf U x
  have hlevel :
      ({x | lambda < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x} ∩ (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ) ⊆
      {x | lambda / 2 < lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U) x} ∪
      ({x | lambda / 2 < lacunaryCZDyadicCubeThreeWayBadTail psi j r
        (f : Euclidean d → ℂ) U S x} ∩ (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ) := by
    intro x hx
    rcases hx with ⟨hlevel, hxoutside⟩
    change lambda <
      lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ) x at hlevel
    by_cases hgood : lambda / 2 <
        lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U) x
    · exact Or.inl hgood
    · right
      have hgood' :
          lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U) x ≤ lambda / 2 :=
        le_of_not_gt hgood
      have hbad : lambda / 2 <
          lacunaryCZDyadicCubeThreeWayBadTail psi j r (f : Euclidean d → ℂ) U S x := by
        by_contra hbad
        have hbad' : lacunaryCZDyadicCubeThreeWayBadTail psi j r
            (f : Euclidean d → ℂ) U S x ≤ lambda / 2 := le_of_not_gt hbad
        have hupper := hsplit x
        linarith
      exact ⟨hbad, hxoutside⟩
  let E : Set (Euclidean d) := lacunaryCZDyadicCubeExceptionalTriple U
  let g : Euclidean d → ℂ := lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U
