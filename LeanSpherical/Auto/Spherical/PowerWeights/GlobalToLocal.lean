    (hr : r ∈ E) (hε : 0 < ε) (hrinner : 0 < r - 2 * ε) :
    ∃ f : SchwartzMap (Euclidean d) ℂ,
      (∀ y, r - ε ≤ ‖y‖ → ‖y‖ ≤ r + ε → f y = 1) ∧
      (∀ y, ‖y‖ ≤ r - 2 * ε → f y = 0) ∧
      (∀ y, r + 2 * ε ≤ ‖y‖ → f y = 0) ∧
      (∀ y, ‖f y‖ ≤ 2) ∧
      (∀ x ∈ Metric.closedBall (0 : Euclidean d) ε,
        1 ≤ restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x) := by
  rcases exists_schwartz_shell_test d hε hrinner with
    ⟨f, hf_shell, hf_inner, hf_outer, hf_bound⟩
  refine ⟨f, hf_shell, hf_inner, hf_outer, hf_bound, ?_⟩
  have hrpos : 0 < r := by linarith
  intro x hx
  rw [Metric.mem_closedBall, dist_zero_right] at hx
  have hsphere : ∀ w : sphere (0 : Euclidean d) 1,
      f (x + r • (w : Euclidean d)) = 1 := by
    intro w
    apply hf_shell
    · have hw : ‖(w : Euclidean d)‖ = 1 :=
        mem_sphere_zero_iff_norm.mp w.property
      have htri : ‖r • (w : Euclidean d)‖ ≤
          ‖x + r • (w : Euclidean d)‖ + ‖x‖ := by
        calc
          ‖r • (w : Euclidean d)‖ = ‖(x + r • (w : Euclidean d)) - x‖ := by
            congr 1
            abel
