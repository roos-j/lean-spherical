/-- The exact testing inequality used by the sharp Knapp construction.

To apply it at a dyadic entropy scale, `A` is the union of the disjoint
output tubes, `a` is their common average lower bound, `B` is the input
`Lᵖ` bound, and a geometric volume calculation supplies a lower bound for
`powerWeightedVolume d α A`.  No analytic estimate is hidden here: the three
hypotheses `hf`, `hpoint`, and `hinput` are precisely the required input,
pointwise-output, and input-size assertions. -/
theorem restrictedStrongType_knapp_test_bound
    {d : ℕ} {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p α)
    {f : SchwartzMap (Euclidean d) ℂ}
    (hf : MemLp (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α))
    {A : Set (Euclidean d)} (hAmeas : MeasurableSet A)
    {a B : ENNReal}
    (hpoint : ∀ x ∈ A, a ≤ restrictedNormalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x)
    (hinput : eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume d α) ≤ B)
    (hp0 : ENNReal.ofReal p ≠ 0) :
    ∃ C : ℝ, 0 < C ∧
      a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C * B := by
  rcases hstrong with ⟨C, hC, hstrong⟩
  refine ⟨C, hC, ?_⟩
  calc
    a * (powerWeightedVolume d α A) ^ (1 / (ENNReal.ofReal p).toReal) =
        eLpNorm (A.indicator (fun _ : Euclidean d => a))
          (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      rw [eLpNorm_indicator_const hAmeas.nullMeasurableSet hp0 ENNReal.ofReal_ne_top]
      simp
    _ ≤ eLpNorm (restrictedNormalizedSphericalMaximal d E
        (f : Euclidean d → ℂ)) (ENNReal.ofReal p) (powerWeightedVolume d α) := by
      apply eLpNorm_mono_enorm (aestronglyMeasurable_const.indicator hAmeas)
