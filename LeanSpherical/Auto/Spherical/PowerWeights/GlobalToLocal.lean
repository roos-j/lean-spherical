    change HasCompactSupport (fun y => hOut y * (1 - hIn y))
    exact hOutcompact.mul_right
  have hsmooth : ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) g := by
    change ContDiff ℝ ((⊤ : ℕ∞) : WithTop ℕ∞) (fun y => hOut y * (1 - hIn y))
