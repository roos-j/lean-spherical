    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) :
    Measurable (fun x : Euclidean (d + 1) =>
      (restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j f x).toReal) := by
  obtain ⟨r₀, hr₀⟩ := hEne
  have hr₀pos : 0 < r₀ := lt_of_lt_of_le zero_lt_one (hE hr₀).1
  letI : Nonempty ↥(E ∩ Ioi (0 : ℝ)) := ⟨⟨r₀, hr₀, hr₀pos⟩⟩
  let M : Euclidean (d + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j f
  let Q : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      (‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
          𝓕 (f : Euclidean (d + 1) → ℂ) xi) x‖ ^ 2)
  have hQmeas : Measurable Q := by
    simpa only [Q] using
      measurable_iSup_ennreal_norm_sq_literal_relative_dyadic_moving_bandpass
        phi f hphi_one hphi_zero hphi_norm j E hE
  have hQeq (x : Euclidean (d + 1)) : Q x = (M x) ^ 2 := by
    dsimp only [Q, M, restrictedRelativeBandpassSphericalMaximal]
    exact iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
      (fun r : ↥(E ∩ Ioi (0 : ℝ)) =>
        𝓕⁻ (fun xi : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (f : Euclidean (d + 1) → ℂ) xi) x)
  have hroot : (fun x : Euclidean (d + 1) => (M x).toReal) =
      fun x : Euclidean (d + 1) => ((Q x).toReal).sqrt := by
    funext x
    rw [hQeq x, ENNReal.toReal_pow]
    simp only [Real.sqrt_sq_eq_abs, abs_of_nonneg ENNReal.toReal_nonneg]
  rw [show (fun x : Euclidean (d + 1) =>
      (restrictedRelativeBandpassSphericalMaximal (d + 1) E phi j f x).toReal) =
        fun x : Euclidean (d + 1) => (M x).toReal by rfl, hroot]
  exact Real.continuous_sqrt.measurable.comp hQmeas.ennreal_toReal

/-- The physical `L¹` endpoint for a literal moving relative band on one
spatial annulus.  This is written directly for the relative multiplier so
that the subsequent interpolation never changes the frequency localization. -/
theorem restrictedRelativeBandpass_annular_lintegral_one_le_of_pointwise
    {d : Nat} {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r) (hrR : r ≤ R)
    (D : ℝ) (hD : 0 ≤ D) (phi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (E : Set ℝ)
    (hpointwise : ∀ (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d),
      restrictedRelativeBandpassSphericalMaximal d E phi j g x ≤
        ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖))
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    let A : Set (Euclidean d) := euclideanAnnulus d r R
    let μ : Measure (Euclidean d) := powerWeightedVolume d α
    let T : Euclidean d → ℝ := A.indicator (fun x =>
      (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
    let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
    let w : ENNReal := (ENNReal.ofReal R) ^ α
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
      c * μ A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  dsimp only
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let M : Euclidean d → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal d E phi j g
  let T : Euclidean d → ℝ := A.indicator (fun x => (M x).toReal)
  let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
  let w : ENNReal := (ENNReal.ofReal R) ^ α
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂volume
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hDpow : 0 ≤ D * (2 : ℝ) ^ j := by positivity
  have hI : I = ENNReal.ofReal (∫ x : Euclidean d, ‖g x‖) := by
    dsimp only [I]
    symm
    simpa only [ofReal_norm] using
      ofReal_integral_norm_eq_lintegral_enorm (μ := volume) g.integrable
  have hMpoint (x : Euclidean d) : M x ≤ c * I := by
    calc
      M x ≤ ENNReal.ofReal (D * (2 : ℝ) ^ j * ∫ y : Euclidean d, ‖g y‖) :=
        hpointwise g x
      _ = c * I := by
        rw [ENNReal.ofReal_mul hDpow, ← hI]
  have hMfin (x : Euclidean d) : M x ≠ ⊤ :=
    ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (by rw [hI]; exact ENNReal.ofReal_ne_top)) (hMpoint x)
  have hTpoint (x : Euclidean d) :
      ENNReal.ofReal (T x) ≤ A.indicator (fun _ : Euclidean d => c * I) x := by
    by_cases hx : x ∈ A
    · simp only [T, Set.indicator_of_mem hx]
      rw [ENNReal.ofReal_toReal (hMfin x)]
      exact hMpoint x
    · simp only [T, Set.indicator_of_notMem hx]
      simp
  have hGmeas : Measurable (fun x : Euclidean d => ENNReal.ofReal ‖g x‖) :=
    g.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ x, x ∉ A → ENNReal.ofReal ‖g x‖ = 0 := by
    intro x hx
    simp [hgsupport x hx]
  have hinput : I ≤ w⁻¹ * J := by
    dsimp only [I, J, w, μ]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα hr hrR _ hGmeas hGsupport
  calc
    (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
        ∫⁻ x, A.indicator (fun _ : Euclidean d => c * I) x ∂μ :=
      lintegral_mono hTpoint
    _ = c * I * μ A := by
      rw [lintegral_indicator hA, setLIntegral_const]
    _ = c * μ A * I := by ring
    _ ≤ c * μ A * (w⁻¹ * J) := mul_le_mul_right hinput _
    _ = c * μ A * w⁻¹ * J := by ring

/-- Supply the annular physical endpoint from the literal kernel estimate. -/
theorem exists_restrictedRelativeBandpass_annular_lintegral_one_le
    {d : Nat} (hd : 0 < d) {α r R : ℝ} (hα : α ≤ 0) (hr : 0 < r)
    (hrR : r ≤ R) (phi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    (g : SchwartzMap (Euclidean d) ℂ)
    (hgsupport : ∀ x, x ∉ euclideanAnnulus d r R → g x = 0) :
    ∃ D : ℝ, 0 < D ∧
      let A : Set (Euclidean d) := euclideanAnnulus d r R
      let μ : Measure (Euclidean d) := powerWeightedVolume d α
      let T : Euclidean d → ℝ := A.indicator (fun x =>
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal)
      let c : ENNReal := ENNReal.ofReal (D * (2 : ℝ) ^ j)
      let w : ENNReal := (ENNReal.ofReal R) ^ α
      (∫⁻ x, ENNReal.ofReal (T x) ∂μ) ≤
        c * μ A * w⁻¹ * ∫⁻ x, ENNReal.ofReal ‖g x‖ ∂μ := by
  obtain ⟨D, hD, hphysical⟩ :=
    exists_restrictedRelativeBandpass_pointwise_le_integral hd phi
  refine ⟨D, hD, ?_⟩
  exact restrictedRelativeBandpass_annular_lintegral_one_le_of_pointwise
    hα hr hrR D hD.le phi j E (fun h x => hphysical j E hE h x) g hgsupport

/-- At one positive radius, the literal moving relative-band multiplier is
linear in its Schwartz input.  The proof packages the radius-dependent
frequency factor as a Schwartz multiplier before applying Fourier inversion. -/
theorem fourierInv_literal_relative_dyadic_bandpass_add
    {d : Nat} (phi f g : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
        𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x =
      𝓕⁻ (fun xi : Euclidean d =>
        surfaceFourier d (-r • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
          𝓕 (f : Euclidean d → ℂ) xi) x +
        𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
            𝓕 (g : Euclidean d → ℂ) xi) x := by
  obtain ⟨psi, hpsi⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  let a : ℝ := ((2 : ℝ) ^ j)⁻¹
  have ha : 0 < a := by
    dsimp only [a]
    exact inv_pos.mpr (pow_pos (by norm_num) _)
  let R : ℝ := (a * r)⁻¹
  have hR : 0 < R := inv_pos.mpr (mul_pos ha hr)
  let A : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 R⁻¹ (inv_ne_zero hR.ne'))
  let psiR : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A psi
  let hf : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 f)
  let hg : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 g)
  let hfg : SchwartzMap (Euclidean d) ℂ :=
    SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ) (𝓕 (f + g))
  have hpsiR (xi : Euclidean d) : psiR xi = psi (a • (r • xi)) := by
    change psi (A xi) = psi (a • (r • xi))
    change psi (R⁻¹ • xi) = psi (a • (r • xi))
    dsimp only [R]
    rw [inv_inv]
    simp only [smul_smul]
  have hhf (xi : Euclidean d) : hf xi =
      psi (a • (r • xi)) * 𝓕 (f : Euclidean d → ℂ) xi := by
    simp only [hf, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
  have hhg (xi : Euclidean d) : hg xi =
      psi (a • (r • xi)) * 𝓕 (g : Euclidean d → ℂ) xi := by
    simp only [hg, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
  have hhfg (xi : Euclidean d) : hfg xi =
      psi (a • (r • xi)) *
        𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi := by
    simp only [hfg, SchwartzMap.smulLeftCLM_apply psiR.hasTemperateGrowth,
      SchwartzMap.fourier_coe, smul_eq_mul]
    rw [hpsiR]
  have hhadd : hfg = hf + hg := by
    dsimp [hfg, hf, hg]
    rw [fourier_add f g]
    rw [(SchwartzMap.smulLeftCLM ℂ (psiR : Euclidean d → ℂ)).map_add]
  have hinvadd : (𝓕⁻ hfg : SchwartzMap (Euclidean d) ℂ) =
      (𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ) +
        (𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ) := by
    rw [hhadd, fourierInv_add]
  have hint (h : SchwartzMap (Euclidean d) ℂ) : Integrable
      (fun ω : Metric.sphere (0 : Euclidean d) 1 =>
        (𝓕⁻ h : SchwartzMap (Euclidean d) ℂ)
          (x + r • (ω : Euclidean d)))
      (unitSurfaceMeasure d) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact (𝓕⁻ h : SchwartzMap (Euclidean d) ℂ).continuous.comp
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => x).add
          ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => r).smul
            continuous_subtype_val))
    · exact HasCompactSupport.of_compactSpace _
  have havgadd :
      sphericalAverage d ((𝓕⁻ hfg : SchwartzMap (Euclidean d) ℂ) :
        Euclidean d → ℂ) r x =
        sphericalAverage d ((𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x +
          sphericalAverage d ((𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ) :
            Euclidean d → ℂ) r x := by
    rw [hinvadd]
    unfold sphericalAverage
    change ∫ ω : Metric.sphere (0 : Euclidean d) 1,
      ((𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ)
        (x + r • (ω : Euclidean d)) +
        (𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ)
          (x + r • (ω : Euclidean d))) ∂unitSurfaceMeasure d = _
    rw [MeasureTheory.integral_add (hint hf) (hint hg)]
  have hbridge (h : SchwartzMap (Euclidean d) ℂ) :
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) * h xi) x =
        sphericalAverage d ((𝓕⁻ h : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x := by
    exact congrFun
      (sphericalAverage_fourierInv_schwartz_eq_surfaceMultiplier h r).symm x
  have hscalar : (2 : ℝ)⁻¹ * ((2 : ℝ) ^ j)⁻¹ =
      ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [pow_succ, mul_inv_rev]
  have hband (h : SchwartzMap (Euclidean d) ℂ) :
      𝓕⁻ (fun xi : Euclidean d =>
        surfaceFourier d (-r • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
          𝓕 (h : Euclidean d → ℂ) xi) x =
        𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r • xi) * psi (a • (r • xi)) *
            𝓕 (h : Euclidean d → ℂ) xi) x := by
    apply congrArg (fun q : Euclidean d → ℂ => 𝓕⁻ q x)
    funext xi
    rw [hpsi (a • (r • xi))]
    simp only [zero_add, pow_one, pow_zero, inv_one, one_smul]
    have hfirst : (2 : ℝ)⁻¹ • (a • (r • xi)) =
        ((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi) := by
      dsimp only [a]
      rw [smul_smul, hscalar]
    rw [hfirst]
  have heqf :
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) * 𝓕 (f : Euclidean d → ℂ) xi) x =
        sphericalAverage d ((𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x := by
    calc
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) * 𝓕 (f : Euclidean d → ℂ) xi) x =
          𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) * hf xi) x := by
            apply congrArg (fun q : Euclidean d → ℂ => 𝓕⁻ q x)
            funext xi
            rw [hhf]
            ring
      _ = _ := hbridge hf
  have heqg :
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) * 𝓕 (g : Euclidean d → ℂ) xi) x =
        sphericalAverage d ((𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x := by
    calc
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) * 𝓕 (g : Euclidean d → ℂ) xi) x =
          𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) * hg xi) x := by
            apply congrArg (fun q : Euclidean d → ℂ => 𝓕⁻ q x)
            funext xi
            rw [hhg]
            ring
      _ = _ := hbridge hg
  have heqfg :
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) *
          𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x =
        sphericalAverage d ((𝓕⁻ hfg : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x := by
    calc
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) *
          𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x =
          𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) * hfg xi) x := by
            apply congrArg (fun q : Euclidean d → ℂ => 𝓕⁻ q x)
            funext xi
            rw [hhfg]
            ring
      _ = _ := hbridge hfg
  calc
    𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
        𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x =
      𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) *
          𝓕 ((f + g : SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) xi) x :=
        hband (f + g)
    _ = sphericalAverage d ((𝓕⁻ hfg : SchwartzMap (Euclidean d) ℂ) :
        Euclidean d → ℂ) r x := heqfg
    _ = sphericalAverage d ((𝓕⁻ hf : SchwartzMap (Euclidean d) ℂ) :
        Euclidean d → ℂ) r x +
        sphericalAverage d ((𝓕⁻ hg : SchwartzMap (Euclidean d) ℂ) :
          Euclidean d → ℂ) r x := havgadd
    _ = 𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
        psi (a • (r • xi)) * 𝓕 (f : Euclidean d → ℂ) xi) x +
        𝓕⁻ (fun xi : Euclidean d => surfaceFourier d (-r • xi) *
          psi (a • (r • xi)) * 𝓕 (g : Euclidean d → ℂ) xi) x := by
        rw [heqf, heqg]
    _ = 𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
        𝓕 (f : Euclidean d → ℂ) xi) x +
        𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r • xi))) *
            𝓕 (g : Euclidean d → ℂ) xi) x := by
        rw [← hband f, ← hband g]

/-- The restricted literal moving band is subadditive before passing to real
values.  The radius set stays restricted throughout the proof. -/
theorem restrictedRelativeBandpassSphericalMaximal_add_le
    {d : Nat} (E : Set ℝ) (phi f g : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (x : Euclidean d) :
    restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x ≤
      restrictedRelativeBandpassSphericalMaximal d E phi j f x +
        restrictedRelativeBandpassSphericalMaximal d E phi j g x := by
  unfold restrictedRelativeBandpassSphericalMaximal
  apply iSup_le
  intro r
  rw [fourierInv_literal_relative_dyadic_bandpass_add phi f g j r.2.2 x]
  calc
    ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
        𝓕 (f : Euclidean d → ℂ) xi) x +
      𝓕⁻ (fun xi : Euclidean d =>
        surfaceFourier d (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
          𝓕 (g : Euclidean d → ℂ) xi) x‖ ≤
        ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean d =>
            surfaceFourier d (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean d → ℂ) xi) x‖ +
            ‖𝓕⁻ (fun xi : Euclidean d =>
              surfaceFourier d (-r.1 • xi) *
                (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                  phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
                𝓕 (g : Euclidean d → ℂ) xi) x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
      surfaceFourier d (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
        𝓕 (f : Euclidean d → ℂ) xi) x‖ +
        ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean d =>
          surfaceFourier d (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
            𝓕 (g : Euclidean d → ℂ) xi) x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ restrictedRelativeBandpassSphericalMaximal d E phi j f x +
        restrictedRelativeBandpassSphericalMaximal d E phi j g x := by
