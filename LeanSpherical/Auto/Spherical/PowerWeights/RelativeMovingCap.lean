/-- On an input annulus, the unweighted integral is controlled by a
nonnegative power-weighted integral using the inner radius. -/
theorem lintegral_volume_le_innerPower_inv_mul_powerWeightedVolume_of_annular_support_nonneg
    {d : Nat} {α r R : ℝ} (hα : 0 ≤ α) (hr : 0 < r)
    (G : Euclidean d → ENNReal) (hG : Measurable G)
    (hGsupport : ∀ x, x ∉ euclideanAnnulus d r R → G x = 0) :
    (∫⁻ x, G x ∂volume) ≤
      ((ENNReal.ofReal r) ^ α)⁻¹ *
        ∫⁻ x, G x ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let w : ENNReal := (ENNReal.ofReal r) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hindicator : A.indicator G = G := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hGsupport x hx]
  have hwpos : 0 < w := by
    dsimp only [w]
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hr) ENNReal.ofReal_ne_top
  have hw0 : w ≠ 0 := hwpos.ne'
  have hwtop : w ≠ ∞ := by
    dsimp only [w]
    exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_ne_zero_iff.mpr hr) ENNReal.ofReal_ne_top
  have hweight : w * (∫⁻ x, G x ∂volume) ≤
      ∫⁻ x, G x ∂powerWeightedVolume d α := by
    calc
      w * (∫⁻ x, G x ∂volume) =
          w * (∫⁻ x in A, G x ∂volume) := by
        congr 1
        calc
          (∫⁻ x, G x ∂volume) = ∫⁻ x, A.indicator G x ∂volume := by
            rw [hindicator]
          _ = ∫⁻ x in A, G x ∂volume := lintegral_indicator hA G
      _ ≤ ∫⁻ x in A, G x ∂powerWeightedVolume d α := by
        dsimp only [w, A]
        exact setLIntegral_le_powerWeightedVolume_euclideanAnnulus_nonneg
          hα hr G hG
      _ = ∫⁻ x, G x ∂powerWeightedVolume d α := by
        calc
          (∫⁻ x in A, G x ∂powerWeightedVolume d α) =
              ∫⁻ x, A.indicator G x ∂powerWeightedVolume d α :=
            (lintegral_indicator hA G).symm
          _ = ∫⁻ x, G x ∂powerWeightedVolume d α := by rw [hindicator]
  calc
    (∫⁻ x, G x ∂volume) =
        w⁻¹ * (w * ∫⁻ x, G x ∂volume) := by
      rw [← mul_assoc, ENNReal.inv_mul_cancel hw0 hwtop, one_mul]
    _ ≤ w⁻¹ * (∫⁻ x, G x ∂powerWeightedVolume d α) :=
      mul_le_mul_right hweight _
    _ = ((ENNReal.ofReal r) ^ α)⁻¹ *
        ∫⁻ x, G x ∂powerWeightedVolume d α := by rfl

