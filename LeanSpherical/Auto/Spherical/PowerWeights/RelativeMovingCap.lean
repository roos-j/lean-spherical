/-- The preceding pointwise majorant in the literal smooth relative-band
convention used by the finite cutoff reassembly. -/
theorem exists_interval_literal_moving_band_pointwise_cap_majorant
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat)
      (f : SchwartzMap (Euclidean (n + 1)) ℂ) {a b s : ℝ},
      4 ≤ j → a ≤ b → 1 ≤ a → b ≤ 2 →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        (⨆ r : Icc a b, ENNReal.ofReal
          (norm (𝓕⁻ (fun xi : Euclidean (n + 1) =>
            surfaceFourier (n + 1) (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) xi) x))) ≤
          ∫⁻ y : Euclidean (n + 1),
            ENNReal.ofReal (norm (f y)) *
              relativeIntervalTailMajorant n y a b s j
                (ENNReal.ofReal (C * (2 : ℝ) ^ j))
                (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) x := by
  obtain ⟨psi, hpsi⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_relative_dyadic_pointwise_cap_majorant n psi
  refine ⟨C, hC, ?_⟩
  intro j f a b s hj hab ha hb x hx
  have hscalar : (2 : ℝ)⁻¹ * ((2 : ℝ) ^ j)⁻¹ = ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [pow_succ, mul_inv_rev]
  have hmult (r : ℝ) :
      (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          psi (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) =
      fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ := by
    funext ξ
    rw [hpsi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))]
    simp only [zero_add, pow_one, pow_zero, inv_one, one_smul]
    have hfirst : (2 : ℝ)⁻¹ • (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) =
        ((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ) := by
      rw [smul_smul, hscalar]
    rw [hfirst]
  have hsup :
      (fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            psi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) =
      fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ := by
    funext x
    apply iSup_congr
    intro r
    rw [hmult r.1]
  have hsupx := congrFun hsup x
  rw [← hsupx]
  exact hcap j f hj hab ha hb x hx

/-- A restricted radius set contained in a short interval inherits the
pointwise cap majorant for that interval. This is the form consumed by the
near-window and off-window radial reassembly. -/
theorem exists_restrictedRelativeBandpass_interval_pointwise_cap_majorant
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat)
      (f : SchwartzMap (Euclidean (n + 1)) ℂ) (E : Set ℝ)
      {u v s : ℝ},
      4 ≤ j → E ⊆ Icc u v → u ≤ v → 1 ≤ u → v ≤ 2 →
      ∀ x : Euclidean (n + 1), x ∈ ball 0 s →
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x ≤
          ∫⁻ y : Euclidean (n + 1),
            ENNReal.ofReal (norm (f y)) *
              relativeIntervalTailMajorant n y u v s j
                (ENNReal.ofReal (C * (2 : ℝ) ^ j))
                (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) x := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_moving_band_pointwise_cap_majorant n phi
  refine ⟨C, hC, ?_⟩
  intro j f E u v s hj hE huv hu hv x hx
  have hfull := hcap j f hj huv hu hv x hx
  calc
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x ≤
        ⨆ r : Icc u v, ENNReal.ofReal
          (norm (𝓕⁻ (fun xi : Euclidean (n + 1) =>
            surfaceFourier (n + 1) (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) xi) x)) := by
          unfold restrictedRelativeBandpassSphericalMaximal
          apply iSup_le
          intro r
          exact le_iSup
            (fun q : Icc u v => ENNReal.ofReal
              (norm (𝓕⁻ (fun xi : Euclidean (n + 1) =>
                surfaceFourier (n + 1) (-q.1 • xi) *
                  (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (q.1 • xi)) -
                    phi (((2 : ℝ) ^ j)⁻¹ • (q.1 • xi))) *
                    𝓕 (f : Euclidean (n + 1) → ℂ) xi) x)))
            ⟨r.1, hE r.2.1⟩
    _ ≤ ∫⁻ y : Euclidean (n + 1),
          ENNReal.ofReal (norm (f y)) *
            relativeIntervalTailMajorant n y u v s j
              (ENNReal.ofReal (C * (2 : ℝ) ^ j))
              (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) x := hfull

