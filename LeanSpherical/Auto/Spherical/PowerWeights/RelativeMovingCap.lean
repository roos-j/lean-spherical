            A.indicator (fun z => ENNReal.ofReal ((M z).toReal)) x ∂volume :=
        (lintegral_indicator hA _).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1), A.indicator M x ∂volume := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ A
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
          exact ENNReal.ofReal_toReal_le
        · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
      _ = ∫⁻ x in A, M x ∂volume := lintegral_indicator hA M
      _ = ∫⁻ x : Euclidean (n + 1), A.indicator M x ∂volume :=
        (lintegral_indicator hA M).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1),
          (ball (0 : Euclidean (n + 1)) s).indicator Q x ∂volume := by
