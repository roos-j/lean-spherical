  have hGmeas : Measurable (fun y : Euclidean (n + 1) => ENNReal.ofReal ‖f y‖) :=
    f.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ y : Euclidean (n + 1), y ∉ B → ENNReal.ofReal ‖f y‖ = 0 := by
    intro y hy
    simp [hfsupport y hy]
  have hinput : I ≤ ((ENNReal.ofReal a) ^ α)⁻¹ * J := by
    dsimp only [I, J, ν, B]
    exact lintegral_volume_le_innerPower_inv_mul_powerWeightedVolume_of_annular_support_nonneg
