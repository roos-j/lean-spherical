    _ = (ENNReal.ofReal (s / 2)) ^ α * L * ((ENNReal.ofReal a) ^ α)⁻¹ *
        ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))
          ∂powerWeightedVolume (n + 1) α := by rfl

/-- The short-interval cap endpoint transferred to a nonnegative
power-weighted output shell and exterior input annulus. -/
theorem exists_restrictedRelativeBandpass_interval_cap_shell_lintegral_one_le_nonneg
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
