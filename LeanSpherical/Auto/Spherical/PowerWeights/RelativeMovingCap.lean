  have hpow : Filter.Tendsto (fun m : ℕ => (2 : ℝ) ^ m) Filter.atTop Filter.atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  obtain ⟨k, hk⟩ := Filter.eventually_atTop.1 (hpow.eventually_gt_atTop t)
  have hexists : ∃ m : ℕ, t < (2 : ℝ) ^ (m + 1) := by
    refine ⟨k, ?_⟩
    apply (hk k le_rfl).trans_le
    rw [show k + 1 = Nat.succ k by omega, pow_succ]
    have hnonneg : 0 ≤ (2 : ℝ) ^ k := pow_nonneg (by norm_num) _
    nlinarith
  let m : ℕ := Nat.find hexists
  have hmupper : t < (2 : ℝ) ^ (m + 1) := Nat.find_spec hexists
  have hmpos : 0 < m := by
    by_contra hm
    have hmzero : m = 0 := Nat.eq_zero_of_not_pos hm
    have hsmall : t < 2 := by simpa [hmzero] using hmupper
    linarith
  have hmlower : (2 : ℝ) ^ m ≤ t := by
    by_contra hm
    have hlt : t < (2 : ℝ) ^ m := lt_of_not_ge hm
    have hpred : m - 1 + 1 = m := Nat.sub_add_cancel (Nat.succ_le_iff.2 hmpos)
    have hprior : t < (2 : ℝ) ^ ((m - 1) + 1) := by simpa [hpred] using hlt
    exact (not_lt_of_ge (Nat.find_min' hexists hprior))
      (Nat.sub_lt hmpos (by omega))
  exact ⟨m, hmlower, hmupper⟩

/-- A fixed-radius radial kernel with the standard dyadic off-shell tail has
small-ball mass controlled by the codimension-one cap factor.  The displayed
finite sum is intentional: the literal physical kernel is substituted into
this statement before the harmless geometric-series simplification. -/
theorem local_lintegral_radial_tail_le
    (n : Nat) (y : Euclidean (n + 1)) {r s : ℝ} (j : Nat)
    (hj : 3 ≤ j) (hr : 0 < r) (hs : 0 < s) (hy : s < ‖y‖)
    (hsmall : 4 * s ≤ r) (A q : ENNReal) (V : Euclidean (n + 1) → ENNReal)
    (_hVmeas : Measurable V) (hnear : ∀ x, V x ≤ A)
    (htail : ∀ (x : Euclidean (n + 1)) (m : Nat),
      (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r →
        V x ≤ A * q ^ m) :
    (∫⁻ x in ball (0 : Euclidean (n + 1)) s, V x) ≤
      (∑ m ∈ Finset.range (j - 2),
        A * q ^ m * volume (ball (0 : Euclidean n) s) *
          ENNReal.ofReal (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
        A * q ^ (j - 2) * volume (ball (0 : Euclidean (n + 1)) s) := by
  classical
  let B : Set (Euclidean (n + 1)) := ball 0 s
  let L : ℝ := (2 : ℝ) ^ j
  let F : ℕ → Euclidean (n + 1) → ENNReal := fun m x =>
    A * q ^ m * (relativeTailCap n y r L s m).indicator (fun _ => (1 : ENNReal)) x
  let G : Euclidean (n + 1) → ENNReal := fun x =>
    A * q ^ (j - 2) * B.indicator (fun _ => (1 : ENNReal)) x
  have hL : 0 < L := by
    dsimp only [L]
    positivity
  have hFmeas (m : ℕ) : Measurable (F m) := by
    dsimp only [F]
    exact measurable_const.mul
      (measurable_const.indicator (by
        dsimp only [relativeTailCap]
        exact measurableSet_thinShellCap (n + 1) y r s _))
  have hGmeas : Measurable G := by
    dsimp only [G]
    exact measurable_const.mul
      (measurable_const.indicator (by
        dsimp only [B]
        exact measurableSet_ball))
  have hpoint (x : Euclidean (n + 1)) (hx : x ∈ B) :
      V x ≤ (∑ m ∈ Finset.range (j - 2), F m x) + G x := by
    let u : ℝ := L * r⁻¹ * |‖y - x‖ - r|
    by_cases hu : u < 2
    · have hcap : x ∈ relativeTailCap n y r L s 0 := by
        apply mem_relativeTailCap_of_scaled_gap_lt n y x 0 hr hL
        · exact hx
        · have hu' : u < (2 : ℝ) ^ (0 + 1) := by simpa using hu
          simpa only [u] using hu'
      have hzero : 0 ∈ Finset.range (j - 2) := Finset.mem_range.mpr (by omega)
      have hterm : V x ≤ F 0 x := by
        calc
          V x ≤ A := hnear x
          _ = F 0 x := by
            dsimp only [F]
            rw [Set.indicator_of_mem hcap]
            simp
      calc
        V x ≤ F 0 x := hterm
        _ ≤ ∑ m ∈ Finset.range (j - 2), F m x :=
          Finset.single_le_sum (s := Finset.range (j - 2))
            (f := fun m => F m x) (fun _ _ => bot_le) hzero
        _ ≤ (∑ m ∈ Finset.range (j - 2), F m x) + G x :=
          le_add_of_nonneg_right bot_le
    · have htwo : 2 ≤ u := le_of_not_gt hu
      by_cases hfar : (2 : ℝ) ^ (j - 2) ≤ u
      · have hthreshold :
            (2 : ℝ) ^ (j - 2) / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r := by
            apply shell_tail_threshold_of_scaled_gap_le (j - 2) hr hL
            simpa only [u] using hfar
        have hterm : V x ≤ G x := by
          calc
            V x ≤ A * q ^ (j - 2) := htail x (j - 2) hthreshold
            _ = G x := by
              dsimp only [G]
              rw [Set.indicator_of_mem hx]
              simp
        calc
          V x ≤ G x := hterm
          _ ≤ (∑ m ∈ Finset.range (j - 2), F m x) + G x :=
            le_add_of_nonneg_left bot_le
      · have huupper : u < (2 : ℝ) ^ (j - 2) := lt_of_not_ge hfar
        obtain ⟨m, hmlower, hmupper⟩ := exists_relative_dyadic_annulus htwo
        have hm : m < j - 2 := by
          by_contra hnot
          have hm' : j - 2 ≤ m := Nat.le_of_not_gt hnot
          have hpow_nat : 2 ^ (j - 2) ≤ 2 ^ m :=
            Nat.pow_le_pow_right (by omega) hm'
          have hpow : (2 : ℝ) ^ (j - 2) ≤ (2 : ℝ) ^ m := by
            exact_mod_cast hpow_nat
          exact (not_lt_of_ge (hpow.trans hmlower)) huupper
        have hcap : x ∈ relativeTailCap n y r L s m := by
          apply mem_relativeTailCap_of_scaled_gap_lt n y x m hr hL
          · exact hx
          · simpa only [u] using hmupper
        have hthreshold :
            (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r := by
          apply shell_tail_threshold_of_scaled_gap_le m hr hL
          simpa only [u] using hmlower
        have hmset : m ∈ Finset.range (j - 2) := Finset.mem_range.mpr hm
        have hterm : V x ≤ F m x := by
          calc
            V x ≤ A * q ^ m := htail x m hthreshold
            _ = F m x := by
              dsimp only [F]
              rw [Set.indicator_of_mem hcap]
              simp
        calc
          V x ≤ F m x := hterm
          _ ≤ ∑ m ∈ Finset.range (j - 2), F m x :=
            Finset.single_le_sum (s := Finset.range (j - 2))
              (f := fun m => F m x) (fun _ _ => bot_le) hmset
          _ ≤ (∑ m ∈ Finset.range (j - 2), F m x) + G x :=
            le_add_of_nonneg_right bot_le
  have hFint (m : ℕ) :
      (∫⁻ x : Euclidean (n + 1), F m x) =
        A * q ^ m * volume (relativeTailCap n y r L s m) := by
    dsimp only [F]
    rw [lintegral_const_mul _
      (measurable_const.indicator (by
        dsimp only [relativeTailCap]
        exact measurableSet_thinShellCap (n + 1) y r s _)),
      lintegral_indicator (by
        dsimp only [relativeTailCap]
        exact measurableSet_thinShellCap (n + 1) y r s _),
      setLIntegral_const]
    simp
  have hGint : (∫⁻ x : Euclidean (n + 1), G x) =
      A * q ^ (j - 2) * volume B := by
    dsimp only [G]
    rw [lintegral_const_mul _ (measurable_const.indicator (by
        dsimp only [B]
        exact measurableSet_ball)),
      lintegral_indicator (by
        dsimp only [B]
        exact measurableSet_ball), setLIntegral_const]
    simp
  calc
    (∫⁻ x in ball (0 : Euclidean (n + 1)) s, V x) =
        ∫⁻ x : Euclidean (n + 1), B.indicator V x := by
          exact (lintegral_indicator (by
            exact measurableSet_ball) V).symm
    _ ≤ ∫⁻ x : Euclidean (n + 1),
        (∑ m ∈ Finset.range (j - 2), F m x) + G x := by
      apply lintegral_mono
      intro x
      by_cases hx : x ∈ B
      · simpa only [Set.indicator_of_mem hx] using hpoint x hx
      · simp only [Set.indicator_of_notMem hx]
        exact bot_le
    _ = (∑ m ∈ Finset.range (j - 2), ∫⁻ x : Euclidean (n + 1), F m x) +
        ∫⁻ x : Euclidean (n + 1), G x := by
      rw [MeasureTheory.lintegral_add_left
        (Finset.measurable_fun_sum _ fun m _ => hFmeas m),
        lintegral_finsetSum _ (fun m _ => hFmeas m)]
    _ = (∑ m ∈ Finset.range (j - 2),
        A * q ^ m * volume (relativeTailCap n y r L s m)) +
        A * q ^ (j - 2) * volume B := by
      rw [hGint]
      apply congrArg (fun z : ENNReal => z + A * q ^ (j - 2) * volume B)
      apply Finset.sum_congr rfl
      intro m _
      exact hFint m
    _ ≤ (∑ m ∈ Finset.range (j - 2),
        A * q ^ m * volume (ball (0 : Euclidean n) s) *
          ENNReal.ofReal (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
        A * q ^ (j - 2) * volume (ball (0 : Euclidean (n + 1)) s) := by
      apply add_le_add
      · apply Finset.sum_le_sum
        intro m hm
        have hm' : m < j - 2 := Finset.mem_range.mp hm
        have hcap := volume_relativeTailCap_le n y j m hr hs hy hsmall hm'
        calc
          A * q ^ m * volume (relativeTailCap n y r L s m) ≤
              A * q ^ m *
                (volume (ball (0 : Euclidean n) s) * ENNReal.ofReal
                  (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) :=
            mul_le_mul_right hcap (A * q ^ m)
          _ = A * q ^ m * volume (ball (0 : Euclidean n) s) *
              ENNReal.ofReal (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j)) := by
            ring
      · rfl

/-- The product-Tonelli step used after the fixed-radius physical kernel has
been estimated on every exterior fibre.  It is kept private because the
literal moving-band endpoint below is its only intended consumer. -/
private theorem local_lintegral_le_of_kernel_majorant
    (d : Nat) {s : ℝ} (f H : Euclidean d → ENNReal)
    (V : Euclidean d → Euclidean d → ENNReal) (K : ENNReal)
    (hfmeas : Measurable f) (hVmeas : Measurable (Function.uncurry V))
    (hmajor : ∀ x, H x ≤ ∫⁻ y : Euclidean d, f y * V x y)
    (hzero : ∀ y, ¬ s < ‖y‖ → f y = 0)
    (hmass : ∀ y, s < ‖y‖ → ∫⁻ x in ball (0 : Euclidean d) s, V x y ≤ K) :
    (∫⁻ x in ball (0 : Euclidean d) s, H x) ≤ K * ∫⁻ y, f y := by
  let B : Set (Euclidean d) := ball 0 s
  have hFmeas : Measurable (fun q : Euclidean d × Euclidean d =>
      f q.2 * V q.1 q.2) :=
    (hfmeas.comp measurable_snd).mul hVmeas
  have houtermeas : Measurable (fun x : Euclidean d =>
      ∫⁻ y : Euclidean d, f y * V x y) :=
    hFmeas.lintegral_prod_right
  calc
    (∫⁻ x in ball (0 : Euclidean d) s, H x) ≤
        ∫⁻ x in ball (0 : Euclidean d) s,
          ∫⁻ y : Euclidean d, f y * V x y := by
      apply setLIntegral_mono houtermeas
      intro x _
      exact hmajor x
    _ = ∫⁻ y : Euclidean d,
        ∫⁻ x in ball (0 : Euclidean d) s, f y * V x y := by
      exact lintegral_lintegral_swap (μ := volume.restrict B) (ν := volume)
        hFmeas.aemeasurable
    _ = ∫⁻ y : Euclidean d,
        f y * ∫⁻ x in ball (0 : Euclidean d) s, V x y := by
      apply lintegral_congr
      intro y
      have hVy : Measurable (fun x : Euclidean d => V x y) :=
        hVmeas.comp (measurable_id.prodMk measurable_const)
      rw [← lintegral_const_mul (f y) hVy]
    _ ≤ ∫⁻ y : Euclidean d, f y * K := by
      apply lintegral_mono
      intro y
      by_cases hy : s < ‖y‖
      · exact mul_le_mul_right (hmass y hy) _
      · simp [hzero y hy]
    _ = K * ∫⁻ y : Euclidean d, f y := by
      rw [show (fun y : Euclidean d => f y * K) = fun y => K * f y by
        funext y
        exact mul_comm _ _, lintegral_const_mul K hfmeas]

set_option maxHeartbeats 800000 in
-- The literal Fourier-convolution identity and the finite cap-tail sum
-- generate a large elaboration term; the proof is otherwise elementary.
/-- The literal relative dyadic multiplier has the cap-improved fixed-radius
`L¹` endpoint when the input is exterior to the output ball.  The first sum
is the near-shell contribution; the final term is the summable far-tail
remainder.  In ambient dimension `n + 1`, every near-shell summand contains
the transverse cap factor `volume (ball (0 : Euclidean n) s)`. -/
theorem exists_fixed_radius_literal_relative_dyadic_cap_lintegral_one_le
    (n : Nat) (ψ : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      {r s : ℝ}, 3 ≤ j → r ∈ Icc (1 : ℝ) 2 → 0 < s → 4 * s ≤ r →
      (∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0) →
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
        ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r • ξ) *
            ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) ≤
        ((∑ m ∈ Finset.range (j - 2),
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m *
              volume (ball (0 : Euclidean n) s) *
                ENNReal.ofReal (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 2) *
              volume (ball (0 : Euclidean (n + 1)) s)) *
          ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ := by
  let K : SchwartzMap (Euclidean (n + 1)) ℂ := 𝓕⁻ ψ
  let negA : Euclidean (n + 1) ≃L[ℝ] Euclidean (n + 1) :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 (-1 : ℝ) (by norm_num))
  let Kneg : SchwartzMap (Euclidean (n + 1)) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ negA K
  have hKneg (u : Euclidean (n + 1)) : Kneg u = K (-u) := by
    change K (negA u) = K (-u)
    simp [negA]
  obtain ⟨C, hC, hshell⟩ :=
    exists_surface_smoothed_schwartz_kernel_shell_bound (Nat.succ_pos n) Kneg
  refine ⟨C, hC, ?_⟩
  intro j f r s hj hr hs hsmall hfsupp
  have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one hr.1
  let L : ℝ := (2 : ℝ) ^ j
  have hL : 1 ≤ L := by
    dsimp only [L]
    exact one_le_pow₀ (by norm_num)
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  let σ : ℝ := L * r⁻¹
  have hσ : 0 < σ := mul_pos hLpos (inv_pos.mpr hrpos)
  let W : Euclidean (n + 1) → ℝ := fun z =>
    ∫ w : Metric.sphere (0 : Euclidean (n + 1)) 1,
      ‖L ^ (n + 1) • Kneg (L • (z - (w : Euclidean (n + 1))))‖
        ∂unitSurfaceMeasure (n + 1)
  have hWnonneg (z : Euclidean (n + 1)) : 0 ≤ W z := by
    dsimp only [W]
    exact integral_nonneg fun w => norm_nonneg _
  have hWnear (z : Euclidean (n + 1)) : W z ≤ C * L := by
    simpa only [W] using (hshell L hL z).1
  have hWtail (z : Euclidean (n + 1)) (m : Nat) :
      (2 : ℝ) ^ m / L ≤ |‖z‖ - 1| →
        W z ≤ C * L * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m := by
    intro hm
    simpa only [W] using (hshell L hL z).2 m hm
  have hWjoint : Continuous (Function.uncurry
      (fun (z : Euclidean (n + 1))
        (w : Metric.sphere (0 : Euclidean (n + 1)) 1) =>
        ‖((L ^ (n + 1) : ℝ) : ℂ) *
          Kneg (L • (z - (w : Euclidean (n + 1))))‖)) := by
    have harg : Continuous (fun p : Euclidean (n + 1) ×
        Metric.sphere (0 : Euclidean (n + 1)) 1 =>
        L • (p.1 - (p.2 : Euclidean (n + 1)))) :=
      (continuous_const : Continuous
        (fun _ : Euclidean (n + 1) × Metric.sphere (0 : Euclidean (n + 1)) 1 => L)).smul
        (continuous_fst.sub (continuous_subtype_val.comp continuous_snd))
    have hkernel : Continuous (fun p : Euclidean (n + 1) ×
        Metric.sphere (0 : Euclidean (n + 1)) 1 =>
        Kneg (L • (p.1 - (p.2 : Euclidean (n + 1))))) :=
      Kneg.continuous.comp harg
    exact (Continuous.mul
      (continuous_const : Continuous
        (fun _ : Euclidean (n + 1) × Metric.sphere (0 : Euclidean (n + 1)) 1 =>
          ((L ^ (n + 1) : ℝ) : ℂ))) hkernel).norm
  have hWcont : Continuous W := by
    dsimp only [W]
    simpa only [Complex.real_smul, Measure.restrict_univ] using
      (continuous_parametric_integral_of_continuous
        (μ := unitSurfaceMeasure (n + 1)) hWjoint isCompact_univ)
  let V : Euclidean (n + 1) → Euclidean (n + 1) → ENNReal := fun x y =>
    ENNReal.ofReal ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)))
  have hVcont : Continuous (Function.uncurry V) := by
    change Continuous (fun q : Euclidean (n + 1) × Euclidean (n + 1) =>
      ENNReal.ofReal ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (q.2 - q.1))))
    apply ENNReal.continuous_ofReal.comp
    apply continuous_const.mul
    exact hWcont.comp
      ((continuous_const : Continuous
        (fun _ : Euclidean (n + 1) × Euclidean (n + 1) => r⁻¹)).smul
        (continuous_snd.sub continuous_fst))
  have hrinv : r⁻¹ ≤ 1 := (inv_le_one₀ hrpos).mpr hr.1
  have hrpow : (r⁻¹) ^ (n + 1) ≤ 1 := by
    simpa using pow_le_one₀ (inv_nonneg.mpr hrpos.le) hrinv
  have hkernel (x y : Euclidean (n + 1)) :
      (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ C * L := by
    calc
      (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ 1 * (C * L) :=
        mul_le_mul hrpow (hWnear _) (hWnonneg _) (by positivity)
      _ = C * L := one_mul _
  have hgap (x y : Euclidean (n + 1)) :
      |‖r⁻¹ • (y - x)‖ - 1| = |‖y - x‖ - r| / r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    have hinside : r⁻¹ * ‖y - x‖ - 1 = (‖y - x‖ - r) / r := by
      field_simp [hrpos.ne']
    rw [hinside, abs_div, abs_of_pos hrpos]
  have hQnonneg : 0 ≤ ((2 : ℝ)⁻¹) ^ (n + 1 + 3) := by positivity
  have hCLnonneg : 0 ≤ C * L := mul_nonneg hC.le hLpos.le
  have hVnear (x y : Euclidean (n + 1)) :
      V x y ≤ ENNReal.ofReal (C * L) := by
    dsimp only [V]
    exact ENNReal.ofReal_le_ofReal (hkernel x y)
  have hVtail (x y : Euclidean (n + 1)) (m : Nat)
      (hm : (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r) :
      V x y ≤ ENNReal.ofReal (C * L) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m := by
    have hm' : (2 : ℝ) ^ m / L ≤ |‖r⁻¹ • (y - x)‖ - 1| := by
      rw [hgap]
      simpa only [L] using hm
    rw [show V x y = ENNReal.ofReal
        ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x))) by rfl,
      ← ENNReal.ofReal_pow hQnonneg,
      ← ENNReal.ofReal_mul hCLnonneg]
    apply ENNReal.ofReal_le_ofReal
    calc
      (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤
          1 * (C * L * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m) :=
        mul_le_mul hrpow (hWtail _ m hm') (hWnonneg _) (by positivity)
      _ = (C * L) * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m := by ring
  have hmass (y : Euclidean (n + 1)) (hy : s < ‖y‖) :
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s, V x y) ≤
        (∑ m ∈ Finset.range (j - 2),
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m *
              volume (ball (0 : Euclidean n) s) *
                ENNReal.ofReal (6 * (r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 2) *
              volume (ball (0 : Euclidean (n + 1)) s) := by
    simpa only [L] using
      (local_lintegral_radial_tail_le n y j hj hrpos hs hy hsmall
        (ENNReal.ofReal (C * L))
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ) (fun x => V x y)
        (hVcont.comp (continuous_id.prodMk continuous_const)).measurable
        (fun x => hVnear x y) (fun x m hm => hVtail x y m hm))
  have hphysical (x : Euclidean (n + 1)) :
      𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x =
        sphericalAverage (n + 1)
          (fun z : Euclidean (n + 1) =>
            ((fun y : Euclidean (n + 1) => σ ^ (n + 1) • K (σ • y))
              ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
              (f : Euclidean (n + 1) → ℂ)) z) r x := by
    rw [fourierInv_relative_surface_scaled_schwartz_multiplier_eq_surface_convolution ψ f j
      hrpos x]
    unfold sphericalAverage
    congr 1
    funext w
