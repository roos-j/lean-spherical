      (∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) →
      (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
        ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
          ∂powerWeightedVolume (n + 1) α) ≤
        (ENNReal.ofReal (s / 2)) ^ α * relativeIntervalBandCapTail n j C u v s *
          ((ENNReal.ofReal a) ^ α)⁻¹ *
            ∫⁻ y, ENNReal.ofReal ‖f y‖ ∂powerWeightedVolume (n + 1) α := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_moving_band_cap_lintegral_one_le n phi
