        volume (ball (0 : Euclidean (n + 1)) s)

/-- On the output ball, the maximal radial kernel over a short interval is
dominated by the cap majorant. -/
theorem iSup_radial_interval_tail_le_relativeIntervalTailMajorant
    (n : Nat) (y : Euclidean (n + 1)) {a b s : ℝ} (j : Nat)
    (hj : 4 ≤ j) (ha : 1 ≤ a) (hab : a ≤ b)
    (A q : ENNReal) (V : ℝ → Euclidean (n + 1) → ENNReal)
    (hnear : ∀ r ∈ Icc a b, ∀ x, V r x ≤ A)
    (htail : ∀ r ∈ Icc a b, ∀ (x : Euclidean (n + 1)) (m : Nat),
      (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r →
        V r x ≤ A * q ^ m)
    (x : Euclidean (n + 1)) (hx : x ∈ ball 0 s) :
    (⨆ r : Icc a b, V r.1 x) ≤
      relativeIntervalTailMajorant n y a b s j A q x := by
  let B : Set (Euclidean (n + 1)) := ball 0 s
  let L : ℝ := (2 : ℝ) ^ j
  let F : ℕ → Euclidean (n + 1) → ENNReal := fun m z =>
    A * q ^ m * (relativeIntervalTailCap n y b (b - a) L s m).indicator
      (fun _ => (1 : ENNReal)) z
  let G : Euclidean (n + 1) → ENNReal := fun z =>
    A * q ^ (j - 3) * B.indicator (fun _ => (1 : ENNReal)) z
  change (⨆ r : Icc a b, V r.1 x) ≤
    (∑ m ∈ Finset.range (j - 3), F m x) + G x
  have hL : 0 < L := by
    dsimp only [L]
    positivity
  have hb : 0 < b := lt_of_lt_of_le zero_lt_one (ha.trans hab)
  let u : ℝ := L * b⁻¹ * (|‖y - x‖ - b| - (b - a))
  apply iSup_le
  intro r
  by_cases hu : u < 2
  · have hcap : x ∈ relativeIntervalTailCap n y b (b - a) L s 0 := by
      apply mem_relativeIntervalTailCap_of_scaled_gap_lt n y x 0 hab hb hL hx
      have hu' : u < (2 : ℝ) ^ (0 + 1) := by simpa using hu
      simpa only [u] using hu'
    have hzero : 0 ∈ Finset.range (j - 3) := Finset.mem_range.mpr (by omega)
    have hterm : V r.1 x ≤ F 0 x := by
      calc
        V r.1 x ≤ A := hnear r.1 r.2 x
        _ = F 0 x := by
          dsimp only [F]
          rw [Set.indicator_of_mem hcap]
          simp
    calc
      V r.1 x ≤ F 0 x := hterm
      _ ≤ ∑ m ∈ Finset.range (j - 3), F m x :=
        Finset.single_le_sum (s := Finset.range (j - 3))
          (f := fun m => F m x) (fun _ _ => bot_le) hzero
      _ ≤ (∑ m ∈ Finset.range (j - 3), F m x) + G x :=
        le_add_of_nonneg_right bot_le
  · have htwo : 2 ≤ u := le_of_not_gt hu
    by_cases hfar : (2 : ℝ) ^ (j - 3) ≤ u
    · have hthreshold :
          (2 : ℝ) ^ (j - 3) / (2 : ℝ) ^ j ≤ |‖y - x‖ - r.1| / r.1 := by
        apply relative_interval_tail_threshold (lt_of_lt_of_le zero_lt_one ha) r.2 hL
        simpa only [u] using hfar
      have hterm : V r.1 x ≤ G x := by
        calc
          V r.1 x ≤ A * q ^ (j - 3) := htail r.1 r.2 x (j - 3) hthreshold
          _ = G x := by
            dsimp only [G]
            rw [Set.indicator_of_mem hx]
            simp
      calc
        V r.1 x ≤ G x := hterm
        _ ≤ (∑ m ∈ Finset.range (j - 3), F m x) + G x :=
          le_add_of_nonneg_left bot_le
    · have huupper : u < (2 : ℝ) ^ (j - 3) := lt_of_not_ge hfar
      obtain ⟨m, hmlower, hmupper⟩ := exists_relative_interval_dyadic_annulus htwo
      have hm : m < j - 3 := by
        by_contra hnot
        have hm' : j - 3 ≤ m := Nat.le_of_not_gt hnot
        have hpow_nat : 2 ^ (j - 3) ≤ 2 ^ m :=
          Nat.pow_le_pow_right (by omega) hm'
        have hpow : (2 : ℝ) ^ (j - 3) ≤ (2 : ℝ) ^ m := by
          exact_mod_cast hpow_nat
        exact (not_lt_of_ge (hpow.trans hmlower)) huupper
      have hcap : x ∈ relativeIntervalTailCap n y b (b - a) L s m := by
        apply mem_relativeIntervalTailCap_of_scaled_gap_lt n y x m hab hb hL hx
        simpa only [u] using hmupper
      have hthreshold :
          (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r.1| / r.1 := by
        apply relative_interval_tail_threshold (lt_of_lt_of_le zero_lt_one ha) r.2 hL
        simpa only [u] using hmlower
      have hmset : m ∈ Finset.range (j - 3) := Finset.mem_range.mpr hm
      have hterm : V r.1 x ≤ F m x := by
        calc
          V r.1 x ≤ A * q ^ m := htail r.1 r.2 x m hthreshold
          _ = F m x := by
            dsimp only [F]
            rw [Set.indicator_of_mem hcap]
            simp
      calc
        V r.1 x ≤ F m x := hterm
        _ ≤ ∑ m ∈ Finset.range (j - 3), F m x :=
          Finset.single_le_sum (s := Finset.range (j - 3))
            (f := fun m => F m x) (fun _ _ => bot_le) hmset
        _ ≤ (∑ m ∈ Finset.range (j - 3), F m x) + G x :=
          le_add_of_nonneg_right bot_le

/-- The interval cap majorant has the expected codimension-one small-ball
mass. -/
theorem lintegral_relativeIntervalTailMajorant_le
    (n : Nat) (y : Euclidean (n + 1)) {a b s : ℝ} (j : Nat)
    (hj : 4 ≤ j) (ha : 1 ≤ a) (hab : a ≤ b) (hs : 0 < s)
    (hy : s < ‖y‖) (hsmall : 4 * s ≤ a)
    (hwidth : b - a ≤ ((2 : ℝ) ^ j)⁻¹) (A q : ENNReal) :
    (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
      relativeIntervalTailMajorant n y a b s j A q x) ≤
      (∑ m ∈ Finset.range (j - 3),
        A * q ^ m * volume (ball (0 : Euclidean n) s) *
          ENNReal.ofReal
            (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
        A * q ^ (j - 3) * volume (ball (0 : Euclidean (n + 1)) s) := by
  let B : Set (Euclidean (n + 1)) := ball 0 s
  let F : ℕ → Euclidean (n + 1) → ENNReal := fun m x =>
    A * q ^ m *
      (relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m).indicator
        (fun _ => (1 : ENNReal)) x
  let G : Euclidean (n + 1) → ENNReal := fun x =>
    A * q ^ (j - 3) * B.indicator (fun _ => (1 : ENNReal)) x
  change (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
    (∑ m ∈ Finset.range (j - 3), F m x) + G x) ≤ _
  have hFmeas (m : ℕ) : Measurable (F m) := by
    dsimp only [F]
    exact measurable_const.mul
      (measurable_const.indicator
        (measurableSet_relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m))
  have hGmeas : Measurable G := by
    dsimp only [G]
    exact measurable_const.mul
      (measurable_const.indicator (by
        dsimp only [B]
        exact measurableSet_ball))
  have hFint (m : ℕ) :
      (∫⁻ x : Euclidean (n + 1), F m x) =
        A * q ^ m * volume
          (relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m) := by
    dsimp only [F]
    rw [lintegral_const_mul _ (measurable_const.indicator
      (measurableSet_relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m)),
      lintegral_indicator
        (measurableSet_relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m),
      setLIntegral_const]
    simp
  have hGint : (∫⁻ x : Euclidean (n + 1), G x) =
      A * q ^ (j - 3) * volume B := by
    dsimp only [G]
    rw [lintegral_const_mul _ (measurable_const.indicator (by
        dsimp only [B]
        exact measurableSet_ball)),
      lintegral_indicator (by
        dsimp only [B]
        exact measurableSet_ball), setLIntegral_const]
    simp
  calc
    (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
      (∑ m ∈ Finset.range (j - 3), F m x) + G x) ≤
        ∫⁻ x : Euclidean (n + 1),
          (∑ m ∈ Finset.range (j - 3), F m x) + G x :=
      lintegral_mono' Measure.restrict_le_self le_rfl
    _ = (∑ m ∈ Finset.range (j - 3), ∫⁻ x : Euclidean (n + 1), F m x) +
        ∫⁻ x : Euclidean (n + 1), G x := by
      rw [MeasureTheory.lintegral_add_left
        (Finset.measurable_fun_sum _ fun m _ => hFmeas m),
        lintegral_finsetSum _ (fun m _ => hFmeas m)]
    _ = (∑ m ∈ Finset.range (j - 3),
        A * q ^ m * volume
          (relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m)) +
        A * q ^ (j - 3) * volume B := by
      rw [hGint]
      apply congrArg (fun z : ENNReal => z + A * q ^ (j - 3) * volume B)
      apply Finset.sum_congr rfl
      intro m _
      exact hFint m
    _ ≤ (∑ m ∈ Finset.range (j - 3),
        A * q ^ m * volume (ball (0 : Euclidean n) s) *
          ENNReal.ofReal
            (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
        A * q ^ (j - 3) * volume (ball (0 : Euclidean (n + 1)) s) := by
      apply add_le_add
      · apply Finset.sum_le_sum
        intro m hm
        have hm' : m < j - 3 := Finset.mem_range.mp hm
        have hcap := volume_relativeIntervalTailCap_le n y j m
          ha hab hj hs hy hsmall hwidth hm'
        calc
          A * q ^ m * volume
              (relativeIntervalTailCap n y b (b - a) ((2 : ℝ) ^ j) s m) ≤
              A * q ^ m *
                (volume (ball (0 : Euclidean n) s) * ENNReal.ofReal
                  (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) :=
            mul_le_mul_right hcap (A * q ^ m)
          _ = A * q ^ m * volume (ball (0 : Euclidean n) s) *
              ENNReal.ofReal
                (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j)) := by
            ring
      · rfl

private theorem measurable_uncurry_relativeIntervalTailMajorant
    (n : Nat) (a b s : ℝ) (j : Nat) (A q : ENNReal) :
    Measurable (Function.uncurry fun (x y : Euclidean (n + 1)) =>
      relativeIntervalTailMajorant n y a b s j A q x) := by
  let B : Set (Euclidean (n + 1)) := ball 0 s
  let S : ℕ → Set (Euclidean (n + 1) × Euclidean (n + 1)) := fun m =>
    {z | z.1 ∈ B ∧ |‖z.2 - z.1‖ - b| <
      b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j}
  let F : ℕ → Euclidean (n + 1) × Euclidean (n + 1) → ENNReal := fun m z =>
    A * q ^ m * (S m).indicator (fun _ => (1 : ENNReal)) z
  let G : Euclidean (n + 1) × Euclidean (n + 1) → ENNReal := fun z =>
    A * q ^ (j - 3) * B.indicator (fun _ => (1 : ENNReal)) z.1
  have hgap : Measurable (fun z : Euclidean (n + 1) × Euclidean (n + 1) =>
      |‖z.2 - z.1‖ - b|) :=
    (((continuous_snd.sub continuous_fst).norm.sub
      (continuous_const : Continuous fun _ : Euclidean (n + 1) × Euclidean (n + 1) =>
          b)).abs).measurable
  have hB : MeasurableSet B := by
    dsimp only [B]
    exact measurableSet_ball
  have hS (m : ℕ) : MeasurableSet (S m) := by
    dsimp only [S]
    change MeasurableSet
      ((fun z : Euclidean (n + 1) × Euclidean (n + 1) => z.1) ⁻¹' B ∩
        (fun z : Euclidean (n + 1) × Euclidean (n + 1) =>
          |‖z.2 - z.1‖ - b|) ⁻¹'
          Iio (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))
    exact (hB.preimage measurable_fst).inter
      (measurableSet_Iio.preimage hgap)
  have hF (m : ℕ) : Measurable (F m) := by
    dsimp only [F]
    exact measurable_const.mul (measurable_const.indicator (hS m))
  have hG : Measurable G := by
    dsimp only [G]
    exact measurable_const.mul
      ((measurable_const.indicator hB).comp measurable_fst)
  change Measurable (fun z : Euclidean (n + 1) × Euclidean (n + 1) =>
    (∑ m ∈ Finset.range (j - 3), F m z) + G z)
  exact (Finset.measurable_fun_sum _ fun m _ => hF m).add hG

private theorem local_lintegral_le_of_interval_kernel_majorant
    (d : Nat) {s : ℝ} (f H : Euclidean d → ENNReal)
    (V : Euclidean d → Euclidean d → ENNReal) (K : ENNReal)
    (hfmeas : Measurable f) (hVmeas : Measurable (Function.uncurry V))
    (hmajor : ∀ x, x ∈ ball (0 : Euclidean d) s →
      H x ≤ ∫⁻ y : Euclidean d, f y * V x y)
    (hzero : ∀ y, ¬ s < ‖y‖ → f y = 0)
    (hmass : ∀ y, s < ‖y‖ → ∫⁻ x in ball (0 : Euclidean d) s, V x y ≤ K) :
    (∫⁻ x in ball (0 : Euclidean d) s, H x) ≤ K * ∫⁻ y : Euclidean d, f y := by
  let B : Set (Euclidean d) := ball 0 s
  have hFmeas : Measurable (fun z : Euclidean d × Euclidean d =>
      f z.2 * V z.1 z.2) :=
    (hfmeas.comp measurable_snd).mul hVmeas
  have houtermeas : Measurable (fun x : Euclidean d =>
      ∫⁻ y : Euclidean d, f y * V x y) :=
    hFmeas.lintegral_prod_right
  calc
    (∫⁻ x in ball (0 : Euclidean d) s, H x) ≤
        ∫⁻ x in ball (0 : Euclidean d) s,
          ∫⁻ y : Euclidean d, f y * V x y := by
      apply setLIntegral_mono houtermeas
      intro x hx
      exact hmajor x hx
    _ = ∫⁻ y : Euclidean d,
        ∫⁻ x in ball (0 : Euclidean d) s, f y * V x y := by
      exact lintegral_lintegral_swap (μ := volume.restrict B) (ν := volume)
        hFmeas.aemeasurable
    _ = ∫⁻ y : Euclidean d,
        f y * ∫⁻ x in ball (0 : Euclidean d) s, V x y := by
      apply lintegral_congr
      intro y
      have hVy : Measurable (fun x : Euclidean d => V x y) :=
        hVmeas.comp (measurable_id.prodMk measurable_const)
      rw [← lintegral_const_mul (f y) hVy]
    _ ≤ ∫⁻ y : Euclidean d, f y * K := by
      apply lintegral_mono
      intro y
      by_cases hy : s < ‖y‖
      · exact mul_le_mul_right (hmass y hy) _
      · simp [hzero y hy]
    _ = K * ∫⁻ y : Euclidean d, f y := by
      rw [show (fun y : Euclidean d => f y * K) = fun y => K * f y by
        funext y
        exact mul_comm _ _, lintegral_const_mul K hfmeas]

private theorem lintegral_add_restrict_eq_lintegral_of_support_left_interval
    {X : Type*} [MeasurableSpace X] {ν : Measure X} {A B : Set X}
    (hA : MeasurableSet A) (hB : MeasurableSet B) (hdisj : Disjoint A B)
    (G : X → ENNReal) (hGsupport : ∀ x, x ∉ A → G x = 0) :
    (∫⁻ x, G x ∂(ν.restrict A + ν.restrict B)) = ∫⁻ x, G x ∂ν := by
  have hBzero : (∫⁻ x, G x ∂ν.restrict B) = 0 := by
    calc
      (∫⁻ x, G x ∂ν.restrict B) = ∫⁻ x, B.indicator G x ∂ν :=
        (lintegral_indicator hB G).symm
      _ = ∫⁻ x : X, 0 ∂ν := by
        congr with x
        by_cases hx : x ∈ B
        · rw [Set.indicator_of_mem hx]
          have hxnot : x ∉ A := fun hxA => (Set.disjoint_left.mp hdisj) hxA hx
          simp [hGsupport x hxnot]
        · rw [Set.indicator_of_notMem hx]
      _ = 0 := lintegral_zero
  have hAeq : (∫⁻ x, G x ∂ν.restrict A) = ∫⁻ x, G x ∂ν :=
    (lintegral_eq_lintegral_restrict_of_support A hA G hGsupport).symm
  calc
    (∫⁻ x, G x ∂(ν.restrict A + ν.restrict B)) =
        (∫⁻ x, G x ∂ν.restrict A) + ∫⁻ x, G x ∂ν.restrict B :=
      lintegral_add_measure G _ _
    _ = (∫⁻ x, G x ∂ν.restrict A) + 0 := by rw [hBzero]
    _ = ∫⁻ x, G x ∂ν := by rw [add_zero, hAeq]

private theorem lintegral_add_restrict_eq_lintegral_of_support_right_interval
    {X : Type*} [MeasurableSpace X] {ν : Measure X} {A B : Set X}
    (hA : MeasurableSet A) (hB : MeasurableSet B) (hdisj : Disjoint A B)
    (G : X → ENNReal) (hGsupport : ∀ x, x ∉ B → G x = 0) :
    (∫⁻ x, G x ∂(ν.restrict A + ν.restrict B)) = ∫⁻ x, G x ∂ν := by
  simpa only [add_comm] using
    (lintegral_add_restrict_eq_lintegral_of_support_left_interval
      hB hA hdisj.symm G hGsupport)

set_option maxHeartbeats 800000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- A literal relative dyadic multiplier, maximised over one interval of
length at most its reciprocal frequency, has the cap-improved local `L¹`
endpoint. -/
theorem exists_interval_literal_relative_dyadic_cap_lintegral_one_le
    (n : Nat) (ψ : SchwartzMap (Euclidean (n + 1)) ℂ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      {a b s : ℝ}, 4 ≤ j → a ≤ b → 1 ≤ a → b ≤ 2 → 0 < s → 4 * s ≤ a →
      b - a ≤ ((2 : ℝ) ^ j)⁻¹ →
      (∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0) →
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) ≤
        ((∑ m ∈ Finset.range (j - 3),
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m *
              volume (ball (0 : Euclidean n) s) *
                ENNReal.ofReal
                  (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3) *
              volume (ball (0 : Euclidean (n + 1)) s)) *
          ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ := by
  let K : SchwartzMap (Euclidean (n + 1)) ℂ := 𝓕⁻ ψ
  let negA : Euclidean (n + 1) ≃L[ℝ] Euclidean (n + 1) :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 (-1 : ℝ) (by norm_num))
  let Kneg : SchwartzMap (Euclidean (n + 1)) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ negA K
  have hKneg (u : Euclidean (n + 1)) : Kneg u = K (-u) := by
    change K (negA u) = K (-u)
    simp [negA]
  obtain ⟨C, hC, hshell⟩ :=
    exists_surface_smoothed_schwartz_kernel_shell_bound (Nat.succ_pos n) Kneg
  refine ⟨C, hC, ?_⟩
  intro j f a b s hj hab ha hb hs hsmall hwidth hfsupp
  let L : ℝ := (2 : ℝ) ^ j
  have hL : 1 ≤ L := by
    dsimp only [L]
    exact one_le_pow₀ (by norm_num)
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hL
  let σ : ℝ → ℝ := fun r => L * r⁻¹
  let W : Euclidean (n + 1) → ℝ := fun z =>
    ∫ w : Metric.sphere (0 : Euclidean (n + 1)) 1,
      ‖L ^ (n + 1) • Kneg (L • (z - (w : Euclidean (n + 1))))‖
        ∂unitSurfaceMeasure (n + 1)
  have hWnonneg (z : Euclidean (n + 1)) : 0 ≤ W z := by
    dsimp only [W]
    exact integral_nonneg fun w => norm_nonneg _
  have hWnear (z : Euclidean (n + 1)) : W z ≤ C * L := by
    simpa only [W] using (hshell L hL z).1
  have hWtail (z : Euclidean (n + 1)) (m : Nat) :
      (2 : ℝ) ^ m / L ≤ |‖z‖ - 1| →
        W z ≤ C * L * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m := by
    intro hm
    simpa only [W] using (hshell L hL z).2 m hm
  have hWjoint : Continuous (Function.uncurry
      (fun (z : Euclidean (n + 1))
        (w : Metric.sphere (0 : Euclidean (n + 1)) 1) =>
        ‖((L ^ (n + 1) : ℝ) : ℂ) *
          Kneg (L • (z - (w : Euclidean (n + 1))))‖)) := by
    have harg : Continuous (fun p : Euclidean (n + 1) ×
        Metric.sphere (0 : Euclidean (n + 1)) 1 =>
        L • (p.1 - (p.2 : Euclidean (n + 1)))) :=
      (continuous_const : Continuous
        (fun _ : Euclidean (n + 1) × Metric.sphere (0 : Euclidean (n + 1)) 1 => L)).smul
        (continuous_fst.sub (continuous_subtype_val.comp continuous_snd))
    have hkernel : Continuous (fun p : Euclidean (n + 1) ×
        Metric.sphere (0 : Euclidean (n + 1)) 1 =>
        Kneg (L • (p.1 - (p.2 : Euclidean (n + 1))))) :=
      Kneg.continuous.comp harg
    exact (Continuous.mul
      (continuous_const : Continuous
        (fun _ : Euclidean (n + 1) × Metric.sphere (0 : Euclidean (n + 1)) 1 =>
          ((L ^ (n + 1) : ℝ) : ℂ))) hkernel).norm
  have hWcont : Continuous W := by
    dsimp only [W]
    simpa only [Complex.real_smul, Measure.restrict_univ] using
      (continuous_parametric_integral_of_continuous
        (μ := unitSurfaceMeasure (n + 1)) hWjoint isCompact_univ)
  let V : ℝ → Euclidean (n + 1) → Euclidean (n + 1) → ENNReal := fun r x y =>
    ENNReal.ofReal ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)))
  have hQnonneg : 0 ≤ ((2 : ℝ)⁻¹) ^ (n + 1 + 3) := by positivity
  have hCLnonneg : 0 ≤ C * L := mul_nonneg hC.le hLpos.le
  have hVnear (r : ℝ) (hr : r ∈ Icc a b)
      (x y : Euclidean (n + 1)) :
      V r x y ≤ ENNReal.ofReal (C * L) := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    have hrinv : r⁻¹ ≤ 1 := (inv_le_one₀ hrpos).mpr (ha.trans hr.1)
    have hrpow : (r⁻¹) ^ (n + 1) ≤ 1 := by
      simpa using pow_le_one₀ (inv_nonneg.mpr hrpos.le) hrinv
    have hkernel :
        (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ C * L := by
      calc
        (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ 1 * (C * L) :=
          mul_le_mul hrpow (hWnear _) (hWnonneg _) (by positivity)
        _ = C * L := one_mul _
    dsimp only [V]
    exact ENNReal.ofReal_le_ofReal hkernel
  have hVtail (r : ℝ) (hr : r ∈ Icc a b)
      (x y : Euclidean (n + 1)) (m : Nat)
      (hm : (2 : ℝ) ^ m / (2 : ℝ) ^ j ≤ |‖y - x‖ - r| / r) :
      V r x y ≤ ENNReal.ofReal (C * L) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    have hrinv : r⁻¹ ≤ 1 := (inv_le_one₀ hrpos).mpr (ha.trans hr.1)
    have hrpow : (r⁻¹) ^ (n + 1) ≤ 1 := by
      simpa using pow_le_one₀ (inv_nonneg.mpr hrpos.le) hrinv
    have hgap : |‖r⁻¹ • (y - x)‖ - 1| = |‖y - x‖ - r| / r := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
      have hinside : r⁻¹ * ‖y - x‖ - 1 = (‖y - x‖ - r) / r := by
        field_simp [hrpos.ne']
      rw [hinside, abs_div, abs_of_pos hrpos]
    have hm' : (2 : ℝ) ^ m / L ≤ |‖r⁻¹ • (y - x)‖ - 1| := by
      rw [hgap]
      simpa only [L] using hm
    rw [show V r x y = ENNReal.ofReal
        ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x))) by rfl,
      ← ENNReal.ofReal_pow hQnonneg,
      ← ENNReal.ofReal_mul hCLnonneg]
    apply ENNReal.ofReal_le_ofReal
    calc
      (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤
          1 * (C * L * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m) :=
        mul_le_mul hrpow (hWtail _ m hm') (hWnonneg _) (by positivity)
      _ = (C * L) * (((2 : ℝ)⁻¹) ^ (n + 1 + 3)) ^ m := by ring
  have hphysical (r : ℝ) (hr : r ∈ Icc a b) (x : Euclidean (n + 1)) :
      𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x =
        sphericalAverage (n + 1)
          (fun z : Euclidean (n + 1) =>
            ((fun y : Euclidean (n + 1) => (σ r) ^ (n + 1) • K ((σ r) • y))
              ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
              (f : Euclidean (n + 1) → ℂ)) z) r x := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    rw [fourierInv_relative_surface_scaled_schwartz_multiplier_eq_surface_convolution ψ f j
      hrpos x]
    unfold sphericalAverage
    congr 1
    funext w
    congr 3
    dsimp only [σ, L, K]
    rw [mul_inv_rev, inv_inv]
    funext y
    congr 2 <;> ring_nf
  have hinner (r : ℝ) (hr : r ∈ Icc a b)
      (x y : Euclidean (n + 1)) :
      (∫ w : Metric.sphere (0 : Euclidean (n + 1)) 1,
        ‖(σ r) ^ (n + 1) • K
          ((σ r) • (x + r • (w : Euclidean (n + 1)) - y))‖
          ∂unitSurfaceMeasure (n + 1)) =
        (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    dsimp only [W]
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with w
    have hσ_eq : σ r = L * r⁻¹ := rfl
    have harg : σ r • (x + r • (w : Euclidean (n + 1)) - y) =
        - (L • (r⁻¹ • (y - x) - (w : Euclidean (n + 1)))) := by
      rw [hσ_eq]
      exact relative_interval_cap_kernel_argument L r hrpos x y
        (w : Euclidean (n + 1))
    rw [harg, ← hKneg]
    change ‖((σ r ^ (n + 1) : ℝ) : ℂ) *
        Kneg (L • (r⁻¹ • (y - x) - (w : Euclidean (n + 1))))‖ =
      (r⁻¹) ^ (n + 1) * ‖((L ^ (n + 1) : ℝ) : ℂ) *
        Kneg (L • (r⁻¹ • (y - x) - (w : Euclidean (n + 1))))‖
    rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real]
    simp only [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hLpos.le _)]
    rw [hσ_eq, mul_pow]
    ring_nf
    rw [abs_of_nonneg (by positivity)]
  have hpointreal (r : ℝ) (hr : r ∈ Icc a b)
      (x : Euclidean (n + 1)) :
      ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ ≤
        ∫ y : Euclidean (n + 1), ‖f y‖ *
          ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x))) := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    have hσ : 0 < σ r := by
      dsimp only [σ]
      exact mul_pos hLpos (inv_pos.mpr hrpos)
    calc
      ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ =
          ‖sphericalAverage (n + 1)
            (fun z : Euclidean (n + 1) =>
              ((fun y : Euclidean (n + 1) => (σ r) ^ (n + 1) • K ((σ r) • y))
                ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
                (f : Euclidean (n + 1) → ℂ)) z) r x‖ := by
            rw [hphysical r hr x]
      _ ≤ ∫ y : Euclidean (n + 1), ‖f y‖ *
          (∫ w : Metric.sphere (0 : Euclidean (n + 1)) 1,
            ‖(σ r) ^ (n + 1) • K
              ((σ r) • (x + r • (w : Euclidean (n + 1)) - y))‖
              ∂unitSurfaceMeasure (n + 1)) :=
          norm_sphericalAverage_scaled_schwartz_convolution_le K f hσ x
      _ = ∫ y : Euclidean (n + 1), ‖f y‖ *
          ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x))) := by
          apply integral_congr_ae
          filter_upwards with y
          rw [hinner r hr x y]
  have hrightint : Integrable (fun y : Euclidean (n + 1) => ‖f y‖ * (C * L)) :=
    f.integrable.norm.mul_const (C * L)
  have hleftint (r : ℝ) (hr : r ∈ Icc a b) (x : Euclidean (n + 1)) :
      Integrable (fun y : Euclidean (n + 1) => ‖f y‖ *
        ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)))) := by
    have hrpos : 0 < r := lt_of_lt_of_le zero_lt_one (ha.trans hr.1)
    have hrinv : r⁻¹ ≤ 1 := (inv_le_one₀ hrpos).mpr (ha.trans hr.1)
    have hrpow : (r⁻¹) ^ (n + 1) ≤ 1 := by
      simpa using pow_le_one₀ (inv_nonneg.mpr hrpos.le) hrinv
    have hkernel (y : Euclidean (n + 1)) :
        (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ C * L := by
      calc
        (r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)) ≤ 1 * (C * L) :=
          mul_le_mul hrpow (hWnear _) (hWnonneg _) (by positivity)
        _ = C * L := one_mul _
    have hWargcont : Continuous (fun y : Euclidean (n + 1) =>
        W (r⁻¹ • (y - x))) :=
      hWcont.comp
        ((continuous_const : Continuous (fun _ : Euclidean (n + 1) => r⁻¹)).smul
          (continuous_id.sub (continuous_const : Continuous
            (fun _ : Euclidean (n + 1) => x))))
    have hleftcont : Continuous (fun y : Euclidean (n + 1) =>
        ‖f y‖ * ((r⁻¹) ^ (n + 1) * W (r⁻¹ • (y - x)))) :=
      f.continuous.norm.mul (continuous_const.mul hWargcont)
    refine hrightint.mono' hleftcont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => ?_)
    rw [Real.norm_of_nonneg]
    · exact mul_le_mul_of_nonneg_left (hkernel y) (norm_nonneg _)
    · exact mul_nonneg (norm_nonneg _)
        (mul_nonneg (pow_nonneg (inv_nonneg.mpr hrpos.le) _) (hWnonneg _))
  let Input : Euclidean (n + 1) → ENNReal := fun y => ENNReal.ofReal ‖f y‖
  let H : Euclidean (n + 1) → ENNReal := fun x =>
    ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r.1 • ξ) *
        ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
          𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖
  let M : Euclidean (n + 1) → Euclidean (n + 1) → ENNReal := fun x y =>
    relativeIntervalTailMajorant n y a b s j
      (ENNReal.ofReal (C * L))
      (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) x
  let Ktail : ENNReal :=
    (∑ m ∈ Finset.range (j - 3),
      ENNReal.ofReal (C * L) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m *
          volume (ball (0 : Euclidean n) s) *
            ENNReal.ofReal
              (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
      ENNReal.ofReal (C * L) *
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3) *
          volume (ball (0 : Euclidean (n + 1)) s)
  have hInputmeas : Measurable Input := f.continuous.norm.measurable.ennreal_ofReal
  have hMmeas : Measurable (Function.uncurry M) := by
    dsimp only [M]
    exact measurable_uncurry_relativeIntervalTailMajorant n a b s j
      (ENNReal.ofReal (C * L))
      (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3)))
  have hzero (y : Euclidean (n + 1)) (hy : ¬ s < ‖y‖) : Input y = 0 := by
    dsimp only [Input]
    rw [hfsupp y hy]
    simp
  have hmass (y : Euclidean (n + 1)) (hy : s < ‖y‖) :
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s, M x y) ≤ Ktail := by
    dsimp only [M, Ktail]
    exact lintegral_relativeIntervalTailMajorant_le n y j hj ha hab hs hy hsmall hwidth
      (ENNReal.ofReal (C * L))
      (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3)))
  have hmajor (x : Euclidean (n + 1)) (hx : x ∈ ball (0 : Euclidean (n + 1)) s) :
      H x ≤ ∫⁻ y : Euclidean (n + 1), Input y * M x y := by
    have hVmajor (y : Euclidean (n + 1)) :
        (⨆ r : Icc a b, V r.1 x y) ≤ M x y := by
      dsimp only [M]
      exact iSup_radial_interval_tail_le_relativeIntervalTailMajorant n y j hj ha hab
        (ENNReal.ofReal (C * L))
        (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) (fun r z => V r z y)
        (fun r hr z => hVnear r hr z y)
        (fun r hr z m hm => hVtail r hr z y m hm) x hx
    dsimp only [H]
    apply iSup_le
    intro r
    have hpoint : ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r.1 • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ ≤
        ∫⁻ y : Euclidean (n + 1), Input y * V r.1 x y := by
      calc
        ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ ≤
            ENNReal.ofReal (∫ y : Euclidean (n + 1), ‖f y‖ *
              ((r.1⁻¹) ^ (n + 1) * W (r.1⁻¹ • (y - x)))) :=
          ENNReal.ofReal_le_ofReal (hpointreal r.1 r.2 x)
        _ = ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal
            (‖f y‖ * ((r.1⁻¹) ^ (n + 1) * W (r.1⁻¹ • (y - x)))) :=
          ofReal_integral_eq_lintegral_ofReal (hleftint r.1 r.2 x)
            (Filter.Eventually.of_forall fun y => mul_nonneg (norm_nonneg _)
              (mul_nonneg (pow_nonneg (inv_nonneg.mpr
                (lt_of_lt_of_le zero_lt_one (ha.trans r.2.1)).le) _) (hWnonneg _)))
        _ = ∫⁻ y : Euclidean (n + 1), Input y * V r.1 x y := by
          apply lintegral_congr
          intro y
          rw [ENNReal.ofReal_mul (norm_nonneg _)]
    calc
      ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r.1 • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ ≤
          ∫⁻ y : Euclidean (n + 1), Input y * V r.1 x y := hpoint
      _ ≤ ∫⁻ y : Euclidean (n + 1), Input y * M x y := by
        apply lintegral_mono
        intro y
        have hsingle : V r.1 x y ≤ ⨆ t : Icc a b, V t.1 x y :=
          le_iSup (fun t : Icc a b => V t.1 x y) r
        exact mul_le_mul_right (hsingle.trans (hVmajor y)) (Input y)
  simpa only [H, Input, M, Ktail, L] using
    (local_lintegral_le_of_interval_kernel_majorant (n + 1) Input H M Ktail
      hInputmeas hMmeas hmajor hzero hmass)

/-- The preceding interval endpoint in the exact smooth moving-band cutoff
convention. -/
theorem exists_interval_literal_moving_band_cap_lintegral_one_le
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (_hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (_hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (_hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      {a b s : ℝ}, 4 ≤ j → a ≤ b → 1 ≤ a → b ≤ 2 → 0 < s → 4 * s ≤ a →
      b - a ≤ ((2 : ℝ) ^ j)⁻¹ →
      (∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0) →
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s,
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) ≤
        ((∑ m ∈ Finset.range (j - 3),
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ m *
              volume (ball (0 : Euclidean n) s) *
                ENNReal.ofReal
                  (6 * (b - a + b * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j))) +
          ENNReal.ofReal (C * (2 : ℝ) ^ j) *
            (ENNReal.ofReal (((2 : ℝ)⁻¹) ^ (n + 1 + 3))) ^ (j - 3) *
              volume (ball (0 : Euclidean (n + 1)) s)) *
          ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ := by
  obtain ⟨ψ, hψ⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_relative_dyadic_cap_lintegral_one_le n ψ
  refine ⟨C, hC, ?_⟩
  intro j f a b s hj hab ha hb hs hsmall hwidth hfsupp
  have hscalar : (2 : ℝ)⁻¹ * ((2 : ℝ) ^ j)⁻¹ = ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [pow_succ, mul_inv_rev]
  have hmult (r : ℝ) :
      (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          ψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) =
      fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ := by
    funext ξ
    rw [hψ (((2 : ℝ) ^ j)⁻¹ • (r • ξ))]
    simp only [zero_add, pow_one, pow_zero, inv_one, one_smul]
    have hfirst : (2 : ℝ)⁻¹ • (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) =
        ((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ) := by
      rw [smul_smul, hscalar]
    rw [hfirst]
  have hsup :
      (fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            ψ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ)) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) =
      fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ := by
    funext x
    apply iSup_congr
    intro r
    rw [hmult r.1]
  rw [← hsup]
  exact hcap j f hj hab ha hb hs hsmall hwidth hfsupp

/-- The short-interval cap endpoint transferred to a weighted output shell
and an exterior input annulus.  The maximal function is kept in its
continuum-radius form; no sampling of the interval is used. -/
theorem exists_restrictedRelativeBandpass_interval_cap_shell_lintegral_one_le
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      (E : Set ℝ) {u v s a b α : ℝ}, 4 ≤ j → E.Nonempty → E ⊆ Icc u v →
      u ≤ v → 1 ≤ u → v ≤ 2 → 0 < s → 4 * s ≤ u →
      v - u ≤ ((2 : ℝ) ^ j)⁻¹ → α ≤ 0 → 0 < a → a ≤ b → s < a →
      (∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) →
      (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
        ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
          ∂powerWeightedVolume (n + 1) α) ≤
        (ENNReal.ofReal (s / 4)) ^ α * relativeIntervalBandCapTail n j C u v s *
          ((ENNReal.ofReal b) ^ α)⁻¹ *
            ∫⁻ y, ENNReal.ofReal ‖f y‖ ∂powerWeightedVolume (n + 1) α := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_moving_band_cap_lintegral_one_le n phi
      hphi_one hphi_zero hphi_norm
  refine ⟨C, hC, ?_⟩
  intro j f E u v s a b α hj hEne hE huv hu hv hs hsmall hwidth hα ha hab hsa hfsupport
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let Q : Euclidean (n + 1) → ENNReal := fun x =>
    ⨆ r : Icc u v, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r.1 • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖
  let I : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂volume
  let J : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂ν
  have hs4 : 0 < s / 4 := by positivity
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hMtoReal : Measurable (fun x : Euclidean (n + 1) => (M x).toReal) := by
    have hEunit : E ⊆ Icc (1 : ℝ) 2 := by
      intro r hr
      exact ⟨hu.trans (hE hr).1, (hE hr).2.trans hv⟩
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hEunit hEne
  have hA_subset : A ⊆ ball (0 : Euclidean (n + 1)) s := by
    intro x hx
    have hxnorm : ‖x‖ ≤ s / 2 := by
      have hxclosed := hx.1
      rw [Metric.mem_closedBall, dist_zero_right] at hxclosed
      exact hxclosed
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_of_le_of_lt hxnorm (by linarith)
  have hcap_support : ∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0 := by
    intro y hy
    apply hfsupport y
    intro hyB
    have hynorm : a ≤ ‖y‖ := by
      have hynotball := hyB.2
      rw [Metric.mem_ball, dist_zero_right] at hynotball
      exact le_of_not_gt hynotball
    exact hy (lt_of_lt_of_le hsa hynorm)
  have hQcap : (∫⁻ x in ball (0 : Euclidean (n + 1)) s, Q x) ≤
      relativeIntervalBandCapTail n j C u v s * I := by
    dsimp only [Q, I, relativeIntervalBandCapTail]
    exact hcap j f hj huv hu hv hs hsmall hwidth hcap_support
  have hM_le_Q (x : Euclidean (n + 1)) : M x ≤ Q x := by
    dsimp only [M, Q, restrictedRelativeBandpassSphericalMaximal]
    apply iSup_le
    intro r
    exact le_iSup (fun t : Icc u v => ENNReal.ofReal ‖𝓕⁻
      (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-t.1 • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (t.1 • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (t.1 • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖)
      ⟨r.1, hE r.2.1⟩
  have hunweighted :
      (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) ≤
        relativeIntervalBandCapTail n j C u v s * I := by
    calc
      (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) =
          ∫⁻ x : Euclidean (n + 1),
            A.indicator (fun z => ENNReal.ofReal ((M z).toReal)) x ∂volume :=
        (lintegral_indicator hA _).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1), A.indicator M x ∂volume := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ A
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
          exact ENNReal.ofReal_toReal_le
        · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
      _ = ∫⁻ x in A, M x ∂volume :=
        lintegral_indicator hA M
      _ = ∫⁻ x : Euclidean (n + 1), A.indicator M x ∂volume :=
        (lintegral_indicator hA M).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1),
          (ball (0 : Euclidean (n + 1)) s).indicator Q x ∂volume := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ A
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hA_subset hx)]
          exact hM_le_Q x
        · rw [Set.indicator_of_notMem hx]
          exact bot_le
      _ = ∫⁻ x in ball (0 : Euclidean (n + 1)) s, Q x :=
        lintegral_indicator measurableSet_ball Q
      _ ≤ relativeIntervalBandCapTail n j C u v s * I := hQcap
  have hGmeas : Measurable (fun y : Euclidean (n + 1) => ENNReal.ofReal ‖f y‖) :=
    f.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ y : Euclidean (n + 1), y ∉ B → ENNReal.ofReal ‖f y‖ = 0 := by
    intro y hy
    simp [hfsupport y hy]
  have hinput : I ≤ ((ENNReal.ofReal b) ^ α)⁻¹ * J := by
    dsimp only [I, J, ν, B]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα ha hab _ hGmeas hGsupport
  calc
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
        ∂powerWeightedVolume (n + 1) α) =
        ∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂ν := by rfl
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) := by
      exact setLIntegral_powerWeightedVolume_euclideanAnnulus_le hα hs4 _
        hMtoReal.ennreal_ofReal
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        (relativeIntervalBandCapTail n j C u v s * I) :=
      mul_le_mul_right hunweighted _
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        (relativeIntervalBandCapTail n j C u v s *
          (((ENNReal.ofReal b) ^ α)⁻¹ * J)) := by
      exact mul_le_mul_right (mul_le_mul_right hinput
        (relativeIntervalBandCapTail n j C u v s)) _
    _ = (ENNReal.ofReal (s / 4)) ^ α * relativeIntervalBandCapTail n j C u v s *
          ((ENNReal.ofReal b) ^ α)⁻¹ * J := by ring
    _ = (ENNReal.ofReal (s / 4)) ^ α * relativeIntervalBandCapTail n j C u v s *
          ((ENNReal.ofReal b) ^ α)⁻¹ *
            ∫⁻ y, ENNReal.ofReal ‖f y‖ ∂powerWeightedVolume (n + 1) α := by
      rfl

/-- Measurability of the literal continuum maximum on one compact radius
interval.  This is the unsquared version needed to sum the interval cap
endpoints before interpolation. -/
theorem measurable_iSup_ennreal_norm_literal_relative_dyadic_moving_bandpass_interval
    {n : Nat} (phi f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) (j : Nat)
    {a b : ℝ} (_hab : a ≤ b) (ha : 1 ≤ a) (hb : b ≤ 2) :
    Measurable (fun x : Euclidean (n + 1) =>
      ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r.1 • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) := by
  obtain ⟨theta, htheta_compact, htheta_norm, htheta_active⟩ :=
    exists_compact_cutoff_one_on_relative_dyadic_bandpass
      phi hphi_one hphi_zero hphi_norm j
  let F : ℝ → Euclidean (n + 1) → ℂ := fun r x =>
    𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x
  let Ftheta : ℝ → Euclidean (n + 1) → ℂ := fun r x =>
    𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) * theta ξ *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x
  have hFtheta_eq (r : ℝ) (hr : r ∈ Icc a b) : Ftheta r = F r := by
    funext x
    apply congrArg (fun h : Euclidean (n + 1) → ℂ => 𝓕⁻ h x)
    funext ξ
    have hr' : r ∈ Icc (1 : ℝ) 2 := ⟨ha.trans hr.1, hr.2.trans hb⟩
    calc
      surfaceFourier (n + 1) (-r • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) * theta ξ *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ =
          surfaceFourier (n + 1) (-r • ξ) *
            ((phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) * theta ξ) *
                𝓕 (f : Euclidean (n + 1) → ℂ) ξ := by ring
      _ = surfaceFourier (n + 1) (-r • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ := by
          rw [htheta_active r hr' ξ]
  have hjoint := continuous_and_hasDerivAt_fourierInv_relative_dyadic_bandpass
    phi theta f htheta_compact j
  dsimp only at hjoint
  have hcont : Continuous (Function.uncurry Ftheta) := by
    simpa only [Ftheta] using hjoint.1
  have hmeas0 : Measurable (⨆ r : Icc a b,
      fun x : Euclidean (n + 1) => ENNReal.ofReal ‖Ftheta r.1 x‖) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro r
      exact (ENNReal.continuous_ofReal.comp
        ((hcont.comp (continuous_const.prodMk continuous_id)).norm)).measurable
    · intro x
      exact (ENNReal.continuous_ofReal.comp
        ((hcont.comp (continuous_subtype_val.prodMk continuous_const)).norm)).lowerSemicontinuous
  have hmeas : Measurable (fun x : Euclidean (n + 1) =>
      ⨆ r : Icc a b, ENNReal.ofReal ‖Ftheta r.1 x‖) := by
    rw [show (fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖Ftheta r.1 x‖) =
        ⨆ r : Icc a b, fun x : Euclidean (n + 1) =>
          ENNReal.ofReal ‖Ftheta r.1 x‖ by
      funext x
      exact (iSup_apply
        (f := fun r : Icc a b => fun x : Euclidean (n + 1) =>
          ENNReal.ofReal ‖Ftheta r.1 x‖)
        (a := x)).symm]
    exact hmeas0
  have heq :
      (fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖) =
      fun x : Euclidean (n + 1) =>
        ⨆ r : Icc a b, ENNReal.ofReal ‖Ftheta r.1 x‖ := by
    funext x
    apply iSup_congr
    intro r
    rw [hFtheta_eq r.1 r.2]
  rw [show (fun x : Euclidean (n + 1) =>
      ⨆ r : Icc a b, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r.1 • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖) =
        fun x : Euclidean (n + 1) =>
          ⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖ by rfl,
    heq]
  exact hmeas

/-- Reassemble the continuum interval cap endpoint over a finite interval
cover of the radius set.  This is the `L¹` side of the entropy-cover
interpolation argument. -/
theorem exists_restrictedRelativeBandpass_intervalCover_cap_shell_lintegral_one_le
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      (E : Set ℝ) (T : Finset (ℝ × ℝ)) {s a b α : ℝ}, 4 ≤ j → E.Nonempty →
      E ⊆ Icc (1 : ℝ) 2 → (∀ q ∈ T, q.1 ≤ q.2) →
      (∀ q ∈ T, q.1 ∈ Icc (1 : ℝ) 2 ∧ q.2 ∈ Icc (1 : ℝ) 2) →
      (∀ q ∈ T, q.2 - q.1 ≤ ((2 : ℝ) ^ j)⁻¹) →
      E ⊆ ⋃ q ∈ T, Icc q.1 q.2 → 0 < s →
      (∀ q ∈ T, 4 * s ≤ q.1) → α ≤ 0 → 0 < a → a ≤ b → s < a →
      (∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) →
      (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
        ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
          ∂powerWeightedVolume (n + 1) α) ≤
        (ENNReal.ofReal (s / 4)) ^ α *
          (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) *
            ((ENNReal.ofReal b) ^ α)⁻¹ *
              ∫⁻ y, ENNReal.ofReal ‖f y‖ ∂powerWeightedVolume (n + 1) α := by
  classical
  obtain ⟨C, hC, hcap⟩ :=
    exists_interval_literal_moving_band_cap_lintegral_one_le n phi
      hphi_one hphi_zero hphi_norm
  refine ⟨C, hC, ?_⟩
  intro j f E T s a b α hj hEne hE hordered hends hlength hcover hs hsmall hα ha hab hsa
    hfsupport
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let Q : ℝ × ℝ → Euclidean (n + 1) → ENNReal := fun q x =>
    ⨆ r : Icc q.1 q.2, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r.1 • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖
  let I : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂volume
  let J : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂ν
  have hs4 : 0 < s / 4 := by positivity
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hA_subset : A ⊆ ball (0 : Euclidean (n + 1)) s := by
    intro x hx
    have hxnorm : ‖x‖ ≤ s / 2 := by
      have hxclosed := hx.1
      rw [Metric.mem_closedBall, dist_zero_right] at hxclosed
      exact hxclosed
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_of_le_of_lt hxnorm (by linarith)
  have hMtoReal : Measurable (fun x : Euclidean (n + 1) => (M x).toReal) := by
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hE hEne
  have hQmeas (q : ℝ × ℝ) (hq : q ∈ T) : Measurable (Q q) := by
    dsimp only [Q]
    exact measurable_iSup_ennreal_norm_literal_relative_dyadic_moving_bandpass_interval
      phi f hphi_one hphi_zero hphi_norm j (hordered q hq)
        (hends q hq).1.1 (hends q hq).2.2
  have hcap_support : ∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0 := by
    intro y hy
    apply hfsupport y
    intro hyB
    have hynorm : a ≤ ‖y‖ := by
      have hynotball := hyB.2
      rw [Metric.mem_ball, dist_zero_right] at hynotball
      exact le_of_not_gt hynotball
    exact hy (lt_of_lt_of_le hsa hynorm)
  have hQcap (q : ℝ × ℝ) (hq : q ∈ T) :
      (∫⁻ x in ball (0 : Euclidean (n + 1)) s, Q q x) ≤
        relativeIntervalBandCapTail n j C q.1 q.2 s * I := by
    dsimp only [Q, I, relativeIntervalBandCapTail]
    exact hcap j f hj (hordered q hq) (hends q hq).1.1 (hends q hq).2.2 hs
      (hsmall q hq) (hlength q hq) hcap_support
  have hMsum (x : Euclidean (n + 1)) : M x ≤ ∑ q ∈ T, Q q x := by
    dsimp only [M, restrictedRelativeBandpassSphericalMaximal]
    apply iSup_le
    intro r
    rcases Set.mem_iUnion.mp (hcover r.2.1) with ⟨q, hq⟩
    rcases Set.mem_iUnion.mp hq with ⟨hqT, hrq⟩
    calc
      ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • ξ) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
                𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖ ≤ Q q x :=
        le_iSup (fun t : Icc q.1 q.2 => ENNReal.ofReal ‖𝓕⁻
          (fun ξ : Euclidean (n + 1) =>
            surfaceFourier (n + 1) (-t.1 • ξ) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (t.1 • ξ)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (t.1 • ξ))) *
                  𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖)
          ⟨r.1, hrq⟩
      _ ≤ ∑ q ∈ T, Q q x :=
        Finset.single_le_sum (s := T) (f := fun z => Q z x)
          (fun _ _ => bot_le) hqT
  have hsum_meas : Measurable (fun x : Euclidean (n + 1) => ∑ q ∈ T, Q q x) :=
    Finset.measurable_fun_sum T (fun q hq => hQmeas q hq)
  have hsum_mass :
      (∫⁻ x in A, ∑ q ∈ T, Q q x ∂volume) ≤
        (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) * I := by
    calc
      (∫⁻ x in A, ∑ q ∈ T, Q q x ∂volume) =
          ∫⁻ x : Euclidean (n + 1), A.indicator (fun z => ∑ q ∈ T, Q q z) x ∂volume :=
        (lintegral_indicator hA _).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1),
          (ball (0 : Euclidean (n + 1)) s).indicator
            (fun z => ∑ q ∈ T, Q q z) x ∂volume := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ A
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hA_subset hx)]
        · rw [Set.indicator_of_notMem hx]
          exact bot_le
      _ = ∫⁻ x in ball (0 : Euclidean (n + 1)) s, ∑ q ∈ T, Q q x ∂volume :=
        lintegral_indicator measurableSet_ball _
      _ = ∑ q ∈ T, ∫⁻ x in ball (0 : Euclidean (n + 1)) s, Q q x ∂volume := by
        rw [lintegral_finsetSum _ (fun q hq => hQmeas q hq)]
      _ ≤ ∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s * I := by
        apply Finset.sum_le_sum
        intro q hq
        exact hQcap q hq
      _ = (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) * I := by
        rw [Finset.sum_mul]
  have hunweighted :
      (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) ≤
        (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) * I := by
    calc
      (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) =
          ∫⁻ x : Euclidean (n + 1),
            A.indicator (fun z => ENNReal.ofReal ((M z).toReal)) x ∂volume :=
        (lintegral_indicator hA _).symm
      _ ≤ ∫⁻ x : Euclidean (n + 1),
          A.indicator (fun z => ∑ q ∈ T, Q q z) x ∂volume := by
        apply lintegral_mono
        intro x
        by_cases hx : x ∈ A
        · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx]
          exact ENNReal.ofReal_toReal_le.trans (hMsum x)
        · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx]
      _ = ∫⁻ x in A, ∑ q ∈ T, Q q x ∂volume :=
        lintegral_indicator hA _
      _ ≤ (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) * I := hsum_mass
  have hGmeas : Measurable (fun y : Euclidean (n + 1) => ENNReal.ofReal ‖f y‖) :=
    f.continuous.norm.measurable.ennreal_ofReal
  have hGsupport : ∀ y : Euclidean (n + 1), y ∉ B → ENNReal.ofReal ‖f y‖ = 0 := by
    intro y hy
    simp [hfsupport y hy]
  have hinput : I ≤ ((ENNReal.ofReal b) ^ α)⁻¹ * J := by
    dsimp only [I, J, ν, B]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα ha hab _ hGmeas hGsupport
  calc
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
        ∂powerWeightedVolume (n + 1) α) =
        ∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂ν := by rfl
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        (∫⁻ x in A, ENNReal.ofReal ((M x).toReal) ∂volume) := by
      exact setLIntegral_powerWeightedVolume_euclideanAnnulus_le hα hs4 _
        hMtoReal.ennreal_ofReal
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        ((∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) * I) :=
      mul_le_mul_right hunweighted _
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        ((∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) *
          (((ENNReal.ofReal b) ^ α)⁻¹ * J)) := by
      exact mul_le_mul_right (mul_le_mul_right hinput
        (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s)) _
    _ = (ENNReal.ofReal (s / 4)) ^ α *
          (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) *
            ((ENNReal.ofReal b) ^ α)⁻¹ * J := by ring
    _ = (ENNReal.ofReal (s / 4)) ^ α *
          (∑ q ∈ T, relativeIntervalBandCapTail n j C q.1 q.2 s) *
            ((ENNReal.ofReal b) ^ α)⁻¹ *
              ∫⁻ y, ENNReal.ofReal ‖f y‖ ∂powerWeightedVolume (n + 1) α := by
      rfl

/-- Transfer a global unweighted square estimate for a continuum restricted
moving band to the cap output shell.  This is the `p = 2` endpoint paired
with the interval-cover `L¹` estimate above. -/
theorem restrictedRelativeBandpass_cap_shell_lintegral_two_le_of_global
    (n j : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (L : ENNReal)
    (hglobal : ∀ g : SchwartzMap (Euclidean (n + 1)) ℂ,
      (∫⁻ x : Euclidean (n + 1), ENNReal.ofReal
        ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
          (2 : ℕ)) ∂volume) ≤
        L * ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume)
    {s a b α : ℝ} (hs : 0 < s) (hα : α ≤ 0) (ha : 0 < a) (hab : a ≤ b)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hfsupport : ∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) :
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^
        (2 : ℕ)) ∂powerWeightedVolume (n + 1) α) ≤
      (ENNReal.ofReal (s / 4)) ^ α * L * ((ENNReal.ofReal b) ^ α)⁻¹ *
        ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))
          ∂powerWeightedVolume (n + 1) α := by
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let G : Euclidean (n + 1) → ENNReal := fun x => ENNReal.ofReal ((M x).toReal ^
    (2 : ℕ))
  let I : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) ∂volume
  let J : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) ∂ν
  have hs4 : 0 < s / 4 := by positivity
  have hMreal : Measurable (fun x : Euclidean (n + 1) => (M x).toReal) := by
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hE hEne
  have hGmeas : Measurable G := (hMreal.pow_const 2).ennreal_ofReal
  have hunweighted : (∫⁻ x in A, G x ∂volume) ≤ L * I := by
    calc
      (∫⁻ x in A, G x ∂volume) ≤ ∫⁻ x : Euclidean (n + 1), G x ∂volume :=
        lintegral_mono' Measure.restrict_le_self le_rfl
      _ ≤ L * I := by
        simpa only [G, M, I] using hglobal f
  have hGinput_meas : Measurable (fun y : Euclidean (n + 1) =>
      ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))) :=
    (f.continuous.norm.pow 2).measurable.ennreal_ofReal
  have hGinput_support : ∀ y : Euclidean (n + 1), y ∉ B →
      ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) = 0 := by
    intro y hy
    simp [hfsupport y hy]
  have hinput : I ≤ ((ENNReal.ofReal b) ^ α)⁻¹ * J := by
    dsimp only [I, J, ν, B]
    exact lintegral_volume_le_outerPower_inv_mul_powerWeightedVolume_of_annular_support
      hα ha hab _ hGinput_meas hGinput_support
  calc
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^
        (2 : ℕ)) ∂powerWeightedVolume (n + 1) α) =
        ∫⁻ x in A, G x ∂ν := by rfl
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α * (∫⁻ x in A, G x ∂volume) := by
      exact setLIntegral_powerWeightedVolume_euclideanAnnulus_le hα hs4 G hGmeas
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α * (L * I) :=
      mul_le_mul_right hunweighted _
    _ ≤ (ENNReal.ofReal (s / 4)) ^ α *
        (L * (((ENNReal.ofReal b) ^ α)⁻¹ * J)) := by
      exact mul_le_mul_right (mul_le_mul_right hinput L) _
    _ = (ENNReal.ofReal (s / 4)) ^ α * L * ((ENNReal.ofReal b) ^ α)⁻¹ * J := by
      ring
    _ = (ENNReal.ofReal (s / 4)) ^ α * L * ((ENNReal.ofReal b) ^ α)⁻¹ *
        ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))
          ∂powerWeightedVolume (n + 1) α := by rfl

set_option maxHeartbeats 800000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- Cap-aware `L¹`--`L²` interpolation for a continuum radius set covered by
short intervals.  The `L¹` coefficient is the sum of the interval cap tails;
the `L²` coefficient is supplied globally, so this theorem can be connected
directly to the entropy square estimate. -/
theorem exists_restrictedRelBp_intervalCover_cap_shell_lintegral_rpow_le_of_global
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      (E : Set ℝ) (R : Finset (ℝ × ℝ)) (L : ENNReal) {s a b α p τ : ℝ},
      4 ≤ j → E.Nonempty → E ⊆ Icc (1 : ℝ) 2 →
      (∀ q ∈ R, q.1 ≤ q.2) →
      (∀ q ∈ R, q.1 ∈ Icc (1 : ℝ) 2 ∧ q.2 ∈ Icc (1 : ℝ) 2) →
      (∀ q ∈ R, q.2 - q.1 ≤ ((2 : ℝ) ^ j)⁻¹) →
      E ⊆ ⋃ q ∈ R, Icc q.1 q.2 → 0 < s →
      (∀ q ∈ R, 4 * s ≤ q.1) → α ≤ 0 → 0 < a → a ≤ b → s < a →
      1 < p → p < 2 → 0 < τ →
      (∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) →
      (∀ g : SchwartzMap (Euclidean (n + 1)) ℂ,
        (∫⁻ x : Euclidean (n + 1), ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
            (2 : ℕ)) ∂volume) ≤
          L * ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume) →
      let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
      let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
      let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
      let μ : Measure (Euclidean (n + 1)) := ν.restrict A + ν.restrict B
      let Op : SchwartzMap (Euclidean (n + 1)) ℂ → Euclidean (n + 1) → ℝ :=
        fun g => A.indicator (fun x =>
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)
      let c1 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α *
        (∑ q ∈ R, relativeIntervalBandCapTail n j C q.1 q.2 s) *
          ((ENNReal.ofReal b) ^ α)⁻¹
      let c2 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α * L *
        ((ENNReal.ofReal b) ^ α)⁻¹
      let a2 : ENNReal :=
        (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (2 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
      let a1 : ENNReal :=
        ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
      (∫⁻ x, ENNReal.ofReal ((Op f x) ^ p) ∂μ) ≤
        ENNReal.ofReal p *
          (4 * c2 * ((ENNReal.ofReal τ) ^ (2 - p) * a2) +
            2 * c1 * ((ENNReal.ofReal τ) ^ (1 - p) * a1)) := by
  classical
  obtain ⟨C, hC, hcap⟩ :=
    exists_restrictedRelativeBandpass_intervalCover_cap_shell_lintegral_one_le
      n phi hphi_one hphi_zero hphi_norm
  refine ⟨C, hC, ?_⟩
  intro j f E R L s a b α p τ hj hEne hE hordered hends hlength hcover hs hsmall hα ha hab hsa
    hp1 hp2 hτ hfsupport hglobal
  dsimp only
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let μ : Measure (Euclidean (n + 1)) := ν.restrict A + ν.restrict B
  let Op : SchwartzMap (Euclidean (n + 1)) ℂ → Euclidean (n + 1) → ℝ :=
    fun g => A.indicator (fun x =>
      (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)
  let c1 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α *
    (∑ q ∈ R, relativeIntervalBandCapTail n j C q.1 q.2 s) *
      ((ENNReal.ofReal b) ^ α)⁻¹
  let c2 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α * L *
    ((ENNReal.ofReal b) ^ α)⁻¹
  let a2 : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
      ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let a1 : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
      ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let Sset : Set (SchwartzMap (Euclidean (n + 1)) ℂ) :=
    {g | ∀ x, x ∉ B → g x = 0}
  have hs4 : 0 < s / 4 := by positivity
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hB : MeasurableSet B := measurableSet_closedBall.diff measurableSet_ball
  have hAB : Disjoint A B := by
    rw [Set.disjoint_left]
    intro x hxA hxB
    have hxAouter : ‖x‖ ≤ s / 2 := by
      have hxclosed := hxA.1
      rw [Metric.mem_closedBall, dist_zero_right] at hxclosed
      exact hxclosed
    have hxBinner : a ≤ ‖x‖ := by
      have hxnotball := hxB.2
      rw [Metric.mem_ball, dist_zero_right] at hxnotball
      exact le_of_not_gt hxnotball
    linarith
  letI : IsFiniteMeasure μ :=
    ⟨by
      dsimp only [μ]
      rw [Measure.add_apply, Measure.restrict_apply_univ, Measure.restrict_apply_univ]
      exact ENNReal.add_lt_top.mpr ⟨
        powerWeightedVolume_euclideanAnnulus_lt_top_any (d := n + 1) (α := α) hs4,
        powerWeightedVolume_euclideanAnnulus_lt_top_any (d := n + 1) (α := α) ha⟩⟩
  have hOp_nonneg : ∀ g x, 0 ≤ Op g x := by
    intro g x
    by_cases hx : x ∈ A
    · simp [Op, hx, ENNReal.toReal_nonneg]
    · simp [Op, hx]
  have hOp_subadd : ∀ ⦃g h : SchwartzMap (Euclidean (n + 1)) ℂ⦄,
      g ∈ Sset → h ∈ Sset → ∀ x, Op (g + h) x ≤ Op g x + Op h x := by
    intro g h _ _ x
    by_cases hx : x ∈ A
    · simp only [Op, Set.indicator_of_mem hx]
      exact toReal_restrictedRelativeBandpassSphericalMaximal_add_le
        (Nat.succ_pos n) E hE phi g h j x
    · simp [Op, hx]
  have hOpmeas : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ), g ∈ Sset →
      AEMeasurable (Op g) μ := by
    intro g _
    exact ((measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi g hphi_one hphi_zero hphi_norm j E hE hEne).indicator hA).aemeasurable
  have hstrong_one : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ), g ∈ Sset →
      (∫⁻ x, ENNReal.ofReal (Op g x) ∂μ) ≤
        c1 * ∫⁻ x, ENNReal.ofReal ‖(g : Euclidean (n + 1) → ℂ) x‖ ∂μ := by
    intro g hg
    have hTout : ∀ x : Euclidean (n + 1), x ∉ A → ENNReal.ofReal (Op g x) = 0 := by
      intro x hx
      simp [Op, hx]
    have hTin : ∀ x : Euclidean (n + 1), x ∉ B →
        ENNReal.ofReal ‖(g : Euclidean (n + 1) → ℂ) x‖ = 0 := by
      intro x hx
      simp [hg x hx]
    have hout_eq := lintegral_add_restrict_eq_lintegral_of_support_left_interval
      hA hB hAB (fun x : Euclidean (n + 1) => ENNReal.ofReal (Op g x)) hTout (ν := ν)
    have hin_eq := lintegral_add_restrict_eq_lintegral_of_support_right_interval
      hA hB hAB (fun x : Euclidean (n + 1) =>
        ENNReal.ofReal ‖(g : Euclidean (n + 1) → ℂ) x‖) hTin (ν := ν)
    have hcapg := hcap j g E R hj hEne hE hordered hends hlength hcover hs hsmall hα ha hab hsa hg
    calc
      (∫⁻ x, ENNReal.ofReal (Op g x) ∂μ) =
          ∫⁻ x, ENNReal.ofReal (Op g x) ∂ν := hout_eq
      _ = ∫⁻ x in A, ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)
            ∂ν := by
        rw [show (fun x : Euclidean (n + 1) => ENNReal.ofReal (Op g x)) =
          A.indicator (fun x => ENNReal.ofReal
            ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)) by
          funext x
          by_cases hx : x ∈ A <;> simp [Op, hx],
          lintegral_indicator hA]
      _ ≤ c1 * ∫⁻ x, ENNReal.ofReal ‖(g : Euclidean (n + 1) → ℂ) x‖ ∂ν := by
        simpa only [A, ν, c1] using hcapg
      _ = c1 * ∫⁻ x, ENNReal.ofReal ‖(g : Euclidean (n + 1) → ℂ) x‖ ∂μ := by
        rw [hin_eq]
  have hstrong_two : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ), g ∈ Sset →
      (∫⁻ x, ENNReal.ofReal ((Op g x) ^ (2 : ℕ)) ∂μ) ≤
        c2 * ∫⁻ x, ENNReal.ofReal (‖(g : Euclidean (n + 1) → ℂ) x‖ ^ (2 : ℕ)) ∂μ := by
    intro g hg
    have hTout : ∀ x : Euclidean (n + 1), x ∉ A →
        ENNReal.ofReal ((Op g x) ^ (2 : ℕ)) = 0 := by
      intro x hx
      simp [Op, hx]
    have hTin : ∀ x : Euclidean (n + 1), x ∉ B →
        ENNReal.ofReal (‖(g : Euclidean (n + 1) → ℂ) x‖ ^ (2 : ℕ)) = 0 := by
      intro x hx
      simp [hg x hx]
    have hout_eq := lintegral_add_restrict_eq_lintegral_of_support_left_interval
      hA hB hAB (fun x : Euclidean (n + 1) => ENNReal.ofReal ((Op g x) ^ (2 : ℕ)))
        hTout (ν := ν)
    have hin_eq := lintegral_add_restrict_eq_lintegral_of_support_right_interval
      hA hB hAB (fun x : Euclidean (n + 1) =>
        ENNReal.ofReal (‖(g : Euclidean (n + 1) → ℂ) x‖ ^ (2 : ℕ))) hTin (ν := ν)
    have hL2g := restrictedRelativeBandpass_cap_shell_lintegral_two_le_of_global
      n j phi hphi_one hphi_zero hphi_norm E hE hEne L hglobal hs hα ha hab g hg
    calc
      (∫⁻ x, ENNReal.ofReal ((Op g x) ^ (2 : ℕ)) ∂μ) =
          ∫⁻ x, ENNReal.ofReal ((Op g x) ^ (2 : ℕ)) ∂ν := hout_eq
      _ = ∫⁻ x in A, ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
            (2 : ℕ)) ∂ν := by
        rw [show (fun x : Euclidean (n + 1) => ENNReal.ofReal ((Op g x) ^ (2 : ℕ))) =
          A.indicator (fun x => ENNReal.ofReal
            ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
              (2 : ℕ))) by
          funext x
          by_cases hx : x ∈ A <;> simp [Op, hx],
          lintegral_indicator hA]
      _ ≤ c2 * ∫⁻ x, ENNReal.ofReal
          (‖(g : Euclidean (n + 1) → ℂ) x‖ ^ (2 : ℕ)) ∂ν := by
        simpa only [A, ν, c2] using hL2g
      _ = c2 * ∫⁻ x, ENNReal.ofReal
          (‖(g : Euclidean (n + 1) → ℂ) x‖ ^ (2 : ℕ)) ∂μ := by
        rw [hin_eq]
  have hf_mem : f ∈ Sset := hfsupport
  have hOpf : AEMeasurable (Op f) μ := hOpmeas f hf_mem
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hlow_zero (t : ℝ) (x : Euclidean (n + 1)) (hx : x ∉ B) : low t x = 0 := by
    rw [hlow t x, hfsupport x hx]
    simp
  have hlow_mem : ∀ t, low t ∈ Sset := by
    intro t x hx
    exact hlow_zero t x hx
  have hhigh_mem : ∀ t, high t ∈ Sset := by
    intro t x hx
    rw [hhigh t]
    simp only [sub_apply, hfsupport x hx, hlow_zero t x hx, sub_zero]
  have hsplit' : ∀ t, f = low t + high t := by
    intro t
    ext x
    exact hsplit t x
  have hprofiles := measurable_rational_low_high_profile_lintegrals
    f low high hlow hhigh (μ := μ)
  have hlow_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) ≤ a2 := by
    dsimp only [a2]
    apply weighted_low_tail_le_of_two_region_bounds
      (u := fun x : Euclidean (n + 1) => ‖f x‖)
      (low := fun t x => low t x)
    · exact f.continuous.norm.measurable
    · intro x
      exact norm_nonneg _
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).1
      simpa [htx] using h
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).1
      have hnot : ¬ t ≤ ‖f x‖ := not_le_of_gt htx
      simpa [hnot] using h
    · exact hp1
    · exact hp2
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high t x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) ≤ a1 := by
    dsimp only [a1]
    apply rational_high_weighted_tail_le
      (u := fun x : Euclidean (n + 1) => ‖f x‖)
      (high := fun t x => high t x)
    · exact f.continuous.norm.measurable
    · intro x
      exact norm_nonneg _
    · have heq : (fun q : ℝ × Euclidean (n + 1) => ENNReal.ofReal ‖high q.1 q.2‖) =
          (fun q : ℝ × Euclidean (n + 1) => ENNReal.ofReal
            ‖f q.2 - ((1 + ‖(q.1⁻¹ : ℝ) • f q.2‖ ^ 2) ^ (-1 : ℝ)) • f q.2‖) := by
        funext q
        rw [hhigh q.1]
        simp only [sub_apply]
        rw [hlow q.1 q.2]
      rw [heq]
      exact (measurable_rational_high_family f).norm.ennreal_ofReal
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).2
      simpa [htx] using h
    · intro t x ht htx
      apply ENNReal.ofReal_le_ofReal
      have h := (rational_low_high_pointwise_tail_bounds f (low t) (high t)
        ht (hlow t) (hhigh t) x).2
      have hnot : ¬ t ≤ ‖f x‖ := not_le_of_gt htx
      simpa [hnot] using h
    · exact hp1
    · exact hp2
  have hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low (τ * t) x‖ ^ (2 : ℕ)) ∂μ) :=
    hprofiles.1.comp (measurable_const_mul τ)
  have hhighI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal ‖high (τ * t) x‖ ∂μ) :=
    hprofiles.2.comp (measurable_const_mul τ)
  have hlow_tail_scaled :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low (τ * t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) ≤
        (ENNReal.ofReal τ) ^ (2 - p) * a2 := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖low (τ * t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (p - 3)) =
          (ENNReal.ofReal τ) ^ (2 - p) *
            (∫⁻ u in Ioi (0 : ℝ),
              (∫⁻ x, ENNReal.ofReal (‖low u x‖ ^ (2 : ℕ)) ∂μ) *
                (ENNReal.ofReal u) ^ (p - 3)) :=
        lintegral_Ioi_comp_mul_low_weight
          (fun u => ∫⁻ x, ENNReal.ofReal (‖low u x‖ ^ (2 : ℕ)) ∂μ)
          hprofiles.1 τ hτ p
      _ ≤ (ENNReal.ofReal τ) ^ (2 - p) * a2 :=
        mul_le_mul_right hlow_tail _
  have hhigh_tail_scaled :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high (τ * t) x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) ≤
        (ENNReal.ofReal τ) ^ (1 - p) * a1 := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal ‖high (τ * t) x‖ ∂μ) *
          (ENNReal.ofReal t) ^ (p - 2)) =
          (ENNReal.ofReal τ) ^ (1 - p) *
            (∫⁻ u in Ioi (0 : ℝ),
              (∫⁻ x, ENNReal.ofReal ‖high u x‖ ∂μ) *
                (ENNReal.ofReal u) ^ (p - 2)) :=
        lintegral_Ioi_comp_mul_high_weight
          (fun u => ∫⁻ x, ENNReal.ofReal ‖high u x‖ ∂μ)
          hprofiles.2 τ hτ p
      _ ≤ (ENNReal.ofReal τ) ^ (1 - p) * a1 :=
        mul_le_mul_right hhigh_tail _
  exact marcinkiewicz_one_two_on_additive_split
    (α := Euclidean (n + 1)) (E := ℂ)
    (F := SchwartzMap (Euclidean (n + 1)) ℂ) (μ := μ)
    Sset (fun g => (g : Euclidean (n + 1) → ℂ)) Op hOp_nonneg hOp_subadd hOpmeas
    c1 c2 hstrong_one hstrong_two hp1 hp2 f hOpf
    (fun t => low (τ * t)) (fun t => high (τ * t))
    (fun t => hlow_mem (τ * t)) (fun t => hhigh_mem (τ * t))
    (fun t => hsplit' (τ * t)) hlowI_meas hhighI_meas
    ((ENNReal.ofReal τ) ^ (2 - p) * a2)
    ((ENNReal.ofReal τ) ^ (1 - p) * a1)
    hlow_tail_scaled hhigh_tail_scaled

/-- The entropy-cover square estimate in the exact continuum restricted
operator convention. -/
theorem restrictedRelativeBandpass_lintegral_two_le_of_entropy
    {n : Nat} (hn : 1 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ u : ℝ, 1 ≤ ‖xi‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun z : ℝ => surfaceFourier (n + 1) (z • xi)) u‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (δ : NNReal) (N : ℕ) (hN : multiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (g : SchwartzMap (Euclidean (n + 1)) ℂ) :
    (∫⁻ x : Euclidean (n + 1), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
        (2 : ℕ)) ∂volume) ≤
      (N : ENNReal) * ENNReal.ofReal
        (2 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)) ^
            (2 : ℕ) +
          2 * (8 * Real.log 2 * (δ : ℝ)) ^ (2 : ℕ) *
            (2 * ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2 - 1)
                +
              (12 * C0 *
                ‖((SchwartzMap.fderivCLM ℂ (Euclidean (n + 1)) ℂ) phi).toBoundedContinuousFunction‖)
                    /
                (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))) ^ (2 : ℕ)) *
        ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume := by
  classical
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g
  let Q : Euclidean (n + 1) → ENNReal := fun x =>
    ⨆ r : ↥(E ∩ Ioi (0 : ℝ)), ENNReal.ofReal
      (‖𝓕⁻ (fun xi : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (g : Euclidean (n + 1) → ℂ) xi) x‖ ^ (2 : ℕ))
  let B : ℝ := (4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)
  let D : ℝ := 2 *
    ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2 - 1) +
      (12 * C0 *
        ‖((SchwartzMap.fderivCLM ℂ (Euclidean (n + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
        (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))
  let ℓ : ℝ := 8 * Real.log 2 * (δ : ℝ)
  let I : ENNReal := ∫⁻ x : Euclidean (n + 1),
    ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume
  obtain ⟨q0, hq0⟩ := hEne
  have hEne : E.Nonempty := ⟨q0, hq0⟩
  have hq0pos : 0 < q0 := lt_of_lt_of_le zero_lt_one (hE hq0).1
  letI : Nonempty ↥(E ∩ Ioi (0 : ℝ)) := ⟨⟨q0, hq0, hq0pos⟩⟩
  have hQeq (x : Euclidean (n + 1)) : Q x = (M x) ^ (2 : ℕ) := by
    dsimp only [Q, M, restrictedRelativeBandpassSphericalMaximal]
    exact iSup_ennreal_norm_sq_eq_sq_iSup_ennreal_norm
      (fun r : ↥(E ∩ Ioi (0 : ℝ)) =>
        𝓕⁻ (fun xi : Euclidean (n + 1) =>
          surfaceFourier (n + 1) (-r.1 • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) *
                𝓕 (g : Euclidean (n + 1) → ℂ) xi) x)
  obtain ⟨T, _hcard, _hordered, _hends, _hlength, hraw⟩ :=
    exists_entropy_interval_lintegral_iSup_literal_rel_dy_moving_bp_le_of_sharp
      hn C0 C1 hC0 hC1 hdecay hderiv phi g hphi_one hphi_zero hphi_norm j
      E hE hEne δ N hN hδ
  have hraw' : (∫⁻ x : Euclidean (n + 1), Q x ∂volume) ≤
      (N : ENNReal) * ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * ℓ ^ (2 : ℕ) * D ^ (2 : ℕ)) *
        ENNReal.ofReal (∫ xi : Euclidean (n + 1), ‖𝓕 (g : Euclidean (n + 1) → ℂ) xi‖ ^
          (2 : ℕ)) := by
    simpa only [Q, B, D, ℓ] using hraw
  have hgintegrable : Integrable (fun x : Euclidean (n + 1) => ‖g x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm g.continuous.aestronglyMeasurable).mp
      (g.memLp 2 volume)
  have hI : I = ENNReal.ofReal (∫ x : Euclidean (n + 1), ‖g x‖ ^ (2 : ℕ)) := by
    dsimp only [I]
    exact (ofReal_integral_eq_lintegral_ofReal hgintegrable
      (Filter.Eventually.of_forall fun x => sq_nonneg (‖g x‖))).symm
  have hfourier : ENNReal.ofReal (∫ xi : Euclidean (n + 1),
      ‖𝓕 (g : Euclidean (n + 1) → ℂ) xi‖ ^ (2 : ℕ)) = I := by
    rw [integral_norm_sq_fourier_schwartz_eq g, ← hI]
  have hglobal : (∫⁻ x : Euclidean (n + 1), Q x ∂volume) ≤
      (N : ENNReal) * ENNReal.ofReal (2 * B ^ (2 : ℕ) + 2 * ℓ ^ (2 : ℕ) * D ^ (2 : ℕ)) * I := by
    rw [← hfourier]
    exact hraw'
  have hpoint (x : Euclidean (n + 1)) :
      ENNReal.ofReal ((M x).toReal ^ (2 : ℕ)) ≤ Q x := by
    rw [hQeq x, ENNReal.ofReal_pow ENNReal.toReal_nonneg]
    exact pow_le_pow_left' ENNReal.ofReal_toReal_le (2 : ℕ)
  calc
    (∫⁻ x : Euclidean (n + 1), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
        (2 : ℕ)) ∂volume) =
        ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal ((M x).toReal ^ (2 : ℕ)) ∂volume := by rfl
    _ ≤ ∫⁻ x : Euclidean (n + 1), Q x ∂volume := lintegral_mono hpoint
    _ ≤ (N : ENNReal) * ENNReal.ofReal
        (2 * B ^ (2 : ℕ) + 2 * ℓ ^ (2 : ℕ) * D ^ (2 : ℕ)) * I := hglobal
    _ = (N : ENNReal) * ENNReal.ofReal
        (2 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)) ^
            (2 : ℕ) +
          2 * (8 * Real.log 2 * (δ : ℝ)) ^ (2 : ℕ) *
            (2 * ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2 - 1)
                +
              (12 * C0 *
                ‖((SchwartzMap.fderivCLM ℂ (Euclidean (n + 1)) ℂ) phi).toBoundedContinuousFunction‖)
                    /
                (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))) ^ (2 : ℕ)) *
        ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume := by
      rfl

