  refine ⟨C, hC, ?_⟩
  intro j f E u v s a b α hj hEne hE huv hu hv hs hsmall hwidth hα ha hab hsa hfsupport
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let Q : Euclidean (n + 1) → ENNReal := fun x =>
    ⨆ r : Icc u v, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean (n + 1) =>
      surfaceFourier (n + 1) (-r.1 • ξ) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
            𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖
  let I : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂volume
  let J : ENNReal := ∫⁻ y : Euclidean (n + 1), ENNReal.ofReal ‖f y‖ ∂ν
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hMtoReal : Measurable (fun x : Euclidean (n + 1) => (M x).toReal) := by
    have hEunit : E ⊆ Icc (1 : ℝ) 2 := by
      intro r hr
      exact ⟨hu.trans (hE hr).1, (hE hr).2.trans hv⟩
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hEunit hEne
  have hA_subset : A ⊆ ball (0 : Euclidean (n + 1)) s := by
    intro x hx
    have hxnorm : ‖x‖ ≤ s / 2 := by
      have hxclosed := hx.1
      rw [Metric.mem_closedBall, dist_zero_right] at hxclosed
      exact hxclosed
    rw [Metric.mem_ball, dist_zero_right]
    exact lt_of_le_of_lt hxnorm (by linarith)
  have hcap_support : ∀ y : Euclidean (n + 1), ¬ s < ‖y‖ → f y = 0 := by
    intro y hy
    apply hfsupport y
    intro hyB
    have hynorm : a ≤ ‖y‖ := by
      have hynotball := hyB.2
      rw [Metric.mem_ball, dist_zero_right] at hynotball
      exact le_of_not_gt hynotball
    exact hy (lt_of_lt_of_le hsa hynorm)
  have hQcap : (∫⁻ x in ball (0 : Euclidean (n + 1)) s, Q x) ≤
      relativeIntervalBandCapTail n j C u v s * I := by
    dsimp only [Q, I, relativeIntervalBandCapTail]
    exact hcap j f hj huv hu hv hs hsmall hwidth hcap_support
  have hM_le_Q (x : Euclidean (n + 1)) : M x ≤ Q x := by
    dsimp only [M, Q, restrictedRelativeBandpassSphericalMaximal]
    apply iSup_le
    intro r
    exact le_iSup (fun t : Icc u v => ENNReal.ofReal ‖𝓕⁻
      (fun ξ : Euclidean (n + 1) =>
        surfaceFourier (n + 1) (-t.1 • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (t.1 • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (t.1 • ξ))) *
              𝓕 (f : Euclidean (n + 1) → ℂ) ξ) x‖)
