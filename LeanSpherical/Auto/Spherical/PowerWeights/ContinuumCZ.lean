            exact Finset.sum_product (K.filter fun k => k ≤ q.scale)
              (Finset.univ : Finset (Fin N))
              (fun z => (dyadicPhysicalEntropyCellRight δ r z) ^ 2)
    _ ≤ ∑ k ∈ K.filter (fun k => k ≤ q.scale),
          ∑ i ∈ Finset.univ, (rUpper k : ℝ) ^ 2 := by
            apply Finset.sum_le_sum
            intro k hk
            exact Finset.sum_le_sum fun i hi => hterm k hk i
    _ = ∑ i ∈ Finset.univ,
          ∑ k ∈ K.filter (fun k => k ≤ q.scale), (rUpper k : ℝ) ^ 2 := by
            rw [Finset.sum_comm]
    _ = ∑ i ∈ Finset.univ,
          ∑ n ∈ lacunaryCZDyadicCubePastIndices K q,
            (rUpper (q.scale - (n : ℤ)) : ℝ) ^ 2 := by
            apply Finset.sum_congr rfl
            intro i hi
            exact (sum_lacunaryCZDyadicCubePastIndices_eq K q
              (fun k => (rUpper k : ℝ) ^ 2)).symm
    _ ≤ ∑ _i ∈ Finset.univ,
          (16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2 := by
            apply Finset.sum_le_sum
            intro i hi
            exact dyadic_lacunary_selector_finset_past_sq_le rUpper hrUpper q.scale
              (lacunaryCZDyadicCubePastIndices K q)
    _ = (N : ℝ) * (16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2 := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      ring

/-- The total relative width of entropy cells strictly above a cube scale is
summable after the `a⁻²` factor from the radius FTOC. -/
theorem sum_dyadicPhysicalEntropyCell_length_mul_left_inv_sq_future_le
    {d N : Nat} (K : Finset ℤ) (δ : ℝ≥0)
    (r : Fin N → ℤ → PositiveRadius)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (q : LacunaryCZDyadicCubeIndex d)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1) :
    (∑ z ∈ (K.product Finset.univ).filter (fun z => q.scale < z.1),
      (dyadicPhysicalEntropyCellRight δ r z -
        dyadicPhysicalEntropyCellLeft δ r z) *
          (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2) ≤
        (N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
          ((2 : ℝ) ^ q.scale)⁻¹ := by
  classical
  let L : ℝ := 8 * Real.log 2 * (δ : ℝ)
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (mul_nonneg (by norm_num)
      (Real.log_nonneg (by norm_num))) (by positivity)
  let rLower : ℤ → PositiveRadius := fun k =>
    ⟨(2 : ℝ) ^ k, zpow_pos (by norm_num : (0 : ℝ) < 2) k⟩
  have hrLower : IsDyadicLacunaryRadiusSelector rLower := by
    intro k
    dsimp only [rLower]
    constructor
    · rfl
    · have hpow : 0 ≤ (2 : ℝ) ^ k := zpow_nonneg (by norm_num) _
      nlinarith
  have hterm (k : ℤ) (hk : k ∈ K.filter (fun k => q.scale < k)) (i : Fin N) :
      (dyadicPhysicalEntropyCellRight δ r (k, i) -
        dyadicPhysicalEntropyCellLeft δ r (k, i)) *
          (dyadicPhysicalEntropyCellLeft δ r (k, i))⁻¹ ^ 2 ≤
        L * (rLower k : ℝ)⁻¹ := by
    let a : ℝ := dyadicPhysicalEntropyCellLeft δ r (k, i)
    let b : ℝ := dyadicPhysicalEntropyCellRight δ r (k, i)
    let R : ℝ := (2 : ℝ) ^ k
    have hR : 0 < R := zpow_pos (by norm_num) k
    have ha : 0 < a := by
      simpa only [a] using dyadicPhysicalEntropyCellLeft_pos δ r hr (k, i)
    have hab : a ≤ b := by
      simpa only [a, b] using dyadicPhysicalEntropyCellLeft_le_right δ r hr (k, i)
    have hlength : b - a ≤ R * L := by
      simpa only [a, b, R, L] using
        dyadicPhysicalEntropyCell_length_le_linear δ r hr (k, i) hδ
    have hleft : R ≤ a := by
      simpa only [a, R] using
        (dyadicPhysicalEntropyCell_endpoints_mem_block δ r hr (k, i)).1.1
    have hinv : a⁻¹ ≤ R⁻¹ := by
      rw [inv_eq_one_div, inv_eq_one_div]
      exact one_div_le_one_div_of_le hR hleft
    have hinv_sq : a⁻¹ ^ 2 ≤ R⁻¹ ^ 2 :=
      pow_le_pow_left₀ (inv_nonneg.mpr ha.le) hinv 2
    have hRL : 0 ≤ R * L := mul_nonneg hR.le hL
    calc
      (dyadicPhysicalEntropyCellRight δ r (k, i) -
        dyadicPhysicalEntropyCellLeft δ r (k, i)) *
          (dyadicPhysicalEntropyCellLeft δ r (k, i))⁻¹ ^ 2 =
          (b - a) * a⁻¹ ^ 2 := by rfl
      _ ≤ (R * L) * a⁻¹ ^ 2 :=
        mul_le_mul_of_nonneg_right hlength (sq_nonneg _)
      _ ≤ (R * L) * R⁻¹ ^ 2 :=
        mul_le_mul_of_nonneg_left hinv_sq hRL
      _ = L * R⁻¹ := by
        field_simp [hR.ne']
      _ = L * (rLower k : ℝ)⁻¹ := by rfl
  have hfilter :
      (K.product (Finset.univ : Finset (Fin N))).filter (fun z => q.scale < z.1) =
        (K.filter fun k => q.scale < k).product (Finset.univ : Finset (Fin N)) := by
    ext z
    simp
  have hfuture (i : Fin N) :
      (∑ n ∈ lacunaryCZDyadicCubeFutureIndices K q,
        L * (rLower (q.scale + (n : ℤ)) : ℝ)⁻¹) ≤
          2 * L * ((2 : ℝ) ^ q.scale)⁻¹ := by
    have htail := dyadic_lacunary_selector_finset_tail_le rLower hrLower 0 q.scale
      (lacunaryCZDyadicCubeFutureIndices K q)
    have htail' :
        (∑ n ∈ lacunaryCZDyadicCubeFutureIndices K q,
          (rLower (q.scale + (n : ℤ)) : ℝ)⁻¹) ≤
            2 * ((2 : ℝ) ^ q.scale)⁻¹ := by
      simpa only [rLower, pow_zero, inv_one, one_mul, mul_one] using htail
    calc
      (∑ n ∈ lacunaryCZDyadicCubeFutureIndices K q,
        L * (rLower (q.scale + (n : ℤ)) : ℝ)⁻¹) =
          L * (∑ n ∈ lacunaryCZDyadicCubeFutureIndices K q,
            (rLower (q.scale + (n : ℤ)) : ℝ)⁻¹) := by
              rw [Finset.mul_sum]
      _ ≤ L * (2 * ((2 : ℝ) ^ q.scale)⁻¹) :=
        mul_le_mul_of_nonneg_left htail' hL
      _ = 2 * L * ((2 : ℝ) ^ q.scale)⁻¹ := by ring
  calc
    (∑ z ∈ (K.product Finset.univ).filter (fun z => q.scale < z.1),
      (dyadicPhysicalEntropyCellRight δ r z -
        dyadicPhysicalEntropyCellLeft δ r z) *
          (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2) =
        ∑ k ∈ K.filter (fun k => q.scale < k),
          ∑ i ∈ Finset.univ,
            (dyadicPhysicalEntropyCellRight δ r (k, i) -
              dyadicPhysicalEntropyCellLeft δ r (k, i)) *
                (dyadicPhysicalEntropyCellLeft δ r (k, i))⁻¹ ^ 2 := by
          rw [hfilter]
          exact Finset.sum_product (K.filter fun k => q.scale < k)
            (Finset.univ : Finset (Fin N))
            (fun z => (dyadicPhysicalEntropyCellRight δ r z -
              dyadicPhysicalEntropyCellLeft δ r z) *
                (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2)
    _ ≤ ∑ k ∈ K.filter (fun k => q.scale < k),
          ∑ i ∈ Finset.univ, L * (rLower k : ℝ)⁻¹ := by
            apply Finset.sum_le_sum
            intro k hk
            exact Finset.sum_le_sum fun i hi => hterm k hk i
    _ = ∑ i ∈ Finset.univ,
          ∑ k ∈ K.filter (fun k => q.scale < k), L * (rLower k : ℝ)⁻¹ := by
            rw [Finset.sum_comm]
    _ = ∑ i ∈ Finset.univ,
          ∑ n ∈ lacunaryCZDyadicCubeFutureIndices K q,
            L * (rLower (q.scale + (n : ℤ)) : ℝ)⁻¹ := by
            apply Finset.sum_congr rfl
            intro i hi
            exact (sum_lacunaryCZDyadicCubeFutureIndices_eq K q
              (fun k => L * (rLower k : ℝ)⁻¹)).symm
    _ ≤ ∑ _i ∈ Finset.univ,
          2 * L * ((2 : ℝ) ^ q.scale)⁻¹ := by
            apply Finset.sum_le_sum
            intro i hi
            exact hfuture i
    _ = (N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
          ((2 : ℝ) ^ q.scale)⁻¹ := by
      rw [Finset.sum_const, Finset.card_univ, Fintype.card_fin, nsmul_eq_mul]
      dsimp only [L]
      ring

/-- The finite entropy-palette reduction written directly in physical
coordinates.  It is only the normalized palette comparison with the radius
in block `k` written as `2^k t`; keeping that factor visible is what lets the
Calderón--Zygmund tail argument subsequently apply the physical radius FTC
on the exact interval. -/
theorem iSup_ennreal_norm_sq_finite_physical_palette_blocks_le
    {X : Type*} (K : Finset ℤ) (E : Set ℝ)
    (F : ℤ → ℝ → X → ℂ) (δ : ℝ≥0) (N : ℕ)
    (r : Fin N → ℤ → PositiveRadius) (P : Fin N → X → ENNReal)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (hcover : ∀ k ∈ K, ∀ s : PositiveRadius,
      (s : ℝ) ∈ E ∩ Icc ((2 : ℝ) ^ k) (2 * (2 : ℝ) ^ k) →
        ∃ i : Fin N, |logRadius s - logRadius (r i k)| ≤ (δ : ℝ))
    (hselector : ∀ k ∈ K, ∀ i x,
      ENNReal.ofReal (‖F k (r i k : ℝ) x‖ ^ 2) ≤ P i x) (x : X) :
    (⨆ k : {k // k ∈ K},
      ⨆ s : ↥((E ∩ Icc ((2 : ℝ) ^ k.1) (2 * (2 : ℝ) ^ k.1)) ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal (‖F k.1 s.1 x‖ ^ 2)) ≤
      2 * (⨆ i : Fin N, P i x) +
        8 * ∑ k ∈ K, ∑ i : Fin N,
          ⨆ t : Icc (unitScaleEntropyCell δ
              ⟨((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ),
                by
                  change 0 < ((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ)
                  exact mul_pos
                    (inv_pos.mpr (zpow_pos (by norm_num : (0 : ℝ) < 2) k))
                    (r i k).2⟩).1
              (unitScaleEntropyCell δ
              ⟨((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ),
                by
                  change 0 < ((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ)
                  exact mul_pos
                    (inv_pos.mpr (zpow_pos (by norm_num : (0 : ℝ) < 2) k))
                    (r i k).2⟩).2,
            ENNReal.ofReal
              (‖F k ((2 : ℝ) ^ k * t.1) x -
                F k ((2 : ℝ) ^ k *
                  (unitScaleEntropyCell δ
                    ⟨((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ),
                      by
                        change 0 < ((2 : ℝ) ^ k)⁻¹ * (r i k : ℝ)
                        exact mul_pos
                          (inv_pos.mpr (zpow_pos (by norm_num : (0 : ℝ) < 2) k))
                          (r i k).2⟩).1) x‖ ^ 2) := by
  classical
  let R : ℤ → ℝ := fun k => (2 : ℝ) ^ k
  have hR (k : ℤ) : 0 < R k := zpow_pos (by norm_num) k
  let c : ℤ → Fin N → PositiveRadius := fun k i =>
    ⟨(R k)⁻¹ * (r i k : ℝ), by
      change 0 < (R k)⁻¹ * (r i k : ℝ)
      exact mul_pos (inv_pos.mpr (hR k)) (r i k).2⟩
  let E₀ : ℤ → Set ℝ := fun k => normalizedRadiusBlock E (R k)
  let G : ℤ → ℝ → X → ℂ := fun k t => F k (R k * t)
  have hE₀ (k : ℤ) (hk : k ∈ K) : E₀ k ⊆ Icc (1 : ℝ) 2 := by
    exact normalizedRadiusBlock_subset_Icc_one_two (hR k)
  have hc (k : ℤ) (hk : k ∈ K) (i : Fin N) :
      (c k i : ℝ) ∈ Icc (1 : ℝ) 2 := by
    constructor
    · change 1 ≤ (R k)⁻¹ * (r i k : ℝ)
      calc
        1 = (R k)⁻¹ * R k := by field_simp [(hR k).ne']
        _ ≤ (R k)⁻¹ * (r i k : ℝ) :=
          mul_le_mul_of_nonneg_left (hr i k).1 (inv_nonneg.mpr (hR k).le)
    · change (R k)⁻¹ * (r i k : ℝ) ≤ 2
      have h := (hr i k).2
      calc
        (R k)⁻¹ * (r i k : ℝ) ≤ (R k)⁻¹ * (2 * R k) :=
          mul_le_mul_of_nonneg_left h (inv_nonneg.mpr (hR k).le)
        _ = 2 := by field_simp [(hR k).ne']
  have hcover₀ (k : ℤ) (hk : k ∈ K) (s : PositiveRadius)
      (hs : (s : ℝ) ∈ E₀ k) :
      ∃ i : Fin N, |logRadius s - logRadius (c k i)| ≤ (δ : ℝ) := by
    rcases hs with ⟨u, hu, hus⟩
    have hu_pos : 0 < u := lt_of_lt_of_le (hR k) hu.2.1
    let u' : PositiveRadius := ⟨u, hu_pos⟩
    obtain ⟨i, hi⟩ := hcover k hk u' hu
    refine ⟨i, ?_⟩
    let R' : PositiveRadius := ⟨R k, hR k⟩
    have hs_mul : R k * s.1 = u := by
      rw [← hus]
      field_simp [(hR k).ne']
    have hc_mul : R k * (c k i : ℝ) = r i k := by
      dsimp only [c]
      field_simp [(hR k).ne']
    have hs_log : logRadius s = logRadius u' - logRadius R' := by
      let rs : PositiveRadius := ⟨R k * s.1, mul_pos (hR k) s.2⟩
      have hrs : rs = u' := Subtype.ext hs_mul
      have hmul : logRadius rs = logRadius R' + logRadius s := by
        simpa only [rs, R'] using logRadius_mul R' s
      change logRadius s = logRadius u' - logRadius R'
      rw [hrs] at hmul
      linarith
    have hc_log : logRadius (c k i) = logRadius (r i k) - logRadius R' := by
      let rc : PositiveRadius := ⟨R k * (c k i : ℝ),
        mul_pos (hR k) (c k i).2⟩
      have hrc : rc = r i k := Subtype.ext hc_mul
      have hmul : logRadius rc = logRadius R' + logRadius (c k i) := by
        simpa only [rc, R'] using logRadius_mul R' (c k i)
      change logRadius (c k i) = logRadius (r i k) - logRadius R'
      rw [hrc] at hmul
      linarith
    rw [hs_log, hc_log]
    convert hi using 1; ring
  have hselector₀ (k : ℤ) (hk : k ∈ K) (i : Fin N) (x' : X) :
      ENNReal.ofReal (‖G k (c k i : ℝ) x'‖ ^ 2) ≤ P i x' := by
    have h := hselector k hk i x'
    dsimp only [G]
    convert h using 1
    congr 1
    dsimp only [c]
    field_simp [(hR k).ne']
  have hnormalized :=
    iSup_ennreal_norm_sq_finite_palette_blocks_le K E₀ G δ N c P hE₀ hc
      hcover₀ hselector₀ x
  have hphysical :
      (⨆ k : {k // k ∈ K},
        ⨆ s : ↥((E ∩ Icc (R k.1) (2 * R k.1)) ∩ Ioi (0 : ℝ)),
          ENNReal.ofReal (‖F k.1 s.1 x‖ ^ 2)) ≤
        (⨆ k : {k // k ∈ K},
          ⨆ s : ↥(E₀ k.1 ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal (‖G k.1 s.1 x‖ ^ 2)) := by
    apply iSup_le
    intro k
    apply iSup_le
    intro s
    let t : PositiveRadius := ⟨(R k.1)⁻¹ * s.1,
      mul_pos (inv_pos.mpr (hR k.1)) s.2.2⟩
    have htE : (t : ℝ) ∈ E₀ k.1 := by
      refine ⟨s.1, s.2.1, ?_⟩
      rfl
    have htpos : (t : ℝ) ∈ Ioi (0 : ℝ) := t.2
    have hval : R k.1 * (t : ℝ) = s.1 := by
      dsimp only [t]
      field_simp [(hR k.1).ne']
    calc
      ENNReal.ofReal (‖F k.1 s.1 x‖ ^ 2) =
          ENNReal.ofReal (‖G k.1 (t : ℝ) x‖ ^ 2) := by
            dsimp only [G]
            rw [hval]
      _ ≤ ⨆ k : {k // k ∈ K},
          ⨆ z : ↥(E₀ k.1 ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal (‖G k.1 z.1 x‖ ^ 2) :=
            le_iSup_of_le k
              (le_iSup (fun z : ↥(E₀ k.1 ∩ Ioi (0 : ℝ)) =>
                ENNReal.ofReal (‖G k.1 z.1 x‖ ^ 2)) ⟨t, htE, htpos⟩)
  calc
    (⨆ k : {k // k ∈ K},
      ⨆ s : ↥((E ∩ Icc ((2 : ℝ) ^ k.1) (2 * (2 : ℝ) ^ k.1)) ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal (‖F k.1 s.1 x‖ ^ 2)) =
        (⨆ k : {k // k ∈ K},
          ⨆ s : ↥((E ∩ Icc (R k.1) (2 * R k.1)) ∩ Ioi (0 : ℝ)),
            ENNReal.ofReal (‖F k.1 s.1 x‖ ^ 2)) := by rfl
    _ ≤ _ := hphysical
    _ ≤ 2 * (⨆ i : Fin N, P i x) +
        8 * ∑ k ∈ K, ∑ i : Fin N,
          ⨆ t : Icc (unitScaleEntropyCell δ (c k i)).1
              (unitScaleEntropyCell δ (c k i)).2,
            ENNReal.ofReal
              (‖F k (R k * t.1) x -
                F k (R k * (unitScaleEntropyCell δ (c k i)).1) x‖ ^ 2) := by
          simpa only [E₀, G, c, R] using hnormalized

/-- The physical finite-palette comparison specialized to the literal
bandpass convolution and expressed through the finite physical cell square
variation used by the Calderón--Zygmund argument. -/
theorem iSup_ennreal_norm_sq_finite_physical_palette_blocks_le_cellVariation
    {d N : Nat} (K : Finset ℤ) (E : Set ℝ)
    (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat) (g : Euclidean d → ℂ)
    (δ : ℝ≥0) (r : Fin N → ℤ → PositiveRadius)
    (P : Fin N → Euclidean d → ENNReal)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (hcover : ∀ k ∈ K, ∀ s : PositiveRadius,
      (s : ℝ) ∈ E ∩ Icc ((2 : ℝ) ^ k) (2 * (2 : ℝ) ^ k) →
        ∃ i : Fin N, |logRadius s - logRadius (r i k)| ≤ (δ : ℝ))
    (hselector : ∀ k ∈ K, ∀ i x,
      ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j (r i k : ℝ) g x‖ ^ 2) ≤ P i x)
    (x : Euclidean d) :
    (⨆ k : {k // k ∈ K},
      ⨆ s : ↥((E ∩ Icc ((2 : ℝ) ^ k.1) (2 * (2 : ℝ) ^ k.1)) ∩ Ioi (0 : ℝ)),
        ENNReal.ofReal
          (‖lacunaryRelativeBandpassPhysicalTerm ψ j s.1 g x‖ ^ 2)) ≤
      2 * (⨆ i : Fin N, P i x) +
        8 * lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r) g x := by
  rw [lacunaryRelativeBandpassPhysicalCellSquareVariation_dyadic_entropy_cells]
  simpa only [dyadicPhysicalEntropyCellCenter] using
    iSup_ennreal_norm_sq_finite_physical_palette_blocks_le K E
      (fun k s x => lacunaryRelativeBandpassPhysicalTerm ψ j s g x)
      δ N r P hr hcover hselector x

/-- The literal square variation is bounded by the square of the literal
oscillation.  This is the exact conversion used to combine the `L²` good
part with the `L¹` FTOC bad part. -/
theorem lacunaryRelativeBandpassPhysicalCellSquareVariation_le_oscillation_sq
    {d : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (hab : ∀ q ∈ I, a q ≤ b q) (g : Euclidean d → ℂ)
    (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j I a b g x ≤
      (lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b g x) ^ 2 := by
  classical
  let A : ι → ENNReal := fun q =>
    ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖
  have hcell (q : ι) (hq : q ∈ I) :
      (⨆ t : Icc (a q) (b q), ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖ ^ 2)) =
        (A q) ^ 2 := by
    letI : Nonempty (Icc (a q) (b q)) :=
      ⟨⟨a q, le_rfl, hab q hq⟩⟩
    change (⨆ t : Icc (a q) (b q), ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖ ^ 2)) = _
    rw [show (fun t : Icc (a q) (b q) => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖ ^ 2)) =
        fun t => (ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖) ^ 2 by
          funext t
          rw [ENNReal.ofReal_pow (norm_nonneg _)]]
    rw [← ENNReal.iSup_pow]
  have hterm (q : ι) (hq : q ∈ I) :
      (A q) ^ 2 ≤ A q * (∑ z ∈ I, A z) := by
    rw [pow_two]
    have hqsum : A q ≤ ∑ z ∈ I, A z :=
      Finset.single_le_sum (fun _ _ => bot_le) hq
    calc
      A q * A q ≤ (∑ z ∈ I, A z) * A q :=
        mul_le_mul_left hqsum (A q)
      _ = A q * (∑ z ∈ I, A z) := by ring
  unfold lacunaryRelativeBandpassPhysicalCellSquareVariation
    lacunaryRelativeBandpassPhysicalCellOscillation
  change (∑ q ∈ I, _ ) ≤ (∑ q ∈ I, A q) ^ 2
  calc
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 g x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q) g x‖ ^ 2)) =
        ∑ q ∈ I, (A q) ^ 2 := by
          apply Finset.sum_congr rfl
          intro q hq
          exact hcell q hq
    _ ≤ ∑ q ∈ I, A q * (∑ z ∈ I, A z) :=
      Finset.sum_le_sum fun q hq => hterm q hq
    _ = (∑ q ∈ I, A q) ^ 2 := by
      rw [← Finset.sum_mul]
      ring

private theorem lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_le_of_cell_majorant
    {d : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (atom : Euclidean d → ℂ) (H : ι → Euclidean d → ℝ)
    (hHmeas : ∀ q ∈ I, AEMeasurable (fun x => ENNReal.ofReal (H q x)) volume)
    (hmajor : ∀ q ∈ I, ∀ x : Euclidean d, ∀ t : Icc (a q) (b q),
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) atom x‖ ≤ H q x) :
    (∫⁻ x, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
      ∑ q ∈ I, ∫⁻ x, ENNReal.ofReal (H q x) := by
  unfold lacunaryRelativeBandpassPhysicalCellOscillation
  calc
    (∫⁻ x, ∑ q ∈ I,
      ⨆ t : Icc (a q) (b q), ENNReal.ofReal
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) atom x‖) ≤
        ∫⁻ x, ∑ q ∈ I, ENNReal.ofReal (H q x) := by
          apply lintegral_mono
          intro x
          apply Finset.sum_le_sum
          intro q hq
          apply iSup_le
          intro t
          exact ENNReal.ofReal_le_ofReal (hmajor q hq x t)
    _ = ∑ q ∈ I, ∫⁻ x, ENNReal.ofReal (H q x) := by
      rw [lintegral_finsetSum' I hHmeas]

/-- The signed radius FTOC turns the literal finite cell oscillation of one
mean-zero atom into the centred-generator tail.  The two hypotheses
`hHintegrable` and `hFubini` are the sole Fubini bookkeeping required here;
the cell estimate itself keeps the literal interval supremum. -/
theorem lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_future_atom_le_of_fubini
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (hzero : (∫ y : Euclidean d, atom y) = 0)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ)
    (hHintegrable : ∀ q ∈ I,
      Integrable (fun x : Euclidean d =>
        ∫ t in a q..b q, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) volume)
    (hFubini : ∀ q ∈ I,
      (∫ x : Euclidean d, ∫ t in a q..b q, ‖∫ y : Euclidean d, atom y *
        ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) =
        ∫ t in a q..b q, ∫ x : Euclidean d, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) :
    (∫⁻ x, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
      ENNReal.ofReal
        (ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖atom y‖)) := by
  let H : ι → Euclidean d → ℝ := fun q x =>
    ∫ t in a q..b q, ‖∫ y : Euclidean d, atom y *
      ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
        (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖
  have hHnon (q : ι) (hq : q ∈ I) (x : Euclidean d) : 0 ≤ H q x := by
    dsimp only [H]
    exact intervalIntegral.integral_nonneg (hab q hq) fun _ _ => norm_nonneg _
  have hHmeas (q : ι) (hq : q ∈ I) :
      AEMeasurable (fun x => ENNReal.ofReal (H q x)) volume := by
    exact (hHintegrable q hq).aemeasurable.ennreal_ofReal
  have hpoint (q : ι) (hq : q ∈ I) (x : Euclidean d)
      (t : Icc (a q) (b q)) :
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) atom x‖ ≤ H q x := by
    simpa only [H] using
      norm_lacunaryRelBpPhysicalTerm_sub_left_le_intervalInteg_mean_zero_generator
        hd ψ j G hG (ha q hq) (hab q hq) t.2 atom hatom hzero c x
  have hosci :=
    lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_le_of_cell_majorant
      ψ j I a b atom H hHmeas hpoint
  calc
    (∫⁻ x, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
        ∑ q ∈ I, ∫⁻ x, ENNReal.ofReal (H q x) := hosci
    _ = ∑ q ∈ I, ENNReal.ofReal (∫ x, H q x) := by
      apply Finset.sum_congr rfl
      intro q hq
      exact (ofReal_integral_eq_lintegral_ofReal (hHintegrable q hq)
        (Filter.Eventually.of_forall (hHnon q hq))).symm
    _ = ENNReal.ofReal (∑ q ∈ I, ∫ x, H q x) := by
      rw [ENNReal.ofReal_sum_of_nonneg fun q hq =>
        integral_nonneg fun x => hHnon q hq x]
    _ = ENNReal.ofReal (∑ q ∈ I, ∫ t in a q..b q,
        ∫ x : Euclidean d, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖) := by
      congr 1
      apply Finset.sum_congr rfl
      intro q hq
      simpa only [H] using hFubini q hq
    _ ≤ ENNReal.ofReal
        (ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖atom y‖)) :=
      ENNReal.ofReal_le_ofReal
        (lacunaryRelativeBandpassPhysicalCellFuture_atom_tail_le
          hd ψ j G hG I a b ha hab atom hatom hρ hatom_supp)

/-- The future physical-cell atom tail, with the concrete centred-generator
Fubini theorem supplying the only interval-integrability input. -/
theorem lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_future_atom_le
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (hzero : (∫ y : Euclidean d, atom y) = 0)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫⁻ x, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
      ENNReal.ofReal
        (ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖atom y‖)) := by
  apply lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_future_atom_le_of_fubini
    hd ψ j G hG I a b ha hab atom hatom hzero hρ hatom_supp
  · intro q hq
    exact (integrable_and_integral_lacunaryRelativeBandpassPhysicalCell_centeredGenerator
      hd ψ j G hG (ha q hq) (hab q hq) atom hatom hρ hatom_supp).1
  · intro q hq
    exact (integrable_and_integral_lacunaryRelativeBandpassPhysicalCell_centeredGenerator
      hd ψ j G hG (ha q hq) (hab q hq) atom hatom hρ hatom_supp).2

/-- The future-cell FTOC estimate has a concrete integrable majorant.  This
is intentionally stated as an existential package: the majorant is used
only in the ensuing Calderón--Zygmund Markov step, so introducing a global
operator name for it would add no mathematical content. -/
theorem exists_integrable_lacunaryRelBpPhysicalCellOscillation_future_atom_majorant
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (atom : Euclidean d → ℂ) (hatom : Integrable atom volume)
    (hzero : (∫ y : Euclidean d, atom y) = 0)
    {c : Euclidean d} {ρ : ℝ} (hρ : 0 ≤ ρ)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    ∃ H : Euclidean d → ℝ, Integrable H volume ∧
      (∀ x, 0 ≤ H x) ∧
      (∀ x, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
        ENNReal.ofReal (H x)) ∧
      (∫ x : Euclidean d, H x) ≤
        ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖atom y‖) := by
  let Hq : ι → Euclidean d → ℝ := fun q x =>
    ∫ t in a q..b q, ‖∫ y : Euclidean d, atom y *
      ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
        (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖
  let H : Euclidean d → ℝ := fun x => ∑ q ∈ I, Hq q x
  have hHqint (q : ι) (hq : q ∈ I) : Integrable (Hq q) volume := by
    dsimp only [Hq]
    exact (integrable_and_integral_lacunaryRelativeBandpassPhysicalCell_centeredGenerator
      hd ψ j G hG (ha q hq) (hab q hq) atom hatom hρ hatom_supp).1
  have hHqeq (q : ι) (hq : q ∈ I) :
      (∫ x : Euclidean d, Hq q x) =
        ∫ t in a q..b q, ∫ x : Euclidean d, ‖∫ y : Euclidean d, atom y *
          ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
            (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖ := by
    dsimp only [Hq]
    exact (integrable_and_integral_lacunaryRelativeBandpassPhysicalCell_centeredGenerator
      hd ψ j G hG (ha q hq) (hab q hq) atom hatom hρ hatom_supp).2
  have hHqnon (q : ι) (hq : q ∈ I) (x : Euclidean d) : 0 ≤ Hq q x := by
    dsimp only [Hq]
    exact intervalIntegral.integral_nonneg (hab q hq) fun _ _ => norm_nonneg _
  have hHint : Integrable H volume := by
    dsimp only [H]
    exact integrable_finsetSum I fun q hq => hHqint q hq
  have hHnon (x : Euclidean d) : 0 ≤ H x := by
    dsimp only [H]
    exact Finset.sum_nonneg fun q hq => hHqnon q hq x
  have hpoint (q : ι) (hq : q ∈ I) (x : Euclidean d)
      (t : Icc (a q) (b q)) :
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) atom x‖ ≤ Hq q x := by
    simpa only [Hq] using
      norm_lacunaryRelBpPhysicalTerm_sub_left_le_intervalInteg_mean_zero_generator
        hd ψ j G hG (ha q hq) (hab q hq) t.2 atom hatom hzero c x
  have hmajor (x : Euclidean d) :
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
        ENNReal.ofReal (H x) := by
    unfold lacunaryRelativeBandpassPhysicalCellOscillation
    calc
      (∑ q ∈ I, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 atom x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) atom x‖) ≤
          ∑ q ∈ I, ENNReal.ofReal (Hq q x) := by
        apply Finset.sum_le_sum
        intro q hq
        apply iSup_le
        intro t
        exact ENNReal.ofReal_le_ofReal (hpoint q hq x t)
      _ = ENNReal.ofReal (H x) := by
        rw [← ENNReal.ofReal_sum_of_nonneg fun q hq => hHqnon q hq x]
  refine ⟨H, hHint, hHnon, hmajor, ?_⟩
  calc
    (∫ x : Euclidean d, H x) = ∑ q ∈ I, ∫ x : Euclidean d, Hq q x := by
      dsimp only [H]
      rw [integral_finsetSum I fun q hq => hHqint q hq]
    _ = ∑ q ∈ I, ∫ t in a q..b q, ∫ x : Euclidean d, ‖∫ y : Euclidean d,
        atom y * ((t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - y)) -
          (t⁻¹ ^ (d + 1) : ℝ) • G (t⁻¹ • (x - c)))‖ := by
      apply Finset.sum_congr rfl
      intro q hq
      exact hHqeq q hq
    _ ≤ ρ * (∑ q ∈ I, (b q - a q) * (a q)⁻¹ ^ 2) *
          (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
            (∫ y : Euclidean d, ‖atom y‖) :=
      lacunaryRelativeBandpassPhysicalCellFuture_atom_tail_le
        hd ψ j G hG I a b ha hab atom hatom hρ hatom_supp

/-- The small-radius part of the literal cell oscillation has an integrable
exterior tail.  This is the physical-cell counterpart of the usual past
Calderón--Zygmund atom estimate. -/
theorem lintegral_lacunaryRelativeBandpassPhysicalCellOscillation_past_atom_tail_le
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    {ρ Q : ℝ} (hρ : 0 < ρ) (hsmall : ∀ q ∈ I, b q ≤ ρ)
    (hSq : ∑ q ∈ I, (b q) ^ 2 ≤ Q)
    (c : Euclidean d) (atom : Euclidean d → ℂ)
    (hatom : Integrable atom volume)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    (∫⁻ x in (Metric.closedBall c (3 * ρ))ᶜ,
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
      ENNReal.ofReal
        ((2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) * Q * surfaceMass d *
            (∫ y : Euclidean d, ‖atom y‖)) *
          (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2))) := by
  let E : Set (Euclidean d) := (Metric.closedBall c (3 * ρ))ᶜ
  let T : Euclidean d → ℝ := fun x => 1 / (‖x - c‖ / 3) ^ (d + 2)
  let C : ℝ := 2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
    SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) * Q * surfaceMass d *
      (∫ y : Euclidean d, ‖atom y‖)
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) * ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) 0‖ :=
        by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hQ : 0 ≤ Q := by
    have hsum : 0 ≤ ∑ q ∈ I, (b q) ^ 2 :=
      Finset.sum_nonneg fun q _ => sq_nonneg (b q)
    exact hsum.trans hSq
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg
            (by norm_num) (mul_nonneg (sq_nonneg _) hsemi))
          hQ)
        measureReal_nonneg)
      (integral_nonneg fun _ => norm_nonneg _)
  have hT : IntegrableOn T E volume := by
    simpa only [E, T] using integrableOn_lacunary_exterior_kernel_tail hd hρ c
  have hCT : IntegrableOn (fun x => C * T x) E volume := hT.const_mul C
  have hCTnon : 0 ≤ᵐ[volume.restrict E] fun x => C * T x := by
    filter_upwards with x
    dsimp only [T]
    exact mul_nonneg hC (one_div_nonneg.mpr (pow_nonneg (by positivity) _))
  have hEmeas : MeasurableSet E := by
    dsimp only [E]
    exact Metric.isClosed_closedBall.measurableSet.compl
  have hpoint (x : Euclidean d) (hx : x ∈ E) :
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
        ENNReal.ofReal (C * T x) := by
    have hxout : 3 * ρ ≤ ‖x - c‖ := by
      apply le_of_not_gt
      intro hlt
      apply hx
      rw [Metric.mem_closedBall, dist_eq_norm_sub]
      exact hlt.le
    have htail := lacunaryRelativeBandpassPhysicalCellPast_atom_tail_le
      ψ j I a b ha hab hρ hsmall hSq c atom hatom hatom_supp hxout
    calc
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
          ENNReal.ofReal
            (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
              SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) /
                (‖x - c‖ / 3) ^ (d + 2)) * Q * surfaceMass d *
                  ∫ y : Euclidean d, ‖atom y‖) := htail
      _ = ENNReal.ofReal (C * T x) := by
        congr 1
        dsimp only [C, T]
        ring
  have hlin :
      (∫⁻ x in E, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) ≤
        ∫⁻ x in E, ENNReal.ofReal (C * T x) := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem hEmeas] with x hx
    exact hpoint x hx
  calc
    (∫⁻ x in (Metric.closedBall c (3 * ρ))ᶜ,
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x) =
        ∫⁻ x in E, lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x := by
          rfl
    _ ≤ ∫⁻ x in E, ENNReal.ofReal (C * T x) := hlin
    _ = ENNReal.ofReal (∫ x in E, C * T x) :=
      (ofReal_integral_eq_lintegral_ofReal hCT hCTnon).symm
    _ = ENNReal.ofReal (C * ∫ x in E, T x) := by
      rw [MeasureTheory.integral_const_mul]
    _ = ENNReal.ofReal
        (C * (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2))) := by
      rw [integral_lacunary_exterior_kernel_tail hd hρ c]
    _ = _ := by rfl

/-- The small-radius atom oscillation has a concrete integrable exterior
majorant.  As for the future term, it is returned only as an existential
package because the object is needed solely to make the C--Z bad tail
measurable for the final Chebyshev step. -/
theorem exists_integrable_lacunaryRelativeBandpassPhysicalCellOscillation_past_atom_majorant
    {d : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    {ρ Q : ℝ} (hρ : 0 < ρ) (hsmall : ∀ q ∈ I, b q ≤ ρ)
    (hSq : ∑ q ∈ I, (b q) ^ 2 ≤ Q)
    (c : Euclidean d) (atom : Euclidean d → ℂ)
    (hatom : Integrable atom volume)
    (hatom_supp : ∀ y, atom y ≠ 0 → ‖y - c‖ ≤ ρ) :
    ∃ H : Euclidean d → ℝ, Integrable H volume ∧
      (∀ x, 0 ≤ H x) ∧
      (∀ x, x ∉ Metric.closedBall c (3 * ρ) →
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
          ENNReal.ofReal (H x)) ∧
      (∫ x : Euclidean d, H x) ≤
        (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) * Q * surfaceMass d *
            (∫ y : Euclidean d, ‖atom y‖)) *
          (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2)) := by
  classical
  let E : Set (Euclidean d) := (Metric.closedBall c (3 * ρ))ᶜ
  let T : Euclidean d → ℝ := fun x => 1 / (‖x - c‖ / 3) ^ (d + 2)
  let C : ℝ := 2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
    SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) * Q * surfaceMass d *
      (∫ y : Euclidean d, ‖atom y‖)
  let H : Euclidean d → ℝ := E.indicator fun x => C * T x
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hQ : 0 ≤ Q := by
    have hsum : 0 ≤ ∑ q ∈ I, (b q) ^ 2 :=
      Finset.sum_nonneg fun q _ => sq_nonneg (b q)
    exact hsum.trans hSq
  have hC : 0 ≤ C := by
    dsimp only [C]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg
            (by norm_num) (mul_nonneg (sq_nonneg _) hsemi))
          hQ)
        measureReal_nonneg)
      (integral_nonneg fun _ => norm_nonneg _)
  have hEmeas : MeasurableSet E := by
    dsimp only [E]
    exact Metric.isClosed_closedBall.measurableSet.compl
  have hT : IntegrableOn T E volume := by
    simpa only [E, T] using integrableOn_lacunary_exterior_kernel_tail hd hρ c
  have hCT : IntegrableOn (fun x => C * T x) E volume := hT.const_mul C
  have hHint : Integrable H volume := by
    dsimp only [H]
    exact hCT.integrable_indicator hEmeas
  have hHnon (x : Euclidean d) : 0 ≤ H x := by
    by_cases hx : x ∈ E
    · rw [show H x = C * T x by simp only [H, Set.indicator_of_mem hx]]
      dsimp only [T]
      exact mul_nonneg hC (one_div_nonneg.mpr (pow_nonneg (by positivity) _))
    · rw [show H x = 0 by simp only [H, Set.indicator_of_notMem hx]]
  have hpoint (x : Euclidean d) (hx : x ∉ Metric.closedBall c (3 * ρ)) :
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
        ENNReal.ofReal (H x) := by
    have hxE : x ∈ E := hx
    have hxout : 3 * ρ ≤ ‖x - c‖ := by
      apply le_of_not_gt
      intro hlt
      apply hx
      rw [Metric.mem_closedBall, dist_eq_norm_sub]
      exact hlt.le
    have htail := lacunaryRelativeBandpassPhysicalCellPast_atom_tail_le
      ψ j I a b ha hab hρ hsmall hSq c atom hatom hatom_supp hxout
    calc
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b atom x ≤
          ENNReal.ofReal
            (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
              SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) /
                (‖x - c‖ / 3) ^ (d + 2)) * Q * surfaceMass d *
                  ∫ y : Euclidean d, ‖atom y‖) := htail
      _ = ENNReal.ofReal (H x) := by
        congr 1
        rw [show H x = C * T x by simp only [H, Set.indicator_of_mem hxE]]
        dsimp only [C, T]
        ring
  refine ⟨H, hHint, hHnon, hpoint, ?_⟩
  calc
    (∫ x : Euclidean d, H x) = ∫ x in E, C * T x := by
      dsimp only [H]
      rw [MeasureTheory.integral_indicator hEmeas]
    _ = C * ∫ x in E, T x := by
      rw [MeasureTheory.integral_const_mul]
    _ = C * (surfaceMass d * (3 : ℝ) ^ d / (2 * ρ ^ 2)) := by
      rw [integral_lacunary_exterior_kernel_tail hd hρ c]
    _ ≤ _ := by
      dsimp only [C]
      exact le_refl _

/-- The scale-free coefficient produced by the physical-cell past and
future atom tails.  Its two summands respectively correspond to the
Fourier-decay and radius-FTOC pieces of the argument. -/
def lacunaryRelativeBandpassPhysicalCellCZTailConstant
    {d : Nat} (N : Nat) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (δ : ℝ≥0) (G : SchwartzMap (Euclidean d) ℂ) : ℝ :=
  (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
      SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) *
      ((N : ℝ) * (16 / 3 : ℝ)) * surfaceMass d *
        (surfaceMass d * (3 : ℝ) ^ d / (2 * (d : ℝ) ^ 2))) +
    ((d : ℝ) * ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ)))) *
      ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)

theorem lacunaryRelativeBandpassPhysicalCellCZTailConstant_nonneg
    {d : Nat} (N : Nat) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (δ : ℝ≥0) (G : SchwartzMap (Euclidean d) ℂ) :
    0 ≤ lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G := by
  have hsemi : 0 ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) := by
    calc
      0 ≤ ‖(0 : Euclidean d)‖ ^ (d + 2) *
          ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) 0‖ := by positivity
      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hlog : 0 ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  have hδ : 0 ≤ (δ : ℝ) := δ.2
  have hderiv : 0 ≤ ∫ x : Euclidean d,
      ‖fderiv ℝ (G : Euclidean d → ℂ) x‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hA : 0 ≤ ((2 : ℝ) ^ j)⁻¹ ^ 2 *
      SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ) :=
    mul_nonneg (sq_nonneg _) hsemi
  have hB : 0 ≤ (N : ℝ) * (16 / 3 : ℝ) :=
    mul_nonneg (Nat.cast_nonneg _) (by norm_num)
  have hR : 0 ≤ surfaceMass d * (3 : ℝ) ^ d / (2 * (d : ℝ) ^ 2) :=
    div_nonneg
      (mul_nonneg measureReal_nonneg (pow_nonneg (by norm_num) _))
      (mul_nonneg (by norm_num) (sq_nonneg _))
  have h8log : 0 ≤ 8 * Real.log 2 := mul_nonneg (by norm_num) hlog
  have hscale : 0 ≤ 2 * (8 * Real.log 2 * (δ : ℝ)) :=
    mul_nonneg (by norm_num) (mul_nonneg h8log hδ)
  unfold lacunaryRelativeBandpassPhysicalCellCZTailConstant
  exact add_nonneg
    (mul_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg (by norm_num) hA)
          hB)
        measureReal_nonneg)
      hR)
    (mul_nonneg
      (mul_nonneg
        (Nat.cast_nonneg d)
        (mul_nonneg (Nat.cast_nonneg N) hscale))
      hderiv)

/-- The finite physical cells split exactly at a stopping cube's dyadic
scale.  The two parts are respectively the inputs of the small-radius and
FTOC atom estimates. -/
theorem lacunaryRelativeBandpassPhysicalCellOscillation_dyadic_scale_split
    {d N : Nat} (K : Finset ℤ) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (a b : ℤ × Fin N → ℝ) (q : LacunaryCZDyadicCubeIndex d)
    (g : Euclidean d → ℂ) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalCellOscillation ψ j
        (K.product Finset.univ) a b g x =
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          ((K.product Finset.univ).filter fun z => z.1 ≤ q.scale) a b g x +
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          ((K.product Finset.univ).filter fun z => q.scale < z.1) a b g x := by
  unfold lacunaryRelativeBandpassPhysicalCellOscillation
  rw [← Finset.sum_filter_add_sum_filter_not
    (p := fun z : ℤ × Fin N => z.1 ≤ q.scale)]
  simp only [not_le]

private theorem lacunaryRelativeBandpassPhysicalCellCZ_past_rhs_eq
    {d N : Nat} (hd : 0 < d) (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (q : LacunaryCZDyadicCubeIndex d) (L : ℝ) :
    (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
        SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) *
        ((N : ℝ) * (16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2) *
          surfaceMass d * L) *
        (surfaceMass d * (3 : ℝ) ^ d /
          (2 * (lacunaryCZDyadicCubeRadius q) ^ 2)) =
      (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
          SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) *
          ((N : ℝ) * (16 / 3 : ℝ)) * surfaceMass d *
            (surfaceMass d * (3 : ℝ) ^ d / (2 * (d : ℝ) ^ 2))) * L := by
  unfold lacunaryCZDyadicCubeRadius
  have hd0 : (d : ℝ) ≠ 0 := by exact_mod_cast Nat.ne_of_gt hd
  have hq0 : (2 : ℝ) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
  field_simp

private theorem lacunaryRelativeBandpassPhysicalCellCZ_future_rhs_eq
    {d N : Nat} (hd : 0 < d) (δ : ℝ≥0)
    (G : SchwartzMap (Euclidean d) ℂ)
    (q : LacunaryCZDyadicCubeIndex d) (L : ℝ) :
    lacunaryCZDyadicCubeRadius q *
        ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
          ((2 : ℝ) ^ q.scale)⁻¹) *
        (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) * L =
      ((d : ℝ) * ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ)))) *
        ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) * L := by
  unfold lacunaryCZDyadicCubeRadius
  have hq0 : (2 : ℝ) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
  field_simp

/-- One dyadic C--Z atom has an integrable majorant for all literal
physical entropy cells outside its triple ball.  The past/future split is
performed at the cube scale, so the coefficient is uniform in the finite
physical block set. -/
theorem exists_integrable_lacunaryRelativeBandpassPhysicalCellCZ_atom_majorant
    {d N : Nat} (hd : 3 ≤ d) (K : Finset ℤ) (δ : ℝ≥0)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (r : Fin N → ℤ → PositiveRadius)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    (q : LacunaryCZDyadicCubeIndex d) (atom : Euclidean d → ℂ)
    (hatom : Integrable atom volume)
    (hzero : (∫ y : Euclidean d, atom y) = 0)
    (hatom_supp : ∀ y, atom y ≠ 0 →
      ‖y - lacunaryCZDyadicCubeCenter q‖ ≤ lacunaryCZDyadicCubeRadius q) :
    ∃ H : Euclidean d → ℝ, Integrable H volume ∧
      (∀ x, 0 ≤ H x) ∧
      (∀ x, x ∉ Metric.closedBall (lacunaryCZDyadicCubeCenter q)
          (3 * lacunaryCZDyadicCubeRadius q) →
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r) atom x ≤ ENNReal.ofReal (H x)) ∧
      (∫ x : Euclidean d, H x) ≤
        lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
          (∫ y : Euclidean d, ‖atom y‖) := by
  classical
  have hdpos : 0 < d := by omega
  letI : NeZero d := ⟨Nat.ne_of_gt hdpos⟩
  have hdtwoNat : 2 ≤ d := by omega
  have hdtwo : (2 : ℝ) ≤ d := by exact_mod_cast hdtwoNat
  let Iminus : Finset (ℤ × Fin N) :=
    (K.product Finset.univ).filter fun z => z.1 ≤ q.scale
  let Iplus : Finset (ℤ × Fin N) :=
    (K.product Finset.univ).filter fun z => q.scale < z.1
  have ha_minus : ∀ z ∈ Iminus, 0 < dyadicPhysicalEntropyCellLeft δ r z := by
    intro z hz
    exact dyadicPhysicalEntropyCellLeft_pos δ r hr z
  have hab_minus : ∀ z ∈ Iminus,
      dyadicPhysicalEntropyCellLeft δ r z ≤ dyadicPhysicalEntropyCellRight δ r z := by
    intro z hz
    exact dyadicPhysicalEntropyCellLeft_le_right δ r hr z
  have ha_plus : ∀ z ∈ Iplus, 0 < dyadicPhysicalEntropyCellLeft δ r z := by
    intro z hz
    exact dyadicPhysicalEntropyCellLeft_pos δ r hr z
  have hab_plus : ∀ z ∈ Iplus,
      dyadicPhysicalEntropyCellLeft δ r z ≤ dyadicPhysicalEntropyCellRight δ r z := by
    intro z hz
    exact dyadicPhysicalEntropyCellLeft_le_right δ r hr z
  have hsmall : ∀ z ∈ Iminus,
      dyadicPhysicalEntropyCellRight δ r z ≤ lacunaryCZDyadicCubeRadius q := by
    intro z hz
    have hzq : z.1 ≤ q.scale := by
      exact (Finset.mem_filter.mp (show z ∈
        (K.product Finset.univ).filter fun w => w.1 ≤ q.scale by simpa only [Iminus] using hz)).2
    have hpow : (2 : ℝ) ^ z.1 ≤ (2 : ℝ) ^ q.scale := by
      apply zpow_le_zpow_right₀ (by norm_num)
      exact hzq
    calc
      dyadicPhysicalEntropyCellRight δ r z ≤ 2 * (2 : ℝ) ^ z.1 :=
        (dyadicPhysicalEntropyCell_endpoints_mem_block δ r hr z).2.2
      _ ≤ 2 * (2 : ℝ) ^ q.scale :=
        mul_le_mul_of_nonneg_left hpow (by norm_num)
      _ ≤ (d : ℝ) * (2 : ℝ) ^ q.scale :=
        mul_le_mul_of_nonneg_right hdtwo (zpow_nonneg (by norm_num) _)
      _ = lacunaryCZDyadicCubeRadius q := by rfl
  have hSq : ∑ z ∈ Iminus, (dyadicPhysicalEntropyCellRight δ r z) ^ 2 ≤
      (N : ℝ) * (16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2 := by
    simpa only [Iminus] using
      sum_dyadicPhysicalEntropyCellRight_sq_past_le K δ r hr q
  have hfuture : ∑ z ∈ Iplus,
      (dyadicPhysicalEntropyCellRight δ r z - dyadicPhysicalEntropyCellLeft δ r z) *
          (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2 ≤
        (N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
          ((2 : ℝ) ^ q.scale)⁻¹ := by
    simpa only [Iplus] using
      sum_dyadicPhysicalEntropyCell_length_mul_left_inv_sq_future_le
        K δ r hr q hδ
  rcases exists_integrable_lacunaryRelativeBandpassPhysicalCellOscillation_past_atom_majorant
    hdpos ψ j Iminus (dyadicPhysicalEntropyCellLeft δ r)
      (dyadicPhysicalEntropyCellRight δ r) ha_minus hab_minus
      (lacunaryCZDyadicCubeRadius_pos q) hsmall hSq
      (lacunaryCZDyadicCubeCenter q) atom hatom hatom_supp with
    ⟨Hp, hPint, hPnon, hPpoint, hPbound⟩
  rcases exists_integrable_lacunaryRelBpPhysicalCellOscillation_future_atom_majorant
    hdpos ψ j G hG Iplus (dyadicPhysicalEntropyCellLeft δ r)
      (dyadicPhysicalEntropyCellRight δ r) ha_plus hab_plus atom hatom hzero
      (lacunaryCZDyadicCubeRadius_pos q).le hatom_supp with
    ⟨Hf, hFint, hFnon, hFpoint, hFbound⟩
  let L : ℝ := ∫ y : Euclidean d, ‖atom y‖
  let P : ℝ := 2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
    SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) *
      ((N : ℝ) * (16 / 3 : ℝ)) * surfaceMass d *
        (surfaceMass d * (3 : ℝ) ^ d / (2 * (d : ℝ) ^ 2))
  let F : ℝ := (d : ℝ) * ((N : ℝ) *
    (2 * (8 * Real.log 2 * (δ : ℝ)))) *
      ∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖
  have hPbound' : (∫ x : Euclidean d, Hp x) ≤ P * L := by
    calc
      (∫ x : Euclidean d, Hp x) ≤
          (2 * (((2 : ℝ) ^ j)⁻¹ ^ 2 *
            SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ ψ)) *
            ((N : ℝ) * (16 / 3 : ℝ) * ((2 : ℝ) ^ q.scale) ^ 2) *
              surfaceMass d * (∫ y : Euclidean d, ‖atom y‖)) *
            (surfaceMass d * (3 : ℝ) ^ d /
              (2 * (lacunaryCZDyadicCubeRadius q) ^ 2)) := hPbound
      _ = P * L := by
        simpa only [P, L] using
          lacunaryRelativeBandpassPhysicalCellCZ_past_rhs_eq hdpos ψ j q L
  have hFbound' : (∫ x : Euclidean d, Hf x) ≤ F * L := by
    have hderivnon : 0 ≤ ∫ x : Euclidean d,
        ‖fderiv ℝ (G : Euclidean d → ℂ) x‖ :=
      integral_nonneg fun _ => norm_nonneg _
    have hLnon : 0 ≤ ∫ y : Euclidean d, ‖atom y‖ :=
      integral_nonneg fun _ => norm_nonneg _
    have hscale :
        lacunaryCZDyadicCubeRadius q *
            (∑ z ∈ Iplus,
              (dyadicPhysicalEntropyCellRight δ r z - dyadicPhysicalEntropyCellLeft δ r z) *
                (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2) ≤
          lacunaryCZDyadicCubeRadius q *
            ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
              ((2 : ℝ) ^ q.scale)⁻¹) :=
      mul_le_mul_of_nonneg_left hfuture (lacunaryCZDyadicCubeRadius_pos q).le
    have hscale' :
        (lacunaryCZDyadicCubeRadius q *
            (∑ z ∈ Iplus,
              (dyadicPhysicalEntropyCellRight δ r z - dyadicPhysicalEntropyCellLeft δ r z) *
                (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2)) *
            (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) ≤
          (lacunaryCZDyadicCubeRadius q *
            ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
              ((2 : ℝ) ^ q.scale)⁻¹)) *
            (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) :=
      mul_le_mul_of_nonneg_right hscale hderivnon
    calc
      (∫ x : Euclidean d, Hf x) ≤
          (lacunaryCZDyadicCubeRadius q *
              (∑ z ∈ Iplus,
                (dyadicPhysicalEntropyCellRight δ r z - dyadicPhysicalEntropyCellLeft δ r z) *
                  (dyadicPhysicalEntropyCellLeft δ r z)⁻¹ ^ 2) *
              (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖)) *
                (∫ y : Euclidean d, ‖atom y‖) := hFbound
      _ ≤
          lacunaryCZDyadicCubeRadius q *
              ((N : ℝ) * (2 * (8 * Real.log 2 * (δ : ℝ))) *
                ((2 : ℝ) ^ q.scale)⁻¹) *
              (∫ x : Euclidean d, ‖fderiv ℝ (G : Euclidean d → ℂ) x‖) *
                (∫ y : Euclidean d, ‖atom y‖) :=
        mul_le_mul_of_nonneg_right hscale' hLnon
      _ = F * L := by
        simpa only [F, L] using
          lacunaryRelativeBandpassPhysicalCellCZ_future_rhs_eq hdpos δ G q L
  refine ⟨fun x => Hp x + Hf x, hPint.add hFint, ?_, ?_, ?_⟩
  · intro x
    exact add_nonneg (hPnon x) (hFnon x)
  · intro x hx
    have hsplit := lacunaryRelativeBandpassPhysicalCellOscillation_dyadic_scale_split
      K ψ j (dyadicPhysicalEntropyCellLeft δ r)
      (dyadicPhysicalEntropyCellRight δ r) q atom x
    rw [hsplit]
    calc
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j Iminus
          (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r) atom x +
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j Iplus
          (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r) atom x ≤
          ENNReal.ofReal (Hp x) + ENNReal.ofReal (Hf x) :=
        add_le_add (hPpoint x hx) (hFpoint x)
      _ = ENNReal.ofReal (Hp x + Hf x) :=
        (ENNReal.ofReal_add (hPnon x) (hFnon x)).symm
  · calc
      (∫ x : Euclidean d, Hp x + Hf x) =
          (∫ x : Euclidean d, Hp x) + ∫ x : Euclidean d, Hf x :=
        integral_add hPint hFint
      _ ≤ P * L + F * L := add_le_add hPbound' hFbound'
      _ = (P + F) * L := by ring
      _ = lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G * L := by
        rfl

/-- Summing the per-atom exterior majorants over a finite C--Z stopping
family gives a measurable bad-tail majorant away from the exceptional triple
balls, with linear `L¹` mass. -/
theorem exists_integrable_lacunaryRelativeBandpassPhysicalCellCZ_bad_majorant
    {d N : Nat} (hd : 3 ≤ d) (K : Finset ℤ) (δ : ℝ≥0)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (r : Fin N → ℤ → PositiveRadius)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    (f : Euclidean d → ℂ) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (hf : Integrable f volume)
    (hdisj : (↑U : Set (LacunaryCZDyadicCubeIndex d)).PairwiseDisjoint
      lacunaryCZDyadicCube) :
    ∃ H : Euclidean d → ℝ, Integrable H volume ∧
      (∀ x, 0 ≤ H x) ∧
      (∀ x, x ∉ lacunaryCZDyadicCubeExceptionalTriple U →
        (∑ u ∈ U,
          lacunaryRelativeBandpassPhysicalCellOscillation ψ j
            (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
            (dyadicPhysicalEntropyCellRight δ r)
            (lacunaryCZDyadicCubeBadAtom f u) x) ≤ ENNReal.ofReal (H x)) ∧
      (∫ x : Euclidean d, H x) ≤
        2 * lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
          (∫ y : Euclidean d, ‖f y‖) := by
  classical
  have hdpos : 0 < d := by omega
  letI : NeZero d := ⟨Nat.ne_of_gt hdpos⟩
  have hatom (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U) :
      ∃ H : Euclidean d → ℝ, Integrable H volume ∧
        (∀ x, 0 ≤ H x) ∧
        (∀ x, x ∉ Metric.closedBall (lacunaryCZDyadicCubeCenter u)
            (3 * lacunaryCZDyadicCubeRadius u) →
          lacunaryRelativeBandpassPhysicalCellOscillation ψ j
            (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
            (dyadicPhysicalEntropyCellRight δ r)
            (lacunaryCZDyadicCubeBadAtom f u) x ≤ ENNReal.ofReal (H x)) ∧
        (∫ x : Euclidean d, H x) ≤
          lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
            (∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f u y‖) :=
    exists_integrable_lacunaryRelativeBandpassPhysicalCellCZ_atom_majorant
      hd K δ hδ r hr ψ j G hG u (lacunaryCZDyadicCubeBadAtom f u)
      (integrable_lacunaryCZDyadicCubeBadAtom f u hf)
      (integral_lacunaryCZDyadicCubeBadAtom_eq_zero f u hf)
      (fun y hy => lacunaryCZDyadicCubeBadAtom_dist_center_le_radius f u hy)
  choose H0 hHint0 hHnon0 hHpoint0 hHbound0 using hatom
  let H : LacunaryCZDyadicCubeIndex d → Euclidean d → ℝ := fun u =>
    if hu : u ∈ U then H0 u hu else fun _ => 0
  have hHint (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U) :
      Integrable (H u) volume := by
    simpa only [H, dif_pos hu] using hHint0 u hu
  have hHnon (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U)
      (x : Euclidean d) : 0 ≤ H u x := by
    simpa only [H, dif_pos hu] using hHnon0 u hu x
  have hHpoint (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U)
      (x : Euclidean d)
      (hx : x ∉ Metric.closedBall (lacunaryCZDyadicCubeCenter u)
          (3 * lacunaryCZDyadicCubeRadius u)) :
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r)
          (lacunaryCZDyadicCubeBadAtom f u) x ≤ ENNReal.ofReal (H u x) := by
    simpa only [H, dif_pos hu] using hHpoint0 u hu x hx
  have hHbound (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U) :
      (∫ x : Euclidean d, H u x) ≤
        lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
          (∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f u y‖) := by
    simpa only [H, dif_pos hu] using hHbound0 u hu
  let HT : Euclidean d → ℝ := fun x => ∑ u ∈ U, H u x
  have hHTint : Integrable HT volume := by
    dsimp only [HT]
    exact integrable_finsetSum U fun u hu => hHint u hu
  have hHTnon (x : Euclidean d) : 0 ≤ HT x := by
    dsimp only [HT]
    exact Finset.sum_nonneg fun u hu => hHnon u hu x
  have hHTpoint (x : Euclidean d)
      (hx : x ∉ lacunaryCZDyadicCubeExceptionalTriple U) :
      (∑ u ∈ U,
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r)
          (lacunaryCZDyadicCubeBadAtom f u) x) ≤ ENNReal.ofReal (HT x) := by
    have hout (u : LacunaryCZDyadicCubeIndex d) (hu : u ∈ U) :
        x ∉ Metric.closedBall (lacunaryCZDyadicCubeCenter u)
          (3 * lacunaryCZDyadicCubeRadius u) := by
      intro hball
      apply hx
      exact Set.mem_iUnion₂.mpr ⟨u, hu, hball⟩
    calc
      (∑ u ∈ U,
        lacunaryRelativeBandpassPhysicalCellOscillation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r)
          (lacunaryCZDyadicCubeBadAtom f u) x) ≤
          ∑ u ∈ U, ENNReal.ofReal (H u x) :=
        Finset.sum_le_sum fun u hu => hHpoint u hu x (hout u hu)
      _ = ENNReal.ofReal (HT x) := by
        rw [← ENNReal.ofReal_sum_of_nonneg fun u hu => hHnon u hu x]
  refine ⟨HT, hHTint, hHTnon, hHTpoint, ?_⟩
  have hbad :
      (∑ u ∈ U, ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f u y‖) ≤
        2 * ∫ y : Euclidean d, ‖f y‖ :=
    sum_integral_norm_lacunaryCZDyadicCubeBadAtom_le_two_mul_integral_norm
      f U hdisj hf
  have htailnon :=
    lacunaryRelativeBandpassPhysicalCellCZTailConstant_nonneg N ψ j δ G
  calc
    (∫ x : Euclidean d, HT x) = ∑ u ∈ U, ∫ x : Euclidean d, H u x := by
      dsimp only [HT]
      rw [integral_finsetSum U fun u hu => hHint u hu]
    _ ≤ ∑ u ∈ U,
        lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
          (∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f u y‖) :=
      Finset.sum_le_sum fun u hu => hHbound u hu
    _ = lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
        (∑ u ∈ U, ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f u y‖) := by
      rw [Finset.mul_sum]
    _ ≤ lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G *
        (2 * ∫ y : Euclidean d, ‖f y‖) :=
      mul_le_mul_of_nonneg_left hbad htailnon
    _ = _ := by ring

/-- The literal physical cell oscillation respects the finite dyadic-cube
Calderón--Zygmund decomposition.  The palette term is deliberately not
split here: it is estimated directly on the original Schwartz input. -/
theorem lacunaryRelativeBandpassPhysicalCellOscillation_le_CZGood_add_badAtoms
    {d : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q)
    (f : Euclidean d → ℂ) (hf : Integrable f volume)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b f x ≤
      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b
          (lacunaryCZDyadicCubeGoodPart f U) x +
        ∑ u ∈ U,
          lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b
            (lacunaryCZDyadicCubeBadAtom f u) x := by
  classical
  have hdecomp (r : ℝ) (hr : 0 < r) :
      lacunaryRelativeBandpassPhysicalTerm ψ j r f x =
        lacunaryRelativeBandpassPhysicalTerm ψ j r
            (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U,
            lacunaryRelativeBandpassPhysicalTerm ψ j r
              (lacunaryCZDyadicCubeBadAtom f u) x := by
    simpa only [lacunaryRelativeBandpassPhysicalTerm] using
      lacunaryCZDyadicCube_kernel_integral_decomposition
        (lacunaryRelativeBandpassPhysicalKernel ψ j r)
        (continuous_lacunaryRelativeBandpassPhysicalKernel ψ j hr)
        (norm_lacunaryRelativeBandpassPhysicalKernel_le ψ j hr)
        f hf U x
  have hdiff (q : ι) (hq : q ∈ I) (t : Icc (a q) (b q)) :
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ≤
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ +
          ∑ u ∈ U,
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖ := by
    have ht : 0 < t.1 := lt_of_lt_of_le (ha q hq) t.2.1
    rw [hdecomp t.1 ht, hdecomp (a q) (ha q hq)]
    calc
      ‖(lacunaryRelativeBandpassPhysicalTerm ψ j t.1
          (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U, lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeBadAtom f u) x) -
          (lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U, lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeBadAtom f u) x)‖ =
          ‖(lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x) +
            ∑ u ∈ U,
              (lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x)‖ := by
            congr 1
            rw [Finset.sum_sub_distrib]
            ring
      _ ≤ ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ +
          ‖∑ u ∈ U,
            (lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeBadAtom f u) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeBadAtom f u) x)‖ := norm_add_le _ _
      _ ≤ _ := add_le_add_right
        (norm_sum_le U fun u =>
          lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeBadAtom f u) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeBadAtom f u) x) _
  have hcell (q : ι) (hq : q ∈ I) :
      (⨆ t : Icc (a q) (b q), ENNReal.ofReal
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖) ≤
        (⨆ t : Icc (a q) (b q), ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x‖) +
          ∑ u ∈ U, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖ := by
    apply iSup_le
    intro t
    calc
      ENNReal.ofReal ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ≤
          ENNReal.ofReal
            (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeGoodPart f U) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeGoodPart f U) x‖ +
              ∑ u ∈ U,
                ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                    (lacunaryCZDyadicCubeBadAtom f u) x -
                  lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                    (lacunaryCZDyadicCubeBadAtom f u) x‖) :=
        ENNReal.ofReal_le_ofReal (hdiff q hq t)
      _ = ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeGoodPart f U) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeGoodPart f U) x‖ +
            ∑ u ∈ U, ENNReal.ofReal
              ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                  (lacunaryCZDyadicCubeBadAtom f u) x -
                lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                  (lacunaryCZDyadicCubeBadAtom f u) x‖ := by
          rw [ENNReal.ofReal_add (norm_nonneg _)
            (Finset.sum_nonneg fun _ _ => norm_nonneg _),
            ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _]
      _ ≤ _ := add_le_add
        (le_iSup (fun z : Icc (a q) (b q) => ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j z.1
              (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x‖) t)
        (Finset.sum_le_sum fun u hu =>
          le_iSup (fun z : Icc (a q) (b q) => ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j z.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖) t)
  unfold lacunaryRelativeBandpassPhysicalCellOscillation
  calc
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖) ≤
        ∑ q ∈ I,
          ((⨆ t : Icc (a q) (b q), ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeGoodPart f U) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeGoodPart f U) x‖) +
            ∑ u ∈ U, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
              ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                  (lacunaryCZDyadicCubeBadAtom f u) x -
                lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                  (lacunaryCZDyadicCubeBadAtom f u) x‖) :=
      Finset.sum_le_sum fun q hq => hcell q hq
    _ = _ := by
      rw [Finset.sum_add_distrib, Finset.sum_comm]

private theorem ennreal_add_sq_le_two_mul_sq_add_sq (A B : ENNReal) :
    (A + B) ^ 2 ≤ 2 * (A ^ 2 + B ^ 2) := by
  have h := ENNReal.rpow_add_le_mul_rpow_add_rpow A B (p := (2 : ℝ))
    (by norm_num)
  norm_num at h ⊢
  simpa using h

/-- At square level the literal physical cells split into the `L²` good
part and the square of the finite sum of bad atom oscillations.  Keeping
the square variation on the good side is what lets the sharp cell estimate
enter the Calderón--Zygmund argument without replacing the interval
suprema by a countable proxy. -/
theorem lacunaryRelBpPhysCellSquareVariation_le_two_mul_CZGood_add_badOscillation_sq
    {d : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {ι : Type*} (I : Finset ι) (a b : ι → ℝ)
    (ha : ∀ q ∈ I, 0 < a q) (hab : ∀ q ∈ I, a q ≤ b q)
    (f : Euclidean d → ℂ) (hf : Integrable f volume)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j I a b f x ≤
      2 * lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j I a b
          (lacunaryCZDyadicCubeGoodPart f U) x +
        2 * (∑ u ∈ U,
          lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b
            (lacunaryCZDyadicCubeBadAtom f u) x) ^ 2 := by
  classical
  let A : ι → ENNReal := fun q =>
    ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
          (lacunaryCZDyadicCubeGoodPart f U) x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
          (lacunaryCZDyadicCubeGoodPart f U) x‖
  let B : ι → ENNReal := fun q => ∑ u ∈ U,
    ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
          (lacunaryCZDyadicCubeBadAtom f u) x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
          (lacunaryCZDyadicCubeBadAtom f u) x‖
  let BT : ENNReal := ∑ u ∈ U,
    lacunaryRelativeBandpassPhysicalCellOscillation ψ j I a b
      (lacunaryCZDyadicCubeBadAtom f u) x
  have hdecomp (r : ℝ) (hr : 0 < r) :
      lacunaryRelativeBandpassPhysicalTerm ψ j r f x =
        lacunaryRelativeBandpassPhysicalTerm ψ j r
            (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U,
            lacunaryRelativeBandpassPhysicalTerm ψ j r
              (lacunaryCZDyadicCubeBadAtom f u) x := by
    simpa only [lacunaryRelativeBandpassPhysicalTerm] using
      lacunaryCZDyadicCube_kernel_integral_decomposition
        (lacunaryRelativeBandpassPhysicalKernel ψ j r)
        (continuous_lacunaryRelativeBandpassPhysicalKernel ψ j hr)
        (norm_lacunaryRelativeBandpassPhysicalKernel_le ψ j hr)
        f hf U x
  have hdiff (q : ι) (hq : q ∈ I) (t : Icc (a q) (b q)) :
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ≤
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ +
          ∑ u ∈ U,
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖ := by
    have ht : 0 < t.1 := lt_of_lt_of_le (ha q hq) t.2.1
    rw [hdecomp t.1 ht, hdecomp (a q) (ha q hq)]
    calc
      ‖(lacunaryRelativeBandpassPhysicalTerm ψ j t.1
          (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U, lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeBadAtom f u) x) -
          (lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x +
          ∑ u ∈ U, lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeBadAtom f u) x)‖ =
          ‖(lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x) +
            ∑ u ∈ U,
              (lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x)‖ := by
            congr 1
            rw [Finset.sum_sub_distrib]
            ring
      _ ≤ ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ +
          ‖∑ u ∈ U,
            (lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeBadAtom f u) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeBadAtom f u) x)‖ := norm_add_le _ _
      _ ≤ _ := add_le_add_right
        (norm_sum_le U fun u =>
          lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeBadAtom f u) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeBadAtom f u) x) _
  have hpoint (q : ι) (hq : q ∈ I) (t : Icc (a q) (b q)) :
      ENNReal.ofReal
        ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ≤ A q + B q := by
    calc
      ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ≤
          ENNReal.ofReal
            (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeGoodPart f U) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeGoodPart f U) x‖ +
              ∑ u ∈ U,
                ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                    (lacunaryCZDyadicCubeBadAtom f u) x -
                  lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                    (lacunaryCZDyadicCubeBadAtom f u) x‖) :=
        ENNReal.ofReal_le_ofReal (hdiff q hq t)
      _ = ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeGoodPart f U) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeGoodPart f U) x‖ +
          ∑ u ∈ U, ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖ := by
          rw [ENNReal.ofReal_add (norm_nonneg _)
            (Finset.sum_nonneg fun _ _ => norm_nonneg _),
            ENNReal.ofReal_sum_of_nonneg fun _ _ => norm_nonneg _]
      _ ≤ _ := add_le_add
        (le_iSup (fun z : Icc (a q) (b q) => ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j z.1
              (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x‖) t)
        (Finset.sum_le_sum fun u hu =>
          le_iSup (fun z : Icc (a q) (b q) => ENNReal.ofReal
            ‖lacunaryRelativeBandpassPhysicalTerm ψ j z.1
                (lacunaryCZDyadicCubeBadAtom f u) x -
              lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
                (lacunaryCZDyadicCubeBadAtom f u) x‖) t)
  have hAcell (q : ι) (hq : q ∈ I) :
      (⨆ t : Icc (a q) (b q), ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ ^ 2)) = (A q) ^ 2 := by
    letI : Nonempty (Icc (a q) (b q)) := ⟨⟨a q, le_rfl, hab q hq⟩⟩
    change (⨆ t : Icc (a q) (b q), ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
          (lacunaryCZDyadicCubeGoodPart f U) x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
          (lacunaryCZDyadicCubeGoodPart f U) x‖ ^ 2)) = _
    rw [show (fun t : Icc (a q) (b q) => ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ ^ 2)) =
        fun t => (ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
              (lacunaryCZDyadicCubeGoodPart f U) x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
              (lacunaryCZDyadicCubeGoodPart f U) x‖) ^ 2 by
      funext t
      rw [ENNReal.ofReal_pow (norm_nonneg _)]]
    rw [← ENNReal.iSup_pow]
  have hBsum : (∑ q ∈ I, B q) = BT := by
    dsimp only [B, BT, lacunaryRelativeBandpassPhysicalCellOscillation]
    rw [Finset.sum_comm]
  have hBq (q : ι) (hq : q ∈ I) : B q ≤ BT := by
    calc
      B q ≤ ∑ z ∈ I, B z :=
        Finset.single_le_sum (fun _ _ => bot_le) hq
      _ = BT := hBsum
  have hBsq : (∑ q ∈ I, (B q) ^ 2) ≤ BT ^ 2 := by
    calc
      (∑ q ∈ I, (B q) ^ 2) ≤ ∑ q ∈ I, B q * BT :=
        Finset.sum_le_sum fun q hq => by
          rw [pow_two]
          simpa only [mul_comm] using mul_le_mul_left (hBq q hq) (B q)
      _ = (∑ q ∈ I, B q) * BT := by rw [Finset.sum_mul]
      _ = BT ^ 2 := by rw [hBsum, pow_two]
  have hcell (q : ι) (hq : q ∈ I) :
      (⨆ t : Icc (a q) (b q), ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ^ 2)) ≤
        2 * ((A q) ^ 2 + (B q) ^ 2) := by
    apply iSup_le
    intro t
    rw [ENNReal.ofReal_pow (norm_nonneg _)]
    calc
      (ENNReal.ofReal
          ‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
            lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖) ^ 2 ≤
          (A q + B q) ^ 2 :=
        pow_le_pow_left' (hpoint q hq t) 2
      _ ≤ 2 * ((A q) ^ 2 + (B q) ^ 2) :=
        ennreal_add_sq_le_two_mul_sq_add_sq _ _
  have hAsum : (∑ q ∈ I, (A q) ^ 2) =
      ∑ q ∈ I, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
        (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1
            (lacunaryCZDyadicCubeGoodPart f U) x -
          lacunaryRelativeBandpassPhysicalTerm ψ j (a q)
            (lacunaryCZDyadicCubeGoodPart f U) x‖ ^ 2) := by
    apply Finset.sum_congr rfl
    intro q hq
    exact (hAcell q hq).symm
  unfold lacunaryRelativeBandpassPhysicalCellSquareVariation
    lacunaryRelativeBandpassPhysicalCellOscillation
  change (∑ q ∈ I, _) ≤ 2 * (∑ q ∈ I, _) + 2 * BT ^ 2
  calc
    (∑ q ∈ I, ⨆ t : Icc (a q) (b q), ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm ψ j t.1 f x -
        lacunaryRelativeBandpassPhysicalTerm ψ j (a q) f x‖ ^ 2)) ≤
        ∑ q ∈ I, 2 * ((A q) ^ 2 + (B q) ^ 2) :=
      Finset.sum_le_sum fun q hq => hcell q hq
    _ = 2 * (∑ q ∈ I, (A q) ^ 2) + 2 * (∑ q ∈ I, (B q) ^ 2) := by
      calc
        (∑ q ∈ I, 2 * ((A q) ^ 2 + (B q) ^ 2)) =
            ∑ q ∈ I, (2 * (A q) ^ 2 + 2 * (B q) ^ 2) := by
              apply Finset.sum_congr rfl
              intro q hq
              ring
        _ = (∑ q ∈ I, 2 * (A q) ^ 2) +
            ∑ q ∈ I, 2 * (B q) ^ 2 := by
              rw [Finset.sum_add_distrib]
        _ = _ := by
              rw [← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 2 * (∑ q ∈ I, (A q) ^ 2) + 2 * BT ^ 2 := by
      apply add_le_add (le_refl _)
      simpa only [mul_comm] using mul_le_mul_right hBsq 2
    _ = _ := by
      rw [hAsum]

/-- A selected physical radius is bounded by the square of its all-scale
selector maximum.  This is the selector endpoint used in the continuum
Calderón--Zygmund comparison. -/
theorem ennreal_ofReal_norm_sq_lacunaryRelativeBandpassPhysicalTerm_le_physicalMaximalAll_sq
    {d : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (g : Euclidean d → ℂ) (k : ℤ)
    (x : Euclidean d) :
    ENNReal.ofReal
      (‖lacunaryRelativeBandpassPhysicalTerm ψ j (r k : ℝ) g x‖ ^ 2) ≤
        (lacunaryRelativeBandpassPhysicalMaximalAll ψ j r g x) ^ 2 := by
  rw [ENNReal.ofReal_pow (norm_nonneg _)]
  exact pow_le_pow_left'
    (le_iSup (fun l : ℤ => ENNReal.ofReal
      ‖lacunaryRelativeBandpassPhysicalTerm ψ j (r l : ℝ) g x‖) k) 2

/-- Squaring commutes with taking the finite selector palette upper bound in
the direction needed for the physical cell comparison. -/
theorem iSup_lacunaryRelativeBandpassPhysicalMaximalAll_sq_le_palette_sq
    {d N : Nat} (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : Fin N → ℤ → PositiveRadius) (g : Euclidean d → ℂ)
    (x : Euclidean d) :
    (⨆ i : Fin N,
      (lacunaryRelativeBandpassPhysicalMaximalAll ψ j (r i) g x) ^ 2) ≤
        (lacunaryRelativeBandpassPhysicalPaletteMaximalAll ψ j r g x) ^ 2 := by
  apply iSup_le
  intro i
  apply pow_le_pow_left'
  exact le_iSup (fun l : Fin N =>
    lacunaryRelativeBandpassPhysicalMaximalAll ψ j (r l) g x) i

/- The good part of the Calderón--Zygmund decomposition is controlled by an
almost-everywhere measurable majorant.  This small Markov wrapper keeps the
literal (and hence not a priori measurable) cell supremum on the left. -/
theorem mul_measure_cell_level_le_lintegral_of_ae_majorant
    {d : Nat} (V M : Euclidean d → ENNReal)
    (hM : AEMeasurable M volume)
    (hpoint : ∀ᵐ x ∂volume, V x ≤ M x) (a : ENNReal) :
    a * volume {x | a < V x} ≤ ∫⁻ x, M x := by
  have hset : {x | a < V x} ≤ᵐ[volume] {x | a ≤ M x} := by
    filter_upwards [hpoint] with x hx hlevel
    exact hlevel.le.trans hx
  calc
    a * volume {x | a < V x} ≤ a * volume {x | a ≤ M x} :=
      mul_le_mul_right (measure_mono_ae hset) _
    _ ≤ ∫⁻ x, M x := mul_meas_ge_le_lintegral₀ hM a

theorem memLp_two_of_integrable_of_norm_le_cell
    {d : Nat} (g : Euclidean d → ℂ) (hg : Integrable g volume)
    (B : ℝ) (_hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B) : MemLp g 2 volume := by
  apply (memLp_two_iff_integrable_sq_norm hg.aestronglyMeasurable).2
  refine (hg.norm.const_mul B).mono' ?_ (Filter.Eventually.of_forall fun x => ?_)
  · exact hg.aestronglyMeasurable.norm.pow 2
  · have hpoint : ‖g x‖ ^ (2 : ℕ) ≤ B * ‖g x‖ := by
      calc
        ‖g x‖ ^ (2 : ℕ) = ‖g x‖ * ‖g x‖ := by ring
        _ ≤ B * ‖g x‖ := mul_le_mul_of_nonneg_right (hgB x) (norm_nonneg _)
    simpa [Real.norm_eq_abs] using hpoint

theorem measure_le_of_real_bound_cell
    {α : Type*} [MeasurableSpace α] (μ : Measure α) (E : Set α)
    {K : ℝ} (hEtop : μ E ≠ ∞) (hK : 0 ≤ K)
    (h : μ.real E ≤ K) : μ E ≤ ENNReal.ofReal K := by
  apply (ENNReal.toReal_le_toReal hEtop ENNReal.ofReal_ne_top).mp
  simpa only [Measure.real, ENNReal.toReal_ofReal hK] using h

theorem exceptional_lt_top_cell
    {d : Nat} [NeZero d] (U : Finset (LacunaryCZDyadicCubeIndex d)) :
    volume (lacunaryCZDyadicCubeExceptionalTriple U) < ∞ := by
  let B : LacunaryCZDyadicCubeIndex d → Set (Euclidean d) := fun q =>
    Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q)
  have hmeasure : volume (lacunaryCZDyadicCubeExceptionalTriple U) ≤
      ∑ q ∈ U, volume (B q) := by
    simpa only [lacunaryCZDyadicCubeExceptionalTriple, B] using
      (measure_biUnion_finset_le (μ := volume) U B)
  have hsumlt : (∑ q ∈ U, volume (B q)) < ∞ :=
    ENNReal.sum_lt_top.mpr fun q hq => measure_closedBall_lt_top
  exact lt_of_le_of_lt hmeasure hsumlt

theorem weak_square_level_scaled_eight
    {b A C F G : ENNReal} (hb : b ≠ 0) (hbtop : b ≠ ∞)
    (h : b ^ (2 : ℕ) * G ≤ C ^ (2 : ℕ) * ((4 * A) * b * F)) :
    (8 * b) * G ≤ (32 * A * C ^ (2 : ℕ)) * F := by
  rw [← ENNReal.mul_le_mul_iff_right hb hbtop]
  calc
    b * ((8 * b) * G) = 8 * (b ^ (2 : ℕ) * G) := by ring
    _ ≤ 8 * (C ^ (2 : ℕ) * ((4 * A) * b * F)) :=
      mul_le_mul_right h _
    _ = b * ((32 * A * C ^ (2 : ℕ)) * F) := by ring

/-- The three contributions in the literal cell weak estimate: the C--Z
exceptional cubes, the measurable `L²` majorant of the good cells, and the
exterior FTOC majorant of the bad cells. -/
def lacunaryRelativeBandpassPhysicalCellWeakOneConstant {d N : Nat}
    (ψ : SchwartzMap (Euclidean d) ℂ) (j : Nat) (δ : ℝ≥0)
    (G : SchwartzMap (Euclidean d) ℂ) (C : ℝ) : ENNReal :=
  2 * ENNReal.ofReal
      ((volume (Metric.ball (0 : Euclidean d) 1)).toReal *
        (3 : ℝ) ^ d * (d : ℝ) ^ d) +
    (32 * ENNReal.ofReal (3 * (2 : ℝ) ^ d) * (ENNReal.ofReal C) ^ (2 : ℕ)) +
      16 * ENNReal.ofReal
        (lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G)

/-- A finite family of literal physical entropy cells satisfies the
Calderón--Zygmund weak estimate as soon as its Schwartz `L²` cell bound is
available.  The good part is handled through the liminf majorant, so no
countable replacement of an interval supremum occurs. -/
theorem weak_one_lacunaryRelativeBandpassPhysicalCellSquareVariation_of_schwartz_core
    {d N : Nat} (hd : 3 ≤ d) (K : Finset ℤ) (δ : ℝ≥0)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (r : Fin N → ℤ → PositiveRadius)
    (hr : ∀ i, IsDyadicLacunaryRadiusSelector (r i))
    (ψ : SchwartzMap (Euclidean d) ℂ)
    (hψCompact : HasCompactSupport (ψ : Euclidean d → ℂ)) (j : Nat)
    (G : SchwartzMap (Euclidean d) ℂ)
    (hG : ∀ z : Euclidean d,
      G z = lacunaryRelativeBandpassPhysicalKernelRadiusGenerator ψ j z)
    (C : ℝ)
    (hcore : ∀ g : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j
        (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
        (dyadicPhysicalEntropyCellRight δ r) (g : Euclidean d → ℂ) x) ≤
          (ENNReal.ofReal C) ^ 2 *
            ∫⁻ x, ENNReal.ofReal (‖(g : Euclidean d → ℂ) x‖ ^ 2))
    (f : SchwartzMap (Euclidean d) ℂ) {lambda : ℝ} (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x |
      4 * (ENNReal.ofReal (lambda / 8)) ^ 2 <
        lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j
          (K.product Finset.univ) (dyadicPhysicalEntropyCellLeft δ r)
          (dyadicPhysicalEntropyCellRight δ r) (f : Euclidean d → ℂ) x} ≤
      lacunaryRelativeBandpassPhysicalCellWeakOneConstant (N := N) ψ j δ G C *
        ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → ℂ) x‖ := by
  classical
  have hdpos : 0 < d := by omega
  letI : NeZero d := ⟨Nat.ne_of_gt hdpos⟩
  let I : Finset (ℤ × Fin N) := K.product Finset.univ
  let aCell : ℤ × Fin N → ℝ := dyadicPhysicalEntropyCellLeft δ r
  let bCell : ℤ × Fin N → ℝ := dyadicPhysicalEntropyCellRight δ r
  let V : (Euclidean d → ℂ) → Euclidean d → ENNReal :=
    lacunaryRelativeBandpassPhysicalCellSquareVariation ψ j I aCell bCell
  have haCell (q : ℤ × Fin N) (hq : q ∈ I) : 0 < aCell q := by
    dsimp only [aCell]
    exact dyadicPhysicalEntropyCellLeft_pos δ r hr q
  have habCell (q : ℤ × Fin N) (hq : q ∈ I) : aCell q ≤ bCell q := by
    dsimp only [aCell, bCell]
    exact dyadicPhysicalEntropyCellLeft_le_right δ r hr q
  obtain ⟨U, hdisj, hbad, houtside, havg, hgoodBound, hatomInt, hzero,
    hsupp, hsum, hgoodInt, hgoodL2, hbadL1, hscale, hradius⟩ :=
    exists_lacunaryCZDyadicCube_continuous_decay_decomposition
      (f : Euclidean d → ℂ) lambda hlambda f.continuous f.integrable
      f.tendsto_cocompact
  let g : Euclidean d → ℂ := lacunaryCZDyadicCubeGoodPart (f : Euclidean d → ℂ) U
  let E : Set (Euclidean d) := lacunaryCZDyadicCubeExceptionalTriple U
  let a₀ : ENNReal := ENNReal.ofReal (lambda / 2)
  let b : ENNReal := ENNReal.ofReal (lambda / 8)
  let A : ENNReal := ENNReal.ofReal (3 * (2 : ℝ) ^ d)
  let F : ENNReal := ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → ℂ) x‖
  let T : ℝ := lacunaryRelativeBandpassPhysicalCellCZTailConstant N ψ j δ G
  have ha₀pos : 0 < a₀ := by
    dsimp only [a₀]
    exact ENNReal.ofReal_pos.mpr (by linarith)
  have ha₀ : a₀ ≠ 0 := ha₀pos.ne'
  have ha₀top : a₀ ≠ ∞ := by
    dsimp only [a₀]
    exact ENNReal.ofReal_ne_top
  have hbpos : 0 < b := by
    dsimp only [b]
    exact ENNReal.ofReal_pos.mpr (by linarith)
  have hb : b ≠ 0 := hbpos.ne'
  have hbtop : b ≠ ∞ := by
    dsimp only [b]
    exact ENNReal.ofReal_ne_top
  have haeq : ENNReal.ofReal lambda = 8 * b := by
    dsimp only [b]
    rw [show lambda = 8 * (lambda / 8) by ring,
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 8)]
    norm_num
  have ha₀eq : a₀ = 4 * b := by
    dsimp only [a₀, b]
    rw [show lambda / 2 = 4 * (lambda / 8) by ring,
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
    norm_num
  have hB : 0 ≤ (2 : ℝ) ^ d * (lambda / 2) := by positivity
  have hgB : ∀ x, ‖g x‖ ≤ (2 : ℝ) ^ d * (lambda / 2) := by
    intro x
    simpa only [g] using hgoodBound x
  have hg2 : MemLp g 2 volume :=
    memLp_two_of_integrable_of_norm_le_cell g
      (by simpa only [g] using hgoodInt) _ hB hgB
  obtain ⟨M, hMmeas, hMpoint, hMbound⟩ :=
    exists_aemeasurable_lacRelBpPhysCellSquareVariation_majorant_of_schwartz_core
      hdpos ψ hψCompact j I aCell bCell haCell habCell C
      (by
        intro u
        simpa only [V, I, aCell, bCell] using hcore u)
      g hg2
  obtain ⟨H, hHint, hHnon, hHpoint, hHbound⟩ :=
    exists_integrable_lacunaryRelativeBandpassPhysicalCellCZ_bad_majorant
      hd K δ hδ r hr ψ j G hG (f : Euclidean d → ℂ) U f.integrable hdisj
  have hlevel :
      ({x : Euclidean d | 4 * b ^ 2 < V (f : Euclidean d → ℂ) x} :
        Set (Euclidean d)) ≤ᵐ[volume]
        Set.union E (Set.union
          ({x : Euclidean d | b ^ 2 < M x} : Set (Euclidean d))
          (Set.inter ({x : Euclidean d | b < ENNReal.ofReal (H x)} : Set (Euclidean d)) Eᶜ)) := by
    filter_upwards [hMpoint] with x hxM hx
    by_cases hxE : x ∈ E
    · exact Or.inl hxE
    · by_cases hxGood : b ^ 2 < M x
      · exact Or.inr (Or.inl hxGood)
      · by_cases hxBad : b < ENNReal.ofReal (H x)
        · exact Or.inr (Or.inr ⟨hxBad, hxE⟩)
        · exfalso
          have hsplit :=
            lacunaryRelBpPhysCellSquareVariation_le_two_mul_CZGood_add_badOscillation_sq
              ψ j I aCell bCell haCell habCell (f : Euclidean d → ℂ)
                f.integrable U x
          have hbadpoint := hHpoint x hxE
          have hbadSq :
              (∑ u ∈ U,
                lacunaryRelativeBandpassPhysicalCellOscillation ψ j I aCell bCell
                  (lacunaryCZDyadicCubeBadAtom (f : Euclidean d → ℂ) u) x) ^ 2 ≤
                (ENNReal.ofReal (H x)) ^ 2 :=
            pow_le_pow_left' hbadpoint 2
          have hbound : V (f : Euclidean d → ℂ) x ≤ 4 * b ^ 2 := by
            calc
              V (f : Euclidean d → ℂ) x ≤
                  2 * V g x +
                    2 * (∑ u ∈ U,
                      lacunaryRelativeBandpassPhysicalCellOscillation ψ j I aCell bCell
                        (lacunaryCZDyadicCubeBadAtom (f : Euclidean d → ℂ) u) x) ^ 2 := by
                  simpa only [V] using hsplit
              _ ≤ 2 * M x + 2 * (ENNReal.ofReal (H x)) ^ 2 :=
                add_le_add
                  (by simpa only [mul_comm] using mul_le_mul_left hxM 2)
                  (by simpa only [mul_comm] using mul_le_mul_left hbadSq 2)
              _ ≤ 2 * b ^ 2 + 2 * b ^ 2 :=
                add_le_add
                  (by simpa only [mul_comm] using
                    mul_le_mul_left (le_of_not_gt hxGood) 2)
                  (by simpa only [mul_comm] using
                    mul_le_mul_left (pow_le_pow_left' (le_of_not_gt hxBad) 2) 2)
              _ = 4 * b ^ 2 := by ring
          exact (not_lt_of_ge hbound hx)
  have hgSq : Integrable (fun x => ‖g x‖ ^ (2 : ℕ)) volume := by
    simpa using hg2.integrable_norm_rpow (by norm_num) ENNReal.ofNat_ne_top
  have hFreal : ENNReal.ofReal (∫ x, ‖(f : Euclidean d → ℂ) x‖) = F := by
    dsimp only [F]
    exact ofReal_integral_eq_lintegral_ofReal f.integrable.norm
      (Filter.Eventually.of_forall fun x => norm_nonneg _)
  have hgoodLin :
      (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) ≤ A * a₀ * F := by
    calc
      (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ))) =
          ENNReal.ofReal (∫ x, ‖g x‖ ^ (2 : ℕ)) :=
        (ofReal_integral_eq_lintegral_ofReal hgSq
          (Filter.Eventually.of_forall fun x => sq_nonneg _)).symm
      _ ≤ ENNReal.ofReal
          ((3 * ((2 : ℝ) ^ d * (lambda / 2))) *
            ∫ x, ‖(f : Euclidean d → ℂ) x‖) :=
        ENNReal.ofReal_le_ofReal (by simpa only [g] using hgoodL2)
      _ = A * a₀ * F := by
        have hAreal : 0 ≤ 3 * (2 : ℝ) ^ d := by positivity
        rw [show 3 * ((2 : ℝ) ^ d * (lambda / 2)) =
              (3 * (2 : ℝ) ^ d) * (lambda / 2) by ring,
          ENNReal.ofReal_mul (mul_nonneg hAreal (by linarith)),
          ENNReal.ofReal_mul hAreal, hFreal]
  have hgoodMarkov :
      b ^ 2 * volume {x | b ^ 2 < M x} ≤ ∫⁻ x, M x :=
    mul_measure_cell_level_le_lintegral_of_ae_majorant M M hMmeas
      (Filter.Eventually.of_forall fun x => le_rfl) (b ^ 2)
  have hgoodSq :
      b ^ 2 * volume {x | b ^ 2 < M x} ≤
        (ENNReal.ofReal C) ^ 2 * ((4 * A) * b * F) := by
    calc
      b ^ 2 * volume {x | b ^ 2 < M x} ≤ ∫⁻ x, M x := hgoodMarkov
      _ ≤ (ENNReal.ofReal C) ^ 2 *
          ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ 2) := hMbound
      _ ≤ (ENNReal.ofReal C) ^ 2 * (A * a₀ * F) :=
        by simpa only [mul_comm] using
          mul_le_mul_left hgoodLin ((ENNReal.ofReal C) ^ 2)
      _ = (ENNReal.ofReal C) ^ 2 * ((4 * A) * b * F) := by
        rw [ha₀eq]
        ring
  have hgoodScaled :
      (8 * b) * volume {x | b ^ 2 < M x} ≤
        (32 * A * (ENNReal.ofReal C) ^ 2) * F :=
    weak_square_level_scaled_eight hb hbtop hgoodSq
  have hTnon : 0 ≤ T := by
    dsimp only [T]
    exact lacunaryRelativeBandpassPhysicalCellCZTailConstant_nonneg N ψ j δ G
  have hHlintegral :
      (∫⁻ x, ENNReal.ofReal (H x)) ≤ ENNReal.ofReal (2 * T) * F := by
    calc
      (∫⁻ x, ENNReal.ofReal (H x)) = ENNReal.ofReal (∫ x, H x) :=
        (ofReal_integral_eq_lintegral_ofReal hHint
          (Filter.Eventually.of_forall fun x => hHnon x)).symm
      _ ≤ ENNReal.ofReal (2 * T * ∫ x, ‖(f : Euclidean d → ℂ) x‖) :=
        ENNReal.ofReal_le_ofReal (by simpa only [T] using hHbound)
      _ = ENNReal.ofReal (2 * T) * F := by
        rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * T), hFreal]
  have hbadMarkov :
      b * volume {x | b < ENNReal.ofReal (H x)} ≤
        ∫⁻ x, ENNReal.ofReal (H x) :=
    mul_measure_cell_level_le_lintegral_of_ae_majorant
      (fun x => ENNReal.ofReal (H x)) (fun x => ENNReal.ofReal (H x))
      hHint.aemeasurable.ennreal_ofReal
      (Filter.Eventually.of_forall fun x => le_rfl) b
  have hbadScaled :
      (8 * b) * volume {x | b < ENNReal.ofReal (H x)} ≤
        (16 * ENNReal.ofReal T) * F := by
    calc
      (8 * b) * volume {x | b < ENNReal.ofReal (H x)} =
          8 * (b * volume {x | b < ENNReal.ofReal (H x)}) := by ring
      _ ≤ 8 * (∫⁻ x, ENNReal.ofReal (H x)) := mul_le_mul_right hbadMarkov _
      _ ≤ 8 * (ENNReal.ofReal (2 * T) * F) :=
        mul_le_mul_right hHlintegral _
      _ = (16 * ENNReal.ofReal T) * F := by
        rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
        norm_num
        ring
  let D : ℝ :=
    (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (3 : ℝ) ^ d * (d : ℝ) ^ d
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hEreal : volume.real E ≤ D * (lambda / 2)⁻¹ *
      ∫ x, ‖(f : Euclidean d → ℂ) x‖ := by
    calc
      volume.real E ≤
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (3 : ℝ) ^ d *
            ((d : ℝ) ^ d * ((lambda / 2)⁻¹ *
              ∫ x, ‖(f : Euclidean d → ℂ) x‖)) := by
        simpa only [E] using
          volume_real_lacunaryCZDyadicCubeExceptionalTriple_le_of_radius_sum U hradius
      _ = D * (lambda / 2)⁻¹ * ∫ x, ‖(f : Euclidean d → ℂ) x‖ := by
        dsimp only [D]
        ring
  have hEKnon : 0 ≤ D * (lambda / 2)⁻¹ *
      ∫ x, ‖(f : Euclidean d → ℂ) x‖ :=
    mul_nonneg (mul_nonneg hD (inv_nonneg.mpr (by linarith)))
      (integral_nonneg fun _ => norm_nonneg _)
  have hEraw : volume E ≤ ENNReal.ofReal
      (D * (lambda / 2)⁻¹ * ∫ x, ‖(f : Euclidean d → ℂ) x‖) :=
    measure_le_of_real_bound_cell volume E (exceptional_lt_top_cell U).ne hEKnon hEreal
  have hEbound : volume E ≤ ENNReal.ofReal D * a₀⁻¹ * F := by
    calc
      volume E ≤ ENNReal.ofReal
          (D * (lambda / 2)⁻¹ * ∫ x, ‖(f : Euclidean d → ℂ) x‖) := hEraw
      _ = ENNReal.ofReal D * a₀⁻¹ * F := by
        rw [ENNReal.ofReal_mul (mul_nonneg hD (inv_nonneg.mpr (by linarith))),
          ENNReal.ofReal_mul hD, ENNReal.ofReal_inv_of_pos (by linarith), hFreal]
  have hEScaled : (8 * b) * volume E ≤ (2 * ENNReal.ofReal D) * F := by
    calc
      (8 * b) * volume E = (2 * a₀) * volume E := by rw [ha₀eq]; ring
      _ ≤ (2 * a₀) * (ENNReal.ofReal D * a₀⁻¹ * F) :=
        mul_le_mul_right hEbound _
      _ = (2 * ENNReal.ofReal D) * F := by
        rw [show 2 * a₀ * (ENNReal.ofReal D * a₀⁻¹ * F) =
              (2 * ENNReal.ofReal D) * (a₀ * a₀⁻¹) * F by ring,
          ENNReal.mul_inv_cancel ha₀ ha₀top, mul_one]
  have hunion :
