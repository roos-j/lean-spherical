            (p.1 + (p.2 : Euclidean d))‖ * ‖p.1 + (p.2 : Euclidean d)‖)
        (volume.prod (unitSurfaceMeasure d)) :=
      ((hcont.comp (continuous_fst.add
        (continuous_subtype_val.comp continuous_snd))).norm.mul
        (continuous_fst.add (continuous_subtype_val.comp continuous_snd)).norm).aestronglyMeasurable
    refine (integrable_prod_iff' hmeas).2 ?_
    constructor
    · filter_upwards with omega
      simpa only [mul_comm] using hDDKWeighted.comp_add_right (omega : Euclidean d)
