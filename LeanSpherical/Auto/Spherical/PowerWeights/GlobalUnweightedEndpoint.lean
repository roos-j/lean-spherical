    · unfold lacunaryRelativeBandpassPhysicalKernelRadiusGeneratorFDerivConstant
      apply mul_nonneg measureReal_nonneg
      apply add_nonneg
      · apply add_nonneg
        · exact mul_nonneg
            (add_nonneg (Nat.cast_nonneg d) (by norm_num))
