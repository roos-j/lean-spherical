    · exact div_nonneg
        (mul_nonneg measureReal_nonneg (pow_nonneg (by norm_num) _))
        (mul_nonneg (by norm_num) (sq_nonneg _))
  have hA : 0 ≤ surfaceMass d *
      ((d : ℝ) * (∫ x : Euclidean d,
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) +
