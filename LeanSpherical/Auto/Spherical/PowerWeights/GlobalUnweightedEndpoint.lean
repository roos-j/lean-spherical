      _ = 0 := lintegral_zero
  have hAeq : (∫⁻ x, G x ∂ν.restrict A) = ∫⁻ x, G x ∂ν :=
    (lintegral_eq_lintegral_restrict_of_support A hA G hGsupport).symm
  calc
    (∫⁻ x, G x ∂(ν.restrict A + ν.restrict B)) =
        (∫⁻ x, G x ∂ν.restrict A) + ∫⁻ x, G x ∂ν.restrict B :=
      lintegral_add_measure G _ _
    _ = (∫⁻ x, G x ∂ν.restrict A) + 0 := by rw [hBzero]
    _ = ∫⁻ x, G x ∂ν := by rw [add_zero, hAeq]

/-- The cap theorem is stated for the sum of the output and input restricted
measures.  Its output integrand is supported on the output shell, so it is
literally the global power-weighted moment on that shell. -/
theorem lintegral_annular_output_indicator_add_restrict_eq
    {d : Nat} {s a b α p : ℝ} (hs : 0 < s) (hsa : s < a) (hp : 0 < p)
    (M : Euclidean d → ℝ) :
    (∫⁻ x,
        ENNReal.ofReal
          (((euclideanAnnulus d (s / 4) (s / 2)).indicator M x) ^ p)
        ∂((powerWeightedVolume d α).restrict
            (euclideanAnnulus d (s / 4) (s / 2)) +
          (powerWeightedVolume d α).restrict (euclideanAnnulus d a b))) =
      ∫⁻ x in euclideanAnnulus d (s / 4) (s / 2),
        ENNReal.ofReal ((M x) ^ p) ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d (s / 4) (s / 2)
  let B : Set (Euclidean d) := euclideanAnnulus d a b
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let G : Euclidean d → ENNReal := fun x =>
    ENNReal.ofReal ((A.indicator M x) ^ p)
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hB : MeasurableSet B := measurableSet_closedBall.diff measurableSet_ball
  have hhalf : s / 2 < a := by linarith
  have hdisj : Disjoint A B :=
    disjoint_euclideanAnnulus_of_outer_lt_inner hhalf
  have hGsupport : ∀ x, x ∉ A → G x = 0 := by
    intro x hx
    simp [G, Set.indicator_of_notMem hx, hp.ne']
  have hmeasure := lintegral_add_restrict_eq_lintegral_of_support_left_shell
    (ν := ν) hA hB hdisj G hGsupport
  have hset : (∫⁻ x, G x ∂ν) =
      ∫⁻ x in A, ENNReal.ofReal ((M x) ^ p) ∂ν := by
    rw [← lintegral_indicator hA]
    apply lintegral_congr
    intro x
    by_cases hx : x ∈ A
    · simp [G, hx]
    · simp [G, hx, hp.ne']
  simpa only [A, B, ν, G] using hmeasure.trans hset

/-- The same auxiliary-measure conversion for an input supported on the
separated input annulus. -/
theorem lintegral_annular_input_add_restrict_eq
    {d : Nat} {s a b α p : ℝ} (hs : 0 < s) (hsa : s < a) (hp : 0 < p)
    (f : SchwartzMap (Euclidean d) ℂ)
    (hfsupport : ∀ y, y ∉ euclideanAnnulus d a b → f y = 0) :
    (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p
        ∂((powerWeightedVolume d α).restrict
            (euclideanAnnulus d (s / 4) (s / 2)) +
          (powerWeightedVolume d α).restrict (euclideanAnnulus d a b))) =
      ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d (s / 4) (s / 2)
  let B : Set (Euclidean d) := euclideanAnnulus d a b
  let ν : Measure (Euclidean d) := powerWeightedVolume d α
  let G : Euclidean d → ENNReal := fun x => (ENNReal.ofReal ‖f x‖) ^ p
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hB : MeasurableSet B := measurableSet_closedBall.diff measurableSet_ball
  have hhalf : s / 2 < a := by linarith
  have hdisj : Disjoint A B :=
    disjoint_euclideanAnnulus_of_outer_lt_inner hhalf
  have hGsupport : ∀ x, x ∉ B → G x = 0 := by
    intro x hx
    simp [G, hfsupport x hx, hp]
  have hmeasure : (∫⁻ x, G x ∂(ν.restrict A + ν.restrict B)) = ∫⁻ x, G x ∂ν := by
    simpa only [add_comm] using
      (lintegral_add_restrict_eq_lintegral_of_support_left_shell
        (ν := ν) hB hA hdisj.symm G hGsupport)
  simpa only [A, B, ν, G] using hmeasure

/-- The entropy-cap interpolation theorem, with its auxiliary two-annulus
measure removed.  Both the input and output moments are now literal moments
for `powerWeightedVolume`; this is the exact form consumed by finite spatial
and frequency reassembly. -/
theorem exists_restrictedRelativeBandpass_entropyCap_shell_global_lintegral_rpow_le
    {n : Nat} (hn : 1 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ u : ℝ, 1 ≤ ‖xi‖ →
      u ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun z : ℝ => surfaceFourier (n + 1) (z • xi)) u‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      (E : Set ℝ) (δ : NNReal) (N : ℕ) {s a b α p τ : ℝ},
      4 ≤ j → E.Nonempty → E ⊆ Icc (1 : ℝ) 2 →
      multiplicativeEntropy E δ ≤ N →
      Real.log 2 * (δ : ℝ) ≤ 1 →
      8 * Real.log 2 * (δ : ℝ) ≤ ((2 : ℝ) ^ j)⁻¹ →
      0 < s → 4 * s ≤ 1 → α ≤ 0 → 0 < a → a ≤ b → s < a →
      1 < p → p < 2 → 0 < τ →
      (∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) →
      ∃ R : Finset (ℝ × ℝ), R.card ≤ N ∧
        (∀ q ∈ R, q.1 ≤ q.2) ∧
        (∀ q ∈ R, q.1 ∈ Icc (1 : ℝ) 2 ∧ q.2 ∈ Icc (1 : ℝ) 2) ∧
        (∀ q ∈ R, q.2 - q.1 ≤ ((2 : ℝ) ^ j)⁻¹) ∧
        E ⊆ ⋃ q ∈ R, Icc q.1 q.2 ∧
        let L : ENNReal := (N : ENNReal) * ENNReal.ofReal
          (2 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)) ^
              (2 : ℕ) +
            2 * (8 * Real.log 2 * (δ : ℝ)) ^ (2 : ℕ) *
              (2 * ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^
                  ((n : ℝ) / 2 - 1) +
                (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ (Euclidean (n + 1)) ℂ)
                      phi).toBoundedContinuousFunction‖) /
                  (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))) ^ (2 : ℕ))
        let c1 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α *
          (∑ q ∈ R, relativeIntervalBandCapTail n j C q.1 q.2 s) *
            ((ENNReal.ofReal b) ^ α)⁻¹
        let c2 : ENNReal := (ENNReal.ofReal (s / 4)) ^ α * L *
          ((ENNReal.ofReal b) ^ α)⁻¹
        let a2 : ENNReal :=
          (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (2 - p))⁻¹) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume (n + 1) α
        let a1 : ENNReal :=
          ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume (n + 1) α
        (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2),
          ENNReal.ofReal
            ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^ p)
            ∂powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal p *
            (4 * c2 * ((ENNReal.ofReal τ) ^ (2 - p) * a2) +
              2 * c1 * ((ENNReal.ofReal τ) ^ (1 - p) * a1)) := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_restrictedRelativeBandpass_entropyCap_shell_lintegral_rpow_le
      hn C0 C1 hC0 hC1 hdecay hderiv phi hphi_one hphi_zero hphi_norm
  refine ⟨C, hC, ?_⟩
  intro j f E δ N s a b α p τ hj hEne hE hN hδ hshort hs hsone hα ha hab hsa hp1 hp2 hτ
    hfsupport
  obtain ⟨R, hRcard, hRordered, hRends, hRlength, hRcover, hbound⟩ :=
    hcap j f E δ N hj hEne hE hN hδ hshort hs hsone hα ha hab hsa hp1 hp2 hτ hfsupport
  refine ⟨R, hRcard, hRordered, hRends, hRlength, hRcover, ?_⟩
  dsimp only at hbound
  have houtput := lintegral_annular_output_indicator_add_restrict_eq
    (d := n + 1) (s := s) (a := a) (b := b) (α := α) (p := p)
      hs hsa (lt_trans zero_lt_one hp1)
      (fun x => (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
  have hinput := lintegral_annular_input_add_restrict_eq
    (d := n + 1) (s := s) (a := a) (b := b) (α := α) (p := p)
      hs hsa (lt_trans zero_lt_one hp1) f hfsupport
  rw [houtput, hinput] at hbound
  exact hbound

/-
/-- Turn a finite global `p`-moment estimate for one literal relative band
into the `MemLp` and norm form used by the final local estimate.  This keeps
the literal band visible: the preceding shell argument supplies `hbound`
directly, rather than through a new bundled operator. -/
theorem memLp_and_eLpNorm_restrictedRelativeBandpass_of_global_lintegral_rpow_le
    {n : Nat} {p α : ℝ} (hp : 0 < p) (E : Set ℝ)
    (phi f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hf : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α))
    (hbound :
      (∫⁻ x : Euclidean (n + 1),
        ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^ p)
          ∂powerWeightedVolume (n + 1) α) ≤
        A * ∫⁻ x : Euclidean (n + 1),
          (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume (n + 1) α) :
    MemLp
      (fun x : Euclidean (n + 1) =>
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
      (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ∧
      eLpNorm
        (fun x : Euclidean (n + 1) =>
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
        (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ≤
        A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) := by
  let μ : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ℝ := fun x =>
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal
  let I : ENNReal := ∫⁻ x : Euclidean (n + 1), (ENNReal.ofReal ‖f x‖) ^ p ∂μ
  let J : ENNReal := ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal ((M x) ^ p) ∂μ
  have hpNN : 0 ≤ p := hp.le
  have hpInvNN : 0 ≤ p⁻¹ := inv_nonneg.mpr hpNN
  have hIlt : I < ⊤ := by
    have h := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (μ := μ) (f := (f : Euclidean (n + 1) → ℂ))
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top hf.2
    simpa only [I, ENNReal.toReal_ofReal hpNN, ofReal_norm] using h
  have hJle : J ≤ A * I := by
    simpa only [J, I, M, μ] using hbound
  have hJlt : J < ⊤ :=
    hJle.trans_lt (ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hAtop) hIlt)
  have hMmeas : Measurable M := by
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hE hEne
  have hMnonneg : ∀ x, 0 ≤ M x := by
    intro x
    exact ENNReal.toReal_nonneg
  have hMmem : MemLp M (ENNReal.ofReal p) μ :=
    memLp_of_lintegral_ofReal_rpow_lt_top M hMmeas.aemeasurable hMnonneg hp hJlt
  have hInorm : eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p) μ =
      I ^ p⁻¹ := by
    dsimp only [I]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, ofReal_norm]
    rw [one_div]
  constructor
  · simpa only [M, μ] using hMmem
  · calc
      eLpNorm
          (fun x : Euclidean (n + 1) =>
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) =
          eLpNorm M (ENNReal.ofReal p) μ := by rfl
      _ ≤ J ^ p⁻¹ :=
        eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le μ M hp hMnonneg hJle
      _ ≤ (A * I) ^ p⁻¹ := ENNReal.rpow_le_rpow hJle hpInvNN
      _ = A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) μ := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hpInvNN, ← hInorm]
      _ = A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) := by rfl

-/

/-- Turn a finite global `p`-moment estimate for one literal relative band
into the `MemLp` and norm form used by the final local estimate.  This keeps
the literal band visible: the preceding shell argument supplies `hbound`
directly, rather than through a new bundled operator. -/
theorem memLp_and_eLpNorm_restrictedRelativeBandpass_of_global_lintegral_rpow_le
    {n : Nat} {p α : ℝ} (hp : 0 < p) (E : Set ℝ)
    (phi f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (A : ENNReal) (hAtop : A ≠ ⊤)
    (hf : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α))
    (hbound :
      (∫⁻ x : Euclidean (n + 1),
        ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^ p)
          ∂powerWeightedVolume (n + 1) α) ≤
        A * ∫⁻ x : Euclidean (n + 1),
          (ENNReal.ofReal ‖f x‖) ^ p ∂powerWeightedVolume (n + 1) α) :
    MemLp
      (fun x : Euclidean (n + 1) =>
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
      (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ∧
      eLpNorm
        (fun x : Euclidean (n + 1) =>
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
        (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) ≤
        A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) := by
  let mu : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ℝ := fun x =>
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal
  let I : ENNReal := ∫⁻ x : Euclidean (n + 1), (ENNReal.ofReal ‖f x‖) ^ p ∂mu
  let J : ENNReal := ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal ((M x) ^ p) ∂mu
  have hpNN : 0 ≤ p := hp.le
  have hpInvNN : 0 ≤ p⁻¹ := inv_nonneg.mpr hpNN
  have hIlt : I < ⊤ := by
    have h := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (μ := mu) (f := (f : Euclidean (n + 1) → ℂ))
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top hf.2
    simpa only [I, ENNReal.toReal_ofReal hpNN, ofReal_norm] using h
  have hJle : J ≤ A * I := by
    simpa only [J, I, M, mu] using hbound
  have hJlt : J < ⊤ :=
    hJle.trans_lt (ENNReal.mul_lt_top (lt_top_iff_ne_top.mpr hAtop) hIlt)
  have hMmeas : Measurable M := by
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hE hEne
  have hMnonneg : ∀ x, 0 ≤ M x := by
    intro x
    exact ENNReal.toReal_nonneg
  have hMmem : MemLp M (ENNReal.ofReal p) mu :=
    memLp_of_lintegral_ofReal_rpow_lt_top M hMmeas.aemeasurable hMnonneg hp hJlt
  have hInorm : eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p) mu =
      I ^ p⁻¹ := by
    dsimp only [I]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hpNN, ofReal_norm]
    rw [one_div]
  constructor
  · simpa only [M, mu] using hMmem
  · calc
      eLpNorm
          (fun x : Euclidean (n + 1) =>
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) =
          eLpNorm M (ENNReal.ofReal p) mu := by rfl
      _ ≤ (A * I) ^ p⁻¹ :=
        eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le mu M hp hMnonneg hJle
      _ = A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) mu := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hpInvNN, ← hInorm]
      _ = A ^ p⁻¹ * eLpNorm (f : Euclidean (n + 1) → ℂ)
          (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α) := by rfl

/-- Finite output-shell reassembly for literal relative bands.  The input
to the cap argument is held fixed here (and is normally supported in one
annulus); the displayed hypotheses are exactly the shell moments produced by
`exists_restrictedRelativeBandpass_entropyCap_shell_lintegral_rpow_le`.

Keeping the output cutoff visible is useful: a later finite input-annulus
decomposition can invoke this lemma term-by-term without introducing another
maximal-operator wrapper. -/
theorem eLpNorm_finite_annular_shell_relativeBandpass_sum_le_of_moments
    {d : Nat} {p α : ℝ} (hp : 1 ≤ p) (E : Set ℝ)
    (phi : SchwartzMap (Euclidean d) ℂ) (f : SchwartzMap (Euclidean d) ℂ)
    (K J : Finset ℕ) (s : ℕ → ℝ)
    (hAmeas : ∀ k ∈ K,
      MeasurableSet (euclideanAnnulus d (s k / 4) (s k / 2)))
    (hband_meas : ∀ j ∈ J,
      Measurable (fun x : Euclidean d =>
        (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
    (Q : ℕ → ℕ → ENNReal)
    (hQ : ∀ k ∈ K, ∀ j ∈ J,
      (∫⁻ x in euclideanAnnulus d (s k / 4) (s k / 2),
        ENNReal.ofReal
          ((restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal ^ p)
          ∂powerWeightedVolume d α) ≤ Q k j) :
    eLpNorm
      ((⋃ k ∈ (K : Set ℕ), euclideanAnnulus d (s k / 4) (s k / 2)).indicator
        (fun x : Euclidean d => ∑ j ∈ J,
          (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal))
      (ENNReal.ofReal p) (powerWeightedVolume d α) ≤
      ∑ k ∈ K, ∑ j ∈ J, (Q k j) ^ p⁻¹ := by
  let μ : Measure (Euclidean d) := powerWeightedVolume d α
  let A : ℕ → Set (Euclidean d) := fun k =>
    euclideanAnnulus d (s k / 4) (s k / 2)
  let M : ℕ → Euclidean d → ℝ := fun j x =>
    (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal
  let g : ℕ × ℕ → Euclidean d → ℝ := fun kj =>
    (A kj.1).indicator (M kj.2)
  let S : Finset (ℕ × ℕ) := K.product J
  let q : ℕ × ℕ → ENNReal := fun kj => Q kj.1 kj.2
  have hgmeas : ∀ ij ∈ S, AEStronglyMeasurable (g ij) μ := by
    intro ij hij
    have hik : ij.1 ∈ K := (Finset.mem_product.mp hij).1
    have hij' : ij.2 ∈ J := (Finset.mem_product.mp hij).2
    exact ((hband_meas ij.2 hij').indicator (hAmeas ij.1 hik)).aestronglyMeasurable
  have hgnonneg : ∀ ij ∈ S, ∀ x : Euclidean d, 0 ≤ g ij x := by
    intro ij hij x
    dsimp only [g]
    by_cases hx : x ∈ A ij.1
    · rw [Set.indicator_of_mem hx]
      exact ENNReal.toReal_nonneg
    · simp [hx]
  have hq : ∀ ij ∈ S,
      (∫⁻ x, ENNReal.ofReal ((g ij x) ^ p) ∂μ) ≤ q ij := by
    intro ij hij
    have hik : ij.1 ∈ K := (Finset.mem_product.mp hij).1
    have hij' : ij.2 ∈ J := (Finset.mem_product.mp hij).2
    have hpow : (fun x : Euclidean d => ENNReal.ofReal ((g ij x) ^ p)) =
        (A ij.1).indicator (fun x => ENNReal.ofReal ((M ij.2 x) ^ p)) := by
