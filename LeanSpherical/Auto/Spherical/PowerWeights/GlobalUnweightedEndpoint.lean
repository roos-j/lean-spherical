    exists_schwartz_rational_low_high_family f
  have hprofiles :=
    measurable_rational_low_high_profile_lintegrals f low high hlow hhigh (μ := volume)
  have htail2 :=
    rational_schwartz_low_weighted_tail f low high hlow hhigh hp1 hp2
  have htail1 :=
    rational_schwartz_high_weighted_tail f low high hlow hhigh hp1 hp2
  let A₂ : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  let A₁ : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ +
      (ENNReal.ofReal (3 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  have hweak_two : ∀ (g : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal (s ^ (2 : ℕ)) * volume {x | s < T g x} ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := by
    intro g s hs
    calc
      ENNReal.ofReal (s ^ (2 : ℕ)) * volume {x | s < T g x} ≤
          ENNReal.ofReal (s ^ (2 : ℕ)) *
            volume {x | ENNReal.ofReal (s ^ (2 : ℕ)) ≤
              ENNReal.ofReal ((T g x) ^ (2 : ℕ))} := by
        apply mul_le_mul_right
        apply measure_mono
        intro x hx
        apply ENNReal.ofReal_le_ofReal
        exact pow_le_pow_left₀ hs.le hx.le 2
      _ ≤ ∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ)) :=
        mul_meas_ge_le_lintegral₀ ((hTmeas g).pow_const 2).ennreal_ofReal
          (ENNReal.ofReal (s ^ (2 : ℕ)))
      _ ≤ C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := hsquare g
  have hinterp := marcinkiewicz_weak_one_two_on_additive_split
    (Set.univ : Set (SchwartzMap (Euclidean d) ℂ))
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ))
    T hTnonneg
    (by
      intro g h _ _
      exact hTsubadd g h)
    C₁ C₂
    (by
      intro g _ s hs
      exact hweak_one g hs)
    (by
      intro g _ s hs
      exact hweak_two g hs)
    hp1 hp2 f (hTmeas f)
    low high
    (by intro t; simp) (by intro t; simp)
    (by
      intro t
      ext x
      exact hsplit t x)
    hprofiles.1 hprofiles.2
    A₂ A₁ htail2 htail1
  simpa only [A₂, A₁] using hinterp

/-- The coefficient in the strong `Lᵖ` moment obtained by interpolating a
weak-one constant with a square-moment constant. -/
def weakOneSquareMomentCoefficient (p : ℝ) (C₁ C₂ : ENNReal) : ENNReal :=
  ENNReal.ofReal p *
    (4 * C₂ *
        (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (2 - p))⁻¹) +
      2 * C₁ *
        ((ENNReal.ofReal (p - 1))⁻¹ +
          (ENNReal.ofReal (3 - p))⁻¹))

/-- In the open interpolation range the displayed moment coefficient is
finite whenever both endpoint constants are finite. -/
theorem weakOneSquareMomentCoefficient_ne_top
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    {C₁ C₂ : ENNReal} (hC₁ : C₁ ≠ ⊤) (hC₂ : C₂ ≠ ⊤) :
    weakOneSquareMomentCoefficient p C₁ C₂ ≠ ⊤ := by
  rw [weakOneSquareMomentCoefficient]
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · exact ENNReal.mul_ne_top (by norm_num) hC₂
    · apply ENNReal.add_ne_top.mpr
      constructor
      · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        apply ENNReal.inv_ne_top.mpr
        exact ENNReal.ofReal_ne_zero_iff.mpr (lt_trans zero_lt_one hp1)
      · apply ENNReal.inv_ne_top.mpr
        exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp2)
  · apply ENNReal.mul_ne_top
    · exact ENNReal.mul_ne_top (by norm_num) hC₁
    · apply ENNReal.add_ne_top.mpr
      constructor
      · apply ENNReal.inv_ne_top.mpr
        exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp1)
      · apply ENNReal.inv_ne_top.mpr
        exact ENNReal.ofReal_ne_zero_iff.mpr (by linarith)

/-- The preceding interpolation estimate with its input moment factored
out.  This is the exact form consumed by the raw-maximal-function and
geometric-reassembly steps. -/
theorem schwartz_lintegral_rpow_of_weak_one_and_square_factorized
    {d : Nat} (T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ)
    (hTnonneg : ∀ (g : SchwartzMap (Euclidean d) ℂ) x, 0 ≤ T g x)
    (hTsubadd : ∀ (g h : SchwartzMap (Euclidean d) ℂ),
      ∀ᵐ x ∂volume, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g : SchwartzMap (Euclidean d) ℂ,
      AEMeasurable (T g) volume)
    (C₁ C₂ : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x | s < T g x} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ g : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)))
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) ℂ) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p)) ≤
      weakOneSquareMomentCoefficient p C₁ C₂ *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  calc
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p)) ≤
        ENNReal.ofReal p *
          (4 * C₂ *
              (((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                  (ENNReal.ofReal (2 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) +
            2 * C₁ *
              (((ENNReal.ofReal (p - 1))⁻¹ +
                  (ENNReal.ofReal (3 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) :=
      schwartz_lintegral_rpow_of_weak_one_and_square T hTnonneg hTsubadd hTmeas
        C₁ C₂ hweak_one hsquare hp1 hp2 f
    _ = weakOneSquareMomentCoefficient p C₁ C₂ *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
      rw [weakOneSquareMomentCoefficient]
      ring

/-- The same interpolation argument with a freely chosen splitting scale.
Balancing this scale is what converts the weak-one and square coefficients
into their geometric mean in the final global summation. -/
theorem schwartz_lintegral_rpow_of_weak_one_and_square_scaled
    {d : Nat} (T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ)
    (hTnonneg : ∀ (g : SchwartzMap (Euclidean d) ℂ) x, 0 ≤ T g x)
    (hTsubadd : ∀ (g h : SchwartzMap (Euclidean d) ℂ),
      ∀ᵐ x ∂volume, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g : SchwartzMap (Euclidean d) ℂ,
      AEMeasurable (T g) volume)
    (C₁ C₂ : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x | s < T g x} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ g : SchwartzMap (Euclidean d) ℂ,
      (∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)))
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) ℂ) (s : ℝ) (hs : 0 < s) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ p)) ≤
      ENNReal.ofReal p *
        (4 * C₂ *
            ((ENNReal.ofReal s) ^ (2 - p) *
              ((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) +
          2 * C₁ *
            ((ENNReal.ofReal s) ^ (1 - p) *
              (((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹) *
                ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p))) := by
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high_family f
  have hprofiles :=
    measurable_rational_low_high_profile_lintegrals f low high hlow hhigh (μ := volume)
  have htail2 :=
    rational_schwartz_low_weighted_tail f low high hlow hhigh hp1 hp2
  have htail1 :=
    rational_schwartz_high_weighted_tail f low high hlow hhigh hp1 hp2
  let A₂ : ENNReal :=
    (ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  let A₁ : ENNReal :=
    ((ENNReal.ofReal (p - 1))⁻¹ +
      (ENNReal.ofReal (3 - p))⁻¹) *
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)
  have hweak_two : ∀ (g : SchwartzMap (Euclidean d) ℂ) {t : ℝ}, 0 < t →
      ENNReal.ofReal (t ^ (2 : ℕ)) * volume {x | t < T g x} ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := by
    intro g t ht
    calc
      ENNReal.ofReal (t ^ (2 : ℕ)) * volume {x | t < T g x} ≤
          ENNReal.ofReal (t ^ (2 : ℕ)) *
            volume {x | ENNReal.ofReal (t ^ (2 : ℕ)) ≤
              ENNReal.ofReal ((T g x) ^ (2 : ℕ))} := by
        apply mul_le_mul_right
        apply measure_mono
        intro x hx
        apply ENNReal.ofReal_le_ofReal
        exact pow_le_pow_left₀ ht.le hx.le 2
      _ ≤ ∫⁻ x, ENNReal.ofReal ((T g x) ^ (2 : ℕ)) :=
        mul_meas_ge_le_lintegral₀ ((hTmeas g).pow_const 2).ennreal_ofReal
          (ENNReal.ofReal (t ^ (2 : ℕ)))
      _ ≤ C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := hsquare g
  have hinterp := marcinkiewicz_weak_one_two_on_additive_split_scaled
    (Set.univ : Set (SchwartzMap (Euclidean d) ℂ))
    (fun g : SchwartzMap (Euclidean d) ℂ => (g : Euclidean d → ℂ))
    T hTnonneg
    (by
      intro g h _ _
      exact hTsubadd g h)
    C₁ C₂
    (by
      intro g _ t ht
      exact hweak_one g ht)
    (by
      intro g _ t ht
      exact hweak_two g ht)
    hp1 hp2 f (hTmeas f)
    low high
    (by intro t; simp) (by intro t; simp)
    (by
      intro t
      ext x
      exact hsplit t x)
    hprofiles.1 hprofiles.2
    A₂ A₁ htail2 htail1 s hs
  simpa only [A₂, A₁] using hinterp

/-- The square coefficient furnished by the all-scale entropy estimate for
one relative frequency band.  Naming this displayed quantity keeps the
continuum weak-one endpoint readable without hiding any analytic content. -/
def globalRelativeBandSquareCoefficient
    (n : Nat) (C₀ C₁ : ℝ) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (j : Nat) (δ : NNReal) (N : ℕ) : ℝ :=
  24 * (N : ℝ) *
    (2 * ((4 * C₀) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2)) ^ 2 +
      2 * (8 * Real.log 2 * (δ : ℝ)) ^ 2 *
        (2 *
          ((8 * C₁) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2 - 1) +
            (12 * C₀ *
              ‖((SchwartzMap.fderivCLM ℂ (Euclidean (n + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
              (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : ℝ) / 2))) ^ 2)


/-- Convert a finite moment estimate for the real-valued version of an
`ENNReal` maximal function into the raw `ENNReal` strong-type estimate used
by cutoff reassembly.  The a.e. finiteness premise is indispensable here:
`ENNReal.toReal ⊤ = 0` would otherwise lose exceptional infinite values. -/
theorem memLp_and_eLpNorm_ennreal_of_toReal_lintegral_rpow_le
    {X : Type*} [MeasurableSpace X] (mu : Measure X) (M : X → ENNReal)
    (hMmeas : AEMeasurable M mu) (hMfinite : ∀ᵐ x ∂mu, M x ≠ ⊤)
    {p : ℝ} (hp : 0 < p) {A : ENNReal} (hAtop : A ≠ ⊤)
    (f : X → ℂ) (hf : MemLp f (ENNReal.ofReal p) mu)
    (hbound :
      (∫⁻ x, ENNReal.ofReal ((M x).toReal ^ p) ∂mu) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂mu) :
    MemLp M (ENNReal.ofReal p) mu ∧
      eLpNorm M (ENNReal.ofReal p) mu ≤
        A ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) mu := by
  let T : X → ℝ := fun x => (M x).toReal
  let I : ENNReal := ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p ∂mu
  let J : ENNReal := ∫⁻ x, ENNReal.ofReal ((T x) ^ p) ∂mu
  have hp_nonneg : 0 ≤ p := hp.le
  have hp_inv_nonneg : 0 ≤ p⁻¹ := inv_nonneg.mpr hp_nonneg
  have hIlt : I < ⊤ := by
    have h := lintegral_rpow_enorm_lt_top_of_eLpNorm_lt_top
      (μ := mu) (f := f) (ENNReal.ofReal_ne_zero_iff.mpr hp)
      ENNReal.ofReal_ne_top hf.eLpNorm_lt_top
    simpa only [I, ENNReal.toReal_ofReal hp_nonneg, ofReal_norm] using h
  have hJle : J ≤ A * I := by
    simpa only [J, I, T] using hbound
  have hJlt : J < ⊤ :=
    hJle.trans_lt (ENNReal.mul_lt_top hAtop.lt_top hIlt)
  have hTmeas : AEMeasurable T mu := by
    change AEMeasurable (ENNReal.toReal ∘ M) mu
    exact ENNReal.measurable_toReal.comp_aemeasurable hMmeas
  have hTnonneg (x : X) : 0 ≤ T x := ENNReal.toReal_nonneg
  have hTmem : MemLp T (ENNReal.ofReal p) mu :=
    memLp_of_lintegral_ofReal_rpow_lt_top T hTmeas hTnonneg hp hJlt
  have hInorm : eLpNorm f (ENNReal.ofReal p) mu = I ^ p⁻¹ := by
    dsimp only [I]
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
    simp only [ENNReal.toReal_ofReal hp_nonneg, ofReal_norm]
    rw [one_div]
  have hTnorm : eLpNorm T (ENNReal.ofReal p) mu ≤
      A ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) mu := by
    calc
      eLpNorm T (ENNReal.ofReal p) mu ≤ (A * I) ^ p⁻¹ :=
        eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le mu T hp hTnonneg hJle
      _ = A ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) mu := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp_inv_nonneg, ← hInorm]
  have hpoint : ∀ᵐ x ∂mu,
      ‖M x‖ₑ ≤ ((1 : NNReal) : ENNReal) * ‖T x‖ₑ := by
    filter_upwards [hMfinite] with x hx
    calc
      ‖M x‖ₑ = M x := enorm_eq_self _
      _ = ENNReal.ofReal (T x) := (ENNReal.ofReal_toReal hx).symm
      _ = ‖T x‖ₑ := (Real.enorm_of_nonneg (hTnonneg x)).symm
      _ ≤ ((1 : NNReal) : ENNReal) * ‖T x‖ₑ := by norm_num
  have hMmem : MemLp M (ENNReal.ofReal p) mu :=
    MemLp.of_enorm_le_mul hTmem hMmeas.aestronglyMeasurable hpoint
  have hMnorm : eLpNorm M (ENNReal.ofReal p) mu ≤
      eLpNorm T (ENNReal.ofReal p) mu := by
    calc
      eLpNorm M (ENNReal.ofReal p) mu ≤
          ((1 : NNReal) : ENNReal) * eLpNorm T (ENNReal.ofReal p) mu :=
        eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' (ENNReal.ofReal p)
          hTmem.aestronglyMeasurable hpoint
      _ = eLpNorm T (ENNReal.ofReal p) mu := by norm_num
  exact ⟨hMmem, hMnorm.trans hTnorm⟩

/-- An `ENNReal`-valued `L²` function is finite almost everywhere.  We use
this only to retain the raw value of the global relative band after taking
`toReal` for interpolation. -/
theorem ae_ne_top_ennreal_of_memLp_two
    {X : Type*} [MeasurableSpace X] (mu : Measure X) (M : X → ENNReal)
    (hM : MemLp M 2 mu) :
    ∀ᵐ x ∂mu, M x ≠ ⊤ := by
  have hlin : (∫⁻ x, M x ^ (2 : ℝ) ∂mu) < ⊤ := by
    have h := (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top
      (p := (2 : ENNReal)) (by norm_num) (by norm_num)).mp hM.eLpNorm_lt_top
    simpa only [enorm_eq_self, ENNReal.toReal_ofNat] using h
  filter_upwards [ae_lt_top'
    (hM.aestronglyMeasurable.aemeasurable.pow_const (2 : ℝ)) hlin.ne] with x hx
  intro hMtop
  rw [hMtop, ENNReal.top_rpow_of_pos (by norm_num)] at hx
  exact lt_irrefl _ hx

/-- The literal relative dyadic band is measurable for an arbitrary radius
set.  The proof rewrites it as a compactly supported relative cutoff; unlike
the older normalized measurability lemma, it does not assume `E ⊆ [1,2]`. -/
theorem measurable_restrictedRelativeBandpassSphericalMaximal_global
    {d : Nat} (E : Set ℝ) (phi f : SchwartzMap (Euclidean d) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0) (j : Nat) :
    Measurable (restrictedRelativeBandpassSphericalMaximal d E phi j f) := by
  obtain ⟨psi, hpsi, hpsi_compact, _⟩ :=
    exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      phi hphi_one hphi_zero j
  have hEq : restrictedRelativeBandpassSphericalMaximal d E phi j f =
      restrictedRelativeCutoffSphericalMaximal d E psi 0 f := by
    funext x
    unfold restrictedRelativeBandpassSphericalMaximal
      restrictedRelativeCutoffSphericalMaximal
    apply iSup_congr
    intro r
    congr 2
    apply congrArg (fun g : Euclidean d → ℂ => 𝓕⁻ g x)
    funext ξ
    simp only [pow_zero, inv_one, one_smul]
    rw [hpsi (r.1 • ξ)]
  rw [hEq]
  exact measurable_restrictedRelativeCutoffSphericalMaximal E psi hpsi_compact 0 f

/-- The all-scale entropy theorem, converted to the lower-integral square
form used by the interpolation bridge. -/
theorem global_relative_band_square_lintegral_of_unitEntropy
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : ℝ) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set ℝ) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (δ : NNReal) (N : ℕ) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (g : SchwartzMap (Euclidean (n + 1)) ℂ) :
    (∫⁻ x, ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
        (2 : ℕ))) ≤
      ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N) *
        ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) := by
  let T : SchwartzMap (Euclidean (n + 1)) ℂ → Euclidean (n + 1) → ℝ :=
    fun h x => (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal
  obtain ⟨hmem, hbound⟩ :=
    memLp_two_restrictedRelativeBandpassSphericalMaximal_global_of_unitEntropy
      hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi g hphi_one hphi_zero hphi_norm
      j E hEne hEpos δ N hN hδ
  have hcoeff : 0 ≤ globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N := by
    dsimp only [globalRelativeBandSquareCoefficient]
    positivity
  have hTnonneg (x : Euclidean (n + 1)) : 0 ≤ T g x := by
    exact ENNReal.toReal_nonneg
  have hTint : Integrable (fun x : Euclidean (n + 1) => (T g x) ^ (2 : ℕ)) volume := by
    apply integrable_sq_of_memLp_two_nonneg (T g)
    · simpa only [T] using hmem
    · exact hTnonneg
  have hgint : Integrable (fun x : Euclidean (n + 1) => ‖g x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm g.continuous.aestronglyMeasurable).mp
      (g.memLp 2 volume)
  have hbound' :
      (∫ x : Euclidean (n + 1), (T g x) ^ (2 : ℕ)) ≤
        globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N *
          ∫ x : Euclidean (n + 1), ‖g x‖ ^ (2 : ℕ) := by
    simpa only [T, globalRelativeBandSquareCoefficient,
      Real.norm_of_nonneg ENNReal.toReal_nonneg] using hbound
  have hresult := lintegral_ofReal_sq_le_of_integral_sq_le
    (fun h : SchwartzMap (Euclidean (n + 1)) ℂ => (h : Euclidean (n + 1) → ℂ))
    T g (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N) hcoeff
    hTint hgint hbound'
  simpa only [T] using hresult

/-- The entropy cover used for the `j`th relative band is taken four dyadic
steps below its frequency scale.  This elementary buffer is precisely what
makes the short-interval square estimate uniform in `j`. -/
theorem dyadicMultiplicativeScale_shift_four_short (j : Nat) :
    8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) ≤
      (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j)⁻¹ := by
  have hlog : Real.log 2 ≤ 1 := by
    have h := Real.log_le_sub_one_of_pos (by norm_num : (0 : Real) < 2)
    norm_num at h ⊢
    exact h
  have hdelta : 0 ≤ (dyadicMultiplicativeScale (j + 4) : Real) := by positivity
  calc
    8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) ≤
        8 * 1 * (dyadicMultiplicativeScale (j + 4) : Real) := by gcongr
    _ ≤ (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j)⁻¹ := by
      rw [show (8 : Real) * 1 = 8 by norm_num]
      simp only [dyadicMultiplicativeScale, Auto.Spherical.SurfaceMeasureDecay.dyadicScale,
          NNReal.coe_pow,
        NNReal.coe_inv, NNReal.coe_ofNat]
      rw [pow_add]
      norm_num
      field_simp
      calc
        8 * (1 / 2 : Real) ^ j * 2 ^ j = 8 * ((1 / 2 : Real) * 2) ^ j := by
          rw [mul_assoc]
          rw [← mul_pow]
        _ = 8 := by norm_num
        _ ≤ 16 := by norm_num

theorem dyadicMultiplicativeScale_shift_four_log_two_le_one (j : Nat) :
    Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) ≤ 1 := by
  have hnonneg : 0 ≤ Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) := by
    exact mul_nonneg (Real.log_nonneg (by norm_num)) (by positivity)
  have hscaleone : 1 ≤ Auto.Spherical.SurfaceMeasureDecay.dyadicScale j := by
    unfold Auto.Spherical.SurfaceMeasureDecay.dyadicScale
    exact one_le_pow₀ (by norm_num)
  calc
    Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) ≤
        8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real) := by
          nlinarith
    _ ≤ (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j)⁻¹ :=
        dyadicMultiplicativeScale_shift_four_short j
    _ ≤ 1 := inv_le_one_of_one_le₀ hscaleone


/-- The explicit entropy-square coefficient for a relative band has the
expected `2^{-nj}` envelope when its entropy cover is four scales shorter
than the band. -/
def globalRelativeBandSquareEnvelope
    (n : Nat) (C₀ C₁ : Real) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ENNReal :=
  ENNReal.ofReal 24 * ENNReal.ofReal
    (2 * (4 * C₀) ^ 2 +
      2 * (2 * (8 * C₁ +
        12 * C₀ *
          ‖((SchwartzMap.fderivCLM Complex (Euclidean (n + 1)) Complex)
              phi).toBoundedContinuousFunction‖)) ^ 2)

theorem globalRelativeBandSquareEnvelope_pos
    {n : Nat} {C₀ C₁ : Real} (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hC₀ : 0 < C₀) :
    0 < globalRelativeBandSquareEnvelope n C₀ C₁ phi := by
  unfold globalRelativeBandSquareEnvelope
  apply ENNReal.mul_pos
  · norm_num
  · exact (ENNReal.ofReal_pos.mpr (by
      have hmain : 0 < 2 * (4 * C₀) ^ 2 := by positivity
      positivity)).ne'

theorem globalRelativeBandSquareEnvelope_ne_top
    (n : Nat) (C₀ C₁ : Real) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    globalRelativeBandSquareEnvelope n C₀ C₁ phi ≠ ∞ := by
  unfold globalRelativeBandSquareEnvelope
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top

theorem globalRelativeBandSquareCoefficient_le_dyadicEnvelope
    {n : Nat} (C₀ C₁ : Real) (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hC₀ : 0 < C₀) (hC₁ : 0 < C₁) (j N : Nat) :
    ENNReal.ofReal
      (globalRelativeBandSquareCoefficient n C₀ C₁ phi j
        (dyadicMultiplicativeScale (j + 4)) N) ≤
      globalRelativeBandSquareEnvelope n C₀ C₁ phi * (N : ENNReal) *
        (dyadicMultiplicativeScale j : ENNReal) ^ n := by
  let D : Real :=
    12 * C₀ *
      ‖((SchwartzMap.fderivCLM Complex (Euclidean (n + 1)) Complex)
          phi).toBoundedContinuousFunction‖
  let K : Real := 2 * (4 * C₀) ^ 2 + 2 * (2 * (8 * C₁ + D)) ^ 2
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hinner := ofReal_thinRadialCapEntropySquare_le_dyadicDecay
    (n := n) j C₀ (2 * C₁) D (dyadicMultiplicativeScale (j + 4) : Real)
    hC₀.le (by positivity) hD (by positivity)
    (dyadicMultiplicativeScale_shift_four_short j)
  have hfour : (4 : Real) * (2 * C₁) = 8 * C₁ := by ring
  rw [hfour] at hinner
  have hN : 0 ≤ (N : Real) := Nat.cast_nonneg N
  have htwentyfour : 0 ≤ (24 : Real) := by norm_num
  dsimp only [globalRelativeBandSquareCoefficient, globalRelativeBandSquareEnvelope]
  change ENNReal.ofReal (24 * (N : Real) *
      (2 * ((4 * C₀) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2)) ^ 2 +
        2 * (8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real)) ^ 2 *
          (2 * ((8 * C₁) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2 - 1)
              +
            D / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2))) ^ 2)) ≤
      globalRelativeBandSquareEnvelope n C₀ C₁ phi * (N : ENNReal) *
        (dyadicMultiplicativeScale j : ENNReal) ^ n
  rw [ENNReal.ofReal_mul (mul_nonneg htwentyfour hN),
    ENNReal.ofReal_mul htwentyfour]
  rw [ENNReal.ofReal_natCast]
  unfold globalRelativeBandSquareEnvelope
  change ENNReal.ofReal 24 * (N : ENNReal) * ENNReal.ofReal
      (2 * ((4 * C₀) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2)) ^ 2 +
        2 * (8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real)) ^ 2 *
          (2 * ((8 * C₁) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2 - 1)
              +
            D / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2))) ^ 2) ≤
      ENNReal.ofReal 24 * ENNReal.ofReal K * (N : ENNReal) *
        (dyadicMultiplicativeScale j : ENNReal) ^ n
  calc
    ENNReal.ofReal 24 * (N : ENNReal) * ENNReal.ofReal
        (2 * ((4 * C₀) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2)) ^ 2
            +
          2 * (8 * Real.log 2 * (dyadicMultiplicativeScale (j + 4) : Real)) ^ 2 *
            (2 * ((8 * C₁) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^
                ((n : Real) / 2 - 1) +
              D / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2))) ^ 2) ≤
        ENNReal.ofReal 24 * (N : ENNReal) *
          (ENNReal.ofReal K * (dyadicMultiplicativeScale j : ENNReal) ^ n) := by
          gcongr
    _ = ENNReal.ofReal 24 * ENNReal.ofReal K * (N : ENNReal) *
          (dyadicMultiplicativeScale j : ENNReal) ^ n := by ring

/-- Pointwise finiteness upgrades the raw `ENNReal` subadditivity of a
literal relative band to ordinary real subadditivity.  Finite physical
truncations satisfy this hypothesis automatically, which is the form used
by the C--Z endpoint before all-scale exhaustion. -/
theorem toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_ne_top
    {d : Nat} (E : Set ℝ) (phi f g : SchwartzMap (Euclidean d) ℂ)
    (j : Nat) (x : Euclidean d)
    (hfin : ∀ h : SchwartzMap (Euclidean d) ℂ,
      restrictedRelativeBandpassSphericalMaximal d E phi j h x ≠ ⊤) :
    (restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x).toReal ≤
      (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal +
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal := by
  have hraw := restrictedRelativeBandpassSphericalMaximal_add_le E phi f g j x
  calc
    (restrictedRelativeBandpassSphericalMaximal d E phi j (f + g) x).toReal ≤
        (restrictedRelativeBandpassSphericalMaximal d E phi j f x +
          restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal :=
      (ENNReal.toReal_le_toReal (hfin (f + g))
        (ENNReal.add_ne_top.mpr ⟨hfin f, hfin g⟩)).2 hraw
    _ = (restrictedRelativeBandpassSphericalMaximal d E phi j f x).toReal +
        (restrictedRelativeBandpassSphericalMaximal d E phi j g x).toReal :=
      ENNReal.toReal_add (hfin f) (hfin g)

/-- The all-scale square theorem makes the real-valued literal band
subadditive almost everywhere.  This is the exact regularity needed by the
distribution-function interpolation argument. -/
theorem ae_toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_sharp
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : Real) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : Real) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : Real, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : Real) 2 →
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set Real)
    (g h : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∀ᵐ x ∂volume,
      (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal := by
  have hghmem := restrictedRelativeBandpassSphericalMaximal_memLp_two_global_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E (g + h)
  have hgmem := restrictedRelativeBandpassSphericalMaximal_memLp_two_global_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E g
  have hhmem := restrictedRelativeBandpassSphericalMaximal_memLp_two_global_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E h
  have hghfinite := ae_ne_top_ennreal_of_memLp_two volume
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h)) hghmem.1
  have hgfinite := ae_ne_top_ennreal_of_memLp_two volume
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g) hgmem.1
  have hhfinite := ae_ne_top_ennreal_of_memLp_two volume
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h) hhmem.1
  filter_upwards [hghfinite, hgfinite, hhfinite] with x hgh hg hh
  have hraw := restrictedRelativeBandpassSphericalMaximal_add_le E phi g h j x
  calc
    (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x +
          restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal :=
      (ENNReal.toReal_le_toReal hgh
        (ENNReal.add_ne_top.mpr ⟨hg, hh⟩)).2 hraw
    _ = (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal :=
      ENNReal.toReal_add hg hh

/-- The concrete global band endpoint.  Apart from the elementary
measurability and subadditivity inputs, its sole harmonic-analysis premise
is the continuum weak-`L¹` inequality `hweak_one`; its square input is
discharged by `GlobalEntropyAllScale`. -/
theorem global_relative_band_lintegral_rpow_of_continuum_weak_one
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : ℝ) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set ℝ) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (δ : NNReal) (N : ℕ) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (hsubadd : ∀ (g h : SchwartzMap (Euclidean (n + 1)) ℂ),
      ∀ᵐ x ∂volume,
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal)
    (C₁weak : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        C₁weak * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ) :
    (∫⁻ x, ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^ p)) ≤
      ENNReal.ofReal p *
        (4 * ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N) *
            (((ENNReal.ofReal ((1 : ℝ) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) +
          2 * C₁weak *
            (((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹) *
              ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) := by
  apply schwartz_lintegral_rpow_of_weak_one_and_square
    (fun g x =>
      (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)
    (fun _ _ => ENNReal.toReal_nonneg) hsubadd
    (fun g => by
      exact (measurable_restricted_raw_relative_dyadic_maxima
        phi g hphi_one hphi_zero j E).2.aemeasurable)
    C₁weak (ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N))
    hweak_one
    (fun g => global_relative_band_square_lintegral_of_unitEntropy
      hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E hEne hEpos
      δ N hN hδ g)
    hp1 hp2 f

/-- Factorized form of the global continuum-band endpoint.  Its coefficient
is the only quantity whose geometric decay has to be checked before the
relative-frequency reassembly theorem applies. -/
theorem global_relative_band_lintegral_rpow_of_continuum_weak_one_factorized
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : ℝ) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set ℝ) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (δ : NNReal) (N : ℕ) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (hsubadd : ∀ (g h : SchwartzMap (Euclidean (n + 1)) ℂ),
      ∀ᵐ x ∂volume,
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal)
    (C₁weak : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        C₁weak * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ) :
    (∫⁻ x, ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^ p)) ≤
      weakOneSquareMomentCoefficient p C₁weak
        (ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N)) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  apply schwartz_lintegral_rpow_of_weak_one_and_square_factorized
    (fun g x =>
      (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal)
    (fun _ _ => ENNReal.toReal_nonneg) hsubadd
    (fun g => by
      exact (measurable_restricted_raw_relative_dyadic_maxima
        phi g hphi_one hphi_zero j E).2.aemeasurable)
    C₁weak (ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N))
    hweak_one
    (fun g => global_relative_band_square_lintegral_of_unitEntropy
      hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E hEne hEpos
      δ N hN hδ g)
    hp1 hp2 f

/-- The literal continuum weak-one input, together with the global entropy
square estimate, gives a raw `ENNReal` strong bound for one relative band.
The existing all-positive-radius square theorem supplies the a.e. finiteness
needed to pass safely back from `toReal`. -/
theorem global_relative_band_memLp_eLpNorm_of_continuum_weak_one
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : ℝ) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : ℝ) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set ℝ) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : ℝ))
    (δ : NNReal) (N : ℕ) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : ℝ) ≤ 1)
    (hsubadd : ∀ (g h : SchwartzMap (Euclidean (n + 1)) ℂ),
      ∀ᵐ x ∂volume,
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal)
    (C₁weak : ENNReal) (hC₁weak : C₁weak ≠ ⊤)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean (n + 1)) ℂ) {s : ℝ}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        C₁weak * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    {p : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ) :
    MemLp (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
          (ENNReal.ofReal p) volume ≤
        (weakOneSquareMomentCoefficient p C₁weak
          (ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N))) ^ p⁻¹ *
          eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p) volume := by
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  have hMtwo := restrictedRelativeBandpassSphericalMaximal_memLp_two_global_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E f
  have hMfinite : ∀ᵐ x ∂volume, M x ≠ ⊤ := by
    exact ae_ne_top_ennreal_of_memLp_two volume M (by simpa only [M] using hMtwo.1)
  have hmoment := global_relative_band_lintegral_rpow_of_continuum_weak_one_factorized
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E hEne hEpos
    δ N hN hδ hsubadd C₁weak hweak_one hp1 hp2 f
  have hcoefficient_top :
      weakOneSquareMomentCoefficient p C₁weak
        (ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N)) ≠ ⊤ :=
    weakOneSquareMomentCoefficient_ne_top hp1 hp2 hC₁weak ENNReal.ofReal_ne_top
  exact memLp_and_eLpNorm_ennreal_of_toReal_lintegral_rpow_le volume M
    (by
      simpa only [M] using
        (measurable_restrictedRelativeBandpassSphericalMaximal_global
          E phi f hphi_one hphi_zero j).aemeasurable)
    hMfinite (lt_trans zero_lt_one hp1) hcoefficient_top
    (f : Euclidean (n + 1) → ℂ) (f.memLp (ENNReal.ofReal p) volume)
    (by simpa only [M] using hmoment)

/- The following is the internal balanced interpolation bridge used by the
global endpoint.  Its inputs are the literal weak-one and square constants,
together with explicit finite envelopes for those constants. -/
private theorem global_relative_band_memLp_eLpNorm_of_continuum_weak_one_of_envelopes
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : Real) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : Real) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : Real, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : Real) 2 →
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (j : Nat) (E : Set Real) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : Real))
    (δ : NNReal) (N : Nat) (hN : unitMultiplicativeEntropy E δ ≤ N)
    (hδ : Real.log 2 * (δ : Real) ≤ 1)
    (hsubadd : ∀ (g h : SchwartzMap (Euclidean (n + 1)) Complex),
      ∀ᵐ x ∂volume,
        (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j (g + h) x).toReal ≤
          (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal +
            (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j h x).toReal)
    (Cweak : ENNReal)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean (n + 1)) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        Cweak * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (d₁ d₂ K gain : ENNReal)
    (hd₁zero : d₁ ≠ 0) (hd₁top : d₁ ≠ ∞)
    (hd₂zero : d₂ ≠ 0) (hd₂top : d₂ ≠ ∞)
    (hKtop : K ≠ ∞) (hgaintop : gain ≠ ∞)
    (hweak_env : Cweak ≤ d₁)
    (hsquare_env : ENNReal.ofReal
      (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N) ≤ d₂)
    {p : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hproduct : d₁ ^ (2 - p) * d₂ ^ (p - 1) ≤ K * gain)
    (f : SchwartzMap (Euclidean (n + 1)) Complex) :
    MemLp (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
          (ENNReal.ofReal p) volume ≤
        (ENNReal.ofReal p *
          (4 * (ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
              (ENNReal.ofReal (2 - p))⁻¹) +
            2 * ((ENNReal.ofReal (p - 1))⁻¹ +
              (ENNReal.ofReal (3 - p))⁻¹)) * K * gain) ^ p⁻¹ *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let T : SchwartzMap (Euclidean (n + 1)) Complex → Euclidean (n + 1) → Real :=
    fun g x => (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal
  let c₂ : ENNReal :=
    ENNReal.ofReal (globalRelativeBandSquareCoefficient n C₀ C₁ phi j δ N)
  let κ₂ : ENNReal :=
    ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹
  let κ₁ : ENNReal :=
    (ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹
  let I : ENNReal := ∫⁻ x : Euclidean (n + 1), (ENNReal.ofReal ‖f x‖) ^ p
  obtain ⟨tau, htau, hbalanced⟩ :=
    exists_positive_tau_cap_interpolation_moment_le_of_coefficient_envelopes
      hp1 hp2 hd₁zero hd₁top hd₂zero hd₂top hweak_env
      (by simpa only [c₂] using hsquare_env)
      (le_refl (κ₁ * I)) (le_refl (κ₂ * I)) hproduct
  have hmoment_raw := schwartz_lintegral_rpow_of_weak_one_and_square_scaled
    T (fun _ _ => ENNReal.toReal_nonneg) hsubadd
    (fun g => by
      change AEMeasurable (ENNReal.toReal ∘
        restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g) volume
      exact ENNReal.measurable_toReal.comp_aemeasurable
        (measurable_restrictedRelativeBandpassSphericalMaximal_global E phi g
          hphi_one hphi_zero j).aemeasurable)
    Cweak c₂ hweak_one
    (fun g => global_relative_band_square_lintegral_of_unitEntropy
      hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E hEne hEpos
      δ N hN hδ g)
    hp1 hp2 f tau htau
  have hmoment :
      (∫⁻ x, ENNReal.ofReal ((M x).toReal ^ p)) ≤
        ENNReal.ofReal p * (4 * κ₂ + 2 * κ₁) * K * gain * I := by
    calc
      (∫⁻ x, ENNReal.ofReal ((M x).toReal ^ p)) ≤
          ENNReal.ofReal p *
            (4 * c₂ * ((ENNReal.ofReal tau) ^ (2 - p) * (κ₂ * I)) +
              2 * Cweak * ((ENNReal.ofReal tau) ^ (1 - p) * (κ₁ * I))) := by
            simpa only [M, T, c₂, κ₁, κ₂, I] using hmoment_raw
      _ ≤ ENNReal.ofReal p * (4 * κ₂ + 2 * κ₁) * K * gain * I := hbalanced
  have hMtwo := restrictedRelativeBandpassSphericalMaximal_memLp_two_global_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E f
  have hMfinite : ∀ᵐ x ∂volume, M x ≠ ∞ := by
    exact ae_ne_top_ennreal_of_memLp_two volume M (by simpa only [M] using hMtwo.1)
  have hκ₂top : κ₂ ≠ ∞ := by
    dsimp only [κ₂]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (lt_trans zero_lt_one hp1)
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp2)
  have hκ₁top : κ₁ ≠ ∞ := by
    dsimp only [κ₁]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp1)
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (by linarith)
  have hAtop : ENNReal.ofReal p * (4 * κ₂ + 2 * κ₁) * K * gain ≠ ∞ := by
    refine ENNReal.mul_ne_top
      (ENNReal.mul_ne_top
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_) hKtop) hgaintop
    apply ENNReal.add_ne_top.mpr
    constructor
    · exact ENNReal.mul_ne_top (by norm_num) hκ₂top
    · exact ENNReal.mul_ne_top (by norm_num) hκ₁top
  exact memLp_and_eLpNorm_ennreal_of_toReal_lintegral_rpow_le volume M
    (by
      simpa only [M] using
        (measurable_restrictedRelativeBandpassSphericalMaximal_global
          E phi f hphi_one hphi_zero j).aemeasurable)
    hMfinite (lt_trans zero_lt_one hp1) hAtop
    (f : Euclidean (n + 1) → Complex) (f.memLp (ENNReal.ofReal p) volume)
    (by simpa only [M, κ₁, κ₂, I] using hmoment)

/-- One literal relative band has the balanced strong bound forced by a
linear-in-`j` continuum weak-one estimate and a global unit-entropy bound.
The displayed coefficient is arranged so that the sole remaining global
step is summability of a polynomial times a strict dyadic gain. -/
theorem global_relative_band_memLp_eLpNorm_of_unitEntropy_and_continuum_weak_one
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : Real) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : Real) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : Real, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : Real) 2 →
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (E : Set Real) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : Real))
    {p beta : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (A W : ENNReal) (hAtop : A ≠ ∞)
    (hWpos : 0 < W) (hWtop : W ≠ ∞)
    (N : Nat → Nat)
    (hentropy : ∀ j : Nat,
      unitMultiplicativeEntropy E (dyadicMultiplicativeScale (j + 4)) ≤ N j)
    (hNrate : ∀ j : Nat, (N j : ENNReal) ≤
      A * ((dyadicMultiplicativeScale j : ENNReal)⁻¹) ^ beta)
    (hweak_one : ∀ (j : Nat) (g : SchwartzMap (Euclidean (n + 1)) Complex)
      {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        W * (N j : ENNReal) * ENNReal.ofReal ((j : Real) + 1) *
          ∫⁻ x, ENNReal.ofReal ‖g x‖) :
    ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) Complex),
      MemLp (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
          (ENNReal.ofReal p) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f)
            (ENNReal.ofReal p) volume ≤
          (ENNReal.ofReal p *
            (4 * (ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
                (ENNReal.ofReal (2 - p))⁻¹) +
              2 * ((ENNReal.ofReal (p - 1))⁻¹ +
                (ENNReal.ofReal (3 - p))⁻¹)) *
            ((W * ENNReal.ofReal ((j : Real) + 1)) ^ (2 - p) *
              (globalRelativeBandSquareEnvelope n C₀ C₁ phi) ^ (p - 1) * A) *
            (dyadicMultiplicativeScale j : ENNReal) ^
              ((n : Real) * (p - 1) - beta)) ^ p⁻¹ *
            eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
  intro j f
  let δ : NNReal := dyadicMultiplicativeScale j
  let Q : ENNReal := globalRelativeBandSquareEnvelope n C₀ C₁ phi
  let L : ENNReal := ENNReal.ofReal ((j : Real) + 1)
  let d₁ : ENNReal := W * (N j : ENNReal) * L
  let d₂ : ENNReal := Q * (N j : ENNReal) * (δ : ENNReal) ^ n
  let K : ENNReal := (W * L) ^ (2 - p) * Q ^ (p - 1) * A
  let gain : ENNReal := (δ : ENNReal) ^ ((n : Real) * (p - 1) - beta)
  have hNnat_one : 1 ≤ N j := by
    have hunit := one_le_unitMultiplicativeEntropy_of_nonempty_of_subset_Ioi
      hEne hEpos (dyadicMultiplicativeScale (j + 4))
    exact_mod_cast hunit.trans (hentropy j)
  have hNpos : 0 < (N j : ENNReal) := by
    exact_mod_cast (show 0 < N j by omega)
  have hLpos : 0 < L := by
    dsimp only [L]
    apply ENNReal.ofReal_pos.mpr
    positivity
  have hδpos : 0 < (δ : ENNReal) := by
    dsimp only [δ]
    exact_mod_cast dyadicMultiplicativeScale_pos j
  have hQpos : 0 < Q := by
    dsimp only [Q]
    exact globalRelativeBandSquareEnvelope_pos phi hC₀
  have hd₁zero : d₁ ≠ 0 := by
    dsimp only [d₁]
    exact (ENNReal.mul_pos (ENNReal.mul_pos hWpos.ne' hNpos.ne').ne' hLpos.ne').ne'
  have hd₂zero : d₂ ≠ 0 := by
    dsimp only [d₂]
    exact (ENNReal.mul_pos (ENNReal.mul_pos hQpos.ne' hNpos.ne').ne'
      (pow_ne_zero n hδpos.ne')).ne'
  have hd₁top : d₁ ≠ ∞ := by
    dsimp only [d₁]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top hWtop ENNReal.coe_ne_top)
      ENNReal.ofReal_ne_top
  have hd₂top : d₂ ≠ ∞ := by
    dsimp only [d₂]
    exact ENNReal.mul_ne_top
      (ENNReal.mul_ne_top (globalRelativeBandSquareEnvelope_ne_top n C₀ C₁ phi)
        ENNReal.coe_ne_top)
      (ENNReal.pow_ne_top ENNReal.coe_ne_top)
  have hKtop : K ≠ ∞ := by
    dsimp only [K]
    refine ENNReal.mul_ne_top
      (ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by linarith)
          (ENNReal.mul_ne_top hWtop ENNReal.ofReal_ne_top))
        (ENNReal.rpow_ne_top_of_nonneg (by linarith)
          (globalRelativeBandSquareEnvelope_ne_top n C₀ C₁ phi))) hAtop
  have hgaintop : gain ≠ ∞ := by
    dsimp only [gain]
    exact ENNReal.rpow_ne_top_of_ne_zero hδpos.ne' ENNReal.coe_ne_top
  have hproduct : d₁ ^ (2 - p) * d₂ ^ (p - 1) ≤ K * gain := by
    have hnpos : 0 < (n : Real) := by exact_mod_cast (show 0 < n by omega)
    have halpha : -(n : Real) * (2 - p) < 0 := by
      nlinarith [mul_pos hnpos (sub_pos.mpr hp2)]
    have hmain := strict_negative_cap_product_envelope
      (n := n) (p := p) (alpha := -(n : Real) * (2 - p))
      (epsilon := (n : Real) * (p - 1) - beta) (rho := 0) (sigma := beta)
      hp1 hp2 halpha
      (by ring) (by ring)
      (c1 := d₁) (c2 := d₂) (A := W * L) (B := Q) (W := (1 : ENNReal))
      (N := (N j : ENNReal)) (s := (1 : ENNReal)) (delta := (δ : ENNReal)) (K := A)
      (by norm_num) (by norm_num) hNpos.ne' ENNReal.coe_ne_top
      (by norm_num) (by norm_num) (by norm_num) hδpos.ne' ENNReal.coe_ne_top
      (by
        simpa only [ENNReal.one_rpow, one_mul, mul_one, δ] using hNrate j)
      (by
        dsimp only [d₁]
        apply le_of_eq
        simp only [one_pow]
        ring)
      (by
        dsimp only [d₂]
        apply le_of_eq
        ring)
    calc
      d₁ ^ (2 - p) * d₂ ^ (p - 1) ≤
          (W * L) ^ (2 - p) * Q ^ (p - 1) * 1 * A *
            (δ : ENNReal) ^ ((n : Real) * (p - 1) - beta) := hmain
      _ = K * gain := by
        dsimp only [K, gain]
        ring
  have hsubadd := ae_toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_sharp
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm j E
  have hsquare_env : ENNReal.ofReal
      (globalRelativeBandSquareCoefficient n C₀ C₁ phi j
        (dyadicMultiplicativeScale (j + 4)) (N j)) ≤ d₂ := by
    dsimp only [d₂, Q, δ]
    exact globalRelativeBandSquareCoefficient_le_dyadicEnvelope C₀ C₁ phi hC₀ hC₁ j (N j)
  have hband := global_relative_band_memLp_eLpNorm_of_continuum_weak_one_of_envelopes
    hn C₀ C₁ hC₀ hC₁ hdecay hderiv phi hphi_one hphi_zero hphi_norm
    j E hEne hEpos (dyadicMultiplicativeScale (j + 4)) (N j) (hentropy j)
    (dyadicMultiplicativeScale_shift_four_log_two_le_one j) hsubadd
    d₁ (hweak_one j) d₁ d₂ K gain hd₁zero hd₁top hd₂zero hd₂top hKtop hgaintop
    (le_refl d₁) hsquare_env hp1 hp2 hproduct f
  simpa only [d₁, d₂, K, gain, L, Q, δ] using hband

/-- The standard cutoff and sharp Fourier estimates needed by the global
endpoint are simultaneously available in every spatial dimension at least
two.  The cutoff's compact support follows from its displayed support
condition, so no auxiliary construction is needed later. -/
theorem exists_global_unweighted_endpoint_data
    {d : Nat} (hd : 2 ≤ d) :
    ∃ (phi : SchwartzMap (Euclidean d) ℂ) (C₀ C₁ : ℝ),
      HasCompactSupport (phi : Euclidean d → ℂ) ∧
      (∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1) ∧
      (∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0) ∧
      (∀ ξ, ‖phi ξ‖ ≤ 1) ∧
      0 < C₀ ∧ 0 < C₁ ∧
      (∀ ξ : Euclidean d, 1 ≤ ‖ξ‖ →
        ‖surfaceFourier d ξ‖ ≤ C₀ / ‖ξ‖ ^ (((d - 1 : Nat) : ℝ) / 2)) ∧
      (∀ ξ : Euclidean d, ∀ r : ℝ, 1 ≤ ‖ξ‖ → r ∈ Icc (1 : ℝ) 2 →
        ‖deriv (fun s : ℝ => surfaceFourier d (s • ξ)) r‖ ≤
          C₁ / ‖ξ‖ ^ (((d - 1 : Nat) : ℝ) / 2 - 1)) := by
  by_cases htwo : d = 2
  · subst d
    obtain ⟨phi, hphi_one, hphi_zero, hphi_norm⟩ :=
      exists_schwartz_frequency_cutoff_norm_le_one 2
    obtain ⟨C₀, C₁, hC₀, hC₁, hdecay, hderiv⟩ :=
      Auto.Spherical.SurfaceMeasureDecay.exists_sharp_surfaceFourier_two_decay_and_deriv
    have hphi_compact : HasCompactSupport (phi : Euclidean 2 → ℂ) := by
      apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) 2)
      intro ξ hξ
      apply hphi_zero ξ
      have hlt : 2 < ‖ξ‖ := by
        rw [Metric.mem_closedBall, dist_zero_right] at hξ
        exact lt_of_not_ge hξ
      exact hlt.le
    refine ⟨phi, C₀, C₁, hphi_compact, hphi_one, hphi_zero, hphi_norm,
      hC₀, hC₁, ?_, ?_⟩
    · simpa using hdecay
    · simpa using hderiv
  · have hd' : 2 ≤ d - 1 := by omega
    have hdim : d - 1 + 1 = d := by omega
    obtain ⟨phi, hphi_one, hphi_zero, hphi_norm⟩ :=
      exists_schwartz_frequency_cutoff_norm_le_one d
    obtain ⟨C₀, C₁, hC₀, hC₁, hdecay, hderiv⟩ :=
      exists_sharp_surfaceFourier_succ_decay_and_deriv (d := d - 1) hd'
    rw [hdim] at hdecay hderiv
    have hphi_compact : HasCompactSupport (phi : Euclidean d → ℂ) := by
      apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean d) 2)
      intro ξ hξ
      apply hphi_zero ξ
      have hlt : 2 < ‖ξ‖ := by
        rw [Metric.mem_closedBall, dist_zero_right] at hξ
        exact lt_of_not_ge hξ
      exact hlt.le
    refine ⟨phi, C₀, C₁, hphi_compact, hphi_one, hphi_zero, hphi_norm,
      hC₀, hC₁, ?_, ?_⟩
    · exact hdecay
    · exact hderiv

/-- The global entropy and literal continuum weak-one inputs give the
unweighted restricted maximal estimate in every dimension `n + 1 ≥ 2`.

This is the all-scale endpoint assembly itself.  The entropy witness is
written at the shifted scales used by the relative band square estimate;
the weak-one input is deliberately literal, with no replacement by a finite
radius or finite-frequency maximum. -/
theorem hasRestrNormdSphMaxPowerWtStrongType_zero_of_glob_unitEnt_and_contm_weak_one
    {n : Nat} (hn : 1 ≤ n) (C₀ C₁ : Real) (hC₀ : 0 < C₀) (hC₁ : 0 < C₁)
    (hdecay : ∀ ξ : Euclidean (n + 1), 1 ≤ ‖ξ‖ →
      ‖surfaceFourier (n + 1) ξ‖ ≤ C₀ / ‖ξ‖ ^ ((n : Real) / 2))
    (hderiv : ∀ ξ : Euclidean (n + 1), ∀ r : Real, 1 ≤ ‖ξ‖ →
      r ∈ Icc (1 : Real) 2 →
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • ξ)) r‖ ≤
        C₁ / ‖ξ‖ ^ ((n : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphi_compact : HasCompactSupport (phi : Euclidean (n + 1) → Complex))
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (E : Set Real) (hEne : E.Nonempty) (hEpos : E ⊆ Ioi (0 : Real))
    {p beta : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : beta < (n : Real) * (p - 1))
    (A W : ENNReal) (hAtop : A ≠ ∞) (hWpos : 0 < W) (hWtop : W ≠ ∞)
    (N : Nat → Nat)
    (hentropy : ∀ j : Nat,
      unitMultiplicativeEntropy E (dyadicMultiplicativeScale (j + 4)) ≤ N j)
    (hNrate : ∀ j : Nat, (N j : ENNReal) ≤
      A * ((dyadicMultiplicativeScale j : ENNReal)⁻¹) ^ beta)
    (hweak_one : ∀ (j : Nat) (g : SchwartzMap (Euclidean (n + 1)) Complex)
      {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x |
        s < (restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal} ≤
        W * (N j : ENNReal) * ENNReal.ofReal ((j : Real) + 1) *
          ∫⁻ x, ENNReal.ofReal ‖g x‖) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType (n + 1) E p 0 := by
  let Q : ENNReal := globalRelativeBandSquareEnvelope n C₀ C₁ phi
  let κ₂ : ENNReal :=
    ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹
  let κ₁ : ENNReal :=
    (ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹
  let epsilon : Real := (n : Real) * (p - 1) - beta
  have hepsilon : 0 < epsilon := by
    dsimp only [epsilon]
    linarith
