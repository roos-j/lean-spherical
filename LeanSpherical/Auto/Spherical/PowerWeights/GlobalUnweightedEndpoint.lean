      _ ≤ SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) :=
        SchwartzMap.norm_pow_mul_le_seminorm ℂ
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (d + 2) 0
  have hP : 0 ≤
      (2 * SchwartzMap.seminorm ℂ (d + 2) 0 (𝓕⁻ psi) * (16 / 3 : ℝ) *
