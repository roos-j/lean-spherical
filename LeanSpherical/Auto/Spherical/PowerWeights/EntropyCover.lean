/-- Base-two exponentiation inverts `logRadius` on positive radii. -/
theorem two_rpow_logRadius (r : PositiveRadius) :
    (2 : ℝ) ^ logRadius r = (r : ℝ) := by
  rw [logRadius, Real.rpow_def_of_pos (by norm_num)]
  rw [mul_div_cancel₀ _ (ne_of_gt (Real.log_pos (by norm_num : (1 : ℝ) < 2)))]
  exact Real.exp_log r.2

/-- A finite entropy bound supplies physical intervals which cover every
positive radius in `E`; their endpoints are the inverse logarithmic images
of the covering cells. -/
theorem exists_finset_physical_radius_cover_of_multiplicativeEntropy_le
    (E : Set ℝ) (δ : ℝ≥0) (N : ℕ)
    (hN : multiplicativeEntropy E δ ≤ N) :
    ∃ C : Finset ℝ, C.card ≤ N ∧
      ∀ r : PositiveRadius, (r : ℝ) ∈ E → ∃ c ∈ C,
        (2 : ℝ) ^ (c - (δ : ℝ) / 2) ≤ (r : ℝ) ∧
          (r : ℝ) ≤ (2 : ℝ) ^ (c + (δ : ℝ) / 2) := by
  obtain ⟨C, hcard, hcover⟩ :=
    exists_finset_logRadius_cover_of_multiplicativeEntropy_le E δ N hN
  refine ⟨C, hcard, ?_⟩
  intro r hr
  obtain ⟨c, hc, hdist⟩ := hcover r hr
  have hbounds := abs_le.mp hdist
  have hlow : c - (δ : ℝ) / 2 ≤ logRadius r := by linarith
  have hhigh : logRadius r ≤ c + (δ : ℝ) / 2 := by linarith
  have hmono := (Real.strictMono_rpow_of_base_gt_one (by norm_num : (1 : ℝ) < 2)).monotone
  refine ⟨c, hc, ?_, ?_⟩
  · simpa only [two_rpow_logRadius] using hmono hlow
  · simpa only [two_rpow_logRadius] using hmono hhigh

/-- The physical cells of a finite entropy cover can be packaged as a finite
