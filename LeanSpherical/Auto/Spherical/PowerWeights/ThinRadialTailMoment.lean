    _ = ∫⁻ _x in B, Q ^ p ∂powerWeightedVolume (n + 1) alpha := by
          rw [lintegral_indicator hB]
    _ = Q ^ p * powerWeightedVolume (n + 1) alpha B := setLIntegral_const _ _

end

end Auto.Spherical.PowerWeights.ThinRadialTailMoment