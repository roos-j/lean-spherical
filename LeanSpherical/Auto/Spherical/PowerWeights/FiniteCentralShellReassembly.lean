private theorem lintegral_biUnion_finset_le
    {X : Type*} [MeasurableSpace X] (mu : Measure X) (F : X → ENNReal)
    (S : Finset Int) (T : Int → Set X) :
    (∫⁻ x in ⋃ l ∈ (S : Set Int), T l, F x ∂mu) ≤
      ∑ l ∈ S, ∫⁻ x in T l, F x ∂mu := by
  classical
  induction S using Finset.induction_on with
  | empty => simp
  | insert l S hl hS =>
      calc
        (∫⁻ x in ⋃ q ∈ ((insert l S : Finset Int) : Set Int), T q, F x ∂mu) =
            ∫⁻ x in T l ∪ ⋃ q ∈ (S : Set Int), T q, F x ∂mu := by
              have hset :
                  (⋃ q ∈ ((insert l S : Finset Int) : Set Int), T q) =
                    T l ∪ ⋃ q ∈ (S : Set Int), T q := by
                ext x
                simp only [Set.mem_iUnion, Set.mem_union, Finset.mem_coe,
                  Finset.mem_insert]
                constructor
                · rintro ⟨q, hq, hx⟩
                  rcases hq with rfl | hq
                  · exact Or.inl hx
                  · exact Or.inr ⟨q, hq, hx⟩
                · rintro (hx | ⟨q, hq, hx⟩)
                  · exact ⟨l, Or.inl rfl, hx⟩
                  · exact ⟨q, Or.inr hq, hx⟩
              rw [hset]
        _ ≤ (∫⁻ x in T l, F x ∂mu) +
            ∫⁻ x in ⋃ q ∈ (S : Set Int), T q, F x ∂mu :=
          lintegral_union_le F _ _
        _ ≤ (∫⁻ x in T l, F x ∂mu) + ∑ q ∈ S, ∫⁻ x in T q, F x ∂mu :=
          add_le_add le_rfl hS
        _ = ∑ q ∈ insert l S, ∫⁻ x in T q, F x ∂mu := by
          rw [Finset.sum_insert hl]

/-- The ball of radius `1 / 8` is controlled by its deep dyadic subball and
the finitely many dyadic shells down to that subball. -/
theorem lintegral_closedBall_one_eighth_le_closedBall_dyadic_add_finset_shells
    {d : Nat} (j : Nat) (_hj : 4 ≤ j) (alpha : Real)
    (F : Euclidean d → ENNReal) :
    (∫⁻ x in closedBall (0 : Euclidean d) (1 / 8 : Real), F x ∂
      powerWeightedVolume d alpha) ≤
      (∫⁻ x in closedBall (0 : Euclidean d) ((2 : Real) ^ (-(j : Int))), F x ∂
        powerWeightedVolume d alpha) +
        ∑ l ∈ Finset.Icc (-(j : Int)) (-4),
          ∫⁻ x in dyadicSpatialShell d l, F x ∂powerWeightedVolume d alpha := by
  let B : Set (Euclidean d) := closedBall 0 (1 / 8 : Real)
  let D : Set (Euclidean d) := closedBall 0 ((2 : Real) ^ (-(j : Int)))
  let S : Finset Int := Finset.Icc (-(j : Int)) (-4)
  let U : Set (Euclidean d) := ⋃ l ∈ (S : Set Int), dyadicSpatialShell d l
  let mu : Measure (Euclidean d) := powerWeightedVolume d alpha
  have hcover : B ⊆ D ∪ U := by
    intro x hx
    have hxB : ‖x‖ ≤ 1 / 8 := by
      simpa only [B, Metric.mem_closedBall, dist_zero_right] using hx
    by_cases hxdeep : ‖x‖ ≤ (2 : Real) ^ (-(j : Int))
    · exact Or.inl (by
        simpa only [D, Metric.mem_closedBall, dist_zero_right] using hxdeep)
    · right
      have hxgt : (2 : Real) ^ (-(j : Int)) < ‖x‖ := lt_of_not_ge hxdeep
      have hxpos : 0 < ‖x‖ :=
        lt_trans (zpow_pos (by norm_num : (0 : Real) < 2) (-(j : Int))) hxgt
      obtain ⟨l, hl⟩ := exists_mem_Ioc_zpow hxpos (by norm_num : (1 : Real) < 2)
      have hlow : -(j : Int) ≤ l := by
        by_contra hnot
        have hle : l + 1 ≤ -(j : Int) := by omega
        have hpow : (2 : Real) ^ (l + 1) ≤ (2 : Real) ^ (-(j : Int)) := by
          apply zpow_le_zpow_right₀ (by norm_num)
          exact hle
        exact hxdeep (hl.2.trans hpow)
      have hhigh : l ≤ -4 := by
        by_contra hnot
        have hle : (-3 : Int) ≤ l := by omega
        have hpow : (2 : Real) ^ (-3 : Int) ≤ (2 : Real) ^ l := by
          apply zpow_le_zpow_right₀ (by norm_num)
          exact hle
        have hlarge : (1 / 8 : Real) < ‖x‖ := by
          calc
            (1 / 8 : Real) = (2 : Real) ^ (-3 : Int) := by norm_num
            _ ≤ (2 : Real) ^ l := hpow
            _ < ‖x‖ := hl.1
        exact (not_lt_of_ge hxB) hlarge
      refine Set.mem_iUnion.2 ⟨l, ?_⟩
      refine Set.mem_iUnion.2 ⟨Finset.mem_Icc.mpr ⟨hlow, hhigh⟩, ?_⟩
      exact hl
  calc
    (∫⁻ x in closedBall (0 : Euclidean d) (1 / 8 : Real), F x ∂
      powerWeightedVolume d alpha) = ∫⁻ x in B, F x ∂mu := by rfl
    _ ≤ ∫⁻ x in D ∪ U, F x ∂mu := lintegral_mono_set hcover
    _ ≤ (∫⁻ x in D, F x ∂mu) + ∫⁻ x in U, F x ∂mu :=
      lintegral_union_le F D U
    _ ≤ (∫⁻ x in D, F x ∂mu) +
        ∑ l ∈ S, ∫⁻ x in dyadicSpatialShell d l, F x ∂mu :=
      add_le_add le_rfl
        (lintegral_biUnion_finset_le mu F S (dyadicSpatialShell d))
    _ = (∫⁻ x in closedBall (0 : Euclidean d) ((2 : Real) ^ (-(j : Int))), F x ∂
        powerWeightedVolume d alpha) +
        ∑ l ∈ Finset.Icc (-(j : Int)) (-4),
          ∫⁻ x in dyadicSpatialShell d l, F x ∂powerWeightedVolume d alpha := by
      rfl

