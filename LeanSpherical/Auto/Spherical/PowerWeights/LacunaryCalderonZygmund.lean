      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r

/-- Changing the physical radius is exactly a normalized Euclidean dilation
of the radius-one relative-band kernel. -/
theorem lacunaryRelativeBandpassPhysicalKernel_dilate
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalKernel psi j r x =
      ((r⁻¹) ^ d : ℝ) •
        lacunaryRelativeBandpassPhysicalKernel psi j 1 (r⁻¹ • x) := by
  unfold lacunaryRelativeBandpassPhysicalKernel
  have hpow : (2 : ℝ) ^ j ≠ 0 := by positivity
  have hrne : r ≠ 0 := hr.ne'
  unfold sphericalAverage
  rw [← integral_smul]
  apply integral_congr_ae
  filter_upwards with w
  have hsr : (((2 : ℝ) ^ j)⁻¹ * r)⁻¹ = (2 : ℝ) ^ j * r⁻¹ := by
    field_simp
  have hsone : (((2 : ℝ) ^ j)⁻¹ * 1)⁻¹ = (2 : ℝ) ^ j := by
    field_simp
  rw [hsr, hsone]
  simp only [Complex.real_smul, smul_add, smul_smul, one_smul]
  have hcoef : ((2 : ℝ) ^ j * r⁻¹) ^ d = r⁻¹ ^ d * ((2 : ℝ) ^ j) ^ d := by
    rw [mul_pow]
    ring
  rw [hcoef, Complex.ofReal_mul, mul_smul]
  have hxr : (2 : ℝ) ^ j * r⁻¹ * r = (2 : ℝ) ^ j := by
    field_simp
  rw [hxr]
  rw [smul_smul]
  simp only [smul_eq_mul]
  ring

/-- The physical convolution action of one selected lacunary radius. -/
def lacunaryRelativeBandpassPhysicalTerm
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) (r : ℝ)
    (g : Euclidean d → ℂ) : Euclidean d → ℂ :=
  fun x => ∫ y : Euclidean d, g y *
    lacunaryRelativeBandpassPhysicalKernel psi j r (x - y)

/-- The literal finite physical maximum.  The nonempty hypothesis is exactly
what is needed for a finite truncation of the selected radii. -/
def lacunaryRelativeBandpassFinitePhysicalMaximal
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (g : Euclidean d → ℂ) : Euclidean d → ℝ :=
  fun x => S.sup' hS (fun k =>
    ‖lacunaryRelativeBandpassPhysicalTerm psi j (r k : ℝ) g x‖)

/-- The test-function adjoint of the literal convolution kernel.  It is
written in the order naturally produced by the `L²` inner product. -/
def convolutionPhysicalAdjoint
    {d : Nat} (K : Euclidean d → ℂ) (h : Euclidean d → ℂ) :
    Euclidean d → ℂ :=
  fun y => ∫ x : Euclidean d, h x * conj (K (x - y))

theorem lacunaryRelativeBandpassPhysicalTerm_eq_integral
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) (r : ℝ)
    (g : Euclidean d → ℂ) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalTerm psi j r g x =
      ∫ y : Euclidean d, g y *
        lacunaryRelativeBandpassPhysicalKernel psi j r (x - y) := rfl

/-- For Schwartz input, the literal physical convolution at one selected
radius is exactly its relative surface Fourier multiplier. -/
theorem lacunaryRelativeBandpassPhysicalTerm_eq_fourier
    {d : Nat} (psi f : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalTerm psi j r (f : Euclidean d → ℂ) x =
      𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r • ξ) * psi (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) *
          𝓕 (f : Euclidean d → ℂ) ξ) x := by
  symm
  simpa only [lacunaryRelativeBandpassPhysicalTerm,
    lacunaryRelativeBandpassPhysicalKernel] using
    fourierInv_relative_surface_scaled_schwartz_multiplier_eq_integral_sphericalAverage
      psi f j hr x

/-- If `psi` is the fixed dyadic difference kernel, the physical selected
action is the literal relative-frequency band in the Fourier decomposition. -/
theorem lacunaryRelativeBandpassPhysicalTerm_eq_relative_bandpass
    {d : Nat} (phi psi f : SchwartzMap (Euclidean d) ℂ)
    (hpsi : ∀ ξ : Euclidean d, psi ξ = phi ((2 : ℝ)⁻¹ • ξ) - phi ξ)
    (j : Nat) {r : ℝ} (hr : 0 < r) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalTerm psi j r (f : Euclidean d → ℂ) x =
      𝓕⁻ (fun ξ : Euclidean d =>
        surfaceFourier d (-r • ξ) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))) *
          𝓕 (f : Euclidean d → ℂ) ξ) x := by
  rw [lacunaryRelativeBandpassPhysicalTerm_eq_fourier psi f j hr]
  apply congrArg (fun g : Euclidean d → ℂ => 𝓕⁻ g x)
  funext ξ
  rw [hpsi (((2 : ℝ) ^ j)⁻¹ • (r • ξ))]
  have hscale : (2 : ℝ)⁻¹ • (((2 : ℝ) ^ j)⁻¹ • (r • ξ)) =
      ((2 : ℝ) ^ (j + 1))⁻¹ • (r • ξ) := by
    rw [smul_smul]
    congr 1
    rw [pow_succ, mul_inv_rev]
  rw [hscale]

private theorem lacunaryRelativeBandpassPhysical_scale_pos
    (j : Nat) {r : ℝ} (hr : 0 < r) :
    0 < (((2 : ℝ) ^ j)⁻¹ * r)⁻¹ := by
  apply inv_pos.mpr
  exact mul_pos (inv_pos.mpr (pow_pos (by norm_num) _)) hr

theorem continuous_lacunaryRelativeBandpassPhysicalKernel
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r) :
    Continuous (lacunaryRelativeBandpassPhysicalKernel psi j r) := by
  let s : ℝ := (((2 : ℝ) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    exact lacunaryRelativeBandpassPhysical_scale_pos j hr
  change Continuous (sphericalAverage d
    (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r)
  exact continuous_sphericalAverage_complexScaled_fourierInv psi hs r

theorem integrable_lacunaryRelativeBandpassPhysicalKernel
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r) :
    Integrable (lacunaryRelativeBandpassPhysicalKernel psi j r) volume := by
  let s : ℝ := (((2 : ℝ) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    exact lacunaryRelativeBandpassPhysical_scale_pos j hr
  change Integrable (sphericalAverage d
    (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r) volume
  have hbasecont : Continuous (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) := by
    change Continuous (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) *
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z))
    exact continuous_const.mul
      ((𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).continuous.comp
        ((continuous_const : Continuous fun _ : Euclidean d => s).smul continuous_id))
  have hbaseint : Integrable (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) volume := by
    simpa only [Complex.real_smul, smul_eq_mul] using integrable_scaled_fourierInv psi hs
  exact integrable_sphericalAverage _ hbasecont hbaseint r

theorem norm_lacunaryRelativeBandpassPhysicalKernel_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r)
    (x : Euclidean d) :
    ‖lacunaryRelativeBandpassPhysicalKernel psi j r x‖ ≤
      (((((2 : ℝ) ^ j)⁻¹ * r)⁻¹) ^ d *
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ).toBoundedContinuousFunction‖) *
          surfaceMass d := by
  let s : ℝ := (((2 : ℝ) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    exact lacunaryRelativeBandpassPhysical_scale_pos j hr
  change ‖sphericalAverage d
    (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
      (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r x‖ ≤ _
  simpa only [s] using
    norm_sphericalAverage_complexScaled_fourierInv_le psi hs r x

theorem integrable_lacunaryRelativeBandpassPhysicalTerm
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r)
    (g : Euclidean d → ℂ) (hg : Integrable g volume) :
    Integrable (lacunaryRelativeBandpassPhysicalTerm psi j r g) volume := by
  let K := lacunaryRelativeBandpassPhysicalKernel psi j r
  have hK : Integrable K volume :=
    integrable_lacunaryRelativeBandpassPhysicalKernel psi j hr
  have hconv : Integrable
      (g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] K) volume :=
    hg.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  change Integrable (g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume]
    lacunaryRelativeBandpassPhysicalKernel psi j r) volume
  exact hconv

/-- Every one literal relative-band physical action has a scale-uniform
`L¹` bound.  This is the estimate used for the finitely many radii lying
between a Calderón--Zygmund cube scale and its frequency-shifted scale. -/
theorem integral_norm_lacunaryRelativeBandpassPhysicalTerm_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r)
    (g : Euclidean d → ℂ) (hg : Integrable g volume) :
    (∫ x : Euclidean d, ‖lacunaryRelativeBandpassPhysicalTerm psi j r g x‖) ≤
      (∫ x : Euclidean d, ‖g x‖) *
        (surfaceMass d *
          ∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) := by
  let K : Euclidean d → ℂ := lacunaryRelativeBandpassPhysicalKernel psi j r
  have hK : Integrable K volume :=
    integrable_lacunaryRelativeBandpassPhysicalKernel psi j hr
  have hconv :
      (∫ x : Euclidean d,
        ‖(g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] K) x‖) ≤
        (∫ x : Euclidean d, ‖g x‖) * (∫ x : Euclidean d, ‖K x‖) :=
    integral_norm_convolution_mul_le g K hg hK
  let s : ℝ := (((2 : ℝ) ^ j)⁻¹ * r)⁻¹
  have hs : 0 < s := by
    dsimp [s]
    exact lacunaryRelativeBandpassPhysical_scale_pos j hr
  have hkernel :
      (∫ x : Euclidean d, ‖K x‖) ≤
        surfaceMass d *
          ∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖ := by
    change (∫ x : Euclidean d,
      ‖sphericalAverage d
        (fun z : Euclidean d => ((s ^ d : ℝ) : ℂ) •
          (𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) (s • z)) r x‖) ≤ _
    simpa only [s] using
      integral_norm_sphericalAverage_scaled_fourierInv_le psi hs r
  calc
    (∫ x : Euclidean d, ‖lacunaryRelativeBandpassPhysicalTerm psi j r g x‖) =
        ∫ x : Euclidean d,
          ‖(g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] K) x‖ := by
          rfl
    _ ≤ (∫ x : Euclidean d, ‖g x‖) * (∫ x : Euclidean d, ‖K x‖) := hconv
    _ ≤ (∫ x : Euclidean d, ‖g x‖) *
        (surfaceMass d *
          ∫ x : Euclidean d,
            ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) ℂ) x‖) :=
      mul_le_mul_of_nonneg_left hkernel (integral_nonneg fun _ => norm_nonneg _)

theorem integrable_convolution_integrand_of_norm_le
    {d : Nat} (K g : Euclidean d → ℂ) (hK : Integrable K volume)
    (hg : Integrable g volume) (B : ℝ)
    (hgB : ∀ x, ‖g x‖ ≤ B) (x : Euclidean d) :
    Integrable (fun y : Euclidean d => g y * K (x - y)) volume := by
  have hmajor : Integrable (fun y : Euclidean d => B * ‖K (x - y)‖) volume :=
    (hK.comp_sub_left x).norm.const_mul B
  refine hmajor.mono' ?_ (Filter.Eventually.of_forall fun y => ?_)
  · exact hg.aestronglyMeasurable.mul (hK.comp_sub_left x).aestronglyMeasurable
  · rw [norm_mul]
    exact mul_le_mul_of_nonneg_right (hgB y) (norm_nonneg _)

theorem convolution_integral_sub
    {d : Nat} (K f g : Euclidean d → ℂ) (hK : Integrable K volume)
    (hf : Integrable f volume) (hg : Integrable g volume)
    (Bf Bg : ℝ) (hfB : ∀ x, ‖f x‖ ≤ Bf) (hgB : ∀ x, ‖g x‖ ≤ Bg)
    (x : Euclidean d) :
    (∫ y : Euclidean d, (f y - g y) * K (x - y)) =
      (∫ y : Euclidean d, f y * K (x - y)) -
        ∫ y : Euclidean d, g y * K (x - y) := by
  rw [← integral_sub
    (integrable_convolution_integrand_of_norm_le K f hK hf Bf hfB x)
    (integrable_convolution_integrand_of_norm_le K g hK hg Bg hgB x)]
  apply integral_congr_ae
  filter_upwards with y
  ring

private theorem memLp_top_schwartz_comp_fst
    {d : Nat} (h : SchwartzMap (Euclidean d) ℂ) :
    MemLp (fun p : Euclidean d × Euclidean d => h p.1) ∞ (volume.prod volume) := by
  refine memLp_top_of_bound ?_ ‖h.toBoundedContinuousFunction‖
    (Filter.Eventually.of_forall fun p => ?_)
  · exact h.continuous.aestronglyMeasurable.comp_fst
  · exact BoundedContinuousFunction.norm_coe_le_norm h.toBoundedContinuousFunction p.1

private theorem integrable_schwartz_convolution_pairing_integrand
    {d : Nat} (K g : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) (hg : Integrable g volume) :
    Integrable (fun p : Euclidean d × Euclidean d =>
      h p.1 * conj (g p.2 * K (p.1 - p.2))) (volume.prod volume) := by
  have hbase : Integrable (fun p : Euclidean d × Euclidean d =>
      g p.2 * K (p.1 - p.2)) (volume.prod volume) := by
    simpa only [ContinuousLinearMap.mul_apply'] using
      hg.convolution_integrand (ContinuousLinearMap.mul ℂ ℂ) hK
  have hstar : Integrable (fun p : Euclidean d × Euclidean d =>
      conj (g p.2 * K (p.1 - p.2))) (volume.prod volume) := by
    change Integrable (fun p : Euclidean d × Euclidean d =>
      (Complex.conjCLE : ℂ →L[ℝ] ℂ) (g p.2 * K (p.1 - p.2))) (volume.prod volume)
    exact (Complex.conjCLE : ℂ →L[ℝ] ℂ).integrable_comp hbase
  convert hstar.mul_of_top_right (memLp_top_schwartz_comp_fst h) using 1; rfl

/-- Fubini identity which identifies the literal physical convolution against
Schwartz test functions.  The only integrability input is `L¹` for the kernel
and the input; Schwartz decay supplies the bounded test factor. -/
theorem integral_schwartz_mul_star_convolution_eq
    {d : Nat} (K g : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) (hg : Integrable g volume) :
    (∫ x : Euclidean d, h x * conj (∫ y : Euclidean d, g y * K (x - y))) =
      ∫ y : Euclidean d,
        (∫ x : Euclidean d, h x * conj (K (x - y))) * conj (g y) := by
  have hF := integrable_schwartz_convolution_pairing_integrand K g h hK hg
  calc
    (∫ x : Euclidean d, h x * conj (∫ y : Euclidean d, g y * K (x - y))) =
        ∫ x : Euclidean d, ∫ y : Euclidean d,
          h x * conj (g y * K (x - y)) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [← integral_conj, ← integral_const_mul]
    _ = ∫ y : Euclidean d, ∫ x : Euclidean d,
          h x * conj (g y * K (x - y)) := by
      simpa only [Function.uncurry] using integral_integral_swap hF
    _ = ∫ y : Euclidean d,
        (∫ x : Euclidean d, h x * conj (K (x - y))) * conj (g y) := by
      apply integral_congr_ae
      filter_upwards with y
      rw [← integral_mul_const]
      apply integral_congr_ae
      filter_upwards with x
      rw [(starRingEnd ℂ).map_mul]
      ring

/-- An integrable bounded input convolved with an integrable kernel is in
`L²`.  We only use this elementary `L¹∩L∞` fact to put the literal physical
representative of a C--Z good part into `L²`; it is not used for the sharp
square estimate. -/
theorem memLp_two_convolution_of_integrable_of_norm_le
    {d : Nat} (K g : Euclidean d → ℂ) (hK : Integrable K volume)
    (hg : Integrable g volume) (B : ℝ) (hB : 0 ≤ B)
    (hgB : ∀ x, ‖g x‖ ≤ B) :
    MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume := by
  let P : Euclidean d → ℂ := fun x => ∫ y : Euclidean d, g y * K (x - y)
  have hP : Integrable P volume := by
    change Integrable (g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] K) volume
    exact hg.integrable_convolution (ContinuousLinearMap.mul ℂ ℂ) hK
  have hC : 0 ≤ B * ∫ y : Euclidean d, ‖K y‖ :=
    mul_nonneg hB (integral_nonneg fun _ => norm_nonneg _)
  have hPbound (x : Euclidean d) : ‖P x‖ ≤ B * ∫ y : Euclidean d, ‖K y‖ := by
    have hmajor : Integrable (fun y : Euclidean d => B * ‖K (x - y)‖) volume :=
      (hK.comp_sub_left x).norm.const_mul B
    have hint : Integrable (fun y : Euclidean d => g y * K (x - y)) volume :=
      integrable_convolution_integrand_of_norm_le K g hK hg B hgB x
    have hintnorm : Integrable (fun y : Euclidean d => ‖g y‖ * ‖K (x - y)‖) volume := by
      convert hint.norm using 1
      funext y
      rw [norm_mul]
    calc
      ‖P x‖ ≤ ∫ y : Euclidean d, ‖g y * K (x - y)‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean d, ‖g y‖ * ‖K (x - y)‖ := by
        apply integral_congr_ae
        filter_upwards with y
        rw [norm_mul]
      _ ≤ ∫ y : Euclidean d, B * ‖K (x - y)‖ :=
        integral_mono hintnorm hmajor (fun y =>
          mul_le_mul_of_nonneg_right (hgB y) (norm_nonneg _))
      _ = B * ∫ y : Euclidean d, ‖K y‖ := by
        rw [integral_const_mul,
          integral_sub_left_eq_self (fun y : Euclidean d => ‖K y‖) volume x]
  have hsq : Integrable (fun x : Euclidean d => ‖P x‖ ^ 2) volume := by
    refine (hP.norm.const_mul (B * ∫ y : Euclidean d, ‖K y‖)).mono' ?_
      (Filter.Eventually.of_forall fun x => ?_)
    · exact (hP.aestronglyMeasurable.norm.pow 2)
    · have hpoint : ‖P x‖ ^ 2 ≤
          (B * ∫ y : Euclidean d, ‖K y‖) * ‖P x‖ := by
        calc
          ‖P x‖ ^ 2 = ‖P x‖ * ‖P x‖ := by ring
          _ ≤ (B * ∫ y : Euclidean d, ‖K y‖) * ‖P x‖ :=
            mul_le_mul_of_nonneg_right (hPbound x) (norm_nonneg _)
      simpa [Real.norm_eq_abs, abs_of_nonneg] using hpoint
  exact (memLp_two_iff_integrable_sq_norm hP.aestronglyMeasurable).2 hsq

theorem memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r)
    (g : Euclidean d → ℂ) (hg : Integrable g volume) (B : ℝ) (hB : 0 ≤ B)
    (hgB : ∀ x, ‖g x‖ ≤ B) :
    MemLp (lacunaryRelativeBandpassPhysicalTerm psi j r g) 2 volume := by
  change MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y *
    lacunaryRelativeBandpassPhysicalKernel psi j r (x - y)) 2 volume
  exact memLp_two_convolution_of_integrable_of_norm_le
    (lacunaryRelativeBandpassPhysicalKernel psi j r) g
    (integrable_lacunaryRelativeBandpassPhysicalKernel psi j hr) hg B hB hgB

private theorem lacunaryRelativeBandpassPhysicalTerm_sub
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat) {r : ℝ} (hr : 0 < r)
    (f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    lacunaryRelativeBandpassPhysicalTerm psi j r (fun y => f y - g y) x =
      lacunaryRelativeBandpassPhysicalTerm psi j r (f : Euclidean d → ℂ) x -
        lacunaryRelativeBandpassPhysicalTerm psi j r (g : Euclidean d → ℂ) x := by
  change (∫ y : Euclidean d, (f y - g y) *
    lacunaryRelativeBandpassPhysicalKernel psi j r (x - y)) = _
  rw [convolution_integral_sub
    (lacunaryRelativeBandpassPhysicalKernel psi j r)
    (f : Euclidean d → ℂ) (g : Euclidean d → ℂ)
    (integrable_lacunaryRelativeBandpassPhysicalKernel psi j hr)
    f.integrable g.integrable
    ‖f.toBoundedContinuousFunction‖ ‖g.toBoundedContinuousFunction‖
    (fun y => BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction y)
    (fun y => BoundedContinuousFunction.norm_coe_le_norm g.toBoundedContinuousFunction y) x]
  rfl

private theorem exists_lipschitz_lacunaryRelativeBandpassPhysicalTerm_extension
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C : ℝ) (hC : 0 ≤ C)
    (hcoreMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ)) 2 volume)
    (hcoreBound : ∀ f : SchwartzMap (Euclidean d) ℂ,
      ‖(hcoreMem f).toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ))‖ ≤ C * ‖f.toLp 2 volume‖) :
    ∀ k : ↥S, ∃ Tbar :
      Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℂ 2 volume,
      (∀ f : SchwartzMap (Euclidean d) ℂ,
        Tbar (f.toLp 2 volume) =
          (memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
            psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
            ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
            (fun x => BoundedContinuousFunction.norm_coe_le_norm
              f.toBoundedContinuousFunction x)).toLp
            (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
              (f : Euclidean d → ℂ))) ∧
      LipschitzWith C.toNNReal Tbar := by
  classical
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  intro k
  let htermMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
        (f : Euclidean d → ℂ)) 2 volume := fun f =>
    memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
      ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
      (fun x => BoundedContinuousFunction.norm_coe_le_norm
        f.toBoundedContinuousFunction x)
  let Tcore : SchwartzMap (Euclidean d) ℂ → Lp ℂ 2 volume := fun f =>
    (htermMem f).toLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
      (f : Euclidean d → ℂ))
  have hterm_bound (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Tcore f‖ ≤ C * ‖f.toLp 2 volume‖ := by
    calc
      ‖Tcore f‖ ≤ ‖(hcoreMem f).toLp
          (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
            (f : Euclidean d → ℂ))‖ := by
        apply Lp.norm_le_norm_of_ae_le
        filter_upwards [
          (htermMem f).coeFn_toLp,
          (hcoreMem f).coeFn_toLp] with x hterm hM
        rw [hterm, hM, Real.norm_of_nonneg]
        · exact Finset.le_sup' (fun n : ℤ =>
            ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
              (f : Euclidean d → ℂ) x‖) k.2
        · exact le_trans (norm_nonneg _)
            (Finset.le_sup' (fun n : ℤ =>
              ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
                (f : Euclidean d → ℂ) x‖) hS.choose_spec)
      _ ≤ C * ‖f.toLp 2 volume‖ := hcoreBound f
  have hTcore_zero : Tcore 0 = 0 := by
    apply norm_eq_zero.mp
    apply le_antisymm
    · have hzero : (0 : SchwartzMap (Euclidean d) ℂ).toLp 2 volume = 0 := by
        change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) 0 = 0
        exact map_zero _
      simpa [hzero] using hterm_bound (0 : SchwartzMap (Euclidean d) ℂ)
    · exact norm_nonneg _
  have hTcore_sub (f g : SchwartzMap (Euclidean d) ℂ) :
      Tcore (f - g) = Tcore f - Tcore g := by
    apply Lp.ext
    filter_upwards [(htermMem (f - g)).coeFn_toLp, (htermMem f).coeFn_toLp,
      (htermMem g).coeFn_toLp, Lp.coeFn_sub (Tcore f) (Tcore g)]
      with x hfg hf hg hsub
    calc
      (Tcore (f - g) : Euclidean d → ℂ) x =
          lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (fun y => f y - g y) x := hfg
      _ = lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (f : Euclidean d → ℂ) x -
          lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
            (g : Euclidean d → ℂ) x :=
        lacunaryRelativeBandpassPhysicalTerm_sub psi j (r k.1).2 f g x
      _ = (Tcore f : Euclidean d → ℂ) x - (Tcore g : Euclidean d → ℂ) x := by
        rw [hf, hg]
      _ = ((Tcore f - Tcore g : Lp ℂ 2 volume) : Euclidean d → ℂ) x := hsub.symm
  have hTcore_lip (f g : SchwartzMap (Euclidean d) ℂ) :
      dist (Tcore f) (Tcore g) ≤ C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
    calc
      dist (Tcore f) (Tcore g) = ‖Tcore f - Tcore g‖ := by
        rw [Lp.dist_eq_norm]
        rw [show -Tcore f + Tcore g = -(Tcore f - Tcore g) by abel, norm_neg]
      _ = ‖Tcore (f - g)‖ := by rw [hTcore_sub]
      _ ≤ C * ‖(f - g).toLp 2 volume‖ := hterm_bound (f - g)
      _ = C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
        have htoLp_sub : (f - g).toLp 2 volume =
            f.toLp 2 volume - g.toLp 2 volume := by
          change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) (f - g) =
            (SchwartzMap.toLpCLM ℝ ℂ 2 volume) f -
              (SchwartzMap.toLpCLM ℝ ℂ 2 volume) g
          exact map_sub _ _ _
        rw [htoLp_sub, Lp.dist_eq_norm]
        rw [show -f.toLp 2 volume + g.toLp 2 volume =
          -(f.toLp 2 volume - g.toLp 2 volume) by abel, norm_neg]
  obtain ⟨Tbar, hagree, hLip, _⟩ :=
    exists_lipschitz_extension_of_denseRange_norm_bound
      (e := fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume)
      (a0 := (0 : SchwartzMap (Euclidean d) ℂ))
      (SchwartzMap.denseRange_toLpCLM ENNReal.ofNat_ne_top)
      (by
        simpa only [SchwartzMap.toLpCLM_apply] using
          (SchwartzMap.injective_toLp (E := Euclidean d) (F := ℂ) 2 volume))
      Tcore C hC
      (by
        change (SchwartzMap.toLpCLM ℝ ℂ 2 volume) 0 = 0
        exact map_zero _)
      hTcore_zero hTcore_lip
  refine ⟨Tbar, ?_, hLip⟩
  intro f
  simpa only [Tcore, htermMem] using hagree f

private def lpPointwiseNorm {d : Nat}
    (F : Lp ℂ 2 (volume : Measure (Euclidean d))) :
    Lp ℝ 2 (volume : Measure (Euclidean d)) :=
  (Lp.memLp F).norm.toLp (fun x => ‖(F : Euclidean d → ℂ) x‖)

private theorem lpPointwiseNorm_coe {d : Nat}
    (F : Lp ℂ 2 (volume : Measure (Euclidean d))) :
    (lpPointwiseNorm F : Euclidean d → ℝ) =ᵐ[volume]
      fun x => ‖(F : Euclidean d → ℂ) x‖ := by
  exact (Lp.memLp F).norm.coeFn_toLp

private theorem continuous_lpPointwiseNorm {d : Nat} :
    Continuous (lpPointwiseNorm :
      Lp ℂ 2 (volume : Measure (Euclidean d)) →
        Lp ℝ 2 (volume : Measure (Euclidean d))) := by
  refine (show LipschitzWith (1 : NNReal) lpPointwiseNorm from ?_).continuous
  apply LipschitzWith.of_dist_le_mul
  intro F G
  simp only [NNReal.coe_one, one_mul]
  rw [Lp.dist_eq_norm, Lp.dist_eq_norm]
  apply Lp.norm_le_norm_of_ae_le
  filter_upwards [lpPointwiseNorm_coe F, lpPointwiseNorm_coe G,
    Lp.coeFn_neg (lpPointwiseNorm F),
    Lp.coeFn_add (-lpPointwiseNorm F) (lpPointwiseNorm G),
    Lp.coeFn_neg F, Lp.coeFn_add (-F) G] with x hF hG hneg hsum hFneg hFG
  simp only [Pi.add_apply, Pi.neg_apply] at hneg hsum hFneg hFG
  rw [hsum, hneg, hF, hG, hFG, hFneg, Real.norm_eq_abs]
  calc
    abs (-‖(F : Euclidean d → ℂ) x‖ + ‖(G : Euclidean d → ℂ) x‖) =
        abs (-(‖(F : Euclidean d → ℂ) x‖ - ‖(G : Euclidean d → ℂ) x‖)) := by
          congr 1
          ring
    _ = abs (‖(F : Euclidean d → ℂ) x‖ - ‖(G : Euclidean d → ℂ) x‖) := abs_neg _
    _ ≤ ‖(F : Euclidean d → ℂ) x - (G : Euclidean d → ℂ) x‖ :=
      abs_norm_sub_norm_le _ _
    _ = ‖-(F : Euclidean d → ℂ) x + (G : Euclidean d → ℂ) x‖ := by
      rw [show -(F : Euclidean d → ℂ) x + (G : Euclidean d → ℂ) x =
        -((F : Euclidean d → ℂ) x - (G : Euclidean d → ℂ) x) by abel,
        norm_neg]

private theorem memLp_two_convolutionPhysicalAdjoint_schwartz
    {d : Nat} (K : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) :
    MemLp (convolutionPhysicalAdjoint K h) 2 volume := by
  let Kstar : Euclidean d → ℂ := fun z => conj (K (-z))
  have hKneg : Integrable (fun z : Euclidean d => K (-z)) volume := by
    simpa using hK.comp_neg
  have hKstar : Integrable Kstar volume := by
    change Integrable (fun z : Euclidean d =>
      (Complex.conjCLE : ℂ →L[ℝ] ℂ) (K (-z))) volume
    exact (Complex.conjCLE : ℂ →L[ℝ] ℂ).integrable_comp hKneg
  have hconv := memLp_two_convolution_of_integrable_of_norm_le Kstar
    (h : Euclidean d → ℂ) hKstar h.integrable
    ‖h.toBoundedContinuousFunction‖ (norm_nonneg _)
    (fun x => BoundedContinuousFunction.norm_coe_le_norm h.toBoundedContinuousFunction x)
  have heq : convolutionPhysicalAdjoint K h = fun y : Euclidean d =>
      ∫ x : Euclidean d, h x * Kstar (y - x) := by
    funext y
    apply integral_congr_ae
    filter_upwards with x
    dsimp [convolutionPhysicalAdjoint, Kstar]
    congr 2
    congr 1
    abel
  rw [heq]
  exact hconv

private theorem inner_convolution_eq_physicalAdjoint
    {d : Nat} (K g : Euclidean d → ℂ) (h : SchwartzMap (Euclidean d) ℂ)
    (hK : Integrable K volume) (hg : Integrable g volume)
    (hg2 : MemLp g 2 volume)
    (hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume)
    (hA : MemLp (convolutionPhysicalAdjoint K h) 2 volume) :
    inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
      inner ℂ (hg2.toLp g) (hA.toLp (convolutionPhysicalAdjoint K h)) := by
  rw [L2.inner_def, L2.inner_def]
  have hleft :
      (∫ x : Euclidean d,
        inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) x)
          ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ) x)) =
        ∫ x : Euclidean d, h x * conj (∫ y : Euclidean d, g y * K (x - y)) := by
    apply integral_congr_ae
    filter_upwards [hP.coeFn_toLp, (h.memLp 2 volume).coeFn_toLp] with x hPx hhx
    rw [hPx, hhx, RCLike.inner_apply]
  have hright :
      (∫ y : Euclidean d,
        inner ℂ (hg2.toLp g y) (hA.toLp (convolutionPhysicalAdjoint K h) y)) =
        ∫ y : Euclidean d, convolutionPhysicalAdjoint K h y * conj (g y) := by
    apply integral_congr_ae
    filter_upwards [hg2.coeFn_toLp, hA.coeFn_toLp] with y hgy hAy
    rw [hgy, hAy, RCLike.inner_apply]
  rw [hleft, hright]
  exact integral_schwartz_mul_star_convolution_eq K g h hK hg

private theorem lipschitz_extension_eq_physical_convolution
    {d : Nat} (K : Euclidean d → ℂ)
    (Tbar : Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℂ 2 volume)
    (hTbarCont : Continuous Tbar) (hK : Integrable K volume)
    (hTbarCore : ∀ f : SchwartzMap (Euclidean d) ℂ,
      Tbar (f.toLp 2 volume) =
        (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → ℂ)
          hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
          (fun x => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction x)).toLp
          (fun x : Euclidean d => ∫ y : Euclidean d, f y * K (x - y)))
    (g : Euclidean d → ℂ) (hg : Integrable g volume) (hg2 : MemLp g 2 volume)
    (B : ℝ) (hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B) :
    Tbar (hg2.toLp g) =
      (memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB).toLp
        (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) := by
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  let hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume :=
    memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB
  let hA : ∀ h : SchwartzMap (Euclidean d) ℂ,
      MemLp (convolutionPhysicalAdjoint K h) 2 volume := fun h =>
    memLp_two_convolutionPhysicalAdjoint_schwartz K h hK
  apply (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
    (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).eq_of_inner_left ℂ
  intro h
  have hcorePair (f : SchwartzMap (Euclidean d) ℂ) :
      inner ℂ (Tbar (f.toLp 2 volume))
          ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ (f.toLp 2 volume)
          ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    rw [hTbarCore f]
    exact inner_convolution_eq_physicalAdjoint K (f : Euclidean d → ℂ) h hK f.integrable
      (f.memLp 2 volume)
      (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → ℂ)
        hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
        (fun x => BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction x))
      (hA h)
  have hpairs (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    let left : Lp ℂ 2 (volume : Measure (Euclidean d)) → ℂ := fun G =>
      inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ))
    let right : Lp ℂ 2 (volume : Measure (Euclidean d)) → ℂ := fun G =>
      inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h))
    have hleftCont : Continuous left := by
      change Continuous (fun G : Lp ℂ 2 (volume : Measure (Euclidean d)) =>
        inner ℂ (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)))
      exact continuous_inner.comp (hTbarCont.prodMk continuous_const)
    have hrightCont : Continuous right := by
      change Continuous (fun G : Lp ℂ 2 (volume : Measure (Euclidean d)) =>
        inner ℂ G ((hA h).toLp (convolutionPhysicalAdjoint K h)))
      exact continuous_inner.comp (continuous_id.prodMk continuous_const)
    have heq : left ∘ (fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume) =
        right ∘ (fun f : SchwartzMap (Euclidean d) ℂ => f.toLp 2 volume) := by
      funext f
      exact hcorePair f
    change left G = right G
    exact congrFun
      ((SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
        (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).equalizer hleftCont hrightCont heq) G
  calc
    inner ℂ (Tbar (hg2.toLp g)) ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) =
        inner ℂ (hg2.toLp g) ((hA h).toLp (convolutionPhysicalAdjoint K h)) :=
      hpairs (hg2.toLp g)
    _ = inner ℂ (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → ℂ)) :=
      (inner_convolution_eq_physicalAdjoint K g h hK hg hg2 hP (hA h)).symm

/-- A finite physical lacunary maximum inherits an `L²` estimate from the
corresponding estimate on Schwartz inputs.  The core hypotheses are stated
with the literal finite maximum, so this is the direct bridge used by the
Calderón--Zygmund good part. -/
theorem memLp_two_lacunaryRelativeBandpassFinitePhysicalMaximal_of_core_bound
    {d : Nat} (psi : SchwartzMap (Euclidean d) ℂ) (j : Nat)
    (r : ℤ → PositiveRadius) (S : Finset ℤ) (hS : S.Nonempty)
    (C : ℝ) (hC : 0 ≤ C)
    (hcoreMem : ∀ f : SchwartzMap (Euclidean d) ℂ,
      MemLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
        (f : Euclidean d → ℂ)) 2 volume)
    (hcoreBound : ∀ f : SchwartzMap (Euclidean d) ℂ,
      ‖(hcoreMem f).toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ))‖ ≤ C * ‖f.toLp 2 volume‖)
    (g : Euclidean d → ℂ) (hg : Integrable g volume)
    (hg2 : MemLp g 2 volume) (B : ℝ) (hB : 0 ≤ B)
    (hgB : ∀ x, ‖g x‖ ≤ B) :
    ∃ hmax : MemLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g) 2 volume,
      ‖hmax.toLp
        (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS g)‖ ≤
        C * ‖hg2.toLp g‖ := by
  classical
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  have hindividual :=
    exists_lipschitz_lacunaryRelativeBandpassPhysicalTerm_extension
      psi j r S hS C hC hcoreMem hcoreBound
  choose Tbar hTbarCore hTbarLip using hindividual
  have hSattach : S.attach.Nonempty := by
    rcases hS with ⟨k, hk⟩
    exact ⟨⟨k, hk⟩, by simp⟩
  let Mbar : Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℝ 2 volume := fun G =>
    S.attach.sup' hSattach (fun k => lpPointwiseNorm (Tbar k G))
  have hMbarCont : Continuous Mbar := by
    let U : ↥S → Lp ℂ 2 (volume : Measure (Euclidean d)) → Lp ℝ 2 volume :=
      fun k => lpPointwiseNorm ∘ Tbar k
    change Continuous (fun G => S.attach.sup' hSattach
      (fun k => U k G))
    rw [show (fun G => S.attach.sup' hSattach (fun k => U k G)) =
        S.attach.sup' hSattach U by
          funext G
          exact (Finset.sup'_apply hSattach U G).symm]
    exact Continuous.finset_sup' hSattach
      (fun k _ => continuous_lpPointwiseNorm.comp (hTbarLip k).continuous)
  let coreLp : SchwartzMap (Euclidean d) ℂ → Lp ℝ 2 volume := fun f =>
    (hcoreMem f).toLp (lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
      (f : Euclidean d → ℂ))
  have hTbarCoreCoe (k : ↥S) (f : SchwartzMap (Euclidean d) ℂ) :
      (Tbar k (f.toLp 2 volume) : Euclidean d → ℂ) =ᵐ[volume]
        lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ)
          (f : Euclidean d → ℂ) := by
    rw [hTbarCore k f]
    exact (memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 (f : Euclidean d → ℂ) f.integrable
      ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
      (fun x => BoundedContinuousFunction.norm_coe_le_norm
        f.toBoundedContinuousFunction x)).coeFn_toLp
  have hMbarCoreLe (f : SchwartzMap (Euclidean d) ℂ) :
      Mbar (f.toLp 2 volume) ≤ coreLp f := by
    change S.attach.sup' hSattach (fun k =>
      lpPointwiseNorm (Tbar k (f.toLp 2 volume))) ≤ coreLp f
    apply Finset.sup'_le hSattach _
    intro k _
    apply (Lp.coeFn_le _ _).mp
    filter_upwards [lpPointwiseNorm_coe (Tbar k (f.toLp 2 volume)),
      hTbarCoreCoe k f, (hcoreMem f).coeFn_toLp] with x hN hT hM
    rw [hN, hT, hM]
    exact Finset.le_sup' (fun n : ℤ =>
      ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
        (f : Euclidean d → ℂ) x‖) k.2
  have hCoordNonneg (k : ↥S) (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      0 ≤ lpPointwiseNorm (Tbar k G) := by
    apply (Lp.coeFn_le _ _).mp
    filter_upwards [Lp.coeFn_zero ℝ 2 volume,
      lpPointwiseNorm_coe (Tbar k G)] with x hzero hN
    rw [hzero, hN]
    exact norm_nonneg ((Tbar k G : Euclidean d → ℂ) x)
  have hMbarNonneg (G : Lp ℂ 2 (volume : Measure (Euclidean d))) : 0 ≤ Mbar G := by
    let k0 : ↥S := hSattach.choose
    have hle : lpPointwiseNorm (Tbar k0 G) ≤ Mbar G := by
      change lpPointwiseNorm (Tbar k0 G) ≤
        S.attach.sup' hSattach (fun k => lpPointwiseNorm (Tbar k G))
      exact Finset.le_sup' (fun k => lpPointwiseNorm (Tbar k G)) hSattach.choose_spec
    exact (hCoordNonneg k0 G).trans hle
  have hMbarCoreNorm (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Mbar (f.toLp 2 volume)‖ ≤ ‖coreLp f‖ := by
    apply Lp.norm_le_norm_of_ae_le
    filter_upwards [(Lp.coeFn_le _ _).mpr (hMbarCoreLe f),
      (Lp.coeFn_le _ _).mpr (hMbarNonneg (f.toLp 2 volume)),
      Lp.coeFn_zero ℝ 2 volume, (hcoreMem f).coeFn_toLp]
      with x hle hnonneg hzero hcore
    have hnonneg' : 0 ≤ (Mbar (f.toLp 2 volume) : Euclidean d → ℝ) x := by
      rw [hzero] at hnonneg
      simpa only [Pi.zero_apply] using hnonneg
    have hle' : (Mbar (f.toLp 2 volume) : Euclidean d → ℝ) x ≤
        lacunaryRelativeBandpassFinitePhysicalMaximal psi j r S hS
          (f : Euclidean d → ℂ) x := by
      rw [hcore] at hle
      exact hle
    rw [Real.norm_of_nonneg hnonneg', hcore, Real.norm_of_nonneg]
    · exact hle'
    · exact le_trans (norm_nonneg _)
        (Finset.le_sup' (fun n : ℤ =>
          ‖lacunaryRelativeBandpassPhysicalTerm psi j (r n : ℝ)
            (f : Euclidean d → ℂ) x‖) hS.choose_spec)
  have hMbarCoreBound (f : SchwartzMap (Euclidean d) ℂ) :
      ‖Mbar (f.toLp 2 volume)‖ ≤ C * ‖f.toLp 2 volume‖ := by
    exact (hMbarCoreNorm f).trans (hcoreBound f)
  have hMbarBound (G : Lp ℂ 2 (volume : Measure (Euclidean d))) :
      ‖Mbar G‖ ≤ C * ‖G‖ := by
    refine (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := ℂ)
      (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).induction_on G ?_ ?_
    · exact isClosed_le (continuous_norm.comp hMbarCont)
        (continuous_const.mul continuous_norm)
    · intro f
      simpa only [SchwartzMap.toLpCLM_apply] using hMbarCoreBound f
  let hterm : ∀ k : ↥S,
      MemLp (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g) 2 volume :=
    fun k => memLp_two_lacunaryRelativeBandpassPhysicalTerm_of_integrable_of_norm_le
      psi j (r k.1).2 g hg B hB hgB
  have hTbarPhysical (k : ↥S) :
      Tbar k (hg2.toLp g) =
        (hterm k).toLp
          (lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g) := by
    change Tbar k (hg2.toLp g) = (hterm k).toLp (fun x : Euclidean d =>
      ∫ y : Euclidean d, g y *
        lacunaryRelativeBandpassPhysicalKernel psi j (r k.1 : ℝ) (x - y))
    exact lipschitz_extension_eq_physical_convolution
      (lacunaryRelativeBandpassPhysicalKernel psi j (r k.1 : ℝ))
      (Tbar k) (hTbarLip k).continuous
      (integrable_lacunaryRelativeBandpassPhysicalKernel psi j (r k.1).2)
      (by
        intro f
        rw [hTbarCore k f]
        rfl)
      g hg hg2 B hB hgB
  have hTbarPhysicalCoe (k : ↥S) :
      (Tbar k (hg2.toLp g) : Euclidean d → ℂ) =ᵐ[volume]
        lacunaryRelativeBandpassPhysicalTerm psi j (r k.1 : ℝ) g := by
    rw [hTbarPhysical k]
