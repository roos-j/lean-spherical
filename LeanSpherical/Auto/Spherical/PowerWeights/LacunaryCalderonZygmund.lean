          (∫ y : Euclidean d, ‖b y‖)) := by
  apply add_le_add
  · exact setIntegral_dyadic_lacunary_past_small_radius_atom_signed_tail_le
      hd psi r hr j K Sminus hρ hsmall c b hb hbsupp
