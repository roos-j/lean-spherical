theorem exists_uniform_scaledBesselRestrictedNormalizedSphericalMaximal_bound_of_unweighted
    {d : ℕ} (hd : 2 ≤ d) (E : Set ℝ) {a q p : ℝ}
    (ha : 0 ≤ a) (ha_lt : a < (d : ℝ) - 1)
    (hq : 0 < q) (hqp : q < p)
    (hunweighted : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E q 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (ε : ℝ), 0 < ε →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
        eLpNorm (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ))
            (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (a * (p - q))) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
            (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (a * (p - q))) := by
  have hp : 0 < p := hq.trans hqp
  obtain ⟨Cq, hCq, hdiagonal⟩ :=
    exists_scaledBesselConjugated_diagonal_of_unweighted
      (show 0 < d by omega) E hq hunweighted
  obtain ⟨Ctop, hCtop, htop⟩ :=
    exists_scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_top_endpoint
      hd ha ha_lt E
  let C : ℝ :=
    (p * (2 : ℝ) ^ q * Cq ^ q *
      ((p - q)⁻¹ * (4 : ℝ) ^ (p - q)) * Ctop ^ (p - q)) ^ p⁻¹
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro ε hε f
  letI : SFinite (scaledBesselWeightedVolume (d := d) ε (-a * q)) :=
    scaledBesselWeightedVolume_sfinite hε
  letI : (scaledBesselWeightedVolume (d := d) ε (-a * q)).HasTemperateGrowth :=
    scaledBesselWeightedVolume_hasTemperateGrowth hε
  let T : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ :=
    scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E
  have hTmeas (g : SchwartzMap (Euclidean d) ℂ) :
      AEStronglyMeasurable (T g) (scaledBesselWeightedVolume ε (-a * q)) := by
    change AEStronglyMeasurable
      (scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E g)
      (scaledBesselWeightedVolume ε (-a * q))
    exact (measurable_scaledBesselConjugatedRestrictedNormalizedSphericalMaximal
      hε a E g).aestronglyMeasurable
  have hTstrong := conjugated_schwartz_strong_type_of_q_and_top_with_constant
    T
    hTmeas
    (fun g x =>
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_nonneg hε a E g x)
    (fun g h x =>
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_add_le
        (show 0 < d by omega) hε a E g h x)
    hq hqp hCq hCtop (hdiagonal ε hε) (htop ε hε)
  have hinputMem : MemLp (scaledBesselSchwartzMultiplier ε a f : Euclidean d → ℂ)
      (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (-a * q)) := by
    exact (scaledBesselSchwartzMultiplier ε a f).memLp (ENNReal.ofReal p)
      (scaledBesselWeightedVolume ε (-a * q))
  obtain ⟨_hTmem, hTbound⟩ := hTstrong
    (scaledBesselSchwartzMultiplier ε a f) hinputMem
  let M : Euclidean d → ENNReal :=
    restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ)
  have hMmeas : Measurable M := by
    dsimp [M]
    exact measurable_restrictedNormalizedSphericalMaximal E
      (f : Euclidean d → ℂ) f.continuous
  have hMtop (x : Euclidean d) : M x ≠ ∞ := by
    dsimp [M]
    exact restrictedNormalizedSphericalMaximal_ne_top_schwartz (show 0 < d by omega) E f x
  have hMnorm : eLpNorm M (ENNReal.ofReal p)
      (scaledBesselWeightedVolume ε (a * (p - q))) =
      eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal p)
        (scaledBesselWeightedVolume ε (a * (p - q))) := by
    apply eLpNorm_congr_enorm_ae
    filter_upwards with x
    rw [enorm_eq_self, Real.enorm_toReal (hMtop x)]
  have hinputNorm :
      eLpNorm (scaledBesselSchwartzMultiplier ε a f : Euclidean d → ℂ)
          (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (-a * q)) =
        eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p)
          (scaledBesselWeightedVolume ε (a * (p - q))) := by
    rw [show a * (p - q) = a * p + -a * q by ring]
    exact eLpNorm_scaledBesselSchwartzMultiplier_eq hε a (-a * q) p hp f
  have houtputNorm :
      eLpNorm (T (scaledBesselSchwartzMultiplier ε a f)) (ENNReal.ofReal p)
