    (measurable_restrictedNormalizedSphericalMaximal E
      (scaledBesselSchwartzMultiplier ε (-a) f : Euclidean d → ℂ)
      (scaledBesselSchwartzMultiplier ε (-a) f).continuous).ennreal_toReal

theorem scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_nonneg
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a : ℝ) (E : Set ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    0 ≤ scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f x := by
  unfold scaledBesselConjugatedRestrictedNormalizedSphericalMaximal
  exact mul_nonneg (scaledBesselPowerWeight_nonneg hε a x) ENNReal.toReal_nonneg

theorem scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_add_le
    {d : ℕ} (hd : 0 < d) {ε : ℝ} (hε : 0 < ε) (a : ℝ) (E : Set ℝ)
    (f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E (f + g) x ≤
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f x +
        scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E g x := by
  have hmul : scaledBesselSchwartzMultiplier ε (-a) (f + g) =
      scaledBesselSchwartzMultiplier ε (-a) f +
        scaledBesselSchwartzMultiplier ε (-a) g :=
    (scaledBesselSchwartzMultiplier ε (-a)).map_add f g
  have hmax := restrictedNormalizedSphericalMaximalReal_schwartz_add_le hd E
    (scaledBesselSchwartzMultiplier ε (-a) f)
    (scaledBesselSchwartzMultiplier ε (-a) g) x
  unfold scaledBesselConjugatedRestrictedNormalizedSphericalMaximal
  rw [hmul]
  calc
    scaledBesselPowerWeight ε a x *
        (restrictedNormalizedSphericalMaximal d E
          ((scaledBesselSchwartzMultiplier ε (-a) f +
            scaledBesselSchwartzMultiplier ε (-a) g :
              SchwartzMap (Euclidean d) ℂ) : Euclidean d → ℂ) x).toReal ≤
        scaledBesselPowerWeight ε a x *
          ((restrictedNormalizedSphericalMaximal d E
            (scaledBesselSchwartzMultiplier ε (-a) f : Euclidean d → ℂ) x).toReal +
            (restrictedNormalizedSphericalMaximal d E
              (scaledBesselSchwartzMultiplier ε (-a) g : Euclidean d → ℂ) x).toReal) :=
      mul_le_mul_of_nonneg_left hmax (scaledBesselPowerWeight_nonneg hε a x)
    _ = _ := by ring

theorem scaledBesselPowerWeight_rpow_mul
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a b p : ℝ) (x : Euclidean d) :
    (scaledBesselPowerWeight ε a x) ^ p * scaledBesselPowerWeight ε b x =
      scaledBesselPowerWeight ε (a * p + b) x := by
  unfold scaledBesselPowerWeight
  rw [← Real.rpow_mul (by positivity : 0 ≤ ε ^ 2 + ‖x‖ ^ 2)]
  rw [← Real.rpow_add (by positivity : 0 < ε ^ 2 + ‖x‖ ^ 2)]
  congr 1
  ring

theorem scaledBesselPowerWeight_conjugation_density
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a p q : ℝ) (x : Euclidean d) :
    (scaledBesselPowerWeight ε a x) ^ p * scaledBesselPowerWeight ε (-a * q) x =
      scaledBesselPowerWeight ε (a * (p - q)) x := by
  rw [scaledBesselPowerWeight_rpow_mul hε]
  congr 1
  ring

theorem norm_scaledBesselSchwartzMultiplier_apply
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a : ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    ‖scaledBesselSchwartzMultiplier ε a f x‖ =
      scaledBesselPowerWeight ε a x * ‖f x‖ := by
  rw [scaledBesselSchwartzMultiplier_apply hε, norm_mul, Complex.norm_real,
    Real.norm_eq_abs, abs_of_nonneg (scaledBesselPowerWeight_nonneg hε a x)]

theorem scaledBesselPowerWeight_zero
    {d : ℕ} (ε : ℝ) (x : Euclidean d) :
    scaledBesselPowerWeight ε 0 x = 1 := by
  simp [scaledBesselPowerWeight]

theorem scaledBesselWeightedVolume_zero
    {d : ℕ} (ε : ℝ) :
    scaledBesselWeightedVolume (d := d) ε 0 = volume := by
  unfold scaledBesselWeightedVolume
  simp only [scaledBesselPowerWeight_zero, ENNReal.ofReal_one]
  change (volume : Measure (Euclidean d)).withDensity 1 = volume
  exact withDensity_one

theorem scaledBesselSchwartzMultiplier_neg_apply_scaledBesselSchwartzMultiplier
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a : ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) :
    scaledBesselSchwartzMultiplier ε (-a) (scaledBesselSchwartzMultiplier ε a f) = f := by
  ext x
  rw [scaledBesselSchwartzMultiplier_apply hε,
    scaledBesselSchwartzMultiplier_apply hε]
  have hreal : scaledBesselPowerWeight ε (-a) x *
      scaledBesselPowerWeight ε a x = 1 := by
    rw [scaledBesselPowerWeight_mul hε]
    rw [neg_add_cancel, scaledBesselPowerWeight_zero]
  calc
    (scaledBesselPowerWeight ε (-a) x : ℂ) *
        ((scaledBesselPowerWeight ε a x : ℂ) * f x) =
        ((scaledBesselPowerWeight ε (-a) x *
          scaledBesselPowerWeight ε a x : ℝ) : ℂ) * f x := by
          push_cast
          ring
    _ = f x := by rw [hreal]; simp

theorem scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_multiplier
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a : ℝ) (E : Set ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E
        (scaledBesselSchwartzMultiplier ε a f) x =
      scaledBesselPowerWeight ε a x *
        (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal := by
  unfold scaledBesselConjugatedRestrictedNormalizedSphericalMaximal
  rw [scaledBesselSchwartzMultiplier_neg_apply_scaledBesselSchwartzMultiplier hε]

theorem eLpNorm_scaledBesselSchwartzMultiplier_eq
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a b p : ℝ) (hp : 0 < p)
    (f : SchwartzMap (Euclidean d) ℂ) :
    eLpNorm (scaledBesselSchwartzMultiplier ε a f : Euclidean d → ℂ)
        (ENNReal.ofReal p) (scaledBesselWeightedVolume ε b) =
      eLpNorm (f : Euclidean d → ℂ)
        (ENNReal.ofReal p) (scaledBesselWeightedVolume ε (a * p + b)) := by
  have hp0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  have hleft_meas : Measurable (fun x : Euclidean d =>
      ‖scaledBesselSchwartzMultiplier ε a f x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      (scaledBesselSchwartzMultiplier ε a f).continuous.enorm.measurable
  have hright_meas : Measurable (fun x : Euclidean d => ‖f x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp f.continuous.enorm.measurable
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  congr 1
  unfold scaledBesselWeightedVolume
  rw [lintegral_withDensity_eq_lintegral_mul volume
      (measurable_scaledBesselPowerDensity hε b) hleft_meas,
    lintegral_withDensity_eq_lintegral_mul volume
      (measurable_scaledBesselPowerDensity hε (a * p + b)) hright_meas]
  apply lintegral_congr
  intro x
  change ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
      ‖scaledBesselSchwartzMultiplier ε a f x‖ₑ ^ p =
    ENNReal.ofReal (scaledBesselPowerWeight ε (a * p + b) x) * ‖f x‖ₑ ^ p
  rw [← ofReal_norm, norm_scaledBesselSchwartzMultiplier_apply hε]
  rw [ENNReal.ofReal_mul (scaledBesselPowerWeight_nonneg hε a x),
    ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  have hweight :
      ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
          (ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p =
        ENNReal.ofReal (scaledBesselPowerWeight ε (a * p + b) x) := by
    rw [ENNReal.ofReal_rpow_of_pos (scaledBesselPowerWeight_pos hε a x)]
    rw [mul_comm]
    rw [← ENNReal.ofReal_mul
      (Real.rpow_nonneg (scaledBesselPowerWeight_nonneg hε a x) p)]
    rw [scaledBesselPowerWeight_rpow_mul hε]
  rw [show ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
      ((ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p *
        (ENNReal.ofReal ‖f x‖) ^ p) =
      (ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
        (ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p) *
        (ENNReal.ofReal ‖f x‖) ^ p by ring,
    hweight]
  rw [ofReal_norm]

theorem eLpNorm_scaledBessel_weighted_real_mul_eq
    {d : ℕ} {ε : ℝ} (hε : 0 < ε) (a b p : ℝ) (hp : 0 < p)
    (g : Euclidean d → ℝ) (hg : Measurable g) (hgnonneg : ∀ x, 0 ≤ g x) :
    eLpNorm (fun x => scaledBesselPowerWeight ε a x * g x)
        (ENNReal.ofReal p) (scaledBesselWeightedVolume ε b) =
      eLpNorm g (ENNReal.ofReal p)
        (scaledBesselWeightedVolume ε (a * p + b)) := by
  have hp0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  have hleft_meas : Measurable (fun x : Euclidean d =>
      ‖scaledBesselPowerWeight ε a x * g x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      ((measurable_scaledBesselPowerWeight hε a).mul hg).enorm
  have hright_meas : Measurable (fun x : Euclidean d => ‖g x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hg.enorm
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top,
    eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  congr 1
  unfold scaledBesselWeightedVolume
  rw [lintegral_withDensity_eq_lintegral_mul volume
      (measurable_scaledBesselPowerDensity hε b) hleft_meas,
    lintegral_withDensity_eq_lintegral_mul volume
      (measurable_scaledBesselPowerDensity hε (a * p + b)) hright_meas]
  apply lintegral_congr
  intro x
  change ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
      ‖scaledBesselPowerWeight ε a x * g x‖ₑ ^ p =
    ENNReal.ofReal (scaledBesselPowerWeight ε (a * p + b) x) * ‖g x‖ₑ ^ p
  rw [← ofReal_norm, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (scaledBesselPowerWeight_nonneg hε a x) (hgnonneg x)),
    ENNReal.ofReal_mul (scaledBesselPowerWeight_nonneg hε a x),
    ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  have hweight :
      ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
          (ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p =
        ENNReal.ofReal (scaledBesselPowerWeight ε (a * p + b) x) := by
    rw [ENNReal.ofReal_rpow_of_pos (scaledBesselPowerWeight_pos hε a x)]
    rw [mul_comm]
    rw [← ENNReal.ofReal_mul
      (Real.rpow_nonneg (scaledBesselPowerWeight_nonneg hε a x) p)]
    rw [scaledBesselPowerWeight_rpow_mul hε]
  rw [show ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
      ((ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p *
        (ENNReal.ofReal (g x)) ^ p) =
      (ENNReal.ofReal (scaledBesselPowerWeight ε b x) *
        (ENNReal.ofReal (scaledBesselPowerWeight ε a x)) ^ p) *
        (ENNReal.ofReal (g x)) ^ p by ring,
    hweight]
  rw [← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (hgnonneg x)]

/-- The unweighted `L^q` estimate gives the diagonal estimate for every
positive-scale Bessel conjugation, with exactly the same constant. -/
theorem exists_scaledBesselConjugated_diagonal_of_unweighted
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) {a q : ℝ} (hq : 0 < q)
    (hunweighted : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E q 0) :
    ∃ C : ℝ, 0 < C ∧ ∀ (ε : ℝ), 0 < ε →
      ∀ f : SchwartzMap (Euclidean d) ℂ,
        eLpNorm (scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f)
            (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
            (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) := by
  rcases (hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff d E q).mp
      hunweighted with ⟨C, hC, hstrong⟩
  refine ⟨C, hC, ?_⟩
  intro ε hε f
  let h : SchwartzMap (Euclidean d) ℂ := scaledBesselSchwartzMultiplier ε (-a) f
  have hhmem : MemLp (h : Euclidean d → ℂ) (ENNReal.ofReal q) volume := by
    dsimp [h]
    exact (scaledBesselSchwartzMultiplier ε (-a) f).memLp (ENNReal.ofReal q) volume
  obtain ⟨hMmem, hMbound⟩ := hstrong h hhmem
  let M : Euclidean d → ENNReal :=
    restrictedNormalizedSphericalMaximal d E (h : Euclidean d → ℂ)
  have hMmeas : Measurable M := by
    dsimp [M]
    exact measurable_restrictedNormalizedSphericalMaximal E
      (h : Euclidean d → ℂ) h.continuous
  have hMtop (x : Euclidean d) : M x ≠ ∞ := by
    dsimp [M]
    exact restrictedNormalizedSphericalMaximal_ne_top_schwartz hd E h x
  have hMnonneg (x : Euclidean d) : 0 ≤ (M x).toReal := ENNReal.toReal_nonneg
  have hMnorm : eLpNorm M (ENNReal.ofReal q) volume =
      eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal q) volume := by
    apply eLpNorm_congr_enorm_ae
    filter_upwards with x
    rw [enorm_eq_self, Real.enorm_toReal (hMtop x)]
  have hinputNorm : eLpNorm (h : Euclidean d → ℂ) (ENNReal.ofReal q) volume =
      eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal q)
        (scaledBesselWeightedVolume ε (-a * q)) := by
    rw [← scaledBesselWeightedVolume_zero ε]
    change eLpNorm (scaledBesselSchwartzMultiplier ε (-a) f : Euclidean d → ℂ)
      (ENNReal.ofReal q) (scaledBesselWeightedVolume ε 0) = _
    simpa only [add_zero] using
      (eLpNorm_scaledBesselSchwartzMultiplier_eq hε (-a) 0 q hq f)
  have houtputNorm :
      eLpNorm (scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f)
          (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) =
        eLpNorm M (ENNReal.ofReal q) volume := by
    calc
      eLpNorm (scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f)
          (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) =
          eLpNorm (fun x => scaledBesselPowerWeight ε a x * (M x).toReal)
            (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) := by
              rfl
      _ = eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal q)
          (scaledBesselWeightedVolume ε (a * q + -a * q)) :=
        eLpNorm_scaledBessel_weighted_real_mul_eq hε a (-a * q) q hq
          (fun x => (M x).toReal) hMmeas.ennreal_toReal hMnonneg
      _ = eLpNorm (fun x => (M x).toReal) (ENNReal.ofReal q) volume := by
        rw [show a * q + -a * q = 0 by ring, scaledBesselWeightedVolume_zero]
      _ = eLpNorm M (ENNReal.ofReal q) volume := hMnorm.symm
  rw [houtputNorm]
  calc
    eLpNorm M (ENNReal.ofReal q) volume =
        eLpNorm (restrictedNormalizedSphericalMaximal d E (h : Euclidean d → ℂ))
          (ENNReal.ofReal q) volume := by rfl
    _ ≤ ENNReal.ofReal C * eLpNorm (h : Euclidean d → ℂ)
        (ENNReal.ofReal q) volume := hMbound
    _ = ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ)
        (ENNReal.ofReal q) (scaledBesselWeightedVolume ε (-a * q)) := by
      rw [hinputNorm]

private theorem normalizedSphericalAverage_const_smul
    {d : ℕ} (c : ℂ) (f : Euclidean d → ℂ) (r : ℝ) (x : Euclidean d) :
    normalizedSphericalAverage d (c • f) r x =
      c * normalizedSphericalAverage d f r x := by
  unfold normalizedSphericalAverage sphericalAverage
  simp only [Pi.smul_apply]
  rw [integral_smul]
  simp only [smul_eq_mul]
  ring

private theorem restrictedNormalizedSphericalMaximal_const_smul
    {d : ℕ} (E : Set ℝ) (c : ℂ) (f : Euclidean d → ℂ) (x : Euclidean d) :
    restrictedNormalizedSphericalMaximal d E (c • f) x =
      ENNReal.ofReal ‖c‖ * restrictedNormalizedSphericalMaximal d E f x := by
  unfold restrictedNormalizedSphericalMaximal
  rw [ENNReal.mul_iSup]
  apply iSup_congr
  intro r
  rw [normalizedSphericalAverage_const_smul, norm_mul,
    ENNReal.ofReal_mul (norm_nonneg _)]

private theorem dilateRadiusSet_inv_dilateRadiusSet
    (E : Set ℝ) {ε : ℝ} (hε : 0 < ε) :
    dilateRadiusSet ε (dilateRadiusSet ε⁻¹ E) = E := by
  ext r
  constructor
  · rintro ⟨s, ⟨t, ht, hst⟩, hrs⟩
    rw [← hrs, ← hst]
    convert ht using 1; field_simp [hε.ne']
  · intro hr
    refine ⟨ε⁻¹ * r, ⟨r, hr, by ring⟩, ?_⟩
    field_simp [hε.ne']

private theorem exists_besselConjugated_top_endpoint_uniform_radius_set
    {d : ℕ} (hd : 2 ≤ d) {a : ℝ} (ha : 0 ≤ a)
    (ha_lt : a < (d : ℝ) - 1) :
    ∃ K : ℝ, 0 < K ∧ ∀ (E : Set ℝ) (f : SchwartzMap (Euclidean d) ℂ) (u : ℝ),
      0 ≤ u → (∀ x, ‖f x‖ ≤ u) → ∀ x,
        besselConjugatedRestrictedNormalizedSphericalMaximal a E f x ≤ K * u := by
  obtain ⟨K, hK, hkernel⟩ :=
    exists_uniform_bessel_spherical_kernel_bound hd ha ha_lt
  refine ⟨K + 1, by linarith, ?_⟩
  intro E f u hu hfu x
  have hmult_bound (y : Euclidean d) :
      ‖besselSchwartzMultiplier (-a) f y‖ ≤
        u * (besselPowerWeight a y)⁻¹ := by
    rw [besselSchwartzMultiplier_apply, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_nonneg (besselPowerWeight_nonneg (-a) y),
      besselPowerWeight_inv]
    simpa only [mul_comm] using
      mul_le_mul_of_nonneg_left (hfu y) (besselPowerWeight_nonneg (-a) y)
  have htop := bessel_weighted_restrictedNormalizedSphericalMaximal_toReal_le_of_kernel
    (show 0 < d by omega) E hu (mul_nonneg hu hK)
      (besselSchwartzMultiplier (-a) f) x hmult_bound
      (fun r => hkernel x r.2.2)
  unfold besselConjugatedRestrictedNormalizedSphericalMaximal
  calc
    besselPowerWeight a x *
        (restrictedNormalizedSphericalMaximal d E
          (besselSchwartzMultiplier (-a) f : Euclidean d → ℂ) x).toReal ≤
        u * K := htop
    _ ≤ (K + 1) * u := by nlinarith

theorem exists_scaledBesselConjugatedRestrictedNormalizedSphericalMaximal_top_endpoint
    {d : ℕ} (hd : 2 ≤ d) {a : ℝ} (ha : 0 ≤ a)
    (ha_lt : a < (d : ℝ) - 1) (E : Set ℝ) :
    ∃ K : ℝ, 0 < K ∧ ∀ (ε : ℝ), 0 < ε →
      ∀ (f : SchwartzMap (Euclidean d) ℂ) (u : ℝ), 0 ≤ u →
        (∀ x, ‖f x‖ ≤ u) → ∀ x,
          scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f x ≤ K * u := by
  obtain ⟨K, hK, hunit⟩ :=
    exists_besselConjugated_top_endpoint_uniform_radius_set hd ha ha_lt
  refine ⟨K, hK, ?_⟩
  intro ε hε f u hu hfu x
  let D : Euclidean d ≃L[ℝ] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 ε hε.ne')
  let g : SchwartzMap (Euclidean d) ℂ :=
    (SchwartzMap.compCLMOfContinuousLinearEquiv ℂ D) f
  have hgfun : (g : Euclidean d → ℂ) = fun y => f (ε • y) := by
    funext y
    change f (D y) = f (ε • y)
    simp [D]
  let z : Euclidean d := ε⁻¹ • x
  have hx : ε • z = x := by
    dsimp [z]
    simp [smul_smul, hε.ne']
  have hgBound (y : Euclidean d) : ‖g y‖ ≤ u := by
    rw [hgfun]
    exact hfu _
  let H : Euclidean d → ℂ :=
    (scaledBesselSchwartzMultiplier ε (-a) f : Euclidean d → ℂ)
  let G : Euclidean d → ℂ :=
    (besselSchwartzMultiplier (-a) g : Euclidean d → ℂ)
  have hinput : (fun y : Euclidean d => H (ε • y)) =
      ((ε ^ (-a) : ℝ) : ℂ) • G := by
    funext y
    dsimp [H, G]
    rw [scaledBesselSchwartzMultiplier_apply hε,
      besselSchwartzMultiplier_apply, scaledBesselPowerWeight_dilate hε (-a), hgfun]
    push_cast
    ring
  have hcoeffpos : 0 < ε ^ (-a) := Real.rpow_pos_of_pos hε _
  have hcoeffnorm : ‖((ε ^ (-a) : ℝ) : ℂ)‖ = ε ^ (-a) := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hcoeffpos]
  have hmax :
      restrictedNormalizedSphericalMaximal d E H (ε • z) =
        ENNReal.ofReal (ε ^ (-a)) *
          restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z := by
    calc
      restrictedNormalizedSphericalMaximal d E H (ε • z) =
          restrictedNormalizedSphericalMaximal d
            (dilateRadiusSet ε (dilateRadiusSet ε⁻¹ E)) H (ε • z) := by
              rw [dilateRadiusSet_inv_dilateRadiusSet E hε]
      _ = restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E)
          (fun y => H (ε • y)) z := by
            symm
            exact restrictedNormalizedSphericalMaximal_dilate (dilateRadiusSet ε⁻¹ E) H hε z
      _ = restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E)
          (((ε ^ (-a) : ℝ) : ℂ) • G) z := by rw [hinput]
      _ = ENNReal.ofReal (ε ^ (-a)) *
          restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z := by
            rw [restrictedNormalizedSphericalMaximal_const_smul, hcoeffnorm]
  have hident :
      scaledBesselConjugatedRestrictedNormalizedSphericalMaximal ε a E f (ε • z) =
        besselConjugatedRestrictedNormalizedSphericalMaximal a
          (dilateRadiusSet ε⁻¹ E) g z := by
    change scaledBesselPowerWeight ε a (ε • z) *
        (restrictedNormalizedSphericalMaximal d E H (ε • z)).toReal =
      besselPowerWeight a z *
        (restrictedNormalizedSphericalMaximal d (dilateRadiusSet ε⁻¹ E) G z).toReal
    rw [scaledBesselPowerWeight_dilate hε a, hmax,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal hcoeffpos.le]
    have hcancel : ε ^ a * ε ^ (-a) = 1 := by
      rw [← Real.rpow_add hε]
