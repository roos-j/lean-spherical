        mul_lt_mul_of_pos_left hgap (div_pos hr hL)
      _ = r * (2 : ℝ) ^ (m + 1) / L := by ring

private theorem shell_tail_threshold_of_scaled_gap_le
    {r L : ℝ} (m : Nat) (hr : 0 < r) (hL : 0 < L)
