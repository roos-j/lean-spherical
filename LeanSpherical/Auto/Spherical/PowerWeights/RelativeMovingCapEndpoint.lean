        A * q ^ m * volume (relativeTailCap n y r L s m)) +
        A * q ^ (j - 2) * volume B := by
      rw [hGint]
      apply congrArg (fun z : ENNReal => z + A * q ^ (j - 2) * volume B)
      apply Finset.sum_congr rfl
      intro m _
      exact hFint m
