  let L : ℝ := (2 : ℝ) ^ j
  let F : ℕ → Euclidean (n + 1) → ENNReal := fun m x =>
    A * q ^ m * (relativeTailCap n y r L s m).indicator (fun _ => (1 : ENNReal)) x
