            exact measurableSet_ball) V).symm
    _ ≤ ∫⁻ x : Euclidean (n + 1),
        (∑ m ∈ Finset.range (j - 2), F m x) + G x := by
      apply lintegral_mono
      intro x
      by_cases hx : x ∈ B
      · simpa only [Set.indicator_of_mem hx] using hpoint x hx
      · simp only [Set.indicator_of_notMem hx]
