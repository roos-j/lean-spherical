private theorem mem_relativeTailCap_of_scaled_gap_lt
    (n : Nat) (y x : Euclidean (n + 1)) {r L s : ℝ} (m : Nat)
    (hr : 0 < r) (hL : 0 < L) (hx : x ∈ ball 0 s)
    (hgap : L * r⁻¹ * |‖y - x‖ - r| < (2 : ℝ) ^ (m + 1)) :
