/-- The `m`th cap appearing in the high-frequency radial-tail decomposition. -/
def relativeTailCap (n : Nat) (y : Euclidean (n + 1))
    (r L s : ℝ) (m : Nat) : Set (Euclidean (n + 1)) :=
  thinShellCap (n + 1) y r s (r * (2 : ℝ) ^ (m + 1) / L)

theorem measurableSet_relativeTailCap
    (n : Nat) (y : Euclidean (n + 1)) (r L s : ℝ) (m : Nat) :
    MeasurableSet (relativeTailCap n y r L s m) := by
  exact measurableSet_thinShellCap (n + 1) y r s _

private theorem relative_tail_thickness_le_quarter
