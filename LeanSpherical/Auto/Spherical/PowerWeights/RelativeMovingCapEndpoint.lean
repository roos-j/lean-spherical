    r * (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j =
        r * ((2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j) := by ring
    _ ≤ r * ((1 : ℝ) / 4) := mul_le_mul_of_nonneg_left hratio hr.le
    _ = r / 4 := by ring

