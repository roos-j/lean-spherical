    exact_mod_cast hpow_nat
  have hden : 0 < (2 : ℝ) ^ j := pow_pos (by norm_num) _
  have hratio : (2 : ℝ) ^ (m + 1) / (2 : ℝ) ^ j ≤ (1 : ℝ) / 4 := by
    calc
