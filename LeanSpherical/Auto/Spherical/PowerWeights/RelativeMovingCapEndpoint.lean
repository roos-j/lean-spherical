  calc
    (2 : ℝ) ^ m ≤ L * r⁻¹ * u := hu
    _ = (u / r) * L := by field_simp [hr.ne']

private theorem exists_relative_dyadic_annulus {t : ℝ} (ht : 2 ≤ t) :
    ∃ m : ℕ, (2 : ℝ) ^ m ≤ t ∧ t < (2 : ℝ) ^ (m + 1) := by
