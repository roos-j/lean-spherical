      intro y
      by_cases hy : y ∈ D
      · rw [indicator_of_mem hy, hfg]
        rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hgnonneg y)]
        simpa using hgle_one y
      · rw [indicator_of_notMem hy, hfg]
        have hnorm : 2 * R ≤ ‖y‖ := by
          rw [Metric.mem_closedBall, dist_zero_right] at hy
          exact le_of_lt (lt_of_not_ge hy)
        rw [hsupport y hnorm]
        norm_num
    _ = (powerWeightedVolume d α D) ^
        (1 / (ENNReal.ofReal p).toReal) := by
      rw [eLpNorm_indicator_const hD.nullMeasurableSet hp0 ENNReal.ofReal_ne_top]
      norm_num [enorm]
    _ = (powerWeightedVolume d α (closedBall (0 : Euclidean d) (2 * R))) ^
        (1 / (ENNReal.ofReal p).toReal) := by rfl

/-- The finite ball-at-origin test with a fixed strong-type constant.  The
output is exactly the union of the disjoint radial shells associated to the
selected radii. -/
theorem restrictedStrongType_ballOrigin_finite_lower_of_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) *
      ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let D : Set (Euclidean (n + 1)) := closedBall 0 (2 * R)
  let U : PositiveRadius → Set (Euclidean (n + 1)) :=
    fun r => radialShell (n + 1) (r : ℝ) b
  let V : Set (Euclidean (n + 1)) := ⋃ r ∈ (↑T : Set PositiveRadius), U r
  rcases exists_schwartz_nonnegative_ball_test (n + 1) hRpos with
    ⟨g, f, hfg, hgcont, hgnonneg, hgleone, hgone, hzero⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hinput : eLpNorm (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) ≤
      (powerWeightedVolume (n + 1) α D) ^
        (1 / (ENNReal.ofReal p).toReal) := by
    dsimp only [D]
    exact eLpNorm_nonnegative_ball_cutoff_le (n + 1) hp0 g f hfg
      hgnonneg hgleone hzero
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hf : MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume (n + 1) α) := by
    refine lt_of_le_of_lt hinput ?_
    exact ENNReal.rpow_lt_top_of_nonneg hq (by simpa only [D] using hDfinite)
  have hUmeas : ∀ r ∈ T, MeasurableSet (U r) := by
    intro r hr
    exact measurableSet_radialShell (n + 1) (r : ℝ) b
  have hUdisjoint : (↑T : Set PositiveRadius).PairwiseDisjoint U := by
    intro r hr s hs hrs
    change Disjoint (U r) (U s)
    exact disjoint_radialShell_of_radius_separated (n + 1)
      (hsep r (by simpa using hr) s (by simpa using hs) hrs)
  have hVmeas : MeasurableSet V := by
    dsimp only [V]
    exact T.measurableSet_biUnion hUmeas
  have hpoint : ∀ x ∈ V,
      (ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1)) ≤
        restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ) x := by
    intro x hx
    rcases Set.mem_iUnion.mp hx with ⟨r, hx⟩
    rcases Set.mem_iUnion.mp hx with ⟨hrT, hxr⟩
    calc
      (ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1)) ≤
          ENNReal.ofReal ‖normalizedSphericalAverage (n + 1)
            (fun y => (g y : ℂ)) (r : ℝ) x‖ :=
        radialShell_cap_average_lower n hn r.2 (hinner r hrT) (hmargin r hrT)
          hh hhone g hgcont hgnonneg hgone hxr
      _ = ENNReal.ofReal ‖normalizedSphericalAverage (n + 1)
          (f : Euclidean (n + 1) → ℂ) (r : ℝ) x‖ := by
        have hfun : (fun y : Euclidean (n + 1) => (g y : ℂ)) =
            (f : Euclidean (n + 1) → ℂ) := by
          funext y
          exact (hfg y).symm
        rw [hfun]
      _ ≤ restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ) x :=
        ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
          f (hT r hrT) r.2 x
  have hvolume : (T.card : ℝ≥0∞) * m ≤ powerWeightedVolume (n + 1) α V := by
    calc
      (T.card : ℝ≥0∞) * m = ∑ r ∈ T, m := by simp [mul_comm]
      _ ≤ ∑ r ∈ T, powerWeightedVolume (n + 1) α (U r) := by
        gcongr with r hr
        exact hm r hr
      _ = powerWeightedVolume (n + 1) α V := by
        dsimp only [V]
        exact (measure_biUnion_finset hUdisjoint hUmeas).symm
  have hbound := restrictedStrongType_knapp_entropy_test_bound_of_bound
    hstrong (f := f) hf hVmeas hpoint hinput hvolume hppos
  simpa only [D] using hbound

/-- Existential-constant form of the finite origin-ball test. -/
theorem restrictedStrongType_ballOrigin_finite_lower
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ∃ C : ℝ, 0 < C ∧
      ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  rcases hstrong with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  exact restrictedStrongType_ballOrigin_finite_lower_of_bound n hn hbound T
    hT hsep hm hppos hRpos hh hhone hinner hmargin hDfinite

/-- The ball-at-origin lower test with the cardinality of a finite radial
packing replaced by the local multiplicative entropy at the same scale.

The net condition is deliberately stated with radius `δ / 2`: this is exactly
the covering radius in the definition of `localMultiplicativeEntropy E c diam
δ`.  The separation hypothesis remains in physical radius because it is what
makes the radial shells disjoint. -/
theorem restrictedStrongType_ballOrigin_localEntropy_lower_of_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (c : PositiveRadius) (diam δ : ℝ≥0) (T : Finset PositiveRadius)
    {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam)
    (hnet : ∀ r : PositiveRadius, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam →
      ∃ t ∈ T, |logRadius r - logRadius t| ≤ ((δ : ℝ≥0) : ℝ) / 2)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ((ENNReal.ofReal (surfaceMass n) *
        ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
        ENNReal.ofReal (surfaceMass (n + 1))) *
      ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
        (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let F : Set ℝ := E ∩ multiplicativeInterval c diam
  let centers : Set ℝ := logRadius '' (↑T : Set PositiveRadius)
  have hcover : Metric.IsCover (δ / 2) (logRadiusSet F) centers := by
    rintro u ⟨r, hrF, rfl⟩
    obtain ⟨t, htT, hrt⟩ := hnet r (by simpa only [F] using hrF)
    refine ⟨logRadius t, ⟨t, htT, rfl⟩, ?_⟩
    change edist (logRadius r) (logRadius t) ≤ ((δ / 2 : ℝ≥0) : ℝ≥0∞)
    rw [edist_dist]
    apply ENNReal.ofReal_le_coe.mpr
    simpa only [Real.dist_eq, NNReal.coe_div, NNReal.coe_ofNat] using hrt
  have hCcard : centers.encard = T.card := by
    have hC : centers = (↑(T.image logRadius) : Set ℝ) := by
      ext u
      simp [centers]
    rw [hC, Set.encard_coe_eq_coe_finsetCard,
      Finset.card_image_of_injective T logRadius_injective]
  have hentropyENat : localMultiplicativeEntropy E c diam δ ≤ T.card := by
    change Metric.externalCoveringNumber (δ / 2) (logRadiusSet F) ≤ T.card
    rw [← hCcard]
    exact hcover.externalCoveringNumber_le_encard
  have hentropy : (localMultiplicativeEntropy E c diam δ).toENNReal ≤
      (T.card : ℝ≥0∞) := by
    exact_mod_cast ENat.toENNReal_mono hentropyENat
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hbound :=
    restrictedStrongType_ballOrigin_finite_lower_of_bound n hn hstrong T
      (fun r hr => (hT r hr).1) hsep hm hppos hRpos hh hhone hinner hmargin hDfinite
  calc
    ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) := by
      gcongr
    _ ≤ ENNReal.ofReal C *
        (powerWeightedVolume (n + 1) α
          (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
            (1 / (ENNReal.ofReal p).toReal) := hbound

/-- Existential-constant form of the local entropy origin-ball test. -/
theorem restrictedStrongType_ballOrigin_localEntropy_lower
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (c : PositiveRadius) (diam δ : ℝ≥0) (T : Finset PositiveRadius)
    {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam)
    (hnet : ∀ r : PositiveRadius, (r : ℝ) ∈ E ∩ multiplicativeInterval c diam →
      ∃ t ∈ T, |logRadius r - logRadius t| ≤ ((δ : ℝ≥0) : ℝ) / 2)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhone : h ≤ 1)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    ∃ C : ℝ, 0 < C ∧
      ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (h / 2)) ^ (n - 2) * ENNReal.ofReal (h ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c diam δ).toENNReal * m) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1)) (2 * R))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  rcases hstrong with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  exact restrictedStrongType_ballOrigin_localEntropy_lower_of_bound n hn hbound c diam δ T
    hT hnet hsep hm hppos hRpos hh hhone hinner hmargin hDfinite

/-- The origin-ball test with all geometric parameters fixed at their natural
unit-window scales.  The remaining inequality is uniform in the centre `c`;
the factors of `c` on its two sides are the ones that cancel when the entropy
power estimate is extracted. -/
theorem restrictedStrongType_ballOrigin_unit_localEntropy_lower_of_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean (n + 1)) ℂ,
      MemLp (f : Euclidean (n + 1) → ℂ) (ENNReal.ofReal p)
        (powerWeightedVolume (n + 1) α) →
        MemLp (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal (n + 1) E
          (f : Euclidean (n + 1) → ℂ)) (ENNReal.ofReal p)
          (powerWeightedVolume (n + 1) α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean (n + 1) → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume (n + 1) α))
    (c : PositiveRadius) (δ : ℝ≥0) (hδ : 0 < δ) (hδone : δ ≤ 1)
    (hppos : 0 < p) (hα : 0 ≤ α) :
    ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (((δ : ℝ) / 8) / 2)) ^ (n - 2) *
            ENNReal.ofReal (((δ : ℝ) / 8) ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c 1 δ).toENNReal *
          ((ENNReal.ofReal ((c : ℝ) / 4)) ^ α *
            (volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) *
              ENNReal.ofReal
                (2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16))))) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1))
              (2 * ((c : ℝ) * (δ : ℝ))))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let b : ℝ := (c : ℝ) * Real.log 2 * (δ : ℝ) / 16
  let h : ℝ := (δ : ℝ) / 8
  let R : ℝ := (c : ℝ) * (δ : ℝ)
  let ρ : ℝ := (c : ℝ) / 4
  let m : ℝ≥0∞ := (ENNReal.ofReal ((c : ℝ) / 4)) ^ α *
    (volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) * ENNReal.ofReal (2 * b))
  let F : Set ℝ := E ∩ multiplicativeInterval c 1
  obtain ⟨T, hT, hnet, _hlogsep, hphyssep⟩ :=
    exists_finset_unitMultiplicative_packing F c δ hδ (by
      intro r hr
      exact hr.2)
  have hcpos : 0 < (c : ℝ) := c.2
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hlogtwo : 0 < Real.log 2 := Real.log_pos (by norm_num)
  have hlogtwole : Real.log 2 ≤ 1 := by
    nlinarith [Real.log_le_sub_one_of_pos (by norm_num : (0 : ℝ) < 2)]
  have hbpos : 0 < b := by
    dsimp only [b]
    positivity
  have hhpos : 0 < h := by
    dsimp only [h]
    positivity
  have hRpos : 0 < R := by
    dsimp only [R]
    positivity
  have hhone : h ≤ 1 := by
    dsimp only [h]
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    linarith
  have hb_le_cδ_sixteen : b ≤ (c : ℝ) * (δ : ℝ) / 16 := by
    calc
      b = ((c : ℝ) * (δ : ℝ) / 16) * Real.log 2 := by
        dsimp only [b]
        ring
      _ ≤ ((c : ℝ) * (δ : ℝ) / 16) * 1 := by
        apply mul_le_mul_of_nonneg_left hlogtwole
        positivity
      _ = (c : ℝ) * (δ : ℝ) / 16 := by ring
  have hb_le_c_sixteen : b ≤ (c : ℝ) / 16 := by
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    calc
      b ≤ (c : ℝ) * (δ : ℝ) / 16 := hb_le_cδ_sixteen
      _ ≤ (c : ℝ) * 1 / 16 := by
        apply div_le_div_of_nonneg_right
        · exact mul_le_mul_of_nonneg_left hδrealone hcpos.le
        · norm_num
      _ = (c : ℝ) / 16 := by ring
  have hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s →
      2 * b ≤ |(r : ℝ) - (s : ℝ)| := by
    intro r hr s hs hrs
    have hstrict := hphyssep r hr s hs hrs
    have hscale : 2 * b ≤ (c : ℝ) * Real.log 2 * (δ : ℝ) / 4 := by
      dsimp only [b]
      have hz : 0 ≤ (c : ℝ) * Real.log 2 * (δ : ℝ) := by positivity
      nlinarith
    exact hscale.trans hstrict.le
  have hinner : ∀ r ∈ T, b < (r : ℝ) := by
    intro r hr
    have hrhalf := half_center_le_radius_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    linarith
  have hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R := by
    intro r hr
    have hrupper := radius_le_two_center_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    have hδrealone : (δ : ℝ) ≤ 1 := by exact_mod_cast hδone
    dsimp only [h, R]
    calc
      b + (r : ℝ) * ((δ : ℝ) / 8) ≤
          (c : ℝ) * (δ : ℝ) / 16 +
            (2 * (c : ℝ)) * ((δ : ℝ) / 8) := by
        gcongr
      _ ≤ (c : ℝ) * (δ : ℝ) := by
        have hcd : 0 ≤ (c : ℝ) * (δ : ℝ) := by positivity
        nlinarith
  have hm : ∀ r ∈ T, m ≤ powerWeightedVolume (n + 1) α
      (radialShell (n + 1) (r : ℝ) b) := by
    intro r hr
    have hrhalf := half_center_le_radius_of_mem_unitMultiplicativeInterval c
      (hT r hr).2
    have hρr : ρ ≤ (r : ℝ) := by
      dsimp only [ρ]
      linarith
    have hrlower : (c : ℝ) / 4 ≤ (r : ℝ) - b := by
      linarith
    have hpowlower : (ENNReal.ofReal ((c : ℝ) / 4)) ^ α ≤
        (ENNReal.ofReal ((r : ℝ) - b)) ^ α :=
      ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hrlower) hα
    calc
      m ≤ (ENNReal.ofReal ((r : ℝ) - b)) ^ α *
          (volume (ball (0 : Euclidean n) ρ) * ENNReal.ofReal (2 * b)) := by
        dsimp only [m, ρ]
        gcongr
      _ ≤ powerWeightedVolume (n + 1) α
          (graphTube n (r : ℝ) 0 ρ b) :=
        powerWeightedVolume_graphTube_lower_of_nonneg n hα r.2.le hρr
      _ ≤ powerWeightedVolume (n + 1) α
          (radialShell (n + 1) (r : ℝ) b) := by
        apply measure_mono
        exact graphTube_subset_radialShell n r.2.le hρr
  have hDfinite : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1)) (2 * R)) ≠ (∞ : ℝ≥0∞) :=
    ne_of_lt (powerWeightedVolume_closedBall_lt_top hα)
  have hbound :=
    restrictedStrongType_ballOrigin_localEntropy_lower_of_bound n hn hstrong c 1 δ T
      (by simpa only [F] using hT) (by
        intro r hr
        exact hnet r (by simpa only [F] using hr)) hsep hm hppos hRpos hhpos hhone
      hinner hmargin hDfinite
  simpa only [b, h, R, ρ, m] using hbound

/-- Existential-constant form of the unit-window origin-ball test. -/
theorem restrictedStrongType_ballOrigin_unit_localEntropy_lower
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (c : PositiveRadius) (δ : ℝ≥0) (hδ : 0 < δ) (hδone : δ ≤ 1)
    (hppos : 0 < p) (hα : 0 ≤ α) :
    ∃ C : ℝ, 0 < C ∧
      ((ENNReal.ofReal (surfaceMass n) *
          ((ENNReal.ofReal (((δ : ℝ) / 8) / 2)) ^ (n - 2) *
            ENNReal.ofReal (((δ : ℝ) / 8) ^ 2 / 4))) /
          ENNReal.ofReal (surfaceMass (n + 1))) *
        ((localMultiplicativeEntropy E c 1 δ).toENNReal *
          ((ENNReal.ofReal ((c : ℝ) / 4)) ^ α *
            (volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) *
              ENNReal.ofReal
                (2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16))))) ^
          (1 / (ENNReal.ofReal p).toReal) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1))
              (2 * ((c : ℝ) * (δ : ℝ))))) ^
              (1 / (ENNReal.ofReal p).toReal) := by
  rcases hstrong with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  exact restrictedStrongType_ballOrigin_unit_localEntropy_lower_of_bound n hn hbound c δ
    hδ hδone hppos hα

private theorem cancel_center_scale_in_rpow_bound
    {a N x y z w : ℝ≥0∞} {p q : ℝ}
    (ha0 : a ≠ 0) (hatop : a ≠ (∞ : ℝ≥0∞)) (hp : 0 < p)
    (h : x * (N * (a ^ q * y)) ^ (1 / p) ≤
      z * (a ^ q * w) ^ (1 / p)) :
    x * (N * y) ^ (1 / p) ≤ z * w ^ (1 / p) := by
  have hip : 0 ≤ 1 / p := by positivity
  have hpowpos : 0 < a ^ q := ENNReal.rpow_pos
    (pos_iff_ne_zero.mpr ha0) hatop
  have hpowtop : a ^ q ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_ne_zero ha0 hatop
  let common : ℝ≥0∞ := (a ^ q) ^ (1 / p)
  have hcommonpos : 0 < common := by
    dsimp only [common]
    exact ENNReal.rpow_pos hpowpos hpowtop
  have hcommontop : common ≠ (∞ : ℝ≥0∞) := by
    dsimp only [common]
    exact ENNReal.rpow_ne_top_of_ne_zero hpowpos.ne' hpowtop
  have hfactor : (N * (a ^ q * y)) ^ (1 / p) =
      common * (N * y) ^ (1 / p) := by
    change (N * (a ^ q * y)) ^ (1 / p) =
      (a ^ q) ^ (1 / p) * (N * y) ^ (1 / p)
    rw [show N * (a ^ q * y) = a ^ q * (N * y) by ac_rfl]
    exact ENNReal.mul_rpow_of_nonneg _ _ hip
  have hfactor' : (a ^ q * w) ^ (1 / p) = common * w ^ (1 / p) := by
    change (a ^ q * w) ^ (1 / p) = (a ^ q) ^ (1 / p) * w ^ (1 / p)
    exact ENNReal.mul_rpow_of_nonneg _ _ hip
  apply (ENNReal.mul_le_mul_iff_right hcommonpos.ne' hcommontop).mp
  calc
    common * (x * (N * y) ^ (1 / p)) =
        x * (N * (a ^ q * y)) ^ (1 / p) := by rw [hfactor]; ac_rfl
    _ ≤ z * (a ^ q * w) ^ (1 / p) := h
    _ = common * (z * w ^ (1 / p)) := by rw [hfactor']; ac_rfl

/-- Solve the elementary Knapp inequality for the entropy factor.  Keeping
this as a separate algebra lemma avoids repeating divisions by the positive
cap and tube-volume constants below. -/
private theorem entropy_le_of_knapp_bound
    {N a m B : ℝ≥0∞} {p : ℝ}
    (hp : 0 < p) (ha0 : a ≠ 0) (hatop : a ≠ (∞ : ℝ≥0∞))
    (hm0 : m ≠ 0) (hmtop : m ≠ (∞ : ℝ≥0∞))
    (h : a * (N * m) ^ (1 / p) ≤ B) :
    N ≤ (B / a) ^ p / m := by
  have hroot : (N * m) ^ (1 / p) ≤ B / a := by
    apply (ENNReal.le_div_iff_mul_le (Or.inl ha0) (Or.inl hatop)).mpr
    simpa [mul_comm] using h
  have hpow := ENNReal.rpow_le_rpow hroot hp.le
  have hNm : N * m ≤ (B / a) ^ p := by
    calc
      N * m = ((N * m) ^ (1 / p)) ^ p := by
        rw [show 1 / p = p⁻¹ by rw [one_div], ENNReal.rpow_inv_rpow hp.ne']
      _ ≤ (B / a) ^ p := hpow
  apply (ENNReal.le_div_iff_mul_le (Or.inl hm0) (Or.inl hmtop)).mpr
  simpa [mul_comm] using hNm

/-- Homogeneous algebra for the origin-ball test. -/
private theorem scaled_knapp_entropy_rhs
    {C I cap tube t : ℝ≥0∞} {p u v : ℝ}
    (hp : 0 < p) (ht0 : t ≠ 0) (httop : t ≠ (∞ : ℝ≥0∞))
    (hcap0 : cap ≠ 0) (hcaptop : cap ≠ (∞ : ℝ≥0∞))
    (htube0 : tube ≠ 0) (htubetop : tube ≠ (∞ : ℝ≥0∞)) :
    ((C * (I * t ^ u) ^ (1 / p) / (cap * t ^ v)) ^ p / (tube * t)) =
      ((C * I ^ (1 / p) / cap) ^ p / tube) *
        t ^ (u - v * p - 1) := by
  have hq : 0 ≤ 1 / p := by positivity
  have hroot : (I * t ^ u) ^ (1 / p) =
      I ^ (1 / p) * t ^ (u * (1 / p)) := by
    calc
      (I * t ^ u) ^ (1 / p) = I ^ (1 / p) * (t ^ u) ^ (1 / p) :=
        ENNReal.mul_rpow_of_nonneg _ _ hq
      _ = I ^ (1 / p) * t ^ (u * (1 / p)) := by
        rw [ENNReal.rpow_mul]
  have hu : u * (1 / p) * p = u := by
    field_simp [hp.ne']
  have hnum : (C * (I * t ^ u) ^ (1 / p)) ^ p =
      (C * I ^ (1 / p)) ^ p * t ^ u := by
    calc
      (C * (I * t ^ u) ^ (1 / p)) ^ p =
          ((C * I ^ (1 / p)) * t ^ (u * (1 / p))) ^ p := by
            rw [hroot]
            congr 1
            ring
      _ = (C * I ^ (1 / p)) ^ p * (t ^ (u * (1 / p))) ^ p :=
        ENNReal.mul_rpow_of_nonneg _ _ hp.le
      _ = (C * I ^ (1 / p)) ^ p * t ^ (u * (1 / p) * p) := by
        rw [← ENNReal.rpow_mul]
      _ = (C * I ^ (1 / p)) ^ p * t ^ u := by rw [hu]
  have hden : (cap * t ^ v) ^ p = cap ^ p * t ^ (v * p) := by
    calc
      (cap * t ^ v) ^ p = cap ^ p * (t ^ v) ^ p :=
        ENNReal.mul_rpow_of_nonneg _ _ hp.le
      _ = cap ^ p * t ^ (v * p) := by rw [← ENNReal.rpow_mul]
  have htpos : 0 < t := pos_iff_ne_zero.mpr ht0
  have htpow0 (r : ℝ) : t ^ r ≠ 0 :=
    (ENNReal.rpow_pos htpos httop).ne'
  have htpowtop (r : ℝ) : t ^ r ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_ne_zero ht0 httop
  have hcappow0 : cap ^ p ≠ 0 :=
    (ENNReal.rpow_pos (pos_iff_ne_zero.mpr hcap0) hcaptop).ne'
  have hcapowtop : cap ^ p ≠ (∞ : ℝ≥0∞) :=
    ENNReal.rpow_ne_top_of_ne_zero hcap0 hcaptop
  have hscale : t ^ u / (t ^ (v * p) * t) =
      t ^ (u - v * p - 1) := by
    rw [show u - v * p - 1 = u - (v * p + 1) by ring,
      ENNReal.rpow_sub u (v * p + 1) ht0 httop,
      ENNReal.rpow_add (v * p) 1 ht0 httop, ENNReal.rpow_one]
  have hconst : (C * I ^ (1 / p) / cap) ^ p =
      (C * I ^ (1 / p)) ^ p / cap ^ p :=
    ENNReal.div_rpow_of_nonneg _ _ hp.le
  rw [ENNReal.div_rpow_of_nonneg _ _ hp.le, hnum, hden]
  calc
    ((C * I ^ (1 / p)) ^ p * t ^ u / (cap ^ p * t ^ (v * p))) /
        (tube * t) =
        ((C * I ^ (1 / p)) ^ p / cap ^ p / tube) *
          (t ^ u / (t ^ (v * p) * t)) := by
      simp only [ENNReal.div_eq_inv_mul]
      rw [ENNReal.mul_inv (Or.inl hcappow0) (Or.inl hcapowtop),
        ENNReal.mul_inv (Or.inl htube0) (Or.inl htubetop),
        ENNReal.mul_inv (Or.inl (htpow0 (v * p))) (Or.inl (htpowtop (v * p)))]
      ring
    _ = ((C * I ^ (1 / p) / cap) ^ p / tube) *
          t ^ (u - v * p - 1) := by
      rw [hconst, hscale]

private theorem origin_output_scale
    (n : ℕ) (hn : 0 < n) {α : ℝ} (c : PositiveRadius) (δ : ℝ≥0) :
    (ENNReal.ofReal ((c : ℝ) / 4)) ^ α *
        (volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) *
          ENNReal.ofReal (2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16))) =
      (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
        ((ENNReal.ofReal ((1 : ℝ) / 4)) ^ α *
          (volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) *
            ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8))) := by
  have hcpos : 0 < (c : ℝ) := c.2
  have hcenn0 : ENNReal.ofReal (c : ℝ) ≠ 0 :=
    ne_of_gt (ENNReal.ofReal_pos.mpr hcpos)
  have hweight : (ENNReal.ofReal ((c : ℝ) / 4)) ^ α =
      (ENNReal.ofReal (c : ℝ)) ^ α *
        (ENNReal.ofReal ((1 : ℝ) / 4)) ^ α := by
    rw [show (c : ℝ) / 4 = (c : ℝ) * ((1 : ℝ) / 4) by ring,
      ENNReal.ofReal_mul hcpos.le]
    exact ENNReal.mul_rpow_of_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top α
  have hvol : volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) =
      (ENNReal.ofReal (c : ℝ)) ^ n *
        volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) := by
    calc
      volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) =
          (ENNReal.ofReal ((c : ℝ) / 4)) ^ n *
            volume (ball (0 : Euclidean n) 1) := volume_ball_scale hn
      _ = (ENNReal.ofReal (c : ℝ)) ^ n *
          ((ENNReal.ofReal ((1 : ℝ) / 4)) ^ n *
            volume (ball (0 : Euclidean n) 1)) := by
        rw [show (c : ℝ) / 4 = (c : ℝ) * ((1 : ℝ) / 4) by ring,
          ENNReal.ofReal_mul hcpos.le, mul_pow]
        ring
      _ = (ENNReal.ofReal (c : ℝ)) ^ n *
          volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) := by
        congr 1
        exact (volume_ball_scale hn).symm
  have hthickness : ENNReal.ofReal
      (2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16)) =
      ENNReal.ofReal (c : ℝ) *
        ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8) := by
    rw [show 2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16) =
        (c : ℝ) * (Real.log 2 * (δ : ℝ) / 8) by ring,
      ENNReal.ofReal_mul hcpos.le]
  have hcpow : (ENNReal.ofReal (c : ℝ)) ^ α *
      (ENNReal.ofReal (c : ℝ)) ^ n * ENNReal.ofReal (c : ℝ) =
      (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) := by
    let a : ℝ≥0∞ := ENNReal.ofReal (c : ℝ)
    change a ^ α * a ^ n * a = a ^ (α + (n + 1 : ℕ))
    calc
      a ^ α * a ^ n * a = a ^ α * a ^ (n : ℝ) * a ^ (1 : ℝ) := by
        simp only [ENNReal.rpow_natCast, ENNReal.rpow_one]
      _ = a ^ (α + (n : ℝ)) * a ^ (1 : ℝ) := by
        rw [← ENNReal.rpow_add α (n : ℝ) hcenn0 ENNReal.ofReal_ne_top]
      _ = a ^ ((α + (n : ℝ)) + 1) := by
        rw [← ENNReal.rpow_add (α + (n : ℝ)) 1 hcenn0 ENNReal.ofReal_ne_top]
      _ = a ^ (α + (n + 1 : ℕ)) := by
        congr 1
        push_cast
        ring
  rw [hweight, hvol, hthickness]
  calc
    (ENNReal.ofReal (c : ℝ)) ^ α * (ENNReal.ofReal ((1 : ℝ) / 4)) ^ α *
        ((ENNReal.ofReal (c : ℝ)) ^ n *
          volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) *
          (ENNReal.ofReal (c : ℝ) *
            ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8))) =
        ((ENNReal.ofReal (c : ℝ)) ^ α *
          (ENNReal.ofReal (c : ℝ)) ^ n * ENNReal.ofReal (c : ℝ)) *
          ((ENNReal.ofReal ((1 : ℝ) / 4)) ^ α *
            (volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) *
              ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8))) := by
          ring
    _ = (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
          ((ENNReal.ofReal ((1 : ℝ) / 4)) ^ α *
            (volume (ball (0 : Euclidean n) ((1 : ℝ) / 4)) *
              ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8))) := by
          rw [hcpow]

private theorem volume_closedBall_smul_scale
    {d : ℕ} (hd : 0 < d) (c R : ℝ) (hc : 0 < c) :
    volume (closedBall (0 : Euclidean d) (c * R)) =
      (ENNReal.ofReal c) ^ d * volume (closedBall (0 : Euclidean d) R) := by
  calc
    volume (closedBall (0 : Euclidean d) (c * R)) =
        (ENNReal.ofReal (c * R)) ^ d *
          volume (closedBall (0 : Euclidean d) 1) := volume_closedBall_scale hd
    _ = (ENNReal.ofReal c) ^ d *
          ((ENNReal.ofReal R) ^ d * volume (closedBall (0 : Euclidean d) 1)) := by
      rw [ENNReal.ofReal_mul hc.le, mul_pow]
      ring
    _ = (ENNReal.ofReal c) ^ d * volume (closedBall (0 : Euclidean d) R) := by
      congr 1
      exact (volume_closedBall_scale hd).symm

private theorem origin_input_scale_upper
    (n : ℕ) {α : ℝ} (hα : 0 ≤ α) (c : PositiveRadius) (δ : ℝ≥0) :
    powerWeightedVolume (n + 1) α
        (closedBall (0 : Euclidean (n + 1))
          (2 * ((c : ℝ) * (δ : ℝ)))) ≤
      (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
        ((ENNReal.ofReal (2 * (δ : ℝ))) ^ α *
          volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ))) ) := by
  have hcpos : 0 < (c : ℝ) := c.2
  have hcenn0 : ENNReal.ofReal (c : ℝ) ≠ 0 :=
    ne_of_gt (ENNReal.ofReal_pos.mpr hcpos)
  have hdpos : 0 < n + 1 := by omega
  have hweight : (ENNReal.ofReal (2 * ((c : ℝ) * (δ : ℝ)))) ^ α =
      (ENNReal.ofReal (c : ℝ)) ^ α *
        (ENNReal.ofReal (2 * (δ : ℝ))) ^ α := by
    rw [show 2 * ((c : ℝ) * (δ : ℝ)) = (c : ℝ) * (2 * (δ : ℝ)) by ring,
      ENNReal.ofReal_mul hcpos.le]
    exact ENNReal.mul_rpow_of_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top α
  have hvolume : volume (closedBall (0 : Euclidean (n + 1))
      (2 * ((c : ℝ) * (δ : ℝ)))) =
      (ENNReal.ofReal (c : ℝ)) ^ (n + 1) *
        volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ))) := by
    rw [show 2 * ((c : ℝ) * (δ : ℝ)) = (c : ℝ) * (2 * (δ : ℝ)) by ring]
    exact volume_closedBall_smul_scale hdpos (c : ℝ) (2 * (δ : ℝ)) hcpos
  calc
    powerWeightedVolume (n + 1) α
        (closedBall (0 : Euclidean (n + 1))
          (2 * ((c : ℝ) * (δ : ℝ)))) ≤
        (ENNReal.ofReal (2 * ((c : ℝ) * (δ : ℝ)))) ^ α *
          volume (closedBall (0 : Euclidean (n + 1))
            (2 * ((c : ℝ) * (δ : ℝ)))) :=
      powerWeightedVolume_closedBall_le hα
    _ = ((ENNReal.ofReal (c : ℝ)) ^ α *
          (ENNReal.ofReal (2 * (δ : ℝ))) ^ α) *
        ((ENNReal.ofReal (c : ℝ)) ^ (n + 1) *
          volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ)))) := by
      rw [hweight, hvolume]
    _ = (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
        ((ENNReal.ofReal (2 * (δ : ℝ))) ^ α *
          volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ))) ) := by
      have hcpow : (ENNReal.ofReal (c : ℝ)) ^ α *
          (ENNReal.ofReal (c : ℝ)) ^ (n + 1) =
          (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) := by
        let a : ℝ≥0∞ := ENNReal.ofReal (c : ℝ)
        change a ^ α * a ^ (n + 1) = a ^ (α + (n + 1 : ℕ))
        have hnat : a ^ (n + 1) = a ^ ((n + 1 : ℕ) : ℝ) :=
          (ENNReal.rpow_natCast a (n + 1)).symm
        calc
          a ^ α * a ^ (n + 1) = a ^ α * a ^ ((n + 1 : ℕ) : ℝ) := by rw [hnat]
          _ = a ^ (α + ((n + 1 : ℕ) : ℝ)) :=
            (ENNReal.rpow_add α ((n + 1 : ℕ) : ℝ) hcenn0 ENNReal.ofReal_ne_top).symm
      calc
        (ENNReal.ofReal (c : ℝ)) ^ α *
            (ENNReal.ofReal (2 * (δ : ℝ))) ^ α *
            ((ENNReal.ofReal (c : ℝ)) ^ (n + 1) *
              volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ)))) =
            ((ENNReal.ofReal (c : ℝ)) ^ α *
              (ENNReal.ofReal (c : ℝ)) ^ (n + 1)) *
              ((ENNReal.ofReal (2 * (δ : ℝ))) ^ α *
                volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ)))) := by
              ring
        _ = (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
              ((ENNReal.ofReal (2 * (δ : ℝ))) ^ α *
                volume (closedBall (0 : Euclidean (n + 1)) (2 * (δ : ℝ))) ) := by
              rw [hcpow]

/-- At the origin-ball scale the cap factor contributes exactly `δ^n`. -/
theorem ballOriginCapFactor_scale
    (n : ℕ) (hn : 2 ≤ n) {δ : ℝ≥0} (hδ : 0 < δ) :
    ballOriginCapFactor n δ =
      ballOriginCapConstant n * ((δ : ℝ≥0∞) ^ n) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hfirst : ENNReal.ofReal (((δ : ℝ) / 8) / 2) =
      (δ : ℝ≥0∞) * ENNReal.ofReal ((1 : ℝ) / 16) := by
    rw [show ((δ : ℝ) / 8) / 2 = (δ : ℝ) * ((1 : ℝ) / 16) by ring,
      ENNReal.ofReal_mul hδreal.le]
    simp
  have hsecond : ENNReal.ofReal (((δ : ℝ) / 8) ^ 2 / 4) =
      (δ : ℝ≥0∞) ^ 2 * ENNReal.ofReal ((1 : ℝ) / 256) := by
    rw [show ((δ : ℝ) / 8) ^ 2 / 4 = (δ : ℝ) ^ 2 * ((1 : ℝ) / 256) by ring,
      ENNReal.ofReal_mul (sq_nonneg _), ENNReal.ofReal_pow hδreal.le]
    simp
  unfold ballOriginCapFactor ballOriginCapConstant
  rw [hfirst, hsecond, mul_pow]
  have hpow : (δ : ℝ≥0∞) ^ (n - 2) * (δ : ℝ≥0∞) ^ 2 =
      (δ : ℝ≥0∞) ^ n := by
    rw [← pow_add, Nat.sub_add_cancel hn]
  rw [show
    ENNReal.ofReal (surfaceMass n) *
        (((δ : ℝ≥0∞) ^ (n - 2) * ENNReal.ofReal ((1 : ℝ) / 16) ^ (n - 2)) *
          ((δ : ℝ≥0∞) ^ 2 * ENNReal.ofReal ((1 : ℝ) / 256))) =
      (ENNReal.ofReal (surfaceMass n) *
        (ENNReal.ofReal ((1 : ℝ) / 16) ^ (n - 2) *
          ENNReal.ofReal ((1 : ℝ) / 256))) *
        ((δ : ℝ≥0∞) ^ (n - 2) * (δ : ℝ≥0∞) ^ 2) by ring,
    hpow]
  simp only [div_eq_mul_inv]
  ring

/-- The shell-mass factor contributes one further radial power of `δ`. -/
theorem ballOriginTubeMass_scale
    (n : ℕ) (α : ℝ) {δ : ℝ≥0} (hδ : 0 < δ) :
    ballOriginTubeMass n α δ =
      ballOriginTubeConstant n α * (δ : ℝ≥0∞) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hlog : 0 < Real.log 2 / 8 := by positivity
  have hthickness : ENNReal.ofReal (Real.log 2 * (δ : ℝ) / 8) =
      ENNReal.ofReal (Real.log 2 / 8) * (δ : ℝ≥0∞) := by
    rw [show Real.log 2 * (δ : ℝ) / 8 =
        (Real.log 2 / 8) * (δ : ℝ) by ring,
      ENNReal.ofReal_mul hlog.le]
    simp
  unfold ballOriginTubeMass ballOriginTubeConstant
  rw [hthickness]
  ring

/-- The input-ball upper bound has homogeneous degree `α + n + 1`. -/
theorem ballOriginInputMass_scale
    (n : ℕ) (α : ℝ) {δ : ℝ≥0} (hδ : 0 < δ) :
    ballOriginInputMass n α δ =
      ballOriginInputConstant n α *
        ((δ : ℝ≥0∞) ^ (α + (n + 1 : ℕ))) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hδzero : (δ : ℝ≥0∞) ≠ 0 := ne_of_gt (by exact_mod_cast hδ)
  have hδtop : (δ : ℝ≥0∞) ≠ (∞ : ℝ≥0∞) := ENNReal.coe_ne_top
  have hweight : (ENNReal.ofReal (2 * (δ : ℝ))) ^ α =
      (ENNReal.ofReal (2 : ℝ)) ^ α * (δ : ℝ≥0∞) ^ α := by
    rw [show 2 * (δ : ℝ) = (2 : ℝ) * (δ : ℝ) by ring,
      ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
    simp only [ENNReal.ofReal_ofNat, ENNReal.ofReal_coe_nnreal]
    exact ENNReal.mul_rpow_of_ne_top (by norm_num) ENNReal.coe_ne_top α
  have hvolume : volume (closedBall (0 : Euclidean (n + 1))
      (2 * (δ : ℝ))) =
      (δ : ℝ≥0∞) ^ (n + 1) *
        volume (closedBall (0 : Euclidean (n + 1)) 2) := by
    rw [show 2 * (δ : ℝ) = (δ : ℝ) * 2 by ring]
    simpa using volume_closedBall_smul_scale (d := n + 1) (by omega)
      (δ : ℝ) 2 hδreal
  unfold ballOriginInputMass ballOriginInputConstant
  rw [hweight, hvolume]
  have hpow : (δ : ℝ≥0∞) ^ α * (δ : ℝ≥0∞) ^ (n + 1) =
      (δ : ℝ≥0∞) ^ (α + (n + 1 : ℕ)) := by
    rw [show (δ : ℝ≥0∞) ^ (n + 1) =
        (δ : ℝ≥0∞) ^ ((n + 1 : ℕ) : ℝ) by simp only [ENNReal.rpow_natCast],
      ← ENNReal.rpow_add α ((n + 1 : ℕ) : ℝ) hδzero hδtop]
  rw [show
    ENNReal.ofReal (2 : ℝ) ^ α * (δ : ℝ≥0∞) ^ α *
        ((δ : ℝ≥0∞) ^ (n + 1) *
          volume (closedBall (0 : Euclidean (n + 1)) 2)) =
      (ENNReal.ofReal (2 : ℝ) ^ α *
        volume (closedBall (0 : Euclidean (n + 1)) 2)) *
        ((δ : ℝ≥0∞) ^ α * (δ : ℝ≥0∞) ^ (n + 1)) by ring,
    hpow]

/-- A strong-type estimate forces a uniform power bound for the unit-window
entropy.  This is the quantitative form of the origin-ball obstruction; all
dependence on the multiplicative interval centre has cancelled. -/
theorem exists_unitMultiplicativeEntropy_ballOrigin_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (hppos : 0 < p) (hα : 0 ≤ α) :
    ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ≥0, 0 < δ → δ ≤ 1 →
      (unitMultiplicativeEntropy E δ).toENNReal ≤
        ((ENNReal.ofReal C * (ballOriginInputMass n α δ) ^ (1 / p)) /
          ballOriginCapFactor n δ) ^ p /
          ballOriginTubeMass n α δ := by
  classical
  rcases hstrong with ⟨C, hC, hstrong⟩
  refine ⟨C, hC, ?_⟩
  intro δ hδ hδone
  unfold unitMultiplicativeEntropy
  rw [ENat.toENNReal_iSup]
  apply iSup_le
  intro c
  have htest := restrictedStrongType_ballOrigin_unit_localEntropy_lower_of_bound
    n hn hstrong c δ hδ hδone hppos hα
  have houtput :
      (ENNReal.ofReal ((c : ℝ) / 4)) ^ α *
          (volume (ball (0 : Euclidean n) ((c : ℝ) / 4)) *
            ENNReal.ofReal
              (2 * ((c : ℝ) * Real.log 2 * (δ : ℝ) / 16))) =
        (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
          ballOriginTubeMass n α δ := by
    simpa only [ballOriginTubeMass] using
      origin_output_scale n (by omega) (α := α) c δ
  rw [houtput] at htest
  have htest' :
      ballOriginCapFactor n δ *
          ((localMultiplicativeEntropy E c 1 δ).toENNReal *
            ((ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
              ballOriginTubeMass n α δ)) ^ (1 / p) ≤
        ENNReal.ofReal C *
          (powerWeightedVolume (n + 1) α
            (closedBall (0 : Euclidean (n + 1))
              (2 * ((c : ℝ) * (δ : ℝ))))) ^ (1 / p) := by
    simpa only [ballOriginCapFactor, ENNReal.toReal_ofReal hppos.le] using htest
  have hinput : powerWeightedVolume (n + 1) α
      (closedBall (0 : Euclidean (n + 1))
        (2 * ((c : ℝ) * (δ : ℝ)))) ≤
      (ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
        ballOriginInputMass n α δ := by
    simpa only [ballOriginInputMass] using origin_input_scale_upper n hα c δ
  have hinputpow :
      (powerWeightedVolume (n + 1) α
        (closedBall (0 : Euclidean (n + 1))
          (2 * ((c : ℝ) * (δ : ℝ))))) ^ (1 / p) ≤
        ((ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
          ballOriginInputMass n α δ) ^ (1 / p) :=
    ENNReal.rpow_le_rpow hinput (by positivity)
  have htestscale :
      ballOriginCapFactor n δ *
          ((localMultiplicativeEntropy E c 1 δ).toENNReal *
            ((ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
              ballOriginTubeMass n α δ)) ^ (1 / p) ≤
        ENNReal.ofReal C *
          (((ENNReal.ofReal (c : ℝ)) ^ (α + (n + 1 : ℕ)) *
            ballOriginInputMass n α δ) ^ (1 / p)) :=
    htest'.trans (by
      simpa only [mul_comm] using mul_le_mul_left hinputpow (ENNReal.ofReal C))
  have hcancel := cancel_center_scale_in_rpow_bound
    (a := ENNReal.ofReal (c : ℝ))
    (N := (localMultiplicativeEntropy E c 1 δ).toENNReal)
    (x := ballOriginCapFactor n δ) (y := ballOriginTubeMass n α δ)
    (z := ENNReal.ofReal C) (w := ballOriginInputMass n α δ)
    (ne_of_gt (ENNReal.ofReal_pos.mpr c.2)) ENNReal.ofReal_ne_top hppos htestscale
  exact entropy_le_of_knapp_bound hppos
    (ballOriginCapFactor_pos n hn hδ).ne'
    (ballOriginCapFactor_ne_top n δ)
    (ballOriginTubeMass_pos n α hδ).ne'
    (ballOriginTubeMass_ne_top n α δ) hcancel

/-- The preceding estimate is homogeneous in the observing scale.  In
particular it has the usual inverse-power form with exponent
`n (p - 1) - α`. -/
theorem exists_unitMultiplicativeEntropy_ballOrigin_power_bound
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α)
    (hppos : 0 < p) (hα : 0 ≤ α) :
    ∃ A : ℝ≥0∞, A ≠ (∞ : ℝ≥0∞) ∧ ∀ δ : ℝ≥0, 0 < δ → δ ≤ 1 →
      (unitMultiplicativeEntropy E δ).toENNReal ≤
        A * (δ : ℝ≥0∞) ^ (-((n : ℝ) * (p - 1) - α)) := by
  rcases exists_unitMultiplicativeEntropy_ballOrigin_bound n hn hstrong hppos hα with
    ⟨C, hC, hbound⟩
  let A : ℝ≥0∞ :=
    ((ENNReal.ofReal C * (ballOriginInputConstant n α) ^ (1 / p) /
      ballOriginCapConstant n) ^ p / ballOriginTubeConstant n α)
  have hinnerpos : 0 < ENNReal.ofReal C *
      (ballOriginInputConstant n α) ^ (1 / p) /
        ballOriginCapConstant n := by
    apply ENNReal.div_pos
    · apply ne_of_gt
      apply ENNReal.mul_pos
      · exact (ENNReal.ofReal_pos.mpr hC).ne'
      · exact (ENNReal.rpow_pos (ballOriginInputConstant_pos n α)
          (ballOriginInputConstant_ne_top n α)).ne'
    · exact ballOriginCapConstant_ne_top n
  have hinnertop : ENNReal.ofReal C *
      (ballOriginInputConstant n α) ^ (1 / p) /
        ballOriginCapConstant n ≠ (∞ : ℝ≥0∞) := by
    apply ENNReal.div_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero
          (ballOriginInputConstant_pos n α).ne'
          (ballOriginInputConstant_ne_top n α)
    · exact (ballOriginCapConstant_pos n hn).ne'
  have hAtop : A ≠ (∞ : ℝ≥0∞) := by
    dsimp only [A]
    apply ENNReal.div_ne_top
    · exact ENNReal.rpow_ne_top_of_ne_zero hinnerpos.ne' hinnertop
    · exact (ballOriginTubeConstant_pos n α).ne'
  refine ⟨A, hAtop, ?_⟩
  intro δ hδ hδone
  have hinputscale := ballOriginInputMass_scale n α hδ
  have hcapscale : ballOriginCapFactor n δ =
      ballOriginCapConstant n * (δ : ℝ≥0∞) ^ (n : ℝ) := by
    rw [ballOriginCapFactor_scale n hn hδ]
    simp only [ENNReal.rpow_natCast]
  have htubescale := ballOriginTubeMass_scale n α hδ
  calc
    (unitMultiplicativeEntropy E δ).toENNReal ≤
        ((ENNReal.ofReal C * (ballOriginInputMass n α δ) ^ (1 / p)) /
          ballOriginCapFactor n δ) ^ p /
          ballOriginTubeMass n α δ := hbound δ hδ hδone
    _ = ((ENNReal.ofReal C *
          (ballOriginInputConstant n α *
            (δ : ℝ≥0∞) ^ (α + (n + 1 : ℕ))) ^ (1 / p) /
          (ballOriginCapConstant n * (δ : ℝ≥0∞) ^ (n : ℝ))) ^ p /
          (ballOriginTubeConstant n α * (δ : ℝ≥0∞))) := by
      rw [hinputscale, hcapscale, htubescale]
    _ = A * (δ : ℝ≥0∞) ^
          ((α + (n + 1 : ℕ)) - (n : ℝ) * p - 1) := by
      dsimp only [A]
      exact scaled_knapp_entropy_rhs hppos
        (ne_of_gt (by exact_mod_cast hδ)) ENNReal.coe_ne_top
        (ballOriginCapConstant_pos n hn).ne'
        (ballOriginCapConstant_ne_top n)
        (ballOriginTubeConstant_pos n α).ne'
        (ballOriginTubeConstant_ne_top n α)
    _ = A * (δ : ℝ≥0∞) ^ (-((n : ℝ) * (p - 1) - α)) := by
      congr 2
      push_cast
      ring


/-- The origin-ball Knapp test gives the upper power-weight face for
nonnegative weights.  No compactness or nonemptiness hypothesis on the
radius set is needed. -/
theorem alpha_add_multiplicativeMinkowskiExponent_le_of_restrictedStrongType_of_nonneg
    (n : ℕ) (hn : 2 ≤ n) {E : Set ℝ} {p α : ℝ}
    (hppos : 0 < p) (hα : 0 ≤ α)
    (hstrong : HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType
      (n + 1) E p α) :
    (α : EReal) + multiplicativeMinkowskiExponent E ≤
      ((n : ℝ) * (p - 1) : EReal) := by
  rcases exists_unitMultiplicativeEntropy_ballOrigin_power_bound n hn hstrong hppos hα with
    ⟨A, hAtop, hbound⟩
  have hsmall : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0), δ ∈ Ioo 0 1 :=
    nhdsGT_basis 0 |>.mem_of_mem zero_lt_one
  have hpower : ∀ᶠ δ : ℝ≥0 in 𝓝[>] (0 : ℝ≥0),
      (unitMultiplicativeEntropy E δ).toENNReal ≤
        A * (δ : ℝ≥0∞) ^ (-((n : ℝ) * (p - 1) - α)) := by
    filter_upwards [hsmall] with δ hδ
    exact hbound δ hδ.1 hδ.2.le
  have hβ : multiplicativeMinkowskiExponent E ≤
      (((n : ℝ) * (p - 1) - α : ℝ) : EReal) :=
    multiplicativeMinkowskiExponent_le_of_unitEntropy_power_bound hAtop hpower
  calc
    (α : EReal) + multiplicativeMinkowskiExponent E ≤
        (α : EReal) + (((n : ℝ) * (p - 1) - α : ℝ) : EReal) :=
      by simpa only [add_comm] using add_le_add_right hβ (α : EReal)
    _ = ((n : ℝ) * (p - 1) : EReal) := by
      norm_cast
      ring

/-- The planar cap factor has the sharp linear scale supplied by the circle
surface-measure estimate. -/
private def planarBallOriginCapFactor (κ : ℝ≥0∞) (δ : ℝ≥0) : ℝ≥0∞ :=
  κ * ENNReal.ofReal ((δ : ℝ) / 8) / ENNReal.ofReal (surfaceMass 2)

/-- The scale-free part of the planar cap factor. -/
private def planarBallOriginCapConstant (κ : ℝ≥0∞) : ℝ≥0∞ :=
  κ * ENNReal.ofReal ((1 : ℝ) / 8) / ENNReal.ofReal (surfaceMass 2)

private theorem planarBallOriginCapFactor_pos {κ : ℝ≥0∞} (hκ : 0 < κ)
    {δ : ℝ≥0} (hδ : 0 < δ) :
    0 < planarBallOriginCapFactor κ δ := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  have hfrac : 0 < (δ : ℝ) / 8 := div_pos hδreal (by norm_num)
  unfold planarBallOriginCapFactor
  apply ENNReal.div_pos
  · exact (ENNReal.mul_pos (ne_of_gt hκ)
      (ENNReal.ofReal_pos.mpr hfrac).ne').ne'
  · exact ENNReal.ofReal_ne_top

private theorem planarBallOriginCapFactor_ne_top {κ : ℝ≥0∞} (hκtop : κ ≠ (∞ : ℝ≥0∞))
    (δ : ℝ≥0) :
    planarBallOriginCapFactor κ δ ≠ (∞ : ℝ≥0∞) := by
  unfold planarBallOriginCapFactor
  apply ENNReal.div_ne_top
  · exact ENNReal.mul_ne_top hκtop ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by norm_num))).ne'

private theorem planarBallOriginCapConstant_pos {κ : ℝ≥0∞} (hκ : 0 < κ) :
    0 < planarBallOriginCapConstant κ := by
  have hfrac : 0 < (1 : ℝ) / 8 := by norm_num
  unfold planarBallOriginCapConstant
  apply ENNReal.div_pos
  · exact (ENNReal.mul_pos (ne_of_gt hκ)
      (ENNReal.ofReal_pos.mpr hfrac).ne').ne'
  · exact ENNReal.ofReal_ne_top

private theorem planarBallOriginCapConstant_ne_top {κ : ℝ≥0∞}
    (hκtop : κ ≠ (∞ : ℝ≥0∞)) :
    planarBallOriginCapConstant κ ≠ (∞ : ℝ≥0∞) := by
  unfold planarBallOriginCapConstant
  apply ENNReal.div_ne_top
  · exact ENNReal.mul_ne_top hκtop ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by norm_num))).ne'

private theorem planarBallOriginCapFactor_scale (κ : ℝ≥0∞) {δ : ℝ≥0} (hδ : 0 < δ) :
    planarBallOriginCapFactor κ δ = planarBallOriginCapConstant κ * (δ : ℝ≥0∞) := by
  have hδreal : 0 < (δ : ℝ) := by exact_mod_cast hδ
  unfold planarBallOriginCapFactor planarBallOriginCapConstant
  rw [show (δ : ℝ) / 8 = (δ : ℝ) * ((1 : ℝ) / 8) by ring,
    ENNReal.ofReal_mul hδreal.le]
  rw [ENNReal.ofReal_coe_nnreal]
  change κ * ((δ : ℝ≥0∞) * ENNReal.ofReal ((1 : ℝ) / 8)) /
      ENNReal.ofReal (surfaceMass 2) =
    (κ * ENNReal.ofReal ((1 : ℝ) / 8) /
      ENNReal.ofReal (surfaceMass 2)) * (δ : ℝ≥0∞)
  simp only [ENNReal.div_eq_inv_mul]
  ac_rfl

/-- The circle version of the moving-cap lower bound.  The geometric
inclusion is dimension-free; the new ingredient is the linear circle-cap
measure lower bound. -/
private theorem planar_radialShell_cap_average_lower
    (κ : ℝ≥0∞)
    (hκ : ∀ {v : Euclidean 2}, ‖v‖ = 1 → ∀ {h : ℝ}, 0 < h → h ≤ 1 / 2 →
      κ * ENNReal.ofReal h ≤ unitSurfaceMeasure 2 (sphericalCap 1 v h))
    {r b h R : ℝ} (hr : 0 < r) (hinner : b < r)
    (hmargin : b + r * h ≤ R) (hh : 0 < h) (hhalf : h ≤ 1 / 2)
    (g : Euclidean 2 → ℝ) (hgContinuous : Continuous g)
    (hgnonneg : ∀ y, 0 ≤ g y)
    (hg_one : ∀ y, ‖y‖ ≤ R → g y = 1)
    {x : Euclidean 2} (hx : x ∈ radialShell 2 r b) :
    κ * ENNReal.ofReal h / ENNReal.ofReal (surfaceMass 2) ≤
      ENNReal.ofReal ‖normalizedSphericalAverage 2
        (fun y => (g y : ℂ)) r x‖ := by
  have hxshell : |‖x‖ - r| < b := hx
  have hxnorm : 0 < ‖x‖ := by
    have : r - b < ‖x‖ := by
      rcases abs_lt.mp hxshell with ⟨hlow, _⟩
      linarith
    linarith
  have hdir : ‖inwardRadialDirection x‖ = 1 := norm_inwardRadialDirection hxnorm
  have hgi : Integrable (fun w : sphere (0 : Euclidean 2) 1 =>
      g (x + r • (w : Euclidean 2))) (unitSurfaceMeasure 2) := by
    have hcont : Continuous (fun w : sphere (0 : Euclidean 2) 1 =>
        g (x + r • (w : Euclidean 2))) := by
      apply hgContinuous.comp
      fun_prop
    exact hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.of_compactSpace _)
  apply planar_sphericalCap_lower_le_ennreal_norm_normalizedSphericalAverage
    hκ g r x (v := inwardRadialDirection x) hdir (h := h) hh hhalf hgi
  · intro w
    exact hgnonneg _
  · intro w hw
    apply hg_one
    have hmem := inwardRadial_cap_translate_subset_ball (n := 1)
      hr hinner hmargin hx hw
    rw [Metric.mem_ball, dist_zero_right] at hmem
    exact hmem.le

/-- The finite circle origin-ball test with an arbitrary nonnegative power
weight. -/
private theorem planar_ballOrigin_finite_lower_of_bound
    (κ : ℝ≥0∞)
    (hκ : ∀ {v : Euclidean 2}, ‖v‖ = 1 → ∀ {h : ℝ}, 0 < h → h ≤ 1 / 2 →
      κ * ENNReal.ofReal h ≤ unitSurfaceMeasure 2 (sphericalCap 1 v h))
    {E : Set ℝ} {p α C : ℝ}
    (hstrong : ∀ f : SchwartzMap (Euclidean 2) ℂ,
      MemLp (f : Euclidean 2 → ℂ) (ENNReal.ofReal p) (powerWeightedVolume 2 α) →
        MemLp (restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 α) ∧
        eLpNorm (restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ))
          (ENNReal.ofReal p) (powerWeightedVolume 2 α) ≤
          ENNReal.ofReal C * eLpNorm (f : Euclidean 2 → ℂ)
            (ENNReal.ofReal p) (powerWeightedVolume 2 α))
    (T : Finset PositiveRadius) {b h R : ℝ} {m : ℝ≥0∞}
    (hT : ∀ r ∈ T, (r : ℝ) ∈ E)
    (hsep : ∀ r ∈ T, ∀ s ∈ T, r ≠ s → 2 * b ≤ |(r : ℝ) - (s : ℝ)|)
    (hm : ∀ r ∈ T, m ≤ powerWeightedVolume 2 α (radialShell 2 (r : ℝ) b))
    (hppos : 0 < p) (hRpos : 0 < R) (hh : 0 < h) (hhalf : h ≤ 1 / 2)
    (hinner : ∀ r ∈ T, b < (r : ℝ))
    (hmargin : ∀ r ∈ T, b + (r : ℝ) * h ≤ R)
    (hDfinite : powerWeightedVolume 2 α
      (closedBall (0 : Euclidean 2) (2 * R)) ≠ (∞ : ℝ≥0∞)) :
    (κ * ENNReal.ofReal h / ENNReal.ofReal (surfaceMass 2)) *
        ((T.card : ℝ≥0∞) * m) ^ (1 / (ENNReal.ofReal p).toReal) ≤
      ENNReal.ofReal C *
        (powerWeightedVolume 2 α (closedBall (0 : Euclidean 2) (2 * R))) ^
          (1 / (ENNReal.ofReal p).toReal) := by
  classical
  let D : Set (Euclidean 2) := closedBall 0 (2 * R)
  let U : PositiveRadius → Set (Euclidean 2) :=
    fun r => radialShell 2 (r : ℝ) b
  let V : Set (Euclidean 2) := ⋃ r ∈ (↑T : Set PositiveRadius), U r
  rcases exists_schwartz_nonnegative_ball_test 2 hRpos with
    ⟨g, f, hfg, hgcont, hgnonneg, hgleone, hgone, hzero⟩
  have hp0 : ENNReal.ofReal p ≠ 0 := ne_of_gt (ENNReal.ofReal_pos.mpr hppos)
  have hinput : eLpNorm (f : Euclidean 2 → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume 2 α) ≤
      (powerWeightedVolume 2 α D) ^ (1 / (ENNReal.ofReal p).toReal) := by
    dsimp only [D]
    exact eLpNorm_nonnegative_ball_cutoff_le 2 hp0 g f hfg
      hgnonneg hgleone hzero
  have hq : 0 ≤ 1 / (ENNReal.ofReal p).toReal := by
    rw [ENNReal.toReal_ofReal hppos.le]
    positivity
  have hf : MemLp (f : Euclidean 2 → ℂ) (ENNReal.ofReal p)
      (powerWeightedVolume 2 α) := by
    refine lt_of_le_of_lt hinput ?_
    exact ENNReal.rpow_lt_top_of_nonneg hq (by simpa only [D] using hDfinite)
  have hUmeas : ∀ r ∈ T, MeasurableSet (U r) := by
    intro r hr
    exact measurableSet_radialShell 2 (r : ℝ) b
  have hUdisjoint : (↑T : Set PositiveRadius).PairwiseDisjoint U := by
    intro r hr s hs hrs
    change Disjoint (U r) (U s)
    exact disjoint_radialShell_of_radius_separated 2
      (hsep r (by simpa using hr) s (by simpa using hs) hrs)
  have hVmeas : MeasurableSet V := by
    dsimp only [V]
    exact T.measurableSet_biUnion hUmeas
  have hpoint : ∀ x ∈ V,
      κ * ENNReal.ofReal h / ENNReal.ofReal (surfaceMass 2) ≤
        restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ) x := by
    intro x hx
    rcases Set.mem_iUnion.mp hx with ⟨r, hx⟩
    rcases Set.mem_iUnion.mp hx with ⟨hrT, hxr⟩
    calc
      κ * ENNReal.ofReal h / ENNReal.ofReal (surfaceMass 2) ≤
          ENNReal.ofReal ‖normalizedSphericalAverage 2
            (fun y => (g y : ℂ)) (r : ℝ) x‖ :=
        planar_radialShell_cap_average_lower κ hκ r.2 (hinner r hrT)
          (hmargin r hrT) hh hhalf g hgcont hgnonneg hgone hxr
      _ = ENNReal.ofReal ‖normalizedSphericalAverage 2
          (f : Euclidean 2 → ℂ) (r : ℝ) x‖ := by
        have hfun : (fun y : Euclidean 2 => (g y : ℂ)) = (f : Euclidean 2 → ℂ) := by
          funext y
          exact (hfg y).symm
        rw [hfun]
      _ ≤ restrictedNormalizedSphericalMaximal 2 E (f : Euclidean 2 → ℂ) x :=
        ennreal_norm_normalizedSphericalAverage_le_restrictedNormalizedSphericalMaximal
          f (hT r hrT) r.2 x
  have hvolume : (T.card : ℝ≥0∞) * m ≤ powerWeightedVolume 2 α V := by
    calc
      (T.card : ℝ≥0∞) * m = ∑ r ∈ T, m := by simp [mul_comm]
      _ ≤ ∑ r ∈ T, powerWeightedVolume 2 α (U r) := by
        gcongr with r hr
        exact hm r hr
      _ = powerWeightedVolume 2 α V := by
        dsimp only [V]
        exact (measure_biUnion_finset hUdisjoint hUmeas).symm
  have hbound := restrictedStrongType_knapp_entropy_test_bound_of_bound
    hstrong (f := f) hf hVmeas hpoint hinput hvolume hppos
  simpa only [D] using hbound

/-- The planar origin-ball test in a fixed unit multiplicative window. -/
private theorem planar_ballOrigin_unit_localEntropy_lower_of_bound
