/-- The Legendre--Assouad exponent is globally one-Lipschitz in its penalty
parameter, in the one-sided form needed when admissible parameters are
passed to a limit. -/
theorem multiplicativeLegendreAssouadExponent_le_add_abs_sub
    (E : Set ℝ) (rho sigma : ℝ) :
