      multiplicativeLegendreAssouadExponent E rho ≤
          multiplicativeLegendreAssouadExponent E sigma := hmono
      _ ≤ multiplicativeLegendreAssouadExponent E sigma +
          ((|rho - sigma| : ℝ) : EReal) := by
            exact le_add_of_nonneg_right (by positivity)
