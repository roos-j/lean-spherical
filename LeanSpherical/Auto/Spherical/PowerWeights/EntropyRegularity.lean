    dsimp [D]
    exact ENNReal.coe_pos.mpr (lt_of_lt_of_le hdelta diam.2.1)
  have hDzero : D ≠ 0 := hDpos.ne'
  have hDtop : D ≠ ∞ := ENNReal.coe_ne_top
