  have hpoint (x : Euclidean d) : L x ≤ ENNReal.ofReal (M x) := by
    calc
      L x ≤ relativeLowpassMaximalRaw d phi f x :=
        restrictedRelativeLowpassSphericalMaximal_le_relativeLowpassMaximalRaw E phi f x
