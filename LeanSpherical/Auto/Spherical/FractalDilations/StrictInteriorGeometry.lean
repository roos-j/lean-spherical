    (hcluster : 0 < clusterEdgeFunctional d (beta / gamma) beta x) :
    StrictTriangle134Combination d beta gamma x := by
  let D : Real := d
  let H : Real := D - 1
  let A : Real := D - beta
  let B : Real := A + 1
  let T : Real := D ^ 2 + 2 * gamma - 1
  let alpha : Real := beta / gamma
  let C : Real := alpha / 2 * H
  let w3 : Real := (D * x.2 - x.1) * B / beta
  let w4 : Real := (x.1 - A * x.2) * T / (beta * H)
  let w1 : Real := 1 - w3 - w4
  have hD : 2 ≤ D := by
    simpa only [D] using (show (2 : Real) ≤ (d : Real) by exact_mod_cast hd)
  have hgamma : 0 < gamma := lt_of_lt_of_le hbeta hbeta_gamma
  have hH : 0 < H := by dsimp [H]; linarith
  have hB : 0 < B := by dsimp [B, A]; linarith
  have hT : 0 < T := by
    dsimp [T]
    nlinarith [sq_nonneg (D - 2)]
  have halpha : 0 < alpha := by dsimp [alpha]; exact div_pos hbeta hgamma
  have hC : 0 < C := by
    dsimp [C]
    exact mul_pos (div_pos halpha (by norm_num)) hH
  have hD0 : (d : Real) - 1 ≠ 0 := by linarith
  have hB0 : (d : Real) - beta + 1 ≠ 0 := by linarith
  have hT0 : (d : Real) ^ 2 + 2 * gamma - 1 ≠ 0 := by
    change D ^ 2 + 2 * gamma - 1 ≠ 0
    exact hT.ne'
  have hgamma0 : gamma ≠ 0 := hgamma.ne'
  have hw3 : 0 < w3 := by
    apply div_pos
    · exact mul_pos (by dsimp [D]; linarith) hB
    · exact hbeta
  have hw4 : 0 < w4 := by
    apply div_pos
    · exact mul_pos (by dsimp [A]; linarith) hT
    · exact mul_pos hbeta hH
  have hweight_identity : clusterEdgeFunctional d (beta / gamma) beta x = C * w1 := by
    dsimp [D, H, A, B, T, alpha, C, w1, w3, w4, clusterEdgeFunctional]
    field_simp [hD0, hB0, hT0, hgamma0, hbeta.ne']
    ring
  have hw1 : 0 < w1 := by
    rw [hweight_identity] at hcluster
    nlinarith
  have hsum : w1 + w3 + w4 = 1 := by
    dsimp [w1]
    ring
  have hrepr : w1 • Q1 + w3 • Q3 d beta + w4 • Q4 d gamma = x := by
    ext <;> dsimp [D, H, A, B, T, alpha, C, w1, w3, w4, Q1, Q3, Q4]
    all_goals field_simp [hD0, hB0, hT0, hgamma0, hbeta.ne']
    all_goals ring
  exact ⟨w1, w3, w4, hw1, hw3, hw4, hsum, hrepr⟩

/-- A strict point on the `Q1`--`Q3`--`Q4` side has a strict Minkowski
point directly above it on the vertical (common-input) line.  This is the
elementary common-input part of the nonendpoint assembly: the first
reciprocal exponent is unchanged, while the output reciprocal exponent is
increased. -/
theorem exists_strictTriangle123_vertical_above_of_strictTriangle134
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 3 ≤ d ∨ d = 2 ∧ gamma ≤ 1 / 2)
    (hbeta : 0 ≤ beta) (hbeta_gamma : beta ≤ gamma) (hgamma_one : gamma ≤ 1)
    (hx : StrictTriangle134Combination d beta gamma x) :
    ∃ z : ExponentPoint,
      StrictTriangle123Combination d beta z ∧
        z.1 = x.1 ∧ x.2 < z.2 ∧ 0 < z.1 ∧ 0 < z.2 := by
  rcases hx with ⟨a, b, c, ha, hb, hc, habc, hrepr⟩
  have hd2 : 2 ≤ d := by
    rcases hd with hd | hd <;> omega
  have hD : (2 : Real) ≤ (d : Real) := by exact_mod_cast hd2
  have hbeta_one : beta ≤ 1 := hbeta_gamma.trans hgamma_one
  have hgamma : 0 ≤ gamma := hbeta.trans hbeta_gamma
  have hDminus : 0 < (d : Real) - 1 := by linarith
  have hB3 : 0 < (d : Real) - beta + 1 := by linarith
  have hT : 0 < (d : Real) ^ 2 + 2 * gamma - 1 := by
    nlinarith [sq_nonneg ((d : Real) - 2)]
  have hK : 0 < (d : Real) - 1 - beta :=
    theoremOne_diagonal_gap_pos hd hbeta_gamma hgamma_one
  let A : Real := (d : Real) - beta
  have hAone : 1 < A := by
    dsimp only [A]
    linarith
  have hA : 0 < A := by linarith
  have hxfst :
      x.1 = a * Q1.1 + b * (Q3 d beta).1 + c * (Q4 d gamma).1 := by
    have hfst := congrArg Prod.fst hrepr
    simpa only [Prod.smul_fst, Prod.fst_add, smul_eq_mul] using hfst.symm
  have hxsnd :
      x.2 = a * Q1.2 + b * (Q3 d beta).2 + c * (Q4 d gamma).2 := by
    have hsnd := congrArg Prod.snd hrepr
    simpa only [Prod.smul_snd, Prod.snd_add, smul_eq_mul] using hsnd.symm
  have hq3fst : 0 < (Q3 d beta).1 := by
    dsimp [Q3]
    exact div_pos (by linarith) hB3
  have hq4fst : 0 < (Q4 d gamma).1 := by
    dsimp [Q4]
    exact div_pos (mul_pos (by linarith) hDminus) hT
  have hxpos : 0 < x.1 := by
    rw [hxfst]
    simpa [Q1] using add_pos (mul_pos hb hq3fst) (mul_pos hc hq4fst)
  let G : ExponentPoint → Real := fun u =>
    (1 - beta) * u.2 + ((d : Real) - 1) - (d : Real) * u.1
  have hq1gap : 0 < G Q1 := by
    dsimp [G, Q1]
    linarith
  have hq3gap : 0 ≤ G (Q3 d beta) := by
    dsimp only [G]
    linarith [Q3_annulus_identity hd2 hbeta_one]
  have hq4gap : 0 ≤ G (Q4 d gamma) := by
    dsimp only [G]
    linarith [Q4_annulus_le hd2 hbeta hbeta_gamma]
  have hxgap_identity :
      G x = a * G Q1 + b * G (Q3 d beta) + c * G (Q4 d gamma) := by
    dsimp only [G]
    rw [hxfst, hxsnd]
    linear_combination -((d : Real) - 1) * habc
  have hxgap : 0 < G x := by
    rw [hxgap_identity]
    exact add_pos_of_pos_of_nonneg
      (add_pos_of_pos_of_nonneg (mul_pos ha hq1gap) (mul_nonneg hb.le hq3gap))
      (mul_nonneg hc.le hq4gap)
  have hannulus_x :
      (d : Real) * x.1 < (1 - beta) * x.2 + ((d : Real) - 1) := by
    dsimp only [G] at hxgap
    linarith
  have hdiagonal_identity :
      x.1 - A * x.2 =
        c * (beta * ((d : Real) - 1) /
          ((d : Real) ^ 2 + 2 * gamma - 1)) := by
    dsimp only [A]
    rw [hxfst, hxsnd]
    dsimp [Q1, Q3, Q4]
    field_simp [hB3.ne', hT.ne']
    ring
  have hside : A * x.2 ≤ x.1 := by
    have hcoef : 0 ≤ beta * ((d : Real) - 1) /
        ((d : Real) ^ 2 + 2 * gamma - 1) :=
      div_nonneg (mul_nonneg hbeta hDminus.le) hT.le
    have hdiff : 0 ≤ x.1 - A * x.2 := by
      rw [hdiagonal_identity]
      exact mul_nonneg hc.le hcoef
    linarith
  let y : Real := (x.1 / A + x.1) / 2
  let z : ExponentPoint := (x.1, y)
  have hx2_le : x.2 ≤ x.1 / A := by
    apply (le_div_iff₀ hA).mpr
    nlinarith [hside]
  have hdiv_lt : x.1 / A < x.1 := by
    apply (div_lt_iff₀ hA).mpr
    nlinarith [mul_pos hxpos (sub_pos.mpr hAone)]
  have hylower : x.1 / A < y := by
    dsimp only [y]
    nlinarith
  have hylt : y < x.1 := by
    dsimp only [y]
    nlinarith
  have hxy : x.2 < y := lt_of_le_of_lt hx2_le hylower
  have hypos : 0 < y := by
    have hdivpos : 0 < x.1 / A := div_pos hxpos hA
    dsimp only [y]
    nlinarith
  have htranslation : z.2 < z.1 := by
    dsimp only [z]
    exact hylt
  have hcoefficient : 0 ≤ 1 - beta := by linarith
  have hraise : (1 - beta) * x.2 ≤ (1 - beta) * y :=
    mul_le_mul_of_nonneg_left hxy.le hcoefficient
  have hannulus_z :
      (d : Real) * z.1 < (1 - beta) * z.2 + ((d : Real) - 1) := by
    dsimp only [z]
    linarith
  have hmul : A * (x.1 / A) < A * y :=
    mul_lt_mul_of_pos_left hylower hA
  have hcancel : A * (x.1 / A) = x.1 := by
    field_simp [hA.ne'] <;> ring
  have hdiagonal_z : z.1 < ((d : Real) - beta) * z.2 := by
    change x.1 < A * y
    rw [← hcancel]
    exact hmul
  have hz : StrictTriangle123Combination d beta z :=
    strictTriangle123Combination_of_strict_halfspaces
      hd2 hbeta hbeta_one hK htranslation hannulus_z hdiagonal_z
  refine ⟨z, hz, rfl, ?_, ?_, ?_⟩
  · simpa only [z] using hxy
  · simpa only [z] using hxpos
  · simpa only [z] using hypos

/-- Strict interior points lie in one of the two open analytic triangles,
unless they lie on their common `Q1`--`Q3` diagonal.  The assumptions exclude
only the collapsed `Q2 = Q3` configuration; that configuration is absent in
the dimensional range of Theorem 1. -/
theorem strict_triangle_side_decomposition_of_mem_interior_Q
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 2 ≤ d) (hbeta : 0 ≤ beta) (hbeta_one : beta ≤ 1)
    (hbeta_gamma : beta ≤ gamma)
    (hK : 0 < (d : Real) - 1 - beta)
    (hx : x ∈ interior (Q d beta gamma)) :
    StrictTriangle123Combination d beta x ∨
      StrictTriangle134Combination d beta gamma x ∨
        x.1 = ((d : Real) - beta) * x.2 := by
  have hgamma : 0 ≤ gamma := hbeta.trans hbeta_gamma
  have htranslation := strict_second_lt_first_of_mem_interior_Q hd hbeta_one hgamma hx
  have hcap := strict_first_lt_natCast_mul_second_of_mem_interior_Q
    hd hbeta hbeta_one hgamma hx
  have hannulus := strict_annulus_of_mem_interior_Q hd hbeta hbeta_gamma hbeta_one hx
  have hcluster := strict_clusterEdgeFunctional_of_mem_interior_Q
    hd hbeta hbeta_one hbeta_gamma hx
  rcases lt_trichotomy x.1 (((d : Real) - beta) * x.2) with hleft | heq | hright
  · left
    exact strictTriangle123Combination_of_strict_halfspaces
      hd hbeta hbeta_one hK htranslation hannulus hleft
  · exact Or.inr (Or.inr heq)
  · by_cases hbeta_zero : beta = 0
    · subst beta
      have : ¬ (x.1 < (d : Real) * x.2) := by
        linarith
      exact False.elim (this hcap)
    · have hbeta_pos : 0 < beta := lt_of_le_of_ne hbeta (Ne.symm hbeta_zero)
      right
      left
      exact strictTriangle134Combination_of_strict_halfspaces
        hd hbeta_pos hbeta_one hbeta_gamma hcap hright hcluster

/-- A point of the interior on the common `Q1`--`Q3` diagonal is the midpoint
of one point in each of the two strict analytic triangles.  This is the
geometric input needed to interpolate the two strict dyadic estimates across
the artificial diagonal used to split the polygon. -/
theorem exists_opposite_strict_triangle_points_of_mem_interior_Q
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 2 ≤ d) (hbeta : 0 < beta) (hbeta_one : beta ≤ 1)
    (hbeta_gamma : beta ≤ gamma)
    (hK : 0 < (d : Real) - 1 - beta)
    (hx : x ∈ interior (Q d beta gamma))
    (hdiagonal : x.1 = ((d : Real) - beta) * x.2) :
    ∃ xleft xright : ExponentPoint,
      x = (1 / 2 : Real) • xleft + (1 / 2 : Real) • xright ∧
        StrictTriangle123Combination d beta xleft ∧
          StrictTriangle134Combination d beta gamma xright := by
  have hgamma : 0 ≤ gamma := hbeta.le.trans hbeta_gamma
  have hnhds : interior (Q d beta gamma) ∈ 𝓝 x :=
    isOpen_interior.mem_nhds hx
  obtain ⟨eps, heps, hball⟩ := Metric.mem_nhds_iff.mp hnhds
  let t : Real := eps / 2
  let xleft : ExponentPoint := (x.1 - t, x.2)
  let xright : ExponentPoint := (x.1 + t, x.2)
  have ht : 0 < t := by
    dsimp [t]
    linarith
  have hdist_left : dist xleft x < eps := by
    calc
      dist xleft x = ‖xleft - x‖ := dist_eq_norm_sub _ _
      _ = t := by
        dsimp [xleft]
        rw [Prod.norm_def]
        change max ‖x.1 - t - x.1‖ ‖x.2 - x.2‖ = t
        rw [show x.1 - t - x.1 = -t by ring, sub_self, norm_neg]
        rw [Real.norm_of_nonneg ht.le, norm_zero, max_eq_left ht.le]
      _ < eps := by
        dsimp [t]
        linarith
  have hdist_right : dist xright x < eps := by
    calc
      dist xright x = ‖xright - x‖ := dist_eq_norm_sub _ _
      _ = t := by
        dsimp [xright]
        rw [Prod.norm_def]
        change max ‖x.1 + t - x.1‖ ‖x.2 - x.2‖ = t
        rw [show x.1 + t - x.1 = t by ring, sub_self]
        rw [Real.norm_of_nonneg ht.le, norm_zero, max_eq_left ht.le]
      _ < eps := by
        dsimp [t]
        linarith
  have hxleft : xleft ∈ interior (Q d beta gamma) :=
    hball (by simpa only [Metric.mem_ball] using hdist_left)
  have hxright : xright ∈ interior (Q d beta gamma) :=
    hball (by simpa only [Metric.mem_ball] using hdist_right)
  have hleft_diagonal : xleft.1 < ((d : Real) - beta) * xleft.2 := by
    dsimp [xleft]
    rw [hdiagonal]
    linarith
  have hright_diagonal : ((d : Real) - beta) * xright.2 < xright.1 := by
    dsimp [xright]
    rw [hdiagonal]
    linarith
  have hleft_translation :=
    strict_second_lt_first_of_mem_interior_Q hd hbeta_one hgamma hxleft
  have hleft_annulus :=
    strict_annulus_of_mem_interior_Q hd hbeta.le hbeta_gamma hbeta_one hxleft
  have hright_cap :=
    strict_first_lt_natCast_mul_second_of_mem_interior_Q
      hd hbeta.le hbeta_one hgamma hxright
  have hright_cluster :=
    strict_clusterEdgeFunctional_of_mem_interior_Q
      hd hbeta.le hbeta_one hbeta_gamma hxright
  refine ⟨xleft, xright, ?_, ?_, ?_⟩
  · ext <;> dsimp [xleft, xright]
    all_goals ring
  · exact strictTriangle123Combination_of_strict_halfspaces
      hd hbeta.le hbeta_one hK hleft_translation hleft_annulus hleft_diagonal
  · exact strictTriangle134Combination_of_strict_halfspaces
      hd hbeta hbeta_one hbeta_gamma hright_cap hright_diagonal hright_cluster

/-- The strict geometric cover used by the nonendpoint proof of Theorem 1.
Every interior exponent is either in one strict analytic triangle, or is the
midpoint of strict exponents in the two adjacent triangles.  The last case is
the only use of the artificial diagonal split in the proof. -/
theorem theoremOne_strict_analytic_triangle_cover
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 3 ≤ d ∨ d = 2 ∧ gamma ≤ 1 / 2)
    (hbeta : 0 ≤ beta) (hbeta_gamma : beta ≤ gamma) (hgamma_one : gamma ≤ 1)
    (hx : x ∈ interior (Q d beta gamma)) :
    StrictTriangle123Combination d beta x ∨
      StrictTriangle134Combination d beta gamma x ∨
        ∃ xleft xright : ExponentPoint,
          x = (1 / 2 : Real) • xleft + (1 / 2 : Real) • xright ∧
            StrictTriangle123Combination d beta xleft ∧
              StrictTriangle134Combination d beta gamma xright := by
  have hd2 : 2 ≤ d := by
    rcases hd with hd | ⟨hd, _⟩
    · omega
    · omega
  have hbeta_one : beta ≤ 1 := hbeta_gamma.trans hgamma_one
  have hK : 0 < (d : Real) - 1 - beta :=
    theoremOne_diagonal_gap_pos hd hbeta_gamma hgamma_one
  rcases strict_triangle_side_decomposition_of_mem_interior_Q
      hd2 hbeta hbeta_one hbeta_gamma hK hx with hleft | hright | hdiag
  · exact Or.inl hleft
  · exact Or.inr (Or.inl hright)
  · by_cases hbeta_zero : beta = 0
    · subst beta
      have hgamma : 0 ≤ gamma := hbeta.trans hbeta_gamma
      have hcap := strict_first_lt_natCast_mul_second_of_mem_interior_Q
        hd2 (by norm_num) (by norm_num) hgamma hx
      exfalso
      linarith
    · have hbeta_pos : 0 < beta := lt_of_le_of_ne hbeta (Ne.symm hbeta_zero)
      exact Or.inr (Or.inr
        (exists_opposite_strict_triangle_points_of_mem_interior_Q
          hd2 hbeta_pos hbeta_one hbeta_gamma hK hx hdiag))

end

end Auto.Spherical.FractalDilations.StrictInteriorGeometry