/-- The half-gap specialization of the quantitative Q2 estimate.  It is a
convenient default for diagonal-only applications; the T123 physical branch
uses the preceding loss-parametrized version instead. -/
theorem q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent_with_ratio
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {alpha p : Real} (halpha : 0 ≤ alpha)
    (hM : HasUpperMinkowskiExponent E alpha)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : alpha < n * (p - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi)) :
    ∃ C rho : ENNReal, 0 < C ∧ C < ∞ ∧ 0 < rho ∧ rho < 1 ∧
      rho = ENNReal.ofReal (q2PhysicalMinkowskiRatio n alpha p) ∧
      ∀ j : Nat, ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ≤
          C * rho ^ j *
            eLpNorm (f : Euclidean (n + 1) → Complex)
              (ENNReal.ofReal p) volume := by
  let eta : Real := (n * (p - 1) - alpha) / 2
  have heta : 0 < eta := by
    dsimp only [eta]
    linarith
