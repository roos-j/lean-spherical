          (s ^ (d - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ := by ring
    _ ≤ (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ d‖ *
