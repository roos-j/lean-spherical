      _ ≤ A * P := hAbsorb (Lsmall * Cmo) P₁ hCmo_le hP₁_le hP₁
  have hImi :
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cmi / R) := by positivity
    calc
      _ ≤ δ * (Cmi / R) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) := by
        convert hmi r s t hr0 hr hs using 1 <;>
          dsimp [δ, R, brrsSurfaceWavePhase] <;> ring
      _ ≤ δ * (Cmi / R) * (Lsmall * P₂) :=
        mul_le_mul_of_nonneg_left hphase_mi hcoef
      _ = δ * ((Lsmall * Cmi) / R) * P₂ := by ring
      _ ≤ A * P := hAbsorb (Lsmall * Cmi) P₂ hCmi_le hP₂_le hP₂
  have hIom :
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Com / R) := by positivity
    calc
      _ ≤ δ * (Com / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) := by
        convert hom r s t hr0 hr hs using 1 <;>
          dsimp [δ, R, brrsSurfaceWavePhase] <;> ring
      _ = (δ * (Com / R)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))) := by
        rw [hfactor Com]
        ring
      _ ≤ (δ * (Com / R)) * (Lhigh * P₁) :=
        mul_le_mul_of_nonneg_left hphase_om hcoef
      _ = δ * ((Lhigh * Com) / R) * P₁ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Com) P₁ hCom_le hP₁_le hP₁
  have hIim :
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cim / R) := by positivity
    calc
      _ ≤ δ * (Cim / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) := by
        convert him r s t hr0 hr hs using 1 <;>
          dsimp [δ, R, brrsSurfaceWavePhase] <;> ring
      _ = (δ * (Cim / R)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) := by
        rw [hfactor Cim]
        ring
      _ ≤ (δ * (Cim / R)) * (Lhigh * P₃) :=
        mul_le_mul_of_nonneg_left hphase_im hcoef
      _ = δ * ((Lhigh * Cim) / R) * P₃ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Cim) P₃ hCim_le hP₃_le hP₃
  have hImm :
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t‖ ≤
        A * P := by
    have hcoef : 0 ≤ δ * (Cmm / R) := by positivity
    calc
      _ ≤ δ * (Cmm / R ^ (M - 1)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t) := by
        convert hmm r s t hr0 hr hs using 1 <;>
          dsimp [δ, R, brrsSurfaceWavePhase] <;> ring
      _ = (δ * (Cmm / R)) *
          ((1 / R ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) := by
        rw [hfactor Cmm]
        ring
      _ ≤ (δ * (Cmm / R)) * (Lhigh * P₃) :=
        mul_le_mul_of_nonneg_left hphase_mm hcoef
      _ = δ * ((Lhigh * Cmm) / R) * P₃ := by ring
      _ ≤ A * P := hAbsorb (Lhigh * Cmm) P₃ hCmm_le hP₃_le hP₃
  have hall :=
    norm_brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_le_of_component_common_bound
      Phi r s t A P (by
        intro partR partS
        cases partR <;> cases partS
        · exact hIoo
        · exact hIoi
        · exact hIom
        · exact hIio
        · exact hIii
        · exact hIim
        · exact hImo
        · exact hImi
        · exact hImm)
  calc
    ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
        (9 : Real) * A * P := hall
    _ = δ * (((9 : Real) * C) / R) * P := by
      dsimp [A]
      ring
    _ = (1 - (1 / 32 : Real)) * (((9 : Real) * C) / Real.sqrt (s / 16)) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, R, P, P₁, P₂, P₃, P₄]

/-- Exact norm transport for one dyadic planar stationary component. -/
theorem norm_brrsDyadicPlanarTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    ‖brrsDyadicPlanarTwoRadiusStationaryComponentIntegral Phi j partR partS r s t‖ =
      ‖((2 : Real) ^ j) ^ 2‖ *
        ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi partR partS
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
            (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicPlanarTwoRadiusStationaryComponentIntegral
  exact norm_smul _ _

/-- Dyadic transport of the literal planar source-middle rapid profile. -/
theorem exists_norm_brrsDyadicPlanarTwoRadiusStationaryComponentIntegral_lowHigh_middleSource_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partR : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      0 ≤ ((2 : Real) ^ j) * r → ((2 : Real) ^ j) * r ≤ 16 →
      16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicPlanarTwoRadiusStationaryComponentIntegral
          Phi j partR .middle r s t‖ ≤
        ((2 : Real) ^ j) ^ 2 *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (M - 1)) *
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
                brrsSurfaceWavePhase .middle (((2 : Real) ^ j) * s) +
                  2 * Real.pi * (((2 : Real) ^ j) * t))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_lowHigh_middleSource_rapidProfile_le
      N M hM Phi partR
  refine ⟨C, hC, ?_⟩
  intro j r s t hr0 hr hs
  have hq : 0 < (2 : Real) ^ j := by positivity
  rw [norm_brrsDyadicPlanarTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled,
    Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq.le _)]
  exact mul_le_mul_of_nonneg_left
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
