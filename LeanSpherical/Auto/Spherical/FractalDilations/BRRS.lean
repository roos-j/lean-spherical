      _ = _ := by
        rw [eLpNorm_two_rpow_two_brrsPositiveRadialHalfWaveTestPacket_eq_scaledAnnularEnergy]
  calc
    (eLpNorm f 4 volume) ^ (2 : Real) ≤
        eLpNorm f 2 volume * eLpNorm f ⊤ volume :=
      Auto.LpSpaceFacts.eLpNorm_four_rpow_two_le_two_mul_top f hfmeas
    _ ≤ eLpNorm f 2 volume * ENNReal.ofReal
          (6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
            (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1))) :=
      by
        simpa only [mul_comm] using
          (mul_le_mul_left (htop j referenceTime hj href) (eLpNorm f 2 volume))
    _ = _ := by rw [htwo]

/-- The complete pointwise-envelope interpolation family for the positive
BRRS packet.  For every real `p ≥ 2`, its `p`-th `Lp` moment is controlled by
the exact annular `L²` energy times the `p - 2` power of the half-density
envelope.  This is the literal power form of the input normalization in
BRRS (3.2), and includes the preceding `p = 4` estimate. -/
theorem exists_eLpNorm_rpow_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime p : Real,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 → 2 ≤ p →
      (eLpNorm (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime :
        BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p ≤
        (ENNReal.ofReal
          (6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
            (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1))) ^ (p - 2)) *
          ENNReal.ofReal
            (((2 : Real) ^ j) ^ d *
              ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2) := by
  obtain ⟨C, hC, hpoint⟩ :=
    exists_norm_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime p hj href hp
  let f : BRRSSpace d → Complex :=
    brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime
  let B : Real :=
    6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
      (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1))
  let A : ENNReal := ENNReal.ofReal B
  let F : BRRSSpace d → ENNReal := fun x => ENNReal.ofReal ‖f x‖
  change (eLpNorm f (ENNReal.ofReal p) volume) ^ p ≤
    A ^ (p - 2) * ENNReal.ofReal
      (((2 : Real) ^ j) ^ d *
        ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)
  have hp0 : 0 < p := lt_of_lt_of_le (by norm_num) hp
  have hpminus : 0 ≤ p - 2 := by linarith
  have hfcont : Continuous f := by
    dsimp only [f]
    exact (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime).continuous
  have hFmeas : Measurable F := by
    dsimp only [F]
    exact Measurable.ennreal_ofReal hfcont.measurable.norm
  have hF2meas : Measurable (fun x : BRRSSpace d => F x ^ (2 : Real)) := by
    exact ENNReal.continuous_rpow_const.measurable.comp hFmeas
  have hFpoint (x : BRRSSpace d) : F x ≤ A := by
    dsimp only [F, A, B, f]
    exact ENNReal.ofReal_le_ofReal (hpoint j referenceTime x hj href)
  have hpointpow (x : BRRSSpace d) :
      F x ^ p ≤ A ^ (p - 2) * F x ^ (2 : Real) := by
    calc
      F x ^ p = F x ^ ((p - 2) + 2) := by congr 1 <;> ring
      _ = F x ^ (p - 2) * F x ^ (2 : Real) :=
        ENNReal.rpow_add_of_nonneg _ _ hpminus (by norm_num)
      _ ≤ A ^ (p - 2) * F x ^ (2 : Real) :=
        mul_le_mul_left (ENNReal.rpow_le_rpow (hFpoint x) hpminus) _
  have hmoment :
      (∫⁻ x : BRRSSpace d, F x ^ p) ≤
        A ^ (p - 2) * ∫⁻ x : BRRSSpace d, F x ^ (2 : Real) := by
    calc
      (∫⁻ x : BRRSSpace d, F x ^ p) ≤
          ∫⁻ x : BRRSSpace d, A ^ (p - 2) * F x ^ (2 : Real) :=
        lintegral_mono fun x => hpointpow x
      _ = A ^ (p - 2) * ∫⁻ x : BRRSSpace d, F x ^ (2 : Real) :=
        lintegral_const_mul _ hF2meas
  have hmomentp :
      (∫⁻ x : BRRSSpace d, F x ^ p) =
        (eLpNorm f (ENNReal.ofReal p) volume) ^ p := by
    dsimp only [F]
    exact Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp0 f
  have hmomenttwo :
      (∫⁻ x : BRRSSpace d, F x ^ (2 : Real)) =
        (eLpNorm f 2 volume) ^ (2 : Real) := by
    dsimp only [F]
    simpa only [ENNReal.ofReal_ofNat] using
      (Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow
        (by norm_num : (0 : Real) < 2) f)
  have henergy : (eLpNorm f 2 volume) ^ (2 : Real) =
      ENNReal.ofReal
        (((2 : Real) ^ j) ^ d *
          ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2) := by
    dsimp only [f]
    exact
      eLpNorm_two_rpow_two_brrsPositiveRadialHalfWaveTestPacket_eq_scaledAnnularEnergy
        Phi j referenceTime
  calc
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
        ∫⁻ x : BRRSSpace d, F x ^ p := hmomentp.symm
    _ ≤ A ^ (p - 2) * ∫⁻ x : BRRSSpace d, F x ^ (2 : Real) := hmoment
    _ = A ^ (p - 2) * ENNReal.ofReal
        (((2 : Real) ^ j) ^ d *
          ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2) := by
      rw [hmomenttwo, henergy]

/-- Root form of the all-`p` packet normalization.  This is the ordinary
`L^p` seminorm statement obtained from
`exists_eLpNorm_rpow_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le`;
the displayed right side retains the exact annular energy rather than hiding
it in an unspecified constant. -/
theorem exists_eLpNorm_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime p : Real,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 → 2 ≤ p →
      eLpNorm (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime :
        BRRSSpace d → Complex) (ENNReal.ofReal p) volume ≤
        ((ENNReal.ofReal
          (6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
            (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1))) ^ (p - 2)) *
          ENNReal.ofReal
            (((2 : Real) ^ j) ^ d *
              ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)) ^ p⁻¹ := by
  obtain ⟨C, hC, hmoment⟩ :=
    exists_eLpNorm_rpow_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
      hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime p hj href hp
  let f : BRRSSpace d → Complex :=
    brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime
  let B : Real :=
    6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
      (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1))
  let A : ENNReal := ENNReal.ofReal B
  let E : ENNReal := ENNReal.ofReal
    (((2 : Real) ^ j) ^ d *
      ∫ xi : BRRSSpace d, ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)
  change eLpNorm f (ENNReal.ofReal p) volume ≤ (A ^ (p - 2) * E) ^ p⁻¹
  have hp0 : 0 < p := lt_of_lt_of_le (by norm_num) hp
  have hpow : (eLpNorm f (ENNReal.ofReal p) volume) ^ p ≤
      A ^ (p - 2) * E := by
    dsimp only [f, A, B, E]
    exact hmoment j referenceTime p hj href hp
  have hroot : eLpNorm f (ENNReal.ofReal p) volume =
      ((eLpNorm f (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := by
    symm
    calc
      ((eLpNorm f (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ =
          (eLpNorm f (ENNReal.ofReal p) volume) ^ (p * p⁻¹) :=
        (ENNReal.rpow_mul _ _ _).symm
      _ = eLpNorm f (ENNReal.ofReal p) volume := by
        rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  calc
    eLpNorm f (ENNReal.ofReal p) volume =
        ((eLpNorm f (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hroot
    _ ≤ (A ^ (p - 2) * E) ^ p⁻¹ :=
      ENNReal.rpow_le_rpow hpow (inv_nonneg.mpr hp0.le)

/-- The elementary exponent bookkeeping for the positive BRRS packet:
combining its half-density `L∞` scale with its annular `L²` scale produces
the Section 3 input exponent `p * ((d + 1) / 2 - 1 / p)`. -/
theorem brrsPositiveRadialHalfWaveTestPacket_halfDensity_input_rpow_exponent
    {q p : Real} {d : Nat} (hq : 0 < q) (hp : 0 < p) :
    (q ^ (((d : Real) + 1) / 2)) ^ (p - 2) * q ^ (d : Real) =
      q ^ (p * (((d : Real) + 1) / 2 - 1 / p)) := by
  rw [← Real.rpow_mul hq.le, ← Real.rpow_add hq]
  congr 1
  field_simp [hp.ne']
  ring

/-- The literal half-density envelope of the positive BRRS packet has the
expected wave-scale power.  This keeps the numerical factor from the fixed
annulus explicit, so it can subsequently be absorbed into a scale-independent
input constant. -/
theorem brrsPositiveRadialHalfWaveTestPacket_halfDensity_envelope_eq
    {q : Real} {d : Nat} (hq : 0 < q) (hd : 1 ≤ d) :
    ‖q ^ d‖ / (Real.sqrt (q / 32) ^ (d - 1)) =
      (32 : Real) ^ (((d : Real) - 1) / 2) * q ^ (((d : Real) + 1) / 2) := by
  let n : Real := (d : Real) - 1
  have hnum : ‖q ^ d‖ = q ^ (n + 1) := by
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq.le _),
      ← Real.rpow_natCast]
    dsimp [n]
    congr 1
    ring
  have hden : Real.sqrt (q / 32) ^ (d - 1) = (q / 32) ^ (n / 2) := by
    rw [brrs_sqrtPow_eq_timeHalfExponent hd (q / 32) (by positivity)]
  rw [hnum, hden, Real.div_rpow hq.le (by norm_num)]
  have hsplit :
      q ^ (n + 1) / (q ^ (n / 2) / (32 : Real) ^ (n / 2)) =
        (32 : Real) ^ (n / 2) * (q ^ (n + 1) / q ^ (n / 2)) := by
    have hqhalf : 0 < q ^ (n / 2) := Real.rpow_pos_of_pos hq _
    have h32half : 0 < (32 : Real) ^ (n / 2) :=
      Real.rpow_pos_of_pos (by norm_num) _
    field_simp [ne_of_gt hqhalf, ne_of_gt h32half]
  rw [hsplit]
  have hqpow : q ^ (n + 1) / q ^ (n / 2) = q ^ (n / 2 + 1) := by
    field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _)]
    rw [← Real.rpow_add hq]
    congr 1
    ring
  rw [hqpow]
  all_goals
    congr 1
    dsimp only [n]
    ring

/-- After extracting the fixed annular constant in the half-density packet
envelope, its `p`-moment has exactly the BRRS input scale.  This is a purely
algebraic identity: the factor involving `k` is scale-independent, while the
remaining dyadic power is the Section 3 exponent. -/
theorem brrsPositiveRadialHalfWaveTestPacket_halfDensity_normalized_input_rpow_eq
    {q k p : Real} {d : Nat} (hq : 0 < q) (hk : 0 < k)
    (hp : p ≠ 0) :
    (k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
      q ^ (((d : Real) + 1) / 2))) ^ (p - 2) * q ^ d =
      (k * (32 : Real) ^ (((d : Real) - 1) / 2)) ^ (p - 2) *
        q ^ (p * (((d : Real) + 1) / 2 - 1 / p)) := by
  have hknonneg : 0 ≤ k * (32 : Real) ^ (((d : Real) - 1) / 2) := by
    positivity
  have hqpow : 0 ≤ q ^ (((d : Real) + 1) / 2) :=
    Real.rpow_nonneg hq.le _
  have hfactor :
      (k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
        q ^ (((d : Real) + 1) / 2))) =
        ((k * (32 : Real) ^ (((d : Real) - 1) / 2)) *
          q ^ (((d : Real) + 1) / 2)) := by
    ring
  have hexp : ((d : Real) + 1) / 2 * (p - 2) + (d : Real) =
      p * (((d : Real) + 1) / 2 - 1 / p) := by
    field_simp [hp]
    ring
  rw [hfactor]
  rw [Real.mul_rpow hknonneg hqpow]
  rw [← Real.rpow_mul hq.le]
  rw [mul_assoc, ← Real.rpow_natCast, ← Real.rpow_add hq, hexp]

/-- The preceding normalization written in terms of the literal packet
envelope, rather than with its fixed annular constant already extracted. -/
theorem brrsPositiveRadialHalfWaveTestPacket_halfDensity_input_rpow_eq
    {q k p : Real} {d : Nat} (hq : 0 < q) (hk : 0 < k)
    (hp : p ≠ 0) (hd : 1 ≤ d) :
    (k * (‖q ^ d‖ / (Real.sqrt (q / 32) ^ (d - 1)))) ^ (p - 2) * q ^ d =
      (k * (32 : Real) ^ (((d : Real) - 1) / 2)) ^ (p - 2) *
        q ^ (p * (((d : Real) + 1) / 2 - 1 / p)) := by
  rw [brrsPositiveRadialHalfWaveTestPacket_halfDensity_envelope_eq hq hd]
  exact brrsPositiveRadialHalfWaveTestPacket_halfDensity_normalized_input_rpow_eq
    hq hk hp

/-- `ENNReal` form of the exact half-density input normalization.  This is
the form that can be substituted directly into the right hand side of the
odd-dimensional cone-tube obstruction, whose `L^p` quantities are
`ENNReal`-valued. -/
theorem ENNReal_brrsPositiveRadialHalfWaveTestPacket_halfDensity_input_rpow_eq
    {q k p : Real} {d : Nat} (hq : 0 < q) (hk : 0 < k)
    (hp : p ≠ 0) (hd : 1 ≤ d) :
    (ENNReal.ofReal (k * (‖q ^ d‖ /
      (Real.sqrt (q / 32) ^ (d - 1)))) ^ (p - 2)) *
        ENNReal.ofReal (q ^ d) =
      ENNReal.ofReal
        ((k * (32 : Real) ^ (((d : Real) - 1) / 2)) ^ (p - 2) *
          q ^ (p * (((d : Real) + 1) / 2 - 1 / p))) := by
  rw [brrsPositiveRadialHalfWaveTestPacket_halfDensity_envelope_eq hq hd]
  have hbase : 0 <
      (k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
        q ^ (((d : Real) + 1) / 2))) := by
    positivity
  have hknonneg : 0 ≤ k * (32 : Real) ^ (((d : Real) - 1) / 2) := by
    positivity
  have hqpow : 0 ≤ q ^ (((d : Real) + 1) / 2) :=
    Real.rpow_nonneg hq.le _
  have hfactor :
      (k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
        q ^ (((d : Real) + 1) / 2))) =
        ((k * (32 : Real) ^ (((d : Real) - 1) / 2)) *
          q ^ (((d : Real) + 1) / 2)) := by
    ring
  have hexp : ((d : Real) + 1) / 2 * (p - 2) + (d : Real) =
      p * (((d : Real) + 1) / 2 - 1 / p) := by
    field_simp [hp]
    ring
  rw [ENNReal.ofReal_rpow_of_pos hbase]
  calc
    ENNReal.ofReal
          ((k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
            q ^ (((d : Real) + 1) / 2))) ^ (p - 2)) *
        ENNReal.ofReal (q ^ d) =
        ENNReal.ofReal
          ((k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
            q ^ (((d : Real) + 1) / 2))) ^ (p - 2) * q ^ d) :=
      (ENNReal.ofReal_mul
        (p := (k * ((32 : Real) ^ (((d : Real) - 1) / 2) *
          q ^ (((d : Real) + 1) / 2))) ^ (p - 2))
        (q := q ^ d) (Real.rpow_nonneg hbase.le (p - 2))).symm
    _ = ENNReal.ofReal
        ((k * (32 : Real) ^ (((d : Real) - 1) / 2)) ^ (p - 2) *
          q ^ (p * (((d : Real) + 1) / 2 - 1 / p))) := by
      congr 1
      rw [hfactor]
      rw [Real.mul_rpow hknonneg hqpow]
      rw [← Real.rpow_mul hq.le]
      rw [mul_assoc, ← Real.rpow_natCast, ← Real.rpow_add hq, hexp]

/-- The exponent gap between a cone-tube packet lower bound and the
half-density input normalization.  In the odd-dimensional cone-tube
obstruction the output shell contributes `q^(d * (p - 1))`; after including
the Sobolev factor `q^(p * s)`, this identity identifies the remaining
dyadic gap exactly as `p * (s_p - s)`.  It is only bookkeeping, not a
sharpness conclusion. -/
theorem brrsConeTube_outputInput_dyadic_exponent_gap_eq
    {d : Nat} {p s : Real} (hp : p ≠ 0) :
    (d : Real) * (p - 1) -
      p * (s + (((d : Real) + 1) / 2 - 1 / p)) =
        p * (sobolevExponent d p - s) := by
  unfold sobolevExponent
  field_simp [hp]
  ring

/-- A literal pointwise lower bound for the propagated positive BRRS packet
on one radial time shell gives the corresponding lower `L^p` moment.  This is
the direct analytic interface for a quantified stationary cone-tube lower
bound: it retains both the shell volume and the actual dyadic packet. -/
theorem brrsPositiveRadialTestPacket_eLpNorm_rpow_lower_of_shell_pointwise
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat)
    (referenceTime t width c p : Real) (hp : 0 < p)
    (hlower : ∀ x : BRRSSpace d,
      x ∈ brrsTimeRadialShell d referenceTime t width →
        c ≤ ‖brrsDyadicHalfWave Phi j t
          (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) x‖) :
    (ENNReal.ofReal c) ^ p *
        volume (brrsTimeRadialShell d referenceTime t width) ≤
      (eLpNorm (brrsDyadicHalfWave Phi j t
        (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) :
          BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p := by
  let F : BRRSSpace d → Complex := brrsDyadicHalfWave Phi j t
    (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime)
  have hlocal :
      (ENNReal.ofReal c) ^ p *
          volume (brrsTimeRadialShell d referenceTime t width) ≤
        ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
          (ENNReal.ofReal ‖F x‖) ^ p := by
    dsimp only [F]
    exact brrsTimeRadialShell_lintegral_rpow_lower_of_pointwise
      referenceTime t width c p F hp.le hlower
  calc
    (ENNReal.ofReal c) ^ p *
        volume (brrsTimeRadialShell d referenceTime t width) ≤
      ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
        (ENNReal.ofReal ‖F x‖) ^ p := hlocal
    _ ≤ ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖F x‖) ^ p :=
      setLIntegral_le_lintegral _ _
    _ = (eLpNorm F (ENNReal.ofReal p) volume) ^ p := by
      exact Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp F

/-- The preceding shell-moment bridge specialized through the exact `TT*`
identity for the positive radial packet.  Its hypothesis is deliberately a
literal pointwise estimate for the actual dyadic `TT*` kernel, so a future
cone-tube theorem can be inserted without any model-kernel replacement or
unproved cancellation step. -/
theorem brrsPositiveRadialTestPacket_eLpNorm_rpow_lower_of_ttStarShell_pointwise
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat)
    (referenceTime t width c p : Real) (hp : 0 < p)
    (hlower : ∀ x : BRRSSpace d,
      x ∈ brrsTimeRadialShell d referenceTime t width →
        c ≤ ‖(brrsDyadicHalfWaveTTStarKernel Phi j referenceTime t :
          BRRSSpace d → Complex) x‖) :
    (ENNReal.ofReal c) ^ p *
        volume (brrsTimeRadialShell d referenceTime t width) ≤
      (eLpNorm (brrsDyadicHalfWave Phi j t
        (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) :
          BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p := by
  apply brrsPositiveRadialTestPacket_eLpNorm_rpow_lower_of_shell_pointwise
    Phi j referenceTime t width c p hp
  intro x hx
  have hidentity := congrFun
    (brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel
      (d := d) Phi j referenceTime t) x
  rw [hidentity]
  exact hlower x hx

/-- In odd dimension, the literal outgoing cone tube of the positive `TT*`
kernel supplies a quantitative `L^p` lower bound for the propagated BRRS
packet on its physical radial shell.  Both the shell width and the lower
amplitude are displayed at the actual dyadic scale; no model kernel is used.
-/
theorem exists_brrsPositiveRadialTestPacket_odd_dyadic_coneTube_shell_eLpNorm_rpow_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 0 < p) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (referenceTime t : Real),
        A + (1 / 6 : Real) ≤ (2 : Real) ^ j * (t - referenceTime) →
          (ENNReal.ofReal
            ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
              (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
            volume (brrsTimeRadialShell (2 * n + 3) referenceTime t
              ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹)) ≤
            (eLpNorm
              (brrsDyadicHalfWave Phi j t
                (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) :
                  BRRSSpace (2 * n + 3) → Complex)
              (ENNReal.ofReal p) volume) ^ p := by
  obtain ⟨A, c, hA, hc, hkernel⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_outgoing_dyadic_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j referenceTime t hlarge
  let q : Real := (2 : Real) ^ j
  let width : Real := (1 / 6 : Real) * q⁻¹
  let D : Real := q * (t - referenceTime) + 1 / 6
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hAplus : 0 < A + (1 / 6 : Real) := by linarith
  have hqrelative : 0 < q * (t - referenceTime) :=
    lt_of_lt_of_le hAplus (by simpa only [q] using hlarge)
  have hrelative : 0 < t - referenceTime := by
    rcases (mul_pos_iff.mp hqrelative) with hpos | hneg
    · exact hpos.2
    · exact False.elim (not_lt_of_ge hq.le hneg.1)
  have habs : |t - referenceTime| = t - referenceTime :=
    abs_of_nonneg hrelative.le
  have hqwidth : q * width = 1 / 6 := by
    dsimp only [width]
    calc
      q * ((1 / 6 : Real) * q⁻¹) = (1 / 6 : Real) * (q * q⁻¹) := by ring
      _ = 1 / 6 := by rw [mul_inv_cancel₀ (ne_of_gt hq), mul_one]
  change (ENNReal.ofReal (q ^ (2 * n + 3) * c / D ^ (n + 1))) ^ p *
      volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width) ≤
        (eLpNorm (brrsDyadicHalfWave Phi j t
          (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) :
            BRRSSpace (2 * n + 3) → Complex) (ENNReal.ofReal p) volume) ^ p
  apply brrsPositiveRadialTestPacket_eLpNorm_rpow_lower_of_ttStarShell_pointwise
    Phi j referenceTime t width (q ^ (2 * n + 3) * c / D ^ (n + 1)) p hp
  intro x hx
  change abs (‖x‖ - |t - referenceTime|) < width at hx
  rw [habs] at hx
  have hxleft : t - referenceTime - width < ‖x‖ := by
    have hleft := (abs_lt.mp hx).1
    linarith
  have hxright : ‖x‖ < t - referenceTime + width := by
    have hright := (abs_lt.mp hx).2
    linarith
  have hxlowerq : q * (t - referenceTime) - 1 / 6 < q * ‖x‖ := by
    calc
      q * (t - referenceTime) - 1 / 6 =
          q * (t - referenceTime) - q * width := by rw [hqwidth]
      _ = q * (t - referenceTime - width) := by ring
      _ < q * ‖x‖ := mul_lt_mul_of_pos_left hxleft hq
  have hxupperq : q * ‖x‖ ≤ D := by
    apply le_of_lt
    calc
      q * ‖x‖ < q * (t - referenceTime + width) :=
        mul_lt_mul_of_pos_left hxright hq
      _ = D := by
        dsimp only [D]
        rw [mul_add, hqwidth]
  have hxlarge : A ≤ q * ‖x‖ := by
    calc
      A ≤ q * (t - referenceTime) - 1 / 6 := by
        linarith [hlarge]
      _ ≤ q * ‖x‖ := hxlowerq.le
  have hxtube : |(t - referenceTime) - ‖x‖| ≤ (1 / 6 : Real) * q⁻¹ := by
    change |(t - referenceTime) - ‖x‖| ≤ width
    rw [abs_sub_comm]
    exact hx.le
  have hbase := hkernel j referenceTime t x
    (by simpa only [q] using hxlarge)
    (by simpa only [q] using hxtube)
  have hApos : 0 < A := by linarith
  have hxqpos : 0 < q * ‖x‖ :=
    lt_of_lt_of_le hApos hxlarge
  have hDpos : 0 < D := lt_of_lt_of_le hxqpos hxupperq
  have hpow : (q * ‖x‖) ^ (n + 1) ≤ D ^ (n + 1) :=
    pow_le_pow_left₀ hxqpos.le hxupperq _
  have hnum : 0 ≤ q ^ (2 * n + 3) * c :=
    mul_nonneg (pow_nonneg hq.le _) hc.le
  have hfraction : q ^ (2 * n + 3) * c / D ^ (n + 1) ≤
      q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) :=
    div_le_div_of_nonneg_left hnum (pow_pos hxqpos _) hpow
  calc
    q ^ (2 * n + 3) * c / D ^ (n + 1) ≤
        q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) := hfraction
    _ ≤ ‖(brrsDyadicHalfWaveTTStarKernel Phi j referenceTime t :
          BRRSSpace (2 * n + 3) → Complex) x‖ := by
      simpa only [q] using hbase

/-- A positive radial shell has the expected polar-volume lower bound.  More
precisely, the outer half of the shell contains a radial interval of length
`width` on which the polar density is at least `radius ^ (d - 1)`.

This is the geometric factor needed to turn the cone-tube kernel lower bound
into the weighted local entropy factor in the BRRS sharpness construction. -/
theorem ENNReal_ofReal_surfaceMass_mul_radius_pow_mul_width_le_volume_brrsRadialShell
    {d : Nat} (hd : 0 < d) {radius width : Real}
    (hradius : 0 ≤ radius) (hwidth : 0 < width) :
    ENNReal.ofReal (surfaceMass d) *
        (ENNReal.ofReal (radius ^ (d - 1)) * ENNReal.ofReal width) ≤
      volume (brrsRadialShell d radius width) := by
  let J : Set Real := Ioo radius (radius + width)
  let F : Real → ENNReal := J.indicator (fun _ => (1 : ENNReal))
  let S : Set (BRRSSpace d) := {x | ‖x‖ ∈ J}
  have hJ : MeasurableSet J := by
    dsimp only [J]
    exact measurableSet_Ioo
  have hJpos : J ⊆ Ioi (0 : Real) := by
    intro r hr
    exact lt_of_le_of_lt hradius hr.1
  have hF : Measurable F := by
    dsimp only [F]
    exact (measurable_indicator_const_iff 1).mpr hJ
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact hJ.preimage continuous_norm.measurable
  have hSsubset : S ⊆ brrsRadialShell d radius width := by
    intro x hx
    change ‖x‖ ∈ J at hx
    change |‖x‖ - radius| < width
    rw [abs_of_nonneg (sub_nonneg.mpr hx.1.le)]
    linarith [hx.2]
  have hFnorm : (fun x : BRRSSpace d => F ‖x‖) =
      S.indicator (fun _ => (1 : ENNReal)) := by
    funext x
    dsimp only [F, S]
    by_cases hx : ‖x‖ ∈ J <;> simp [hx]
  have hvolumeS : (∫⁻ x : BRRSSpace d, F ‖x‖) = volume S := by
    rw [hFnorm, lintegral_indicator_const hS]
    simp
  let c : ENNReal := ENNReal.ofReal (radius ^ (d - 1))
  have hpoint (r : Real) : J.indicator (fun _ => c) r ≤
      ENNReal.ofReal r ^ (d - 1) * F r := by
    by_cases hr : r ∈ J
    · rw [Set.indicator_of_mem hr]
      change c ≤ ENNReal.ofReal r ^ (d - 1) *
        J.indicator (fun _ => (1 : ENNReal)) r
      rw [Set.indicator_of_mem hr]
      have hrnonneg : 0 ≤ r := le_trans hradius hr.1.le
      have hpow : radius ^ (d - 1) ≤ r ^ (d - 1) :=
        pow_le_pow_left₀ hradius hr.1.le _
      dsimp only [c]
      rw [mul_one, ← ENNReal.ofReal_pow hrnonneg]
      exact ENNReal.ofReal_le_ofReal hpow
    · rw [Set.indicator_of_notMem hr]
      change 0 ≤ ENNReal.ofReal r ^ (d - 1) *
        J.indicator (fun _ => (1 : ENNReal)) r
      rw [Set.indicator_of_notMem hr]
      exact bot_le
  have hradialLower :
      (∫⁻ r in Ioi (0 : Real), J.indicator (fun _ => c) r) ≤
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r := by
    exact lintegral_mono fun r => hpoint r
  have hleft :
      (∫⁻ r in Ioi (0 : Real), J.indicator (fun _ => c) r) =
        ENNReal.ofReal (radius ^ (d - 1)) * ENNReal.ofReal width := by
    rw [lintegral_indicator hJ]
    change ∫⁻ r : Real, c ∂(volume.restrict (Ioi (0 : Real))).restrict J = _
    rw [Measure.restrict_restrict hJ]
    simp only [Set.inter_eq_left.mpr hJpos]
    rw [setLIntegral_const, Real.volume_Ioo]
    dsimp only [c]
    have hdiff : radius + width - radius = width := by ring
    rw [hdiff]
  have hpolar := lintegral_euclidean_radial hd F hF
  calc
    ENNReal.ofReal (surfaceMass d) *
          (ENNReal.ofReal (radius ^ (d - 1)) * ENNReal.ofReal width) =
        ENNReal.ofReal (surfaceMass d) *
          (∫⁻ r in Ioi (0 : Real), J.indicator (fun _ => c) r) := by
      rw [hleft]
    _ ≤ ENNReal.ofReal (surfaceMass d) *
          (∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r) :=
      by
        simpa only [mul_comm] using
          (mul_le_mul_right hradialLower (ENNReal.ofReal (surfaceMass d)))
    _ = ∫⁻ x : BRRSSpace d, F ‖x‖ := hpolar.symm
    _ = volume S := hvolumeS
    _ ≤ volume (brrsRadialShell d radius width) := measure_mono hSsubset

/-- Time-shell form of the polar lower bound. -/
theorem ENNReal_ofReal_surfaceMass_mul_abs_sub_pow_mul_width_le_volume_brrsTimeRadialShell
    {d : Nat} (hd : 0 < d) (referenceTime t width : Real) (hwidth : 0 < width) :
    ENNReal.ofReal (surfaceMass d) *
        (ENNReal.ofReal (|t - referenceTime| ^ (d - 1)) * ENNReal.ofReal width) ≤
      volume (brrsTimeRadialShell d referenceTime t width) := by
  unfold brrsTimeRadialShell
  exact ENNReal_ofReal_surfaceMass_mul_radius_pow_mul_width_le_volume_brrsRadialShell
    hd (abs_nonneg _) hwidth

/-- The odd-dimensional cone-tube packet lower bound and the all-`p`
half-density input normalization hold simultaneously.  This is the honest
packet comparison needed for a sharpness argument: the first conjunct is a
literal output lower on the physical cone shell, while the second is the
exact annular-energy source upper. -/
theorem exists_brrsPositiveRadialTestPacket_odd_dyadic_coneTube_shell_lower_and_halfDensityInput_upper
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 2 ≤ p) :
    ∃ A c C : Real, 16 ≤ A ∧ 0 < c ∧ 0 < C ∧
      ∀ (j : Nat) (referenceTime t : Real),
        5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
          A + (1 / 6 : Real) ≤ (2 : Real) ^ j * (t - referenceTime) →
          ((ENNReal.ofReal
            ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
              (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
              volume (brrsTimeRadialShell (2 * n + 3) referenceTime t
                ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹)) ≤
            (eLpNorm
              (brrsDyadicHalfWave Phi j t
                (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) :
                  BRRSSpace (2 * n + 3) → Complex)
              (ENNReal.ofReal p) volume) ^ p) ∧
          (eLpNorm
            (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime :
              BRRSSpace (2 * n + 3) → Complex)
            (ENNReal.ofReal p) volume) ^ p ≤
            (ENNReal.ofReal
              (6 * ((1 - (1 / 32 : Real)) * C) *
                ‖((2 : Real) ^ j) ^ (2 * n + 3)‖ /
                (Real.sqrt (((2 : Real) ^ j / 32)) ^ ((2 * n + 3) - 1))) ^
              (p - 2)) *
            ENNReal.ofReal
              (((2 : Real) ^ j) ^ (2 * n + 3) *
                ∫ xi : BRRSSpace (2 * n + 3),
                  ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2) := by
  have hp0 : 0 < p := lt_of_lt_of_le (by norm_num) hp
  obtain ⟨A, c, hA, hc, hlower⟩ :=
    exists_brrsPositiveRadialTestPacket_odd_dyadic_coneTube_shell_eLpNorm_rpow_lower
      Phi n hp0
  obtain ⟨C, hC, hinput⟩ :=
    exists_eLpNorm_rpow_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
      (d := 2 * n + 3) (by omega) Phi
  refine ⟨A, c, C, hA, hc, hC, ?_⟩
  intro j referenceTime t hj href hlarge
  refine ⟨?_, ?_⟩
  · exact hlower j referenceTime t hlarge
  · exact hinput j referenceTime p hj href hp

/-- The dyadic full `TT*` cone-tube estimate is uniform over the complete
physical radial shell centered at the positive relative time.  This is the
pointwise shell form used when a finite packet of such times is inserted into
a `UniformEstimateAtExponent`. -/
theorem exists_brrsDyadicHalfWaveTTStarKernel_odd_dyadic_coneTube_timeShell_pointwise_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (referenceTime t : Real) (x : BRRSSpace (2 * n + 3)),
        A + (1 / 6 : Real) ≤ (2 : Real) ^ j * (t - referenceTime) →
          x ∈ brrsTimeRadialShell (2 * n + 3) referenceTime t
            ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹) →
            ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1)) ≤
              ‖(brrsDyadicHalfWaveTTStarKernel Phi j referenceTime t :
                BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hkernel⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_outgoing_dyadic_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j referenceTime t x hlarge hx
  let q : Real := (2 : Real) ^ j
  let width : Real := (1 / 6 : Real) * q⁻¹
  let D : Real := q * (t - referenceTime) + 1 / 6
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hAplus : 0 < A + (1 / 6 : Real) := by linarith
  have hqrelative : 0 < q * (t - referenceTime) :=
    lt_of_lt_of_le hAplus (by simpa only [q] using hlarge)
  have hrelative : 0 < t - referenceTime := by
    rcases (mul_pos_iff.mp hqrelative) with hpos | hneg
    · exact hpos.2
    · exact False.elim (not_lt_of_ge hq.le hneg.1)
  have habs : |t - referenceTime| = t - referenceTime :=
    abs_of_nonneg hrelative.le
  have hqwidth : q * width = 1 / 6 := by
    dsimp only [width]
    calc
      q * ((1 / 6 : Real) * q⁻¹) = (1 / 6 : Real) * (q * q⁻¹) := by ring
      _ = 1 / 6 := by rw [mul_inv_cancel₀ (ne_of_gt hq), mul_one]
  change abs (‖x‖ - |t - referenceTime|) < width at hx
  rw [habs] at hx
  have hxleft : t - referenceTime - width < ‖x‖ := by
    have hleft := (abs_lt.mp hx).1
    linarith
  have hxright : ‖x‖ < t - referenceTime + width := by
    have hright := (abs_lt.mp hx).2
    linarith
  have hxlowerq : q * (t - referenceTime) - 1 / 6 < q * ‖x‖ := by
    calc
      q * (t - referenceTime) - 1 / 6 =
          q * (t - referenceTime) - q * width := by rw [hqwidth]
      _ = q * (t - referenceTime - width) := by ring
      _ < q * ‖x‖ := mul_lt_mul_of_pos_left hxleft hq
  have hxupperq : q * ‖x‖ ≤ D := by
    apply le_of_lt
    calc
      q * ‖x‖ < q * (t - referenceTime + width) :=
        mul_lt_mul_of_pos_left hxright hq
      _ = D := by
        dsimp only [D]
        rw [mul_add, hqwidth]
  have hxlarge : A ≤ q * ‖x‖ := by
    calc
      A ≤ q * (t - referenceTime) - 1 / 6 := by
        linarith [hlarge]
      _ ≤ q * ‖x‖ := hxlowerq.le
  have hxtube : |(t - referenceTime) - ‖x‖| ≤ (1 / 6 : Real) * q⁻¹ := by
    change |(t - referenceTime) - ‖x‖| ≤ width
    rw [abs_sub_comm]
    exact hx.le
  have hbase := hkernel j referenceTime t x
    (by simpa only [q] using hxlarge)
    (by simpa only [q] using hxtube)
  have hApos : 0 < A := by linarith
  have hxqpos : 0 < q * ‖x‖ :=
    lt_of_lt_of_le hApos hxlarge
  have hpow : (q * ‖x‖) ^ (n + 1) ≤ D ^ (n + 1) :=
    pow_le_pow_left₀ hxqpos.le hxupperq _
  have hnum : 0 ≤ q ^ (2 * n + 3) * c :=
    mul_nonneg (pow_nonneg hq.le _) hc.le
  have hfraction : q ^ (2 * n + 3) * c / D ^ (n + 1) ≤
      q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) :=
    div_le_div_of_nonneg_left hnum (pow_pos hxqpos _) hpow
  change q ^ (2 * n + 3) * c / D ^ (n + 1) ≤
    ‖(brrsDyadicHalfWaveTTStarKernel Phi j referenceTime t :
      BRRSSpace (2 * n + 3) → Complex) x‖
  calc
    q ^ (2 * n + 3) * c / D ^ (n + 1) ≤
        q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) := hfraction
    _ ≤ ‖(brrsDyadicHalfWaveTTStarKernel Phi j referenceTime t :
          BRRSSpace (2 * n + 3) → Complex) x‖ := by
      simpa only [q] using hbase

/-- The pointwise odd-dimensional cone-tube lower bound integrates over its
entire physical time shell.  This restricted-mass form is the exact input to
the finite-time `UniformEstimateAtExponent` summation interface. -/
theorem exists_brrsPositiveRadialTestPacket_odd_dyadic_coneTube_timeShell_lintegral_rpow_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 0 < p) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (referenceTime t : Real),
        A + (1 / 6 : Real) ≤ (2 : Real) ^ j * (t - referenceTime) →
          (ENNReal.ofReal
            ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
              (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
              volume (brrsTimeRadialShell (2 * n + 3) referenceTime t
                ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹)) ≤
            ∫⁻ x in brrsTimeRadialShell (2 * n + 3) referenceTime t
                ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹),
              (ENNReal.ofReal
                ‖brrsDyadicHalfWave Phi j t
                  (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) x‖) ^ p := by
  obtain ⟨A, c, hA, hc, hpoint⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_odd_dyadic_coneTube_timeShell_pointwise_lower
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j referenceTime t hlarge
  let q : Real := (2 : Real) ^ j
  let width : Real := (1 / 6 : Real) * q⁻¹
  let D : Real := q * (t - referenceTime) + 1 / 6
  change (ENNReal.ofReal (q ^ (2 * n + 3) * c / D ^ (n + 1))) ^ p *
      volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width) ≤
        ∫⁻ x in brrsTimeRadialShell (2 * n + 3) referenceTime t width,
          (ENNReal.ofReal
            ‖brrsDyadicHalfWave Phi j t
              (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) x‖) ^ p
  apply brrsTimeRadialShell_lintegral_rpow_lower_of_pointwise
    referenceTime t width (q ^ (2 * n + 3) * c / D ^ (n + 1)) p
    (brrsDyadicHalfWave Phi j t
      (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime)) hp.le
  intro x hx
  have hidentity := congrFun
    (brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel
      (d := 2 * n + 3) Phi j referenceTime t) x
  rw [hidentity]
  exact hpoint j referenceTime t x (by simpa only [q] using hlarge)
    (by simpa only [q, width] using hx)

/-- A uniform BRRS estimate in an odd dimension must dominate the literal
cone-shell mass of every eligible subpacket.  The conclusion pairs that
quantitative output lower bound with the all-`p` half-density input upper, so
it is a genuine necessary inequality for `UniformEstimateAtExponent`, rather
than an unproved assertion of full sharpness. -/
theorem exists_odd_dyadic_coneTube_obstruction_of_uniformEstimateAtExponent
    (Phi : BRRSAnnularCutoff) (n : Nat)
    (W : BRRSLpHalfWaveExtension (2 * n + 3) Phi)
    {E : Set Real} {p s : Real} (hp : 2 ≤ p)
    (hUniform : UniformEstimateAtExponent Phi W E p s) :
    ∃ A c C K : Real, 16 ≤ A ∧ 0 < c ∧ 0 < C ∧ 0 < K ∧
      ∀ (j : Nat) (T U : Finset Real) (referenceTime : Real),
        5 ≤ j → IsDyadicDiscretization E j T → U ⊆ T →
          referenceTime ∈ Icc (1 : Real) 2 →
          (∀ t ∈ U, A + (1 / 6 : Real) ≤
            (2 : Real) ^ j * (t - referenceTime)) →
          (∑ t ∈ U,
            (ENNReal.ofReal
              ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
                (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
              volume (brrsTimeRadialShell (2 * n + 3) referenceTime t
                ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹))) ≤
            (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
              ((ENNReal.ofReal
                (6 * ((1 - (1 / 32 : Real)) * C) *
                  ‖((2 : Real) ^ j) ^ (2 * n + 3)‖ /
                  (Real.sqrt (((2 : Real) ^ j / 32)) ^ ((2 * n + 3) - 1))) ^
                (p - 2)) *
              ENNReal.ofReal
                (((2 : Real) ^ j) ^ (2 * n + 3) *
                  ∫ xi : BRRSSpace (2 * n + 3),
                    ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)) ^ p⁻¹) ^ p := by
  have hp0 : 0 < p := lt_of_lt_of_le (by norm_num) hp
  obtain ⟨A, c, hA, hc, hlocal⟩ :=
    exists_brrsPositiveRadialTestPacket_odd_dyadic_coneTube_timeShell_lintegral_rpow_lower
      Phi n hp0
  obtain ⟨C, hC, hinput⟩ :=
    exists_eLpNorm_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
      (d := 2 * n + 3) (by omega) Phi
  obtain ⟨K, hK, hsum⟩ :=
    exists_sum_positiveRadialTestPacket_shell_pMass_le_of_uniformEstimateAtExponent
      W hp0 hUniform
  refine ⟨A, c, C, K, hA, hc, hC, hK, ?_⟩
  intro j T U referenceTime hj hT hUT href hlarge
  let width : Real := (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹
  let a : Real → ENNReal := fun t =>
    (ENNReal.ofReal
      ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
        (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
      volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width)
  let B : ENNReal :=
    ((ENNReal.ofReal
      (6 * ((1 - (1 / 32 : Real)) * C) *
        ‖((2 : Real) ^ j) ^ (2 * n + 3)‖ /
        (Real.sqrt (((2 : Real) ^ j / 32)) ^ ((2 * n + 3) - 1))) ^
      (p - 2)) *
    ENNReal.ofReal
      (((2 : Real) ^ j) ^ (2 * n + 3) *
        ∫ xi : BRRSSpace (2 * n + 3),
          ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)) ^ p⁻¹
  have hrestricted : ∀ t ∈ U, a t ≤
      ∫⁻ x in brrsTimeRadialShell (2 * n + 3) referenceTime t width,
        (ENNReal.ofReal
          ‖brrsDyadicHalfWave Phi j t
            (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime) x‖) ^ p := by
    intro t ht
    dsimp only [a, width]
    exact hlocal j referenceTime t (hlarge t ht)
  have hsum' := hsum j (by omega) T U hT hUT referenceTime width a hrestricted
  have hsource :
      eLpNorm (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime :
        BRRSSpace (2 * n + 3) → Complex) (ENNReal.ofReal p) volume ≤ B := by
    dsimp only [B]
    exact hinput j referenceTime p hj href hp
  change (∑ t ∈ U, a t) ≤
    (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) * B) ^ p
  calc
    (∑ t ∈ U, a t) ≤
        (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
          eLpNorm (brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime :
            BRRSSpace (2 * n + 3) → Complex) (ENNReal.ofReal p) volume) ^ p :=
      hsum'
    _ ≤ (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) * B) ^ p :=
      ENNReal.rpow_le_rpow
        (by
          simpa only [mul_comm] using
            (mul_le_mul_right hsource
              (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s))))) hp0.le

/-- The odd-dimensional cone-shell obstruction with its polar radial-volume
factor made explicit.  This is a necessary condition for any uniform BRRS
estimate: the stationary lower bound, the true volume of every full radial
shell, and the all-`p` input normalization are all present in one inequality.

It is deliberately a necessary inequality rather than a claim of global
sharpness; applying the local entropy witnesses still requires the final
finite-packet selection and power comparison. -/
theorem exists_odd_dyadic_coneTube_polar_obstruction_of_uniformEstimateAtExponent
    (Phi : BRRSAnnularCutoff) (n : Nat)
    (W : BRRSLpHalfWaveExtension (2 * n + 3) Phi)
    {E : Set Real} {p s : Real} (hp : 2 ≤ p)
    (hUniform : UniformEstimateAtExponent Phi W E p s) :
    ∃ A c C K : Real, 16 ≤ A ∧ 0 < c ∧ 0 < C ∧ 0 < K ∧
      ∀ (j : Nat) (T U : Finset Real) (referenceTime : Real),
        5 ≤ j → IsDyadicDiscretization E j T → U ⊆ T →
          referenceTime ∈ Icc (1 : Real) 2 →
          (∀ t ∈ U, A + (1 / 6 : Real) ≤
            (2 : Real) ^ j * (t - referenceTime)) →
          (∑ t ∈ U,
            (ENNReal.ofReal
              ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
                (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p) *
              (ENNReal.ofReal (surfaceMass (2 * n + 3)) *
                (ENNReal.ofReal ((t - referenceTime) ^ ((2 * n + 3) - 1)) *
                  ENNReal.ofReal ((1 / 6 : Real) * ((2 : Real) ^ j)⁻¹)))) ≤
            (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
              ((ENNReal.ofReal
                (6 * ((1 - (1 / 32 : Real)) * C) *
                  ‖((2 : Real) ^ j) ^ (2 * n + 3)‖ /
                  (Real.sqrt (((2 : Real) ^ j / 32)) ^ ((2 * n + 3) - 1))) ^
                (p - 2)) *
              ENNReal.ofReal
                (((2 : Real) ^ j) ^ (2 * n + 3) *
                  ∫ xi : BRRSSpace (2 * n + 3),
                    ‖brrsDyadicMultiplier Phi 0 xi‖ ^ 2)) ^ p⁻¹) ^ p := by
  obtain ⟨A, c, C, K, hA, hc, hC, hK, hbase⟩ :=
    exists_odd_dyadic_coneTube_obstruction_of_uniformEstimateAtExponent
      Phi n W hp hUniform
  refine ⟨A, c, C, K, hA, hc, hC, hK, ?_⟩
  intro j T U referenceTime hj hT hUT href hlarge
  let width : Real := (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹
  let amplitude : Real → ENNReal := fun t =>
    (ENNReal.ofReal
      ((((2 : Real) ^ j) ^ (2 * n + 3) * c) /
        (((2 : Real) ^ j * (t - referenceTime) + 1 / 6) ^ (n + 1))) ^ p)
  have hwidth : 0 < width := by
    dsimp only [width]
    positivity
  have hterm (t : Real) (ht : t ∈ U) :
      amplitude t *
          (ENNReal.ofReal (surfaceMass (2 * n + 3)) *
            (ENNReal.ofReal ((t - referenceTime) ^ ((2 * n + 3) - 1)) *
              ENNReal.ofReal width)) ≤
        amplitude t *
          volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width) := by
    have hq : 0 < (2 : Real) ^ j := by positivity
    have hApos : 0 < A + (1 / 6 : Real) := by linarith
    have hqrelative : 0 < (2 : Real) ^ j * (t - referenceTime) :=
      lt_of_lt_of_le hApos (hlarge t ht)
    have hforward : 0 ≤ t - referenceTime := by
      rcases (mul_pos_iff.mp hqrelative) with hpos | hneg
      · exact hpos.2.le
      · exact False.elim (not_lt_of_ge hq.le hneg.1)
    have hvolume :=
      ENNReal_ofReal_surfaceMass_mul_abs_sub_pow_mul_width_le_volume_brrsTimeRadialShell
        (d := 2 * n + 3) (by omega) referenceTime t width hwidth
    rw [abs_of_nonneg hforward] at hvolume
    simpa only [mul_comm] using (mul_le_mul_right hvolume (amplitude t))
  have hsum :
      (∑ t ∈ U,
        amplitude t *
          (ENNReal.ofReal (surfaceMass (2 * n + 3)) *
            (ENNReal.ofReal ((t - referenceTime) ^ ((2 * n + 3) - 1)) *
              ENNReal.ofReal width))) ≤
        ∑ t ∈ U,
          amplitude t *
            volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width) := by
    apply Finset.sum_le_sum
    intro t ht
    exact hterm t ht
  change (∑ t ∈ U,
      amplitude t *
        (ENNReal.ofReal (surfaceMass (2 * n + 3)) *
          (ENNReal.ofReal ((t - referenceTime) ^ ((2 * n + 3) - 1)) *
            ENNReal.ofReal width))) ≤ _
  calc
    (∑ t ∈ U,
      amplitude t *
        (ENNReal.ofReal (surfaceMass (2 * n + 3)) *
          (ENNReal.ofReal ((t - referenceTime) ^ ((2 * n + 3) - 1)) *
            ENNReal.ofReal width))) ≤
        ∑ t ∈ U,
          amplitude t *
            volume (brrsTimeRadialShell (2 * n + 3) referenceTime t width) := hsum
    _ ≤ _ := by
      simpa only [amplitude, width] using
        (hbase j T U referenceTime hj hT hUT href hlarge)

end

end Auto.Spherical.FractalDilations.BRRS
