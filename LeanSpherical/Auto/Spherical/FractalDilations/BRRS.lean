/-- The compact-frequency profile of a planar middle--endpoint coefficient
retains arbitrary rapid decay in its middle radius. -/
theorem exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_middle_endpoint_highRadius_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi .middle partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            Real.sqrt (s / 16))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      N Phi .middle partS
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        Real.sqrt (s / 16))
      (by
        intro r s hrs
        apply mul_pos
        · apply pow_pos
          apply Real.sqrt_pos.2
          linarith [hrs.1]
        · apply Real.sqrt_pos.2
          linarith [hrs.2])
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_middle_endpoint_highRadius_rapidDecay
            N M hM Phi partS hpartS
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- Restoring the literal stationary carrier to the preceding planar
middle--endpoint profile estimate. -/
theorem exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_middle_endpoint_highRadius_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart)
    (hpartS : partS = .outgoing ∨ partS = .incoming) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            Real.sqrt (s / 16))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_middle_endpoint_highRadius_rapidProfile_le
      N M hM Phi partS hpartS
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr hs

/-- The compact-frequency profile of the planar middle--middle coefficient
has independently arbitrary decay at both high radii. -/
theorem exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsPlanarTwoRadiusStationaryCoefficient Phi .middle .middle r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      N Phi .middle .middle
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        (Real.sqrt (s / 16)) ^ (M - 1))
      (by
        intro r s hrs
        apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;>
          linarith)
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsPlanarTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidDecay
            N M hM Phi
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- Restoring the carrier to the planar middle--middle rapid profile. -/
theorem exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_middle_middle_highRadius_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsPlanarTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidProfile_le
      N M hM Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs

end

end Auto.Spherical.FractalDilations.BRRS

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- At two high planar radii, the five named components containing a middle
wave are bounded by their five exact compact-frequency phase profiles.  The
two endpoint--middle pieces use the swapped geometry, the two middle--endpoint
pieces retain rapid decay in the first radius, and the middle--middle piece is
kept with its independent rapid decay in both radii. -/
theorem exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fivePhase_rapidProfile_le
    (N M : Nat) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (s / 16)) ^ (M - 1) *
            Real.sqrt (r / 16))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .incoming r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .middle r +
                brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .middle r +
                brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)) +
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_middle_endpoint_highRadius_rapidProfile_le
      N M hM Phi .outgoing (Or.inl rfl)
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_middle_endpoint_highRadius_rapidProfile_le
      N M hM Phi .incoming (Or.inr rfl)
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsPlanarTwoRadiusStationaryComponentIntegral_middle_middle_highRadius_rapidProfile_le
      N M hM Phi
  let C : Real := Cmo + Cmi + Cmm
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let qr : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    Real.sqrt (s / 16)
  let qs : Real := (Real.sqrt (s / 16)) ^ (M - 1) *
    Real.sqrt (r / 16)
  let qmm : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    (Real.sqrt (s / 16)) ^ (M - 1)
  let Ar : Real := (1 - (1 / 32 : Real)) * (C / qr)
  let As : Real := (1 - (1 / 32 : Real)) * (C / qs)
  let Amm : Real := (1 - (1 / 32 : Real)) * (C / qmm)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply Real.sqrt_pos.2
      linarith
  have hqs : 0 < qs := by
    dsimp [qs]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply Real.sqrt_pos.2
      linarith
  have hqmm : 0 < qmm := by
    dsimp [qmm]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hAr_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qr) ≤ Ar := by
    dsimp [Ar]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqr.le
    · norm_num
  have hAs_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qs) ≤ As := by
    dsimp [As]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqs.le
    · norm_num
  have hAmm_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qmm) ≤ Amm := by
    dsimp [Amm]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqmm.le
    · norm_num
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Iom : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .outgoing .middle r s t
  let Iim : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .incoming .middle r s t
  let Imo : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .outgoing r s t
  let Imi : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .incoming r s t
  let Imm : Complex :=
    brrsPlanarTwoRadiusStationaryComponentIntegral Phi .middle .middle r s t
  have hphaseom :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .outgoing r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .outgoing r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hphaseim :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .incoming r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .incoming r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hPom : 0 ≤ Pom := by
    dsimp [Pom]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPim : 0 ≤ Pim := by
    dsimp [Pim]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmo : 0 ≤ Pmo := by
    dsimp [Pmo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmi : 0 ≤ Pmi := by
    dsimp [Pmi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmm : 0 ≤ Pmm := by
    dsimp [Pmm]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIom : ‖Iom‖ ≤ As * Pom := by
    dsimp [Iom, Pom]
    rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t) := by
        simpa only [qs] using hmo s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseom]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmo hCmo_le) hPom
  have hIim : ‖Iim‖ ≤ As * Pim := by
    dsimp [Iim, Pim]
    rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t) := by
        simpa only [qs] using hmi s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseim]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmi hCmi_le) hPim
  have hImo : ‖Imo‖ ≤ Ar * Pmo := by
    dsimp [Imo, Pmo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [qr] using hmo r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmo hCmo_le) hPmo
  have hImi : ‖Imi‖ ≤ Ar * Pmi := by
    dsimp [Imi, Pmi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [qr] using hmi r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmi hCmi_le) hPmi
  have hImm : ‖Imm‖ ≤ Amm * Pmm := by
    dsimp [Imm, Pmm]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / qmm) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [qmm] using hmm r s t hr hs
      _ ≤ Amm * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAmm_le Cmm hCmm_le) hPmm
  change ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
    As * (Pom + Pim) + Ar * (Pmo + Pmi) + Amm * Pmm
  calc
    ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
        ‖Iom + Iim‖ + ‖Imo + Imi + Imm‖ := norm_add_le _ _
    _ ≤ (‖Iom‖ + ‖Iim‖) + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖) := by
      apply add_le_add
      · exact norm_add_le _ _
      · calc
          ‖Imo + Imi + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
          _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
            exact add_le_add (norm_add_le Imo Imi) le_rfl
    _ ≤ (As * Pom + As * Pim) +
          ((Ar * Pmo + Ar * Pmi) + Amm * Pmm) := by
      apply add_le_add
      · exact add_le_add hIom hIim
      · apply add_le_add
        · exact add_le_add hImo hImi
        · exact hImm
    _ = As * (Pom + Pim) + Ar * (Pmo + Pmi) + Amm * Pmm := by ring

/-- The planar five-term middle remainder is exactly symmetric in its two
radii.  This is the planar counterpart of the all-dimensional symmetry used
to pass from the ordered kernel majorant to the full high--high region. -/
theorem brrsPlanarTwoRadiusMiddleComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (r s t : Real) :
    brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t =
      brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t := by
  unfold brrsPlanarTwoRadiusMiddleComponentIntegralSum
  rw [brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .outgoing .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .incoming .middle r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .outgoing r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .incoming r s t,
    brrsPlanarTwoRadiusStationaryComponentIntegral_swap Phi .middle .middle r s t]
  ring

/-- The planar middle-wave contribution satisfies the four endpoint-sign
profile bound in the ordered high--high region.  The middle--middle term has
rapid decay at both radii; one of those factors is used for the phase
transfer and the other is harmlessly bounded by one. -/
theorem exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le_of_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s → s ≤ r →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let M : Nat := 2 + 2 * N
  have hM : 2 ≤ M := by
    dsimp [M]
    omega
  obtain ⟨C₀, hC₀, hfive⟩ :=
    exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fivePhase_rapidProfile_le
      (2 * N) M hM Phi
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let C : Real := 5 * L * C₀
  have hL : 0 < L := by
    dsimp [L]
    positivity
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs hsr
  let R : Real := Real.sqrt (r / 16)
  let S : Real := Real.sqrt (s / 16)
  let B : Real := R * S
  let Dₛ : Real := 1 / S ^ (2 * N)
  let Dᵣ : Real := 1 / R ^ (2 * N)
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Q₁ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))
  let Q₂ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))
  let Q₃ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s))
  let Q₄ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s))
  let Q₅ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)
  have hMsub : M - 1 = 1 + 2 * N := by
    dsimp [M]
    omega
  have hfive' :
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R)) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S)) * (Q₃ + Q₄) +
            δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) * Q₅ := by
    convert hfive r s t hr hs using 1 <;>
      simp only [R, S, δ, Q₁, Q₂, Q₃, Q₄, Q₅,
        brrsSurfaceWavePhase] <;> ring
  have hR : 0 < R := by
    dsimp [R]
    apply Real.sqrt_pos.2
    linarith
  have hS : 0 < S := by
    dsimp [S]
    apply Real.sqrt_pos.2
    linarith
  have hB : 0 < B := by
    dsimp [B]
    exact mul_pos hR hS
  have hfactorS :
      δ * (C₀ / (S ^ (M - 1) * R)) =
        (δ * (C₀ / B)) * Dₛ := by
    rw [hMsub]
    dsimp [B, Dₛ, R, S]
    calc
      δ * (C₀ / ((Real.sqrt (s / 16)) ^ (1 + 2 * N) *
          Real.sqrt (r / 16))) =
          δ * (C₀ / (Real.sqrt (r / 16) *
            (Real.sqrt (s / 16)) ^ (1 + 2 * N))) := by ring
      _ = δ * ((C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by
          simpa only [pow_one] using
            congrArg (fun z : Real => δ * z)
              (brrs_twoRadius_middle_denominator_factor
                (r := r) (s := s) hr hs 1 N C₀)
      _ = (δ * (C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by ring
  have hfactorR :
      δ * (C₀ / (R ^ (M - 1) * S)) =
        (δ * (C₀ / B)) * Dᵣ := by
    rw [hMsub]
    dsimp [B, Dᵣ, R, S]
    calc
      δ * (C₀ / ((Real.sqrt (r / 16)) ^ (1 + 2 * N) *
          Real.sqrt (s / 16))) =
          δ * (C₀ / (Real.sqrt (s / 16) *
            (Real.sqrt (r / 16)) ^ (1 + 2 * N))) := by ring
      _ = δ * ((C₀ / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by
          simpa only [pow_one] using
            congrArg (fun z : Real => δ * z)
              (brrs_twoRadius_middle_denominator_factor
                (r := s) (s := r) hs hr 1 N C₀)
      _ = (δ * (C₀ / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by ring
  have hfactorMM :
      δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) =
        (δ * (C₀ / B)) * Dᵣ * Dₛ := by
    rw [hMsub]
    dsimp [B, Dᵣ, Dₛ, R, S]
    rw [pow_add, pow_add]
    simp only [pow_one]
    field_simp [hR.ne', hS.ne']
  have hphase :=
    brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
      (r := r) (s := s) (t := t) hr hs hsr N
  have hphase' :
      Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅) ≤
        (5 * L) * (P₁ + P₂ + P₃ + P₄) := by
    simpa only [Dₛ, Dᵣ, Q₁, Q₂, Q₃, Q₄, Q₅, L, P₁, P₂, P₃, P₄] using hphase
  have hDₛ_le_one : Dₛ ≤ 1 := by
    simpa only [Dₛ, S] using
      brrs_highRadius_sqrt_inverse_pow_le_one hs N
  have hDᵣ_nonneg : 0 ≤ Dᵣ := by
    dsimp [Dᵣ]
    positivity
  have hQ₅_nonneg : 0 ≤ Q₅ := by
    dsimp [Q₅]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hmm_le : Dᵣ * Dₛ * Q₅ ≤ Dᵣ * Q₅ := by
    calc
      Dᵣ * Dₛ * Q₅ = Dᵣ * (Dₛ * Q₅) := by ring
      _ ≤ Dᵣ * (1 * Q₅) := by
        apply mul_le_mul_of_nonneg_left
        exact mul_le_mul_of_nonneg_right hDₛ_le_one hQ₅_nonneg
        exact hDᵣ_nonneg
      _ = Dᵣ * Q₅ := by ring
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ δ * (C₀ / B) := by
    exact mul_nonneg hδ (div_nonneg hC₀.le hB.le)
  calc
    ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R)) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S)) * (Q₃ + Q₄) +
            δ * (C₀ / (R ^ (M - 1) * S ^ (M - 1))) * Q₅ := hfive'
    _ = (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Dₛ * Q₅) := by
      rw [hfactorS, hfactorR, hfactorMM]
      ring
    _ ≤ (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Q₅) := by
      apply mul_le_mul_of_nonneg_left
      · calc
          Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Dₛ * Q₅ =
              Dᵣ * Dₛ * Q₅ + (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) := by ring
          _ = (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) + Dᵣ * Dₛ * Q₅ := by ring
          _ ≤ (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) + Dᵣ * Q₅ :=
            add_le_add_right hmm_le _
          _ = Dᵣ * Q₅ + (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄)) := by ring
          _ = Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄) + Dᵣ * Q₅ := by ring
      · exact hA
    _ = (δ * (C₀ / B)) *
          (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅)) := by ring
    _ ≤ (δ * (C₀ / B)) * ((5 * L) * (P₁ + P₂ + P₃ + P₄)) := by
      exact mul_le_mul_of_nonneg_left hphase' hA
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, C, B, R, S, P₁, P₂, P₃, P₄]
      ring

/-- The ordered planar middle-wave estimate extends by exact radial
symmetry to every pair of high radii. -/
theorem exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨C, hC, hordered⟩ :=
    exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le_of_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  by_cases hsr : s ≤ r
  · exact hordered r s t hr hs hsr
  · have hrs : r ≤ s := le_of_not_ge hsr
    rw [brrsPlanarTwoRadiusMiddleComponentIntegralSum_swap Phi r s t]
    have hswapped := hordered s r t hs hr hrs
    have hswapped' :
        ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t‖ ≤
          (1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
      calc
        ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi s r t‖ ≤
            (1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) :=
          hswapped
        _ = (1 - (1 / 32 : Real)) *
              (C / (Real.sqrt (s / 16) * Real.sqrt (r / 16))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
          ring
    convert hswapped' using 1 <;> ring

/-- The literal planar all-nine stationary kernel obeys the same high-radius
four-sign majorant as the nonplanar kernel.  Its endpoint and middle pieces
are both exact components of the circle Fourier decomposition. -/
theorem exists_norm_brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Cend, hCend, hend⟩ :=
    exists_norm_brrsPlanarTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      N Phi
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_brrsPlanarTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
      N Phi
  let C : Real := Cend + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let B : Real := Real.sqrt (r / 16) * Real.sqrt (s / 16)
  let P : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
    brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
      brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  have hsum :
      brrsPlanarTwoRadiusAllStationaryComponentIntegralSum Phi r s t =
        brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t +
          brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t :=
    brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
      Phi r s t
  rw [hsum]
  calc
    ‖brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t +
        brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ ≤
        ‖brrsPlanarTwoRadiusEndpointIntegralSum Phi r s t‖ +
          ‖brrsPlanarTwoRadiusMiddleComponentIntegralSum Phi r s t‖ := norm_add_le _ _
    _ ≤ (1 - (1 / 32 : Real)) * (Cend / B) * P +
          (1 - (1 / 32 : Real)) * (Cmid / B) * P := by
      dsimp [B, P]
      exact add_le_add (hend r s t hr hs) (hmid r s t hr hs)
    _ = (1 - (1 / 32 : Real)) * (C / B) * P := by
      dsimp [C]
      ring
    _ = (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16) * Real.sqrt (s / 16))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

/-- The literal dyadic all-nine circle kernel carries the same four-sign
majorant at high scaled radii. -/
theorem exists_norm_brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ 2‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
              Real.sqrt ((((2 : Real) ^ j) * s) / 16))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsPlanarTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  unfold brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum
  rw [norm_smul]
  exact mul_le_mul_of_nonneg_left
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)
    (norm_nonneg _)

/-- The circle case of the literal all-nine kernel has the same normalized
four-sign source profile as BRRS (5.4).  This closes the `d = 2` branch of
the Bessel-kernel reduction without treating the planar middle term as an
error. -/
theorem exists_brrsDyadicHighHigh_allPlanarStationary_radial_fourPhase_block_le
    (N : Nat) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace 2 → Complex, ∀ w : BRRSSpace 2,
      0 < p → 16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      r ^ (((2 : Real) - 1) / p) *
          (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
            (s ^ (2 - 1) * ‖f (s • w)‖)) ≤
        (1 - (1 / 32 : Real)) * C * 16 ^ ((2 : Real) - 1) *
          ((s / r) ^ sobolevExponent 2 p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
      N Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr hs
  have hqpos : 0 < (2 : Real) ^ j := by positivity
  have hrpos : 0 < r := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hr)
    exact hqpos.le
  have hspos : 0 < s := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hs)
    exact hqpos.le
  have hdenpos : 0 <
      Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
        Real.sqrt ((((2 : Real) ^ j) * s) / 16) := by
    apply mul_pos
    · apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hrpos) (by norm_num)
    · apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hspos) (by norm_num)
  have hdenne :
      Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
        Real.sqrt ((((2 : Real) ^ j) * s) / 16) ≠ 0 :=
    ne_of_gt hdenpos
  have hradial : 0 ≤ r ^ (((2 : Real) - 1) / p) :=
    Real.rpow_nonneg hrpos.le _
  have hdensity : 0 ≤ s ^ (2 - 1) * ‖f (s • w)‖ :=
    mul_nonneg (pow_nonneg hspos.le _) (norm_nonneg _)
  have hkernel := hprofile j r s t hr hs
  calc
    r ^ (((2 : Real) - 1) / p) *
        (‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ *
          (s ^ (2 - 1) * ‖f (s • w)‖)) =
        (r ^ (((2 : Real) - 1) / p) *
          (s ^ (2 - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicPlanarTwoRadiusAllStationaryComponentIntegralSum Phi j r s t‖ := by ring
    _ ≤ (r ^ (((2 : Real) - 1) / p) *
          (s ^ (2 - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ 2‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16) *
              Real.sqrt ((((2 : Real) ^ j) * s) / 16))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s)))))) := by
      exact mul_le_mul_of_nonneg_left hkernel (mul_nonneg hradial hdensity)
    _ = (1 - (1 / 32 : Real)) * C *
          (r ^ (((2 : Real) - 1) / p) *
            ((‖((2 : Real) ^ j) ^ 2‖ /
              ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (2 - 1) *
                (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (2 - 1))) *
              (s ^ (2 - 1) * ‖f (s • w)‖)) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
      field_simp [hdenne]
      norm_num
      ring
    _ = (1 - (1 / 32 : Real)) * C * 16 ^ ((2 : Real) - 1) *
          ((s / r) ^ sobolevExponent 2 p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
      have hfactor :=
        brrsDyadicHighHigh_prefactor_polar_source_fourPhase_eq
          (d := 2) (j := j) (N := N) (t := t)
          (by norm_num) hp.ne' hrpos hspos f w
      norm_num at hfactor ⊢
      rw [hfactor]
      ring

/-! ### Outer integration of the compact all-nine model

The exact stationary identities above are identities of Bochner integrals.
For the initial output cell, the following lemmas turn the unconditional
all-nine kernel bound into a genuine outer radial majorant.  In particular,
the profile-weighted source integral is integrable on Schwartz data, so the
triangle inequality is not relying on a formal zero value of a non-integrable
integral. -/

/-- A stationary rapid profile is bounded by one, independently of the
number of integrations by parts used to define it. -/
theorem brrsStationaryRapidProfile_le_one (N : Nat) (u : Real) :
    brrsStationaryRapidProfile N u ≤ 1 := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  · rw [brrsStationaryRapidProfile, if_neg hu]
    exact min_le_left _ _

/-- Away from the carrier zero, the stationary rapid profile is bounded by
the literal integration-by-parts power that defines it. -/
theorem brrsStationaryRapidProfile_le_inversePow {N : Nat} {u : Real}
    (hu : u ≠ 0) :
    brrsStationaryRapidProfile N u ≤ (1 / |u|) ^ N := by
  rw [brrsStationaryRapidProfile, if_neg hu]
  exact min_le_right _ _

/-- On the high-radius side of the cone (`|x| ≥ t / 2`), the three literal
stationary profiles are bounded by one and the stationary half-density alone
gives the sharp wave-size majorant. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_nearTime_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ → t / 2 ≤ ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t x ht hx hnear
  have htpos : 0 < t := by linarith
  have hratio : t / 32 ≤ ‖x‖ / 16 := by linarith
  have hsqrt : Real.sqrt (t / 32) ≤ Real.sqrt (‖x‖ / 16) :=
    Real.sqrt_le_sqrt hratio
  have hden : (Real.sqrt (t / 32)) ^ (d - 1) ≤
      (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrt _
  have hdenpos : 0 < (Real.sqrt (t / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hdiv : C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1) ≤
      C / (Real.sqrt (t / 32)) ^ (d - 1) :=
    div_le_div_of_nonneg_left hC.le hdenpos hden
  have hsum :
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
          brrsStationaryRapidProfile N (2 * Real.pi * t) ≤ 3 := by
    have h₁ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * (t - ‖x‖))
    have h₂ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * (t + ‖x‖))
    have h₃ := brrsStationaryRapidProfile_le_one N (2 * Real.pi * t)
    linarith
  have hkernel := hprofile t x hx
  calc
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := hkernel
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) * 3 := by
      apply mul_le_mul_of_nonneg_left hsum
      positivity
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (t / 32)) ^ (d - 1)) * 3 := by
      apply mul_le_mul_of_nonneg_right
      · apply mul_le_mul_of_nonneg_left hdiv
        norm_num
      · norm_num
    _ = 3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) := by
      field_simp [hdenpos.ne']

/-- Well inside the high-radius light cone (`|x| < t / 2`), every stationary
carrier is nonzero at scale at least `t`.  Repeated integration by parts then
gives arbitrary rapid time decay even though the spatial radius itself may be
large. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_insideTime_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ → ‖x‖ < t / 2 →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t x ht hx hinside
  have htpos : 0 < t := by linarith
  have hx0 : 0 ≤ ‖x‖ := norm_nonneg _
  have hsubpos : 0 ≤ t - ‖x‖ := by linarith
  have hphaseout :
      2 * Real.pi * (t - ‖x‖) =
        2 * Real.pi * (t - ‖x‖) := rfl
  have htwole : (2 : Real) ≤ 2 * Real.pi := by
    nlinarith [Real.pi_gt_three]
  have houtbase : t ≤ 2 * Real.pi * (t - ‖x‖) := by
    have hhalf : t ≤ 2 * (t - ‖x‖) := by linarith
    calc
      t ≤ 2 * (t - ‖x‖) := hhalf
      _ ≤ (2 * Real.pi) * (t - ‖x‖) :=
        mul_le_mul_of_nonneg_right htwole hsubpos
      _ = 2 * Real.pi * (t - ‖x‖) := by ring
  have hinbase : t ≤ 2 * Real.pi * (t + ‖x‖) := by
    have hsumpos : 0 ≤ t + ‖x‖ := by linarith
    calc
      t ≤ t + ‖x‖ := by linarith
      _ ≤ (2 * Real.pi) * (t + ‖x‖) :=
        le_mul_of_one_le_left hsumpos (by linarith [htwole])
      _ = 2 * Real.pi * (t + ‖x‖) := by ring
  have hmidbase : t ≤ 2 * Real.pi * t :=
    le_mul_of_one_le_left htpos.le (by linarith [htwole])
  have houtdom : t ≤ |2 * Real.pi * (t - ‖x‖)| := by
    rw [abs_of_nonneg (by positivity)]
    exact houtbase
  have hindom : t ≤ |2 * Real.pi * (t + ‖x‖)| := by
    rw [abs_of_nonneg (by positivity)]
    exact hinbase
  have hmiddom : t ≤ |2 * Real.pi * t| := by
    rw [abs_of_nonneg (by positivity)]
    exact hmidbase
  have houtne : 2 * Real.pi * (t - ‖x‖) ≠ 0 := by
    intro hzero
    rw [hzero] at houtdom
    linarith
  have hinne : 2 * Real.pi * (t + ‖x‖) ≠ 0 := by
    intro hzero
    rw [hzero] at hindom
    linarith
  have hmidne : 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero] at hmiddom
    linarith
  have houtpow : brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) ≤
          (1 / |2 * Real.pi * (t - ‖x‖)|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow houtne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos houtdom) _
  have hinpow : brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) ≤
          (1 / |2 * Real.pi * (t + ‖x‖)|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow hinne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos hindom) _
  have hmidpow : brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
      (1 / t) ^ N := by
    calc
      brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
          (1 / |2 * Real.pi * t|) ^ N :=
        brrsStationaryRapidProfile_le_inversePow hmidne
      _ ≤ (1 / t) ^ N :=
        pow_le_pow_left₀ (by positivity)
          (one_div_le_one_div_of_le htpos hmiddom) _
  have hsqrtone : 1 ≤ Real.sqrt (‖x‖ / 16) := by
    rw [← Real.sqrt_one]
    apply Real.sqrt_le_sqrt
    linarith
  have hdenone : 1 ≤ (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    one_le_pow₀ hsqrtone
  have hdenpos : 0 < (Real.sqrt (‖x‖ / 16)) ^ (d - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hsum :
      brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
          brrsStationaryRapidProfile N (2 * Real.pi * t) ≤
        (1 / t) ^ N + (1 / t) ^ N + (1 / t) ^ N := by
    linarith
  have hkernel := hprofile t x hx
  calc
    ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - ‖x‖)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + ‖x‖)) +
                brrsStationaryRapidProfile N (2 * Real.pi * t)) := hkernel
    _ ≤ (1 - (1 / 32 : Real)) * C *
        ((1 / t) ^ N + (1 / t) ^ N + (1 / t) ^ N) := by
      apply mul_le_mul
      · apply mul_le_mul_of_nonneg_left hdiv
        norm_num
      · exact hsum
      · exact add_nonneg
          (add_nonneg (brrsStationaryRapidProfile_nonneg N _)
            (brrsStationaryRapidProfile_nonneg N _))
          (brrsStationaryRapidProfile_nonneg N _)
      · positivity
    _ = 3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ N := by
      ring

/-- The two high-radius regimes combine into a completely explicit global
envelope: the first term is the cone-scale half-density and the second is a
rapid nonstationary remainder. -/
theorem exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_largeTime_envelope_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real, ∀ x : Euclidean d,
      32 ≤ t → 16 ≤ ‖x‖ →
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
        3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (t / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d := by
  obtain ⟨Cnear, hCnear, hnear⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_nearTime_le
      (d := d) (N := d) hd Phi
  obtain ⟨Cinside, hCinside, hinside⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_insideTime_le
      (d := d) (N := d) hd Phi
  let C : Real := Cnear + Cinside
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro t x ht hx
  have htpos : 0 < t := by linarith
  have hdenpos : 0 < (Real.sqrt (t / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hnearle : Cnear ≤ C := by
    dsimp [C]
    linarith
  have hinsidele : Cinside ≤ C := by
    dsimp [C]
    linarith
  by_cases hsplit : t / 2 ≤ ‖x‖
  · have h := hnear t x ht hx hsplit
    calc
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
          3 * ((1 - (1 / 32 : Real)) * Cnear) /
            (Real.sqrt (t / 32)) ^ (d - 1) := h
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) := by
        apply div_le_div_of_nonneg_right
        apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_left hnearle (by norm_num)
        · norm_num
        · exact hdenpos.le
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d :=
        le_add_of_nonneg_right (by positivity)
  · have hlt : ‖x‖ < t / 2 := lt_of_not_ge hsplit
    have h := hinside t x ht hx hlt
    calc
      ‖(brrsDyadicHalfWaveKernel Phi 0 t : Euclidean d → Complex) x‖ ≤
          3 * ((1 - (1 / 32 : Real)) * Cinside) * (1 / t) ^ d := h
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d := by
        apply mul_le_mul_of_nonneg_right
        · apply mul_le_mul_of_nonneg_left
          · exact mul_le_mul_of_nonneg_left hinsidele (by norm_num)
          · norm_num
        · positivity
      _ ≤ 3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt (t / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) * (1 / t) ^ d :=
        le_add_of_nonneg_left (by positivity)

/-- Global pointwise envelope for the literal BRRS adjoint test packet at
all sufficiently high dyadic levels.  Its first term is exactly the
stationary cone scale `q^d / sqrt(q)^(d-1)`, while its second term is a
rapidly decaying nonstationary remainder.  Thus it is the direct formal
precursor of the `q^((d+1)/2)` input `L∞` bound in BRRS (3.2). -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_globalEnvelope_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
  obtain ⟨Chigh, hChigh, hhigh⟩ :=
    exists_norm_brrsDyadicHalfWaveKernel_levelZero_highRadius_largeTime_envelope_le
      (d := d) hd Phi
  obtain ⟨Clow, hClow, hlow⟩ :=
    exists_norm_brrsPositiveRadialHalfWaveTestPacket_lowScaledRadius_le
      (d := d) (N := d) hd Phi
  let C : Real := Chigh + Clow
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hj href
  let q : Real := (2 : Real) ^ j
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqge : 32 ≤ q := by
    dsimp only [q]
    calc
      (32 : Real) = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) hj
  have htime : 32 ≤ q * referenceTime := by
    calc
      (32 : Real) = 32 * 1 := by ring
      _ ≤ q * referenceTime := mul_le_mul hqge href.1 (by norm_num) hqpos.le
  have hChighle : Chigh ≤ C := by
    dsimp [C]
    linarith
  have hClowle : Clow ≤ C := by
    dsimp [C]
    linarith
  by_cases hsmall : q * ‖x‖ ≤ 16
  · have h := hlow j referenceTime x hj href (by simpa only [q] using hsmall)
    have hrem :
        3 * ((1 - (1 / 32 : Real)) * Clow) *
            (1 / (q * referenceTime)) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d := by
      apply mul_le_mul_of_nonneg_right
      · apply mul_le_mul_of_nonneg_left
        · exact mul_le_mul_of_nonneg_left hClowle (by norm_num)
        · norm_num
      · positivity
    calc
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
          ‖q ^ d‖ *
            (3 * ((1 - (1 / 32 : Real)) * Clow) *
              (1 / (q * referenceTime)) ^ d) := by
        simpa only [q] using h
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hrem (norm_nonneg _)
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left (le_add_of_nonneg_left (by positivity))
          (norm_nonneg _)
      _ = ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
        rfl
  · have hlarge : 16 ≤ q * ‖x‖ := le_of_not_ge hsmall
    have hscaledRadius : 16 ≤ ‖q • (-x)‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hqpos, norm_neg]
      exact hlarge
    have hkernel := hhigh (q * referenceTime) (q • (-x)) htime hscaledRadius
    have hinner :
        3 * ((1 - (1 / 32 : Real)) * Chigh) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * Chigh) *
            (1 / (q * referenceTime)) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d := by
      gcongr
    rw [brrsPositiveRadialHalfWaveTestPacket_eq_star_neg_halfWaveKernel]
    change ‖star ((brrsDyadicHalfWaveKernel Phi j referenceTime : Euclidean d → Complex)
      (-x))‖ ≤ _
    rw [norm_star, brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general,
      norm_smul]
    calc
      ‖q ^ d‖ *
          ‖(brrsDyadicHalfWaveKernel Phi 0 (q * referenceTime) :
            Euclidean d → Complex) (q • (-x))‖ ≤
          ‖q ^ d‖ *
            (3 * ((1 - (1 / 32 : Real)) * Chigh) /
              (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
            3 * ((1 - (1 / 32 : Real)) * Chigh) *
              (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hkernel (norm_nonneg _)
      _ ≤ ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) :=
        mul_le_mul_of_nonneg_left hinner (norm_nonneg _)
      _ = ‖((2 : Real) ^ j) ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((((2 : Real) ^ j) * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (((2 : Real) ^ j) * referenceTime)) ^ d) := by
        rfl

/-- The global packet envelope has the single stationary half-density scale.
Written using natural powers, `q^d / sqrt (q / 32)^(d-1)` is precisely a
dimension-dependent constant times `q^((d+1)/2)`.  This is the pointwise
`L∞` normalization required for the BRRS input packet. -/
theorem exists_norm_brrsPositiveRadialHalfWaveTestPacket_halfDensityScale_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ referenceTime : Real, ∀ x : Euclidean d,
      5 ≤ j → referenceTime ∈ Icc (1 : Real) 2 →
      ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
          (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1)) := by
  obtain ⟨C, hC, henvelope⟩ :=
    exists_norm_brrsPositiveRadialHalfWaveTestPacket_globalEnvelope_le hd Phi
  refine ⟨C, hC, ?_⟩
  intro j referenceTime x hj href
  let q : Real := (2 : Real) ^ j
  let s : Real := q * referenceTime
  let r : Real := Real.sqrt (q / 32)
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hqge : 32 ≤ q := by
    dsimp only [q]
    calc
      (32 : Real) = 2 ^ 5 := by norm_num
      _ ≤ 2 ^ j := pow_le_pow_right₀ (by norm_num) hj
  have hsgeq : q ≤ s := by
    dsimp [s]
    exact le_mul_of_one_le_right hqpos.le href.1
  have hspos : 0 < s := lt_of_lt_of_le hqpos hsgeq
  have hq32one : 1 ≤ q / 32 := by linarith
  have hrleq : r ≤ q := by
    dsimp [r]
    calc
      Real.sqrt (q / 32) ≤ q / 32 :=
        Real.sqrt_le_self_iff.mpr (Or.inr hq32one)
      _ ≤ q := by linarith
  have hrles : r ≤ s := hrleq.trans hsgeq
  have hrpos : 0 < r := by
    dsimp [r]
    apply Real.sqrt_pos.2
    linarith
  have hsone : 1 ≤ s := by linarith
  have hpowrs : r ^ (d - 1) ≤ s ^ (d - 1) :=
    pow_le_pow_left₀ hrpos.le hrles _
  have hdpos : 1 ≤ d := by omega
  have hd_eq : d = (d - 1) + 1 := by omega
  have hpowss : s ^ (d - 1) ≤ s ^ d := by
    calc
      s ^ (d - 1) = s ^ (d - 1) * 1 := by ring
      _ ≤ s ^ (d - 1) * s :=
        mul_le_mul_of_nonneg_left hsone (pow_nonneg hspos.le _)
      _ = s ^ d := by
        rw [← pow_succ, ← hd_eq]
  have hpowrsd : r ^ (d - 1) ≤ s ^ d := hpowrs.trans hpowss
  have hrpowpos : 0 < r ^ (d - 1) := pow_pos hrpos _
  have hdenTime : r ^ (d - 1) ≤ (Real.sqrt (s / 32)) ^ (d - 1) := by
    apply pow_le_pow_left₀ (Real.sqrt_nonneg _)
    apply Real.sqrt_le_sqrt
    dsimp [s]
    have : q ≤ q * referenceTime := hsgeq
    linarith
  have hdenTimePos : 0 < (Real.sqrt (s / 32)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    dsimp [s]
    linarith
  have hfirst :
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) ≤
        3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) := by
    have hinv : 1 / (Real.sqrt (s / 32)) ^ (d - 1) ≤ 1 / r ^ (d - 1) :=
      one_div_le_one_div_of_le hrpowpos hdenTime
    simpa only [div_eq_mul_inv, one_mul] using
      mul_le_mul_of_nonneg_left hinv (by positivity :
        0 ≤ 3 * ((1 - (1 / 32 : Real)) * C))
  have hsecond :
      3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
        3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) := by
    have hinv : 1 / s ^ d ≤ 1 / r ^ (d - 1) :=
      one_div_le_one_div_of_le hrpowpos hpowrsd
    rw [one_div_pow]
    simpa only [div_eq_mul_inv, one_mul] using
      mul_le_mul_of_nonneg_left hinv (by positivity :
        0 ≤ 3 * ((1 - (1 / 32 : Real)) * C))
  have h := henvelope j referenceTime x hj href
  have hinner :
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
        2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1)) := by
    calc
      3 * ((1 - (1 / 32 : Real)) * C) /
          (Real.sqrt (s / 32)) ^ (d - 1) +
        3 * ((1 - (1 / 32 : Real)) * C) * (1 / s) ^ d ≤
          3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) +
            3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1) :=
        add_le_add hfirst hsecond
      _ = 2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1)) := by ring
  calc
    ‖brrsPositiveRadialHalfWaveTestPacket Phi j referenceTime x‖ ≤
        ‖q ^ d‖ *
          (3 * ((1 - (1 / 32 : Real)) * C) /
            (Real.sqrt ((q * referenceTime) / 32)) ^ (d - 1) +
          3 * ((1 - (1 / 32 : Real)) * C) *
            (1 / (q * referenceTime)) ^ d) := by
      simpa only [q] using h
    _ ≤ ‖q ^ d‖ *
          (2 * (3 * ((1 - (1 / 32 : Real)) * C) / r ^ (d - 1))) :=
      mul_le_mul_of_nonneg_left hinner (norm_nonneg _)
    _ = 6 * ((1 - (1 / 32 : Real)) * C) * ‖q ^ d‖ /
          (Real.sqrt (q / 32)) ^ (d - 1) := by
      dsimp [r]
      field_simp [hrpowpos.ne']
      norm_num
    _ = 6 * ((1 - (1 / 32 : Real)) * C) * ‖((2 : Real) ^ j) ^ d‖ /
          (Real.sqrt (((2 : Real) ^ j / 32)) ^ (d - 1)) := by
      rfl

/-- The sum of the nine literal carrier profiles is uniformly bounded.  This
elementary fact supplies the integrable Schwartz majorant needed before the
outer radial triangle inequality is applied. -/
theorem brrsTwoRadiusNinePhaseProfile_le_nine
    (N : Nat) (r s t : Real) :
    brrsTwoRadiusNinePhaseProfile N r s t ≤ 9 := by
  unfold brrsTwoRadiusNinePhaseProfile
  have hoo := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hoi := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have hom := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hio := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hii := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have him := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  have hmo := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  have hmi := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  have hmm := brrsStationaryRapidProfile_le_one N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  linarith

/-- Measurability of the all-nine profile when the source radius varies
along the positive ray. -/
theorem measurable_brrsTwoRadiusNinePhaseProfile_source
    (N : Nat) (r q t : Real) :
    Measurable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t) := by
  have hphase (partR partS : BRRSSurfaceWavePart) :
      Measurable (fun s : Ioi (0 : Real) =>
        brrsSurfaceWavePhase partR r +
          brrsSurfaceWavePhase partS (q * s.1) + 2 * Real.pi * t) := by
    cases partR <;> cases partS <;>
      simp [brrsSurfaceWavePhase] <;> fun_prop
  unfold brrsTwoRadiusNinePhaseProfile
  repeat' apply Measurable.add
  all_goals
    exact (measurable_brrsStationaryRapidProfile N).comp (hphase _ _)

/-- The nine-profile source majorant is integrable against the radial trace
of a Schwartz datum.  Its proof uses only the uniform bound by nine and the
already established polar integrability of radial Schwartz functions. -/
theorem integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
    {d : Nat} (hd : 0 < d) (N : Nat) (r q t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    Integrable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hprofile : Measurable (fun s : Ioi (0 : Real) =>
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t) :=
    measurable_brrsTwoRadiusNinePhaseProfile_source N r q t
  refine (hinput.norm.const_mul (9 : Real)).mono'
    (hprofile.aestronglyMeasurable.mul hinput.norm.aestronglyMeasurable) ?_
  filter_upwards with s
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg
      (brrsTwoRadiusNinePhaseProfile_nonneg N r (q * s.1) t)
      (norm_nonneg _))]
  exact mul_le_mul_of_nonneg_right
    (brrsTwoRadiusNinePhaseProfile_le_nine N r (q * s.1) t)
    (norm_nonneg _)

/-- On a compact output radius, the literal all-nine outer source integral
is controlled by the two translated cubic source integrals and the one
middle-phase cubic tail.  No kernel hypothesis is added here: this is the
direct phase reduction of the actual all-nine profile. -/
theorem brrs_I0_ninePhase_outerIntegral_le_three_cubic
    {d : Nat} (hd : 3 ≤ d) (q r t : Real)
    (hr0 : 0 ≤ q * r) (hr : q * r ≤ 1)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t) *
        ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) ≤
      192 *
        ((∫ s : Ioi (0 : Real),
          brrsCubicJapaneseRealProfile (q * (t - s.1)) *
            ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) +
          (∫ s : Ioi (0 : Real),
            brrsCubicJapaneseRealProfile (q * (t + s.1)) *
              ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) +
            brrsCubicJapaneseRealProfile (q * t) *
              ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
                ∂Measure.volumeIoiPow (d - 1)) := by
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t)
  let Fminus : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖
  let Fplus : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖
  let Fmiddle : Ioi (0 : Real) → Real := fun s =>
    brrsCubicJapaneseRealProfile (q * t) * ‖f (s.1 • w)‖
  have hphase (s : Ioi (0 : Real)) :
      P s ≤ 192 * (brrsCubicJapaneseRealProfile (q * (t - s.1)) +
        brrsCubicJapaneseRealProfile (q * (t + s.1)) +
          brrsCubicJapaneseRealProfile (q * t)) := by
    dsimp only [P]
    convert brrsTwoRadiusNinePhaseProfile_I0_le_three_cubic
      (q * r) (q * s.1) (q * t) hr0 hr using 1 <;> ring
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow (by omega) f hf w hw
  have hminus : Integrable Fminus (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fminus]
    exact integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t - s.1)) (by fun_prop)
        f hf w hw
  have hplus : Integrable Fplus (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fplus]
    exact integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t + s.1)) (by fun_prop)
        f hf w hw
  have hmiddle : Integrable Fmiddle (Measure.volumeIoiPow (d - 1)) := by
    dsimp only [Fmiddle]
    exact hinput.norm.const_mul _
  have hR : Integrable (fun s : Ioi (0 : Real) =>
      192 * ((Fminus s + Fplus s) + Fmiddle s))
      (Measure.volumeIoiPow (d - 1)) :=
    ((hminus.add hplus).add hmiddle).const_mul 192
  have hpoint (s : Ioi (0 : Real)) :
      P s * ‖f (s.1 • w)‖ ≤
        192 * ((Fminus s + Fplus s) + Fmiddle s) := by
    have hnorm : 0 ≤ ‖f (s.1 • w)‖ := norm_nonneg _
    calc
      P s * ‖f (s.1 • w)‖ ≤
          (192 * (brrsCubicJapaneseRealProfile (q * (t - s.1)) +
            brrsCubicJapaneseRealProfile (q * (t + s.1)) +
              brrsCubicJapaneseRealProfile (q * t))) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hphase s) hnorm
      _ = 192 * ((Fminus s + Fplus s) + Fmiddle s) := by
        dsimp only [Fminus, Fplus, Fmiddle]
        ring
  change (∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) ≤ _
  calc
    (∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
        ∫ s : Ioi (0 : Real), 192 * ((Fminus s + Fplus s) + Fmiddle s)
          ∂Measure.volumeIoiPow (d - 1) :=
      integral_mono_of_nonneg
        (Filter.Eventually.of_forall fun s =>
          mul_nonneg (brrsTwoRadiusNinePhaseProfile_nonneg 3 _ _ _)
            (norm_nonneg _)) hR (Filter.Eventually.of_forall hpoint)
    _ = 192 * ((∫ s : Ioi (0 : Real), Fminus s
          ∂Measure.volumeIoiPow (d - 1)) +
        (∫ s : Ioi (0 : Real), Fplus s
          ∂Measure.volumeIoiPow (d - 1)) +
          brrsCubicJapaneseRealProfile (q * t) *
            ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
              ∂Measure.volumeIoiPow (d - 1)) := by
      rw [integral_const_mul]
      congr 1
      calc
        (∫ s : Ioi (0 : Real), (Fminus s + Fplus s) + Fmiddle s
            ∂Measure.volumeIoiPow (d - 1)) =
            (∫ s : Ioi (0 : Real), Fminus s + Fplus s
              ∂Measure.volumeIoiPow (d - 1)) +
              ∫ s : Ioi (0 : Real), Fmiddle s
                ∂Measure.volumeIoiPow (d - 1) := by
          simpa only [Pi.add_apply] using
            (integral_add (hminus.add hplus) hmiddle)
        _ = ((∫ s : Ioi (0 : Real), Fminus s
              ∂Measure.volumeIoiPow (d - 1)) +
            ∫ s : Ioi (0 : Real), Fplus s
              ∂Measure.volumeIoiPow (d - 1)) +
              brrsCubicJapaneseRealProfile (q * t) *
                ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
                  ∂Measure.volumeIoiPow (d - 1) := by
          rw [integral_add hminus hplus]
          dsimp only [Fmiddle]
          rw [integral_const_mul]

/-- Every vector in a positive-dimensional Euclidean space lies on a unit
ray, including the origin (where a fixed coordinate direction is chosen).
This lets radial stationary estimates stated on a ray become pointwise
estimates on the whole compact output ball. -/
theorem exists_unit_direction_eq_norm_smul
    {d : Nat} (hd : 0 < d) (x : BRRSSpace d) :
    ∃ v : BRRSSpace d, ‖v‖ = 1 ∧ x = ‖x‖ • v := by
  by_cases hx : x = 0
  · let i : Fin d := ⟨0, hd⟩
    let v : BRRSSpace d := EuclideanSpace.single i (1 : Real)
    refine ⟨v, ?_, ?_⟩
    · dsimp [v]
      simpa using (EuclideanSpace.norm_single i (1 : Real))
    · rw [hx, norm_zero, zero_smul]
  · let v : BRRSSpace d := ‖x‖⁻¹ • x
    have hxpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
    refine ⟨v, ?_, ?_⟩
    · dsimp [v]
      rw [norm_smul, Real.norm_eq_abs,
        abs_of_pos (inv_pos.mpr hxpos),
        inv_mul_cancel₀ hxpos.ne']
    · dsimp [v]
      rw [smul_smul, mul_inv_cancel₀ hxpos.ne', one_smul]

/-- On the compact output cell `I₀`, the exact dyadic half-wave is bounded
by the outer integral of its all-nine stationary phase profile.  The source
integral on the right is genuinely integrable for every radial Schwartz
datum; all nine endpoint and middle components remain present. -/
theorem exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_I0_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
        (((2 : Real) ^ j) * t)
  let B : Real := ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    exact integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
      (by omega) N (((2 : Real) ^ j) * r) ((2 : Real) ^ j)
        (((2 : Real) ^ j) * t) f hf w hw
  have hK (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        B * P s := by
    dsimp [B, P]
    simpa only [Real.norm_eq_abs, mul_assoc] using
      hkernel j r s.1 t hr0 hr s.2.le
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ ≤ B * (P s * ‖f (s.1 • w)‖) := by
    rw [norm_mul]
    calc
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ *
          ‖f (s.1 • w)‖ ≤ (B * P s) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hK s) (norm_nonneg _)
      _ = B * (P s * ‖f (s.1 • w)‖) := by ring
  rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    hd Phi j t f hf v w hv hw r hr0]
  calc
    ‖∫ s : Ioi (0 : Real),
        brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖ ≤
        ∫ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ s : Ioi (0 : Real), B * (P s * ‖f (s.1 • w)‖)
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact norm_nonneg _
      · exact hPint.const_mul B
      · filter_upwards with s
        exact hpoint s
    _ = B * ∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- Literal compact-source form of the initial-cell all-nine bound.  If the
radial trace vanishes once the scaled source radius exceeds `16`, then the
exact stationary integral for `brrsDyadicHalfWave` is supported on the
compact source region `0 < 2^j s ≤ 16`.  In particular, no uncontrolled
source tail is hidden in this `I₀` estimate. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      (∀ s : Ioi (0 : Real),
        16 < ((2 : Real) ^ j) * s.1 → f (s.1 • w) = 0) →
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in {s : Ioi (0 : Real) | ((2 : Real) ^ j) * s.1 ≤ 16},
          ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
            (ENNReal.ofReal ((1 - (1 / 32 : Real)) * C) *
              (ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t)) *
                ENNReal.ofReal ‖f (s.1 • w)‖))
          ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_lowLow_ninePhase_profile_le
      (d := d) (N := N) Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr hsupport
  let q : Real := (2 : Real) ^ j
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let R : Ioi (0 : Real) → ENNReal := fun s =>
    ENNReal.ofReal ‖q ^ d‖ *
      (ENNReal.ofReal Cfac *
        (ENNReal.ofReal (P s) * ENNReal.ofReal ‖f (s.1 • w)‖))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hCfac : 0 ≤ Cfac := by
    dsimp only [Cfac]
    positivity
  have hscaled : q * dyadicTimeScale j = 1 := by
    dsimp only [q, dyadicTimeScale]
    exact mul_inv_cancel₀ (pow_ne_zero j (by norm_num))
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqrone : q * r ≤ 1 := by
    calc
      q * r ≤ q * dyadicTimeScale j :=
        mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := hscaled
  have hqr : q * r ≤ 16 := by linarith
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have houtside (s : Ioi (0 : Real)) (hs : s ∉ S) :
      f (s.1 • w) = 0 := by
    apply hsupport s
    have hs' : ¬ q * s.1 ≤ 16 := by
      change ¬ q * s.1 ≤ 16 at hs
      exact hs
    exact lt_of_not_ge hs'
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ₑ ≤ S.indicator R s := by
    rw [enorm_mul, ← ofReal_norm, ← ofReal_norm]
    by_cases hs : s ∈ S
    · rw [Set.indicator_of_mem hs]
      have hs0 : 0 ≤ q * s.1 := mul_nonneg hq.le s.2.le
      have hslow : q * s.1 ≤ 16 := by
        change q * s.1 ≤ 16 at hs
        exact hs
      have hkernel' :
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
            ‖q ^ d‖ * (Cfac * P s) := by
        simpa only [q, Cfac, P] using
          hkernel j r s.1 t hqr0 hqr hs0 hslow
      have hmul := mul_le_mul_right (ENNReal.ofReal_le_ofReal hkernel')
        (ENNReal.ofReal ‖f (s.1 • w)‖)
      calc
        ENNReal.ofReal
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ *
            ENNReal.ofReal ‖f (s.1 • w)‖ =
            ENNReal.ofReal ‖f (s.1 • w)‖ *
              ENNReal.ofReal
                ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ := by
              ac_rfl
        _ ≤ ENNReal.ofReal ‖f (s.1 • w)‖ *
              ENNReal.ofReal (‖q ^ d‖ * (Cfac * P s)) := hmul
        _ = R s := by
          dsimp only [R]
          rw [ENNReal.ofReal_mul (norm_nonneg _), ENNReal.ofReal_mul hCfac]
          ac_rfl
    · rw [Set.indicator_of_notMem hs]
      simp [houtside s hs]
  have hmain :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ =
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖₊ := ofReal_norm _
      _ = ‖∫ s : Ioi (0 : Real),
          brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖₊ := by
        rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
          hd Phi j t f hf v w hv hw r hr0]
      _ ≤ ∫⁻ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) :=
        enorm_integral_le_lintegral_enorm _
  have hfinal :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in S, R s ∂Measure.volumeIoiPow (d - 1) := by
    calc
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
          ∫⁻ s : Ioi (0 : Real),
            ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
              f (s.1 • w)‖₊ ∂Measure.volumeIoiPow (d - 1) := hmain
      _ ≤ ∫⁻ s : Ioi (0 : Real), S.indicator R s
            ∂Measure.volumeIoiPow (d - 1) := lintegral_mono hpoint
      _ = ∫⁻ s in S, R s ∂Measure.volumeIoiPow (d - 1) :=
        lintegral_indicator hS R
  simpa only [q, S, P, Cfac, R] using hfinal

/-- The compact radial polar integral is exactly the Lebesgue integral of the
exponent-one source profile on the corresponding scaled interval.  This is
the measure-theoretic interface between the literal half-wave estimate and
the normalized-cubic convolution bound. -/
theorem brrs_lintegral_I0_compactSource_polar_eq_sourceProfile_one
    {d N : Nat} (hd : 2 ≤ d) {q r t : Real} (hq : 0 < q)
    (f : BRRSSchwartz d) (w : BRRSSpace d) :
    (∫⁻ s in {s : Ioi (0 : Real) | q * s.1 ≤ 16},
      ENNReal.ofReal
          (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) =
      ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
        ENNReal.ofReal
            (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) *
          brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w s := by
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let T : Set Real := Ioc (0 : Real) (16 * q⁻¹)
  let P : Real → ENNReal := fun s =>
    ENNReal.ofReal
      (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t))
  let F : Real → ENNReal := fun s => P s * ENNReal.ofReal ‖f (s • w)‖
  let Fcut : Real → ENNReal := T.indicator F
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have hT : MeasurableSet T := measurableSet_Ioc
  have hTsub : T ⊆ Ioi (0 : Real) := by
    intro s hs
    exact hs.1
  have hmem (s : Ioi (0 : Real)) : s ∈ S ↔ s.1 ∈ T := by
    dsimp only [S, T]
    constructor
    · intro hs
      refine ⟨s.2, ?_⟩
      rw [show 16 * q⁻¹ = 16 / q by rw [div_eq_mul_inv]]
      apply (le_div_iff₀ hq).2
      change q * s.1 ≤ 16 at hs
      simpa only [mul_comm] using hs
    · rintro ⟨_, hs⟩
      rw [show 16 * q⁻¹ = 16 / q by rw [div_eq_mul_inv]] at hs
      have hs' : s.1 * q ≤ 16 := (le_div_iff₀ hq).1 hs
      change q * s.1 ≤ 16
      simpa only [mul_comm] using hs'
  have hP : Measurable P := by
    have hphase (partR partS : BRRSSurfaceWavePart) :
        Measurable (fun s : Real =>
          brrsSurfaceWavePhase partR (q * r) +
            brrsSurfaceWavePhase partS (q * s) + 2 * Real.pi * (q * t)) := by
      cases partR <;> cases partS <;>
        simp [brrsSurfaceWavePhase] <;> fun_prop
    have hsum : Measurable (fun s : Real =>
        brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) := by
      unfold brrsTwoRadiusNinePhaseProfile
      repeat' apply Measurable.add
      all_goals
        exact (measurable_brrsStationaryRapidProfile N).comp (hphase _ _)
    dsimp only [P]
    exact ENNReal.continuous_ofReal.measurable.comp hsum
  have hnorm : Measurable (fun s : Real => ENNReal.ofReal ‖f (s • w)‖) := by
    exact (f.continuous.measurable.comp
      (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal
  have hF : Measurable F := hP.mul hnorm
  have hFcut : Measurable Fcut := hF.indicator hT
  calc
    (∫⁻ s in {s : Ioi (0 : Real) | q * s.1 ≤ 16},
      ENNReal.ofReal
          (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)) =
        ∫⁻ s : Ioi (0 : Real), S.indicator (fun s => F s.1) s
          ∂Measure.volumeIoiPow (d - 1) := by
          rw [lintegral_indicator hS]
    _ = ∫⁻ s : Ioi (0 : Real), Fcut s.1
          ∂Measure.volumeIoiPow (d - 1) := by
          apply lintegral_congr
          intro s
          by_cases hs : s ∈ S
          · have hsT : s.1 ∈ T := (hmem s).1 hs
            dsimp only [Fcut]
            rw [Set.indicator_of_mem hs, Set.indicator_of_mem hsT]
          · have hsT : s.1 ∉ T := fun h => hs ((hmem s).2 h)
            dsimp only [Fcut]
            rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem hsT]
    _ = ∫⁻ s in Ioi (0 : Real),
          ENNReal.ofReal s ^ (d - 1) * Fcut s :=
        Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow
          (d - 1) Fcut hFcut
    _ = ∫⁻ s in Ioi (0 : Real),
          T.indicator (fun s => ENNReal.ofReal s ^ (d - 1) * F s) s := by
          apply setLIntegral_congr_fun measurableSet_Ioi
          intro s _hs
          by_cases hsT : s ∈ T <;> simp [Fcut, hsT]
    _ = ∫⁻ s in T, ENNReal.ofReal s ^ (d - 1) * F s := by
          rw [lintegral_indicator hT]
          change ∫⁻ s : Real, ENNReal.ofReal s ^ (d - 1) * F s ∂
              (volume.restrict (Ioi (0 : Real))).restrict T = _
          rw [Measure.restrict_restrict hT]
          rw [inter_eq_left.mpr hTsub]
    _ = ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
              (brrsTwoRadiusNinePhaseProfile N (q * r) (q * s) (q * t)) *
            brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s := by
          apply setLIntegral_congr_fun hT
          intro s hs
          dsimp only [F, P]
          rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega)
            (f : BRRSSpace d → Complex) w hs.1]
          ac_rfl

/-- Literal compact-source initial-cell estimate in normalized-cubic form.
This composes the exact stationary representation of the BRRS half-wave with
the compact radial polar-density identity and the all-nine cubic convolution
estimate.  All dyadic and polar prefactors are retained explicitly. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_normalizedCubic_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      0 ≤ r → r ≤ dyadicTimeScale j →
      (∀ s : Ioi (0 : Real),
        16 < ((2 : Real) ^ j) * s.1 → f (s.1 • w) = 0) →
      ENNReal.ofReal ((2 : Real) ^ j) *
          ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        (ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C)) *
          (192 *
            (brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                  (brrsRadialLpSourceProfile (d := d) 1
                    (f : BRRSSpace d → Complex) w)) t +
              brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsReflectProfile
                  (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                    (brrsRadialLpSourceProfile (d := d) 1
                      (f : BRRSSpace d → Complex) w))) t +
                brrsNormalizedScaledCubicProfile ((2 : Real) ^ j) t *
                  ∫⁻ s : Real,
                    brrsI0CompactSourceProfile ((2 : Real) ^ j)
                      (brrsRadialLpSourceProfile (d := d) 1
                        (f : BRRSSpace d → Complex) w) s)) := by
  obtain ⟨C, hC, hbridge⟩ :=
    exists_ennreal_norm_brrsDyadicHalfWave_I0_supported_compact_le
      (d := d) (N := 3) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr0 hr hsupport
  let q : Real := (2 : Real) ^ j
  let S : Set (Ioi (0 : Real)) := {s | q * s.1 ≤ 16}
  let Cfac : Real := (1 - (1 / 32 : Real)) * C
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let F : Ioi (0 : Real) → ENNReal := fun s =>
    ENNReal.ofReal
      (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t)) *
        ENNReal.ofReal ‖f (s.1 • w)‖
  let B : ENNReal := ENNReal.ofReal ‖q ^ d‖ * ENNReal.ofReal Cfac
  let Z : ENNReal :=
    brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
        (brrsI0CompactSourceProfile q g) t +
      brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q)
        (brrsReflectProfile (brrsI0CompactSourceProfile q g)) t +
        brrsNormalizedScaledCubicProfile q t *
          ∫⁻ s : Real, brrsI0CompactSourceProfile q g s
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hscaled : q * dyadicTimeScale j = 1 := by
    dsimp only [q, dyadicTimeScale]
    exact mul_inv_cancel₀ (pow_ne_zero j (by norm_num))
  have hqr0 : 0 ≤ q * r := mul_nonneg hq.le hr0
  have hqr : q * r ≤ 1 := by
    calc
      q * r ≤ q * dyadicTimeScale j :=
        mul_le_mul_of_nonneg_left hr hq.le
      _ = 1 := hscaled
  have hS : MeasurableSet S := by
    dsimp only [S]
    exact (continuous_const.mul continuous_subtype_val).measurable measurableSet_Iic
  have hphase : Measurable (fun s : Ioi (0 : Real) =>
      ENNReal.ofReal
        (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s.1) (q * t))) :=
    (measurable_brrsTwoRadiusNinePhaseProfile_source 3 (q * r) q (q * t)).ennreal_ofReal
  have hnorm : Measurable (fun s : Ioi (0 : Real) =>
      ENNReal.ofReal ‖f (s.1 • w)‖) := by
    fun_prop
  have hF : Measurable F := hphase.mul hnorm
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hbridge' :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ∫⁻ s in S,
          ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
          ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [q, S, Cfac, F] using
      hbridge j r t f hf v w hv hw hr0 hr hsupport
  have hfactor :
      (∫⁻ s in S,
        ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
        ∂Measure.volumeIoiPow (d - 1)) =
        B * ∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1) := by
    rw [← lintegral_const_mul B hF]
    apply setLIntegral_congr_fun hS
    intro s _hs
    dsimp only [B]
    ac_rfl
  have hpolar :
      (∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1)) =
        ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
          ENNReal.ofReal
              (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
            g s := by
    simpa only [S, F, g] using
      (brrs_lintegral_I0_compactSource_polar_eq_sourceProfile_one
        (d := d) (N := 3) (by omega) hq f w)
  have hcubic :
      ENNReal.ofReal q *
          (∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
            ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
              g s) ≤ 192 * Z := by
    simpa only [Z] using
      (brrs_I0_ninePhase_compactSource_lintegral_normalizedCubic_le
        hq hqr0 hqr g hg)
  calc
    ENNReal.ofReal ((2 : Real) ^ j) *
        ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ =
        ENNReal.ofReal q *
          ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ := by rfl
    _ ≤ ENNReal.ofReal q *
          (∫⁻ s in S,
            ENNReal.ofReal ‖q ^ d‖ * (ENNReal.ofReal Cfac * F s)
            ∂Measure.volumeIoiPow (d - 1)) :=
      by simpa only [mul_comm] using
        (mul_le_mul_left hbridge' (ENNReal.ofReal q))
    _ = B * (ENNReal.ofReal q *
          ∫⁻ s in S, F s ∂Measure.volumeIoiPow (d - 1)) := by
      rw [hfactor]
      ring
    _ = B * (ENNReal.ofReal q *
          ∫⁻ s in Ioc (0 : Real) (16 * q⁻¹),
            ENNReal.ofReal
                (brrsTwoRadiusNinePhaseProfile 3 (q * r) (q * s) (q * t)) *
              g s) := by rw [hpolar]
    _ ≤ B * (192 * Z) := by
      simpa only [mul_comm] using (mul_le_mul_left hcubic B)
    _ =
        (ENNReal.ofReal ‖((2 : Real) ^ j) ^ d‖ *
          ENNReal.ofReal ((1 - (1 / 32 : Real)) * C)) * (192 *
            (brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                  (brrsRadialLpSourceProfile (d := d) 1
                    (f : BRRSSpace d → Complex) w)) t +
              brrsOneDimProfileConvolution
                (brrsNormalizedScaledCubicProfile ((2 : Real) ^ j))
                (brrsReflectProfile
                  (brrsI0CompactSourceProfile ((2 : Real) ^ j)
                    (brrsRadialLpSourceProfile (d := d) 1
                      (f : BRRSSpace d → Complex) w))) t +
                brrsNormalizedScaledCubicProfile ((2 : Real) ^ j) t *
                  ∫⁻ s : Real,
                    brrsI0CompactSourceProfile ((2 : Real) ^ j)
                      (brrsRadialLpSourceProfile (d := d) 1
                        (f : BRRSSpace d → Complex) w) s)) := by
      rfl

/-- Pointwise ball form of the compact-cell all-nine majorant.  Unlike the
ray version, this statement applies directly to every physical-space point
whose radius lies in `I₀`; its right-hand side is the genuinely integrable
outer radial source integral from the preceding theorem. -/
theorem exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le_at_point
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 →
      ‖x‖ ≤ dyadicTimeScale j →
      ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * ‖x‖) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j t f hf x w hw hx
  obtain ⟨v, hv, hxray⟩ :=
    exists_unit_direction_eq_norm_smul (show 0 < d by omega) x
  calc
    ‖brrsDyadicHalfWave Phi j t f x‖ =
        ‖brrsDyadicHalfWave Phi j t f (‖x‖ • v)‖ :=
      congrArg (fun z : BRRSSpace d => ‖brrsDyadicHalfWave Phi j t f z‖) hxray
    _ ≤ ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N
              (((2 : Real) ^ j) * ‖x‖) (((2 : Real) ^ j) * s.1)
                (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) :=
      hbound j ‖x‖ t f hf v w hv hw (norm_nonneg _) hx

/-- Literal compact-cell pointwise bridge: the actual BRRS dyadic half-wave
is controlled by the three cubic local-time profiles (negative source,
positive source, and middle tail).  All source terms are the normalized
radial `L¹` profile of the given Schwartz datum. -/
theorem exists_ennreal_norm_brrsDyadicHalfWave_I0_threeCubicProfile_le
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 →
      ‖x‖ ≤ dyadicTimeScale j →
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        (ENNReal.ofReal
          (192 * (‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)))) *
          brrsI0ThreeCubicProfile ((2 : Real) ^ j)
            (brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w)
            (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s) t := by
  obtain ⟨C, hC, houter⟩ :=
    exists_norm_brrsDyadicHalfWave_I0_ninePhase_outerIntegral_le_at_point
      (d := d) (N := 3) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j t f hf x w hw hx
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let M : ENNReal := ∫⁻ s : Real, g s
  let A : Real := ‖q ^ d‖ * ((1 - (1 / 32 : Real)) * C)
  let Jminus : Real := ∫ s : Ioi (0 : Real),
    brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let Jplus : Real := ∫ s : Ioi (0 : Real),
    brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let Jmiddle : Real := brrsCubicJapaneseRealProfile (q * t) *
    ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hqr0 : 0 ≤ q * ‖x‖ := mul_nonneg hq.le (norm_nonneg _)
  have hqr : q * ‖x‖ ≤ 1 := by
    change ‖x‖ ≤ q⁻¹ at hx
    calc
      q * ‖x‖ ≤ q * q⁻¹ := mul_le_mul_of_nonneg_left hx hq.le
      _ = 1 := mul_inv_cancel₀ hq.ne'
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact mul_nonneg (norm_nonneg _)
      (mul_nonneg (by norm_num) hC.le)
  have houter' : ‖brrsDyadicHalfWave Phi j t f x‖ ≤ A *
      ∫ s : Ioi (0 : Real),
        brrsTwoRadiusNinePhaseProfile 3 (q * ‖x‖) (q * s.1) (q * t) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) := by
    simpa only [q, A] using houter j t f hf x w hw hx
  have hphase := brrs_I0_ninePhase_outerIntegral_le_three_cubic hd
    q ‖x‖ t hqr0 hqr f hf w hw
  have hreal : ‖brrsDyadicHalfWave Phi j t f x‖ ≤
      (192 * A) * (Jminus + Jplus + Jmiddle) := by
    calc
      ‖brrsDyadicHalfWave Phi j t f x‖ ≤ A *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile 3 (q * ‖x‖) (q * s.1) (q * t) *
              ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) := houter'
      _ ≤ A * (192 * (Jminus + Jplus + Jmiddle)) := by
        apply mul_le_mul_of_nonneg_left _ hA
        simpa only [Jminus, Jplus, Jmiddle] using hphase
      _ = (192 * A) * (Jminus + Jplus + Jmiddle) := by ring
  have hJminus : 0 ≤ Jminus := by
    dsimp only [Jminus]
    exact integral_nonneg fun s =>
      mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _)
  have hJplus : 0 ≤ Jplus := by
    dsimp only [Jplus]
    exact integral_nonneg fun s =>
      mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _)
  have hJmiddle : 0 ≤ Jmiddle := by
    dsimp only [Jmiddle]
    exact mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _)
      (integral_nonneg fun s => norm_nonneg _)
  have hminus : brrsI0ScaledCubicConvolution q g t = ENNReal.ofReal Jminus := by
    dsimp only [g, Jminus]
    exact brrsI0ScaledCubicConvolution_sourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw q t
  have hplus : brrsI0ScaledCubicConvolution q (brrsReflectProfile g) t =
      ENNReal.ofReal Jplus := by
    dsimp only [g, Jplus]
    exact brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw q t
  have hmass : M = ENNReal.ofReal
      (∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) := by
    dsimp only [M, g]
    exact brrs_lintegral_radialLpSourceProfile_one_eq_ofReal_integral
      (by omega) f hf w hw
  have hmiddle : brrsI0CubicTailProfile q M t = ENNReal.ofReal Jmiddle := by
    dsimp only [brrsI0CubicTailProfile, Jmiddle]
    rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
    unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
    rw [hmass]
  calc
    ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f x‖ ≤
        ENNReal.ofReal ((192 * A) * (Jminus + Jplus + Jmiddle)) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (192 * A) *
        ((ENNReal.ofReal Jminus + ENNReal.ofReal Jplus) +
          ENNReal.ofReal Jmiddle) := by
      rw [ENNReal.ofReal_mul (mul_nonneg (by norm_num) hA),
        ENNReal.ofReal_add (add_nonneg hJminus hJplus) hJmiddle,
        ENNReal.ofReal_add hJminus hJplus]
    _ = ENNReal.ofReal (192 * A) *
        brrsI0ThreeCubicProfile q g M t := by
      rw [← hminus, ← hplus, ← hmiddle]
      rfl
    _ = (ENNReal.ofReal (192 *
          (‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C)))) *
          (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
            (brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w)
            (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
              (f : BRRSSpace d → Complex) w s) t) := by
      rfl

/-- Actual compact-cell radial `p`-moment estimate for the BRRS dyadic
half-wave.  It combines the literal all-nine phase reduction with the
bounded-overlap `I₀` profile, and is valid for every nonnegative real
power.  The source profile here is the genuinely obtained radial `L¹`
profile; obtaining the sharp BRRS low-`p` rate requires a further weighted
source-profile estimate. -/
theorem exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_threeCubicProfile
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ p : Real, 0 ≤ p →
      ∀ j : Nat, ∀ E : Set Real, ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
        (ENNReal.ofReal r) ^ (d - 1) *
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 * ∫⁻ x : Real,
          ((∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1)) *
            (ENNReal.ofReal
              (192 * (‖((2 : Real) ^ j) ^ d‖ *
                ((1 - (1 / 32 : Real)) * C)))) ^ p) *
            ((((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j)) *
              (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
                (brrsRadialLpSourceProfile (d := d) 1
                  (f : BRRSSpace d → Complex) w)
                (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
                  (f : BRRSSpace d → Complex) w s) x) ^ p)) := by
  obtain ⟨C, hC, hhalf⟩ :=
    exists_ennreal_norm_brrsDyadicHalfWave_I0_threeCubicProfile_le hd Phi
  refine ⟨C, hC, ?_⟩
  intro p hp j E T hT f hf v w hv hw
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let M : ENNReal := ∫⁻ s : Real, g s
  let K : ENNReal := ENNReal.ofReal
    (192 * (‖q ^ d‖ * ((1 - (1 / 32 : Real)) * C)))
  let W : ENNReal := ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
    (ENNReal.ofReal r) ^ (d - 1)
  let A : ENNReal := W * K ^ p
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  let H : Real → Real → ENNReal := fun t r =>
    (ENNReal.ofReal r) ^ (d - 1) *
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hweight : Measurable (fun r : Real =>
      (ENNReal.ofReal r) ^ (d - 1)) :=
    ENNReal.continuous_ofReal.measurable.pow_const (d - 1)
  have hhalfpoint (t r : Real) (hr : r ∈ Icc (0 : Real) (dyadicTimeScale j)) :
      ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤ K * F t := by
    have hnorm : ‖r • v‖ = r := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr.1, hv, mul_one]
    have hradial : ‖r • v‖ ≤ dyadicTimeScale j := by
      rw [hnorm]
      exact hr.2
    have hbound := hhalf j t f hf (r • v) w hw hradial
    simpa only [q, g, M, K, F] using hbound
  have hpointp (t r : Real) (hr : r ∈ Icc (0 : Real) (dyadicTimeScale j)) :
      (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p ≤
        K ^ p * F t ^ p := by
    have hpow := ENNReal.rpow_le_rpow (hhalfpoint t r hr) hp
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp] at hpow
    exact hpow
  have hcontrol (t : Real) (_ht : t ∈ T) :
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t ^ p := by
    calc
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
          ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
            (ENNReal.ofReal r) ^ (d - 1) * (K ^ p * F t ^ p) := by
        apply setLIntegral_mono' measurableSet_Icc
        intro r hr
        dsimp only [H]
        simpa only [mul_comm] using
          (mul_le_mul_left (hpointp t r hr)
            ((ENNReal.ofReal r) ^ (d - 1)))
      _ = W * (K ^ p * F t ^ p) := by
        dsimp only [W]
        calc
          (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1) * (K ^ p * F t ^ p)) =
              ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
                (K ^ p * F t ^ p) * (ENNReal.ofReal r) ^ (d - 1) := by
            apply setLIntegral_congr_fun measurableSet_Icc
            intro r hr
            ring
          _ = (K ^ p * F t ^ p) *
              ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
                (ENNReal.ofReal r) ^ (d - 1) := by
            exact lintegral_const_mul (K ^ p * F t ^ p) hweight
          _ = W * (K ^ p * F t ^ p) := by
            dsimp only [W]
            ring
      _ = A * F t ^ p := by
        dsimp only [A]
        ring
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, A * (c * F x ^ p)
  simpa only [q, g, M, A, F, c] using
    (brrs_sum_dyadicI0_lintegral_le_of_threeCubic_rpow_control j T hT H A M p hp
      hg hcontrol)

/-- Assembly interface for the actual compact-cell radial `I₀` moment.
It separates the geometric half-wave reduction from the remaining scalar
source-profile estimate: any stated full-line `p`-moment bound for the
three-cubic profile yields the corresponding sampled radial half-wave bound,
with every dyadic and radial-volume factor displayed explicitly.  This is not
the BRRS low-`p` proposition itself. -/
theorem exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_of_threeCubicProfile_moment
    {d : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ p : Real, 0 ≤ p →
      ∀ j : Nat, ∀ E : Set Real, ∀ T : Finset Real,
      IsDyadicDiscretization E j T →
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      ∀ B : ENNReal,
      (∫⁻ x : Real,
        (brrsI0ThreeCubicProfile ((2 : Real) ^ j)
          (brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w)
          (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
            (f : BRRSSpace d → Complex) w s) x) ^ p) ≤ B →
      (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
        (ENNReal.ofReal r) ^ (d - 1) *
          (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 *
          ((((∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1)) *
            (ENNReal.ofReal
              (192 * (‖((2 : Real) ^ j) ^ d‖ *
                ((1 - (1 / 32 : Real)) * C)))) ^ p) *
            ((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j))) * B) := by
  obtain ⟨C, hC, hI0⟩ :=
    exists_brrsDyadicHalfWave_I0_radial_rpow_sum_le_threeCubicProfile hd Phi
  refine ⟨C, hC, ?_⟩
  intro p hp j E T hT f hf v w hv hw B hprofile
  let q : Real := (2 : Real) ^ j
  let g : Real → ENNReal := brrsRadialLpSourceProfile (d := d) 1
    (f : BRRSSpace d → Complex) w
  let M : ENNReal := ∫⁻ s : Real, g s
  let W : ENNReal := ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
    (ENNReal.ofReal r) ^ (d - 1)
  let K : ENNReal := ENNReal.ofReal
    (192 * (‖q ^ d‖ * ((1 - (1 / 32 : Real)) * C)))
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  have hg : Measurable g := by
    dsimp only [g]
    exact measurable_brrsRadialLpSourceProfile 1
      (f : BRRSSpace d → Complex) f.continuous.measurable w
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hFp : Measurable (fun x : Real => F x ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  have hliteral := hI0 p hp j E T hT f hf v w hv hw
  have hintegral :
      (∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p)) =
        (W * K ^ p * c) * ∫⁻ x : Real, F x ^ p := by
    calc
      (∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p)) =
          ∫⁻ x : Real, (W * K ^ p * c) * F x ^ p := by
            apply lintegral_congr
            intro x
            ring
      _ = (W * K ^ p * c) * ∫⁻ x : Real, F x ^ p := by
            exact lintegral_const_mul (W * K ^ p * c) hFp
  have hprofile' : (∫⁻ x : Real, F x ^ p) ≤ B := by
    simpa only [q, g, M, F] using hprofile
  calc
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
      (ENNReal.ofReal r) ^ (d - 1) *
        (ENNReal.ofReal ‖brrsDyadicHalfWave Phi j t f (r • v)‖) ^ p) ≤
        17 * ∫⁻ x : Real, (W * K ^ p) * (c * F x ^ p) := by
          simpa only [q, g, M, W, K, c, F] using hliteral
    _ = 17 * ((W * K ^ p * c) * ∫⁻ x : Real, F x ^ p) := by
          rw [hintegral]
    _ ≤ 17 * ((W * K ^ p * c) * B) := by
          simpa only [mul_comm, mul_left_comm, mul_assoc] using
            (mul_le_mul_left
              (mul_le_mul_left hprofile' (W * K ^ p * c)) 17)
    _ = 17 *
          ((((∫⁻ r in Icc (0 : Real) (dyadicTimeScale j),
              (ENNReal.ofReal r) ^ (d - 1)) *
            (ENNReal.ofReal
              (192 * (‖((2 : Real) ^ j) ^ d‖ *
                ((1 - (1 / 32 : Real)) * C)))) ^ p) *
            ((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j))) * B) := by
          rfl

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### Disjoint-shell lower summation for sharpness packets -/

namespace Auto.Spherical.FractalDilations.BRRS

open Set MeasureTheory

/-- Radial shells are Borel sets, so their positive `L^p` masses can be
summed exactly over a finite disjoint packet. -/
theorem measurableSet_brrsRadialShell (d : Nat) (radius width : Real) :
    MeasurableSet (brrsRadialShell d radius width) := by
  unfold brrsRadialShell
  change MeasurableSet ((fun x : BRRSSpace d => |‖x‖ - radius|) ⁻¹' Iio width)
  exact measurableSet_preimage
    ((continuous_norm.sub continuous_const).abs.measurable) measurableSet_Iio

theorem measurableSet_brrsTimeRadialShell
    (d : Nat) (referenceTime t width : Real) :
    MeasurableSet (brrsTimeRadialShell d referenceTime t width) := by
  unfold brrsTimeRadialShell
  exact measurableSet_brrsRadialShell d |t - referenceTime| width

/-- The sum of the radial `L^p` masses of one function on pairwise disjoint
time shells is bounded by its full `L^p` mass.  This is the measure-theoretic
aggregation step used after a per-shell lower bound for a sharpness packet. -/
theorem sum_brrsTimeRadialShell_lintegral_rpow_le_lintegral
    {d : Nat} (U : Finset Real) (referenceTime width p : Real)
    (F : BRRSSpace d → Complex)
    (hdisjoint : (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsTimeRadialShell d referenceTime t width)) :
    (∑ t ∈ U, ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
      (ENNReal.ofReal ‖F x‖) ^ p) ≤
      ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖F x‖) ^ p := by
  let G : BRRSSpace d → ENNReal := fun x => (ENNReal.ofReal ‖F x‖) ^ p
  have hmeas : ∀ t ∈ U,
      MeasurableSet (brrsTimeRadialShell d referenceTime t width) := by
    intro t ht
    exact measurableSet_brrsTimeRadialShell d referenceTime t width
  change (∑ t ∈ U, ∫⁻ x in brrsTimeRadialShell d referenceTime t width, G x) ≤
    ∫⁻ x : BRRSSpace d, G x
  rw [← lintegral_biUnion_finset hdisjoint hmeas G]
  exact setLIntegral_le_lintegral _ _

/-- A family of per-time lower shell estimates adds without loss on disjoint
shells.  The lower profile `a` is deliberately arbitrary, making this lemma
directly reusable with the stationary kernel lower bound expected in the
general-`p` BRRS sharpness argument. -/
theorem sum_brrsTimeRadialShell_lower_le_lintegral_rpow
    {d : Nat} (U : Finset Real) (referenceTime width p : Real)
    (F : BRRSSpace d → Complex) (a : Real → ENNReal)
    (hdisjoint : (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsTimeRadialShell d referenceTime t width))
    (hlower : ∀ t ∈ U, a t ≤
      ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
        (ENNReal.ofReal ‖F x‖) ^ p) :
    (∑ t ∈ U, a t) ≤ ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖F x‖) ^ p := by
  calc
    (∑ t ∈ U, a t) ≤
        ∑ t ∈ U, ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
          (ENNReal.ofReal ‖F x‖) ^ p := by
      apply Finset.sum_le_sum
      intro t ht
      exact hlower t ht
    _ ≤ ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖F x‖) ^ p :=
      sum_brrsTimeRadialShell_lintegral_rpow_le_lintegral
        U referenceTime width p F hdisjoint

/-- A literal pointwise lower bound on one time shell yields its `L^p`
mass lower bound.  This has no regularity assumption on the function: shell
measurability is sufficient for monotonicity of the restricted lintegral. -/
theorem brrsTimeRadialShell_lintegral_rpow_lower_of_pointwise
    {d : Nat} (referenceTime t width c p : Real)
    (F : BRRSSpace d → Complex) (hp : 0 ≤ p)
    (hlower : ∀ x : BRRSSpace d,
      x ∈ brrsTimeRadialShell d referenceTime t width → c ≤ ‖F x‖) :
    (ENNReal.ofReal c) ^ p * volume
        (brrsTimeRadialShell d referenceTime t width) ≤
      ∫⁻ x in brrsTimeRadialShell d referenceTime t width,
        (ENNReal.ofReal ‖F x‖) ^ p := by
  rw [← setLIntegral_const]
  apply setLIntegral_mono'
    (measurableSet_brrsTimeRadialShell d referenceTime t width)
  intro x hx
  exact ENNReal.rpow_le_rpow
    (ENNReal.ofReal_le_ofReal (hlower x hx)) hp

/-- Pointwise lower bounds on a common sharpness packet over pairwise
disjoint shells aggregate directly into one global `L^p` lower bound. -/
theorem sum_brrsTimeRadialShell_pointwise_lower_le_lintegral_rpow
    {d : Nat} (U : Finset Real) (referenceTime width p : Real)
    (F : BRRSSpace d → Complex) (c : Real → Real) (hp : 0 ≤ p)
    (hdisjoint : (↑U : Set Real).PairwiseDisjoint
      (fun t => brrsTimeRadialShell d referenceTime t width))
    (hlower : ∀ t ∈ U, ∀ x : BRRSSpace d,
      x ∈ brrsTimeRadialShell d referenceTime t width → c t ≤ ‖F x‖) :
    (∑ t ∈ U, (ENNReal.ofReal (c t)) ^ p * volume
      (brrsTimeRadialShell d referenceTime t width)) ≤
      ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖F x‖) ^ p := by
  apply sum_brrsTimeRadialShell_lower_le_lintegral_rpow
    U referenceTime width p F
    (fun t => (ENNReal.ofReal (c t)) ^ p * volume
      (brrsTimeRadialShell d referenceTime t width)) hdisjoint
  intro t ht
  exact brrsTimeRadialShell_lintegral_rpow_lower_of_pointwise
    referenceTime t width (c t) p F hp (hlower t ht)

/-- The zero-relative-time shell is an ordinary open ball and hence has
strictly positive Euclidean volume. -/
theorem volume_brrsTimeRadialShell_reference_pos
    {d : Nat} (referenceTime width : Real) (hwidth : 0 < width) :
    0 < volume (brrsTimeRadialShell d referenceTime referenceTime width) := by
  have hshell : brrsTimeRadialShell d referenceTime referenceTime width =
      Metric.ball (0 : BRRSSpace d) width := by
    ext x
    change abs (‖x‖ - abs (referenceTime - referenceTime)) < width ↔
      dist x 0 < width
    rw [sub_self, abs_zero, sub_zero, abs_of_nonneg (norm_nonneg x),
      dist_zero_right]
  rw [hshell]
  exact Metric.measure_ball_pos volume 0 hwidth

/-- For every positive exponent, the actual positive `TT*` packet has
strictly positive `L^p` mass on a nontrivial shell at its reference time.
This is the literal zero-relative-time lower bound; extending it to the
remote shells in a BRRS packet is precisely the remaining cone-asymptotic
step. -/
theorem exists_brrsPositiveRadialTestPacket_reference_shell_lintegral_rpow_pos
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat)
    (referenceTime p : Real) (hp : 0 < p) :
    ∃ width : Real, 0 < width ∧
      0 < ∫⁻ x in brrsTimeRadialShell d referenceTime referenceTime width,
        (ENNReal.ofReal ‖brrsDyadicHalfWave (d := d) Phi j referenceTime
          (brrsPositiveRadialHalfWaveTestPacket (d := d) Phi j referenceTime) x‖) ^ p := by
  obtain ⟨width, c, hwidth, hc, hlower⟩ :=
    exists_brrsPositiveRadialTestPacket_reference_shell_lower hd Phi j referenceTime
  refine ⟨width, hwidth, ?_⟩
  have hvol : 0 < volume
      (brrsTimeRadialShell d referenceTime referenceTime width) :=
    volume_brrsTimeRadialShell_reference_pos referenceTime width hwidth
  have hmass := brrsTimeRadialShell_lintegral_rpow_lower_of_pointwise
    referenceTime referenceTime width c p
    (brrsDyadicHalfWave (d := d) Phi j referenceTime
      (brrsPositiveRadialHalfWaveTestPacket (d := d) Phi j referenceTime)) hp.le hlower
  have hbase : 0 < (ENNReal.ofReal c) ^ p * volume
      (brrsTimeRadialShell d referenceTime referenceTime width) := by
    apply ENNReal.mul_pos
    · exact (ENNReal.rpow_pos_of_nonneg (ENNReal.ofReal_pos.2 hc) hp.le).ne'
    · exact hvol.ne'
  exact lt_of_lt_of_le hbase hmass

/-! ### Persistence of cone lower bounds on radial shells

A stationary-phase calculation is normally first obtained at a single point
on the cone.  The sharpness argument, however, needs a positive spatial
`L^p` mass on a shell.  The following elementary bridge makes that passage
literal.  Continuity supplies a ball on which a quantitative lower bound
persists, and the reverse triangle inequality places that ball inside the
radial shell with the same centre radius.  In particular, no unproved
``pointwise implies shell'' principle is hidden in the later cone argument.
-/

/-- A metric ball about a point is contained in the radial shell centred at
that point's radius, with the same width. -/
theorem metricBall_subset_brrsRadialShell
    {d : Nat} (x : BRRSSpace d) (width : Real) :
    Metric.ball x width ⊆ brrsRadialShell d ‖x‖ width := by
  intro y hy
  change |‖y‖ - ‖x‖| < width
  have hy' : dist y x < width := by
    simpa only [Metric.mem_ball] using hy
  calc
    |‖y‖ - ‖x‖| ≤ ‖y - x‖ := abs_norm_sub_norm_le _ _
    _ = dist y x := by rw [dist_eq_norm_sub]
    _ < width := hy'

/-- A point on a BRRS time shell supplies a concrete ball contained in that
shell.  This is the reusable geometric witness for shell volume lower bounds.
-/
theorem metricBall_subset_brrsTimeRadialShell_of_norm_eq
    {d : Nat} (referenceTime t width : Real) (x : BRRSSpace d)
    (hx : ‖x‖ = |t - referenceTime|) :
    Metric.ball x width ⊆ brrsTimeRadialShell d referenceTime t width := by
  simpa only [brrsTimeRadialShell, hx] using
    (metricBall_subset_brrsRadialShell x width)

/-- A time shell has at least the volume of any metric ball centred on its
central radius. -/
theorem volume_metricBall_le_volume_brrsTimeRadialShell_of_norm_eq
    {d : Nat} (referenceTime t width : Real) (x : BRRSSpace d)
    (hx : ‖x‖ = |t - referenceTime|) :
    volume (Metric.ball x width) ≤
      volume (brrsTimeRadialShell d referenceTime t width) := by
  exact measure_mono
    (metricBall_subset_brrsTimeRadialShell_of_norm_eq referenceTime t width x hx)

/-- Positive-width time shells have positive volume whenever a point on their
central radius is supplied. -/
theorem volume_brrsTimeRadialShell_pos_of_norm_eq
    {d : Nat} (referenceTime t width : Real) (x : BRRSSpace d)
    (hx : ‖x‖ = |t - referenceTime|) (hwidth : 0 < width) :
    0 < volume (brrsTimeRadialShell d referenceTime t width) := by
  exact lt_of_lt_of_le (Metric.measure_ball_pos volume x hwidth)
    (volume_metricBall_le_volume_brrsTimeRadialShell_of_norm_eq
      referenceTime t width x hx)

/-- A quantitative pointwise lower bound of a continuous function persists
as a quantitative `L^p` lower bound on a radial shell.  The displayed lower
bound keeps the physical ball that witnesses positive shell mass, which is
useful when a later stationary calculation supplies an explicit modulus of
continuity. -/
theorem exists_brrsRadialShell_lintegral_rpow_lower_of_continuous_of_le
    {d : Nat} {F : BRRSSpace d → Complex} {x : BRRSSpace d}
    (hcont : Continuous F) {c p : Real} (hc : 0 < c)
    (hpoint : c ≤ ‖F x‖) (hp : 0 < p) :
    ∃ width : Real, 0 < width ∧
      (ENNReal.ofReal (c / 2)) ^ p * volume (Metric.ball x width) ≤
        ∫⁻ y in brrsRadialShell d ‖x‖ width,
          (ENNReal.ofReal ‖F y‖) ^ p := by
  let c' : Real := c / 2
  have hc' : 0 < c' := by
    dsimp [c']
    linarith
  have hlt : c' < ‖F x‖ := by
    dsimp [c']
    linarith
  have hopen : IsOpen {y : BRRSSpace d | c' < ‖F y‖} :=
    isOpen_lt continuous_const hcont.norm
  have hmem : x ∈ {y : BRRSSpace d | c' < ‖F y‖} := hlt
  obtain ⟨width, hwidth, hball⟩ :=
    Metric.mem_nhds_iff.mp (hopen.mem_nhds hmem)
  refine ⟨width, hwidth, ?_⟩
  have hballLower : ∀ y : BRRSSpace d, y ∈ Metric.ball x width →
      c' ≤ ‖F y‖ := by
    intro y hy
    exact (hball hy).le
  have hballMass :
      (ENNReal.ofReal c') ^ p * volume (Metric.ball x width) ≤
        ∫⁻ y in Metric.ball x width, (ENNReal.ofReal ‖F y‖) ^ p := by
    rw [← setLIntegral_const]
    apply setLIntegral_mono' measurableSet_ball
    intro y hy
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal (hballLower y hy)) hp.le
  calc
    (ENNReal.ofReal (c / 2)) ^ p * volume (Metric.ball x width) =
        (ENNReal.ofReal c') ^ p * volume (Metric.ball x width) := by rfl
    _ ≤ ∫⁻ y in Metric.ball x width, (ENNReal.ofReal ‖F y‖) ^ p := hballMass
    _ ≤ ∫⁻ y in brrsRadialShell d ‖x‖ width,
        (ENNReal.ofReal ‖F y‖) ^ p :=
      lintegral_mono_set (metricBall_subset_brrsRadialShell x width)

/-- In particular, a nonzero value of a continuous function at one cone
point yields strictly positive `L^p` mass on some radial shell about that
cone radius. -/
theorem exists_brrsRadialShell_lintegral_rpow_pos_of_continuous_pointwise_pos
    {d : Nat} {F : BRRSSpace d → Complex} {x : BRRSSpace d} {p : Real}
    (hcont : Continuous F) (hpoint : 0 < ‖F x‖) (hp : 0 < p) :
    ∃ width : Real, 0 < width ∧
      0 < ∫⁻ y in brrsRadialShell d ‖x‖ width,
        (ENNReal.ofReal ‖F y‖) ^ p := by
  obtain ⟨width, hwidth, hmass⟩ :=
    exists_brrsRadialShell_lintegral_rpow_lower_of_continuous_of_le
      hcont (c := ‖F x‖) hpoint le_rfl hp
  refine ⟨width, hwidth, ?_⟩
  have hbase :
      0 < (ENNReal.ofReal (‖F x‖ / 2)) ^ p * volume (Metric.ball x width) := by
    apply ENNReal.mul_pos
    · exact (ENNReal.rpow_pos_of_nonneg
        (ENNReal.ofReal_pos.2 (by linarith : 0 < ‖F x‖ / 2)) hp.le).ne'
    · exact (Metric.measure_ball_pos volume x hwidth).ne'
  exact lt_of_lt_of_le hbase hmass

/-- The exact annular `TT*` kernel is continuous in physical space. -/
theorem continuous_brrsDyadicHalfWaveTTStarKernel
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (s t : Real) :
    Continuous (brrsDyadicHalfWaveTTStarKernel Phi j s t :
      BRRSSpace d → Complex) := by
  exact (brrsDyadicHalfWaveTTStarKernel Phi j s t).continuous

/-- The exact annular `TT*` kernel is norm-radial. -/
theorem brrsDyadicHalfWaveTTStarKernel_isRadial
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (s t : Real) :
    IsRadial (brrsDyadicHalfWaveTTStarKernel Phi j s t :
      BRRSSpace d → Complex) := by
  intro x y hxy
  rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff Phi j s t x,
    brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff Phi j s t y]
  exact brrsDyadicHalfWaveKernel_isRadial (brrsTTStarAnnularCutoff Phi) j
    (t - s) x y hxy

/-- A literal pointwise cone lower bound for the continuous `TT*` kernel
produces positive radial-shell `L^p` mass.  The cone identity is kept as an
explicit hypothesis so this theorem composes directly with any future
stationary lower bound for the full kernel. -/
theorem exists_brrsDyadicHalfWaveTTStarKernel_timeShell_lintegral_rpow_pos_of_pointwise_pos
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (s t p : Real)
    (x : BRRSSpace d) (hcone : ‖x‖ = |t - s|)
    (hpoint : 0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
      BRRSSpace d → Complex) x‖) (hp : 0 < p) :
    ∃ width : Real, 0 < width ∧
      0 < ∫⁻ y in brrsTimeRadialShell d s t width,
        (ENNReal.ofReal ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
          BRRSSpace d → Complex) y‖) ^ p := by
  obtain ⟨width, hwidth, hmass⟩ :=
    exists_brrsRadialShell_lintegral_rpow_pos_of_continuous_pointwise_pos
      (continuous_brrsDyadicHalfWaveTTStarKernel Phi j s t) hpoint hp
  refine ⟨width, hwidth, ?_⟩
  simpa only [brrsTimeRadialShell, hcone] using hmass

/-- The continuity-to-shell bridge may be made at any prescribed positive
spatial resolution.  Thus, after dyadic rescaling, it can always be invoked
on a shell no wider than the natural scale `2⁻ʲ`; the theorem deliberately
does not claim a uniform modulus of continuity which the stationary estimate
has not supplied. -/
theorem exists_brrsRadialShell_lintegral_rpow_lower_of_continuous_of_le_of_width_le
    {d : Nat} {F : BRRSSpace d → Complex} {x : BRRSSpace d}
    (hcont : Continuous F) {c p cap : Real} (hc : 0 < c)
    (hpoint : c ≤ ‖F x‖) (hp : 0 < p) (hcap : 0 < cap) :
    ∃ width : Real, 0 < width ∧ width ≤ cap ∧
      (ENNReal.ofReal (c / 2)) ^ p * volume (Metric.ball x width) ≤
        ∫⁻ y in brrsRadialShell d ‖x‖ width,
          (ENNReal.ofReal ‖F y‖) ^ p := by
  let c' : Real := c / 2
  have hc' : 0 < c' := by
    dsimp [c']
    linarith
  have hlt : c' < ‖F x‖ := by
    dsimp [c']
    linarith
  have hopen : IsOpen {y : BRRSSpace d | c' < ‖F y‖} :=
    isOpen_lt continuous_const hcont.norm
  have hmem : x ∈ {y : BRRSSpace d | c' < ‖F y‖} := hlt
  obtain ⟨delta, hdelta, hball⟩ :=
    Metric.mem_nhds_iff.mp (hopen.mem_nhds hmem)
  let width : Real := min delta cap
  have hwidth : 0 < width := by
    dsimp only [width]
    exact lt_min hdelta hcap
  have hwidth_delta : width ≤ delta := by
    dsimp only [width]
    exact min_le_left _ _
  have hwidth_cap : width ≤ cap := by
    dsimp only [width]
    exact min_le_right _ _
  refine ⟨width, hwidth, hwidth_cap, ?_⟩
  have hballLower : ∀ y : BRRSSpace d, y ∈ Metric.ball x width →
      c' ≤ ‖F y‖ := by
    intro y hy
    have hywidth : dist y x < width := by
      simpa only [Metric.mem_ball] using hy
    have hydelta : dist y x < delta := lt_of_lt_of_le hywidth hwidth_delta
    exact (hball (by simpa only [Metric.mem_ball] using hydelta)).le
  have hballMass :
      (ENNReal.ofReal c') ^ p * volume (Metric.ball x width) ≤
        ∫⁻ y in Metric.ball x width, (ENNReal.ofReal ‖F y‖) ^ p := by
    rw [← setLIntegral_const]
    apply setLIntegral_mono' measurableSet_ball
    intro y hy
    exact ENNReal.rpow_le_rpow
      (ENNReal.ofReal_le_ofReal (hballLower y hy)) hp.le
  calc
    (ENNReal.ofReal (c / 2)) ^ p * volume (Metric.ball x width) =
        (ENNReal.ofReal c') ^ p * volume (Metric.ball x width) := by rfl
    _ ≤ ∫⁻ y in Metric.ball x width, (ENNReal.ofReal ‖F y‖) ^ p := hballMass
    _ ≤ ∫⁻ y in brrsRadialShell d ‖x‖ width,
        (ENNReal.ofReal ‖F y‖) ^ p :=
      lintegral_mono_set (metricBall_subset_brrsRadialShell x width)

/-- The `TT*` cone-to-shell bridge with a prescribed shell-width cap.  Taking
the cap to be the physical dyadic scale gives the natural-width form used by
the BRRS packet construction, while leaving the available continuity modulus
completely explicit. -/
theorem exists_brrsDyadicHalfWaveTTStarKernel_timeShell_lintegral_rpow_pos_of_pointwise_pos_of_width_le
    {d : Nat} (Phi : BRRSAnnularCutoff) (j : Nat) (s t p cap : Real)
    (x : BRRSSpace d) (hcone : ‖x‖ = |t - s|)
    (hpoint : 0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
      BRRSSpace d → Complex) x‖) (hp : 0 < p) (hcap : 0 < cap) :
    ∃ width : Real, 0 < width ∧ width ≤ cap ∧
      0 < ∫⁻ y in brrsTimeRadialShell d s t width,
        (ENNReal.ofReal ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
          BRRSSpace d → Complex) y‖) ^ p := by
  let K : BRRSSpace d → Complex :=
    (brrsDyadicHalfWaveTTStarKernel Phi j s t : BRRSSpace d → Complex)
  obtain ⟨width, hwidth, hwidthcap, hmass⟩ :=
    exists_brrsRadialShell_lintegral_rpow_lower_of_continuous_of_le_of_width_le
      (continuous_brrsDyadicHalfWaveTTStarKernel Phi j s t)
      (c := ‖K x‖) hpoint le_rfl hp hcap
  refine ⟨width, hwidth, hwidthcap, ?_⟩
  have hbase :
      0 < (ENNReal.ofReal (‖K x‖ / 2)) ^ p * volume (Metric.ball x width) := by
    apply ENNReal.mul_pos
    · exact (ENNReal.rpow_pos_of_nonneg
        (ENNReal.ofReal_pos.2 (by dsimp [K]; linarith : 0 < ‖K x‖ / 2))
        hp.le).ne'
    · exact (Metric.measure_ball_pos volume x hwidth).ne'
  have hmassTime :
      (ENNReal.ofReal (‖K x‖ / 2)) ^ p * volume (Metric.ball x width) ≤
        ∫⁻ y in brrsTimeRadialShell d s t width,
          (ENNReal.ofReal ‖K y‖) ^ p := by
    simpa only [brrsTimeRadialShell, hcone] using hmass
  exact lt_of_lt_of_le hbase hmassTime

/-- The exact full odd-dimensional outgoing-cone lower bound has genuine
positive `L^p` mass on a BRRS time shell.  This is the analytic-to-geometric
step needed before the separated-shell packing argument: it uses the literal
positive `TT*` packet, not a model kernel. -/
theorem exists_brrsPositiveRadialTestPacket_ttStar_outgoing_cone_timeShell_lintegral_rpow_pos
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 0 < p) :
    ∃ A : Real, 16 ≤ A ∧ ∀ (a : Real) (v : BRRSSpace (2 * n + 3)),
      A ≤ a → ‖v‖ = 1 →
        ∃ width : Real, 0 < width ∧
          0 < ∫⁻ y in brrsTimeRadialShell (2 * n + 3) 0 a width,
            (ENNReal.ofReal
              ‖brrsDyadicHalfWave Phi 0 a
                (brrsPositiveRadialHalfWaveTestPacket Phi 0 0) y‖) ^ p := by
  obtain ⟨A, c, hA, hc, hconeLower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
      Phi n
  refine ⟨A, hA, ?_⟩
  intro a v ha hv
  have ha16 : 16 ≤ a := le_trans hA ha
  have ha0 : 0 < a := by linarith
  have hpow : 0 < a ^ (n + 1) := pow_pos ha0 _
  have hhalfWavePoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    exact lt_of_lt_of_le (div_pos hc hpow) (hconeLower a v ha hv)
  have hkernelPoint :
      0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi 0 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
    simpa only [sub_zero] using hhalfWavePoint
  have hnorm : ‖a • v‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha0.le, hv, mul_one]
  have hcone : ‖a • v‖ = |a - 0| := by
    simpa only [sub_zero, abs_of_nonneg ha0.le] using hnorm
  obtain ⟨width, hwidth, hmass⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_timeShell_lintegral_rpow_pos_of_pointwise_pos
      Phi 0 0 a p (a • v) hcone hkernelPoint hp
  refine ⟨width, hwidth, ?_⟩
  simpa only [brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel] using hmass

/-- The odd-dimensional cone-shell lower bound transports to every dyadic
frequency scale with a shell no wider than the natural physical scale
`2⁻ʲ`.  The cone parameter `a` is the scaled time `2ʲ t`; in the BRRS range
`t ∈ [1,2]` it is therefore large exactly when the dyadic level is large. -/
theorem exists_brrsPositiveRadialTestPacket_ttStar_outgoing_dyadic_cone_timeShell_lintegral_rpow_pos
    (Phi : BRRSAnnularCutoff) (n : Nat) {p : Real} (hp : 0 < p) :
    ∃ A : Real, 16 ≤ A ∧ ∀ (j : Nat) (a : Real)
      (v : BRRSSpace (2 * n + 3)), A ≤ a → ‖v‖ = 1 →
        ∃ width : Real, 0 < width ∧ width ≤ ((2 : Real) ^ j)⁻¹ ∧
          0 < ∫⁻ y in brrsTimeRadialShell (2 * n + 3) 0
            (a / ((2 : Real) ^ j)) width,
            (ENNReal.ofReal
              ‖brrsDyadicHalfWave Phi j (a / ((2 : Real) ^ j))
                (brrsPositiveRadialHalfWaveTestPacket Phi j 0) y‖) ^ p := by
  obtain ⟨A, c, hA, hc, hconeLower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
      Phi n
  refine ⟨A, hA, ?_⟩
  intro j a v ha hv
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have ha0 : 0 < a := by linarith [hA]
  have hpow : 0 < a ^ (n + 1) := pow_pos ha0 _
  have hlevelZeroPoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
        BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
    exact lt_of_lt_of_le (div_pos hc hpow) (hconeLower a v ha hv)
  have htime : q * (a / q) = a := by
    field_simp [ne_of_gt hq]
  have hscaledKernel :
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j (a / q) :
        BRRSSpace (2 * n + 3) → Complex) ((a / q) • v) =
        q ^ (2 * n + 3) •
          (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v) := by
    calc
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j (a / q) :
          BRRSSpace (2 * n + 3) → Complex) ((a / q) • v) =
          q ^ (2 * n + 3) •
            (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0
              (q * (a / q)) : BRRSSpace (2 * n + 3) → Complex)
              (q • ((a / q) • v)) := by
        simpa only [q] using
          brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general
            (brrsTTStarAnnularCutoff Phi) j (a / q) ((a / q) • v)
      _ = q ^ (2 * n + 3) •
          (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v) := by
        rw [smul_smul, htime]
  have hqpow : 0 < q ^ (2 * n + 3) := pow_pos hq _
  have hhalfWavePoint :
      0 < ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j
        (a / q) : BRRSSpace (2 * n + 3) → Complex) ((a / q) • v)‖ := by
    rw [hscaledKernel, norm_smul, Real.norm_eq_abs, abs_of_pos hqpow]
    exact mul_pos hqpow hlevelZeroPoint
  have hkernelPoint :
      0 < ‖(brrsDyadicHalfWaveTTStarKernel Phi j 0 (a / q) :
        BRRSSpace (2 * n + 3) → Complex) ((a / q) • v)‖ := by
    rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
    simpa only [sub_zero] using hhalfWavePoint
  have haq : 0 < a / q := div_pos ha0 hq
  have hnorm : ‖(a / q) • v‖ = a / q := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg haq.le, hv, mul_one]
  have hcone : ‖(a / q) • v‖ = |a / q - 0| := by
    simpa only [sub_zero, abs_of_nonneg haq.le] using hnorm
  have hqinv : 0 < q⁻¹ := inv_pos.mpr hq
  obtain ⟨width, hwidth, hwidthcap, hmass⟩ :=
    exists_brrsDyadicHalfWaveTTStarKernel_timeShell_lintegral_rpow_pos_of_pointwise_pos_of_width_le
      Phi j 0 (a / q) p q⁻¹ ((a / q) • v) hcone hkernelPoint hp hqinv
  refine ⟨width, hwidth, ?_, ?_⟩
  · simpa only [q] using hwidthcap
  · simpa only [q, brrsDyadicHalfWave_positiveRadialTestPacket_eq_ttStarKernel]
      using hmass

/-! ### Positivity of a slowly varying Fourier carrier -/

/-- A nonnegative integrable profile retains at least half of its mass in
the real part of a Fourier-character integral whenever the carrier phase is
at most `π / 3` on the support of the profile.  The phase condition is only
required where `a` is nonzero. -/
theorem brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ x, 0 ≤ a x) (hphase_meas : Measurable phase)
    (hsmall : ∀ x, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re := by
  have hchar_meas : Measurable (fun x : α =>
      (Real.fourierChar (phase x) : Complex)) := by
    change Measurable (fun x : α =>
      Complex.exp (((2 * Real.pi * phase x : Real) : Complex) * Complex.I))
    exact Complex.continuous_exp.measurable.comp
      ((Complex.measurable_ofReal.comp
        (measurable_const.mul hphase_meas)).mul measurable_const)
  have ha_complex : Integrable (fun x : α => (a x : Complex)) μ := ha.ofReal
  have hcomplex : Integrable (fun x : α =>
      (Real.fourierChar (phase x) : Complex) * (a x : Complex)) μ := by
    exact ha_complex.bdd_mul (c := 1) hchar_meas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by simp [Circle.norm_coe])
  have hcos (u : Real) (hu : |u| ≤ Real.pi / 3) :
      (1 / 2 : Real) ≤ Real.cos u := by
    calc
      (1 / 2 : Real) = Real.cos (Real.pi / 3) := Real.cos_pi_div_three.symm
      _ ≤ Real.cos |u| := Real.cos_le_cos_of_nonneg_of_le_pi
        (abs_nonneg u) (by linarith [Real.pi_pos]) hu
      _ = Real.cos u := Real.cos_abs u
  have hre (x : α) :
      ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re =
        Real.cos (2 * Real.pi * phase x) * a x := by
    rw [Real.fourierChar_apply]
    rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re,
      Complex.exp_ofReal_mul_I_im]
    simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hpoint (x : α) :
      (1 / 2 : Real) * a x ≤
        ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re := by
    rw [hre]
    by_cases hzero : a x = 0
    · simp [hzero]
    · exact mul_le_mul_of_nonneg_right
        (hcos _ (hsmall x hzero)) (ha_nonneg x)
  calc
    (1 / 2 : Real) * (∫ x, a x ∂μ) =
        ∫ x, (1 / 2 : Real) * a x ∂μ :=
      (integral_const_mul (1 / 2 : Real) a).symm
    _ ≤ ∫ x, ((Real.fourierChar (phase x) : Complex) *
        (a x : Complex)).re ∂μ :=
      integral_mono (ha.const_mul (1 / 2 : Real)) hcomplex.re hpoint
    _ = (∫ x, (Real.fourierChar (phase x) : Complex) *
        (a x : Complex) ∂μ).re :=
      integral_re hcomplex

/-- The small-phase carrier lower bound with the phase hypothesis only where
the measure sees it.  This restriction-measure form is convenient for compact
frequency intervals: no artificial condition is imposed outside the annulus. -/
theorem brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase_ae
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ᵐ x ∂μ, 0 ≤ a x) (hphase_meas : Measurable phase)
    (hsmall : ∀ᵐ x ∂μ, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re := by
  have hchar_meas : Measurable (fun x : α =>
      (Real.fourierChar (phase x) : Complex)) := by
    change Measurable (fun x : α =>
      Complex.exp (((2 * Real.pi * phase x : Real) : Complex) * Complex.I))
    exact Complex.continuous_exp.measurable.comp
      ((Complex.measurable_ofReal.comp
        (measurable_const.mul hphase_meas)).mul measurable_const)
  have ha_complex : Integrable (fun x : α => (a x : Complex)) μ := ha.ofReal
  have hcomplex : Integrable (fun x : α =>
      (Real.fourierChar (phase x) : Complex) * (a x : Complex)) μ := by
    exact ha_complex.bdd_mul (c := 1) hchar_meas.aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by simp [Circle.norm_coe])
  have hcos (u : Real) (hu : |u| ≤ Real.pi / 3) :
      (1 / 2 : Real) ≤ Real.cos u := by
    calc
      (1 / 2 : Real) = Real.cos (Real.pi / 3) := Real.cos_pi_div_three.symm
      _ ≤ Real.cos |u| := Real.cos_le_cos_of_nonneg_of_le_pi
        (abs_nonneg u) (by linarith [Real.pi_pos]) hu
      _ = Real.cos u := Real.cos_abs u
  have hre (x : α) :
      ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re =
        Real.cos (2 * Real.pi * phase x) * a x := by
    rw [Real.fourierChar_apply]
    rw [Complex.mul_re, Complex.exp_ofReal_mul_I_re,
      Complex.exp_ofReal_mul_I_im]
    simp only [Complex.ofReal_re, Complex.ofReal_im, mul_zero, sub_zero]
  have hpoint : ∀ᵐ x ∂μ,
      (1 / 2 : Real) * a x ≤
        ((Real.fourierChar (phase x) : Complex) * (a x : Complex)).re := by
    filter_upwards [ha_nonneg, hsmall] with x hnonneg hsmallx
    rw [hre]
    by_cases hzero : a x = 0
    · simp [hzero]
    · exact mul_le_mul_of_nonneg_right
        (hcos _ (hsmallx hzero)) hnonneg
  calc
    (1 / 2 : Real) * (∫ x, a x ∂μ) =
        ∫ x, (1 / 2 : Real) * a x ∂μ :=
      (integral_const_mul (1 / 2 : Real) a).symm
    _ ≤ ∫ x, ((Real.fourierChar (phase x) : Complex) *
        (a x : Complex)).re ∂μ :=
      integral_mono_ae (ha.const_mul (1 / 2 : Real)) hcomplex.re hpoint
    _ = (∫ x, (Real.fourierChar (phase x) : Complex) *
        (a x : Complex) ∂μ).re :=
      integral_re hcomplex

/-- A compact interval form of the small-phase carrier lower bound.  It is
stated for the literal interval integral used by the stationary wave
components, and is therefore ready to control the leading carrier on a cone
tube. -/
theorem brrs_intervalIntegral_fourierChar_norm_lower_of_nonneg_of_small_phase
    {a b : Real} (hab : a ≤ b) (w phase : Real → Real)
    (hw : IntervalIntegrable w volume a b)
    (hwnonneg : ∀ rho ∈ Ioc a b, 0 ≤ w rho)
    (hwpos : 0 < ∫ rho in a..b, w rho)
    (hphase_meas : Measurable phase)
    (hsmall : ∀ rho ∈ Ioc a b, w rho ≠ 0 →
      |2 * Real.pi * phase rho| ≤ Real.pi / 3) :
    (1 / 2 : Real) * (∫ rho in a..b, w rho) ≤
      ‖∫ rho in a..b,
        (Real.fourierChar (phase rho) : Complex) * (w rho : Complex)‖ := by
  let μ : Measure Real := volume.restrict (Ioc a b)
  have hw_int : Integrable w μ := by
    dsimp only [μ]
    exact (intervalIntegrable_iff_integrableOn_Ioc_of_le hab).mp hw
  have hnonneg : ∀ᵐ rho ∂μ, 0 ≤ w rho := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hwnonneg rho hrho
  have hsmall_ae : ∀ᵐ rho ∂μ,
      w rho ≠ 0 → |2 * Real.pi * phase rho| ≤ Real.pi / 3 := by
    dsimp only [μ]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hsmall rho hrho
  have hcarrier := brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase_ae
    μ w phase hw_int hnonneg hphase_meas hsmall_ae
  have hnorm :
      (1 / 2 : Real) * (∫ rho, w rho ∂μ) ≤
        ‖∫ rho, (Real.fourierChar (phase rho) : Complex) *
          (w rho : Complex) ∂μ‖ := by
    calc
      (1 / 2 : Real) * (∫ rho, w rho ∂μ) ≤
          (∫ rho, (Real.fourierChar (phase rho) : Complex) *
            (w rho : Complex) ∂μ).re := hcarrier
      _ ≤ ‖∫ rho, (Real.fourierChar (phase rho) : Complex) *
          (w rho : Complex) ∂μ‖ := Complex.re_le_norm _
  simpa only [μ, intervalIntegral.integral_of_le hab] using hnorm

/-- The positive `TT*` annular moment remains quantitatively nonzero under a
small radial carrier shift.  This is the leading-term protection needed for a
uniform cone tube: on `|u| ≤ 1 / 6`, every frequency in the literal annulus
has phase at most `π / 3`. -/
theorem brrsOddTTStarRadialCarrier_norm_lower_of_abs_le_one_sixth
    (Phi : BRRSAnnularCutoff) (n : Nat) (u : Real) (hu : |u| ≤ 1 / 6) :
    (1 / 2 : Real) * brrsOddTTStarRadialMoment Phi n ≤
      ‖∫ rho in (1 / 32 : Real)..1,
        (Real.fourierChar (u * rho) : Complex) *
          ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
            Complex)‖ := by
  let w : Real → Real := fun rho : Real =>
    rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2
  have hwcont : Continuous w := by
    dsimp only [w]
    exact (continuous_id.pow (n + 1)).mul
      ((Phi.symbol.continuous.comp (by fun_prop)).norm.pow 2)
  have hw : IntervalIntegrable w volume (1 / 32 : Real) 1 :=
    hwcont.intervalIntegrable _ _
  have hwnonneg : ∀ rho ∈ Ioc (1 / 32 : Real) 1, 0 ≤ w rho := by
    intro rho hrho
    dsimp only [w]
    exact mul_nonneg (pow_nonneg (by linarith [hrho.1]) _) (sq_nonneg _)
  have hwpos : 0 < ∫ rho in (1 / 32 : Real)..1, w rho := by
    simpa only [w, brrsOddTTStarRadialMoment] using
      brrsOddTTStarRadialMoment_pos Phi n
  have hphase_meas : Measurable (fun rho : Real => u * rho) :=
    measurable_const.mul measurable_id
  have hsmall : ∀ rho ∈ Ioc (1 / 32 : Real) 1, w rho ≠ 0 →
      |2 * Real.pi * (u * rho)| ≤ Real.pi / 3 := by
    intro rho hrho _
    have hrho0 : 0 ≤ rho := by linarith [hrho.1]
    have hrhoabs : |rho| ≤ 1 := by
      rw [abs_of_nonneg hrho0]
      exact hrho.2
    have htwopi : 0 ≤ 2 * Real.pi := by positivity
    calc
      |2 * Real.pi * (u * rho)| = (2 * Real.pi) * (|u| * |rho|) := by
        rw [abs_mul, abs_mul, abs_mul,
          abs_of_nonneg (by norm_num : (0 : Real) ≤ 2),
          abs_of_nonneg Real.pi_pos.le]
      _ ≤ (2 * Real.pi) * ((1 / 6 : Real) * 1) := by
        apply mul_le_mul_of_nonneg_left
          (mul_le_mul hu hrhoabs (abs_nonneg _) (by norm_num)) htwopi
      _ = Real.pi / 3 := by ring
  have hcarrier :=
    brrs_intervalIntegral_fourierChar_norm_lower_of_nonneg_of_small_phase
      (a := (1 / 32 : Real)) (b := 1) (by norm_num) w
      (fun rho : Real => u * rho) hw hwnonneg hwpos hphase_meas hsmall
  simpa only [w, brrsOddTTStarRadialMoment] using hcarrier

open Auto.Spherical.FractalDilations.Auxiliary

/-- The normalized odd-dimensional outgoing `TT*` component has the same
leading carrier throughout a bounded cone tube.  The displacement `t - r`
is retained literally in the Fourier character, while the stationary
remainder is uniform in the physical radius `r`. -/
theorem exists_norm_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_normalized_leading_asymptotic
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real, 16 ≤ r →
      ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t -
          brrsOddOutgoingLeadingCarrier n *
            (∫ rho in (1 / 32 : Real)..1,
              (Real.fourierChar ((t - r) * rho) : Complex) *
                ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
                  Complex))‖ ≤ C / Real.sqrt (r / 16) := by
  obtain ⟨D, hD, hamp⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic' n
  let Psi : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Phi
  let W : Real → Complex := fun rho : Real => Psi.symbol (2 * Real.pi * rho)
  have hWcont : Continuous W := by
    dsimp [W]
    exact Psi.symbol.continuous.comp (by fun_prop)
  obtain ⟨B, hB⟩ :=
    (isCompact_Icc : IsCompact (Icc (1 / 32 : Real) 1)).exists_bound_of_continuousOn
      hWcont.continuousOn
  let C : Real := (1 - (1 / 32 : Real)) * (max B 0 * D) + 1
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r t hr
  let A : Complex := ((4 * Real.pi * r : Real) : Complex) * Complex.I
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let omega : Real → Complex := fun rho : Real =>
    oscillatoryExp (2 * Real.pi * (t - r)) rho
  let P : Real → Complex := fun rho : Real =>
    ((rho ^ (2 * n + 2) : Real) : Complex) *
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho * W rho
  let Q : Real → Complex := fun rho : Real =>
    ((rho ^ (n + 1) : Real) : Complex) * W rho
  let J : Complex := ∫ rho in (1 / 32 : Real)..1, Q rho * omega rho
  have hPcont : Continuous P := by
    dsimp [P]
    exact ((Complex.ofRealCLM.continuous.comp (continuous_id.pow (2 * n + 2))).mul
      (contDiff_brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r).continuous).mul hWcont
  have hQcont : Continuous Q := by
    dsimp [Q]
    exact (Complex.ofRealCLM.continuous.comp (continuous_id.pow (n + 1))).mul hWcont
  have homegaCont : Continuous omega := by
    dsimp [omega, oscillatoryExp]
    exact Complex.continuous_exp.comp
      ((Complex.ofRealCLM.continuous.comp
        (continuous_const.mul continuous_id)).mul continuous_const)
  have hAPint : IntervalIntegrable (fun rho : Real =>
      A ^ (n + 1) * (P rho * omega rho)) volume (1 / 32 : Real) 1 :=
    (continuous_const.mul (hPcont.mul homegaCont)).intervalIntegrable _ _
  have hLQint : IntervalIntegrable (fun rho : Real =>
      L * (Q rho * omega rho)) volume (1 / 32 : Real) 1 :=
    (continuous_const.mul (hQcont.mul homegaCont)).intervalIntegrable _ _
  have hphase :
      brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t =
        2 * Real.pi * (t - r) := by
    simp only [brrsSurfaceWavePhase]
    ring
  have hindex : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hcomponent :
      brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t =
        ∫ rho in (1 / 32 : Real)..1, P rho * omega rho := by
    unfold brrsStationaryWaveComponentIntegral
    rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
    apply intervalIntegral.integral_congr
    intro rho _
    dsimp [P, omega, W]
    rw [hphase]
    unfold brrsStationaryWaveRadialCoefficient
    rw [hindex]
  have hJcarrier : J =
      ∫ rho in (1 / 32 : Real)..1,
        (Real.fourierChar ((t - r) * rho) : Complex) *
          ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
            Complex) := by
    unfold J
    apply intervalIntegral.integral_congr
    intro rho _
    have homega :
        oscillatoryExp (2 * Real.pi * (t - r)) rho =
          (Real.fourierChar ((t - r) * rho) : Complex) := by
      rw [Real.fourierChar_apply]
      unfold oscillatoryExp
      congr 1
      push_cast
      ring
    dsimp [Q, omega, W, Psi]
    rw [brrsTTStarAnnularCutoff_symbol_apply, RCLike.mul_conj]
    rw [homega]
    push_cast
    ac_rfl
  have hrewrite :
      A ^ (n + 1) *
          brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t -
          L * J =
        ∫ rho in (1 / 32 : Real)..1,
          Q rho * omega rho *
            (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L) := by
    rw [hcomponent]
    change A ^ (n + 1) * (∫ rho in (1 / 32 : Real)..1, P rho * omega rho) -
        L * (∫ rho in (1 / 32 : Real)..1, Q rho * omega rho) = _
    rw [← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_const_mul]
    rw [← intervalIntegral.integral_sub
      (μ := volume) (a := (1 / 32 : Real)) (b := 1)
      (f := fun rho : Real => A ^ (n + 1) * (P rho * omega rho))
      (g := fun rho : Real => L * (Q rho * omega rho)) hAPint hLQint]
    apply intervalIntegral.integral_congr
    intro rho _
    have hpower : (2 * n + 2 : Nat) = (n + 1) + (n + 1) := by omega
    dsimp [P, Q, omega]
    push_cast <;> rw [hpower, pow_add] <;> ring
  rw [show (((4 * Real.pi * r : Real) : Complex) * Complex.I) = A by rfl,
    show brrsOddOutgoingLeadingCarrier n = L by rfl,
    ← hJcarrier, hrewrite]
  refine (intervalIntegral.norm_integral_le_of_norm_le_const
    (C := (max B 0) * (D / Real.sqrt (r / 16))) ?_).trans ?_
  · intro rho hrho
    have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
      rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
      exact ⟨hrho.1.le, hrho.2⟩
    have hr0 : 0 ≤ r := by linarith
    have hrho0 : 0 ≤ rho := le_trans (by norm_num) hrho'.1
    have hfactor : (1 / 16 : Real) ≤ (2 * Real.pi) * rho := by
      calc
        (1 / 16 : Real) ≤ (2 * Real.pi) * (1 / 32 : Real) := by
          nlinarith [Real.pi_gt_three]
        _ ≤ (2 * Real.pi) * rho := by
          exact mul_le_mul_of_nonneg_left hrho'.1 (by positivity)
    have hlambda : r / 16 ≤ (2 * Real.pi * r) * rho := by
      calc
        r / 16 = r * (1 / 16 : Real) := by ring
        _ ≤ r * ((2 * Real.pi) * rho) := by gcongr
        _ = (2 * Real.pi * r) * rho := by ring
    have hlarge : 1 ≤ (2 * Real.pi * r) * rho := by
      calc
        (1 : Real) ≤ r / 16 := by linarith
        _ ≤ (2 * Real.pi * r) * rho := hlambda
    have hqpos : 0 < Real.sqrt (r / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hsqrt : Real.sqrt (r / 16) ≤ Real.sqrt ((2 * Real.pi * r) * rho) :=
      Real.sqrt_le_sqrt hlambda
    have herr :
        ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L‖ ≤
          D / Real.sqrt (r / 16) := by
      change ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho -
          brrsOddOutgoingLeadingCarrier n‖ ≤ _
      exact (hamp r rho hlarge).trans
        (div_le_div_of_nonneg_left hD.le hqpos hsqrt)
    have hrhopow : ‖((rho ^ (n + 1) : Real) : Complex)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hrho0 _)]
      exact pow_le_one₀ hrho0 hrho'.2
    have hW : ‖W rho‖ ≤ max B 0 :=
      (hB rho hrho').trans (le_max_left _ _)
    have hE : 0 ≤ D / Real.sqrt (r / 16) := by positivity
    calc
      ‖Q rho * omega rho *
          (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L)‖ =
          ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ * ‖omega rho‖ *
            ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing r rho - L‖ := by
        dsimp [Q]
        rw [norm_mul, norm_mul, norm_mul]
      _ ≤ ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ * ‖omega rho‖ *
            (D / Real.sqrt (r / 16)) := by
        gcongr
      _ = ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            (D / Real.sqrt (r / 16)) := by
        rw [show ‖omega rho‖ = 1 by
          dsimp [omega]
          exact norm_oscillatoryExp _ _]
        ring
      _ ≤ (max B 0) * (D / Real.sqrt (r / 16)) := by
        calc
          _ ≤ (1 : Real) * (max B 0) * (D / Real.sqrt (r / 16)) := by
            gcongr
          _ = (max B 0) * (D / Real.sqrt (r / 16)) := by ring
  · have hqpos : 0 < Real.sqrt (r / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hlength : |1 - (1 / 32 : Real)| = 1 - (1 / 32 : Real) := by
      rw [abs_of_nonneg]
      norm_num
    rw [hlength]
    calc
      (max B 0) * (D / Real.sqrt (r / 16)) * (1 - (1 / 32 : Real)) =
          ((1 - (1 / 32 : Real)) * (max B 0 * D)) /
            Real.sqrt (r / 16) := by
        rw [div_eq_mul_inv, div_eq_mul_inv]
        ring
      _ ≤ C / Real.sqrt (r / 16) := by
        apply (div_le_div_iff_of_pos_right hqpos).mpr
        dsimp [C]
        linarith

/-- The outgoing stationary component has a uniform normalized lower bound
on the fixed level-zero cone tube `|t - r| ≤ 1 / 6`.  Unlike a bare
continuity argument, the width here is independent of the large cone radius.
The result concerns the outgoing component alone; the full kernel additionally
requires uniform control of the other stationary components on the tube. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_normalized_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ r t : Real, A ≤ r →
      |t - r| ≤ 1 / 6 →
        c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t‖ := by
  obtain ⟨C, hC, herror⟩ :=
    exists_norm_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_normalized_leading_asymptotic
      Phi n
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let M : Real := brrsOddTTStarRadialMoment Phi n
  let K : Real := ‖L‖ * ((1 / 2 : Real) * M)
  have hLne : L ≠ 0 := by
    dsimp [L]
    exact brrsOddOutgoingLeadingCarrier_ne_zero n
  have hM : 0 < M := by
    dsimp [M]
    exact brrsOddTTStarRadialMoment_pos Phi n
  have hK : 0 < K := by
    dsimp [K]
    exact mul_pos (norm_pos_iff.mpr hLne) (mul_pos (by norm_num) hM)
  let A : Real := max 16 (16 * (2 * C / K) ^ 2)
  refine ⟨A, K / 2, le_max_left _ _, div_pos hK (by norm_num), ?_⟩
  intro r t hr htube
  let J : Complex := ∫ rho in (1 / 32 : Real)..1,
    (Real.fourierChar ((t - r) * rho) : Complex) *
      ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) : Complex)
  let X : Complex :=
    (((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
      brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
        (2 * n + 3) .outgoing r t
  change K / 2 ≤ ‖X‖
  have hr16 : 16 ≤ r := le_trans (le_max_left _ _) hr
  have hrover : 0 < r / 16 := by linarith
  have hqpos : 0 < Real.sqrt (r / 16) := Real.sqrt_pos.2 hrover
  have hsq : (2 * C / K) ^ 2 ≤ r / 16 := by
    have hraw : 16 * (2 * C / K) ^ 2 ≤ r :=
      le_trans (le_max_right _ _) hr
    nlinarith
  have hratio0 : 0 ≤ 2 * C / K := by positivity
  have hroot_sq : (Real.sqrt (r / 16)) ^ 2 = r / 16 :=
    Real.sq_sqrt hrover.le
  have hratio : 2 * C / K ≤ Real.sqrt (r / 16) := by
    nlinarith [Real.sqrt_nonneg (r / 16)]
  have htwoC : 2 * C ≤ Real.sqrt (r / 16) * K :=
    (div_le_iff₀ hK).mp hratio
  have hhalf : C / Real.sqrt (r / 16) ≤ K / 2 := by
    apply (div_le_iff₀ hqpos).mpr
    nlinarith
  have hcarrier : (1 / 2 : Real) * M ≤ ‖J‖ := by
    dsimp [J, M]
    exact brrsOddTTStarRadialCarrier_norm_lower_of_abs_le_one_sixth Phi n
      (t - r) htube
  have hmain : K ≤ ‖L * J‖ := by
    dsimp [K]
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hcarrier (norm_nonneg L)
  have herr : ‖X - L * J‖ ≤ C / Real.sqrt (r / 16) := by
    change ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
        brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
          (2 * n + 3) .outgoing r t -
        brrsOddOutgoingLeadingCarrier n *
          (∫ rho in (1 / 32 : Real)..1,
            (Real.fourierChar ((t - r) * rho) : Complex) *
              ((rho ^ (n + 1) * ‖Phi.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) :
                Complex))‖ ≤ _
    exact herror r t hr16
  have hdiff : ‖X - L * J‖ ≤ K / 2 := herr.trans hhalf
  have htri : K ≤ ‖X‖ + ‖X - L * J‖ := by
    calc
      K ≤ ‖L * J‖ := hmain
      _ = ‖X - (X - L * J)‖ := by
        congr 1
        ring
      _ ≤ ‖X‖ + ‖X - L * J‖ := norm_sub_le _ _
  nlinarith

/-- The fixed-width outgoing cone-tube lower bound at the literal stationary
scale. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ r t : Real, A ≤ r →
      |t - r| ≤ 1 / 6 →
        c / r ^ (n + 1) ≤
          ‖brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
            (2 * n + 3) .outgoing r t‖ := by
  obtain ⟨A, c, hA, hc, hbound⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_normalized_eventually_lower
      Phi n
  let D : Real := (4 * Real.pi) ^ (n + 1)
  have hD : 0 < D := by
    dsimp [D]
    positivity
  refine ⟨A, c / D, hA, div_pos hc hD, ?_⟩
  intro r t hr htube
  let Y : Complex :=
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Phi)
      (2 * n + 3) .outgoing r t
  have hr16 : 16 ≤ r := le_trans hA hr
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hbase : 0 ≤ 4 * Real.pi * r := by positivity
  have hbaseNorm : ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I)‖ =
      4 * Real.pi * r := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hbase, Complex.norm_I, mul_one]
  have hnorm : c ≤ (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := by
    have hnorm' := hbound r t hr htube
    change c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) *
      Y‖ at hnorm'
    calc
      c ≤ ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I) ^ (n + 1) * Y‖ :=
        hnorm'
      _ = ‖(((4 * Real.pi * r : Real) : Complex) * Complex.I)‖ ^ (n + 1) * ‖Y‖ := by
        rw [norm_mul, norm_pow]
      _ = (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := by rw [hbaseNorm]
  have hscale : (4 * Real.pi * r) ^ (n + 1) =
      (4 * Real.pi) ^ (n + 1) * r ^ (n + 1) := by
    rw [show 4 * Real.pi * r = (4 * Real.pi) * r by ring, mul_pow]
  have hscaled : c ≤ D * r ^ (n + 1) * ‖Y‖ := by
    calc
      c ≤ (4 * Real.pi * r) ^ (n + 1) * ‖Y‖ := hnorm
      _ = D * r ^ (n + 1) * ‖Y‖ := by
        dsimp [D]
        rw [hscale]
  change c / D / r ^ (n + 1) ≤ ‖Y‖
  rw [div_div]
  apply (div_le_iff₀ (mul_pos hD (pow_pos hrpos _))).mpr
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hscaled

/-- The incoming and middle stationary components gain an extra radial power
uniformly throughout the fixed outgoing cone tube. -/
theorem exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
    (Phi : BRRSAnnularCutoff) (n : Nat) (part : BRRSSurfaceWavePart)
    (hpart : part ≠ .outgoing) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real, 16 ≤ r → |t - r| ≤ 1 / 6 →
      ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        C / r ^ (n + 2) := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := 2 * n + 3) (N := n + 2) (by omega) Phi part
  let C' : Real := (1 - (1 / 32 : Real)) * C
  have hC' : 0 < C' := by
    dsimp [C']
    positivity
  refine ⟨C', hC', ?_⟩
  intro r t hr htube
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have htlower : r - 1 / 6 ≤ t := by
    have hleft : -(1 / 6 : Real) ≤ t - r := (abs_le.mp htube).1
    linarith
  have ht0 : 0 ≤ t := by linarith
  have hphase_lower :
      r ≤ |brrsSurfaceWavePhase part r + 2 * Real.pi * t| := by
    cases part with
    | outgoing => exact False.elim (hpart rfl)
    | incoming =>
      have hrsum0 : 0 ≤ r + t := by linarith
      have hcoef : (1 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * (r + t) := by positivity
      rw [show brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t =
        2 * Real.pi * (r + t) by simp [brrsSurfaceWavePhase]; ring,
        abs_of_nonneg hnonneg]
      calc
        r ≤ r + t := by linarith
        _ = 1 * (r + t) := by ring
        _ ≤ (2 * Real.pi) * (r + t) :=
          mul_le_mul_of_nonneg_right hcoef hrsum0
    | middle =>
      have hhalf : r / 2 ≤ t := by linarith
      have hcoef : (2 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * t := by positivity
      rw [show brrsSurfaceWavePhase .middle r + 2 * Real.pi * t =
        2 * Real.pi * t by simp [brrsSurfaceWavePhase],
        abs_of_nonneg hnonneg]
      calc
        r = 2 * (r / 2) := by ring
        _ ≤ (2 * Real.pi) * (r / 2) :=
          mul_le_mul_of_nonneg_right hcoef (by linarith)
        _ ≤ (2 * Real.pi) * t :=
          mul_le_mul_of_nonneg_left hhalf (by positivity)
  have habspos : 0 < |brrsSurfaceWavePhase part r + 2 * Real.pi * t| :=
    lt_of_lt_of_le hrpos hphase_lower
  have hphase_ne : brrsSurfaceWavePhase part r + 2 * Real.pi * t ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at habspos
    linarith
  have hraw :
      ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent r t hr hphase_ne
  have hratio : 1 ≤ r / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (r / 16) := Real.one_le_sqrt.mpr hratio
  have hdenone : 1 ≤ (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) :=
    one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hinv : 1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t| ≤ 1 / r :=
    one_div_le_one_div_of_le hrpos hphase_lower
  have hinvpow :
      (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) ≤
        (1 / r) ^ (n + 2) :=
    pow_le_pow_left₀ (by positivity) hinv _
  have hconst : 0 ≤ (1 - (1 / 32 : Real)) * C := by positivity
  calc
    ‖brrsStationaryWaveComponentIntegral Phi (2 * n + 3) part r t‖ ≤
        (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (r / 16)) ^ ((2 * n + 3) - 1))) := hraw
    _ ≤ (1 / |brrsSurfaceWavePhase part r + 2 * Real.pi * t|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) * C) := by
      apply mul_le_mul_of_nonneg_left
      · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
      · positivity
    _ ≤ (1 / r) ^ (n + 2) * ((1 - (1 / 32 : Real)) * C) :=
      mul_le_mul_of_nonneg_right hinvpow hconst
    _ = C' / r ^ (n + 2) := by
      dsimp [C']
      rw [one_div, inv_pow]
      ring

/-- The literal level-zero positive `TT*` kernel has a uniform lower bound
throughout a fixed outgoing cone tube in every odd dimension.  The tube width
is the absolute level-zero width `1 / 6`; it does not shrink as the radius
grows. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (r t : Real) (v : BRRSSpace (2 * n + 3)), A ≤ r → ‖v‖ = 1 →
        |t - r| ≤ 1 / 6 →
          c / r ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 t :
              BRRSSpace (2 * n + 3) → Complex) (r • v)‖ := by
  obtain ⟨Aout, cout, hAout, hcout, hout⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_coneTube_eventually_lower
      Phi n
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
      (brrsTTStarAnnularCutoff Phi) n .incoming (by simp)
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_coneTube_highRadius_power_le
      (brrsTTStarAnnularCutoff Phi) n .middle (by simp)
  let E : Real := Cin + Cmid
  have hE : 0 < E := by
    dsimp [E]
    linarith
  let A : Real := max Aout (max 16 (2 * E / cout))
  refine ⟨A, cout / 2, ?_, div_pos hcout (by norm_num), ?_⟩
  · exact le_trans (le_max_left _ _) (le_max_right _ _)
  intro r t v hr hv htube
  let Psi : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Phi
  let O : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .outgoing r t
  let I : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .incoming r t
  let M : Complex :=
    brrsStationaryWaveComponentIntegral Psi (2 * n + 3) .middle r t
  let K : Complex :=
    (brrsDyadicHalfWaveKernel Psi 0 t : BRRSSpace (2 * n + 3) → Complex) (r • v)
  change cout / 2 / r ^ (n + 1) ≤ ‖K‖
  have hinner : max 16 (2 * E / cout) ≤ r :=
    le_trans (le_max_right _ _) hr
  have hrout : Aout ≤ r := le_trans (le_max_left _ _) hr
  have hr16 : 16 ≤ r := le_trans (le_max_left _ _) hinner
  have hratio : 2 * E / cout ≤ r := le_trans (le_max_right _ _) hinner
  have hr0 : 0 ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hout' : cout / r ^ (n + 1) ≤ ‖O‖ := by
    dsimp [O, Psi]
    exact hout r t hrout htube
  have hin' : ‖I‖ ≤ Cin / r ^ (n + 2) := by
    dsimp [I, Psi]
    exact hin r t hr16 htube
  have hmid' : ‖M‖ ≤ Cmid / r ^ (n + 2) := by
    dsimp [M, Psi]
    exact hmid r t hr16 htube
  have hsum : ‖I‖ + ‖M‖ ≤ E / r ^ (n + 2) := by
    calc
      ‖I‖ + ‖M‖ ≤ Cin / r ^ (n + 2) + Cmid / r ^ (n + 2) :=
        add_le_add hin' hmid'
      _ = E / r ^ (n + 2) := by
        dsimp [E]
        ring
  have htwoE : 2 * E ≤ r * cout :=
    (div_le_iff₀ hcout).mp hratio
  have hEover : E / r ≤ cout / 2 := by
    apply (div_le_iff₀ hrpos).mpr
    nlinarith
  have hpowers : r ^ (n + 2) = r * r ^ (n + 1) := by
    rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
    ring
  have htail : E / r ^ (n + 2) ≤ (cout / 2) / r ^ (n + 1) := by
    calc
      E / r ^ (n + 2) = (E / r) / r ^ (n + 1) := by
        rw [hpowers]
        field_simp [ne_of_gt hrpos]
      _ ≤ (cout / 2) / r ^ (n + 1) :=
        div_le_div_of_nonneg_right hEover (pow_nonneg hr0 _)
  have hnorm : ‖r • v‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hr0, hv, mul_one]
  have hsplit :=
    brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents
      (d := 2 * n + 3) (by omega) Psi t (r • v)
  rw [hnorm] at hsplit
  have hK : K = O + I + M := by
    dsimp [K, O, I, M]
    simpa only [brrsStationaryWaveComponentIntegral] using hsplit
  have htri : ‖O‖ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
    calc
      ‖O‖ = ‖K - (I + M)‖ := by
        congr 1
        rw [hK]
        ring
      _ ≤ ‖K‖ + ‖I + M‖ := norm_sub_le _ _
      _ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
        gcongr
        exact norm_add_le _ _
  have hhalf : cout / r ^ (n + 1) =
      2 * ((cout / 2) / r ^ (n + 1)) := by ring
  nlinarith [hsum.trans htail]

/-- Pointwise form of the full cone-tube lower bound.  This avoids choosing a
unit radial direction at every later use. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (t : Real) (x : BRRSSpace (2 * n + 3)), A ≤ ‖x‖ →
        |t - ‖x‖| ≤ 1 / 6 →
          c / ‖x‖ ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro t x hx htube
  let r : Real := ‖x‖
  have hrlarge : A ≤ r := by simpa only [r] using hx
  have hApos : 0 < A := by linarith
  have hrpos : 0 < r := by
    exact lt_of_lt_of_le hApos hrlarge
  have hv : ‖r⁻¹ • x‖ = 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    change r⁻¹ * r = 1
    exact inv_mul_cancel₀ (ne_of_gt hrpos)
  have hradial : r • (r⁻¹ • x) = x := by
    rw [smul_smul, mul_inv_cancel₀ (ne_of_gt hrpos), one_smul]
  have hpoint := hlower r t (r⁻¹ • x) hrlarge hv (by simpa only [r] using htube)
  rw [hradial] at hpoint
  simpa only [r] using hpoint

/-- Dyadic transport of the full pointwise cone-tube lower bound.  At level
`j` the physical tube has width `(1 / 6) 2⁻ʲ`, while the lower bound carries
the exact scaling factor `2ʲᵈ`. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_dyadic_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (t : Real) (x : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * ‖x‖ →
        |t - ‖x‖| ≤ (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹ →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * ‖x‖) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlevel⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j t x hlarge htube
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hnormscaled : ‖q • x‖ = q * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hq]
  have hlarge' : A ≤ ‖q • x‖ := by
    rw [hnormscaled]
    simpa only [q] using hlarge
  have htubeq : |t - ‖x‖| ≤ (1 / 6 : Real) * q⁻¹ := by
    simpa only [q] using htube
  have htube' : |q * t - ‖q • x‖| ≤ 1 / 6 := by
    rw [hnormscaled]
    calc
      |q * t - q * ‖x‖| = |q * (t - ‖x‖)| := by
        congr 1
        ring
      _ = |q| * |t - ‖x‖| := abs_mul _ _
      _ = q * |t - ‖x‖| := by rw [abs_of_pos hq]
      _ ≤ q * ((1 / 6 : Real) * q⁻¹) :=
        mul_le_mul_of_nonneg_left htubeq hq.le
      _ = 1 / 6 := by
        calc
          q * ((1 / 6 : Real) * q⁻¹) = (1 / 6 : Real) * (q * q⁻¹) := by ring
          _ = 1 / 6 := by rw [mul_inv_cancel₀ (ne_of_gt hq), mul_one]
  have hlevel' := hlevel (q * t) (q • x) hlarge' htube'
  have hbase : c / (q * ‖x‖) ^ (n + 1) ≤
      ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
        BRRSSpace (2 * n + 3) → Complex) (q • x)‖ := by
    simpa only [hnormscaled] using hlevel'
  change q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) ≤
    ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) j t :
      BRRSSpace (2 * n + 3) → Complex) x‖
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]
  change q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) ≤
    ‖q ^ (2 * n + 3) •
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
        BRRSSpace (2 * n + 3) → Complex) (q • x)‖
  rw [norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hq.le _)]
  calc
    q ^ (2 * n + 3) * c / (q * ‖x‖) ^ (n + 1) =
        q ^ (2 * n + 3) * (c / (q * ‖x‖) ^ (n + 1)) := by ring
    _ ≤ q ^ (2 * n + 3) *
        ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Phi) 0 (q * t) :
          BRRSSpace (2 * n + 3) → Complex) (q • x)‖ :=
      mul_le_mul_of_nonneg_left hbase (pow_nonneg hq.le _)

/-- Relative-time form of the dyadic cone-tube lower bound for the actual
`TT*` kernel. -/
theorem exists_brrsDyadicHalfWaveTTStarKernel_outgoing_dyadic_coneTube_eventually_lower_at_point
    (Phi : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (s t : Real) (x : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * ‖x‖ →
        |(t - s) - ‖x‖| ≤ (1 / 6 : Real) * ((2 : Real) ^ j)⁻¹ →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * ‖x‖) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveTTStarKernel Phi j s t :
              BRRSSpace (2 * n + 3) → Complex) x‖ := by
  obtain ⟨A, c, hA, hc, hlower⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_dyadic_coneTube_eventually_lower_at_point
      Phi n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j s t x hlarge htube
  rw [brrsDyadicHalfWaveTTStarKernel_eq_halfWaveKernelTTStarCutoff]
  exact hlower j (t - s) x hlarge htube

/-- The preceding carrier estimate is strictly positive for a profile of
positive mass; consequently the complex Fourier-character integral is
nonzero and its norm has the same explicit lower bound. -/
theorem brrs_fourierChar_integral_pos_re_nonzero_norm_lower_of_nonneg_of_small_phase
    {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (a phase : α → Real) (ha : Integrable a μ)
    (ha_nonneg : ∀ x, 0 ≤ a x) (ha_pos : 0 < ∫ x, a x ∂μ)
    (hphase_meas : Measurable phase)
    (hsmall : ∀ x, a x ≠ 0 → |2 * Real.pi * phase x| ≤ Real.pi / 3) :
    0 < (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re ∧
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ) ≠ 0 ∧
        (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
          ‖∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ‖ := by
  have hlower := brrs_fourierChar_integral_re_lower_of_nonneg_of_small_phase
    μ a phase ha ha_nonneg hphase_meas hsmall
  have hhalf_pos : 0 < (1 / 2 : Real) * (∫ x, a x ∂μ) :=
    mul_pos (by norm_num) ha_pos
  have hre_pos : 0 <
      (∫ x, (Real.fourierChar (phase x) : Complex) * (a x : Complex) ∂μ).re :=
    lt_of_lt_of_le hhalf_pos hlower
  refine ⟨hre_pos, ?_, ?_⟩
  · intro hzero
    simp [hzero] at hre_pos
  · calc
      (1 / 2 : Real) * (∫ x, a x ∂μ) ≤
          (∫ x, (Real.fourierChar (phase x) : Complex) *
            (a x : Complex) ∂μ).re := hlower
      _ ≤ ‖∫ x, (Real.fourierChar (phase x) : Complex) *
            (a x : Complex) ∂μ‖ := Complex.re_le_norm _

end Auto.Spherical.FractalDilations.BRRS

/-! ### Outer radial stationary kernel bounds -/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The exact all-nine two-radius stationary kernel is symmetric in the two
radial variables.  This transfers the compact-output/high-source estimate to
the high-output/compact-source regime without discarding any wave piece. -/
theorem brrsTwoRadiusAllStationaryComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
      brrsTwoRadiusAllStationaryComponentIntegralSum Phi d s r t := by
  unfold brrsTwoRadiusAllStationaryComponentIntegralSum
  rw [brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .middle r s t]
  ring

/-- The nine phase profiles have the same symmetry as the stationary kernel. -/
theorem brrsTwoRadiusNinePhaseProfile_swap
    (N : Nat) (r s t : Real) :
    brrsTwoRadiusNinePhaseProfile N r s t =
      brrsTwoRadiusNinePhaseProfile N s r t := by
  unfold brrsTwoRadiusNinePhaseProfile
  simp only [brrsSurfaceWavePhase]
  ring_nf

/-- The mixed high-output/compact-source regime is the reflected version of
the already proved compact-output/high-source stationary estimate. -/
theorem exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highLow_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_lowHigh_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0 hs
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_swap Phi d r s t,
    brrsTwoRadiusNinePhaseProfile_swap N r s t]
  exact hbound s r t hs0 hs hr

/-- At every output radius at least `20`, the full exact two-radius stationary
kernel has the high-output half-density bound, uniformly over all nonnegative
source radii.  The proof genuinely combines the compact-source reflection
with the high--high nine-phase estimate. -/
theorem exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_outer_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      20 ≤ r → 0 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
            brrsTwoRadiusNinePhaseProfile N r s t := by
  obtain ⟨Clo, hClo, hlow⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highLow_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  obtain ⟨Chi, hChi, hhigh⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highRadius_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  let C : Real := Clo + Chi
  have hC : 0 < C := by
    simpa only [C] using add_pos hClo hChi
  have hClo_le : Clo ≤ C := by
    simpa only [C] using le_add_of_nonneg_right hChi.le
  have hChi_le : Chi ≤ C := by
    simpa only [C] using le_add_of_nonneg_left hClo.le
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0
  have hr16 : 16 ≤ r := by linarith
  let qr : Real := (Real.sqrt (r / 16)) ^ (d - 1)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  let P : Real := brrsTwoRadiusNinePhaseProfile N r s t
  rcases le_total s 16 with hs | hs
  · have hlow' := hlow r s t hr16 hs0 hs
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) * (Clo / qr) * P := by
            simpa only [qr, P] using hlow'
      _ ≤ (1 - (1 / 32 : Real)) * (C / qr) * P := by
            apply mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left
                (div_le_div_of_nonneg_right hClo_le hqr.le) (by norm_num))
            dsimp [P]
            exact brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _

  · have hratio : 1 ≤ s / 16 := by linarith
    have hqs_one : 1 ≤ (Real.sqrt (s / 16)) ^ (d - 1) := by
      exact one_le_pow₀ (Real.one_le_sqrt.mpr hratio)
    have hqs : 0 < (Real.sqrt (s / 16)) ^ (d - 1) :=
      lt_of_lt_of_le zero_lt_one hqs_one
    have hdiv : Chi / (Real.sqrt (s / 16)) ^ (d - 1) ≤ C := by
      calc
        Chi / (Real.sqrt (s / 16)) ^ (d - 1) ≤ Chi := by
          apply (div_le_iff₀ hqs).mpr
          exact le_mul_of_one_le_right hChi.le hqs_one
        _ ≤ C := hChi_le
    have hquot :
        Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1)) ≤ C / qr := by
      have heq :
          Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1)) =
            (Chi / (Real.sqrt (s / 16)) ^ (d - 1)) / qr := by
        field_simp [ne_of_gt hqr, ne_of_gt hqs]
      rw [heq]
      exact div_le_div_of_nonneg_right hdiv hqr.le
    have hhigh' :
        ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) *
            (Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1))) * P := by
      simpa only [qr, P, brrsTwoRadiusNinePhaseProfile] using
        hhigh r s t hr16 hs
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
          (1 - (1 / 32 : Real)) *
            (Chi / (qr * (Real.sqrt (s / 16)) ^ (d - 1))) * P := hhigh'
      _ ≤ (1 - (1 / 32 : Real)) * (C / qr) * P := by
            apply mul_le_mul_of_nonneg_right
              (mul_le_mul_of_nonneg_left hquot (by norm_num))
            dsimp [P]
            exact brrsTwoRadiusNinePhaseProfile_nonneg N _ _ _

/-- Fixed-time outer-region bound for the literal level-zero BRRS half-wave
on radial Schwartz data.  All nine stationary pieces remain inside the
integrable radial source majorant, while the output radius has the sharp
high-radius half-density factor. -/
theorem exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ r →
      ‖brrsDyadicHalfWave Phi 0 t f (r • v)‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N r s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r t f hf v w hv hw hr
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N r s.1 t
  let B : Real := (1 - (1 / 32 : Real)) *
    (C / (Real.sqrt (r / 16)) ^ (d - 1))
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    simpa only [one_mul] using
      (integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
        (by omega) N r 1 t f hf w hw)
  have hK (s : Ioi (0 : Real)) :
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t‖ ≤
        B * P s := by
    dsimp [B, P]
    exact hkernel r s.1 t hr s.2.le
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
          f (s.1 • w)‖ ≤ B * (P s * ‖f (s.1 • w)‖) := by
    rw [norm_mul]
    calc
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t‖ *
          ‖f (s.1 • w)‖ ≤ (B * P s) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hK s) (norm_nonneg _)
      _ = B * (P s * ‖f (s.1 • w)‖) := by ring
  rw [brrsDyadicHalfWave_levelZero_eq_allStationaryComponentIntegralSum
    hd Phi t f hf v w hv hw r (by linarith)]
  calc
    ‖∫ s : Ioi (0 : Real),
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
          f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖ ≤
        ∫ s : Ioi (0 : Real),
          ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s.1 t *
            f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ s : Ioi (0 : Real), B * (P s * ‖f (s.1 • w)‖)
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact norm_nonneg _
      · exact hPint.const_mul B
      · filter_upwards with s
        exact hpoint s
    _ = B * ∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- Pointwise fixed-time outer-region form.  This is the radial estimate in
the literal physical-space condition `20 ≤ ‖x‖`, rather than merely along a
chosen ray. -/
theorem exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le_at_point
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ x w : BRRSSpace d, ‖w‖ = 1 → 20 ≤ ‖x‖ →
      ‖brrsDyadicHalfWave Phi 0 t f x‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N ‖x‖ s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsDyadicHalfWave_levelZero_outer_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro t f hf x w hw hx
  obtain ⟨v, hv, hxray⟩ :=
    exists_unit_direction_eq_norm_smul (show 0 < d by omega) x
  calc
    ‖brrsDyadicHalfWave Phi 0 t f x‖ =
        ‖brrsDyadicHalfWave Phi 0 t f (‖x‖ • v)‖ :=
      congrArg (fun z : BRRSSpace d => ‖brrsDyadicHalfWave Phi 0 t f z‖) hxray
    _ ≤ (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (‖x‖ / 16)) ^ (d - 1)) *
          ∫ s : Ioi (0 : Real),
            brrsTwoRadiusNinePhaseProfile N ‖x‖ s.1 t * ‖f (s.1 • w)‖
            ∂Measure.volumeIoiPow (d - 1) :=
      hbound ‖x‖ t f hf v w hv hw hx

/-- Exact dyadic transport of the all-source outer stationary kernel bound.
The high-output hypothesis is stated in the natural scaled radius. -/
theorem exists_norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_outer_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      20 ≤ ((2 : Real) ^ j) * r → 0 ≤ s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
                  (((2 : Real) ^ j) * t)) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  have hq : 0 < (2 : Real) ^ j := pow_pos (by norm_num) _
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr (mul_nonneg hq.le hs))

/-- Fixed-time outer-region bound at every dyadic scale.  The output
condition is the literal high-radius condition after rescaling, and the
right side is an integrable all-nine radial phase majorant. -/
theorem exists_norm_brrsDyadicHalfWave_outer_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
      ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              ∫ s : Ioi (0 : Real),
                brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
                ∂Measure.volumeIoiPow (d - 1)) := by
  obtain ⟨C, hC, hkernel⟩ :=
    exists_norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_outer_ninePhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr
  let q : Real := (2 : Real) ^ j
  let P : Ioi (0 : Real) → Real := fun s =>
    brrsTwoRadiusNinePhaseProfile N (q * r) (q * s.1) (q * t)
  let B : Real := ‖q ^ d‖ *
    ((1 - (1 / 32 : Real)) *
      (C / (Real.sqrt ((q * r) / 16)) ^ (d - 1)))
  have hPint : Integrable (fun s : Ioi (0 : Real) => P s * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
    dsimp [P]
    exact integrable_brrsTwoRadiusNinePhaseProfile_mul_radialNorm
      (by omega) N (q * r) q (q * t) f hf w hw
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hK (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        B * P s := by
    change
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ ≤
        (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1))) *
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                  (((2 : Real) ^ j) * t))
    simpa only [mul_assoc] using hkernel j r s.1 t hr s.2.le
  have hpoint (s : Ioi (0 : Real)) :
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w)‖ ≤ B * (P s * ‖f (s.1 • w)‖) := by
    rw [norm_mul]
    calc
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t‖ *
          ‖f (s.1 • w)‖ ≤ (B * P s) * ‖f (s.1 • w)‖ :=
        mul_le_mul_of_nonneg_right (hK s) (norm_nonneg _)
      _ = B * (P s * ‖f (s.1 • w)‖) := by ring
  rw [brrsDyadicHalfWave_eq_dyadicAllStationaryComponentIntegralSum
    hd Phi j t f hf v w hv hw r (by
      by_contra hnonneg
      have hneg : r < 0 := lt_of_not_ge hnonneg
      have hscaled_neg : ((2 : Real) ^ j) * r < 0 :=
        mul_neg_of_pos_of_neg hq hneg
      linarith)]
  calc
    ‖∫ s : Ioi (0 : Real),
        brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
          f (s.1 • w) ∂Measure.volumeIoiPow (d - 1)‖ ≤
        ∫ s : Ioi (0 : Real),
          ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s.1 t *
            f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1) :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ s : Ioi (0 : Real), B * (P s * ‖f (s.1 • w)‖)
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact norm_nonneg _
      · exact hPint.const_mul B
      · filter_upwards with s
        exact hpoint s
    _ = B * ∫ s : Ioi (0 : Real), P s * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]
    _ = ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)) *
              ∫ s : Ioi (0 : Real),
                brrsTwoRadiusNinePhaseProfile N
                  (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                    (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
                ∂Measure.volumeIoiPow (d - 1)) := by
      dsimp only [B, P, q]
      ring

/-- The all-nine source integral is uniformly controlled by the polar
`L¹` trace of the radial datum.  This deliberately retains the literal
nine-phase profile on the left, while the right hand side is the source
quantity later normalized as `brrsRadialLpSourceProfile 1`. -/
theorem brrsTwoRadiusNinePhase_outerIntegral_le_nine_mul_radialL1
    {d N : Nat} (hd : 0 < d) (r q t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
      9 * ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hright : Integrable (fun s : Ioi (0 : Real) =>
      (9 : Real) * ‖f (s.1 • w)‖) (Measure.volumeIoiPow (d - 1)) :=
    hinput.norm.const_mul 9
  calc
    (∫ s : Ioi (0 : Real),
      brrsTwoRadiusNinePhaseProfile N r (q * s.1) t * ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) ≤
        ∫ s : Ioi (0 : Real), (9 : Real) * ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      apply integral_mono_of_nonneg
      · filter_upwards with s
        exact mul_nonneg
          (brrsTwoRadiusNinePhaseProfile_nonneg N r (q * s.1) t)
          (norm_nonneg _)
      · exact hright
      · filter_upwards with s
        exact mul_le_mul_of_nonneg_right
          (brrsTwoRadiusNinePhaseProfile_le_nine N r (q * s.1) t)
          (norm_nonneg _)
    _ = 9 * ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [integral_const_mul]

/-- The `p = 1` source-profile mass is literally the real polar radial
`L¹` trace after taking `toReal`.  This is a convenient exact bridge for
outer-region pointwise estimates. -/
theorem brrs_radialLpSourceProfile_one_mass_toReal_eq_polarL1
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
      (f : BRRSSpace d → Complex) w s).toReal =
      ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [brrs_lintegral_radialLpSourceProfile_one_eq_ofReal_integral hd f hf w hw]
  exact ENNReal.toReal_ofReal
    (integral_nonneg fun s : Ioi (0 : Real) => norm_nonneg _)

/-- The output half-density cancels exactly in the outer all-nine estimate.
This is the profile-retaining form intended for subsequent radial
integration; in particular it has not replaced the phase profile by a
constant. -/
theorem exists_norm_brrsDyadicHalfWave_outer_weighted_ninePhase_outerIntegral_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
      (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C *
            ∫ s : Ioi (0 : Real),
              brrsTwoRadiusNinePhaseProfile N
                (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
                  (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
              ∂Measure.volumeIoiPow (d - 1)) := by
  obtain ⟨C, hC, houter⟩ :=
    exists_norm_brrsDyadicHalfWave_outer_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr
  let D : Real :=
    (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)
  let J : Real := ∫ s : Ioi (0 : Real),
    brrsTwoRadiusNinePhaseProfile N
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
        (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  have hDpos : 0 < D := by
    dsimp [D]
    apply pow_pos
    apply Real.sqrt_pos.2
    exact div_pos (lt_of_lt_of_le (by norm_num) hr) (by norm_num)
  have hpoint : ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ *
        ((1 - (1 / 32 : Real)) * (C / D) * J) := by
    dsimp [D, J]
    simpa only [Real.norm_eq_abs] using houter j r t f hf v w hv hw hr
  change D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
    ‖((2 : Real) ^ j) ^ d‖ * ((1 - (1 / 32 : Real)) * C * J)
  calc
    D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        D * (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (C / D) * J)) :=
      mul_le_mul_of_nonneg_left hpoint hDpos.le
    _ = ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C * J) := by
      field_simp [ne_of_gt hDpos]

/-- A literal outer spatial estimate with the output half-density restored.
The remaining datum norm is exactly its polar radial `L¹` trace.  This is
the all-nine analogue of a weighted outer `L∞` bound and, unlike a crude
uniform kernel bound, preserves the source normalization needed for the
radial block argument. -/
theorem exists_norm_brrsDyadicHalfWave_outer_weighted_radialL1_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
      (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (9 * C)) *
            ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
              ∂Measure.volumeIoiPow (d - 1) := by
  obtain ⟨C, hC, houter⟩ :=
    exists_norm_brrsDyadicHalfWave_outer_ninePhase_outerIntegral_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r t f hf v w hv hw hr
  let D : Real :=
    (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1)
  let J : Real := ∫ s : Ioi (0 : Real),
    brrsTwoRadiusNinePhaseProfile N
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s.1)
        (((2 : Real) ^ j) * t) * ‖f (s.1 • w)‖
      ∂Measure.volumeIoiPow (d - 1)
  let I : Real := ∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
    ∂Measure.volumeIoiPow (d - 1)
  have hDpos : 0 < D := by
    dsimp [D]
    apply pow_pos
    apply Real.sqrt_pos.2
    exact div_pos (lt_of_lt_of_le (by norm_num) hr) (by norm_num)
  have hpoint : ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ *
        ((1 - (1 / 32 : Real)) * (C / D) * J) := by
    dsimp [D, J]
    simpa only [Real.norm_eq_abs] using houter j r t f hf v w hv hw hr
  have hsource : J ≤ 9 * I := by
    dsimp [J, I]
    exact brrsTwoRadiusNinePhase_outerIntegral_le_nine_mul_radialL1
      (d := d) (N := N) (by omega)
      (((2 : Real) ^ j) * r) ((2 : Real) ^ j)
      (((2 : Real) ^ j) * t) f hf w hw
  have hfactor : 0 ≤ ‖((2 : Real) ^ j) ^ d‖ *
      ((1 - (1 / 32 : Real)) * C) := by
    positivity
  change D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
    ‖((2 : Real) ^ j) ^ d‖ *
      ((1 - (1 / 32 : Real)) * (9 * C)) * I
  calc
    D * ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
        D * (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (C / D) * J)) :=
      mul_le_mul_of_nonneg_left hpoint hDpos.le
    _ = (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C)) * J := by
      field_simp [ne_of_gt hDpos]
    _ ≤ (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * C)) * (9 * I) :=
      mul_le_mul_of_nonneg_left hsource hfactor
    _ = ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) * (9 * C)) * I := by
      ring

/-- The preceding weighted outer estimate stated directly with the standard
one-dimensional `p = 1` radial source profile. -/
theorem exists_norm_brrsDyadicHalfWave_outer_weighted_sourceProfile_one_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r t : Real,
      ∀ f : BRRSSchwartz d,
      ∀ hf : IsRadial (f : BRRSSpace d → Complex),
      ∀ v w : BRRSSpace d, ‖v‖ = 1 → ‖w‖ = 1 →
      20 ≤ ((2 : Real) ^ j) * r →
      (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
          ‖brrsDyadicHalfWave Phi j t f (r • v)‖ ≤
