        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  apply sum_le_seven_mul_dyadicBlockCount_mul_of_uniform_kappa
    T j alpha K ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
  · intro m hm
    exact brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega f
      homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)
  · exact hK

/-- The outgoing dyadic radial decomposition satisfies the entropy-tail
version of the Section 5 weighted estimate.  This is the direct composition
of the profile Young bound, the block geometry, and the Legendre--Assouad
local-count tail. -/
theorem exists_tail_sum_brrsDyadicRadialBlockAdd_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockAdd T j m p W omega f) ≤
          7 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_sum_le_seven_mul_dyadicEntropy_mul_of_lt halpha hνq with
    ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  apply hJ j hj T hT
    ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
    (fun m => brrsDyadicRadialBlockAdd T j m p W omega f)
  intro m hm
  exact brrsDyadicRadialBlockAdd_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)

/-- The incoming counterpart of the entropy-tail Section 5 dyadic estimate.
-/
theorem exists_tail_sum_brrsDyadicRadialBlockSub_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1), brrsDyadicRadialBlockSub T j m p W omega f) ≤
          7 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_sum_le_seven_mul_dyadicEntropy_mul_of_lt halpha hνq with
    ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  apply hJ j hj T hT
    ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p)
    (fun m => brrsDyadicRadialBlockSub T j m p W omega f)
  intro m hm
  exact brrsDyadicRadialBlockSub_le_kappa T j m alpha p hp W omega f
    homega hf homega_pos homega_top hmass_pos hmass_top (hW m hm)

/-- The complete four-sign endpoint contribution has the same dyadic
local-count bound as either travelling sign separately.  This is the scalar
assembly step which keeps the two reflected `+s` phases in the literal
Section 5 estimate, rather than treating them as an implicit symmetry. -/
theorem sum_brrsDyadicRadialEndpointFourPhaseBlock_le_of_uniform_kappa
    (T : Finset Real) (j : Nat) (alpha p : Real) (K : ENNReal) (hp : 1 < p)
    (W omega f : Real → ENNReal)
    (homega : Measurable omega) (hf : Measurable f)
    (homega_pos : ∀ u : Real, 0 < omega u)
    (homega_top : ∀ u : Real, omega u ≠ ∞)
    (hmass_pos : 0 < ∫⁻ u : Real, omega u)
    (hmass_top : (∫⁻ u : Real, omega u) ≠ ∞)
    (hW : ∀ m : Nat, m ≤ j → ∀ r ∈
        Icc (brrsDyadicRadialBlockRadius j m : Real)
          (2 * (brrsDyadicRadialBlockRadius j m : Real)),
      W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha))
    (hK : ∀ m : Nat, m ≤ j → brrsDyadicKappa T j m alpha ≤ K) :
    (∑ m ∈ Finset.range (j + 1),
      brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
      28 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  let M : ENNReal :=
    (∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p
  calc
    (∑ m ∈ Finset.range (j + 1),
        brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
        ∑ m ∈ Finset.range (j + 1),
          28 * brrsDyadicKappa T j m alpha * M := by
      apply Finset.sum_le_sum
      intro m hm
      exact brrsDyadicRadialEndpointFourPhaseBlock_le_kappa
        T j m alpha p hp W omega f homega hf homega_pos homega_top
        hmass_pos hmass_top (hW m (Nat.lt_succ_iff.mp (Finset.mem_range.mp hm)))
    _ = 28 * (∑ m ∈ Finset.range (j + 1),
          brrsDyadicKappa T j m alpha) * M := by
      simp_rw [mul_assoc]
      rw [← Finset.mul_sum, ← Finset.sum_mul]
    _ ≤ 28 * ((j + 1 : ENNReal) * K) * M := by
      simpa only [mul_comm, mul_left_comm, mul_assoc] using
        (mul_le_mul_right
          (mul_le_mul_left
            (sum_brrsDyadicKappa_le_of_uniform_bound T j alpha K hK) 28) M)
    _ = 28 * ((j + 1 : ENNReal) * K) *
        ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
      rfl

/-- The literal four endpoint phases consume a strict
Legendre--Assouad entropy bound simultaneously.  This is the dyadic
Section 5 scalar estimate used before inserting the two-radius stationary
kernel: it includes `t ± r ± s`, with no endpoint sign omitted. -/
theorem exists_tail_sum_brrsDyadicRadialEndpointFourPhaseBlock_le_inv_rpow_of_lt
    {E : Set Real} {alpha q : Real} (halpha : 0 ≤ alpha)
    (hνq : brrsLegendreAssouadFunction E alpha < q) :
    ∃ J : Nat, ∀ j ≥ J, ∀ T : Finset Real, IsDyadicDiscretization E j T →
      ∀ (p : Real) (W omega f : Real → ENNReal), 1 < p →
        Measurable omega → Measurable f →
        (∀ u : Real, 0 < omega u) → (∀ u : Real, omega u ≠ ∞) →
        0 < ∫⁻ u : Real, omega u → (∫⁻ u : Real, omega u) ≠ ∞ →
        (∀ m : Nat, m ≤ j → ∀ r ∈
          Icc (brrsDyadicRadialBlockRadius j m : Real)
            (2 * (brrsDyadicRadialBlockRadius j m : Real)),
          W r ≤ (brrsDyadicRadialBlockRadius j m : ENNReal) ^ (-alpha)) →
        (∑ m ∈ Finset.range (j + 1),
          brrsDyadicRadialEndpointFourPhaseBlock T j m p W omega f) ≤
          28 * ((j + 1 : ENNReal) *
            ((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) :
              ENNReal)⁻¹) ^ q) *
            ((∫⁻ u : Real, omega u) ^ p * ∫⁻ s : Real, (f s) ^ p) := by
  rcases exists_tail_brrsDyadicKappa_le_inv_rpow_of_lt halpha hνq with ⟨J, hJ⟩
  refine ⟨J, ?_⟩
  intro j hj T hT p W omega f hp homega hf homega_pos homega_top hmass_pos hmass_top hW
  exact sum_brrsDyadicRadialEndpointFourPhaseBlock_le_of_uniform_kappa
    T j alpha p
    (((Auto.Spherical.LegendreAssouad.dyadicMultiplicativeScale (j + 1) : ENNReal)⁻¹) ^ q)
    hp W omega f homega hf homega_pos homega_top hmass_pos hmass_top hW
    (fun m hm => hJ j hj T hT m hm)

end

/-! ### Finite-time product-space norm bridge

The Riesz--Thorin transport theorem uses a single output measure space, while
the BRRS output is a finite family of spatial functions.  The next equality
identifies the literal `\ell^p(L^p)` norm with an ordinary product-space norm.
-/

/-- The BRRS finite-time `\ell^p(L^p)` norm is exactly the `L^p` norm on the
product of the finite time subtype (with counting measure) and physical
space.  The explicit `AEMeasurable` hypothesis is precisely the Fubini
hypothesis and is the only analytic input needed for this conversion. -/
theorem discreteLpNorm_eq_eLpNorm_finset_counting_product
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hprod : AEMeasurable
      (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2)
      (Measure.count.prod volume)) :
    discreteLpNorm p T u =
      eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume) := by
  apply ENNReal.rpow_left_injective hp.ne'
  change (discreteLpNorm p T u) ^ p =
    (eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
      u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume)) ^ p
  have hdisc : (discreteLpNorm p T u) ^ p =
      ∑ t ∈ T, ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p := by
    exact discreteLpNorm_rpow_eq_sum_lintegral_ofReal_norm_rpow hp T u
  have hprodPow : AEMeasurable
      (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        (ENNReal.ofReal ‖u (z.1 : Real) z.2‖) ^ p)
      (Measure.count.prod volume) := by
    have hrewrite :
        (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          (ENNReal.ofReal ‖u (z.1 : Real) z.2‖) ^ p) =
        fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          ‖u (z.1 : Real) z.2‖ₑ ^ p := by
      funext z
      simp only [ofReal_norm]
    rw [hrewrite]
    change AEMeasurable
      ((fun a : ENNReal => a ^ p) ∘
        fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
          ‖u (z.1 : Real) z.2‖ₑ)
      (Measure.count.prod volume)
    exact ENNReal.continuous_rpow_const.measurable.comp_aemeasurable hprod.enorm
  rw [hdisc]
  rw [← Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp]
  rw [MeasureTheory.lintegral_prod _ hprodPow]
  rw [MeasureTheory.lintegral_count, tsum_fintype]
  exact (Finset.sum_subtype T (fun t => by
    change t ∈ T ↔ t ∈ T
    rfl) fun t =>
    ∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖u t x‖) ^ p)

/-- Measurability of a finite family of spatial functions is equivalent to
measurability of the associated function on counting-time times space.  This
is the direct measurability bridge needed to instantiate the product-output
form of Riesz--Thorin. -/
theorem measurable_finset_time_product_of_measurable
    {d : Nat} (T : Finset Real) (u : Real → BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, Measurable (u t)) :
    Measurable (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
      u (z.1 : Real) z.2) := by
  apply measurable_from_prod_countable_right
  intro t
  exact hu (t : Real) (by simpa using t.property)

/-- A slice-wise measurable finite-time output automatically satisfies the
Fubini hypothesis in `discreteLpNorm_eq_eLpNorm_finset_counting_product`. -/
theorem discreteLpNorm_eq_eLpNorm_finset_counting_product_of_measurable
    {d : Nat} {p : Real} (hp : 0 < p) (T : Finset Real)
    (u : Real → BRRSSpace d → Complex)
    (hu : ∀ t ∈ T, Measurable (u t)) :
    discreteLpNorm p T u =
      eLpNorm (fun z : ({t : Real // t ∈ (T : Set Real)}) × BRRSSpace d =>
        u (z.1 : Real) z.2) (ENNReal.ofReal p) (Measure.count.prod volume) := by
  apply discreteLpNorm_eq_eLpNorm_finset_counting_product hp T u
  exact (measurable_finset_time_product_of_measurable T u hu).aemeasurable

/-! ### Conditional radial Schwartz-core extension

The ordinary `SchwartzMap.denseRange_toLpCLM` theorem is a density statement
in the full `L^p` space.  It does not by itself preserve the radial subspace,
which is the domain of the BRRS core estimate.  We therefore isolate the
precise radial approximation and canonical-output continuity statements that
are needed to promote a Schwartz-core estimate.  No instance of either
condition is asserted here.
-/

/-- Package an ordinary real lower exponent bound as the `Lp` typeclass
assumption used by the topology on `Lp`. -/
theorem brrsFactOneLeOfReal {p : Real} (hp : 1 ≤ p) :
    Fact (1 ≤ ENNReal.ofReal p) :=
  ⟨ENNReal.one_le_ofReal.mpr hp⟩

/-- A radial `L^p` function can be approximated in the actual `Lp` space by
pointwise radial Schwartz functions.  This is deliberately a hypothesis: the
ambient Schwartz density theorem does not establish radial density without a
separate radialization argument. -/
def HasRadialSchwartzLpApproximation {d : Nat} (p : Real)
    [Fact (1 ≤ ENNReal.ofReal p)] : Prop :=
  ∀ (f : BRRSSpace d → Complex) (hf : MemLp f (ENNReal.ofReal p) volume),
    IsAERadial f →
      ∃ u : Nat → BRRSSchwartz d,
        (∀ n : Nat, IsRadial (u n : BRRSSpace d → Complex)) ∧
          Tendsto (fun n => (u n).toLp (ENNReal.ofReal p) volume) atTop
            (𝓝 (hf.toLp f))

/-- The canonical finite-time convolution realization is continuous along a
radial Schwartz approximation, after its literal Schwartz formula is used on
each approximant.  This records exactly the finite-product continuity needed
by the extension step; it is not a substitute for proving that continuity. -/
def HasRadialSchwartzCoreConvergence {d : Nat} (Φ : BRRSAnnularCutoff)
    (W : BRRSLpHalfWaveExtension d Φ) (p : Real)
    [Fact (1 ≤ ENNReal.ofReal p)] : Prop :=
  ∀ (j : Nat) (T : Finset Real) (f : BRRSSpace d → Complex)
    (hf : MemLp f (ENNReal.ofReal p) volume), IsAERadial f →
    ∀ u : Nat → BRRSSchwartz d,
      (∀ n : Nat, IsRadial (u n : BRRSSpace d → Complex)) →
      Tendsto (fun n => (u n).toLp (ENNReal.ofReal p) volume) atTop
        (𝓝 (hf.toLp f)) →
        Tendsto
          (fun n => discreteLpNorm p T
            (fun t => brrsDyadicHalfWave Φ j t (u n))) atTop
          (𝓝 (discreteLpNorm p T (fun t => W.apply j t f)))

/-- A radial Schwartz-core BRRS estimate extends with the *same constant* to
any prescribed `L^p` realization once the explicit radial approximation and
finite-time output-convergence hypotheses above have been supplied.

This is only a conditional transfer principle.  In particular, it does not
claim radial Schwartz density, nor does it claim the required continuity for
the canonical convolution realization. -/
theorem uniformEstimateAtExponent_of_schwartzCore_of_radialSchwartzApproximation
    {d : Nat} (Φ : BRRSAnnularCutoff) (W : BRRSLpHalfWaveExtension d Φ)
    (E : Set Real) (p s : Real)
    [Fact (1 ≤ ENNReal.ofReal p)]
    (hcore : SchwartzCoreUniformEstimateAtExponent (d := d) Φ E p s)
    (happrox : HasRadialSchwartzLpApproximation (d := d) p)
    (houtput : HasRadialSchwartzCoreConvergence Φ W p) :
    UniformEstimateAtExponent Φ W E p s := by
  rcases hcore with ⟨K, hK, hcore⟩
  refine ⟨K, hK, ?_⟩
  intro j hj T hT f hf hfradial
  obtain ⟨u, huradial, hu⟩ := happrox f hf hfradial
  have huNorm : Tendsto
      (fun n => eLpNorm (u n : BRRSSpace d → Complex) (ENNReal.ofReal p) volume)
      atTop (𝓝 (eLpNorm f (ENNReal.ofReal p) volume)) := by
    have h := (continuous_id.enorm.tendsto (hf.toLp f)).comp hu
    change Tendsto (fun n => ‖(u n).toLp (ENNReal.ofReal p) volume‖ₑ) atTop
      (𝓝 ‖hf.toLp f‖ₑ) at h
    simpa only [SchwartzMap.toLp, Lp.enorm_toLp] using h
  have huOutput := houtput j T f hf hfradial u huradial hu
  have huRHS : Tendsto
      (fun n => ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm (u n : BRRSSpace d → Complex) (ENNReal.ofReal p) volume)
      atTop
      (𝓝 (ENNReal.ofReal (K * (2 : Real) ^ ((j : Real) * s)) *
        eLpNorm f (ENNReal.ofReal p) volume)) :=
    ((ENNReal.continuous_const_mul ENNReal.ofReal_ne_top).tendsto _).comp huNorm
  apply le_of_tendsto_of_tendsto huOutput huRHS
  exact Eventually.of_forall fun n =>
    hcore j hj T hT (u n) (huradial n)

end Auto.Spherical.FractalDilations.BRRS


/-! ### Low-radius stationary amplitudes

The stationary decomposition also needs a compact-radius counterpart to the
high-radius estimates above.  Here the physical phase scale is bounded, so the
global derivative bounds for the one-dimensional endpoint and middle profiles
give a uniform estimate without any nonstationary denominator. -/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- On the low-radius region the linear stationary frequency scale is bounded
by the numerical constant used throughout the level-zero annulus estimates. -/
private theorem brrs_lowRadius_phaseScale_le
    {a : Real} (ha0 : 0 <= a) (ha : a <= 16) :
    |2 * Real.pi * a| <= 128 := by
  have htwopi0 : 0 <= 2 * Real.pi := by positivity
  have hphase0 : 0 <= 2 * Real.pi * a :=
    mul_nonneg htwopi0 ha0
  rw [abs_of_nonneg hphase0]
  have htwopi : 2 * Real.pi <= 8 := by
    nlinarith [Real.pi_lt_four]
  calc
    2 * Real.pi * a <= 8 * a :=
      mul_le_mul_of_nonneg_right htwopi ha0
    _ <= 8 * 16 := mul_le_mul_of_nonneg_left ha (by norm_num)
    _ = 128 := by norm_num

/-- Every fixed radial derivative of every BRRS surface-wave amplitude is
uniformly bounded when the physical radius lies in the compact interval
`[0, 16]`.  The estimate is global in the radial frequency variable, hence in
particular applies on the literal annulus `[1/32,1]`. -/
theorem exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound
    (d k : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 0 <= a -> a <= 16 ->
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d part a u) rho‖ <= C := by
  cases part with
  | outgoing =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| <= 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field, norm_mul]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            ‖iteratedDeriv k (fun u : Real =>
              smoothEndpointQuadraticIntegral (d - 2) ((2 * Real.pi * a) * u)) rho‖ <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (B * |2 * Real.pi * a| ^ k) :=
          mul_le_mul_of_nonneg_left (hbound (2 * Real.pi * a) rho) (norm_nonneg _)
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith
  | incoming =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_iteratedDeriv_smoothEndpointQuadraticIntegral_comp_mul_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |-(2 * Real.pi * a)| <= 128 := by
        rw [abs_neg]
        exact brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |-(2 * Real.pi * a)| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field, norm_mul]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            ‖iteratedDeriv k (fun u : Real =>
              smoothEndpointQuadraticIntegral (d - 2) ((-(2 * Real.pi * a)) * u)) rho‖ <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (B * |-(2 * Real.pi * a)| ^ k) :=
          mul_le_mul_of_nonneg_left (hbound (-(2 * Real.pi * a)) rho) (norm_nonneg _)
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |-(2 * Real.pi * a)| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith
  | middle =>
      obtain ⟨B, hB, hbound⟩ :=
        exists_norm_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_le (d - 2) k
      let C : Real := ‖(surfaceMass (d - 1) : Complex)‖ * B * 128 ^ k + 1
      refine ⟨C, by dsimp [C]; positivity, ?_⟩
      intro a rho ha0 ha
      have hscale : |2 * Real.pi * a| <= 128 :=
        brrs_lowRadius_phaseScale_le ha0 ha
      have hpow : |2 * Real.pi * a| ^ k <= (128 : Real) ^ k :=
        pow_le_pow_left₀ (abs_nonneg _) hscale _
      have hk : ((k : ENat) : WithTop ENat) <= ((⊤ : ENat) : WithTop ENat) := by
        exact_mod_cast le_top
      unfold brrsSurfaceWaveAmplitude
      rw [iteratedDeriv_const_mul_field,
        iteratedDeriv_comp_const_smul
          ((contDiff_coordinateMiddleMeridianLocalizedIntegral (d - 2)).of_le hk),
        norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
      calc
        ‖(surfaceMass (d - 1) : Complex)‖ *
            (|2 * Real.pi * a| ^ k *
              ‖iteratedDeriv k
                (coordinateMiddleMeridianLocalizedIntegral (d - 2))
                ((2 * Real.pi * a) * rho)‖) <=
            ‖(surfaceMass (d - 1) : Complex)‖ *
              (|2 * Real.pi * a| ^ k * B) := by
          gcongr
          exact hbound _
        _ = (‖(surfaceMass (d - 1) : Complex)‖ * B) * |2 * Real.pi * a| ^ k := by
          ring
        _ <= (‖(surfaceMass (d - 1) : Complex)‖ * B) * (128 : Real) ^ k := by
          exact mul_le_mul_of_nonneg_left hpow (mul_nonneg (norm_nonneg _) hB.le)
        _ <= C := by
          dsimp [C]
          linarith

/-- Finitely many radial derivatives of a BRRS surface-wave amplitude admit
one simultaneous bound on the compact low-radius region and the level-zero
frequency annulus.  This is the form used in finite-order integration by
parts. -/
theorem exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound
    (d N : Nat) (part : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ a rho : Real,
      0 <= a -> a <= 16 -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsSurfaceWaveAmplitude d part a u) rho‖ <= C := by
  choose A hApos hAbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d k part
  let C : Real := ∑ k ∈ Finset.range (N + 1), A k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 <= C := by
      dsimp [C]
      exact Finset.single_le_sum (fun k hk => (hApos k).le) hzero
    exact lt_of_lt_of_le (hApos 0) hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha0 ha hrho
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : A k <= C := by
    dsimp [C]
    exact Finset.single_le_sum (fun l hl => (hApos l).le) hkmem
  exact (hAbound k a rho ha0 ha).trans hle

/-- When one physical radius is in the compact low-radius region and the
other is high, the two-radius stationary coefficient retains exactly the
high-radius half-density decay.  This is the mixed counterpart of the
high--high differential estimate. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
    {d N : Nat} (hd : 3 <= d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ r s rho : Real,
      0 <= r -> r <= 16 -> 16 <= s -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ <=
          C / (Real.sqrt (s / 16)) ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_lowRadius_bound d N partR
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 <= C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr0 hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d partR r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d partR r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hqpos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l <= k ->
      ‖iteratedDeriv l left rho‖ <= A := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr0 hr hrho
  have hrightbound : ∀ l : Nat, l <= k ->
      ‖iteratedDeriv l right rho‖ <=
        B / (Real.sqrt (s / 16)) ^ (d - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright hA.le
    (div_nonneg hB.le hqpos.le) hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    exact brrsTwoRadiusStationaryCoefficient_eq_amplitude_mul_coefficient
      Phi d partR partS r s u
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B <= C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ <=
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (s / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (s / 16)) ^ (d - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (s / 16)) ^ (d - 1)) hqpos.ne']
    _ <= C / (Real.sqrt (s / 16)) ^ (d - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ <= (C + 1) / (Real.sqrt (s / 16)) ^ (d - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- The two-radius stationary coefficient is symmetric in its two labelled
surface-wave factors. -/
theorem brrsTwoRadiusStationaryCoefficient_swap
    (Phi : BRRSAnnularCutoff) (d : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s rho : Real) :
    brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho =
      brrsTwoRadiusStationaryCoefficient Phi d partS partR s r rho := by
  unfold brrsTwoRadiusStationaryCoefficient
  ring

/-- The counterpart of the low--high estimate with the first physical radius
high and the second in the compact low-radius region. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highLow_decay
    {d N : Nat} (hd : 3 <= d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k <= N -> ∀ r s rho : Real,
      16 <= r -> 0 <= s -> s <= 16 -> rho ∈ Icc (1 / 32 : Real) 1 ->
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ <=
          C / (Real.sqrt (r / 16)) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
      (d := d) (N := N) hd Phi partS partR
  refine ⟨C, hC, ?_⟩
  intro k hk r s rho hr hs0 hs hrho
  have hswap : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) =
      fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d partS partR s r u := by
    funext u
    exact brrsTwoRadiusStationaryCoefficient_swap Phi d partR partS r s u
  rw [hswap]
  exact hbound k hk s r rho hs0 hs hr hrho

/-- A reusable rapid-profile estimate for a compact frequency integral once
all radial derivatives of its stationary coefficient have a common spatial
weight.  The hypotheses deliberately separate the geometric radius condition
from the integration-by-parts argument, so the lemma applies equally to the
low--high and high--low regimes. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
    {d N : Nat} (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart)
    (H : Real → Real → Prop) (q : Real → Real → Real)
    (hq : ∀ r s : Real, H r s → 0 < q r s)
    (hderiv : ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      H r s → rho ∈ Icc (1 / 32 : Real) 1 →
        ‖iteratedDeriv k (fun u : Real =>
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s u) rho‖ ≤
          C / q r s) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, H r s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) * (C / q r s) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hbound⟩ := hderiv
  refine ⟨C, hC, ?_⟩
  intro r s freq hrs
  have hqpos : 0 < q r s := hq r s hrs
  have hCq_nonneg : 0 ≤ C / q r s :=
    div_nonneg hC.le hqpos.le
  have huniform : ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤
      (1 - (1 / 32 : Real)) * (C / q r s) := by
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤
          (C / q r s) * |1 - (1 / 32 : Real)| := by
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro rho hrho
        have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
          rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
          exact ⟨hrho.1.le, hrho.2⟩
        rw [norm_mul, norm_oscillatoryExp, mul_one]
        exact hbound 0 (Nat.zero_le _) r s rho hrs hrho'
      _ = (1 - (1 / 32 : Real)) * (C / q r s) := by
        rw [abs_of_nonneg (by norm_num : (0 : Real) ≤ 1 - 1 / 32)]
        ring
  let A : Real := (1 - (1 / 32 : Real)) * (C / q r s)
  have hAnonneg : 0 ≤ A := by
    dsimp [A]
    exact mul_nonneg (by norm_num) hCq_nonneg
  have huniform' : ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A := by
    simpa only [A] using huniform
  change ‖∫ rho in (1 / 32 : Real)..1,
      brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
        oscillatoryExp freq rho‖ ≤ A * brrsStationaryRapidProfile N freq
  by_cases hfreq : freq = 0
  · simpa [brrsStationaryRapidProfile, hfreq] using huniform'
  · rw [brrsStationaryRapidProfile, if_neg hfreq]
    let z : Real := (1 / |freq|) ^ N
    have hchain := hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
      (fun rho : Real => brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho)
      (contDiff_brrsTwoRadiusStationaryCoefficient Phi d partR partS r s)
      (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_lower
        Phi d partR partS r s)
      (brrsTwoRadiusStationaryCoefficient_eventuallyEq_zero_at_upper
        Phi d partR partS r s) N
    have hdecay' : ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤ z * A := by
      dsimp [z, A]
      simpa only [iteratedDeriv_zero] using
        (norm_intervalIntegral_mul_oscillatoryExp_le_iterated
          (F := fun k => iteratedDeriv k
            (fun rho : Real =>
              brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho))
          (N := N) (by norm_num : (1 / 32 : Real) ≤ 1) hfreq hchain
          hCq_nonneg
          (fun rho hrho => hbound N le_rfl r s rho hrs hrho))
    calc
      ‖∫ rho in (1 / 32 : Real)..1,
          brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
            oscillatoryExp freq rho‖ ≤ min A (z * A) :=
        le_min huniform' hdecay'
      _ = A * min 1 z := by
        calc
          min A (z * A) = min (A * 1) (A * z) := by
            congr 1 <;> ring
          _ = A * min 1 z := (mul_min_of_nonneg 1 z hAnonneg).symm
      _ = A * min 1 ((1 / |freq|) ^ N) := by rfl

/-- In the low--high radial regime, a two-radius stationary component has
the one high-radius half-density and a rapidly decaying scalar phase profile. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowHigh_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      (d := d) (N := N) Phi partR partS
      (fun r s => 0 ≤ r ∧ r ≤ 16 ∧ 16 ≤ s)
      (fun _ s => (Real.sqrt (s / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply pow_pos
        apply Real.sqrt_pos.2
        linarith [hrs.2.2])
      (by
        obtain ⟨D, hD, hbound⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_lowHigh_decay
            (d := d) (N := N) hd Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hbound k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr0 hr hs
  exact hprofile r s freq ⟨hr0, hr, hs⟩

/-- In the high--low radial regime, a two-radius stationary component has
the one high-radius half-density and a rapidly decaying scalar phase profile. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highLow_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d partR partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      (d := d) (N := N) Phi partR partS
      (fun r s => 16 ≤ r ∧ 0 ≤ s ∧ s ≤ 16)
      (fun r _ => (Real.sqrt (r / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply pow_pos
        apply Real.sqrt_pos.2
        linarith [hrs.1])
      (by
        obtain ⟨D, hD, hbound⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_highLow_decay
            (d := d) (N := N) hd Phi partR partS
        refine ⟨D, hD, ?_⟩
        intro k hk r s rho hrs hrho
        exact hbound k hk r s rho hrs.1 hrs.2.1 hrs.2.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs0 hs
  exact hprofile r s freq ⟨hr, hs0, hs⟩

/-- The low--high profile estimate expressed with the literal stationary
carrier restored. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_lowHigh_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      0 ≤ r → r ≤ 16 → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (s / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_lowHigh_profile_le
      (d := d) (N := N) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr0 hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr0 hr hs

/-- The high--low profile estimate expressed with the literal stationary
carrier restored. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_highLow_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff)
    (partR partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real,
      16 ≤ r → 0 ≤ s → s ≤ 16 →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / (Real.sqrt (r / 16)) ^ (d - 1)) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase partR r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highLow_profile_le
      (d := d) (N := N) hd Phi partR partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs0 hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase partR r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr hs0 hs

/-! ### The initial radial block `I_0`

The dyadic main-block package starts at the annulus `[h, 2h]`.  The
initial interval `[0, h]` in the proof of BRRS Proposition 5.1 instead uses
the separation of the sampled times: each time has a fixed `O(h)` local
input interval, and these intervals have bounded overlap.  This section
records only that geometric bookkeeping.  The analytic local-profile and
off-diagonal hypotheses remain explicit below.
-/

/-- A finite `len`-separated subset of an interval of length `n * len` has
at most `n + 1` elements. -/
theorem brrs_card_le_succ_of_separated_in_interval
    {S : Finset Real} {a len : Real} {n : Nat} (hlen : 0 < len)
    (hsub : ∀ x ∈ S, x ∈ Icc a (a + (n : Real) * len))
    (hsep : ∀ x ∈ S, ∀ y ∈ S, x ≠ y → len ≤ |x - y|) :
    S.card ≤ n + 1 := by
  classical
  have hcard : S.card ≤ (Finset.Icc (0 : Int) (n : Int)).card := by
    refine Finset.card_le_card_of_injOn (fun x => ⌊(x - a) / len⌋) ?_ ?_
    · intro x hx
      obtain ⟨hleft, hright⟩ := hsub x hx
      have hq0 : (0 : Real) ≤ (x - a) / len :=
        div_nonneg (by linarith) hlen.le
      have hqn : (x - a) / len ≤ (n : Real) := by
        rw [div_le_iff₀ hlen]
        linarith
      refine Finset.mem_Icc.mpr ⟨Int.le_floor.mpr (by simpa using hq0), ?_⟩
      have hfloor := Int.floor_le_floor hqn
      simpa using hfloor
    · intro x hx y hy hfloor
      by_contra hxy
      have hfx : ((⌊(x - a) / len⌋ : Int) : Real) ≤ (x - a) / len :=
        Int.floor_le _
      have hfy : ((⌊(y - a) / len⌋ : Int) : Real) ≤ (y - a) / len :=
        Int.floor_le _
      have hfx' : (x - a) / len < ((⌊(x - a) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hfy' : (y - a) / len < ((⌊(y - a) / len⌋ : Int) : Real) + 1 :=
        Int.lt_floor_add_one _
      have hfloor' : ⌊(x - a) / len⌋ = ⌊(y - a) / len⌋ := hfloor
      rw [hfloor'] at hfx hfx'
      have hdiff : |(x - a) / len - (y - a) / len| < 1 := by
        rw [abs_lt]
        constructor <;> linarith
      have hlenne : len ≠ 0 := hlen.ne'
      have hxydiv : (x - a) / len - (y - a) / len = (x - y) / len := by
        field_simp
        ring
      rw [hxydiv, abs_div, abs_of_pos hlen, div_lt_one hlen] at hdiff
      exact absurd (hsep x hx y hy hxy) (not_le.mpr hdiff)
  simpa using hcard

/-- The local time interval used for the initial radial block.  Its radius is
eight mesh lengths, matching the localization in BRRS (5.7). -/
def brrsI0TimeCell (h t : Real) : Set Real :=
  Icc (t - 8 * h) (t + 8 * h)

/-- The dyadic specialization of `brrsI0TimeCell`. -/
def brrsDyadicI0TimeCell (j : Nat) (t : Real) : Set Real :=
  brrsI0TimeCell (dyadicTimeScale j) t

/-- At most seventeen pairwise `h`-separated sample times have local
`I_0`-intervals containing one fixed point. -/
theorem brrsI0TimeCell_overlap_le_seventeen
    (T : Finset Real) {h : Real} (hh : 0 < h)
    (hsep : IsSeparated T h) (x : Real) :
    (∑ t ∈ T,
      (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) ≤ 17 := by
  classical
  let Sx : Finset Real := T.filter (fun t => x ∈ brrsI0TimeCell h t)
  have hsub : ∀ t ∈ Sx, t ∈ Icc (x - 8 * h) ((x - 8 * h) + (16 : Real) * h) := by
    intro t ht
    have ht' : t ∈ T ∧ x ∈ brrsI0TimeCell h t := by
      simpa only [Sx, Finset.mem_filter] using ht
    simp only [brrsI0TimeCell, mem_Icc] at ht' ⊢
    constructor <;> linarith
  have hseparated : ∀ t ∈ Sx, ∀ u ∈ Sx, t ≠ u → h ≤ |t - u| := by
    intro t ht u hu htu
    have ht' : t ∈ T ∧ x ∈ brrsI0TimeCell h t := by
      simpa only [Sx, Finset.mem_filter] using ht
    have hu' : u ∈ T ∧ x ∈ brrsI0TimeCell h u := by
      simpa only [Sx, Finset.mem_filter] using hu
    exact hsep (by simpa using ht'.1) (by simpa using hu'.1) htu
  have hcard : Sx.card ≤ 17 := by
    simpa only [show (16 : Nat) + 1 = 17 by norm_num] using
      (brrs_card_le_succ_of_separated_in_interval (n := 16) hh hsub hseparated)
  have hsum :
      (∑ t ∈ T,
        (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) =
        (Sx.card : ENNReal) := by
    calc
      (∑ t ∈ T,
          (brrsI0TimeCell h t).indicator (fun _ => (1 : ENNReal)) x) =
          ∑ t ∈ T, if x ∈ brrsI0TimeCell h t then (1 : ENNReal) else 0 := by
        apply Finset.sum_congr rfl
        intro t ht
        simp only [Set.indicator]
      _ = (Sx.card : ENNReal) := by
        rw [Finset.sum_boole]
  rw [hsum]
  exact_mod_cast hcard

/-- The dyadic local-time intervals inherit the same bounded overlap from a
BRRS discretization. -/
theorem brrsDyadicI0TimeCell_overlap_le_seventeen
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) (x : Real) :
    (∑ t ∈ T,
      (brrsDyadicI0TimeCell j t).indicator (fun _ => (1 : ENNReal)) x) ≤ 17 := by
  simpa only [brrsDyadicI0TimeCell] using
    (brrsI0TimeCell_overlap_le_seventeen T
      (by
        unfold dyadicTimeScale
        positivity)
      hT.separated x)

/-- Conditional summation for the initial radial block.  The premise is the
entire analytic input: for every sampled time, its radial mass on `[0,h]` is
controlled by a nonnegative profile on the corresponding local time cell.
The conclusion uses only finite separation and bounded overlap; in
particular, it does not assert an unproved estimate for any half-wave
kernel. -/
theorem brrs_sum_I0_lintegral_le_of_local_profile
    (T : Finset Real) {h : Real} (hh : 0 < h)
    (hsep : IsSeparated T h) (H : Real → Real → ENNReal)
    (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) h, H t r) ≤
        ∫⁻ x in brrsI0TimeCell h t, G x) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) h, H t r) ≤
      17 * ∫⁻ x, G x := by
  have hbound := brrs_fibered_interval_lintegral_le_of_profile_count_and_overlap
    (s := T) (J := brrsI0TimeCell h) (points := fun t : Real => {t})
    (R := Icc (0 : Real) h) (H := H) (G := G) (K := (1 : ENNReal))
    (M := (17 : ENNReal)) hG
    (by
      intro t ht
      exact measurableSet_Icc)
    (by
      intro t ht
      simp)
    (by
      intro x
      exact brrsI0TimeCell_overlap_le_seventeen T hh hsep x)
    (by
      intro t ht u hu
      have htu : u = t := Finset.mem_singleton.mp hu
      subst u
      exact hprofile t ht)
  simpa using hbound

/-- The preceding conditional initial-block estimate in the exact dyadic
notation used by BRRS. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_local_profile
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T) (H : Real → Real → ENNReal)
    (G : Real → ENNReal) (hG : Measurable G)
    (hprofile : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        ∫⁻ x in brrsDyadicI0TimeCell j t, G x) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x, G x := by
  simpa only [brrsDyadicI0TimeCell] using
    (brrs_sum_I0_lintegral_le_of_local_profile T
      (by
        unfold dyadicTimeScale
        positivity)
      hT.separated H G hG hprofile)

/-- Uniform all-order rapid high-radius decay for the middle stationary
surface-wave amplitude.  The exponent `M` is retained, rather than being
specialized to the ambient-dimensional endpoint scale. -/
theorem exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
    {d N M : Nat} (_hd : 3 ≤ d) (hM : 2 ≤ M) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay d k (M + k)
  let C : Real := ∑ k ∈ Finset.range (N + 1), B k * (128 : Real) ^ k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 * (128 : Real) ^ (0 : Nat) ≤ C := by
      dsimp [C]
      exact Finset.single_le_sum
        (fun k hk => mul_nonneg (hBpos k).le
          (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) k)) hzero
    have hterm : 0 < B 0 * (128 : Real) ^ (0 : Nat) := by
      simpa using hBpos 0
    exact lt_of_lt_of_le hterm hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha hrho
  obtain ⟨hfreq, hamp, hscale, _⟩ :=
    brrs_highRadius_frequency_geometry ha hrho
  have hs : 1 ≤ a / 16 := by linarith
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrapid := brrs_rapid_middle_denominator_le_scale
    (d := M) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
    (lambda := |(2 * Real.pi * a) * rho|) (C := B k) (L := 128)
    hM hs (hBpos k).le (by positivity) hamp hscale
  have hkmem : k ∈ Finset.range (N + 1) :=
    Finset.mem_range.mpr (by omega)
  have hCbound : B k * (128 : Real) ^ k ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (fun l hl => mul_nonneg (hBpos l).le
        (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) l)) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude d .middle a u) rho‖ ≤
        B k * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ (M + k) :=
      hBbound k a rho hfreq
    _ ≤ (B k * 128 ^ k) / (Real.sqrt (a / 16)) ^ (M - 1) := hrapid
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le

/-- The compact radial coefficient inherits the all-order rapid high-radius
decay of its middle stationary-wave factor. -/
theorem exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_middle_highRadius_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsStationaryWaveRadialCoefficient Phi d .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialFixedFactor_bound Phi d N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk a rho ha hrho
  let fixed : Real → Complex := brrsStationaryWaveRadialFixedFactor Phi d
  let physical : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle a u
  have hfixed : ContDiff Real (⊤ : ENat) fixed := by
    dsimp [fixed]
    exact contDiff_brrsStationaryWaveRadialFixedFactor Phi d
  have hphysical : ContDiff Real (⊤ : ENat) physical := by
    dsimp [physical]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle a
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hphysicalBound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l physical rho‖ ≤
        B / (Real.sqrt (a / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) a rho ha hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hfixed hphysical hA.le
    (div_nonneg hB.le hqpos.le)
    (fun l hl => hAbound l (hl.trans hk) rho hrho)
    hphysicalBound
  have hfactorfun : (fun u : Real =>
      brrsStationaryWaveRadialCoefficient Phi d .middle a u) =
      fun u : Real => fixed u * physical u := by
    funext u
    dsimp [fixed, physical]
    unfold brrsStationaryWaveRadialCoefficient
      brrsStationaryWaveRadialFixedFactor
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => fixed u * physical u) rho‖ ≤
        brrsStationaryLeibnizConstant k A
          (B / (Real.sqrt (a / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          (Real.sqrt (a / 16)) ^ (M - 1) := by
      rw [brrsStationaryLeibnizConstant_right_div k A B
        ((Real.sqrt (a / 16)) ^ (M - 1)) hqpos.ne']
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le
    _ ≤ (C + 1) / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right (by linarith) hqpos.le

/-- A two-radius coefficient with a middle factor in its first radius has
rapid decay in that radius together with the usual endpoint-scale decay in
the second.  In particular this applies when `partS` is outgoing or incoming. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_middle_highRadius_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s u) rho‖ ≤
        C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_highRadius_decay
      (d := d) (N := N) hd Phi partS
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d partS s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d partS s
  have hqpos : 0 < (Real.sqrt (r / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < (Real.sqrt (s / 16)) ^ (d - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A / (Real.sqrt (r / 16)) ^ (M - 1) := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (d - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA.le hqpos.le) (div_nonneg hB.le hspos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A / (Real.sqrt (r / 16)) ^ (M - 1))
          (B / (Real.sqrt (s / 16)) ^ (d - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1)) := by
      rw [brrsStationaryLeibnizConstant_two_div k A B
        ((Real.sqrt (r / 16)) ^ (M - 1))
        ((Real.sqrt (s / 16)) ^ (d - 1)) hqpos.ne' hspos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hqpos hspos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (d - 1)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hqpos hspos).le

/-- When both two-radius stationary factors are middle waves, their two
independent middle remainders give arbitrary high-radius decay in each radial
variable.  Unlike the middle--endpoint estimate, this keeps both rapid
denominators, which is necessary to transfer the zero carrier to one of the
four endpoint phase lines without changing the radial half-density. -/
theorem exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidDecay
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ r s rho : Real,
      16 ≤ r → 16 ≤ s → rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s u) rho‖ ≤
        C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_iteratedDeriv_brrsStationaryWaveRadialCoefficient_middle_highRadius_rapidDecay
      (d := d) (N := N) (M := M) hd hM Phi
  let C : Real := ∑ l ∈ Finset.range (N + 1),
    brrsStationaryLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact brrsStationaryLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk r s rho hr hs hrho
  let left : Real → Complex := fun u : Real =>
    brrsSurfaceWaveAmplitude d .middle r u
  let right : Real → Complex := fun u : Real =>
    brrsStationaryWaveRadialCoefficient Phi d .middle s u
  have hleft : ContDiff Real (⊤ : ENat) left := by
    dsimp [left]
    exact contDiff_brrsSurfaceWaveAmplitude d .middle r
  have hright : ContDiff Real (⊤ : ENat) right := by
    dsimp [right]
    exact contDiff_brrsStationaryWaveRadialCoefficient Phi d .middle s
  have hrpos : 0 < (Real.sqrt (r / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < (Real.sqrt (s / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hleftbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l left rho‖ ≤
        A / (Real.sqrt (r / 16)) ^ (M - 1) := by
    intro l hl
    exact hAbound l (hl.trans hk) r rho hr hrho
  have hrightbound : ∀ l : Nat, l ≤ k →
      ‖iteratedDeriv l right rho‖ ≤
        B / (Real.sqrt (s / 16)) ^ (M - 1) := by
    intro l hl
    exact hBbound l (hl.trans hk) s rho hs hrho
  have hprod := norm_iteratedDeriv_mul_le_brrsStationaryLeibnizConstant
    (n := k) hleft hright
    (div_nonneg hA.le hrpos.le) (div_nonneg hB.le hspos.le)
    hleftbound hrightbound
  have hfactorfun : (fun u : Real =>
      brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s u) =
      fun u : Real => left u * right u := by
    funext u
    dsimp [left, right]
    unfold brrsTwoRadiusStationaryCoefficient
      brrsStationaryWaveRadialCoefficient
    ring
  rw [hfactorfun]
  have hCbound : brrsStationaryLeibnizConstant k A B ≤ C := by
    unfold C
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => brrsStationaryLeibnizConstant_nonneg l hA.le hB.le) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real => left u * right u) rho‖ ≤
        brrsStationaryLeibnizConstant k
          (A / (Real.sqrt (r / 16)) ^ (M - 1))
          (B / (Real.sqrt (s / 16)) ^ (M - 1)) := hprod
    _ = brrsStationaryLeibnizConstant k A B /
          ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1)) := by
      rw [brrsStationaryLeibnizConstant_two_div k A B
        ((Real.sqrt (r / 16)) ^ (M - 1))
        ((Real.sqrt (s / 16)) ^ (M - 1)) hrpos.ne' hspos.ne']
    _ ≤ C / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) :=
      div_le_div_of_nonneg_right hCbound (mul_pos hrpos hspos).le
    _ ≤ (C + 1) / ((Real.sqrt (r / 16)) ^ (M - 1) *
          (Real.sqrt (s / 16)) ^ (M - 1)) :=
      div_le_div_of_nonneg_right (by linarith) (mul_pos hrpos hspos).le

/-- A high--high stationary coefficient with a middle first wave has its
arbitrary middle-radius decay together with a compact rapid frequency
profile.  The second wave is retained as the explicit `partS` parameter. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_middle_highRadius_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d .middle partS r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      (d := d) (N := N) Phi .middle partS
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        (Real.sqrt (s / 16)) ^ (d - 1))
      (by
        intro r s hrs
        apply mul_pos
        · apply pow_pos
          apply Real.sqrt_pos.2
          linarith [hrs.1]
        · apply pow_pos
          apply Real.sqrt_pos.2
          linarith [hrs.2])
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_middle_highRadius_rapidDecay
            (d := d) (N := N) (M := M) hd hM Phi partS
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- The compact-frequency profile of a generic-dimensional middle--middle
coefficient retains the independently rapid decay in both high radii. -/
theorem exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s freq : Real, 16 ≤ r → 16 ≤ s →
      ‖∫ rho in (1 / 32 : Real)..1,
        brrsTwoRadiusStationaryCoefficient Phi d .middle .middle r s rho *
          oscillatoryExp freq rho‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N freq := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_profile_le_of_deriv_decay
      (d := d) (N := N) Phi .middle .middle
      (fun r s => 16 ≤ r ∧ 16 ≤ s)
      (fun r s => (Real.sqrt (r / 16)) ^ (M - 1) *
        (Real.sqrt (s / 16)) ^ (M - 1))
      (by
        intro r s hrs
        apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;>
          linarith)
      (by
        obtain ⟨C, hC, hderiv⟩ :=
          exists_uniform_iteratedDeriv_brrsTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidDecay
            (d := d) (N := N) (M := M) hd hM Phi
        refine ⟨C, hC, ?_⟩
        intro k hk r s rho hrs hrho
        exact hderiv k hk r s rho hrs.1 hrs.2 hrho)
  refine ⟨C, hC, ?_⟩
  intro r s freq hr hs
  exact hprofile r s freq ⟨hr, hs⟩

/-- The preceding compact-frequency profile estimate with the literal
stationary carrier restored.  This treats only the named middle--`partS`
component and does not combine it with any other component. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_middle_highRadius_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff)
    (partS : BRRSSurfaceWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle partS r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase partS s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_middle_highRadius_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi partS
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase partS s + 2 * Real.pi * t) hr hs

/-- Restoring the stationary carrier in the generic-dimensional middle--middle
estimate keeps the two rapid radial denominators visible for the four-sign
kernel reduction. -/
theorem exists_norm_brrsTwoRadiusStationaryComponentIntegral_middle_middle_highRadius_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
            (Real.sqrt (s / 16)) ^ (M - 1))) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_middle_middle_highRadius_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
  exact hprofile r s
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs

/-- Uniform all-order rapid high-radius decay for the literal
two-dimensional middle stationary-wave amplitude.  This keeps the arbitrary
middle exponent rather than replacing it by the half-order endpoint scale. -/
theorem exists_uniform_iteratedDeriv_brrsSurfaceWaveAmplitude_two_middle_highRadius_rapidDecay
    (N M : Nat) (hM : 2 ≤ M) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a rho : Real, 16 ≤ a →
      rho ∈ Icc (1 / 32 : Real) 1 →
      ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude 2 .middle a u) rho‖ ≤
        C / (Real.sqrt (a / 16)) ^ (M - 1) := by
  choose B hBpos hBbound using fun k : Nat =>
    exists_norm_iteratedDeriv_brrsSurfaceWaveAmplitude_middle_decay 2 k (M + k)
  let C : Real := ∑ k ∈ Finset.range (N + 1), B k * (128 : Real) ^ k
  have hC : 0 < C := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : B 0 * (128 : Real) ^ (0 : Nat) ≤ C := by
      dsimp [C]
      exact Finset.single_le_sum
        (fun k hk => mul_nonneg (hBpos k).le
          (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) k)) hzero
    have hterm : 0 < B 0 * (128 : Real) ^ (0 : Nat) := by
      simpa using hBpos 0
    exact lt_of_lt_of_le hterm hle
  refine ⟨C, hC, ?_⟩
  intro k hk a rho ha hrho
  obtain ⟨hfreq, hamp, hscale, _⟩ :=
    brrs_highRadius_frequency_geometry ha hrho
  have hs : 1 ≤ a / 16 := by linarith
  have hqpos : 0 < (Real.sqrt (a / 16)) ^ (M - 1) := by
    apply pow_pos
    apply Real.sqrt_pos.2
    linarith
  have hrapid := brrs_rapid_middle_denominator_le_scale
    (d := M) (k := k) (s := a / 16) (a := 2 * Real.pi * a)
    (lambda := |(2 * Real.pi * a) * rho|) (C := B k) (L := 128)
    hM hs (hBpos k).le (by positivity) hamp hscale
  have hkmem : k ∈ Finset.range (N + 1) :=
    Finset.mem_range.mpr (by omega)
  have hCbound : B k * (128 : Real) ^ k ≤ C := by
    dsimp [C]
    exact Finset.single_le_sum
      (fun l hl => mul_nonneg (hBpos l).le
        (pow_nonneg (show (0 : Real) ≤ 128 by norm_num) l)) hkmem
  calc
    ‖iteratedDeriv k (fun u : Real =>
        brrsSurfaceWaveAmplitude 2 .middle a u) rho‖ ≤
        B k * |2 * Real.pi * a| ^ k /
          |(2 * Real.pi * a) * rho| ^ (M + k) :=
      hBbound k a rho hfreq
    _ ≤ (B k * 128 ^ k) / (Real.sqrt (a / 16)) ^ (M - 1) := hrapid
    _ ≤ C / (Real.sqrt (a / 16)) ^ (M - 1) :=
      div_le_div_of_nonneg_right hCbound hqpos.le

end

/-! ### A genuine odd-order stationary lower bound

The quadratic stationary package in `Auxiliary` already contains the exact
one-step recurrence at the first odd moment.  Unlike the order-zero Fresnel
term, this recurrence has an explicit nonzero boundary coefficient.  The
following lemma turns that coefficient and the proved `O(lambda^(-1/2))`
bound for the derivative remainder into a quantitative eventual lower bound.

This is the first analytic lower estimate needed by the BRRS shell packet:
it applies, in particular, to the `d = 3` meridional endpoint.  It is kept
generic so that the odd-order recurrence can be iterated in a subsequent
development. -/

/-- The nonzero leading coefficient produced by iterating the odd quadratic
endpoint recurrence.  The recurrence is kept rather than expanded into
factorials so its phase and normalization remain transparent. -/
def brrsOddQuadraticLeadingCoefficient : Nat → Complex
  | 0 => -1
  | n + 1 => -((2 * n + 2 : Nat) : Complex) * brrsOddQuadraticLeadingCoefficient n

theorem brrsOddQuadraticLeadingCoefficient_succ (n : Nat) :
    brrsOddQuadraticLeadingCoefficient (n + 1) =
      -((2 * n + 2 : Nat) : Complex) * brrsOddQuadraticLeadingCoefficient n := rfl

/-- No odd stationary leading coefficient vanishes. -/
theorem brrsOddQuadraticLeadingCoefficient_ne_zero (n : Nat) :
    brrsOddQuadraticLeadingCoefficient n ≠ 0 := by
  induction n with
  | zero => norm_num [brrsOddQuadraticLeadingCoefficient]
  | succ n ih =>
      rw [brrsOddQuadraticLeadingCoefficient_succ]
      apply mul_ne_zero
      · apply neg_ne_zero.mpr
        exact Nat.cast_ne_zero.mpr (by omega)
      · exact ih

/-- The exact first-odd-moment recurrence yields a quantitative leading
stationary coefficient, with the derivative moment as its `O(lambda⁻¹ᐟ²)`
remainder. -/
theorem exists_quadraticMoment_one_leading_asymptotic
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) *
          quadraticMomentIntegral 1 h lambda + h 0‖ ≤ C / Real.sqrt lambda := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_zero_decay (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2)
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hrec := quadraticMomentIntegral_one_recurrence h hh hvanish
    (ne_of_gt hlambda_pos)
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let R : Complex := quadraticMomentIntegral 0 (deriv h) lambda
  have hq : q ≠ 0 := by
    dsimp [q]
    exact mul_ne_zero
      (Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos)))
      Complex.I_ne_zero
  have hid : q * (-q⁻¹ * (h 0 + R)) + h 0 = -R := by
    calc
      q * (-q⁻¹ * (h 0 + R)) + h 0 = -(q * q⁻¹) * (h 0 + R) + h 0 := by ring
      _ = -(h 0 + R) + h 0 := by simp [hq]
      _ = -R := by ring
  change ‖q * quadraticMomentIntegral 1 h lambda + h 0‖ ≤ _
  rw [hrec]
  rw [hid, norm_neg]
  exact hCbound lambda hlambda

/-- Norm of the quadratic carrier in the endpoint recurrence. -/
private theorem brrs_norm_quadraticCarrier (lambda : Real) (hlambda : 0 ≤ lambda) :
    ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
  have htwo : 0 ≤ 2 * lambda := by nlinarith
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
    abs_of_nonneg htwo]
  simp

/-- The carrier power has the corresponding real scalar norm. -/
private theorem brrs_norm_quadraticCarrier_pow
    (k : Nat) (lambda : Real) (hlambda : 0 ≤ lambda) :
    ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ k‖ = (2 * lambda) ^ k := by
  rw [norm_pow, brrs_norm_quadraticCarrier lambda hlambda]

/-- The even derivative remainder in the odd leading-term recurrence has one
extra square-root in its stationary scale. -/
private theorem brrs_quadraticMomentScale_even_remainder_leading
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 2) lambda =
      lambda ^ (n + 1) * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 2 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1) + 1) := by congr 1
    _ = (Real.sqrt lambda ^ (2 * (n + 1))) * Real.sqrt lambda := by
      rw [show 2 * (n + 1) + 1 = Nat.succ (2 * (n + 1)) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ (n + 1) * Real.sqrt lambda := by rw [hsquare]

/-- Full complex leading asymptotic for every odd quadratic endpoint moment.
The leading coefficient is fixed (and nonzero) across the frequency annulus;
the error gains a square root.  This is stronger than the norm lower bound
and is the form required to prevent cancellation in a radial packet. -/
theorem exists_quadraticMoment_odd_leading_asymptotic
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          quadraticMomentIntegral (2 * n + 1) h lambda -
            brrsOddQuadraticLeadingCoefficient n * h 0‖ ≤ C / Real.sqrt lambda := by
  induction n with
  | zero =>
      obtain ⟨C, hC, hbound⟩ :=
        exists_quadraticMoment_one_leading_asymptotic h hh hvanish
      refine ⟨C, hC, ?_⟩
      intro lambda hlambda
      have hrewrite :
          (((2 * lambda : Real) : Complex) * Complex.I) ^ (0 + 1) *
              quadraticMomentIntegral (2 * 0 + 1) h lambda -
                brrsOddQuadraticLeadingCoefficient 0 * h 0 =
            (((2 * lambda : Real) : Complex) * Complex.I) *
              quadraticMomentIntegral 1 h lambda + h 0 := by
        simp [brrsOddQuadraticLeadingCoefficient]
      rw [hrewrite]
      exact hbound lambda hlambda
  | succ n ih =>
      obtain ⟨C₀, hC₀, hmain⟩ := ih
      obtain ⟨C₁, hC₁, hrem⟩ :=
        exists_quadraticMoment_decay (2 * n + 2) (deriv h)
          ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
      let D : Real := ((2 * n + 2 : Nat) : Real) * C₀ + (2 : Real) ^ (n + 1) * C₁
      have hD : 0 < D := by
        dsimp [D]
        have hcoeff : (0 : Real) < ((2 * n + 2 : Nat) : Real) := by positivity
        positivity
      refine ⟨D, hD, ?_⟩
      intro lambda hlambda
      have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
      have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
      let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
      let A : Complex := quadraticMomentIntegral (2 * n + 1) h lambda
      let R : Complex := quadraticMomentIntegral ((2 * n + 1) + 1) (deriv h) lambda
      let K : Complex := brrsOddQuadraticLeadingCoefficient n
      have hmain' : ‖q ^ (n + 1) * A - K * h 0‖ ≤ C₀ / Real.sqrt lambda := by
        dsimp [q, A, K]
        exact hmain lambda hlambda
      have hindex : (2 * n + 1) + 1 = 2 * n + 2 := by omega
      have hRraw : ‖R‖ ≤ C₁ / quadraticMomentScale (2 * n + 2) lambda := by
        dsimp [R]
        rw [hindex]
        exact hrem lambda hlambda
      have hscale := brrs_quadraticMomentScale_even_remainder_leading n hlambda_pos.le
      have hR : ‖R‖ ≤ C₁ / (lambda ^ (n + 1) * Real.sqrt lambda) := by
        calc
          ‖R‖ ≤ C₁ / quadraticMomentScale (2 * n + 2) lambda := hRraw
          _ = C₁ / (lambda ^ (n + 1) * Real.sqrt lambda) := by rw [hscale]
      have hqpow : ‖q ^ (n + 1)‖ = (2 * lambda) ^ (n + 1) := by
        dsimp [q]
        exact brrs_norm_quadraticCarrier_pow (n + 1) lambda hlambda_pos.le
      have hqR : ‖q ^ (n + 1) * R‖ ≤
          ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda := by
        calc
          ‖q ^ (n + 1) * R‖ = ‖q ^ (n + 1)‖ * ‖R‖ := norm_mul _ _
          _ = (2 * lambda) ^ (n + 1) * ‖R‖ := by rw [hqpow]
          _ ≤ (2 * lambda) ^ (n + 1) *
              (C₁ / (lambda ^ (n + 1) * Real.sqrt lambda)) :=
            mul_le_mul_of_nonneg_left hR (pow_nonneg (by nlinarith) _)
          _ = ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda := by
            rw [mul_pow]
            field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]
      have hq : q ≠ 0 := by
        dsimp [q]
        apply mul_ne_zero
        · exact Complex.ofReal_ne_zero.mpr (mul_ne_zero (by norm_num) (ne_of_gt hlambda_pos))
        · exact Complex.I_ne_zero
      have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n + 1) h hh hvanish
        (ne_of_gt hlambda_pos)
      have hrec' :
          quadraticMomentIntegral ((2 * n + 1) + 2) h lambda =
            -q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R) := by
        dsimp [q, A, R]
        rw [hindex]
        exact hrec
      have hid :
          q ^ (n + 2) * quadraticMomentIntegral ((2 * n + 1) + 2) h lambda -
              brrsOddQuadraticLeadingCoefficient (n + 1) * h 0 =
            -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
              q ^ (n + 1) * R := by
        rw [brrsOddQuadraticLeadingCoefficient_succ, hrec']
        rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
        have hcancel : q * q⁻¹ = 1 := mul_inv_cancel₀ hq
        calc
          q ^ (n + 1) * q * (-q⁻¹ * (((2 * n + 2 : Nat) : Complex) * A + R)) -
                (-((2 * n + 2 : Nat) : Complex) * K) * h 0 =
              -(q ^ (n + 1) * (q * q⁻¹) *
                  (((2 * n + 2 : Nat) : Complex) * A + R)) +
                ((2 * n + 2 : Nat) : Complex) * K * h 0 := by
                ring
          _ = -((2 * n + 2 : Nat) : Complex) * (q ^ (n + 1) * A - K * h 0) -
                q ^ (n + 1) * R := by
                rw [hcancel]
                ring
      have hcoeff_norm : ‖-((2 * n + 2 : Nat) : Complex)‖ =
          ((2 * n + 2 : Nat) : Real) := by
        rw [norm_neg, norm_natCast]
      have hfirst : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0)‖ ≤
          (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda := by
        rw [norm_mul, hcoeff_norm]
        calc
          ((2 * n + 2 : Nat) : Real) * ‖q ^ (n + 1) * A - K * h 0‖ ≤
              ((2 * n + 2 : Nat) : Real) * (C₀ / Real.sqrt lambda) :=
            mul_le_mul_of_nonneg_left hmain' (Nat.cast_nonneg _)
          _ = (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda := by ring
      have hsum : ‖-((2 * n + 2 : Nat) : Complex) *
          (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
          D / Real.sqrt lambda := by
        calc
          ‖-((2 * n + 2 : Nat) : Complex) *
              (q ^ (n + 1) * A - K * h 0) - q ^ (n + 1) * R‖ ≤
              ‖-((2 * n + 2 : Nat) : Complex) *
                (q ^ (n + 1) * A - K * h 0)‖ + ‖q ^ (n + 1) * R‖ :=
            norm_sub_le _ _
          _ ≤ (((2 * n + 2 : Nat) : Real) * C₀) / Real.sqrt lambda +
              ((2 : Real) ^ (n + 1) * C₁) / Real.sqrt lambda :=
            add_le_add hfirst hqR
          _ = D / Real.sqrt lambda := by
            dsimp [D]
            ring
      have hsucc_index : 2 * Nat.succ n + 1 = (2 * n + 1) + 2 := by omega
      have hsucc_power : Nat.succ n + 1 = n + 2 := by omega
      rw [hsucc_index, hsucc_power]
      rw [hid]
      exact hsum

/-- The concrete nonplanar endpoint has a fixed complex leading stationary
coefficient at every odd order.  The displayed normalization removes the
oscillatory stationary scale, so the limiting coefficient is independent of
the frequency within a high annulus. -/
theorem exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
            brrsOddQuadraticLeadingCoefficient n *
              smoothEndpointProfile (2 * n + 1) 0‖ ≤ C / Real.sqrt lambda := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_quadraticMoment_odd_leading_asymptotic n
      (smoothEndpointProfile (2 * n + 1))
      (contDiff_smoothEndpointProfile (2 * n + 1))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n + 1))
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- On an outgoing odd-dimensional BRRS surface wave, demodulation by its
quadratic stationary scale leaves a single fixed nonzero endpoint coefficient.
The error is uniform in the physical radius and radial frequency once their
literal product is in the high-frequency annulus. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real, 1 ≤ (2 * Real.pi * a) * rho →
      ‖(((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
            (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_leading_asymptotic n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    exact surfaceMass_pos (by omega)
  refine ⟨mass * C, mul_pos hmass hC, ?_⟩
  intro a rho hlambda
  let lambda : Real := (2 * Real.pi * a) * rho
  have hmain := hbound lambda (by simpa [lambda] using hlambda)
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp :
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho =
        (mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda := by
    unfold brrsSurfaceWaveAmplitude
    dsimp [lambda, mass]
    rw [hdim_two]
  rw [hamp]
  have hfactor :
      (((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((mass : Complex) * smoothEndpointQuadraticIntegral (2 * n + 1) lambda) -
            (mass : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) =
        (mass : Complex) *
          ((((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
            smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
              brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0) := by
      ring
  rw [show (2 * Real.pi * a) * rho = lambda by rfl, hfactor, norm_mul,
    Complex.norm_real, Real.norm_eq_abs, abs_of_pos hmass]
  calc
    mass * ‖(((2 * lambda : Real) : Complex) * Complex.I) ^ (n + 1) *
        smoothEndpointQuadraticIntegral (2 * n + 1) lambda -
          brrsOddQuadraticLeadingCoefficient n *
            smoothEndpointProfile (2 * n + 1) 0‖ ≤
        mass * (C / Real.sqrt lambda) :=
      mul_le_mul_of_nonneg_left hmain hmass.le
    _ = (mass * C) / Real.sqrt lambda := by ring

/-- In every odd spatial dimension, the outgoing endpoint wave has a fixed
complex leading carrier after separating the physical radius from the radial
frequency.  This is the normalization needed to integrate the leading term
against the positive `TT*` annular density: the limiting phase is independent
of the frequency variable, so there is no endpoint cancellation to hide. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real,
      1 ≤ (2 * Real.pi * a) * rho →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            (surfaceMass (2 * n + 2) : Complex) *
              (brrsOddQuadraticLeadingCoefficient n *
                smoothEndpointProfile (2 * n + 1) 0)‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_leading_asymptotic n
  refine ⟨C, hC, ?_⟩
  intro a rho hlambda
  have hbase :
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) *
          ((rho : Real) : Complex) =
        ((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I := by
    push_cast
    ring
  have hfactor :
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) =
        (((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
          (n + 1) := by
    calc
      (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) =
          ((((4 * Real.pi * a : Real) : Complex) * Complex.I) *
            ((rho : Real) : Complex)) ^ (n + 1) :=
        (mul_pow (((4 * Real.pi * a : Real) : Complex) * Complex.I)
          ((rho : Real) : Complex) (n + 1)).symm
      _ = (((2 * ((2 * Real.pi * a) * rho) : Real) : Complex) * Complex.I) ^
          (n + 1) := by rw [hbase]
  rw [hfactor]
  exact hbound a rho hlambda

/-- The fixed complex leading carrier of the odd-dimensional outgoing wave. -/
noncomputable def brrsOddOutgoingLeadingCarrier (n : Nat) : Complex :=
  (surfaceMass (2 * n + 2) : Complex) *
    (brrsOddQuadraticLeadingCoefficient n *
      smoothEndpointProfile (2 * n + 1) 0)

/-- The odd outgoing leading carrier is genuinely nonzero. -/
theorem brrsOddOutgoingLeadingCarrier_ne_zero (n : Nat) :
    brrsOddOutgoingLeadingCarrier n ≠ 0 := by
  unfold brrsOddOutgoingLeadingCarrier
  apply mul_ne_zero
  · exact Complex.ofReal_ne_zero.mpr
      (ne_of_gt (surfaceMass_pos (by omega)))
  · exact mul_ne_zero (brrsOddQuadraticLeadingCoefficient_ne_zero n)
      (brrs_smoothEndpointProfile_zero_ne_zero (2 * n + 1))

/-- The normalized odd outgoing asymptotic written using its named nonzero
leading carrier. -/
theorem exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic'
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a rho : Real,
      1 ≤ (2 * Real.pi * a) * rho →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            brrsOddOutgoingLeadingCarrier n‖ ≤
        C / Real.sqrt ((2 * Real.pi * a) * rho) := by
  simpa only [brrsOddOutgoingLeadingCarrier] using
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic n

/-- The positive weighted annular moment that multiplies the fixed odd
outgoing leading carrier for the literal `TT*` cutoff. -/
noncomputable def brrsOddTTStarRadialMoment (Φ : BRRSAnnularCutoff) (n : Nat) : Real :=
  ∫ rho in (1 / 32 : Real)..1,
    rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2

/-- The weighted positive `TT*` annular moment cannot vanish.  This is the
frequency-side positivity which prevents cancellation of the normalized odd
outgoing leading term. -/
theorem brrsOddTTStarRadialMoment_pos (Φ : BRRSAnnularCutoff) (n : Nat) :
    0 < brrsOddTTStarRadialMoment Φ n := by
  let f : Real → Real := fun rho : Real =>
    rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2
  have hcont : Continuous f := by
    dsimp [f]
    exact (continuous_id.pow (n + 1)).mul
      ((Φ.symbol.continuous.comp (by fun_prop)).norm.pow 2)
  have hfi : IntervalIntegrable f volume (1 / 32 : Real) 1 :=
    hcont.intervalIntegrable _ _
  have hnonneg_on : ∀ rho : Real, rho ∈ Ioc (1 / 32 : Real) 1 → 0 ≤ f rho := by
    intro rho hrho
    dsimp [f]
    exact mul_nonneg (pow_nonneg (by linarith [hrho.1]) _) (sq_nonneg _)
  have hnonneg_ae : 0 ≤ᵐ[volume.restrict (uIoc (1 / 32 : Real) 1)] f := by
    rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)]
    filter_upwards [ae_restrict_mem measurableSet_Ioc] with rho hrho
    exact hnonneg_on rho hrho
  rcases Φ.nontrivial with ⟨r, hr⟩
  have hrsupport : r ∈ tsupport (Φ.symbol : Real → Complex) :=
    subset_tsupport _ (Function.mem_support.mpr hr)
  have hrange : r ∈ Ioo (1 / 4 : Real) 4 := Φ.tsupport_subset hrsupport
  let rho : Real := r / (2 * Real.pi)
  have hden : 0 < 2 * Real.pi := by positivity
  have hrho : rho ∈ Ioo (1 / 32 : Real) 1 := by
    constructor
    · apply (lt_div_iff₀ hden).mpr
      nlinarith [hrange.1, Real.pi_lt_four]
    · apply (div_lt_iff₀ hden).mpr
      nlinarith [hrange.2, Real.pi_gt_three]
  have harg : 2 * Real.pi * rho = r := by
    dsimp [rho]
    field_simp [Real.pi_ne_zero]
  have hsymbol : Φ.symbol (2 * Real.pi * rho) ≠ 0 := by
    rw [harg]
    exact hr
  have hfrho : f rho ≠ 0 := by
    dsimp [f]
    apply mul_ne_zero
    · exact pow_ne_zero _ (ne_of_gt (lt_trans (by norm_num) hrho.1))
    · exact pow_ne_zero _ (norm_ne_zero_iff.mpr hsymbol)
  unfold brrsOddTTStarRadialMoment
  change 0 < ∫ rho in (1 / 32 : Real)..1, f rho
  apply (intervalIntegral.integral_pos_iff_support_of_nonneg_ae'
    hnonneg_ae hfi).mpr
  refine ⟨by norm_num, ?_⟩
  let S : Set Real := Function.support f ∩ Ioo (1 / 32 : Real) 1
  have hSopen : IsOpen S := hcont.isOpen_support.inter isOpen_Ioo
  have hrhoS : rho ∈ S := ⟨Function.mem_support.mpr hfrho, hrho⟩
  have hSpos : 0 < volume S := hSopen.measure_pos volume ⟨rho, hrhoS⟩
  refine hSpos.trans_le (measure_mono ?_)
  intro x hx
  exact ⟨hx.1, Ioo_subset_Ioc_self hx.2⟩

/-- The complex radial moment of the positive `TT*` cutoff is exactly the
real positive moment above, embedded in `Complex`. -/
theorem intervalIntegral_brrsTTStarAnnularCutoff_weighted_eq_ofReal_moment
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    (∫ rho in (1 / 32 : Real)..1,
      ((rho ^ (n + 1) : Real) : Complex) *
        (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho)) =
      (brrsOddTTStarRadialMoment Φ n : Complex) := by
  rw [show (fun rho : Real =>
      ((rho ^ (n + 1) : Real) : Complex) *
        (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho)) =
      fun rho : Real =>
        ((rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2 : Real) : Complex) by
      funext rho
      rw [brrsTTStarAnnularCutoff_symbol_apply, RCLike.mul_conj]
      push_cast
      rfl]
  simpa only [brrsOddTTStarRadialMoment] using
    (intervalIntegral.integral_ofReal
      (f := fun rho : Real => rho ^ (n + 1) * ‖Φ.symbol (2 * Real.pi * rho)‖ ^ 2)
      (μ := volume))

/-- At the outgoing relative cone, the literal stationary component of the
positive `TT*` kernel has no remaining linear carrier.  It is exactly the
radial integral of the outgoing amplitude against the positive cutoff. -/
theorem brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eq
    (Φ : BRRSAnnularCutoff) (n : Nat) (a : Real) :
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
      (2 * n + 3) .outgoing a a =
      ∫ rho in (1 / 32 : Real)..1,
        ((rho ^ (2 * n + 2) : Real) : Complex) *
          brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho *
            (brrsTTStarAnnularCutoff Φ).symbol (2 * Real.pi * rho) := by
  unfold brrsStationaryWaveComponentIntegral
  rw [intervalIntegral_brrsStationaryWaveComponent_eq_oscillatoryExp]
  apply intervalIntegral.integral_congr
  intro rho _
  unfold brrsStationaryWaveRadialCoefficient
  have hphase : brrsSurfaceWavePhase .outgoing a + 2 * Real.pi * a = 0 := by
    simp only [brrsSurfaceWavePhase]
    ring
  rw [hphase]
  simp only [oscillatoryExp, zero_mul, Complex.ofReal_zero, zero_mul,
    Complex.exp_zero, mul_one]
  have hindex : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  rw [hindex]

/-- After the outgoing cone demodulation in odd dimension, the outgoing
`TT*` component converges quantitatively to the nonzero endpoint carrier
times its positive radial moment.  This concerns the outgoing component alone;
it deliberately makes no cancellation claim about the other stationary
components of the full kernel. -/
theorem exists_norm_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_normalized_leading_asymptotic
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 16 ≤ a →
      ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a -
          brrsOddOutgoingLeadingCarrier n *
            (brrsOddTTStarRadialMoment Φ n : Complex)‖ ≤
        C / Real.sqrt (a / 16) := by
  obtain ⟨D, hD, hamp⟩ :=
    exists_brrsSurfaceWaveAmplitude_outgoing_odd_normalized_carrier_asymptotic' n
  let Ψ : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Φ
  let W : Real → Complex := fun rho : Real => Ψ.symbol (2 * Real.pi * rho)
  have hWcont : Continuous W := by
    dsimp [W]
    exact Ψ.symbol.continuous.comp (by fun_prop)
  obtain ⟨B, hB⟩ :=
    (isCompact_Icc : IsCompact (Icc (1 / 32 : Real) 1)).exists_bound_of_continuousOn
      hWcont.continuousOn
  let C : Real := (1 - (1 / 32 : Real)) * (max B 0 * D) + 1
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro a ha
  let A : Complex := ((4 * Real.pi * a : Real) : Complex) * Complex.I
  let L : Complex := brrsOddOutgoingLeadingCarrier n
  let P : Real → Complex := fun rho : Real =>
    ((rho ^ (2 * n + 2) : Real) : Complex) *
      brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho * W rho
  let Q : Real → Complex := fun rho : Real =>
    ((rho ^ (n + 1) : Real) : Complex) * W rho
  have hPcont : Continuous P := by
    dsimp [P]
    exact ((Complex.ofRealCLM.continuous.comp (continuous_id.pow (2 * n + 2))).mul
      (contDiff_brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a).continuous).mul hWcont
  have hQcont : Continuous Q := by
    dsimp [Q]
    exact (Complex.ofRealCLM.continuous.comp (continuous_id.pow (n + 1))).mul hWcont
  have hAPint : IntervalIntegrable (fun rho : Real => A ^ (n + 1) * P rho)
      volume (1 / 32 : Real) 1 :=
    (continuous_const.mul hPcont).intervalIntegrable _ _
  have hLQint : IntervalIntegrable (fun rho : Real => L * Q rho)
      volume (1 / 32 : Real) 1 :=
    (continuous_const.mul hQcont).intervalIntegrable _ _
  have hrewrite :
      A ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a -
          L * (brrsOddTTStarRadialMoment Φ n : Complex) =
        ∫ rho in (1 / 32 : Real)..1,
          ((rho ^ (n + 1) : Real) : Complex) * W rho *
            (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L) := by
    rw [brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eq]
    rw [← intervalIntegral_brrsTTStarAnnularCutoff_weighted_eq_ofReal_moment]
    change A ^ (n + 1) * (∫ rho in (1 / 32 : Real)..1, P rho) -
        L * (∫ rho in (1 / 32 : Real)..1, Q rho) = _
    rw [← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_const_mul,
      ← intervalIntegral.integral_sub hAPint hLQint]
    apply intervalIntegral.integral_congr
    intro rho _
    have hpower : (2 * n + 2 : Nat) = (n + 1) + (n + 1) := by omega
    dsimp [P, Q]
    push_cast <;> rw [hpower, pow_add] <;> ring
  rw [show (((4 * Real.pi * a : Real) : Complex) * Complex.I) = A by rfl,
    show brrsOddOutgoingLeadingCarrier n = L by rfl, hrewrite]
  refine (intervalIntegral.norm_integral_le_of_norm_le_const
    (C := (max B 0) * (D / Real.sqrt (a / 16))) ?_).trans ?_
  · intro rho hrho
    have hrho' : rho ∈ Icc (1 / 32 : Real) 1 := by
      rw [uIoc_of_le (by norm_num : (1 / 32 : Real) ≤ 1)] at hrho
      exact ⟨hrho.1.le, hrho.2⟩
    have ha0 : 0 ≤ a := by linarith
    have hrho0 : 0 ≤ rho := le_trans (by norm_num) hrho'.1
    have hfactor : (1 / 16 : Real) ≤ (2 * Real.pi) * rho := by
      calc
        (1 / 16 : Real) ≤ (2 * Real.pi) * (1 / 32 : Real) := by
          nlinarith [Real.pi_gt_three]
        _ ≤ (2 * Real.pi) * rho := by
          exact mul_le_mul_of_nonneg_left hrho'.1 (by positivity)
    have hlambda : a / 16 ≤ (2 * Real.pi * a) * rho := by
      calc
        a / 16 = a * (1 / 16 : Real) := by ring
        _ ≤ a * ((2 * Real.pi) * rho) := by gcongr
        _ = (2 * Real.pi * a) * rho := by ring
    have hlarge : 1 ≤ (2 * Real.pi * a) * rho := by
      calc
        (1 : Real) ≤ a / 16 := by linarith
        _ ≤ (2 * Real.pi * a) * rho := hlambda
    have hqpos : 0 < Real.sqrt (a / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hsqrt : Real.sqrt (a / 16) ≤ Real.sqrt ((2 * Real.pi * a) * rho) :=
      Real.sqrt_le_sqrt hlambda
    have herr :
        ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L‖ ≤
          D / Real.sqrt (a / 16) := by
      change ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho -
            brrsOddOutgoingLeadingCarrier n‖ ≤ _
      exact (hamp a rho hlarge).trans
        (div_le_div_of_nonneg_left hD.le hqpos hsqrt)
    have hrhopow : ‖((rho ^ (n + 1) : Real) : Complex)‖ ≤ 1 := by
      rw [Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (pow_nonneg hrho0 _)]
      exact pow_le_one₀ hrho0 hrho'.2
    have hW : ‖W rho‖ ≤ max B 0 :=
      (hB rho hrho').trans (le_max_left _ _)
    have hE : 0 ≤ D / Real.sqrt (a / 16) := by positivity
    calc
      ‖((rho ^ (n + 1) : Real) : Complex) * W rho *
          (A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
            brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L)‖ =
          ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            ‖A ^ (n + 1) * ((rho : Real) : Complex) ^ (n + 1) *
              brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho - L‖ := by
        rw [norm_mul, norm_mul]
      _ ≤ ‖((rho ^ (n + 1) : Real) : Complex)‖ * ‖W rho‖ *
            (D / Real.sqrt (a / 16)) := by
        gcongr
      _ ≤ (max B 0) * (D / Real.sqrt (a / 16)) := by
        calc
          _ ≤ (1 : Real) * (max B 0) * (D / Real.sqrt (a / 16)) := by
            gcongr
          _ = (max B 0) * (D / Real.sqrt (a / 16)) := by ring
  · have hqpos : 0 < Real.sqrt (a / 16) := by
      apply Real.sqrt_pos.2
      linarith
    have hlength : |1 - (1 / 32 : Real)| = 1 - (1 / 32 : Real) := by
      rw [abs_of_nonneg]
      norm_num
    rw [hlength]
    calc
      (max B 0) * (D / Real.sqrt (a / 16)) * (1 - (1 / 32 : Real)) =
          ((1 - (1 / 32 : Real)) * (max B 0 * D)) /
            Real.sqrt (a / 16) := by
        rw [div_eq_mul_inv, div_eq_mul_inv]
        ring
      _ ≤ C / Real.sqrt (a / 16) := by
        apply (div_le_div_iff_of_pos_right hqpos).mpr
        dsimp [C]
        linarith

/-- In every odd dimension the outgoing stationary component of the positive
`TT*` kernel is eventually bounded away from zero on its relative cone, after
the natural stationary demodulation.  The assertion is intentionally only for
this component; bounding the full kernel additionally requires quantified
control of the incoming and middle components. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_normalized_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ a : Real, A ≤ a →
      c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
          brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
            (2 * n + 3) .outgoing a a‖ := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_normalized_leading_asymptotic
      Φ n
  let Z : Complex := brrsOddOutgoingLeadingCarrier n *
    (brrsOddTTStarRadialMoment Φ n : Complex)
  let K : Real := ‖Z‖
  have hmoment_ne : (brrsOddTTStarRadialMoment Φ n : Complex) ≠ 0 :=
    Complex.ofReal_ne_zero.mpr (ne_of_gt (brrsOddTTStarRadialMoment_pos Φ n))
  have hZne : Z ≠ 0 := by
    dsimp [Z]
    exact mul_ne_zero (brrsOddOutgoingLeadingCarrier_ne_zero n) hmoment_ne
  have hK : 0 < K := by
    dsimp [K]
    exact norm_pos_iff.mpr hZne
  let A : Real := max 16 (16 * (2 * C / K) ^ 2)
  let X : Real → Complex := fun a : Real =>
    (((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
      brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
        (2 * n + 3) .outgoing a a
  refine ⟨A, K / 2, le_max_left _ _, by positivity, ?_⟩
  intro a ha
  change K / 2 ≤ ‖X a‖
  have ha16 : 16 ≤ a := le_trans (le_max_left _ _) ha
  have haover : 0 < a / 16 := by linarith
  have hqpos : 0 < Real.sqrt (a / 16) := Real.sqrt_pos.2 haover
  have hsq : (2 * C / K) ^ 2 ≤ a / 16 := by
    have hraw : 16 * (2 * C / K) ^ 2 ≤ a :=
      le_trans (le_max_right _ _) ha
    nlinarith
  have hratio0 : 0 ≤ 2 * C / K := by positivity
  have hroot_sq : (Real.sqrt (a / 16)) ^ 2 = a / 16 :=
    Real.sq_sqrt haover.le
  have hratio : 2 * C / K ≤ Real.sqrt (a / 16) := by
    nlinarith [Real.sqrt_nonneg (a / 16)]
  have htwoC : 2 * C ≤ Real.sqrt (a / 16) * K :=
    (div_le_iff₀ hK).mp hratio
  have hhalf : C / Real.sqrt (a / 16) ≤ K / 2 := by
    apply (div_le_iff₀ hqpos).mpr
    nlinarith
  have herr : ‖X a - Z‖ ≤ C / Real.sqrt (a / 16) := by
    change ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
        brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
          (2 * n + 3) .outgoing a a -
        brrsOddOutgoingLeadingCarrier n *
          (brrsOddTTStarRadialMoment Φ n : Complex)‖ ≤ _
    exact hbound a ha16
  have hdiff : ‖X a - Z‖ ≤ K / 2 := herr.trans hhalf
  have htri : K ≤ ‖X a‖ + ‖X a - Z‖ := by
    calc
      K = ‖X a - (X a - Z)‖ := by
        dsimp [K]
        congr 1
        ring
      _ ≤ ‖X a‖ + ‖X a - Z‖ := norm_sub_le _ _
  nlinarith

/-- The preceding normalized lower bound gives the literal stationary-scale
lower bound for the outgoing component itself. -/
theorem exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ a : Real, A ≤ a →
      c / a ^ (n + 1) ≤
        ‖brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
          (2 * n + 3) .outgoing a a‖ := by
  obtain ⟨A, c, hA, hc, hbound⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_normalized_eventually_lower
      Φ n
  let D : Real := (4 * Real.pi) ^ (n + 1)
  have hD : 0 < D := by
    dsimp [D]
    positivity
  refine ⟨A, c / D, hA, div_pos hc hD, ?_⟩
  intro a ha
  let Y : Complex :=
    brrsStationaryWaveComponentIntegral (brrsTTStarAnnularCutoff Φ)
      (2 * n + 3) .outgoing a a
  have ha16 : 16 ≤ a := le_trans hA ha
  have ha0 : 0 ≤ a := by linarith
  have hbase : 0 ≤ 4 * Real.pi * a := by positivity
  have hbaseNorm : ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I)‖ =
      4 * Real.pi * a := by
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hbase, Complex.norm_I, mul_one]
  have hnorm : c ≤ (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := by
    have hnorm' := hbound a ha
    change c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) *
      Y‖ at hnorm'
    calc
      c ≤ ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I) ^ (n + 1) * Y‖ :=
        hnorm'
      _ = ‖(((4 * Real.pi * a : Real) : Complex) * Complex.I)‖ ^ (n + 1) * ‖Y‖ := by
        rw [norm_mul, norm_pow]
      _ = (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := by rw [hbaseNorm]
  have hscale : (4 * Real.pi * a) ^ (n + 1) =
      (4 * Real.pi) ^ (n + 1) * a ^ (n + 1) := by
    rw [show 4 * Real.pi * a = (4 * Real.pi) * a by ring, mul_pow]
  have hscaled : c ≤ D * a ^ (n + 1) * ‖Y‖ := by
    calc
      c ≤ (4 * Real.pi * a) ^ (n + 1) * ‖Y‖ := hnorm
      _ = D * a ^ (n + 1) * ‖Y‖ := by
        dsimp [D]
        rw [hscale]
  change c / D / a ^ (n + 1) ≤ ‖Y‖
  rw [div_div]
  apply (div_le_iff₀ (mul_pos hD (pow_pos (by linarith : 0 < a) _))).mpr
  simpa only [mul_assoc, mul_left_comm, mul_comm] using hscaled

/-- Any non-outgoing stationary component gains a full extra power of the
cone radius at the outgoing cone.  This is the quantitative separation needed
to turn the outgoing-component lower bound into a lower bound for the literal
three-component kernel. -/
theorem exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
    (Φ : BRRSAnnularCutoff) (n : Nat) (part : BRRSSurfaceWavePart)
    (hpart : part ≠ .outgoing) :
    ∃ C : Real, 0 < C ∧ ∀ a : Real, 16 ≤ a →
      ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        C / a ^ (n + 2) := by
  obtain ⟨C, hC, hcomponent⟩ :=
    exists_norm_intervalIntegral_brrsStationaryWaveComponent_highRadius_le
      (d := 2 * n + 3) (N := n + 2) (by omega) Φ part
  let C' : Real := (1 - (1 / 32 : Real)) * C
  have hC' : 0 < C' := by
    dsimp [C']
    positivity
  refine ⟨C', hC', ?_⟩
  intro a ha
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a := by linarith
  have hphase_lower : a ≤ |brrsSurfaceWavePhase part a + 2 * Real.pi * a| := by
    cases part with
    | outgoing => exact False.elim (hpart rfl)
    | incoming =>
      have hcoef : (1 : Real) ≤ 4 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 4 * Real.pi * a := by positivity
      rw [show brrsSurfaceWavePhase .incoming a + 2 * Real.pi * a =
        4 * Real.pi * a by simp [brrsSurfaceWavePhase]; ring,
        abs_of_nonneg hnonneg]
      calc
        a = 1 * a := by ring
        _ ≤ (4 * Real.pi) * a := mul_le_mul_of_nonneg_right hcoef ha0
        _ = 4 * Real.pi * a := by ring
    | middle =>
      have hcoef : (1 : Real) ≤ 2 * Real.pi := by
        nlinarith [Real.pi_gt_three]
      have hnonneg : 0 ≤ 2 * Real.pi * a := by positivity
      rw [show brrsSurfaceWavePhase .middle a + 2 * Real.pi * a =
        2 * Real.pi * a by simp [brrsSurfaceWavePhase],
        abs_of_nonneg hnonneg]
      calc
        a = 1 * a := by ring
        _ ≤ (2 * Real.pi) * a := mul_le_mul_of_nonneg_right hcoef ha0
        _ = 2 * Real.pi * a := by ring
  have habspos : 0 < |brrsSurfaceWavePhase part a + 2 * Real.pi * a| :=
    lt_of_lt_of_le hapos hphase_lower
  have hphase_ne : brrsSurfaceWavePhase part a + 2 * Real.pi * a ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at habspos
    linarith
  have hraw :
      ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1))) := by
    simpa only [brrsStationaryWaveComponentIntegral] using
      hcomponent a a ha hphase_ne
  have hratio : 1 ≤ a / 16 := by linarith
  have hsqrt : 1 ≤ Real.sqrt (a / 16) := Real.one_le_sqrt.mpr hratio
  have hdenone : 1 ≤ (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) :=
    one_le_pow₀ hsqrt
  have hdenpos : 0 < (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) :=
    lt_of_lt_of_le zero_lt_one hdenone
  have hdiv : C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1) ≤ C := by
    apply (div_le_iff₀ hdenpos).mpr
    exact le_mul_of_one_le_right hC.le hdenone
  have hinv : 1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a| ≤ 1 / a :=
    one_div_le_one_div_of_le hapos hphase_lower
  have hinvpow :
      (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) ≤
        (1 / a) ^ (n + 2) :=
    pow_le_pow_left₀ (by positivity) hinv _
  have hconst : 0 ≤ (1 - (1 / 32 : Real)) * C := by positivity
  calc
    ‖brrsStationaryWaveComponentIntegral Φ (2 * n + 3) part a a‖ ≤
        (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) *
            (C / (Real.sqrt (a / 16)) ^ ((2 * n + 3) - 1))) := hraw
    _ ≤ (1 / |brrsSurfaceWavePhase part a + 2 * Real.pi * a|) ^ (n + 2) *
          ((1 - (1 / 32 : Real)) * C) := by
      apply mul_le_mul_of_nonneg_left
      · exact mul_le_mul_of_nonneg_left hdiv (by norm_num)
      · positivity
    _ ≤ (1 / a) ^ (n + 2) * ((1 - (1 / 32 : Real)) * C) :=
      mul_le_mul_of_nonneg_right hinvpow hconst
    _ = C' / a ^ (n + 2) := by
      dsimp [C']
      rw [one_div, inv_pow]
      ring

/-- The literal level-zero positive `TT*` half-wave kernel has nontrivial mass
on every sufficiently large outgoing cone in odd dimension.  The proof uses
the exact three-component stationary decomposition: the outgoing component has
the nonzero endpoint lower term, while incoming and middle components gain one
additional power of the cone radius. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧ ∀ (a : Real) (v : BRRSSpace (2 * n + 3)),
      A ≤ a → ‖v‖ = 1 →
        c / a ^ (n + 1) ≤
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0 a :
            BRRSSpace (2 * n + 3) → Complex) (a • v)‖ := by
  obtain ⟨Aout, cout, hAout, hcout, hout⟩ :=
    exists_brrsStationaryWaveComponentIntegral_ttStar_outgoing_cone_eventually_lower
      Φ n
  obtain ⟨Cin, hCin, hin⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
      (brrsTTStarAnnularCutoff Φ) n .incoming (by simp)
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_brrsStationaryWaveComponentIntegral_nonoutgoing_cone_highRadius_power_le
      (brrsTTStarAnnularCutoff Φ) n .middle (by simp)
  let E : Real := Cin + Cmid
  have hE : 0 < E := by
    dsimp [E]
    linarith
  let A : Real := max Aout (max 16 (2 * E / cout))
  refine ⟨A, cout / 2, ?_, by positivity, ?_⟩
  · exact le_trans (le_max_left _ _) (le_max_right _ _)
  intro a v ha hv
  let Ψ : BRRSAnnularCutoff := brrsTTStarAnnularCutoff Φ
  let O : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .outgoing a a
  let I : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .incoming a a
  let M : Complex :=
    brrsStationaryWaveComponentIntegral Ψ (2 * n + 3) .middle a a
  let K : Complex :=
    (brrsDyadicHalfWaveKernel Ψ 0 a : BRRSSpace (2 * n + 3) → Complex) (a • v)
  change cout / 2 / a ^ (n + 1) ≤ ‖K‖
  have hinner : max 16 (2 * E / cout) ≤ a :=
    le_trans (le_max_right _ _) ha
  have haout : Aout ≤ a := le_trans (le_max_left _ _) ha
  have ha16 : 16 ≤ a := le_trans (le_max_left _ _) hinner
  have hratio : 2 * E / cout ≤ a := le_trans (le_max_right _ _) hinner
  have ha0 : 0 ≤ a := by linarith
  have hapos : 0 < a := by linarith
  have hout' : cout / a ^ (n + 1) ≤ ‖O‖ := by
    dsimp [O, Ψ]
    exact hout a haout
  have hin' : ‖I‖ ≤ Cin / a ^ (n + 2) := by
    dsimp [I, Ψ]
    exact hin a ha16
  have hmid' : ‖M‖ ≤ Cmid / a ^ (n + 2) := by
    dsimp [M, Ψ]
    exact hmid a ha16
  have hsum : ‖I‖ + ‖M‖ ≤ E / a ^ (n + 2) := by
    calc
      ‖I‖ + ‖M‖ ≤ Cin / a ^ (n + 2) + Cmid / a ^ (n + 2) :=
        add_le_add hin' hmid'
      _ = E / a ^ (n + 2) := by
        dsimp [E]
        ring
  have htwoE : 2 * E ≤ a * cout :=
    (div_le_iff₀ hcout).mp hratio
  have hEover : E / a ≤ cout / 2 := by
    apply (div_le_iff₀ hapos).mpr
    nlinarith
  have hpowers : a ^ (n + 2) = a * a ^ (n + 1) := by
    rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
    ring
  have htail : E / a ^ (n + 2) ≤ (cout / 2) / a ^ (n + 1) := by
    calc
      E / a ^ (n + 2) = (E / a) / a ^ (n + 1) := by
        rw [hpowers]
        field_simp [ne_of_gt hapos]
      _ ≤ (cout / 2) / a ^ (n + 1) :=
        div_le_div_of_nonneg_right hEover (pow_nonneg ha0 _)
  have hnorm : ‖a • v‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ha0, hv, mul_one]
  have hsplit :=
    brrsDyadicHalfWaveKernel_eq_levelZero_sum_stationaryWaveComponents
      (d := 2 * n + 3) (by omega) Ψ a (a • v)
  rw [hnorm] at hsplit
  have hK : K = O + I + M := by
    dsimp [K, O, I, M]
    simpa only [brrsStationaryWaveComponentIntegral] using hsplit
  have htri : ‖O‖ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
    calc
      ‖O‖ = ‖K - (I + M)‖ := by
        congr 1
        rw [hK]
        ring
      _ ≤ ‖K‖ + ‖I + M‖ := norm_sub_le _ _
      _ ≤ ‖K‖ + (‖I‖ + ‖M‖) := by
        gcongr
        exact norm_add_le _ _
  have hhalf : cout / a ^ (n + 1) =
      2 * ((cout / 2) / a ^ (n + 1)) := by ring
  nlinarith [hsum.trans htail]

/-- Exact dyadic transport of the odd-dimensional positive `TT*` cone lower
bound.  At physical scale `j`, the cone point is `relativeTime • v`, while its
level-zero radius is `q * relativeTime` for `q = 2^j`; the Jacobian contributes
the literal factor `q^(2n+3)`. -/
theorem exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_dyadic_eventually_lower
    (Φ : BRRSAnnularCutoff) (n : Nat) :
    ∃ A c : Real, 16 ≤ A ∧ 0 < c ∧
      ∀ (j : Nat) (relativeTime : Real) (v : BRRSSpace (2 * n + 3)),
        A ≤ (2 : Real) ^ j * relativeTime → ‖v‖ = 1 →
          ((2 : Real) ^ j) ^ (2 * n + 3) * c /
              ((2 : Real) ^ j * relativeTime) ^ (n + 1) ≤
            ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j relativeTime :
              BRRSSpace (2 * n + 3) → Complex) (relativeTime • v)‖ := by
  obtain ⟨A, c, hA, hc, hlevel⟩ :=
    exists_brrsDyadicHalfWaveKernel_ttStar_outgoing_cone_eventually_lower Φ n
  refine ⟨A, c, hA, hc, ?_⟩
  intro j relativeTime v hlarge hv
  let q : Real := (2 : Real) ^ j
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hlarge' : A ≤ q * relativeTime := by simpa only [q] using hlarge
  have hzero := hlevel (q * relativeTime) v hlarge' hv
  have hmult :
      q ^ (2 * n + 3) * (c / (q * relativeTime) ^ (n + 1)) ≤
        q ^ (2 * n + 3) *
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
            (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
              ((q * relativeTime) • v)‖ :=
    mul_le_mul_of_nonneg_left hzero (pow_nonneg hq.le _)
  change q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) ≤
    ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) j relativeTime :
      BRRSSpace (2 * n + 3) → Complex) (relativeTime • v)‖
  rw [brrsDyadicHalfWaveKernel_eq_levelZero_scaled_general]
  change q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) ≤
    ‖q ^ (2 * n + 3) •
      (brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
        (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
          (q • (relativeTime • v))‖
  rw [smul_smul, norm_smul, Real.norm_eq_abs,
    abs_of_nonneg (pow_nonneg hq.le _)]
  calc
    q ^ (2 * n + 3) * c / (q * relativeTime) ^ (n + 1) =
        q ^ (2 * n + 3) * (c / (q * relativeTime) ^ (n + 1)) := by ring
    _ ≤ q ^ (2 * n + 3) *
          ‖(brrsDyadicHalfWaveKernel (brrsTTStarAnnularCutoff Φ) 0
            (q * relativeTime) : BRRSSpace (2 * n + 3) → Complex)
              ((q * relativeTime) • v)‖ := hmult

/-- A nonzero endpoint coefficient forces the first odd quadratic stationary
moment to have its sharp eventual lower size. -/
theorem exists_quadraticMoment_one_eventually_lower_of_ne_zero
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ≤ ‖quadraticMomentIntegral 1 h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_zero_decay (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2)
  let a : Real := ‖h 0‖
  have ha : 0 < a := norm_pos_iff.mpr hzero
  let B : Real := 4 * C / a
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max 1 (B ^ 2), a / 4, ?_, by positivity, ?_⟩
  · exact le_max_left _ _
  intro lambda hlambda
  have hlambda_one : 1 ≤ lambda := le_trans (le_max_left _ _) hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsquare : B ^ 2 ≤ lambda := le_trans (le_max_right _ _) hlambda
  have hsqrt_sq : (Real.sqrt lambda) ^ 2 = lambda := Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hfourC : 4 * C ≤ Real.sqrt lambda * a := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ ha).mp hB_le_sqrt
  have hrest : ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ a / 4 := by
    calc
      ‖quadraticMomentIntegral 0 (deriv h) lambda‖ ≤ C / Real.sqrt lambda :=
        hCbound lambda hlambda_one
      _ ≤ a / 4 := by
        rw [div_le_iff₀ hsqrt_pos]
        nlinarith
  have hsum : 3 * a / 4 ≤
      ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ := by
    have htriangle : ‖h 0‖ ≤
        ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ +
          ‖quadraticMomentIntegral 0 (deriv h) lambda‖ := by
      calc
        ‖h 0‖ = ‖(h 0 + quadraticMomentIntegral 0 (deriv h) lambda) -
            quadraticMomentIntegral 0 (deriv h) lambda‖ := by ring_nf
        _ ≤ ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ +
            ‖quadraticMomentIntegral 0 (deriv h) lambda‖ := norm_sub_le _ _
    change 3 * a / 4 ≤ _
    linarith
  have hformula := quadraticMomentIntegral_one_recurrence h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  rw [hformula, norm_mul, hscalar]
  calc
    a / 4 / lambda ≤ (3 * a / 8) / lambda := by
      apply div_le_div_of_nonneg_right
      · nlinarith
      · exact hlambda_pos.le
    _ = (1 / (2 * lambda)) * (3 * a / 4) := by
      field_simp
      ring
    _ ≤ (1 / (2 * lambda)) *
        ‖h 0 + quadraticMomentIntegral 0 (deriv h) lambda‖ := by
      exact mul_le_mul_of_nonneg_left hsum (by positivity)

/-- The concrete nonplanar endpoint symbol in dimension three therefore has
the sharp eventual `lambda⁻¹` lower size. -/
theorem exists_smoothEndpointQuadraticIntegral_one_eventually_lower :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ≤ ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_one_eventually_lower_of_ne_zero
      (smoothEndpointProfile 1) (contDiff_smoothEndpointProfile 1)
      (smoothEndpointProfile_eventuallyEq_zero_at_one 1)
      (brrs_smoothEndpointProfile_zero_ne_zero 1)
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- The same dimension-three endpoint lower bound is valid for both signs of
the stationary parameter.  This is the form used by the outgoing and
incoming half-wave phases. -/
theorem exists_smoothEndpointQuadraticIntegral_one_eventually_lower_abs :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ |lambda| →
      c / |lambda| ≤ ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_one_eventually_lower
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rcases le_total 0 lambda with hnonneg | hnonpos
  · have hlarge : L ≤ lambda := by
      simpa [abs_of_nonneg hnonneg] using hlambda
    simpa [abs_of_nonneg hnonneg] using hbound lambda hlarge
  · by_cases hzero : lambda = 0
    · subst lambda
      norm_num at hlambda
      linarith
    · have hneg : lambda < 0 := lt_of_le_of_ne hnonpos hzero
      have hlarge : L ≤ -lambda := by
        simpa [abs_of_neg hneg] using hlambda
      have hpositive := hbound (-lambda) hlarge
      calc
        c / |lambda| = c / (-lambda) := by rw [abs_of_neg hneg]
        _ ≤ ‖smoothEndpointQuadraticIntegral 1 (-lambda)‖ := hpositive
        _ = ‖smoothEndpointQuadraticIntegral 1 lambda‖ := by
          simpa only [neg_neg] using
            (norm_smoothEndpointQuadraticIntegral_neg 1 (-lambda)).symm

/-- At the even remainder orders occurring in the odd-moment recurrence, the
quadratic stationary scale is exactly one extra square-root beyond an
integral power of `lambda`. -/
private theorem brrs_quadraticMomentScale_even_remainder
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 2) lambda =
      lambda ^ (n + 1) * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 2 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1) + 1) := by congr 1
    _ = (Real.sqrt lambda ^ (2 * (n + 1))) * Real.sqrt lambda := by
      rw [show 2 * (n + 1) + 1 = Nat.succ (2 * (n + 1)) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ (n + 1) * Real.sqrt lambda := by rw [hsquare]

/-- The leading stationary scale of an even endpoint moment. -/
private theorem brrs_quadraticMomentScale_even
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n) lambda =
      lambda ^ n * Real.sqrt lambda := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 1) =
        (Real.sqrt lambda ^ (2 * n)) * Real.sqrt lambda := by
      rw [show 2 * n + 1 = Nat.succ (2 * n) by omega, pow_succ]
    _ = (Real.sqrt lambda ^ 2) ^ n * Real.sqrt lambda := by
      rw [← pow_mul]
    _ = lambda ^ n * Real.sqrt lambda := by rw [hsquare]

/-- The derivative remainder in an even-order recurrence has integral-power
stationary scale. -/
private theorem brrs_quadraticMomentScale_odd
    (n : Nat) {lambda : Real} (hlambda : 0 ≤ lambda) :
    quadraticMomentScale (2 * n + 1) lambda = lambda ^ (n + 1) := by
  unfold quadraticMomentScale
  have hsquare : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda
  calc
    Real.sqrt lambda ^ (2 * n + 1 + 1) =
        Real.sqrt lambda ^ (2 * (n + 1)) := by congr 1
    _ = (Real.sqrt lambda ^ 2) ^ (n + 1) := by rw [pow_mul]
    _ = lambda ^ (n + 1) := by rw [hsquare]

/-! ### A normalized finite Fresnel lower bound

The elementary unit-quadratic Fresnel integral is the analytic base case for
the order-zero stationary term.  The estimate below deliberately concerns a
finite truncation only: its proof keeps a positive core on `[0, 3 / 2]` and
controls the remaining finite tail by the proved quadratic-phase integration
by-parts estimate.  Thus it does not invoke, or conceal, an improper-integral
asymptotic. -/

/-- The unit-scale truncated quadratic Fresnel integral.  This normalization
is the one obtained from `∫₀¹ exp (i λ u²) du` after the substitution
`v = sqrt λ * u`. -/
noncomputable def brrsNormalizedQuadraticFresnelIntegral (R : Real) : Complex :=
  intervalIntegral
    (fun u => Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)) 0 R volume

private theorem brrsNormalizedQuadraticFresnelIntegrand_im (u : Real) :
    (Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)).im =
      Real.sin (u ^ 2) := by
  rw [Complex.exp_ofReal_mul_I]
  rw [Complex.add_im, Complex.mul_im, Complex.ofReal_re, Complex.ofReal_im,
    Complex.I_re, Complex.I_im]
  ring

private theorem brrsNormalizedQuadraticFresnel_core_polynomial_integral :
    intervalIntegral (fun u => u ^ 2 - u ^ 6 / 6) 0 (3 / 2) volume =
      (1287 / 1792 : Real) := by
  rw [intervalIntegral.integral_sub]
  · rw [integral_pow, intervalIntegral.integral_div, integral_pow]
    norm_num
  · exact (continuous_pow 2).intervalIntegrable _ _
  · exact ((continuous_pow 6).div continuous_const (by norm_num)).intervalIntegrable _ _

private theorem brrsNormalizedQuadraticFresnel_core_lower :
    (1287 / 1792 : Real) ≤
      intervalIntegral (fun u => Real.sin (u ^ 2)) 0 (3 / 2) volume := by
  rw [← brrsNormalizedQuadraticFresnel_core_polynomial_integral]
  apply intervalIntegral.integral_mono
  · norm_num
  · exact ((continuous_pow 2).sub
      ((continuous_pow 6).div continuous_const (by norm_num))).intervalIntegrable _ _
  · exact (Real.continuous_sin.comp (continuous_pow 2)).intervalIntegrable _ _
  intro u
  simpa [show (u ^ 2) ^ 3 = u ^ 6 by ring] using
    (Real.sin_ge_sub_cube (sq_nonneg u))

/-- An explicit lower bound for every sufficiently long normalized quadratic
Fresnel truncation.  The positive core is bounded below using
`sin_ge_sub_cube`; the tail from `3 / 2` to `R` is bounded by
`quadratic_phase_tail_norm_le_inv`. -/
theorem brrsNormalizedQuadraticFresnelIntegral_norm_lower
    (R : Real) (hR : (3 / 2 : Real) ≤ R) :
    (277 / 5376 : Real) ≤ norm (brrsNormalizedQuadraticFresnelIntegral R) := by
  let F : Real -> Complex := fun u =>
    Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)
  have hFcont : Continuous F := by
    dsimp [F]
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (continuous_pow 2)).mul continuous_const
  have hFim : ∀ a b : Real,
      (intervalIntegral F a b volume).im =
        intervalIntegral (fun u => Real.sin (u ^ 2)) a b volume := by
    intro a b
    calc
      (intervalIntegral F a b volume).im =
          intervalIntegral (fun u => (F u).im) a b volume :=
        (intervalIntegral.intervalIntegral_im (hFcont.intervalIntegrable a b)).symm
      _ = intervalIntegral (fun u => Real.sin (u ^ 2)) a b volume := by
        apply intervalIntegral.integral_congr
        intro u _
        exact brrsNormalizedQuadraticFresnelIntegrand_im u
  have hcore : (1287 / 1792 : Real) ≤
      (intervalIntegral F 0 (3 / 2) volume).im := by
    rw [hFim]
    exact brrsNormalizedQuadraticFresnel_core_lower
  have htailnorm : norm (intervalIntegral F (3 / 2) R volume) ≤ (2 / 3 : Real) := by
    have htail := quadratic_phase_tail_norm_le_inv (a := (3 / 2 : Real)) (b := R) (c := 1)
      (by norm_num) hR (by norm_num)
    simpa only [F, one_mul, inv_div] using htail
  have htail : -(2 / 3 : Real) ≤ (intervalIntegral F (3 / 2) R volume).im := by
    apply neg_le_of_abs_le
    exact (Complex.abs_im_le_norm _).trans htailnorm
  have hsplit :
      intervalIntegral F 0 (3 / 2) volume + intervalIntegral F (3 / 2) R volume =
        intervalIntegral F 0 R volume :=
    intervalIntegral.integral_add_adjacent_intervals
      (hFcont.intervalIntegrable 0 (3 / 2))
      (hFcont.intervalIntegrable (3 / 2) R)
  have him : (277 / 5376 : Real) ≤ (intervalIntegral F 0 R volume).im := by
    calc
      (277 / 5376 : Real) = 1287 / 1792 - 2 / 3 := by norm_num
      _ ≤ (intervalIntegral F 0 (3 / 2) volume).im +
          (intervalIntegral F (3 / 2) R volume).im := by linarith
      _ = (intervalIntegral F 0 R volume).im := by
        rw [← hsplit]
        rfl
  change (277 / 5376 : Real) ≤ norm (intervalIntegral F 0 R volume)
  exact him.trans (Complex.im_le_norm _)

/-- Existentially packaged form of the uniform finite-truncation lower bound.
It records the concrete threshold and positive constant separately so that it
can be used as a scale-normalized stationary-phase input. -/
theorem exists_brrsNormalizedQuadraticFresnelIntegral_eventually_norm_lower :
    ∃ B c : Real, (3 / 2 : Real) ≤ B ∧ 0 < c ∧ ∀ R : Real, B ≤ R →
      c ≤ norm (brrsNormalizedQuadraticFresnelIntegral R) := by
  refine ⟨3 / 2, 277 / 5376, by norm_num, by norm_num, ?_⟩
  intro R hR
  exact brrsNormalizedQuadraticFresnelIntegral_norm_lower R hR

/-- The difference of two finite normalized Fresnel truncations is precisely
the intervening nonstationary tail.  Keeping this as an exact identity makes
the subsequent coherent-carrier estimate independent of any improper
integral. -/
theorem brrsNormalizedQuadraticFresnelIntegral_sub_eq_tail
    (R0 R : Real) :
    brrsNormalizedQuadraticFresnelIntegral R -
        brrsNormalizedQuadraticFresnelIntegral R0 =
      intervalIntegral
        (fun u => Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I))
        R0 R volume := by
  let F : Real -> Complex := fun u =>
    Complex.exp (((u ^ 2 : Real) : Complex) * Complex.I)
  have hFcont : Continuous F := by
    dsimp [F]
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (continuous_pow 2)).mul continuous_const
  change intervalIntegral F 0 R volume - intervalIntegral F 0 R0 volume =
    intervalIntegral F R0 R volume
  rw [← intervalIntegral.integral_add_adjacent_intervals
    (hFcont.intervalIntegrable 0 R0) (hFcont.intervalIntegrable R0 R)]
  abel

/-- Quantitative Cauchy control of the finite normalized Fresnel truncations.
For a fixed positive cutoff `R0`, all later truncations lie within `R0⁻¹` of
the same complex value. -/
theorem brrsNormalizedQuadraticFresnelIntegral_tail_distance_le
    {R0 R : Real} (hR0 : 0 < R0) (hR : R0 ≤ R) :
    norm (brrsNormalizedQuadraticFresnelIntegral R -
      brrsNormalizedQuadraticFresnelIntegral R0) ≤ R0⁻¹ := by
  rw [brrsNormalizedQuadraticFresnelIntegral_sub_eq_tail]
  have htail := quadratic_phase_tail_norm_le_inv
    (a := R0) (b := R) (c := 1) hR0 hR (by norm_num)
  simpa using htail

/-- The actual improper Fresnel value, defined as the limit of its finite
quadratic truncations.  The next lemmas evaluate this limit by Abel damping;
unlike the finite carrier below, this definition is independent of a chosen
cutoff. -/
noncomputable def brrsQuadraticFresnelLimit : Complex :=
  limUnder atTop brrsNormalizedQuadraticFresnelIntegral

/-- The elementary `R⁻¹` tail estimate makes the finite Fresnel truncations
converge to their improper value. -/
theorem brrsNormalizedQuadraticFresnelIntegral_tendsto_limit :
    Tendsto brrsNormalizedQuadraticFresnelIntegral atTop
      (nhds brrsQuadraticFresnelLimit) := by
  have hcauchy : CauchySeq brrsNormalizedQuadraticFresnelIntegral := by
    refine (Metric.cauchySeq_iff').2 ?_
    intro eps heps
    let N : Real := eps⁻¹ + 1
    have hNone : 0 < N := by
      dsimp [N]
      positivity
    have hquot : N⁻¹ < eps := by
      apply (inv_lt_iff_one_lt_mul₀' hNone).mpr
      dsimp [N]
      calc
        1 < eps * (eps⁻¹ + 1) := by
          rw [mul_add, mul_inv_cancel₀ (ne_of_gt heps)]
          linarith
        _ = (eps⁻¹ + 1) * eps := by ring
    refine ⟨N, ?_⟩
    intro R hR
    simpa only [dist_eq_norm] using
      (lt_of_le_of_lt
        (brrsNormalizedQuadraticFresnelIntegral_tail_distance_le hNone hR) hquot)
  simpa only [brrsQuadraticFresnelLimit] using hcauchy.tendsto_limUnder

/-- A concrete nonzero carrier for the normalized Fresnel truncations.  The
choice `64` makes the nonstationary tail smaller than half the certified
carrier magnitude. -/
noncomputable def brrsNormalizedQuadraticFresnelCarrier : Complex :=
  brrsNormalizedQuadraticFresnelIntegral 64

/-- The fixed Fresnel carrier has a quantitative nonvanishing margin. -/
theorem brrsNormalizedQuadraticFresnelCarrier_norm_lower :
    (1 / 32 : Real) ≤ norm brrsNormalizedQuadraticFresnelCarrier := by
  change (1 / 32 : Real) ≤ norm (brrsNormalizedQuadraticFresnelIntegral 64)
  exact le_trans (by norm_num)
    (brrsNormalizedQuadraticFresnelIntegral_norm_lower 64 (by norm_num))

/-- The fixed carrier is genuinely nonzero. -/
theorem brrsNormalizedQuadraticFresnelCarrier_ne_zero :
    brrsNormalizedQuadraticFresnelCarrier ≠ 0 := by
  intro hzero
  have hbad : (1 / 32 : Real) ≤ 0 := by
    simpa [hzero] using brrsNormalizedQuadraticFresnelCarrier_norm_lower
  norm_num at hbad

/-- Every truncation past `64` stays in a fixed small neighborhood of the
same nonzero complex carrier.  This is a finite, quantitative coherence
statement suitable for a later even-dimensional stationary-phase transfer. -/
theorem brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier
    (R : Real) (hR : (64 : Real) ≤ R) :
    norm (brrsNormalizedQuadraticFresnelIntegral R -
      brrsNormalizedQuadraticFresnelCarrier) ≤ (1 / 64 : Real) := by
  simpa [brrsNormalizedQuadraticFresnelCarrier] using
    (brrsNormalizedQuadraticFresnelIntegral_tail_distance_le
      (R0 := (64 : Real)) (R := R) (by norm_num) hR)

/-- Existential packaging of the coherent finite Fresnel carrier.  In
particular, the carrier has at least twice the radius of the uniform tail
neighborhood. -/
theorem exists_brrsNormalizedQuadraticFresnelIntegral_coherentCarrier :
    ∃ R0 c : Real, 0 < c ∧
      2 * c ≤ norm (brrsNormalizedQuadraticFresnelIntegral R0) ∧
      ∀ R : Real, R0 ≤ R →
        norm (brrsNormalizedQuadraticFresnelIntegral R -
          brrsNormalizedQuadraticFresnelIntegral R0) ≤ c := by
  refine ⟨64, 1 / 64, by norm_num, ?_, ?_⟩
  · calc
      2 * (1 / 64 : Real) = 1 / 32 := by norm_num
      _ ≤ norm (brrsNormalizedQuadraticFresnelIntegral 64) := by
        simpa [brrsNormalizedQuadraticFresnelCarrier] using
          brrsNormalizedQuadraticFresnelCarrier_norm_lower
  · intro R hR
    simpa [brrsNormalizedQuadraticFresnelCarrier] using
      (brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier R hR)

/-! ### Fixed carriers for even quadratic endpoint moments

For the literal Bessel asymptotic needed in BRRS (3.3), the endpoint
normalization must converge to a fixed complex number with one full inverse
power of error.  The cancellation below is the elementary even-amplitude
stationary-phase mechanism: differentiating `sqrt(lambda) I_0(lambda)` and
using the first two integration-by-parts recurrences removes the order-zero
term. -/

/-- The normalized order-zero endpoint moment whose limit is the even
quadratic stationary carrier. -/
noncomputable def brrsEvenQuadraticBaseNormalized
    (h : Real -> Complex) (lambda : Real) : Complex :=
  (Real.sqrt lambda : Complex) * quadraticMomentIntegral 0 h lambda

/-- After the exact recurrence cancellation, the derivative of the normalized
even endpoint moment is a first derivative moment with an integrable
`lambda⁻²` size. -/
theorem brrs_hasDerivAt_evenQuadraticBaseNormalized
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {lambda : Real} (hlambda : 0 < lambda) :
    HasDerivAt (brrsEvenQuadraticBaseNormalized h)
      (-(1 / (2 * Real.sqrt lambda) : Complex) *
        quadraticMomentIntegral 1 (deriv h) lambda) lambda := by
  have hsqrt : HasDerivAt Real.sqrt
      (1 / (2 * Real.sqrt lambda)) lambda := by
    exact Real.hasDerivAt_sqrt (ne_of_gt hlambda)
  have hmoment := hasDerivAt_quadraticMomentIntegral 0 h hh lambda
  have hsqrtC : HasDerivAt (fun t : Real => (Real.sqrt t : Complex))
      (1 / (2 * Real.sqrt lambda) : Complex) lambda := by
    convert hsqrt.ofReal_comp using 1
    push_cast
    rfl
  have hprod := hsqrtC.mul hmoment
  have hrec := quadraticMomentIntegral_succ_two_recurrence 0 h hh hvanish
    (ne_of_gt hlambda)
  have hsqrt_ne : Not (Real.sqrt lambda = 0) := Real.sqrt_ne_zero'.mpr hlambda
  have hlambda_sq : Real.sqrt lambda ^ 2 = lambda := Real.sq_sqrt hlambda.le
  have hderivEq :
      (Real.sqrt lambda : Complex) *
          (Complex.I * quadraticMomentIntegral (0 + 2) h lambda) =
        -(1 / (2 * Real.sqrt lambda) : Complex) *
          quadraticMomentIntegral 0 h lambda +
          (-(1 / (2 * Real.sqrt lambda) : Complex) *
            quadraticMomentIntegral 1 (deriv h) lambda) := by
    rw [hrec]
    push_cast
    field_simp [hsqrt_ne, ne_of_gt hlambda]
    have hcoerced : (Real.sqrt lambda : Complex) ^ 2 = (lambda : Complex) := by
      exact_mod_cast hlambda_sq
    rw [hcoerced]
    ring
  rw [hderivEq] at hprod
  change HasDerivAt
    (fun t => (Real.sqrt t : Complex) * quadraticMomentIntegral 0 h t)
    (-(1 / (2 * Real.sqrt lambda) : Complex) *
      quadraticMomentIntegral 1 (deriv h) lambda) lambda
  have hfun :
      ((fun t : Real => (Real.sqrt t : Complex)) * quadraticMomentIntegral 0 h) =
        (fun t => (Real.sqrt t : Complex) * quadraticMomentIntegral 0 h t) := by
    rfl
  rw [hfun] at hprod
  convert hprod using 1 <;> try rfl
  simp only [neg_mul, ← add_assoc, add_neg_cancel, zero_add]


/-- If the endpoint amplitude has vanishing first derivative at the stationary
point, the normalized order-zero moment has an integrable `lambda^-2`
derivative. This is the quantitative cancellation needed to construct its
fixed stationary carrier. -/
theorem exists_brrsEvenQuadraticBaseNormalized_deriv_decay
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      ‖deriv (brrsEvenQuadraticBaseNormalized h) lambda‖ ≤ C / lambda ^ 2 := by
  obtain ⟨C, hC, hleading⟩ :=
    exists_quadraticMoment_odd_leading_asymptotic 0 (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) hvanish.deriv
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlambda_pos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  let q : Complex := ((2 * lambda : Real) : Complex) * Complex.I
  let Ione : Complex := quadraticMomentIntegral 1 (deriv h) lambda
  have hqIone : ‖q * Ione‖ ≤ C / Real.sqrt lambda := by
    dsimp [q, Ione]
    simpa [brrsOddQuadraticLeadingCoefficient, hderiv_zero] using
      hleading lambda hlambda
  have hqnorm : ‖q‖ = 2 * lambda := by
    dsimp [q]
    exact brrs_norm_quadraticCarrier lambda hlambda_pos.le
  have hscaled : (2 * lambda) * ‖Ione‖ ≤ C / Real.sqrt lambda := by
    calc
      (2 * lambda) * ‖Ione‖ = ‖q * Ione‖ := by
        rw [norm_mul, hqnorm]
      _ ≤ C / Real.sqrt lambda := hqIone
  have hIone : ‖Ione‖ ≤ (C / Real.sqrt lambda) / (2 * lambda) := by
    calc
      ‖Ione‖ = (1 / (2 * lambda)) * ((2 * lambda) * ‖Ione‖) := by
        field_simp [ne_of_gt hlambda_pos]
      _ ≤ (1 / (2 * lambda)) * (C / Real.sqrt lambda) := by
        gcongr
      _ = (C / Real.sqrt lambda) / (2 * lambda) := by ring
  have hcoef : ‖-(1 / (2 * Real.sqrt lambda) : Complex)‖ =
      1 / (2 * Real.sqrt lambda) := by
    rw [norm_neg, norm_div, norm_one, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hsqrt_pos]
    norm_num
  have hderiv :=
    (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish hlambda_pos).deriv
  change ‖deriv (brrsEvenQuadraticBaseNormalized h) lambda‖ ≤ C / lambda ^ 2
  rw [hderiv]
  calc
    ‖-(1 / (2 * Real.sqrt lambda) : Complex) * Ione‖ =
        (1 / (2 * Real.sqrt lambda)) * ‖Ione‖ := by
          rw [norm_mul, hcoef]
    _ ≤ (1 / (2 * Real.sqrt lambda)) *
        ((C / Real.sqrt lambda) / (2 * lambda)) := by
          gcongr
    _ = C / (4 * lambda ^ 2) := by
          field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos]
          rw [Real.sq_sqrt hlambda_pos.le]
          ring
    _ ≤ C / lambda ^ 2 := by
          have hlambda_sq_pos : 0 < lambda ^ 2 := pow_pos hlambda_pos _
          have hnonneg : 0 ≤ C / lambda ^ 2 :=
            div_nonneg hC.le hlambda_sq_pos.le
          calc
            C / (4 * lambda ^ 2) = (C / lambda ^ 2) / 4 := by
              field_simp [ne_of_gt hlambda_sq_pos]
            _ ≤ C / lambda ^ 2 := by nlinarith

/-- The elementary reciprocal-square antiderivative used to turn an
integrable derivative estimate into a quantitative tail estimate. -/
private theorem brrs_intervalIntegral_inv_sq {a b : Real} (ha : 0 < a)
    (hab : a ≤ b) :
    (∫ t in a..b, Inv.inv (t ^ 2)) = Inv.inv a - Inv.inv b := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hcont : ContinuousOn (fun x : Real => Inv.inv (x ^ 2)) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (-(fun y : Real => Inv.inv y)) (Inv.inv (x ^ 2)) x := by
    intro x hx
    simpa using (hasDerivAt_inv (ne_of_gt (hpos x hx))).neg
  have h := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := fun _ : Real => (1 : Real)) (u' := fun _ : Real => (0 : Real))
    (v := -(fun y : Real => Inv.inv y)) (v' := fun y : Real => Inv.inv (y ^ 2))
    (fun _ _ => hasDerivAt_const _ (1 : Real)) hderiv
    (Continuous.intervalIntegrable (by fun_prop) a b)
    hcont.intervalIntegrable
  simp only [one_mul, Pi.neg_apply, zero_mul, intervalIntegral.integral_zero, sub_zero] at h
  calc
    (∫ t in a..b, Inv.inv (t ^ 2)) = -Inv.inv b - -Inv.inv a := h
    _ = Inv.inv a - Inv.inv b := by ring

/-- Finite coherence of the normalized even endpoint moment.  The estimate is
the exact `O(a^-1)` tail obtained by integrating its `O(lambda^-2)`
derivative over `[a,b]`. -/
theorem exists_brrsEvenQuadraticBaseNormalized_tail_bound
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ {a b : Real}, 1 ≤ a → a ≤ b →
      norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h a) ≤ C / a := by
  obtain ⟨C, hC, hderiv_bound⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_deriv_decay h hh hvanish hderiv_zero
  refine ⟨C, hC, ?_⟩
  intro a b ha hab
  have ha_pos : 0 < a := lt_of_lt_of_le zero_lt_one ha
  have hb_pos : 0 < b := lt_of_lt_of_le ha_pos hab
  have hcont : ContinuousOn (brrsEvenQuadraticBaseNormalized h) (Set.Icc a b) := by
    intro x hx
    exact (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish
      (lt_of_lt_of_le ha_pos hx.1)).continuousAt.continuousWithinAt
  have hdiff : DifferentiableOn Real (brrsEvenQuadraticBaseNormalized h)
      (Set.Ioo a b) := by
    intro x hx
    exact (brrs_hasDerivAt_evenQuadraticBaseNormalized h hh hvanish
      (lt_trans ha_pos hx.1)).differentiableAt.differentiableWithinAt
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha_pos hx'.1
  have hmajor_cont : ContinuousOn (fun x : Real => C / x ^ 2) (Set.uIcc a b) := by
    refine continuousOn_const.div (continuousOn_id.pow 2) ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hline := norm_sub_le_integral_of_norm_deriv_le_of_le
    (f := brrsEvenQuadraticBaseNormalized h) (B := fun x : Real => C / x ^ 2)
    hab hcont hdiff
    (Filter.Eventually.of_forall (fun x hx =>
      hderiv_bound x (le_trans ha (le_of_lt hx.1))))
    hmajor_cont.intervalIntegrable
  calc
    norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h a) ≤
        ∫ x in a..b, C / x ^ 2 := hline
    _ = C * (Inv.inv a - Inv.inv b) := by
      have hfactor : (fun x : Real => C / x ^ 2) =
          fun x => C * Inv.inv (x ^ 2) := by
        funext x
        rw [div_eq_mul_inv]
      rw [hfactor, intervalIntegral.integral_const_mul,
        brrs_intervalIntegral_inv_sq ha_pos hab]
    _ ≤ C * Inv.inv a := by
      apply mul_le_mul_of_nonneg_left
        (sub_le_self _ (inv_nonneg.mpr hb_pos.le)) hC.le
    _ = C / a := by rw [div_eq_mul_inv]

/-- The fixed stationary carrier of the normalized even quadratic endpoint
moment.  Convergence and its quantitative tail are proved below under the
natural stationary cancellation hypotheses. -/
noncomputable def brrsEvenQuadraticBaseCarrier (h : Real -> Complex) : Complex :=
  limUnder atTop (brrsEvenQuadraticBaseNormalized h)

/-- The finite `O(a^-1)` coherence bound makes the normalized even endpoint
moment Cauchy at infinity, hence convergent to its fixed carrier. -/
theorem brrsEvenQuadraticBaseNormalized_tendsto_carrier
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    Tendsto (brrsEvenQuadraticBaseNormalized h) atTop
      (nhds (brrsEvenQuadraticBaseCarrier h)) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_tail_bound h hh hvanish hderiv_zero
  have hcauchy : CauchySeq (brrsEvenQuadraticBaseNormalized h) := by
    refine (Metric.cauchySeq_iff').2 ?_
    intro eps heps
    let N : Real := C / eps + 1
    have hNone : 1 ≤ N := by
      dsimp [N]
      have hnonneg : 0 ≤ C / eps := div_nonneg hC.le (le_of_lt heps)
      linarith
    have hNpos : 0 < N := lt_of_lt_of_le zero_lt_one hNone
    have hquot : C / N < eps := by
      apply (div_lt_iff₀ hNpos).2
      dsimp [N]
      calc
        C = eps * (C / eps) := by field_simp [ne_of_gt heps]
        _ < eps * (C / eps + 1) :=
          mul_lt_mul_of_pos_left (by linarith) heps
    refine ⟨N, ?_⟩
    intro n hn
    simpa only [dist_eq_norm] using
      (lt_of_le_of_lt (htail hNone hn) hquot)
  simpa only [brrsEvenQuadraticBaseCarrier] using hcauchy.tendsto_limUnder

/-- Quantitative convergence of the normalized even endpoint moment to its
fixed carrier. -/
theorem exists_brrsEvenQuadraticBaseNormalized_carrier_decay
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hderiv_zero : deriv h 0 = 0) :
    ∃ C : Real, 0 < C ∧ ∀ lambda : Real, 1 ≤ lambda →
      norm (brrsEvenQuadraticBaseNormalized h lambda -
        brrsEvenQuadraticBaseCarrier h) ≤ C / lambda := by
  obtain ⟨C, hC, htail⟩ :=
    exists_brrsEvenQuadraticBaseNormalized_tail_bound h hh hvanish hderiv_zero
  refine ⟨C, hC, ?_⟩
  intro lambda hlambda
  have hlim := brrsEvenQuadraticBaseNormalized_tendsto_carrier
    h hh hvanish hderiv_zero
  have hnorm_tendsto : Tendsto
      (fun b : Real => norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h lambda)) atTop
      (nhds (norm (brrsEvenQuadraticBaseCarrier h -
        brrsEvenQuadraticBaseNormalized h lambda)) ) := by
    exact (hlim.sub (tendsto_const_nhds : Tendsto
      (fun _ : Real => brrsEvenQuadraticBaseNormalized h lambda) atTop
      (nhds (brrsEvenQuadraticBaseNormalized h lambda)))).norm
  have hevent : Filter.Eventually (fun b : Real =>
      norm (brrsEvenQuadraticBaseNormalized h b -
        brrsEvenQuadraticBaseNormalized h lambda) ≤ C / lambda) atTop := by
    filter_upwards [Filter.eventually_ge_atTop lambda] with b hb
    exact htail hlambda hb
  have hbound := le_of_tendsto hnorm_tendsto hevent
  simpa only [norm_sub_rev] using hbound

/-- Exact rescaling of an order-zero quadratic stationary moment.  This is the
change of variables `v = sqrt(lambda) * u` written without any limiting or
stationary-phase approximation.  In particular, the rescaled amplitude is
kept explicitly, which makes this identity safe to use for a nonconstant
endpoint profile. -/
theorem quadraticMomentIntegral_zero_eq_rescaledFresnel
    (h : Real -> Complex) {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (intervalIntegral
          (fun v => h (v / Real.sqrt lambda) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume) := by
  let c : Real := Real.sqrt lambda
  let G : Real -> Complex := fun v => h (v / c) *
    Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)
  have hc : Not (c = 0) := by
    dsimp [c]
    exact Real.sqrt_ne_zero'.mpr hlambda
  have hc_sq : c ^ 2 = lambda := by
    dsimp [c]
    exact Real.sq_sqrt hlambda.le
  have hcomp : (fun u : Real => G (c * u)) =
      (fun u => ((u ^ 0 : Real) : Complex) * h u *
        Complex.exp (((lambda * u ^ 2 : Real) : Complex) * Complex.I)) := by
    funext u
    dsimp [G]
    have hdiv : c * u / c = u := by
      field_simp
    rw [hdiv]
    have hsq : (c * u) ^ 2 = lambda * u ^ 2 := by
      rw [mul_pow, hc_sq]
    rw [hsq]
    norm_num
  calc
    quadraticMomentIntegral 0 h lambda =
        intervalIntegral (fun u => G (c * u)) 0 1 volume := by
      unfold quadraticMomentIntegral
      rw [hcomp]
    _ = SMul.smul (Inv.inv c)
        (intervalIntegral G (c * 0) (c * 1) volume) := by
      exact intervalIntegral.integral_comp_mul_left G hc
    _ = SMul.smul (Inv.inv c)
        (intervalIntegral G 0 c volume) := by
      norm_num
    _ = SMul.smul (Inv.inv (Real.sqrt lambda))
        (intervalIntegral
          (fun v => h (v / Real.sqrt lambda) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume) := by
      rfl

/-- Constant amplitudes rescale exactly to the normalized finite Fresnel
integral.  This is the literal bridge between the unit-scale lower bound and
the order-zero quadratic moment; no asymptotic statement is used here. -/
theorem quadraticMomentIntegral_zero_const_one_eq_sqrt_inv_smul_fresnel
    {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 (fun _ : Real => (1 : Complex)) lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) := by
  rw [quadraticMomentIntegral_zero_eq_rescaledFresnel
    (fun _ : Real => (1 : Complex)) hlambda]
  simp only [one_mul]
  rfl

/-- Exact constant-plus-error form of the order-zero rescaling.  The error
retains the variation of the amplitude on the `sqrt(lambda)` scale.  It is a
pure identity under continuity, deliberately without an unproved estimate of
that error. -/
theorem quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError
    (h : Real -> Complex) (hh : Continuous h)
    {lambda : Real} (hlambda : 0 < lambda) :
    quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv (Real.sqrt lambda))
        (h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
          intervalIntegral
            (fun v => (h (v / Real.sqrt lambda) - h 0) *
              Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
            0 (Real.sqrt lambda) volume) := by
  rw [quadraticMomentIntegral_zero_eq_rescaledFresnel h hlambda]
  congr 1
  let c : Real := Real.sqrt lambda
  let F : Real -> Complex := fun v =>
    Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)
  let G : Real -> Complex := fun v => h (v / c) * F v
  let E : Real -> Complex := fun v => (h (v / c) - h 0) * F v
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hhscale : Continuous (fun v : Real => h (v / c)) := by
    apply hh.comp
    fun_prop
  have hmain_int : IntervalIntegrable (fun v : Real => h 0 * F v) volume 0 c := by
    exact (hF.const_mul (h 0)).intervalIntegrable 0 c
  have hE_int : IntervalIntegrable E volume 0 c := by
    exact ((hhscale.sub continuous_const).mul hF).intervalIntegrable 0 c
  have hsplit : (fun v : Real => G v) =
      (fun v => h 0 * F v + E v) := by
    funext v
    dsimp [G, E]
    ring
  have hGsplit : G = (fun v => h 0 * F v + E v) := by
    funext v
    exact congrFun hsplit v
  change intervalIntegral (fun v => h (v / c) * F v) 0 c volume = _
  change intervalIntegral G 0 c volume = _
  rw [hGsplit, intervalIntegral.integral_add hmain_int hE_int,
    intervalIntegral.integral_const_mul]
  rfl

/-- After multiplying by the natural square-root stationary scale, the
order-zero endpoint moment is exactly its Fresnel core plus the rescaled
amplitude error.  This is private because it is solely the normalization
step for the even-endpoint carrier calculation. -/
private theorem brrsEvenQuadraticBaseNormalized_eq_fresnel_add_rescaledError
    (h : Real -> Complex) (hh : Continuous h)
    {lambda : Real} (hlambda : 0 < lambda) :
    brrsEvenQuadraticBaseNormalized h lambda =
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
        intervalIntegral
          (fun v => (h (v / Real.sqrt lambda) - h 0) *
            Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
          0 (Real.sqrt lambda) volume := by
  unfold brrsEvenQuadraticBaseNormalized
  rw [quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError h hh hlambda]
  change (Real.sqrt lambda : Complex) *
      ((Real.sqrt lambda)⁻¹ •
        (h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) +
          intervalIntegral
            (fun v => (h (v / Real.sqrt lambda) - h 0) *
              Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
            0 (Real.sqrt lambda) volume)) = _
  rw [Complex.real_smul]
  have hsqrt : Real.sqrt lambda ≠ 0 := Real.sqrt_ne_zero'.mpr hlambda
  push_cast
  field_simp [hsqrt]
  congr 1
  apply intervalIntegral.integral_congr
  intro v hv
  ring

/-- A coherent finite Fresnel carrier transfers any sufficiently small
rescaled endpoint error into a quantitative order-zero stationary lower
bound.  This is an entirely finite statement: the only carrier input is the
proved neighborhood estimate for the truncation at `64`. -/
theorem quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
    (h : Real → Complex) (hh : Continuous h) (hzero : h 0 ≠ 0)
    {lambda : Real} (hlambda : (4096 : Real) ≤ lambda)
    (herror : ‖intervalIntegral
      (fun v => (h (v / Real.sqrt lambda) - h 0) *
        Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
      0 (Real.sqrt lambda) volume‖ ≤ ‖h 0‖ / 128) :
    ‖h 0‖ / 128 / Real.sqrt lambda ≤
      ‖quadraticMomentIntegral 0 h lambda‖ := by
  have hlambda_pos : 0 < lambda := by linarith
  let c : Real := Real.sqrt lambda
  let F : Complex := brrsNormalizedQuadraticFresnelIntegral c
  let E : Complex := intervalIntegral
    (fun v => (h (v / c) - h 0) *
      Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
    0 c volume
  let a : Real := ‖h 0‖
  have ha : 0 < a := norm_pos_iff.mpr hzero
  have hcpos : 0 < c := by
    dsimp [c]
    exact Real.sqrt_pos.2 hlambda_pos
  have hcsq : c ^ 2 = lambda := by
    dsimp [c]
    exact Real.sq_sqrt hlambda_pos.le
  have hc_large : (64 : Real) ≤ c := by
    have hsq : (64 : Real) ^ 2 ≤ c ^ 2 := by
      calc
        (64 : Real) ^ 2 = 4096 := by norm_num
        _ ≤ lambda := hlambda
        _ = c ^ 2 := hcsq.symm
    nlinarith
  have hFclose : ‖F - brrsNormalizedQuadraticFresnelCarrier‖ ≤ (1 / 64 : Real) := by
    dsimp [F]
    exact brrsNormalizedQuadraticFresnelIntegral_eventually_close_to_carrier c hc_large
  have hE : ‖E‖ ≤ a / 128 := by
    dsimp [E, c, a]
    exact herror
  have hcarrier_scaled : a / 32 ≤ ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := by
    calc
      a / 32 = ‖h 0‖ * (1 / 32 : Real) := by
        dsimp [a]
        ring
      _ ≤ ‖h 0‖ * ‖brrsNormalizedQuadraticFresnelCarrier‖ :=
        mul_le_mul_of_nonneg_left brrsNormalizedQuadraticFresnelCarrier_norm_lower
          (norm_nonneg _)
      _ = ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := (norm_mul _ _).symm
  have hscaled_tail : ‖h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      a / 64 := by
    rw [show h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier =
      h 0 * (F - brrsNormalizedQuadraticFresnelCarrier) by ring, norm_mul]
    calc
      ‖h 0‖ * ‖F - brrsNormalizedQuadraticFresnelCarrier‖ ≤
          ‖h 0‖ * (1 / 64 : Real) :=
        mul_le_mul_of_nonneg_left hFclose (norm_nonneg _)
      _ = a / 64 := by
        dsimp [a]
        ring
  have hsecondary : ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      a / 64 + a / 128 := by
    calc
      ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ =
          ‖(h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier) + E‖ := by
        congr 1
        ring
      _ ≤ ‖h 0 * F - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ + ‖E‖ :=
        norm_add_le _ _
      _ ≤ a / 64 + a / 128 := add_le_add hscaled_tail hE
  have htriangle : ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ ≤
      ‖h 0 * F + E‖ +
        ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ := by
    calc
      ‖h 0 * brrsNormalizedQuadraticFresnelCarrier‖ =
          ‖(h 0 * F + E) -
            (h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier)‖ := by
        congr 1
        ring
      _ ≤ ‖h 0 * F + E‖ +
          ‖h 0 * F + E - h 0 * brrsNormalizedQuadraticFresnelCarrier‖ :=
        norm_sub_le _ _
  have hmain : a / 128 ≤ ‖h 0 * F + E‖ := by
    nlinarith [hcarrier_scaled, htriangle, hsecondary]
  have hformula : quadraticMomentIntegral 0 h lambda =
      SMul.smul (Inv.inv c) (h 0 * F + E) := by
    dsimp [c, F, E]
    exact quadraticMomentIntegral_zero_eq_fresnel_add_rescaledError h hh hlambda_pos
  rw [hformula]
  change a / 128 / c ≤ ‖(c⁻¹ : Real) • (h 0 * F + E)‖
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hcpos)]
  calc
    a / 128 / c = c⁻¹ * (a / 128) := by
      field_simp [ne_of_gt hcpos]
    _ ≤ c⁻¹ * ‖h 0 * F + E‖ :=
      mul_le_mul_of_nonneg_left hmain (inv_nonneg.mpr hcpos.le)

/-- The fixed coherent Fresnel carrier already gives a completely explicit
order-zero lower bound for the constant smooth amplitude.  This is an
analytic endpoint statement only; it makes no assertion about the full
spherical kernel. -/
theorem quadraticMomentIntegral_zero_const_one_eventually_lower
    {lambda : Real} (hlambda : (4096 : Real) ≤ lambda) :
    (1 / 128 : Real) / Real.sqrt lambda ≤
      ‖quadraticMomentIntegral 0 (fun _ : Real => (1 : Complex)) lambda‖ := by
  simpa using
    (quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
      (fun _ : Real => (1 : Complex)) continuous_const (by norm_num) hlambda
      (by simp))

/-- A one-step integration-by-parts identity for a quadratic phase away from
its stationary point.  The hypotheses deliberately retain the actual
derivative and its continuity on the interval, so the lemma can be reused for
cutoffs and for rescaled endpoint amplitudes without appealing to an
unjustified asymptotic expansion. -/
theorem brrs_quadratic_phase_weighted_integration_by_parts
    {a b lambda : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : lambda ≠ 0)
    (g g' : Real → Complex)
    (hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a b)) :
    (∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) =
      g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I) := by
  let E : Real → Complex := fun t =>
    Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)
  let Q : Real → Complex := fun t =>
    (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹
  let Q' : Real → Complex := fun t =>
    -(((2 * lambda : Real) : Complex) * Complex.I) /
      ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hbase_ne : ∀ x ∈ Set.uIcc a b,
      ((2 * lambda * x : Real) : Complex) * Complex.I ≠ 0 := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx)
    have hlx : (2 * lambda * x : Real) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) hlambda) hx0
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hlx) Complex.I_ne_zero
  have hQ : ∀ x ∈ Set.uIcc a b, HasDerivAt Q (Q' x) x := by
    intro x hx
    dsimp [Q, Q']
    have hbase : HasDerivAt
        (fun y : Real => ((2 * lambda * y : Real) : Complex) * Complex.I)
        (((2 * lambda : Real) : Complex) * Complex.I) x := by
      have hreal : HasDerivAt (fun y : Real => 2 * lambda * y) (2 * lambda) x := by
        simpa [mul_assoc] using (hasDerivAt_id x).const_mul (2 * lambda)
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    exact hbase.inv (hbase_ne x hx)
  have hE : ∀ x ∈ Set.uIcc a b,
      HasDerivAt E (E x * (((2 * lambda * x : Real) : Complex) * Complex.I)) x := by
    intro x hx
    dsimp [E]
    have hpoly : HasDerivAt
        (fun y : Real => ((lambda * y ^ 2 : Real) : Complex) * Complex.I)
        (((2 * lambda * x : Real) : Complex) * Complex.I) x := by
      have hreal : HasDerivAt (fun y : Real => lambda * y ^ 2) (2 * lambda * x) x := by
        simpa [mul_assoc, mul_left_comm, mul_comm] using
          (hasDerivAt_pow 2 x).const_mul lambda
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    simpa [mul_assoc] using hpoly.cexp
  have hQE : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun t => Q t * E t) (Q' x * E x + E x) x := by
    intro x hx
    have h := (hQ x hx).mul (hE x hx)
    convert h using 1 <;> try rfl
    have hne := hbase_ne x hx
    have hcancel : Q x *
        (E x * (((2 * lambda * x : Real) : Complex) * Complex.I)) = E x := by
      dsimp [Q]
      have hscalar : ((2 * lambda * x : Real) : Complex) ≠ 0 := by
        apply Complex.ofReal_ne_zero.mpr
        exact mul_ne_zero (mul_ne_zero (by norm_num) hlambda) (ne_of_gt (hpos x hx))
      field_simp [hne, hscalar]
    rw [hcancel]
  have hQcont : ContinuousOn Q (Set.uIcc a b) := by
    dsimp [Q]
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn Q' (Set.uIcc a b) := by
    dsimp [Q']
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn E (Set.uIcc a b) := by
    dsimp [E]
    fun_prop
  have hgcont : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := g) (u' := g') (v := fun t => Q t * E t)
    (v' := fun t => Q' t * E t + E t)
    hg hQE hg'cont.intervalIntegrable
    (hQ'cont.mul hEcont |>.add hEcont).intervalIntegrable
  have hsplit :
      (∫ t in a..b, g t * (Q' t * E t + E t)) =
        (∫ t in a..b, g t * Q' t * E t) +
          ∫ t in a..b, g t * E t := by
    have hfun : (fun t => g t * (Q' t * E t + E t)) =
        fun t => g t * Q' t * E t + g t * E t := by
      funext t
      ring
    rw [hfun, intervalIntegral.integral_add]
    · exact ((hgcont.mul hQ'cont).mul hEcont).intervalIntegrable
    · exact (hgcont.mul hEcont).intervalIntegrable
  rw [hsplit] at hparts
  change (∫ t in a..b, g t * E t) = _
  calc
    (∫ t in a..b, g t * E t) =
        ((∫ t in a..b, g t * Q' t * E t) +
          ∫ t in a..b, g t * E t) -
          ∫ t in a..b, g t * Q' t * E t := by ring
    _ = (g b * (Q b * E b) - g a * (Q a * E a) -
        ∫ t in a..b, g' t * (Q t * E t)) -
          ∫ t in a..b, g t * Q' t * E t := by rw [hparts]
    _ = g b * (Q b * E b) - g a * (Q a * E a) -
        (∫ t in a..b, g' t * Q t * E t) -
        ∫ t in a..b, g t * Q' t * E t := by
      have hgv : (∫ t in a..b, g' t * (Q t * E t)) =
          ∫ t in a..b, g' t * Q t * E t := by
        apply intervalIntegral.integral_congr
        intro t ht
        ring
      rw [hgv]
    _ = _ := by
      dsimp [Q, Q', E]
      ring

/-- A uniform nonstationary tail estimate for the Abel-damped unit Fresnel
phase.  It is the tail estimate needed to pass from the absolutely
convergent Gaussian integral to the improper oscillatory Fresnel integral.
The bound is deliberately independent of the damping parameter. -/
theorem brrs_dampedQuadraticFresnel_tail_norm_le
    {a b eps : Real} (ha : 0 < a) (hab : a ≤ b) (heps : 0 ≤ eps) :
    ‖∫ t in a..b,
      (Real.exp (-eps * t ^ 2) : Complex) *
        Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 3 / a := by
  let g : Real → Complex := fun t => (Real.exp (-eps * t ^ 2) : Complex)
  let g' : Real → Complex := fun t =>
    (-(2 * eps * t) * Real.exp (-eps * t ^ 2) : Real)
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x := by
    intro x hx
    have hpoly : HasDerivAt (fun t : Real => -eps * t ^ 2)
        (-(2 * eps * x)) x := by
      simpa [mul_assoc, mul_left_comm, mul_comm] using
        (hasDerivAt_pow 2 x).const_mul (-eps)
    have hexp := hpoly.exp
    dsimp [g, g']
    convert hexp.ofReal_comp using 1 <;> push_cast <;> ring
  have hg'cont : ContinuousOn g' (Set.uIcc a b) := by
    dsimp [g']
    fun_prop
  have hid := brrs_quadratic_phase_weighted_integration_by_parts
    ha hab (by norm_num : (1 : Real) ≠ 0) g g' hg hg'cont
  have hexp_nonneg (x : Real) : 0 ≤ Real.exp (-eps * x ^ 2) :=
    (Real.exp_pos _).le
  have hexp_le_one (x : Real) : Real.exp (-eps * x ^ 2) ≤ 1 := by
    exact Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr heps) (sq_nonneg x))
  have hgnorm (x : Real) : ‖g x‖ = Real.exp (-eps * x ^ 2) := by
    dsimp [g]
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg (hexp_nonneg x)]
  have hQcont : ContinuousOn
      (fun t : Real => (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹)
      (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    apply mul_ne_zero
    · exact Complex.ofReal_ne_zero.mpr
        (mul_ne_zero (mul_ne_zero (by norm_num) (by norm_num))
          (ne_of_gt (hpos x hx)))
    · exact Complex.I_ne_zero
  have hQ'cont : ContinuousOn (fun t : Real =>
      -(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
        ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2))
      (Set.uIcc a b) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (mul_ne_zero
      (Complex.ofReal_ne_zero.mpr
        (mul_ne_zero (mul_ne_zero (by norm_num) (by norm_num))
          (ne_of_gt (hpos x hx)))) Complex.I_ne_zero)
  have hEcont : ContinuousOn
      (fun t : Real => Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))
      (Set.uIcc a b) := by
    fun_prop
  have hendpoint (x : Real) (hx : 0 < x) :
      ‖g x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 1 / (2 * x) := by
    rw [norm_mul, norm_mul, hgnorm, norm_inv, norm_mul, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos (by positivity : 0 < 2 * (1 : Real) * x),
      Complex.norm_I, Complex.norm_exp_ofReal_mul_I]
    norm_num
    have harg : -(eps * x ^ 2) = -eps * x ^ 2 := by ring
    rw [harg]
    calc
      Real.exp (-eps * x ^ 2) * (x⁻¹ * (1 / 2)) ≤
          1 * (x⁻¹ * (1 / 2)) :=
        mul_le_mul_of_nonneg_right (hexp_le_one x)
          (mul_nonneg (inv_nonneg.mpr hx.le) (by norm_num))
      _ = x⁻¹ * (1 / 2) := one_mul _
  have hsmall (x : Real) (hx : 0 < x) :
      eps * Real.exp (-eps * x ^ 2) ≤ (x ^ 2)⁻¹ := by
    have hcore : eps * x ^ 2 * Real.exp (-eps * x ^ 2) ≤ 1 := by
      have hraw : eps * x ^ 2 * Real.exp (-(eps * x ^ 2)) ≤ 1 :=
        (Real.mul_exp_neg_le_exp_neg_one (eps * x ^ 2)).trans
          (Real.exp_le_one_iff.mpr (by norm_num))
      have harg : -(eps * x ^ 2) = -eps * x ^ 2 := by ring
      rwa [harg] at hraw
    have hx2 : 0 < x ^ 2 := sq_pos_of_pos hx
    calc
      eps * Real.exp (-eps * x ^ 2) =
          (eps * x ^ 2 * Real.exp (-eps * x ^ 2)) * (x ^ 2)⁻¹ := by
            field_simp [ne_of_gt hx2]
      _ ≤ 1 * (x ^ 2)⁻¹ :=
        mul_le_mul_of_nonneg_right hcore (inv_nonneg.mpr hx2.le)
      _ = (x ^ 2)⁻¹ := one_mul _
  have hderiv_point : ∀ x ∈ Set.Icc a b,
      ‖g' x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ (x ^ 2)⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hxpos := hpos x hx'
    have hnorm :
        ‖g' x * (((2 * (1 : Real) * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ =
          eps * Real.exp (-eps * x ^ 2) := by
      dsimp [g']
      simp only [norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_inv,
        Complex.norm_I, Complex.norm_exp_ofReal_mul_I]
      rw [abs_neg,
        abs_of_nonneg (mul_nonneg (mul_nonneg (by norm_num) heps) hxpos.le),
        abs_of_nonneg (hexp_nonneg x), abs_of_pos hxpos]
      norm_num
      field_simp [ne_of_gt hxpos]
    rw [hnorm]
    exact hsmall x hxpos
  have hrem_point : ∀ x ∈ Set.Icc a b,
      ‖g x *
          (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
            ((((2 * (1 : Real) * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ ≤ (x ^ 2)⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hxpos := hpos x hx'
    have hnorm :
        ‖g x *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * x : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)‖ =
          Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) := by
      simp only [norm_mul, hgnorm, norm_div, norm_neg, Complex.norm_real,
        Real.norm_eq_abs, Complex.norm_I, norm_pow, Complex.norm_exp_ofReal_mul_I]
      rw [abs_of_pos (by norm_num), abs_of_pos hxpos]
      norm_num
      field_simp [ne_of_gt hxpos]
    rw [hnorm]
    calc
      Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) ≤
          1 * (1 * (x ^ 2)⁻¹) := by
        calc
          Real.exp (-eps * x ^ 2) * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) ≤
              1 * ((2 : Real)⁻¹ * (x ^ 2)⁻¹) :=
            mul_le_mul_of_nonneg_right (hexp_le_one x)
              (mul_nonneg (inv_nonneg.mpr (by norm_num))
                (inv_nonneg.mpr (sq_nonneg x)))
          _ ≤ 1 * (1 * (x ^ 2)⁻¹) := by
            gcongr
            exact inv_le_one_of_one_le₀ (by norm_num)
      _ = (x ^ 2)⁻¹ := by norm_num
  have hinvsq_cont : ContinuousOn (fun t : Real => (t ^ 2)⁻¹) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hinvsq_int : IntervalIntegrable (fun t : Real => (t ^ 2)⁻¹) volume a b :=
    hinvsq_cont.intervalIntegrable
  have hderiv_int : IntervalIntegrable (fun t : Real =>
      ‖g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
        Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) volume a b :=
    ((hg'cont.mul hQcont).mul hEcont).norm.intervalIntegrable
  have hrem_int : IntervalIntegrable (fun t : Real =>
      ‖g t *
          (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
            ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) volume a b :=
    (((show ContinuousOn g (Set.uIcc a b) from fun x hx =>
      (hg x hx).continuousAt.continuousWithinAt).mul hQ'cont).mul hEcont).norm.intervalIntegrable
  have hderiv_bound :
      ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        a⁻¹ - b⁻¹ := by
    calc
      ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (t ^ 2)⁻¹ :=
        intervalIntegral.integral_mono_on hab hderiv_int hinvsq_int hderiv_point
      _ = a⁻¹ - b⁻¹ := brrs_intervalIntegral_inv_sq ha hab
  have hrem_bound :
      ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        a⁻¹ - b⁻¹ := by
    calc
      ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g t *
              (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (t ^ 2)⁻¹ :=
        intervalIntegral.integral_mono_on hab hrem_int hinvsq_int hrem_point
      _ = a⁻¹ - b⁻¹ := brrs_intervalIntegral_inv_sq ha hab
  have hbpos : 0 < b := lt_of_lt_of_le ha hab
  have hinv_ba : 1 / (2 * b) ≤ 1 / (2 * a) := by
    exact one_div_le_one_div_of_le (by positivity)
      (mul_le_mul_of_nonneg_left hab (by norm_num))
  change ‖∫ t in a..b,
      g t * Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤ 3 / a
  simp only [one_mul] at hid
  rw [hid]
  calc
    ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g t *
            (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
              ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
      calc
        _ ≤ ‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I) -
          (∫ t in a..b,
            g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))‖ +
          ‖∫ t in a..b,
            g t *
              (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := norm_sub_le _ _
        _ ≤ (‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I)‖ +
            ‖g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
            ‖∫ t in a..b,
              g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) +
            ‖∫ t in a..b,
              g t *
                (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                  ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
          calc
            _ ≤ (‖g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                  Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
                g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                  Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I)‖ +
                ‖∫ t in a..b,
                  g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖) +
                ‖∫ t in a..b,
                  g t *
                    (-(((2 * (1 : Real) : Real) : Complex) * Complex.I) /
                      ((((2 * (1 : Real) * t : Real) : Complex) * Complex.I) ^ 2)) *
                    Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I)‖ := by
              exact add_le_add_left
                (norm_sub_le
                  (g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I) -
                    g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                      Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I))
                  (∫ t in a..b,
                    g' t * (((2 * (1 : Real) * t : Real) : Complex) * Complex.I)⁻¹ *
                      Complex.exp (((t ^ 2 : Real) : Complex) * Complex.I))) _
            _ ≤ _ := by
              exact add_le_add_left (add_le_add_left
                (norm_sub_le
                  (g b * (((2 * (1 : Real) * b : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((b ^ 2 : Real) : Complex) * Complex.I))
                  (g a * (((2 * (1 : Real) * a : Real) : Complex) * Complex.I)⁻¹ *
                    Complex.exp (((a ^ 2 : Real) : Complex) * Complex.I))) _) _
        _ = _ := by ring
    _ ≤ 1 / (2 * b) + 1 / (2 * a) + (a⁻¹ - b⁻¹) + (a⁻¹ - b⁻¹) := by
      nlinarith [hendpoint b hbpos, hendpoint a ha, hderiv_bound, hrem_bound]
    _ ≤ 3 / a := by
      have hbinv_nonneg : 0 ≤ b⁻¹ := inv_nonneg.mpr hbpos.le
      have hainv_nonneg : 0 ≤ a⁻¹ := inv_nonneg.mpr ha.le
      calc
        1 / (2 * b) + 1 / (2 * a) + (a⁻¹ - b⁻¹) + (a⁻¹ - b⁻¹) ≤
            1 / (2 * a) + 1 / (2 * a) + a⁻¹ + a⁻¹ := by
          nlinarith [hinv_ba]
        _ = 3 / a := by field_simp [ne_of_gt ha] <;> ring

/-- Algebraic separation of Abel damping from the unit Fresnel phase. -/
private theorem brrs_abelDampedFresnel_integrand_eq (eps x : Real) :
    Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) =
      (Real.exp (-eps * x ^ 2) : Complex) *
        Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
  have harg : -(((eps : Complex) - Complex.I) * (x : Complex) ^ 2) =
      ((-eps * x ^ 2 : Real) : Complex) +
        ((x ^ 2 : Real) : Complex) * Complex.I := by
    push_cast
    ring
  rw [harg, Complex.exp_add, ← Complex.ofReal_exp]

/-- On every fixed finite interval, Abel damping converges to the undamped
quadratic phase by dominated convergence.  This is kept private because it is
only the local step in the evaluation of the improper Fresnel carrier. -/
private theorem brrs_dampedQuadraticFresnel_finite_tendsto (A : Real) :
    Tendsto (fun eps : Real =>
      ∫ x in (0 : Real)..A,
        Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (intervalIntegral (fun x : Real =>
        Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I)) 0 A volume)) := by
  refine intervalIntegral.tendsto_integral_filter_of_dominated_convergence
    (μ := volume) (a := (0 : Real)) (b := A)
    (l := nhdsWithin 0 (Set.Ioi 0))
    (F := fun (eps : Real) (x : Real) =>
      Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2)))
    (f := fun (x : Real) =>
      Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I))
    (bound := fun _ : Real => (1 : Real)) ?_ ?_ ?_ ?_
  · filter_upwards [self_mem_nhdsWithin] with eps heps
    fun_prop
  · filter_upwards [self_mem_nhdsWithin] with eps heps
    filter_upwards with x hx
    have harg : -(((eps : Complex) - Complex.I) * (x : Complex) ^ 2) =
        -((eps : Complex) - Complex.I) * (x : Complex) ^ 2 := by
      ring
    rw [harg]
    rw [norm_cexp_neg_mul_sq]
    simp only [Complex.sub_re, Complex.ofReal_re, Complex.I_re, sub_zero]
    exact Real.exp_le_one_iff.mpr
      (mul_nonpos_of_nonpos_of_nonneg (neg_nonpos.mpr heps.le) (sq_nonneg x))
  · exact (continuous_const : Continuous (fun _ : Real => (1 : Real))).intervalIntegrable 0 A
  · filter_upwards with x hx
    have hcont : ContinuousAt (fun eps : Real =>
        Complex.exp (-(((eps : Complex) - Complex.I) * (x : Complex) ^ 2))) 0 := by
      fun_prop
    have hzero :
        Complex.exp (-((((0 : Real) : Complex) - Complex.I) * (x : Complex) ^ 2)) =
          Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
      congr 1
      push_cast
      ring
    have hleft : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0 :=
      nhdsWithin_le_nhds
    have ht := hcont.tendsto.mono_left hleft
    rw [hzero] at ht
    exact ht

/-- Uniform passage from a finite Abel-damped Fresnel truncation to its
absolutely convergent half-line integral. -/
private theorem brrs_abelDampedFresnel_improper_tail_norm_le
    {eps A : Real} (heps : 0 < eps) (hA : 0 < A) :
    ‖(∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
      ∫ x in (0 : Real)..A,
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ ≤
      3 / A := by
  let F : Real → Complex := fun x =>
    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)
  change ‖(∫ x in Set.Ioi (0 : Real), F x) - ∫ x in (0 : Real)..A, F x‖ ≤ 3 / A
  have hFint : Integrable F := by
    dsimp [F]
    exact integrable_cexp_neg_mul_sq (by
      simp only [Complex.sub_re, Complex.ofReal_re, Complex.I_re, sub_zero]
      exact heps)
  have hFcont : Continuous F := by
    dsimp [F]
    fun_prop
  have hlim : Tendsto (fun R : Real => ∫ x in (0 : Real)..R, F x) atTop
      (nhds (∫ x in Set.Ioi (0 : Real), F x)) :=
    intervalIntegral_tendsto_integral_Ioi 0 hFint.integrableOn tendsto_id
  have hbase := hlim.sub (tendsto_const_nhds : Tendsto
    (fun _ : Real => ∫ x in (0 : Real)..A, F x) atTop
    (nhds (∫ x in (0 : Real)..A, F x)))
  have hdiff : Tendsto (fun R : Real => ∫ x in A..R, F x) atTop
      (nhds ((∫ x in Set.Ioi (0 : Real), F x) - ∫ x in (0 : Real)..A, F x)) := by
    refine hbase.congr' ?_
    filter_upwards with R
    change (∫ x in (0 : Real)..R, F x) - ∫ x in (0 : Real)..A, F x =
      ∫ x in A..R, F x
    rw [← intervalIntegral.integral_add_adjacent_intervals
      (hFcont.intervalIntegrable 0 A) (hFcont.intervalIntegrable A R)]
    abel
  have hsplit (R : Real) :
      (∫ x in A..R, F x) =
        ∫ x in A..R,
          (Real.exp (-eps * x ^ 2) : Complex) *
            Complex.exp (((x ^ 2 : Real) : Complex) * Complex.I) := by
    apply intervalIntegral.integral_congr
    intro x hx
    dsimp [F]
    convert brrs_abelDampedFresnel_integrand_eq eps x using 1 <;> ring
  have hevent : ∀ᶠ R : Real in atTop,
      ‖∫ x in A..R, F x‖ ≤ 3 / A := by
    filter_upwards [eventually_ge_atTop A] with R hR
    rw [hsplit R]
    exact brrs_dampedQuadraticFresnel_tail_norm_le hA hR heps.le
  exact le_of_tendsto hdiff.norm hevent

/-- The finite undamped Fresnel truncation remains within its elementary
`A⁻¹` nonstationary tail of the improper carrier. -/
private theorem brrsNormalizedQuadraticFresnelIntegral_distance_to_limit_le
    {A : Real} (hA : 0 < A) :
    ‖brrsNormalizedQuadraticFresnelIntegral A - brrsQuadraticFresnelLimit‖ ≤ A⁻¹ := by
  have hbase := brrsNormalizedQuadraticFresnelIntegral_tendsto_limit.sub
    (tendsto_const_nhds : Tendsto
      (fun _ : Real => brrsNormalizedQuadraticFresnelIntegral A) atTop
      (nhds (brrsNormalizedQuadraticFresnelIntegral A)))
  have hevent : ∀ᶠ R : Real in atTop,
      ‖brrsNormalizedQuadraticFresnelIntegral R -
          brrsNormalizedQuadraticFresnelIntegral A‖ ≤ A⁻¹ := by
    filter_upwards [eventually_ge_atTop A] with R hR
    exact brrsNormalizedQuadraticFresnelIntegral_tail_distance_le hA hR
  have hle : ‖brrsQuadraticFresnelLimit -
      brrsNormalizedQuadraticFresnelIntegral A‖ ≤ A⁻¹ :=
    le_of_tendsto hbase.norm hevent
  rw [norm_sub_rev] at hle
  exact hle

/-- Abel damping converges to the improper normalized quadratic Fresnel
carrier.  The proof uses dominated convergence on each finite interval and a
uniform nonstationary tail, so no unproved oscillatory-integral identity is
being assumed. -/
theorem brrs_abelDampedFresnelIntegral_tendsto_limit :
    Tendsto (fun eps : Real =>
      ∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds brrsQuadraticFresnelLimit) := by
  refine Metric.tendsto_nhds.mpr ?_
  intro eta heta
  let A : Real := 16 / eta
  have hA : 0 < A := by
    dsimp [A]
    positivity
  have hAinv : A⁻¹ = eta / 16 := by
    dsimp [A]
    field_simp [ne_of_gt heta]
  have hthreeA : 3 / A = 3 * eta / 16 := by
    rw [div_eq_mul_inv, hAinv]
    ring
  have htail0 : ‖brrsNormalizedQuadraticFresnelIntegral A -
      brrsQuadraticFresnelLimit‖ ≤ A⁻¹ :=
    brrsNormalizedQuadraticFresnelIntegral_distance_to_limit_le hA
  have hmid : ∀ᶠ eps : Real in nhdsWithin 0 (Set.Ioi 0),
      ‖(∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
          brrsNormalizedQuadraticFresnelIntegral A‖ < eta / 2 := by
    have hfinite : Tendsto (fun eps : Real =>
        ∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2))
        (nhdsWithin 0 (Set.Ioi 0))
        (nhds (brrsNormalizedQuadraticFresnelIntegral A)) := by
      refine (brrs_dampedQuadraticFresnel_finite_tendsto A).congr' ?_
      filter_upwards with eps
      apply intervalIntegral.integral_congr
      intro x hx
      congr 1
      ring
    simpa only [brrsNormalizedQuadraticFresnelIntegral, dist_eq_norm] using
      (Metric.tendsto_nhds.mp hfinite
        (eta / 2) (by positivity))
  filter_upwards [hmid, self_mem_nhdsWithin] with eps hmid_eps heps
  rw [dist_eq_norm]
  have htail_eps :
      ‖(∫ x in Set.Ioi (0 : Real),
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
        ∫ x in (0 : Real)..A,
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ ≤ 3 / A :=
    brrs_abelDampedFresnel_improper_tail_norm_le heps hA
  calc
    ‖(∫ x in Set.Ioi (0 : Real),
        Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
        brrsQuadraticFresnelLimit‖ ≤
        ‖(∫ x in Set.Ioi (0 : Real),
          Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
            ∫ x in (0 : Real)..A,
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ +
          ‖(∫ x in (0 : Real)..A,
            Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
              brrsNormalizedQuadraticFresnelIntegral A‖ +
          ‖brrsNormalizedQuadraticFresnelIntegral A -
              brrsQuadraticFresnelLimit‖ := by
      calc
        _ = ‖((∫ x in Set.Ioi (0 : Real),
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
              ∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) +
            (((∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                brrsNormalizedQuadraticFresnelIntegral A) +
              (brrsNormalizedQuadraticFresnelIntegral A -
                brrsQuadraticFresnelLimit))‖ := by
            congr 1
            ring
        _ ≤ _ := by
          calc
            _ ≤ ‖(∫ x in Set.Ioi (0 : Real),
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                ∫ x in (0 : Real)..A,
                  Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖ +
                ‖((∫ x in (0 : Real)..A,
                    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                    brrsNormalizedQuadraticFresnelIntegral A) +
                  (brrsNormalizedQuadraticFresnelIntegral A -
                    brrsQuadraticFresnelLimit)‖ := norm_add_le _ _
            _ ≤ _ := by
              simpa only [add_assoc] using
                (add_le_add_right
                  (norm_add_le
                    ((∫ x in (0 : Real)..A,
                      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                      brrsNormalizedQuadraticFresnelIntegral A)
                    (brrsNormalizedQuadraticFresnelIntegral A -
                      brrsQuadraticFresnelLimit))
                  ‖(∫ x in Set.Ioi (0 : Real),
                    Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                    ∫ x in (0 : Real)..A,
                      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)‖)
    _ < 3 / A + eta / 2 + A⁻¹ := by
      calc
        _ ≤ 3 / A +
            ‖(∫ x in (0 : Real)..A,
              Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                brrsNormalizedQuadraticFresnelIntegral A‖ + A⁻¹ := by
          gcongr
        _ < _ := by
          have hleft : 3 / A +
              ‖(∫ x in (0 : Real)..A,
                Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) -
                  brrsNormalizedQuadraticFresnelIntegral A‖ <
              3 / A + eta / 2 :=
            add_lt_add_right hmid_eps (3 / A)
          simpa only [add_assoc] using add_lt_add_left hleft A⁻¹
    _ < eta := by
      rw [hthreeA, hAinv]
      nlinarith

/-- The Abel-regularized quadratic carrier is an ordinary complex Gaussian
integral.  This is the exact special-function bridge used to identify the
even stationary-endpoint constant; it does not introduce a separate Bessel
normalization. -/
theorem brrs_abelDampedFresnelIntegral_eq_gaussian
    {eps : Real} (heps : 0 < eps) :
    (∫ x in Set.Ioi (0 : Real),
      Complex.exp (-((eps : Complex) - Complex.I) * (x : Complex) ^ 2)) =
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2 := by
  simpa using
    (integral_gaussian_complex_Ioi (b := (eps : Complex) - Complex.I) (by simpa using heps))

/-- Rewriting the Abel regularization by the complex Gaussian formula gives a
closed-form limiting description of the normalized Fresnel carrier. -/
theorem brrs_gaussianAbelFresnel_tendsto_limit :
    Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2)
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds brrsQuadraticFresnelLimit) := by
  refine brrs_abelDampedFresnelIntegral_tendsto_limit.congr' ?_
  filter_upwards [self_mem_nhdsWithin] with eps heps
  exact brrs_abelDampedFresnelIntegral_eq_gaussian heps

/-- Exact boundary value of the normalized quadratic Fresnel carrier, before
choosing a trigonometric presentation of its square-root phase. -/
theorem brrsQuadraticFresnelLimit_eq_gaussianBoundary :
    brrsQuadraticFresnelLimit =
      ((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex) / 2 := by
  have hden : Tendsto (fun eps : Real => (eps : Complex) - Complex.I)
      (nhdsWithin 0 (Set.Ioi 0)) (nhds (-Complex.I)) := by
    have hcont : ContinuousAt (fun eps : Real => (eps : Complex) - Complex.I) 0 := by
      fun_prop
    simpa using hcont.tendsto.mono_left
      (nhdsWithin_le_nhds : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0)
  have hratio : Tendsto (fun eps : Real =>
      (Real.pi : Complex) / ((eps : Complex) - Complex.I))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds ((Real.pi : Complex) / (-Complex.I))) := by
    have hcont : ContinuousAt (fun eps : Real =>
        (Real.pi : Complex) / ((eps : Complex) - Complex.I)) 0 := by
      exact continuousAt_const.div
        (Complex.continuous_ofReal.continuousAt.sub continuousAt_const) (by simp)
    simpa using hcont.tendsto.mono_left
      (nhdsWithin_le_nhds : nhdsWithin (0 : Real) (Set.Ioi 0) ≤ nhds 0)
  have hslit : (Real.pi : Complex) / (-Complex.I) ∈ Complex.slitPlane := by
    rw [Complex.mem_slitPlane_iff]
    right
    simp [div_eq_mul_inv, Real.pi_ne_zero]
  have hpow : Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex))
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex))) :=
    (continuousAt_cpow_const hslit).tendsto.comp hratio
  have hclosed : Tendsto (fun eps : Real =>
      ((Real.pi : Complex) / ((eps : Complex) - Complex.I)) ^ (1 / 2 : Complex) / 2)
      (nhdsWithin 0 (Set.Ioi 0))
      (nhds (((Real.pi : Complex) / (-Complex.I)) ^ (1 / 2 : Complex) / 2)) := by
    simpa only [Pi.div_apply] using hpow.div_const (2 : Complex)
  exact tendsto_nhds_unique brrs_gaussianAbelFresnel_tendsto_limit hclosed

/-- The normalized Fresnel carrier has the standard positive-phase value.
The formula records both real and imaginary leading components and is the
constant needed by the even stationary-endpoint expansion. -/
theorem brrsQuadraticFresnelLimit_eq_explicit :
    brrsQuadraticFresnelLimit =
      ((Real.sqrt (Real.pi / 2) : Complex) * (1 + Complex.I)) / 2 := by
  rw [brrsQuadraticFresnelLimit_eq_gaussianBoundary]
  have hratio : (Real.pi : Complex) / (-Complex.I) = (Real.pi : Complex) * Complex.I := by
    field_simp
    simp
  rw [hratio]
  have hhalf : (1 / 2 : Complex) = (2⁻¹ : Complex) := by rw [one_div]
  rw [hhalf]
  change Complex.sqrt ((Real.pi : Complex) * Complex.I) / 2 = _
  rw [Complex.sqrt_eq_real_add_ite]
  simp [Real.pi_pos.le]
  rw [abs_of_pos Real.pi_pos]
  ring

/-- A refined quadratic nonstationary-tail bound.  Besides a derivative bound,
the amplitude is assumed to vanish to first order at the stationary endpoint
in the explicit form `‖g x‖ ≤ N * x`.  The resulting logarithm is exactly the
integral of `x⁻¹`; after the substitution `v = sqrt(lambda) * x` it gives a
vanishing `log(lambda) / sqrt(lambda)` error, rather than a merely bounded
one. -/
theorem brrs_quadratic_phase_weighted_tail_norm_le_of_cone
    {a b lambda N : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : 0 < lambda)
    (g g' : Real → Complex)
    (hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a b))
    (hg_cone : ∀ x ∈ Set.Icc a b, ‖g x‖ ≤ N * x)
    (hg'_bound : ∀ x ∈ Set.uIcc a b, ‖g' x‖ ≤ N) :
    ‖∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (N / lambda) * (1 + Real.log (b / a)) := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hbpos : 0 < b := lt_of_lt_of_le ha hab
  have htwolambda : 0 < 2 * lambda := by positivity
  have htwoa : 0 < 2 * lambda * a := by positivity
  have htwob : 0 < 2 * lambda * b := by positivity
  have hbase_ne : ∀ x ∈ Set.uIcc a b,
      ((2 * lambda * x : Real) : Complex) * Complex.I ≠ 0 := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx)
    have hlx : (2 * lambda * x : Real) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) hlambda.ne') hx0
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hlx) Complex.I_ne_zero
  have hQnorm : ∀ x ∈ Set.uIcc a b,
      ‖(((2 * lambda * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ =
        (2 * lambda * x)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_inv, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
  have hQ'norm : ∀ x ∈ Set.uIcc a b,
      ‖(-(((2 * lambda : Real) : Complex) * Complex.I) /
          ((((2 * lambda * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ =
        (2 * lambda)⁻¹ * (x ^ 2)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_div, norm_neg, norm_mul, norm_pow, norm_mul,
      Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_pos (mul_pos (by norm_num) hlambda),
      abs_of_pos (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
    field_simp
  have hgcont : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hQcont : ContinuousOn
      (fun t : Real => (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹)
      (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn (fun t : Real =>
      -(((2 * lambda : Real) : Complex) * Complex.I) /
        ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2))
      (Set.uIcc a b) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn
      (fun t : Real => Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I))
      (Set.uIcc a b) := by
    fun_prop
  have hendpoint_a :
      ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N / (2 * lambda) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm a Set.left_mem_uIcc]
    calc
      ‖g a‖ * (2 * lambda * a)⁻¹ ≤
          (N * a) * (2 * lambda * a)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg_cone a ⟨le_rfl, hab⟩)
          (inv_nonneg.mpr htwoa.le)
      _ = N / (2 * lambda) := by
        field_simp [ne_of_gt htwolambda, ne_of_gt ha]
  have hendpoint_b :
      ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N / (2 * lambda) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm b Set.right_mem_uIcc]
    calc
      ‖g b‖ * (2 * lambda * b)⁻¹ ≤
          (N * b) * (2 * lambda * b)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg_cone b ⟨hab, le_rfl⟩)
          (inv_nonneg.mpr htwob.le)
      _ = N / (2 * lambda) := by
        field_simp [ne_of_gt htwolambda, ne_of_gt hbpos]
  have hg'point : ∀ x ∈ Set.Icc a b,
      ‖g' x * (((2 * lambda * x : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * x⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx')
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm x hx']
    calc
      ‖g' x‖ * (2 * lambda * x)⁻¹ ≤
          N * (2 * lambda * x)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg'_bound x hx')
          (inv_nonneg.mpr (mul_pos (mul_pos (by norm_num) hlambda) (hpos x hx')).le)
      _ = (N / (2 * lambda)) * x⁻¹ := by
        field_simp [ne_of_gt htwolambda, hx0]
  have hg'integrable : IntervalIntegrable
      (fun t : Real => ‖g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
        Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume a b :=
    ((hg'cont.mul hQcont).mul hEcont).norm.intervalIntegrable
  have hinvcont : ContinuousOn (fun t : Real => t⁻¹) (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ continuous_id.continuousOn ?_
    intro x hx
    exact ne_of_gt (hpos x hx)
  have hderiv_major_integrable : IntervalIntegrable
      (fun t : Real => (N / (2 * lambda)) * t⁻¹) volume a b :=
    (continuousOn_const.mul hinvcont).intervalIntegrable
  have hderivbound :
      ‖∫ t in a..b,
        g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * Real.log (b / a) := by
    calc
      ‖∫ t in a..b,
        g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (N / (2 * lambda)) * t⁻¹ :=
        intervalIntegral.integral_mono_on hab hg'integrable hderiv_major_integrable hg'point
      _ = (N / (2 * lambda)) * Real.log (b / a) := by
        rw [intervalIntegral.integral_const_mul, integral_inv_of_pos ha hbpos]
  have hrempoint : ∀ x ∈ Set.Icc a b,
      ‖g x *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * x : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * x⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx')
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQ'norm x hx']
    calc
      ‖g x‖ * ((2 * lambda)⁻¹ * (x ^ 2)⁻¹) ≤
          (N * x) * ((2 * lambda)⁻¹ * (x ^ 2)⁻¹) :=
        mul_le_mul_of_nonneg_right (hg_cone x hx)
          (mul_nonneg (inv_nonneg.mpr htwolambda.le) (inv_nonneg.mpr (sq_nonneg x)))
      _ = (N / (2 * lambda)) * x⁻¹ := by
        field_simp [ne_of_gt htwolambda, hx0]
  have hrem_integrable : IntervalIntegrable (fun t : Real =>
      ‖g t *
        (-(((2 * lambda : Real) : Complex) * Complex.I) /
          ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
          Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume a b :=
    ((hgcont.mul hQ'cont).mul hEcont).norm.intervalIntegrable
  have hrembound :
      ‖∫ t in a..b,
        g t *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        (N / (2 * lambda)) * Real.log (b / a) := by
    calc
      ‖∫ t in a..b,
        g t *
          (-(((2 * lambda : Real) : Complex) * Complex.I) /
            ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, (N / (2 * lambda)) * t⁻¹ :=
        intervalIntegral.integral_mono_on hab hrem_integrable hderiv_major_integrable hrempoint
      _ = (N / (2 * lambda)) * Real.log (b / a) := by
        rw [intervalIntegral.integral_const_mul, integral_inv_of_pos ha hbpos]
  have hid := brrs_quadratic_phase_weighted_integration_by_parts
    ha hab hlambda.ne' g g' hg hg'cont
  rw [hid]
  calc
    ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
        g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ +
        ‖∫ t in a..b,
          g t *
            (-(((2 * lambda : Real) : Complex) * Complex.I) /
              ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := by
      calc
        _ ≤ ‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I) -
          (∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I))‖ +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := norm_sub_le _ _
        _ ≤ (‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I) -
          g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
          add_le_add_left (norm_sub_le _ _) _
        _ ≤ ((‖g b * (((2 * lambda * b : Real) : Complex) * Complex.I)⁻¹ *
          Complex.exp (((lambda * b ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖g a * (((2 * lambda * a : Real) : Complex) * Complex.I)⁻¹ *
            Complex.exp (((lambda * a ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g' t * (((2 * lambda * t : Real) : Complex) * Complex.I)⁻¹ *
              Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * lambda : Real) : Complex) * Complex.I) /
                ((((2 * lambda * t : Real) : Complex) * Complex.I) ^ 2)) *
                Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ := by
          gcongr
          exact norm_sub_le _ _
        _ = _ := by ring
    _ ≤ N / (2 * lambda) + N / (2 * lambda) +
        (N / (2 * lambda)) * Real.log (b / a) +
        (N / (2 * lambda)) * Real.log (b / a) := by
      gcongr
    _ = (N / lambda) * (1 + Real.log (b / a)) := by
      field_simp [ne_of_gt hlambda]
      ring

/-- The derivative-form tail estimate above packages directly from a `C¹`
amplitude which vanishes at the stationary endpoint.  This is the form used
for `u ↦ h u - h 0`: the first-order endpoint condition is derived by the
mean-value theorem, while all nonstationary cancellation is supplied by the
preceding integration-by-parts lemma. -/
theorem brrs_quadratic_phase_weighted_tail_norm_le_of_contDiff_zero
    {a b lambda N : Real} (ha : 0 < a) (hab : a ≤ b) (hlambda : 0 < lambda)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 b, ‖deriv g x‖ ≤ N) :
    ‖∫ t in a..b, g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (N / lambda) * (1 + Real.log (b / a)) := by
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hderiv_cont : Continuous (deriv g) :=
    hg_smooth.continuous_deriv (by norm_num)
  have hcone_full : ∀ x ∈ Set.Icc (0 : Real) b, ‖g x - g 0‖ ≤ N * (x - 0) := by
    apply norm_image_sub_le_of_norm_deriv_le_segment'
    · intro x hx
      exact (hdiff x).hasDerivAt.hasDerivWithinAt
    · intro x hx
      exact hderiv_bound x ⟨hx.1, hx.2.le⟩
  apply brrs_quadratic_phase_weighted_tail_norm_le_of_cone ha hab hlambda
    g (deriv g)
  · intro x hx
    exact (hdiff x).hasDerivAt
  · exact hderiv_cont.continuousOn
  · intro x hx
    have hcone := hcone_full x ⟨le_trans ha.le hx.1, hx.2⟩
    simpa [hg_zero] using hcone
  · intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact hderiv_bound x ⟨le_trans ha.le hx'.1, hx'.2⟩

/-- The stationary core of an amplitude vanishing at zero is quadratically
small in the interval length.  Together with the weighted nonstationary tail
estimate, this gives a direct finite-scale control of the rescaled endpoint
error. -/
theorem brrs_quadratic_phase_small_interval_norm_le_of_contDiff_zero
    {b lambda N : Real} (hb : 0 ≤ b) (hN : 0 ≤ N)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 b, ‖deriv g x‖ ≤ N) :
    ‖∫ t in (0 : Real)..b,
      g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      N * b ^ 2 / 2 := by
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hcone : ∀ x ∈ Set.Icc (0 : Real) b, ‖g x‖ ≤ N * x := by
    intro x hx
    have himage : ‖g x - g 0‖ ≤ N * (x - 0) := by
      exact norm_image_sub_le_of_norm_deriv_le_segment'
        (fun y hy => (hdiff y).hasDerivAt.hasDerivWithinAt)
        (fun y hy => hderiv_bound y ⟨hy.1, hy.2.le⟩) x hx
    simpa [hg_zero] using himage
  have hgcont : Continuous g := hg_smooth.continuous
  have hphasecont : Continuous (fun t : Real =>
      Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)) := by
    fun_prop
  have hintegrable : IntervalIntegrable (fun t : Real =>
      ‖g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖)
      volume 0 b :=
    ((hgcont.mul hphasecont).norm).intervalIntegrable _ _
  have hmajor_integrable : IntervalIntegrable (fun t : Real => N * t) volume 0 b :=
    (continuous_const.mul continuous_id).intervalIntegrable _ _
  have hpoint : ∀ x ∈ Set.Icc (0 : Real) b,
      ‖g x * Complex.exp (((lambda * x ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        N * x := by
    intro x hx
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I]
    simpa using hcone x hx
  calc
    ‖∫ t in (0 : Real)..b,
        g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ∫ t in (0 : Real)..b,
          ‖g t * Complex.exp (((lambda * t ^ 2 : Real) : Complex) * Complex.I)‖ :=
      intervalIntegral.norm_integral_le_integral_norm hb
    _ ≤ ∫ t in (0 : Real)..b, N * t :=
      intervalIntegral.integral_mono_on hb hintegrable hmajor_integrable hpoint
    _ = N * b ^ 2 / 2 := by
      rw [intervalIntegral.integral_const_mul, integral_id]
      ring

/-- A finite rescaled endpoint-error estimate.  The amplitude vanishes at the
stationary endpoint, so the unit-scale core costs `M / (2c)` and the rest is
controlled by the quadratic nonstationary tail.  This is the quantitative
input needed to feed a compact smooth endpoint amplitude into the fixed
Fresnel carrier; it does not assert any kernel lower bound. -/
theorem brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
    {c M : Real} (hc : 1 ≤ c)
    (g : Real → Complex) (hg_smooth : ContDiff Real 1 g) (hg_zero : g 0 = 0)
    (hderiv_bound : ∀ x ∈ Set.Icc 0 1, ‖deriv g x‖ ≤ M) :
    ‖∫ v in (0 : Real)..c,
      g (v / c) * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (M / c) * (3 / 2 + Real.log c) := by
  have hcpos : 0 < c := lt_of_lt_of_le zero_lt_one hc
  have hM : 0 ≤ M := by
    exact (norm_nonneg (deriv g 0)).trans
      (hderiv_bound 0 ⟨le_rfl, zero_le_one⟩)
  let G : Real → Complex := fun v => g (v / c)
  have hG_smooth : ContDiff Real 1 G := by
    dsimp [G]
    exact hg_smooth.comp (contDiff_id.div_const c)
  have hG_zero : G 0 = 0 := by
    simp [G, hg_zero]
  have hdiff : Differentiable Real g := hg_smooth.differentiable (by norm_num)
  have hderiv_G : ∀ v : Real, deriv G v = (1 / c : Real) • deriv g (v / c) := by
    intro v
    have hscale : HasDerivAt (fun w : Real => w / c) (1 / c : Real) v := by
      simpa using (hasDerivAt_id v).div_const c
    have hchain : HasDerivAt (fun w : Real => g (w / c))
        ((1 / c : Real) • deriv g (v / c)) v := by
      change HasDerivAt (g ∘ fun w : Real => w / c)
        ((1 / c : Real) • deriv g (v / c)) v
      exact HasDerivAt.scomp v ((hdiff (v / c)).hasDerivAt) hscale
    exact hchain.deriv
  have hderiv_G_bound : ∀ v ∈ Set.Icc (0 : Real) c, ‖deriv G v‖ ≤ M / c := by
    intro v hv
    have hvdiv : v / c ∈ Set.Icc (0 : Real) 1 := by
      constructor
      · exact div_nonneg hv.1 hcpos.le
      · exact (div_le_iff₀ hcpos).mpr (by simpa using hv.2)
    rw [hderiv_G v, norm_smul, Real.norm_eq_abs,
      abs_of_pos (one_div_pos.mpr hcpos)]
    calc
      (1 / c) * ‖deriv g (v / c)‖ ≤ (1 / c) * M :=
        mul_le_mul_of_nonneg_left (hderiv_bound _ hvdiv)
          (one_div_nonneg.mpr hcpos.le)
      _ = M / c := by ring
  have hN : 0 ≤ M / c := div_nonneg hM hcpos.le
  have hcore := brrs_quadratic_phase_small_interval_norm_le_of_contDiff_zero
    (b := 1) (lambda := 1) (N := M / c) (by norm_num) hN G hG_smooth hG_zero
    (fun v hv => hderiv_G_bound v ⟨hv.1, le_trans hv.2 hc⟩)
  have htail := brrs_quadratic_phase_weighted_tail_norm_le_of_contDiff_zero
    (a := 1) (b := c) (lambda := 1) zero_lt_one hc (by norm_num)
    G hG_smooth hG_zero hderiv_G_bound
  have hcore' : ‖∫ v in (0 : Real)..1,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤ M / c / 2 := by
    simpa using hcore
  have htail' : ‖∫ v in (1 : Real)..c,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
      (M / c) * (1 + Real.log c) := by
    simpa using htail
  have hGcont : Continuous G := hG_smooth.continuous
  have hsplit :
      (∫ v in (0 : Real)..1,
        G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)) +
        ∫ v in (1 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I) =
        ∫ v in (0 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I) :=
    intervalIntegral.integral_add_adjacent_intervals
      ((hGcont.mul (by fun_prop)).intervalIntegrable 0 1)
      ((hGcont.mul (by fun_prop)).intervalIntegrable 1 c)
  change ‖∫ v in (0 : Real)..c,
      G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤ _
  rw [← hsplit]
  calc
    ‖(∫ v in (0 : Real)..1,
        G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)) +
        ∫ v in (1 : Real)..c,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ ≤
        ‖∫ v in (0 : Real)..1,
          G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ +
          ‖∫ v in (1 : Real)..c,
            G v * Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I)‖ :=
      norm_add_le _ _
    _ ≤ M / c / 2 + (M / c) * (1 + Real.log c) :=
      add_le_add hcore' htail'
    _ = (M / c) * (3 / 2 + Real.log c) := by ring

/-- A smooth order-zero endpoint has the exact Fresnel leading carrier after
the natural square-root normalization.  The proof combines the finite
rescaled-error estimate with the Abel evaluation of the carrier; it is the
even-dimensional stationary-endpoint input needed before assembling a
two-wave Bessel expansion. -/
theorem brrsEvenQuadraticBaseNormalized_tendsto_fresnel
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) :
    Tendsto (brrsEvenQuadraticBaseNormalized h) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
  let g : Real -> Complex := fun u => h u - h 0
  have hg : ContDiff Real (⊤ : ℕ∞) g := by
    dsimp only [g]
    exact hh.sub contDiff_const
  have hgzero : g 0 = 0 := by
    simp only [g, sub_self]
  have hg_one : ContDiff Real 1 g := hg.of_le (by norm_num)
  obtain ⟨M, hMpos, hMbound⟩ :=
    exists_pos_norm_le_on_unit_of_contDiff (deriv g)
      ((contDiff_infty_iff_deriv.mp hg).2)
  have hbase : Tendsto
      (fun c : Real => ((3 / 2 : Real) + Real.log c) / c) atTop (nhds 0) := by
    have hconst : (fun _ : Real => (3 / 2 : Real)) =o[atTop] id :=
      (Real.isLittleO_const_log_atTop (c := (3 / 2 : Real))).trans
        Real.isLittleO_log_id_atTop
    have hsmall : (fun c : Real => (3 / 2 : Real) + Real.log c) =o[atTop] id :=
      hconst.add Real.isLittleO_log_id_atTop
    simpa only [id] using hsmall.tendsto_div_nhds_zero
  have hbound_tendsto : Tendsto
      (fun c : Real => (M / c) * ((3 / 2 : Real) + Real.log c)) atTop (nhds 0) := by
    have hmul : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds (M * 0)) :=
      (tendsto_const_nhds : Tendsto (fun _ : Real => M) atTop (nhds M)).mul hbase
    have hmul_zero : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds 0) := by
      simpa only [mul_zero] using hmul
    convert hmul_zero using 1 <;> ext c <;> ring
  let E : Real -> Complex := fun lambda =>
    intervalIntegral
      (fun v => (h (v / Real.sqrt lambda) - h 0) *
        Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
      0 (Real.sqrt lambda) volume
  have hEbound : ∀ᶠ lambda : Real in atTop,
      ‖E lambda‖ ≤ (M / Real.sqrt lambda) *
        ((3 / 2 : Real) + Real.log (Real.sqrt lambda)) := by
    filter_upwards [eventually_ge_atTop (1 : Real)] with lambda hlambda
    have hsqrt : (1 : Real) ≤ Real.sqrt lambda := Real.one_le_sqrt.mpr hlambda
    dsimp [E]
    simpa only [g] using
      (brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
        (c := Real.sqrt lambda) (M := M) hsqrt g hg_one hgzero hMbound)
  have hE_tendsto : Tendsto E atTop (nhds 0) := by
    apply squeeze_zero_norm' hEbound
    exact hbound_tendsto.comp Real.tendsto_sqrt_atTop
  have hF_tendsto : Tendsto
      (fun lambda : Real =>
        brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) atTop
      (nhds brrsQuadraticFresnelLimit) :=
    brrsNormalizedQuadraticFresnelIntegral_tendsto_limit.comp Real.tendsto_sqrt_atTop
  have hcore_tendsto : Tendsto (fun lambda : Real =>
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda)) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
    exact (tendsto_const_nhds : Tendsto (fun _ : Real => h 0) atTop (nhds (h 0))).mul hF_tendsto
  have hsum_tendsto : Tendsto (fun lambda : Real =>
      h 0 * brrsNormalizedQuadraticFresnelIntegral (Real.sqrt lambda) + E lambda) atTop
      (nhds (h 0 * brrsQuadraticFresnelLimit)) := by
    simpa using hcore_tendsto.add hE_tendsto
  refine Tendsto.congr' ?_ hsum_tendsto
  filter_upwards [eventually_gt_atTop (0 : Real)] with lambda hlambda
  dsimp [E]
  exact (brrsEvenQuadraticBaseNormalized_eq_fresnel_add_rescaledError
    h hh.continuous hlambda).symm

/-- The canonical carrier used by the existing even endpoint machinery is
therefore the explicit Fresnel value multiplied by the endpoint amplitude. -/
theorem brrsEvenQuadraticBaseCarrier_eq_fresnel
    (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) :
    brrsEvenQuadraticBaseCarrier h = h 0 * brrsQuadraticFresnelLimit := by
  unfold brrsEvenQuadraticBaseCarrier
  exact (brrsEvenQuadraticBaseNormalized_tendsto_fresnel h hh).limUnder_eq

/-- The fixed finite Fresnel carrier gives the order-zero stationary lower
bound for every genuinely smooth compact endpoint profile with a nonzero
value at the stationary point.  The error is made explicit: subtract the
constant endpoint value, control its derivative on the unit interval, and use
the proved rescaled nonstationary estimate.  Thus this is an unconditional
analytic result, rather than a new stationary-phase hypothesis. -/
theorem exists_quadraticMoment_zero_eventually_lower_of_contDiff
    (h : Real → Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤ ‖quadraticMomentIntegral 0 h lambda‖ := by
  let g : Real → Complex := fun u => h u - h 0
  have hg : ContDiff Real (⊤ : ℕ∞) g := by
    dsimp only [g]
    exact hh.sub contDiff_const
  have hgzero : g 0 = 0 := by
    simp only [g, sub_self]
  have hg_one : ContDiff Real 1 g := hg.of_le (by norm_num)
  obtain ⟨M, hMpos, hMbound⟩ :=
    exists_pos_norm_le_on_unit_of_contDiff (deriv g)
      ((contDiff_infty_iff_deriv.mp hg).2)
  let a : Real := ‖h 0‖
  have ha : 0 < a := by
    dsimp only [a]
    exact norm_pos_iff.mpr hzero
  have ha128 : 0 < a / 128 := div_pos ha (by norm_num)
  have hbase : Tendsto
      (fun c : Real => ((3 / 2 : Real) + Real.log c) / c) atTop (nhds 0) := by
    have hconst : (fun _ : Real => (3 / 2 : Real)) =o[atTop] id :=
      (Real.isLittleO_const_log_atTop (c := (3 / 2 : Real))).trans
        Real.isLittleO_log_id_atTop
    have hsmall : (fun c : Real => (3 / 2 : Real) + Real.log c) =o[atTop] id :=
      hconst.add Real.isLittleO_log_id_atTop
    simpa only [id] using hsmall.tendsto_div_nhds_zero
  have hlimit : Tendsto
      (fun c : Real => (M / c) * ((3 / 2 : Real) + Real.log c)) atTop (nhds 0) := by
    have hmul : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds (M * 0)) :=
      (tendsto_const_nhds : Tendsto (fun _ : Real => M) atTop (nhds M)).mul hbase
    have hmul_zero : Tendsto
        (fun c : Real => M * (((3 / 2 : Real) + Real.log c) / c))
          atTop (nhds 0) := by
      simpa only [mul_zero] using hmul
    convert hmul_zero using 1 <;> ext c <;> ring
  have hevent : Filter.Eventually (fun c : Real =>
      (M / c) * ((3 / 2 : Real) + Real.log c) ≤ a / 128) atTop := by
    filter_upwards [hlimit.eventually (eventually_lt_nhds ha128)]
      with c hc
    exact hc.le
  obtain ⟨C, hC⟩ := eventually_atTop.mp hevent
  let B : Real := max 64 C
  have hB64 : (64 : Real) ≤ B := by
    dsimp only [B]
    exact le_max_left _ _
  have hBC : C ≤ B := by
    dsimp only [B]
    exact le_max_right _ _
  have hBpos : 0 < B := by linarith
  refine ⟨B ^ 2, a / 128, ?_, div_pos ha (by norm_num), ?_⟩
  · nlinarith
  · intro lambda hlambda
    have hlambda_pos : 0 < lambda := by
      have hBsq_pos : 0 < B ^ 2 := pow_pos hBpos _
      exact lt_of_lt_of_le hBsq_pos hlambda
    have hlambda_large : (4096 : Real) ≤ lambda := by
      nlinarith [hB64]
    have hsqrt_B : B ≤ Real.sqrt lambda := by
      have hBnonneg : 0 ≤ B := hBpos.le
      calc
        B = Real.sqrt (B ^ 2) := by
          rw [Real.sqrt_sq_eq_abs, abs_of_nonneg hBnonneg]
        _ ≤ Real.sqrt lambda := Real.sqrt_le_sqrt hlambda
    have hB_one : (1 : Real) ≤ B := by
      linarith [hB64]
    have hsqrt_one : (1 : Real) ≤ Real.sqrt lambda :=
      le_trans hB_one hsqrt_B
    have hbudget : (M / Real.sqrt lambda) *
        ((3 / 2 : Real) + Real.log (Real.sqrt lambda)) ≤ a / 128 :=
      hC _ (le_trans hBC hsqrt_B)
    have hrescaled := brrs_rescaled_quadratic_phase_error_norm_le_of_contDiff_zero
      (c := Real.sqrt lambda) (M := M) hsqrt_one g hg_one hgzero hMbound
    have herror : ‖intervalIntegral
        (fun v => (h (v / Real.sqrt lambda) - h 0) *
          Complex.exp (((v ^ 2 : Real) : Complex) * Complex.I))
        0 (Real.sqrt lambda) volume‖ ≤ a / 128 := by
      simpa only [g] using hrescaled.trans hbudget
    have hmain := quadraticMomentIntegral_zero_norm_lower_of_rescaledError_le
      h hh.continuous hzero hlambda_large herror
    simpa only [a] using hmain

/-- A quantified recurrence step for even quadratic stationary moments.

It isolates the only missing analytic input for the even-dimensional and
planar BRRS lower bound: a sharp lower estimate at the order-zero Fresnel
moment.  Once that base estimate is supplied, the exact recurrence below
propagates it through every even order without any additional stationary
analysis. -/
theorem exists_quadraticMoment_even_eventually_lower_step
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {L c : Real}
    (hL : 1 ≤ L) (hc : 0 < c)
    (hlower : ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n) h lambda‖) :
    ∃ L' c' : Real, 1 ≤ L' ∧ 0 < c' ∧ ∀ lambda : Real, L' ≤ lambda →
      c' / (lambda ^ (n + 1) * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n + 2) h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_decay (2 * n + 1) (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
  let B : Real := 2 * C / c
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max L (max 1 (B ^ 2)), c / 4, ?_, by positivity, ?_⟩
  · exact le_trans hL (le_max_left _ _)
  intro lambda hlambda
  have hlambda_L : L ≤ lambda :=
    le_trans (le_max_left _ _) hlambda
  have hlambda_one : 1 ≤ lambda := by
    exact le_trans (le_max_left _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hlambda_pos : 0 < lambda :=
    lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsq : B ^ 2 ≤ lambda := by
    exact le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hsqrt_sq : Real.sqrt lambda ^ 2 = lambda :=
    Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hCmul : 2 * C ≤ Real.sqrt lambda * c := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ hc).mp hB_le_sqrt
  have hCsqrt : C / Real.sqrt lambda ≤ c / 2 := by
    rw [div_le_iff₀ hsqrt_pos]
    nlinarith
  have hden_pos : 0 < lambda ^ n * Real.sqrt lambda :=
    mul_pos (pow_pos hlambda_pos _) hsqrt_pos
  let A : Complex := quadraticMomentIntegral (2 * n) h lambda
  let R : Complex := quadraticMomentIntegral (2 * n + 1) (deriv h) lambda
  have hA : c / (lambda ^ n * Real.sqrt lambda) ≤ ‖A‖ := by
    exact hlower lambda hlambda_L
  have hRraw : ‖R‖ ≤ C / quadraticMomentScale (2 * n + 1) lambda := by
    dsimp [R]
    exact hCbound lambda hlambda_one
  have hscale := brrs_quadraticMomentScale_odd n hlambda_pos.le
  have hR : ‖R‖ ≤ (c / 2) / (lambda ^ n * Real.sqrt lambda) := by
    calc
      ‖R‖ ≤ C / quadraticMomentScale (2 * n + 1) lambda := hRraw
      _ = C / lambda ^ (n + 1) := by rw [hscale]
      _ = (C / Real.sqrt lambda) / (lambda ^ n * Real.sqrt lambda) := by
        rw [show n + 1 = n + 1 by rfl, pow_succ]
        field_simp [ne_of_gt hsqrt_pos, ne_of_gt hden_pos, ne_of_gt hlambda_pos,
          hsqrt_sq]
        exact hsqrt_sq
      _ ≤ (c / 2) / (lambda ^ n * Real.sqrt lambda) :=
        div_le_div_of_nonneg_right hCsqrt hden_pos.le
  have hcoeff_one : (1 : Real) ≤ ((2 * n + 1 : Nat) : Real) := by
    have hcoeff_nat : 1 ≤ 2 * n + 1 := by omega
    exact_mod_cast hcoeff_nat
  have hcoeff_nonneg : (0 : Real) ≤ ((2 * n + 1 : Nat) : Real) :=
    Nat.cast_nonneg _
  have hbase_nonneg : 0 ≤ c / (lambda ^ n * Real.sqrt lambda) :=
    (div_pos hc hden_pos).le
  have hcoeff_norm :
      ‖((2 * n + 1 : Nat) : Complex) * A‖ =
        ((2 * n + 1 : Nat) : Real) * ‖A‖ := by
    rw [norm_mul, norm_natCast]
  have hcoeff_lower : c / (lambda ^ n * Real.sqrt lambda) ≤
      ‖((2 * n + 1 : Nat) : Complex) * A‖ := by
    calc
      c / (lambda ^ n * Real.sqrt lambda) ≤
          ((2 * n + 1 : Nat) : Real) *
            (c / (lambda ^ n * Real.sqrt lambda)) := by
        simpa only [one_mul] using
          (mul_le_mul_of_nonneg_right hcoeff_one hbase_nonneg)
      _ ≤ ((2 * n + 1 : Nat) : Real) * ‖A‖ :=
        mul_le_mul_of_nonneg_left hA hcoeff_nonneg
      _ = ‖((2 * n + 1 : Nat) : Complex) * A‖ := hcoeff_norm.symm
  have htriangle : ‖((2 * n + 1 : Nat) : Complex) * A‖ ≤
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖ + ‖R‖ := by
    calc
      ‖((2 * n + 1 : Nat) : Complex) * A‖ =
          ‖(((2 * n + 1 : Nat) : Complex) * A + R) - R‖ := by ring_nf
      _ ≤ ‖((2 * n + 1 : Nat) : Complex) * A + R‖ + ‖R‖ :=
        norm_sub_le _ _
  have hsum : (c / 2) / (lambda ^ n * Real.sqrt lambda) ≤
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖ := by
    have hhalf : (c / 2) / (lambda ^ n * Real.sqrt lambda) =
        (c / (lambda ^ n * Real.sqrt lambda)) / 2 := by ring
    rw [hhalf]
    linarith
  have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n) h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  change c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) ≤ _
  rw [hrec, norm_mul, hscalar]
  change c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) ≤
    (1 / (2 * lambda)) *
      ‖((2 * n + 1 : Nat) : Complex) * A + R‖
  calc
    c / 4 / (lambda ^ (n + 1) * Real.sqrt lambda) =
        (1 / (2 * lambda)) *
          ((c / 2) / (lambda ^ n * Real.sqrt lambda)) := by
      rw [pow_succ]
      field_simp [ne_of_gt hlambda_pos, ne_of_gt hsqrt_pos] <;> norm_num
    _ ≤ (1 / (2 * lambda)) *
        ‖((2 * n + 1 : Nat) : Complex) * A + R‖ :=
      mul_le_mul_of_nonneg_left hsum (by positivity)

/-- Reduction of all even quadratic stationary lower bounds to the single
order-zero Fresnel lower bound for the same endpoint profile.  This is a
proved recurrence theorem, not an assumed stationary estimate. -/
theorem exists_quadraticMoment_even_eventually_lower_of_zero_lower
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h)
    (hzero : ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤ ‖quadraticMomentIntegral 0 h lambda‖) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖quadraticMomentIntegral (2 * n) h lambda‖ := by
  induction n with
  | zero =>
      obtain ⟨L, c, hL, hc, hbound⟩ := hzero
      refine ⟨L, c, hL, hc, ?_⟩
      intro lambda hlambda
      simpa using hbound lambda hlambda
  | succ n ih =>
      obtain ⟨L, c, hL, hc, hbound⟩ := ih
      obtain ⟨L', c', hL', hc', hstep⟩ :=
        exists_quadraticMoment_even_eventually_lower_step n h hh hvanish hL hc hbound
      refine ⟨L', c', hL', hc', ?_⟩
      intro lambda hlambda
      have hmoment : 2 * (n + 1) = 2 * n + 2 := by omega
      rw [hmoment]
      exact hstep lambda hlambda

/-- For a concrete even BRRS endpoint profile, the sole remaining analytic
input is its order-zero compact Fresnel lower bound.  The conclusion then
follows in every even stationary order by the proved recurrence. -/
theorem exists_smoothEndpointQuadraticIntegral_even_eventually_lower_of_zero_lower
    (n : Nat)
    (hzero : ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / Real.sqrt lambda ≤
        ‖quadraticMomentIntegral 0 (smoothEndpointProfile (2 * n)) lambda‖) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / (lambda ^ n * Real.sqrt lambda) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_even_eventually_lower_of_zero_lower n
      (smoothEndpointProfile (2 * n))
      (contDiff_smoothEndpointProfile (2 * n))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n)) hzero
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- One quantified recurrence step for sharp lower bounds at odd quadratic
stationary orders.  A lower bound at order `2 n + 1` propagates to order
`(2 n + 1) + 2`: the exact recurrence makes the old moment the leading
term, while the next even derivative moment is smaller by one square root.

This is deliberately stated for an arbitrary smooth compact endpoint
amplitude, rather than just the BRRS symbol, so it can be iterated without
reproving stationary phase. -/
theorem exists_quadraticMoment_odd_eventually_lower_step
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) {L c : Real}
    (hL : 1 ≤ L) (hc : 0 < c)
    (hlower : ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤ ‖quadraticMomentIntegral (2 * n + 1) h lambda‖) :
    ∃ L' c' : Real, 1 ≤ L' ∧ 0 < c' ∧ ∀ lambda : Real, L' ≤ lambda →
      c' / lambda ^ (n + 2) ≤
        ‖quadraticMomentIntegral ((2 * n + 1) + 2) h lambda‖ := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_quadraticMoment_decay (2 * n + 2) (deriv h)
      ((contDiff_infty_iff_deriv.mp hh).2) (VanishesNearOne.deriv h hvanish)
  let B : Real := C / c
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  refine ⟨max L (max 1 (B ^ 2)), c / 2, ?_, by positivity, ?_⟩
  · exact le_trans hL (le_max_left _ _)
  intro lambda hlambda
  have hlambda_L : L ≤ lambda :=
    le_trans (le_max_left _ _) hlambda
  have hlambda_one : 1 ≤ lambda := by
    exact le_trans (le_max_left _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hlambda_pos : 0 < lambda :=
    lt_of_lt_of_le zero_lt_one hlambda_one
  have hsqrt_pos : 0 < Real.sqrt lambda := Real.sqrt_pos.2 hlambda_pos
  have hBsq : B ^ 2 ≤ lambda := by
    exact le_trans (le_max_right _ _)
      (le_trans (le_max_right _ _) hlambda)
  have hsqrt_sq : Real.sqrt lambda ^ 2 = lambda :=
    Real.sq_sqrt hlambda_pos.le
  have hB_le_sqrt : B ≤ Real.sqrt lambda := by
    nlinarith
  have hCmul : C ≤ Real.sqrt lambda * c := by
    dsimp [B] at hB_le_sqrt
    exact (div_le_iff₀ hc).mp hB_le_sqrt
  have hCsqrt : C / Real.sqrt lambda ≤ c := by
    rw [div_le_iff₀ hsqrt_pos]
    nlinarith
  have hpow_pos : 0 < lambda ^ (n + 1) := pow_pos hlambda_pos _
  have hindex : (2 * n + 1) + 1 = 2 * n + 2 := by omega
  let A : Complex := quadraticMomentIntegral (2 * n + 1) h lambda
  let R : Complex := quadraticMomentIntegral ((2 * n + 1) + 1) (deriv h) lambda
  have hA : c / lambda ^ (n + 1) ≤ ‖A‖ := by
    exact hlower lambda hlambda_L
  have hRraw : ‖R‖ ≤ C / quadraticMomentScale (2 * n + 2) lambda := by
    dsimp [R]
    rw [hindex]
    exact hCbound lambda hlambda_one
  have hscale := brrs_quadraticMomentScale_even_remainder n hlambda_pos.le
  have hR : ‖R‖ ≤ c / lambda ^ (n + 1) := by
    calc
      ‖R‖ ≤ C / quadraticMomentScale (2 * n + 2) lambda := hRraw
      _ = C / (lambda ^ (n + 1) * Real.sqrt lambda) := by rw [hscale]
      _ = (C / Real.sqrt lambda) / lambda ^ (n + 1) := by
        field_simp [ne_of_gt hsqrt_pos, ne_of_gt hpow_pos]
      _ ≤ c / lambda ^ (n + 1) :=
        div_le_div_of_nonneg_right hCsqrt hpow_pos.le
  have hcoeff_two : (2 : Real) ≤ ((2 * n + 1 + 1 : Nat) : Real) := by
    have hcoeff_nat : 2 ≤ 2 * n + 1 + 1 := by omega
    exact_mod_cast hcoeff_nat
  have hcoeff_nonneg : (0 : Real) ≤ ((2 * n + 1 + 1 : Nat) : Real) :=
    Nat.cast_nonneg _
  have hbase_nonneg : 0 ≤ c / lambda ^ (n + 1) :=
    (div_pos hc hpow_pos).le
  have hcoeff_norm :
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ =
        ((2 * n + 1 + 1 : Nat) : Real) * ‖A‖ := by
    rw [norm_mul, norm_natCast]
  have hcoeff_lower : 2 * (c / lambda ^ (n + 1)) ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ := by
    calc
      2 * (c / lambda ^ (n + 1)) ≤
          ((2 * n + 1 + 1 : Nat) : Real) * (c / lambda ^ (n + 1)) :=
        mul_le_mul_of_nonneg_right hcoeff_two hbase_nonneg
      _ ≤ ((2 * n + 1 + 1 : Nat) : Real) * ‖A‖ :=
        mul_le_mul_of_nonneg_left hA hcoeff_nonneg
      _ = ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ := hcoeff_norm.symm
  have htriangle : ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ + ‖R‖ := by
    calc
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A‖ =
          ‖(((2 * n + 1 + 1 : Nat) : Complex) * A + R) - R‖ := by ring_nf
      _ ≤ ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ + ‖R‖ :=
        norm_sub_le _ _
  have hsum : c / lambda ^ (n + 1) ≤
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ := by
    linarith
  have hrec := quadraticMomentIntegral_succ_two_recurrence (2 * n + 1) h hh hvanish
    (ne_of_gt hlambda_pos)
  have hqnorm : ‖((2 * lambda : Real) : Complex) * Complex.I‖ = 2 * lambda := by
    have htwo : 0 ≤ 2 * lambda := by nlinarith
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I,
      abs_of_nonneg htwo]
    simp
  have hscalar : ‖-((((2 * lambda : Real) : Complex) * Complex.I)⁻¹)‖ =
      1 / (2 * lambda) := by
    rw [norm_neg, norm_inv, hqnorm]
    simp
  change c / 2 / lambda ^ (n + 2) ≤ _
  rw [hrec, norm_mul, hscalar]
  change c / 2 / lambda ^ (n + 2) ≤
    (1 / (2 * lambda)) *
      ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖
  calc
    c / 2 / lambda ^ (n + 2) =
        (1 / (2 * lambda)) * (c / lambda ^ (n + 1)) := by
      rw [show n + 2 = (n + 1) + 1 by omega, pow_succ]
      field_simp [ne_of_gt hlambda_pos]
    _ ≤ (1 / (2 * lambda)) *
        ‖((2 * n + 1 + 1 : Nat) : Complex) * A + R‖ :=
      mul_le_mul_of_nonneg_left hsum (by positivity)

/-- Every odd quadratic stationary moment with a nonzero endpoint
coefficient has its sharp eventual lower size.  This is obtained by
iterating `exists_quadraticMoment_odd_eventually_lower_step` from the exact
first-moment boundary formula. -/
theorem exists_quadraticMoment_odd_eventually_lower_of_ne_zero
    (n : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (hvanish : VanishesNearOne h) (hzero : h 0 ≠ 0) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤ ‖quadraticMomentIntegral (2 * n + 1) h lambda‖ := by
  induction n with
  | zero =>
      obtain ⟨L, c, hL, hc, hbound⟩ :=
        exists_quadraticMoment_one_eventually_lower_of_ne_zero h hh hvanish hzero
      refine ⟨L, c, hL, hc, ?_⟩
      intro lambda hlambda
      simpa using hbound lambda hlambda
  | succ n ih =>
      obtain ⟨L, c, hL, hc, hbound⟩ := ih
      obtain ⟨L', c', hL', hc', hbound'⟩ :=
        exists_quadraticMoment_odd_eventually_lower_step n h hh hvanish hL hc hbound
      refine ⟨L', c', hL', hc', ?_⟩
      intro lambda hlambda
      have hstep := hbound' lambda hlambda
      have hexponent : Nat.succ n + 1 = n + 2 := by omega
      have hmoment : 2 * Nat.succ n + 1 = (2 * n + 1) + 2 := by omega
      rw [hexponent, hmoment]
      exact hstep

/-- The concrete nonplanar BRRS endpoint integrals therefore have sharp
eventual lower decay in every odd stationary order (equivalently, every odd
spatial dimension at least three). -/
theorem exists_smoothEndpointQuadraticIntegral_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ lambda →
      c / lambda ^ (n + 1) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_quadraticMoment_odd_eventually_lower_of_ne_zero n
      (smoothEndpointProfile (2 * n + 1))
      (contDiff_smoothEndpointProfile (2 * n + 1))
      (smoothEndpointProfile_eventuallyEq_zero_at_one (2 * n + 1))
      (brrs_smoothEndpointProfile_zero_ne_zero (2 * n + 1))
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rw [smoothEndpointQuadraticIntegral_eq_quadraticMomentIntegral]
  exact hbound lambda hlambda

/-- The odd-order endpoint lower bound is invariant under reversal of the
stationary phase.  This packages the outgoing and incoming signs in one
reusable statement. -/
theorem exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ lambda : Real, L ≤ |lambda| →
      c / |lambda| ^ (n + 1) ≤
        ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower n
  refine ⟨L, c, hL, hc, ?_⟩
  intro lambda hlambda
  rcases le_total 0 lambda with hnonneg | hnonpos
  · have hlarge : L ≤ lambda := by
      simpa [abs_of_nonneg hnonneg] using hlambda
    simpa [abs_of_nonneg hnonneg] using hbound lambda hlarge
  · by_cases hzero : lambda = 0
    · subst lambda
      norm_num at hlambda
      linarith
    · have hneg : lambda < 0 := lt_of_le_of_ne hnonpos hzero
      have hlarge : L ≤ -lambda := by
        simpa [abs_of_neg hneg] using hlambda
      have hpositive := hbound (-lambda) hlarge
      calc
        c / |lambda| ^ (n + 1) = c / (-lambda) ^ (n + 1) := by
          rw [abs_of_neg hneg]
        _ ≤ ‖smoothEndpointQuadraticIntegral (2 * n + 1) (-lambda)‖ := hpositive
        _ = ‖smoothEndpointQuadraticIntegral (2 * n + 1) lambda‖ := by
          simpa only [neg_neg] using
            (norm_smoothEndpointQuadraticIntegral_neg (2 * n + 1) (-lambda)).symm

/-- In every odd spatial dimension at least three, the outgoing BRRS
stationary endpoint amplitude inherits the sharp lower decay of its quadratic
normal form.  The statement retains the literal `2π a rho` parameter which
is later matched to the packet shell. -/
theorem exists_norm_brrsSurfaceWaveAmplitude_outgoing_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ a rho : Real,
      L ≤ |(2 * Real.pi * a) * rho| →
      c / |(2 * Real.pi * a) * rho| ^ (n + 1) ≤
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    apply surfaceMass_pos
    omega
  refine ⟨L, mass * c, hL, mul_pos hmass hc, ?_⟩
  intro a rho hlarge
  have hstationary := hbound ((2 * Real.pi * a) * rho) hlarge
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp : ‖brrsSurfaceWaveAmplitude (2 * n + 3) .outgoing a rho‖ =
      mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((2 * Real.pi * a) * rho)‖ := by
    unfold brrsSurfaceWaveAmplitude
    rw [hdim_one, hdim_two, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hmass.le]
  rw [hamp]
  calc
    mass * c / |(2 * Real.pi * a) * rho| ^ (n + 1) =
        mass * (c / |(2 * Real.pi * a) * rho| ^ (n + 1)) := by ring
    _ ≤ mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((2 * Real.pi * a) * rho)‖ :=
      mul_le_mul_of_nonneg_left hstationary hmass.le

/-- The incoming odd-dimensional endpoint has the same lower size; phase
reversal only conjugates the real endpoint integral. -/
theorem exists_norm_brrsSurfaceWaveAmplitude_incoming_odd_eventually_lower
    (n : Nat) :
    ∃ L c : Real, 1 ≤ L ∧ 0 < c ∧ ∀ a rho : Real,
      L ≤ |(2 * Real.pi * a) * rho| →
      c / |(2 * Real.pi * a) * rho| ^ (n + 1) ≤
        ‖brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho‖ := by
  obtain ⟨L, c, hL, hc, hbound⟩ :=
    exists_smoothEndpointQuadraticIntegral_odd_eventually_lower_abs n
  let mass : Real := surfaceMass (2 * n + 2)
  have hmass : 0 < mass := by
    dsimp [mass]
    apply surfaceMass_pos
    omega
  refine ⟨L, mass * c, hL, mul_pos hmass hc, ?_⟩
  intro a rho hlarge
  have hphase : |(-(2 * Real.pi * a)) * rho| = |(2 * Real.pi * a) * rho| := by
    rw [show (-(2 * Real.pi * a)) * rho = -((2 * Real.pi * a) * rho) by ring,
      abs_neg]
  have hstationary := hbound ((-(2 * Real.pi * a)) * rho) (by simpa [hphase] using hlarge)
  have hdim_one : (2 * n + 3) - 1 = 2 * n + 2 := by omega
  have hdim_two : (2 * n + 3) - 2 = 2 * n + 1 := by omega
  have hamp : ‖brrsSurfaceWaveAmplitude (2 * n + 3) .incoming a rho‖ =
      mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((-(2 * Real.pi * a)) * rho)‖ := by
    unfold brrsSurfaceWaveAmplitude
    rw [hdim_one, hdim_two, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg hmass.le]
  rw [hamp]
  calc
    mass * c / |(2 * Real.pi * a) * rho| ^ (n + 1) =
        mass * (c / |(-(2 * Real.pi * a)) * rho| ^ (n + 1)) := by
      rw [hphase]
      ring
    _ ≤ mass * ‖smoothEndpointQuadraticIntegral (2 * n + 1)
        ((-(2 * Real.pi * a)) * rho)‖ :=
      mul_le_mul_of_nonneg_left hstationary hmass.le

/-- Multiplication by the literal stationary carrier has unit modulus, so an
endpoint-amplitude lower bound is exactly a lower bound for the corresponding
isolated radial surface-wave term. -/
theorem norm_brrsSurfaceWaveTerm_eq_norm_brrsSurfaceWaveAmplitude
    (d : Nat) (part : BRRSSurfaceWavePart) (a rho : Real) :
    ‖brrsSurfaceWaveTerm d part a rho‖ = ‖brrsSurfaceWaveAmplitude d part a rho‖ := by
  unfold brrsSurfaceWaveTerm
  rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]

end Auto.Spherical.FractalDilations.BRRS


namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-! ### Polar `L^p` profiles for radial data

The stationary two-radius formula acts on the scalar restriction of a radial
input to a unit ray.  These lemmas give the exact measure-theoretic bridge
between that one-dimensional profile and the ambient Euclidean `L^p` moment.
They deliberately use `volumeIoiPow` rather than hiding the radial Jacobian
inside a change of notation. -/

/-- The nonnegative scalar restriction of a function to the ray through a
unit vector.  Its `p`-th power is the input profile that occurs in the
one-dimensional stationary estimates. -/
def brrsRadialNormProfile {d : Nat} (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) : Real → ENNReal :=
  fun r => ENNReal.ofReal ‖f (r • w)‖

/-- The `p`-moment version of `brrsRadialNormProfile`. -/
def brrsRadialLpProfile {d : Nat} (p : Real) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) : Real → ENNReal :=
  fun r => brrsRadialNormProfile f w r ^ p

/-- Measurability of the scalar radial norm profile. -/
theorem measurable_brrsRadialNormProfile {d : Nat}
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialNormProfile f w) := by
  unfold brrsRadialNormProfile
  exact (hf.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal

/-- Measurability of every real-power radial `L^p` profile. -/
theorem measurable_brrsRadialLpProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialLpProfile p f w) := by
  unfold brrsRadialLpProfile
  exact ENNReal.continuous_rpow_const.measurable.comp
    (measurable_brrsRadialNormProfile f hf w)

/-- Exact polar-coordinate formula for the `p`-moment of a measurable radial
function.  The profile may be read on any unit ray. -/
theorem brrs_lintegral_radial_norm_rpow_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) (p : Real)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖f x‖) ^ p) =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := brrsRadialLpProfile p f w
  have hF : Measurable F := measurable_brrsRadialLpProfile p f hfm w
  have hradial : ∀ x : BRRSSpace d,
      (ENNReal.ofReal ‖f x‖) ^ p = F ‖x‖ := by
    intro x
    dsimp only [F, brrsRadialLpProfile, brrsRadialNormProfile]
    rw [hf x (‖x‖ • w)]
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _), hw, mul_one]
  calc
    (∫⁻ x : BRRSSpace d, (ENNReal.ofReal ‖f x‖) ^ p) =
        ∫⁻ x : BRRSSpace d, F ‖x‖ := by
      apply lintegral_congr
      intro x
      exact hradial x
    _ = ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r in Ioi (0 : Real), ENNReal.ofReal r ^ (d - 1) * F r :=
      Auto.Spherical.SurfaceMeasureDecay.lintegral_euclidean_radial hd F hF
    _ = ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
      rw [Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1) F hF]

/-- The preceding polar identity in the `eLpNorm` normalization.  It is the
form used to turn a one-dimensional stationary estimate into a radial spatial
`L^p` estimate. -/
theorem brrs_eLpNorm_rpow_radial_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real), brrsRadialLpProfile p f w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  rw [← Auto.LpSpaceFacts.lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp f]
  exact brrs_lintegral_radial_norm_rpow_eq_polar hd f hf hfm p w hw

/-- A Schwartz radial datum has the polar `L^p` identity without a separate
measurability hypothesis. -/
theorem brrs_eLpNorm_rpow_radial_schwartz_eq_polar
    {d : Nat} (hd : 0 < d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real),
          brrsRadialLpProfile p (f : BRRSSpace d → Complex) w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  exact brrs_eLpNorm_rpow_radial_eq_polar hd (f : BRRSSpace d → Complex) hf
    f.continuous.measurable hp w hw

/-- The polar-coordinate identity applies directly to the literal dyadic
half-wave of a radial Schwartz datum.  The only extra point here is
measurability: the Fourier formula agrees pointwise with convolution by the
Schwartz half-wave kernel, which is continuous on the integrable Schwartz
input.  This is the output-side bridge used when a one-dimensional radial
estimate is converted back to the spatial `L^p` moment. -/
theorem brrs_eLpNorm_rpow_brrsDyadicHalfWave_radial_eq_polar
    {d : Nat} (hd : 0 < d) (Phi : BRRSAnnularCutoff) (j : Nat) (t : Real)
    (f : BRRSSchwartz d) (hf : IsRadial (f : BRRSSpace d → Complex))
    {p : Real} (hp : 0 < p) (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (brrsDyadicHalfWave Phi j t f) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ r : Ioi (0 : Real),
          brrsRadialLpProfile p (brrsDyadicHalfWave Phi j t f) w r.1
          ∂Measure.volumeIoiPow (d - 1) := by
  refine brrs_eLpNorm_rpow_radial_eq_polar hd
    (brrsDyadicHalfWave Phi j t f)
    (brrsDyadicHalfWave_isRadial Phi j t f hf) ?_ hp w hw
  let g : BRRSSchwartz d := SchwartzMap.smulLeftCLM Complex
    (brrsDyadicHalfWaveSchwartzSymbol Phi j t : BRRSSpace d → Complex) (𝓕 f)
  let q : BRRSSchwartz d := 𝓕⁻ g
  have hg : (g : BRRSSpace d → Complex) = fun xi : BRRSSpace d =>
      brrsDyadicHalfWaveSchwartzSymbol Phi j t xi *
        𝓕 (f : BRRSSpace d → Complex) xi := by
    funext xi
    simp only [g, SchwartzMap.smulLeftCLM_apply
      (brrsDyadicHalfWaveSchwartzSymbol Phi j t).hasTemperateGrowth, smul_eq_mul]
    rw [SchwartzMap.fourier_coe]
  have hq : (q : BRRSSpace d → Complex) = brrsDyadicHalfWave Phi j t f := by
    funext x
    dsimp [q]
    rw [SchwartzMap.fourierInv_coe, brrsDyadicHalfWave, hg]
    simp only [brrsDyadicHalfWaveSchwartzSymbol_apply,
      brrsDyadicHalfWaveSymbol]
  rw [← hq]
  exact q.continuous.measurable

/-- The one-dimensional source profile whose ordinary Lebesgue `L^p` moment
is exactly the polar radial `L^p` moment.  This is the normalization used
when the two-radius stationary kernel is reduced to the Section 5
convolution estimates: the factor `s^((d - 1) / p)` absorbs the polar
Jacobian into the input rather than into the kernel. -/
noncomputable def brrsRadialLpSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : Real → ENNReal :=
  fun s => (ENNReal.ofReal s) ^ (((d : Real) - 1) / p) *
    ENNReal.ofReal ‖f (s • w)‖

/-- Measurability of the weighted one-dimensional radial source profile. -/
theorem measurable_brrsRadialLpSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialLpSourceProfile p f w) := by
  unfold brrsRadialLpSourceProfile
  apply Measurable.mul
  · exact ENNReal.continuous_rpow_const.measurable.comp
      ENNReal.continuous_ofReal.measurable
  · exact (hf.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal

/-- Taking the `p`-th power of the weighted source profile restores the
literal polar density.  The identity is pointwise on the positive radial
half-line and does not use radiality of the input. -/
theorem brrsRadialLpSourceProfile_rpow_eq_polarDensity
    {d : Nat} (hd : 1 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) {s : Real} (hs : 0 < s) :
    (brrsRadialLpSourceProfile p f w s) ^ p =
      ENNReal.ofReal s ^ (d - 1) *
        (ENNReal.ofReal ‖f (s • w)‖) ^ p := by
  have hcast : (d : Real) - 1 = ((d - 1 : Nat) : Real) := by
    norm_num [Nat.cast_sub hd]
  have hpower : (((d : Real) - 1) / p) * p = (d : Real) - 1 := by
    field_simp [hp.ne']
  unfold brrsRadialLpSourceProfile
  rw [ENNReal.mul_rpow_of_nonneg _ _ hp.le, ← ENNReal.rpow_mul, hpower,
    hcast, ← ENNReal.rpow_natCast]

/-- The `p`-moment of the one-dimensional weighted source profile is the
same polar moment appearing in the radial `L^p` formula. -/
theorem brrs_lintegral_radialLpSourceProfile_rpow_eq_polar
    {d : Nat} (hd : 1 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p) =
      ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
        ∂Measure.volumeIoiPow (d - 1) := by
  rw [Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
    (brrsRadialLpProfile p f w) (measurable_brrsRadialLpProfile p f hfm w)]
  apply setLIntegral_congr_fun measurableSet_Ioi
  intro s hs
  change (brrsRadialLpSourceProfile p f w s) ^ p =
    ENNReal.ofReal s ^ (d - 1) * brrsRadialLpProfile p f w s
  rw [brrsRadialLpSourceProfile_rpow_eq_polarDensity hd hp f w hs]
  rfl

/-- In dimensions at least two the weighted source profile vanishes on the
nonpositive half-line.  Thus its ordinary one-dimensional `L^p` moment is
literally the positive-ray polar moment, so it can be passed directly to the
Section 5 convolution lemmas (which integrate over all of `ℝ`). -/
theorem brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
    {d : Nat} (hd : 2 ≤ d) {p : Real} (hp : 0 < p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p) =
      ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
        ∂Measure.volumeIoiPow (d - 1) := by
  have hdreal : 0 < (d : Real) - 1 := by
    have hd' : (2 : Real) ≤ d := by exact_mod_cast hd
    linarith
  have hsourcePower : 0 < ((d : Real) - 1) / p := div_pos hdreal hp
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      (brrsRadialLpSourceProfile p f w s) ^ p = 0 := by
    intro s hs
    have hs0 : s ≤ 0 := le_of_not_gt hs
    have hzero : ENNReal.ofReal s = 0 := ENNReal.ofReal_eq_zero.mpr hs0
    simp [brrsRadialLpSourceProfile, hzero,
      ENNReal.zero_rpow_of_pos hsourcePower, ENNReal.zero_rpow_of_pos hp]
  calc
    (∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p) =
        ∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi
        (fun s : Real => (brrsRadialLpSourceProfile p f w s) ^ p) hsupport
    _ = ∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p := rfl
    _ = ∫⁻ s : Ioi (0 : Real), brrsRadialLpProfile p f w s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      brrs_lintegral_radialLpSourceProfile_rpow_eq_polar (by omega) hp f hfm w

/-- Combining the weighted source-profile identity with polar coordinates
expresses a radial Euclidean `L^p` norm as an ordinary one-dimensional
positive-ray moment. -/
theorem brrs_eLpNorm_rpow_radial_eq_sourceProfile
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s in Ioi (0 : Real), (brrsRadialLpSourceProfile p f w s) ^ p := by
  rw [brrs_eLpNorm_rpow_radial_eq_polar hd f hf hfm hp w hw]
  rw [← brrs_lintegral_radialLpSourceProfile_rpow_eq_polar hd hp f hfm w]

/-- The ambient radial `L^p` norm also equals the full-line source-profile
moment in dimensions at least two. -/
theorem brrs_eLpNorm_rpow_radial_eq_sourceProfile_full
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hf : IsRadial f) (hfm : Measurable f) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm f (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s : Real, (brrsRadialLpSourceProfile p f w s) ^ p := by
  have hIoi := brrs_lintegral_radialLpSourceProfile_rpow_eq_polar
    (d := d) (by omega) hp f hfm w
  have hfull := brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
    (d := d) hd hp f hfm w
  rw [brrs_eLpNorm_rpow_radial_eq_sourceProfile (by omega) f hf hfm hp w hw]
  exact congrArg (fun z : ENNReal => ENNReal.ofReal (surfaceMass d) * z)
    (hIoi.trans hfull.symm)

/-- Schwartz radial data satisfy the same source-profile normalization without
an additional measurability hypothesis. -/
theorem brrs_eLpNorm_rpow_radial_schwartz_eq_sourceProfile
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) {p : Real} (hp : 0 < p)
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    (eLpNorm (f : BRRSSpace d → Complex) (ENNReal.ofReal p) volume) ^ p =
      ENNReal.ofReal (surfaceMass d) *
        ∫⁻ s in Ioi (0 : Real),
          (brrsRadialLpSourceProfile p (f : BRRSSpace d → Complex) w s) ^ p := by
  exact brrs_eLpNorm_rpow_radial_eq_sourceProfile hd
    (f : BRRSSpace d → Complex) hf f.continuous.measurable hp w hw

/-! ### Initial-cell localization for scaled cubic profiles

The `I₀` overlap argument needs a local-time profile, rather than merely a
global convolution bound.  The following elementary package supplies that
missing geometric step for the cubic Japanese profile at the dyadic scale.
It is deliberately independent of the half-wave: an analytic stationary
estimate can feed its scalar majorant into this result without reopening the
bounded-overlap bookkeeping.
-/

/-- The cubic profile convolved at physical scale `q⁻¹`.  We do not
normalize the kernel here: the compensating factor `q` occurs in the local
profile below, so its global mass remains scale-free. -/
noncomputable def brrsI0ScaledCubicConvolution
    (q : Real) (g : Real → ENNReal) : Real → ENNReal :=
  fun x => ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s

/-- Measurability of the scaled cubic profile convolution. -/
theorem measurable_brrsI0ScaledCubicConvolution
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (brrsI0ScaledCubicConvolution q g) := by
  unfold brrsI0ScaledCubicConvolution
  apply Measurable.lintegral_prod_right
  change Measurable (fun z : Real × Real =>
    brrsCubicJapaneseProfile (q * (z.1 - z.2)) * g z.2)
  exact (measurable_brrsCubicJapaneseProfile.comp
    (measurable_const.mul (measurable_fst.sub measurable_snd))).mul
      (hg.comp measurable_snd)

/-- At exponent one, the full-line source profile is the literal polar
density on the positive ray.  This makes the compact radial block compatible
with the cubic convolution API without discarding its radial Jacobian. -/
theorem brrsRadialLpSourceProfile_one_eq_polarDensity
    {d : Nat} (hd : 1 ≤ d) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) {s : Real} (hs : 0 < s) :
    brrsRadialLpSourceProfile (d := d) 1 f w s =
      ENNReal.ofReal s ^ (d - 1) * ENNReal.ofReal ‖f (s • w)‖ := by
  simpa using
    (brrsRadialLpSourceProfile_rpow_eq_polarDensity hd (p := (1 : Real))
      (by norm_num) f w hs)

/-- In dimensions at least two, the exponent-one source profile is supported
on the positive radius ray. -/
theorem brrsRadialLpSourceProfile_one_eq_zero_of_nonpos
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (w : BRRSSpace d) {s : Real} (hs : s ≤ 0) :
    brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
  have hdreal : 0 < (d : Real) - 1 := by
    have hd' : (2 : Real) ≤ d := by exact_mod_cast hd
    linarith
  have hpower : 0 < ((d : Real) - 1) / (1 : Real) :=
    div_pos hdreal (by norm_num)
  have hzero : ENNReal.ofReal s = 0 := ENNReal.ofReal_eq_zero.mpr hs
  unfold brrsRadialLpSourceProfile
  rw [hzero, ENNReal.zero_rpow_of_pos hpower, zero_mul]

/-- The cubic convolution of the exponent-one radial source profile is
exactly the polar source integral with the corresponding translated cubic
phase profile.  This is the source-variable conversion required by the
compact `I₀` all-nine estimate. -/
theorem brrsI0ScaledCubicConvolution_sourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsRadialLpSourceProfile (d := d) 1 f w) t =
      ∫⁻ s : Ioi (0 : Real),
        brrsCubicJapaneseProfile (q * (t - s.1)) *
          ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := fun s =>
    brrsCubicJapaneseProfile (q * (t - s)) *
      ENNReal.ofReal ‖f (s • w)‖
  have hF : Measurable F := by
    dsimp [F]
    exact (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul
        ((hfm.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal)
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      brrsCubicJapaneseProfile (q * (t - s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
    intro s hs
    rw [brrsRadialLpSourceProfile_one_eq_zero_of_nonpos hd f w
      (le_of_not_gt hs)]
    simp
  unfold brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t - s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s) =
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi _ hsupport
    _ = ∫⁻ s in Ioi (0 : Real), brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s := rfl
    _ = ∫⁻ s in Ioi (0 : Real), ENNReal.ofReal s ^ (d - 1) * F s := by
      apply setLIntegral_congr_fun measurableSet_Ioi
      intro s hs
      change brrsCubicJapaneseProfile (q * (t - s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s =
        ENNReal.ofReal s ^ (d - 1) *
          (brrsCubicJapaneseProfile (q * (t - s)) *
            ENNReal.ofReal ‖f (s • w)‖)
      rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega) f w hs]
      ac_rfl
    _ = ∫⁻ s : Ioi (0 : Real), F s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      (Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
        F hF).symm

/-- Reflecting the source profile changes the translated cubic kernel from
`t - s` to `t + s`; this is the incoming-wave bookkeeping identity in the
same scaled-convolution notation. -/
theorem brrsI0ScaledCubicConvolution_reflect_eq_plus
    (q t : Real) (g : Real → ENNReal) :
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g) t =
      ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) * g s := by
  change brrsOneDimProfileConvolution
      (fun u : Real => brrsCubicJapaneseProfile (q * u))
      (brrsReflectProfile g) t =
    brrsOneDimProfileConvolutionPlus
      (fun u : Real => brrsCubicJapaneseProfile (q * u)) g t
  exact (brrsOneDimProfileConvolutionPlus_eq_reflect
    (fun u : Real => brrsCubicJapaneseProfile (q * u)) g t).symm

/-- The reflected exponent-one cubic convolution is the actual polar source
integral for the `t + s` phase. -/
theorem brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsReflectProfile (brrsRadialLpSourceProfile (d := d) 1 f w)) t =
      ∫⁻ s : Ioi (0 : Real),
        brrsCubicJapaneseProfile (q * (t + s.1)) *
          ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  let F : Real → ENNReal := fun s =>
    brrsCubicJapaneseProfile (q * (t + s)) *
      ENNReal.ofReal ‖f (s • w)‖
  have hF : Measurable F := by
    dsimp [F]
    exact (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.add measurable_id))).mul
        ((hfm.comp (continuous_id.smul continuous_const).measurable).norm.ennreal_ofReal)
  have hsupport : ∀ s : Real, s ∉ Ioi (0 : Real) →
      brrsCubicJapaneseProfile (q * (t + s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s = 0 := by
    intro s hs
    rw [brrsRadialLpSourceProfile_one_eq_zero_of_nonpos hd f w
      (le_of_not_gt hs)]
    simp
  rw [brrsI0ScaledCubicConvolution_reflect_eq_plus]
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) *
        brrsRadialLpSourceProfile (d := d) 1 f w s) =
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s
          ∂volume.restrict (Ioi (0 : Real)) :=
      Auto.Spherical.PowerWeights.lintegral_eq_lintegral_restrict_of_support
        (Ioi (0 : Real)) measurableSet_Ioi _ hsupport
    _ = ∫⁻ s in Ioi (0 : Real), brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s := rfl
    _ = ∫⁻ s in Ioi (0 : Real), ENNReal.ofReal s ^ (d - 1) * F s := by
      apply setLIntegral_congr_fun measurableSet_Ioi
      intro s hs
      change brrsCubicJapaneseProfile (q * (t + s)) *
          brrsRadialLpSourceProfile (d := d) 1 f w s =
        ENNReal.ofReal s ^ (d - 1) *
          (brrsCubicJapaneseProfile (q * (t + s)) *
            ENNReal.ofReal ‖f (s • w)‖)
      rw [brrsRadialLpSourceProfile_one_eq_polarDensity (by omega) f w hs]
      ac_rfl
    _ = ∫⁻ s : Ioi (0 : Real), F s.1
          ∂Measure.volumeIoiPow (d - 1) :=
      (Auto.Spherical.SurfaceMeasureDecay.lintegral_volumeIoiPow (d - 1)
        F hF).symm

/-- The mass of the exponent-one source profile is precisely the polar
radial `L¹` source mass. -/
theorem brrs_lintegral_radialLpSourceProfile_one_eq_polar
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSpace d → Complex)
    (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1 f w s) =
      ∫⁻ s : Ioi (0 : Real), ENNReal.ofReal ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1) := by
  simpa only [ENNReal.rpow_one, brrsRadialLpProfile,
    brrsRadialNormProfile] using
    (brrs_lintegral_radialLpSourceProfile_rpow_eq_polar_full
      (d := d) hd (p := (1 : Real)) (by norm_num) f hfm w)

/-- Moving the cubic Japanese profile by at most one unit costs at most a
factor eight.  This is the quantitative fact that turns a point value at a
sample time into mass on one dyadic time cell. -/
theorem brrsCubicJapaneseProfile_shift_le_eight
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsCubicJapaneseProfile u ≤
      8 * brrsCubicJapaneseProfile (u + delta) := by
  have hdenom : 1 + |u + delta| ≤ 2 * (1 + |u|) := by
    calc
      1 + |u + delta| ≤ 1 + (|u| + |delta|) := by
        gcongr
        exact abs_add_le _ _
      _ ≤ 1 + (|u| + 1) := by gcongr
      _ ≤ 2 * (1 + |u|) := by nlinarith [abs_nonneg u]
  have hinv : (2 * (1 + |u|))⁻¹ ≤ (1 + |u + delta|)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 2 * (1 + |u|))
      (by positivity : 0 < 1 + |u + delta|)).mpr
    exact hdenom
  have hpow : ((1 + |u|)⁻¹) ^ 3 ≤
      8 * ((1 + |u + delta|)⁻¹) ^ 3 := by
    calc
      ((1 + |u|)⁻¹) ^ 3 =
          (2 : Real) ^ 3 * ((2 * (1 + |u|))⁻¹) ^ 3 := by
        field_simp
      _ ≤ (2 : Real) ^ 3 * ((1 + |u + delta|)⁻¹) ^ 3 := by
        exact mul_le_mul_of_nonneg_left
          (pow_le_pow_left₀ (by positivity) hinv _) (by positivity)
      _ = 8 * ((1 + |u + delta|)⁻¹) ^ 3 := by norm_num
  unfold brrsCubicJapaneseProfile
  calc
    ENNReal.ofReal ((1 + |u|)⁻¹ ^ 3) ≤
        ENNReal.ofReal (8 * ((1 + |u + delta|)⁻¹) ^ 3) :=
      ENNReal.ofReal_le_ofReal hpow
    _ = 8 * ENNReal.ofReal ((1 + |u + delta|)⁻¹ ^ 3) := by
      rw [ENNReal.ofReal_mul (p := (8 : Real))
        (q := ((1 + |u + delta|)⁻¹) ^ 3) (by norm_num)]
      norm_num

/-- Real-valued notation for the cubic Japanese profile.  The stationary
kernel estimates are real inequalities, whereas the overlap/Young package is
in `ENNReal`; keeping this companion notation makes the bridge explicit. -/
def brrsCubicJapaneseRealProfile (u : Real) : Real :=
  ((1 + |u|)⁻¹) ^ 3

/-- Measurability of the real-valued cubic Japanese profile. -/
theorem measurable_brrsCubicJapaneseRealProfile :
    Measurable brrsCubicJapaneseRealProfile := by
  unfold brrsCubicJapaneseRealProfile
  fun_prop

theorem brrsCubicJapaneseRealProfile_nonneg (u : Real) :
    0 ≤ brrsCubicJapaneseRealProfile u := by
  unfold brrsCubicJapaneseRealProfile
  positivity

/-- The cubic Japanese profile is bounded by one. -/
theorem brrsCubicJapaneseRealProfile_le_one (u : Real) :
    brrsCubicJapaneseRealProfile u ≤ 1 := by
  unfold brrsCubicJapaneseRealProfile
  apply pow_le_one₀ (by positivity)
  apply (inv_le_one₀ (by positivity : 0 < 1 + |u|)).mpr
  linarith [abs_nonneg u]

/-- Multiplication by any measurable cubic Japanese profile preserves the
polar integrability of a radial Schwartz trace. -/
theorem integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
    {d : Nat} (hd : 0 < d) (U : Ioi (0 : Real) → Real)
    (hU : Measurable U) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex))
    (w : BRRSSpace d) (hw : ‖w‖ = 1) :
    Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (U s) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) := by
  have hinput : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow hd f hf w hw
  have hprofile : Measurable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (U s)) :=
    measurable_brrsCubicJapaneseRealProfile.comp hU
  refine (hinput.norm.const_mul (1 : Real)).mono'
    (hprofile.aestronglyMeasurable.mul hinput.norm.aestronglyMeasurable) ?_
  filter_upwards with s
  rw [Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg
      (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  simpa only [one_mul] using mul_le_mul_of_nonneg_right
    (brrsCubicJapaneseRealProfile_le_one (U s)) (norm_nonneg _)

/-- Converting the negative-source cubic polar integral to `ENNReal` gives
exactly the scaled source-profile convolution. -/
theorem brrsI0ScaledCubicConvolution_sourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsRadialLpSourceProfile (d := d) 1
          (f : BRRSSpace d → Complex) w) t =
      ENNReal.ofReal (∫ s : Ioi (0 : Real),
        brrsCubicJapaneseRealProfile (q * (t - s.1)) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (q * (t - s.1)) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t - s.1)) (by fun_prop)
        f hf w hw
  rw [brrsI0ScaledCubicConvolution_sourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w q t,
    ofReal_integral_eq_lintegral_ofReal hI
      (Filter.Eventually.of_forall fun s =>
        mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  apply lintegral_congr
  intro s
  rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
  unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
  rfl

/-- The positive-source cubic polar integral is the reflected scaled source
convolution after conversion to `ENNReal`. -/
theorem brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) (q t : Real) :
    brrsI0ScaledCubicConvolution q
        (brrsReflectProfile (brrsRadialLpSourceProfile (d := d) 1
          (f : BRRSSpace d → Complex) w)) t =
      ENNReal.ofReal (∫ s : Ioi (0 : Real),
        brrsCubicJapaneseRealProfile (q * (t + s.1)) *
          ‖f (s.1 • w)‖ ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) =>
      brrsCubicJapaneseRealProfile (q * (t + s.1)) * ‖f (s.1 • w)‖)
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrsCubicJapaneseRealProfile_comp_mul_radialNorm
      (by omega) (fun s : Ioi (0 : Real) => q * (t + s.1)) (by fun_prop)
        f hf w hw
  rw [brrsI0ScaledCubicConvolution_reflect_sourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w q t,
    ofReal_integral_eq_lintegral_ofReal hI
      (Filter.Eventually.of_forall fun s =>
        mul_nonneg (brrsCubicJapaneseRealProfile_nonneg _) (norm_nonneg _))]
  apply lintegral_congr
  intro s
  rw [ENNReal.ofReal_mul (brrsCubicJapaneseRealProfile_nonneg _)]
  unfold brrsCubicJapaneseProfile brrsCubicJapaneseRealProfile
  rfl

/-- The total exponent-one source mass is the `ENNReal` conversion of the
literal polar radial source integral. -/
theorem brrs_lintegral_radialLpSourceProfile_one_eq_ofReal_integral
    {d : Nat} (hd : 2 ≤ d) (f : BRRSSchwartz d)
    (hf : IsRadial (f : BRRSSpace d → Complex)) (w : BRRSSpace d)
    (hw : ‖w‖ = 1) :
    (∫⁻ s : Real, brrsRadialLpSourceProfile (d := d) 1
      (f : BRRSSpace d → Complex) w s) =
      ENNReal.ofReal (∫ s : Ioi (0 : Real), ‖f (s.1 • w)‖
        ∂Measure.volumeIoiPow (d - 1)) := by
  have hI : Integrable (fun s : Ioi (0 : Real) => f (s.1 • w))
      (Measure.volumeIoiPow (d - 1)) :=
    integrable_brrs_radial_profile_volumeIoiPow (by omega) f hf w hw
  rw [brrs_lintegral_radialLpSourceProfile_one_eq_polar hd
    (f : BRRSSpace d → Complex) f.continuous.measurable w,
    ofReal_integral_eq_lintegral_ofReal hI.norm
      (Filter.Eventually.of_forall fun s => norm_nonneg _)]

theorem brrsCubicJapaneseRealProfile_shift_le_eight
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsCubicJapaneseRealProfile (u + delta) ≤
      8 * brrsCubicJapaneseRealProfile u := by
  have hdenom : 1 + |u| ≤ 2 * (1 + |u + delta|) := by
    calc
      1 + |u| = 1 + |(u + delta) + (-delta)| := by ring_nf
      _ ≤ 1 + (|u + delta| + |-delta|) := by
        gcongr
        exact abs_add_le _ _
      _ = 1 + (|u + delta| + |delta|) := by rw [abs_neg]
      _ ≤ 1 + (|u + delta| + 1) := by gcongr
      _ ≤ 2 * (1 + |u + delta|) := by nlinarith [abs_nonneg (u + delta)]
  have hinv : (2 * (1 + |u + delta|))⁻¹ ≤ (1 + |u|)⁻¹ := by
    apply (inv_le_inv₀ (by positivity : 0 < 2 * (1 + |u + delta|))
      (by positivity : 0 < 1 + |u|)).mpr
    exact hdenom
  unfold brrsCubicJapaneseRealProfile
  calc
    ((1 + |u + delta|)⁻¹) ^ 3 =
        (2 : Real) ^ 3 * ((2 * (1 + |u + delta|))⁻¹) ^ 3 := by
      field_simp
    _ ≤ (2 : Real) ^ 3 * ((1 + |u|)⁻¹) ^ 3 := by
      exact mul_le_mul_of_nonneg_left
        (pow_le_pow_left₀ (by positivity) hinv _) (by positivity)
    _ = 8 * ((1 + |u|)⁻¹) ^ 3 := by norm_num

/-- Cubic stationary decay is stable under a unit-scale displacement of its
phase.  This is the form needed for the output radius `q r ≤ 1` in the
initial radial block. -/
theorem brrsStationaryRapidProfile_three_twoPi_smallShift_le
    (u delta : Real) (hdelta : |delta| ≤ 1) :
    brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
      64 * brrsCubicJapaneseRealProfile u := by
  have hrapid := brrsStationaryRapidProfile_twoPi_phase_le_rpowJapanese 3
    (u + delta)
  have hshift := brrsCubicJapaneseRealProfile_shift_le_eight u delta hdelta
  unfold brrsCubicJapaneseRealProfile at hshift ⊢
  have hrapid' :
      brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
        8 * ((1 + |u + delta|) ^ (-3 : Real)) := by
    calc
      brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
          (2 : Real) ^ (3 : Real) *
            (1 + |u + delta|) ^ (-(3 : Real)) := hrapid
      _ = 8 * ((1 + |u + delta|) ^ (-3 : Real)) := by
        norm_num [Real.rpow_natCast]
  have hphase : (1 + |u + delta|) ^ (-3 : Real) =
      ((1 + |u + delta|)⁻¹) ^ 3 := by
    calc
      (1 + |u + delta|) ^ (-3 : Real) =
          (1 + |u + delta|) ^ (-(3 : Real)) := by norm_num
      _ = ((1 + |u + delta|)⁻¹) ^ (3 : Real) :=
        Real.rpow_neg_eq_inv_rpow _ _
      _ = ((1 + |u + delta|)⁻¹) ^ (3 : Nat) := by
        norm_num [Real.rpow_natCast]
  calc
    brrsStationaryRapidProfile 3 (2 * Real.pi * (u + delta)) ≤
        8 * ((1 + |u + delta|) ^ (-3 : Real)) := hrapid'
    _ = 8 * ((1 + |u + delta|)⁻¹) ^ 3 := by rw [hphase]
    _ ≤ 8 * (8 * ((1 + |u|)⁻¹) ^ 3) :=
      mul_le_mul_of_nonneg_left hshift (by positivity)
    _ = 64 * ((1 + |u|)⁻¹) ^ 3 := by ring

/-- A scaled cubic convolution is locally stable on one mesh interval. -/
theorem brrsI0ScaledCubicConvolution_le_eight_shift
    (q x y : Real) {g : Real → ENNReal} (hg : Measurable g)
    (hxy : |q * (y - x)| ≤ 1) :
    brrsI0ScaledCubicConvolution q g x ≤
      8 * brrsI0ScaledCubicConvolution q g y := by
  have hmeas : Measurable (fun s : Real =>
      brrsCubicJapaneseProfile (q * (y - s)) * g s) :=
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul hg
  unfold brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s) ≤
        ∫⁻ s : Real,
          (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s := by
      apply lintegral_mono
      intro s
      have hphase : q * (y - s) = q * (x - s) + q * (y - x) := by ring
      change brrsCubicJapaneseProfile (q * (x - s)) * g s ≤
        (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s
      rw [hphase]
      have hshift := brrsCubicJapaneseProfile_shift_le_eight
        (q * (x - s)) (q * (y - x)) hxy
      simpa only [mul_assoc, mul_left_comm, mul_comm] using
        (mul_le_mul_left hshift (g s))
    _ = 8 * ∫⁻ s : Real,
        brrsCubicJapaneseProfile (q * (y - s)) * g s := by
      rw [show (fun s : Real =>
          (8 * brrsCubicJapaneseProfile (q * (y - s))) * g s) =
          fun s => 8 * (brrsCubicJapaneseProfile (q * (y - s)) * g s) by
            funext s; ring]
      exact lintegral_const_mul 8 hmeas

/-- The source-independent middle stationary phase produces this cubic tail:
its coefficient is the total radial source mass, while its time profile is
still localized at the dyadic scale. -/
noncomputable def brrsI0CubicTailProfile
    (q : Real) (M : ENNReal) : Real → ENNReal :=
  fun x => brrsCubicJapaneseProfile (q * x) * M

/-- Measurability of the middle cubic tail. -/
theorem measurable_brrsI0CubicTailProfile (q : Real) (M : ENNReal) :
    Measurable (brrsI0CubicTailProfile q M) := by
  unfold brrsI0CubicTailProfile
  exact (measurable_brrsCubicJapaneseProfile.comp
    (measurable_const.mul measurable_id)).mul measurable_const

/-- The middle cubic tail has the same unit-scale translation stability as a
source convolution. -/
theorem brrsI0CubicTailProfile_le_eight_shift
    (q x y : Real) (M : ENNReal) (hxy : |q * (y - x)| ≤ 1) :
    brrsI0CubicTailProfile q M x ≤ 8 * brrsI0CubicTailProfile q M y := by
  unfold brrsI0CubicTailProfile
  have hphase : q * y = q * x + q * (y - x) := by ring
  rw [hphase]
  have hshift := brrsCubicJapaneseProfile_shift_le_eight
    (q * x) (q * (y - x)) hxy
  simpa only [mul_assoc, mul_left_comm, mul_comm] using
    (mul_le_mul_left hshift M)

/-- The local time cell contains the forward mesh interval used to average a
scaled cubic convolution. -/
theorem brrsI0_forwardMeshInterval_subset_timeCell
    {q t : Real} (hq : 0 < q) :
    Icc t (t + q⁻¹) ⊆ brrsI0TimeCell q⁻¹ t := by
  intro x hx
  simp only [brrsI0TimeCell, mem_Icc] at hx ⊢
  have hqinv : 0 < q⁻¹ := inv_pos.mpr hq
  constructor <;> linarith

/-- A point value of the scaled cubic convolution is bounded by the integral
of a scale-normalized local profile over its `I₀` time cell.  The right-hand
profile has a scale-free global `L¹` size, because the prefactor `q` exactly
cancels the width `q⁻¹` of the unnormalized convolution kernel. -/
theorem brrsI0ScaledCubicConvolution_le_local_profile
    {q t : Real} (hq : 0 < q) {g : Real → ENNReal} (hg : Measurable g) :
    brrsI0ScaledCubicConvolution q g t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ScaledCubicConvolution q g x := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  have hF : Measurable F := measurable_brrsI0ScaledCubicConvolution q hg
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ≤ 8 * F x := by
    apply brrsI0ScaledCubicConvolution_le_eight_shift q t x hg
    dsimp only [J] at hx
    rw [abs_of_nonneg]
    · have hleft : t ≤ x := hx.1
      have hright : x ≤ t + q⁻¹ := hx.2
      have hqnonneg : 0 ≤ q := hq.le
      have hdiff : 0 ≤ x - t := by linarith
      rw [mul_sub]
      have hqx : q * (x - t) ≤ q * q⁻¹ :=
        mul_le_mul_of_nonneg_left (by linarith) hqnonneg
      rw [mul_inv_cancel₀ hq.ne'] at hqx
      linarith
    · exact mul_nonneg hq.le (by linarith [hx.1])
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ≤
        ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ≤ (ENNReal.ofReal q) * (8 * F x) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = (8 * ENNReal.ofReal q) * F x := by ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t) = F t := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t := by ring
      _ = F t := by rw [hqmul, one_mul]
  calc
    F t = ∫⁻ x in J, (ENNReal.ofReal q) * F t := hconst.symm
    _ ≤ ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * F x :=
      lintegral_mono_set hsub

/-- The source-independent middle cubic tail obeys the same local-time
profile estimate as the translated source convolutions. -/
theorem brrsI0CubicTailProfile_le_local_profile
    {q t : Real} (hq : 0 < q) (M : ENNReal) :
    brrsI0CubicTailProfile q M t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0CubicTailProfile q M x := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0CubicTailProfile q M
  have hF : Measurable F := measurable_brrsI0CubicTailProfile q M
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ≤ 8 * F x := by
    apply brrsI0CubicTailProfile_le_eight_shift q t x M
    dsimp only [J] at hx
    rw [abs_of_nonneg]
    · have hleft : t ≤ x := hx.1
      have hright : x ≤ t + q⁻¹ := hx.2
      have hqnonneg : 0 ≤ q := hq.le
      have hdiff : 0 ≤ x - t := by linarith
      rw [mul_sub]
      have hqx : q * (x - t) ≤ q * q⁻¹ :=
        mul_le_mul_of_nonneg_left (by linarith) hqnonneg
      rw [mul_inv_cancel₀ hq.ne'] at hqx
      linarith
    · exact mul_nonneg hq.le (by linarith [hx.1])
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ≤
        ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ≤ (ENNReal.ofReal q) * (8 * F x) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = (8 * ENNReal.ofReal q) * F x := by ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t) = F t := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t := by ring
      _ = F t := by rw [hqmul, one_mul]
  calc
    F t = ∫⁻ x in J, (ENNReal.ofReal q) * F t := hconst.symm
    _ ≤ ∫⁻ x in J, (8 * ENNReal.ofReal q) * F x := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * F x :=
      lintegral_mono_set hsub

/-- The sum of the two source convolutions and the middle cubic tail is a
single valid `I₀` local profile.  Hence it can be passed verbatim to the
bounded-overlap lemma for a dyadic time discretization. -/
noncomputable def brrsI0ThreeCubicProfile
    (q : Real) (g : Real → ENNReal) (M : ENNReal) : Real → ENNReal :=
  fun x => (brrsI0ScaledCubicConvolution q g x +
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g) x) +
      brrsI0CubicTailProfile q M x

/-- Measurability of the complete three-phase compact-cell profile. -/
theorem measurable_brrsI0ThreeCubicProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal) :
    Measurable (brrsI0ThreeCubicProfile q g M) := by
  unfold brrsI0ThreeCubicProfile
  exact ((measurable_brrsI0ScaledCubicConvolution q hg).add
    (measurable_brrsI0ScaledCubicConvolution q
      (measurable_brrsReflectProfile hg))).add
        (measurable_brrsI0CubicTailProfile q M)

/-- On a unit scaled time displacement, each of the three compact-cell
profiles varies by at most the universal cubic factor `8`. -/
theorem brrsI0ThreeCubicProfile_le_eight_shift
    (q x y : Real) {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal)
    (hxy : |q * (y - x)| ≤ 1) :
    brrsI0ThreeCubicProfile q g M x ≤
      8 * brrsI0ThreeCubicProfile q g M y := by
  have hminus := brrsI0ScaledCubicConvolution_le_eight_shift q x y hg hxy
  have hplus := brrsI0ScaledCubicConvolution_le_eight_shift q x y
    (measurable_brrsReflectProfile hg) hxy
  have hmiddle := brrsI0CubicTailProfile_le_eight_shift q x y M hxy
  unfold brrsI0ThreeCubicProfile
  calc
    (brrsI0ScaledCubicConvolution q g x +
        brrsI0ScaledCubicConvolution q (brrsReflectProfile g) x) +
          brrsI0CubicTailProfile q M x ≤
        (8 * brrsI0ScaledCubicConvolution q g y +
          8 * brrsI0ScaledCubicConvolution q (brrsReflectProfile g) y) +
            8 * brrsI0CubicTailProfile q M y := by
      gcongr
    _ = 8 * ((brrsI0ScaledCubicConvolution q g y +
        brrsI0ScaledCubicConvolution q (brrsReflectProfile g) y) +
          brrsI0CubicTailProfile q M y) := by ring

/-- The `p`-th power of the complete compact-cell profile has the same
bounded-overlap local control.  This is deliberately stated for all
nonnegative real powers, so it can be used at the BRRS low-`p` exponents. -/
theorem brrsI0ThreeCubicProfile_rpow_le_local_profile
    {q t p : Real} (hq : 0 < q) (hp : 0 ≤ p)
    {g : Real → ENNReal} (hg : Measurable g) (M : ENNReal) :
    (brrsI0ThreeCubicProfile q g M t) ^ p ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        ((8 : ENNReal) ^ p * ENNReal.ofReal q) *
          (brrsI0ThreeCubicProfile q g M x) ^ p := by
  let J : Set Real := Icc t (t + q⁻¹)
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hJ : MeasurableSet J := measurableSet_Icc
  have hsub : J ⊆ brrsI0TimeCell q⁻¹ t :=
    brrsI0_forwardMeshInterval_subset_timeCell hq
  have hpoint (x : Real) (hx : x ∈ J) :
      F t ^ p ≤ (8 : ENNReal) ^ p * F x ^ p := by
    have hshift : F t ≤ 8 * F x := by
      apply brrsI0ThreeCubicProfile_le_eight_shift q t x hg M
      dsimp only [J] at hx
      rw [abs_of_nonneg]
      · have hleft : t ≤ x := hx.1
        have hright : x ≤ t + q⁻¹ := hx.2
        have hqnonneg : 0 ≤ q := hq.le
        have hdiff : 0 ≤ x - t := by linarith
        rw [mul_sub]
        have hqx : q * (x - t) ≤ q * q⁻¹ :=
          mul_le_mul_of_nonneg_left (by linarith) hqnonneg
        rw [mul_inv_cancel₀ hq.ne'] at hqx
        linarith
      · exact mul_nonneg hq.le (by linarith [hx.1])
    have hpow := ENNReal.rpow_le_rpow hshift hp
    rw [ENNReal.mul_rpow_of_nonneg _ _ hp] at hpow
    exact hpow
  have hJbound :
      ∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p ≤
        ∫⁻ x in J, c * F x ^ p := by
    apply setLIntegral_mono' hJ
    intro x hx
    calc
      (ENNReal.ofReal q) * F t ^ p ≤
          (ENNReal.ofReal q) * ((8 : ENNReal) ^ p * F x ^ p) :=
        by simpa only [mul_comm] using
          (mul_le_mul_left (hpoint x hx) (ENNReal.ofReal q))
      _ = c * F x ^ p := by
        dsimp only [c]
        ring
  have hconst :
      (∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p) = F t ^ p := by
    rw [setLIntegral_const, Real.volume_Icc]
    have hlength : (t + q⁻¹) - t = q⁻¹ := by ring
    rw [hlength]
    have hqmul : ENNReal.ofReal q * ENNReal.ofReal q⁻¹ = 1 := by
      rw [← ENNReal.ofReal_mul hq.le, mul_inv_cancel₀ hq.ne']
      norm_num
    calc
      ENNReal.ofReal q * F t ^ p * ENNReal.ofReal q⁻¹ =
          (ENNReal.ofReal q * ENNReal.ofReal q⁻¹) * F t ^ p := by ring
      _ = F t ^ p := by rw [hqmul, one_mul]
  calc
    F t ^ p = ∫⁻ x in J, (ENNReal.ofReal q) * F t ^ p := hconst.symm
    _ ≤ ∫⁻ x in J, c * F x ^ p := hJbound
    _ ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * F x ^ p :=
      lintegral_mono_set hsub

/-- Local-time control of the complete compact-cell profile. -/
theorem brrsI0ThreeCubicProfile_le_local_profile
    {q t : Real} (hq : 0 < q) {g : Real → ENNReal} (hg : Measurable g)
    (M : ENNReal) :
    brrsI0ThreeCubicProfile q g M t ≤
      ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ThreeCubicProfile q g M x := by
  let Fminus : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  let Fplus : Real → ENNReal :=
    brrsI0ScaledCubicConvolution q (brrsReflectProfile g)
  let Fmiddle : Real → ENNReal := brrsI0CubicTailProfile q M
  let c : ENNReal := 8 * ENNReal.ofReal q
  have hFminus : Measurable Fminus := measurable_brrsI0ScaledCubicConvolution q hg
  have hFplus : Measurable Fplus := measurable_brrsI0ScaledCubicConvolution q
    (measurable_brrsReflectProfile hg)
  have hFmiddle : Measurable Fmiddle := measurable_brrsI0CubicTailProfile q M
  have hminus : Fminus t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x := by
    simpa only [Fminus, c] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq hg (t := t))
  have hplus : Fplus t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x := by
    simpa only [Fplus, c] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq
        (measurable_brrsReflectProfile hg) (t := t))
  have hmiddle : Fmiddle t ≤ ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
    simpa only [Fmiddle, c] using
      (brrsI0CubicTailProfile_le_local_profile hq M (t := t))
  have hGminus : Measurable (fun x : Real => c * Fminus x) :=
    measurable_const.mul hFminus
  have hGplus : Measurable (fun x : Real => c * Fplus x) :=
    measurable_const.mul hFplus
  calc
    brrsI0ThreeCubicProfile q g M t = (Fminus t + Fplus t) + Fmiddle t := by
      rfl
    _ ≤ ((∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x) +
        (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x)) +
          (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x) := by
      gcongr
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        ((c * Fminus x + c * Fplus x) + c * Fmiddle x) := by
      symm
      calc
        (∫⁻ x in brrsI0TimeCell q⁻¹ t,
          ((c * Fminus x + c * Fplus x) + c * Fmiddle x)) =
            (∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x + c * Fplus x) +
              ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
          simpa only [Pi.add_apply] using
            (lintegral_add_left
              (μ := volume.restrict (brrsI0TimeCell q⁻¹ t))
              (hGminus.add hGplus) (fun x : Real => c * Fmiddle x))
        _ = ((∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fminus x) +
            ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fplus x) +
              ∫⁻ x in brrsI0TimeCell q⁻¹ t, c * Fmiddle x := by
          rw [lintegral_add_left
            (μ := volume.restrict (brrsI0TimeCell q⁻¹ t)) hGminus
            (fun x : Real => c * Fplus x)]
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        c * ((Fminus x + Fplus x) + Fmiddle x) := by
      congr with x
      ring
    _ = ∫⁻ x in brrsI0TimeCell q⁻¹ t,
        (8 * ENNReal.ofReal q) * brrsI0ThreeCubicProfile q g M x := by
      rfl

/-- Direct bounded-overlap summation interface for the full compact-cell
three-profile majorant.  It is the three-phase analogue of the single cubic
convolution interface and contains no analytic hypothesis beyond its stated
input control. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_threeCubic_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A M : ENNReal)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M t) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((8 * ENNReal.ofReal ((2 : Real) ^ j)) *
          brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M x) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let G : Real → ENNReal := fun x =>
    A * ((8 * ENNReal.ofReal q) * F x)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hG : Measurable G := measurable_const.mul
    (measurable_const.mul hF)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, (8 * ENNReal.ofReal q) * F x := by
    simpa only [F, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ThreeCubicProfile_le_local_profile hq hg M (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t,
        (8 * ENNReal.ofReal q) * F x := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t,
        A * ((8 * ENNReal.ofReal q) * F x) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hF)

/-- Bounded-overlap summation for a nonnegative real power of the complete
three-phase `I₀` profile.  This is the reusable p-moment version of the
compact-cell interface. -/
theorem brrs_sum_dyadicI0_lintegral_le_of_threeCubic_rpow_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A M : ENNReal) (p : Real) (hp : 0 ≤ p)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * (brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M t) ^ p) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((((8 : ENNReal) ^ p * ENNReal.ofReal ((2 : Real) ^ j)) *
          (brrsI0ThreeCubicProfile ((2 : Real) ^ j) g M x) ^ p)) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ThreeCubicProfile q g M
  let c : ENNReal := (8 : ENNReal) ^ p * ENNReal.ofReal q
  let G : Real → ENNReal := fun x => A * (c * F x ^ p)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ThreeCubicProfile q hg M
  have hFp : Measurable (fun x : Real => F x ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp hF
  have hG : Measurable G := measurable_const.mul (measurable_const.mul hFp)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ^ p ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, c * F x ^ p := by
    simpa only [F, c, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ThreeCubicProfile_rpow_le_local_profile hq hp hg M (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t ^ p := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t, c * F x ^ p := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t, A * (c * F x ^ p) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hFp)

/-- The scaled cubic local profile is measurable, so it can be used directly
as the `G` input to `brrs_sum_dyadicI0_lintegral_le_of_local_profile`. -/
theorem measurable_brrsI0ScaledCubicLocalProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (fun x : Real =>
      (8 * ENNReal.ofReal q) * brrsI0ScaledCubicConvolution q g x) := by
  exact measurable_const.mul (measurable_brrsI0ScaledCubicConvolution q hg)

/-- This is the exact interface between an analytic `I₀` majorant and the
already-proved bounded-overlap summation.  Thus, once the physical radial
mass at time `t` is controlled by a scaled cubic convolution, no further
time-set argument is needed: the displayed scale-normalized local profile
can be inserted directly into `brrs_sum_dyadicI0_lintegral_le_of_local_profile`.
-/
theorem brrs_sum_dyadicI0_lintegral_le_of_scaledCubic_control
    {E : Set Real} (j : Nat) (T : Finset Real)
    (hT : IsDyadicDiscretization E j T)
    (H : Real → Real → ENNReal) (A : ENNReal)
    {g : Real → ENNReal} (hg : Measurable g)
    (hcontrol : ∀ t ∈ T,
      (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
        A * brrsI0ScaledCubicConvolution ((2 : Real) ^ j) g t) :
    (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
      17 * ∫⁻ x : Real,
        A * ((8 * ENNReal.ofReal ((2 : Real) ^ j)) *
          brrsI0ScaledCubicConvolution ((2 : Real) ^ j) g x) := by
  let q : Real := (2 : Real) ^ j
  let F : Real → ENNReal := brrsI0ScaledCubicConvolution q g
  let G : Real → ENNReal := fun x =>
    A * ((8 * ENNReal.ofReal q) * F x)
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hF : Measurable F := measurable_brrsI0ScaledCubicConvolution q hg
  have hG : Measurable G := measurable_const.mul
    (measurable_const.mul hF)
  change (∑ t ∈ T, ∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤
    17 * ∫⁻ x : Real, G x
  apply brrs_sum_dyadicI0_lintegral_le_of_local_profile j T hT H G hG
  intro t ht
  have hlocal : F t ≤
      ∫⁻ x in brrsDyadicI0TimeCell j t, (8 * ENNReal.ofReal q) * F x := by
    simpa only [F, q, brrsDyadicI0TimeCell, dyadicTimeScale] using
      (brrsI0ScaledCubicConvolution_le_local_profile hq hg (t := t))
  calc
    (∫⁻ r in Icc (0 : Real) (dyadicTimeScale j), H t r) ≤ A * F t := by
      simpa only [F, q] using hcontrol t ht
    _ ≤ A * ∫⁻ x in brrsDyadicI0TimeCell j t,
        (8 * ENNReal.ofReal q) * F x := by
      simpa only [mul_comm] using (mul_le_mul_left hlocal A)
    _ = ∫⁻ x in brrsDyadicI0TimeCell j t,
        A * ((8 * ENNReal.ofReal q) * F x) := by
      symm
      exact lintegral_const_mul A (measurable_const.mul hF)

end

open Set Filter MeasureTheory FourierTransform
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-! ### Exact dilation bookkeeping for Section 5 profiles

The `2^j` stationary scale occurs repeatedly in the radial-block estimates.
This elementary full-line change-of-variables lemma records the normalization
once, so that later convolution estimates do not silently lose a factor of
`2^j`.
-/

/-- Dilation on the real phase line transforms Lebesgue mass by the inverse
scale.  This is stated for `ENNReal`-valued profiles, exactly the setting of
the positive Section 5 convolutions. -/
theorem lintegral_comp_mul_real_eq
    (G : Real → ENNReal) {q : Real} (hq : 0 < q) :
    (∫⁻ x : Real, G (q * x)) =
      ENNReal.ofReal q⁻¹ * ∫⁻ y : Real, G y := by
  have hu : IsUnit q := isUnit_iff_ne_zero.mpr hq.ne'
  have hmap :
      (∫⁻ y : Real, G y ∂(Measure.map (fun x : Real => q • x) volume)) =
        ∫⁻ x : Real, G (q • x) :=
    lintegral_map_equiv G (Homeomorph.smul hu.unit).toMeasurableEquiv
  have hscale :
      (∫⁻ x : Real, G (q • x)) =
        ENNReal.ofReal q⁻¹ * ∫⁻ y : Real, G y := by
    rw [← hmap, Measure.map_addHaar_smul volume hq.ne',
      lintegral_smul_measure, Module.finrank_self, smul_eq_mul]
    have hfac : ENNReal.ofReal |(q ^ (1 : Nat))⁻¹| =
        ENNReal.ofReal q⁻¹ := by
      rw [abs_inv, abs_of_pos (pow_pos hq _), pow_one]
    rw [hfac]
  simpa only [smul_eq_mul] using hscale

/-! ### Normalized scaled cubic convolutions

The compact `I₀` estimates use the unnormalized kernel
`u ↦ brrsCubicJapaneseProfile (q * u)`.  Putting the factor `q` in the
kernel gives a unit-scale family with exactly constant mass.  These lemmas
make the normalization and its global positive Young estimate explicit, so
later endpoint estimates can use the literal `I₀` convolution without losing
a dyadic factor.
-/

/-- The mass-normalized cubic phase-line kernel at spatial scale `q`. -/
noncomputable def brrsNormalizedScaledCubicProfile (q : Real) : Real → ENNReal :=
  fun u => ENNReal.ofReal q * brrsCubicJapaneseProfile (q * u)

/-- The normalized scaled cubic profile is measurable. -/
theorem measurable_brrsNormalizedScaledCubicProfile (q : Real) :
    Measurable (brrsNormalizedScaledCubicProfile q) := by
  unfold brrsNormalizedScaledCubicProfile
  exact measurable_const.mul
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul measurable_id))

/-- At a positive scale, the normalized scaled cubic profile is positive. -/
theorem brrsNormalizedScaledCubicProfile_pos
    {q : Real} (hq : 0 < q) (u : Real) :
    0 < brrsNormalizedScaledCubicProfile q u := by
  unfold brrsNormalizedScaledCubicProfile
  exact ENNReal.mul_pos (ENNReal.ofReal_pos.mpr hq).ne'
    (brrsCubicJapaneseProfile_pos _).ne'

/-- The normalized scaled cubic profile is pointwise finite. -/
theorem brrsNormalizedScaledCubicProfile_ne_top
    (q u : Real) :
    brrsNormalizedScaledCubicProfile q u ≠ ∞ := by
  unfold brrsNormalizedScaledCubicProfile
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (brrsCubicJapaneseProfile_ne_top _)

/-- Normalization cancels the one-dimensional dilation Jacobian exactly. -/
theorem lintegral_brrsNormalizedScaledCubicProfile_eq
    {q : Real} (hq : 0 < q) :
    (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) =
      ∫⁻ v : Real, brrsCubicJapaneseProfile v := by
  let G : Real → ENNReal := brrsCubicJapaneseProfile
  have hG : Measurable G := by
    simpa only [G] using measurable_brrsCubicJapaneseProfile
  have hmul : Measurable (fun u : Real => q * u) :=
    measurable_const.mul measurable_id
  change (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) = ∫⁻ v : Real, G v
  have hmass :
      (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) =
        ENNReal.ofReal q * ∫⁻ u : Real, G (q * u) := by
    simpa only [Function.comp_apply] using
      (lintegral_const_mul (μ := volume) (ENNReal.ofReal q) (hG.comp hmul))
  rw [hmass, lintegral_comp_mul_real_eq G hq]
  rw [← mul_assoc, ← ENNReal.ofReal_mul hq.le,
    mul_inv_cancel₀ hq.ne', ENNReal.ofReal_one, one_mul]

/-- The normalized cubic convolution is exactly `q` times the literal
unnormalized `I₀` convolution used by the radial kernel bounds. -/
theorem brrsOneDimProfileConvolution_normalizedScaledCubic_eq
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) (x : Real) :
    brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x =
      ENNReal.ofReal q * brrsI0ScaledCubicConvolution q g x := by
  have hkernel : Measurable (fun s : Real =>
      brrsCubicJapaneseProfile (q * (x - s)) * g s) :=
    (measurable_brrsCubicJapaneseProfile.comp
      (measurable_const.mul (measurable_const.sub measurable_id))).mul
        hg
  unfold brrsOneDimProfileConvolution brrsNormalizedScaledCubicProfile
    brrsI0ScaledCubicConvolution
  calc
    (∫⁻ s : Real,
        (ENNReal.ofReal q * brrsCubicJapaneseProfile (q * (x - s))) * g s) =
        ∫⁻ s : Real,
          ENNReal.ofReal q *
            (brrsCubicJapaneseProfile (q * (x - s)) * g s) := by
      apply lintegral_congr
      intro s
      ring
    _ = ENNReal.ofReal q *
        ∫⁻ s : Real, brrsCubicJapaneseProfile (q * (x - s)) * g s :=
      lintegral_const_mul _ hkernel

/-- Global positive Young inequality for the normalized cubic convolution.
Its constant is exactly the scale-free mass of the base cubic profile. -/
theorem lintegral_brrsOneDimProfileConvolution_normalizedScaledCubic_rpow_le
    {q p : Real} (hq : 0 < q) (hp : 1 < p)
    {g : Real → ENNReal} (hg : Measurable g) :
    (∫⁻ x : Real,
      (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x) ^ p) ≤
        (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by
  have hmass :
      (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) =
        ∫⁻ v : Real, brrsCubicJapaneseProfile v :=
    lintegral_brrsNormalizedScaledCubicProfile_eq hq
  calc
    (∫⁻ x : Real,
        (brrsOneDimProfileConvolution (brrsNormalizedScaledCubicProfile q) g x) ^ p) ≤
        (∫⁻ u : Real, brrsNormalizedScaledCubicProfile q u) ^ p *
          ∫⁻ s : Real, (g s) ^ p :=
      lintegral_brrsOneDimProfileConvolution_rpow_le hp
        (measurable_brrsNormalizedScaledCubicProfile q) hg
        (brrsNormalizedScaledCubicProfile_pos hq)
        (brrsNormalizedScaledCubicProfile_ne_top q)
        (by
          rw [hmass]
          exact lintegral_brrsCubicJapaneseProfile_pos)
        (by
          rw [hmass]
          exact lintegral_brrsCubicJapaneseProfile_ne_top)
    _ = (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by rw [hmass]

/-- The same Young estimate stated directly for the literal `I₀` scaled
cubic convolution, after placing its compensating factor `q` outside. -/
theorem lintegral_normalized_brrsI0ScaledCubicConvolution_rpow_le
    {q p : Real} (hq : 0 < q) (hp : 1 < p)
    {g : Real → ENNReal} (hg : Measurable g) :
    (∫⁻ x : Real,
      (ENNReal.ofReal q * brrsI0ScaledCubicConvolution q g x) ^ p) ≤
        (∫⁻ u : Real, brrsCubicJapaneseProfile u) ^ p *
          ∫⁻ s : Real, (g s) ^ p := by
  have hYoung :=
    lintegral_brrsOneDimProfileConvolution_normalizedScaledCubic_rpow_le
      hq hp hg
  simpa only [brrsOneDimProfileConvolution_normalizedScaledCubic_eq q hg] using hYoung

/-- Restricting an input profile by an indicator converts the full-line
convolution exactly into its source-set integral. -/
theorem brrsOneDimProfileConvolution_indicator_eq_setLIntegral
    (omega g : Real → ENNReal) (S : Set Real) (hS : MeasurableSet S) (x : Real) :
    brrsOneDimProfileConvolution omega (S.indicator g) x =
      ∫⁻ s in S, omega (x - s) * g s := by
  classical
  unfold brrsOneDimProfileConvolution
  calc
    (∫⁻ s : Real, omega (x - s) * S.indicator g s) =
        ∫⁻ s : Real, S.indicator (fun s => omega (x - s) * g s) s := by
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ S <;> simp [Set.indicator, hs]
    _ = ∫⁻ s in S, omega (x - s) * g s :=
      lintegral_indicator hS _

/-- The same source-set identity for the plus-sign convolution convention. -/
theorem brrsOneDimProfileConvolutionPlus_indicator_eq_setLIntegral
    (omega g : Real → ENNReal) (S : Set Real) (hS : MeasurableSet S) (x : Real) :
    brrsOneDimProfileConvolutionPlus omega (S.indicator g) x =
      ∫⁻ s in S, omega (x + s) * g s := by
  classical
  unfold brrsOneDimProfileConvolutionPlus
  calc
    (∫⁻ s : Real, omega (x + s) * S.indicator g s) =
        ∫⁻ s : Real, S.indicator (fun s => omega (x + s) * g s) s := by
      apply lintegral_congr
      intro s
      by_cases hs : s ∈ S <;> simp [Set.indicator, hs]
    _ = ∫⁻ s in S, omega (x + s) * g s :=
      lintegral_indicator hS _

/-- The source restriction for the compact branch `0 < q s ≤ 16` of the
dyadic initial cell. -/
noncomputable def brrsI0CompactSourceProfile
    (q : Real) (g : Real → ENNReal) : Real → ENNReal :=
  (Ioc (0 : Real) (16 * q⁻¹)).indicator g

/-- Measurability of the compact initial-cell source restriction. -/
theorem measurable_brrsI0CompactSourceProfile
    (q : Real) {g : Real → ENNReal} (hg : Measurable g) :
    Measurable (brrsI0CompactSourceProfile q g) := by
  unfold brrsI0CompactSourceProfile
  exact hg.indicator measurableSet_Ioc

/-- The unit-mass rescaling of the stationary phase-line profile at dyadic
frequency `2^j`.  The leading factor is deliberately inside `ENNReal`: its
exact cancellation with the Jacobian is what makes the later convolution
constants independent of the frequency level. -/
noncomputable def brrsDyadicStationaryPhaseProfile
    (N j : Nat) (u : Real) : ENNReal :=
  ENNReal.ofReal
    (((2 : Real) ^ j) *
      brrsStationaryRapidProfile N (2 * Real.pi * ((2 : Real) ^ j * u)))

/-- Measurability of the dyadically normalized stationary phase profile. -/
theorem measurable_brrsDyadicStationaryPhaseProfile (N j : Nat) :
    Measurable (brrsDyadicStationaryPhaseProfile N j) := by
  unfold brrsDyadicStationaryPhaseProfile
  apply ENNReal.continuous_ofReal.measurable.comp
  apply measurable_const.mul
  apply (measurable_brrsStationaryRapidProfile N).comp
  fun_prop

/-- The dyadic stationary profile has exactly the same phase-line mass as its
level-zero counterpart.  This is the normalization used by the radial block
convolution estimates. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_eq
    (N j : Nat) :
    (∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) =
      ∫⁻ v : Real,
        ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v)) := by
  let q : Real := (2 : Real) ^ j
  let G : Real → ENNReal := fun v =>
    ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))
  have hq : 0 < q := by
    dsimp only [q]
    positivity
  have hG : Measurable G := by
    dsimp only [G]
    exact ENNReal.continuous_ofReal.measurable.comp
      ((measurable_brrsStationaryRapidProfile N).comp
        (by fun_prop))
  have happly (u : Real) :
      brrsDyadicStationaryPhaseProfile N j u =
        ENNReal.ofReal q * G (q * u) := by
    dsimp only [brrsDyadicStationaryPhaseProfile, q, G]
    rw [ENNReal.ofReal_mul hq.le]
  rw [show brrsDyadicStationaryPhaseProfile N j =
      fun u => ENNReal.ofReal q * G (q * u) from funext happly]
  change (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) = ∫⁻ v : Real, G v
  have hmul : Measurable (fun u : Real => q * u) :=
    measurable_const.mul measurable_id
  have hmass :
      (∫⁻ u : Real, ENNReal.ofReal q * G (q * u)) =
        ENNReal.ofReal q * ∫⁻ u : Real, G (q * u) := by
    simpa only [Function.comp_apply] using
      (lintegral_const_mul (μ := volume) (ENNReal.ofReal q) (hG.comp hmul))
  rw [hmass, lintegral_comp_mul_real_eq G hq]
  rw [← mul_assoc, ← ENNReal.ofReal_mul hq.le]
  have hqq : q * q⁻¹ = 1 := mul_inv_cancel₀ hq.ne'
  rw [hqq]
  simp

/-- The real stationary decay profile is strictly positive, including at the
origin.  Positivity is useful when it is used as a Young-convolution kernel. -/
theorem brrsStationaryRapidProfile_pos (N : Nat) (u : Real) :
    0 < brrsStationaryRapidProfile N u := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  · rw [brrsStationaryRapidProfile, if_neg hu]
    exact lt_min (by norm_num)
      (pow_pos (one_div_pos.mpr (abs_pos.mpr hu)) _)

/-- The normalized dyadic stationary phase profile is strictly positive at
every phase value. -/
theorem brrsDyadicStationaryPhaseProfile_pos (N j : Nat) (u : Real) :
    0 < brrsDyadicStationaryPhaseProfile N j u := by
  unfold brrsDyadicStationaryPhaseProfile
  rw [ENNReal.ofReal_pos]
  exact mul_pos (pow_pos (by norm_num) _)
    (brrsStationaryRapidProfile_pos N _)

/-- Pointwise finiteness of the normalized dyadic stationary phase profile. -/
theorem brrsDyadicStationaryPhaseProfile_ne_top (N j : Nat) (u : Real) :
    brrsDyadicStationaryPhaseProfile N j u ≠ ∞ := by
  unfold brrsDyadicStationaryPhaseProfile
  exact ENNReal.ofReal_ne_top

/-- The normalized dyadic stationary profile has positive phase-line mass. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_pos (N j : Nat) :
    0 < ∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u := by
  rw [lintegral_pos_iff_support
    (measurable_brrsDyadicStationaryPhaseProfile N j)]
  have hsupport : Function.support (brrsDyadicStationaryPhaseProfile N j) =
      Set.univ := by
    ext u
    simp only [Function.mem_support, Set.mem_univ, iff_true]
    exact (brrsDyadicStationaryPhaseProfile_pos N j u).ne'
  rw [hsupport]
  simp

/-- Quadratic stationary decay makes the dyadic profile's phase-line mass
finite.  Together with the preceding positivity lemma, this supplies all
mass hypotheses needed by the Section 5 positive Young inequality. -/
theorem lintegral_brrsDyadicStationaryPhaseProfile_ne_top
    (N j : Nat) (hN : 2 ≤ N) :
    (∫⁻ u : Real, brrsDyadicStationaryPhaseProfile N j u) ≠ ∞ := by
  have hbase : (∫⁻ u : Real,
      ENNReal.ofReal (brrsStationaryRapidProfile N u)) ≠ ∞ := by
    exact (lintegral_ofReal_ne_top_iff_integrable
      (measurable_brrsStationaryRapidProfile N).aestronglyMeasurable
      (Filter.Eventually.of_forall fun u =>
        brrsStationaryRapidProfile_nonneg N u)).mpr
        (integrable_brrsStationaryRapidProfile N hN)
  let P : Real → ENNReal := fun u =>
    ENNReal.ofReal (brrsStationaryRapidProfile N u)
  have hphase : (∫⁻ v : Real,
      ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))) ≠ ∞ := by
    have htransport := lintegral_comp_mul_real_eq P
      (show 0 < 2 * Real.pi by positivity)
    have htransport' :
        (∫⁻ v : Real,
          ENNReal.ofReal (brrsStationaryRapidProfile N (2 * Real.pi * v))) =
          ENNReal.ofReal (2 * Real.pi)⁻¹ *
            ∫⁻ u : Real, ENNReal.ofReal (brrsStationaryRapidProfile N u) := by
      simpa only [P] using htransport
    rw [htransport']
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hbase
  rw [lintegral_brrsDyadicStationaryPhaseProfile_eq]
  exact hphase

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### Four-sign phase-transfer preparation

The exact radial kernel has five middle-wave terms in addition to the four
endpoint signs.  Before those terms can be absorbed into the four-sign kernel
of BRRS (5.4), we need a two-sided comparison between the concrete stationary
rapid profile and the usual Japanese bracket.  The lower comparison below is
the part that is not supplied by the integration-by-parts estimates: it lets
rapid spatial decay pay for moving a middle carrier onto an endpoint phase
line.
-/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The elementary Japanese-bracket lower bound for the literal stationary
rapid profile.  Together with
`brrsStationaryRapidProfile_le_japaneseBracket`, this gives a two-sided
comparison with constants explicit enough for the middle-wave phase transfer.
-/
theorem brrsJapaneseBracket_le_brrsStationaryRapidProfile
    (N : Nat) (u : Real) :
    ((1 + |u|)⁻¹) ^ N ≤ brrsStationaryRapidProfile N u := by
  by_cases hu : u = 0
  · simp [brrsStationaryRapidProfile, hu]
  rw [brrsStationaryRapidProfile, if_neg hu]
  apply le_min
  · have hden : 1 ≤ 1 + |u| := by linarith [abs_nonneg u]
    have hinv : (1 + |u|)⁻¹ ≤ 1 := by
      simpa only [one_div] using inv_le_one_of_one_le₀ hden
    exact pow_le_one₀ (by positivity) hinv
  · have habs : 0 < |u| := abs_pos.mpr hu
    have hden : |u| ≤ 1 + |u| := by linarith
    have hinv : (1 + |u|)⁻¹ ≤ 1 / |u| := by
      simpa only [one_div] using one_div_le_one_div_of_le habs hden
    exact pow_le_pow_left₀ (by positivity) hinv N

/-- Rapid decay in a middle radius moves a middle carrier onto an endpoint
phase line.  This is the elementary Peetre-type estimate needed to turn the
five middle-wave profiles in the exact two-radius expansion into the four
signs of the BRRS kernel majorant. -/
theorem brrs_middleRapidProfile_transfer_to_endpointPhase
    (N : Nat) (x s : Real) :
    ((1 + |s|)⁻¹) ^ N *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
  let J : Real → Real := fun u => (1 + |u|)⁻¹
  have hJ_nonneg (u : Real) : 0 ≤ J u := by
    dsimp [J]
    positivity
  have hJ_le_one (u : Real) : J u ≤ 1 := by
    dsimp [J]
    have hden : 1 ≤ 1 + |u| := by linarith [abs_nonneg u]
    simpa only [one_div] using inv_le_one_of_one_le₀ hden
  have htriangle : 1 + |x - s| ≤ (1 + |x|) * (1 + |s|) := by
    have hsub : |x - s| ≤ |x| + |s| := by
      simpa [sub_eq_add_neg] using abs_add_le x (-s)
    have hprod : 0 ≤ |x| * |s| := mul_nonneg (abs_nonneg x) (abs_nonneg s)
    nlinarith
  have hinv : J x * J s ≤ J (x - s) := by
    dsimp [J]
    rw [← mul_inv]
    simpa only [one_div] using
      (one_div_le_one_div_of_le (by positivity) htriangle)
  have hpow : J x ^ N * J s ^ N ≤ J (x - s) ^ N := by
    calc
      J x ^ N * J s ^ N = (J x * J s) ^ N := by rw [mul_pow]
      _ ≤ J (x - s) ^ N :=
        pow_le_pow_left₀ (mul_nonneg (hJ_nonneg x) (hJ_nonneg s)) hinv N
  have hmore : J x ^ (2 * N) * J s ^ N ≤ J (x - s) ^ N := by
    have hJpow : J x ^ N ≤ 1 :=
      pow_le_one₀ (hJ_nonneg x) (hJ_le_one x)
    calc
      J x ^ (2 * N) * J s ^ N = J x ^ N * (J x ^ N * J s ^ N) := by
        rw [show 2 * N = N + N by omega, pow_add]
        ring
      _ ≤ 1 * (J x ^ N * J s ^ N) := by
        apply mul_le_mul_of_nonneg_right hJpow
        exact mul_nonneg (pow_nonneg (hJ_nonneg x) _)
          (pow_nonneg (hJ_nonneg s) _)
      _ = J x ^ N * J s ^ N := by ring
      _ ≤ J (x - s) ^ N := hpow
  have hpi : 0 < 2 * Real.pi := by positivity
  have hJ_scaled_upper : J (2 * Real.pi * x) ≤ J x := by
    dsimp [J]
    have hden : 1 + |x| ≤ 1 + |2 * Real.pi * x| := by
      rw [abs_mul, abs_of_pos hpi]
      nlinarith [abs_nonneg x, Real.pi_gt_three]
    simpa only [one_div] using
      (one_div_le_one_div_of_le (by positivity) hden)
  have hrapid_upper :
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
        (2 : Real) ^ (2 * N) * J x ^ (2 * N) := by
    calc
      brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
          (2 : Real) ^ (2 * N) * J (2 * Real.pi * x) ^ (2 * N) := by
        simpa only [J] using
          (brrsStationaryRapidProfile_le_japaneseBracket (2 * N)
            (2 * Real.pi * x))
      _ ≤ (2 : Real) ^ (2 * N) * J x ^ (2 * N) := by
        apply mul_le_mul_of_nonneg_left
        · exact pow_le_pow_left₀ (hJ_nonneg _) hJ_scaled_upper _
        · positivity
  have hJ_scaled_lower : J (x - s) ≤
      (2 * Real.pi) * J (2 * Real.pi * (x - s)) := by
    dsimp [J]
    rw [abs_mul, abs_of_pos hpi]
    have hdiv : 1 / (1 + |x - s|) ≤
        (2 * Real.pi) / (1 + (2 * Real.pi) * |x - s|) := by
      apply (div_le_div_iff₀ (by positivity) (by positivity)).2
      nlinarith [abs_nonneg (x - s), Real.pi_gt_three]
    simpa only [one_div, one_mul, div_eq_mul_inv] using hdiv
  have hendpoint_lower : J (x - s) ^ N ≤
      (2 * Real.pi) ^ N *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
    calc
      J (x - s) ^ N ≤
          ((2 * Real.pi) * J (2 * Real.pi * (x - s))) ^ N :=
        pow_le_pow_left₀ (hJ_nonneg _) hJ_scaled_lower N
      _ = (2 * Real.pi) ^ N * J (2 * Real.pi * (x - s)) ^ N := by
        rw [mul_pow]
      _ ≤ (2 * Real.pi) ^ N *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by
        apply mul_le_mul_of_nonneg_left
        · exact brrsJapaneseBracket_le_brrsStationaryRapidProfile N
            (2 * Real.pi * (x - s))
        · positivity
  calc
    J s ^ N * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
        J s ^ N * ((2 : Real) ^ (2 * N) * J x ^ (2 * N)) := by
      apply mul_le_mul_of_nonneg_left hrapid_upper
      exact pow_nonneg (hJ_nonneg s) _
    _ = (2 : Real) ^ (2 * N) * (J x ^ (2 * N) * J s ^ N) := by ring
    _ ≤ (2 : Real) ^ (2 * N) * J (x - s) ^ N := by
      apply mul_le_mul_of_nonneg_left hmore
      positivity
    _ ≤ (2 : Real) ^ (2 * N) *
        ((2 * Real.pi) ^ N *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - s))) := by
      apply mul_le_mul_of_nonneg_left hendpoint_lower
      positivity
    _ = ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - s)) := by ring

/-- A compact radial displacement can be absorbed into a stationary phase
profile after doubling the number of integrations by parts.  This is the
small-radius companion to the high-radius phase transfer: it is what turns
the `0` carrier of a low-radius stationary wave into either endpoint sign. -/
theorem brrsStationaryRapidProfile_smallRadius_shift_to_endpointPhase
    (N : Nat) (x delta : Real) (hdelta : |delta| ≤ 16) :
    brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((17 : Real) ^ N *
        ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - delta)) := by
  let J : Real := (1 + |delta|)⁻¹
  let L : Real := (2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N
  have hJnonneg : 0 ≤ J := by
    dsimp [J]
    positivity
  have hdenpos : 0 < 1 + |delta| := by positivity
  have hdenle : 1 + |delta| ≤ 17 := by linarith
  have hscale_base : 1 ≤ 17 * J := by
    dsimp [J]
    rw [show 17 * (1 + |delta|)⁻¹ = 17 / (1 + |delta|) by ring]
    exact (le_div_iff₀ hdenpos).mpr (by simpa using hdenle)
  have hscale : 1 ≤ (17 : Real) ^ N * J ^ N := by
    calc
      1 = (1 : Real) ^ N := by simp
      _ ≤ (17 * J) ^ N := by
        exact pow_le_pow_left₀ (by positivity) hscale_base N
      _ = (17 : Real) ^ N * J ^ N := by rw [mul_pow]
  have htransfer := brrs_middleRapidProfile_transfer_to_endpointPhase N x delta
  have hPnonneg : 0 ≤ brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) :=
    brrsStationaryRapidProfile_nonneg _ _
  calc
    brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) =
        1 * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by ring
    _ ≤ ((17 : Real) ^ N * J ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) :=
      mul_le_mul_of_nonneg_right hscale hPnonneg
    _ = (17 : Real) ^ N *
        (J ^ N * brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x)) := by
      ring
    _ ≤ (17 : Real) ^ N *
        (L * brrsStationaryRapidProfile N (2 * Real.pi * (x - delta))) := by
      apply mul_le_mul_of_nonneg_left
      · simpa only [J, L] using htransfer
      · positivity
    _ = ((17 : Real) ^ N * L) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - delta)) := by ring

/-- At a high radial position, the extra `2 N` half-powers produced by a
middle Bessel remainder dominate the Japanese-bracket factor needed to move
its carrier onto an endpoint phase.  The normalization by `16` is the one
used by the stationary component bounds. -/
theorem brrs_highRadius_sqrt_decay_le_japaneseBracket
    {s : Real} (hs : 16 ≤ s) (N : Nat) :
    1 / (Real.sqrt (s / 16)) ^ (2 * N) ≤
      (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by
  have hspos : 0 < s := by linarith
  have hroot : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    positivity
  have hsq : (Real.sqrt (s / 16)) ^ 2 = s / 16 :=
    Real.sq_sqrt (by positivity)
  have hbase : 1 / s ≤ 2 * ((1 + |s|)⁻¹) := by
    rw [abs_of_pos hspos]
    rw [show (1 + s)⁻¹ = 1 / (1 + s) by rw [one_div]]
    calc
      1 / s ≤ 2 / (1 + s) := by
        apply (div_le_div_iff₀ hspos (by positivity)).2
        nlinarith
      _ = 2 * (1 / (1 + s)) := by simp only [one_mul, div_eq_mul_inv]
  have hpow : (1 / s) ^ N ≤ (2 * ((1 + |s|)⁻¹)) ^ N :=
    pow_le_pow_left₀ (by positivity) hbase N
  have hleft :
      1 / (Real.sqrt (s / 16)) ^ (2 * N) =
        (16 : Real) ^ N * (1 / s) ^ N := by
    rw [show 2 * N = 2 * N by rfl, pow_mul, hsq, div_pow, one_div_pow]
    field_simp [pow_ne_zero N (ne_of_gt hspos)]
  rw [hleft]
  calc
    (16 : Real) ^ N * (1 / s) ^ N ≤
        (16 : Real) ^ N * (2 * ((1 + |s|)⁻¹)) ^ N := by
      exact mul_le_mul_of_nonneg_left hpow (by positivity)
    _ = (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by
      rw [mul_pow]
      calc
        (16 : Real) ^ N * (2 ^ N * ((1 + |s|)⁻¹) ^ N) =
            ((1 + |s|)⁻¹) ^ N * (2 ^ N * 16 ^ N) := by ring
        _ = ((1 + |s|)⁻¹) ^ N * (32 : Real) ^ N := by
          congr 1
          rw [← mul_pow]
          norm_num
        _ = (32 : Real) ^ N * ((1 + |s|)⁻¹) ^ N := by ring

/-- An extra `2 N` half-powers in a high middle radius moves its carrier by
any nonnegative distance no larger than that radius.  This is the precise
Peetre bridge used both for a middle--endpoint term and, after comparing the
two radii, for the middle--middle term. -/
theorem brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
    {u a : Real} (hu : 16 ≤ u) (ha0 : 0 ≤ a) (hau : a ≤ u)
    (N : Nat) (x : Real) :
    (1 / (Real.sqrt (u / 16)) ^ (2 * N)) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - a)) := by
  have hu0 : 0 ≤ u := by linarith
  have hbracket : ((1 + |u|)⁻¹) ^ N ≤ ((1 + |a|)⁻¹) ^ N := by
    have hbase : (1 + |u|)⁻¹ ≤ (1 + |a|)⁻¹ := by
      rw [abs_of_nonneg hu0, abs_of_nonneg ha0]
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by positivity : 0 < 1 + a) (by linarith))
    exact pow_le_pow_left₀ (by positivity) hbase N
  have hdecay := brrs_highRadius_sqrt_decay_le_japaneseBracket hu N
  have htransfer := brrs_middleRapidProfile_transfer_to_endpointPhase N x a
  calc
    (1 / (Real.sqrt (u / 16)) ^ (2 * N)) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) ≤
      ((32 : Real) ^ N * ((1 + |u|)⁻¹) ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by
      exact mul_le_mul_of_nonneg_right hdecay
        (brrsStationaryRapidProfile_nonneg _ _)
    _ ≤ ((32 : Real) ^ N * ((1 + |a|)⁻¹) ^ N) *
        brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x) := by
      apply mul_le_mul_of_nonneg_right
      · exact mul_le_mul_of_nonneg_left hbracket (by positivity)
      · exact brrsStationaryRapidProfile_nonneg _ _
    _ = (32 : Real) ^ N *
        (((1 + |a|)⁻¹) ^ N *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * x)) := by ring
    _ ≤ (32 : Real) ^ N *
        (((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N) *
          brrsStationaryRapidProfile N (2 * Real.pi * (x - a))) := by
      exact mul_le_mul_of_nonneg_left htransfer (by positivity)
    _ = ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)) *
        brrsStationaryRapidProfile N (2 * Real.pi * (x - a)) := by ring

/-- Factoring a high-radius middle remainder into the endpoint half-density
and the extra `2 N` half-powers.  This keeps the eventual
`(s / r)^((d-1)/2)` normalization visible rather than absorbing it into an
unnamed constant. -/
theorem brrs_twoRadius_middle_denominator_factor
    {r s : Real} (hr : 16 ≤ r) (hs : 16 ≤ s) (k N : Nat) (C : Real) :
    C / ((Real.sqrt (r / 16)) ^ k *
      (Real.sqrt (s / 16)) ^ (k + 2 * N)) =
      (C / ((Real.sqrt (r / 16)) ^ k *
        (Real.sqrt (s / 16)) ^ k)) *
        (1 / (Real.sqrt (s / 16)) ^ (2 * N)) := by
  have hrpos : 0 < Real.sqrt (r / 16) := by
    apply Real.sqrt_pos.2
    linarith
  have hspos : 0 < Real.sqrt (s / 16) := by
    apply Real.sqrt_pos.2
    linarith
  rw [pow_add]
  field_simp [hrpos.ne', hspos.ne']

/-- The extra high-radius middle factor is at most one, so an unused rapid
denominator may safely be discarded after it has supplied a phase transfer. -/
theorem brrs_highRadius_sqrt_inverse_pow_le_one
    {u : Real} (hu : 16 ≤ u) (N : Nat) :
    1 / (Real.sqrt (u / 16)) ^ (2 * N) ≤ 1 := by
  have hroot : 1 ≤ Real.sqrt (u / 16) := by
    apply Real.one_le_sqrt.mpr
    linarith
  have hpow : 1 ≤ (Real.sqrt (u / 16)) ^ (2 * N) :=
    one_le_pow₀ hroot
  simpa only [one_div] using inv_le_one_of_one_le₀ hpow

/-- At ordered high radii, the five profiles arising from at least one
middle Bessel wave are absorbed into the four endpoint phase lines.  The
extra `2 N` half-powers are retained explicitly on the radius carrying the
middle remainder.  This is the scalar phase-transfer step behind the
four-sign radial kernel majorant. -/
theorem brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
    {r s t : Real} (hr : 16 ≤ r) (hs : 16 ≤ s) (hsr : s ≤ r) (N : Nat) :
    (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
        (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
        (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) ≤
      (5 * ((32 : Real) ^ N * ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N))) *
        (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let E₁ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t - r - s))
  let E₂ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t - r + s))
  let E₃ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t + r - s))
  let E₄ : Real := brrsStationaryRapidProfile N
    (2 * Real.pi * (t + r + s))
  let S : Real := E₁ + E₂ + E₃ + E₄
  have hL : 0 ≤ L := by
    dsimp [L]
    positivity
  have hE₁ : 0 ≤ E₁ := by
    dsimp [E₁]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₂ : 0 ≤ E₂ := by
    dsimp [E₂]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₃ : 0 ≤ E₃ := by
    dsimp [E₃]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₄ : 0 ≤ E₄ := by
    dsimp [E₄]
    exact brrsStationaryRapidProfile_nonneg _ _
  have hE₁S : E₁ ≤ S := by
    dsimp [S]
    linarith
  have hE₂S : E₂ ≤ S := by
    dsimp [S]
    linarith
  have hE₃S : E₃ ≤ S := by
    dsimp [S]
    linarith
  have hE₄S : E₄ ≤ S := by
    dsimp [S]
    linarith
  have h₁ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t - r)
  have h₂ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := s) (a := s) hs (by linarith) le_rfl N (t + r)
  have h₃ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r) hr (by linarith) le_rfl N (t - s)
  have h₄ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r) hr (by linarith) le_rfl N (t + s)
  have hrs0 : 0 ≤ r - s := by linarith
  have hrsle : r - s ≤ r := by linarith
  have h₅ :=
    brrs_highRadius_middle_decay_transfer_to_endpointPhase_of_nonneg_le
      (u := r) (a := r - s) hr hrs0 hrsle N t
  have h₁' :
      (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) ≤
        L * E₁ := by
    dsimp [L, E₁]
    convert h₁ using 1 <;> ring
  have h₂' :
      (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r)) ≤
        L * E₃ := by
    dsimp [L, E₃]
    convert h₂ using 1 <;> ring
  have h₃' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) ≤
        L * E₁ := by
    dsimp [L, E₁]
    convert h₃ using 1 <;> ring
  have h₄' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) ≤
        L * E₂ := by
    dsimp [L, E₂]
    convert h₄ using 1 <;> ring
  have h₅' :
      (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t) ≤
        L * E₂ := by
    dsimp [L, E₂]
    convert h₅ using 1 <;> ring
  have hLS₁ : L * E₁ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₁S hL
  have hLS₂ : L * E₂ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₂S hL
  have hLS₃ : L * E₃ ≤ L * S :=
    mul_le_mul_of_nonneg_left hE₃S hL
  calc
    (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
          (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
        (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
          (brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) =
        ((1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r)) +
          (1 / (Real.sqrt (s / 16)) ^ (2 * N)) *
            brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))) +
          ((1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s)) +
            (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
              brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s)) +
              (1 / (Real.sqrt (r / 16)) ^ (2 * N)) *
                brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)) := by
      ring
    _ ≤ (L * E₁ + L * E₃) + (L * E₁ + L * E₂ + L * E₂) := by
      gcongr
    _ ≤ (L * S + L * S) + (L * S + L * S + L * S) := by
      gcongr
    _ = (5 * L) * S := by ring
    _ = (5 * ((32 : Real) ^ N *
          ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N))) *
        (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### Terminal radial-packet scalar estimates

The last output-radius packet in the Section 5 decomposition does not need
local entropy: its finite time sum is controlled directly by translation
invariance on the phase line.  The following lemmas record that argument for
an arbitrary closed radial interval and an arbitrary finite packet.  They are
stated first for a measurable nonnegative profile, then specialized to the
`ENNReal` `p`-power convention used by the radial block estimates.
-/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- Restricting an outgoing translated phase-line profile to any radial
interval can only decrease its global mass. -/
theorem brrs_lintegral_Icc_add_profile_le_global
    (G : Real → ENNReal) (t a b : Real) :
    (∫⁻ r in Icc a b, G (t + r)) ≤ ∫⁻ x : Real, G x := by
  calc
    (∫⁻ r in Icc a b, G (t + r)) ≤ ∫⁻ r : Real, G (t + r) := by
      simpa only [Measure.restrict_univ] using
        (lintegral_mono_set
          (f := fun r : Real => G (t + r)) (Set.subset_univ _))
    _ = ∫⁻ x : Real, G x := by
      rw [lintegral_add_left_eq_self]

/-- The reflected incoming translated phase-line profile has the same global
mass bound on every radial interval. -/
theorem brrs_lintegral_Icc_sub_profile_le_global
    (G : Real → ENNReal) (t a b : Real) :
    (∫⁻ r in Icc a b, G (t - r)) ≤ ∫⁻ x : Real, G x := by
  calc
    (∫⁻ r in Icc a b, G (t - r)) ≤ ∫⁻ r : Real, G (t - r) := by
      simpa only [Measure.restrict_univ] using
        (lintegral_mono_set
          (f := fun r : Real => G (t - r)) (Set.subset_univ _))
    _ = ∫⁻ x : Real, G x := by
      rw [lintegral_sub_left_eq_self]

/-- A uniformly bounded radial weight can be pulled out of an outgoing
terminal interval, after which translation invariance controls the profile
by its full phase-line mass. -/
theorem brrs_lintegral_Icc_add_weighted_profile_le
    (G W : Real → ENNReal) (t a b : Real) (C : ENNReal)
    (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∫⁻ r in Icc a b, W r * G (t + r)) ≤ C * ∫⁻ x : Real, G x := by
  have htranslate : Measurable (fun r : Real => G (t + r)) :=
    hG.comp (measurable_const.add measurable_id)
  calc
    (∫⁻ r in Icc a b, W r * G (t + r)) ≤
        ∫⁻ r in Icc a b, C * G (t + r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact mul_le_mul' (hW r hr) le_rfl
    _ = C * ∫⁻ r in Icc a b, G (t + r) := by
      rw [lintegral_const_mul C htranslate]
    _ ≤ C * ∫⁻ x : Real, G x :=
      mul_le_mul' le_rfl (brrs_lintegral_Icc_add_profile_le_global G t a b)

/-- The incoming counterpart of
`brrs_lintegral_Icc_add_weighted_profile_le`. -/
theorem brrs_lintegral_Icc_sub_weighted_profile_le
    (G W : Real → ENNReal) (t a b : Real) (C : ENNReal)
    (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∫⁻ r in Icc a b, W r * G (t - r)) ≤ C * ∫⁻ x : Real, G x := by
  have htranslate : Measurable (fun r : Real => G (t - r)) :=
    hG.comp (measurable_const.sub measurable_id)
  calc
    (∫⁻ r in Icc a b, W r * G (t - r)) ≤
        ∫⁻ r in Icc a b, C * G (t - r) := by
      apply lintegral_mono_ae
      filter_upwards [ae_restrict_mem measurableSet_Icc] with r hr
      exact mul_le_mul' (hW r hr) le_rfl
    _ = C * ∫⁻ r in Icc a b, G (t - r) := by
      rw [lintegral_const_mul C htranslate]
    _ ≤ C * ∫⁻ x : Real, G x :=
      mul_le_mul' le_rfl (brrs_lintegral_Icc_sub_profile_le_global G t a b)

/-- Summing the outgoing terminal interval estimate over a finite time packet
costs exactly the cardinality of that packet. -/
theorem brrs_sum_Icc_add_weighted_profile_le_card_mul
    (T : Finset Real) (a b : Real) (C : ENNReal)
    (W G : Real → ENNReal) (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t + r)) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t + r)) ≤
        ∑ t ∈ T, C * ∫⁻ x : Real, G x := by
      apply Finset.sum_le_sum
      intro t ht
      exact brrs_lintegral_Icc_add_weighted_profile_le G W t a b C hG hW
    _ = (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ac_rfl

/-- Summing the incoming terminal interval estimate over a finite time packet
costs exactly the cardinality of that packet. -/
theorem brrs_sum_Icc_sub_weighted_profile_le_card_mul
    (T : Finset Real) (a b : Real) (C : ENNReal)
    (W G : Real → ENNReal) (hG : Measurable G)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t - r)) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
  calc
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * G (t - r)) ≤
        ∑ t ∈ T, C * ∫⁻ x : Real, G x := by
      apply Finset.sum_le_sum
      intro t ht
      exact brrs_lintegral_Icc_sub_weighted_profile_le G W t a b C hG hW
    _ = (T.card : ENNReal) * C * ∫⁻ x : Real, G x := by
      rw [Finset.sum_const, nsmul_eq_mul]
      ac_rfl

/-- The outgoing terminal-packet bound in the `ENNReal` `p`-power form used
by the BRRS Section 5 scalar estimates. -/
theorem brrs_sum_terminalInterval_add_weighted_rpow_le_card_mul
    (T : Finset Real) (a b p : Real) (C : ENNReal)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * (F (t + r)) ^ p) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, (F x) ^ p := by
  exact brrs_sum_Icc_add_weighted_profile_le_card_mul T a b C W
    (fun x : Real => (F x) ^ p)
    (ENNReal.continuous_rpow_const.measurable.comp hF) hW

/-- The incoming terminal-packet bound in the `ENNReal` `p`-power form used
by the BRRS Section 5 scalar estimates. -/
theorem brrs_sum_terminalInterval_sub_weighted_rpow_le_card_mul
    (T : Finset Real) (a b p : Real) (C : ENNReal)
    (W F : Real → ENNReal) (hF : Measurable F)
    (hW : ∀ r ∈ Icc a b, W r ≤ C) :
    (∑ t ∈ T, ∫⁻ r in Icc a b, W r * (F (t - r)) ^ p) ≤
      (T.card : ENNReal) * C * ∫⁻ x : Real, (F x) ^ p := by
  exact brrs_sum_Icc_sub_weighted_profile_le_card_mul T a b C W
    (fun x : Real => (F x) ^ p)
    (ENNReal.continuous_rpow_const.measurable.comp hF) hW

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### All-nine high--high stationary profile

The literal two-radius kernel has nine stationary components, not merely the
four endpoint--endpoint components.  At two high radii the same compact
frequency integration-by-parts estimate applies to each of the nine pieces.
The resulting bound deliberately keeps the five profiles involving a middle
wave: this is the profile estimate compatible with the exact kernel identity.
-/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The full exact stationary contribution to the two-radius kernel, with
all nine pairs of outgoing, incoming, and middle waves displayed
individually.  The four endpoint--endpoint terms are the previously named
`brrsTwoRadiusEndpointIntegralSum`; the other five terms are retained because
the equality with the literal kernel is exact. -/
noncomputable def brrsTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  ((brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t +
      brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t) +
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t) +
      (((brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t +
          brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t) +
        brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t) +
          ((brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t +
            brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t) +
              brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t))

/-- The five literal stationary components involving at least one middle
wave.  Keeping this remainder named makes its rapid spatial decay available
to the radial-block argument without altering the exact nine-term identity. -/
noncomputable def brrsTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) : Complex :=
  brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t +
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t +
      (brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t +
        brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t +
          brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t)

/-- At two high radii, the five literal components containing a middle wave
are controlled by their five exact phase profiles.  The first two terms place
the middle factor in the second radius and hence retain rapid decay in `s`;
the final three retain it in `r`.  No component is discarded. -/
theorem exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fivePhase_rapidProfile_le
    {d N M : Nat} (hd : 3 ≤ d) (hM : 2 ≤ M) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (s / 16)) ^ (M - 1) *
            (Real.sqrt (r / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .incoming r +
                brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt (r / 16)) ^ (M - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .middle r +
                  brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .middle r +
                  brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) := by
  obtain ⟨Cmo, hCmo, hmo⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_middle_highRadius_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .outgoing
  obtain ⟨Cmi, hCmi, hmi⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_middle_highRadius_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .incoming
  obtain ⟨Cmm, hCmm, hmm⟩ :=
    exists_norm_brrsTwoRadiusStationaryComponentIntegral_middle_highRadius_rapidProfile_le
      (d := d) (N := N) (M := M) hd hM Phi .middle
  let C : Real := Cmo + Cmi + Cmm
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let qr : Real := (Real.sqrt (r / 16)) ^ (M - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let qs : Real := (Real.sqrt (s / 16)) ^ (M - 1) *
    (Real.sqrt (r / 16)) ^ (d - 1)
  let Ar : Real := (1 - (1 / 32 : Real)) * (C / qr)
  let As : Real := (1 - (1 / 32 : Real)) * (C / qs)
  have hqr : 0 < qr := by
    dsimp [qr]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
  have hqs : 0 < qs := by
    dsimp [qs]
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
    · apply pow_pos
      apply Real.sqrt_pos.2
      linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hAr_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qr) ≤ Ar := by
    dsimp [Ar]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqr.le
    · norm_num
  have hAs_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / qs) ≤ As := by
    dsimp [As]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hqs.le
    · norm_num
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  have hphaseom :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .outgoing r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .outgoing r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hphaseim :
      brrsSurfaceWavePhase .middle s + brrsSurfaceWavePhase .incoming r +
          2 * Real.pi * t =
        brrsSurfaceWavePhase .incoming r + brrsSurfaceWavePhase .middle s +
          2 * Real.pi * t := by ring
  have hPom : 0 ≤ Pom := by
    dsimp [Pom]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPim : 0 ≤ Pim := by
    dsimp [Pim]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmo : 0 ≤ Pmo := by
    dsimp [Pmo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmi : 0 ≤ Pmi := by
    dsimp [Pmi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPmm : 0 ≤ Pmm := by
    dsimp [Pmm]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIom : ‖Iom‖ ≤ As * Pom := by
    dsimp [Iom, Pom]
    rw [brrsTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .outgoing r + 2 * Real.pi * t) := by
        simpa only [qs] using hmo s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmo / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseom]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmo hCmo_le) hPom
  have hIim : ‖Iim‖ ≤ As * Pim := by
    dsimp [Iim, Pim]
    rw [brrsTwoRadiusStationaryComponentIntegral_swap]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle s +
              brrsSurfaceWavePhase .incoming r + 2 * Real.pi * t) := by
        simpa only [qs] using hmi s r t hs hr
      _ = (1 - (1 / 32 : Real)) * (Cmi / qs) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        rw [hphaseim]
      _ ≤ As * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAs_le Cmi hCmi_le) hPim
  have hImo : ‖Imo‖ ≤ Ar * Pmo := by
    dsimp [Imo, Pmo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [qr] using hmo r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmo hCmo_le) hPmo
  have hImi : ‖Imi‖ ≤ Ar * Pmi := by
    dsimp [Imi, Pmi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [qr] using hmi r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmi hCmi_le) hPmi
  have hImm : ‖Imm‖ ≤ Ar * Pmm := by
    dsimp [Imm, Pmm]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / qr) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [qr] using hmm r s t hr hs
      _ ≤ Ar * brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) :=
        mul_le_mul_of_nonneg_right (hAr_le Cmm hCmm_le) hPmm
  change ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
    As * (Pom + Pim) + Ar * (Pmo + Pmi + Pmm)
  calc
    ‖(Iom + Iim) + (Imo + Imi + Imm)‖ ≤
        ‖Iom + Iim‖ + ‖Imo + Imi + Imm‖ := norm_add_le _ _
    _ ≤ (‖Iom‖ + ‖Iim‖) + ((‖Imo‖ + ‖Imi‖) + ‖Imm‖) := by
      apply add_le_add
      · exact norm_add_le _ _
      · calc
          ‖Imo + Imi + Imm‖ ≤ ‖Imo + Imi‖ + ‖Imm‖ := norm_add_le _ _
          _ ≤ (‖Imo‖ + ‖Imi‖) + ‖Imm‖ := by
            exact add_le_add (norm_add_le Imo Imi) le_rfl
    _ ≤ (As * Pom + As * Pim) +
          ((Ar * Pmo + Ar * Pmi) + Ar * Pmm) := by
      apply add_le_add
      · exact add_le_add hIom hIim
      · apply add_le_add
        · exact add_le_add hImo hImi
        · exact hImm
    _ = As * (Pom + Pim) + Ar * (Pmo + Pmi + Pmm) := by ring

/-- The exact nine-component kernel is its endpoint/end-point main term plus
the five named middle-wave components. -/
theorem brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
      brrsTwoRadiusEndpointIntegralSum Phi d r s t +
        brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t := by
  unfold brrsTwoRadiusAllStationaryComponentIntegralSum
    brrsTwoRadiusEndpointIntegralSum brrsTwoRadiusMiddleComponentIntegralSum
  ring

/-! ### Exact dyadic transport of the two-radius stationary model

The level-zero two-radius stationary expansion is the object for which the
surface-wave factors and all nine phases have been constructed literally.
For the dyadic radial-block argument it is useful to retain its exact
parabolic dilation as a separately named object.  The definitions in this
section are introduced first as *scaled stationary models*.  Their equality
with the actual dyadic half-wave is proved below, after the required outer
radial change-of-variables lemma has been established.
-/

/-- The exact `2^j` transport of one level-zero two-radius stationary
component.  It is a scaled model, not an unproved alternate definition of the
dyadic half-wave kernel. -/
noncomputable def brrsDyadicTwoRadiusStationaryComponentIntegral
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the four endpoint--endpoint stationary
components. -/
noncomputable def brrsDyadicTwoRadiusEndpointIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusEndpointIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the five stationary components involving a
middle wave. -/
noncomputable def brrsDyadicTwoRadiusMiddleComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusMiddleComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- The exact `2^j` transport of the literal all-nine level-zero stationary
sum. -/
noncomputable def brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) : Complex :=
  (((2 : Real) ^ j) ^ d) •
    brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)

/-- Unfolding the dyadic stationary component leaves exactly the expected
spatial and temporal dilation. -/
theorem brrsDyadicTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t =
      (((2 : Real) ^ j) ^ d) •
        brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic endpoint sum leaves exactly the corresponding
level-zero endpoint sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) • brrsTwoRadiusEndpointIntegralSum Phi d
        (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic middle sum leaves exactly the corresponding
level-zero middle sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) • brrsTwoRadiusMiddleComponentIntegralSum Phi d
        (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- Unfolding the dyadic all-nine sum leaves exactly the corresponding
level-zero all-nine sum at the dilated variables. -/
theorem brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t =
      (((2 : Real) ^ j) ^ d) •
        brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t) := rfl

/-- The rescaled stationary component remains symmetric in its two radial
variables. -/
theorem brrsDyadicTwoRadiusStationaryComponentIntegral_swap
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t =
      brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partS partR s r t := by
  unfold brrsDyadicTwoRadiusStationaryComponentIntegral
  rw [brrsTwoRadiusStationaryComponentIntegral_swap]

/-- The dyadic endpoint model is the sum of its four rescaled endpoint
components. -/
theorem brrsDyadicTwoRadiusEndpointIntegralSum_eq_four_component_sum
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t =
      brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .outgoing .outgoing r s t +
        brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .outgoing .incoming r s t +
          brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .incoming .outgoing r s t +
            brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j .incoming .incoming r s t := by
  unfold brrsDyadicTwoRadiusEndpointIntegralSum
    brrsDyadicTwoRadiusStationaryComponentIntegral
    brrsTwoRadiusEndpointIntegralSum
  simp only [smul_add]

/-- The dyadic all-nine stationary model has the same exact main/remainder
split as its level-zero source. -/
theorem brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t =
      brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t +
        brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t := by
  unfold brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
    brrsDyadicTwoRadiusEndpointIntegralSum
    brrsDyadicTwoRadiusMiddleComponentIntegralSum
  rw [brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle,
    smul_add]

/-- Norm transport for one rescaled stationary component. -/
theorem norm_brrsDyadicTwoRadiusStationaryComponentIntegral_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat)
    (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    ‖brrsDyadicTwoRadiusStationaryComponentIntegral Phi d j partR partS r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusStationaryComponentIntegral Phi d partR partS
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusStationaryComponentIntegral
  exact norm_smul _ _

/-- Norm transport for the rescaled endpoint model. -/
theorem norm_brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusEndpointIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusEndpointIntegralSum
  exact norm_smul _ _

/-- Norm transport for the rescaled middle-wave model. -/
theorem norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusMiddleComponentIntegralSum
  exact norm_smul _ _

/-- Norm transport for the rescaled all-nine stationary model. -/
theorem norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t : Real) :
    ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ =
      ‖((2 : Real) ^ j) ^ d‖ *
        ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
          (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ := by
  unfold brrsDyadicTwoRadiusAllStationaryComponentIntegralSum
  exact norm_smul _ _

/-- Any pointwise endpoint bound at the dilated level-zero variables
transports through the dyadic stationary model with precisely its scalar
Jacobian factor. -/
theorem norm_brrsDyadicTwoRadiusEndpointIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusEndpointIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusEndpointIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- Any pointwise middle-wave bound at the dilated level-zero variables
transports through the dyadic stationary model with precisely its scalar
Jacobian factor. -/
theorem norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusMiddleComponentIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusMiddleComponentIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- The same exact scalar transport is available for the all-nine stationary
model. -/
theorem norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    (Phi : BRRSAnnularCutoff) (d j : Nat) (r s t B : Real)
    (hB : ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d
      (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s) (((2 : Real) ^ j) * t)‖ ≤ B) :
    ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
      ‖((2 : Real) ^ j) ^ d‖ * B := by
  rw [norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_eq_levelZero_scaled]
  exact mul_le_mul_of_nonneg_left hB (norm_nonneg _)

/-- At two high radial positions, the full exact three-by-three stationary
sum is controlled by the nine corresponding rapidly decaying phase profiles.
In particular, no middle-wave remainder is discarded. -/
theorem exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highRadius_ninePhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          ((brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
            brrsStationaryRapidProfile N
              (brrsSurfaceWavePhase .outgoing r +
                brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .outgoing r +
                  brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
            ((brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .incoming r +
                  brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
              brrsStationaryRapidProfile N
                (brrsSurfaceWavePhase .incoming r +
                  brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .incoming r +
                    brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)) +
              (brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) +
                brrsStationaryRapidProfile N
                  (brrsSurfaceWavePhase .middle r +
                    brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) +
                  brrsStationaryRapidProfile N
                    (brrsSurfaceWavePhase .middle r +
                      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)))) := by
  obtain ⟨Coo, hCoo_pos, hoo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi_pos, hoi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Com, hCom_pos, hom⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing .middle
  obtain ⟨Cio, hCio_pos, hio⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii_pos, hii⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  obtain ⟨Cim, hCim_pos, him⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming .middle
  obtain ⟨Cmo, hCmo_pos, hmo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .middle .outgoing
  obtain ⟨Cmi, hCmi_pos, hmi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .middle .incoming
  obtain ⟨Cmm, hCmm_pos, hmm⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .middle .middle
  let C : Real :=
    (Coo + Coi + Com) + ((Cio + Cii + Cim) + (Cmo + Cmi + Cmm))
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let q : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  have hq : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCoo_le : Coo ≤ C := by
    dsimp [C]
    linarith
  have hCoi_le : Coi ≤ C := by
    dsimp [C]
    linarith
  have hCom_le : Com ≤ C := by
    dsimp [C]
    linarith
  have hCio_le : Cio ≤ C := by
    dsimp [C]
    linarith
  have hCii_le : Cii ≤ C := by
    dsimp [C]
    linarith
  have hCim_le : Cim ≤ C := by
    dsimp [C]
    linarith
  have hCmo_le : Cmo ≤ C := by
    dsimp [C]
    linarith
  have hCmi_le : Cmi ≤ C := by
    dsimp [C]
    linarith
  have hCmm_le : Cmm ≤ C := by
    dsimp [C]
    linarith
  have hA_le (D : Real) (hD : D ≤ C) :
      (1 - (1 / 32 : Real)) * (D / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hD hq.le
    · norm_num
  let Poo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Poi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pom : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .outgoing r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pio : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pii : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pim : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .incoming r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Pmo : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t)
  let Pmi : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t)
  let Pmm : Real := brrsStationaryRapidProfile N
    (brrsSurfaceWavePhase .middle r +
      brrsSurfaceWavePhase .middle s + 2 * Real.pi * t)
  let Ioo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .outgoing r s t
  let Ioi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .incoming r s t
  let Iom : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .outgoing .middle r s t
  let Iio : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .outgoing r s t
  let Iii : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .incoming r s t
  let Iim : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .incoming .middle r s t
  let Imo : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .outgoing r s t
  let Imi : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .incoming r s t
  let Imm : Complex :=
    brrsTwoRadiusStationaryComponentIntegral Phi d .middle .middle r s t
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coo / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hoo r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Poo := by
        dsimp [Poo]
        exact mul_le_mul_of_nonneg_right (hA_le Coo hCoo_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coi / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hoi r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Poi := by
        dsimp [Poi]
        exact mul_le_mul_of_nonneg_right (hA_le Coi hCoi_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIom : ‖Iom‖ ≤ A * Pom := by
    dsimp [Iom]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Com / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .outgoing r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using hom r s
          (brrsSurfaceWavePhase .outgoing r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pom := by
        dsimp [Pom]
        exact mul_le_mul_of_nonneg_right (hA_le Com hCom_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cio / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hio r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pio := by
        dsimp [Pio]
        exact mul_le_mul_of_nonneg_right (hA_le Cio hCio_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cii / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hii r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pii := by
        dsimp [Pii]
        exact mul_le_mul_of_nonneg_right (hA_le Cii hCii_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hIim : ‖Iim‖ ≤ A * Pim := by
    dsimp [Iim]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cim / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .incoming r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using him r s
          (brrsSurfaceWavePhase .incoming r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pim := by
        dsimp [Pim]
        exact mul_le_mul_of_nonneg_right (hA_le Cim hCim_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImo : ‖Imo‖ ≤ A * Pmo := by
    dsimp [Imo]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmo / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) := by
        simpa only [q] using hmo r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .outgoing s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmo := by
        dsimp [Pmo]
        exact mul_le_mul_of_nonneg_right (hA_le Cmo hCmo_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImi : ‖Imi‖ ≤ A * Pmi := by
    dsimp [Imi]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmi / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) := by
        simpa only [q] using hmi r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .incoming s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmi := by
        dsimp [Pmi]
        exact mul_le_mul_of_nonneg_right (hA_le Cmi hCmi_le)
          (brrsStationaryRapidProfile_nonneg N _)
  have hImm : ‖Imm‖ ≤ A * Pmm := by
    dsimp [Imm]
    rw [brrsTwoRadiusStationaryComponentIntegral_eq_oscillatoryExp]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cmm / q) *
          brrsStationaryRapidProfile N
            (brrsSurfaceWavePhase .middle r +
              brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) := by
        simpa only [q] using hmm r s
          (brrsSurfaceWavePhase .middle r +
            brrsSurfaceWavePhase .middle s + 2 * Real.pi * t) hr hs
      _ ≤ A * Pmm := by
        dsimp [Pmm]
        exact mul_le_mul_of_nonneg_right (hA_le Cmm hCmm_le)
          (brrsStationaryRapidProfile_nonneg N _)
  change ‖((Ioo + Ioi) + Iom) +
      (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
    A * ((Poo + Poi + Pom) + ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm)))
  calc
    ‖((Ioo + Ioi) + Iom) +
        (((Iio + Iii) + Iim) + ((Imo + Imi) + Imm))‖ ≤
        ‖(Ioo + Ioi) + Iom‖ +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := norm_add_le _ _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          ‖((Iio + Iii) + Iim) + ((Imo + Imi) + Imm)‖ := by
      exact add_le_add_left (norm_add_le _ _) _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          (‖(Iio + Iii) + Iim‖ + ‖(Imo + Imi) + Imm‖) := by
      exact add_le_add_right (norm_add_le _ _) _
    _ ≤ (‖Ioo + Ioi‖ + ‖Iom‖) +
          ((‖Iio + Iii‖ + ‖Iim‖) + (‖Imo + Imi‖ + ‖Imm‖)) := by
      apply add_le_add_right
      exact add_le_add (norm_add_le _ _) (norm_add_le _ _)
    _ ≤ ((‖Ioo‖ + ‖Ioi‖) + ‖Iom‖) +
          (((‖Iio‖ + ‖Iii‖) + ‖Iim‖) +
            ((‖Imo‖ + ‖Imi‖) + ‖Imm‖)) := by
      apply add_le_add
      · exact add_le_add_left (norm_add_le _ _) _
      · apply add_le_add
        · exact add_le_add_left (norm_add_le _ _) _
        · exact add_le_add_left (norm_add_le _ _) _
    _ ≤ ((A * Poo + A * Poi) + A * Pom) +
          (((A * Pio + A * Pii) + A * Pim) +
            ((A * Pmo + A * Pmi) + A * Pmm)) := by
      apply add_le_add
      · apply add_le_add
        · exact add_le_add hIoo hIoi
        · exact hIom
      · apply add_le_add
        · apply add_le_add
          · exact add_le_add hIio hIii
          · exact hIim
        · apply add_le_add
          · exact add_le_add hImo hImi
          · exact hImm
    _ = A * ((Poo + Poi + Pom) +
          ((Pio + Pii + Pim) + (Pmo + Pmi + Pmm))) := by ring

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### High--high two-radius four-phase profile -/

/- At two high radial positions, the endpoint/end-point contribution is
controlled by the four translated stationary profiles.  The common radial
factor is exactly the product of the two stationary-phase denominators. -/
namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- The literal five-term middle remainder is symmetric in the two radial
variables.  This exact identity lets the ordered phase-transfer estimate be
used without sacrificing the source/output radial normalization. -/
theorem brrsTwoRadiusMiddleComponentIntegralSum_swap
    (Phi : BRRSAnnularCutoff) (d : Nat) (r s t : Real) :
    brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t =
      brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t := by
  unfold brrsTwoRadiusMiddleComponentIntegralSum
  rw [brrsTwoRadiusStationaryComponentIntegral_swap Phi d .outgoing .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .incoming .middle r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .outgoing r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .incoming r s t,
    brrsTwoRadiusStationaryComponentIntegral_swap Phi d .middle .middle r s t]
  ring

theorem exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Coo, hCoo_pos, hoo⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing .outgoing
  obtain ⟨Coi, hCoi_pos, hoi⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .outgoing .incoming
  obtain ⟨Cio, hCio_pos, hio⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming .outgoing
  obtain ⟨Cii, hCii_pos, hii⟩ :=
    exists_norm_intervalIntegral_brrsTwoRadiusStationaryCoefficient_highRadius_profile_le
      (d := d) (N := N) hd Phi .incoming .incoming
  let C : Real := Coo + Coi + Cio + Cii
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let q : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let A : Real := (1 - (1 / 32 : Real)) * (C / q)
  let Poo : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let Poi : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let Pio : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let Pii : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Ioo : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .outgoing .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t - r - s)) rho
  let Ioi : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .outgoing .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t - r + s)) rho
  let Iio : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .incoming .outgoing r s rho *
      oscillatoryExp (2 * Real.pi * (t + r - s)) rho
  let Iii : Complex := ∫ rho in (1 / 32 : Real)..1,
    brrsTwoRadiusStationaryCoefficient Phi d .incoming .incoming r s rho *
      oscillatoryExp (2 * Real.pi * (t + r + s)) rho
  have hq : 0 < q := by
    dsimp [q]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hCoo_le : Coo ≤ C := by
    dsimp [C]
    linarith
  have hCoi_le : Coi ≤ C := by
    dsimp [C]
    linarith
  have hCio_le : Cio ≤ C := by
    dsimp [C]
    linarith
  have hCii_le : Cii ≤ C := by
    dsimp [C]
    linarith
  have hAoo : (1 - (1 / 32 : Real)) * (Coo / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoo_le hq.le
    · norm_num
  have hAoi : (1 - (1 / 32 : Real)) * (Coi / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCoi_le hq.le
    · norm_num
  have hAio : (1 - (1 / 32 : Real)) * (Cio / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCio_le hq.le
    · norm_num
  have hAii : (1 - (1 / 32 : Real)) * (Cii / q) ≤ A := by
    dsimp [A]
    apply mul_le_mul_of_nonneg_left
    · exact div_le_div_of_nonneg_right hCii_le hq.le
    · norm_num
  have hPoo : 0 ≤ Poo := by
    dsimp [Poo]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPoi : 0 ≤ Poi := by
    dsimp [Poi]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPio : 0 ≤ Pio := by
    dsimp [Pio]
    exact brrsStationaryRapidProfile_nonneg N _
  have hPii : 0 ≤ Pii := by
    dsimp [Pii]
    exact brrsStationaryRapidProfile_nonneg N _
  have hIoo : ‖Ioo‖ ≤ A * Poo := by
    dsimp [Ioo, Poo]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coo / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) := by
        simpa only [q] using hoo r s (2 * Real.pi * (t - r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) :=
        mul_le_mul_of_nonneg_right hAoo hPoo
  have hIoi : ‖Ioi‖ ≤ A * Poi := by
    dsimp [Ioi, Poi]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Coi / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) := by
        simpa only [q] using hoi r s (2 * Real.pi * (t - r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) :=
        mul_le_mul_of_nonneg_right hAoi hPoi
  have hIio : ‖Iio‖ ≤ A * Pio := by
    dsimp [Iio, Pio]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cio / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) := by
        simpa only [q] using hio r s (2 * Real.pi * (t + r - s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) :=
        mul_le_mul_of_nonneg_right hAio hPio
  have hIii : ‖Iii‖ ≤ A * Pii := by
    dsimp [Iii, Pii]
    calc
      _ ≤ (1 - (1 / 32 : Real)) * (Cii / q) *
          brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) := by
        simpa only [q] using hii r s (2 * Real.pi * (t + r + s)) hr hs
      _ ≤ A * brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s)) :=
        mul_le_mul_of_nonneg_right hAii hPii
  have hsum :
      brrsTwoRadiusEndpointIntegralSum Phi d r s t = Ioo + Ioi + Iio + Iii := by
    dsimp [Ioo, Ioi, Iio, Iii]
    exact brrsTwoRadiusEndpointIntegralSum_eq_four_phase_integrals Phi d r s t
  rw [hsum]
  calc
    ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by
      calc
        ‖Ioo + Ioi + Iio + Iii‖ ≤ ‖Ioo + Ioi + Iio‖ + ‖Iii‖ := norm_add_le _ _
        _ ≤ (‖Ioo + Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ ≤ (‖Ioo‖ + ‖Ioi‖ + ‖Iio‖) + ‖Iii‖ := by
          gcongr
          exact norm_add_le _ _
        _ = ‖Ioo‖ + ‖Ioi‖ + ‖Iio‖ + ‖Iii‖ := by ring
    _ ≤ A * Poo + A * Poi + A * Pio + A * Pii := by gcongr
    _ = A * (Poo + Poi + Pio + Pii) := by ring
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

/-- In the ordered high--high region, all five literal middle-wave
components obey the same four-sign profile bound as the endpoint kernel.
The displayed half-density is deliberately kept visible: after polar source
normalization it is exactly the factor `(s / r)^((d - 1) / 2)` in BRRS
(5.4). -/
theorem exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le_of_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s → s ≤ r →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  let M : Nat := d + 2 * N
  have hM : 2 ≤ M := by
    dsimp [M]
    omega
  obtain ⟨C₀, hC₀, hfive⟩ :=
    exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fivePhase_rapidProfile_le
      (d := d) (N := 2 * N) (M := M) hd hM Phi
  let L : Real := (32 : Real) ^ N *
    ((2 : Real) ^ (2 * N) * (2 * Real.pi) ^ N)
  let C : Real := 5 * L * C₀
  have hL : 0 < L := by
    dsimp [L]
    positivity
  have hC : 0 < C := by
    dsimp [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs hsr
  let R : Real := Real.sqrt (r / 16)
  let S : Real := Real.sqrt (s / 16)
  let B : Real := R ^ (d - 1) * S ^ (d - 1)
  let Dₛ : Real := 1 / S ^ (2 * N)
  let Dᵣ : Real := 1 / R ^ (2 * N)
  let δ : Real := 1 - (1 / 32 : Real)
  let P₁ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s))
  let P₂ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s))
  let P₃ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s))
  let P₄ : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  let Q₁ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - r))
  let Q₂ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + r))
  let Q₃ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t - s))
  let Q₄ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * (t + s))
  let Q₅ : Real := brrsStationaryRapidProfile (2 * N) (2 * Real.pi * t)
  have hMsub : M - 1 = (d - 1) + 2 * N := by
    dsimp [M]
    omega
  have hfive' :
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) * (Q₃ + Q₄ + Q₅) := by
    convert hfive r s t hr hs using 1 <;>
      simp only [R, S, δ, Q₁, Q₂, Q₃, Q₄, Q₅,
        brrsSurfaceWavePhase] <;> ring
  have hfactorS :
      δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) =
        (δ * (C₀ / B)) * Dₛ := by
    rw [hMsub]
    dsimp [B, Dₛ, R, S]
    calc
      δ * (C₀ /
          ((Real.sqrt (s / 16)) ^ ((d - 1) + 2 * N) *
            (Real.sqrt (r / 16)) ^ (d - 1))) =
          δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ ((d - 1) + 2 * N))) := by ring
      _ = δ * ((C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by
          rw [brrs_twoRadius_middle_denominator_factor
            (r := r) (s := s) hr hs (d - 1) N C₀]
      _ = (δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (s / 16)) ^ (2 * N))) := by ring
  have hfactorR :
      δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) =
        (δ * (C₀ / B)) * Dᵣ := by
    rw [hMsub]
    dsimp [B, Dᵣ, R, S]
    calc
      δ * (C₀ /
          ((Real.sqrt (r / 16)) ^ ((d - 1) + 2 * N) *
            (Real.sqrt (s / 16)) ^ (d - 1))) =
          δ * (C₀ /
            ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ ((d - 1) + 2 * N))) := by ring
      _ =
          δ * ((C₀ /
            ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by
        rw [brrs_twoRadius_middle_denominator_factor
          (r := s) (s := r) hs hr (d - 1) N C₀]
      _ = (δ * (C₀ /
            ((Real.sqrt (r / 16)) ^ (d - 1) *
              (Real.sqrt (s / 16)) ^ (d - 1))) *
            (1 / (Real.sqrt (r / 16)) ^ (2 * N))) := by ring
  have hphase :=
    brrs_highRadius_ordered_fiveMiddleProfiles_le_fourEndpointProfiles
      (r := r) (s := s) (t := t) hr hs hsr N
  have hphase' :
      Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅) ≤
        (5 * L) * (P₁ + P₂ + P₃ + P₄) := by
    simpa only [Dₛ, Dᵣ, Q₁, Q₂, Q₃, Q₄, Q₅, L, P₁, P₂, P₃, P₄] using hphase
  have hB : 0 < B := by
    dsimp [B, R, S]
    apply mul_pos <;> apply pow_pos <;> apply Real.sqrt_pos.2 <;> linarith
  have hδ : 0 ≤ δ := by
    dsimp [δ]
    norm_num
  have hA : 0 ≤ δ * (C₀ / B) := by
    positivity
  calc
    ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        δ * (C₀ / (S ^ (M - 1) * R ^ (d - 1))) * (Q₁ + Q₂) +
          δ * (C₀ / (R ^ (M - 1) * S ^ (d - 1))) * (Q₃ + Q₄ + Q₅) := hfive'
    _ = (δ * (C₀ / B)) * (Dₛ * (Q₁ + Q₂) + Dᵣ * (Q₃ + Q₄ + Q₅)) := by
      rw [hfactorS, hfactorR]
      ring
    _ ≤ (δ * (C₀ / B)) * ((5 * L) * (P₁ + P₂ + P₃ + P₄)) := by
      exact mul_le_mul_of_nonneg_left hphase' hA
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      dsimp [δ, C, B, R, S, P₁, P₂, P₃, P₄]
      ring

/-- The ordered middle-wave estimate is symmetric in the two radii, hence
gives a four-sign bound throughout the high--high region. -/
theorem exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨C, hC, hordered⟩ :=
    exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le_of_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  by_cases hsr : s ≤ r
  · exact hordered r s t hr hs hsr
  · have hrs : r ≤ s := le_of_not_ge hsr
    rw [brrsTwoRadiusMiddleComponentIntegralSum_swap Phi d r s t]
    have hswapped := hordered s r t hs hr hrs
    have hswapped' :
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t‖ ≤
          (1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
              (Real.sqrt (r / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
      calc
        ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d s r t‖ ≤
            (1 - (1 / 32 : Real)) *
              (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
                (Real.sqrt (r / 16)) ^ (d - 1))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) :=
          hswapped
        _ = (1 - (1 / 32 : Real)) *
              (C / ((Real.sqrt (s / 16)) ^ (d - 1) *
                (Real.sqrt (r / 16)) ^ (d - 1))) *
              (brrsStationaryRapidProfile N (2 * Real.pi * (t - s - r)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + s - r)) +
                  brrsStationaryRapidProfile N (2 * Real.pi * (t - s + r)) +
                    brrsStationaryRapidProfile N (2 * Real.pi * (t + s + r))) := by
          ring
    convert hswapped' using 1 <;> ring

/-- The exact all-nine stationary two-radius kernel has the BRRS four-sign
majorant at two high radii in every dimension `d ≥ 3`.  This combines the
endpoint waves with the genuinely absorbed middle-wave remainder; it does
not replace the literal kernel by an abstract model. -/
theorem exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ r s t : Real, 16 ≤ r → 16 ≤ s →
      ‖brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t‖ ≤
        (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
  obtain ⟨Cend, hCend, hend⟩ :=
    exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  obtain ⟨Cmid, hCmid, hmid⟩ :=
    exists_norm_brrsTwoRadiusMiddleComponentIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  let C : Real := Cend + Cmid
  have hC : 0 < C := by
    dsimp [C]
    linarith
  refine ⟨C, hC, ?_⟩
  intro r s t hr hs
  let B : Real := (Real.sqrt (r / 16)) ^ (d - 1) *
    (Real.sqrt (s / 16)) ^ (d - 1)
  let P : Real := brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
    brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
      brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
        brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))
  have hsum :
      brrsTwoRadiusAllStationaryComponentIntegralSum Phi d r s t =
        brrsTwoRadiusEndpointIntegralSum Phi d r s t +
          brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t :=
    brrsTwoRadiusAllStationaryComponentIntegralSum_eq_endpoint_add_middle
      Phi d r s t
  rw [hsum]
  calc
    ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t +
        brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ ≤
        ‖brrsTwoRadiusEndpointIntegralSum Phi d r s t‖ +
          ‖brrsTwoRadiusMiddleComponentIntegralSum Phi d r s t‖ := norm_add_le _ _
    _ ≤ (1 - (1 / 32 : Real)) * (Cend / B) * P +
          (1 - (1 / 32 : Real)) * (Cmid / B) * P := by
      dsimp [B, P]
      exact add_le_add (hend r s t hr hs) (hmid r s t hr hs)
    _ = (1 - (1 / 32 : Real)) * (C / B) * P := by
      dsimp [C]
      ring
    _ = (1 - (1 / 32 : Real)) *
          (C / ((Real.sqrt (r / 16)) ^ (d - 1) *
            (Real.sqrt (s / 16)) ^ (d - 1))) *
          (brrsStationaryRapidProfile N (2 * Real.pi * (t - r - s)) +
            brrsStationaryRapidProfile N (2 * Real.pi * (t - r + s)) +
              brrsStationaryRapidProfile N (2 * Real.pi * (t + r - s)) +
                brrsStationaryRapidProfile N (2 * Real.pi * (t + r + s))) := by
      rfl

end

end Auto.Spherical.FractalDilations.BRRS

/-! ### Dyadic high--high two-radius profile transport -/

namespace Auto.Spherical.FractalDilations.BRRS

open Set Filter MeasureTheory FourierTransform
open Auto.LittlewoodPaley
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.FractalDilations.Auxiliary
open scoped BigOperators Convolution ENNReal FourierTransform Topology

noncomputable section

/-- Every literal stationary carrier scales linearly under the common dyadic
dilation of the two radii and time.  This algebraic identity applies equally
to the endpoint and middle surface-wave parts. -/
theorem brrsDyadicTwoRadius_stationary_phase_eq_scale
    (j : Nat) (partR partS : BRRSSurfaceWavePart) (r s t : Real) :
    brrsSurfaceWavePhase partR (((2 : Real) ^ j) * r) +
        brrsSurfaceWavePhase partS (((2 : Real) ^ j) * s) +
          2 * Real.pi * (((2 : Real) ^ j) * t) =
      ((2 : Real) ^ j) *
        (brrsSurfaceWavePhase partR r + brrsSurfaceWavePhase partS s +
          2 * Real.pi * t) := by
  cases partR <;> cases partS <;> simp [brrsSurfaceWavePhase] <;> ring

/-- The level-zero endpoint four-phase estimate transports exactly to the
dyadic two-radius stationary model.  The high-radius hypotheses and every
profile retain their literal scaled variables, which is the form needed
before the radial change of variables in the block argument. -/
theorem exists_norm_brrsDyadicTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  exact norm_brrsDyadicTwoRadiusEndpointIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)

/-- Exact dyadic transport of the all-nine high--high four-sign bound.  The
left side is the literal scaled stationary kernel which occurs in the radial
formula for `brrsDyadicHalfWave`, not merely its endpoint submodel. -/
theorem exists_norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t : Real,
      16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      ‖brrsDyadicTwoRadiusAllStationaryComponentIntegralSum Phi d j r s t‖ ≤
        ‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
                brrsStationaryRapidProfile N
                  (2 * Real.pi * (((2 : Real) ^ j * t) +
                    ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
                  brrsStationaryRapidProfile N
                    (2 * Real.pi * (((2 : Real) ^ j * t) +
                      ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))))) := by
  obtain ⟨C, hC, hlevel⟩ :=
    exists_norm_brrsTwoRadiusAllStationaryComponentIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t hr hs
  exact norm_brrsDyadicTwoRadiusAllStationaryComponentIntegralSum_le_scaled_of_levelZero
    Phi d j r s t _
    (hlevel (((2 : Real) ^ j) * r) (((2 : Real) ^ j) * s)
      (((2 : Real) ^ j) * t) hr hs)

/-! ### High--high polar source normalization

The preceding dyadic kernel bound is written with the literal polar
half-densities.  The Section 5 convolution lemmas, on the other hand, take
an ordinary one-dimensional input.  The following identities make the
conversion exact: the polar input density becomes
`brrsRadialLpSourceProfile`, the remaining radius ratio is precisely the
Sobolev weight `(s / r)^s_p`, and the dyadic factor is absorbed into the
translated phase profile.
-/

/-- The real value of the scaled stationary profile is the literal dyadic
factor times the original stationary profile.  The profile itself is defined
above with its stationary-decay parameter first, so it can also be used by
the phase-line change-of-variables lemma. -/
theorem brrsDyadicStationaryPhaseProfile_toReal
    (N j : Nat) (u : Real) :
    (brrsDyadicStationaryPhaseProfile N j u).toReal =
      ((2 : Real) ^ j) * brrsStationaryRapidProfile N
        (2 * Real.pi * ((2 : Real) ^ j * u)) := by
  unfold brrsDyadicStationaryPhaseProfile
  rw [ENNReal.toReal_ofReal
    (mul_nonneg (by positivity) (brrsStationaryRapidProfile_nonneg N _))]

/-- On the positive radial half-line, taking a real value of the weighted
source profile simply recovers its displayed power of the source radius. -/
theorem brrsRadialLpSourceProfile_toReal
    {d : Nat} (p : Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    {s : Real} (hs : 0 ≤ s) :
    (brrsRadialLpSourceProfile p f w s).toReal =
      s ^ (((d : Real) - 1) / p) * ‖f (s • w)‖ := by
  unfold brrsRadialLpSourceProfile
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
    ENNReal.toReal_ofReal hs, ENNReal.toReal_ofReal (norm_nonneg _)]

/-- The Sobolev-weighted scalar source profile.  It is the input which makes
the high--high endpoint majorant a literal one-dimensional convolution: the
remaining Sobolev factor then depends only on the output radius. -/
noncomputable def brrsRadialSobolevSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) : Real → ENNReal :=
  fun s => (ENNReal.ofReal s) ^ sobolevExponent d p *
    brrsRadialLpSourceProfile p f w s

/-- The Sobolev-weighted scalar source profile is measurable whenever the
original radial datum is measurable. -/
theorem measurable_brrsRadialSobolevSourceProfile {d : Nat} (p : Real)
    (f : BRRSSpace d → Complex) (hf : Measurable f) (w : BRRSSpace d) :
    Measurable (brrsRadialSobolevSourceProfile p f w) := by
  unfold brrsRadialSobolevSourceProfile
  exact (ENNReal.continuous_rpow_const.measurable.comp
    ENNReal.continuous_ofReal.measurable).mul
      (measurable_brrsRadialLpSourceProfile p f hf w)

/-- On the compact source-radius range used in the Section 5 split, the
Sobolev weight is uniformly bounded. -/
theorem brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    brrsRadialSobolevSourceProfile p f w s ≤
      (ENNReal.ofReal 1024) ^ sobolevExponent d p *
        brrsRadialLpSourceProfile p f w s := by
  unfold brrsRadialSobolevSourceProfile
  exact mul_le_mul'
    (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hs)
      (sobolevExponent_nonneg hd hp)) le_rfl

/-- The compact-source bound is also available after passing to real values;
the finite ENNReal majorant is explicit. -/
theorem brrsRadialSobolevSourceProfile_toReal_le_const_mul_toReal_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    (brrsRadialSobolevSourceProfile p f w s).toReal ≤
      (((ENNReal.ofReal 1024) ^ sobolevExponent d p) *
        brrsRadialLpSourceProfile p f w s).toReal := by
  have hp_nonneg : 0 ≤ p := le_trans (by norm_num) hp
  have hd_nonneg : 0 ≤ (d : Real) - 1 := by
    have hd_one : (1 : Real) ≤ d := by
      exact_mod_cast (show 1 ≤ d by omega)
    linarith
  have hsource_exp : 0 ≤ ((d : Real) - 1) / p :=
    div_nonneg hd_nonneg hp_nonneg
  have hconst_top : (ENNReal.ofReal 1024) ^ sobolevExponent d p ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg (sobolevExponent_nonneg hd hp)
      ENNReal.ofReal_ne_top
  have hsource_top : brrsRadialLpSourceProfile p f w s ≠ ∞ := by
    unfold brrsRadialLpSourceProfile
    apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg hsource_exp ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  exact ENNReal.toReal_mono (ENNReal.mul_ne_top hconst_top hsource_top)
    (brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024 hd hp f w hs)

/-- Raising the compact-source estimate to the `L^p` power preserves its
explicit Sobolev constant. -/
theorem brrsRadialSobolevSourceProfile_rpow_le_const_mul_rpow_of_le_1024
    {d : Nat} {p s : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) (hs : s ≤ 1024) :
    (brrsRadialSobolevSourceProfile p f w s) ^ p ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (brrsRadialLpSourceProfile p f w s) ^ p := by
  have hp_nonneg : 0 ≤ p := le_trans (by norm_num) hp
  calc
    (brrsRadialSobolevSourceProfile p f w s) ^ p ≤
        ((ENNReal.ofReal 1024) ^ sobolevExponent d p *
          brrsRadialLpSourceProfile p f w s) ^ p :=
      ENNReal.rpow_le_rpow
        (brrsRadialSobolevSourceProfile_le_const_mul_of_le_1024
          hd hp f w hs) hp_nonneg
    _ = ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        (brrsRadialLpSourceProfile p f w s) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp_nonneg]

/-- On the compact source interval, the Sobolev-weighted `L^p` mass is
bounded by the ordinary radial source mass with the same explicit constant.
This is the direct form consumed by the Section 5 block estimates. -/
theorem brrs_lintegral_radialSobolevSourceProfile_rpow_restrict_le_of_le_1024
    {d : Nat} {p : Real} (hd : 2 ≤ d) (hp : 2 ≤ p)
    (f : BRRSSpace d → Complex) (hfm : Measurable f) (w : BRRSSpace d) :
    (∫⁻ s in Icc (0 : Real) 1024,
      (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
      ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p *
        ∫⁻ s in Icc (0 : Real) 1024,
          (brrsRadialLpSourceProfile p f w s) ^ p := by
  let C : ENNReal := ((ENNReal.ofReal 1024) ^ sobolevExponent d p) ^ p
  have hsource : Measurable (fun s : Real =>
      (brrsRadialLpSourceProfile p f w s) ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      (measurable_brrsRadialLpSourceProfile p f hfm w)
  calc
    (∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialSobolevSourceProfile p f w s) ^ p) ≤
        ∫⁻ s in Icc (0 : Real) 1024,
          C * (brrsRadialLpSourceProfile p f w s) ^ p := by
      apply setLIntegral_mono' measurableSet_Icc
      intro s hs
      simpa only [C] using
        brrsRadialSobolevSourceProfile_rpow_le_const_mul_rpow_of_le_1024
          hd hp f w hs.2
    _ = C * ∫⁻ s in Icc (0 : Real) 1024,
        (brrsRadialLpSourceProfile p f w s) ^ p := by
      rw [lintegral_const_mul C hsource]

/-- On the positive half-line, the real value of the Sobolev-weighted source
is the product of the Sobolev radial power and the ordinary `L^p` source
profile. -/
theorem brrsRadialSobolevSourceProfile_toReal
    {d : Nat} (p : Real) (f : BRRSSpace d → Complex) (w : BRRSSpace d)
    {s : Real} (hs : 0 ≤ s) :
    (brrsRadialSobolevSourceProfile p f w s).toReal =
      s ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
  unfold brrsRadialSobolevSourceProfile
  rw [ENNReal.toReal_mul, ← ENNReal.toReal_rpow,
    ENNReal.toReal_ofReal hs]

/-- The source/output radius ratio in the high--high majorant factors into
the output Section 5 weight and the Sobolev-weighted scalar input.  Thus the
four endpoint phase terms are literally profile convolutions against one
fixed source function. -/
theorem brrs_radiusRatio_mul_radialLpSourceProfile_toReal_eq
    {d : Nat} {p r s : Real} (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal =
      r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  rw [brrsRadialSobolevSourceProfile_toReal p f w hs.le]
  rw [Real.div_rpow hs.le hr.le]
  rw [show s ^ sobolevExponent d p / r ^ sobolevExponent d p =
      s ^ sobolevExponent d p *
        (r ^ sobolevExponent d p)⁻¹ by rw [div_eq_mul_inv]]
  rw [← Real.rpow_neg hr.le]
  ring

/-- The exact half-density/Sobolev-weight identity.  This is the pointwise
source normalization behind the high--high radial reduction. -/
theorem brrs_highHigh_halfDensity_source_weight_eq
    {d : Nat} {p r s : Real} (hp : p ≠ 0) (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
      (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
  rw [brrsRadialLpSourceProfile_toReal p f w hs.le]
  let a : Real := (d : Real) - 1
  let b : Real := a * (1 / 2 - 1 / p)
  have hb1 : a / p + -(a / 2) = -b := by
    dsimp [b]
    field_simp [hp]
    ring
  have hb2 : b + a / p = a / 2 := by
    dsimp [b]
    field_simp [hp]
    ring
  change r ^ (a / p) * (r ^ (-(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖) =
    (s / r) ^ b * (s ^ (a / p) * ‖f (s • w)‖)
  calc
    r ^ (a / p) * (r ^ (-(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖) =
        (r ^ (a / p) * r ^ (-(a / 2))) * s ^ (a / 2) * ‖f (s • w)‖ := by ring
    _ = r ^ (a / p + -(a / 2)) * s ^ (a / 2) * ‖f (s • w)‖ := by
      rw [Real.rpow_add hr]
    _ = r ^ (-b) * s ^ (a / 2) * ‖f (s • w)‖ := by rw [hb1]
    _ = (r ^ b)⁻¹ * (s ^ b * s ^ (a / p)) * ‖f (s • w)‖ := by
      rw [Real.rpow_neg hr.le, ← Real.rpow_add hs, hb2]
    _ = (s / r) ^ b * (s ^ (a / p) * ‖f (s • w)‖) := by
      rw [Real.div_rpow hs.le hr.le]
      ring

/-- The exact power conjugation used in the Section 5 radial Bessel-kernel
reduction.  Multiplying the half-density kernel bound by the output radial
`L^p` factor turns it into the (5.4) output weight
`r ^ (-s_p)` times the one-dimensional Sobolev-weighted source profile.
No kernel estimate is used in this identity. -/
theorem brrsRadialBesselKernel_weightConjugation_eq
    {d : Nat} {p r s : Real} (hp : p ≠ 0) (hr : 0 < r) (hs : 0 < s)
    (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
      r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal := by
  calc
    r ^ (((d : Real) - 1) / p) *
        (r ^ (-(((d : Real) - 1) / 2)) *
          s ^ (((d : Real) - 1) / 2) * ‖f (s • w)‖) =
        (s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal :=
      brrs_highHigh_halfDensity_source_weight_eq hp hr hs f w
    _ = r ^ (-sobolevExponent d p) *
        (brrsRadialSobolevSourceProfile p f w s).toReal :=
      brrs_radiusRatio_mul_radialLpSourceProfile_toReal_eq hr hs f w

/-- A purely algebraic normalization of the two high-radius half-densities.
It is kept in a form independent of the stationary kernel, so the same
calculation can be reused by every endpoint and middle-wave profile. -/
theorem brrs_highHigh_prefactor_rpow_eq
    {q r s n : Real} (hq : 0 < q) (hr : 0 < r) (hs : 0 < s) :
    q ^ (n + 1) /
        ((q * r / 16) ^ (n / 2) * (q * s / 16) ^ (n / 2)) =
      q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2))) := by
  have h16 : (0 : Real) < 16 := by norm_num
  have hq0 : 0 ≤ q := hq.le
  have hr0 : 0 ≤ r := hr.le
  have hs0 : 0 ≤ s := hs.le
  rw [Real.div_rpow (mul_nonneg hq0 hr0) (by norm_num),
    Real.div_rpow (mul_nonneg hq0 hs0) (by norm_num)]
  rw [Real.mul_rpow hq0 hr0, Real.mul_rpow hq0 hs0]
  have hden :
      (q ^ (n / 2) * r ^ (n / 2) / 16 ^ (n / 2)) *
          (q ^ (n / 2) * s ^ (n / 2) / 16 ^ (n / 2)) =
        (q ^ (n / 2) * q ^ (n / 2)) * (r ^ (n / 2) * s ^ (n / 2)) /
          (16 ^ (n / 2) * 16 ^ (n / 2)) := by
    field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _),
      ne_of_gt (Real.rpow_pos_of_pos hr _),
      ne_of_gt (Real.rpow_pos_of_pos hs _),
      ne_of_gt (Real.rpow_pos_of_pos h16 _)]
  rw [hden]
  rw [show q ^ (n / 2) * q ^ (n / 2) = q ^ n by
    rw [← Real.rpow_add hq]
    congr 1
    ring]
  rw [show 16 ^ (n / 2) * 16 ^ (n / 2) = (16 : Real) ^ n by
    rw [← Real.rpow_add h16]
    congr 1
    ring]
  rw [show q ^ (n + 1) = q ^ n * q by
    rw [Real.rpow_add hq, Real.rpow_one]]
  rw [show r ^ (-(n / 2)) = (r ^ (n / 2))⁻¹ by
    rw [Real.rpow_neg hr.le],
    show s ^ (-(n / 2)) = (s ^ (n / 2))⁻¹ by
      rw [Real.rpow_neg hs.le]]
  field_simp [ne_of_gt (Real.rpow_pos_of_pos hq _),
    ne_of_gt (Real.rpow_pos_of_pos hr _),
    ne_of_gt (Real.rpow_pos_of_pos hs _),
    ne_of_gt (Real.rpow_pos_of_pos h16 _)]

/-- The literal coefficient in the dyadic high--high endpoint estimate has
exactly one remaining dyadic factor after its two radial half-densities are
cancelled. -/
theorem brrsDyadicHighHigh_prefactor_eq
    {d j : Nat} (hd : 1 ≤ d) {r s : Real} (hr : 0 < r) (hs : 0 < s) :
    ‖((2 : Real) ^ j) ^ d‖ /
        ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
          (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1)) =
      ((2 : Real) ^ j) * 16 ^ ((d : Real) - 1) *
        (r ^ (-(((d : Real) - 1) / 2)) * s ^ (-(((d : Real) - 1) / 2))) := by
  let q : Real := (2 : Real) ^ j
  let n : Real := (d : Real) - 1
  have hq : 0 < q := by
    dsimp [q]
    positivity
  have hnum : ‖q ^ d‖ = q ^ (n + 1) := by
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hq.le _),
      ← Real.rpow_natCast]
    dsimp [n]
    congr 1
    ring
  have hsqrtr : (Real.sqrt (q * r / 16)) ^ (d - 1) =
      (q * r / 16) ^ (n / 2) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast,
      ← Real.rpow_mul (by positivity)]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
    ring
  have hsqrts : (Real.sqrt (q * s / 16)) ^ (d - 1) =
      (q * s / 16) ^ (n / 2) := by
    rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast,
      ← Real.rpow_mul (by positivity)]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
    ring
  change ‖q ^ d‖ /
      ((Real.sqrt (q * r / 16)) ^ (d - 1) *
        (Real.sqrt (q * s / 16)) ^ (d - 1)) =
      q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2)))
  rw [hnum, hsqrtr, hsqrts]
  exact brrs_highHigh_prefactor_rpow_eq hq hr hs

/-- Multiplying the literal dyadic high--high coefficient by the polar
source density and the output `L^p` radial factor yields exactly the Section
5 source profile with its Sobolev radius weight. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_eq
    {d j : Nat} (hd : 1 ≤ d) {p r s : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        ((‖((2 : Real) ^ j) ^ d‖ /
          ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
          (s ^ (d - 1) * ‖f (s • w)‖)) =
      16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) * ((2 : Real) ^ j) := by
  let n : Real := (d : Real) - 1
  let q : Real := (2 : Real) ^ j
  have hspow : s ^ (d - 1) = s ^ n := by
    rw [← Real.rpow_natCast]
    dsimp [n]
    norm_num [Nat.cast_sub hd]
  have hscombine : s ^ (-(n / 2)) * s ^ n = s ^ (n / 2) := by
    rw [← Real.rpow_add hs]
    congr 1
    ring
  have hhalf : r ^ (n / p) *
      (r ^ (-(n / 2)) * s ^ (n / 2) * ‖f (s • w)‖) =
      (s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal := by
    dsimp [n]
    exact brrs_highHigh_halfDensity_source_weight_eq hp hr hs f w
  change r ^ (n / p) *
      ((‖q ^ d‖ /
        ((Real.sqrt (q * r / 16)) ^ (d - 1) *
          (Real.sqrt (q * s / 16)) ^ (d - 1))) *
        (s ^ (d - 1) * ‖f (s • w)‖)) =
      16 ^ n * ((s / r) ^ sobolevExponent d p *
        (brrsRadialLpSourceProfile p f w s).toReal) * q
  rw [hspow, brrsDyadicHighHigh_prefactor_eq hd hr hs]
  calc
    r ^ (n / p) *
        ((q * 16 ^ n * (r ^ (-(n / 2)) * s ^ (-(n / 2)))) *
          (s ^ n * ‖f (s • w)‖)) =
        16 ^ n * q *
          (r ^ (n / p) * (r ^ (-(n / 2)) *
            (s ^ (-(n / 2)) * s ^ n) * ‖f (s • w)‖)) := by ring
    _ = 16 ^ n * q *
          (r ^ (n / p) * (r ^ (-(n / 2)) *
            s ^ (n / 2) * ‖f (s • w)‖)) := by rw [hscombine]
    _ = 16 ^ n * q *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) := by rw [hhalf]
    _ = 16 ^ n * ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) * q := by ring

/-- The four literal endpoint phases in the dyadic high--high kernel become
the four translated copies of the single scalar phase profile.  Together
with `brrsDyadicHighHigh_prefactor_polar_source_eq`, this is the pointwise
bridge from the kernel estimate to the four Section 5 convolution inputs;
no outer radial integration is used here. -/
theorem brrsDyadicHighHigh_prefactor_polar_source_fourPhase_eq
    {d j N : Nat} (hd : 1 ≤ d) {p r s t : Real} (hp : p ≠ 0)
    (hr : 0 < r) (hs : 0 < s) (f : BRRSSpace d → Complex) (w : BRRSSpace d) :
    r ^ (((d : Real) - 1) / p) *
        ((‖((2 : Real) ^ j) ^ d‖ /
          ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
            (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (brrsStationaryRapidProfile N
            (2 * Real.pi * (((2 : Real) ^ j * t) -
              ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
          brrsStationaryRapidProfile N
            (2 * Real.pi * (((2 : Real) ^ j * t) -
              ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s))) +
            brrsStationaryRapidProfile N
              (2 * Real.pi * (((2 : Real) ^ j * t) +
                ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
              brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) +
                  ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s)))) =
      16 ^ ((d : Real) - 1) *
        ((s / r) ^ sobolevExponent d p *
          (brrsRadialLpSourceProfile p f w s).toReal) *
        ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
          (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
  rw [brrsDyadicHighHigh_prefactor_polar_source_eq hd hp hr hs f w]
  rw [brrsDyadicStationaryPhaseProfile_toReal N j (t - r - s),
    brrsDyadicStationaryPhaseProfile_toReal N j (t - r + s),
    brrsDyadicStationaryPhaseProfile_toReal N j (t + r - s),
    brrsDyadicStationaryPhaseProfile_toReal N j (t + r + s)]
  have hsubsub : ((2 : Real) ^ j) * (t - r - s) =
      ((2 : Real) ^ j * t) - ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s) := by
    ring
  have hsubadd : ((2 : Real) ^ j) * (t - r + s) =
      ((2 : Real) ^ j * t) - ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s) := by
    ring
  have haddsub : ((2 : Real) ^ j) * (t + r - s) =
      ((2 : Real) ^ j * t) + ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s) := by
    ring
  have haddadd : ((2 : Real) ^ j) * (t + r + s) =
      ((2 : Real) ^ j * t) + ((2 : Real) ^ j * r) + ((2 : Real) ^ j * s) := by
    ring
  rw [hsubsub, hsubadd, haddsub, haddadd]
  ring

/-- The dyadic high--high endpoint kernel, after multiplication by the polar
source density and the output radial `L^p` factor, is bounded by the four
literal scalar phase profiles with precisely the Section 5 Sobolev weight.
This is a pointwise statement on a high--high radial block; the subsequent
block and convolution estimates can therefore be applied without any further
kernel normalization. -/
theorem exists_brrsDyadicHighHigh_endpoint_radial_fourPhase_block_le
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ r s t p : Real,
      ∀ f : BRRSSpace d → Complex, ∀ w : BRRSSpace d,
      0 < p → 16 ≤ ((2 : Real) ^ j) * r → 16 ≤ ((2 : Real) ^ j) * s →
      r ^ (((d : Real) - 1) / p) *
          (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
            (s ^ (d - 1) * ‖f (s • w)‖)) ≤
        (1 - (1 / 32 : Real)) * C * 16 ^ ((d : Real) - 1) *
          ((s / r) ^ sobolevExponent d p *
            (brrsRadialLpSourceProfile p f w s).toReal) *
          ((brrsDyadicStationaryPhaseProfile N j (t - r - s)).toReal +
            (brrsDyadicStationaryPhaseProfile N j (t - r + s)).toReal +
              (brrsDyadicStationaryPhaseProfile N j (t + r - s)).toReal +
                (brrsDyadicStationaryPhaseProfile N j (t + r + s)).toReal) := by
  obtain ⟨C, hC, hprofile⟩ :=
    exists_norm_brrsDyadicTwoRadiusEndpointIntegralSum_highRadius_fourPhase_profile_le
      (d := d) (N := N) hd Phi
  refine ⟨C, hC, ?_⟩
  intro j r s t p f w hp hr hs
  have hqpos : 0 < (2 : Real) ^ j := by positivity
  have hrpos : 0 < r := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hr)
    exact hqpos.le
  have hspos : 0 < s := by
    apply pos_of_mul_pos_right
      (lt_of_lt_of_le (by norm_num) hs)
    exact hqpos.le
  have hdenpos : 0 <
      (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
        (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) := by
    apply mul_pos
    · apply pow_pos
      apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hrpos) (by norm_num)
    · apply pow_pos
      apply Real.sqrt_pos.mpr
      exact div_pos (mul_pos hqpos hspos) (by norm_num)
  have hdenne :
      (Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
        (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1) ≠ 0 :=
    ne_of_gt hdenpos
  have hradial : 0 ≤ r ^ (((d : Real) - 1) / p) :=
    Real.rpow_nonneg hrpos.le _
  have hdensity : 0 ≤ s ^ (d - 1) * ‖f (s • w)‖ :=
    mul_nonneg (pow_nonneg hspos.le _) (norm_nonneg _)
  have hkernel := hprofile j r s t hr hs
  calc
    r ^ (((d : Real) - 1) / p) *
        (‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ *
          (s ^ (d - 1) * ‖f (s • w)‖)) =
        (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
          ‖brrsDyadicTwoRadiusEndpointIntegralSum Phi d j r s t‖ := by ring
    _ ≤ (r ^ (((d : Real) - 1) / p) *
          (s ^ (d - 1) * ‖f (s • w)‖)) *
        (‖((2 : Real) ^ j) ^ d‖ *
          ((1 - (1 / 32 : Real)) *
            (C / ((Real.sqrt ((((2 : Real) ^ j) * r) / 16)) ^ (d - 1) *
              (Real.sqrt ((((2 : Real) ^ j) * s) / 16)) ^ (d - 1))) *
            (brrsStationaryRapidProfile N
                (2 * Real.pi * (((2 : Real) ^ j * t) -
                  ((2 : Real) ^ j * r) - ((2 : Real) ^ j * s))) +
