theorem exists_norm_brrsDyadicHalfWave_outer_weighted_sourceProfile_one_le_at_point
    {d N : Nat} (hd : 3 ≤ d) (Phi : BRRSAnnularCutoff) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat, ∀ x : BRRSSpace d, ∀ t : Real,
      ∀ f : BRRSSchwartz d,
