  (⨆ r : E, ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
    surfaceFourier d (-r.1 • ξ) *
      (φ (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • ξ)) -
        φ (((2 : ℝ) ^ j)⁻¹ • (r.1 • ξ))) *
      𝓕 (f : Euclidean d → ℂ) ξ) x‖).toReal

