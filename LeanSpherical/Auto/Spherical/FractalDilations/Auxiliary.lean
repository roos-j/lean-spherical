/-!
# Exponent regions for fractal spherical maximal estimates

The points and regions in this file are the exponent geometry from
Anderson--Hughes--Roos--Seeger.  An exponent point `(u, v)` stands for
`u = 1 / p` and `v = 1 / q`.

`Q d beta gamma` is the closed convex quadrilateral from (1.4), while
`R d beta gamma` is its open interior together with the half-open diagonal
segment which is relevant to the strong-type theorem.
-/
open Set

noncomputable section

/-- Coordinates in the reciprocal-exponent plane: `(1 / p, 1 / q)`. -/
abbrev ExponentPoint := ℝ × ℝ

/-- The origin of the exponent diagram. -/
def Q1 : ExponentPoint := (0, 0)

/-- The diagonal Minkowski endpoint in the exponent diagram. -/
def Q2 (d : ℕ) (beta : ℝ) : ExponentPoint :=
  let D : ℝ := d
  ((D - 1) / (D - 1 + beta), (D - 1) / (D - 1 + beta))

/-- The upper Minkowski endpoint in the exponent diagram. -/
def Q3 (d : ℕ) (beta : ℝ) : ExponentPoint :=
  let D : ℝ := d
  ((D - beta) / (D - beta + 1), 1 / (D - beta + 1))

/-- The endpoint controlled by the quasi-Assouad dimension. -/
def Q4 (d : ℕ) (gamma : ℝ) : ExponentPoint :=
  let D : ℝ := d
  (D * (D - 1) / (D ^ 2 + 2 * gamma - 1),
    (D - 1) / (D ^ 2 + 2 * gamma - 1))

/-- The four vertices of the closed exponent region. -/
def exponentVertices (d : ℕ) (beta gamma : ℝ) : Set ExponentPoint :=
  {Q1, Q2 d beta, Q3 d beta, Q4 d gamma}

/-- The closed convex exponent region `Q(beta, gamma)` of the paper. -/
def Q (d : ℕ) (beta gamma : ℝ) : Set ExponentPoint :=
  convexHull ℝ (exponentVertices d beta gamma)

/-- The half-open diagonal segment `Seg(beta)` of the paper. -/
def Seg (d : ℕ) (beta : ℝ) : Set ExponentPoint :=
  segment ℝ Q1 (Q2 d beta) \ {Q2 d beta}

/-- The strong-type exponent region `R(beta, gamma)` of the paper. -/
def R (d : ℕ) (beta gamma : ℝ) : Set ExponentPoint :=
  Seg d beta ∪ interior (Q d beta gamma)

/-! ## Elementary properties of the closed region -/

theorem exponentVertices_finite (d : ℕ) (beta gamma : ℝ) :
    (exponentVertices d beta gamma).Finite := by
  simp only [exponentVertices]
  exact (finite_singleton _).insert _ |>.insert _ |>.insert _

theorem convex_Q (d : ℕ) (beta gamma : ℝ) : Convex ℝ (Q d beta gamma) :=
  convex_convexHull _ _

theorem isClosed_Q (d : ℕ) (beta gamma : ℝ) : IsClosed (Q d beta gamma) := by
  exact (exponentVertices_finite d beta gamma).isClosed_convexHull ℝ

theorem isCompact_Q (d : ℕ) (beta gamma : ℝ) : IsCompact (Q d beta gamma) := by
  exact (exponentVertices_finite d beta gamma).isCompact_convexHull ℝ

theorem Q1_mem_exponentVertices (d : ℕ) (beta gamma : ℝ) :
    Q1 ∈ exponentVertices d beta gamma := by
  simp [exponentVertices]

theorem Q2_mem_exponentVertices (d : ℕ) (beta gamma : ℝ) :
    Q2 d beta ∈ exponentVertices d beta gamma := by
  simp [exponentVertices]

theorem Q3_mem_exponentVertices (d : ℕ) (beta gamma : ℝ) :
    Q3 d beta ∈ exponentVertices d beta gamma := by
  simp [exponentVertices]

theorem Q4_mem_exponentVertices (d : ℕ) (beta gamma : ℝ) :
    Q4 d gamma ∈ exponentVertices d beta gamma := by
  simp [exponentVertices]

theorem exponentVertices_subset_Q (d : ℕ) (beta gamma : ℝ) :
    exponentVertices d beta gamma ⊆ Q d beta gamma :=
  subset_convexHull ℝ _

theorem Q1_mem_Q (d : ℕ) (beta gamma : ℝ) : Q1 ∈ Q d beta gamma :=
  exponentVertices_subset_Q d beta gamma (Q1_mem_exponentVertices d beta gamma)

theorem Q2_mem_Q (d : ℕ) (beta gamma : ℝ) : Q2 d beta ∈ Q d beta gamma :=
  exponentVertices_subset_Q d beta gamma (Q2_mem_exponentVertices d beta gamma)

theorem Q3_mem_Q (d : ℕ) (beta gamma : ℝ) : Q3 d beta ∈ Q d beta gamma :=
  exponentVertices_subset_Q d beta gamma (Q3_mem_exponentVertices d beta gamma)

theorem Q4_mem_Q (d : ℕ) (beta gamma : ℝ) : Q4 d gamma ∈ Q d beta gamma :=
  exponentVertices_subset_Q d beta gamma (Q4_mem_exponentVertices d beta gamma)

/-! ## The half-open segment and the strong-type region -/

theorem Seg_subset_Q (d : ℕ) (beta gamma : ℝ) :
    Seg d beta ⊆ Q d beta gamma := by
  intro x hx
  exact (convex_Q d beta gamma).segment_subset
    (Q1_mem_Q d beta gamma) (Q2_mem_Q d beta gamma) hx.1

theorem Seg_subset_R (d : ℕ) (beta gamma : ℝ) :
    Seg d beta ⊆ R d beta gamma :=
  subset_union_left

theorem interior_Q_subset_R (d : ℕ) (beta gamma : ℝ) :
    interior (Q d beta gamma) ⊆ R d beta gamma :=
  subset_union_right

theorem R_subset_Q (d : ℕ) (beta gamma : ℝ) :
    R d beta gamma ⊆ Q d beta gamma := by
  apply union_subset
  · exact Seg_subset_Q d beta gamma
  · exact interior_subset

theorem Q1_mem_Seg_iff (d : ℕ) (beta : ℝ) :
    Q1 ∈ Seg d beta ↔ Q1 ≠ Q2 d beta := by
  constructor
  · intro h hEq
    exact h.2 (mem_singleton_iff.mpr hEq)
  · intro h
    exact ⟨left_mem_segment ℝ Q1 (Q2 d beta), h⟩

theorem Q2_not_mem_Seg (d : ℕ) (beta : ℝ) : Q2 d beta ∉ Seg d beta := by
  simp [Seg]

theorem Q2_not_mem_R_of_not_mem_interior (d : ℕ) (beta gamma : ℝ)
    (h : Q2 d beta ∉ interior (Q d beta gamma)) : Q2 d beta ∉ R d beta gamma := by
  simp only [R, mem_union, Q2_not_mem_Seg, false_or]
  exact h

theorem R_subset_Q_closure (d : ℕ) (beta gamma : ℝ) :
    closure (R d beta gamma) ⊆ Q d beta gamma := by
  exact closure_minimal (R_subset_Q d beta gamma) (isClosed_Q d beta gamma)

end
end Former_ExponentRegions

/- ===== Foundational portion of former FractalDilations/Maximal.lean ===== -/
section Former_MaximalBase
open Auto.HardyLittlewoodMaximal
open Auto.Spherical.Auxiliary
open Auto.Spherical.SurfaceMeasureDecay
open MeasureTheory Set
noncomputable section
/-- The normalized spherical maximal operator with radii restricted to `E`.
The output is extended nonnegative real-valued so that the supremum is total.
-/
def fractalSphericalMaximal (d : ℕ) (E : Set ℝ) (f : Euclidean d → ℂ)
    (x : Euclidean d) : ENNReal :=
  ⨆ t : E, ENNReal.ofReal ‖normalizedSphericalAverage d f t.1 x‖

/-- The real-valued version of `fractalSphericalMaximal` used for `MemLp`
statements on Schwartz data. -/
def fractalSphericalMaximalReal (d : ℕ) (E : Set ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) : ℝ :=
  (fractalSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal

/-- A radius belonging to `E` contributes to the fractal maximal operator. -/
theorem normalizedSphericalAverage_le_fractalSphericalMaximal
    {d : ℕ} (E : Set ℝ) (f : Euclidean d → ℂ) {t : ℝ} (ht : t ∈ E)
    (x : Euclidean d) :
    ENNReal.ofReal ‖normalizedSphericalAverage d f t x‖ ≤
      fractalSphericalMaximal d E f x := by
  exact le_iSup
    (fun s : E => ENNReal.ofReal ‖normalizedSphericalAverage d f s.1 x‖)
    ⟨t, ht⟩

/-- Enlarging the set of radii can only enlarge the maximal operator. -/
theorem fractalSphericalMaximal_mono
    {d : ℕ} {E F : Set ℝ} (hEF : E ⊆ F) (f : Euclidean d → ℂ)
    (x : Euclidean d) :
    fractalSphericalMaximal d E f x ≤ fractalSphericalMaximal d F f x := by
  unfold fractalSphericalMaximal
  refine iSup_le fun t => ?_
  exact le_iSup
    (fun s : F => ENNReal.ofReal ‖normalizedSphericalAverage d f s.1 x‖)
    ⟨t.1, hEF t.2⟩

/-- The restricted maximal operator is subadditive on continuous data. -/
theorem fractalSphericalMaximal_add_le
    {d : ℕ} (E : Set ℝ) (f g : Euclidean d → ℂ)
    (hf : Continuous f) (hg : Continuous g) (x : Euclidean d) :
    fractalSphericalMaximal d E (f + g) x ≤
      fractalSphericalMaximal d E f x + fractalSphericalMaximal d E g x := by
  unfold fractalSphericalMaximal
  apply iSup_le
  intro r
  have hint (h : Euclidean d → ℂ) (hh : Continuous h) : Integrable
      (fun ω : Metric.sphere (0 : Euclidean d) 1 => h (x + r.1 • (ω : Euclidean d)))
      (unitSurfaceMeasure d) := by
    apply Continuous.integrable_of_hasCompactSupport
    · exact hh.comp
        ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => x).add
          ((continuous_const : Continuous fun _ : Metric.sphere (0 : Euclidean d) 1 => r.1).smul
            continuous_subtype_val))
    · exact HasCompactSupport.of_compactSpace _
  have havg : normalizedSphericalAverage d (f + g) r.1 x =
      normalizedSphericalAverage d f r.1 x + normalizedSphericalAverage d g r.1 x := by
    unfold normalizedSphericalAverage sphericalAverage
    change (surfaceMass d : ℂ)⁻¹ *
        ∫ ω : Metric.sphere (0 : Euclidean d) 1,
          (f (x + r.1 • (ω : Euclidean d)) + g (x + r.1 • (ω : Euclidean d)))
          ∂unitSurfaceMeasure d = _
    rw [MeasureTheory.integral_add (hint f hf) (hint g hg), mul_add]
  rw [havg]
  calc
    ENNReal.ofReal ‖normalizedSphericalAverage d f r.1 x +
        normalizedSphericalAverage d g r.1 x‖ ≤
        ENNReal.ofReal (‖normalizedSphericalAverage d f r.1 x‖ +
          ‖normalizedSphericalAverage d g r.1 x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖normalizedSphericalAverage d f r.1 x‖ +
        ENNReal.ofReal ‖normalizedSphericalAverage d g r.1 x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ (⨆ s : E, ENNReal.ofReal ‖normalizedSphericalAverage d f s.1 x‖) +
        ⨆ s : E, ENNReal.ofReal ‖normalizedSphericalAverage d g s.1 x‖ := by
      gcongr
      · exact le_iSup (fun s : E => ENNReal.ofReal
          ‖normalizedSphericalAverage d f s.1 x‖) r
      · exact le_iSup (fun s : E => ENNReal.ofReal
          ‖normalizedSphericalAverage d g s.1 x‖) r

/-- The supremum over an arbitrary set of radii is measurable on continuous
data.  This uses lower semicontinuity, so neither countability nor closedness
of `E` is needed. -/
theorem measurable_fractalSphericalMaximal {d : ℕ} (E : Set ℝ)
    (f : Euclidean d → ℂ) (hf : Continuous f) :
    Measurable (fractalSphericalMaximal d E f) := by
  let F : ℝ × Euclidean d → ℂ := fun p => normalizedSphericalAverage d f p.1 p.2
  have hF : Continuous F := by
    unfold F normalizedSphericalAverage
    exact continuous_const.mul (continuous_sphericalAverage f hf)
  have hG : Measurable (⨆ r : E, fun x : Euclidean d =>
      ENNReal.ofReal ‖F (r.1, x)‖) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro r
      exact (ENNReal.continuous_ofReal.comp
        ((hF.comp (continuous_const.prodMk continuous_id)).norm)).measurable
    · intro x
      exact (ENNReal.continuous_ofReal.comp
        ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm)).lowerSemicontinuous
  have hEq : fractalSphericalMaximal d E f =
      ⨆ r : E, fun x : Euclidean d => ENNReal.ofReal ‖F (r.1, x)‖ := by
    funext x
    exact (iSup_apply
      (f := fun r : E => fun x : Euclidean d => ENNReal.ofReal ‖F (r.1, x)‖)
      (a := x)).symm
  rw [hEq]
  exact hG

/-- Measurability of the real-valued restricted maximal operator on Schwartz
data. -/
theorem measurable_fractalSphericalMaximalReal {d : ℕ} (E : Set ℝ)
    (f : SchwartzMap (Euclidean d) ℂ) :
    Measurable (fractalSphericalMaximalReal d E f) := by
  unfold fractalSphericalMaximalReal
  exact ENNReal.measurable_toReal.comp
    (measurable_fractalSphericalMaximal E (f : Euclidean d → ℂ) f.continuous)

end
end Former_MaximalBase

/- ===== Foundational portion of former FractalDilations/Definitions.lean ===== -/
section Former_DefinitionsBase
open Auto.FractalDimensions
open Auto.Spherical.FractalDilations.Auxiliary
open Auto.Spherical.FractalDilations.Auxiliary
open Auto.FractalDimensions
open Auto.Spherical.SurfaceMeasureDecay
open MeasureTheory Set
noncomputable section
/-- The reciprocal-exponent point associated to finite positive exponents. -/
def reciprocalExponentPoint (p q : ℝ) : ExponentPoint := (p⁻¹, q⁻¹)

/-- Strong `Lᵖ → Lᑫ` boundedness of the local spherical maximal operator,
formulated on Schwartz functions. -/
def HasFractalSphericalStrongType (d : ℕ) (E : Set ℝ) (p q : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) ℂ,
    MemLp (fractalSphericalMaximalReal d E f) (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalSphericalMaximalReal d E f) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal C * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume

/-- Failure of every uniform `Lᵖ → Lᑫ` bound on the Schwartz core.  The
normalization of the input norm makes this the formal version of (1.9). -/
def FractalSphericalUnbounded (d : ℕ) (E : Set ℝ) (p q : ℝ) : Prop :=
  ∀ C : ℝ, 0 < C → ∃ f : SchwartzMap (Euclidean d) ℂ,
    eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume ≤ 1 ∧
      ENNReal.ofReal C <
        eLpNorm (fractalSphericalMaximalReal d E f) (ENNReal.ofReal q) volume

/-- With no admissible radii the restricted supremum is identically zero. -/
theorem fractalSphericalMaximal_empty
    (d : ℕ) (f : Euclidean d → ℂ) (x : Euclidean d) :
    fractalSphericalMaximal d (∅ : Set ℝ) f x = 0 := by
  simp [fractalSphericalMaximal]

/-- The real-valued restricted maximal function also vanishes for the empty
radius set. -/
theorem fractalSphericalMaximalReal_empty
    (d : ℕ) (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalSphericalMaximalReal d (∅ : Set ℝ) f x = 0 := by
  simp [fractalSphericalMaximalReal, fractalSphericalMaximal]

/-- The empty radius set satisfies every finite-exponent strong estimate.
This lets the main proof reserve the active-cell/selector construction for
the genuinely nonempty case. -/
theorem hasFractalSphericalStrongType_empty
    (d : ℕ) (p q : ℝ) :
    HasFractalSphericalStrongType d (∅ : Set ℝ) p q := by
  refine ⟨1, zero_lt_one, ?_⟩
  intro f
  have hzero : fractalSphericalMaximalReal d (∅ : Set ℝ) f = 0 := by
    funext x
    exact fractalSphericalMaximalReal_empty d f x
  rw [hzero]
  simp

end
end Former_DefinitionsBase

