open Auto.Spherical.FractalDilations.Auxiliary







/-!
# Affine halfspaces for the exponent region

This file provides the convex-geometric interface used by the sharpness
argument.  A linear inequality holding at all four vertices of `Q` holds on
all of `Q`; consequently, a strict violation certifies that an exponent point
is outside the closed region.
-/
open Set

noncomputable section

/-- A real linear functional on reciprocal-exponent points. -/
def exponentLinearMap (a b : ℝ) : ExponentPoint →ₗ[ℝ] ℝ where
  toFun x := a * x.1 + b * x.2
  map_add' x y := by
    rcases x with ⟨x₁, x₂⟩
    rcases y with ⟨y₁, y₂⟩
    simp only [Prod.fst_add, Prod.snd_add]
    ring
  map_smul' r x := by
    rcases x with ⟨x₁, x₂⟩
    change a * (r * x₁) + b * (r * x₂) = r * (a * x₁ + b * x₂)
    ring

/-- The closed linear halfspace cut out by an exponent functional. -/
def exponentHalfspace (a b c : ℝ) : Set ExponentPoint :=
  {x | exponentLinearMap a b x ≤ c}

/-- The affine functional whose zero set is the edge joining `Q3(β)` to
`Q4(γ)` when `α * γ = β`.  Keeping `α` explicit makes the elementary vertex
algebra independent of a division-by-zero convention. -/
def clusterEdgeFunctional (d : ℕ) (α β : ℝ) (x : ExponentPoint) : ℝ :=
  let A := α / 2 * ((d : ℝ) - 1)
  A + ((d : ℝ) - β - A) * x.2 - (1 + A) * x.1

/-- The linear halfspace equivalent to nonnegativity of
`clusterEdgeFunctional`. -/
def clusterEdgeHalfspace (d : ℕ) (α β : ℝ) : Set ExponentPoint :=
  let A := α / 2 * ((d : ℝ) - 1)
  exponentHalfspace (1 + A) (-((d : ℝ) - β - A)) A

/-- Nonnegativity of the clustered-edge functional is exactly membership in
its associated affine halfspace. -/
theorem mem_clusterEdgeHalfspace_iff
    {d : ℕ} {α β : ℝ} {x : ExponentPoint} :
    x ∈ clusterEdgeHalfspace d α β ↔ 0 ≤ clusterEdgeFunctional d α β x := by
  change
    (1 + α / 2 * ((d : ℝ) - 1)) * x.1 +
        -((d : ℝ) - β - α / 2 * ((d : ℝ) - 1)) * x.2 ≤
      α / 2 * ((d : ℝ) - 1) ↔
    0 ≤ α / 2 * ((d : ℝ) - 1) +
      ((d : ℝ) - β - α / 2 * ((d : ℝ) - 1)) * x.2 -
        (1 + α / 2 * ((d : ℝ) - 1)) * x.1
  constructor <;> intro h <;> linarith

/-- Closed exponent halfspaces are convex. -/
theorem convex_exponentHalfspace (a b c : ℝ) :
    Convex ℝ (exponentHalfspace a b c) := by
  exact convex_halfSpace_le (exponentLinearMap a b).isLinear c

/-- Evaluation of the clustered-edge functional at `Q1`. -/
theorem clusterEdgeFunctional_Q1 (d : ℕ) (α β : ℝ) :
    clusterEdgeFunctional d α β Q1 = α / 2 * ((d : ℝ) - 1) := by
  simp [clusterEdgeFunctional, Q1]

/-- Evaluation at `Q3`: this vertex lies on every clustered-edge line. -/
theorem clusterEdgeFunctional_Q3_eq_zero
    {d : ℕ} {α β : ℝ} (hd : 2 ≤ d) (hβ : β ≤ 1) :
    clusterEdgeFunctional d α β (Q3 d β) = 0 := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) - β + 1 := by linarith
  unfold clusterEdgeFunctional
  dsimp [Q3]
  field_simp [hden.ne']
  ring

/-- Evaluation at `Q4`.  The right-hand side vanishes precisely when the
edge parameter obeys `α * γ = β`. -/
theorem clusterEdgeFunctional_Q4
    {d : ℕ} {α β γ : ℝ} (hd : 2 ≤ d) (hγ : 0 ≤ γ) :
    clusterEdgeFunctional d α β (Q4 d γ) =
      (((d : ℝ) - 1) * (α * γ - β)) /
        ((d : ℝ) ^ 2 + 2 * γ - 1) := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) ^ 2 + 2 * γ - 1 := by
    nlinarith [sq_nonneg ((d : ℝ) - 2)]
  unfold clusterEdgeFunctional
  dsimp [Q4]
  field_simp [hden.ne']
  ring

/-- Evaluation at `Q2`, in factored form suited to proving nonnegativity. -/
theorem clusterEdgeFunctional_Q2
    {d : ℕ} {α β : ℝ} (hd : 2 ≤ d) (hβ : 0 ≤ β) :
    clusterEdgeFunctional d α β (Q2 d β) =
      (((d : ℝ) - 1 - β) *
        ((d : ℝ) - 1 - α / 2 * ((d : ℝ) - 1))) /
          ((d : ℝ) - 1 + β) := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) - 1 + β := by linarith
  unfold clusterEdgeFunctional
  dsimp [Q2]
  field_simp [hden.ne']
  ring

/-- The clustered-radius edge supports the whole closed exponent region.
The explicit parameter `α` is assumed to lie in `[0,1]` and to satisfy
`α γ = β`; these are exactly the algebraic facts supplied by
`α = β / γ` in the nondegenerate spectrum range. -/
theorem Q_subset_clusterEdgeHalfspace
    {d : ℕ} {α β γ : ℝ} (hd : 2 ≤ d)
    (hβ : 0 ≤ β) (hβone : β ≤ 1) (hγ : 0 ≤ γ)
    (hα : 0 ≤ α) (hαone : α ≤ 1) (hαγ : α * γ = β) :
    Q d β γ ⊆ clusterEdgeHalfspace d α β := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hH : 0 ≤ (d : ℝ) - 1 := by linarith
  have hQ1F : 0 ≤ clusterEdgeFunctional d α β Q1 := by
    rw [clusterEdgeFunctional_Q1]
    exact mul_nonneg (div_nonneg hα (by norm_num)) hH
  have hQ2F : 0 ≤ clusterEdgeFunctional d α β (Q2 d β) := by
    rw [clusterEdgeFunctional_Q2 hd hβ]
    apply div_nonneg
    · apply mul_nonneg
      · linarith
      · have hαhalf : α / 2 ≤ 1 := by linarith
        have hA : α / 2 * ((d : ℝ) - 1) ≤ (d : ℝ) - 1 := by
          calc
            α / 2 * ((d : ℝ) - 1) ≤ 1 * ((d : ℝ) - 1) :=
              mul_le_mul_of_nonneg_right hαhalf hH
            _ = (d : ℝ) - 1 := one_mul _
        linarith
    · have hden : 0 < (d : ℝ) - 1 + β := by linarith
      exact hden.le
  have hQ3F : 0 ≤ clusterEdgeFunctional d α β (Q3 d β) := by
    rw [clusterEdgeFunctional_Q3_eq_zero hd hβone]
  have hQ4F : 0 ≤ clusterEdgeFunctional d α β (Q4 d γ) := by
    rw [clusterEdgeFunctional_Q4 hd hγ, hαγ]
    simp
  rw [Q]
  apply convexHull_min
  · intro x hx
    simp only [exponentVertices, mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact mem_clusterEdgeHalfspace_iff.mpr hQ1F
    · exact mem_clusterEdgeHalfspace_iff.mpr hQ2F
    · exact mem_clusterEdgeHalfspace_iff.mpr hQ3F
    · exact mem_clusterEdgeHalfspace_iff.mpr hQ4F
  · dsimp [clusterEdgeHalfspace]
    exact convex_exponentHalfspace _ _ _

/-- Specialization of the clustered-edge support to `α = β / γ`.  The
possibly degenerate case `β = γ = 0` is included, using Lean's total division
convention and a separate elementary branch. -/
theorem Q_subset_clusterEdgeHalfspace_div
    {d : ℕ} {β γ : ℝ} (hd : 2 ≤ d)
    (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ) :
    Q d β γ ⊆ clusterEdgeHalfspace d (β / γ) β := by
  have hγ : 0 ≤ γ := hβ.trans hβγ
  by_cases hγzero : γ = 0
  · have hβzero : β = 0 := by
      apply le_antisymm
      · simpa only [hγzero, le_refl] using hβγ
      · exact hβ
    subst γ
    subst β
    simpa using (Q_subset_clusterEdgeHalfspace (d := d) (α := 0) (β := 0) (γ := 0)
      hd (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num) (by norm_num))
  · have hγpos : 0 < γ := lt_of_le_of_ne hγ (Ne.symm hγzero)
    have hα : 0 ≤ β / γ := div_nonneg hβ hγ
    have hαone : β / γ ≤ 1 := (div_le_one hγpos).2 hβγ
    have hαγ : (β / γ) * γ = β := div_mul_cancel₀ β hγzero
    exact Q_subset_clusterEdgeHalfspace hd hβ hβone hγ hα hαone hαγ

/-- A negative clustered-edge functional excludes an exponent point from
`Q`, in the usual range `0 ≤ β ≤ γ` and `β ≤ 1`. -/
theorem not_mem_Q_of_clusterEdgeFunctional_neg
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hbad : clusterEdgeFunctional d (β / γ) β x < 0) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_clusterEdgeHalfspace_div hd hβ hβone hβγ hx
  have hnonneg := mem_clusterEdgeHalfspace_iff.mp hinside
  exact (not_lt_of_ge hnonneg) hbad

/-- Any linear halfspace containing the four vertices contains the full
closed exponent region. -/
theorem Q_subset_exponentHalfspace_of_vertices
    {d : ℕ} {β γ a b c : ℝ}
    (hQ1 : exponentLinearMap a b Q1 ≤ c)
    (hQ2 : exponentLinearMap a b (Q2 d β) ≤ c)
    (hQ3 : exponentLinearMap a b (Q3 d β) ≤ c)
    (hQ4 : exponentLinearMap a b (Q4 d γ) ≤ c) :
    Q d β γ ⊆ exponentHalfspace a b c := by
  rw [Q]
  apply convexHull_min
  · intro x hx
    simp only [exponentVertices, mem_insert_iff, mem_singleton_iff] at hx
    rcases hx with rfl | rfl | rfl | rfl
    · exact hQ1
    · exact hQ2
    · exact hQ3
    · exact hQ4
  · exact convex_exponentHalfspace a b c

/-- An explicit nonnegative three-vertex convex combination belongs to `Q`.
This is a lightweight entry point for the barycentric proofs of planar
halfspace descriptions. -/
theorem three_weight_mem_Q
    {d : ℕ} {β γ a b c : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hsum : a + b + c = 1) :
    a • Q1 + b • Q2 d β + c • Q3 d β ∈ Q d β γ := by
  let w : Fin 3 → ℝ := ![a, b, c]
  let z : Fin 3 → ExponentPoint := ![Q1, Q2 d β, Q3 d β]
  have hw0 : ∀ i, 0 ≤ w i := by
    intro i
    fin_cases i <;> simp [w, ha, hb, hc]
  have hw1 : ∑ i, w i = 1 := by
    simpa [w, Fin.sum_univ_succ, add_assoc] using hsum
  have hz : ∀ i, z i ∈ exponentVertices d β γ := by
    intro i
    fin_cases i <;> simp [z, exponentVertices]
  rw [Q]
  have hmem := mem_convexHull_of_exists_fintype w z hw0 hw1 hz
    (by simpa [w, z, Fin.sum_univ_succ, add_assoc] :
      ∑ i, w i • z i = a • Q1 + b • Q2 d β + c • Q3 d β)
  exact hmem

/-- The corresponding three-vertex combination for the triangle
`conv {Q1, Q3, Q4}`. -/
theorem three_weight_mem_Q134
    {d : ℕ} {β γ a b c : ℝ}
    (ha : 0 ≤ a) (hb : 0 ≤ b) (hc : 0 ≤ c) (hsum : a + b + c = 1) :
    a • Q1 + b • Q3 d β + c • Q4 d γ ∈ Q d β γ := by
  let w : Fin 3 → ℝ := ![a, b, c]
  let z : Fin 3 → ExponentPoint := ![Q1, Q3 d β, Q4 d γ]
  have hw0 : ∀ i, 0 ≤ w i := by
    intro i
    fin_cases i <;> simp [w, ha, hb, hc]
  have hw1 : ∑ i, w i = 1 := by
    simpa [w, Fin.sum_univ_succ, add_assoc] using hsum
  have hz : ∀ i, z i ∈ exponentVertices d β γ := by
    intro i
    fin_cases i <;> simp [z, exponentVertices]
  rw [Q]
  have hmem := mem_convexHull_of_exists_fintype w z hw0 hw1 hz
    (by simpa [w, z, Fin.sum_univ_succ, add_assoc] :
      ∑ i, w i • z i = a • Q1 + b • Q3 d β + c • Q4 d γ)
  exact hmem

/-- A strict violation of a vertex-certified linear inequality excludes a
point from `Q`. -/
theorem not_mem_Q_of_exponentHalfspace_violation
    {d : ℕ} {β γ a b c : ℝ} {x : ExponentPoint}
    (hvertices : exponentLinearMap a b Q1 ≤ c)
    (hvertices₂ : exponentLinearMap a b (Q2 d β) ≤ c)
    (hvertices₃ : exponentLinearMap a b (Q3 d β) ≤ c)
    (hvertices₄ : exponentLinearMap a b (Q4 d γ) ≤ c)
    (hviolation : c < exponentLinearMap a b x) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_exponentHalfspace_of_vertices
    hvertices hvertices₂ hvertices₃ hvertices₄ hx
  exact (not_lt_of_ge hinside) hviolation

/-! ## Concrete halfspaces used by the elementary sharpness tests -/

/-- The two coordinates of `Q2` agree. -/
theorem Q2_second_eq_first (d : ℕ) (β : ℝ) :
    (Q2 d β).2 = (Q2 d β).1 := by
  rfl

/-- At `Q3`, the second reciprocal exponent does not exceed the first in the
range `d ≥ 2`, `β ≤ 1`. -/
theorem Q3_second_le_first
    {d : ℕ} {β : ℝ} (hd : 2 ≤ d) (hβ : β ≤ 1) :
    (Q3 d β).2 ≤ (Q3 d β).1 := by
  dsimp [Q3]
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hnum : 1 ≤ (d : ℝ) - β := by linarith
  have hden : 0 < (d : ℝ) - β + 1 := by linarith
  exact (div_le_div_iff_of_pos_right hden).2 hnum

/-- At `Q4`, the second reciprocal exponent does not exceed the first in the
range `d ≥ 2`, `γ ≥ 0`. -/
theorem Q4_second_le_first
    {d : ℕ} {γ : ℝ} (hd : 2 ≤ d) (hγ : 0 ≤ γ) :
    (Q4 d γ).2 ≤ (Q4 d γ).1 := by
  dsimp [Q4]
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hD_one : 1 ≤ (d : ℝ) := by linarith
  have hDm_one : 0 ≤ (d : ℝ) - 1 := by linarith
  have hden : 0 < (d : ℝ) ^ 2 + 2 * γ - 1 := by
    nlinarith [sq_nonneg ((d : ℝ) - 2)]
  apply (div_le_div_iff_of_pos_right hden).2
  calc
    (d : ℝ) - 1 = 1 * ((d : ℝ) - 1) := by ring
    _ ≤ (d : ℝ) * ((d : ℝ) - 1) :=
      mul_le_mul_of_nonneg_right hD_one hDm_one

/-- Every point of `Q` satisfies `v ≤ u`, the necessary inequality detected
by the translation test.  Assumptions are exactly those used at the four
vertices: `d ≥ 2`, `β ≤ 1`, and `γ ≥ 0`. -/
theorem Q_subset_second_le_first
    {d : ℕ} {β γ : ℝ} (hd : 2 ≤ d) (hβ : β ≤ 1) (hγ : 0 ≤ γ) :
    Q d β γ ⊆ {x : ExponentPoint | x.2 ≤ x.1} := by
  have hQ1 : exponentLinearMap (-1) 1 Q1 ≤ 0 := by
    norm_num [exponentLinearMap, Q1]
  have hQ2 : exponentLinearMap (-1) 1 (Q2 d β) ≤ 0 := by
    change -1 * (Q2 d β).1 + 1 * (Q2 d β).2 ≤ 0
    rw [Q2_second_eq_first]
    ring_nf
    norm_num
  have hQ3 : exponentLinearMap (-1) 1 (Q3 d β) ≤ 0 := by
    change -1 * (Q3 d β).1 + 1 * (Q3 d β).2 ≤ 0
    nlinarith [Q3_second_le_first hd hβ]
  have hQ4 : exponentLinearMap (-1) 1 (Q4 d γ) ≤ 0 := by
    change -1 * (Q4 d γ).1 + 1 * (Q4 d γ).2 ≤ 0
    nlinarith [Q4_second_le_first hd hγ]
  intro x hx
  have hx' := Q_subset_exponentHalfspace_of_vertices hQ1 hQ2 hQ3 hQ4 hx
  change -1 * x.1 + 1 * x.2 ≤ 0 at hx'
  change x.2 ≤ x.1
  linarith

/-- At `Q2`, the common coordinate is nonnegative under the usual
Minkowski-parameter assumptions. -/
theorem Q2_first_nonneg
    {d : ℕ} {β : ℝ} (hd : 2 ≤ d) (hβ : 0 ≤ β) :
    0 ≤ (Q2 d β).1 := by
  dsimp [Q2]
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) - 1 + β := by linarith
  exact div_nonneg (by linarith) hden.le

/-- Every point of `Q` satisfies `u ≤ d v`, the necessary inequality
detected by the spherical-cap test.  The assumptions ensure the relevant
vertex denominators and numerators have the indicated signs. -/
theorem Q_subset_first_le_natCast_mul_second
    {d : ℕ} {β γ : ℝ} (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1)
    (_hγ : 0 ≤ γ) :
    Q d β γ ⊆ {x : ExponentPoint | x.1 ≤ (d : ℝ) * x.2} := by
  have hD : (1 : ℝ) ≤ (d : ℝ) := by
    have hD' : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hQ1 : exponentLinearMap 1 (-(d : ℝ)) Q1 ≤ 0 := by
    norm_num [exponentLinearMap, Q1]
  have hQ2 : exponentLinearMap 1 (-(d : ℝ)) (Q2 d β) ≤ 0 := by
    change 1 * (Q2 d β).1 + -(d : ℝ) * (Q2 d β).2 ≤ 0
    rw [Q2_second_eq_first]
    have hnonneg := Q2_first_nonneg hd hβ
    nlinarith
  have hQ3 : exponentLinearMap 1 (-(d : ℝ)) (Q3 d β) ≤ 0 := by
    change 1 * (Q3 d β).1 + -(d : ℝ) * (Q3 d β).2 ≤ 0
    have hD' : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    have hden : 0 < (d : ℝ) - β + 1 := by linarith
    have hnum : (d : ℝ) - β ≤ (d : ℝ) := by linarith
    have hratio : (Q3 d β).1 ≤ (d : ℝ) * (Q3 d β).2 := by
      dsimp [Q3]
      have hinv : 0 ≤ ((d : ℝ) - β + 1)⁻¹ := inv_nonneg.mpr hden.le
      calc
        ((d : ℝ) - β) / ((d : ℝ) - β + 1) =
            ((d : ℝ) - β) * ((d : ℝ) - β + 1)⁻¹ := div_eq_mul_inv _ _
        _ ≤ (d : ℝ) * ((d : ℝ) - β + 1)⁻¹ :=
          mul_le_mul_of_nonneg_right hnum hinv
        _ = (d : ℝ) * (1 / ((d : ℝ) - β + 1)) := by ring
    nlinarith
  have hQ4 : exponentLinearMap 1 (-(d : ℝ)) (Q4 d γ) ≤ 0 := by
    change 1 * (Q4 d γ).1 + -(d : ℝ) * (Q4 d γ).2 ≤ 0
    dsimp [Q4]
    ring_nf
    norm_num
  intro x hx
  have hx' := Q_subset_exponentHalfspace_of_vertices hQ1 hQ2 hQ3 hQ4 hx
  change 1 * x.1 + -(d : ℝ) * x.2 ≤ 0 at hx'
  change x.1 ≤ (d : ℝ) * x.2
  linarith

/-- The `Q2` vertex lies on the small-ball/annulus sharpness line. -/
theorem Q2_annulus_identity
    {d : ℕ} {β : ℝ} (hd : 2 ≤ d) (hβ : 0 ≤ β) :
    (d : ℝ) * (Q2 d β).1 =
      (1 - β) * (Q2 d β).2 + ((d : ℝ) - 1) := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) - 1 + β := by linarith
  dsimp [Q2]
  field_simp [hden.ne']
  ring

/-- The `Q3` vertex lies on the small-ball/annulus sharpness line. -/
theorem Q3_annulus_identity
    {d : ℕ} {β : ℝ} (hd : 2 ≤ d) (hβ : β ≤ 1) :
    (d : ℝ) * (Q3 d β).1 =
      (1 - β) * (Q3 d β).2 + ((d : ℝ) - 1) := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hden : 0 < (d : ℝ) - β + 1 := by linarith
  dsimp [Q3]
  field_simp [hden.ne']
  ring

/-- At `Q4`, the small-ball/annulus inequality is satisfied when the
quasi-Assouad parameter dominates the Minkowski parameter. -/
theorem Q4_annulus_le
    {d : ℕ} {β γ : ℝ} (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβγ : β ≤ γ) :
    (d : ℝ) * (Q4 d γ).1 ≤
      (1 - β) * (Q4 d γ).2 + ((d : ℝ) - 1) := by
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hγ : 0 ≤ γ := hβ.trans hβγ
  have hden : 0 < (d : ℝ) ^ 2 + 2 * γ - 1 := by
    nlinarith [sq_nonneg ((d : ℝ) - 2)]
  have hfactor : 0 ≤ ((d : ℝ) - 1) * (2 * γ - β) := by
    apply mul_nonneg
    · linarith
    · linarith
  have hidentity :
      (1 - β) * (Q4 d γ).2 + ((d : ℝ) - 1) -
          (d : ℝ) * (Q4 d γ).1 =
        (((d : ℝ) - 1) * (2 * γ - β)) /
          ((d : ℝ) ^ 2 + 2 * γ - 1) := by
    dsimp [Q4]
    field_simp [hden.ne']
    ring
  have hnonneg : 0 ≤ (1 - β) * (Q4 d γ).2 + ((d : ℝ) - 1) -
      (d : ℝ) * (Q4 d γ).1 := by
    rw [hidentity]
    exact div_nonneg hfactor hden.le
  linarith

/-- Every point of `Q` obeys the necessary small-ball/annulus inequality.
This uses `d ≥ 2`, `0 ≤ β ≤ γ`, and `β ≤ 1`; no analytic input is involved. -/
theorem Q_subset_annulus_halfspace
    {d : ℕ} {β γ : ℝ} (hd : 2 ≤ d)
    (hβ : 0 ≤ β) (hβγ : β ≤ γ) (hβone : β ≤ 1) :
    Q d β γ ⊆ {x : ExponentPoint |
      (d : ℝ) * x.1 ≤ (1 - β) * x.2 + ((d : ℝ) - 1)} := by
  have hQ1 : exponentLinearMap (d : ℝ) (β - 1) Q1 ≤ (d : ℝ) - 1 := by
    norm_num [exponentLinearMap, Q1]
    have hd' : 1 ≤ d := by omega
    exact_mod_cast hd'
  have hQ2 : exponentLinearMap (d : ℝ) (β - 1) (Q2 d β) ≤ (d : ℝ) - 1 := by
    change (d : ℝ) * (Q2 d β).1 + (β - 1) * (Q2 d β).2 ≤ (d : ℝ) - 1
    rw [show (β - 1 : ℝ) = -(1 - β) by ring]
    linarith [Q2_annulus_identity hd hβ]
  have hQ3 : exponentLinearMap (d : ℝ) (β - 1) (Q3 d β) ≤ (d : ℝ) - 1 := by
    change (d : ℝ) * (Q3 d β).1 + (β - 1) * (Q3 d β).2 ≤ (d : ℝ) - 1
    rw [show (β - 1 : ℝ) = -(1 - β) by ring]
    linarith [Q3_annulus_identity hd hβone]
  have hQ4 : exponentLinearMap (d : ℝ) (β - 1) (Q4 d γ) ≤ (d : ℝ) - 1 := by
    change (d : ℝ) * (Q4 d γ).1 + (β - 1) * (Q4 d γ).2 ≤ (d : ℝ) - 1
    rw [show (β - 1 : ℝ) = -(1 - β) by ring]
    linarith [Q4_annulus_le hd hβ hβγ]
  intro x hx
  have hx' := Q_subset_exponentHalfspace_of_vertices hQ1 hQ2 hQ3 hQ4 hx
  change (d : ℝ) * x.1 + (β - 1) * x.2 ≤ (d : ℝ) - 1 at hx'
  change (d : ℝ) * x.1 ≤ (1 - β) * x.2 + ((d : ℝ) - 1)
  linarith

/-- The translation-test inequality `u < v` places an exponent point outside
the closed region `Q`. -/
theorem not_mem_Q_of_first_lt_second
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβone : β ≤ 1) (hγ : 0 ≤ γ)
    (hbad : x.1 < x.2) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_second_le_first hd hβone hγ hx
  exact (not_le_of_gt hbad) hinside

/-- The spherical-cap-test inequality `d v < u` places an exponent point
outside the closed region `Q`. -/
theorem not_mem_Q_of_natCast_mul_second_lt_first
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hγ : 0 ≤ γ)
    (hbad : (d : ℝ) * x.2 < x.1) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_first_le_natCast_mul_second hd hβ hβone hγ hx
  exact (not_le_of_gt hbad) hinside

/-- The small-ball/annulus-test inequality places an exponent point outside
the closed region `Q`. -/
theorem not_mem_Q_of_annulus_violation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβγ : β ≤ γ) (hβone : β ≤ 1)
    (hbad : (1 - β) * x.2 + ((d : ℝ) - 1) < (d : ℝ) * x.1) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_annulus_halfspace hd hβ hβγ hβone hx
  exact (not_le_of_gt hbad) hinside

/-- The four strict inequalities produced by the elementary sharpness tests.
The first three correspond to translation, spherical-cap, and annulus tests;
the last is the clustered-radius edge. -/
def SharpnessViolation (d : ℕ) (β γ : ℝ) (x : ExponentPoint) : Prop :=
  x.1 < x.2 ∨
    (d : ℝ) * x.2 < x.1 ∨
      (1 - β) * x.2 + ((d : ℝ) - 1) < (d : ℝ) * x.1 ∨
        clusterEdgeFunctional d (β / γ) β x < 0

/-- Each strict sharpness violation certifies that the point is outside `Q`.
This is the fully formal, easy direction of the planar H-representation. -/
theorem not_mem_Q_of_sharpnessViolation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hbad : SharpnessViolation d β γ x) :
    x ∉ Q d β γ := by
  rcases hbad with hbad | hbad | hbad | hbad
  · exact not_mem_Q_of_first_lt_second hd hβone (hβ.trans hβγ) hbad
  · exact not_mem_Q_of_natCast_mul_second_lt_first hd hβ hβone (hβ.trans hβγ) hbad
  · exact not_mem_Q_of_annulus_violation hd hβ hβγ hβone hbad
  · exact not_mem_Q_of_clusterEdgeFunctional_neg hd hβ hβone hβγ hbad

/-- A point in `Q` satisfies none of the four strict sharpness inequalities.
Together with `not_mem_Q_of_sharpnessViolation`, this records the supporting
halfspace direction of the exponent-region H-representation. -/
theorem not_sharpnessViolation_of_mem_Q
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hx : x ∈ Q d β γ) :
    ¬ SharpnessViolation d β γ x := by
  intro hbad
  exact not_mem_Q_of_sharpnessViolation hd hβ hβone hβγ hbad hx

/-- The first barycentric triangle in the exponent polygon.  When the point
lies on the `Q1`--`Q3` side facing `Q2`, the translation and annulus
halfspaces give nonnegative barycentric coordinates in
`conv {Q1, Q2, Q3}`.  The strict positivity assumption excludes only the
collapsed edge `d = 2, β = 1`. -/
theorem mem_Q_of_triangle123_halfspaces
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1)
    (hK : 0 < (d : ℝ) - 1 - β)
    (htranslation : x.2 ≤ x.1)
    (hannulus : (d : ℝ) * x.1 ≤ (1 - β) * x.2 + ((d : ℝ) - 1))
    (hdiagonal : x.1 ≤ ((d : ℝ) - β) * x.2) :
    x ∈ Q d β γ := by
  let H : ℝ := (d : ℝ) - 1
  let K : ℝ := H - β
