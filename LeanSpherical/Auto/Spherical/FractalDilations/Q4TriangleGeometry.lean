/-- Two nearby ordinary Q4 shell parameters around a strict target slope.
The same positive subpower loss works at both parameters.  This is the
strict, endpoint-free replacement for the Bourgain endpoint summation in the
ordinary (non-planar-critical) regime. -/
theorem exists_q4_two_nearby_strict_parameters
    {d : Nat} {gamma thetaStar : Real}
    (hd : 1 < d) (hgamma : 0 ≤ gamma)
    (hlower : 1 / (d : Real) < thetaStar)
    (hupper : thetaStar <
      (((d : Real) - 1) / 2) /
        ((((d : Real) - 1) / 2) + gamma)) :
    ∃ thetaLow thetaHigh eta : Real,
      1 / (d : Real) < thetaLow ∧ thetaLow < thetaStar ∧
        thetaStar < thetaHigh ∧ thetaHigh <
          (((d : Real) - 1) / 2) /
            ((((d : Real) - 1) / 2) + gamma) ∧
        thetaHigh < 1 ∧ 0 < eta ∧
        q4FrequencyExponentWithSubpowerLoss d thetaLow eta < 0 ∧
        q4GapExponent d gamma thetaLow < 0 ∧
        q4FrequencyExponentWithSubpowerLoss d thetaHigh eta < 0 ∧
        q4GapExponent d gamma thetaHigh < 0 := by
  let D : Real := d
  let A : Real := (D - 1) / 2
  let L : Real := 1 / D
  let U : Real := A / (A + gamma)
  let thetaLow : Real := (L + thetaStar) / 2
  let thetaHigh : Real := (thetaStar + U) / 2
  let eta : Real := (D * thetaLow - 1) / (2 * thetaHigh)
  have hD : 0 < D := by
    dsimp only [D]
    exact_mod_cast (show 0 < d by omega)
  have hDone : 1 < D := by
    dsimp only [D]
    exact_mod_cast hd
  have hA : 0 < A := by
    dsimp only [A]
    linarith
  have hAden : 0 < A + gamma := add_pos_of_pos_of_nonneg hA hgamma
  have hUpos : 0 < U := div_pos hA hAden
  have hUone : U ≤ 1 := by
    dsimp only [U]
    rw [div_le_one hAden]
    linarith
  have hLpos : 0 < L := by
    dsimp only [L]
    exact one_div_pos.mpr hD
  have hlow : L < thetaLow := by
    dsimp only [thetaLow]
    nlinarith [show L < thetaStar by simpa only [L, D] using hlower]
  have hlowStar : thetaLow < thetaStar := by
    dsimp only [thetaLow]
    nlinarith [show L < thetaStar by simpa only [L, D] using hlower]
  have hstarHigh : thetaStar < thetaHigh := by
    dsimp only [thetaHigh]
    nlinarith [show thetaStar < U by simpa only [U, A, D] using hupper]
  have hhighU : thetaHigh < U := by
    dsimp only [thetaHigh]
    nlinarith [show thetaStar < U by simpa only [U, A, D] using hupper]
  have hlowHigh : thetaLow < thetaHigh := lt_trans hlowStar hstarHigh
  have hhighPos : 0 < thetaHigh :=
    lt_trans hLpos (lt_trans hlow hlowHigh)
  have hDlow : 1 < D * thetaLow := by
    have hL : 1 / D < thetaLow := by simpa only [L] using hlow
    exact (div_lt_iff₀ hD).mp hL
  have heta : 0 < eta := by
    dsimp only [eta]
    exact div_pos (sub_pos.mpr hDlow) (mul_pos (by norm_num) hhighPos)
  have hetaScale : thetaHigh * eta = (D * thetaLow - 1) / 2 := by
    dsimp only [eta]
    field_simp [hhighPos.ne']
    ring
  have hfrequency : ∀ z : Real, thetaLow ≤ z → z ≤ thetaHigh →
      q4FrequencyExponentWithSubpowerLoss d z eta < 0 := by
    intro z hzLow hzHigh
    have hscale : z * eta ≤ (D * thetaLow - 1) / 2 := by
