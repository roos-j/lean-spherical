    apply q4GapExponent_neg_of_lt_balancing_parameter hd hgamma
    have hlowU : thetaLow < U := lt_trans hlowHigh hhighU
    simpa only [D, A, U] using hlowU
  have hgapHigh : q4GapExponent d gamma thetaHigh < 0 := by
    apply q4GapExponent_neg_of_lt_balancing_parameter hd hgamma
    simpa only [D, A, U] using hhighU
  refine ⟨thetaLow, thetaHigh, eta, ?_, hlowStar, hstarHigh, ?_, ?_, heta,
    ?_, hgapLow, ?_, hgapHigh⟩
