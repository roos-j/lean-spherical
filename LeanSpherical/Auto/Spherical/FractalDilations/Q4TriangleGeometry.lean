/-- Two nearby parameters in the planar critical finite-gap regime.  Unlike
the ordinary selector, the conclusion keeps the combined frequency-plus-gap
exponent negative; this is exactly the scalar quantity used by the literal
finite-level reassembly. -/
theorem exists_q4_planar_critical_two_nearby_parameters
    {thetaStar : Real}
    (hlower : 1 / 2 < thetaStar) (hupper : thetaStar < 1) :
    ∃ thetaLow thetaHigh eta : Real,
      1 / 2 < thetaLow ∧ thetaLow < thetaStar ∧
        thetaStar < thetaHigh ∧ thetaHigh < 1 ∧ 0 < eta ∧
        q4FrequencyExponentWithSubpowerLoss 2 thetaLow eta +
          q4GapExponent 2 (1 / 2) thetaLow < 0 ∧
        q4FrequencyExponentWithSubpowerLoss 2 thetaHigh eta +
          q4GapExponent 2 (1 / 2) thetaHigh < 0 := by
  let thetaLow : Real := (1 / 2 + thetaStar) / 2
  let thetaHigh : Real := (thetaStar + 1) / 2
  let eta : Real := (thetaLow - 1 / 2) / (2 * thetaHigh)
  have hlowHalf : 1 / 2 < thetaLow := by
    dsimp only [thetaLow]
    nlinarith
  have hlowStar : thetaLow < thetaStar := by
    dsimp only [thetaLow]
    nlinarith
  have hstarHigh : thetaStar < thetaHigh := by
    dsimp only [thetaHigh]
    nlinarith
  have hhighOne : thetaHigh < 1 := by
    dsimp only [thetaHigh]
    nlinarith
  have hhighPos : 0 < thetaHigh := by linarith
  have heta : 0 < eta := by
    dsimp only [eta]
    exact div_pos (sub_pos.mpr hlowHalf) (mul_pos (by norm_num) hhighPos)
  have hetaScale : thetaHigh * eta = (thetaLow - 1 / 2) / 2 := by
    dsimp only [eta]
    field_simp [hhighPos.ne']
    ring
  have hcombined : ∀ z : Real, thetaLow ≤ z → z ≤ thetaHigh →
      q4FrequencyExponentWithSubpowerLoss 2 z eta +
        q4GapExponent 2 (1 / 2) z < 0 := by
    intro z hzLow hzHigh
    have hscale : z * eta ≤ (thetaLow - 1 / 2) / 2 := by
      calc
        z * eta ≤ thetaHigh * eta :=
          mul_le_mul_of_nonneg_right hzHigh heta.le
        _ = (thetaLow - 1 / 2) / 2 := hetaScale
    unfold q4FrequencyExponentWithSubpowerLoss q4FrequencyExponent q4GapExponent
    norm_num
    nlinarith
  refine ⟨thetaLow, thetaHigh, eta, hlowHalf, hlowStar, hstarHigh, hhighOne,
    heta, ?_, ?_⟩
  · exact hcombined thetaLow le_rfl (le_of_lt (lt_trans hlowStar hstarHigh))
  · exact hcombined thetaHigh (le_of_lt (lt_trans hlowStar hstarHigh)) le_rfl

