/-- The reciprocal slope of a strict triangle point is larger than the cap
slope.  This is the planar-critical geometric input. -/
theorem strictTriangle134_theta_gt_reciprocal_dimension
    {d : Nat} {beta gamma p q : Real}
    (hd : 2 ≤ d) (hbeta : 0 < beta) (hbeta_one : beta ≤ 1)
    (hgamma : 0 ≤ gamma)
    (hp : 0 < p) (hq : 0 < q)
    (h : StrictTriangle134Combination d beta gamma (reciprocalExponentPoint p q)) :
    1 / (d : Real) < p / q := by
  have hcap := strictTriangle134_cap_and_diagonal hd hbeta hbeta_one hgamma h
  have hD : 0 < (d : Real) := by
    have : (0 : Real) < 2 := by norm_num
    exact this.trans_le (by exact_mod_cast hd)
  have hrecip : p⁻¹ < (d : Real) * q⁻¹ := by
    simpa [reciprocalExponentPoint] using hcap.1
  have hmul := (mul_lt_mul_right (mul_pos hp hq)).mpr hrecip
  have hleft : p⁻¹ * (p * q) = q := by
    calc
      p⁻¹ * (p * q) = (p⁻¹ * p) * q := by ring
      _ = q := by rw [inv_mul_cancel₀ hp.ne', one_mul]
  have hright : ((d : Real) * q⁻¹) * (p * q) = (d : Real) * p := by
    calc
      ((d : Real) * q⁻¹) * (p * q) = (d : Real) * p * (q⁻¹ * q) := by ring
      _ = (d : Real) * p := by rw [inv_mul_cancel₀ hq.ne', mul_one]
  rw [hleft, hright] at hmul
  apply (div_lt_div_iff₀ hD hq).mpr
  nlinarith

