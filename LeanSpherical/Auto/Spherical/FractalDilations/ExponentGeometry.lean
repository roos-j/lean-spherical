  have hQ3 : exponentLinearMap (d : ℝ) (β - 1) (Q3 d β) ≤ (d : ℝ) - 1 := by
    change (d : ℝ) * (Q3 d β).1 + (β - 1) * (Q3 d β).2 ≤ (d : ℝ) - 1
    rw [show (β - 1 : ℝ) = -(1 - β) by ring]
    linarith [Q3_annulus_identity hd hβone]
  have hQ4 : exponentLinearMap (d : ℝ) (β - 1) (Q4 d γ) ≤ (d : ℝ) - 1 := by
    change (d : ℝ) * (Q4 d γ).1 + (β - 1) * (Q4 d γ).2 ≤ (d : ℝ) - 1
    rw [show (β - 1 : ℝ) = -(1 - β) by ring]
    linarith [Q4_annulus_le hd hβ hβγ]
  intro x hx
  have hx' := Q_subset_exponentHalfspace_of_vertices hQ1 hQ2 hQ3 hQ4 hx
  change (d : ℝ) * x.1 + (β - 1) * x.2 ≤ (d : ℝ) - 1 at hx'
  change (d : ℝ) * x.1 ≤ (1 - β) * x.2 + ((d : ℝ) - 1)
  linarith

/-- The translation-test inequality `u < v` places an exponent point outside
the closed region `Q`. -/
theorem not_mem_Q_of_first_lt_second
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβone : β ≤ 1) (hγ : 0 ≤ γ)
    (hbad : x.1 < x.2) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_second_le_first hd hβone hγ hx
  exact (not_le_of_gt hbad) hinside

/-- The spherical-cap-test inequality `d v < u` places an exponent point
outside the closed region `Q`. -/
theorem not_mem_Q_of_natCast_mul_second_lt_first
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hγ : 0 ≤ γ)
    (hbad : (d : ℝ) * x.2 < x.1) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_first_le_natCast_mul_second hd hβ hβone hγ hx
  exact (not_le_of_gt hbad) hinside

/-- The small-ball/annulus-test inequality places an exponent point outside
the closed region `Q`. -/
theorem not_mem_Q_of_annulus_violation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβγ : β ≤ γ) (hβone : β ≤ 1)
    (hbad : (1 - β) * x.2 + ((d : ℝ) - 1) < (d : ℝ) * x.1) :
    x ∉ Q d β γ := by
  intro hx
  have hinside := Q_subset_annulus_halfspace hd hβ hβγ hβone hx
  exact (not_le_of_gt hbad) hinside

/-- The four strict inequalities produced by the elementary sharpness tests.
The first three correspond to translation, spherical-cap, and annulus tests;
the last is the clustered-radius edge. -/
def SharpnessViolation (d : ℕ) (β γ : ℝ) (x : ExponentPoint) : Prop :=
  x.1 < x.2 ∨
    (d : ℝ) * x.2 < x.1 ∨
      (1 - β) * x.2 + ((d : ℝ) - 1) < (d : ℝ) * x.1 ∨
        clusterEdgeFunctional d (β / γ) β x < 0

/-- Each strict sharpness violation certifies that the point is outside `Q`.
This is the fully formal, easy direction of the planar H-representation. -/
theorem not_mem_Q_of_sharpnessViolation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hbad : SharpnessViolation d β γ x) :
    x ∉ Q d β γ := by
  rcases hbad with hbad | hbad | hbad | hbad
  · exact not_mem_Q_of_first_lt_second hd hβone (hβ.trans hβγ) hbad
  · exact not_mem_Q_of_natCast_mul_second_lt_first hd hβ hβone (hβ.trans hβγ) hbad
  · exact not_mem_Q_of_annulus_violation hd hβ hβγ hβone hbad
  · exact not_mem_Q_of_clusterEdgeFunctional_neg hd hβ hβone hβγ hbad

/-- A point in `Q` satisfies none of the four strict sharpness inequalities.
Together with `not_mem_Q_of_sharpnessViolation`, this records the supporting
halfspace direction of the exponent-region H-representation. -/
theorem not_sharpnessViolation_of_mem_Q
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hx : x ∈ Q d β γ) :
    ¬ SharpnessViolation d β γ x := by
  intro hbad
  exact not_mem_Q_of_sharpnessViolation hd hβ hβone hβγ hbad hx

/-- The first barycentric triangle in the exponent polygon.  When the point
lies on the `Q1`--`Q3` side facing `Q2`, the translation and annulus
halfspaces give nonnegative barycentric coordinates in
`conv {Q1, Q2, Q3}`.  The strict positivity assumption excludes only the
collapsed edge `d = 2, β = 1`. -/
theorem mem_Q_of_triangle123_halfspaces
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1)
    (hK : 0 < (d : ℝ) - 1 - β)
    (htranslation : x.2 ≤ x.1)
    (hannulus : (d : ℝ) * x.1 ≤ (1 - β) * x.2 + ((d : ℝ) - 1))
    (hdiagonal : x.1 ≤ ((d : ℝ) - β) * x.2) :
    x ∈ Q d β γ := by
  let H : ℝ := (d : ℝ) - 1
  let K : ℝ := H - β
  let w₁ : ℝ := (H + (1 - β) * x.2 - (d : ℝ) * x.1) / H
  let w₃ : ℝ := (x.1 - x.2) * ((d : ℝ) - β + 1) / K
  let w₂ : ℝ := 1 - w₁ - w₃
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hH : 0 < H := by dsimp [H]; linarith
  have hK' : 0 < K := by simpa only [K, H] using hK
  have hB₂ : 0 < H + β := by dsimp [H]; linarith
  have hB₃ : 0 < (d : ℝ) - β + 1 := by linarith
  have hH0 : (d : ℝ) - 1 ≠ 0 := by linarith
  have hK0 : (d : ℝ) - 1 - β ≠ 0 := hK.ne'
  have hB₂0 : (d : ℝ) - 1 + β ≠ 0 := by linarith
  have hB₃0 : (d : ℝ) - β + 1 ≠ 0 := by linarith
  have hw₁ : 0 ≤ w₁ := by
    apply div_nonneg
    · dsimp [H]
      linarith
    · exact hH.le
  have hw₃ : 0 ≤ w₃ := by
    apply div_nonneg
    · apply mul_nonneg
      · linarith
      · exact hB₃.le
    · exact hK'.le
  have hdiagonal' : x.1 - ((d : ℝ) - β) * x.2 ≤ 0 := by linarith
  have hweight_identity :
      x.1 - ((d : ℝ) - β) * x.2 = -(H / (H + β) * K) * w₂ := by
    dsimp [H, K, w₁, w₂, w₃]
    field_simp [hH0, hK0, hB₂0]
    ring
  have hcoefficient : 0 < H / (H + β) * K := by
    exact mul_pos (div_pos hH hB₂) hK'
  have hw₂ : 0 ≤ w₂ := by
    rw [hweight_identity] at hdiagonal'
    nlinarith
  have hsum : w₁ + w₂ + w₃ = 1 := by
    dsimp [w₂]
    ring
  have hrepr : w₁ • Q1 + w₂ • Q2 d β + w₃ • Q3 d β = x := by
    ext <;> dsimp [H, K, w₁, w₂, w₃, Q1, Q2, Q3]
    all_goals field_simp [hH0, hK0, hB₂0, hB₃0]
    all_goals ring
  have hmem := three_weight_mem_Q (d := d) (β := β) (γ := γ) hw₁ hw₂ hw₃ hsum
  rw [hrepr] at hmem
  exact hmem

/-- The second barycentric triangle in the exponent polygon.  On the
`Q4` side of the `Q1`--`Q3` diagonal, the cap halfspace and clustered-edge
halfspace give nonnegative coordinates in `conv {Q1, Q3, Q4}`. -/
theorem mem_Q_of_triangle134_halfspaces
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 < β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hcap : x.1 ≤ (d : ℝ) * x.2)
    (hdiagonal : ((d : ℝ) - β) * x.2 ≤ x.1)
    (hcluster : 0 ≤ clusterEdgeFunctional d (β / γ) β x) :
    x ∈ Q d β γ := by
  let D : ℝ := d
  let H : ℝ := D - 1
  let A : ℝ := D - β
  let B : ℝ := A + 1
  let T : ℝ := D ^ 2 + 2 * γ - 1
  let α : ℝ := β / γ
  let C : ℝ := α / 2 * H
  let w₃ : ℝ := (D * x.2 - x.1) * B / β
  let w₄ : ℝ := (x.1 - A * x.2) * T / (β * H)
  let w₁ : ℝ := 1 - w₃ - w₄
  have hD : 2 ≤ D := by simpa only [D] using (show (2 : ℝ) ≤ (d : ℝ) by exact_mod_cast hd)
  have hγ : 0 < γ := lt_of_lt_of_le hβ hβγ
  have hH : 0 < H := by dsimp [H]; linarith
  have hB : 0 < B := by dsimp [B, A]; linarith
  have hT : 0 < T := by
    dsimp [T]
    nlinarith [sq_nonneg (D - 2)]
  have hα : 0 < α := by dsimp [α]; exact div_pos hβ hγ
  have hC : 0 < C := by
    dsimp [C]
    exact mul_pos (div_pos hα (by norm_num)) hH
  have hD0 : (d : ℝ) - 1 ≠ 0 := by linarith
  have hB0 : (d : ℝ) - β + 1 ≠ 0 := by linarith
  have hT0 : (d : ℝ) ^ 2 + 2 * γ - 1 ≠ 0 := by
    change D ^ 2 + 2 * γ - 1 ≠ 0
    exact hT.ne'
  have hγ0 : γ ≠ 0 := hγ.ne'
  have hw₃ : 0 ≤ w₃ := by
    apply div_nonneg
    · apply mul_nonneg
      · dsimp [D]
        linarith
      · exact hB.le
    · exact hβ.le
  have hw₄ : 0 ≤ w₄ := by
    apply div_nonneg
    · apply mul_nonneg
      · dsimp [A]
        linarith
      · exact hT.le
    · exact mul_nonneg hβ.le hH.le
  have hweight_identity : clusterEdgeFunctional d (β / γ) β x = C * w₁ := by
    dsimp [D, H, A, B, T, α, C, w₁, w₃, w₄, clusterEdgeFunctional]
    field_simp [hD0, hB0, hT0, hγ0, hβ.ne']
    ring
  have hw₁ : 0 ≤ w₁ := by
    rw [hweight_identity] at hcluster
    nlinarith
  have hsum : w₁ + w₃ + w₄ = 1 := by
    dsimp [w₁]
    ring
  have hrepr : w₁ • Q1 + w₃ • Q3 d β + w₄ • Q4 d γ = x := by
    ext <;> dsimp [D, H, A, B, T, α, C, w₁, w₃, w₄, Q1, Q3, Q4]
    all_goals field_simp [hD0, hB0, hT0, hγ0, hβ.ne']
    all_goals ring
  have hmem := three_weight_mem_Q134 (d := d) (β := β) (γ := γ) hw₁ hw₃ hw₄ hsum
  rw [hrepr] at hmem
  exact hmem

/-- The reverse planar H-representation: if no one of the four sharpness
halfspaces is strictly violated, the point belongs to `Q`.  The proof splits
the quadrilateral along the `Q1`--`Q3` diagonal and uses the two explicit
barycentric-coordinate lemmas above.  It retains the degenerate cases
`β = 0` and `d = 2, β = 1`. -/
theorem mem_Q_of_not_sharpnessViolation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ)
    (hno : ¬ SharpnessViolation d β γ x) :
    x ∈ Q d β γ := by
  simp only [SharpnessViolation, not_or] at hno
  rcases hno with ⟨htranslation', hcap', hannulus', hcluster'⟩
  have htranslation : x.2 ≤ x.1 := le_of_not_gt htranslation'
  have hcap : x.1 ≤ (d : ℝ) * x.2 := le_of_not_gt hcap'
  have hannulus : (d : ℝ) * x.1 ≤
      (1 - β) * x.2 + ((d : ℝ) - 1) := le_of_not_gt hannulus'
  have hcluster : 0 ≤ clusterEdgeFunctional d (β / γ) β x := le_of_not_gt hcluster'
  have hD : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  by_cases hβzero : β = 0
  · subst β
    have hK : 0 < (d : ℝ) - 1 - 0 := by linarith
    have hdiagonal : x.1 ≤ ((d : ℝ) - 0) * x.2 := by simpa using hcap
    exact mem_Q_of_triangle123_halfspaces hd (by norm_num) (by norm_num) hK
      htranslation hannulus hdiagonal
  · have hβpos : 0 < β := lt_of_le_of_ne hβ (Ne.symm hβzero)
    rcases le_total x.1 (((d : ℝ) - β) * x.2) with hleft | hright
    · by_cases hKpos : 0 < (d : ℝ) - 1 - β
      · exact mem_Q_of_triangle123_halfspaces hd hβ hβone hKpos
          htranslation hannulus hleft
      · have hKnonneg : 0 ≤ (d : ℝ) - 1 - β := by linarith
        have hKzero : (d : ℝ) - 1 - β = 0 :=
          le_antisymm (le_of_not_gt hKpos) hKnonneg
        have hAone : (d : ℝ) - β = 1 := by linarith
        have hright' : ((d : ℝ) - β) * x.2 ≤ x.1 := by
          rw [hAone]
          simpa using htranslation
        exact mem_Q_of_triangle134_halfspaces hd hβpos hβone hβγ
          hcap hright' hcluster
    · exact mem_Q_of_triangle134_halfspaces hd hβpos hβone hβγ
        hcap hright hcluster

/-- Exact four-halfspace description of the closed exponent region. -/
theorem mem_Q_iff_not_sharpnessViolation
    {d : ℕ} {β γ : ℝ} {x : ExponentPoint}
    (hd : 2 ≤ d) (hβ : 0 ≤ β) (hβone : β ≤ 1) (hβγ : β ≤ γ) :
    x ∈ Q d β γ ↔ ¬ SharpnessViolation d β γ x := by
  constructor
  · exact not_sharpnessViolation_of_mem_Q hd hβ hβone hβγ
  · exact mem_Q_of_not_sharpnessViolation hd hβ hβone hβγ

end

end Auto.Spherical.FractalDilations.ExponentGeometry