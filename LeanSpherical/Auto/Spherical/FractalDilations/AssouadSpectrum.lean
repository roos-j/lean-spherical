/-- The empty set has every nonnegative upper-spectrum exponent. -/
theorem empty_hasUpperAssouadSpectrumExponent (θ γ : ℝ) :
    HasUpperAssouadSpectrumExponent (∅ : Set ℝ) θ γ := by
  refine ⟨1, zero_lt_one, fun δ a b hδ hδone ha hab hb hscale => ?_⟩
  refine ⟨∅, ?_, ?_⟩
  · simp [IsIntervalCover]
  simp only [Finset.card_empty, Nat.cast_zero]
  exact mul_nonneg zero_le_one (Real.rpow_nonneg (by positivity) _)

/-- The quasi-Assouad dimension.  The upper spectrum is increasing in the
scale parameter, so this supremum is its left limit at `1`.  Defining it this
way avoids assigning an arbitrary value before that monotonicity theorem is
used. -/
noncomputable def quasiAssouadDimension (F : Set ℝ) : ℝ :=
  sSup (upperAssouadSpectrum F '' Ico (0 : ℝ) 1)

/-- The filter formulation of the assertion that `γ` is the quasi-Assouad
dimension.  This is useful when the proof needs to choose a parameter `θ`
arbitrarily close to one. -/
def HasQuasiAssouadDimension (F : Set ℝ) (γ : ℝ) : Prop :=
  Tendsto (fun θ : ℝ => upperAssouadSpectrum F θ) (nhdsWithin 1 (Iio 1)) (𝓝 γ)

/-- The regularity hypothesis used for sharpness, with `γ` interpreted as
quasi-Assouad dimension rather than the full Assouad dimension. -/
def IsQuasiAssouadRegular (F : Set ℝ) (β γ : ℝ) : Prop :=
  upperMinkowskiDimension F = β ∧ quasiAssouadDimension F = γ ∧
    (γ = 0 ∨ ∀ θ : ℝ, 0 ≤ θ → θ < 1 → 1 - β / γ < θ →
      upperAssouadSpectrum F θ = γ)

