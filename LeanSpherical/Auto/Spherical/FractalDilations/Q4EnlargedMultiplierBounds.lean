  (q4EnlargedScaledNormalizedDerivativeMultiplierBound d C a j) ^ 2

/-- The literal pair of scaled normalized derivatives has the square of the
one-radius enlarged-range multiplier bound. -/
theorem norm_q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
    {n : Nat} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r r' : Real)
    (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (hr' : r' ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) j r r' xi‖ <=
      q4EnlargedScaledNormalizedDerivativePairMultiplierBound (n + 1) C a j := by
  let B : Real := q4EnlargedScaledNormalizedDerivativeMultiplierBound (n + 1) C a j
  have hB : 0 <= B := by
    dsimp only [B, q4EnlargedScaledNormalizedDerivativeMultiplierBound]
    exact mul_nonneg
      (mul_nonneg (dyadicScale_pos j).le (norm_nonneg _))
      (by
        dsimp only [q4EnlargedSurfaceDerivativeMultiplierBound]
        exact mul_nonneg (by norm_num)
          (div_nonneg hC.le (Real.rpow_nonneg (by positivity) _)))
  have hsingle (t : Real) (ht : t ∈ Icc (1 / 2 : Real) (5 / 2)) :
      ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
          (absoluteDyadicBandpass phi hphiOne hphiZero j) j t xi‖ <= B := by
    exact norm_q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
      C hC ha hderiv phi hphiOne hphiZero hphiNorm j hj t ht xi
  rw [q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier,
    norm_mul, starRingEnd_apply, norm_star]
  calc
    ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) j r xi‖ *
        ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
          (absoluteDyadicBandpass phi hphiOne hphiZero j) j r' xi‖ <= B * B :=
      mul_le_mul (hsingle r hr) (hsingle r' hr') (norm_nonneg _) hB
    _ = q4EnlargedScaledNormalizedDerivativePairMultiplierBound (n + 1) C a j := by
      dsimp only [q4EnlargedScaledNormalizedDerivativePairMultiplierBound, B]

/-- The derivative pair bound at literal active cells and a common local
offset.  The radius inclusion is proved from the active-cell geometry, not
assumed for the left endpoints. -/
theorem norm_q4ActiveDyadicScaledNormalizedDerivativePairMultiplier_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (hE : E ⊆ Icc (1 : Real) 2)
    (u : Real) (hu : u ∈ Icc (0 : Real) (dyadicScale j))
    (i l : Int) (hi : i ∈ activeDyadicIndices E j)
    (hl : l ∈ activeDyadicIndices E j)
    (xi : Euclidean (n + 1)) :
    ‖q4ActiveDyadicScaledNormalizedDerivativePairMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j)
        (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) j u i l xi‖ <=
      q4EnlargedScaledNormalizedDerivativePairMultiplierBound (n + 1) C a j := by
  rw [q4ActiveDyadicScaledNormalizedDerivativePairMultiplier_spec]
  apply norm_q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
    C hC ha hderiv phi hphiOne hphiZero hphiNorm j hj
  · exact dyadicLeft_add_mem_Icc_half_five_halves_of_mem_activeDyadicIndices
      hj hE hi hu
  · exact dyadicLeft_add_mem_Icc_half_five_halves_of_mem_activeDyadicIndices
      hj hE hl hu

end

