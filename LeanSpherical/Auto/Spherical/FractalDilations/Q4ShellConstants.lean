    field_simp [hR.ne']
  change 6 * C * (dyadicScale j) ^ (-eta) *
      ((2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
        dyadicScale j) ^ gamma = _
  rw [hdelta, hscale, hratio]

/-- The literal positive-level degree bound is controlled by its explicit
frequency/gap envelope.  This is exactly the upper Assouad-spectrum input
in the paper, with no equality-scale version of the spectrum used. -/
theorem q4ActiveDyadicPositiveGapDegree_le_frequency_gap_envelope
    {gamma eta C : ℝ} (hC : 0 ≤ C) (hgamma : 0 ≤ gamma)
    (j n : ℕ) :
    q4ActiveDyadicPositiveGapDegree gamma eta C j n ≤
      q4PositiveGapDegreeFrequencyEnvelope gamma eta C j n := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  have hR : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hone : 1 ≤ (2 : ℝ) ^ n := one_le_pow₀ (by norm_num)
  have hbase : 2 * ((2 : ℝ) ^ n + 1) ≤ (2 : ℝ) ^ (n + 2) := by
    calc
      2 * ((2 : ℝ) ^ n + 1) ≤ 2 * ((2 : ℝ) ^ n + (2 : ℝ) ^ n) := by
        apply mul_le_mul_of_nonneg_left
        · linarith
        · norm_num
      _ = (2 : ℝ) ^ (n + 2) := by
        rw [pow_add]
        norm_num
        ring
  have hbase_nonneg : 0 ≤ 2 * ((2 : ℝ) ^ n + 1) := by positivity
  have hpow : (2 * ((2 : ℝ) ^ n + 1)) ^ gamma ≤
      ((2 : ℝ) ^ (n + 2)) ^ gamma :=
    Real.rpow_le_rpow hbase_nonneg hbase hgamma
  have hpref : 0 ≤ 6 * C * R ^ eta := by
    exact mul_nonneg (mul_nonneg (by norm_num) hC)
      (Real.rpow_nonneg hR.le _)
  have hcast : ((n + 2 : ℕ) : ℝ) = (n : ℝ) + 2 := by norm_num
  have htop : ((2 : ℝ) ^ (n + 2)) ^ gamma =
      (2 : ℝ) ^ (2 * gamma) * (2 : ℝ) ^ (gamma * (n : ℝ)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul htwo.le, hcast,
      show ((n : Real) + 2) * gamma = 2 * gamma + gamma * (n : Real) by ring,
      Real.rpow_add htwo]
  rw [q4ActiveDyadicPositiveGapDegree_eq_frequency_gap_normalForm]
  change 6 * C * R ^ eta * (2 * ((2 : ℝ) ^ n + 1)) ^ gamma ≤
    (6 * C * (2 : ℝ) ^ (2 * gamma)) * R ^ eta *
      (2 : ℝ) ^ (gamma * (n : ℝ))
  calc
    6 * C * R ^ eta * (2 * ((2 : ℝ) ^ n + 1)) ^ gamma ≤
        6 * C * R ^ eta * ((2 : ℝ) ^ (n + 2)) ^ gamma :=
      mul_le_mul_of_nonneg_left hpow hpref
    _ = (6 * C * (2 : ℝ) ^ (2 * gamma)) * R ^ eta *
        (2 : ℝ) ^ (gamma * (n : ℝ)) := by
      rw [htop]
      ring

/-- Combining a literal pair-multiplier rate with the upper-spectrum count
gives the explicit unsquared `L²` coefficient of a positive Q4 shell.  The
multiplier-rate premise is internal plumbing: the two public corollaries
below instantiate it with the actual ordinary and derivative multipliers. -/
theorem q4ActiveDyadicPositiveGap_multiplier_degree_le_frequency_gap_envelope
    {d : ℕ} {gamma eta Ccover B B0 : ℝ}
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j n : ℕ)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    B * q4ActiveDyadicPositiveGapDegree gamma eta Ccover j n ≤
      q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  let D : ℝ := q4ActiveDyadicPositiveGapDegree gamma eta Ccover j n
  let D0 : ℝ := q4PositiveGapDegreeFrequencyEnvelope gamma eta Ccover j n
  let Benv : ℝ := B0 * R ^ (-((d : ℝ) - 1))
  have hR : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have hD : 0 ≤ D := by
    dsimp only [D, q4ActiveDyadicPositiveGapDegree]
    have hdelta : 0 < dyadicScale j := dyadicScale_pos j
    have hratio : 0 ≤
        (2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j := by
      apply div_nonneg
      · positivity
      · exact hdelta.le
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hCcover)
        (Real.rpow_nonneg hdelta.le _))
      (Real.rpow_nonneg hratio _)
  have hD0 : 0 ≤ D0 := by
    dsimp only [D0, q4PositiveGapDegreeFrequencyEnvelope]
    have h1 : (0 : Real) ≤ (2 : Real) ^ (2 * gamma) :=
      Real.rpow_nonneg (by norm_num) _
    have h2 : (0 : Real) ≤ (q4AbsoluteFrequencyScale j) ^ eta :=
      Real.rpow_nonneg hR.le _
    have h3 : (0 : Real) ≤ (2 : Real) ^ (gamma * (n : Real)) :=
      Real.rpow_nonneg (by norm_num) _
    have h4 : (0 : Real) ≤ 6 * Ccover * (2 : Real) ^ (2 * gamma) :=
      mul_nonneg (by linarith) h1
    exact mul_nonneg (mul_nonneg h4 h2) h3
  have hDle : D ≤ D0 := by
    dsimp only [D, D0]
    exact q4ActiveDyadicPositiveGapDegree_le_frequency_gap_envelope
      hCcover hgamma j n
  have hBenv : 0 ≤ Benv := by
    dsimp only [Benv]
    exact mul_nonneg hB0 (Real.rpow_nonneg hR.le _)
  have hBrate' : B ≤ Benv := by
    simpa only [Benv, R] using hBrate
  have hproduct : B * D ≤ Benv * D0 :=
    mul_le_mul hBrate' hDle hD hBenv
  have hpower : R ^ (-((d : ℝ) - 1)) * R ^ eta =
      R ^ (eta - ((d : ℝ) - 1)) := by
    rw [← Real.rpow_add hR]
    congr 1
    ring
  change B * D ≤ q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n
  dsimp only [q4PositiveGapEnergyFrequencyEnvelope]
  calc
    B * D ≤ Benv * D0 := hproduct
    _ = (B0 * (6 * Ccover * (2 : ℝ) ^ (2 * gamma))) *
        R ^ (eta - ((d : ℝ) - 1)) *
          (2 : ℝ) ^ (gamma * (n : ℝ)) := by
      dsimp only [Benv, D0, q4PositiveGapDegreeFrequencyEnvelope]
      rw [← hpower]
      ring

/-- Squared-energy form of the preceding literal multiplier/degree
calculation, ready to be inserted into the crossed shell constant. -/
theorem q4ActiveDyadicPositiveGapSquareConstant_le_frequency_gap_envelope
    {d : ℕ} {gamma eta Ccover B B0 : ℝ}
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j n : ℕ)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    q4ActiveDyadicPositiveGapSquareConstant gamma eta Ccover B j n ≤
      (q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2 := by
  let D : ℝ := q4ActiveDyadicPositiveGapDegree gamma eta Ccover j n
  let E0 : ℝ := q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n
  have hD : 0 ≤ D := by
    dsimp only [D, q4ActiveDyadicPositiveGapDegree]
    have hdelta : 0 < dyadicScale j := dyadicScale_pos j
    have hratio : 0 ≤
        (2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j := by
      apply div_nonneg
      · positivity
      · exact hdelta.le
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hCcover)
        (Real.rpow_nonneg hdelta.le _))
      (Real.rpow_nonneg hratio _)
  have hE0 : 0 ≤ E0 := by
    dsimp only [E0, q4PositiveGapEnergyFrequencyEnvelope]
    have hR : 0 ≤ q4AbsoluteFrequencyScale j :=
      (_root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j).le
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg hB0
          (mul_nonneg (mul_nonneg (by norm_num) hCcover)
            (Real.rpow_nonneg (by norm_num) _)))
        (Real.rpow_nonneg hR _))
      (Real.rpow_nonneg (by norm_num) _)
  have hunsquared : B * D ≤ E0 := by
    dsimp only [D, E0]
    exact q4ActiveDyadicPositiveGap_multiplier_degree_le_frequency_gap_envelope
      hCcover hgamma hB hB0 j n hBrate
  change (B * D) ^ 2 ≤ E0 ^ 2
  exact (sq_le_sq₀ (mul_nonneg hB hD) hE0).2 hunsquared

/-- The literal positive active shell is bounded by the crossed constant of
its explicit frequency/gap envelopes.  All hypotheses here are scalar
consequences of the actual multiplier and upper-spectrum estimates; the
ordinary and derivative corollaries below remove the multiplier-rate premise. -/
theorem q4ActiveDyadicPositiveGapStrongConstant_le_crossed_frequency_gap_envelope
    {d : ℕ} {gamma eta Ccover Ckernel B B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j n : ℕ) (hn : 0 < n)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel B j n q ≤
      q4CrossedStrongShellConstant q
        (q4PositiveGapKernelFrequencyEnvelope d Ckernel j n)
        ((q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2) := by
  have hA : 0 < q4ActiveDyadicPositiveGapKernelConstant d Ckernel j n := by
    dsimp only [q4ActiveDyadicPositiveGapKernelConstant]
    exact mul_pos (mul_pos hCkernel (pow_pos (by norm_num) _))
      (Real.rpow_pos_of_pos (pow_pos (by norm_num) _) _)
  have hAeq : q4ActiveDyadicPositiveGapKernelConstant d Ckernel j n =
      q4PositiveGapKernelFrequencyEnvelope d Ckernel j n :=
    q4ActiveDyadicPositiveGapKernelConstant_eq_frequency_gap_normalForm d Ckernel j n hn
  have hE : 0 ≤ q4ActiveDyadicPositiveGapSquareConstant gamma eta Ccover B j n :=
    sq_nonneg _
  have hEle : q4ActiveDyadicPositiveGapSquareConstant gamma eta Ccover B j n ≤
      (q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2 :=
    q4ActiveDyadicPositiveGapSquareConstant_le_frequency_gap_envelope
      hCcover hgamma hB hB0 j n hBrate
  unfold q4ActiveDyadicPositiveGapStrongConstant
  exact q4CrossedStrongShellConstant_mono hq hA hE hAeq.le hEle

/-- The shell-independent prefactor left after all frequency and gap powers
have been extracted from the literal positive Q4 crossed constant. -/
def q4PositiveGapStrongFrequencyPrefactor
    (d : ℕ) (gamma Ccover Ckernel B0 q : ℝ) : ℝ :=
  q4CrossedStrongShellPrefactor q *
    (B0 * (6 * Ccover * (2 : ℝ) ^ (2 * gamma))) ^ (2 / q) *
      (Ckernel * (2 : ℝ) ^ (((d : ℝ) - 1) / 2)) ^ (1 - 2 / q)

/-- Exact frequency/gap normal form of the crossed constant built from the
literal positive-shell envelopes.  This is the scalar calculation in
Section 3 of the paper: the exponents on `R` and on the gap are precisely
`q4FrequencyExponentWithSubpowerLoss` and `q4GapExponent`. -/
theorem q4CrossedStrongShellConstant_positive_envelope_eq_frequency_gap_normalForm
    {d : ℕ} {gamma eta Ccover Ckernel B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hB0 : 0 ≤ B0)
    (j n : ℕ) :
    q4CrossedStrongShellConstant q
      (q4PositiveGapKernelFrequencyEnvelope d Ckernel j n)
      ((q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2) =
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q *
          (q4AbsoluteFrequencyScale j) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta) *
          (2 : ℝ) ^ (q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  let a : ℝ := ((d : ℝ) - 1) / 2
  let H : ℝ := B0 * (6 * Ccover * (2 : ℝ) ^ (2 * gamma))
  let A0 : ℝ := Ckernel * (2 : ℝ) ^ a
  let u : ℝ := eta - ((d : ℝ) - 1)
  let v : ℝ := gamma * (n : ℝ)
  let e : ℝ := 1 - 2 / q
  have hqpos : 0 < q := lt_trans zero_lt_two hq
  have hR : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hH : 0 ≤ H := by
    dsimp only [H]
    exact mul_nonneg hB0
      (mul_nonneg (mul_nonneg (by norm_num) hCcover)
        (Real.rpow_nonneg (by norm_num) _))
  have hA0 : 0 < A0 := by
    dsimp only [A0]
    exact mul_pos hCkernel (Real.rpow_pos_of_pos htwo _)
  have hRu : 0 ≤ R ^ u := Real.rpow_nonneg hR.le _
  have htwov : 0 ≤ (2 : ℝ) ^ v := Real.rpow_nonneg htwo.le _
  have htwogap : 0 < (2 : ℝ) ^ (-a * (n : ℝ)) :=
    Real.rpow_pos_of_pos htwo _
  have hA : 0 < A0 * R * (2 : ℝ) ^ (-a * (n : ℝ)) := by
    exact mul_pos (mul_pos hA0 hR) htwogap
  have he : 0 ≤ e := by
    dsimp only [e]
    rw [sub_nonneg]
    exact (div_le_one hqpos).mpr hq.le
  have htheta : 2 / q = 2 * q⁻¹ := by rw [div_eq_mul_inv]
  have hEpower :
      ((H * R ^ u * (2 : ℝ) ^ v) ^ 2) ^ q⁻¹ =
        H ^ (2 / q) * R ^ (u * (2 / q)) *
          (2 : ℝ) ^ (v * (2 / q)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul
      (mul_nonneg (mul_nonneg hH hRu) htwov)]
    rw [Nat.cast_ofNat, ← htheta]
    rw [Real.mul_rpow (mul_nonneg hH hRu) htwov,
      Real.mul_rpow hH hRu]
    rw [← Real.rpow_mul hR.le, ← Real.rpow_mul htwo.le]
  have hApower :
      (A0 * R * (2 : ℝ) ^ (-a * (n : ℝ))) ^ e =
        A0 ^ e * R ^ e * (2 : ℝ) ^ ((-a * (n : ℝ)) * e) := by
    rw [Real.mul_rpow (mul_nonneg hA0.le hR.le) htwogap.le,
      Real.mul_rpow hA0.le hR.le, ← Real.rpow_mul htwo.le]
  have hfrequency : u * (2 / q) + e =
      q4FrequencyExponentWithSubpowerLoss d (2 / q) eta := by
    dsimp only [u, e]
    exact q4Crossed_frequencyExponent_eq_of_theta_eq_two_div d eta q hqpos.ne'
  have hgap : v * (2 / q) + (-a * (n : ℝ)) * e =
      q4GapExponent d gamma (2 / q) * (n : ℝ) := by
    dsimp only [v, a, e]
    exact q4Crossed_gapExponent_eq_of_theta_eq_two_div d gamma q hqpos.ne' n
  have hreal :
      q4CrossedStrongShellPrefactor q *
          ((H * R ^ u * (2 : ℝ) ^ v) ^ 2) ^ q⁻¹ *
          (A0 * R * (2 : ℝ) ^ (-a * (n : ℝ))) ^ e =
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q) *
          R ^ (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta) *
          (2 : ℝ) ^ (q4GapExponent d gamma (2 / q) * (n : ℝ)) := by
    rw [hEpower, hApower]
    calc
      q4CrossedStrongShellPrefactor q *
          (H ^ (2 / q) * R ^ (u * (2 / q)) *
            (2 : ℝ) ^ (v * (2 / q))) *
          (A0 ^ e * R ^ e * (2 : ℝ) ^ ((-a * (n : ℝ)) * e)) =
          (q4CrossedStrongShellPrefactor q * H ^ (2 / q) * A0 ^ e) *
            (R ^ (u * (2 / q)) * R ^ e) *
            ((2 : ℝ) ^ (v * (2 / q)) *
              (2 : ℝ) ^ ((-a * (n : ℝ)) * e)) := by ring
      _ = (q4CrossedStrongShellPrefactor q * H ^ (2 / q) * A0 ^ e) *
            R ^ (u * (2 / q) + e) *
            (2 : ℝ) ^ (v * (2 / q) + (-a * (n : ℝ)) * e) := by
        rw [← Real.rpow_add hR, ← Real.rpow_add htwo]
      _ = (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q) *
            R ^ (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta) *
            (2 : ℝ) ^ (q4GapExponent d gamma (2 / q) * (n : ℝ)) := by
        rw [hfrequency, hgap]
        rfl
  change q4CrossedStrongShellConstant q
      (A0 * R * (2 : ℝ) ^ (-a * (n : ℝ)))
      ((H * R ^ u * (2 : ℝ) ^ v) ^ 2) = _
  rw [q4CrossedStrongShellConstant_eq_ofReal_homogeneous hq hA (sq_nonneg _)]
  change ENNReal.ofReal
      (q4CrossedStrongShellPrefactor q *
        ((H * R ^ u * (2 : ℝ) ^ v) ^ 2) ^ q⁻¹ *
        (A0 * R * (2 : ℝ) ^ (-a * (n : ℝ))) ^ e) = _
  rw [hreal]

/-- Conversion from the absolute dyadic frequency scale to a real-power
dyadic exponent. -/
theorem q4AbsoluteFrequencyScale_rpow_eq_two_rpow
    (j : ℕ) (a : ℝ) :
    (q4AbsoluteFrequencyScale j) ^ a =
      (2 : ℝ) ^ (a * (j : ℝ)) := by
  change ((2 : ℝ) ^ j) ^ a = (2 : ℝ) ^ (a * (j : ℝ))
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
  congr 1
  ring

/-- The envelope crossed constant in the exact form required by the
finite-level reassembly lemmas: one frequency exponent times one gap
exponent, both expressed with base `2`. -/
theorem q4CrossedStrongShellConstant_positive_envelope_eq_dyadic_normalForm
    {d : ℕ} {gamma eta Ccover Ckernel B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hB0 : 0 ≤ B0)
    (j n : ℕ) :
    q4CrossedStrongShellConstant q
      (q4PositiveGapKernelFrequencyEnvelope d Ckernel j n)
      ((q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2) =
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  rw [q4CrossedStrongShellConstant_positive_envelope_eq_frequency_gap_normalForm
    hq hCkernel hCcover hB0 j n,
    q4AbsoluteFrequencyScale_rpow_eq_two_rpow]
  rw [mul_assoc, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]

/-- Internal scalar bridge from a pair-multiplier frequency rate to the
literal positive active-shell dyadic rate.  The following three corollaries
instantiate this with the actual ordinary, higher-dimensional derivative,
and signed planar derivative multiplier constants. -/
theorem q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_multiplierRate
    {d : ℕ} {gamma eta Ccover Ckernel B B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j n : ℕ) (hn : 0 < n)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel B j n q ≤
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  calc
    q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel B j n q ≤
        q4CrossedStrongShellConstant q
          (q4PositiveGapKernelFrequencyEnvelope d Ckernel j n)
          ((q4PositiveGapEnergyFrequencyEnvelope d gamma eta Ccover B0 j n) ^ 2) :=
      q4ActiveDyadicPositiveGapStrongConstant_le_crossed_frequency_gap_envelope
        hq hCkernel hCcover hgamma hB hB0 j n hn hBrate
    _ = ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) :=
      q4CrossedStrongShellConstant_positive_envelope_eq_dyadic_normalForm
        hq hCkernel hCcover hB0 j n

/-- Public ordinary-multiplier Q4 shell rate.  The multiplier is the actual
absolute-bandpass pair multiplier from the sharp spherical Fourier estimate,
not a supplied abstract `L²` endpoint. -/
theorem q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
    {d : ℕ} {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (j n : ℕ) (hn : 0 < n) :
    q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel
      (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j n q ≤
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel
          (4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)) q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let B : ℝ := q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j
  let B0 : ℝ := 4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)
  have hB : 0 ≤ B := by
    dsimp only [B, q4EnlargedPairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C))
      (Real.rpow_nonneg (by norm_num) _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1)) := by
    simpa only [B, B0] using le_of_eq
      (q4EnlargedPairMultiplierBound_eq_dimension_frequency_normalForm d C j)
  simpa only [B, B0] using
    (q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_multiplierRate
      hq hCkernel hCcover hgamma hB hB0 j n hn hBrate)

/-- Public higher-dimensional derivative-multiplier Q4 shell rate.  The
coefficient is the literal scaled normalized derivative pair multiplier at
the sharp derivative exponent; the cell-length cancellation is already
encoded in its proved normal form. -/
theorem q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_derivativeMultiplier
    {d : ℕ} {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (j n : ℕ) (hn : 0 < n) :
    q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel
      (q4EnlargedScaledNormalizedDerivativePairMultiplierBound d C
        ((((d : ℝ) - 1) / 2) - 1) j) j n q ≤
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel
          (16 * C ^ 2 * ‖(surfaceMass d : Complex)⁻¹‖ ^ 2 *
            (2 : ℝ) ^ ((d : ℝ) - 3)) q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let B : ℝ := q4EnlargedScaledNormalizedDerivativePairMultiplierBound d C
    ((((d : ℝ) - 1) / 2) - 1) j
  let B0 : ℝ := 16 * C ^ 2 * ‖(surfaceMass d : Complex)⁻¹‖ ^ 2 *
    (2 : ℝ) ^ ((d : ℝ) - 3)
  have hB : 0 ≤ B := by
    dsimp only [B, q4EnlargedScaledNormalizedDerivativePairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg C)) (sq_nonneg _))
      (Real.rpow_nonneg (by norm_num) _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1)) := by
    simpa only [B, B0] using le_of_eq
      (q4EnlargedScaledNormalizedDerivativePairMultiplierBound_eq_dimension_frequency_normalForm
        d C j)
  simpa only [B, B0] using
    (q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_multiplierRate
      hq hCkernel hCcover hgamma hB hB0 j n hn hBrate)

/-- Public signed-planar-derivative Q4 shell rate.  This is separate from
the preceding theorem because the circle derivative has exponent `-1/2` and
uses the proved upper-annulus multiplier calculation rather than a false
nonnegative-decay specialization. -/
theorem q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_planarSignedDerivativeMultiplier
    {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma)
    (j n : ℕ) (hn : 0 < n) :
    q4ActiveDyadicPositiveGapStrongConstant 2 gamma eta Ccover Ckernel
      (q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C j) j n q ≤
      ENNReal.ofReal
        (q4PositiveGapStrongFrequencyPrefactor 2 gamma Ccover Ckernel
          (160 * C ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2) q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss 2 (2 / q) eta * (j : ℝ) +
              q4GapExponent 2 gamma (2 / q) * (n : ℝ))) := by
  let B : ℝ := q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C j
  let B0 : ℝ := 160 * C ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp only [B, q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C))
      (sq_nonneg _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((2 : ℝ) - 1)) := by
    have hdim : -((2 : ℝ) - 1) = (-1 : ℝ) := by norm_num
    rw [hdim]
    simpa only [B, B0] using le_of_eq
      (q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound_eq_frequency_normalForm
        C j)
  simpa only [B, B0] using
    (q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_multiplierRate
      (d := 2) hq hCkernel hCcover hgamma hB hB0 j n hn hBrate)

/-! ## The diagonal level -/

/-- The shell-independent prefactor for the genuine diagonal Q4 level. -/
def q4DiagonalStrongFrequencyPrefactor
    (Ckernel B0 q : ℝ) : ℝ :=
  q4CrossedStrongShellPrefactor q * B0 ^ (2 / q) *
    Ckernel ^ (1 - 2 / q)

/-- Positivity bookkeeping for the positive-shell prefactor. -/
theorem q4PositiveGapStrongFrequencyPrefactor_nonneg
    {d : ℕ} {gamma Ccover Ckernel B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hB0 : 0 ≤ B0) :
    0 ≤ q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q := by
  have hqpos : 0 < q := lt_trans zero_lt_two hq
  have hcross : 0 ≤ q4CrossedStrongShellPrefactor q := by
    unfold q4CrossedStrongShellPrefactor
    exact Real.rpow_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg hqpos.le (by norm_num))
          (inv_nonneg.mpr (sub_nonneg.mpr hq.le)))
        (Real.rpow_nonneg (by norm_num) _)) _
  unfold q4PositiveGapStrongFrequencyPrefactor
  exact mul_nonneg
    (mul_nonneg hcross
      (Real.rpow_nonneg
        (mul_nonneg hB0
          (mul_nonneg (mul_nonneg (by norm_num) hCcover)
            (Real.rpow_nonneg (by norm_num) _))) _))
    (Real.rpow_nonneg
      (mul_nonneg hCkernel.le (Real.rpow_nonneg (by norm_num) _)) _)

/-- Positivity bookkeeping for the diagonal-shell prefactor. -/
theorem q4DiagonalStrongFrequencyPrefactor_nonneg
    {Ckernel B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel) (hB0 : 0 ≤ B0) :
    0 ≤ q4DiagonalStrongFrequencyPrefactor Ckernel B0 q := by
  have hqpos : 0 < q := lt_trans zero_lt_two hq
  have hcross : 0 ≤ q4CrossedStrongShellPrefactor q := by
    unfold q4CrossedStrongShellPrefactor
    exact Real.rpow_nonneg
      (mul_nonneg
        (mul_nonneg
          (mul_nonneg hqpos.le (by norm_num))
          (inv_nonneg.mpr (sub_nonneg.mpr hq.le)))
        (Real.rpow_nonneg (by norm_num) _)) _
  unfold q4DiagonalStrongFrequencyPrefactor
  exact mul_nonneg
    (mul_nonneg hcross (Real.rpow_nonneg hB0 _))
    (Real.rpow_nonneg hCkernel.le _)

/-- Exact frequency normal form of a diagonal crossed shell with a pair
multiplier coefficient `B0 R^{-(d-1)}`. -/
theorem q4CrossedStrongShellConstant_diagonal_envelope_eq_frequency_normalForm
    {d : ℕ} {Ckernel B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel) (hB0 : 0 ≤ B0)
    (j : ℕ) :
    q4CrossedStrongShellConstant q
      (q4ActiveDyadicDiagonalKernelConstant Ckernel j)
      ((B0 * (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) ^ 2) =
      ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          (q4AbsoluteFrequencyScale j) ^
            (q4FrequencyExponent d (2 / q))) := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  let D : ℝ := (d : ℝ) - 1
  let e : ℝ := 1 - 2 / q
  have hqpos : 0 < q := lt_trans zero_lt_two hq
  have hR : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have hA : 0 < Ckernel * R := mul_pos hCkernel hR
  have hRneg : 0 ≤ R ^ (-D) := Real.rpow_nonneg hR.le _
  have he : 0 ≤ e := by
    dsimp only [e]
    rw [sub_nonneg]
    exact (div_le_one hqpos).mpr hq.le
  have htheta : 2 / q = 2 * q⁻¹ := by rw [div_eq_mul_inv]
  have hEpower : ((B0 * R ^ (-D)) ^ 2) ^ q⁻¹ =
      B0 ^ (2 / q) * R ^ ((-D) * (2 / q)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (mul_nonneg hB0 hRneg)]
    rw [Nat.cast_ofNat, ← htheta]
    rw [Real.mul_rpow hB0 hRneg, ← Real.rpow_mul hR.le]
  have hApower : (Ckernel * R) ^ e = Ckernel ^ e * R ^ e := by
    rw [Real.mul_rpow hCkernel.le hR.le]
  have hfrequency : (-D) * (2 / q) + e = q4FrequencyExponent d (2 / q) := by
    dsimp only [D, e, q4FrequencyExponent]
    field_simp [hqpos.ne']
    ring
  change q4CrossedStrongShellConstant q (Ckernel * R) ((B0 * R ^ (-D)) ^ 2) = _
  rw [q4CrossedStrongShellConstant_eq_ofReal_homogeneous hq hA (sq_nonneg _)]
  change ENNReal.ofReal
      (q4CrossedStrongShellPrefactor q *
        ((B0 * R ^ (-D)) ^ 2) ^ q⁻¹ * (Ckernel * R) ^ e) = _
  rw [hEpower, hApower]
  calc
    ENNReal.ofReal
        (q4CrossedStrongShellPrefactor q *
          (B0 ^ (2 / q) * R ^ ((-D) * (2 / q))) *
          (Ckernel ^ e * R ^ e)) =
        ENNReal.ofReal
          ((q4CrossedStrongShellPrefactor q * B0 ^ (2 / q) * Ckernel ^ e) *
            (R ^ ((-D) * (2 / q)) * R ^ e)) := by
      congr 1
      ring
    _ = ENNReal.ofReal
        ((q4CrossedStrongShellPrefactor q * B0 ^ (2 / q) * Ckernel ^ e) *
          R ^ (((-D) * (2 / q)) + e)) := by
      rw [← Real.rpow_add hR]
    _ = ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          R ^ (q4FrequencyExponent d (2 / q))) := by
      rw [hfrequency]
      rfl

/-- The diagonal literal shell obeys the same subpower-loss frequency rate
as the positive shells.  The diagonal itself has no cover loss, so this is
just monotonicity in the (harmless) factor `R^(theta * eta)`. -/
theorem q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_multiplierRate
    {d : ℕ} {eta Ckernel B B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (heta : 0 ≤ eta) (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j : ℕ)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    q4ActiveDyadicDiagonalStrongConstant Ckernel B j q ≤
      ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ))) := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  let Benv : ℝ := B0 * R ^ (-((d : ℝ) - 1))
  have hqpos : 0 < q := lt_trans zero_lt_two hq
  have hR : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have hRone : 1 ≤ R := by
    dsimp only [R, q4AbsoluteFrequencyScale,
      _root_.Auto.Spherical.SurfaceCore.dyadicScale]
    exact one_le_pow₀ (by norm_num)
  have hA : 0 < q4ActiveDyadicDiagonalKernelConstant Ckernel j := by
    dsimp only [q4ActiveDyadicDiagonalKernelConstant]
    exact mul_pos hCkernel (pow_pos (by norm_num) _)
  have hBenv : 0 ≤ Benv := by
    dsimp only [Benv]
    exact mul_nonneg hB0 (Real.rpow_nonneg hR.le _)
  have hBrate' : B ≤ Benv := by
    simpa only [Benv, R] using hBrate
  have hEsq : B ^ 2 ≤ Benv ^ 2 :=
    (sq_le_sq₀ hB hBenv).2 hBrate'
  have hmodel : q4ActiveDyadicDiagonalStrongConstant Ckernel B j q ≤
      q4CrossedStrongShellConstant q
        (q4ActiveDyadicDiagonalKernelConstant Ckernel j) (Benv ^ 2) := by
    unfold q4ActiveDyadicDiagonalStrongConstant
    exact q4CrossedStrongShellConstant_mono hq hA (sq_nonneg _) le_rfl hEsq
  have hfrequency : q4FrequencyExponent d (2 / q) ≤
      q4FrequencyExponentWithSubpowerLoss d (2 / q) eta := by
    unfold q4FrequencyExponentWithSubpowerLoss
    have htheta : 0 ≤ 2 / q := div_nonneg (by norm_num) hqpos.le
    linarith [mul_nonneg htheta heta]
  have hRpow : R ^ (q4FrequencyExponent d (2 / q)) ≤
      R ^ (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta) :=
    Real.rpow_le_rpow_of_exponent_le hRone hfrequency
  have hP : 0 ≤ q4DiagonalStrongFrequencyPrefactor Ckernel B0 q := by
    unfold q4DiagonalStrongFrequencyPrefactor
    have hcross : 0 ≤ q4CrossedStrongShellPrefactor q := by
      unfold q4CrossedStrongShellPrefactor
      exact Real.rpow_nonneg
        (mul_nonneg
          (mul_nonneg
            (mul_nonneg hqpos.le (by norm_num))
            (inv_nonneg.mpr (sub_nonneg.mpr hq.le)))
          (Real.rpow_nonneg (by norm_num) _)) _
    exact mul_nonneg
      (mul_nonneg hcross (Real.rpow_nonneg hB0 _))
      (Real.rpow_nonneg hCkernel.le _)
  calc
    q4ActiveDyadicDiagonalStrongConstant Ckernel B j q ≤
        q4CrossedStrongShellConstant q
          (q4ActiveDyadicDiagonalKernelConstant Ckernel j) (Benv ^ 2) := hmodel
    _ = ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          R ^ q4FrequencyExponent d (2 / q)) := by
      simpa only [Benv, R] using
        (q4CrossedStrongShellConstant_diagonal_envelope_eq_frequency_normalForm
          (d := d) hq hCkernel hB0 j)
    _ ≤ ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          R ^ q4FrequencyExponentWithSubpowerLoss d (2 / q) eta) := by
      apply ENNReal.ofReal_le_ofReal
      exact mul_le_mul_of_nonneg_left hRpow hP
    _ = ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel B0 q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ))) := by
      rw [q4AbsoluteFrequencyScale_rpow_eq_two_rpow]

/-- Literal ordinary-multiplier diagonal rate. -/
theorem q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
    {d : ℕ} {eta Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel) (heta : 0 ≤ eta)
    (j : ℕ) :
    q4ActiveDyadicDiagonalStrongConstant Ckernel
      (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j q ≤
      ENNReal.ofReal
        (q4DiagonalStrongFrequencyPrefactor Ckernel
          (4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)) q *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ))) := by
  let B : ℝ := q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j
  let B0 : ℝ := 4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)
  have hB : 0 ≤ B := by
    dsimp only [B, q4EnlargedPairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C))
      (Real.rpow_nonneg (by norm_num) _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1)) := by
    simpa only [B, B0] using le_of_eq
      (q4EnlargedPairMultiplierBound_eq_dimension_frequency_normalForm d C j)
  simpa only [B, B0] using
    (q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_multiplierRate
      (d := d) hq hCkernel heta hB hB0 j hBrate)

