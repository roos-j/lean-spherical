/-! ## Uniform literal level rates -/

/-- The ordinary absolute-bandpass multiplier gives one uniform dyadic
normal form for every canonical active level, including the genuine
diagonal `n = 0`.  This is the direct input to the finite active-level
reassembly; there is no abstract `hlevel` endpoint in this statement. -/
theorem q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
    {d : ℕ} {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma) (heta : 0 ≤ eta)
    (j n : ℕ) :
    q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel
      (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j n q ≤
      ENNReal.ofReal
        ((q4DiagonalStrongFrequencyPrefactor Ckernel
            (4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)) q +
          q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel
            (4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)) q) *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let B0 : ℝ := 4 * C ^ 2 * (2 : ℝ) ^ ((d : ℝ) - 1)
  let Pdiag : ℝ := q4DiagonalStrongFrequencyPrefactor Ckernel B0 q
  let Ppos : ℝ := q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q
  let P : ℝ := Pdiag + Ppos
  let a : ℝ := q4FrequencyExponentWithSubpowerLoss d (2 / q) eta
  let b : ℝ := q4GapExponent d gamma (2 / q)
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C))
      (Real.rpow_nonneg (by norm_num) _)
  have hPdiag : 0 ≤ Pdiag := by
    dsimp only [Pdiag]
    exact q4DiagonalStrongFrequencyPrefactor_nonneg hq hCkernel hB0
  have hPpos : 0 ≤ Ppos := by
    dsimp only [Ppos]
    exact q4PositiveGapStrongFrequencyPrefactor_nonneg
      hq hCkernel hCcover hB0
  have hdiag_le : Pdiag ≤ P := le_add_of_nonneg_right hPpos
  have hpos_le : Ppos ≤ P := le_add_of_nonneg_left hPdiag
  change q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel
      (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j n q ≤
      ENNReal.ofReal (P * (2 : ℝ) ^ (a * (j : ℝ) + b * (n : ℝ)))
  by_cases hnzero : n = 0
  · subst n
    rw [q4ActiveDyadicLevelStrongConstant, if_pos rfl]
    calc
      q4ActiveDyadicDiagonalStrongConstant Ckernel
          (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j q ≤
          ENNReal.ofReal (Pdiag * (2 : ℝ) ^ (a * (j : ℝ))) := by
        dsimp only [Pdiag, B0, a]
        exact q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
          hq hCkernel heta j
      _ ≤ ENNReal.ofReal (P * (2 : ℝ) ^
          (a * (j : ℝ) + b * ((0 : Nat) : ℝ))) := by
        apply ENNReal.ofReal_le_ofReal
        rw [Nat.cast_zero, mul_zero, add_zero]
        exact mul_le_mul_of_nonneg_right hdiag_le
          (Real.rpow_nonneg (by norm_num) _)
  · have hn : 0 < n := Nat.pos_of_ne_zero hnzero
    rw [q4ActiveDyadicLevelStrongConstant, if_neg hnzero]
    calc
      q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel
          (q4EnlargedPairMultiplierBound C (((d : ℝ) - 1) / 2) j) j n q ≤
          ENNReal.ofReal (Ppos *
            (2 : ℝ) ^ (a * (j : ℝ) + b * (n : ℝ))) := by
        dsimp only [Ppos, B0, a, b]
        exact q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_ordinaryMultiplier
          hq hCkernel hCcover hgamma j n hn
      _ ≤ ENNReal.ofReal (P * (2 : ℝ) ^
          (a * (j : ℝ) + b * (n : ℝ))) := by
        apply ENNReal.ofReal_le_ofReal
        exact mul_le_mul_of_nonneg_right hpos_le
          (Real.rpow_nonneg (by norm_num) _)

/-- Internal all-level version of the preceding theorem.  It is used only
to instantiate the two literal derivative multiplier corollaries below. -/
theorem q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_multiplierRate
    {d : ℕ} {gamma eta Ccover Ckernel B B0 q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma) (heta : 0 ≤ eta)
    (hB : 0 ≤ B) (hB0 : 0 ≤ B0)
    (j n : ℕ)
    (hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1))) :
    q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q ≤
      ENNReal.ofReal
        ((q4DiagonalStrongFrequencyPrefactor Ckernel B0 q +
          q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q) *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let Pdiag : ℝ := q4DiagonalStrongFrequencyPrefactor Ckernel B0 q
  let Ppos : ℝ := q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel B0 q
  let P : ℝ := Pdiag + Ppos
  let a : ℝ := q4FrequencyExponentWithSubpowerLoss d (2 / q) eta
  let b : ℝ := q4GapExponent d gamma (2 / q)
  have hPdiag : 0 ≤ Pdiag := by
    dsimp only [Pdiag]
    exact q4DiagonalStrongFrequencyPrefactor_nonneg hq hCkernel hB0
  have hPpos : 0 ≤ Ppos := by
    dsimp only [Ppos]
    exact q4PositiveGapStrongFrequencyPrefactor_nonneg
      hq hCkernel hCcover hB0
  have hdiag_le : Pdiag ≤ P := le_add_of_nonneg_right hPpos
  have hpos_le : Ppos ≤ P := le_add_of_nonneg_left hPdiag
  change q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q ≤
      ENNReal.ofReal (P * (2 : ℝ) ^ (a * (j : ℝ) + b * (n : ℝ)))
  by_cases hnzero : n = 0
  · subst n
    rw [q4ActiveDyadicLevelStrongConstant, if_pos rfl]
    calc
      q4ActiveDyadicDiagonalStrongConstant Ckernel B j q ≤
          ENNReal.ofReal (Pdiag * (2 : ℝ) ^ (a * (j : ℝ))) := by
        dsimp only [Pdiag, a]
        exact q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_multiplierRate
          hq hCkernel heta hB hB0 j hBrate
      _ ≤ ENNReal.ofReal (P * (2 : ℝ) ^
          (a * (j : ℝ) + b * ((0 : Nat) : ℝ))) := by
        apply ENNReal.ofReal_le_ofReal
        rw [Nat.cast_zero, mul_zero, add_zero]
        exact mul_le_mul_of_nonneg_right hdiag_le
          (Real.rpow_nonneg (by norm_num) _)
  · have hn : 0 < n := Nat.pos_of_ne_zero hnzero
    rw [q4ActiveDyadicLevelStrongConstant, if_neg hnzero]
    calc
      q4ActiveDyadicPositiveGapStrongConstant d gamma eta Ccover Ckernel B j n q ≤
          ENNReal.ofReal (Ppos *
            (2 : ℝ) ^ (a * (j : ℝ) + b * (n : ℝ))) := by
        dsimp only [Ppos, a, b]
        exact q4ActiveDyadicPositiveGapStrongConstant_le_dyadic_normalForm_of_multiplierRate
          hq hCkernel hCcover hgamma hB hB0 j n hn hBrate
      _ ≤ ENNReal.ofReal (P * (2 : ℝ) ^
          (a * (j : ℝ) + b * (n : ℝ))) := by
        apply ENNReal.ofReal_le_ofReal
        exact mul_le_mul_of_nonneg_right hpos_le
          (Real.rpow_nonneg (by norm_num) _)

/-- Uniform all-level rate for the literal higher-dimensional scaled
derivative multiplier. -/
theorem q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_derivativeMultiplier
    {d : ℕ} {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma) (heta : 0 ≤ eta)
    (j n : ℕ) :
    q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel
      (q4EnlargedScaledNormalizedDerivativePairMultiplierBound d C
        ((((d : ℝ) - 1) / 2) - 1) j) j n q ≤
      ENNReal.ofReal
        ((q4DiagonalStrongFrequencyPrefactor Ckernel
            (16 * C ^ 2 * ‖(surfaceMass d : Complex)⁻¹‖ ^ 2 *
              (2 : ℝ) ^ ((d : ℝ) - 3)) q +
          q4PositiveGapStrongFrequencyPrefactor d gamma Ccover Ckernel
            (16 * C ^ 2 * ‖(surfaceMass d : Complex)⁻¹‖ ^ 2 *
              (2 : ℝ) ^ ((d : ℝ) - 3)) q) *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d (2 / q) eta * (j : ℝ) +
              q4GapExponent d gamma (2 / q) * (n : ℝ))) := by
  let B : ℝ := q4EnlargedScaledNormalizedDerivativePairMultiplierBound d C
    ((((d : ℝ) - 1) / 2) - 1) j
  let B0 : ℝ := 16 * C ^ 2 * ‖(surfaceMass d : Complex)⁻¹‖ ^ 2 *
    (2 : ℝ) ^ ((d : ℝ) - 3)
  have hB : 0 ≤ B := by
    dsimp only [B, q4EnlargedScaledNormalizedDerivativePairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg C)) (sq_nonneg _))
      (Real.rpow_nonneg (by norm_num) _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((d : ℝ) - 1)) := by
    simpa only [B, B0] using le_of_eq
      (q4EnlargedScaledNormalizedDerivativePairMultiplierBound_eq_dimension_frequency_normalForm
        d C j)
  simpa only [B, B0] using
    (q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_multiplierRate
      hq hCkernel hCcover hgamma heta hB hB0 j n hBrate)

/-- Uniform all-level rate for the literal signed planar derivative
multiplier. -/
theorem q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_planarSignedDerivativeMultiplier
    {gamma eta Ccover Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel)
    (hCcover : 0 ≤ Ccover) (hgamma : 0 ≤ gamma) (heta : 0 ≤ eta)
    (j n : ℕ) :
    q4ActiveDyadicLevelStrongConstant 2 gamma eta Ccover Ckernel
      (q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C j) j n q ≤
      ENNReal.ofReal
        ((q4DiagonalStrongFrequencyPrefactor Ckernel
            (160 * C ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2) q +
          q4PositiveGapStrongFrequencyPrefactor 2 gamma Ccover Ckernel
            (160 * C ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2) q) *
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss 2 (2 / q) eta * (j : ℝ) +
              q4GapExponent 2 gamma (2 / q) * (n : ℝ))) := by
  let B : ℝ := q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound C j
  let B0 : ℝ := 160 * C ^ 2 * ‖(surfaceMass 2 : Complex)⁻¹‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp only [B, q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound]
    exact sq_nonneg _
  have hB0 : 0 ≤ B0 := by
    dsimp only [B0]
    exact mul_nonneg
      (mul_nonneg (by norm_num) (sq_nonneg C))
      (sq_nonneg _)
  have hBrate : B ≤ B0 *
      (q4AbsoluteFrequencyScale j) ^ (-((2 : ℝ) - 1)) := by
    have hdim : -((2 : ℝ) - 1) = (-1 : ℝ) := by norm_num
    rw [hdim]
    simpa only [B, B0] using le_of_eq
      (q4PlanarEnlargedScaledNormalizedDerivativePairMultiplierBound_eq_frequency_normalForm
        C j)
  simpa only [B, B0] using
    (q4ActiveDyadicLevelStrongConstant_le_dyadic_normalForm_of_multiplierRate
      (d := 2) hq hCkernel hCcover hgamma heta hB hB0 j n hBrate)

end

