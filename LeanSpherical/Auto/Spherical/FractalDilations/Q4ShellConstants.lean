    (d : ℕ) (C : ℝ) (j n : ℕ) (hn : 0 < n) :
    q4ActiveDyadicPositiveGapKernelConstant d C j n =
      q4PositiveGapKernelFrequencyEnvelope d C j n := by
  let R : ℝ := q4AbsoluteFrequencyScale j
  let a : ℝ := ((d : ℝ) - 1) / 2
  have htwo : 0 < (2 : ℝ) := by norm_num
  have hncast : ((n - 1 : ℕ) : ℝ) = (n : ℝ) - 1 := by
    rw [Nat.cast_sub (Nat.succ_le_iff.mpr hn)]
    norm_num
  have hexp : ((n : ℝ) - 1) * (-a) = a + (-a * (n : ℝ)) := by ring
