/-! ## Literal kernel and cover envelopes -/

/-- The frequency/gap normal form of the positive stationary kernel
coefficient. -/
def q4PositiveGapKernelFrequencyEnvelope
    (d : ℕ) (C : ℝ) (j n : ℕ) : ℝ :=
  (C * (2 : ℝ) ^ (((d : ℝ) - 1) / 2)) *
    q4AbsoluteFrequencyScale j *
      (2 : ℝ) ^ (-(((d : ℝ) - 1) / 2) * (n : ℝ))

/-- The explicit dyadic envelope for the upper-spectrum degree of a
positive gap shell.  The factor `2^(2γ)` is the harmless comparison
`2 (2^n + 1) ≤ 2^(n+2)`. -/
def q4PositiveGapDegreeFrequencyEnvelope
    (gamma eta C : ℝ) (j n : ℕ) : ℝ :=
  (6 * C * (2 : ℝ) ^ (2 * gamma)) *
    (q4AbsoluteFrequencyScale j) ^ eta *
      (2 : ℝ) ^ (gamma * (n : ℝ))

/-- The unsquared `L²` shell coefficient after combining the pair multiplier
and the upper-spectrum degree envelope. -/
def q4PositiveGapEnergyFrequencyEnvelope
    (d : ℕ) (gamma eta Ccover B0 : ℝ) (j n : ℕ) : ℝ :=
  (B0 * (6 * Ccover * (2 : ℝ) ^ (2 * gamma))) *
    (q4AbsoluteFrequencyScale j) ^ (eta - ((d : ℝ) - 1)) *
      (2 : ℝ) ^ (gamma * (n : ℝ))

/-- The frequency exponent in the crossed shell normal form after putting
`theta = 2 / q`. -/
theorem q4Crossed_frequencyExponent_eq_of_theta_eq_two_div
    (d : ℕ) (eta q : ℝ) (hq : q ≠ 0) :
    (eta - ((d : ℝ) - 1)) * (2 / q) + (1 - 2 / q) =
      q4FrequencyExponentWithSubpowerLoss d (2 / q) eta := by
  unfold q4FrequencyExponentWithSubpowerLoss q4FrequencyExponent
  field_simp [hq]
  ring

/-- The radius-gap exponent in the crossed shell normal form after putting
`theta = 2 / q`. -/
theorem q4Crossed_gapExponent_eq_of_theta_eq_two_div
    (d : ℕ) (gamma q : ℝ) (hq : q ≠ 0) (n : ℕ) :
    gamma * (n : ℝ) * (2 / q) +
        (-(((d : ℝ) - 1) / 2) * (n : ℝ)) * (1 - 2 / q) =
      q4GapExponent d gamma (2 / q) * (n : ℝ) := by
  unfold q4GapExponent
  field_simp [hq]
  ring

