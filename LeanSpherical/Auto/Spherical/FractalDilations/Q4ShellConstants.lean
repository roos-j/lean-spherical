/-- Literal signed-planar-derivative diagonal rate. -/
theorem q4ActiveDyadicDiagonalStrongConstant_le_dyadic_normalForm_of_planarSignedDerivativeMultiplier
    {eta Ckernel C q : ℝ}
    (hq : 2 < q) (hCkernel : 0 < Ckernel) (heta : 0 ≤ eta)
