/-- Pointwise derivative form of the quadratic moment identity. -/
theorem deriv_quadraticMomentIntegral
    (m : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h)
    (lambda : Real) :
    deriv (quadraticMomentIntegral m h) lambda =
      Complex.I * quadraticMomentIntegral (m + 2) h lambda :=
  (hasDerivAt_quadraticMomentIntegral m h hh lambda).deriv

/-- Exact formula for every iterated parameter derivative of a quadratic
endpoint moment. -/
theorem iteratedDeriv_quadraticMomentIntegral
    (m k : Nat) (h : Real -> Complex) (hh : ContDiff Real (⊤ : ℕ∞) h) :
    iteratedDeriv k (quadraticMomentIntegral m h) =
      fun lambda => Complex.I ^ k * quadraticMomentIntegral (m + 2 * k) h lambda := by
  induction k with
  | zero =>
      ext lambda
      simp [iteratedDeriv]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext lambda
      have hindex : m + 2 * k + 2 = m + 2 * (k + 1) := by omega
      have hderiv : deriv (quadraticMomentIntegral (m + 2 * k) h) =
          fun lambda => Complex.I * quadraticMomentIntegral (m + 2 * k + 2) h lambda := by
        funext z
        exact deriv_quadraticMomentIntegral (m + 2 * k) h hh z
      rw [deriv_const_mul_field, hderiv, hindex, pow_succ]
      ring

