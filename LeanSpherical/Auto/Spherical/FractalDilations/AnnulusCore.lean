/-- A normalized spherical average preserves the integral of a continuous
integrable function. -/
theorem integral_normalizedSphericalAverage_eq_integral
    {d : ℕ} (hd : 0 < d) (f : Euclidean d → ℂ)
    (hfcont : Continuous f) (hf : Integrable f volume) (r : ℝ) :
