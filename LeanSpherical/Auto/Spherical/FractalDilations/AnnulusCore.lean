  have havg :
      (∫ x : Euclidean d, sphericalAverage d f r x) =
        (surfaceMass d : ℂ) * ∫ x : Euclidean d, f x := by
    calc
      (∫ x : Euclidean d, sphericalAverage d f r x) =
          ∫ x : Euclidean d, ∫ ω : sphere (0 : Euclidean d) 1,
