/-! ## The plane and the plane squared -/

/-- The plane `ℝ²`. -/
abbrev Pl := Euclidean 2

/-- The product `ℝ² × ℝ²`, carrying the Euclidean structure of `ℝ⁴`. -/
abbrev Pl2 := WithLp 2 (Pl × Pl)

/-- Pair two planar vectors into a vector of `ℝ⁴`. -/
def pr (y z : Pl) : Pl2 := WithLp.toLp 2 (y, z)

@[simp] theorem pr_ofLp (y z : Pl) : WithLp.ofLp (pr y z) = (y, z) := rfl

theorem inner_pr (y z y' z' : Pl) :
    inner ℝ (pr y z) (pr y' z') = inner ℝ y y' + inner ℝ z z' := rfl

/-! ## Planar coordinates -/

theorem inner_two (x y : Pl) : inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
  rw [PiLp.inner_apply, Fin.sum_univ_two]
  simp [RCLike.inner_apply, mul_comm]

theorem norm_sq_two (x : Pl) : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

/-- The determinant of two planar vectors. -/
def det2 (x y : Pl) : ℝ := x 0 * y 1 - x 1 * y 0

/-- Lagrange's identity in the plane. -/
theorem lagrange (x y : Pl) :
    det2 x y ^ 2 = ‖x‖ ^ 2 * ‖y‖ ^ 2 - inner ℝ x y ^ 2 := by
  rw [det2, norm_sq_two, norm_sq_two, inner_two]
  ring

/-- The determinant is bounded by the product of the norms and the unoriented angle. -/
theorem abs_det2_le (x y : Pl) :
    |det2 x y| ≤ ‖x‖ * ‖y‖ * InnerProductGeometry.angle x y := by
  set θ := InnerProductGeometry.angle x y with hθ
  have hθ0 : 0 ≤ θ := InnerProductGeometry.angle_nonneg x y
  have hcos : Real.cos θ * (‖x‖ * ‖y‖) = inner ℝ x y :=
    InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
  have hsin : det2 x y ^ 2 = (‖x‖ * ‖y‖) ^ 2 * Real.sin θ ^ 2 := by
    rw [lagrange, ← hcos]
    have := Real.sin_sq_add_cos_sq θ
    nlinarith [this]
  have hsinle : Real.sin θ ≤ θ := by
    rcases eq_or_lt_of_le hθ0 with h | h
    · rw [← h]
      simp
    · exact (Real.sin_lt h).le
  have hsinnn : 0 ≤ Real.sin θ := Real.sin_nonneg_of_nonneg_of_le_pi hθ0
    (InnerProductGeometry.angle_le_pi x y)
  have hnn : (0 : ℝ) ≤ ‖x‖ * ‖y‖ := by positivity
  have hsq : |det2 x y| ^ 2 ≤ (‖x‖ * ‖y‖ * θ) ^ 2 := by
    rw [sq_abs, hsin]
    have : Real.sin θ ^ 2 ≤ θ ^ 2 := by nlinarith
    nlinarith [sq_nonneg (‖x‖ * ‖y‖)]
  have hrhs : 0 ≤ ‖x‖ * ‖y‖ * θ := by positivity
  nlinarith [abs_nonneg (det2 x y), hsq, hrhs]

/-! ## Volume of a planar slab -/

/-- The measurable identification of the plane with `ℝ × ℝ` given by its coordinates. -/
def coords : Pl ≃ᵐ ℝ × ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

@[simp] theorem coords_apply (x : Pl) : coords x = (x 0, x 1) := rfl

theorem measurePreserving_coords :
    MeasurePreserving coords (volume : Measure Pl) (volume : Measure (ℝ × ℝ)) :=
  (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
    (volume_preserving_finTwoArrow ℝ)

theorem volume_planar_eq (s : Set (ℝ × ℝ)) :
    volume {x : Pl | (x 0, x 1) ∈ s} = (volume : Measure (ℝ × ℝ)) s := by
  have h : {x : Pl | (x 0, x 1) ∈ s} = coords ⁻¹' s := rfl
  rw [h]
  exact measurePreserving_coords.measure_preimage_emb coords.measurableEmbedding s

/-- The measure of the planar slab `|x₀ - s x₁| ≤ K`, `|x₁| ≤ L`. -/
theorem volume_slab_le (s K L : ℝ) (hK : 0 ≤ K) (hL : 0 ≤ L) :
    volume {x : Pl | |x 0 - s * x 1| ≤ K ∧ |x 1| ≤ L} ≤ ENNReal.ofReal (4 * K * L) := by
  classical
  set T : Set (ℝ × ℝ) := {p : ℝ × ℝ | |p.1 - s * p.2| ≤ K ∧ |p.2| ≤ L} with hT
  have hcL : IsClosed {y : ℝ | |y| ≤ L} := isClosed_le continuous_abs continuous_const
  have hmeasT : MeasurableSet T := by
    have h1 : IsClosed {p : ℝ × ℝ | |p.1 - s * p.2| ≤ K} :=
      isClosed_le ((continuous_fst.sub (continuous_const.mul continuous_snd)).abs)
        continuous_const
    have h2 : IsClosed {p : ℝ × ℝ | |p.2| ≤ L} :=
      isClosed_le continuous_snd.abs continuous_const
    exact (h1.inter h2).measurableSet
  have hset : {x : Pl | |x 0 - s * x 1| ≤ K ∧ |x 1| ≤ L} = {x : Pl | (x 0, x 1) ∈ T} := rfl
  rw [hset, volume_planar_eq, Measure.volume_eq_prod, Measure.prod_apply_symm hmeasT]
  have hslice : ∀ y : ℝ, (volume : Measure ℝ) ((fun x : ℝ => (x, y)) ⁻¹' T)
      ≤ Set.indicator {y : ℝ | |y| ≤ L} (fun _ => ENNReal.ofReal (2 * K)) y := by
    intro y
    by_cases hy : |y| ≤ L
    · rw [Set.indicator_of_mem (show y ∈ {y : ℝ | |y| ≤ L} from hy)]
      have hsub : (fun x : ℝ => (x, y)) ⁻¹' T ⊆ Icc (s * y - K) (s * y + K) := by
        intro x hx
        have hx1 : |x - s * y| ≤ K := hx.1
        rw [abs_le] at hx1
        exact ⟨by linarith [hx1.1], by linarith [hx1.2]⟩
      refine le_trans (measure_mono hsub) ?_
      rw [Real.volume_Icc]
      apply le_of_eq
      congr 1
      ring
    · have : (fun x : ℝ => (x, y)) ⁻¹' T = ∅ := by
        ext x
        simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false, hT, Set.mem_setOf_eq]
        exact fun h => hy h.2
      rw [this]
      simp
  refine le_trans (lintegral_mono hslice) ?_
  rw [lintegral_indicator hcL.measurableSet, setLIntegral_const]
  have hvol : (volume : Measure ℝ) {y : ℝ | |y| ≤ L} ≤ ENNReal.ofReal (2 * L) := by
    have hsub : {y : ℝ | |y| ≤ L} ⊆ Icc (-L) L := by
      intro y hy
      simp only [Set.mem_setOf_eq, abs_le] at hy
      exact ⟨hy.1, hy.2⟩
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
    apply le_of_eq
    congr 1
    ring
  calc ENNReal.ofReal (2 * K) * (volume : Measure ℝ) {y : ℝ | |y| ≤ L}
      ≤ ENNReal.ofReal (2 * K) * ENNReal.ofReal (2 * L) := mul_le_mul' (le_refl _) hvol
    _ = ENNReal.ofReal (4 * K * L) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 1
        ring

/-! ## §4.1  The sector `Θ_j` and adapted symbols -/

/-- The convex annular sector `Θ_j = {ω : 0 < ω₁ < 2^{-10} ω₂, 2^{j-1} ≤ |ω| ≤ 2^{j+1}}`
of §4.  The paper's coordinates `(ω₁, ω₂)` are the coordinates `ω 0`, `ω 1`. -/
def Theta (j : ℕ) : Set Pl :=
  {ω | 0 < ω 0 ∧ ω 0 < (2 : ℝ) ^ (-(10 : ℤ)) * ω 1 ∧
    (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ω‖ ∧ ‖ω‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1)}

theorem Theta.snd_pos {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : 0 < ω 1 := by
  obtain ⟨h0, h1, -, -⟩ := h
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
  nlinarith

theorem Theta.snd_le_norm {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : ω 1 ≤ ‖ω‖ := by
  have hpos : 0 < ω 1 := Theta.snd_pos h
  have hsq : ω 1 ^ 2 ≤ ‖ω‖ ^ 2 := by
    rw [norm_sq_two]
    nlinarith [sq_nonneg (ω 0)]
  nlinarith [norm_nonneg ω, hpos]

theorem Theta.norm_le_two_mul_snd {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : ‖ω‖ ≤ 2 * ω 1 := by
  obtain ⟨h0, h1, -, -⟩ := h
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
  have hpos : 0 < ω 1 := by nlinarith
  have hcle : (2 : ℝ) ^ (-(10 : ℤ)) ≤ 1 := by
    rw [zpow_neg]
    norm_num
  have hlt : ω 0 < ω 1 := by nlinarith
  have hsq : ‖ω‖ ^ 2 ≤ (2 * ω 1) ^ 2 := by
    rw [norm_sq_two]
    nlinarith
  nlinarith [norm_nonneg ω, hpos]

theorem Theta.snd_lower {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) :
    (2 : ℝ) ^ ((j : ℤ) - 2) ≤ ω 1 := by
  have h1 := h.2.2.1
  have h2 := Theta.norm_le_two_mul_snd h
  have hstep : (2 : ℝ) ^ ((j : ℤ) - 1) = 2 * (2 : ℝ) ^ ((j : ℤ) - 2) := by
    rw [show (j : ℤ) - 1 = 1 + ((j : ℤ) - 2) by ring, zpow_add₀ (two_ne_zero), zpow_one]
  rw [hstep] at h1
  linarith

theorem Theta.norm_le {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) :
    ‖ω‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := h.2.2.2

/-- `Θ_j` is measurable. -/
theorem measurableSet_Theta (j : ℕ) : MeasurableSet (Theta j) := by
  have hc0 : Continuous fun ω : Pl => ω 0 := by
    exact (EuclideanSpace.proj (0 : Fin 2)).continuous
  have hc1 : Continuous fun ω : Pl => ω 1 := by
    exact (EuclideanSpace.proj (1 : Fin 2)).continuous
  have hcn : Continuous fun ω : Pl => ‖ω‖ := continuous_norm
  have h1 : MeasurableSet {ω : Pl | 0 < ω 0} :=
    measurableSet_lt measurable_const hc0.measurable
  have h2 : MeasurableSet {ω : Pl | ω 0 < (2 : ℝ) ^ (-(10 : ℤ)) * ω 1} :=
    measurableSet_lt hc0.measurable (measurable_const.mul hc1.measurable)
  have h3 : MeasurableSet {ω : Pl | (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ω‖} :=
    measurableSet_le measurable_const hcn.measurable
  have h4 : MeasurableSet {ω : Pl | ‖ω‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1)} :=
    measurableSet_le hcn.measurable measurable_const
  exact h1.inter (h2.inter (h3.inter h4))

/-- The `η`-support constraint of a `(j,m)`-adapted symbol at frequency `ξ`. -/
def SuppSet (j m : ℕ) (ξ : Pl) : Set Pl :=
  {η | η ∈ Theta j ∧ ξ - η ∈ Theta j ∧
    InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ))}

theorem measurable_angle_right (ξ : Pl) :
    Measurable fun η : Pl => InnerProductGeometry.angle ξ η := by
  have hnum : Measurable fun η : Pl => (inner ℝ ξ η : ℝ) :=
    (continuous_const.inner continuous_id).measurable
  have hden : Measurable fun η : Pl => ‖ξ‖ * ‖η‖ :=
    (continuous_const.mul continuous_norm).measurable
  exact Real.continuous_arccos.measurable.comp (hnum.div hden)

theorem measurableSet_SuppSet (j m : ℕ) (ξ : Pl) : MeasurableSet (SuppSet j m ξ) := by
  have h1 : MeasurableSet {η : Pl | η ∈ Theta j} := measurableSet_Theta j
  have h2 : MeasurableSet {η : Pl | ξ - η ∈ Theta j} := by
    have : Measurable fun η : Pl => ξ - η := (continuous_const.sub continuous_id).measurable
    exact this (measurableSet_Theta j)
  have h3 : MeasurableSet {η : Pl | InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ))} :=
    measurableSet_le (measurable_angle_right ξ) measurable_const
  exact h1.inter (h2.inter h3)

/-- The slab used to bound the support is closed. -/
theorem isClosed_slab (c K L : ℝ) :
    IsClosed {η : Pl | |η 0 - c * η 1| ≤ K ∧ |η 1| ≤ L} := by
  have h0 : Continuous fun η : Pl => η 0 := (EuclideanSpace.proj (0 : Fin 2)).continuous
  have h1 : Continuous fun η : Pl => η 1 := (EuclideanSpace.proj (1 : Fin 2)).continuous
  have hA : IsClosed {η : Pl | |η 0 - c * η 1| ≤ K} :=
    isClosed_le ((h0.sub (continuous_const.mul h1)).abs) continuous_const
  have hB : IsClosed {η : Pl | |η 1| ≤ L} := isClosed_le h1.abs continuous_const
  exact hA.inter hB

/-- The closure of the `η`-support of a `(j,m)`-adapted symbol has measure at most
`2^{2j - m + 12}`.  This is the source of the factor `2^{j - m/2}` in Proposition 4.1. -/
theorem volume_closure_SuppSet_le (j m : ℕ) (ξ : Pl) :
    volume (closure (SuppSet j m ξ))
      ≤ ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) := by
  rcases Set.eq_empty_or_nonempty (SuppSet j m ξ) with hempty | ⟨η₀, hη₀⟩
  · rw [hempty, closure_empty]
    simp
  obtain ⟨hη₀T, hξη₀T, -⟩ := hη₀
  -- the second coordinate of `ξ` is at least `2 ^ (j - 1)`
  have hsub : (ξ - η₀) 1 = ξ 1 - η₀ 1 := by
    simp [PiLp.sub_apply]
  have hξ1 : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ξ 1 := by
    have h1 := Theta.snd_lower hη₀T
    have h2 := Theta.snd_lower hξη₀T
    rw [hsub] at h2
    have hstep : (2 : ℝ) ^ ((j : ℤ) - 1) = 2 * (2 : ℝ) ^ ((j : ℤ) - 2) := by
      rw [show (j : ℤ) - 1 = 1 + ((j : ℤ) - 2) by ring, zpow_add₀ (two_ne_zero), zpow_one]
    rw [hstep]
    linarith
  have hξ1pos : 0 < ξ 1 := lt_of_lt_of_le (by positivity) hξ1
  -- the norm of `ξ` is at most `2 ^ (j + 2)`
  have hξnorm : ‖ξ‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := by
    have he : (ξ - η₀) + η₀ = ξ := by abel
    have h1 : ‖ξ‖ ≤ ‖ξ - η₀‖ + ‖η₀‖ := by
      have h := norm_add_le (ξ - η₀) η₀
      rw [he] at h
      exact h
    have h2 := Theta.norm_le hξη₀T
    have h3 := Theta.norm_le hη₀T
    have hstep : (2 : ℝ) ^ ((j : ℤ) + 2) = 2 * (2 : ℝ) ^ ((j : ℤ) + 1) := by
      rw [show (j : ℤ) + 2 = 1 + ((j : ℤ) + 1) by ring, zpow_add₀ (two_ne_zero), zpow_one]
    rw [hstep]
    linarith
  -- the support is contained in a slab
  set K : ℝ := (2 : ℝ) ^ ((j : ℤ) + 9 - (m : ℤ)) with hK
  set L : ℝ := (2 : ℝ) ^ ((j : ℤ) + 1) with hL
  have hKpos : 0 < K := by rw [hK]; positivity
  have hLpos : 0 < L := by rw [hL]; positivity
  have hincl : SuppSet j m ξ ⊆ {η : Pl | |η 0 - (ξ 0 / ξ 1) * η 1| ≤ K ∧ |η 1| ≤ L} := by
    intro η hη
    obtain ⟨hηT, hξηT, hang⟩ := hη
    have hη1pos : 0 < η 1 := Theta.snd_pos hηT
    have hηnorm : ‖η‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := Theta.norm_le hηT
    refine ⟨?_, ?_⟩
    · -- the determinant bound
      have hdet : |det2 ξ η| ≤ ‖ξ‖ * ‖η‖ * InnerProductGeometry.angle ξ η := abs_det2_le ξ η
      have hangnn : 0 ≤ InnerProductGeometry.angle ξ η :=
        InnerProductGeometry.angle_nonneg ξ η
      have hdet2 : |det2 ξ η| ≤ (2 : ℝ) ^ (2 * (j : ℤ) + 8 - (m : ℤ)) := by
        have hstep : ‖ξ‖ * ‖η‖ * InnerProductGeometry.angle ξ η
            ≤ (2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1) * (2 : ℝ) ^ (5 - (m : ℤ)) := by
          have h1 : (0 : ℝ) ≤ ‖ξ‖ := norm_nonneg _
          have h2 : (0 : ℝ) ≤ ‖η‖ := norm_nonneg _
          have hp1 : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) + 2) := by positivity
          have hp2 : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) + 1) := by positivity
          have hmul : ‖ξ‖ * ‖η‖
              ≤ (2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1) :=
            mul_le_mul hξnorm hηnorm h2 hp1.le
          have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1) := by positivity
          exact mul_le_mul hmul hang hangnn hnn
        refine le_trans (le_trans hdet hstep) (le_of_eq ?_)
        rw [← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0), ← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
        congr 1
        ring
      -- rewrite the slab condition through the determinant
      have hid : η 0 - (ξ 0 / ξ 1) * η 1 = -(det2 ξ η) / ξ 1 := by
        rw [det2]
        field_simp
        ring
      rw [hid, abs_div, abs_neg, abs_of_pos hξ1pos]
      rw [div_le_iff₀ hξ1pos]
      refine le_trans hdet2 ?_
      have hmul : (2 : ℝ) ^ (2 * (j : ℤ) + 8 - (m : ℤ))
          ≤ K * (2 : ℝ) ^ ((j : ℤ) - 1) := by
        rw [hK, ← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
        apply le_of_eq
        congr 1
        ring
      refine le_trans hmul ?_
      exact mul_le_mul_of_nonneg_left hξ1 hKpos.le
    · rw [abs_of_pos hη1pos, hL]
      exact le_trans (Theta.snd_le_norm hηT) hηnorm
  refine le_trans (measure_mono (closure_minimal hincl (isClosed_slab _ _ _))) ?_
  refine le_trans (volume_slab_le (ξ 0 / ξ 1) K L hKpos.le hLpos.le) ?_
  apply le_of_eq
  congr 1
  rw [hK, hL]
  have h4 : (4 : ℝ) = (2 : ℝ) ^ (2 : ℤ) := by norm_num
  rw [h4, ← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0),
    ← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
  congr 1
  ring

/-- The `η`-support of a `(j,m)`-adapted symbol has measure at most `2^{2j - m + 12}`. -/
theorem volume_SuppSet_le (j m : ℕ) (ξ : Pl) :
    volume (SuppSet j m ξ) ≤ ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) :=
  le_trans (measure_mono subset_closure) (volume_closure_SuppSet_le j m ξ)


/-! ## §4.1  The operator `S[F, b]` -/

/-- The unimodular phase `e^{± 2π i t (|ξ - η| + |η|)}` of §4. -/
def phase (ε t : ℝ) (ξ η : Pl) : ℂ :=
  Complex.exp (((2 * Real.pi * ε * t * (‖ξ - η‖ + ‖η‖) : ℝ) : ℂ) * Complex.I)

@[simp] theorem norm_phase (ε t : ℝ) (ξ η : Pl) : ‖phase ε t ξ η‖ = 1 := by
  rw [phase, Complex.norm_exp_ofReal_mul_I]

/-- A `(j,m)`-adapted symbol: it vanishes unless `η, ξ - η ∈ Θ_j` and `∠(ξ,η) ≤ 2^{-m+5}`. -/
structure IsAdapted (j m : ℕ) (b : ℝ → Pl → Pl → ℂ) : Prop where
  meas : ∀ t ξ, Measurable (b t ξ)
  supp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0

/-- The operator `S[F,b]` of §4, written in terms of `G = 𝓕 F`. -/
def SopK (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (G : Pl2 → ℂ) (ξ : Pl) (t : ℝ) : ℂ :=
  ∫ η, phase ε t ξ η * b t ξ η * G (pr (ξ - η) η)

/-! ### The shift change of variables -/

theorem measurable_pr_shift {h : Pl2 → ℝ≥0∞} (hh : Measurable h) :
    Measurable fun p : Pl × Pl => h (pr (p.1 - p.2) p.2) := by
  have h1 : Measurable fun p : Pl × Pl => ((p.1 - p.2 : Pl), p.2) :=
    (measurable_fst.sub measurable_snd).prodMk measurable_snd
  have h2 : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
    have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact hh.comp this
  exact h2.comp h1

theorem lintegral_pr (h : Pl2 → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ u : Pl, ∫⁻ η : Pl, h (pr u η)) = ∫⁻ x : Pl2, h x := by
  have hmeas : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
    have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact hh.comp this
  have hstep : (∫⁻ u : Pl, ∫⁻ η : Pl, h (pr u η))
      = ∫⁻ q : Pl × Pl, h (pr q.1 q.2) ∂(volume.prod volume) :=
    lintegral_lintegral hmeas.aemeasurable
  rw [hstep, ← Measure.volume_eq_prod]
  exact (WithLp.volume_preserving_toLp (U := Pl) (V := Pl)).lintegral_comp hh

theorem lintegral_pr_shift (h : Pl2 → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ ξ : Pl, ∫⁻ η : Pl, h (pr (ξ - η) η)) = ∫⁻ x : Pl2, h x := by
  have hswap : (∫⁻ ξ : Pl, ∫⁻ η : Pl, h (pr (ξ - η) η))
      = ∫⁻ η : Pl, ∫⁻ ξ : Pl, h (pr (ξ - η) η) :=
    lintegral_lintegral_swap (measurable_pr_shift hh).aemeasurable
  have hinner : ∀ η : Pl, (∫⁻ ξ : Pl, h (pr (ξ - η) η)) = ∫⁻ u : Pl, h (pr u η) := by
    intro η
    exact lintegral_sub_right_eq_self (fun u : Pl => h (pr u η)) η
  rw [hswap, lintegral_congr hinner]
  rw [← lintegral_pr h hh]
  refine lintegral_lintegral_swap ?_
  have hmeas : Measurable fun q : Pl × Pl => h (pr q.2 q.1) := by
    have h1 : Measurable fun q : Pl × Pl => ((q.2 : Pl), (q.1 : Pl)) :=
      measurable_snd.prodMk measurable_fst
    have h2 : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
      have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
      exact hh.comp this
    exact h2.comp h1
  exact hmeas.aemeasurable

/-! ### Proposition 4.1: the trivial estimate -/

/-- The pointwise Cauchy--Schwarz bound behind Proposition 4.1. -/
theorem enorm_SopK_sq_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε t : ℝ) {G : Pl2 → ℂ} (hG : Measurable G) (ξ : Pl) :
    ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ η : Pl, ‖G (pr (ξ - η) η)‖ₑ ^ (2 : ℝ) := by
  classical
  set f : Pl → ℂ := fun η => G (pr (ξ - η) η) with hf
  have hfmeas : Measurable f := by
    have h1 : Measurable fun η : Pl => (pr (ξ - η) η : Pl2) := by
      have h2 : Measurable fun η : Pl => ((ξ - η : Pl), (η : Pl)) :=
        (measurable_const.sub measurable_id).prodMk measurable_id
      exact (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp h2
    exact hG.comp h1
  -- step 1: the triangle inequality
  have hstep1 : ‖SopK ε b G ξ t‖ₑ ≤ ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ := by
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun η => ?_
    rw [enorm_mul, enorm_mul, ← ofReal_norm, norm_phase, ENNReal.ofReal_one, one_mul]
  -- step 2: Cauchy--Schwarz
  have hstep2 : (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ) ^ (2 : ℝ)
      ≤ (∫⁻ η, ‖b t ξ η‖ₑ) * ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ) :=
    Auto.CalderonVaillancourt.lintegral_enorm_mul_sq_le (K := fun (_ : Pl) η => b t ξ η)
      (f := f) ξ (hb.meas t ξ).aemeasurable hfmeas.aemeasurable
  -- step 3: the mass of the symbol
  have hmass : (∫⁻ η, ‖b t ξ η‖ₑ) ≤ ENNReal.ofReal B *
      ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) := by
    have hmono : ∀ η : Pl, ‖b t ξ η‖ₑ
        ≤ Set.indicator (SuppSet j m ξ) (fun _ => ENNReal.ofReal B) η := by
      intro η
      by_cases hη : η ∈ SuppSet j m ξ
      · rw [Set.indicator_of_mem hη, ← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hbB t ξ η)
      · rw [Set.indicator_of_notMem hη, hb.supp t ξ η hη]
        simp
    refine le_trans (lintegral_mono hmono) ?_
    rw [lintegral_indicator (measurableSet_SuppSet j m ξ), setLIntegral_const]
    exact mul_le_mul' (le_refl _) (volume_SuppSet_le j m ξ)
  -- step 4: pull the symbol bound out of the weighted square integral
  have hweight : (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal B * ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono fun η => ?_
    refine mul_le_mul' ?_ (le_refl _)
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hbB t ξ η)
  -- assemble
  calc ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ)
      ≤ (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ) ^ (2 : ℝ) :=
        ENNReal.rpow_le_rpow hstep1 (by norm_num)
    _ ≤ (∫⁻ η, ‖b t ξ η‖ₑ) * ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ) := hstep2
    _ ≤ (ENNReal.ofReal B * ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))) *
          (ENNReal.ofReal B * ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ)) := mul_le_mul' hmass hweight
    _ = ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ) := by
        rw [← ENNReal.ofReal_mul hB, ← mul_assoc,
          ← ENNReal.ofReal_mul
            (mul_nonneg hB (by positivity :
              (0:ℝ) ≤ (2:ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)))]
        congr 2
        ring

/-- **Proposition 4.1** (the trivial estimate), in the form `‖S[F,b]‖²_{L²(ℝ² × ℰ)} ≤
c B² 2^{2j-m} (#ℰ) ‖𝓕F‖²_{L²}`. -/
theorem prop41_K {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε : ℝ) (Efin : Finset ℝ) {G : Pl2 → ℂ} (hG : Measurable G) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ (Efin.card : ℝ≥0∞) *
        ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
  classical
  have hsq : Measurable fun x : Pl2 => ‖G x‖ₑ ^ (2 : ℝ) := (hG.enorm).pow_const _
  have hterm : ∀ t : ℝ, (∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
    intro t
    refine le_trans (lintegral_mono fun ξ => enorm_SopK_sq_le hB hb hbB ε t hG ξ) ?_
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine mul_le_mul' (le_refl _) ?_
    exact le_of_eq (lintegral_pr_shift (fun x => ‖G x‖ₑ ^ (2 : ℝ)) hsq)
  calc (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ∑ _t ∈ Efin, ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := Finset.sum_le_sum fun t _ => hterm t
    _ = (Efin.card : ℝ≥0∞) *
          ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_assoc]


/-! ### Plancherel on `ℝ⁴` -/

theorem eLpNorm_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    eLpNorm (𝓕 (F : Pl2 → ℂ)) 2 (volume : Measure Pl2)
      = eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) := by
  have hnorm : ‖SchwartzMap.toLp (𝓕 F) 2 (volume : Measure Pl2)‖
      = ‖SchwartzMap.toLp F 2 (volume : Measure Pl2)‖ := by
    rw [← SchwartzMap.toLp_fourier_eq F]
    exact MeasureTheory.Lp.norm_fourier_eq _
  rw [SchwartzMap.norm_toLp, SchwartzMap.norm_toLp] at hnorm
  have h1 : eLpNorm ((𝓕 F : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) 2 (volume : Measure Pl2) ≠ ⊤ :=
    ((𝓕 F : SchwartzMap Pl2 ℂ).memLp 2 (volume : Measure Pl2)).2.ne
  have h2 : eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) ≠ ⊤ :=
    (F.memLp 2 (volume : Measure Pl2)).2.ne
  have heq : eLpNorm ((𝓕 F : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) 2 (volume : Measure Pl2)
      = eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) :=
    (ENNReal.toReal_eq_toReal_iff' h1 h2).mp hnorm
  rw [← SchwartzMap.fourier_coe F]
  exact heq

theorem lintegral_enorm_sq_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ x : Pl2, ‖𝓕 (F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have h1 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl2) (𝓕 (F : Pl2 → ℂ))
  have h2 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl2) ((F : Pl2 → ℂ))
  rw [Auto.CalderonVaillancourt.sqMass] at h1 h2
  rw [h1, h2, eLpNorm_fourier_schwartz]

theorem measurable_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    Measurable (𝓕 (F : Pl2 → ℂ)) := by
  rw [← SchwartzMap.fourier_coe F]
  exact (𝓕 F : SchwartzMap Pl2 ℂ).continuous.measurable

/-! ### Proposition 4.1 in the paper's form -/

/-- The operator `S[F,b]` of §4:
`S[F,b](ξ,t) = ∫ e^{± 2π i t(|ξ-η| + |η|)} b(t,ξ,η) 𝓕F(ξ-η, η) dη`. -/
def Sop (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (F : Pl2 → ℂ) : Pl → ℝ → ℂ :=
  SopK ε b (𝓕 F)

/-- **Proposition 4.1** of Roos--Seeger (the trivial estimate).  If `b` is `(j,m)`-adapted with
`‖b‖_∞ ≤ B`, then for every finite set `ℰ` of radii,
`‖S[F,b]‖²_{L²(ℝ² × ℰ)} ≤ 2^{12} B² 2^{2j-m} (#ℰ) ‖F‖²_{L²(ℝ⁴)}`,
which is the squared form of the paper's `c B 2^{j-m/2} (#ℰ)^{1/2} ‖F‖_{L²(ℝ⁴)}`. -/
theorem prop41 {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε : ℝ) (Efin : Finset ℝ) (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ (Efin.card : ℝ≥0∞) *
        ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have h := prop41_K hB hb hbB ε Efin (measurable_fourier_schwartz F)
  rw [lintegral_enorm_sq_fourier_schwartz F] at h
  exact h


/-! ## A one-dimensional non-stationary phase estimate

The engine of §4.3.  If the phase derivative `τ'` never vanishes and the amplitude `A` vanishes at
the two endpoints, then two integrations by parts gain a factor `λ^{-2}`.
-/

section NonStationary

/-- The oscillatory factor `e^{i λ τ}`. -/
def osc (lam τ : ℝ) : ℂ := Complex.exp (((lam * τ : ℝ) : ℂ) * Complex.I)

@[simp] theorem norm_osc (lam τ : ℝ) : ‖osc lam τ‖ = 1 := by
  rw [osc, Complex.norm_exp_ofReal_mul_I]

theorem hasDerivAt_osc {lam : ℝ} {τ : ℝ → ℝ} {c x : ℝ} (h : HasDerivAt τ c x) :
    HasDerivAt (fun y => osc lam (τ y)) (osc lam (τ x) * ((((lam * c : ℝ)) : ℂ) * Complex.I)) x := by
  have h1 : HasDerivAt (fun y => (((lam * τ y : ℝ)) : ℂ) * Complex.I)
      ((((lam * c : ℝ)) : ℂ) * Complex.I) x := by
    have h2 : HasDerivAt (fun y => ((lam * τ y : ℝ) : ℂ)) (((lam * c : ℝ) : ℂ)) x := by
      have h3 : HasDerivAt (fun y => lam * τ y) (lam * c) x := h.const_mul lam
      exact h3.ofReal_comp
    exact h2.mul_const Complex.I
  exact h1.cexp

theorem continuous_osc_comp {lam : ℝ} {τ : ℝ → ℝ} (hτ : Continuous τ) :
    Continuous fun y => osc lam (τ y) := by
  refine Complex.continuous_exp.comp ?_
  exact (Complex.continuous_ofReal.comp (continuous_const.mul hτ)).mul continuous_const

/-- One integration by parts against a nonvanishing phase derivative. -/
theorem integral_osc_ibp {a b lam : ℝ} (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ') (hτ'ne : ∀ x, τ' x ≠ 0)
    (hAc : Continuous A) (hBc : Continuous Bn)
    (hAB : ∀ x, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hAa : A a = 0) (hAb : A b = 0) :
    (∫ x in a..b, osc lam (τ x) * A x)
      = -(1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, osc lam (τ x) * Bn x := by
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  have hτc : Continuous τ := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ x).continuousAt
  set u : ℝ → ℂ := fun y => (A y / ((τ' y : ℝ) : ℂ)) / (((lam : ℝ) : ℂ) * Complex.I) with hu
  set v : ℝ → ℂ := fun y => osc lam (τ y) with hv
  have hud : ∀ x, HasDerivAt u (Bn x / (((lam : ℝ) : ℂ) * Complex.I)) x := fun x =>
    (hAB x).div_const _
  have hvd : ∀ x, HasDerivAt v (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I)) x := fun x =>
    hasDerivAt_osc (hτ x)
  -- the derivative of `u * v`
  have hkey : ∀ x, HasDerivAt (fun y => u y * v y)
      (v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) x := by
    intro x
    have h := (hud x).mul (hvd x)
    have hlamC' : ((lam : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hlam
    have heq : Bn x / (((lam : ℝ) : ℂ) * Complex.I) * v x +
        u x * (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I))
        = v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      have hτ'C : ((τ' x : ℝ) : ℂ) ≠ 0 := by
        exact_mod_cast hτ'ne x
      rw [hu]
      push_cast
      field_simp
      ring
    rw [heq] at h
    exact h
  -- the boundary terms vanish
  have hbdry : u b * v b - u a * v a = 0 := by
    simp [hu, hAa, hAb]
  have hintg : IntervalIntegrable
      (fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    refine Continuous.intervalIntegrable ?_ a b
    exact (continuous_osc_comp hτc).mul (hAc.add (hBc.div_const _))
  have hzero : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) = 0 := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hkey x) hintg, hbdry]
  have hsplit : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      = (∫ x in a..b, v x * A x) +
        (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x := by
    have h1 : IntervalIntegrable (fun x => v x * A x) volume a b :=
      ((continuous_osc_comp hτc).mul hAc).intervalIntegrable a b
    have h2 : IntervalIntegrable (fun x => v x * Bn x) volume a b :=
      ((continuous_osc_comp hτc).mul hBc).intervalIntegrable a b
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_add h1 (h2.const_mul _)]
    refine intervalIntegral.integral_congr fun x _ => ?_
    field_simp
  rw [hsplit] at hzero
  have hres : (∫ x in a..b, v x * A x)
      = -((1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x) := by
    linear_combination hzero
  rw [hres]
  ring

/-- Two integrations by parts gain `λ^{-2}`. -/
theorem norm_integral_osc_ibp_twice {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn Cn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ') (hτ'ne : ∀ x, τ' x ≠ 0)
    (hAc : Continuous A) (hBc : Continuous Bn) (hCc : Continuous Cn)
    (hAB : ∀ x, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hBC : ∀ x, HasDerivAt (fun y => Bn y / ((τ' y : ℝ) : ℂ)) (Cn x) x)
    (hAa : A a = 0) (hAb : A b = 0) (hBa : Bn a = 0) (hBb : Bn b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖ ≤ (lam ^ 2)⁻¹ * ∫ x in a..b, ‖Cn x‖ := by
  have h1 := integral_osc_ibp hlam hτ hτ'c hτ'ne hAc hBc hAB hAa hAb
  have h2 := integral_osc_ibp hlam hτ hτ'c hτ'ne hBc hCc hBC hBa hBb
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hstep : ‖∫ x in a..b, osc lam (τ x) * A x‖
      = |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * Cn x‖) := by
    rw [h1, norm_mul, norm_neg, hnormlam, h2, norm_mul, norm_neg, hnormlam]
  rw [hstep]
  have hbound : ‖∫ x in a..b, osc lam (τ x) * Cn x‖ ≤ ∫ x in a..b, ‖Cn x‖ := by
    have hcont : Continuous fun x => osc lam (τ x) * Cn x := by
      have hτc : Continuous τ := continuous_iff_continuousAt.mpr fun x => (hτ x).continuousAt
      exact (continuous_osc_comp hτc).mul hCc
    have h := intervalIntegral.norm_integral_le_abs_integral_norm
      (f := fun x => osc lam (τ x) * Cn x) (a := a) (b := b) (μ := volume)
    refine le_trans h (le_of_eq ?_)
    rw [abs_of_nonneg]
    · refine intervalIntegral.integral_congr fun x _ => ?_
      rw [norm_mul, norm_osc, one_mul]
    · refine intervalIntegral.integral_nonneg hab fun x _ => ?_
      exact norm_nonneg _
  have hlamnn : (0 : ℝ) ≤ |lam|⁻¹ := by positivity
  have hsq : (lam ^ 2)⁻¹ = |lam|⁻¹ * |lam|⁻¹ := by
    have h : |lam| * |lam| = lam ^ 2 := by
      rw [← abs_mul, ← pow_two, abs_of_nonneg (sq_nonneg lam)]
    rw [← mul_inv, h]
  rw [hsq, mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ hlamnn
  exact mul_le_mul_of_nonneg_left hbound hlamnn

end NonStationary

/-! ### Three integrations by parts, and the linear-phase case -/

section IbpThrice

/-- Three integrations by parts against a nonvanishing phase derivative. -/
theorem norm_integral_osc_ibp_thrice {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn Cn Dn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ') (hτ'ne : ∀ x, τ' x ≠ 0)
    (hAc : Continuous A) (hBc : Continuous Bn) (hCc : Continuous Cn) (hDc : Continuous Dn)
    (hAB : ∀ x, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hBC : ∀ x, HasDerivAt (fun y => Bn y / ((τ' y : ℝ) : ℂ)) (Cn x) x)
    (hCD : ∀ x, HasDerivAt (fun y => Cn y / ((τ' y : ℝ) : ℂ)) (Dn x) x)
    (hAa : A a = 0) (hAb : A b = 0) (hBa : Bn a = 0) (hBb : Bn b = 0)
    (hCa : Cn a = 0) (hCb : Cn b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖ ≤ (|lam| ^ 3)⁻¹ * ∫ x in a..b, ‖Dn x‖ := by
  have h1 := integral_osc_ibp hlam hτ hτ'c hτ'ne hAc hBc hAB hAa hAb
  have h2 := norm_integral_osc_ibp_twice hab hlam hτ hτ'c hτ'ne hBc hCc hDc hBC hCD
    hBa hBb hCa hCb
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hstep : ‖∫ x in a..b, osc lam (τ x) * A x‖
      = |lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * Bn x‖ := by
    rw [h1, norm_mul, norm_neg, hnormlam]
  rw [hstep]
  have hcube : (|lam| ^ 3)⁻¹ = |lam|⁻¹ * (lam ^ 2)⁻¹ := by
    have h : |lam| ^ 3 = |lam| * lam ^ 2 := by
      rw [pow_succ' , sq_abs]
    rw [h, mul_inv]
  rw [hcube, mul_assoc]
  exact mul_le_mul_of_nonneg_left h2 (by positivity)

/-- Three integrations by parts against a *linear* phase `x ↦ x * psi`.  The chain of
integration-by-parts amplitudes is then simply division by powers of `psi`. -/
theorem norm_integral_osc_linear_ibp3 {a b lam psi : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    (hpsi : psi ≠ 0) {A A1 A2 A3 : ℝ → ℂ}
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2 : ∀ x, HasDerivAt A2 (A3 x) x) (hA3c : Continuous A3)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0)
    (h2a : A2 a = 0) (h2b : A2 b = 0) :
    ‖∫ x in a..b, osc lam (x * psi) * A x‖
      ≤ (|lam| ^ 3 * |psi| ^ 3)⁻¹ * ∫ x in a..b, ‖A3 x‖ := by
  have hpsiC : ((psi : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hpsi
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hA2c : Continuous A2 := continuous_iff_continuousAt.mpr fun x => (hA2 x).continuousAt
  have hτ : ∀ x : ℝ, HasDerivAt (fun y : ℝ => y * psi) psi x := by
    intro x
    simpa using (hasDerivAt_id x).mul_const psi
  set Bn : ℝ → ℂ := fun x => A1 x / ((psi : ℝ) : ℂ) with hBn
  set Cn : ℝ → ℂ := fun x => A2 x / ((psi : ℝ) : ℂ) ^ 2 with hCn
  set Dn : ℝ → ℂ := fun x => A3 x / ((psi : ℝ) : ℂ) ^ 3 with hDn
  have hAB : ∀ x : ℝ, HasDerivAt (fun y => A y / ((psi : ℝ) : ℂ)) (Bn x) x := fun x =>
    (hA x).div_const _
  have hBC : ∀ x : ℝ, HasDerivAt (fun y => Bn y / ((psi : ℝ) : ℂ)) (Cn x) x := by
    intro x
    have h := ((hA1 x).div_const ((psi : ℝ) : ℂ)).div_const ((psi : ℝ) : ℂ)
    refine h.congr_deriv ?_
    rw [hCn]
    field_simp
  have hCD : ∀ x : ℝ, HasDerivAt (fun y => Cn y / ((psi : ℝ) : ℂ)) (Dn x) x := by
    intro x
    have h := ((hA2 x).div_const (((psi : ℝ) : ℂ) ^ 2)).div_const ((psi : ℝ) : ℂ)
    refine h.congr_deriv ?_
    rw [hDn]
    field_simp
  have hBcont : Continuous Bn := hA1c.div_const _
  have hCcont : Continuous Cn := hA2c.div_const _
  have hDcont : Continuous Dn := hA3c.div_const _
  have h := norm_integral_osc_ibp_thrice (τ := fun y : ℝ => y * psi) (τ' := fun _ => psi)
    hab hlam hτ continuous_const (fun _ => hpsi) hAc hBcont hCcont hDcont hAB hBC hCD
    (by rw [hAa]) (by rw [hAb]) (by rw [hBn]; simp [h1a]) (by rw [hBn]; simp [h1b])
    (by rw [hCn]; simp [h2a]) (by rw [hCn]; simp [h2b])
  refine le_trans h (le_of_eq ?_)
  have hnorm : ∀ x : ℝ, ‖Dn x‖ = ‖A3 x‖ * (|psi| ^ 3)⁻¹ := by
    intro x
    rw [hDn, norm_div, norm_pow, Complex.norm_real, Real.norm_eq_abs, div_eq_mul_inv]
  rw [intervalIntegral.integral_congr (fun x _ => hnorm x)]
  rw [intervalIntegral.integral_mul_const]
  rw [mul_inv]
  ring

/-- Four integrations by parts against a linear phase. -/
theorem norm_integral_osc_linear_ibp4 {a b lam psi : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    (hpsi : psi ≠ 0) {A A1 A2 A3 A4 : ℝ → ℂ}
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2 : ∀ x, HasDerivAt A2 (A3 x) x) (hA3 : ∀ x, HasDerivAt A3 (A4 x) x)
    (hA4c : Continuous A4)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0)
    (h2a : A2 a = 0) (h2b : A2 b = 0) (h3a : A3 a = 0) (h3b : A3 b = 0) :
    ‖∫ x in a..b, osc lam (x * psi) * A x‖
      ≤ (|lam| ^ 4 * |psi| ^ 4)⁻¹ * ∫ x in a..b, ‖A4 x‖ := by
  have hpsiC : ((psi : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hpsi
  have hpsipos : (0 : ℝ) < |psi| := abs_pos.mpr hpsi
  have hlampos : (0 : ℝ) < |lam| := abs_pos.mpr hlam
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hA2c : Continuous A2 := continuous_iff_continuousAt.mpr fun x => (hA2 x).continuousAt
  have hA3c : Continuous A3 := continuous_iff_continuousAt.mpr fun x => (hA3 x).continuousAt
  have hτ : ∀ x : ℝ, HasDerivAt (fun y : ℝ => y * psi) psi x := by
    intro x
    simpa using (hasDerivAt_id x).mul_const psi
  -- one step
  have hAB : ∀ x : ℝ, HasDerivAt (fun y => A y / ((psi : ℝ) : ℂ)) (A1 x / ((psi : ℝ) : ℂ)) x :=
    fun x => (hA x).div_const _
  have h1 := integral_osc_ibp (τ := fun y : ℝ => y * psi) (τ' := fun _ => psi) hlam hτ
    continuous_const (fun _ => hpsi) hAc (hA1c.div_const _) hAB (by rw [hAa])
    (by rw [hAb])
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hstep : ‖∫ x in a..b, osc lam (x * psi) * A x‖
      = |lam|⁻¹ * ‖∫ x in a..b, osc lam (x * psi) * (A1 x / ((psi : ℝ) : ℂ))‖ := by
    rw [h1, norm_mul, norm_neg, hnormlam]
  -- three more steps on the amplitude `A1/psi`
  have h3 := norm_integral_osc_linear_ibp3 (a := a) (b := b) (lam := lam) (psi := psi)
    (A := fun x => A1 x / ((psi : ℝ) : ℂ)) (A1 := fun x => A2 x / ((psi : ℝ) : ℂ))
    (A2 := fun x => A3 x / ((psi : ℝ) : ℂ)) (A3 := fun x => A4 x / ((psi : ℝ) : ℂ))
    hab hlam hpsi (fun x => (hA1 x).div_const _) (fun x => (hA2 x).div_const _)
    (fun x => (hA3 x).div_const _) (hA4c.div_const _)
    (by rw [h1a]; simp) (by rw [h1b]; simp) (by rw [h2a]; simp) (by rw [h2b]; simp)
    (by rw [h3a]; simp) (by rw [h3b]; simp)
  have hnorm4 : ∀ x : ℝ, ‖A4 x / ((psi : ℝ) : ℂ)‖ = ‖A4 x‖ * |psi|⁻¹ := by
    intro x
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, div_eq_mul_inv]
  rw [intervalIntegral.integral_congr (fun x _ => hnorm4 x),
    intervalIntegral.integral_mul_const] at h3
  rw [hstep]
  have hchain : |lam|⁻¹ * ‖∫ x in a..b, osc lam (x * psi) * (A1 x / ((psi : ℝ) : ℂ))‖
      ≤ |lam|⁻¹ * ((|lam| ^ 3 * |psi| ^ 3)⁻¹ * ((∫ x in a..b, ‖A4 x‖) * |psi|⁻¹)) :=
    mul_le_mul_of_nonneg_left h3 (by positivity)
  refine le_trans hchain (le_of_eq ?_)
  have hp4 : |psi| ^ 4 = |psi| ^ 3 * |psi| := by ring
  have hl4 : |lam| ^ 4 = |lam| * |lam| ^ 3 := by ring
  rw [hp4, hl4, mul_inv, mul_inv, mul_inv, mul_inv]
  ring

end IbpThrice



/-! ## Polar coordinates on the plane -/

section Polar

/-- The coordinate constructor for the plane. -/
def mk2 (x y : ℝ) : Pl :=
  x • EuclideanSpace.single (0 : Fin 2) (1 : ℝ) + y • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)

@[simp] theorem mk2_apply_zero (x y : ℝ) : mk2 x y 0 = x := by
  simp [mk2, EuclideanSpace.single_apply, PiLp.add_apply, PiLp.smul_apply]

@[simp] theorem mk2_apply_one (x y : ℝ) : mk2 x y 1 = y := by
  simp [mk2, EuclideanSpace.single_apply, PiLp.add_apply, PiLp.smul_apply]

theorem coords_mk2 (x y : ℝ) : coords (mk2 x y) = (x, y) := by
  rw [coords_apply, mk2_apply_zero, mk2_apply_one]

theorem coords_symm_apply (q : ℝ × ℝ) : coords.symm q = mk2 q.1 q.2 := by
  refine coords.injective ?_
  rw [MeasurableEquiv.apply_symm_apply, coords_mk2]

theorem continuous_mk2 : Continuous fun q : ℝ × ℝ => mk2 q.1 q.2 := by
  show Continuous fun q : ℝ × ℝ =>
    q.1 • EuclideanSpace.single (0 : Fin 2) (1 : ℝ) +
      q.2 • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)
  refine Continuous.add ?_ ?_
  · exact continuous_fst.smul
      (continuous_const (y := EuclideanSpace.single (0 : Fin 2) (1 : ℝ)))
  · exact continuous_snd.smul
      (continuous_const (y := EuclideanSpace.single (1 : Fin 2) (1 : ℝ)))

theorem norm_mk2_sq (x y : ℝ) : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := by
  rw [norm_sq_two, mk2_apply_zero, mk2_apply_one]

/-- The polar parameterization of the plane. -/
def pt (r φ : ℝ) : Pl := mk2 (r * Real.cos φ) (r * Real.sin φ)

theorem norm_pt (r φ : ℝ) (hr : 0 ≤ r) : ‖pt r φ‖ = r := by
  have hsq : ‖pt r φ‖ ^ 2 = r ^ 2 := by
    rw [pt, norm_mk2_sq]
    have := Real.sin_sq_add_cos_sq φ
    nlinarith
  nlinarith [norm_nonneg (pt r φ), hr]

theorem pt_eq_smul (r φ : ℝ) : pt r φ = r • pt 1 φ := by
  rw [pt, pt, mk2, mk2, one_mul, one_mul, smul_add, smul_smul, smul_smul]

theorem norm_pt_one (φ : ℝ) : ‖pt 1 φ‖ = 1 := norm_pt 1 φ zero_le_one

theorem continuous_pt : Continuous fun q : ℝ × ℝ => pt q.1 q.2 := by
  have hinner : Continuous fun q : ℝ × ℝ =>
      ((q.1 * Real.cos q.2 : ℝ), (q.1 * Real.sin q.2 : ℝ)) :=
    (continuous_fst.mul (Real.continuous_cos.comp continuous_snd)).prodMk
      (continuous_fst.mul (Real.continuous_sin.comp continuous_snd))
  exact continuous_mk2.comp hinner

theorem continuous_pt_fixed (φ : ℝ) : Continuous fun r : ℝ => pt r φ := by
  have : (fun r : ℝ => pt r φ) = (fun q : ℝ × ℝ => pt q.1 q.2) ∘ (fun r : ℝ => (r, φ)) := rfl
  rw [this]
  exact continuous_pt.comp (continuous_id.prodMk continuous_const)

/-- The polar coordinate formula on the plane. -/
theorem integral_polar (f : Pl → ℂ) :
    (∫ η : Pl, f η) = ∫ q in polarCoord.target, q.1 • f (pt q.1 q.2) := by
  have h1 : (∫ η : Pl, f η) = ∫ q : ℝ × ℝ, f (coords.symm q) := by
    have h := measurePreserving_coords.integral_comp coords.measurableEmbedding
      (fun q : ℝ × ℝ => f (coords.symm q))
    rw [← h]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show f η = f (coords.symm (coords η))
    rw [MeasurableEquiv.symm_apply_apply]
  rw [h1, ← integral_comp_polarCoord_symm (fun q : ℝ × ℝ => f (coords.symm q))]
  refine setIntegral_congr_fun polarCoord.open_target.measurableSet fun q _ => ?_
  congr 2
  rw [coords_symm_apply]
  rfl

theorem integrableOn_polar {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) :
    IntegrableOn (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) volume := by
  classical
  obtain ⟨C0, hC0⟩ := (isCompact_closedBall (0 : Pl) R).exists_bound_of_continuousOn
    hf.continuousOn
  set C : ℝ := max C0 0 with hCdef
  have hCnn : (0 : ℝ) ≤ C := le_max_right _ _
  have hC : ∀ η : Pl, ‖f η‖ ≤ C := by
    intro η
    by_cases h : ‖η‖ ≤ R
    · refine le_trans (hC0 η ?_) (le_max_left _ _)
      rw [Metric.mem_closedBall, dist_zero_right]
      exact h
    · rw [hsupp η (not_le.mp h)]
      simpa using hCnn
  have hcont : Continuous fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2) := by
    exact continuous_fst.smul (hf.comp continuous_pt)
  have hsplit : Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π
      = (Set.Ioc 0 R ×ˢ Set.Ioo (-π) π) ∪ (Set.Ioi R ×ˢ Set.Ioo (-π) π) := by
    rw [← Set.union_prod, Set.Ioc_union_Ioi_eq_Ioi hR.le]
  rw [hsplit]
  refine IntegrableOn.union ?_ ?_
  · refine Measure.integrableOn_of_bounded ?_ hcont.aestronglyMeasurable (M := R * C) ?_
    · rw [Measure.volume_eq_prod, Measure.prod_prod]
      exact ENNReal.mul_ne_top measure_Ioc_lt_top.ne measure_Ioo_lt_top.ne
    · refine ae_restrict_of_forall_mem (measurableSet_Ioc.prod measurableSet_Ioo) fun q hq => ?_
      have hq1 : q.1 ∈ Set.Ioc (0 : ℝ) R := hq.1
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hq1.1]
      exact mul_le_mul hq1.2 (hC _) (norm_nonneg _) (le_trans hq1.1.le hq1.2)
  · have hzero : ∀ q ∈ Set.Ioi R ×ˢ Set.Ioo (-π) π, q.1 • f (pt q.1 q.2) = 0 := by
      intro q hq
      have hq1 : R < q.1 := hq.1
      rw [hsupp (pt q.1 q.2) (by rw [norm_pt _ _ (lt_trans hR hq1).le]; exact hq1)]
      simp
    refine (integrableOn_zero (μ := (volume : Measure (ℝ × ℝ)))
      (s := Set.Ioi R ×ˢ Set.Ioo (-π) π)).congr_fun ?_ ?_
    · exact fun q hq => (hzero q hq).symm
    · exact (measurableSet_Ioi.prod measurableSet_Ioo)

/-- The polar estimate with the angular variable outermost.  If for every angle `φ` the radial
integral has extended norm at most `M · 1_{Sφ}(φ)`, then the plane integral is bounded by
`M` times the measure of the relevant angular range. -/
theorem enorm_integral_polar_le {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0)
    {Sφ : Set ℝ} (hSφ : MeasurableSet Sφ) {M : ℝ}
    (hbd : ∀ φ : ℝ, ‖∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ)‖ₑ
      ≤ Set.indicator Sφ (fun _ => ENNReal.ofReal M) φ) :
    ‖∫ η : Pl, f η‖ₑ ≤ ENNReal.ofReal M * volume (Sφ ∩ Set.Ioo (-π) π) := by
  classical
  have htarget : polarCoord.target = Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π := rfl
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar hf hR hsupp
  have hpolar : (∫ η : Pl, f η)
      = ∫ φ in Set.Ioo (-π) π, ∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ) := by
    rw [integral_polar f, htarget, ← hprod]
    exact integral_prod_symm (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2)) hint
  rw [hpolar]
  refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
  refine le_trans (lintegral_mono hbd) ?_
  rw [lintegral_indicator hSφ, setLIntegral_const, Measure.restrict_apply hSφ]

end Polar

/-! ### Iterated polar integrals -/

section PolarIterated

/-- Polar coordinates with the angle outermost. -/
theorem integral_polar_angle_outer {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) :
    (∫ η : Pl, f η) = ∫ φ in Set.Ioo (-π) π, ∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ) := by
  have htarget : polarCoord.target = Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π := rfl
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar hf hR hsupp
  rw [integral_polar f, htarget, ← hprod]
  exact integral_prod_symm (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2)) hint

/-- Polar coordinates with the radius outermost. -/
theorem integral_polar_radius_outer {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) :
    (∫ η : Pl, f η) = ∫ r in Set.Ioi (0 : ℝ), ∫ φ in Set.Ioo (-π) π, (r : ℝ) • f (pt r φ) := by
  have htarget : polarCoord.target = Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π := rfl
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar hf hR hsupp
  rw [integral_polar f, htarget, ← hprod]
  exact integral_prod (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2)) hint

/-- Bounding a plane integral by the angular integral of a bound for the radial integrals. -/
theorem enorm_integral_polar_le_angle {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) {g : ℝ → ℝ≥0∞}
    (hbd : ∀ φ : ℝ, ‖∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ)‖ₑ ≤ g φ) :
    ‖∫ η : Pl, f η‖ₑ ≤ ∫⁻ φ in Set.Ioo (-π) π, g φ := by
  rw [integral_polar_angle_outer hf hR hsupp]
  exact le_trans (enorm_integral_le_lintegral_enorm _) (lintegral_mono hbd)

/-- Bounding a plane integral by the radial integral of a bound for the angular integrals. -/
theorem enorm_integral_polar_le_radius {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) {g : ℝ → ℝ≥0∞}
    (hbd : ∀ r : ℝ, ‖∫ φ in Set.Ioo (-π) π, (r : ℝ) • f (pt r φ)‖ₑ ≤ g r) :
    ‖∫ η : Pl, f η‖ₑ ≤ ∫⁻ r in Set.Ioi (0 : ℝ), g r := by
  rw [integral_polar_radius_outer hf hR hsupp]
  exact le_trans (enorm_integral_le_lintegral_enorm _) (lintegral_mono hbd)

end PolarIterated




/-! ## The elliptic phase `τ_ξ(ρ) = |ξ - ρθ| + ρ`

For a unit vector `θ` write `a = ⟪ξ, θ⟫` and `R = ‖ξ‖`.  Then `|ξ - ρθ|² = ρ² - 2aρ + R²`, and the
discriminant condition `a² < R²` says exactly that `θ` is not parallel to `ξ`.  Under it the phase
is smooth on all of `ℝ` and its derivative never vanishes, which is what the non-stationary phase
estimate needs.
-/

section Phase

/-- `|ξ - ρθ|²`. -/
def qf (a R ρ : ℝ) : ℝ := ρ ^ 2 - 2 * a * ρ + R ^ 2

/-- `|ξ - ρθ|`. -/
def gf (a R ρ : ℝ) : ℝ := Real.sqrt (qf a R ρ)

/-- The elliptic phase `|ξ - ρθ| + ρ`. -/
def tauf (a R ρ : ℝ) : ℝ := gf a R ρ + ρ

/-- The first derivative of the elliptic phase. -/
def tauf1 (a R ρ : ℝ) : ℝ := 1 + (ρ - a) / gf a R ρ

/-- The second derivative of the elliptic phase. -/
def tauf2 (a R ρ : ℝ) : ℝ := (R ^ 2 - a ^ 2) / gf a R ρ ^ 3

/-- The third derivative of the elliptic phase. -/
def tauf3 (a R ρ : ℝ) : ℝ := -(3 * (R ^ 2 - a ^ 2) * (ρ - a)) / gf a R ρ ^ 5

variable {a R : ℝ}

theorem qf_eq (a R ρ : ℝ) : qf a R ρ = (ρ - a) ^ 2 + (R ^ 2 - a ^ 2) := by
  rw [qf]; ring

theorem qf_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < qf a R ρ := by
  rw [qf_eq]
  nlinarith [sq_nonneg (ρ - a)]

theorem gf_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < gf a R ρ :=
  Real.sqrt_pos.mpr (qf_pos hD ρ)

theorem gf_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : gf a R ρ ≠ 0 := (gf_pos hD ρ).ne'

theorem gf_sq (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : gf a R ρ ^ 2 = qf a R ρ :=
  Real.sq_sqrt (qf_pos hD ρ).le

theorem abs_sub_lt_gf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : |ρ - a| < gf a R ρ := by
  have hsq : (ρ - a) ^ 2 < gf a R ρ ^ 2 := by
    rw [gf_sq hD, qf_eq]
    linarith
  have habs : |ρ - a| ^ 2 < gf a R ρ ^ 2 := by rwa [sq_abs]
  nlinarith [abs_nonneg (ρ - a), gf_pos hD ρ]

theorem hasDerivAt_qf (a R ρ : ℝ) : HasDerivAt (qf a R) (2 * ρ - 2 * a) ρ := by
  show HasDerivAt (fun x : ℝ => x ^ 2 - 2 * a * x + R ^ 2) (2 * ρ - 2 * a) ρ
  have h1 : HasDerivAt (fun x : ℝ => x ^ 2) (2 * ρ) ρ := by
    simpa using hasDerivAt_pow 2 ρ
  have h2 : HasDerivAt (fun x : ℝ => 2 * a * x) (2 * a) ρ := by
    simpa using (hasDerivAt_id ρ).const_mul (2 * a)
  exact (h1.sub h2).add_const (R ^ 2)

theorem hasDerivAt_gf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (gf a R) ((ρ - a) / gf a R ρ) ρ := by
  have h1 : HasDerivAt Real.sqrt (1 / (2 * Real.sqrt (qf a R ρ))) (qf a R ρ) :=
    Real.hasDerivAt_sqrt (qf_pos hD ρ).ne'
  have h2 := h1.comp ρ (hasDerivAt_qf a R ρ)
  have heq : 1 / (2 * Real.sqrt (qf a R ρ)) * (2 * ρ - 2 * a) = (ρ - a) / gf a R ρ := by
    rw [gf]
    field_simp
  rw [heq] at h2
  exact h2

theorem continuous_gf (hD : 0 < R ^ 2 - a ^ 2) : Continuous (gf a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_gf hD ρ).continuousAt

theorem hasDerivAt_tauf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf a R) (tauf1 a R ρ) ρ := by
  have h := (hasDerivAt_gf hD ρ).add (hasDerivAt_id ρ)
  have heq : (ρ - a) / gf a R ρ + 1 = tauf1 a R ρ := by rw [tauf1]; ring
  rw [heq] at h
  exact h

theorem continuous_tauf (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf a R) :=
  (continuous_gf hD).add continuous_id

theorem hasDerivAt_tauf1 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf1 a R) (tauf2 a R ρ) ρ := by
  have hg := hasDerivAt_gf hD ρ
  have hnum : HasDerivAt (fun x : ℝ => x - a) 1 ρ := (hasDerivAt_id ρ).sub_const a
  have h := hnum.div hg (gf_ne hD ρ)
  have hgne : gf a R ρ ≠ 0 := gf_ne hD ρ
  have hgg : gf a R ρ * gf a R ρ = (ρ - a) ^ 2 + (R ^ 2 - a ^ 2) := by
    rw [← pow_two, gf_sq hD, qf_eq]
  have key : 1 * gf a R ρ - (ρ - a) * ((ρ - a) / gf a R ρ)
      = (R ^ 2 - a ^ 2) / gf a R ρ := by
    rw [one_mul]
    field_simp
    nlinarith [hgg]
  have heq : (0 : ℝ) + (1 * gf a R ρ - (ρ - a) * ((ρ - a) / gf a R ρ)) / gf a R ρ ^ 2
      = tauf2 a R ρ := by
    rw [zero_add, key, tauf2, div_div]
    congr 1
    ring
  have h2 := (hasDerivAt_const ρ (1 : ℝ)).add h
  rw [heq] at h2
  exact h2

theorem continuous_tauf1 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf1 a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_tauf1 hD ρ).continuousAt

theorem hasDerivAt_tauf2 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf2 a R) (tauf3 a R ρ) ρ := by
  have hgne : gf a R ρ ≠ 0 := gf_ne hD ρ
  have hg := hasDerivAt_gf hD ρ
  have hcube : HasDerivAt (fun x : ℝ => gf a R x ^ 3)
      (3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ)) ρ := by
    have h := hg.pow 3
    have heq : (3 : ℕ) * gf a R ρ ^ (3 - 1) * ((ρ - a) / gf a R ρ)
        = 3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ) := by
      norm_num
    rw [heq] at h
    exact h
  have hpow3 : (0 : ℝ) < gf a R ρ ^ 3 := pow_pos (gf_pos hD ρ) 3
  have h := (hasDerivAt_const ρ (R ^ 2 - a ^ 2)).div hcube hpow3.ne'
  have heq : (0 * gf a R ρ ^ 3 - (R ^ 2 - a ^ 2) * (3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ)))
      / (gf a R ρ ^ 3) ^ 2 = tauf3 a R ρ := by
    rw [tauf3]
    field_simp
    ring
  rw [heq] at h
  exact h

theorem continuous_tauf2 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf2 a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_tauf2 hD ρ).continuousAt

theorem continuous_tauf3 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf3 a R) := by
  refine Continuous.div ?_ ((continuous_gf hD).pow 5) (fun ρ => pow_ne_zero 5 (gf_ne hD ρ))
  exact (continuous_const.mul (continuous_id.sub continuous_const)).neg

theorem tauf1_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < tauf1 a R ρ := by
  have h1 := abs_sub_lt_gf hD ρ
  have hg := gf_pos hD ρ
  have h2 : -(gf a R ρ) < ρ - a := (abs_lt.mp h1).1
  have h4 : (-1 : ℝ) < (ρ - a) / gf a R ρ := by
    rw [lt_div_iff₀ hg]
    linarith
  rw [tauf1]
  linarith

theorem tauf1_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : tauf1 a R ρ ≠ 0 := (tauf1_pos hD ρ).ne'

end Phase


/-! ## The radial oscillatory estimate

Two integrations by parts against the elliptic phase.  The amplitudes after one and two
integrations by parts are written out explicitly, so that they can be estimated directly and so
that they visibly vanish wherever the original amplitude vanishes to second order.
-/

section Radial

variable {a R : ℝ}

/-- The amplitude after one integration by parts. -/
def bfun (a R : ℝ) (A A1 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  A1 ρ / (tauf1 a R ρ : ℂ) - A ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2

/-- The derivative of the amplitude after one integration by parts. -/
def bfun1 (a R : ℝ) (A A1 A2 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  A2 ρ / (tauf1 a R ρ : ℂ)
    - 2 * A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
    - A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
    + 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3

/-- The amplitude after two integrations by parts. -/
def cfun (a R : ℝ) (A A1 A2 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  bfun1 a R A A1 A2 ρ / (tauf1 a R ρ : ℂ)
    - bfun a R A A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2

theorem cT_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : (tauf1 a R ρ : ℂ) ≠ 0 := by
  exact_mod_cast tauf1_ne hD ρ

theorem hasDerivAt_cT (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (fun y => (tauf1 a R y : ℂ)) ((tauf2 a R ρ : ℂ)) ρ :=
  (hasDerivAt_tauf1 hD ρ).ofReal_comp

theorem hasDerivAt_cT2 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (fun y => (tauf2 a R y : ℂ)) ((tauf3 a R ρ : ℂ)) ρ :=
  (hasDerivAt_tauf2 hD ρ).ofReal_comp

theorem continuous_cT (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf1 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf1 hD)

theorem continuous_cT2 (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf2 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf2 hD)

theorem continuous_cT3 (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf3 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf3 hD)

/-- Dividing by the phase derivative: the general step. -/
theorem hasDerivAt_div_cT (hD : 0 < R ^ 2 - a ^ 2) {f f1 : ℝ → ℂ}
    (hf : ∀ ρ, HasDerivAt f (f1 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (fun y => f y / (tauf1 a R y : ℂ))
      (f1 ρ / (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2) ρ := by
  have h := (hf ρ).div (hasDerivAt_cT hD ρ) (cT_ne hD ρ)
  have heq : (f1 ρ * (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ)) / (tauf1 a R ρ : ℂ) ^ 2
      = f1 ρ / (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2 := by
    have hne := cT_ne hD ρ
    field_simp
  rw [heq] at h
  exact h

theorem hasDerivAt_bfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (bfun a R A A1) (bfun1 a R A A1 A2 ρ) ρ := by
  have hne := cT_ne hD ρ
  have h1 : HasDerivAt (fun y => A1 y / (tauf1 a R y : ℂ))
      (A2 ρ / (tauf1 a R ρ : ℂ) - A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2) ρ :=
    hasDerivAt_div_cT hD hA1 ρ
  have hsq : HasDerivAt (fun y => (tauf1 a R y : ℂ) ^ 2)
      (2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ)) ρ := by
    have h := (hasDerivAt_cT hD ρ).pow 2
    have heq : ((2 : ℕ) : ℂ) * (tauf1 a R ρ : ℂ) ^ (2 - 1) * (tauf2 a R ρ : ℂ)
        = 2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ) := by norm_num
    rw [heq] at h
    exact h
  have hnum : HasDerivAt (fun y => A y * (tauf2 a R y : ℂ))
      (A1 ρ * (tauf2 a R ρ : ℂ) + A ρ * (tauf3 a R ρ : ℂ)) ρ :=
    (hA ρ).mul (hasDerivAt_cT2 hD ρ)
  have hsqne : (tauf1 a R ρ : ℂ) ^ 2 ≠ 0 := pow_ne_zero 2 hne
  have h2 := hnum.div hsq hsqne
  have heq2 : ((A1 ρ * (tauf2 a R ρ : ℂ) + A ρ * (tauf3 a R ρ : ℂ)) * (tauf1 a R ρ : ℂ) ^ 2
        - A ρ * (tauf2 a R ρ : ℂ) * (2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ)))
        / ((tauf1 a R ρ : ℂ) ^ 2) ^ 2
      = A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        + A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        - 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3 := by
    field_simp
  rw [heq2] at h2
  have h3 := h1.sub h2
  have heq3 : (A2 ρ / (tauf1 a R ρ : ℂ) - A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2)
      - (A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        + A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        - 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3)
      = bfun1 a R A A1 A2 ρ := by
    rw [bfun1]
    field_simp
    ring
  rw [heq3] at h3
  exact h3

theorem hasDerivAt_bfun_div_cT (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (fun y => bfun a R A A1 y / (tauf1 a R y : ℂ)) (cfun a R A A1 A2 ρ) ρ :=
  hasDerivAt_div_cT hD (fun y => hasDerivAt_bfun hD hA hA1 y) ρ

theorem continuous_bfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) : Continuous (bfun a R A A1) := by
  refine Continuous.sub ?_ ?_
  · exact hA1c.div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact (hAc.mul (continuous_cT2 hD)).div ((continuous_cT hD).pow 2)
      (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))

theorem continuous_bfun1 (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2) :
    Continuous (bfun1 a R A A1 A2) := by
  refine Continuous.add (Continuous.sub (Continuous.sub ?_ ?_) ?_) ?_
  · exact hA2c.div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact ((continuous_const.mul hA1c).mul (continuous_cT2 hD)).div
      ((continuous_cT hD).pow 2) (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))
  · exact (hAc.mul (continuous_cT3 hD)).div ((continuous_cT hD).pow 2)
      (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))
  · exact ((continuous_const.mul hAc).mul ((continuous_cT2 hD).pow 2)).div
      ((continuous_cT hD).pow 3) (fun ρ => pow_ne_zero 3 (cT_ne hD ρ))

theorem continuous_cfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2) :
    Continuous (cfun a R A A1 A2) := by
  refine Continuous.sub ?_ ?_
  · exact (continuous_bfun1 hD hAc hA1c hA2c).div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact ((continuous_bfun hD hAc hA1c).mul (continuous_cT2 hD)).div
      ((continuous_cT hD).pow 2) (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))

/-- The radial oscillatory estimate: two integrations by parts against the elliptic phase. -/
theorem norm_integral_radial_le (hD : 0 < R ^ 2 - a ^ 2)
    {A A1 A2 : ℝ → ℂ} (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ)
    (hA2c : Continuous A2)
    {lam : ℝ} (hlam : lam ≠ 0) {b : ℝ} (hb : 0 ≤ b)
    (hA0 : A 0 = 0) (hAb : A b = 0)
    (hB0 : bfun a R A A1 0 = 0) (hBb : bfun a R A A1 b = 0)
    {K : ℝ} (hK : 0 ≤ K) (hCbd : ∀ ρ ∈ Set.Icc (0 : ℝ) b, ‖cfun a R A A1 A2 ρ‖ ≤ K) :
    ‖∫ ρ in (0 : ℝ)..b, osc lam (tauf a R ρ) * A ρ‖ ≤ (lam ^ 2)⁻¹ * (K * b) := by
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun ρ => (hA ρ).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun ρ => (hA1 ρ).continuousAt
  have hstep := norm_integral_osc_ibp_twice hb hlam (τ := tauf a R) (τ' := tauf1 a R)
    (A := A) (Bn := bfun a R A A1) (Cn := cfun a R A A1 A2)
    (fun ρ => hasDerivAt_tauf hD ρ) (continuous_tauf1 hD) (fun ρ => tauf1_ne hD ρ)
    hAc (continuous_bfun hD hAc hA1c) (continuous_cfun hD hAc hA1c hA2c)
    (fun ρ => hasDerivAt_div_cT hD hA ρ) (fun ρ => hasDerivAt_bfun_div_cT hD hA hA1 ρ)
    hA0 hAb hB0 hBb
  refine le_trans hstep ?_
  have hnn : (0 : ℝ) ≤ (lam ^ 2)⁻¹ := by positivity
  refine mul_le_mul_of_nonneg_left ?_ hnn
  have hintg : IntervalIntegrable (fun ρ => ‖cfun a R A A1 A2 ρ‖) volume 0 b :=
    ((continuous_cfun hD hAc hA1c hA2c).norm).intervalIntegrable 0 b
  have hmono : (∫ ρ in (0 : ℝ)..b, ‖cfun a R A A1 A2 ρ‖) ≤ ∫ _ρ in (0 : ℝ)..b, K :=
    intervalIntegral.integral_mono_on hb hintg (intervalIntegrable_const) hCbd
  refine le_trans hmono (le_of_eq ?_)
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
  ring

end Radial


/-! ## Planar angle geometry

The sine of the unoriented angle is the normalized determinant, and vectors of the narrow cone
`{0 < ω₁ < 2^{-10} ω₂}` make a tiny angle with each other.
-/

section AngleGeometry

theorem sin_angle_eq (x y : Pl) :
    Real.sin (InnerProductGeometry.angle x y) * (‖x‖ * ‖y‖) = |det2 x y| := by
  set θ := InnerProductGeometry.angle x y with hθ
  have hcos : Real.cos θ * (‖x‖ * ‖y‖) = inner ℝ x y :=
    InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
  have hsinnn : 0 ≤ Real.sin θ :=
    Real.sin_nonneg_of_nonneg_of_le_pi (InnerProductGeometry.angle_nonneg x y)
      (InnerProductGeometry.angle_le_pi x y)
  have hnn : (0 : ℝ) ≤ ‖x‖ * ‖y‖ := by positivity
  have hsq : (Real.sin θ * (‖x‖ * ‖y‖)) ^ 2 = |det2 x y| ^ 2 := by
    rw [sq_abs, lagrange, ← hcos]
    have h := Real.sin_sq_add_cos_sq θ
    nlinarith [h]
  have h1 : 0 ≤ Real.sin θ * (‖x‖ * ‖y‖) := mul_nonneg hsinnn hnn
  nlinarith [hsq, h1, abs_nonneg (det2 x y)]

theorem inner_pos_of_cone {x y : Pl} (hx0 : 0 < x 0) (hx1 : 0 < x 1)
    (hy0 : 0 < y 0) (hy1 : 0 < y 1) : 0 < inner ℝ x y := by
  rw [inner_two]
  positivity

/-- Two vectors of the narrow cone make an angle whose sine is at most `2^{-10}`. -/
theorem sin_angle_le_of_cone {x y : Pl}
    (hx0 : 0 < x 0) (hx1 : 0 < x 1) (hxc : x 0 < (2 : ℝ) ^ (-(10 : ℤ)) * x 1)
    (hy0 : 0 < y 0) (hy1 : 0 < y 1) (hyc : y 0 < (2 : ℝ) ^ (-(10 : ℤ)) * y 1) :
    Real.sin (InnerProductGeometry.angle x y) ≤ (2 : ℝ) ^ (-(10 : ℤ)) := by
  have hxn : x 1 ≤ ‖x‖ := by
    have hsq : x 1 ^ 2 ≤ ‖x‖ ^ 2 := by
      rw [norm_sq_two]; nlinarith [sq_nonneg (x 0)]
    nlinarith [norm_nonneg x, hx1]
  have hyn : y 1 ≤ ‖y‖ := by
    have hsq : y 1 ^ 2 ≤ ‖y‖ ^ 2 := by
      rw [norm_sq_two]; nlinarith [sq_nonneg (y 0)]
    nlinarith [norm_nonneg y, hy1]
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
  have hdet : |det2 x y| < (2 : ℝ) ^ (-(10 : ℤ)) * (x 1 * y 1) := by
    rw [det2, abs_lt]
    constructor
    · nlinarith
    · nlinarith
  have hkey := sin_angle_eq x y
  have hxpos : (0 : ℝ) < ‖x‖ := lt_of_lt_of_le hx1 hxn
  have hypos : (0 : ℝ) < ‖y‖ := lt_of_lt_of_le hy1 hyn
  have hprod : (2 : ℝ) ^ (-(10 : ℤ)) * (x 1 * y 1) ≤ (2 : ℝ) ^ (-(10 : ℤ)) * (‖x‖ * ‖y‖) := by
    refine mul_le_mul_of_nonneg_left ?_ hc.le
    exact mul_le_mul hxn hyn hy1.le (le_of_lt hxpos)
  have hle : Real.sin (InnerProductGeometry.angle x y) * (‖x‖ * ‖y‖)
      ≤ (2 : ℝ) ^ (-(10 : ℤ)) * (‖x‖ * ‖y‖) := by
    rw [hkey]
    linarith
  have hmul : (0 : ℝ) < ‖x‖ * ‖y‖ := by positivity
  exact le_of_mul_le_mul_right hle hmul

/-- Two vectors of the narrow cone make an angle of at most `2^{-9}`. -/
theorem angle_le_of_cone {x y : Pl}
    (hx0 : 0 < x 0) (hx1 : 0 < x 1) (hxc : x 0 < (2 : ℝ) ^ (-(10 : ℤ)) * x 1)
    (hy0 : 0 < y 0) (hy1 : 0 < y 1) (hyc : y 0 < (2 : ℝ) ^ (-(10 : ℤ)) * y 1) :
    InnerProductGeometry.angle x y ≤ (2 : ℝ) ^ (-(9 : ℤ)) := by
  set α := InnerProductGeometry.angle x y with hα
  have hα0 : 0 ≤ α := InnerProductGeometry.angle_nonneg x y
  have hsin := sin_angle_le_of_cone hx0 hx1 hxc hy0 hy1 hyc
  rw [← hα] at hsin
  -- the cosine is positive, so the angle is less than `π / 2`
  have hinner : 0 < inner ℝ x y := inner_pos_of_cone hx0 hx1 hy0 hy1
  have hxpos : (0 : ℝ) < ‖x‖ := by
    have : x 1 ^ 2 ≤ ‖x‖ ^ 2 := by rw [norm_sq_two]; nlinarith [sq_nonneg (x 0)]
    nlinarith [norm_nonneg x, hx1]
  have hypos : (0 : ℝ) < ‖y‖ := by
    have : y 1 ^ 2 ≤ ‖y‖ ^ 2 := by rw [norm_sq_two]; nlinarith [sq_nonneg (y 0)]
    nlinarith [norm_nonneg y, hy1]
  have hcos : Real.cos α * (‖x‖ * ‖y‖) = inner ℝ x y :=
    InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
  have hmul : (0 : ℝ) < ‖x‖ * ‖y‖ := by positivity
  have hcospos : 0 < Real.cos α := by
    have h : 0 < Real.cos α * (‖x‖ * ‖y‖) := by rw [hcos]; exact hinner
    nlinarith [h, hmul]
  have hlepi : α ≤ π := InnerProductGeometry.angle_le_pi x y
  -- for `0 ≤ α < π / 2` we have `α ≤ (π / 2) * sin α`
  have hαlt : α < π / 2 := by
    by_contra hcon
    push_neg at hcon
    have := Real.cos_nonpos_of_pi_div_two_le_of_le hcon (by linarith [Real.pi_pos])
    linarith
  have hkey : α ≤ (π / 2) * Real.sin α := by
    have h := Real.mul_le_sin hα0 (le_of_lt hαlt)
    calc α = (π / 2) * (2 / π * α) := by
          have hπ : π ≠ 0 := Real.pi_pos.ne'
          field_simp
      _ ≤ (π / 2) * Real.sin α := by
          refine mul_le_mul_of_nonneg_left h ?_
          positivity
  have hbound : (π / 2) * Real.sin α ≤ (π / 2) * (2 : ℝ) ^ (-(10 : ℤ)) := by
    refine mul_le_mul_of_nonneg_left hsin ?_
    positivity
  have hnum : (π / 2) * (2 : ℝ) ^ (-(10 : ℤ)) ≤ (2 : ℝ) ^ (-(9 : ℤ)) := by
    have h4 : π / 2 ≤ 2 := by linarith [Real.pi_le_four]
    have hpow : (2 : ℝ) ^ (-(9 : ℤ)) = 2 * (2 : ℝ) ^ (-(10 : ℤ)) := by
      rw [show (-(9 : ℤ)) = 1 + (-(10 : ℤ)) by ring, zpow_add₀ (two_ne_zero), zpow_one]
    rw [hpow]
    have hc : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
    exact mul_le_mul_of_nonneg_right h4 hc.le
  exact le_trans hkey (le_trans hbound hnum)

end AngleGeometry


/-! ## Quantitative bounds on the elliptic phase

The three facts used by the non-stationary phase estimate:
`τ' ≥ D / (2 g²)`, and the second and third derivatives of `τ` are bounded by `(2/g) τ'` and
`(6/g²) τ'`, where `D = R² - a²` and `g = |ξ - ρθ|`.  In the application `D ≈ R² 2^{-2m}` and
`g ≈ 2^j`, so `τ' ≈ 2^{-2m}` and each further derivative costs a factor `2^{-j}`.
-/

section PhaseBounds

variable {a R : ℝ}

theorem tauf1_lower (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    (R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2) ≤ tauf1 a R ρ := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hg2 : gf a R ρ ^ 2 = (ρ - a) ^ 2 + (R ^ 2 - a ^ 2) := by
    rw [gf_sq hD, qf_eq]
  have hden : (0 : ℝ) < 2 * gf a R ρ ^ 2 := by positivity
  rw [tauf1, div_le_iff₀ hden]
  have hexp : (1 + (ρ - a) / gf a R ρ) * (2 * gf a R ρ ^ 2)
      = 2 * gf a R ρ ^ 2 + 2 * gf a R ρ * (ρ - a) := by
    field_simp
  rw [hexp]
  nlinarith [sq_nonneg ((ρ - a) + gf a R ρ), hg2]

theorem tauf2_abs_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    |tauf2 a R ρ| ≤ 2 / gf a R ρ * tauf1 a R ρ := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have h1 := tauf1_lower hD ρ
  have habs : |tauf2 a R ρ| = tauf2 a R ρ := by
    refine abs_of_nonneg ?_
    rw [tauf2]
    positivity
  rw [habs, tauf2]
  have hstep : 2 / gf a R ρ * ((R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2))
      = (R ^ 2 - a ^ 2) / gf a R ρ ^ 3 := by
    field_simp
  calc (R ^ 2 - a ^ 2) / gf a R ρ ^ 3
      = 2 / gf a R ρ * ((R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2)) := hstep.symm
    _ ≤ 2 / gf a R ρ * tauf1 a R ρ := by
        refine mul_le_mul_of_nonneg_left h1 ?_
        positivity

theorem tauf3_abs_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    |tauf3 a R ρ| ≤ 6 / gf a R ρ ^ 2 * tauf1 a R ρ := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have h1 := tauf1_lower hD ρ
  have habs : |tauf3 a R ρ| = 3 * (R ^ 2 - a ^ 2) * |ρ - a| / gf a R ρ ^ 5 := by
    rw [tauf3, abs_div, abs_neg, abs_of_pos (show (0 : ℝ) < gf a R ρ ^ 5 by positivity)]
    congr 1
    rw [abs_mul, abs_of_pos (show (0 : ℝ) < 3 * (R ^ 2 - a ^ 2) by linarith)]
  have hstep : 3 * (R ^ 2 - a ^ 2) * |ρ - a| / gf a R ρ ^ 5
      ≤ 3 * (R ^ 2 - a ^ 2) / gf a R ρ ^ 4 := by
    rw [div_le_div_iff₀ (by positivity) (by positivity)]
    have hlt : |ρ - a| ≤ gf a R ρ := (abs_sub_lt_gf hD ρ).le
    have h4 : |ρ - a| * gf a R ρ ^ 4 ≤ gf a R ρ * gf a R ρ ^ 4 :=
      mul_le_mul_of_nonneg_right hlt (by positivity)
    nlinarith [h4, hD]
  have hfinal : 3 * (R ^ 2 - a ^ 2) / gf a R ρ ^ 4
      ≤ 6 / gf a R ρ ^ 2 * tauf1 a R ρ := by
    have heq : 6 / gf a R ρ ^ 2 * ((R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2))
        = 3 * (R ^ 2 - a ^ 2) / gf a R ρ ^ 4 := by
      field_simp
      ring
    calc 3 * (R ^ 2 - a ^ 2) / gf a R ρ ^ 4
        = 6 / gf a R ρ ^ 2 * ((R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2)) := heq.symm
      _ ≤ 6 / gf a R ρ ^ 2 * tauf1 a R ρ := by
          refine mul_le_mul_of_nonneg_left h1 ?_
          positivity
  rw [habs]
  exact le_trans hstep hfinal

theorem inv_tauf1_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    (tauf1 a R ρ)⁻¹ ≤ 2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) := by
  have h1 := tauf1_lower hD ρ
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hnum : 0 < (R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2) := by positivity
  have hstep : (tauf1 a R ρ)⁻¹ ≤ ((R ^ 2 - a ^ 2) / (2 * gf a R ρ ^ 2))⁻¹ :=
    inv_anti₀ hnum h1
  refine le_trans hstep (le_of_eq ?_)
  rw [inv_div]

end PhaseBounds


/-! ## The Schur summation over the radii

`∑_{t' ∈ ℰ} (1 + |t - t'| / δ)^{-2} ≲ sup_{|I| = δ} #(ℰ ∩ I)`.
-/

section Schur

/-- `N` bounds the number of points of `Efin` in every half-open interval of length `δ`. -/
def IsIntervalCount (Efin : Finset ℝ) (δ N : ℝ) : Prop :=
  ∀ c : ℝ, ((Efin.filter (fun t => c ≤ t ∧ t < c + δ)).card : ℝ) ≤ N

theorem schur_sum_le {Efin : Finset ℝ} {δ N : ℝ} (hδ : 0 < δ) (hNnn : 0 ≤ N)
    (hN : IsIntervalCount Efin δ N) (t : ℝ) :
    ∑ t' ∈ Efin, ((1 + |t - t'| / δ) ^ 2)⁻¹ ≤ 12 * N := by
  classical
  set kof : ℝ → ℤ := fun t' => ⌊(t' - t) / δ⌋ with hkof
  have hmaps : ∀ t' ∈ Efin, kof t' ∈ Efin.image kof := fun t' h => Finset.mem_image_of_mem _ h
  rw [← Finset.sum_fiberwise_of_maps_to hmaps]
  have hfiber : ∀ k ∈ Efin.image kof,
      (∑ t' ∈ Efin.filter (fun t' => kof t' = k), ((1 + |t - t'| / δ) ^ 2)⁻¹)
        ≤ N * (4 * (((1 : ℝ) + |(k : ℝ)|) ^ 2)⁻¹) := by
    intro k _
    have hmem : ∀ t' ∈ Efin.filter (fun t' => kof t' = k),
        (k : ℝ) * δ ≤ t' - t ∧ t' - t < ((k : ℝ) + 1) * δ := by
      intro t' ht'
      have hk : kof t' = k := (Finset.mem_filter.mp ht').2
      have hfl : ((k : ℝ) ≤ (t' - t) / δ) ∧ ((t' - t) / δ < (k : ℝ) + 1) := by
        have h := Int.floor_eq_iff.mp hk
        exact ⟨by exact_mod_cast h.1, by exact_mod_cast h.2⟩
      constructor
      · rw [le_div_iff₀ hδ] at hfl
        linarith [hfl.1]
      · rw [div_lt_iff₀ hδ] at hfl
        linarith [hfl.2]
    have hterm : ∀ t' ∈ Efin.filter (fun t' => kof t' = k),
        ((1 + |t - t'| / δ) ^ 2)⁻¹ ≤ 4 * (((1 : ℝ) + |(k : ℝ)|) ^ 2)⁻¹ := by
      intro t' ht'
      obtain ⟨hlo, hhi⟩ := hmem t' ht'
      have habs : |t - t'| / δ = |t' - t| / δ := by rw [abs_sub_comm]
      have hkey : ((1 : ℝ) + |(k : ℝ)|) / 2 ≤ 1 + |t - t'| / δ := by
        rw [habs]
        rcases le_or_gt 0 (k : ℝ) with hk0 | hk0
        · have h1 : (k : ℝ) * δ ≤ |t' - t| := le_trans hlo (le_abs_self _)
          have h2 : (k : ℝ) ≤ |t' - t| / δ := by
            rw [le_div_iff₀ hδ]
            linarith
          rw [abs_of_nonneg hk0]
          linarith
        · have h1 : -(t' - t) > -((k : ℝ) + 1) * δ := by nlinarith
          have h2 : |t' - t| ≥ -(t' - t) := neg_le_abs _
          have h3 : -((k : ℝ) + 1) ≤ |t' - t| / δ := by
            rw [le_div_iff₀ hδ]
            nlinarith
          rw [abs_of_neg hk0]
          have hkle : (1 : ℝ) ≤ -(k : ℝ) := by
            have hkz : k < 0 := by exact_mod_cast hk0
            have hkm : k ≤ -1 := by omega
            have hkr : ((k : ℝ)) ≤ -1 := by exact_mod_cast hkm
            linarith
          linarith
      have hposk : (0 : ℝ) < ((1 : ℝ) + |(k : ℝ)|) / 2 := by positivity
      have hsq : (((1 : ℝ) + |(k : ℝ)|) / 2) ^ 2 ≤ (1 + |t - t'| / δ) ^ 2 := by
        refine pow_le_pow_left₀ hposk.le hkey 2
      have hposq : (0 : ℝ) < (((1 : ℝ) + |(k : ℝ)|) / 2) ^ 2 := by positivity
      have hstep : ((1 + |t - t'| / δ) ^ 2)⁻¹ ≤ ((((1 : ℝ) + |(k : ℝ)|) / 2) ^ 2)⁻¹ :=
        inv_anti₀ hposq hsq
      refine le_trans hstep (le_of_eq ?_)
      have hne : ((1 : ℝ) + |(k : ℝ)|) ≠ 0 := by positivity
      field_simp
      ring
    refine le_trans (Finset.sum_le_sum hterm) ?_
    rw [Finset.sum_const, nsmul_eq_mul]
    refine mul_le_mul_of_nonneg_right ?_ (by positivity)
    have hsub : Efin.filter (fun t' => kof t' = k)
        ⊆ Efin.filter (fun t' => t + (k : ℝ) * δ ≤ t' ∧ t' < t + (k : ℝ) * δ + δ) := by
      intro t' ht'
      obtain ⟨hlo, hhi⟩ := hmem t' ht'
      refine Finset.mem_filter.mpr ⟨(Finset.mem_filter.mp ht').1, ?_, ?_⟩
      · linarith
      · nlinarith
    have hcard := Finset.card_le_card hsub
    have h2 : ((Efin.filter (fun t' => kof t' = k)).card : ℝ)
        ≤ ((Efin.filter (fun t' => t + (k : ℝ) * δ ≤ t' ∧
            t' < t + (k : ℝ) * δ + δ)).card : ℝ) := by exact_mod_cast hcard
    exact le_trans h2 (hN (t + (k : ℝ) * δ))
  refine le_trans (Finset.sum_le_sum hfiber) ?_
  have hpull : (∑ k ∈ Efin.image kof, N * (4 * (((1 : ℝ) + |(k : ℝ)|) ^ 2)⁻¹))
      = 4 * N * ∑ k ∈ Efin.image kof, (((1 : ℝ) + |(k : ℝ)|) ^ 2)⁻¹ := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hpull]
  have hsum := Auto.CalderonVaillancourt.sum_finset_int_inv_sq_le (Efin.image kof)
  have hnn : (0 : ℝ) ≤ 4 * N := by linarith
  calc 4 * N * ∑ k ∈ Efin.image kof, (((1 : ℝ) + |(k : ℝ)|) ^ 2)⁻¹
      ≤ 4 * N * 3 := mul_le_mul_of_nonneg_left hsum hnn
    _ = 12 * N := by ring

end Schur


/-! ## Almost orthogonality in a Hilbert space

The `TT*` step of §4.3, in the form of a Schur bound for a Gram matrix: if every row sum of the
Gram matrix of a finite family `v` is at most `A`, then `∑ |⟪v i, x⟫|² ≤ A ‖x‖²`.
-/

section GramSchur

variable {E : Type*} [NormedAddCommGroup E] [InnerProductSpace ℂ E]

theorem sum_norm_inner_sq_le {ι : Type*} (s : Finset ι) (v : ι → E) (x : E) {A : ℝ}
    (hAnn : 0 ≤ A)
    (hA : ∀ i ∈ s, ∑ i' ∈ s, ‖(inner ℂ (v i) (v i') : ℂ)‖ ≤ A) :
    ∑ i ∈ s, ‖(inner ℂ (v i) x : ℂ)‖ ^ 2 ≤ A * ‖x‖ ^ 2 := by
  classical
  set c : ι → ℂ := fun i => (inner ℂ (v i) x : ℂ) with hcdef
  set w : E := ∑ i ∈ s, c i • v i with hwdef
  set Sg : ℝ := ∑ i ∈ s, ‖c i‖ ^ 2 with hSgdef
  have hSgnn : 0 ≤ Sg := by
    rw [hSgdef]
    positivity
  -- Step 1: `⟪w, x⟫ = Sg`
  have hinner : (inner ℂ w x : ℂ) = ((Sg : ℝ) : ℂ) := by
    rw [hwdef, sum_inner, hSgdef]
    push_cast
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [inner_smul_left]
    have hci : (inner ℂ (v i) x : ℂ) = c i := rfl
    rw [hci, RCLike.conj_mul]
    norm_cast
  have hcs1 : Sg ≤ ‖w‖ * ‖x‖ := by
    have h1 : Sg = ‖(inner ℂ w x : ℂ)‖ := by
      rw [hinner, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hSgnn]
    rw [h1]
    exact norm_inner_le_norm w x
  -- Step 2: `‖w‖² ≤ A * Sg`
  set aa : ι → ι → ℝ := fun i i' => ‖(inner ℂ (v i) (v i') : ℂ)‖ with haadef
  have hsymm : ∀ i i', aa i i' = aa i' i := by
    intro i i'
    rw [haadef]
    simp only
    rw [← inner_conj_symm (v i) (v i'), RCLike.norm_conj]
  have hww : (inner ℂ w w : ℂ)
      = ∑ i ∈ s, ∑ i' ∈ s, (starRingEnd ℂ) (c i) * (c i' * (inner ℂ (v i) (v i') : ℂ)) := by
    rw [hwdef, sum_inner]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [inner_smul_left, inner_sum, Finset.mul_sum]
    refine Finset.sum_congr rfl fun i' _ => ?_
    rw [inner_smul_right]
  have hnormw : ‖w‖ ^ 2 = ‖(inner ℂ w w : ℂ)‖ := by
    rw [inner_self_eq_norm_sq_to_K]
    simp
  have hbound : ‖w‖ ^ 2 ≤ ∑ i ∈ s, ∑ i' ∈ s, aa i i' * (‖c i‖ * ‖c i'‖) := by
    rw [hnormw, hww]
    refine le_trans (norm_sum_le _ _) ?_
    refine Finset.sum_le_sum fun i _ => ?_
    refine le_trans (norm_sum_le _ _) ?_
    refine Finset.sum_le_sum fun i' _ => ?_
    rw [norm_mul, norm_mul, RCLike.norm_conj, haadef]
    ring_nf
    exact le_refl _
  -- the Schur step
  have hschur : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * (‖c i‖ * ‖c i'‖)) ≤ A * Sg := by
    have hamgm : ∀ i ∈ s, ∀ i' ∈ s, aa i i' * (‖c i‖ * ‖c i'‖)
        ≤ aa i i' * ((‖c i‖ ^ 2 + ‖c i'‖ ^ 2) / 2) := by
      intro i _ i' _
      refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
      nlinarith [sq_nonneg (‖c i‖ - ‖c i'‖)]
    have hstep1 : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * (‖c i‖ * ‖c i'‖))
        ≤ ∑ i ∈ s, ∑ i' ∈ s, aa i i' * ((‖c i‖ ^ 2 + ‖c i'‖ ^ 2) / 2) := by
      refine Finset.sum_le_sum fun i hi => ?_
      exact Finset.sum_le_sum fun i' hi' => hamgm i hi i' hi'
    have hsplit : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ((‖c i‖ ^ 2 + ‖c i'‖ ^ 2) / 2))
        = (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ‖c i‖ ^ 2) / 2
          + (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ‖c i'‖ ^ 2) / 2 := by
      rw [Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [Finset.sum_div, Finset.sum_div, ← Finset.sum_add_distrib]
      refine Finset.sum_congr rfl fun i' _ => ?_
      ring
    have hT1 : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ‖c i‖ ^ 2) ≤ A * Sg := by
      have hrw : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ‖c i‖ ^ 2)
          = ∑ i ∈ s, (∑ i' ∈ s, aa i i') * ‖c i‖ ^ 2 := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.sum_mul]
      rw [hrw, hSgdef, Finset.mul_sum]
      refine Finset.sum_le_sum fun i hi => ?_
      exact mul_le_mul_of_nonneg_right (hA i hi) (by positivity)
    have hT2 : (∑ i ∈ s, ∑ i' ∈ s, aa i i' * ‖c i'‖ ^ 2) ≤ A * Sg := by
      rw [Finset.sum_comm]
      have hrw : (∑ i' ∈ s, ∑ i ∈ s, aa i i' * ‖c i'‖ ^ 2)
          = ∑ i' ∈ s, (∑ i ∈ s, aa i' i) * ‖c i'‖ ^ 2 := by
        refine Finset.sum_congr rfl fun i' _ => ?_
        rw [Finset.sum_mul]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [hsymm i i']
      rw [hrw, hSgdef, Finset.mul_sum]
      refine Finset.sum_le_sum fun i' hi' => ?_
      exact mul_le_mul_of_nonneg_right (hA i' hi') (by positivity)
    linarith [hstep1, hsplit, hT1, hT2]
  have hw2 : ‖w‖ ^ 2 ≤ A * Sg := le_trans hbound hschur
  -- Step 3: conclude
  rcases eq_or_lt_of_le hSgnn with hz | hpos
  · rw [← hz]
    exact mul_nonneg hAnn (by positivity)
  · have hsq : Sg ^ 2 ≤ (‖w‖ * ‖x‖) ^ 2 := by
      refine pow_le_pow_left₀ hSgnn hcs1 2
    have hstep : Sg ^ 2 ≤ (A * Sg) * ‖x‖ ^ 2 := by
      calc Sg ^ 2 ≤ (‖w‖ * ‖x‖) ^ 2 := hsq
        _ = ‖w‖ ^ 2 * ‖x‖ ^ 2 := by ring
        _ ≤ (A * Sg) * ‖x‖ ^ 2 := mul_le_mul_of_nonneg_right hw2 (by positivity)
    have hfin : Sg ≤ A * ‖x‖ ^ 2 := by
      have hSgpos : 0 < Sg := hpos
      nlinarith [hstep, hSgpos]
    exact hfin

end GramSchur


/-! ## The `TT*` reduction of §4.3

For each fixed `ξ` the operators `S[·, b](ξ, t)`, `t ∈ ℰ`, are the inner products of the fixed
function `η ↦ 𝓕F(ξ - η, η)` against the kernels `Kern t ξ`.  The Gram matrix of the kernels is
`∫ Kern t ξ η · conj (Kern t' ξ η) dη`, so a Schur bound on it gives the `L²` estimate.
-/

section TTStar

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}

/-- The kernel of `S[·, b](·, t)`. -/
def Kern (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (t : ℝ) (ξ η : Pl) : ℂ := phase ε t ξ η * b t ξ η

theorem norm_Kern (ε t : ℝ) (ξ η : Pl) : ‖Kern ε b t ξ η‖ = ‖b t ξ η‖ := by
  rw [Kern, norm_mul, norm_phase, one_mul]

theorem continuous_phase_right (ε t : ℝ) (ξ : Pl) : Continuous fun η => phase ε t ξ η := by
  refine Complex.continuous_exp.comp ?_
  refine Continuous.mul ?_ continuous_const
  refine Complex.continuous_ofReal.comp ?_
  exact continuous_const.mul ((continuous_const.sub continuous_id).norm.add continuous_norm)

theorem measurable_Kern (hb : IsAdapted j m b) (ε t : ℝ) (ξ : Pl) :
    Measurable (Kern ε b t ξ) :=
  ((continuous_phase_right ε t ξ).measurable).mul (hb.meas t ξ)

theorem Kern_eq_zero (hb : IsAdapted j m b) (ε t : ℝ) (ξ η : Pl)
    (h : η ∉ SuppSet j m ξ) : Kern ε b t ξ η = 0 := by
  rw [Kern, hb.supp t ξ η h, mul_zero]

theorem memLp_Kern (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hB : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) : MemLp (Kern ε b t ξ) 2 (volume : Measure Pl) := by
  classical
  refine ⟨(measurable_Kern hb ε t ξ).aestronglyMeasurable, ?_⟩
  rw [Auto.CalderonVaillancourt.eLpNorm_two_eq_sqMass_rpow]
  refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) ?_
  rw [Auto.CalderonVaillancourt.sqMass]
  have hmono : ∀ η : Pl, ‖Kern ε b t ξ η‖ₑ ^ (2 : ℝ)
      ≤ Set.indicator (SuppSet j m ξ) (fun _ => ENNReal.ofReal B ^ (2 : ℝ)) η := by
    intro η
    by_cases hη : η ∈ SuppSet j m ξ
    · rw [Set.indicator_of_mem hη]
      refine ENNReal.rpow_le_rpow ?_ (by norm_num)
      rw [← ofReal_norm, norm_Kern]
      exact ENNReal.ofReal_le_ofReal (hbB t ξ η)
    · rw [Set.indicator_of_notMem hη, Kern_eq_zero hb ε t ξ η hη]
      simp
  refine ne_of_lt (lt_of_le_of_lt (lintegral_mono hmono) ?_)
  rw [lintegral_indicator (measurableSet_SuppSet j m ξ), setLIntegral_const]
  refine ENNReal.mul_lt_top (ENNReal.rpow_lt_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top) ?_
  exact lt_of_le_of_lt (volume_SuppSet_le j m ξ) ENNReal.ofReal_lt_top

theorem memLp_conj_Kern (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hB : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) :
    MemLp (fun η => (starRingEnd ℂ) (Kern ε b t ξ η)) 2 (volume : Measure Pl) := by
  have h := memLp_Kern hb hbB hB ε t ξ
  refine ⟨(Complex.continuous_conj.comp_aestronglyMeasurable h.1), ?_⟩
  have heq : eLpNorm (fun η => (starRingEnd ℂ) (Kern ε b t ξ η)) 2 (volume : Measure Pl)
      = eLpNorm (Kern ε b t ξ) 2 (volume : Measure Pl) := by
    refine eLpNorm_congr_norm_ae (Filter.Eventually.of_forall fun η => ?_)
    rw [RCLike.norm_conj]
  rw [heq]
  exact h.2

/-- The inner product of the conjugate kernel against a fixed `L²` function is the operator. -/
theorem inner_conj_Kern_toLp (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hB : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) {H : Pl → ℂ} (hH : MemLp H 2 (volume : Measure Pl)) :
    (inner ℂ ((memLp_conj_Kern hb hbB hB ε t ξ).toLp _) (hH.toLp H) : ℂ)
      = ∫ η, Kern ε b t ξ η * H η := by
  rw [MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [(memLp_conj_Kern hb hbB hB ε t ξ).coeFn_toLp, hH.coeFn_toLp] with η h1 h2
  rw [h1, h2, RCLike.inner_apply]
  simp only [Complex.conj_conj]
  ring

/-- The Gram matrix of the conjugate kernels. -/
theorem inner_conj_Kern_conj_Kern (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (hB : 0 ≤ B) (ε t t' : ℝ) (ξ : Pl) :
    (inner ℂ ((memLp_conj_Kern hb hbB hB ε t ξ).toLp _)
        ((memLp_conj_Kern hb hbB hB ε t' ξ).toLp _) : ℂ)
      = ∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η) := by
  rw [MeasureTheory.L2.inner_def]
  refine integral_congr_ae ?_
  filter_upwards [(memLp_conj_Kern hb hbB hB ε t ξ).coeFn_toLp,
    (memLp_conj_Kern hb hbB hB ε t' ξ).coeFn_toLp] with η h1 h2
  rw [h1, h2, RCLike.inner_apply]
  simp only [Complex.conj_conj]
  ring

theorem enorm_rpow_two (z : ℂ) : ‖z‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (‖z‖ ^ 2) := by
  have h1 : ENNReal.ofReal (‖z‖ ^ 2) = ENNReal.ofReal ‖z‖ ^ (2 : ℝ) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    rw [← Real.rpow_natCast ‖z‖ 2]
    norm_num
  rw [h1, ofReal_norm]

theorem enn_rpow_two_eq (x : ℝ≥0∞) (hx : x ≠ ⊤) :
    x ^ (2 : ℝ) = ENNReal.ofReal (x.toReal ^ 2) := by
  have h1 : ENNReal.ofReal (x.toReal ^ 2) = ENNReal.ofReal x.toReal ^ (2 : ℝ) := by
    rw [ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    rw [← Real.rpow_natCast x.toReal 2]
    norm_num
  rw [h1, ENNReal.ofReal_toReal hx]

theorem sum_lintegral_le_lintegral_sum {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {ι : Type*} (s : Finset ι) (f : ι → α → ℝ≥0∞) :
    (∑ i ∈ s, ∫⁻ a, f i a ∂μ) ≤ ∫⁻ a, ∑ i ∈ s, f i a ∂μ := by
  classical
  induction s using Finset.cons_induction with
  | empty => simp
  | cons i t hi ih =>
      rw [Finset.sum_cons]
      have hpt : ∀ a, ∑ k ∈ Finset.cons i t hi, f k a = f i a + ∑ k ∈ t, f k a := by
        intro a
        rw [Finset.sum_cons]
      rw [lintegral_congr hpt]
      calc (∫⁻ a, f i a ∂μ) + ∑ k ∈ t, ∫⁻ a, f k a ∂μ
          ≤ (∫⁻ a, f i a ∂μ) + ∫⁻ a, ∑ k ∈ t, f k a ∂μ := add_le_add (le_refl _) ih
        _ ≤ ∫⁻ a, (f i a + ∑ k ∈ t, f k a) ∂μ := le_lintegral_add _ _

/-- The pointwise (in `ξ`) `TT*` bound, in real form. -/
theorem sum_sq_SopK_pointwise (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (hB : 0 ≤ B) (ε : ℝ) (Efin : Finset ℝ) {G : Pl2 → ℂ} {A : ℝ} (hAnn : 0 ≤ A) (ξ : Pl)
    (hA : ∀ t ∈ Efin, ∑ t' ∈ Efin,
        ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖ ≤ A)
    (hH : MemLp (fun η => G (pr (ξ - η) η)) 2 (volume : Measure Pl)) :
    ∑ t ∈ Efin, ‖SopK ε b G ξ t‖ ^ 2
      ≤ A * (eLpNorm (fun η => G (pr (ξ - η) η)) 2 (volume : Measure Pl)).toReal ^ 2 := by
  classical
  set v : ℝ → Lp ℂ 2 (volume : Measure Pl) :=
    fun t => (memLp_conj_Kern hb hbB hB ε t ξ).toLp _ with hvdef
  have hgram : ∀ t ∈ Efin, ∑ t' ∈ Efin, ‖(inner ℂ (v t) (v t') : ℂ)‖ ≤ A := by
    intro t ht
    refine le_trans (le_of_eq ?_) (hA t ht)
    refine Finset.sum_congr rfl fun t' _ => ?_
    rw [hvdef]
    rw [inner_conj_Kern_conj_Kern hb hbB hB ε t t' ξ]
  have hkey := sum_norm_inner_sq_le Efin v (hH.toLp _) hAnn hgram
  have hval : ∀ t : ℝ, (inner ℂ (v t) (hH.toLp _) : ℂ) = SopK ε b G ξ t := by
    intro t
    rw [hvdef, inner_conj_Kern_toLp hb hbB hB ε t ξ hH]
    rfl
  have hlhs : (∑ t ∈ Efin, ‖(inner ℂ (v t) (hH.toLp _) : ℂ)‖ ^ 2)
      = ∑ t ∈ Efin, ‖SopK ε b G ξ t‖ ^ 2 := by
    refine Finset.sum_congr rfl fun t _ => ?_
    rw [hval t]
  rw [hlhs] at hkey
  rw [Lp.norm_toLp] at hkey
  exact hkey

/-- The pointwise `TT*` bound in extended-real form. -/
theorem sum_enorm_sq_SopK_pointwise (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (hB : 0 ≤ B) (ε : ℝ) (Efin : Finset ℝ) {G : Pl2 → ℂ} (hGm : Measurable G) {A : ℝ}
    (hApos : 0 < A) (ξ : Pl)
    (hA : ∀ t ∈ Efin, ∑ t' ∈ Efin,
        ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖ ≤ A) :
    (∑ t ∈ Efin, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal A * ∫⁻ η : Pl, ‖G (pr (ξ - η) η)‖ₑ ^ (2 : ℝ) := by
  classical
  set H : Pl → ℂ := fun η => G (pr (ξ - η) η) with hHdef
  have hHmeas : Measurable H := by
    have h1 : Measurable fun η : Pl => (pr (ξ - η) η : Pl2) := by
      have h2 : Measurable fun η : Pl => ((ξ - η : Pl), (η : Pl)) :=
        (measurable_const.sub measurable_id).prodMk measurable_id
      exact (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp h2
    exact hGm.comp h1
  have hmass : Auto.CalderonVaillancourt.sqMass (volume : Measure Pl) H
      = ∫⁻ η : Pl, ‖H η‖ₑ ^ (2 : ℝ) := rfl
  have hA0 : ENNReal.ofReal A ≠ 0 := by
    simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    exact hApos
  by_cases htop : (∫⁻ η : Pl, ‖H η‖ₑ ^ (2 : ℝ)) = ⊤
  · rw [htop, ENNReal.mul_top hA0]
    exact le_top
  · have hlp : MemLp H 2 (volume : Measure Pl) := by
      refine ⟨hHmeas.aestronglyMeasurable, ?_⟩
      rw [Auto.CalderonVaillancourt.eLpNorm_two_eq_sqMass_rpow]
      exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) (by rw [hmass]; exact htop)
    have hreal := sum_sq_SopK_pointwise hb hbB hB ε Efin hApos.le ξ hA hlp
    have hfin : eLpNorm H 2 (volume : Measure Pl) ≠ ⊤ := hlp.2.ne
    -- rewrite the left side
    have hL : (∑ t ∈ Efin, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
        = ENNReal.ofReal (∑ t ∈ Efin, ‖SopK ε b G ξ t‖ ^ 2) := by
      rw [ENNReal.ofReal_sum_of_nonneg (fun t _ => by positivity)]
      refine Finset.sum_congr rfl fun t _ => ?_
      exact enorm_rpow_two _
    -- rewrite the right side
    have hR : (∫⁻ η : Pl, ‖H η‖ₑ ^ (2 : ℝ))
        = ENNReal.ofReal ((eLpNorm H 2 (volume : Measure Pl)).toReal ^ 2) := by
      rw [← hmass, Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow]
      exact enn_rpow_two_eq _ hfin
    rw [hL, hR, ← ENNReal.ofReal_mul hApos.le]
    exact ENNReal.ofReal_le_ofReal hreal

/-- The `L²` bound for `S[·, b]` coming from a Schur bound on the Gram matrix of the kernels. -/
theorem sum_lintegral_SopK_le (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (hB : 0 ≤ B) (ε : ℝ) (Efin : Finset ℝ) {G : Pl2 → ℂ} (hGm : Measurable G) {A : ℝ}
    (hApos : 0 < A)
    (hA : ∀ ξ : Pl, ∀ t ∈ Efin, ∑ t' ∈ Efin,
        ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖ ≤ A) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal A * ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
  have hstep1 := sum_lintegral_le_lintegral_sum Efin
    (fun t ξ => ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ)) (μ := (volume : Measure Pl))
  refine le_trans hstep1 ?_
  have hstep2 : (∫⁻ ξ : Pl, ∑ t ∈ Efin, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ∫⁻ ξ : Pl, ENNReal.ofReal A * ∫⁻ η : Pl, ‖G (pr (ξ - η) η)‖ₑ ^ (2 : ℝ) :=
    lintegral_mono fun ξ =>
      sum_enorm_sq_SopK_pointwise hb hbB hB ε Efin hGm hApos ξ (hA ξ)
  refine le_trans hstep2 ?_
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine mul_le_mul' (le_refl _) (le_of_eq ?_)
  exact lintegral_pr_shift (fun x => ‖G x‖ₑ ^ (2 : ℝ)) ((hGm.enorm).pow_const _)

end TTStar



/-! ## Strict adaptedness and the polar frame -/

section Frame

/-- The `η`-support of a strictly `(j,m)`-adapted symbol: the angle is also bounded below. -/
def SuppSetStrict (j m : ℕ) (ξ : Pl) : Set Pl :=
  {η | η ∈ SuppSet j m ξ ∧ (2 : ℝ) ^ (-(m : ℤ) - 5) ≤ InnerProductGeometry.angle ξ η}

theorem SuppSetStrict_subset (j m : ℕ) (ξ : Pl) : SuppSetStrict j m ξ ⊆ SuppSet j m ξ :=
  fun _ h => h.1

/-- A strictly `(j,m)`-adapted symbol. -/
structure IsStrictlyAdapted (j m : ℕ) (b : ℝ → Pl → Pl → ℂ) : Prop where
  meas : ∀ t ξ, Measurable (b t ξ)
  supp : ∀ t ξ η, η ∉ SuppSetStrict j m ξ → b t ξ η = 0

theorem IsStrictlyAdapted.toIsAdapted {j m : ℕ} {b : ℝ → Pl → Pl → ℂ}
    (h : IsStrictlyAdapted j m b) : IsAdapted j m b :=
  ⟨h.meas, fun t ξ η hη => h.supp t ξ η fun hs => hη (SuppSetStrict_subset j m ξ hs)⟩

/-- The data on `ξ` implied by a nonempty support. -/
structure XiData (j : ℕ) (ξ : Pl) : Prop where
  lower : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ξ 1
  norm_le : ‖ξ‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2)
  cone0 : 0 < ξ 0
  cone : ξ 0 < (2 : ℝ) ^ (-(10 : ℤ)) * ξ 1

theorem XiData.snd_pos {j : ℕ} {ξ : Pl} (h : XiData j ξ) : 0 < ξ 1 :=
  lt_of_lt_of_le (by positivity) h.lower

theorem XiData.norm_lower {j : ℕ} {ξ : Pl} (h : XiData j ξ) :
    (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ξ‖ := by
  refine le_trans h.lower ?_
  have hsq : ξ 1 ^ 2 ≤ ‖ξ‖ ^ 2 := by
    rw [norm_sq_two]
    nlinarith [sq_nonneg (ξ 0)]
  nlinarith [norm_nonneg ξ, h.snd_pos]

theorem xiData_of_mem {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) : XiData j ξ := by
  obtain ⟨hηT, hξηT, -⟩ := h
  have hsub0 : (ξ - η) 0 = ξ 0 - η 0 := by simp [PiLp.sub_apply]
  have hsub1 : (ξ - η) 1 = ξ 1 - η 1 := by simp [PiLp.sub_apply]
  have hstep : (2 : ℝ) ^ ((j : ℤ) - 1) = 2 * (2 : ℝ) ^ ((j : ℤ) - 2) := by
    rw [show (j : ℤ) - 1 = 1 + ((j : ℤ) - 2) by ring, zpow_add₀ (two_ne_zero), zpow_one]
  refine ⟨?_, ?_, ?_, ?_⟩
  · have h1 := Theta.snd_lower hηT
    have h2 := Theta.snd_lower hξηT
    rw [hsub1] at h2
    rw [hstep]
    linarith
  · have he : (ξ - η) + η = ξ := by abel
    have h1 : ‖ξ‖ ≤ ‖ξ - η‖ + ‖η‖ := by
      have h := norm_add_le (ξ - η) η
      rw [he] at h
      exact h
    have h2 := Theta.norm_le hξηT
    have h3 := Theta.norm_le hηT
    have hstep2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 2 * (2 : ℝ) ^ ((j : ℤ) + 1) := by
      rw [show (j : ℤ) + 2 = 1 + ((j : ℤ) + 1) by ring, zpow_add₀ (two_ne_zero), zpow_one]
    rw [hstep2]
    linarith
  · have h1 := hηT.1
    have h2 := hξηT.1
    rw [hsub0] at h2
    linarith
  · have h1 := hηT.2.1
    have h2 := hξηT.2.1
    rw [hsub0, hsub1] at h2
    have hc : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
    nlinarith

/-- The discriminant of the elliptic phase in terms of the angle. -/
theorem disc_eq (ξ θ : Pl) (hθ : ‖θ‖ = 1) :
    ‖ξ‖ ^ 2 - inner ℝ ξ θ ^ 2
      = ‖ξ‖ ^ 2 * Real.sin (InnerProductGeometry.angle ξ θ) ^ 2 := by
  have hlag := lagrange ξ θ
  have hsin := sin_angle_eq ξ θ
  rw [hθ] at hlag hsin
  simp only [one_pow, mul_one] at hlag hsin
  have h2 : (Real.sin (InnerProductGeometry.angle ξ θ) * ‖ξ‖) ^ 2 = det2 ξ θ ^ 2 := by
    rw [hsin, sq_abs]
  rw [← hlag, ← h2]
  ring

/-- The elliptic phase computed in the polar frame. -/
theorem gf_eq_norm (ξ θ : Pl) (hθ : ‖θ‖ = 1) (ρ : ℝ) :
    gf (inner ℝ ξ θ) ‖ξ‖ ρ = ‖ξ - ρ • θ‖ := by
  have hsq : ‖ξ - ρ • θ‖ ^ 2 = qf (inner ℝ ξ θ) ‖ξ‖ ρ := by
    rw [qf, norm_sub_sq_real, real_inner_smul_right, norm_smul, hθ, mul_one,
      Real.norm_eq_abs, sq_abs]
    ring
  rw [gf, ← hsq, Real.sqrt_sq (norm_nonneg _)]

theorem tauf_eq_phase (ξ θ : Pl) (hθ : ‖θ‖ = 1) {ρ : ℝ} (hρ : 0 ≤ ρ) :
    tauf (inner ℝ ξ θ) ‖ξ‖ ρ = ‖ξ - ρ • θ‖ + ‖ρ • θ‖ := by
  rw [tauf, gf_eq_norm ξ θ hθ, norm_smul, hθ, mul_one, Real.norm_eq_abs, abs_of_nonneg hρ]

end Frame


/-! ## The amplitude after two integrations by parts

All four combinations of phase derivatives that occur are bounded by powers of `g` over the
discriminant `D`.
-/

section CfunBound

variable {a R : ℝ}

theorem inv_tauf1_le' (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    (tauf1 a R ρ)⁻¹ ≤ 2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) := inv_tauf1_le hD ρ

theorem ratio2_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    |tauf2 a R ρ| / tauf1 a R ρ ^ 2 ≤ 4 * gf a R ρ / (R ^ 2 - a ^ 2) := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have h2 := tauf2_abs_le hD ρ
  have hP := inv_tauf1_le hD ρ
  have hstep : |tauf2 a R ρ| / tauf1 a R ρ ^ 2 ≤ (2 / gf a R ρ) * (tauf1 a R ρ)⁻¹ := by
    rw [div_le_iff₀ (by positivity : (0 : ℝ) < tauf1 a R ρ ^ 2)]
    have hexp : 2 / gf a R ρ * (tauf1 a R ρ)⁻¹ * tauf1 a R ρ ^ 2
        = 2 / gf a R ρ * tauf1 a R ρ := by
      field_simp
    rw [hexp]
    exact h2
  refine le_trans hstep ?_
  have hmul : (2 / gf a R ρ) * (tauf1 a R ρ)⁻¹
      ≤ (2 / gf a R ρ) * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul_of_nonneg_left hP (by positivity)
  refine le_trans hmul (le_of_eq ?_)
  field_simp
  ring

theorem ratio3_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    |tauf3 a R ρ| / tauf1 a R ρ ^ 2 ≤ 12 / (R ^ 2 - a ^ 2) := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have h3 := tauf3_abs_le hD ρ
  have hP := inv_tauf1_le hD ρ
  have hstep : |tauf3 a R ρ| / tauf1 a R ρ ^ 2 ≤ (6 / gf a R ρ ^ 2) * (tauf1 a R ρ)⁻¹ := by
    rw [div_le_iff₀ (by positivity : (0 : ℝ) < tauf1 a R ρ ^ 2)]
    have hexp : 6 / gf a R ρ ^ 2 * (tauf1 a R ρ)⁻¹ * tauf1 a R ρ ^ 2
        = 6 / gf a R ρ ^ 2 * tauf1 a R ρ := by
      field_simp
    rw [hexp]
    exact h3
  refine le_trans hstep ?_
  have hmul : (6 / gf a R ρ ^ 2) * (tauf1 a R ρ)⁻¹
      ≤ (6 / gf a R ρ ^ 2) * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul_of_nonneg_left hP (by positivity)
  refine le_trans hmul (le_of_eq ?_)
  field_simp
  ring

theorem ratio22_le (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    |tauf2 a R ρ| ^ 2 / tauf1 a R ρ ^ 3 ≤ 8 / (R ^ 2 - a ^ 2) := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have h2 := tauf2_abs_le hD ρ
  have hP := inv_tauf1_le hD ρ
  have hsq : |tauf2 a R ρ| ^ 2 ≤ (2 / gf a R ρ) ^ 2 * tauf1 a R ρ ^ 2 := by
    have hnn : (0 : ℝ) ≤ 2 / gf a R ρ * tauf1 a R ρ := by positivity
    nlinarith [h2, abs_nonneg (tauf2 a R ρ)]
  have hstep : |tauf2 a R ρ| ^ 2 / tauf1 a R ρ ^ 3
      ≤ (2 / gf a R ρ) ^ 2 * (tauf1 a R ρ)⁻¹ := by
    rw [div_le_iff₀ (by positivity : (0 : ℝ) < tauf1 a R ρ ^ 3)]
    have hexp : (2 / gf a R ρ) ^ 2 * (tauf1 a R ρ)⁻¹ * tauf1 a R ρ ^ 3
        = (2 / gf a R ρ) ^ 2 * tauf1 a R ρ ^ 2 := by
      field_simp
    rw [hexp]
    exact hsq
  refine le_trans hstep ?_
  have hmul : (2 / gf a R ρ) ^ 2 * (tauf1 a R ρ)⁻¹
      ≤ (2 / gf a R ρ) ^ 2 * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul_of_nonneg_left hP (by positivity)
  refine le_trans hmul (le_of_eq ?_)
  field_simp
  ring

theorem norm_bfun_le (hD : 0 < R ^ 2 - a ^ 2) {A A1 : ℝ → ℂ} (ρ : ℝ) {MA MA1 : ℝ}
    (hA : ‖A ρ‖ ≤ MA) (hA1 : ‖A1 ρ‖ ≤ MA1) (hMA : 0 ≤ MA) (hMA1 : 0 ≤ MA1) :
    ‖bfun a R A A1 ρ‖
      ≤ 2 * MA1 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) + 4 * MA * gf a R ρ / (R ^ 2 - a ^ 2) := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have hTne : (tauf1 a R ρ : ℂ) ≠ 0 := cT_ne hD ρ
  have hn1 : ‖A1 ρ / (tauf1 a R ρ : ℂ)‖ = ‖A1 ρ‖ * (tauf1 a R ρ)⁻¹ := by
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hT, div_eq_mul_inv]
  have hn2 : ‖A ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
      = ‖A ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2) := by
    rw [norm_div, norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_pow, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hT]
    ring
  calc ‖bfun a R A A1 ρ‖
      ≤ ‖A1 ρ / (tauf1 a R ρ : ℂ)‖ + ‖A ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖ := by
        rw [bfun]; exact norm_sub_le _ _
    _ = ‖A1 ρ‖ * (tauf1 a R ρ)⁻¹ + ‖A ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2) := by
        rw [hn1, hn2]
    _ ≤ MA1 * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) + MA * (4 * gf a R ρ / (R ^ 2 - a ^ 2)) := by
        refine add_le_add ?_ ?_
        · exact mul_le_mul hA1 (inv_tauf1_le hD ρ) (by positivity) hMA1
        · exact mul_le_mul hA (ratio2_le hD ρ) (by positivity) hMA
    _ = 2 * MA1 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)
          + 4 * MA * gf a R ρ / (R ^ 2 - a ^ 2) := by ring

theorem norm_bfun1_le (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ} (ρ : ℝ) {MA MA1 MA2 : ℝ}
    (hA : ‖A ρ‖ ≤ MA) (hA1 : ‖A1 ρ‖ ≤ MA1) (hA2 : ‖A2 ρ‖ ≤ MA2)
    (hMA : 0 ≤ MA) (hMA1 : 0 ≤ MA1) (hMA2 : 0 ≤ MA2) :
    ‖bfun1 a R A A1 A2 ρ‖
      ≤ 2 * MA2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) + 8 * MA1 * gf a R ρ / (R ^ 2 - a ^ 2)
        + 28 * MA / (R ^ 2 - a ^ 2) := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have habsT : |tauf1 a R ρ| = tauf1 a R ρ := abs_of_pos hT
  have hn1 : ‖A2 ρ / (tauf1 a R ρ : ℂ)‖ = ‖A2 ρ‖ * (tauf1 a R ρ)⁻¹ := by
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, habsT, div_eq_mul_inv]
  have hn2 : ‖2 * A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
      = 2 * ‖A1 ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2) := by
    rw [norm_div, norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_pow,
      Complex.norm_real, Real.norm_eq_abs, habsT]
    norm_num
    ring
  have hn3 : ‖A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
      = ‖A ρ‖ * (|tauf3 a R ρ| / tauf1 a R ρ ^ 2) := by
    rw [norm_div, norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_pow, Complex.norm_real,
      Real.norm_eq_abs, habsT]
    ring
  have hn4 : ‖2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3‖
      = 2 * ‖A ρ‖ * (|tauf2 a R ρ| ^ 2 / tauf1 a R ρ ^ 3) := by
    rw [norm_div, norm_mul, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs, norm_pow,
      Complex.norm_real, Real.norm_eq_abs, habsT]
    norm_num
    ring
  have hsplit : ‖bfun1 a R A A1 A2 ρ‖
      ≤ ‖A2 ρ / (tauf1 a R ρ : ℂ)‖
        + ‖2 * A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
        + ‖A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
        + ‖2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3‖ := by
    rw [bfun1]
    refine le_trans (norm_add_le _ _) ?_
    refine add_le_add ?_ (le_refl _)
    refine le_trans (norm_sub_le _ _) ?_
    refine add_le_add ?_ (le_refl _)
    exact norm_sub_le _ _
  refine le_trans hsplit ?_
  rw [hn1, hn2, hn3, hn4]
  have hb1 : ‖A2 ρ‖ * (tauf1 a R ρ)⁻¹ ≤ MA2 * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul hA2 (inv_tauf1_le hD ρ) (by positivity) hMA2
  have hb2 : 2 * ‖A1 ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2)
      ≤ 2 * MA1 * (4 * gf a R ρ / (R ^ 2 - a ^ 2)) := by
    refine mul_le_mul (by linarith) (ratio2_le hD ρ) (by positivity) (by linarith)
  have hb3 : ‖A ρ‖ * (|tauf3 a R ρ| / tauf1 a R ρ ^ 2) ≤ MA * (12 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul hA (ratio3_le hD ρ) (by positivity) hMA
  have hb4 : 2 * ‖A ρ‖ * (|tauf2 a R ρ| ^ 2 / tauf1 a R ρ ^ 3)
      ≤ 2 * MA * (8 / (R ^ 2 - a ^ 2)) := by
    refine mul_le_mul (by linarith) (ratio22_le hD ρ) (by positivity) (by linarith)
  have hgoal : MA2 * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) + 2 * MA1 * (4 * gf a R ρ / (R ^ 2 - a ^ 2))
      + MA * (12 / (R ^ 2 - a ^ 2)) + 2 * MA * (8 / (R ^ 2 - a ^ 2))
      = 2 * MA2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) + 8 * MA1 * gf a R ρ / (R ^ 2 - a ^ 2)
        + 28 * MA / (R ^ 2 - a ^ 2) := by
    field_simp
    ring
  linarith [hb1, hb2, hb3, hb4, hgoal]

theorem norm_cfun_le (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ} (ρ : ℝ) {MA MA1 MA2 : ℝ}
    (hA : ‖A ρ‖ ≤ MA) (hA1 : ‖A1 ρ‖ ≤ MA1) (hA2 : ‖A2 ρ‖ ≤ MA2)
    (hMA : 0 ≤ MA) (hMA1 : 0 ≤ MA1) (hMA2 : 0 ≤ MA2) :
    ‖cfun a R A A1 A2 ρ‖
      ≤ (4 * MA2 * gf a R ρ ^ 4 + 24 * MA1 * gf a R ρ ^ 3 + 72 * MA * gf a R ρ ^ 2)
          / (R ^ 2 - a ^ 2) ^ 2 := by
  have hgpos : 0 < gf a R ρ := gf_pos hD ρ
  have hT : 0 < tauf1 a R ρ := tauf1_pos hD ρ
  have habsT : |tauf1 a R ρ| = tauf1 a R ρ := abs_of_pos hT
  have hb := norm_bfun_le hD ρ hA hA1 hMA hMA1
  have hb1 := norm_bfun1_le hD ρ hA hA1 hA2 hMA hMA1 hMA2
  have hn1 : ‖bfun1 a R A A1 A2 ρ / (tauf1 a R ρ : ℂ)‖
      = ‖bfun1 a R A A1 A2 ρ‖ * (tauf1 a R ρ)⁻¹ := by
    rw [norm_div, Complex.norm_real, Real.norm_eq_abs, habsT, div_eq_mul_inv]
  have hn2 : ‖bfun a R A A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2‖
      = ‖bfun a R A A1 ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2) := by
    rw [norm_div, norm_mul, Complex.norm_real, Real.norm_eq_abs, norm_pow, Complex.norm_real,
      Real.norm_eq_abs, habsT]
    ring
  have hsplit : ‖cfun a R A A1 A2 ρ‖
      ≤ ‖bfun1 a R A A1 A2 ρ‖ * (tauf1 a R ρ)⁻¹
        + ‖bfun a R A A1 ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2) := by
    rw [cfun, ← hn1, ← hn2]
    exact norm_sub_le _ _
  have hnn1 : (0 : ℝ) ≤ 2 * MA2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)
      + 8 * MA1 * gf a R ρ / (R ^ 2 - a ^ 2) + 28 * MA / (R ^ 2 - a ^ 2) := by positivity
  have hnn2 : (0 : ℝ) ≤ 2 * MA1 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)
      + 4 * MA * gf a R ρ / (R ^ 2 - a ^ 2) := by positivity
  have hstep1 : ‖bfun1 a R A A1 A2 ρ‖ * (tauf1 a R ρ)⁻¹
      ≤ (2 * MA2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)
          + 8 * MA1 * gf a R ρ / (R ^ 2 - a ^ 2) + 28 * MA / (R ^ 2 - a ^ 2))
        * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)) :=
    mul_le_mul hb1 (inv_tauf1_le hD ρ) (by positivity) hnn1
  have hstep2 : ‖bfun a R A A1 ρ‖ * (|tauf2 a R ρ| / tauf1 a R ρ ^ 2)
      ≤ (2 * MA1 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) + 4 * MA * gf a R ρ / (R ^ 2 - a ^ 2))
        * (4 * gf a R ρ / (R ^ 2 - a ^ 2)) :=
    mul_le_mul hb (ratio2_le hD ρ) (by positivity) hnn2
  have hid : (2 * MA2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2)
        + 8 * MA1 * gf a R ρ / (R ^ 2 - a ^ 2) + 28 * MA / (R ^ 2 - a ^ 2))
      * (2 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2))
      + (2 * MA1 * gf a R ρ ^ 2 / (R ^ 2 - a ^ 2) + 4 * MA * gf a R ρ / (R ^ 2 - a ^ 2))
        * (4 * gf a R ρ / (R ^ 2 - a ^ 2))
      = (4 * MA2 * gf a R ρ ^ 4 + 24 * MA1 * gf a R ρ ^ 3 + 72 * MA * gf a R ρ ^ 2)
          / (R ^ 2 - a ^ 2) ^ 2 := by
    have hDne : (R ^ 2 - a ^ 2) ≠ 0 := hD.ne'
    field_simp
    ring
  linarith [hsplit, hstep1, hstep2, hid]

end CfunBound



/-! ## The amplitude of the Gram integral along a ray

Along the ray of direction `φ` the Gram integrand is `b(t,ξ,·) · conj b(t',ξ,·)` times the polar
Jacobian `ρ`.  Its first two derivatives are written out explicitly.
-/

section Amplitude

/-- The product of two symbols along a ray, the second one conjugated. -/
def cprod (u v : ℝ → ℂ) (ρ : ℝ) : ℂ := u ρ * (starRingEnd ℂ) (v ρ)

/-- Its first derivative. -/
def cprod1 (u u1 v v1 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  u1 ρ * (starRingEnd ℂ) (v ρ) + u ρ * (starRingEnd ℂ) (v1 ρ)

/-- Its second derivative. -/
def cprod2 (u u1 u2 v v1 v2 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  u2 ρ * (starRingEnd ℂ) (v ρ) + 2 * (u1 ρ * (starRingEnd ℂ) (v1 ρ))
    + u ρ * (starRingEnd ℂ) (v2 ρ)

theorem hasDerivAt_conj {v v1 : ℝ → ℂ} (hv : ∀ ρ, HasDerivAt v (v1 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (fun y => (starRingEnd ℂ) (v y)) ((starRingEnd ℂ) (v1 ρ)) ρ := by
  have h := HasDerivAt.star (hv ρ)
  exact h

theorem hasDerivAt_cprod {u u1 v v1 : ℝ → ℂ}
    (hu : ∀ ρ, HasDerivAt u (u1 ρ) ρ) (hv : ∀ ρ, HasDerivAt v (v1 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (cprod u v) (cprod1 u u1 v v1 ρ) ρ :=
  (hu ρ).mul (hasDerivAt_conj hv ρ)

theorem hasDerivAt_cprod1 {u u1 u2 v v1 v2 : ℝ → ℂ}
    (hu : ∀ ρ, HasDerivAt u (u1 ρ) ρ) (hu1 : ∀ ρ, HasDerivAt u1 (u2 ρ) ρ)
    (hv : ∀ ρ, HasDerivAt v (v1 ρ) ρ) (hv1 : ∀ ρ, HasDerivAt v1 (v2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (cprod1 u u1 v v1) (cprod2 u u1 u2 v v1 v2 ρ) ρ := by
  have h1 := (hu1 ρ).mul (hasDerivAt_conj hv ρ)
  have h2 := (hu ρ).mul (hasDerivAt_conj hv1 ρ)
  have h := h1.add h2
  have heq : u2 ρ * (starRingEnd ℂ) (v ρ) + u1 ρ * (starRingEnd ℂ) (v1 ρ)
      + (u1 ρ * (starRingEnd ℂ) (v1 ρ) + u ρ * (starRingEnd ℂ) (v2 ρ))
      = cprod2 u u1 u2 v v1 v2 ρ := by
    rw [cprod2]
    ring
  rw [heq] at h
  exact h

theorem continuous_cprod2 {u u1 u2 v v1 v2 : ℝ → ℂ}
    (hu : Continuous u) (hu1 : Continuous u1) (hu2 : Continuous u2)
    (hv : Continuous v) (hv1 : Continuous v1) (hv2 : Continuous v2) :
    Continuous (cprod2 u u1 u2 v v1 v2) := by
  refine Continuous.add (Continuous.add ?_ ?_) ?_
  · exact hu2.mul (Complex.continuous_conj.comp hv)
  · exact continuous_const.mul (hu1.mul (Complex.continuous_conj.comp hv1))
  · exact hu.mul (Complex.continuous_conj.comp hv2)

theorem norm_cprod_le {u v : ℝ → ℂ} {Bu Bv : ℝ} (ρ : ℝ)
    (hu : ‖u ρ‖ ≤ Bu) (hv : ‖v ρ‖ ≤ Bv) (hBu : 0 ≤ Bu) :
    ‖cprod u v ρ‖ ≤ Bu * Bv := by
  rw [cprod, norm_mul, RCLike.norm_conj]
  exact mul_le_mul hu hv (norm_nonneg _) hBu

theorem norm_cprod1_le {u u1 v v1 : ℝ → ℂ} {Bu Bu1 Bv Bv1 : ℝ} (ρ : ℝ)
    (hu : ‖u ρ‖ ≤ Bu) (hu1 : ‖u1 ρ‖ ≤ Bu1) (hv : ‖v ρ‖ ≤ Bv) (hv1 : ‖v1 ρ‖ ≤ Bv1)
    (hBu : 0 ≤ Bu) (hBu1 : 0 ≤ Bu1) :
    ‖cprod1 u u1 v v1 ρ‖ ≤ Bu1 * Bv + Bu * Bv1 := by
  rw [cprod1]
  refine le_trans (norm_add_le _ _) ?_
  refine add_le_add ?_ ?_
  · rw [norm_mul, RCLike.norm_conj]
    exact mul_le_mul hu1 hv (norm_nonneg _) hBu1
  · rw [norm_mul, RCLike.norm_conj]
    exact mul_le_mul hu hv1 (norm_nonneg _) hBu

theorem norm_cprod2_le {u u1 u2 v v1 v2 : ℝ → ℂ} {Bu Bu1 Bu2 Bv Bv1 Bv2 : ℝ} (ρ : ℝ)
    (hu : ‖u ρ‖ ≤ Bu) (hu1 : ‖u1 ρ‖ ≤ Bu1) (hu2 : ‖u2 ρ‖ ≤ Bu2)
    (hv : ‖v ρ‖ ≤ Bv) (hv1 : ‖v1 ρ‖ ≤ Bv1) (hv2 : ‖v2 ρ‖ ≤ Bv2)
    (hBu : 0 ≤ Bu) (hBu1 : 0 ≤ Bu1) (hBu2 : 0 ≤ Bu2) :
    ‖cprod2 u u1 u2 v v1 v2 ρ‖ ≤ Bu2 * Bv + 2 * (Bu1 * Bv1) + Bu * Bv2 := by
  rw [cprod2]
  refine le_trans (norm_add_le _ _) ?_
  refine add_le_add (le_trans (norm_add_le _ _) (add_le_add ?_ ?_)) ?_
  · rw [norm_mul, RCLike.norm_conj]
    exact mul_le_mul hu2 hv (norm_nonneg _) hBu2
  · rw [norm_mul, norm_mul, RCLike.norm_conj]
    norm_num
    exact mul_le_mul hu1 hv1 (norm_nonneg _) hBu1
  · rw [norm_mul, RCLike.norm_conj]
    exact mul_le_mul hu hv2 (norm_nonneg _) hBu

/-- The polar amplitude `ρ ↦ ρ · c ρ`. -/
def ampl (c : ℝ → ℂ) (ρ : ℝ) : ℂ := (ρ : ℂ) * c ρ

/-- Its first derivative. -/
def ampl1 (c c1 : ℝ → ℂ) (ρ : ℝ) : ℂ := c ρ + (ρ : ℂ) * c1 ρ

/-- Its second derivative. -/
def ampl2 (c1 c2 : ℝ → ℂ) (ρ : ℝ) : ℂ := 2 * c1 ρ + (ρ : ℂ) * c2 ρ

theorem hasDerivAt_ofReal_id (ρ : ℝ) : HasDerivAt (fun y : ℝ => ((y : ℝ) : ℂ)) 1 ρ := by
  have h := (hasDerivAt_id ρ).ofReal_comp
  simpa using h

theorem hasDerivAt_ampl {c c1 : ℝ → ℂ} (hc : ∀ ρ, HasDerivAt c (c1 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (ampl c) (ampl1 c c1 ρ) ρ := by
  have h := (hasDerivAt_ofReal_id ρ).mul (hc ρ)
  have heq : (1 : ℂ) * c ρ + (ρ : ℂ) * c1 ρ = ampl1 c c1 ρ := by
    rw [ampl1]
    ring
  rw [heq] at h
  exact h

theorem hasDerivAt_ampl1 {c c1 c2 : ℝ → ℂ} (hc : ∀ ρ, HasDerivAt c (c1 ρ) ρ)
    (hc1 : ∀ ρ, HasDerivAt c1 (c2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (ampl1 c c1) (ampl2 c1 c2 ρ) ρ := by
  have h := (hc ρ).add ((hasDerivAt_ofReal_id ρ).mul (hc1 ρ))
  have heq : c1 ρ + ((1 : ℂ) * c1 ρ + (ρ : ℂ) * c2 ρ) = ampl2 c1 c2 ρ := by
    rw [ampl2]
    ring
  rw [heq] at h
  exact h

theorem continuous_ampl2 {c1 c2 : ℝ → ℂ} (hc1 : Continuous c1) (hc2 : Continuous c2) :
    Continuous (ampl2 c1 c2) :=
  (continuous_const.mul hc1).add ((Complex.continuous_ofReal).mul hc2)

theorem norm_ampl_le {c : ℝ → ℂ} {Bc M : ℝ} (ρ : ℝ) (hc : ‖c ρ‖ ≤ Bc) (hρ : |ρ| ≤ M)
    (hM : 0 ≤ M) : ‖ampl c ρ‖ ≤ M * Bc := by
  rw [ampl, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_mul hρ hc (norm_nonneg _) hM

theorem norm_ampl1_le {c c1 : ℝ → ℂ} {Bc Bc1 M : ℝ} (ρ : ℝ) (hc : ‖c ρ‖ ≤ Bc)
    (hc1 : ‖c1 ρ‖ ≤ Bc1) (hρ : |ρ| ≤ M) (hM : 0 ≤ M) :
    ‖ampl1 c c1 ρ‖ ≤ Bc + M * Bc1 := by
  rw [ampl1]
  refine le_trans (norm_add_le _ _) (add_le_add hc ?_)
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  exact mul_le_mul hρ hc1 (norm_nonneg _) hM

theorem norm_ampl2_le {c1 c2 : ℝ → ℂ} {Bc1 Bc2 M : ℝ} (ρ : ℝ) (hc1 : ‖c1 ρ‖ ≤ Bc1)
    (hc2 : ‖c2 ρ‖ ≤ Bc2) (hρ : |ρ| ≤ M) (hM : 0 ≤ M) :
    ‖ampl2 c1 c2 ρ‖ ≤ 2 * Bc1 + M * Bc2 := by
  rw [ampl2]
  refine le_trans (norm_add_le _ _) (add_le_add ?_ ?_)
  · rw [norm_mul]
    norm_num
    exact hc1
  · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul hρ hc2 (norm_nonneg _) hM

end Amplitude


/-! ## The angular support and its measure

The set of polar angles that meet the support of a `(j,m)`-adapted symbol has measure
`≲ 2^{-m}`.  This is the second source of the factor `2^{-m/2}` in §4.3.
-/

section Angular

/-- The determinant of `ξ` against the unit vector of polar angle `φ`. -/
def wfun (ξ : Pl) (φ : ℝ) : ℝ := ξ 0 * Real.sin φ - ξ 1 * Real.cos φ

theorem det2_pt_one (ξ : Pl) (φ : ℝ) : det2 ξ (pt 1 φ) = wfun ξ φ := by
  rw [det2, wfun, pt, mk2_apply_zero, mk2_apply_one]
  ring

theorem det2_smul_right (x y : Pl) (r : ℝ) : det2 x (r • y) = r * det2 x y := by
  rw [det2, det2, PiLp.smul_apply, PiLp.smul_apply]
  simp only [smul_eq_mul]
  ring

theorem hasDerivAt_wfun (ξ : Pl) (φ : ℝ) :
    HasDerivAt (wfun ξ) (ξ 0 * Real.cos φ + ξ 1 * Real.sin φ) φ := by
  have h1 : HasDerivAt (fun x : ℝ => ξ 0 * Real.sin x) (ξ 0 * Real.cos φ) φ :=
    (Real.hasDerivAt_sin φ).const_mul _
  have h2 : HasDerivAt (fun x : ℝ => ξ 1 * Real.cos x) (ξ 1 * (-Real.sin φ)) φ :=
    (Real.hasDerivAt_cos φ).const_mul _
  have h := h1.sub h2
  have heq : ξ 0 * Real.cos φ - ξ 1 * -Real.sin φ = ξ 0 * Real.cos φ + ξ 1 * Real.sin φ := by
    ring
  rw [heq] at h
  exact h

theorem continuous_wfun (ξ : Pl) : Continuous (wfun ξ) :=
  (continuous_const.mul Real.continuous_sin).sub (continuous_const.mul Real.continuous_cos)

/-- A measurable set of polar angles containing all directions that meet the support. -/
def AngSet (m : ℕ) (ξ : Pl) : Set ℝ :=
  {φ | |wfun ξ φ| ≤ ‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ)) ∧ 0 < Real.cos φ ∧
    Real.cos φ < (2 : ℝ) ^ (-(10 : ℤ)) ∧ 0 < Real.sin φ}

theorem measurableSet_AngSet (m : ℕ) (ξ : Pl) : MeasurableSet (AngSet m ξ) := by
  have h1 : MeasurableSet {φ : ℝ | |wfun ξ φ| ≤ ‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ))} :=
    measurableSet_le (continuous_wfun ξ).abs.measurable measurable_const
  have h2 : MeasurableSet {φ : ℝ | 0 < Real.cos φ} :=
    measurableSet_lt measurable_const Real.continuous_cos.measurable
  have h3 : MeasurableSet {φ : ℝ | Real.cos φ < (2 : ℝ) ^ (-(10 : ℤ))} :=
    measurableSet_lt Real.continuous_cos.measurable measurable_const
  have h4 : MeasurableSet {φ : ℝ | 0 < Real.sin φ} :=
    measurableSet_lt measurable_const Real.continuous_sin.measurable
  exact h1.inter (h2.inter (h3.inter h4))

theorem mem_AngSet_of_mem_SuppSet {j m : ℕ} {ξ : Pl} {ρ φ : ℝ} (hρ : 0 < ρ)
    (h : pt ρ φ ∈ SuppSet j m ξ) : φ ∈ AngSet m ξ := by
  obtain ⟨hηT, -, hang⟩ := h
  have hcoord0 : (pt ρ φ) 0 = ρ * Real.cos φ := by rw [pt, mk2_apply_zero]
  have hcoord1 : (pt ρ φ) 1 = ρ * Real.sin φ := by rw [pt, mk2_apply_one]
  have hc0 : 0 < Real.cos φ := by
    have h := hηT.1
    rw [hcoord0] at h
    nlinarith [hρ]
  have hs0 : 0 < Real.sin φ := by
    have h := Theta.snd_pos hηT
    rw [hcoord1] at h
    nlinarith
  have hcone : Real.cos φ < (2 : ℝ) ^ (-(10 : ℤ)) := by
    have h := hηT.2.1
    rw [hcoord0, hcoord1] at h
    have h2 : Real.cos φ < (2 : ℝ) ^ (-(10 : ℤ)) * Real.sin φ := by
      have hmul : ρ * Real.cos φ < ρ * ((2 : ℝ) ^ (-(10 : ℤ)) * Real.sin φ) := by
        calc ρ * Real.cos φ < (2 : ℝ) ^ (-(10 : ℤ)) * (ρ * Real.sin φ) := h
          _ = ρ * ((2 : ℝ) ^ (-(10 : ℤ)) * Real.sin φ) := by ring
      exact lt_of_mul_lt_mul_left hmul hρ.le
    have hsle : Real.sin φ ≤ 1 := Real.sin_le_one φ
    have hc : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
    nlinarith
  refine ⟨?_, hc0, hcone, hs0⟩
  -- the determinant bound
  have hnorm : ‖pt ρ φ‖ = ρ := norm_pt ρ φ hρ.le
  have hsm : pt ρ φ = ρ • pt 1 φ := pt_eq_smul ρ φ
  have hdet : det2 ξ (pt ρ φ) = ρ * det2 ξ (pt 1 φ) := by
    rw [hsm, det2_smul_right]
  have hbound : |det2 ξ (pt ρ φ)| ≤ ‖ξ‖ * ρ * (2 : ℝ) ^ (5 - (m : ℤ)) := by
    refine le_trans (abs_det2_le ξ (pt ρ φ)) ?_
    rw [hnorm]
    have hnn : (0 : ℝ) ≤ ‖ξ‖ * ρ := by positivity
    exact mul_le_mul_of_nonneg_left hang hnn
  rw [hdet, abs_mul, abs_of_pos hρ] at hbound
  rw [det2_pt_one] at hbound
  have hfin : ρ * |wfun ξ φ| ≤ ρ * (‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ))) := by
    calc ρ * |wfun ξ φ| ≤ ‖ξ‖ * ρ * (2 : ℝ) ^ (5 - (m : ℤ)) := hbound
      _ = ρ * (‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ))) := by ring
  exact le_of_mul_le_mul_left hfin hρ

theorem sin_half_lower : (2 : ℝ) / 5 < Real.sin (1 / 2) := by
  have h := Real.sin_gt_sub_cube (show (0 : ℝ) < 1 / 2 by norm_num)
  nlinarith [h]

/-- The angular support is contained in a short interval on which `wfun` grows quickly. -/
theorem AngSet_subset {m : ℕ} {ξ : Pl} :
    AngSet m ξ ∩ Set.Ioo (-π) π ⊆ Set.Icc (1 / 2 : ℝ) (π / 2) := by
  intro φ hφ
  obtain ⟨⟨-, hc0, hcone, hs0⟩, hIoo⟩ := hφ
  have hsin_ge : (1 : ℝ) / 2 ≤ Real.sin φ := by
    have hcs := Real.sin_sq_add_cos_sq φ
    have hnum : (2 : ℝ) ^ (-(10 : ℤ)) ≤ 1 / 2 := by
      rw [zpow_neg]
      norm_num
    have hchalf : Real.cos φ < 1 / 2 := lt_of_lt_of_le hcone hnum
    have hcsq : Real.cos φ ^ 2 < 1 / 4 := by nlinarith [hc0]
    have hssq : (3 : ℝ) / 4 < Real.sin φ ^ 2 := by linarith
    nlinarith [hs0, hssq]
  refine ⟨?_, ?_⟩
  · have hle : Real.sin φ ≤ φ ∨ φ < 0 := by
      rcases le_or_gt 0 φ with h | h
      · exact Or.inl (Real.sin_le h)
      · exact Or.inr h
    rcases hle with h | h
    · linarith
    · exfalso
      have hneg : Real.sin φ ≤ 0 := by
        have h1 : 0 ≤ -φ := by linarith
        have h2 : -φ ≤ π := by linarith [hIoo.1]
        have h3 : 0 ≤ Real.sin (-φ) := Real.sin_nonneg_of_nonneg_of_le_pi h1 h2
        rw [Real.sin_neg] at h3
        linarith
      linarith
  · by_contra hcon
    push_neg at hcon
    have hneg : Real.cos φ < 0 :=
      Real.cos_neg_of_pi_div_two_lt_of_lt hcon (by linarith [hIoo.2, Real.pi_pos])
    linarith

theorem volume_AngSet_le {j m : ℕ} {ξ : Pl} (hξ : XiData j ξ) :
    volume (AngSet m ξ ∩ Set.Ioo (-π) π) ≤ ENNReal.ofReal ((2 : ℝ) ^ (12 - (m : ℤ))) := by
  classical
  set I : Set ℝ := Set.Icc (1 / 2 : ℝ) (π / 2) with hIdef
  have hsub := AngSet_subset (m := m) (ξ := ξ)
  rcases Set.eq_empty_or_nonempty (AngSet m ξ ∩ Set.Ioo (-π) π) with hempty | ⟨φ₀, hφ₀⟩
  · rw [hempty]
    simp
  -- the derivative of `wfun` is at least `(2/5) * ξ 1` on `I`
  have hderiv : ∀ φ ∈ I, (2 / 5) * ξ 1 ≤ ξ 0 * Real.cos φ + ξ 1 * Real.sin φ := by
    intro φ hφ
    have hφ1 : (1 : ℝ) / 2 ≤ φ := hφ.1
    have hφ2 : φ ≤ π / 2 := hφ.2
    have hcnn : 0 ≤ Real.cos φ := Real.cos_nonneg_of_mem_Icc ⟨by linarith [Real.pi_pos], hφ2⟩
    have hsin : (2 : ℝ) / 5 ≤ Real.sin φ := by
      have hmono := Real.strictMonoOn_sin.monotoneOn
        (a := (1 : ℝ) / 2) (b := φ)
        ⟨by linarith [Real.pi_pos], by linarith⟩ ⟨by linarith [Real.pi_pos], hφ2⟩ hφ1
      linarith [sin_half_lower]
    have h0 : 0 ≤ ξ 0 * Real.cos φ := mul_nonneg hξ.cone0.le hcnn
    nlinarith [hξ.snd_pos]
  -- the mean value theorem on `I`
  have hmvt : ∀ x ∈ I, ∀ y ∈ I, x ≤ y →
      (2 / 5) * ξ 1 * (y - x) ≤ wfun ξ y - wfun ξ x := by
    refine (convex_Icc _ _).mul_sub_le_image_sub_of_le_deriv ?_ ?_ ?_
    · exact (continuous_wfun ξ).continuousOn
    · exact fun x _ => (hasDerivAt_wfun ξ x).differentiableAt.differentiableWithinAt
    · intro x hx
      rw [(hasDerivAt_wfun ξ x).deriv]
      exact hderiv x (interior_subset hx)
  -- points of the angular support are close together
  have hdiam : ∀ φ ∈ AngSet m ξ ∩ Set.Ioo (-π) π, |φ - φ₀| ≤ (2 : ℝ) ^ (11 - (m : ℤ)) := by
    intro φ hφ
    have hwφ : |wfun ξ φ| ≤ ‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ)) := hφ.1.1
    have hwφ₀ : |wfun ξ φ₀| ≤ ‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ)) := hφ₀.1.1
    have hbig : |wfun ξ φ - wfun ξ φ₀| ≤ 2 * (‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ))) := by
      refine le_trans (abs_sub _ _) ?_
      linarith [abs_sub_abs_le_abs_sub (wfun ξ φ) (wfun ξ φ₀)]
    have hkey : (2 / 5) * ξ 1 * |φ - φ₀| ≤ |wfun ξ φ - wfun ξ φ₀| := by
      rcases le_total φ₀ φ with hle | hle
      · have h := hmvt φ₀ (hsub hφ₀) φ (hsub hφ) hle
        rw [abs_of_nonneg (by linarith : (0:ℝ) ≤ φ - φ₀)]
        refine le_trans (le_of_eq (by ring)) (le_trans h (le_abs_self _))
      · have h := hmvt φ (hsub hφ) φ₀ (hsub hφ₀) hle
        rw [abs_of_nonpos (by linarith : φ - φ₀ ≤ (0:ℝ))]
        have h2 : (2 / 5) * ξ 1 * (φ₀ - φ) ≤ wfun ξ φ₀ - wfun ξ φ := h
        have h3 : wfun ξ φ₀ - wfun ξ φ ≤ |wfun ξ φ - wfun ξ φ₀| := by
          rw [abs_sub_comm]
          exact le_abs_self _
        calc (2 / 5) * ξ 1 * -(φ - φ₀) = (2 / 5) * ξ 1 * (φ₀ - φ) := by ring
          _ ≤ wfun ξ φ₀ - wfun ξ φ := h2
          _ ≤ |wfun ξ φ - wfun ξ φ₀| := h3
    have hpos : (0 : ℝ) < (2 / 5) * ξ 1 := by
      have := hξ.snd_pos
      positivity
    rw [← le_div_iff₀' hpos] at hkey
    refine le_trans hkey ?_
    rw [div_le_iff₀ hpos]
    refine le_trans hbig ?_
    have hc5 : (0 : ℝ) < (2 : ℝ) ^ (5 - (m : ℤ)) := by positivity
    have hnorm := hξ.norm_le
    have hlow := hξ.lower
    have hA : 2 * (‖ξ‖ * (2 : ℝ) ^ (5 - (m : ℤ)))
        ≤ 2 * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ (5 - (m : ℤ))) := by
      nlinarith [norm_nonneg ξ]
    have hidA : 2 * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ (5 - (m : ℤ)))
        = 2 * (2 : ℝ) ^ ((j : ℤ) + 7 - (m : ℤ)) := by
      congr 1
      rw [← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
      congr 1
      ring
    have hidB : (2 : ℝ) ^ (11 - (m : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 1)
        = (2 : ℝ) ^ ((j : ℤ) + 10 - (m : ℤ)) := by
      rw [← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
      congr 1
      ring
    have hidC : (2 : ℝ) ^ ((j : ℤ) + 10 - (m : ℤ))
        = 8 * (2 : ℝ) ^ ((j : ℤ) + 7 - (m : ℤ)) := by
      rw [show (j : ℤ) + 10 - (m : ℤ) = 3 + ((j : ℤ) + 7 - (m : ℤ)) by ring,
        zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
      norm_num
    have hB : (2 : ℝ) ^ (11 - (m : ℤ)) * (2 / 5 * (2 : ℝ) ^ ((j : ℤ) - 1))
        ≤ (2 : ℝ) ^ (11 - (m : ℤ)) * (2 / 5 * ξ 1) := by
      have hc : (0 : ℝ) < (2 : ℝ) ^ (11 - (m : ℤ)) := by positivity
      nlinarith
    have hC : (2 : ℝ) ^ (11 - (m : ℤ)) * (2 / 5 * (2 : ℝ) ^ ((j : ℤ) - 1))
        = 2 / 5 * (8 * (2 : ℝ) ^ ((j : ℤ) + 7 - (m : ℤ))) := by
      rw [show (2 : ℝ) ^ (11 - (m : ℤ)) * (2 / 5 * (2 : ℝ) ^ ((j : ℤ) - 1))
          = 2 / 5 * ((2 : ℝ) ^ (11 - (m : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 1)) from by ring,
        hidB, hidC]
    have hpos7 : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) + 7 - (m : ℤ)) := by positivity
    linarith [hA, hidA, hB, hC, hpos7]
  -- hence the angular support lies in an interval of length `2 ^ (12 - m)`
  have hincl : AngSet m ξ ∩ Set.Ioo (-π) π
      ⊆ Set.Icc (φ₀ - (2 : ℝ) ^ (11 - (m : ℤ))) (φ₀ + (2 : ℝ) ^ (11 - (m : ℤ))) := by
    intro φ hφ
    have h := hdiam φ hφ
    rw [abs_le] at h
    exact ⟨by linarith [h.1], by linarith [h.2]⟩
  refine le_trans (measure_mono hincl) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  have hid : (2 : ℝ) ^ (12 - (m : ℤ)) = 2 * (2 : ℝ) ^ (11 - (m : ℤ)) := by
    rw [show (12 : ℤ) - (m : ℤ) = 1 + (11 - (m : ℤ)) by ring,
      zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0), zpow_one]
  rw [hid]
  linarith

end Angular


/-! ## The discriminant is bounded below on the strict angular support -/

section StrictAngular

/-- Angles meeting the support of a *strictly* adapted symbol: the determinant is also bounded
below, which is exactly the nondegeneracy of the elliptic phase. -/
def AngSetStrict (m : ℕ) (ξ : Pl) : Set ℝ :=
  {φ | φ ∈ AngSet m ξ ∧ ‖ξ‖ * (2 : ℝ) ^ (-(m : ℤ) - 6) ≤ |wfun ξ φ|}

theorem mem_AngSetStrict_of_mem {j m : ℕ} {ξ : Pl} {ρ φ : ℝ} (hρ : 0 < ρ)
    (hξ : XiData j ξ) (h : pt ρ φ ∈ SuppSetStrict j m ξ) : φ ∈ AngSetStrict m ξ := by
  refine ⟨mem_AngSet_of_mem_SuppSet hρ h.1, ?_⟩
  obtain ⟨⟨hηT, -, -⟩, hlow⟩ := h
  -- the angle is small, hence its sine is comparable to it
  have hcone := angle_le_of_cone hξ.cone0 hξ.snd_pos hξ.cone hηT.1 (Theta.snd_pos hηT) hηT.2.1
  have hang0 : 0 ≤ InnerProductGeometry.angle ξ (pt ρ φ) :=
    InnerProductGeometry.angle_nonneg _ _
  have hle : (2 : ℝ) ^ (-(9 : ℤ)) ≤ π / 2 := by
    have h1 : (1 : ℝ) ≤ π / 2 := Real.one_le_pi_div_two
    have h2 : (2 : ℝ) ^ (-(9 : ℤ)) ≤ 1 := by
      rw [zpow_neg]
      norm_num
    linarith
  have hsin : (1 : ℝ) / 2 * InnerProductGeometry.angle ξ (pt ρ φ)
      ≤ Real.sin (InnerProductGeometry.angle ξ (pt ρ φ)) := by
    have h := Real.mul_le_sin hang0 (le_trans hcone hle)
    have hπ : (2 : ℝ) / π ≥ 1 / 2 := by
      rw [ge_iff_le, div_le_div_iff₀ (by norm_num) Real.pi_pos]
      linarith [Real.pi_le_four]
    nlinarith [h, hang0]
  have hsinlow : (2 : ℝ) ^ (-(m : ℤ) - 6)
      ≤ Real.sin (InnerProductGeometry.angle ξ (pt ρ φ)) := by
    refine le_trans ?_ hsin
    have hid : (2 : ℝ) ^ (-(m : ℤ) - 5) = 2 * (2 : ℝ) ^ (-(m : ℤ) - 6) := by
      rw [show -(m : ℤ) - 5 = 1 + (-(m : ℤ) - 6) by ring,
        zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0), zpow_one]
    rw [hid] at hlow
    linarith
  -- the angle of `ξ` with the unit direction is the same
  have hsm : pt ρ φ = ρ • pt 1 φ := pt_eq_smul ρ φ
  have hangeq : InnerProductGeometry.angle ξ (pt ρ φ) = InnerProductGeometry.angle ξ (pt 1 φ) := by
    rw [hsm]
    exact InnerProductGeometry.angle_smul_right_of_pos ξ (pt 1 φ) hρ
  rw [hangeq] at hsinlow
  -- convert the sine into the determinant
  have hnorm1 : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hkey := sin_angle_eq ξ (pt 1 φ)
  rw [hnorm1, mul_one, det2_pt_one] at hkey
  have hnn : (0 : ℝ) ≤ ‖ξ‖ := norm_nonneg ξ
  calc ‖ξ‖ * (2 : ℝ) ^ (-(m : ℤ) - 6)
      ≤ ‖ξ‖ * Real.sin (InnerProductGeometry.angle ξ (pt 1 φ)) :=
        mul_le_mul_of_nonneg_left hsinlow hnn
    _ = |wfun ξ φ| := by rw [← hkey]; ring

/-- The discriminant of the elliptic phase is at least `2^{2j - 2m - 14}`. -/
theorem disc_lower {j m : ℕ} {ξ : Pl} (hξ : XiData j ξ) {φ : ℝ}
    (hφ : φ ∈ AngSetStrict m ξ) :
    (2 : ℝ) ^ (2 * (j : ℤ) - 2 * (m : ℤ) - 14)
      ≤ ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 := by
  have hnorm1 : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hlag := lagrange ξ (pt 1 φ)
  rw [hnorm1] at hlag
  simp only [one_pow, mul_one] at hlag
  -- `det² = R² - a²`
  have hdet : |wfun ξ φ| ^ 2 = ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 := by
    rw [sq_abs, ← det2_pt_one]
    exact hlag
  rw [← hdet]
  have hlow := hφ.2
  have hR := hξ.norm_lower
  have hstep : (2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ (-(m : ℤ) - 6) ≤ |wfun ξ φ| := by
    refine le_trans ?_ hlow
    have hc : (0 : ℝ) < (2 : ℝ) ^ (-(m : ℤ) - 6) := by positivity
    nlinarith
  have hid : (2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ (-(m : ℤ) - 6)
      = (2 : ℝ) ^ ((j : ℤ) - (m : ℤ) - 7) := by
    rw [← zpow_add₀ (two_ne_zero : (2 : ℝ) ≠ 0)]
    congr 1
    ring
  rw [hid] at hstep
  have hpos : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) - (m : ℤ) - 7) := by positivity
  have hsq : ((2 : ℝ) ^ ((j : ℤ) - (m : ℤ) - 7)) ^ 2 ≤ |wfun ξ φ| ^ 2 := by
    exact pow_le_pow_left₀ hpos.le hstep 2
  refine le_trans (le_of_eq ?_) hsq
  rw [← zpow_natCast ((2 : ℝ) ^ ((j : ℤ) - (m : ℤ) - 7)) 2, ← zpow_mul]
  congr 1
  push_cast
  ring

theorem disc_pos {j m : ℕ} {ξ : Pl} (hξ : XiData j ξ) {φ : ℝ}
    (hφ : φ ∈ AngSetStrict m ξ) :
    0 < ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 :=
  lt_of_lt_of_le (by positivity) (disc_lower hξ hφ)

end StrictAngular


/-! ## The symbol along rays

The hypotheses of Proposition 4.2 on the symbol, written along rays: `|∂_ρ^N b(t,ξ,ρθ)| ≤ B 2^{-jN}`
for `N = 0, 1, 2`, which is the paper's `|⟨η/|η|, ∇⟩^N b| ≤ B 2^{-jN}`.
-/

section RaySymbol

theorem norm_pt_abs (ρ φ : ℝ) : ‖pt ρ φ‖ = |ρ| := by
  have hsq : ‖pt ρ φ‖ ^ 2 = ρ ^ 2 := by
    rw [pt, norm_mk2_sq]
    have := Real.sin_sq_add_cos_sq φ
    nlinarith
  rw [← Real.sqrt_sq_eq_abs, ← hsq, Real.sqrt_sq (norm_nonneg _)]

/-- The radii at which the ray leaves the annulus of `Θ_j`; an open set. -/
def OutAnn (j : ℕ) : Set ℝ :=
  {r : ℝ | |r| < (2 : ℝ) ^ ((j : ℤ) - 1)} ∪ {r : ℝ | (2 : ℝ) ^ ((j : ℤ) + 1) < |r|}

theorem isOpen_OutAnn (j : ℕ) : IsOpen (OutAnn j) := by
  refine IsOpen.union ?_ ?_
  · exact isOpen_lt continuous_abs continuous_const
  · exact isOpen_lt continuous_const continuous_abs

theorem symbol_ray_eq_zero {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} (hb : IsStrictlyAdapted j m b)
    (t : ℝ) (ξ : Pl) (φ : ℝ) {ρ : ℝ} (hρ : ρ ∈ OutAnn j) : b t ξ (pt ρ φ) = 0 := by
  refine hb.supp t ξ (pt ρ φ) ?_
  intro hmem
  have hT : pt ρ φ ∈ Theta j := hmem.1.1
  have h1 : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ |ρ| := by
    have := hT.2.2.1
    rwa [norm_pt_abs] at this
  have h2 : |ρ| ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := by
    have := hT.2.2.2
    rwa [norm_pt_abs] at this
  rcases hρ with h | h
  · exact absurd h (not_lt.mpr h1)
  · exact absurd h (not_lt.mpr h2)

theorem deriv_eq_zero_of_eventually_zero {u u1 : ℝ → ℂ} (hu : ∀ ρ, HasDerivAt u (u1 ρ) ρ)
    {ρ : ℝ} (h : u =ᶠ[nhds ρ] 0) : u1 ρ = 0 := by
  have h1 : HasDerivAt u 0 ρ := (hasDerivAt_const ρ (0 : ℂ)).congr_of_eventuallyEq h
  exact (hu ρ).unique h1

/-- The radial data of a symbol: values and the first two radial derivatives, with the bounds of
Proposition 4.2. -/
structure RayData (j : ℕ) (b : ℝ → Pl → Pl → ℂ) (B : ℝ)
    (b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ) : Prop where
  cont0 : ∀ t ξ, Continuous (b t ξ)
  d1 : ∀ t ξ φ ρ, HasDerivAt (fun r => b t ξ (pt r φ)) (b1 t ξ φ ρ) ρ
  d2 : ∀ t ξ φ ρ, HasDerivAt (b1 t ξ φ) (b2 t ξ φ ρ) ρ
  cont2 : ∀ t ξ φ, Continuous (b2 t ξ φ)
  bd0 : ∀ t ξ η, ‖b t ξ η‖ ≤ B
  bd1 : ∀ t ξ φ ρ, ‖b1 t ξ φ ρ‖ ≤ B * (2 : ℝ) ^ (-(j : ℤ))
  bd2 : ∀ t ξ φ ρ, ‖b2 t ξ φ ρ‖ ≤ B * (2 : ℝ) ^ (-2 * (j : ℤ))

theorem ray_vanish {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (t : ℝ) (ξ : Pl) (φ : ℝ) {ρ : ℝ} (hρ : ρ ∈ OutAnn j) :
    b t ξ (pt ρ φ) = 0 ∧ b1 t ξ φ ρ = 0 ∧ b2 t ξ φ ρ = 0 := by
  have hzero : ∀ r ∈ OutAnn j, b t ξ (pt r φ) = 0 := fun r hr =>
    symbol_ray_eq_zero hb t ξ φ hr
  have hmem : ∀ r ∈ OutAnn j, (fun r => b t ξ (pt r φ)) =ᶠ[nhds r] 0 := by
    intro r hr
    refine Filter.eventuallyEq_of_mem ((isOpen_OutAnn j).mem_nhds hr) ?_
    intro x hx
    exact hzero x hx
  have h1 : ∀ r ∈ OutAnn j, b1 t ξ φ r = 0 := fun r hr =>
    deriv_eq_zero_of_eventually_zero (hray.d1 t ξ φ) (hmem r hr)
  have hmem1 : (b1 t ξ φ) =ᶠ[nhds ρ] 0 := by
    refine Filter.eventuallyEq_of_mem ((isOpen_OutAnn j).mem_nhds hρ) ?_
    intro x hx
    exact h1 x hx
  exact ⟨hzero ρ hρ, h1 ρ hρ, deriv_eq_zero_of_eventually_zero (hray.d2 t ξ φ) hmem1⟩

end RaySymbol


/-! ## The numerical bookkeeping of §4.3

With `P = 2^j` and `Q = 2^m` the amplitude bounds are `|A| ≤ 2 P B²`, `|A'| ≤ 5 B²`,
`|A''| ≤ 12 B² / P`, while `g ≤ 8 P` and `D ≥ P² / (2^{14} Q²)`.  The bound on the twice
integrated-by-parts amplitude is then `2^{47} B² Q⁴ / P`.
-/

section Numeric

theorem cfun_numeric_bound {MA MA1 MA2 g D P Q Bv : ℝ}
    (hP : 0 < P) (hQ : 0 < Q) (hBv : 0 ≤ Bv)
    (hMA : MA ≤ 2 * P * Bv) (hMA1 : MA1 ≤ 5 * Bv) (hMA2 : MA2 ≤ 12 * Bv / P)
    (hMAnn : 0 ≤ MA) (hMA1nn : 0 ≤ MA1) (hMA2nn : 0 ≤ MA2)
    (hg : 0 < g) (hgle : g ≤ 8 * P) (hD : 0 < D)
    (hDlow : P ^ 2 / (2 ^ 14 * Q ^ 2) ≤ D) :
    (4 * MA2 * g ^ 4 + 24 * MA1 * g ^ 3 + 72 * MA * g ^ 2) / D ^ 2
      ≤ 2 ^ 47 * Bv * Q ^ 4 / P := by
  have hD2 : (0 : ℝ) < D ^ 2 := by positivity
  rw [div_le_iff₀ hD2]
  have hnum : 4 * MA2 * g ^ 4 + 24 * MA1 * g ^ 3 + 72 * MA * g ^ 2
      ≤ 4 * (12 * Bv / P) * (8 * P) ^ 4 + 24 * (5 * Bv) * (8 * P) ^ 3
        + 72 * (2 * P * Bv) * (8 * P) ^ 2 := by
    gcongr <;> positivity
  have hnum2 : 4 * (12 * Bv / P) * (8 * P) ^ 4 + 24 * (5 * Bv) * (8 * P) ^ 3
      + 72 * (2 * P * Bv) * (8 * P) ^ 2 ≤ 2 ^ 19 * Bv * P ^ 3 := by
    have hid : 4 * (12 * Bv / P) * (8 * P) ^ 4 + 24 * (5 * Bv) * (8 * P) ^ 3
        + 72 * (2 * P * Bv) * (8 * P) ^ 2 = 267264 * Bv * P ^ 3 := by
      field_simp
      ring
    rw [hid]
    have h2 : (267264 : ℝ) ≤ 2 ^ 19 := by norm_num
    nlinarith [mul_nonneg hBv (pow_nonneg hP.le 3)]
  have hDsq : P ^ 4 / (2 ^ 28 * Q ^ 4) ≤ D ^ 2 := by
    have hpos : (0 : ℝ) < P ^ 2 / (2 ^ 14 * Q ^ 2) := by positivity
    have hsq : (P ^ 2 / (2 ^ 14 * Q ^ 2)) ^ 2 ≤ D ^ 2 := pow_le_pow_left₀ hpos.le hDlow 2
    refine le_trans (le_of_eq ?_) hsq
    field_simp
  have hlast : 2 ^ 19 * Bv * P ^ 3 ≤ 2 ^ 47 * Bv * Q ^ 4 / P * D ^ 2 := by
    have hc : (0 : ℝ) ≤ 2 ^ 47 * Bv * Q ^ 4 / P := by positivity
    have hstep : 2 ^ 47 * Bv * Q ^ 4 / P * (P ^ 4 / (2 ^ 28 * Q ^ 4))
        ≤ 2 ^ 47 * Bv * Q ^ 4 / P * D ^ 2 := mul_le_mul_of_nonneg_left hDsq hc
    refine le_trans (le_of_eq ?_) hstep
    field_simp
  linarith [hnum, hnum2, hlast]

end Numeric


theorem real_smul_eq (r : ℝ) (z : ℂ) : r • z = (r : ℂ) * z := by
  rw [Complex.real_smul]

/-! ## The Gram integrand in polar coordinates

The product `K_t(ξ,η) conj K_{t'}(ξ,η)` is the elliptic oscillatory factor with frequency
`2π ε (t - t')` times the product of the two symbols; along a ray the polar Jacobian turns it into
the amplitude `ampl (cprod u v)`.
-/

section GramIntegrand

theorem phase_mul_conj_phase (ε t t' : ℝ) (ξ η : Pl) :
    phase ε t ξ η * (starRingEnd ℂ) (phase ε t' ξ η)
      = osc (2 * Real.pi * ε * (t - t')) (‖ξ - η‖ + ‖η‖) := by
  have hc : (starRingEnd ℂ) (phase ε t' ξ η)
      = Complex.exp (((-(2 * Real.pi * ε * t' * (‖ξ - η‖ + ‖η‖)) : ℝ) : ℂ) * Complex.I) := by
    rw [phase, ← Complex.exp_conj, map_mul, Complex.conj_ofReal, Complex.conj_I]
    congr 1
    push_cast
    ring
  rw [phase, hc, ← Complex.exp_add, osc]
  congr 1
  push_cast
  ring

variable {b : ℝ → Pl → Pl → ℂ}

theorem radial_integrand_eq (ε t t' : ℝ) (ξ : Pl) (φ : ℝ) {r : ℝ} (hr : 0 ≤ r) :
    (r : ℝ) • (Kern ε b t ξ (pt r φ) * (starRingEnd ℂ) (Kern ε b t' ξ (pt r φ)))
      = osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ r) *
        ampl (cprod (fun s => b t ξ (pt s φ)) (fun s => b t' ξ (pt s φ))) r := by
  have hsm : pt r φ = r • pt 1 φ := pt_eq_smul r φ
  have hnorm1 : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hphase : ‖ξ - pt r φ‖ + ‖pt r φ‖ = tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ r := by
    rw [hsm]
    exact (tauf_eq_phase ξ (pt 1 φ) hnorm1 hr).symm
  have hkern : Kern ε b t ξ (pt r φ) * (starRingEnd ℂ) (Kern ε b t' ξ (pt r φ))
      = osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ r) *
        cprod (fun s => b t ξ (pt s φ)) (fun s => b t' ξ (pt s φ)) r := by
    rw [Kern, Kern, cprod, map_mul, ← hphase]
    rw [show phase ε t ξ (pt r φ) * b t ξ (pt r φ) *
        ((starRingEnd ℂ) (phase ε t' ξ (pt r φ)) * (starRingEnd ℂ) (b t' ξ (pt r φ)))
        = (phase ε t ξ (pt r φ) * (starRingEnd ℂ) (phase ε t' ξ (pt r φ))) *
          (b t ξ (pt r φ) * (starRingEnd ℂ) (b t' ξ (pt r φ))) from by ring]
    rw [phase_mul_conj_phase]
  rw [hkern, ampl, real_smul_eq]
  ring

end GramIntegrand


/-! ## Named amplitudes for the Gram integral -/

section GramAmplitudes

theorem continuous_cprod1 {u u1 v v1 : ℝ → ℂ} (hu : Continuous u) (hu1 : Continuous u1)
    (hv : Continuous v) (hv1 : Continuous v1) : Continuous (cprod1 u u1 v v1) :=
  (hu1.mul (Complex.continuous_conj.comp hv)).add (hu.mul (Complex.continuous_conj.comp hv1))

theorem cprod_eq_zero {u v : ℝ → ℂ} {ρ : ℝ} (hu : u ρ = 0) : cprod u v ρ = 0 := by
  rw [cprod, hu, zero_mul]

theorem cprod1_eq_zero {u u1 v v1 : ℝ → ℂ} {ρ : ℝ} (hu : u ρ = 0) (hu1 : u1 ρ = 0) :
    cprod1 u u1 v v1 ρ = 0 := by
  rw [cprod1, hu, hu1, zero_mul, zero_mul, add_zero]

theorem cprod2_eq_zero {u u1 u2 v v1 v2 : ℝ → ℂ} {ρ : ℝ} (hu : u ρ = 0) (hu1 : u1 ρ = 0)
    (hu2 : u2 ρ = 0) : cprod2 u u1 u2 v v1 v2 ρ = 0 := by
  rw [cprod2, hu, hu1, hu2]
  ring

theorem ampl_eq_zero {c : ℝ → ℂ} {ρ : ℝ} (hc : c ρ = 0) : ampl c ρ = 0 := by
  rw [ampl, hc, mul_zero]

theorem ampl1_eq_zero {c c1 : ℝ → ℂ} {ρ : ℝ} (hc : c ρ = 0) (hc1 : c1 ρ = 0) :
    ampl1 c c1 ρ = 0 := by
  rw [ampl1, hc, hc1, mul_zero, add_zero]

theorem ampl2_eq_zero {c1 c2 : ℝ → ℂ} {ρ : ℝ} (hc1 : c1 ρ = 0) (hc2 : c2 ρ = 0) :
    ampl2 c1 c2 ρ = 0 := by
  rw [ampl2, hc1, hc2, mul_zero, mul_zero, add_zero]

variable {a R : ℝ}

theorem bfun_eq_zero {A A1 : ℝ → ℂ} {ρ : ℝ} (hA : A ρ = 0) (hA1 : A1 ρ = 0) :
    bfun a R A A1 ρ = 0 := by
  rw [bfun, hA, hA1]
  simp

theorem bfun1_eq_zero {A A1 A2 : ℝ → ℂ} {ρ : ℝ} (hA : A ρ = 0) (hA1 : A1 ρ = 0)
    (hA2 : A2 ρ = 0) : bfun1 a R A A1 A2 ρ = 0 := by
  rw [bfun1, hA, hA1, hA2]
  simp

theorem cfun_eq_zero {A A1 A2 : ℝ → ℂ} {ρ : ℝ} (hA : A ρ = 0) (hA1 : A1 ρ = 0)
    (hA2 : A2 ρ = 0) : cfun a R A A1 A2 ρ = 0 := by
  rw [cfun, bfun_eq_zero (a := a) (R := R) hA hA1,
    bfun1_eq_zero (a := a) (R := R) hA hA1 hA2]
  simp

/-- The symbol restricted to the ray of direction `φ`. -/
def rayb (b : ℝ → Pl → Pl → ℂ) (t : ℝ) (ξ : Pl) (φ : ℝ) : ℝ → ℂ := fun s => b t ξ (pt s φ)

variable {b : ℝ → Pl → Pl → ℂ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

/-- The amplitude of the Gram integral along a ray. -/
def gramA (b : ℝ → Pl → Pl → ℂ) (t t' : ℝ) (ξ : Pl) (φ : ℝ) : ℝ → ℂ :=
  ampl (cprod (rayb b t ξ φ) (rayb b t' ξ φ))

/-- Its first derivative. -/
def gramA1 (b : ℝ → Pl → Pl → ℂ) (b1 : ℝ → Pl → ℝ → ℝ → ℂ) (t t' : ℝ) (ξ : Pl) (φ : ℝ) :
    ℝ → ℂ :=
  ampl1 (cprod (rayb b t ξ φ) (rayb b t' ξ φ))
    (cprod1 (rayb b t ξ φ) (b1 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ))

/-- Its second derivative. -/
def gramA2 (b : ℝ → Pl → Pl → ℂ) (b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ) (t t' : ℝ) (ξ : Pl) (φ : ℝ) :
    ℝ → ℂ :=
  ampl2 (cprod1 (rayb b t ξ φ) (b1 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ))
    (cprod2 (rayb b t ξ φ) (b1 t ξ φ) (b2 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ) (b2 t' ξ φ))

theorem hasDerivAt_gramA {j : ℕ} {B : ℝ} (hray : RayData j b B b1 b2) (t t' : ℝ) (ξ : Pl)
    (φ : ℝ) (ρ : ℝ) : HasDerivAt (gramA b t t' ξ φ) (gramA1 b b1 t t' ξ φ ρ) ρ :=
  hasDerivAt_ampl (fun r => hasDerivAt_cprod (hray.d1 t ξ φ) (hray.d1 t' ξ φ) r) ρ

theorem hasDerivAt_gramA1 {j : ℕ} {B : ℝ} (hray : RayData j b B b1 b2) (t t' : ℝ) (ξ : Pl)
    (φ : ℝ) (ρ : ℝ) : HasDerivAt (gramA1 b b1 t t' ξ φ) (gramA2 b b1 b2 t t' ξ φ ρ) ρ :=
  hasDerivAt_ampl1 (fun r => hasDerivAt_cprod (hray.d1 t ξ φ) (hray.d1 t' ξ φ) r)
    (fun r => hasDerivAt_cprod1 (hray.d1 t ξ φ) (hray.d2 t ξ φ) (hray.d1 t' ξ φ)
      (hray.d2 t' ξ φ) r) ρ

theorem continuous_gramA2 {j : ℕ} {B : ℝ} (hray : RayData j b B b1 b2) (t t' : ℝ) (ξ : Pl)
    (φ : ℝ) : Continuous (gramA2 b b1 b2 t t' ξ φ) := by
  have hu : Continuous (rayb b t ξ φ) :=
    continuous_iff_continuousAt.mpr fun r => (hray.d1 t ξ φ r).continuousAt
  have hu1 : Continuous (b1 t ξ φ) :=
    continuous_iff_continuousAt.mpr fun r => (hray.d2 t ξ φ r).continuousAt
  have hv : Continuous (rayb b t' ξ φ) :=
    continuous_iff_continuousAt.mpr fun r => (hray.d1 t' ξ φ r).continuousAt
  have hv1 : Continuous (b1 t' ξ φ) :=
    continuous_iff_continuousAt.mpr fun r => (hray.d2 t' ξ φ r).continuousAt
  exact continuous_ampl2 (continuous_cprod1 hu hu1 hv hv1)
    (continuous_cprod2 hu hu1 (hray.cont2 t ξ φ) hv hv1 (hray.cont2 t' ξ φ))

theorem gram_vanish {j m : ℕ} {B : ℝ} (hb : IsStrictlyAdapted j m b)
    (hray : RayData j b B b1 b2) (t t' : ℝ) (ξ : Pl) (φ : ℝ) {ρ : ℝ} (hρ : ρ ∈ OutAnn j) :
    gramA b t t' ξ φ ρ = 0 ∧ gramA1 b b1 t t' ξ φ ρ = 0 ∧ gramA2 b b1 b2 t t' ξ φ ρ = 0 := by
  obtain ⟨hu0, hu1, hu2⟩ := ray_vanish hb hray t ξ φ hρ
  have hcc : cprod (rayb b t ξ φ) (rayb b t' ξ φ) ρ = 0 := cprod_eq_zero hu0
  have hcc1 : cprod1 (rayb b t ξ φ) (b1 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ) ρ = 0 :=
    cprod1_eq_zero hu0 hu1
  have hcc2 : cprod2 (rayb b t ξ φ) (b1 t ξ φ) (b2 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ)
      (b2 t' ξ φ) ρ = 0 := cprod2_eq_zero hu0 hu1 hu2
  exact ⟨ampl_eq_zero hcc, ampl1_eq_zero hcc hcc1, ampl2_eq_zero hcc1 hcc2⟩

end GramAmplitudes


/-! ## The `cfun` bound for the Gram amplitude -/

section RadialGram

theorem two_zpow_add (e f : ℤ) : (2 : ℝ) ^ (e + f) = (2 : ℝ) ^ e * (2 : ℝ) ^ f :=
  zpow_add₀ (two_ne_zero) e f

theorem two_zpow_sq (e : ℤ) : ((2 : ℝ) ^ e) ^ 2 = (2 : ℝ) ^ (2 * e) := by
  rw [show 2 * e = e + e by ring, two_zpow_add]
  ring

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

theorem norm_gram_cfun_le (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (hB : 0 ≤ B) {ξ : Pl} (hξ : XiData j ξ) {φ : ℝ} (hφ : φ ∈ AngSetStrict m ξ) (t t' : ℝ)
    {ρ : ℝ} (hρ0 : 0 ≤ ρ) :
    ‖cfun (inner ℝ ξ (pt 1 φ)) ‖ξ‖ (gramA b t t' ξ φ) (gramA1 b b1 t t' ξ φ)
        (gramA2 b b1 b2 t t' ξ φ) ρ‖
      ≤ (2 : ℝ) ^ (47 : ℕ) * B ^ 2 * ((2 : ℝ) ^ (m : ℤ)) ^ 4 / (2 : ℝ) ^ (j : ℤ) := by
  classical
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hQ : (0 : ℝ) < (2 : ℝ) ^ (m : ℤ) := by positivity
  have hD : 0 < ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 := disc_pos hξ hφ
  have hRHSnn : (0 : ℝ) ≤ (2 : ℝ) ^ (47 : ℕ) * B ^ 2 * ((2 : ℝ) ^ (m : ℤ)) ^ 4
      / (2 : ℝ) ^ (j : ℤ) := by positivity
  by_cases hout : ρ ∈ OutAnn j
  · obtain ⟨h0, h1, h2⟩ := gram_vanish hb hray t t' ξ φ hout
    rw [cfun_eq_zero h0 h1 h2, norm_zero]
    exact hRHSnn
  -- the main case: `ρ` lies in the annulus
  have hrange : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ |ρ| ∧ |ρ| ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := by
    simp only [OutAnn, Set.mem_union, Set.mem_setOf_eq, not_or, not_lt] at hout
    exact ⟨hout.1, hout.2⟩
  -- numeric identities
  have hP1 : (2 : ℝ) ^ ((j : ℤ) + 1) = 2 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]
    norm_num
    ring
  have hP2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 4 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]
    norm_num
    ring
  have hPinv : (2 : ℝ) ^ (-(j : ℤ)) = ((2 : ℝ) ^ (j : ℤ))⁻¹ := zpow_neg 2 (j : ℤ)
  have hPinv2 : (2 : ℝ) ^ (-2 * (j : ℤ)) = (((2 : ℝ) ^ (j : ℤ))⁻¹) ^ 2 := by
    rw [show -2 * (j : ℤ) = -(j : ℤ) + -(j : ℤ) by ring, two_zpow_add, hPinv]
    ring
  have habs : |ρ| ≤ 2 * (2 : ℝ) ^ (j : ℤ) := by
    rw [← hP1]
    exact hrange.2
  have hMnn : (0 : ℝ) ≤ 2 * (2 : ℝ) ^ (j : ℤ) := by positivity
  -- the symbol bounds along the ray
  have hu0 : ‖rayb b t ξ φ ρ‖ ≤ B := hray.bd0 t ξ (pt ρ φ)
  have hv0 : ‖rayb b t' ξ φ ρ‖ ≤ B := hray.bd0 t' ξ (pt ρ φ)
  have hu1 : ‖b1 t ξ φ ρ‖ ≤ B * ((2 : ℝ) ^ (j : ℤ))⁻¹ := by
    rw [← hPinv]
    exact hray.bd1 t ξ φ ρ
  have hv1 : ‖b1 t' ξ φ ρ‖ ≤ B * ((2 : ℝ) ^ (j : ℤ))⁻¹ := by
    rw [← hPinv]
    exact hray.bd1 t' ξ φ ρ
  have hu2 : ‖b2 t ξ φ ρ‖ ≤ B * (((2 : ℝ) ^ (j : ℤ))⁻¹) ^ 2 := by
    rw [← hPinv2]
    exact hray.bd2 t ξ φ ρ
  have hv2 : ‖b2 t' ξ φ ρ‖ ≤ B * (((2 : ℝ) ^ (j : ℤ))⁻¹) ^ 2 := by
    rw [← hPinv2]
    exact hray.bd2 t' ξ φ ρ
  -- the product bounds
  have hcc : ‖cprod (rayb b t ξ φ) (rayb b t' ξ φ) ρ‖ ≤ B ^ 2 := by
    refine le_trans (norm_cprod_le ρ hu0 hv0 hB) (le_of_eq ?_)
    ring
  have hcc1 : ‖cprod1 (rayb b t ξ φ) (b1 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ) ρ‖
      ≤ 2 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ))⁻¹ := by
    refine le_trans (norm_cprod1_le ρ hu0 hu1 hv0 hv1 hB (by positivity)) (le_of_eq ?_)
    ring
  have hcc2 : ‖cprod2 (rayb b t ξ φ) (b1 t ξ φ) (b2 t ξ φ) (rayb b t' ξ φ) (b1 t' ξ φ)
        (b2 t' ξ φ) ρ‖ ≤ 4 * B ^ 2 * (((2 : ℝ) ^ (j : ℤ))⁻¹) ^ 2 := by
    refine le_trans (norm_cprod2_le ρ hu0 hu1 hu2 hv0 hv1 hv2 hB (by positivity)
      (by positivity)) (le_of_eq ?_)
    ring
  -- the amplitude bounds
  have hA : ‖gramA b t t' ξ φ ρ‖ ≤ 2 * (2 : ℝ) ^ (j : ℤ) * B ^ 2 := by
    rw [gramA]
    exact norm_ampl_le ρ hcc habs hMnn
  have hA1 : ‖gramA1 b b1 t t' ξ φ ρ‖ ≤ 5 * B ^ 2 := by
    rw [gramA1]
    refine le_trans (norm_ampl1_le ρ hcc hcc1 habs hMnn) (le_of_eq ?_)
    field_simp
    ring
  have hA2 : ‖gramA2 b b1 b2 t t' ξ φ ρ‖ ≤ 12 * B ^ 2 / (2 : ℝ) ^ (j : ℤ) := by
    rw [gramA2]
    refine le_trans (norm_ampl2_le ρ hcc1 hcc2 habs hMnn) (le_of_eq ?_)
    field_simp
    ring
  -- the bound on `g`
  have hnorm1 : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hg : gf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ ≤ 8 * (2 : ℝ) ^ (j : ℤ) := by
    rw [gf_eq_norm ξ (pt 1 φ) hnorm1]
    have h1 : ‖ξ - ρ • pt 1 φ‖ ≤ ‖ξ‖ + ‖ρ • pt 1 φ‖ := norm_sub_le _ _
    have h2 : ‖ρ • pt 1 φ‖ = |ρ| := by
      rw [norm_smul, hnorm1, mul_one, Real.norm_eq_abs]
    rw [h2] at h1
    have h3 : ‖ξ‖ ≤ 4 * (2 : ℝ) ^ (j : ℤ) := by
      rw [← hP2]
      exact hξ.norm_le
    linarith
  have hgpos : 0 < gf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ := gf_pos hD ρ
  -- the bound on `D`
  have hDlow : ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 ^ 14 * ((2 : ℝ) ^ (m : ℤ)) ^ 2)
      ≤ ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 := by
    refine le_trans (le_of_eq ?_) (disc_lower hξ hφ)
    rw [two_zpow_sq, two_zpow_sq]
    rw [show 2 * (j : ℤ) - 2 * (m : ℤ) - 14 = 2 * (j : ℤ) + (-(2 * (m : ℤ)) + -(14 : ℤ)) by ring,
      two_zpow_add, two_zpow_add, zpow_neg, zpow_neg]
    norm_num
    field_simp
  -- conclude
  refine le_trans (norm_cfun_le hD ρ hA hA1 hA2 (by positivity) (by positivity)
    (by positivity)) ?_
  refine le_trans (cfun_numeric_bound (P := (2 : ℝ) ^ (j : ℤ)) (Q := (2 : ℝ) ^ (m : ℤ))
    (Bv := B ^ 2) hP hQ (by positivity) (le_refl _) (le_refl _) (le_refl _)
    (by positivity) (by positivity) (by positivity) hgpos hg hD hDlow) ?_
  norm_num

end RadialGram


/-! ## The radial oscillatory bound for the Gram integral -/

section RadialGramBound

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

theorem norm_gramA_le (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2) (hB : 0 ≤ B)
    (t t' : ℝ) (ξ : Pl) (φ : ℝ) (ρ : ℝ) :
    ‖gramA b t t' ξ φ ρ‖ ≤ 2 * (2 : ℝ) ^ (j : ℤ) * B ^ 2 := by
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  by_cases hout : ρ ∈ OutAnn j
  · obtain ⟨h0, -, -⟩ := gram_vanish hb hray t t' ξ φ hout
    rw [h0, norm_zero]
    positivity
  · have hrange : |ρ| ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := by
      simp only [OutAnn, Set.mem_union, Set.mem_setOf_eq, not_or, not_lt] at hout
      exact hout.2
    have hP1 : (2 : ℝ) ^ ((j : ℤ) + 1) = 2 * (2 : ℝ) ^ (j : ℤ) := by
      rw [two_zpow_add]
      norm_num
      ring
    rw [hP1] at hrange
    have hcc : ‖cprod (rayb b t ξ φ) (rayb b t' ξ φ) ρ‖ ≤ B ^ 2 := by
      refine le_trans (norm_cprod_le ρ (hray.bd0 t ξ (pt ρ φ)) (hray.bd0 t' ξ (pt ρ φ)) hB)
        (le_of_eq ?_)
      ring
    rw [gramA]
    exact norm_ampl_le ρ hcc hrange (by positivity)

theorem continuous_gramA (hray : RayData j b B b1 b2) (t t' : ℝ) (ξ : Pl) (φ : ℝ) :
    Continuous (gramA b t t' ξ φ) :=
  continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_gramA hray t t' ξ φ ρ).continuousAt

theorem zero_mem_OutAnn (j : ℕ) : (0 : ℝ) ∈ OutAnn j := by
  refine Or.inl ?_
  simp only [Set.mem_setOf_eq, abs_zero]
  positivity

theorem two_zpow_add_two_mem_OutAnn (j : ℕ) : (2 : ℝ) ^ ((j : ℤ) + 2) ∈ OutAnn j := by
  refine Or.inr ?_
  simp only [Set.mem_setOf_eq]
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hP1 : (2 : ℝ) ^ ((j : ℤ) + 1) = 2 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]; norm_num; ring
  have hP2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 4 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]; norm_num; ring
  rw [abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) + 2)), hP1, hP2]
  linarith

/-- The trivial bound for the radial Gram integral. -/
theorem norm_radial_gram_trivial_le (hb : IsStrictlyAdapted j m b)
    (hray : RayData j b B b1 b2) (hB : 0 ≤ B) {ξ : Pl} {φ : ℝ}
    (hD : 0 < ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2) (t t' : ℝ) (lam : ℝ) :
    ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
        osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) * gramA b t t' ξ φ ρ‖
      ≤ 8 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * B ^ 2 := by
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hbbnn : (0 : ℝ) ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := by positivity
  have hcont : Continuous fun ρ => osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) *
      gramA b t t' ξ φ ρ :=
    (continuous_osc_comp (continuous_tauf hD)).mul (continuous_gramA hray t t' ξ φ)
  have hstep : ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
      osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) * gramA b t t' ξ φ ρ‖
      ≤ ∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
        ‖osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) * gramA b t t' ξ φ ρ‖ := by
    refine le_trans (intervalIntegral.norm_integral_le_abs_integral_norm) (le_of_eq ?_)
    refine abs_of_nonneg ?_
    exact intervalIntegral.integral_nonneg hbbnn fun ρ _ => norm_nonneg _
  refine le_trans hstep ?_
  have hbd : ∀ ρ ∈ Set.Icc (0 : ℝ) ((2 : ℝ) ^ ((j : ℤ) + 2)),
      ‖osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) * gramA b t t' ξ φ ρ‖
        ≤ 2 * (2 : ℝ) ^ (j : ℤ) * B ^ 2 := by
    intro ρ _
    rw [norm_mul, norm_osc, one_mul]
    exact norm_gramA_le hb hray hB t t' ξ φ ρ
  have hconstint : IntervalIntegrable (fun _ : ℝ => 2 * (2 : ℝ) ^ (j : ℤ) * B ^ 2)
      volume 0 ((2 : ℝ) ^ ((j : ℤ) + 2)) := intervalIntegrable_const
  have hmono := intervalIntegral.integral_mono_on hbbnn (hcont.norm.intervalIntegrable _ _)
    hconstint hbd
  refine le_trans hmono (le_of_eq ?_)
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
  have hP2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 4 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]; norm_num; ring
  rw [hP2]
  ring

/-- The oscillatory bound for the radial Gram integral. -/
theorem norm_radial_gram_le (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (hB : 0 ≤ B) {ξ : Pl} (hξ : XiData j ξ) {φ : ℝ} (hφ : φ ∈ AngSetStrict m ξ)
    (t t' : ℝ) {lam : ℝ} (hlam : lam ≠ 0) :
    ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
        osc lam (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) * gramA b t t' ξ φ ρ‖
      ≤ (lam ^ 2)⁻¹ * ((2 : ℝ) ^ (49 : ℕ) * B ^ 2 * ((2 : ℝ) ^ (m : ℤ)) ^ 4) := by
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hD : 0 < ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 := disc_pos hξ hφ
  have hbbnn : (0 : ℝ) ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := by positivity
  obtain ⟨hA0, hA10, -⟩ := gram_vanish hb hray t t' ξ φ (zero_mem_OutAnn j)
  obtain ⟨hAb, hA1b, -⟩ := gram_vanish hb hray t t' ξ φ (two_zpow_add_two_mem_OutAnn j)
  have hK : (0 : ℝ) ≤ (2 : ℝ) ^ (47 : ℕ) * B ^ 2 * ((2 : ℝ) ^ (m : ℤ)) ^ 4
      / (2 : ℝ) ^ (j : ℤ) := by positivity
  have hmain := norm_integral_radial_le hD
    (fun ρ => hasDerivAt_gramA hray t t' ξ φ ρ)
    (fun ρ => hasDerivAt_gramA1 hray t t' ξ φ ρ)
    (continuous_gramA2 hray t t' ξ φ) hlam hbbnn hA0 hAb
    (bfun_eq_zero hA0 hA10) (bfun_eq_zero hAb hA1b)
    hK (fun ρ hρ => norm_gram_cfun_le hb hray hB hξ hφ t t' hρ.1)
  refine le_trans hmain (le_of_eq ?_)
  congr 1
  have hP2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 4 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]; norm_num; ring
  rw [hP2]
  field_simp
  ring

end RadialGramBound


/-! ## The Gram integral in polar coordinates -/

section PolarGram

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

theorem measurableSet_AngSetStrict (m : ℕ) (ξ : Pl) : MeasurableSet (AngSetStrict m ξ) := by
  refine (measurableSet_AngSet m ξ).inter ?_
  exact measurableSet_le measurable_const (continuous_wfun ξ).abs.measurable

theorem AngSetStrict_subset_AngSet (m : ℕ) (ξ : Pl) : AngSetStrict m ξ ⊆ AngSet m ξ :=
  fun _ h => h.1

/-- The Gram integrand `K_t(ξ,·) conj K_{t'}(ξ,·)`. -/
def gramK (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (t t' : ℝ) (ξ : Pl) : Pl → ℂ :=
  fun η => Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)

theorem continuous_gramK (hray : RayData j b B b1 b2) (ε t t' : ℝ) (ξ : Pl) :
    Continuous (gramK ε b t t' ξ) := by
  have h1 : Continuous (Kern ε b t ξ) :=
    (continuous_phase_right ε t ξ).mul (hray.cont0 t ξ)
  have h2 : Continuous (Kern ε b t' ξ) :=
    (continuous_phase_right ε t' ξ).mul (hray.cont0 t' ξ)
  exact h1.mul (Complex.continuous_conj.comp h2)

theorem gramK_eq_zero_of_norm (hb : IsStrictlyAdapted j m b) (ε t t' : ℝ) (ξ : Pl)
    {η : Pl} (h : (2 : ℝ) ^ ((j : ℤ) + 1) < ‖η‖) : gramK ε b t t' ξ η = 0 := by
  have hz : b t ξ η = 0 := by
    refine hb.supp t ξ η ?_
    intro hmem
    exact absurd hmem.1.1.2.2.2 (not_le.mpr h)
  rw [gramK, Kern, hz, mul_zero, zero_mul]

theorem gramK_eq_zero_of_notMem (hb : IsStrictlyAdapted j m b) {ξ : Pl} (hξ : XiData j ξ)
    (ε t t' : ℝ) {φ : ℝ} (hφ : φ ∉ AngSetStrict m ξ) {r : ℝ} (hr : 0 < r) :
    gramK ε b t t' ξ (pt r φ) = 0 := by
  have hz : b t ξ (pt r φ) = 0 := by
    refine hb.supp t ξ (pt r φ) ?_
    intro hmem
    exact hφ (mem_AngSetStrict_of_mem hr hξ hmem)
  rw [gramK, Kern, hz, mul_zero, zero_mul]

/-- The radial Gram integral, rewritten as an interval integral of the oscillatory amplitude. -/
theorem radial_gram_integral_eq (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (ε t t' : ℝ) (ξ : Pl) (φ : ℝ) :
    (∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • gramK ε b t t' ξ (pt r φ))
      = ∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
          osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) *
            gramA b t t' ξ φ ρ := by
  classical
  set bb : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hbbdef
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hP1 : (2 : ℝ) ^ ((j : ℤ) + 1) = 2 * (2 : ℝ) ^ (j : ℤ) := by
    rw [two_zpow_add]; norm_num; ring
  have hP2 : bb = 4 * (2 : ℝ) ^ (j : ℤ) := by
    rw [hbbdef, two_zpow_add]; norm_num; ring
  have hbbpos : (0 : ℝ) < bb := by rw [hP2]; positivity
  set g : ℝ → ℂ := fun r => (r : ℝ) • gramK ε b t t' ξ (pt r φ) with hgdef
  have hcont : Continuous g := by
    rw [hgdef]
    exact continuous_id.smul ((continuous_gramK hray ε t t' ξ).comp (continuous_pt_fixed φ))
  have hzero : ∀ r, bb < r → g r = 0 := by
    intro r hr
    have hnorm : (2 : ℝ) ^ ((j : ℤ) + 1) < ‖pt r φ‖ := by
      rw [norm_pt_abs, abs_of_pos (lt_trans hbbpos hr)]
      rw [hP1, hP2] at *
      linarith
    rw [hgdef]
    simp only
    rw [gramK_eq_zero_of_norm hb ε t t' ξ hnorm, smul_zero]
  -- split `Ioi 0`
  have hsplit : Set.Ioi (0 : ℝ) = Set.Ioc 0 bb ∪ Set.Ioi bb :=
    (Set.Ioc_union_Ioi_eq_Ioi hbbpos.le).symm
  have hint1 : IntegrableOn g (Set.Ioc 0 bb) volume :=
    (hcont.integrableOn_Icc).mono_set Set.Ioc_subset_Icc_self
  have hint2 : IntegrableOn g (Set.Ioi bb) volume := by
    refine (integrableOn_zero (μ := (volume : Measure ℝ)) (s := Set.Ioi bb)).congr_fun ?_
      measurableSet_Ioi
    intro r hr
    exact (hzero r hr).symm
  have hdisj : Disjoint (Set.Ioc (0 : ℝ) bb) (Set.Ioi bb) := by
    rw [Set.disjoint_left]
    intro r hr1 hr2
    exact absurd hr2 (not_lt.mpr hr1.2)
  have hstep1 : (∫ r in Set.Ioi (0 : ℝ), g r) = ∫ r in Set.Ioc 0 bb, g r := by
    rw [hsplit, setIntegral_union hdisj measurableSet_Ioi hint1 hint2]
    have h2 : (∫ r in Set.Ioi bb, g r) = 0 := by
      rw [setIntegral_congr_fun measurableSet_Ioi (fun r hr => hzero r hr)]
      simp
    rw [h2, add_zero]
  rw [hstep1, ← intervalIntegral.integral_of_le hbbpos.le]
  refine intervalIntegral.integral_congr fun r hr => ?_
  have hr0 : 0 ≤ r := by
    rw [Set.uIcc_of_le hbbpos.le] at hr
    exact hr.1
  rw [hgdef]
  simp only [gramK]
  exact radial_integrand_eq ε t t' ξ φ hr0

end PolarGram


/-! ## The Gram matrix bound of §4.3 -/

section GramBound

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

theorem enorm_gram_integral_le_of (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    {ξ : Pl} (hξ : XiData j ξ) (ε t t' : ℝ) {M : ℝ}
    (hM : ∀ φ ∈ AngSetStrict m ξ,
      ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
        osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) *
          gramA b t t' ξ φ ρ‖ ≤ M) :
    ‖∫ η : Pl, gramK ε b t t' ξ η‖ₑ
      ≤ ENNReal.ofReal M * volume (AngSetStrict m ξ ∩ Set.Ioo (-π) π) := by
  refine enorm_integral_polar_le (continuous_gramK hray ε t t' ξ)
    (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
    (fun η h => gramK_eq_zero_of_norm hb ε t t' ξ h)
    (measurableSet_AngSetStrict m ξ) ?_
  intro φ
  by_cases hφ : φ ∈ AngSetStrict m ξ
  · rw [Set.indicator_of_mem hφ, radial_gram_integral_eq hb hray ε t t' ξ φ, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hM φ hφ)
  · rw [Set.indicator_of_notMem hφ]
    have h1 : (∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • gramK ε b t t' ξ (pt r φ))
        = ∫ _r in Set.Ioi (0 : ℝ), (0 : ℂ) := by
      refine setIntegral_congr_fun measurableSet_Ioi fun r hr => ?_
      rw [gramK_eq_zero_of_notMem hb hξ ε t t' hφ hr, smul_zero]
    rw [h1]
    simp

theorem volume_AngSetStrict_le {ξ : Pl} (hξ : XiData j ξ) :
    volume (AngSetStrict m ξ ∩ Set.Ioo (-π) π)
      ≤ ENNReal.ofReal ((2 : ℝ) ^ (12 : ℕ) / (2 : ℝ) ^ (m : ℤ)) := by
  refine le_trans (measure_mono (Set.inter_subset_inter_left _
    (AngSetStrict_subset_AngSet m ξ))) ?_
  refine le_trans (volume_AngSet_le hξ) (le_of_eq ?_)
  congr 1
  rw [show (12 : ℤ) - (m : ℤ) = 12 + -(m : ℤ) by ring, two_zpow_add, zpow_neg]
  norm_num
  ring

theorem gram_numeric_case1 {P Q Bv w : ℝ} (hP : 0 < P) (hQ : 0 < Q) (hBv : 0 ≤ Bv)
    (hw0 : 0 ≤ w) (hw : w ≤ 1) :
    8 * P ^ 2 * Bv * (2 ^ 12 / Q) ≤ 2 ^ 61 * Bv * P ^ 2 / Q * ((1 + w) ^ 2)⁻¹ := by
  have hpos : (0 : ℝ) < (1 + w) ^ 2 := by positivity
  have h4 : (1 + w) ^ 2 ≤ 4 := by nlinarith
  have hinv : (1 : ℝ) / 4 ≤ ((1 + w) ^ 2)⁻¹ := by
    rw [← one_div]
    exact one_div_le_one_div_of_le hpos h4
  have hnn : (0 : ℝ) ≤ 2 ^ 61 * Bv * P ^ 2 / Q := by positivity
  calc 8 * P ^ 2 * Bv * (2 ^ 12 / Q)
      = 2 ^ 61 * Bv * P ^ 2 / Q * (2 ^ 15 / 2 ^ 61) := by
        field_simp
        ring
    _ ≤ 2 ^ 61 * Bv * P ^ 2 / Q * (1 / 4) := by
        refine mul_le_mul_of_nonneg_left ?_ hnn
        norm_num
    _ ≤ 2 ^ 61 * Bv * P ^ 2 / Q * ((1 + w) ^ 2)⁻¹ := mul_le_mul_of_nonneg_left hinv hnn

set_option maxRecDepth 8000 in
theorem gram_numeric_case2 {P Q Bv s w : ℝ} (hP : 0 < P) (hQ : 0 < Q) (hBv : 0 ≤ Bv)
    (hs : s ≠ 0) (hw : 1 < w) (hwdef : w = P * |s| / Q ^ 2) :
    (4 * Real.pi ^ 2 * s ^ 2)⁻¹ * (2 ^ 49 * Bv * Q ^ 4) * (2 ^ 12 / Q)
      ≤ 2 ^ 61 * Bv * P ^ 2 / Q * ((1 + w) ^ 2)⁻¹ := by
  have hspos : (0 : ℝ) < s ^ 2 := by positivity
  have hπ : (1 : ℝ) ≤ Real.pi ^ 2 := by nlinarith [Real.two_le_pi]
  have hw0 : (0 : ℝ) < w := lt_trans zero_lt_one hw
  have hwsq : w ^ 2 = P ^ 2 * s ^ 2 / (Q ^ 2) ^ 2 := by
    rw [hwdef, div_pow, mul_pow, sq_abs]
  have hpos : (0 : ℝ) < (1 + w) ^ 2 := by positivity
  have hle : (1 + w) ^ 2 ≤ 4 * w ^ 2 := by nlinarith
  have hinv : (4 * w ^ 2)⁻¹ ≤ ((1 + w) ^ 2)⁻¹ := inv_anti₀ hpos hle
  have hnn : (0 : ℝ) ≤ 2 ^ 61 * Bv * P ^ 2 / Q := by positivity
  have hid : 2 ^ 61 * Bv * P ^ 2 / Q * (4 * w ^ 2)⁻¹
      = 2 ^ 61 * Bv * Q ^ 3 / (4 * s ^ 2) := by
    rw [hwsq]
    field_simp
  have hid2 : (4 * Real.pi ^ 2 * s ^ 2)⁻¹ * (2 ^ 49 * Bv * Q ^ 4) * (2 ^ 12 / Q)
      = 2 ^ 61 * Bv * Q ^ 3 / (4 * Real.pi ^ 2 * s ^ 2) := by
    field_simp
  calc (4 * Real.pi ^ 2 * s ^ 2)⁻¹ * (2 ^ 49 * Bv * Q ^ 4) * (2 ^ 12 / Q)
      = 2 ^ 61 * Bv * Q ^ 3 / (4 * Real.pi ^ 2 * s ^ 2) := hid2
    _ ≤ 2 ^ 61 * Bv * Q ^ 3 / (4 * s ^ 2) := by
        have hA : (0 : ℝ) ≤ 2 ^ 61 * Bv * Q ^ 3 := by positivity
        have hd : 4 * s ^ 2 ≤ 4 * Real.pi ^ 2 * s ^ 2 := by nlinarith [hπ, hspos]
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        exact mul_le_mul_of_nonneg_left hd hA
    _ = 2 ^ 61 * Bv * P ^ 2 / Q * (4 * w ^ 2)⁻¹ := hid.symm
    _ ≤ 2 ^ 61 * Bv * P ^ 2 / Q * ((1 + w) ^ 2)⁻¹ := mul_le_mul_of_nonneg_left hinv hnn

/-- **The Gram matrix bound.**  The `(t,t')` entry of the Gram matrix of the kernels is
`≲ B² 2^{2j-m} (1 + 2^{j-2m}|t-t'|)^{-2}`. -/
theorem enorm_gram_integral_le (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (hB : 0 ≤ B) {ξ : Pl} (hξ : XiData j ξ) {ε : ℝ} (hε : |ε| = 1) (t t' : ℝ) :
    ‖∫ η : Pl, gramK ε b t t' ξ η‖ₑ
      ≤ ENNReal.ofReal (2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 : ℝ) ^ (m : ℤ)
          * ((1 + (2 : ℝ) ^ (j : ℤ) * |t - t'| / ((2 : ℝ) ^ (m : ℤ)) ^ 2) ^ 2)⁻¹) := by
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hQ : (0 : ℝ) < (2 : ℝ) ^ (m : ℤ) := by positivity
  have hD : ∀ φ ∈ AngSetStrict m ξ, 0 < ‖ξ‖ ^ 2 - inner ℝ ξ (pt 1 φ) ^ 2 :=
    fun φ hφ => disc_pos hξ hφ
  have hvol := volume_AngSetStrict_le (j := j) (m := m) hξ
  set w : ℝ := (2 : ℝ) ^ (j : ℤ) * |t - t'| / ((2 : ℝ) ^ (m : ℤ)) ^ 2 with hwdef
  have hw0 : 0 ≤ w := by rw [hwdef]; positivity
  by_cases hcase : w ≤ 1
  · have hM : ∀ φ ∈ AngSetStrict m ξ,
        ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
          osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) *
            gramA b t t' ξ φ ρ‖ ≤ 8 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * B ^ 2 :=
      fun φ hφ => norm_radial_gram_trivial_le hb hray hB (hD φ hφ) t t' _
    refine le_trans (enorm_gram_integral_le_of hb hray hξ ε t t' hM) ?_
    refine le_trans (mul_le_mul' (le_refl _) hvol) ?_
    rw [← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    exact gram_numeric_case1 hP hQ (by positivity) hw0 hcase
  · push_neg at hcase
    have hs : t - t' ≠ 0 := by
      intro h
      rw [hwdef, h, abs_zero, mul_zero, zero_div] at hcase
      linarith
    have hεne : ε ≠ 0 := by
      intro h
      rw [h, abs_zero] at hε
      norm_num at hε
    have hlam : 2 * Real.pi * ε * (t - t') ≠ 0 :=
      mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero Real.pi_ne_zero) hεne) hs
    have hM : ∀ φ ∈ AngSetStrict m ξ,
        ‖∫ ρ in (0 : ℝ)..(2 : ℝ) ^ ((j : ℤ) + 2),
          osc (2 * Real.pi * ε * (t - t')) (tauf (inner ℝ ξ (pt 1 φ)) ‖ξ‖ ρ) *
            gramA b t t' ξ φ ρ‖
          ≤ ((2 * Real.pi * ε * (t - t')) ^ 2)⁻¹ *
            (2 ^ 49 * B ^ 2 * ((2 : ℝ) ^ (m : ℤ)) ^ 4) :=
      fun φ hφ => norm_radial_gram_le hb hray hB hξ hφ t t' hlam
    refine le_trans (enorm_gram_integral_le_of hb hray hξ ε t t' hM) ?_
    refine le_trans (mul_le_mul' (le_refl _) hvol) ?_
    rw [← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    have hεsq : ε ^ 2 = 1 := by
      rcases (abs_eq (by norm_num : (0 : ℝ) ≤ 1)).mp hε with h | h <;> rw [h] <;> norm_num
    have hlamsq : (2 * Real.pi * ε * (t - t')) ^ 2 = 4 * Real.pi ^ 2 * (t - t') ^ 2 := by
      calc (2 * Real.pi * ε * (t - t')) ^ 2
          = 4 * Real.pi ^ 2 * ε ^ 2 * (t - t') ^ 2 := by ring
        _ = 4 * Real.pi ^ 2 * (t - t') ^ 2 := by rw [hεsq]; ring
    rw [hlamsq]
    exact gram_numeric_case2 hP hQ (by positivity) hs hcase hwdef

end GramBound


/-! ## Proposition 4.2 -/

section Prop42

variable {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}

theorem norm_gram_integral_le (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (hB : 0 ≤ B) {ξ : Pl} (hξ : XiData j ξ) {ε : ℝ} (hε : |ε| = 1) (t t' : ℝ) :
    ‖∫ η : Pl, gramK ε b t t' ξ η‖
      ≤ 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 : ℝ) ^ (m : ℤ)
        * ((1 + (2 : ℝ) ^ (j : ℤ) * |t - t'| / ((2 : ℝ) ^ (m : ℤ)) ^ 2) ^ 2)⁻¹ := by
  have h := enorm_gram_integral_le hb hray hB hξ hε t t'
  rw [← ofReal_norm] at h
  exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp h

theorem gramK_eq_zero_of_empty (hb : IsStrictlyAdapted j m b) {ξ : Pl}
    (hempty : SuppSet j m ξ = ∅) (ε t t' : ℝ) (η : Pl) : gramK ε b t t' ξ η = 0 := by
  have hz : b t ξ η = 0 := by
    refine hb.supp t ξ η ?_
    intro hm
    have : η ∈ SuppSet j m ξ := SuppSetStrict_subset j m ξ hm
    rw [hempty] at this
    exact absurd this (Set.notMem_empty η)
  rw [gramK, Kern, hz, mul_zero, zero_mul]

set_option maxRecDepth 40000 in
/-- **Proposition 4.2** of Roos--Seeger (almost orthogonality).  If `b` is strictly
`(j,m)`-adapted with `|⟨η/|η|,∇⟩^N b| ≤ B 2^{-jN}` for `N = 0,1,2`, and `N` bounds the number of
points of `ℰ` in any interval of length `2^{2m-j}`, then
`‖S[F,b]‖²_{L²(ℝ²×ℰ)} ≤ c B² 2^{2j-m} N ‖F‖²_{L²(ℝ⁴)}`. -/
theorem prop42 (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2) (hB : 0 ≤ B)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) {N : ℝ} (hNnn : 0 ≤ N)
    (hN : IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ)) N)
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (12 * 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * N
          / (2 : ℝ) ^ (m : ℤ)) * ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  classical
  have hP : (0 : ℝ) < (2 : ℝ) ^ (j : ℤ) := by positivity
  have hQ : (0 : ℝ) < (2 : ℝ) ^ (m : ℤ) := by positivity
  set A : ℝ := 12 * 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * N / (2 : ℝ) ^ (m : ℤ) with hAdef
  have hAnn : (0 : ℝ) ≤ A := by rw [hAdef]; positivity
  -- the Gram row sums are bounded by `A`
  have hArow : ∀ ξ : Pl, ∀ t ∈ Efin, ∑ t' ∈ Efin,
      ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖ ≤ A := by
    intro ξ t ht
    rcases Set.eq_empty_or_nonempty (SuppSet j m ξ) with hempty | ⟨η₀, hη₀⟩
    · have hz : ∀ t' : ℝ, (∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)) = 0 := by
        intro t'
        have hpt : ∀ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η) = 0 :=
          fun η => gramK_eq_zero_of_empty hb hempty ε t t' η
        rw [integral_congr_ae (Filter.Eventually.of_forall hpt)]
        simp
      have hsum : (∑ t' ∈ Efin,
          ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖) = 0 := by
        refine Finset.sum_eq_zero fun t' _ => ?_
        rw [hz t', norm_zero]
      rw [hsum]
      exact hAnn
    · have hξ := xiData_of_mem hη₀
      have hterm : ∀ t' ∈ Efin,
          ‖∫ η, Kern ε b t ξ η * (starRingEnd ℂ) (Kern ε b t' ξ η)‖
            ≤ 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 : ℝ) ^ (m : ℤ)
              * ((1 + (2 : ℝ) ^ (j : ℤ) * |t - t'| / ((2 : ℝ) ^ (m : ℤ)) ^ 2) ^ 2)⁻¹ :=
        fun t' _ => norm_gram_integral_le hb hray hB hξ hε t t'
      refine le_trans (Finset.sum_le_sum hterm) ?_
      have hrw : (∑ t' ∈ Efin, 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 : ℝ) ^ (m : ℤ)
            * ((1 + (2 : ℝ) ^ (j : ℤ) * |t - t'| / ((2 : ℝ) ^ (m : ℤ)) ^ 2) ^ 2)⁻¹)
          = 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 / (2 : ℝ) ^ (m : ℤ)
            * ∑ t' ∈ Efin, ((1 + |t - t'| / (((2 : ℝ) ^ (m : ℤ)) ^ 2
              / (2 : ℝ) ^ (j : ℤ))) ^ 2)⁻¹ := by
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun t' _ => ?_
        congr 2
        field_simp
      rw [hrw]
      have hδ : (0 : ℝ) < ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ) := by positivity
      have hschur := schur_sum_le hδ hNnn hN t
      have hnn : (0 : ℝ) ≤ 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2
          / (2 : ℝ) ^ (m : ℤ) := by positivity
      refine le_trans (mul_le_mul_of_nonneg_left hschur hnn) (le_of_eq ?_)
      rw [hAdef]
      field_simp
  -- split on whether `A` is positive
  rcases eq_or_lt_of_le hAnn with hA0 | hApos
  · -- `A = 0`: either `B = 0` or `ℰ` is empty
    have hBN : B ^ 2 * N = 0 := by
      have hA : (12 : ℝ) * 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * N
          / (2 : ℝ) ^ (m : ℤ) = 0 := by rw [← hAdef]; exact hA0.symm
      rcases div_eq_zero_iff.mp hA with h1 | h1
      · have h2 : (12 * 2 ^ 61 * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * (B ^ 2 * N) = 0 := by
          linear_combination h1
        have hC : (0 : ℝ) < 12 * 2 ^ 61 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by positivity
        exact (mul_eq_zero.mp h2).resolve_left hC.ne'
      · exact absurd h1 hQ.ne'
    have hzero : ∀ t ∈ Efin, ∀ ξ : Pl, Sop ε b (F : Pl2 → ℂ) ξ t = 0 := by
      intro t ht ξ
      rcases mul_eq_zero.mp hBN with hB0 | hN0
      · have hb0 : ∀ η, b t ξ η = 0 := by
          intro η
          have h := hray.bd0 t ξ η
          have hBz : B = 0 := by nlinarith [sq_nonneg B]
          rw [hBz] at h
          exact norm_eq_zero.mp (le_antisymm h (norm_nonneg _))
        rw [Sop, SopK]
        have hpt : ∀ η, phase ε t ξ η * b t ξ η * 𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η) = 0 := by
          intro η
          rw [hb0 η, mul_zero, zero_mul]
        rw [integral_congr_ae (Filter.Eventually.of_forall hpt)]
        simp
      · exfalso
        have hcount := hN t
        have hmem : t ∈ Efin.filter (fun s => t ≤ s ∧
            s < t + ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ)) := by
          refine Finset.mem_filter.mpr ⟨ht, le_refl t, ?_⟩
          have : (0 : ℝ) < ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ) := by positivity
          linarith
        have hone : (1 : ℝ) ≤ ((Efin.filter (fun s => t ≤ s ∧
            s < t + ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))).card : ℝ) := by
          have h1 : 1 ≤ (Efin.filter (fun s => t ≤ s ∧
              s < t + ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))).card :=
            Finset.card_pos.mpr ⟨t, hmem⟩
          exact_mod_cast h1
        rw [hN0] at hcount
        linarith
    have hlhs : (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ)) = 0 := by
      refine Finset.sum_eq_zero fun t ht => ?_
      have hpt : ∀ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ) = 0 := by
        intro ξ
        rw [hzero t ht ξ]
        simp
      rw [lintegral_congr hpt]
      simp
    rw [hlhs]
    exact zero_le
  · have hmain := sum_lintegral_SopK_le hb.toIsAdapted (fun t ξ η => hray.bd0 t ξ η) hB ε Efin
      (measurable_fourier_schwartz F) hApos hArow
    rw [lintegral_enorm_sq_fourier_schwartz F] at hmain
    exact hmain

end Prop42


/-! ## Partial Plancherel on `ℝ⁴ = ℝ² × ℝ²`

The Fourier transform in the first planar variable is an `L²` isometry.  This is what turns the
support hypothesis of Proposition 4.3 (`F` supported far from the diagonal) into a statement about
the auxiliary function `G_ξ(w) = ∫ e^{-2πi⟪y,ξ⟫} F(y, y-w) dy`.
-/

section PartialPlancherel

theorem norm_pr_sq (a c : Pl) : ‖pr a c‖ ^ 2 = ‖a‖ ^ 2 + ‖c‖ ^ 2 := by
  have h : (inner ℝ (pr a c) (pr a c) : ℝ) = inner ℝ a a + inner ℝ c c := inner_pr a c a c
  rw [real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq, real_inner_self_eq_norm_sq] at h
  exact h

theorem norm_pr_right_zero (a : Pl) : ‖pr a 0‖ = ‖a‖ := by
  have h := norm_pr_sq a 0
  rw [norm_zero] at h
  nlinarith [norm_nonneg (pr a 0), norm_nonneg a, h]

theorem pr_eq_symm (a c : Pl) :
    pr a c = (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm (a, c) := rfl

theorem pr_sub_pr (y y' c : Pl) : pr y c - pr y' c = pr (y - y') 0 := by
  rw [pr_eq_symm, pr_eq_symm, pr_eq_symm, ← map_sub]
  congr 1
  simp [Prod.ext_iff]

/-- `y ↦ (y, 0)` as a continuous linear map into `ℝ⁴`. -/
def prL : Pl →L[ℝ] Pl2 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toContinuousLinearMap ∘L
    (ContinuousLinearMap.inl ℝ Pl Pl)

@[simp] theorem prL_apply (y : Pl) : prL y = pr y 0 := rfl

theorem pr_eq_prL_add (y c : Pl) : pr y c = prL y + pr 0 c := by
  rw [prL_apply, pr_eq_symm, pr_eq_symm, pr_eq_symm, ← map_add]
  congr 1
  simp [Prod.ext_iff]

theorem hasTemperateGrowth_prRight (c : Pl) :
    Function.HasTemperateGrowth (fun y : Pl => pr y c) := by
  have h : (fun y : Pl => pr y c) = fun y : Pl => prL y + pr 0 c := by
    funext y
    exact pr_eq_prL_add y c
  rw [h]
  exact (prL.hasTemperateGrowth).add (Function.HasTemperateGrowth.const _)

theorem antilipschitz_prRight (c : Pl) :
    AntilipschitzWith 1 (fun y : Pl => pr y c) := by
  refine AntilipschitzWith.of_le_mul_dist fun y y' => ?_
  have h : dist (pr y c) (pr y' c) = dist y y' := by
    rw [dist_eq_norm, dist_eq_norm, pr_sub_pr, norm_pr_right_zero]
  rw [h]
  simp

/-- The slice `y ↦ F (y, w)` of a Schwartz function on `ℝ⁴`, as a Schwartz function on `ℝ²`. -/
def sliceSchwartz (F : SchwartzMap Pl2 ℂ) (c : Pl) : SchwartzMap Pl ℂ :=
  SchwartzMap.compCLMOfAntilipschitz ℝ (hasTemperateGrowth_prRight c)
    (antilipschitz_prRight c) F

@[simp] theorem sliceSchwartz_apply (F : SchwartzMap Pl2 ℂ) (c y : Pl) :
    sliceSchwartz F c y = F (pr y c) := rfl

theorem eLpNorm_fourier_schwartz_Pl (F : SchwartzMap Pl ℂ) :
    eLpNorm (𝓕 (F : Pl → ℂ)) 2 (volume : Measure Pl)
      = eLpNorm ((F : Pl → ℂ)) 2 (volume : Measure Pl) := by
  have hnorm : ‖SchwartzMap.toLp (𝓕 F) 2 (volume : Measure Pl)‖
      = ‖SchwartzMap.toLp F 2 (volume : Measure Pl)‖ := by
    rw [← SchwartzMap.toLp_fourier_eq F]
    exact MeasureTheory.Lp.norm_fourier_eq _
  rw [SchwartzMap.norm_toLp, SchwartzMap.norm_toLp] at hnorm
  have h1 : eLpNorm ((𝓕 F : SchwartzMap Pl ℂ) : Pl → ℂ) 2 (volume : Measure Pl) ≠ ⊤ :=
    ((𝓕 F : SchwartzMap Pl ℂ).memLp 2 (volume : Measure Pl)).2.ne
  have h2 : eLpNorm ((F : Pl → ℂ)) 2 (volume : Measure Pl) ≠ ⊤ :=
    (F.memLp 2 (volume : Measure Pl)).2.ne
  have heq : eLpNorm ((𝓕 F : SchwartzMap Pl ℂ) : Pl → ℂ) 2 (volume : Measure Pl)
      = eLpNorm ((F : Pl → ℂ)) 2 (volume : Measure Pl) :=
    (ENNReal.toReal_eq_toReal_iff' h1 h2).mp hnorm
  rw [← SchwartzMap.fourier_coe F]
  exact heq

theorem lintegral_enorm_sq_fourier_schwartz_Pl (F : SchwartzMap Pl ℂ) :
    (∫⁻ x : Pl, ‖𝓕 (F : Pl → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(F : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have h1 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl) (𝓕 (F : Pl → ℂ))
  have h2 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl) ((F : Pl → ℂ))
  rw [Auto.CalderonVaillancourt.sqMass] at h1 h2
  rw [h1, h2, eLpNorm_fourier_schwartz_Pl]

/-- Partial Plancherel: the Fourier transform in the first planar variable preserves the `L²`
norm on `ℝ⁴`. -/
theorem lintegral_partial_plancherel (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ c : Pl, ∫⁻ ξ : Pl, ‖𝓕 (fun y : Pl => (F : Pl2 → ℂ) (pr y c)) ξ‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have hslice : ∀ c : Pl,
      (∫⁻ ξ : Pl, ‖𝓕 (fun y : Pl => (F : Pl2 → ℂ) (pr y c)) ξ‖ₑ ^ (2 : ℝ))
        = ∫⁻ y : Pl, ‖(F : Pl2 → ℂ) (pr y c)‖ₑ ^ (2 : ℝ) := by
    intro c
    exact lintegral_enorm_sq_fourier_schwartz_Pl (sliceSchwartz F c)
  rw [lintegral_congr hslice]
  have hmeas : Measurable fun q : Pl × Pl => ‖(F : Pl2 → ℂ) (pr q.1 q.2)‖ₑ ^ (2 : ℝ) := by
    have h1 : Measurable fun q : Pl × Pl => (pr q.1 q.2 : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact (((F.continuous.measurable).comp h1).enorm).pow_const _
  have hswap : (∫⁻ c : Pl, ∫⁻ y : Pl, ‖(F : Pl2 → ℂ) (pr y c)‖ₑ ^ (2 : ℝ))
      = ∫⁻ y : Pl, ∫⁻ c : Pl, ‖(F : Pl2 → ℂ) (pr y c)‖ₑ ^ (2 : ℝ) := by
    refine lintegral_lintegral_swap ?_
    have h2 : Measurable fun q : Pl × Pl => ‖(F : Pl2 → ℂ) (pr q.2 q.1)‖ₑ ^ (2 : ℝ) := by
      have h1 : Measurable fun q : Pl × Pl => (pr q.2 q.1 : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp
          (measurable_snd.prodMk measurable_fst)
      exact (((F.continuous.measurable).comp h1).enorm).pow_const _
    exact h2.aemeasurable
  rw [hswap]
  exact lintegral_pr (fun x => ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ))
    (((F.continuous.measurable).enorm).pow_const _)

end PartialPlancherel


/-! ## The shear `(y, z) ↦ (y, y - z)`

The support hypothesis of Proposition 4.3 is a condition on `|y - z|`; after the shear it becomes a
condition on the second variable, and the corresponding Fourier variable `w` produces the
oscillation `e^{2π i ⟪w, η⟫}` that the integration by parts in `η` exploits.
-/

section Shear

/-- The shear of `ℝ² × ℝ²`, as a linear map. -/
def sigmaLM : (Pl × Pl) →ₗ[ℝ] (Pl × Pl) :=
  (LinearMap.fst ℝ Pl Pl).prod ((LinearMap.fst ℝ Pl Pl) - (LinearMap.snd ℝ Pl Pl))

@[simp] theorem sigmaLM_apply (p : Pl × Pl) : sigmaLM p = (p.1, p.1 - p.2) := rfl

theorem sigmaLM_sigmaLM (p : Pl × Pl) : sigmaLM (sigmaLM p) = p := by
  rw [sigmaLM_apply, sigmaLM_apply]
  have h : p.1 - (p.1 - p.2) = p.2 := by abel
  rw [h]

/-- The shear of `ℝ² × ℝ²`, as a linear equivalence. -/
def sigmaLE : (Pl × Pl) ≃ₗ[ℝ] (Pl × Pl) :=
  LinearEquiv.ofLinear sigmaLM sigmaLM
    (LinearMap.ext fun p => sigmaLM_sigmaLM p)
    (LinearMap.ext fun p => sigmaLM_sigmaLM p)

@[simp] theorem sigmaLE_apply (p : Pl × Pl) : sigmaLE p = (p.1, p.1 - p.2) := rfl

/-- The shear of `ℝ⁴ = ℝ² × ℝ²`. -/
def shearCLE : Pl2 ≃L[ℝ] Pl2 :=
  ((WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).trans sigmaLE.toContinuousLinearEquiv).trans
    (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm

@[simp] theorem shearCLE_pr (y w : Pl) : shearCLE (pr y w) = pr y (y - w) := rfl

theorem shearCLE_involutive (x : Pl2) : shearCLE (shearCLE x) = x := by
  have hx : x = pr (WithLp.ofLp x).1 (WithLp.ofLp x).2 := rfl
  rw [hx, shearCLE_pr, shearCLE_pr]
  congr 1
  abel

/-- The shear preserves the `L²` mass. -/
theorem lintegral_comp_shear (h : Pl2 → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ x : Pl2, h (shearCLE x)) = ∫⁻ x : Pl2, h x := by
  have hmeas : Measurable fun q : Pl × Pl => h (shearCLE (pr q.1 q.2)) := by
    have h1 : Measurable fun q : Pl × Pl => (pr q.1 q.2 : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact hh.comp (shearCLE.continuous.measurable.comp h1)
  have hstep1 : (∫⁻ x : Pl2, h (shearCLE x))
      = ∫⁻ y : Pl, ∫⁻ w : Pl, h (shearCLE (pr y w)) :=
    (lintegral_pr (fun x => h (shearCLE x)) (hh.comp shearCLE.continuous.measurable)).symm
  have hinner : ∀ y : Pl, (∫⁻ w : Pl, h (shearCLE (pr y w))) = ∫⁻ z : Pl, h (pr y z) := by
    intro y
    have hpt : ∀ w : Pl, h (shearCLE (pr y w)) = (fun z : Pl => h (pr y z)) (y - w) := by
      intro w
      rw [shearCLE_pr]
    rw [lintegral_congr hpt]
    exact lintegral_sub_left_eq_self (fun z : Pl => h (pr y z)) y
  rw [hstep1, lintegral_congr hinner]
  exact lintegral_pr h hh

/-- The sheared Schwartz function `H = F ∘ shear`. -/
def shearSchwartz (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ shearCLE F

@[simp] theorem shearSchwartz_apply (F : SchwartzMap Pl2 ℂ) (x : Pl2) :
    shearSchwartz F x = F (shearCLE x) := rfl

theorem lintegral_enorm_sq_shearSchwartz (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ x : Pl2, ‖(shearSchwartz F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have hmeas : Measurable fun x : Pl2 => ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) :=
    ((F.continuous.measurable).enorm).pow_const _
  exact lintegral_comp_shear (fun x => ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ)) hmeas

theorem inner_shear_pr (y w ξ η : Pl) :
    (inner ℝ (shearCLE (pr y w)) (pr (ξ - η) η) : ℝ) = inner ℝ (pr y w) (pr ξ (-η)) := by
  rw [shearCLE_pr, inner_pr, inner_pr, inner_sub_right, inner_neg_right, inner_sub_left]
  ring

end Shear


/-! ## The `w`-representation of the Fourier transform -/

section WRep

/-- The Fourier kernel `e^{-2π i r}`. -/
def ee (r : ℝ) : ℂ := Complex.exp (((-2 * Real.pi * r : ℝ) : ℂ) * Complex.I)

@[simp] theorem norm_ee (r : ℝ) : ‖ee r‖ = 1 := by
  rw [ee, Complex.norm_exp_ofReal_mul_I]

theorem ee_add (r s : ℝ) : ee (r + s) = ee r * ee s := by
  rw [ee, ee, ee, ← Complex.exp_add]
  congr 1
  push_cast
  ring

theorem continuous_ee : Continuous ee := by
  refine Complex.continuous_exp.comp ?_
  exact (Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul
    continuous_const

theorem fourier_eq_ee_Pl (f : Pl → ℂ) (w : Pl) :
    𝓕 f w = ∫ v : Pl, ee (inner ℝ v w) * f v := by
  rw [Real.fourier_eq']
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [ee, smul_eq_mul]

theorem fourier_eq_ee_Pl2 (f : Pl2 → ℂ) (w : Pl2) :
    𝓕 f w = ∫ v : Pl2, ee (inner ℝ v w) * f v := by
  rw [Real.fourier_eq']
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [ee, smul_eq_mul]

theorem continuous_prPair : Continuous fun q : Pl × Pl => (pr q.1 q.2 : Pl2) :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.continuous

theorem measurePreserving_shear :
    MeasurePreserving shearCLE (volume : Measure Pl2) (volume : Measure Pl2) := by
  classical
  refine ⟨shearCLE.continuous.measurable, ?_⟩
  refine Measure.ext fun s hs => ?_
  rw [Measure.map_apply shearCLE.continuous.measurable hs]
  have hpre : MeasurableSet (shearCLE ⁻¹' s) := shearCLE.continuous.measurable hs
  have h := lintegral_comp_shear (Set.indicator s fun _ => (1 : ℝ≥0∞))
    (measurable_const.indicator hs)
  have hind : ∀ x : Pl2, Set.indicator s (fun _ => (1 : ℝ≥0∞)) (shearCLE x)
      = Set.indicator (shearCLE ⁻¹' s) (fun _ => (1 : ℝ≥0∞)) x := by
    intro x
    by_cases hx : shearCLE x ∈ s
    · rw [Set.indicator_of_mem hx,
        Set.indicator_of_mem (show x ∈ shearCLE ⁻¹' s from hx)]
    · rw [Set.indicator_of_notMem hx,
        Set.indicator_of_notMem (show x ∉ shearCLE ⁻¹' s from hx)]
  rw [lintegral_congr hind, lintegral_indicator hpre, setLIntegral_one,
    lintegral_indicator hs, setLIntegral_one] at h
  exact h

theorem integral_comp_shear (g : Pl2 → ℂ) :
    (∫ x : Pl2, g (shearCLE x)) = ∫ x : Pl2, g x :=
  measurePreserving_shear.integral_comp (shearCLE.toHomeomorph.measurableEmbedding) g

theorem inner_shear (x : Pl2) (ξ η : Pl) :
    (inner ℝ (shearCLE x) (pr (ξ - η) η) : ℝ) = inner ℝ x (pr ξ (-η)) := by
  have hx : x = pr (WithLp.ofLp x).1 (WithLp.ofLp x).2 := rfl
  rw [hx]
  exact inner_shear_pr _ _ ξ η

/-- The Fourier transform of `F` at `(ξ - η, η)` is that of the sheared function at `(ξ, -η)`. -/
theorem fourier_shear_eq (F : SchwartzMap Pl2 ℂ) (ξ η : Pl) :
    𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η)
      = 𝓕 ((shearSchwartz F : Pl2 → ℂ)) (pr ξ (-η)) := by
  rw [fourier_eq_ee_Pl2, fourier_eq_ee_Pl2,
    ← integral_comp_shear (fun x => ee (inner ℝ x (pr (ξ - η) η)) * (F : Pl2 → ℂ) x)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
  show ee (inner ℝ (shearCLE x) (pr (ξ - η) η)) * (F : Pl2 → ℂ) (shearCLE x)
      = ee (inner ℝ x (pr ξ (-η))) * (shearSchwartz F : Pl2 → ℂ) x
  rw [inner_shear x ξ η]
  rfl

/-- The partial Fourier transform in the first variable. -/
def Gf (H : Pl2 → ℂ) (ξ w : Pl) : ℂ := 𝓕 (fun y : Pl => H (pr y w)) ξ

theorem measurePreserving_prPair :
    MeasurePreserving (fun q : Pl × Pl => (pr q.1 q.2 : Pl2))
      ((volume : Measure (Pl × Pl))) (volume : Measure Pl2) :=
  WithLp.volume_preserving_toLp (U := Pl) (V := Pl)

/-- The Fourier transform of a Schwartz function on `ℝ⁴`, as an iterated transform. -/
theorem fourier_pr_eq (H : SchwartzMap Pl2 ℂ) (ξ ζ : Pl) :
    𝓕 (H : Pl2 → ℂ) (pr ξ ζ) = 𝓕 (fun w : Pl => Gf (H : Pl2 → ℂ) ξ w) ζ := by
  classical
  have hHprod : Integrable (fun q : Pl × Pl => (H : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) :=
    measurePreserving_prPair.integrable_comp_of_integrable H.integrable
  have hcont : Continuous fun q : Pl × Pl =>
      ee (inner ℝ q.1 ξ) * ee (inner ℝ q.2 ζ) * (H : Pl2 → ℂ) (pr q.1 q.2) := by
    have h1 : Continuous fun q : Pl × Pl => ee (inner ℝ q.1 ξ) :=
      continuous_ee.comp (continuous_fst.inner continuous_const)
    have h2 : Continuous fun q : Pl × Pl => ee (inner ℝ q.2 ζ) :=
      continuous_ee.comp (continuous_snd.inner continuous_const)
    have h3 : Continuous fun q : Pl × Pl => (H : Pl2 → ℂ) (pr q.1 q.2) :=
      H.continuous.comp continuous_prPair
    exact (h1.mul h2).mul h3
  have hI : Integrable (fun q : Pl × Pl =>
      ee (inner ℝ q.1 ξ) * ee (inner ℝ q.2 ζ) * (H : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) := by
    refine Integrable.mono' hHprod.norm hcont.aestronglyMeasurable
      (Filter.Eventually.of_forall fun q => ?_)
    rw [norm_mul, norm_mul, norm_ee, norm_ee, one_mul, one_mul]
  rw [fourier_eq_ee_Pl2, fourier_eq_ee_Pl]
  have hstep1 : (∫ v : Pl2, ee (inner ℝ v (pr ξ ζ)) * (H : Pl2 → ℂ) v)
      = ∫ q : Pl × Pl, ee (inner ℝ q.1 ξ) * ee (inner ℝ q.2 ζ) *
          (H : Pl2 → ℂ) (pr q.1 q.2) := by
    rw [← measurePreserving_prPair.integral_comp
      (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toHomeomorph.measurableEmbedding
      (fun v : Pl2 => ee (inner ℝ v (pr ξ ζ)) * (H : Pl2 → ℂ) v)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    show ee (inner ℝ (pr q.1 q.2) (pr ξ ζ)) * (H : Pl2 → ℂ) (pr q.1 q.2)
        = ee (inner ℝ q.1 ξ) * ee (inner ℝ q.2 ζ) * (H : Pl2 → ℂ) (pr q.1 q.2)
    rw [inner_pr, ee_add]
  have hfub : (∫ q : Pl × Pl, ee (inner ℝ q.1 ξ) * ee (inner ℝ q.2 ζ) *
        (H : Pl2 → ℂ) (pr q.1 q.2))
      = ∫ w : Pl, ∫ y : Pl, ee (inner ℝ y ξ) * ee (inner ℝ w ζ) *
        (H : Pl2 → ℂ) (pr y w) :=
    integral_prod_symm _ hI
  rw [hstep1, hfub]
  refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
  show (∫ y : Pl, ee (inner ℝ y ξ) * ee (inner ℝ w ζ) * (H : Pl2 → ℂ) (pr y w))
      = ee (inner ℝ w ζ) * Gf (H : Pl2 → ℂ) ξ w
  rw [Gf, fourier_eq_ee_Pl, ← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  ring

end WRep


/-! ## Integration by parts on the plane

For a compactly supported `C¹` function the integral of a directional derivative vanishes.  This
is the two-dimensional integration by parts used in §4.4.
-/

section PlanarIBP

/-- One dimension: the integral of the derivative of a compactly supported `C¹` function is `0`. -/
theorem integral_deriv_eq_zero {g g' : ℝ → ℂ} (hg : ∀ x, HasDerivAt g (g' x) x)
    (hg'c : Continuous g') (hgs : HasCompactSupport g) :
    (∫ x : ℝ, g' x) = 0 := by
  have hderiv : ∀ x, deriv g x = g' x := fun x => (hg x).deriv
  have hg's : HasCompactSupport g' := by
    have h := hgs.deriv
    refine HasCompactSupport.intro h.isCompact fun x hx => ?_
    rw [← hderiv x]
    exact image_eq_zero_of_notMem_tsupport hx
  obtain ⟨R, hR⟩ : ∃ R : ℝ, 0 < R ∧ ∀ x, R < |x| → g x = 0 ∧ g' x = 0 := by
    obtain ⟨R1, hR1⟩ := (hgs.isCompact.union hg's.isCompact).isBounded.subset_closedBall 0
    refine ⟨max R1 1 + 1, by positivity, fun x hx => ?_⟩
    have hnot : x ∉ tsupport g ∪ tsupport g' := by
      intro hmem
      have := hR1 hmem
      rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at this
      have h2 : R1 ≤ max R1 1 := le_max_left _ _
      linarith
    refine ⟨image_eq_zero_of_notMem_tsupport (fun h => hnot (Or.inl h)),
      image_eq_zero_of_notMem_tsupport (fun h => hnot (Or.inr h))⟩
  obtain ⟨hRpos, hRz⟩ := hR
  have hzero : ∀ x, x ∉ Set.Icc (-(R + 1)) (R + 1) → g' x = 0 := by
    intro x hx
    refine (hRz x ?_).2
    rw [Set.mem_Icc] at hx
    push_neg at hx
    rcases lt_or_ge x (-(R + 1)) with h | h
    · rw [abs_of_neg (by linarith)]
      linarith
    · have h2 : R + 1 < x := hx h
      rw [abs_of_pos (by linarith)]
      linarith
  have hint : (∫ x : ℝ, g' x) = ∫ x in Set.Icc (-(R + 1)) (R + 1), g' x :=
    (setIntegral_eq_integral_of_forall_compl_eq_zero hzero).symm
  rw [hint]
  have hIcc : (∫ x in Set.Icc (-(R + 1)) (R + 1), g' x)
      = ∫ x in (-(R + 1))..(R + 1), g' x := by
    rw [intervalIntegral.integral_of_le (by linarith), ← MeasureTheory.integral_Icc_eq_integral_Ioc]
  rw [hIcc, intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hg x)
    (hg'c.intervalIntegrable _ _)]
  have h1 : g (R + 1) = 0 := (hRz (R + 1) (by rw [abs_of_pos (by linarith)]; linarith)).1
  have h2 : g (-(R + 1)) = 0 := (hRz (-(R + 1)) (by
    rw [abs_of_neg (by linarith)]; linarith)).1
  rw [h1, h2, sub_zero]

/-- The unit vectors of the plane. -/
def ee0 : Pl := EuclideanSpace.single (0 : Fin 2) (1 : ℝ)

/-- The unit vectors of the plane. -/
def ee1 : Pl := EuclideanSpace.single (1 : Fin 2) (1 : ℝ)

theorem mk2_eq_add (x y : ℝ) : mk2 x y = x • ee0 + y • ee1 := rfl

theorem hasDerivAt_mk2_fst (y : ℝ) (x : ℝ) :
    HasDerivAt (fun s : ℝ => mk2 s y) ee0 x := by
  have h : (fun s : ℝ => mk2 s y) = fun s : ℝ => s • ee0 + y • ee1 := by
    funext s
    exact mk2_eq_add s y
  rw [h]
  have h1 : HasDerivAt (fun s : ℝ => s • ee0) ee0 x := by
    simpa using (hasDerivAt_id x).smul_const ee0
  exact h1.add_const _

theorem hasDerivAt_mk2_snd (x : ℝ) (y : ℝ) :
    HasDerivAt (fun s : ℝ => mk2 x s) ee1 y := by
  have h : (fun s : ℝ => mk2 x s) = fun s : ℝ => x • ee0 + s • ee1 := by
    funext s
    exact mk2_eq_add x s
  rw [h]
  have h1 : HasDerivAt (fun s : ℝ => s • ee1) ee1 y := by
    simpa using (hasDerivAt_id y).smul_const ee1
  exact h1.const_add _

theorem mk2_coords (x : Pl) : mk2 (x 0) (x 1) = x := by
  refine PiLp.ext fun i => ?_
  by_cases h : i = 0
  · subst h
    rw [mk2_apply_zero]
  · have h1 : i = 1 := by omega
    subst h1
    rw [mk2_apply_one]

theorem norm_mk2_ge (x y : ℝ) : ‖(x, y)‖ ≤ ‖mk2 x y‖ := by
  have hsq : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := norm_mk2_sq x y
  have hx : |x| ≤ ‖mk2 x y‖ := by
    nlinarith [abs_nonneg x, norm_nonneg (mk2 x y), sq_abs x, sq_nonneg y]
  have hy : |y| ≤ ‖mk2 x y‖ := by
    nlinarith [abs_nonneg y, norm_nonneg (mk2 x y), sq_abs y, sq_nonneg x]
  rw [Prod.norm_def, Real.norm_eq_abs, Real.norm_eq_abs]
  exact max_le hx hy

theorem hasCompactSupport_comp_mk2 {D : Pl → ℂ} (hD : HasCompactSupport D) :
    HasCompactSupport fun p : ℝ × ℝ => D (mk2 p.1 p.2) := by
  obtain ⟨R, hR⟩ := hD.isCompact.isBounded.subset_closedBall 0
  refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ × ℝ) R) fun p hp => ?_
  refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
  have h1 := hR hmem
  rw [Metric.mem_closedBall, dist_zero_right] at h1
  rw [Metric.mem_closedBall, dist_zero_right] at hp
  exact hp (le_trans (norm_mk2_ge p.1 p.2) h1)

theorem hasCompactSupport_slice_fst {f : Pl → ℂ} (hf : HasCompactSupport f) (y : ℝ) :
    HasCompactSupport fun x : ℝ => f (mk2 x y) := by
  obtain ⟨R, hR⟩ := hf.isCompact.isBounded.subset_closedBall 0
  refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun x hx => ?_
  refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
  have h1 := hR hmem
  rw [Metric.mem_closedBall, dist_zero_right] at h1
  have h2 : |x| ≤ ‖mk2 x y‖ := by
    have hsq : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := norm_mk2_sq x y
    nlinarith [abs_nonneg x, norm_nonneg (mk2 x y), sq_abs x, sq_nonneg y]
  have h3 : |x| ≤ R := le_trans h2 h1
  rw [abs_le] at h3
  exact hx ⟨h3.1, h3.2⟩

/-- Two dimensions: the integral of the partial derivative in the first coordinate direction of a
compactly supported `C¹` function vanishes. -/
theorem integral_partial_fst_eq_zero {f D : Pl → ℂ}
    (hD : ∀ x y : ℝ, HasDerivAt (fun s : ℝ => f (mk2 s y)) (D (mk2 x y)) x)
    (hDc : Continuous D) (hDs : HasCompactSupport D) (hfs : HasCompactSupport f) :
    (∫ η : Pl, D η) = 0 := by
  have hDmk : Continuous fun p : ℝ × ℝ => D (mk2 p.1 p.2) := hDc.comp continuous_mk2
  have hI : Integrable (fun p : ℝ × ℝ => D (mk2 p.1 p.2)) (volume : Measure (ℝ × ℝ)) :=
    hDmk.integrable_of_hasCompactSupport (hasCompactSupport_comp_mk2 hDs)
  have hstep1 : (∫ η : Pl, D η) = ∫ p : ℝ × ℝ, D (mk2 p.1 p.2) := by
    rw [← measurePreserving_coords.integral_comp coords.measurableEmbedding
      (fun p : ℝ × ℝ => D (mk2 p.1 p.2))]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    show D x = D (mk2 (x 0) (x 1))
    rw [mk2_coords]
  have hfub : (∫ p : ℝ × ℝ, D (mk2 p.1 p.2)) = ∫ y : ℝ, ∫ x : ℝ, D (mk2 x y) :=
    integral_prod_symm _ hI
  rw [hstep1, hfub]
  have hinner : ∀ y : ℝ, (∫ x : ℝ, D (mk2 x y)) = 0 := by
    intro y
    exact integral_deriv_eq_zero (fun x => hD x y)
      (hDc.comp (continuous_mk2.comp (continuous_id.prodMk continuous_const)))
      (hasCompactSupport_slice_fst hfs y)
  rw [integral_congr_ae (Filter.Eventually.of_forall hinner)]
  simp

theorem hasCompactSupport_slice_snd {f : Pl → ℂ} (hf : HasCompactSupport f) (x : ℝ) :
    HasCompactSupport fun y : ℝ => f (mk2 x y) := by
  obtain ⟨R, hR⟩ := hf.isCompact.isBounded.subset_closedBall 0
  refine HasCompactSupport.intro (isCompact_Icc (a := -R) (b := R)) fun y hy => ?_
  refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
  have h1 := hR hmem
  rw [Metric.mem_closedBall, dist_zero_right] at h1
  have h2 : |y| ≤ ‖mk2 x y‖ := by
    have hsq : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := norm_mk2_sq x y
    nlinarith [abs_nonneg y, norm_nonneg (mk2 x y), sq_abs y, sq_nonneg x]
  have h3 : |y| ≤ R := le_trans h2 h1
  rw [abs_le] at h3
  exact hy ⟨h3.1, h3.2⟩

/-- The same statement in the second coordinate direction. -/
theorem integral_partial_snd_eq_zero {f D : Pl → ℂ}
    (hD : ∀ x y : ℝ, HasDerivAt (fun s : ℝ => f (mk2 x s)) (D (mk2 x y)) y)
    (hDc : Continuous D) (hDs : HasCompactSupport D) (hfs : HasCompactSupport f) :
    (∫ η : Pl, D η) = 0 := by
  have hDmk : Continuous fun p : ℝ × ℝ => D (mk2 p.1 p.2) := hDc.comp continuous_mk2
  have hI : Integrable (fun p : ℝ × ℝ => D (mk2 p.1 p.2)) (volume : Measure (ℝ × ℝ)) :=
    hDmk.integrable_of_hasCompactSupport (hasCompactSupport_comp_mk2 hDs)
  have hstep1 : (∫ η : Pl, D η) = ∫ p : ℝ × ℝ, D (mk2 p.1 p.2) := by
    rw [← measurePreserving_coords.integral_comp coords.measurableEmbedding
      (fun p : ℝ × ℝ => D (mk2 p.1 p.2))]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    show D x = D (mk2 (x 0) (x 1))
    rw [mk2_coords]
  have hfub : (∫ p : ℝ × ℝ, D (mk2 p.1 p.2)) = ∫ x : ℝ, ∫ y : ℝ, D (mk2 x y) :=
    integral_prod _ hI
  rw [hstep1, hfub]
  have hinner : ∀ x : ℝ, (∫ y : ℝ, D (mk2 x y)) = 0 := by
    intro x
    exact integral_deriv_eq_zero (fun y => hD x y)
      (hDc.comp (continuous_mk2.comp (continuous_const.prodMk continuous_id)))
      (hasCompactSupport_slice_snd hfs x)
  rw [integral_congr_ae (Filter.Eventually.of_forall hinner)]
  simp

end PlanarIBP




/-! ## The phase of §4.4

`ph ε t ξ w η = ⟪w, η⟫ + ε t (|ξ - η| + |η|)`; its partial derivative in a coordinate direction is
`w_i + ε t (η_i/|η| - (ξ-η)_i/|ξ-η|)`, which is dominated by `w_i` once `|w|` is much larger than
the angle `2^{-m}`.
-/

section Phase44

/-- The derivative of `r ↦ ‖η + r • u‖` at `s`, for a unit vector `u`. -/
theorem hasDerivAt_norm_line {u : Pl} (hu : ‖u‖ = 1) (η : Pl) {s : ℝ}
    (hs : η + s • u ≠ 0) :
    HasDerivAt (fun r : ℝ => ‖η + r • u‖)
      ((inner ℝ (η + s • u) u : ℝ) / ‖η + s • u‖) s := by
  set a : ℝ := inner ℝ η u with hadef
  set P : ℝ → ℝ := fun r => ‖η‖ ^ 2 + 2 * r * a + r ^ 2 with hPdef
  have hnorm : ∀ r : ℝ, ‖η + r • u‖ = Real.sqrt (P r) := by
    intro r
    have hsq : ‖η + r • u‖ ^ 2 = P r := by
      rw [norm_add_sq_real, real_inner_smul_right, norm_smul, hu, mul_one, Real.norm_eq_abs,
        sq_abs, hPdef, hadef]
      ring
    rw [← hsq, Real.sqrt_sq (norm_nonneg _)]
  have hPs : 0 < P s := by
    have h : ‖η + s • u‖ ^ 2 = P s := by
      rw [hnorm s, Real.sq_sqrt]
      exact le_of_lt (by
        have h2 : ‖η + s • u‖ ^ 2 = ‖η‖ ^ 2 + 2 * s * a + s ^ 2 := by
          rw [norm_add_sq_real, real_inner_smul_right, norm_smul, hu, mul_one, Real.norm_eq_abs,
            sq_abs, hadef]
          ring
        have h3 : (0 : ℝ) < ‖η + s • u‖ := norm_pos_iff.mpr hs
        rw [hPdef]
        nlinarith [h2, h3])
    have h3 : (0 : ℝ) < ‖η + s • u‖ := norm_pos_iff.mpr hs
    nlinarith [h, h3]
  have hPd : HasDerivAt P (2 * a + 2 * s) s := by
    have h1 : HasDerivAt (fun r : ℝ => ‖η‖ ^ 2 + 2 * r * a) (2 * a) s := by
      have h2 : HasDerivAt (fun r : ℝ => 2 * r * a) (2 * a) s := by
        have h3 : HasDerivAt (fun r : ℝ => 2 * r) 2 s := by
          simpa using (hasDerivAt_id s).const_mul (2 : ℝ)
        simpa using h3.mul_const a
      exact h2.const_add _
    have h4 : HasDerivAt (fun r : ℝ => r ^ 2) (2 * s) s := by
      simpa using hasDerivAt_pow 2 s
    exact h1.add h4
  have hsq := (Real.hasDerivAt_sqrt hPs.ne').comp s hPd
  have hcongr : (fun r : ℝ => ‖η + r • u‖) = fun r : ℝ => Real.sqrt (P r) := by
    funext r
    exact hnorm r
  rw [hcongr]
  have heq : 1 / (2 * Real.sqrt (P s)) * (2 * a + 2 * s)
      = (inner ℝ (η + s • u) u : ℝ) / ‖η + s • u‖ := by
    have hinner : (inner ℝ (η + s • u) u : ℝ) = a + s := by
      rw [inner_add_left, real_inner_smul_left, hadef, real_inner_self_eq_norm_sq, hu]
      ring
    have hne : ‖η + s • u‖ ≠ 0 := (norm_pos_iff.mpr hs).ne'
    rw [hinner, ← hnorm s]
    field_simp
  rw [heq] at hsq
  exact hsq

/-- The phase of §4.4. -/
def ph (ε t : ℝ) (ξ w η : Pl) : ℝ := inner ℝ w η + ε * t * (‖ξ - η‖ + ‖η‖)

/-- Its partial derivative in the direction `u`. -/
def phd (ε t : ℝ) (ξ w η u : Pl) : ℝ :=
  inner ℝ w u + ε * t * (-(inner ℝ (ξ - η) u / ‖ξ - η‖) + inner ℝ η u / ‖η‖)

theorem hasDerivAt_ph {u : Pl} (hu : ‖u‖ = 1) (ε t : ℝ) (ξ w η : Pl)
    (hη : η ≠ 0) (hξη : ξ - η ≠ 0) :
    HasDerivAt (fun r : ℝ => ph ε t ξ w (η + r • u)) (phd ε t ξ w η u) 0 := by
  have h1 : HasDerivAt (fun r : ℝ => (inner ℝ w (η + r • u) : ℝ)) (inner ℝ w u) 0 := by
    have h : (fun r : ℝ => (inner ℝ w (η + r • u) : ℝ))
        = fun r : ℝ => inner ℝ w η + r * inner ℝ w u := by
      funext r
      rw [inner_add_right, real_inner_smul_right]
    rw [h]
    have h2 : HasDerivAt (fun r : ℝ => r * (inner ℝ w u : ℝ)) (inner ℝ w u) 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).mul_const (inner ℝ w u : ℝ)
    exact h2.const_add _
  have h2 : HasDerivAt (fun r : ℝ => ‖η + r • u‖) ((inner ℝ η u : ℝ) / ‖η‖) 0 := by
    have h := hasDerivAt_norm_line hu η (s := 0) (by simpa using hη)
    simpa using h
  have h3 : HasDerivAt (fun r : ℝ => ‖ξ - (η + r • u)‖)
      (-((inner ℝ (ξ - η) u : ℝ) / ‖ξ - η‖)) 0 := by
    have hline : (fun r : ℝ => ‖ξ - (η + r • u)‖)
        = fun r : ℝ => ‖(ξ - η) + r • (-u)‖ := by
      funext r
      congr 1
      rw [smul_neg]
      abel
    have hnu : ‖-u‖ = 1 := by rw [norm_neg]; exact hu
    have h := hasDerivAt_norm_line hnu (ξ - η) (s := 0) (by simpa using hξη)
    rw [hline]
    have heq : (inner ℝ ((ξ - η) + (0 : ℝ) • (-u)) (-u) : ℝ) / ‖(ξ - η) + (0 : ℝ) • (-u)‖
        = -((inner ℝ (ξ - η) u : ℝ) / ‖ξ - η‖) := by
      simp only [zero_smul, add_zero, inner_neg_right]
      ring
    rw [← heq]
    exact h
  have hsum : HasDerivAt (fun r : ℝ => ‖ξ - (η + r • u)‖ + ‖η + r • u‖)
      (-((inner ℝ (ξ - η) u : ℝ) / ‖ξ - η‖) + (inner ℝ η u : ℝ) / ‖η‖) 0 := h3.add h2
  have hfin := h1.add (hsum.const_mul (ε * t))
  have hcongr : (fun r : ℝ => ph ε t ξ w (η + r • u))
      = fun r : ℝ => (inner ℝ w (η + r • u) : ℝ) +
        ε * t * (‖ξ - (η + r • u)‖ + ‖η + r • u‖) := by
    funext r
    rw [ph]
  rw [hcongr, phd]
  exact hfin

end Phase44


/-! ## The gradient of the phase is dominated by `w`

The difference of the two unit vectors `η/|η|` and `(ξ-η)/|ξ-η|` has norm at most the angle
between them, which on the support of a `(j,m)`-adapted symbol is `≲ 2^{-m}`.
-/

section UnitDiff

theorem norm_unit_diff_le {x y : Pl} (hx : x ≠ 0) (hy : y ≠ 0) :
    ‖‖x‖⁻¹ • x - ‖y‖⁻¹ • y‖ ≤ InnerProductGeometry.angle x y := by
  set α := InnerProductGeometry.angle x y with hα
  have hxpos : (0 : ℝ) < ‖x‖ := norm_pos_iff.mpr hx
  have hypos : (0 : ℝ) < ‖y‖ := norm_pos_iff.mpr hy
  have hu : ‖‖x‖⁻¹ • x‖ = 1 := by
    rw [norm_smul, norm_inv, norm_norm]
    field_simp
  have hv : ‖‖y‖⁻¹ • y‖ = 1 := by
    rw [norm_smul, norm_inv, norm_norm]
    field_simp
  have hinner : (inner ℝ (‖x‖⁻¹ • x) (‖y‖⁻¹ • y) : ℝ) = Real.cos α := by
    rw [real_inner_smul_left, real_inner_smul_right]
    have hcos : Real.cos α * (‖x‖ * ‖y‖) = inner ℝ x y :=
      InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
    rw [← hcos]
    field_simp
  have hsq : ‖‖x‖⁻¹ • x - ‖y‖⁻¹ • y‖ ^ 2 = 2 - 2 * Real.cos α := by
    rw [norm_sub_sq_real, hu, hv, hinner]
    ring
  have hα0 : 0 ≤ α := InnerProductGeometry.angle_nonneg x y
  have hαπ : α ≤ π := InnerProductGeometry.angle_le_pi x y
  have hhalf : Real.cos α = 1 - 2 * Real.sin (α / 2) ^ 2 := by
    have h := Real.cos_two_mul' (α / 2)
    rw [show 2 * (α / 2) = α by ring] at h
    have h2 := Real.sin_sq_add_cos_sq (α / 2)
    nlinarith [h, h2]
  have hsinnn : 0 ≤ Real.sin (α / 2) :=
    Real.sin_nonneg_of_nonneg_of_le_pi (by linarith) (by linarith [Real.pi_pos])
  have hsinle : Real.sin (α / 2) ≤ α / 2 := Real.sin_le (by linarith)
  have hsq2 : ‖‖x‖⁻¹ • x - ‖y‖⁻¹ • y‖ ^ 2 = (2 * Real.sin (α / 2)) ^ 2 := by
    rw [hsq, hhalf]
    ring
  have hnn : (0 : ℝ) ≤ 2 * Real.sin (α / 2) := by linarith
  have heq : ‖‖x‖⁻¹ • x - ‖y‖⁻¹ • y‖ = 2 * Real.sin (α / 2) := by
    nlinarith [norm_nonneg (‖x‖⁻¹ • x - ‖y‖⁻¹ • y), hsq2, hnn]
  rw [heq]
  linarith

/-- On the support of a `(j,m)`-adapted symbol the angle between `η` and `ξ - η` is at most
`2^{9-m}`. -/
theorem angle_eta_le {j m : ℕ} {ξ η : Pl} (hξ : XiData j ξ) (h : η ∈ SuppSet j m ξ) :
    InnerProductGeometry.angle η (ξ - η) ≤ (2 : ℝ) ^ (9 - (m : ℤ)) := by
  obtain ⟨hηT, hξηT, hang⟩ := h
  set β := InnerProductGeometry.angle η (ξ - η) with hβ
  have hβ0 : 0 ≤ β := InnerProductGeometry.angle_nonneg _ _
  -- the cone bound
  have hcone := angle_le_of_cone hηT.1 (Theta.snd_pos hηT) hηT.2.1
    hξηT.1 (Theta.snd_pos hξηT) hξηT.2.1
  rw [← hβ] at hcone
  -- the sine rule: `sin β = sin∠(η,ξ) ‖ξ‖ / ‖ξ - η‖`
  have hηpos : (0 : ℝ) < ‖η‖ := lt_of_lt_of_le (by positivity) hηT.2.2.1
  have hξηpos : (0 : ℝ) < ‖ξ - η‖ := lt_of_lt_of_le (by positivity) hξηT.2.2.1
  have hdeteq : det2 η (ξ - η) = det2 η ξ := by
    rw [det2, det2]
    simp only [PiLp.sub_apply]
    ring
  have hsinβ := sin_angle_eq η (ξ - η)
  rw [← hβ, hdeteq] at hsinβ
  -- `|det2 η ξ| = ‖η‖ ‖ξ‖ sin ∠(ξ,η)`
  have hsinξη := sin_angle_eq ξ η
  have hdetsymm : |det2 η ξ| = |det2 ξ η| := by
    rw [det2, det2, ← abs_neg]
    congr 1
    ring
  -- combine
  have hkey : Real.sin β * ‖ξ - η‖
      = Real.sin (InnerProductGeometry.angle ξ η) * ‖ξ‖ := by
    have h1 : Real.sin β * (‖η‖ * ‖ξ - η‖) = |det2 η ξ| := hsinβ
    have h2 : Real.sin (InnerProductGeometry.angle ξ η) * (‖ξ‖ * ‖η‖) = |det2 ξ η| := hsinξη
    rw [hdetsymm] at h1
    have h3 : Real.sin β * (‖η‖ * ‖ξ - η‖)
        = Real.sin (InnerProductGeometry.angle ξ η) * (‖ξ‖ * ‖η‖) := by rw [h1, h2]
    have hne : ‖η‖ ≠ 0 := hηpos.ne'
    field_simp at h3
    nlinarith [h3, hηpos]
  -- the numeric bound
  have hsinle : Real.sin (InnerProductGeometry.angle ξ η)
      ≤ (2 : ℝ) ^ (5 - (m : ℤ)) := by
    refine le_trans (Real.sin_le (InnerProductGeometry.angle_nonneg ξ η)) hang
  have hnormξ := hξ.norm_le
  have hsinβle : Real.sin β ≤ (2 : ℝ) ^ (8 - (m : ℤ)) := by
    have hlow := hξηT.2.2.1
    have hstep : Real.sin β * ‖ξ - η‖ ≤ (2 : ℝ) ^ (5 - (m : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 2) := by
      rw [hkey]
      refine mul_le_mul hsinle hnormξ (norm_nonneg _) (by positivity)
    have hid : (2 : ℝ) ^ (5 - (m : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 2)
        = (2 : ℝ) ^ (8 - (m : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 1) := by
      rw [← two_zpow_add, ← two_zpow_add]
      congr 1
      ring
    rw [hid] at hstep
    have hpos : (0 : ℝ) < (2 : ℝ) ^ ((j : ℤ) - 1) := by positivity
    have hsinnn : 0 ≤ Real.sin β :=
      Real.sin_nonneg_of_nonneg_of_le_pi hβ0 (InnerProductGeometry.angle_le_pi _ _)
    nlinarith [hstep, hlow, hpos, hsinnn]
  -- `β ≤ (π/2) sin β` since `β ≤ 2 ^ (-9) ≤ π / 2`
  have hle : (2 : ℝ) ^ (-(9 : ℤ)) ≤ π / 2 := by
    have h1 : (1 : ℝ) ≤ π / 2 := Real.one_le_pi_div_two
    have h2 : (2 : ℝ) ^ (-(9 : ℤ)) ≤ 1 := by
      rw [zpow_neg]
      norm_num
    linarith
  have hkey2 : β ≤ (π / 2) * Real.sin β := by
    have h := Real.mul_le_sin hβ0 (le_trans hcone hle)
    calc β = (π / 2) * (2 / π * β) := by
          have hπ : π ≠ 0 := Real.pi_pos.ne'
          field_simp
      _ ≤ (π / 2) * Real.sin β := by
          refine mul_le_mul_of_nonneg_left h ?_
          positivity
  have hnum : (π / 2) * (2 : ℝ) ^ (8 - (m : ℤ)) ≤ (2 : ℝ) ^ (9 - (m : ℤ)) := by
    have h4 : π / 2 ≤ 2 := by linarith [Real.pi_le_four]
    have hpow : (2 : ℝ) ^ (9 - (m : ℤ)) = 2 * (2 : ℝ) ^ (8 - (m : ℤ)) := by
      rw [show (9 : ℤ) - (m : ℤ) = 1 + (8 - (m : ℤ)) by ring, two_zpow_add, zpow_one]
    rw [hpow]
    have hc : (0 : ℝ) < (2 : ℝ) ^ (8 - (m : ℤ)) := by positivity
    exact mul_le_mul_of_nonneg_right h4 hc.le
  have hmono : (π / 2) * Real.sin β ≤ (π / 2) * (2 : ℝ) ^ (8 - (m : ℤ)) := by
    refine mul_le_mul_of_nonneg_left hsinβle ?_
    positivity
  linarith

end UnitDiff


/-! ## The phase derivative is dominated by `w` -/

section PhdBound

theorem phd_eq_inner (ε t : ℝ) (ξ w η u : Pl) (hη : η ≠ 0) (hξη : ξ - η ≠ 0) :
    phd ε t ξ w η u
      = inner ℝ w u + ε * t * (inner ℝ (‖η‖⁻¹ • η - ‖ξ - η‖⁻¹ • (ξ - η)) u : ℝ) := by
  have h1 : ‖η‖ ≠ 0 := norm_ne_zero_iff.mpr hη
  have h2 : ‖ξ - η‖ ≠ 0 := norm_ne_zero_iff.mpr hξη
  have hV : (inner ℝ (‖η‖⁻¹ • η - ‖ξ - η‖⁻¹ • (ξ - η)) u : ℝ)
      = (inner ℝ η u : ℝ) / ‖η‖ - (inner ℝ (ξ - η) u : ℝ) / ‖ξ - η‖ := by
    rw [inner_sub_left, real_inner_smul_left, real_inner_smul_left]
    field_simp
  rw [phd, hV]
  ring

/-- On the support of a `(j,m)`-adapted symbol the correction to the phase derivative is at most
`2^{10-m}`. -/
theorem abs_phd_sub_le {j m : ℕ} {ξ η : Pl} (hξ : XiData j ξ) (hsupp : η ∈ SuppSet j m ξ)
    {u : Pl} (hu : ‖u‖ = 1) (w : Pl) {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) :
    |phd ε t ξ w η u - inner ℝ w u| ≤ (2 : ℝ) ^ (10 - (m : ℤ)) := by
  have hηpos : (0 : ℝ) < ‖η‖ := lt_of_lt_of_le (by positivity) hsupp.1.2.2.1
  have hξηpos : (0 : ℝ) < ‖ξ - η‖ := lt_of_lt_of_le (by positivity) hsupp.2.1.2.2.1
  have hη : η ≠ 0 := norm_pos_iff.mp hηpos
  have hξη : ξ - η ≠ 0 := norm_pos_iff.mp hξηpos
  set V : Pl := ‖η‖⁻¹ • η - ‖ξ - η‖⁻¹ • (ξ - η) with hVdef
  have heq : phd ε t ξ w η u - inner ℝ w u = ε * t * (inner ℝ V u : ℝ) := by
    rw [phd_eq_inner ε t ξ w η u hη hξη, hVdef]
    ring
  rw [heq]
  have hVnorm : ‖V‖ ≤ (2 : ℝ) ^ (9 - (m : ℤ)) := by
    refine le_trans (norm_unit_diff_le hη hξη) (angle_eta_le hξ hsupp)
  have hinnerle : |(inner ℝ V u : ℝ)| ≤ ‖V‖ := by
    refine le_trans (abs_real_inner_le_norm V u) ?_
    rw [hu, mul_one]
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_pos (by linarith)]
    exact ht2
  have hid : (2 : ℝ) ^ (10 - (m : ℤ)) = 2 * (2 : ℝ) ^ (9 - (m : ℤ)) := by
    rw [show (10 : ℤ) - (m : ℤ) = 1 + (9 - (m : ℤ)) by ring, two_zpow_add, zpow_one]
  rw [abs_mul, hid]
  refine mul_le_mul hεt (le_trans hinnerle hVnorm) (abs_nonneg _) (by norm_num)

/-- The hypotheses of Proposition 4.3 on the symbol: `|∂_η^α b| ≤ B 2^{-(j-m)|α|}` for
`|α| ≤ 9`, as in the paper. -/
structure CartData (j m : ℕ) (b : ℝ → Pl → Pl → ℂ) (B : ℝ) : Prop where
  smooth : ∀ t ξ, ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)
  bd : ∀ t ξ, ∀ n ≤ 9, ∀ η, ‖iteratedFDeriv ℝ n (b t ξ) η‖
    ≤ B * (2 : ℝ) ^ (-(n : ℤ) * ((j : ℤ) - (m : ℤ)))

theorem CartData.norm_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (h : CartData j m b B) (t : ℝ) (ξ η : Pl) : ‖b t ξ η‖ ≤ B := by
  have hb := h.bd t ξ 0 (by norm_num) η
  rw [norm_iteratedFDeriv_zero] at hb
  simpa using hb

theorem CartData.nonneg {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (h : CartData j m b B) : 0 ≤ B :=
  le_trans (norm_nonneg _) (h.norm_le 0 0 0)

/-- The directional derivative of the symbol is bounded by `B 2^{-(j-m)}`. -/
theorem CartData.dir_deriv_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (h : CartData j m b B) (t : ℝ) (ξ η : Pl) {u : Pl} (hu : ‖u‖ = 1) :
    ‖fderiv ℝ (b t ξ) η u‖ ≤ B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) := by
  have hb := h.bd t ξ 1 (by norm_num) η
  have hcd : ContDiff ℝ (1 : ℕ) (b t ξ) := (h.smooth t ξ).of_le (by exact_mod_cast le_top)
  have hnorm : ‖fderiv ℝ (b t ξ) η‖ = ‖iteratedFDeriv ℝ 1 (b t ξ) η‖ := by
    rw [norm_iteratedFDeriv_one]
  have hle : ‖fderiv ℝ (b t ξ) η u‖ ≤ ‖fderiv ℝ (b t ξ) η‖ * ‖u‖ :=
    (fderiv ℝ (b t ξ) η).le_opNorm u
  rw [hu, mul_one, hnorm] at hle
  refine le_trans hle (le_trans hb (le_of_eq ?_))
  congr 1
  push_cast
  ring

end PhdBound


/-! ## Smooth cutoffs in a single coordinate

The cutoffs used for the integration by parts of §4.4 depend on `w` only through a single
coordinate, so all their `w`-derivatives are controlled by the chain rule for an affine map with no
combinatorial input: `|∂_w^n cut| ≤ C λ^n`.
-/

section Cutoff44

theorem hasCompactSupport_deriv_st : HasCompactSupport (deriv Real.smoothTransition) := by
  refine HasCompactSupport.intro (isCompact_Icc (a := (0 : ℝ)) (b := 1)) fun s hs => ?_
  simp only [Set.mem_Icc, not_and_or, not_le] at hs
  rcases hs with h | h
  · have hev : Real.smoothTransition =ᶠ[nhds s] fun _ : ℝ => (0 : ℝ) := by
      filter_upwards [isOpen_Iio.mem_nhds (show s ∈ Set.Iio (0 : ℝ) from h)] with x hx
      exact Real.smoothTransition.zero_of_nonpos (le_of_lt hx)
    rw [hev.deriv_eq]
    exact deriv_const s _
  · have hev : Real.smoothTransition =ᶠ[nhds s] fun _ : ℝ => (1 : ℝ) := by
      filter_upwards [isOpen_Ioi.mem_nhds (show s ∈ Set.Ioi (1 : ℝ) from h)] with x hx
      exact Real.smoothTransition.one_of_one_le (le_of_lt hx)
    rw [hev.deriv_eq]
    exact deriv_const s _

theorem contDiff_st : ContDiff ℝ (↑(⊤ : ℕ∞)) Real.smoothTransition :=
  Real.smoothTransition.contDiff

theorem contDiff_deriv_st : ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv Real.smoothTransition) := by
  have h : ContDiff ℝ ((↑(⊤ : ℕ∞)) + 1) Real.smoothTransition := by
    simpa using contDiff_st
  exact h.deriv'

/-- Every derivative of `Real.smoothTransition` of order at most `N` is bounded by a single
constant. -/
theorem exists_st_bound (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ s : ℝ, ‖iteratedFDeriv ℝ n Real.smoothTransition s‖ ≤ C := by
  have hb : ∀ k : ℕ, ∃ C : ℝ, ∀ s : ℝ,
      ‖iteratedFDeriv ℝ k (deriv Real.smoothTransition) s‖ ≤ C := by
    intro k
    exact (hasCompactSupport_deriv_st.iteratedFDeriv k).exists_bound_of_continuous
      (contDiff_deriv_st.continuous_iteratedFDeriv (by exact_mod_cast le_top))
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ k ∈ Finset.range (N + 1), |C k| :=
    Finset.sum_nonneg fun k _ => abs_nonneg _
  refine ⟨1 + ∑ k ∈ Finset.range (N + 1), |C k|, by linarith, ?_⟩
  intro n hn s
  match n with
  | 0 =>
    rw [norm_iteratedFDeriv_zero]
    have h1 := Real.smoothTransition.le_one s
    have h2 := Real.smoothTransition.nonneg s
    rw [Real.norm_eq_abs, abs_of_nonneg h2]
    linarith
  | (k + 1) =>
    have hstep : ‖iteratedFDeriv ℝ (k + 1) Real.smoothTransition s‖
        = ‖iteratedFDeriv ℝ k (deriv Real.smoothTransition) s‖ := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, norm_iteratedFDeriv_eq_norm_iteratedDeriv,
        iteratedDeriv_succ']
    rw [hstep]
    refine le_trans (hC k s) ?_
    have hmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : |C k| ≤ ∑ l ∈ Finset.range (N + 1), |C l| :=
      Finset.single_le_sum (f := fun l => |C l|) (fun l _ => abs_nonneg _) hmem
    have h2 : C k ≤ |C k| := le_abs_self _
    linarith

/-- The `i`-th coordinate functional on the plane. -/
def prj (i : Fin 2) : Pl →L[ℝ] ℝ := EuclideanSpace.proj i

@[simp] theorem prj_apply (i : Fin 2) (w : Pl) : prj i w = w i := rfl

theorem norm_prj_le (i : Fin 2) : ‖prj i‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun w => ?_
  rw [one_mul, Real.norm_eq_abs, prj_apply]
  exact Auto.CalderonVaillancourt.abs_apply_le_norm w i

/-- A smooth cutoff depending on `w` only through its `i`-th coordinate: it vanishes when
`lam * w i ≤ c` and equals `1` when `lam * w i ≥ c + 1`. -/
def cut (i : Fin 2) (lam c : ℝ) (w : Pl) : ℝ := Real.smoothTransition (lam * w i - c)

theorem cut_nonneg (i : Fin 2) (lam c : ℝ) (w : Pl) : 0 ≤ cut i lam c w :=
  Real.smoothTransition.nonneg _

theorem cut_le_one (i : Fin 2) (lam c : ℝ) (w : Pl) : cut i lam c w ≤ 1 :=
  Real.smoothTransition.le_one _

theorem cut_eq_zero_of_le {i : Fin 2} {lam c : ℝ} {w : Pl} (h : lam * w i ≤ c) :
    cut i lam c w = 0 :=
  Real.smoothTransition.zero_of_nonpos (by linarith)

theorem cut_eq_one_of_ge {i : Fin 2} {lam c : ℝ} {w : Pl} (h : c + 1 ≤ lam * w i) :
    cut i lam c w = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

/-- `cut` as the composition of `Real.smoothTransition` with an affine map of a single
coordinate. -/
theorem cut_eq_comp (i : Fin 2) (lam c : ℝ) :
    cut i lam c = (fun s : ℝ => Real.smoothTransition (s - c)) ∘ (lam • prj i) := by
  funext w
  have hval : (lam • prj i) w = lam * w i := by
    rw [ContinuousLinearMap.smul_apply, prj_apply, smul_eq_mul]
  rw [Function.comp_apply, hval, cut]

theorem contDiff_cut (i : Fin 2) (lam c : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cut i lam c) := by
  rw [cut_eq_comp]
  exact (contDiff_st.comp (contDiff_id.sub contDiff_const)).comp
    (lam • prj i).contDiff

theorem norm_smul_prj_le (i : Fin 2) (lam : ℝ) : ‖lam • prj i‖ ≤ |lam| := by
  refine le_trans (norm_smul_le lam (prj i)) ?_
  rw [Real.norm_eq_abs]
  have h := norm_prj_le i
  nlinarith [abs_nonneg lam, norm_nonneg (prj i)]

/-- All `w`-derivatives of `cut i lam c` of order at most `N` are bounded by `C |lam| ^ n`. -/
theorem norm_iteratedFDeriv_cut_le {N : ℕ} {C : ℝ}
    (hC : ∀ n ≤ N, ∀ s : ℝ, ‖iteratedFDeriv ℝ n Real.smoothTransition s‖ ≤ C)
    (hCnn : 0 ≤ C) (i : Fin 2) (lam c : ℝ) {n : ℕ} (hn : n ≤ N) (w : Pl) :
    ‖iteratedFDeriv ℝ n (cut i lam c) w‖ ≤ C * |lam| ^ n := by
  set L : Pl →L[ℝ] ℝ := lam • prj i with hL
  set g : ℝ → ℝ := fun s : ℝ => Real.smoothTransition (s - c) with hg
  have hgcd : ContDiff ℝ (↑(⊤ : ℕ∞)) g := contDiff_st.comp (contDiff_id.sub contDiff_const)
  have hcomp : iteratedFDeriv ℝ n (cut i lam c) w
      = (iteratedFDeriv ℝ n g (L w)).compContinuousLinearMap fun _ => L := by
    rw [cut_eq_comp]
    exact L.iteratedFDeriv_comp_right hgcd w (by exact_mod_cast le_top)
  have hgder : ‖iteratedFDeriv ℝ n g (L w)‖ ≤ C := by
    have hshift : iteratedFDeriv ℝ n g (L w)
        = iteratedFDeriv ℝ n Real.smoothTransition (L w - c) := by
      rw [hg]
      exact iteratedFDeriv_comp_sub n c (L w)
    rw [hshift]
    exact hC n hn _
  rw [hcomp]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin n, ‖L‖) = ‖L‖ ^ n := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod]
  have hLle : ‖L‖ ^ n ≤ |lam| ^ n := by
    have h1 : ‖L‖ ≤ |lam| := norm_smul_prj_le i lam
    have h2 : (0 : ℝ) ≤ ‖L‖ := norm_nonneg _
    gcongr
  exact mul_le_mul hgder hLle (by positivity) hCnn

end Cutoff44


/-! ## A partition of unity on `{|w| ≳ 1/lam}`

Four cutoffs, each depending on `w` through a single coordinate (up to one product), add up to `1`
whenever `lam |w| ≥ 256`.  On the support of the `i`-th pair the `i`-th coordinate satisfies
`|lam w_i| ≥ 2`, which is what makes the phase derivative of §4.4 non-degenerate.
-/

section Partition44

/-- `w_0` large and positive. -/
def wc0p (lam : ℝ) : Pl → ℝ := cut 0 lam 2

/-- `w_0` large and negative. -/
def wc0m (lam : ℝ) : Pl → ℝ := cut 0 (-lam) 2

/-- The part not covered by the first coordinate. -/
def wrest (lam : ℝ) (w : Pl) : ℝ := 1 - wc0p lam w - wc0m lam w

/-- `w_1` large and positive. -/
def wc1p (lam : ℝ) (w : Pl) : ℝ := wrest lam w * cut 1 lam 2 w

/-- `w_1` large and negative. -/
def wc1m (lam : ℝ) (w : Pl) : ℝ := wrest lam w * cut 1 (-lam) 2 w

theorem norm_sq_eq_coords (w : Pl) : ‖w‖ ^ 2 = (w 0) ^ 2 + (w 1) ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

theorem wc0p_eq_zero {lam : ℝ} {w : Pl} (h : lam * w 0 ≤ 2) : wc0p lam w = 0 :=
  cut_eq_zero_of_le h

theorem wc0m_eq_zero {lam : ℝ} {w : Pl} (h : -(lam * w 0) ≤ 2) : wc0m lam w = 0 := by
  refine cut_eq_zero_of_le ?_
  rw [neg_mul]
  exact h

/-- `wc0p` and `wc0m` never both vanish to a positive value, so `wrest` lies in `[0,1]`. -/
theorem wrest_mem {lam : ℝ} (hlam : 0 < lam) (w : Pl) :
    0 ≤ wrest lam w ∧ wrest lam w ≤ 1 := by
  rcases le_or_gt (lam * w 0) 2 with h | h
  · have h0 : wc0p lam w = 0 := wc0p_eq_zero h
    have h1 := cut_nonneg 0 (-lam) 2 w
    have h2 := cut_le_one 0 (-lam) 2 w
    rw [wrest, h0]
    constructor
    · simp only [sub_zero]
      have : wc0m lam w ≤ 1 := h2
      linarith
    · have : 0 ≤ wc0m lam w := h1
      linarith
  · have h0 : wc0m lam w = 0 := by
      refine wc0m_eq_zero ?_
      linarith
    have h1 := cut_nonneg 0 lam 2 w
    have h2 := cut_le_one 0 lam 2 w
    rw [wrest, h0]
    constructor
    · have : wc0p lam w ≤ 1 := h2
      linarith
    · have : 0 ≤ wc0p lam w := h1
      linarith

/-- The four cutoffs form a partition of unity on `{lam |w| ≥ 256}`. -/
theorem sum_wcut {lam : ℝ} (hlam : 0 < lam) {w : Pl} (hw : 256 ≤ lam * ‖w‖) :
    wc0p lam w + wc0m lam w + wc1p lam w + wc1m lam w = 1 := by
  rcases le_or_gt 3 (lam * w 0) with h | h
  · -- `w_0` large and positive
    have h1 : wc0p lam w = 1 := cut_eq_one_of_ge (by linarith)
    have h2 : wc0m lam w = 0 := wc0m_eq_zero (by linarith)
    have h3 : wrest lam w = 0 := by rw [wrest, h1, h2]; ring
    rw [wc1p, wc1m, h1, h2, h3]
    ring
  rcases le_or_gt (lam * w 0) (-3) with h' | h'
  · -- `w_0` large and negative
    have h1 : wc0m lam w = 1 := by
      refine cut_eq_one_of_ge ?_
      rw [neg_mul]
      linarith
    have h2 : wc0p lam w = 0 := wc0p_eq_zero (by linarith)
    have h3 : wrest lam w = 0 := by rw [wrest, h1, h2]; ring
    rw [wc1p, wc1m, h1, h2, h3]
    ring
  · -- `w_0` small, hence `w_1` large
    have hsq : (lam * ‖w‖) ^ 2 = (lam * w 0) ^ 2 + (lam * w 1) ^ 2 := by
      rw [mul_pow, mul_pow, mul_pow, norm_sq_eq_coords]
      ring
    have hbig : (256 : ℝ) ^ 2 ≤ (lam * ‖w‖) ^ 2 := by
      have hnn : (0 : ℝ) ≤ 256 := by norm_num
      nlinarith [hw, hnn]
    have hsmall : (lam * w 0) ^ 2 < 9 := by nlinarith [h, h']
    have h1big : (9 : ℝ) < (lam * w 1) ^ 2 := by nlinarith [hsq, hbig, hsmall]
    have hcases : 3 ≤ lam * w 1 ∨ lam * w 1 ≤ -3 := by
      rcases le_or_gt 0 (lam * w 1) with hs | hs
      · left; nlinarith [h1big, hs]
      · right; nlinarith [h1big, hs]
    rcases hcases with hc | hc
    · have h1 : cut 1 lam 2 w = 1 := cut_eq_one_of_ge (by linarith)
      have h2 : cut 1 (-lam) 2 w = 0 := by
        refine cut_eq_zero_of_le ?_
        rw [neg_mul]
        linarith
      rw [wc1p, wc1m, h1, h2, wrest]
      ring
    · have h1 : cut 1 (-lam) 2 w = 1 := by
        refine cut_eq_one_of_ge ?_
        rw [neg_mul]
        linarith
      have h2 : cut 1 lam 2 w = 0 := cut_eq_zero_of_le (by linarith)
      rw [wc1p, wc1m, h1, h2, wrest]
      ring

/-- On the support of `wc0p` the first coordinate is large and positive. -/
theorem wc0p_support {lam : ℝ} {w : Pl} (h : wc0p lam w ≠ 0) : 2 < lam * w 0 := by
  by_contra hcon
  exact h (wc0p_eq_zero (not_lt.mp hcon))

/-- On the support of `wc0m` the first coordinate is large and negative. -/
theorem wc0m_support {lam : ℝ} {w : Pl} (h : wc0m lam w ≠ 0) : 2 < -(lam * w 0) := by
  by_contra hcon
  exact h (wc0m_eq_zero (not_lt.mp hcon))

/-- On the support of `wc1p` the second coordinate is large and positive. -/
theorem wc1p_support {lam : ℝ} {w : Pl} (h : wc1p lam w ≠ 0) : 2 < lam * w 1 := by
  by_contra hcon
  refine h ?_
  rw [wc1p, cut_eq_zero_of_le (not_lt.mp hcon), mul_zero]

/-- On the support of `wc1m` the second coordinate is large and negative. -/
theorem wc1m_support {lam : ℝ} {w : Pl} (h : wc1m lam w ≠ 0) : 2 < -(lam * w 1) := by
  by_contra hcon
  refine h ?_
  have hle : (-lam) * w 1 ≤ 2 := by
    rw [neg_mul]
    exact not_lt.mp hcon
  rw [wc1m, cut_eq_zero_of_le hle, mul_zero]

theorem contDiff_wc0p (lam : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (wc0p lam) := contDiff_cut 0 lam 2

theorem contDiff_wc0m (lam : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (wc0m lam) := contDiff_cut 0 (-lam) 2

theorem contDiff_wrest (lam : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (wrest lam) :=
  (contDiff_const.sub (contDiff_wc0p lam)).sub (contDiff_wc0m lam)

theorem contDiff_wc1p (lam : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (wc1p lam) :=
  (contDiff_wrest lam).mul (contDiff_cut 1 lam 2)

theorem contDiff_wc1m (lam : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (wc1m lam) :=
  (contDiff_wrest lam).mul (contDiff_cut 1 (-lam) 2)

end Partition44


/-! ## Bounded derivatives

Every symbol appearing in §4.4 is, after rescaling to unit scale, a fixed smooth function with
compact support composed with an affine map, so all of its derivatives are bounded by absolute
constants.  The following lemma is the only source of those constants; no explicit value is ever
needed.
-/

section BoundedDerivs

/-- A smooth compactly supported function has all its derivatives up to order `N` bounded by a
single constant. -/
theorem exists_deriv_bound {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [FiniteDimensional ℝ E] [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : E → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hs : HasCompactSupport f) (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n ≤ N, ∀ x, ‖iteratedFDeriv ℝ n f x‖ ≤ C := by
  have hb : ∀ n : ℕ, ∃ C : ℝ, ∀ x, ‖iteratedFDeriv ℝ n f x‖ ≤ C := by
    intro n
    exact (hs.iteratedFDeriv n).exists_bound_of_continuous
      (hf.continuous_iteratedFDeriv (by exact_mod_cast le_top))
  choose C hC using hb
  have hnn : (0 : ℝ) ≤ ∑ n ∈ Finset.range (N + 1), |C n| :=
    Finset.sum_nonneg fun n _ => abs_nonneg _
  refine ⟨1 + ∑ n ∈ Finset.range (N + 1), |C n|, by linarith, ?_⟩
  intro n hn x
  refine le_trans (hC n x) ?_
  have hmem : n ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : |C n| ≤ ∑ l ∈ Finset.range (N + 1), |C l| :=
    Finset.single_le_sum (f := fun l => |C l|) (fun l _ => abs_nonneg _) hmem
  have h2 : C n ≤ |C n| := le_abs_self _
  linarith

/-- Adding a constant does not change the derivatives of positive order. -/
theorem iteratedFDeriv_const_add {E F : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] {f : E → F} (c : F)
    (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) {n : ℕ} (hn : n ≠ 0) (x : E) :
    iteratedFDeriv ℝ n (fun y => c + f y) x = iteratedFDeriv ℝ n f x := by
  have hfun : (fun y => c + f y) = (fun _ : E => c) + f := by
    funext y
    rw [Pi.add_apply]
  rw [hfun, iteratedFDeriv_add_apply (contDiffAt_const (c := c))
    ((hf.of_le (by exact_mod_cast le_top : (n : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞))).contDiffAt),
    iteratedFDeriv_const_of_ne hn]
  simp

/-- Composition with an affine map multiplies the `n`-th derivative by at most `‖L‖ ^ n`. -/
theorem norm_iteratedFDeriv_comp_affine {E F G : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    [NormedAddCommGroup F] [NormedSpace ℝ F] [NormedAddCommGroup G] [NormedSpace ℝ G]
    {f : E → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (L : G →L[ℝ] E) (c : E) (n : ℕ) (x : G) :
    ‖iteratedFDeriv ℝ n (fun y => f (L y + c)) x‖
      ≤ ‖iteratedFDeriv ℝ n f (L x + c)‖ * ‖L‖ ^ n := by
  have hshift : ContDiff ℝ (↑(⊤ : ℕ∞)) (fun z : E => f (z + c)) :=
    hf.comp (contDiff_id.add contDiff_const)
  have hcomp : iteratedFDeriv ℝ n (fun y => f (L y + c)) x
      = (iteratedFDeriv ℝ n (fun z : E => f (z + c)) (L x)).compContinuousLinearMap fun _ => L :=
    L.iteratedFDeriv_comp_right hshift x (by exact_mod_cast le_top)
  have hkey : iteratedFDeriv ℝ n (fun z : E => f (z + c)) (L x)
      = iteratedFDeriv ℝ n f (L x + c) := iteratedFDeriv_comp_add_right (f := f) n c (L x)
  rw [hcomp]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin n, ‖L‖) = ‖L‖ ^ n := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod, hkey]

end BoundedDerivs

/-! ## One-dimensional smooth building blocks

`annB` is a bump adapted to the annulus, `gsm s = annB s / sqrt s` is the smooth truncation of
`s ↦ s ^ (-1/2)`, `shrinkS` truncates the identity, and `clampLow` is a smooth function that agrees
with the identity on `[1/4, 4]` and never drops below `1/8`.
-/

section Blocks1D

/-- A smooth bump equal to `1` on `[1/128, 512]` and supported in `[1/256, 1024]`. -/
def annB (s : ℝ) : ℝ := Real.smoothTransition (256 * s - 1) * Real.smoothTransition (2 - s / 512)

theorem contDiff_annB : ContDiff ℝ (↑(⊤ : ℕ∞)) annB :=
  (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub (contDiff_id.div_const 512)))

theorem annB_nonneg (s : ℝ) : 0 ≤ annB s :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem annB_le_one (s : ℝ) : annB s ≤ 1 := by
  have h1 := Real.smoothTransition.le_one (256 * s - 1)
  have h2 := Real.smoothTransition.le_one (2 - s / 512)
  have h3 := Real.smoothTransition.nonneg (256 * s - 1)
  have h4 := Real.smoothTransition.nonneg (2 - s / 512)
  rw [annB]
  nlinarith

theorem annB_eq_one {s : ℝ} (h1 : 1 / 128 ≤ s) (h2 : s ≤ 512) : annB s = 1 := by
  rw [annB, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem annB_eq_zero_of_le {s : ℝ} (h : s ≤ 1 / 256) : annB s = 0 := by
  rw [annB, Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]

theorem annB_eq_zero_of_ge {s : ℝ} (h : 1024 ≤ s) : annB s = 0 := by
  rw [annB, Real.smoothTransition.zero_of_nonpos (show 2 - s / 512 ≤ 0 by linarith), mul_zero]

/-- The smooth truncation of `s ↦ s ^ (-1/2)`. -/
def gsm (s : ℝ) : ℝ := annB s / Real.sqrt s

theorem gsm_eq_zero_of_le {s : ℝ} (h : s ≤ 1 / 256) : gsm s = 0 := by
  rw [gsm, annB_eq_zero_of_le h, zero_div]

theorem gsm_eq_zero_of_ge {s : ℝ} (h : 1024 ≤ s) : gsm s = 0 := by
  rw [gsm, annB_eq_zero_of_ge h, zero_div]

theorem gsm_eq_inv_sqrt {s : ℝ} (h1 : 1 / 128 ≤ s) (h2 : s ≤ 512) :
    gsm s = 1 / Real.sqrt s := by
  rw [gsm, annB_eq_one h1 h2]

/-- `gsm` is smooth: away from the origin it is a quotient of smooth functions, and near the origin
it vanishes identically. -/
theorem contDiff_gsm : ContDiff ℝ (↑(⊤ : ℕ∞)) gsm := by
  have hcover : ∀ s : ℝ, ContDiffAt ℝ (↑(⊤ : ℕ∞)) gsm s := by
    intro s
    rcases lt_or_ge (1 / 512 : ℝ) s with h | h
    · have hspos : (0 : ℝ) < s := by linarith
      have hsqrt : ContDiffAt ℝ (↑(⊤ : ℕ∞)) Real.sqrt s :=
        (Real.contDiffAt_sqrt (by linarith)).of_le (by exact_mod_cast le_top)
      have hne : Real.sqrt s ≠ 0 := (Real.sqrt_pos.mpr hspos).ne'
      exact (contDiff_annB.contDiffAt).div hsqrt hne
    · have hev : gsm =ᶠ[nhds s] fun _ : ℝ => (0 : ℝ) := by
        filter_upwards [isOpen_Iio.mem_nhds (show s ∈ Set.Iio (1 / 384 : ℝ) by
          simp only [Set.mem_Iio]; linarith)] with x hx
        exact gsm_eq_zero_of_le (by simp only [Set.mem_Iio] at hx; linarith)
      exact (contDiffAt_const (c := (0 : ℝ))).congr_of_eventuallyEq hev
  exact contDiff_iff_contDiffAt.mpr hcover

theorem hasCompactSupport_gsm : HasCompactSupport gsm := by
  refine HasCompactSupport.intro (isCompact_Icc (a := (1 / 256 : ℝ)) (b := 1024)) fun s hs => ?_
  simp only [Set.mem_Icc, not_and_or, not_le] at hs
  rcases hs with h | h
  · exact gsm_eq_zero_of_le (le_of_lt h)
  · exact gsm_eq_zero_of_ge (le_of_lt h)

/-- The smooth truncation of the identity: `shrinkS s = s` for `s ^ 2 ≤ 1`, and `shrinkS s = 0` for
`s ^ 2 ≥ 2`. -/
def shrinkS (s : ℝ) : ℝ := s * (1 - Real.smoothTransition (s ^ 2 - 1))

theorem contDiff_shrinkS : ContDiff ℝ (↑(⊤ : ℕ∞)) shrinkS :=
  contDiff_id.mul (contDiff_const.sub
    (contDiff_st.comp ((contDiff_id.pow 2).sub contDiff_const)))

theorem shrinkS_eq_self {s : ℝ} (h : s ^ 2 ≤ 1) : shrinkS s = s := by
  rw [shrinkS, Real.smoothTransition.zero_of_nonpos (by linarith), sub_zero, mul_one]

theorem shrinkS_eq_zero {s : ℝ} (h : 2 ≤ s ^ 2) : shrinkS s = 0 := by
  rw [shrinkS, Real.smoothTransition.one_of_one_le (by linarith), sub_self, mul_zero]

theorem abs_shrinkS_le (s : ℝ) : |shrinkS s| ≤ 2 := by
  rcases le_or_gt (s ^ 2) 2 with h | h
  · have h1 : |s| ≤ 2 := by nlinarith [abs_nonneg s, sq_abs s]
    have h2 := Real.smoothTransition.le_one (s ^ 2 - 1)
    have h3 := Real.smoothTransition.nonneg (s ^ 2 - 1)
    rw [shrinkS, abs_mul]
    have h4 : |1 - Real.smoothTransition (s ^ 2 - 1)| ≤ 1 := by
      rw [abs_le]
      constructor <;> linarith
    nlinarith [abs_nonneg s, abs_nonneg (1 - Real.smoothTransition (s ^ 2 - 1))]
  · rw [shrinkS_eq_zero (le_of_lt h), abs_zero]
    norm_num

theorem hasCompactSupport_shrinkS : HasCompactSupport shrinkS := by
  refine HasCompactSupport.intro (isCompact_Icc (a := (-2 : ℝ)) (b := 2)) fun s hs => ?_
  simp only [Set.mem_Icc, not_and_or, not_le] at hs
  refine shrinkS_eq_zero ?_
  rcases hs with h | h <;> nlinarith

/-- The compactly supported part of the low clamp. -/
def clampAux (x : ℝ) : ℝ :=
  (x - 1 / 8) * Real.smoothTransition (8 * x - 1) * (1 - Real.smoothTransition (x / 4 - 1))

/-- A smooth function that agrees with the identity on `[1/4, 4]` and is never smaller
than `1/8`. -/
def clampLow (x : ℝ) : ℝ := 1 / 8 + clampAux x

theorem contDiff_clampAux : ContDiff ℝ (↑(⊤ : ℕ∞)) clampAux :=
  ((contDiff_id.sub contDiff_const).mul
      (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const))).mul
    (contDiff_const.sub (contDiff_st.comp ((contDiff_id.div_const 4).sub contDiff_const)))

theorem contDiff_clampLow : ContDiff ℝ (↑(⊤ : ℕ∞)) clampLow :=
  contDiff_const.add contDiff_clampAux

theorem clampAux_eq_zero_of_le {x : ℝ} (h : x ≤ 1 / 8) : clampAux x = 0 := by
  rw [clampAux, Real.smoothTransition.zero_of_nonpos (by linarith), mul_zero, zero_mul]

theorem clampAux_eq_zero_of_ge {x : ℝ} (h : 8 ≤ x) : clampAux x = 0 := by
  rw [clampAux, Real.smoothTransition.one_of_one_le (show (1 : ℝ) ≤ x / 4 - 1 by linarith),
    sub_self, mul_zero]

theorem clampAux_nonneg (x : ℝ) : 0 ≤ clampAux x := by
  rcases le_or_gt x (1 / 8) with h | h
  · rw [clampAux_eq_zero_of_le h]
  · have h1 : 0 ≤ x - 1 / 8 := by linarith
    have h2 := Real.smoothTransition.nonneg (8 * x - 1)
    have h3 := Real.smoothTransition.le_one (x / 4 - 1)
    rw [clampAux]
    have h4 : 0 ≤ 1 - Real.smoothTransition (x / 4 - 1) := by linarith
    exact mul_nonneg (mul_nonneg h1 h2) h4

theorem hasCompactSupport_clampAux : HasCompactSupport clampAux := by
  refine HasCompactSupport.intro (isCompact_Icc (a := (1 / 8 : ℝ)) (b := 8)) fun x hx => ?_
  simp only [Set.mem_Icc, not_and_or, not_le] at hx
  rcases hx with h | h
  · exact clampAux_eq_zero_of_le (le_of_lt h)
  · exact clampAux_eq_zero_of_ge (le_of_lt h)

theorem clampLow_ge (x : ℝ) : 1 / 8 ≤ clampLow x := by
  rw [clampLow]
  linarith [clampAux_nonneg x]

theorem clampLow_pos (x : ℝ) : 0 < clampLow x := lt_of_lt_of_le (by norm_num) (clampLow_ge x)

theorem clampLow_eq_self {x : ℝ} (h1 : 1 / 4 ≤ x) (h2 : x ≤ 4) : clampLow x = x := by
  rw [clampLow, clampAux, Real.smoothTransition.one_of_one_le (show (1 : ℝ) ≤ 8 * x - 1 by linarith),
    Real.smoothTransition.zero_of_nonpos (show x / 4 - 1 ≤ 0 by linarith)]
  ring

/-- All derivatives of `clampLow` of positive order are bounded by an absolute constant. -/
theorem exists_clampLow_bound (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ n, 1 ≤ n → n ≤ N → ∀ x : ℝ,
      ‖iteratedFDeriv ℝ n clampLow x‖ ≤ C := by
  obtain ⟨C, hC1, hC⟩ := exists_deriv_bound contDiff_clampAux hasCompactSupport_clampAux N
  refine ⟨C, hC1, ?_⟩
  intro n hn1 hn x
  have heq : iteratedFDeriv ℝ n clampLow x = iteratedFDeriv ℝ n clampAux x := by
    have hfun : clampLow = fun y : ℝ => 1 / 8 + clampAux y := by
      funext y
      rw [clampLow]
    rw [hfun]
    exact iteratedFDeriv_const_add (1 / 8 : ℝ) contDiff_clampAux (by omega) x
  rw [heq]
  exact hC n hn x

end Blocks1D


/-! ## The truncated unit vector field

`unitVec i` is a fixed smooth compactly supported function on the plane agreeing with
`ζ ↦ ζ i / ‖ζ‖` on the annulus `1/2 ≤ ‖ζ‖ ≤ 4`.  Rescaling by `2 ^ (-j)` turns it into a smooth
replacement for `η ↦ η i / ‖η‖` on the annulus of the symbol, with derivative bounds
`≲ 2 ^ (-j n)`.
-/

section UnitVecField

/-- A smooth compactly supported function agreeing with `ζ ↦ ζ i / ‖ζ‖` on the annulus
`1/2 ≤ ‖ζ‖ ≤ 4`. -/
def unitVec (i : Fin 2) (ζ : Pl) : ℝ := ζ i * gsm (‖ζ‖ ^ 2)

theorem contDiff_unitVec (i : Fin 2) : ContDiff ℝ (↑(⊤ : ℕ∞)) (unitVec i) :=
  (prj i).contDiff.mul (contDiff_gsm.comp (contDiff_norm_sq ℝ))

theorem unitVec_eq_zero_of_le {i : Fin 2} {ζ : Pl} (h : ‖ζ‖ ≤ 1 / 32) : unitVec i ζ = 0 := by
  refine mul_eq_zero_of_right _ (gsm_eq_zero_of_le ?_)
  nlinarith [norm_nonneg ζ]

theorem unitVec_eq_zero_of_ge {i : Fin 2} {ζ : Pl} (h : 32 ≤ ‖ζ‖) : unitVec i ζ = 0 := by
  refine mul_eq_zero_of_right _ (gsm_eq_zero_of_ge ?_)
  nlinarith [norm_nonneg ζ]

theorem hasCompactSupport_unitVec (i : Fin 2) : HasCompactSupport (unitVec i) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl) 32) fun ζ hζ => ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hζ
  exact unitVec_eq_zero_of_ge (le_of_lt (not_le.mp hζ))

/-- On the annulus `unitVec` is the unit vector field. -/
theorem unitVec_eq {i : Fin 2} {ζ : Pl} (h1 : 1 / 8 ≤ ‖ζ‖) (h2 : ‖ζ‖ ≤ 16) :
    unitVec i ζ = ζ i / ‖ζ‖ := by
  have hpos : (0 : ℝ) < ‖ζ‖ := by linarith
  have hlow : (1 : ℝ) / 128 ≤ ‖ζ‖ ^ 2 := by nlinarith
  have hhigh : ‖ζ‖ ^ 2 ≤ 512 := by nlinarith
  rw [unitVec, gsm_eq_inv_sqrt hlow hhigh, Real.sqrt_sq (norm_nonneg ζ)]
  field_simp

/-- The uniform bound on the derivatives of `unitVec`. -/
theorem exists_unitVec_bound (N : ℕ) :
    ∃ C : ℝ, 1 ≤ C ∧ ∀ i : Fin 2, ∀ n ≤ N, ∀ ζ : Pl,
      ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ C := by
  obtain ⟨C0, hC01, hC0⟩ :=
    exists_deriv_bound (contDiff_unitVec 0) (hasCompactSupport_unitVec 0) N
  obtain ⟨C1, hC11, hC1⟩ :=
    exists_deriv_bound (contDiff_unitVec 1) (hasCompactSupport_unitVec 1) N
  refine ⟨C0 + C1, by linarith, ?_⟩
  intro i n hn ζ
  match i with
  | 0 => linarith [hC0 n hn ζ]
  | 1 => linarith [hC1 n hn ζ]

end UnitVecField


/-! ## The smooth replacement for the difference of unit vectors

`Vt j ξ i` is a globally smooth function of `η` that agrees with
`η i / ‖η‖ - (ξ - η) i / ‖ξ - η‖` on the support of a `(j,m)`-adapted symbol and whose `n`-th
derivative is `O(2 ^ (-j n))`.
-/

section VtField

/-- The dilation by `r` as a continuous linear map on the plane. -/
def dil (r : ℝ) : Pl →L[ℝ] Pl := r • ContinuousLinearMap.id ℝ Pl

@[simp] theorem dil_apply (r : ℝ) (η : Pl) : dil r η = r • η := rfl

theorem norm_dil_le (r : ℝ) : ‖dil r‖ ≤ |r| := by
  refine le_trans (norm_smul_le r (ContinuousLinearMap.id ℝ Pl)) ?_
  rw [Real.norm_eq_abs]
  have h := ContinuousLinearMap.norm_id_le (𝕜 := ℝ) (E := Pl)
  nlinarith [abs_nonneg r, norm_nonneg (ContinuousLinearMap.id ℝ Pl)]

/-- The smooth global replacement for `η ↦ η i / ‖η‖ - (ξ - η) i / ‖ξ - η‖`. -/
def Vt (j : ℕ) (ξ : Pl) (i : Fin 2) (η : Pl) : ℝ :=
  unitVec i (dil ((2 : ℝ) ^ (-(j : ℤ))) η + 0) -
    unitVec i (dil (-(2 : ℝ) ^ (-(j : ℤ))) η + (2 : ℝ) ^ (-(j : ℤ)) • ξ)

theorem contDiff_Vt (j : ℕ) (ξ : Pl) (i : Fin 2) : ContDiff ℝ (↑(⊤ : ℕ∞)) (Vt j ξ i) :=
  ((contDiff_unitVec i).comp ((dil _).contDiff.add contDiff_const)).sub
    ((contDiff_unitVec i).comp ((dil _).contDiff.add contDiff_const))

/-- On the annulus the rescaled unit vector field is the unit vector field. -/
theorem unitVec_dil_eq {j : ℕ} {i : Fin 2} {η : Pl}
    (h1 : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖η‖) (h2 : ‖η‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1)) :
    unitVec i (dil ((2 : ℝ) ^ (-(j : ℤ))) η) = η i / ‖η‖ := by
  set r : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hr
  have hrpos : (0 : ℝ) < r := by positivity
  have hnorm : ‖dil r η‖ = r * ‖η‖ := by
    rw [dil_apply, norm_smul, Real.norm_eq_abs, abs_of_pos hrpos]
  have hlow : (1 : ℝ) / 8 ≤ ‖dil r η‖ := by
    rw [hnorm, hr]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 1) = 1 / 2 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) - 1) = -1 by ring]
      norm_num
    calc (1 : ℝ) / 8 ≤ (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 1) := by
          rw [hid]; norm_num
      _ ≤ (2 : ℝ) ^ (-(j : ℤ)) * ‖η‖ := by
          refine mul_le_mul_of_nonneg_left h1 (by positivity)
  have hhigh : ‖dil r η‖ ≤ 16 := by
    rw [hnorm, hr]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1) = 2 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) + 1) = 1 by ring]
      norm_num
    calc (2 : ℝ) ^ (-(j : ℤ)) * ‖η‖ ≤ (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1) := by
          refine mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = 2 := hid
      _ ≤ 16 := by norm_num
  rw [unitVec_eq hlow hhigh, hnorm]
  have hcoord : (dil r η) i = r * η i := by
    rw [dil_apply, PiLp.smul_apply, smul_eq_mul]
  rw [hcoord]
  rw [mul_div_mul_left _ _ hrpos.ne']

theorem Vt_eq {j m : ℕ} {ξ η : Pl} {i : Fin 2} (h : η ∈ SuppSet j m ξ) :
    Vt j ξ i η = η i / ‖η‖ - (ξ - η) i / ‖ξ - η‖ := by
  obtain ⟨hηT, hξηT, -⟩ := h
  have hfst : unitVec i (dil ((2 : ℝ) ^ (-(j : ℤ))) η + 0) = η i / ‖η‖ := by
    rw [add_zero]
    exact unitVec_dil_eq hηT.2.2.1 hηT.2.2.2
  have hsnd : unitVec i (dil (-(2 : ℝ) ^ (-(j : ℤ))) η + (2 : ℝ) ^ (-(j : ℤ)) • ξ)
      = (ξ - η) i / ‖ξ - η‖ := by
    have harg : dil (-(2 : ℝ) ^ (-(j : ℤ))) η + (2 : ℝ) ^ (-(j : ℤ)) • ξ
        = dil ((2 : ℝ) ^ (-(j : ℤ))) (ξ - η) := by
      rw [dil_apply, dil_apply, smul_sub, neg_smul]
      abel
    rw [harg]
    exact unitVec_dil_eq hξηT.2.2.1 hξηT.2.2.2
  rw [Vt, hfst, hsnd]

/-- The derivative bound for `Vt`. -/
theorem norm_iteratedFDeriv_Vt_le {N : ℕ} {C : ℝ} (hCnn : 0 ≤ C)
    (hC : ∀ i : Fin 2, ∀ n ≤ N, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ C)
    (j : ℕ) (ξ : Pl) (i : Fin 2) {n : ℕ} (hn : n ≤ N) (η : Pl) :
    ‖iteratedFDeriv ℝ n (Vt j ξ i) η‖ ≤ 2 * C * ((2 : ℝ) ^ (-(j : ℤ))) ^ n := by
  set r : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hr
  have hrpos : (0 : ℝ) < r := by positivity
  set f1 : Pl → ℝ := fun η => unitVec i (dil r η + 0) with hf1
  set f2 : Pl → ℝ := fun η => unitVec i (dil (-r) η + r • ξ) with hf2
  have hcd1 : ContDiff ℝ (↑(⊤ : ℕ∞)) f1 :=
    (contDiff_unitVec i).comp ((dil r).contDiff.add contDiff_const)
  have hcd2 : ContDiff ℝ (↑(⊤ : ℕ∞)) f2 :=
    (contDiff_unitVec i).comp ((dil (-r)).contDiff.add contDiff_const)
  have hsplit : iteratedFDeriv ℝ n (Vt j ξ i) η
      = iteratedFDeriv ℝ n f1 η - iteratedFDeriv ℝ n f2 η := by
    have hfun : Vt j ξ i = f1 - f2 := by
      funext y
      rw [Vt, hf1, hf2, Pi.sub_apply]
    rw [hfun]
    exact iteratedFDeriv_sub_apply
      ((hcd1.of_le (by exact_mod_cast le_top : (n : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞))).contDiffAt)
      ((hcd2.of_le (by exact_mod_cast le_top : (n : WithTop ℕ∞) ≤ ↑(⊤ : ℕ∞))).contDiffAt)
  have hb1 : ‖iteratedFDeriv ℝ n f1 η‖ ≤ C * r ^ n := by
    refine le_trans (norm_iteratedFDeriv_comp_affine (contDiff_unitVec i) (dil r) 0 n η) ?_
    have hpow : ‖dil r‖ ^ n ≤ r ^ n := by
      have h1 : ‖dil r‖ ≤ r := by
        refine le_trans (norm_dil_le r) ?_
        rw [abs_of_pos hrpos]
      have h2 : (0 : ℝ) ≤ ‖dil r‖ := norm_nonneg _
      gcongr
    refine mul_le_mul (hC i n hn _) hpow (by positivity) hCnn
  have hb2 : ‖iteratedFDeriv ℝ n f2 η‖ ≤ C * r ^ n := by
    refine le_trans (norm_iteratedFDeriv_comp_affine (contDiff_unitVec i) (dil (-r)) (r • ξ) n η) ?_
    have hpow : ‖dil (-r)‖ ^ n ≤ r ^ n := by
      have h1 : ‖dil (-r)‖ ≤ r := by
        refine le_trans (norm_dil_le (-r)) ?_
        rw [abs_neg, abs_of_pos hrpos]
      have h2 : (0 : ℝ) ≤ ‖dil (-r)‖ := norm_nonneg _
      gcongr
    refine mul_le_mul (hC i n hn _) hpow (by positivity) hCnn
  rw [hsplit]
  refine le_trans (norm_sub_le _ _) ?_
  have : C * r ^ n + C * r ^ n = 2 * C * r ^ n := by ring
  linarith [hb1, hb2]

end VtField


/-! ## The smooth replacement for the norm

`nrm` is a fixed smooth compactly supported function on the plane agreeing with `ζ ↦ ‖ζ‖` on the
annulus `1/8 ≤ ‖ζ‖ ≤ 16`.  Rescaling gives a globally smooth phase that agrees with
`η ↦ ‖η‖` on the annulus of the symbol, so no case distinctions are needed when differentiating
under the integral sign.
-/

section SmoothNorm

/-- A smooth compactly supported function agreeing with `ζ ↦ ‖ζ‖` on the annulus
`1/8 ≤ ‖ζ‖ ≤ 16`. -/
def nrm (ζ : Pl) : ℝ := ‖ζ‖ ^ 2 * gsm (‖ζ‖ ^ 2)

theorem contDiff_nrm : ContDiff ℝ (↑(⊤ : ℕ∞)) nrm :=
  (contDiff_norm_sq ℝ).mul (contDiff_gsm.comp (contDiff_norm_sq ℝ))

theorem nrm_eq {ζ : Pl} (h1 : 1 / 8 ≤ ‖ζ‖) (h2 : ‖ζ‖ ≤ 16) : nrm ζ = ‖ζ‖ := by
  have hpos : (0 : ℝ) < ‖ζ‖ := by linarith
  have hlow : (1 : ℝ) / 128 ≤ ‖ζ‖ ^ 2 := by nlinarith
  have hhigh : ‖ζ‖ ^ 2 ≤ 512 := by nlinarith
  rw [nrm, gsm_eq_inv_sqrt hlow hhigh, Real.sqrt_sq (norm_nonneg ζ)]
  field_simp

theorem nrm_eq_zero_of_ge {ζ : Pl} (h : 32 ≤ ‖ζ‖) : nrm ζ = 0 := by
  refine mul_eq_zero_of_right _ (gsm_eq_zero_of_ge ?_)
  nlinarith [norm_nonneg ζ]

theorem hasCompactSupport_nrm : HasCompactSupport nrm := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl) 32) fun ζ hζ => ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hζ
  exact nrm_eq_zero_of_ge (le_of_lt (not_le.mp hζ))

/-- The line derivative of `nrm`. -/
theorem hasDerivAt_nrm_line (ζ u : Pl) :
    HasDerivAt (fun r : ℝ => nrm (ζ + r • u)) (fderiv ℝ nrm ζ u) 0 := by
  have hg : HasDerivAt (fun r : ℝ => ζ + r • u) u 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const u).const_add ζ
  have hf : HasFDerivAt nrm (fderiv ℝ nrm ζ) (ζ + (0 : ℝ) • u) := by
    have h := (contDiff_nrm.differentiable (by simp) ζ).hasFDerivAt
    simpa using h
  exact hf.comp_hasDerivAt 0 hg

/-- On the annulus the derivative of `nrm` is the derivative of the norm. -/
theorem fderiv_nrm_apply {ζ : Pl} (h1 : 1 / 8 < ‖ζ‖) (h2 : ‖ζ‖ < 16) {u : Pl} (hu : ‖u‖ = 1) :
    fderiv ℝ nrm ζ u = (inner ℝ ζ u : ℝ) / ‖ζ‖ := by
  have hζ : ζ ≠ 0 := by
    refine norm_pos_iff.mp ?_
    linarith
  set δ : ℝ := min (‖ζ‖ - 1 / 8) (16 - ‖ζ‖) with hδ
  have hδpos : 0 < δ := by
    rw [hδ]
    exact lt_min (by linarith) (by linarith)
  have hev : (fun r : ℝ => nrm (ζ + r • u)) =ᶠ[nhds 0] fun r : ℝ => ‖ζ + r • u‖ := by
    filter_upwards [Metric.ball_mem_nhds (0 : ℝ) hδpos] with r hr
    rw [Metric.mem_ball, Real.dist_eq, sub_zero] at hr
    have hru : ‖r • u‖ = |r| := by
      rw [norm_smul, Real.norm_eq_abs, hu, mul_one]
    have hup : ‖ζ + r • u‖ ≤ ‖ζ‖ + |r| := by
      refine le_trans (norm_add_le _ _) ?_
      rw [hru]
    have hlo : ‖ζ‖ - |r| ≤ ‖ζ + r • u‖ := by
      have hid : ζ = (ζ + r • u) - r • u := by abel
      have h := norm_add_le (ζ + r • u) (-(r • u))
      rw [show (ζ + r • u) + -(r • u) = ζ by abel, norm_neg, hru] at h
      linarith
    have hδ1 : δ ≤ ‖ζ‖ - 1 / 8 := by rw [hδ]; exact min_le_left _ _
    have hδ2 : δ ≤ 16 - ‖ζ‖ := by rw [hδ]; exact min_le_right _ _
    refine nrm_eq (by linarith) (by linarith)
  have hA := hasDerivAt_nrm_line ζ u
  have hB : HasDerivAt (fun r : ℝ => ‖ζ + r • u‖) ((inner ℝ ζ u : ℝ) / ‖ζ‖) 0 := by
    have h := hasDerivAt_norm_line hu ζ (s := 0) (by simpa using hζ)
    simpa using h
  exact (hA.congr_of_eventuallyEq hev.symm).unique hB

end SmoothNorm


/-! ## The smooth phase of §4.4

Replacing `‖η‖` by the rescaled smooth truncation `Ntl j` gives a globally smooth phase agreeing
with the true one on the support of a `(j,m)`-adapted symbol.
-/

section SmoothPhase

/-- The `i`-th standard basis vector of the plane. -/
def ev : Fin 2 → Pl
  | 0 => mk2 1 0
  | 1 => mk2 0 1

@[simp] theorem inner_ev (x : Pl) (i : Fin 2) : (inner ℝ x (ev i) : ℝ) = x i := by
  match i with
  | 0 =>
    rw [inner_two, ev]
    simp
  | 1 =>
    rw [inner_two, ev]
    simp

@[simp] theorem norm_ev (i : Fin 2) : ‖ev i‖ = 1 := by
  match i with
  | 0 =>
    have h : ‖ev 0‖ ^ 2 = 1 := by
      rw [ev, norm_mk2_sq]
      norm_num
    nlinarith [norm_nonneg (ev 0), h]
  | 1 =>
    have h : ‖ev 1‖ ^ 2 = 1 := by
      rw [ev, norm_mk2_sq]
      norm_num
    nlinarith [norm_nonneg (ev 1), h]

/-- The rescaled smooth norm, equal to `‖η‖` on the annulus `2^{j-3} ≤ ‖η‖ ≤ 2^{j+4}`. -/
def Ntl (j : ℕ) (η : Pl) : ℝ := (2 : ℝ) ^ (j : ℤ) * nrm ((2 : ℝ) ^ (-(j : ℤ)) • η)

theorem contDiff_Ntl (j : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (Ntl j) :=
  contDiff_const.mul (contDiff_nrm.comp (contDiff_id.const_smul _))

theorem two_zpow_neg_mul (j : ℕ) : (2 : ℝ) ^ (j : ℤ) * (2 : ℝ) ^ (-(j : ℤ)) = 1 := by
  rw [← two_zpow_add, add_neg_cancel, zpow_zero]

theorem Ntl_eq {j : ℕ} {η : Pl} (h1 : (2 : ℝ) ^ ((j : ℤ) - 3) ≤ ‖η‖)
    (h2 : ‖η‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 4)) : Ntl j η = ‖η‖ := by
  set r : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hr
  have hrpos : (0 : ℝ) < r := by rw [hr]; positivity
  have hnorm : ‖r • η‖ = r * ‖η‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos]
  have hlow : (1 : ℝ) / 8 ≤ ‖r • η‖ := by
    rw [hnorm, hr]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 3) = 1 / 8 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) - 3) = -3 by ring]
      norm_num
    calc (1 : ℝ) / 8 = (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 3) := hid.symm
      _ ≤ (2 : ℝ) ^ (-(j : ℤ)) * ‖η‖ := mul_le_mul_of_nonneg_left h1 (by positivity)
  have hhigh : ‖r • η‖ ≤ 16 := by
    rw [hnorm, hr]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 4) = 16 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) + 4) = 4 by ring]
      norm_num
    calc (2 : ℝ) ^ (-(j : ℤ)) * ‖η‖ ≤ (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 4) :=
          mul_le_mul_of_nonneg_left h2 (by positivity)
      _ = 16 := hid
  rw [Ntl, nrm_eq hlow hhigh, hnorm, ← mul_assoc, hr, two_zpow_neg_mul, one_mul]

/-- The directional derivative of the rescaled smooth norm. -/
def gnrm (j : ℕ) (x u : Pl) : ℝ := fderiv ℝ nrm ((2 : ℝ) ^ (-(j : ℤ)) • x) u

theorem gnrm_neg (j : ℕ) (x u : Pl) : gnrm j x (-u) = -gnrm j x u := by
  rw [gnrm, gnrm, ← ContinuousLinearMap.map_neg]

theorem hasDerivAt_Ntl_line (j : ℕ) (x u : Pl) :
    HasDerivAt (fun r : ℝ => Ntl j (x + r • u)) (gnrm j x u) 0 := by
  set c : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hc
  have h := hasDerivAt_nrm_line (c • x) (c • u)
  have hfun : (fun r : ℝ => nrm (c • x + r • (c • u)))
      = fun r : ℝ => nrm (c • (x + r • u)) := by
    funext r
    congr 1
    rw [smul_add, smul_smul, smul_smul, mul_comm r c]
  rw [hfun] at h
  have hlin : fderiv ℝ nrm (c • x) (c • u) = c * fderiv ℝ nrm (c • x) u := by
    rw [ContinuousLinearMap.map_smul, smul_eq_mul]
  rw [hlin] at h
  have h2 := h.const_mul ((2 : ℝ) ^ (j : ℤ))
  have heq : (2 : ℝ) ^ (j : ℤ) * (c * fderiv ℝ nrm (c • x) u) = gnrm j x u := by
    rw [gnrm, ← hc, ← mul_assoc, hc, two_zpow_neg_mul, one_mul]
  rw [heq] at h2
  have hfun2 : (fun r : ℝ => (2 : ℝ) ^ (j : ℤ) * nrm (c • (x + r • u)))
      = fun r : ℝ => Ntl j (x + r • u) := by
    funext r
    rw [Ntl, hc]
  rw [hfun2] at h2
  exact h2

theorem gnrm_eq {j : ℕ} {x : Pl} (h1 : (2 : ℝ) ^ ((j : ℤ) - 3) < ‖x‖)
    (h2 : ‖x‖ < (2 : ℝ) ^ ((j : ℤ) + 4)) {u : Pl} (hu : ‖u‖ = 1) :
    gnrm j x u = (inner ℝ x u : ℝ) / ‖x‖ := by
  set c : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hc
  have hcpos : (0 : ℝ) < c := by rw [hc]; positivity
  have hnorm : ‖c • x‖ = c * ‖x‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hcpos]
  have hlow : (1 : ℝ) / 8 < ‖c • x‖ := by
    rw [hnorm, hc]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 3) = 1 / 8 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) - 3) = -3 by ring]
      norm_num
    calc (1 : ℝ) / 8 = (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) - 3) := hid.symm
      _ < (2 : ℝ) ^ (-(j : ℤ)) * ‖x‖ := by
          refine mul_lt_mul_of_pos_left h1 (by positivity)
  have hhigh : ‖c • x‖ < 16 := by
    rw [hnorm, hc]
    have hid : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 4) = 16 := by
      rw [← two_zpow_add, show -(j : ℤ) + ((j : ℤ) + 4) = 4 by ring]
      norm_num
    calc (2 : ℝ) ^ (-(j : ℤ)) * ‖x‖ < (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 4) := by
          refine mul_lt_mul_of_pos_left h2 (by positivity)
      _ = 16 := hid
  rw [gnrm, ← hc, fderiv_nrm_apply hlow hhigh hu, hnorm, real_inner_smul_left,
    mul_div_mul_left _ _ hcpos.ne']

/-- The smooth phase of §4.4. -/
def phsm (j : ℕ) (ε t : ℝ) (ξ w η : Pl) : ℝ :=
  inner ℝ w η + ε * t * (Ntl j (ξ - η) + Ntl j η)

theorem hasDerivAt_phsm (j : ℕ) (ε t : ℝ) (ξ w η u : Pl) :
    HasDerivAt (fun r : ℝ => phsm j ε t ξ w (η + r • u))
      (inner ℝ w u + ε * t * (-(gnrm j (ξ - η) u) + gnrm j η u)) 0 := by
  have h1 : HasDerivAt (fun r : ℝ => (inner ℝ w (η + r • u) : ℝ)) (inner ℝ w u) 0 := by
    have hf : (fun r : ℝ => (inner ℝ w (η + r • u) : ℝ))
        = fun r : ℝ => inner ℝ w η + r * inner ℝ w u := by
      funext r
      rw [inner_add_right, real_inner_smul_right]
    rw [hf]
    have h2 : HasDerivAt (fun r : ℝ => r * (inner ℝ w u : ℝ)) (inner ℝ w u) 0 := by
      simpa using (hasDerivAt_id (0 : ℝ)).mul_const (inner ℝ w u : ℝ)
    exact h2.const_add _
  have h2 : HasDerivAt (fun r : ℝ => Ntl j (η + r • u)) (gnrm j η u) 0 :=
    hasDerivAt_Ntl_line j η u
  have h3 : HasDerivAt (fun r : ℝ => Ntl j (ξ - (η + r • u))) (-(gnrm j (ξ - η) u)) 0 := by
    have hline : (fun r : ℝ => Ntl j (ξ - (η + r • u)))
        = fun r : ℝ => Ntl j ((ξ - η) + r • (-u)) := by
      funext r
      congr 1
      rw [smul_neg]
      abel
    rw [hline, ← gnrm_neg]
    exact hasDerivAt_Ntl_line j (ξ - η) (-u)
  have hsum := h1.add ((h3.add h2).const_mul (ε * t))
  have hfun : (fun r : ℝ => phsm j ε t ξ w (η + r • u))
      = fun r : ℝ => (inner ℝ w (η + r • u) : ℝ) +
        ε * t * (Ntl j (ξ - (η + r • u)) + Ntl j (η + r • u)) := by
    funext r
    rw [phsm]
  rw [hfun]
  exact hsum

/-- On the support of a `(j,m)`-adapted symbol the smooth phase is the true phase. -/
theorem phsm_eq_ph {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) (ε t : ℝ) (w : Pl) :
    phsm j ε t ξ w η = ph ε t ξ w η := by
  obtain ⟨hηT, hξηT, -⟩ := h
  have hwiden : ∀ x : Pl, (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖x‖ → ‖x‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) →
      Ntl j x = ‖x‖ := by
    intro x hx1 hx2
    refine Ntl_eq (le_trans ?_ hx1) (le_trans hx2 ?_)
    · exact zpow_le_zpow_right₀ (by norm_num) (by omega)
    · exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  rw [phsm, ph, hwiden η hηT.2.2.1 hηT.2.2.2, hwiden (ξ - η) hξηT.2.2.1 hξηT.2.2.2]

/-- On the support the smooth phase gradient is the true one. -/
theorem gnrm_eq_of_mem {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) {u : Pl} (hu : ‖u‖ = 1) :
    -(gnrm j (ξ - η) u) + gnrm j η u
      = -((inner ℝ (ξ - η) u : ℝ) / ‖ξ - η‖) + (inner ℝ η u : ℝ) / ‖η‖ := by
  obtain ⟨hηT, hξηT, -⟩ := h
  have hwiden : ∀ x : Pl, (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖x‖ → ‖x‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) →
      gnrm j x u = (inner ℝ x u : ℝ) / ‖x‖ := by
    intro x hx1 hx2
    refine gnrm_eq (lt_of_lt_of_le ?_ hx1) (lt_of_le_of_lt hx2 ?_) hu
    · exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
    · exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
  rw [hwiden η hηT.2.2.1 hηT.2.2.2, hwiden (ξ - η) hξηT.2.2.1 hξηT.2.2.2]

end SmoothPhase


/-! ## The truncated phase gradient

`Psi` is a globally smooth function of `η` that agrees with the `i`-th coordinate of the gradient of
the smooth phase on the support of a `(j,m)`-adapted symbol, and satisfies
`|Psi| ≥ |w_i| - 2^{12-m}` everywhere.  This is what allows one integration by parts with no case
distinctions.
-/

section PsiSec

/-- The truncation of `Vt` at height `2^{9-m}`. -/
def Vhat (j m : ℕ) (ξ : Pl) (i : Fin 2) (η : Pl) : ℝ :=
  (2 : ℝ) ^ (9 - (m : ℤ)) * shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η)

theorem contDiff_Vhat (j m : ℕ) (ξ : Pl) (i : Fin 2) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (Vhat j m ξ i) :=
  contDiff_const.mul (contDiff_shrinkS.comp (contDiff_const.mul (contDiff_Vt j ξ i)))

theorem abs_Vhat_le (j m : ℕ) (ξ : Pl) (i : Fin 2) (η : Pl) :
    |Vhat j m ξ i η| ≤ (2 : ℝ) ^ (10 - (m : ℤ)) := by
  have h := abs_shrinkS_le ((2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η)
  have hc : (0 : ℝ) < (2 : ℝ) ^ (9 - (m : ℤ)) := by positivity
  rw [Vhat, abs_mul, abs_of_pos hc]
  have hid : (2 : ℝ) ^ (10 - (m : ℤ)) = (2 : ℝ) ^ (9 - (m : ℤ)) * 2 := by
    rw [show (10 : ℤ) - (m : ℤ) = (9 - (m : ℤ)) + 1 by ring, two_zpow_add, zpow_one]
  rw [hid]
  exact mul_le_mul_of_nonneg_left h hc.le

theorem Vhat_eq_Vt {j m : ℕ} {ξ : Pl} {i : Fin 2} {η : Pl}
    (h : |Vt j ξ i η| ≤ (2 : ℝ) ^ (9 - (m : ℤ))) : Vhat j m ξ i η = Vt j ξ i η := by
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ ((m : ℤ) - 9) := by positivity
  have hxle : |(2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η| ≤ 1 := by
    rw [abs_mul, abs_of_pos hcpos]
    have hstep : (2 : ℝ) ^ ((m : ℤ) - 9) * |Vt j ξ i η|
        ≤ (2 : ℝ) ^ ((m : ℤ) - 9) * (2 : ℝ) ^ (9 - (m : ℤ)) :=
      mul_le_mul_of_nonneg_left h hcpos.le
    refine le_trans hstep (le_of_eq ?_)
    rw [← two_zpow_add, show ((m : ℤ) - 9) + (9 - (m : ℤ)) = 0 by ring, zpow_zero]
  have hsq : ((2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η) ^ 2 ≤ 1 := by
    nlinarith [abs_nonneg ((2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η),
      sq_abs ((2 : ℝ) ^ ((m : ℤ) - 9) * Vt j ξ i η)]
  rw [Vhat, shrinkS_eq_self hsq, ← mul_assoc]
  have hid : (2 : ℝ) ^ (9 - (m : ℤ)) * (2 : ℝ) ^ ((m : ℤ) - 9) = 1 := by
    rw [← two_zpow_add, show (9 - (m : ℤ)) + ((m : ℤ) - 9) = 0 by ring, zpow_zero]
  rw [hid, one_mul]

/-- On the support of a `(j,m)`-adapted symbol `Vt` is at most `2^{9-m}` in absolute value. -/
theorem abs_Vt_le_of_mem {j m : ℕ} {ξ η : Pl} {i : Fin 2} (hξ : XiData j ξ)
    (h : η ∈ SuppSet j m ξ) : |Vt j ξ i η| ≤ (2 : ℝ) ^ (9 - (m : ℤ)) := by
  have hηpos : (0 : ℝ) < ‖η‖ := lt_of_lt_of_le (by positivity) h.1.2.2.1
  have hξηpos : (0 : ℝ) < ‖ξ - η‖ := lt_of_lt_of_le (by positivity) h.2.1.2.2.1
  have hη : η ≠ 0 := norm_pos_iff.mp hηpos
  have hξη : ξ - η ≠ 0 := norm_pos_iff.mp hξηpos
  have hVeq : Vt j ξ i η = (‖η‖⁻¹ • η - ‖ξ - η‖⁻¹ • (ξ - η)) i := by
    rw [Vt_eq h]
    simp only [PiLp.sub_apply, PiLp.smul_apply, smul_eq_mul]
    field_simp
  rw [hVeq]
  refine le_trans (Auto.CalderonVaillancourt.abs_apply_le_norm _ i) ?_
  exact le_trans (norm_unit_diff_le hη hξη) (angle_eta_le hξ h)

theorem Vhat_eq_of_mem {j m : ℕ} {ξ η : Pl} {i : Fin 2} (hξ : XiData j ξ)
    (h : η ∈ SuppSet j m ξ) : Vhat j m ξ i η = Vt j ξ i η :=
  Vhat_eq_Vt (abs_Vt_le_of_mem hξ h)

/-- The truncated `i`-th component of the gradient of the smooth phase. -/
def Psi (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (w η : Pl) : ℝ :=
  w i + ε * t * Vhat j m ξ i η

theorem contDiff_Psi (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (w : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (Psi j m ε t ξ i w) :=
  contDiff_const.add (contDiff_const.mul (contDiff_Vhat j m ξ i))

/-- The lower bound for `|Psi|`: the correction is at most `2^{12-m}`. -/
theorem abs_Psi_ge {j m : ℕ} {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) (w η : Pl) :
    |w i| - (2 : ℝ) ^ (12 - (m : ℤ)) ≤ |Psi j m ε t ξ i w η| := by
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_pos (by linarith)]
    exact ht2
  have hcorr : |ε * t * Vhat j m ξ i η| ≤ (2 : ℝ) ^ (12 - (m : ℤ)) := by
    rw [abs_mul]
    have hid : (2 : ℝ) ^ (11 - (m : ℤ)) = 2 * (2 : ℝ) ^ (10 - (m : ℤ)) := by
      rw [show (11 : ℤ) - (m : ℤ) = 1 + (10 - (m : ℤ)) by ring, two_zpow_add, zpow_one]
    have hstep : |ε * t| * |Vhat j m ξ i η| ≤ 2 * (2 : ℝ) ^ (10 - (m : ℤ)) :=
      mul_le_mul hεt (abs_Vhat_le j m ξ i η) (abs_nonneg _) (by norm_num)
    refine le_trans hstep ?_
    rw [← hid]
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  have hsplit : |w i| ≤ |Psi j m ε t ξ i w η| + |ε * t * Vhat j m ξ i η| := by
    have hid : w i = Psi j m ε t ξ i w η - ε * t * Vhat j m ξ i η := by
      rw [Psi]
      ring
    rw [hid]
    exact abs_sub _ _
  linarith

/-- On the support the truncated gradient is the true gradient of the smooth phase. -/
theorem Psi_eq_of_mem {j m : ℕ} {ξ η : Pl} (hξ : XiData j ξ) (h : η ∈ SuppSet j m ξ)
    (ε t : ℝ) (i : Fin 2) (w : Pl) :
    Psi j m ε t ξ i w η
      = inner ℝ w (ev i) + ε * t * (-(gnrm j (ξ - η) (ev i)) + gnrm j η (ev i)) := by
  rw [Psi, inner_ev, Vhat_eq_of_mem hξ h, Vt_eq h, gnrm_eq_of_mem h (norm_ev i),
    inner_ev, inner_ev]
  ring

end PsiSec


/-! ## Integration by parts in `η`

One integration by parts in the coordinate direction `ev i`, with the amplitude `b / Psi`.  Since
the phase and `Psi` are globally smooth and `Psi` does not vanish, no case distinctions are needed.
-/

section IBP44

theorem osc_add (lam a c : ℝ) : osc lam (a + c) = osc lam a * osc lam c := by
  rw [osc, osc, osc, ← Complex.exp_add]
  congr 1
  push_cast
  ring

/-- The line derivative of a smooth function. -/
theorem hasDerivAt_line {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (η u : Pl) :
    HasDerivAt (fun r : ℝ => f (η + r • u)) (fderiv ℝ f η u) 0 := by
  have hg : HasDerivAt (fun r : ℝ => η + r • u) u 0 := by
    simpa using ((hasDerivAt_id (0 : ℝ)).smul_const u).const_add η
  have hfd : HasFDerivAt f (fderiv ℝ f η) (η + (0 : ℝ) • u) := by
    have h := (hf.differentiable (by simp) η).hasFDerivAt
    simpa using h
  exact hfd.comp_hasDerivAt 0 hg

theorem contDiff_inner_left (w : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun η : Pl => (inner ℝ w η : ℝ)) := by
  have h : (fun η : Pl => (inner ℝ w η : ℝ)) = fun η => (innerSL ℝ w) η := rfl
  rw [h]
  exact (innerSL ℝ w).contDiff

theorem contDiff_phsm (j : ℕ) (ε t : ℝ) (ξ w : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (phsm j ε t ξ w) :=
  (contDiff_inner_left w).add
    (contDiff_const.mul
      (((contDiff_Ntl j).comp (contDiff_const.sub contDiff_id)).add (contDiff_Ntl j)))

/-- The total oscillatory factor of §4.4, with the smooth phase. -/
def oscph (j : ℕ) (ε t : ℝ) (ξ w η : Pl) : ℂ := osc (2 * Real.pi) (phsm j ε t ξ w η)

@[simp] theorem norm_oscph (j : ℕ) (ε t : ℝ) (ξ w η : Pl) : ‖oscph j ε t ξ w η‖ = 1 :=
  norm_osc _ _

theorem continuous_oscph (j : ℕ) (ε t : ℝ) (ξ w : Pl) : Continuous (oscph j ε t ξ w) := by
  refine Complex.continuous_exp.comp ?_
  refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
  exact continuous_const.mul (contDiff_phsm j ε t ξ w).continuous

/-- On the support the smooth oscillatory factor is the product of the true phase and the Fourier
kernel. -/
theorem oscph_eq_of_mem {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) (ε t : ℝ) (w : Pl) :
    oscph j ε t ξ w η = ee (-(inner ℝ w η : ℝ)) * phase ε t ξ η := by
  rw [oscph, phsm_eq_ph h, ph, osc_add]
  congr 1
  · rw [osc, ee]
    congr 2
    push_cast
    ring
  · rw [osc, phase]
    congr 2
    push_cast
    ring

/-- The derivative of the total phase in the direction `u`. -/
def dphsf (j : ℕ) (ε t : ℝ) (ξ w u η : Pl) : ℝ :=
  inner ℝ w u + ε * t * (-(gnrm j (ξ - η) u) + gnrm j η u)

theorem hasDerivAt_oscph_line (j : ℕ) (ε t : ℝ) (ξ w η u : Pl) :
    HasDerivAt (fun r : ℝ => oscph j ε t ξ w (η + r • u))
      (oscph j ε t ξ w η *
        ((((2 * Real.pi * dphsf j ε t ξ w u η : ℝ)) : ℂ) * Complex.I)) 0 := by
  have h := hasDerivAt_osc (lam := 2 * Real.pi) (hasDerivAt_phsm j ε t ξ w η u)
  simpa [oscph, dphsf] using h

/-- The integration-by-parts amplitude `b / Psi`. -/
def Amp (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (w η : Pl) : ℂ :=
  b t ξ η / (((Psi j m ε t ξ i w η : ℝ)) : ℂ)

/-- Its derivative in the direction `u`. -/
def Ampd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (w u η : Pl) : ℂ :=
  (fderiv ℝ (b t ξ) η u * (((Psi j m ε t ξ i w η : ℝ)) : ℂ)
      - b t ξ η * (((fderiv ℝ (Psi j m ε t ξ i w) η u : ℝ)) : ℂ))
    / (((Psi j m ε t ξ i w η : ℝ)) : ℂ) ^ 2

theorem hasDerivAt_Amp_line {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) (η u : Pl) :
    HasDerivAt (fun r : ℝ => Amp j m ε t ξ i b w (η + r • u))
      (Ampd j m ε t ξ i b w u η) 0 := by
  have hbline : HasDerivAt (fun r : ℝ => b t ξ (η + r • u)) (fderiv ℝ (b t ξ) η u) 0 :=
    hasDerivAt_line hb η u
  have hPline : HasDerivAt (fun r : ℝ => Psi j m ε t ξ i w (η + r • u))
      (fderiv ℝ (Psi j m ε t ξ i w) η u) 0 :=
    hasDerivAt_line (contDiff_Psi j m ε t ξ i w) η u
  have hPC : HasDerivAt (fun r : ℝ => (((Psi j m ε t ξ i w (η + r • u) : ℝ)) : ℂ))
      ((((fderiv ℝ (Psi j m ε t ξ i w) η u : ℝ)) : ℂ)) 0 := hPline.ofReal_comp
  have hne : (((Psi j m ε t ξ i w (η + (0 : ℝ) • u) : ℝ)) : ℂ) ≠ 0 := by
    simp only [zero_smul, add_zero]
    exact Complex.ofReal_ne_zero.mpr (hPsi η)
  have h := hbline.div hPC hne
  simp only [zero_smul, add_zero] at h
  rw [Ampd]
  exact h

/-- The full integrand of §4.4. -/
def Intg (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (w η : Pl) : ℂ :=
  oscph j ε t ξ w η * Amp j m ε t ξ i b w η

/-- Its coordinate derivative. -/
def Intgd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (w η : Pl) : ℂ :=
  (((2 * Real.pi : ℝ)) : ℂ) * Complex.I * oscph j ε t ξ w η * b t ξ η
    + oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η

theorem hasDerivAt_Intg_line {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hξ : XiData j ξ) (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) (η : Pl) :
    HasDerivAt (fun r : ℝ => Intg j m ε t ξ i b w (η + r • ev i))
      (Intgd j m ε t ξ i b w η) 0 := by
  have h1 := hasDerivAt_oscph_line j ε t ξ w η (ev i)
  have h2 := hasDerivAt_Amp_line hb w hPsi η (ev i)
  have h := h1.mul h2
  simp only [zero_smul, add_zero] at h
  -- identify the first term
  have hkey : oscph j ε t ξ w η *
      ((((2 * Real.pi * dphsf j ε t ξ w (ev i) η : ℝ)) : ℂ) * Complex.I) *
        Amp j m ε t ξ i b w η
      = (((2 * Real.pi : ℝ)) : ℂ) * Complex.I * oscph j ε t ξ w η * b t ξ η := by
    by_cases hmem : η ∈ SuppSet j m ξ
    · have hdp : dphsf j ε t ξ w (ev i) η = Psi j m ε t ξ i w η := by
        rw [dphsf, Psi_eq_of_mem hξ hmem]
      rw [hdp, Amp]
      have hne : (((Psi j m ε t ξ i w η : ℝ)) : ℂ) ≠ 0 :=
        Complex.ofReal_ne_zero.mpr (hPsi η)
      push_cast
      field_simp
    · rw [hsupp η hmem, Amp, hsupp η hmem]
      simp
  have hfun : (fun r : ℝ => Intg j m ε t ξ i b w (η + r • ev i))
      = fun r : ℝ => oscph j ε t ξ w (η + r • ev i) *
        Amp j m ε t ξ i b w (η + r • ev i) := rfl
  rw [hfun, Intgd, ← hkey]
  exact h

end IBP44


/-! ### The integration by parts identity -/

section IBPIdentity

theorem continuous_fderiv_dir {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (u : Pl) :
    Continuous fun η : Pl => fderiv ℝ f η u := by
  have h := hf.continuous_fderiv_apply (by simp)
  exact h.comp (continuous_id.prodMk continuous_const)

theorem mk2_add_smul_ev_zero (x y s : ℝ) : mk2 x y + (s - x) • ev 0 = mk2 s y := by
  refine PiLp.ext fun k => ?_
  match k with
  | 0 =>
    rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, mk2_apply_zero, mk2_apply_zero, ev,
      mk2_apply_zero]
    ring
  | 1 =>
    rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, mk2_apply_one, mk2_apply_one, ev,
      mk2_apply_one]
    ring

theorem mk2_add_smul_ev_one (x y s : ℝ) : mk2 x y + (s - y) • ev 1 = mk2 x s := by
  refine PiLp.ext fun k => ?_
  match k with
  | 0 =>
    rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, mk2_apply_zero, mk2_apply_zero, ev,
      mk2_apply_zero]
    ring
  | 1 =>
    rw [PiLp.add_apply, PiLp.smul_apply, smul_eq_mul, mk2_apply_one, mk2_apply_one, ev,
      mk2_apply_one]
    ring

theorem hasDerivAt_coord_fst {f D : Pl → ℂ}
    (h : ∀ η : Pl, HasDerivAt (fun r : ℝ => f (η + r • ev 0)) (D η) 0) (x y : ℝ) :
    HasDerivAt (fun s : ℝ => f (mk2 s y)) (D (mk2 x y)) x := by
  have houter : HasDerivAt (fun r : ℝ => f (mk2 x y + r • ev 0)) (D (mk2 x y))
      (x - x) := by simpa using h (mk2 x y)
  have hcomp := houter.comp_sub_const x x
  have hfun : (fun s : ℝ => f (mk2 x y + (s - x) • ev 0)) = fun s : ℝ => f (mk2 s y) := by
    funext s
    rw [mk2_add_smul_ev_zero]
  rw [hfun] at hcomp
  exact hcomp

theorem hasDerivAt_coord_snd {f D : Pl → ℂ}
    (h : ∀ η : Pl, HasDerivAt (fun r : ℝ => f (η + r • ev 1)) (D η) 0) (x y : ℝ) :
    HasDerivAt (fun s : ℝ => f (mk2 x s)) (D (mk2 x y)) y := by
  have houter : HasDerivAt (fun r : ℝ => f (mk2 x y + r • ev 1)) (D (mk2 x y))
      (y - y) := by simpa using h (mk2 x y)
  have hcomp := houter.comp_sub_const y y
  have hfun : (fun s : ℝ => f (mk2 x y + (s - y) • ev 1)) = fun s : ℝ => f (mk2 x s) := by
    funext s
    rw [mk2_add_smul_ev_one]
  rw [hfun] at hcomp
  exact hcomp

theorem closure_SuppSet_subset_ball (j m : ℕ) (ξ : Pl) :
    closure (SuppSet j m ξ) ⊆ Metric.closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1)) := by
  refine closure_minimal ?_ Metric.isClosed_closedBall
  intro η hη
  rw [Metric.mem_closedBall, dist_zero_right]
  exact hη.1.2.2.2

theorem fderiv_b_eq_zero_of_notMem {j m : ℕ} {t : ℝ} {ξ : Pl} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0)
    {η : Pl} (h : η ∉ closure (SuppSet j m ξ)) : fderiv ℝ (b t ξ) η = 0 := by
  have hev : b t ξ =ᶠ[nhds η] fun _ : Pl => (0 : ℂ) := by
    filter_upwards [isClosed_closure.isOpen_compl.mem_nhds h] with x hx
    exact hsupp x fun hmem => hx (subset_closure hmem)
  rw [hev.fderiv_eq]
  simp

theorem Intgd_eq_zero_of_notMem {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl)
    {η : Pl} (h : η ∉ closure (SuppSet j m ξ)) : Intgd j m ε t ξ i b w η = 0 := by
  have hb0 : b t ξ η = 0 := hsupp η fun hmem => h (subset_closure hmem)
  have hfd : fderiv ℝ (b t ξ) η = 0 := fderiv_b_eq_zero_of_notMem hsupp h
  rw [Intgd, hb0, Ampd, hb0, hfd]
  simp

theorem hasCompactSupport_Intgd {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl) :
    HasCompactSupport (Intgd j m ε t ξ i b w) := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  exact Intgd_eq_zero_of_notMem hsupp w fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)

theorem hasCompactSupport_Intg {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl) :
    HasCompactSupport (Intg j m ε t ξ i b w) := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  have hb0 : b t ξ η = 0 := by
    refine hsupp η fun hmem => hη ?_
    exact closure_SuppSet_subset_ball j m ξ (subset_closure hmem)
  rw [Intg, Amp, hb0]
  simp

theorem continuous_Intgd {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    Continuous (Intgd j m ε t ξ i b w) := by
  have hbc : Continuous (b t ξ) := hb.continuous
  have hPc : Continuous (Psi j m ε t ξ i w) := (contDiff_Psi j m ε t ξ i w).continuous
  have hPCc : Continuous fun η : Pl => (((Psi j m ε t ξ i w η : ℝ)) : ℂ) :=
    Complex.continuous_ofReal.comp hPc
  have hbd : Continuous fun η : Pl => fderiv ℝ (b t ξ) η (ev i) :=
    continuous_fderiv_dir hb (ev i)
  have hPd : Continuous fun η : Pl => fderiv ℝ (Psi j m ε t ξ i w) η (ev i) :=
    continuous_fderiv_dir (contDiff_Psi j m ε t ξ i w) (ev i)
  have hAmpd : Continuous (Ampd j m ε t ξ i b w (ev i)) := by
    refine Continuous.div ?_ (hPCc.pow 2) ?_
    · exact (hbd.mul hPCc).sub (hbc.mul (Complex.continuous_ofReal.comp hPd))
    · intro η
      exact pow_ne_zero 2 (Complex.ofReal_ne_zero.mpr (hPsi η))
  exact ((continuous_const.mul (continuous_oscph j ε t ξ w)).mul hbc).add
    ((continuous_oscph j ε t ξ w).mul hAmpd)

theorem integral_Intgd_eq_zero {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hξ : XiData j ξ) (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    (∫ η : Pl, Intgd j m ε t ξ i b w η) = 0 := by
  have hline := hasDerivAt_Intg_line hξ hb hsupp w hPsi
  have hDc := continuous_Intgd hb w hPsi
  have hDs := hasCompactSupport_Intgd (ε := ε) (i := i) hsupp w
  have hfs := hasCompactSupport_Intg (ε := ε) (i := i) hsupp w
  match i with
  | 0 =>
    exact integral_partial_fst_eq_zero (hasDerivAt_coord_fst hline) hDc hDs hfs
  | 1 =>
    exact integral_partial_snd_eq_zero (hasDerivAt_coord_snd hline) hDc hDs hfs

/-- **The integration by parts identity of §4.4.** -/
theorem ibp44 {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hξ : XiData j ξ) (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)
      = -(1 / ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I)) *
          ∫ η : Pl, oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η := by
  have hbc : Continuous (b t ξ) := hb.continuous
  have h1c : Continuous fun η : Pl => oscph j ε t ξ w η * b t ξ η :=
    (continuous_oscph j ε t ξ w).mul hbc
  have h2c : Continuous fun η : Pl => oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η := by
    have hDc := continuous_Intgd hb w hPsi
    have h1 : Continuous fun η : Pl =>
        (((2 * Real.pi : ℝ)) : ℂ) * Complex.I * oscph j ε t ξ w η * b t ξ η :=
      (continuous_const.mul (continuous_oscph j ε t ξ w)).mul hbc
    have hsub : (fun η : Pl => oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η)
        = fun η : Pl => Intgd j m ε t ξ i b w η -
          (((2 * Real.pi : ℝ)) : ℂ) * Complex.I * oscph j ε t ξ w η * b t ξ η := by
      funext η
      rw [Intgd]
      ring
    rw [hsub]
    exact hDc.sub h1
  have h1s : HasCompactSupport fun η : Pl => oscph j ε t ξ w η * b t ξ η := by
    refine HasCompactSupport.intro
      (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
    have hb0 : b t ξ η = 0 := by
      refine hsupp η fun hmem => hη ?_
      exact closure_SuppSet_subset_ball j m ξ (subset_closure hmem)
    rw [hb0, mul_zero]
  have h2s : HasCompactSupport
      fun η : Pl => oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η := by
    refine HasCompactSupport.intro
      (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
    have hnot : η ∉ closure (SuppSet j m ξ) :=
      fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)
    have hb0 : b t ξ η = 0 := hsupp η fun hmem => hnot (subset_closure hmem)
    have hfd : fderiv ℝ (b t ξ) η = 0 := fderiv_b_eq_zero_of_notMem hsupp hnot
    rw [Ampd, hb0, hfd]
    simp
  have h1i : Integrable (fun η : Pl => oscph j ε t ξ w η * b t ξ η) :=
    h1c.integrable_of_hasCompactSupport h1s
  have h2i : Integrable
      (fun η : Pl => oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η) :=
    h2c.integrable_of_hasCompactSupport h2s
  have hsplit : (∫ η : Pl, Intgd j m ε t ξ i b w η)
      = (((2 * Real.pi : ℝ)) : ℂ) * Complex.I *
          (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)
        + ∫ η : Pl, oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η := by
    have hpt : ∀ η : Pl, Intgd j m ε t ξ i b w η
        = (((2 * Real.pi : ℝ)) : ℂ) * Complex.I * (oscph j ε t ξ w η * b t ξ η)
          + oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η := by
      intro η
      rw [Intgd]
      ring
    rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
      integral_add (h1i.const_mul _) h2i, integral_const_mul]
  have hzero := integral_Intgd_eq_zero hξ hb hsupp w hPsi
  rw [hsplit] at hzero
  have hne : ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I) ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    simp [Real.pi_ne_zero]
  field_simp
  linear_combination hzero

end IBPIdentity


/-! ## The Neumann expansion

On the region where `|w_i|` dominates the correction, `1/Psi` is expanded into a finite geometric
series whose terms are products of a function of `w` alone and a function of `η` alone.  This is
what turns the symbol into a sum of `K` separated symbols, each handled by plain Plancherel.
-/

section Neumann

/-- The finite Neumann expansion of `1/(a+v)` with an explicit remainder. -/
theorem inv_add_geom {F : Type*} [Field F] (K : ℕ) {a v : F} (ha : a ≠ 0) (hav : a + v ≠ 0) :
    1 / (a + v)
      = (∑ k ∈ Finset.range K, (-v) ^ k / a ^ (k + 1)) + (-v) ^ K / (a ^ K * (a + v)) := by
  induction K with
  | zero => simp
  | succ K ih =>
    have hak : a ^ K ≠ 0 := pow_ne_zero K ha
    have hak1 : a ^ (K + 1) ≠ 0 := pow_ne_zero _ ha
    have hstep : (-v) ^ K / (a ^ K * (a + v))
        = (-v) ^ K / a ^ (K + 1) + (-v) ^ (K + 1) / (a ^ (K + 1) * (a + v)) := by
      rw [pow_succ, pow_succ]
      field_simp
      ring
    rw [Finset.sum_range_succ, ih, hstep]
    ring

/-- The `η`-dependent factor of the smooth oscillatory kernel. -/
def phasm (j : ℕ) (ε t : ℝ) (ξ η : Pl) : ℂ :=
  osc (2 * Real.pi) (ε * t * (Ntl j (ξ - η) + Ntl j η))

@[simp] theorem norm_phasm (j : ℕ) (ε t : ℝ) (ξ η : Pl) : ‖phasm j ε t ξ η‖ = 1 :=
  norm_osc _ _

/-- The oscillatory kernel factors globally into a Fourier kernel in `w` and a phase in `η`. -/
theorem oscph_factor (j : ℕ) (ε t : ℝ) (ξ w η : Pl) :
    oscph j ε t ξ w η = ee (-(inner ℝ w η : ℝ)) * phasm j ε t ξ η := by
  rw [oscph, phsm, osc_add, phasm]
  congr 1
  rw [osc, ee]
  congr 2
  push_cast
  ring

theorem contDiff_osc_comp {τ : Pl → ℝ} (hτ : ContDiff ℝ (↑(⊤ : ℕ∞)) τ) (lam : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun η : Pl => osc lam (τ η)) := by
  refine Complex.contDiff_exp.comp ?_
  refine ContDiff.mul ?_ contDiff_const
  exact Complex.ofRealCLM.contDiff.comp (contDiff_const.mul hτ)

theorem contDiff_phasm (j : ℕ) (ε t : ℝ) (ξ : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (phasm j ε t ξ) := by
  refine contDiff_osc_comp ?_ (2 * Real.pi)
  exact contDiff_const.mul
    (((contDiff_Ntl j).comp (contDiff_const.sub contDiff_id)).add (contDiff_Ntl j))

/-- The `k`-th separated amplitude `b · (-ε t Vhat) ^ k`. -/
def cAmp (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (k : ℕ) (η : Pl) : ℂ :=
  b t ξ η * (((-(ε * t * Vhat j m ξ i η) : ℝ) : ℂ)) ^ k

theorem contDiff_cAmp {j m : ℕ} {t : ℝ} {ξ : Pl} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (ε : ℝ) (i : Fin 2) (k : ℕ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cAmp j m ε t ξ i b k) := by
  refine hb.mul (ContDiff.pow ?_ k)
  exact Complex.ofRealCLM.contDiff.comp
    ((contDiff_const.mul (contDiff_Vhat j m ξ i)).neg)

/-- The remainder amplitude `b · (-ε t Vhat) ^ K / (w_i ^ K · Psi)`. -/
def rAmp (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (K : ℕ) (w η : Pl) : ℂ :=
  cAmp j m ε t ξ i b K η /
    (((w i : ℝ) : ℂ) ^ K * ((Psi j m ε t ξ i w η : ℝ) : ℂ))

/-- The pointwise Neumann decomposition of the integration-by-parts amplitude. -/
theorem Amp_eq_sum {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (K : ℕ) {w : Pl} (hw : w i ≠ 0) (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) (η : Pl) :
    Amp j m ε t ξ i b w η
      = (∑ k ∈ Finset.range K, cAmp j m ε t ξ i b k η / ((w i : ℝ) : ℂ) ^ (k + 1))
        + rAmp j m ε t ξ i b K w η := by
  have hwC : ((w i : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr hw
  have hPsiC : ((Psi j m ε t ξ i w η : ℝ) : ℂ) ≠ 0 := Complex.ofReal_ne_zero.mpr (hPsi η)
  have hsplit : ((Psi j m ε t ξ i w η : ℝ) : ℂ)
      = ((w i : ℝ) : ℂ) + ((ε * t * Vhat j m ξ i η : ℝ) : ℂ) := by
    rw [Psi]
    push_cast
    ring
  have hexp := inv_add_geom K (a := ((w i : ℝ) : ℂ))
    (v := ((ε * t * Vhat j m ξ i η : ℝ) : ℂ)) hwC (by rw [← hsplit]; exact hPsiC)
  rw [Amp, div_eq_mul_one_div, hsplit, hexp, mul_add, Finset.mul_sum]
  congr 1
  · refine Finset.sum_congr rfl fun k _ => ?_
    rw [cAmp]
    push_cast
    ring
  · rw [rAmp, cAmp, ← hsplit]
    push_cast
    ring

end Neumann


/-! ### The derivative of the decomposition -/

section NeumannDeriv

/-- The coordinate derivative of the `k`-th separated amplitude. -/
def cAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (k : ℕ) (η : Pl) : ℂ :=
  fderiv ℝ (cAmp j m ε t ξ i b k) η (ev i)

/-- The coordinate derivative of the remainder amplitude. -/
def rAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (K : ℕ)
    (w η : Pl) : ℂ :=
  fderiv ℝ (fun z : Pl => rAmp j m ε t ξ i b K w z) η (ev i)

theorem contDiff_PsiC (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (w : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun η : Pl => ((Psi j m ε t ξ i w η : ℝ) : ℂ) :=
  Complex.ofRealCLM.contDiff.comp (contDiff_Psi j m ε t ξ i w)

theorem contDiff_PsiInvC {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun η : Pl => (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ) :=
  Complex.ofRealCLM.contDiff.comp ((contDiff_Psi j m ε t ξ i w).inv hPsi)

theorem contDiff_Amp {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (w : Pl)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (Amp j m ε t ξ i b w) := by
  have hfun : Amp j m ε t ξ i b w
      = fun η : Pl => b t ξ η * (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ) := by
    funext η
    rw [Amp, div_eq_mul_inv, Complex.ofReal_inv]
  rw [hfun]
  exact hb.mul (contDiff_PsiInvC w hPsi)

theorem contDiff_rAmp {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (K : ℕ) {w : Pl} (hw : w i ≠ 0)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun z : Pl => rAmp j m ε t ξ i b K w z := by
  have hfun : (fun z : Pl => rAmp j m ε t ξ i b K w z)
      = fun z : Pl => cAmp j m ε t ξ i b K z * ((((w i : ℝ) : ℂ) ^ K)⁻¹ *
        (((Psi j m ε t ξ i w z)⁻¹ : ℝ) : ℂ)) := by
    funext z
    rw [rAmp, div_eq_mul_inv, mul_inv, Complex.ofReal_inv]
  rw [hfun]
  exact (contDiff_cAmp hb ε i K).mul (contDiff_const.mul (contDiff_PsiInvC w hPsi))

/-- The Neumann decomposition of the coordinate derivative of the amplitude. -/
theorem Ampd_decomp {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (K : ℕ) {w : Pl} (hw : w i ≠ 0)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) (η : Pl) :
    Ampd j m ε t ξ i b w (ev i) η
      = (∑ k ∈ Finset.range K, cAmpd j m ε t ξ i b k η / ((w i : ℝ) : ℂ) ^ (k + 1))
        + rAmpd j m ε t ξ i b K w η := by
  have hL : HasDerivAt (fun r : ℝ => Amp j m ε t ξ i b w (η + r • ev i))
      (Ampd j m ε t ξ i b w (ev i) η) 0 := hasDerivAt_Amp_line hb w hPsi η (ev i)
  have hR : HasDerivAt (fun r : ℝ => Amp j m ε t ξ i b w (η + r • ev i))
      ((∑ k ∈ Finset.range K, cAmpd j m ε t ξ i b k η / ((w i : ℝ) : ℂ) ^ (k + 1))
        + rAmpd j m ε t ξ i b K w η) 0 := by
    have hfun : (fun r : ℝ => Amp j m ε t ξ i b w (η + r • ev i))
        = fun r : ℝ => (∑ k ∈ Finset.range K,
              cAmp j m ε t ξ i b k (η + r • ev i) / ((w i : ℝ) : ℂ) ^ (k + 1))
            + rAmp j m ε t ξ i b K w (η + r • ev i) := by
      funext r
      exact Amp_eq_sum K hw hPsi (η + r • ev i)
    have hsum : HasDerivAt (fun r : ℝ => ∑ k ∈ Finset.range K,
          cAmp j m ε t ξ i b k (η + r • ev i) / ((w i : ℝ) : ℂ) ^ (k + 1))
        (∑ k ∈ Finset.range K, cAmpd j m ε t ξ i b k η / ((w i : ℝ) : ℂ) ^ (k + 1)) 0 := by
      refine HasDerivAt.fun_sum fun k _ => ?_
      exact (hasDerivAt_line (contDiff_cAmp hb ε i k) η (ev i)).div_const _
    have hrem : HasDerivAt (fun r : ℝ => rAmp j m ε t ξ i b K w (η + r • ev i))
        (rAmpd j m ε t ξ i b K w η) 0 :=
      hasDerivAt_line (contDiff_rAmp hb K hw hPsi) η (ev i)
    rw [hfun]
    exact hsum.add hrem
  exact hL.unique hR

end NeumannDeriv


/-! ### Pointwise bounds for the separated amplitudes -/

section AmpBounds

/-- The chain rule for a scalar outer function, in the form of a directional derivative. -/
theorem fderiv_comp_scalar_apply {g : ℝ → ℝ} {f : Pl → ℝ} (hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g)
    (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (η u : Pl) :
    fderiv ℝ (fun z : Pl => g (f z)) η u = deriv g (f η) * fderiv ℝ f η u := by
  have hL : HasDerivAt (fun r : ℝ => g (f (η + r • u)))
      (fderiv ℝ (fun z : Pl => g (f z)) η u) 0 :=
    hasDerivAt_line (hg.comp hf) η u
  have hinner : HasDerivAt (fun r : ℝ => f (η + r • u)) (fderiv ℝ f η u) 0 :=
    hasDerivAt_line hf η u
  have houter : HasDerivAt g (deriv g (f (η + (0 : ℝ) • u))) (f (η + (0 : ℝ) • u)) :=
    ((hg.differentiable (by simp) _).hasDerivAt)
  have hR : HasDerivAt (fun r : ℝ => g (f (η + r • u)))
      (deriv g (f η) * fderiv ℝ f η u) 0 := by
    have h := houter.comp 0 hinner
    simp only [Function.comp_def, zero_smul, add_zero] at h
    exact h
  exact hL.unique hR

/-- Every derivative of `shrinkS` is bounded; in particular its first derivative. -/
theorem exists_shrinkS_deriv_bound : ∃ C : ℝ, 1 ≤ C ∧ ∀ x : ℝ, |deriv shrinkS x| ≤ C := by
  obtain ⟨C, hC1, hC⟩ := exists_deriv_bound contDiff_shrinkS hasCompactSupport_shrinkS 1
  refine ⟨C, hC1, fun x => ?_⟩
  have h := hC 1 (le_refl 1) x
  rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_one, Real.norm_eq_abs] at h
  exact h

/-- The scaled truncation used to define `Vhat`. -/
def shrScaled (m : ℕ) (x : ℝ) : ℝ :=
  (2 : ℝ) ^ (9 - (m : ℤ)) * shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * x)

theorem contDiff_shrScaled (m : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (shrScaled m) :=
  contDiff_const.mul (contDiff_shrinkS.comp (contDiff_const.mul contDiff_id))

theorem Vhat_eq_comp (j m : ℕ) (ξ : Pl) (i : Fin 2) :
    Vhat j m ξ i = fun η : Pl => shrScaled m (Vt j ξ i η) := by
  funext η
  rw [Vhat, shrScaled]

theorem abs_deriv_shrScaled_le {C : ℝ} (hC : ∀ x : ℝ, |deriv shrinkS x| ≤ C) (m : ℕ) (x : ℝ) :
    |deriv (shrScaled m) x| ≤ C := by
  have hd : deriv (shrScaled m) x
      = (2 : ℝ) ^ (9 - (m : ℤ)) * (deriv shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * x)
        * (2 : ℝ) ^ ((m : ℤ) - 9)) := by
    have h1 : HasDerivAt (fun y : ℝ => (2 : ℝ) ^ ((m : ℤ) - 9) * y)
        ((2 : ℝ) ^ ((m : ℤ) - 9)) x := by
      simpa using (hasDerivAt_id x).const_mul ((2 : ℝ) ^ ((m : ℤ) - 9))
    have h2 : HasDerivAt shrinkS (deriv shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * x))
        ((2 : ℝ) ^ ((m : ℤ) - 9) * x) :=
      (contDiff_shrinkS.differentiable (by simp) _).hasDerivAt
    have h3 := (h2.comp x h1).const_mul ((2 : ℝ) ^ (9 - (m : ℤ)))
    simp only [Function.comp_def] at h3
    have hfun : (fun y : ℝ => (2 : ℝ) ^ (9 - (m : ℤ)) *
        shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * y)) = shrScaled m := by
      funext y
      rw [shrScaled]
    rw [hfun] at h3
    exact h3.deriv
  rw [hd, abs_mul, abs_mul, abs_of_pos (show (0 : ℝ) < (2 : ℝ) ^ (9 - (m : ℤ)) by positivity),
    abs_of_pos (show (0 : ℝ) < (2 : ℝ) ^ ((m : ℤ) - 9) by positivity)]
  have hid : (2 : ℝ) ^ (9 - (m : ℤ)) * (2 : ℝ) ^ ((m : ℤ) - 9) = 1 := by
    rw [← two_zpow_add, show (9 - (m : ℤ)) + ((m : ℤ) - 9) = 0 by ring, zpow_zero]
  have hstep : (2 : ℝ) ^ (9 - (m : ℤ)) *
      (|deriv shrinkS ((2 : ℝ) ^ ((m : ℤ) - 9) * x)| * (2 : ℝ) ^ ((m : ℤ) - 9))
      ≤ (2 : ℝ) ^ (9 - (m : ℤ)) * (C * (2 : ℝ) ^ ((m : ℤ) - 9)) := by
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact mul_le_mul_of_nonneg_right (hC _) (by positivity)
  refine le_trans hstep (le_of_eq ?_)
  rw [← mul_assoc, mul_comm ((2 : ℝ) ^ (9 - (m : ℤ))) C, mul_assoc, hid, mul_one]

/-- The derivative of `Vhat` is `O(2^{-j})`. -/
theorem abs_fderiv_Vhat_le {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs)
    (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    (j m : ℕ) (ξ : Pl) (i : Fin 2) (η : Pl) {u : Pl} (hu : ‖u‖ = 1) :
    |fderiv ℝ (Vhat j m ξ i) η u| ≤ Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))) := by
  have hVt : ‖fderiv ℝ (Vt j ξ i) η u‖ ≤ 2 * CV * (2 : ℝ) ^ (-(j : ℤ)) := by
    have h1 : ‖fderiv ℝ (Vt j ξ i) η‖ ≤ 2 * CV * ((2 : ℝ) ^ (-(j : ℤ))) ^ 1 := by
      have h := norm_iteratedFDeriv_Vt_le (N := 1) hCVnn hCV j ξ i (le_refl 1) η
      rwa [norm_iteratedFDeriv_one] at h
    have h2 : ‖fderiv ℝ (Vt j ξ i) η u‖ ≤ ‖fderiv ℝ (Vt j ξ i) η‖ * ‖u‖ :=
      (fderiv ℝ (Vt j ξ i) η).le_opNorm u
    rw [hu, mul_one] at h2
    rw [pow_one] at h1
    exact le_trans h2 h1
  have hchain : fderiv ℝ (Vhat j m ξ i) η u
      = deriv (shrScaled m) (Vt j ξ i η) * fderiv ℝ (Vt j ξ i) η u := by
    rw [Vhat_eq_comp]
    exact fderiv_comp_scalar_apply (contDiff_shrScaled m) (contDiff_Vt j ξ i) η u
  rw [hchain, abs_mul]
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  refine mul_le_mul (abs_deriv_shrScaled_le hCs m _) ?_ (abs_nonneg _) hCsnn
  rw [← Real.norm_eq_abs]
  exact hVt

/-- The hypotheses of the off-diagonal estimate on the symbol: the paper's hypotheses restricted to
multi-indices of order at most one. -/
structure SymbData (j m : ℕ) (b : ℝ → Pl → Pl → ℂ) (B : ℝ) : Prop where
  smooth : ∀ t ξ, ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)
  supp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0
  bd0 : ∀ t ξ η, ‖b t ξ η‖ ≤ B
  bd1 : ∀ t ξ η, ∀ u : Pl, ‖u‖ = 1 →
    ‖fderiv ℝ (b t ξ) η u‖ ≤ B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))

theorem SymbData.nonneg {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (h : SymbData j m b B) :
    0 ≤ B := le_trans (norm_nonneg _) (h.bd0 0 0 0)

theorem SymbData.toIsAdapted {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (h : SymbData j m b B) : IsAdapted j m b :=
  ⟨fun t ξ => (h.smooth t ξ).continuous.measurable, h.supp⟩

end AmpBounds


/-! ### The complexified correction -/

section VcSec

/-- The complexified correction `-ε t Vhat`. -/
def Vc (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (η : Pl) : ℂ :=
  ((-(ε * t * Vhat j m ξ i η) : ℝ) : ℂ)

theorem contDiff_Vc (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (Vc j m ε t ξ i) :=
  Complex.ofRealCLM.contDiff.comp ((contDiff_const.mul (contDiff_Vhat j m ξ i)).neg)

theorem cAmp_eq_Vc (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (k : ℕ) :
    cAmp j m ε t ξ i b k = fun η : Pl => b t ξ η * Vc j m ε t ξ i η ^ k := by
  funext η
  rw [cAmp, Vc]

theorem norm_Vc_le {j m : ℕ} {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) (η : Pl) : ‖Vc j m ε t ξ i η‖ ≤ (2 : ℝ) ^ (11 - (m : ℤ)) := by
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_pos (by linarith)]
    exact ht2
  rw [Vc, Complex.norm_real, Real.norm_eq_abs, abs_neg, abs_mul]
  have hid : (2 : ℝ) ^ (11 - (m : ℤ)) = 2 * (2 : ℝ) ^ (10 - (m : ℤ)) := by
    rw [show (11 : ℤ) - (m : ℤ) = 1 + (10 - (m : ℤ)) by ring, two_zpow_add, zpow_one]
  rw [hid]
  exact mul_le_mul hεt (abs_Vhat_le j m ξ i η) (abs_nonneg _) (by norm_num)

theorem fderiv_Vc_apply (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (η u : Pl) :
    fderiv ℝ (Vc j m ε t ξ i) η u
      = ((-(ε * t * fderiv ℝ (Vhat j m ξ i) η u) : ℝ) : ℂ) := by
  have hL : HasDerivAt (fun r : ℝ => Vc j m ε t ξ i (η + r • u))
      (fderiv ℝ (Vc j m ε t ξ i) η u) 0 := hasDerivAt_line (contDiff_Vc j m ε t ξ i) η u
  have hVhat : HasDerivAt (fun r : ℝ => Vhat j m ξ i (η + r • u))
      (fderiv ℝ (Vhat j m ξ i) η u) 0 := hasDerivAt_line (contDiff_Vhat j m ξ i) η u
  have hreal : HasDerivAt (fun r : ℝ => -(ε * t * Vhat j m ξ i (η + r • u)))
      (-(ε * t * fderiv ℝ (Vhat j m ξ i) η u)) 0 := (hVhat.const_mul (ε * t)).neg
  have hR : HasDerivAt (fun r : ℝ => Vc j m ε t ξ i (η + r • u))
      (((-(ε * t * fderiv ℝ (Vhat j m ξ i) η u) : ℝ) : ℂ)) 0 := by
    have h := hreal.ofReal_comp
    have hfun : (fun r : ℝ => ((-(ε * t * Vhat j m ξ i (η + r • u)) : ℝ) : ℂ))
        = fun r : ℝ => Vc j m ε t ξ i (η + r • u) := by
      funext r
      rw [Vc]
    rw [hfun] at h
    exact h
  exact hL.unique hR

theorem norm_fderiv_Vc_le {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs)
    (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {j m : ℕ} {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) (η : Pl) {u : Pl} (hu : ‖u‖ = 1) :
    ‖fderiv ℝ (Vc j m ε t ξ i) η u‖ ≤ 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) := by
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_pos (by linarith)]
    exact ht2
  rw [fderiv_Vc_apply, Complex.norm_real, Real.norm_eq_abs, abs_neg, abs_mul]
  refine mul_le_mul hεt (abs_fderiv_Vhat_le hCs hCVnn hCV j m ξ i η hu) (abs_nonneg _)
    (by norm_num)

end VcSec

/-! ### The bound for the separated amplitudes -/

section CAmpdBound

/-- The pointwise bound for the coordinate derivative of the `k`-th separated amplitude. -/
theorem norm_cAmpd_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (k : ℕ) (η : Pl) :
    ‖cAmpd j m ε t ξ i b k η‖
      ≤ B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ k
        + B * (k : ℝ) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) *
          (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) := by
  have hBnn : 0 ≤ B := hB.nonneg
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  -- the derivative formula
  have hL : HasDerivAt (fun r : ℝ => cAmp j m ε t ξ i b k (η + r • ev i))
      (cAmpd j m ε t ξ i b k η) 0 :=
    hasDerivAt_line (contDiff_cAmp (hB.smooth t ξ) ε i k) η (ev i)
  have hbl : HasDerivAt (fun r : ℝ => b t ξ (η + r • ev i))
      (fderiv ℝ (b t ξ) η (ev i)) 0 := hasDerivAt_line (hB.smooth t ξ) η (ev i)
  have hVl : HasDerivAt (fun r : ℝ => Vc j m ε t ξ i (η + r • ev i))
      (fderiv ℝ (Vc j m ε t ξ i) η (ev i)) 0 :=
    hasDerivAt_line (contDiff_Vc j m ε t ξ i) η (ev i)
  have hpow : HasDerivAt (fun r : ℝ => Vc j m ε t ξ i (η + r • ev i) ^ k)
      ((k : ℂ) * Vc j m ε t ξ i η ^ (k - 1) * fderiv ℝ (Vc j m ε t ξ i) η (ev i)) 0 := by
    have h := hVl.fun_pow k
    simpa using h
  have hR : HasDerivAt (fun r : ℝ => cAmp j m ε t ξ i b k (η + r • ev i))
      (fderiv ℝ (b t ξ) η (ev i) * Vc j m ε t ξ i η ^ k
        + b t ξ η * ((k : ℂ) * Vc j m ε t ξ i η ^ (k - 1)
          * fderiv ℝ (Vc j m ε t ξ i) η (ev i))) 0 := by
    have h := hbl.fun_mul hpow
    simp only [zero_smul, add_zero] at h
    have hfun : (fun r : ℝ => b t ξ (η + r • ev i) * Vc j m ε t ξ i (η + r • ev i) ^ k)
        = fun r : ℝ => cAmp j m ε t ξ i b k (η + r • ev i) := by
      funext r
      rw [cAmp_eq_Vc]
    rw [hfun] at h
    exact h
  have hform := hL.unique hR
  rw [hform]
  -- now the bounds
  have hVb : ‖Vc j m ε t ξ i η‖ ≤ (2 : ℝ) ^ (11 - (m : ℤ)) := norm_Vc_le hε ht1 ht2 ξ i η
  have hVbnn : (0 : ℝ) ≤ (2 : ℝ) ^ (11 - (m : ℤ)) := by positivity
  have hpk : ‖Vc j m ε t ξ i η ^ k‖ ≤ ((2 : ℝ) ^ (11 - (m : ℤ))) ^ k := by
    rw [norm_pow]
    exact pow_le_pow_left₀ (norm_nonneg _) hVb k
  have hpk1 : ‖Vc j m ε t ξ i η ^ (k - 1)‖ ≤ ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) := by
    rw [norm_pow]
    exact pow_le_pow_left₀ (norm_nonneg _) hVb (k - 1)
  have hbd1 := hB.bd1 t ξ η (ev i) (norm_ev i)
  have hbd0 := hB.bd0 t ξ η
  have hVd : ‖fderiv ℝ (Vc j m ε t ξ i) η (ev i)‖
      ≤ 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) :=
    norm_fderiv_Vc_le hCs hCVnn hCV hε ht1 ht2 ξ i η (norm_ev i)
  have hVdnn : (0 : ℝ) ≤ 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) := by positivity
  refine le_trans (norm_add_le _ _) ?_
  have h1 : ‖fderiv ℝ (b t ξ) η (ev i) * Vc j m ε t ξ i η ^ k‖
      ≤ B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ k := by
    rw [norm_mul]
    refine mul_le_mul hbd1 hpk (norm_nonneg _) (by positivity)
  have h2 : ‖b t ξ η * ((k : ℂ) * Vc j m ε t ξ i η ^ (k - 1)
        * fderiv ℝ (Vc j m ε t ξ i) η (ev i))‖
      ≤ B * (k : ℝ) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) *
        (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) := by
    rw [norm_mul, norm_mul, norm_mul]
    have hknorm : ‖(k : ℂ)‖ = (k : ℝ) := by
      rw [Complex.norm_natCast]
    rw [hknorm]
    have hinner : (k : ℝ) * ‖Vc j m ε t ξ i η ^ (k - 1)‖
          * ‖fderiv ℝ (Vc j m ε t ξ i) η (ev i)‖
        ≤ (k : ℝ) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) *
          (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) := by
      refine mul_le_mul (mul_le_mul_of_nonneg_left hpk1 (Nat.cast_nonneg k)) hVd
        (norm_nonneg _) (by positivity)
    have houter : ‖b t ξ η‖ * ((k : ℝ) * ‖Vc j m ε t ξ i η ^ (k - 1)‖
          * ‖fderiv ℝ (Vc j m ε t ξ i) η (ev i)‖)
        ≤ B * ((k : ℝ) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) *
          (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) :=
      mul_le_mul hbd0 hinner (by positivity) hBnn
    exact le_trans houter (le_of_eq (by ring))
  linarith

end CAmpdBound


/-! ### Support and smoothness of the separated amplitudes -/

section CAmpSupport

theorem contDiff_fderiv_dir {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (u : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun η : Pl => fderiv ℝ f η u := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun η : Pl => fderiv ℝ f η := hf.fderiv_right (by simp)
  exact h1.clm_apply contDiff_const

theorem cAmp_eq_zero_of_notMem (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ)
    {η : Pl} (h : η ∉ SuppSet j m ξ) : cAmp j m ε t ξ i b k η = 0 := by
  rw [cAmp, hsupp t ξ η h, zero_mul]

theorem contDiff_cAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (k : ℕ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (cAmpd j m ε t ξ i b k) :=
  contDiff_fderiv_dir (contDiff_cAmp hb ε i k) (ev i)

theorem cAmpd_eq_zero_of_notMem (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ)
    {η : Pl} (h : η ∉ closure (SuppSet j m ξ)) : cAmpd j m ε t ξ i b k η = 0 := by
  have hev : cAmp j m ε t ξ i b k =ᶠ[nhds η] fun _ : Pl => (0 : ℂ) := by
    filter_upwards [isClosed_closure.isOpen_compl.mem_nhds h] with x hx
    exact cAmp_eq_zero_of_notMem j m ε t ξ i hsupp k fun hmem => hx (subset_closure hmem)
  rw [cAmpd, hev.fderiv_eq]
  simp

theorem hasCompactSupport_cAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) :
    HasCompactSupport (cAmpd j m ε t ξ i b k) := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  exact cAmpd_eq_zero_of_notMem j m ε t ξ i hsupp k
    fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)

/-- The `η`-function whose Fourier transform in `w` gives the `k`-th term. -/
def phcA (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ) (k : ℕ) (η : Pl) : ℂ :=
  phasm j ε t ξ η * cAmpd j m ε t ξ i b k η

theorem contDiff_phcA (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (k : ℕ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (phcA j m ε t ξ i b k) :=
  (contDiff_phasm j ε t ξ).mul (contDiff_cAmpd j m ε t ξ i hb k)

theorem hasCompactSupport_phcA (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) :
    HasCompactSupport (phcA j m ε t ξ i b k) := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  have h := cAmpd_eq_zero_of_notMem j m ε t ξ i hsupp k
    (η := η) fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)
  rw [phcA, h, mul_zero]

theorem norm_phcA (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (b : ℝ → Pl → Pl → ℂ)
    (k : ℕ) (η : Pl) : ‖phcA j m ε t ξ i b k η‖ = ‖cAmpd j m ε t ξ i b k η‖ := by
  rw [phcA, norm_mul, norm_phasm, one_mul]

/-- The `k`-th term as a Schwartz function. -/
def phcAS (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) : SchwartzMap Pl ℂ :=
  (hasCompactSupport_phcA j m ε t ξ i hsupp k).toSchwartzMap (contDiff_phcA j m ε t ξ i hb k)

/-- Plancherel for the `k`-th term. -/
theorem lintegral_enorm_sq_fourier_phcA (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) :
    (∫⁻ w : Pl, ‖𝓕 (phcA j m ε t ξ i b k) w‖ₑ ^ (2 : ℝ))
      = ∫⁻ η : Pl, ‖cAmpd j m ε t ξ i b k η‖ₑ ^ (2 : ℝ) := by
  have h := lintegral_enorm_sq_fourier_schwartz_Pl (phcAS j m ε t ξ i hb hsupp k)
  have hcoe : ((phcAS j m ε t ξ i hb hsupp k : SchwartzMap Pl ℂ) : Pl → ℂ)
      = phcA j m ε t ξ i b k := rfl
  rw [hcoe] at h
  rw [h]
  refine lintegral_congr fun η => ?_
  congr 1
  rw [phcA, enorm_mul, ← ofReal_norm, norm_phasm, ENNReal.ofReal_one, one_mul]

end CAmpSupport


/-! ### The Fourier identification and the region in `w` -/

section FourierId

/-- The `η`-integral of the `k`-th separated term is a Fourier transform in `w`. -/
theorem integral_oscph_mul_cAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    (b : ℝ → Pl → Pl → ℂ) (k : ℕ) (w : Pl) :
    (∫ η : Pl, oscph j ε t ξ w η * cAmpd j m ε t ξ i b k η)
      = 𝓕 (phcA j m ε t ξ i b k) (-w) := by
  rw [fourier_eq_ee_Pl]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  show oscph j ε t ξ w η * cAmpd j m ε t ξ i b k η
      = ee (inner ℝ η (-w)) * phcA j m ε t ξ i b k η
  have harg : (inner ℝ η (-w) : ℝ) = -(inner ℝ w η : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  rw [oscph_factor, phcA, harg]
  ring

/-- In the plane one of the two coordinates is at least half the norm. -/
theorem exists_coord_large (w : Pl) : ∃ i : Fin 2, ‖w‖ ≤ 2 * |w i| := by
  rcases le_or_gt (‖w‖) (2 * |w 0|) with h | h
  · exact ⟨0, h⟩
  · refine ⟨1, ?_⟩
    have hsq := norm_sq_eq_coords w
    nlinarith [abs_nonneg (w 0), abs_nonneg (w 1), sq_abs (w 0), sq_abs (w 1),
      norm_nonneg w]

theorem two_zpow_succ_sub (a : ℤ) : (2 : ℝ) ^ (a + 1) = 2 * (2 : ℝ) ^ a := by
  rw [show a + 1 = 1 + a by ring, two_zpow_add, zpow_one]

/-- On the region where `|w_i|` is large, `Psi` is at least `|w_i| / 2` in absolute value. -/
theorem abs_Psi_lower (j m : ℕ) {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) {w : Pl} (hw : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i|) (η : Pl) :
    |w i| / 2 ≤ |Psi j m ε t ξ i w η| := by
  have h := abs_Psi_ge (m := m) (j := j) hε ht1 ht2 ξ i w η
  have hid : (2 : ℝ) ^ (13 - (m : ℤ)) = 2 * (2 : ℝ) ^ (12 - (m : ℤ)) := by
    rw [show (13 : ℤ) - (m : ℤ) = (12 - (m : ℤ)) + 1 by ring, two_zpow_succ_sub]
  rw [hid] at hw
  linarith

theorem Psi_ne_zero {j m : ℕ} {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) {w : Pl} (hw : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i|) (η : Pl) :
    Psi j m ε t ξ i w η ≠ 0 := by
  have hlow := abs_Psi_lower j m hε ht1 ht2 ξ i hw η
  have hpos : (0 : ℝ) < |w i| := lt_of_lt_of_le (by positivity) hw
  intro h0
  rw [h0, abs_zero] at hlow
  linarith

theorem w_coord_ne_zero {m : ℕ} {w : Pl} {i : Fin 2}
    (hw : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i|) : w i ≠ 0 := by
  have hpos : (0 : ℝ) < |w i| := lt_of_lt_of_le (by positivity) hw
  intro h0
  rw [h0, abs_zero] at hpos
  linarith

end FourierId


/-! ### The smooth phase agrees with the true one on the support -/

section PhasmEq

theorem phasm_eq_phase {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) (ε t : ℝ) :
    phasm j ε t ξ η = phase ε t ξ η := by
  obtain ⟨hηT, hξηT, -⟩ := h
  have hwiden : ∀ x : Pl, (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖x‖ → ‖x‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) →
      Ntl j x = ‖x‖ := by
    intro x hx1 hx2
    refine Ntl_eq (le_trans ?_ hx1) (le_trans hx2 ?_)
    · exact zpow_le_zpow_right₀ (by norm_num) (by omega)
    · exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  rw [phasm, hwiden η hηT.2.2.1 hηT.2.2.2, hwiden (ξ - η) hξηT.2.2.1 hξηT.2.2.2, osc, phase]
  congr 2
  push_cast
  ring

/-- The product `phase · b · e^{-2πi⟪w,η⟫}` is the smooth oscillatory kernel times `b`. -/
theorem phase_mul_b_eq {j m : ℕ} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (ε t : ℝ) (ξ w η : Pl) :
    phase ε t ξ η * b t ξ η * ee (-(inner ℝ w η : ℝ))
      = oscph j ε t ξ w η * b t ξ η := by
  by_cases hmem : η ∈ SuppSet j m ξ
  · rw [oscph_factor, phasm_eq_phase hmem ε t]
    ring
  · rw [hsupp t ξ η hmem]
    ring

end PhasmEq

/-! ### Integrability of the partial Fourier transform -/

section GfIntegrable

theorem continuous_Gf_pair (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Continuous fun q : Pl × Pl => ee (inner ℝ q.1 ξ) * (H : Pl2 → ℂ) (pr q.1 q.2) := by
  have h1 : Continuous fun q : Pl × Pl => ee (inner ℝ q.1 ξ) :=
    continuous_ee.comp (continuous_fst.inner continuous_const)
  have h2 : Continuous fun q : Pl × Pl => (H : Pl2 → ℂ) (pr q.1 q.2) :=
    H.continuous.comp continuous_prPair
  exact h1.mul h2

theorem integrable_Gf_pair (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Integrable (fun q : Pl × Pl => ee (inner ℝ q.1 ξ) * (H : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) := by
  have hbase : Integrable (fun q : Pl × Pl => (H : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) :=
    measurePreserving_prPair.integrable_comp_of_integrable H.integrable
  refine Integrable.mono' hbase.norm (continuous_Gf_pair H ξ).aestronglyMeasurable ?_
  refine Filter.Eventually.of_forall fun q => ?_
  rw [norm_mul, norm_ee, one_mul]

theorem Gf_eq_integral (H : SchwartzMap Pl2 ℂ) (ξ w : Pl) :
    Gf (H : Pl2 → ℂ) ξ w = ∫ y : Pl, ee (inner ℝ y ξ) * (H : Pl2 → ℂ) (pr y w) := by
  rw [Gf, fourier_eq_ee_Pl]

theorem integrable_Gf (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Integrable (fun w : Pl => Gf (H : Pl2 → ℂ) ξ w) := by
  have h := (integrable_Gf_pair H ξ).integral_prod_right
  have hfun : (fun w : Pl => ∫ y : Pl, ee (inner ℝ y ξ) * (H : Pl2 → ℂ) (pr y w))
      = fun w : Pl => Gf (H : Pl2 → ℂ) ξ w := by
    funext w
    rw [Gf_eq_integral]
  rw [← hfun]
  exact h

end GfIntegrable


/-! ### `L²` tools -/

section L2Tools

theorem lintegral_enorm_mul_le_sq {u v : Pl → ℂ}
    (hu : AEMeasurable u (volume : Measure Pl)) (hv : AEMeasurable v (volume : Measure Pl)) :
    (∫⁻ x : Pl, ‖u x‖ₑ * ‖v x‖ₑ)
      ≤ (∫⁻ x : Pl, ‖u x‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
        * (∫⁻ x : Pl, ‖v x‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
  have hconj : Real.HolderConjugate 2 2 := by
    rw [Real.holderConjugate_iff] <;> norm_num
  have hh := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl) hconj hu.enorm hv.enorm
  simpa using hh

theorem enorm_integral_mul_le {u v : Pl → ℂ}
    (hu : AEMeasurable u (volume : Measure Pl)) (hv : AEMeasurable v (volume : Measure Pl)) :
    ‖∫ x : Pl, u x * v x‖ₑ
      ≤ (∫⁻ x : Pl, ‖u x‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
        * (∫⁻ x : Pl, ‖v x‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
  refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
  have hpt : ∀ x : Pl, ‖u x * v x‖ₑ = ‖u x‖ₑ * ‖v x‖ₑ := fun x => enorm_mul _ _
  rw [lintegral_congr hpt]
  exact lintegral_enorm_mul_le_sq hu hv

theorem lintegral_comp_neg (h : Pl → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ w : Pl, h (-w)) = ∫⁻ w : Pl, h w := by
  have hmp : MeasurePreserving (fun w : Pl => -w) (volume : Measure Pl) (volume : Measure Pl) :=
    Measure.measurePreserving_neg (volume : Measure Pl)
  exact hmp.lintegral_comp hh

theorem lintegral_enorm_sq_le_of_bound {f : Pl → ℂ} {S : Set Pl} (hS : MeasurableSet S)
    (hf0 : ∀ x, x ∉ S → f x = 0) {M : ℝ} (hM : 0 ≤ M) (hfM : ∀ x, ‖f x‖ ≤ M) :
    (∫⁻ x : Pl, ‖f x‖ₑ ^ (2 : ℝ)) ≤ ENNReal.ofReal (M ^ 2) * volume S := by
  have hpt : ∀ x : Pl, ‖f x‖ₑ ^ (2 : ℝ)
      ≤ S.indicator (fun _ => ENNReal.ofReal (M ^ 2)) x := by
    intro x
    by_cases hx : x ∈ S
    · rw [Set.indicator_of_mem hx]
      have h1 : ‖f x‖ₑ ≤ ENNReal.ofReal M := by
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hfM x)
      have h2 : ‖f x‖ₑ ^ (2 : ℝ) ≤ (ENNReal.ofReal M) ^ (2 : ℝ) :=
        ENNReal.rpow_le_rpow h1 (by norm_num)
      have hMr : M ^ (2 : ℝ) = M ^ 2 := by
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
      have h3 : (ENNReal.ofReal M) ^ (2 : ℝ) = ENNReal.ofReal (M ^ 2) := by
        rw [ENNReal.ofReal_rpow_of_nonneg hM (by norm_num : (0 : ℝ) ≤ (2 : ℝ)), hMr]
      rw [h3] at h2
      exact h2
    · rw [Set.indicator_of_notMem hx, hf0 x hx]
      simp [ENNReal.zero_rpow_of_pos]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_indicator_const hS]

end L2Tools


/-! ### The `L²` norm of the `k`-th term -/

section TermL2

/-- The pointwise bound for the coordinate derivative of the `k`-th separated amplitude. -/
def cBound (j m : ℕ) (B Cs CV : ℝ) (k : ℕ) : ℝ :=
  B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ k
    + B * (k : ℝ) * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ (k - 1) *
      (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))

theorem cBound_nonneg {j m : ℕ} {B Cs CV : ℝ} (hB : 0 ≤ B) (hCs : 0 ≤ Cs) (hCV : 0 ≤ CV)
    (k : ℕ) : 0 ≤ cBound j m B Cs CV k := by
  rw [cBound]
  positivity

theorem norm_cAmpd_le' {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (k : ℕ) (η : Pl) :
    ‖cAmpd j m ε t ξ i b k η‖ ≤ cBound j m B Cs CV k := by
  rw [cBound]
  exact norm_cAmpd_le hB hCs hCVnn hCV hε ht1 ht2 ξ i k η

/-- The `L²` bound for the `k`-th separated amplitude. -/
theorem lintegral_enorm_sq_cAmpd_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (k : ℕ) :
    (∫⁻ η : Pl, ‖cAmpd j m ε t ξ i b k η‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (cBound j m B Cs CV k ^ 2)
        * ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hnn : 0 ≤ cBound j m B Cs CV k := cBound_nonneg hB.nonneg hCsnn hCVnn k
  have hstep := lintegral_enorm_sq_le_of_bound
    (f := cAmpd j m ε t ξ i b k) (S := closure (SuppSet j m ξ))
    isClosed_closure.measurableSet
    (fun x hx => cAmpd_eq_zero_of_notMem j m ε t ξ i hB.supp k hx) hnn
    (fun x => norm_cAmpd_le' hB hCs hCVnn hCV hε ht1 ht2 ξ i k x)
  refine le_trans hstep ?_
  exact mul_le_mul' (le_refl _) (volume_closure_SuppSet_le j m ξ)

theorem fourier_phcA_eq {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) :
    𝓕 (phcA j m ε t ξ i b k)
      = ((𝓕 (phcAS j m ε t ξ i hb hsupp k) : SchwartzMap Pl ℂ) : Pl → ℂ) := by
  rw [SchwartzMap.fourier_coe]
  rfl

theorem measurable_fourier_phcA {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2}
    {b : ℝ → Pl → Pl → ℂ} (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) :
    Measurable (𝓕 (phcA j m ε t ξ i b k)) := by
  rw [fourier_phcA_eq hb hsupp k]
  exact (𝓕 (phcAS j m ε t ξ i hb hsupp k)).continuous.measurable

/-- The `L²` bound in `w` for the reflected Fourier transform of the `k`-th term. -/
theorem lintegral_enorm_sq_fourier_neg_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (k : ℕ) :
    (∫⁻ w : Pl, ‖𝓕 (phcA j m ε t ξ i b k) (-w)‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (cBound j m B Cs CV k ^ 2)
        * ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) := by
  have hmeas : Measurable fun w : Pl => ‖𝓕 (phcA j m ε t ξ i b k) w‖ₑ ^ (2 : ℝ) :=
    ((measurable_fourier_phcA (hB.smooth t ξ) hB.supp k).enorm).pow_const _
  have hneg := lintegral_comp_neg
    (fun w : Pl => ‖𝓕 (phcA j m ε t ξ i b k) w‖ₑ ^ (2 : ℝ)) hmeas
  rw [hneg, lintegral_enorm_sq_fourier_phcA j m ε t ξ i (hB.smooth t ξ) hB.supp k]
  exact lintegral_enorm_sq_cAmpd_le hB hCs hCVnn hCV hε ht1 ht2 ξ i k

end TermL2


/-! ### Summation of the Neumann series -/

section GeomSum

theorem sum_geom_le {r : ℝ} (hr0 : 0 ≤ r) (hr : r < 1) (K : ℕ) :
    ∑ k ∈ Finset.range K, r ^ k ≤ 1 / (1 - r) := by
  have hne : r ≠ 1 := ne_of_lt hr
  have hpos : (0 : ℝ) < 1 - r := by linarith
  have heq : ∑ k ∈ Finset.range K, r ^ k = (1 - r ^ K) / (1 - r) := by
    rw [geom_sum_eq hne K]
    field_simp
    ring
  rw [heq, div_le_div_iff_of_pos_right hpos]
  have hrK : 0 ≤ r ^ K := by positivity
  linarith

theorem pow_div_pow_succ_le {Vb A : ℝ} (hVb : 0 ≤ Vb) (hA : 4 * Vb ≤ A) (hApos : 0 < A) (k : ℕ) :
    Vb ^ k / A ^ (k + 1) ≤ (1 / 4 : ℝ) ^ k / A := by
  have hq : Vb / A ≤ 1 / 4 := by
    rw [div_le_div_iff₀ hApos (by norm_num : (0 : ℝ) < 4)]
    linarith
  have hqnn : 0 ≤ Vb / A := by positivity
  have hpow : (Vb / A) ^ k ≤ (1 / 4 : ℝ) ^ k := pow_le_pow_left₀ hqnn hq k
  have heq : Vb ^ k / A ^ (k + 1) = (Vb / A) ^ k / A := by
    rw [div_pow, pow_succ]
    field_simp
  rw [heq]
  exact div_le_div_of_nonneg_right hpow hApos.le

theorem nat_pow_div_pow_succ_le {Vb A : ℝ} (hVb : 0 ≤ Vb) (hA : 4 * Vb ≤ A) (hApos : 0 < A)
    (k : ℕ) : (k : ℝ) * Vb ^ (k - 1) / A ^ (k + 1) ≤ 4 * (1 / 2 : ℝ) ^ k / A ^ 2 := by
  match k with
  | 0 =>
    simp only [Nat.cast_zero, zero_mul, zero_div]
    positivity
  | (n + 1) =>
    have hq : Vb / A ≤ 1 / 4 := by
      rw [div_le_div_iff₀ hApos (by norm_num : (0 : ℝ) < 4)]
      linarith
    have hqnn : 0 ≤ Vb / A := by positivity
    have hpow : (Vb / A) ^ n ≤ (1 / 4 : ℝ) ^ n := pow_le_pow_left₀ hqnn hq n
    have heq : ((n + 1 : ℕ) : ℝ) * Vb ^ (n + 1 - 1) / A ^ (n + 1 + 1)
        = ((n + 1 : ℕ) : ℝ) * (Vb / A) ^ n / A ^ 2 := by
      have hn : n + 1 - 1 = n := by omega
      rw [hn, div_pow]
      have hApow : A ^ (n + 1 + 1) = A ^ n * A ^ 2 := by ring
      rw [hApow]
      field_simp
    rw [heq]
    have hcast : ((n + 1 : ℕ) : ℝ) ≤ 2 ^ (n + 1) := by
      have h := Nat.lt_two_pow_self (n := n + 1)
      have h2 : ((n + 1 : ℕ) : ℝ) ≤ ((2 ^ (n + 1) : ℕ) : ℝ) := by
        exact_mod_cast le_of_lt h
      simpa using h2
    have hstep : ((n + 1 : ℕ) : ℝ) * (Vb / A) ^ n ≤ 4 * (1 / 2 : ℝ) ^ (n + 1) := by
      have h1 : ((n + 1 : ℕ) : ℝ) * (Vb / A) ^ n
          ≤ (2 : ℝ) ^ (n + 1) * (1 / 4 : ℝ) ^ n := by
        refine mul_le_mul hcast hpow (by positivity) (by positivity)
      refine le_trans h1 (le_of_eq ?_)
      rw [show (1 / 4 : ℝ) = (1 / 2 : ℝ) ^ 2 by norm_num, ← pow_mul,
        show (1 / 2 : ℝ) ^ (n + 1) = (1 / 2 : ℝ) ^ n * (1 / 2 : ℝ) by ring]
      have hid : (2 : ℝ) ^ (n + 1) = 2 ^ n * 2 := by ring
      rw [hid, show 2 * n = n + n by ring, pow_add]
      have hcancel : (2 : ℝ) ^ n * (1 / 2 : ℝ) ^ n = 1 := by
        rw [← mul_pow]
        norm_num
      calc (2 : ℝ) ^ n * 2 * ((1 / 2 : ℝ) ^ n * (1 / 2 : ℝ) ^ n)
          = ((2 : ℝ) ^ n * (1 / 2 : ℝ) ^ n) * (2 * (1 / 2 : ℝ) ^ n) := by ring
        _ = 2 * (1 / 2 : ℝ) ^ n := by rw [hcancel, one_mul]
        _ = 4 * ((1 / 2 : ℝ) ^ n * (1 / 2 : ℝ)) := by ring
    exact div_le_div_of_nonneg_right hstep (by positivity)

/-- The summed Neumann bound. -/
theorem sum_cBound_div_le (j m : ℕ) {B Cs CV : ℝ} (hBnn : 0 ≤ B) (hCsnn : 0 ≤ Cs)
    (hCVnn : 0 ≤ CV) {A : ℝ} (hA : 4 * (2 : ℝ) ^ (11 - (m : ℤ)) ≤ A) (K : ℕ) :
    (∑ k ∈ Finset.range K, cBound j m B Cs CV k / A ^ (k + 1))
      ≤ 2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
        + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2 := by
  set Vb : ℝ := (2 : ℝ) ^ (11 - (m : ℤ)) with hVbdef
  set Bd : ℝ := B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) with hBddef
  set Vd : ℝ := 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) with hVddef
  have hVbpos : (0 : ℝ) < Vb := by rw [hVbdef]; positivity
  have hApos : (0 : ℝ) < A := by nlinarith
  have hBdnn : 0 ≤ Bd := by rw [hBddef]; positivity
  have hVdnn : 0 ≤ Vd := by rw [hVddef]; positivity
  have hterm : ∀ k ∈ Finset.range K, cBound j m B Cs CV k / A ^ (k + 1)
      ≤ Bd * ((1 / 4 : ℝ) ^ k / A) + B * Vd * (4 * (1 / 2 : ℝ) ^ k / A ^ 2) := by
    intro k _
    have h1 : Bd * Vb ^ k / A ^ (k + 1) ≤ Bd * ((1 / 4 : ℝ) ^ k / A) := by
      have h := pow_div_pow_succ_le hVbpos.le hA hApos k
      calc Bd * Vb ^ k / A ^ (k + 1) = Bd * (Vb ^ k / A ^ (k + 1)) := by ring
        _ ≤ Bd * ((1 / 4 : ℝ) ^ k / A) := mul_le_mul_of_nonneg_left h hBdnn
    have h2 : B * (k : ℝ) * Vb ^ (k - 1) * Vd / A ^ (k + 1)
        ≤ B * Vd * (4 * (1 / 2 : ℝ) ^ k / A ^ 2) := by
      have h := nat_pow_div_pow_succ_le hVbpos.le hA hApos k
      calc B * (k : ℝ) * Vb ^ (k - 1) * Vd / A ^ (k + 1)
          = (B * Vd) * ((k : ℝ) * Vb ^ (k - 1) / A ^ (k + 1)) := by ring
        _ ≤ (B * Vd) * (4 * (1 / 2 : ℝ) ^ k / A ^ 2) :=
            mul_le_mul_of_nonneg_left h (by positivity)
    have hsplit : cBound j m B Cs CV k / A ^ (k + 1)
        = Bd * Vb ^ k / A ^ (k + 1) + B * (k : ℝ) * Vb ^ (k - 1) * Vd / A ^ (k + 1) := by
      rw [cBound, hVbdef, hBddef, hVddef]
      ring
    rw [hsplit]
    linarith
  refine le_trans (Finset.sum_le_sum hterm) ?_
  have hs1 : (∑ k ∈ Finset.range K, Bd * ((1 / 4 : ℝ) ^ k / A))
      = (Bd / A) * ∑ k ∈ Finset.range K, (1 / 4 : ℝ) ^ k := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  have hs2 : (∑ k ∈ Finset.range K, B * Vd * (4 * (1 / 2 : ℝ) ^ k / A ^ 2))
      = (4 * B * Vd / A ^ 2) * ∑ k ∈ Finset.range K, (1 / 2 : ℝ) ^ k := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [Finset.sum_add_distrib, hs1, hs2]
  have hg1 : (∑ k ∈ Finset.range K, (1 / 4 : ℝ) ^ k) ≤ 4 / 3 := by
    have h := sum_geom_le (r := (1 / 4 : ℝ)) (by norm_num) (by norm_num) K
    calc (∑ k ∈ Finset.range K, (1 / 4 : ℝ) ^ k) ≤ 1 / (1 - 1 / 4 : ℝ) := h
      _ = 4 / 3 := by norm_num
  have hg2 : (∑ k ∈ Finset.range K, (1 / 2 : ℝ) ^ k) ≤ 2 := by
    have h := sum_geom_le (r := (1 / 2 : ℝ)) (by norm_num) (by norm_num) K
    calc (∑ k ∈ Finset.range K, (1 / 2 : ℝ) ^ k) ≤ 1 / (1 - 1 / 2 : ℝ) := h
      _ = 2 := by norm_num
  have hc1 : (Bd / A) * ∑ k ∈ Finset.range K, (1 / 4 : ℝ) ^ k ≤ (Bd / A) * (4 / 3) :=
    mul_le_mul_of_nonneg_left hg1 (by positivity)
  have hc2 : (4 * B * Vd / A ^ 2) * ∑ k ∈ Finset.range K, (1 / 2 : ℝ) ^ k
      ≤ (4 * B * Vd / A ^ 2) * 2 :=
    mul_le_mul_of_nonneg_left hg2 (by positivity)
  have hfin1 : (Bd / A) * (4 / 3) ≤ 2 * Bd / A := by
    rw [← sub_nonneg]
    have hid : 2 * Bd / A - Bd / A * (4 / 3) = (2 / 3) * Bd / A := by
      field_simp
      ring
    rw [hid]
    positivity
  have hfin2 : (4 * B * Vd / A ^ 2) * 2 = 8 * (B * Vd) / A ^ 2 := by ring
  rw [hfin2] at hc2
  linarith

end GeomSum


/-! ### The remainder amplitude -/

section RemBound

/-- The derivative of `Psi` in the direction `u`. -/
theorem fderiv_Psi_apply (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2) (w η u : Pl) :
    fderiv ℝ (Psi j m ε t ξ i w) η u = ε * t * fderiv ℝ (Vhat j m ξ i) η u := by
  have hL : HasDerivAt (fun r : ℝ => Psi j m ε t ξ i w (η + r • u))
      (fderiv ℝ (Psi j m ε t ξ i w) η u) 0 :=
    hasDerivAt_line (contDiff_Psi j m ε t ξ i w) η u
  have hVhat : HasDerivAt (fun r : ℝ => Vhat j m ξ i (η + r • u))
      (fderiv ℝ (Vhat j m ξ i) η u) 0 := hasDerivAt_line (contDiff_Vhat j m ξ i) η u
  have hR : HasDerivAt (fun r : ℝ => Psi j m ε t ξ i w (η + r • u))
      (ε * t * fderiv ℝ (Vhat j m ξ i) η u) 0 := by
    have h := (hVhat.const_mul (ε * t)).const_add (w i)
    have hfun : (fun r : ℝ => w i + ε * t * Vhat j m ξ i (η + r • u))
        = fun r : ℝ => Psi j m ε t ξ i w (η + r • u) := by
      funext r
      rw [Psi]
    rw [hfun] at h
    exact h
  exact hL.unique hR

theorem abs_fderiv_Psi_le {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {j m : ℕ} {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (ξ : Pl) (i : Fin 2) (w η : Pl) {u : Pl} (hu : ‖u‖ = 1) :
    |fderiv ℝ (Psi j m ε t ξ i w) η u| ≤ 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) := by
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_pos (by linarith)]
    exact ht2
  rw [fderiv_Psi_apply, abs_mul]
  exact mul_le_mul hεt (abs_fderiv_Vhat_le hCs hCVnn hCV j m ξ i η hu) (abs_nonneg _)
    (by norm_num)

theorem norm_cAmp_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (k : ℕ)
    (η : Pl) : ‖cAmp j m ε t ξ i b k η‖ ≤ B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ k := by
  rw [cAmp_eq_Vc, norm_mul, norm_pow]
  refine mul_le_mul (hB.bd0 t ξ η) ?_ (by positivity) hB.nonneg
  exact pow_le_pow_left₀ (norm_nonneg _) (norm_Vc_le hε ht1 ht2 ξ i η) k

/-- The derivative of the remainder amplitude. -/
theorem rAmpd_eq {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (K : ℕ) {w : Pl} (hw : w i ≠ 0)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) (η : Pl) :
    rAmpd j m ε t ξ i b K w η
      = (((w i : ℝ) : ℂ) ^ K)⁻¹ *
        (cAmpd j m ε t ξ i b K η * (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)
          + cAmp j m ε t ξ i b K η *
            ((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
              / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)) := by
  have hL : HasDerivAt (fun r : ℝ => rAmp j m ε t ξ i b K w (η + r • ev i))
      (rAmpd j m ε t ξ i b K w η) 0 :=
    hasDerivAt_line (contDiff_rAmp hb K hw hPsi) η (ev i)
  have hcA : HasDerivAt (fun r : ℝ => cAmp j m ε t ξ i b K (η + r • ev i))
      (cAmpd j m ε t ξ i b K η) 0 := hasDerivAt_line (contDiff_cAmp hb ε i K) η (ev i)
  have hPl : HasDerivAt (fun r : ℝ => Psi j m ε t ξ i w (η + r • ev i))
      (fderiv ℝ (Psi j m ε t ξ i w) η (ev i)) 0 :=
    hasDerivAt_line (contDiff_Psi j m ε t ξ i w) η (ev i)
  have hinvR : HasDerivAt (fun r : ℝ => (Psi j m ε t ξ i w (η + r • ev i))⁻¹)
      (-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i)) / (Psi j m ε t ξ i w η) ^ 2) 0 := by
    have h := hPl.fun_inv (by simpa using hPsi η)
    simpa using h
  have hinvC : HasDerivAt (fun r : ℝ => (((Psi j m ε t ξ i w (η + r • ev i))⁻¹ : ℝ) : ℂ))
      (((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
        / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)) 0 :=
    hinvR.ofReal_comp
  have hprod := (hcA.fun_mul hinvC).const_mul ((((w i : ℝ) : ℂ) ^ K)⁻¹)
  simp only [zero_smul, add_zero] at hprod
  have hfun : (fun r : ℝ => (((w i : ℝ) : ℂ) ^ K)⁻¹ *
        (cAmp j m ε t ξ i b K (η + r • ev i) *
          (((Psi j m ε t ξ i w (η + r • ev i))⁻¹ : ℝ) : ℂ)))
      = fun r : ℝ => rAmp j m ε t ξ i b K w (η + r • ev i) := by
    funext r
    rw [rAmp, div_eq_mul_inv, mul_inv, Complex.ofReal_inv]
    ring
  rw [hfun] at hprod
  exact hL.unique hprod

end RemBound


/-! ### The bound for the remainder amplitude -/

section RemNorm

/-- The pointwise bound for the coordinate derivative of the remainder amplitude. -/
theorem norm_rAmpd_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (K : ℕ)
    {w : Pl} (hw13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i|) (η : Pl) :
    ‖rAmpd j m ε t ξ i b K w η‖
      ≤ (2 * cBound j m B Cs CV K / |w i|
          + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
            (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2)
        / |w i| ^ K := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hwpos : (0 : ℝ) < |w i| := lt_of_lt_of_le (by positivity) hw13
  have hwne : w i ≠ 0 := w_coord_ne_zero hw13
  have hPsi : ∀ z : Pl, Psi j m ε t ξ i w z ≠ 0 := Psi_ne_zero hε ht1 ht2 ξ i hw13
  have hPlow : |w i| / 2 ≤ |Psi j m ε t ξ i w η| := abs_Psi_lower j m hε ht1 ht2 ξ i hw13 η
  have hPpos : (0 : ℝ) < |Psi j m ε t ξ i w η| := by
    have : (0 : ℝ) < |w i| / 2 := by linarith
    linarith
  rw [rAmpd_eq (hB.smooth t ξ) K hwne hPsi η, norm_mul]
  -- the constant factor
  have hconst : ‖(((w i : ℝ) : ℂ) ^ K)⁻¹‖ = 1 / |w i| ^ K := by
    rw [norm_inv, norm_pow, Complex.norm_real, Real.norm_eq_abs, one_div]
  -- the two terms
  have hinvbd : ‖(((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)‖ ≤ 2 / |w i| := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_inv, inv_eq_one_div,
      div_le_div_iff₀ hPpos hwpos]
    linarith
  have hPd := abs_fderiv_Psi_le hCs hCVnn hCV (j := j) (m := m) hε ht1 ht2 ξ i w η (norm_ev i)
  have hsecbd : ‖((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
      / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)‖
      ≤ 4 * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_div, abs_neg, abs_pow]
    have hsq : |w i| ^ 2 / 4 ≤ |Psi j m ε t ξ i w η| ^ 2 := by
      nlinarith [hPlow, hPpos, hwpos]
    have hnum : |fderiv ℝ (Psi j m ε t ξ i w) η (ev i)|
        ≤ 2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))) := hPd
    have hden : (0 : ℝ) < |Psi j m ε t ξ i w η| ^ 2 := by positivity
    rw [div_le_div_iff₀ hden (by positivity : (0 : ℝ) < |w i| ^ 2)]
    nlinarith [hsq, hnum, hden, abs_nonneg (fderiv ℝ (Psi j m ε t ξ i w) η (ev i))]
  have hcAd : ‖cAmpd j m ε t ξ i b K η‖ ≤ cBound j m B Cs CV K :=
    norm_cAmpd_le' hB hCs hCVnn hCV hε ht1 ht2 ξ i K η
  have hcA : ‖cAmp j m ε t ξ i b K η‖ ≤ B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K :=
    norm_cAmp_le hB hε ht1 ht2 ξ i K η
  have hcBnn : 0 ≤ cBound j m B Cs CV K := cBound_nonneg hB.nonneg hCsnn hCVnn K
  have hsum : ‖cAmpd j m ε t ξ i b K η * (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)
        + cAmp j m ε t ξ i b K η * ((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
          / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)‖
      ≤ 2 * cBound j m B Cs CV K / |w i|
        + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
          (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2 := by
    refine le_trans (norm_add_le _ _) ?_
    have h1 : ‖cAmpd j m ε t ξ i b K η * (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)‖
        ≤ 2 * cBound j m B Cs CV K / |w i| := by
      rw [norm_mul]
      have := mul_le_mul hcAd hinvbd (norm_nonneg _) hcBnn
      calc ‖cAmpd j m ε t ξ i b K η‖ * ‖(((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)‖
          ≤ cBound j m B Cs CV K * (2 / |w i|) := this
        _ = 2 * cBound j m B Cs CV K / |w i| := by ring
    have h2 : ‖cAmp j m ε t ξ i b K η * ((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
          / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)‖
        ≤ 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
          (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2 := by
      rw [norm_mul]
      have hBVnn : (0 : ℝ) ≤ B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K := by
        have := hB.nonneg
        positivity
      have := mul_le_mul hcA hsecbd (norm_nonneg _) hBVnn
      calc ‖cAmp j m ε t ξ i b K η‖ * ‖((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
              / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)‖
          ≤ (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
            (4 * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2) := this
        _ = 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
            (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2 := by ring
    linarith
  rw [hconst]
  have hnn : (0 : ℝ) ≤ 2 * cBound j m B Cs CV K / |w i|
      + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
        (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2 := by
    have := hB.nonneg
    positivity
  calc (1 / |w i| ^ K) * ‖cAmpd j m ε t ξ i b K η * (((Psi j m ε t ξ i w η)⁻¹ : ℝ) : ℂ)
        + cAmp j m ε t ξ i b K η * ((-(fderiv ℝ (Psi j m ε t ξ i w) η (ev i))
          / (Psi j m ε t ξ i w η) ^ 2 : ℝ) : ℂ)‖
      ≤ (1 / |w i| ^ K) * (2 * cBound j m B Cs CV K / |w i|
          + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
            (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2) :=
        mul_le_mul_of_nonneg_left hsum (by positivity)
    _ = (2 * cBound j m B Cs CV K / |w i|
          + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
            (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / |w i| ^ 2)
        / |w i| ^ K := by ring

end RemNorm


/-! ### The `w`-representation of `S[F,b]` -/

section WRepresentation

theorem continuous_Gf_pair' (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Continuous fun q : Pl × Pl => ee (inner ℝ q.2 ξ) * (H : Pl2 → ℂ) (pr q.2 q.1) := by
  have h1 : Continuous fun q : Pl × Pl => ee (inner ℝ q.2 ξ) :=
    continuous_ee.comp (continuous_snd.inner continuous_const)
  have h2 : Continuous fun q : Pl × Pl => (H : Pl2 → ℂ) (pr q.2 q.1) :=
    H.continuous.comp (continuous_prPair.comp (continuous_snd.prodMk continuous_fst))
  exact h1.mul h2

theorem stronglyMeasurable_Gf (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    StronglyMeasurable fun w : Pl => Gf (H : Pl2 → ℂ) ξ w := by
  have h := (continuous_Gf_pair' H ξ).stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure Pl))
  have hfun : (fun w : Pl => ∫ y : Pl, ee (inner ℝ y ξ) * (H : Pl2 → ℂ) (pr y w))
      = fun w : Pl => Gf (H : Pl2 → ℂ) ξ w := by
    funext w
    rw [Gf_eq_integral]
  rw [← hfun]
  exact h

theorem measurable_Gf (H : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Measurable fun w : Pl => Gf (H : Pl2 → ℂ) ξ w :=
  (stronglyMeasurable_Gf H ξ).measurable

/-- The Fourier transform of `F` at `(ξ-η, η)` as an integral in `w`. -/
theorem fourier_F_eq_integral_w (F : SchwartzMap Pl2 ℂ) (ξ η : Pl) :
    𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η)
      = ∫ w : Pl, ee (-(inner ℝ w η : ℝ)) * Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w := by
  rw [fourier_shear_eq F ξ η, fourier_pr_eq (shearSchwartz F) ξ (-η), fourier_eq_ee_Pl]
  refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
  show ee (inner ℝ w (-η)) * Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w
      = ee (-(inner ℝ w η : ℝ)) * Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w
  congr 2
  rw [inner_neg_right]

end WRepresentation


/-! ### Fubini: the `w`-representation -/

section Fubini44

theorem volume_SuppSet_lt_top (j m : ℕ) (ξ : Pl) : volume (SuppSet j m ξ) < ⊤ :=
  lt_of_le_of_lt (volume_SuppSet_le j m ξ) ENNReal.ofReal_lt_top

theorem integrable_indicator_SuppSet (j m : ℕ) (ξ : Pl) (B : ℝ) :
    Integrable (fun η : Pl => B * Set.indicator (SuppSet j m ξ) (fun _ => (1 : ℝ)) η) := by
  refine Integrable.const_mul ?_ B
  rw [integrable_indicator_iff (measurableSet_SuppSet j m ξ)]
  exact integrableOn_const (C := (1 : ℝ)) (hs := (volume_SuppSet_lt_top j m ξ).ne)

/-- The `w`-representation of `S[F,b]`. -/
theorem Sop_eq_integral_w {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    (ε t : ℝ) (ξ : Pl) (F : SchwartzMap Pl2 ℂ) :
    Sop ε b (F : Pl2 → ℂ) ξ t
      = ∫ w : Pl, Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w *
          (∫ η : Pl, oscph j ε t ξ w η * b t ξ η) := by
  set H : SchwartzMap Pl2 ℂ := shearSchwartz F with hH
  set g : Pl → ℂ := fun w => Gf ((H : Pl2 → ℂ)) ξ w with hg
  have hgmeas : Measurable g := measurable_Gf H ξ
  have hgint : Integrable g := integrable_Gf H ξ
  -- the doubly indexed integrand
  set Φ : Pl → Pl → ℂ := fun η w =>
    phase ε t ξ η * b t ξ η * (ee (-(inner ℝ w η : ℝ)) * g w) with hΦ
  have hbc : Continuous (b t ξ) := (hB.smooth t ξ).continuous
  have hcont : Continuous fun p : Pl × Pl =>
      phase ε t ξ p.1 * b t ξ p.1 * ee (-(inner ℝ p.2 p.1 : ℝ)) := by
    have h1 : Continuous fun p : Pl × Pl => phase ε t ξ p.1 := by
      refine Complex.continuous_exp.comp ?_
      refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
      exact continuous_const.mul ((continuous_const.sub continuous_fst).norm.add
        continuous_fst.norm)
    have h2 : Continuous fun p : Pl × Pl => b t ξ p.1 := hbc.comp continuous_fst
    have h3 : Continuous fun p : Pl × Pl => ee (-(inner ℝ p.2 p.1 : ℝ)) :=
      continuous_ee.comp (continuous_snd.inner continuous_fst).neg
    exact (h1.mul h2).mul h3
  have hmeasΦ : AEStronglyMeasurable (fun p : Pl × Pl => Φ p.1 p.2)
      (volume : Measure (Pl × Pl)) := by
    have hsnd : StronglyMeasurable fun p : Pl × Pl => g p.2 :=
      (hgmeas.comp measurable_snd).stronglyMeasurable
    have hfun : (fun p : Pl × Pl => Φ p.1 p.2)
        = fun p : Pl × Pl => (phase ε t ξ p.1 * b t ξ p.1 * ee (-(inner ℝ p.2 p.1 : ℝ)))
          * g p.2 := by
      funext p
      show phase ε t ξ p.1 * b t ξ p.1 * (ee (-(inner ℝ p.2 p.1 : ℝ)) * g p.2)
          = (phase ε t ξ p.1 * b t ξ p.1 * ee (-(inner ℝ p.2 p.1 : ℝ))) * g p.2
      ring
    rw [hfun]
    exact (hcont.stronglyMeasurable.mul hsnd).aestronglyMeasurable
  have hdom : Integrable (fun p : Pl × Pl =>
      (B * Set.indicator (SuppSet j m ξ) (fun _ => (1 : ℝ)) p.1) * ‖g p.2‖)
      (volume : Measure (Pl × Pl)) :=
    (integrable_indicator_SuppSet j m ξ B).mul_prod hgint.norm
  have hbound : ∀ p : Pl × Pl, ‖Φ p.1 p.2‖
      ≤ (B * Set.indicator (SuppSet j m ξ) (fun _ => (1 : ℝ)) p.1) * ‖g p.2‖ := by
    intro p
    show ‖phase ε t ξ p.1 * b t ξ p.1 * (ee (-(inner ℝ p.2 p.1 : ℝ)) * g p.2)‖
        ≤ (B * Set.indicator (SuppSet j m ξ) (fun _ => (1 : ℝ)) p.1) * ‖g p.2‖
    by_cases hmem : p.1 ∈ SuppSet j m ξ
    · rw [Set.indicator_of_mem hmem, mul_one]
      rw [norm_mul, norm_mul, norm_mul, norm_phase, one_mul, norm_ee, one_mul]
      exact mul_le_mul_of_nonneg_right (hB.bd0 t ξ p.1) (norm_nonneg _)
    · rw [Set.indicator_of_notMem hmem, hB.supp t ξ p.1 hmem]
      simp
  have hintΦ : Integrable (fun p : Pl × Pl => Φ p.1 p.2) (volume : Measure (Pl × Pl)) :=
    Integrable.mono' hdom hmeasΦ (Filter.Eventually.of_forall hbound)
  -- step 1: rewrite the Fourier transform
  have hstep1 : Sop ε b (F : Pl2 → ℂ) ξ t = ∫ η : Pl, ∫ w : Pl, Φ η w := by
    rw [Sop, SopK]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show phase ε t ξ η * b t ξ η * 𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η) = ∫ w : Pl, Φ η w
    have hΦint : (∫ w : Pl, Φ η w)
        = ∫ w : Pl, phase ε t ξ η * b t ξ η * (ee (-(inner ℝ w η : ℝ)) * g w) := rfl
    rw [fourier_F_eq_integral_w F ξ η, hΦint, integral_const_mul]
  -- step 2: Fubini
  have hstep2 : (∫ η : Pl, ∫ w : Pl, Φ η w) = ∫ w : Pl, ∫ η : Pl, Φ η w :=
    integral_integral_swap hintΦ
  -- step 3: identify the inner integral
  have hstep3 : ∀ w : Pl, (∫ η : Pl, Φ η w)
      = g w * ∫ η : Pl, oscph j ε t ξ w η * b t ξ η := by
    intro w
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show phase ε t ξ η * b t ξ η * (ee (-(inner ℝ w η : ℝ)) * g w)
        = g w * (oscph j ε t ξ w η * b t ξ η)
    have h := phase_mul_b_eq (j := j) hB.supp ε t ξ w η
    calc phase ε t ξ η * b t ξ η * (ee (-(inner ℝ w η : ℝ)) * g w)
        = (phase ε t ξ η * b t ξ η * ee (-(inner ℝ w η : ℝ))) * g w := by ring
      _ = (oscph j ε t ξ w η * b t ξ η) * g w := by rw [h]
      _ = g w * (oscph j ε t ξ w η * b t ξ η) := by ring
  rw [hstep1, hstep2, integral_congr_ae (Filter.Eventually.of_forall hstep3)]

end Fubini44


/-! ### The decomposed inner integral -/

section InnerDecomp

theorem rAmp_eq_zero_of_notMem (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (K : ℕ)
    (w : Pl) {η : Pl} (h : η ∉ SuppSet j m ξ) : rAmp j m ε t ξ i b K w η = 0 := by
  rw [rAmp, cAmp_eq_zero_of_notMem j m ε t ξ i hsupp K h, zero_div]

theorem rAmpd_eq_zero_of_notMem (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (K : ℕ)
    (w : Pl) {η : Pl} (h : η ∉ closure (SuppSet j m ξ)) :
    rAmpd j m ε t ξ i b K w η = 0 := by
  have hev : (fun z : Pl => rAmp j m ε t ξ i b K w z) =ᶠ[nhds η] fun _ : Pl => (0 : ℂ) := by
    filter_upwards [isClosed_closure.isOpen_compl.mem_nhds h] with x hx
    exact rAmp_eq_zero_of_notMem j m ε t ξ i hsupp K w fun hmem => hx (subset_closure hmem)
  rw [rAmpd, hev.fderiv_eq]
  simp

theorem continuous_rAmpd {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ)) (K : ℕ) {w : Pl} (hw : w i ≠ 0)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    Continuous fun η : Pl => rAmpd j m ε t ξ i b K w η :=
  continuous_fderiv_dir (contDiff_rAmp hb K hw hPsi) (ev i)

theorem hasCompactSupport_rAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (K : ℕ)
    (w : Pl) : HasCompactSupport fun η : Pl => rAmpd j m ε t ξ i b K w η := by
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  exact rAmpd_eq_zero_of_notMem j m ε t ξ i hsupp K w
    fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)

theorem integrable_oscph_mul_cAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (k : ℕ) (w : Pl) :
    Integrable fun η : Pl => oscph j ε t ξ w η * cAmpd j m ε t ξ i b k η := by
  refine Continuous.integrable_of_hasCompactSupport
    ((continuous_oscph j ε t ξ w).mul (contDiff_cAmpd j m ε t ξ i hb k).continuous) ?_
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  have h := cAmpd_eq_zero_of_notMem j m ε t ξ i hsupp k
    (η := η) fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)
  rw [h, mul_zero]

theorem integrable_oscph_mul_rAmpd (j m : ℕ) (ε t : ℝ) (ξ : Pl) (i : Fin 2)
    {b : ℝ → Pl → Pl → ℂ} (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (K : ℕ) {w : Pl} (hw : w i ≠ 0)
    (hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0) :
    Integrable fun η : Pl => oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η := by
  refine Continuous.integrable_of_hasCompactSupport
    ((continuous_oscph j ε t ξ w).mul (continuous_rAmpd hb K hw hPsi)) ?_
  refine HasCompactSupport.intro
    (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))) fun η hη => ?_
  have h := rAmpd_eq_zero_of_notMem j m ε t ξ i hsupp K w
    (η := η) fun hmem => hη (closure_SuppSet_subset_ball j m ξ hmem)
  rw [h, mul_zero]

/-- The inner integral after one integration by parts and the Neumann expansion. -/
theorem integral_oscph_mul_b_eq {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B) {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    {ξ : Pl} (hξ : XiData j ξ) (i : Fin 2) (K : ℕ)
    {w : Pl} (hw : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i|) :
    (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)
      = -(1 / ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I)) *
        ((∑ k ∈ Finset.range K,
            (𝓕 (phcA j m ε t ξ i b k) (-w)) / ((w i : ℝ) : ℂ) ^ (k + 1))
          + ∫ η : Pl, oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η) := by
  have hwne : w i ≠ 0 := w_coord_ne_zero hw
  have hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0 := Psi_ne_zero hε ht1 ht2 ξ i hw
  have hibp := ibp44 hξ (hB.smooth t ξ) (hB.supp t ξ) w hPsi
  rw [hibp]
  congr 1
  -- decompose the integral
  have hpt : ∀ η : Pl, oscph j ε t ξ w η * Ampd j m ε t ξ i b w (ev i) η
      = (∑ k ∈ Finset.range K, oscph j ε t ξ w η * cAmpd j m ε t ξ i b k η
            / ((w i : ℝ) : ℂ) ^ (k + 1))
        + oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η := by
    intro η
    rw [Ampd_decomp (hB.smooth t ξ) K hwne hPsi η, mul_add, Finset.mul_sum]
    congr 1
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  have hsumint : ∀ k ∈ Finset.range K, Integrable fun η : Pl =>
      oscph j ε t ξ w η * cAmpd j m ε t ξ i b k η / ((w i : ℝ) : ℂ) ^ (k + 1) := by
    intro k _
    exact (integrable_oscph_mul_cAmpd j m ε t ξ i (hB.smooth t ξ) hB.supp k w).div_const _
  have hremint : Integrable fun η : Pl =>
      oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η :=
    integrable_oscph_mul_rAmpd j m ε t ξ i (hB.smooth t ξ) hB.supp K hwne hPsi
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
    integral_add (integrable_finset_sum _ hsumint) hremint,
    integral_finset_sum _ hsumint]
  congr 1
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [integral_div, integral_oscph_mul_cAmpd]

end InnerDecomp


/-! ### Cauchy--Schwarz for one Neumann term -/

section TermCS

theorem lintegral_term_le (i : Fin 2) (k : ℕ) {A : ℝ} (hApos : 0 < A)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgisupp : ∀ w : Pl, gi w ≠ 0 → A ≤ |w i|)
    {G : Pl → ℂ} (hG : Measurable G) :
    (∫⁻ w : Pl, ‖gi w * (G (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))‖ₑ)
      ≤ ENNReal.ofReal (1 / A ^ (k + 1))
        * ((∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
          * (∫⁻ w : Pl, ‖G (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)) := by
  have hGneg : Measurable fun w : Pl => G (-w) := hG.comp measurable_neg
  have hpt : ∀ w : Pl, ‖gi w * (G (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))‖ₑ
      ≤ ENNReal.ofReal (1 / A ^ (k + 1)) * (‖gi w‖ₑ * ‖G (-w)‖ₑ) := by
    intro w
    by_cases hz : gi w = 0
    · rw [hz]
      simp
    · have hA := hgisupp w hz
      have hwpos : (0 : ℝ) < |w i| := lt_of_lt_of_le hApos hA
      have hApow : A ^ (k + 1) ≤ |w i| ^ (k + 1) := pow_le_pow_left₀ hApos.le hA _
      have hApowpos : (0 : ℝ) < A ^ (k + 1) := by positivity
      have hcoef : ‖(((w i : ℝ) : ℂ) ^ (k + 1))⁻¹‖ ≤ 1 / A ^ (k + 1) := by
        rw [norm_inv, norm_pow, Complex.norm_real, Real.norm_eq_abs]
        rw [inv_eq_one_div, div_le_div_iff₀ (by positivity) hApowpos]
        linarith
      have heq : gi w * (G (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))
          = (((w i : ℝ) : ℂ) ^ (k + 1))⁻¹ * (gi w * G (-w)) := by
        rw [div_eq_mul_inv]
        ring
      rw [heq, enorm_mul, enorm_mul]
      refine mul_le_mul' ?_ (le_refl _)
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal hcoef
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_const_mul' _ _ (by simp)]
  refine mul_le_mul' (le_refl _) ?_
  exact lintegral_enorm_mul_le_sq hgi hGneg.aemeasurable

theorem enorm_integral_term_le (i : Fin 2) (k : ℕ) {A : ℝ} (hApos : 0 < A)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgisupp : ∀ w : Pl, gi w ≠ 0 → A ≤ |w i|)
    {G : Pl → ℂ} (hG : Measurable G) :
    ‖∫ w : Pl, gi w * (G (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))‖ₑ
      ≤ ENNReal.ofReal (1 / A ^ (k + 1))
        * ((∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
          * (∫⁻ w : Pl, ‖G (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)) :=
  le_trans (enorm_integral_le_lintegral_enorm _) (lintegral_term_le i k hApos hgi hgisupp hG)

/-- Cauchy--Schwarz for the remainder term. -/
theorem lintegral_rem_le {S : Set Pl} (hS : MeasurableSet S)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgisupp : ∀ w : Pl, gi w ≠ 0 → w ∈ S)
    {R : Pl → ℂ} {M : ℝ} (hM : 0 ≤ M)
    (hRM : ∀ w : Pl, w ∈ S → ‖R w‖ ≤ M) :
    (∫⁻ w : Pl, ‖gi w * R w‖ₑ)
      ≤ ENNReal.ofReal M * ((volume S) ^ (2⁻¹ : ℝ)
        * (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)) := by
  have hpt : ∀ w : Pl, ‖gi w * R w‖ₑ
      ≤ ENNReal.ofReal M * (S.indicator (fun _ => (1 : ℝ≥0∞)) w * ‖gi w‖ₑ) := by
    intro w
    by_cases hz : gi w = 0
    · rw [hz]
      simp
    · have hmem := hgisupp w hz
      rw [Set.indicator_of_mem hmem, one_mul, enorm_mul,
        mul_comm (ENNReal.ofReal M) (‖gi w‖ₑ)]
      refine mul_le_mul' (le_refl _) ?_
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hRM w hmem)
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_const_mul' _ _ (by simp)]
  refine mul_le_mul' (le_refl _) ?_
  exact Auto.CalderonVaillancourt.lintegral_indicator_enorm_le hS hgi

theorem enorm_integral_rem_le {S : Set Pl} (hS : MeasurableSet S)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgisupp : ∀ w : Pl, gi w ≠ 0 → w ∈ S)
    {R : Pl → ℂ} {M : ℝ} (hM : 0 ≤ M)
    (hRM : ∀ w : Pl, w ∈ S → ‖R w‖ ≤ M) :
    ‖∫ w : Pl, gi w * R w‖ₑ
      ≤ ENNReal.ofReal M * ((volume S) ^ (2⁻¹ : ℝ)
        * (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)) :=
  le_trans (enorm_integral_le_lintegral_enorm _) (lintegral_rem_le hS hgi hgisupp hM hRM)

end TermCS


/-! ### Summing the Neumann terms -/

section SumTerms

theorem lintegral_sum_terms_le (i : Fin 2) (K : ℕ) {A : ℝ} (hApos : 0 < A)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgisupp : ∀ w : Pl, gi w ≠ 0 → A ≤ |w i|)
    (G : ℕ → Pl → ℂ) (hG : ∀ k, Measurable (G k)) :
    (∫⁻ w : Pl, ‖gi w * ∑ k ∈ Finset.range K,
        G k (-w) / ((w i : ℝ) : ℂ) ^ (k + 1)‖ₑ)
      ≤ ∑ k ∈ Finset.range K, ENNReal.ofReal (1 / A ^ (k + 1))
          * ((∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
            * (∫⁻ w : Pl, ‖G k (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)) := by
  have hpt : ∀ w : Pl, ‖gi w * ∑ k ∈ Finset.range K,
      G k (-w) / ((w i : ℝ) : ℂ) ^ (k + 1)‖ₑ
      ≤ ∑ k ∈ Finset.range K, ‖gi w * (G k (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))‖ₑ := by
    intro w
    rw [Finset.mul_sum]
    exact enorm_sum_le _ _
  refine le_trans (lintegral_mono hpt) ?_
  have hmeas : ∀ k ∈ Finset.range K, AEMeasurable
      (fun w : Pl => ‖gi w * (G k (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))‖ₑ)
      (volume : Measure Pl) := by
    intro k _
    have h1 : AEMeasurable (fun w : Pl => G k (-w)) (volume : Measure Pl) :=
      ((hG k).comp measurable_neg).aemeasurable
    have h2 : AEMeasurable (fun w : Pl => ((w i : ℝ) : ℂ) ^ (k + 1))
        (volume : Measure Pl) := by
      refine AEMeasurable.pow_const ?_ _
      exact (Complex.measurable_ofReal.comp (EuclideanSpace.proj i).continuous.measurable
        ).aemeasurable
    exact (hgi.mul (h1.div h2)).enorm
  rw [lintegral_finset_sum' _ hmeas]
  refine Finset.sum_le_sum fun k _ => ?_
  exact lintegral_term_le i k hApos hgi hgisupp (hG k)

end SumTerms


/-! ### The main terms -/

section MainTerms

theorem rpow_half_eq_sqrt {y : ℝ} (hy : 0 ≤ y) : y ^ (2⁻¹ : ℝ) = Real.sqrt y := by
  rw [Real.sqrt_eq_rpow]
  norm_num

theorem enorm_sq_root_bound {x v : ℝ} (hx : 0 ≤ x) (hv : 0 ≤ v) :
    (ENNReal.ofReal (x ^ 2) * ENNReal.ofReal v) ^ (2⁻¹ : ℝ)
      = ENNReal.ofReal (x * Real.sqrt v) := by
  rw [← ENNReal.ofReal_mul (by positivity),
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  congr 1
  rw [rpow_half_eq_sqrt (by positivity), Real.sqrt_mul (by positivity), Real.sqrt_sq hx]

/-- The bound for the sum of the main Neumann terms. -/
theorem enorm_main_terms_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (K : ℕ)
    {A : ℝ} (hA4 : 4 * (2 : ℝ) ^ (11 - (m : ℤ)) ≤ A)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgiA : ∀ w : Pl, gi w ≠ 0 → A ≤ |w i|) :
    (∫⁻ w : Pl, ‖gi w * ∑ k ∈ Finset.range K,
        𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1)‖ₑ)
      ≤ ENNReal.ofReal (Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
            + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2))
        * (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hVbpos : (0 : ℝ) < (2 : ℝ) ^ (11 - (m : ℤ)) := by positivity
  have hApos : (0 : ℝ) < A := by nlinarith
  set Ng : ℝ≥0∞ := (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) with hNg
  set vol : ℝ := (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) with hvol
  have hvolnn : (0 : ℝ) ≤ vol := by rw [hvol]; positivity
  -- step 1: the general summation bound
  have hstep1 := lintegral_sum_terms_le i K hApos hgi hgiA
    (fun k => 𝓕 (phcA j m ε t ξ i b k))
    (fun k => measurable_fourier_phcA (hB.smooth t ξ) hB.supp k)
  -- step 2: bound each factor
  have hterm : ∀ k ∈ Finset.range K,
      ENNReal.ofReal (1 / A ^ (k + 1))
          * (Ng * (∫⁻ w : Pl, ‖𝓕 (phcA j m ε t ξ i b k) (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ))
        ≤ ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol / A ^ (k + 1)) * Ng := by
    intro k _
    have hcnn : 0 ≤ cBound j m B Cs CV k := cBound_nonneg hB.nonneg hCsnn hCVnn k
    have hNk : (∫⁻ w : Pl, ‖𝓕 (phcA j m ε t ξ i b k) (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
        ≤ ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol) := by
      have h := lintegral_enorm_sq_fourier_neg_le hB hCs hCVnn hCV hε ht1 ht2 ξ i k
      have h2 := ENNReal.rpow_le_rpow h (by norm_num : (0 : ℝ) ≤ (2⁻¹ : ℝ))
      rw [enorm_sq_root_bound hcnn hvolnn] at h2
      exact h2
    have hmono : ENNReal.ofReal (1 / A ^ (k + 1)) * (Ng *
          (∫⁻ w : Pl, ‖𝓕 (phcA j m ε t ξ i b k) (-w)‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ))
        ≤ ENNReal.ofReal (1 / A ^ (k + 1)) *
          (Ng * ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol)) :=
      mul_le_mul' (le_refl _) (mul_le_mul' (le_refl _) hNk)
    refine le_trans hmono (le_of_eq ?_)
    have hcomm : ENNReal.ofReal (1 / A ^ (k + 1)) * (Ng *
          ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol))
        = (ENNReal.ofReal (1 / A ^ (k + 1)) *
          ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol)) * Ng := by
      ring
    rw [hcomm, ← ENNReal.ofReal_mul (by positivity)]
    have hid : 1 / A ^ (k + 1) * (cBound j m B Cs CV k * Real.sqrt vol)
        = cBound j m B Cs CV k * Real.sqrt vol / A ^ (k + 1) := by
      ring
    rw [hid]
  refine le_trans hstep1 (le_trans (Finset.sum_le_sum hterm) ?_)
  -- step 3: pull out the constant and use the geometric bound
  rw [← Finset.sum_mul]
  refine mul_le_mul' ?_ (le_refl _)
  have hsum : (∑ k ∈ Finset.range K,
      ENNReal.ofReal (cBound j m B Cs CV k * Real.sqrt vol / A ^ (k + 1)))
      = ENNReal.ofReal (∑ k ∈ Finset.range K,
        cBound j m B Cs CV k * Real.sqrt vol / A ^ (k + 1)) := by
    rw [ENNReal.ofReal_sum_of_nonneg]
    intro k _
    have hcnn : 0 ≤ cBound j m B Cs CV k := cBound_nonneg hB.nonneg hCsnn hCVnn k
    positivity
  rw [hsum]
  refine ENNReal.ofReal_le_ofReal ?_
  have hgeom := sum_cBound_div_le j m hB.nonneg hCsnn hCVnn hA4 K
  have hrw : (∑ k ∈ Finset.range K, cBound j m B Cs CV k * Real.sqrt vol / A ^ (k + 1))
      = Real.sqrt vol * ∑ k ∈ Finset.range K, cBound j m B Cs CV k / A ^ (k + 1) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun k _ => ?_
    ring
  rw [hrw]
  refine mul_le_mul_of_nonneg_left hgeom (Real.sqrt_nonneg _)

end MainTerms


/-! ### The remainder term -/

section RemTerm

/-- The uniform bound for the remainder amplitude on the region `|w_i| ≥ A`. -/
def rBound (j m : ℕ) (B Cs CV : ℝ) (K : ℕ) (A : ℝ) : ℝ :=
  (2 * cBound j m B Cs CV K / A
      + 4 * (B * ((2 : ℝ) ^ (11 - (m : ℤ))) ^ K) *
        (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))) / A ^ 2) / A ^ K

theorem rBound_nonneg {j m : ℕ} {B Cs CV : ℝ} (hB : 0 ≤ B) (hCs : 0 ≤ Cs) (hCV : 0 ≤ CV)
    (K : ℕ) {A : ℝ} (hA : 0 < A) : 0 ≤ rBound j m B Cs CV K A := by
  have hc : 0 ≤ cBound j m B Cs CV K := cBound_nonneg hB hCs hCV K
  rw [rBound]
  positivity

theorem norm_rAmpd_le' {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (K : ℕ)
    {A : ℝ} (hA13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ A) {w : Pl} (hA : A ≤ |w i|) (η : Pl) :
    ‖rAmpd j m ε t ξ i b K w η‖ ≤ rBound j m B Cs CV K A := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hApos : (0 : ℝ) < A := lt_of_lt_of_le (by positivity) hA13
  have hw13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i| := le_trans hA13 hA
  have hcnn : 0 ≤ cBound j m B Cs CV K := cBound_nonneg hB.nonneg hCsnn hCVnn K
  have hBnn : 0 ≤ B := hB.nonneg
  refine le_trans (norm_rAmpd_le hB hCs hCVnn hCV hε ht1 ht2 ξ i K hw13 η) ?_
  rw [rBound]
  gcongr <;> positivity

theorem norm_integral_oscph_rAmpd_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) (i : Fin 2) (K : ℕ)
    {A : ℝ} (hA13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ A) {w : Pl} (hA : A ≤ |w i|) :
    ‖∫ η : Pl, oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η‖
      ≤ rBound j m B Cs CV K A * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hApos : (0 : ℝ) < A := lt_of_lt_of_le (by positivity) hA13
  have hw13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i| := le_trans hA13 hA
  have hwne : w i ≠ 0 := w_coord_ne_zero hw13
  have hPsi : ∀ η : Pl, Psi j m ε t ξ i w η ≠ 0 := Psi_ne_zero hε ht1 ht2 ξ i hw13
  set RB : ℝ := rBound j m B Cs CV K A with hRB
  have hRBnn : 0 ≤ RB := by
    rw [hRB]
    exact rBound_nonneg hB.nonneg hCsnn hCVnn K hApos
  set S : Set Pl := closure (SuppSet j m ξ) with hS
  have hSmeas : MeasurableSet S := isClosed_closure.measurableSet
  have hSfin : volume S < ⊤ :=
    lt_of_le_of_lt (volume_closure_SuppSet_le j m ξ) ENNReal.ofReal_lt_top
  set f : Pl → ℂ := fun η => oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η with hf
  have hfint : Integrable f :=
    integrable_oscph_mul_rAmpd j m ε t ξ i (hB.smooth t ξ) hB.supp K hwne hPsi
  have hbd : ∀ η : Pl, ‖f η‖ ≤ RB * Set.indicator S (fun _ => (1 : ℝ)) η := by
    intro η
    by_cases hmem : η ∈ S
    · rw [Set.indicator_of_mem hmem, mul_one, hf]
      show ‖oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η‖ ≤ RB
      rw [norm_mul, norm_oscph, one_mul, hRB]
      exact norm_rAmpd_le' hB hCs hCVnn hCV hε ht1 ht2 ξ i K hA13 hA η
    · rw [Set.indicator_of_notMem hmem, mul_zero, hf]
      show ‖oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η‖ ≤ 0
      have h := rAmpd_eq_zero_of_notMem j m ε t ξ i hB.supp K w (η := η) hmem
      rw [h, mul_zero, norm_zero]
  have hintR : Integrable (fun η : Pl => RB * Set.indicator S (fun _ => (1 : ℝ)) η) := by
    refine Integrable.const_mul ?_ RB
    rw [integrable_indicator_iff hSmeas]
    exact integrableOn_const (C := (1 : ℝ)) (hs := hSfin.ne)
  have hmono := integral_mono hfint.norm hintR hbd
  have hRHS : (∫ η : Pl, RB * Set.indicator S (fun _ => (1 : ℝ)) η)
      = RB * (volume S).toReal := by
    rw [integral_const_mul]
    congr 1
    rw [integral_indicator_const (1 : ℝ) hSmeas, smul_eq_mul, mul_one]
    rfl
  rw [hRHS] at hmono
  refine le_trans (norm_integral_le_integral_norm f) (le_trans hmono ?_)
  refine mul_le_mul_of_nonneg_left ?_ hRBnn
  have h1 : (volume S).toReal ≤ ((ENNReal.ofReal
      ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))).toReal) := by
    refine ENNReal.toReal_mono ENNReal.ofReal_ne_top ?_
    rw [hS]
    exact volume_closure_SuppSet_le j m ξ
  refine le_trans h1 (le_of_eq ?_)
  rw [ENNReal.toReal_ofReal (by positivity)]

end RemTerm


/-! ### The off-diagonal estimate on one coordinate-dominant region -/

section OffdiagRegion

theorem norm_ibp_const :
    ‖-(1 / ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I))‖ = 1 / (2 * Real.pi) := by
  rw [norm_neg, norm_div, norm_one, norm_mul, Complex.norm_I, mul_one, Complex.norm_real,
    Real.norm_eq_abs, abs_of_pos (by positivity : (0 : ℝ) < 2 * Real.pi)]

theorem measurable_mainSum {j m : ℕ} {ε t : ℝ} {ξ : Pl} {i : Fin 2} {b : ℝ → Pl → Pl → ℂ}
    (hb : ContDiff ℝ (↑(⊤ : ℕ∞)) (b t ξ))
    (hsupp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0) (K : ℕ) :
    Measurable fun w : Pl => ∑ k ∈ Finset.range K,
      𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1) := by
  refine Finset.measurable_sum _ fun k _ => ?_
  have h1 : Measurable fun w : Pl => 𝓕 (phcA j m ε t ξ i b k) (-w) :=
    (measurable_fourier_phcA hb hsupp k).comp measurable_neg
  have h2 : Measurable fun w : Pl => ((w i : ℝ) : ℂ) ^ (k + 1) :=
    (Complex.measurable_ofReal.comp
      (EuclideanSpace.proj i).continuous.measurable).pow_const _
  exact h1.div h2

/-- The off-diagonal estimate on a region where the `i`-th coordinate of `w` dominates. -/
theorem lintegral_offdiag_region {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ)
    (i : Fin 2) (K : ℕ) {A : ℝ}
    (hA13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ A) (hA4 : 4 * (2 : ℝ) ^ (11 - (m : ℤ)) ≤ A)
    {S : Set Pl} (hSmeas : MeasurableSet S) (hSA : ∀ w : Pl, w ∈ S → A ≤ |w i|)
    {gi : Pl → ℂ} (hgi : AEMeasurable gi (volume : Measure Pl))
    (hgiS : ∀ w : Pl, gi w ≠ 0 → w ∈ S) :
    (∫⁻ w : Pl, ‖gi w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ ENNReal.ofReal (1 / (2 * Real.pi)) *
          (ENNReal.ofReal (Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
              (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
                + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2))
            * (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
          + ENNReal.ofReal (rBound j m B Cs CV K A * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
            * ((volume S) ^ (2⁻¹ : ℝ)
              * (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ))) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hApos : (0 : ℝ) < A := lt_of_lt_of_le (by positivity) hA13
  have hgiA : ∀ w : Pl, gi w ≠ 0 → A ≤ |w i| := fun w hz => hSA w (hgiS w hz)
  -- the pointwise bound
  have hpt : ∀ w : Pl, ‖gi w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ
      ≤ ENNReal.ofReal (1 / (2 * Real.pi)) *
        (‖gi w * ∑ k ∈ Finset.range K,
              𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1)‖ₑ
          + ‖gi w * ∫ η : Pl, oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η‖ₑ) := by
    intro w
    by_cases hz : gi w = 0
    · rw [hz, zero_mul, enorm_zero]
      exact zero_le
    · have hAw : A ≤ |w i| := hgiA w hz
      have hw13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ |w i| := le_trans hA13 hAw
      rw [integral_oscph_mul_b_eq hB hε ht1 ht2 hξ i K hw13]
      have hrw : gi w * (-(1 / ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I)) *
            ((∑ k ∈ Finset.range K,
                𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))
              + ∫ η : Pl, oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η))
          = (-(1 / ((((2 * Real.pi : ℝ)) : ℂ) * Complex.I))) *
            ((gi w * ∑ k ∈ Finset.range K,
                𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1))
              + gi w * ∫ η : Pl, oscph j ε t ξ w η * rAmpd j m ε t ξ i b K w η) := by
        ring
      rw [hrw, enorm_mul]
      refine mul_le_mul' (le_of_eq ?_) (enorm_add_le _ _)
      rw [← ofReal_norm, norm_ibp_const]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_const_mul' _ _ (by simp)]
  refine mul_le_mul' (le_refl _) ?_
  -- split the two pieces
  have hMSmeas : AEMeasurable (fun w : Pl => ‖gi w * ∑ k ∈ Finset.range K,
      𝓕 (phcA j m ε t ξ i b k) (-w) / ((w i : ℝ) : ℂ) ^ (k + 1)‖ₑ)
      (volume : Measure Pl) :=
    (hgi.mul (measurable_mainSum (hB.smooth t ξ) hB.supp K).aemeasurable).enorm
  rw [lintegral_add_left' hMSmeas]
  refine add_le_add ?_ ?_
  · exact enorm_main_terms_le hB hCs hCVnn hCV hε ht1 ht2 ξ i K hA4 hgi hgiA
  · refine lintegral_rem_le hSmeas hgi hgiS ?_ ?_
    · have hc : 0 ≤ rBound j m B Cs CV K A :=
        rBound_nonneg hB.nonneg hCsnn hCVnn K hApos
      positivity
    · intro w hw
      exact norm_integral_oscph_rAmpd_le hB hCs hCVnn hCV hε ht1 ht2 ξ i K hA13 (hSA w hw)

/-- In the plane, if the norm is not dominated by twice the first coordinate then it is dominated
by twice the second. -/
theorem norm_le_two_mul_abs_snd {w : Pl} (h : ¬ ‖w‖ ≤ 2 * |w 0|) : ‖w‖ ≤ 2 * |w 1| := by
  have hgt : 2 * |w 0| < ‖w‖ := not_le.mp h
  have hsq := norm_sq_eq_coords w
  nlinarith [abs_nonneg (w 0), abs_nonneg (w 1), sq_abs (w 0), sq_abs (w 1), norm_nonneg w]

end OffdiagRegion


/-! ### Splitting into the two coordinate-dominant regions -/

section TwoRegions

theorem continuous_oscph_pair (j : ℕ) (ε t : ℝ) (ξ : Pl) :
    Continuous fun q : Pl × Pl => oscph j ε t ξ q.1 q.2 := by
  refine Complex.continuous_exp.comp ?_
  refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
  refine continuous_const.mul ?_
  have hinner : Continuous fun q : Pl × Pl => (inner ℝ q.1 q.2 : ℝ) :=
    continuous_fst.inner continuous_snd
  have hNtl : Continuous (Ntl j) := (contDiff_Ntl j).continuous
  exact hinner.add (continuous_const.mul
    ((hNtl.comp (continuous_const.sub continuous_snd)).add (hNtl.comp continuous_snd)))

theorem measurable_inner_integral (j m : ℕ) (ε t : ℝ) (ξ : Pl) {b : ℝ → Pl → Pl → ℂ}
    (hbc : Continuous (b t ξ)) :
    Measurable fun w : Pl => ∫ η : Pl, oscph j ε t ξ w η * b t ξ η := by
  have hcont : Continuous fun q : Pl × Pl => oscph j ε t ξ q.1 q.2 * b t ξ q.2 :=
    (continuous_oscph_pair j ε t ξ).mul (hbc.comp continuous_snd)
  exact (hcont.stronglyMeasurable.integral_prod_right'
    (ν := (volume : Measure Pl))).measurable

theorem measurableSet_domFst : MeasurableSet {w : Pl | ‖w‖ ≤ 2 * |w 0|} := by
  have h0 : Continuous fun w : Pl => w 0 := (EuclideanSpace.proj (0 : Fin 2)).continuous
  exact measurableSet_le continuous_norm.measurable
    (continuous_const.mul h0.abs).measurable

theorem lintegral_enorm_sq_indicator_le (T : Set Pl) (g : Pl → ℂ) :
    (∫⁻ w : Pl, ‖Set.indicator T g w‖ₑ ^ (2 : ℝ)) ≤ ∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ) := by
  refine lintegral_mono fun w => ?_
  by_cases hw : w ∈ T
  · rw [Set.indicator_of_mem hw]
  · rw [Set.indicator_of_notMem hw]
    simp [ENNReal.zero_rpow_of_pos]

/-- The off-diagonal estimate, after splitting the `w`-integral into the two
coordinate-dominant regions. -/
theorem lintegral_offdiag_two_regions {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ)
    (K : ℕ) {A R : ℝ}
    (hA13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ A) (hA4 : 4 * (2 : ℝ) ^ (11 - (m : ℤ)) ≤ A)
    {g : Pl → ℂ} (hg : AEMeasurable g (volume : Measure Pl))
    (hgA : ∀ w : Pl, g w ≠ 0 → 2 * A ≤ ‖w‖) (hgR : ∀ w : Pl, g w ≠ 0 → ‖w‖ ≤ R) :
    (∫⁻ w : Pl, ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ 2 * (ENNReal.ofReal (1 / (2 * Real.pi)) *
          (ENNReal.ofReal (Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
              (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
                + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2))
            * (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
          + ENNReal.ofReal (rBound j m B Cs CV K A * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
            * ((volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ)
              * (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)))) := by
  classical
  set T : Set Pl := {w : Pl | ‖w‖ ≤ 2 * |w 0|} with hT
  have hTmeas : MeasurableSet T := measurableSet_domFst
  set g0 : Pl → ℂ := Set.indicator T g with hg0
  set g1 : Pl → ℂ := Set.indicator Tᶜ g with hg1
  set h : Pl → ℂ := fun w => ∫ η : Pl, oscph j ε t ξ w η * b t ξ η with hh
  have hhmeas : Measurable h := measurable_inner_integral j m ε t ξ (hB.smooth t ξ).continuous
  have hg0meas : AEMeasurable g0 (volume : Measure Pl) := hg.indicator hTmeas
  have hg1meas : AEMeasurable g1 (volume : Measure Pl) := hg.indicator hTmeas.compl
  have hsplit : ∀ w : Pl, ‖g w * h w‖ₑ = ‖g0 w * h w‖ₑ + ‖g1 w * h w‖ₑ := by
    intro w
    by_cases hw : w ∈ T
    · rw [hg0, hg1, Set.indicator_of_mem hw,
        Set.indicator_of_notMem (by simpa using hw)]
      simp
    · rw [hg0, hg1, Set.indicator_of_notMem hw,
        Set.indicator_of_mem (by simpa using hw)]
      simp
  have hbound : ∀ (i : Fin 2) (gi : Pl → ℂ), AEMeasurable gi (volume : Measure Pl) →
      (∀ w : Pl, gi w ≠ 0 → A ≤ |w i| ∧ ‖w‖ ≤ R) →
      (∀ w : Pl, ‖gi w‖ ≤ ‖g w‖) →
      (∫⁻ w : Pl, ‖gi w * h w‖ₑ)
        ≤ ENNReal.ofReal (1 / (2 * Real.pi)) *
            (ENNReal.ofReal (Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
                (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
                  + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2))
              * (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
            + ENNReal.ofReal (rBound j m B Cs CV K A *
                (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
              * ((volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ)
                * (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ))) := by
    intro i gi hgim hgireg hgile
    set S : Set Pl := {w : Pl | A ≤ |w i|} ∩ Metric.closedBall (0 : Pl) R with hS
    have hSmeas : MeasurableSet S := by
      refine MeasurableSet.inter ?_ Metric.isClosed_closedBall.measurableSet
      have hi : Continuous fun w : Pl => w i := (EuclideanSpace.proj i).continuous
      exact measurableSet_le measurable_const hi.abs.measurable
    have hSA : ∀ w : Pl, w ∈ S → A ≤ |w i| := fun w hw => hw.1
    have hgiS : ∀ w : Pl, gi w ≠ 0 → w ∈ S := by
      intro w hz
      obtain ⟨h1, h2⟩ := hgireg w hz
      refine ⟨h1, ?_⟩
      rw [Metric.mem_closedBall, dist_zero_right]
      exact h2
    have hkey := lintegral_offdiag_region hB hCs hCVnn hCV hε ht1 ht2 hξ i K hA13 hA4
      hSmeas hSA hgim hgiS
    have hNle : (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
        ≤ (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
      refine ENNReal.rpow_le_rpow ?_ (by norm_num)
      refine lintegral_mono fun w => ?_
      refine ENNReal.rpow_le_rpow ?_ (by norm_num)
      rw [← ofReal_norm, ← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (hgile w)
    have hvS : (volume S) ^ (2⁻¹ : ℝ)
        ≤ (volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ) := by
      refine ENNReal.rpow_le_rpow (measure_mono ?_) (by norm_num)
      exact Set.inter_subset_right
    refine le_trans hkey ?_
    refine mul_le_mul' (le_refl _) ?_
    exact add_le_add (mul_le_mul' (le_refl _) hNle)
      (mul_le_mul' (le_refl _) (mul_le_mul' hvS hNle))
  have hreg0 : ∀ w : Pl, g0 w ≠ 0 → A ≤ |w 0| ∧ ‖w‖ ≤ R := by
    intro w hz
    have hmem : w ∈ T := by
      by_contra hw
      rw [hg0, Set.indicator_of_notMem hw] at hz
      exact hz rfl
    have hgw : g w ≠ 0 := by
      intro hcon
      rw [hg0, Set.indicator_of_mem hmem, hcon] at hz
      exact hz rfl
    have h2A := hgA w hgw
    have hTw : ‖w‖ ≤ 2 * |w 0| := hmem
    exact ⟨by linarith, hgR w hgw⟩
  have hle0 : ∀ w : Pl, ‖g0 w‖ ≤ ‖g w‖ := by
    intro w
    by_cases hw : w ∈ T
    · rw [hg0, Set.indicator_of_mem hw]
    · rw [hg0, Set.indicator_of_notMem hw, norm_zero]
      exact norm_nonneg _
  have hreg1 : ∀ w : Pl, g1 w ≠ 0 → A ≤ |w 1| ∧ ‖w‖ ≤ R := by
    intro w hz
    have hmem : w ∈ Tᶜ := by
      by_contra hw
      rw [hg1, Set.indicator_of_notMem hw] at hz
      exact hz rfl
    have hgw : g w ≠ 0 := by
      intro hcon
      rw [hg1, Set.indicator_of_mem hmem, hcon] at hz
      exact hz rfl
    have h2A := hgA w hgw
    have hTw : ‖w‖ ≤ 2 * |w 1| := by
      refine norm_le_two_mul_abs_snd ?_
      intro hcon
      exact hmem hcon
    exact ⟨by linarith, hgR w hgw⟩
  have hle1 : ∀ w : Pl, ‖g1 w‖ ≤ ‖g w‖ := by
    intro w
    by_cases hw : w ∈ Tᶜ
    · rw [hg1, Set.indicator_of_mem hw]
    · rw [hg1, Set.indicator_of_notMem hw, norm_zero]
      exact norm_nonneg _
  have h0 := hbound 0 g0 hg0meas hreg0 hle0
  have h1 := hbound 1 g1 hg1meas hreg1 hle1
  have hAE : AEMeasurable (fun w : Pl => ‖g0 w * h w‖ₑ) (volume : Measure Pl) := by
    have h1 : AEMeasurable (fun w : Pl => g0 w * h w) (volume : Measure Pl) :=
      hg0meas.mul hhmeas.aemeasurable
    exact h1.enorm
  rw [lintegral_congr hsplit, lintegral_add_left' hAE]
  exact le_trans (add_le_add h0 h1) (le_of_eq (two_mul _).symm)

end TwoRegions


/-! ### The volume of a planar ball -/

section BallVolume

theorem volume_closedBall_le {R : ℝ} (hR : 0 ≤ R) :
    volume (Metric.closedBall (0 : Pl) R) ≤ ENNReal.ofReal (4 * R ^ 2) := by
  have hsub : Metric.closedBall (0 : Pl) R
      ⊆ {x : Pl | |x 0 - (0 : ℝ) * x 1| ≤ R ∧ |x 1| ≤ R} := by
    intro w hw
    rw [Metric.mem_closedBall, dist_zero_right] at hw
    refine ⟨?_, ?_⟩
    · rw [zero_mul, sub_zero]
      exact le_trans (Auto.CalderonVaillancourt.abs_apply_le_norm w 0) hw
    · exact le_trans (Auto.CalderonVaillancourt.abs_apply_le_norm w 1) hw
  refine le_trans (measure_mono hsub) (le_trans (volume_slab_le 0 R R hR hR) ?_)
  refine ENNReal.ofReal_le_ofReal ?_
  nlinarith [hR]

end BallVolume


/-! ### Square roots of dyadic powers -/

section SqrtDyadic

theorem sqrt_two_zpow_mul (a c : ℤ) :
    Real.sqrt ((2 : ℝ) ^ a) * Real.sqrt ((2 : ℝ) ^ c)
      = Real.sqrt ((2 : ℝ) ^ (a + c)) := by
  rw [two_zpow_add, Real.sqrt_mul (by positivity)]

theorem sqrt_two_zpow_even (a : ℤ) : Real.sqrt ((2 : ℝ) ^ (2 * a)) = (2 : ℝ) ^ a := by
  have hsq : ((2 : ℝ) ^ a) ^ 2 = (2 : ℝ) ^ (2 * a) := by
    rw [sq, ← two_zpow_add]
    congr 1
    ring
  rw [← hsq, Real.sqrt_sq (by positivity)]

theorem sqrt_two_zpow_pos (a : ℤ) : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ a) :=
  Real.sqrt_pos.mpr (by positivity)

/-- `√(2 ^ (2j - m + 12)) = 2 ^ (j + 6) √(2 ^ (-m))`. -/
theorem sqrt_vol_eq (j m : ℕ) :
    Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
      = (2 : ℝ) ^ ((j : ℤ) + 6) * Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) := by
  have hsplit : (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
      = (2 : ℝ) ^ (2 * ((j : ℤ) + 6)) * (2 : ℝ) ^ (-(m : ℤ)) := by
    rw [← two_zpow_add]
    congr 1
    ring
  rw [hsplit, Real.sqrt_mul (by positivity), sqrt_two_zpow_even]

/-- `√(2 ^ (-m)) · 2 ^ (2m) = √(2 ^ (3m))`. -/
theorem sqrt_neg_mul_sq (m : ℕ) :
    Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) * (2 : ℝ) ^ (2 * (m : ℤ))
      = Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) := by
  have h4 : (2 : ℝ) ^ (2 * (m : ℤ)) = Real.sqrt ((2 : ℝ) ^ (4 * (m : ℤ))) := by
    rw [show (4 : ℤ) * (m : ℤ) = 2 * (2 * (m : ℤ)) by ring, sqrt_two_zpow_even]
  rw [h4, sqrt_two_zpow_mul]
  congr 2
  ring

end SqrtDyadic


/-! ### The closed form of the main term -/

section MainClosed

theorem two_zpow_ne (a : ℤ) : ((2 : ℝ) ^ a) ≠ 0 := by positivity

theorem two_zpow_div (a c : ℤ) : (2 : ℝ) ^ a / (2 : ℝ) ^ c = (2 : ℝ) ^ (a - c) :=
  (zpow_sub₀ (two_ne_zero) a c).symm

theorem two_zpow_one : (2 : ℝ) = (2 : ℝ) ^ (1 : ℤ) := by norm_num

theorem main_term1_eq (j m l : ℕ) (B : ℝ) :
    Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18))
      = B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-(l : ℤ) - 11) := by
  have hpow : (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))))
        / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18))
      = B * (2 : ℝ) ^ (1 - ((j : ℤ) - (m : ℤ)) - (((l : ℤ) - (m : ℤ)) + 18)) := by
    rw [show (2 : ℝ) * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))))
        = B * ((2 : ℝ) ^ (1 : ℤ) * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) by
      rw [← two_zpow_one]; ring]
    rw [← two_zpow_add, mul_div_assoc, two_zpow_div,
      show (1 + -((j : ℤ) - (m : ℤ))) - (((l : ℤ) - (m : ℤ)) + 18)
        = 1 - ((j : ℤ) - (m : ℤ)) - (((l : ℤ) - (m : ℤ)) + 18) by ring]
  rw [hpow, sqrt_vol_eq]
  have hcollect : (2 : ℝ) ^ ((j : ℤ) + 6) *
      (2 : ℝ) ^ (1 - ((j : ℤ) - (m : ℤ)) - (((l : ℤ) - (m : ℤ)) + 18))
      = (2 : ℝ) ^ (2 * (m : ℤ)) * (2 : ℝ) ^ (-(l : ℤ) - 11) := by
    rw [← two_zpow_add, ← two_zpow_add]
    congr 1
    ring
  calc (2 : ℝ) ^ ((j : ℤ) + 6) * Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        (B * (2 : ℝ) ^ (1 - ((j : ℤ) - (m : ℤ)) - (((l : ℤ) - (m : ℤ)) + 18)))
      = B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        ((2 : ℝ) ^ ((j : ℤ) + 6) *
          (2 : ℝ) ^ (1 - ((j : ℤ) - (m : ℤ)) - (((l : ℤ) - (m : ℤ)) + 18)))) := by ring
    _ = B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        ((2 : ℝ) ^ (2 * (m : ℤ)) * (2 : ℝ) ^ (-(l : ℤ) - 11))) := by rw [hcollect]
    _ = B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) * (2 : ℝ) ^ (2 * (m : ℤ))) *
        (2 : ℝ) ^ (-(l : ℤ) - 11) := by ring
    _ = B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-(l : ℤ) - 11) := by
        rw [sqrt_neg_mul_sq]

theorem main_term2_eq (j m l : ℕ) (B Cs CV : ℝ) :
    Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        (8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))))
          / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2)
      = 32 * Cs * CV * B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) *
          (2 : ℝ) ^ (-2 * (l : ℤ) - 30) := by
  have hsq : ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
      = (2 : ℝ) ^ (2 * (((l : ℤ) - (m : ℤ)) + 18)) := by
    rw [sq, ← two_zpow_add]
    congr 1
    ring
  have hnum : (8 : ℝ) * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))))
      = 32 * Cs * CV * B * (2 : ℝ) ^ (-(j : ℤ)) := by ring
  rw [hsq, hnum, sqrt_vol_eq, mul_div_assoc, two_zpow_div]
  have hcollect : (2 : ℝ) ^ ((j : ℤ) + 6) *
      (2 : ℝ) ^ (-(j : ℤ) - 2 * (((l : ℤ) - (m : ℤ)) + 18))
      = (2 : ℝ) ^ (2 * (m : ℤ)) * (2 : ℝ) ^ (-2 * (l : ℤ) - 30) := by
    rw [← two_zpow_add, ← two_zpow_add]
    congr 1
    ring
  calc (2 : ℝ) ^ ((j : ℤ) + 6) * Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        (32 * Cs * CV * B * (2 : ℝ) ^ (-(j : ℤ) - 2 * (((l : ℤ) - (m : ℤ)) + 18)))
      = 32 * Cs * CV * B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        ((2 : ℝ) ^ ((j : ℤ) + 6) *
          (2 : ℝ) ^ (-(j : ℤ) - 2 * (((l : ℤ) - (m : ℤ)) + 18)))) := by ring
    _ = 32 * Cs * CV * B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) *
        ((2 : ℝ) ^ (2 * (m : ℤ)) * (2 : ℝ) ^ (-2 * (l : ℤ) - 30))) := by rw [hcollect]
    _ = 32 * Cs * CV * B * (Real.sqrt ((2 : ℝ) ^ (-(m : ℤ))) * (2 : ℝ) ^ (2 * (m : ℤ))) *
        (2 : ℝ) ^ (-2 * (l : ℤ) - 30) := by ring
    _ = 32 * Cs * CV * B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) *
        (2 : ℝ) ^ (-2 * (l : ℤ) - 30) := by rw [sqrt_neg_mul_sq]

/-- The main term of the off-diagonal estimate in closed form. -/
theorem main_bound_closed (j m l : ℕ) {B Cs CV : ℝ} (hBnn : 0 ≤ B) (hCsnn : 0 ≤ Cs)
    (hCVnn : 0 ≤ CV) :
    Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)
          + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ))))))
            / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2)
      ≤ (1 + 32 * Cs * CV) * B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ)))
        * (2 : ℝ) ^ (-(l : ℤ)) := by
  set Sq : ℝ := Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) with hSq
  have hSqnn : 0 ≤ Sq := by rw [hSq]; exact Real.sqrt_nonneg _
  have h1 : (2 : ℝ) ^ (-(l : ℤ) - 11) ≤ (2 : ℝ) ^ (-(l : ℤ)) :=
    zpow_le_zpow_right₀ (by norm_num) (by omega)
  have h2 : (2 : ℝ) ^ (-2 * (l : ℤ) - 30) ≤ (2 : ℝ) ^ (-(l : ℤ)) :=
    zpow_le_zpow_right₀ (by norm_num) (by omega)
  rw [mul_add, main_term1_eq, main_term2_eq, ← hSq]
  have e1 : B * Sq * (2 : ℝ) ^ (-(l : ℤ) - 11)
      ≤ 1 * (B * Sq * (2 : ℝ) ^ (-(l : ℤ))) := by
    rw [one_mul, mul_assoc, mul_assoc]
    refine mul_le_mul_of_nonneg_left ?_ hBnn
    exact mul_le_mul_of_nonneg_left h1 hSqnn
  have e2 : 32 * Cs * CV * B * Sq * (2 : ℝ) ^ (-2 * (l : ℤ) - 30)
      ≤ (32 * Cs * CV) * (B * Sq * (2 : ℝ) ^ (-(l : ℤ))) := by
    have hre : 32 * Cs * CV * B * Sq * (2 : ℝ) ^ (-2 * (l : ℤ) - 30)
        = (32 * Cs * CV) * (B * (Sq * (2 : ℝ) ^ (-2 * (l : ℤ) - 30))) := by ring
    have hre2 : (32 * Cs * CV) * (B * Sq * (2 : ℝ) ^ (-(l : ℤ)))
        = (32 * Cs * CV) * (B * (Sq * (2 : ℝ) ^ (-(l : ℤ)))) := by ring
    rw [hre, hre2]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    refine mul_le_mul_of_nonneg_left ?_ hBnn
    exact mul_le_mul_of_nonneg_left h2 hSqnn
  calc B * Sq * (2 : ℝ) ^ (-(l : ℤ) - 11)
        + 32 * Cs * CV * B * Sq * (2 : ℝ) ^ (-2 * (l : ℤ) - 30)
      ≤ 1 * (B * Sq * (2 : ℝ) ^ (-(l : ℤ)))
        + (32 * Cs * CV) * (B * Sq * (2 : ℝ) ^ (-(l : ℤ))) := add_le_add e1 e2
    _ = (1 + 32 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ)) := by ring

end MainClosed


/-! ### The closed form of the remainder -/

section RemClosed

theorem two_zpow_pow (a : ℤ) (n : ℕ) : ((2 : ℝ) ^ a) ^ n = (2 : ℝ) ^ (a * (n : ℤ)) := by
  rw [← zpow_natCast ((2 : ℝ) ^ a) n, ← zpow_mul]

/-- `j + 17 + l ≤ (l + 7)(j + 3)`, the inequality that makes the remainder negligible. -/
theorem key_exp_ineq (j l : ℕ) :
    (j : ℤ) + 17 + (l : ℤ) ≤ ((l : ℤ) + 7) * ((j : ℤ) + 3) := by
  have hl : (0 : ℤ) ≤ (l : ℤ) := Int.natCast_nonneg l
  have hj : (0 : ℤ) ≤ (j : ℤ) := Int.natCast_nonneg j
  nlinarith [mul_nonneg hl hj]

theorem key_exp_ineq' (j l : ℕ) :
    (j : ℤ) - 2 + (l : ℤ) ≤ ((l : ℤ) + 7) * ((j : ℤ) + 3) := by
  have h := key_exp_ineq j l
  linarith

/-- `(j + 3) ≤ 3 · 2 ^ (6j)` in the reals. -/
theorem nat_le_three_mul_two_pow (j : ℕ) :
    ((j : ℝ) + 3) ≤ 3 * (2 : ℝ) ^ (6 * (j : ℤ)) := by
  have hnat : 6 * j + 1 ≤ 2 ^ (6 * j) := by
    have h := Nat.lt_two_pow_self (n := 6 * j)
    omega
  have hcast : ((6 * j + 1 : ℕ) : ℝ) ≤ ((2 ^ (6 * j) : ℕ) : ℝ) := by
    exact_mod_cast hnat
  have hpow : ((2 ^ (6 * j) : ℕ) : ℝ) = (2 : ℝ) ^ (6 * (j : ℤ)) := by
    rw [show (6 : ℤ) * (j : ℤ) = ((6 * j : ℕ) : ℤ) by push_cast; ring, zpow_natCast]
    push_cast
    ring
  rw [hpow] at hcast
  push_cast at hcast
  linarith

/-- The exponent identity for the first remainder term. -/
theorem rem_exp1 (j m l : ℕ) :
    2 * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)
        * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)))
      = (2 : ℝ) ^ ((j : ℤ) + 17) := by
  rw [show (2 : ℝ) * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))
      = (2 : ℝ) ^ (1 : ℤ) * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) by rw [← two_zpow_one],
    show (2 : ℝ) * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)
      = (2 : ℝ) ^ (1 : ℤ) * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21) by rw [← two_zpow_one]]
  rw [← two_zpow_add, ← two_zpow_add, two_zpow_div, ← two_zpow_add, ← two_zpow_add]
  congr 1
  ring

/-- The exponent identity for the remaining two remainder terms. -/
theorem rem_exp2 (j m l : ℕ) :
    (2 : ℝ) ^ (-(j : ℤ)) / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
        * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)))
      = (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2) := by
  have hsq : ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
      = (2 : ℝ) ^ (2 * (((l : ℤ) - (m : ℤ)) + 18)) := by
    rw [sq, ← two_zpow_add]
    congr 1
    ring
  rw [hsq, show (2 : ℝ) * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)
      = (2 : ℝ) ^ (1 : ℤ) * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21) by rw [← two_zpow_one]]
  rw [two_zpow_div, ← two_zpow_add, ← two_zpow_add, ← two_zpow_add]
  congr 1
  ring

/-- The first remainder factor is at most `2 ^ (-l)`. -/
theorem rem_factor1 (j l : ℕ) :
    ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) * (2 : ℝ) ^ ((j : ℤ) + 17)
      ≤ (2 : ℝ) ^ (-(l : ℤ)) := by
  rw [two_zpow_pow, ← two_zpow_add]
  refine zpow_le_zpow_right₀ (by norm_num) ?_
  have h := key_exp_ineq j l
  push_cast
  nlinarith [h]

/-- The third remainder factor is at most `2 ^ (-l)`. -/
theorem rem_factor3 (j l : ℕ) :
    ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)
      ≤ (2 : ℝ) ^ (-(l : ℤ)) := by
  rw [two_zpow_pow, ← two_zpow_add]
  refine zpow_le_zpow_right₀ (by norm_num) ?_
  have h := key_exp_ineq' j l
  push_cast
  nlinarith [h]

/-- The second remainder factor is at most `3 · 2 ^ (-l)`. -/
theorem rem_factor2 (j l : ℕ) :
    ((j : ℝ) + 3) * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)
      ≤ 3 * (2 : ℝ) ^ (-(l : ℤ)) := by
  have hkey : (2 : ℝ) ^ (6 * (j : ℤ)) *
      (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2) * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2))
      ≤ (2 : ℝ) ^ (-(l : ℤ)) := by
    rw [two_zpow_pow, ← two_zpow_add, ← two_zpow_add]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    have hl : (0 : ℤ) ≤ (l : ℤ) := Int.natCast_nonneg l
    have hj : (0 : ℤ) ≤ (j : ℤ) := Int.natCast_nonneg j
    have hprod : (0 : ℤ) ≤ (l : ℤ) * (j : ℤ) := mul_nonneg hl hj
    push_cast
    nlinarith [hprod, hl, hj]
  have hcast := nat_le_three_mul_two_pow j
  have hposq : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
      * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2) := by positivity
  calc ((j : ℝ) + 3) * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)
      = ((j : ℝ) + 3) * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)) := by ring
    _ ≤ (3 * (2 : ℝ) ^ (6 * (j : ℤ))) * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)) := mul_le_mul_of_nonneg_right hcast hposq
    _ = 3 * ((2 : ℝ) ^ (6 * (j : ℤ)) * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2))) := by ring
    _ ≤ 3 * (2 : ℝ) ^ (-(l : ℤ)) := by
        refine mul_le_mul_of_nonneg_left hkey (by norm_num)

/-- The Neumann expansion of `rBound` with `K = j + 3`. -/
theorem rBound_expand (j m l : ℕ) (B Cs CV : ℝ) :
    rBound j m B Cs CV (j + 3) ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18))
      = 2 * B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))
          * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)
        + 8 * Cs * CV * B * ((j : ℝ) + 3) * (2 : ℝ) ^ (-(j : ℤ))
          * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
            / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
        + 16 * Cs * CV * B * (2 : ℝ) ^ (-(j : ℤ))
          * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3)
            / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2 := by
  have hAne : ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ≠ 0 := by positivity
  have hVbq : (2 : ℝ) ^ (11 - (m : ℤ))
      = (2 : ℝ) ^ (-(l : ℤ) - 7) * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18) := by
    rw [← two_zpow_add]
    congr 1
    ring
  have hsub : j + 3 - 1 = j + 2 := by omega
  rw [rBound, cBound, hsub, hVbq]
  push_cast
  field_simp
  ring

/-- The remainder of the off-diagonal estimate in closed form. -/
theorem rem_bound_closed (j m l : ℕ) {B Cs CV : ℝ} (hBnn : 0 ≤ B) (hCsnn : 0 ≤ Cs)
    (hCVnn : 0 ≤ CV) :
    rBound j m B Cs CV (j + 3) ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18))
        * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
        * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21))
      ≤ (1 + 40 * Cs * CV) * B * (2 : ℝ) ^ (-(l : ℤ)) := by
  have he1 := rem_exp1 j m l
  have he2 := rem_exp2 j m l
  have hcollapse : rBound j m B Cs CV (j + 3) ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18))
        * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
        * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21))
      = B * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) * (2 : ℝ) ^ ((j : ℤ) + 17))
        + 8 * Cs * CV * B * (((j : ℝ) + 3) * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
            * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2))
        + 16 * Cs * CV * B * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3)
            * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2)) := by
    rw [rBound_expand]
    rw [show (2 * B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))
            * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)
          + 8 * Cs * CV * B * ((j : ℝ) + 3) * (2 : ℝ) ^ (-(j : ℤ))
            * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
              / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
          + 16 * Cs * CV * B * (2 : ℝ) ^ (-(j : ℤ))
            * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3)
              / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2)
          * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
          * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21))
        = B * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) *
            (2 * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) / (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)
              * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
                * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21))))
          + 8 * Cs * CV * B * ((j : ℝ) + 3) * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2) *
            ((2 : ℝ) ^ (-(j : ℤ)) / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
              * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
                * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21))))
          + 16 * Cs * CV * B * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) *
            ((2 : ℝ) ^ (-(j : ℤ)) / ((2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18)) ^ 2
              * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
                * (2 * (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)))) from by ring]
    rw [he1, he2]
    ring
  rw [hcollapse]
  have h1 := rem_factor1 j l
  have h2 := rem_factor2 j l
  have h3 := rem_factor3 j l
  have e1 : B * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3) * (2 : ℝ) ^ ((j : ℤ) + 17))
      ≤ B * (2 : ℝ) ^ (-(l : ℤ)) := mul_le_mul_of_nonneg_left h1 hBnn
  have e2 : 8 * Cs * CV * B * (((j : ℝ) + 3) * ((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 2)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2))
      ≤ 8 * Cs * CV * B * (3 * (2 : ℝ) ^ (-(l : ℤ))) :=
    mul_le_mul_of_nonneg_left h2 (by positivity)
  have e3 : 16 * Cs * CV * B * (((2 : ℝ) ^ (-(l : ℤ) - 7)) ^ (j + 3)
        * (2 : ℝ) ^ ((j : ℤ) - (l : ℤ) - 2))
      ≤ 16 * Cs * CV * B * (2 : ℝ) ^ (-(l : ℤ)) :=
    mul_le_mul_of_nonneg_left h3 (by positivity)
  have hfin : B * (2 : ℝ) ^ (-(l : ℤ)) + 8 * Cs * CV * B * (3 * (2 : ℝ) ^ (-(l : ℤ)))
      + 16 * Cs * CV * B * (2 : ℝ) ^ (-(l : ℤ))
      = (1 + 40 * Cs * CV) * B * (2 : ℝ) ^ (-(l : ℤ)) := by ring
  linarith [e1, e2, e3]

end RemClosed


/-! ## §4.4  The off-diagonal estimate, kernel form -/

section OffdiagKernel

theorem ofReal_ball_sqrt {R : ℝ} (hR : 0 ≤ R) :
    (volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ) ≤ ENNReal.ofReal (2 * R) := by
  have h1 : (volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ)
      ≤ (ENNReal.ofReal (4 * R ^ 2)) ^ (2⁻¹ : ℝ) :=
    ENNReal.rpow_le_rpow (volume_closedBall_le hR) (by norm_num)
  refine le_trans h1 (le_of_eq ?_)
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num)]
  congr 1
  rw [rpow_half_eq_sqrt (by positivity), show (4 : ℝ) * R ^ 2 = (2 * R) ^ 2 by ring,
    Real.sqrt_sq (by positivity)]

theorem one_le_sqrt_two_zpow_mul (m : ℕ) :
    (1 : ℝ) ≤ Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) := by
  have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ (3 * (m : ℤ)) := by
    have h := zpow_le_zpow_right₀ (a := (2 : ℝ)) (by norm_num : (1 : ℝ) ≤ 2)
      (show (0 : ℤ) ≤ 3 * (m : ℤ) by positivity)
    simpa using h
  rw [show (1 : ℝ) = Real.sqrt 1 by rw [Real.sqrt_one]]
  exact Real.sqrt_le_sqrt h1

/-- **The off-diagonal estimate of §4.4** in kernel form.  If `g` is supported in the annulus
`2^{l-m+19} ≤ ‖w‖ ≤ 2^{l-m+21}` then
`∫ ‖g(w) ∫ e^{2πiΦ} b dη‖ dw ≤ c B √(2^{3m}) 2^{-l} ‖g‖₂`, the constant `c` being absolute. -/
theorem lintegral_offdiag_kernel {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ) (l : ℕ)
    {g : Pl → ℂ} (hg : AEMeasurable g (volume : Measure Pl))
    (hglow : ∀ w : Pl, g w ≠ 0 → (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 19) ≤ ‖w‖)
    (hghigh : ∀ w : Pl, g w ≠ 0 → ‖w‖ ≤ (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)) :
    (∫⁻ w : Pl, ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ ENNReal.ofReal ((1 / Real.pi) * (2 + 72 * Cs * CV) * B
            * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-(l : ℤ)))
        * (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hBnn : 0 ≤ B := hB.nonneg
  set A : ℝ := (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 18) with hAdef
  set R : ℝ := (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21) with hRdef
  set Sq : ℝ := Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) with hSqdef
  set Ng : ℝ≥0∞ := (∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) with hNgdef
  have hSq1 : (1 : ℝ) ≤ Sq := by rw [hSqdef]; exact one_le_sqrt_two_zpow_mul m
  have hSqnn : (0 : ℝ) ≤ Sq := by linarith
  have hRnn : (0 : ℝ) ≤ R := by rw [hRdef]; positivity
  have hA13 : (2 : ℝ) ^ (13 - (m : ℤ)) ≤ A := by
    rw [hAdef]
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  have hA4 : 4 * (2 : ℝ) ^ (11 - (m : ℤ)) ≤ A := by
    have hid : (4 : ℝ) * (2 : ℝ) ^ (11 - (m : ℤ)) = (2 : ℝ) ^ (13 - (m : ℤ)) := by
      rw [show (13 : ℤ) - (m : ℤ) = 2 + (11 - (m : ℤ)) by ring, two_zpow_add]
      norm_num
    rw [hid]
    exact hA13
  have hgA : ∀ w : Pl, g w ≠ 0 → 2 * A ≤ ‖w‖ := by
    intro w hz
    have hid : (2 : ℝ) * A = (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 19) := by
      rw [hAdef, show ((l : ℤ) - (m : ℤ) + 19) = 1 + ((l : ℤ) - (m : ℤ) + 18) by ring,
        two_zpow_add 1 ((l : ℤ) - (m : ℤ) + 18), zpow_one]
    rw [hid]
    exact hglow w hz
  have hkey := lintegral_offdiag_two_regions hB hCs hCVnn hCV hε ht1 ht2 hξ (j + 3)
    hA13 hA4 hg hgA (fun w hz => hghigh w hz)
  refine le_trans hkey ?_
  -- bound the main constant
  have hmain : Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
      (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
        + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2)
      ≤ (1 + 32 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ)) := by
    rw [hAdef, hSqdef]
    exact main_bound_closed j m l hBnn hCsnn hCVnn
  have hrem : rBound j m B Cs CV (j + 3) A * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)
      * (2 * R) ≤ (1 + 40 * Cs * CV) * B * (2 : ℝ) ^ (-(l : ℤ)) := by
    rw [hAdef, hRdef]
    exact rem_bound_closed j m l hBnn hCsnn hCVnn
  -- combine in `ℝ≥0∞`
  have hb1 : ENNReal.ofReal (Real.sqrt ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        (2 * (B * (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ)))) / A
          + 8 * (B * (2 * (Cs * (2 * CV * (2 : ℝ) ^ (-(j : ℤ)))))) / A ^ 2)) * Ng
      ≤ ENNReal.ofReal ((1 + 32 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ))) * Ng :=
    mul_le_mul' (ENNReal.ofReal_le_ofReal hmain) (le_refl _)
  have hb2 : ENNReal.ofReal (rBound j m B Cs CV (j + 3) A *
        (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
      * ((volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ) * Ng)
      ≤ ENNReal.ofReal ((1 + 40 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ))) * Ng := by
    have hstep1 : ENNReal.ofReal (rBound j m B Cs CV (j + 3) A *
          (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
        * ((volume (Metric.closedBall (0 : Pl) R)) ^ (2⁻¹ : ℝ) * Ng)
        ≤ ENNReal.ofReal (rBound j m B Cs CV (j + 3) A *
            (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
          * (ENNReal.ofReal (2 * R) * Ng) :=
      mul_le_mul' (le_refl _) (mul_le_mul' (ofReal_ball_sqrt hRnn) (le_refl _))
    refine le_trans hstep1 ?_
    have hrnn : 0 ≤ rBound j m B Cs CV (j + 3) A *
        (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) := by
      have hApos : (0 : ℝ) < A := by rw [hAdef]; positivity
      have hrb : 0 ≤ rBound j m B Cs CV (j + 3) A :=
        rBound_nonneg hBnn hCsnn hCVnn (j + 3) hApos
      positivity
    have hmerge : ENNReal.ofReal (rBound j m B Cs CV (j + 3) A *
          (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) * (ENNReal.ofReal (2 * R) * Ng)
        = ENNReal.ofReal (rBound j m B Cs CV (j + 3) A *
            (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) * (2 * R)) * Ng := by
      rw [← mul_assoc, ← ENNReal.ofReal_mul hrnn]
    rw [hmerge]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
    have hc : 0 ≤ (1 + 40 * Cs * CV) * B := by positivity
    have hp : (0 : ℝ) ≤ (2 : ℝ) ^ (-(l : ℤ)) := by positivity
    have hmulSq : (1 + 40 * Cs * CV) * B ≤ (1 + 40 * Cs * CV) * B * Sq := by
      nlinarith [hSq1, hc]
    refine le_trans hrem ?_
    exact mul_le_mul_of_nonneg_right hmulSq hp
  refine le_trans (mul_le_mul' (le_refl (2 : ℝ≥0∞))
    (mul_le_mul' (le_refl _) (add_le_add hb1 hb2))) ?_
  -- final numeric merge
  have hsum : ENNReal.ofReal ((1 + 32 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ))) * Ng
      + ENNReal.ofReal ((1 + 40 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ))) * Ng
      = ENNReal.ofReal ((2 + 72 * Cs * CV) * B * Sq * (2 : ℝ) ^ (-(l : ℤ))) * Ng := by
    rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
    congr 2
    ring
  rw [hsum]
  have htwo : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := by simp
  rw [htwo, ← mul_assoc, ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2), ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity)]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal (le_of_eq ?_)) (le_refl _)
  have hpi : Real.pi ≠ 0 := Real.pi_ne_zero
  field_simp

end OffdiagKernel


/-! ### Localization of the partial Fourier transform -/

section GfLocal

/-- If `F` is supported where `ρ₁ ≤ ‖y - z‖ ≤ ρ₂` then the partial Fourier transform of the
sheared function is supported in the annulus `ρ₁ ≤ ‖w‖ ≤ ρ₂`. -/
theorem Gf_eq_zero_of_localized {F : SchwartzMap Pl2 ℂ} {r1 r2 : ℝ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → r1 ≤ ‖y - z‖ ∧ ‖y - z‖ ≤ r2)
    (ξ : Pl) {w : Pl} (hw : ¬ (r1 ≤ ‖w‖ ∧ ‖w‖ ≤ r2)) :
    Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w = 0 := by
  have hzero : ∀ y : Pl, (shearSchwartz F : Pl2 → ℂ) (pr y w) = 0 := by
    intro y
    by_contra hne
    have hval : (shearSchwartz F : Pl2 → ℂ) (pr y w) = (F : Pl2 → ℂ) (pr y (y - w)) := by
      rw [shearSchwartz_apply, shearCLE_pr]
    rw [hval] at hne
    have h := hF y (y - w) hne
    rw [show y - (y - w) = w by abel] at h
    exact hw h
  rw [Gf_eq_integral]
  have hpt : ∀ y : Pl, ee (inner ℝ y ξ) * (shearSchwartz F : Pl2 → ℂ) (pr y w) = 0 := by
    intro y
    rw [hzero y, mul_zero]
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_zero]

theorem Gf_low {F : SchwartzMap Pl2 ℂ} {r1 r2 : ℝ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → r1 ≤ ‖y - z‖ ∧ ‖y - z‖ ≤ r2)
    (ξ : Pl) {w : Pl} (hz : Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w ≠ 0) : r1 ≤ ‖w‖ := by
  by_contra hcon
  exact hz (Gf_eq_zero_of_localized hF ξ (fun h => hcon h.1))

theorem Gf_high {F : SchwartzMap Pl2 ℂ} {r1 r2 : ℝ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → r1 ≤ ‖y - z‖ ∧ ‖y - z‖ ≤ r2)
    (ξ : Pl) {w : Pl} (hz : Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w ≠ 0) : ‖w‖ ≤ r2 := by
  by_contra hcon
  exact hz (Gf_eq_zero_of_localized hF ξ (fun h => hcon h.2))

/-- The partial Fourier transform is jointly measurable. -/
theorem stronglyMeasurable_Gf_pair (H : SchwartzMap Pl2 ℂ) :
    StronglyMeasurable fun p : Pl × Pl => Gf (H : Pl2 → ℂ) p.1 p.2 := by
  have hcont : Continuous fun q : (Pl × Pl) × Pl =>
      ee (inner ℝ q.2 q.1.1) * (H : Pl2 → ℂ) (pr q.2 q.1.2) := by
    have h1 : Continuous fun q : (Pl × Pl) × Pl => ee (inner ℝ q.2 q.1.1) :=
      continuous_ee.comp (continuous_snd.inner (continuous_fst.comp continuous_fst))
    have h2 : Continuous fun q : (Pl × Pl) × Pl => (H : Pl2 → ℂ) (pr q.2 q.1.2) :=
      H.continuous.comp (continuous_prPair.comp
        (continuous_snd.prodMk (continuous_snd.comp continuous_fst)))
    exact h1.mul h2
  have h := hcont.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure Pl))
  have hfun : (fun p : Pl × Pl => ∫ y : Pl, ee (inner ℝ y p.1) * (H : Pl2 → ℂ) (pr y p.2))
      = fun p : Pl × Pl => Gf (H : Pl2 → ℂ) p.1 p.2 := by
    funext p
    rw [Gf_eq_integral]
  rw [← hfun]
  exact h

end GfLocal


/-! ## §4.4  The off-diagonal estimate for `S[F,b]` -/

section OffdiagSop

/-- **The off-diagonal estimate of §4.4.**  If `F` is supported where
`2^{l-m+19} ≤ |y - z| ≤ 2^{l-m+21}` and `b` is a `(j,m)`-adapted symbol with
`|b| ≤ B`, `|∂_η b| ≤ B 2^{-(j-m)}`, then
`‖S[F,b](·,t)‖_{L²(ℝ²)} ≤ c B √(2^{3m}) 2^{-l} ‖F‖_{L²(ℝ⁴)}`, the constant being absolute. -/
theorem offdiag_Sop {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (l : ℕ)
    {F : SchwartzMap Pl2 ℂ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 →
      (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 19) ≤ ‖y - z‖ ∧
        ‖y - z‖ ≤ (2 : ℝ) ^ ((l : ℤ) - (m : ℤ) + 21)) :
    (∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (((1 / Real.pi) * (2 + 72 * Cs * CV) * B
            * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-(l : ℤ))) ^ 2)
        * ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hBnn : 0 ≤ B := hB.nonneg
  set C : ℝ := (1 / Real.pi) * (2 + 72 * Cs * CV) * B
      * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-(l : ℤ)) with hCdef
  have hCnn : 0 ≤ C := by
    rw [hCdef]
    have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
    have hs : (0 : ℝ) ≤ Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) := Real.sqrt_nonneg _
    positivity
  -- the pointwise bound in `ξ`
  have hptwise : ∀ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ
      ≤ ENNReal.ofReal C *
        (∫⁻ w : Pl, ‖Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ) := by
    intro ξ
    rcases Set.eq_empty_or_nonempty (SuppSet j m ξ) with hempty | ⟨η₀, hη₀⟩
    · have hb0 : ∀ η : Pl, b t ξ η = 0 := by
        intro η
        refine hB.supp t ξ η ?_
        rw [hempty]
        exact Set.notMem_empty η
      have hS0 : Sop ε b (F : Pl2 → ℂ) ξ t = 0 := by
        rw [Sop, SopK]
        have hpt : ∀ η : Pl,
            phase ε t ξ η * b t ξ η * 𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η) = 0 := by
          intro η
          rw [hb0 η]
          ring
        rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_zero]
      rw [hS0, enorm_zero]
      exact zero_le
    · have hξ : XiData j ξ := xiData_of_mem hη₀
      rw [Sop_eq_integral_w hB ε t ξ F]
      refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
      rw [hCdef]
      exact lintegral_offdiag_kernel hB hCs hCVnn hCV hε ht1 ht2 hξ l
        (measurable_Gf (shearSchwartz F) ξ).aemeasurable
        (fun w hz => Gf_low hF ξ hz) (fun w hz => Gf_high hF ξ hz)
  -- square the pointwise bound
  have hsq : ∀ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (C ^ 2) *
        ∫⁻ w : Pl, ‖Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ) := by
    intro ξ
    have h := ENNReal.rpow_le_rpow (hptwise ξ) (by norm_num : (0 : ℝ) ≤ (2 : ℝ))
    refine le_trans h (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    congr 1
    · rw [ENNReal.ofReal_rpow_of_nonneg hCnn (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
      congr 1
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    · rw [← ENNReal.rpow_mul]
      norm_num
  refine le_trans (lintegral_mono hsq) ?_
  rw [lintegral_const_mul' _ _ (by simp)]
  refine mul_le_mul' (le_refl _) ?_
  -- swap the order of integration and use partial Plancherel
  have hmeas : AEMeasurable
      (Function.uncurry fun ξ w : Pl =>
        ‖Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ))
      ((volume : Measure Pl).prod (volume : Measure Pl)) := by
    have h := (stronglyMeasurable_Gf_pair (shearSchwartz F)).measurable.enorm
    exact (h.pow_const _).aemeasurable
  have hswap := lintegral_lintegral_swap hmeas
  rw [hswap]
  have hGfdef : ∀ w ξ : Pl, Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w
      = 𝓕 (fun y : Pl => (shearSchwartz F : Pl2 → ℂ) (pr y w)) ξ := fun w ξ => rfl
  have hrw : (∫⁻ w : Pl, ∫⁻ ξ : Pl, ‖Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ))
      = ∫⁻ w : Pl, ∫⁻ ξ : Pl,
        ‖𝓕 (fun y : Pl => (shearSchwartz F : Pl2 → ℂ) (pr y w)) ξ‖ₑ ^ (2 : ℝ) := by
    refine lintegral_congr fun w => ?_
    refine lintegral_congr fun ξ => ?_
    rw [hGfdef w ξ]
  rw [hrw, lintegral_partial_plancherel (shearSchwartz F),
    lintegral_enorm_sq_shearSchwartz F]

end OffdiagSop


/-! ## §4.6  The summation over the dyadic separation scales

The geometric series `∑_n 2^{-na}` is `≤ 3/a` for `0 < a ≤ 1`; this is the source of the factor
`(2γ-1)^{-1}` in Proposition 3.1.
-/

section GeomRpow

theorem two_rpow_neg_eq_exp (a : ℝ) : (2 : ℝ) ^ (-a) = Real.exp (-(a * Real.log 2)) := by
  rw [Real.rpow_def_of_pos (by norm_num : (0 : ℝ) < 2)]
  congr 1
  ring

theorem two_rpow_neg_lt_one {a : ℝ} (ha : 0 < a) : (2 : ℝ) ^ (-a) < 1 := by
  rw [two_rpow_neg_eq_exp]
  refine Real.exp_lt_one_iff.mpr ?_
  have hlog : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  nlinarith [ha, hlog]

theorem two_rpow_neg_pos (a : ℝ) : (0 : ℝ) < (2 : ℝ) ^ (-a) := by positivity

/-- `1 - 2^{-a} ≥ a/3` for `0 < a ≤ 1`. -/
theorem one_sub_two_rpow_neg_ge {a : ℝ} (ha : 0 < a) (ha1 : a ≤ 1) :
    a / 3 ≤ 1 - (2 : ℝ) ^ (-a) := by
  have hlog : (0.6931471803 : ℝ) < Real.log 2 := Real.log_two_gt_d9
  have hlog2 : Real.log 2 < 0.6931471808 := Real.log_two_lt_d9
  set x : ℝ := a * Real.log 2 with hx
  have hxpos : 0 < x := by
    rw [hx]
    have : (0 : ℝ) < Real.log 2 := by linarith
    positivity
  have hxle : x ≤ 0.6931471808 := by
    rw [hx]
    nlinarith [ha1, hlog2, hlog, ha]
  have hexp : 1 + x ≤ Real.exp x := by
    have h := Real.add_one_le_exp x
    linarith
  have hexppos : (0 : ℝ) < Real.exp x := Real.exp_pos x
  have hinv : Real.exp (-x) = 1 / Real.exp x := by
    rw [Real.exp_neg, one_div]
  have hle : Real.exp (-x) ≤ 1 / (1 + x) := by
    rw [hinv]
    refine one_div_le_one_div_of_le (by linarith) hexp
  have hstep : 1 - 1 / (1 + x) = x / (1 + x) := by
    field_simp
    ring
  have hfin : a / 3 ≤ x / (1 + x) := by
    rw [div_le_div_iff₀ (by norm_num) (by linarith)]
    rw [hx]
    nlinarith [hlog, hxle, ha, ha1]
  rw [two_rpow_neg_eq_exp, ← hx]
  linarith [hle, hstep, hfin]

/-- The geometric sum `∑_n (2^{-a})^n` is at most `3/a`. -/
theorem tsum_two_rpow_neg_le {a : ℝ} (ha : 0 < a) (ha1 : a ≤ 1) :
    ∑' n : ℕ, ((2 : ℝ) ^ (-a)) ^ n ≤ 3 / a := by
  have hlt : (2 : ℝ) ^ (-a) < 1 := two_rpow_neg_lt_one ha
  have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ (-a) := le_of_lt (two_rpow_neg_pos a)
  rw [tsum_geometric_of_lt_one hnn hlt]
  have hden : a / 3 ≤ 1 - (2 : ℝ) ^ (-a) := one_sub_two_rpow_neg_ge ha ha1
  have hpos : (0 : ℝ) < 1 - (2 : ℝ) ^ (-a) := by linarith
  rw [inv_eq_one_div, div_le_div_iff₀ hpos ha]
  linarith

end GeomRpow


/-! ### The dyadic annuli in the separation variable -/

section DyadicAnn

/-- The dyadic annulus `2^{k+20} ≤ ‖w‖ < 2^{k+21}`, matching the paper's decomposition
`F = ∑_k F_k` with `F_k` supported where `2^k ≤ 2^{-20}|y-z| < 2^{k+1}`. -/
def Ann (k : ℤ) : Set Pl := {w : Pl | (2 : ℝ) ^ (k + 20) ≤ ‖w‖ ∧ ‖w‖ < (2 : ℝ) ^ (k + 21)}

theorem measurableSet_Ann (k : ℤ) : MeasurableSet (Ann k) := by
  have h1 : MeasurableSet {w : Pl | (2 : ℝ) ^ (k + 20) ≤ ‖w‖} :=
    measurableSet_le measurable_const continuous_norm.measurable
  have h2 : MeasurableSet {w : Pl | ‖w‖ < (2 : ℝ) ^ (k + 21)} :=
    measurableSet_lt continuous_norm.measurable measurable_const
  exact h1.inter h2

theorem Ann_disjoint : Pairwise (Function.onFun Disjoint Ann) := by
  intro k k' hne
  refine Set.disjoint_left.mpr ?_
  intro w hw hw'
  rcases lt_or_gt_of_ne hne with hlt | hlt
  · have h1 : ‖w‖ < (2 : ℝ) ^ (k + 21) := hw.2
    have h2 : (2 : ℝ) ^ (k' + 20) ≤ ‖w‖ := hw'.1
    have hstep : (2 : ℝ) ^ (k + 21) ≤ (2 : ℝ) ^ (k' + 20) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    linarith
  · have h1 : ‖w‖ < (2 : ℝ) ^ (k' + 21) := hw'.2
    have h2 : (2 : ℝ) ^ (k + 20) ≤ ‖w‖ := hw.1
    have hstep : (2 : ℝ) ^ (k' + 21) ≤ (2 : ℝ) ^ (k + 20) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    linarith

theorem mem_iUnion_Ann {w : Pl} (hw : w ≠ 0) : w ∈ ⋃ k : ℤ, Ann k := by
  have hpos : (0 : ℝ) < ‖w‖ := norm_pos_iff.mpr hw
  obtain ⟨n, hn⟩ := exists_mem_Ico_zpow hpos (by norm_num : (1 : ℝ) < 2)
  refine Set.mem_iUnion.mpr ⟨n - 20, ?_⟩
  refine ⟨?_, ?_⟩
  · rw [show n - 20 + 20 = n by ring]
    exact hn.1
  · rw [show n - 20 + 21 = n + 1 by ring]
    exact hn.2

theorem iUnion_Ann_ae : (⋃ k : ℤ, Ann k) =ᵐ[(volume : Measure Pl)] Set.univ := by
  have hsub : (Set.univ : Set Pl) \ (⋃ k : ℤ, Ann k) ⊆ {(0 : Pl)} := by
    intro w hw
    by_contra hne
    exact hw.2 (mem_iUnion_Ann (by simpa using hne))
  have hnull : (volume : Measure Pl) ((Set.univ : Set Pl) \ (⋃ k : ℤ, Ann k)) = 0 := by
    refine measure_mono_null hsub ?_
    exact measure_singleton (0 : Pl)
  refine (ae_eq_set).mpr ⟨?_, hnull⟩
  rw [Set.diff_univ]
  exact measure_empty (μ := (volume : Measure Pl))

/-- The `lintegral` over the plane splits into the sum over the dyadic annuli. -/
theorem lintegral_eq_tsum_Ann (f : Pl → ℝ≥0∞) :
    (∫⁻ w : Pl, f w) = ∑' k : ℤ, ∫⁻ w in Ann k, f w := by
  have hstep : (∫⁻ w : Pl, f w) = ∫⁻ w in ⋃ k : ℤ, Ann k, f w := by
    rw [← setLIntegral_univ f]
    exact (setLIntegral_congr iUnion_Ann_ae).symm
  rw [hstep]
  exact lintegral_iUnion measurableSet_Ann Ann_disjoint f

end DyadicAnn


/-! ### The near/far cutoff in the separation variable

A single smooth cutoff in `‖y - z‖²` splits `F` into a near and a far piece, both Schwartz.
-/

section NearFar

/-- The smooth cutoff `sepCut c x = smoothTransition (c ‖y - z‖² - 1)`, as a function of
`x = (y,z) ∈ ℝ⁴`.  It vanishes when `c ‖y-z‖² ≤ 1` and equals `1` when `c ‖y-z‖² ≥ 2`. -/
def sepCut (c : ℝ) (x : Pl2) : ℝ :=
  Real.smoothTransition (c * ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2 - 1)

theorem sepDiff_apply (y z : Pl) :
    (WithLp.ofLp (pr y z)).1 - (WithLp.ofLp (pr y z)).2 = y - z := rfl

/-- The separation map `x = (y,z) ↦ y - z` as a continuous linear map. -/
def sepCLM : Pl2 →L[ℝ] Pl :=
  (ContinuousLinearMap.fst ℝ Pl Pl - ContinuousLinearMap.snd ℝ Pl Pl).comp
    (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl : Pl2 →L[ℝ] Pl × Pl)

@[simp] theorem sepCLM_apply (x : Pl2) :
    sepCLM x = (WithLp.ofLp x).1 - (WithLp.ofLp x).2 := rfl

theorem contDiff_sepDiffSq : ContDiff ℝ (↑(⊤ : ℕ∞))
    fun x : Pl2 => ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2 := by
  have h : (fun x : Pl2 => ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2)
      = fun x : Pl2 => ‖sepCLM x‖ ^ 2 := rfl
  rw [h]
  exact (contDiff_norm_sq ℝ).comp sepCLM.contDiff

theorem contDiff_sepCut (c : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (sepCut c) :=
  contDiff_st.comp ((contDiff_const.mul contDiff_sepDiffSq).sub contDiff_const)

theorem sepCut_nonneg (c : ℝ) (x : Pl2) : 0 ≤ sepCut c x :=
  Real.smoothTransition.nonneg _

theorem sepCut_le_one (c : ℝ) (x : Pl2) : sepCut c x ≤ 1 :=
  Real.smoothTransition.le_one _

theorem sepCut_eq_zero {c : ℝ} {x : Pl2}
    (h : c * ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2 ≤ 1) : sepCut c x = 0 :=
  Real.smoothTransition.zero_of_nonpos (by linarith)

theorem sepCut_eq_one {c : ℝ} {x : Pl2}
    (h : 2 ≤ c * ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2) : sepCut c x = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

theorem hasTemperateGrowth_st : Function.HasTemperateGrowth Real.smoothTransition := by
  refine ⟨contDiff_st, fun n => ?_⟩
  obtain ⟨C, hC1, hC⟩ := exists_st_bound n
  refine ⟨0, C, fun x => ?_⟩
  simpa using hC n (le_refl n) x

theorem hasTemperateGrowth_sepDiffSq :
    Function.HasTemperateGrowth
      fun x : Pl2 => ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2 := by
  have h : (fun x : Pl2 => ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2)
      = (fun v : Pl => ‖v‖ ^ 2) ∘ sepCLM := rfl
  rw [h]
  exact (Function.hasTemperateGrowth_norm_sq Pl).comp sepCLM.hasTemperateGrowth

theorem hasTemperateGrowth_sepCut (c : ℝ) : Function.HasTemperateGrowth (sepCut c) := by
  have h : sepCut c = Real.smoothTransition ∘
      fun x : Pl2 => c * ‖(WithLp.ofLp x).1 - (WithLp.ofLp x).2‖ ^ 2 - 1 := rfl
  rw [h]
  refine hasTemperateGrowth_st.comp ?_
  exact ((Function.HasTemperateGrowth.const c).mul hasTemperateGrowth_sepDiffSq).sub
    (Function.HasTemperateGrowth.const 1)

/-- The far piece `F · sepCut c`, a Schwartz function. -/
def farPart (c : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  SchwartzMap.smulLeftCLM ℂ (sepCut c) F

/-- The near piece `F · (1 - sepCut c)`, a Schwartz function. -/
def nearPart (c : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ := F - farPart c F

theorem farPart_apply (c : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl2) :
    (farPart c F : Pl2 → ℂ) x = (sepCut c x : ℝ) • (F : Pl2 → ℂ) x := by
  rw [farPart]
  exact SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_sepCut c) F x

theorem nearPart_apply (c : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl2) :
    (nearPart c F : Pl2 → ℂ) x
      = (1 - sepCut c x : ℝ) • (F : Pl2 → ℂ) x := by
  rw [nearPart, sub_apply, farPart_apply, sub_smul, one_smul]

theorem add_nearPart_farPart (c : ℝ) (F : SchwartzMap Pl2 ℂ) :
    nearPart c F + farPart c F = F := by
  rw [nearPart]
  abel

/-- The far piece is supported where the separation is large. -/
theorem farPart_support {c : ℝ} {F : SchwartzMap Pl2 ℂ} {y z : Pl}
    (h : (farPart c F : Pl2 → ℂ) (pr y z) ≠ 0) : 1 < c * ‖y - z‖ ^ 2 := by
  by_contra hcon
  refine h ?_
  rw [farPart_apply, sepCut_eq_zero (by rw [sepDiff_apply]; exact not_lt.mp hcon), zero_smul]

/-- The near piece is supported where the separation is small. -/
theorem nearPart_support {c : ℝ} {F : SchwartzMap Pl2 ℂ} {y z : Pl}
    (h : (nearPart c F : Pl2 → ℂ) (pr y z) ≠ 0) : c * ‖y - z‖ ^ 2 < 2 := by
  by_contra hcon
  refine h ?_
  rw [nearPart_apply, sepCut_eq_one (by rw [sepDiff_apply]; exact not_lt.mp hcon)]
  simp

end NearFar


/-! ### The weight `w_γ(y,z) = |y-z|^{-(2γ-1)}` -/

section Weight

/-- The weighted `L²` mass `∫ |F|² |y-z|^{-(2γ-1)}`. -/
def wMass (gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ x : Pl2, ‖F x‖ₑ ^ (2 : ℝ) * ‖sepCLM x‖ₑ ^ (-(2 * gam - 1))

/-- The diagonal `{y = z}` is null in `ℝ⁴`. -/
theorem volume_sepCLM_eq_zero : (volume : Measure Pl2) {x : Pl2 | sepCLM x = 0} = 0 := by
  have hker : {x : Pl2 | sepCLM x = 0} = (LinearMap.ker (sepCLM : Pl2 →ₗ[ℝ] Pl) : Set Pl2) := by
    ext x
    simp [LinearMap.mem_ker]
  have hne : (LinearMap.ker (sepCLM : Pl2 →ₗ[ℝ] Pl)) ≠ ⊤ := by
    intro hcon
    have hmem : (pr (mk2 1 0) 0) ∈ LinearMap.ker (sepCLM : Pl2 →ₗ[ℝ] Pl) := by
      rw [hcon]
      exact Submodule.mem_top
    rw [LinearMap.mem_ker] at hmem
    have hval : (sepCLM : Pl2 →ₗ[ℝ] Pl) (pr (mk2 1 0) 0) = mk2 1 0 := by
      show mk2 1 0 - 0 = mk2 1 0
      rw [sub_zero]
    rw [hval] at hmem
    have h1 : (mk2 1 0 : Pl) 0 = 1 := mk2_apply_zero 1 0
    rw [hmem] at h1
    simp at h1
  rw [hker]
  exact Measure.addHaar_submodule (volume : Measure Pl2) _ hne

/-- The key pointwise inequality behind both weight comparisons. -/
theorem one_le_ofReal_mul_enorm_rpow {gam R : ℝ} (hgam : 1 / 2 < gam) (hR : 0 < R)
    {v : Pl} (hv : ‖v‖ ≤ R) :
    (1 : ℝ≥0∞) ≤ ENNReal.ofReal (R ^ (2 * gam - 1)) * ‖v‖ₑ ^ (-(2 * gam - 1)) := by
  have hexp : (0 : ℝ) < 2 * gam - 1 := by linarith
  have hRpow : (0 : ℝ) < R ^ (2 * gam - 1) := Real.rpow_pos_of_pos hR _
  by_cases hz : v = 0
  · rw [hz]
    have h0 : ‖(0 : Pl)‖ₑ = 0 := by simp
    rw [h0, ENNReal.zero_rpow_of_neg (by linarith)]
    rw [ENNReal.mul_top (by
      simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
      exact hRpow)]
    exact le_top
  · have hpos : (0 : ℝ) < ‖v‖ := norm_pos_iff.mpr hz
    have hvpos : (0 : ℝ) < ‖v‖ ^ (2 * gam - 1) := Real.rpow_pos_of_pos hpos _
    have hmono : ‖v‖ ^ (2 * gam - 1) ≤ R ^ (2 * gam - 1) :=
      Real.rpow_le_rpow hpos.le hv hexp.le
    have hkey : (1 : ℝ) ≤ R ^ (2 * gam - 1) * ‖v‖ ^ (-(2 * gam - 1)) := by
      rw [Real.rpow_neg hpos.le, ← div_eq_mul_inv, le_div_iff₀ hvpos, one_mul]
      exact hmono
    have henorm : ‖v‖ₑ ^ (-(2 * gam - 1)) = ENNReal.ofReal (‖v‖ ^ (-(2 * gam - 1))) := by
      rw [← ofReal_norm, ENNReal.ofReal_rpow_of_pos hpos]
    rw [henorm, ← ENNReal.ofReal_mul (le_of_lt hRpow), ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hkey

/-- On the support of a function localized where the separation is at most `R`, the unweighted
`L²` mass is controlled by the weighted one. -/
theorem lintegral_enorm_sq_le_wMass {gam : ℝ} (hgam : 1 / 2 < gam) {R : ℝ} (hR : 0 < R)
    {G F : Pl2 → ℂ} (hGF : ∀ x, ‖G x‖ ≤ ‖F x‖)
    (hsupp : ∀ x, G x ≠ 0 → ‖sepCLM x‖ ≤ R) :
    (∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (R ^ (2 * gam - 1)) * wMass gam F := by
  have hpt : ∀ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (R ^ (2 * gam - 1)) *
        (‖F x‖ₑ ^ (2 : ℝ) * ‖sepCLM x‖ₑ ^ (-(2 * gam - 1))) := by
    intro x
    by_cases hz : G x = 0
    · rw [hz]
      simp [ENNReal.zero_rpow_of_pos]
    · have hcoef := one_le_ofReal_mul_enorm_rpow hgam hR (hsupp x hz)
      have hGle : ‖G x‖ₑ ^ (2 : ℝ) ≤ ‖F x‖ₑ ^ (2 : ℝ) := by
        refine ENNReal.rpow_le_rpow ?_ (by norm_num)
        rw [← ofReal_norm, ← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hGF x)
      calc ‖G x‖ₑ ^ (2 : ℝ) ≤ ‖F x‖ₑ ^ (2 : ℝ) := hGle
        _ = 1 * ‖F x‖ₑ ^ (2 : ℝ) := by rw [one_mul]
        _ ≤ (ENNReal.ofReal (R ^ (2 * gam - 1)) * ‖sepCLM x‖ₑ ^ (-(2 * gam - 1)))
            * ‖F x‖ₑ ^ (2 : ℝ) := mul_le_mul' hcoef (le_refl _)
        _ = ENNReal.ofReal (R ^ (2 * gam - 1)) *
            (‖F x‖ₑ ^ (2 : ℝ) * ‖sepCLM x‖ₑ ^ (-(2 * gam - 1))) := by ring
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_const_mul' _ _ (by simp), wMass]

end Weight


/-! ### The weight in the separation variable `w` -/

section WeightW

/-- The weighted `L²` mass in the `w`-variable, `∫ |g|² |w|^{-(2γ-1)}`. -/
def wMassW (gam : ℝ) (g : Pl → ℂ) : ℝ≥0∞ :=
  ∫⁻ w : Pl, ‖g w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1))

theorem lintegral_indicator_mul_eq {T : Set Pl} (hT : MeasurableSet T) (g h : Pl → ℂ) :
    (∫⁻ w : Pl, ‖Set.indicator T g w * h w‖ₑ) = ∫⁻ w in T, ‖g w * h w‖ₑ := by
  have hpt : ∀ w : Pl, ‖Set.indicator T g w * h w‖ₑ
      = Set.indicator T (fun w => ‖g w * h w‖ₑ) w := by
    intro w
    by_cases hw : w ∈ T
    · rw [Set.indicator_of_mem hw, Set.indicator_of_mem hw]
    · rw [Set.indicator_of_notMem hw, Set.indicator_of_notMem hw, zero_mul, enorm_zero]
  rw [lintegral_congr hpt, lintegral_indicator hT]

theorem lintegral_indicator_sq_eq {T : Set Pl} (hT : MeasurableSet T) (g : Pl → ℂ) :
    (∫⁻ w : Pl, ‖Set.indicator T g w‖ₑ ^ (2 : ℝ)) = ∫⁻ w in T, ‖g w‖ₑ ^ (2 : ℝ) := by
  have hpt : ∀ w : Pl, ‖Set.indicator T g w‖ₑ ^ (2 : ℝ)
      = Set.indicator T (fun w => ‖g w‖ₑ ^ (2 : ℝ)) w := by
    intro w
    by_cases hw : w ∈ T
    · rw [Set.indicator_of_mem hw, Set.indicator_of_mem hw]
    · rw [Set.indicator_of_notMem hw, Set.indicator_of_notMem hw, enorm_zero]
      simp [ENNReal.zero_rpow_of_pos]
  rw [lintegral_congr hpt, lintegral_indicator hT]

/-- On the dyadic annulus `Ann k` the unweighted `L²` mass is controlled by the weighted one. -/
theorem lintegral_sq_ann_le_wMassW {gam : ℝ} (hgam : 1 / 2 < gam) (k : ℤ) (g : Pl → ℂ) :
    (∫⁻ w in Ann k, ‖g w‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (((2 : ℝ) ^ (k + 21)) ^ (2 * gam - 1)) * wMassW gam g := by
  have hRpos : (0 : ℝ) < (2 : ℝ) ^ (k + 21) := by positivity
  have hpt : ∀ w ∈ Ann k, ‖g w‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (((2 : ℝ) ^ (k + 21)) ^ (2 * gam - 1)) *
        (‖g w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1))) := by
    intro w hw
    have hhigh : ‖w‖ ≤ (2 : ℝ) ^ (k + 21) := le_of_lt hw.2
    have hcoef := one_le_ofReal_mul_enorm_rpow hgam hRpos hhigh
    calc ‖g w‖ₑ ^ (2 : ℝ) = 1 * ‖g w‖ₑ ^ (2 : ℝ) := by rw [one_mul]
      _ ≤ (ENNReal.ofReal (((2 : ℝ) ^ (k + 21)) ^ (2 * gam - 1)) *
          ‖w‖ₑ ^ (-(2 * gam - 1))) * ‖g w‖ₑ ^ (2 : ℝ) := mul_le_mul' hcoef (le_refl _)
      _ = ENNReal.ofReal (((2 : ℝ) ^ (k + 21)) ^ (2 * gam - 1)) *
          (‖g w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1))) := by ring
  refine le_trans (setLIntegral_mono' (measurableSet_Ann k) hpt) ?_
  rw [lintegral_const_mul' _ _ (by simp)]
  refine mul_le_mul' (le_refl _) ?_
  rw [wMassW]
  exact setLIntegral_le_lintegral _ _

end WeightW


/-! ### The far part, annulus by annulus -/

section FarAnn

/-- The off-diagonal estimate on the annulus `Ann (l+1-m)`, with the weight brought in. -/
theorem lintegral_ann_offdiag_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ)
    {gam : ℝ} (hgam : 1 / 2 < gam)
    {g : Pl → ℂ} (hg : AEMeasurable g (volume : Measure Pl)) (l : ℕ) :
    (∫⁻ w in Ann ((l : ℤ) + 1 - (m : ℤ)),
        ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ ENNReal.ofReal ((1 / Real.pi) * (2 + 72 * Cs * CV) * B
            * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) * (2 : ℝ) ^ (-((l : ℤ) + 1)))
          * ENNReal.ofReal ((((2 : ℝ) ^ ((l : ℤ) + 1 - (m : ℤ) + 21)) ^ ((2 * gam - 1) / 2)))
          * (wMassW gam g) ^ (2⁻¹ : ℝ) := by
  set k : ℤ := (l : ℤ) + 1 - (m : ℤ) with hk
  set gi : Pl → ℂ := Set.indicator (Ann k) g with hgi
  have hgim : AEMeasurable gi (volume : Measure Pl) := hg.indicator (measurableSet_Ann k)
  have hlow : ∀ w : Pl, gi w ≠ 0 → (2 : ℝ) ^ (((l + 1 : ℕ) : ℤ) - (m : ℤ) + 19) ≤ ‖w‖ := by
    intro w hz
    have hmem : w ∈ Ann k := by
      by_contra hw
      rw [hgi, Set.indicator_of_notMem hw] at hz
      exact hz rfl
    refine le_trans ?_ hmem.1
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    rw [hk]
    push_cast
    omega
  have hhigh : ∀ w : Pl, gi w ≠ 0 → ‖w‖ ≤ (2 : ℝ) ^ (((l + 1 : ℕ) : ℤ) - (m : ℤ) + 21) := by
    intro w hz
    have hmem : w ∈ Ann k := by
      by_contra hw
      rw [hgi, Set.indicator_of_notMem hw] at hz
      exact hz rfl
    refine le_trans (le_of_lt hmem.2) ?_
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    rw [hk]
    push_cast
    omega
  have hkernel := lintegral_offdiag_kernel hB hCs hCVnn hCV hε ht1 ht2 hξ (l + 1)
    hgim hlow hhigh
  have hrw : (∫⁻ w : Pl, ‖gi w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      = ∫⁻ w in Ann k, ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ := by
    rw [hgi]
    exact lintegral_indicator_mul_eq (measurableSet_Ann k) g _
  rw [hrw] at hkernel
  refine le_trans hkernel ?_
  -- bring in the weight
  have hsq : (∫⁻ w : Pl, ‖gi w‖ₑ ^ (2 : ℝ)) = ∫⁻ w in Ann k, ‖g w‖ₑ ^ (2 : ℝ) := by
    rw [hgi]
    exact lintegral_indicator_sq_eq (measurableSet_Ann k) g
  rw [hsq]
  have hwt := lintegral_sq_ann_le_wMassW hgam k g
  have hstep : (∫⁻ w in Ann k, ‖g w‖ₑ ^ (2 : ℝ)) ^ (2⁻¹ : ℝ)
      ≤ (ENNReal.ofReal (((2 : ℝ) ^ (k + 21)) ^ (2 * gam - 1)) * wMassW gam g) ^ (2⁻¹ : ℝ) :=
    ENNReal.rpow_le_rpow hwt (by norm_num)
  refine le_trans (mul_le_mul' (le_refl _) hstep) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ (2⁻¹ : ℝ))]
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by norm_num : (0 : ℝ) ≤ (2⁻¹ : ℝ))]
  rw [← mul_assoc]
  congr 2
  congr 1
  rw [← Real.rpow_mul (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ (k + 21)),
    show (2 * gam - 1) * 2⁻¹ = (2 * gam - 1) / 2 by ring]

end FarAnn


/-! ### The far part, summed over the annuli -/

section FarSum

/-- The coefficient of the `l`-th far annulus. -/
def coefFar (m : ℕ) (B Cs CV gam : ℝ) (l : ℕ) : ℝ :=
  (1 / Real.pi) * (2 + 72 * Cs * CV) * B * Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ)))
    * (2 : ℝ) ^ (-((l : ℤ) + 1))
    * (((2 : ℝ) ^ ((l : ℤ) + 1 - (m : ℤ) + 21)) ^ ((2 * gam - 1) / 2))

theorem coefFar_nonneg {m : ℕ} {B Cs CV gam : ℝ} (hB : 0 ≤ B) (hCs : 0 ≤ Cs)
    (hCV : 0 ≤ CV) (l : ℕ) : 0 ≤ coefFar m B Cs CV gam l := by
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hs : (0 : ℝ) ≤ Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) := Real.sqrt_nonneg _
  rw [coefFar]
  positivity

/-- **The far part of §4.6.**  If `g` vanishes where `‖w‖ < 2^{21-m}`, the `w`-integral is bounded
by the sum of the annulus contributions. -/
theorem lintegral_offdiag_far {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ)
    {gam : ℝ} (hgam : 1 / 2 < gam)
    {g : Pl → ℂ} (hg : AEMeasurable g (volume : Measure Pl))
    (hglow : ∀ w : Pl, g w ≠ 0 → (2 : ℝ) ^ (21 - (m : ℤ)) ≤ ‖w‖) :
    (∫⁻ w : Pl, ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ (∑' l : ℕ, ENNReal.ofReal (coefFar m B Cs CV gam l))
        * (wMassW gam g) ^ (2⁻¹ : ℝ) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hBnn : 0 ≤ B := hB.nonneg
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hsq : (0 : ℝ) ≤ Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) := Real.sqrt_nonneg _
  set h : Pl → ℂ := fun w => ∫ η : Pl, oscph j ε t ξ w η * b t ξ η with hhdef
  set f : ℤ → ℝ≥0∞ := fun k => ∫⁻ w in Ann k, ‖g w * h w‖ₑ with hfdef
  set i : ℕ → ℤ := fun l => (l : ℤ) + 1 - (m : ℤ) with hidef
  have hinj : Function.Injective i := by
    intro a c hac
    rw [hidef] at hac
    simp only at hac
    have : (a : ℤ) = (c : ℤ) := by omega
    exact_mod_cast this
  have hzero : ∀ k : ℤ, k ∉ Set.range i → f k = 0 := by
    intro k hk
    have hkle : k ≤ -(m : ℤ) := by
      by_contra hcon
      push_neg at hcon
      have hnn : (0 : ℤ) ≤ k + (m : ℤ) - 1 := by omega
      refine hk ⟨(k + (m : ℤ) - 1).toNat, ?_⟩
      rw [hidef]
      simp only
      rw [Int.toNat_of_nonneg hnn]
      ring
    have hg0 : ∀ w ∈ Ann k, g w = 0 := by
      intro w hw
      by_contra hne
      have h1 := hglow w hne
      have h2 : ‖w‖ < (2 : ℝ) ^ (k + 21) := hw.2
      have h3 : (2 : ℝ) ^ (k + 21) ≤ (2 : ℝ) ^ (21 - (m : ℤ)) :=
        zpow_le_zpow_right₀ (by norm_num) (by omega)
      linarith
    have hcongr : (∫⁻ w in Ann k, ‖g w * h w‖ₑ) = ∫⁻ _w in Ann k, (0 : ℝ≥0∞) := by
      refine setLIntegral_congr_fun (measurableSet_Ann k) ?_
      intro w hw
      show ‖g w * h w‖ₑ = 0
      rw [hg0 w hw, zero_mul, enorm_zero]
    rw [hfdef]
    simp only
    rw [hcongr, lintegral_zero]
  have hsupp : Function.support f ⊆ Set.range i := by
    intro k hk
    by_contra hcon
    exact hk (hzero k hcon)
  rw [lintegral_eq_tsum_Ann, ← hinj.tsum_eq hsupp]
  have hterm : ∀ l : ℕ, f (i l)
      ≤ ENNReal.ofReal (coefFar m B Cs CV gam l) * (wMassW gam g) ^ (2⁻¹ : ℝ) := by
    intro l
    have hbase := lintegral_ann_offdiag_le hB hCs hCVnn hCV hε ht1 ht2 hξ hgam hg l
    have harg : i l = (l : ℤ) + 1 - (m : ℤ) := rfl
    rw [hfdef]
    simp only
    rw [harg]
    refine le_trans hbase (le_of_eq ?_)
    rw [coefFar, ← ENNReal.ofReal_mul (by positivity)]
  refine le_trans (ENNReal.tsum_le_tsum hterm) (le_of_eq ?_)
  rw [ENNReal.tsum_mul_right]

end FarSum


/-! ### The closed form of the far coefficient sum -/

section FarConst

theorem two_zpow_rpow (K : ℤ) (a : ℝ) : ((2 : ℝ) ^ K) ^ a = (2 : ℝ) ^ ((K : ℝ) * a) := by
  rw [← Real.rpow_intCast (2 : ℝ) K, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]

theorem two_zpow_eq_rpow (K : ℤ) : (2 : ℝ) ^ K = (2 : ℝ) ^ ((K : ℝ)) := by
  rw [Real.rpow_intCast]

theorem sqrt_two_zpow_eq_rpow (K : ℤ) :
    Real.sqrt ((2 : ℝ) ^ K) = (2 : ℝ) ^ ((K : ℝ) / 2) := by
  rw [Real.sqrt_eq_rpow, two_zpow_rpow]
  congr 1
  ring

/-- `coefFar` written as a single dyadic power. -/
theorem coefFar_eq (m : ℕ) (B Cs CV gam : ℝ) (l : ℕ) :
    coefFar m B Cs CV gam l
      = ((1 / Real.pi) * (2 + 72 * Cs * CV) * B) *
        (2 : ℝ) ^ ((3 * (m : ℝ) / 2 + (21 - (m : ℝ)) * ((2 * gam - 1) / 2))
          - ((l : ℝ) + 1) * (1 - (2 * gam - 1) / 2)) := by
  have h1 : Real.sqrt ((2 : ℝ) ^ (3 * (m : ℤ))) = (2 : ℝ) ^ (3 * (m : ℝ) / 2) := by
    rw [sqrt_two_zpow_eq_rpow]
    congr 1
    push_cast
    ring
  have h2 : (2 : ℝ) ^ (-((l : ℤ) + 1)) = (2 : ℝ) ^ (-((l : ℝ) + 1)) := by
    rw [two_zpow_eq_rpow]
    congr 1
    push_cast
    ring
  have h3 : (((2 : ℝ) ^ ((l : ℤ) + 1 - (m : ℤ) + 21)) ^ ((2 * gam - 1) / 2))
      = (2 : ℝ) ^ (((l : ℝ) + 1 - (m : ℝ) + 21) * ((2 * gam - 1) / 2)) := by
    rw [two_zpow_rpow]
    congr 1
    push_cast
    ring
  rw [coefFar, h1, h2, h3]
  rw [show ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (3 * (m : ℝ) / 2)
        * (2 : ℝ) ^ (-((l : ℝ) + 1))
        * (2 : ℝ) ^ (((l : ℝ) + 1 - (m : ℝ) + 21) * ((2 * gam - 1) / 2)))
      = ((1 / Real.pi) * (2 + 72 * Cs * CV) * B) *
        ((2 : ℝ) ^ (3 * (m : ℝ) / 2) * (2 : ℝ) ^ (-((l : ℝ) + 1))
          * (2 : ℝ) ^ (((l : ℝ) + 1 - (m : ℝ) + 21) * ((2 * gam - 1) / 2))) from by ring]
  congr 1
  rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2),
    ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  congr 1
  ring

theorem tsum_coefFar_le {m : ℕ} {B Cs CV gam : ℝ} (hBnn : 0 ≤ B) (hCsnn : 0 ≤ Cs)
    (hCVnn : 0 ≤ CV) (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1) :
    (∑' l : ℕ, ENNReal.ofReal (coefFar m B Cs CV gam l))
      ≤ ENNReal.ofReal (6 * ((1 / Real.pi) * (2 + 72 * Cs * CV)) * (2 : ℝ) ^ ((21 : ℝ) / 2)
          * B * (2 : ℝ) ^ ((m : ℝ) * (2 - gam))) := by
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have hKnn : (0 : ℝ) ≤ (1 / Real.pi) * (2 + 72 * Cs * CV) * B := by positivity
  set a : ℝ := (2 * gam - 1) / 2 with hadef
  have ha0 : 0 < a := by rw [hadef]; linarith
  set r : ℝ := 1 - a with hrdef
  have hr0 : 0 < r := by rw [hrdef, hadef]; linarith
  have hr1 : r ≤ 1 := by rw [hrdef]; linarith
  set D : ℝ := 3 * (m : ℝ) / 2 + (21 - (m : ℝ)) * a with hDdef
  have hDrnn : (0 : ℝ) ≤ (2 : ℝ) ^ (D - r) :=
    le_of_lt (Real.rpow_pos_of_pos (by norm_num) _)
  -- each term as a geometric term
  have hcf : ∀ l : ℕ, coefFar m B Cs CV gam l
      = ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
        * ((2 : ℝ) ^ (-r)) ^ l := by
    intro l
    have hpow : ((2 : ℝ) ^ (-r)) ^ l = (2 : ℝ) ^ (-r * (l : ℝ)) := by
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (-r)) l,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    rw [coefFar_eq, hpow]
    rw [show ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
          * (2 : ℝ) ^ (-r * (l : ℝ))
        = ((1 / Real.pi) * (2 + 72 * Cs * CV) * B)
          * ((2 : ℝ) ^ (D - r) * (2 : ℝ) ^ (-r * (l : ℝ))) from by ring,
      ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
    congr 1
    rw [hDdef, hrdef, hadef]
    ring
  -- sum the geometric series
  have hgeo : ∑' l : ℕ, ((2 : ℝ) ^ (-r)) ^ l ≤ 3 / r := tsum_two_rpow_neg_le hr0 hr1
  have hsummable : Summable fun l : ℕ => ((2 : ℝ) ^ (-r)) ^ l := by
    refine summable_geometric_of_lt_one (le_of_lt (two_rpow_neg_pos r)) ?_
    exact two_rpow_neg_lt_one hr0
  have hnn : ∀ l : ℕ,
      0 ≤ ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
        * ((2 : ℝ) ^ (-r)) ^ l := by
    intro l
    have h1 : (0 : ℝ) ≤ ((2 : ℝ) ^ (-r)) ^ l := by positivity
    have h2 : (0 : ℝ) ≤ (1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r) := by
      positivity
    positivity
  have hsummable2 : Summable fun l : ℕ =>
      ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
        * ((2 : ℝ) ^ (-r)) ^ l := hsummable.mul_left _
  have hstep : (∑' l : ℕ, ENNReal.ofReal (coefFar m B Cs CV gam l))
      ≤ ENNReal.ofReal (((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
        * (3 / r)) := by
    calc (∑' l : ℕ, ENNReal.ofReal (coefFar m B Cs CV gam l))
        = ∑' l : ℕ, ENNReal.ofReal
            (((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
              * ((2 : ℝ) ^ (-r)) ^ l) := by
          refine tsum_congr fun l => ?_
          rw [hcf l]
      _ = ENNReal.ofReal (∑' l : ℕ,
            ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
              * ((2 : ℝ) ^ (-r)) ^ l) := by
          rw [ENNReal.ofReal_tsum_of_nonneg hnn hsummable2]
      _ ≤ ENNReal.ofReal (((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
            * (3 / r)) := by
          refine ENNReal.ofReal_le_ofReal ?_
          rw [tsum_mul_left]
          refine mul_le_mul_of_nonneg_left hgeo ?_
          positivity
  refine le_trans hstep (ENNReal.ofReal_le_ofReal ?_)
  -- the numeric comparison
  have h3r : 3 / r ≤ 6 := by
    rw [div_le_iff₀ hr0, hrdef, hadef]
    linarith
  have hDr : (2 : ℝ) ^ (D - r)
      ≤ (2 : ℝ) ^ ((21 : ℝ) / 2) * (2 : ℝ) ^ ((m : ℝ) * (2 - gam)) := by
    rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    rw [hDdef, hrdef, hadef]
    have hm : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
    nlinarith [hgam1, hgam2, hm]
  have hpos2 : (0 : ℝ) ≤ (2 : ℝ) ^ ((21 : ℝ) / 2) * (2 : ℝ) ^ ((m : ℝ) * (2 - gam)) := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ ((21 : ℝ) / 2) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < (2 : ℝ) ^ ((m : ℝ) * (2 - gam)) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  have hfin1 : ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r)) * (3 / r)
      ≤ ((1 / Real.pi) * (2 + 72 * Cs * CV) * B *
        ((2 : ℝ) ^ ((21 : ℝ) / 2) * (2 : ℝ) ^ ((m : ℝ) * (2 - gam)))) * 6 := by
    have hA : ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r))
        ≤ ((1 / Real.pi) * (2 + 72 * Cs * CV) * B *
          ((2 : ℝ) ^ ((21 : ℝ) / 2) * (2 : ℝ) ^ ((m : ℝ) * (2 - gam)))) :=
      mul_le_mul_of_nonneg_left hDr hKnn
    have hAnn : (0 : ℝ) ≤ ((1 / Real.pi) * (2 + 72 * Cs * CV) * B * (2 : ℝ) ^ (D - r)) := by
      positivity
    nlinarith [hA, hAnn, h3r, hr0]
  refine le_trans hfin1 (le_of_eq ?_)
  ring

/-- **The far part of §4.6 in closed form.** -/
theorem lintegral_offdiag_far_closed {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {ξ : Pl} (hξ : XiData j ξ)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {g : Pl → ℂ} (hg : AEMeasurable g (volume : Measure Pl))
    (hglow : ∀ w : Pl, g w ≠ 0 → (2 : ℝ) ^ (21 - (m : ℤ)) ≤ ‖w‖) :
    (∫⁻ w : Pl, ‖g w * (∫ η : Pl, oscph j ε t ξ w η * b t ξ η)‖ₑ)
      ≤ ENNReal.ofReal (6 * ((1 / Real.pi) * (2 + 72 * Cs * CV))
            * (2 : ℝ) ^ ((21 : ℝ) / 2) * B * (2 : ℝ) ^ ((m : ℝ) * (2 - gam)))
        * (wMassW gam g) ^ (2⁻¹ : ℝ) := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  refine le_trans (lintegral_offdiag_far hB hCs hCVnn hCV hε ht1 ht2 hξ hgam1 hg hglow) ?_
  exact mul_le_mul' (tsum_coefFar_le hB.nonneg hCsnn hCVnn hgam1 hgam2) (le_refl _)

end FarConst


/-! ### One-sided localization and the weighted partial Plancherel -/

section WeightedPlancherel

/-- The one-sided version of `Gf_eq_zero_of_localized`. -/
theorem Gf_eq_zero_of_low {F : SchwartzMap Pl2 ℂ} {r1 : ℝ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → r1 ≤ ‖y - z‖)
    (ξ : Pl) {w : Pl} (hw : ¬ (r1 ≤ ‖w‖)) :
    Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w = 0 := by
  have hzero : ∀ y : Pl, (shearSchwartz F : Pl2 → ℂ) (pr y w) = 0 := by
    intro y
    by_contra hne
    have hval : (shearSchwartz F : Pl2 → ℂ) (pr y w) = (F : Pl2 → ℂ) (pr y (y - w)) := by
      rw [shearSchwartz_apply, shearCLE_pr]
    rw [hval] at hne
    have h := hF y (y - w) hne
    rw [show y - (y - w) = w by abel] at h
    exact hw h
  rw [Gf_eq_integral]
  have hpt : ∀ y : Pl, ee (inner ℝ y ξ) * (shearSchwartz F : Pl2 → ℂ) (pr y w) = 0 := by
    intro y
    rw [hzero y, mul_zero]
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_zero]

theorem Gf_low' {F : SchwartzMap Pl2 ℂ} {r1 : ℝ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → r1 ≤ ‖y - z‖)
    (ξ : Pl) {w : Pl} (hz : Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w ≠ 0) : r1 ≤ ‖w‖ := by
  by_contra hcon
  exact hz (Gf_eq_zero_of_low hF ξ hcon)

theorem sepCLM_shearCLE (x : Pl2) : ‖sepCLM (shearCLE x)‖ = ‖(WithLp.ofLp x).2‖ := by
  have hx : x = pr (WithLp.ofLp x).1 (WithLp.ofLp x).2 := rfl
  rw [hx, shearCLE_pr, sepCLM_apply]
  show ‖(WithLp.ofLp x).1 - ((WithLp.ofLp x).1 - (WithLp.ofLp x).2)‖ = ‖(WithLp.ofLp x).2‖
  congr 1
  abel

theorem enorm_sepCLM_shearCLE (x : Pl2) :
    ‖sepCLM (shearCLE x)‖ₑ = ‖(WithLp.ofLp x).2‖ₑ := by
  rw [← ofReal_norm, ← ofReal_norm, sepCLM_shearCLE]

/-- **The weighted partial Plancherel identity.**  Integrating the `w`-weighted `L²` mass of the
partial Fourier transform over `ξ` recovers the weighted `L²` mass of `F`. -/
theorem lintegral_wMassW_Gf (gam : ℝ) (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ ξ : Pl, wMassW gam fun w => Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w)
      = wMass gam F := by
  set H : SchwartzMap Pl2 ℂ := shearSchwartz F with hH
  have hCmeas : Measurable fun w : Pl => ‖w‖ₑ ^ (-(2 * gam - 1)) :=
    (ENNReal.continuous_rpow_const).measurable.comp measurable_enorm
  -- step 1: swap the order of integration
  have hmeas : AEMeasurable
      (Function.uncurry fun ξ w : Pl =>
        ‖Gf ((H : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)))
      ((volume : Measure Pl).prod (volume : Measure Pl)) := by
    have h1 : Measurable fun p : Pl × Pl => ‖Gf ((H : Pl2 → ℂ)) p.1 p.2‖ₑ ^ (2 : ℝ) :=
      ((stronglyMeasurable_Gf_pair H).measurable.enorm).pow_const _
    exact (h1.mul (hCmeas.comp measurable_snd)).aemeasurable
  have hstep1 : (∫⁻ ξ : Pl, wMassW gam fun w => Gf ((H : Pl2 → ℂ)) ξ w)
      = ∫⁻ w : Pl, ∫⁻ ξ : Pl,
        ‖Gf ((H : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)) := by
    rw [← lintegral_lintegral_swap hmeas]
    refine lintegral_congr fun ξ => ?_
    rw [wMassW]
  -- step 2: Plancherel in `ξ` for each fixed `w`
  have hinner : ∀ w : Pl,
      (∫⁻ ξ : Pl, ‖Gf ((H : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)))
      = ∫⁻ y : Pl, ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)) := by
    intro w
    have hm1 : Measurable fun ξ : Pl => ‖Gf ((H : Pl2 → ℂ)) ξ w‖ₑ ^ (2 : ℝ) := by
      have h := (stronglyMeasurable_Gf_pair H).measurable.enorm
      exact ((h.comp (measurable_id.prodMk measurable_const)).pow_const _)
    have hm2 : Measurable fun y : Pl => ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) := by
      have hp : Measurable fun y : Pl => (pr y w : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp
          (measurable_id.prodMk measurable_const)
      exact (((H.continuous.measurable).comp hp).enorm).pow_const _
    rw [lintegral_mul_const _ hm1, lintegral_mul_const _ hm2]
    congr 1
    exact lintegral_enorm_sq_fourier_schwartz_Pl (sliceSchwartz H w)
  rw [hstep1, lintegral_congr hinner]
  -- step 3: assemble into an integral over `ℝ⁴`
  have hmeas2 : Measurable fun x : Pl2 =>
      ‖(H : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) * ‖(WithLp.ofLp x).2‖ₑ ^ (-(2 * gam - 1)) := by
    have h1 : Measurable fun x : Pl2 => ‖(H : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) :=
      ((H.continuous.measurable).enorm).pow_const _
    have h2 : Measurable fun x : Pl2 => ‖(WithLp.ofLp x).2‖ₑ ^ (-(2 * gam - 1)) :=
      hCmeas.comp ((WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).continuous.snd).measurable
    exact h1.mul h2
  have hswap2 : (∫⁻ w : Pl, ∫⁻ y : Pl,
        ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)))
      = ∫⁻ y : Pl, ∫⁻ w : Pl,
        ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)) := by
    have hm : AEMeasurable
        (Function.uncurry fun w y : Pl =>
          ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)))
        ((volume : Measure Pl).prod (volume : Measure Pl)) := by
      have h1 : Measurable fun q : Pl × Pl => ‖(H : Pl2 → ℂ) (pr q.2 q.1)‖ₑ ^ (2 : ℝ) := by
        have hp : Measurable fun q : Pl × Pl => (pr q.2 q.1 : Pl2) :=
          (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp
            (measurable_snd.prodMk measurable_fst)
        exact (((H.continuous.measurable).comp hp).enorm).pow_const _
      exact (h1.mul (hCmeas.comp measurable_fst)).aemeasurable
    exact lintegral_lintegral_swap hm
  have hconv : (∫⁻ y : Pl, ∫⁻ w : Pl,
        ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ) * ‖w‖ₑ ^ (-(2 * gam - 1)))
      = ∫⁻ y : Pl, ∫⁻ w : Pl,
        ‖(H : Pl2 → ℂ) (pr y w)‖ₑ ^ (2 : ℝ)
          * ‖(WithLp.ofLp (pr y w)).2‖ₑ ^ (-(2 * gam - 1)) := rfl
  rw [hswap2, hconv, lintegral_pr _ hmeas2]
  -- step 4: undo the shear
  have hpt : ∀ x : Pl2, ‖(H : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) * ‖(WithLp.ofLp x).2‖ₑ ^ (-(2 * gam - 1))
      = (fun u : Pl2 => ‖(F : Pl2 → ℂ) u‖ₑ ^ (2 : ℝ)
          * ‖sepCLM u‖ₑ ^ (-(2 * gam - 1))) (shearCLE x) := by
    intro x
    rw [hH, shearSchwartz_apply]
    congr 2
    exact (enorm_sepCLM_shearCLE x).symm
  rw [lintegral_congr hpt]
  have hmeas3 : Measurable fun u : Pl2 => ‖(F : Pl2 → ℂ) u‖ₑ ^ (2 : ℝ)
      * ‖sepCLM u‖ₑ ^ (-(2 * gam - 1)) := by
    have h1 : Measurable fun u : Pl2 => ‖(F : Pl2 → ℂ) u‖ₑ ^ (2 : ℝ) :=
      ((F.continuous.measurable).enorm).pow_const _
    exact h1.mul (hCmeas.comp sepCLM.continuous.measurable)
  rw [lintegral_comp_shear _ hmeas3, wMass]

end WeightedPlancherel


/-! ## §4.6  The far part of `S[F,b]` -/

section OffdiagSopFar

/-- The constant of the far estimate. -/
def CFar (m : ℕ) (B Cs CV gam : ℝ) : ℝ :=
  6 * ((1 / Real.pi) * (2 + 72 * Cs * CV)) * (2 : ℝ) ^ ((21 : ℝ) / 2) * B
    * (2 : ℝ) ^ ((m : ℝ) * (2 - gam))

theorem CFar_nonneg {m : ℕ} {B Cs CV gam : ℝ} (hB : 0 ≤ B) (hCs : 0 ≤ Cs) (hCV : 0 ≤ CV) :
    0 ≤ CFar m B Cs CV gam := by
  have hpi : (0 : ℝ) < Real.pi := Real.pi_pos
  have h1 : (0 : ℝ) < (2 : ℝ) ^ ((21 : ℝ) / 2) := Real.rpow_pos_of_pos (by norm_num) _
  have h2 : (0 : ℝ) < (2 : ℝ) ^ ((m : ℝ) * (2 - gam)) := Real.rpow_pos_of_pos (by norm_num) _
  rw [CFar]
  positivity

/-- **The far part of Proposition 3.1.**  For `F` supported where `|y-z| ≥ 2^{21-m}`,
`‖S[F,b](·,t)‖₂ ≤ CFar · ‖F‖_{L²(w_γ)}`. -/
theorem offdiag_Sop_far {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : SymbData j m b B)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {F : SchwartzMap Pl2 ℂ}
    (hF : ∀ y z : Pl, (F : Pl2 → ℂ) (pr y z) ≠ 0 → (2 : ℝ) ^ (21 - (m : ℤ)) ≤ ‖y - z‖) :
    (∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam F := by
  have hCsnn : 0 ≤ Cs := le_trans (abs_nonneg _) (hCs 0)
  have hBnn : 0 ≤ B := hB.nonneg
  have hCnn : 0 ≤ CFar m B Cs CV gam := CFar_nonneg hBnn hCsnn hCVnn
  -- the pointwise bound in `ξ`
  have hptwise : ∀ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ
      ≤ ENNReal.ofReal (CFar m B Cs CV gam) *
        (wMassW gam fun w => Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w) ^ (2⁻¹ : ℝ) := by
    intro ξ
    rcases Set.eq_empty_or_nonempty (SuppSet j m ξ) with hempty | ⟨η₀, hη₀⟩
    · have hb0 : ∀ η : Pl, b t ξ η = 0 := by
        intro η
        refine hB.supp t ξ η ?_
        rw [hempty]
        exact Set.notMem_empty η
      have hS0 : Sop ε b (F : Pl2 → ℂ) ξ t = 0 := by
        rw [Sop, SopK]
        have hpt : ∀ η : Pl,
            phase ε t ξ η * b t ξ η * 𝓕 (F : Pl2 → ℂ) (pr (ξ - η) η) = 0 := by
          intro η
          rw [hb0 η]
          ring
        rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_zero]
      rw [hS0, enorm_zero]
      exact zero_le
    · have hξ : XiData j ξ := xiData_of_mem hη₀
      rw [Sop_eq_integral_w hB ε t ξ F]
      refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
      rw [CFar]
      exact lintegral_offdiag_far_closed hB hCs hCVnn hCV hε ht1 ht2 hξ hgam1 hgam2
        (measurable_Gf (shearSchwartz F) ξ).aemeasurable
        (fun w hz => Gf_low' hF ξ hz)
  -- square and integrate
  have hsq : ∀ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (CFar m B Cs CV gam ^ 2) *
        (wMassW gam fun w => Gf ((shearSchwartz F : Pl2 → ℂ)) ξ w) := by
    intro ξ
    have h := ENNReal.rpow_le_rpow (hptwise ξ) (by norm_num : (0 : ℝ) ≤ (2 : ℝ))
    refine le_trans h (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    congr 1
    · rw [ENNReal.ofReal_rpow_of_nonneg hCnn (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
      congr 1
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
    · rw [← ENNReal.rpow_mul]
      norm_num
  refine le_trans (lintegral_mono hsq) ?_
  rw [lintegral_const_mul' _ _ (by simp), lintegral_wMassW_Gf]

end OffdiagSopFar


/-! ## §4.6  The near part of `S[F,b]` -/

section NearSop

/-- **The near part of Proposition 3.1.**  For `F` supported where `|y-z| ≤ 2^{22-m}`, the almost
orthogonality estimate combines with the weight to give a bound in terms of `‖·‖_{L²(w_γ)}`. -/
theorem near_Sop {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hb : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2) (hBnn : 0 ≤ B)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) {N : ℝ} (hNnn : 0 ≤ N)
    (hN : IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ)) N)
    {gam : ℝ} (hgam : 1 / 2 < gam)
    {F Fbig : SchwartzMap Pl2 ℂ}
    (hdom : ∀ x, ‖(F : Pl2 → ℂ) x‖ ≤ ‖(Fbig : Pl2 → ℂ) x‖)
    (hF : ∀ x : Pl2, (F : Pl2 → ℂ) x ≠ 0 → ‖sepCLM x‖ ≤ (2 : ℝ) ^ (22 - (m : ℤ))) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (12 * 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * N
            / (2 : ℝ) ^ (m : ℤ))
        * (ENNReal.ofReal ((((2 : ℝ) ^ (22 - (m : ℤ)))) ^ (2 * gam - 1)) * wMass gam Fbig) := by
  have hRpos : (0 : ℝ) < (2 : ℝ) ^ (22 - (m : ℤ)) := by positivity
  refine le_trans (prop42 hb hray hBnn hε Efin hNnn hN F) ?_
  refine mul_le_mul' (le_refl _) ?_
  exact lintegral_enorm_sq_le_wMass hgam hRpos hdom hF

end NearSop


/-! ### Additivity of `S[F,b]` in `F` -/

section SopAdd

theorem fourier_schwartz_add (F1 F2 : SchwartzMap Pl2 ℂ) :
    𝓕 ((F1 + F2 : SchwartzMap Pl2 ℂ) : Pl2 → ℂ)
      = fun x => 𝓕 ((F1 : Pl2 → ℂ)) x + 𝓕 ((F2 : Pl2 → ℂ)) x := by
  have hco : ∀ f : SchwartzMap Pl2 ℂ,
      ((SchwartzMap.fourierTransformCLM ℂ f : SchwartzMap Pl2 ℂ) : Pl2 → ℂ)
        = 𝓕 ((f : Pl2 → ℂ)) := by
    intro f
    rw [SchwartzMap.fourierTransformCLM_apply, SchwartzMap.fourier_coe]
  rw [← hco (F1 + F2), ← hco F1, ← hco F2, map_add]
  funext x
  rw [add_apply]

/-- A uniform bound for the Fourier transform of a Schwartz function. -/
theorem exists_fourier_bound (F : SchwartzMap Pl2 ℂ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : Pl2, ‖𝓕 ((F : Pl2 → ℂ)) x‖ ≤ C := by
  refine ⟨∫ v : Pl2, ‖(F : Pl2 → ℂ) v‖, integral_nonneg fun v => norm_nonneg _, fun x => ?_⟩
  rw [fourier_eq_ee_Pl2]
  refine le_trans (norm_integral_le_integral_norm _) ?_
  refine le_of_eq (integral_congr_ae (Filter.Eventually.of_forall fun v => ?_))
  show ‖ee (inner ℝ v x) * (F : Pl2 → ℂ) v‖ = ‖(F : Pl2 → ℂ) v‖
  rw [norm_mul, norm_ee, one_mul]

theorem integrable_SopK_integrand {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hBnn : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) {G : Pl2 → ℂ} (hGm : Measurable G) {C : ℝ} (hCnn : 0 ≤ C)
    (hGC : ∀ x, ‖G x‖ ≤ C) :
    Integrable fun η : Pl => phase ε t ξ η * b t ξ η * G (pr (ξ - η) η) := by
  have hmeas : AEMeasurable
      (fun η : Pl => phase ε t ξ η * b t ξ η * G (pr (ξ - η) η))
      (volume : Measure Pl) := by
    have h1 : Measurable fun η : Pl => phase ε t ξ η := by
      refine Complex.continuous_exp.measurable.comp ?_
      refine (Complex.continuous_ofReal.comp ?_).mul continuous_const |>.measurable
      exact continuous_const.mul ((continuous_const.sub continuous_id).norm.add
        continuous_norm)
    have h2 : Measurable fun η : Pl => G (pr (ξ - η) η) := by
      have hp : Measurable fun η : Pl => (pr (ξ - η) η : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp
          ((measurable_const.sub measurable_id).prodMk measurable_id)
      exact hGm.comp hp
    exact ((h1.mul (hb.meas t ξ)).mul h2).aemeasurable
  refine Integrable.mono' (integrable_indicator_SuppSet j m ξ (B * C))
    hmeas.aestronglyMeasurable ?_
  refine Filter.Eventually.of_forall fun η => ?_
  by_cases hmem : η ∈ SuppSet j m ξ
  · rw [Set.indicator_of_mem hmem, mul_one, norm_mul, norm_mul, norm_phase, one_mul]
    exact mul_le_mul (hbB t ξ η) (hGC _) (norm_nonneg _) hBnn
  · rw [Set.indicator_of_notMem hmem, mul_zero, hb.supp t ξ η hmem]
    simp

/-- `S[F,b]` is additive in `F`. -/
theorem Sop_add {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hBnn : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) (F1 F2 : SchwartzMap Pl2 ℂ) :
    Sop ε b ((F1 + F2 : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) ξ t
      = Sop ε b ((F1 : Pl2 → ℂ)) ξ t + Sop ε b ((F2 : Pl2 → ℂ)) ξ t := by
  obtain ⟨C1, hC1nn, hC1⟩ := exists_fourier_bound F1
  obtain ⟨C2, hC2nn, hC2⟩ := exists_fourier_bound F2
  have hi1 := integrable_SopK_integrand hb hbB hBnn ε t ξ
    (measurable_fourier_schwartz F1) hC1nn hC1
  have hi2 := integrable_SopK_integrand hb hbB hBnn ε t ξ
    (measurable_fourier_schwartz F2) hC2nn hC2
  rw [Sop, Sop, Sop, SopK, SopK, SopK]
  have hpt : ∀ η : Pl,
      phase ε t ξ η * b t ξ η * 𝓕 ((F1 + F2 : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) (pr (ξ - η) η)
        = phase ε t ξ η * b t ξ η * 𝓕 ((F1 : Pl2 → ℂ)) (pr (ξ - η) η)
          + phase ε t ξ η * b t ξ η * 𝓕 ((F2 : Pl2 → ℂ)) (pr (ξ - η) η) := by
    intro η
    rw [fourier_schwartz_add]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_add hi1 hi2]

end SopAdd


/-! ### Elementary tools for the near/far combination -/

section NearFarTools

theorem enorm_add_sq_le (a c : ℂ) :
    ‖a + c‖ₑ ^ (2 : ℝ) ≤ 4 * (‖a‖ₑ ^ (2 : ℝ) + ‖c‖ₑ ^ (2 : ℝ)) := by
  have h1 : ‖a + c‖ₑ ≤ ‖a‖ₑ + ‖c‖ₑ := enorm_add_le a c
  have h2 : ‖a‖ₑ + ‖c‖ₑ ≤ 2 * max ‖a‖ₑ ‖c‖ₑ := by
    rw [two_mul]
    exact add_le_add (le_max_left _ _) (le_max_right _ _)
  have h3 : ‖a + c‖ₑ ^ (2 : ℝ) ≤ (2 * max ‖a‖ₑ ‖c‖ₑ) ^ (2 : ℝ) :=
    ENNReal.rpow_le_rpow (le_trans h1 h2) (by norm_num)
  have htwo : ((2 : ℝ≥0∞)) ^ (2 : ℝ) = 4 := by
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
    norm_num
  have h4 : (2 * max ‖a‖ₑ ‖c‖ₑ) ^ (2 : ℝ) = 4 * (max ‖a‖ₑ ‖c‖ₑ) ^ (2 : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ (2 : ℝ)), htwo]
  have h5 : (max ‖a‖ₑ ‖c‖ₑ) ^ (2 : ℝ) ≤ ‖a‖ₑ ^ (2 : ℝ) + ‖c‖ₑ ^ (2 : ℝ) := by
    rcases le_total ‖a‖ₑ ‖c‖ₑ with hle | hle
    · rw [max_eq_right hle]
      exact le_add_self
    · rw [max_eq_left hle]
      exact le_self_add
  rw [h4] at h3
  refine le_trans h3 ?_
  exact mul_le_mul' (le_refl _) h5

theorem farPart_support' {c : ℝ} {F : SchwartzMap Pl2 ℂ} {x : Pl2}
    (h : (farPart c F : Pl2 → ℂ) x ≠ 0) : 1 < c * ‖sepCLM x‖ ^ 2 := by
  have hx : x = pr (WithLp.ofLp x).1 (WithLp.ofLp x).2 := rfl
  rw [hx] at h
  have hval := farPart_support h
  rw [sepCLM_apply]
  exact hval

theorem nearPart_support' {c : ℝ} {F : SchwartzMap Pl2 ℂ} {x : Pl2}
    (h : (nearPart c F : Pl2 → ℂ) x ≠ 0) : c * ‖sepCLM x‖ ^ 2 < 2 := by
  have hx : x = pr (WithLp.ofLp x).1 (WithLp.ofLp x).2 := rfl
  rw [hx] at h
  have hval := nearPart_support h
  rw [sepCLM_apply]
  exact hval

theorem norm_nearPart_le (c : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl2) :
    ‖(nearPart c F : Pl2 → ℂ) x‖ ≤ ‖(F : Pl2 → ℂ) x‖ := by
  rw [nearPart_apply, norm_smul, Real.norm_eq_abs]
  have h1 := sepCut_nonneg c x
  have h2 := sepCut_le_one c x
  have habs : |1 - sepCut c x| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith
  nlinarith [norm_nonneg ((F : Pl2 → ℂ) x), habs]

theorem norm_farPart_le (c : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl2) :
    ‖(farPart c F : Pl2 → ℂ) x‖ ≤ ‖(F : Pl2 → ℂ) x‖ := by
  rw [farPart_apply, norm_smul, Real.norm_eq_abs]
  have h1 := sepCut_nonneg c x
  have h2 := sepCut_le_one c x
  have habs : |sepCut c x| ≤ 1 := by
    rw [abs_le]
    constructor <;> linarith
  nlinarith [norm_nonneg ((F : Pl2 → ℂ) x), habs]

/-- With `c = 2^{2m-42}` the near piece is supported where `|y-z| ≤ 2^{22-m}`. -/
theorem nearPart_sep_le {m : ℕ} {F : SchwartzMap Pl2 ℂ} {x : Pl2}
    (h : (nearPart ((2 : ℝ) ^ (2 * (m : ℤ) - 42)) F : Pl2 → ℂ) x ≠ 0) :
    ‖sepCLM x‖ ≤ (2 : ℝ) ^ (22 - (m : ℤ)) := by
  have hval := nearPart_support' h
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (2 * (m : ℤ) - 42) := by positivity
  have hsq : ‖sepCLM x‖ ^ 2 < (2 : ℝ) ^ (43 - 2 * (m : ℤ)) := by
    by_contra hcon
    push_neg at hcon
    have hge : (2 : ℝ) ≤ (2 : ℝ) ^ (2 * (m : ℤ) - 42) * ‖sepCLM x‖ ^ 2 := by
      calc (2 : ℝ)
          = (2 : ℝ) ^ (2 * (m : ℤ) - 42) * (2 : ℝ) ^ (43 - 2 * (m : ℤ)) := by
            rw [← two_zpow_add,
              show (2 * (m : ℤ) - 42) + (43 - 2 * (m : ℤ)) = 1 by ring]
            norm_num
        _ ≤ (2 : ℝ) ^ (2 * (m : ℤ) - 42) * ‖sepCLM x‖ ^ 2 :=
            mul_le_mul_of_nonneg_left hcon hcpos.le
    linarith
  have hbound : (2 : ℝ) ^ (43 - 2 * (m : ℤ)) ≤ ((2 : ℝ) ^ (22 - (m : ℤ))) ^ 2 := by
    rw [sq, ← two_zpow_add]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    omega
  have hlt : ‖sepCLM x‖ ^ 2 < ((2 : ℝ) ^ (22 - (m : ℤ))) ^ 2 := lt_of_lt_of_le hsq hbound
  have hRpos : (0 : ℝ) < (2 : ℝ) ^ (22 - (m : ℤ)) := by positivity
  nlinarith [norm_nonneg (sepCLM x), hlt, hRpos]

/-- With `c = 2^{2m-42}` the far piece is supported where `|y-z| ≥ 2^{21-m}`. -/
theorem farPart_sep_ge {m : ℕ} {F : SchwartzMap Pl2 ℂ} {y z : Pl}
    (h : (farPart ((2 : ℝ) ^ (2 * (m : ℤ) - 42)) F : Pl2 → ℂ) (pr y z) ≠ 0) :
    (2 : ℝ) ^ (21 - (m : ℤ)) ≤ ‖y - z‖ := by
  have hval := farPart_support h
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (2 * (m : ℤ) - 42) := by positivity
  have hsq : ((2 : ℝ) ^ (21 - (m : ℤ))) ^ 2 ≤ ‖y - z‖ ^ 2 := by
    have hstep : (2 : ℝ) ^ (42 - 2 * (m : ℤ)) < ‖y - z‖ ^ 2 := by
      by_contra hcon
      push_neg at hcon
      have hle : (2 : ℝ) ^ (2 * (m : ℤ) - 42) * ‖y - z‖ ^ 2 ≤ 1 := by
        calc (2 : ℝ) ^ (2 * (m : ℤ) - 42) * ‖y - z‖ ^ 2
            ≤ (2 : ℝ) ^ (2 * (m : ℤ) - 42) * (2 : ℝ) ^ (42 - 2 * (m : ℤ)) :=
              mul_le_mul_of_nonneg_left hcon hcpos.le
          _ = 1 := by
              rw [← two_zpow_add,
                show (2 * (m : ℤ) - 42) + (42 - 2 * (m : ℤ)) = 0 by ring]
              norm_num
      linarith
    refine le_of_lt (lt_of_le_of_lt (le_of_eq ?_) hstep)
    rw [sq, ← two_zpow_add]
    congr 1
    ring
  have hRpos : (0 : ℝ) < (2 : ℝ) ^ (21 - (m : ℤ)) := by positivity
  nlinarith [norm_nonneg (y - z), hsq, hRpos]

end NearFarTools


/-! ### Measurability of `ξ ↦ S[F,b](ξ,t)` -/

section SopMeasurable

theorem continuous_phase_pair (ε t : ℝ) :
    Continuous fun p : Pl × Pl => phase ε t p.1 p.2 := by
  refine Complex.continuous_exp.comp ?_
  refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
  exact continuous_const.mul
    (((continuous_fst.sub continuous_snd).norm).add continuous_snd.norm)

theorem measurable_Sop {b : ℝ → Pl → Pl → ℂ} {t : ℝ}
    (hbjoint : Measurable fun p : Pl × Pl => b t p.1 p.2)
    (ε : ℝ) (F : SchwartzMap Pl2 ℂ) :
    Measurable fun ξ : Pl => Sop ε b (F : Pl2 → ℂ) ξ t := by
  have hpair : Measurable fun p : Pl × Pl =>
      phase ε t p.1 p.2 * b t p.1 p.2 * 𝓕 ((F : Pl2 → ℂ)) (pr (p.1 - p.2) p.2) := by
    have h1 : Measurable fun p : Pl × Pl => phase ε t p.1 p.2 :=
      (continuous_phase_pair ε t).measurable
    have h3 : Measurable fun p : Pl × Pl => 𝓕 ((F : Pl2 → ℂ)) (pr (p.1 - p.2) p.2) := by
      have hp : Measurable fun p : Pl × Pl => (pr (p.1 - p.2) p.2 : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp
          ((measurable_fst.sub measurable_snd).prodMk measurable_snd)
      exact (measurable_fourier_schwartz F).comp hp
    exact (h1.mul hbjoint).mul h3
  have h := hpair.stronglyMeasurable.integral_prod_right' (ν := (volume : Measure Pl))
  exact h.measurable

end SopMeasurable

/-! ## §4.6  Proposition 3.1 for a single angular scale `m` -/

section Prop31Single

/-- The near/far combination with the near bound left as a hypothesis. -/
theorem prop31_combine {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hSD : SymbData j m b B)
    (hbjoint : ∀ t' : ℝ, Measurable fun p : Pl × Pl => b t' p.1 p.2)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t' ∈ Efin, 1 ≤ t' ∧ t' ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (F : SchwartzMap Pl2 ℂ) {NB : ℝ≥0∞}
    (hnear : (∑ t' ∈ Efin, ∫⁻ ξ : Pl,
        ‖Sop ε b ((nearPart ((2 : ℝ) ^ (2 * (m : ℤ) - 42)) F : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ))
      ≤ NB) :
    (∑ t' ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t'‖ₑ ^ (2 : ℝ))
      ≤ 4 * (NB + (Efin.card : ℝ≥0∞) *
          (ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam F)) := by
  classical
  have hBnn : 0 ≤ B := hSD.nonneg
  set c : ℝ := (2 : ℝ) ^ (2 * (m : ℤ) - 42) with hcdef
  set FN : SchwartzMap Pl2 ℂ := nearPart c F with hFN
  set FF : SchwartzMap Pl2 ℂ := farPart c F with hFF
  have hsplit : ∀ (t' : ℝ) (ξ : Pl), ‖Sop ε b (F : Pl2 → ℂ) ξ t'‖ₑ ^ (2 : ℝ)
      ≤ 4 * (‖Sop ε b ((FN : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ)
        + ‖Sop ε b ((FF : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ)) := by
    intro t' ξ
    have hFsum : (FN + FF : SchwartzMap Pl2 ℂ) = F := by
      rw [hFN, hFF]
      exact add_nearPart_farPart c F
    have hadd := Sop_add hSD.toIsAdapted (fun t'' ξ'' η'' => hSD.bd0 t'' ξ'' η'') hBnn
      ε t' ξ FN FF
    rw [hFsum] at hadd
    rw [hadd]
    exact enorm_add_sq_le _ _
  have hstep : ∀ t' ∈ Efin, (∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t'‖ₑ ^ (2 : ℝ))
      ≤ 4 * ((∫⁻ ξ : Pl, ‖Sop ε b ((FN : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ))
        + ∫⁻ ξ : Pl, ‖Sop ε b ((FF : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ)) := by
    intro t' _
    have hmN : AEMeasurable
        (fun ξ : Pl => ‖Sop ε b ((FN : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ))
        (volume : Measure Pl) :=
      (((measurable_Sop (hbjoint t') ε FN).enorm).pow_const _).aemeasurable
    refine le_trans (lintegral_mono (hsplit t')) ?_
    rw [lintegral_const_mul' _ _ (by simp), lintegral_add_left' hmN]
  refine le_trans (Finset.sum_le_sum hstep) ?_
  rw [← Finset.mul_sum, Finset.sum_add_distrib]
  refine mul_le_mul' (le_refl _) (add_le_add ?_ ?_)
  · rw [hFN, hcdef] at hnear
    exact hnear
  · have hfar : ∀ t' ∈ Efin,
        (∫⁻ ξ : Pl, ‖Sop ε b ((FF : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ))
          ≤ ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam FF := by
      intro t' ht'
      obtain ⟨h1, h2⟩ := hEfin t' ht'
      refine offdiag_Sop_far hSD hCs hCVnn hCV hε h1 h2 hgam1 hgam2 ?_
      intro y z hyz
      rw [hFF, hcdef] at hyz
      exact farPart_sep_ge hyz
    have hwF : wMass gam FF ≤ wMass gam F := by
      rw [wMass, wMass]
      refine lintegral_mono fun x => ?_
      refine mul_le_mul' ?_ (le_refl _)
      refine ENNReal.rpow_le_rpow ?_ (by norm_num)
      rw [← ofReal_norm, ← ofReal_norm]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [hFF]
      exact norm_farPart_le c F x
    have hsum2 : (∑ t' ∈ Efin,
        (∫⁻ ξ : Pl, ‖Sop ε b ((FF : Pl2 → ℂ)) ξ t'‖ₑ ^ (2 : ℝ)))
        ≤ ∑ _t' ∈ Efin, ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam F := by
      refine Finset.sum_le_sum fun t' ht' => ?_
      refine le_trans (hfar t' ht') ?_
      exact mul_le_mul' (le_refl _) hwF
    refine le_trans hsum2 (le_of_eq ?_)
    rw [Finset.sum_const, nsmul_eq_mul]

/-- **Proposition 3.1 for one angular scale**, using the almost orthogonality estimate. -/
theorem prop31_single {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hstrict : IsStrictlyAdapted j m b) (hray : RayData j b B b1 b2)
    (hSD : SymbData j m b B)
    (hbjoint : ∀ t' : ℝ, Measurable fun p : Pl × Pl => b t' p.1 p.2)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t' ∈ Efin, 1 ≤ t' ∧ t' ≤ 2)
    {N : ℝ} (hNnn : 0 ≤ N)
    (hN : IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ)) N)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t' ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t'‖ₑ ^ (2 : ℝ))
      ≤ 4 * (ENNReal.ofReal (12 * 2 ^ 61 * B ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * N
              / (2 : ℝ) ^ (m : ℤ))
            * (ENNReal.ofReal ((((2 : ℝ) ^ (22 - (m : ℤ)))) ^ (2 * gam - 1)) * wMass gam F)
          + (Efin.card : ℝ≥0∞) *
            (ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam F)) := by
  refine prop31_combine hSD hbjoint hCs hCVnn hCV hε Efin hEfin hgam1 hgam2 F ?_
  refine near_Sop hstrict hray hSD.nonneg hε Efin hNnn hN hgam1
    (fun x => norm_nearPart_le _ F x) ?_
  intro x hx
  exact nearPart_sep_le hx

/-- **Proposition 3.1 for one angular scale**, using only the trivial estimate.  This is the version
used for the smallest-angle piece, which is adapted but not strictly adapted. -/
theorem prop31_single_triv {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hSD : SymbData j m b B)
    (hbjoint : ∀ t' : ℝ, Measurable fun p : Pl × Pl => b t' p.1 p.2)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t' ∈ Efin, 1 ≤ t' ∧ t' ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t' ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t'‖ₑ ^ (2 : ℝ))
      ≤ 4 * ((Efin.card : ℝ≥0∞) *
            ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
            * (ENNReal.ofReal ((((2 : ℝ) ^ (22 - (m : ℤ)))) ^ (2 * gam - 1)) * wMass gam F)
          + (Efin.card : ℝ≥0∞) *
            (ENNReal.ofReal (CFar m B Cs CV gam ^ 2) * wMass gam F)) := by
  have hRpos : (0 : ℝ) < (2 : ℝ) ^ (22 - (m : ℤ)) := by positivity
  refine prop31_combine hSD hbjoint hCs hCVnn hCV hε Efin hEfin hgam1 hgam2 F ?_
  refine le_trans (prop41 hSD.nonneg hSD.toIsAdapted
    (fun t'' ξ'' η'' => hSD.bd0 t'' ξ'' η'') ε Efin _) ?_
  refine mul_le_mul' (le_refl _) ?_
  refine lintegral_enorm_sq_le_wMass hgam1 hRpos (fun x => norm_nearPart_le _ F x) ?_
  intro x hx
  exact nearPart_sep_le hx

end Prop31Single


/-! ## §4.6  From covering numbers to interval counts

A `σ`-separated set meets any interval of length `σ` in at most two points, so an interval count for
a separated set is controlled by a covering number.
-/

section CountFromCover

/-- Three points of a `σ`-separated set cannot lie in a common interval of length `σ`. -/
theorem not_three_in_interval {σ x y z : ℝ} (hσ : 0 < σ) {L : ℝ}
    (hx : L ≤ x) (hx' : x ≤ L + σ) (hy : L ≤ y) (hy' : y ≤ L + σ)
    (hz : L ≤ z) (hz' : z ≤ L + σ)
    (hxy : σ ≤ |x - y|) (hxz : σ ≤ |x - z|) (hyz : σ ≤ |y - z|) : False := by
  rcases abs_cases (x - y) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
    rcases abs_cases (x - z) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
      rcases abs_cases (y - z) with ⟨h3, _⟩ | ⟨h3, _⟩ <;>
        rw [h1] at hxy <;> rw [h2] at hxz <;> rw [h3] at hyz <;> linarith

/-- A `σ`-separated finite set meets a closed interval of length `σ` in at most two points. -/
theorem card_le_two_of_separated {Efin : Finset ℝ} {σ : ℝ} (hσ : 0 < σ)
    (hsep : ∀ s ∈ Efin, ∀ t ∈ Efin, s ≠ t → σ ≤ |s - t|) (a : ℝ) :
    (Efin.filter (fun t => a - σ / 2 ≤ t ∧ t ≤ a + σ / 2)).card ≤ 2 := by
  classical
  by_contra hcon
  push_neg at hcon
  obtain ⟨x, y, z, hxm, hym, hzm, hxy, hxz, hyz⟩ :=
    Finset.two_lt_card_iff.mp hcon
  rw [Finset.mem_filter] at hxm hym hzm
  refine not_three_in_interval hσ (L := a - σ / 2)
    hxm.2.1 (by linarith [hxm.2.2]) hym.2.1 (by linarith [hym.2.2])
    hzm.2.1 (by linarith [hzm.2.2])
    (hsep x hxm.1 y hym.1 hxy) (hsep x hxm.1 z hzm.1 hxz) (hsep y hym.1 z hzm.1 hyz)

/-- If a finite `σ`-separated set is covered by `ι.card` intervals of length `σ`, its cardinality is
at most `2 * ι.card`. -/
theorem card_le_two_mul_card_of_cover {Efin ι : Finset ℝ} {σ : ℝ} (hσ : 0 < σ)
    (hsep : ∀ s ∈ Efin, ∀ t ∈ Efin, s ≠ t → σ ≤ |s - t|)
    (hcov : ∀ t ∈ Efin, ∃ a ∈ ι, a - σ / 2 ≤ t ∧ t ≤ a + σ / 2) :
    Efin.card ≤ 2 * ι.card := by
  classical
  choose! f hfmem hf1 hf2 using hcov
  refine Finset.card_le_mul_card_image_of_maps_to (t := ι) hfmem 2 ?_
  intro a _
  refine le_trans (Finset.card_le_card ?_) (card_le_two_of_separated hσ hsep a)
  intro t ht
  rw [Finset.mem_filter] at ht
  obtain ⟨htE, hfa⟩ := ht
  rw [Finset.mem_filter]
  refine ⟨htE, ?_, ?_⟩
  · rw [← hfa]
    exact hf1 t htE
  · rw [← hfa]
    exact hf2 t htE

end CountFromCover


/-! ### The interval count supplied by the quasi-Assouad cover bound -/

section AssouadBridge

/-- A `σ`-separated finite set has at most two points in any interval of length at most `σ`. -/
theorem card_le_two_of_short {Efin : Finset ℝ} {σ : ℝ} (hσ : 0 < σ)
    (hsep : ∀ s ∈ Efin, ∀ t ∈ Efin, s ≠ t → σ ≤ |s - t|) {u v : ℝ} (huv : v - u ≤ σ) :
    (Efin.filter (fun t => u ≤ t ∧ t ≤ v)).card ≤ 2 := by
  refine le_trans (Finset.card_le_card ?_) (card_le_two_of_separated hσ hsep (u + σ / 2))
  intro t ht
  rw [Finset.mem_filter] at ht ⊢
  obtain ⟨htE, h1, h2⟩ := ht
  refine ⟨htE, by linarith, by linarith⟩

/-- **The interval count coming from the quasi-Assouad cover bound.**  If `ℰ ⊆ E ∩ [1,2]` is
`2^{-j}`-separated then the number of its points in any interval of length `2^{2m-j}` is at most
`2 + 2 C 2^{jη} 2^{2mγ}`. -/
theorem intervalCount_of_assouad {E : Set ℝ} {gam eta C : ℝ}
    (hcov : HasSubpowerAssouadCoverBound E gam eta C) (hCnn : 0 ≤ C) (hgam : 0 ≤ gam)
    {j m : ℕ} (hjm : 2 * m ≤ j) (hj : 0 < j)
    {Efin : Finset ℝ} (hEsub : ∀ t ∈ Efin, t ∈ E)
    (hE1 : ∀ t ∈ Efin, 1 ≤ t) (hE2 : ∀ t ∈ Efin, t ≤ 2)
    (hsep : ∀ s ∈ Efin, ∀ t ∈ Efin, s ≠ t → (2 : ℝ) ^ (-(j : ℤ)) ≤ |s - t|) :
    IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
      (2 + 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) := by
  classical
  intro c
  set σ : ℝ := (2 : ℝ) ^ (-(j : ℤ)) with hσdef
  have hσpos : (0 : ℝ) < σ := by rw [hσdef]; positivity
  have hσlt : σ < 1 := by
    rw [hσdef]
    refine zpow_lt_one_of_neg₀ (by norm_num) ?_
    omega
  set dl : ℝ := ((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ) with hdl
  have hdlpos : (0 : ℝ) < dl := by rw [hdl]; positivity
  set S : Finset ℝ := Efin.filter (fun t => c ≤ t ∧ t < c + dl) with hS
  have hCbig : (0 : ℝ) ≤ 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) * (2 : ℝ) ^ (2 * (m : ℝ) * gam) := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ ((j : ℝ) * eta) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < (2 : ℝ) ^ (2 * (m : ℝ) * gam) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  rcases Finset.eq_empty_or_nonempty S with hempty | ⟨t0, ht0⟩
  · rw [hS] at hempty
    rw [hS, hempty]
    simp only [Finset.card_empty, Nat.cast_zero]
    linarith
  -- the interval `[a, b]` inside `[1,2]`
  rw [hS] at ht0
  obtain ⟨ht0E, ht0c, ht0d⟩ := Finset.mem_filter.mp ht0
  set a : ℝ := max c 1 with ha
  set b : ℝ := min (c + dl) 2 with hb
  have h1a : (1 : ℝ) ≤ a := by rw [ha]; exact le_max_right _ _
  have hb2 : b ≤ 2 := by rw [hb]; exact min_le_right _ _
  have hat0 : a ≤ t0 := by
    rw [ha]
    exact max_le ht0c (hE1 t0 ht0E)
  have ht0b : t0 ≤ b := by
    rw [hb]
    exact le_min (le_of_lt ht0d) (hE2 t0 ht0E)
  have hab : a ≤ b := le_trans hat0 ht0b
  have hsubset : ∀ t ∈ S, t ∈ E ∩ Set.Icc a b := by
    intro t ht
    rw [hS] at ht
    obtain ⟨htE, htc, htd⟩ := Finset.mem_filter.mp ht
    refine ⟨hEsub t htE, ?_, ?_⟩
    · rw [ha]
      exact max_le htc (hE1 t htE)
    · rw [hb]
      exact le_min (le_of_lt htd) (hE2 t htE)
  rcases lt_or_ge (b - a) σ with hshort | hlong
  · -- degenerate case: the overlap is shorter than the separation
    have hsub2 : S ⊆ Efin.filter (fun t => a ≤ t ∧ t ≤ b) := by
      intro t ht
      have h := hsubset t ht
      rw [hS] at ht
      rw [Finset.mem_filter]
      exact ⟨(Finset.mem_filter.mp ht).1, h.2.1, h.2.2⟩
    have hcard := card_le_two_of_short hσpos hsep (le_of_lt hshort)
    have hle : S.card ≤ 2 := le_trans (Finset.card_le_card hsub2) hcard
    have : ((S.card : ℝ)) ≤ 2 := by exact_mod_cast hle
    rw [hS] at this ⊢
    linarith
  · -- main case: apply the cover bound
    obtain ⟨ι, hcovι, hcard⟩ := hcov σ a b hσpos hσlt h1a hab hb2 hlong
    have hcov2 : ∀ t ∈ S, ∃ x ∈ ι, x - σ / 2 ≤ t ∧ t ≤ x + σ / 2 := by
      intro t ht
      have hmem := hcovι (hsubset t ht)
      rw [Set.mem_iUnion₂] at hmem
      obtain ⟨x, hxι, hx⟩ := hmem
      exact ⟨x, hxι, hx.1, hx.2⟩
    have hsepS : ∀ s ∈ S, ∀ t ∈ S, s ≠ t → σ ≤ |s - t| := by
      intro s hs t ht hst
      rw [hS] at hs ht
      exact hsep s (Finset.mem_filter.mp hs).1 t (Finset.mem_filter.mp ht).1 hst
    have hSle : S.card ≤ 2 * ι.card := card_le_two_mul_card_of_cover hσpos hsepS hcov2
    have hScast : ((S.card : ℝ)) ≤ 2 * (ι.card : ℝ) := by exact_mod_cast hSle
    -- bound the cover cardinality
    have hratio : (b - a) / σ ≤ ((2 : ℝ) ^ (m : ℤ)) ^ 2 := by
      rw [div_le_iff₀ hσpos]
      have hba : b - a ≤ dl := by
        have h1 : b ≤ c + dl := by rw [hb]; exact min_le_left _ _
        have h2 : c ≤ a := by rw [ha]; exact le_max_left _ _
        linarith
      refine le_trans hba (le_of_eq ?_)
      rw [hdl, hσdef, zpow_neg, div_eq_mul_inv]
    have hpow : ((b - a) / σ) ^ gam ≤ ((2 : ℝ) ^ (2 * (m : ℝ) * gam)) := by
      refine le_trans (Real.rpow_le_rpow (by positivity) hratio hgam) (le_of_eq ?_)
      rw [two_zpow_sq, two_zpow_rpow]
      congr 1
      push_cast
      ring
    have hsigma : σ ^ (-eta) = (2 : ℝ) ^ ((j : ℝ) * eta) := by
      rw [hσdef, two_zpow_rpow]
      congr 1
      push_cast
      ring
    have hcard2 : (ι.card : ℝ)
        ≤ C * (2 : ℝ) ^ ((j : ℝ) * eta) * (2 : ℝ) ^ (2 * (m : ℝ) * gam) := by
      refine le_trans hcard ?_
      rw [hsigma]
      have hC2 : (0 : ℝ) ≤ C * (2 : ℝ) ^ ((j : ℝ) * eta) := by
        have h1 : (0 : ℝ) < (2 : ℝ) ^ ((j : ℝ) * eta) := Real.rpow_pos_of_pos (by norm_num) _
        positivity
      exact mul_le_mul_of_nonneg_left hpow hC2
    rw [hS] at hScast ⊢
    linarith

end AssouadBridge


/-! ## §4.6  The angular partition of unity

`det(ξ,η)` is bilinear, hence linear in `η` and linear along rays through the origin.  This is what
makes the angular cutoffs `ψ_m` have radial derivatives of size `2^{-jN}` and Cartesian
`η`-derivatives of size `2^{-(j-m)}` — exactly the two scales required by `RayData` and `SymbData`.
-/

section AngularPartition

/-- `η ↦ det(ξ,η)` as a continuous linear map. -/
def detCLM (ξ : Pl) : Pl →L[ℝ] ℝ := (ξ 0) • prj 1 - (ξ 1) • prj 0

@[simp] theorem detCLM_apply (ξ η : Pl) : detCLM ξ η = det2 ξ η := by
  rw [detCLM, det2, ContinuousLinearMap.sub_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.smul_apply, prj_apply, prj_apply, smul_eq_mul, smul_eq_mul]

theorem norm_detCLM_le (ξ : Pl) : ‖detCLM ξ‖ ≤ 2 * ‖ξ‖ := by
  refine le_trans (norm_sub_le _ _) ?_
  have h1 : ‖(ξ 0) • prj 1‖ ≤ ‖ξ‖ := by
    refine le_trans (norm_smul_le (ξ 0) (prj 1)) ?_
    have h := norm_prj_le 1
    have habs : |ξ 0| ≤ ‖ξ‖ := Auto.CalderonVaillancourt.abs_apply_le_norm ξ 0
    rw [Real.norm_eq_abs]
    nlinarith [abs_nonneg (ξ 0), norm_nonneg (prj (1 : Fin 2))]
  have h2 : ‖(ξ 1) • prj 0‖ ≤ ‖ξ‖ := by
    refine le_trans (norm_smul_le (ξ 1) (prj 0)) ?_
    have h := norm_prj_le 0
    have habs : |ξ 1| ≤ ‖ξ‖ := Auto.CalderonVaillancourt.abs_apply_le_norm ξ 1
    rw [Real.norm_eq_abs]
    nlinarith [abs_nonneg (ξ 1), norm_nonneg (prj (0 : Fin 2))]
  linarith

/-- The normalized angular variable, `v = (2^{-2j} det(ξ,η))²`. -/
def angV (j : ℕ) (ξ η : Pl) : ℝ := ((2 : ℝ) ^ (-2 * (j : ℤ)) * detCLM ξ η) ^ 2

theorem angV_nonneg (j : ℕ) (ξ η : Pl) : 0 ≤ angV j ξ η := by
  rw [angV]
  positivity

theorem contDiff_angV (j : ℕ) (ξ : Pl) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angV j ξ) := by
  have h : angV j ξ = fun η => ((2 : ℝ) ^ (-2 * (j : ℤ)) * detCLM ξ η) ^ 2 := rfl
  rw [h]
  exact (contDiff_const.mul (detCLM ξ).contDiff).pow 2

/-- The increasing family of angular cutoffs: `angA j m = 1` where `4^m v ≥ 2` and `= 0` where
`4^m v ≤ 1`. -/
def angA (j m : ℕ) (ξ η : Pl) : ℝ :=
  Real.smoothTransition ((4 : ℝ) ^ m * angV j ξ η - 1)

theorem contDiff_angA (j m : ℕ) (ξ : Pl) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angA j m ξ) :=
  contDiff_st.comp ((contDiff_const.mul (contDiff_angV j ξ)).sub contDiff_const)

theorem angA_nonneg (j m : ℕ) (ξ η : Pl) : 0 ≤ angA j m ξ η :=
  Real.smoothTransition.nonneg _

theorem angA_le_one (j m : ℕ) (ξ η : Pl) : angA j m ξ η ≤ 1 :=
  Real.smoothTransition.le_one _

theorem angA_eq_zero {j m : ℕ} {ξ η : Pl} (h : (4 : ℝ) ^ m * angV j ξ η ≤ 1) :
    angA j m ξ η = 0 :=
  Real.smoothTransition.zero_of_nonpos (by linarith)

theorem angA_eq_one {j m : ℕ} {ξ η : Pl} (h : 2 ≤ (4 : ℝ) ^ m * angV j ξ η) :
    angA j m ξ η = 1 :=
  Real.smoothTransition.one_of_one_le (by linarith)

/-- The `m`-th piece of the angular partition, for `0 ≤ m ≤ M + 1`. -/
def angPsi (j M m : ℕ) (ξ η : Pl) : ℝ :=
  if m = 0 then angA j 0 ξ η
  else if m ≤ M then angA j m ξ η - angA j (m - 1) ξ η
  else 1 - angA j M ξ η

theorem contDiff_angPsi (j M m : ℕ) (ξ : Pl) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angPsi j M m ξ) := by
  by_cases h0 : m = 0
  · have h : angPsi j M m ξ = angA j 0 ξ := by
      funext η
      rw [angPsi]
      simp [h0]
    rw [h]
    exact contDiff_angA j 0 ξ
  · by_cases hM : m ≤ M
    · have h : angPsi j M m ξ = fun η => angA j m ξ η - angA j (m - 1) ξ η := by
        funext η
        rw [angPsi]
        simp [h0, hM]
      rw [h]
      exact (contDiff_angA j m ξ).sub (contDiff_angA j (m - 1) ξ)
    · have h : angPsi j M m ξ = fun η => 1 - angA j M ξ η := by
        funext η
        rw [angPsi]
        simp [h0, hM]
      rw [h]
      exact contDiff_const.sub (contDiff_angA j M ξ)

/-- The angular pieces sum to `1`. -/
theorem sum_angPsi (j M : ℕ) (ξ η : Pl) :
    ∑ m ∈ Finset.range (M + 2), angPsi j M m ξ η = 1 := by
  classical
  have hmid : ∀ m ∈ Finset.range M, angPsi j M (m + 1) ξ η
      = angA j (m + 1) ξ η - angA j m ξ η := by
    intro m hm
    rw [Finset.mem_range] at hm
    rw [angPsi]
    have h0 : ¬ (m + 1 = 0) := by omega
    have hM : m + 1 ≤ M := by omega
    simp only [h0, if_false, hM, if_true, Nat.add_sub_cancel]
  have hlast : angPsi j M (M + 1) ξ η = 1 - angA j M ξ η := by
    rw [angPsi]
    have h0 : ¬ (M + 1 = 0) := by omega
    have hM : ¬ (M + 1 ≤ M) := by omega
    simp only [h0, if_false, hM, if_false]
  have hfirst : angPsi j M 0 ξ η = angA j 0 ξ η := by
    rw [angPsi]
    simp
  rw [show M + 2 = (M + 1) + 1 by ring, Finset.sum_range_succ, hlast]
  rw [Finset.sum_range_succ' (fun m => angPsi j M m ξ η) M, hfirst]
  rw [Finset.sum_congr rfl hmid, Finset.sum_range_sub (fun m => angA j m ξ η) M]
  ring

end AngularPartition


/-! ### The determinant and the angle are comparable on the support -/

section AngleComparison

/-- The normalized modulus of the determinant, `|2^{-2j} det(ξ,η)|`. -/
def dnorm (j : ℕ) (ξ η : Pl) : ℝ := |(2 : ℝ) ^ (-2 * (j : ℤ)) * det2 ξ η|

theorem dnorm_nonneg (j : ℕ) (ξ η : Pl) : 0 ≤ dnorm j ξ η := abs_nonneg _

theorem angV_eq_sq (j : ℕ) (ξ η : Pl) : angV j ξ η = dnorm j ξ η ^ 2 := by
  rw [angV, dnorm, detCLM_apply, sq_abs]

theorem dnorm_eq (j : ℕ) (ξ η : Pl) :
    dnorm j ξ η = (2 : ℝ) ^ (-2 * (j : ℤ)) * |det2 ξ η| := by
  rw [dnorm, abs_mul, abs_of_pos (show (0 : ℝ) < (2 : ℝ) ^ (-2 * (j : ℤ)) by positivity)]

/-- The normalized determinant is at most `2^3` times the angle. -/
theorem dnorm_le_angle {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) :
    dnorm j ξ η ≤ (2 : ℝ) ^ (3 : ℤ) * InnerProductGeometry.angle ξ η := by
  have hxi := xiData_of_mem h
  obtain ⟨hηT, -, -⟩ := h
  set θ := InnerProductGeometry.angle ξ η with hθ
  have hθ0 : 0 ≤ θ := InnerProductGeometry.angle_nonneg ξ η
  have hsin := sin_angle_eq ξ η
  rw [← hθ] at hsin
  have hxn : ‖ξ‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := hxi.norm_le
  have hyn : ‖η‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := hηT.2.2.2
  have hypos : (0 : ℝ) < ‖η‖ := lt_of_lt_of_le (by positivity) hηT.2.2.1
  have hdet : |det2 ξ η| ≤ θ * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1)) := by
    rw [← hsin]
    have hprod : ‖ξ‖ * ‖η‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1) :=
      mul_le_mul hxn hyn (le_of_lt hypos) (by positivity)
    have hsl : Real.sin θ ≤ θ := Real.sin_le hθ0
    have hpn : (0 : ℝ) ≤ ‖ξ‖ * ‖η‖ := by positivity
    calc Real.sin θ * (‖ξ‖ * ‖η‖) ≤ θ * (‖ξ‖ * ‖η‖) := by nlinarith
      _ ≤ θ * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1)) :=
          mul_le_mul_of_nonneg_left hprod hθ0
  have hkey : (2 : ℝ) ^ (-2 * (j : ℤ)) * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1))
      = (2 : ℝ) ^ (3 : ℤ) := by
    rw [← two_zpow_add, ← two_zpow_add]
    congr 1
    ring
  rw [dnorm_eq]
  calc (2 : ℝ) ^ (-2 * (j : ℤ)) * |det2 ξ η|
      ≤ (2 : ℝ) ^ (-2 * (j : ℤ)) * (θ * ((2 : ℝ) ^ ((j : ℤ) + 2) * (2 : ℝ) ^ ((j : ℤ) + 1))) :=
        mul_le_mul_of_nonneg_left hdet (by positivity)
    _ = (2 : ℝ) ^ (3 : ℤ) * θ := by rw [← hkey]; ring

/-- The angle is at most `2^3` times the normalized determinant. -/
theorem angle_le_dnorm {j m : ℕ} {ξ η : Pl} (h : η ∈ SuppSet j m ξ) :
    InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (3 : ℤ) * dnorm j ξ η := by
  have hxi := xiData_of_mem h
  obtain ⟨hηT, -, -⟩ := h
  set θ := InnerProductGeometry.angle ξ η with hθ
  have hθ0 : 0 ≤ θ := InnerProductGeometry.angle_nonneg ξ η
  have hπp : (0 : ℝ) < π := Real.pi_pos
  have hπ4 : π ≤ 4 := Real.pi_le_four
  have hπ3 : (2 : ℝ) ≤ π := Real.two_le_pi
  have hsmall : θ ≤ (2 : ℝ) ^ (-(9 : ℤ)) := by
    rw [hθ]
    exact angle_le_of_cone hxi.cone0 hxi.snd_pos hxi.cone hηT.1
      (Theta.snd_pos hηT) hηT.2.1
  have hhalf : θ ≤ π / 2 := by
    have h9 : (2 : ℝ) ^ (-(9 : ℤ)) ≤ 1 := by norm_num
    linarith
  have hlow : 2 / π * θ ≤ Real.sin θ := Real.mul_le_sin hθ0 hhalf
  have hsin := sin_angle_eq ξ η
  rw [← hθ] at hsin
  have hxn : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ξ‖ := hxi.norm_lower
  have hyn : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖η‖ := hηT.2.2.1
  have hdet : 2 / π * θ * ((2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ ((j : ℤ) - 1)) ≤ |det2 ξ η| := by
    rw [← hsin]
    have hprod : (2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ξ‖ * ‖η‖ :=
      mul_le_mul hxn hyn (by positivity) (norm_nonneg _)
    have h2 : (0 : ℝ) ≤ 2 / π * θ := by positivity
    have hpn : (0 : ℝ) ≤ ‖ξ‖ * ‖η‖ := by positivity
    calc 2 / π * θ * ((2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ ((j : ℤ) - 1))
        ≤ 2 / π * θ * (‖ξ‖ * ‖η‖) := mul_le_mul_of_nonneg_left hprod h2
      _ ≤ Real.sin θ * (‖ξ‖ * ‖η‖) := by nlinarith
  have hkey : (2 : ℝ) ^ (-2 * (j : ℤ)) * ((2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ ((j : ℤ) - 1))
      = 1 / 4 := by
    rw [← two_zpow_add, ← two_zpow_add]
    rw [show -2 * (j : ℤ) + ((j : ℤ) - 1 + ((j : ℤ) - 1)) = -2 by ring]
    norm_num
  have hd : θ / (2 * π) ≤ dnorm j ξ η := by
    rw [dnorm_eq]
    have hstep := mul_le_mul_of_nonneg_left hdet
      (show (0 : ℝ) ≤ (2 : ℝ) ^ (-2 * (j : ℤ)) by positivity)
    refine le_trans (le_of_eq ?_) hstep
    have hcalc : (2 : ℝ) ^ (-2 * (j : ℤ))
        * (2 / π * θ * ((2 : ℝ) ^ ((j : ℤ) - 1) * (2 : ℝ) ^ ((j : ℤ) - 1)))
        = (2 / π * θ) * (1 / 4) := by
      rw [← hkey]; ring
    rw [hcalc]
    field_simp
    ring
  rw [div_le_iff₀ (show (0 : ℝ) < 2 * π by positivity)] at hd
  have hdn := dnorm_nonneg j ξ η
  have hgap : (0 : ℝ) ≤ dnorm j ξ η * (8 - 2 * π) := mul_nonneg hdn (by linarith)
  rw [show ((2 : ℝ) ^ (3 : ℤ)) = 8 by norm_num]
  nlinarith

end AngleComparison

/-! ### Derivative bounds for the smooth transition -/

section StBounds

theorem exists_st_deriv2_bound : ∃ C : ℝ, 1 ≤ C ∧
    (∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C) ∧
    (∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ C) := by
  obtain ⟨C, hC1, hC⟩ := exists_st_bound 2
  refine ⟨C, hC1, fun x => ?_, fun x => ?_⟩
  · have h := hC 1 (by norm_num) x
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_one, Real.norm_eq_abs] at h
    exact h
  · have h := hC 2 (le_refl 2) x
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, Real.norm_eq_abs,
      show (2 : ℕ) = 1 + 1 from rfl, iteratedDeriv_succ, iteratedDeriv_one] at h
    exact h

end StBounds

/-! ### The support of the angular pieces -/

section AngSupport

theorem angV_gt_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : m ≤ M)
    (h : angPsi j M m ξ η ≠ 0) : 1 < (4 : ℝ) ^ m * angV j ξ η := by
  by_contra hcon
  push_neg at hcon
  refine h ?_
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · subst h0
    rw [angPsi]
    simp only [if_pos rfl]
    exact angA_eq_zero hcon
  · have hne : ¬ (m = 0) := by omega
    have hprev : (4 : ℝ) ^ (m - 1) * angV j ξ η ≤ 1 := by
      have hstep : (4 : ℝ) ^ m = 4 * (4 : ℝ) ^ (m - 1) := by
        have hm1 : m - 1 + 1 = m := by omega
        conv_lhs => rw [← hm1]
        rw [pow_succ]
        ring
      rw [hstep] at hcon
      have hv := angV_nonneg j ξ η
      nlinarith [pow_nonneg (show (0:ℝ) ≤ 4 by norm_num) (m - 1)]
    rw [angPsi]
    simp only [hne, if_false, hm, if_true]
    rw [angA_eq_zero hcon, angA_eq_zero hprev, sub_zero]

theorem angV_lt_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : 1 ≤ m) (hmM : m ≤ M + 1)
    (h : angPsi j M m ξ η ≠ 0) : (4 : ℝ) ^ (m - 1) * angV j ξ η < 2 := by
  by_contra hcon
  push_neg at hcon
  refine h ?_
  have hne : ¬ (m = 0) := by omega
  rcases le_or_gt m M with hle | hgt
  · have hcur : 2 ≤ (4 : ℝ) ^ m * angV j ξ η := by
      have hstep : (4 : ℝ) ^ m = 4 * (4 : ℝ) ^ (m - 1) := by
        have hm1 : m - 1 + 1 = m := by omega
        conv_lhs => rw [← hm1]
        rw [pow_succ]
        ring
      rw [hstep]
      have hv := angV_nonneg j ξ η
      nlinarith [pow_nonneg (show (0:ℝ) ≤ 4 by norm_num) (m - 1)]
    rw [angPsi]
    simp only [hne, if_false, hle, if_true]
    rw [angA_eq_one hcur, angA_eq_one hcon, sub_self]
  · have hmeq : m - 1 = M := by omega
    rw [hmeq] at hcon
    rw [angPsi]
    simp only [hne, if_false, show ¬ (m ≤ M) by omega, if_false]
    rw [angA_eq_one hcon, sub_self]

theorem dnorm_gt_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : m ≤ M)
    (h : angPsi j M m ξ η ≠ 0) : (2 : ℝ) ^ (-(m : ℤ)) < dnorm j ξ η := by
  have hv := angV_gt_of_angPsi_ne hm h
  rw [angV_eq_sq] at hv
  have h4 : (4 : ℝ) ^ m = ((2 : ℝ) ^ (m : ℤ)) ^ 2 := by
    rw [zpow_natCast, show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul, mul_comm]
  rw [h4] at hv
  have hprod : 1 < ((2 : ℝ) ^ (m : ℤ) * dnorm j ξ η) ^ 2 := by
    rw [mul_pow]; exact hv
  have hnn : 0 ≤ (2 : ℝ) ^ (m : ℤ) * dnorm j ξ η := by
    have := dnorm_nonneg j ξ η; positivity
  have h1 : 1 < (2 : ℝ) ^ (m : ℤ) * dnorm j ξ η := by nlinarith
  have hp : (0 : ℝ) < (2 : ℝ) ^ (m : ℤ) := by positivity
  rw [show ((2 : ℝ) ^ (-(m : ℤ))) = 1 / (2 : ℝ) ^ (m : ℤ) by
    rw [zpow_neg, one_div], div_lt_iff₀ hp]
  linarith [h1]

theorem dnorm_lt_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : 1 ≤ m) (hmM : m ≤ M + 1)
    (h : angPsi j M m ξ η ≠ 0) : dnorm j ξ η < (2 : ℝ) ^ (2 - (m : ℤ)) := by
  have hv := angV_lt_of_angPsi_ne hm hmM h
  rw [angV_eq_sq] at hv
  have hcast : ((m - 1 : ℕ) : ℤ) = (m : ℤ) - 1 := by
    push_cast [Nat.cast_sub hm]
    ring
  have h4 : (4 : ℝ) ^ (m - 1) = ((2 : ℝ) ^ ((m : ℤ) - 1)) ^ 2 := by
    rw [← hcast, zpow_natCast, show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul, mul_comm]
  rw [h4] at hv
  have hprod : ((2 : ℝ) ^ ((m : ℤ) - 1) * dnorm j ξ η) ^ 2 < 2 := by
    rw [mul_pow]; exact hv
  have hnn : 0 ≤ (2 : ℝ) ^ ((m : ℤ) - 1) * dnorm j ξ η := by
    have := dnorm_nonneg j ξ η; positivity
  have h1 : (2 : ℝ) ^ ((m : ℤ) - 1) * dnorm j ξ η < 2 := by nlinarith
  have hp : (0 : ℝ) < (2 : ℝ) ^ ((m : ℤ) - 1) := by positivity
  have hgoal : (2 : ℝ) ^ (2 - (m : ℤ)) = 2 / (2 : ℝ) ^ ((m : ℤ) - 1) := by
    rw [eq_div_iff (ne_of_gt hp), ← two_zpow_add,
      show 2 - (m : ℤ) + ((m : ℤ) - 1) = 1 by ring]
    norm_num
  rw [hgoal, lt_div_iff₀ hp]
  linarith [h1]

/-- On the support of the `m`-th angular piece the angle is at most `2^{5-m}`. -/
theorem angle_le_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : 1 ≤ m) (hmM : m ≤ M + 1)
    (hsupp : η ∈ SuppSet j 0 ξ) (h : angPsi j M m ξ η ≠ 0) :
    InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ)) := by
  have h1 := angle_le_dnorm hsupp
  have h2 := dnorm_lt_of_angPsi_ne hm hmM h
  have heq : (2 : ℝ) ^ (3 : ℤ) * (2 : ℝ) ^ (2 - (m : ℤ)) = (2 : ℝ) ^ (5 - (m : ℤ)) := by
    rw [← two_zpow_add]
    congr 1
    ring
  have h3 : (2 : ℝ) ^ (3 : ℤ) * dnorm j ξ η
      ≤ (2 : ℝ) ^ (3 : ℤ) * (2 : ℝ) ^ (2 - (m : ℤ)) :=
    mul_le_mul_of_nonneg_left (le_of_lt h2) (by positivity)
  rw [heq] at h3
  linarith

/-- On the support of the `m`-th angular piece the angle is at least `2^{-m-5}`. -/
theorem angle_ge_of_angPsi_ne {j M m : ℕ} {ξ η : Pl} (hm : m ≤ M)
    (hsupp : η ∈ SuppSet j 0 ξ) (h : angPsi j M m ξ η ≠ 0) :
    (2 : ℝ) ^ (-(m : ℤ) - 5) ≤ InnerProductGeometry.angle ξ η := by
  have h1 := dnorm_le_angle hsupp
  have h2 := dnorm_gt_of_angPsi_ne hm h
  have heq : (2 : ℝ) ^ (-(m : ℤ) - 5) * (2 : ℝ) ^ (3 : ℤ) = (2 : ℝ) ^ (-(m : ℤ) - 2) := by
    rw [← two_zpow_add]
    congr 1
    ring
  have h3 : (2 : ℝ) ^ (-(m : ℤ) - 2) ≤ (2 : ℝ) ^ (-(m : ℤ)) := by
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    omega
  have hp : (0 : ℝ) < (2 : ℝ) ^ (3 : ℤ) := by positivity
  -- `2^{-m-5}·2^3 = 2^{-m-2} ≤ 2^{-m} < dnorm ≤ 2^3 θ`
  have h4 : (2 : ℝ) ^ (-(m : ℤ) - 5) * (2 : ℝ) ^ (3 : ℤ)
      ≤ (2 : ℝ) ^ (3 : ℤ) * InnerProductGeometry.angle ξ η := by
    rw [heq]
    linarith
  nlinarith [h4, hp]

end AngSupport


/-! ### The derivatives of the smooth transition vanish off the transition zone -/

section StVanish

theorem deriv_st_eq_zero_of_nonpos {x : ℝ} (hx : x ≤ 0) :
    deriv Real.smoothTransition x = 0 := by
  have hmin : IsLocalMin Real.smoothTransition x := by
    refine Filter.Eventually.of_forall fun y => ?_
    rw [Real.smoothTransition.zero_of_nonpos hx]
    exact Real.smoothTransition.nonneg y
  exact hmin.deriv_eq_zero

theorem deriv_st_eq_zero_of_one_le {x : ℝ} (hx : 1 ≤ x) :
    deriv Real.smoothTransition x = 0 := by
  have hmax : IsLocalMax Real.smoothTransition x := by
    refine Filter.Eventually.of_forall fun y => ?_
    rw [Real.smoothTransition.one_of_one_le hx]
    exact Real.smoothTransition.le_one y
  exact hmax.deriv_eq_zero

theorem deriv_st_nonneg (x : ℝ) : 0 ≤ deriv Real.smoothTransition x :=
  Real.smoothTransition.monotone.deriv_nonneg

theorem deriv2_st_eq_zero_of_nonpos {x : ℝ} (hx : x ≤ 0) :
    deriv (deriv Real.smoothTransition) x = 0 := by
  have hmin : IsLocalMin (deriv Real.smoothTransition) x := by
    refine Filter.Eventually.of_forall fun y => ?_
    rw [deriv_st_eq_zero_of_nonpos hx]
    exact deriv_st_nonneg y
  exact hmin.deriv_eq_zero

theorem deriv2_st_eq_zero_of_one_le {x : ℝ} (hx : 1 ≤ x) :
    deriv (deriv Real.smoothTransition) x = 0 := by
  have hmin : IsLocalMin (deriv Real.smoothTransition) x := by
    refine Filter.Eventually.of_forall fun y => ?_
    rw [deriv_st_eq_zero_of_one_le hx]
    exact deriv_st_nonneg y
  exact hmin.deriv_eq_zero

end StVanish

/-! ### The angular cutoffs as functions of the determinant -/

section AngG

/-- `P_{j,k} = 4^k (2^{-2j})^2`, the coefficient in the angular cutoff. -/
def angP (j k : ℕ) : ℝ := (4 : ℝ) ^ k * ((2 : ℝ) ^ (-2 * (j : ℤ))) ^ 2

theorem angP_pos (j k : ℕ) : 0 < angP j k := by rw [angP]; positivity

theorem angP_eq_sq (j k : ℕ) :
    angP j k = ((2 : ℝ) ^ (k : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) ^ 2 := by
  rw [angP, mul_pow]
  congr 1
  rw [zpow_natCast, show (4 : ℝ) = 2 ^ 2 by norm_num, ← pow_mul, ← pow_mul, mul_comm]

/-- The argument of the smooth transition. -/
def angGa (j k : ℕ) (x : ℝ) : ℝ := angP j k * x ^ 2 - 1

/-- The angular cutoff as a function of the determinant. -/
def angG (j k : ℕ) (x : ℝ) : ℝ := Real.smoothTransition (angGa j k x)

/-- Its first derivative. -/
def angG1 (j k : ℕ) (x : ℝ) : ℝ :=
  deriv Real.smoothTransition (angGa j k x) * (2 * angP j k * x)

/-- Its second derivative. -/
def angG2 (j k : ℕ) (x : ℝ) : ℝ :=
  deriv (deriv Real.smoothTransition) (angGa j k x) * (2 * angP j k * x) * (2 * angP j k * x)
    + deriv Real.smoothTransition (angGa j k x) * (2 * angP j k)

theorem angA_eq_angG (j k : ℕ) (ξ η : Pl) : angA j k ξ η = angG j k (det2 ξ η) := by
  rw [angA, angG, angGa, angP, angV, detCLM_apply, mul_pow]
  congr 2
  ring

theorem hasDerivAt_angGa (j k : ℕ) (x : ℝ) :
    HasDerivAt (angGa j k) (2 * angP j k * x) x := by
  have h : HasDerivAt (fun y : ℝ => y ^ 2) (2 * x) x := by
    have := hasDerivAt_pow 2 x
    simpa using this
  have h2 : HasDerivAt (fun y : ℝ => angP j k * y ^ 2) (angP j k * (2 * x)) x :=
    h.const_mul (angP j k)
  have h3 := h2.sub_const 1
  refine h3.congr_deriv ?_
  ring

theorem contDiff_angG (j k : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angG j k) :=
  contDiff_st.comp ((contDiff_const.mul (contDiff_id.pow 2)).sub contDiff_const)

theorem hasDerivAt_angG (j k : ℕ) (x : ℝ) : HasDerivAt (angG j k) (angG1 j k x) x := by
  have hst : HasDerivAt Real.smoothTransition
      (deriv Real.smoothTransition (angGa j k x)) (angGa j k x) :=
    (contDiff_st.differentiable (by simp)).differentiableAt.hasDerivAt
  exact hst.comp x (hasDerivAt_angGa j k x)

theorem hasDerivAt_angG1 (j k : ℕ) (x : ℝ) : HasDerivAt (angG1 j k) (angG2 j k x) x := by
  have hst : HasDerivAt (deriv Real.smoothTransition)
      (deriv (deriv Real.smoothTransition) (angGa j k x)) (angGa j k x) :=
    (contDiff_deriv_st.differentiable (by simp)).differentiableAt.hasDerivAt
  have h1 : HasDerivAt (fun y => deriv Real.smoothTransition (angGa j k y))
      (deriv (deriv Real.smoothTransition) (angGa j k x) * (2 * angP j k * x)) x :=
    hst.comp x (hasDerivAt_angGa j k x)
  have h2 : HasDerivAt (fun y : ℝ => 2 * angP j k * y) (2 * angP j k) x := by
    have := (hasDerivAt_id x).const_mul (2 * angP j k)
    simpa using this
  exact h1.mul h2

/-- The key global bound: `|x| |G'(x)| ≤ 4 C`. -/
theorem abs_mul_angG1_le {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (j k : ℕ) (x : ℝ) : |x| * |angG1 j k x| ≤ 4 * C := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC 0)
  have hPpos := angP_pos j k
  rcases le_or_gt (angGa j k x) 0 with hle | hgt
  · rw [angG1, deriv_st_eq_zero_of_nonpos hle, zero_mul, abs_zero, mul_zero]
    linarith
  rcases le_or_gt 1 (angGa j k x) with hge | hlt
  · rw [angG1, deriv_st_eq_zero_of_one_le hge, zero_mul, abs_zero, mul_zero]
    linarith
  · -- the transition zone: `angP * x^2 < 2`
    have hbd : angP j k * x ^ 2 < 2 := by rw [angGa] at hlt; linarith
    have hkey : |x| * |angG1 j k x|
        = |deriv Real.smoothTransition (angGa j k x)| * (2 * (angP j k * x ^ 2)) := by
      rw [angG1, abs_mul, abs_mul, abs_mul]
      rw [show |(2 : ℝ)| = 2 by rw [abs_of_pos]; norm_num]
      rw [abs_of_pos hPpos]
      have hx2 : |x| * |x| = x ^ 2 := by rw [← abs_mul, ← sq, abs_sq]
      ring_nf
      rw [← hx2]
      ring
    rw [hkey]
    have h1 := hC (angGa j k x)
    have h2 : (0 : ℝ) ≤ angP j k * x ^ 2 := by positivity
    nlinarith [abs_nonneg (deriv Real.smoothTransition (angGa j k x))]

/-- The global bound `|G'(x)| ≤ 3 C 2^k 2^{-2j}`. -/
theorem abs_angG1_le {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (j k : ℕ) (x : ℝ) :
    |angG1 j k x| ≤ 3 * C * ((2 : ℝ) ^ (k : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC 0)
  have hPpos := angP_pos j k
  set q : ℝ := (2 : ℝ) ^ (k : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ)) with hq
  have hqpos : 0 < q := by rw [hq]; positivity
  have hPq : angP j k = q ^ 2 := by rw [angP_eq_sq, hq]
  rcases le_or_gt (angGa j k x) 0 with hle | hgt
  · rw [angG1, deriv_st_eq_zero_of_nonpos hle, zero_mul, abs_zero]
    positivity
  rcases le_or_gt 1 (angGa j k x) with hge | hlt
  · rw [angG1, deriv_st_eq_zero_of_one_le hge, zero_mul, abs_zero]
    positivity
  · have hbd : angP j k * x ^ 2 < 2 := by rw [angGa] at hlt; linarith
    have hstep : |angG1 j k x|
        = |deriv Real.smoothTransition (angGa j k x)| * (2 * angP j k * |x|) := by
      rw [angG1, abs_mul, abs_mul, abs_mul]
      rw [show |(2 : ℝ)| = 2 by rw [abs_of_pos]; norm_num, abs_of_pos hPpos]
    -- `(2 P |x|)^2 = 4 P (P x^2) < 8 P = 8 q^2 < (3 q)^2`
    have hbd' : q ^ 2 * x ^ 2 < 2 := by rw [← hPq]; exact hbd
    have hx2 : |x| ^ 2 = x ^ 2 := sq_abs x
    have hexp : (2 * angP j k * |x|) ^ 2 = 4 * angP j k * (angP j k * x ^ 2) := by
      rw [← hx2]; ring
    have hmul : 4 * q ^ 2 * (q ^ 2 * x ^ 2) < 4 * q ^ 2 * 2 :=
      mul_lt_mul_of_pos_left hbd' (by positivity)
    have hsq : (2 * angP j k * |x|) ^ 2 < (3 * q) ^ 2 := by
      rw [hexp, hPq]
      nlinarith [hmul, pow_pos hqpos 2]
    have hnn : 0 ≤ 2 * angP j k * |x| := by positivity
    have hlin : 2 * angP j k * |x| < 3 * q := by
      by_contra hcon
      push_neg at hcon
      have h3 : (0 : ℝ) ≤ 3 * q := by positivity
      have h2 : (3 * q) ^ 2 ≤ (2 * angP j k * |x|) ^ 2 := pow_le_pow_left₀ h3 hcon 2
      linarith
    have h1 := hC (angGa j k x)
    rw [hstep]
    nlinarith [abs_nonneg (deriv Real.smoothTransition (angGa j k x))]

/-- The key global bound: `x² |G''(x)| ≤ 20 C`. -/
theorem sq_mul_angG2_le {C : ℝ} (hC1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (hC2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ C)
    (j k : ℕ) (x : ℝ) : x ^ 2 * |angG2 j k x| ≤ 20 * C := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC1 0)
  have hPpos := angP_pos j k
  rcases le_or_gt (angGa j k x) 0 with hle | hgt
  · rw [angG2, deriv_st_eq_zero_of_nonpos hle, deriv2_st_eq_zero_of_nonpos hle]
    simp only [zero_mul, mul_zero, zero_add, abs_zero, mul_zero]
    linarith
  rcases le_or_gt 1 (angGa j k x) with hge | hlt
  · rw [angG2, deriv_st_eq_zero_of_one_le hge, deriv2_st_eq_zero_of_one_le hge]
    simp only [zero_mul, mul_zero, zero_add, abs_zero, mul_zero]
    linarith
  · have hbd : angP j k * x ^ 2 < 2 := by rw [angGa] at hlt; linarith
    set A : ℝ := deriv (deriv Real.smoothTransition) (angGa j k x) with hA
    set D : ℝ := deriv Real.smoothTransition (angGa j k x) with hD
    have hAb := hC2 (angGa j k x)
    have hDb := hC1 (angGa j k x)
    rw [← hA] at hAb
    rw [← hD] at hDb
    have hexp : x ^ 2 * |angG2 j k x|
        ≤ x ^ 2 * (|A| * (2 * angP j k * |x|) * (2 * angP j k * |x|)
            + |D| * (2 * angP j k)) := by
      refine mul_le_mul_of_nonneg_left ?_ (sq_nonneg x)
      rw [angG2, ← hA, ← hD]
      refine le_trans (abs_add_le _ _) ?_
      rw [abs_mul, abs_mul, abs_mul, abs_mul, abs_mul,
        show |(2 : ℝ)| = 2 by rw [abs_of_pos]; norm_num, abs_of_pos hPpos,
        abs_of_pos (show (0 : ℝ) < 2 * angP j k by positivity)]
    refine le_trans hexp ?_
    have hx2 : |x| ^ 2 = x ^ 2 := sq_abs x
    have hrw : x ^ 2 * (|A| * (2 * angP j k * |x|) * (2 * angP j k * |x|)
          + |D| * (2 * angP j k))
        = 4 * |A| * (angP j k * x ^ 2) * (angP j k * x ^ 2)
          + 2 * |D| * (angP j k * x ^ 2) := by
      rw [← hx2]
      ring
    rw [hrw]
    have hP2 : (0 : ℝ) ≤ angP j k * x ^ 2 := by positivity
    have hAnn : (0 : ℝ) ≤ |A| := abs_nonneg _
    have hDnn : (0 : ℝ) ≤ |D| := abs_nonneg _
    have hkey1 : |A| * (angP j k * x ^ 2) ≤ C * 2 :=
      mul_le_mul hAb (le_of_lt hbd) hP2 hCnn
    have hkey2 : |D| * (angP j k * x ^ 2) ≤ C * 2 :=
      mul_le_mul hDb (le_of_lt hbd) hP2 hCnn
    have hkey3 : |A| * (angP j k * x ^ 2) * (angP j k * x ^ 2) ≤ C * 2 * 2 :=
      mul_le_mul hkey1 (le_of_lt hbd) hP2 (by linarith)
    nlinarith [hkey2, hkey3]

end AngG


/-! ### The angular pieces as functions of the determinant -/

section AngH

/-- The `m`-th angular piece as a function of the determinant. -/
def angH (j M m : ℕ) (x : ℝ) : ℝ :=
  if m = 0 then angG j 0 x
  else if m ≤ M then angG j m x - angG j (m - 1) x
  else 1 - angG j M x

/-- Its first derivative. -/
def angH1 (j M m : ℕ) (x : ℝ) : ℝ :=
  if m = 0 then angG1 j 0 x
  else if m ≤ M then angG1 j m x - angG1 j (m - 1) x
  else -angG1 j M x

/-- Its second derivative. -/
def angH2 (j M m : ℕ) (x : ℝ) : ℝ :=
  if m = 0 then angG2 j 0 x
  else if m ≤ M then angG2 j m x - angG2 j (m - 1) x
  else -angG2 j M x

theorem angPsi_eq_angH (j M m : ℕ) (ξ η : Pl) :
    angPsi j M m ξ η = angH j M m (det2 ξ η) := by
  rw [angPsi, angH]
  split_ifs <;> rw [angA_eq_angG] <;> try rw [angA_eq_angG]

theorem hasDerivAt_angH (j M m : ℕ) (x : ℝ) :
    HasDerivAt (angH j M m) (angH1 j M m x) x := by
  have hfun : ∀ y, angH j M m y
      = if m = 0 then angG j 0 y
        else if m ≤ M then angG j m y - angG j (m - 1) y
        else 1 - angG j M y := fun y => by rw [angH]
  by_cases h0 : m = 0
  · have he : angH j M m = angG j 0 := by
      funext y; rw [hfun y]; simp [h0]
    have hd : angH1 j M m x = angG1 j 0 x := by rw [angH1]; simp [h0]
    rw [he, hd]
    exact hasDerivAt_angG j 0 x
  · by_cases hM : m ≤ M
    · have he : angH j M m = fun y => angG j m y - angG j (m - 1) y := by
        funext y; rw [hfun y]; simp [h0, hM]
      have hd : angH1 j M m x = angG1 j m x - angG1 j (m - 1) x := by
        rw [angH1]; simp [h0, hM]
      rw [he, hd]
      exact (hasDerivAt_angG j m x).sub (hasDerivAt_angG j (m - 1) x)
    · have he : angH j M m = fun y => 1 - angG j M y := by
        funext y; rw [hfun y]; simp [h0, hM]
      have hd : angH1 j M m x = -angG1 j M x := by rw [angH1]; simp [h0, hM]
      rw [he, hd]
      exact (hasDerivAt_angG j M x).const_sub 1

theorem hasDerivAt_angH1 (j M m : ℕ) (x : ℝ) :
    HasDerivAt (angH1 j M m) (angH2 j M m x) x := by
  have hfun : ∀ y, angH1 j M m y
      = if m = 0 then angG1 j 0 y
        else if m ≤ M then angG1 j m y - angG1 j (m - 1) y
        else -angG1 j M y := fun y => by rw [angH1]
  by_cases h0 : m = 0
  · have he : angH1 j M m = angG1 j 0 := by
      funext y; rw [hfun y]; simp [h0]
    have hd : angH2 j M m x = angG2 j 0 x := by rw [angH2]; simp [h0]
    rw [he, hd]
    exact hasDerivAt_angG1 j 0 x
  · by_cases hM : m ≤ M
    · have he : angH1 j M m = fun y => angG1 j m y - angG1 j (m - 1) y := by
        funext y; rw [hfun y]; simp [h0, hM]
      have hd : angH2 j M m x = angG2 j m x - angG2 j (m - 1) x := by
        rw [angH2]; simp [h0, hM]
      rw [he, hd]
      exact (hasDerivAt_angG1 j m x).sub (hasDerivAt_angG1 j (m - 1) x)
    · have he : angH1 j M m = fun y => -angG1 j M y := by
        funext y; rw [hfun y]; simp [h0, hM]
      have hd : angH2 j M m x = -angG2 j M x := by rw [angH2]; simp [h0, hM]
      rw [he, hd]
      exact (hasDerivAt_angG1 j M x).neg

theorem contDiff_angH (j M m : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angH j M m) := by
  have hfun : ∀ y, angH j M m y
      = if m = 0 then angG j 0 y
        else if m ≤ M then angG j m y - angG j (m - 1) y
        else 1 - angG j M y := fun y => by rw [angH]
  by_cases h0 : m = 0
  · have he : angH j M m = angG j 0 := by funext y; rw [hfun y]; simp [h0]
    rw [he]; exact contDiff_angG j 0
  · by_cases hM : m ≤ M
    · have he : angH j M m = fun y => angG j m y - angG j (m - 1) y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact (contDiff_angG j m).sub (contDiff_angG j (m - 1))
    · have he : angH j M m = fun y => 1 - angG j M y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact contDiff_const.sub (contDiff_angG j M)

theorem abs_mul_angH1_le {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (j M m : ℕ) (x : ℝ) : |x| * |angH1 j M m x| ≤ 8 * C := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC 0)
  have hbase : ∀ k : ℕ, |x| * |angG1 j k x| ≤ 4 * C := fun k =>
    abs_mul_angG1_le hC j k x
  rw [angH1]
  split_ifs with h0 hM
  · have := hbase 0; linarith
  · refine le_trans (mul_le_mul_of_nonneg_left (abs_sub _ _) (abs_nonneg x)) ?_
    rw [mul_add]
    have h1 := hbase m
    have h2 := hbase (m - 1)
    linarith
  · rw [abs_neg]
    have := hbase M; linarith

theorem sq_mul_angH2_le {C : ℝ} (hC1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (hC2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ C)
    (j M m : ℕ) (x : ℝ) : x ^ 2 * |angH2 j M m x| ≤ 40 * C := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC1 0)
  have hbase : ∀ k : ℕ, x ^ 2 * |angG2 j k x| ≤ 20 * C := fun k =>
    sq_mul_angG2_le hC1 hC2 j k x
  rw [angH2]
  split_ifs with h0 hM
  · have := hbase 0; linarith
  · refine le_trans (mul_le_mul_of_nonneg_left (abs_sub _ _) (sq_nonneg x)) ?_
    rw [mul_add]
    have h1 := hbase m
    have h2 := hbase (m - 1)
    linarith
  · rw [abs_neg]
    have := hbase M; linarith

theorem abs_angH1_le {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (j M m : ℕ) (x : ℝ) :
    |angH1 j M m x| ≤ 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC 0)
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-2 * (j : ℤ)) := by positivity
  have hbase : ∀ k : ℕ, k ≤ m →
      |angG1 j k x| ≤ 3 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
    intro k hk
    refine le_trans (abs_angG1_le hC j k x) ?_
    have hpow : (2 : ℝ) ^ (k : ℤ) ≤ (2 : ℝ) ^ (m : ℤ) := by
      refine zpow_le_zpow_right₀ (by norm_num) ?_
      exact_mod_cast hk
    have h3 : (0 : ℝ) ≤ 3 * C := by linarith
    refine mul_le_mul_of_nonneg_left ?_ h3
    exact mul_le_mul_of_nonneg_right hpow (le_of_lt hcpos)
  have hprod : (0 : ℝ) ≤ C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) := by positivity
  rw [angH1]
  split_ifs with h0 hM
  · have := hbase 0 (by omega); linarith
  · refine le_trans (abs_sub _ _) ?_
    have h1 := hbase m (le_refl m)
    have h2 := hbase (m - 1) (by omega)
    linarith
  · rw [abs_neg]
    have := hbase M (by omega)
    linarith

theorem angG_nonneg (j k : ℕ) (x : ℝ) : 0 ≤ angG j k x := Real.smoothTransition.nonneg _

theorem angG_le_one (j k : ℕ) (x : ℝ) : angG j k x ≤ 1 := Real.smoothTransition.le_one _

theorem angG_mono {j : ℕ} {k l : ℕ} (hkl : k ≤ l) (x : ℝ) : angG j k x ≤ angG j l x := by
  rw [angG, angG]
  refine Real.smoothTransition.monotone ?_
  rw [angGa, angGa]
  have hP : angP j k ≤ angP j l := by
    rw [angP, angP]
    refine mul_le_mul_of_nonneg_right ?_ (by positivity)
    exact pow_le_pow_right₀ (by norm_num) hkl
  nlinarith [sq_nonneg x]

theorem angH_nonneg (j M m : ℕ) (x : ℝ) : 0 ≤ angH j M m x := by
  rw [angH]
  split_ifs with h0 hM
  · exact angG_nonneg j 0 x
  · have := angG_mono (j := j) (show m - 1 ≤ m by omega) x; linarith
  · have := angG_le_one j M x; linarith

theorem angH_le_one (j M m : ℕ) (x : ℝ) : angH j M m x ≤ 1 := by
  rw [angH]
  split_ifs with h0 hM
  · exact angG_le_one j 0 x
  · have h1 := angG_le_one j m x
    have h2 := angG_nonneg j (m - 1) x
    linarith
  · have := angG_nonneg j M x; linarith

theorem abs_angH_le_one (j M m : ℕ) (x : ℝ) : |angH j M m x| ≤ 1 :=
  abs_le.mpr ⟨by linarith [angH_nonneg j M m x], angH_le_one j M m x⟩

/-- The angular pieces sum to one. -/
theorem sum_angH (j M : ℕ) (x : ℝ) : ∑ m ∈ Finset.range (M + 2), angH j M m x = 1 := by
  have h : ∀ m, angH j M m x = angPsi j M m (mk2 1 0) (mk2 0 x) := by
    intro m
    rw [angPsi_eq_angH]
    congr 1
    rw [det2, mk2_apply_zero, mk2_apply_one, mk2_apply_zero, mk2_apply_one]
    ring
  rw [Finset.sum_congr rfl fun m _ => h m]
  exact sum_angPsi j M _ _

end AngH


/-! ### Smoothness of the angular derivatives -/

section AngSmooth

theorem contDiff_deriv2_st :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (deriv Real.smoothTransition)) := by
  have h : ContDiff ℝ ((↑(⊤ : ℕ∞)) + 1) (deriv Real.smoothTransition) := by
    simpa using contDiff_deriv_st
  exact h.deriv'

theorem contDiff_angGa (j k : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angGa j k) := by
  have h : angGa j k = fun x : ℝ => angP j k * x ^ 2 - 1 := rfl
  rw [h]
  exact (contDiff_const.mul (contDiff_id.pow 2)).sub contDiff_const

theorem contDiff_angG1 (j k : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angG1 j k) := by
  have h : angG1 j k = fun x : ℝ =>
      deriv Real.smoothTransition (angGa j k x) * (2 * angP j k * x) := rfl
  rw [h]
  exact (contDiff_deriv_st.comp (contDiff_angGa j k)).mul
    (contDiff_const.mul contDiff_id)

theorem contDiff_angG2 (j k : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angG2 j k) := by
  have h : angG2 j k = fun x : ℝ =>
      deriv (deriv Real.smoothTransition) (angGa j k x) * (2 * angP j k * x)
          * (2 * angP j k * x)
        + deriv Real.smoothTransition (angGa j k x) * (2 * angP j k) := rfl
  rw [h]
  refine ContDiff.add ?_ ?_
  · exact ((contDiff_deriv2_st.comp (contDiff_angGa j k)).mul
      (contDiff_const.mul contDiff_id)).mul (contDiff_const.mul contDiff_id)
  · exact (contDiff_deriv_st.comp (contDiff_angGa j k)).mul contDiff_const

theorem contDiff_angH1 (j M m : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angH1 j M m) := by
  have hfun : ∀ y, angH1 j M m y
      = if m = 0 then angG1 j 0 y
        else if m ≤ M then angG1 j m y - angG1 j (m - 1) y
        else -angG1 j M y := fun y => by rw [angH1]
  by_cases h0 : m = 0
  · have he : angH1 j M m = angG1 j 0 := by funext y; rw [hfun y]; simp [h0]
    rw [he]; exact contDiff_angG1 j 0
  · by_cases hM : m ≤ M
    · have he : angH1 j M m = fun y => angG1 j m y - angG1 j (m - 1) y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact (contDiff_angG1 j m).sub (contDiff_angG1 j (m - 1))
    · have he : angH1 j M m = fun y => -angG1 j M y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact (contDiff_angG1 j M).neg

theorem contDiff_angH2 (j M m : ℕ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (angH2 j M m) := by
  have hfun : ∀ y, angH2 j M m y
      = if m = 0 then angG2 j 0 y
        else if m ≤ M then angG2 j m y - angG2 j (m - 1) y
        else -angG2 j M y := fun y => by rw [angH2]
  by_cases h0 : m = 0
  · have he : angH2 j M m = angG2 j 0 := by funext y; rw [hfun y]; simp [h0]
    rw [he]; exact contDiff_angG2 j 0
  · by_cases hM : m ≤ M
    · have he : angH2 j M m = fun y => angG2 j m y - angG2 j (m - 1) y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact (contDiff_angG2 j m).sub (contDiff_angG2 j (m - 1))
    · have he : angH2 j M m = fun y => -angG2 j M y := by
        funext y; rw [hfun y]; simp [h0, hM]
      rw [he]; exact (contDiff_angG2 j M).neg

theorem continuous_angH2 (j M m : ℕ) : Continuous (angH2 j M m) :=
  (contDiff_angH2 j M m).continuous

theorem contDiff_angHdet (j M m : ℕ) (ξ : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (fun y : Pl => ((angH j M m (det2 ξ y) : ℝ) : ℂ)) := by
  have h : (fun y : Pl => ((angH j M m (det2 ξ y) : ℝ) : ℂ))
      = fun y : Pl => ((angH j M m (detCLM ξ y) : ℝ) : ℂ) := by
    funext y; rw [detCLM_apply]
  rw [h]
  exact Complex.ofRealCLM.contDiff.comp ((contDiff_angH j M m).comp (detCLM ξ).contDiff)

end AngSmooth

/-! ### The `η`-derivative of an angular piece -/

section AngFDeriv

theorem hasFDerivAt_angHdet (j M m : ℕ) (ξ η : Pl) :
    HasFDerivAt (fun y : Pl => ((angH j M m (det2 ξ y) : ℝ) : ℂ))
      (Complex.ofRealCLM.comp
        ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
          (detCLM ξ))) η := by
  have h0 : HasFDerivAt (fun y : Pl => detCLM ξ y) (detCLM ξ) η := (detCLM ξ).hasFDerivAt
  have h1 : HasFDerivAt (angH j M m)
      (ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η)))
      (detCLM ξ η) := by
    rw [detCLM_apply]
    exact (hasDerivAt_angH j M m (det2 ξ η)).hasFDerivAt
  have h2 : HasFDerivAt (fun y : Pl => angH j M m (detCLM ξ y))
      ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
        (detCLM ξ)) η := h1.comp η h0
  have h3 := (Complex.ofRealCLM.hasFDerivAt
    (x := angH j M m (detCLM ξ η))).comp η h2
  have hfun : (fun y : Pl => ((angH j M m (det2 ξ y) : ℝ) : ℂ))
      = Complex.ofRealCLM ∘ fun y : Pl => angH j M m (detCLM ξ y) := by
    funext y
    simp only [Function.comp_apply, detCLM_apply, Complex.ofRealCLM_apply]
  rw [hfun]
  exact h3

theorem norm_angHdet_deriv_apply {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (j M m : ℕ) (ξ η u : Pl) :
    ‖(Complex.ofRealCLM.comp
        ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
          (detCLM ξ))) u‖
      ≤ 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) * (2 * ‖ξ‖) * ‖u‖ := by
  have hval : (Complex.ofRealCLM.comp
      ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
        (detCLM ξ))) u
      = ((det2 ξ u * angH1 j M m (det2 ξ η) : ℝ) : ℂ) := by
    rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.comp_apply,
      ContinuousLinearMap.smulRight_apply, Complex.ofRealCLM_apply, detCLM_apply]
    congr 1
  rw [hval, Complex.norm_real, Real.norm_eq_abs, abs_mul]
  have hdet : |det2 ξ u| ≤ 2 * ‖ξ‖ * ‖u‖ := by
    have h := (detCLM ξ).le_opNorm u
    rw [detCLM_apply, Real.norm_eq_abs] at h
    refine le_trans h ?_
    exact mul_le_mul_of_nonneg_right (norm_detCLM_le ξ) (norm_nonneg u)
  have hH := abs_angH1_le hC j M m (det2 ξ η)
  have hCnn : 0 ≤ C := le_trans (abs_nonneg _) (hC 0)
  have hK : (0 : ℝ) ≤ 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
    positivity
  calc |det2 ξ u| * |angH1 j M m (det2 ξ η)|
      ≤ (2 * ‖ξ‖ * ‖u‖) * (6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ)))) :=
        mul_le_mul hdet hH (abs_nonneg _) (by positivity)
    _ = 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) * (2 * ‖ξ‖) * ‖u‖ := by ring

end AngFDeriv


/-! ### The angular pieces of a symbol -/

section BPiece

/-- The `m`-th angular piece of a symbol. -/
def bpiece (j M m : ℕ) (b : ℝ → Pl → Pl → ℂ) : ℝ → Pl → Pl → ℂ :=
  fun t ξ η => b t ξ η * ((angH j M m (det2 ξ η) : ℝ) : ℂ)

theorem sum_bpiece (j M : ℕ) (b : ℝ → Pl → Pl → ℂ) (t : ℝ) (ξ η : Pl) :
    ∑ m ∈ Finset.range (M + 2), bpiece j M m b t ξ η = b t ξ η := by
  have h : ∀ m : ℕ, bpiece j M m b t ξ η
      = b t ξ η * ((angH j M m (det2 ξ η) : ℝ) : ℂ) := fun m => rfl
  rw [Finset.sum_congr rfl fun m _ => h m, ← Finset.mul_sum, ← Complex.ofReal_sum,
    sum_angH]
  norm_num

/-- The angle bound on the support of the `m`-th piece, including `m = 0`. -/
theorem angle_le_of_angPsi_ne' {j M m : ℕ} {ξ η : Pl} (hmM : m ≤ M + 1)
    (hsupp : η ∈ SuppSet j 0 ξ) (h : angPsi j M m ξ η ≠ 0) :
    InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ)) := by
  rcases Nat.eq_zero_or_pos m with h0 | hpos
  · subst h0
    have h1 : InnerProductGeometry.angle ξ η ≤ π := InnerProductGeometry.angle_le_pi ξ η
    have h2 : π ≤ 4 := Real.pi_le_four
    have h3 : (2 : ℝ) ^ (5 - ((0 : ℕ) : ℤ)) = 32 := by norm_num
    rw [h3]
    linarith
  · exact angle_le_of_angPsi_ne hpos hmM hsupp h

theorem angH_ne_zero_of_bpiece {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {t : ℝ} {ξ η : Pl}
    (h : bpiece j M m b t ξ η ≠ 0) : angPsi j M m ξ η ≠ 0 := by
  rw [angPsi_eq_angH]
  intro h0
  refine h ?_
  rw [bpiece, h0]
  norm_num

theorem base_ne_zero_of_bpiece {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {t : ℝ} {ξ η : Pl}
    (h : bpiece j M m b t ξ η ≠ 0) : b t ξ η ≠ 0 := by
  intro h0
  refine h ?_
  rw [bpiece, h0, zero_mul]

theorem mem_suppSet_of_bpiece {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hsupp : ∀ t ξ η, η ∉ SuppSet j 0 ξ → b t ξ η = 0) {t : ℝ} {ξ η : Pl}
    (h : bpiece j M m b t ξ η ≠ 0) : η ∈ SuppSet j 0 ξ := by
  by_contra hcon
  exact base_ne_zero_of_bpiece h (hsupp t ξ η hcon)

theorem bpiece_supp {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ t ξ η, η ∉ SuppSet j 0 ξ → b t ξ η = 0) (hmM : m ≤ M + 1)
    (t : ℝ) (ξ η : Pl) (hη : η ∉ SuppSet j m ξ) : bpiece j M m b t ξ η = 0 := by
  by_contra hne
  have hmem : η ∈ SuppSet j 0 ξ := mem_suppSet_of_bpiece (B := (0 : ℝ)) hsupp hne
  refine hη ⟨hmem.1, hmem.2.1, ?_⟩
  exact angle_le_of_angPsi_ne' hmM hmem (angH_ne_zero_of_bpiece hne)

theorem bpiece_strict_supp {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ}
    (hsupp : ∀ t ξ η, η ∉ SuppSet j 0 ξ → b t ξ η = 0) (hmM : m ≤ M)
    (t : ℝ) (ξ η : Pl) (hη : η ∉ SuppSetStrict j m ξ) : bpiece j M m b t ξ η = 0 := by
  by_contra hne
  have hmem : η ∈ SuppSet j 0 ξ := mem_suppSet_of_bpiece (B := (0 : ℝ)) hsupp hne
  have hψ := angH_ne_zero_of_bpiece hne
  refine hη ⟨⟨hmem.1, hmem.2.1, angle_le_of_angPsi_ne' (by omega) hmem hψ⟩, ?_⟩
  exact angle_ge_of_angPsi_ne hmM hmem hψ

theorem measurable_bpiece {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {t : ℝ}
    (hb : Measurable fun p : Pl × Pl => b t p.1 p.2) :
    Measurable fun p : Pl × Pl => bpiece j M m b t p.1 p.2 := by
  have hdet : Continuous fun p : Pl × Pl => det2 p.1 p.2 := by
    have hc : ∀ i : Fin 2, Continuous fun x : Pl => x i := fun i => by
      have h : (fun x : Pl => x i) = fun x : Pl => prj i x := by
        funext x; rw [prj_apply]
      rw [h]
      exact (prj i).continuous
    have h : (fun p : Pl × Pl => det2 p.1 p.2)
        = fun p : Pl × Pl => p.1 0 * p.2 1 - p.1 1 * p.2 0 := rfl
    rw [h]
    exact (((hc 0).comp continuous_fst).mul ((hc 1).comp continuous_snd)).sub
      (((hc 1).comp continuous_fst).mul ((hc 0).comp continuous_snd))
  have hang : Measurable fun p : Pl × Pl => ((angH j M m (det2 p.1 p.2) : ℝ) : ℂ) :=
    (Complex.continuous_ofReal.comp
      ((contDiff_angH j M m).continuous.comp hdet)).measurable
  exact hb.mul hang

/-- The symbol data of an angular piece. -/
theorem bpiece_symbData {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hb : SymbData j 0 b B) (hmM : m ≤ M + 1)
    {C : ℝ} (hC : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C) (hC1 : 1 ≤ C) :
    SymbData j m (bpiece j M m b) ((1 + 192 * C) * B) := by
  have hBnn : 0 ≤ B := hb.nonneg
  have hCnn : (0 : ℝ) ≤ C := by linarith
  refine ⟨fun t ξ => (hb.smooth t ξ).mul (contDiff_angHdet j M m ξ),
    bpiece_supp hb.supp hmM, ?_, ?_⟩
  · intro t ξ η
    have h1 : ‖bpiece j M m b t ξ η‖
        = ‖b t ξ η‖ * |angH j M m (det2 ξ η)| := by
      rw [bpiece, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    rw [h1]
    have h2 := hb.bd0 t ξ η
    have h3 := abs_angH_le_one j M m (det2 ξ η)
    have h4 : (0 : ℝ) ≤ ‖b t ξ η‖ := norm_nonneg _
    nlinarith [abs_nonneg (angH j M m (det2 ξ η))]
  · intro t ξ η u hu
    set R : ℝ := (2 : ℝ) ^ ((m : ℤ) - (j : ℤ)) with hR
    have hRpos : (0 : ℝ) < R := by rw [hR]; positivity
    have hgoal : (2 : ℝ) ^ (-((j : ℤ) - (m : ℤ))) = R := by
      rw [hR]; congr 1; ring
    rw [hgoal]
    have hbd : HasFDerivAt (b t ξ) (fderiv ℝ (b t ξ) η) η :=
      ((hb.smooth t ξ).differentiable (by simp)).differentiableAt.hasFDerivAt
    have hdd := hasFDerivAt_angHdet j M m ξ η
    have hmul : HasFDerivAt (bpiece j M m b t ξ)
        (b t ξ η • (Complex.ofRealCLM.comp
            ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
              (detCLM ξ)))
          + ((angH j M m (det2 ξ η) : ℝ) : ℂ) • fderiv ℝ (b t ξ) η) η := hbd.mul hdd
    rw [hmul.fderiv, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply]
    refine le_trans (norm_add_le _ _) ?_
    rw [norm_smul, norm_smul]
    -- the second term
    have hterm2 : ‖((angH j M m (det2 ξ η) : ℝ) : ℂ)‖ * ‖fderiv ℝ (b t ξ) η u‖ ≤ B * R := by
      have h1 : ‖((angH j M m (det2 ξ η) : ℝ) : ℂ)‖ ≤ 1 := by
        rw [Complex.norm_real, Real.norm_eq_abs]
        exact abs_angH_le_one j M m (det2 ξ η)
      have h2 := hb.bd1 t ξ η u hu
      have h3 : (2 : ℝ) ^ (-((j : ℤ) - ((0 : ℕ) : ℤ))) ≤ R := by
        rw [hR]
        refine zpow_le_zpow_right₀ (by norm_num) ?_
        simp
      have h4 : ‖fderiv ℝ (b t ξ) η u‖ ≤ B * R := by
        refine le_trans h2 ?_
        exact mul_le_mul_of_nonneg_left h3 hBnn
      have h5 : (0 : ℝ) ≤ ‖fderiv ℝ (b t ξ) η u‖ := norm_nonneg _
      nlinarith [norm_nonneg ((angH j M m (det2 ξ η) : ℝ) : ℂ)]
    -- the first term
    have hterm1 : ‖b t ξ η‖ * ‖(Complex.ofRealCLM.comp
        ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
          (detCLM ξ))) u‖ ≤ 48 * C * B * R := by
      rcases eq_or_ne (b t ξ η) 0 with hb0 | hb0
      · rw [hb0, norm_zero, zero_mul]
        positivity
      · have hmem : η ∈ SuppSet j 0 ξ := by
          by_contra hcon
          exact hb0 (hb.supp t ξ η hcon)
        have hxi := xiData_of_mem hmem
        have hxn : ‖ξ‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := hxi.norm_le
        have hnd := norm_angHdet_deriv_apply hC j M m ξ η u
        rw [hu, mul_one] at hnd
        have hstep : 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) * (2 * ‖ξ‖)
            ≤ 48 * C * R := by
          have hkey : (2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))
              * (2 * (2 : ℝ) ^ ((j : ℤ) + 2)) = 8 * R := by
            have e1 : (2 : ℝ) * (2 : ℝ) ^ ((j : ℤ) + 2) = (2 : ℝ) ^ ((j : ℤ) + 3) := by
              rw [show (j : ℤ) + 3 = ((j : ℤ) + 2) + 1 by ring, two_zpow_succ_sub]
            have eL : (2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))
                * (2 * (2 : ℝ) ^ ((j : ℤ) + 2))
                = (2 : ℝ) ^ ((m : ℤ) - (j : ℤ) + 3) := by
              rw [e1, ← two_zpow_add, ← two_zpow_add]
              congr 1
              ring
            have eR : (8 : ℝ) * (2 : ℝ) ^ ((m : ℤ) - (j : ℤ))
                = (2 : ℝ) ^ ((m : ℤ) - (j : ℤ) + 3) := by
              rw [show (8 : ℝ) = (2 : ℝ) ^ (3 : ℤ) by norm_num, ← two_zpow_add]
              congr 1
              ring
            rw [hR, eL, eR]
          have hmono : (2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ)) * (2 * ‖ξ‖)
              ≤ (2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ)) * (2 * (2 : ℝ) ^ ((j : ℤ) + 2)) := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            linarith
          have h6 : (0 : ℝ) ≤ 6 * C := by linarith
          calc 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ))) * (2 * ‖ξ‖)
              = 6 * C * ((2 : ℝ) ^ (m : ℤ) * (2 : ℝ) ^ (-2 * (j : ℤ)) * (2 * ‖ξ‖)) := by ring
            _ ≤ 6 * C * (8 * R) := by
                rw [← hkey]
                exact mul_le_mul_of_nonneg_left hmono h6
            _ = 48 * C * R := by ring
        have hnrm := hb.bd0 t ξ η
        have hnn : (0 : ℝ) ≤ ‖b t ξ η‖ := norm_nonneg _
        have hDDnn : (0 : ℝ) ≤ ‖(Complex.ofRealCLM.comp
            ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
              (detCLM ξ))) u‖ := norm_nonneg _
        have hDD : ‖(Complex.ofRealCLM.comp
            ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ) (angH1 j M m (det2 ξ η))).comp
              (detCLM ξ))) u‖ ≤ 48 * C * R := le_trans hnd hstep
        have h48 : (0 : ℝ) ≤ 48 * C * R := by positivity
        calc ‖b t ξ η‖ * ‖(Complex.ofRealCLM.comp
              ((ContinuousLinearMap.smulRight (1 : ℝ →L[ℝ] ℝ)
                (angH1 j M m (det2 ξ η))).comp (detCLM ξ))) u‖
            ≤ B * (48 * C * R) := mul_le_mul hnrm hDD hDDnn hBnn
          _ = 48 * C * B * R := by ring
    have hfinal : 48 * C * B * R + B * R ≤ (1 + 192 * C) * B * R := by
      have h1 : (0 : ℝ) ≤ C * B * R := by positivity
      nlinarith
    linarith

end BPiece


/-! ### The radial data of an angular piece -/

section BPieceRay

theorem symbol_ray_eq_zero' {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} (hb : IsAdapted j m b)
    (t : ℝ) (ξ : Pl) (φ : ℝ) {ρ : ℝ} (hρ : ρ ∈ OutAnn j) : b t ξ (pt ρ φ) = 0 := by
  refine hb.supp t ξ (pt ρ φ) ?_
  intro hmem
  have hT : pt ρ φ ∈ Theta j := hmem.1
  have h1 : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ |ρ| := by
    have := hT.2.2.1
    rwa [norm_pt_abs] at this
  have h2 : |ρ| ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := by
    have := hT.2.2.2
    rwa [norm_pt_abs] at this
  rcases hρ with h | h
  · exact absurd h (not_lt.mpr h1)
  · exact absurd h (not_lt.mpr h2)

theorem ray_vanish' {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hb : IsAdapted j m b) (hray : RayData j b B b1 b2)
    (t : ℝ) (ξ : Pl) (φ : ℝ) {ρ : ℝ} (hρ : ρ ∈ OutAnn j) :
    b t ξ (pt ρ φ) = 0 ∧ b1 t ξ φ ρ = 0 ∧ b2 t ξ φ ρ = 0 := by
  have hzero : ∀ r ∈ OutAnn j, b t ξ (pt r φ) = 0 := fun r hr =>
    symbol_ray_eq_zero' hb t ξ φ hr
  have hmem : ∀ r ∈ OutAnn j, (fun r => b t ξ (pt r φ)) =ᶠ[nhds r] 0 := by
    intro r hr
    refine Filter.eventuallyEq_of_mem ((isOpen_OutAnn j).mem_nhds hr) ?_
    intro x hx
    exact hzero x hx
  have h1 : ∀ r ∈ OutAnn j, b1 t ξ φ r = 0 := fun r hr =>
    deriv_eq_zero_of_eventually_zero (hray.d1 t ξ φ) (hmem r hr)
  have hmem1 : (b1 t ξ φ) =ᶠ[nhds ρ] 0 := by
    refine Filter.eventuallyEq_of_mem ((isOpen_OutAnn j).mem_nhds hρ) ?_
    intro x hx
    exact h1 x hx
  exact ⟨hzero ρ hρ, h1 ρ hρ, deriv_eq_zero_of_eventually_zero (hray.d2 t ξ φ) hmem1⟩

theorem det2_pt (ξ : Pl) (ρ φ : ℝ) : det2 ξ (pt ρ φ) = ρ * wfun ξ φ := by
  rw [pt_eq_smul ρ φ, det2_smul_right, det2_pt_one]

theorem bpiece_pt (j M m : ℕ) (b : ℝ → Pl → Pl → ℂ) (t : ℝ) (ξ : Pl) (ρ φ : ℝ) :
    bpiece j M m b t ξ (pt ρ φ)
      = b t ξ (pt ρ φ) * ((angH j M m (ρ * wfun ξ φ) : ℝ) : ℂ) := by
  rw [bpiece, det2_pt]

/-- The first radial derivative of an angular piece. -/
def bp1 (j M m : ℕ) (b : ℝ → Pl → Pl → ℂ) (b1 : ℝ → Pl → ℝ → ℝ → ℂ) :
    ℝ → Pl → ℝ → ℝ → ℂ :=
  fun t ξ φ ρ => b1 t ξ φ ρ * ((angH j M m (ρ * wfun ξ φ) : ℝ) : ℂ)
    + b t ξ (pt ρ φ) * ((angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ : ℝ) : ℂ)

/-- The second radial derivative of an angular piece. -/
def bp2 (j M m : ℕ) (b : ℝ → Pl → Pl → ℂ) (b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ) :
    ℝ → Pl → ℝ → ℝ → ℂ :=
  fun t ξ φ ρ => b2 t ξ φ ρ * ((angH j M m (ρ * wfun ξ φ) : ℝ) : ℂ)
    + 2 * b1 t ξ φ ρ * ((angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ : ℝ) : ℂ)
    + b t ξ (pt ρ φ) * ((angH2 j M m (ρ * wfun ξ φ) * wfun ξ φ ^ 2 : ℝ) : ℂ)

theorem hasDerivAt_angHlin (j M m : ℕ) (w ρ : ℝ) :
    HasDerivAt (fun r : ℝ => ((angH j M m (r * w) : ℝ) : ℂ))
      (((angH1 j M m (ρ * w) * w : ℝ) : ℂ)) ρ := by
  have hlin : HasDerivAt (fun r : ℝ => r * w) w ρ := by
    simpa using (hasDerivAt_id ρ).mul_const w
  exact ((hasDerivAt_angH j M m (ρ * w)).comp ρ hlin).ofReal_comp

theorem hasDerivAt_angH1lin (j M m : ℕ) (w ρ : ℝ) :
    HasDerivAt (fun r : ℝ => ((angH1 j M m (r * w) * w : ℝ) : ℂ))
      (((angH2 j M m (ρ * w) * w * w : ℝ) : ℂ)) ρ := by
  have hlin : HasDerivAt (fun r : ℝ => r * w) w ρ := by
    simpa using (hasDerivAt_id ρ).mul_const w
  have h1 := (hasDerivAt_angH1 j M m (ρ * w)).comp ρ hlin
  have h2 : HasDerivAt (fun r : ℝ => angH1 j M m (r * w) * w)
      (angH2 j M m (ρ * w) * w * w) ρ := h1.mul_const w
  exact h2.ofReal_comp

/-- The radial data of an angular piece. -/
theorem bpiece_rayData {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hAd : IsAdapted j 0 b) (hray : RayData j b B b1 b2)
    {C : ℝ} (hCd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ C)
    (hCd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ C) (hC1 : 1 ≤ C) :
    RayData j (bpiece j M m b) ((1 + 192 * C) * B)
      (bp1 j M m b b1) (bp2 j M m b b1 b2) := by
  have hCnn : (0 : ℝ) ≤ C := by linarith
  have hBnn : 0 ≤ B := le_trans (norm_nonneg _) (hray.bd0 0 0 0)
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · -- cont0
    intro t ξ
    exact (hray.cont0 t ξ).mul (contDiff_angHdet j M m ξ).continuous
  · -- d1
    intro t ξ φ ρ
    have hfun : (fun r => bpiece j M m b t ξ (pt r φ))
        = fun r => b t ξ (pt r φ) * ((angH j M m (r * wfun ξ φ) : ℝ) : ℂ) := by
      funext r
      rw [bpiece_pt]
    rw [hfun]
    exact (hray.d1 t ξ φ ρ).mul (hasDerivAt_angHlin j M m (wfun ξ φ) ρ)
  · -- d2
    intro t ξ φ ρ
    have hfun : bp1 j M m b b1 t ξ φ
        = fun r => b1 t ξ φ r * ((angH j M m (r * wfun ξ φ) : ℝ) : ℂ)
          + b t ξ (pt r φ) * ((angH1 j M m (r * wfun ξ φ) * wfun ξ φ : ℝ) : ℂ) := rfl
    rw [hfun]
    have p1 := (hray.d2 t ξ φ ρ).mul (hasDerivAt_angHlin j M m (wfun ξ φ) ρ)
    have p2 := (hray.d1 t ξ φ ρ).mul (hasDerivAt_angH1lin j M m (wfun ξ φ) ρ)
    refine (p1.add p2).congr_deriv ?_
    rw [bp2]
    push_cast
    ring
  · -- cont2
    intro t ξ φ
    have hbdiff : Differentiable ℝ (fun r : ℝ => b t ξ (pt r φ)) :=
      fun r => (hray.d1 t ξ φ r).differentiableAt
    have hb0 : Continuous fun r : ℝ => b t ξ (pt r φ) := hbdiff.continuous
    have hb1diff : Differentiable ℝ (b1 t ξ φ) :=
      fun r => (hray.d2 t ξ φ r).differentiableAt
    have hb1c : Continuous (b1 t ξ φ) := hb1diff.continuous
    have hb2c : Continuous (b2 t ξ φ) := hray.cont2 t ξ φ
    have hlin : Continuous fun r : ℝ => r * wfun ξ φ := continuous_id.mul continuous_const
    have hH : Continuous fun r : ℝ => ((angH j M m (r * wfun ξ φ) : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp ((contDiff_angH j M m).continuous.comp hlin)
    have hH1 : Continuous fun r : ℝ =>
        ((angH1 j M m (r * wfun ξ φ) * wfun ξ φ : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp
        (((contDiff_angH1 j M m).continuous.comp hlin).mul continuous_const)
    have hH2 : Continuous fun r : ℝ =>
        ((angH2 j M m (r * wfun ξ φ) * wfun ξ φ ^ 2 : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp
        (((contDiff_angH2 j M m).continuous.comp hlin).mul continuous_const)
    exact ((hb2c.mul hH).add ((continuous_const.mul hb1c).mul hH1)).add (hb0.mul hH2)
  · -- bd0
    intro t ξ η
    have h1 : ‖bpiece j M m b t ξ η‖ = ‖b t ξ η‖ * |angH j M m (det2 ξ η)| := by
      rw [bpiece, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    rw [h1]
    have h2 := hray.bd0 t ξ η
    have h3 := abs_angH_le_one j M m (det2 ξ η)
    have h4 : ‖b t ξ η‖ * |angH j M m (det2 ξ η)| ≤ B * 1 :=
      mul_le_mul h2 h3 (abs_nonneg _) hBnn
    nlinarith [mul_nonneg hCnn hBnn]
  · -- bd1
    intro t ξ φ ρ
    by_cases hout : ρ ∈ OutAnn j
    · obtain ⟨hz0, hz1, -⟩ := ray_vanish' hAd hray t ξ φ hout
      have hzero : bp1 j M m b b1 t ξ φ ρ = 0 := by
        rw [bp1, hz0, hz1, zero_mul, zero_mul, add_zero]
      rw [hzero, norm_zero]
      positivity
    · have hρ : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ |ρ| := by
        by_contra hcon
        push_neg at hcon
        exact hout (Or.inl hcon)
      have hρpos : (0 : ℝ) < |ρ| := lt_of_lt_of_le (by positivity) hρ
      have hinv : 1 / |ρ| ≤ (2 : ℝ) ^ (1 - (j : ℤ)) := by
        have he : (2 : ℝ) ^ (1 - (j : ℤ)) = 1 / (2 : ℝ) ^ ((j : ℤ) - 1) := by
          rw [eq_div_iff (by positivity), ← two_zpow_add,
            show 1 - (j : ℤ) + ((j : ℤ) - 1) = 0 by ring]
          norm_num
        rw [he]
        exact one_div_le_one_div_of_le (by positivity) hρ
      have hH1w : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ|
          ≤ 8 * C * (2 : ℝ) ^ (1 - (j : ℤ)) := by
        have hkey := abs_mul_angH1_le hCd1 j M m (ρ * wfun ξ φ)
        rw [abs_mul] at hkey
        have h1 : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ| * |ρ| ≤ 8 * C := by
          rw [abs_mul]
          calc |angH1 j M m (ρ * wfun ξ φ)| * |wfun ξ φ| * |ρ|
              = |ρ| * |wfun ξ φ| * |angH1 j M m (ρ * wfun ξ φ)| := by ring
            _ ≤ 8 * C := hkey
        have h2 : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ| ≤ 8 * C / |ρ| :=
          (le_div_iff₀ hρpos).mpr h1
        refine le_trans h2 ?_
        rw [div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_left hinv (by positivity)
      have hbp1 : ‖bp1 j M m b b1 t ξ φ ρ‖
          ≤ B * (2 : ℝ) ^ (-(j : ℤ)) * 1 + B * (8 * C * (2 : ℝ) ^ (1 - (j : ℤ))) := by
        rw [bp1]
        refine le_trans (norm_add_le _ _) ?_
        rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
          Real.norm_eq_abs]
        have t1 : ‖b1 t ξ φ ρ‖ * |angH j M m (ρ * wfun ξ φ)|
            ≤ B * (2 : ℝ) ^ (-(j : ℤ)) * 1 :=
          mul_le_mul (hray.bd1 t ξ φ ρ) (abs_angH_le_one _ _ _ _) (abs_nonneg _)
            (by positivity)
        have t2 : ‖b t ξ (pt ρ φ)‖ * |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ|
            ≤ B * (8 * C * (2 : ℝ) ^ (1 - (j : ℤ))) :=
          mul_le_mul (hray.bd0 _ _ _) hH1w (abs_nonneg _) hBnn
        linarith
      refine le_trans hbp1 ?_
      have he : (2 : ℝ) ^ (1 - (j : ℤ)) = 2 * (2 : ℝ) ^ (-(j : ℤ)) := by
        rw [show 1 - (j : ℤ) = 1 + -(j : ℤ) by ring, two_zpow_add]
        norm_num
      rw [he]
      have hpp : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
      nlinarith [mul_nonneg (mul_nonneg hCnn hBnn) (le_of_lt hpp)]
  · -- bd2
    intro t ξ φ ρ
    by_cases hout : ρ ∈ OutAnn j
    · obtain ⟨hz0, hz1, hz2⟩ := ray_vanish' hAd hray t ξ φ hout
      have hzero : bp2 j M m b b1 b2 t ξ φ ρ = 0 := by
        rw [bp2, hz0, hz1, hz2, zero_mul, zero_mul, mul_zero, zero_mul, add_zero, add_zero]
      rw [hzero, norm_zero]
      positivity
    · have hρ : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ |ρ| := by
        by_contra hcon
        push_neg at hcon
        exact hout (Or.inl hcon)
      have hρpos : (0 : ℝ) < |ρ| := lt_of_lt_of_le (by positivity) hρ
      have hinv : 1 / |ρ| ≤ (2 : ℝ) ^ (1 - (j : ℤ)) := by
        have he : (2 : ℝ) ^ (1 - (j : ℤ)) = 1 / (2 : ℝ) ^ ((j : ℤ) - 1) := by
          rw [eq_div_iff (by positivity), ← two_zpow_add,
            show 1 - (j : ℤ) + ((j : ℤ) - 1) = 0 by ring]
          norm_num
        rw [he]
        exact one_div_le_one_div_of_le (by positivity) hρ
      have hsqinv : 1 / ρ ^ 2 ≤ (2 : ℝ) ^ (2 - 2 * (j : ℤ)) := by
        have habs : ρ ^ 2 = |ρ| ^ 2 := (sq_abs ρ).symm
        have hlow : ((2 : ℝ) ^ ((j : ℤ) - 1)) ^ 2 ≤ |ρ| ^ 2 :=
          pow_le_pow_left₀ (by positivity) hρ 2
        rw [two_zpow_sq] at hlow
        have he : (2 : ℝ) ^ (2 - 2 * (j : ℤ)) = 1 / (2 : ℝ) ^ (2 * ((j : ℤ) - 1)) := by
          rw [eq_div_iff (by positivity), ← two_zpow_add,
            show 2 - 2 * (j : ℤ) + 2 * ((j : ℤ) - 1) = 0 by ring]
          norm_num
        rw [he, habs]
        exact one_div_le_one_div_of_le (by positivity) hlow
      have hH1w : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ|
          ≤ 8 * C * (2 : ℝ) ^ (1 - (j : ℤ)) := by
        have hkey := abs_mul_angH1_le hCd1 j M m (ρ * wfun ξ φ)
        rw [abs_mul] at hkey
        have h1 : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ| * |ρ| ≤ 8 * C := by
          rw [abs_mul]
          calc |angH1 j M m (ρ * wfun ξ φ)| * |wfun ξ φ| * |ρ|
              = |ρ| * |wfun ξ φ| * |angH1 j M m (ρ * wfun ξ φ)| := by ring
            _ ≤ 8 * C := hkey
        have h2 : |angH1 j M m (ρ * wfun ξ φ) * wfun ξ φ| ≤ 8 * C / |ρ| :=
          (le_div_iff₀ hρpos).mpr h1
        refine le_trans h2 ?_
        rw [div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_left hinv (by positivity)
      have hH2w : |angH2 j M m (ρ * wfun ξ φ) * wfun ξ φ ^ 2|
          ≤ 40 * C * (2 : ℝ) ^ (2 - 2 * (j : ℤ)) := by
        have hkey := sq_mul_angH2_le hCd1 hCd2 j M m (ρ * wfun ξ φ)
        have hexp : (ρ * wfun ξ φ) ^ 2 = ρ ^ 2 * wfun ξ φ ^ 2 := by ring
        rw [hexp] at hkey
        have hρ2 : (0 : ℝ) < ρ ^ 2 := by
          have := hρpos
          nlinarith [sq_abs ρ]
        have h1 : |angH2 j M m (ρ * wfun ξ φ) * wfun ξ φ ^ 2| * ρ ^ 2 ≤ 40 * C := by
          rw [abs_mul, abs_of_nonneg (sq_nonneg (wfun ξ φ))]
          calc |angH2 j M m (ρ * wfun ξ φ)| * wfun ξ φ ^ 2 * ρ ^ 2
              = ρ ^ 2 * wfun ξ φ ^ 2 * |angH2 j M m (ρ * wfun ξ φ)| := by ring
            _ ≤ 40 * C := hkey
        have h2 : |angH2 j M m (ρ * wfun ξ φ) * wfun ξ φ ^ 2| ≤ 40 * C / ρ ^ 2 :=
          (le_div_iff₀ hρ2).mpr h1
        refine le_trans h2 ?_
        rw [div_eq_mul_one_div]
        exact mul_le_mul_of_nonneg_left hsqinv (by positivity)
      have hbp2 : ‖bp2 j M m b b1 b2 t ξ φ ρ‖
          ≤ B * (2 : ℝ) ^ (-2 * (j : ℤ)) * 1
            + 2 * (B * (2 : ℝ) ^ (-(j : ℤ))) * (8 * C * (2 : ℝ) ^ (1 - (j : ℤ)))
            + B * (40 * C * (2 : ℝ) ^ (2 - 2 * (j : ℤ))) := by
        rw [bp2]
        refine le_trans (norm_add_le _ _) ?_
        refine add_le_add (le_trans (norm_add_le _ _) (add_le_add ?_ ?_)) ?_
        · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
          exact mul_le_mul (hray.bd2 t ξ φ ρ) (abs_angH_le_one _ _ _ _) (abs_nonneg _)
            (by positivity)
        · rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
          have hn2 : ‖(2 : ℂ)‖ = 2 := by norm_num
          rw [hn2]
          refine mul_le_mul (mul_le_mul_of_nonneg_left (hray.bd1 t ξ φ ρ) (by norm_num))
            hH1w (abs_nonneg _) (by positivity)
        · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
          exact mul_le_mul (hray.bd0 _ _ _) hH2w (abs_nonneg _) hBnn
      refine le_trans hbp2 ?_
      have e1 : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ (1 - (j : ℤ))
          = 2 * (2 : ℝ) ^ (-2 * (j : ℤ)) := by
        rw [← two_zpow_add, show -(j : ℤ) + (1 - (j : ℤ)) = 1 + -2 * (j : ℤ) by ring,
          two_zpow_add]
        norm_num
      have e2 : (2 : ℝ) ^ (2 - 2 * (j : ℤ)) = 4 * (2 : ℝ) ^ (-2 * (j : ℤ)) := by
        rw [show 2 - 2 * (j : ℤ) = 2 + -2 * (j : ℤ) by ring, two_zpow_add]
        norm_num
      have hpp : (0 : ℝ) < (2 : ℝ) ^ (-2 * (j : ℤ)) := by positivity
      have hrw : 2 * (B * (2 : ℝ) ^ (-(j : ℤ))) * (8 * C * (2 : ℝ) ^ (1 - (j : ℤ)))
          = 16 * (B * C) * ((2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ (1 - (j : ℤ))) := by ring
      rw [hrw, e1, e2]
      nlinarith [mul_nonneg (mul_nonneg hBnn hCnn) (le_of_lt hpp)]

end BPieceRay


/-! ### Cauchy--Schwarz over the angular pieces -/

section EnnCS

theorem enn_mul_le_sq_add_sq (a c : ℝ≥0∞) : a * c ≤ a ^ 2 + c ^ 2 := by
  rcases le_total a c with h | h
  · calc a * c ≤ c * c := by gcongr
      _ = c ^ 2 := by rw [sq]
      _ ≤ a ^ 2 + c ^ 2 := le_add_self
  · calc a * c ≤ a * a := by gcongr
      _ = a ^ 2 := by rw [sq]
      _ ≤ a ^ 2 + c ^ 2 := le_self_add

theorem enn_sq_sum_le {ι : Type*} (s : Finset ι) (a : ι → ℝ≥0∞) :
    (∑ i ∈ s, a i) ^ 2 ≤ 2 * (s.card : ℝ≥0∞) * ∑ i ∈ s, a i ^ 2 := by
  classical
  rw [sq, Finset.sum_mul_sum]
  calc ∑ i ∈ s, ∑ j ∈ s, a i * a j
      ≤ ∑ i ∈ s, ∑ j ∈ s, (a i ^ 2 + a j ^ 2) := by
        refine Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => ?_
        exact enn_mul_le_sq_add_sq (a i) (a j)
    _ = ∑ i ∈ s, ((s.card : ℝ≥0∞) * a i ^ 2 + ∑ j ∈ s, a j ^ 2) := by
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul]
    _ = (s.card : ℝ≥0∞) * (∑ i ∈ s, a i ^ 2) + (s.card : ℝ≥0∞) * ∑ j ∈ s, a j ^ 2 := by
        rw [Finset.sum_add_distrib, ← Finset.mul_sum, Finset.sum_const, nsmul_eq_mul]
    _ = 2 * (s.card : ℝ≥0∞) * ∑ i ∈ s, a i ^ 2 := by ring

theorem enn_rpow_two_eq_pow (x : ℝ≥0∞) : x ^ (2 : ℝ) = x ^ (2 : ℕ) := by
  rw [show ((2 : ℝ)) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]

theorem enn_sq_sum_le' {ι : Type*} (s : Finset ι) (a : ι → ℝ≥0∞) :
    (∑ i ∈ s, a i) ^ (2 : ℝ) ≤ 2 * (s.card : ℝ≥0∞) * ∑ i ∈ s, a i ^ (2 : ℝ) := by
  rw [enn_rpow_two_eq_pow]
  refine le_trans (enn_sq_sum_le s a) ?_
  refine mul_le_mul' (le_refl _) (Finset.sum_le_sum fun i _ => ?_)
  rw [enn_rpow_two_eq_pow]

/-- Cauchy--Schwarz applied to a finite decomposition of a complex number. -/
theorem enorm_sq_sum_le {ι : Type*} (s : Finset ι) (z : ι → ℂ) :
    ‖∑ i ∈ s, z i‖ₑ ^ (2 : ℝ)
      ≤ 2 * (s.card : ℝ≥0∞) * ∑ i ∈ s, ‖z i‖ₑ ^ (2 : ℝ) := by
  refine le_trans ?_ (enn_sq_sum_le' s fun i => ‖z i‖ₑ)
  exact ENNReal.rpow_le_rpow (enorm_sum_le s z) (by norm_num)

end EnnCS

/-! ### Splitting the operator over the angular pieces -/

section SopSplit

theorem continuous_det2_right (ξ : Pl) : Continuous fun η : Pl => det2 ξ η := by
  have h : (fun η : Pl => det2 ξ η) = fun η : Pl => detCLM ξ η := by
    funext η; rw [detCLM_apply]
  rw [h]
  exact (detCLM ξ).continuous

theorem bpiece_isAdapted0 {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ}
    (hb : IsAdapted j 0 b) : IsAdapted j 0 (bpiece j M m b) := by
  refine ⟨fun t ξ => (hb.meas t ξ).mul ?_, fun t ξ η hη => ?_⟩
  · exact (Complex.continuous_ofReal.comp
      ((contDiff_angH j M m).continuous.comp (continuous_det2_right ξ))).measurable
  · by_contra hne
    exact hη (mem_suppSet_of_bpiece (B := (0 : ℝ)) hb.supp hne)

theorem bpiece_bd0 {j M m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (t : ℝ) (ξ η : Pl) :
    ‖bpiece j M m b t ξ η‖ ≤ B := by
  have h1 : ‖bpiece j M m b t ξ η‖ = ‖b t ξ η‖ * |angH j M m (det2 ξ η)| := by
    rw [bpiece, norm_mul, Complex.norm_real, Real.norm_eq_abs]
  rw [h1]
  have h2 := hbB t ξ η
  have h3 := abs_angH_le_one j M m (det2 ξ η)
  nlinarith [norm_nonneg (b t ξ η), abs_nonneg (angH j M m (det2 ξ η))]

/-- The operator splits over the angular pieces of the symbol. -/
theorem Sop_sum_symbol {j M : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    (hb : IsAdapted j 0 b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B) (hBnn : 0 ≤ B)
    (ε t : ℝ) (ξ : Pl) (F : SchwartzMap Pl2 ℂ) :
    Sop ε b (F : Pl2 → ℂ) ξ t
      = ∑ m ∈ Finset.range (M + 2), Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t := by
  classical
  obtain ⟨CF, hCFnn, hCF⟩ := exists_fourier_bound F
  have hRHS : ∀ m : ℕ, Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t
      = ∫ η, phase ε t ξ η * bpiece j M m b t ξ η
          * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η) := fun m => rfl
  rw [Finset.sum_congr rfl fun m _ => hRHS m]
  have hint : ∀ m ∈ Finset.range (M + 2),
      Integrable fun η : Pl => phase ε t ξ η * bpiece j M m b t ξ η
        * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η) := by
    intro m _
    exact integrable_SopK_integrand (bpiece_isAdapted0 hb) (bpiece_bd0 hbB) hBnn ε t ξ
      (measurable_fourier_schwartz F) hCFnn hCF
  have key : (∫ η, phase ε t ξ η * b t ξ η * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η))
      = ∫ η, ∑ m ∈ Finset.range (M + 2), phase ε t ξ η * bpiece j M m b t ξ η
          * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show phase ε t ξ η * b t ξ η * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η)
        = ∑ m ∈ Finset.range (M + 2), phase ε t ξ η * bpiece j M m b t ξ η
          * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η)
    have h1 : ∀ m : ℕ, phase ε t ξ η * bpiece j M m b t ξ η
        * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η)
        = (phase ε t ξ η * b t ξ η * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η))
          * ((angH j M m (det2 ξ η) : ℝ) : ℂ) := by
      intro m
      rw [bpiece]
      ring
    rw [Finset.sum_congr rfl fun m _ => h1 m, ← Finset.mul_sum, ← Complex.ofReal_sum,
      sum_angH]
    norm_num
  have hL : Sop ε b (F : Pl2 → ℂ) ξ t
      = ∫ η, phase ε t ξ η * b t ξ η * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η) := rfl
  rw [hL, key, integral_finset_sum _ hint]

end SopSplit


/-! ### The exponent bookkeeping of Proposition 3.1

The powers of `2^m` cancel exactly in all three routes: `2mγ - m - m(2γ-1) = 0` for the near
estimates, and `2(M+1)γ + 2m(2-γ) ≤ 4(M+1) ≤ 2j + 4` for the far estimate.
-/

section P31Arith

theorem two_rpow_mono {x y : ℝ} (h : x ≤ y) : (2 : ℝ) ^ x ≤ (2 : ℝ) ^ y :=
  Real.rpow_le_rpow_of_exponent_le (by norm_num) h

theorem two_zpow_eq_rpow_nat (m : ℕ) : (2 : ℝ) ^ (m : ℤ) = (2 : ℝ) ^ ((m : ℝ)) := by
  rw [two_zpow_eq_rpow]
  norm_num

theorem two_zpow_sq_rpow (j : ℕ) : ((2 : ℝ) ^ (j : ℤ)) ^ 2 = (2 : ℝ) ^ (2 * (j : ℝ)) := by
  rw [two_zpow_sq, two_zpow_eq_rpow]
  congr 1
  push_cast
  ring

theorem two_rpow_sq (a : ℝ) : ((2 : ℝ) ^ a) ^ 2 = (2 : ℝ) ^ (a * 2) := by
  rw [← Real.rpow_natCast ((2 : ℝ) ^ a) 2, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
  norm_num

/-- The near-estimate factor: the powers of `2^m` cancel and only `2^{22(2γ-1)} ≤ 2^{22}`
survives. -/
theorem near_factor_le (m : ℕ) {gam : ℝ} (hgam2 : gam ≤ 1) :
    (2 : ℝ) ^ (2 * (m : ℝ) * gam) / (2 : ℝ) ^ (m : ℤ)
        * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
      ≤ (2 : ℝ) ^ (22 : ℝ) := by
  have h1 : ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
      = (2 : ℝ) ^ ((22 - (m : ℝ)) * (2 * gam - 1)) := by
    rw [two_zpow_rpow]
    congr 1
    push_cast
    ring
  rw [h1, two_zpow_eq_rpow_nat, ← Real.rpow_sub (by norm_num : (0 : ℝ) < 2),
    ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  refine two_rpow_mono ?_
  nlinarith

/-- The trivial-route factor at the last angular scale. -/
theorem triv_factor_le (j m : ℕ) {gam : ℝ} (hgam2 : gam ≤ 1) :
    (2 : ℝ) ^ (2 * (m : ℝ) * gam) * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
        * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
      ≤ (2 : ℝ) ^ (34 : ℝ) * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
  have h1 : ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
      = (2 : ℝ) ^ ((22 - (m : ℝ)) * (2 * gam - 1)) := by
    rw [two_zpow_rpow]
    congr 1
    push_cast
    ring
  have h2 : ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
      = (2 : ℝ) ^ (2 * (j : ℝ) - (m : ℝ) + 12) := by
    rw [two_zpow_eq_rpow]
    congr 1
    push_cast
    ring
  rw [h1, h2, two_zpow_sq_rpow, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2),
    ← Real.rpow_add (by norm_num : (0 : ℝ) < 2),
    ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  refine two_rpow_mono ?_
  nlinarith

/-- The far-estimate factor. -/
theorem far_factor_le {j M m : ℕ} {gam : ℝ} (hgam2 : gam ≤ 1) (hgam0 : 0 ≤ gam)
    (hmM : m ≤ M + 1) (hM : 2 * M ≤ j) :
    (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam) * ((2 : ℝ) ^ ((m : ℝ) * (2 - gam))) ^ 2
      ≤ (2 : ℝ) ^ (4 : ℝ) * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
  have hmR : (m : ℝ) ≤ (M : ℝ) + 1 := by
    have : (m : ℝ) ≤ ((M + 1 : ℕ) : ℝ) := Nat.cast_le.mpr hmM
    push_cast at this
    exact this
  have hMR : 2 * (M : ℝ) ≤ (j : ℝ) := by
    have : ((2 * M : ℕ) : ℝ) ≤ ((j : ℕ) : ℝ) := Nat.cast_le.mpr hM
    push_cast at this
    exact this
  rw [two_rpow_sq, two_zpow_sq_rpow, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2),
    ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  refine two_rpow_mono ?_
  have hg2 : 0 ≤ 2 - gam := by linarith
  nlinarith [mul_le_mul_of_nonneg_right hmR hg2]

end P31Arith


/-! ### The bound for one angular piece -/

section P31Piece

theorem ofReal_mul_ofReal_mul {a c : ℝ} (ha : 0 ≤ a) (Y : ℝ≥0∞) :
    ENNReal.ofReal a * (ENNReal.ofReal c * Y) = ENNReal.ofReal (a * c) * Y := by
  rw [← mul_assoc, ← ENNReal.ofReal_mul ha]

theorem card_le_ofReal {Efin : Finset ℝ} {x : ℝ} (h : (Efin.card : ℝ) ≤ x) :
    (Efin.card : ℝ≥0∞) ≤ ENNReal.ofReal x := by
  rw [← ENNReal.ofReal_natCast]
  exact ENNReal.ofReal_le_ofReal h

theorem two_rpow_ofNat_eq (n : ℕ) : (2 : ℝ) ^ ((n : ℝ)) = (2 : ℝ) ^ n :=
  Real.rpow_natCast 2 n

/-- The absolute constant of the off-diagonal estimate. -/
def c0far (Cs CV : ℝ) : ℝ := (1 / Real.pi) * (2 + 72 * Cs * CV)

/-- The constant in Proposition 3.1. -/
def KP31 (Cs CV Cst : ℝ) : ℝ :=
  4 * (1 + 192 * Cst) ^ 2 * (12 * 2 ^ 83 + 2 ^ 34 + 36 * c0far Cs CV ^ 2 * 2 ^ 25)

theorem CFar_sq_eq (m : ℕ) (B Cs CV gam : ℝ) :
    CFar m B Cs CV gam ^ 2
      = 36 * c0far Cs CV ^ 2 * (2 : ℝ) ^ (21 : ℕ) * B ^ 2
        * ((2 : ℝ) ^ ((m : ℝ) * (2 - gam))) ^ 2 := by
  rw [CFar, c0far]
  have h : ((2 : ℝ) ^ ((21 : ℝ) / 2)) ^ 2 = (2 : ℝ) ^ (21 : ℕ) := by
    rw [two_rpow_sq, show (21 : ℝ) / 2 * 2 = ((21 : ℕ) : ℝ) by norm_num,
      two_rpow_ofNat_eq]
  ring_nf
  rw [show ((2 : ℝ) ^ ((21 : ℝ) / 2)) ^ 2 = (2 : ℝ) ^ (21 : ℕ) from h]
  ring

/-- The far-part contribution of one angular piece. -/
theorem far_piece_le {j M m : ℕ} {B' Cs CV gam Na : ℝ} (hB' : 0 ≤ B') (hNa : 0 ≤ Na)
    (hgam2 : gam ≤ 1) (hgam0 : 0 ≤ gam) (hmM : m ≤ M + 1) (hM : 2 * M ≤ j) :
    Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam) * CFar m B' Cs CV gam ^ 2
      ≤ 36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
  rw [CFar_sq_eq]
  have hff := far_factor_le (j := j) (M := M) (m := m) hgam2 hgam0 hmM hM
  have h4 : (2 : ℝ) ^ (4 : ℝ) = 16 := by
    rw [show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num, two_rpow_ofNat_eq]
    norm_num
  rw [h4] at hff
  have hc : (0 : ℝ) ≤ 36 * c0far Cs CV ^ 2 * (2 : ℝ) ^ (21 : ℕ) * B' ^ 2 * Na := by
    positivity
  have hkey : Na * ((2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam)
        * ((2 : ℝ) ^ ((m : ℝ) * (2 - gam))) ^ 2)
      ≤ Na * (16 * ((2 : ℝ) ^ (j : ℤ)) ^ 2) := mul_le_mul_of_nonneg_left hff hNa
  nlinarith [hkey, hc, sq_nonneg B', pow_pos (show (0:ℝ) < 2 by norm_num) 21,
    sq_nonneg (c0far Cs CV), sq_nonneg ((2:ℝ)^(j:ℤ))]

end P31Piece


/-- **The uniform bound for one angular piece.**  Every piece obeys the same bound
`K B² Na 2^{2j}`, the powers of `2^m` cancelling exactly. -/
theorem prop31_piece {j : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ}
    {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hSD : SymbData j 0 b B) (hray : RayData j b B b1 b2)
    (hbjoint : ∀ t : ℝ, Measurable fun p : Pl × Pl => b t p.1 p.2)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ m ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)))
    (F : SchwartzMap Pl2 ℂ) {m : ℕ} (hmM : m ≤ M + 1) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (KP31 Cs CV Cst * B ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)
        * wMass gam F := by
  have hBnn : 0 ≤ B := hSD.nonneg
  have hCstnn : (0 : ℝ) ≤ Cst := by linarith
  have hNann : (0 : ℝ) ≤ Na := by linarith
  have hgam0 : (0 : ℝ) ≤ gam := by linarith
  set B' : ℝ := (1 + 192 * Cst) * B with hB'def
  have hB'nn : 0 ≤ B' := by rw [hB'def]; positivity
  have hPpos : (0 : ℝ) < ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by positivity
  have hQ : (0 : ℝ) ≤ Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := mul_nonneg hNann (le_of_lt hPpos)
  set Y : ℝ≥0∞ := wMass gam F with hYdef
  have hSDm : SymbData j m (bpiece j M m b) B' := bpiece_symbData hSD hmM hCstd1 hCst1
  have hraym : RayData j (bpiece j M m b) B' (bp1 j M m b b1) (bp2 j M m b b1 b2) :=
    bpiece_rayData hSD.toIsAdapted hray hCstd1 hCstd2 hCst1
  have hjointm : ∀ t : ℝ, Measurable fun p : Pl × Pl => bpiece j M m b t p.1 p.2 :=
    fun t => measurable_bpiece (hbjoint t)
  -- the far contribution, common to both routes
  have hfar : (Efin.card : ℝ≥0∞) * (ENNReal.ofReal (CFar m B' Cs CV gam ^ 2) * Y)
      ≤ ENNReal.ofReal (36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 * Na
          * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
    have h1 : (Efin.card : ℝ≥0∞) ≤ ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam)) :=
      card_le_ofReal hcard
    have hanng : (0 : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam) :=
      mul_nonneg hNann (le_of_lt (Real.rpow_pos_of_pos (by norm_num) _))
    calc (Efin.card : ℝ≥0∞) * (ENNReal.ofReal (CFar m B' Cs CV gam ^ 2) * Y)
        ≤ ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
            * (ENNReal.ofReal (CFar m B' Cs CV gam ^ 2) * Y) := mul_le_mul' h1 (le_refl _)
      _ = ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam)
            * CFar m B' Cs CV gam ^ 2) * Y := ofReal_mul_ofReal_mul hanng Y
      _ ≤ ENNReal.ofReal (36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 * Na
            * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
          refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
          exact far_piece_le hB'nn hNann hgam2 hgam0 hmM hM
  have hfinal : ∀ K1 : ℝ, 0 ≤ K1 → K1 ≤ 12 * 2 ^ 83 + 2 ^ 34 →
      (4 : ℝ≥0∞) * (ENNReal.ofReal (K1 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y
        + ENNReal.ofReal (36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 * Na
            * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y)
      ≤ ENNReal.ofReal (KP31 Cs CV Cst * B ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
    intro K1 hK1nn hK1le
    have hA : (0 : ℝ) ≤ K1 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
      have h1 : (0 : ℝ) ≤ K1 * B' ^ 2 := mul_nonneg hK1nn (sq_nonneg _)
      have := mul_nonneg h1 hQ
      nlinarith [this]
    have hBb : (0 : ℝ) ≤ 36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 * Na
        * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
      have h1 : (0 : ℝ) ≤ 36 * c0far Cs CV ^ 2 * 2 ^ 25 * B' ^ 2 := by positivity
      have := mul_nonneg h1 hQ
      nlinarith [this]
    rw [← add_mul, ← ENNReal.ofReal_add hA hBb, ← mul_assoc,
      show (4 : ℝ≥0∞) = ENNReal.ofReal 4 by
        rw [show (4 : ℝ) = ((4 : ℕ) : ℝ) by norm_num, ENNReal.ofReal_natCast]; norm_num,
      ← ENNReal.ofReal_mul (by norm_num)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
    rw [hB'def, KP31]
    have hX : (0 : ℝ) ≤ (1 + 192 * Cst) ^ 2 * (B ^ 2 * (Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) :=
      mul_nonneg (sq_nonneg _) (mul_nonneg (sq_nonneg B) hQ)
    nlinarith [hX, mul_nonneg (sub_nonneg.mpr hK1le) hX]
  rcases le_or_gt m M with hle | hgt
  · -- the strictly adapted route
    have hstrict : IsStrictlyAdapted j m (bpiece j M m b) :=
      ⟨fun t ξ => (hSDm.smooth t ξ).continuous.measurable,
        bpiece_strict_supp hSD.supp hle⟩
    have hNnn : (0 : ℝ) ≤ Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam) :=
      mul_nonneg hNann (le_of_lt (Real.rpow_pos_of_pos (by norm_num) _))
    refine le_trans (prop31_single hstrict hraym hSDm hjointm hCs hCVnn hCV hε Efin hEfin
      hNnn (hcount m hle) hgam1 hgam2 F) ?_
    have hnear : ENNReal.ofReal (12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2
          * (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) / (2 : ℝ) ^ (m : ℤ))
          * (ENNReal.ofReal (((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y)
        ≤ ENNReal.ofReal (12 * 2 ^ 83 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
      have hcc : (0 : ℝ) ≤ 12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * Na := by
        have h1 : (0 : ℝ) ≤ 12 * 2 ^ 61 * B' ^ 2 := by positivity
        have := mul_nonneg h1 hQ
        nlinarith [this]
      have hann : (0 : ℝ) ≤ 12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2
          * (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) / (2 : ℝ) ^ (m : ℤ) := by
        have hr : (0 : ℝ) < (2 : ℝ) ^ (2 * (m : ℝ) * gam) :=
          Real.rpow_pos_of_pos (by norm_num) _
        have h2 : (0 : ℝ) ≤ 12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2
            * (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) := by
          nlinarith [hcc, hr]
        exact div_nonneg h2 (by positivity)
      rw [ofReal_mul_ofReal_mul hann Y]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
      have hnf := near_factor_le m hgam2
      have h22 : (2 : ℝ) ^ (22 : ℝ) = 2 ^ (22 : ℕ) := by
        rw [show (22 : ℝ) = ((22 : ℕ) : ℝ) by norm_num, two_rpow_ofNat_eq]
      rw [h22] at hnf
      have hrw : 12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2
            * (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) / (2 : ℝ) ^ (m : ℤ)
            * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
          = (12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * Na)
            * ((2 : ℝ) ^ (2 * (m : ℝ) * gam) / (2 : ℝ) ^ (m : ℤ)
              * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) := by
        field_simp
      rw [hrw]
      calc (12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * Na)
            * ((2 : ℝ) ^ (2 * (m : ℝ) * gam) / (2 : ℝ) ^ (m : ℤ)
              * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1))
          ≤ (12 * 2 ^ 61 * B' ^ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ 2 * Na) * 2 ^ (22 : ℕ) :=
            mul_le_mul_of_nonneg_left hnf hcc
        _ = 12 * 2 ^ 83 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by ring
    refine le_trans (mul_le_mul' (le_refl (4 : ℝ≥0∞)) (add_le_add hnear hfar)) ?_
    refine hfinal (12 * 2 ^ 83) (by positivity) ?_
    have h34 : (0 : ℝ) < 2 ^ (34 : ℕ) := by positivity
    linarith
  · -- the trivial route, `m = M + 1`
    refine le_trans (prop31_single_triv hSDm hjointm hCs hCVnn hCV hε Efin hEfin
      hgam1 hgam2 F) ?_
    have hmeq : m = M + 1 := by omega
    have hnear : (Efin.card : ℝ≥0∞)
          * ENNReal.ofReal (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
          * (ENNReal.ofReal (((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y)
        ≤ ENNReal.ofReal (2 ^ 34 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
      have hmR : 2 * ((M : ℝ) + 1) * gam = 2 * (m : ℝ) * gam := by
        rw [hmeq]; push_cast; ring
      have h1 : (Efin.card : ℝ≥0∞)
          ≤ ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)) := by
        refine card_le_ofReal ?_
        rw [← hmR]
        exact hcard
      have hanng : (0 : ℝ) ≤ Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam) :=
        mul_nonneg hNann (le_of_lt (Real.rpow_pos_of_pos (by norm_num) _))
      have hbnn : (0 : ℝ) ≤ B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12) := by positivity
      calc (Efin.card : ℝ≥0∞)
            * ENNReal.ofReal (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
            * (ENNReal.ofReal (((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y)
          ≤ ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam))
              * ENNReal.ofReal (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
              * (ENNReal.ofReal (((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y) :=
            mul_le_mul' (mul_le_mul' h1 (le_refl _)) (le_refl _)
        _ = ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)
              * (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)))
              * (ENNReal.ofReal (((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y) := by
            rw [← ENNReal.ofReal_mul hanng]
        _ = ENNReal.ofReal (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)
              * (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
              * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) * Y :=
            ofReal_mul_ofReal_mul (mul_nonneg hanng hbnn) Y
        _ ≤ ENNReal.ofReal (2 ^ 34 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2) * Y := by
            refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) (le_refl _)
            have htf := triv_factor_le j m hgam2
            have h34 : (2 : ℝ) ^ (34 : ℝ) = 2 ^ (34 : ℕ) := by
              rw [show (34 : ℝ) = ((34 : ℕ) : ℝ) by norm_num, two_rpow_ofNat_eq]
            rw [h34] at htf
            have hcc : (0 : ℝ) ≤ Na * B' ^ 2 := mul_nonneg hNann (sq_nonneg _)
            have hrw : Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)
                  * (B' ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
                  * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)
                = (Na * B' ^ 2) * ((2 : ℝ) ^ (2 * (m : ℝ) * gam)
                    * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
                    * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1)) := by ring
            rw [hrw]
            calc (Na * B' ^ 2) * ((2 : ℝ) ^ (2 * (m : ℝ) * gam)
                  * ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))
                  * ((2 : ℝ) ^ (22 - (m : ℤ))) ^ (2 * gam - 1))
                ≤ (Na * B' ^ 2) * (2 ^ (34 : ℕ) * ((2 : ℝ) ^ (j : ℤ)) ^ 2) :=
                  mul_le_mul_of_nonneg_left htf hcc
              _ = 2 ^ 34 * B' ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by ring
    refine le_trans (mul_le_mul' (le_refl (4 : ℝ≥0∞)) (add_le_add hnear hfar)) ?_
    refine hfinal (2 ^ 34) (by positivity) ?_
    have h83 : (0 : ℝ) < 12 * 2 ^ (83 : ℕ) := by positivity
    linarith


theorem ennreal_two_card_sq {c A : ℝ} (hc : 0 ≤ c) (hA : 0 ≤ A) (Y : ℝ≥0∞) :
    (2 : ℝ≥0∞) * ENNReal.ofReal c * (ENNReal.ofReal c * (ENNReal.ofReal A * Y))
      = ENNReal.ofReal (2 * c ^ 2 * A) * Y := by
  have h2 : (2 : ℝ≥0∞) = ENNReal.ofReal 2 := by
    rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.ofReal_natCast]
    norm_num
  have hstep : (2 : ℝ≥0∞) * ENNReal.ofReal c * (ENNReal.ofReal c * (ENNReal.ofReal A * Y))
      = (ENNReal.ofReal 2 * ENNReal.ofReal c * ENNReal.ofReal c * ENNReal.ofReal A) * Y := by
    rw [h2]; ring
  rw [hstep, ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2),
    ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * c),
    ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * c * c)]
  congr 2
  ring

/-- **Proposition 3.1** of Roos--Seeger, in the `j` alternative of the paper's
`min(j^{1/2}(2γ-1)^{-1}, j)`:  for a `(j,0)`-adapted symbol with the radial and Cartesian
derivative bounds, and a `2^{-j}`-separated set of radii whose interval counts at scale
`2^{2m-j}` are at most `Na 2^{2mγ}`,
`‖S[F,b]‖²_{L²(ℝ²×ℰ)} ≤ c (M+2)² B² Na 2^{2j} ‖F‖²_{L²(w_γ)}` with `M = ⌊j/2⌋`. -/
theorem prop31 {j : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} {b1 b2 : ℝ → Pl → ℝ → ℝ → ℂ}
    (hSD : SymbData j 0 b B) (hray : RayData j b B b1 b2)
    (hbjoint : ∀ t : ℝ, Measurable fun p : Pl × Pl => b t p.1 p.2)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ m ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (m : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (m : ℝ) * gam)))
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * B ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) * wMass gam F := by
  classical
  have hBnn : 0 ≤ B := hSD.nonneg
  have hNann : (0 : ℝ) ≤ Na := by linarith
  have hCstnn : (0 : ℝ) ≤ Cst := by linarith
  have hjointm : ∀ (m : ℕ) (t : ℝ),
      Measurable fun p : Pl × Pl => bpiece j M m b t p.1 p.2 :=
    fun m t => measurable_bpiece (hbjoint t)
  -- the pointwise Cauchy--Schwarz over the angular pieces
  have hsplit : ∀ (t : ℝ) (ξ : Pl), ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ)
      ≤ 2 * ((M + 2 : ℕ) : ℝ≥0∞) * ∑ m ∈ Finset.range (M + 2),
          ‖Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ) := by
    intro t ξ
    rw [Sop_sum_symbol (M := M) hSD.toIsAdapted (fun t' ξ' η' => hSD.bd0 t' ξ' η') hBnn
      ε t ξ F]
    have h := enorm_sq_sum_le (Finset.range (M + 2))
      (fun m => Sop ε (bpiece j M m b) ((F : Pl2 → ℂ)) ξ t)
    rw [Finset.card_range] at h
    exact h
  -- integrate in `ξ`
  have hstep : ∀ t ∈ Efin, (∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ 2 * ((M + 2 : ℕ) : ℝ≥0∞) * ∑ m ∈ Finset.range (M + 2),
          ∫⁻ ξ : Pl, ‖Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ) := by
    intro t _
    refine le_trans (lintegral_mono (hsplit t)) ?_
    have hfin : (2 : ℝ≥0∞) * ((M + 2 : ℕ) : ℝ≥0∞) ≠ ⊤ :=
      ENNReal.mul_ne_top (by simp) (ENNReal.natCast_ne_top _)
    rw [lintegral_const_mul' _ _ hfin]
    refine mul_le_mul' (le_refl _) (le_of_eq ?_)
    refine lintegral_finset_sum _ ?_
    intro m _
    exact ((measurable_Sop (hjointm m t) ε F).enorm).pow_const _
  refine le_trans (Finset.sum_le_sum hstep) ?_
  rw [← Finset.mul_sum, Finset.sum_comm]
  -- each angular piece
  have hpiece : ∀ m ∈ Finset.range (M + 2),
      (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε (bpiece j M m b) (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
        ≤ ENNReal.ofReal (KP31 Cs CV Cst * B ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)
          * wMass gam F := by
    intro m hm
    rw [Finset.mem_range] at hm
    exact prop31_piece hSD hray hbjoint hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin
      hgam1 hgam2 hNa hM hcard hcount F (by omega)
  refine le_trans (mul_le_mul' (le_refl _) (Finset.sum_le_sum hpiece)) ?_
  rw [Finset.sum_const, nsmul_eq_mul, Finset.card_range]
  have hcast : ((M + 2 : ℕ) : ℝ≥0∞) = ENNReal.ofReal ((M : ℝ) + 2) := by
    rw [← ENNReal.ofReal_natCast]
    norm_num
  have hA : (0 : ℝ) ≤ KP31 Cs CV Cst * B ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
    have hK : (0 : ℝ) ≤ KP31 Cs CV Cst := by
      rw [KP31]
      positivity
    have h1 : (0 : ℝ) ≤ KP31 Cs CV Cst * B ^ 2 := mul_nonneg hK (sq_nonneg B)
    have h2 : (0 : ℝ) ≤ Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2 :=
      mul_nonneg hNann (by positivity)
    nlinarith [mul_nonneg h1 h2]
  rw [hcast, ennreal_two_card_sq (by positivity) hA]


/-! ## §3  The symbol of the operator `𝒯_j`

The symbol occurring in §3 is a product `b(t,ξ,η) = m(t,ξ-η) m(t,η)` of a single-factor
multiplier `m(t,ω) = χ_j(ω) a(tω)` with itself.  This section records the hypotheses on `m`
that are needed and derives from them the `SymbData` and `RayData` packages of §4, so that
Proposition 3.1 applies.
-/

section MultSymbol

/-- The line derivative at an arbitrary parameter value. -/
theorem hasDerivAt_line' {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (ω e : Pl) (ρ : ℝ) :
    HasDerivAt (fun r : ℝ => f (ω + r • e)) (fderiv ℝ f (ω + ρ • e) e) ρ := by
  have hline : HasDerivAt (fun r : ℝ => ω + r • e) e ρ := by
    have h := (hasDerivAt_id ρ).smul_const e
    simpa using h.const_add ω
  have hd : HasFDerivAt f (fderiv ℝ f (ω + ρ • e)) (ω + ρ • e) :=
    ((hf.differentiable (by simp)).differentiableAt).hasFDerivAt
  exact hd.comp_hasDerivAt ρ hline

/-- The single-factor multiplier data: smooth, supported in `Θ_j`, with values and the first two
directional derivatives bounded by `B₀ 2^{-jN}`. -/
structure MultData (j : ℕ) (m : ℝ → Pl → ℂ) (m2 : ℝ → Pl → Pl → Pl → ℂ) (B0 : ℝ) : Prop where
  smooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (m t)
  supp : ∀ (t : ℝ) (ω : Pl), m t ω ≠ 0 → ω ∈ Theta j
  d2 : ∀ (t : ℝ) (ω e e' : Pl) (ρ : ℝ),
    HasDerivAt (fun r : ℝ => fderiv ℝ (m t) (ω + r • e) e') (m2 t (ω + ρ • e) e e') ρ
  cont2 : ∀ (t : ℝ) (e e' : Pl), Continuous fun ω : Pl => m2 t ω e e'
  bd0 : ∀ (t : ℝ) (ω : Pl), ‖m t ω‖ ≤ B0
  bd1 : ∀ (t : ℝ) (ω u : Pl), ‖u‖ = 1 → ‖fderiv ℝ (m t) ω u‖ ≤ B0 * (2 : ℝ) ^ (-(j : ℤ))
  bd2 : ∀ (t : ℝ) (ω e e' : Pl), ‖e‖ = 1 → ‖e'‖ = 1 →
    ‖m2 t ω e e'‖ ≤ B0 * (2 : ℝ) ^ (-2 * (j : ℤ))
  bdi : ∀ (n : ℕ), n ≤ 3 → ∀ (t : ℝ) (ω : Pl),
    ‖iteratedFDeriv ℝ n (m t) ω‖ ≤ B0 * (2 : ℝ) ^ (-((n : ℤ) * (j : ℤ)))

theorem MultData.nonneg {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) : 0 ≤ B0 := le_trans (norm_nonneg _) (hm.bd0 0 0)

/-- The product symbol of §3. -/
def bprod (m : ℝ → Pl → ℂ) (t : ℝ) (ξ η : Pl) : ℂ := m t (ξ - η) * m t η

theorem contDiff_bprod {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (ξ : Pl) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (bprod m t ξ) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun η : Pl => m t (ξ - η) :=
    (hm.smooth t).comp (contDiff_const.sub contDiff_id)
  exact h1.mul (hm.smooth t)

theorem bprod_supp {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (ξ η : Pl) (hη : η ∉ SuppSet j 0 ξ) :
    bprod m t ξ η = 0 := by
  by_contra hne
  rw [bprod] at hne
  have h1 : m t (ξ - η) ≠ 0 := fun h => hne (by rw [h, zero_mul])
  have h2 : m t η ≠ 0 := fun h => hne (by rw [h, mul_zero])
  refine hη ⟨hm.supp t η h2, hm.supp t (ξ - η) h1, ?_⟩
  have hpi : InnerProductGeometry.angle ξ η ≤ π := InnerProductGeometry.angle_le_pi ξ η
  have h4 : π ≤ 4 := Real.pi_le_four
  have h32 : (2 : ℝ) ^ (5 - ((0 : ℕ) : ℤ)) = 32 := by norm_num
  rw [h32]
  linarith

/-- The `η`-derivative of the product symbol. -/
theorem fderiv_bprod_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (ξ η u : Pl) :
    fderiv ℝ (bprod m t ξ) η u
      = fderiv ℝ (m t) (ξ - η) (-u) * m t η + m t (ξ - η) * fderiv ℝ (m t) η u := by
  have hdiff : DifferentiableAt ℝ (m t) (ξ - η) :=
    ((hm.smooth t).differentiable (by simp)).differentiableAt
  have hdiff2 : DifferentiableAt ℝ (m t) η :=
    ((hm.smooth t).differentiable (by simp)).differentiableAt
  -- the two line derivatives
  have h1 : HasDerivAt (fun r : ℝ => m t (ξ - (η + r • u)))
      (fderiv ℝ (m t) (ξ - η) (-u)) 0 := by
    have hfun : (fun r : ℝ => m t (ξ - (η + r • u)))
        = fun r : ℝ => m t ((ξ - η) + r • (-u)) := by
      funext r
      congr 1
      rw [smul_neg]
      abel
    rw [hfun]
    have h := hasDerivAt_line' (hm.smooth t) (ξ - η) (-u) 0
    simpa using h
  have h2 : HasDerivAt (fun r : ℝ => m t (η + r • u)) (fderiv ℝ (m t) η u) 0 := by
    have h := hasDerivAt_line' (hm.smooth t) η u 0
    simpa using h
  have hprod := h1.mul h2
  simp only [zero_smul, add_zero] at hprod
  have hline : HasDerivAt (fun r : ℝ => bprod m t ξ (η + r • u))
      (fderiv ℝ (bprod m t ξ) η u) 0 := hasDerivAt_line (contDiff_bprod hm t ξ) η u
  have hfun2 : (fun r : ℝ => bprod m t ξ (η + r • u))
      = fun r : ℝ => m t (ξ - (η + r • u)) * m t (η + r • u) := by
    funext r
    rw [bprod]
  rw [hfun2] at hline
  exact hline.unique hprod

/-- **The product symbol satisfies `SymbData j 0`.** -/
theorem bprod_symbData {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) : SymbData j 0 (bprod m) (2 * B0 ^ 2) := by
  have hB0 : 0 ≤ B0 := hm.nonneg
  refine ⟨fun t ξ => contDiff_bprod hm t ξ, bprod_supp hm, ?_, ?_⟩
  · intro t ξ η
    rw [bprod, norm_mul]
    have h1 := hm.bd0 t (ξ - η)
    have h2 := hm.bd0 t η
    nlinarith [norm_nonneg (m t (ξ - η)), norm_nonneg (m t η)]
  · intro t ξ η u hu
    rw [fderiv_bprod_apply hm t ξ η u]
    have hnu : ‖(-u : Pl)‖ = 1 := by rw [norm_neg]; exact hu
    have h1 := hm.bd1 t (ξ - η) (-u) hnu
    have h2 := hm.bd1 t η u hu
    have h3 := hm.bd0 t (ξ - η)
    have h4 := hm.bd0 t η
    have hp : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
    have hgoal : (2 : ℝ) ^ (-((j : ℤ) - ((0 : ℕ) : ℤ))) = (2 : ℝ) ^ (-(j : ℤ)) := by
      congr 1
    rw [hgoal]
    refine le_trans (norm_add_le _ _) ?_
    rw [norm_mul, norm_mul]
    have t1 : ‖fderiv ℝ (m t) (ξ - η) (-u)‖ * ‖m t η‖ ≤ (B0 * (2 : ℝ) ^ (-(j : ℤ))) * B0 :=
      mul_le_mul h1 h4 (norm_nonneg _) (by positivity)
    have t2 : ‖m t (ξ - η)‖ * ‖fderiv ℝ (m t) η u‖ ≤ B0 * (B0 * (2 : ℝ) ^ (-(j : ℤ))) :=
      mul_le_mul h3 h2 (norm_nonneg _) hB0
    nlinarith [t1, t2]

theorem measurable_bprod {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) :
    Measurable fun p : Pl × Pl => bprod m t p.1 p.2 := by
  have hc : Continuous fun p : Pl × Pl => m t (p.1 - p.2) :=
    (hm.smooth t).continuous.comp (continuous_fst.sub continuous_snd)
  have hc2 : Continuous fun p : Pl × Pl => m t p.2 :=
    (hm.smooth t).continuous.comp continuous_snd
  exact (hc.mul hc2).measurable

end MultSymbol


/-! ### The radial data of the product symbol -/

section MultRay

theorem continuous_fderiv_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (e : Pl) :
    Continuous fun ω : Pl => fderiv ℝ (m t) ω e := by
  have h1 : Continuous fun ω : Pl => fderiv ℝ (m t) ω :=
    (hm.smooth t).continuous_fderiv (by simp)
  exact (ContinuousLinearMap.apply ℝ ℂ e).continuous.comp h1

/-- The first radial derivative of the product symbol. -/
def bq1 (m : ℝ → Pl → ℂ) (t : ℝ) (ξ : Pl) (φ ρ : ℝ) : ℂ :=
  fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ)) * m t (pt ρ φ)
    + m t (ξ - pt ρ φ) * fderiv ℝ (m t) (pt ρ φ) (pt 1 φ)

/-- The second radial derivative of the product symbol. -/
def bq2 (m : ℝ → Pl → ℂ) (m2 : ℝ → Pl → Pl → Pl → ℂ) (t : ℝ) (ξ : Pl) (φ ρ : ℝ) : ℂ :=
  m2 t (ξ - pt ρ φ) (-(pt 1 φ)) (-(pt 1 φ)) * m t (pt ρ φ)
    + 2 * (fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ)) * fderiv ℝ (m t) (pt ρ φ) (pt 1 φ))
    + m t (ξ - pt ρ φ) * m2 t (pt ρ φ) (pt 1 φ) (pt 1 φ)

theorem hasDerivAt_bprod_ray {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (ξ : Pl) (φ ρ : ℝ) :
    HasDerivAt (fun r : ℝ => bprod m t ξ (pt r φ)) (bq1 m t ξ φ ρ) ρ := by
  have hshift : ∀ r : ℝ, ξ + r • (-(pt 1 φ)) = ξ - pt r φ := by
    intro r
    rw [smul_neg, ← pt_eq_smul r φ]
    abel
  have hshift0 : ∀ r : ℝ, (0 : Pl) + r • (pt 1 φ) = pt r φ := by
    intro r
    rw [zero_add, ← pt_eq_smul r φ]
  have h1fun : (fun r : ℝ => m t (ξ + r • (-(pt 1 φ))))
      = fun r : ℝ => m t (ξ - pt r φ) := by
    funext r
    rw [hshift r]
  have h2fun : (fun r : ℝ => m t ((0 : Pl) + r • (pt 1 φ)))
      = fun r : ℝ => m t (pt r φ) := by
    funext r
    rw [hshift0 r]
  have h1 : HasDerivAt (fun r : ℝ => m t (ξ - pt r φ))
      (fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ))) ρ := by
    have h := hasDerivAt_line' (hm.smooth t) ξ (-(pt 1 φ)) ρ
    rw [hshift ρ, h1fun] at h
    exact h
  have h2 : HasDerivAt (fun r : ℝ => m t (pt r φ))
      (fderiv ℝ (m t) (pt ρ φ) (pt 1 φ)) ρ := by
    have h := hasDerivAt_line' (hm.smooth t) 0 (pt 1 φ) ρ
    rw [hshift0 ρ, h2fun] at h
    exact h
  have hprod := h1.mul h2
  have hbfun : (fun r : ℝ => bprod m t ξ (pt r φ))
      = fun r : ℝ => m t (ξ - pt r φ) * m t (pt r φ) := by
    funext r
    rw [bprod]
  rw [hbfun]
  refine hprod.congr_deriv ?_
  rw [bq1]

theorem hasDerivAt_bq1 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (t : ℝ) (ξ : Pl) (φ ρ : ℝ) :
    HasDerivAt (bq1 m t ξ φ) (bq2 m m2 t ξ φ ρ) ρ := by
  have hshift : ∀ r : ℝ, ξ + r • (-(pt 1 φ)) = ξ - pt r φ := by
    intro r
    rw [smul_neg, ← pt_eq_smul r φ]
    abel
  have hshift0 : ∀ r : ℝ, (0 : Pl) + r • (pt 1 φ) = pt r φ := by
    intro r
    rw [zero_add, ← pt_eq_smul r φ]
  have hAfun : (fun r : ℝ => fderiv ℝ (m t) (ξ + r • (-(pt 1 φ))) (-(pt 1 φ)))
      = fun r : ℝ => fderiv ℝ (m t) (ξ - pt r φ) (-(pt 1 φ)) := by
    funext r
    rw [hshift r]
  have hDfun : (fun r : ℝ => fderiv ℝ (m t) ((0 : Pl) + r • (pt 1 φ)) (pt 1 φ))
      = fun r : ℝ => fderiv ℝ (m t) (pt r φ) (pt 1 φ) := by
    funext r
    rw [hshift0 r]
  have h1fun : (fun r : ℝ => m t (ξ + r • (-(pt 1 φ))))
      = fun r : ℝ => m t (ξ - pt r φ) := by
    funext r
    rw [hshift r]
  have h2fun : (fun r : ℝ => m t ((0 : Pl) + r • (pt 1 φ)))
      = fun r : ℝ => m t (pt r φ) := by
    funext r
    rw [hshift0 r]
  have hA : HasDerivAt (fun r : ℝ => fderiv ℝ (m t) (ξ - pt r φ) (-(pt 1 φ)))
      (m2 t (ξ - pt ρ φ) (-(pt 1 φ)) (-(pt 1 φ))) ρ := by
    have h := hm.d2 t ξ (-(pt 1 φ)) (-(pt 1 φ)) ρ
    rw [hshift ρ, hAfun] at h
    exact h
  have hB : HasDerivAt (fun r : ℝ => m t (pt r φ))
      (fderiv ℝ (m t) (pt ρ φ) (pt 1 φ)) ρ := by
    have h := hasDerivAt_line' (hm.smooth t) 0 (pt 1 φ) ρ
    rw [hshift0 ρ, h2fun] at h
    exact h
  have hC : HasDerivAt (fun r : ℝ => m t (ξ - pt r φ))
      (fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ))) ρ := by
    have h := hasDerivAt_line' (hm.smooth t) ξ (-(pt 1 φ)) ρ
    rw [hshift ρ, h1fun] at h
    exact h
  have hD : HasDerivAt (fun r : ℝ => fderiv ℝ (m t) (pt r φ) (pt 1 φ))
      (m2 t (pt ρ φ) (pt 1 φ) (pt 1 φ)) ρ := by
    have h := hm.d2 t 0 (pt 1 φ) (pt 1 φ) ρ
    rw [hshift0 ρ, hDfun] at h
    exact h
  have hsum := (hA.mul hB).add (hC.mul hD)
  have hfun : bq1 m t ξ φ
      = fun r : ℝ => fderiv ℝ (m t) (ξ - pt r φ) (-(pt 1 φ)) * m t (pt r φ)
        + m t (ξ - pt r φ) * fderiv ℝ (m t) (pt r φ) (pt 1 φ) := by
    funext r
    rw [bq1]
  rw [hfun]
  refine hsum.congr_deriv ?_
  rw [bq2]
  ring

/-- **The product symbol satisfies `RayData j`.** -/
theorem bprod_rayData {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) :
    RayData j (bprod m) (4 * B0 ^ 2) (bq1 m) (bq2 m m2) := by
  have hB0 : 0 ≤ B0 := hm.nonneg
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · intro t ξ
    exact (contDiff_bprod hm t ξ).continuous
  · intro t ξ φ ρ
    exact hasDerivAt_bprod_ray hm t ξ φ ρ
  · intro t ξ φ ρ
    exact hasDerivAt_bq1 hm t ξ φ ρ
  · intro t ξ φ
    have hptc : Continuous fun r : ℝ => pt r φ := continuous_pt_fixed φ
    have hsub : Continuous fun r : ℝ => ξ - pt r φ := continuous_const.sub hptc
    have hfun : bq2 m m2 t ξ φ
        = fun r : ℝ => m2 t (ξ - pt r φ) (-(pt 1 φ)) (-(pt 1 φ)) * m t (pt r φ)
          + 2 * (fderiv ℝ (m t) (ξ - pt r φ) (-(pt 1 φ))
              * fderiv ℝ (m t) (pt r φ) (pt 1 φ))
          + m t (ξ - pt r φ) * m2 t (pt r φ) (pt 1 φ) (pt 1 φ) := by
      funext r
      rw [bq2]
    rw [hfun]
    refine Continuous.add (Continuous.add ?_ ?_) ?_
    · exact ((hm.cont2 t (-(pt 1 φ)) (-(pt 1 φ))).comp hsub).mul
        ((hm.smooth t).continuous.comp hptc)
    · exact continuous_const.mul
        (((continuous_fderiv_apply hm t (-(pt 1 φ))).comp hsub).mul
          ((continuous_fderiv_apply hm t (pt 1 φ)).comp hptc))
    · exact ((hm.smooth t).continuous.comp hsub).mul
        ((hm.cont2 t (pt 1 φ) (pt 1 φ)).comp hptc)
  · intro t ξ η
    rw [bprod, norm_mul]
    have h1 := hm.bd0 t (ξ - η)
    have h2 := hm.bd0 t η
    nlinarith [norm_nonneg (m t (ξ - η)), norm_nonneg (m t η)]
  · intro t ξ φ ρ
    have hu : ‖pt 1 φ‖ = 1 := norm_pt_one φ
    have hnu : ‖(-(pt 1 φ) : Pl)‖ = 1 := by rw [norm_neg]; exact hu
    have h1 := hm.bd1 t (ξ - pt ρ φ) (-(pt 1 φ)) hnu
    have h2 := hm.bd1 t (pt ρ φ) (pt 1 φ) hu
    have h3 := hm.bd0 t (ξ - pt ρ φ)
    have h4 := hm.bd0 t (pt ρ φ)
    have hp : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
    rw [bq1]
    refine le_trans (norm_add_le _ _) ?_
    rw [norm_mul, norm_mul]
    have t1 : ‖fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ))‖ * ‖m t (pt ρ φ)‖
        ≤ (B0 * (2 : ℝ) ^ (-(j : ℤ))) * B0 :=
      mul_le_mul h1 h4 (norm_nonneg _) (by positivity)
    have t2 : ‖m t (ξ - pt ρ φ)‖ * ‖fderiv ℝ (m t) (pt ρ φ) (pt 1 φ)‖
        ≤ B0 * (B0 * (2 : ℝ) ^ (-(j : ℤ))) :=
      mul_le_mul h3 h2 (norm_nonneg _) hB0
    nlinarith [t1, t2]
  · intro t ξ φ ρ
    have hu : ‖pt 1 φ‖ = 1 := norm_pt_one φ
    have hnu : ‖(-(pt 1 φ) : Pl)‖ = 1 := by rw [norm_neg]; exact hu
    have h1 := hm.bd2 t (ξ - pt ρ φ) (-(pt 1 φ)) (-(pt 1 φ)) hnu hnu
    have h2 := hm.bd2 t (pt ρ φ) (pt 1 φ) (pt 1 φ) hu hu
    have h3 := hm.bd1 t (ξ - pt ρ φ) (-(pt 1 φ)) hnu
    have h4 := hm.bd1 t (pt ρ φ) (pt 1 φ) hu
    have h5 := hm.bd0 t (ξ - pt ρ φ)
    have h6 := hm.bd0 t (pt ρ φ)
    have hp : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
    have hp2 : (0 : ℝ) < (2 : ℝ) ^ (-2 * (j : ℤ)) := by positivity
    have hsq : (2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ (-(j : ℤ)) = (2 : ℝ) ^ (-2 * (j : ℤ)) := by
      rw [← two_zpow_add]
      congr 1
      ring
    have tA : ‖m2 t (ξ - pt ρ φ) (-(pt 1 φ)) (-(pt 1 φ)) * m t (pt ρ φ)‖
        ≤ (B0 * (2 : ℝ) ^ (-2 * (j : ℤ))) * B0 := by
      rw [norm_mul]
      exact mul_le_mul h1 h6 (norm_nonneg _) (by positivity)
    have tB : ‖2 * (fderiv ℝ (m t) (ξ - pt ρ φ) (-(pt 1 φ))
          * fderiv ℝ (m t) (pt ρ φ) (pt 1 φ))‖
        ≤ 2 * ((B0 * (2 : ℝ) ^ (-(j : ℤ))) * (B0 * (2 : ℝ) ^ (-(j : ℤ)))) := by
      rw [norm_mul, norm_mul, show ‖(2 : ℂ)‖ = 2 by norm_num]
      refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
      exact mul_le_mul h3 h4 (norm_nonneg _) (by positivity)
    have tC : ‖m t (ξ - pt ρ φ) * m2 t (pt ρ φ) (pt 1 φ) (pt 1 φ)‖
        ≤ B0 * (B0 * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
      rw [norm_mul]
      exact mul_le_mul h5 h2 (norm_nonneg _) hB0
    have htot : ‖bq2 m m2 t ξ φ ρ‖ ≤ (B0 * (2 : ℝ) ^ (-2 * (j : ℤ))) * B0
        + 2 * ((B0 * (2 : ℝ) ^ (-(j : ℤ))) * (B0 * (2 : ℝ) ^ (-(j : ℤ))))
        + B0 * (B0 * (2 : ℝ) ^ (-2 * (j : ℤ))) := by
      rw [bq2]
      refine le_trans (norm_add_le _ _) ?_
      exact add_le_add (le_trans (norm_add_le _ _) (add_le_add tA tB)) tC
    refine le_trans htot (le_of_eq ?_)
    rw [show (B0 * (2 : ℝ) ^ (-(j : ℤ))) * (B0 * (2 : ℝ) ^ (-(j : ℤ)))
        = B0 ^ 2 * ((2 : ℝ) ^ (-(j : ℤ)) * (2 : ℝ) ^ (-(j : ℤ))) from by ring, hsq]
    ring

end MultRay

/-! ### Proposition 3.1 for the §3 symbol -/

section Prop31Bprod

theorem SymbData.mono {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B B' : ℝ} (h : SymbData j m b B)
    (hBB : B ≤ B') : SymbData j m b B' := by
  refine ⟨h.smooth, h.supp, fun t ξ η => le_trans (h.bd0 t ξ η) hBB, ?_⟩
  intro t ξ η u hu
  refine le_trans (h.bd1 t ξ η u hu) ?_
  exact mul_le_mul_of_nonneg_right hBB (by positivity)

/-- **Proposition 3.1 for the product symbol of §3.**  With `b(t,ξ,η) = m(t,ξ-η) m(t,η)` and `m`
satisfying `MultData j m m2 B₀`, and `ℰ` a set of radii whose interval counts at scale `2^{2m-j}`
are at most `Na 2^{2mγ}`:
`∑_{t∈ℰ} ‖S[F,b](·,t)‖₂² ≤ c (M+2)² B₀⁴ Na 2^{2j} ‖F‖²_{L²(w_γ)}` with `M = ⌊j/2⌋`. -/
theorem prop31_bprod {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε (bprod m) (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam F := by
  have hB0 : 0 ≤ B0 := hm.nonneg
  have hSD : SymbData j 0 (bprod m) (4 * B0 ^ 2) := by
    refine (bprod_symbData hm).mono ?_
    nlinarith [sq_nonneg B0]
  exact prop31 hSD (bprod_rayData hm) (measurable_bprod hm) hCs hCVnn hCV hCst1 hCstd1 hCstd2
    hε Efin hEfin hgam1 hgam2 hNa hM hcard hcount F

end Prop31Bprod


/-! ## §3  The operator in physical space

The single factor of the §3 symbol, phase included, is `M(t,ω) = e^{2πiεt‖ω‖}m(t,ω)`.  Since `m`
is supported in `Θ_j`, where `‖·‖` agrees with the globally smooth `Ntl j`, we may use the latter
and obtain a globally smooth, compactly supported — hence Schwartz — multiplier.
-/

section PhysOp

/-- The single-factor multiplier of §3, phase included.  The norm is *not* smooth at the origin,
but `m t` vanishes on a neighbourhood of the origin, so the product is. -/
def mfull (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (ω : Pl) : ℂ :=
  Complex.exp (((2 * Real.pi * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I) * m t ω

theorem contDiff_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (mfull j ε m t) := by
  rw [contDiff_iff_contDiffAt]
  intro ω0
  by_cases h0 : ω0 = 0
  · -- near the origin the multiplier vanishes identically
    have hev : mfull j ε m t =ᶠ[nhds ω0] fun _ : Pl => (0 : ℂ) := by
      have hball : Metric.ball (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) - 1)) ∈ nhds ω0 := by
        rw [h0]
        exact Metric.ball_mem_nhds _ (by positivity)
      filter_upwards [hball] with ω hω
      rw [mfull]
      have hmz : m t ω = 0 := by
        by_contra hne
        have hT := hm.supp t ω hne
        have h1 : (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ω‖ := hT.2.2.1
        rw [Metric.mem_ball, dist_zero_right] at hω
        linarith
      rw [hmz, mul_zero]
    refine ContDiffAt.congr_of_eventuallyEq ?_ hev
    exact contDiffAt_const
  · have hnorm : ContDiffAt ℝ (↑(⊤ : ℕ∞)) (fun ω : Pl => ‖ω‖) ω0 := contDiffAt_norm ℝ h0
    have hph : ContDiffAt ℝ (↑(⊤ : ℕ∞))
        (fun ω : Pl => Complex.exp (((2 * Real.pi * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I)) ω0 := by
      refine Complex.contDiff_exp.contDiffAt.comp ω0 ?_
      exact (Complex.ofRealCLM.contDiff.contDiffAt.comp ω0
        (contDiffAt_const.mul hnorm)).mul contDiffAt_const
    exact hph.mul ((hm.smooth t).contDiffAt)

@[simp] theorem norm_mfull_phase (ε t : ℝ) (ω : Pl) :
    ‖Complex.exp (((2 * Real.pi * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I)‖ = 1 :=
  Complex.norm_exp_ofReal_mul_I _

theorem norm_mfull_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (ω : Pl) : ‖mfull j ε m t ω‖ ≤ B0 := by
  rw [mfull, norm_mul, norm_mfull_phase, one_mul]
  exact hm.bd0 t ω

theorem mfull_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {ω : Pl} (h : ω ∉ Theta j) :
    mfull j ε m t ω = 0 := by
  rw [mfull]
  have : m t ω = 0 := by
    by_contra hne
    exact h (hm.supp t ω hne)
  rw [this, mul_zero]

/-- On `Θ_j` the smooth substitute `Ntl j` agrees with the norm. -/
theorem Ntl_eq_of_mem_Theta {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : Ntl j ω = ‖ω‖ := by
  refine Ntl_eq ?_ ?_
  · refine le_trans ?_ h.2.2.1
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  · refine le_trans h.2.2.2 ?_
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)

/-- The phase and the product symbol factor. -/
theorem phase_bprod_eq {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (ξ η : Pl) :
    phase ε t ξ η * bprod m t ξ η = mfull j ε m t (ξ - η) * mfull j ε m t η := by
  by_cases h1 : m t (ξ - η) = 0
  · rw [bprod, h1, zero_mul, mul_zero, mfull, h1, mul_zero, zero_mul]
  by_cases h2 : m t η = 0
  · rw [bprod, h2, mul_zero, mul_zero, mfull, mfull, h2, mul_zero, mul_zero]
  · have hT1 : ξ - η ∈ Theta j := hm.supp t (ξ - η) h1
    have hT2 : η ∈ Theta j := hm.supp t η h2
    rw [phase, bprod, mfull, mfull]
    rw [show ((2 * Real.pi * ε * t * (‖ξ - η‖ + ‖η‖) : ℝ) : ℂ) * Complex.I
        = ((2 * Real.pi * ε * t * ‖ξ - η‖ : ℝ) : ℂ) * Complex.I
          + ((2 * Real.pi * ε * t * ‖η‖ : ℝ) : ℂ) * Complex.I from by push_cast; ring,
      Complex.exp_add]
    ring

theorem hasCompactSupport_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : HasCompactSupport (mfull j ε m t) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl) ((2 : ℝ) ^ ((j : ℤ) + 1))
    ) ?_
  intro ω hω
  refine mfull_eq_zero hm ε t ?_
  intro hT
  refine hω ?_
  rw [Metric.mem_closedBall, dist_zero_right]
  exact hT.2.2.2

/-- The multiplier as a Schwartz function. -/
noncomputable def mfullS {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl ℂ :=
  (hasCompactSupport_mfull hm ε t).toSchwartzMap (contDiff_mfull hm ε t)

@[simp] theorem mfullS_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (ω : Pl) :
    (mfullS hm ε t : Pl → ℂ) ω = mfull j ε m t ω := rfl

end PhysOp


/-! ### The operator `T_t` on Schwartz data -/

section TopSec

theorem hasTemperateGrowth_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    Function.HasTemperateGrowth (mfull j ε m t) := by
  have h := SchwartzMap.hasTemperateGrowth (mfullS hm ε t)
  exact h

/-- The operator `T_t^{j,±}[a,·]` of §3, on Schwartz data. -/
noncomputable def TopS {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) : SchwartzMap Pl ℂ :=
  𝓕⁻ (SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f))

/-- The Fourier transform of `T_t f` is the multiplier times `𝓕 f`. -/
theorem fourier_TopS {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (ω : Pl) :
    𝓕 ((TopS hm ε t f : Pl → ℂ)) ω = mfull j ε m t ω * 𝓕 ((f : Pl → ℂ)) ω := by
  have hS : (𝓕 (TopS hm ε t f) : SchwartzMap Pl ℂ)
      = SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) := by
    rw [TopS, FourierTransform.fourier_fourierInv_eq]
  have hpt : ((𝓕 (TopS hm ε t f) : SchwartzMap Pl ℂ) : Pl → ℂ) ω
      = mfull j ε m t ω * ((𝓕 f : SchwartzMap Pl ℂ) : Pl → ℂ) ω := by
    rw [hS, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull hm ε t)]
    rw [smul_eq_mul]
  rw [← SchwartzMap.fourier_coe (TopS hm ε t f), hpt, SchwartzMap.fourier_coe f]

theorem norm_fourier_TopS_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (ω : Pl) :
    ‖𝓕 ((TopS hm ε t f : Pl → ℂ)) ω‖ ≤ B0 * ‖𝓕 ((f : Pl → ℂ)) ω‖ := by
  rw [fourier_TopS hm ε t f ω, norm_mul]
  exact mul_le_mul_of_nonneg_right (norm_mfull_le hm ε t ω) (norm_nonneg _)

/-- The Fourier transform of `T_t f` vanishes off `Θ_j`. -/
theorem fourier_TopS_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) {ω : Pl} (h : ω ∉ Theta j) :
    𝓕 ((TopS hm ε t f : Pl → ℂ)) ω = 0 := by
  rw [fourier_TopS hm ε t f ω, mfull_eq_zero hm ε t h, zero_mul]

end TopSec


/-! ### Plancherel for the inverse transform -/

section PlancherelInv

theorem measurable_fourier_schwartz_Pl (F : SchwartzMap Pl ℂ) :
    Measurable (𝓕 ((F : Pl → ℂ))) := by
  rw [← SchwartzMap.fourier_coe F]
  exact ((𝓕 F : SchwartzMap Pl ℂ).continuous).measurable

theorem lintegral_enorm_sq_neg (g : Pl → ℂ) :
    (∫⁻ x : Pl, ‖g (-x)‖ₑ ^ (2 : ℝ)) = ∫⁻ x : Pl, ‖g x‖ₑ ^ (2 : ℝ) :=
  lintegral_neg_eq_self (fun x : Pl => ‖g x‖ₑ ^ (2 : ℝ))

theorem lintegral_enorm_sq_fourierInv_schwartz_Pl (F : SchwartzMap Pl ℂ) :
    (∫⁻ x : Pl, ‖𝓕⁻ ((F : Pl → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(F : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have hpt : ∀ x : Pl, ‖𝓕⁻ ((F : Pl → ℂ)) x‖ₑ ^ (2 : ℝ)
      = ‖𝓕 ((F : Pl → ℂ)) (-x)‖ₑ ^ (2 : ℝ) := by
    intro x
    rw [Real.fourierInv_eq_fourier_neg]
  rw [lintegral_congr hpt,
    lintegral_enorm_sq_neg (𝓕 ((F : Pl → ℂ))),
    lintegral_enorm_sq_fourier_schwartz_Pl]

end PlancherelInv


/-! ### The tensor product of two Schwartz functions on the plane -/

section Tens

/-- The two coordinate projections `ℝ⁴ → ℝ²` as continuous linear maps. -/
def prjL : Pl2 →L[ℝ] Pl :=
  (ContinuousLinearMap.fst ℝ Pl Pl).comp
    (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl : Pl2 →L[ℝ] Pl × Pl)

def prjR : Pl2 →L[ℝ] Pl :=
  (ContinuousLinearMap.snd ℝ Pl Pl).comp
    (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl : Pl2 →L[ℝ] Pl × Pl)

@[simp] theorem prjL_pr (y z : Pl) : prjL (pr y z) = y := rfl
@[simp] theorem prjR_pr (y z : Pl) : prjR (pr y z) = z := rfl

theorem norm_le_prj_add (x : Pl2) : ‖x‖ ≤ ‖prjL x‖ + ‖prjR x‖ := by
  have hsq : ‖x‖ ^ 2 = ‖prjL x‖ ^ 2 + ‖prjR x‖ ^ 2 := by
    have h := norm_pr_sq (prjL x) (prjR x)
    have hx : pr (prjL x) (prjR x) = x := rfl
    rw [hx] at h
    exact h
  nlinarith [norm_nonneg x, norm_nonneg (prjL x), norm_nonneg (prjR x),
    mul_nonneg (norm_nonneg (prjL x)) (norm_nonneg (prjR x))]

theorem pow_norm_le_prod (x : Pl2) (k : ℕ) :
    ‖x‖ ^ k ≤ (1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k := by
  have h1 : ‖x‖ ≤ (1 + ‖prjL x‖) * (1 + ‖prjR x‖) := by
    have h := norm_le_prj_add x
    nlinarith [norm_nonneg (prjL x), norm_nonneg (prjR x),
      mul_nonneg (norm_nonneg (prjL x)) (norm_nonneg (prjR x))]
  calc ‖x‖ ^ k ≤ ((1 + ‖prjL x‖) * (1 + ‖prjR x‖)) ^ k :=
        pow_le_pow_left₀ (norm_nonneg x) h1 k
    _ = (1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k := by rw [mul_pow]

/-- The tensor product `f ⊗ g` on `ℝ⁴`. -/
noncomputable def tens (f g : SchwartzMap Pl ℂ) : SchwartzMap Pl2 ℂ where
  toFun := fun x => (f : Pl → ℂ) (prjL x) * (g : Pl → ℂ) (prjR x)
  smooth' := by
    exact ((f.smooth ⊤).comp prjL.contDiff).mul ((g.smooth ⊤).comp prjR.contDiff)
  decay' := by
    intro k n
    set Lf : ℝ := ‖prjL‖ with hLf
    set Rg : ℝ := ‖prjR‖ with hRg
    have hLfnn : 0 ≤ Lf := by rw [hLf]; exact norm_nonneg _
    have hRgnn : 0 ≤ Rg := by rw [hRg]; exact norm_nonneg _
    set Kf : ℝ := 2 ^ k * (Finset.Iic (k, n)).sup
      (fun mm : ℕ × ℕ => SchwartzMap.seminorm ℝ mm.1 mm.2) f with hKf
    set Kg : ℝ := 2 ^ k * (Finset.Iic (k, n)).sup
      (fun mm : ℕ × ℕ => SchwartzMap.seminorm ℝ mm.1 mm.2) g with hKg
    have hKfnn : 0 ≤ Kf := by
      rw [hKf]
      refine mul_nonneg (by positivity) ?_
      exact apply_nonneg _ f
    have hKgnn : 0 ≤ Kg := by
      rw [hKg]
      refine mul_nonneg (by positivity) ?_
      exact apply_nonneg _ g
    refine ⟨Kf * Kg * (Lf + Rg) ^ n, fun x => ?_⟩
    -- the Leibniz bound
    have hL : ContDiff ℝ (↑(⊤ : ℕ∞)) fun y : Pl2 => (f : Pl → ℂ) (prjL y) :=
      (f.smooth ⊤).comp prjL.contDiff
    have hR : ContDiff ℝ (↑(⊤ : ℕ∞)) fun y : Pl2 => (g : Pl → ℂ) (prjR y) :=
      (g.smooth ⊤).comp prjR.contDiff
    have hleib := norm_iteratedFDeriv_mul_le hL hR x (n := n) (by exact_mod_cast le_top)
    -- each factor
    have hfac : ∀ i : ℕ,
        ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
          ≤ ‖iteratedFDeriv ℝ i (f : Pl → ℂ) (prjL x)‖ * Lf ^ i := by
      intro i
      have hfun : (fun y : Pl2 => (f : Pl → ℂ) (prjL y))
          = fun y : Pl2 => (f : Pl → ℂ) (prjL y + 0) := by
        funext y
        rw [add_zero]
      rw [hfun]
      have h := norm_iteratedFDeriv_comp_affine (f.smooth ⊤) prjL 0 i x
      rw [add_zero] at h
      exact h
    have hfac2 : ∀ i : ℕ,
        ‖iteratedFDeriv ℝ i (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖
          ≤ ‖iteratedFDeriv ℝ i (g : Pl → ℂ) (prjR x)‖ * Rg ^ i := by
      intro i
      have hfun : (fun y : Pl2 => (g : Pl → ℂ) (prjR y))
          = fun y : Pl2 => (g : Pl → ℂ) (prjR y + 0) := by
        funext y
        rw [add_zero]
      rw [hfun]
      have h := norm_iteratedFDeriv_comp_affine (g.smooth ⊤) prjR 0 i x
      rw [add_zero] at h
      exact h
    -- the Schwartz bounds
    have hsemf : ∀ i ≤ n, (1 + ‖prjL x‖) ^ k
        * ‖iteratedFDeriv ℝ i (f : Pl → ℂ) (prjL x)‖ ≤ Kf := by
      intro i hi
      rw [hKf]
      exact SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (k, n)) (le_refl k) hi f _
    have hsemg : ∀ i ≤ n, (1 + ‖prjR x‖) ^ k
        * ‖iteratedFDeriv ℝ i (g : Pl → ℂ) (prjR x)‖ ≤ Kg := by
      intro i hi
      rw [hKg]
      exact SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := (k, n)) (le_refl k) hi g _
    -- assemble
    have hstep : ∀ i ∈ Finset.range (n + 1),
        (1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k
          * ((n.choose i : ℝ)
            * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
            * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖)
          ≤ (n.choose i : ℝ) * (Lf ^ i * Rg ^ (n - i)) * (Kf * Kg) := by
      intro i hi
      rw [Finset.mem_range] at hi
      have hin : i ≤ n := by omega
      have hni : n - i ≤ n := by omega
      have h1 := hfac i
      have h2 := hfac2 (n - i)
      have h3 := hsemf i hin
      have h4 := hsemg (n - i) hni
      have hApos : (0 : ℝ) ≤ (1 + ‖prjL x‖) ^ k := by positivity
      have hBpos : (0 : ℝ) ≤ (1 + ‖prjR x‖) ^ k := by positivity
      have hnn1 : (0 : ℝ) ≤ ‖iteratedFDeriv ℝ i (f : Pl → ℂ) (prjL x)‖ := norm_nonneg _
      have hnn2 : (0 : ℝ) ≤ ‖iteratedFDeriv ℝ (n - i) (g : Pl → ℂ) (prjR x)‖ := norm_nonneg _
      have hnn3 : (0 : ℝ)
          ≤ ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖ := norm_nonneg _
      have hnn4 : (0 : ℝ)
          ≤ ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖ :=
        norm_nonneg _
      have hLi : (0 : ℝ) ≤ Lf ^ i := by positivity
      have hRi : (0 : ℝ) ≤ Rg ^ (n - i) := by positivity
      have hchoose : (0 : ℝ) ≤ (n.choose i : ℝ) := by positivity
      have hAP : (1 + ‖prjL x‖) ^ k
          * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
          ≤ Kf * Lf ^ i := by
        calc (1 + ‖prjL x‖) ^ k
              * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
            ≤ (1 + ‖prjL x‖) ^ k
                * (‖iteratedFDeriv ℝ i (f : Pl → ℂ) (prjL x)‖ * Lf ^ i) :=
              mul_le_mul_of_nonneg_left h1 hApos
          _ = ((1 + ‖prjL x‖) ^ k * ‖iteratedFDeriv ℝ i (f : Pl → ℂ) (prjL x)‖) * Lf ^ i := by
              ring
          _ ≤ Kf * Lf ^ i := mul_le_mul_of_nonneg_right h3 hLi
      have hBQ : (1 + ‖prjR x‖) ^ k
          * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖
          ≤ Kg * Rg ^ (n - i) := by
        calc (1 + ‖prjR x‖) ^ k
              * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖
            ≤ (1 + ‖prjR x‖) ^ k
                * (‖iteratedFDeriv ℝ (n - i) (g : Pl → ℂ) (prjR x)‖ * Rg ^ (n - i)) :=
              mul_le_mul_of_nonneg_left h2 hBpos
          _ = ((1 + ‖prjR x‖) ^ k
                * ‖iteratedFDeriv ℝ (n - i) (g : Pl → ℂ) (prjR x)‖) * Rg ^ (n - i) := by ring
          _ ≤ Kg * Rg ^ (n - i) := mul_le_mul_of_nonneg_right h4 hRi
      calc (1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k
            * ((n.choose i : ℝ)
              * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
              * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖)
          = (n.choose i : ℝ)
            * (((1 + ‖prjL x‖) ^ k
                * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖)
              * ((1 + ‖prjR x‖) ^ k
                * ‖iteratedFDeriv ℝ (n - i)
                    (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖)) := by ring
        _ ≤ (n.choose i : ℝ) * ((Kf * Lf ^ i) * (Kg * Rg ^ (n - i))) := by
            refine mul_le_mul_of_nonneg_left ?_ hchoose
            exact mul_le_mul hAP hBQ (by positivity) (by positivity)
        _ = (n.choose i : ℝ) * (Lf ^ i * Rg ^ (n - i)) * (Kf * Kg) := by ring
    calc ‖x‖ ^ k * ‖iteratedFDeriv ℝ n
          (fun y : Pl2 => (f : Pl → ℂ) (prjL y) * (g : Pl → ℂ) (prjR y)) x‖
        ≤ ((1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k)
          * ∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)
            * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
            * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖ :=
          mul_le_mul (pow_norm_le_prod x k) hleib (norm_nonneg _) (by positivity)
      _ = ∑ i ∈ Finset.range (n + 1), (1 + ‖prjL x‖) ^ k * (1 + ‖prjR x‖) ^ k
            * ((n.choose i : ℝ)
              * ‖iteratedFDeriv ℝ i (fun y : Pl2 => (f : Pl → ℂ) (prjL y)) x‖
              * ‖iteratedFDeriv ℝ (n - i) (fun y : Pl2 => (g : Pl → ℂ) (prjR y)) x‖) := by
          rw [Finset.mul_sum]
      _ ≤ ∑ i ∈ Finset.range (n + 1),
            (n.choose i : ℝ) * (Lf ^ i * Rg ^ (n - i)) * (Kf * Kg) :=
          Finset.sum_le_sum hstep
      _ = (Kf * Kg) * ∑ i ∈ Finset.range (n + 1),
            (n.choose i : ℝ) * (Lf ^ i * Rg ^ (n - i)) := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          ring
      _ = Kf * Kg * (Lf + Rg) ^ n := by
          rw [add_pow]
          refine congrArg (fun z => Kf * Kg * z) ?_
          refine Finset.sum_congr rfl fun i _ => ?_
          ring

@[simp] theorem tens_apply (f g : SchwartzMap Pl ℂ) (x : Pl2) :
    (tens f g : Pl2 → ℂ) x = (f : Pl → ℂ) (prjL x) * (g : Pl → ℂ) (prjR x) := rfl

theorem tens_apply_pr (f g : SchwartzMap Pl ℂ) (y z : Pl) :
    (tens f g : Pl2 → ℂ) (pr y z) = (f : Pl → ℂ) y * (g : Pl → ℂ) z := rfl

end Tens


/-! ### The Fourier transform of a tensor product -/

section TensFourier

/-- The Fourier transform of a tensor product factors. -/
theorem fourier_tens (f g : SchwartzMap Pl ℂ) (u v : Pl) :
    𝓕 ((tens f g : Pl2 → ℂ)) (pr u v)
      = 𝓕 ((f : Pl → ℂ)) u * 𝓕 ((g : Pl → ℂ)) v := by
  have hmp : MeasurePreserving (fun q : Pl × Pl => (pr q.1 q.2 : Pl2))
      ((volume : Measure Pl).prod (volume : Measure Pl)) (volume : Measure Pl2) :=
    WithLp.volume_preserving_toLp (U := Pl) (V := Pl)
  have hemb : MeasurableEmbedding (fun q : Pl × Pl => (pr q.1 q.2 : Pl2)) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurableEmbedding
  have hpt : ∀ q : Pl × Pl,
      ee (inner ℝ (pr q.1 q.2 : Pl2) (pr u v)) * (tens f g : Pl2 → ℂ) (pr q.1 q.2)
        = (ee (inner ℝ q.1 u) * (f : Pl → ℂ) q.1)
          * (ee (inner ℝ q.2 v) * (g : Pl → ℂ) q.2) := by
    intro q
    rw [inner_pr, ee_add, tens_apply_pr]
    ring
  rw [fourier_eq_ee_Pl2, fourier_eq_ee_Pl, fourier_eq_ee_Pl,
    ← hmp.integral_comp hemb
      (fun x : Pl2 => ee (inner ℝ x (pr u v)) * (tens f g : Pl2 → ℂ) x),
    integral_congr_ae (Filter.Eventually.of_forall hpt)]
  exact integral_prod_mul (f := fun y : Pl => ee (inner ℝ y u) * (f : Pl → ℂ) y)
    (g := fun z : Pl => ee (inner ℝ z v) * (g : Pl → ℂ) z)

end TensFourier

/-! ### The `L²` transfer: from `S[f⊗g,b]` to `T_tf · T_tg` -/

section L2Transfer

/-- The multiplier applied to `𝓕f`, as a Schwartz function. -/
noncomputable def Amul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f)

@[simp] theorem Amul_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (ω : Pl) :
    (Amul hm ε t f : Pl → ℂ) ω = mfull j ε m t ω * 𝓕 ((f : Pl → ℂ)) ω := by
  rw [Amul, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull hm ε t),
    smul_eq_mul, SchwartzMap.fourier_coe]

theorem TopS_eq_fourierInv_Amul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x = 𝓕⁻ ((Amul hm ε t f : Pl → ℂ)) x := by
  rw [TopS, Amul, SchwartzMap.fourierInv_coe]

/-- The §4 operator applied to a tensor product is the convolution of the two multiplied
transforms. -/
theorem Sop_tens_eq_convolution {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) (ξ : Pl) :
    Sop ε (bprod m) ((tens f g : Pl2 → ℂ)) ξ t
      = ((Amul hm ε t g : Pl → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (Amul hm ε t f : Pl → ℂ)) ξ := by
  rw [Sop, SopK, MeasureTheory.convolution]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  show phase ε t ξ η * bprod m t ξ η * 𝓕 ((tens f g : Pl2 → ℂ)) (pr (ξ - η) η)
      = (ContinuousLinearMap.mul ℂ ℂ) ((Amul hm ε t g : Pl → ℂ) η)
        ((Amul hm ε t f : Pl → ℂ) (ξ - η))
  rw [phase_bprod_eq hm ε t ξ η, fourier_tens f g (ξ - η) η, Amul_apply, Amul_apply]
  simp only [ContinuousLinearMap.mul_apply']
  ring

/-- The product of the two operators is the inverse transform of the convolution. -/
theorem TopS_mul_eq {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x
      = 𝓕⁻ ((Amul hm ε t g : Pl → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (Amul hm ε t f : Pl → ℂ)) x := by
  rw [Real.fourierInv_eq_fourier_neg,
    Real.fourier_mul_convolution_eq (Amul hm ε t g).integrable (Amul hm ε t f).integrable,
    TopS_eq_fourierInv_Amul, TopS_eq_fourierInv_Amul, Real.fourierInv_eq_fourier_neg,
    Real.fourierInv_eq_fourier_neg]
  ring

/-- The convolution as a Schwartz function. -/
noncomputable def Wconv {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.convolution (𝕜 := ℂ) (ContinuousLinearMap.mul ℂ ℂ) (Amul hm ε t g) (Amul hm ε t f)

theorem Wconv_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) (ξ : Pl) :
    (Wconv hm ε t f g : Pl → ℂ) ξ
      = ((Amul hm ε t g : Pl → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (Amul hm ε t f : Pl → ℂ)) ξ := by
  rw [Wconv]
  exact SchwartzMap.convolution_apply _ _ _ ξ

/-- **The `L²` transfer.**  Plancherel identifies the `L²` norm of `T_tf·T_tg` with that of the
§4 operator applied to `f ⊗ g`. -/
theorem lintegral_enorm_sq_TopS_mul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) :
    (∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((tens f g : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
  have h1 : ∀ x : Pl, (TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x
      = 𝓕⁻ ((Wconv hm ε t f g : Pl → ℂ)) x := by
    intro x
    rw [TopS_mul_eq hm ε t f g x]
    have hfun : ((Wconv hm ε t f g : Pl → ℂ))
        = ((Amul hm ε t g : Pl → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
            (Amul hm ε t f : Pl → ℂ)) := by
      funext ξ
      exact Wconv_apply hm ε t f g ξ
    rw [hfun]
  have h2 : ∀ ξ : Pl, Sop ε (bprod m) ((tens f g : Pl2 → ℂ)) ξ t
      = (Wconv hm ε t f g : Pl → ℂ) ξ := by
    intro ξ
    rw [Sop_tens_eq_convolution hm ε t f g ξ, Wconv_apply hm ε t f g ξ]
  have hL : (∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖𝓕⁻ ((Wconv hm ε t f g : Pl → ℂ)) x‖ₑ ^ (2 : ℝ) := by
    refine lintegral_congr fun x => ?_
    rw [h1 x]
  have hR : (∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((tens f g : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖(Wconv hm ε t f g : Pl → ℂ) ξ‖ₑ ^ (2 : ℝ) := by
    refine lintegral_congr fun ξ => ?_
    rw [h2 ξ]
  rw [hL, hR]
  exact lintegral_enorm_sq_fourierInv_schwartz_Pl (Wconv hm ε t f g)

end L2Transfer


/-! ### Proposition 3.1 in physical space: the `L²` endpoint of §3 -/

section Prop31Phys

/-- **The `L²` endpoint of §3.**  For `f, g` Schwartz on the plane,
`∑_{t∈ℰ} ‖T_tf · T_tg‖²_{L²(ℝ²)} ≤ c (M+2)² B₀⁴ Na 2^{2j} ‖f⊗g‖²_{L²(w_γ)}`
with `M = ⌊j/2⌋`. -/
theorem prop31_phys {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    (f g : SchwartzMap Pl ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl,
        ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam (tens f g) := by
  have hstep : ∀ t ∈ Efin, (∫⁻ x : Pl,
      ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((tens f g : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
    intro t _
    exact lintegral_enorm_sq_TopS_mul hm ε t f g
  rw [Finset.sum_congr rfl hstep]
  exact prop31_bprod hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
    hNa hM hcard hcount (tens f g)

end Prop31Phys


/-! ## §3  Oscillatory integrals: the first-derivative test with boundary terms

`integral_osc_ibp` of §4.3 integrates by parts assuming the amplitude vanishes at both endpoints.
For the van der Corput second-derivative estimate one must integrate by parts on a subinterval on
which `τ'` is bounded away from zero, so the boundary terms have to be kept and the hypotheses on
`τ'` have to be local.
-/

section OscBdry

/-- Integration by parts against an oscillatory factor, keeping the boundary terms. -/
theorem integral_osc_ibp_bdry {a b lam : ℝ} (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Q : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ')
    (hτ'ne : ∀ x ∈ Set.uIcc a b, τ' x ≠ 0)
    (hAc : Continuous A) (hQc : ContinuousOn Q (Set.uIcc a b))
    (hAQ : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Q x) x) :
    (∫ x in a..b, osc lam (τ x) * A x)
      = (osc lam (τ b) * (A b / ((τ' b : ℝ) : ℂ))
          - osc lam (τ a) * (A a / ((τ' a : ℝ) : ℂ)))
            / (((lam : ℝ) : ℂ) * Complex.I)
        - (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, osc lam (τ x) * Q x := by
  have hlamne : ((lam : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hlam
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := mul_ne_zero hlamne Complex.I_ne_zero
  have hτc : Continuous τ := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ x).continuousAt
  set u : ℝ → ℂ := fun y => (A y / ((τ' y : ℝ) : ℂ)) / (((lam : ℝ) : ℂ) * Complex.I) with hu
  set v : ℝ → ℂ := fun y => osc lam (τ y) with hv
  have hvd : ∀ x, HasDerivAt v (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I)) x := fun x =>
    hasDerivAt_osc (hτ x)
  have hvc : Continuous v := by
    rw [hv]
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul hτc)).mul continuous_const)
  have hkey : ∀ x ∈ Set.uIcc a b, HasDerivAt (fun y => u y * v y)
      (v x * (A x + Q x / (((lam : ℝ) : ℂ) * Complex.I))) x := by
    intro x hx
    have hτ'x : ((τ' x : ℝ) : ℂ) ≠ 0 := by
      exact_mod_cast hτ'ne x hx
    have hud : HasDerivAt u (Q x / (((lam : ℝ) : ℂ) * Complex.I)) x :=
      (hAQ x hx).div_const _
    have h := hud.mul (hvd x)
    refine h.congr_deriv ?_
    simp only [hu]
    push_cast
    field_simp [hlamne]
    ring
  have hQint : IntervalIntegrable Q volume a b := hQc.intervalIntegrable
  have hi1 : IntervalIntegrable (fun x => v x * A x) volume a b :=
    (hvc.mul hAc).intervalIntegrable a b
  have hi2 : IntervalIntegrable
      (fun x => v x * (Q x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    refine ((hvc.continuousOn).mul ?_).intervalIntegrable
    exact hQc.div_const _
  have hint : IntervalIntegrable
      (fun x => v x * (A x + Q x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    have hpt : ∀ x : ℝ, v x * (A x + Q x / (((lam : ℝ) : ℂ) * Complex.I))
        = v x * A x + v x * (Q x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      intro x
      ring
    have := hi1.add hi2
    refine this.congr ?_
    intro x _
    exact (hpt x).symm
  have hftc := intervalIntegral.integral_eq_sub_of_hasDerivAt hkey hint
  have hsplit : (∫ x in a..b, v x * (A x + Q x / (((lam : ℝ) : ℂ) * Complex.I)))
      = (∫ x in a..b, v x * A x)
        + (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Q x := by
    have hpt : ∀ x : ℝ, v x * (A x + Q x / (((lam : ℝ) : ℂ) * Complex.I))
        = v x * A x + v x * (Q x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      intro x
      ring
    have h2 : (∫ x in a..b, v x * (Q x / (((lam : ℝ) : ℂ) * Complex.I)))
        = (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Q x := by
      have hpt2 : ∀ x : ℝ, v x * (Q x / (((lam : ℝ) : ℂ) * Complex.I))
          = (1 / (((lam : ℝ) : ℂ) * Complex.I)) * (v x * Q x) := by
        intro x
        ring
      rw [intervalIntegral.integral_congr (fun x _ => hpt2 x),
        intervalIntegral.integral_const_mul]
    rw [intervalIntegral.integral_congr (fun x _ => hpt x),
      intervalIntegral.integral_add hi1 hi2, h2]
  rw [hsplit] at hftc
  have hane : ((τ' a : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast hτ'ne a Set.left_mem_uIcc
  have hbne : ((τ' b : ℝ) : ℂ) ≠ 0 := by
    exact_mod_cast hτ'ne b Set.right_mem_uIcc
  have hval : u b * v b - u a * v a
      = (osc lam (τ b) * (A b / ((τ' b : ℝ) : ℂ))
          - osc lam (τ a) * (A a / ((τ' a : ℝ) : ℂ)))
            / (((lam : ℝ) : ℂ) * Complex.I) := by
    rw [hu, hv]
    field_simp
  rw [hval] at hftc
  rw [hv] at hftc
  linear_combination hftc

/-- **The first-derivative (non-stationary phase) test**, with boundary terms. -/
theorem norm_integral_osc_ibp_bdry {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Q : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ')
    (hτ'ne : ∀ x ∈ Set.uIcc a b, τ' x ≠ 0)
    (hAc : Continuous A) (hQc : ContinuousOn Q (Set.uIcc a b))
    (hAQ : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Q x) x) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (‖A b‖ / |τ' b| + ‖A a‖ / |τ' a| + ∫ x in a..b, ‖Q x‖) / |lam| := by
  have hlampos : (0 : ℝ) < |lam| := abs_pos.mpr hlam
  have hnormL : ‖((lam : ℝ) : ℂ) * Complex.I‖ = |lam| := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
  rw [integral_osc_ibp_bdry hlam hτ hτ'c hτ'ne hAc hQc hAQ]
  refine le_trans (norm_sub_le _ _) ?_
  rw [norm_div, hnormL, norm_mul, one_div, norm_inv, hnormL]
  have hbdry : ‖osc lam (τ b) * (A b / ((τ' b : ℝ) : ℂ))
        - osc lam (τ a) * (A a / ((τ' a : ℝ) : ℂ))‖
      ≤ ‖A b‖ / |τ' b| + ‖A a‖ / |τ' a| := by
    refine le_trans (norm_sub_le _ _) ?_
    rw [norm_mul, norm_mul, norm_osc, norm_osc, one_mul, one_mul, norm_div, norm_div,
      Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs]
  have hQint : ‖∫ x in a..b, osc lam (τ x) * Q x‖ ≤ ∫ x in a..b, ‖Q x‖ := by
    refine le_trans (intervalIntegral.norm_integral_le_integral_norm hab) ?_
    refine le_of_eq (intervalIntegral.integral_congr fun x _ => ?_)
    rw [norm_mul, norm_osc, one_mul]
  calc ‖osc lam (τ b) * (A b / ((τ' b : ℝ) : ℂ))
          - osc lam (τ a) * (A a / ((τ' a : ℝ) : ℂ))‖ / |lam|
        + |lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * Q x‖
      ≤ (‖A b‖ / |τ' b| + ‖A a‖ / |τ' a|) / |lam|
          + |lam|⁻¹ * ∫ x in a..b, ‖Q x‖ := by
        refine add_le_add (div_le_div_of_nonneg_right hbdry (le_of_lt hlampos)) ?_
        exact mul_le_mul_of_nonneg_left hQint (by positivity)
    _ = (‖A b‖ / |τ' b| + ‖A a‖ / |τ' a| + ∫ x in a..b, ‖Q x‖) / |lam| := by
        field_simp

end OscBdry

/-! ### The stationary point of a convex phase -/

section Stationary

/-- With `τ'' ≥ kap` on `[a,b]` the increment of `τ'` there is at least `kap` times the increment
of the variable. -/
theorem incr_of_deriv_ge {a b kap : ℝ} {τ' τ'' : ℝ → ℝ}
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x)
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x) {x y : ℝ}
    (hx : x ∈ Set.Icc a b) (hy : y ∈ Set.Icc a b) (hxy : x ≤ y) :
    τ' x + kap * (y - x) ≤ τ' y := by
  have hgd : ∀ z : ℝ, HasDerivAt (fun w : ℝ => τ' w - kap * w) (τ'' z - kap) z := by
    intro z
    have h := (hτ' z).sub ((hasDerivAt_id z).const_mul kap)
    refine h.congr_deriv ?_
    ring
  have hmono : MonotoneOn (fun w : ℝ => τ' w - kap * w) (Set.Icc a b) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc a b) ?_ ?_ ?_
    · intro z _
      exact ((hgd z).continuousAt).continuousWithinAt
    · intro z _
      exact ((hgd z).differentiableAt).differentiableWithinAt
    · intro z hz
      rw [interior_Icc] at hz
      have hzmem : z ∈ Set.Icc a b := ⟨le_of_lt hz.1, le_of_lt hz.2⟩
      rw [(hgd z).deriv]
      linarith [hτ'' z hzmem]
  have h := hmono hx hy hxy
  simp only [] at h
  linarith

/-- **The stationary point.**  If `τ'' ≥ kap > 0` on `[a,b]` there is `c ∈ [a,b]` with
`kap |x - c| ≤ |τ' x|` throughout `[a,b]`. -/
theorem exists_stationary_lower {a b kap : ℝ} (hab : a ≤ b) (hkap : 0 < kap)
    {τ' τ'' : ℝ → ℝ} (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x)
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x) :
    ∃ c ∈ Set.Icc a b, ∀ x ∈ Set.Icc a b, kap * |x - c| ≤ |τ' x| := by
  have hτ'c : Continuous τ' := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ' x).continuousAt
  have hamem : a ∈ Set.Icc a b := Set.left_mem_Icc.mpr hab
  have hbmem : b ∈ Set.Icc a b := Set.right_mem_Icc.mpr hab
  rcases le_or_gt 0 (τ' a) with hA | hA
  · refine ⟨a, hamem, fun x hx => ?_⟩
    have h := incr_of_deriv_ge hτ' hτ'' hamem hx hx.1
    have hprod : (0 : ℝ) ≤ kap * (x - a) := mul_nonneg (le_of_lt hkap) (by linarith [hx.1])
    have habs : |x - a| = x - a := abs_of_nonneg (by linarith [hx.1])
    have hpos : (0 : ℝ) ≤ τ' x := by linarith
    rw [habs, abs_of_nonneg hpos]
    linarith
  rcases le_or_gt (τ' b) 0 with hB | hB
  · refine ⟨b, hbmem, fun x hx => ?_⟩
    have h := incr_of_deriv_ge hτ' hτ'' hx hbmem hx.2
    have hprod : (0 : ℝ) ≤ kap * (b - x) := mul_nonneg (le_of_lt hkap) (by linarith [hx.2])
    have habs : |x - b| = b - x := by
      rw [abs_of_nonpos (by linarith [hx.2])]
      ring
    have hneg : τ' x ≤ 0 := by linarith
    rw [habs, abs_of_nonpos hneg]
    linarith
  · have hmem : (0 : ℝ) ∈ Set.Icc (τ' a) (τ' b) := ⟨le_of_lt hA, le_of_lt hB⟩
    obtain ⟨c, hc, hc0⟩ := intermediate_value_Icc hab hτ'c.continuousOn hmem
    refine ⟨c, hc, fun x hx => ?_⟩
    rcases le_or_gt c x with hcx | hcx
    · have h := incr_of_deriv_ge hτ' hτ'' hc hx hcx
      rw [hc0] at h
      have hprod : (0 : ℝ) ≤ kap * (x - c) := mul_nonneg (le_of_lt hkap) (by linarith)
      have habs : |x - c| = x - c := abs_of_nonneg (by linarith)
      have hpos : (0 : ℝ) ≤ τ' x := by linarith
      rw [habs, abs_of_nonneg hpos]
      linarith
    · have hxc : x ≤ c := le_of_lt hcx
      have h := incr_of_deriv_ge hτ' hτ'' hx hc hxc
      rw [hc0] at h
      have hprod : (0 : ℝ) ≤ kap * (c - x) := mul_nonneg (le_of_lt hkap) (by linarith)
      have habs : |x - c| = c - x := by
        rw [abs_of_nonpos (by linarith)]
        ring
      have hneg : τ' x ≤ 0 := by linarith
      rw [habs, abs_of_nonpos hneg]
      linarith

end Stationary


/-! ### The one-sided piece of van der Corput's estimate -/

section VdCSide

theorem div_le_div_of_le_of_le {a b c d : ℝ} (hbd : 0 < b) (hd : 0 < d)
    (hac : a ≤ c) (hcnn : 0 ≤ c) (hdb : d ≤ b) : a / b ≤ c / d := by
  rw [div_le_div_iff₀ hbd hd]
  exact mul_le_mul hac hdb (le_of_lt hd) hcnn

/-- On an interval where `|τ'| ≥ mu > 0`, the first-derivative test gives
`(4M + M₁(β-α))/(lam·mu)`.  The `τ''`-term is handled by the telescoping identity
`∫ τ''/(τ')² = 1/τ'(α) - 1/τ'(β)`, which is what makes the estimate independent of any upper
bound on `τ''`. -/
theorem norm_integral_osc_side {al be lam mu M M1 : ℝ} (halbe : al ≤ be) (hlam : 0 < lam)
    (hmu : 0 < mu)
    {τ τ' τ'' : ℝ → ℝ} {A A' : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x)
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x) (hτ''c : Continuous τ'')
    (hτ''nn : ∀ x ∈ Set.Icc al be, 0 ≤ τ'' x)
    (hA : ∀ x, HasDerivAt A (A' x) x) (hA'c : Continuous A')
    (hM : ∀ x, ‖A x‖ ≤ M) (hM1 : ∀ x, ‖A' x‖ ≤ M1)
    (hmulow : ∀ x ∈ Set.Icc al be, mu ≤ |τ' x|) :
    ‖∫ x in al..be, osc lam (τ x) * A x‖ ≤ (4 * M + M1 * (be - al)) / (lam * mu) := by
  have hMnn : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM al)
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) (hM1 al)
  have hAc : Continuous A := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hA x).continuousAt
  have hτ'c : Continuous τ' := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ' x).continuousAt
  have huIcc : Set.uIcc al be = Set.Icc al be := Set.uIcc_of_le halbe
  have hτ'ne : ∀ x ∈ Set.uIcc al be, τ' x ≠ 0 := by
    intro x hx
    rw [huIcc] at hx
    intro h0
    have h := hmulow x hx
    rw [h0, abs_zero] at h
    linarith
  set Q : ℝ → ℂ := fun x =>
    (A' x * ((τ' x : ℝ) : ℂ) - A x * ((τ'' x : ℝ) : ℂ)) / (((τ' x : ℝ) : ℂ)) ^ 2 with hQdef
  have hAQ : ∀ x ∈ Set.uIcc al be,
      HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Q x) x := by
    intro x hx
    have hne : ((τ' x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hτ'ne x hx
    have hd : HasDerivAt (fun y : ℝ => ((τ' y : ℝ) : ℂ)) (((τ'' x : ℝ) : ℂ)) x :=
      (hτ' x).ofReal_comp
    exact (hA x).div hd hne
  have hQc : ContinuousOn Q (Set.uIcc al be) := by
    rw [hQdef]
    refine ContinuousOn.div ?_ ?_ ?_
    · exact ((hA'c.continuousOn).mul
        ((Complex.continuous_ofReal.comp hτ'c).continuousOn)).sub
        ((hAc.continuousOn).mul ((Complex.continuous_ofReal.comp hτ''c).continuousOn))
    · exact (((Complex.continuous_ofReal.comp hτ'c)).continuousOn).pow 2
    · intro x hx
      have hne : ((τ' x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hτ'ne x hx
      exact pow_ne_zero 2 hne
  have hbound := norm_integral_osc_ibp_bdry halbe (ne_of_gt hlam) hτ hτ'c hτ'ne hAc hQc hAQ
  have hbd1 : ‖A be‖ / |τ' be| ≤ M / mu := by
    have hbe := hmulow be (Set.right_mem_Icc.mpr halbe)
    exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hbe) hmu (hM be) hMnn hbe
  have hbd2 : ‖A al‖ / |τ' al| ≤ M / mu := by
    have hal := hmulow al (Set.left_mem_Icc.mpr halbe)
    exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hal) hmu (hM al) hMnn hal
  have hQsplit : ∀ x ∈ Set.Icc al be,
      ‖Q x‖ ≤ M1 / mu + M * (τ'' x / (τ' x) ^ 2) := by
    intro x hx
    have hne : τ' x ≠ 0 := hτ'ne x (by rw [huIcc]; exact hx)
    have hmux := hmulow x hx
    have habspos : (0 : ℝ) < |τ' x| := lt_of_lt_of_le hmu hmux
    have hsqpos : (0 : ℝ) < (τ' x) ^ 2 := by positivity
    have habs2 : ‖(((τ' x : ℝ) : ℂ)) ^ 2‖ = (τ' x) ^ 2 := by
      rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    have hsq : (τ' x) ^ 2 = |τ' x| * |τ' x| := by
      rw [← sq_abs]
      ring
    have h1 : ‖A' x‖ * |τ' x| / (τ' x) ^ 2 ≤ M1 / mu := by
      rw [hsq, mul_div_mul_right _ _ (ne_of_gt habspos)]
      exact div_le_div_of_le_of_le habspos hmu (hM1 x) hM1nn hmux
    have h2 : ‖A x‖ * |τ'' x| / (τ' x) ^ 2 ≤ M * (τ'' x / (τ' x) ^ 2) := by
      rw [abs_of_nonneg (hτ''nn x hx), mul_div_assoc]
      exact mul_le_mul_of_nonneg_right (hM x) (div_nonneg (hτ''nn x hx) (le_of_lt hsqpos))
    have hQx : ‖Q x‖ ≤ (‖A' x‖ * |τ' x| + ‖A x‖ * |τ'' x|) / (τ' x) ^ 2 := by
      show ‖(A' x * ((τ' x : ℝ) : ℂ) - A x * ((τ'' x : ℝ) : ℂ)) / (((τ' x : ℝ) : ℂ)) ^ 2‖
        ≤ (‖A' x‖ * |τ' x| + ‖A x‖ * |τ'' x|) / (τ' x) ^ 2
      rw [norm_div, habs2]
      refine div_le_div_of_nonneg_right ?_ (le_of_lt hsqpos)
      refine le_trans (norm_sub_le _ _) ?_
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
        Real.norm_eq_abs]
    refine le_trans hQx ?_
    rw [_root_.add_div]
    linarith
  have hdivne : ∀ x ∈ Set.uIcc al be, (τ' x) ^ 2 ≠ 0 :=
    fun x hx => pow_ne_zero 2 (hτ'ne x hx)
  have hcont2 : ContinuousOn (fun x => τ'' x / (τ' x) ^ 2) (Set.uIcc al be) :=
    ContinuousOn.div (hτ''c.continuousOn) ((hτ'c.continuousOn).pow 2) hdivne
  have htel : (∫ x in al..be, τ'' x / (τ' x) ^ 2) = 1 / τ' al - 1 / τ' be := by
    have hd : ∀ x ∈ Set.uIcc al be,
        HasDerivAt (fun y : ℝ => -(τ' y)⁻¹) (τ'' x / (τ' x) ^ 2) x := by
      intro x hx
      have hne : τ' x ≠ 0 := hτ'ne x hx
      have h := ((hτ' x).inv hne).neg
      refine h.congr_deriv ?_
      field_simp
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt hd hcont2.intervalIntegrable
    rw [h]
    have hane : τ' al ≠ 0 := hτ'ne al Set.left_mem_uIcc
    have hbne : τ' be ≠ 0 := hτ'ne be Set.right_mem_uIcc
    field_simp
    ring
  have htelbd : (1 : ℝ) / τ' al - 1 / τ' be ≤ 2 / mu := by
    have hal := hmulow al (Set.left_mem_Icc.mpr halbe)
    have hbe := hmulow be (Set.right_mem_Icc.mpr halbe)
    have h1 : |(1 : ℝ) / τ' al| ≤ 1 / mu := by
      rw [abs_div, abs_one]
      exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hal) hmu (le_refl (1:ℝ))
        (by norm_num) hal
    have h2 : |(1 : ℝ) / τ' be| ≤ 1 / mu := by
      rw [abs_div, abs_one]
      exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hbe) hmu (le_refl (1:ℝ))
        (by norm_num) hbe
    have h3 := abs_le.mp h1
    have h4 := abs_le.mp h2
    have hmu' : (2 : ℝ) / mu = 1 / mu + 1 / mu := by ring
    rw [hmu']
    linarith [h3.1, h3.2, h4.1, h4.2]
  have hQintbd : (∫ x in al..be, ‖Q x‖) ≤ M1 * (be - al) / mu + 2 * M / mu := by
    have hi1 : IntervalIntegrable (fun x => ‖Q x‖) volume al be :=
      (hQc.norm).intervalIntegrable
    have hia : IntervalIntegrable (fun _ : ℝ => M1 / mu) volume al be :=
      intervalIntegrable_const
    have hib : IntervalIntegrable (fun x : ℝ => M * (τ'' x / (τ' x) ^ 2)) volume al be :=
      ((continuousOn_const).mul hcont2).intervalIntegrable
    have hi2 : IntervalIntegrable
        (fun x => M1 / mu + M * (τ'' x / (τ' x) ^ 2)) volume al be := hia.add hib
    have hmono := intervalIntegral.integral_mono_on halbe hi1 hi2 hQsplit
    refine le_trans hmono ?_
    rw [intervalIntegral.integral_add hia hib, intervalIntegral.integral_const,
      intervalIntegral.integral_const_mul, htel]
    have hstep : M * ((1 : ℝ) / τ' al - 1 / τ' be) ≤ M * (2 / mu) :=
      mul_le_mul_of_nonneg_left htelbd hMnn
    have h2M : M * (2 / mu) = 2 * M / mu := by ring
    rw [h2M] at hstep
    have hfirst : (be - al) • (M1 / mu) = M1 * (be - al) / mu := by
      rw [smul_eq_mul]
      ring
    rw [hfirst]
    linarith
  have hlamabs : |lam| = lam := abs_of_pos hlam
  rw [hlamabs] at hbound
  refine le_trans hbound ?_
  have hsum : ‖A be‖ / |τ' be| + ‖A al‖ / |τ' al| + (∫ x in al..be, ‖Q x‖)
      ≤ (4 * M + M1 * (be - al)) / mu := by
    have heq : M / mu + M / mu + (M1 * (be - al) / mu + 2 * M / mu)
        = (4 * M + M1 * (be - al)) / mu := by
      field_simp
      ring
    linarith [hbd1, hbd2, hQintbd]
  rw [div_le_div_iff₀ hlam (by positivity : (0:ℝ) < lam * mu)]
  have hmul : (4 * M + M1 * (be - al)) * lam
      = ((4 * M + M1 * (be - al)) / mu) * (lam * mu) := by
    field_simp
  calc (‖A be‖ / |τ' be| + ‖A al‖ / |τ' al| + ∫ x in al..be, ‖Q x‖) * (lam * mu)
      ≤ ((4 * M + M1 * (be - al)) / mu) * (lam * mu) :=
        mul_le_mul_of_nonneg_right hsum (by positivity)
    _ = (4 * M + M1 * (be - al)) * lam := hmul.symm

end VdCSide


/-! ### Van der Corput's second-derivative test -/

section VdC

/-- **Van der Corput's second-derivative test.**  If `τ'' ≥ kap > 0`, `‖A‖ ≤ M` and
`‖A'‖ ≤ M₁`, then `‖∫_a^b e^{i lam τ}A‖ ≤ (10M + 2M₁(b-a))/√(lam·kap)`.  The gain
`(lam·kap)^{-1/2}` is the curvature gain: the interval of length `2(lam·kap)^{-1/2}` around the
stationary point is estimated trivially and the first-derivative test is applied outside it. -/
theorem norm_integral_osc_vdc {a b lam kap M M1 : ℝ} (hab : a ≤ b) (hlam : 0 < lam)
    (hkap : 0 < kap)
    {τ τ' τ'' : ℝ → ℝ} {A A' : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x)
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x) (hτ''c : Continuous τ'')
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x)
    (hA : ∀ x, HasDerivAt A (A' x) x) (hA'c : Continuous A')
    (hM : ∀ x, ‖A x‖ ≤ M) (hM1 : ∀ x, ‖A' x‖ ≤ M1) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (10 * M + 2 * M1 * (b - a)) / Real.sqrt (lam * kap) := by
  have hMnn : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM a)
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) (hM1 a)
  have hτ''nn : ∀ x ∈ Set.Icc a b, (0 : ℝ) ≤ τ'' x :=
    fun x hx => le_trans (le_of_lt hkap) (hτ'' x hx)
  have hAc : Continuous A := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hA x).continuousAt
  have hτc : Continuous τ := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ x).continuousAt
  have hoscc : Continuous fun x : ℝ => osc lam (τ x) * A x := by
    refine Continuous.mul ?_ hAc
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul hτc)).mul continuous_const)
  have hsqpos : (0 : ℝ) < Real.sqrt (lam * kap) := Real.sqrt_pos.mpr (by positivity)
  set del : ℝ := 1 / Real.sqrt (lam * kap) with hdel
  have hdelpos : (0 : ℝ) < del := by rw [hdel]; positivity
  have hprod : lam * kap * del = Real.sqrt (lam * kap) := by
    have hs : Real.sqrt (lam * kap) * Real.sqrt (lam * kap) = lam * kap :=
      Real.mul_self_sqrt (by positivity)
    rw [hdel, mul_one_div, eq_comm, eq_div_iff (ne_of_gt hsqpos)]
    linarith [hs]
  obtain ⟨c, hc, hlow⟩ := exists_stationary_lower hab hkap hτ' hτ''
  set p : ℝ := max a (min b (c - del)) with hp
  set q : ℝ := max a (min b (c + del)) with hq
  have hap : a ≤ p := le_max_left _ _
  have hqb : q ≤ b := max_le hab (min_le_left _ _)
  have hpq : p ≤ q := by
    rw [hp, hq]
    exact max_le_max (le_refl a) (min_le_min (le_refl b) (by linarith))
  have hpb : p ≤ b := le_trans hpq hqb
  have haq : a ≤ q := le_trans hap hpq
  -- the three pieces
  have hsplit : (∫ x in a..b, osc lam (τ x) * A x)
      = (∫ x in a..p, osc lam (τ x) * A x) + (∫ x in p..q, osc lam (τ x) * A x)
        + ∫ x in q..b, osc lam (τ x) * A x := by
    rw [intervalIntegral.integral_add_adjacent_intervals
        (hoscc.intervalIntegrable a p) (hoscc.intervalIntegrable p q),
      intervalIntegral.integral_add_adjacent_intervals
        (hoscc.intervalIntegrable a q) (hoscc.intervalIntegrable q b)]
  -- the middle piece
  have hmid : ‖∫ x in p..q, osc lam (τ x) * A x‖ ≤ M * (2 * del) := by
    have hqp : q - p ≤ 2 * del := by
      have hmin : min b (c + del) ≤ min b (c - del) + 2 * del := by
        rcases le_total b (c - del) with h | h
        · rw [min_eq_left h]
          have h2 : min b (c + del) ≤ b := min_le_left _ _
          linarith
        · rw [min_eq_right h]
          have h2 : min b (c + del) ≤ c + del := min_le_right _ _
          linarith
      have hmax : max a (min b (c + del)) ≤ max a (min b (c - del)) + 2 * del := by
        rcases le_total (min b (c + del)) a with h | h
        · rw [max_eq_left h]
          have h2 : a ≤ max a (min b (c - del)) := le_max_left _ _
          linarith
        · rw [max_eq_right h]
          have h2 : min b (c - del) ≤ max a (min b (c - del)) := le_max_right _ _
          linarith
      rw [hp, hq]
      linarith [hmax]
    have hbd := intervalIntegral.norm_integral_le_of_norm_le_const
      (C := M) (a := p) (b := q) (f := fun x : ℝ => osc lam (τ x) * A x) ?_
    · refine le_trans hbd ?_
      have habsq : |q - p| = q - p := abs_of_nonneg (by linarith)
      rw [habsq]
      exact mul_le_mul_of_nonneg_left hqp hMnn
    · intro x _
      rw [norm_mul, norm_osc, one_mul]
      exact hM x
  -- the right piece
  have hright : ‖∫ x in q..b, osc lam (τ x) * A x‖
      ≤ (4 * M + M1 * (b - q)) / (lam * (kap * del)) := by
    rcases le_or_gt b (c + del) with hcase | hcase
    · have hqeqb : q = b := by
        rw [hq, min_eq_left hcase, max_eq_right hab]
      rw [hqeqb, intervalIntegral.integral_same, norm_zero]
      have hnn : (0 : ℝ) ≤ (4 * M + M1 * (b - b)) / (lam * (kap * del)) := by
        have : (b : ℝ) - b = 0 := by ring
        rw [this]
        positivity
      simpa [hqeqb] using hnn
    · have hqge : c + del ≤ q := by
        rw [hq, min_eq_right (le_of_lt hcase)]
        exact le_max_right _ _
      refine norm_integral_osc_side hqb hlam (by positivity) hτ hτ' hτ''c
        (fun x hx => hτ''nn x ⟨le_trans haq hx.1, hx.2⟩) hA hA'c hM hM1 ?_
      intro x hx
      have hxab : x ∈ Set.Icc a b := ⟨le_trans haq hx.1, hx.2⟩
      have hxc : del ≤ |x - c| := by
        have h1 : c + del ≤ x := le_trans hqge hx.1
        rw [abs_of_nonneg (by linarith)]
        linarith
      have h := hlow x hxab
      calc kap * del ≤ kap * |x - c| := mul_le_mul_of_nonneg_left hxc (le_of_lt hkap)
        _ ≤ |τ' x| := h
  -- the left piece
  have hleft : ‖∫ x in a..p, osc lam (τ x) * A x‖
      ≤ (4 * M + M1 * (p - a)) / (lam * (kap * del)) := by
    rcases le_or_gt (c - del) a with hcase | hcase
    · have hpeqa : p = a := by
        rw [hp, max_eq_left]
        exact le_trans (min_le_right _ _) hcase
      rw [hpeqa, intervalIntegral.integral_same, norm_zero]
      have hnn : (0 : ℝ) ≤ (4 * M + M1 * (a - a)) / (lam * (kap * del)) := by
        have : (a : ℝ) - a = 0 := by ring
        rw [this]
        positivity
      simpa [hpeqa] using hnn
    · have hple : p ≤ c - del := by
        have hcb : c ≤ b := hc.2
        rw [hp, min_eq_right (by linarith), max_eq_right (le_of_lt hcase)]
      refine norm_integral_osc_side hap hlam (by positivity) hτ hτ' hτ''c
        (fun x hx => hτ''nn x ⟨hx.1, le_trans hx.2 hpb⟩) hA hA'c hM hM1 ?_
      intro x hx
      have hxab : x ∈ Set.Icc a b := ⟨hx.1, le_trans hx.2 hpb⟩
      have hxc : del ≤ |x - c| := by
        have h1 : x ≤ c - del := le_trans hx.2 hple
        rw [abs_of_nonpos (by linarith)]
        linarith
      have h := hlow x hxab
      calc kap * del ≤ kap * |x - c| := mul_le_mul_of_nonneg_left hxc (le_of_lt hkap)
        _ ≤ |τ' x| := h
  -- assemble
  rw [hsplit]
  refine le_trans (norm_add_le _ _) ?_
  refine le_trans (add_le_add (le_trans (norm_add_le _ _) (add_le_add hleft hmid)) hright) ?_
  have hkd : lam * (kap * del) = Real.sqrt (lam * kap) := by
    rw [← hprod]
    ring
  rw [hkd]
  have hmd : M * (2 * del) = 2 * M / Real.sqrt (lam * kap) := by
    rw [hdel]
    field_simp
  rw [hmd]
  have hpa : (0 : ℝ) ≤ p - a := by linarith
  have hbq : (0 : ℝ) ≤ b - q := by linarith
  have hsum : (p - a) + (b - q) ≤ b - a := by linarith
  have hcomb : (4 * M + M1 * (p - a)) / Real.sqrt (lam * kap)
        + 2 * M / Real.sqrt (lam * kap)
        + (4 * M + M1 * (b - q)) / Real.sqrt (lam * kap)
      = ((4 * M + M1 * (p - a)) + 2 * M + (4 * M + M1 * (b - q)))
        / Real.sqrt (lam * kap) := by
    ring
  rw [hcomb]
  refine div_le_div_of_nonneg_right ?_ (le_of_lt hsqpos)
  nlinarith [mul_le_mul_of_nonneg_left hsum hM1nn, mul_nonneg hM1nn hpa,
    mul_nonneg hM1nn hbq]

end VdC


/-! ### The phase of the kernel in the first frequency variable -/

section KernelPhase

/-- Flipping the sign of the phase does not change the modulus of an oscillatory integral. -/
theorem norm_integral_osc_conj {a b lam : ℝ} (τ : ℝ → ℝ) (A : ℝ → ℂ) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      = ‖∫ x in a..b, osc lam (-τ x) * (starRingEnd ℂ) (A x)‖ := by
  have hpt : ∀ x : ℝ, (starRingEnd ℂ) (osc lam (τ x) * A x)
      = osc lam (-τ x) * (starRingEnd ℂ) (A x) := by
    intro x
    rw [map_mul, osc, osc]
    congr 1
    rw [← Complex.exp_conj]
    congr 1
    rw [map_mul, Complex.conj_I, Complex.conj_ofReal]
    push_cast
    ring
  have hcj : (starRingEnd ℂ) (∫ x in a..b, osc lam (τ x) * A x)
      = ∫ x in a..b, (starRingEnd ℂ) (osc lam (τ x) * A x) := by
    simp only [intervalIntegral, map_sub, integral_conj]
  rw [← intervalIntegral.integral_congr (fun x _ => hpt x), ← hcj, RCLike.norm_conj]

/-- The radial variable in the plane, as a function of the first coordinate. -/
noncomputable def rr (w2 w1 : ℝ) : ℝ := Real.sqrt (w1 ^ 2 + w2 ^ 2)

theorem rr_pos {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) : 0 < rr w2 w1 := by
  rw [rr, Real.sqrt_pos]
  positivity

theorem rr_sq {w2 : ℝ} (w1 : ℝ) : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := by
  rw [rr, Real.sq_sqrt (by positivity)]

theorem hasDerivAt_rr {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) :
    HasDerivAt (rr w2) (w1 / rr w2 w1) w1 := by
  have hinner : HasDerivAt (fun x : ℝ => x ^ 2 + w2 ^ 2) (2 * w1) w1 := by
    have h := (hasDerivAt_pow 2 w1).add_const (w2 ^ 2)
    refine h.congr_deriv ?_
    push_cast
    ring
  have hne : w1 ^ 2 + w2 ^ 2 ≠ 0 := by positivity
  have h := hinner.sqrt hne
  refine h.congr_deriv ?_
  rw [rr]
  have hs : (0 : ℝ) < Real.sqrt (w1 ^ 2 + w2 ^ 2) := by
    rw [Real.sqrt_pos]
    positivity
  field_simp

/-- The second derivative of the radial variable: this is the curvature of the circle. -/
theorem hasDerivAt_rr' {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) :
    HasDerivAt (fun x : ℝ => x / rr w2 x) (w2 ^ 2 / (rr w2 w1) ^ 3) w1 := by
  have hrne : rr w2 w1 ≠ 0 := ne_of_gt (rr_pos h2 w1)
  have h := (hasDerivAt_id w1).div (hasDerivAt_rr h2 w1) hrne
  refine h.congr_deriv ?_
  have hsq : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := rr_sq w1
  simp only [id_eq]
  field_simp
  nlinarith [hsq, rr_pos h2 w1]

/-- The curvature lower bound on the relevant range. -/
theorem rr_curvature_lower {w2 w1 R : ℝ} (h2 : 0 < w2) (hw1 : |w1| ≤ R) :
    w2 ^ 2 / (Real.sqrt (R ^ 2 + w2 ^ 2)) ^ 3 ≤ w2 ^ 2 / (rr w2 w1) ^ 3 := by
  have hrpos : 0 < rr w2 w1 := rr_pos (ne_of_gt h2) w1
  have hsq : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := rr_sq w1
  have hw1sq : w1 ^ 2 ≤ R ^ 2 := by
    nlinarith [sq_abs w1, abs_nonneg w1]
  have h1 : rr w2 w1 ≤ Real.sqrt (R ^ 2 + w2 ^ 2) := by
    rw [rr]
    exact Real.sqrt_le_sqrt (by linarith)
  have hcube : (rr w2 w1) ^ 3 ≤ (Real.sqrt (R ^ 2 + w2 ^ 2)) ^ 3 :=
    pow_le_pow_left₀ (le_of_lt hrpos) h1 3
  exact div_le_div_of_nonneg_left (by positivity) (by positivity) hcube

end KernelPhase


/-! ### The kernel in polar coordinates -/

section KernelPolar

/-- The coefficient of the linear radial phase: `⟨u,θ(φ)⟩ + εt`.  It vanishes exactly at the
angles where the radial direction is stationary. -/
def psiu (u : Pl) (ε t φ : ℝ) : ℝ := (inner ℝ u (pt 1 φ) : ℝ) + ε * t

/-- The kernel of the single-scale operator. -/
def kern (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) : ℂ :=
  ∫ ω : Pl, ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω

/-- Polar derivative data for the multiplier: the radial derivatives `mr k` and the angular
derivatives `ma k` of `(r,φ) ↦ m t (pt r φ)`, up to third order.  Radial derivatives gain a
factor `2^{-j}` each; angular derivatives are bounded. -/
structure PolarData (j : ℕ) (m : ℝ → Pl → ℂ)
    (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (B0 : ℝ) : Prop where
  r0 : ∀ (t φ r : ℝ), mr 0 t φ r = m t (pt r φ)
  rd : ∀ (k : ℕ), k ≤ 3 → ∀ (t φ r : ℝ), HasDerivAt (mr k t φ) (mr (k + 1) t φ r) r
  rc : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ : ℝ), Continuous (mr k t φ)
  rb : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ r : ℝ),
    ‖mr k t φ r‖ ≤ B0 * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
  rz : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ r : ℝ), r = 0 ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r → mr k t φ r = 0
  a0 : ∀ (t r φ : ℝ), ma 0 t r φ = m t (pt r φ)
  ad : ∀ (k : ℕ), k ≤ 2 → ∀ (t r φ : ℝ), HasDerivAt (ma k t r) (ma (k + 1) t r φ) φ
  ac : ∀ (k : ℕ), k ≤ 3 → ∀ (t r : ℝ), Continuous (ma k t r)
  ab : ∀ (k : ℕ), k ≤ 3 → ∀ (t r φ : ℝ), ‖ma k t r φ‖ ≤ B0

theorem PolarData.nonneg {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) : 0 ≤ B0 :=
  le_trans (norm_nonneg _) (hp.ab 0 (by norm_num) 0 0 0)

/-- In polar coordinates the kernel integrand is an oscillatory factor with a phase that is
*linear* in the radius. -/
theorem kern_polar_pt (j : ℕ) (m : ℝ → Pl → ℂ) (ε t : ℝ) (u : Pl) {r : ℝ} (hr : 0 ≤ r) (φ : ℝ) :
    (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))
      = osc (2 * π) (r * psiu u ε t φ) * ((r : ℂ) * m t (pt r φ)) := by
  have hinner : (inner ℝ u (pt r φ) : ℝ) = r * (inner ℝ u (pt 1 φ) : ℝ) := by
    rw [pt_eq_smul r φ, real_inner_smul_right]
  have hE : ee (-(r * (inner ℝ u (pt 1 φ) : ℝ)))
        * Complex.exp (((2 * π * ε * t * r : ℝ) : ℂ) * Complex.I)
      = osc (2 * π) (r * psiu u ε t φ) := by
    rw [ee, osc, ← Complex.exp_add, psiu]
    congr 1
    push_cast
    ring
  rw [mfull, hinner, norm_pt r φ hr, Complex.real_smul, ← hE]
  ring

theorem continuous_kern_integrand {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    Continuous fun ω : Pl => ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω := by
  refine Continuous.mul ?_ (contDiff_mfull hm ε t).continuous
  refine Complex.continuous_exp.comp ?_
  refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
  exact continuous_const.mul (continuous_const.inner continuous_id).neg

/-- The amplitude of the radial oscillatory integral. -/
def radAmp (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := (r : ℂ) * mr 0 t φ r

/-- Its first derivative. -/
def radAmp1 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := mr 0 t φ r + (r : ℂ) * mr 1 t φ r

/-- Its second derivative. -/
def radAmp2 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 2 * mr 1 t φ r + (r : ℂ) * mr 2 t φ r

/-- Its third derivative. -/
def radAmp3 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 3 * mr 2 t φ r + (r : ℂ) * mr 3 t φ r

/-- Its fourth derivative. -/
def radAmp4 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 4 * mr 3 t φ r + (r : ℂ) * mr 4 t φ r

theorem hasDerivAt_radAmp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp mr t φ) (radAmp1 mr t φ r) r := by
  have h := (hasDerivAt_ofReal_id r).mul (hp.rd 0 (by norm_num) t φ r)
  refine h.congr_deriv ?_
  rw [radAmp1]
  ring

theorem hasDerivAt_radAmp1 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp1 mr t φ) (radAmp2 mr t φ r) r := by
  have h := (hp.rd 0 (by norm_num) t φ r).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 1 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp2]
  ring

theorem hasDerivAt_radAmp2 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp2 mr t φ) (radAmp3 mr t φ r) r := by
  have h := ((hp.rd 1 (by norm_num) t φ r).const_mul (2 : ℂ)).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 2 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp3]
  ring

theorem hasDerivAt_radAmp3 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp3 mr t φ) (radAmp4 mr t φ r) r := by
  have h := ((hp.rd 2 (by norm_num) t φ r).const_mul (3 : ℂ)).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 3 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp4]
  ring

theorem continuous_radAmp3 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) : Continuous (radAmp3 mr t φ) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul (hp.rc 2 (by norm_num) t φ)
  · exact Complex.continuous_ofReal.mul (hp.rc 3 (by norm_num) t φ)

theorem continuous_radAmp4 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) : Continuous (radAmp4 mr t φ) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul (hp.rc 3 (by norm_num) t φ)
  · exact Complex.continuous_ofReal.mul (hp.rc 4 (by norm_num) t φ)

theorem radAmp_zero_left {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) :
    radAmp mr t φ 0 = 0 ∧ radAmp1 mr t φ 0 = 0 ∧ radAmp2 mr t φ 0 = 0
      ∧ radAmp3 mr t φ 0 = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [radAmp]
    simp
  · rw [radAmp1, hp.rz 0 (by norm_num) t φ 0 (Or.inl rfl)]
    simp
  · rw [radAmp2, hp.rz 1 (by norm_num) t φ 0 (Or.inl rfl)]
    simp
  · rw [radAmp3, hp.rz 2 (by norm_num) t φ 0 (Or.inl rfl)]
    simp

theorem radAmp_zero_right {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) {r : ℝ} (hr : (2 : ℝ) ^ ((j : ℤ) + 1) < r) :
    radAmp mr t φ r = 0 ∧ radAmp1 mr t φ r = 0 ∧ radAmp2 mr t φ r = 0
      ∧ radAmp3 mr t φ r = 0 := by
  have h0 := hp.rz 0 (by norm_num) t φ r (Or.inr hr)
  have h1 := hp.rz 1 (by norm_num) t φ r (Or.inr hr)
  have h2 := hp.rz 2 (by norm_num) t φ r (Or.inr hr)
  have h3 := hp.rz 3 (by norm_num) t φ r (Or.inr hr)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [radAmp, h0, mul_zero]
  · rw [radAmp1, h0, h1]
    simp
  · rw [radAmp2, h1, h2]
    simp
  · rw [radAmp3, h2, h3]
    simp

/-- The radial integral of the kernel integrand is an interval integral with a linear phase. -/
theorem radial_integral_eq {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) :
    (∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))
      = ∫ r in (0 : ℝ)..((2 : ℝ) ^ ((j : ℤ) + 2)),
          osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have hpt : ∀ r ∈ Set.Ioi (0 : ℝ),
      (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))
        = osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
    intro r hr
    rw [kern_polar_pt j m ε t u (le_of_lt hr) φ, radAmp, hp.r0]
  rw [setIntegral_congr_fun measurableSet_Ioi hpt]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ) \ Set.Ioc (0 : ℝ) b,
      osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r = 0 := by
    intro r hr
    have hrb : b < r := by
      rcases hr with ⟨hr1, hr2⟩
      rw [Set.mem_Ioc] at hr2
      exact not_le.mp fun h => hr2 ⟨hr1, h⟩
    have hgt : (2 : ℝ) ^ ((j : ℤ) + 1) < r := by
      refine lt_of_lt_of_le ?_ (le_of_lt hrb)
      rw [hb]
      exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
    rw [(radAmp_zero_right hp t φ hgt).1, mul_zero]
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi Set.Ioc_subset_Ioi_self
    hzero]
  rw [intervalIntegral.integral_of_le (le_of_lt hbpos)]

/-- **The radial estimate.**  Four integrations by parts in the radius, whose phase is linear,
give four powers of `(2^j |ψ|)` off the trivial size `2^{2j}`. -/
theorem norm_radial_integral_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) (hψ : psiu u ε t φ ≠ 0) :
    ‖∫ r in Set.Ioi (0 : ℝ),
        (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))‖
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hlam : (2 * π : ℝ) ≠ 0 := by
    have := Real.pi_pos
    positivity
  have hbgt : (2 : ℝ) ^ ((j : ℤ) + 1) < b := by
    rw [hb]
    exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
  rw [radial_integral_eq hp ε t u φ]
  have hibp := norm_integral_osc_linear_ibp4 (a := (0 : ℝ)) (b := b) (lam := 2 * π)
    (psi := psiu u ε t φ) (le_of_lt hbpos) hlam hψ
    (hasDerivAt_radAmp hp t φ) (hasDerivAt_radAmp1 hp t φ) (hasDerivAt_radAmp2 hp t φ)
    (hasDerivAt_radAmp3 hp t φ) (continuous_radAmp4 hp t φ)
    (radAmp_zero_left hp t φ).1 (radAmp_zero_right hp t φ hbgt).1
    (radAmp_zero_left hp t φ).2.1 (radAmp_zero_right hp t φ hbgt).2.1
    (radAmp_zero_left hp t φ).2.2.1 (radAmp_zero_right hp t φ hbgt).2.2.1
    (radAmp_zero_left hp t φ).2.2.2 (radAmp_zero_right hp t φ hbgt).2.2.2
  have hA4 : ∀ r ∈ Set.Icc (0 : ℝ) b,
      ‖radAmp4 mr t φ r‖ ≤ 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
    intro r hr
    have h3 : ‖mr 3 t φ r‖ ≤ B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
      have h := hp.rb 3 (by norm_num) t φ r
      norm_num at h
      convert h using 3
      norm_num
    have h4 : ‖mr 4 t φ r‖ ≤ B0 * (2 : ℝ) ^ (-(4 * (j : ℤ))) := by
      have h := hp.rb 4 (by norm_num) t φ r
      norm_num at h
      convert h using 3
      norm_num
    have hrb : |r| ≤ b := by
      rw [abs_of_nonneg hr.1]
      exact hr.2
    have hstep : ‖radAmp4 mr t φ r‖ ≤ 4 * ‖mr 3 t φ r‖ + b * ‖mr 4 t φ r‖ := by
      rw [radAmp4]
      refine le_trans (norm_add_le _ _) ?_
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have h4n : ‖(4 : ℂ)‖ = 4 := by norm_num
      rw [h4n]
      have hmul : |r| * ‖mr 4 t φ r‖ ≤ b * ‖mr 4 t φ r‖ :=
        mul_le_mul_of_nonneg_right hrb (norm_nonneg _)
      linarith
    have hbval : b * ((2 : ℝ) ^ (-(4 * (j : ℤ)))) = 4 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
      rw [hb, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      rw [show ((j : ℤ) + 2 + -(4 * (j : ℤ))) = 2 + -(3 * (j : ℤ)) by ring]
      rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    calc ‖radAmp4 mr t φ r‖ ≤ 4 * ‖mr 3 t φ r‖ + b * ‖mr 4 t φ r‖ := hstep
      _ ≤ 4 * (B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) + b * (B0 * (2 : ℝ) ^ (-(4 * (j : ℤ)))) := by
          refine add_le_add (by linarith) ?_
          exact mul_le_mul_of_nonneg_left h4 (le_of_lt hbpos)
      _ = 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
          rw [show b * (B0 * (2 : ℝ) ^ (-(4 * (j : ℤ))))
            = B0 * (b * ((2 : ℝ) ^ (-(4 * (j : ℤ))))) by ring, hbval]
          ring
  have hintA4 : (∫ r in (0 : ℝ)..b, ‖radAmp4 mr t φ r‖)
      ≤ b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) := by
    have hint1 : IntervalIntegrable (fun r => ‖radAmp4 mr t φ r‖) volume 0 b :=
      ((continuous_radAmp4 hp t φ).norm).intervalIntegrable 0 b
    have hint2 : IntervalIntegrable
        (fun _ : ℝ => 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) volume 0 b :=
      intervalIntegrable_const
    have h := intervalIntegral.integral_mono_on (le_of_lt hbpos) hint1 hint2 hA4
    rw [intervalIntegral.integral_const] at h
    have heq : (b - 0) • (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))))
        = b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) := by
      rw [smul_eq_mul]
      ring
    rw [heq] at h
    exact h
  have hpsipos : (0 : ℝ) < |psiu u ε t φ| := abs_pos.mpr hψ
  have hbv : b * ((2 : ℝ) ^ (-(3 * (j : ℤ)))) = 4 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := by
    rw [hb, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    rw [show ((j : ℤ) + 2 + -(3 * (j : ℤ))) = 2 + -(2 * (j : ℤ)) by ring]
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    norm_num
  have habs : |2 * π| = 2 * π := abs_of_nonneg (by positivity)
  have hquart : (256 : ℝ) ≤ |2 * π| ^ 4 := by
    rw [habs]
    have h4 : (4 : ℝ) ≤ 2 * π := by linarith [Real.two_le_pi]
    have h := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 4) h4 4
    norm_num at h
    exact h
  have hfinal : (|2 * π| ^ 4 * |psiu u ε t φ| ^ 4)⁻¹ * (b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))))
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
    have hlhs : (|2 * π| ^ 4 * |psiu u ε t φ| ^ 4)⁻¹
          * (b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))))
        = (32 / |2 * π| ^ 4) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ)))) / |psiu u ε t φ| ^ 4 := by
      rw [show b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))))
        = 8 * B0 * (b * ((2 : ℝ) ^ (-(3 * (j : ℤ))))) by ring, hbv]
      rw [mul_inv]
      field_simp
      ring
    rw [hlhs]
    have hfac : (32 : ℝ) / |2 * π| ^ 4 ≤ 1 := by
      rw [div_le_one (by nlinarith)]
      linarith
    have hnum : (0 : ℝ) ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := by positivity
    refine div_le_div_of_nonneg_right ?_ (by positivity)
    calc (32 / |2 * π| ^ 4) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))))
        ≤ 1 * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ)))) := mul_le_mul_of_nonneg_right hfac hnum
      _ = B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := one_mul _
  refine le_trans hibp (le_trans ?_ hfinal)
  exact mul_le_mul_of_nonneg_left hintA4 (by positivity)

end KernelPolar


/-! ### Two integrations by parts with explicit amplitude bounds -/

section IbpChain

/-- The amplitude after one integration by parts, `(A/τ')`. -/
def chainB (τ1 τ2 : ℝ → ℝ) (A A1 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A1 x / ((τ1 x : ℝ) : ℂ) - A x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2

/-- Its derivative. -/
def chainB1 (τ1 τ2 τ3 : ℝ → ℝ) (A A1 A2 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A2 x / ((τ1 x : ℝ) : ℂ) - 2 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2
    - A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2
    + 2 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 3

/-- The amplitude after two integrations by parts. -/
def chainC (τ1 τ2 τ3 : ℝ → ℝ) (A A1 A2 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A2 x / ((τ1 x : ℝ) : ℂ) ^ 2 - 3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3
    - A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3
    + 3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4

theorem hasDerivAt_chain_first {τ1 τ2 : ℝ → ℝ} {A A1 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hA : HasDerivAt A (A1 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (fun y => A y / ((τ1 y : ℝ) : ℂ)) (chainB τ1 τ2 A A1 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have h := hA.div hτ1C hneC
  refine h.congr_deriv ?_
  rw [chainB]
  field_simp

theorem hasDerivAt_chainB {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hτ2 : HasDerivAt τ2 (τ3 x) x)
    (hA : HasDerivAt A (A1 x) x) (hA1 : HasDerivAt A1 (A2 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (chainB τ1 τ2 A A1) (chainB1 τ1 τ2 τ3 A A1 A2 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have hτ2C : HasDerivAt (fun z : ℝ => ((τ2 z : ℝ) : ℂ)) ((τ3 x : ℝ) : ℂ) x :=
    hτ2.ofReal_comp
  have hsq : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ) ^ 2)
      (2 * ((τ1 x : ℝ) : ℂ) * ((τ2 x : ℝ) : ℂ)) x := by
    have h := hτ1C.pow 2
    refine h.congr_deriv ?_
    push_cast
    ring
  have hsqne : ((τ1 x : ℝ) : ℂ) ^ 2 ≠ 0 := pow_ne_zero _ hneC
  have hfirst : HasDerivAt (fun y => A1 y / ((τ1 y : ℝ) : ℂ))
      ((A2 x * ((τ1 x : ℝ) : ℂ) - A1 x * ((τ2 x : ℝ) : ℂ)) / ((τ1 x : ℝ) : ℂ) ^ 2) x :=
    hA1.div hτ1C hneC
  have hnum : HasDerivAt (fun y => A y * ((τ2 y : ℝ) : ℂ))
      (A1 x * ((τ2 x : ℝ) : ℂ) + A x * ((τ3 x : ℝ) : ℂ)) x := hA.mul hτ2C
  have hsecond : HasDerivAt (fun y => A y * ((τ2 y : ℝ) : ℂ) / ((τ1 y : ℝ) : ℂ) ^ 2)
      (((A1 x * ((τ2 x : ℝ) : ℂ) + A x * ((τ3 x : ℝ) : ℂ)) * ((τ1 x : ℝ) : ℂ) ^ 2
        - A x * ((τ2 x : ℝ) : ℂ) * (2 * ((τ1 x : ℝ) : ℂ) * ((τ2 x : ℝ) : ℂ)))
          / (((τ1 x : ℝ) : ℂ) ^ 2) ^ 2) x := hnum.div hsq hsqne
  have h := hfirst.sub hsecond
  refine h.congr_deriv ?_
  rw [chainB1]
  field_simp
  ring

theorem hasDerivAt_chainB_div {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hτ2 : HasDerivAt τ2 (τ3 x) x)
    (hA : HasDerivAt A (A1 x) x) (hA1 : HasDerivAt A1 (A2 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (fun y => chainB τ1 τ2 A A1 y / ((τ1 y : ℝ) : ℂ))
      (chainC τ1 τ2 τ3 A A1 A2 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have h := (hasDerivAt_chainB hτ1 hτ2 hA hA1 hne).div hτ1C hneC
  refine h.congr_deriv ?_
  rw [chainC, chainB1, chainB]
  field_simp
  ring

theorem continuous_chainB {τ1 τ2 : ℝ → ℝ} {A A1 : ℝ → ℂ}
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hAc : Continuous A) (hA1c : Continuous A1)
    (hne : ∀ x, τ1 x ≠ 0) : Continuous (chainB τ1 τ2 A A1) := by
  have hτ1C : Continuous fun x : ℝ => ((τ1 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ1c
  have hτ2C : Continuous fun x : ℝ => ((τ2 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ2c
  have hneC : ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ≠ 0 := fun x => by exact_mod_cast hne x
  refine Continuous.sub (hA1c.div hτ1C hneC) ?_
  exact (hAc.mul hτ2C).div (hτ1C.pow 2) fun x => pow_ne_zero _ (hneC x)

theorem continuous_chainC {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2)
    (hne : ∀ x, τ1 x ≠ 0) : Continuous (chainC τ1 τ2 τ3 A A1 A2) := by
  have hτ1C : Continuous fun x : ℝ => ((τ1 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ1c
  have hτ2C : Continuous fun x : ℝ => ((τ2 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ2c
  have hτ3C : Continuous fun x : ℝ => ((τ3 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ3c
  have hneC : ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ≠ 0 := fun x => by exact_mod_cast hne x
  have hp : ∀ n : ℕ, ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ^ n ≠ 0 := fun n x => pow_ne_zero _ (hneC x)
  refine Continuous.add (Continuous.sub (Continuous.sub ?_ ?_) ?_) ?_
  · exact hA2c.div (hτ1C.pow 2) (hp 2)
  · exact ((continuous_const.mul hA1c).mul hτ2C).div (hτ1C.pow 3) (hp 3)
  · exact (hAc.mul hτ3C).div (hτ1C.pow 3) (hp 3)
  · exact ((continuous_const.mul hAc).mul (hτ2C.pow 2)).div (hτ1C.pow 4) (hp 4)

/-- The size of the amplitude after two integrations by parts. -/
theorem norm_chainC_le {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {mu M0 M1 M2 T2 T3 : ℝ}
    (hmu : 0 < mu) {x : ℝ} (hlow : mu ≤ |τ1 x|)
    (hM0 : ‖A x‖ ≤ M0) (hM1 : ‖A1 x‖ ≤ M1) (hM2 : ‖A2 x‖ ≤ M2)
    (hT2 : |τ2 x| ≤ T2) (hT3 : |τ3 x| ≤ T3) :
    ‖chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3 + 3 * M0 * T2 ^ 2 / mu ^ 4 := by
  have habs : ∀ n : ℕ, mu ^ n ≤ ‖((τ1 x : ℝ) : ℂ) ^ n‖ := by
    intro n
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs]
    exact pow_le_pow_left₀ (le_of_lt hmu) hlow n
  have hmun : ∀ n : ℕ, (0 : ℝ) < mu ^ n := fun n => pow_pos hmu n
  have hdiv : ∀ (z : ℂ) (n : ℕ) (K : ℝ), ‖z‖ ≤ K → 0 ≤ K →
      ‖z / ((τ1 x : ℝ) : ℂ) ^ n‖ ≤ K / mu ^ n := by
    intro z n K hz hK
    rw [norm_div]
    exact div_le_div_of_le_of_le (lt_of_lt_of_le (hmun n) (habs n)) (hmun n) hz hK (habs n)
  have hT2nn : (0 : ℝ) ≤ T2 := le_trans (abs_nonneg _) hT2
  have hT3nn : (0 : ℝ) ≤ T3 := le_trans (abs_nonneg _) hT3
  have hM0nn : (0 : ℝ) ≤ M0 := le_trans (norm_nonneg _) hM0
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) hM1
  have hM2nn : (0 : ℝ) ≤ M2 := le_trans (norm_nonneg _) hM2
  have h1 : ‖A2 x / ((τ1 x : ℝ) : ℂ) ^ 2‖ ≤ M2 / mu ^ 2 := hdiv _ 2 _ hM2 hM2nn
  have h2 : ‖3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3‖ ≤ 3 * M1 * T2 / mu ^ 3 := by
    refine hdiv _ 3 _ ?_ (by positivity)
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h3 : ‖(3 : ℂ)‖ = 3 := by norm_num
    rw [h3]
    exact mul_le_mul (mul_le_mul_of_nonneg_left hM1 (by norm_num)) hT2
      (abs_nonneg _) (by positivity)
  have h3 : ‖A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3‖ ≤ M0 * T3 / mu ^ 3 := by
    refine hdiv _ 3 _ ?_ (by positivity)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul hM0 hT3 (abs_nonneg _) hM0nn
  have h4 : ‖3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4‖
      ≤ 3 * M0 * T2 ^ 2 / mu ^ 4 := by
    refine hdiv _ 4 _ ?_ (by positivity)
    rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs]
    have h3 : ‖(3 : ℂ)‖ = 3 := by norm_num
    rw [h3]
    refine mul_le_mul (mul_le_mul_of_nonneg_left hM0 (by norm_num))
      (pow_le_pow_left₀ (abs_nonneg _) hT2 2) (by positivity) (by positivity)
  rw [chainC]
  set X1 := A2 x / ((τ1 x : ℝ) : ℂ) ^ 2 with hX1
  set X2 := 3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3 with hX2
  set X3 := A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3 with hX3
  set X4 := 3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4 with hX4
  have e1 : ‖X1 - X2 - X3 + X4‖ ≤ ‖X1 - X2 - X3‖ + ‖X4‖ := norm_add_le _ _
  have e2 : ‖X1 - X2 - X3‖ ≤ ‖X1 - X2‖ + ‖X3‖ := norm_sub_le _ _
  have e3 : ‖X1 - X2‖ ≤ ‖X1‖ + ‖X2‖ := norm_sub_le _ _
  linarith

/-- **Two integrations by parts with explicit bounds.**  The phase derivative is bounded below by
`mu`, the amplitude and its first two derivatives by `M0, M1, M2`, and the second and third
derivatives of the phase by `T2, T3`. -/
theorem norm_integral_osc_ibp2_bound {a b lam mu M0 M1 M2 T2 T3 : ℝ}
    (hab : a ≤ b) (hlam : lam ≠ 0) (hmu : 0 < mu)
    {τ τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ1 x) x) (hτ1 : ∀ x, HasDerivAt τ1 (τ2 x) x)
    (hτ2 : ∀ x, HasDerivAt τ2 (τ3 x) x)
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2c : Continuous A2)
    (hlow : ∀ x, mu ≤ |τ1 x|)
    (hM0 : ∀ x, ‖A x‖ ≤ M0) (hM1 : ∀ x, ‖A1 x‖ ≤ M1) (hM2 : ∀ x, ‖A2 x‖ ≤ M2)
    (hT2 : ∀ x, |τ2 x| ≤ T2) (hT3 : ∀ x, |τ3 x| ≤ T3)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (b - a) * (lam ^ 2)⁻¹
        * (M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
            + 3 * M0 * T2 ^ 2 / mu ^ 4) := by
  have hne : ∀ x, τ1 x ≠ 0 := by
    intro x
    have h := hlow x
    intro h0
    rw [h0] at h
    simp at h
    linarith
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hBc : Continuous (chainB τ1 τ2 A A1) := continuous_chainB hτ1c hτ2c hAc hA1c hne
  have hCc : Continuous (chainC τ1 τ2 τ3 A A1 A2) :=
    continuous_chainC hτ1c hτ2c hτ3c hAc hA1c hA2c hne
  have hBa : chainB τ1 τ2 A A1 a = 0 := by
    rw [chainB, hAa, h1a]
    simp
  have hBb : chainB τ1 τ2 A A1 b = 0 := by
    rw [chainB, hAb, h1b]
    simp
  have h := norm_integral_osc_ibp_twice hab hlam hτ hτ1c hne hAc hBc hCc
    (fun x => hasDerivAt_chain_first (hτ1 x) (hA x) (hne x))
    (fun x => hasDerivAt_chainB_div (hτ1 x) (hτ2 x) (hA x) (hA1 x) (hne x))
    hAa hAb hBa hBb
  refine le_trans h ?_
  set K : ℝ := M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
    + 3 * M0 * T2 ^ 2 / mu ^ 4 with hK
  have hbound : (∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖) ≤ (b - a) * K := by
    have hint1 : IntervalIntegrable (fun x => ‖chainC τ1 τ2 τ3 A A1 A2 x‖) volume a b :=
      hCc.norm.intervalIntegrable a b
    have hint2 : IntervalIntegrable (fun _ : ℝ => K) volume a b := intervalIntegrable_const
    have hmono := intervalIntegral.integral_mono_on hab hint1 hint2
      (fun x _ => norm_chainC_le hmu (hlow x) (hM0 x) (hM1 x) (hM2 x) (hT2 x) (hT3 x))
    rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
    exact hmono
  have hlamnn : (0 : ℝ) ≤ (lam ^ 2)⁻¹ := by positivity
  calc (lam ^ 2)⁻¹ * ∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ (lam ^ 2)⁻¹ * ((b - a) * K) := mul_le_mul_of_nonneg_left hbound hlamnn
    _ = (b - a) * (lam ^ 2)⁻¹ * K := by ring

end IbpChain


/-! ### The angular phase and the plate cutoffs -/

section AngularPhase

theorem psiu_eq (u : Pl) (ε t φ : ℝ) :
    psiu u ε t φ = u 0 * Real.cos φ + u 1 * Real.sin φ + ε * t := by
  rw [psiu, pt, inner_two, mk2_apply_zero, mk2_apply_one]
  ring

/-- The first angular derivative of the phase coefficient. -/
def psi1 (u : Pl) (φ : ℝ) : ℝ := -(u 0) * Real.sin φ + u 1 * Real.cos φ

/-- The second angular derivative. -/
def psi2 (u : Pl) (φ : ℝ) : ℝ := -(u 0 * Real.cos φ + u 1 * Real.sin φ)

/-- The third angular derivative. -/
def psi3 (u : Pl) (φ : ℝ) : ℝ := u 0 * Real.sin φ - u 1 * Real.cos φ

theorem hasDerivAt_psiu (u : Pl) (ε t φ : ℝ) : HasDerivAt (psiu u ε t) (psi1 u φ) φ := by
  have h : HasDerivAt (fun x : ℝ => u 0 * Real.cos x + u 1 * Real.sin x + ε * t)
      (u 0 * (-Real.sin φ) + u 1 * Real.cos φ) φ := by
    have h1 := (Real.hasDerivAt_cos φ).const_mul (u 0)
    have h2 := (Real.hasDerivAt_sin φ).const_mul (u 1)
    exact (h1.add h2).add_const _
  have heq : psiu u ε t = fun x : ℝ => u 0 * Real.cos x + u 1 * Real.sin x + ε * t := by
    funext x
    exact psiu_eq u ε t x
  rw [heq]
  refine h.congr_deriv ?_
  rw [psi1]
  ring

theorem hasDerivAt_psi1 (u : Pl) (φ : ℝ) : HasDerivAt (psi1 u) (psi2 u φ) φ := by
  have h1 := (Real.hasDerivAt_sin φ).const_mul (-(u 0))
  have h2 := (Real.hasDerivAt_cos φ).const_mul (u 1)
  have h := h1.add h2
  refine h.congr_deriv ?_
  rw [psi2]
  ring

theorem hasDerivAt_psi2 (u : Pl) (φ : ℝ) : HasDerivAt (psi2 u) (psi3 u φ) φ := by
  have h1 := (Real.hasDerivAt_cos φ).const_mul (u 0)
  have h2 := (Real.hasDerivAt_sin φ).const_mul (u 1)
  have h := (h1.add h2).neg
  refine h.congr_deriv ?_
  rw [psi3]
  ring

theorem continuous_psi1 (u : Pl) : Continuous (psi1 u) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul Real.continuous_sin
  · exact continuous_const.mul Real.continuous_cos

theorem continuous_psi2 (u : Pl) : Continuous (psi2 u) := by
  refine Continuous.neg (Continuous.add ?_ ?_)
  · exact continuous_const.mul Real.continuous_cos
  · exact continuous_const.mul Real.continuous_sin

theorem continuous_psi3 (u : Pl) : Continuous (psi3 u) := by
  refine Continuous.sub ?_ ?_
  · exact continuous_const.mul Real.continuous_sin
  · exact continuous_const.mul Real.continuous_cos

theorem abs_psi_le (u : Pl) (φ : ℝ) :
    |psi1 u φ| ≤ 2 * ‖u‖ ∧ |psi2 u φ| ≤ 2 * ‖u‖ ∧ |psi3 u φ| ≤ 2 * ‖u‖ := by
  have h0 : |u 0| ≤ ‖u‖ := Auto.CalderonVaillancourt.abs_apply_le_norm u 0
  have h1 : |u 1| ≤ ‖u‖ := Auto.CalderonVaillancourt.abs_apply_le_norm u 1
  have hs : |Real.sin φ| ≤ 1 := Real.abs_sin_le_one φ
  have hc : |Real.cos φ| ≤ 1 := Real.abs_cos_le_one φ
  have hb0 : |u 0 * Real.cos φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 0| * |Real.cos φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h0 hc (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb1 : |u 1 * Real.sin φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 1| * |Real.sin φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h1 hs (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb0s : |u 0 * Real.sin φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 0| * |Real.sin φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h0 hs (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb1c : |u 1 * Real.cos φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 1| * |Real.cos φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h1 hc (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  refine ⟨?_, ?_, ?_⟩
  · rw [psi1]
    have h : |-(u 0) * Real.sin φ + u 1 * Real.cos φ|
        ≤ |-(u 0) * Real.sin φ| + |u 1 * Real.cos φ| := abs_add_le _ _
    have he : |-(u 0) * Real.sin φ| = |u 0 * Real.sin φ| := by
      rw [neg_mul, abs_neg]
    linarith [h, he ▸ hb0s]
  · rw [psi2, abs_neg]
    have h : |u 0 * Real.cos φ + u 1 * Real.sin φ|
        ≤ |u 0 * Real.cos φ| + |u 1 * Real.sin φ| := abs_add_le _ _
    linarith
  · rw [psi3]
    have h : |u 0 * Real.sin φ - u 1 * Real.cos φ|
        ≤ |u 0 * Real.sin φ| + |u 1 * Real.cos φ| := abs_sub _ _
    linarith

/-! #### The plate cutoffs -/

/-- The telescoping angular cutoff: `1` when `2^M φ ≥ ν + 1`, `0` when `2^M φ ≤ ν`. -/
def plateT (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))

/-- The plate cutoff at angular scale `2^{-M}`, supported in `[ν 2^{-M}, (ν+2) 2^{-M}]`. -/
def plateC (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ := plateT M ν φ - plateT M (ν + 1) φ

/-- The first derivative of the plate cutoff. -/
def plateC1 (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  (2 : ℝ) ^ M * (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
    - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))

/-- The second derivative of the plate cutoff. -/
def plateC2 (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  (2 : ℝ) ^ M * (2 : ℝ) ^ M
    * (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))

theorem hasDerivAt_plateT (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateT M ν)
      ((2 : ℝ) ^ M * deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))) φ := by
  have hinner : HasDerivAt (fun x : ℝ => (2 : ℝ) ^ M * x - (ν : ℝ)) ((2 : ℝ) ^ M) φ := by
    have h := (hasDerivAt_id φ).const_mul ((2 : ℝ) ^ M)
    simpa using h.sub_const ((ν : ℝ))
  have hst : HasDerivAt Real.smoothTransition
      (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
      ((2 : ℝ) ^ M * φ - (ν : ℝ)) :=
    (contDiff_st.differentiable (by simp) _).hasDerivAt
  have h := hst.comp φ hinner
  refine h.congr_deriv ?_
  ring

theorem hasDerivAt_plateC (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateC M ν) (plateC1 M ν φ) φ := by
  have h1 := hasDerivAt_plateT M ν φ
  have h2 := hasDerivAt_plateT M (ν + 1) φ
  have h := h1.sub h2
  refine h.congr_deriv ?_
  rw [plateC1]
  push_cast
  ring

theorem hasDerivAt_plateC1 (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateC1 M ν) (plateC2 M ν φ) φ := by
  have hd : ∀ c : ℝ, HasDerivAt (fun x : ℝ => deriv Real.smoothTransition ((2 : ℝ) ^ M * x - c))
      ((2 : ℝ) ^ M * deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - c)) φ := by
    intro c
    have hinner : HasDerivAt (fun x : ℝ => (2 : ℝ) ^ M * x - c) ((2 : ℝ) ^ M) φ := by
      have h := (hasDerivAt_id φ).const_mul ((2 : ℝ) ^ M)
      simpa using h.sub_const c
    have hst : HasDerivAt (deriv Real.smoothTransition)
        (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - c))
        ((2 : ℝ) ^ M * φ - c) :=
      (contDiff_deriv_st.differentiable (by simp) _).hasDerivAt
    have h := hst.comp φ hinner
    refine h.congr_deriv ?_
    ring
  have h := ((hd ((ν : ℝ))).sub (hd ((ν : ℝ) + 1))).const_mul ((2 : ℝ) ^ M)
  refine h.congr_deriv ?_
  rw [plateC2]
  ring

theorem continuous_plateC1 (M : ℕ) (ν : ℤ) : Continuous (plateC1 M ν) := by
  refine continuous_const.mul (Continuous.sub ?_ ?_)
  · exact contDiff_deriv_st.continuous.comp ((continuous_const.mul continuous_id).sub
      continuous_const)
  · exact contDiff_deriv_st.continuous.comp ((continuous_const.mul continuous_id).sub
      continuous_const)

theorem continuous_plateC2 (M : ℕ) (ν : ℤ) : Continuous (plateC2 M ν) := by
  have hc : Continuous (deriv (deriv Real.smoothTransition)) := by
    have h : ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (deriv Real.smoothTransition)) := by
      have h2 : ContDiff ℝ ((↑(⊤ : ℕ∞)) + 1) (deriv Real.smoothTransition) := by
        simpa using contDiff_deriv_st
      exact (contDiff_succ_iff_deriv.mp h2).2.2
    exact h.continuous
  refine continuous_const.mul (Continuous.sub ?_ ?_)
  · exact hc.comp ((continuous_const.mul continuous_id).sub continuous_const)
  · exact hc.comp ((continuous_const.mul continuous_id).sub continuous_const)

theorem continuous_plateC (M : ℕ) (ν : ℤ) : Continuous (plateC M ν) :=
  continuous_iff_continuousAt.mpr fun φ => (hasDerivAt_plateC M ν φ).continuousAt

theorem plateC_nonneg (M : ℕ) (ν : ℤ) (φ : ℝ) : 0 ≤ plateC M ν φ := by
  rw [plateC, plateT, plateT, sub_nonneg]
  refine Real.smoothTransition.monotone ?_
  push_cast
  linarith

theorem plateC_le_one (M : ℕ) (ν : ℤ) (φ : ℝ) : plateC M ν φ ≤ 1 := by
  rw [plateC]
  have h1 : plateT M ν φ ≤ 1 := Real.smoothTransition.le_one _
  have h2 : (0 : ℝ) ≤ plateT M (ν + 1) φ := Real.smoothTransition.nonneg _
  linarith

theorem abs_plateC_le_one (M : ℕ) (ν : ℤ) (φ : ℝ) : |plateC M ν φ| ≤ 1 := by
  rw [abs_of_nonneg (plateC_nonneg M ν φ)]
  exact plateC_le_one M ν φ

/-- Outside its plate, on the left, the cutoff and its first two derivatives vanish. -/
theorem plateC_eq_zero_of_nonpos {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : (2 : ℝ) ^ M * φ - (ν : ℝ) ≤ 0) :
    plateC M ν φ = 0 ∧ plateC1 M ν φ = 0 ∧ plateC2 M ν φ = 0 := by
  have h2 : (2 : ℝ) ^ M * φ - ((ν : ℝ) + 1) ≤ 0 := by linarith
  have hz1 : plateT M ν φ = 0 := Real.smoothTransition.zero_of_nonpos h
  have hz2 : plateT M (ν + 1) φ = 0 := by
    rw [plateT]
    refine Real.smoothTransition.zero_of_nonpos ?_
    push_cast
    linarith
  refine ⟨by rw [plateC, hz1, hz2, sub_zero], ?_, ?_⟩
  · rw [plateC1, deriv_st_eq_zero_of_nonpos h, deriv_st_eq_zero_of_nonpos h2]
    ring
  · rw [plateC2, deriv2_st_eq_zero_of_nonpos h, deriv2_st_eq_zero_of_nonpos h2]
    ring

/-- Outside its plate, on the right, the cutoff and its first two derivatives vanish. -/
theorem plateC_eq_zero_of_two_le {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : 2 ≤ (2 : ℝ) ^ M * φ - (ν : ℝ)) :
    plateC M ν φ = 0 ∧ plateC1 M ν φ = 0 ∧ plateC2 M ν φ = 0 := by
  have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ M * φ - (ν : ℝ) := by linarith
  have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ M * φ - ((ν : ℝ) + 1) := by linarith
  have hz1 : plateT M ν φ = 1 := Real.smoothTransition.one_of_one_le h1
  have hz2 : plateT M (ν + 1) φ = 1 := by
    rw [plateT]
    refine Real.smoothTransition.one_of_one_le ?_
    push_cast
    linarith
  refine ⟨by rw [plateC, hz1, hz2, sub_self], ?_, ?_⟩
  · rw [plateC1, deriv_st_eq_zero_of_one_le h1, deriv_st_eq_zero_of_one_le h2]
    ring
  · rw [plateC2, deriv2_st_eq_zero_of_one_le h1, deriv2_st_eq_zero_of_one_le h2]
    ring

/-- The derivatives of the plate cutoff are bounded by the natural powers of `2^M`. -/
theorem abs_plateC_deriv_le (M : ℕ) (ν : ℤ) (φ : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ |plateC1 M ν φ| ≤ 2 * C * (2 : ℝ) ^ M
      ∧ |plateC2 M ν φ| ≤ 2 * C * ((2 : ℝ) ^ M) ^ 2 := by
  obtain ⟨C, hC1, hCd, hCd2⟩ := exists_st_deriv2_bound
  refine ⟨C, hC1, ?_, ?_⟩
  · rw [plateC1, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ (2 : ℝ) ^ M)]
    have hsub : |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * C := by
      have ha := hCd ((2 : ℝ) ^ M * φ - (ν : ℝ))
      have hb := hCd ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
      have h := abs_sub (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
        (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
      linarith
    calc (2 : ℝ) ^ M * |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
          - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
        ≤ (2 : ℝ) ^ M * (2 * C) := mul_le_mul_of_nonneg_left hsub (by positivity)
      _ = 2 * C * (2 : ℝ) ^ M := by ring
  · rw [plateC2, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M)]
    have hsub : |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * C := by
      have ha := hCd2 ((2 : ℝ) ^ M * φ - (ν : ℝ))
      have hb := hCd2 ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
      have h := abs_sub (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ)))
        (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
      linarith
    calc (2 : ℝ) ^ M * (2 : ℝ) ^ M
          * |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
            - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
        ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M * (2 * C) := mul_le_mul_of_nonneg_left hsub (by positivity)
      _ = 2 * C * ((2 : ℝ) ^ M) ^ 2 := by ring

/-- The plate cutoffs telescope. -/
theorem sum_plateC (M : ℕ) (a b : ℤ) (hab : a ≤ b) (φ : ℝ) :
    ∑ ν ∈ Finset.Icc a b, plateC M ν φ = plateT M a φ - plateT M (b + 1) φ := by
  classical
  induction b, hab using Int.le_induction with
  | base =>
    simp [plateC]
  | succ n hn ih =>
    have hnot : (n + 1) ∉ Finset.Icc a n := by
      simp [Finset.mem_Icc]
    have hins : Finset.Icc a (n + 1) = insert (n + 1) (Finset.Icc a n) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    rw [hins, Finset.sum_insert hnot, ih, plateC]
    ring

end AngularPhase


/-! ### Localized integration by parts -/

section IbpLocal

/-- One integration by parts, with the hypotheses on the phase and the amplitudes needed only on
the interval of integration. -/
theorem integral_osc_ibp_on {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτc : Continuous τ)
    (hne : ∀ x ∈ Set.Icc a b, τ' x ≠ 0)
    (hAc : ContinuousOn A (Set.Icc a b)) (hBc : ContinuousOn Bn (Set.Icc a b))
    (hAB : ∀ x ∈ Set.Icc a b, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hAa : A a = 0) (hAb : A b = 0) :
    (∫ x in a..b, osc lam (τ x) * A x)
      = -(1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, osc lam (τ x) * Bn x := by
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  set u : ℝ → ℂ := fun y => (A y / ((τ' y : ℝ) : ℂ)) / (((lam : ℝ) : ℂ) * Complex.I) with hu
  set v : ℝ → ℂ := fun y => osc lam (τ y) with hv
  have hvc : Continuous v := continuous_osc_comp hτc
  have hud : ∀ x ∈ Set.Icc a b, HasDerivAt u (Bn x / (((lam : ℝ) : ℂ) * Complex.I)) x :=
    fun x hx => (hAB x hx).div_const _
  have hvd : ∀ x, HasDerivAt v (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I)) x := fun x =>
    hasDerivAt_osc (hτ x)
  have hkey : ∀ x ∈ Set.Icc a b, HasDerivAt (fun y => u y * v y)
      (v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) x := by
    intro x hx
    have h := (hud x hx).mul (hvd x)
    have hlamC' : ((lam : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hlam
    have heq : Bn x / (((lam : ℝ) : ℂ) * Complex.I) * v x +
        u x * (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I))
        = v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      have hτ'C : ((τ' x : ℝ) : ℂ) ≠ 0 := by
        exact_mod_cast hne x hx
      rw [hu]
      push_cast
      field_simp
      ring
    rw [heq] at h
    exact h
  have hbdry : u b * v b - u a * v a = 0 := by
    simp [hu, hAa, hAb]
  have hintg : IntervalIntegrable
      (fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul (hAc.add (hBc.div_const _))
  have hzero : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) = 0 := by
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun y => u y * v y)
      (f' := fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      (fun x hx => hkey x (by rw [huIcc] at hx; exact hx)) hintg
    rw [h, hbdry]
  have h1 : IntervalIntegrable (fun x => v x * A x) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul hAc
  have h2 : IntervalIntegrable (fun x => v x * Bn x) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul hBc
  have hsplit : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      = (∫ x in a..b, v x * A x) +
        (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_add h1 (h2.const_mul _)]
    refine intervalIntegral.integral_congr fun x _ => ?_
    field_simp
  rw [hsplit] at hzero
  have hres : (∫ x in a..b, v x * A x)
      = -((1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x) := by
    linear_combination hzero
  rw [hres]
  ring

/-- **Two integrations by parts, localized.**  All hypotheses on the phase and on the amplitude
are needed only on the interval of integration; the amplitude and its first derivative vanish at
the endpoints. -/
theorem norm_integral_osc_ibp2_bound_on {a b lam mu M0 M1 M2 T2 T3 : ℝ}
    (hab : a ≤ b) (hlam : lam ≠ 0) (hmu : 0 < mu)
    {τ τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ1 x) x) (hτ1 : ∀ x, HasDerivAt τ1 (τ2 x) x)
    (hτ2 : ∀ x, HasDerivAt τ2 (τ3 x) x)
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2c : Continuous A2)
    (hlow : ∀ x ∈ Set.Icc a b, mu ≤ |τ1 x|)
    (hM0 : ∀ x ∈ Set.Icc a b, ‖A x‖ ≤ M0) (hM1 : ∀ x ∈ Set.Icc a b, ‖A1 x‖ ≤ M1)
    (hM2 : ∀ x ∈ Set.Icc a b, ‖A2 x‖ ≤ M2)
    (hT2 : ∀ x ∈ Set.Icc a b, |τ2 x| ≤ T2) (hT3 : ∀ x ∈ Set.Icc a b, |τ3 x| ≤ T3)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (b - a) * (lam ^ 2)⁻¹
        * (M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
            + 3 * M0 * T2 ^ 2 / mu ^ 4) := by
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hne : ∀ x ∈ Set.Icc a b, τ1 x ≠ 0 := by
    intro x hx h0
    have h := hlow x hx
    rw [h0] at h
    simp at h
    linarith
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hτc : Continuous τ := continuous_iff_continuousAt.mpr fun x => (hτ x).continuousAt
  have hτ1CC : ContinuousOn (fun x : ℝ => ((τ1 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ1c).continuousOn
  have hτ2CC : ContinuousOn (fun x : ℝ => ((τ2 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ2c).continuousOn
  have hτ3CC : ContinuousOn (fun x : ℝ => ((τ3 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ3c).continuousOn
  have hneC : ∀ x ∈ Set.Icc a b, ((τ1 x : ℝ) : ℂ) ≠ 0 := by
    intro x hx
    exact_mod_cast hne x hx
  have hpow : ∀ (n : ℕ), ∀ x ∈ Set.Icc a b, ((τ1 x : ℝ) : ℂ) ^ n ≠ 0 :=
    fun n x hx => pow_ne_zero _ (hneC x hx)
  have hBcOn : ContinuousOn (chainB τ1 τ2 A A1) (Set.Icc a b) := by
    refine ContinuousOn.sub (hA1c.continuousOn.div hτ1CC hneC) ?_
    exact (hAc.continuousOn.mul hτ2CC).div (hτ1CC.pow 2) (hpow 2)
  have hCcOn : ContinuousOn (chainC τ1 τ2 τ3 A A1 A2) (Set.Icc a b) := by
    refine ContinuousOn.add (ContinuousOn.sub (ContinuousOn.sub
      (hA2c.continuousOn.div (hτ1CC.pow 2) (hpow 2)) ?_) ?_) ?_
    · exact ((continuousOn_const.mul hA1c.continuousOn).mul hτ2CC).div (hτ1CC.pow 3) (hpow 3)
    · exact (hAc.continuousOn.mul hτ3CC).div (hτ1CC.pow 3) (hpow 3)
    · exact ((continuousOn_const.mul hAc.continuousOn).mul (hτ2CC.pow 2)).div
        (hτ1CC.pow 4) (hpow 4)
  have hBa : chainB τ1 τ2 A A1 a = 0 := by
    rw [chainB, hAa, h1a]
    simp
  have hBb : chainB τ1 τ2 A A1 b = 0 := by
    rw [chainB, hAb, h1b]
    simp
  have hstep1 := integral_osc_ibp_on hab hlam hτ hτc hne hAc.continuousOn hBcOn
    (fun x hx => hasDerivAt_chain_first (hτ1 x) (hA x) (hne x hx)) hAa hAb
  have hstep2 := integral_osc_ibp_on hab hlam hτ hτc hne hBcOn hCcOn
    (fun x hx => hasDerivAt_chainB_div (hτ1 x) (hτ2 x) (hA x) (hA1 x) (hne x hx)) hBa hBb
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hchain : ‖∫ x in a..b, osc lam (τ x) * A x‖
      = |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖) := by
    rw [hstep1, norm_mul, norm_neg, hnormlam, hstep2, norm_mul, norm_neg, hnormlam]
  -- bound the last integral
  have hCint : IntervalIntegrable (fun x => ‖chainC τ1 τ2 τ3 A A1 A2 x‖) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact hCcOn.norm
  have hbd : ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ ∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖ := by
    have h := intervalIntegral.norm_integral_le_abs_integral_norm
      (f := fun x => osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x) (a := a) (b := b) (μ := volume)
    refine le_trans h (le_of_eq ?_)
    rw [abs_of_nonneg]
    · refine intervalIntegral.integral_congr fun x _ => ?_
      rw [norm_mul, norm_osc, one_mul]
    · refine intervalIntegral.integral_nonneg hab fun x _ => ?_
      exact norm_nonneg _
  set K : ℝ := M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
    + 3 * M0 * T2 ^ 2 / mu ^ 4 with hK
  have hKint : (∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖) ≤ (b - a) * K := by
    have hmono := intervalIntegral.integral_mono_on hab hCint
      (intervalIntegrable_const (c := K))
      (fun x hx => norm_chainC_le hmu (hlow x hx) (hM0 x hx) (hM1 x hx) (hM2 x hx)
        (hT2 x hx) (hT3 x hx))
    rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
    exact hmono
  rw [hchain]
  have hlamnn : (0 : ℝ) ≤ |lam|⁻¹ := by positivity
  have hstep : |lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ |lam|⁻¹ * ((b - a) * K) :=
    mul_le_mul_of_nonneg_left (le_trans hbd hKint) hlamnn
  have hfin : |lam|⁻¹ * (|lam|⁻¹ * ((b - a) * K)) = (b - a) * (lam ^ 2)⁻¹ * K := by
    have h : |lam| * |lam| = lam ^ 2 := by
      rw [← abs_mul, ← pow_two, abs_of_nonneg (sq_nonneg lam)]
    field_simp
    rw [← h]
    ring
  calc |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖)
      ≤ |lam|⁻¹ * (|lam|⁻¹ * ((b - a) * K)) := mul_le_mul_of_nonneg_left hstep hlamnn
    _ = (b - a) * (lam ^ 2)⁻¹ * K := hfin

end IbpLocal


/-! ### The angular amplitude on a plate -/

section AngularAmp

/-- A fixed constant bounding the first two derivatives of `Real.smoothTransition`. -/
noncomputable def stC : ℝ := Classical.choose exists_st_deriv2_bound

theorem one_le_stC : 1 ≤ stC := (Classical.choose_spec exists_st_deriv2_bound).1

theorem abs_deriv_st_le (x : ℝ) : |deriv Real.smoothTransition x| ≤ stC :=
  (Classical.choose_spec exists_st_deriv2_bound).2.1 x

theorem abs_deriv2_st_le (x : ℝ) : |deriv (deriv Real.smoothTransition) x| ≤ stC :=
  (Classical.choose_spec exists_st_deriv2_bound).2.2 x

theorem stC_nonneg : (0 : ℝ) ≤ stC := le_trans zero_le_one one_le_stC

attribute [irreducible] stC

theorem abs_plateC1_le (M : ℕ) (ν : ℤ) (φ : ℝ) : |plateC1 M ν φ| ≤ 2 * stC * (2 : ℝ) ^ M := by
  rw [plateC1, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ M)]
  have ha := abs_deriv_st_le ((2 : ℝ) ^ M * φ - (ν : ℝ))
  have hb := abs_deriv_st_le ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
  have h := abs_sub (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
    (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
  have hsub : |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * stC := by
    linarith
  calc (2 : ℝ) ^ M * |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
      ≤ (2 : ℝ) ^ M * (2 * stC) := mul_le_mul_of_nonneg_left hsub (by positivity)
    _ = 2 * stC * (2 : ℝ) ^ M := by ring

theorem abs_plateC2_le (M : ℕ) (ν : ℤ) (φ : ℝ) :
    |plateC2 M ν φ| ≤ 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by
  rw [plateC2, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M)]
  have ha := abs_deriv2_st_le ((2 : ℝ) ^ M * φ - (ν : ℝ))
  have hb := abs_deriv2_st_le ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
  have h := abs_sub (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ)))
    (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
  have hsub : |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * stC := by
    linarith
  calc (2 : ℝ) ^ M * (2 : ℝ) ^ M
        * |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
          - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
      ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M * (2 * stC) :=
        mul_le_mul_of_nonneg_left hsub (by positivity)
    _ = 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by ring

/-- The amplitude of the angular oscillatory integral on the plate `ν`. -/
def angAmp (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 0 t r φ * ((plateC M ν φ : ℝ) : ℂ))

/-- Its first angular derivative. -/
def angAmp1 (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
    + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ))

/-- Its second angular derivative. -/
def angAmp2 (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
    + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
    + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ))

theorem hasDerivAt_angAmp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) :
    HasDerivAt (angAmp ma M ν t r) (angAmp1 ma M ν t r φ) φ := by
  have hc : HasDerivAt (fun x : ℝ => ((plateC M ν x : ℝ) : ℂ))
      (((plateC1 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC M ν φ).ofReal_comp
  have h := ((hp.ad 0 (by norm_num) t r φ).mul hc).const_mul ((r : ℂ))
  refine h.congr_deriv ?_
  rw [angAmp1]

theorem hasDerivAt_angAmp1 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) :
    HasDerivAt (angAmp1 ma M ν t r) (angAmp2 ma M ν t r φ) φ := by
  have hc : HasDerivAt (fun x : ℝ => ((plateC M ν x : ℝ) : ℂ))
      (((plateC1 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC M ν φ).ofReal_comp
  have hc1 : HasDerivAt (fun x : ℝ => ((plateC1 M ν x : ℝ) : ℂ))
      (((plateC2 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC1 M ν φ).ofReal_comp
  have h := (((hp.ad 1 (by norm_num) t r φ).mul hc).add
    ((hp.ad 0 (by norm_num) t r φ).mul hc1)).const_mul ((r : ℂ))
  refine h.congr_deriv ?_
  rw [angAmp2]
  ring

theorem continuous_angAmp2 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r : ℝ) :
    Continuous (angAmp2 ma M ν t r) := by
  have hc : Continuous fun x : ℝ => ((plateC M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC M ν)
  have hc1 : Continuous fun x : ℝ => ((plateC1 M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC1 M ν)
  have hc2 : Continuous fun x : ℝ => ((plateC2 M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC2 M ν)
  refine continuous_const.mul (Continuous.add (Continuous.add ?_ ?_) ?_)
  · exact (hp.ac 2 (by norm_num) t r).mul hc
  · exact (continuous_const.mul (hp.ac 1 (by norm_num) t r)).mul hc1
  · exact (hp.ac 0 (by norm_num) t r).mul hc2

/-- The size of the angular amplitude and of its first two derivatives. -/
theorem norm_angAmp_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) (hr : 0 < r) :
    ‖angAmp ma M ν t r φ‖ ≤ r * B0
      ∧ ‖angAmp1 ma M ν t r φ‖ ≤ 3 * stC * (2 : ℝ) ^ M * (r * B0)
      ∧ ‖angAmp2 ma M ν t r φ‖ ≤ 7 * stC * ((2 : ℝ) ^ M) ^ 2 * (r * B0) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hP : (1 : ℝ) ≤ (2 : ℝ) ^ M := one_le_pow₀ (by norm_num)
  have hrn : ‖(r : ℂ)‖ = r := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  have hc0 : ‖((plateC M ν φ : ℝ) : ℂ)‖ ≤ 1 := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC_le_one M ν φ
  have hc1 : ‖((plateC1 M ν φ : ℝ) : ℂ)‖ ≤ 2 * stC * (2 : ℝ) ^ M := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC1_le M ν φ
  have hc2 : ‖((plateC2 M ν φ : ℝ) : ℂ)‖ ≤ 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC2_le M ν φ
  have hm0 : ‖ma 0 t r φ‖ ≤ B0 := hp.ab 0 (by norm_num) t r φ
  have hm1 : ‖ma 1 t r φ‖ ≤ B0 := hp.ab 1 (by norm_num) t r φ
  have hm2 : ‖ma 2 t r φ‖ ≤ B0 := hp.ab 2 (by norm_num) t r φ
  have hprod : ∀ (z w : ℂ) (X Y : ℝ), ‖z‖ ≤ X → ‖w‖ ≤ Y → 0 ≤ Y → ‖z * w‖ ≤ X * Y := by
    intro z w X Y hz hw hY
    rw [norm_mul]
    exact mul_le_mul hz hw (norm_nonneg _) (le_trans (norm_nonneg _) hz)
  refine ⟨?_, ?_, ?_⟩
  · rw [angAmp, norm_mul, hrn]
    have h := hprod (ma 0 t r φ) (((plateC M ν φ : ℝ) : ℂ)) B0 1 hm0 hc0 zero_le_one
    rw [mul_one] at h
    exact mul_le_mul_of_nonneg_left h (le_of_lt hr)
  · rw [angAmp1, norm_mul, hrn]
    have hA : ‖ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
        + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)‖
        ≤ B0 * 1 + B0 * (2 * stC * (2 : ℝ) ^ M) := by
      refine le_trans (norm_add_le _ _) (add_le_add ?_ ?_)
      · exact hprod _ _ _ _ hm1 hc0 zero_le_one
      · exact hprod _ _ _ _ hm0 hc1 (by positivity)
    have hstep : B0 * 1 + B0 * (2 * stC * (2 : ℝ) ^ M) ≤ 3 * stC * (2 : ℝ) ^ M * B0 := by
      nlinarith [hB0, hstC, hP, mul_le_mul_of_nonneg_left hP (le_of_lt (lt_of_lt_of_le zero_lt_one hstC))]
    calc r * ‖ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
          + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)‖
        ≤ r * (3 * stC * (2 : ℝ) ^ M * B0) :=
          mul_le_mul_of_nonneg_left (le_trans hA hstep) (le_of_lt hr)
      _ = 3 * stC * (2 : ℝ) ^ M * (r * B0) := by ring
  · rw [angAmp2, norm_mul, hrn]
    have hA : ‖ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
        + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
        + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ)‖
        ≤ (B0 * 1 + 2 * B0 * (2 * stC * (2 : ℝ) ^ M))
          + B0 * (2 * stC * ((2 : ℝ) ^ M) ^ 2) := by
      refine le_trans (norm_add_le _ _) (add_le_add (le_trans (norm_add_le _ _)
        (add_le_add ?_ ?_)) ?_)
      · exact hprod _ _ _ _ hm2 hc0 zero_le_one
      · have h2 : ‖(2 : ℂ) * ma 1 t r φ‖ ≤ 2 * B0 := by
          rw [norm_mul]
          have : ‖(2 : ℂ)‖ = 2 := by norm_num
          rw [this]
          exact mul_le_mul_of_nonneg_left hm1 (by norm_num)
        exact hprod _ _ _ _ h2 hc1 (by positivity)
      · exact hprod _ _ _ _ hm0 hc2 (by positivity)
    have hstep : (B0 * 1 + 2 * B0 * (2 * stC * (2 : ℝ) ^ M))
        + B0 * (2 * stC * ((2 : ℝ) ^ M) ^ 2) ≤ 7 * stC * ((2 : ℝ) ^ M) ^ 2 * B0 := by
      have hPP : (2 : ℝ) ^ M ≤ ((2 : ℝ) ^ M) ^ 2 := by
        nlinarith [hP]
      have h1 : (1 : ℝ) ≤ stC * ((2 : ℝ) ^ M) ^ 2 := by
        nlinarith [hP, hstC]
      nlinarith [hB0, hstC, hP, hPP, h1,
        mul_le_mul_of_nonneg_left hPP (le_of_lt (lt_of_lt_of_le zero_lt_one hstC))]
    calc r * ‖ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
          + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
          + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ)‖
        ≤ r * (7 * stC * ((2 : ℝ) ^ M) ^ 2 * B0) :=
          mul_le_mul_of_nonneg_left (le_trans hA hstep) (le_of_lt hr)
      _ = 7 * stC * ((2 : ℝ) ^ M) ^ 2 * (r * B0) := by ring

/-- The angular amplitude and its derivative vanish at both ends of the plate. -/
theorem angAmp_zero_ends {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r : ℝ) :
    angAmp ma M ν t r ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp1 ma M ν t r ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp ma M ν t r (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp1 ma M ν t r (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = 0 := by
  have hPQ : (2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ)) = 1 := by
    rw [show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by
      rw [zpow_natCast]]
    rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hleft : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) - (ν : ℝ) ≤ 0 := by
    have h : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) := by
      calc (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * (ν : ℝ) := by ring
        _ = (ν : ℝ) := by rw [hPQ, one_mul]
    rw [h]
    linarith
  have hright : 2 ≤ (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) - (ν : ℝ) := by
    have h : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) + 2 := by
      calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * ((ν : ℝ) + 2) := by ring
        _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
    rw [h]
    linarith
  obtain ⟨hz0, hz1, -⟩ := plateC_eq_zero_of_nonpos hleft
  obtain ⟨hw0, hw1, -⟩ := plateC_eq_zero_of_two_le hright
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [angAmp, hz0]
    simp
  · rw [angAmp1, hz0, hz1]
    simp
  · rw [angAmp, hw0]
    simp
  · rw [angAmp1, hw0, hw1]
    simp

end AngularAmp


/-! ### The angular estimate on a plate -/

section AngularPlate

theorem inv_two_pi_sq_le : ((2 * π) ^ 2)⁻¹ ≤ 1 / 16 := by
  have h4 : (4 : ℝ) ≤ 2 * π := by linarith [Real.two_le_pi]
  have h16 : (16 : ℝ) ≤ (2 * π) ^ 2 := by nlinarith [h4]
  rw [inv_eq_one_div, div_le_div_iff₀ (by positivity) (by norm_num)]
  linarith

set_option maxHeartbeats 1000000 in
/-- **The angular estimate.**  On a plate of angular length `2·2^{-M}` on which the angular
derivative of the phase coefficient is at least `mu0 ≥ 2^{-M}`, while its second and third
derivatives are `O(1 + mu0)` and `O(mu0)`, two integrations by parts give `2^M/(r·mu0²)`. -/
theorem norm_angular_plate_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (u : Pl) (ε t : ℝ) (M : ℕ) (ν : ℤ)
    {mu0 r : ℝ} (hmu0 : 0 < mu0) (hmuM : (2 : ℝ) ^ (-(M : ℤ)) ≤ mu0) (hr : 0 < r)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu0 ≤ |psi1 u φ|)
    (h2 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi2 u φ| ≤ 3 + 24 * mu0)
    (h3 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi3 u φ| ≤ 8 * mu0) :
    ‖∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
        osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ‖
      ≤ 400 * stC * B0 * (2 : ℝ) ^ M / (r * mu0 ^ 2) := by
  set P : ℝ := (2 : ℝ) ^ M with hP
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hPpos : (0 : ℝ) < P := by rw [hP]; positivity
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hP1 : (1 : ℝ) ≤ P := by
    rw [hP]
    exact one_le_pow₀ (by norm_num)
  have hPQ : P * Q = 1 := by
    rw [hP, hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hPmu : (1 : ℝ) ≤ P * mu0 := by
    have h := mul_le_mul_of_nonneg_left hmuM (le_of_lt hPpos)
    rw [hPQ] at h
    exact h
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  set a : ℝ := (ν : ℝ) * Q with ha
  set b : ℝ := ((ν : ℝ) + 2) * Q with hb
  have hab : a ≤ b := by
    rw [ha, hb]
    exact mul_le_mul_of_nonneg_right (by linarith : (ν : ℝ) ≤ (ν : ℝ) + 2) (le_of_lt hQpos)
  have hba : b - a = 2 * Q := by
    rw [ha, hb]
    ring
  have hτ : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psiu u ε t x) (r * psi1 u φ) φ :=
    fun φ => (hasDerivAt_psiu u ε t φ).const_mul r
  have hτ1 : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psi1 u x) (r * psi2 u φ) φ :=
    fun φ => (hasDerivAt_psi1 u φ).const_mul r
  have hτ2 : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psi2 u x) (r * psi3 u φ) φ :=
    fun φ => (hasDerivAt_psi2 u φ).const_mul r
  have hτ1c : Continuous fun x : ℝ => r * psi1 u x := continuous_const.mul (continuous_psi1 u)
  have hτ2c : Continuous fun x : ℝ => r * psi2 u x := continuous_const.mul (continuous_psi2 u)
  have hτ3c : Continuous fun x : ℝ => r * psi3 u x := continuous_const.mul (continuous_psi3 u)
  have hlowr : ∀ φ ∈ Set.Icc a b, r * mu0 ≤ |r * psi1 u φ| := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (hlow φ hφ) (le_of_lt hr)
  have hc2 : (3 : ℝ) + 24 * mu0 ≤ 27 * (mu0 * P) := by
    have h1 : (1 : ℝ) ≤ mu0 * P := by
      rw [mul_comm]
      exact hPmu
    have h2' : mu0 ≤ mu0 * P := by nlinarith [hmu0, hP1]
    linarith
  have hT2 : ∀ φ ∈ Set.Icc a b, |r * psi2 u φ| ≤ r * (27 * (mu0 * P)) := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (le_trans (h2 φ hφ) hc2) (le_of_lt hr)
  have hT3 : ∀ φ ∈ Set.Icc a b, |r * psi3 u φ| ≤ r * (8 * mu0) := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (h3 φ hφ) (le_of_lt hr)
  obtain ⟨hv0, hv1, hw0, hw1⟩ := angAmp_zero_ends hp M ν t r
  have hlam : (2 * π : ℝ) ≠ 0 := by
    have := Real.pi_pos
    positivity
  have hibp := norm_integral_osc_ibp2_bound_on (a := a) (b := b) (lam := 2 * π)
    (mu := r * mu0) (M0 := r * B0) (M1 := 3 * stC * P * (r * B0))
    (M2 := 7 * stC * P ^ 2 * (r * B0)) (T2 := r * (27 * (mu0 * P))) (T3 := r * (8 * mu0))
    hab hlam (by positivity) hτ hτ1 hτ2 hτ1c hτ2c hτ3c
    (hasDerivAt_angAmp hp M ν t r) (hasDerivAt_angAmp1 hp M ν t r)
    (continuous_angAmp2 hp M ν t r) hlowr
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).1)
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).2.1)
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).2.2)
    hT2 hT3 hv0 hw0 hv1 hw1
  refine le_trans hibp ?_
  have hden : (0 : ℝ) < r * mu0 ^ 2 := by positivity
  -- each of the four terms is an exact multiple of `stC P² B₀ /(r mu0²)`
  have e1 : 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
      = 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
  have e2 : 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
      = 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
    ring
  have e3 : r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3 = 8 * B0 / (r * mu0 ^ 2) := by
    field_simp
  have e4 : 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4
      = 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
    ring
  have g3 : 8 * B0 / (r * mu0 ^ 2) ≤ 8 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    refine div_le_div_of_nonneg_right ?_ hden.le
    have h1 : (1 : ℝ) ≤ stC * P ^ 2 := by nlinarith [hstC, hP1]
    nlinarith [h1, hB0]
  have g4 : 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2)
      ≤ 2187 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    refine div_le_div_of_nonneg_right ?_ hden.le
    nlinarith [hstC, hB0, sq_nonneg P, mul_nonneg hB0 (sq_nonneg P)]
  have hbrnn : (0 : ℝ) ≤ 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
        + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
        + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
        + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4 := by
    rw [e1, e2, e3, e4]
    have hfacnn : (0 : ℝ) ≤ stC * P ^ 2 * B0 :=
      mul_nonneg (mul_nonneg hstCnn (sq_nonneg P)) hB0
    have h1 : (0 : ℝ) ≤ 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by linarith) hden.le
    have h2' : (0 : ℝ) ≤ 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by linarith) hden.le
    have h3' : (0 : ℝ) ≤ 8 * B0 / (r * mu0 ^ 2) := div_nonneg (by linarith) hden.le
    have h4 : (0 : ℝ) ≤ 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by nlinarith [sq_nonneg P, hB0]) hden.le
    linarith
  have hbracket : 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
        + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
        + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
        + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4
      ≤ 2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    rw [e1, e2, e3, e4]
    have hsum : 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 8 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 2187 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        = 2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
      simp only [div_eq_mul_inv]
      ring
    linarith [g3, g4]
  have hpi : ((2 * π) ^ 2)⁻¹ ≤ 1 / 16 := inv_two_pi_sq_le
  have hstepf : (b - a) * ((2 * π) ^ 2)⁻¹
        * (7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
          + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
          + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
          + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4)
      ≤ 2 * Q * (1 / 16) * (2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)) := by
    rw [hba]
    refine mul_le_mul (mul_le_mul_of_nonneg_left hpi (by positivity)) hbracket hbrnn ?_
    positivity
  refine le_trans hstepf ?_
  have hQP2 : Q * P ^ 2 = P := by
    have h : Q * P ^ 2 = (P * Q) * P := by ring
    rw [h, hPQ, one_mul]
  have hL : 2 * Q * (1 / 16) * (2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2))
      = 2445 / 8 * (Q * P ^ 2) * (stC * B0) / (r * mu0 ^ 2) := by
    simp only [div_eq_mul_inv]
    ring
  rw [hL, hQP2]
  refine div_le_div_of_nonneg_right ?_ hden.le
  have hnn : (0 : ℝ) ≤ P * (stC * B0) := mul_nonneg (le_of_lt hPpos) (mul_nonneg hstCnn hB0)
  nlinarith [hnn]

end AngularPlate


/-! ### The plate decomposition of the kernel -/

section KernelPlates

/-- The radial integral of the kernel integrand at a fixed angle. -/
def kernRad (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) (φ : ℝ) : ℂ :=
  ∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))

/-- The plate piece of the kernel. -/
def kernPlate (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) : ℂ :=
  ∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) • kernRad j ε m t u φ

theorem kern_integrand_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {ω : Pl}
    (h : (2 : ℝ) ^ ((j : ℤ) + 1) < ‖ω‖) :
    ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω = 0 := by
  have hnot : ω ∉ Theta j := by
    intro hT
    exact absurd hT.2.2.2 (not_le.mpr h)
  rw [mfull_eq_zero hm ε t hnot, mul_zero]

/-- The kernel is the angular integral of its radial integrals. -/
theorem kern_eq_integral_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    kern j ε m t u = ∫ φ in Set.Ioo (-π) π, kernRad j ε m t u φ := by
  rw [kern]
  exact integral_polar_angle_outer (continuous_kern_integrand hm ε t u)
    (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
    (fun ω hω => kern_integrand_eq_zero hm ε t u hω)

/-- **The angular support.**  The multiplier vanishes unless the polar angle lies in `(1, π/2)`. -/
theorem mem_sector_angle {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) {t r φ : ℝ} (hr : 0 < r) (hφ : φ ∈ Set.Ioo (-π) π)
    (hne : m t (pt r φ) ≠ 0) : 1 < φ ∧ φ < π / 2 := by
  have hT := hm.supp t (pt r φ) hne
  have h0 : 0 < (pt r φ) 0 := hT.1
  have h1 : (pt r φ) 0 < (2 : ℝ) ^ (-(10 : ℤ)) * (pt r φ) 1 := hT.2.1
  rw [pt, mk2_apply_zero] at h0
  rw [pt, mk2_apply_zero, mk2_apply_one] at h1
  have hcos : 0 < Real.cos φ := by
    by_contra hc
    have : r * Real.cos φ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hc)
    linarith
  have hsin : 0 < Real.sin φ := by
    by_contra hs
    have hle : r * Real.sin φ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hs)
    have hcpos : 0 < r * Real.cos φ := mul_pos hr hcos
    have hc10 : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
    nlinarith [h1, hle, hcpos]
  -- `sin φ > 0` and `φ ∈ (-π,π)` force `φ > 0`
  have hpos : 0 < φ := by
    by_contra hp
    have hple : φ ≤ 0 := not_lt.mp hp
    have hnn : 0 ≤ -φ := by linarith
    have hle : -φ ≤ π := by linarith [hφ.1]
    have h := Real.sin_nonneg_of_nonneg_of_le_pi hnn hle
    rw [Real.sin_neg] at h
    linarith
  -- `cos φ > 0` and `φ ∈ (0,π)` force `φ < π/2`
  have hlt : φ < π / 2 := by
    by_contra hq
    have hq' : π / 2 ≤ φ := not_lt.mp hq
    have hle : φ ≤ π + π / 2 := by linarith [hφ.2, Real.pi_pos]
    have h := Real.cos_nonpos_of_pi_div_two_le_of_le hq' hle
    linarith
  refine ⟨?_, hlt⟩
  by_contra hone
  have hle1 : φ ≤ 1 := not_lt.mp hone
  have hcoslow : (1 : ℝ) - φ ^ 2 / 2 ≤ Real.cos φ := Real.one_sub_sq_div_two_le_cos
  have hsinle : Real.sin φ ≤ 1 := Real.sin_le_one φ
  have hc10 : (2 : ℝ) ^ (-(10 : ℤ)) = 1 / 1024 := by
    norm_num [zpow_neg]
  have hcos2 : (1 : ℝ) / 2 ≤ Real.cos φ := by
    have hsq : φ ^ 2 ≤ 1 := by nlinarith [hpos, hle1]
    linarith
  have hcontr : r * Real.cos φ < (1 / 1024 : ℝ) * (r * Real.sin φ) := by
    rw [hc10] at h1
    exact h1
  nlinarith [hcontr, hcos2, hsinle, hr]

/-- Off the angular sector the radial integral vanishes. -/
theorem kernRad_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {φ : ℝ} (hφ : φ ∈ Set.Ioo (-π) π)
    (hout : ¬ (1 < φ ∧ φ < π / 2)) : kernRad j ε m t u φ = 0 := by
  rw [kernRad]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ),
      (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)) = 0 := by
    intro r hr
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      exact hout (mem_sector_angle hm hr hφ hne)
    rw [mfull, hmz, mul_zero, mul_zero, smul_zero]
  rw [setIntegral_congr_fun measurableSet_Ioi hzero]
  simp

/-- The radial integrals are integrable in the angle. -/
theorem integrableOn_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    IntegrableOn (kernRad j ε m t u) (Set.Ioo (-π) π) volume := by
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 •
        (ee (-(inner ℝ u (pt q.1 q.2) : ℝ)) * mfull j ε m t (pt q.1 q.2)))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar (continuous_kern_integrand hm ε t u)
      (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
      (fun ω hω => kern_integrand_eq_zero hm ε t u hω)
  exact hint.integral_prod_right

/-- Each plate piece is integrable in the angle. -/
theorem integrableOn_plate_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    IntegrableOn (fun φ => (plateC M ν φ : ℝ) • kernRad j ε m t u φ)
      (Set.Ioo (-π) π) volume := by
  have hkr := integrableOn_kernRad hm ε t u
  refine Integrable.mono' hkr.norm ?_ ?_
  · exact ((continuous_plateC M ν).aestronglyMeasurable).smul hkr.aestronglyMeasurable
  · filter_upwards with φ
    rw [norm_smul, Real.norm_eq_abs]
    have h1 := abs_plateC_le_one M ν φ
    have h2 : (0 : ℝ) ≤ ‖kernRad j ε m t u φ‖ := norm_nonneg _
    nlinarith [h1, h2]

/-- **The plate decomposition.**  The kernel is the sum of its plate pieces. -/
theorem kern_eq_sum_plates {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {M : ℕ} (hM : 1 ≤ M) :
    kern j ε m t u
      = ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, kernPlate j ε m t u M ν := by
  have hPpos : (0 : ℝ) < (2 : ℝ) ^ M := by positivity
  have hB : (0 : ℤ) ≤ ⌈π * (2 : ℝ) ^ M⌉ := by
    refine Int.ceil_nonneg ?_
    positivity
  have hP1 : (2 : ℝ) ≤ (2 : ℝ) ^ M := by
    calc (2 : ℝ) = (2 : ℝ) ^ (1 : ℕ) := by norm_num
      _ ≤ (2 : ℝ) ^ M := pow_le_pow_right₀ (by norm_num) hM
  have hsum1 : ∀ φ ∈ Set.Ioo (-π) π,
      ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, (plateC M ν φ : ℝ) • kernRad j ε m t u φ
        = kernRad j ε m t u φ := by
    intro φ hφ
    by_cases hs : 1 < φ ∧ φ < π / 2
    · have hone : ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, plateC M ν φ = 1 := by
        rw [sum_plateC M 0 _ hB φ]
        have hT0 : plateT M 0 φ = 1 := by
          rw [plateT]
          refine Real.smoothTransition.one_of_one_le ?_
          push_cast
          nlinarith [hs.1, hP1]
        have hTB : plateT M (⌈π * (2 : ℝ) ^ M⌉ + 1) φ = 0 := by
          rw [plateT]
          refine Real.smoothTransition.zero_of_nonpos ?_
          have hceil : π * (2 : ℝ) ^ M ≤ ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) := Int.le_ceil _
          push_cast
          nlinarith [hs.2, Real.pi_pos, hPpos, hceil]
        rw [hT0, hTB, sub_zero]
      rw [← Finset.sum_smul, hone, one_smul]
    · rw [kernRad_eq_zero hm ε t u hφ hs]
      simp
  rw [kern_eq_integral_kernRad hm ε t u, ← setIntegral_congr_fun measurableSet_Ioo hsum1]
  rw [integral_finset_sum _ (fun ν _ => integrableOn_plate_kernRad hm ε t u M ν)]
  rfl

/-- The trivial bound for the radial integral. -/
theorem norm_kernRad_le_trivial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) :
    ‖kernRad j ε m t u φ‖ ≤ B0 * ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have heq : kernRad j ε m t u φ
      = ∫ r in (0 : ℝ)..b, osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
    rw [kernRad]
    exact radial_integral_eq hp ε t u φ
  rw [heq]
  have hconst : ∀ r ∈ Set.uIoc (0 : ℝ) b,
      ‖osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r‖ ≤ b * B0 := by
    intro r hr
    rw [Set.uIoc_of_le (le_of_lt hbpos)] at hr
    rw [norm_mul, norm_osc, one_mul, radAmp, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have hrb : |r| ≤ b := by
      rw [abs_of_nonneg (le_of_lt hr.1)]
      exact hr.2
    have hm0 : ‖mr 0 t φ r‖ ≤ B0 := by
      have h := hp.rb 0 (by norm_num) t φ r
      simpa using h
    exact mul_le_mul hrb hm0 (norm_nonneg _) (le_of_lt hbpos)
  have h := intervalIntegral.norm_integral_le_of_norm_le_const hconst
  refine le_trans h (le_of_eq ?_)
  have habs : |b - 0| = b := by
    rw [sub_zero, abs_of_pos hbpos]
  rw [habs, hb]
  ring

/-- **The plate bound from a uniform bound for the radial integrals.**  Only the values of the
radial integral on the plate matter. -/
theorem norm_kernPlate_le_of_kernRad_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {C : ℝ} (hCnn : 0 ≤ C)
    (hrad : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), ‖kernRad j ε m t u φ‖ ≤ C) :
    ‖kernPlate j ε m t u M ν‖ ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * C := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  set I : Set ℝ := Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) with hI
  -- the plate piece is an integral over the intersection with the plate
  have hzero : ∀ φ ∈ Set.Ioo (-π) π \ (Set.Ioo (-π) π ∩ I),
      (plateC M ν φ : ℝ) • kernRad j ε m t u φ = 0 := by
    intro φ hφ
    have hnot : φ ∉ I := by
      intro hmem
      exact hφ.2 ⟨hφ.1, hmem⟩
    rw [hI, Set.mem_Icc, not_and_or] at hnot
    have hpz : plateC M ν φ = 0 := by
      rcases hnot with h | h
      · refine (plateC_eq_zero_of_nonpos ?_).1
        have hlt : φ < (ν : ℝ) * Q := not_le.mp h
        have hmul : (2 : ℝ) ^ M * φ < (2 : ℝ) ^ M * ((ν : ℝ) * Q) :=
          mul_lt_mul_of_pos_left hlt (by positivity)
        have hPQ : (2 : ℝ) ^ M * Q = 1 := by
          rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
            ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
          simp
        have hval : (2 : ℝ) ^ M * ((ν : ℝ) * Q) = (ν : ℝ) := by
          calc (2 : ℝ) ^ M * ((ν : ℝ) * Q) = ((2 : ℝ) ^ M * Q) * (ν : ℝ) := by ring
            _ = (ν : ℝ) := by rw [hPQ, one_mul]
        rw [hval] at hmul
        linarith
      · refine (plateC_eq_zero_of_two_le ?_).1
        have hgt : ((ν : ℝ) + 2) * Q < φ := not_le.mp h
        have hmul : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) < (2 : ℝ) ^ M * φ :=
          mul_lt_mul_of_pos_left hgt (by positivity)
        have hPQ : (2 : ℝ) ^ M * Q = 1 := by
          rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
            ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
          simp
        have hval : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) = (ν : ℝ) + 2 := by
          calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) = ((2 : ℝ) ^ M * Q) * ((ν : ℝ) + 2) := by ring
            _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
        rw [hval] at hmul
        linarith
    rw [hpz]
    simp
  have hrestrict : (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) • kernRad j ε m t u φ)
      = ∫ φ in Set.Ioo (-π) π ∩ I, (plateC M ν φ : ℝ) • kernRad j ε m t u φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioo
      Set.inter_subset_left hzero
  rw [kernPlate, hrestrict]
  -- the uniform bound on the plate
  have hbd : ∀ φ ∈ Set.Ioo (-π) π ∩ I, ‖(plateC M ν φ : ℝ) • kernRad j ε m t u φ‖ ≤ C := by
    intro φ hφ
    have hradφ : ‖kernRad j ε m t u φ‖ ≤ C := hrad φ (by rw [hI] at hφ; exact hφ.2)
    rw [norm_smul, Real.norm_eq_abs]
    have h1 := abs_plateC_le_one M ν φ
    have h2 : (0 : ℝ) ≤ ‖kernRad j ε m t u φ‖ := norm_nonneg _
    calc |plateC M ν φ| * ‖kernRad j ε m t u φ‖ ≤ 1 * ‖kernRad j ε m t u φ‖ :=
          mul_le_mul_of_nonneg_right h1 h2
      _ = ‖kernRad j ε m t u φ‖ := one_mul _
      _ ≤ C := hradφ
  have hmeas : volume (Set.Ioo (-π) π ∩ I) ≤ ENNReal.ofReal (2 * Q) := by
    refine le_trans (measure_mono Set.inter_subset_right) ?_
    rw [hI, Real.volume_Icc]
    refine ENNReal.ofReal_le_ofReal ?_
    have h : ((ν : ℝ) + 2) * Q - (ν : ℝ) * Q = 2 * Q := by ring
    rw [h]
  have hfin : volume (Set.Ioo (-π) π ∩ I) < ⊤ :=
    lt_of_le_of_lt hmeas (by exact ENNReal.ofReal_lt_top)
  have hle := norm_setIntegral_le_of_norm_le_const hfin hbd
  refine le_trans hle ?_
  have htoreal : (volume (Set.Ioo (-π) π ∩ I)).toReal ≤ 2 * Q := by
    have h := ENNReal.toReal_le_toReal hfin.ne (by exact ENNReal.ofReal_ne_top) |>.mpr hmeas
    refine le_trans h ?_
    rw [ENNReal.toReal_ofReal (by positivity)]
  calc C * (volume (Set.Ioo (-π) π ∩ I)).toReal ≤ C * (2 * Q) :=
        mul_le_mul_of_nonneg_left htoreal hCnn
    _ = 2 * Q * C := by ring

/-- On the support of the multiplier both polar coordinates of the frequency are positive. -/
theorem sin_cos_pos_of_ne {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) {t r φ : ℝ} (hr : 0 < r) (hne : m t (pt r φ) ≠ 0) :
    0 < Real.sin φ ∧ 0 < Real.cos φ := by
  have hT := hm.supp t (pt r φ) hne
  have h0 : 0 < (pt r φ) 0 := hT.1
  have h1 : 0 < (pt r φ) 1 := Theta.snd_pos hT
  rw [pt, mk2_apply_zero] at h0
  rw [pt, mk2_apply_one] at h1
  constructor
  · by_contra hs
    have := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hs)
    linarith
  · by_contra hc
    have := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hc)
    linarith

/-- **The radial route for a plate.**  If the phase coefficient is at least `mu` on the plate, the
radial estimate integrates to `2·2^{-M}·B₀ 2^{-2j} mu^{-4}`. -/
theorem norm_kernPlate_le_radial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {mu : ℝ} (hmu : 0 < mu)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu ≤ |psiu u ε t φ|) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / mu ^ 4) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  refine norm_kernPlate_le_of_kernRad_le hp hm ε t u M ν (by positivity) ?_
  intro φ hφ
  have hmuφ : mu ≤ |psiu u ε t φ| := hlow φ hφ
  have hψ : psiu u ε t φ ≠ 0 := by
    intro h0
    rw [h0, abs_zero] at hmuφ
    linarith
  have hradφ : ‖kernRad j ε m t u φ‖
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
    rw [kernRad]
    exact norm_radial_integral_le hp ε t u φ hψ
  have hpow : mu ^ 4 ≤ |psiu u ε t φ| ^ 4 := pow_le_pow_left₀ (le_of_lt hmu) hmuφ 4
  refine le_trans hradφ ?_
  exact div_le_div_of_nonneg_left (by positivity) (by positivity) hpow

/-- **The trivial route for a plate.** -/
theorem norm_kernPlate_le_trivial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * (B0 * ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  refine norm_kernPlate_le_of_kernRad_le hp hm ε t u M ν (by positivity) ?_
  intro φ _
  exact norm_kernRad_le_trivial hp ε t u φ

/-- The plate piece with the radius outermost. -/
theorem kernPlate_eq_radius_outer {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    kernPlate j ε m t u M ν
      = ∫ r in Set.Ioi (0 : ℝ), ∫ φ in Set.Ioo (-π) π,
          (plateC M ν φ : ℝ) •
            ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))) := by
  have hprodOI : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint0 : Integrable (fun q : ℝ × ℝ => q.1 •
        (ee (-(inner ℝ u (pt q.1 q.2) : ℝ)) * mfull j ε m t (pt q.1 q.2)))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprodOI]
    exact integrableOn_polar (continuous_kern_integrand hm ε t u)
      (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
      (fun ω hω => kern_integrand_eq_zero hm ε t u hω)
  -- the plate-weighted integrand is integrable on the swapped product
  have hint : Integrable (Function.uncurry fun (φ : ℝ) (r : ℝ) =>
        (plateC M ν φ : ℝ) • ((r : ℝ) •
          (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))))
      (((volume : Measure ℝ).restrict (Set.Ioo (-π) π)).prod
        ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ)))) := by
    have hswap := hint0.swap
    refine Integrable.mono' hswap.norm ?_ ?_
    · have hc : Continuous (Function.uncurry fun (φ : ℝ) (r : ℝ) =>
          (plateC M ν φ : ℝ) • ((r : ℝ) •
            (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))) := by
        have h1 : Continuous fun q : ℝ × ℝ => plateC M ν q.1 :=
          (continuous_plateC M ν).comp continuous_fst
        have h2 : Continuous fun q : ℝ × ℝ => (q.2 : ℝ) •
            (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1)) := by
          refine continuous_snd.smul ?_
          refine (continuous_kern_integrand hm ε t u).comp ?_
          exact continuous_pt.comp (continuous_snd.prodMk continuous_fst)
        exact h1.smul h2
      exact hc.aestronglyMeasurable
    · filter_upwards with q
      have h1 := abs_plateC_le_one M ν q.1
      have h2 : (0 : ℝ) ≤ ‖(q.2 : ℝ) •
          (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1))‖ := norm_nonneg _
      show ‖(plateC M ν q.1 : ℝ) • ((q.2 : ℝ) •
        (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1)))‖ ≤ _
      rw [norm_smul, Real.norm_eq_abs]
      have hsw : ‖(Prod.swap q).1 •
          (ee (-(inner ℝ u (pt (Prod.swap q).1 (Prod.swap q).2) : ℝ))
            * mfull j ε m t (pt (Prod.swap q).1 (Prod.swap q).2))‖
          = ‖(q.2 : ℝ) • (ee (-(inner ℝ u (pt q.2 q.1) : ℝ))
            * mfull j ε m t (pt q.2 q.1))‖ := rfl
      rw [Function.comp_apply] at *
      nlinarith [h1, h2]
  rw [kernPlate]
  have hin : ∀ φ : ℝ, (plateC M ν φ : ℝ) • kernRad j ε m t u φ
      = ∫ r in Set.Ioi (0 : ℝ), (plateC M ν φ : ℝ) •
          ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))) := by
    intro φ
    rw [kernRad, integral_smul]
  rw [setIntegral_congr_fun measurableSet_Ioo (fun φ _ => hin φ)]
  exact integral_integral_swap hint

/-- The plate cutoff kills the angles outside its plate. -/
theorem plateC_eq_zero_of_not_mem {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : φ ∉ Set.Ioc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))) :
    plateC M ν φ = 0 := by
  have hPQ : (2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ)) = 1 := by
    rw [show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  rw [Set.mem_Ioc, not_and_or] at h
  rcases h with h | h
  · refine (plateC_eq_zero_of_nonpos ?_).1
    have hle : φ ≤ (ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)) := not_lt.mp h
    have hmul : (2 : ℝ) ^ M * φ ≤ (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) :=
      mul_le_mul_of_nonneg_left hle (by positivity)
    have hval : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) := by
      calc (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * (ν : ℝ) := by ring
        _ = (ν : ℝ) := by rw [hPQ, one_mul]
    rw [hval] at hmul
    linarith
  · refine (plateC_eq_zero_of_two_le ?_).1
    have hgt : ((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)) < φ := not_le.mp h
    have hmul : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) ≤ (2 : ℝ) ^ M * φ :=
      mul_le_mul_of_nonneg_left (le_of_lt hgt) (by positivity)
    have hval : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) + 2 := by
      calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * ((ν : ℝ) + 2) := by ring
        _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
    rw [hval] at hmul
    linarith

/-- For a fixed radius, the plate-weighted angular integral is an interval integral over the
plate, with the angular amplitude `angAmp`. -/
theorem angular_integral_eq {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl)
    {M : ℕ} (hM : 1 ≤ M) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉) {r : ℝ} (hr : 0 < r) :
    (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))))
      = ∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
          osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hQhalf : Q ≤ 1 / 2 := by
    rw [hQ]
    have h : (2 : ℝ) ^ (-(M : ℤ)) ≤ (2 : ℝ) ^ (-(1 : ℤ)) := by
      refine zpow_le_zpow_right₀ (by norm_num : (1 : ℝ) ≤ 2) ?_
      omega
    calc (2 : ℝ) ^ (-(M : ℤ)) ≤ (2 : ℝ) ^ (-(1 : ℤ)) := h
      _ = 1 / 2 := by norm_num
  -- the pointwise identity
  have hpt : ∀ φ : ℝ, (plateC M ν φ : ℝ) •
      ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))
      = osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    intro φ
    rw [kern_polar_pt j m ε t u (le_of_lt hr) φ, angAmp, hp.a0, Complex.real_smul]
    push_cast
    ring
  -- both integrals are over the intersection of the plate with `(-π,π)`
  set I : Set ℝ := Set.Ioc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) with hI
  have hIm : MeasurableSet I := by
    rw [hI]
    exact measurableSet_Ioc
  have hleft : (∫ φ in Set.Ioo (-π) π, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ)
      = ∫ φ in Set.Ioo (-π) π ∩ I, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioo
      Set.inter_subset_left ?_
    intro φ hφ
    have hnot : φ ∉ I := fun hmem => hφ.2 ⟨hφ.1, hmem⟩
    have hz : plateC M ν φ = 0 := plateC_eq_zero_of_not_mem (by rw [hI] at hnot; exact hnot)
    rw [angAmp, hz]
    simp
  have hright : (∫ φ in I, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ)
      = ∫ φ in I ∩ Set.Ioo (-π) π, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hIm Set.inter_subset_left ?_
    intro φ hφ
    have hmemI : φ ∈ I := hφ.1
    have hnot : φ ∉ Set.Ioo (-π) π := fun hmem => hφ.2 ⟨hmemI, hmem⟩
    -- such an angle is at least `π`, hence has non-positive sine
    have hlow : 0 < φ := by
      rw [hI, Set.mem_Ioc] at hmemI
      have h0 : (0 : ℝ) ≤ (ν : ℝ) * Q := by
        have : (0 : ℝ) ≤ (ν : ℝ) := by exact_mod_cast hν
        positivity
      linarith [hmemI.1]
    have hpi : π ≤ φ := by
      rw [Set.mem_Ioo, not_and_or] at hnot
      rcases hnot with h | h
      · exact absurd hlow (by linarith [not_lt.mp h, Real.pi_pos])
      · exact not_lt.mp h
    have hup : φ ≤ 2 * π := by
      rw [hI, Set.mem_Ioc] at hmemI
      have hceil : ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) ≤ π * (2 : ℝ) ^ M + 1 := by
        have h := Int.ceil_lt_add_one (π * (2 : ℝ) ^ M)
        linarith
      have hνle : ((ν : ℤ) : ℝ) ≤ π * (2 : ℝ) ^ M + 1 := by
        have h : ((ν : ℤ) : ℝ) ≤ ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) := by exact_mod_cast hνB
        linarith
      have hPQ : (2 : ℝ) ^ M * Q = 1 := by
        rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
          ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
        simp
      have hstep : ((ν : ℝ) + 2) * Q ≤ π + 3 * Q := by
        have h1 : (ν : ℝ) * Q ≤ (π * (2 : ℝ) ^ M + 1) * Q :=
          mul_le_mul_of_nonneg_right hνle (le_of_lt hQpos)
        have h2 : (π * (2 : ℝ) ^ M + 1) * Q = π + Q := by
          calc (π * (2 : ℝ) ^ M + 1) * Q = π * ((2 : ℝ) ^ M * Q) + Q := by ring
            _ = π + Q := by rw [hPQ, mul_one]
        nlinarith [h1, h2, hQpos]
      have hπ : (2 : ℝ) ≤ π := Real.two_le_pi
      nlinarith [hmemI.2, hstep, hQhalf, hπ]
    have hsin : Real.sin φ ≤ 0 := by
      have h1 : 0 ≤ φ - π := by linarith
      have h2 : φ - π ≤ π := by linarith
      have h := Real.sin_nonneg_of_nonneg_of_le_pi h1 h2
      rw [Real.sin_sub_pi] at h
      linarith
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      exact absurd (sin_cos_pos_of_ne hm hr hne).1 (not_lt.mpr hsin)
    rw [angAmp, hp.a0, hmz]
    simp
  rw [setIntegral_congr_fun measurableSet_Ioo (fun φ _ => hpt φ), hleft,
    intervalIntegral.integral_of_le (by nlinarith [hQpos] : (ν : ℝ) * Q ≤ ((ν : ℝ) + 2) * Q),
    ← hI, hright, Set.inter_comm]

/-- Off the frequency annulus the angular integral vanishes. -/
theorem angular_integral_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {r : ℝ} (hr : 0 < r) (hout : r < (2 : ℝ) ^ ((j : ℤ) - 1) ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r) :
    (∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
        osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ) = 0 := by
  have hzero : ∀ φ : ℝ, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ = 0 := by
    intro φ
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      have hT := hm.supp t (pt r φ) hne
      have hnorm : ‖pt r φ‖ = r := norm_pt r φ (le_of_lt hr)
      rcases hout with h | h
      · have := hT.2.2.1
        rw [hnorm] at this
        linarith
      · have := hT.2.2.2
        rw [hnorm] at this
        linarith
    rw [angAmp, hp.a0, hmz]
    simp
  rw [intervalIntegral.integral_congr (fun φ _ => hzero φ)]
  simp

/-- **The angular route for a plate.**  Two integrations by parts in the angle, integrated over the
radial annulus. -/
theorem norm_kernPlate_le_angular {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl)
    {M : ℕ} (hM : 1 ≤ M) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    {mu0 : ℝ} (hmu0 : 0 < mu0) (hmuM : (2 : ℝ) ^ (-(M : ℤ)) ≤ mu0)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu0 ≤ |psi1 u φ|)
    (h2 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi2 u φ| ≤ 3 + 24 * mu0)
    (h3 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi3 u φ| ≤ 8 * mu0) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 3200 * stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  set K : ℝ := stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 with hK
  have hKnn : (0 : ℝ) ≤ K := by
    rw [hK]
    refine div_nonneg ?_ (by positivity)
    exact mul_nonneg (mul_nonneg (le_trans zero_le_one hstC) hB0) (by positivity)
  set A : ℝ := (2 : ℝ) ^ ((j : ℤ) - 2) with hA
  set Bb : ℝ := (2 : ℝ) ^ ((j : ℤ) + 1) with hBb
  have hApos : (0 : ℝ) < A := by rw [hA]; positivity
  have hBpos : (0 : ℝ) < Bb := by rw [hBb]; positivity
  have hAB : A ≤ Bb := by
    rw [hA, hBb]
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  -- the radius-outer representation
  rw [kernPlate_eq_radius_outer hm ε t u M ν]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ) \ Set.Ioc A Bb,
      (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))) = 0 := by
    intro r hr
    have hrpos : (0 : ℝ) < r := hr.1
    have hnot : r ∉ Set.Ioc A Bb := hr.2
    rw [Set.mem_Ioc, not_and_or] at hnot
    have hout : r < (2 : ℝ) ^ ((j : ℤ) - 1) ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r := by
      rcases hnot with h | h
      · refine Or.inl ?_
        have hle : r ≤ A := not_lt.mp h
        have hlt : A < (2 : ℝ) ^ ((j : ℤ) - 1) := by
          rw [hA]
          exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
        linarith
      · exact Or.inr (not_le.mp h)
    rw [angular_integral_eq hp hm ε t u hM hν hνB hrpos]
    exact angular_integral_eq_zero hp hm ε t u M ν hrpos hout
  have hsub : Set.Ioc A Bb ⊆ Set.Ioi (0 : ℝ) := fun r hr => lt_trans hApos hr.1
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub hzero]
  -- the uniform bound on the annulus
  have hbd : ∀ r ∈ Set.Ioc A Bb,
      ‖∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))‖
      ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) := by
    intro r hr
    have hrpos : (0 : ℝ) < r := lt_trans hApos hr.1
    rw [angular_integral_eq hp hm ε t u hM hν hνB hrpos]
    have h := norm_angular_plate_le hp u ε t M ν hmu0 hmuM hrpos hlow h2 h3
    refine le_trans h ?_
    have hrinv : (r : ℝ)⁻¹ ≤ (2 : ℝ) ^ (2 - (j : ℤ)) := by
      have hAinv : A⁻¹ = (2 : ℝ) ^ (2 - (j : ℤ)) := by
        rw [hA, ← zpow_neg]
        congr 1
        ring
      rw [← hAinv]
      exact inv_anti₀ hApos (le_of_lt hr.1)
    have hlhs : 400 * stC * B0 * (2 : ℝ) ^ M / (r * mu0 ^ 2) = (400 * K) * r⁻¹ := by
      rw [hK]
      field_simp
    rw [hlhs]
    exact mul_le_mul_of_nonneg_left hrinv (by positivity)
  have hfin : volume (Set.Ioc A Bb) < ⊤ := by
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hle := norm_setIntegral_le_of_norm_le_const hfin hbd
  refine le_trans hle ?_
  have htoreal : (volume (Set.Ioc A Bb)).toReal ≤ Bb := by
    rw [Real.volume_Ioc, ENNReal.toReal_ofReal (by linarith)]
    linarith [hApos]
  have hCnn : (0 : ℝ) ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) := by positivity
  calc 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * (volume (Set.Ioc A Bb)).toReal
      ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * Bb :=
        mul_le_mul_of_nonneg_left htoreal hCnn
    _ = 3200 * K := by
        have hpow8 : (2 : ℝ) ^ (2 - (j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1) = 8 := by
          rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
            show (2 - (j : ℤ) + ((j : ℤ) + 1)) = 3 by ring]
          norm_num
        calc 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * Bb
            = 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1)) := by
              rw [hBb]
              ring
          _ = 3200 * K := by
              rw [hpow8]
              ring
    _ = 3200 * stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 := by
        rw [hK]
        field_simp

/-! ### An elementary one-dimensional integral -/

/-- The quadratically decaying bump `(1 + A|a v + b|)^{-2}` has integral at most `2π/(Aa)`.
It is dominated by the Cauchy kernel `2(1 + (A(av+b))²)^{-1}`. -/
theorem integral_inv_one_add_abs_sq_le {A a b : ℝ} (hA : 0 < A) (ha : 0 < a) :
    (∫ v : ℝ, (1 + A * |a * v + b|)⁻¹ ^ 2) ≤ 2 * π / (A * a) := by
  set c : ℝ := A * a with hc
  have hcpos : (0 : ℝ) < c := by rw [hc]; positivity
  have hcne : c ≠ 0 := ne_of_gt hcpos
  -- the pointwise majorant
  have hmaj : ∀ v : ℝ, (1 + A * |a * v + b|)⁻¹ ^ 2 ≤ 2 * (1 + (c * v + A * b) ^ 2)⁻¹ := by
    intro v
    set y : ℝ := A * |a * v + b| with hy
    have hynn : (0 : ℝ) ≤ y := by
      rw [hy]
      positivity
    have hsq : (c * v + A * b) ^ 2 = y ^ 2 := by
      rw [hy, hc, mul_pow, sq_abs]
      ring
    rw [hsq, inv_pow]
    have hp1 : (0 : ℝ) < (1 + y) ^ 2 := by positivity
    have hp2 : (0 : ℝ) < 1 + y ^ 2 := by positivity
    rw [show (2 : ℝ) * (1 + y ^ 2)⁻¹ = 2 / (1 + y ^ 2) by
      rw [div_eq_mul_inv]]
    rw [inv_eq_one_div, div_le_div_iff₀ hp1 hp2]
    nlinarith [hynn]
  -- the majorant is integrable, with integral `2π/c`
  have hbase : Integrable fun x : ℝ => (1 + x ^ 2)⁻¹ := integrable_inv_one_add_sq
  have hshift : Integrable fun x : ℝ => (1 + (x + A * b) ^ 2)⁻¹ :=
    hbase.comp_add_right (A * b)
  have hscale : Integrable fun v : ℝ => (1 + (c * v + A * b) ^ 2)⁻¹ := by
    have h := hshift.comp_mul_left' hcne
    refine h.congr ?_
    filter_upwards with v
    ring_nf
  have hint : Integrable fun v : ℝ => 2 * (1 + (c * v + A * b) ^ 2)⁻¹ := hscale.const_mul 2
  have hnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => (1 + A * |a * v + b|)⁻¹ ^ 2 := by
    filter_upwards with v
    show (0 : ℝ) ≤ (1 + A * |a * v + b|)⁻¹ ^ 2
    positivity
  have hle := integral_mono_of_nonneg hnn hint (Filter.Eventually.of_forall hmaj)
  refine le_trans hle (le_of_eq ?_)
  -- compute the majorant's integral
  have hcomp : (∫ v : ℝ, (1 + (c * v + A * b) ^ 2)⁻¹) = c⁻¹ * π := by
    have hstep : (∫ v : ℝ, (1 + (c * v + A * b) ^ 2)⁻¹)
        = ∫ v : ℝ, (fun y : ℝ => (1 + (y + A * b) ^ 2)⁻¹) (c * v) := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
      show (1 + (c * v + A * b) ^ 2)⁻¹ = (1 + (c * v + A * b) ^ 2)⁻¹
      rfl
    rw [hstep, MeasureTheory.Measure.integral_comp_mul_left (fun y : ℝ => (1 + (y + A * b) ^ 2)⁻¹) c]
    rw [MeasureTheory.integral_add_right_eq_self (fun x : ℝ => (1 + x ^ 2)⁻¹) (A * b)]
    rw [integral_univ_inv_one_add_sq, smul_eq_mul, abs_of_pos (by positivity : (0 : ℝ) < c⁻¹)]
  rw [integral_const_mul, hcomp, hc]
  field_simp

/-! ### Combining the two routes, and the sinusoid form of the phase -/

/-- If a nonnegative quantity is bounded by both `R` and `A`, it is bounded by any `Z ≥ 0` with
`R·A ≤ Z²`.  This replaces taking square roots. -/
theorem le_of_sq_le_mul {K R A Z : ℝ} (hK : 0 ≤ K) (hZ : 0 ≤ Z) (hR : K ≤ R) (hA : K ≤ A)
    (h : R * A ≤ Z ^ 2) : K ≤ Z := by
  have hKK : K ^ 2 ≤ R * A := by nlinarith
  nlinarith [hKK, h]

/-- **The capped radial route.**  Combining the radial estimate with the trivial one gives a bound
which is finite even where the phase coefficient vanishes. -/
theorem norm_kernPlate_le_capped {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {mu : ℝ} (hmu : 0 ≤ mu)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu ≤ |psiu u ε t φ|) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
          * (1 + (2 : ℝ) ^ (j : ℤ) * mu)⁻¹ ^ 4 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJ]; positivity
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJ, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  have hy : (0 : ℝ) ≤ J * mu := by positivity
  have hpos : (0 : ℝ) < 1 + J * mu := by linarith
  have hb : ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2 = 16 * J ^ 2 := by
    rw [hJ, ← hJ2, show ((j : ℤ) + 2) = 2 + (j : ℤ) by ring,
      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    rw [show (2 * (j : ℤ)) = (j : ℤ) + (j : ℤ) by ring,
      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    norm_num
    ring
  rcases le_or_gt (J * mu) 1 with hcase | hcase
  · -- the trivial bound suffices
    have htriv := norm_kernPlate_le_trivial hp hm ε t u M ν
    refine le_trans htriv ?_
    rw [hb, hJ2]
    have hinv : (1 : ℝ) / 16 ≤ (1 + J * mu)⁻¹ ^ 4 := by
      have h2 : (1 + J * mu) ≤ 2 := by linarith
      have h1 : (0 : ℝ) < (1 + J * mu) ^ 4 := by positivity
      rw [inv_pow, le_inv_comm₀ (by norm_num) h1]
      have h4 : (1 + J * mu) ^ 4 ≤ 2 ^ 4 := pow_le_pow_left₀ (by positivity) h2 4
      norm_num at h4 ⊢
      linarith
    have hfac : (0 : ℝ) ≤ 512 * Q * B0 * J ^ 2 := by positivity
    calc 2 * Q * (B0 * (16 * J ^ 2)) = 32 * (Q * B0 * J ^ 2) := by ring
      _ ≤ 512 * Q * B0 * J ^ 2 * ((1 : ℝ) / 16) := by
          nlinarith [mul_nonneg (mul_nonneg (le_of_lt hQpos) hB0) (sq_nonneg J)]
      _ ≤ 512 * Q * B0 * J ^ 2 * (1 + J * mu)⁻¹ ^ 4 :=
          mul_le_mul_of_nonneg_left hinv hfac
  · -- the radial bound suffices
    have hmupos : (0 : ℝ) < mu := by
      by_contra hle
      have : J * mu ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hJpos) (not_lt.mp hle)
      linarith
    have hrad := norm_kernPlate_le_radial hp hm ε t u M ν hmupos hlow
    refine le_trans hrad ?_
    have hneg : (2 : ℝ) ^ (-(2 * (j : ℤ))) = (J ^ 2)⁻¹ := by
      rw [← hJ2, ← zpow_neg]
    rw [hneg, hJ2]
    have hinv : (16 * (J * mu) ^ 4)⁻¹ ≤ (1 + J * mu)⁻¹ ^ 4 := by
      have h2 : (1 + J * mu) ≤ 2 * (J * mu) := by linarith
      have h1 : (0 : ℝ) < (1 + J * mu) ^ 4 := by positivity
      have h3 : (0 : ℝ) < 16 * (J * mu) ^ 4 := by positivity
      rw [inv_pow, inv_le_inv₀ h3 h1]
      have h4 : (1 + J * mu) ^ 4 ≤ (2 * (J * mu)) ^ 4 :=
        pow_le_pow_left₀ (by positivity) h2 4
      calc (1 + J * mu) ^ 4 ≤ (2 * (J * mu)) ^ 4 := h4
        _ = 16 * (J * mu) ^ 4 := by ring
    have hkey : 2 * Q * (B0 * (J ^ 2)⁻¹ / mu ^ 4)
        ≤ 512 * Q * B0 * J ^ 2 * ((16 * (J * mu) ^ 4)⁻¹) := by
      have hrhs : 512 * Q * B0 * J ^ 2 * ((16 * (J * mu) ^ 4)⁻¹)
          = 32 * Q * B0 / (J ^ 2 * mu ^ 4) := by
        field_simp
        ring
      have hlhs : 2 * Q * (B0 * (J ^ 2)⁻¹ / mu ^ 4) = 2 * Q * B0 / (J ^ 2 * mu ^ 4) := by
        field_simp
      rw [hrhs, hlhs, div_le_div_iff₀ (by positivity) (by positivity)]
      have hnn : (0 : ℝ) ≤ Q * B0 * (J ^ 2 * mu ^ 4) := by positivity
      nlinarith [hnn]
    refine le_trans hkey ?_
    exact mul_le_mul_of_nonneg_left hinv (by positivity)

/-- **The sinusoid form of the phase.**  There is a phase shift `δ` with
`⟨u,θ(φ)⟩ = ‖u‖ sin(φ+δ)` and `ψ'(φ) = ‖u‖ cos(φ+δ)`. -/
theorem exists_phase_shift (u : Pl) : ∃ δ : ℝ,
    (∀ φ : ℝ, (inner ℝ u (pt 1 φ) : ℝ) = ‖u‖ * Real.sin (φ + δ))
      ∧ ∀ φ : ℝ, psi1 u φ = ‖u‖ * Real.cos (φ + δ) := by
  by_cases h0 : u = 0
  · refine ⟨0, fun φ => ?_, fun φ => ?_⟩
    · rw [h0]
      simp
    · rw [h0, psi1]
      simp
  · set z : ℂ := (u 1 : ℂ) + (u 0 : ℂ) * Complex.I with hz
    have hzre : z.re = u 1 := by
      rw [hz]
      simp
    have hzim : z.im = u 0 := by
      rw [hz]
      simp
    have hznorm : ‖z‖ = ‖u‖ := by
      rw [Complex.norm_eq_sqrt_sq_add_sq, hzre, hzim]
      rw [show ‖u‖ = Real.sqrt (‖u‖ ^ 2) by rw [Real.sqrt_sq (norm_nonneg u)]]
      rw [norm_sq_eq_coords u]
      congr 1
      ring
    have hunorm : (0 : ℝ) < ‖u‖ := by
      rw [norm_pos_iff]
      exact h0
    have hzne : z ≠ 0 := by
      intro hzz
      rw [hzz] at hznorm
      simp at hznorm
      exact absurd hznorm.symm (ne_of_gt hunorm)
    refine ⟨Complex.arg z, fun φ => ?_, fun φ => ?_⟩
    · have hs : Real.sin (Complex.arg z) = u 0 / ‖u‖ := by
        rw [Complex.sin_arg, hzim, hznorm]
      have hc : Real.cos (Complex.arg z) = u 1 / ‖u‖ := by
        rw [Complex.cos_arg hzne, hzre, hznorm]
      rw [Real.sin_add, hs, hc, pt, inner_two, mk2_apply_zero, mk2_apply_one]
      field_simp
      ring
    · have hs : Real.sin (Complex.arg z) = u 0 / ‖u‖ := by
        rw [Complex.sin_arg, hzim, hznorm]
      have hc : Real.cos (Complex.arg z) = u 1 / ‖u‖ := by
        rw [Complex.cos_arg hzne, hzre, hznorm]
      rw [Real.cos_add, hs, hc, psi1]
      field_simp
      ring

/-! ### The lower bound for the angular derivative -/

/-- Jordan's inequality in the form `|s|/2 ≤ |sin s|` on `|s| ≤ π/2`. -/
theorem abs_sin_ge_half {s : ℝ} (hs : |s| ≤ π / 2) : |s| / 2 ≤ |Real.sin s| := by
  have hpi4 : π ≤ 4 := Real.pi_le_four
  have hpipos : (0 : ℝ) < π := Real.pi_pos
  have hmain : ∀ x : ℝ, 0 ≤ x → x ≤ π / 2 → x / 2 ≤ Real.sin x := by
    intro x hx hx'
    have hj := Real.mul_le_sin hx hx'
    have hcoef : (1 : ℝ) / 2 ≤ 2 / π := by
      rw [div_le_div_iff₀ (by norm_num) hpipos]
      linarith
    have hstep : x / 2 ≤ 2 / π * x := by
      have h := mul_le_mul_of_nonneg_right hcoef hx
      calc x / 2 = 1 / 2 * x := by ring
        _ ≤ 2 / π * x := h
    linarith
  rcases le_or_gt 0 s with h | h
  · have habs : |s| = s := abs_of_nonneg h
    rw [habs] at hs ⊢
    have hsin : 0 ≤ Real.sin s :=
      Real.sin_nonneg_of_nonneg_of_le_pi h (by linarith)
    rw [abs_of_nonneg hsin]
    exact hmain s h hs
  · have habs : |s| = -s := abs_of_neg h
    have hneg : 0 ≤ -s := by linarith
    have hs' : -s ≤ π / 2 := by
      rw [habs] at hs
      exact hs
    have hsin : 0 ≤ Real.sin (-s) :=
      Real.sin_nonneg_of_nonneg_of_le_pi hneg (by linarith)
    have hmain' := hmain (-s) hneg hs'
    rw [Real.sin_neg] at hmain'
    rw [habs, abs_of_nonpos (by linarith [hsin, Real.sin_neg s] : Real.sin s ≤ 0)]
    linarith

/-- The distance from `x` to the nearest zero of the cosine. -/
noncomputable def cosDist (x : ℝ) : ℝ := |x - (π / 2 + (round ((x - π / 2) / π) : ℝ) * π)|

theorem cosDist_nonneg (x : ℝ) : 0 ≤ cosDist x := abs_nonneg _

theorem cosDist_le (x : ℝ) : cosDist x ≤ π / 2 := by
  have hpipos : (0 : ℝ) < π := Real.pi_pos
  have h := abs_sub_round ((x - π / 2) / π)
  have hx : x - (π / 2 + ((round ((x - π / 2) / π) : ℤ) : ℝ) * π)
      = π * ((x - π / 2) / π - ((round ((x - π / 2) / π) : ℤ) : ℝ)) := by
    field_simp
    ring
  rw [cosDist, hx, abs_mul, abs_of_pos hpipos]
  calc π * |(x - π / 2) / π - ((round ((x - π / 2) / π) : ℤ) : ℝ)| ≤ π * (1 / 2) :=
        mul_le_mul_of_nonneg_left h (le_of_lt hpipos)
    _ = π / 2 := by ring

/-- `|cos x|` is at least half the distance to the nearest zero of the cosine. -/
theorem abs_cos_ge (x : ℝ) : cosDist x / 2 ≤ |Real.cos x| := by
  set n : ℤ := round ((x - π / 2) / π) with hn
  set sarg : ℝ := x - (π / 2 + (n : ℝ) * π) with hsarg
  have hx : x = π / 2 + sarg + (n : ℝ) * π := by
    rw [hsarg]
    ring
  have hcos : |Real.cos x| = |Real.sin sarg| := by
    rw [hx, Real.cos_add_int_mul_pi, abs_mul]
    have hpow : |((-1 : ℝ) ^ n)| = 1 := by
      rcases Int.even_or_odd n with he | ho
      · rw [he.neg_one_zpow]
        norm_num
      · rw [ho.neg_one_zpow]
        norm_num
    have hstep : Real.cos (π / 2 + sarg) = -Real.sin sarg := by
      rw [Real.cos_add, Real.cos_pi_div_two, Real.sin_pi_div_two]
      ring
    rw [hpow, one_mul, hstep, abs_neg]
  have hd : cosDist x = |sarg| := by
    rw [cosDist, ← hn, ← hsarg]
  rw [hd, hcos]
  refine abs_sin_ge_half ?_
  rw [← hd]
  exact cosDist_le x

/-- **The lower bound for the angular derivative of the phase.** -/
theorem abs_psi1_ge (u : Pl) {δ : ℝ} (hδ : ∀ φ : ℝ, psi1 u φ = ‖u‖ * Real.cos (φ + δ)) (φ : ℝ) :
    ‖u‖ * cosDist (φ + δ) / 2 ≤ |psi1 u φ| := by
  rw [hδ φ, abs_mul, abs_of_nonneg (norm_nonneg u)]
  have h := abs_cos_ge (φ + δ)
  have hnn : (0 : ℝ) ≤ ‖u‖ := norm_nonneg u
  calc ‖u‖ * cosDist (φ + δ) / 2 = ‖u‖ * (cosDist (φ + δ) / 2) := by ring
    _ ≤ ‖u‖ * |Real.cos (φ + δ)| := mul_le_mul_of_nonneg_left h hnn

/-- The round-based distance is minimal among all the zeros of the cosine. -/
theorem cosDist_le_of_int (x : ℝ) (k : ℤ) : cosDist x ≤ |x - (π / 2 + (k : ℝ) * π)| := by
  have hpi : (0 : ℝ) < π := Real.pi_pos
  set n : ℤ := round ((x - π / 2) / π) with hn
  by_cases h : k = n
  · rw [cosDist, ← hn, h]
  · have hkn : (1 : ℝ) ≤ |(k : ℝ) - (n : ℝ)| := by
      have hz : ((k - n : ℤ) : ℝ) = (k : ℝ) - (n : ℝ) := by push_cast; ring
      have hne : k - n ≠ 0 := by
        intro h0
        exact h (by omega)
      have h1 : (1 : ℤ) ≤ |k - n| := by
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · rw [abs_of_neg hlt]
          omega
        · rw [abs_of_pos hgt]
          omega
      have h2 : ((1 : ℤ) : ℝ) ≤ ((|k - n| : ℤ) : ℝ) := by exact_mod_cast h1
      rw [Int.cast_abs, hz] at h2
      simpa using h2
    have hround := abs_sub_round ((x - π / 2) / π)
    rw [← hn] at hround
    have hxk : |x - (π / 2 + (k : ℝ) * π)| = π * |(x - π / 2) / π - (k : ℝ)| := by
      rw [show x - (π / 2 + (k : ℝ) * π) = π * ((x - π / 2) / π - (k : ℝ)) by
        field_simp; ring, abs_mul, abs_of_pos hpi]
    have hlow : (1 : ℝ) / 2 ≤ |(x - π / 2) / π - (k : ℝ)| := by
      have htri : |(k : ℝ) - (n : ℝ)|
          ≤ |(x - π / 2) / π - (n : ℝ)| + |(x - π / 2) / π - (k : ℝ)| := by
        calc |(k : ℝ) - (n : ℝ)|
            = |((x - π / 2) / π - (n : ℝ)) - ((x - π / 2) / π - (k : ℝ))| := by
              congr 1
              ring
          _ ≤ |(x - π / 2) / π - (n : ℝ)| + |(x - π / 2) / π - (k : ℝ)| := abs_sub _ _
      linarith
    have h2 : π / 2 ≤ |x - (π / 2 + (k : ℝ) * π)| := by
      rw [hxk]
      calc π / 2 = π * (1 / 2) := by ring
        _ ≤ π * |(x - π / 2) / π - (k : ℝ)| := mul_le_mul_of_nonneg_left hlow (le_of_lt hpi)
    exact le_trans (cosDist_le x) h2

/-- The distance to the nearest zero of the cosine is Lipschitz. -/
theorem cosDist_sub_le (x y : ℝ) : cosDist x - |x - y| ≤ cosDist y := by
  set n : ℤ := round ((y - π / 2) / π) with hn
  have h1 : cosDist x ≤ |x - (π / 2 + (n : ℝ) * π)| := cosDist_le_of_int x n
  have h2 : |x - (π / 2 + (n : ℝ) * π)| ≤ |x - y| + |y - (π / 2 + (n : ℝ) * π)| := by
    calc |x - (π / 2 + (n : ℝ) * π)| = |(x - y) + (y - (π / 2 + (n : ℝ) * π))| := by
          congr 1
          ring
      _ ≤ |x - y| + |y - (π / 2 + (n : ℝ) * π)| := abs_add_le _ _
  have h3 : |y - (π / 2 + (n : ℝ) * π)| = cosDist y := by
    rw [cosDist, ← hn]
  linarith

/-! ### The harmonic sum and the clustering of the resonant plates -/

/-- The dyadic bound for the harmonic sum. -/
theorem harmonic_dyadic (L : ℕ) :
    ∑ k ∈ Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L), (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  induction L with
  | zero => norm_num
  | succ L ih =>
    have hsplit : Finset.Icc (1 : ℕ) ((2 : ℕ) ^ (L + 1))
        = Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L)
          ∪ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_union]
      constructor
      · intro h
        rcases le_or_gt k ((2 : ℕ) ^ L) with hk | hk
        · exact Or.inl ⟨h.1, hk⟩
        · exact Or.inr ⟨hk, h.2⟩
      · intro h
        rcases h with h | h
        · refine ⟨h.1, le_trans h.2 ?_⟩
          exact Nat.pow_le_pow_right (by norm_num) (by omega)
        · refine ⟨?_, h.2⟩
          have h1 : 1 ≤ (2 : ℕ) ^ L := Nat.one_le_two_pow
          omega
    have hdisj : Disjoint (Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L))
        (Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1))) := by
      refine Finset.disjoint_left.mpr ?_
      intro k hk hk'
      rw [Finset.mem_Icc] at hk hk'
      omega
    rw [hsplit, Finset.sum_union hdisj]
    have hcard : (Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1))).card = (2 : ℕ) ^ L := by
      rw [Nat.card_Icc]
      have h2 : (2 : ℕ) ^ (L + 1) = 2 * (2 : ℕ) ^ L := by ring
      omega
    have hbd : ∀ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
        (1 : ℝ) / (k : ℝ) ≤ (1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ) := by
      intro k hk
      rw [Finset.mem_Icc] at hk
      have hk1 : (0 : ℝ) < (((2 : ℕ) ^ L : ℕ) : ℝ) := by positivity
      have hk2 : (((2 : ℕ) ^ L : ℕ) : ℝ) ≤ (k : ℝ) := by
        have hnat : (2 : ℕ) ^ L ≤ k := by omega
        exact_mod_cast hnat
      exact one_div_le_one_div_of_le hk1 hk2
    have htail : ∑ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
        (1 : ℝ) / (k : ℝ) ≤ 1 := by
      calc ∑ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)), (1 : ℝ) / (k : ℝ)
          ≤ ∑ _k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
              (1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ) := Finset.sum_le_sum hbd
        _ = (((2 : ℕ) ^ L : ℕ) : ℝ) * ((1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ)) := by
            rw [Finset.sum_const, hcard, nsmul_eq_mul]
        _ = 1 := by
            have hne : (((2 : ℕ) ^ L : ℕ) : ℝ) ≠ 0 := by positivity
            field_simp
    push_cast
    push_cast at ih
    linarith

/-- The harmonic sum up to any `n ≤ 2^L`. -/
theorem harmonic_le (n L : ℕ) (h : n ≤ (2 : ℕ) ^ L) :
    ∑ k ∈ Finset.Icc (1 : ℕ) n, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_) (harmonic_dyadic L)
  · intro k hk
    rw [Finset.mem_Icc] at hk ⊢
    exact ⟨hk.1, le_trans hk.2 h⟩
  · intro k _ _
    positivity

/-- **Clustering.**  Two points at distance at most `1` that are both within `1` of a zero of the
cosine are within the sum of their distances to the zeros: their nearest zeros coincide, because
the zeros are `π`-separated. -/
theorem abs_sub_le_cosDist_add {x y : ℝ} (hxy : |x - y| ≤ 1) (hx : cosDist x ≤ 1)
    (hy : cosDist y ≤ 1) : |x - y| ≤ cosDist x + cosDist y := by
  have hpi : (3 : ℝ) < π := by
    have h := Real.pi_gt_three
    linarith
  set nx : ℤ := round ((x - π / 2) / π) with hnx
  set ny : ℤ := round ((y - π / 2) / π) with hny
  set zx : ℝ := π / 2 + (nx : ℝ) * π with hzx
  set zy : ℝ := π / 2 + (ny : ℝ) * π with hzy
  have hdx : |x - zx| = cosDist x := by rw [cosDist, ← hnx, ← hzx]
  have hdy : |y - zy| = cosDist y := by rw [cosDist, ← hny, ← hzy]
  have hclose : |zx - zy| ≤ 3 := by
    have h1 : |zx - zy| ≤ |zx - x| + |x - y| + |y - zy| := by
      calc |zx - zy| = |(zx - x) + (x - y) + (y - zy)| := by
            congr 1
            ring
        _ ≤ |(zx - x) + (x - y)| + |y - zy| := abs_add_le _ _
        _ ≤ |zx - x| + |x - y| + |y - zy| := by
            have := abs_add_le (zx - x) (x - y)
            linarith
    have h2 : |zx - x| = cosDist x := by
      rw [← hdx, abs_sub_comm]
    linarith [hdy ▸ le_refl |y - zy|, h1, h2 ▸ le_refl |zx - x|]
  have hsame : nx = ny := by
    by_contra hne
    have h1 : (1 : ℤ) ≤ |nx - ny| := by
      have hne' : nx - ny ≠ 0 := by omega
      rcases lt_or_gt_of_ne hne' with hlt | hgt
      · rw [abs_of_neg hlt]
        omega
      · rw [abs_of_pos hgt]
        omega
    have h2 : |zx - zy| = |(nx : ℝ) - (ny : ℝ)| * π := by
      rw [hzx, hzy, show π / 2 + (nx : ℝ) * π - (π / 2 + (ny : ℝ) * π)
        = ((nx : ℝ) - (ny : ℝ)) * π by ring, abs_mul, abs_of_pos Real.pi_pos]
    have h3 : (1 : ℝ) ≤ |(nx : ℝ) - (ny : ℝ)| := by
      have hz : ((nx - ny : ℤ) : ℝ) = (nx : ℝ) - (ny : ℝ) := by push_cast; ring
      have h4 : ((1 : ℤ) : ℝ) ≤ ((|nx - ny| : ℤ) : ℝ) := by exact_mod_cast h1
      rw [Int.cast_abs, hz] at h4
      simpa using h4
    have h5 : π ≤ |zx - zy| := by
      rw [h2]
      calc π = 1 * π := by ring
        _ ≤ |(nx : ℝ) - (ny : ℝ)| * π :=
            mul_le_mul_of_nonneg_right h3 (le_of_lt Real.pi_pos)
    linarith
  rw [hsame] at hzx
  have hzz : zx = zy := by rw [hzx, hzy]
  calc |x - y| = |(x - zx) + (zx - y)| := by
        congr 1
        ring
    _ ≤ |x - zx| + |zx - y| := abs_add_le _ _
    _ = cosDist x + cosDist y := by
        rw [hdx, hzz, abs_sub_comm, hdy]

/-! ### The phase in coordinates -/

/-- The second angular derivative of the phase coefficient is `εt - ψ`. -/
theorem psi2_eq (u : Pl) (ε t φ : ℝ) : psi2 u φ = ε * t - psiu u ε t φ := by
  rw [psi2, psiu_eq]
  ring

/-- The third angular derivative is minus the first. -/
theorem psi3_eq_neg (u : Pl) (φ : ℝ) : psi3 u φ = -psi1 u φ := by
  rw [psi3, psi1]
  ring

/-- The phase coefficient is affine in the second coordinate. -/
theorem psiu_mk2 (w v ε t φ : ℝ) :
    psiu (mk2 w v) ε t φ = v * Real.sin φ + (w * Real.cos φ + ε * t) := by
  rw [psiu_eq, mk2_apply_zero, mk2_apply_one]
  ring

/-- Its angular derivative is affine in the second coordinate. -/
theorem psi1_mk2 (w v φ : ℝ) :
    psi1 (mk2 w v) φ = v * Real.cos φ - w * Real.sin φ := by
  rw [psi1, mk2_apply_zero, mk2_apply_one]
  ring

/-! #### Angles near `π/2` -/

/-- Near `π/2` the sine is bounded below. -/
theorem sin_ge_of_near {φ : ℝ} (h : |π / 2 - φ| ≤ 3 / 5) : (4 : ℝ) / 5 ≤ Real.sin φ := by
  have hcos : Real.sin φ = Real.cos (π / 2 - φ) := by
    rw [Real.cos_pi_div_two_sub]
  have hlow : (1 : ℝ) - (π / 2 - φ) ^ 2 / 2 ≤ Real.cos (π / 2 - φ) :=
    Real.one_sub_sq_div_two_le_cos
  have hsq : (π / 2 - φ) ^ 2 ≤ (3 / 5) ^ 2 := by
    have h0 : (0 : ℝ) ≤ |π / 2 - φ| := abs_nonneg _
    nlinarith [sq_abs (π / 2 - φ)]
  rw [hcos]
  nlinarith [hlow, hsq]

/-- Near `π/2` the cosine is small. -/
theorem abs_cos_le_of_near {φ : ℝ} (h : |π / 2 - φ| ≤ 3 / 5) : |Real.cos φ| ≤ 3 / 5 := by
  have hsin : Real.cos φ = Real.sin (π / 2 - φ) := by
    rw [Real.sin_pi_div_two_sub]
  rw [hsin]
  refine le_trans ?_ h
  rcases le_or_gt 0 (π / 2 - φ) with hpos | hneg
  · rw [abs_of_nonneg hpos]
    have h1 : Real.sin (π / 2 - φ) ≤ π / 2 - φ := Real.sin_le hpos
    have h2 : -(π / 2 - φ) ≤ Real.sin (π / 2 - φ) := by
      rcases le_or_gt (π / 2 - φ) π with hle | hgt
      · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hpos hle
        linarith
      · have hm1 := Real.neg_one_le_sin (π / 2 - φ)
        have h1 : (1 : ℝ) ≤ π / 2 - φ := by linarith [Real.pi_gt_three]
        linarith
    rw [abs_le]
    exact ⟨h2, h1⟩
  · have hneg' : π / 2 - φ < 0 := hneg
    rw [abs_of_neg hneg']
    have hpos' : 0 ≤ -(π / 2 - φ) := by linarith
    have h1 : Real.sin (-(π / 2 - φ)) ≤ -(π / 2 - φ) := Real.sin_le hpos'
    have h2 : -(-(π / 2 - φ)) ≤ Real.sin (-(π / 2 - φ)) := by
      rcases le_or_gt (-(π / 2 - φ)) π with hle | hgt
      · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hpos' hle
        linarith
      · have hm1 := Real.neg_one_le_sin (-(π / 2 - φ))
        have h1 : (1 : ℝ) ≤ -(π / 2 - φ) := by linarith [Real.pi_gt_three]
        linarith
    rw [Real.sin_neg] at h1 h2
    rw [abs_le]
    constructor <;> linarith

/-! ### Exact identities for the phase -/

theorem abs_sin_le_abs_of_nonneg {x : ℝ} (hx : 0 ≤ x) : |Real.sin x| ≤ |x| := by
  rw [abs_of_nonneg hx]
  have hup : Real.sin x ≤ x := Real.sin_le hx
  have hlow : -x ≤ Real.sin x := by
    rcases le_or_gt x π with hle | hgt
    · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hx hle
      linarith
    · have hm1 := Real.neg_one_le_sin x
      have h1 : (1 : ℝ) ≤ x := by linarith [Real.pi_gt_three]
      linarith
  rw [abs_le]
  exact ⟨hlow, hup⟩

theorem abs_sin_le_abs (x : ℝ) : |Real.sin x| ≤ |x| := by
  rcases le_or_gt 0 x with hx | hx
  · exact abs_sin_le_abs_of_nonneg hx
  · have h := abs_sin_le_abs_of_nonneg (x := -x) (by linarith)
    rw [Real.sin_neg, abs_neg, abs_neg] at h
    exact h

theorem abs_sin_sub_sin_le (a b : ℝ) : |Real.sin a - Real.sin b| ≤ |a - b| := by
  rw [Real.sin_sub_sin, abs_mul, abs_mul]
  have h1 : |Real.sin ((a - b) / 2)| ≤ |(a - b) / 2| := abs_sin_le_abs _
  have h2 : |Real.cos ((a + b) / 2)| ≤ 1 := Real.abs_cos_le_one _
  have h2n : (2 : ℝ) = |(2 : ℝ)| := by norm_num
  have habs : |(a - b) / 2| = |a - b| / 2 := by
    rw [abs_div]
    norm_num
  calc |(2 : ℝ)| * |Real.sin ((a - b) / 2)| * |Real.cos ((a + b) / 2)|
      ≤ |(2 : ℝ)| * (|a - b| / 2) * 1 := by
        refine mul_le_mul (mul_le_mul_of_nonneg_left (habs ▸ h1) (abs_nonneg _)) h2
          (abs_nonneg _) (by positivity)
    _ = |a - b| := by
        rw [show |(2 : ℝ)| = 2 by norm_num]
        ring

theorem abs_cos_sub_cos_le (a b : ℝ) : |Real.cos a - Real.cos b| ≤ |a - b| := by
  rw [Real.cos_sub_cos, abs_mul, abs_mul, abs_neg]
  have h1 : |Real.sin ((a - b) / 2)| ≤ |(a - b) / 2| := abs_sin_le_abs _
  have h2 : |Real.sin ((a + b) / 2)| ≤ 1 := Real.abs_sin_le_one _
  have habs : |(a - b) / 2| = |a - b| / 2 := by
    rw [abs_div]
    norm_num
  calc |(2 : ℝ)| * |Real.sin ((a + b) / 2)| * |Real.sin ((a - b) / 2)|
      ≤ |(2 : ℝ)| * 1 * (|a - b| / 2) := by
        refine mul_le_mul (mul_le_mul_of_nonneg_left h2 (abs_nonneg _)) (habs ▸ h1)
          (abs_nonneg _) (by positivity)
    _ = |a - b| := by
        rw [show |(2 : ℝ)| = 2 by norm_num]
        ring

/-- The Pythagorean identity for the phase: `ψ'² + (ψ - εt)² = ‖u‖²`. -/
theorem sq_psi1_add_sq (u : Pl) (ε t φ : ℝ) :
    (psi1 u φ) ^ 2 + (psiu u ε t φ - ε * t) ^ 2 = ‖u‖ ^ 2 := by
  rw [psi1, psiu_eq, norm_sq_eq_coords]
  have h := Real.sin_sq_add_cos_sq φ
  nlinarith [h]

/-- The phase and its angular derivative are `‖u‖`-Lipschitz in the angle. -/
theorem abs_psiu_sub_le (u : Pl) (ε t φ φ' : ℝ) :
    |psiu u ε t φ - psiu u ε t φ'| ≤ ‖u‖ * |φ - φ'| := by
  obtain ⟨δ, hs, hc⟩ := exists_phase_shift u
  have h1 : psiu u ε t φ - psiu u ε t φ'
      = ‖u‖ * (Real.sin (φ + δ) - Real.sin (φ' + δ)) := by
    rw [psiu, psiu, hs φ, hs φ']
    ring
  rw [h1, abs_mul, abs_of_nonneg (norm_nonneg u)]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg u)
  have h2 := abs_sin_sub_sin_le (φ + δ) (φ' + δ)
  have h3 : (φ + δ) - (φ' + δ) = φ - φ' := by ring
  rw [h3] at h2
  exact h2

theorem abs_psi1_sub_le (u : Pl) (φ φ' : ℝ) :
    |psi1 u φ - psi1 u φ'| ≤ ‖u‖ * |φ - φ'| := by
  obtain ⟨δ, hs, hc⟩ := exists_phase_shift u
  have h1 : psi1 u φ - psi1 u φ' = ‖u‖ * (Real.cos (φ + δ) - Real.cos (φ' + δ)) := by
    rw [hc φ, hc φ']
    ring
  rw [h1, abs_mul, abs_of_nonneg (norm_nonneg u)]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg u)
  have h2 := abs_cos_sub_cos_le (φ + δ) (φ' + δ)
  have h3 : (φ + δ) - (φ' + δ) = φ - φ' := by ring
  rw [h3] at h2
  exact h2

/-- `‖u‖` is controlled by the phase and its derivative at any single angle. -/
theorem norm_le_psi (u : Pl) (ε t φ : ℝ) :
    ‖u‖ ≤ |psi1 u φ| + |psiu u ε t φ - ε * t| := by
  have h := sq_psi1_add_sq u ε t φ
  have h1 : (0 : ℝ) ≤ |psi1 u φ| := abs_nonneg _
  have h2 : (0 : ℝ) ≤ |psiu u ε t φ - ε * t| := abs_nonneg _
  have hsq : ‖u‖ ^ 2 ≤ (|psi1 u φ| + |psiu u ε t φ - ε * t|) ^ 2 := by
    rw [← h]
    nlinarith [sq_abs (psi1 u φ), sq_abs (psiu u ε t φ - ε * t), h1, h2]
  nlinarith [hsq, norm_nonneg u, h1, h2]

/-- **The reference identity.**  At the plate's reference angle, the angular derivative is
determined by `w + εt cos φ` and the value of the phase. -/
theorem psi1_ref_identity (w v ε t φ : ℝ) :
    psi1 (mk2 w v) φ * Real.sin φ
      = Real.cos φ * psiu (mk2 w v) ε t φ - (w + ε * t * Real.cos φ) := by
  rw [psi1_mk2, psiu_mk2]
  have h := Real.sin_sq_add_cos_sq φ
  linear_combination (-w) * h

/-! ### Mean value bounds on a plate -/

/-- The phase varies over an interval by at most the length times a bound for its derivative. -/
theorem abs_psiu_sub_le_of_bound (u : Pl) (ε t : ℝ) {a b K : ℝ}
    (hK : ∀ φ ∈ Set.Icc a b, |psi1 u φ| ≤ K) {φ φ' : ℝ}
    (hφ : φ ∈ Set.Icc a b) (hφ' : φ' ∈ Set.Icc a b) :
    |psiu u ε t φ - psiu u ε t φ'| ≤ K * |φ - φ'| := by
  have hconv : Convex ℝ (Set.Icc a b) := convex_Icc a b
  have hderiv : ∀ x ∈ Set.Icc a b,
      HasDerivWithinAt (psiu u ε t) (psi1 u x) (Set.Icc a b) x := by
    intro x _
    exact (hasDerivAt_psiu u ε t x).hasDerivWithinAt
  have hbound : ∀ x ∈ Set.Icc a b, ‖psi1 u x‖ ≤ K := by
    intro x hx
    rw [Real.norm_eq_abs]
    exact hK x hx
  have h := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le hderiv hbound hφ' hφ
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at h
  calc |psiu u ε t φ - psiu u ε t φ'| = |psiu u ε t φ - psiu u ε t φ'| := rfl
    _ ≤ K * |φ - φ'| := h

/-- The same for the angular derivative. -/
theorem abs_psi1_sub_le_of_bound (u : Pl) (ε t : ℝ) {a b K : ℝ}
    (hK : ∀ φ ∈ Set.Icc a b, |psi2 u φ| ≤ K) {φ φ' : ℝ}
    (hφ : φ ∈ Set.Icc a b) (hφ' : φ' ∈ Set.Icc a b) :
    |psi1 u φ - psi1 u φ'| ≤ K * |φ - φ'| := by
  have hconv : Convex ℝ (Set.Icc a b) := convex_Icc a b
  have hderiv : ∀ x ∈ Set.Icc a b,
      HasDerivWithinAt (psi1 u) (psi2 u x) (Set.Icc a b) x := by
    intro x _
    exact (hasDerivAt_psi1 u x).hasDerivWithinAt
  have hbound : ∀ x ∈ Set.Icc a b, ‖psi2 u x‖ ≤ K := by
    intro x hx
    rw [Real.norm_eq_abs]
    exact hK x hx
  have h := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le hderiv hbound hφ' hφ
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at h
  exact h

/-! ### The plate bounds for a far plate -/

/-- The reference angle of the plate `ν`. -/
def plAng (M : ℕ) (ν : ℤ) : ℝ := (ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))

/-- The `v`-independent size parameter of the plate `ν`: it measures how far the plate is from the
angular resonance. -/
def plA (M : ℕ) (ν : ℤ) (ε t w : ℝ) : ℝ := w + ε * t * Real.cos (plAng M ν)

theorem plAng_add (M : ℕ) (ν : ℤ) :
    plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ)) = ((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)) := by
  rw [plAng]
  ring

/-- **The plate bounds.**  On a far plate, in the `v`-region where the phase is small compared with
the plate parameter `A`, all the quantities entering the two routes are comparable to `|A|`. -/
theorem plate_bounds_far {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |plA M ν ε t w| / 3 ≤ |psi1 (mk2 w v) φ|)
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psi2 (mk2 w v) φ| ≤ 3 + 24 * (|plA M ν ε t w| / 3))
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psi1 (mk2 w v) φ| ≤ 8 * (|plA M ν ε t w| / 3))
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psiu (mk2 w v) ε t (plAng M ν)| - 6 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|
          ≤ |psiu (mk2 w v) ε t φ|) := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφν
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hQA : Q ≤ |A| / 100 := by linarith [hA]
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsin1 : Real.sin φν ≤ 1 := Real.sin_le_one φν
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  -- the reference identity
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * psiu u ε t φν - A := by
    rw [hu, hAdef, plA, ← hφν]
    exact psi1_ref_identity w v ε t φν
  have habsq : |Real.cos φν * psiu u ε t φν| ≤ 3 / 5 * (|A| / 2) := by
    rw [abs_mul]
    exact mul_le_mul hcos hreg (abs_nonneg _) (by norm_num)
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * psiu u ε t φν - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_low : |A| / 2 ≤ |psi1 u φν| := by
    have h6 : |A| - |Real.cos φν * psiu u ε t φν|
        ≤ |Real.cos φν * psiu u ε t φν - A| := by
      have h7 := abs_sub_abs_le_abs_sub A (Real.cos φν * psiu u ε t φν)
      rw [abs_sub_comm A (Real.cos φν * psiu u ε t φν)] at h7
      linarith
    have h9 : |A| - 3 / 5 * (|A| / 2) ≤ |psi1 u φν| * Real.sin φν := by
      rw [hpsin]
      linarith
    have h10 : |psi1 u φν| * Real.sin φν ≤ |psi1 u φν| := by
      calc |psi1 u φν| * Real.sin φν ≤ |psi1 u φν| * 1 :=
            mul_le_mul_of_nonneg_left hsin1 (abs_nonneg _)
        _ = |psi1 u φν| := mul_one _
    linarith
  have hpp_up : |psi1 u φν| ≤ 2 * |A| := by
    have h1 : |Real.cos φν * psiu u ε t φν - A| ≤ 3 / 5 * (|A| / 2) + |A| := by
      have h3 := abs_sub (Real.cos φν * psiu u ε t φν) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    linarith
  -- the size of `u`
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 3 * |A| + 2 := by
    have h := norm_le_psi u ε t φν
    have h2 : |psiu u ε t φν - ε * t| ≤ |A| / 2 + 2 := by
      have h3 := abs_sub (psiu u ε t φν) (ε * t)
      linarith
    linarith [hpp_up]
  -- the Lipschitz bounds on the plate
  have hlip : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |φ - φν| ≤ 2 * Q := by
    intro φ hφ
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have hslack : ∀ φ ∈ Set.Icc φν (φν + 2 * Q),
      |psiu u ε t φ - psiu u ε t φν| ≤ 6 * Q * |A| + 4 * Q := by
    intro φ hφ
    have h := abs_psiu_sub_le u ε t φ φν
    calc |psiu u ε t φ - psiu u ε t φν| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (3 * |A| + 2) * (2 * Q) :=
          mul_le_mul hnorm (hlip φ hφ) (abs_nonneg _) (by positivity)
      _ = 6 * Q * |A| + 4 * Q := by ring
  have hslack1 : ∀ φ ∈ Set.Icc φν (φν + 2 * Q),
      |psi1 u φ - psi1 u φν| ≤ 6 * Q * |A| + 4 * Q := by
    intro φ hφ
    have h := abs_psi1_sub_le u φ φν
    calc |psi1 u φ - psi1 u φν| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (3 * |A| + 2) * (2 * Q) :=
          mul_le_mul hnorm (hlip φ hφ) (abs_nonneg _) (by positivity)
      _ = 6 * Q * |A| + 4 * Q := by ring
  have hsmall : 6 * Q * |A| + 4 * Q ≤ |A| / 10 := by
    have h1 : 6 * Q * |A| ≤ 6 / 100 * |A| := by
      have := mul_le_mul_of_nonneg_right hQ (le_of_lt hApos)
      linarith
    have h2 : 4 * Q ≤ 4 / 100 * |A| := by linarith [hQA]
    linarith
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- the lower bound for the angular derivative
    intro φ hφ
    have h1 := hslack1 φ hφ
    have h2 : |psi1 u φν| - |psi1 u φ - psi1 u φν| ≤ |psi1 u φ| := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φν) (psi1 u φ)
      rw [abs_sub_comm (psi1 u φν) (psi1 u φ)] at h3
      linarith
    have hgoal : |A| / 3 ≤ |psi1 u φν| - (6 * Q * |A| + 4 * Q) := by
      linarith [hpp_low, hsmall]
    linarith
  · -- the bound for the second derivative
    intro φ hφ
    have h1 := hslack φ hφ
    have h2 : |psiu u ε t φ| ≤ |psiu u ε t φν| + (6 * Q * |A| + 4 * Q) := by
      have h3 := abs_sub_abs_le_abs_sub (psiu u ε t φ) (psiu u ε t φν)
      linarith
    have h4 : |psi2 u φ| ≤ |ε * t| + |psiu u ε t φ| := by
      rw [psi2_eq u ε t φ]
      exact abs_sub _ _
    have h5 : |psiu u ε t φ| ≤ |A| / 2 + |A| / 10 := by linarith [hreg, hsmall]
    linarith [hApos]
  · -- the upper bound for the angular derivative
    intro φ hφ
    have h1 := hslack1 φ hφ
    have h2 : |psi1 u φ| ≤ |psi1 u φν| + (6 * Q * |A| + 4 * Q) := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
      linarith
    linarith [hpp_up, hsmall]
  · -- the sharper lower bound for the phase, from the mean value theorem on the plate
    have hK : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |psi1 u φ| ≤ 8 * (|A| / 3) := by
      intro φ hφ
      have h1 := hslack1 φ hφ
      have h2 : |psi1 u φ| ≤ |psi1 u φν| + (6 * Q * |A| + 4 * Q) := by
        have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
        linarith
      linarith [hpp_up, hsmall]
    intro φ hφ
    have hmvt := abs_psiu_sub_le_of_bound u ε t hK hφ
      (Set.left_mem_Icc.mpr (by linarith [hQpos]))
    have hlipφ := hlip φ hφ
    have h1 : |psiu u ε t φ - psiu u ε t φν| ≤ 6 * Q * |A| := by
      calc |psiu u ε t φ - psiu u ε t φν| ≤ 8 * (|A| / 3) * |φ - φν| := hmvt
        _ ≤ 8 * (|A| / 3) * (2 * Q) := by
            refine mul_le_mul_of_nonneg_left hlipφ (by positivity)
        _ ≤ 6 * Q * |A| := by
            nlinarith [hQpos, hApos]
    have h2 : |psiu u ε t φν| - |psiu u ε t φ - psiu u ε t φν| ≤ |psiu u ε t φ| := by
      have h3 := abs_sub_abs_le_abs_sub (psiu u ε t φν) (psiu u ε t φ)
      rw [abs_sub_comm (psiu u ε t φν) (psiu u ε t φ)] at h3
      linarith
    linarith

/-! ### The combined bound on a far plate -/

set_option maxHeartbeats 1000000 in
/-- **The combined bound for a far plate.**  In the `v`-region where the phase is at most half the
plate parameter, the geometric mean of the capped radial bound and the angular bound gives a bound
that decays like `(1+2^j μ)^{-2}` in the phase and like `|A|^{-1}` in the plate. -/
theorem norm_kernPlate_far_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 4000 * stC * B0 * (2 : ℝ) ^ (j : ℤ)
          * (1 + (2 : ℝ) ^ (j : ℤ) * max 0 (|psiu (mk2 w v) ε t (plAng M ν)|
              - 6 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|))⁻¹ ^ 2
          / |plA M ν ε t w| := by
  obtain ⟨hb1, hb2, hb3, hb4⟩ := plate_bounds_far hε ht1 ht2 hQ hang hA hreg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t (plAng M ν) with hq
  set slack : ℝ := 6 * Q * |A| with hslackdef
  set mu : ℝ := max 0 (|q| - slack) with hmudef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hmunn : (0 : ℝ) ≤ mu := le_max_left _ _
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hplate : Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q)
      = Set.Icc (plAng M ν) (plAng M ν + 2 * Q) := by
    rw [plAng_add M ν, plAng]
  -- the angular route
  have hang_bd : ‖kernPlate j ε m t u M ν‖ ≤ 3200 * stC * B0 * P / (|A| / 3) ^ 2 := by
    refine norm_kernPlate_le_angular hp hm ε t u hM hν hνB (by positivity) ?_ ?_ ?_ ?_
    · -- `Q ≤ |A|/3`
      linarith [hA]
    · rw [hplate]
      exact hb1
    · rw [hplate]
      exact hb2
    · rw [hplate]
      intro φ hφ
      have h := hb3 φ hφ
      rw [psi3_eq_neg u φ, abs_neg]
      exact h
  -- the capped radial route
  have hrad_bd : ‖kernPlate j ε m t u M ν‖ ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
      * (1 + J * mu)⁻¹ ^ 4 := by
    refine norm_kernPlate_le_capped hp hm ε t u M ν hmunn ?_
    rw [hplate]
    intro φ hφ
    rcases le_or_gt (|q| - slack) 0 with hle | hgt
    · have : mu = 0 := by
        rw [hmudef, max_eq_left hle]
      rw [this]
      exact abs_nonneg _
    · have : mu = |q| - slack := by
        rw [hmudef, max_eq_right (le_of_lt hgt)]
      rw [this]
      exact hb4 φ hφ
  -- combine
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  rw [hJ2] at hrad_bd
  refine le_of_sq_le_mul (norm_nonneg _) (by positivity) hrad_bd hang_bd ?_
  -- the numerical inequality
  have hinvpos : (0 : ℝ) < 1 + J * mu := by positivity
  have hsq : ((1 + J * mu)⁻¹ ^ 4) = ((1 + J * mu)⁻¹ ^ 2) ^ 2 := by ring
  have hstC2 : stC ≤ stC ^ 2 := by nlinarith [hstC]
  have hlhs : 512 * Q * B0 * J ^ 2 * (1 + J * mu)⁻¹ ^ 4 * (3200 * stC * B0 * P / (|A| / 3) ^ 2)
      = 14745600 * (P * Q) * stC * B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 / |A| ^ 2 := by
    rw [hsq]
    field_simp
    ring
  have hrhs : (4000 * stC * B0 * J * (1 + J * mu)⁻¹ ^ 2 / |A|) ^ 2
      = 16000000 * stC ^ 2 * B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 / |A| ^ 2 := by
    field_simp
    ring
  rw [hlhs, hrhs, hPQ]
  refine div_le_div_of_nonneg_right ?_ (by positivity)
  have hfac : (0 : ℝ) ≤ B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 := by positivity
  nlinarith [hstC2, hfac, mul_le_mul_of_nonneg_right hstC2 hfac]

/-! ### The one-dimensional integral of the capped bound -/

/-- The integral of the capped quadratic bump: the flat part contributes the length of the
`slack`-neighbourhood, the decaying part contributes `O(1/A)`. -/
theorem integral_capped_le {A a b slack : ℝ} (hA : 0 < A) (ha : 4 / 5 ≤ a)
    (hslack : 0 ≤ slack) :
    Integrable (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2)
      ∧ (∫ v : ℝ, (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) ≤ 5 * slack + 5 * π / A := by
  have hapos : (0 : ℝ) < a := by linarith
  set c : ℝ := A / 2 * a with hc
  have hcpos : (0 : ℝ) < c := by rw [hc]; positivity
  set S : Set ℝ := Set.Icc ((-(2 * slack) - b) / a) ((2 * slack - b) / a) with hS
  set g1 : ℝ → ℝ := S.indicator (fun _ => (1 : ℝ)) with hg1
  set g2 : ℝ → ℝ := fun v => 2 * (1 + (c * v + A / 2 * b) ^ 2)⁻¹ with hg2
  -- the majorant
  have hmaj : ∀ v : ℝ, (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 ≤ g1 v + g2 v := by
    intro v
    have hg2nn : (0 : ℝ) ≤ g2 v := by
      rw [hg2]
      positivity
    have hg1nn : (0 : ℝ) ≤ g1 v := by
      rw [hg1]
      refine Set.indicator_nonneg ?_ v
      intro x _
      norm_num
    rcases le_or_gt (|a * v + b|) (2 * slack) with hcase | hcase
    · -- the flat part
      have hmem : v ∈ S := by
        rw [hS, Set.mem_Icc]
        have h := abs_le.mp hcase
        constructor
        · rw [div_le_iff₀ hapos]
          linarith [h.1]
        · rw [le_div_iff₀ hapos]
          linarith [h.2]
      have hone : g1 v = 1 := by
        rw [hg1, Set.indicator_of_mem hmem]
      have hnn : (0 : ℝ) ≤ A * max 0 (|a * v + b| - slack) := by
        have : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
        positivity
      have hle : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 ≤ 1 := by
        have h1 : (1 : ℝ) ≤ 1 + A * max 0 (|a * v + b| - slack) := by linarith
        have h2 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ≤ 1 := by
          rw [inv_le_one_iff₀]
          right
          exact h1
        have h3 : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ := by positivity
        nlinarith [h2, h3]
      linarith
    · -- the decaying part
      have hmaxeq : max 0 (|a * v + b| - slack) = |a * v + b| - slack := by
        refine max_eq_right ?_
        linarith
      have hhalf : |a * v + b| / 2 ≤ |a * v + b| - slack := by linarith
      have h1 : 1 + A / 2 * |a * v + b| ≤ 1 + A * max 0 (|a * v + b| - slack) := by
        rw [hmaxeq]
        nlinarith [hhalf, hA]
      have h2 : (0 : ℝ) < 1 + A / 2 * |a * v + b| := by positivity
      have h3 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2
          ≤ (1 + A / 2 * |a * v + b|)⁻¹ ^ 2 := by
        have h4 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ≤ (1 + A / 2 * |a * v + b|)⁻¹ :=
          inv_anti₀ h2 h1
        have h5 : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ := by positivity
        nlinarith [h4, h5]
      have h6 : (1 + A / 2 * |a * v + b|)⁻¹ ^ 2 ≤ g2 v := by
        have hg2v : g2 v = 2 * (1 + (c * v + A / 2 * b) ^ 2)⁻¹ := rfl
        set y : ℝ := A / 2 * |a * v + b| with hy
        have hynn : (0 : ℝ) ≤ y := by
          rw [hy]
          positivity
        have hsq : (c * v + A / 2 * b) ^ 2 = y ^ 2 := by
          rw [hy, hc, mul_pow, sq_abs]
          ring
        rw [hg2v, hsq, inv_pow]
        have hp1 : (0 : ℝ) < (1 + y) ^ 2 := by positivity
        have hp2 : (0 : ℝ) < 1 + y ^ 2 := by positivity
        rw [show (2 : ℝ) * (1 + y ^ 2)⁻¹ = 2 / (1 + y ^ 2) by rw [div_eq_mul_inv]]
        rw [inv_eq_one_div, div_le_div_iff₀ hp1 hp2]
        nlinarith [hynn]
      linarith
  -- integrability
  have hg1int : Integrable g1 := by
    rw [hg1, integrable_indicator_iff measurableSet_Icc]
    exact continuous_const.integrableOn_Icc
  have hg2int : Integrable g2 := by
    have hbase : Integrable fun x : ℝ => (1 + x ^ 2)⁻¹ := integrable_inv_one_add_sq
    have hshift : Integrable fun x : ℝ => (1 + (x + A / 2 * b) ^ 2)⁻¹ :=
      hbase.comp_add_right (A / 2 * b)
    have hscale : Integrable fun v : ℝ => (1 + (c * v + A / 2 * b) ^ 2)⁻¹ := by
      have h := hshift.comp_mul_left' (ne_of_gt hcpos)
      refine h.congr ?_
      filter_upwards with v
      ring_nf
    rw [hg2]
    exact hscale.const_mul 2
  have hnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 := by
    filter_upwards with v
    show (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2
    have : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    positivity
  have hgint : Integrable (fun v : ℝ => g1 v + g2 v) := hg1int.add hg2int
  have hcont : Continuous (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) := by
    have hinner : Continuous (fun v : ℝ => 1 + A * max 0 (|a * v + b| - slack)) := by
      refine continuous_const.add (continuous_const.mul ?_)
      refine continuous_const.max ?_
      refine Continuous.sub ?_ continuous_const
      exact continuous_abs.comp ((continuous_const.mul continuous_id).add continuous_const)
    refine Continuous.pow (Continuous.inv₀ hinner ?_) 2
    intro v
    have h0 : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    have h1 : (0 : ℝ) < 1 + A * max 0 (|a * v + b| - slack) := by positivity
    exact ne_of_gt h1
  have hFint : Integrable (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) := by
    refine Integrable.mono' hgint hcont.aestronglyMeasurable ?_
    filter_upwards with v
    have h0 : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    have hnnv : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 := by positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hnnv]
    exact hmaj v
  refine ⟨hFint, ?_⟩
  have hle := integral_mono_of_nonneg hnn hgint (Filter.Eventually.of_forall hmaj)
  refine le_trans hle ?_
  rw [integral_add hg1int hg2int]
  -- the two integrals
  have hI1 : (∫ v : ℝ, g1 v) ≤ 5 * slack := by
    have hlen : (2 * slack - b) / a - (-(2 * slack) - b) / a = 4 * slack / a := by
      field_simp
      ring
    rw [hg1, integral_indicator measurableSet_Icc, setIntegral_const, smul_eq_mul, mul_one,
      MeasureTheory.measureReal_def, Real.volume_Icc, hlen,
      ENNReal.toReal_ofReal (by positivity)]
    rw [div_le_iff₀ hapos]
    nlinarith [hslack, ha]
  have hI2 : (∫ v : ℝ, g2 v) ≤ 5 * π / A := by
    have hcomp : (∫ v : ℝ, (1 + (c * v + A / 2 * b) ^ 2)⁻¹) = c⁻¹ * π := by
      have hstep : (∫ v : ℝ, (1 + (c * v + A / 2 * b) ^ 2)⁻¹)
          = ∫ v : ℝ, (fun y : ℝ => (1 + (y + A / 2 * b) ^ 2)⁻¹) (c * v) := rfl
      rw [hstep, MeasureTheory.Measure.integral_comp_mul_left
        (fun y : ℝ => (1 + (y + A / 2 * b) ^ 2)⁻¹) c]
      rw [MeasureTheory.integral_add_right_eq_self (fun x : ℝ => (1 + x ^ 2)⁻¹) (A / 2 * b)]
      rw [integral_univ_inv_one_add_sq, smul_eq_mul,
        abs_of_pos (by positivity : (0 : ℝ) < c⁻¹)]
    rw [hg2, integral_const_mul, hcomp, hc]
    have hpi : (0 : ℝ) < π := Real.pi_pos
    have h1 : 2 * ((A / 2 * a)⁻¹ * π) = 4 * π / (A * a) := by
      field_simp
      ring
    rw [h1, div_le_div_iff₀ (by positivity) hA]
    have hkey : π * A * 4 ≤ π * A * (5 * a) :=
      mul_le_mul_of_nonneg_left (by linarith : (4 : ℝ) ≤ 5 * a)
        (le_of_lt (mul_pos hpi hA))
    nlinarith [hkey]
  linarith

/-! ### The far plate in the complementary region -/

/-- In the region where the phase at the reference angle is at least half the plate parameter, the
phase stays comparable to its reference value across the plate. -/
theorem plate_bounds_far2 {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg2 : |plA M ν ε t w| / 2 ≤ |psiu (mk2 w v) ε t (plAng M ν)|) :
    ∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
      |psiu (mk2 w v) ε t (plAng M ν)| / 2 ≤ |psiu (mk2 w v) ε t φ| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφν
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t φν with hq
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hqpos : (0 : ℝ) < |q| := lt_of_lt_of_le (by positivity) hreg2
  have hQq : Q ≤ |q| / 50 := by
    have h1 : 100 * Q ≤ |A| := hA
    have h2 : |A| ≤ 2 * |q| := by linarith
    linarith
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * q - A := by
    rw [hu, hAdef, plA, ← hφν, hq, hu]
    exact psi1_ref_identity w v ε t φν
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * q - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_up : |psi1 u φν| ≤ 4 * |q| := by
    have hcq : |Real.cos φν * q| ≤ 3 / 5 * |q| := by
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right hcos (abs_nonneg _)
    have h1 : |Real.cos φν * q - A| ≤ 3 / 5 * |q| + |A| := by
      have h3 := abs_sub (Real.cos φν * q) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    have h5 : |A| ≤ 2 * |q| := by linarith
    linarith
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 5 * |q| + 2 := by
    have h := norm_le_psi u ε t φν
    rw [← hq] at h
    have h2 : |q - ε * t| ≤ |q| + 2 := by
      have h3 := abs_sub q (ε * t)
      linarith
    linarith [hpp_up]
  intro φ hφ
  have hlipφ : |φ - φν| ≤ 2 * Q := by
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have h1 : |psiu u ε t φ - q| ≤ (5 * |q| + 2) * (2 * Q) := by
    have h := abs_psiu_sub_le u ε t φ φν
    rw [← hq] at h
    calc |psiu u ε t φ - q| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (5 * |q| + 2) * (2 * Q) :=
          mul_le_mul hnorm hlipφ (abs_nonneg _) (by positivity)
  have hsmall : (5 * |q| + 2) * (2 * Q) ≤ |q| / 2 := by
    have hA1 : 10 * Q * |q| ≤ 10 / 100 * |q| := by
      have := mul_le_mul_of_nonneg_right hQ (le_of_lt hqpos)
      linarith
    have hA2 : 4 * Q ≤ 4 / 50 * |q| := by linarith [hQq]
    nlinarith [hA1, hA2, hqpos]
  have h2 : |q| - |psiu u ε t φ - q| ≤ |psiu u ε t φ| := by
    have h3 := abs_sub_abs_le_abs_sub q (psiu u ε t φ)
    rw [abs_sub_comm q (psiu u ε t φ)] at h3
    linarith
  linarith

/-- **The far plate in the complementary region.**  Only the capped radial route is needed. -/
theorem norm_kernPlate_far2_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg2 : |plA M ν ε t w| / 2 ≤ |psiu (mk2 w v) ε t (plAng M ν)|) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
          * (1 + (2 : ℝ) ^ (j : ℤ) * (|psiu (mk2 w v) ε t (plAng M ν)| / 2))⁻¹ ^ 4 := by
  have hb := plate_bounds_far2 hε ht1 ht2 hQ hang hA hreg2
  refine norm_kernPlate_le_capped hp hm ε t (mk2 w v) M ν (by positivity) ?_
  have hplate : Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
      (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
      = Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))) := by
    rw [plAng_add M ν, plAng]
  rw [hplate]
  exact hb

/-! ### The pointwise majorant on a far plate -/

/-- The angular bound on a far plate, in the region where the phase is small. -/
theorem norm_kernPlate_ang_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 28800 * stC * B0 * (2 : ℝ) ^ M / |plA M ν ε t w| ^ 2 := by
  obtain ⟨hb1, hb2, hb3, hb4⟩ := plate_bounds_far hε ht1 ht2 hQ hang hA hreg
  have hApos : (0 : ℝ) < |plA M ν ε t w| := lt_of_lt_of_le (by positivity) hA
  have hplate : Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
      (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
      = Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))) := by
    rw [plAng_add M ν, plAng]
  have h := norm_kernPlate_le_angular hp hm ε t (mk2 w v) hM hν hνB
    (by positivity : (0 : ℝ) < |plA M ν ε t w| / 3) (by linarith [hA])
    (by rw [hplate]; exact hb1) (by rw [hplate]; exact hb2)
    (by
      rw [hplate]
      intro φ hφ
      have h3 := hb3 φ hφ
      rw [psi3_eq_neg (mk2 w v) φ, abs_neg]
      exact h3)
  refine le_trans h (le_of_eq ?_)
  field_simp
  ring

set_option maxHeartbeats 2000000 in
/-- **The pointwise majorant on a far plate.**  Three regions: the flat core (angular bound), the
intermediate region (the combined bound), and the far region (capped radial bound).  All three are
dominated by the sum of two capped quadratic bumps. -/
theorem norm_kernPlate_far_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|) (v : ℝ) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 28800 * stC * B0 * (2 : ℝ) ^ M / |plA M ν ε t w| ^ 2
          * (1 + (2 : ℝ) ^ (j : ℤ)
              * max 0 (|psiu (mk2 w v) ε t (plAng M ν)|
                  - 12 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|))⁻¹ ^ 2
        + (4000 * stC * B0 * (2 : ℝ) ^ (j : ℤ) / |plA M ν ε t w|
            + 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * (1 + (2 : ℝ) ^ (j : ℤ) * (|plA M ν ε t w| / 4))⁻¹ ^ 2)
          * (1 + (2 : ℝ) ^ (j : ℤ) / 2
              * max 0 (|psiu (mk2 w v) ε t (plAng M ν)| - 0))⁻¹ ^ 2 := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set q : ℝ := psiu (mk2 w v) ε t (plAng M ν) with hqdef
  set Ab : ℝ := 28800 * stC * B0 * P / |A| ^ 2 with hAbdef
  set C1 : ℝ := 4000 * stC * B0 * J / |A| with hC1def
  set D1 : ℝ := 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2 with hD1def
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hAbnn : (0 : ℝ) ≤ Ab := by
    rw [hAbdef]
    positivity
  have hC1nn : (0 : ℝ) ≤ C1 := by
    rw [hC1def]
    positivity
  have hD1nn : (0 : ℝ) ≤ D1 := by
    rw [hD1def]
    positivity
  have hqnn : (0 : ℝ) ≤ |q| := abs_nonneg _
  have hqabs : (0 : ℝ) ≤ |A| := le_of_lt hApos
  clear_value Ab C1 D1
  have hzero : max 0 (|q| - 0) = |q| := by
    rw [sub_zero, max_eq_right hqnn]
  have hterm2nn : (0 : ℝ) ≤ (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
    have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
    positivity
  have hterm1nn : (0 : ℝ) ≤ Ab * (1 + J * max 0 (|q| - 12 * Q * |A|))⁻¹ ^ 2 := by
    have h : (0 : ℝ) ≤ max 0 (|q| - 12 * Q * |A|) := le_max_left _ _
    positivity
  rcases le_or_gt (|q|) (12 * Q * |A|) with hcase1 | hcase1
  · -- the flat core: the angular bound, and the first majorant is exactly `Ab`
    have hreg : |q| ≤ |A| / 2 := by
      have h1 : 12 * Q * |A| ≤ |A| / 2 := by
        have h2 : 12 * Q ≤ 12 / 100 := by linarith
        nlinarith [hApos, h2]
      linarith
    have hangb := norm_kernPlate_ang_le hp hm hε ht1 ht2 hM hQ hν hνB hang hA hreg
    have hmax : max 0 (|q| - 12 * Q * |A|) = 0 := max_eq_left (by linarith)
    have heq : Ab * (1 + J * max 0 (|q| - 12 * Q * |A|))⁻¹ ^ 2 = Ab := by
      rw [hmax]
      norm_num
    rw [heq]
    linarith [hangb, hterm2nn]
  · rcases le_or_gt (|q|) (|A| / 2) with hcase2 | hcase2
    · -- the intermediate region: the combined bound
      have hcomb := norm_kernPlate_far_le hp hm hε ht1 ht2 hM hQ hν hνB hang hA hcase2
      have hmu : |q| / 2 ≤ max 0 (|q| - 6 * Q * |A|) := by
        have h1 : 6 * Q * |A| ≤ |q| / 2 := by
          nlinarith [hcase1, hQpos, hApos]
        have h2 : |q| / 2 ≤ |q| - 6 * Q * |A| := by linarith
        exact le_trans h2 (le_max_right _ _)
      have hmono : (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2
          ≤ (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        rw [hzero]
        have h1 : 1 + J / 2 * |q| ≤ 1 + J * max 0 (|q| - 6 * Q * |A|) := by
          nlinarith [hmu, hJpos]
        have h2 : (0 : ℝ) < 1 + J / 2 * |q| := by positivity
        have h3 := inv_anti₀ h2 h1
        have h4 : (0 : ℝ) ≤ (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ := by
          have h5 : (0 : ℝ) ≤ max 0 (|q| - 6 * Q * |A|) := le_max_left _ _
          positivity
        nlinarith [h3, h4]
      have hbd : ‖kernPlate j ε m t (mk2 w v) M ν‖
          ≤ C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        refine le_trans hcomb ?_
        have heq : 4000 * stC * B0 * J
              * (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2 / |A|
            = C1 * (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2 := by
          rw [hC1def]
          field_simp
        rw [heq]
        exact mul_le_mul_of_nonneg_left hmono hC1nn
      have hD1term : (0 : ℝ) ≤ D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
        positivity
      have hsplit : (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
          = C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
            + D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      rw [hsplit]
      linarith [hbd, hterm1nn, hD1term]
    · -- the far region: the capped radial bound
      have hcap := norm_kernPlate_far2_le hp hm hε ht1 ht2 hQ hang hA (le_of_lt hcase2)
      have hfac : (1 + J * (|q| / 2))⁻¹ ^ 4
          ≤ (1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        rw [hzero]
        have h1 : 1 + J * (|A| / 4) ≤ 1 + J * (|q| / 2) := by
          nlinarith [hcase2, hJpos]
        have h2 : (0 : ℝ) < 1 + J * (|A| / 4) := by positivity
        have h3 : (0 : ℝ) < 1 + J * (|q| / 2) := by positivity
        have h4 := inv_anti₀ h2 h1
        have h5 : (1 + J * (|q| / 2))⁻¹ ^ 2 ≤ (1 + J * (|A| / 4))⁻¹ ^ 2 := by
          have h6 : (0 : ℝ) ≤ (1 + J * (|q| / 2))⁻¹ := by positivity
          nlinarith [h4, h6]
        have h7 : (1 + J / 2 * |q|) = (1 + J * (|q| / 2)) := by ring
        rw [h7]
        have h8 : (1 + J * (|q| / 2))⁻¹ ^ 4
            = (1 + J * (|q| / 2))⁻¹ ^ 2 * (1 + J * (|q| / 2))⁻¹ ^ 2 := by ring
        rw [h8]
        refine mul_le_mul h5 (le_refl _) (by positivity) (by positivity)
      have hbd : ‖kernPlate j ε m t (mk2 w v) M ν‖
          ≤ D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        refine le_trans hcap ?_
        rw [hD1def]
        have hfac2 : 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|q| / 2))⁻¹ ^ 4
            ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * ((1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2) :=
          mul_le_mul_of_nonneg_left hfac (by positivity)
        calc 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|q| / 2))⁻¹ ^ 4
            ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * ((1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2) := hfac2
          _ = 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
              * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      have hC1term : (0 : ℝ) ≤ C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
        positivity
      have hsplit : (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
          = C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
            + D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      rw [hsplit]
      linarith [hbd, hterm1nn, hC1term]

/-! ### The `v`-integral over a far plate -/

set_option maxHeartbeats 2000000 in
/-- **The far plate contributes `stC·B₀/|A|`.**  Integrating the pointwise majorant in the second
coordinate: the flat core contributes `2^{-M}|A|` times the angular bound, and the two decaying
pieces contribute `2^{-j}` times their peaks. -/
theorem exists_far_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 100000000 * stC * B0 / |plA M ν ε t w| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set φν : ℝ := plAng M ν with hφνdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hJ1 : (1 : ℝ) ≤ J := by
    rw [hJdef, zpow_natCast]
    exact one_le_pow₀ (by norm_num)
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hP2J : P ^ 2 ≤ 16384 * J := by
    rw [hPdef, hJdef]
    have h1 : ((2 : ℝ) ^ M) ^ 2 = (2 : ℝ) ^ (((2 * M : ℕ) : ℤ)) := by
      rw [zpow_natCast, ← pow_mul]
      ring_nf
    have h2 : (16384 : ℝ) * (2 : ℝ) ^ (j : ℤ) = (2 : ℝ) ^ ((j : ℤ) + 14) := by
      rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
      ring
    rw [h1, h2]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    push_cast
    omega
  have hAinv : (1 : ℝ) / |A| ≤ P / 100 := by
    rw [div_le_div_iff₀ hApos (by norm_num)]
    have h1 : 100 * Q ≤ |A| := hA
    have h2 : P * (100 * Q) ≤ P * |A| := mul_le_mul_of_nonneg_left h1 (le_of_lt hPpos)
    rw [show P * (100 * Q) = 100 * (P * Q) by ring, hPQ] at h2
    linarith
  -- the affine form of the phase
  set a : ℝ := Real.sin φν with hadef
  set b : ℝ := w * Real.cos φν + ε * t with hbdef
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have ha : (4 : ℝ) / 5 ≤ a := by
    rw [hadef]
    exact sin_ge_of_near hangle
  have hqaff : ∀ v : ℝ, psiu (mk2 w v) ε t φν = a * v + b := by
    intro v
    rw [hadef, hbdef, hφνdef, psiu_mk2]
    ring
  -- the two constants
  set T1 : ℝ := 28800 * stC * B0 * P / |A| ^ 2 with hT1def
  set T2 : ℝ := 4000 * stC * B0 * J / |A|
    + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2 with hT2def
  have hT1nn : (0 : ℝ) ≤ T1 := by
    rw [hT1def]
    positivity
  have hT2nn : (0 : ℝ) ≤ T2 := by
    rw [hT2def]
    positivity
  -- the majorant
  set G : ℝ → ℝ := fun v =>
    T1 * (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2
      + T2 * (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 with hGdef
  have hmaj : ∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v := by
    intro v
    have h := norm_kernPlate_far_majorant hp hm hε ht1 ht2 hM hQ hν hνB hang hA v
    rw [hqaff v] at h
    exact h
  -- the two capped integrals
  obtain ⟨hint1, hbd1⟩ := integral_capped_le (A := J) (a := a) (b := b)
    (slack := 12 * Q * |A|) hJpos ha (by positivity)
  obtain ⟨hint2, hbd2⟩ := integral_capped_le (A := J / 2) (a := a) (b := b) (slack := 0)
    (by positivity) ha (le_refl 0)
  have hGint : Integrable G := by
    rw [hGdef]
    exact (hint1.const_mul T1).add (hint2.const_mul T2)
  have hGnn : ∀ v : ℝ, (0 : ℝ) ≤ G v := by
    intro v
    rw [hGdef]
    have h1 : (0 : ℝ) ≤ max 0 (|a * v + b| - 12 * Q * |A|) := le_max_left _ _
    have h2 : (0 : ℝ) ≤ max 0 (|a * v + b| - 0) := le_max_left _ _
    have h3 : (0 : ℝ) ≤ (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2 := by positivity
    have h4 : (0 : ℝ) ≤ (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 := by positivity
    have h5 : (0 : ℝ) ≤ T1 * (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2 :=
      mul_nonneg hT1nn h3
    have h6 : (0 : ℝ) ≤ T2 * (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 :=
      mul_nonneg hT2nn h4
    linarith
  -- the integral of the majorant
  have hGbd : (∫ v : ℝ, G v) ≤ T1 * (5 * (12 * Q * |A|) + 5 * π / J)
      + T2 * (5 * 0 + 5 * π / (J / 2)) := by
    rw [hGdef, integral_add (hint1.const_mul T1) (hint2.const_mul T2),
      integral_const_mul, integral_const_mul]
    refine add_le_add (mul_le_mul_of_nonneg_left hbd1 hT1nn)
      (mul_le_mul_of_nonneg_left hbd2 hT2nn)
  -- the numerical estimate
  have hnum : T1 * (5 * (12 * Q * |A|) + 5 * π / J) + T2 * (5 * 0 + 5 * π / (J / 2))
      ≤ 100000000 * (stC * B0 / |A|) := by
    have hpi : π ≤ 4 := Real.pi_le_four
    have hpipos : (0 : ℝ) < π := Real.pi_pos
    have hXnn : (0 : ℝ) ≤ stC * B0 / |A| := by positivity
    -- first term
    have e1 : T1 * (5 * (12 * Q * |A|)) = 1728000 * stC * B0 * (P * Q) / |A| := by
      rw [hT1def]
      field_simp
      ring
    have e1' : T1 * (5 * (12 * Q * |A|)) = 1728000 * (stC * B0 / |A|) := by
      rw [e1, hPQ]
      ring
    -- second term
    have e2 : T1 * (5 * π / J) = 144000 * π * stC * B0 * P / (|A| ^ 2 * J) := by
      rw [hT1def]
      field_simp
      ring
    have e2' : T1 * (5 * π / J) ≤ 80000000 * (stC * B0 / |A|) := by
      rw [e2]
      have hstep : P / (|A| ^ 2 * J) ≤ 16384 / (100 * |A|) := by
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        have h4 : 100 ≤ |A| * P := by
          rw [div_le_div_iff₀ hApos (by norm_num)] at hAinv
          linarith
        have h5 : P ^ 2 ≤ 16384 * J := hP2J
        have h6 : |A| ^ 2 * P ^ 2 ≤ |A| ^ 2 * (16384 * J) :=
          mul_le_mul_of_nonneg_left h5 (sq_nonneg _)
        have h7 : 100 * (|A| * P) ≤ (|A| * P) * (|A| * P) := by nlinarith [h4]
        nlinarith [h6, h7]
      have h7 : 144000 * π * stC * B0 * P / (|A| ^ 2 * J)
          = 144000 * π * stC * B0 * (P / (|A| ^ 2 * J)) := by ring
      rw [h7]
      have h6 : 144000 * π * stC * B0 * (P / (|A| ^ 2 * J))
          ≤ 144000 * π * stC * B0 * (16384 / (100 * |A|)) :=
        mul_le_mul_of_nonneg_left hstep (by positivity)
      refine le_trans h6 ?_
      have h8 : 144000 * π * stC * B0 * (16384 / (100 * |A|))
          = 23592960 * π * (stC * B0 / |A|) := by
        field_simp
        ring
      rw [h8]
      have h9 : 23592960 * π ≤ 80000000 := by
        have hpi : π ≤ 3.15 := le_of_lt Real.pi_lt_d2
        nlinarith [hpi]
      exact mul_le_mul_of_nonneg_right h9 hXnn
    -- third term
    have e3 : T2 * (5 * 0 + 5 * π / (J / 2)) = T2 * (10 * π / J) := by
      have h : 5 * π / (J / 2) = 10 * π / J := by
        field_simp
        ring
      rw [h]
      ring
    have e3' : T2 * (10 * π / J) ≤ 250000 * (stC * B0 / |A|) := by
      rw [hT2def]
      have hsplit : (4000 * stC * B0 * J / |A|
            + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2)
            * (10 * π / J)
          = 4000 * stC * B0 * J / |A| * (10 * π / J)
            + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
              * (10 * π / J) := by ring
      rw [hsplit]
      have hfirst : 4000 * stC * B0 * J / |A| * (10 * π / J)
          = 40000 * π * (stC * B0 / |A|) := by
        field_simp
        ring
      have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
        rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
        congr 1
        push_cast
        ring
      have hinvbd : (1 + J * (|A| / 4))⁻¹ ^ 2 ≤ 16 / (J ^ 2 * |A| ^ 2) := by
        have h1 : J * (|A| / 4) ≤ 1 + J * (|A| / 4) := by linarith
        have h2 : (0 : ℝ) < J * (|A| / 4) := by positivity
        have h3 : (1 + J * (|A| / 4))⁻¹ ≤ (J * (|A| / 4))⁻¹ := inv_anti₀ h2 h1
        have h4 : (0 : ℝ) ≤ (1 + J * (|A| / 4))⁻¹ := by positivity
        have h5 : (1 + J * (|A| / 4))⁻¹ ^ 2 ≤ ((J * (|A| / 4))⁻¹) ^ 2 :=
          pow_le_pow_left₀ h4 h3 2
        refine le_trans h5 (le_of_eq ?_)
        field_simp
        ring
      have hsecond : 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
            * (10 * π / J)
          ≤ 512 * Q * B0 * J ^ 2 * (16 / (J ^ 2 * |A| ^ 2)) * (10 * π / J) := by
        rw [hJ2]
        refine mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hinvbd (by positivity)) (by positivity)
      have hsecond' : 512 * Q * B0 * J ^ 2 * (16 / (J ^ 2 * |A| ^ 2)) * (10 * π / J)
          = 81920 * π * Q * B0 / (J * |A| ^ 2) := by
        field_simp
        ring
      have hthird : 81920 * π * Q * B0 / (J * |A| ^ 2) ≤ 4000 * (B0 / |A|) := by
        have hstep : Q / (J * |A| ^ 2) ≤ 1 / (100 * |A|) := by
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have h5 : Q * (100 * |A|) ≤ |A| ^ 2 := by
            nlinarith [hA, hApos, hQpos]
          nlinarith [h5, hJ1, hApos, sq_nonneg |A|]
        have h1 : 81920 * π * Q * B0 / (J * |A| ^ 2)
            = 81920 * π * B0 * (Q / (J * |A| ^ 2)) := by ring
        rw [h1]
        have h2 : 81920 * π * B0 * (Q / (J * |A| ^ 2))
            ≤ 81920 * π * B0 * (1 / (100 * |A|)) :=
          mul_le_mul_of_nonneg_left hstep (by positivity)
        refine le_trans h2 ?_
        have h3 : 81920 * π * B0 * (1 / (100 * |A|)) = 819.2 * π * (B0 / |A|) := by
          field_simp
          ring
        rw [h3]
        have h4 : 819.2 * π ≤ 4000 := by linarith
        have h5 : (0 : ℝ) ≤ B0 / |A| := by positivity
        exact mul_le_mul_of_nonneg_right h4 h5
      have hstC1 : B0 / |A| ≤ stC * B0 / |A| := by
        refine div_le_div_of_nonneg_right ?_ hApos.le
        nlinarith [hstC, hB0]
      have hfin : 4000 * (B0 / |A|) ≤ 4000 * (stC * B0 / |A|) :=
        mul_le_mul_of_nonneg_left hstC1 (by norm_num)
      have hpi40000 : 40000 * π * (stC * B0 / |A|) ≤ 160000 * (stC * B0 / |A|) := by
        have h9 : 40000 * π ≤ 160000 := by linarith
        have h : 40000 * π * (stC * B0 / |A|) = (40000 * π) * (stC * B0 / |A|) := by ring
        rw [h]
        exact mul_le_mul_of_nonneg_right h9 hXnn
      rw [hfirst]
      linarith [hsecond, hsecond' ▸ hthird, hfin, hpi40000, hXnn]
    have hsplit2 : T1 * (5 * (12 * Q * |A|) + 5 * π / J)
        = T1 * (5 * (12 * Q * |A|)) + T1 * (5 * π / J) := by ring
    rw [hsplit2, e1', e3]
    linarith [e2', e3', hXnn]
  refine ⟨G, hmaj, hGint, hGnn, ?_⟩
  refine le_trans (le_trans hGbd hnum) (le_of_eq ?_)
  ring

/-! ### The near plates -/

/-- On a near plate the phase varies by at most `2Q|q| + 300Q²` across the plate. -/
theorem plate_bounds_near {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : |plA M ν ε t w| ≤ 100 * (2 : ℝ) ^ (-(M : ℤ))) :
    ∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
      |psiu (mk2 w v) ε t (plAng M ν)|
          - (2 * (2 : ℝ) ^ (-(M : ℤ)) * |psiu (mk2 w v) ε t (plAng M ν)|
            + 300 * ((2 : ℝ) ^ (-(M : ℤ))) ^ 2)
        ≤ |psiu (mk2 w v) ε t φ| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφνdef
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t φν with hqdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hqnn : (0 : ℝ) ≤ |q| := abs_nonneg _
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * q - A := by
    rw [hu, hAdef, plA, ← hφνdef, hqdef, hu]
    exact psi1_ref_identity w v ε t φν
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * q - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_up : |psi1 u φν| ≤ 3 / 4 * |q| + 125 * Q := by
    have hcq : |Real.cos φν * q| ≤ 3 / 5 * |q| := by
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right hcos (abs_nonneg _)
    have h1 : |Real.cos φν * q - A| ≤ 3 / 5 * |q| + 100 * Q := by
      have h3 := abs_sub (Real.cos φν * q) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    linarith
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 7 / 4 * |q| + 125 * Q + 2 := by
    have h := norm_le_psi u ε t φν
    rw [← hqdef] at h
    have h2 : |q - ε * t| ≤ |q| + 2 := by
      have h3 := abs_sub q (ε * t)
      linarith
    linarith [hpp_up]
  -- the derivative bound on the plate
  have hK : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |psi1 u φ| ≤ 4 / 5 * |q| + 132 * Q := by
    intro φ hφ
    have hlipφ : |φ - φν| ≤ 2 * Q := by
      rw [abs_of_nonneg (by linarith [hφ.1])]
      linarith [hφ.2]
    have h1 : |psi1 u φ - psi1 u φν| ≤ (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) := by
      have h := abs_psi1_sub_le u φ φν
      calc |psi1 u φ - psi1 u φν| ≤ ‖u‖ * |φ - φν| := h
        _ ≤ (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) :=
            mul_le_mul hnorm hlipφ (abs_nonneg _) (by positivity)
    have h2 : |psi1 u φ| ≤ |psi1 u φν| + |psi1 u φ - psi1 u φν| := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
      linarith
    have h4 : (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) ≤ 1 / 20 * |q| + 7 * Q := by
      have hq1 : 2 * Q * (7 / 4 * |q|) ≤ 1 / 20 * |q| := by
        nlinarith [hQpos, hqnn, hQ]
      have hq2 : 2 * Q * (125 * Q) ≤ 3 * Q := by
        nlinarith [hQpos, hQ]
      nlinarith [hq1, hq2, hQpos]
    linarith [hpp_up]
  -- the mean value bound
  intro φ hφ
  have hmvt := abs_psiu_sub_le_of_bound u ε t hK hφ
    (Set.left_mem_Icc.mpr (by linarith [hQpos]))
  have hlipφ : |φ - φν| ≤ 2 * Q := by
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have h1 : |psiu u ε t φ - q| ≤ 2 * Q * |q| + 300 * Q ^ 2 := by
    rw [← hqdef] at hmvt
    calc |psiu u ε t φ - q| ≤ (4 / 5 * |q| + 132 * Q) * |φ - φν| := hmvt
      _ ≤ (4 / 5 * |q| + 132 * Q) * (2 * Q) := by
          refine mul_le_mul_of_nonneg_left hlipφ (by positivity)
      _ ≤ 2 * Q * |q| + 300 * Q ^ 2 := by
          nlinarith [hQpos, hqnn]
  have h2 : |q| - |psiu u ε t φ - q| ≤ |psiu u ε t φ| := by
    have h3 := abs_sub_abs_le_abs_sub q (psiu u ε t φ)
    rw [abs_sub_comm q (psiu u ε t φ)] at h3
    linarith
  linarith

set_option maxHeartbeats 1000000 in
/-- **The near plates.**  There are `O(1)` of them, and each contributes `O(B₀ 2^M)`. -/
theorem exists_near_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ))
    {ν : ℤ} (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : |plA M ν ε t w| ≤ 100 * (2 : ℝ) ^ (-(M : ℤ))) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 7000000 * B0 * (2 : ℝ) ^ M := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set φν : ℝ := plAng M ν with hφνdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hJP2 : J ≤ P ^ 2 := by
    rw [hJdef, hPdef]
    have h1 : ((2 : ℝ) ^ M) ^ 2 = (2 : ℝ) ^ (((2 * M : ℕ) : ℤ)) := by
      rw [zpow_natCast, ← pow_mul]
      ring_nf
    rw [h1]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    push_cast
    omega
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  -- the affine form of the phase
  set a : ℝ := Real.sin φν with hadef
  set b : ℝ := w * Real.cos φν + ε * t with hbdef
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have ha : (4 : ℝ) / 5 ≤ a := by
    rw [hadef]
    exact sin_ge_of_near hangle
  have hqaff : ∀ v : ℝ, psiu (mk2 w v) ε t φν = a * v + b := by
    intro v
    rw [hadef, hbdef, hφνdef, psiu_mk2]
    ring
  refine ⟨fun v => 512 * Q * B0 * J ^ 2
      * (1 + J / 3 * max 0 (|a * v + b| - 2700 * Q ^ 2))⁻¹ ^ 2, ?_, ?_, ?_, ?_⟩
  · -- the pointwise bound
    intro v
    set qv : ℝ := |a * v + b| with hqvdef
    have hqvnn : (0 : ℝ) ≤ qv := by rw [hqvdef]; exact abs_nonneg _
    have hbd := plate_bounds_near hε ht1 ht2 hQ hang hA (v := v)
    rw [hqaff v] at hbd
    set mu : ℝ := max 0 (qv - (2 * Q * qv + 300 * Q ^ 2)) with hmudef
    have hcap : ‖kernPlate j ε m t (mk2 w v) M ν‖
        ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * mu)⁻¹ ^ 4 := by
      refine norm_kernPlate_le_capped hp hm ε t (mk2 w v) M ν (le_max_left _ _) ?_
      have hplate : Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q)
          = Set.Icc φν (φν + 2 * Q) := by
        rw [hφνdef, plAng_add M ν, plAng]
      rw [hplate]
      intro φ hφ
      rcases le_or_gt (qv - (2 * Q * qv + 300 * Q ^ 2)) 0 with hle | hgt
      · have hz : mu = 0 := by rw [hmudef, max_eq_left hle]
        rw [hz]
        exact abs_nonneg _
      · have hz : mu = qv - (2 * Q * qv + 300 * Q ^ 2) := by
          rw [hmudef, max_eq_right (le_of_lt hgt)]
        rw [hz, hqvdef]
        exact hbd φ hφ
    -- compare the two capped bounds
    have hstep : (1 : ℝ) / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ mu := by
      rcases le_or_gt (2700 * Q ^ 2) qv with hcase | hcase
      · have hslack : 2 * Q * qv + 300 * Q ^ 2 ≤ 2 / 3 * qv := by
          have h1 : 2 * Q * qv ≤ 1 / 50 * qv := by
            nlinarith [hQpos, hqvnn, hQ]
          have h2 : 300 * Q ^ 2 ≤ 1 / 9 * qv := by
            nlinarith [hcase, hQpos]
          linarith
        have h3 : (1 : ℝ) / 3 * qv ≤ qv - (2 * Q * qv + 300 * Q ^ 2) := by linarith
        have h4 : max 0 (qv - 2700 * Q ^ 2) ≤ qv := by
          refine max_le hqvnn ?_
          nlinarith [hQpos]
        calc (1 : ℝ) / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ 1 / 3 * qv := by linarith
          _ ≤ qv - (2 * Q * qv + 300 * Q ^ 2) := h3
          _ ≤ mu := le_max_right _ _
      · have hz : max 0 (qv - 2700 * Q ^ 2) = 0 := by
          refine max_eq_left ?_
          linarith
        rw [hz]
        have : (0 : ℝ) ≤ mu := le_max_left _ _
        linarith
    have hmono : (1 + J * mu)⁻¹ ^ 4
        ≤ (1 + J / 3 * max 0 (qv - 2700 * Q ^ 2))⁻¹ ^ 2 := by
      have h1 : 1 + J / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ 1 + J * mu := by
        have h2 : J / 3 * max 0 (qv - 2700 * Q ^ 2) = J * (1 / 3 * max 0 (qv - 2700 * Q ^ 2)) := by
          ring
        rw [h2]
        linarith [mul_le_mul_of_nonneg_left hstep (le_of_lt hJpos)]
      have h3 : (0 : ℝ) < 1 + J / 3 * max 0 (qv - 2700 * Q ^ 2) := by
        have h4 : (0 : ℝ) ≤ max 0 (qv - 2700 * Q ^ 2) := le_max_left _ _
        positivity
      have h5 := inv_anti₀ h3 h1
      have h6 : (0 : ℝ) ≤ (1 + J * mu)⁻¹ := by
        have h7 : (0 : ℝ) ≤ mu := le_max_left _ _
        positivity
      have h8 : (1 + J * mu)⁻¹ ^ 4 ≤ (1 + J * mu)⁻¹ ^ 2 := by
        have h9 : (1 + J * mu)⁻¹ ≤ 1 := by
          rw [inv_le_one_iff₀]
          right
          have h7 : (0 : ℝ) ≤ mu := le_max_left _ _
          nlinarith [hJpos, h7]
        exact pow_le_pow_of_le_one h6 h9 (by norm_num)
      have h10 : (1 + J * mu)⁻¹ ^ 2
          ≤ (1 + J / 3 * max 0 (qv - 2700 * Q ^ 2))⁻¹ ^ 2 := pow_le_pow_left₀ h6 h5 2
      linarith
    refine le_trans hcap ?_
    rw [hJ2]
    exact mul_le_mul_of_nonneg_left hmono (by positivity)
  · -- integrability
    obtain ⟨hint, -⟩ := integral_capped_le (A := J / 3) (a := a) (b := b)
      (slack := 2700 * Q ^ 2) (by positivity) ha (by positivity)
    exact hint.const_mul _
  · -- nonnegativity
    intro v
    have h : (0 : ℝ) ≤ max 0 (|a * v + b| - 2700 * Q ^ 2) := le_max_left _ _
    positivity
  · -- the integral
    obtain ⟨hint, hbd⟩ := integral_capped_le (A := J / 3) (a := a) (b := b)
      (slack := 2700 * Q ^ 2) (by positivity) ha (by positivity)
    rw [integral_const_mul]
    have hfac : (0 : ℝ) ≤ 512 * Q * B0 * J ^ 2 := by positivity
    refine le_trans (mul_le_mul_of_nonneg_left hbd hfac) ?_
    -- the numerical estimate
    have hpi : π ≤ 4 := Real.pi_le_four
    have h1 : 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2)) = 6912000 * B0 * (Q ^ 3 * J ^ 2) := by
      ring
    have h2 : Q ^ 3 * J ^ 2 ≤ P := by
      have h3 : J ^ 2 ≤ (P ^ 2) ^ 2 := by
        refine pow_le_pow_left₀ (le_of_lt hJpos) hJP2 2
      have h4 : Q ^ 3 * J ^ 2 ≤ Q ^ 3 * (P ^ 2) ^ 2 :=
        mul_le_mul_of_nonneg_left h3 (by positivity)
      refine le_trans h4 (le_of_eq ?_)
      have h5 : Q = 1 / P := by
        field_simp
        linarith [hPQ]
      rw [h5]
      field_simp
    have h6 : 512 * Q * B0 * J ^ 2 * (5 * π / (J / 3)) = 7680 * π * B0 * (Q * J) := by
      field_simp
      ring
    have h7 : Q * J ≤ P := by
      have h8 : Q * J ≤ Q * P ^ 2 := mul_le_mul_of_nonneg_left hJP2 (le_of_lt hQpos)
      refine le_trans h8 (le_of_eq ?_)
      have h5 : Q = 1 / P := by
        field_simp
        linarith [hPQ]
      rw [h5]
      field_simp
    have hsplit : 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2) + 5 * π / (J / 3))
        = 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2))
          + 512 * Q * B0 * J ^ 2 * (5 * π / (J / 3)) := by ring
    rw [hsplit, h1, h6]
    have hA1 : 6912000 * B0 * (Q ^ 3 * J ^ 2) ≤ 6912000 * B0 * P :=
      mul_le_mul_of_nonneg_left h2 (by positivity)
    have hA2 : 7680 * π * B0 * (Q * J) ≤ 7680 * π * B0 * P :=
      mul_le_mul_of_nonneg_left h7 (by positivity)
    have hA3 : 7680 * π * B0 * P ≤ 30720 * B0 * P := by
      have h : (0 : ℝ) ≤ B0 * P := by positivity
      nlinarith [hpi, h]
    have hA4 : (0 : ℝ) ≤ B0 * P := by positivity
    nlinarith [hA1, hA2, hA3, hA4]

/-! ### The uniform per-plate majorant -/

/-- The weight of a plate in the plate sum: the reciprocal of `max(2^{-M}, |A_ν|)` for plates in
the angular range, and zero for the others. -/
noncomputable def plWt (M : ℕ) (ν : ℤ) (ε t w : ℝ) : ℝ :=
  if |π / 2 - plAng M ν| ≤ 3 / 5 then 1 / max ((2 : ℝ) ^ (-(M : ℤ))) (|plA M ν ε t w|) else 0

theorem plWt_nonneg (M : ℕ) (ν : ℤ) (ε t w : ℝ) : 0 ≤ plWt M ν ε t w := by
  rw [plWt]
  split
  · positivity
  · exact le_refl 0

/-- A plate whose reference angle is far from `π/2` does not meet the angular support. -/
theorem kernPlate_eq_zero_of_angle {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : ¬ (|π / 2 - plAng M ν| ≤ 3 / 5)) :
    kernPlate j ε m t u M ν = 0 := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hgt : (3 : ℝ) / 5 < |π / 2 - plAng M ν| := not_le.mp hang
  rw [kernPlate]
  have hzero : ∀ φ ∈ Set.Ioo (-π) π,
      (plateC M ν φ : ℝ) • kernRad j ε m t u φ = 0 := by
    intro φ hφ
    by_cases hpc : plateC M ν φ = 0
    · rw [hpc]
      simp
    · -- the angle lies in the plate, hence far from `π/2`
      have hmem : φ ∈ Set.Ioc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) := by
        by_contra hnot
        exact hpc (plateC_eq_zero_of_not_mem hnot)
      have hclose : |φ - plAng M ν| ≤ 2 * Q := by
        rw [plAng, Set.mem_Ioc] at *
        rw [abs_le]
        constructor
        · linarith [hmem.1]
        · linarith [hmem.2]
      have hfar : (3 : ℝ) / 5 - 2 * Q ≤ |π / 2 - φ| := by
        have h1 : |π / 2 - plAng M ν| ≤ |π / 2 - φ| + |φ - plAng M ν| := by
          calc |π / 2 - plAng M ν| = |(π / 2 - φ) + (φ - plAng M ν)| := by
                congr 1
                ring
            _ ≤ |π / 2 - φ| + |φ - plAng M ν| := abs_add_le _ _
        linarith
      have hout : ¬ (1 < φ ∧ φ < π / 2) := by
        intro ⟨h1, h2⟩
        have h3 : |π / 2 - φ| = π / 2 - φ := abs_of_nonneg (by linarith)
        have hpi : π < 3.15 := Real.pi_lt_d2
        rw [h3] at hfar
        have h4 : 2 * Q ≤ 1 / 50 := by linarith
        linarith
      rw [kernRad_eq_zero hm ε t u hφ hout]
      simp
  rw [setIntegral_congr_fun measurableSet_Ioo hzero]
  simp

set_option maxHeartbeats 1000000 in
/-- **The uniform per-plate majorant.**  Every plate — far, near, or outside the angular support —
admits a majorant whose integral is at most `C(1+stC)B₀ / max(2^{-M}, |A_ν|)`. -/
theorem exists_plate_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ))
    {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉) (w : ℝ) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 700000000 * (1 + stC) * B0 * plWt M ν ε t w := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hmaxpos : (0 : ℝ) < max Q |A| := lt_of_lt_of_le hQpos (le_max_left _ _)
  by_cases hangle : |π / 2 - plAng M ν| ≤ 3 / 5
  · by_cases hfar : 100 * Q ≤ |A|
    · -- a far plate
      obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
        exists_far_majorant hp hm hε ht1 ht2 hM hQ hMj hν hνB hangle hfar
      refine ⟨G, hG1, hG2, hG3, le_trans hG4 ?_⟩
      have hmaxeq : max Q |A| = |A| := by
        refine max_eq_right ?_
        linarith
      rw [plWt, if_pos hangle, ← hQdef, ← hAdef, hmaxeq, mul_one_div]
      refine div_le_div_of_nonneg_right ?_ (abs_nonneg A)
      nlinarith [hstCnn, hB0, hstC]
    · -- a near plate
      have hnear : |A| ≤ 100 * Q := le_of_lt (not_le.mp hfar)
      obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
        exists_near_majorant hp hm hε ht1 ht2 hQ hMj2 hangle hnear
      refine ⟨G, hG1, hG2, hG3, le_trans hG4 ?_⟩
      have hmaxle : max Q |A| ≤ 100 * Q := max_le (by linarith) hnear
      have hstep : 7000000 * B0 * P ≤ 700000000 * (1 + stC) * B0 / (100 * Q) := by
        have hPform : P = 1 / Q := by
          field_simp
          linarith [hPQ]
        rw [hPform, le_div_iff₀ (by positivity : (0 : ℝ) < 100 * Q)]
        have h : 7000000 * B0 * (1 / Q) * (100 * Q) = 700000000 * B0 := by
          field_simp
          ring
        rw [h]
        nlinarith [hstCnn, hB0]
      refine le_trans hstep ?_
      rw [plWt, if_pos hangle, ← hQdef, ← hAdef, mul_one_div]
      refine div_le_div_of_nonneg_left ?_ hmaxpos hmaxle
      nlinarith [hstCnn, hB0]
  · -- outside the angular support
    refine ⟨fun _ => 0, ?_, integrable_zero _ _ _, fun _ => le_refl 0, ?_⟩
    · intro v
      rw [kernPlate_eq_zero_of_angle hm ε t (mk2 w v) hQ hangle]
      simp
    · rw [integral_zero, plWt, if_neg hangle]
      simp

/-! ### The plate parameters are separated -/

/-- **Separation.**  The plate parameters `A_ν = w + εt cos φ_ν` of two plates in the angular range
differ by at least `(2/5)|ν - ν'| 2^{-M}`: the `w` cancels, and the cosine has derivative at least
`4/5` in modulus there. -/
theorem plA_separated {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} {ν ν' : ℤ}
    (w : ℝ) (hang : |π / 2 - plAng M ν| ≤ 3 / 5) (hang' : |π / 2 - plAng M ν'| ≤ 3 / 5) :
    2 / 5 * (|(ν : ℝ) - (ν' : ℝ)| * (2 : ℝ) ^ (-(M : ℤ)))
      ≤ |plA M ν ε t w - plA M ν' ε t w| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set x : ℝ := plAng M ν with hxdef
  set y : ℝ := plAng M ν' with hydef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hdiff : plA M ν ε t w - plA M ν' ε t w = ε * t * (Real.cos x - Real.cos y) := by
    rw [plA, plA, ← hxdef, ← hydef]
    ring
  have hxy : x - y = ((ν : ℝ) - (ν' : ℝ)) * Q := by
    rw [hxdef, hydef, plAng, plAng, hQdef]
    ring
  -- the midpoint is still in the good range
  have hmid : |π / 2 - (x + y) / 2| ≤ 3 / 5 := by
    have h : π / 2 - (x + y) / 2 = ((π / 2 - x) + (π / 2 - y)) / 2 := by ring
    rw [h, abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    have h2 : |(π / 2 - x) + (π / 2 - y)| ≤ |π / 2 - x| + |π / 2 - y| := abs_add_le _ _
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2)]
    linarith
  have hsinmid : (4 : ℝ) / 5 ≤ Real.sin ((x + y) / 2) := sin_ge_of_near hmid
  -- the half-difference is small
  have hsmall : |(x - y) / 2| ≤ π / 2 := by
    have h1 : |x - y| ≤ 6 / 5 := by
      have h2 : |x - y| ≤ |π / 2 - y| + |π / 2 - x| := by
        calc |x - y| = |(π / 2 - y) - (π / 2 - x)| := by
              congr 1
              ring
          _ ≤ |π / 2 - y| + |π / 2 - x| := abs_sub _ _
      linarith
    rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    have hpi : (3 : ℝ) < π := Real.pi_gt_three
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2)]
    linarith
  have hsinhalf : |(x - y) / 2| / 2 ≤ |Real.sin ((x - y) / 2)| := abs_sin_ge_half hsmall
  -- put things together
  have hcos : |Real.cos x - Real.cos y|
      = 2 * |Real.sin ((x + y) / 2)| * |Real.sin ((x - y) / 2)| := by
    rw [Real.cos_sub_cos, abs_mul, abs_mul, abs_neg, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have hsinmidabs : (4 : ℝ) / 5 ≤ |Real.sin ((x + y) / 2)| := by
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sin ((x + y) / 2))]
    exact hsinmid
  have hstep : 2 / 5 * |x - y| ≤ |Real.cos x - Real.cos y| := by
    rw [hcos]
    have habs : |(x - y) / 2| = |x - y| / 2 := by
      rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    rw [habs] at hsinhalf
    have h1 : (4 : ℝ) / 5 * (|x - y| / 4) ≤ |Real.sin ((x + y) / 2)| * |Real.sin ((x - y) / 2)| := by
      refine mul_le_mul hsinmidabs ?_ (by positivity) (by positivity)
      linarith [hsinhalf]
    nlinarith [h1, abs_nonneg (x - y)]
  have hεt : |ε * t| = t := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
  rw [hdiff, abs_mul, hεt]
  have habsxy : |x - y| = |(ν : ℝ) - (ν' : ℝ)| * Q := by
    rw [hxy, abs_mul, abs_of_pos hQpos]
  rw [habsxy] at hstep
  have hcosnn : (0 : ℝ) ≤ |Real.cos x - Real.cos y| := abs_nonneg _
  have h : 1 * |Real.cos x - Real.cos y| ≤ t * |Real.cos x - Real.cos y| :=
    mul_le_mul_of_nonneg_right ht1 hcosnn
  linarith [hstep, h]

/-! ### The plate sum -/

/-- The harmonic sum over an integer interval. -/
theorem harmonic_int_le (B : ℤ) (L : ℕ) (hB : B ≤ 2 ^ L) :
    ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  classical
  rcases le_or_gt B 0 with hlt | hge
  · have hempty : Finset.Icc (1 : ℤ) B = ∅ := by
      rw [Finset.Icc_eq_empty]
      omega
    rw [hempty, Finset.sum_empty]
    positivity
  · have himg : (Finset.Icc (1 : ℕ) B.toNat).image (fun n : ℕ => (n : ℤ))
        = Finset.Icc (1 : ℤ) B := by
      ext k
      simp only [Finset.mem_image, Finset.mem_Icc]
      constructor
      · rintro ⟨n, ⟨h1, h2⟩, rfl⟩
        omega
      · intro h
        exact ⟨k.toNat, ⟨by omega, by omega⟩, by omega⟩
    rw [← himg, Finset.sum_image (by
      intro x _ y _ h
      exact Nat.cast_injective h)]
    have hcast : ∀ n ∈ Finset.Icc (1 : ℕ) B.toNat,
        (1 : ℝ) / (((n : ℤ) : ℝ)) = (1 : ℝ) / (n : ℝ) := by
      intro n _
      push_cast
      ring
    rw [Finset.sum_congr rfl hcast]
    refine harmonic_le B.toNat L ?_
    have h2 : (((2 : ℕ) ^ L : ℕ) : ℤ) = (2 : ℤ) ^ L := by push_cast; ring
    omega

set_option maxHeartbeats 1000000 in
/-- **The plate sum.**  The separation of the plate parameters turns the sum of the plate weights
into a harmonic sum, giving `2^M(1+M)` up to constants. -/
theorem plate_sum_le {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    {B : ℤ} (hB0 : 0 ≤ B) {L : ℕ} (hBL : B ≤ 2 ^ L) (w : ℝ) :
    ∑ ν ∈ Finset.Icc (0 : ℤ) B, plWt M ν ε t w
      ≤ (2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1) := by
  classical
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hQinv : 1 / Q = P := by
    field_simp
    linarith [hPQ]
  set S : Finset ℤ := (Finset.Icc (0 : ℤ) B).filter
    (fun ν => |π / 2 - plAng M ν| ≤ 3 / 5) with hSdef
  have hsum : ∑ ν ∈ Finset.Icc (0 : ℤ) B, plWt M ν ε t w
      = ∑ ν ∈ S, 1 / max Q (|plA M ν ε t w|) := by
    rw [hSdef, Finset.sum_filter]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [plWt, hQdef]
  rw [hsum]
  rcases S.eq_empty_or_nonempty with hempty | hne
  · rw [hempty, Finset.sum_empty]
    have h1 : (0 : ℝ) ≤ 10 * ((L : ℝ) + 1) + 1 := by positivity
    positivity
  obtain ⟨ν₀, hν₀S, hν₀min⟩ := S.exists_min_image (fun ν => |plA M ν ε t w|) hne
  -- the angular hypothesis for members of `S`
  have hSang : ∀ ν ∈ S, |π / 2 - plAng M ν| ≤ 3 / 5 := by
    intro ν hν
    rw [hSdef, Finset.mem_filter] at hν
    exact hν.2
  have hSrange : ∀ ν ∈ S, 0 ≤ ν ∧ ν ≤ B := by
    intro ν hν
    rw [hSdef, Finset.mem_filter, Finset.mem_Icc] at hν
    exact hν.1
  -- the term at the minimiser
  have hmin_term : 1 / max Q (|plA M ν₀ ε t w|) ≤ P := by
    rw [← hQinv]
    refine one_div_le_one_div_of_le hQpos (le_max_left _ _)
  -- the other terms
  have hterm : ∀ ν ∈ S.erase ν₀,
      1 / max Q (|plA M ν ε t w|) ≤ 5 * P / |(ν : ℝ) - (ν₀ : ℝ)| := by
    intro ν hν
    have hνS : ν ∈ S := Finset.mem_of_mem_erase hν
    have hne' : ν ≠ ν₀ := Finset.ne_of_mem_erase hν
    have hsep := plA_separated hε ht1 ht2 w (hSang ν hνS) (hSang ν₀ hν₀S)
    have hmin := hν₀min ν hνS
    have habs : |plA M ν ε t w - plA M ν₀ ε t w|
        ≤ |plA M ν ε t w| + |plA M ν₀ ε t w| := abs_sub _ _
    have hd : (1 : ℝ) ≤ |(ν : ℝ) - (ν₀ : ℝ)| := by
      have h1 : ((ν - ν₀ : ℤ) : ℝ) = (ν : ℝ) - (ν₀ : ℝ) := by push_cast; ring
      have h2 : (1 : ℤ) ≤ |ν - ν₀| := by
        rcases lt_or_gt_of_ne (sub_ne_zero.mpr (by exact_mod_cast hne')) with hlt | hgt
        · rw [abs_of_neg hlt]
          omega
        · rw [abs_of_pos hgt]
          omega
      have h3 : ((1 : ℤ) : ℝ) ≤ ((|ν - ν₀| : ℤ) : ℝ) := by exact_mod_cast h2
      rw [Int.cast_abs, h1] at h3
      simpa using h3
    have hlow : 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) ≤ |plA M ν ε t w| := by
      have h4 := hsep
      rw [← hQdef] at h4
      linarith [habs, hmin, h4]
    have hmaxlow : 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) ≤ max Q (|plA M ν ε t w|) :=
      le_trans hlow (le_max_right _ _)
    have hpos : (0 : ℝ) < 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) := by
      have h5 : (0 : ℝ) < |(ν : ℝ) - (ν₀ : ℝ)| := lt_of_lt_of_le zero_lt_one hd
      positivity
    have hstep : 1 / max Q (|plA M ν ε t w|)
        ≤ 1 / (1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q)) :=
      one_div_le_one_div_of_le hpos hmaxlow
    refine le_trans hstep (le_of_eq ?_)
    rw [← hQinv]
    field_simp
  -- the reindexing
  set N : ℤ := B with hNdef
  have hreindex : ∑ ν ∈ S.erase ν₀, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
      ≤ 2 * (5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ)) := by
    set T : Finset ℤ := S.erase ν₀ with hTdef
    have hTrange : ∀ ν ∈ T, 0 ≤ ν ∧ ν ≤ B ∧ ν ≠ ν₀ := by
      intro ν hν
      refine ⟨(hSrange ν (Finset.mem_of_mem_erase hν)).1,
        (hSrange ν (Finset.mem_of_mem_erase hν)).2, Finset.ne_of_mem_erase hν⟩
    have hν₀range : 0 ≤ ν₀ ∧ ν₀ ≤ B := hSrange ν₀ hν₀S
    have hpart : ∑ ν ∈ T, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        = ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
          + ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|) :=
      (Finset.sum_filter_add_sum_filter_not T _ _).symm
    have hplus : ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        ≤ 5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) := by
      have hinj : ∀ x ∈ T.filter (fun ν => ν₀ < ν), ∀ y ∈ T.filter (fun ν => ν₀ < ν),
          x - ν₀ = y - ν₀ → x = y := by
        intro x _ y _ h
        omega
      have heq : ∀ ν ∈ T.filter (fun ν => ν₀ < ν),
          5 * P / |(ν : ℝ) - (ν₀ : ℝ)| = 5 * P * ((1 : ℝ) / (((ν - ν₀ : ℤ) : ℝ))) := by
        intro ν hν
        rw [Finset.mem_filter] at hν
        have hlt : ν₀ < ν := hν.2
        have hcast : ((ν - ν₀ : ℤ) : ℝ) = (ν : ℝ) - (ν₀ : ℝ) := by push_cast; ring
        have hpos : (0 : ℝ) < (ν : ℝ) - (ν₀ : ℝ) := by
          have : (ν₀ : ℝ) < (ν : ℝ) := by exact_mod_cast hlt
          linarith
        rw [hcast, abs_of_pos hpos]
        field_simp
      rw [Finset.sum_congr rfl heq, ← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have hsubset : (T.filter (fun ν => ν₀ < ν)).image (fun ν => ν - ν₀)
          ⊆ Finset.Icc (1 : ℤ) B := by
        intro k hk
        rw [Finset.mem_image] at hk
        obtain ⟨ν, hν, rfl⟩ := hk
        rw [Finset.mem_filter] at hν
        have h1 := hTrange ν hν.1
        rw [Finset.mem_Icc]
        omega
      calc ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (1 : ℝ) / (((ν - ν₀ : ℤ) : ℝ))
          = ∑ k ∈ (T.filter (fun ν => ν₀ < ν)).image (fun ν => ν - ν₀),
              (1 : ℝ) / ((k : ℤ) : ℝ) := by rw [Finset.sum_image hinj]
        _ ≤ ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / ((k : ℤ) : ℝ) := by
            refine Finset.sum_le_sum_of_subset_of_nonneg hsubset ?_
            intro k hk _
            rw [Finset.mem_Icc] at hk
            have h1 : (1 : ℝ) ≤ ((k : ℤ) : ℝ) := by exact_mod_cast hk.1
            positivity
    have hminus : ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        ≤ 5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) := by
      have hinj : ∀ x ∈ T.filter (fun ν => ¬ (ν₀ < ν)), ∀ y ∈ T.filter (fun ν => ¬ (ν₀ < ν)),
          ν₀ - x = ν₀ - y → x = y := by
        intro x _ y _ h
        omega
      have heq : ∀ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)),
          5 * P / |(ν : ℝ) - (ν₀ : ℝ)| = 5 * P * ((1 : ℝ) / (((ν₀ - ν : ℤ) : ℝ))) := by
        intro ν hν
        rw [Finset.mem_filter] at hν
        have hle : ν < ν₀ := by
          have h1 := hν.2
          have h2 := (hTrange ν hν.1).2.2
          omega
        have hcast : ((ν₀ - ν : ℤ) : ℝ) = (ν₀ : ℝ) - (ν : ℝ) := by push_cast; ring
        have hpos : (0 : ℝ) < (ν₀ : ℝ) - (ν : ℝ) := by
          have : (ν : ℝ) < (ν₀ : ℝ) := by exact_mod_cast hle
          linarith
        rw [hcast, abs_sub_comm, abs_of_pos hpos]
        field_simp
      rw [Finset.sum_congr rfl heq, ← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have hsubset : (T.filter (fun ν => ¬ (ν₀ < ν))).image (fun ν => ν₀ - ν)
          ⊆ Finset.Icc (1 : ℤ) B := by
        intro k hk
        rw [Finset.mem_image] at hk
        obtain ⟨ν, hν, rfl⟩ := hk
        rw [Finset.mem_filter] at hν
        have h1 := hTrange ν hν.1
        have h2 := hν.2
        rw [Finset.mem_Icc]
        omega
      calc ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (1 : ℝ) / (((ν₀ - ν : ℤ) : ℝ))
          = ∑ k ∈ (T.filter (fun ν => ¬ (ν₀ < ν))).image (fun ν => ν₀ - ν),
              (1 : ℝ) / ((k : ℤ) : ℝ) := by rw [Finset.sum_image hinj]
        _ ≤ ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / ((k : ℤ) : ℝ) := by
            refine Finset.sum_le_sum_of_subset_of_nonneg hsubset ?_
            intro k hk _
            rw [Finset.mem_Icc] at hk
            have h1 : (1 : ℝ) ≤ ((k : ℤ) : ℝ) := by exact_mod_cast hk.1
            positivity
    rw [hpart]
    linarith
  -- assemble
  have hsplit : ∑ ν ∈ S, 1 / max Q (|plA M ν ε t w|)
      = 1 / max Q (|plA M ν₀ ε t w|) + ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|) := by
    rw [← Finset.add_sum_erase S _ hν₀S]
  rw [hsplit]
  have hbound : ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|)
      ≤ ∑ ν ∈ S.erase ν₀, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|) :=
    Finset.sum_le_sum hterm
  have hharm : ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 :=
    harmonic_int_le B L hBL
  have hfinal : 2 * (5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ))
      ≤ 10 * P * ((L : ℝ) + 1) := by
    have h : (0 : ℝ) ≤ 10 * P := by positivity
    nlinarith [hharm, h]
  have hPnn : (0 : ℝ) ≤ P := le_of_lt hPpos
  calc 1 / max Q (|plA M ν₀ ε t w|) + ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|)
      ≤ P + 10 * P * ((L : ℝ) + 1) := by
        linarith [hmin_term, hbound, hreindex, hfinal]
    _ = P * (10 * ((L : ℝ) + 1) + 1) := by ring

/-! ### The endpoint estimate for the kernel -/

/-- The per-plate majorant, in the form needed for the sum over all plates: the pointwise bound is
only claimed for plates in the range, and the bound for the integral is expressed through the plate
weight `plWt`. -/
theorem exists_plate_majorant' {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) (w : ℝ) (ν : ℤ) :
    ∃ G : ℝ → ℝ,
      ((0 ≤ ν ∧ ν ≤ ⌈π * (2 : ℝ) ^ M⌉) → ∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
        ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
        ∧ (∫ v : ℝ, G v) ≤ 700000000 * (1 + stC) * B0 * plWt M ν ε t w := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  by_cases hrange : 0 ≤ ν ∧ ν ≤ ⌈π * (2 : ℝ) ^ M⌉
  · obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
      exists_plate_majorant hp hm hε ht1 ht2 hM hQ hMj hMj2 hrange.1 hrange.2 w
    exact ⟨G, fun _ => hG1, hG2, hG3, hG4⟩
  · refine ⟨fun _ => 0, fun hc => absurd hc hrange, integrable_zero _ _ _, fun _ => le_refl 0, ?_⟩
    rw [integral_zero]
    have h := plWt_nonneg M ν ε t w
    positivity

set_option maxHeartbeats 1000000 in
/-- **The endpoint estimate for the kernel.**  For every `w`, the `L¹` norm of the kernel in the
second variable is at most `C(1+stC)B₀ 2^M(1+M)`, i.e. `2^{j/2}` up to a factor `j`. -/
theorem lintegral_norm_kern_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L) (w : ℝ) :
    (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v)‖ₑ)
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) := by
  classical
  set B : ℤ := ⌈π * (2 : ℝ) ^ M⌉ with hBdef
  have hBnn : (0 : ℤ) ≤ B := by
    rw [hBdef]
    refine Int.ceil_nonneg ?_
    positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  choose G hG1 hG2 hG3 hG4 using
    exists_plate_majorant' hp hm hε ht1 ht2 hM hQ hMj hMj2 w
  -- the pointwise bound
  have hpt : ∀ v : ℝ, ‖kern j ε m t (mk2 w v)‖ ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v := by
    intro v
    rw [kern_eq_sum_plates hm ε t (mk2 w v) hM, ← hBdef]
    refine le_trans (norm_sum_le _ _) ?_
    refine Finset.sum_le_sum fun ν hν => ?_
    rw [Finset.mem_Icc] at hν
    exact hG1 ν ⟨hν.1, hν.2⟩ v
  -- integrability and nonnegativity of the total majorant
  have hGtotint : Integrable (fun v : ℝ => ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) :=
    integrable_finsetSum _ fun ν _ => hG2 ν
  have hGtotnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v := by
    filter_upwards with v
    show (0 : ℝ) ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v
    exact Finset.sum_nonneg fun ν _ => hG3 ν v
  -- the sum of the integrals
  have hsumint : (∫ v : ℝ, ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v)
      = ∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v :=
    integral_finsetSum _ fun ν _ => hG2 ν
  have hsumbd : (∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v)
      ≤ 700000000 * (1 + stC) * B0 * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) := by
    have hstep : (∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v)
        ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, 700000000 * (1 + stC) * B0 * plWt M ν ε t w :=
      Finset.sum_le_sum fun ν _ => hG4 ν
    refine le_trans hstep ?_
    rw [← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact plate_sum_le hε ht1 ht2 hBnn hBL w
  calc (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v)‖ₑ)
      ≤ ∫⁻ v : ℝ, ENNReal.ofReal (∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) := by
        refine lintegral_mono fun v => ?_
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hpt v)
    _ = ENNReal.ofReal (∫ v : ℝ, ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) :=
        (ofReal_integral_eq_lintegral_ofReal hGtotint hGtotnn).symm
    _ ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [hsumint]
        exact hsumbd

/-! ### The convolution representation of `T_t` -/

/-- The kernel of the single-scale operator, as a Schwartz function. -/
noncomputable def kernS {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl ℂ :=
  𝓕⁻ (mfullS hm ε t)

theorem kernS_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    (kernS hm ε t : Pl → ℂ) u = kern j ε m t u := by
  rw [kernS, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl, kern]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  have hinner : (inner ℝ v (-u) : ℝ) = -(inner ℝ u v : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  simp only [mfullS_apply, hinner]

/-- **The convolution representation.**  `T_t f = k_{j,t} ∗ f`. -/
theorem TopS_eq_convolution {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x = ∫ y : Pl, kern j ε m t y * (f : Pl → ℂ) (x - y) := by
  have h3 : 𝓕 (kernS hm ε t) = mfullS hm ε t := by
    rw [kernS, FourierTransform.fourier_fourierInv_eq]
  have h1 : 𝓕 (TopS hm ε t f) = SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) := by
    rw [TopS, FourierTransform.fourier_fourierInv_eq]
  have h2 : 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f)
      = SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (𝓕 (kernS hm ε t)) (𝓕 f) :=
    SchwartzMap.fourier_convolution _ _ _
  have h4 : SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (mfullS hm ε t) (𝓕 f)
      = SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) := by
    refine SchwartzMap.ext fun ω => ?_
    rw [SchwartzMap.pairing_apply_apply,
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull hm ε t), mfullS_apply,
      smul_eq_mul]
    rfl
  have hEq : TopS hm ε t f
      = SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f := by
    have hF : 𝓕 (TopS hm ε t f)
        = 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f) := by
      rw [h1, h2, h3, h4]
    calc TopS hm ε t f = 𝓕⁻ (𝓕 (TopS hm ε t f)) :=
          (FourierTransform.fourierInv_fourier_eq _).symm
      _ = 𝓕⁻ (𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f)) := by
          rw [hF]
      _ = _ := FourierTransform.fourierInv_fourier_eq _
  rw [hEq, SchwartzMap.convolution_apply]
  show (∫ y : Pl, (ContinuousLinearMap.mul ℂ ℂ) ((kernS hm ε t : Pl → ℂ) y)
      ((f : Pl → ℂ) (x - y))) = _
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [ContinuousLinearMap.mul_apply', kernS_apply]

/-! ### The mixed norm and the `L¹L^∞ → L^∞` endpoint -/

theorem mk2_sub_mk2 (a b c d : ℝ) : mk2 a b - mk2 c d = mk2 (a - c) (b - d) := by
  rw [mk2_eq_add, mk2_eq_add, mk2_eq_add, sub_smul, sub_smul]
  abel

theorem sub_mk2 (x : Pl) (w v : ℝ) : x - mk2 w v = mk2 (x 0 - w) (x 1 - v) := by
  conv_lhs => rw [← mk2_coords x]
  rw [mk2_sub_mk2]

theorem continuous_kern {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : Continuous (kern j ε m t) := by
  have h : kern j ε m t = ((kernS hm ε t : SchwartzMap Pl ℂ) : Pl → ℂ) := by
    funext u
    rw [kernS_apply]
  rw [h]
  exact (kernS hm ε t).continuous

/-- Iterated integration on the plane, for `ℝ≥0∞`-valued functions. -/
theorem lintegral_Pl_eq_prod (F : Pl → ℝ≥0∞) (hF : Measurable F) :
    (∫⁻ y : Pl, F y) = ∫⁻ w : ℝ, ∫⁻ v : ℝ, F (mk2 w v) := by
  have hmeas : Measurable fun p : ℝ × ℝ => F (mk2 p.1 p.2) :=
    hF.comp continuous_mk2.measurable
  have h1 : (∫⁻ p : ℝ × ℝ, F (mk2 p.1 p.2)) = ∫⁻ y : Pl, F (mk2 (y 0) (y 1)) :=
    measurePreserving_coords.lintegral_map_equiv (fun p : ℝ × ℝ => F (mk2 p.1 p.2)) coords
  have h2 : (∫⁻ y : Pl, F (mk2 (y 0) (y 1))) = ∫⁻ y : Pl, F y := by
    refine lintegral_congr fun y => ?_
    rw [mk2_coords]
  have h3 : (∫⁻ p : ℝ × ℝ, F (mk2 p.1 p.2)) = ∫⁻ w : ℝ, ∫⁻ v : ℝ, F (mk2 w v) := by
    rw [Measure.volume_eq_prod, lintegral_prod _ hmeas.aemeasurable]
  rw [← h2, ← h1, h3]

/-- The mixed norm `‖f‖_{L¹_{y₁}L^∞_{y₂}}` of §3. -/
noncomputable def mixL1Linf (f : Pl → ℂ) : ℝ≥0∞ :=
  ∫⁻ y : ℝ, ⨆ v : ℝ, ‖f (mk2 y v)‖ₑ

set_option maxHeartbeats 1000000 in
/-- **The `L¹_{y₁}L^∞_{y₂} → L^∞` endpoint of §3.**  The kernel estimate gives the operator bound
with the constant `C(1+stC)B₀2^M(1+M)`, i.e. `2^{j/2}` up to a factor `j`. -/
theorem enorm_TopS_le_mix {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) * mixL1Linf (f : Pl → ℂ) := by
  set C : ℝ := 700000000 * (1 + stC) * B0
    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) with hCdef
  set S : ℝ → ℝ≥0∞ := fun y => ⨆ v : ℝ, ‖(f : Pl → ℂ) (mk2 y v)‖ₑ with hSdef
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hFcont : Continuous fun y : Pl => kern j ε m t y * (f : Pl → ℂ) (x - y) :=
    hkc.mul (f.continuous.comp (continuous_const.sub continuous_id))
  have hFmeas : Measurable fun y : Pl => ‖kern j ε m t y * (f : Pl → ℂ) (x - y)‖ₑ :=
    hFcont.enorm.measurable
  have hkmeas : ∀ w : ℝ, Measurable fun v : ℝ => ‖kern j ε m t (mk2 w v)‖ₑ := by
    intro w
    refine (Continuous.enorm ?_).measurable
    exact hkc.comp (continuous_mk2.comp (continuous_const.prodMk continuous_id))
  have hinner : ∀ w : ℝ,
      (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v) * (f : Pl → ℂ) (x - mk2 w v)‖ₑ)
        ≤ ENNReal.ofReal C * S (x 0 - w) := by
    intro w
    have hstep : ∀ v : ℝ, ‖kern j ε m t (mk2 w v) * (f : Pl → ℂ) (x - mk2 w v)‖ₑ
        ≤ ‖kern j ε m t (mk2 w v)‖ₑ * S (x 0 - w) := by
      intro v
      rw [enorm_mul]
      gcongr
      rw [sub_mk2, hSdef]
      exact le_iSup (fun v' : ℝ => ‖(f : Pl → ℂ) (mk2 (x 0 - w) v')‖ₑ) (x 1 - v)
    refine le_trans (lintegral_mono hstep) ?_
    rw [lintegral_mul_const _ (hkmeas w)]
    gcongr
    exact lintegral_norm_kern_le hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL w
  have htrans : (∫⁻ w : ℝ, S (x 0 - w)) = ∫⁻ y : ℝ, S y := by
    have h1 : (∫⁻ w : ℝ, S (x 0 - w)) = ∫⁻ w : ℝ, S (x 0 + w) := by
      have h := lintegral_neg_eq_self (μ := (volume : Measure ℝ))
        (fun w : ℝ => S (x 0 + w))
      simpa [sub_eq_add_neg] using h
    rw [h1]
    exact lintegral_add_left_eq_self S (x 0)
  calc ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ
      = ‖∫ y : Pl, kern j ε m t y * (f : Pl → ℂ) (x - y)‖ₑ := by
        rw [TopS_eq_convolution]
    _ ≤ ∫⁻ y : Pl, ‖kern j ε m t y * (f : Pl → ℂ) (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ = ∫⁻ w : ℝ, ∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v) * (f : Pl → ℂ) (x - mk2 w v)‖ₑ :=
        lintegral_Pl_eq_prod _ hFmeas
    _ ≤ ∫⁻ w : ℝ, ENNReal.ofReal C * S (x 0 - w) := lintegral_mono hinner
    _ = ENNReal.ofReal C * ∫⁻ w : ℝ, S (x 0 - w) :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ = ENNReal.ofReal C * mixL1Linf (f : Pl → ℂ) := by
        rw [htrans, mixL1Linf, hSdef]

/-! ### The tensor form of the endpoint, and the one-dimensional weight -/

/-- The endpoint estimate for a product `T_tf · T_tg`, i.e. for `𝒯_j(f ⊗ g)`. -/
theorem enorm_TopS_mul_le_mix {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    (f g : SchwartzMap Pl ℂ) (x : Pl) :
    ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) ^ 2
          * (mixL1Linf (f : Pl → ℂ) * mixL1Linf (g : Pl → ℂ)) := by
  have h1 := enorm_TopS_le_mix hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL f x
  have h2 := enorm_TopS_le_mix hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL g x
  rw [enorm_mul]
  refine le_trans (mul_le_mul' h1 h2) (le_of_eq ?_)
  ring

/-- The weight of §3 with the full separation `|y - z|` replaced by the separation `|y₁ - z₁|` of
the first coordinates. -/
noncomputable def wMass1 (gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ x : Pl2, ‖F x‖ₑ ^ (2 : ℝ) * ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1))

/-- **The one-dimensional weight dominates.**  Since `|y₁ - z₁| ≤ |y - z|` and the exponent is
negative, replacing the separation by the separation of the first coordinates only increases the
weighted mass. -/
theorem wMass_le_wMass1 {gam : ℝ} (hgam : 1 / 2 < gam) (F : Pl2 → ℂ) :
    wMass gam F ≤ wMass1 gam F := by
  rw [wMass, wMass1]
  refine lintegral_mono fun x => ?_
  have hcoord : ‖(sepCLM x) 0‖ ≤ ‖sepCLM x‖ := by
    have hsq : ‖sepCLM x‖ ^ 2 = (sepCLM x) 0 ^ 2 + (sepCLM x) 1 ^ 2 := norm_sq_two _
    have h1 : ‖(sepCLM x) 0‖ = |(sepCLM x) 0| := rfl
    rw [h1]
    nlinarith [abs_nonneg ((sepCLM x) 0), norm_nonneg (sepCLM x), sq_abs ((sepCLM x) 0),
      sq_nonneg ((sepCLM x) 1)]
  have hle : ‖(sepCLM x) 0‖ₑ ≤ ‖sepCLM x‖ₑ := by
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal hcoord
  have hc : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
  have hstep : ‖sepCLM x‖ₑ ^ (-(2 * gam - 1)) ≤ ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1)) := by
    rw [ENNReal.rpow_neg, ENNReal.rpow_neg]
    exact ENNReal.inv_le_inv.mpr (ENNReal.rpow_le_rpow hle hc)
  exact mul_le_mul' (le_refl _) hstep

/-! ### The bilinear operator on `ℝ⁴` and its endpoint -/

theorem lintegral_sub_left_eq_self' (g : ℝ → ℝ≥0∞) (c : ℝ) :
    (∫⁻ w : ℝ, g (c - w)) = ∫⁻ w : ℝ, g w := by
  have h1 : (∫⁻ w : ℝ, g (c - w)) = ∫⁻ w : ℝ, g (c + w) := by
    have h := lintegral_neg_eq_self (μ := (volume : Measure ℝ)) (fun w : ℝ => g (c + w))
    simpa [sub_eq_add_neg] using h
  rw [h1]
  exact lintegral_add_left_eq_self g c

/-- The bilinear operator `𝒯_j` of §3, defined by its kernel `k_{j,t}(x-y)k_{j,t}(x-z)`. -/
noncomputable def Top2 (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (F : Pl2 → ℂ) (x : Pl) : ℂ :=
  ∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q

/-- The mixed norm `‖F‖_{L¹_{(y₁,z₁)}L^∞_{(y₂,z₂)}}` on `ℝ⁴`, in iterated form. -/
noncomputable def mix2 (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ⨆ y2 : ℝ, ⨆ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ

set_option maxHeartbeats 1000000 in
/-- **The `L¹L^∞ → L^∞` endpoint of §3 for `𝒯_j`**, the paper's (3.14): the kernel factorizes, so
the single-kernel estimate applies twice. -/
theorem enorm_Top2_le_mix2 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    {F : Pl2 → ℂ} (hF : Measurable F) (x : Pl) :
    ‖Top2 j ε m t F x‖ₑ
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * mix2 F := by
  classical
  set C : ℝ := 700000000 * (1 + stC) * B0
    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) with hCdef
  set K : Pl → ℝ≥0∞ := fun u => ‖kern j ε m t u‖ₑ with hKdef
  set S : ℝ → ℝ → ℝ≥0∞ := fun y1 z1 =>
    ⨆ y2 : ℝ, ⨆ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ with hSdef
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hKm : Measurable K := hkc.enorm.measurable
  have hKtop : ∀ u : Pl, K u ≠ ⊤ := by
    intro u
    rw [hKdef]
    exact enorm_ne_top
  have hCtop : ENNReal.ofReal C ≠ ⊤ := ENNReal.ofReal_ne_top
  -- the kernel estimate, in the translated form
  have hKbd : ∀ c : ℝ, (∫⁻ v : ℝ, K (x - mk2 c v)) ≤ ENNReal.ofReal C := by
    intro c
    have hpt : ∀ v : ℝ, K (x - mk2 c v) = (fun u : ℝ => K (mk2 (x 0 - c) u)) (x 1 - v) := by
      intro v
      rw [sub_mk2]
    rw [lintegral_congr hpt, lintegral_sub_left_eq_self' (fun u : ℝ => K (mk2 (x 0 - c) u)) (x 1)]
    exact lintegral_norm_kern_le hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL (x 0 - c)
  have hKmk2 : ∀ c : ℝ, Measurable fun v : ℝ => K (x - mk2 c v) := by
    intro c
    exact hKm.comp (measurable_const.sub
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_id)))
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have hmeasPl2 : Measurable fun q : Pl2 => K (x - prjL q) * K (x - prjR q) * ‖F q‖ₑ := by
    have h1 : Measurable fun q : Pl2 => K (x - prjL q) :=
      hKm.comp (measurable_const.sub prjL.continuous.measurable)
    have h2 : Measurable fun q : Pl2 => K (x - prjR q) :=
      hKm.comp (measurable_const.sub prjR.continuous.measurable)
    exact (h1.mul h2).mul hF.enorm
  have hmeasPP : Measurable fun w : Pl × Pl => K (x - w.1) * K (x - w.2) * ‖F (pr w.1 w.2)‖ₑ := by
    have h1 : Measurable fun w : Pl × Pl => K (x - w.1) :=
      hKm.comp (measurable_const.sub measurable_fst)
    have h2 : Measurable fun w : Pl × Pl => K (x - w.2) :=
      hKm.comp (measurable_const.sub measurable_snd)
    exact (h1.mul h2).mul ((hF.comp hprmeas).enorm)
  have hmeasOuter : Measurable fun y : Pl =>
      ∫⁻ z : Pl, K (x - y) * K (x - z) * ‖F (pr y z)‖ₑ := hmeasPP.lintegral_prod_right'
  -- the estimate in `z`, for fixed `y`
  have hz : ∀ y : Pl, (∫⁻ z : Pl, K (x - y) * K (x - z) * ‖F (pr y z)‖ₑ)
      ≤ K (x - y) * (ENNReal.ofReal C * ∫⁻ z1 : ℝ, S (y 0) z1) := by
    intro y
    have hmz : Measurable fun z : Pl => K (x - y) * K (x - z) * ‖F (pr y z)‖ₑ := by
      have h1 : Measurable fun z : Pl => K (x - z) :=
        hKm.comp (measurable_const.sub measurable_id)
      have h2 : Measurable fun z : Pl => ‖F (pr y z)‖ₑ :=
        (hF.comp (hprmeas.comp (measurable_const.prodMk measurable_id))).enorm
      exact (measurable_const.mul h1).mul h2
    rw [lintegral_Pl_eq_prod _ hmz]
    have hinnerz : ∀ z1 : ℝ,
        (∫⁻ z2 : ℝ, K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ)
          ≤ K (x - y) * ENNReal.ofReal C * S (y 0) z1 := by
      intro z1
      have hbd : ∀ z2 : ℝ, K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ
          ≤ K (x - mk2 z1 z2) * (K (x - y) * S (y 0) z1) := by
        intro z2
        have hFle : ‖F (pr y (mk2 z1 z2))‖ₑ ≤ S (y 0) z1 := by
          have hSval : S (y 0) z1
              = ⨆ y2 : ℝ, ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ := rfl
          rw [hSval]
          calc ‖F (pr y (mk2 z1 z2))‖ₑ
              = ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2))‖ₑ := by rw [mk2_coords]
            _ ≤ ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2'))‖ₑ :=
                le_iSup (fun z2' : ℝ => ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2'))‖ₑ) z2
            _ ≤ ⨆ y2 : ℝ, ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ :=
                le_iSup (fun y2 : ℝ =>
                  ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ) (y 1)
        calc K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ
            ≤ K (x - y) * K (x - mk2 z1 z2) * S (y 0) z1 := mul_le_mul' (le_refl _) hFle
          _ = K (x - mk2 z1 z2) * (K (x - y) * S (y 0) z1) := by ring
      refine le_trans (lintegral_mono hbd) ?_
      rw [lintegral_mul_const _ (hKmk2 z1)]
      calc (∫⁻ z2 : ℝ, K (x - mk2 z1 z2)) * (K (x - y) * S (y 0) z1)
          ≤ ENNReal.ofReal C * (K (x - y) * S (y 0) z1) :=
            mul_le_mul' (hKbd z1) (le_refl _)
        _ = K (x - y) * ENNReal.ofReal C * S (y 0) z1 := by ring
    refine le_trans (lintegral_mono hinnerz) (le_of_eq ?_)
    rw [lintegral_const_mul' _ _ (ENNReal.mul_ne_top (hKtop (x - y)) hCtop), mul_assoc]
  -- assemble
  calc ‖Top2 j ε m t F x‖ₑ
      ≤ ∫⁻ q : Pl2, K (x - prjL q) * K (x - prjR q) * ‖F q‖ₑ := by
        rw [Top2]
        refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
        refine lintegral_mono fun q => ?_
        rw [enorm_mul, enorm_mul]
    _ = ∫⁻ y : Pl, ∫⁻ z : Pl, K (x - y) * K (x - z) * ‖F (pr y z)‖ₑ :=
        (lintegral_pr _ hmeasPl2).symm
    _ = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z : Pl,
          K (x - mk2 y1 y2) * K (x - z) * ‖F (pr (mk2 y1 y2) z)‖ₑ :=
        lintegral_Pl_eq_prod _ hmeasOuter
    _ ≤ ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, K (x - mk2 y1 y2)
          * (ENNReal.ofReal C * ∫⁻ z1 : ℝ, S y1 z1) := by
        refine lintegral_mono fun y1 => lintegral_mono fun y2 => ?_
        have h := hz (mk2 y1 y2)
        rw [mk2_apply_zero] at h
        exact h
    _ ≤ ∫⁻ y1 : ℝ, ENNReal.ofReal C * (ENNReal.ofReal C * ∫⁻ z1 : ℝ, S y1 z1) := by
        refine lintegral_mono fun y1 => ?_
        rw [lintegral_mul_const _ (hKmk2 y1)]
        exact mul_le_mul' (hKbd y1) (le_refl _)
    _ = ENNReal.ofReal C ^ 2 * ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, S y1 z1 := by
        rw [← lintegral_const_mul' (ENNReal.ofReal C ^ 2)
          (fun y1 : ℝ => ∫⁻ z1 : ℝ, S y1 z1) (ENNReal.pow_ne_top hCtop)]
        refine lintegral_congr fun y1 => ?_
        rw [pow_two, mul_assoc]
    _ = ENNReal.ofReal C ^ 2 * mix2 F := by
        rw [mix2, hSdef]

/-! ### `𝒯_j` on a tensor is the product of the two single-scale operators -/

theorem TopS_eq_conv_left {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x = ∫ y : Pl, kern j ε m t (x - y) * (f : Pl → ℂ) y := by
  rw [TopS_eq_convolution hm ε t f x]
  have h := integral_sub_left_eq_self
    (fun y : Pl => kern j ε m t (x - y) * (f : Pl → ℂ) y) (volume : Measure Pl) x
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [sub_sub_cancel]

/-- **The bilinear operator on a tensor.** `𝒯_j(f ⊗ g) = T_tf · T_tg`, which is the
bilinearization identity of §3. -/
theorem Top2_tens {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) (x : Pl) :
    Top2 j ε m t (tens f g : Pl2 → ℂ) x
      = (TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x := by
  have hchange : (∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
        * (tens f g : Pl2 → ℂ) q)
      = ∫ w : Pl × Pl, (kern j ε m t (x - w.1) * (f : Pl → ℂ) w.1)
          * (kern j ε m t (x - w.2) * (g : Pl → ℂ) w.2) := by
    rw [← measurePreserving_prPair.integral_comp
      (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toHomeomorph.measurableEmbedding
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
        * (tens f g : Pl2 → ℂ) q)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
    show kern j ε m t (x - prjL (pr w.1 w.2)) * kern j ε m t (x - prjR (pr w.1 w.2))
        * (tens f g : Pl2 → ℂ) (pr w.1 w.2)
      = (kern j ε m t (x - w.1) * (f : Pl → ℂ) w.1)
          * (kern j ε m t (x - w.2) * (g : Pl → ℂ) w.2)
    rw [prjL_pr, prjR_pr, tens_apply_pr]
    ring
  rw [Top2, hchange, Measure.volume_eq_prod,
    integral_prod_mul (f := fun y : Pl => kern j ε m t (x - y) * (f : Pl → ℂ) y)
      (g := fun z : Pl => kern j ε m t (x - z) * (g : Pl → ℂ) z),
    TopS_eq_conv_left hm ε t f x, TopS_eq_conv_left hm ε t g x]

/-! ### The convolution representation of `𝒯_j` on `ℝ⁴` -/

theorem pr_sub (a b c d : Pl) : pr a b - pr c d = pr (a - c) (b - d) := rfl

instance instIsNegInvariantPl2 : (volume : Measure Pl2).IsNegInvariant :=
  MeasureTheory.Measure.IsAddHaarMeasure.isNegInvariant_of_regular _

theorem pr_neg (a b : Pl) : -(pr a b) = pr (-a) (-b) := rfl

theorem pr_prj (q : Pl2) : pr (prjL q) (prjR q) = q := rfl

theorem fourierInv_mfull_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    𝓕⁻ ((mfullS hm ε t : Pl → ℂ)) u = kern j ε m t u := by
  rw [← SchwartzMap.fourierInv_coe]
  exact kernS_apply hm ε t u

/-- The multiplier of `𝒯_j` on `ℝ⁴`: the tensor square of `mfull`. -/
noncomputable def mfull2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl2 ℂ :=
  tens (mfullS hm ε t) (mfullS hm ε t)

/-- The kernel of `𝒯_j` on `ℝ⁴`. -/
noncomputable def kern2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl2 ℂ :=
  𝓕⁻ (mfull2S hm ε t)

theorem kern2S_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u v : Pl) :
    (kern2S hm ε t : Pl2 → ℂ) (pr u v) = kern j ε m t u * kern j ε m t v := by
  rw [kern2S, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, pr_neg, mfull2S,
    fourier_tens, ← Real.fourierInv_eq_fourier_neg, ← Real.fourierInv_eq_fourier_neg,
    fourierInv_mfull_apply, fourierInv_mfull_apply]

theorem hasTemperateGrowth_mfull2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    Function.HasTemperateGrowth ((mfull2S hm ε t : Pl2 → ℂ)) :=
  SchwartzMap.hasTemperateGrowth (mfull2S hm ε t)

/-- The operator `𝒯_j` on `ℝ⁴`, as a Schwartz map. -/
noncomputable def Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  𝓕⁻ (SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F))

theorem Top2S_eq_convolution {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (w : Pl2) :
    (Top2S hm ε t F : Pl2 → ℂ)  w
      = ∫ q : Pl2, (kern2S hm ε t : Pl2 → ℂ) q * (F : Pl2 → ℂ) (w - q) := by
  have h3 : 𝓕 (kern2S hm ε t) = mfull2S hm ε t := by
    rw [kern2S, FourierTransform.fourier_fourierInv_eq]
  have h1 : 𝓕 (Top2S hm ε t F)
      = SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) := by
    rw [Top2S, FourierTransform.fourier_fourierInv_eq]
  have h2 : 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F)
      = SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (𝓕 (kern2S hm ε t)) (𝓕 F) :=
    SchwartzMap.fourier_convolution _ _ _
  have h4 : SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (mfull2S hm ε t) (𝓕 F)
      = SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) := by
    refine SchwartzMap.ext fun ω => ?_
    rw [SchwartzMap.pairing_apply_apply,
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul]
    rfl
  have hEq : Top2S hm ε t F
      = SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F := by
    have hF : 𝓕 (Top2S hm ε t F)
        = 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F) := by
      rw [h1, h2, h3, h4]
    calc Top2S hm ε t F = 𝓕⁻ (𝓕 (Top2S hm ε t F)) :=
          (FourierTransform.fourierInv_fourier_eq _).symm
      _ = 𝓕⁻ (𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F)) := by
          rw [hF]
      _ = _ := FourierTransform.fourierInv_fourier_eq _
  rw [hEq, SchwartzMap.convolution_apply]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  simp only [ContinuousLinearMap.mul_apply']

/-- **The kernel representation of `𝒯_j`.**  The operator defined by the kernel agrees with the
multiplier operator on `ℝ⁴`, restricted to the diagonal. -/
theorem Top2_eq_Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl) :
    Top2 j ε m t (F : Pl2 → ℂ) x = (Top2S hm ε t F : Pl2 → ℂ) (pr x x) := by
  rw [Top2S_eq_convolution, Top2]
  have h := integral_sub_left_eq_self
    (fun q : Pl2 => (kern2S hm ε t : Pl2 → ℂ) q * (F : Pl2 → ℂ) (pr x x - q))
    (volume : Measure Pl2) (pr x x)
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  have hk : (kern2S hm ε t : Pl2 → ℂ) (pr x x - q)
      = kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) := by
    have hq : (pr x x - q : Pl2) = pr (x - prjL q) (x - prjR q) := by
      conv_lhs => rw [← pr_prj q]
      rw [pr_sub]
    rw [hq, kern2S_apply]
  simp only [sub_sub_cancel, hk]

/-! ### The frequency side: `𝒯_j` is the inverse transform of `S[F,b]` -/

/-- The shear `(u,v) ↦ (u+v, v)` of `ℝ² × ℝ²`, as a measurable equivalence. -/
def shiftME : (Pl × Pl) ≃ᵐ (Pl × Pl) where
  toFun := fun q => (q.1 + q.2, q.2)
  invFun := fun q => (q.1 - q.2, q.2)
  left_inv := fun q => by simp
  right_inv := fun q => by simp
  measurable_toFun := (measurable_fst.add measurable_snd).prodMk measurable_snd
  measurable_invFun := (measurable_fst.sub measurable_snd).prodMk measurable_snd

@[simp] theorem shiftME_apply (q : Pl × Pl) : shiftME q = (q.1 + q.2, q.2) := rfl

theorem measurePreserving_shiftME :
    MeasurePreserving shiftME (volume : Measure (Pl × Pl)) (volume : Measure (Pl × Pl)) := by
  have h := measurePreserving_add_prod (volume : Measure Pl) (volume : Measure Pl)
  rw [Measure.volume_eq_prod]
  exact h

theorem integrable_ee_mfull_prod {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (Ff : SchwartzMap Pl2 ℂ) (x : Pl) :
    Integrable (fun q : Pl × Pl => (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)))
      (volume : Measure (Pl × Pl)) := by
  have hFint : Integrable (fun q : Pl × Pl => (Ff : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) :=
    measurePreserving_prPair.integrable_comp_of_integrable Ff.integrable
  have hmc : Continuous (mfull j ε m t) := (contDiff_mfull hm ε t).continuous
  have hcont : Continuous fun q : Pl × Pl =>
      (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)) := by
    have h1 : Continuous fun q : Pl × Pl => ee (-(inner ℝ q.1 x : ℝ)) :=
      continuous_ee.comp ((continuous_fst.inner continuous_const).neg)
    have h2 : Continuous fun q : Pl × Pl => ee (-(inner ℝ q.2 x : ℝ)) :=
      continuous_ee.comp ((continuous_snd.inner continuous_const).neg)
    have h3 : Continuous fun q : Pl × Pl => mfull j ε m t q.1 := hmc.comp continuous_fst
    have h4 : Continuous fun q : Pl × Pl => mfull j ε m t q.2 := hmc.comp continuous_snd
    have h5 : Continuous fun q : Pl × Pl => (Ff : Pl2 → ℂ) (pr q.1 q.2) :=
      Ff.continuous.comp continuous_prPair
    exact (h1.mul h2).mul ((h3.mul h4).mul h5)
  refine Integrable.mono' ((hFint.norm).const_mul (B0 * B0)) hcont.aestronglyMeasurable
    (Filter.Eventually.of_forall fun q => ?_)
  have hb1 : ‖mfull j ε m t q.1‖ ≤ B0 := norm_mfull_le hm ε t q.1
  have hb2 : ‖mfull j ε m t q.2‖ ≤ B0 := norm_mfull_le hm ε t q.2
  have hnn : (0 : ℝ) ≤ ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := norm_nonneg _
  have hB0 : (0 : ℝ) ≤ B0 := le_trans (norm_nonneg _) hb1
  calc ‖(ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2))‖
      = ‖mfull j ε m t q.1‖ * ‖mfull j ε m t q.2‖ * ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := by
        rw [norm_mul, norm_mul, norm_mul, norm_mul, norm_ee, norm_ee, one_mul, one_mul, mul_assoc]
    _ ≤ B0 * B0 * ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := by
        refine mul_le_mul_of_nonneg_right ?_ hnn
        exact mul_le_mul hb1 hb2 (norm_nonneg _) hB0

set_option maxHeartbeats 1000000 in
/-- **The frequency-side identification.**  The kernel operator `𝒯_j` is the inverse Fourier
transform of the §4 operator `S[F, bprod m]`. -/
theorem Top2S_diag_eq_fourierInv_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl) :
    (Top2S hm ε t F : Pl2 → ℂ) (pr x x)
      = 𝓕⁻ (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) x := by
  classical
  set Ff : SchwartzMap Pl2 ℂ := 𝓕 F with hFfdef
  have hFf : ∀ ω : Pl2, 𝓕 ((F : Pl2 → ℂ)) ω = (Ff : Pl2 → ℂ) ω := by
    intro ω
    rw [hFfdef, SchwartzMap.fourier_coe]
  set G : Pl × Pl → ℂ := fun q =>
    ee (-(inner ℝ q.1 x : ℝ)) * (mfull j ε m t (q.1 - q.2) * mfull j ε m t q.2
      * (Ff : Pl2 → ℂ) (pr (q.1 - q.2) q.2)) with hGdef
  set W : Pl × Pl → ℂ := fun q =>
    (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
      * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)) with hWdef
  -- `W = G ∘ shiftME`
  have hWG : ∀ q : Pl × Pl, W q = G (shiftME q) := by
    intro q
    have h1 : (q.1 + q.2 - q.2 : Pl) = q.1 := by abel
    have harg : (inner ℝ (q.1 + q.2 : Pl) x : ℝ)
        = (inner ℝ q.1 x : ℝ) + (inner ℝ q.2 x : ℝ) := inner_add_left _ _ _
    rw [hWdef, hGdef]
    show (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2))
      = ee (-(inner ℝ (q.1 + q.2 : Pl) x : ℝ))
        * (mfull j ε m t (q.1 + q.2 - q.2) * mfull j ε m t q.2
            * (Ff : Pl2 → ℂ) (pr (q.1 + q.2 - q.2) q.2))
    rw [h1, harg, show -((inner ℝ q.1 x : ℝ) + (inner ℝ q.2 x : ℝ))
      = -(inner ℝ q.1 x : ℝ) + -(inner ℝ q.2 x : ℝ) by ring, ee_add]
  have hWint : Integrable W (volume : Measure (Pl × Pl)) := by
    rw [hWdef]
    exact integrable_ee_mfull_prod hm ε t Ff x
  have hGint : Integrable G (volume : Measure (Pl × Pl)) := by
    have hcomp : Integrable (G ∘ shiftME) (volume : Measure (Pl × Pl)) := by
      have hfun : (G ∘ shiftME) = W := by
        funext q
        exact (hWG q).symm
      rw [hfun]
      exact hWint
    exact (measurePreserving_shiftME.integrable_comp_emb shiftME.measurableEmbedding).mp hcomp
  -- Step 1: the left-hand side as an integral over `Pl × Pl`
  have hL : (Top2S hm ε t F : Pl2 → ℂ) (pr x x) = ∫ q : Pl × Pl, W q := by
    rw [Top2S, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl2,
      ← measurePreserving_prPair.integral_comp
        (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toHomeomorph.measurableEmbedding
        (fun v : Pl2 => ee (inner ℝ v (-(pr x x)))
          * ((SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) :
              SchwartzMap Pl2 ℂ) : Pl2 → ℂ) v)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    show ee (inner ℝ (pr q.1 q.2 : Pl2) (-(pr x x)))
        * ((SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) :
            SchwartzMap Pl2 ℂ) : Pl2 → ℂ) (pr q.1 q.2) = W q
    rw [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul,
      mfull2S]
    have harg : (inner ℝ (pr q.1 q.2 : Pl2) (-(pr x x)) : ℝ)
        = -(inner ℝ q.1 x : ℝ) + -(inner ℝ q.2 x : ℝ) := by
      rw [pr_neg, inner_pr, inner_neg_right, inner_neg_right]
    rw [harg, ee_add, tens_apply_pr, mfullS_apply, mfullS_apply, hWdef]
  -- Step 2: the change of variables
  have hchange : (∫ q : Pl × Pl, W q) = ∫ q : Pl × Pl, G q := by
    rw [← measurePreserving_shiftME.integral_comp' G]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    exact hWG q
  -- Step 3: Fubini
  have hfub : (∫ q : Pl × Pl, G q) = ∫ ξ : Pl, ∫ η : Pl, G (ξ, η) := by
    rw [Measure.volume_eq_prod] at hGint ⊢
    have hG' : Integrable (Function.uncurry fun ξ η => G (ξ, η))
        ((volume : Measure Pl).prod (volume : Measure Pl)) := hGint
    exact (integral_integral hG').symm
  -- Step 4: the inner integral
  have hinner : ∀ ξ : Pl, (∫ η : Pl, G (ξ, η))
      = ee (-(inner ℝ ξ x : ℝ)) * Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
    intro ξ
    rw [Sop, SopK, ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show ee (-(inner ℝ ξ x : ℝ)) * (mfull j ε m t (ξ - η) * mfull j ε m t η
        * (Ff : Pl2 → ℂ) (pr (ξ - η) η))
      = ee (-(inner ℝ ξ x : ℝ)) * (phase ε t ξ η * bprod m t ξ η
          * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η))
    rw [phase_bprod_eq hm ε t ξ η, hFf]
  -- Step 5: the right-hand side
  have hR : 𝓕⁻ (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) x
      = ∫ ξ : Pl, ee (-(inner ℝ ξ x : ℝ)) * Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
    rw [Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    simp only [inner_neg_right]
  rw [hL, hchange, hfub, hR]
  exact integral_congr_ae (Filter.Eventually.of_forall hinner)

/-! ### `S[F, bprod m]` is continuous and integrable -/

theorem norm_pr_ge_right (a b : Pl) : ‖b‖ ≤ ‖(pr a b : Pl2)‖ := by
  have h : ‖(pr a b : Pl2)‖ ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2 := norm_pr_sq a b
  nlinarith [norm_nonneg a, norm_nonneg b, norm_nonneg (pr a b : Pl2)]

/-- The `ℝ⁴` multiplier applied to `𝓕F`, as a Schwartz function. -/
noncomputable def Hmul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F)

theorem Hmul_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (ω : Pl2) :
    (Hmul hm ε t F : Pl2 → ℂ)  ω
      = (mfull2S hm ε t : Pl2 → ℂ) ω * 𝓕 ((F : Pl2 → ℂ)) ω := by
  rw [Hmul, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul,
    SchwartzMap.fourier_coe]

theorem Sop_eq_integral_Hmul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t
      = ∫ η : Pl, (Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η) := by
  rw [Sop, SopK]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  simp only [Hmul_apply, mfull2S, tens_apply_pr, mfullS_apply]
  rw [phase_bprod_eq hm ε t ξ η]

/-- The decay of a Schwartz function on `ℝ⁴`, in the form needed for the majorant. -/
theorem exists_decay_Pl2 (H : SchwartzMap Pl2 ℂ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ w : Pl2, ‖(H : Pl2 → ℂ) w‖ * (1 + ‖w‖) ^ (3 : ℕ) ≤ K := by
  refine ⟨2 ^ (3 : ℕ) * (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H, ?_, ?_⟩
  · have h : (0 : ℝ) ≤ (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
        (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H := apply_nonneg _ _
    positivity
  · intro w
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((3 : ℕ), (0 : ℕ)))
      (le_refl 3) (le_refl 0) H w
    rw [norm_iteratedFDeriv_zero] at h
    rw [mul_comm]
    exact h

theorem integrable_inv_one_add_norm_cube :
    Integrable (fun η : Pl => ((1 + ‖η‖) ^ (3 : ℕ))⁻¹) (volume : Measure Pl) := by
  have hrank : ((Module.finrank ℝ Pl : ℕ) : ℝ) < 3 := by
    rw [finrank_euclideanSpace_fin]
    norm_num
  have h := integrable_one_add_norm (E := Pl) (μ := (volume : Measure Pl)) (r := 3) hrank
  have hfun : (fun η : Pl => (1 + ‖η‖) ^ (-(3 : ℝ)))
      = fun η : Pl => ((1 + ‖η‖) ^ (3 : ℕ))⁻¹ := by
    funext η
    have h1 : (0 : ℝ) < 1 + ‖η‖ := by positivity
    rw [Real.rpow_neg h1.le, ← Real.rpow_natCast (1 + ‖η‖) 3]
    norm_num
  rw [← hfun]
  exact h

theorem continuous_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    Continuous fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
  obtain ⟨K, hK0, hK⟩ := exists_decay_Pl2 (Hmul hm ε t F)
  have hrepr : (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t)
      = fun ξ : Pl => ∫ η : Pl, (Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η) := by
    funext ξ
    exact Sop_eq_integral_Hmul hm ε t F ξ
  rw [hrepr]
  have hcontpr : ∀ ξ : Pl, Continuous fun η : Pl => (pr (ξ - η) η : Pl2) :=
    fun ξ => continuous_prPair.comp ((continuous_const.sub continuous_id).prodMk continuous_id)
  have hcontpr' : ∀ η : Pl, Continuous fun ξ : Pl => (pr (ξ - η) η : Pl2) :=
    fun η => continuous_prPair.comp ((continuous_id.sub continuous_const).prodMk continuous_const)
  refine continuous_of_dominated (bound := fun η : Pl => K * ((1 + ‖η‖) ^ (3 : ℕ))⁻¹) ?_ ?_ ?_ ?_
  · intro ξ
    exact ((Hmul hm ε t F).continuous.comp (hcontpr ξ)).aestronglyMeasurable
  · intro ξ
    filter_upwards with η
    have h1 := hK (pr (ξ - η) η)
    have h2 : (1 : ℝ) + ‖η‖ ≤ 1 + ‖(pr (ξ - η) η : Pl2)‖ := by
      linarith [norm_pr_ge_right (ξ - η) η]
    have h3 : (0 : ℝ) < (1 + ‖η‖) ^ (3 : ℕ) := by positivity
    have h4 : ((1 + ‖η‖) ^ (3 : ℕ)) ≤ ((1 + ‖(pr (ξ - η) η : Pl2)‖) ^ (3 : ℕ)) := by
      refine pow_le_pow_left₀ (by positivity) h2 3
    have h5 : ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ * ((1 + ‖η‖) ^ (3 : ℕ)) ≤ K := by
      refine le_trans (mul_le_mul_of_nonneg_left h4 (norm_nonneg _)) h1

    rw [← le_div_iff₀ h3] at h5
    refine le_trans h5 (le_of_eq ?_)
    field_simp
  · exact (integrable_inv_one_add_norm_cube).const_mul K
  · filter_upwards with η
    exact (Hmul hm ε t F).continuous.comp (hcontpr' η)

theorem integrable_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    Integrable (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) (volume : Measure Pl) := by
  refine ⟨(continuous_Sop hm ε t F).aestronglyMeasurable, ?_⟩
  have hmeas : Measurable fun w : Pl2 => ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ :=
    (Hmul hm ε t F).continuous.enorm.measurable
  have hbd : ∀ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ
      ≤ ∫⁻ η : Pl, ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ₑ := by
    intro ξ
    rw [Sop_eq_integral_Hmul hm ε t F ξ]
    exact enorm_integral_le_lintegral_enorm _
  have hfin : (∫⁻ w : Pl2, ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ) < ⊤ :=
    (Hmul hm ε t F).integrable.hasFiniteIntegral
  calc (∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ)
      ≤ ∫⁻ ξ : Pl, ∫⁻ η : Pl, ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ₑ :=
        lintegral_mono hbd
    _ = ∫⁻ w : Pl2, ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ :=
        lintegral_pr_shift (fun w => ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ) hmeas
    _ < ⊤ := hfin

/-! ### The `L²` endpoint of §3 for `𝒯_j` -/

/-- The diagonal embedding `ℝ² → ℝ⁴`. -/
def diagCLM : Pl →L[ℝ] Pl2 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toContinuousLinearMap.comp
    ((ContinuousLinearMap.id ℝ Pl).prod (ContinuousLinearMap.id ℝ Pl))

@[simp] theorem diagCLM_apply (x : Pl) : (diagCLM x : Pl2) = pr x x := rfl

theorem diag_upper : ∃ (k : ℕ) (C : ℝ), ∀ x : Pl, ‖x‖ ≤ C * (1 + ‖(diagCLM x : Pl2)‖) ^ k := by
  refine ⟨1, 1, fun x => ?_⟩
  have h := norm_pr_ge_right x x
  rw [diagCLM_apply]
  simp only [pow_one, one_mul]
  linarith

/-- The restriction of a Schwartz function on `ℝ⁴` to the diagonal. -/
noncomputable def diagS (H : SchwartzMap Pl2 ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.compCLM ℝ (g := (diagCLM : Pl → Pl2)) diagCLM.hasTemperateGrowth diag_upper H

@[simp] theorem diagS_apply (H : SchwartzMap Pl2 ℂ) (x : Pl) :
    (diagS H : Pl → ℂ) x = (H : Pl2 → ℂ) (pr x x) := rfl

theorem fourier_diagS_Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ))
      = fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
  set g : Pl → ℂ := fun ξ => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t with hgdef
  have hu : ((diagS (Top2S hm ε t F) : Pl → ℂ)) = 𝓕⁻ g := by
    funext x
    rw [diagS_apply, hgdef]
    exact Top2S_diag_eq_fourierInv_Sop hm ε t F x
  have hginv : Integrable (𝓕 g) (volume : Measure Pl) := by
    have hpt : (𝓕 g) = fun w : Pl => ((diagS (Top2S hm ε t F) : Pl → ℂ)) (-w) := by
      funext w
      rw [hu, Real.fourierInv_eq_fourier_neg, neg_neg]
    rw [hpt]
    exact ((diagS (Top2S hm ε t F)).integrable).comp_neg
  rw [hu]
  have hgc : Continuous g := by
    rw [hgdef]
    exact continuous_Sop hm ε t F
  have hgi : Integrable g (volume : Measure Pl) := by
    rw [hgdef]
    exact integrable_Sop hm ε t F
  exact hgc.fourier_fourierInv_eq hgi hginv

/-- **The `L²` transfer for `𝒯_j`.**  Plancherel identifies the `L²` norm of `𝒯_jF(·,t)` with that
of the §4 operator `S[F, bprod m](·,t)`. -/
theorem lintegral_enorm_sq_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
  have h1 : (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(diagS (Top2S hm ε t F) : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
    refine lintegral_congr fun x => ?_
    rw [Top2_eq_Top2S hm ε t F x, diagS_apply]
  have h2 : (∫⁻ ξ : Pl, ‖𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ)) ξ‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(diagS (Top2S hm ε t F) : Pl → ℂ) x‖ₑ ^ (2 : ℝ) :=
    lintegral_enorm_sq_fourier_schwartz_Pl (diagS (Top2S hm ε t F))
  have h3 : (∫⁻ ξ : Pl, ‖𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ)) ξ‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
    rw [fourier_diagS_Top2S hm ε t F]
  rw [h1, ← h2, h3]

/-- **Proposition 3.1 for `𝒯_j`**: the `L²` endpoint of §3 in physical space, for arbitrary
Schwartz data on `ℝ⁴`. -/
theorem prop31_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam F := by
  have hstep : ∀ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
    intro t _
    exact lintegral_enorm_sq_Top2 hm ε t F
  rw [Finset.sum_congr rfl hstep]
  exact prop31_bprod hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
    hNa hM hcard hcount F

/-! ### `𝒯_j` is continuous on `L¹(ℝ⁴)` -/

/-- The `L¹` norm of the multiplier, which bounds the kernel. -/
noncomputable def Ckern (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) : ℝ :=
  ∫ ω : Pl, ‖mfull j ε m t ω‖

theorem integrable_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    Integrable (mfull j ε m t) (volume : Measure Pl) :=
  ((contDiff_mfull hm ε t).continuous).integrable_of_hasCompactSupport
    (hasCompactSupport_mfull hm ε t)

theorem Ckern_nonneg (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) : 0 ≤ Ckern j ε m t := by
  rw [Ckern]
  exact integral_nonneg fun ω => norm_nonneg _

theorem norm_kern_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    ‖kern j ε m t u‖ ≤ Ckern j ε m t := by
  rw [kern, Ckern]
  refine le_trans (norm_integral_le_integral_norm _) (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
  simp only [norm_mul, norm_ee, one_mul]

theorem integrable_Top2_integrand {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hh : Integrable h (volume : Measure Pl2))
    (x : Pl) :
    Integrable (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hmeas : AEStronglyMeasurable
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q)
      (volume : Measure Pl2) := by
    have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    exact h1.aestronglyMeasurable.mul hh.aestronglyMeasurable
  refine Integrable.mono' ((hh.norm).const_mul (Ckern j ε m t * Ckern j ε m t)) hmeas
    (Filter.Eventually.of_forall fun q => ?_)
  have hb1 := norm_kern_le hm ε t (x - prjL q)
  have hb2 := norm_kern_le hm ε t (x - prjR q)
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
      = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
        rw [norm_mul, norm_mul]
    _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
        refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
        exact mul_le_mul hb1 hb2 (norm_nonneg _) hC

/-- **`𝒯_j` is bounded from `L¹(ℝ⁴)` to `L^∞`.** -/
theorem norm_Top2_le_L1 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hh : Integrable h (volume : Measure Pl2))
    (x : Pl) :
    ‖Top2 j ε m t h x‖ ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h q‖ := by
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  rw [Top2]
  refine le_trans (norm_integral_le_integral_norm _) ?_
  have hbd : ∀ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
      ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
    intro q
    have hb1 := norm_kern_le hm ε t (x - prjL q)
    have hb2 := norm_kern_le hm ε t (x - prjR q)
    calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
        = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
          rw [norm_mul, norm_mul]
      _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
          refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
          exact mul_le_mul hb1 hb2 (norm_nonneg _) hC
  have hint1 : Integrable
      (fun q : Pl2 => ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖)
      (volume : Measure Pl2) := (integrable_Top2_integrand hm ε t hh x).norm
  have hint2 : Integrable (fun q : Pl2 => Ckern j ε m t * Ckern j ε m t * ‖h q‖)
      (volume : Measure Pl2) := (hh.norm).const_mul _
  calc (∫ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖)
      ≤ ∫ q : Pl2, Ckern j ε m t * Ckern j ε m t * ‖h q‖ :=
        integral_mono hint1 hint2 hbd
    _ = Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h q‖ := integral_const_mul _ _

theorem Top2_sub {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h1 h2 : Pl2 → ℂ}
    (hh1 : Integrable h1 (volume : Measure Pl2)) (hh2 : Integrable h2 (volume : Measure Pl2))
    (x : Pl) :
    Top2 j ε m t (h1 - h2) x = Top2 j ε m t h1 x - Top2 j ε m t h2 x := by
  rw [Top2, Top2, Top2, ← integral_sub (integrable_Top2_integrand hm ε t hh1 x)
    (integrable_Top2_integrand hm ε t hh2 x)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  show kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * (h1 q - h2 q)
    = kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h1 q
      - kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h2 q
  ring

/-! ### Continuity of `𝒯_j` and the transfer of the `L²` estimate along `L¹` limits -/

theorem continuous_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ}
    (hh : Integrable h (volume : Measure Pl2)) :
    Continuous (Top2 j ε m t h) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  refine continuous_of_dominated (bound := fun q : Pl2 => Ckern j ε m t * Ckern j ε m t * ‖h q‖)
    ?_ ?_ ((hh.norm).const_mul _) ?_
  · intro x
    exact (integrable_Top2_integrand hm ε t hh x).aestronglyMeasurable
  · intro x
    filter_upwards with q
    have hb1 := norm_kern_le hm ε t (x - prjL q)
    have hb2 := norm_kern_le hm ε t (x - prjR q)
    calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
        = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
          rw [norm_mul, norm_mul]
      _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
          refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
          exact mul_le_mul hb1 hb2 (norm_nonneg _) hC
  · filter_upwards with q
    have h1 : Continuous fun x : Pl => kern j ε m t (x - prjL q) :=
      hkc.comp (continuous_id.sub continuous_const)
    have h2 : Continuous fun x : Pl => kern j ε m t (x - prjR q) :=
      hkc.comp (continuous_id.sub continuous_const)
    exact (h1.mul h2).mul continuous_const

/-- If `h n → H` in `L¹(ℝ⁴)`, then `𝒯_j h n → 𝒯_j H` pointwise. -/
theorem tendsto_Top2_of_tendsto_L1 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : ℕ → Pl2 → ℂ} {H : Pl2 → ℂ}
    (hhn : ∀ n, Integrable (h n) (volume : Measure Pl2))
    (hH : Integrable H (volume : Measure Pl2))
    (hconv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖h n q - H q‖) Filter.atTop (nhds 0))
    (x : Pl) :
    Filter.Tendsto (fun n => Top2 j ε m t (h n) x) Filter.atTop (nhds (Top2 j ε m t H x)) := by
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  rw [Metric.tendsto_atTop]
  intro δ hδ
  by_cases hCz : Ckern j ε m t * Ckern j ε m t = 0
  · refine ⟨0, fun n _ => ?_⟩
    have hbd : ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := by
      rw [← Top2_sub hm ε t (hhn n) hH x]
      exact norm_Top2_le_L1 hm ε t ((hhn n).sub hH) x
    rw [hCz, zero_mul] at hbd
    have : dist (Top2 j ε m t (h n) x) (Top2 j ε m t H x) = 0 := by
      rw [dist_eq_norm]
      exact le_antisymm hbd (norm_nonneg _)
    rw [this]
    exact hδ
  · have hCpos : 0 < Ckern j ε m t * Ckern j ε m t := by
      rcases lt_or_eq_of_le (by positivity : (0 : ℝ) ≤ Ckern j ε m t * Ckern j ε m t) with h1 | h1
      · exact h1
      · exact absurd h1.symm hCz
    have hδ' : 0 < δ / (Ckern j ε m t * Ckern j ε m t) := by positivity
    rw [Metric.tendsto_atTop] at hconv
    obtain ⟨N, hN⟩ := hconv (δ / (Ckern j ε m t * Ckern j ε m t)) hδ'
    refine ⟨N, fun n hn => ?_⟩
    have hbd : ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := by
      rw [← Top2_sub hm ε t (hhn n) hH x]
      exact norm_Top2_le_L1 hm ε t ((hhn n).sub hH) x
    have hsmall : (∫ q : Pl2, ‖h n q - H q‖) < δ / (Ckern j ε m t * Ckern j ε m t) := by
      have h1 := hN n hn
      rw [Real.dist_eq, sub_zero] at h1
      have h2 : (0 : ℝ) ≤ ∫ q : Pl2, ‖h n q - H q‖ :=
        integral_nonneg fun q => norm_nonneg _
      rw [abs_of_nonneg h2] at h1
      exact h1
    rw [dist_eq_norm]
    calc ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := hbd
      _ < Ckern j ε m t * Ckern j ε m t * (δ / (Ckern j ε m t * Ckern j ε m t)) :=
          mul_lt_mul_of_pos_left hsmall hCpos
      _ = δ := by
          have hne : Ckern j ε m t ≠ 0 := by
            intro hzero
            rw [hzero, mul_zero] at hCpos
            exact absurd hCpos (lt_irrefl 0)
          field_simp

/-! ### Smooth cutoffs on `ℝ⁴` -/

/-- The first coordinate of the separation `y - z`, as a continuous linear functional on `ℝ⁴`. -/
noncomputable def sepFst : Pl2 →L[ℝ] ℝ :=
  (EuclideanSpace.proj (0 : Fin 2)).comp sepCLM

@[simp] theorem sepFst_apply (q : Pl2) : sepFst q = (sepCLM q) 0 := rfl

/-- A smooth cutoff on `ℝ⁴` that vanishes where `|y₁ - z₁| ≤ δ/2` and equals `1` where
`|y₁ - z₁| ≥ δ`. -/
noncomputable def cutDiag (δ : ℝ) (q : Pl2) : ℝ :=
  Real.smoothTransition ((sepFst q ^ 2 - (δ / 2) ^ 2) / (δ ^ 2 - (δ / 2) ^ 2))

theorem contDiff_cutDiag (δ : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutDiag δ) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => sepFst q ^ 2 :=
    (sepFst.contDiff).pow 2
  exact Real.smoothTransition.contDiff.comp ((h1.sub contDiff_const).div_const _)

theorem cutDiag_nonneg (δ : ℝ) (q : Pl2) : 0 ≤ cutDiag δ q := Real.smoothTransition.nonneg _

theorem cutDiag_le_one (δ : ℝ) (q : Pl2) : cutDiag δ q ≤ 1 := Real.smoothTransition.le_one _

theorem cutDiag_eq_one {δ : ℝ} (hδ : 0 < δ) {q : Pl2} (h : δ ≤ |sepFst q|) :
    cutDiag δ q = 1 := by
  have hden : (0 : ℝ) < δ ^ 2 - (δ / 2) ^ 2 := by nlinarith
  rw [cutDiag]
  refine Real.smoothTransition.one_of_one_le ?_
  rw [le_div_iff₀ hden]
  nlinarith [sq_abs (sepFst q), abs_nonneg (sepFst q)]

theorem cutDiag_eq_zero {δ : ℝ} (hδ : 0 < δ) {q : Pl2} (h : |sepFst q| ≤ δ / 2) :
    cutDiag δ q = 0 := by
  have hden : (0 : ℝ) < δ ^ 2 - (δ / 2) ^ 2 := by nlinarith
  rw [cutDiag]
  refine Real.smoothTransition.zero_of_nonpos ?_
  rw [div_nonpos_iff]
  refine Or.inr ⟨?_, le_of_lt hden⟩
  nlinarith [sq_abs (sepFst q), abs_nonneg (sepFst q)]

/-- A smooth cutoff on `ℝ⁴` that equals `1` on the ball of radius `R` and vanishes outside the
ball of radius `2R`. -/
noncomputable def cutBall (R : ℝ) (q : Pl2) : ℝ :=
  Real.smoothTransition ((4 * R ^ 2 - ‖q‖ ^ 2) / (3 * R ^ 2))

theorem contDiff_cutBall (R : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutBall R) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => ‖q‖ ^ 2 := contDiff_norm_sq ℝ
  exact Real.smoothTransition.contDiff.comp ((contDiff_const.sub h1).div_const _)

theorem cutBall_nonneg (R : ℝ) (q : Pl2) : 0 ≤ cutBall R q := Real.smoothTransition.nonneg _

theorem cutBall_le_one (R : ℝ) (q : Pl2) : cutBall R q ≤ 1 := Real.smoothTransition.le_one _

theorem cutBall_eq_one {R : ℝ} (hR : 0 < R) {q : Pl2} (h : ‖q‖ ≤ R) : cutBall R q = 1 := by
  have hden : (0 : ℝ) < 3 * R ^ 2 := by positivity
  rw [cutBall]
  refine Real.smoothTransition.one_of_one_le ?_
  rw [le_div_iff₀ hden]
  nlinarith [norm_nonneg q]

theorem cutBall_eq_zero {R : ℝ} (hR : 0 < R) {q : Pl2} (h : 2 * R ≤ ‖q‖) : cutBall R q = 0 := by
  have hden : (0 : ℝ) < 3 * R ^ 2 := by positivity
  rw [cutBall]
  refine Real.smoothTransition.zero_of_nonpos ?_
  rw [div_nonpos_iff]
  refine Or.inr ⟨?_, le_of_lt hden⟩
  nlinarith [norm_nonneg q, hR]

theorem hasCompactSupport_cutBall {R : ℝ} (hR : 0 < R) : HasCompactSupport (cutBall R) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl2) (2 * R)) fun q hq => ?_
  refine cutBall_eq_zero hR ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hq
  exact le_of_lt (by simpa using not_le.mp (fun hc => hq hc))

/-- The product cutoff: smooth, compactly supported, equal to `1` where `|y₁-z₁| ≥ δ` and
`‖q‖ ≤ R`. -/
noncomputable def cutBoth (δ R : ℝ) (q : Pl2) : ℂ := ((cutDiag δ q * cutBall R q : ℝ) : ℂ)

theorem contDiff_cutBoth (δ R : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutBoth δ R) := by
  have h : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => cutDiag δ q * cutBall R q :=
    (contDiff_cutDiag δ).mul (contDiff_cutBall R)
  exact Complex.ofRealCLM.contDiff.comp h

theorem norm_cutBoth_le_one (δ R : ℝ) (q : Pl2) : ‖cutBoth δ R q‖ ≤ 1 := by
  rw [cutBoth, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (cutDiag_nonneg δ q) (cutBall_nonneg R q))]
  exact mul_le_one₀ (cutDiag_le_one δ q) (cutBall_nonneg R q) (cutBall_le_one R q)

theorem cutBoth_eq_one {δ R : ℝ} (hδ : 0 < δ) (hR : 0 < R) {q : Pl2}
    (h1 : δ ≤ |sepFst q|) (h2 : ‖q‖ ≤ R) : cutBoth δ R q = 1 := by
  rw [cutBoth, cutDiag_eq_one hδ h1, cutBall_eq_one hR h2, mul_one, Complex.ofReal_one]

theorem hasCompactSupport_cutBoth {δ R : ℝ} (hR : 0 < R) : HasCompactSupport (cutBoth δ R) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl2) (2 * R)) fun q hq => ?_
  have hz : cutBall R q = 0 := by
    refine cutBall_eq_zero hR ?_
    rw [Metric.mem_closedBall, dist_zero_right] at hq
    exact le_of_lt (by simpa using not_le.mp (fun hc => hq hc))
  rw [cutBoth, hz, mul_zero, Complex.ofReal_zero]

/-! ### Bounded compactly supported data: membership, the weight, and Hölder -/

theorem memLp_of_bdd_support {p : ℝ≥0∞} {G : Pl2 → ℂ} (hGm : Measurable G) {CG ρ : ℝ}
    (hGb : ∀ q, ‖G q‖ ≤ CG) (hsupp : ∀ q, ρ < ‖q‖ → G q = 0) :
    MemLp G p (volume : Measure Pl2) := by
  refine (memLp_top_of_bound hGm.aestronglyMeasurable CG
    (Filter.Eventually.of_forall hGb)).mono_exponent_of_measure_support_ne_top
    (s := Metric.closedBall (0 : Pl2) ρ) ?_ ?_ le_top
  · intro q hq
    refine hsupp q ?_
    rw [Metric.mem_closedBall, dist_zero_right] at hq
    exact not_le.mp hq
  · exact (measure_closedBall_lt_top).ne

theorem abs_sepFst_le (q : Pl2) : |sepFst q| ≤ ‖sepCLM q‖ := by
  have hsq : ‖sepCLM q‖ ^ 2 = (sepCLM q) 0 ^ 2 + (sepCLM q) 1 ^ 2 := norm_sq_two _
  rw [sepFst_apply]
  nlinarith [abs_nonneg ((sepCLM q) 0), norm_nonneg (sepCLM q), sq_abs ((sepCLM q) 0),
    sq_nonneg ((sepCLM q) 1)]

/-- On functions supported away from the diagonal the weight is bounded. -/
theorem wMass_le_of_away {gam δ : ℝ} (hgam : 1 / 2 ≤ gam) (hδ : 0 < δ) {h : Pl2 → ℂ}
    (hsupp : ∀ q, |sepFst q| < δ → h q = 0) :
    wMass gam h
      ≤ ENNReal.ofReal (δ ^ (-(2 * gam - 1))) * ∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ) := by
  rw [wMass, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun q => ?_
  by_cases hq : |sepFst q| < δ
  · rw [hsupp q hq]
    simp
  · have hexp : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
    have h1 : δ ≤ ‖sepCLM q‖ := le_trans (not_lt.mp hq) (abs_sepFst_le q)
    have h2 : ENNReal.ofReal δ ≤ ‖sepCLM q‖ₑ := by
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal h1
    have h3 : ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) ≤ (ENNReal.ofReal δ) ^ (-(2 * gam - 1)) := by
      rw [ENNReal.rpow_neg, ENNReal.rpow_neg]
      exact ENNReal.inv_le_inv.mpr (ENNReal.rpow_le_rpow h2 hexp)
    have h4 : (ENNReal.ofReal δ) ^ (-(2 * gam - 1))
        = ENNReal.ofReal (δ ^ (-(2 * gam - 1))) :=
      ENNReal.ofReal_rpow_of_pos hδ
    rw [h4] at h3
    calc ‖h q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
        ≤ ‖h q‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (δ ^ (-(2 * gam - 1))) :=
          mul_le_mul' (le_refl _) h3
      _ = ENNReal.ofReal (δ ^ (-(2 * gam - 1))) * ‖h q‖ₑ ^ (2 : ℝ) := by ring

/-- A quasi-triangle inequality for the weighted mass. -/
theorem wMass_le_four_add (gam : ℝ) {f g : Pl2 → ℂ} (hf : Measurable f) (hg : Measurable g) :
    wMass gam f ≤ 4 * wMass gam g + 4 * wMass gam (f - g) := by
  have hw : Measurable fun q : Pl2 => ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    (sepCLM.continuous.enorm.measurable).pow_const _
  have hA : Measurable fun q : Pl2 => ‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    ((hg.enorm).pow_const _).mul hw
  have hB : Measurable fun q : Pl2 =>
      ‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    (((hf.sub hg).enorm).pow_const _).mul hw
  have hpt : ∀ q : Pl2, ‖f q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
      ≤ 4 * (‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
        + 4 * (‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))) := by
    intro q
    have hsub : f q = g q + (f - g) q := by
      show f q = g q + (f q - g q)
      ring
    have htri : ‖f q‖ₑ ≤ ‖g q‖ₑ + ‖(f - g) q‖ₑ := by
      rw [hsub]
      exact enorm_add_le _ _
    set X : ℝ≥0∞ := ‖g q‖ₑ with hX
    set Y : ℝ≥0∞ := ‖(f - g) q‖ₑ with hY
    have hmax : ‖f q‖ₑ ≤ 2 * max X Y := by
      refine le_trans htri ?_
      have h1 : X ≤ max X Y := le_max_left _ _
      have h2 : Y ≤ max X Y := le_max_right _ _
      calc X + Y ≤ max X Y + max X Y := add_le_add h1 h2
        _ = 2 * max X Y := by ring
    have hsq : ‖f q‖ₑ ^ (2 : ℝ) ≤ 4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ)) := by
      have h5 : ‖f q‖ₑ ^ (2 : ℝ) ≤ (2 * max X Y) ^ (2 : ℝ) :=
        ENNReal.rpow_le_rpow hmax (by norm_num)
      have h6 : (2 * max X Y) ^ (2 : ℝ) = 4 * (max X Y) ^ (2 : ℝ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ))]
        congr 1
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
        norm_num
      have h7 : (max X Y) ^ (2 : ℝ) ≤ X ^ (2 : ℝ) + Y ^ (2 : ℝ) := by
        rcases le_total X Y with hle | hle
        · rw [max_eq_right hle]
          exact le_add_self
        · rw [max_eq_left hle]
          exact le_add_right (le_refl _)
      calc ‖f q‖ₑ ^ (2 : ℝ) ≤ 4 * (max X Y) ^ (2 : ℝ) := by rw [← h6]; exact h5
        _ ≤ 4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ)) := mul_le_mul' (le_refl _) h7
    calc ‖f q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
        ≤ (4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ))) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
          mul_le_mul' hsq (le_refl _)
      _ = 4 * (X ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
          + 4 * (Y ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))) := by ring
  calc wMass gam f
      ≤ ∫⁻ q : Pl2, (4 * (‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
          + 4 * (‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))) := by
        rw [wMass]
        exact lintegral_mono hpt
    _ = 4 * wMass gam g + 4 * wMass gam (f - g) := by
        rw [lintegral_add_left (hA.const_mul 4), lintegral_const_mul _ hA,
          lintegral_const_mul _ hB, wMass, wMass]

/-- Hölder: the `L¹` norm of a function supported in a ball is controlled by its `L²` norm. -/
theorem lintegral_enorm_le_sqrt {ρ : ℝ} {h : Pl2 → ℂ} (hm : Measurable h)
    (hsupp : ∀ q, ρ < ‖q‖ → h q = 0) :
    (∫⁻ q : Pl2, ‖h q‖ₑ)
      ≤ (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (volume (Metric.closedBall (0 : Pl2) ρ)) ^ ((1 : ℝ) / 2) := by
  classical
  set K : Set Pl2 := Metric.closedBall (0 : Pl2) ρ with hKdef
  have hKm : MeasurableSet K := measurableSet_closedBall
  have hpt : ∀ q : Pl2, ‖h q‖ₑ
      = ((fun q => ‖h q‖ₑ) * (K.indicator (fun _ => (1 : ℝ≥0∞)))) q := by
    intro q
    by_cases hq : q ∈ K
    · show ‖h q‖ₑ = ‖h q‖ₑ * K.indicator (fun _ => (1 : ℝ≥0∞)) q
      rw [Set.indicator_of_mem hq, mul_one]
    · have hz : h q = 0 := by
        refine hsupp q ?_
        rw [hKdef, Metric.mem_closedBall, dist_zero_right] at hq
        exact not_le.mp hq
      show ‖h q‖ₑ = ‖h q‖ₑ * K.indicator (fun _ => (1 : ℝ≥0∞)) q
      rw [hz, Set.indicator_of_notMem hq]
      simp
  rw [lintegral_congr hpt]
  have hf : AEMeasurable (fun q : Pl2 => ‖h q‖ₑ) (volume : Measure Pl2) :=
    hm.enorm.aemeasurable
  have hg : AEMeasurable (K.indicator (fun _ => (1 : ℝ≥0∞))) (volume : Measure Pl2) :=
    (measurable_const.indicator hKm).aemeasurable
  have hhol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl2)
    Real.HolderConjugate.two_two hf hg
  refine le_trans hhol (le_of_eq ?_)
  congr 1
  have hind : ∀ q : Pl2, (K.indicator (fun _ => (1 : ℝ≥0∞)) q) ^ (2 : ℝ)
      = K.indicator (fun _ => (1 : ℝ≥0∞)) q := by
    intro q
    by_cases hq : q ∈ K
    · rw [Set.indicator_of_mem hq, ENNReal.one_rpow]
    · rw [Set.indicator_of_notMem hq, ENNReal.zero_rpow_of_pos (by norm_num)]
  rw [lintegral_congr hind, lintegral_indicator hKm, setLIntegral_one]

/-! ### The `L²` endpoint for bounded data supported away from the diagonal -/

theorem lintegral_enorm_sq_le_of_eLpNorm {h : Pl2 → ℂ} {c : ℝ≥0∞}
    (hc : eLpNorm h 2 (volume : Measure Pl2) ≤ c) :
    (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ≤ c ^ (2 : ℝ) := by
  have h1 : eLpNorm h 2 (volume : Measure Pl2)
      = (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
    rw [eLpNorm_eq_lintegral_rpow_enorm (by norm_num) (by norm_num)]
    norm_num
  rw [h1] at hc
  have h2 := ENNReal.rpow_le_rpow hc (by norm_num : (0 : ℝ) ≤ (2 : ℝ))
  rw [← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one] at h2
  exact h2

theorem eLpNorm_two_eq_rpow (h : Pl2 → ℂ) :
    eLpNorm h 2 (volume : Measure Pl2)
      = (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm (by norm_num) (by norm_num)]
  norm_num

set_option maxHeartbeats 4000000 in
/-- **Proposition 3.1 for bounded data supported away from the diagonal.**  The `L²` endpoint of §3
extends from Schwartz data to bounded measurable data supported in
`{|y₁-z₁| ≥ δ} ∩ {‖q‖ ≤ R}`, at the cost of a factor `4`. -/
theorem prop31_Top2_away {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {δ R CG : ℝ} (hδ : 0 < δ) (hR : 0 < R)
    {G : Pl2 → ℂ} (hGm : Measurable G) (hGb : ∀ q, ‖G q‖ ≤ CG)
    (hGsupp1 : ∀ q, |sepFst q| < δ → G q = 0) (hGsupp2 : ∀ q, R < ‖q‖ → G q = 0) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      ≤ 4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam G := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  have hKEtop : KE ≠ ⊤ := by rw [hKE]; exact ENNReal.ofReal_ne_top
  have hGL2 : MemLp G 2 (volume : Measure Pl2) := memLp_of_bdd_support hGm hGb hGsupp2
  have hGL1 : Integrable G (volume : Measure Pl2) :=
    memLp_one_iff_integrable.mp (memLp_of_bdd_support hGm hGb hGsupp2)
  -- the smooth approximants
  have hex : ∀ n : ℕ, ∃ g : Pl2 → ℂ, HasCompactSupport g ∧ ContDiff ℝ (↑(⊤ : ℕ∞)) g ∧
      eLpNorm (G - g) 2 (volume : Measure Pl2) ≤ ENNReal.ofReal (1 / ((n : ℝ) + 1)) := by
    intro n
    exact hGL2.exist_eLpNorm_sub_le (by norm_num) (by norm_num)
      (one_div_pos.mpr (by positivity))
  choose g hgcs hgsm hgcl using hex
  set gt : ℕ → Pl2 → ℂ := fun n q => cutBoth δ R q * g n q with hgtdef
  have hgtsm : ∀ n, ContDiff ℝ (↑(⊤ : ℕ∞)) (gt n) :=
    fun n => (contDiff_cutBoth δ R).mul (hgsm n)
  have hgtcs : ∀ n, HasCompactSupport (gt n) := by
    intro n
    exact HasCompactSupport.mul_right (hasCompactSupport_cutBoth hR)
  set S : ℕ → SchwartzMap Pl2 ℂ := fun n => (hgtcs n).toSchwartzMap (hgtsm n) with hSdef
  have hScoe : ∀ n, ((S n : Pl2 → ℂ)) = gt n := fun n => rfl
  have hgtint : ∀ n, Integrable (gt n) (volume : Measure Pl2) := by
    intro n
    rw [← hScoe n]
    exact (S n).integrable
  have hgtmeas : ∀ n, Measurable (gt n) := fun n => (hgtsm n).continuous.measurable
  -- the cut-off does not change `G`
  have hcutG : ∀ q, cutBoth δ R q * G q = G q := by
    intro q
    by_cases hz : G q = 0
    · rw [hz, mul_zero]
    · have h1 : δ ≤ |sepFst q| := by
        by_contra hc
        exact hz (hGsupp1 q (not_le.mp hc))
      have h2 : ‖q‖ ≤ R := by
        by_contra hc
        exact hz (hGsupp2 q (not_le.mp hc))
      rw [cutBoth_eq_one hδ hR h1 h2, one_mul]
  have hdiff : ∀ n q, gt n q - G q = cutBoth δ R q * (g n q - G q) := by
    intro n q
    show cutBoth δ R q * g n q - G q = cutBoth δ R q * (g n q - G q)
    rw [mul_sub, hcutG q]
  -- `L²` closeness of the cut approximants
  have hgtcl : ∀ n, eLpNorm (fun q => gt n q - G q) 2 (volume : Measure Pl2)
      ≤ ENNReal.ofReal (1 / ((n : ℝ) + 1)) := by
    intro n
    refine le_trans (eLpNorm_mono (g := fun q => (G - g n) q) (fun q => ?_)) (hgcl n)
    rw [hdiff n q]
    calc ‖cutBoth δ R q * (g n q - G q)‖ = ‖cutBoth δ R q‖ * ‖g n q - G q‖ := norm_mul _ _
      _ ≤ 1 * ‖g n q - G q‖ :=
          mul_le_mul_of_nonneg_right (norm_cutBoth_le_one δ R q) (norm_nonneg _)
      _ = ‖(G - g n) q‖ := by
          rw [one_mul]
          show ‖g n q - G q‖ = ‖G q - g n q‖
          rw [norm_sub_rev]
  have hsqcl : ∀ n, (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ ^ (2 : ℝ))
      ≤ (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ) := fun n =>
    lintegral_enorm_sq_le_of_eLpNorm (hgtcl n)
  -- the supports of the differences
  have hdsupp1 : ∀ n q, |sepFst q| < δ / 2 → gt n q - G q = 0 := by
    intro n q h
    have h1 : cutBoth δ R q = 0 := by
      rw [cutBoth, cutDiag_eq_zero hδ (le_of_lt h), zero_mul, Complex.ofReal_zero]
    rw [hdiff n q, h1, zero_mul]
  have hdsupp2 : ∀ n q, 2 * R < ‖q‖ → gt n q - G q = 0 := by
    intro n q h
    have h1 : cutBoth δ R q = 0 := by
      rw [cutBoth, cutBall_eq_zero hR (le_of_lt h), mul_zero, Complex.ofReal_zero]
    rw [hdiff n q, h1, zero_mul]
  -- the weighted mass of the approximants
  set W : ℝ≥0∞ := ENNReal.ofReal ((δ / 2) ^ (-(2 * gam - 1))) with hW
  have hWtop : W ≠ ⊤ := by rw [hW]; exact ENNReal.ofReal_ne_top
  have hwt : ∀ n, wMass gam (gt n)
      ≤ 4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ)) := by
    intro n
    have h1 := wMass_le_four_add gam (hgtmeas n) hGm
    have h2 : wMass gam (gt n - G) ≤ W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ) := by
      have h3 : wMass gam (gt n - G)
          ≤ W * ∫⁻ q : Pl2, ‖(gt n - G) q‖ₑ ^ (2 : ℝ) := by
        rw [hW]
        refine wMass_le_of_away (le_of_lt hgam1) (by positivity) (fun q hq => ?_)
        show gt n q - G q = 0
        exact hdsupp1 n q hq
      refine le_trans h3 (mul_le_mul' (le_refl _) ?_)
      exact hsqcl n
    calc wMass gam (gt n) ≤ 4 * wMass gam G + 4 * wMass gam (gt n - G) := h1
      _ ≤ 4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ)) :=
          add_le_add (le_refl _) (mul_le_mul' (le_refl _) h2)
  -- the `L¹` convergence
  have hofRealzero : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1)))
      Filter.atTop (nhds 0) := by
    have h1 : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have h2 : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1)))
        Filter.atTop (nhds (ENNReal.ofReal 0)) :=
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp h1
    rwa [ENNReal.ofReal_zero] at h2
  have hL1en : Filter.Tendsto (fun n => ∫⁻ q : Pl2, ‖gt n q - G q‖ₑ) Filter.atTop (nhds 0) := by
    have hvol : (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2) ≠ ⊤ := by
      refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
      exact (measure_closedBall_lt_top).ne
    have hbd : ∀ n, (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ)
        ≤ ENNReal.ofReal (1 / ((n : ℝ) + 1))
          * (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2) := by
      intro n
      have h1 := lintegral_enorm_le_sqrt (ρ := 2 * R)
        (h := fun q => gt n q - G q) ((hgtmeas n).sub hGm) (fun q hq => hdsupp2 n q hq)
      refine le_trans h1 (mul_le_mul' ?_ (le_refl _))
      rw [← eLpNorm_two_eq_rpow]
      exact hgtcl n
    have hzero : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1))
        * (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2)) Filter.atTop
        (nhds 0) := by
      have h := ENNReal.Tendsto.mul_const hofRealzero (Or.inr hvol)
      simpa using h
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hzero
      (fun _ => zero_le) hbd
  have hL1conv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖gt n q - G q‖) Filter.atTop (nhds 0) := by
    have heq : ∀ n, (∫ q : Pl2, ‖gt n q - G q‖) = (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ).toReal := by
      intro n
      exact integral_norm_eq_lintegral_enorm (((hgtmeas n).sub hGm).aestronglyMeasurable)
    rw [Filter.tendsto_congr heq]
    have h3 : Filter.Tendsto (fun n : ℕ => (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ).toReal)
        Filter.atTop (nhds ((0 : ℝ≥0∞).toReal)) :=
      (ENNReal.tendsto_toReal (by norm_num : (0 : ℝ≥0∞) ≠ ⊤)).comp hL1en
    rwa [ENNReal.toReal_zero] at h3
  -- the finite sum inside the integral
  have hmeasT : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh t
    exact ((continuous_Top2 hm ε t hh).enorm.measurable).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hh t)]
  -- pointwise convergence
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    have h1 := tendsto_Top2_of_tendsto_L1 hm ε t hgtint hGL1 hL1conv x
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp h1.enorm
  -- Fatou
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (gt n) (hgtint n) t))
  -- the bound for each approximant
  have hRHS : ∀ n, (∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ))
      ≤ KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) := by
    intro n
    rw [← hsum_in (gt n) (hgtint n)]
    have h1 : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t ((S n : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
        ≤ KE * wMass gam ((S n : Pl2 → ℂ)) :=
      prop31_Top2 hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2 hNa hM
        hcard hcount (S n)
    rw [hScoe n] at h1
    exact le_trans h1 (mul_le_mul' (le_refl _) (hwt n))
  -- the limit of the bounds
  have hlim : Filter.Tendsto (fun n : ℕ =>
      KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))))
      Filter.atTop (nhds (KE * (4 * wMass gam G))) := by
    have h1 : Filter.Tendsto (fun n : ℕ => (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
        Filter.atTop (nhds 0) := by
      have h : Filter.Tendsto (fun n : ℕ => (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
          Filter.atTop (nhds ((0 : ℝ≥0∞) ^ (2 : ℝ))) :=
        ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto (0 : ℝ≥0∞)).comp hofRealzero
      rwa [ENNReal.zero_rpow_of_pos (by norm_num)] at h
    have h2 : Filter.Tendsto (fun n : ℕ => W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
        Filter.atTop (nhds 0) := by
      have h := ENNReal.Tendsto.const_mul h1 (Or.inr hWtop)
      simpa using h
    have h3 : Filter.Tendsto (fun n : ℕ =>
        4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) Filter.atTop (nhds 0) := by
      have h := ENNReal.Tendsto.const_mul h2 (Or.inr (by norm_num : (4 : ℝ≥0∞) ≠ ⊤))
      simpa using h
    have h4 : Filter.Tendsto (fun n : ℕ => 4 * wMass gam G
        + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) Filter.atTop
        (nhds (4 * wMass gam G)) := by
      have hc : Filter.Tendsto (fun _ : ℕ => 4 * wMass gam G) Filter.atTop
          (nhds (4 * wMass gam G)) := tendsto_const_nhds
      have h := hc.add h3
      simpa using h
    have h5 := ENNReal.Tendsto.const_mul h4
      (Or.inr hKEtop)
    exact h5
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ) := hsum_in G hGL1
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun n : ℕ =>
          KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))))
          Filter.atTop :=
        Filter.liminf_le_liminf (Filter.Eventually.of_forall hRHS)
    _ = KE * (4 * wMass gam G) := hlim.liminf_eq
    _ = 4 * KE * wMass gam G := by ring

/-! ### The `L²` endpoint for bounded compactly supported data -/

theorem volume_sepFst_eq_zero : (volume : Measure Pl2) {q : Pl2 | sepFst q = 0} = 0 := by
  have hker : {q : Pl2 | sepFst q = 0} = (LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ) : Set Pl2) := by
    ext q
    simp [LinearMap.mem_ker]
  have hne : (LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ)) ≠ ⊤ := by
    intro hcon
    have hmem : (pr (mk2 1 0) 0) ∈ LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ) := by
      rw [hcon]
      exact Submodule.mem_top
    rw [LinearMap.mem_ker] at hmem
    have hval : (sepFst : Pl2 →ₗ[ℝ] ℝ) (pr (mk2 1 0) 0) = 1 := by
      show ((mk2 1 0 - 0 : Pl)) 0 = 1
      rw [sub_zero]
      exact mk2_apply_zero 1 0
    rw [hval] at hmem
    exact absurd hmem one_ne_zero
  rw [hker]
  exact Measure.addHaar_submodule (volume : Measure Pl2) _ hne

set_option maxHeartbeats 4000000 in
/-- **Proposition 3.1 for bounded compactly supported data.**  Truncating away from the diagonal
and applying `prop31_Top2_away` gives the `L²` endpoint of §3 for all bounded compactly supported
measurable data, with the same constant. -/
theorem prop31_Top2_bdd {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {R CG : ℝ} (hR : 0 < R)
    {G : Pl2 → ℂ} (hGm : Measurable G) (hGb : ∀ q, ‖G q‖ ≤ CG)
    (hGsupp : ∀ q, R < ‖q‖ → G q = 0) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      ≤ 4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam G := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  have hGL1 : Integrable G (volume : Measure Pl2) :=
    memLp_one_iff_integrable.mp (memLp_of_bdd_support hGm hGb hGsupp)
  -- the truncations
  set Gd : ℕ → Pl2 → ℂ := fun n q =>
    if 1 / ((n : ℝ) + 1) ≤ |sepFst q| then G q else 0 with hGddef
  have hGdmeas : ∀ n, Measurable (Gd n) := by
    intro n
    refine Measurable.ite ?_ hGm measurable_const
    exact measurableSet_le measurable_const (sepFst.continuous.abs.measurable)
  have hGdb : ∀ (n : ℕ) (q : Pl2), ‖Gd n q‖ ≤ CG := by
    intro n q
    rw [hGddef]
    by_cases hq : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos hq]
      exact hGb q
    · simp only [if_neg hq, norm_zero]
      exact le_trans (norm_nonneg (G q)) (hGb q)
  have hGdsupp1 : ∀ (n : ℕ) (q : Pl2), |sepFst q| < 1 / ((n : ℝ) + 1) → Gd n q = 0 := by
    intro n q hq
    rw [hGddef]
    simp only [if_neg (not_le.mpr hq)]
  have hGdsupp2 : ∀ (n : ℕ) (q : Pl2), R < ‖q‖ → Gd n q = 0 := by
    intro n q hq
    rw [hGddef]
    by_cases h : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos h]
      exact hGsupp q hq
    · simp only [if_neg h]
  have hGdle : ∀ (n : ℕ) (q : Pl2), ‖Gd n q‖ ≤ ‖G q‖ := by
    intro n q
    rw [hGddef]
    by_cases h : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos h]
      exact le_refl _
    · simp only [if_neg h, norm_zero]
      exact norm_nonneg _
  have hGdint : ∀ n, Integrable (Gd n) (volume : Measure Pl2) := by
    intro n
    exact memLp_one_iff_integrable.mp
      (memLp_of_bdd_support (hGdmeas n) (hGdb n) (hGdsupp2 n))
  -- the weighted mass only decreases
  have hwd : ∀ n, wMass gam (Gd n) ≤ wMass gam G := by
    intro n
    rw [wMass, wMass]
    refine lintegral_mono fun q => ?_
    refine mul_le_mul' ?_ (le_refl _)
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hGdle n q)
  -- the bound for each truncation
  have hbdd : ∀ n, (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ))
      ≤ 4 * KE * wMass gam G := by
    intro n
    have h1 := prop31_Top2_away hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
      hNa hM hcard hcount (δ := 1 / ((n : ℝ) + 1)) (R := R) (CG := CG)
      (by positivity) hR (hGdmeas n) (hGdb n) (hGdsupp1 n) (hGdsupp2 n)
    refine le_trans h1 ?_
    rw [hKE]
    exact mul_le_mul' (le_refl _) (hwd n)
  -- `L¹` convergence of the truncations
  have hL1conv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖Gd n q - G q‖) Filter.atTop (nhds 0) := by
    have hae : ∀ᵐ q : Pl2, Filter.Tendsto (fun n => ‖Gd n q - G q‖) Filter.atTop (nhds 0) := by
      have hnull : (volume : Measure Pl2) {q : Pl2 | sepFst q = 0} = 0 := volume_sepFst_eq_zero
      rw [Filter.eventually_iff_exists_mem]
      refine ⟨{q : Pl2 | sepFst q = 0}ᶜ, ?_, ?_⟩
      · rw [mem_ae_iff, compl_compl]
        exact hnull
      · intro q hq
        have hqne : sepFst q ≠ 0 := hq
        have hpos : 0 < |sepFst q| := abs_pos.mpr hqne
        have hev : ∀ᶠ n : ℕ in Filter.atTop, ‖Gd n q - G q‖ = 0 := by
          obtain ⟨N, hN⟩ := exists_nat_gt (1 / |sepFst q|)
          refine Filter.eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
          have h1 : 1 / ((n : ℝ) + 1) ≤ |sepFst q| := by
            rw [div_le_iff₀ (by positivity)]
            have h2 : (1 : ℝ) / |sepFst q| < (N : ℝ) := hN
            have h3 : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
            have h4 : (1 : ℝ) / |sepFst q| < (n : ℝ) + 1 := by linarith
            rw [div_lt_iff₀ hpos] at h4
            linarith
          have h5 : Gd n q = G q := by
            rw [hGddef]
            simp only [if_pos h1]
          rw [h5, sub_self, norm_zero]
        exact Filter.Tendsto.congr' (hev.mono fun n hn => hn.symm) tendsto_const_nhds
    have hbound : ∀ n : ℕ, ∀ᵐ q : Pl2, ‖‖Gd n q - G q‖‖ ≤ 2 * ‖G q‖ := by
      intro n
      filter_upwards with q
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      calc ‖Gd n q - G q‖ ≤ ‖Gd n q‖ + ‖G q‖ := norm_sub_le _ _
        _ ≤ ‖G q‖ + ‖G q‖ := add_le_add (hGdle n q) (le_refl _)
        _ = 2 * ‖G q‖ := by ring
    have hconv := tendsto_integral_of_dominated_convergence (bound := fun q : Pl2 => 2 * ‖G q‖)
      (F := fun n q => ‖Gd n q - G q‖) (f := fun _ : Pl2 => (0 : ℝ))
      (fun n => (((hGdmeas n).sub hGm).norm).aestronglyMeasurable)
      ((hGL1.norm).const_mul 2) hbound hae
    simpa using hconv
  -- Fatou
  have hmeasT : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh t
    exact ((continuous_Top2 hm ε t hh).enorm.measurable).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hh t)]
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    have h1 := tendsto_Top2_of_tendsto_L1 hm ε t hGdint hGL1 hL1conv x
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp h1.enorm
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (Gd n) (hGdint n) t))
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ) := hsum_in G hGL1
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun _ : ℕ => 4 * KE * wMass gam G) Filter.atTop := by
        refine Filter.liminf_le_liminf (Filter.Eventually.of_forall fun n => ?_)
        rw [← hsum_in (Gd n) (hGdint n)]
        exact hbdd n
    _ = 4 * KE * wMass gam G := by
        exact Filter.liminf_const _

/-! ### The kernel is square integrable against a polynomial weight -/

theorem exists_decay_Pl (H : SchwartzMap Pl ℂ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : Pl, ‖(H : Pl → ℂ) u‖ * (1 + ‖u‖) ^ (3 : ℕ) ≤ K := by
  refine ⟨2 ^ (3 : ℕ) * (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H, ?_, ?_⟩
  · have h : (0 : ℝ) ≤ (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
        (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H := apply_nonneg _ _
    positivity
  · intro u
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((3 : ℕ), (0 : ℕ)))
      (le_refl 3) (le_refl 0) H u
    rw [norm_iteratedFDeriv_zero] at h
    rw [mul_comm]
    exact h

theorem integrable_inv_one_add_norm_pow5 :
    Integrable (fun u : Pl => ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) (volume : Measure Pl) := by
  have hrank : ((Module.finrank ℝ Pl : ℕ) : ℝ) < 5 := by
    rw [finrank_euclideanSpace_fin]
    norm_num
  have h := integrable_one_add_norm (E := Pl) (μ := (volume : Measure Pl)) (r := 5) hrank
  have hfun : (fun u : Pl => (1 + ‖u‖) ^ (-(5 : ℝ)))
      = fun u : Pl => ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
    funext u
    have h1 : (0 : ℝ) < 1 + ‖u‖ := by positivity
    rw [Real.rpow_neg h1.le, ← Real.rpow_natCast (1 + ‖u‖) 5]
    norm_num
  rw [← hfun]
  exact h

/-- The `L²` norm of a Schwartz function against the weight `1 + ‖u‖` is finite. -/
theorem lintegral_enorm_sq_mul_one_add_lt_top (H : SchwartzMap Pl ℂ) :
    (∫⁻ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) < ⊤ := by
  obtain ⟨K, hK0, hK⟩ := exists_decay_Pl H
  have hmaj : ∀ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)
      ≤ ENNReal.ofReal (K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) := by
    intro u
    have h1 : (0 : ℝ) < 1 + ‖u‖ := by positivity
    have hreal : ‖(H : Pl → ℂ) u‖ ^ 2 * (1 + ‖u‖) ≤ K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
      have h2 : ‖(H : Pl → ℂ) u‖ ≤ K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹ := by
        have hu := hK u
        rw [← le_div_iff₀ (by positivity : (0 : ℝ) < (1 + ‖u‖) ^ (3 : ℕ))] at hu
        refine le_trans hu (le_of_eq ?_)
        field_simp
      have h3 : ‖(H : Pl → ℂ) u‖ ^ 2 ≤ (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 := by
        refine pow_le_pow_left₀ (norm_nonneg _) h2 2
      have h4 : (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 * (1 + ‖u‖)
          = K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
        field_simp
      calc ‖(H : Pl → ℂ) u‖ ^ 2 * (1 + ‖u‖)
          ≤ (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 * (1 + ‖u‖) :=
            mul_le_mul_of_nonneg_right h3 (le_of_lt h1)
        _ = K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := h4
    have hen1 : ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (‖(H : Pl → ℂ) u‖ ^ 2) := by
      rw [← ofReal_norm, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast,
        ← ENNReal.ofReal_pow (norm_nonneg _)]
    have hen2 : (1 : ℝ≥0∞) + ‖u‖ₑ = ENNReal.ofReal (1 + ‖u‖) := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one, ← ENNReal.ofReal_add (by norm_num)
        (norm_nonneg _)]
    rw [hen1, hen2, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have hint : Integrable (fun u : Pl => K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹)
      (volume : Measure Pl) := integrable_inv_one_add_norm_pow5.const_mul _
  have hnn : (0 : Pl → ℝ) ≤ᵐ[volume] fun u : Pl => K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
    filter_upwards with u
    show (0 : ℝ) ≤ K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹
    positivity
  calc (∫⁻ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
      ≤ ∫⁻ u : Pl, ENNReal.ofReal (K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) := lintegral_mono hmaj
    _ = ENNReal.ofReal (∫ u : Pl, K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) :=
        (ofReal_integral_eq_lintegral_ofReal hint hnn).symm
    _ < ⊤ := ENNReal.ofReal_lt_top

theorem enorm_sub_le_one_add_mul_one_add (x y z : Pl) {sgam : ℝ} (hs0 : 0 ≤ sgam)
    (hs1 : sgam ≤ 1) :
    ‖y - z‖ₑ ^ sgam ≤ (1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ) := by
  have htri : ‖y - z‖ₑ ≤ ‖x - y‖ₑ + ‖x - z‖ₑ := by
    have h1 : y - z = -(x - y) + (x - z) := by abel
    calc ‖y - z‖ₑ = ‖-(x - y) + (x - z)‖ₑ := by rw [h1]
      _ ≤ ‖-(x - y)‖ₑ + ‖x - z‖ₑ := enorm_add_le _ _
      _ = ‖x - y‖ₑ + ‖x - z‖ₑ := by rw [enorm_neg]
  set c : ℝ≥0∞ := ‖x - y‖ₑ + ‖x - z‖ₑ with hc
  have h2 : ‖y - z‖ₑ ^ sgam ≤ c ^ sgam := ENNReal.rpow_le_rpow htri hs0
  have h3 : c ^ sgam ≤ 1 + c := by
    rcases le_total c 1 with hle | hle
    · refine le_trans (ENNReal.rpow_le_one hle hs0) ?_
      exact le_self_add
    · calc c ^ sgam ≤ c ^ (1 : ℝ) := ENNReal.rpow_le_rpow_of_exponent_le hle hs1
        _ = c := ENNReal.rpow_one c
        _ ≤ 1 + c := le_add_self
  refine le_trans h2 (le_trans h3 ?_)
  rw [hc]
  calc 1 + (‖x - y‖ₑ + ‖x - z‖ₑ)
      ≤ 1 + ‖x - y‖ₑ + ‖x - z‖ₑ + ‖x - y‖ₑ * ‖x - z‖ₑ := by
        calc 1 + (‖x - y‖ₑ + ‖x - z‖ₑ) = 1 + ‖x - y‖ₑ + ‖x - z‖ₑ := by ring
          _ ≤ 1 + ‖x - y‖ₑ + ‖x - z‖ₑ + ‖x - y‖ₑ * ‖x - z‖ₑ := le_self_add
    _ = (1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ) := by ring

/-! ### The weighted Cauchy--Schwarz bound for the kernel of `𝒯_j` -/

theorem lintegral_sub_left_eq_self_Pl (g : Pl → ℝ≥0∞) (c : Pl) :
    (∫⁻ w : Pl, g (c - w)) = ∫⁻ w : Pl, g w := by
  have h1 : (∫⁻ w : Pl, g (c - w)) = ∫⁻ w : Pl, g (c + w) := by
    have h := lintegral_neg_eq_self (μ := (volume : Measure Pl)) (fun w : Pl => g (c + w))
    simpa [sub_eq_add_neg] using h
  rw [h1]
  exact lintegral_add_left_eq_self g c

/-- The weighted square integral of the kernel of `𝒯_j`. -/
noncomputable def CKx (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (gam : ℝ) (x : Pl) : ℝ≥0∞ :=
  ∫⁻ q : Pl2, (‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ) ^ (2 : ℝ)
    * ‖sepCLM q‖ₑ ^ (2 * gam - 1)

set_option maxHeartbeats 1000000 in
theorem CKx_le_sq {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) : CKx j ε m t gam x
      ≤ (∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
        * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hs0 : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
  have hs1 : 2 * gam - 1 ≤ 1 := by linarith
  set A : Pl → ℝ≥0∞ := fun u => ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) with hA
  have hAtop : ∀ u : Pl, A u ≠ ⊤ := by
    intro u
    rw [hA]
    refine ENNReal.mul_ne_top ?_ ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) enorm_ne_top
    · exact ENNReal.add_ne_top.mpr ⟨by norm_num, enorm_ne_top⟩
  have hAmeas : Measurable A := by
    rw [hA]
    exact ((hkc.enorm.measurable).pow_const _).mul (measurable_const.add
      (continuous_id.enorm.measurable))
  have hAfin : (∫⁻ u : Pl, A u) < ⊤ := by
    have hfun : ∀ u : Pl, A u = ‖(kernS hm ε t : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
      intro u
      rw [hA, kernS_apply]
    rw [lintegral_congr hfun]
    exact lintegral_enorm_sq_mul_one_add_lt_top (kernS hm ε t)
  -- the pointwise bound
  have hmeasint : Measurable fun q : Pl2 =>
      (‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ) ^ (2 : ℝ)
        * ‖sepCLM q‖ₑ ^ (2 * gam - 1) := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact ((h1.mul h2).pow_const _).mul ((sepCLM.continuous.enorm.measurable).pow_const _)
  have hbd : ∀ y z : Pl,
      (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
          * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1)
        ≤ A (x - y) * A (x - z) := by
    intro y z
    have hsplit : (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
        = ‖kern j ε m t (x - y)‖ₑ ^ (2 : ℝ) * ‖kern j ε m t (x - z)‖ₑ ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    have hw := enorm_sub_le_one_add_mul_one_add x y z hs0 hs1
    calc (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
          * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1)
        ≤ (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
            * ((1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ)) := mul_le_mul' (le_refl _) hw
      _ = A (x - y) * A (x - z) := by
          rw [hsplit, hA]
          ring
  -- iterate and split
  calc CKx j ε m t gam x
      = ∫⁻ y : Pl, ∫⁻ z : Pl,
          (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
            * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1) := by
        rw [CKx]
        exact (lintegral_pr _ hmeasint).symm
    _ ≤ ∫⁻ y : Pl, ∫⁻ z : Pl, A (x - y) * A (x - z) :=
        lintegral_mono fun y => lintegral_mono fun z => hbd y z
    _ = ∫⁻ y : Pl, A (x - y) * ∫⁻ z : Pl, A (x - z) := by
        refine lintegral_congr fun y => ?_
        exact lintegral_const_mul' _ _ (hAtop (x - y))
    _ = (∫⁻ y : Pl, A (x - y)) * ∫⁻ z : Pl, A (x - z) := by
        rw [lintegral_mul_const' _ _ ?_]
        rw [lintegral_sub_left_eq_self_Pl A x]
        exact hAfin.ne
    _ = (∫⁻ u : Pl, A u) * ∫⁻ u : Pl, A u := by
        rw [lintegral_sub_left_eq_self_Pl A x]

theorem CKx_lt_top {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) : CKx j ε m t gam x < ⊤ := by
  have hAfin : (∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) < ⊤ := by
    have hfun : ∀ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)
        = ‖(kernS hm ε t : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
      intro u
      rw [kernS_apply]
    rw [lintegral_congr hfun]
    exact lintegral_enorm_sq_mul_one_add_lt_top (kernS hm ε t)
  exact lt_of_le_of_lt (CKx_le_sq hm ε t hgam1 hgam2 x) (ENNReal.mul_lt_top hAfin hAfin)

set_option maxHeartbeats 1000000 in
/-- **The weighted Cauchy--Schwarz bound.**  The kernel integral of `𝒯_j` is controlled by the
weighted mass of the data. -/
theorem lintegral_kern_mul_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) {F : Pl2 → ℂ} (hF : Measurable F) :
    (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ * ‖F q‖ₑ)
      ≤ (CKx j ε m t gam x) ^ ((1 : ℝ) / 2) * (wMass gam F) ^ ((1 : ℝ) / 2) := by
  classical
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  set kk : Pl2 → ℝ≥0∞ := fun q =>
    ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ with hkk
  set w : Pl2 → ℝ≥0∞ := fun q => ‖sepCLM q‖ₑ ^ (2 * gam - 1) with hwdef
  have hkkmeas : Measurable kk := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact h1.mul h2
  have hwmeas : Measurable w := (sepCLM.continuous.enorm.measurable).pow_const _
  -- off the diagonal the weight splits
  have hae : (fun q : Pl2 => kk q * ‖F q‖ₑ)
      =ᵐ[volume] fun q : Pl2 => (kk q * w q ^ ((1 : ℝ) / 2))
        * (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹) := by
    have hnull : (volume : Measure Pl2) {q : Pl2 | sepCLM q = 0} = 0 := volume_sepCLM_eq_zero
    rw [Filter.eventuallyEq_iff_exists_mem]
    refine ⟨{q : Pl2 | sepCLM q = 0}ᶜ, ?_, ?_⟩
    · rw [mem_ae_iff, compl_compl]
      exact hnull
    · intro q hq
      have hqne : sepCLM q ≠ 0 := hq
      have hpos : (0 : ℝ≥0∞) < ‖sepCLM q‖ₑ := by
        rw [enorm_pos]
        exact hqne
      have hwpos : (0 : ℝ≥0∞) < w q ^ ((1 : ℝ) / 2) := by
        rw [hwdef]
        refine ENNReal.rpow_pos ?_ ?_
        · exact ENNReal.rpow_pos hpos enorm_ne_top
        · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      have hwtop : w q ^ ((1 : ℝ) / 2) ≠ ⊤ := by
        rw [hwdef]
        refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
        exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      show kk q * ‖F q‖ₑ = (kk q * w q ^ ((1 : ℝ) / 2)) * (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹)
      rw [mul_comm (‖F q‖ₑ) ((w q ^ ((1 : ℝ) / 2))⁻¹), ← mul_assoc, mul_assoc (kk q),
        ENNReal.mul_inv_cancel hwpos.ne' hwtop, mul_one]
  rw [lintegral_congr_ae hae]
  have hf : AEMeasurable (fun q : Pl2 => kk q * w q ^ ((1 : ℝ) / 2)) (volume : Measure Pl2) :=
    (hkkmeas.mul (hwmeas.pow_const _)).aemeasurable
  have hg : AEMeasurable (fun q : Pl2 => ‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹)
      (volume : Measure Pl2) := ((hF.enorm).mul ((hwmeas.pow_const _).inv)).aemeasurable
  have hhol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl2)
    Real.HolderConjugate.two_two hf hg
  refine le_trans hhol ?_
  refine mul_le_mul' ?_ ?_
  · -- the kernel factor
    refine le_of_eq ?_
    congr 1
    rw [CKx]
    refine lintegral_congr fun q => ?_
    have h1 : (kk q * w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ)
        = kk q ^ (2 : ℝ) * (w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1, ← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one, hkk,
      hwdef]
  · -- the data factor
    refine le_of_eq ?_
    congr 1
    rw [wMass]
    refine lintegral_congr fun q => ?_
    have h1 : (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ)
        = ‖F q‖ₑ ^ (2 : ℝ) * ((w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1]
    congr 1
    rw [← ENNReal.rpow_neg_one (w q ^ ((1 : ℝ) / 2)), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      hwdef, ← ENNReal.rpow_mul]
    congr 1
    ring

/-! ### The `L²` endpoint for all data of finite weighted mass -/

theorem integrable_Top2_integrand_of_wMass {j : ℕ} {m : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ}
    (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1) (x : Pl) {F : Pl2 → ℂ} (hFm : Measurable F)
    (hFfin : wMass gam F ≠ ⊤) :
    Integrable (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hmeas : Measurable fun q : Pl2 =>
      kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q := by
    have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    exact h1.measurable.mul hFm
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  have hbd := lintegral_kern_mul_le hm ε t hgam1 hgam2 x hFm
  have heq : ∀ q : Pl2,
      ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q‖ₑ
        = ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ * ‖F q‖ₑ := by
    intro q
    rw [enorm_mul, enorm_mul]
  rw [hasFiniteIntegral_iff_enorm, lintegral_congr heq]
  refine lt_of_le_of_lt hbd ?_
  refine ENNReal.mul_lt_top ?_ ?_
  · refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) ?_
    exact (CKx_lt_top hm ε t hgam1 hgam2 x).ne
  · exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hFfin

/-- `𝒯_jh` is measurable in `x` for any measurable `h`. -/
theorem measurable_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hhm : Measurable h) :
    Measurable (Top2 j ε m t h) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hcont : Continuous fun p : Pl × Pl2 =>
      kern j ε m t (p.1 - prjL p.2) * kern j ε m t (p.1 - prjR p.2) := by
    have h1 : Continuous fun p : Pl × Pl2 => kern j ε m t (p.1 - prjL p.2) :=
      hkc.comp (continuous_fst.sub (prjL.continuous.comp continuous_snd))
    have h2 : Continuous fun p : Pl × Pl2 => kern j ε m t (p.1 - prjR p.2) :=
      hkc.comp (continuous_fst.sub (prjR.continuous.comp continuous_snd))
    exact h1.mul h2
  have hjoint : StronglyMeasurable fun p : Pl × Pl2 =>
      kern j ε m t (p.1 - prjL p.2) * kern j ε m t (p.1 - prjR p.2) * h p.2 := by
    refine (hcont.stronglyMeasurable).mul ?_
    exact (hhm.comp measurable_snd).stronglyMeasurable
  have hSM : StronglyMeasurable fun x : Pl =>
      ∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q :=
    hjoint.integral_prod_right'
  exact hSM.measurable

set_option maxHeartbeats 4000000 in
/-- **Proposition 3.1 for all data of finite weighted mass.**  This is the class in which the
Calderón family of the interpolation lives. -/
theorem prop31_Top2_wmass {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {F : Pl2 → ℂ} (hFm : Measurable F) (hFfin : wMass gam F ≠ ⊤) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))
      ≤ 4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam F := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  -- the truncations
  set Fn : ℕ → Pl2 → ℂ := fun n q =>
    if ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ) then F q else 0 with hFndef
  have hFnmeas : ∀ n : ℕ, Measurable (Fn n) := by
    intro n
    refine Measurable.ite ?_ hFm measurable_const
    exact ((measurableSet_le (hFm.norm) measurable_const).inter
      (measurableSet_le (continuous_id.norm.measurable) measurable_const))
  have hFnb : ∀ (n : ℕ) (q : Pl2), ‖Fn n q‖ ≤ (n : ℝ) := by
    intro n q
    rw [hFndef]
    by_cases h : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)
    · simp only [if_pos h]
      exact h.1
    · simp only [if_neg h, norm_zero]
      positivity
  have hFnsupp : ∀ (n : ℕ) (q : Pl2), (n : ℝ) + 1 < ‖q‖ → Fn n q = 0 := by
    intro n q hq
    rw [hFndef]
    have h : ¬ (‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)) := by
      intro hc
      have h2 := hc.2
      linarith
    simp only [if_neg h]
  have hFnle : ∀ (n : ℕ) (q : Pl2), ‖Fn n q‖ ≤ ‖F q‖ := by
    intro n q
    rw [hFndef]
    by_cases h : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)
    · simp only [if_pos h]
      exact le_refl _
    · simp only [if_neg h, norm_zero]
      exact norm_nonneg _
  have hwn : ∀ n : ℕ, wMass gam (Fn n) ≤ wMass gam F := by
    intro n
    rw [wMass, wMass]
    refine lintegral_mono fun q => ?_
    refine mul_le_mul' ?_ (le_refl _)
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hFnle n q)
  -- the bound for each truncation
  have hbdd : ∀ n : ℕ, (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ))
      ≤ 4 * KE * wMass gam F := by
    intro n
    have h1 := prop31_Top2_bdd hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
      hNa hM hcard hcount (R := (n : ℝ) + 1) (CG := (n : ℝ))
      (by positivity) (hFnmeas n) (hFnb n) (hFnsupp n)
    refine le_trans h1 ?_
    rw [hKE]
    exact mul_le_mul' (le_refl _) (hwn n)
  -- pointwise convergence of the images
  have hptTop2 : ∀ (t : ℝ) (x : Pl), Filter.Tendsto (fun n => Top2 j ε m t (Fn n) x)
      Filter.atTop (nhds (Top2 j ε m t F x)) := by
    intro t x
    have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
    have hkmul : Continuous fun q : Pl2 =>
        kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    have hFint := integrable_Top2_integrand_of_wMass hm ε t hgam1 hgam2 x hFm hFfin
    have hmeasn : ∀ n : ℕ, AEStronglyMeasurable
        (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q)
        (volume : Measure Pl2) := fun n => (hkmul.measurable.mul (hFnmeas n)).aestronglyMeasurable
    have hbound : ∀ n : ℕ, ∀ᵐ q : Pl2,
        ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q‖
          ≤ ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q‖ := by
      intro n
      filter_upwards with q
      rw [norm_mul, norm_mul, norm_mul, norm_mul]
      exact mul_le_mul_of_nonneg_left (hFnle n q)
        (mul_nonneg (norm_nonneg (kern j ε m t (x - prjL q)))
          (norm_nonneg (kern j ε m t (x - prjR q))))
    have hconvpt : ∀ᵐ q : Pl2, Filter.Tendsto
        (fun n => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q)
        Filter.atTop
        (nhds (kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q)) := by
      filter_upwards with q
      have hev : ∀ᶠ n : ℕ in Filter.atTop, Fn n q = F q := by
        obtain ⟨N, hN⟩ := exists_nat_gt (max ‖F q‖ ‖q‖)
        refine Filter.eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
        have h1 : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
        have h2 : ‖F q‖ ≤ (n : ℝ) := by
          have h4 := le_max_left ‖F q‖ ‖q‖
          linarith [hN, h1]
        have h3 : ‖q‖ ≤ (n : ℝ) := by
          have h4 := le_max_right ‖F q‖ ‖q‖
          linarith [hN, h1]
        rw [hFndef]
        simp only [if_pos (⟨h2, h3⟩ : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ))]
      refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
      filter_upwards [hev] with n hn
      rw [hn]
    exact tendsto_integral_of_dominated_convergence _ hmeasn hFint.norm hbound hconvpt
  -- measurability of the integrands
  have hmeasT : ∀ (h : Pl2 → ℂ), Measurable h → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hhm t
    exact (((measurable_Top2 hm ε t hhm).enorm)).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Measurable h →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hhm
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hhm t)]
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp (hptTop2 t x).enorm
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (Fn n) (hFnmeas n) t))
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ) := hsum_in F hFm
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun _ : ℕ => 4 * KE * wMass gam F) Filter.atTop := by
        refine Filter.liminf_le_liminf (Filter.Eventually.of_forall fun n => ?_)
        rw [← hsum_in (Fn n) (hFnmeas n)]
        exact hbdd n
    _ = 4 * KE * wMass gam F := Filter.liminf_const _

/-! ### Hadamard's three lines lemma -/

/-- **Hadamard's three lines lemma**, in the bounded case, which is the one needed for the
interpolation of §3: a function holomorphic on the strip `0 < Re ζ < 1`, continuous up to the
boundary and bounded on the closed strip, whose modulus is at most `M₀` on `Re ζ = 0` and at most
`M₁` on `Re ζ = 1`, satisfies `‖Ψ(θ)‖ ≤ M₀^{1-θ}M₁^{θ}` for `θ ∈ [0,1]`. -/
theorem three_lines {Ψ : ℂ → ℂ} {M0 M1 : ℝ} {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (hM0 : 0 < M0) (hM1 : 0 < M1)
    (hd : DiffContOnCl ℂ Ψ (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1))
    (hbdd : ∃ C : ℝ, ∀ z : ℂ, 0 ≤ z.re → z.re ≤ 1 → ‖Ψ z‖ ≤ C)
    (h0 : ∀ z : ℂ, z.re = 0 → ‖Ψ z‖ ≤ M0)
    (h1 : ∀ z : ℂ, z.re = 1 → ‖Ψ z‖ ≤ M1) :
    ‖Ψ (θ : ℂ)‖ ≤ M0 ^ (1 - θ) * M1 ^ θ := by
  obtain ⟨C, hC⟩ := hbdd
  set Φ : ℂ → ℂ := fun z =>
    Ψ z * Complex.exp ((z - 1) * (Real.log M0 : ℂ)) * Complex.exp (-z * (Real.log M1 : ℂ))
    with hΦ
  -- the modulus of the auxiliary factors
  have hnormΦ : ∀ z : ℂ, ‖Φ z‖ = ‖Ψ z‖ * M0 ^ (z.re - 1) * M1 ^ (-z.re) := by
    intro z
    have h2 : ‖Complex.exp ((z - 1) * (Real.log M0 : ℂ))‖ = M0 ^ (z.re - 1) := by
      rw [Complex.norm_exp]
      have h3 : ((z - 1) * (Real.log M0 : ℂ)).re = (z.re - 1) * Real.log M0 := by
        simp [Complex.mul_re]
      rw [h3, Real.rpow_def_of_pos hM0]
      ring_nf
    have h4 : ‖Complex.exp (-z * (Real.log M1 : ℂ))‖ = M1 ^ (-z.re) := by
      rw [Complex.norm_exp]
      have h5 : (-z * (Real.log M1 : ℂ)).re = (-z.re) * Real.log M1 := by
        simp [Complex.mul_re]
      rw [h5, Real.rpow_def_of_pos hM1]
      ring_nf
    rw [hΦ, norm_mul, norm_mul, h2, h4]
  -- `Φ` is holomorphic on the strip and continuous up to the boundary
  have hdΦ : DiffContOnCl ℂ Φ (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
    have hent1 : Differentiable ℂ fun z : ℂ => Complex.exp ((z - 1) * (Real.log M0 : ℂ)) :=
      fun z => (Complex.differentiable_exp _).comp z
        (((differentiable_id.sub_const 1).mul_const _) z)
    have hent2 : Differentiable ℂ fun z : ℂ => Complex.exp (-z * (Real.log M1 : ℂ)) :=
      fun z => (Complex.differentiable_exp _).comp z
        (((differentiable_neg.mul_const _)) z)
    refine ⟨(hd.differentiableOn.mul hent1.differentiableOn).mul hent2.differentiableOn, ?_⟩
    exact (hd.continuousOn.mul hent1.continuous.continuousOn).mul
      hent2.continuous.continuousOn
  -- the boundary bounds become `1`
  have hb0 : ∀ z : ℂ, z.re = 0 → ‖Φ z‖ ≤ 1 := by
    intro z hz
    rw [hnormΦ z, hz]
    have h6 : M1 ^ (-(0 : ℝ)) = 1 := by
      rw [neg_zero, Real.rpow_zero]
    rw [h6, mul_one]
    have h7 : ‖Ψ z‖ * M0 ^ ((0 : ℝ) - 1) ≤ M0 * M0 ^ ((0 : ℝ) - 1) :=
      mul_le_mul_of_nonneg_right (h0 z hz) (by positivity)
    refine le_trans h7 (le_of_eq ?_)
    rw [show (0 : ℝ) - 1 = -1 by ring, Real.rpow_neg_one, mul_inv_cancel₀ hM0.ne']
  have hb1 : ∀ z : ℂ, z.re = 1 → ‖Φ z‖ ≤ 1 := by
    intro z hz
    rw [hnormΦ z, hz]
    have h6 : M0 ^ ((1 : ℝ) - 1) = 1 := by
      rw [sub_self, Real.rpow_zero]
    rw [h6, mul_one]
    have h7 : ‖Ψ z‖ * M1 ^ (-(1 : ℝ)) ≤ M1 * M1 ^ (-(1 : ℝ)) :=
      mul_le_mul_of_nonneg_right (h1 z hz) (by positivity)
    refine le_trans h7 (le_of_eq ?_)
    rw [Real.rpow_neg_one, mul_inv_cancel₀ hM1.ne']
  -- the growth hypothesis: `Φ` is bounded on the closed strip
  have hbound : ∃ K : ℝ, ∀ z : ℂ, z ∈ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 → ‖Φ z‖ ≤ K := by
    refine ⟨|C| * (1 + M0⁻¹) * (1 + M1⁻¹), fun z hz => ?_⟩
    have hz0 : 0 < z.re := hz.1
    have hz1 : z.re < 1 := hz.2
    have hΨ : ‖Ψ z‖ ≤ |C| := le_trans (hC z (le_of_lt hz0) (le_of_lt hz1)) (le_abs_self C)
    have hp0 : M0 ^ (z.re - 1) ≤ 1 + M0⁻¹ := by
      rcases le_total M0 1 with hle | hle
      · have h8 : M0 ^ (z.re - 1) ≤ M0 ^ (-(1 : ℝ)) := by
          refine Real.rpow_le_rpow_of_exponent_ge hM0 hle ?_
          linarith
        rw [Real.rpow_neg_one] at h8
        linarith
      · have h8 : M0 ^ (z.re - 1) ≤ M0 ^ (0 : ℝ) := by
          refine Real.rpow_le_rpow_of_exponent_le hle ?_
          linarith
        rw [Real.rpow_zero] at h8
        have h9 : (0 : ℝ) ≤ M0⁻¹ := by positivity
        linarith
    have hp1 : M1 ^ (-z.re) ≤ 1 + M1⁻¹ := by
      rcases le_total M1 1 with hle | hle
      · have h8 : M1 ^ (-z.re) ≤ M1 ^ (-(1 : ℝ)) := by
          refine Real.rpow_le_rpow_of_exponent_ge hM1 hle ?_
          linarith
        rw [Real.rpow_neg_one] at h8
        linarith
      · have h8 : M1 ^ (-z.re) ≤ M1 ^ (0 : ℝ) := by
          refine Real.rpow_le_rpow_of_exponent_le hle ?_
          linarith
        rw [Real.rpow_zero] at h8
        have h9 : (0 : ℝ) ≤ M1⁻¹ := by positivity
        linarith
    rw [hnormΦ z]
    have hnn0 : (0 : ℝ) ≤ M0 ^ (z.re - 1) := by positivity
    have hnn1 : (0 : ℝ) ≤ M1 ^ (-z.re) := by positivity
    have hCnn : (0 : ℝ) ≤ |C| := abs_nonneg C
    refine mul_le_mul (mul_le_mul hΨ hp0 hnn0 hCnn) hp1 hnn1 (by positivity)
  obtain ⟨K, hK⟩ := hbound
  have hgrowth : ∃ c < π / (1 - 0), ∃ B : ℝ,
      Φ =O[Filter.comap (abs ∘ Complex.im) Filter.atTop
        ⊓ Filter.principal (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1)]
        fun z : ℂ => Real.exp (B * Real.exp (c * |z.im|)) := by
    refine ⟨0, by simpa using Real.pi_pos, 0, ?_⟩
    refine Asymptotics.IsBigO.of_bound |K| ?_
    refine Filter.Eventually.filter_mono inf_le_right ?_
    rw [Filter.eventually_principal]
    intro z hz
    have h1 : ‖Φ z‖ ≤ K := hK z hz
    have h2 : ‖(fun z : ℂ => Real.exp (0 * Real.exp (0 * |z.im|))) z‖ = 1 := by
      simp
    rw [h2, mul_one]
    exact le_trans h1 (le_abs_self K)
  have hPL := PhragmenLindelof.vertical_strip (a := (0 : ℝ)) (b := (1 : ℝ))
    (f := Φ) (C := 1) (z := (θ : ℂ)) hdΦ hgrowth hb0 hb1 (by simpa using hθ0) (by simpa using hθ1)
  -- undo the auxiliary factors
  have hval : ‖Φ (θ : ℂ)‖ = ‖Ψ (θ : ℂ)‖ * M0 ^ (θ - 1) * M1 ^ (-θ) := by
    rw [hnormΦ]
    simp
  rw [hval] at hPL
  have hpos0 : (0 : ℝ) < M0 ^ (θ - 1) := Real.rpow_pos_of_pos hM0 _
  have hpos1 : (0 : ℝ) < M1 ^ (-θ) := Real.rpow_pos_of_pos hM1 _
  have hmul : ‖Ψ (θ : ℂ)‖ ≤ (M0 ^ (θ - 1) * M1 ^ (-θ))⁻¹ := by
    rw [inv_eq_one_div, le_div_iff₀ (by positivity : (0 : ℝ) < M0 ^ (θ - 1) * M1 ^ (-θ))]
    calc ‖Ψ (θ : ℂ)‖ * (M0 ^ (θ - 1) * M1 ^ (-θ))
        = ‖Ψ (θ : ℂ)‖ * M0 ^ (θ - 1) * M1 ^ (-θ) := by ring
      _ ≤ 1 := hPL
  refine le_trans hmul (le_of_eq ?_)
  rw [mul_inv, ← Real.rpow_neg_one (M0 ^ (θ - 1)), ← Real.rpow_neg_one (M1 ^ (-θ)),
    ← Real.rpow_mul hM0.le, ← Real.rpow_mul hM1.le]
  congr 1
  · congr 1
    ring
  · congr 1
    ring

/-! ### The pairing on the output side, and its two endpoint bounds -/

/-- The pairing `⟨𝒯_jF, φ⟩` over `ℝ² × ℰ`. -/
noncomputable def pairT (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (Efin : Finset ℝ) (F : Pl2 → ℂ)
    (φ : ℝ → Pl → ℂ) : ℂ :=
  ∑ t ∈ Efin, ∫ x : Pl, Top2 j ε m t F x * φ t x

/-- The `ℓ²L²` norm on the output side. -/
noncomputable def outL2 (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ) : ℝ≥0∞ :=
  (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)

/-- The `ℓ¹L¹` norm on the output side. -/
noncomputable def outL1 (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ) : ℝ≥0∞ :=
  ∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ

/-- **The `L^∞` endpoint for the pairing.** -/
theorem enorm_pairT_le_sup {j : ℕ} {m : ℝ → Pl → ℂ} (ε : ℝ) (Efin : Finset ℝ)
    (F : Pl2 → ℂ) (φ : ℝ → Pl → ℂ) {Bv : ℝ≥0∞} (hBv : Bv ≠ ⊤)
    (hB : ∀ t ∈ Efin, ∀ x : Pl, ‖Top2 j ε m t F x‖ₑ ≤ Bv) :
    ‖pairT j ε m Efin F φ‖ₑ ≤ Bv * outL1 Efin φ := by
  rw [pairT, outL1, Finset.mul_sum]
  refine le_trans (enorm_sum_le _ _) ?_
  refine Finset.sum_le_sum fun t ht => ?_
  refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
  rw [← lintegral_const_mul' _ _ hBv]
  refine lintegral_mono fun x => ?_
  rw [enorm_mul]
  exact mul_le_mul' (hB t ht x) (le_refl _)

/-- **The `L²` endpoint for the pairing.** -/
theorem enorm_pairT_le_L2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε : ℝ) (Efin : Finset ℝ)
    {F : Pl2 → ℂ} (hFm : Measurable F) {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t))
    {Av : ℝ≥0∞}
    (hA : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) ≤ Av) :
    ‖pairT j ε m Efin F φ‖ₑ ≤ Av * outL2 Efin φ := by
  classical
  -- the pointwise Hölder in `x`, for each `t`
  have hstep : ∀ t : ℝ, ‖∫ x : Pl, Top2 j ε m t F x * φ t x‖ₑ
      ≤ (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
    intro t
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have heq : ∀ x : Pl, ‖Top2 j ε m t F x * φ t x‖ₑ
        = ((fun x => ‖Top2 j ε m t F x‖ₑ) * (fun x => ‖φ t x‖ₑ)) x := by
      intro x
      show ‖Top2 j ε m t F x * φ t x‖ₑ = ‖Top2 j ε m t F x‖ₑ * ‖φ t x‖ₑ
      rw [enorm_mul]
    rw [lintegral_congr heq]
    exact ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl) Real.HolderConjugate.two_two
      ((measurable_Top2 hm ε t hFm).enorm.aemeasurable) ((hφm t).enorm.aemeasurable)
  -- the discrete Cauchy--Schwarz over `ℰ`
  have hCS : (∑ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      ≤ (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
    have h := ENNReal.inner_le_Lp_mul_Lq (s := Efin)
      (f := fun t => (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      (g := fun t => (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      (p := 2) (q := 2) Real.HolderConjugate.two_two
    have hsq : ∀ (y : ℝ≥0∞), (y ^ ((1 : ℝ) / 2)) ^ (2 : ℝ) = y := by
      intro y
      rw [← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one]
    simp only [hsq] at h
    exact h
  calc ‖pairT j ε m Efin F φ‖ₑ
      ≤ ∑ t ∈ Efin, ‖∫ x : Pl, Top2 j ε m t F x * φ t x‖ₑ := by
        rw [pairT]
        exact enorm_sum_le _ _
    _ ≤ ∑ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
          * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) :=
        Finset.sum_le_sum fun t _ => hstep t
    _ ≤ (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
          * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := hCS
    _ ≤ Av * outL2 Efin φ := by
        rw [outL2]
        exact mul_le_mul' hA (le_refl _)

/-! ### Base--fibre coordinates for the weighted mass -/

theorem sepFst_pr_mk2 (y1 y2 z1 z2 : ℝ) :
    sepFst (pr (mk2 y1 y2) (mk2 z1 z2)) = y1 - z1 := by
  show ((mk2 y1 y2 - mk2 z1 z2 : Pl)) 0 = y1 - z1
  rw [mk2_sub_mk2, mk2_apply_zero]

set_option maxHeartbeats 1000000 in
/-- The weighted mass in base--fibre coordinates: the base variables `(y₁,z₁)` outside, the fibre
variables `(y₂,z₂)` inside. -/
theorem wMass1_iter {gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    wMass1 gam F
      = ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
          ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (2 : ℝ)
            * ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) := by
  classical
  set Gfun : Pl2 → ℝ≥0∞ := fun x =>
    ‖F x‖ₑ ^ (2 : ℝ) * ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1)) with hGfun
  have hsepmeas : Measurable fun x : Pl2 => ((sepCLM x) 0 : ℝ) :=
    sepFst.continuous.measurable
  have hGmeas : Measurable Gfun := by
    rw [hGfun]
    exact ((hF.enorm).pow_const _).mul ((hsepmeas.enorm).pow_const _)
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  -- step 1: iterate over `Pl × Pl`
  have h1 : wMass1 gam F = ∫⁻ y : Pl, ∫⁻ z : Pl, Gfun (pr y z) := by
    rw [wMass1, ← hGfun]
    exact (lintegral_pr Gfun hGmeas).symm
  -- step 2: split each `Pl` into its two coordinates
  have h2 : ∀ y : Pl, (∫⁻ z : Pl, Gfun (pr y z))
      = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
    intro y
    refine lintegral_Pl_eq_prod _ ?_
    exact hGmeas.comp (hprmeas.comp (measurable_const.prodMk measurable_id))
  have h3 : (∫⁻ y : Pl, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)))
      = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    refine lintegral_Pl_eq_prod _ ?_
    have hjoint : Measurable fun w : Pl × (ℝ × ℝ) => Gfun (pr w.1 (mk2 w.2.1 w.2.2)) := by
      refine hGmeas.comp (hprmeas.comp ?_)
      exact measurable_fst.prodMk
        (continuous_mk2.measurable.comp measurable_snd)
    have hstep : Measurable fun y : Pl => ∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)) :=
      hjoint.lintegral_prod_right'
    have heq : ∀ y : Pl, (∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)))
        = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
      intro y
      rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
      exact (hGmeas.comp (hprmeas.comp (measurable_const.prodMk
        (continuous_mk2.measurable)))).aemeasurable
    simpa [heq] using hstep
  -- step 3: swap the two inner variables `y₂` and `z₁`
  have h4 : ∀ y1 : ℝ, (∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)))
      = ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    intro y1
    refine lintegral_lintegral_swap ?_
    have hjoint : Measurable fun w : ℝ × ℝ => ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 w.1) (mk2 w.2 z2)) := by
      have h5 : Measurable fun v : (ℝ × ℝ) × ℝ =>
          Gfun (pr (mk2 y1 v.1.1) (mk2 v.1.2 v.2)) := by
        refine hGmeas.comp (hprmeas.comp ?_)
        refine Measurable.prodMk ?_ ?_
        · exact continuous_mk2.measurable.comp
            (measurable_const.prodMk (measurable_fst.comp measurable_fst))
        · exact continuous_mk2.measurable.comp
            ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
      exact h5.lintegral_prod_right'
    exact hjoint.aemeasurable
  rw [h1, lintegral_congr h2, h3, lintegral_congr h4]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  refine lintegral_congr fun y2 => ?_
  refine lintegral_congr fun z2 => ?_
  have hsep : ((sepCLM (pr (mk2 y1 y2) (mk2 z1 z2))) 0 : ℝ) = y1 - z1 := sepFst_pr_mk2 y1 y2 z1 z2
  simp only [hGfun, hsep]

/-! ### The algebra of the Calderón factorization -/

/-- `Φ·Ψ₁ = u^{p'}` with `u = WΦ`, `Ψ₁ = W u^{p'-1}`. -/
theorem calderon_alg1 {p : ℝ} (hp : 2 < p) (W Ph : ℝ≥0∞) :
    Ph * (W * (W * Ph) ^ (p / (p - 1) - 1)) = (W * Ph) ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hstep : Ph * (W * (W * Ph) ^ (p / (p - 1) - 1))
      = (W * Ph) ^ (1 : ℝ) * (W * Ph) ^ (p / (p - 1) - 1) := by
    rw [ENNReal.rpow_one]
    ring
  rw [hstep, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by linarith)]
  congr 1
  ring

/-- `Ψ₀²Φ²W^p = u^{p'}` with `Ψ₀ = Ψ₁^{-(p-2)/2}`, i.e. `Ψ₀² = Ψ₁^{-(p-2)}`.  This is the
identity that makes the `L²` norm of the first Calderón factor equal to the interpolated norm. -/
theorem calderon_alg2 {p : ℝ} (hp : 2 < p) {W Ph : ℝ≥0∞} (hW0 : W ≠ 0) (hWt : W ≠ ⊤)
    (hPht : Ph ≠ ⊤) :
    (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2)) * (Ph ^ (2 : ℝ) * W ^ p)
      = (W * Ph) ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hexp : 2 - (p / (p - 1) - 1) * (p - 2) = p / (p - 1) := by
    field_simp
    ring
  rcases eq_or_ne Ph 0 with hPh0 | hPh0
  · rw [hPh0]
    have h1 : ((0 : ℝ≥0∞)) ^ (2 : ℝ) = 0 := ENNReal.zero_rpow_of_pos (by norm_num)
    have h2 : (W * (0 : ℝ≥0∞)) ^ (p / (p - 1)) = 0 := by
      rw [mul_zero, ENNReal.zero_rpow_of_pos (by linarith)]
    rw [h1, h2, zero_mul, mul_zero]
  · -- the nondegenerate case
    have hu0 : W * Ph ≠ 0 := mul_ne_zero hW0 hPh0
    have hut : W * Ph ≠ ⊤ := ENNReal.mul_ne_top hWt hPht
    have hpow0 : (W * Ph) ^ (p / (p - 1) - 1) ≠ 0 := by
      rw [ne_eq, ENNReal.rpow_eq_zero_iff]
      intro hcon
      rcases hcon with hc | hc
      · exact hu0 hc.1
      · exact hut hc.1
    have hpowt : (W * Ph) ^ (p / (p - 1) - 1) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by linarith) hut
    -- expand the first factor
    have h1 : (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2))
        = W ^ (-(p - 2)) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2))) := by
      rw [ENNReal.mul_rpow_of_ne_top hWt hpowt, ← ENNReal.rpow_mul]
    -- combine the `W` powers
    have h2 : W ^ (-(p - 2)) * W ^ p = W ^ (2 : ℝ) := by
      rw [← ENNReal.rpow_add _ _ hW0 hWt]
      congr 1
      ring
    have h3 : W ^ (2 : ℝ) * Ph ^ (2 : ℝ) = (W * Ph) ^ (2 : ℝ) :=
      (ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)).symm
    have h4 : (W * Ph) ^ (2 : ℝ) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2)))
        = (W * Ph) ^ (p / (p - 1)) := by
      rw [← ENNReal.rpow_add _ _ hu0 hut]
      congr 1
      have h5 : (2 : ℝ) + (p / (p - 1) - 1) * (-(p - 2)) = 2 - (p / (p - 1) - 1) * (p - 2) := by
        ring
      rw [h5, hexp]
    calc (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2)) * (Ph ^ (2 : ℝ) * W ^ p)
        = (W ^ (-(p - 2)) * W ^ p) * (Ph ^ (2 : ℝ)
            * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2)))) := by
          rw [h1]
          ring
      _ = ((W * Ph) ^ (2 : ℝ)) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2))) := by
          rw [h2, ← h3]
          ring
      _ = (W * Ph) ^ (p / (p - 1)) := h4

/-! ### The Calderón factorization: the base data -/

/-- The fibre `L^p` profile of `F` at the base point `(y₁,z₁)`. -/
noncomputable def fibProf (p : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p) ^ (1 / p)

/-- The base weight `W = |y₁-z₁|^{(1-2γ)/p}` of the interpolated norm. -/
noncomputable def wtB (p gam y1 z1 : ℝ) : ℝ≥0∞ := ‖(y1 - z1 : ℝ)‖ₑ ^ ((1 - 2 * gam) / p)

/-- `u = WΦ`. -/
noncomputable def uB (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  wtB p gam y1 z1 * fibProf p F y1 z1

/-- The `p'`-th power of the interpolated norm `N_p(F)` of §3. -/
noncomputable def normNpp (p gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, (uB p gam F y1 z1) ^ (p / (p - 1))

/-- The second Calderón factor `Ψ₁ = W u^{p'-1}`. -/
noncomputable def psi1B (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  wtB p gam y1 z1 * (uB p gam F y1 z1) ^ (p / (p - 1) - 1)

/-- The first Calderón factor `Ψ₀ = Ψ₁^{-(p-2)/2}`. -/
noncomputable def psi0B (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  (psi1B p gam F y1 z1) ^ (-(p - 2) / 2)

/-- The modulus of the first factor of the Calderón family. -/
noncomputable def gZero (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 y2 z2 : ℝ) : ℝ≥0∞ :=
  ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2) * fibProf p F y1 z1 ^ (1 - p / 2)
    * psi0B p gam F y1 z1

/-- The modulus of the second factor of the Calderón family; it does not depend on the fibre
variables. -/
noncomputable def gOne (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  fibProf p F y1 z1 * psi1B p gam F y1 z1

theorem fibProf_pow {p : ℝ} (hp : 0 < p) (F : Pl2 → ℂ) (y1 z1 : ℝ) :
    (fibProf p F y1 z1) ^ p = ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
      ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
  rw [fibProf, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne', ENNReal.rpow_one]

theorem wtB_pow {p gam : ℝ} (hp : 0 < p) (y1 z1 : ℝ) :
    (wtB p gam y1 z1) ^ p = ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) := by
  rw [wtB, ← ENNReal.rpow_mul, div_mul_cancel₀ _ hp.ne']
  congr 1
  ring

theorem wtB_ne_zero {p gam : ℝ} (hp : 0 < p) (hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 ≠ z1) :
    wtB p gam y1 z1 ≠ 0 := by
  rw [wtB, ne_eq, ENNReal.rpow_eq_zero_iff]
  intro hcon
  rcases hcon with hc | hc
  · rw [enorm_eq_zero, sub_eq_zero] at hc
    exact h hc.1
  · exact (by simpa using hc.1 : ‖(y1 - z1 : ℝ)‖ₑ = ⊤) |> fun hh => absurd hh enorm_ne_top

theorem wtB_ne_top {p gam : ℝ} (hp : 0 < p) (hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 ≠ z1) :
    wtB p gam y1 z1 ≠ ⊤ := by
  have hne : ‖(y1 - z1 : ℝ)‖ₑ ≠ 0 := by
    rw [ne_eq, enorm_eq_zero, sub_eq_zero]
    exact h
  rw [wtB, ne_eq, ENNReal.rpow_eq_top_iff]
  intro hcon
  rcases hcon with hc | hc
  · exact hne hc.1
  · exact absurd hc.1 enorm_ne_top

theorem measurable_fibProf {p : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => fibProf p F a.1 a.2 := by
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have hjoint : Measurable fun v : (ℝ × ℝ) × (ℝ × ℝ) =>
      ‖F (pr (mk2 v.1.1 v.2.1) (mk2 v.1.2 v.2.2))‖ₑ ^ p := by
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    refine Measurable.prodMk ?_ ?_
    · exact continuous_mk2.measurable.comp
        ((measurable_fst.comp measurable_fst).prodMk (measurable_fst.comp measurable_snd))
    · exact continuous_mk2.measurable.comp
        ((measurable_snd.comp measurable_fst).prodMk (measurable_snd.comp measurable_snd))
  have hinner : Measurable fun a : ℝ × ℝ => ∫⁻ r : ℝ × ℝ,
      ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p := hjoint.lintegral_prod_right'
  have heq : ∀ a : ℝ × ℝ, (∫⁻ r : ℝ × ℝ, ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p)
      = ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 a.1 y2) (mk2 a.2 z2))‖ₑ ^ p := by
    intro a
    rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
    refine (Measurable.aemeasurable ?_)
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    exact (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_fst)).prodMk
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_snd))
  have hfib : ∀ a : ℝ × ℝ, fibProf p F a.1 a.2
      = (∫⁻ r : ℝ × ℝ, ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p) ^ (1 / p) := by
    intro a
    rw [fibProf, heq a]
  simp only [hfib]
  exact hinner.pow_const _

theorem measurable_wtB (p gam : ℝ) : Measurable fun a : ℝ × ℝ => wtB p gam a.1 a.2 := by
  have h1 : Measurable fun a : ℝ × ℝ => ‖(a.1 - a.2 : ℝ)‖ₑ :=
    ((measurable_fst.sub measurable_snd).enorm)
  exact h1.pow_const _

theorem measurable_uB {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => uB p gam F a.1 a.2 :=
  (measurable_wtB p gam).mul (measurable_fibProf hF)

theorem measurable_psi1B {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => psi1B p gam F a.1 a.2 :=
  (measurable_wtB p gam).mul ((measurable_uB hF).pow_const _)

theorem measurable_psi0B {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => psi0B p gam F a.1 a.2 :=
  (measurable_psi1B hF).pow_const _

theorem measurable_gOne {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => gOne p gam F a.1 a.2 :=
  (measurable_fibProf hF).mul (measurable_psi1B hF)

/-! ### The two norm identities of the Calderón factorization -/

theorem gOne_eq (p gam : ℝ) (hp : 2 < p) (F : Pl2 → ℂ) (y1 z1 : ℝ) :
    gOne p gam F y1 z1 = (uB p gam F y1 z1) ^ (p / (p - 1)) := by
  rw [gOne, psi1B, uB]
  exact calderon_alg1 hp (wtB p gam y1 z1) (fibProf p F y1 z1)

/-- **The `X₁` norm of the second Calderón factor** is the interpolated norm. -/
theorem lintegral_gOne (p gam : ℝ) (hp : 2 < p) (F : Pl2 → ℂ) :
    (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, gOne p gam F y1 z1) = normNpp p gam F := by
  rw [normNpp]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  exact gOne_eq p gam hp F y1 z1

theorem ae_ne_of_singleton (y1 : ℝ) : ∀ᵐ z1 : ℝ, z1 ≠ y1 := by
  rw [Filter.eventually_iff_exists_mem]
  refine ⟨{y1}ᶜ, ?_, fun z1 hz1 => hz1⟩
  rw [mem_ae_iff, compl_compl]
  exact measure_singleton y1

set_option maxHeartbeats 1000000 in
/-- **The `X₀` norm of the first Calderón factor** is the interpolated norm. -/
theorem lintegral_gZero_sq_weight {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam)
    {F : Pl2 → ℂ} (hF : Measurable F) (hfin : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) :
    (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
        (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)))
      = normNpp p gam F := by
  have hppos : (0 : ℝ) < p := by linarith
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  rw [normNpp]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr_ae ?_
  filter_upwards [ae_ne_of_singleton y1] with z1 hz1
  have hne : y1 ≠ z1 := fun hc => hz1 hc.symm
  -- the inner integral in the fibre variables
  have hmeasF2 : ∀ y2 : ℝ, Measurable fun z2 : ℝ =>
      ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    intro y2
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    exact measurable_const.prodMk
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_id))
  have hmeasF1 : Measurable fun y2 : ℝ =>
      ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    have hjoint : Measurable fun v : ℝ × ℝ =>
        ‖F (pr (mk2 y1 v.1) (mk2 z1 v.2))‖ₑ ^ p := by
      refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
      exact (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_fst)).prodMk
        (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_snd))
    exact hjoint.lintegral_prod_right'
  set C : ℝ≥0∞ := fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1 with hC
  set W2 : ℝ≥0∞ := ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) with hW2
  have hsq : ∀ y2 z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2
      = (C ^ (2 : ℝ) * W2) * ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    intro y2 z2
    rw [gZero, hC]
    have h1 : (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)
          * fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1) ^ (2 : ℝ)
        = (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)) ^ (2 : ℝ)
          * (fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1) ^ (2 : ℝ) := by
      rw [← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ))]
      congr 1
      ring
    have h2 : (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)) ^ (2 : ℝ)
        = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
      rw [← ENNReal.rpow_mul]
      congr 1
      ring
    rw [h1, h2]
    ring
  have hinner : (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2)
      = (C ^ (2 : ℝ) * W2) * (fibProf p F y1 z1) ^ p := by
    have hstep1 : ∀ y2 : ℝ, (∫⁻ z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2)
        = (C ^ (2 : ℝ) * W2) * ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
      intro y2
      rw [lintegral_congr (fun z2 => hsq y2 z2), lintegral_const_mul _ (hmeasF2 y2)]
    rw [lintegral_congr hstep1, lintegral_const_mul _ hmeasF1, fibProf_pow hppos]
  rw [hinner, hC]
  -- the base algebra
  have hfib : fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1 = C := by rw [hC]
  have hexpand : (C ^ (2 : ℝ) * W2) * (fibProf p F y1 z1) ^ p
      = (psi1B p gam F y1 z1) ^ (-(p - 2))
        * ((fibProf p F y1 z1) ^ (2 : ℝ) * (wtB p gam y1 z1) ^ p) := by
    have h1 : C ^ (2 : ℝ) = (fibProf p F y1 z1) ^ (2 - p) * (psi1B p gam F y1 z1) ^ (-(p - 2)) := by
      rw [hC, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ)), psi0B,
        ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
      congr 2
      · ring
      · ring
    have h2 : (fibProf p F y1 z1) ^ (2 - p) * (fibProf p F y1 z1) ^ p
        = (fibProf p F y1 z1) ^ (2 : ℝ) := by
      rcases eq_or_ne (fibProf p F y1 z1) 0 with h0 | h0
      · rw [h0]
        have e1 : (0 : ℝ≥0∞) ^ (2 - p) = ⊤ := ENNReal.zero_rpow_of_neg (by linarith)
        have e2 : (0 : ℝ≥0∞) ^ p = 0 := ENNReal.zero_rpow_of_pos hppos
        have e3 : (0 : ℝ≥0∞) ^ (2 : ℝ) = 0 := ENNReal.zero_rpow_of_pos (by norm_num)
        rw [e1, e2, e3, mul_zero]
      · rw [← ENNReal.rpow_add _ _ h0 (hfin y1 z1)]
        congr 1
        ring
    have hW2eq : W2 = (wtB p gam y1 z1) ^ p := by
      rw [hW2, wtB_pow hppos]
    rw [h1, hW2eq]
    calc (fibProf p F y1 z1) ^ (2 - p) * (psi1B p gam F y1 z1) ^ (-(p - 2))
          * (wtB p gam y1 z1) ^ p * (fibProf p F y1 z1) ^ p
        = (psi1B p gam F y1 z1) ^ (-(p - 2))
            * (((fibProf p F y1 z1) ^ (2 - p) * (fibProf p F y1 z1) ^ p)
              * (wtB p gam y1 z1) ^ p) := by ring
      _ = (psi1B p gam F y1 z1) ^ (-(p - 2))
            * ((fibProf p F y1 z1) ^ (2 : ℝ) * (wtB p gam y1 z1) ^ p) := by rw [h2]
  rw [hexpand, psi1B, uB]
  exact calderon_alg2 hp (wtB_ne_zero hppos hgam1 hne) (wtB_ne_top hppos hgam1 hne) (hfin y1 z1)

/-! ### The pointwise Calderón factorization -/

theorem psi1B_ne_zero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (hpos : fibProf p F y1 z1 ≠ 0) : psi1B p gam F y1 z1 ≠ 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have hW0 := wtB_ne_zero hppos hgam1 hne (p := p) (gam := gam)
  have hWt := wtB_ne_top hppos hgam1 hne (p := p) (gam := gam)
  have hu0 : uB p gam F y1 z1 ≠ 0 := mul_ne_zero hW0 hpos
  have hut : uB p gam F y1 z1 ≠ ⊤ := ENNReal.mul_ne_top hWt hfin
  rw [psi1B, ne_eq, mul_eq_zero]
  intro hcon
  rcases hcon with hc | hc
  · exact hW0 hc
  · rw [ENNReal.rpow_eq_zero_iff] at hc
    rcases hc with hc | hc
    · exact hu0 hc.1
    · exact hut hc.1

theorem psi1B_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (hpos : fibProf p F y1 z1 ≠ 0) : psi1B p gam F y1 z1 ≠ ⊤ := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hW0 := wtB_ne_zero hppos hgam1 hne (p := p) (gam := gam)
  have hWt := wtB_ne_top hppos hgam1 hne (p := p) (gam := gam)
  have hut : uB p gam F y1 z1 ≠ ⊤ := ENNReal.mul_ne_top hWt hfin
  rw [psi1B]
  refine ENNReal.mul_ne_top hWt ?_
  exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hut

set_option maxHeartbeats 1000000 in
/-- **The Calderón factorization.**  `|F| = G₀^{2/p} G₁^{1-2/p}` at every point where the fibre
profile is finite and nonzero, and the base point is off the diagonal. -/
theorem calderon_factorization {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (hpos : fibProf p F y1 z1 ≠ 0) (y2 z2 : ℝ) :
    (gZero p gam F y1 z1 y2 z2) ^ (2 / p) * (gOne p gam F y1 z1) ^ (1 - 2 / p)
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := by positivity
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  have hP0 : psi1B p gam F y1 z1 ≠ 0 := psi1B_ne_zero hp hgam1 hne hfin hpos
  have hPt : psi1B p gam F y1 z1 ≠ ⊤ := psi1B_ne_top hp hgam1 hne hfin hpos
  -- expand the two factors
  have hA : (gZero p gam F y1 z1 y2 z2) ^ (2 / p)
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * ((fibProf p F y1 z1) ^ ((2 - p) / p) * (psi1B p gam F y1 z1) ^ (-((p - 2) / p))) := by
    rw [gZero, ENNReal.mul_rpow_of_nonneg _ _ h2p.le, ENNReal.mul_rpow_of_nonneg _ _ h2p.le,
      psi0B, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    have e1 : p / 2 * (2 / p) = 1 := by field_simp
    have e2 : (1 - p / 2) * (2 / p) = (2 - p) / p := by field_simp
    have e3 : -(p - 2) / 2 * (2 / p) = -((p - 2) / p) := by field_simp
    rw [e1, e2, e3, ENNReal.rpow_one, mul_assoc]
  have hB : (gOne p gam F y1 z1) ^ (1 - 2 / p)
      = (fibProf p F y1 z1) ^ ((p - 2) / p) * (psi1B p gam F y1 z1) ^ ((p - 2) / p) := by
    rw [gOne, ENNReal.mul_rpow_of_nonneg _ _ h2p'.le]
    have e4 : (1 : ℝ) - 2 / p = (p - 2) / p := by field_simp
    rw [e4]
  rw [hA, hB]
  -- combine the powers of the profile and of `Ψ₁`
  have hfibcomb : (fibProf p F y1 z1) ^ ((2 - p) / p) * (fibProf p F y1 z1) ^ ((p - 2) / p) = 1 := by
    rw [← ENNReal.rpow_add _ _ hpos hfin]
    have e5 : (2 - p) / p + (p - 2) / p = 0 := by
      field_simp
      ring
    rw [e5, ENNReal.rpow_zero]
  have hpsicomb : (psi1B p gam F y1 z1) ^ (-((p - 2) / p))
      * (psi1B p gam F y1 z1) ^ ((p - 2) / p) = 1 := by
    rw [← ENNReal.rpow_add _ _ hP0 hPt]
    have e6 : -((p - 2) / p) + (p - 2) / p = 0 := by ring
    rw [e6, ENNReal.rpow_zero]
  calc ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * ((fibProf p F y1 z1) ^ ((2 - p) / p) * (psi1B p gam F y1 z1) ^ (-((p - 2) / p)))
        * ((fibProf p F y1 z1) ^ ((p - 2) / p) * (psi1B p gam F y1 z1) ^ ((p - 2) / p))
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * (((fibProf p F y1 z1) ^ ((2 - p) / p) * (fibProf p F y1 z1) ^ ((p - 2) / p))
          * ((psi1B p gam F y1 z1) ^ (-((p - 2) / p))
            * (psi1B p gam F y1 z1) ^ ((p - 2) / p))) := by ring
    _ = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
        rw [hfibcomb, hpsicomb, mul_one, mul_one]

/-- In the degenerate case where the fibre profile vanishes, both Calderón factors vanish. -/
theorem calderon_factorization_zero {p gam : ℝ} (hp : 2 < p) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hzero : fibProf p F y1 z1 = 0) (y2 z2 : ℝ) :
    (gZero p gam F y1 z1 y2 z2) ^ (2 / p) * (gOne p gam F y1 z1) ^ (1 - 2 / p) = 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  have hg1 : gOne p gam F y1 z1 = 0 := by
    rw [gOne, hzero, zero_mul]
  rw [hg1, ENNReal.zero_rpow_of_pos h2p', mul_zero]

/-! ### Complex powers of nonnegative reals, and unimodular signs -/

/-- The complex power `r^w` of a nonnegative real, with the convention `0^w = 0`. -/
noncomputable def rpowC (r : ℝ) (w : ℂ) : ℂ :=
  if r = 0 then 0 else Complex.exp (w * (Real.log r : ℂ))

@[simp] theorem rpowC_zero_base (w : ℂ) : rpowC 0 w = 0 := by
  rw [rpowC, if_pos rfl]

theorem rpowC_of_pos {r : ℝ} (hr : 0 < r) (w : ℂ) :
    rpowC r w = Complex.exp (w * (Real.log r : ℂ)) := by
  rw [rpowC, if_neg hr.ne']

theorem norm_rpowC {r : ℝ} (hr : 0 < r) (w : ℂ) : ‖rpowC r w‖ = r ^ w.re := by
  rw [rpowC_of_pos hr, Complex.norm_exp]
  have h1 : (w * (Real.log r : ℂ)).re = w.re * Real.log r := by
    simp [Complex.mul_re]
  rw [h1, Real.rpow_def_of_pos hr]
  ring_nf

theorem norm_rpowC_nonneg {r : ℝ} (hr : 0 ≤ r) (w : ℂ) : ‖rpowC r w‖ = r ^ w.re ∨ r = 0 := by
  rcases eq_or_lt_of_le hr with h | h
  · exact Or.inr h.symm
  · exact Or.inl (norm_rpowC h w)

theorem rpowC_one {r : ℝ} (hr : 0 < r) : rpowC r 1 = (r : ℂ) := by
  rw [rpowC_of_pos hr, one_mul, ← Complex.ofReal_exp, Real.exp_log hr]

theorem rpowC_add (r : ℝ) (a b : ℂ) : rpowC r (a + b) = rpowC r a * rpowC r b := by
  rcases eq_or_ne r 0 with hr | hr
  · rw [hr, rpowC_zero_base, rpowC_zero_base, rpowC_zero_base, mul_zero]
  · rw [rpowC, rpowC, rpowC, if_neg hr, if_neg hr, if_neg hr, ← Complex.exp_add]
    congr 1
    ring

theorem differentiable_rpowC (r : ℝ) : Differentiable ℂ (rpowC r) := by
  rcases eq_or_ne r 0 with hr | hr
  · have h : rpowC r = fun _ : ℂ => (0 : ℂ) := by
      funext w
      rw [hr, rpowC_zero_base]
    rw [h]
    exact differentiable_const 0
  · have h : rpowC r = fun w : ℂ => Complex.exp (w * (Real.log r : ℂ)) := by
      funext w
      rw [rpowC, if_neg hr]
    rw [h]
    exact fun w => (Complex.differentiable_exp _).comp w ((differentiable_id.mul_const _) w)

/-- The unimodular sign of a complex number, with `signC 0 = 0`. -/
noncomputable def signC (z : ℂ) : ℂ := if z = 0 then 0 else z / (‖z‖ : ℂ)

theorem signC_zero : signC 0 = 0 := by
  rw [signC, if_pos rfl]

theorem norm_signC_of_ne {z : ℂ} (h : z ≠ 0) : ‖signC z‖ = 1 := by
  rw [signC, if_neg h, norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg z), div_self (norm_ne_zero_iff.mpr h)]

theorem norm_signC_le_one (z : ℂ) : ‖signC z‖ ≤ 1 := by
  rcases eq_or_ne z 0 with h | h
  · rw [h, signC_zero, norm_zero]
    norm_num
  · rw [norm_signC_of_ne h]

theorem signC_mul_norm (z : ℂ) : signC z * (‖z‖ : ℂ) = z := by
  rcases eq_or_ne z 0 with h | h
  · rw [h, signC_zero, zero_mul]
  · rw [signC, if_neg h, div_mul_cancel₀]
    exact Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr h)

theorem measurable_signC : Measurable signC := by
  classical
  have h : signC = fun z : ℂ => if z = 0 then 0 else z / (‖z‖ : ℂ) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_id measurable_const) measurable_const ?_
  exact measurable_id.div (Complex.measurable_ofReal.comp measurable_id.norm)

theorem measurable_rpowC (w : ℂ) : Measurable fun r : ℝ => rpowC r w := by
  classical
  have h : (fun r : ℝ => rpowC r w)
      = fun r : ℝ => if r = 0 then 0 else Complex.exp (w * (Real.log r : ℂ)) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_id measurable_const) measurable_const ?_
  exact (Complex.measurable_exp.comp
    ((Complex.measurable_ofReal.comp Real.measurable_log).const_mul w))

/-! ### The Calderón family -/

/-- The first base coordinate `y₁` of a point of `ℝ⁴`. -/
def bs1 (q : Pl2) : ℝ := (prjL q) 0
/-- The first fibre coordinate `y₂`. -/
def fb1 (q : Pl2) : ℝ := (prjL q) 1
/-- The second base coordinate `z₁`. -/
def bs2 (q : Pl2) : ℝ := (prjR q) 0
/-- The second fibre coordinate `z₂`. -/
def fb2 (q : Pl2) : ℝ := (prjR q) 1

theorem pr_bs_fb (q : Pl2) : pr (mk2 (bs1 q) (fb1 q)) (mk2 (bs2 q) (fb2 q)) = q := by
  rw [bs1, fb1, bs2, fb2, mk2_coords, mk2_coords, pr_prj]

theorem measurable_bs1 : Measurable bs1 :=
  ((EuclideanSpace.proj (0 : Fin 2)).comp prjL).continuous.measurable
theorem measurable_fb1 : Measurable fb1 :=
  ((EuclideanSpace.proj (1 : Fin 2)).comp prjL).continuous.measurable
theorem measurable_bs2 : Measurable bs2 :=
  ((EuclideanSpace.proj (0 : Fin 2)).comp prjR).continuous.measurable
theorem measurable_fb2 : Measurable fb2 :=
  ((EuclideanSpace.proj (1 : Fin 2)).comp prjR).continuous.measurable

theorem gOne_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0) :
    gOne p gam F y1 z1 ≠ ⊤ := by
  rw [gOne]
  exact ENNReal.mul_ne_top hfin (psi1B_ne_top hp hgam1 hne hfin hpos)

theorem gOne_ne_zero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0) :
    gOne p gam F y1 z1 ≠ 0 := by
  rw [gOne]
  exact mul_ne_zero hpos (psi1B_ne_zero hp hgam1 hne hfin hpos)

theorem gZero_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0)
    (y2 z2 : ℝ) : gZero p gam F y1 z1 y2 z2 ≠ ⊤ := by
  have hP0 : psi1B p gam F y1 z1 ≠ 0 := psi1B_ne_zero hp hgam1 hne hfin hpos
  have hPt : psi1B p gam F y1 z1 ≠ ⊤ := psi1B_ne_top hp hgam1 hne hfin hpos
  rw [gZero]
  refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ?_
  · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) enorm_ne_top
  · rw [ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact hpos hc.1
    · exact hfin hc.1
  · rw [psi0B, ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact hP0 hc.1
    · exact hPt hc.1

/-- The Calderón family of `F`: `F_ζ = sgn(F)·G₀^{1-ζ}G₁^{ζ}`. -/
noncomputable def Ffam (p gam : ℝ) (F : Pl2 → ℂ) (ζ : ℂ) (q : Pl2) : ℂ :=
  signC (F q) * rpowC ((gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal) (1 - ζ)
    * rpowC ((gOne p gam F (bs1 q) (bs2 q)).toReal) ζ

/-- The family of the test function: `φ_ζ = sgn(φ)|φ|^{p'(1+ζ)/2}`. -/
noncomputable def phifam (p : ℝ) (φ : ℝ → Pl → ℂ) (ζ : ℂ) (t : ℝ) (x : Pl) : ℂ :=
  signC (φ t x) * rpowC ‖φ t x‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2)

theorem rpowC_toReal_eq {a : ℝ≥0∞} (hat : a ≠ ⊤) {s : ℝ} (hs : 0 < s) :
    rpowC a.toReal ((s : ℝ) : ℂ) = (((a ^ s).toReal : ℝ) : ℂ) := by
  rcases eq_or_ne a 0 with h0 | h0
  · rw [h0, ENNReal.toReal_zero, rpowC_zero_base, ENNReal.zero_rpow_of_pos hs,
      ENNReal.toReal_zero, Complex.ofReal_zero]
  · have hpos : 0 < a.toReal := ENNReal.toReal_pos h0 hat
    rw [rpowC_of_pos hpos]
    have h1 : (((s : ℝ) : ℂ) * (Real.log a.toReal : ℂ))
        = ((s * Real.log a.toReal : ℝ) : ℂ) := by
      push_cast
      ring
    rw [h1, ← Complex.ofReal_exp]
    congr 1
    rw [← ENNReal.toReal_rpow, Real.rpow_def_of_pos hpos, mul_comm]

set_option maxHeartbeats 1000000 in
/-- The Calderón family reproduces `F` at `ζ = θ = 1 - 2/p`. -/
theorem Ffam_at_theta {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {q : Pl2} (hne : bs1 q ≠ bs2 q) (hfin : fibProf p F (bs1 q) (bs2 q) ≠ ⊤)
    (hpos : fibProf p F (bs1 q) (bs2 q) ≠ 0) :
    Ffam p gam F (((1 - 2 / p : ℝ)) : ℂ) q = F q := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := by positivity
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  set y1 := bs1 q
  set z1 := bs2 q
  set y2 := fb1 q
  set z2 := fb2 q
  have hGZt : gZero p gam F y1 z1 y2 z2 ≠ ⊤ := gZero_ne_top hp hgam1 hne hfin hpos y2 z2
  have hG1t : gOne p gam F y1 z1 ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
  have hone : (1 : ℂ) - ((1 - 2 / p : ℝ) : ℂ) = ((2 / p : ℝ) : ℂ) := by
    push_cast
    ring
  rw [Ffam, hone, rpowC_toReal_eq hGZt h2p, rpowC_toReal_eq hG1t h2p']
  have hprod : (((gZero p gam F y1 z1 y2 z2 ^ (2 / p)).toReal : ℝ) : ℂ)
      * (((gOne p gam F y1 z1 ^ (1 - 2 / p)).toReal : ℝ) : ℂ)
      = ((((gZero p gam F y1 z1 y2 z2 ^ (2 / p))
          * (gOne p gam F y1 z1 ^ (1 - 2 / p))).toReal : ℝ) : ℂ) := by
    rw [ENNReal.toReal_mul]
    push_cast
    ring
  rw [mul_assoc, hprod, calderon_factorization hp hgam1 hne hfin hpos y2 z2]
  have hval : ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ.toReal = ‖F q‖ := by
    rw [pr_bs_fb q, ← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)]
  rw [hval, signC_mul_norm]

/-! ### The edge bounds for the Calderón family -/

theorem wtB_eq_top {p gam : ℝ} (hp : 0 < p) (hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 = z1) :
    wtB p gam y1 z1 = ⊤ := by
  have hneg : (1 - 2 * gam) / p < 0 := by
    refine div_neg_of_neg_of_pos ?_ hp
    linarith
  rw [wtB, h, sub_self]
  have h0 : ‖(0 : ℝ)‖ₑ = 0 := by simp
  rw [h0, ENNReal.zero_rpow_of_neg hneg]

/-- Off the support of the fibre profile, and on the diagonal, the whole family vanishes. -/
theorem Ffam_eq_zero_of_degenerate {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam)
    (F : Pl2 → ℂ) (ζ : ℂ) {q : Pl2}
    (hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q) :
    Ffam p gam F ζ q = 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  rcases hdeg with h0 | hdiag
  · -- the profile vanishes, so `G₁ = 0`
    have hg1 : gOne p gam F (bs1 q) (bs2 q) = 0 := by
      rw [gOne, h0, zero_mul]
    rw [Ffam, hg1, ENNReal.toReal_zero, rpowC_zero_base, mul_zero]
  · -- on the diagonal `Ψ₀ = 0`, so `G₀ = 0`
    rcases eq_or_ne (fibProf p F (bs1 q) (bs2 q)) 0 with h0 | h0
    · have hg1 : gOne p gam F (bs1 q) (bs2 q) = 0 := by
        rw [gOne, h0, zero_mul]
      rw [Ffam, hg1, ENNReal.toReal_zero, rpowC_zero_base, mul_zero]
    · have hWtop : wtB p gam (bs1 q) (bs2 q) = ⊤ := wtB_eq_top hppos hgam1 hdiag
      have huTop : uB p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [uB, hWtop]
        exact ENNReal.top_mul h0
      have hpsi1 : psi1B p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [psi1B, hWtop, huTop, ENNReal.top_rpow_of_pos (by linarith)]
        exact ENNReal.top_mul_top
      have hpsi0 : psi0B p gam F (bs1 q) (bs2 q) = 0 := by
        rw [psi0B, hpsi1]
        refine ENNReal.top_rpow_of_neg ?_
        have h1 : (0 : ℝ) < p - 2 := by linarith
        linarith [div_pos h1 (by norm_num : (0:ℝ) < 2)]
      have hg0 : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = 0 := by
        rw [gZero, hpsi0, mul_zero]
      rw [Ffam, hg0, ENNReal.toReal_zero, rpowC_zero_base, mul_zero, zero_mul]

set_option maxHeartbeats 1000000 in
/-- **The edge bound at `Re ζ = 0`.** -/
theorem enorm_Ffam_le_gZero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 0) (q : Pl2) :
    ‖Ffam p gam F ζ q‖ₑ ≤ gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) := by
  by_cases hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q
  · rw [Ffam_eq_zero_of_degenerate hp hgam1 F ζ hdeg, enorm_zero]
    exact zero_le
  · push_neg at hdeg
    obtain ⟨hpos, hne⟩ := hdeg
    by_cases hfin : fibProf p F (bs1 q) (bs2 q) = ⊤
    · -- an infinite profile makes `G₀` vanish, so the bound is trivial
      by_cases hz : ‖Ffam p gam F ζ q‖ₑ = 0
      · rw [hz]
        exact zero_le
      · -- `G₀` contains the factor `Φ^{1-p/2}` with `Φ = ⊤`, which is `0`; so the family vanishes
        exfalso
        have hexp : (1 : ℝ) - p / 2 < 0 := by
          rw [sub_neg]
          rw [lt_div_iff₀ (by norm_num : (0:ℝ) < 2)]
          linarith
        have h1 : (fibProf p F (bs1 q) (bs2 q)) ^ (1 - p / 2) = 0 := by
          rw [hfin]
          exact ENNReal.top_rpow_of_neg hexp
        have hg0z : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = 0 := by
          rw [gZero, h1, mul_zero, zero_mul]
        rw [Ffam, hg0z, ENNReal.toReal_zero, rpowC_zero_base, mul_zero, zero_mul, enorm_zero] at hz
        exact hz rfl
    · -- the nondegenerate case
      have hG0t : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) ≠ ⊤ :=
        gZero_ne_top hp hgam1 hne hfin hpos (fb1 q) (fb2 q)
      have hG1t : gOne p gam F (bs1 q) (bs2 q) ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
      set a : ℝ := (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal with ha
      set b : ℝ := (gOne p gam F (bs1 q) (bs2 q)).toReal with hb
      have hbpos : 0 < b := by
        rw [hb]
        exact ENNReal.toReal_pos (gOne_ne_zero hp hgam1 hne hfin hpos) hG1t
      have hanonneg : 0 ≤ a := by
        rw [ha]
        exact ENNReal.toReal_nonneg
      -- the norm of the family
      have hnorm : ‖Ffam p gam F ζ q‖ ≤ a := by
        rcases eq_or_lt_of_le hanonneg with hazero | hapos
        · have h1 : rpowC a (1 - ζ) = 0 := by
            rw [← hazero, rpowC_zero_base]
          rw [Ffam, h1, mul_zero, zero_mul, norm_zero, ← hazero]
        · have h2 : ‖rpowC a (1 - ζ)‖ = a ^ (1 - ζ).re := norm_rpowC hapos _
          have h3 : ‖rpowC b ζ‖ = b ^ ζ.re := norm_rpowC hbpos _
          have h4 : (1 - ζ).re = 1 := by
            simp [Complex.sub_re, hζ]
          rw [Ffam, norm_mul, norm_mul, h2, h3, h4, hζ, Real.rpow_one, Real.rpow_zero, mul_one]
          calc ‖signC (F q)‖ * a ≤ 1 * a :=
                mul_le_mul_of_nonneg_right (norm_signC_le_one _) hanonneg
            _ = a := one_mul a
      -- transfer to `ℝ≥0∞`
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖Ffam p gam F ζ q‖ ≤ ENNReal.ofReal a :=
            ENNReal.ofReal_le_ofReal hnorm
        _ = gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) := by
            rw [ha, ENNReal.ofReal_toReal hG0t]

set_option maxHeartbeats 1000000 in
/-- **The edge bound at `Re ζ = 1`.** -/
theorem enorm_Ffam_le_gOne {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 1) (q : Pl2) :
    ‖Ffam p gam F ζ q‖ₑ ≤ gOne p gam F (bs1 q) (bs2 q) := by
  by_cases hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q
  · rw [Ffam_eq_zero_of_degenerate hp hgam1 F ζ hdeg, enorm_zero]
    exact zero_le
  · push_neg at hdeg
    obtain ⟨hpos, hne⟩ := hdeg
    by_cases hfin : fibProf p F (bs1 q) (bs2 q) = ⊤
    · -- `G₁` is then infinite, so the bound is trivial
      have hppos : (0 : ℝ) < p := by linarith
      have hp1 : (0 : ℝ) < p - 1 := by linarith
      have hppgt : 1 < p / (p - 1) := by
        rw [lt_div_iff₀ hp1]
        linarith
      have hW0 : wtB p gam (bs1 q) (bs2 q) ≠ 0 := wtB_ne_zero hppos hgam1 hne
      have hu : uB p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [uB, hfin]
        exact ENNReal.mul_top hW0
      have hpsi : psi1B p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [psi1B, hu, ENNReal.top_rpow_of_pos (by linarith)]
        exact ENNReal.mul_top hW0
      have hg1 : gOne p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [gOne, hfin, hpsi]
        exact ENNReal.top_mul_top
      rw [hg1]
      exact le_top
    · have hG0t : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) ≠ ⊤ :=
        gZero_ne_top hp hgam1 hne hfin hpos (fb1 q) (fb2 q)
      have hG1t : gOne p gam F (bs1 q) (bs2 q) ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
      set a : ℝ := (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal with ha
      set b : ℝ := (gOne p gam F (bs1 q) (bs2 q)).toReal with hb
      have hbpos : 0 < b := by
        rw [hb]
        exact ENNReal.toReal_pos (gOne_ne_zero hp hgam1 hne hfin hpos) hG1t
      have hanonneg : 0 ≤ a := by
        rw [ha]
        exact ENNReal.toReal_nonneg
      have hnorm : ‖Ffam p gam F ζ q‖ ≤ b := by
        rcases eq_or_lt_of_le hanonneg with hazero | hapos
        · have h1 : rpowC a (1 - ζ) = 0 := by
            rw [← hazero, rpowC_zero_base]
          rw [Ffam, h1, mul_zero, zero_mul, norm_zero]
          exact le_of_lt hbpos
        · have h2 : ‖rpowC a (1 - ζ)‖ = a ^ (1 - ζ).re := norm_rpowC hapos _
          have h3 : ‖rpowC b ζ‖ = b ^ ζ.re := norm_rpowC hbpos _
          have h4 : (1 - ζ).re = 0 := by
            simp [Complex.sub_re, hζ]
          rw [Ffam, norm_mul, norm_mul, h2, h3, h4, hζ, Real.rpow_zero, Real.rpow_one, mul_one]
          calc ‖signC (F q)‖ * b ≤ 1 * b :=
                mul_le_mul_of_nonneg_right (norm_signC_le_one _) (le_of_lt hbpos)
            _ = b := one_mul b
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖Ffam p gam F ζ q‖ ≤ ENNReal.ofReal b :=
            ENNReal.ofReal_le_ofReal hnorm
        _ = gOne p gam F (bs1 q) (bs2 q) := by
            rw [hb, ENNReal.ofReal_toReal hG1t]

/-! ### The family of the test function -/

theorem phifam_exponent_re (p : ℝ) (ζ : ℂ) :
    ((((p / (p - 1) : ℝ)) : ℂ) * (1 + ζ) / 2).re = p / (p - 1) * (1 + ζ.re) / 2 := by
  have h1 : ((((p / (p - 1) : ℝ)) : ℂ) * (1 + ζ) / 2)
      = ((((p / (p - 1) / 2 : ℝ)) : ℂ) * (1 + ζ)) := by
    push_cast
    ring
  rw [h1, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.add_re, Complex.add_im,
    Complex.one_re, Complex.one_im]
  ring

theorem phifam_at_theta {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    phifam p φ (((1 - 2 / p : ℝ)) : ℂ) t x = φ t x := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : p - 1 ≠ 0 := by
    intro hc
    have : p = 1 := by linarith [hc]
    linarith
  have hexp : (((p / (p - 1) : ℝ)) : ℂ) * (1 + (((1 - 2 / p : ℝ)) : ℂ)) / 2 = 1 := by
    have hpc : ((p : ℂ)) ≠ 0 := by
      exact_mod_cast hppos.ne'
    have hp1c : ((p : ℂ)) - 1 ≠ 0 := by
      intro hc
      have : ((p - 1 : ℝ) : ℂ) = 0 := by push_cast; linear_combination hc
      exact hp1 (by exact_mod_cast this)
    push_cast
    field_simp
    ring
  rw [phifam, hexp]
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [h0, signC_zero, zero_mul]
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    rw [rpowC_one hpos, signC_mul_norm]

theorem enorm_phifam_le {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) {ζ : ℂ} (hζ : 0 ≤ ζ.re)
    (t : ℝ) (x : Pl) :
    ‖phifam p φ ζ t x‖ₑ ≤ ‖φ t x‖ₑ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hexppos : 0 < p / (p - 1) * (1 + ζ.re) / 2 := by
    have h1 : 0 < p / (p - 1) := by positivity
    have h2 : (0 : ℝ) < 1 + ζ.re := by linarith
    positivity
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [phifam, h0, signC_zero, zero_mul, enorm_zero]
    exact zero_le
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    have hnorm : ‖phifam p φ ζ t x‖ ≤ ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
      rw [phifam, norm_mul, norm_rpowC hpos, phifam_exponent_re]
      calc ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
          ≤ 1 * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
            mul_le_mul_of_nonneg_right (norm_signC_le_one _) (by positivity)
        _ = ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := one_mul _
    rw [← ofReal_norm, ← ofReal_norm]
    calc ENNReal.ofReal ‖phifam p φ ζ t x‖
        ≤ ENNReal.ofReal (‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)) :=
          ENNReal.ofReal_le_ofReal hnorm
      _ = (ENNReal.ofReal ‖φ t x‖) ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
          (ENNReal.ofReal_rpow_of_pos hpos).symm

theorem measurable_phifam {p : ℝ} (φ : ℝ → Pl → ℂ) (ζ : ℂ) {t : ℝ} (hφ : Measurable (φ t)) :
    Measurable (phifam p φ ζ t) := by
  have h1 : Measurable fun x : Pl => signC (φ t x) := measurable_signC.comp hφ
  have h2 : Measurable fun x : Pl =>
      rpowC ‖φ t x‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2) :=
    (measurable_rpowC _).comp hφ.norm
  exact h1.mul h2

theorem differentiable_phifam (p : ℝ) (φ : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    Differentiable ℂ fun ζ : ℂ => phifam p φ ζ t x := by
  have h1 : Differentiable ℂ fun ζ : ℂ => ((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2 :=
    ((differentiable_const _).mul ((differentiable_const (1 : ℂ)).add differentiable_id)).div_const _
  exact (differentiable_const _).mul ((differentiable_rpowC ‖φ t x‖).comp h1)

theorem differentiable_Ffam (p gam : ℝ) (F : Pl2 → ℂ) (q : Pl2) :
    Differentiable ℂ fun ζ : ℂ => Ffam p gam F ζ q := by
  have h1 : Differentiable ℂ fun ζ : ℂ =>
      rpowC ((gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal) (1 - ζ) :=
    (differentiable_rpowC _).comp ((differentiable_const (1 : ℂ)).sub differentiable_id)
  have h2 : Differentiable ℂ fun ζ : ℂ =>
      rpowC ((gOne p gam F (bs1 q) (bs2 q)).toReal) ζ :=
    (differentiable_rpowC _).comp differentiable_id
  exact ((differentiable_const _).mul h1).mul h2

/-! ### The edge norms of the two families -/

@[simp] theorem bs1_pr_mk2 (y1 y2 z1 z2 : ℝ) : bs1 (pr (mk2 y1 y2) (mk2 z1 z2)) = y1 := by
  rw [bs1, prjL_pr, mk2_apply_zero]

@[simp] theorem fb1_pr_mk2 (y1 y2 z1 z2 : ℝ) : fb1 (pr (mk2 y1 y2) (mk2 z1 z2)) = y2 := by
  rw [fb1, prjL_pr, mk2_apply_one]

@[simp] theorem bs2_pr_mk2 (y1 y2 z1 z2 : ℝ) : bs2 (pr (mk2 y1 y2) (mk2 z1 z2)) = z1 := by
  rw [bs2, prjR_pr, mk2_apply_zero]

@[simp] theorem fb2_pr_mk2 (y1 y2 z1 z2 : ℝ) : fb2 (pr (mk2 y1 y2) (mk2 z1 z2)) = z2 := by
  rw [fb2, prjR_pr, mk2_apply_one]

