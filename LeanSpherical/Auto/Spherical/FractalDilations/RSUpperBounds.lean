/-- **The `X₀` edge norm of the family.** -/
theorem wMass1_Ffam_le {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    (hF : Measurable F) (hfin : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) {ζ : ℂ} (hζ : ζ.re = 0) :
    wMass1 gam (Ffam p gam F ζ) ≤ normNpp p gam F := by
  rw [wMass1_iter (measurable_Ffam hF ζ)]
  rw [← lintegral_gZero_sq_weight hp hgam1 hF hfin]
  refine lintegral_mono fun y1 => ?_
  refine lintegral_mono fun z1 => ?_
  refine lintegral_mono fun y2 => ?_
  refine lintegral_mono fun z2 => ?_
  refine mul_le_mul' ?_ (le_refl _)
  refine ENNReal.rpow_le_rpow ?_ (by norm_num)
  have h := enorm_Ffam_le_gZero hp hgam1 F hζ (pr (mk2 y1 y2) (mk2 z1 z2))
  simpa using h

