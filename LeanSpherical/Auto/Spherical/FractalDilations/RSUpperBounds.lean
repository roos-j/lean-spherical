/-- **The uniform bound on the image of the family**, valid on the whole closed strip. -/
theorem enorm_Top2_Ffam_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤)
    {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (x : Pl) :
    ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ
      ≤ ((∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
            * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) ^ ((1 : ℝ) / 2)
          * (normNpp p gam F) ^ ((1 : ℝ) / 2)
        + ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hkkmeas : Measurable fun q : Pl2 =>
      ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact h1.mul h2
  have hsplit : (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)))
      = (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
        + ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
    have hpt : ∀ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q))
        = ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
          + ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
      intro q
      ring
    have hm1 : Measurable fun q : Pl2 =>
        ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) :=
      hkkmeas.mul (measurable_gZero_q hF)
    rw [lintegral_congr hpt, lintegral_add_left hm1]
  calc ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ
      ≤ ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
            * Ffam p gam F ζ q‖ₑ := by
        rw [Top2]
        exact enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)) := by
        refine lintegral_mono fun q => ?_
        rw [enorm_mul, enorm_mul]
        exact mul_le_mul' (le_refl _) (enorm_Ffam_le_sum hpgt hgam1 F hζ0 hζ1 q)
    _ = (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
          + ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := hsplit
    _ ≤ ((∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
            * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) ^ ((1 : ℝ) / 2)
          * (normNpp p gam F) ^ ((1 : ℝ) / 2)
        + ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F := by
        refine add_le_add ?_ (lintegral_kern_gOne_le hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL
          hpgt x hF)
        refine le_trans (lintegral_kern_gZero_le hm ε t hgam1 hgam2 hpgt x hF hfib) ?_
        refine mul_le_mul' ?_ (le_refl _)
        refine ENNReal.rpow_le_rpow ?_ (by norm_num)
        exact le_trans (CKx1_le_CKx j ε m t hgam1 x) (CKx_le_sq hm ε t hgam1 hgam2 x)

/-! ### The real majorant, and continuity of the family's image in the parameter -/

theorem Ffam_eq_zero_of_gZero_top {p gam : ℝ} {F : Pl2 → ℂ} {ζ : ℂ} {q : Pl2}
    (h : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = ⊤) : Ffam p gam F ζ q = 0 := by
  rw [Ffam, h, ENNReal.toReal_top, rpowC_zero_base, mul_zero, zero_mul]

theorem Ffam_eq_zero_of_gOne_top {p gam : ℝ} {F : Pl2 → ℂ} {ζ : ℂ} {q : Pl2}
    (h : gOne p gam F (bs1 q) (bs2 q) = ⊤) : Ffam p gam F ζ q = 0 := by
  rw [Ffam, h, ENNReal.toReal_top, rpowC_zero_base, mul_zero]

/-- The real-valued majorant of the family on the closed strip. -/
theorem norm_Ffam_le_toReal_sum {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (q : Pl2) :
    ‖Ffam p gam F ζ q‖
      ≤ (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
          + gOne p gam F (bs1 q) (bs2 q)).toReal := by
  by_cases htop : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
      + gOne p gam F (bs1 q) (bs2 q) = ⊤
  · have hz : Ffam p gam F ζ q = 0 := by
      rcases ENNReal.add_eq_top.mp htop with h | h
      · exact Ffam_eq_zero_of_gZero_top h
      · exact Ffam_eq_zero_of_gOne_top h
    rw [hz, norm_zero, htop, ENNReal.toReal_top]
  · have h := enorm_Ffam_le_sum hp hgam1 F hζ0 hζ1 q
    rw [← ofReal_norm] at h
    have h2 := ENNReal.toReal_le_toReal (by exact ENNReal.ofReal_ne_top) htop |>.mpr h
    rw [ENNReal.toReal_ofReal (norm_nonneg _)] at h2
    exact h2

/-- The real majorant of the kernel integrand. -/
noncomputable def majB (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (p gam : ℝ) (F : Pl2 → ℂ)
    (x : Pl) (q : Pl2) : ℝ :=
  ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖
    * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)).toReal

theorem majB_nonneg (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (p gam : ℝ) (F : Pl2 → ℂ)
    (x : Pl) (q : Pl2) : 0 ≤ majB j ε m t p gam F x q := by
  rw [majB]
  positivity

theorem measurable_majB {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ} (hF : Measurable F) (x : Pl) :
    Measurable (majB j ε m t p gam F x) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ :=
    (hkc.comp (continuous_const.sub prjL.continuous)).norm.measurable
  have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ :=
    (hkc.comp (continuous_const.sub prjR.continuous)).norm.measurable
  have h3 : Measurable fun q : Pl2 => (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
      + gOne p gam F (bs1 q) (bs2 q)).toReal :=
    ((measurable_gZero_q hF).add (measurable_gOne_q hF)).ennreal_toReal
  exact (h1.mul h2).mul h3

set_option maxHeartbeats 1000000 in
theorem integrable_majB {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) (x : Pl) :
    Integrable (majB j ε m t p gam F x) (volume : Measure Pl2) := by
  refine ⟨(measurable_majB hm ε t p gam hF x).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hbd : ∀ q : Pl2, ‖majB j ε m t p gam F x q‖ₑ
      ≤ ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)) := by
    intro q
    rw [majB, ← ofReal_norm, Real.norm_eq_abs, abs_of_nonneg (by positivity)]
    have h1 : ENNReal.ofReal (‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
            + gOne p gam F (bs1 q) (bs2 q)).toReal)
        = ENNReal.ofReal ‖kern j ε m t (x - prjL q)‖
          * ENNReal.ofReal ‖kern j ε m t (x - prjR q)‖
          * ENNReal.ofReal (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
              + gOne p gam F (bs1 q) (bs2 q)).toReal := by
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_mul (norm_nonneg _)]
    rw [h1, ofReal_norm, ofReal_norm]
    refine mul_le_mul' (le_refl _) ?_
    exact ENNReal.ofReal_toReal_le
  refine lt_of_le_of_lt (lintegral_mono hbd) ?_
  have hsplit : (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)))
      = (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
        + ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
    have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
    have hkkmeas : Measurable fun q : Pl2 =>
        ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ := by
      have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
        (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
      have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
        (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
      exact h1.mul h2
    have hpt : ∀ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q))
        = ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
          + ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
      intro q
      ring
    have hm1 : Measurable fun q : Pl2 =>
        ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) :=
      hkkmeas.mul (measurable_gZero_q hF)
    rw [lintegral_congr hpt, lintegral_add_left hm1]
  rw [hsplit]
  refine ENNReal.add_lt_top.mpr ⟨?_, ?_⟩
  · refine lt_of_le_of_lt (lintegral_kern_gZero_le hm ε t hgam1 hgam2 hpgt x hF hfib) ?_
    refine ENNReal.mul_lt_top ?_ ?_
    · refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) ?_
      exact (CKx1_lt_top hm ε t hgam1 hgam2 x).ne
    · exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hNfin
  · refine lt_of_le_of_lt (lintegral_kern_gOne_le hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL
      hpgt x hF) ?_
    exact ENNReal.mul_lt_top (ENNReal.pow_lt_top ENNReal.ofReal_lt_top) hNfin.lt_top

/-! ### Continuity of the image of the family in the parameter -/

/-- The closed strip `0 ≤ Re ζ ≤ 1`. -/
def clStrip : Set ℂ := {ζ : ℂ | 0 ≤ ζ.re ∧ ζ.re ≤ 1}

theorem aestronglyMeasurable_kern_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ}
    (hF : Measurable F) (x : Pl) (ζ : ℂ) :
    AEStronglyMeasurable (fun q : Pl2 =>
      kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
    (hkc.comp (continuous_const.sub prjL.continuous)).mul
      (hkc.comp (continuous_const.sub prjR.continuous))
  exact (h1.measurable.mul (measurable_Ffam hF ζ)).aestronglyMeasurable

set_option maxHeartbeats 1000000 in
/-- **Continuity in the parameter.**  `ζ ↦ 𝒯_j(F_ζ)(x)` is continuous on the closed strip. -/
theorem continuousOn_Top2_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) (x : Pl) :
    ContinuousOn (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x) clStrip := by
  intro ζ₀ hζ₀
  have hbound_int : Integrable (majB j ε m t p gam F x) (volume : Measure Pl2) :=
    integrable_majB hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin x
  have hmeas : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, AEStronglyMeasurable
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (volume : Measure Pl2) :=
    Filter.Eventually.of_forall fun ζ => aestronglyMeasurable_kern_Ffam hm ε t p gam hF x ζ
  have hbd : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, ∀ᵐ q : Pl2,
      ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q‖
        ≤ majB j ε m t p gam F x q := by
    refine eventually_nhdsWithin_of_forall fun ζ hζ => ?_
    filter_upwards with q
    rw [norm_mul, norm_mul, majB]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact norm_Ffam_le_toReal_sum hpgt hgam1 F hζ.1 hζ.2 q
  have hlim : ∀ᵐ q : Pl2, Filter.Tendsto
      (fun ζ : ℂ => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (nhdsWithin ζ₀ clStrip)
      (nhds (kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ₀ q)) := by
    filter_upwards with q
    have hcont : Continuous fun ζ : ℂ => Ffam p gam F ζ q :=
      (differentiable_Ffam p gam F q).continuous
    have h1 : Filter.Tendsto (fun ζ : ℂ => Ffam p gam F ζ q) (nhdsWithin ζ₀ clStrip)
        (nhds (Ffam p gam F ζ₀ q)) := (hcont.continuousWithinAt (s := clStrip)).tendsto
    exact h1.const_mul _
  have hconv := MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (μ := (volume : Measure Pl2)) (l := nhdsWithin ζ₀ clStrip)
    (F := fun ζ (q : Pl2) => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
      * Ffam p gam F ζ q)
    (f := fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
      * Ffam p gam F ζ₀ q)
    (majB j ε m t p gam F x) hmeas hbd hbound_int hlim
  exact hconv

/-! ### Swapping an interval integral with an integral over a measure space -/

theorem integrable_uncurry_of_bound {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (Function.uncurry G) (((volume : Measure ℝ).restrict S).prod μ) := by
  have hfin : IsFiniteMeasure ((volume : Measure ℝ).restrict S) := by
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ]
    exact hSfin
  have hone : Integrable (fun _ : ℝ => (1 : ℝ)) ((volume : Measure ℝ).restrict S) :=
    integrable_const 1
  have hmaj : Integrable (fun z : ℝ × α => (1 : ℝ) * bound z.2)
      (((volume : Measure ℝ).restrict S).prod μ) := hone.mul_prod hbint
  refine Integrable.mono' hmaj hmeas.aestronglyMeasurable ?_
  have hprodrestrict : (((volume : Measure ℝ).restrict S).prod μ)
      = ((volume : Measure ℝ).prod μ).restrict (S ×ˢ Set.univ) := by
    rw [← Measure.prod_restrict, Measure.restrict_univ]
  have hae : ∀ᵐ z : ℝ × α ∂(((volume : Measure ℝ).restrict S).prod μ), z.1 ∈ S := by
    rw [hprodrestrict]
    have h := ae_restrict_mem (μ := ((volume : Measure ℝ).prod μ))
      (hS.prod MeasurableSet.univ)
    filter_upwards [h] with z hz
    exact hz.1
  filter_upwards [hae] with z hz
  rw [one_mul]
  exact hbd z.1 hz z.2

theorem setIntegral_integral_swap_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    (∫ s in S, ∫ q : α, G s q ∂μ) = ∫ q : α, (∫ s in S, G s q) ∂μ :=
  integral_integral_swap (integrable_uncurry_of_bound hS hSfin hmeas hbd hbint)

theorem integrable_setIntegral_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (fun q : α => ∫ s in S, G s q) μ := by
  have huc := integrable_uncurry_of_bound hS hSfin hmeas hbd hbint
  have h := huc.integral_prod_right
  simpa [Function.uncurry] using h

theorem intervalIntegral_integral_swap_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] (a b : ℝ) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    (∫ s in a..b, ∫ q : α, G s q ∂μ) = ∫ q : α, (∫ s in a..b, G s q) ∂μ := by
  have hbd1 : ∀ s ∈ Set.Ioc a b, ∀ q, ‖G s q‖ ≤ bound q :=
    fun s hs q => hbd s (Or.inl hs) q
  have hbd2 : ∀ s ∈ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q :=
    fun s hs q => hbd s (Or.inr hs) q
  have hIoc1 : (∫ s in Set.Ioc a b, ∫ q : α, G s q ∂μ)
      = ∫ q : α, (∫ s in Set.Ioc a b, G s q) ∂μ :=
    setIntegral_integral_swap_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd1 hbint
  have hIoc2 : (∫ s in Set.Ioc b a, ∫ q : α, G s q ∂μ)
      = ∫ q : α, (∫ s in Set.Ioc b a, G s q) ∂μ :=
    setIntegral_integral_swap_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd2 hbint
  show (∫ s in Set.Ioc a b, ∫ q : α, G s q ∂μ) - (∫ s in Set.Ioc b a, ∫ q : α, G s q ∂μ)
      = ∫ q : α, ((∫ s in Set.Ioc a b, G s q) - ∫ s in Set.Ioc b a, G s q) ∂μ
  rw [hIoc1, hIoc2,
    ← integral_sub
      (integrable_setIntegral_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd1 hbint)
      (integrable_setIntegral_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd2 hbint)]

theorem integrable_intervalIntegral_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] (a b : ℝ) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (fun q : α => ∫ s in a..b, G s q) μ := by
  have h1 := integrable_setIntegral_gen (S := Set.Ioc a b) measurableSet_Ioc measure_Ioc_lt_top
    hmeas (fun s hs q => hbd s (Or.inl hs) q) hbint
  have h2 := integrable_setIntegral_gen (S := Set.Ioc b a) measurableSet_Ioc measure_Ioc_lt_top
    hmeas (fun s hs q => hbd s (Or.inr hs) q) hbint
  exact h1.sub h2

/-- The special case of the swap used for the `ℝ⁴` integral. -/
theorem intervalIntegral_integral_swap_Pl2 (a b : ℝ) {G : ℝ → Pl2 → ℂ}
    (hmeas : Measurable fun z : ℝ × Pl2 => G z.1 z.2)
    {bound : Pl2 → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound (volume : Measure Pl2)) :
    (∫ s in a..b, ∫ q : Pl2, G s q) = ∫ q : Pl2, ∫ s in a..b, G s q :=
  intervalIntegral_integral_swap_gen a b hmeas hbd hbint

theorem integrable_intervalIntegral_Pl2 (a b : ℝ) {G : ℝ → Pl2 → ℂ}
    (hmeas : Measurable fun z : ℝ × Pl2 => G z.1 z.2)
    {bound : Pl2 → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound (volume : Measure Pl2)) :
    Integrable (fun q : Pl2 => ∫ s in a..b, G s q) (volume : Measure Pl2) :=
  integrable_intervalIntegral_gen a b hmeas hbd hbint

/-! ### Holomorphy of the image of the family, by Morera's theorem -/

theorem measurable_rpowC_uncurry : Measurable fun v : ℝ × ℂ => rpowC v.1 v.2 := by
  classical
  have h : (fun v : ℝ × ℂ => rpowC v.1 v.2)
      = fun v : ℝ × ℂ => if v.1 = 0 then 0 else Complex.exp (v.2 * (Real.log v.1 : ℂ)) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_fst measurable_const)
    measurable_const ?_
  exact Complex.measurable_exp.comp (measurable_snd.mul
    (Complex.measurable_ofReal.comp (Real.measurable_log.comp measurable_fst)))

set_option maxHeartbeats 1000000 in
theorem measurable_Ffam_uncurry {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun v : ℂ × Pl2 => Ffam p gam F v.1 v.2 := by
  have h1 : Measurable fun v : ℂ × Pl2 => signC (F v.2) :=
    measurable_signC.comp (hF.comp measurable_snd)
  have h2 : Measurable fun v : ℂ × Pl2 =>
      rpowC ((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal) (1 - v.1) := by
    have hfun : (fun v : ℂ × Pl2 =>
        rpowC ((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal) (1 - v.1))
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl2 =>
            (((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal, 1 - v.1)
              : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact (((measurable_gZero_q hF).ennreal_toReal).comp measurable_snd).prodMk
      (measurable_const.sub measurable_fst)
  have h3 : Measurable fun v : ℂ × Pl2 =>
      rpowC ((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal) v.1 := by
    have hfun : (fun v : ℂ × Pl2 => rpowC ((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal) v.1)
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl2 =>
            (((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal, v.1) : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact (((measurable_gOne_q hF).ennreal_toReal).comp measurable_snd).prodMk measurable_fst
  exact (h1.mul h2).mul h3

set_option maxHeartbeats 2000000 in
/-- **Holomorphy in the parameter.**  `ζ ↦ 𝒯_j(F_ζ)(x)` is holomorphic on the open strip. -/
theorem differentiableOn_Top2_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) (x : Pl) :
    DifferentiableOn ℂ (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
      (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
  classical
  have hopen : IsOpen (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) :=
    isOpen_Ioo.preimage Complex.continuous_re
  have hbound_int : Integrable (majB j ε m t p gam F x) (volume : Measure Pl2) :=
    integrable_majB hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin x
  -- the integrand as a function of the parameter and of `q`
  set g : Pl2 → ℂ → ℂ := fun q ζ =>
    kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q with hg
  have hgdiff : ∀ q : Pl2, Differentiable ℂ (g q) := by
    intro q
    rw [hg]
    exact (differentiable_Ffam p gam F q).const_mul _
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hjoint : ∀ σ : ℝ → ℂ, Measurable σ →
      Measurable fun v : ℝ × Pl2 => g v.2 (σ v.1) := by
    intro σ hσ
    rw [hg]
    have h1 : Measurable fun v : ℝ × Pl2 =>
        kern j ε m t (x - prjL v.2) * kern j ε m t (x - prjR v.2) := by
      have h2 : Continuous fun q : Pl2 =>
          kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
        (hkc.comp (continuous_const.sub prjL.continuous)).mul
          (hkc.comp (continuous_const.sub prjR.continuous))
      exact h2.measurable.comp measurable_snd
    have h3 : Measurable fun v : ℝ × Pl2 => Ffam p gam F (σ v.1) v.2 := by
      have hfun : (fun v : ℝ × Pl2 => Ffam p gam F (σ v.1) v.2)
          = (fun u : ℂ × Pl2 => Ffam p gam F u.1 u.2)
            ∘ (fun v : ℝ × Pl2 => ((σ v.1, v.2) : ℂ × Pl2)) := rfl
      rw [hfun]
      refine (measurable_Ffam_uncurry hF).comp ?_
      exact (hσ.comp measurable_fst).prodMk measurable_snd
    exact h1.mul h3
  have hbdσ : ∀ σ : ℝ → ℂ, ∀ (S : Set ℝ), (∀ s ∈ S, 0 ≤ (σ s).re ∧ (σ s).re ≤ 1) →
      ∀ s ∈ S, ∀ q : Pl2, ‖g q (σ s)‖ ≤ majB j ε m t p gam F x q := by
    intro σ S hS s hs q
    rw [hg, majB, norm_mul, norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact norm_Ffam_le_toReal_sum hpgt hgam1 F (hS s hs).1 (hS s hs).2 q
  -- the wedge integral commutes with the `q`-integral
  have hwedge : ∀ z w : ℂ, Complex.Rectangle z w ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 →
      Complex.wedgeIntegral z w (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
        = ∫ q : Pl2, Complex.wedgeIntegral z w (g q) := by
    intro z w hzw
    -- the real parts of the two parameter paths stay in the strip
    have hre : ∀ s ∈ Set.uIcc z.re w.re, s ∈ Set.Ioo (0 : ℝ) 1 := by
      intro s hs
      have hmem : ((s : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simpa using hs
        · simpa using Set.left_mem_uIcc
      have h := hzw hmem
      simpa using h
    have hwmem : w.re ∈ Set.Ioo (0 : ℝ) 1 := by
      have hmem : ((w.re : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simpa using Set.right_mem_uIcc
        · simpa using Set.left_mem_uIcc
      have h := hzw hmem
      simpa using h
    -- the two paths
    set σ : ℝ → ℂ := fun s => (s : ℂ) + z.im * Complex.I with hσdef
    set τ : ℝ → ℂ := fun y => (w.re : ℂ) + y * Complex.I with hτdef
    have hσmeas : Measurable σ := by
      rw [hσdef]
      exact (Complex.measurable_ofReal).add measurable_const
    have hτmeas : Measurable τ := by
      rw [hτdef]
      exact measurable_const.add (Complex.measurable_ofReal.mul measurable_const)
    have hσstrip : ∀ s ∈ Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re,
        0 ≤ (σ s).re ∧ (σ s).re ≤ 1 := by
      intro s hs
      have hsu : s ∈ Set.uIcc z.re w.re := by
        rcases hs with h | h
        · exact Set.mem_uIcc_of_le (le_of_lt h.1) h.2
        · exact Set.mem_uIcc_of_ge (le_of_lt h.1) h.2
      have h := hre s hsu
      have hre' : (σ s).re = s := by
        rw [hσdef]
        simp
      rw [hre']
      exact ⟨le_of_lt h.1, le_of_lt h.2⟩
    have hτstrip : ∀ y ∈ Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im,
        0 ≤ (τ y).re ∧ (τ y).re ≤ 1 := by
      intro y _
      have hre' : (τ y).re = w.re := by
        rw [hτdef]
        simp
      rw [hre']
      exact ⟨le_of_lt hwmem.1, le_of_lt hwmem.2⟩
    have hswap1 : (∫ s in z.re..w.re, Top2 j ε m t (Ffam p gam F (σ s)) x)
        = ∫ q : Pl2, ∫ s in z.re..w.re, g q (σ s) := by
      refine intervalIntegral_integral_swap_Pl2 z.re w.re (hjoint σ hσmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro s hs q
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs q
    have hswap2 : (∫ y in z.im..w.im, Top2 j ε m t (Ffam p gam F (τ y)) x)
        = ∫ q : Pl2, ∫ y in z.im..w.im, g q (τ y) := by
      refine intervalIntegral_integral_swap_Pl2 z.im w.im (hjoint τ hτmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro y hy q
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy q
    have hint1 : Integrable (fun q : Pl2 => ∫ s in z.re..w.re, g q (σ s))
        (volume : Measure Pl2) := by
      refine integrable_intervalIntegral_Pl2 z.re w.re (hjoint σ hσmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro s hs q
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs q
    have hint2 : Integrable (fun q : Pl2 => ∫ y in z.im..w.im, g q (τ y))
        (volume : Measure Pl2) := by
      refine integrable_intervalIntegral_Pl2 z.im w.im (hjoint τ hτmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro y hy q
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy q
    have hσapp : ∀ s : ℝ, σ s = (s : ℂ) + z.im * Complex.I := fun s => rfl
    have hτapp : ∀ y : ℝ, τ y = (w.re : ℂ) + y * Complex.I := fun y => rfl
    simp only [Complex.wedgeIntegral, ← hσapp, ← hτapp]
    rw [hswap1, hswap2,
      ← integral_smul Complex.I (fun q : Pl2 => ∫ y in z.im..w.im, g q (τ y))]
    exact (integral_add hint1 (hint2.smul Complex.I)).symm
  -- conclude by Morera
  rw [← Complex.isConservativeOn_and_continuousOn_iff_isDifferentiableOn hopen]
  refine ⟨?_, ?_⟩
  · intro z w hzw
    have hrecteq : Complex.Rectangle w z = Complex.Rectangle z w := by
      rw [Complex.Rectangle, Complex.Rectangle, Set.uIcc_comm w.re z.re,
        Set.uIcc_comm w.im z.im]
    have hrect : Complex.Rectangle w z ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 := by
      rw [hrecteq]
      exact hzw
    rw [hwedge z w hzw, hwedge w z hrect, ← integral_neg]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    exact (hgdiff q).differentiableOn.isConservativeOn z w (Set.subset_univ _)
  · refine (continuousOn_Top2_Ffam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt
      hF hfib hNfin x).mono ?_
    intro ζ hζ
    exact ⟨le_of_lt hζ.1, le_of_lt hζ.2⟩

/-! ### Level two: continuity and holomorphy of the pairing in the parameter -/

/-- `a^r ≤ a^{r₀} + a^{r₁}` when `0 < r₀ ≤ r ≤ r₁`. -/
theorem rpow_le_add_rpow {a r r0 r1 : ℝ} (ha : 0 ≤ a) (hr0 : 0 < r0)
    (h0 : r0 ≤ r) (h1 : r ≤ r1) : a ^ r ≤ a ^ r0 + a ^ r1 := by
  rcases eq_or_lt_of_le ha with h | hapos
  · have hrpos : 0 < r := lt_of_lt_of_le hr0 h0
    have hr1pos : 0 < r1 := lt_of_lt_of_le hrpos h1
    rw [← h, Real.zero_rpow hrpos.ne', Real.zero_rpow hr0.ne', Real.zero_rpow hr1pos.ne']
    norm_num
  · rcases le_or_gt a 1 with hle | hgt
    · refine le_trans (Real.rpow_le_rpow_of_exponent_ge hapos hle h0) ?_
      exact le_add_of_nonneg_right (Real.rpow_nonneg ha _)
    · refine le_trans (Real.rpow_le_rpow_of_exponent_le hgt.le h1) ?_
      exact le_add_of_nonneg_left (Real.rpow_nonneg ha _)

/-- **The real bound on the test family**, valid on the whole closed strip. -/
theorem norm_phifam_le_add {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) {ζ : ℂ}
    (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (t : ℝ) (x : Pl) :
    ‖phifam p φ ζ t x‖ ≤ ‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hpp : (0 : ℝ) < p / (p - 1) := div_pos (by linarith) hp1
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [phifam, h0, signC_zero, zero_mul, norm_zero]
    exact add_nonneg (Real.rpow_nonneg le_rfl _) (Real.rpow_nonneg le_rfl _)
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    rw [phifam, norm_mul, norm_rpowC hpos, phifam_exponent_re]
    have hb : ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
        ≤ ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
      calc ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
          ≤ 1 * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
            mul_le_mul_of_nonneg_right (norm_signC_le_one _) (Real.rpow_nonneg hpos.le _)
        _ = ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := one_mul _
    refine le_trans hb (rpow_le_add_rpow (norm_nonneg _) (by linarith) ?_ ?_)
    · nlinarith [mul_nonneg hpp.le hζ0]
    · nlinarith [mul_le_mul_of_nonneg_left hζ1 hpp.le]

/-- The majorant in the output variable for the level-two dominated convergence. -/
noncomputable def majP (p : ℝ) (φ : ℝ → Pl → ℂ) (Uvr : ℝ) (t : ℝ) (x : Pl) : ℝ :=
  Uvr * (‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)))

theorem majP_nonneg {p : ℝ} (φ : ℝ → Pl → ℂ) {Uvr : ℝ} (hU : 0 ≤ Uvr) (t : ℝ) (x : Pl) :
    0 ≤ majP p φ Uvr t x := by
  have h1 : (0 : ℝ) ≤ ‖φ t x‖ ^ (p / (p - 1) / 2) := Real.rpow_nonneg (norm_nonneg _) _
  have h2 : (0 : ℝ) ≤ ‖φ t x‖ ^ (p / (p - 1)) := Real.rpow_nonneg (norm_nonneg _) _
  rw [majP]
  exact mul_nonneg hU (by linarith)

theorem norm_Top2_phifam_le_majP {j : ℕ} {ε t : ℝ} {m : ℝ → Pl → ℂ} {p gam : ℝ} {F : Pl2 → ℂ}
    (hp : 2 < p) {φ : ℝ → Pl → ℂ} {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1)
    {Uvr : ℝ} (hU : ∀ x : Pl, ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr) (x : Pl) :
    ‖Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x‖ ≤ majP p φ Uvr t x := by
  rw [norm_mul, majP]
  exact mul_le_mul (hU x) (norm_phifam_le_add hp φ hζ0 hζ1 t x) (norm_nonneg _)
    (le_trans (norm_nonneg _) (hU x))

/-- A bounded, compactly supported function has an integrable power of its modulus. -/
theorem integrable_rpow_norm_of_bdd_support {r : ℝ} (hr : 0 < r) {g : Pl → ℂ}
    (hg : Measurable g) {C R : ℝ} (hb : ∀ x : Pl, ‖g x‖ ≤ C)
    (hsupp : ∀ x : Pl, R < ‖x‖ → g x = 0) :
    Integrable (fun x : Pl => ‖g x‖ ^ r) (volume : Measure Pl) := by
  have hCnn : (0 : ℝ) ≤ C := le_trans (norm_nonneg (g 0)) (hb 0)
  have hmeas : Measurable fun x : Pl => ‖g x‖ ^ r :=
    (Real.continuous_rpow_const hr.le).measurable.comp hg.norm
  have hind : Integrable (Set.indicator (Metric.closedBall (0 : Pl) R) (fun _ => C ^ r))
      (volume : Measure Pl) := by
    rw [integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const (measure_closedBall_lt_top).ne
  refine Integrable.mono' hind hmeas.aestronglyMeasurable ?_
  filter_upwards with x
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  by_cases hx : ‖x‖ ≤ R
  · have hmem : x ∈ Metric.closedBall (0 : Pl) R := by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hx
    rw [Set.indicator_of_mem hmem]
    exact Real.rpow_le_rpow (norm_nonneg _) (hb x) hr.le
  · have h0 : g x = 0 := hsupp x (lt_of_not_ge hx)
    rw [h0, norm_zero, Real.zero_rpow hr.ne']
    exact Set.indicator_nonneg (fun _ _ => Real.rpow_nonneg hCnn _) x

theorem integrable_majP {p : ℝ} (hp : 2 < p) {φ : ℝ → Pl → ℂ} {t : ℝ}
    (hφm : Measurable (φ t)) {Cφ R : ℝ} (hφb : ∀ x : Pl, ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ x : Pl, R < ‖x‖ → φ t x = 0) (Uvr : ℝ) :
    Integrable (majP p φ Uvr t) (volume : Measure Pl) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hpp : (0 : ℝ) < p / (p - 1) := div_pos (by linarith) hp1
  have h1 : Integrable (fun x : Pl => ‖φ t x‖ ^ (p / (p - 1) / 2)) (volume : Measure Pl) :=
    integrable_rpow_norm_of_bdd_support (by linarith) hφm hφb hφs
  have h2 : Integrable (fun x : Pl => ‖φ t x‖ ^ (p / (p - 1))) (volume : Measure Pl) :=
    integrable_rpow_norm_of_bdd_support hpp hφm hφb hφs
  have h3 : Integrable (fun x : Pl => Uvr
      * (‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)))) (volume : Measure Pl) :=
    (h1.add h2).const_mul Uvr
  exact h3

set_option maxHeartbeats 1000000 in
/-- Joint measurability of the image of the family in the parameter and in the output variable. -/
theorem measurable_Top2_Ffam_uncurry {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ}
    (hF : Measurable F) :
    Measurable fun v : ℂ × Pl => Top2 j ε m t (Ffam p gam F v.1) v.2 := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hcont : Continuous fun w : (ℂ × Pl) × Pl2 =>
      kern j ε m t (w.1.2 - prjL w.2) * kern j ε m t (w.1.2 - prjR w.2) := by
    have h1 : Continuous fun w : (ℂ × Pl) × Pl2 => kern j ε m t (w.1.2 - prjL w.2) :=
      hkc.comp ((continuous_snd.comp continuous_fst).sub (prjL.continuous.comp continuous_snd))
    have h2 : Continuous fun w : (ℂ × Pl) × Pl2 => kern j ε m t (w.1.2 - prjR w.2) :=
      hkc.comp ((continuous_snd.comp continuous_fst).sub (prjR.continuous.comp continuous_snd))
    exact h1.mul h2
  have hF2 : Measurable fun w : (ℂ × Pl) × Pl2 => Ffam p gam F w.1.1 w.2 := by
    have hfun : (fun w : (ℂ × Pl) × Pl2 => Ffam p gam F w.1.1 w.2)
        = (fun u : ℂ × Pl2 => Ffam p gam F u.1 u.2)
          ∘ (fun w : (ℂ × Pl) × Pl2 => ((w.1.1, w.2) : ℂ × Pl2)) := rfl
    rw [hfun]
    exact (measurable_Ffam_uncurry hF).comp
      ((measurable_fst.comp measurable_fst).prodMk measurable_snd)
  have hjoint : StronglyMeasurable fun w : (ℂ × Pl) × Pl2 =>
      kern j ε m t (w.1.2 - prjL w.2) * kern j ε m t (w.1.2 - prjR w.2)
        * Ffam p gam F w.1.1 w.2 :=
    (hcont.stronglyMeasurable).mul hF2.stronglyMeasurable
  have hSM : StronglyMeasurable fun v : ℂ × Pl =>
      ∫ q : Pl2, kern j ε m t (v.2 - prjL q) * kern j ε m t (v.2 - prjR q)
        * Ffam p gam F v.1 q := hjoint.integral_prod_right'
  exact hSM.measurable

theorem measurable_phifam_uncurry {p : ℝ} {φ : ℝ → Pl → ℂ} {t : ℝ} (hφ : Measurable (φ t)) :
    Measurable fun v : ℂ × Pl => phifam p φ v.1 t v.2 := by
  have h1 : Measurable fun v : ℂ × Pl => signC (φ t v.2) :=
    measurable_signC.comp (hφ.comp measurable_snd)
  have h2 : Measurable fun v : ℂ × Pl =>
      rpowC ‖φ t v.2‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2) := by
    have hfun : (fun v : ℂ × Pl => rpowC ‖φ t v.2‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2))
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl =>
            ((‖φ t v.2‖, ((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2) : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact ((hφ.comp measurable_snd).norm).prodMk
      ((measurable_const.mul (measurable_const.add measurable_fst)).div_const 2)
  exact h1.mul h2

set_option maxHeartbeats 1000000 in
/-- **Continuity of the pairing integrand in the parameter**, for a single dilation `t`. -/
theorem continuousOn_integral_Top2_phifam {j : ℕ} {m : ℝ → Pl → ℂ}
    {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : Measurable (φ t)) {Cφ R : ℝ} (hφb : ∀ x : Pl, ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ x : Pl, R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ} (hUvr : ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr) :
    ContinuousOn
      (fun ζ : ℂ => ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x) clStrip := by
  intro ζ₀ hζ₀
  have hmajint : Integrable (majP p φ Uvr t) (volume : Measure Pl) :=
    integrable_majP hpgt hφm hφb hφs Uvr
  have hmeas : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, AEStronglyMeasurable
      (fun x : Pl => Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
      (volume : Measure Pl) :=
    Filter.Eventually.of_forall fun ζ =>
      ((measurable_Top2 hm ε t (measurable_Ffam hF ζ)).mul
        (measurable_phifam φ ζ hφm)).aestronglyMeasurable
  have hbd : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, ∀ᵐ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x‖ ≤ majP p φ Uvr t x := by
    refine eventually_nhdsWithin_of_forall fun ζ hζ => ?_
    filter_upwards with x
    exact norm_Top2_phifam_le_majP hpgt hζ.1 hζ.2 (hUvr ζ hζ) x
  have hlim : ∀ᵐ x : Pl, Filter.Tendsto
      (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
      (nhdsWithin ζ₀ clStrip)
      (nhds (Top2 j ε m t (Ffam p gam F ζ₀) x * phifam p φ ζ₀ t x)) := by
    filter_upwards with x
    have h1 : Filter.Tendsto (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
        (nhdsWithin ζ₀ clStrip) (nhds (Top2 j ε m t (Ffam p gam F ζ₀) x)) :=
      continuousOn_Top2_Ffam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib
        hNfin x ζ₀ hζ₀
    have h2 : Filter.Tendsto (fun ζ : ℂ => phifam p φ ζ t x) (nhdsWithin ζ₀ clStrip)
        (nhds (phifam p φ ζ₀ t x)) :=
      ((differentiable_phifam p φ t x).continuous.continuousWithinAt (s := clStrip)).tendsto
    exact h1.mul h2
  exact MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (majP p φ Uvr t) hmeas hbd hmajint hlim

