/-- **The edge bound at `Re ζ = 1`** for the pairing of the two families. -/
theorem enorm_pairT_edge1 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {M : ℕ} (hM : 1 ≤ M) (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100)
    (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14) (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ))
    {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam)
    {p : ℝ} (hpgt : 2 < p)
    {F : Pl2 → ℂ} (hF : Measurable F) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ}
    {ζ : ℂ} (hζ : ζ.re = 1) :
    ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ₑ
      ≤ (ENNReal.ofReal (700000000 * (1 + stC) * B0
              * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F)
          * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) := by
  set Cbig : ℝ≥0∞ := ENNReal.ofReal (700000000 * (1 + stC) * B0
    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) with hCbig
  have hCbigtop : Cbig ≠ ⊤ := by
    rw [hCbig]
    exact ENNReal.ofReal_ne_top
  have hBvtop : Cbig ^ 2 * normNpp p gam F ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.pow_ne_top hCbigtop) hNfin
  have hB : ∀ t ∈ Efin, ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ ≤ Cbig ^ 2 * normNpp p gam F := by
    intro t ht x
    have h1 := enorm_Top2_le_mix2 hpol hm hε (hEfin t ht).1 (hEfin t ht).2 hM hQ hMj hMj2 hBL
      (F := Ffam p gam F ζ) (measurable_Ffam (p := p) (gam := gam) hF ζ) x
    rw [← hCbig] at h1
    exact le_trans h1 (mul_le_mul' (le_refl _) (mix2_Ffam_le hpgt hgam1 F hζ))
  refine le_trans (enorm_pairT_le_sup ε Efin _ _ hBvtop hB) ?_
  exact mul_le_mul' (le_refl _) (outL1_phifam_le hpgt Efin φ hζ)

/-! ### The master majorant is integrable against the kernel -/

