/-- **The `L^{q₄}` estimate of §3 for the linear operator**, `q₄ = 2p₄`. -/
theorem lintegral_pow_TopS_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hp : p = (3 + 2 * gam) / 2) (f : SchwartzMap Pl ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p)) ^ (1 / (2 * p))
      ≤ (C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  have hp2 : 2 < p := by rw [hp]; linarith
  have hppos : (0 : ℝ) < p := by linarith
  -- the bilinearization identity, pointwise
  have hpt : ∀ (t : ℝ) (x : Pl), ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p)
      = ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ ^ p := by
    intro t x
    have h2 : ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ
        = ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
      rw [tensF_eq_tens, Top2_tens hm ε t f f, enorm_mul,
        show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast, pow_two]
    rw [h2, ← ENNReal.rpow_mul]
  have hsum : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p))
      = ∑ t ∈ Efin, ∫⁻ x : Pl,
        ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ ^ p := by
    refine Finset.sum_congr rfl fun t _ => ?_
    exact lintegral_congr fun x => hpt t x
  have hroot : ∀ A : ℝ≥0∞, A ^ (1 / (2 * p)) = (A ^ (1 / p)) ^ ((1 : ℝ) / 2) := by
    intro A
    rw [← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hhalf : ∀ C X : ℝ≥0∞, (C * X * X) ^ ((1 : ℝ) / 2) = C ^ ((1 : ℝ) / 2) * X := by
    intro C X
    rw [mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    congr 1
    have hXX : X * X = X ^ (2 : ℝ) := by
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast, pow_two]
    rw [hXX, ← ENNReal.rpow_mul, show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one]
  rw [hsum, hroot]
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_pow_Top2_tensF_le hpol hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin
      hgam1 hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hp f f)
    (by norm_num : (0 : ℝ) ≤ 1 / 2)) (le_of_eq ?_)
  exact hhalf _ _

/-! ### The derivative of the single-scale operator in the dilation parameter -/

/-- The multiplier of the `t`-derivative of `T_t`: `m̃ = 2πiε‖ω‖·m + ∂_t m`. -/
def mtil (ε : ℝ) (m mdot : ℝ → Pl → ℂ) (t : ℝ) (ω : Pl) : ℂ :=
  ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * m t ω + mdot t ω

theorem hasDerivAt_mfull {m mdot : ℝ → Pl → ℂ}
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (j : ℕ) (ε : ℝ) (ω : Pl) (t : ℝ) :
    HasDerivAt (fun s : ℝ => mfull j ε m s ω) (mfull j ε (mtil ε m mdot) t ω) t := by
  have hreal : HasDerivAt (fun s : ℝ => (2 * π * ε * s * ‖ω‖ : ℝ)) (2 * π * ε * ‖ω‖) t := by
    have h1 : HasDerivAt (fun s : ℝ => 2 * π * ε * s) (2 * π * ε) t := by
      simpa using (hasDerivAt_id t).const_mul (2 * π * ε)
    simpa using h1.mul_const ‖ω‖
  have hexp : HasDerivAt (fun s : ℝ => Complex.exp (((2 * π * ε * s * ‖ω‖ : ℝ) : ℂ) * Complex.I))
      (Complex.exp (((2 * π * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I)
        * (((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I)) t :=
    ((hreal.ofReal_comp).mul_const Complex.I).cexp
  have hprod := hexp.mul (hmd ω t)
  have htarget : mfull j ε (mtil ε m mdot) t ω
      = Complex.exp (((2 * π * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I)
          * (((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I) * m t ω
        + Complex.exp (((2 * π * ε * t * ‖ω‖ : ℝ) : ℂ) * Complex.I) * mdot t ω := by
    rw [mfull, mtil]
    ring
  have hgoal : (fun s : ℝ => mfull j ε m s ω)
      = fun s : ℝ => Complex.exp (((2 * π * ε * s * ‖ω‖ : ℝ) : ℂ) * Complex.I) * m s ω := rfl
  rw [hgoal, htarget]
  exact hprod

theorem TopS_eq_integral {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x
      = ∫ ω : Pl, ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m t ω * 𝓕 ((f : Pl → ℂ)) ω) := by
  have h1 : (TopS hm ε t f : Pl → ℂ) x
      = 𝓕⁻ ((SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) : Pl → ℂ)) x := by
    rw [TopS, SchwartzMap.fourierInv_coe]
  rw [h1, Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  have hinner : (inner ℝ v (-x) : ℝ) = -(inner ℝ x v : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  simp only [hinner, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull hm ε t),
    smul_eq_mul, SchwartzMap.fourier_coe]

theorem continuous_integrand_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m t ω * 𝓕 ((f : Pl → ℂ)) ω) := by
  have hee : Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) := by
    have h1 : Continuous fun ω : Pl => -(inner ℝ x ω : ℝ) :=
      (continuous_const.inner continuous_id).neg
    exact continuous_ee.comp h1
  have hfF : Continuous (𝓕 ((f : Pl → ℂ))) := by
    rw [← SchwartzMap.fourier_coe f]
    exact (𝓕 f : SchwartzMap Pl ℂ).continuous
  exact hee.mul (((contDiff_mfull hm ε t).continuous).mul hfF)

theorem integrable_integrand_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    Integrable (fun ω : Pl =>
      ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m t ω * 𝓕 ((f : Pl → ℂ)) ω)) (volume : Measure Pl) := by
  have hbint : Integrable (fun ω : Pl => B0 * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul B0
  refine Integrable.mono' hbint
    (continuous_integrand_mfull hm ε t f x).aestronglyMeasurable ?_
  filter_upwards with ω
  rw [norm_mul, norm_mul, norm_ee, one_mul]
  exact mul_le_mul_of_nonneg_right (norm_mfull_le hm ε t ω) (norm_nonneg _)

set_option maxHeartbeats 1000000 in
/-- **The `t`-derivative of `T_t`.**  Differentiation under the Fourier integral. -/
theorem hasDerivAt_TopS {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2 m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0 B0' : ℝ} {ε : ℝ} (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    HasDerivAt (fun s : ℝ => (TopS hm ε s f : Pl → ℂ) x)
      ((TopS hmt ε t f : Pl → ℂ) x) t := by
  have hbint : Integrable (fun ω : Pl => B0' * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul B0'
  have hkey := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := (volume : Measure Pl)) (x₀ := t) (s := Set.univ)
    (F := fun s ω => ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m s ω * 𝓕 ((f : Pl → ℂ)) ω))
    (F' := fun s ω =>
      ee (-(inner ℝ x ω : ℝ)) * (mfull j ε (mtil ε m mdot) s ω * 𝓕 ((f : Pl → ℂ)) ω))
    (bound := fun ω => B0' * ‖𝓕 ((f : Pl → ℂ)) ω‖)
    (by simp)
    (Filter.Eventually.of_forall fun s =>
      (continuous_integrand_mfull hm ε s f x).aestronglyMeasurable)
    (integrable_integrand_mfull hm ε t f x)
    (continuous_integrand_mfull hmt ε t f x).aestronglyMeasurable
    (by
      filter_upwards with ω
      intro s _
      rw [norm_mul, norm_mul, norm_ee, one_mul]
      exact mul_le_mul_of_nonneg_right (norm_mfull_le hmt ε s ω) (norm_nonneg _))
    hbint
    (by
      filter_upwards with ω
      intro s _
      exact ((hasDerivAt_mfull hmd j ε ω s).mul_const (𝓕 ((f : Pl → ℂ)) ω)).const_mul
        (ee (-(inner ℝ x ω : ℝ))))
  have h1 : (fun s : ℝ => (TopS hm ε s f : Pl → ℂ) x)
      = fun s : ℝ => ∫ ω : Pl,
        ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m s ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    funext s
    exact TopS_eq_integral hm ε s f x
  rw [h1, TopS_eq_integral hmt ε t f x]
  exact hkey.2

theorem continuous_TopS_t {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (hmc : ∀ ω : Pl, Continuous fun s : ℝ => m s ω) (ε : ℝ)
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    Continuous fun s : ℝ => (TopS hm ε s f : Pl → ℂ) x := by
  have hbint : Integrable (fun ω : Pl => B0 * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul B0
  have h1 : (fun s : ℝ => (TopS hm ε s f : Pl → ℂ) x)
      = fun s : ℝ => ∫ ω : Pl,
        ee (-(inner ℝ x ω : ℝ)) * (mfull j ε m s ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    funext s
    exact TopS_eq_integral hm ε s f x
  rw [h1]
  refine continuous_of_dominated
    (fun s => (continuous_integrand_mfull hm ε s f x).aestronglyMeasurable) ?_ hbint ?_
  · intro s
    filter_upwards with ω
    rw [norm_mul, norm_mul, norm_ee, one_mul]
    exact mul_le_mul_of_nonneg_right (norm_mfull_le hm ε s ω) (norm_nonneg _)
  · filter_upwards with ω
    have hcexp : Continuous fun s : ℝ =>
        Complex.exp (((2 * π * ε * s * ‖ω‖ : ℝ) : ℂ) * Complex.I) := by
      refine Complex.continuous_exp.comp ?_
      exact (Complex.continuous_ofReal.comp
        (((continuous_id.const_smul (2 * π * ε)).mul continuous_const))).mul continuous_const
    have hmf : Continuous fun s : ℝ => mfull j ε m s ω := by
      show Continuous fun s : ℝ =>
        Complex.exp (((2 * π * ε * s * ‖ω‖ : ℝ) : ℂ) * Complex.I) * m s ω
      exact hcexp.mul (hmc ω)
    exact continuous_const.mul (hmf.mul continuous_const)

