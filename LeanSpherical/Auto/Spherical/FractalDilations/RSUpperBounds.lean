/-- **The edge bound at `Re ζ = 0`** for the pairing of the two families. -/
theorem enorm_pairT_edge0 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {p : ℝ} (hpgt : 2 < p)
    {F : Pl2 → ℂ} (hF : Measurable F) (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤)
    (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t))
    {ζ : ℂ} (hζ : ζ.re = 0) :
    ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ₑ
      ≤ (4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
            * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
          * normNpp p gam F) ^ ((1 : ℝ) / 2)
        * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) ^ ((1 : ℝ) / 2) := by
  have hFfam_meas : Measurable (Ffam p gam F ζ) := measurable_Ffam hF ζ
  have hwm : wMass gam (Ffam p gam F ζ) ≤ normNpp p gam F :=
    le_trans (wMass_le_wMass1 hgam1 _) (wMass1_Ffam_le hpgt hgam1 hF hfib hζ)
  have hwmfin : wMass gam (Ffam p gam F ζ) ≠ ⊤ := ne_top_of_le_ne_top hNfin hwm
  have hA := prop31_Top2_wmass hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
    hNa hM hcard hcount hFfam_meas hwmfin
  have hA2 : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
      ≤ (4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
            * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
          * normNpp p gam F) ^ ((1 : ℝ) / 2) := by
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    exact le_trans hA (mul_le_mul' (le_refl _) hwm)
  refine le_trans (enorm_pairT_le_L2 hm ε Efin hFfam_meas
    (fun t => measurable_phifam φ ζ (hφm t)) hA2) ?_
  exact mul_le_mul' (le_refl _) (outL2_phifam_le hpgt Efin φ hζ)

