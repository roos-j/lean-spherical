theorem measurable_Ffam {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) (ζ : ℂ) :
    Measurable (Ffam p gam F ζ) := by
  have h1 : Measurable fun q : Pl2 => signC (F q) := measurable_signC.comp hF
  have h2 : Measurable fun q : Pl2 =>
      rpowC ((gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal) (1 - ζ) :=
    (measurable_rpowC _).comp ((measurable_gZero_q hF).ennreal_toReal)
  have h3 : Measurable fun q : Pl2 =>
      rpowC ((gOne p gam F (bs1 q) (bs2 q)).toReal) ζ :=
    (measurable_rpowC _).comp ((measurable_gOne_q hF).ennreal_toReal)
  exact (h1.mul h2).mul h3

