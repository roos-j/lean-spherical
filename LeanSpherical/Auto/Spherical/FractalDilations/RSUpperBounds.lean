/-- **The `X₁` edge norm of the family.** -/
theorem mix2_Ffam_le {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 1) :
    mix2 (Ffam p gam F ζ) ≤ normNpp p gam F := by
  rw [mix2, ← lintegral_gOne p gam hp F]
  refine lintegral_mono fun y1 => ?_
  refine lintegral_mono fun z1 => ?_
  refine iSup_le fun y2 => ?_
  refine iSup_le fun z2 => ?_
  have h := enorm_Ffam_le_gOne hp hgam1 F hζ (pr (mk2 y1 y2) (mk2 z1 z2))
  simpa using h

/-- **The `ℓ²L²` edge norm of the test family.** -/
theorem outL2_phifam_le {p : ℝ} (hp : 2 < p) (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 0) :
    outL2 Efin (phifam p φ ζ)
      ≤ (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) ^ ((1 : ℝ) / 2) := by
  rw [outL2]
  refine ENNReal.rpow_le_rpow ?_ (by norm_num)
  refine Finset.sum_le_sum fun t _ => ?_
  refine lintegral_mono fun x => ?_
  have h := enorm_phifam_le hp φ (by rw [hζ]) t x
  have h2 : ‖phifam p φ ζ t x‖ₑ ^ (2 : ℝ)
      ≤ (‖φ t x‖ₑ ^ (p / (p - 1) * (1 + ζ.re) / 2)) ^ (2 : ℝ) :=
    ENNReal.rpow_le_rpow h (by norm_num)
  refine le_trans h2 (le_of_eq ?_)
  rw [← ENNReal.rpow_mul, hζ]
  congr 1
  ring

/-- **The `ℓ¹L¹` edge norm of the test family.** -/
theorem outL1_phifam_le {p : ℝ} (hp : 2 < p) (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 1) :
    outL1 Efin (phifam p φ ζ) ≤ ∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1)) := by
  rw [outL1]
  refine Finset.sum_le_sum fun t _ => ?_
  refine lintegral_mono fun x => ?_
  have h := enorm_phifam_le hp φ (by rw [hζ]; norm_num) t x
  refine le_trans h (le_of_eq ?_)
  rw [hζ]
  congr 1
  ring

