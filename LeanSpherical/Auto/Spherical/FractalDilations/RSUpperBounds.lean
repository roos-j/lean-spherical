theorem measurable_gOne_q {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun q : Pl2 => gOne p gam F (bs1 q) (bs2 q) := by
  have hbase : Measurable fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ) :=
    measurable_bs1.prodMk measurable_bs2
  have hfun : (fun q : Pl2 => gOne p gam F (bs1 q) (bs2 q))
      = (fun a : ℝ × ℝ => gOne p gam F a.1 a.2)
        ∘ (fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ)) := rfl
