theorem measurable_gZero_q {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun q : Pl2 => gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) := by
  have hbase : Measurable fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ) :=
    measurable_bs1.prodMk measurable_bs2
  have h1 : Measurable fun q : Pl2 => ‖F q‖ₑ ^ (p / 2) := (hF.enorm).pow_const _
  have hfun2 : (fun q : Pl2 => fibProf p F (bs1 q) (bs2 q))
      = (fun a : ℝ × ℝ => fibProf p F a.1 a.2)
        ∘ (fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ)) := rfl
  have hfun3 : (fun q : Pl2 => psi0B p gam F (bs1 q) (bs2 q))
      = (fun a : ℝ × ℝ => psi0B p gam F a.1 a.2)
        ∘ (fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ)) := rfl
  have h2 : Measurable fun q : Pl2 => fibProf p F (bs1 q) (bs2 q) ^ (1 - p / 2) := by
    refine Measurable.pow_const ?_ _
    rw [hfun2]
    exact (measurable_fibProf hF).comp hbase
  have h3 : Measurable fun q : Pl2 => psi0B p gam F (bs1 q) (bs2 q) := by
    rw [hfun3]
    exact (measurable_psi0B hF).comp hbase
  have hfun : (fun q : Pl2 => gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
      = fun q : Pl2 => ‖F q‖ₑ ^ (p / 2) * fibProf p F (bs1 q) (bs2 q) ^ (1 - p / 2)
        * psi0B p gam F (bs1 q) (bs2 q) := by
    funext q
    rw [gZero, pr_bs_fb q]
  rw [hfun]
  exact (h1.mul h2).mul h3

