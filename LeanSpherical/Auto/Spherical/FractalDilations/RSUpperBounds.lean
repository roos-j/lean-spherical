/-- **The counting data of the discretization.**  A set of radii with a subpower Assouad cover
bound has, at every dyadic scale, a `2^{-j}`-net whose interval counts are the ones required by
Proposition 3.1. -/
theorem exists_net_counting_data {E : Set ℝ} {gam eta C : ℝ}
    (hE : E ⊆ Set.Icc (1 : ℝ) 2) (hcov : HasSubpowerAssouadCoverBound E gam eta C)
    (hCnn : 0 ≤ C) (hgamhalf : 1 / 2 ≤ gam) {j : ℕ} (hj : 1 ≤ j) :
    ∃ (Efin : Finset ℝ) (Na : ℝ) (Mc : ℕ),
      1 ≤ Na ∧ Na ≤ 6 + 6 * C * (2 : ℝ) ^ ((j : ℝ) * eta)
      ∧ 2 * Mc ≤ j ∧ (j : ℤ) ≤ 2 * (Mc : ℤ) + 1
      ∧ (∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
      ∧ (∀ t ∈ E, ∃ t' ∈ Efin, |t - t'| ≤ (2 : ℝ) ^ (-(j : ℤ)))
      ∧ (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam)
      ∧ (∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
          (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam))) := by
  classical
  have hgam : (0 : ℝ) ≤ gam := by linarith
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  obtain ⟨Efin, hEmem, hsep, hdense⟩ := exists_delta_net hE hδpos
  set Mc : ℕ := j / 2 with hMcdef
  have hMc : 2 * Mc ≤ j := by
    rw [hMcdef]
    omega
  have hMc2 : (j : ℤ) ≤ 2 * (Mc : ℤ) + 1 := by
    have h1 : j ≤ 2 * Mc + 1 := by
      rw [hMcdef]
      omega
    exact_mod_cast h1
  have hE1 : ∀ t ∈ Efin, 1 ≤ t := fun t ht => (hE (hEmem t ht)).1
  have hE2 : ∀ t ∈ Efin, t ≤ 2 := fun t ht => (hE (hEmem t ht)).2
  set Na0 : ℝ := 2 + 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) with hNa0
  have hpow : (0 : ℝ) < (2 : ℝ) ^ ((j : ℝ) * eta) := Real.rpow_pos_of_pos (by norm_num) _
  have hNa0one : 1 ≤ Na0 := by
    rw [hNa0]
    have h1 : (0 : ℝ) ≤ 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) := by positivity
    linarith
  set Na : ℝ := 3 * Na0 with hNadef
  have hNaone : 1 ≤ Na := by
    rw [hNadef]
    linarith
  have hcount0 : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
      (Na0 * (2 : ℝ) ^ (2 * (k : ℝ) * gam)) := by
    intro k hk
    have hkj : 2 * k ≤ j := by omega
    have h := intervalCount_of_assouad hcov hCnn hgam hkj (by omega) hEmem hE1 hE2 hsep
    refine h.mono ?_
    have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ (2 * (k : ℝ) * gam) := by
      rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) from (Real.rpow_zero 2).symm]
      exact Real.rpow_le_rpow_of_exponent_le (by norm_num)
        (mul_nonneg (by positivity) hgam)
    have h2 : (0 : ℝ) ≤ 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) := by positivity
    rw [hNa0]
    nlinarith [h1, h2]
  have hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
      (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)) := by
    intro k hk
    refine (hcount0 k hk).mono ?_
    have h1 : (0 : ℝ) < (2 : ℝ) ^ (2 * (k : ℝ) * gam) := Real.rpow_pos_of_pos (by norm_num) _
    rw [hNadef]
    nlinarith [hNa0one]
  -- the cardinality bound, from the count at the top scale
  have hdl : (1 : ℝ) / 2 ≤ ((2 : ℝ) ^ (Mc : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ) := by
    have h1 : ((2 : ℝ) ^ (Mc : ℤ)) ^ 2 = (2 : ℝ) ^ (2 * (Mc : ℤ)) := by
      rw [← zpow_natCast ((2:ℝ) ^ (Mc : ℤ)) 2, ← zpow_mul]
      congr 1
      ring
    have h2 : ((2 : ℝ) ^ (2 * (Mc : ℤ))) / (2 : ℝ) ^ (j : ℤ)
        = (2 : ℝ) ^ (2 * (Mc : ℤ) - (j : ℤ)) := (zpow_sub₀ (by norm_num) _ _).symm
    rw [h1, h2]
    have h3 : (-1 : ℤ) ≤ 2 * (Mc : ℤ) - (j : ℤ) := by omega
    have h4 : (2 : ℝ) ^ (-1 : ℤ) ≤ (2 : ℝ) ^ (2 * (Mc : ℤ) - (j : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) h3
    have h5 : (2 : ℝ) ^ (-1 : ℤ) = 1 / 2 := by
      norm_num
    rw [h5] at h4
    exact h4
  have hcardle : (Efin.card : ℝ) ≤ 3 * (Na0 * (2 : ℝ) ^ (2 * (Mc : ℝ) * gam)) :=
    card_le_of_isIntervalCount hdl (fun t ht => ⟨hE1 t ht, hE2 t ht⟩) (hcount0 Mc (le_refl _))
  have hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam) := by
    refine le_trans hcardle ?_
    have hmono : (2 : ℝ) ^ (2 * (Mc : ℝ) * gam) ≤ (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      nlinarith [hgam]
    rw [hNadef]
    nlinarith [hmono, hNa0one, Real.rpow_pos_of_pos (show (0:ℝ) < 2 by norm_num)
      (2 * (Mc : ℝ) * gam)]
  refine ⟨Efin, Na, Mc, hNaone, ?_, hMc, hMc2, fun t ht => ⟨hE1 t ht, hE2 t ht⟩, hdense, hcard,
    hcount⟩
  rw [hNadef, hNa0]
  ring_nf
  linarith

/-- **The plate parameters exist at every scale.**  `M = max 7 ⌈j/2⌉` and `L = M + 2` satisfy all
the hypotheses of the endpoint estimate (K). -/
theorem exists_plate_params (j : ℕ) :
    ∃ Mk L : ℕ, 1 ≤ Mk ∧ (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100
      ∧ 2 * (Mk : ℤ) ≤ (j : ℤ) + 14 ∧ (j : ℤ) ≤ 2 * (Mk : ℤ)
      ∧ ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L := by
  refine ⟨max 7 ((j + 1) / 2), max 7 ((j + 1) / 2) + 2, ?_, ?_, ?_, ?_, ?_⟩
  · exact le_trans (by norm_num) (le_max_left _ _)
  · have h7 : (7 : ℤ) ≤ (max 7 ((j + 1) / 2) : ℕ) := by
      have : 7 ≤ max 7 ((j + 1) / 2) := le_max_left _ _
      exact_mod_cast this
    have hle : (2 : ℝ) ^ (-((max 7 ((j + 1) / 2) : ℕ) : ℤ)) ≤ (2 : ℝ) ^ (-(7 : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    refine le_trans hle ?_
    norm_num
  · have h1 : 2 * max 7 ((j + 1) / 2) ≤ j + 14 := by omega
    exact_mod_cast h1
  · have h1 : j ≤ 2 * max 7 ((j + 1) / 2) := by omega
    exact_mod_cast h1
  · refine Int.ceil_le.mpr ?_
    have hpi : π ≤ 4 := by
      have h := Real.pi_lt_d2
      linarith
    have hpow : (0 : ℝ) < (2 : ℝ) ^ (max 7 ((j + 1) / 2)) := by positivity
    have h1 : π * (2 : ℝ) ^ (max 7 ((j + 1) / 2))
        ≤ 4 * (2 : ℝ) ^ (max 7 ((j + 1) / 2)) := by
      exact mul_le_mul_of_nonneg_right hpi hpow.le
    refine le_trans h1 (le_of_eq ?_)
    push_cast
    rw [pow_add]
    ring

set_option maxHeartbeats 1000000 in
/-- **Theorem 2.1 of the paper for the single-scale operator, with the Assouad data.**  For a
dilation set with a subpower Assouad cover bound, the maximal operator of `T_t` over `E` obeys the
`L^{p₄} → L^{q₄}` bound of §3, with the discretization data produced internally. -/
theorem lintegral_pow_iSup_TopS_le_of_assouad {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {mr ma mrt mat : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 B0t : ℝ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0' B0t' : ℝ} {ε : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    (hpolt : PolarData j (mtil ε m mdot) mrt mat B0t)
    (hmt : MultData j (mtil ε m mdot) m2' B0t')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (hmdc : ∀ ω : Pl, Continuous fun s : ℝ => mdot s ω)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    (hε : |ε| = 1)
    {E : Set ℝ} {gam eta Cass : ℝ} (hE : E ⊆ Set.Icc (1 : ℝ) 2)
    (hcov : HasSubpowerAssouadCoverBound E gam eta Cass) (hCnn : 0 ≤ Cass)
    (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1) (hj : 1 ≤ j)
    {Mk L : ℕ} (hMk : 1 ≤ Mk) (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100)
    (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14) (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ))
    (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hp : p = (3 + 2 * gam) / 2) (f : SchwartzMap Pl ℂ) :
    ∃ (Na : ℝ) (Mc : ℕ), 1 ≤ Na ∧ Na ≤ 6 + 6 * Cass * (2 : ℝ) ^ ((j : ℝ) * eta)
      ∧ 2 * Mc ≤ j ∧ (j : ℤ) ≤ 2 * (Mc : ℤ) + 1
      ∧ (∫⁻ x : Pl, (⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) ^ (2 * p)) ^ (1 / (2 * p))
        ≤ ((C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
            + ENNReal.ofReal (2 * (2 : ℝ) ^ (-(j : ℤ)))
              * (C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2))
          * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨Efin, Na, Mc, hNaone, hNable, hMc, hMc2, hEfin12, hdense, hcard, hcount⟩ :=
    exists_net_counting_data hE hcov hCnn (le_of_lt hgam1) hj
  refine ⟨Na, Mc, hNaone, hNable, hMc, hMc2, ?_⟩
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  exact lintegral_pow_iSup_TopS_le hpol hm hpolt hmt hmd hmdc hCs hCVnn hCV hCst1 hCstd1 hCstd2
    hε Efin hEfin12 hgam1 hgam2 hNaone hMc hcard hcount hMk hQb hMj hMj2 hBL hp hδpos
    (fun t ht => ⟨(hE ht).1, (hE ht).2⟩) hdense f

/-! ### Rotations of the plane -/

/-- The rotation of the plane by the angle `α`. -/
def rotF (α : ℝ) (ω : Pl) : Pl :=
  mk2 (ω 0 * Real.cos α - ω 1 * Real.sin α) (ω 0 * Real.sin α + ω 1 * Real.cos α)

@[simp] theorem rotF_apply_zero (α : ℝ) (ω : Pl) :
    rotF α ω 0 = ω 0 * Real.cos α - ω 1 * Real.sin α := by
  rw [rotF, mk2_apply_zero]

@[simp] theorem rotF_apply_one (α : ℝ) (ω : Pl) :
    rotF α ω 1 = ω 0 * Real.sin α + ω 1 * Real.cos α := by
  rw [rotF, mk2_apply_one]

theorem norm_rotF (α : ℝ) (ω : Pl) : ‖rotF α ω‖ = ‖ω‖ := by
  have hpyth := Real.sin_sq_add_cos_sq α
  have hsq : ‖rotF α ω‖ ^ 2 = ‖ω‖ ^ 2 := by
    rw [norm_sq_two, norm_sq_two, rotF_apply_zero, rotF_apply_one]
    nlinarith [hpyth, sq_nonneg (ω 0), sq_nonneg (ω 1)]
  nlinarith [norm_nonneg (rotF α ω), norm_nonneg ω, hsq]

theorem inner_rotF (α : ℝ) (u v : Pl) :
    (inner ℝ (rotF α u) (rotF α v) : ℝ) = inner ℝ u v := by
  have hpyth := Real.sin_sq_add_cos_sq α
  rw [inner_two, inner_two, rotF_apply_zero, rotF_apply_one, rotF_apply_zero, rotF_apply_one]
  linear_combination (u 0 * v 0 + u 1 * v 1) * hpyth

theorem rotF_pt (α r φ : ℝ) : rotF α (pt r φ) = pt r (φ + α) := by
  show mk2 ((pt r φ) 0 * Real.cos α - (pt r φ) 1 * Real.sin α)
      ((pt r φ) 0 * Real.sin α + (pt r φ) 1 * Real.cos α)
    = mk2 (r * Real.cos (φ + α)) (r * Real.sin (φ + α))
  rw [pt, mk2_apply_zero, mk2_apply_one, Real.cos_add, Real.sin_add]
  congr 1 <;> ring

theorem rotF_rotF (α β : ℝ) (ω : Pl) : rotF α (rotF β ω) = rotF (β + α) ω := by
  show mk2 ((rotF β ω) 0 * Real.cos α - (rotF β ω) 1 * Real.sin α)
      ((rotF β ω) 0 * Real.sin α + (rotF β ω) 1 * Real.cos α)
    = mk2 (ω 0 * Real.cos (β + α) - ω 1 * Real.sin (β + α))
      (ω 0 * Real.sin (β + α) + ω 1 * Real.cos (β + α))
  rw [rotF_apply_zero, rotF_apply_one, Real.cos_add, Real.sin_add]
  congr 1 <;> ring

theorem rotF_zero (ω : Pl) : rotF 0 ω = ω := by
  show mk2 (ω 0 * Real.cos 0 - ω 1 * Real.sin 0) (ω 0 * Real.sin 0 + ω 1 * Real.cos 0) = ω
  rw [Real.cos_zero, Real.sin_zero, show ω 0 * 1 - ω 1 * 0 = ω 0 by ring,
    show ω 0 * 0 + ω 1 * 1 = ω 1 by ring]
  exact mk2_coords ω

theorem rotF_neg_rotF (α : ℝ) (ω : Pl) : rotF (-α) (rotF α ω) = ω := by
  rw [rotF_rotF, add_neg_cancel, rotF_zero]

theorem rotF_rotF_neg (α : ℝ) (ω : Pl) : rotF α (rotF (-α) ω) = ω := by
  rw [rotF_rotF, neg_add_cancel, rotF_zero]

theorem rotF_add_apply (α : ℝ) (u v : Pl) : rotF α (u + v) = rotF α u + rotF α v := by
  have h0 : (u + v) 0 = u 0 + v 0 := rfl
  have h1 : (u + v) 1 = u 1 + v 1 := rfl
  show mk2 ((u + v) 0 * Real.cos α - (u + v) 1 * Real.sin α)
      ((u + v) 0 * Real.sin α + (u + v) 1 * Real.cos α)
    = rotF α u + rotF α v
  rw [h0, h1]
  have hgoal : rotF α u + rotF α v
      = mk2 ((rotF α u) 0 + (rotF α v) 0) ((rotF α u) 1 + (rotF α v) 1) := by
    have e0 : (rotF α u + rotF α v) 0 = (rotF α u) 0 + (rotF α v) 0 := rfl
    have e1 : (rotF α u + rotF α v) 1 = (rotF α u) 1 + (rotF α v) 1 := rfl
    rw [← e0, ← e1, mk2_coords]
  rw [hgoal, rotF_apply_zero, rotF_apply_one, rotF_apply_zero, rotF_apply_one]
  congr 1 <;> ring

theorem rotF_smul_apply (α c : ℝ) (u : Pl) : rotF α (c • u) = c • rotF α u := by
  have h0 : (c • u) 0 = c * u 0 := rfl
  have h1 : (c • u) 1 = c * u 1 := rfl
  show mk2 ((c • u) 0 * Real.cos α - (c • u) 1 * Real.sin α)
      ((c • u) 0 * Real.sin α + (c • u) 1 * Real.cos α)
    = c • rotF α u
  rw [h0, h1]
  have hgoal : c • rotF α u = mk2 (c * (rotF α u) 0) (c * (rotF α u) 1) := by
    have e0 : (c • rotF α u) 0 = c * (rotF α u) 0 := rfl
    have e1 : (c • rotF α u) 1 = c * (rotF α u) 1 := rfl
    rw [← e0, ← e1, mk2_coords]
  rw [hgoal, rotF_apply_zero, rotF_apply_one]
  congr 1 <;> ring

/-- The rotation as a linear equivalence of the plane. -/
def rotLE (α : ℝ) : Pl ≃ₗ[ℝ] Pl where
  toFun := rotF α
  map_add' := rotF_add_apply α
  map_smul' := fun c u => rotF_smul_apply α c u
  invFun := rotF (-α)
  left_inv := rotF_neg_rotF α
  right_inv := rotF_rotF_neg α

/-- The rotation as a linear isometry equivalence of the plane. -/
def rotLIE (α : ℝ) : Pl ≃ₗᵢ[ℝ] Pl where
  toLinearEquiv := rotLE α
  norm_map' := norm_rotF α

@[simp] theorem rotLIE_apply (α : ℝ) (ω : Pl) : rotLIE α ω = rotF α ω := rfl

/-- The rotation as a continuous linear equivalence of the plane. -/
def rotCLE (α : ℝ) : Pl ≃L[ℝ] Pl := (rotLIE α).toContinuousLinearEquiv

@[simp] theorem rotCLE_apply (α : ℝ) (ω : Pl) : rotCLE α ω = rotF α ω := rfl

theorem continuous_rotF (α : ℝ) : Continuous (rotF α) := (rotCLE α).continuous

theorem measurePreserving_rotF (α : ℝ) :
    MeasurePreserving (rotF α) (volume : Measure Pl) (volume : Measure Pl) :=
  (rotLIE α).measurePreserving

theorem measurableEmbedding_rotF (α : ℝ) : MeasurableEmbedding (rotF α) :=
  (rotCLE α).toHomeomorph.measurableEmbedding

theorem lintegral_comp_rotF (α : ℝ) {G : Pl → ℝ≥0∞} (hG : Measurable G) :
    (∫⁻ x : Pl, G (rotF α x)) = ∫⁻ x : Pl, G x :=
  (measurePreserving_rotF α).lintegral_comp hG

theorem fourier_comp_rotF {f : Pl → ℂ} (α : ℝ) (ω : Pl) :
    𝓕 (fun v : Pl => f (rotF α v)) ω = 𝓕 f (rotF α ω) := by
  rw [fourier_eq_ee_Pl, fourier_eq_ee_Pl]
  have hchange := (measurePreserving_rotF α).integral_comp (measurableEmbedding_rotF α)
    (fun u : Pl => ee (inner ℝ u (rotF α ω)) * f u)
  rw [← hchange]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [inner_rotF]

/-! ### Building the multiplier data from derivative bounds -/

/-- The canonical second-derivative field of a smooth multiplier. -/
noncomputable def m2can (m : ℝ → Pl → ℂ) (t : ℝ) (ω : Pl) (e e' : Pl) : ℂ :=
  fderiv ℝ (fderiv ℝ (m t)) ω e e'

set_option maxHeartbeats 1000000 in
/-- **The multiplier data from `iteratedFDeriv` bounds.**  A smooth multiplier supported in the
sector whose derivatives of order at most three gain a factor `2^{-j}` each satisfies
`MultData`. -/
theorem multData_of_bounds {m : ℝ → Pl → ℂ} {B0 : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (m t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), m t ω ≠ 0 → ω ∈ Theta j)
    (hbdi : ∀ n ≤ 3, ∀ (t : ℝ) (ω : Pl),
      ‖iteratedFDeriv ℝ n (m t) ω‖ ≤ B0 * (2 : ℝ) ^ (-((n : ℤ) * (j : ℤ)))) :
    MultData j m (m2can m) B0 := by
  have hfd : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fderiv ℝ (m t)) := by
    intro t
    exact (hsmooth t).fderiv_right (by simp)
  have hfd2 : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fderiv ℝ (fderiv ℝ (m t))) := by
    intro t
    exact (hfd t).fderiv_right (by simp)
  refine ⟨hsmooth, hsupp, ?_, ?_, ?_, ?_, ?_, hbdi⟩
  · -- the second directional derivative along a line
    intro t ω e e' ρ
    have hcomp : HasDerivAt (fun r : ℝ => fderiv ℝ (m t) (ω + r • e))
        (fderiv ℝ (fderiv ℝ (m t)) (ω + ρ • e) e) ρ :=
      hasDerivAt_line' (hfd t) ω e ρ
    exact (ContinuousLinearMap.apply ℝ ℂ e').hasFDerivAt.comp_hasDerivAt ρ hcomp
  · -- continuity of the second-derivative field
    intro t e e'
    have hcont : Continuous (fderiv ℝ (fderiv ℝ (m t))) := (hfd2 t).continuous
    exact (hcont.clm_apply continuous_const).clm_apply continuous_const
  · -- the sup bound
    intro t ω
    have h := hbdi 0 (by norm_num) t ω
    rw [norm_iteratedFDeriv_zero] at h
    simpa using h
  · -- the first-derivative bound
    intro t ω u hu
    have h := hbdi 1 (by norm_num) t ω
    rw [norm_iteratedFDeriv_one] at h
    have h2 : ‖fderiv ℝ (m t) ω u‖ ≤ ‖fderiv ℝ (m t) ω‖ * ‖u‖ :=
      (fderiv ℝ (m t) ω).le_opNorm u
    rw [hu, mul_one] at h2
    have hexp : (-(((1 : ℕ) : ℤ) * (j : ℤ))) = -(j : ℤ) := by
      push_cast
      ring
    rw [hexp] at h
    exact le_trans h2 h
  · -- the second-derivative bound
    intro t ω e e' he he'
    have h := hbdi 2 (by norm_num) t ω
    have hval : m2can m t ω e e' = iteratedFDeriv ℝ 2 (m t) ω ![e, e'] := by
      rw [m2can, iteratedFDeriv_two_apply]
      norm_num
    have h2 := (iteratedFDeriv ℝ 2 (m t) ω).le_opNorm ![e, e']
    have hprod : (∏ i : Fin 2, ‖(![e, e'] : Fin 2 → Pl) i‖) = 1 := by
      rw [Fin.prod_univ_two]
      norm_num [he, he']
    rw [hprod, mul_one] at h2
    rw [hval]
    have hexp : (-(((2 : ℕ) : ℤ) * (j : ℤ))) = -2 * (j : ℤ) := by
      push_cast
      ring
    rw [hexp] at h
    exact le_trans h2 h

/-! ### Rescaling a fixed-scale symbol -/

theorem norm_iteratedFDeriv_rescale {g : Pl → ℂ} (hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g) {c : ℝ}
    (hc : 0 ≤ c) (n : ℕ) (ω : Pl) :
    ‖iteratedFDeriv ℝ n (fun v : Pl => g (c • v)) ω‖
      ≤ ‖iteratedFDeriv ℝ n g (c • ω)‖ * c ^ n := by
  set Lc : Pl →L[ℝ] Pl := c • ContinuousLinearMap.id ℝ Pl with hLc
  have hLcapp : ∀ v : Pl, Lc v = c • v := by
    intro v
    rw [hLc]
    rfl
  have hnormLc : ‖Lc‖ ≤ c := by
    rw [hLc]
    refine le_trans (norm_smul_le c (ContinuousLinearMap.id ℝ Pl)) ?_
    rw [Real.norm_eq_abs, abs_of_nonneg hc]
    have h1 : ‖ContinuousLinearMap.id ℝ Pl‖ ≤ 1 := ContinuousLinearMap.norm_id_le
    nlinarith [hc, norm_nonneg (ContinuousLinearMap.id ℝ Pl)]
  have hfun : (fun v : Pl => g (c • v)) = g ∘ Lc := by
    funext v
    rw [Function.comp_apply, hLcapp]
  rw [hfun, Lc.iteratedFDeriv_comp_right hg ω
    (by exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤))]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin n, ‖Lc‖) = ‖Lc‖ ^ n := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod, hLcapp ω]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  exact pow_le_pow_left₀ (norm_nonneg _) hnormLc n

set_option maxHeartbeats 1000000 in
/-- **The multiplier data of a rescaled fixed-scale symbol.**  If `g` is a smooth symbol whose
derivatives up to order three are bounded by `B`, and if the rescaled symbol
`ω ↦ g (2^{-j}ω)` is supported in the sector `Θ_j`, then it satisfies `MultData` with the
constant `B`. -/
theorem multData_of_rescaled {g : ℝ → Pl → ℂ} {B : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (g t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), g t ((2 : ℝ) ^ (-(j : ℤ)) • ω) ≠ 0 → ω ∈ Theta j)
    (hbd : ∀ n ≤ 3, ∀ (t : ℝ) (v : Pl), ‖iteratedFDeriv ℝ n (g t) v‖ ≤ B) :
    MultData j (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (m2can (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))) B := by
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  refine multData_of_bounds ?_ hsupp ?_
  · intro t
    exact (hsmooth t).comp (contDiff_const_smul _)
  · intro n hn t ω
    refine le_trans (norm_iteratedFDeriv_rescale (hsmooth t) hcpos.le n ω) ?_
    have h1 : ((2 : ℝ) ^ (-(j : ℤ))) ^ n = (2 : ℝ) ^ (-((n : ℤ) * (j : ℤ))) := by
      rw [← zpow_natCast ((2 : ℝ) ^ (-(j : ℤ))) n, ← zpow_mul]
      congr 1
      ring
    rw [h1]
    exact mul_le_mul_of_nonneg_right (hbd n hn t _) (by positivity)

/-! ### Building the polar data from derivative bounds -/

theorem contDiff_mk2_pair : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : ℝ × ℝ => mk2 q.1 q.2 := by
  show ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : ℝ × ℝ =>
    q.1 • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
      + q.2 • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)
  exact (contDiff_fst.smul contDiff_const).add (contDiff_snd.smul contDiff_const)

theorem contDiff_pt_radial (φ : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) fun r : ℝ => pt r φ := by
  show ContDiff ℝ (↑(⊤ : ℕ∞)) fun r : ℝ => mk2 (r * Real.cos φ) (r * Real.sin φ)
  exact contDiff_mk2_pair.comp
    ((contDiff_id.mul contDiff_const).prodMk (contDiff_id.mul contDiff_const))

theorem contDiff_pt_angular (r : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ : ℝ => pt r φ := by
  show ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ : ℝ => mk2 (r * Real.cos φ) (r * Real.sin φ)
  exact contDiff_mk2_pair.comp
    ((contDiff_const.mul Real.contDiff_cos).prodMk (contDiff_const.mul Real.contDiff_sin))

/-- The canonical radial data of a multiplier. -/
noncomputable def mrcan (m : ℝ → Pl → ℂ) (k : ℕ) (t φ r : ℝ) : ℂ :=
  iteratedDeriv k (fun r' : ℝ => m t (pt r' φ)) r

/-- The canonical angular data of a multiplier. -/
noncomputable def macan (m : ℝ → Pl → ℂ) (k : ℕ) (t r φ : ℝ) : ℂ :=
  iteratedDeriv k (fun φ' : ℝ => m t (pt r φ')) φ

set_option maxHeartbeats 1000000 in
/-- **The polar data from radial and angular derivative bounds.** -/
theorem polarData_of_bounds {m : ℝ → Pl → ℂ} {B0 : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (m t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), m t ω ≠ 0 → ω ∈ Theta j)
    (hrb : ∀ k ≤ 4, ∀ (t φ r : ℝ),
      ‖mrcan m k t φ r‖ ≤ B0 * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))))
    (hab : ∀ k ≤ 3, ∀ (t r φ : ℝ), ‖macan m k t r φ‖ ≤ B0) :
    PolarData j m (mrcan m) (macan m) B0 := by
  have hrad : ∀ (t φ : ℝ), ContDiff ℝ (↑(⊤ : ℕ∞)) fun r' : ℝ => m t (pt r' φ) := by
    intro t φ
    exact (hsmooth t).comp (contDiff_pt_radial φ)
  have hang : ∀ (t r : ℝ), ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ' : ℝ => m t (pt r φ') := by
    intro t r
    exact (hsmooth t).comp (contDiff_pt_angular r)
  have hvanish : ∀ (t φ r' : ℝ), |r'| < (2 : ℝ) ^ ((j : ℤ) - 1) → m t (pt r' φ) = 0 := by
    intro t φ r' hr'
    by_contra hcon
    have hmem := hsupp t (pt r' φ) hcon
    have hnorm : ‖pt r' φ‖ = |r'| := norm_pt_abs r' φ
    have h := hmem.2.2.1
    rw [hnorm] at h
    linarith
  have hvanishbig : ∀ (t φ r' : ℝ), (2 : ℝ) ^ ((j : ℤ) + 1) < |r'| → m t (pt r' φ) = 0 := by
    intro t φ r' hr'
    by_contra hcon
    have hmem := hsupp t (pt r' φ) hcon
    have hnorm : ‖pt r' φ‖ = |r'| := norm_pt_abs r' φ
    have h := hmem.2.2.2
    rw [hnorm] at h
    linarith
  refine ⟨?_, ?_, ?_, hrb, ?_, ?_, ?_, ?_, hab⟩
  · intro t φ r
    rw [mrcan, iteratedDeriv_zero]
  · intro k hk t φ r
    have hdiff : Differentiable ℝ (iteratedDeriv k fun r' : ℝ => m t (pt r' φ)) :=
      ContDiff.differentiable_iteratedDeriv k (hrad t φ)
        (by exact_mod_cast (ENat.coe_lt_top k))
    have hderiv := (hdiff r).hasDerivAt
    have heq : mrcan m (k + 1) t φ r = deriv (iteratedDeriv k fun r' : ℝ => m t (pt r' φ)) r := by
      rw [mrcan, iteratedDeriv_succ]
    rw [heq]
    exact hderiv
  · intro k hk t φ
    exact ContDiff.continuous_iteratedDeriv k (hrad t φ)
      (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))
  · -- the radial data vanishes at the origin and beyond the annulus
    intro k hk t φ r hr
    rcases hr with hr0 | hrbig
    · have hev : (fun r' : ℝ => m t (pt r' φ)) =ᶠ[nhds r] (fun _ : ℝ => (0 : ℂ)) := by
        have hball : Metric.ball r ((2 : ℝ) ^ ((j : ℤ) - 1)) ∈ nhds r :=
          Metric.ball_mem_nhds r (by positivity)
        filter_upwards [hball] with r' hr'
        rw [Metric.mem_ball, Real.dist_eq, hr0] at hr'
        refine hvanish t φ r' ?_
        simpa using hr'
      rw [mrcan, hev.iteratedDeriv_eq k]
      simp
    · have hev : (fun r' : ℝ => m t (pt r' φ)) =ᶠ[nhds r] (fun _ : ℝ => (0 : ℂ)) := by
        have hnhds : Set.Ioi ((2 : ℝ) ^ ((j : ℤ) + 1)) ∈ nhds r :=
          isOpen_Ioi.mem_nhds hrbig
        filter_upwards [hnhds] with r' hr'
        refine hvanishbig t φ r' ?_
        rw [Set.mem_Ioi] at hr'
        have hpos : (0 : ℝ) < r' := lt_trans (by positivity) hr'
        rw [abs_of_pos hpos]
        exact hr'
      rw [mrcan, hev.iteratedDeriv_eq k]
      simp
  · intro t r φ
    rw [macan, iteratedDeriv_zero]
  · intro k hk t r φ
    have hdiff : Differentiable ℝ (iteratedDeriv k fun φ' : ℝ => m t (pt r φ')) :=
      ContDiff.differentiable_iteratedDeriv k (hang t r)
        (by exact_mod_cast (ENat.coe_lt_top k))
    have hderiv := (hdiff φ).hasDerivAt
    have heq : macan m (k + 1) t r φ
        = deriv (iteratedDeriv k fun φ' : ℝ => m t (pt r φ')) φ := by
      rw [macan, iteratedDeriv_succ]
    rw [heq]
    exact hderiv
  · intro k hk t r
    exact ContDiff.continuous_iteratedDeriv k (hang t r)
      (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))

/-! ### Polar coordinates of a planar vector -/

theorem pt_add_int_mul_two_pi (r φ : ℝ) (n : ℤ) : pt r (φ + n * (2 * π)) = pt r φ := by
  rw [pt, pt, Real.cos_add_int_mul_two_pi, Real.sin_add_int_mul_two_pi]

theorem exists_pt_of_norm_one {v : Pl} (hv : ‖v‖ = 1) : ∃ φ : ℝ, v = pt 1 φ := by
  set z : ℂ := (v 0 : ℂ) + (v 1 : ℂ) * Complex.I with hz
  have hre : z.re = v 0 := by
    rw [hz]
    simp
  have him : z.im = v 1 := by
    rw [hz]
    simp
  have hnorm : ‖z‖ = 1 := by
    have h1 : ‖z‖ = Real.sqrt (z.re ^ 2 + z.im ^ 2) := Complex.norm_eq_sqrt_sq_add_sq z
    rw [h1, hre, him, ← norm_sq_two v, hv]
    norm_num
  have hzne : z ≠ 0 := by
    intro hcon
    rw [hcon] at hnorm
    simp at hnorm
  refine ⟨Complex.arg z, ?_⟩
  have hcos : Real.cos (Complex.arg z) = v 0 := by
    rw [Complex.cos_arg hzne, hnorm, hre, div_one]
  have hsin : Real.sin (Complex.arg z) = v 1 := by
    rw [Complex.sin_arg, hnorm, him, div_one]
  rw [pt, hcos, hsin, one_mul, one_mul]
  exact (mk2_coords v).symm

theorem unitVec_pt_one (i : Fin 2) (φ : ℝ) : unitVec i (pt 1 φ) = (pt 1 φ) i := by
  have hnorm : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hsq : ‖pt 1 φ‖ ^ 2 = 1 := by
    rw [hnorm]
    norm_num
  rw [unitVec, hsq, gsm_eq_inv_sqrt (by norm_num) (by norm_num)]
  norm_num

theorem unitVec_pt_one_zero (φ : ℝ) : unitVec 0 (pt 1 φ) = Real.cos φ := by
  rw [unitVec_pt_one, pt, mk2_apply_zero, one_mul]

theorem unitVec_pt_one_one (φ : ℝ) : unitVec 1 (pt 1 φ) = Real.sin φ := by
  rw [unitVec_pt_one, pt, mk2_apply_one, one_mul]

/-! ### The angular sector cutoff -/

/-- The bump in the first unit coordinate: supported in `[2^{-14}, 3·2^{-14}]`, positive on the
interior of that interval. -/
def angB (s : ℝ) : ℝ :=
  Real.smoothTransition ((2 : ℝ) ^ (14 : ℕ) * s - 1)
    * Real.smoothTransition (3 - (2 : ℝ) ^ (14 : ℕ) * s)

theorem contDiff_angB : ContDiff ℝ (↑(⊤ : ℕ∞)) angB :=
  (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub (contDiff_const.mul contDiff_id)))

theorem angB_nonneg (s : ℝ) : 0 ≤ angB s :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem angB_le_one (s : ℝ) : angB s ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem angB_pos {s : ℝ} (h1 : (2 : ℝ) ^ (14 : ℕ) * s > 1) (h2 : (2 : ℝ) ^ (14 : ℕ) * s < 3) :
    0 < angB s :=
  mul_pos (Real.smoothTransition.pos_of_pos (by linarith))
    (Real.smoothTransition.pos_of_pos (by linarith))

theorem angB_eq_zero_of_le {s : ℝ} (h : (2 : ℝ) ^ (14 : ℕ) * s ≤ 1) : angB s = 0 := by
  rw [angB, Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]

theorem angB_eq_zero_of_ge {s : ℝ} (h : 3 ≤ (2 : ℝ) ^ (14 : ℕ) * s) : angB s = 0 := by
  have hz : Real.smoothTransition (3 - (2 : ℝ) ^ (14 : ℕ) * s) = 0 :=
    Real.smoothTransition.zero_of_nonpos (by linarith)
  rw [angB, hz, mul_zero]

/-- The bump in the second unit coordinate: `0` for `s ≤ 1/4`, `1` for `s ≥ 3/8`. -/
def angC (s : ℝ) : ℝ := Real.smoothTransition (8 * s - 2)

theorem contDiff_angC : ContDiff ℝ (↑(⊤ : ℕ∞)) angC :=
  contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)

theorem angC_nonneg (s : ℝ) : 0 ≤ angC s := Real.smoothTransition.nonneg _

theorem angC_le_one (s : ℝ) : angC s ≤ 1 := Real.smoothTransition.le_one _

theorem angC_eq_one {s : ℝ} (h : 3 / 8 ≤ s) : angC s = 1 := by
  rw [angC, Real.smoothTransition.one_of_one_le (by linarith)]

theorem angC_eq_zero_of_le {s : ℝ} (h : s ≤ 1 / 4) : angC s = 0 := by
  rw [angC, Real.smoothTransition.zero_of_nonpos (by linarith)]

theorem angC_pos {s : ℝ} (h : 1 / 4 < s) : 0 < angC s :=
  Real.smoothTransition.pos_of_pos (by linarith)

/-- The sector cutoff: a smooth function of the direction, supported in the narrow sector. -/
def secCut (v : Pl) : ℝ := angB (unitVec 0 v) * angC (unitVec 1 v)

theorem contDiff_secCut : ContDiff ℝ (↑(⊤ : ℕ∞)) secCut :=
  (contDiff_angB.comp (contDiff_unitVec 0)).mul (contDiff_angC.comp (contDiff_unitVec 1))

theorem secCut_nonneg (v : Pl) : 0 ≤ secCut v :=
  mul_nonneg (angB_nonneg _) (angC_nonneg _)

theorem secCut_le_one (v : Pl) : secCut v ≤ 1 := by
  refine le_trans (mul_le_one₀ (angB_le_one _) (angC_nonneg _) (angC_le_one _)) ?_
  norm_num

theorem secCut_pt_one (φ : ℝ) : secCut (pt 1 φ) = angB (Real.cos φ) * angC (Real.sin φ) := by
  rw [secCut, unitVec_pt_one_zero, unitVec_pt_one_one]

/-- On the annulus where the smooth unit vector field is the true one, the sector cutoff is
supported in the narrow sector. -/
theorem mem_sector_of_secCut_ne_zero {v : Pl} (h1 : (1 : ℝ) / 8 < ‖v‖ ^ 2)
    (h2 : ‖v‖ ^ 2 < 8) (h : secCut v ≠ 0) :
    0 < v 0 ∧ v 0 < (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := by
  have hnormpos : (0 : ℝ) < ‖v‖ := by
    nlinarith [norm_nonneg v]
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (14 : ℕ) := by positivity
  have hgsm : gsm (‖v‖ ^ 2) = 1 / Real.sqrt (‖v‖ ^ 2) :=
    gsm_eq_inv_sqrt (by linarith) (by linarith)
  have hsqrt : Real.sqrt (‖v‖ ^ 2) = ‖v‖ := Real.sqrt_sq (norm_nonneg v)
  have hu0 : unitVec 0 v = v 0 / ‖v‖ := by
    rw [unitVec, hgsm, hsqrt]
    ring
  have hu1 : unitVec 1 v = v 1 / ‖v‖ := by
    rw [unitVec, hgsm, hsqrt]
    ring
  have hB : angB (unitVec 0 v) ≠ 0 := by
    intro hc
    rw [secCut, hc, zero_mul] at h
    exact h rfl
  have hC : angC (unitVec 1 v) ≠ 0 := by
    intro hc
    rw [secCut, hc, mul_zero] at h
    exact h rfl
  have hB1 : 1 < (2 : ℝ) ^ (14 : ℕ) * (v 0 / ‖v‖) := by
    by_contra hcon
    rw [hu0] at hB
    exact hB (angB_eq_zero_of_le (not_lt.mp hcon))
  have hB2 : (2 : ℝ) ^ (14 : ℕ) * (v 0 / ‖v‖) < 3 := by
    by_contra hcon
    rw [hu0] at hB
    exact hB (angB_eq_zero_of_ge (not_lt.mp hcon))
  have hC1 : (1 : ℝ) / 4 < v 1 / ‖v‖ := by
    by_contra hcon
    rw [hu1] at hC
    exact hC (angC_eq_zero_of_le (not_lt.mp hcon))
  have hquot0 : 0 < v 0 / ‖v‖ := by
    by_contra hcon
    have hle : v 0 / ‖v‖ ≤ 0 := not_lt.mp hcon
    nlinarith [hB1, hle, hpow]
  have hv0 : 0 < v 0 := by
    have heq : v 0 = (v 0 / ‖v‖) * ‖v‖ := by
      field_simp
    rw [heq]
    exact mul_pos hquot0 hnormpos
  have hv1 : 0 < v 1 := by
    have heq : v 1 = (v 1 / ‖v‖) * ‖v‖ := by
      field_simp
    rw [heq]
    exact mul_pos (by linarith) hnormpos
  refine ⟨hv0, ?_⟩
  have h14 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / (2 : ℝ) ^ (14 : ℕ) := by
    rw [zpow_neg, ← zpow_natCast (2 : ℝ) 14]
    norm_num
  have h10 : (2 : ℝ) ^ (-(10 : ℤ)) = 1 / (2 : ℝ) ^ (10 : ℕ) := by
    rw [zpow_neg, ← zpow_natCast (2 : ℝ) 10]
    norm_num
  have hdiv : v 0 / ‖v‖ < 3 / (2 : ℝ) ^ (14 : ℕ) := by
    rw [lt_div_iff₀ hpow]
    nlinarith [hB2]
  have hv0lt : v 0 < 3 / (2 : ℝ) ^ (14 : ℕ) * ‖v‖ := (div_lt_iff₀ hnormpos).mp hdiv
  have hnormlt : ‖v‖ < 4 * v 1 := by
    rw [lt_div_iff₀ hnormpos] at hC1
    linarith
  have hcoef : (3 : ℝ) / (2 : ℝ) ^ (14 : ℕ) * 4 ≤ (2 : ℝ) ^ (-(10 : ℤ)) := by
    rw [h10]
    norm_num
  have hposcoef : (0 : ℝ) < 3 / (2 : ℝ) ^ (14 : ℕ) := by positivity
  calc v 0 < 3 / (2 : ℝ) ^ (14 : ℕ) * ‖v‖ := hv0lt
    _ ≤ 3 / (2 : ℝ) ^ (14 : ℕ) * (4 * v 1) := mul_le_mul_of_nonneg_left hnormlt.le hposcoef.le
    _ = (3 / (2 : ℝ) ^ (14 : ℕ) * 4) * v 1 := by ring
    _ ≤ (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := mul_le_mul_of_nonneg_right hcoef hv1.le

/-! ### The rotated sectors cover the circle -/

/-- The number of sectors. -/
def Nsec : ℕ := 2 ^ 17

/-- The angular spacing of the sectors. -/
noncomputable def hsec : ℝ := 2 * π / (Nsec : ℝ)

theorem Nsec_pos : 0 < Nsec := by
  rw [Nsec]
  norm_num

theorem hsec_pos : 0 < hsec := by
  rw [hsec, Nsec]
  have h := Real.pi_pos
  positivity

theorem hsec_le : hsec ≤ (2 : ℝ) ^ (-(14 : ℤ)) := by
  have hpi : π < 3.15 := Real.pi_lt_d2
  have hN : ((Nsec : ℕ) : ℝ) = 131072 := by
    rw [Nsec]
    norm_num
  rw [hsec, hN, div_le_iff₀ (by norm_num : (0 : ℝ) < 131072)]
  have h2 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / 16384 := by
    norm_num
  rw [h2]
  nlinarith [hpi]

theorem Nsec_hsec : (Nsec : ℝ) * hsec = 2 * π := by
  have hN : ((Nsec : ℕ) : ℝ) ≠ 0 := by
    rw [Nsec]
    norm_num
  rw [hsec]
  field_simp

theorem secCut_pt {r : ℝ} (hr1 : (1 : ℝ) / 8 < r ^ 2) (hr2 : r ^ 2 < 8) (hrpos : 0 < r) (φ : ℝ) :
    secCut (pt r φ) = angB (Real.cos φ) * angC (Real.sin φ) := by
  have hnorm : ‖pt r φ‖ = r := norm_pt r φ hrpos.le
  have hsq : ‖pt r φ‖ ^ 2 = r ^ 2 := by
    rw [hnorm]
  have hgsm : gsm (‖pt r φ‖ ^ 2) = 1 / Real.sqrt (‖pt r φ‖ ^ 2) := by
    rw [hsq]
    exact gsm_eq_inv_sqrt (by linarith) (by linarith)
  have hsqrt : Real.sqrt (‖pt r φ‖ ^ 2) = r := by
    rw [hsq, Real.sqrt_sq hrpos.le]
  have hu0 : unitVec 0 (pt r φ) = Real.cos φ := by
    rw [unitVec, hgsm, hsqrt, pt, mk2_apply_zero]
    field_simp
  have hu1 : unitVec 1 (pt r φ) = Real.sin φ := by
    rw [unitVec, hgsm, hsqrt, pt, mk2_apply_one]
    field_simp
  rw [secCut, hu0, hu1]

set_option maxHeartbeats 1000000 in
/-- **The window of the sector cutoff.**  Near `π/2` the cutoff is positive. -/
theorem secCut_pt_pos_of_window {r x : ℝ} (hr1 : (1 : ℝ) / 8 < r ^ 2) (hr2 : r ^ 2 < 8)
    (hrpos : 0 < r) (hx1 : 3 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) ≤ x)
    (hx2 : x ≤ 5 / 2 * (2 : ℝ) ^ (-(14 : ℤ))) :
    0 < secCut (pt r (π / 2 - x)) := by
  have h14 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / 16384 := by
    norm_num
  rw [h14] at hx1 hx2
  have hxpos : 0 < x := by linarith
  have hxsmall : x ≤ 1 := by linarith
  have hcos : Real.cos (π / 2 - x) = Real.sin x := Real.cos_pi_div_two_sub x
  have hsin : Real.sin (π / 2 - x) = Real.cos x := Real.sin_pi_div_two_sub x
  rw [secCut_pt hr1 hr2 hrpos, hcos, hsin]
  refine mul_pos ?_ ?_
  · -- the first bump is positive
    have hsinlt : Real.sin x < x := Real.sin_lt hxpos
    have hsingt : x - x ^ 3 / 6 < Real.sin x := Real.sin_gt_sub_cube hxpos
    refine angB_pos ?_ ?_
    · have hxsq : x ^ 2 ≤ (5 / 2 / 16384) ^ 2 := by
        nlinarith [hx2, hxpos]
      have hcube : x ^ 3 / 6 ≤ x * ((5 / 2 / 16384) ^ 2 / 6) := by
        nlinarith [hxsq, hxpos]
      have hsinlow : x * (1 - (5 / 2 / 16384) ^ 2 / 6) < Real.sin x := by
        nlinarith [hsingt, hcube]
      have hpow : (2 : ℝ) ^ (14 : ℕ) = 16384 := by norm_num
      rw [hpow]
      nlinarith [hsinlow, hx1]
    · have hpow : (2 : ℝ) ^ (14 : ℕ) = 16384 := by norm_num
      rw [hpow]
      nlinarith [hsinlt, hx2]
  · -- the second bump is positive
    refine angC_pos ?_
    have hcosge : 1 - x ^ 2 / 2 ≤ Real.cos x := Real.one_sub_sq_div_two_le_cos
    nlinarith [hcosge, hxsmall, hxpos]

set_option maxHeartbeats 1000000 in
/-- **The rotated sectors cover every direction.** -/
theorem exists_secCut_rot_pos {v : Pl} (h1 : (1 : ℝ) / 8 < ‖v‖ ^ 2) (h2 : ‖v‖ ^ 2 < 8) :
    ∃ ν : ℕ, ν < Nsec ∧ 0 < secCut (rotF (-((ν : ℝ) * hsec)) v) := by
  have hnormpos : (0 : ℝ) < ‖v‖ := by
    nlinarith [norm_nonneg v]
  -- polar coordinates of `v`
  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ, v = pt ‖v‖ φ := by
    have hunit : ‖(‖v‖)⁻¹ • v‖ = 1 := by
      rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hnormpos]
      field_simp
    obtain ⟨φ, hφ1⟩ := exists_pt_of_norm_one hunit
    refine ⟨φ, ?_⟩
    have h3 : v = ‖v‖ • ((‖v‖)⁻¹ • v) := by
      rw [smul_smul, mul_inv_cancel₀ hnormpos.ne', one_smul]
    conv_lhs => rw [h3, hφ1]
    rw [← pt_eq_smul]
  -- choose the rotation index
  have hhpos : 0 < hsec := hsec_pos
  set y : ℝ := φ - π / 2 + 2 * (2 : ℝ) ^ (-(14 : ℤ)) with hy
  set k : ℤ := ⌊y / hsec + 1 / 2⌋ with hk
  have hkbound : |(k : ℝ) * hsec - y| ≤ hsec / 2 := by
    have hfl := Int.floor_le (y / hsec + 1 / 2)
    have hfl2 := Int.lt_floor_add_one (y / hsec + 1 / 2)
    rw [abs_le]
    constructor
    · have h4 : (k : ℝ) ≥ y / hsec - 1 / 2 := by
        rw [hk]
        linarith [hfl2]
      have h5 : (k : ℝ) * hsec ≥ (y / hsec - 1 / 2) * hsec :=
        mul_le_mul_of_nonneg_right h4 hhpos.le
      have h6 : (y / hsec - 1 / 2) * hsec = y - hsec / 2 := by
        field_simp
      linarith [h5, h6.le, h6.ge]
    · have h4 : (k : ℝ) ≤ y / hsec + 1 / 2 := by
        rw [hk]
        exact hfl
      have h5 : (k : ℝ) * hsec ≤ (y / hsec + 1 / 2) * hsec :=
        mul_le_mul_of_nonneg_right h4 hhpos.le
      have h6 : (y / hsec + 1 / 2) * hsec = y + hsec / 2 := by
        field_simp
      linarith [h5, h6.le, h6.ge]
  -- the window
  set x : ℝ := (k : ℝ) * hsec - φ + π / 2 with hx
  have hxwin1 : 3 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) ≤ x := by
    have hhalf : hsec / 2 ≤ (2 : ℝ) ^ (-(14 : ℤ)) / 2 := by
      linarith [hsec_le]
    have h7 := (abs_le.mp hkbound).1
    rw [hx, hy] at *
    linarith [h7, hhalf]
  have hxwin2 : x ≤ 5 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) := by
    have hhalf : hsec / 2 ≤ (2 : ℝ) ^ (-(14 : ℤ)) / 2 := by
      linarith [hsec_le]
    have h7 := (abs_le.mp hkbound).2
    rw [hx, hy] at *
    linarith [h7, hhalf]
  -- reduce the index modulo `Nsec`
  set ν : ℕ := (k % (Nsec : ℤ)).toNat with hν
  have hNpos : (0 : ℤ) < (Nsec : ℤ) := by
    have := Nsec_pos
    exact_mod_cast this
  have hmodnn : 0 ≤ k % (Nsec : ℤ) := Int.emod_nonneg k (by exact_mod_cast hNpos.ne')
  have hmodlt : k % (Nsec : ℤ) < (Nsec : ℤ) := Int.emod_lt_of_pos k hNpos
  have hνcast : ((ν : ℕ) : ℤ) = k % (Nsec : ℤ) := by
    rw [hν]
    exact Int.toNat_of_nonneg hmodnn
  have hνlt : ν < Nsec := by
    have hcast : ((ν : ℕ) : ℤ) < (Nsec : ℤ) := by
      rw [hνcast]
      exact hmodlt
    exact_mod_cast hcast
  refine ⟨ν, hνlt, ?_⟩
  -- the rotation by `ν hsec` agrees with the rotation by `k hsec`
  have hdiff : ((k : ℝ) - (ν : ℝ)) = ((k / (Nsec : ℤ) : ℤ) : ℝ) * (Nsec : ℝ) := by
    have h8 : k % (Nsec : ℤ) = k - (Nsec : ℤ) * (k / (Nsec : ℤ)) := Int.emod_def k _
    have h9 : ((ν : ℕ) : ℝ) = ((k % (Nsec : ℤ) : ℤ) : ℝ) := by
      rw [← hνcast]
      norm_num
    rw [h9, h8]
    push_cast
    ring
  have hrot : rotF (-((ν : ℝ) * hsec)) v = pt ‖v‖ (π / 2 - x) := by
    conv_lhs => rw [hφ]
    rw [rotF_pt]
    have hshift : φ + -((ν : ℝ) * hsec) = (π / 2 - x) + ((k / (Nsec : ℤ) : ℤ) : ℝ) * (2 * π) := by
      rw [hx]
      have h11 : ((k : ℝ) - (ν : ℝ)) * hsec
          = ((k / (Nsec : ℤ) : ℤ) : ℝ) * ((Nsec : ℝ) * hsec) := by
        rw [hdiff]
        ring
      rw [Nsec_hsec] at h11
      linarith [h11]
    rw [hshift, pt_add_int_mul_two_pi]
  rw [hrot]
  exact secCut_pt_pos_of_window h1 h2 hnormpos hxwin1 hxwin2

/-! ### The angular partition of unity -/

theorem rotF_neg_two_pi (v : Pl) : rotF (-(2 * π)) v = v := by
  show mk2 (v 0 * Real.cos (-(2 * π)) - v 1 * Real.sin (-(2 * π)))
      (v 0 * Real.sin (-(2 * π)) + v 1 * Real.cos (-(2 * π))) = v
  rw [Real.cos_neg, Real.sin_neg, Real.cos_two_pi, Real.sin_two_pi]
  rw [show v 0 * 1 - v 1 * -0 = v 0 by ring, show v 0 * -0 + v 1 * 1 = v 1 by ring]
  exact mk2_coords v

/-- The radial cutoff of the partition of unity. -/
def annD (v : Pl) : ℝ :=
  Real.smoothTransition (16 * ‖v‖ ^ 2 - 2) * Real.smoothTransition (8 - ‖v‖ ^ 2)

theorem contDiff_annD : ContDiff ℝ (↑(⊤ : ℕ∞)) annD :=
  (contDiff_st.comp ((contDiff_const.mul (contDiff_norm_sq ℝ)).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub (contDiff_norm_sq ℝ)))

theorem annD_nonneg (v : Pl) : 0 ≤ annD v :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem annD_le_one (v : Pl) : annD v ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem annD_eq_one {v : Pl} (h1 : (1 : ℝ) / 2 ≤ ‖v‖) (h2 : ‖v‖ ≤ 2) : annD v = 1 := by
  have hsq1 : (1 : ℝ) / 4 ≤ ‖v‖ ^ 2 := by nlinarith [norm_nonneg v]
  have hsq2 : ‖v‖ ^ 2 ≤ 4 := by nlinarith [norm_nonneg v]
  rw [annD, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem annulus_of_annD_pos {v : Pl} (h : 0 < annD v) :
    (1 : ℝ) / 8 < ‖v‖ ^ 2 ∧ ‖v‖ ^ 2 < 8 := by
  have h1 : Real.smoothTransition (16 * ‖v‖ ^ 2 - 2) ≠ 0 := by
    intro hc
    rw [annD, hc, zero_mul] at h
    exact absurd h (lt_irrefl 0)
  have h2 : Real.smoothTransition (8 - ‖v‖ ^ 2) ≠ 0 := by
    intro hc
    rw [annD, hc, mul_zero] at h
    exact absurd h (lt_irrefl 0)
  constructor
  · by_contra hcon
    exact h1 (Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith))
  · by_contra hcon
    exact h2 (Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith))

theorem annD_rotF (α : ℝ) (v : Pl) : annD (rotF α v) = annD v := by
  rw [annD, annD, norm_rotF]

/-- The sum of the rotated sector cutoffs. -/
noncomputable def Dsum (v : Pl) : ℝ :=
  ∑ ν ∈ Finset.range Nsec, secCut (rotF (-((ν : ℝ) * hsec)) v)

theorem contDiff_Dsum : ContDiff ℝ (↑(⊤ : ℕ∞)) Dsum := by
  refine ContDiff.sum fun ν _ => ?_
  exact contDiff_secCut.comp ((rotCLE (-((ν : ℝ) * hsec))).contDiff)

theorem Dsum_nonneg (v : Pl) : 0 ≤ Dsum v :=
  Finset.sum_nonneg fun ν _ => secCut_nonneg _

theorem Dsum_pos_of_annD_pos {v : Pl} (h : 0 < annD v) : 0 < Dsum v := by
  obtain ⟨h1, h2⟩ := annulus_of_annD_pos h
  obtain ⟨ν, hν, hpos⟩ := exists_secCut_rot_pos h1 h2
  refine lt_of_lt_of_le hpos ?_
  refine Finset.single_le_sum (f := fun ν : ℕ => secCut (rotF (-((ν : ℝ) * hsec)) v))
    (fun i _ => secCut_nonneg _) ?_
  rw [Finset.mem_range]
  exact hν

set_option maxHeartbeats 1000000 in
/-- The sum of the rotated sector cutoffs is invariant under a rotation by the spacing. -/
theorem Dsum_rotF_step (v : Pl) : Dsum (rotF (-hsec) v) = Dsum v := by
  set f : ℕ → ℝ := fun ν => secCut (rotF (-((ν : ℝ) * hsec)) v) with hf
  have hterm : ∀ ν : ℕ, secCut (rotF (-((ν : ℝ) * hsec)) (rotF (-hsec) v)) = f (ν + 1) := by
    intro ν
    rw [hf, rotF_rotF]
    congr 2
    push_cast
    ring
  have h2 : f Nsec = f 0 := by
    rw [hf]
    show secCut (rotF (-(((Nsec : ℕ) : ℝ) * hsec)) v)
      = secCut (rotF (-(((0 : ℕ) : ℝ) * hsec)) v)
    have hz : (-(((0 : ℕ) : ℝ) * hsec)) = 0 := by
      push_cast
      ring
    rw [hz, rotF_zero, Nsec_hsec, rotF_neg_two_pi]
  have h1 : (∑ ν ∈ Finset.range Nsec, f (ν + 1)) + f 0
      = (∑ ν ∈ Finset.range Nsec, f ν) + f Nsec := by
    rw [← Finset.sum_range_succ' f Nsec, ← Finset.sum_range_succ f Nsec]
  have h3 : (∑ ν ∈ Finset.range Nsec, f (ν + 1)) = ∑ ν ∈ Finset.range Nsec, f ν := by
    rw [h2] at h1
    linarith
  rw [Dsum, Dsum]
  calc (∑ ν ∈ Finset.range Nsec, secCut (rotF (-((ν : ℝ) * hsec)) (rotF (-hsec) v)))
      = ∑ ν ∈ Finset.range Nsec, f (ν + 1) := Finset.sum_congr rfl fun ν _ => hterm ν
    _ = ∑ ν ∈ Finset.range Nsec, f ν := h3

theorem Dsum_rotF_nat (μ : ℕ) : ∀ v : Pl, Dsum (rotF (-((μ : ℝ) * hsec)) v) = Dsum v := by
  induction μ with
  | zero =>
      intro v
      have hz : (-(((0 : ℕ) : ℝ) * hsec)) = 0 := by
        push_cast
        ring
      rw [hz, rotF_zero]
  | succ n ih =>
      intro v
      have hstep : rotF (-(((n + 1 : ℕ) : ℝ) * hsec)) v
          = rotF (-((n : ℝ) * hsec)) (rotF (-hsec) v) := by
        rw [rotF_rotF]
        congr 2
        push_cast
        ring
      rw [hstep, ih (rotF (-hsec) v), Dsum_rotF_step]

/-- The first cutoff of the angular partition of unity. -/
noncomputable def psiSec (v : Pl) : ℝ := secCut v * annD v / (Dsum v + (1 - annD v))

theorem denom_pos (v : Pl) : 0 < Dsum v + (1 - annD v) := by
  rcases lt_or_eq_of_le (annD_le_one v) with hlt | heq
  · have := Dsum_nonneg v
    linarith
  · have hpos : 0 < annD v := by
      rw [heq]
      norm_num
    have := Dsum_pos_of_annD_pos hpos
    rw [heq]
    linarith

theorem contDiff_psiSec : ContDiff ℝ (↑(⊤ : ℕ∞)) psiSec := by
  refine ContDiff.div (contDiff_secCut.mul contDiff_annD) ?_ ?_
  · exact contDiff_Dsum.add (contDiff_const.sub contDiff_annD)
  · intro v
    exact (denom_pos v).ne'

theorem psiSec_nonneg (v : Pl) : 0 ≤ psiSec v := by
  rw [psiSec]
  exact div_nonneg (mul_nonneg (secCut_nonneg v) (annD_nonneg v)) (denom_pos v).le

theorem psiSec_eq_zero_of_secCut_eq_zero {v : Pl} (h : secCut v = 0) : psiSec v = 0 := by
  rw [psiSec, h, zero_mul, zero_div]

set_option maxHeartbeats 1000000 in
/-- **The angular partition of unity.**  On the annulus the rotated cutoffs sum to one. -/
theorem sum_psiSec_rotF {v : Pl} (h1 : (1 : ℝ) / 2 ≤ ‖v‖) (h2 : ‖v‖ ≤ 2) :
    (∑ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v)) = 1 := by
  have hannD : annD v = 1 := annD_eq_one h1 h2
  have hterm : ∀ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v)
      = secCut (rotF (-((ν : ℝ) * hsec)) v) / Dsum v := by
    intro ν _
    rw [psiSec, annD_rotF, Dsum_rotF_nat, hannD]
    norm_num
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_div, ← Dsum]
  have hpos : 0 < Dsum v := by
    refine Dsum_pos_of_annD_pos ?_
    rw [hannD]
    norm_num
  exact div_self hpos.ne'

theorem sector_of_psiSec_ne_zero {v : Pl} (h : psiSec v ≠ 0) :
    (1 : ℝ) / 8 < ‖v‖ ^ 2 ∧ ‖v‖ ^ 2 < 8 ∧ 0 < v 0 ∧ v 0 < (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := by
  have hs : secCut v ≠ 0 := by
    intro hc
    exact h (psiSec_eq_zero_of_secCut_eq_zero hc)
  have ha : annD v ≠ 0 := by
    intro hc
    rw [psiSec, hc, mul_zero, zero_div] at h
    exact h rfl
  have hapos : 0 < annD v := lt_of_le_of_ne (annD_nonneg v) (Ne.symm ha)
  obtain ⟨h1, h2⟩ := annulus_of_annD_pos hapos
  obtain ⟨h3, h4⟩ := mem_sector_of_secCut_ne_zero h1 h2 hs
  exact ⟨h1, h2, h3, h4⟩

/-! ### The radial amplitude of the planar surface wave -/

theorem pi_mul_aux {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3) (hu : 1 ≤ u) :
    (0 : ℝ) < 2 * π * t ∧ 2 * π * t ≤ 6 * π ∧ (1 : ℝ) ≤ 2 * π * t * u
      ∧ u ≤ 2 * π * t * u := by
  have hπ : (3 : ℝ) < π := Real.pi_gt_three
  have hupos : (0 : ℝ) < u := by linarith
  have h1 : (3 : ℝ) ≤ 2 * π * t := by nlinarith
  have h2 : (0 : ℝ) < 2 * π * t := by linarith
  have h3 : 2 * π * t ≤ 6 * π := by nlinarith
  have h4 : 2 * π * t ≤ 2 * π * t * u := by nlinarith
  refine ⟨h2, h3, by linarith, ?_⟩
  nlinarith

theorem sqrt_pow_id {u : ℝ} (hu : 1 ≤ u) (k : ℕ) :
    (Real.sqrt u) ^ (2 * k + 1) = u ^ k * Real.sqrt u := by
  have h1 : (Real.sqrt u) ^ (2 * k + 1) = ((Real.sqrt u) ^ 2) ^ k * Real.sqrt u := by
    rw [← pow_mul, ← pow_succ]
  rw [h1, Real.sq_sqrt (by linarith)]

set_option maxHeartbeats 1000000 in
/-- The `k`-th radial derivative of the planar wave amplitude decays like `u^{-k-1/2}` for
dilations in `[1,2]`, at every order `k`. -/
theorem exists_ampR_decay_order (part : CoordinateWavePart) (k : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ C / (u ^ k * Real.sqrt u) := by
  cases part with
  | outgoing =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_outgoing_decay k
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have habs : |(2 * π * t) * u| = (2 * π * t) * u := by
        rw [abs_of_pos (by nlinarith [hpos, hu])]
      have hlarge : 1 ≤ |(2 * π * t) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hupos : (0 : ℝ) < u := by linarith
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |2 * π * t| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_of_pos hpos]
        exact hle6
      have hden : u ^ k * Real.sqrt u
          ≤ quadraticMomentScale (2 * k) |(2 * π * t) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : Real.sqrt u ≤ Real.sqrt ((2 * π * t) * u) := Real.sqrt_le_sqrt hgeu
        have hpow : (Real.sqrt u) ^ (2 * k + 1) ≤ (Real.sqrt ((2 * π * t) * u)) ^ (2 * k + 1) :=
          pow_le_pow_left₀ (Real.sqrt_nonneg u) hsq _
        rw [← sqrt_pow_id hu k]
        exact hpow
      have hqpos : (0 : ℝ) < quadraticMomentScale (2 * k) |(2 * π * t) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : (0 : ℝ) < Real.sqrt ((2 * π * t) * u) :=
          Real.sqrt_pos.mpr (by nlinarith [hpos, hupos])
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |2 * π * t| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |2 * π * t| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)
  | incoming =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_incoming_decay k
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have hupos : (0 : ℝ) < u := by linarith
      have habs : |(-(2 * π * t)) * u| = (2 * π * t) * u := by
        rw [neg_mul, abs_neg, abs_of_pos (by nlinarith [hpos, hupos])]
      have hlarge : 1 ≤ |(-(2 * π * t)) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |-(2 * π * t)| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_neg, abs_of_pos hpos]
        exact hle6
      have hden : u ^ k * Real.sqrt u
          ≤ quadraticMomentScale (2 * k) |(-(2 * π * t)) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : Real.sqrt u ≤ Real.sqrt ((2 * π * t) * u) := Real.sqrt_le_sqrt hgeu
        have hpow : (Real.sqrt u) ^ (2 * k + 1) ≤ (Real.sqrt ((2 * π * t) * u)) ^ (2 * k + 1) :=
          pow_le_pow_left₀ (Real.sqrt_nonneg u) hsq _
        rw [← sqrt_pow_id hu k]
        exact hpow
      have hqpos : (0 : ℝ) < quadraticMomentScale (2 * k) |(-(2 * π * t)) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : (0 : ℝ) < Real.sqrt ((2 * π * t) * u) :=
          Real.sqrt_pos.mpr (by nlinarith [hpos, hupos])
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |-(2 * π * t)| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |-(2 * π * t)| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)
  | middle =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_middle_decay k (k + 1)
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have hupos : (0 : ℝ) < u := by linarith
      have habs : |(2 * π * t) * u| = (2 * π * t) * u := by
        rw [abs_of_pos (by nlinarith [hpos, hupos])]
      have hlarge : 1 ≤ |(2 * π * t) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |2 * π * t| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_of_pos hpos]
        exact hle6
      have hsqrtle : Real.sqrt u ≤ u := by
        nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ u by linarith), Real.sqrt_nonneg u,
          Real.sqrt_le_sqrt hu, Real.sqrt_one]
      have hden : u ^ k * Real.sqrt u ≤ |(2 * π * t) * u| ^ (k + 1) := by
        rw [habs]
        have h1 : u ^ k * Real.sqrt u ≤ u ^ k * u :=
          mul_le_mul_of_nonneg_left hsqrtle (by positivity)
        have h2 : u ^ k * u = u ^ (k + 1) := by
          rw [pow_succ]
        have h3 : u ^ (k + 1) ≤ ((2 * π * t) * u) ^ (k + 1) := by
          refine pow_le_pow_left₀ (by linarith) hgeu _
        rw [h2] at h1
        linarith
      have hqpos : (0 : ℝ) < |(2 * π * t) * u| ^ (k + 1) := by
        rw [habs]
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |2 * π * t| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |2 * π * t| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)

/-- **The symbol bounds of the planar wave amplitude**, uniform for `k ≤ N`. -/
theorem exists_ampR_decay (part : CoordinateWavePart) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ k ≤ N, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ C / (u ^ k * Real.sqrt u) := by
  induction N with
  | zero =>
      obtain ⟨C, hC, h⟩ := exists_ampR_decay_order part 0
      refine ⟨C, hC, fun k hk => ?_⟩
      have hk0 : k = 0 := by omega
      subst hk0
      exact h
  | succ n ih =>
      obtain ⟨C, hC, h⟩ := ih
      obtain ⟨C', hC', h'⟩ := exists_ampR_decay_order part (n + 1)
      refine ⟨max C C', by positivity, fun k hk t u ht1 ht2 hu => ?_⟩
      have hupos : (0 : ℝ) < u := by linarith
      have hsq : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := mul_pos (pow_pos hupos k) hsq
      by_cases heq : k = n + 1
      · subst heq
        refine le_trans (h' t u ht1 ht2 hu) ?_
        gcongr
        exact le_max_right _ _
      · refine le_trans (h k (by omega) t u ht1 ht2 hu) ?_
        gcongr
        exact le_max_left _ _

/-! ### The fixed-scale symbol -/

theorem contDiff_ampR (part : CoordinateWavePart) (a : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ => planarCoordinateWaveRadialAmplitude part a u := by
  cases part with
  | outgoing =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ) * planarEndpointQuadraticIntegral ((2 * π * a) * u)
      exact contDiff_const.mul (contDiff_planarEndpointQuadraticIntegral.comp
        (contDiff_const.mul contDiff_id))
  | incoming =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ) * planarEndpointQuadraticIntegral ((-(2 * π * a)) * u)
      exact contDiff_const.mul (contDiff_planarEndpointQuadraticIntegral.comp
        (contDiff_const.mul contDiff_id))
  | middle =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ)
          * coordinateMiddleMeridianLocalizedIntegral 0 ((2 * π * a) * u)
      exact contDiff_const.mul
        ((contDiff_coordinateMiddleMeridianLocalizedIntegral 0).comp
          (contDiff_const.mul contDiff_id))

/-- The dilation cutoff: `1` on `[1,2]`, supported in `(1/2, 3)`. -/
def tcut (t : ℝ) : ℝ := Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)

theorem contDiff_tcut : ContDiff ℝ (↑(⊤ : ℕ∞)) tcut :=
  (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub contDiff_id))

theorem tcut_eq_one {t : ℝ} (h1 : 1 ≤ t) (h2 : t ≤ 2) : tcut t = 1 := by
  rw [tcut, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem tcut_nonneg (t : ℝ) : 0 ≤ tcut t :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem tcut_le_one (t : ℝ) : tcut t ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem tcut_mem {t : ℝ} (h : tcut t ≠ 0) : 1 / 2 < t ∧ t < 3 := by
  constructor
  · by_contra hcon
    refine h ?_
    rw [tcut, Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith), zero_mul]
  · by_contra hcon
    refine h ?_
    have hz : Real.smoothTransition (3 - t) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by
        have := not_lt.mp hcon
        linarith)
    rw [tcut, hz, mul_zero]

/-- The radial cutoff of the dyadic bandpass at the fixed scale: `φ(v) - φ(2v)`. -/
noncomputable def bpCut (φ : SchwartzMap Pl ℂ) (v : Pl) : ℂ :=
  (φ : Pl → ℂ) v - (φ : Pl → ℂ) ((2 : ℝ) • v)

theorem contDiff_bpCut (φ : SchwartzMap Pl ℂ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (bpCut φ) := by
  refine ContDiff.sub (φ.smooth (⊤ : ℕ∞)) ?_
  exact (φ.smooth (⊤ : ℕ∞)).comp (contDiff_const_smul _)

theorem bpCut_eq_zero_of_small {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1) {v : Pl} (h : ‖v‖ ≤ 1 / 2) :
    bpCut φ v = 0 := by
  have h1 : (φ : Pl → ℂ) v = 1 := hφone v (by linarith)
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • v) = 1 := by
    refine hφone _ ?_
    rw [norm_smul, Real.norm_eq_abs]
    have : |(2 : ℝ)| = 2 := by norm_num
    rw [this]
    linarith
  rw [bpCut, h1, h2, sub_self]

theorem bpCut_eq_zero_of_large {φ : SchwartzMap Pl ℂ}
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) {v : Pl} (h : 2 ≤ ‖v‖) :
    bpCut φ v = 0 := by
  have h1 : (φ : Pl → ℂ) v = 0 := hφzero v h
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • v) = 0 := by
    refine hφzero _ ?_
    rw [norm_smul, Real.norm_eq_abs]
    have h3 : |(2 : ℝ)| = 2 := by norm_num
    rw [h3]
    linarith
  rw [bpCut, h1, h2, sub_self]

/-- **The fixed-scale symbol** of the `ν = 0` sector piece of the `part`-wave at scale `J`. -/
noncomputable def gSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((tcut t : ℝ) : ℂ) * bpCut φ v * ((psiSec v : ℝ) : ℂ)
    * planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * nrm v)

theorem contDiff_gSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gSym φ part J t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl =>
      planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * nrm v) :=
    (contDiff_ampR part t).comp (contDiff_const.mul contDiff_nrm)
  have h2 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => ((psiSec v : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp contDiff_psiSec
  exact ((((contDiff_const.mul contDiff_const).mul (contDiff_bpCut φ)).mul h2).mul h1)

/-- The symbol at scale `J` is the rescaling of the fixed-scale symbol. -/
theorem gSym_support {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (t : ℝ) (ω : Pl)
    (h : gSym φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0) : ω ∈ Theta J := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hbp : bpCut φ v ≠ 0 := by
    intro hc
    rw [gSym, hc] at h
    simp at h
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [gSym, hc] at h
    simp at h
  obtain ⟨hs1, hs2, hs3, hs4⟩ := sector_of_psiSec_ne_zero hps
  have hlow : 1 / 2 < ‖v‖ := by
    by_contra hcon
    exact hbp (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
  have hhigh : ‖v‖ < 2 := by
    by_contra hcon
    exact hbp (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))
  -- transfer to `ω`
  have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
  have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
    rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
  have hω0 : v 0 = (2 : ℝ) ^ (-(J : ℤ)) * ω 0 := rfl
  have hω1 : v 1 = (2 : ℝ) ^ (-(J : ℤ)) * ω 1 := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hω0] at hs3
    nlinarith [hs3, hJpos]
  · rw [hω0, hω1] at hs4
    nlinarith [hs4, hJpos]
  · -- `2^{J-1} ≤ ‖ω‖`
    rw [hnormv] at hlow
    have hpow : (2 : ℝ) ^ ((J : ℤ) - 1) = (2 : ℝ) ^ (J : ℤ) / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hlow, hJpos, hid]
  · -- `‖ω‖ ≤ 2^{J+1}`
    rw [hnormv] at hhigh
    have hpow : (2 : ℝ) ^ ((J : ℤ) + 1) = (2 : ℝ) ^ (J : ℤ) * 2 := by
      rw [two_zpow_add]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hhigh, hJpos, hid]

/-! ### Uniform derivative bounds for the fixed-scale symbol -/

theorem exists_iteratedFDeriv_bound {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hsupp : HasCompactSupport f) (n : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ v : Pl, ‖iteratedFDeriv ℝ n f v‖ ≤ C := by
  have hcs : HasCompactSupport (iteratedFDeriv ℝ n f) := hsupp.iteratedFDeriv n
  have hcont : Continuous (iteratedFDeriv ℝ n f) :=
    hf.continuous_iteratedFDeriv (by exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤))
  obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hcs
  refine ⟨max C 1, by positivity, fun v => le_trans (hC v) (le_max_left _ _)⟩

/-- All derivatives up to a given order of a smooth compactly supported function admit a common
bound. -/
theorem exists_iteratedFDeriv_bound_upto {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hsupp : HasCompactSupport f) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i f v‖ ≤ C := by
  induction N with
  | zero =>
      obtain ⟨C, hC, h⟩ := exists_iteratedFDeriv_bound hf hsupp 0
      refine ⟨C, hC, fun i hi v => ?_⟩
      have hi0 : i = 0 := by omega
      subst hi0
      exact h v
  | succ n ih =>
      obtain ⟨C, hC, h⟩ := ih
      obtain ⟨C', hC', h'⟩ := exists_iteratedFDeriv_bound hf hsupp (n + 1)
      refine ⟨max C C', by positivity, fun i hi v => ?_⟩
      by_cases heq : i = n + 1
      · subst heq
        exact le_trans (h' v) (le_max_right _ _)
      · exact le_trans (h i (by omega) v) (le_max_left _ _)

theorem hasCompactSupport_psiSec : HasCompactSupport psiSec := by
  have hsub : Function.support psiSec ⊆ Metric.closedBall (0 : Pl) 3 := by
    intro v hv
    rw [Function.mem_support] at hv
    obtain ⟨h1, h2, -, -⟩ := sector_of_psiSec_ne_zero hv
    rw [Metric.mem_closedBall, dist_zero_right]
    nlinarith [norm_nonneg v]
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Pl) 3) hsub

/-- A uniform bound for the derivatives of the smooth truncated norm, in the shape needed by the
composition estimate. -/
theorem exists_nrm_deriv_bound (N : ℕ) : ∃ D : ℝ, 1 ≤ D ∧ ∀ i : ℕ, 1 ≤ i → i ≤ N →
    ∀ v : Pl, ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i := by
  obtain ⟨C, hC, h⟩ := exists_iteratedFDeriv_bound_upto contDiff_nrm hasCompactSupport_nrm N
  refine ⟨max C 1, le_max_right _ _, fun i hi1 hiN v => ?_⟩
  have hD1 : (1 : ℝ) ≤ max C 1 := le_max_right _ _
  have h1 : (max C 1) ^ (1 : ℕ) ≤ (max C 1) ^ i := pow_le_pow_right₀ hD1 hi1
  rw [pow_one] at h1
  exact le_trans (le_trans (h i hiN v) (le_max_left _ _)) h1

/-- The rescaled radial amplitude of the symbol, as a one-dimensional function. -/
noncomputable def gout (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * planarCoordinateWaveRadialAmplitude part t
    ((2 : ℝ) ^ J * u)

theorem contDiff_gout (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gout part J t) :=
  contDiff_const.mul ((contDiff_ampR part t).comp (contDiff_const.mul contDiff_id))

set_option maxHeartbeats 1000000 in
/-- **The rescaled amplitude has uniformly bounded derivatives** on the annulus: the factor
`2^{J/2}` exactly compensates the `(2^J)^{-1/2}` decay of the amplitude. -/
theorem norm_iteratedDeriv_gout_le {part : CoordinateWavePart} {Camp : ℝ} (hCamp : 0 < Camp)
    {N : ℕ}
    (hamp : ∀ k ≤ N, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ Camp / (u ^ k * Real.sqrt u))
    {J : ℕ} (hJ : 1 ≤ J) {i : ℕ} (hi : i ≤ N) {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3)
    (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 1) * Camp := by
  have hpowpos : (0 : ℝ) < (2 : ℝ) ^ J := by positivity
  have hpowge : (2 : ℝ) ≤ (2 : ℝ) ^ J := by
    calc (2 : ℝ) = (2 : ℝ) ^ (1 : ℕ) := by norm_num
      _ ≤ (2 : ℝ) ^ J := pow_le_pow_right₀ (by norm_num) hJ
  have hupos : (0 : ℝ) < u := by linarith
  have hprod : (1 : ℝ) ≤ (2 : ℝ) ^ J * u := by nlinarith
  have hsqrtpow : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ J) := Real.sqrt_pos.mpr hpowpos
  -- the iterated derivative of the rescaled amplitude
  have hchain : iteratedDeriv i (gout part J t) u
      = ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((((2 : ℝ) ^ J : ℝ) : ℂ) ^ i
        * iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
            ((2 : ℝ) ^ J * u)) := by
    have hsm : iteratedDeriv i
        (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t ((((2 : ℝ) ^ J : ℝ)) * u'))
        = fun u' : ℝ => (((2 : ℝ) ^ J : ℝ) : ℝ) ^ i •
            iteratedDeriv i (fun w : ℝ => planarCoordinateWaveRadialAmplitude part t w)
              ((((2 : ℝ) ^ J : ℝ)) * u') :=
      iteratedDeriv_comp_const_smul
        ((contDiff_ampR part t).of_le (by exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤))) _
    have hcm : iteratedDeriv i (gout part J t) u
        = ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ)
          * iteratedDeriv i (fun u' : ℝ =>
              planarCoordinateWaveRadialAmplitude part t ((((2 : ℝ) ^ J : ℝ)) * u')) u := by
      refine iteratedDeriv_const_mul _ ?_
      exact (((contDiff_ampR part t).comp (contDiff_const.mul contDiff_id)).of_le
        (by exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤))).contDiffAt
    rw [hcm, hsm]
    simp only [Complex.real_smul]
    push_cast
    ring
  rw [hchain, norm_mul, norm_mul]
  have hnorm1 : ‖((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ)‖ = Real.sqrt ((2 : ℝ) ^ J) := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrtpow]
  have hnorm2 : ‖((((2 : ℝ) ^ J : ℝ)) : ℂ) ^ i‖ = ((2 : ℝ) ^ J) ^ i := by
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpowpos]
  rw [hnorm1, hnorm2]
  -- the amplitude bound at the rescaled radius
  have hbd := hamp i hi t ((2 : ℝ) ^ J * u) ht1 ht2 hprod
  have hsqrtprod : Real.sqrt ((2 : ℝ) ^ J * u)
      = Real.sqrt ((2 : ℝ) ^ J) * Real.sqrt u := Real.sqrt_mul hpowpos.le u
  have hden : ((2 : ℝ) ^ J * u) ^ i * Real.sqrt ((2 : ℝ) ^ J * u)
      = (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J)) * (u ^ i * Real.sqrt u) := by
    rw [hsqrtprod, mul_pow]
    ring
  rw [hden] at hbd
  have hkey : Real.sqrt ((2 : ℝ) ^ J) * (((2 : ℝ) ^ J) ^ i
      * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
          ((2 : ℝ) ^ J * u)‖)
      ≤ Camp / (u ^ i * Real.sqrt u) := by
    have hfac : (0 : ℝ) < ((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J) := by positivity
    have hstep : ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
          ((2 : ℝ) ^ J * u)‖
        ≤ Camp / ((((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J)) * (u ^ i * Real.sqrt u)) := hbd
    have hupow : (0 : ℝ) < u ^ i * Real.sqrt u := by
      have : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      positivity
    rw [div_mul_eq_div_div_swap] at hstep
    calc Real.sqrt ((2 : ℝ) ^ J) * (((2 : ℝ) ^ J) ^ i
          * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
              ((2 : ℝ) ^ J * u)‖)
        = (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J))
            * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
                ((2 : ℝ) ^ J * u)‖ := by ring
      _ ≤ (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J))
            * (Camp / (u ^ i * Real.sqrt u) / (((2 : ℝ) ^ J) ^ i
              * Real.sqrt ((2 : ℝ) ^ J))) := by
          exact mul_le_mul_of_nonneg_left hstep hfac.le
      _ = Camp / (u ^ i * Real.sqrt u) := by
          field_simp
  refine le_trans hkey ?_
  -- finally `u ≥ 1/2` gives the numerical constant
  have hsqrtu : (1 : ℝ) / 2 ≤ Real.sqrt u := by
    have h1 : Real.sqrt (1 / 2 : ℝ) ≤ Real.sqrt u := Real.sqrt_le_sqrt hu1
    have h2 : (1 : ℝ) / 2 ≤ Real.sqrt (1 / 2 : ℝ) := by
      have h3 : Real.sqrt (1 / 2 : ℝ) ^ 2 = 1 / 2 := Real.sq_sqrt (by norm_num)
      nlinarith [Real.sqrt_nonneg (1 / 2 : ℝ), h3]
    linarith
  have hui : ((1 : ℝ) / 2) ^ N ≤ u ^ i := by
    have hpow : (1 / 2 : ℝ) ^ i ≤ u ^ i := pow_le_pow_left₀ (by norm_num) hu1 i
    have hmono : ((1 : ℝ) / 2) ^ N ≤ ((1 : ℝ) / 2) ^ i :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) hi
    linarith
  have hdenpos : (0 : ℝ) < u ^ i * Real.sqrt u :=
    mul_pos (pow_pos hupos i) (Real.sqrt_pos.mpr hupos)
  rw [div_le_iff₀ hdenpos]
  have hmul : ((1 : ℝ) / 2) ^ N * (1 / 2) ≤ u ^ i * Real.sqrt u :=
    mul_le_mul hui hsqrtu (by norm_num) (pow_nonneg hupos.le i)
  have hinv : ((1 : ℝ) / 2) ^ N * (1 / 2) = ((2 : ℝ) ^ (N + 1))⁻¹ := by
    rw [← pow_succ, div_pow, one_pow, one_div]
  calc Camp = (2 : ℝ) ^ (N + 1) * Camp * ((2 : ℝ) ^ (N + 1))⁻¹ := by
        field_simp
    _ ≤ (2 : ℝ) ^ (N + 1) * Camp * (u ^ i * Real.sqrt u) := by
        refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (by positivity) hCamp.le)
        rw [← hinv]
        exact hmul

/-- The cutoff factor of the fixed-scale symbol. -/
noncomputable def cutF (φ : SchwartzMap Pl ℂ) (v : Pl) : ℂ :=
  bpCut φ v * ((psiSec v : ℝ) : ℂ)

theorem contDiff_cutF (φ : SchwartzMap Pl ℂ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutF φ) :=
  (contDiff_bpCut φ).mul (Complex.ofRealCLM.contDiff.comp contDiff_psiSec)

theorem hasCompactSupport_cutF (φ : SchwartzMap Pl ℂ) : HasCompactSupport (cutF φ) := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Pl) 3) ?_
  intro v hv
  rw [Function.mem_support] at hv
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [cutF, hc] at hv
    simp at hv
  obtain ⟨h1, h2, -, -⟩ := sector_of_psiSec_ne_zero hps
  rw [Metric.mem_closedBall, dist_zero_right]
  nlinarith [norm_nonneg v]

theorem exists_cutF_bound (φ : SchwartzMap Pl ℂ) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ C :=
  exists_iteratedFDeriv_bound_upto (contDiff_cutF φ) (hasCompactSupport_cutF φ) N

theorem gSym_eq_prod (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    gSym φ part J t = fun v : Pl => ((tcut t : ℝ) : ℂ) * (cutF φ v * gout part J t (nrm v)) := by
  funext v
  rw [gSym, cutF, gout]
  ring

set_option maxHeartbeats 4000000 in
/-- **The product bound for the cutoff times a radial profile.**  If the one-dimensional profile
`G` has derivatives up to order `N` bounded by `Cg` on the annulus `1/2 ≤ u ≤ 2`, then the planar
function `w ↦ cutF φ w · G(nrm w)` has Fréchet derivatives up to order `N` bounded uniformly. -/
theorem norm_iteratedFDeriv_cut_mul_comp_le {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    {N : ℕ} {G : ℝ → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {Cg : ℝ} (hCgpos : 0 < Cg)
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i G u‖ ≤ Cg)
    {D : ℝ} (hD1 : 1 ≤ D)
    (hDbd : ∀ i : ℕ, 1 ≤ i → i ≤ N → ∀ v : Pl, ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i)
    {Cc : ℝ} (hCc : 0 < Cc)
    (hcut : ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ Cc)
    {n : ℕ} (hn : n ≤ N) (v : Pl) :
    ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * G (nrm w)) v‖
      ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ) * Cg * D ^ N) := by
  classical
  set Cbig : ℝ := (Nat.factorial N : ℝ) * Cg * D ^ N with hCbig
  have hDpos : (0 : ℝ) < D ^ N := by positivity
  have hCbigpos : 0 < Cbig := by
    rw [hCbig]
    positivity
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  have hcompsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => G (nrm w) :=
    hG.comp contDiff_nrm
  by_cases hv : 1 / 2 ≤ ‖v‖ ∧ ‖v‖ ≤ 2
  · -- the main case: the composition estimate applies
    have hnrmv : nrm v = ‖v‖ := nrm_eq (by linarith [hv.1]) (by linarith [hv.2])
    have hcomp : ∀ m ≤ N, ‖iteratedFDeriv ℝ m (fun w : Pl => G (nrm w)) v‖
        ≤ Cbig := by
      intro m hm
      have hC : ∀ i, i ≤ m → ‖iteratedFDeriv ℝ i G (nrm v)‖ ≤ Cg := by
        intro i hi
        rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hnrmv]
        exact hGbd i (by omega) ‖v‖ hv.1 hv.2
      have hD' : ∀ i, 1 ≤ i → i ≤ m → ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i := by
        intro i hi1 hi2
        exact hDbd i hi1 (by omega) v
      have hmle : ((m : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
        exact_mod_cast (le_top : ((m : ℕ∞)) ≤ ⊤)
      have h := norm_iteratedFDeriv_comp_le hG contDiff_nrm hmle v hC hD'
      refine le_trans h ?_
      rw [hCbig]
      have hfac : ((Nat.factorial m : ℕ) : ℝ) ≤ ((Nat.factorial N : ℕ) : ℝ) := by
        exact_mod_cast Nat.factorial_le hm
      have hDm : D ^ m ≤ D ^ N := pow_le_pow_right₀ hD1 hm
      calc ((Nat.factorial m : ℕ) : ℝ) * Cg * D ^ m
          ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg * D ^ m := by
            have h1 : ((Nat.factorial m : ℕ) : ℝ) * Cg ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg :=
              mul_le_mul_of_nonneg_right hfac hCgpos.le
            exact mul_le_mul_of_nonneg_right h1 (by positivity)
        _ ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg * D ^ N := by
            refine mul_le_mul_of_nonneg_left hDm ?_
            positivity
    have hprodbd := norm_iteratedFDeriv_mul_le (contDiff_cutF φ) hcompsmooth v hnle
    refine le_trans hprodbd ?_
    have hterm : ∀ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (cutF φ) v‖
            * ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖
          ≤ (n.choose i : ℝ) * (Cc * Cbig) := by
      intro i hi
      rw [Finset.mem_range] at hi
      have h1 : ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ Cc := hcut i (by omega) v
      have h2 : ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖ ≤ Cbig :=
        hcomp (n - i) (by omega)
      have h3 : (0 : ℝ) ≤ (n.choose i : ℝ) := by positivity
      calc (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (cutF φ) v‖
              * ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖
          ≤ (n.choose i : ℝ) * Cc * Cbig := by
            refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
            positivity
        _ = (n.choose i : ℝ) * (Cc * Cbig) := by ring
    refine le_trans (Finset.sum_le_sum hterm) ?_
    rw [← Finset.sum_mul]
    have hchoose : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = (2 : ℝ) ^ n := by
      have h := Nat.sum_range_choose n
      have hcast : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ))
          = ((∑ i ∈ Finset.range (n + 1), n.choose i : ℕ) : ℝ) := by
        push_cast
        ring
      rw [hcast, h]
      push_cast
      ring
    rw [hchoose]
    have hpow : (2 : ℝ) ^ n ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hn
    have hprodpos : (0 : ℝ) < Cc * Cbig := by positivity
    calc (2 : ℝ) ^ n * (Cc * Cbig) ≤ (2 : ℝ) ^ N * (Cc * Cbig) :=
          mul_le_mul_of_nonneg_right hpow hprodpos.le
      _ = (2 : ℝ) ^ N * Cc * Cbig := by ring
  · -- off the annulus the cutoff vanishes on a neighbourhood
    have hzero : ∀ᶠ w in nhds v, (fun w : Pl => cutF φ w * G (nrm w)) w
        = (fun _ : Pl => (0 : ℂ)) w := by
      rcases not_and_or.mp hv with hlow | hhigh
      · have hlt : ‖v‖ < 1 / 2 := not_le.mp hlow
        have hball : Metric.ball v (1 / 2 - ‖v‖) ∈ nhds v :=
          Metric.ball_mem_nhds v (by linarith)
        filter_upwards [hball] with w hw
        have hwle : ‖w‖ ≤ 1 / 2 := by
          rw [Metric.mem_ball, dist_eq_norm] at hw
          have h1 : ‖w‖ - ‖v‖ ≤ ‖w - v‖ := norm_sub_norm_le w v
          linarith
        have hbp : bpCut φ w = 0 := bpCut_eq_zero_of_small hφone hwle
        show cutF φ w * G (nrm w) = 0
        rw [cutF, hbp, zero_mul, zero_mul]
      · have hgt : 2 < ‖v‖ := not_le.mp hhigh
        have hball : Metric.ball v (‖v‖ - 2) ∈ nhds v :=
          Metric.ball_mem_nhds v (by linarith)
        filter_upwards [hball] with w hw
        have hwge : 2 ≤ ‖w‖ := by
          rw [Metric.mem_ball, dist_eq_norm] at hw
          have h1 : ‖v‖ - ‖w‖ ≤ ‖v - w‖ := norm_sub_norm_le v w
          have h2 : ‖v - w‖ = ‖w - v‖ := norm_sub_rev v w
          rw [h2] at h1
          linarith
        have hbp : bpCut φ w = 0 := bpCut_eq_zero_of_large hφzero hwge
        show cutF φ w * G (nrm w) = 0
        rw [cutF, hbp, zero_mul, zero_mul]
    have hiter : iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * G (nrm w)) v
        = iteratedFDeriv ℝ n (fun _ : Pl => (0 : ℂ)) v := by
      have hzero' : (fun w : Pl => cutF φ w * G (nrm w))
          =ᶠ[nhdsWithin v Set.univ] (fun _ : Pl => (0 : ℂ)) := by
        rw [nhdsWithin_univ]
        exact hzero
      have hx : (fun w : Pl => cutF φ w * G (nrm w)) v
          = (fun _ : Pl => (0 : ℂ)) v := hzero.self_of_nhds
      have h := hzero'.iteratedFDerivWithin_eq (𝕜 := ℝ) hx n
      rw [iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at h
      exact h
    rw [hiter]
    have hz : iteratedFDeriv ℝ n (fun _ : Pl => (0 : ℂ)) v = 0 := by
      simp
    rw [hz, norm_zero]
    positivity

set_option maxHeartbeats 1000000 in
/-- **The fixed-scale symbol has derivative bounds uniform in the scale and the dilation.** -/
theorem exists_gSym_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (gSym φ part J t) v‖ ≤ B := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part N
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  have hDpos : (0 : ℝ) < D ^ N := by positivity
  refine ⟨(2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 1) * Camp) * D ^ N),
    by positivity, ?_⟩
  intro J hJ n hn t v
  have hcompsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => gout part J t (nrm w) :=
    (contDiff_gout part J t).comp contDiff_nrm
  have hprodsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => cutF φ w * gout part J t (nrm w) :=
    (contDiff_cutF φ).mul hcompsmooth
  have hsplit : ‖iteratedFDeriv ℝ n (gSym φ part J t) v‖
      = |tcut t| * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ := by
    rw [gSym_eq_prod]
    have hsm : (fun w : Pl => ((tcut t : ℝ) : ℂ) * (cutF φ w * gout part J t (nrm w)))
        = (tcut t) • (fun w : Pl => cutF φ w * gout part J t (nrm w)) := by
      funext w
      rw [Pi.smul_apply, Complex.real_smul]
    have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
      exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
    rw [hsm, iteratedFDeriv_const_smul_apply (hprodsmooth.of_le hnle).contDiffAt, norm_smul,
      Real.norm_eq_abs]
  rw [hsplit]
  by_cases ht : 1 / 2 < t ∧ t < 3
  · have hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 1) * Camp := fun i hi u hu1 hu2 =>
      norm_iteratedDeriv_gout_le hCamp hamp hJ hi ht.1.le ht.2.le hu1 hu2
    have hbd := norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_gout part J t)
      (mul_pos (by positivity) hCamp) hGbd hD1 hDbd hCc hcut hn v
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    calc |tcut t| * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖
        ≤ 1 * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ :=
          mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
      _ = ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ := one_mul _
      _ ≤ (2 : ℝ) ^ N * Cc
            * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 1) * Camp) * D ^ N) := hbd
  · have hz : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz, abs_zero, zero_mul]
    positivity

/-! ### Radial and angular derivatives of a planar symbol -/

theorem pt_smul (c r φ : ℝ) : c • pt r φ = pt (c * r) φ := by
  rw [pt_eq_smul r φ, pt_eq_smul (c * r) φ, smul_smul]

/-- Along a unit-speed line through the origin the iterated derivatives of a smooth function are
bounded by its iterated Fréchet derivatives. -/
theorem norm_iteratedDeriv_line_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {e : Pl}
    (he : ‖e‖ = 1) (k : ℕ) (ρ : ℝ) :
    ‖iteratedDeriv k (fun s : ℝ => G (s • e)) ρ‖ ≤ ‖iteratedFDeriv ℝ k G (ρ • e)‖ := by
  set L : ℝ →L[ℝ] Pl := (ContinuousLinearMap.id ℝ ℝ).smulRight e with hL
  have hLapp : ∀ s : ℝ, L s = s • e := fun s => rfl
  have hLnorm : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun s => ?_
    rw [hLapp, norm_smul, he, mul_one, one_mul]
  have hfun : (fun s : ℝ => G (s • e)) = G ∘ L := by
    funext s
    rw [Function.comp_apply, hLapp]
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hfun,
    L.iteratedFDeriv_comp_right hG ρ (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin k, ‖L‖) = ‖L‖ ^ k := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod, hLapp ρ]
  exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hLnorm)

/-- The angular derivative of the polar parametrization is the parametrization rotated by a
quarter turn. -/
theorem hasDerivAt_pt_angle (ρ φ : ℝ) :
    HasDerivAt (fun φ' : ℝ => pt ρ φ') (pt ρ (φ + π / 2)) φ := by
  have h1 : HasDerivAt (fun φ' : ℝ => ρ * Real.cos φ') (ρ * (-Real.sin φ)) φ :=
    (Real.hasDerivAt_cos φ).const_mul ρ
  have h2 : HasDerivAt (fun φ' : ℝ => ρ * Real.sin φ') (ρ * Real.cos φ) φ :=
    (Real.hasDerivAt_sin φ).const_mul ρ
  have h := (h1.smul_const (EuclideanSpace.single (0 : Fin 2) (1 : ℝ))).add
    (h2.smul_const (EuclideanSpace.single (1 : Fin 2) (1 : ℝ)))
  have hgoal : (fun φ' : ℝ => pt ρ φ')
      = fun φ' : ℝ => (ρ * Real.cos φ') • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
          + (ρ * Real.sin φ') • EuclideanSpace.single (1 : Fin 2) (1 : ℝ) := by
    funext φ'
    rw [pt, mk2]
  have hval : pt ρ (φ + π / 2)
      = (ρ * (-Real.sin φ)) • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
        + (ρ * Real.cos φ) • EuclideanSpace.single (1 : Fin 2) (1 : ℝ) := by
    rw [pt, mk2, Real.cos_add_pi_div_two, Real.sin_add_pi_div_two]
  rw [hgoal, hval]
  exact h

theorem iteratedDeriv_pt_angle (ρ : ℝ) (i : ℕ) :
    iteratedDeriv i (fun φ' : ℝ => pt ρ φ') = fun φ : ℝ => pt ρ (φ + (i : ℝ) * (π / 2)) := by
  induction i with
  | zero =>
      funext φ
      rw [iteratedDeriv_zero]
      norm_num
  | succ n ih =>
      funext φ
      rw [iteratedDeriv_succ, ih]
      have h : HasDerivAt (fun φ' : ℝ => pt ρ (φ' + (n : ℝ) * (π / 2)))
          (pt ρ (φ + (n : ℝ) * (π / 2) + π / 2)) φ :=
        HasDerivAt.comp_add_const φ ((n : ℝ) * (π / 2))
          (hasDerivAt_pt_angle ρ (φ + (n : ℝ) * (π / 2)))
      rw [h.deriv]
      congr 1
      push_cast
      ring

/-- **The radial derivatives of a symbol with bounded Fréchet derivatives are bounded.** -/
theorem norm_iteratedDeriv_radial_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {B : ℝ}
    (hbd : ∀ i ≤ 4, ∀ v : Pl, ‖iteratedFDeriv ℝ i G v‖ ≤ B) {k : ℕ} (hk : k ≤ 4) (ρ φ : ℝ) :
    ‖iteratedDeriv k (fun r' : ℝ => G (pt r' φ)) ρ‖ ≤ B := by
  have he : ‖pt 1 φ‖ = 1 := norm_pt 1 φ zero_le_one
  have hfun : (fun r' : ℝ => G (pt r' φ)) = fun s : ℝ => G (s • pt 1 φ) := by
    funext r'
    rw [pt_eq_smul r' φ]
  rw [hfun]
  exact le_trans (norm_iteratedDeriv_line_le hG he k ρ) (hbd k hk _)

set_option maxHeartbeats 1000000 in
/-- **The angular derivatives of a compactly supported symbol with bounded Fréchet derivatives
are bounded**, uniformly in the radius: on the support the radius is at most `2`, so the chain
rule loses only a bounded factor. -/
theorem norm_iteratedDeriv_angle_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {B : ℝ}
    (hbd : ∀ i ≤ 4, ∀ v : Pl, ‖iteratedFDeriv ℝ i G v‖ ≤ B)
    (hzero : ∀ v : Pl, 2 ≤ ‖v‖ → G v = 0)
    {k : ℕ} (hk : k ≤ 4) (ρ φ : ℝ) :
    ‖iteratedDeriv k (fun φ' : ℝ => G (pt ρ φ')) φ‖ ≤ 384 * B := by
  have hB : (0 : ℝ) ≤ B := le_trans (norm_nonneg _) (hbd 0 (by norm_num) 0)
  by_cases hρ : |ρ| ≤ 2
  · -- the main case: the chain rule bound
    have hkle : ((k : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
      exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤)
    have hC : ∀ i, i ≤ k → ‖iteratedFDeriv ℝ i G (pt ρ φ)‖ ≤ B := fun i hi =>
      hbd i (by omega) _
    have hD : ∀ i, 1 ≤ i → i ≤ k →
        ‖iteratedFDeriv ℝ i (fun φ' : ℝ => pt ρ φ') φ‖ ≤ (2 : ℝ) ^ i := by
      intro i hi1 hi2
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_pt_angle, norm_pt_abs]
      have h1 : (2 : ℝ) ^ (1 : ℕ) ≤ (2 : ℝ) ^ i := pow_le_pow_right₀ (by norm_num) hi1
      rw [pow_one] at h1
      linarith
    have h := norm_iteratedFDeriv_comp_le hG (contDiff_pt_angular ρ) hkle φ hC hD
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv] at h
    refine le_trans h ?_
    have hfac : ((Nat.factorial k : ℕ) : ℝ) ≤ 24 := by
      interval_cases k <;> norm_num [Nat.factorial]
    have hpow : (2 : ℝ) ^ k ≤ 16 := by
      interval_cases k <;> norm_num
    calc ((Nat.factorial k : ℕ) : ℝ) * B * (2 : ℝ) ^ k ≤ 24 * B * 16 := by
          have h1 : ((Nat.factorial k : ℕ) : ℝ) * B ≤ 24 * B :=
            mul_le_mul_of_nonneg_right hfac hB
          exact mul_le_mul h1 hpow (by positivity) (by positivity)
      _ = 384 * B := by ring
  · -- off the support the function vanishes identically
    have hfz : (fun φ' : ℝ => G (pt ρ φ')) = fun _ : ℝ => (0 : ℂ) := by
      funext φ'
      refine hzero _ ?_
      rw [norm_pt_abs]
      linarith [not_le.mp hρ]
    rw [hfz]
    have hzz : iteratedDeriv k (fun _ : ℝ => (0 : ℂ)) φ = 0 := by
      simp
    rw [hzz, norm_zero]
    positivity

/-! ### The polar data of a rescaled symbol -/

set_option maxHeartbeats 1000000 in
/-- **The polar data of a rescaled fixed-scale symbol.**  If `g` is smooth, supported in the ball
of radius `2`, with Fréchet derivatives of order at most four bounded by `B`, and if `ω ↦ g(2^{-j}ω)`
is supported in the sector `Θ_j`, then the rescaled symbol satisfies `PolarData`: the rescaling
supplies exactly one factor `2^{-j}` per radial derivative, and the angular derivatives are bounded
because the support forces the radius to be at most `2`. -/
theorem polarData_of_rescaled {g : ℝ → Pl → ℂ} {B : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (g t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), g t ((2 : ℝ) ^ (-(j : ℤ)) • ω) ≠ 0 → ω ∈ Theta j)
    (hzero : ∀ (t : ℝ) (v : Pl), 2 ≤ ‖v‖ → g t v = 0)
    (hbd : ∀ n ≤ 4, ∀ (t : ℝ) (v : Pl), ‖iteratedFDeriv ℝ n (g t) v‖ ≤ B) :
    PolarData j (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (mrcan fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (macan fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω)) (384 * B) := by
  have hB : (0 : ℝ) ≤ B := le_trans (norm_nonneg _) (hbd 0 (by norm_num) 0 0)
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  refine polarData_of_bounds ?_ hsupp ?_ ?_
  · intro t
    exact (hsmooth t).comp (contDiff_const_smul _)
  · -- the radial bounds, with one factor `2^{-j}` per derivative
    intro k hk t φ r
    have hFsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun ρ : ℝ => g t (pt ρ φ) :=
      (hsmooth t).comp (contDiff_pt_radial φ)
    have hrw : (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ))
        = fun r' : ℝ => (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r') := by
      funext r'
      rw [pt_smul]
    have hkey : iteratedDeriv k (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ)) r
        = ((2 : ℝ) ^ (-(j : ℤ))) ^ k • iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ))
            ((2 : ℝ) ^ (-(j : ℤ)) * r) := by
      rw [hrw, iteratedDeriv_comp_const_smul
        (hFsmooth.of_le (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤)))]
    show ‖iteratedDeriv k (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ)) r‖
      ≤ 384 * B * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
    rw [hkey, norm_smul, norm_pow, Real.norm_eq_abs, abs_of_pos hcpos]
    have hpowk : ((2 : ℝ) ^ (-(j : ℤ))) ^ k = (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by
      rw [← zpow_natCast ((2 : ℝ) ^ (-(j : ℤ))) k, ← zpow_mul]
      congr 1
      ring
    rw [hpowk]
    have hbdk : ‖iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r)‖ ≤ B :=
      norm_iteratedDeriv_radial_le (hsmooth t) (fun i hi v => hbd i hi t v) hk _ φ
    have hzpos : (0 : ℝ) < (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by positivity
    calc (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
            * ‖iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r)‖
        ≤ (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) * B :=
          mul_le_mul_of_nonneg_left hbdk hzpos.le
      _ ≤ 384 * B * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by
          nlinarith [mul_nonneg hB hzpos.le]
  · -- the angular bounds
    intro k hk t r φ
    have hrw : (fun φ' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r φ'))
        = fun φ' : ℝ => g t (pt ((2 : ℝ) ^ (-(j : ℤ)) * r) φ') := by
      funext φ'
      rw [pt_smul]
    show ‖iteratedDeriv k (fun φ' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r φ')) φ‖ ≤ 384 * B
    rw [hrw]
    exact norm_iteratedDeriv_angle_le (hsmooth t) (fun i hi v => hbd i hi t v)
      (fun v hv => hzero t v hv) (by omega) _ φ

/-! ### The multiplier data of the sector symbol -/

theorem gSym_eq_zero_of_large {φ : SchwartzMap Pl ℂ}
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (t : ℝ) {v : Pl} (h : 2 ≤ ‖v‖) :
    gSym φ part J t v = 0 := by
  rw [gSym, bpCut_eq_zero_of_large hφzero h]
  ring

/-- **The sector multiplier at scale `J`**: the rescaling of the fixed-scale symbol. -/
noncomputable def msc (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (ω : Pl) : ℂ :=
  gSym φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω)

/-- **The sector multiplier satisfies both hypothesis packages**, with constants independent of the
scale `J` and of the dilation `t`. -/
theorem exists_msc_data (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J →
      MultData J (msc φ part J) (m2can (msc φ part J)) B
        ∧ PolarData J (msc φ part J) (mrcan (msc φ part J)) (macan (msc φ part J)) (384 * B) := by
  obtain ⟨B, hBpos, hB⟩ := exists_gSym_bound φ hφone hφzero part 4
  refine ⟨B, hBpos, fun J hJ => ⟨?_, ?_⟩⟩
  · exact multData_of_rescaled (fun t => contDiff_gSym φ part J t)
      (fun t ω h => gSym_support hφone hφzero part J t ω h)
      (fun n hn t v => hB J hJ n (by omega) t v)
  · exact polarData_of_rescaled (fun t => contDiff_gSym φ part J t)
      (fun t ω h => gSym_support hφone hφzero part J t ω h)
      (fun t v hv => gSym_eq_zero_of_large hφzero part J t hv)
      (fun n hn t v => hB J hJ n hn t v)

/-! ### The dilation derivative of the amplitude -/

/-- The planar wave amplitude is a function of the *product* of its two arguments, hence
symmetric in them.  This turns the derivative in the dilation parameter into the radial
derivative, for which the repository provides the full symbol calculus. -/
theorem ampR_symm (part : CoordinateWavePart) (a ρ : ℝ) :
    planarCoordinateWaveRadialAmplitude part a ρ
      = planarCoordinateWaveRadialAmplitude part ρ a := by
  have h1 : (2 * π * a) * ρ = (2 * π * ρ) * a := by ring
  have h2 : (-(2 * π * a)) * ρ = (-(2 * π * ρ)) * a := by ring
  cases part with
  | outgoing =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h1]
  | incoming =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h2]
  | middle =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h1]

/-- The chain rule for a profile composed with a linear map. -/
theorem hasDerivAt_comp_linear {P : ℝ → ℂ} (hP : ContDiff ℝ (↑(⊤ : ℕ∞)) P) (c ρ : ℝ) :
    HasDerivAt (fun r : ℝ => P (c * r)) (((c : ℝ) : ℂ) * deriv P (c * ρ)) ρ := by
  have hlin : HasDerivAt (fun r : ℝ => c * r) c ρ := by
    simpa using (hasDerivAt_id ρ).const_mul c
  have hP' : HasDerivAt P (deriv P (c * ρ)) (c * ρ) :=
    (hP.differentiable (by simp)).differentiableAt.hasDerivAt
  refine (hP'.scomp ρ hlin).congr_deriv ?_
  rw [Complex.real_smul]

/-- The radial derivative of the planar wave amplitude. -/
noncomputable def ampRD (part : CoordinateWavePart) (a ρ : ℝ) : ℂ :=
  (surfaceMass 1 : ℂ) *
    match part with
    | .outgoing => ((2 * π * a : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((2 * π * a) * ρ)
    | .incoming => ((-(2 * π * a) : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((-(2 * π * a)) * ρ)
    | .middle => ((2 * π * a : ℝ) : ℂ) *
        deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * a) * ρ)

theorem hasDerivAt_ampR (part : CoordinateWavePart) (a ρ : ℝ) :
    HasDerivAt (fun ρ' : ℝ => planarCoordinateWaveRadialAmplitude part a ρ')
      (ampRD part a ρ) ρ := by
  cases part with
  | outgoing =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (2 * π * a) ρ).const_mul (surfaceMass 1 : ℂ)
  | incoming =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (-(2 * π * a)) ρ).const_mul (surfaceMass 1 : ℂ)
  | middle =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear
        (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)
        (2 * π * a) ρ).const_mul (surfaceMass 1 : ℂ)

/-- The derivative of the amplitude in the dilation parameter. -/
theorem hasDerivAt_ampR_param (part : CoordinateWavePart) (u t : ℝ) :
    HasDerivAt (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      (ampRD part u t) t := by
  have hfun : (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      = fun s : ℝ => planarCoordinateWaveRadialAmplitude part u s := by
    funext s
    exact ampR_symm part s u
  rw [hfun]
  exact hasDerivAt_ampR part u t

/-- The two first derivatives of the amplitude are related by the exchange of its arguments:
`s ∂₂A(r,s) = r ∂₂A(s,r)`. -/
theorem ampRD_swap (part : CoordinateWavePart) (s r : ℝ) :
    ((s : ℝ) : ℂ) * ampRD part r s = ((r : ℝ) : ℂ) * ampRD part s r := by
  have h1 : (2 * π * r) * s = (2 * π * s) * r := by ring
  have h2 : (-(2 * π * r)) * s = (-(2 * π * s)) * r := by ring
  cases part with
  | outgoing =>
      unfold ampRD
      dsimp only
      rw [h1]
      push_cast
      ring
  | incoming =>
      unfold ampRD
      dsimp only
      rw [h2]
      push_cast
      ring
  | middle =>
      unfold ampRD
      dsimp only
      rw [h1]
      push_cast
      ring

/-- The radial derivative of the rescaled amplitude. -/
theorem hasDerivAt_gout_radius (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) :
    HasDerivAt (gout part J t)
      (((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((((2 : ℝ) ^ J : ℝ) : ℂ)
        * ampRD part t ((2 : ℝ) ^ J * u))) u := by
  have h1 : HasDerivAt
      (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * u'))
      ((((2 : ℝ) ^ J : ℝ) : ℂ) * ampRD part t ((2 : ℝ) ^ J * u)) u := by
    have hlin : HasDerivAt (fun u' : ℝ => (2 : ℝ) ^ J * u') ((2 : ℝ) ^ J) u := by
      simpa using (hasDerivAt_id u).const_mul ((2 : ℝ) ^ J)
    refine ((hasDerivAt_ampR part t ((2 : ℝ) ^ J * u)).scomp u hlin).congr_deriv ?_
    rw [Complex.real_smul]
  exact h1.const_mul _

theorem contDiff_deriv_endpoint :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv planarEndpointQuadraticIntegral) :=
  (contDiff_infty_iff_deriv.mp contDiff_planarEndpointQuadraticIntegral).2

theorem contDiff_deriv_middle : ContDiff ℝ (↑(⊤ : ℕ∞))
    (deriv (coordinateMiddleMeridianLocalizedIntegral 0)) :=
  (contDiff_infty_iff_deriv.mp (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)).2

theorem contDiff_ampRD_left (part : CoordinateWavePart) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => ampRD part w t := by
  cases part with
  | outgoing =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ) * deriv planarEndpointQuadraticIntegral ((2 * π * w) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul ?_
      exact contDiff_deriv_endpoint.comp ((contDiff_const.mul contDiff_id).mul contDiff_const)
  | incoming =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((-(2 * π * w) : ℝ) : ℂ)
          * deriv planarEndpointQuadraticIntegral ((-(2 * π * w)) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp
        (contDiff_const.mul contDiff_id).neg).mul ?_
      exact contDiff_deriv_endpoint.comp
        ((contDiff_const.mul contDiff_id).neg.mul contDiff_const)
  | middle =>
      show ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ)
          * deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * w) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul ?_
      exact contDiff_deriv_middle.comp ((contDiff_const.mul contDiff_id).mul contDiff_const)

/-- **The dilation derivative of the rescaled amplitude.** -/
noncomputable def goutDot (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ampRD part ((2 : ℝ) ^ J * u) t

theorem hasDerivAt_gout_param (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) :
    HasDerivAt (fun s : ℝ => gout part J s u) (goutDot part J t u) t := by
  have h1 : HasDerivAt
      (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s ((2 : ℝ) ^ J * u))
      (ampRD part ((2 : ℝ) ^ J * u) t) t := hasDerivAt_ampR_param part _ t
  exact h1.const_mul _

theorem contDiff_deriv_gout (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (gout part J t)) :=
  (contDiff_infty_iff_deriv.mp (contDiff_gout part J t)).2

theorem contDiff_goutDot (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (goutDot part J t) :=
  contDiff_const.mul ((contDiff_ampRD_left part t).comp (contDiff_const.mul contDiff_id))

/-- Away from `t = 0` the dilation derivative is `(u/t)` times the radial derivative. -/
theorem goutDot_eq (part : CoordinateWavePart) (J : ℕ) {t : ℝ} (ht : t ≠ 0) (u : ℝ) :
    goutDot part J t u = ((t⁻¹ * u : ℝ) : ℂ) * deriv (gout part J t) u := by
  rw [goutDot, (hasDerivAt_gout_radius part J t u).deriv]
  have hswap := ampRD_swap part t ((2 : ℝ) ^ J * u)
  have htC : ((t : ℝ) : ℂ) ≠ 0 := by exact_mod_cast ht
  have hval : ampRD part ((2 : ℝ) ^ J * u) t
      = ((((2 : ℝ) ^ J * u : ℝ) : ℂ) / ((t : ℝ) : ℂ)) * ampRD part t ((2 : ℝ) ^ J * u) := by
    field_simp
    linear_combination hswap
  rw [hval]
  push_cast
  field_simp

/-! ### Derivative bounds for the dilation derivative of the amplitude -/

/-- All derivatives of an affine profile are bounded on the annulus. -/
theorem norm_iteratedDeriv_ofReal_lin_le {c u : ℝ} (hc : |c| ≤ 2) (hu : |u| ≤ 2) (k : ℕ) :
    ‖iteratedDeriv k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 4 := by
  have hd : deriv (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) = fun _ : ℝ => ((c : ℝ) : ℂ) := by
    funext x
    have h1 : HasDerivAt (fun u' : ℝ => c * u') c x := by
      simpa using (hasDerivAt_id x).const_mul c
    have h2 : HasDerivAt (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) ((c : ℝ) : ℂ) x := by
      simpa using h1.ofReal_comp
    exact h2.deriv
  match k with
  | 0 =>
      rw [iteratedDeriv_zero, Complex.norm_real, Real.norm_eq_abs, abs_mul]
      nlinarith [abs_nonneg c, abs_nonneg u, hc, hu]
  | (n + 1) =>
      rw [iteratedDeriv_succ', hd, iteratedDeriv_const]
      split_ifs with hn
      · rw [Complex.norm_real, Real.norm_eq_abs]
        linarith
      · rw [norm_zero]
        norm_num

set_option maxHeartbeats 1000000 in
/-- **The dilation derivative of the rescaled amplitude has uniformly bounded derivatives** on
the annulus. -/
theorem norm_iteratedDeriv_goutDot_le {part : CoordinateWavePart} {Camp : ℝ} (hCamp : 0 < Camp)
    {N : ℕ}
    (hamp : ∀ k ≤ N + 1, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ Camp / (u ^ k * Real.sqrt u))
    {J : ℕ} (hJ : 1 ≤ J) {i : ℕ} (hi : i ≤ N) {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3)
    (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (goutDot part J t) u‖
      ≤ (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by
  classical
  have htpos : (0 : ℝ) < t := by linarith
  have hcabs : |t⁻¹| ≤ 2 := by
    rw [abs_of_pos (inv_pos.mpr htpos)]
    rw [inv_le_comm₀ htpos (by norm_num)]
    linarith
  have huabs : |u| ≤ 2 := by
    rw [abs_of_pos (by linarith)]
    linarith
  have hile : ((i : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤)
  have hf : ContDiff ℝ (↑(⊤ : ℕ∞)) fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  have hg : ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (gout part J t)) := contDiff_deriv_gout part J t
  have hfun : goutDot part J t
      = fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ) * deriv (gout part J t) u' := by
    funext u'
    exact goutDot_eq part J (ne_of_gt htpos) u'
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hfun]
  refine le_trans (norm_iteratedFDeriv_mul_le hf hg u hile) ?_
  have hterm : ∀ k ∈ Finset.range (i + 1),
      (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖
          * ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (i.choose k : ℝ) * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by
    intro k hk
    rw [Finset.mem_range] at hk
    have h1 : ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖ ≤ 4 := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact norm_iteratedDeriv_ofReal_lin_le hcabs huabs k
    have h2 : ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (2 : ℝ) ^ (N + 2) * Camp := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, ← iteratedDeriv_succ']
      exact norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht1 ht2 hu1 hu2
    have h3 : (0 : ℝ) ≤ (i.choose k : ℝ) := by positivity
    calc (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖
            * ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (i.choose k : ℝ) * 4 * ((2 : ℝ) ^ (N + 2) * Camp) := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
          positivity
      _ = (i.choose k : ℝ) * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.sum_mul]
  have hchoose : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ)) = (2 : ℝ) ^ i := by
    have h := Nat.sum_range_choose i
    have hcast : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ))
        = ((∑ k ∈ Finset.range (i + 1), i.choose k : ℕ) : ℝ) := by
      push_cast
      ring
    rw [hcast, h]
    push_cast
    ring
  rw [hchoose]
  have hpow : (2 : ℝ) ^ i ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hi
  refine mul_le_mul_of_nonneg_right hpow ?_
  positivity

/-! ### The dilation derivative of the fixed-scale symbol -/

/-- The derivative of the dilation cutoff. -/
noncomputable def tcutD (t : ℝ) : ℝ :=
  2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)
    - Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)

theorem hasDerivAt_tcut (t : ℝ) : HasDerivAt tcut (tcutD t) t := by
  have hst : ∀ x : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition x) x :=
    fun x => (contDiff_st.differentiable (by simp)).differentiableAt.hasDerivAt
  have h1 : HasDerivAt (fun s : ℝ => Real.smoothTransition (2 * s - 1))
      (deriv Real.smoothTransition (2 * t - 1) * 2) t := by
    have hin : HasDerivAt (fun s : ℝ => 2 * s - 1) 2 t := by
      simpa using ((hasDerivAt_id t).const_mul (2 : ℝ)).sub_const 1
    exact (hst (2 * t - 1)).comp t hin
  have h2 : HasDerivAt (fun s : ℝ => Real.smoothTransition (3 - s))
      (deriv Real.smoothTransition (3 - t) * (-1)) t := by
    have hin : HasDerivAt (fun s : ℝ => 3 - s) (-1) t := by
      simpa using (hasDerivAt_id t).const_sub (3 : ℝ)
    exact (hst (3 - t)).comp t hin
  refine (h1.mul h2).congr_deriv ?_
  rw [tcutD]
  ring

theorem tcutD_eq_zero {t : ℝ} (h : ¬(1 / 2 < t ∧ t < 3)) : tcutD t = 0 := by
  rcases not_and_or.mp h with hlow | hhigh
  · have hle : t ≤ 1 / 2 := not_lt.mp hlow
    have h1 : Real.smoothTransition (2 * t - 1) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    have h2 : deriv Real.smoothTransition (2 * t - 1) = 0 :=
      deriv_st_eq_zero_of_nonpos (by linarith)
    rw [tcutD, h1, h2]
    ring
  · have hge : 3 ≤ t := not_lt.mp hhigh
    have h1 : Real.smoothTransition (3 - t) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    have h2 : deriv Real.smoothTransition (3 - t) = 0 :=
      deriv_st_eq_zero_of_nonpos (by linarith)
    rw [tcutD, h1, h2]
    ring

/-- **The dilation derivative of the fixed-scale symbol.** -/
noncomputable def gSymDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) : ℂ :=
  ((tcutD t : ℝ) : ℂ) * (cutF φ v * gout part J t (nrm v))
    + ((tcut t : ℝ) : ℂ) * (cutF φ v * goutDot part J t (nrm v))

theorem hasDerivAt_gSym_param (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) :
    HasDerivAt (fun s : ℝ => gSym φ part J s v) (gSymDot φ part J t v) t := by
  have hrepr : ∀ s : ℝ, gSym φ part J s v
      = ((tcut s : ℝ) : ℂ) * (cutF φ v * gout part J s (nrm v)) := by
    intro s
    exact congrFun (gSym_eq_prod φ part J s) v
  have hfun : (fun s : ℝ => gSym φ part J s v)
      = fun s : ℝ => ((tcut s : ℝ) : ℂ) * (cutF φ v * gout part J s (nrm v)) := by
    funext s
    exact hrepr s
  rw [hfun]
  have h1 : HasDerivAt (fun s : ℝ => ((tcut s : ℝ) : ℂ)) ((tcutD t : ℝ) : ℂ) t := by
    simpa using (hasDerivAt_tcut t).ofReal_comp
  have h2 : HasDerivAt (fun s : ℝ => cutF φ v * gout part J s (nrm v))
      (cutF φ v * goutDot part J t (nrm v)) t :=
    (hasDerivAt_gout_param part J t (nrm v)).const_mul _
  refine (h1.mul h2).congr_deriv ?_
  rw [gSymDot]

theorem contDiff_gSymDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gSymDot φ part J t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * gout part J t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_gout part J t).comp contDiff_nrm)
  have h2 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * goutDot part J t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_goutDot part J t).comp contDiff_nrm)
  exact (contDiff_const.mul h1).add (contDiff_const.mul h2)

set_option maxHeartbeats 2000000 in
/-- **The dilation derivative of the fixed-scale symbol has derivative bounds uniform in the
scale and the dilation.** -/
theorem exists_gSymDot_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ B := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part (N + 1)
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  obtain ⟨Cst, hCst1, hCstd1, hCstd2⟩ := exists_st_deriv2_bound
  have hCg1 : (0 : ℝ) < (2 : ℝ) ^ (N + 2) * Camp := by positivity
  have hCg2 : (0 : ℝ) < (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by positivity
  have hCstpos : (0 : ℝ) < Cst := by linarith
  refine ⟨3 * Cst * ((2 : ℝ) ^ N * Cc
      * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N))
    + (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
      * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N), by positivity, ?_⟩
  intro J hJ n hn t v
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  set F1 : Pl → ℂ := fun v' : Pl => cutF φ v' * gout part J t (nrm v') with hF1
  set F2 : Pl → ℂ := fun v' : Pl => cutF φ v' * goutDot part J t (nrm v') with hF2
  have hF1smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) F1 :=
    (contDiff_cutF φ).mul ((contDiff_gout part J t).comp contDiff_nrm)
  have hF2smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) F2 :=
    (contDiff_cutF φ).mul ((contDiff_goutDot part J t).comp contDiff_nrm)
  -- the two pieces of the derivative symbol
  have hsplit : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖
      ≤ |tcutD t| * ‖iteratedFDeriv ℝ n F1 v‖ + |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ := by
    have hadd : gSymDot φ part J t
        = (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v')
          + fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v' := rfl
    have hsm1 : (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') = (tcutD t) • F1 := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hsm2 : (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') = (tcut t) • F2 := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hc1 : ContDiffAt ℝ n (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') v := by
      rw [hsm1]
      exact ((hF1smooth.of_le hnle).const_smul (tcutD t)).contDiffAt
    have hc2 : ContDiffAt ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') v := by
      rw [hsm2]
      exact ((hF2smooth.of_le hnle).const_smul (tcut t)).contDiffAt
    rw [hadd, iteratedFDeriv_add_apply hc1 hc2]
    refine le_trans (norm_add_le _ _) ?_
    have he1 : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') v‖
        = |tcutD t| * ‖iteratedFDeriv ℝ n F1 v‖ := by
      rw [hsm1, iteratedFDeriv_const_smul_apply (hF1smooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    have he2 : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') v‖
        = |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ := by
      rw [hsm2, iteratedFDeriv_const_smul_apply (hF2smooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    rw [he1, he2]
  refine le_trans hsplit ?_
  by_cases ht : 1 / 2 < t ∧ t < 3
  · -- the main case
    have hGbd1 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 2) * Camp :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht.1.le ht.2.le hu1 hu2
    have hGbd2 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (goutDot part J t) u‖
          ≤ (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_goutDot_le hCamp hamp hJ hi ht.1.le ht.2.le hu1 hu2
    have hb1 : ‖iteratedFDeriv ℝ n F1 v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_gout part J t) hCg1 hGbd1
        hD1 hDbd hCc hcut hn v
    have hb2 : ‖iteratedFDeriv ℝ n F2 v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_goutDot part J t) hCg2 hGbd2
        hD1 hDbd hCc hcut hn v
    have htcutD : |tcutD t| ≤ 3 * Cst := by
      have h1 := hCstd1 (2 * t - 1)
      have h2 := hCstd1 (3 - t)
      have h3 := Real.smoothTransition.le_one (2 * t - 1)
      have h4 := Real.smoothTransition.nonneg (2 * t - 1)
      have h5 := Real.smoothTransition.le_one (3 - t)
      have h6 := Real.smoothTransition.nonneg (3 - t)
      have hb : |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)|
          ≤ 2 * Cst := by
        rw [abs_mul, abs_mul]
        have habs : |(2 : ℝ)| = 2 := by norm_num
        rw [habs, abs_of_nonneg h6]
        nlinarith [abs_nonneg (deriv Real.smoothTransition (2 * t - 1))]
      have hb' : |Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)|
          ≤ Cst := by
        rw [abs_mul, abs_of_nonneg h4]
        nlinarith [abs_nonneg (deriv Real.smoothTransition (3 - t))]
      have := abs_sub (2 * deriv Real.smoothTransition (2 * t - 1)
        * Real.smoothTransition (3 - t))
        (Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t))
      rw [tcutD]
      calc |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)
              - Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)|
          ≤ |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)|
              + |Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)| :=
            abs_sub _ _
        _ ≤ 2 * Cst + Cst := add_le_add hb hb'
        _ = 3 * Cst := by ring
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    have hK1nn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N) := by positivity
    have hK2nn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N) := by
      positivity
    refine add_le_add ?_ ?_
    · exact mul_le_mul htcutD hb1 (norm_nonneg _) (by positivity)
    · calc |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ ≤ 1 * ‖iteratedFDeriv ℝ n F2 v‖ :=
            mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ n F2 v‖ := one_mul _
        _ ≤ _ := hb2
  · -- off the dilation window both cutoffs vanish
    have hz1 : tcutD t = 0 := tcutD_eq_zero ht
    have hz2 : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz1, hz2, abs_zero, zero_mul, zero_mul, add_zero]
    positivity

/-! ### The radial profile of the phase derivative -/

/-- All derivatives of an affine profile are bounded on the annulus, with the constant linear in
the slope. -/
theorem norm_iteratedDeriv_lin_le (c : ℝ) {u : ℝ} (hu : |u| ≤ 2) (k : ℕ) :
    ‖iteratedDeriv k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 2 * (|c| + 1) := by
  have hd : deriv (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) = fun _ : ℝ => ((c : ℝ) : ℂ) := by
    funext x
    have h1 : HasDerivAt (fun u' : ℝ => c * u') c x := by
      simpa using (hasDerivAt_id x).const_mul c
    have h2 : HasDerivAt (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) ((c : ℝ) : ℂ) x := by
      simpa using h1.ofReal_comp
    exact h2.deriv
  match k with
  | 0 =>
      rw [iteratedDeriv_zero, Complex.norm_real, Real.norm_eq_abs, abs_mul]
      nlinarith [abs_nonneg c, abs_nonneg u, hu]
  | (n + 1) =>
      rw [iteratedDeriv_succ', hd, iteratedDeriv_const]
      split_ifs with hn
      · rw [Complex.norm_real, Real.norm_eq_abs]
        nlinarith [abs_nonneg c]
      · rw [norm_zero]
        nlinarith [abs_nonneg c]

set_option maxHeartbeats 1000000 in
/-- **The Leibniz bound for an affine factor times a bounded profile.** -/
theorem norm_iteratedDeriv_lin_mul_le {c : ℝ} {G : ℝ → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G)
    {Cg : ℝ} (hCg : 0 ≤ Cg) {N : ℕ}
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i G u‖ ≤ Cg)
    {i : ℕ} (hi : i ≤ N) {u : ℝ} (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (fun u' : ℝ => ((c * u' : ℝ) : ℂ) * G u') u‖
      ≤ (2 : ℝ) ^ N * (2 * (|c| + 1)) * Cg := by
  classical
  have huabs : |u| ≤ 2 := by
    rw [abs_of_pos (by linarith)]
    linarith
  have hile : ((i : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤)
  have hf : ContDiff ℝ (↑(⊤ : ℕ∞)) fun u' : ℝ => ((c * u' : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  refine le_trans (norm_iteratedFDeriv_mul_le hf hG u hile) ?_
  have hterm : ∀ k ∈ Finset.range (i + 1),
      (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖
          * ‖iteratedFDeriv ℝ (i - k) G u‖
        ≤ (i.choose k : ℝ) * ((2 * (|c| + 1)) * Cg) := by
    intro k hk
    rw [Finset.mem_range] at hk
    have h1 : ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 2 * (|c| + 1) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact norm_iteratedDeriv_lin_le c huabs k
    have h2 : ‖iteratedFDeriv ℝ (i - k) G u‖ ≤ Cg := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact hGbd (i - k) (by omega) u hu1 hu2
    have h3 : (0 : ℝ) ≤ (i.choose k : ℝ) := by positivity
    calc (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖
            * ‖iteratedFDeriv ℝ (i - k) G u‖
        ≤ (i.choose k : ℝ) * (2 * (|c| + 1)) * Cg := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
          have habs : (0 : ℝ) ≤ |c| := abs_nonneg c
          positivity
      _ = (i.choose k : ℝ) * ((2 * (|c| + 1)) * Cg) := by ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.sum_mul]
  have hchoose : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ)) = (2 : ℝ) ^ i := by
    have h := Nat.sum_range_choose i
    have hcast : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ))
        = ((∑ k ∈ Finset.range (i + 1), i.choose k : ℕ) : ℝ) := by
      push_cast
      ring
    rw [hcast, h]
    push_cast
    ring
  rw [hchoose, ← mul_assoc]
  have hpow : (2 : ℝ) ^ i ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hi
  refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hpow ?_) hCg
  have habs : (0 : ℝ) ≤ |c| := abs_nonneg c
  positivity

/-- The radial profile of the term produced by differentiating the phase in the dilation. -/
noncomputable def goutPh (part : CoordinateWavePart) (J : ℕ) (ε t u : ℝ) : ℂ :=
  (((2 * π * ε * (2 : ℝ) ^ J) * u : ℝ) : ℂ) * (Complex.I * gout part J t u)

theorem contDiff_goutPh (part : CoordinateWavePart) (J : ℕ) (ε t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (goutPh part J ε t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞))
      fun u : ℝ => (((2 * π * ε * (2 : ℝ) ^ J) * u : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  exact h1.mul (contDiff_const.mul (contDiff_gout part J t))

theorem norm_iteratedDeriv_goutPh_le {part : CoordinateWavePart} {Cg : ℝ} (hCg : 0 ≤ Cg)
    {N : ℕ} {J : ℕ} {ε t : ℝ}
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i (gout part J t) u‖ ≤ Cg)
    {i : ℕ} (hi : i ≤ N) {u : ℝ} (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (goutPh part J ε t) u‖
      ≤ (2 : ℝ) ^ N * (2 * (|2 * π * ε * (2 : ℝ) ^ J| + 1)) * Cg := by
  have hIbd : ∀ k ≤ N, ∀ u' : ℝ, 1 / 2 ≤ u' → u' ≤ 2 →
      ‖iteratedDeriv k (fun w : ℝ => Complex.I * gout part J t w) u'‖ ≤ Cg := by
    intro k hk u' hu1' hu2'
    have hcm : iteratedDeriv k (fun w : ℝ => Complex.I * gout part J t w) u'
        = Complex.I * iteratedDeriv k (gout part J t) u' := by
      refine iteratedDeriv_const_mul _ ?_
      exact ((contDiff_gout part J t).of_le
        (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))).contDiffAt
    rw [hcm, norm_mul, Complex.norm_I, one_mul]
    exact hGbd k hk u' hu1' hu2'
  have hIsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => Complex.I * gout part J t w :=
    contDiff_const.mul (contDiff_gout part J t)
  exact norm_iteratedDeriv_lin_mul_le hIsmooth hCg hIbd hi hu1 hu2

/-! ### The dilation-derivative symbol -/

/-- On the support of the cutoff the smooth truncated norm is the norm, and the annulus
condition holds. -/
theorem norm_mem_of_cutF_ne_zero {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    {v : Pl} (h : cutF φ v ≠ 0) : 1 / 2 < ‖v‖ ∧ ‖v‖ < 2 := by
  have hbp : bpCut φ v ≠ 0 := by
    intro hc
    rw [cutF, hc, zero_mul] at h
    exact h rfl
  constructor
  · by_contra hcon
    exact hbp (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
  · by_contra hcon
    exact hbp (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))

/-- The sector membership from the cutoff alone. -/
theorem theta_of_cutF_ne_zero {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) (J : ℕ) {ω : Pl}
    (h : cutF φ ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0) : ω ∈ Theta J := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [cutF, hc] at h
    simp at h
  obtain ⟨hs1, hs2, hs3, hs4⟩ := sector_of_psiSec_ne_zero hps
  obtain ⟨hlow, hhigh⟩ := norm_mem_of_cutF_ne_zero hφone hφzero h
  have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
  have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
    rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
  have hω0 : v 0 = (2 : ℝ) ^ (-(J : ℤ)) * ω 0 := rfl
  have hω1 : v 1 = (2 : ℝ) ^ (-(J : ℤ)) * ω 1 := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hω0] at hs3
    nlinarith [hs3, hJpos]
  · rw [hω0, hω1] at hs4
    nlinarith [hs4, hJpos]
  · rw [hnormv] at hlow
    have hpow : (2 : ℝ) ^ ((J : ℤ) - 1) = (2 : ℝ) ^ (J : ℤ) / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hlow, hJpos, hid]
  · rw [hnormv] at hhigh
    have hpow : (2 : ℝ) ^ ((J : ℤ) + 1) = (2 : ℝ) ^ (J : ℤ) * 2 := by
      rw [two_zpow_add]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hhigh, hJpos, hid]

theorem gSym_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ) (t : ℝ)
    {v : Pl} (h : cutF φ v = 0) : gSym φ part J t v = 0 := by
  have hrepr := congrFun (gSym_eq_prod φ part J t) v
  rw [hrepr, h, zero_mul, mul_zero]

theorem gSymDot_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) {v : Pl} (h : cutF φ v = 0) : gSymDot φ part J t v = 0 := by
  rw [gSymDot, h, zero_mul, zero_mul, mul_zero, mul_zero, add_zero]

/-- **The symbol of the dilation derivative of the full multiplier.** -/
noncomputable def mtilSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) (v : Pl) : ℂ :=
  ((tcut t : ℝ) : ℂ) * (cutF φ v * goutPh part J ε t (nrm v)) + gSymDot φ part J t v

theorem contDiff_mtilSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (mtilSym φ part J ε t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * goutPh part J ε t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_goutPh part J ε t).comp contDiff_nrm)
  exact (contDiff_const.mul h1).add (contDiff_gSymDot φ part J t)

theorem mtilSym_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) {v : Pl} (h : cutF φ v = 0) : mtilSym φ part J ε t v = 0 := by
  rw [mtilSym, h, zero_mul, mul_zero, gSymDot_eq_zero_of_cutF part J t h, add_zero]

/-- The rescaled sector multiplier and its dilation derivative. -/
noncomputable def mscDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (ω : Pl) : ℂ :=
  gSymDot φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω)

theorem hasDerivAt_msc (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ω : Pl) (t : ℝ) :
    HasDerivAt (fun s : ℝ => msc φ part J s ω) (mscDot φ part J t ω) t :=
  hasDerivAt_gSym_param φ part J t _

/-- **The dilation derivative of the sector multiplier is the rescaling of `mtilSym`.** -/
theorem mtil_msc_eq (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (ε t : ℝ) (ω : Pl) :
    mtil ε (msc φ part J) (mscDot φ part J) t ω
      = mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hkey : ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * gSym φ part J t v
      = ((tcut t : ℝ) : ℂ) * (cutF φ v * goutPh part J ε t (nrm v)) := by
    have hrepr := congrFun (gSym_eq_prod φ part J t) v
    by_cases hc : cutF φ v = 0
    · rw [hrepr, hc]
      simp
    · -- on the support the two radial variables agree
      obtain ⟨hlow, hhigh⟩ := norm_mem_of_cutF_ne_zero hφone hφzero hc
      have hnrm : nrm v = ‖v‖ := nrm_eq (by linarith) (by linarith)
      have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
      have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
        rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
      have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
        rw [← two_zpow_add, neg_add_cancel, zpow_zero]
      have hJn : ((2 : ℝ) ^ J : ℝ) = (2 : ℝ) ^ (J : ℤ) := by
        rw [zpow_natCast]
      have hprod : (2 : ℝ) ^ J * nrm v = ‖ω‖ := by
        rw [hnrm, hnormv, hJn]
        nlinarith [hid]
      have hprod2 : 2 * π * ε * (2 : ℝ) ^ J * nrm v = 2 * π * ε * ‖ω‖ := by
        rw [← hprod]
        ring
      rw [hrepr, goutPh, hprod2]
      ring
  rw [mtil, mscDot, msc, mtilSym, ← hv, hkey]

set_option maxHeartbeats 2000000 in
/-- **The dilation-derivative symbol has derivative bounds which lose only one factor `2^J`**,
the factor produced by differentiating the phase. -/
theorem exists_mtilSym_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) {ε : ℝ} (hε : |ε| = 1) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (mtilSym φ part J ε t) v‖ ≤ B * (2 : ℝ) ^ J := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part (N + 1)
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  obtain ⟨Bdot, hBdot, hdot⟩ := exists_gSymDot_bound φ hφone hφzero part N
  have hCg1 : (0 : ℝ) < (2 : ℝ) ^ (N + 2) * Camp := by positivity
  have hπ : (0 : ℝ) < π := Real.pi_pos
  refine ⟨(2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
      * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) + Bdot,
    by positivity, ?_⟩
  intro J hJ n hn t v
  have h1le : (1 : ℝ) ≤ (2 : ℝ) ^ J := by
    have h := pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (Nat.zero_le J)
    simpa using h
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  set Fph : Pl → ℂ := fun v' : Pl => cutF φ v' * goutPh part J ε t (nrm v') with hFph
  have hFphsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) Fph :=
    (contDiff_cutF φ).mul ((contDiff_goutPh part J ε t).comp contDiff_nrm)
  -- split the symbol into the phase term and the amplitude term
  have hsplit : ‖iteratedFDeriv ℝ n (mtilSym φ part J ε t) v‖
      ≤ |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
        + ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ := by
    have hadd : mtilSym φ part J ε t
        = (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') + gSymDot φ part J t := rfl
    have hsm : (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') = (tcut t) • Fph := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hc1 : ContDiffAt ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') v := by
      rw [hsm]
      exact ((hFphsmooth.of_le hnle).const_smul (tcut t)).contDiffAt
    have hc2 : ContDiffAt ℝ n (gSymDot φ part J t) v :=
      ((contDiff_gSymDot φ part J t).of_le hnle).contDiffAt
    rw [hadd, iteratedFDeriv_add_apply hc1 hc2]
    refine le_trans (norm_add_le _ _) (add_le_add ?_ (le_refl _))
    have he : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') v‖
        = |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖ := by
      rw [hsm, iteratedFDeriv_const_smul_apply (hFphsmooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    rw [he]
  have hdotbd : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ Bdot := hdot J hJ n hn t v
  refine le_trans hsplit ?_
  by_cases ht : 1 / 2 < t ∧ t < 3
  · -- the main case
    have hGbd1 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 2) * Camp :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht.1.le ht.2.le hu1 hu2
    have habs : |2 * π * ε * (2 : ℝ) ^ J| = 2 * π * (2 : ℝ) ^ J := by
      have h1 : 2 * π * ε * (2 : ℝ) ^ J = (2 * π * (2 : ℝ) ^ J) * ε := by ring
      rw [h1, abs_mul, hε, mul_one, abs_of_pos (by positivity)]
    have hGph : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (goutPh part J ε t) u‖
          ≤ (2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp) := by
      intro i hi u hu1 hu2
      refine le_trans (norm_iteratedDeriv_goutPh_le hCg1.le hGbd1 hi hu1 hu2) ?_
      refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ (by positivity)) hCg1.le
      rw [habs]
      nlinarith [h1le, hπ]
    have hb : ‖iteratedFDeriv ℝ n Fph v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ)
            * ((2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp))
          * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_goutPh part J ε t)
        (by positivity) hGph hD1 hDbd hCc hcut hn v
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    have hstep : |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
        ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
            * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
          * (2 : ℝ) ^ J := by
      calc |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖ ≤ 1 * ‖iteratedFDeriv ℝ n Fph v‖ :=
            mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ n Fph v‖ := one_mul _
        _ ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp))
            * D ^ N) := hb
        _ = (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
            * (2 : ℝ) ^ J := by ring
    have hdot2 : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ Bdot * (2 : ℝ) ^ J := by
      nlinarith [hdotbd, h1le, hBdot]
    calc |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
          + ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖
        ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
            * (2 : ℝ) ^ J + Bdot * (2 : ℝ) ^ J := add_le_add hstep hdot2
      _ = ((2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) + Bdot)
            * (2 : ℝ) ^ J := by ring
  · -- off the dilation window the phase term vanishes
    have hz : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz, abs_zero, zero_mul, zero_add]
    have hKnn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
        * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) := by
      positivity
    nlinarith [hdotbd, h1le, hKnn, hBdot]

/-- **The dilation-derivative multiplier satisfies both hypothesis packages**, with constants that
lose only the factor `2^J` of the phase. -/
theorem exists_mtil_data (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) {ε : ℝ} (hε : |ε| = 1) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J →
      MultData J (mtil ε (msc φ part J) (mscDot φ part J))
          (m2can (mtil ε (msc φ part J) (mscDot φ part J))) (B * (2 : ℝ) ^ J)
        ∧ PolarData J (mtil ε (msc φ part J) (mscDot φ part J))
          (mrcan (mtil ε (msc φ part J) (mscDot φ part J)))
          (macan (mtil ε (msc φ part J) (mscDot φ part J))) (384 * (B * (2 : ℝ) ^ J)) := by
  obtain ⟨B, hBpos, hB⟩ := exists_mtilSym_bound φ hφone hφzero part 4 hε
  refine ⟨B, hBpos, fun J hJ => ?_⟩
  have hfun : mtil ε (msc φ part J) (mscDot φ part J)
      = fun t ω => mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) := by
    funext t ω
    exact mtil_msc_eq φ hφone hφzero part J ε t ω
  have hsupp : ∀ (t : ℝ) (ω : Pl),
      mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0 → ω ∈ Theta J := by
    intro t ω h
    refine theta_of_cutF_ne_zero hφone hφzero J ?_
    intro hc
    exact h (mtilSym_eq_zero_of_cutF part J ε t hc)
  have hzero : ∀ (t : ℝ) (v : Pl), 2 ≤ ‖v‖ → mtilSym φ part J ε t v = 0 := by
    intro t v hv
    refine mtilSym_eq_zero_of_cutF part J ε t ?_
    rw [cutF, bpCut_eq_zero_of_large hφzero hv, zero_mul]
  rw [hfun]
  refine ⟨?_, ?_⟩
  · exact multData_of_rescaled (fun t => contDiff_mtilSym φ part J ε t) hsupp
      (fun n hn t v => hB J hJ n (by omega) t v)
  · exact polarData_of_rescaled (fun t => contDiff_mtilSym φ part J ε t) hsupp hzero
      (fun n hn t v => hB J hJ n hn t v)

/-! ### Continuity in the dilation -/

theorem continuous_ampR_param (part : CoordinateWavePart) (u : ℝ) :
    Continuous fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u := by
  have hfun : (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      = fun s : ℝ => planarCoordinateWaveRadialAmplitude part u s := by
    funext s
    exact ampR_symm part s u
  rw [hfun]
  exact (contDiff_ampR part u).continuous

theorem continuous_ampRD_param (part : CoordinateWavePart) (w : ℝ) :
    Continuous fun t : ℝ => ampRD part w t := by
  cases part with
  | outgoing =>
      show Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ) * deriv planarEndpointQuadraticIntegral ((2 * π * w) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_endpoint.continuous.comp (continuous_const.mul continuous_id)))
  | incoming =>
      show Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((-(2 * π * w) : ℝ) : ℂ)
          * deriv planarEndpointQuadraticIntegral ((-(2 * π * w)) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_endpoint.continuous.comp (continuous_const.mul continuous_id)))
  | middle =>
      show Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ)
          * deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * w) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_middle.continuous.comp (continuous_const.mul continuous_id)))

theorem continuous_gout_param (part : CoordinateWavePart) (J : ℕ) (u : ℝ) :
    Continuous fun s : ℝ => gout part J s u :=
  continuous_const.mul (continuous_ampR_param part _)

theorem continuous_goutDot_param (part : CoordinateWavePart) (J : ℕ) (u : ℝ) :
    Continuous fun t : ℝ => goutDot part J t u :=
  continuous_const.mul (continuous_ampRD_param part _)

theorem continuous_tcut : Continuous tcut := contDiff_tcut.continuous

theorem continuous_tcutD : Continuous tcutD := by
  have hst : Continuous Real.smoothTransition := contDiff_st.continuous
  have hstd : Continuous (deriv Real.smoothTransition) := contDiff_deriv_st.continuous
  have h1 : Continuous fun t : ℝ => 2 * t - 1 :=
    (continuous_const.mul continuous_id).sub continuous_const
  have h2 : Continuous fun t : ℝ => 3 - t := continuous_const.sub continuous_id
  exact ((continuous_const.mul (hstd.comp h1)).mul (hst.comp h2)).sub
    ((hst.comp h1).mul (hstd.comp h2))

theorem continuous_gSymDot_param (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (v : Pl) : Continuous fun t : ℝ => gSymDot φ part J t v := by
  have h1 : Continuous fun t : ℝ => ((tcutD t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_tcutD
  have h2 : Continuous fun t : ℝ => ((tcut t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_tcut
  exact (h1.mul (continuous_const.mul (continuous_gout_param part J (nrm v)))).add
    (h2.mul (continuous_const.mul (continuous_goutDot_param part J (nrm v))))

theorem continuous_mscDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ω : Pl) : Continuous fun s : ℝ => mscDot φ part J s ω :=
  continuous_gSymDot_param φ part J _

/-! ### The sector decomposition of the dyadic bandpass multiplier -/

theorem nrm_rotF (α : ℝ) (v : Pl) : nrm (rotF α v) = nrm v := by
  rw [nrm, nrm, norm_rotF]

theorem bpCut_rotF {φ : SchwartzMap Pl ℂ} (hφrad : IsNormRadial (φ : Pl → ℂ)) (α : ℝ)
    (v : Pl) : bpCut φ (rotF α v) = bpCut φ v := by
  have h1 : (φ : Pl → ℂ) (rotF α v) = (φ : Pl → ℂ) v := hφrad (norm_rotF α v)
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • rotF α v) = (φ : Pl → ℂ) ((2 : ℝ) • v) := by
    refine hφrad ?_
    rw [← rotF_smul_apply, norm_rotF]
  rw [bpCut, bpCut, h1, h2]

/-- The repository's absolute dyadic bandpass is the fixed-scale bandpass cutoff at the
rescaled frequency, with `J = j + 1`. -/
theorem absoluteDyadicBandpass_eq_bpCut {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) (j : ℕ) (ξ : Pl) :
    (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ
      = bpCut φ ((2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) • ξ) := by
  have hc : (2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) = ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [zpow_neg, zpow_natCast]
  have hsm : (2 : ℝ) • (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) = ((2 : ℝ) ^ j)⁻¹ • ξ := by
    rw [smul_smul]
    congr 1
    rw [pow_succ]
    field_simp
  rw [absoluteDyadicBandpass_spec φ hφone hφzero j ξ, bpCut, hc, hsm]

set_option maxHeartbeats 1000000 in
/-- **The sector decomposition.**  For dilations in `[1,2]` the product of the wave amplitude with
the dyadic bandpass is `2^{-J/2}` times the sum of the `N` rotated copies of the single sector
multiplier. -/
theorem sector_sum_msc {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (hφrad : IsNormRadial (φ : Pl → ℂ))
    (part : CoordinateWavePart) (j : ℕ) {t : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) :
    (∑ ν ∈ Finset.range Nsec, msc φ part (j + 1) t (rotF (-((ν : ℝ) * hsec)) ξ))
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
        * (planarCoordinateWaveRadialAmplitude part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ) := by
  classical
  set c : ℝ := (2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) with hcdef
  set v : Pl := c • ξ with hvdef
  have hcpos : (0 : ℝ) < c := by
    rw [hcdef]
    positivity
  have hbp : (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ = bpCut φ v :=
    absoluteDyadicBandpass_eq_bpCut hφone hφzero j ξ
  -- each rotated multiplier, written out
  have hterm : ∀ ν : ℕ, msc φ part (j + 1) t (rotF (-((ν : ℝ) * hsec)) ξ)
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * ((tcut t : ℝ) : ℂ) * bpCut φ v
        * ((psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ)
        * planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ (j + 1) * nrm v) := by
    intro ν
    have hrot : c • rotF (-((ν : ℝ) * hsec)) ξ = rotF (-((ν : ℝ) * hsec)) v := by
      rw [hvdef, rotF_smul_apply]
    rw [msc, hrot, gSym, bpCut_rotF hφrad, nrm_rotF]
  rw [Finset.sum_congr rfl fun ν _ => hterm ν]
  by_cases hz : bpCut φ v = 0
  · rw [hbp, hz]
    simp
  · -- on the support the annulus condition holds, so the rotated cutoffs sum to one
    have hlow : 1 / 2 < ‖v‖ := by
      by_contra hcon
      exact hz (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
    have hhigh : ‖v‖ < 2 := by
      by_contra hcon
      exact hz (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))
    have hnrm : nrm v = ‖v‖ := nrm_eq (by linarith) (by linarith)
    have hnormv : ‖v‖ = c * ‖ξ‖ := by
      rw [hvdef, norm_smul, Real.norm_eq_abs, abs_of_pos hcpos]
    have hid : c * (2 : ℝ) ^ (j + 1) = 1 := by
      rw [hcdef]
      rw [show ((2 : ℝ) ^ (j + 1)) = (2 : ℝ) ^ ((j + 1 : ℕ) : ℤ) by rw [zpow_natCast]]
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    have hprod : (2 : ℝ) ^ (j + 1) * nrm v = ‖ξ‖ := by
      rw [hnrm, hnormv]
      nlinarith [hid]
    have htcut1 : tcut t = 1 := tcut_eq_one ht1 ht2
    rw [hprod, htcut1]
    have hsum : (∑ ν ∈ Finset.range Nsec,
        ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * ((1 : ℝ) : ℂ) * bpCut φ v
          * ((psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ)
          * planarCoordinateWaveRadialAmplitude part t ‖ξ‖)
        = (((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * bpCut φ v
            * planarCoordinateWaveRadialAmplitude part t ‖ξ‖)
          * ((∑ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ) := by
      rw [Complex.ofReal_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun ν _ => ?_
      push_cast
      ring
    rw [hsum, sum_psiSec_rotF (le_of_lt hlow) (le_of_lt hhigh), hbp]
    push_cast
    ring

/-! ### The wave pieces of the single-scale average, and their sector expansion -/

/-- The rotate of a Schwartz function. -/
noncomputable def rotSch (α : ℝ) (f : SchwartzMap Pl ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ (rotCLE α) f

@[simp] theorem rotSch_apply (α : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (rotSch α f : Pl → ℂ) x = (f : Pl → ℂ) (rotF α x) := rfl

theorem rotSch_coe (α : ℝ) (f : SchwartzMap Pl ℂ) :
    (rotSch α f : Pl → ℂ) = fun x : Pl => (f : Pl → ℂ) (rotF α x) := rfl

/-- The `part`-wave piece of the dyadic single-scale spherical average. -/
noncomputable def waveInt {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) : ℂ :=
  ∫ ω : Pl, ee (-(inner ℝ x ω : ℝ))
    * (planarCoordinateWaveRadialTerm part t ‖ω‖
        * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω * 𝓕 ((f : Pl → ℂ)) ω)

theorem integrable_integrand_mfull_rot {j : ℕ} {m : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ)
    (f : SchwartzMap Pl ℂ) (x : Pl) (α : ℝ) :
    Integrable (fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
      * (mfull j ε m t (rotF α ξ) * 𝓕 ((f : Pl → ℂ)) ξ)) (volume : Measure Pl) := by
  have hbint : Integrable (fun ω : Pl => B0 * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul B0
  have hcont : Continuous fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
      * (mfull j ε m t (rotF α ξ) * 𝓕 ((f : Pl → ℂ)) ξ) := by
    have hee : Continuous fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ)) := by
      have h1 : Continuous fun ξ : Pl => -(inner ℝ x ξ : ℝ) :=
        (continuous_const.inner continuous_id).neg
      exact continuous_ee.comp h1
    have hfF : Continuous (𝓕 ((f : Pl → ℂ))) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).continuous
    exact hee.mul ((((contDiff_mfull hm ε t).continuous).comp (continuous_rotF α)).mul hfF)
  refine Integrable.mono' hbint hcont.aestronglyMeasurable ?_
  filter_upwards with ξ
  rw [norm_mul, norm_mul, norm_ee, one_mul]
  exact mul_le_mul_of_nonneg_right (norm_mfull_le hm ε t _) (norm_nonneg _)

set_option maxHeartbeats 1000000 in
/-- **The wave piece is the sum of the rotated sector operators**, given the sector expansion of
the multiplier. -/
theorem waveInt_eq_sector_sum {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) {ε : ℝ} {j : ℕ} {msym : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData (j + 1) msym m2 B0) {t : ℝ}
    (hsum : ∀ ξ : Pl, (∑ ν ∈ Finset.range Nsec,
        mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ))
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
        * (planarCoordinateWaveRadialTerm part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ))
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    waveInt hφone hφzero part j t f x
      = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ) * ∑ ν ∈ Finset.range Nsec,
          (TopS hm ε t (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ) (rotF (-((ν : ℝ) * hsec)) x) := by
  classical
  have hsqrtpos : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ (j + 1)) := by
    refine Real.sqrt_pos.mpr ?_
    positivity
  -- step 1: each rotated operator as an integral in the original frequency variable
  have hpiece : ∀ α : ℝ,
      (TopS hm ε t (rotSch α f) : Pl → ℂ) (rotF (-α) x)
        = ∫ ξ : Pl, ee (-(inner ℝ x ξ : ℝ))
            * (mfull (j + 1) ε msym t (rotF (-α) ξ) * 𝓕 ((f : Pl → ℂ)) ξ) := by
    intro α
    rw [TopS_eq_integral hm ε t (rotSch α f) (rotF (-α) x)]
    have h := (measurePreserving_rotF α).integral_comp (measurableEmbedding_rotF α)
      (fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-α) ξ) * 𝓕 ((f : Pl → ℂ)) ξ))
    rw [← h]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    have hinner : (inner ℝ x (rotF α ω) : ℝ) = (inner ℝ (rotF (-α) x) ω : ℝ) := by
      have h1 := inner_rotF (-α) x (rotF α ω)
      rw [rotF_neg_rotF] at h1
      exact h1.symm
    have hrot2 : rotF (-α) (rotF α ω) = ω := rotF_neg_rotF α ω
    have hfour : 𝓕 ((rotSch α f : Pl → ℂ)) ω = 𝓕 ((f : Pl → ℂ)) (rotF α ω) := by
      rw [rotSch_coe]
      exact fourier_comp_rotF α ω
    show ee (-(inner ℝ (rotF (-α) x) ω : ℝ))
        * (mfull (j + 1) ε msym t ω * 𝓕 ((rotSch α f : Pl → ℂ)) ω)
      = ee (-(inner ℝ x (rotF α ω) : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-α) (rotF α ω))
          * 𝓕 ((f : Pl → ℂ)) (rotF α ω))
    rw [hinner, hrot2, hfour]
  have hsumeq : (∑ ν ∈ Finset.range Nsec,
      (TopS hm ε t (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ) (rotF (-((ν : ℝ) * hsec)) x))
      = ∑ ν ∈ Finset.range Nsec, ∫ ξ : Pl, ee (-(inner ℝ x ξ : ℝ))
          * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
            * 𝓕 ((f : Pl → ℂ)) ξ) :=
    Finset.sum_congr rfl fun ν _ => hpiece ((ν : ℝ) * hsec)
  rw [hsumeq]
  -- step 2: combine the finite sum with the integral
  have hint : ∀ ν ∈ Finset.range Nsec, Integrable (fun ξ : Pl =>
      ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
          * 𝓕 ((f : Pl → ℂ)) ξ)) (volume : Measure Pl) := fun ν _ =>
    integrable_integrand_mfull_rot hm ε t f x _
  rw [← integral_finset_sum _ hint, ← integral_const_mul, waveInt]
  -- step 3: compare the integrands
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  show ee (-(inner ℝ x ξ : ℝ))
      * (planarCoordinateWaveRadialTerm part t ‖ξ‖
        * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ * 𝓕 ((f : Pl → ℂ)) ξ)
    = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ) * ∑ ν ∈ Finset.range Nsec,
        ee (-(inner ℝ x ξ : ℝ))
          * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
            * 𝓕 ((f : Pl → ℂ)) ξ)
  have hcancel : (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
      * ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, inv_mul_cancel₀ (ne_of_gt hsqrtpos), Complex.ofReal_one]
  have hpull : (∑ ν ∈ Finset.range Nsec, ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ) * 𝓕 ((f : Pl → ℂ)) ξ))
      = (ee (-(inner ℝ x ξ : ℝ)) * 𝓕 ((f : Pl → ℂ)) ξ)
        * ∑ ν ∈ Finset.range Nsec,
            mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    ring
  rw [hpull, hsum ξ]
  calc ee (-(inner ℝ x ξ : ℝ))
        * (planarCoordinateWaveRadialTerm part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ * 𝓕 ((f : Pl → ℂ)) ξ)
      = ((((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
          * ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ))
        * (ee (-(inner ℝ x ξ : ℝ))
          * (planarCoordinateWaveRadialTerm part t ‖ξ‖
            * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ
            * 𝓕 ((f : Pl → ℂ)) ξ)) := by
        rw [hcancel, one_mul]
    _ = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
        * ((ee (-(inner ℝ x ξ : ℝ)) * 𝓕 ((f : Pl → ℂ)) ξ)
          * (((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
            * (planarCoordinateWaveRadialTerm part t ‖ξ‖
              * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ))) := by
        ring

/-! ### The three wave pieces reassemble the single-scale average -/

theorem fourierInv_eq_ee_Pl (g : Pl → ℂ) (x : Pl) :
    𝓕⁻ g x = ∫ ω : Pl, ee (-(inner ℝ x ω : ℝ)) * g ω := by
  rw [Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  have hinner : (inner ℝ v (-x) : ℝ) = -(inner ℝ x v : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  simp only [hinner]

theorem continuous_waveTerm_norm (part : CoordinateWavePart) (t : ℝ) :
    Continuous fun ω : Pl => planarCoordinateWaveRadialTerm part t ‖ω‖ := by
  have h1 : Continuous fun ρ : ℝ => planarCoordinateWaveRadialTerm part t ρ := by
    rw [show (fun ρ : ℝ => planarCoordinateWaveRadialTerm part t ρ)
        = fun ρ : ℝ => planarCoordinateWaveRadialAmplitude part t ρ
          * oscillatoryExp (coordinateWaveRadialPhase part t) ρ from rfl]
    refine (contDiff_ampR part t).continuous.mul ?_
    have h2 : Continuous fun ρ : ℝ =>
        (((coordinateWaveRadialPhase part t * ρ : ℝ)) : ℂ) * Complex.I :=
      (Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul continuous_const
    exact Complex.continuous_exp.comp h2
  exact h1.comp continuous_norm

/-- The integrand of the `part`-wave piece. -/
noncomputable def waveIntegrand {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) : Pl → ℂ :=
  fun ω : Pl => ee (-(inner ℝ x ω : ℝ))
    * (planarCoordinateWaveRadialTerm part t ‖ω‖
      * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω * 𝓕 ((f : Pl → ℂ)) ω)

theorem waveInt_eq_integral {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    waveInt hφone hφzero part j t f x
      = ∫ ω : Pl, waveIntegrand hφone hφzero part j t f x ω := rfl

theorem integrable_waveInt_integrand {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    Integrable (waveIntegrand hφone hφzero part j t f x) (volume : Measure Pl) := by
  classical
  set G : Pl → ℂ := fun ω : Pl => planarCoordinateWaveRadialTerm part t ‖ω‖
    * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω with hGdef
  have hGcont : Continuous G :=
    (continuous_waveTerm_norm part t).mul
      (absoluteDyadicBandpass φ hφone hφzero j).continuous
  have hGsupp : HasCompactSupport G := by
    refine HasCompactSupport.mul_left ?_
    exact absoluteDyadicBandpass_compact φ hφone hφzero j
  obtain ⟨C, hC⟩ := hGcont.bounded_above_of_compact_support hGsupp
  have hbint : Integrable (fun ω : Pl => C * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul C
  have hcont : Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) * (G ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    have hee : Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) := by
      have h1 : Continuous fun ω : Pl => -(inner ℝ x ω : ℝ) :=
        (continuous_const.inner continuous_id).neg
      exact continuous_ee.comp h1
    have hfF : Continuous (𝓕 ((f : Pl → ℂ))) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).continuous
    exact hee.mul (hGcont.mul hfF)
  have hgoal : waveIntegrand hφone hφzero part j t f x
      = fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) * (G ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    funext ω
    rw [waveIntegrand, hGdef]
  rw [hgoal]
  refine Integrable.mono' hbint hcont.aestronglyMeasurable ?_
  filter_upwards with ω
  rw [norm_mul, norm_mul, norm_ee, one_mul]
  exact mul_le_mul_of_nonneg_right (hC ω) (norm_nonneg _)

set_option maxHeartbeats 1000000 in
/-- **The three coordinate waves reassemble the single-scale dyadic spherical average.** -/
theorem sphericalAverage_bandpass_eq_wave_sum {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (j : ℕ) {t : ℝ} (ht : 0 < t) (f : SchwartzMap Pl ℂ) (x : Pl) :
    sphericalAverage 2 ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
        SchwartzMap Pl ℂ) : Pl → ℂ) t x
      = waveInt hφone hφzero CoordinateWavePart.outgoing j t f x
        + waveInt hφone hφzero CoordinateWavePart.incoming j t f x
        + waveInt hφone hφzero CoordinateWavePart.middle j t f x := by
  classical
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz,
    fourierInv_eq_ee_Pl]
  have hA := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.outgoing j t f x
  have hB := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.incoming j t f x
  have hC := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.middle j t f x
  have hAB : Integrable (fun ω : Pl =>
      waveIntegrand hφone hφzero CoordinateWavePart.outgoing j t f x ω
        + waveIntegrand hφone hφzero CoordinateWavePart.incoming j t f x ω)
      (volume : Measure Pl) := hA.add hB
  have hsplit : ∀ ω : Pl, ee (-(inner ℝ x ω : ℝ))
        * (surfaceFourier 2 (-t • ω)
          * 𝓕 ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
              SchwartzMap Pl ℂ) : Pl → ℂ) ω)
      = (waveIntegrand hφone hφzero CoordinateWavePart.outgoing j t f x ω
          + waveIntegrand hφone hφzero CoordinateWavePart.incoming j t f x ω)
        + waveIntegrand hφone hφzero CoordinateWavePart.middle j t f x ω := by
    intro ω
    rw [Auto.Spherical.FractalDilations.AHRSUpperBounds.fourier_dyadicBandpassProjection,
      surfaceFourier_two_neg_smul_eq_planarCoordinateSurfaceWaveSum ht ω,
      planarCoordinateSurfaceWaveSum_eq_three_radialTerms t ‖ω‖, waveIntegrand, waveIntegrand,
      waveIntegrand]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hsplit), integral_add hAB hC,
    integral_add hA hB, waveInt_eq_integral, waveInt_eq_integral, waveInt_eq_integral]

/-! ### Measurability of the sector maximal functions, and Minkowski for finite sums -/

theorem continuous_TopS_param {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    Continuous fun t : ℝ => (TopS hm ε t f : Pl → ℂ) x :=
  continuous_iff_continuousAt.mpr fun t => (hasDerivAt_TopS hm hmt hmd t f x).continuousAt

theorem measurable_iSup_TopS {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (E : Set ℝ) (f : SchwartzMap Pl ℂ) :
    Measurable fun x : Pl => ⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ := by
  have hEq : (fun x : Pl => ⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ)
      = ⨆ t : E, fun x : Pl => ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ := by
    funext x
    exact (iSup_apply
      (f := fun t : E => fun x : Pl => ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) (a := x)).symm
  rw [hEq]
  refine measurable_iSup_of_lowerSemicontinuous ?_ ?_
  · intro t
    exact ((TopS hm ε t.1 f : SchwartzMap Pl ℂ).continuous.enorm).measurable
  · intro x
    exact (((continuous_TopS_param hm hmt hmd f x).comp
      continuous_subtype_val).enorm).lowerSemicontinuous

/-- **Minkowski's inequality for a finite sum**, in the extended-nonnegative setting. -/
theorem lintegral_rpow_finset_sum_le {ι : Type*} (s : Finset ι) (g : ι → Pl → ℝ≥0∞)
    (hg : ∀ i ∈ s, AEMeasurable (g i) (volume : Measure Pl)) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : Pl, (∑ i ∈ s, g i) x ^ r) ^ (1 / r)
      ≤ ∑ i ∈ s, (∫⁻ x : Pl, g i x ^ r) ^ (1 / r) := by
  classical
  have hrpos : (0 : ℝ) < r := by linarith
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty, Pi.zero_apply, ENNReal.zero_rpow_of_pos hrpos,
        lintegral_zero]
      rw [ENNReal.zero_rpow_of_pos (by positivity : (0 : ℝ) < 1 / r)]
  | insert a s ha ih =>
      have hgs : AEMeasurable (∑ i ∈ s, g i) (volume : Measure Pl) := by
        refine Finset.aemeasurable_sum s fun i hi => hg i (Finset.mem_insert_of_mem hi)
      have hga : AEMeasurable (g a) (volume : Measure Pl) := hg a (Finset.mem_insert_self a s)
      have hsum : (∑ i ∈ insert a s, g i) = g a + ∑ i ∈ s, g i := Finset.sum_insert ha
      rw [hsum, Finset.sum_insert ha]
      refine le_trans (ENNReal.lintegral_Lp_add_le hga hgs hr) ?_
      exact add_le_add (le_refl _) (ih fun i hi => hg i (Finset.mem_insert_of_mem hi))

theorem lintegral_rpow_const_mul {c : ℝ≥0∞} (hc : c ≠ ⊤) (g : Pl → ℝ≥0∞) {r : ℝ}
    (hr : 0 < r) :
    (∫⁻ x : Pl, (c * g x) ^ r) ^ (1 / r) = c * (∫⁻ x : Pl, g x ^ r) ^ (1 / r) := by
  have h1 : ∀ x : Pl, (c * g x) ^ r = c ^ r * g x ^ r := fun x =>
    ENNReal.mul_rpow_of_nonneg _ _ hr.le
  have hcr : c ^ r ≠ ⊤ := by
    exact ENNReal.rpow_ne_top_of_nonneg hr.le hc
  rw [lintegral_congr h1, lintegral_const_mul' _ _ hcr,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / r), ← ENNReal.rpow_mul,
    mul_one_div, div_self hr.ne', ENNReal.rpow_one]

theorem lintegral_enorm_rpow_rotSch (α : ℝ) (f : SchwartzMap Pl ℂ) {r : ℝ} :
    (∫⁻ x : Pl, ‖(rotSch α f : Pl → ℂ) x‖ₑ ^ r) = ∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ r := by
  have hmeas : Measurable fun y : Pl => ‖(f : Pl → ℂ) y‖ₑ ^ r :=
    (f.continuous.enorm.measurable).pow_const r
  have h := lintegral_comp_rotF α hmeas
  rw [← h]
  rfl

