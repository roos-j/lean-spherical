    {I X : Type*} [DecidableEq I]
    (s : Finset I) (hs : s.Nonempty) (f : I → X → ℂ) : X → ℝ :=
  fun x => s.sup' hs (fun i => ‖f i x‖)

/-- A finite maximum is controlled pointwise by the `q`-moment of its
fibres.  This is valid for every real exponent because real powers of
nonnegative numbers are nonnegative; in the application `q > 1`. -/
theorem q4FiniteProductMaximal_rpow_le_fibreSum
    {I X : Type*} [DecidableEq I]
    (s : Finset I) (hs : s.Nonempty) (q : ℝ) (f : I → X → ℂ) (x : X) :
    q4FiniteProductMaximal s hs f x ^ q ≤
      ∑ i ∈ s, ‖f i x‖ ^ q := by
  rcases s.exists_mem_eq_sup' hs (fun i => ‖f i x‖) with ⟨i, hi, himax⟩
  unfold q4FiniteProductMaximal
  rw [himax]
  exact Finset.single_le_sum (f := fun k => ‖f k x‖ ^ q)
