    (d : ℕ) {r R : ℝ}
    (hrone : 1 ≤ r) (hrtwo : r ≤ 2) (hR : 0 < R) (hRhalf : R ≤ 1 / 2) :
    volume (radialAnnulus d r R) ≤
      ENNReal.ofReal ((2 * (d : ℝ) * 3 ^ (d - 1)) * R) *
        volume (ball (0 : Euclidean d) 1) := by
