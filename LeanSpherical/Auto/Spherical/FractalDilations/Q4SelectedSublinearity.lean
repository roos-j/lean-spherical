/-- The natural input domain on which a selected literal kernel shell is
subadditive.  Its condition is exactly the pairwise integrability needed to
use Bochner integral linearity. -/
def q4SelectedShellDomain
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (_s : Finset I) (_R : I → I → Prop) [DecidableRel _R]
    (K : I → I → X → ℂ) (rho : X → I) : Set (X → ℂ) :=
  {f | ∀ i l x, Integrable
    (fun y => K i l (x - y) * q4SelectedFibre rho f l y) μ}

/-- Selecting a hard low cutoff fibrewise is the same as applying that
cutoff to each selected fibre. -/
theorem q4SelectedFibre_powerCutoffLow
    {I X : Type*} [DecidableEq I]
    (rho : X → I) (p K t : ℝ) (f : X → ℂ) (l : I) (y : X) :
    q4SelectedFibre rho (q4PowerCutoffLow p K t f) l y =
      ({y | t * ‖f y‖ ^ (p - 1) ≤ K}.indicator
        (q4SelectedFibre rho f l) y) := by
  by_cases hrho : rho y = l <;>
    by_cases hcut : t * ‖f y‖ ^ (p - 1) ≤ K <;>
      simp [q4SelectedFibre, q4PowerCutoffLow, hrho, hcut]

/-- Likewise, a hard high cutoff is the complementary selected fibre. -/
theorem q4SelectedFibre_powerCutoffHigh
    {I X : Type*} [DecidableEq I]
    (rho : X → I) (p K t : ℝ) (f : X → ℂ) (l : I) (y : X) :
    q4SelectedFibre rho (q4PowerCutoffHigh p K t f) l y =
      ({y | ¬ t * ‖f y‖ ^ (p - 1) ≤ K}.indicator
        (q4SelectedFibre rho f l) y) := by
  by_cases hrho : rho y = l
  · by_cases hcut : t * ‖f y‖ ^ (p - 1) ≤ K
    · simp [q4SelectedFibre, q4PowerCutoffHigh, q4PowerCutoffLow, hrho, hcut]
    · have hmem : y ∈ {y | ¬ t * ‖f y‖ ^ (p - 1) ≤ K} := hcut
      rw [Set.indicator_of_mem hmem]
      simp [q4SelectedFibre, q4PowerCutoffHigh, q4PowerCutoffLow, hrho, hcut]
  · have hleft : q4SelectedFibre rho (q4PowerCutoffHigh p K t f) l y = 0 := by
      simp [q4SelectedFibre, hrho]
    have hright : q4SelectedFibre rho f l y = 0 := by
      simp [q4SelectedFibre, hrho]
    rw [hleft]
    simp only [Set.indicator_apply]
    by_cases hmem : y ∈ {y | ¬ t * ‖f y‖ ^ (p - 1) ≤ K} <;>
      simp [hright]

/-- The natural literal-shell domain is closed under the low hard cutoff.
This is just integrability of a measurable indicator of each pairwise
integrand. -/
theorem q4PowerCutoffLow_mem_q4SelectedShellDomain
    {I X : Type*} [Sub X] [MeasurableSpace X] [DecidableEq I]
    (μ : Measure X) (s : Finset I) (R : I → I → Prop) [DecidableRel R]
    (Kern : I → I → X → ℂ) (rho : X → I)
    {p : ℝ} (hp1 : 1 < p) (K t : ℝ) (f : X → ℂ)
    (hfmeas : Measurable f)
    (hf : f ∈ q4SelectedShellDomain μ s R Kern rho) :
    q4PowerCutoffLow p K t f ∈ q4SelectedShellDomain μ s R Kern rho := by
  let P : Set X := {y | t * ‖f y‖ ^ (p - 1) ≤ K}
  have hpminus : 0 < p - 1 := by linarith
  have hpow : Measurable (fun y => ‖f y‖ ^ (p - 1)) :=
    (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hfmeas.norm
  have hP : MeasurableSet P := by
    exact measurableSet_le (measurable_const.mul hpow) measurable_const
  intro i l x
  have hfun : (fun y => Kern i l (x - y) *
      q4SelectedFibre rho (q4PowerCutoffLow p K t f) l y) =
      P.indicator (fun y => Kern i l (x - y) * q4SelectedFibre rho f l y) := by
    funext y
    rw [q4SelectedFibre_powerCutoffLow]
    simp only [P, Set.indicator_apply]
    by_cases hy : t * ‖f y‖ ^ (p - 1) ≤ K <;> simp [hy]
  rw [hfun]
  exact (hf i l x).indicator hP

