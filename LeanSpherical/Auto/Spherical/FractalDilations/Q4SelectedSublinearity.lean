/-- Chebyshev in the exact extended-real form consumed by the crossed
interpolation lemma.  It converts a proved real square-energy estimate for a
literal shell into a weak square estimate. -/
theorem q4_weak_two_of_square_energy
    {α E F : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [NormedAddCommGroup F] {μ : Measure α}
    (f : α → E) (G : α → F)
    (hGmeas : AEMeasurable (fun x => ‖G x‖) μ)
    (hGint : Integrable (fun x => ‖G x‖ ^ (2 : ℕ)) μ)
    (hfint : Integrable (fun x => ‖f x‖ ^ (2 : ℕ)) μ)
    {B : ℝ} (hB : 0 ≤ B)
    (henergy : (∫ x, ‖G x‖ ^ (2 : ℕ) ∂μ) ≤
      B * ∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ)
    {s : ℝ} (hs : 0 < s) :
    ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < ‖G x‖} ≤
      ENNReal.ofReal B *
        (∫⁻ x, ENNReal.ofReal (‖f x‖ ^ (2 : ℕ)) ∂μ) := by
  have hCheb :
      ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < ‖G x‖} ≤
        ENNReal.ofReal (B * ∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ) := by
    calc
      ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < ‖G x‖} ≤
          ENNReal.ofReal (s ^ (2 : ℕ)) *
            μ {x | ENNReal.ofReal (s ^ (2 : ℕ)) ≤
              ENNReal.ofReal (‖G x‖ ^ (2 : ℕ))} := by
          apply mul_le_mul_right
          apply measure_mono
          intro x hx
          exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ hs.le hx.le 2)
      _ ≤ ∫⁻ x, ENNReal.ofReal (‖G x‖ ^ (2 : ℕ)) ∂μ :=
        mul_meas_ge_le_lintegral₀ (hGmeas.pow_const 2).ennreal_ofReal
          (ENNReal.ofReal (s ^ (2 : ℕ)))
      _ = ENNReal.ofReal (∫ x, ‖G x‖ ^ (2 : ℕ) ∂μ) := by
        symm
        exact ofReal_integral_eq_lintegral_ofReal hGint
          (Filter.Eventually.of_forall fun x => sq_nonneg (‖G x‖))
      _ ≤ ENNReal.ofReal (B * ∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ) :=
        ENNReal.ofReal_le_ofReal henergy
  have hinput :
      (∫⁻ x, ENNReal.ofReal (‖f x‖ ^ (2 : ℕ)) ∂μ) =
        ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ) := by
    symm
    exact ofReal_integral_eq_lintegral_ofReal hfint
      (Filter.Eventually.of_forall fun x => sq_nonneg (‖f x‖))
  calc
    ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < ‖G x‖} ≤
        ENNReal.ofReal (B * ∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ) := hCheb
    _ = ENNReal.ofReal B * ENNReal.ofReal (∫ x, ‖f x‖ ^ (2 : ℕ) ∂μ) := by
      rw [ENNReal.ofReal_mul hB]
    _ = ENNReal.ofReal B *
        (∫⁻ x, ENNReal.ofReal (‖f x‖ ^ (2 : ℕ)) ∂μ) := by rw [hinput]

/-- Integrability of the squared norm supplies the measurability of the norm
needed by the crossed layer-cake argument. -/
theorem aemeasurable_norm_of_integrable_sq
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} (G : α → E)
    (hG : Integrable (fun x => ‖G x‖ ^ (2 : ℕ)) μ) :
    AEMeasurable (fun x => ‖G x‖) μ := by
  have hsq : AEMeasurable (fun x => ‖G x‖ ^ (2 : ℕ)) μ :=
    hG.aestronglyMeasurable.aemeasurable
  have hsqrt : AEMeasurable (fun x => Real.sqrt (‖G x‖ ^ (2 : ℕ))) μ :=
    Real.continuous_sqrt.measurable.comp_aemeasurable hsq
  simpa only [Real.sqrt_sq_eq_abs, abs_of_nonneg (norm_nonneg _)] using hsqrt

