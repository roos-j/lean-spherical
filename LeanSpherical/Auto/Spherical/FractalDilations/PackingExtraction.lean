theorem exists_upperMinkowski_strictlySeparated_power_lower_witness_at_small_scale
    {E : Set ℝ} {α β : ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hdimension : upperMinkowskiDimension E = β)
    (hα0 : 0 ≤ α) (hαβ : α < β) :
    ∀ C : ℝ, 0 < C → ∀ δ₀ : ℝ, 0 < δ₀ →
      ∃ δ : ℝ, ∃ s : Finset ℝ,
        0 < δ ∧ δ < δ₀ ∧ δ < 1 ∧ (↑s : Set ℝ) ⊆ E ∧
          StrictlySeparated s δ ∧ C * δ ^ (-α) < (s.card : ℝ) := by
  intro C hC δ₀ hδ₀
  let C' : ℝ := C * 2 ^ α
  have hC' : 0 < C' := by
    dsimp [C']
    exact mul_pos hC (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨Δ, hΔ, hΔsmall, hΔone, hlarge⟩ :=
    exists_upperMinkowski_coveringNumber_power_lower_witness_at_small_scale
      hE hdimension hα0 hαβ C' hC' (2 * δ₀) (by positivity)
