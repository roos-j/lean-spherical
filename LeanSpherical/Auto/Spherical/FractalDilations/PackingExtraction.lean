      dsimp [C₀]
      exact le_max_left _ _)
    have hCC₀ : C ≤ C₀ := by
      dsimp [C₀]
      exact le_max_left _ _
    have hcardC₀ : (ι₀.card : ℝ) ≤ C₀ := by
      calc
        (ι₀.card : ℝ) ≤ (ι₀.card : ℝ) + 1 := by linarith
