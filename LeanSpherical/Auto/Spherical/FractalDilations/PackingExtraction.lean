/-- Every bounded radius set has a finite strictly `δ`-separated family whose
cardinality dominates its interval covering number at scale `2δ`. -/
theorem exists_strictlySeparated_finset_card_ge_intervalCoveringNumber
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ} (hδ : 0 < δ) :
    ∃ s : Finset ℝ, (↑s : Set ℝ) ⊆ E ∧ StrictlySeparated s δ ∧
      (intervalCoveringNumber E (2 * δ) : ℝ) ≤ s.card := by
  let ε : ℝ≥0 := ⟨δ, hδ.le⟩
  have hεcoe : (↑ε : ℝ≥0∞) = ENNReal.ofReal δ := by
    rw [ENNReal.coe_nnreal_eq]
    congr 1
  have htot : TotallyBounded E := (totallyBounded_Icc (1 : ℝ) 2).subset hE
  have hεpos : 0 < ε := by
    change 0 < δ
    exact hδ
  have hεhalf : ε / 2 ≠ 0 := by
    apply div_ne_zero
    · exact ne_of_gt hεpos
    · norm_num
  obtain ⟨N, hNE, hNfinite, hNcover⟩ :=
    Metric.exists_finite_isCover_of_totallyBounded hεhalf htot
  have hExt : Metric.externalCoveringNumber (ε / 2) E ≠ ⊤ := by
    apply ne_top_of_le_ne_top (Set.encard_lt_top_iff.mpr hNfinite).ne
    exact hNcover.externalCoveringNumber_le_encard
  have hpackle : Metric.packingNumber ε E ≤ Metric.externalCoveringNumber (ε / 2) E := by
    have hdouble : 2 * (ε / 2) = ε := by
      ext
      simp only [NNReal.coe_mul, NNReal.coe_ofNat, NNReal.coe_div]
      ring
    have hbase := Metric.packingNumber_two_mul_le_externalCoveringNumber (ε / 2) E
    rw [hdouble] at hbase
    exact hbase
  have hpack : Metric.packingNumber ε E ≠ ⊤ :=
    ne_top_of_le_ne_top hExt hpackle
  let S : Set ℝ := Metric.maximalSeparatedSet ε E
  have hSfinite : S.Finite := by
    apply Set.encard_lt_top_iff.mp
    rw [show S = Metric.maximalSeparatedSet ε E by rfl,
      Metric.encard_maximalSeparatedSet hpack]
    exact lt_top_iff_ne_top.mpr hpack
  let s : Finset ℝ := hSfinite.toFinset
  have hsS : (↑s : Set ℝ) = S := hSfinite.coe_toFinset
  refine ⟨s, ?_, ?_, ?_⟩
  · rw [hsS]
    exact Metric.maximalSeparatedSet_subset
  · intro x y hx hy hxy
    have hsep : Metric.IsSeparated (↑ε : ℝ≥0∞) S := by
      simpa only [S] using (Metric.isSeparated_maximalSeparatedSet (ε := ε) (A := E))
    have hxS : x ∈ S := by
      rw [← hsS]
      exact hx
    have hyS : y ∈ S := by
      rw [← hsS]
      exact hy
    have hED : (↑ε : ℝ≥0∞) < edist x y := hsep hxS hyS hxy
    have hED' : ENNReal.ofReal δ < ENNReal.ofReal (dist x y) := by
      rw [hεcoe] at hED
      simpa only [edist_dist] using hED
    have hdist : δ < dist x y :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hδ.le).mp hED'
    simpa only [Real.dist_eq] using hdist
  · have hcover : IsIntervalCover E (2 * δ) s := by
      intro x hx
      obtain ⟨y, hyS, hxy⟩ := Metric.isCover_maximalSeparatedSet hpack hx
      have hy : y ∈ s := by
        change y ∈ (↑s : Set ℝ)
        rw [hsS]
        simpa only [S] using hyS
      have hxy' : dist x y ≤ δ := by
        change edist x y ≤ (↑ε : ℝ≥0∞) at hxy
        have hxy' : ENNReal.ofReal (dist x y) ≤ ENNReal.ofReal δ := by
          rw [hεcoe] at hxy
          simpa only [edist_dist] using hxy
        exact (ENNReal.ofReal_le_ofReal_iff hδ.le).mp hxy'
      refine Set.mem_iUnion.2 ⟨y, Set.mem_iUnion.2 ⟨hy, ?_⟩⟩
      rw [show (2 * δ) / 2 = δ by ring]
      rw [Real.dist_eq] at hxy'
      rw [abs_le] at hxy'
      exact ⟨by linarith, by linarith⟩
    exact_mod_cast intervalCoveringNumber_le_card hcover

/-- A strict gap below the upper Minkowski dimension yields arbitrarily fine
finite separated radius families with the corresponding power lower bound.
This is the form of the covering witness used by the small-ball/annulus
sharpness construction. -/
theorem exists_upperMinkowski_strictlySeparated_lower_witness_at_small_scale
    {E : Set ℝ} {α β : ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hdimension : upperMinkowskiDimension E = β)
    (hα0 : 0 ≤ α) (hαβ : α < β) :
    ∃ η : ℝ, 0 < η ∧ ∀ C : ℝ, 0 < C → ∀ δ₀ : ℝ, 0 < δ₀ →
      ∃ δ : ℝ, ∃ s : Finset ℝ,
        0 < δ ∧ δ < δ₀ ∧ δ < 1 ∧ (↑s : Set ℝ) ⊆ E ∧
          StrictlySeparated s δ ∧
          C * δ ^ (-(α + η)) < (s.card : ℝ) := by
  obtain ⟨η, hη, hwitness⟩ :=
    exists_upperMinkowski_coveringNumber_lower_witness_at_small_scale
      hE hdimension hα0 hαβ
  refine ⟨η, hη, ?_⟩
  intro C hC δ₀ hδ₀
  let C' : ℝ := C * 2 ^ (α + η)
  have hC' : 0 < C' := by
    dsimp [C']
    exact mul_pos hC (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨Δ, hΔ, hΔsmall, hΔone, hlarge⟩ :=
    hwitness C' hC' (2 * δ₀) (by positivity)
  obtain ⟨s, hsE, hssep, hcard⟩ :=
    exists_strictlySeparated_finset_card_ge_intervalCoveringNumber hE
      (δ := Δ / 2) (by positivity)
  refine ⟨Δ / 2, s, by positivity, by linarith, by linarith, hsE, hssep, ?_⟩
  have hcard' : (intervalCoveringNumber E Δ : ℝ) ≤ (s.card : ℝ) := by
    convert hcard using 1 <;> ring
  calc
    C * (Δ / 2) ^ (-(α + η)) =
        C * (2 ^ (α + η) * Δ ^ (-(α + η))) := by
      rw [Real.div_rpow hΔ.le (by norm_num : (0 : ℝ) ≤ 2)]
      rw [div_eq_mul_inv, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), inv_inv]
      ring
    _ = C' * Δ ^ (-(α + η)) := by
      dsimp [C']
      ring
    _ < (intervalCoveringNumber E Δ : ℝ) := hlarge
    _ ≤ (s.card : ℝ) := hcard'

