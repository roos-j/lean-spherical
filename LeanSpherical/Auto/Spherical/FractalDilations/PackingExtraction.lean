    dsimp [δstar]
    exact lt_min hδ₀ zero_lt_one
  have hδstar_le : δstar ≤ δ₀ := by
    dsimp [δstar]
    exact min_le_left _ _
  have hδstar_one : δstar ≤ 1 := by
    dsimp [δstar]
    exact min_le_right _ _
