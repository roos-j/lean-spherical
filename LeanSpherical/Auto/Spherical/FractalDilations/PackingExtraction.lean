    exists_strictlySeparated_finset_card_ge_intervalCoveringNumber hE
      (δ := Δ / 2) (by positivity)
  refine ⟨Δ / 2, s, by positivity, by linarith, by linarith, hsE, hssep, ?_⟩
  have hcard' : (intervalCoveringNumber E Δ : ℝ) ≤ (s.card : ℝ) := by
    convert hcard using 1 <;> ring
  calc
    C * (Δ / 2) ^ (-α) = C * (2 ^ α * Δ ^ (-α)) := by
      rw [Real.div_rpow hΔ.le (by norm_num : (0 : ℝ) ≤ 2)]
      rw [div_eq_mul_inv, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), inv_inv]
