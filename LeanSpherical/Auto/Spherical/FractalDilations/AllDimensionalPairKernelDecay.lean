    {d k : Nat} {s a lambda C L : Real}
    (hd : 2 ≤ d) (hs : 1 ≤ s) (hC : 0 ≤ C) (hL : 0 ≤ L)
    (ha : |a| ≤ L * s) (hlambda : s ≤ lambda) :
    C * |a| ^ k / lambda ^ (d + k) ≤
      (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
