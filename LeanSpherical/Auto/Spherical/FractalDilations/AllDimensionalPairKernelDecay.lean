  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hspos hlambda
  have hnum : C * |a| ^ k ≤ C * (L * s) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  have hden : s ^ (d + k) ≤ lambda ^ (d + k) :=
    pow_le_pow_left₀ hs0 hlambda _
  have hsdenpos : 0 < s ^ (d + k) := pow_pos hspos _
  have hlambdadenpos : 0 < lambda ^ (d + k) := pow_pos hlambdapos _
  have hquot : C * |a| ^ k / lambda ^ (d + k) ≤
      C * (L * s) ^ k / s ^ (d + k) := by
    calc
      C * |a| ^ k / lambda ^ (d + k) ≤
          C * (L * s) ^ k / lambda ^ (d + k) :=
        div_le_div_of_nonneg_right hnum hlambdadenpos
      _ ≤ C * (L * s) ^ k / s ^ (d + k) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (pow_nonneg (mul_nonneg hL hs0) _))
          hsdenpos hden
  have hsqrts : Real.sqrt s ≤ s := (Real.sqrt_le_self_iff).2 (Or.inr hs)
  have hrootpow : (Real.sqrt s) ^ (d - 1) ≤ s ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrts _
  have hsd : s ^ (d - 1) ≤ s ^ d := by
    calc
      s ^ (d - 1) = s ^ (d - 1) * 1 := by ring
      _ ≤ s ^ (d - 1) * s := by
        exact mul_le_mul_of_nonneg_left hs (pow_nonneg hs0 _)
      _ = s ^ d := by
        rw [show d = (d - 1) + 1 by omega, pow_add]
        ring
  have hrootden : (Real.sqrt s) ^ (d - 1) ≤ s ^ d := hrootpow.trans hsd
  have hrootpos : 0 < (Real.sqrt s) ^ (d - 1) :=
    pow_pos (Real.sqrt_pos.2 hspos) _
  calc
    C * |a| ^ k / lambda ^ (d + k) ≤ C * (L * s) ^ k / s ^ (d + k) := hquot
    _ = (C * L ^ k) / s ^ d := by
      rw [mul_pow, show d + k = k + d by omega, pow_add]
      field_simp [hspos.ne']
      ring
    _ ≤ (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
      apply div_le_div_of_nonneg_left
      · exact mul_nonneg hC (pow_nonneg hL _)
      · exact hrootpos
      · exact hrootden

