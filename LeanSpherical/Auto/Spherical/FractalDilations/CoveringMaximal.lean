/-- A finite interval cover of the radius set dominates its spherical
maximal operator by the supremum of the interval maximal operators. -/
theorem fractalSphericalMaximal_le_iSup_intervalCover
    {d : ℕ} {E : Set ℝ} {δ : ℝ} {ι : Finset ℝ}
    (hcover : IsIntervalCover E δ ι)
    (f : Euclidean d → ℂ) (x : Euclidean d) :
    fractalSphericalMaximal d E f x ≤
      ⨆ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x := by
  apply iSup_le
  intro t
  have htcover : t.1 ∈ ⋃ c ∈ ι, Icc (c - δ / 2) (c + δ / 2) :=
    hcover t.2
  rcases Set.mem_iUnion.mp htcover with ⟨c, htcover⟩
  rcases Set.mem_iUnion.mp htcover with ⟨hc, hct⟩
  calc
    ENNReal.ofReal ‖normalizedSphericalAverage d f t.1 x‖ ≤
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x :=
      le_iSup (fun r : Icc (c - δ / 2) (c + δ / 2) =>
        ENNReal.ofReal ‖normalizedSphericalAverage d f r.1 x‖) ⟨t.1, hct⟩
    _ ≤ ⨆ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x :=
      le_iSup_of_le c (le_iSup_of_le hc le_rfl)

/-- The finite supremum on the right of the cover reduction is bounded by
the corresponding finite sum. -/
