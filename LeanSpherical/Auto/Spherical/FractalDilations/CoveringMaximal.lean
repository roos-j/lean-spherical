  · exact hc

/-- Combining the two elementary reductions gives a finite-sum majorant for
the maximal operator over any interval-covered radius set. -/
theorem fractalSphericalMaximal_le_sum_intervalCover
    {d : ℕ} {E : Set ℝ} {δ : ℝ} {ι : Finset ℝ}
