    rw [← abs_of_nonneg (add_nonneg (norm_nonneg _) (le_trans zero_le_one hr)),
      ← abs_mul]
    convert h using 1 <;> ring
  calc
    |‖y‖ - r| = |‖y‖ - r| * 1 := by ring
    _ ≤ |‖y‖ - r| * (‖y‖ + r) :=
      mul_le_mul_of_nonneg_left hsum (abs_nonneg _)
    _ ≤ δ := hfac

