  have hθ0 : 0 ≤ θ := InnerProductGeometry.angle_nonneg x y
  have hcos : Real.cos θ * (‖x‖ * ‖y‖) = inner ℝ x y :=
    InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
  have hsin : det2 x y ^ 2 = (‖x‖ * ‖y‖) ^ 2 * Real.sin θ ^ 2 := by
    rw [lagrange, ← hcos]
    have := Real.sin_sq_add_cos_sq θ
    nlinarith [this]
