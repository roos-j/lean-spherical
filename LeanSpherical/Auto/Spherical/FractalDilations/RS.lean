/-! ## §4.1  The operator `S[F, b]` -/

/-- The unimodular phase `e^{± 2π i t (|ξ - η| + |η|)}` of §4. -/
def phase (ε t : ℝ) (ξ η : Pl) : ℂ :=
  Complex.exp (((2 * Real.pi * ε * t * (‖ξ - η‖ + ‖η‖) : ℝ) : ℂ) * Complex.I)

@[simp] theorem norm_phase (ε t : ℝ) (ξ η : Pl) : ‖phase ε t ξ η‖ = 1 := by
  rw [phase, Complex.norm_exp_ofReal_mul_I]

/-- A `(j,m)`-adapted symbol: it vanishes unless `η, ξ - η ∈ Θ_j` and `∠(ξ,η) ≤ 2^{-m+5}`. -/
structure IsAdapted (j m : ℕ) (b : ℝ → Pl → Pl → ℂ) : Prop where
  meas : ∀ t ξ, Measurable (b t ξ)
  supp : ∀ t ξ η, η ∉ SuppSet j m ξ → b t ξ η = 0

/-- The operator `S[F,b]` of §4, written in terms of `G = 𝓕 F`. -/
def SopK (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (G : Pl2 → ℂ) (ξ : Pl) (t : ℝ) : ℂ :=
  ∫ η, phase ε t ξ η * b t ξ η * G (pr (ξ - η) η)

/-! ### The shift change of variables -/

theorem measurable_pr_shift {h : Pl2 → ℝ≥0∞} (hh : Measurable h) :
    Measurable fun p : Pl × Pl => h (pr (p.1 - p.2) p.2) := by
  have h1 : Measurable fun p : Pl × Pl => ((p.1 - p.2 : Pl), p.2) :=
    (measurable_fst.sub measurable_snd).prodMk measurable_snd
  have h2 : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
    have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact hh.comp this
  exact h2.comp h1

theorem lintegral_pr (h : Pl2 → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ u : Pl, ∫⁻ η : Pl, h (pr u η)) = ∫⁻ x : Pl2, h x := by
  have hmeas : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
    have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
      (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
    exact hh.comp this
  have hstep : (∫⁻ u : Pl, ∫⁻ η : Pl, h (pr u η))
      = ∫⁻ q : Pl × Pl, h (pr q.1 q.2) ∂(volume.prod volume) :=
    lintegral_lintegral hmeas.aemeasurable
  rw [hstep, ← Measure.volume_eq_prod]
  exact (WithLp.volume_preserving_toLp (U := Pl) (V := Pl)).lintegral_comp hh

theorem lintegral_pr_shift (h : Pl2 → ℝ≥0∞) (hh : Measurable h) :
    (∫⁻ ξ : Pl, ∫⁻ η : Pl, h (pr (ξ - η) η)) = ∫⁻ x : Pl2, h x := by
  have hswap : (∫⁻ ξ : Pl, ∫⁻ η : Pl, h (pr (ξ - η) η))
      = ∫⁻ η : Pl, ∫⁻ ξ : Pl, h (pr (ξ - η) η) :=
    lintegral_lintegral_swap (measurable_pr_shift hh).aemeasurable
  have hinner : ∀ η : Pl, (∫⁻ ξ : Pl, h (pr (ξ - η) η)) = ∫⁻ u : Pl, h (pr u η) := by
    intro η
    exact lintegral_sub_right_eq_self (fun u : Pl => h (pr u η)) η
  rw [hswap, lintegral_congr hinner]
  rw [← lintegral_pr h hh]
  refine lintegral_lintegral_swap ?_
  have hmeas : Measurable fun q : Pl × Pl => h (pr q.2 q.1) := by
    have h1 : Measurable fun q : Pl × Pl => ((q.2 : Pl), (q.1 : Pl)) :=
      measurable_snd.prodMk measurable_fst
    have h2 : Measurable fun q : Pl × Pl => h (pr q.1 q.2) := by
      have : Measurable fun q : Pl × Pl => (WithLp.toLp 2 q : Pl2) :=
        (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
      exact hh.comp this
    exact h2.comp h1
  exact hmeas.aemeasurable

/-! ### Proposition 4.1: the trivial estimate -/

/-- The pointwise Cauchy--Schwarz bound behind Proposition 4.1. -/
theorem enorm_SopK_sq_le {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε t : ℝ) {G : Pl2 → ℂ} (hG : Measurable G) (ξ : Pl) :
    ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ)
      ≤ ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ η : Pl, ‖G (pr (ξ - η) η)‖ₑ ^ (2 : ℝ) := by
  classical
  set f : Pl → ℂ := fun η => G (pr (ξ - η) η) with hf
  have hfmeas : Measurable f := by
    have h1 : Measurable fun η : Pl => (pr (ξ - η) η : Pl2) := by
      have h2 : Measurable fun η : Pl => ((ξ - η : Pl), (η : Pl)) :=
        (measurable_const.sub measurable_id).prodMk measurable_id
      exact (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable.comp h2
    exact hG.comp h1
  -- step 1: the triangle inequality
  have hstep1 : ‖SopK ε b G ξ t‖ₑ ≤ ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ := by
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun η => ?_
    rw [enorm_mul, enorm_mul, ← ofReal_norm, norm_phase, ENNReal.ofReal_one, one_mul]
  -- step 2: Cauchy--Schwarz
  have hstep2 : (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ) ^ (2 : ℝ)
      ≤ (∫⁻ η, ‖b t ξ η‖ₑ) * ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ) :=
    Auto.CalderonVaillancourt.lintegral_enorm_mul_sq_le (K := fun (_ : Pl) η => b t ξ η)
      (f := f) ξ (hb.meas t ξ).aemeasurable hfmeas.aemeasurable
  -- step 3: the mass of the symbol
  have hmass : (∫⁻ η, ‖b t ξ η‖ₑ) ≤ ENNReal.ofReal B *
      ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) := by
    have hmono : ∀ η : Pl, ‖b t ξ η‖ₑ
        ≤ Set.indicator (SuppSet j m ξ) (fun _ => ENNReal.ofReal B) η := by
      intro η
      by_cases hη : η ∈ SuppSet j m ξ
      · rw [Set.indicator_of_mem hη, ← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hbB t ξ η)
      · rw [Set.indicator_of_notMem hη, hb.supp t ξ η hη]
        simp
    refine le_trans (lintegral_mono hmono) ?_
    rw [lintegral_indicator (measurableSet_SuppSet j m ξ), setLIntegral_const]
    exact mul_le_mul' (le_refl _) (volume_SuppSet_le j m ξ)
  -- step 4: pull the symbol bound out of the weighted square integral
  have hweight : (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal B * ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono fun η => ?_
    refine mul_le_mul' ?_ (le_refl _)
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hbB t ξ η)
  -- assemble
  calc ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ)
      ≤ (∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ) ^ (2 : ℝ) :=
        ENNReal.rpow_le_rpow hstep1 (by norm_num)
    _ ≤ (∫⁻ η, ‖b t ξ η‖ₑ) * ∫⁻ η, ‖b t ξ η‖ₑ * ‖f η‖ₑ ^ (2 : ℝ) := hstep2
    _ ≤ (ENNReal.ofReal B * ENNReal.ofReal ((2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12))) *
          (ENNReal.ofReal B * ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ)) := mul_le_mul' hmass hweight
    _ = ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ η, ‖f η‖ₑ ^ (2 : ℝ) := by
        rw [← ENNReal.ofReal_mul hB, ← mul_assoc,
          ← ENNReal.ofReal_mul
            (mul_nonneg hB (by positivity :
              (0:ℝ) ≤ (2:ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)))]
        congr 2
        ring

/-- **Proposition 4.1** (the trivial estimate), in the form `‖S[F,b]‖²_{L²(ℝ² × ℰ)} ≤
c B² 2^{2j-m} (#ℰ) ‖𝓕F‖²_{L²}`. -/
theorem prop41_K {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε : ℝ) (Efin : Finset ℝ) {G : Pl2 → ℂ} (hG : Measurable G) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ (Efin.card : ℝ≥0∞) *
        ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
  classical
  have hsq : Measurable fun x : Pl2 => ‖G x‖ₑ ^ (2 : ℝ) := (hG.enorm).pow_const _
  have hterm : ∀ t : ℝ, (∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
    intro t
    refine le_trans (lintegral_mono fun ξ => enorm_SopK_sq_le hB hb hbB ε t hG ξ) ?_
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine mul_le_mul' (le_refl _) ?_
    exact le_of_eq (lintegral_pr_shift (fun x => ‖G x‖ₑ ^ (2 : ℝ)) hsq)
  calc (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖SopK ε b G ξ t‖ₑ ^ (2 : ℝ))
      ≤ ∑ _t ∈ Efin, ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := Finset.sum_le_sum fun t _ => hterm t
    _ = (Efin.card : ℝ≥0∞) *
          ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
          ∫⁻ x : Pl2, ‖G x‖ₑ ^ (2 : ℝ) := by
        rw [Finset.sum_const, nsmul_eq_mul, mul_assoc]


/-! ### Plancherel on `ℝ⁴` -/

theorem eLpNorm_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    eLpNorm (𝓕 (F : Pl2 → ℂ)) 2 (volume : Measure Pl2)
      = eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) := by
  have hnorm : ‖SchwartzMap.toLp (𝓕 F) 2 (volume : Measure Pl2)‖
      = ‖SchwartzMap.toLp F 2 (volume : Measure Pl2)‖ := by
    rw [← SchwartzMap.toLp_fourier_eq F]
    exact MeasureTheory.Lp.norm_fourier_eq _
  rw [SchwartzMap.norm_toLp, SchwartzMap.norm_toLp] at hnorm
  have h1 : eLpNorm ((𝓕 F : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) 2 (volume : Measure Pl2) ≠ ⊤ :=
    ((𝓕 F : SchwartzMap Pl2 ℂ).memLp 2 (volume : Measure Pl2)).2.ne
  have h2 : eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) ≠ ⊤ :=
    (F.memLp 2 (volume : Measure Pl2)).2.ne
  have heq : eLpNorm ((𝓕 F : SchwartzMap Pl2 ℂ) : Pl2 → ℂ) 2 (volume : Measure Pl2)
      = eLpNorm ((F : Pl2 → ℂ)) 2 (volume : Measure Pl2) :=
    (ENNReal.toReal_eq_toReal_iff' h1 h2).mp hnorm
  rw [← SchwartzMap.fourier_coe F]
  exact heq

theorem lintegral_enorm_sq_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ x : Pl2, ‖𝓕 (F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have h1 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl2) (𝓕 (F : Pl2 → ℂ))
  have h2 := Auto.CalderonVaillancourt.sqMass_eq_eLpNorm_rpow
    (volume : Measure Pl2) ((F : Pl2 → ℂ))
  rw [Auto.CalderonVaillancourt.sqMass] at h1 h2
  rw [h1, h2, eLpNorm_fourier_schwartz]

theorem measurable_fourier_schwartz (F : SchwartzMap Pl2 ℂ) :
    Measurable (𝓕 (F : Pl2 → ℂ)) := by
  rw [← SchwartzMap.fourier_coe F]
  exact (𝓕 F : SchwartzMap Pl2 ℂ).continuous.measurable

/-! ### Proposition 4.1 in the paper's form -/

/-- The operator `S[F,b]` of §4:
`S[F,b](ξ,t) = ∫ e^{± 2π i t(|ξ-η| + |η|)} b(t,ξ,η) 𝓕F(ξ-η, η) dη`. -/
def Sop (ε : ℝ) (b : ℝ → Pl → Pl → ℂ) (F : Pl2 → ℂ) : Pl → ℝ → ℂ :=
  SopK ε b (𝓕 F)

/-- **Proposition 4.1** of Roos--Seeger (the trivial estimate).  If `b` is `(j,m)`-adapted with
`‖b‖_∞ ≤ B`, then for every finite set `ℰ` of radii,
`‖S[F,b]‖²_{L²(ℝ² × ℰ)} ≤ 2^{12} B² 2^{2j-m} (#ℰ) ‖F‖²_{L²(ℝ⁴)}`,
which is the squared form of the paper's `c B 2^{j-m/2} (#ℰ)^{1/2} ‖F‖_{L²(ℝ⁴)}`. -/
theorem prop41 {j m : ℕ} {b : ℝ → Pl → Pl → ℂ} {B : ℝ} (hB : 0 ≤ B)
    (hb : IsAdapted j m b) (hbB : ∀ t ξ η, ‖b t ξ η‖ ≤ B)
    (ε : ℝ) (Efin : Finset ℝ) (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ ξ : Pl, ‖Sop ε b (F : Pl2 → ℂ) ξ t‖ₑ ^ (2 : ℝ))
      ≤ (Efin.card : ℝ≥0∞) *
        ENNReal.ofReal (B ^ 2 * (2 : ℝ) ^ (2 * (j : ℤ) - (m : ℤ) + 12)) *
        ∫⁻ x : Pl2, ‖(F : Pl2 → ℂ) x‖ₑ ^ (2 : ℝ) := by
  have h := prop41_K hB hb hbB ε Efin (measurable_fourier_schwartz F)
  rw [lintegral_enorm_sq_fourier_schwartz F] at h
  exact h


/-! ## A one-dimensional non-stationary phase estimate

The engine of §4.3.  If the phase derivative `τ'` never vanishes and the amplitude `A` vanishes at
the two endpoints, then two integrations by parts gain a factor `λ^{-2}`.
-/

section NonStationary

/-- The oscillatory factor `e^{i λ τ}`. -/
def osc (lam τ : ℝ) : ℂ := Complex.exp (((lam * τ : ℝ) : ℂ) * Complex.I)

@[simp] theorem norm_osc (lam τ : ℝ) : ‖osc lam τ‖ = 1 := by
  rw [osc, Complex.norm_exp_ofReal_mul_I]

theorem hasDerivAt_osc {lam : ℝ} {τ : ℝ → ℝ} {c x : ℝ} (h : HasDerivAt τ c x) :
    HasDerivAt (fun y => osc lam (τ y)) (osc lam (τ x) * ((((lam * c : ℝ)) : ℂ) * Complex.I)) x := by
  have h1 : HasDerivAt (fun y => (((lam * τ y : ℝ)) : ℂ) * Complex.I)
      ((((lam * c : ℝ)) : ℂ) * Complex.I) x := by
    have h2 : HasDerivAt (fun y => ((lam * τ y : ℝ) : ℂ)) (((lam * c : ℝ) : ℂ)) x := by
      have h3 : HasDerivAt (fun y => lam * τ y) (lam * c) x := h.const_mul lam
      exact h3.ofReal_comp
    exact h2.mul_const Complex.I
  exact h1.cexp

theorem continuous_osc_comp {lam : ℝ} {τ : ℝ → ℝ} (hτ : Continuous τ) :
    Continuous fun y => osc lam (τ y) := by
  refine Complex.continuous_exp.comp ?_
  exact (Complex.continuous_ofReal.comp (continuous_const.mul hτ)).mul continuous_const

/-- One integration by parts against a nonvanishing phase derivative. -/
theorem integral_osc_ibp {a b lam : ℝ} (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ') (hτ'ne : ∀ x, τ' x ≠ 0)
    (hAc : Continuous A) (hBc : Continuous Bn)
    (hAB : ∀ x, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hAa : A a = 0) (hAb : A b = 0) :
    (∫ x in a..b, osc lam (τ x) * A x)
      = -(1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, osc lam (τ x) * Bn x := by
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  have hτc : Continuous τ := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ x).continuousAt
  set u : ℝ → ℂ := fun y => (A y / ((τ' y : ℝ) : ℂ)) / (((lam : ℝ) : ℂ) * Complex.I) with hu
  set v : ℝ → ℂ := fun y => osc lam (τ y) with hv
  have hud : ∀ x, HasDerivAt u (Bn x / (((lam : ℝ) : ℂ) * Complex.I)) x := fun x =>
    (hAB x).div_const _
  have hvd : ∀ x, HasDerivAt v (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I)) x := fun x =>
    hasDerivAt_osc (hτ x)
  -- the derivative of `u * v`
  have hkey : ∀ x, HasDerivAt (fun y => u y * v y)
      (v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) x := by
    intro x
    have h := (hud x).mul (hvd x)
    have hlamC' : ((lam : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hlam
    have heq : Bn x / (((lam : ℝ) : ℂ) * Complex.I) * v x +
        u x * (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I))
        = v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      have hτ'C : ((τ' x : ℝ) : ℂ) ≠ 0 := by
        exact_mod_cast hτ'ne x
      rw [hu]
      push_cast
      field_simp
      ring
    rw [heq] at h
    exact h
  -- the boundary terms vanish
  have hbdry : u b * v b - u a * v a = 0 := by
    simp [hu, hAa, hAb]
  have hintg : IntervalIntegrable
      (fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    refine Continuous.intervalIntegrable ?_ a b
    exact (continuous_osc_comp hτc).mul (hAc.add (hBc.div_const _))
  have hzero : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) = 0 := by
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun x _ => hkey x) hintg, hbdry]
  have hsplit : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      = (∫ x in a..b, v x * A x) +
        (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x := by
    have h1 : IntervalIntegrable (fun x => v x * A x) volume a b :=
      ((continuous_osc_comp hτc).mul hAc).intervalIntegrable a b
    have h2 : IntervalIntegrable (fun x => v x * Bn x) volume a b :=
      ((continuous_osc_comp hτc).mul hBc).intervalIntegrable a b
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_add h1 (h2.const_mul _)]
    refine intervalIntegral.integral_congr fun x _ => ?_
    field_simp
  rw [hsplit] at hzero
  have hres : (∫ x in a..b, v x * A x)
      = -((1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x) := by
    linear_combination hzero
  rw [hres]
  ring

/-- Two integrations by parts gain `λ^{-2}`. -/
theorem norm_integral_osc_ibp_twice {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn Cn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ') (hτ'ne : ∀ x, τ' x ≠ 0)
    (hAc : Continuous A) (hBc : Continuous Bn) (hCc : Continuous Cn)
    (hAB : ∀ x, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hBC : ∀ x, HasDerivAt (fun y => Bn y / ((τ' y : ℝ) : ℂ)) (Cn x) x)
    (hAa : A a = 0) (hAb : A b = 0) (hBa : Bn a = 0) (hBb : Bn b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖ ≤ (lam ^ 2)⁻¹ * ∫ x in a..b, ‖Cn x‖ := by
  have h1 := integral_osc_ibp hlam hτ hτ'c hτ'ne hAc hBc hAB hAa hAb
  have h2 := integral_osc_ibp hlam hτ hτ'c hτ'ne hBc hCc hBC hBa hBb
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hstep : ‖∫ x in a..b, osc lam (τ x) * A x‖
      = |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * Cn x‖) := by
    rw [h1, norm_mul, norm_neg, hnormlam, h2, norm_mul, norm_neg, hnormlam]
  rw [hstep]
  have hbound : ‖∫ x in a..b, osc lam (τ x) * Cn x‖ ≤ ∫ x in a..b, ‖Cn x‖ := by
    have hcont : Continuous fun x => osc lam (τ x) * Cn x := by
      have hτc : Continuous τ := continuous_iff_continuousAt.mpr fun x => (hτ x).continuousAt
      exact (continuous_osc_comp hτc).mul hCc
    have h := intervalIntegral.norm_integral_le_abs_integral_norm
      (f := fun x => osc lam (τ x) * Cn x) (a := a) (b := b) (μ := volume)
    refine le_trans h (le_of_eq ?_)
    rw [abs_of_nonneg]
    · refine intervalIntegral.integral_congr fun x _ => ?_
      rw [norm_mul, norm_osc, one_mul]
    · refine intervalIntegral.integral_nonneg hab fun x _ => ?_
      exact norm_nonneg _
  have hlamnn : (0 : ℝ) ≤ |lam|⁻¹ := by positivity
  have hsq : (lam ^ 2)⁻¹ = |lam|⁻¹ * |lam|⁻¹ := by
    have h : |lam| * |lam| = lam ^ 2 := by
      rw [← abs_mul, ← pow_two, abs_of_nonneg (sq_nonneg lam)]
    rw [← mul_inv, h]
  rw [hsq, mul_assoc]
  refine mul_le_mul_of_nonneg_left ?_ hlamnn
  exact mul_le_mul_of_nonneg_left hbound hlamnn

end NonStationary


/-! ## Polar coordinates on the plane -/

section Polar

/-- The coordinate constructor for the plane. -/
def mk2 (x y : ℝ) : Pl :=
  x • EuclideanSpace.single (0 : Fin 2) (1 : ℝ) + y • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)

@[simp] theorem mk2_apply_zero (x y : ℝ) : mk2 x y 0 = x := by
  simp [mk2, EuclideanSpace.single_apply, PiLp.add_apply, PiLp.smul_apply]

@[simp] theorem mk2_apply_one (x y : ℝ) : mk2 x y 1 = y := by
  simp [mk2, EuclideanSpace.single_apply, PiLp.add_apply, PiLp.smul_apply]

theorem coords_mk2 (x y : ℝ) : coords (mk2 x y) = (x, y) := by
  rw [coords_apply, mk2_apply_zero, mk2_apply_one]

theorem coords_symm_apply (q : ℝ × ℝ) : coords.symm q = mk2 q.1 q.2 := by
  refine coords.injective ?_
  rw [MeasurableEquiv.apply_symm_apply, coords_mk2]

theorem continuous_mk2 : Continuous fun q : ℝ × ℝ => mk2 q.1 q.2 := by
  show Continuous fun q : ℝ × ℝ =>
    q.1 • EuclideanSpace.single (0 : Fin 2) (1 : ℝ) +
      q.2 • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)
  refine Continuous.add ?_ ?_
  · exact continuous_fst.smul
      (continuous_const (y := EuclideanSpace.single (0 : Fin 2) (1 : ℝ)))
  · exact continuous_snd.smul
      (continuous_const (y := EuclideanSpace.single (1 : Fin 2) (1 : ℝ)))

theorem norm_mk2_sq (x y : ℝ) : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := by
  rw [norm_sq_two, mk2_apply_zero, mk2_apply_one]

/-- The polar parameterization of the plane. -/
def pt (r φ : ℝ) : Pl := mk2 (r * Real.cos φ) (r * Real.sin φ)

theorem norm_pt (r φ : ℝ) (hr : 0 ≤ r) : ‖pt r φ‖ = r := by
  have hsq : ‖pt r φ‖ ^ 2 = r ^ 2 := by
    rw [pt, norm_mk2_sq]
    have := Real.sin_sq_add_cos_sq φ
    nlinarith
  nlinarith [norm_nonneg (pt r φ), hr]

theorem pt_eq_smul (r φ : ℝ) : pt r φ = r • pt 1 φ := by
  rw [pt, pt, mk2, mk2, one_mul, one_mul, smul_add, smul_smul, smul_smul]

theorem norm_pt_one (φ : ℝ) : ‖pt 1 φ‖ = 1 := norm_pt 1 φ zero_le_one

theorem continuous_pt : Continuous fun q : ℝ × ℝ => pt q.1 q.2 := by
  have hinner : Continuous fun q : ℝ × ℝ =>
      ((q.1 * Real.cos q.2 : ℝ), (q.1 * Real.sin q.2 : ℝ)) :=
    (continuous_fst.mul (Real.continuous_cos.comp continuous_snd)).prodMk
      (continuous_fst.mul (Real.continuous_sin.comp continuous_snd))
  exact continuous_mk2.comp hinner

theorem continuous_pt_fixed (φ : ℝ) : Continuous fun r : ℝ => pt r φ := by
  have : (fun r : ℝ => pt r φ) = (fun q : ℝ × ℝ => pt q.1 q.2) ∘ (fun r : ℝ => (r, φ)) := rfl
  rw [this]
  exact continuous_pt.comp (continuous_id.prodMk continuous_const)

/-- The polar coordinate formula on the plane. -/
theorem integral_polar (f : Pl → ℂ) :
    (∫ η : Pl, f η) = ∫ q in polarCoord.target, q.1 • f (pt q.1 q.2) := by
  have h1 : (∫ η : Pl, f η) = ∫ q : ℝ × ℝ, f (coords.symm q) := by
    have h := measurePreserving_coords.integral_comp coords.measurableEmbedding
      (fun q : ℝ × ℝ => f (coords.symm q))
    rw [← h]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    show f η = f (coords.symm (coords η))
    rw [MeasurableEquiv.symm_apply_apply]
  rw [h1, ← integral_comp_polarCoord_symm (fun q : ℝ × ℝ => f (coords.symm q))]
  refine setIntegral_congr_fun polarCoord.open_target.measurableSet fun q _ => ?_
  congr 2
  rw [coords_symm_apply]
  rfl

theorem integrableOn_polar {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0) :
    IntegrableOn (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) volume := by
  classical
  obtain ⟨C0, hC0⟩ := (isCompact_closedBall (0 : Pl) R).exists_bound_of_continuousOn
    hf.continuousOn
  set C : ℝ := max C0 0 with hCdef
  have hCnn : (0 : ℝ) ≤ C := le_max_right _ _
  have hC : ∀ η : Pl, ‖f η‖ ≤ C := by
    intro η
    by_cases h : ‖η‖ ≤ R
    · refine le_trans (hC0 η ?_) (le_max_left _ _)
      rw [Metric.mem_closedBall, dist_zero_right]
      exact h
    · rw [hsupp η (not_le.mp h)]
      simpa using hCnn
  have hcont : Continuous fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2) := by
    exact continuous_fst.smul (hf.comp continuous_pt)
  have hsplit : Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π
      = (Set.Ioc 0 R ×ˢ Set.Ioo (-π) π) ∪ (Set.Ioi R ×ˢ Set.Ioo (-π) π) := by
    rw [← Set.union_prod, Set.Ioc_union_Ioi_eq_Ioi hR.le]
  rw [hsplit]
  refine IntegrableOn.union ?_ ?_
  · refine Measure.integrableOn_of_bounded ?_ hcont.aestronglyMeasurable (M := R * C) ?_
    · rw [Measure.volume_eq_prod, Measure.prod_prod]
      exact ENNReal.mul_ne_top measure_Ioc_lt_top.ne measure_Ioo_lt_top.ne
    · refine ae_restrict_of_forall_mem (measurableSet_Ioc.prod measurableSet_Ioo) fun q hq => ?_
      have hq1 : q.1 ∈ Set.Ioc (0 : ℝ) R := hq.1
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hq1.1]
      exact mul_le_mul hq1.2 (hC _) (norm_nonneg _) (le_trans hq1.1.le hq1.2)
  · have hzero : ∀ q ∈ Set.Ioi R ×ˢ Set.Ioo (-π) π, q.1 • f (pt q.1 q.2) = 0 := by
      intro q hq
      have hq1 : R < q.1 := hq.1
      rw [hsupp (pt q.1 q.2) (by rw [norm_pt _ _ (lt_trans hR hq1).le]; exact hq1)]
      simp
    refine (integrableOn_zero (μ := (volume : Measure (ℝ × ℝ)))
      (s := Set.Ioi R ×ˢ Set.Ioo (-π) π)).congr_fun ?_ ?_
    · exact fun q hq => (hzero q hq).symm
    · exact (measurableSet_Ioi.prod measurableSet_Ioo)

/-- The polar estimate with the angular variable outermost.  If for every angle `φ` the radial
integral has extended norm at most `M · 1_{Sφ}(φ)`, then the plane integral is bounded by
`M` times the measure of the relevant angular range. -/
theorem enorm_integral_polar_le {f : Pl → ℂ} (hf : Continuous f) {R : ℝ} (hR : 0 < R)
    (hsupp : ∀ η : Pl, R < ‖η‖ → f η = 0)
    {Sφ : Set ℝ} (hSφ : MeasurableSet Sφ) {M : ℝ}
    (hbd : ∀ φ : ℝ, ‖∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ)‖ₑ
      ≤ Set.indicator Sφ (fun _ => ENNReal.ofReal M) φ) :
    ‖∫ η : Pl, f η‖ₑ ≤ ENNReal.ofReal M * volume (Sφ ∩ Set.Ioo (-π) π) := by
  classical
  have htarget : polarCoord.target = Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π := rfl
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar hf hR hsupp
  have hpolar : (∫ η : Pl, f η)
      = ∫ φ in Set.Ioo (-π) π, ∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • f (pt r φ) := by
    rw [integral_polar f, htarget, ← hprod]
    exact integral_prod_symm (fun q : ℝ × ℝ => q.1 • f (pt q.1 q.2)) hint
  rw [hpolar]
  refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
  refine le_trans (lintegral_mono hbd) ?_
  rw [lintegral_indicator hSφ, setLIntegral_const, Measure.restrict_apply hSφ]

end Polar



/-! ## The elliptic phase `τ_ξ(ρ) = |ξ - ρθ| + ρ`

For a unit vector `θ` write `a = ⟪ξ, θ⟫` and `R = ‖ξ‖`.  Then `|ξ - ρθ|² = ρ² - 2aρ + R²`, and the
discriminant condition `a² < R²` says exactly that `θ` is not parallel to `ξ`.  Under it the phase
is smooth on all of `ℝ` and its derivative never vanishes, which is what the non-stationary phase
estimate needs.
-/

section Phase

/-- `|ξ - ρθ|²`. -/
def qf (a R ρ : ℝ) : ℝ := ρ ^ 2 - 2 * a * ρ + R ^ 2

/-- `|ξ - ρθ|`. -/
def gf (a R ρ : ℝ) : ℝ := Real.sqrt (qf a R ρ)

/-- The elliptic phase `|ξ - ρθ| + ρ`. -/
def tauf (a R ρ : ℝ) : ℝ := gf a R ρ + ρ

/-- The first derivative of the elliptic phase. -/
def tauf1 (a R ρ : ℝ) : ℝ := 1 + (ρ - a) / gf a R ρ

/-- The second derivative of the elliptic phase. -/
def tauf2 (a R ρ : ℝ) : ℝ := (R ^ 2 - a ^ 2) / gf a R ρ ^ 3

/-- The third derivative of the elliptic phase. -/
def tauf3 (a R ρ : ℝ) : ℝ := -(3 * (R ^ 2 - a ^ 2) * (ρ - a)) / gf a R ρ ^ 5

variable {a R : ℝ}

theorem qf_eq (a R ρ : ℝ) : qf a R ρ = (ρ - a) ^ 2 + (R ^ 2 - a ^ 2) := by
  rw [qf]; ring

theorem qf_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < qf a R ρ := by
  rw [qf_eq]
  nlinarith [sq_nonneg (ρ - a)]

theorem gf_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < gf a R ρ :=
  Real.sqrt_pos.mpr (qf_pos hD ρ)

theorem gf_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : gf a R ρ ≠ 0 := (gf_pos hD ρ).ne'

theorem gf_sq (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : gf a R ρ ^ 2 = qf a R ρ :=
  Real.sq_sqrt (qf_pos hD ρ).le

theorem abs_sub_lt_gf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : |ρ - a| < gf a R ρ := by
  have hsq : (ρ - a) ^ 2 < gf a R ρ ^ 2 := by
    rw [gf_sq hD, qf_eq]
    linarith
  have habs : |ρ - a| ^ 2 < gf a R ρ ^ 2 := by rwa [sq_abs]
  nlinarith [abs_nonneg (ρ - a), gf_pos hD ρ]

theorem hasDerivAt_qf (a R ρ : ℝ) : HasDerivAt (qf a R) (2 * ρ - 2 * a) ρ := by
  show HasDerivAt (fun x : ℝ => x ^ 2 - 2 * a * x + R ^ 2) (2 * ρ - 2 * a) ρ
  have h1 : HasDerivAt (fun x : ℝ => x ^ 2) (2 * ρ) ρ := by
    simpa using hasDerivAt_pow 2 ρ
  have h2 : HasDerivAt (fun x : ℝ => 2 * a * x) (2 * a) ρ := by
    simpa using (hasDerivAt_id ρ).const_mul (2 * a)
  exact (h1.sub h2).add_const (R ^ 2)

theorem hasDerivAt_gf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (gf a R) ((ρ - a) / gf a R ρ) ρ := by
  have h1 : HasDerivAt Real.sqrt (1 / (2 * Real.sqrt (qf a R ρ))) (qf a R ρ) :=
    Real.hasDerivAt_sqrt (qf_pos hD ρ).ne'
  have h2 := h1.comp ρ (hasDerivAt_qf a R ρ)
  have heq : 1 / (2 * Real.sqrt (qf a R ρ)) * (2 * ρ - 2 * a) = (ρ - a) / gf a R ρ := by
    rw [gf]
    field_simp
  rw [heq] at h2
  exact h2

theorem continuous_gf (hD : 0 < R ^ 2 - a ^ 2) : Continuous (gf a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_gf hD ρ).continuousAt

theorem hasDerivAt_tauf (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf a R) (tauf1 a R ρ) ρ := by
  have h := (hasDerivAt_gf hD ρ).add (hasDerivAt_id ρ)
  have heq : (ρ - a) / gf a R ρ + 1 = tauf1 a R ρ := by rw [tauf1]; ring
  rw [heq] at h
  exact h

theorem continuous_tauf (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf a R) :=
  (continuous_gf hD).add continuous_id

theorem hasDerivAt_tauf1 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf1 a R) (tauf2 a R ρ) ρ := by
  have hg := hasDerivAt_gf hD ρ
  have hnum : HasDerivAt (fun x : ℝ => x - a) 1 ρ := (hasDerivAt_id ρ).sub_const a
  have h := hnum.div hg (gf_ne hD ρ)
  have hgne : gf a R ρ ≠ 0 := gf_ne hD ρ
  have hgg : gf a R ρ * gf a R ρ = (ρ - a) ^ 2 + (R ^ 2 - a ^ 2) := by
    rw [← pow_two, gf_sq hD, qf_eq]
  have key : 1 * gf a R ρ - (ρ - a) * ((ρ - a) / gf a R ρ)
      = (R ^ 2 - a ^ 2) / gf a R ρ := by
    rw [one_mul]
    field_simp
    nlinarith [hgg]
  have heq : (0 : ℝ) + (1 * gf a R ρ - (ρ - a) * ((ρ - a) / gf a R ρ)) / gf a R ρ ^ 2
      = tauf2 a R ρ := by
    rw [zero_add, key, tauf2, div_div]
    congr 1
    ring
  have h2 := (hasDerivAt_const ρ (1 : ℝ)).add h
  rw [heq] at h2
  exact h2

theorem continuous_tauf1 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf1 a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_tauf1 hD ρ).continuousAt

theorem hasDerivAt_tauf2 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (tauf2 a R) (tauf3 a R ρ) ρ := by
  have hgne : gf a R ρ ≠ 0 := gf_ne hD ρ
  have hg := hasDerivAt_gf hD ρ
  have hcube : HasDerivAt (fun x : ℝ => gf a R x ^ 3)
      (3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ)) ρ := by
    have h := hg.pow 3
    have heq : (3 : ℕ) * gf a R ρ ^ (3 - 1) * ((ρ - a) / gf a R ρ)
        = 3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ) := by
      norm_num
    rw [heq] at h
    exact h
  have hpow3 : (0 : ℝ) < gf a R ρ ^ 3 := pow_pos (gf_pos hD ρ) 3
  have h := (hasDerivAt_const ρ (R ^ 2 - a ^ 2)).div hcube hpow3.ne'
  have heq : (0 * gf a R ρ ^ 3 - (R ^ 2 - a ^ 2) * (3 * gf a R ρ ^ 2 * ((ρ - a) / gf a R ρ)))
      / (gf a R ρ ^ 3) ^ 2 = tauf3 a R ρ := by
    rw [tauf3]
    field_simp
    ring
  rw [heq] at h
  exact h

theorem continuous_tauf2 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf2 a R) := by
  refine continuous_iff_continuousAt.mpr fun ρ => (hasDerivAt_tauf2 hD ρ).continuousAt

theorem continuous_tauf3 (hD : 0 < R ^ 2 - a ^ 2) : Continuous (tauf3 a R) := by
  refine Continuous.div ?_ ((continuous_gf hD).pow 5) (fun ρ => pow_ne_zero 5 (gf_ne hD ρ))
  exact (continuous_const.mul (continuous_id.sub continuous_const)).neg

theorem tauf1_pos (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : 0 < tauf1 a R ρ := by
  have h1 := abs_sub_lt_gf hD ρ
  have hg := gf_pos hD ρ
  have h2 : -(gf a R ρ) < ρ - a := (abs_lt.mp h1).1
  have h4 : (-1 : ℝ) < (ρ - a) / gf a R ρ := by
    rw [lt_div_iff₀ hg]
    linarith
  rw [tauf1]
  linarith

theorem tauf1_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : tauf1 a R ρ ≠ 0 := (tauf1_pos hD ρ).ne'

end Phase


/-! ## The radial oscillatory estimate

Two integrations by parts against the elliptic phase.  The amplitudes after one and two
integrations by parts are written out explicitly, so that they can be estimated directly and so
that they visibly vanish wherever the original amplitude vanishes to second order.
-/

section Radial

variable {a R : ℝ}

/-- The amplitude after one integration by parts. -/
def bfun (a R : ℝ) (A A1 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  A1 ρ / (tauf1 a R ρ : ℂ) - A ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2

/-- The derivative of the amplitude after one integration by parts. -/
def bfun1 (a R : ℝ) (A A1 A2 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  A2 ρ / (tauf1 a R ρ : ℂ)
    - 2 * A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
    - A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
    + 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3

/-- The amplitude after two integrations by parts. -/
def cfun (a R : ℝ) (A A1 A2 : ℝ → ℂ) (ρ : ℝ) : ℂ :=
  bfun1 a R A A1 A2 ρ / (tauf1 a R ρ : ℂ)
    - bfun a R A A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2

theorem cT_ne (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) : (tauf1 a R ρ : ℂ) ≠ 0 := by
  exact_mod_cast tauf1_ne hD ρ

theorem hasDerivAt_cT (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (fun y => (tauf1 a R y : ℂ)) ((tauf2 a R ρ : ℂ)) ρ :=
  (hasDerivAt_tauf1 hD ρ).ofReal_comp

theorem hasDerivAt_cT2 (hD : 0 < R ^ 2 - a ^ 2) (ρ : ℝ) :
    HasDerivAt (fun y => (tauf2 a R y : ℂ)) ((tauf3 a R ρ : ℂ)) ρ :=
  (hasDerivAt_tauf2 hD ρ).ofReal_comp

theorem continuous_cT (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf1 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf1 hD)

theorem continuous_cT2 (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf2 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf2 hD)

theorem continuous_cT3 (hD : 0 < R ^ 2 - a ^ 2) : Continuous fun y => (tauf3 a R y : ℂ) :=
  Complex.continuous_ofReal.comp (continuous_tauf3 hD)

/-- Dividing by the phase derivative: the general step. -/
theorem hasDerivAt_div_cT (hD : 0 < R ^ 2 - a ^ 2) {f f1 : ℝ → ℂ}
    (hf : ∀ ρ, HasDerivAt f (f1 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (fun y => f y / (tauf1 a R y : ℂ))
      (f1 ρ / (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2) ρ := by
  have h := (hf ρ).div (hasDerivAt_cT hD ρ) (cT_ne hD ρ)
  have heq : (f1 ρ * (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ)) / (tauf1 a R ρ : ℂ) ^ 2
      = f1 ρ / (tauf1 a R ρ : ℂ) - f ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2 := by
    have hne := cT_ne hD ρ
    field_simp
  rw [heq] at h
  exact h

theorem hasDerivAt_bfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (bfun a R A A1) (bfun1 a R A A1 A2 ρ) ρ := by
  have hne := cT_ne hD ρ
  have h1 : HasDerivAt (fun y => A1 y / (tauf1 a R y : ℂ))
      (A2 ρ / (tauf1 a R ρ : ℂ) - A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2) ρ :=
    hasDerivAt_div_cT hD hA1 ρ
  have hsq : HasDerivAt (fun y => (tauf1 a R y : ℂ) ^ 2)
      (2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ)) ρ := by
    have h := (hasDerivAt_cT hD ρ).pow 2
    have heq : ((2 : ℕ) : ℂ) * (tauf1 a R ρ : ℂ) ^ (2 - 1) * (tauf2 a R ρ : ℂ)
        = 2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ) := by norm_num
    rw [heq] at h
    exact h
  have hnum : HasDerivAt (fun y => A y * (tauf2 a R y : ℂ))
      (A1 ρ * (tauf2 a R ρ : ℂ) + A ρ * (tauf3 a R ρ : ℂ)) ρ :=
    (hA ρ).mul (hasDerivAt_cT2 hD ρ)
  have hsqne : (tauf1 a R ρ : ℂ) ^ 2 ≠ 0 := pow_ne_zero 2 hne
  have h2 := hnum.div hsq hsqne
  have heq2 : ((A1 ρ * (tauf2 a R ρ : ℂ) + A ρ * (tauf3 a R ρ : ℂ)) * (tauf1 a R ρ : ℂ) ^ 2
        - A ρ * (tauf2 a R ρ : ℂ) * (2 * (tauf1 a R ρ : ℂ) * (tauf2 a R ρ : ℂ)))
        / ((tauf1 a R ρ : ℂ) ^ 2) ^ 2
      = A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        + A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        - 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3 := by
    field_simp
  rw [heq2] at h2
  have h3 := h1.sub h2
  have heq3 : (A2 ρ / (tauf1 a R ρ : ℂ) - A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2)
      - (A1 ρ * (tauf2 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        + A ρ * (tauf3 a R ρ : ℂ) / (tauf1 a R ρ : ℂ) ^ 2
        - 2 * A ρ * (tauf2 a R ρ : ℂ) ^ 2 / (tauf1 a R ρ : ℂ) ^ 3)
      = bfun1 a R A A1 A2 ρ := by
    rw [bfun1]
    field_simp
    ring
  rw [heq3] at h3
  exact h3

theorem hasDerivAt_bfun_div_cT (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ) (ρ : ℝ) :
    HasDerivAt (fun y => bfun a R A A1 y / (tauf1 a R y : ℂ)) (cfun a R A A1 A2 ρ) ρ :=
  hasDerivAt_div_cT hD (fun y => hasDerivAt_bfun hD hA hA1 y) ρ

theorem continuous_bfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) : Continuous (bfun a R A A1) := by
  refine Continuous.sub ?_ ?_
  · exact hA1c.div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact (hAc.mul (continuous_cT2 hD)).div ((continuous_cT hD).pow 2)
      (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))

theorem continuous_bfun1 (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2) :
    Continuous (bfun1 a R A A1 A2) := by
  refine Continuous.add (Continuous.sub (Continuous.sub ?_ ?_) ?_) ?_
  · exact hA2c.div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact ((continuous_const.mul hA1c).mul (continuous_cT2 hD)).div
      ((continuous_cT hD).pow 2) (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))
  · exact (hAc.mul (continuous_cT3 hD)).div ((continuous_cT hD).pow 2)
      (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))
  · exact ((continuous_const.mul hAc).mul ((continuous_cT2 hD).pow 2)).div
      ((continuous_cT hD).pow 3) (fun ρ => pow_ne_zero 3 (cT_ne hD ρ))

theorem continuous_cfun (hD : 0 < R ^ 2 - a ^ 2) {A A1 A2 : ℝ → ℂ}
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2) :
    Continuous (cfun a R A A1 A2) := by
  refine Continuous.sub ?_ ?_
  · exact (continuous_bfun1 hD hAc hA1c hA2c).div (continuous_cT hD) (fun ρ => cT_ne hD ρ)
  · exact ((continuous_bfun hD hAc hA1c).mul (continuous_cT2 hD)).div
      ((continuous_cT hD).pow 2) (fun ρ => pow_ne_zero 2 (cT_ne hD ρ))

/-- The radial oscillatory estimate: two integrations by parts against the elliptic phase. -/
theorem norm_integral_radial_le (hD : 0 < R ^ 2 - a ^ 2)
    {A A1 A2 : ℝ → ℂ} (hA : ∀ ρ, HasDerivAt A (A1 ρ) ρ) (hA1 : ∀ ρ, HasDerivAt A1 (A2 ρ) ρ)
    (hA2c : Continuous A2)
    {lam : ℝ} (hlam : lam ≠ 0) {b : ℝ} (hb : 0 ≤ b)
    (hA0 : A 0 = 0) (hAb : A b = 0)
    (hB0 : bfun a R A A1 0 = 0) (hBb : bfun a R A A1 b = 0)
    {K : ℝ} (hK : 0 ≤ K) (hCbd : ∀ ρ ∈ Set.Icc (0 : ℝ) b, ‖cfun a R A A1 A2 ρ‖ ≤ K) :
    ‖∫ ρ in (0 : ℝ)..b, osc lam (tauf a R ρ) * A ρ‖ ≤ (lam ^ 2)⁻¹ * (K * b) := by
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun ρ => (hA ρ).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun ρ => (hA1 ρ).continuousAt
  have hstep := norm_integral_osc_ibp_twice hb hlam (τ := tauf a R) (τ' := tauf1 a R)
    (A := A) (Bn := bfun a R A A1) (Cn := cfun a R A A1 A2)
    (fun ρ => hasDerivAt_tauf hD ρ) (continuous_tauf1 hD) (fun ρ => tauf1_ne hD ρ)
    hAc (continuous_bfun hD hAc hA1c) (continuous_cfun hD hAc hA1c hA2c)
    (fun ρ => hasDerivAt_div_cT hD hA ρ) (fun ρ => hasDerivAt_bfun_div_cT hD hA hA1 ρ)
    hA0 hAb hB0 hBb
  refine le_trans hstep ?_
  have hnn : (0 : ℝ) ≤ (lam ^ 2)⁻¹ := by positivity
  refine mul_le_mul_of_nonneg_left ?_ hnn
  have hintg : IntervalIntegrable (fun ρ => ‖cfun a R A A1 A2 ρ‖) volume 0 b :=
    ((continuous_cfun hD hAc hA1c hA2c).norm).intervalIntegrable 0 b
  have hmono : (∫ ρ in (0 : ℝ)..b, ‖cfun a R A A1 A2 ρ‖) ≤ ∫ _ρ in (0 : ℝ)..b, K :=
    intervalIntegral.integral_mono_on hb hintg (intervalIntegrable_const) hCbd
  refine le_trans hmono (le_of_eq ?_)
  rw [intervalIntegral.integral_const, sub_zero, smul_eq_mul]
  ring

end Radial


