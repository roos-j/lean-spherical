theorem Theta.norm_le {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) :
    ‖ω‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1) := h.2.2.2

/-- `Θ_j` is measurable. -/
theorem measurableSet_Theta (j : ℕ) : MeasurableSet (Theta j) := by
  have hc0 : Continuous fun ω : Pl => ω 0 := by
    exact (EuclideanSpace.proj (0 : Fin 2)).continuous
  have hc1 : Continuous fun ω : Pl => ω 1 := by
    exact (EuclideanSpace.proj (1 : Fin 2)).continuous
  have hcn : Continuous fun ω : Pl => ‖ω‖ := continuous_norm
  have h1 : MeasurableSet {ω : Pl | 0 < ω 0} :=
    measurableSet_lt measurable_const hc0.measurable
  have h2 : MeasurableSet {ω : Pl | ω 0 < (2 : ℝ) ^ (-(10 : ℤ)) * ω 1} :=
    measurableSet_lt hc0.measurable (measurable_const.mul hc1.measurable)
  have h3 : MeasurableSet {ω : Pl | (2 : ℝ) ^ ((j : ℤ) - 1) ≤ ‖ω‖} :=
    measurableSet_le measurable_const hcn.measurable
  have h4 : MeasurableSet {ω : Pl | ‖ω‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 1)} :=
    measurableSet_le hcn.measurable measurable_const
  exact h1.inter (h2.inter (h3.inter h4))

/-- The `η`-support constraint of a `(j,m)`-adapted symbol at frequency `ξ`. -/
def SuppSet (j m : ℕ) (ξ : Pl) : Set Pl :=
  {η | η ∈ Theta j ∧ ξ - η ∈ Theta j ∧
    InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ))}

theorem measurable_angle_right (ξ : Pl) :
    Measurable fun η : Pl => InnerProductGeometry.angle ξ η := by
  have hnum : Measurable fun η : Pl => (inner ℝ ξ η : ℝ) :=
    (continuous_const.inner continuous_id).measurable
  have hden : Measurable fun η : Pl => ‖ξ‖ * ‖η‖ :=
    (continuous_const.mul continuous_norm).measurable
  exact Real.continuous_arccos.measurable.comp (hnum.div hden)

theorem measurableSet_SuppSet (j m : ℕ) (ξ : Pl) : MeasurableSet (SuppSet j m ξ) := by
  have h1 : MeasurableSet {η : Pl | η ∈ Theta j} := measurableSet_Theta j
  have h2 : MeasurableSet {η : Pl | ξ - η ∈ Theta j} := by
    have : Measurable fun η : Pl => ξ - η := (continuous_const.sub continuous_id).measurable
    exact this (measurableSet_Theta j)
  have h3 : MeasurableSet {η : Pl | InnerProductGeometry.angle ξ η ≤ (2 : ℝ) ^ (5 - (m : ℤ))} :=
    measurableSet_le (measurable_angle_right ξ) measurable_const
  exact h1.inter (h2.inter h3)

/-- The slab used to bound the support is closed. -/
theorem isClosed_slab (c K L : ℝ) :
    IsClosed {η : Pl | |η 0 - c * η 1| ≤ K ∧ |η 1| ≤ L} := by
  have h0 : Continuous fun η : Pl => η 0 := (EuclideanSpace.proj (0 : Fin 2)).continuous
  have h1 : Continuous fun η : Pl => η 1 := (EuclideanSpace.proj (1 : Fin 2)).continuous
  have hA : IsClosed {η : Pl | |η 0 - c * η 1| ≤ K} :=
    isClosed_le ((h0.sub (continuous_const.mul h1)).abs) continuous_const
  have hB : IsClosed {η : Pl | |η 1| ≤ L} := isClosed_le h1.abs continuous_const
  exact hA.inter hB

