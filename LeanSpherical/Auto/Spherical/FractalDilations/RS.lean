    det2 x y ^ 2 = ‖x‖ ^ 2 * ‖y‖ ^ 2 - inner ℝ x y ^ 2 := by
  rw [det2, norm_sq_two, norm_sq_two, inner_two]
  ring

/-- The determinant is bounded by the product of the norms and the unoriented angle. -/
theorem abs_det2_le (x y : Pl) :
    |det2 x y| ≤ ‖x‖ * ‖y‖ * InnerProductGeometry.angle x y := by
