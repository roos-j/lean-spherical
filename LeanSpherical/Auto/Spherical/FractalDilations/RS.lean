  nlinarith

theorem Theta.snd_le_norm {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : ω 1 ≤ ‖ω‖ := by
  have hpos : 0 < ω 1 := Theta.snd_pos h
  have hsq : ω 1 ^ 2 ≤ ‖ω‖ ^ 2 := by
    rw [norm_sq_two]
    nlinarith [sq_nonneg (ω 0)]
  nlinarith [norm_nonneg ω, hpos]

theorem Theta.norm_le_two_mul_snd {j : ℕ} {ω : Pl} (h : ω ∈ Theta j) : ‖ω‖ ≤ 2 * ω 1 := by
  obtain ⟨h0, h1, -, -⟩ := h
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
  have hpos : 0 < ω 1 := by nlinarith
  have hcle : (2 : ℝ) ^ (-(10 : ℤ)) ≤ 1 := by
    rw [zpow_neg]
    norm_num
  have hlt : ω 0 < ω 1 := by nlinarith
  have hsq : ‖ω‖ ^ 2 ≤ (2 * ω 1) ^ 2 := by
    rw [norm_sq_two]
    nlinarith
  nlinarith [norm_nonneg ω, hpos]

