abbrev Pl2 := WithLp 2 (Pl × Pl)

/-- Pair two planar vectors into a vector of `ℝ⁴`. -/
def pr (y z : Pl) : Pl2 := WithLp.toLp 2 (y, z)

@[simp] theorem pr_ofLp (y z : Pl) : WithLp.ofLp (pr y z) = (y, z) := rfl

theorem inner_pr (y z y' z' : Pl) :
    inner ℝ (pr y z) (pr y' z') = inner ℝ y y' + inner ℝ z z' := rfl

/-! ## Planar coordinates -/

theorem inner_two (x y : Pl) : inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
  rw [PiLp.inner_apply, Fin.sum_univ_two]
  simp [RCLike.inner_apply, mul_comm]

theorem norm_sq_two (x : Pl) : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

/-- The determinant of two planar vectors. -/
def det2 (x y : Pl) : ℝ := x 0 * y 1 - x 1 * y 0

/-- Lagrange's identity in the plane. -/
