    (hp : 1 < p) (hq2 : 2 < q) (hpq : p < q) (hq2p : q < 2 * p)
    (hnu : γ < q / 2 + 1 - q / p) :
    ∃ C : ENNReal, C ≠ ⊤ ∧ ∀ g : ℝ → ℂ, Continuous g →
