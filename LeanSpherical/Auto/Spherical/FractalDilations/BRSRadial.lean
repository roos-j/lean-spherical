/-- **BRS (4.1)–(4.2).**  For a radial function with continuous profile `f₀`,
the spherical average of radius `t` at a nonzero point `x` is the kernel
integral of the profile over `[ |r - t|, r + t ]`, with `r = ‖x‖`. -/
theorem sphericalAverage_eq_kernel_integral {d : ℕ} (hd : 2 ≤ d)
    (f₀ : ℝ → ℂ) (hf₀ : Continuous f₀)
    {x : Euclidean (d + 1)} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
      (((surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2)) : ℝ) : ℂ) *
        ∫ s in |‖x‖ - t|..(‖x‖ + t),
          ((brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hFcont : Continuous fun v : ℝ =>
      f₀ (Real.sqrt (‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * v)) :=
    hf₀.comp (Real.continuous_sqrt.comp (by fun_prop))
  have hpull :
      (∫ s in |‖x‖ - t|..(‖x‖ + t),
        (((4 : ℝ) * 2 ^ (d - 2) * brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s) =
      ((4 : ℝ) * 2 ^ (d - 2)) •
        ∫ s in |‖x‖ - t|..(‖x‖ + t), ((brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s := by
    rw [← intervalIntegral.integral_smul]
    refine intervalIntegral.integral_congr ?_
    intro s _
    show (((4 : ℝ) * 2 ^ (d - 2) * brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s =
      ((4 : ℝ) * 2 ^ (d - 2)) • (((brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s)
    rw [smul_smul]
  rw [sphericalAverage_comp_norm_succ hd f₀ hf₀ hx t,
    integral_sliceMeasure_eq_intervalIntegral d _ hFcont,
    intervalIntegral_slice_eq_kernel hr ht f₀ hf₀, hpull]
  rw [Complex.real_smul]
  push_cast
  ring

/-! ## The test function of Lemma 3.1

The necessity of `p ≤ q` is tested on a radial function supported in a union
of `2^{k-5}` annuli of thickness six at radius about `2^k`, separated by gaps
of length two.  A sphere of radius `t ∈ [1,2]` centred in the middle annulus
`I^k_n` stays inside the fattened annulus `I^{k,*}_n` and misses every other
one. -/

/-- The fattened annulus radii `I^{k,*}_n = [2^k + 8n + 1, 2^k + 8n + 7]`. -/
def annulusStar (k n : ℕ) : Set ℝ :=
  Icc ((2 : ℝ) ^ k + 8 * n + 1) ((2 : ℝ) ^ k + 8 * n + 7)

/-- The core annulus radii `I^k_n = [2^k + 8n + 3, 2^k + 8n + 5]`. -/
def annulusCore (k n : ℕ) : Set ℝ :=
  Icc ((2 : ℝ) ^ k + 8 * n + 3) ((2 : ℝ) ^ k + 8 * n + 5)

theorem annulusCore_subset_annulusStar (k n : ℕ) :
    annulusCore k n ⊆ annulusStar k n := by
  intro s hs
  rw [annulusCore, mem_Icc] at hs
  rw [annulusStar, mem_Icc]
  constructor <;> linarith [hs.1, hs.2]

/-- Distinct fattened annuli are disjoint: they have length six inside a
period of eight. -/
theorem annulusStar_disjoint {k m n : ℕ} (h : m ≠ n) :
    Disjoint (annulusStar k m) (annulusStar k n) := by
  rw [Set.disjoint_left]
  intro s hsm hsn
  rw [annulusStar, mem_Icc] at hsm hsn
  rcases Nat.lt_or_ge m n with hmn | hmn
  · have hcast : ((m : ℝ) + 1) ≤ (n : ℝ) := by
      exact_mod_cast Nat.succ_le_of_lt hmn
    linarith [hsm.2, hsn.1]
  · have hnm : n < m := by omega
    have hcast : ((n : ℝ) + 1) ≤ (m : ℝ) := by
      exact_mod_cast Nat.succ_le_of_lt hnm
    linarith [hsn.2, hsm.1]

/-- A radius within distance two of the core annulus lies in the fattened
annulus. -/
theorem mem_annulusStar_of_dist_le {k n : ℕ} {s u : ℝ}
    (hs : s ∈ annulusCore k n) (hu : |u - s| ≤ 2) : u ∈ annulusStar k n := by
  rw [annulusCore, mem_Icc] at hs
  rw [abs_le] at hu
  rw [annulusStar, mem_Icc]
  constructor <;> linarith [hs.1, hs.2, hu.1, hu.2]

/-- A radius within distance two of a different core annulus misses the
fattened annulus. -/
theorem notMem_annulusStar_of_dist_le {k m n : ℕ} (h : m ≠ n) {s u : ℝ}
    (hs : s ∈ annulusCore k m) (hu : |u - s| ≤ 2) : u ∉ annulusStar k n := by
  intro hun
  have hum : u ∈ annulusStar k m := mem_annulusStar_of_dist_le hs hu
  exact (Set.disjoint_left.mp (annulusStar_disjoint (k := k) h)) hum hun

/-- The radial profile of the test function of BRS Lemma 3.1, before the
normalizing constant. -/
def testProfile (k : ℕ) : ℝ → ℂ :=
  fun s => ∑ n ∈ Finset.Icc 1 (2 ^ (k - 5)),
    (annulusStar k n).indicator (fun _ => (1 : ℂ)) s

theorem measurable_testProfile (k : ℕ) : Measurable (testProfile k) := by
  unfold testProfile
  refine Finset.measurable_sum _ fun n _ => ?_
  exact measurable_const.indicator measurableSet_Icc

/-- On a fattened annulus of the family the profile equals one. -/
theorem testProfile_eq_one {k n : ℕ} (hn : n ∈ Finset.Icc 1 (2 ^ (k - 5)))
    {s : ℝ} (hs : s ∈ annulusStar k n) : testProfile k s = 1 := by
  rw [testProfile]
  rw [Finset.sum_eq_single n]
  · rw [Set.indicator_of_mem hs]
  · intro m hm hmn
    refine Set.indicator_of_notMem ?_ _
    exact Set.disjoint_right.mp (annulusStar_disjoint (k := k) hmn) hs
  · intro hcon
    exact absurd hn hcon

/-- The profile is nonnegative and bounded by one. -/
theorem testProfile_norm_le_one (k : ℕ) (s : ℝ) : ‖testProfile k s‖ ≤ 1 := by
  by_cases hs : ∃ n ∈ Finset.Icc 1 (2 ^ (k - 5)), s ∈ annulusStar k n
  · obtain ⟨n, hn, hsn⟩ := hs
    rw [testProfile_eq_one hn hsn]
    norm_num
  · have hzero : testProfile k s = 0 := by
      unfold testProfile
      refine Finset.sum_eq_zero fun n hn => ?_
      refine Set.indicator_of_notMem ?_ _
      intro hsn
      exact hs ⟨n, hn, hsn⟩
    rw [hzero]
    norm_num

/-- The normalized sphere measure of `Definitions.lean` is a probability
measure. -/
theorem unitSphereMeasure_real_univ {d : ℕ} (hd : 0 < d) :
    (_root_.Spherical.unitSphereMeasure d).real univ = 1 := by
  have hpos : 0 < unitSurfaceMeasure d univ := unitSurfaceMeasure_univ_pos hd
  have htop : unitSurfaceMeasure d univ ≠ ⊤ := measure_ne_top _ _
  rw [_root_.Spherical.unitSphereMeasure, measureReal_def, Measure.smul_apply,
    smul_eq_mul]
  have hval : ((volume : Measure (Euclidean d)).toSphere univ) =
      unitSurfaceMeasure d univ := rfl
  rw [hval, ENNReal.toReal_mul, ENNReal.toReal_inv]
  exact inv_mul_cancel₀ (ENNReal.toReal_pos (ne_of_gt hpos) htop).ne'

/-- **The key averaging property of the test function.**  A sphere of radius
`t ∈ [1,2]` centred at radius in the core annulus `I^k_n` stays inside the
fattened annulus, where the profile is one, so the average is one. -/
theorem sphericalAverage_testProfile_eq_one {d k n : ℕ} (hd : 0 < d)
    (hn : n ∈ Finset.Icc 1 (2 ^ (k - 5))) {x : Euclidean d}
    (hx : ‖x‖ ∈ annulusCore k n) {t : ℝ} (ht : t ∈ Icc (1 : ℝ) 2) :
    _root_.Spherical.sphericalAverage t (fun y => testProfile k ‖y‖) x = 1 := by
  have hpoint : ∀ ω : Metric.sphere (0 : Euclidean d) 1,
      testProfile k ‖x + t • (ω : Euclidean d)‖ = 1 := by
    intro ω
    refine testProfile_eq_one hn (mem_annulusStar_of_dist_le hx ?_)
    have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.2
    have h1 : |‖x + t • (ω : Euclidean d)‖ - ‖x‖| ≤ ‖t • (ω : Euclidean d)‖ := by
      simpa using abs_norm_sub_norm_le (x + t • (ω : Euclidean d)) x
    rw [norm_smul, Real.norm_eq_abs, hω, mul_one] at h1
    have ht0 : 0 < t := lt_of_lt_of_le zero_lt_one ht.1
    calc |‖x + t • (ω : Euclidean d)‖ - ‖x‖| ≤ |t| := h1
      _ = t := abs_of_pos ht0
      _ ≤ 2 := ht.2
  rw [_root_.Spherical.sphericalAverage,
    integral_congr_ae (Filter.Eventually.of_forall hpoint), integral_const,
    unitSphereMeasure_real_univ hd, one_smul]

/-! ## Volumes of radial annuli -/

/-- The closed radial annulus `{x : ‖x‖ ∈ [a,b]}`. -/
def radialAnnulusIcc (d : ℕ) (a b : ℝ) : Set (Euclidean d) := {x | ‖x‖ ∈ Icc a b}

theorem radialAnnulusIcc_eq_diff (d : ℕ) (a b : ℝ) :
    radialAnnulusIcc d a b =
      Metric.closedBall (0 : Euclidean d) b \ Metric.ball (0 : Euclidean d) a := by
  ext x
  simp only [radialAnnulusIcc, mem_setOf_eq, mem_Icc, Set.mem_diff,
    Metric.mem_closedBall, Metric.mem_ball, dist_zero_right, not_lt]
  exact ⟨fun h => ⟨h.2, h.1⟩, fun h => ⟨h.2, h.1⟩⟩

theorem measurableSet_radialAnnulusIcc (d : ℕ) (a b : ℝ) :
    MeasurableSet (radialAnnulusIcc d a b) := by
  rw [radialAnnulusIcc_eq_diff]
  exact measurableSet_closedBall.diff measurableSet_ball

/-- The volume of a radial annulus is the difference of the `d`-th powers of
its radii, times the volume of the unit ball. -/
theorem volume_radialAnnulusIcc {d : ℕ} (hd : 0 < d) {a b : ℝ} (ha : 0 ≤ a)
    (hab : a ≤ b) :
    volume (radialAnnulusIcc d a b) =
      ENNReal.ofReal (b ^ d - a ^ d) * volume (Metric.ball (0 : Euclidean d) 1) := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hfr : Module.finrank ℝ (Euclidean d) = d := finrank_euclideanSpace_fin
  have hsub : Metric.ball (0 : Euclidean d) a ⊆
      Metric.closedBall (0 : Euclidean d) b := by
    intro x hx
    rw [Metric.mem_ball, dist_zero_right] at hx
    rw [Metric.mem_closedBall, dist_zero_right]
    linarith
  have hfin : volume (Metric.ball (0 : Euclidean d) a) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hclosed := Measure.addHaar_closedBall (volume : Measure (Euclidean d))
    (0 : Euclidean d) (le_trans ha hab)
  have hopen := Measure.addHaar_ball (volume : Measure (Euclidean d))
    (0 : Euclidean d) ha
  rw [hfr] at hclosed hopen
  have hkey : ENNReal.ofReal (b ^ d) * volume (Metric.ball (0 : Euclidean d) 1) -
      ENNReal.ofReal (a ^ d) * volume (Metric.ball (0 : Euclidean d) 1) =
      ENNReal.ofReal (b ^ d - a ^ d) * volume (Metric.ball (0 : Euclidean d) 1) := by
    rw [ENNReal.ofReal_sub _ (by positivity : (0 : ℝ) ≤ a ^ d)]
    exact (ENNReal.sub_mul (fun _ _ =>
      ((measure_mono Metric.ball_subset_closedBall).trans_lt
        measure_closedBall_lt_top).ne)).symm
  rw [radialAnnulusIcc_eq_diff,
    measure_sdiff hsub measurableSet_ball.nullMeasurableSet hfin, hclosed, hopen,
    hkey]

/-- The radii intervals of the family are pairwise disjoint, hence so are the
annuli. -/
theorem radialAnnulus_annulusStar_disjoint (d : ℕ) {k m n : ℕ} (h : m ≠ n) :
    Disjoint (radialAnnulusIcc d ((2 : ℝ) ^ k + 8 * m + 1) ((2 : ℝ) ^ k + 8 * m + 7))
      (radialAnnulusIcc d ((2 : ℝ) ^ k + 8 * n + 1) ((2 : ℝ) ^ k + 8 * n + 7)) := by
  rw [Set.disjoint_left]
  intro x hxm hxn
  exact (Set.disjoint_left.mp (annulusStar_disjoint (k := k) h)) hxm hxn

/-- The union of the fattened annuli carrying the test function. -/
def testStarSet (d k : ℕ) : Set (Euclidean d) :=
  ⋃ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ), {x : Euclidean d | ‖x‖ ∈ annulusStar k n}

/-- The union of the core annuli on which the maximal function is at least
one. -/
def testCoreSet (d k : ℕ) : Set (Euclidean d) :=
  ⋃ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ), {x : Euclidean d | ‖x‖ ∈ annulusCore k n}

theorem measurableSet_testStarSet (d k : ℕ) : MeasurableSet (testStarSet d k) := by
  unfold testStarSet
  exact Finset.measurableSet_biUnion _ fun n _ => measurableSet_radialAnnulusIcc d _ _

theorem measurableSet_testCoreSet (d k : ℕ) : MeasurableSet (testCoreSet d k) := by
  unfold testCoreSet
  exact Finset.measurableSet_biUnion _ fun n _ => measurableSet_radialAnnulusIcc d _ _

/-- The radial lift of the test profile is the indicator of the union of the
fattened annuli. -/
theorem testProfile_lift_eq_indicator (d k : ℕ) :
    (fun x : Euclidean d => testProfile k ‖x‖) =
      (testStarSet d k).indicator (fun _ => (1 : ℂ)) := by
  funext x
  by_cases hx : ∃ n ∈ Finset.Icc 1 (2 ^ (k - 5)), ‖x‖ ∈ annulusStar k n
  · obtain ⟨n, hn, hxn⟩ := hx
    have hmem : x ∈ testStarSet d k := by
      unfold testStarSet
      exact Set.mem_biUnion hn hxn
    rw [testProfile_eq_one hn hxn, Set.indicator_of_mem hmem]
  · have hzero : testProfile k ‖x‖ = 0 := by
      unfold testProfile
      refine Finset.sum_eq_zero fun n hn => ?_
      refine Set.indicator_of_notMem ?_ _
      intro hxn
      exact hx ⟨n, hn, hxn⟩
    have hnot : x ∉ testStarSet d k := by
      unfold testStarSet
      intro hmem
      simp only [Set.mem_iUnion, Set.mem_setOf_eq, exists_prop] at hmem
      exact hx hmem
    rw [hzero, Set.indicator_of_notMem hnot]

/-- The `L^p` norm of the test function is the `p`-th root of the volume of
the union of the fattened annuli. -/
theorem eLpNorm_testProfile_lift (d k : ℕ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume =
      volume (testStarSet d k) ^ (1 / p) := by
  rw [testProfile_lift_eq_indicator,
    eLpNorm_indicator_const (measurableSet_testStarSet d k)
      (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hp)
      ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hp.le]
  simp

/-- On the union of the core annuli the maximal function is at least one, so
its `L^q` norm dominates the `q`-th root of that volume. -/
theorem le_eLpNorm_M_testProfile_lift {d k : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q) :
    volume (testCoreSet d k) ^ (1 / q) ≤
      eLpNorm (M E (fun x : Euclidean d => testProfile k ‖x‖))
        (ENNReal.ofReal q) volume := by
  obtain ⟨t, htE⟩ := hEne
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
  have hpoint : ∀ x : Euclidean d,
      ‖(testCoreSet d k).indicator (fun _ => (1 : ℂ)) x‖ₑ ≤
        ‖M E (fun y : Euclidean d => testProfile k ‖y‖) x‖ₑ := by
    intro x
    by_cases hx : x ∈ testCoreSet d k
    · have hx' : ∃ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ),
          ‖x‖ ∈ annulusCore k n := by
        unfold testCoreSet at hx
        simpa only [Set.mem_iUnion, Set.mem_setOf_eq, exists_prop] using hx
      obtain ⟨n, hn, hxn⟩ := hx'
      have havg : _root_.Spherical.sphericalAverage t
          (fun y : Euclidean d => testProfile k ‖y‖) x = 1 :=
        sphericalAverage_testProfile_eq_one hd hn hxn htIcc
      have hone : (1 : ENNReal) ≤ M E (fun y : Euclidean d => testProfile k ‖y‖) x := by
        unfold M _root_.Spherical.restrictedSphericalMaximal
        refine le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ ?_)
        rw [havg]
        simp
      calc
        ‖(testCoreSet d k).indicator (fun _ => (1 : ℂ)) x‖ₑ = 1 := by
          rw [Set.indicator_of_mem hx]
          simp
        _ ≤ _ := hone
    · rw [Set.indicator_of_notMem hx]
      simp
  have heq : eLpNorm ((testCoreSet d k).indicator (fun _ => (1 : ℂ)))
      (ENNReal.ofReal q) volume = volume (testCoreSet d k) ^ (1 / q) := by
    rw [eLpNorm_indicator_const (measurableSet_testCoreSet d k)
      (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hq)
      ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hq.le]
    simp
  rw [← heq]
  exact eLpNorm_mono_enorm hpoint

/-- All the fattened annuli lie between the radii `2^k` and `2^{k+1}`. -/
theorem testStarSet_subset_shell {d k : ℕ} (hk : 4 ≤ k) :
    testStarSet d k ⊆ radialAnnulusIcc d ((2 : ℝ) ^ k) ((2 : ℝ) ^ (k + 1)) := by
  intro x hx
  have hx' : ∃ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ), ‖x‖ ∈ annulusStar k n := by
    unfold testStarSet at hx
    simpa only [Set.mem_iUnion, Set.mem_setOf_eq, exists_prop] using hx
  obtain ⟨n, hn, hxn⟩ := hx'
  rw [Finset.mem_Icc] at hn
  rw [annulusStar, mem_Icc] at hxn
  have hncast : (n : ℝ) ≤ 2 ^ (k - 5) := by exact_mod_cast hn.2
  have hpow : ((2 : ℝ) ^ (k - 5)) * 8 + 7 ≤ (2 : ℝ) ^ k := by
    have hsplit : (2 : ℝ) ^ k = 2 ^ (k - 5) * 2 ^ 5 ∨ k < 5 := by
      rcases Nat.lt_or_ge k 5 with h | h
      · exact Or.inr h
      · left
        rw [← pow_add]
        congr 1
        omega
    rcases hsplit with hsplit | hlt
    · rw [hsplit]
      have h1 : (1 : ℝ) ≤ 2 ^ (k - 5) := one_le_pow₀ (by norm_num)
      nlinarith [h1]
    · interval_cases k
      · norm_num
  rw [radialAnnulusIcc, mem_setOf_eq, mem_Icc]
  refine ⟨by nlinarith [hxn.1, hn.1], ?_⟩
  have hupper : (2 : ℝ) ^ k + 8 * n + 7 ≤ (2 : ℝ) ^ (k + 1) := by
    rw [pow_succ]
    nlinarith [hncast, hpow]
  linarith [hxn.2, hupper]

/-- The volume of the union of the fattened annuli is at most the volume of
that shell. -/
theorem volume_testStarSet_le {d k : ℕ} (hd : 0 < d) (hk : 4 ≤ k) :
    volume (testStarSet d k) ≤
      ENNReal.ofReal (((2 : ℝ) ^ (k + 1)) ^ d - ((2 : ℝ) ^ k) ^ d) *
        volume (Metric.ball (0 : Euclidean d) 1) := by
  calc
    volume (testStarSet d k) ≤
        volume (radialAnnulusIcc d ((2 : ℝ) ^ k) ((2 : ℝ) ^ (k + 1))) :=
      measure_mono (testStarSet_subset_shell hk)
    _ = _ := volume_radialAnnulusIcc hd (by positivity)
        (by exact pow_le_pow_right₀ (by norm_num) (by omega))

/-- The core annuli are pairwise disjoint. -/
theorem pairwiseDisjoint_testCore (d k : ℕ) :
    ((Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ) : Set ℕ).PairwiseDisjoint
      (fun n => {x : Euclidean d | ‖x‖ ∈ annulusCore k n}) := by
  intro m _ n _ hmn
  rw [Function.onFun, Set.disjoint_left]
  intro x hxm hxn
  have hm : ‖x‖ ∈ annulusStar k m := annulusCore_subset_annulusStar k m hxm
  have hn : ‖x‖ ∈ annulusStar k n := annulusCore_subset_annulusStar k n hxn
  exact (Set.disjoint_left.mp (annulusStar_disjoint (k := k) hmn)) hm hn

/-- A lower bound for the volume of the union of the core annuli: each
contributes at least `2 · (2^k)^{d-1}` times the unit ball volume. -/
theorem volume_testCoreSet_ge {d k : ℕ} (hd : 0 < d) :
    ((2 ^ (k - 5) : ℕ) : ENNReal) *
        (ENNReal.ofReal (2 * ((2 : ℝ) ^ k) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1)) ≤
      volume (testCoreSet d k) := by
  have hterm : ∀ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ),
      ENNReal.ofReal (2 * ((2 : ℝ) ^ k) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1) ≤
        volume {x : Euclidean d | ‖x‖ ∈ annulusCore k n} := by
    intro n hn
    have hlow : (0 : ℝ) ≤ (2 : ℝ) ^ k + 8 * n + 3 := by positivity
    have hle : (2 : ℝ) ^ k + 8 * n + 3 ≤ (2 : ℝ) ^ k + 8 * n + 5 := by linarith
    have hvol : volume {x : Euclidean d | ‖x‖ ∈ annulusCore k n} =
        ENNReal.ofReal (((2 : ℝ) ^ k + 8 * n + 5) ^ d -
            ((2 : ℝ) ^ k + 8 * n + 3) ^ d) *
          volume (Metric.ball (0 : Euclidean d) 1) :=
      volume_radialAnnulusIcc hd hlow hle
    rw [hvol]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    obtain ⟨m, rfl⟩ : ∃ m, d = m + 1 := ⟨d - 1, by omega⟩
    have hpow := brrs_pow_sub_pow_ge hlow hle m
    have hmono : ((2 : ℝ) ^ k) ^ m ≤ ((2 : ℝ) ^ k + 8 * n + 3) ^ m := by
      refine pow_le_pow_left₀ (by positivity) ?_ m
      have : (0 : ℝ) ≤ 8 * n := by positivity
      linarith
    have harith : ((2 : ℝ) ^ k + 8 * n + 3) ^ m *
        (((2 : ℝ) ^ k + 8 * n + 5) - ((2 : ℝ) ^ k + 8 * n + 3)) =
        ((2 : ℝ) ^ k + 8 * n + 3) ^ m * 2 := by ring
    simp only [Nat.add_sub_cancel]
    nlinarith [hpow, hmono]
  calc
    ((2 ^ (k - 5) : ℕ) : ENNReal) *
        (ENNReal.ofReal (2 * ((2 : ℝ) ^ k) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1)) =
        ∑ _n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ),
          ENNReal.ofReal (2 * ((2 : ℝ) ^ k) ^ (d - 1)) *
            volume (Metric.ball (0 : Euclidean d) 1) := by
      rw [Finset.sum_const, Nat.card_Icc]
      simp [nsmul_eq_mul]
    _ ≤ ∑ n ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ),
          volume {x : Euclidean d | ‖x‖ ∈ annulusCore k n} :=
      Finset.sum_le_sum hterm
    _ = volume (testCoreSet d k) := by
      unfold testCoreSet
      exact (measure_biUnion_finset (pairwiseDisjoint_testCore d k)
        (fun n _ => measurableSet_radialAnnulusIcc d _ _)).symm

/-- The core volume bound in the normalized form `2^{kd}/16` times the unit
ball volume. -/
theorem volume_testCoreSet_ge' {d k : ℕ} (hd : 0 < d) (hk : 5 ≤ k) :
    ENNReal.ofReal ((2 : ℝ) ^ (k * d) / 16) *
        volume (Metric.ball (0 : Euclidean d) 1) ≤ volume (testCoreSet d k) := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 5 := ⟨k - 5, by omega⟩
  obtain ⟨m, rfl⟩ : ∃ m, d = m + 1 := ⟨d - 1, by omega⟩
  refine le_trans (le_of_eq ?_) (volume_testCoreSet_ge hd)
  have hcast : ((2 ^ (j + 5 - 5) : ℕ) : ENNReal) = ENNReal.ofReal ((2 : ℝ) ^ j) := by
    simp only [Nat.add_sub_cancel]
    rw [← ENNReal.ofReal_natCast]
    congr 1
    push_cast
    ring
  have key : (2 : ℝ) ^ ((j + 5) * (m + 1)) / 16 =
      (2 : ℝ) ^ j * (2 * ((2 : ℝ) ^ (j + 5)) ^ (m + 1 - 1)) := by
    simp only [Nat.add_sub_cancel]
    rw [← pow_mul, show (j + 5) * (m + 1) = (j + 5) * m + (j + 5) by ring, pow_add,
      show (2 : ℝ) ^ (j + 5) = 2 ^ j * 32 by rw [pow_add]; norm_num]
    ring
  rw [hcast, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity), key]

/-- The star volume bound in the normalized form `2^{kd}(2^d - 1)` times the
unit ball volume. -/
theorem volume_testStarSet_le' {d k : ℕ} (hd : 0 < d) (hk : 4 ≤ k) :
    volume (testStarSet d k) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (k * d) * (2 ^ d - 1)) *
        volume (Metric.ball (0 : Euclidean d) 1) := by
  refine le_trans (volume_testStarSet_le hd hk) (le_of_eq ?_)
  congr 2
  rw [← pow_mul, ← pow_mul, show (k + 1) * d = k * d + d by ring, pow_add]
  ring

set_option maxHeartbeats 1000000 in
/-- **BRS (3.1).**  The test functions witness the lower bound
`‖M_E f_k‖_q ≳ 2^{-kd(1/p - 1/q)} ‖f_k‖_p`. -/
theorem le_eLpNorm_M_testProfile_ratio {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    ∃ c : ℝ, 0 < c ∧ ∀ k : ℕ, 5 ≤ k →
      ENNReal.ofReal (c * (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) *
          eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume ≤
        eLpNorm (M E (fun x : Euclidean d => testProfile k ‖x‖))
          (ENNReal.ofReal q) volume := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V := by
    rw [hV]
    exact ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hd1 : (1 : ℝ) ≤ 2 ^ d := one_le_pow₀ (by norm_num)
  have hC1 : 0 < ((2 : ℝ) ^ d - 1 + 1) * V := by positivity
  set C1 : ℝ := (2 ^ d - 1) * V with hC1def
  have hC1pos : 0 < C1 := by
    rw [hC1def]
    have h2 : (1 : ℝ) < 2 ^ d := by
      have : (2 : ℝ) ^ 1 ≤ 2 ^ d := pow_le_pow_right₀ (by norm_num) hd
      simp only [pow_one] at this
      nlinarith
    have : (0 : ℝ) < 2 ^ d - 1 := by linarith
    positivity
  set C2 : ℝ := V / 16 with hC2def
  have hC2pos : 0 < C2 := by
    rw [hC2def]
    positivity
  refine ⟨C2 ^ (1 / q) / C1 ^ (1 / p), by positivity, ?_⟩
  intro k hk
  -- the two volume bounds, in `ofReal` form
  have hstar : eLpNorm (fun x : Euclidean d => testProfile k ‖x‖)
      (ENNReal.ofReal p) volume ≤ ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C1) ^ (1 / p)) := by
    rw [eLpNorm_testProfile_lift d k hp]
    have hle : volume (testStarSet d k) ≤
        ENNReal.ofReal ((2 : ℝ) ^ (k * d) * C1) := by
      refine le_trans (volume_testStarSet_le' hd (by omega)) (le_of_eq ?_)
      rw [hVeq, ← ENNReal.ofReal_mul (by positivity), hC1def]
      congr 1
      ring
    calc
      volume (testStarSet d k) ^ (1 / p) ≤
          (ENNReal.ofReal ((2 : ℝ) ^ (k * d) * C1)) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hle (by positivity)
      _ = ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C1) ^ (1 / p)) :=
        ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)
  have hcore : ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C2) ^ (1 / q)) ≤
      eLpNorm (M E (fun x : Euclidean d => testProfile k ‖x‖))
        (ENNReal.ofReal q) volume := by
    have hge : ENNReal.ofReal ((2 : ℝ) ^ (k * d) * C2) ≤ volume (testCoreSet d k) := by
      refine le_trans (le_of_eq ?_) (volume_testCoreSet_ge' hd hk)
      rw [hVeq, ← ENNReal.ofReal_mul (by positivity), hC2def]
      congr 1
      ring
    calc
      ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C2) ^ (1 / q)) =
          (ENNReal.ofReal ((2 : ℝ) ^ (k * d) * C2)) ^ (1 / q) :=
        (ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)).symm
      _ ≤ volume (testCoreSet d k) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hge (by positivity)
      _ ≤ _ := le_eLpNorm_M_testProfile_lift hd hE hEne hq
  -- the real-number inequality between the two explicit bounds
  have hpow : ∀ a : ℝ, 0 < a → ((2 : ℝ) ^ (k * d) * a) ^ (1 / p) =
      (2 : ℝ) ^ (((k : ℝ) * d) / p) * a ^ (1 / p) := by
    intro a ha
    rw [Real.mul_rpow (by positivity) ha.le, ← Real.rpow_natCast (2 : ℝ) (k * d),
      ← Real.rpow_mul (by norm_num)]
    congr 2
    · push_cast
      ring
  have hpowq : ∀ a : ℝ, 0 < a → ((2 : ℝ) ^ (k * d) * a) ^ (1 / q) =
      (2 : ℝ) ^ (((k : ℝ) * d) / q) * a ^ (1 / q) := by
    intro a ha
    rw [Real.mul_rpow (by positivity) ha.le, ← Real.rpow_natCast (2 : ℝ) (k * d),
      ← Real.rpow_mul (by norm_num)]
    congr 2
    · push_cast
      ring
  have hreal : (C2 ^ (1 / q) / C1 ^ (1 / p)) *
        (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q))) *
        ((2 : ℝ) ^ (k * d) * C1) ^ (1 / p) =
      ((2 : ℝ) ^ (k * d) * C2) ^ (1 / q) := by
    rw [hpow C1 hC1pos, hpowq C2 hC2pos]
    have hsplit : (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q))) *
        (2 : ℝ) ^ (((k : ℝ) * d) / p) = (2 : ℝ) ^ (((k : ℝ) * d) / q) := by
      rw [← Real.rpow_add (by norm_num)]
      congr 1
      field_simp
      ring
    calc
      (C2 ^ (1 / q) / C1 ^ (1 / p)) *
            (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q))) *
            ((2 : ℝ) ^ (((k : ℝ) * d) / p) * C1 ^ (1 / p)) =
          ((2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q))) *
            (2 : ℝ) ^ (((k : ℝ) * d) / p)) *
            (C2 ^ (1 / q) * (C1 ^ (1 / p) / C1 ^ (1 / p))) := by ring
      _ = (2 : ℝ) ^ (((k : ℝ) * d) / q) * C2 ^ (1 / q) := by
          rw [hsplit, div_self (by positivity : C1 ^ (1 / p) ≠ 0)]
          ring
  calc
    ENNReal.ofReal (C2 ^ (1 / q) / C1 ^ (1 / p) *
          (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) *
        eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (C2 ^ (1 / q) / C1 ^ (1 / p) *
          (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) *
          ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C1) ^ (1 / p)) :=
      mul_le_mul' le_rfl hstar
    _ = ENNReal.ofReal (((2 : ℝ) ^ (k * d) * C2) ^ (1 / q)) := by
      rw [← ENNReal.ofReal_mul (by positivity), ← hreal]
    _ ≤ _ := hcore

theorem isNormRadial_testProfile_lift (d k : ℕ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial
      (fun x : Euclidean d => testProfile k ‖x‖) := by
  intro x y hxy
  simp only [hxy]

theorem measurable_testProfile_lift (d k : ℕ) :
    Measurable (fun x : Euclidean d => testProfile k ‖x‖) :=
  (measurable_testProfile k).comp continuous_norm.measurable

theorem volume_testStarSet_lt_top {d k : ℕ} (hd : 0 < d) (hk : 4 ≤ k) :
    volume (testStarSet d k) < ⊤ := by
  refine lt_of_le_of_lt (volume_testStarSet_le' hd hk) ?_
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    ((measure_mono Metric.ball_subset_closedBall).trans_lt measure_closedBall_lt_top)

theorem volume_testStarSet_pos {d k : ℕ} (hd : 0 < d) : 0 < volume (testStarSet d k) := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hone : (1 : ℕ) ∈ (Finset.Icc 1 (2 ^ (k - 5)) : Finset ℕ) := by
    rw [Finset.mem_Icc]
    exact ⟨le_rfl, Nat.one_le_two_pow⟩
  have hsub : {x : Euclidean d | ‖x‖ ∈ annulusStar k 1} ⊆ testStarSet d k := by
    unfold testStarSet
    exact Set.subset_biUnion_of_mem
      (u := fun n : ℕ => {x : Euclidean d | ‖x‖ ∈ annulusStar k n}) hone
  refine lt_of_lt_of_le ?_ (measure_mono hsub)
  have hlow : (0 : ℝ) ≤ (2 : ℝ) ^ k + 8 * (1 : ℕ) + 1 := by positivity
  have hle : (2 : ℝ) ^ k + 8 * (1 : ℕ) + 1 ≤ (2 : ℝ) ^ k + 8 * (1 : ℕ) + 7 := by
    push_cast
    linarith
  rw [show {x : Euclidean d | ‖x‖ ∈ annulusStar k 1} =
      radialAnnulusIcc d ((2 : ℝ) ^ k + 8 * (1 : ℕ) + 1)
        ((2 : ℝ) ^ k + 8 * (1 : ℕ) + 7) from rfl,
    volume_radialAnnulusIcc hd hlow hle]
  refine ENNReal.mul_pos ?_ ?_
  · rw [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    have hstrict : (2 : ℝ) ^ k + 8 * (1 : ℕ) + 1 < (2 : ℝ) ^ k + 8 * (1 : ℕ) + 7 := by
      push_cast
      linarith
    have := pow_lt_pow_left₀ hstrict hlow hd.ne'
    linarith
  · exact (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos).ne'

theorem memLp_testProfile_lift {d k : ℕ} (hd : 0 < d) (hk : 4 ≤ k) {p : ℝ}
    (hp : 0 < p) :
    MemLp (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume := by
  refine ⟨(measurable_testProfile_lift d k).aestronglyMeasurable, ?_⟩
  rw [eLpNorm_testProfile_lift d k hp]
  exact ENNReal.rpow_lt_top_of_nonneg (by positivity)
    (volume_testStarSet_lt_top hd hk).ne

set_option maxHeartbeats 1000000 in
/-- **BRS Lemma 3.1.**  A radial `L^p → L^q` bound for the spherical maximal
operator with dilations in `E ⊆ [1,2]` forces `p ≤ q`. -/
theorem le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) : p ≤ q := by
  by_contra hcon
  have hqp : q < p := lt_of_not_ge hcon
  set δ : ℝ := 1 / q - 1 / p with hδ
  have hδpos : 0 < δ := by
    rw [hδ, sub_pos]
    exact one_div_lt_one_div_of_lt hq hqp
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨c, hc, hratio⟩ := le_eLpNorm_M_testProfile_ratio hd hE hEne hp hq
  -- the geometric factor stays bounded by `C / c`
  have hkey : ∀ k : ℕ, 5 ≤ k → c * (2 : ℝ) ^ ((k : ℝ) * d * δ) ≤ C := by
    intro k hk
    have hk4 : 4 ≤ k := by omega
    have hmem := memLp_testProfile_lift (d := d) (k := k) hd hk4 hp
    have hrad := isNormRadial_testProfile_lift d k
    obtain ⟨-, hupper⟩ := hbound _ hmem hrad
    have hlower := hratio k hk
    have hNpos : 0 < eLpNorm (fun x : Euclidean d => testProfile k ‖x‖)
        (ENNReal.ofReal p) volume := by
      rw [eLpNorm_testProfile_lift d k hp]
      exact ENNReal.rpow_pos (volume_testStarSet_pos hd)
        (volume_testStarSet_lt_top hd hk4).ne
    have hNtop : eLpNorm (fun x : Euclidean d => testProfile k ‖x‖)
        (ENNReal.ofReal p) volume ≠ ⊤ := hmem.eLpNorm_lt_top.ne
    have hchain : ENNReal.ofReal (c * (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) *
        eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C *
          eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume :=
      le_trans hlower hupper
    have hchain' : eLpNorm (fun x : Euclidean d => testProfile k ‖x‖)
          (ENNReal.ofReal p) volume *
          ENNReal.ofReal (c * (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) ≤
        eLpNorm (fun x : Euclidean d => testProfile k ‖x‖) (ENNReal.ofReal p) volume *
          ENNReal.ofReal C := by
      rw [mul_comm _ (ENNReal.ofReal
          (c * (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q))))),
        mul_comm _ (ENNReal.ofReal C)]
      exact hchain
    have hcancel : ENNReal.ofReal (c * (2 : ℝ) ^ (-((k : ℝ) * d * (1 / p - 1 / q)))) ≤
        ENNReal.ofReal C :=
      (ENNReal.mul_le_mul_iff_right hNpos.ne' hNtop).mp hchain'
    have hreal := (ENNReal.ofReal_le_ofReal_iff hC.le).mp hcancel
    have hexp : -((k : ℝ) * d * (1 / p - 1 / q)) = (k : ℝ) * d * δ := by
      rw [hδ]
      ring
    rwa [hexp] at hreal
  -- but the geometric factor is unbounded
  have hbase : (1 : ℝ) < (2 : ℝ) ^ ((d : ℝ) * δ) := by
    refine Real.one_lt_rpow_iff_of_pos (by norm_num) |>.mpr ?_
    refine Or.inl ⟨by norm_num, ?_⟩
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (C / c) hbase
  have hk : 5 ≤ n + 5 := by omega
  have hkey' := hkey (n + 5) hk
  have hpow : (2 : ℝ) ^ (((n + 5 : ℕ) : ℝ) * d * δ) =
      ((2 : ℝ) ^ ((d : ℝ) * δ)) ^ (n + 5) := by
    rw [← Real.rpow_natCast ((2 : ℝ) ^ ((d : ℝ) * δ)) (n + 5), ← Real.rpow_mul (by norm_num)]
    congr 1
    push_cast
    ring
  rw [hpow] at hkey'
  have hmono : ((2 : ℝ) ^ ((d : ℝ) * δ)) ^ n ≤ ((2 : ℝ) ^ ((d : ℝ) * δ)) ^ (n + 5) :=
    pow_le_pow_right₀ hbase.le (by omega)
  have hCc : C / c < ((2 : ℝ) ^ ((d : ℝ) * δ)) ^ (n + 5) := lt_of_lt_of_le hn hmono
  rw [div_lt_iff₀ hc] at hCc
  nlinarith [hkey', hCc]

/-! ## The thin shell test function of Lemma 3.2(i) -/

/-- The radial lift of an interval indicator is the indicator of the
corresponding annulus. -/
theorem indicator_lift_eq (d : ℕ) (a b : ℝ) :
    (fun x : Euclidean d => (Icc a b).indicator (fun _ => (1 : ℂ)) ‖x‖) =
      (radialAnnulusIcc d a b).indicator (fun _ => (1 : ℂ)) := by
  funext x
  by_cases hx : ‖x‖ ∈ Icc a b
  · have hx' : x ∈ radialAnnulusIcc d a b := hx
    rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx']
  · have hx' : x ∉ radialAnnulusIcc d a b := hx
    rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx']

theorem measurable_indicator_lift (d : ℕ) (a b : ℝ) :
    Measurable (fun x : Euclidean d => (Icc a b).indicator (fun _ => (1 : ℂ)) ‖x‖) := by
  rw [indicator_lift_eq]
  exact measurable_const.indicator (measurableSet_radialAnnulusIcc d a b)

theorem isNormRadial_indicator_lift (d : ℕ) (a b : ℝ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial
      (fun x : Euclidean d => (Icc a b).indicator (fun _ => (1 : ℂ)) ‖x‖) := by
  intro x y hxy
  simp only [hxy]

/-- The `L^p` norm of an annulus indicator. -/
theorem eLpNorm_indicator_lift (d : ℕ) (a b : ℝ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (fun x : Euclidean d => (Icc a b).indicator (fun _ => (1 : ℂ)) ‖x‖)
        (ENNReal.ofReal p) volume =
      volume (radialAnnulusIcc d a b) ^ (1 / p) := by
  rw [indicator_lift_eq,
    eLpNorm_indicator_const (measurableSet_radialAnnulusIcc d a b)
      (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hp)
      ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hp.le]
  simp

/-- A sphere of radius `t₀` centred within distance `δ` of the origin stays in
the shell of radii `[t₀ - δ, t₀ + δ]`, so the average of the shell indicator
is one. -/
theorem sphericalAverage_shell_eq_one {d : ℕ} (hd : 0 < d) {t₀ δ : ℝ}
    (ht₀ : 0 ≤ t₀) {x : Euclidean d} (hx : ‖x‖ ≤ δ) :
    _root_.Spherical.sphericalAverage t₀
        (fun y : Euclidean d =>
          (Icc (t₀ - δ) (t₀ + δ)).indicator (fun _ => (1 : ℂ)) ‖y‖) x = 1 := by
  have hpoint : ∀ ω : Metric.sphere (0 : Euclidean d) 1,
      (Icc (t₀ - δ) (t₀ + δ)).indicator (fun _ => (1 : ℂ))
        ‖x + t₀ • (ω : Euclidean d)‖ = 1 := by
    intro ω
    have hω : ‖(ω : Euclidean d)‖ = 1 := mem_sphere_zero_iff_norm.mp ω.2
    have hsmul : ‖t₀ • (ω : Euclidean d)‖ = t₀ := by
      rw [norm_smul, Real.norm_eq_abs, hω, mul_one, abs_of_nonneg ht₀]
    have hupper : ‖x + t₀ • (ω : Euclidean d)‖ ≤ t₀ + δ := by
      calc
        ‖x + t₀ • (ω : Euclidean d)‖ ≤ ‖x‖ + ‖t₀ • (ω : Euclidean d)‖ :=
          norm_add_le _ _
        _ = ‖x‖ + t₀ := by rw [hsmul]
        _ ≤ t₀ + δ := by linarith
    have hlower : t₀ - δ ≤ ‖x + t₀ • (ω : Euclidean d)‖ := by
      have h : ‖t₀ • (ω : Euclidean d)‖ ≤ ‖x + t₀ • (ω : Euclidean d)‖ + ‖x‖ := by
        have hsub := norm_sub_le (x + t₀ • (ω : Euclidean d)) x
        rwa [add_sub_cancel_left] at hsub
      rw [hsmul] at h
      linarith
    have hmem : ‖x + t₀ • (ω : Euclidean d)‖ ∈ Icc (t₀ - δ) (t₀ + δ) :=
      ⟨hlower, hupper⟩
    exact Set.indicator_of_mem hmem _
  rw [_root_.Spherical.sphericalAverage,
    integral_congr_ae (Filter.Eventually.of_forall hpoint), integral_const,
    unitSphereMeasure_real_univ hd, one_smul]

/-- Where the maximal function is at least one, its `L^q` norm dominates the
`q`-th root of the volume. -/
theorem le_eLpNorm_of_one_le_on {d : ℕ} {E : Set ℝ} {f : Euclidean d → ℂ}
    {S : Set (Euclidean d)} (hS : MeasurableSet S)
    (hone : ∀ x ∈ S, (1 : ENNReal) ≤ M E f x) {q : ℝ} (hq : 0 < q) :
    volume S ^ (1 / q) ≤ eLpNorm (M E f) (ENNReal.ofReal q) volume := by
  have hpoint : ∀ x : Euclidean d,
      ‖S.indicator (fun _ => (1 : ℂ)) x‖ₑ ≤ ‖M E f x‖ₑ := by
    intro x
    by_cases hx : x ∈ S
    · calc
        ‖S.indicator (fun _ => (1 : ℂ)) x‖ₑ = 1 := by
          rw [Set.indicator_of_mem hx]
          simp
        _ ≤ M E f x := hone x hx
    · rw [Set.indicator_of_notMem hx]
      simp
  have heq : eLpNorm (S.indicator (fun _ => (1 : ℂ))) (ENNReal.ofReal q) volume =
      volume S ^ (1 / q) := by
    rw [eLpNorm_indicator_const hS
      (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hq)
      ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hq.le]
    simp
  rw [← heq]
  exact eLpNorm_mono_enorm hpoint

/-- The volume of a ball, in the normalized form used below. -/
theorem volume_closedBall_eq {d : ℕ} (hd : 0 < d) {δ : ℝ} (hδ : 0 ≤ δ) :
    volume (Metric.closedBall (0 : Euclidean d) δ) =
      ENNReal.ofReal (δ ^ d) * volume (Metric.ball (0 : Euclidean d) 1) := by
  have hfr : Module.finrank ℝ (Euclidean d) = d := finrank_euclideanSpace_fin
  have h := Measure.addHaar_closedBall (volume : Measure (Euclidean d))
    (0 : Euclidean d) hδ
  rw [hfr] at h
  exact h

/-- A shell of half-width `δ` at radius in `[1,2]` has volume `O(δ)`. -/
theorem volume_thin_shell_le {d : ℕ} (hd : 0 < d) {t₀ δ : ℝ} (ht₀ : 1 ≤ t₀)
    (ht₀' : t₀ ≤ 2) (hδ : 0 < δ) (hδ' : δ ≤ 1) :
    volume (radialAnnulusIcc d (t₀ - δ) (t₀ + δ)) ≤
      ENNReal.ofReal (2 * d * 3 ^ (d - 1) * δ) *
        volume (Metric.ball (0 : Euclidean d) 1) := by
  have hlow : (0 : ℝ) ≤ t₀ - δ := by linarith
  have hle : t₀ - δ ≤ t₀ + δ := by linarith
  rw [volume_radialAnnulusIcc hd hlow hle]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  have hpowle : (t₀ - δ) ^ d ≤ (t₀ + δ) ^ d := pow_le_pow_left₀ hlow hle d
  have hmax : max |t₀ + δ| |t₀ - δ| ≤ 3 := by
    refine max_le ?_ ?_
    · rw [abs_of_nonneg (by linarith)]
      linarith
    · rw [abs_of_nonneg hlow]
      linarith
  have hmaxnonneg : (0 : ℝ) ≤ max |t₀ + δ| |t₀ - δ| :=
    le_trans (abs_nonneg _) (le_max_left _ _)
  calc
    (t₀ + δ) ^ d - (t₀ - δ) ^ d = |(t₀ + δ) ^ d - (t₀ - δ) ^ d| := by
      rw [abs_of_nonneg (sub_nonneg.mpr hpowle)]
    _ ≤ |(t₀ + δ) - (t₀ - δ)| * (d : ℝ) * max |t₀ + δ| |t₀ - δ| ^ (d - 1) :=
      abs_pow_sub_pow_le (t₀ + δ) (t₀ - δ) d
    _ ≤ (2 * δ) * (d : ℝ) * 3 ^ (d - 1) := by
      have hsep : |(t₀ + δ) - (t₀ - δ)| = 2 * δ := by
        rw [abs_of_nonneg (by linarith)]
        ring
      rw [hsep]
      gcongr
    _ = 2 * (d : ℝ) * 3 ^ (d - 1) * δ := by ring

set_option maxHeartbeats 1000000 in
/-- The thin-shell test inequality behind Lemma 3.2(i): a radial bound with
constant `C` forces the displayed inequality at every half-width `δ ≤ 1`. -/
theorem shell_test_inequality {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    {C : ℝ} (hC : 0 < C)
    (hbound : ∀ f : Euclidean d → ℂ, MemLp f (ENNReal.ofReal p) volume →
      _root_.Auto.RadialFourierTransform.IsNormRadial f →
        eLpNorm (M E f) (ENNReal.ofReal q) volume ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume)
    {δ : ℝ} (hδ : 0 < δ) (hδ' : δ ≤ 1) :
    (δ ^ d * (volume (Metric.ball (0 : Euclidean d) 1)).toReal) ^ (1 / q) ≤
      C * ((2 * d * 3 ^ (d - 1) * δ) *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) ^ (1 / p) := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  obtain ⟨t₀, ht₀E⟩ := hEne
  have ht₀ : t₀ ∈ Icc (1 : ℝ) 2 := hE ht₀E
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  set f : Euclidean d → ℂ := fun y =>
    (Icc (t₀ - δ) (t₀ + δ)).indicator (fun _ => (1 : ℂ)) ‖y‖ with hf
  have hannvol : volume (radialAnnulusIcc d (t₀ - δ) (t₀ + δ)) ≤
      ENNReal.ofReal ((2 * d * 3 ^ (d - 1) * δ) * V) := by
    refine le_trans (volume_thin_shell_le hd ht₀.1 ht₀.2 hδ hδ') (le_of_eq ?_)
    rw [hVeq, ← ENNReal.ofReal_mul (by positivity)]
  have hnormf : eLpNorm f (ENNReal.ofReal p) volume =
      volume (radialAnnulusIcc d (t₀ - δ) (t₀ + δ)) ^ (1 / p) :=
    eLpNorm_indicator_lift d _ _ hp
  have hmem : MemLp f (ENNReal.ofReal p) volume := by
    refine ⟨(measurable_indicator_lift d _ _).aestronglyMeasurable, ?_⟩
    rw [hnormf]
    refine ENNReal.rpow_lt_top_of_nonneg (by positivity) ?_
    exact (lt_of_le_of_lt hannvol ENNReal.ofReal_lt_top).ne
  have hrad := isNormRadial_indicator_lift d (t₀ - δ) (t₀ + δ)
  -- lower bound on the maximal function over the small ball
  have hone : ∀ x ∈ Metric.closedBall (0 : Euclidean d) δ, (1 : ENNReal) ≤ M E f x := by
    intro x hx
    rw [Metric.mem_closedBall, dist_zero_right] at hx
    have havg : _root_.Spherical.sphericalAverage t₀ f x = 1 :=
      sphericalAverage_shell_eq_one hd (le_trans zero_le_one ht₀.1) hx
    unfold M _root_.Spherical.restrictedSphericalMaximal
    refine le_iSup_of_le t₀ (le_iSup_of_le ⟨ht₀E, lt_of_lt_of_le zero_lt_one ht₀.1⟩ ?_)
    rw [havg]
    simp
  have hlow : ENNReal.ofReal ((δ ^ d * V) ^ (1 / q)) ≤
      eLpNorm (M E f) (ENNReal.ofReal q) volume := by
    refine le_trans (le_of_eq ?_)
      (le_eLpNorm_of_one_le_on measurableSet_closedBall hone hq)
    rw [volume_closedBall_eq hd hδ.le, hVeq, ← ENNReal.ofReal_mul (by positivity),
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
  have hup : eLpNorm f (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal (((2 * d * 3 ^ (d - 1) * δ) * V) ^ (1 / p)) := by
    rw [hnormf, ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    exact ENNReal.rpow_le_rpow hannvol (by positivity)
  have hchain : ENNReal.ofReal ((δ ^ d * V) ^ (1 / q)) ≤
      ENNReal.ofReal C *
        ENNReal.ofReal (((2 * d * 3 ^ (d - 1) * δ) * V) ^ (1 / p)) :=
    le_trans hlow (le_trans (hbound f hmem hrad) (mul_le_mul' le_rfl hup))
  rw [← ENNReal.ofReal_mul hC.le] at hchain
  exact (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hchain

set_option maxHeartbeats 1000000 in
/-- **BRS Lemma 3.2(i).**  A radial `L^p → L^q` bound for the spherical maximal
operator with dilations in a nonempty `E ⊆ [1,2]` forces `q ≤ pd`. -/
theorem le_mul_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    q ≤ p * d := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  by_contra hcon
  push_neg at hcon
  obtain ⟨C, hC, hbound'⟩ := h
  have hbound : ∀ f : Euclidean d → ℂ, MemLp f (ENNReal.ofReal p) volume →
      _root_.Auto.RadialFourierTransform.IsNormRadial f →
        eLpNorm (M E f) (ENNReal.ofReal q) volume ≤
          ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume :=
    fun f hf hrad => (hbound' f hf hrad).2
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  set K : ℝ := 2 * d * 3 ^ (d - 1) with hK
  have hKpos : 0 < K := by
    rw [hK]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  set u : ℝ := (2 : ℝ)⁻¹ with hu
  have hu0 : 0 < u := by rw [hu]; norm_num
  have hu1 : u < 1 := by rw [hu]; norm_num
  -- the exponent gap
  have hgap : (d : ℝ) / q - 1 / p < 0 := by
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    rw [sub_neg, div_lt_div_iff₀ hq hp]
    nlinarith [hcon]
  set a : ℝ := u ^ ((d : ℝ) / q) with ha
  set b : ℝ := u ^ ((1 : ℝ) / p) with hb
  have hapos : 0 < a := Real.rpow_pos_of_pos hu0 _
  have hbpos : 0 < b := Real.rpow_pos_of_pos hu0 _
  -- the ratio exceeds one
  have hratio : (1 : ℝ) < a / b := by
    rw [ha, hb, ← Real.rpow_sub hu0]
    exact (Real.one_lt_rpow_iff_of_pos hu0).mpr (Or.inr ⟨hu1, hgap⟩)
  -- the family of inequalities
  have hfam : ∀ k : ℕ, (a / b) ^ k ≤ C * (K * V) ^ (1 / p) / V ^ (1 / q) := by
    intro k
    have hδpos : (0 : ℝ) < u ^ k := pow_pos hu0 k
    have hδle : u ^ k ≤ 1 := pow_le_one₀ hu0.le hu1.le
    have hineq := shell_test_inequality hd hE hEne hp hq hC hbound hδpos hδle
    rw [← hV, ← hK] at hineq
    -- rewrite both sides in terms of `a` and `b`
    have hleft : ((u ^ k) ^ d * V) ^ (1 / q) = a ^ k * V ^ (1 / q) := by
      rw [Real.mul_rpow (by positivity) hVpos.le, ha]
      congr 1
      rw [← pow_mul, ← Real.rpow_natCast u (k * d), ← Real.rpow_mul hu0.le,
        ← Real.rpow_natCast (u ^ ((d : ℝ) / q)) k, ← Real.rpow_mul hu0.le]
      congr 1
      push_cast
      field_simp
    have hright : (K * u ^ k * V) ^ (1 / p) = (K * V) ^ (1 / p) * b ^ k := by
      rw [show K * u ^ k * V = (K * V) * u ^ k by ring,
        Real.mul_rpow (by positivity) (by positivity), hb]
      congr 1
      rw [← Real.rpow_natCast u k, ← Real.rpow_mul hu0.le,
        ← Real.rpow_natCast (u ^ ((1 : ℝ) / p)) k, ← Real.rpow_mul hu0.le]
      congr 1
      ring
    rw [hleft, hright] at hineq
    rw [div_pow, div_le_div_iff₀ (by positivity) (by positivity)]
    calc
      a ^ k * V ^ (1 / q) ≤ C * ((K * V) ^ (1 / p) * b ^ k) := hineq
      _ = C * (K * V) ^ (1 / p) * b ^ k := by ring
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt
    (C * (K * V) ^ (1 / p) / V ^ (1 / q)) hratio
  exact absurd (hfam n) (not_le.mpr hn)

/-! ## The origin-ball test function of Lemma 3.2(ii) -/

/-- The radial annulus from `0` to `δ` is the closed ball. -/
theorem radialAnnulusIcc_zero (d : ℕ) {δ : ℝ} (hδ : 0 ≤ δ) :
    radialAnnulusIcc d 0 δ = Metric.closedBall (0 : Euclidean d) δ := by
  ext x
  simp only [radialAnnulusIcc, mem_setOf_eq, mem_Icc, Metric.mem_closedBall,
    dist_zero_right]
  exact ⟨fun h => h.2, fun h => ⟨norm_nonneg x, h⟩⟩

set_option maxHeartbeats 1000000 in
/-- **The cap estimate behind (3.2).**  If the sphere of radius `t` about `x`
passes within `δ/2` of the origin, then the spherical average of the indicator
of the ball `B(0,δ)` is at least a constant times `δ^{d-1}`. -/
theorem le_sphericalAverage_ballProfile {d : ℕ} (hd : 0 < d) :
    ∃ c : ℝ, 0 < c ∧ ∀ (t δ : ℝ), 0 < δ → δ ≤ 1 → 1 ≤ t → t ≤ 2 →
      ∀ x : Euclidean d, |‖x‖ - t| ≤ δ / 2 →
        ENNReal.ofReal (c * δ ^ (d - 1)) ≤
          ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
            (fun y : Euclidean d => (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖) x‖ := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  obtain ⟨c₀, hc₀pos, hc₀top, hcap⟩ := exists_stein_unitSurfaceMeasure_cap_ge_power n
  have hmass : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  set c : ℝ := (c₀.toReal / 6 ^ n) / surfaceMass (n + 1) with hc
  have hc₀real : 0 < c₀.toReal := ENNReal.toReal_pos hc₀pos.ne' hc₀top
  have hcpos : 0 < c := by
    rw [hc]
    positivity
  refine ⟨c, hcpos, ?_⟩
  intro t δ hδ hδ1 ht1 ht2 x hx
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hxnorm : 0 < ‖x‖ := by
    rw [abs_le] at hx
    have : t - δ / 2 ≤ ‖x‖ := by linarith [hx.1]
    have hlow : 0 < t - δ / 2 := by linarith
    linarith
  have hxle : ‖x‖ ≤ 2 + 1 := by
    rw [abs_le] at hx
    linarith [hx.2]
  -- the inward cap of radius `δ / 4`
  set v : Euclidean (n + 1) := steinInwardRadialDirection x with hv
  have hvnorm : ‖v‖ = 1 := norm_steinInwardRadialDirection hxnorm
  set A : Set (Metric.sphere (0 : Euclidean (n + 1)) 1) :=
    steinSphericalCap (n + 1) v (δ / 6) with hA
  have hAmeas : MeasurableSet A := measurableSet_steinSphericalCap _ _ _
  -- points of the cap are carried into the ball
  have hone : ∀ ω ∈ A, (Icc 0 δ).indicator (fun _ => (1 : ℝ))
      ‖x + t • (ω : Euclidean (n + 1))‖ = 1 := by
    intro ω hω
    have hclose : ‖x + ‖x‖ • (ω : Euclidean (n + 1))‖ < ‖x‖ * (δ / 6) :=
      stein_inward_cap_translate_subset_ball hxnorm hω
    have hωnorm : ‖(ω : Euclidean (n + 1))‖ = 1 := mem_sphere_zero_iff_norm.mp ω.2
    have hdiff : ‖x + t • (ω : Euclidean (n + 1))‖ ≤
        ‖x + ‖x‖ • (ω : Euclidean (n + 1))‖ + |t - ‖x‖| := by
      have hsplit : x + t • (ω : Euclidean (n + 1)) =
          (x + ‖x‖ • (ω : Euclidean (n + 1))) +
            (t - ‖x‖) • (ω : Euclidean (n + 1)) := by
        module
      calc
        ‖x + t • (ω : Euclidean (n + 1))‖ ≤
            ‖x + ‖x‖ • (ω : Euclidean (n + 1))‖ +
              ‖(t - ‖x‖) • (ω : Euclidean (n + 1))‖ := by
          rw [hsplit]
          exact norm_add_le _ _
        _ = ‖x + ‖x‖ • (ω : Euclidean (n + 1))‖ + |t - ‖x‖| := by
          rw [norm_smul, Real.norm_eq_abs, hωnorm, mul_one]
    have habs : |t - ‖x‖| ≤ δ / 2 := by
      rw [abs_sub_comm]
      exact hx
    have hbound : ‖x + t • (ω : Euclidean (n + 1))‖ ≤ δ := by
      have h1 : ‖x‖ * (δ / 6) ≤ 3 * (δ / 6) := by
        have := hxle
        nlinarith [hδ.le]
      linarith [hdiff, habs, hclose.le, h1]
    have hmem : ‖x + t • (ω : Euclidean (n + 1))‖ ∈ Icc (0 : ℝ) δ :=
      ⟨norm_nonneg _, hbound⟩
    exact Set.indicator_of_mem hmem _
  -- integrability of the slice
  have hgmeas : Measurable
      (fun y : Euclidean (n + 1) => (Icc 0 δ).indicator (fun _ => (1 : ℝ)) ‖y‖) :=
    (measurable_const.indicator measurableSet_Icc).comp continuous_norm.measurable
  have hgb : ∀ y : Euclidean (n + 1),
      ‖(Icc 0 δ).indicator (fun _ => (1 : ℝ)) ‖y‖‖ ≤ 1 := by
    intro y
    by_cases hmem : ‖y‖ ∈ Icc (0 : ℝ) δ
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
      norm_num
  have hint := stein_integrable_sphere_comp_of_bounded_measurable hgmeas hgb t x
  have hnonneg : ∀ ω : Metric.sphere (0 : Euclidean (n + 1)) 1,
      0 ≤ (Icc 0 δ).indicator (fun _ => (1 : ℝ)) ‖x + t • (ω : Euclidean (n + 1))‖ := by
    intro ω
    by_cases hmem : ‖x + t • (ω : Euclidean (n + 1))‖ ∈ Icc (0 : ℝ) δ
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
  have hcapbound := hcap v hvnorm (δ / 6) (by positivity) (by linarith)
  have hfrac := stein_cap_fraction_le_ennreal_norm_normalizedSphericalAverage
    (by omega : 0 < n + 1)
    (fun y : Euclidean (n + 1) => (Icc 0 δ).indicator (fun _ => (1 : ℝ)) ‖y‖)
    t x A hAmeas hint hnonneg hone
  -- the average agrees with the normalized one
  have hbridge : _root_.Spherical.sphericalAverage t
      (fun y : Euclidean (n + 1) => (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖) x =
      normalizedSphericalAverage (n + 1)
        (fun y : Euclidean (n + 1) =>
          (((Icc 0 δ).indicator (fun _ => (1 : ℝ)) ‖y‖ : ℝ) : ℂ)) t x := by
    rw [_root_.Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
    congr 1
    funext y
    by_cases hmem : ‖y‖ ∈ Icc (0 : ℝ) δ
    · rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem, Set.indicator_of_notMem hmem]
      norm_num
  rw [hbridge]
  refine le_trans ?_ hfrac
  calc
    ENNReal.ofReal (c * δ ^ n) =
        ENNReal.ofReal (c₀.toReal * (δ / 6) ^ n) /
          ENNReal.ofReal (surfaceMass (n + 1)) := by
      have hreal : c * δ ^ n = (c₀.toReal * (δ / 6) ^ n) / surfaceMass (n + 1) := by
        rw [hc, div_pow]
        field_simp
      rw [hreal, ENNReal.ofReal_div_of_pos hmass]
    _ ≤ c₀ * ENNReal.ofReal ((δ / 6) ^ n) /
          ENNReal.ofReal (surfaceMass (n + 1)) := by
      refine ENNReal.div_le_div_right ?_ _
      rw [ENNReal.ofReal_mul (by positivity), ENNReal.ofReal_toReal hc₀top]
    _ ≤ unitSurfaceMeasure (n + 1) A / ENNReal.ofReal (surfaceMass (n + 1)) :=
      ENNReal.div_le_div_right hcapbound _

/-- A constant lower bound for the maximal function on a measurable set gives
a lower bound for its `L^q` norm. -/
theorem le_eLpNorm_of_const_le_on {d : ℕ} {E : Set ℝ} {f : Euclidean d → ℂ}
    {S : Set (Euclidean d)} (hS : MeasurableSet S) {c : ℝ} (hc : 0 ≤ c)
    (hle : ∀ x ∈ S, ENNReal.ofReal c ≤ M E f x) {q : ℝ} (hq : 0 < q) :
    ENNReal.ofReal c * volume S ^ (1 / q) ≤
      eLpNorm (M E f) (ENNReal.ofReal q) volume := by
  have hpoint : ∀ x : Euclidean d,
      ‖S.indicator (fun _ => (c : ℂ)) x‖ₑ ≤ ‖M E f x‖ₑ := by
    intro x
    by_cases hx : x ∈ S
    · calc
        ‖S.indicator (fun _ => (c : ℂ)) x‖ₑ = ENNReal.ofReal c := by
          rw [Set.indicator_of_mem hx]
          rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
        _ ≤ M E f x := hle x hx
    · rw [Set.indicator_of_notMem hx]
      simp
  have heq : eLpNorm (S.indicator (fun _ => (c : ℂ))) (ENNReal.ofReal q) volume =
      ENNReal.ofReal c * volume S ^ (1 / q) := by
    rw [eLpNorm_indicator_const hS
      (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hq)
      ENNReal.ofReal_ne_top, ENNReal.toReal_ofReal hq.le]
    congr 1
    rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_nonneg hc]
  rw [← heq]
  exact eLpNorm_mono_enorm hpoint

/-- The annuli attached to a `δ`-separated family of radii are pairwise
disjoint. -/
theorem pairwiseDisjoint_separated_annuli (d : ℕ) {δ : ℝ} (hδ : 0 < δ) {T : Finset ℝ}
    (hsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) :
    ((T : Set ℝ)).PairwiseDisjoint
      (fun t => radialAnnulusIcc d (t - δ / 4) (t + δ / 4)) := by
  intro t ht s hs hts
  rw [Function.onFun, Set.disjoint_left]
  intro x hxt hxs
  rw [radialAnnulusIcc, mem_setOf_eq, mem_Icc] at hxt hxs
  have hgap := hsep t ht s hs hts
  rcases le_total t s with h | h
  · rw [abs_of_nonpos (by linarith : t - s ≤ 0)] at hgap
    linarith [hxt.2, hxs.1]
  · rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ t - s)] at hgap
    linarith [hxs.2, hxt.1]

/-- The union of the annuli attached to a `δ`-separated family of radii in
`[1,2]` has volume at least a constant times the cardinality times `δ`. -/
theorem volume_biUnion_separated_annuli_ge {d : ℕ} (hd : 0 < d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ ≤ 1) {T : Finset ℝ} (hT : ∀ t ∈ T, t ∈ Icc (1 : ℝ) 2)
    (hsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) :
    (T.card : ENNReal) *
        (ENNReal.ofReal ((3 / 4 : ℝ) ^ (d - 1) * (δ / 2)) *
          volume (Metric.ball (0 : Euclidean d) 1)) ≤
      volume (⋃ t ∈ T, radialAnnulusIcc d (t - δ / 4) (t + δ / 4)) := by
  have hterm : ∀ t ∈ T,
      ENNReal.ofReal ((3 / 4 : ℝ) ^ (d - 1) * (δ / 2)) *
          volume (Metric.ball (0 : Euclidean d) 1) ≤
        volume (radialAnnulusIcc d (t - δ / 4) (t + δ / 4)) := by
    intro t ht
    have htmem := hT t ht
    have hlow : (0 : ℝ) ≤ t - δ / 4 := by
      have := htmem.1
      linarith
    have hle : t - δ / 4 ≤ t + δ / 4 := by linarith
    rw [volume_radialAnnulusIcc hd hlow hle]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    obtain ⟨m, rfl⟩ : ∃ m, d = m + 1 := ⟨d - 1, by omega⟩
    have hpow := brrs_pow_sub_pow_ge hlow hle m
    have hbase : (3 / 4 : ℝ) ≤ t - δ / 4 := by
      have := htmem.1
      linarith
    have hmono : ((3 : ℝ) / 4) ^ m ≤ (t - δ / 4) ^ m :=
      pow_le_pow_left₀ (by norm_num) hbase m
    simp only [Nat.add_sub_cancel]
    nlinarith [hpow, hmono, hδ.le]
  calc
    (T.card : ENNReal) *
        (ENNReal.ofReal ((3 / 4 : ℝ) ^ (d - 1) * (δ / 2)) *
          volume (Metric.ball (0 : Euclidean d) 1)) =
        ∑ _t ∈ T, ENNReal.ofReal ((3 / 4 : ℝ) ^ (d - 1) * (δ / 2)) *
          volume (Metric.ball (0 : Euclidean d) 1) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ ≤ ∑ t ∈ T, volume (radialAnnulusIcc d (t - δ / 4) (t + δ / 4)) :=
      Finset.sum_le_sum hterm
    _ = volume (⋃ t ∈ T, radialAnnulusIcc d (t - δ / 4) (t + δ / 4)) :=
      (measure_biUnion_finset (pairwiseDisjoint_separated_annuli d hδ hsep)
        (fun t _ => measurableSet_radialAnnulusIcc d _ _)).symm

set_option maxHeartbeats 1600000 in
/-- **BRS (3.2), Lemma 3.2(ii)**, in separated-set form: for every `δ`-separated
subset `T` of `E`, the radial operator norm is at least
`(card T)^{1/q} δ^{d-1+1/q-d/p}` up to a constant. -/
theorem le_eLpNorm_ratio_separated {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq : 0 < q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 1 → ∀ T : Finset ℝ,
      (↑T : Set ℝ) ⊆ E → (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
        ENNReal.ofReal (c * (T.card : ℝ) ^ (1 / q) *
              δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p)) *
            eLpNorm (fun y : Euclidean d => (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖)
              (ENNReal.ofReal p) volume ≤
          eLpNorm (M E (fun y : Euclidean d =>
            (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖)) (ENNReal.ofReal q) volume := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  have hpinv : (0 : ℝ) ≤ 1 / p := le_of_lt (div_pos one_pos hp)
  have hqinv : (0 : ℝ) ≤ 1 / q := le_of_lt (div_pos one_pos hq)
  obtain ⟨c0, hc0, hcap⟩ := le_sphericalAverage_ballProfile hd
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  set c1 : ℝ := (3 / 4 : ℝ) ^ (d - 1) / 2 with hc1
  have hc1pos : 0 < c1 := by
    rw [hc1]
    have hbase : (0 : ℝ) < (3 / 4 : ℝ) ^ (d - 1) := pow_pos (by norm_num) _
    linarith
  refine ⟨c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p),
    div_pos (mul_pos hc0 (Real.rpow_pos_of_pos (mul_pos hc1pos hVpos) _))
      (Real.rpow_pos_of_pos hVpos _), ?_⟩
  intro δ hδ hδ1 T hTE hsep
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  have hδd : (0 : ℝ) ≤ δ ^ d := pow_nonneg hδ.le d
  have hδd1 : (0 : ℝ) ≤ δ ^ (d - 1) := pow_nonneg hδ.le _
  set f : Euclidean d → ℂ :=
    fun y => (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖ with hf
  set S : Set (Euclidean d) :=
    ⋃ t ∈ T, radialAnnulusIcc d (t - δ / 4) (t + δ / 4) with hS
  have hSmeas : MeasurableSet S := by
    rw [hS]
    exact Finset.measurableSet_biUnion _ fun t _ => measurableSet_radialAnnulusIcc d _ _
  have hlarge : ∀ x ∈ S, ENNReal.ofReal (c0 * δ ^ (d - 1)) ≤ M E f x := by
    intro x hx
    have hx2 : ∃ t ∈ T, x ∈ radialAnnulusIcc d (t - δ / 4) (t + δ / 4) := by
      rw [hS] at hx
      simpa only [Set.mem_iUnion, exists_prop] using hx
    obtain ⟨t, htT, hxt⟩ := hx2
    have htE : t ∈ E := hTE htT
    have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
    have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
    have hclose : |‖x‖ - t| ≤ δ / 2 := by
      rw [radialAnnulusIcc, mem_setOf_eq, mem_Icc] at hxt
      rw [abs_le]
      constructor
      · linarith [hxt.1]
      · linarith [hxt.2]
    have havg := hcap t δ hδ hδ1 htIcc.1 htIcc.2 x hclose
    refine le_trans havg ?_
    unfold M _root_.Spherical.restrictedSphericalMaximal
    exact le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ le_rfl)
  have hlow : ENNReal.ofReal (c0 * δ ^ (d - 1)) * volume S ^ (1 / q) ≤
      eLpNorm (M E f) (ENNReal.ofReal q) volume :=
    le_eLpNorm_of_const_le_on hSmeas (mul_nonneg hc0.le hδd1) hlarge hq
  have hvol : ENNReal.ofReal ((T.card : ℝ) * (c1 * δ) * V) ≤ volume S := by
    have hkey : ENNReal.ofReal ((T.card : ℝ) * (c1 * δ) * V) =
        (T.card : ENNReal) *
          (ENNReal.ofReal ((3 / 4 : ℝ) ^ (d - 1) * (δ / 2)) *
            ENNReal.ofReal V) := by
      rw [ENNReal.ofReal_mul (mul_nonneg hcard (mul_nonneg hc1pos.le hδ.le)),
        ENNReal.ofReal_mul hcard, ENNReal.ofReal_natCast, mul_assoc]
      congr 2
      rw [hc1]
      ring
    rw [hkey, ← hVeq, hS]
    exact volume_biUnion_separated_annuli_ge hd hδ hδ1 (fun t ht => hE (hTE ht)) hsep
  have hnorm : eLpNorm f (ENNReal.ofReal p) volume =
      ENNReal.ofReal ((δ ^ d * V) ^ (1 / p)) := by
    rw [hf, eLpNorm_indicator_lift d 0 δ hp, radialAnnulusIcc_zero d hδ.le,
      volume_closedBall_eq hd hδ.le, hVeq, ← ENNReal.ofReal_mul hδd,
      ENNReal.ofReal_rpow_of_nonneg (mul_nonneg hδd hVpos.le) hpinv]
  have hreal : (c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p)) * (T.card : ℝ) ^ (1 / q) *
        δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) * (δ ^ d * V) ^ (1 / p) ≤
      c0 * δ ^ (d - 1) * ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q) := by
    have hδpow : (δ : ℝ) ^ (d - 1) = δ ^ ((d : ℝ) - 1) := by
      rw [← Real.rpow_natCast δ (d - 1)]
      congr 1
      have h1 : (1 : ℕ) ≤ d := hd
      push_cast [Nat.cast_sub h1]
      ring
    have hsplitp : (δ ^ d * V) ^ (1 / p) = δ ^ ((d : ℝ) / p) * V ^ (1 / p) := by
      rw [Real.mul_rpow hδd hVpos.le, ← Real.rpow_natCast δ d,
        ← Real.rpow_mul hδ.le]
      congr 2
      ring
    have hsplitq : ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q) =
        (T.card : ℝ) ^ (1 / q) * δ ^ ((1 : ℝ) / q) * (c1 * V) ^ (1 / q) := by
      rw [show (T.card : ℝ) * (c1 * δ) * V = ((T.card : ℝ) * δ) * (c1 * V) by ring,
        Real.mul_rpow (mul_nonneg hcard hδ.le) (mul_nonneg hc1pos.le hVpos.le),
        Real.mul_rpow hcard hδ.le]
    rw [hδpow, hsplitp, hsplitq]
    have hcollect : δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) * δ ^ ((d : ℝ) / p) =
        δ ^ ((d : ℝ) - 1) * δ ^ ((1 : ℝ) / q) := by
      rw [← Real.rpow_add hδ, ← Real.rpow_add hδ]
      congr 1
      ring
    have hVcancel : V ^ (1 / p) / V ^ (1 / p) = 1 :=
      div_self (ne_of_gt (Real.rpow_pos_of_pos hVpos _))
    calc
      c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p) * (T.card : ℝ) ^ (1 / q) *
            δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) *
            (δ ^ ((d : ℝ) / p) * V ^ (1 / p)) =
          (c0 * (T.card : ℝ) ^ (1 / q) * (c1 * V) ^ (1 / q)) *
            (δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) * δ ^ ((d : ℝ) / p)) *
            (V ^ (1 / p) / V ^ (1 / p)) := by ring
      _ = c0 * δ ^ ((d : ℝ) - 1) *
            ((T.card : ℝ) ^ (1 / q) * δ ^ ((1 : ℝ) / q) * (c1 * V) ^ (1 / q)) := by
          rw [hcollect, hVcancel]
          ring
      _ ≤ c0 * δ ^ ((d : ℝ) - 1) *
            ((T.card : ℝ) ^ (1 / q) * δ ^ ((1 : ℝ) / q) * (c1 * V) ^ (1 / q)) := le_rfl
  have hAnn : (0 : ℝ) ≤ c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p) *
      (T.card : ℝ) ^ (1 / q) * δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) :=
    mul_nonneg (mul_nonneg (le_of_lt
      (div_pos (mul_pos hc0 (Real.rpow_pos_of_pos (mul_pos hc1pos hVpos) _))
        (Real.rpow_pos_of_pos hVpos _))) (Real.rpow_nonneg hcard _))
      (Real.rpow_nonneg hδ.le _)
  calc
    ENNReal.ofReal (c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p) * (T.card : ℝ) ^ (1 / q) *
          δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p)) *
        eLpNorm f (ENNReal.ofReal p) volume =
        ENNReal.ofReal ((c0 * (c1 * V) ^ (1 / q) / V ^ (1 / p)) *
          (T.card : ℝ) ^ (1 / q) * δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) *
            (δ ^ d * V) ^ (1 / p)) := by
      rw [hnorm, ← ENNReal.ofReal_mul hAnn]
    _ ≤ ENNReal.ofReal (c0 * δ ^ (d - 1) *
          ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q)) := ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (c0 * δ ^ (d - 1)) *
          ENNReal.ofReal (((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q)) := by
      rw [ENNReal.ofReal_mul (mul_nonneg hc0.le hδd1)]
    _ ≤ ENNReal.ofReal (c0 * δ ^ (d - 1)) * volume S ^ (1 / q) := by
      refine mul_le_mul' le_rfl ?_
      rw [← ENNReal.ofReal_rpow_of_nonneg
        (mul_nonneg (mul_nonneg hcard (mul_nonneg hc1pos.le hδ.le)) hVpos.le) hqinv]
      exact ENNReal.rpow_le_rpow hvol hqinv
    _ ≤ _ := hlow

/-! ## Separated sets and covering numbers

A maximal `δ`-separated subset of `E` is in particular a `δ`-cover of `E`, so
its cardinality dominates the covering number at radius `δ`, hence the
entropy number at scale `2δ`. -/

/-- A maximal `δ`-separated subset of `E` covers `E` at radius `δ`. -/
theorem isCover_of_isMaximalSeparatedSubset {E : Set ℝ} {δ : ℝ≥0} (hδ : 0 < δ)
    {T : Finset ℝ} (hT : IsMaximalSeparatedSubset E (δ : ℝ) T) :
    Metric.IsCover δ E (↑T : Set ℝ) := by
  intro x hx
  have hδ' : (0 : ℝ) < (δ : ℝ) := hδ
  obtain ⟨t, htT, hlt⟩ :=
    IsMaximalSeparatedSubset.exists_mem_abs_sub_lt hT hδ' hx
  refine ⟨t, htT, ?_⟩
  show edist x t ≤ (δ : ℝ≥0∞)
  rw [edist_dist, Real.dist_eq]
  calc
    ENNReal.ofReal |x - t| ≤ ENNReal.ofReal (δ : ℝ) :=
      ENNReal.ofReal_le_ofReal hlt.le
    _ = (δ : ℝ≥0∞) := ENNReal.ofReal_coe_nnreal

/-- The covering number at radius `δ` is at most the cardinality of any
maximal `δ`-separated subset. -/
theorem externalCoveringNumber_le_card_of_isMaximalSeparatedSubset {E : Set ℝ}
    {δ : ℝ≥0} (hδ : 0 < δ) {T : Finset ℝ}
    (hT : IsMaximalSeparatedSubset E (δ : ℝ) T) :
    Metric.externalCoveringNumber δ E ≤ (T.card : ℕ∞) := by
  have hcover := isCover_of_isMaximalSeparatedSubset hδ hT
  calc
    Metric.externalCoveringNumber δ E ≤ (↑T : Set ℝ).encard := by
      exact iInf₂_le (↑T : Set ℝ) hcover
    _ = (T.card : ℕ∞) := Set.encard_coe_eq_coe_finsetCard T

/-- The BRS entropy number at scale `2δ` is at most the cardinality of any
maximal `δ`-separated subset. -/
theorem brrsEntropyNumber_le_card_of_isMaximalSeparatedSubset {E : Set ℝ}
    {δ : ℝ≥0} (hδ : 0 < δ) {T : Finset ℝ}
    (hT : IsMaximalSeparatedSubset E (δ : ℝ) T) :
    _root_.Auto.Spherical.LegendreAssouad.brrsEntropyNumber E (2 * δ) ≤
      (T.card : ℝ≥0∞) := by
  have hhalf : (2 * δ) / 2 = δ := by
    rw [mul_comm]
    field_simp
  rw [_root_.Auto.Spherical.LegendreAssouad.brrsEntropyNumber, hhalf]
  exact_mod_cast externalCoveringNumber_le_card_of_isMaximalSeparatedSubset hδ hT


/-! ## Covering numbers and the dimensional necessary condition -/

section CoveringNecessary

open Auto.FractalDimensions

/-- A maximal `δ`-separated subset of `E` gives an interval cover at scale
`2δ`, so it dominates the interval covering number there. -/
theorem intervalCoveringNumber_le_card_of_isMaximalSeparatedSubset {E : Set ℝ}
    {δ : ℝ} (hδ : 0 < δ) {T : Finset ℝ} (hT : IsMaximalSeparatedSubset E δ T) :
    intervalCoveringNumber E (2 * δ) ≤ T.card := by
  refine intervalCoveringNumber_le_card ?_
  intro x hx
  obtain ⟨t, htT, hlt⟩ := IsMaximalSeparatedSubset.exists_mem_abs_sub_lt hT hδ hx
  have h := abs_lt.mp hlt
  refine Set.mem_biUnion htT ?_
  refine Set.mem_Icc.mpr ⟨?_, ?_⟩ <;> [linarith [h.2]; linarith [h.1]]

/-- Every `E ⊆ [1,2]` admits a maximal `δ`-separated finite subset. -/
theorem exists_isMaximalSeparatedSubset {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) : ∃ T : Finset ℝ, IsMaximalSeparatedSubset E δ T := by
  obtain ⟨T, hT, -⟩ :=
    exists_isMaximalSeparatedSubset_superset_of_isSeparated (U := (∅ : Finset ℝ))
      hE hδ (by simp) (by intro s hs; simp at hs)
  exact ⟨T, hT⟩

/-- A nonempty set has positive interval covering number. -/
theorem intervalCoveringNumber_pos {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {δ : ℝ} (hδ : 0 < δ) :
    0 < intervalCoveringNumber E δ := by
  by_contra hcon
  push Not at hcon
  have hzero : intervalCoveringNumber E δ = 0 := Nat.le_zero.mp hcon
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  have hempty : ι = ∅ := Finset.card_eq_zero.mp (by rw [hcard, hzero])
  obtain ⟨x, hx⟩ := hEne
  have hmem := hι hx
  rw [hempty] at hmem
  simp at hmem

/-- The scalar form of (3.2) available under a radial `L^p -> L^q` bound:
the covering number of `E` at scale `2δ` obeys
`N(E,2δ)^{1/q} δ^{d-1+1/q-d/p} ≤ K` for all `0 < δ ≤ 1`. -/
theorem coveringNumber_test_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ K : ℝ, 0 < K ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 1 →
      ((intervalCoveringNumber E (2 * δ) : ℝ)) ^ (1 / q) *
          δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) ≤ K := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨c, hc, h32⟩ := le_eLpNorm_ratio_separated hd hE hp hq
  refine ⟨C / c, div_pos hC hc, ?_⟩
  intro δ hδ hδ1
  obtain ⟨T, hT⟩ := exists_isMaximalSeparatedSubset hE hδ
  have hsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s| := by
    intro t ht s hs hts
    exact hT.2.1 (by simpa using ht) (by simpa using hs) hts
  set f : Euclidean d → ℂ :=
    fun y => (Icc 0 δ).indicator (fun _ => (1 : ℂ)) ‖y‖ with hf
  have hnormf : eLpNorm f (ENNReal.ofReal p) volume =
      volume (radialAnnulusIcc d 0 δ) ^ (1 / p) :=
    eLpNorm_indicator_lift d _ _ hp
  have hballvol : volume (radialAnnulusIcc d 0 δ) =
      volume (Metric.closedBall (0 : Euclidean d) δ) := by
    rw [radialAnnulusIcc_zero d hδ.le]
  have hvoltop : volume (radialAnnulusIcc d 0 δ) ≠ ⊤ := by
    rw [hballvol]; exact measure_closedBall_lt_top.ne
  have hvolpos : 0 < volume (radialAnnulusIcc d 0 δ) := by
    rw [hballvol]
    exact Metric.measure_closedBall_pos volume (0 : Euclidean d) hδ
  have hNpos : 0 < eLpNorm f (ENNReal.ofReal p) volume := by
    rw [hnormf]
    exact ENNReal.rpow_pos hvolpos hvoltop
  have hNtop : eLpNorm f (ENNReal.ofReal p) volume ≠ ⊤ := by
    rw [hnormf]
    exact (ENNReal.rpow_lt_top_of_nonneg (by positivity) hvoltop).ne
  have hmem : MemLp f (ENNReal.ofReal p) volume := by
    refine ⟨(measurable_indicator_lift d _ _).aestronglyMeasurable, ?_⟩
    rw [hnormf]
    exact ENNReal.rpow_lt_top_of_nonneg (by positivity) hvoltop
  have hrad := isNormRadial_indicator_lift d 0 δ
  have hchain :
      ENNReal.ofReal (c * (T.card : ℝ) ^ (1 / q) *
            δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p)) *
          eLpNorm f (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume :=
    le_trans (h32 δ hδ hδ1 T hT.1 hsep) ((hbound f hmem hrad).2)
  rw [mul_comm _ (eLpNorm f (ENNReal.ofReal p) volume),
    mul_comm _ (eLpNorm f (ENNReal.ofReal p) volume)] at hchain
  have hcancel : ENNReal.ofReal (c * (T.card : ℝ) ^ (1 / q) *
      δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p)) ≤ ENNReal.ofReal C :=
    (ENNReal.mul_le_mul_iff_right hNpos.ne' hNtop).mp hchain
  have hreal := (ENNReal.ofReal_le_ofReal_iff hC.le).mp hcancel
  -- pass from the separated set to the covering number
  have hcov : (intervalCoveringNumber E (2 * δ) : ℝ) ≤ (T.card : ℝ) := by
    exact_mod_cast intervalCoveringNumber_le_card_of_isMaximalSeparatedSubset hδ hT
  have hmono : ((intervalCoveringNumber E (2 * δ) : ℝ)) ^ (1 / q) ≤
      (T.card : ℝ) ^ (1 / q) :=
    Real.rpow_le_rpow (Nat.cast_nonneg _) hcov (by positivity)
  have hδpow : (0 : ℝ) < δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) :=
    Real.rpow_pos_of_pos hδ _
  rw [le_div_iff₀ hc]
  calc
    ((intervalCoveringNumber E (2 * δ) : ℝ)) ^ (1 / q) *
          δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) * c
        ≤ (T.card : ℝ) ^ (1 / q) * δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) * c := by
      have := mul_le_mul_of_nonneg_right hmono hδpow.le
      exact mul_le_mul_of_nonneg_right this hc.le
    _ = c * (T.card : ℝ) ^ (1 / q) * δ ^ ((d : ℝ) - 1 + 1 / q - (d : ℝ) / p) := by
      ring
    _ ≤ C := hreal

/-- **The dimensional necessary condition of BRS Lemma 3.2(ii).**  A radial
`L^p -> L^q` bound for the spherical maximal operator with dilations in a
nonempty `E ⊆ [1,2]` of upper Minkowski dimension `β` forces
`(1-β)/q + d - 1 - d/p ≥ 0`. -/
theorem dim_le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ}
    (hβ : upperMinkowskiDimension E = β) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    0 ≤ (1 - β) / q + (d : ℝ) - 1 - (d : ℝ) / p := by
  have hqne : q ≠ 0 := hq.ne'
  have hpne : p ≠ 0 := hp.ne'
  set B : ℝ := (d : ℝ) - 1 + 1 / q - (d : ℝ) / p with hBdef
  obtain ⟨K, hK, hbound⟩ :=
    coveringNumber_test_bound_of_hasRadialStrongType hd hE hp hq h
  have hβ0 : 0 ≤ β := hβ ▸ upperMinkowskiDimension_nonneg_of_subset_Icc hE
  by_contra hcon
  push Not at hcon
  have hEq : (1 - β) / q + (d : ℝ) - 1 - (d : ℝ) / p = B - β / q := by
    rw [hBdef]
    field_simp
    ring
  have h2 : B < β / q := by
    rw [hEq] at hcon
    linarith
  have hqB : q * B < β := by
    rw [lt_div_iff₀ hq] at h2
    calc q * B = B * q := mul_comm _ _
      _ < β := h2
  rcases lt_or_ge B 0 with hB | hB
  · -- the covering number is at least one, and `δ ^ B` is unbounded
    set δ : ℝ := (K + 1) ^ (1 / B) with hδdef
    have hδpos : 0 < δ := Real.rpow_pos_of_pos (by linarith) _
    have hδle : δ ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith)
        (le_of_lt (div_neg_of_pos_of_neg one_pos hB))
    have hδB : δ ^ B = K + 1 := by
      rw [hδdef, ← Real.rpow_mul (by linarith), one_div_mul_cancel hB.ne,
        Real.rpow_one]
    have hone : (1 : ℝ) ≤ ((intervalCoveringNumber E (2 * δ) : ℝ)) ^ (1 / q) := by
      have hNpos : 0 < intervalCoveringNumber E (2 * δ) :=
        intervalCoveringNumber_pos hE hEne (by linarith)
      have hN1 : (1 : ℝ) ≤ (intervalCoveringNumber E (2 * δ) : ℝ) := by
        exact_mod_cast hNpos
      calc (1 : ℝ) = (1 : ℝ) ^ (1 / q) := (Real.one_rpow _).symm
        _ ≤ _ := Real.rpow_le_rpow zero_le_one hN1 (by positivity)
    have hb := hbound δ hδpos hδle
    rw [hδB] at hb
    nlinarith [hb, hone, hK]
  · -- the dimension witness beats the bound at small scales
    have hα0 : 0 ≤ q * B := mul_nonneg hq.le hB
    obtain ⟨ε, hε, hwit⟩ :=
      exists_upperMinkowski_coveringNumber_lower_witness_at_small_scale hE hβ hα0 hqB
    have hεne : ε ≠ 0 := hε.ne'
    have h2B : (0 : ℝ) < (2 : ℝ) ^ B := Real.rpow_pos_of_pos (by norm_num) _
    set M : ℝ := K * (2 : ℝ) ^ B with hM
    have hMpos : 0 < M := by
      rw [hM]; exact mul_pos hK h2B
    set δ₀ : ℝ := M ^ (-(q / ε)) with hδ₀
    have hδ₀pos : 0 < δ₀ := Real.rpow_pos_of_pos hMpos _
    obtain ⟨δ, hδpos, hδlt₀, hδlt1, hwitδ⟩ := hwit 1 one_pos δ₀ hδ₀pos
    have hb := hbound (δ / 2) (by positivity) (by linarith)
    rw [show 2 * (δ / 2) = δ by ring] at hb
    have hδrp : (0 : ℝ) < δ ^ (-(q * B + ε)) := Real.rpow_pos_of_pos hδpos _
    have hNlow : δ ^ (-(q * B + ε) / q) ≤
        ((intervalCoveringNumber E δ : ℝ)) ^ (1 / q) := by
      have h1 : δ ^ (-(q * B + ε)) ≤ (intervalCoveringNumber E δ : ℝ) := by
        have h1' := hwitδ
        rw [one_mul] at h1'
        exact h1'.le
      calc δ ^ (-(q * B + ε) / q)
          = (δ ^ (-(q * B + ε))) ^ (1 / q) := by
            rw [← Real.rpow_mul hδpos.le]
            congr 1
            field_simp
        _ ≤ _ := Real.rpow_le_rpow hδrp.le h1 (by positivity)
    have hhalf : (δ / 2) ^ B = δ ^ B / (2 : ℝ) ^ B :=
      Real.div_rpow hδpos.le (by norm_num : (0:ℝ) ≤ 2) B
    rw [hhalf] at hb
    have hcomb : δ ^ (-(q * B + ε) / q) * δ ^ B = δ ^ (-(ε / q)) := by
      rw [← Real.rpow_add hδpos]
      congr 1
      field_simp
      ring
    have hstep : δ ^ (-(ε / q)) / (2 : ℝ) ^ B ≤ K := by
      calc δ ^ (-(ε / q)) / (2 : ℝ) ^ B
          = (δ ^ (-(q * B + ε) / q) * δ ^ B) / (2 : ℝ) ^ B := by rw [hcomb]
        _ = δ ^ (-(q * B + ε) / q) * (δ ^ B / (2 : ℝ) ^ B) := by ring
        _ ≤ ((intervalCoveringNumber E δ : ℝ)) ^ (1 / q) *
              (δ ^ B / (2 : ℝ) ^ B) :=
            mul_le_mul_of_nonneg_right hNlow (by positivity)
        _ ≤ K := hb
    have hneg : -(ε / q) < 0 := by
      have hpos : 0 < ε / q := div_pos hε hq
      linarith
    have hδ₀eq : δ₀ ^ (-(ε / q)) = M := by
      rw [hδ₀, ← Real.rpow_mul hMpos.le,
        show -(q / ε) * -(ε / q) = 1 by field_simp, Real.rpow_one]
    have hbig : M < δ ^ (-(ε / q)) := by
      have h1 : δ₀ ^ (-(ε / q)) < δ ^ (-(ε / q)) :=
        Real.rpow_lt_rpow_of_neg hδpos hδlt₀ hneg
      rw [hδ₀eq] at h1
      exact h1
    rw [div_le_iff₀ h2B] at hstep
    rw [hM] at hbig
    linarith

end CoveringNecessary


/-! ## The exponent triangle and the endpoint exclusions -/

/-- A convex combination of three points lies in their convex hull. -/
theorem mem_convexHull_triple {A B C P : ℝ × ℝ} {s t u : ℝ} (hs : 0 ≤ s)
    (ht : 0 ≤ t) (hu : 0 ≤ u) (hsum : s + t + u = 1)
    (hP : P = s • A + t • B + u • C) :
    P ∈ convexHull ℝ ({A, B, C} : Set (ℝ × ℝ)) := by
  have hA : A ∈ ({A, B, C} : Set (ℝ × ℝ)) := by simp
  have hB : B ∈ ({A, B, C} : Set (ℝ × ℝ)) := by simp
  have hC : C ∈ ({A, B, C} : Set (ℝ × ℝ)) := by simp
  have key := (convex_convexHull ℝ ({A, B, C} : Set (ℝ × ℝ))).sum_mem
    (t := (Finset.univ : Finset (Fin 3))) (w := ![s, t, u]) (z := ![A, B, C])
    (by
      intro i _
      fin_cases i <;> simpa using ‹_›)
    (by
      rw [Fin.sum_univ_three]
      simpa using hsum)
    (by
      intro i _
      fin_cases i
      · simpa using subset_convexHull ℝ _ hA
      · simpa using subset_convexHull ℝ _ hB
      · simpa using subset_convexHull ℝ _ hC)
  rw [Fin.sum_univ_three] at key
  simpa [hP] using key

/-- The triangle `Δ_β` contains every point of the reciprocal-exponent plane
satisfying the three necessary conditions of BRS §3. -/
theorem mem_Delta_of_conditions {d : ℕ} (hd : 2 ≤ d) {β : ℝ} (hβ0 : 0 ≤ β)
    {x y : ℝ} (hyx : y ≤ x) (hxy : x ≤ (d : ℝ) * y)
    (hc : 0 ≤ (1 - β) * y + ((d : ℝ) - 1) - (d : ℝ) * x) :
    (x, y) ∈ Delta d β := by
  have hd1 : (1 : ℝ) ≤ (d : ℝ) - 1 := by
    have : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hd1pos : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hA : (0 : ℝ) < (d : ℝ) - 1 + β := by linarith
  have hB : (0 : ℝ) < (d : ℝ) ^ 2 - 1 + β := by nlinarith
  set s : ℝ := ((d : ℝ) * y - x) * ((d : ℝ) - 1 + β) / ((d : ℝ) - 1) ^ 2 with hsdef
  set t : ℝ := (x - y) * ((d : ℝ) ^ 2 - 1 + β) / ((d : ℝ) - 1) ^ 2 with htdef
  have hs : 0 ≤ s := by
    rw [hsdef]
    have : (0 : ℝ) ≤ (d : ℝ) * y - x := by linarith
    positivity
  have ht : 0 ≤ t := by
    rw [htdef]
    have : (0 : ℝ) ≤ x - y := by linarith
    positivity
  have hsum : s + t = ((d : ℝ) * x - (1 - β) * y) / ((d : ℝ) - 1) := by
    rw [hsdef, htdef]
    field_simp
    ring
  have hu : 0 ≤ 1 - s - t := by
    rw [sub_sub, hsum, sub_nonneg, div_le_one hd1pos]
    linarith
  refine mem_convexHull_triple hu hs ht (by ring) ?_
  have hx : s * (((d : ℝ) - 1) / ((d : ℝ) - 1 + β)) +
      t * ((d : ℝ) * ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + β)) = x := by
    rw [hsdef, htdef]
    field_simp
    ring
  have hy : s * (((d : ℝ) - 1) / ((d : ℝ) - 1 + β)) +
      t * (((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + β)) = y := by
    rw [hsdef, htdef]
    field_simp
    ring
  simp only [Q1, Q2, P3rad, Prod.smul_mk, smul_eq_mul, Prod.mk_add_mk, mul_zero,
    zero_add]
  rw [Prod.mk.injEq]
  refine ⟨?_, ?_⟩
  · rw [← hx]
  · rw [← hy]

/-- Where the maximal function is at least one on a set of positive measure,
its `L^∞` norm is at least one. -/
theorem le_eLpNorm_top_of_one_le_on {d : ℕ} {E : Set ℝ} {f : Euclidean d → ℂ}
    {S : Set (Euclidean d)} (hS : volume S ≠ 0)
    (hone : ∀ x ∈ S, (1 : ENNReal) ≤ M E f x) :
    1 ≤ eLpNorm (M E f) ⊤ volume := by
  have hpoint : ∀ x : Euclidean d,
      ‖S.indicator (fun _ => (1 : ℂ)) x‖ₑ ≤ ‖M E f x‖ₑ := by
    intro x
    by_cases hx : x ∈ S
    · calc
        ‖S.indicator (fun _ => (1 : ℂ)) x‖ₑ = 1 := by
          rw [Set.indicator_of_mem hx]
          simp
        _ ≤ M E f x := hone x hx
    · rw [Set.indicator_of_notMem hx]
      simp
  have h := eLpNorm_mono_enorm (p := ⊤) (μ := (volume : Measure (Euclidean d))) hpoint
  rwa [eLpNorm_exponent_top, eLpNormEssSup_indicator_const_eq S (1 : ℂ) hS,
    enorm_one] at h

/-- There is no radial `L^p → L^∞` bound for a nonempty set of dilations:
the thin shell test function has small `L^p` norm but its maximal function is
at least one on a ball. -/
theorem not_hasRadialStrongType_top_right {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p : ℝ} (hp : 0 < p)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) ⊤) : False := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨t₀, ht₀E⟩ := hEne
  have ht₀ : t₀ ∈ Icc (1 : ℝ) 2 := hE ht₀E
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  set W : ℝ := 2 * d * 3 ^ (d - 1) * V with hW
  have hWpos : 0 < W := by
    rw [hW]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  set δ : ℝ := min 1 ((1 / C) ^ p / (2 * W)) with hδdef
  have hCp : (0 : ℝ) < (1 / C) ^ p := Real.rpow_pos_of_pos (by positivity) p
  have hδpos : 0 < δ := lt_min one_pos (by positivity)
  have hδle : δ ≤ 1 := min_le_left _ _
  -- the test function
  set f : Euclidean d → ℂ := fun y =>
    (Icc (t₀ - δ) (t₀ + δ)).indicator (fun _ => (1 : ℂ)) ‖y‖ with hf
  have hannvol : volume (radialAnnulusIcc d (t₀ - δ) (t₀ + δ)) ≤
      ENNReal.ofReal (W * δ) := by
    refine le_trans (volume_thin_shell_le hd ht₀.1 ht₀.2 hδpos hδle) (le_of_eq ?_)
    rw [hVeq, ← ENNReal.ofReal_mul (by positivity), hW]
    congr 1
    ring
  have hnormf : eLpNorm f (ENNReal.ofReal p) volume =
      volume (radialAnnulusIcc d (t₀ - δ) (t₀ + δ)) ^ (1 / p) :=
    eLpNorm_indicator_lift d _ _ hp
  have hmem : MemLp f (ENNReal.ofReal p) volume := by
    refine ⟨(measurable_indicator_lift d _ _).aestronglyMeasurable, ?_⟩
    rw [hnormf]
    refine ENNReal.rpow_lt_top_of_nonneg (by positivity) ?_
    exact (lt_of_le_of_lt hannvol ENNReal.ofReal_lt_top).ne
  have hrad := isNormRadial_indicator_lift d (t₀ - δ) (t₀ + δ)
  have hone : ∀ x ∈ Metric.closedBall (0 : Euclidean d) δ, (1 : ENNReal) ≤ M E f x := by
    intro x hx
    rw [Metric.mem_closedBall, dist_zero_right] at hx
    have havg : _root_.Spherical.sphericalAverage t₀ f x = 1 :=
      sphericalAverage_shell_eq_one hd (le_trans zero_le_one ht₀.1) hx
    unfold M _root_.Spherical.restrictedSphericalMaximal
    refine le_iSup_of_le t₀ (le_iSup_of_le ⟨ht₀E, lt_of_lt_of_le zero_lt_one ht₀.1⟩ ?_)
    rw [havg]
    simp
  have hballpos : volume (Metric.closedBall (0 : Euclidean d) δ) ≠ 0 :=
    (Metric.measure_closedBall_pos volume (0 : Euclidean d) hδpos).ne'
  have hlow : (1 : ENNReal) ≤ eLpNorm (M E f) ⊤ volume :=
    le_eLpNorm_top_of_one_le_on hballpos hone
  have hup : eLpNorm f (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((W * δ) ^ (1 / p)) := by
    rw [hnormf, ← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    exact ENNReal.rpow_le_rpow hannvol (by positivity)
  have hchain : (1 : ENNReal) ≤ ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
    calc (1 : ENNReal) ≤ eLpNorm (M E f) ⊤ volume := hlow
      _ ≤ ENNReal.ofReal C * eLpNorm f (ENNReal.ofReal p) volume :=
          (hbound f hmem hrad).2
      _ ≤ ENNReal.ofReal C * ENNReal.ofReal ((W * δ) ^ (1 / p)) :=
          mul_le_mul' le_rfl hup
      _ = ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
          rw [← ENNReal.ofReal_mul hC.le]
  have hreal : (1 : ℝ) ≤ C * (W * δ) ^ (1 / p) := by
    have := ENNReal.one_le_ofReal.mp hchain
    exact this
  -- but the small scale makes the right-hand side less than one
  have hWδ : W * δ < (1 / C) ^ p := by
    have h1 : W * δ ≤ W * ((1 / C) ^ p / (2 * W)) :=
      mul_le_mul_of_nonneg_left (min_le_right _ _) hWpos.le
    have h2 : W * ((1 / C) ^ p / (2 * W)) = (1 / C) ^ p / 2 := by
      field_simp
    rw [h2] at h1
    linarith
  have hsmall : C * (W * δ) ^ (1 / p) < 1 := by
    have h1 : (W * δ) ^ (1 / p) < ((1 / C) ^ p) ^ (1 / p) :=
      Real.rpow_lt_rpow (by positivity) hWδ (by positivity)
    have h2 : ((1 / C) ^ p) ^ (1 / p) = 1 / C := by
      rw [← Real.rpow_mul (by positivity), mul_one_div, div_self hp.ne',
        Real.rpow_one]
    rw [h2] at h1
    calc C * (W * δ) ^ (1 / p) < C * (1 / C) := by
          exact mul_lt_mul_of_pos_left h1 hC
      _ = 1 := by field_simp
  linarith

/-- There is no radial `L^∞ → L^q` bound for finite `q`: the indicator of a
large ball is bounded, but its maximal function is at least one on a ball of
comparable radius, whose volume is unbounded. -/
theorem not_hasRadialStrongType_top_left {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q)
    (h : HasRadialStrongType d E ⊤ (ENNReal.ofReal q)) : False := by
  haveI : Nonempty (Fin d) := ⟨⟨0, hd⟩⟩
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨t₀, ht₀E⟩ := hEne
  have ht₀ : t₀ ∈ Icc (1 : ℝ) 2 := hE ht₀E
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hCq : (0 : ℝ) < C ^ q := Real.rpow_pos_of_pos hC q
  set R : ℝ := C ^ q / V + 1 with hR
  have hR1 : (1 : ℝ) ≤ R := by
    rw [hR]
    have : (0 : ℝ) ≤ C ^ q / V := by positivity
    linarith
  have hRpos : (0 : ℝ) < R := lt_of_lt_of_le one_pos hR1
  set f : Euclidean d → ℂ := fun y =>
    (Icc (t₀ - R) (t₀ + R)).indicator (fun _ => (1 : ℂ)) ‖y‖ with hf
  have hnormle : eLpNorm f ⊤ volume ≤ 1 := by
    rw [hf, eLpNorm_exponent_top, indicator_lift_eq]
    simpa using
      eLpNormEssSup_indicator_const_le (μ := (volume : Measure (Euclidean d)))
        (radialAnnulusIcc d (t₀ - R) (t₀ + R)) (1 : ℂ)
  have hmem : MemLp f ⊤ volume := by
    refine ⟨(measurable_indicator_lift d _ _).aestronglyMeasurable, ?_⟩
    exact lt_of_le_of_lt hnormle ENNReal.one_lt_top
  have hrad := isNormRadial_indicator_lift d (t₀ - R) (t₀ + R)
  have hone : ∀ x ∈ Metric.closedBall (0 : Euclidean d) R, (1 : ENNReal) ≤ M E f x := by
    intro x hx
    rw [Metric.mem_closedBall, dist_zero_right] at hx
    have havg : _root_.Spherical.sphericalAverage t₀ f x = 1 :=
      sphericalAverage_shell_eq_one hd (le_trans zero_le_one ht₀.1) hx
    unfold M _root_.Spherical.restrictedSphericalMaximal
    refine le_iSup_of_le t₀ (le_iSup_of_le ⟨ht₀E, lt_of_lt_of_le zero_lt_one ht₀.1⟩ ?_)
    rw [havg]
    simp
  have hlow := le_eLpNorm_of_one_le_on (E := E) (f := f)
    (S := Metric.closedBall (0 : Euclidean d) R) measurableSet_closedBall hone hq
  have hvol : volume (Metric.closedBall (0 : Euclidean d) R) =
      ENNReal.ofReal (R ^ d * V) := by
    rw [volume_closedBall_eq hd hRpos.le, hVeq, ← ENNReal.ofReal_mul (by positivity)]
  have hchain : ENNReal.ofReal ((R ^ d * V) ^ (1 / q)) ≤ ENNReal.ofReal C := by
    calc ENNReal.ofReal ((R ^ d * V) ^ (1 / q))
        = volume (Metric.closedBall (0 : Euclidean d) R) ^ (1 / q) := by
          rw [hvol, ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
      _ ≤ eLpNorm (M E f) (ENNReal.ofReal q) volume := hlow
      _ ≤ ENNReal.ofReal C * eLpNorm f ⊤ volume := (hbound f hmem hrad).2
      _ ≤ ENNReal.ofReal C * 1 := mul_le_mul' le_rfl hnormle
      _ = ENNReal.ofReal C := mul_one _
  have hreal := (ENNReal.ofReal_le_ofReal_iff hC.le).mp hchain
  have hRd : R ≤ R ^ d := by
    calc R = R ^ 1 := (pow_one R).symm
      _ ≤ R ^ d := pow_le_pow_right₀ hR1 (by omega)
  have h1 : R * V ≤ R ^ d * V := mul_le_mul_of_nonneg_right hRd hVpos.le
  have h2 : (R * V) ^ (1 / q) ≤ C :=
    le_trans (Real.rpow_le_rpow (by positivity) h1 (by positivity)) hreal
  have h3 : R * V ≤ C ^ q := by
    have h4 := Real.rpow_le_rpow (Real.rpow_nonneg (by positivity) (1 / q)) h2 hq.le
    rwa [← Real.rpow_mul (by positivity), one_div_mul_cancel hq.ne', Real.rpow_one] at h4
  rw [hR] at h3
  have h5 : C ^ q + V ≤ C ^ q := by
    calc C ^ q + V = (C ^ q / V + 1) * V := by field_simp
      _ ≤ C ^ q := h3
  linarith


/-! ## Corollary 3.3 -/

section Corollary33

open Auto.FractalDimensions

/-- **BRS Corollary 3.3.**  The radial type set of a nonempty compact set of
dilations `E ⊆ [1,2]` of upper Minkowski dimension `β` is contained in the
closed triangle `Δ_β`. -/
theorem radialTypeSet_subset_Delta {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ}
    (hβ : upperMinkowskiDimension E = β) :
    radialTypeSet d E ⊆ Delta d β := by
  have hd0 : 0 < d := lt_of_lt_of_le two_pos hd
  have hβ0 : 0 ≤ β := hβ ▸ upperMinkowskiDimension_nonneg_of_subset_Icc hE
  intro z hz
  obtain ⟨p, q, hp1, hq1, hzeq, hstrong⟩ := hz
  have hp0 : p ≠ 0 := (lt_of_lt_of_le zero_lt_one hp1).ne'
  have hq0 : q ≠ 0 := (lt_of_lt_of_le zero_lt_one hq1).ne'
  by_cases hptop : p = ⊤
  · by_cases hqtop : q = ⊤
    · have hQ1 : Q1 ∈ Delta d β := subset_convexHull ℝ _ (by simp)
      rw [hzeq, hptop, hqtop]
      simpa [Q1] using hQ1
    · exfalso
      have hqpos : 0 < q.toReal := ENNReal.toReal_pos hq0 hqtop
      refine not_hasRadialStrongType_top_left hd0 hE hEne hqpos ?_
      rw [ENNReal.ofReal_toReal hqtop, ← hptop]
      exact hstrong
  · by_cases hqtop : q = ⊤
    · exfalso
      have hppos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      refine not_hasRadialStrongType_top_right hd0 hE hEne hppos ?_
      rw [ENNReal.ofReal_toReal hptop, ← hqtop]
      exact hstrong
    · have hppos : 0 < p.toReal := ENNReal.toReal_pos hp0 hptop
      have hqpos : 0 < q.toReal := ENNReal.toReal_pos hq0 hqtop
      have hs' : HasRadialStrongType d E (ENNReal.ofReal p.toReal)
          (ENNReal.ofReal q.toReal) := by
        rw [ENNReal.ofReal_toReal hptop, ENNReal.ofReal_toReal hqtop]
        exact hstrong
      have h1 : p.toReal ≤ q.toReal :=
        le_of_hasRadialStrongType hd0 hE hEne hppos hqpos hs'
      have h2 : q.toReal ≤ p.toReal * d :=
        le_mul_of_hasRadialStrongType hd0 hE hEne hppos hqpos hs'
      have h3 : 0 ≤ (1 - β) / q.toReal + (d : ℝ) - 1 - (d : ℝ) / p.toReal :=
        dim_le_of_hasRadialStrongType hd0 hE hEne hβ hppos hqpos hs'
      have hzz : z = (1 / p.toReal, 1 / q.toReal) := by
        rw [hzeq, ENNReal.toReal_inv, ENNReal.toReal_inv, inv_eq_one_div,
          inv_eq_one_div]
      rw [hzz]
      refine mem_Delta_of_conditions hd hβ0 ?_ ?_ ?_
      · exact one_div_le_one_div_of_le hppos h1
      · rw [mul_one_div, div_le_div_iff₀ hppos hqpos, one_mul,
          mul_comm ((d : ℝ)) p.toReal]
        exact h2
      · rw [div_eq_mul_one_div (1 - β), div_eq_mul_one_div ((d : ℝ))] at h3
        linarith

end Corollary33

/-! ## The Stein-type test function of Lemma 3.4 -/

/-- The lower endpoint `δ^{1/2}` of the support of the Stein profile. -/
def steinLower (δ : ℝ) : ℝ := δ ^ (1 / 2 : ℝ)

/-- The upper endpoint `δ^{1/4}` of the support of the Stein profile. -/
def steinUpper (δ : ℝ) : ℝ := δ ^ (1 / 4 : ℝ)

/-- The profile `s^{1-d} (log(1/s))^{(1-d)/d}` of the Stein test function of
BRS Lemma 3.4, cut off to the radii `δ^{1/2} ≤ s ≤ δ^{1/4}`. -/
def steinProfile (d : ℕ) (δ : ℝ) : ℝ → ℂ :=
  (Icc (steinLower δ) (steinUpper δ)).indicator
    (fun s => ((s ^ (1 - (d : ℝ)) *
      Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) : ℝ) : ℂ))

theorem steinLower_pos {δ : ℝ} (hδ : 0 < δ) : 0 < steinLower δ :=
  Real.rpow_pos_of_pos hδ _

theorem steinUpper_pos {δ : ℝ} (hδ : 0 < δ) : 0 < steinUpper δ :=
  Real.rpow_pos_of_pos hδ _

theorem steinLower_lt_steinUpper {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) :
    steinLower δ < steinUpper δ :=
  Real.rpow_lt_rpow_of_exponent_gt hδ hδ1 (by norm_num)

theorem steinUpper_lt_one {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) : steinUpper δ < 1 :=
  Real.rpow_lt_one hδ.le hδ1 (by norm_num)

theorem measurable_steinProfile (d : ℕ) (δ : ℝ) : Measurable (steinProfile d δ) := by
  refine Measurable.indicator ?_ measurableSet_Icc
  have h1 : Measurable fun s : ℝ => s ^ (1 - (d : ℝ)) := by fun_prop
  have h2 : Measurable fun s : ℝ =>
      Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by fun_prop
  exact Complex.measurable_ofReal.comp (h1.mul h2)

/-- The pointwise algebra behind the normalization `‖g‖_{p_d} ≲ 1`: with
`p_d = d/(d-1)` the weighted `p_d`-th power of the profile is `1/(s log(1/s))`. -/
theorem stein_integrand_eq {d : ℕ} (hd : 2 ≤ d) {s : ℝ} (hs : 0 < s) (hs1 : s < 1) :
    s ^ (d - 1) * (s ^ (1 - (d : ℝ)) *
        Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ))) ^ ((d : ℝ) / ((d : ℝ) - 1))
      = s⁻¹ * (Real.log (1 / s))⁻¹ := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hne : (d : ℝ) - 1 ≠ 0 := ne_of_gt hd1
  have hdne : (d : ℝ) ≠ 0 := by positivity
  have hlog : 0 < Real.log (1 / s) := by
    refine Real.log_pos ?_
    rw [lt_div_iff₀ hs]
    linarith
  have hpow : s ^ (d - 1) = s ^ ((d : ℝ) - 1) := by
    rw [← Real.rpow_natCast s (d - 1)]
    have h1 : (1 : ℕ) ≤ d := le_trans (by norm_num) hd
    congr 1
    push_cast [Nat.cast_sub h1]
    ring
  have hA : (s ^ (1 - (d : ℝ))) ^ ((d : ℝ) / ((d : ℝ) - 1)) = s ^ (-(d : ℝ)) := by
    rw [← Real.rpow_mul hs.le]
    congr 1
    field_simp
    ring
  have hB : (Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ))) ^ ((d : ℝ) / ((d : ℝ) - 1))
      = Real.log (1 / s) ^ (-1 : ℝ) := by
    rw [← Real.rpow_mul hlog.le]
    congr 1
    field_simp
    ring
  calc s ^ (d - 1) * (s ^ (1 - (d : ℝ)) *
        Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ))) ^ ((d : ℝ) / ((d : ℝ) - 1))
      = s ^ ((d : ℝ) - 1) * (s ^ (-(d : ℝ)) * Real.log (1 / s) ^ (-1 : ℝ)) := by
        rw [hpow, Real.mul_rpow (Real.rpow_nonneg hs.le _)
          (Real.rpow_nonneg hlog.le _), hA, hB]
    _ = (s ^ ((d : ℝ) - 1) * s ^ (-(d : ℝ))) * Real.log (1 / s) ^ (-1 : ℝ) := by ring
    _ = s ^ (-1 : ℝ) * Real.log (1 / s) ^ (-1 : ℝ) := by
        rw [← Real.rpow_add hs]
        congr 2
        ring
    _ = s⁻¹ * (Real.log (1 / s))⁻¹ := by
        rw [Real.rpow_neg_one, Real.rpow_neg_one]

/-- The normalization of the Stein test profile: its weighted `p_d`-th power
integrates to at most one, uniformly in `δ`. -/
theorem lintegral_steinProfile_le {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ < 1) :
    (∫⁻ r : Ioi (0 : ℝ), (ENNReal.ofReal ‖steinProfile d δ r.1‖) ^
        ((d : ℝ) / ((d : ℝ) - 1)) ∂Measure.volumeIoiPow (d - 1)) ≤ 1 := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  set p : ℝ := (d : ℝ) / ((d : ℝ) - 1) with hp
  have hppos : 0 < p := by rw [hp]; positivity
  set L : ℝ := Real.log (1 / δ) with hL
  have hLpos : 0 < L := by
    rw [hL]
    refine Real.log_pos ?_
    rw [lt_div_iff₀ hδ]
    linarith
  set a : ℝ := steinLower δ with ha
  set b : ℝ := steinUpper δ with hb
  have hapos : 0 < a := steinLower_pos hδ
  have hbpos : 0 < b := steinUpper_pos hδ
  have hab : a < b := steinLower_lt_steinUpper hδ hδ1
  have hb1 : b < 1 := steinUpper_lt_one hδ hδ1
  have hLeq : L = -Real.log δ := by
    rw [hL, one_div, Real.log_inv]
  have hlogb : Real.log (1 / b) = L / 4 := by
    rw [hb, steinUpper, one_div, ← Real.rpow_neg hδ.le, Real.log_rpow hδ, hLeq]
    ring
  -- the pointwise bound
  have hmono : ∀ r : ℝ, ENNReal.ofReal r ^ (d - 1) *
      (ENNReal.ofReal ‖steinProfile d δ r‖) ^ p ≤
        (Icc a b).indicator (fun r : ℝ => ENNReal.ofReal (4 / L * r⁻¹)) r := by
    intro r
    by_cases hr : r ∈ Icc a b
    · have hrpos : 0 < r := lt_of_lt_of_le hapos hr.1
      have hr1 : r < 1 := lt_of_le_of_lt hr.2 hb1
      have hlogr : 0 < Real.log (1 / r) := by
        refine Real.log_pos ?_
        rw [lt_div_iff₀ hrpos]
        linarith
      have hval : ‖steinProfile d δ r‖ =
          r ^ (1 - (d : ℝ)) * Real.log (1 / r) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by
        rw [steinProfile, ← ha, ← hb, Set.indicator_of_mem hr, Complex.norm_real,
          Real.norm_of_nonneg (by positivity)]
      have hlow : L / 4 ≤ Real.log (1 / r) := by
        rw [← hlogb, one_div, one_div, Real.log_inv, Real.log_inv, neg_le_neg_iff]
        exact Real.log_le_log hrpos hr.2
      have hinvle : (Real.log (1 / r))⁻¹ ≤ 4 / L := by
        rw [inv_le_comm₀ hlogr (by positivity)]
        calc (4 / L)⁻¹ = L / 4 := by rw [inv_div]
          _ ≤ Real.log (1 / r) := hlow
      rw [Set.indicator_of_mem hr, hval,
        ENNReal.ofReal_rpow_of_nonneg (by positivity) hppos.le,
        ← ENNReal.ofReal_pow hrpos.le, ← ENNReal.ofReal_mul (by positivity), hp,
        stein_integrand_eq hd hrpos hr1]
      refine ENNReal.ofReal_le_ofReal ?_
      rw [mul_comm (4 / L) r⁻¹]
      exact mul_le_mul_of_nonneg_left hinvle (by positivity)
    · have hzero : steinProfile d δ r = 0 := by
        rw [steinProfile, ← ha, ← hb, Set.indicator_of_notMem hr]
      rw [hzero, Set.indicator_of_notMem hr]
      simp [ENNReal.zero_rpow_of_pos hppos]
  -- integrate the bound
  have hmeas : Measurable fun r : ℝ =>
      (ENNReal.ofReal ‖steinProfile d δ r‖) ^ p := by
    exact (((measurable_steinProfile d δ).norm).ennreal_ofReal).pow_const _
  have hint : IntegrableOn (fun r : ℝ => 4 / L * r⁻¹) (Icc a b) volume := by
    apply ContinuousOn.integrableOn_Icc
    refine ContinuousOn.mul continuousOn_const ?_
    refine ContinuousOn.inv₀ continuousOn_id ?_
    intro x hx
    exact ne_of_gt (lt_of_lt_of_le hapos hx.1)
  have hintegral : (∫ r in Icc a b, 4 / L * r⁻¹) = 1 := by
    rw [MeasureTheory.integral_Icc_eq_integral_Ioc,
      ← intervalIntegral.integral_of_le hab.le, intervalIntegral.integral_const_mul,
      integral_inv_of_pos hapos hbpos]
    have hba : Real.log (b / a) = L / 4 := by
      rw [ha, hb, steinLower, steinUpper, ← Real.rpow_sub hδ, Real.log_rpow hδ,
        hLeq]
      ring
    rw [hba]
    field_simp
  calc (∫⁻ r : Ioi (0 : ℝ), (ENNReal.ofReal ‖steinProfile d δ r.1‖) ^ p
        ∂Measure.volumeIoiPow (d - 1))
      = ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (d - 1) *
          (ENNReal.ofReal ‖steinProfile d δ r‖) ^ p :=
        lintegral_volumeIoiPow (d - 1) _ hmeas
    _ ≤ ∫⁻ r in Ioi (0 : ℝ),
          (Icc a b).indicator (fun r : ℝ => ENNReal.ofReal (4 / L * r⁻¹)) r :=
        lintegral_mono hmono
    _ ≤ ∫⁻ r : ℝ, (Icc a b).indicator (fun r : ℝ => ENNReal.ofReal (4 / L * r⁻¹)) r :=
        lintegral_mono' Measure.restrict_le_self (fun _ => le_rfl)
    _ = ∫⁻ r in Icc a b, ENNReal.ofReal (4 / L * r⁻¹) :=
        lintegral_indicator measurableSet_Icc _
    _ = ENNReal.ofReal (∫ r in Icc a b, 4 / L * r⁻¹) :=
        (ofReal_integral_eq_lintegral_ofReal hint
          (ae_restrict_of_forall_mem measurableSet_Icc (fun r hr => by
            have hrpos : 0 < r := lt_of_lt_of_le hapos hr.1
            positivity))).symm
    _ = 1 := by rw [hintegral, ENNReal.ofReal_one]

theorem isNormRadial_steinProfile_lift (d : ℕ) (δ : ℝ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial
      (fun x : Euclidean d => steinProfile d δ ‖x‖) := by
  intro x y hxy
  simp only [hxy]

theorem measurable_steinProfile_lift (d : ℕ) (δ : ℝ) :
    Measurable (fun x : Euclidean d => steinProfile d δ ‖x‖) :=
  (measurable_steinProfile d δ).comp measurable_norm

/-- **The Stein test function of BRS Lemma 3.4 is normalized in `L^{p_d}`**,
uniformly in `δ`. -/
theorem eLpNorm_steinProfile_lift_le {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ < 1) :
    eLpNorm (fun x : Euclidean d => steinProfile d δ ‖x‖)
        (ENNReal.ofReal ((d : ℝ) / ((d : ℝ) - 1))) volume ≤
      (ENNReal.ofReal (surfaceMass d)) ^ (((d : ℝ) - 1) / (d : ℝ)) := by
  have hd0 : 0 < d := lt_of_lt_of_le two_pos hd
  haveI : Nonempty (Fin d) := ⟨⟨0, hd0⟩⟩
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hppos : (0 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := by positivity
  obtain ⟨w, hw⟩ := exists_norm_eq (Euclidean d) (zero_le_one : (0:ℝ) ≤ 1)
  rw [eLpNorm_of_isNormRadial hd0 hppos _ (isNormRadial_steinProfile_lift d δ)
    (measurable_steinProfile_lift d δ) w hw]
  have hcongr : (∫⁻ r : Ioi (0 : ℝ),
        (ENNReal.ofReal ‖(fun x : Euclidean d => steinProfile d δ ‖x‖) (r.1 • w)‖) ^
          ((d : ℝ) / ((d : ℝ) - 1)) ∂Measure.volumeIoiPow (d - 1)) =
      ∫⁻ r : Ioi (0 : ℝ), (ENNReal.ofReal ‖steinProfile d δ r.1‖) ^
          ((d : ℝ) / ((d : ℝ) - 1)) ∂Measure.volumeIoiPow (d - 1) := by
    refine lintegral_congr fun r => ?_
    have hnorm : ‖r.1 • w‖ = r.1 := by
      rw [norm_smul, hw, mul_one, Real.norm_eq_abs, abs_of_pos r.2]
    simp only [hnorm]
  rw [hcongr]
  have hone : (1 : ℝ) / ((d : ℝ) / ((d : ℝ) - 1)) = ((d : ℝ) - 1) / (d : ℝ) :=
    one_div_div _ _
  rw [hone]
  calc (ENNReal.ofReal (surfaceMass d)) ^ (((d : ℝ) - 1) / (d : ℝ)) *
        (∫⁻ r : Ioi (0 : ℝ), (ENNReal.ofReal ‖steinProfile d δ r.1‖) ^
          ((d : ℝ) / ((d : ℝ) - 1)) ∂Measure.volumeIoiPow (d - 1)) ^
            (((d : ℝ) - 1) / (d : ℝ))
      ≤ (ENNReal.ofReal (surfaceMass d)) ^ (((d : ℝ) - 1) / (d : ℝ)) *
          (1 : ENNReal) ^ (((d : ℝ) - 1) / (d : ℝ)) := by
        refine mul_le_mul' le_rfl ?_
        exact ENNReal.rpow_le_rpow (lintegral_steinProfile_le hd hδ hδ1) (by positivity)
    _ = (ENNReal.ofReal (surfaceMass d)) ^ (((d : ℝ) - 1) / (d : ℝ)) := by
        rw [ENNReal.one_rpow, mul_one]

theorem memLp_steinProfile_lift {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ < 1) :
    MemLp (fun x : Euclidean d => steinProfile d δ ‖x‖)
      (ENNReal.ofReal ((d : ℝ) / ((d : ℝ) - 1))) volume := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp : (0 : ℝ) ≤ ((d : ℝ) - 1) / (d : ℝ) := by
    apply div_nonneg <;> linarith
  refine ⟨(measurable_steinProfile_lift d δ).aestronglyMeasurable, ?_⟩
  refine lt_of_le_of_lt (eLpNorm_steinProfile_lift_le hd hδ hδ1) ?_
  exact ENNReal.rpow_lt_top_of_nonneg hexp ENNReal.ofReal_ne_top

/-! ### A continuous version of the Stein test function

The sharp cutoff of BRS Lemma 3.4 is replaced by a trapezoidal one, which
changes neither the normalization nor the lower bound but keeps the profile
continuous, as required by the kernel representation (4.1). -/

/-- The trapezoidal cutoff: `0` outside `[a,b]`, `1` on `[2a, b/2]`. -/
def trapezoid (a b : ℝ) : ℝ → ℝ := fun s =>
  max 0 (min 1 (min ((s - a) / a) ((b - s) / (b / 2))))

theorem trapezoid_nonneg (a b : ℝ) (s : ℝ) : 0 ≤ trapezoid a b s := le_max_left _ _

theorem trapezoid_le_one (a b : ℝ) (s : ℝ) : trapezoid a b s ≤ 1 := by
  refine max_le zero_le_one ?_
  exact le_trans (min_le_left _ _) le_rfl

theorem continuous_trapezoid (a b : ℝ) : Continuous (trapezoid a b) := by
  unfold trapezoid
  fun_prop

theorem trapezoid_eq_zero_of_le {a b : ℝ} (ha : 0 < a) {s : ℝ} (hs : s ≤ a) :
    trapezoid a b s = 0 := by
  unfold trapezoid
  have h1 : (s - a) / a ≤ 0 := div_nonpos_of_nonpos_of_nonneg (by linarith) ha.le
  have h2 : min 1 (min ((s - a) / a) ((b - s) / (b / 2))) ≤ 0 :=
    le_trans (min_le_right _ _) (le_trans (min_le_left _ _) h1)
  exact max_eq_left h2

theorem trapezoid_eq_zero_of_ge {a b : ℝ} (hb : 0 < b) {s : ℝ} (hs : b ≤ s) :
    trapezoid a b s = 0 := by
  unfold trapezoid
  have h1 : (b - s) / (b / 2) ≤ 0 :=
    div_nonpos_of_nonpos_of_nonneg (by linarith) (by positivity)
  have h2 : min 1 (min ((s - a) / a) ((b - s) / (b / 2))) ≤ 0 :=
    le_trans (min_le_right _ _) (le_trans (min_le_right _ _) h1)
  exact max_eq_left h2

theorem trapezoid_eq_one {a b : ℝ} (ha : 0 < a) (hb : 0 < b) {s : ℝ}
    (hs1 : 2 * a ≤ s) (hs2 : s ≤ b / 2) : trapezoid a b s = 1 := by
  unfold trapezoid
  have h1 : (1 : ℝ) ≤ (s - a) / a := by
    rw [le_div_iff₀ ha]
    linarith
  have h2 : (1 : ℝ) ≤ (b - s) / (b / 2) := by
    rw [le_div_iff₀ (by positivity)]
    linarith
  rw [min_eq_left (le_min h1 h2), max_eq_right zero_le_one]

/-- The continuous Stein profile: the trapezoidal cutoff times the weight
`s^{1-d}(log(1/s))^{(1-d)/d}`, the latter frozen below `δ^{1/2}` and clipped
from below by `1` in the logarithm so that it is continuous everywhere. -/
def steinBump (d : ℕ) (δ : ℝ) : ℝ → ℝ := fun s =>
  trapezoid (steinLower δ) (steinUpper δ) s *
    ((max (steinLower δ) s) ^ (1 - (d : ℝ)) *
      (max 1 (Real.log (1 / max (steinLower δ) s))) ^ ((1 - (d : ℝ)) / (d : ℝ)))

/-- The complex-valued continuous Stein profile. -/
def steinFun (d : ℕ) (δ : ℝ) : ℝ → ℂ := fun s => ((steinBump d δ s : ℝ) : ℂ)

theorem steinBump_nonneg (d : ℕ) {δ : ℝ} (hδ : 0 < δ) (s : ℝ) :
    0 ≤ steinBump d δ s := by
  have hpos : 0 < max (steinLower δ) s :=
    lt_of_lt_of_le (steinLower_pos hδ) (le_max_left _ _)
  refine mul_nonneg (trapezoid_nonneg _ _ _) (mul_nonneg ?_ ?_)
  · exact Real.rpow_nonneg hpos.le _
  · exact Real.rpow_nonneg (le_trans zero_le_one (le_max_left _ _)) _

theorem continuous_steinBump (d : ℕ) {δ : ℝ} (hδ : 0 < δ) :
    Continuous (steinBump d δ) := by
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hbase : Continuous fun s : ℝ => max (steinLower δ) s :=
    continuous_const.max continuous_id
  have hbasepos : ∀ s : ℝ, 0 < max (steinLower δ) s := fun s =>
    lt_of_lt_of_le hlow (le_max_left _ _)
  have h1 : Continuous fun s : ℝ => (max (steinLower δ) s) ^ (1 - (d : ℝ)) := by
    refine hbase.rpow_const ?_
    intro s
    exact Or.inl (hbasepos s).ne'
  have hlog : Continuous fun s : ℝ => Real.log (1 / max (steinLower δ) s) := by
    refine Continuous.log (continuous_const.div hbase ?_) ?_
    · intro s
      exact (hbasepos s).ne'
    · intro s
      have : 0 < 1 / max (steinLower δ) s := by
        exact div_pos one_pos (hbasepos s)
      exact this.ne'
  have h2 : Continuous fun s : ℝ =>
      (max 1 (Real.log (1 / max (steinLower δ) s))) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by
    refine (continuous_const.max hlog).rpow_const ?_
    intro s
    exact Or.inl (ne_of_gt (lt_of_lt_of_le zero_lt_one (le_max_left _ _)))
  exact (continuous_trapezoid _ _).mul (h1.mul h2)

theorem continuous_steinFun (d : ℕ) {δ : ℝ} (hδ : 0 < δ) :
    Continuous (steinFun d δ) :=
  Complex.continuous_ofReal.comp (continuous_steinBump d hδ)

/-- On the plateau of the cutoff the continuous profile is the exact Stein
weight. -/
theorem steinBump_eq_of_mem_plateau {d : ℕ} {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1)
    {s : ℝ} (hs1 : 2 * steinLower δ ≤ s) (hs2 : s ≤ steinUpper δ / 2)
    (hlog : 1 ≤ Real.log (1 / s)) :
    steinBump d δ s =
      s ^ (1 - (d : ℝ)) * Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hup : 0 < steinUpper δ := steinUpper_pos hδ
  have hmax : max (steinLower δ) s = s := max_eq_right (by linarith)
  rw [steinBump, trapezoid_eq_one hlow hup hs1 hs2, one_mul, hmax,
    max_eq_right hlog]

/-- The continuous profile is dominated by the sharp-cutoff profile. -/
theorem norm_steinFun_le_norm_steinProfile {d : ℕ} (hd : 2 ≤ d) {δ : ℝ}
    (hδ : 0 < δ) (_hδ1 : δ < 1) (s : ℝ) :
    ‖steinFun d δ s‖ ≤ ‖steinProfile d δ s‖ := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hexp : ((1 : ℝ) - (d : ℝ)) / (d : ℝ) ≤ 0 := by
    apply div_nonpos_of_nonpos_of_nonneg <;> linarith
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hup : 0 < steinUpper δ := steinUpper_pos hδ
  have hup1 : steinUpper δ < 1 := steinUpper_lt_one hδ _hδ1
  by_cases hs : s ∈ Icc (steinLower δ) (steinUpper δ)
  · have hspos : 0 < s := lt_of_lt_of_le hlow hs.1
    have hs1 : s < 1 := lt_of_le_of_lt hs.2 hup1
    have hlogpos : 0 < Real.log (1 / s) := by
      refine Real.log_pos ?_
      rw [lt_div_iff₀ hspos]
      linarith
    have hmax : max (steinLower δ) s = s := max_eq_right hs.1
    have hnormP : ‖steinProfile d δ s‖ =
        s ^ (1 - (d : ℝ)) * Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by
      rw [steinProfile, Set.indicator_of_mem hs, Complex.norm_real,
        Real.norm_of_nonneg (by positivity)]
    have hlogle : Real.log (1 / s) ≤ max 1 (Real.log (1 / s)) := le_max_right _ _
    have hrpow : (max 1 (Real.log (1 / s))) ^ ((1 - (d : ℝ)) / (d : ℝ)) ≤
        Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) :=
      Real.rpow_le_rpow_of_nonpos hlogpos hlogle hexp
    rw [steinFun, Complex.norm_real,
      Real.norm_of_nonneg (steinBump_nonneg d hδ s), hnormP, steinBump, hmax]
    calc trapezoid (steinLower δ) (steinUpper δ) s *
          (s ^ (1 - (d : ℝ)) * (max 1 (Real.log (1 / s))) ^ ((1 - (d : ℝ)) / (d : ℝ)))
        ≤ 1 * (s ^ (1 - (d : ℝ)) *
            (max 1 (Real.log (1 / s))) ^ ((1 - (d : ℝ)) / (d : ℝ))) := by
          refine mul_le_mul_of_nonneg_right (trapezoid_le_one _ _ _) ?_
          positivity
      _ = s ^ (1 - (d : ℝ)) *
            (max 1 (Real.log (1 / s))) ^ ((1 - (d : ℝ)) / (d : ℝ)) := one_mul _
      _ ≤ s ^ (1 - (d : ℝ)) * Real.log (1 / s) ^ ((1 - (d : ℝ)) / (d : ℝ)) := by
          refine mul_le_mul_of_nonneg_left hrpow ?_
          positivity
  · have hzero : steinBump d δ s = 0 := by
      rw [steinBump]
      rcases not_and_or.mp (fun h => hs ⟨h.1, h.2⟩) with h | h
      · rw [trapezoid_eq_zero_of_le hlow (le_of_not_ge h), zero_mul]
      · rw [trapezoid_eq_zero_of_ge hup (le_of_not_ge h), zero_mul]
    rw [steinFun, hzero]
    simp

theorem measurable_steinFun_lift (d : ℕ) {δ : ℝ} (hδ : 0 < δ) :
    Measurable (fun x : Euclidean d => steinFun d δ ‖x‖) :=
  ((continuous_steinFun d hδ).measurable).comp measurable_norm

theorem isNormRadial_steinFun_lift (d : ℕ) (δ : ℝ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial
      (fun x : Euclidean d => steinFun d δ ‖x‖) := by
  intro x y hxy
  simp only [hxy]

/-- The continuous Stein test function is normalized in `L^{p_d}` too. -/
theorem eLpNorm_steinFun_lift_le {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ < 1) :
    eLpNorm (fun x : Euclidean d => steinFun d δ ‖x‖)
        (ENNReal.ofReal ((d : ℝ) / ((d : ℝ) - 1))) volume ≤
      (ENNReal.ofReal (surfaceMass d)) ^ (((d : ℝ) - 1) / (d : ℝ)) := by
  refine le_trans (eLpNorm_mono_enorm ?_) (eLpNorm_steinProfile_lift_le hd hδ hδ1)
  intro x
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal
    (norm_steinFun_le_norm_steinProfile hd hδ hδ1 ‖x‖)

theorem memLp_steinFun_lift {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hδ1 : δ < 1) :
    MemLp (fun x : Euclidean d => steinFun d δ ‖x‖)
      (ENNReal.ofReal ((d : ℝ) / ((d : ℝ) - 1))) volume := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp : (0 : ℝ) ≤ ((d : ℝ) - 1) / (d : ℝ) := by
    apply div_nonneg <;> linarith
  refine ⟨(measurable_steinFun_lift d hδ).aestronglyMeasurable, ?_⟩
  refine lt_of_le_of_lt (eLpNorm_steinFun_lift_le hd hδ hδ1) ?_
  exact ENNReal.rpow_lt_top_of_nonneg hexp ENNReal.ofReal_ne_top

/-! ### The kernel lower bound behind Lemma 3.4 -/

/-- For dilations `t ∈ [1,2]`, radii `r` within `s/2` of `t`, and small `s`,
the kernel of (4.2) in ambient dimension `d+1` is at least `c s^{d-1}`. -/
theorem le_brsKernel {d : ℕ} {t r s : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (hs : 0 < s) (hs2 : s ≤ 1 / 2) (hrt : |r - t| ≤ s / 2) :
    (s / 36) ^ (d - 2) * (s / 18) ≤ brsKernel (d + 1) t r s := by
  have habs := abs_le.mp hrt
  have hr1 : 3 / 4 ≤ r := by
    have h1 : -(s / 2) ≤ r - t := habs.1
    have : s / 2 ≤ 1 / 4 := by linarith
    linarith
  have hr2 : r ≤ 9 / 4 := by
    have h1 : r - t ≤ s / 2 := habs.2
    have : s / 2 ≤ 1 / 4 := by linarith
    linarith
  have hrpos : 0 < r := by linarith
  have h4rtpos : 0 < 4 * r * t := by
    have : 0 < t := by linarith
    positivity
  have h4rt : 4 * r * t ≤ 18 := by nlinarith
  -- the two square roots
  have hnum1 : (1 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) := by
    rw [Real.one_le_sqrt]
    nlinarith
  have hsq2 : (s / 2) ^ 2 ≤ s ^ 2 - (r - t) ^ 2 := by
    have hsq : (r - t) ^ 2 ≤ (s / 2) ^ 2 := sq_le_sq' habs.1 habs.2
    nlinarith
  have hnum2 : s / 2 ≤ Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
    rw [show s / 2 = Real.sqrt ((s / 2) ^ 2) by
      rw [Real.sqrt_sq (by positivity)]]
    exact Real.sqrt_le_sqrt hsq2
  have hprod : s / 2 ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
    calc s / 2 = 1 * (s / 2) := (one_mul _).symm
      _ ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
          refine mul_le_mul hnum1 hnum2 (by positivity) ?_
          exact le_trans zero_le_one hnum1
  have hbracket : s / 36 ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) := by
    calc s / 36 = (s / 2) / 18 := by ring
      _ ≤ (s / 2) / (4 * r * t) := by gcongr
      _ ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) /
            (4 * r * t) := by gcongr
  have hlast : s / 18 ≤ s / (4 * r * t) := by
    exact div_le_div_of_nonneg_left hs.le h4rtpos h4rt
  rw [brsKernel_eq_of_pos]
  refine mul_le_mul ?_ hlast (by positivity) (by positivity)
  exact pow_le_pow_left₀ (by positivity) hbracket _

theorem log_one_div_eq {x : ℝ} : Real.log (1 / x) = -Real.log x := by
  rw [one_div, Real.log_inv]

theorem log_steinLower {δ : ℝ} (hδ : 0 < δ) :
    Real.log (steinLower δ) = -(Real.log (1 / δ) / 2) := by
  rw [steinLower, Real.log_rpow hδ, log_one_div_eq]
  ring

theorem log_steinUpper {δ : ℝ} (hδ : 0 < δ) :
    Real.log (steinUpper δ) = -(Real.log (1 / δ) / 4) := by
  rw [steinUpper, Real.log_rpow hδ, log_one_div_eq]
  ring

theorem log_four_le : Real.log 4 ≤ 3 / 2 := by
  have h4 : (4 : ℝ) = 2 ^ 2 := by norm_num
  rw [h4, Real.log_pow]
  have := Real.log_two_lt_d9
  push_cast
  linarith

/-- Under `12 ≤ log(1/δ)` the plateau of the trapezoid is nonempty. -/
theorem stein_plateau_le {δ : ℝ} (hδ : 0 < δ) (hL : 12 ≤ Real.log (1 / δ)) :
    2 * steinLower δ ≤ steinUpper δ / 2 := by
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hup : 0 < steinUpper δ := steinUpper_pos hδ
  have hlog : Real.log (4 * steinLower δ) ≤ Real.log (steinUpper δ) := by
    rw [Real.log_mul (by norm_num) hlow.ne', log_steinLower hδ, log_steinUpper hδ]
    have := log_four_le
    linarith
  have h4 : 4 * steinLower δ ≤ steinUpper δ := by
    have := Real.log_le_log_iff (by positivity : (0:ℝ) < 4 * steinLower δ) hup
    exact (this.mp hlog)
  linarith

/-- The plateau lies below `1/2`, where the kernel bound applies. -/
theorem stein_plateau_lt_one {δ : ℝ} (hδ : 0 < δ) (_hL : 12 ≤ Real.log (1 / δ)) :
    steinUpper δ / 2 ≤ 1 / 2 := by
  have hup1 : steinUpper δ < 1 := by
    refine steinUpper_lt_one hδ ?_
    by_contra hcon
    push Not at hcon
    have : Real.log (1 / δ) ≤ 0 := by
      refine Real.log_nonpos (by positivity) ?_
      rw [div_le_one hδ]
      exact hcon
    linarith
  linarith

/-- The logarithm is at least `L/4` on the plateau, hence at least `3`. -/
theorem three_le_log_of_mem_plateau {δ : ℝ} (hδ : 0 < δ)
    (hL : 12 ≤ Real.log (1 / δ)) {s : ℝ} (hs : s ≤ steinUpper δ / 2) (hs0 : 0 < s) :
    Real.log (1 / δ) / 4 ≤ Real.log (1 / s) := by
  have hup : 0 < steinUpper δ := steinUpper_pos hδ
  have h1 : s ≤ steinUpper δ := by linarith
  have : Real.log s ≤ Real.log (steinUpper δ) := Real.log_le_log hs0 h1
  rw [log_steinUpper hδ] at this
  rw [log_one_div_eq]
  rw [log_one_div_eq] at this ⊢
  linarith

/-- The logarithm is at most `L/2` on the plateau. -/
theorem log_le_of_mem_plateau {δ : ℝ} (hδ : 0 < δ) {s : ℝ}
    (hs : 2 * steinLower δ ≤ s) :
    Real.log (1 / s) ≤ Real.log (1 / δ) / 2 := by
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hs0 : 0 < s := lt_of_lt_of_le (by linarith) hs
  have h1 : steinLower δ ≤ s := by linarith
  have h2 : Real.log (steinLower δ) ≤ Real.log s := Real.log_le_log hlow h1
  rw [log_steinLower hδ] at h2
  rw [log_one_div_eq]
  rw [log_one_div_eq] at h2 ⊢
  linarith

/-- **The logarithmic gain of Lemma 3.4.**  On the plateau of the cutoff the
weight `s^{-1}(log(1/s))^{-(d-1)/d}` integrates to at least `L^{1/d}/8`, where
`L = log(1/δ)`. -/
theorem le_integral_stein_weight {d : ℕ} (hd : 2 ≤ d) {δ : ℝ} (hδ : 0 < δ)
    (hL : 12 ≤ Real.log (1 / δ)) :
    Real.log (1 / δ) ^ (1 / (d : ℝ)) / 8 ≤
      ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        s⁻¹ * Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hLpos : (0 : ℝ) < Real.log (1 / δ) := by linarith
  have hc0 : -(((d : ℝ) - 1) / (d : ℝ)) ≤ 0 := by
    simp only [neg_nonpos]
    apply div_nonneg <;> linarith
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hup : 0 < steinUpper δ := steinUpper_pos hδ
  have hapos : (0 : ℝ) < 2 * steinLower δ := by linarith
  have hbpos : (0 : ℝ) < steinUpper δ / 2 := by linarith
  have hab : 2 * steinLower δ ≤ steinUpper δ / 2 := stein_plateau_le hδ hL
  -- pointwise lower bound on the plateau
  have hpoint : ∀ s ∈ Icc (2 * steinLower δ) (steinUpper δ / 2),
      (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * s⁻¹ ≤
        s⁻¹ * Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))) := by
    intro s hs
    have hs0 : 0 < s := lt_of_lt_of_le hapos hs.1
    have hlogpos : 0 < Real.log (1 / s) := by
      have := three_le_log_of_mem_plateau hδ hL hs.2 hs0
      linarith
    have hle : Real.log (1 / s) ≤ Real.log (1 / δ) / 2 :=
      log_le_of_mem_plateau hδ hs.1
    have hrpow : (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) ≤
        Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))) :=
      Real.rpow_le_rpow_of_nonpos hlogpos hle hc0
    calc (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * s⁻¹
        ≤ Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * s⁻¹ := by
          exact mul_le_mul_of_nonneg_right hrpow (by positivity)
      _ = s⁻¹ * Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))) := mul_comm _ _
  have hint1 : IntervalIntegrable
      (fun s : ℝ => (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * s⁻¹)
      volume (2 * steinLower δ) (steinUpper δ / 2) := by
    refine ContinuousOn.intervalIntegrable ?_
    refine ContinuousOn.mul continuousOn_const (ContinuousOn.inv₀ continuousOn_id ?_)
    intro x hx
    rw [Set.uIcc_of_le hab] at hx
    exact (lt_of_lt_of_le hapos hx.1).ne'
  have hint2 : IntervalIntegrable
      (fun s : ℝ => s⁻¹ * Real.log (1 / s) ^ (-(((d : ℝ) - 1) / (d : ℝ))))
      volume (2 * steinLower δ) (steinUpper δ / 2) := by
    refine ContinuousOn.intervalIntegrable ?_
    have hpos : ∀ x ∈ Set.uIcc (2 * steinLower δ) (steinUpper δ / 2), 0 < x := by
      intro x hx
      rw [Set.uIcc_of_le hab] at hx
      exact lt_of_lt_of_le hapos hx.1
    refine ContinuousOn.mul (ContinuousOn.inv₀ continuousOn_id ?_) ?_
    · intro x hx
      exact (hpos x hx).ne'
    · refine ContinuousOn.rpow_const ?_ ?_
      · refine ContinuousOn.log (ContinuousOn.div continuousOn_const continuousOn_id ?_) ?_
        · intro x hx
          exact (hpos x hx).ne'
        · intro x hx
          have := hpos x hx
          exact (div_pos one_pos this).ne'
      · intro x hx
        left
        have hxpos := hpos x hx
        have h3 : Real.log (1 / δ) / 4 ≤ Real.log (1 / x) := by
          rw [Set.uIcc_of_le hab] at hx
          exact three_le_log_of_mem_plateau hδ hL hx.2 hxpos
        have : 0 < Real.log (1 / x) := by linarith
        exact this.ne'
  have hmono := intervalIntegral.integral_mono_on hab hint1 hint2 hpoint
  refine le_trans ?_ hmono
  -- compute the elementary integral
  have hcomp : (∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * s⁻¹) =
      (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) *
        Real.log ((steinUpper δ / 2) / (2 * steinLower δ)) := by
    rw [intervalIntegral.integral_const_mul, integral_inv_of_pos hapos hbpos]
  have hlog4 : Real.log 4 = 2 * Real.log 2 := by
    rw [show (4 : ℝ) = 2 ^ 2 by norm_num, Real.log_pow]
    push_cast
    ring
  have hlogba : Real.log ((steinUpper δ / 2) / (2 * steinLower δ)) =
      Real.log (1 / δ) / 4 - Real.log 4 := by
    rw [Real.log_div (by positivity) (by positivity),
      Real.log_div hup.ne' (two_ne_zero), Real.log_mul two_ne_zero hlow.ne',
      log_steinUpper hδ, log_steinLower hδ, hlog4]
    ring
  rw [hcomp, hlogba]
  -- the remaining arithmetic
  have h8 : Real.log (1 / δ) / 8 ≤ Real.log (1 / δ) / 4 - Real.log 4 := by
    have := log_four_le
    linarith
  have hbase : Real.log (1 / δ) ^ (-(((d : ℝ) - 1) / (d : ℝ))) ≤
      (Real.log (1 / δ) / 2) ^ (-(((d : ℝ) - 1) / (d : ℝ))) := by
    refine Real.rpow_le_rpow_of_nonpos (by positivity) ?_ hc0
    linarith
  have hadd : Real.log (1 / δ) ^ (-(((d : ℝ) - 1) / (d : ℝ))) * Real.log (1 / δ)
      = Real.log (1 / δ) ^ (1 / (d : ℝ)) := by
    have h1 : Real.log (1 / δ) ^ (-(((d : ℝ) - 1) / (d : ℝ))) *
        Real.log (1 / δ) ^ (1 : ℝ) =
          Real.log (1 / δ) ^ (-(((d : ℝ) - 1) / (d : ℝ)) + 1) :=
      (Real.rpow_add hLpos _ _).symm
    rw [Real.rpow_one] at h1
    rw [h1]
    congr 1
    field_simp
    ring
  have hkey : Real.log (1 / δ) ^ (1 / (d : ℝ)) / 8 =
      Real.log (1 / δ) ^ (-(((d : ℝ) - 1) / (d : ℝ))) *
        (Real.log (1 / δ) / 8) := by
    rw [← hadd]
    ring
  rw [hkey]
  refine mul_le_mul hbase h8 (by positivity) ?_
  exact Real.rpow_nonneg (by positivity) _

/-- The kernel lower bound, in terms of the ambient dimension `D`. -/
theorem le_brsKernel_dim {D : ℕ} {t r s : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (hs : 0 < s) (hs2 : s ≤ 1 / 2) (hrt : |r - t| ≤ s / 2) :
    (s / 36) ^ (D - 3) * (s / 18) ≤ brsKernel D t r s := by
  have habs := abs_le.mp hrt
  have hr1 : 3 / 4 ≤ r := by
    have : s / 2 ≤ 1 / 4 := by linarith
    linarith [habs.1]
  have hr2 : r ≤ 9 / 4 := by
    have : s / 2 ≤ 1 / 4 := by linarith
    linarith [habs.2]
  have hrpos : 0 < r := by linarith
  have h4rtpos : 0 < 4 * r * t := by
    have : 0 < t := by linarith
    positivity
  have h4rt : 4 * r * t ≤ 18 := by nlinarith
  have hnum1 : (1 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) := by
    rw [Real.one_le_sqrt]
    nlinarith
  have hsq2 : (s / 2) ^ 2 ≤ s ^ 2 - (r - t) ^ 2 := by
    have hsq : (r - t) ^ 2 ≤ (s / 2) ^ 2 := sq_le_sq' habs.1 habs.2
    nlinarith
  have hnum2 : s / 2 ≤ Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
    rw [show s / 2 = Real.sqrt ((s / 2) ^ 2) by rw [Real.sqrt_sq (by positivity)]]
    exact Real.sqrt_le_sqrt hsq2
  have hprod : s / 2 ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
    calc s / 2 = 1 * (s / 2) := (one_mul _).symm
      _ ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
          refine mul_le_mul hnum1 hnum2 (by positivity) (le_trans zero_le_one hnum1)
  have hbracket : s / 36 ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) := by
    calc s / 36 = (s / 2) / 18 := by ring
      _ ≤ (s / 2) / (4 * r * t) := by gcongr
      _ ≤ _ := by gcongr
  have hlast : s / 18 ≤ s / (4 * r * t) :=
    div_le_div_of_nonneg_left hs.le h4rtpos h4rt
  rw [brsKernel_eq_of_pos]
  refine mul_le_mul ?_ hlast (by positivity) (by positivity)
  exact pow_le_pow_left₀ (by positivity) hbracket _

/-- On the plateau, the kernel times the Stein profile dominates a constant
multiple of the logarithmic weight `s^{-1}(log(1/s))^{-(D-1)/D}`. -/
theorem le_kernel_mul_steinBump {D : ℕ} (hD : 3 ≤ D) {δ : ℝ} (hδ : 0 < δ)
    (hL : 12 ≤ Real.log (1 / δ)) {t r : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (hrt : |r - t| ≤ steinLower δ) {s : ℝ}
    (hs1 : 2 * steinLower δ ≤ s) (hs2 : s ≤ steinUpper δ / 2) :
    (1 / (36 ^ (D - 3) * 18)) *
        (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))) ≤
      brsKernel D t r s * steinBump D δ s := by
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hspos : 0 < s := lt_of_lt_of_le (by linarith) hs1
  have hshalf : s ≤ 1 / 2 := le_trans hs2 (stein_plateau_lt_one hδ hL)
  have hrts : |r - t| ≤ s / 2 := le_trans hrt (by linarith)
  have hlogplateau : Real.log (1 / δ) / 4 ≤ Real.log (1 / s) :=
    three_le_log_of_mem_plateau hδ hL hs2 hspos
  have hlogone : (1 : ℝ) ≤ Real.log (1 / s) := by linarith
  have hlogpos : 0 < Real.log (1 / s) := by linarith
  have hbump : steinBump D δ s =
      s ^ (1 - (D : ℝ)) * Real.log (1 / s) ^ ((1 - (D : ℝ)) / (D : ℝ)) := by
    refine steinBump_eq_of_mem_plateau hδ ?_ hs1 hs2 hlogone
    by_contra hcon
    push Not at hcon
    have : Real.log (1 / δ) ≤ 0 := by
      refine Real.log_nonpos (by positivity) ?_
      rw [div_le_one hδ]
      exact hcon
    linarith
  have hkernel : (s / 36) ^ (D - 3) * (s / 18) ≤ brsKernel D t r s :=
    le_brsKernel_dim ht1 ht2 hspos hshalf hrts
  have hbumpnonneg : 0 ≤ steinBump D δ s := steinBump_nonneg D hδ s
  -- the algebraic identity
  have hpowsucc : s ^ (D - 3) * s = s ^ ((D : ℝ) - 2) := by
    rw [← pow_succ]
    have hDD : D - 3 + 1 = D - 2 := by omega
    rw [hDD, ← Real.rpow_natCast s (D - 2)]
    congr 1
    have h2 : (2 : ℕ) ≤ D := by omega
    push_cast [Nat.cast_sub h2]
    ring
  have hcollapse : s ^ ((D : ℝ) - 2) * s ^ (1 - (D : ℝ)) = s⁻¹ := by
    rw [← Real.rpow_add hspos, show (D : ℝ) - 2 + (1 - (D : ℝ)) = -1 by ring,
      Real.rpow_neg_one]
  have hexp : ((1 : ℝ) - (D : ℝ)) / (D : ℝ) = -(((D : ℝ) - 1) / (D : ℝ)) := by
    ring
  have hident : (s / 36) ^ (D - 3) * (s / 18) *
      (s ^ (1 - (D : ℝ)) * Real.log (1 / s) ^ ((1 - (D : ℝ)) / (D : ℝ))) =
        (1 / (36 ^ (D - 3) * 18)) *
          (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))) := by
    rw [hexp, div_pow]
    rw [show s ^ (D - 3) / (36 : ℝ) ^ (D - 3) * (s / 18) *
        (s ^ (1 - (D : ℝ)) * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))) =
        (1 / ((36 : ℝ) ^ (D - 3) * 18)) *
          ((s ^ (D - 3) * s) * s ^ (1 - (D : ℝ)) *
            Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))) by ring]
    rw [hpowsucc, hcollapse]
  calc (1 / (36 ^ (D - 3) * 18)) *
        (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ))))
      = (s / 36) ^ (D - 3) * (s / 18) *
          (s ^ (1 - (D : ℝ)) * Real.log (1 / s) ^ ((1 - (D : ℝ)) / (D : ℝ))) :=
        hident.symm
    _ = (s / 36) ^ (D - 3) * (s / 18) * steinBump D δ s := by rw [hbump]
    _ ≤ brsKernel D t r s * steinBump D δ s := by
        exact mul_le_mul_of_nonneg_right hkernel hbumpnonneg

theorem continuous_brsKernel (D : ℕ) {t r : ℝ} (hrt : 0 < 4 * r * t) :
    Continuous fun s : ℝ => brsKernel D t r s := by
  unfold brsKernel
  have hne : ((r + t) ^ 2 - (r - t) ^ 2) ≠ 0 := by
    rw [show (r + t) ^ 2 - (r - t) ^ 2 = 4 * r * t by ring]
    exact hrt.ne'
  fun_prop (disch := assumption)

theorem brsKernel_nonneg (D : ℕ) {t r s : ℝ} (hrt : 0 < 4 * r * t) (hs : 0 ≤ s) :
    0 ≤ brsKernel D t r s := by
  have hden : (0 : ℝ) < (r + t) ^ 2 - (r - t) ^ 2 := by
    rw [show (r + t) ^ 2 - (r - t) ^ 2 = 4 * r * t by ring]
    exact hrt
  unfold brsKernel
  have h1 : (0 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / ((r + t) ^ 2 - (r - t) ^ 2) := by
    positivity
  exact mul_nonneg (pow_nonneg h1 _) (by positivity)

theorem delta_lt_one_of_log {δ : ℝ} (hδ : 0 < δ) (hL : 12 ≤ Real.log (1 / δ)) :
    δ < 1 := by
  by_contra hcon
  push Not at hcon
  have : Real.log (1 / δ) ≤ 0 := by
    refine Real.log_nonpos (by positivity) ?_
    rw [div_le_one hδ]
    exact hcon
  linarith

theorem steinLower_le_half {δ : ℝ} (hδ : 0 < δ) (hL : 12 ≤ Real.log (1 / δ)) :
    steinLower δ ≤ 1 / 2 := by
  have hup : steinUpper δ / 2 ≤ 1 / 2 := stein_plateau_lt_one hδ hL
  have hplateau : 2 * steinLower δ ≤ steinUpper δ / 2 := stein_plateau_le hδ hL
  have hpos : 0 < steinLower δ := steinLower_pos hδ
  linarith

/-- **The interval-integral form of the Lemma 3.4 lower bound.** -/
theorem le_intervalIntegral_kernel_steinBump {D : ℕ} (hD : 3 ≤ D) {δ : ℝ}
    (hδ : 0 < δ) (hL : 12 ≤ Real.log (1 / δ)) {t r : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    (hrt : |r - t| ≤ steinLower δ) :
    (1 / (36 ^ (D - 3) * 18)) * (Real.log (1 / δ) ^ (1 / (D : ℝ)) / 8) ≤
      ∫ s in |r - t|..(r + t), brsKernel D t r s * steinBump D δ s := by
  have hD2 : 2 ≤ D := by omega
  have hlow : 0 < steinLower δ := steinLower_pos hδ
  have hlowhalf : steinLower δ ≤ 1 / 2 := steinLower_le_half hδ hL
  have habs := abs_le.mp hrt
  have hr1 : 1 / 2 ≤ r := by linarith [habs.1]
  have hrpos : 0 < r := by linarith
  have h4rt : 0 < 4 * r * t := by
    have : 0 < t := by linarith
    positivity
  have hcont : Continuous fun s : ℝ => brsKernel D t r s * steinBump D δ s :=
    (continuous_brsKernel D h4rt).mul (continuous_steinBump D hδ)
  have hα : |r - t| ≤ 2 * steinLower δ := by linarith
  have hplateau : 2 * steinLower δ ≤ steinUpper δ / 2 := stein_plateau_le hδ hL
  have hβ : steinUpper δ / 2 ≤ r + t := by
    have := stein_plateau_lt_one hδ hL
    linarith
  have hnonneg : ∀ s : ℝ, 0 ≤ s → 0 ≤ brsKernel D t r s * steinBump D δ s :=
    fun s hs => mul_nonneg (brsKernel_nonneg D h4rt hs) (steinBump_nonneg D hδ s)
  have hint : ∀ u v : ℝ, IntervalIntegrable
      (fun s : ℝ => brsKernel D t r s * steinBump D δ s) volume u v := fun u v =>
    hcont.intervalIntegrable u v
  have hsplit1 : (∫ s in |r - t|..(2 * steinLower δ),
        brsKernel D t r s * steinBump D δ s) +
      (∫ s in (2 * steinLower δ)..(r + t), brsKernel D t r s * steinBump D δ s) =
      ∫ s in |r - t|..(r + t), brsKernel D t r s * steinBump D δ s :=
    intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
  have hsplit2 : (∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        brsKernel D t r s * steinBump D δ s) +
      (∫ s in (steinUpper δ / 2)..(r + t), brsKernel D t r s * steinBump D δ s) =
      ∫ s in (2 * steinLower δ)..(r + t), brsKernel D t r s * steinBump D δ s :=
    intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
  have hpos1 : 0 ≤ ∫ s in |r - t|..(2 * steinLower δ),
      brsKernel D t r s * steinBump D δ s := by
    refine intervalIntegral.integral_nonneg hα ?_
    intro s hs
    exact hnonneg s (le_trans (abs_nonneg _) hs.1)
  have hpos2 : 0 ≤ ∫ s in (steinUpper δ / 2)..(r + t),
      brsKernel D t r s * steinBump D δ s := by
    refine intervalIntegral.integral_nonneg hβ ?_
    intro s hs
    have hupos : 0 < steinUpper δ / 2 := by
      have := steinUpper_pos hδ
      linarith
    exact hnonneg s (le_trans hupos.le hs.1)
  have hweightint : IntervalIntegrable (fun s : ℝ =>
      (1 / (36 ^ (D - 3) * 18) : ℝ) *
        (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))))
      volume (2 * steinLower δ) (steinUpper δ / 2) := by
    refine ContinuousOn.intervalIntegrable ?_
    have hpos : ∀ x ∈ Set.uIcc (2 * steinLower δ) (steinUpper δ / 2), 0 < x := by
      intro x hx
      rw [Set.uIcc_of_le hplateau] at hx
      exact lt_of_lt_of_le (by linarith) hx.1
    refine ContinuousOn.mul continuousOn_const (ContinuousOn.mul
      (ContinuousOn.inv₀ continuousOn_id fun x hx => (hpos x hx).ne') ?_)
    refine ContinuousOn.rpow_const ?_ ?_
    · refine ContinuousOn.log
        (ContinuousOn.div continuousOn_const continuousOn_id
          fun x hx => (hpos x hx).ne') ?_
      intro x hx
      exact (div_pos one_pos (hpos x hx)).ne'
    · intro x hx
      left
      have hxpos := hpos x hx
      rw [Set.uIcc_of_le hplateau] at hx
      have h3 := three_le_log_of_mem_plateau hδ hL hx.2 hxpos
      have hlogpos : 0 < Real.log (1 / x) := by linarith
      exact hlogpos.ne'
  have hmono : (∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        (1 / (36 ^ (D - 3) * 18) : ℝ) *
          (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ))))) ≤
      ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        brsKernel D t r s * steinBump D δ s := by
    refine intervalIntegral.integral_mono_on hplateau hweightint (hint _ _) ?_
    intro s hs
    exact le_kernel_mul_steinBump hD hδ hL ht1 ht2 hrt hs.1 hs.2
  have hconst : (∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
        (1 / (36 ^ (D - 3) * 18) : ℝ) *
          (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ))))) =
      (1 / (36 ^ (D - 3) * 18) : ℝ) *
        ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
          s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ))) :=
    intervalIntegral.integral_const_mul _ _
  have hgain := le_integral_stein_weight (d := D) hD2 hδ hL
  have hcpos : (0 : ℝ) < 1 / (36 ^ (D - 3) * 18) := by positivity
  calc (1 / (36 ^ (D - 3) * 18) : ℝ) * (Real.log (1 / δ) ^ (1 / (D : ℝ)) / 8)
      ≤ (1 / (36 ^ (D - 3) * 18) : ℝ) *
          ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
            s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ))) :=
        mul_le_mul_of_nonneg_left hgain hcpos.le
    _ = ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
          (1 / (36 ^ (D - 3) * 18) : ℝ) *
            (s⁻¹ * Real.log (1 / s) ^ (-(((D : ℝ) - 1) / (D : ℝ)))) := hconst.symm
    _ ≤ ∫ s in (2 * steinLower δ)..(steinUpper δ / 2),
          brsKernel D t r s * steinBump D δ s := hmono
    _ ≤ ∫ s in (2 * steinLower δ)..(r + t),
          brsKernel D t r s * steinBump D δ s := by
        rw [← hsplit2]
        linarith
    _ ≤ ∫ s in |r - t|..(r + t), brsKernel D t r s * steinBump D δ s := by
        rw [← hsplit1]
        linarith

/-- The constant of the Lemma 3.4 lower bound in ambient dimension `d + 1`. -/
def steinLowerConst (d : ℕ) : ℝ :=
  ((surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2))) *
    ((1 / (36 ^ (d - 2) * 18)) * (1 / 8))

theorem steinLowerConst_pos {d : ℕ} (hd : 2 ≤ d) : 0 < steinLowerConst d := by
  have h1 : 0 < surfaceMass d := surfaceMass_pos (by omega)
  have h2 : 0 < surfaceMass (d + 1) := surfaceMass_pos (by omega)
  rw [steinLowerConst]
  positivity

/-- **The pointwise lower bound of BRS Lemma 3.4.**  If `‖x‖` is within
`δ^{1/2}` of a dilation `t ∈ [1,2]`, the spherical average of the Stein test
function at `x` is at least `c (log(1/δ))^{1/(d+1)}`. -/
theorem le_norm_sphericalAverage_steinFun {d : ℕ} (hd : 2 ≤ d) {δ : ℝ}
    (hδ : 0 < δ) (hL : 12 ≤ Real.log (1 / δ)) {t : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2)
    {x : Euclidean (d + 1)} (hx : |‖x‖ - t| ≤ steinLower δ) :
    steinLowerConst d * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) ≤
      ‖_root_.Spherical.sphericalAverage t (fun y => steinFun (d + 1) δ ‖y‖) x‖ := by
  have hD : 3 ≤ d + 1 := by omega
  have habs := abs_le.mp hx
  have hlowhalf : steinLower δ ≤ 1 / 2 := steinLower_le_half hδ hL
  have hnormpos : 0 < ‖x‖ := by linarith [habs.1]
  have hx0 : x ≠ 0 := norm_pos_iff.mp hnormpos
  have ht0 : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hC1 : 0 < surfaceMass d := surfaceMass_pos (by omega)
  have hC2 : 0 < surfaceMass (d + 1) := surfaceMass_pos (by omega)
  set C : ℝ := (surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2))
    with hCdef
  have hCpos : 0 < C := by
    rw [hCdef]
    positivity
  -- the interval-integral bound, with the exponents in ambient dimension d+1
  have hcast : ((d + 1 : ℕ) : ℝ) = (d : ℝ) + 1 := by push_cast; ring
  have hsub : d + 1 - 3 = d - 2 := by omega
  have hbound := le_intervalIntegral_kernel_steinBump (D := d + 1) hD hδ hL ht1 ht2
    (r := ‖x‖) hx
  rw [hcast, hsub] at hbound
  -- rewrite the spherical average
  have hintegrand : ∀ s : ℝ,
      ((brsKernel (d + 1) t ‖x‖ s : ℝ)) • steinFun (d + 1) δ s =
        ((brsKernel (d + 1) t ‖x‖ s * steinBump (d + 1) δ s : ℝ) : ℂ) := by
    intro s
    rw [steinFun, Complex.real_smul]
    push_cast
    ring
  rw [sphericalAverage_eq_kernel_integral hd (steinFun (d + 1) δ)
    (continuous_steinFun _ hδ) hx0 ht0]
  simp only [hintegrand]
  rw [intervalIntegral.integral_ofReal, ← hCdef, ← Complex.ofReal_mul,
    Complex.norm_real]
  have hIpos : 0 ≤ ∫ s in |‖x‖ - t|..(‖x‖ + t),
      brsKernel (d + 1) t ‖x‖ s * steinBump (d + 1) δ s := by
    refine le_trans ?_ hbound
    have hLpos : 0 < Real.log (1 / δ) := by linarith
    positivity
  rw [Real.norm_of_nonneg (by positivity)]
  calc steinLowerConst d * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))
      = C * ((1 / (36 ^ (d - 2) * 18)) *
          (Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) / 8)) := by
        rw [steinLowerConst, hCdef]
        ring
    _ ≤ C * ∫ s in |‖x‖ - t|..(‖x‖ + t),
          brsKernel (d + 1) t ‖x‖ s * steinBump (d + 1) δ s :=
        mul_le_mul_of_nonneg_left hbound hCpos.le

theorem delta_le_steinLower {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) :
    δ ≤ steinLower δ := by
  have h : δ ^ (1 : ℝ) ≤ δ ^ (1 / 2 : ℝ) :=
    Real.rpow_le_rpow_of_exponent_ge hδ hδ1 (by norm_num : (1 : ℝ) / 2 ≤ 1)
  rwa [Real.rpow_one] at h

/-- **BRS Lemma 3.4**, in separated-set form: for every `δ`-separated subset
`T` of `E` and every `δ ≤ e^{-12}`, the radial operator norm at the endpoint
exponent `p_D = D/(D-1)`, `D = d+1`, is at least
`(card T)^{1/q} δ^{1/q} (log(1/δ))^{1/D}` up to a constant. -/
theorem le_eLpNorm_ratio_stein {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq : 0 < q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ : ℝ, 0 < δ → 12 ≤ Real.log (1 / δ) → ∀ T : Finset ℝ,
      (↑T : Set ℝ) ⊆ E → (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
        ENNReal.ofReal (c * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
              Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
            eLpNorm (fun y : Euclidean (d + 1) => steinFun (d + 1) δ ‖y‖)
              (ENNReal.ofReal (((d : ℝ) + 1) / ((d : ℝ) + 1 - 1))) volume ≤
          eLpNorm (M E (fun y : Euclidean (d + 1) => steinFun (d + 1) δ ‖y‖))
            (ENNReal.ofReal q) volume := by
  have hd1 : 0 < d + 1 := by omega
  haveI : Nonempty (Fin (d + 1)) := ⟨⟨0, hd1⟩⟩
  have hqinv : (0 : ℝ) ≤ 1 / q := le_of_lt (div_pos one_pos hq)
  set V : ℝ := (volume (Metric.ball (0 : Euclidean (d + 1)) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean (d + 1)) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean (d + 1)) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean (d + 1)) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  set c1 : ℝ := (3 / 4 : ℝ) ^ d / 2 with hc1
  have hc1pos : 0 < c1 := by
    rw [hc1]
    positivity
  set Sm : ℝ := surfaceMass (d + 1) with hSm
  have hSmpos : 0 < Sm := surfaceMass_pos hd1
  set K : ℝ := steinLowerConst d with hK
  have hKpos : 0 < K := steinLowerConst_pos hd
  refine ⟨K * (c1 * V) ^ (1 / q) / Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)),
    div_pos (mul_pos hKpos (Real.rpow_pos_of_pos (mul_pos hc1pos hVpos) _))
      (Real.rpow_pos_of_pos hSmpos _), ?_⟩
  intro δ hδ hL T hTE hsep
  have hδ1 : δ < 1 := delta_lt_one_of_log hδ hL
  have hLpos : 0 < Real.log (1 / δ) := by linarith
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  set f : Euclidean (d + 1) → ℂ := fun y => steinFun (d + 1) δ ‖y‖ with hf
  set S : Set (Euclidean (d + 1)) :=
    ⋃ t ∈ T, radialAnnulusIcc (d + 1) (t - δ / 4) (t + δ / 4) with hS
  have hSmeas : MeasurableSet S := by
    rw [hS]
    exact Finset.measurableSet_biUnion _ fun t _ =>
      measurableSet_radialAnnulusIcc (d + 1) _ _
  -- the pointwise lower bound on `S`
  have hlarge : ∀ x ∈ S,
      ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) ≤ M E f x := by
    intro x hx
    obtain ⟨t, htT, hxt⟩ : ∃ t ∈ T,
        x ∈ radialAnnulusIcc (d + 1) (t - δ / 4) (t + δ / 4) := by
      rw [hS] at hx
      simpa only [Set.mem_iUnion, exists_prop] using hx
    have htE : t ∈ E := hTE htT
    have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
    have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
    have hclose : |‖x‖ - t| ≤ steinLower δ := by
      have hhalf : |‖x‖ - t| ≤ δ / 2 := by
        rw [radialAnnulusIcc, mem_setOf_eq, mem_Icc] at hxt
        rw [abs_le]
        exact ⟨by linarith [hxt.1], by linarith [hxt.2]⟩
      have := delta_le_steinLower hδ hδ1.le
      linarith
    have havg := le_norm_sphericalAverage_steinFun hd hδ hL htIcc.1 htIcc.2 hclose
    unfold M _root_.Spherical.restrictedSphericalMaximal
    refine le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ ?_)
    exact ENNReal.ofReal_le_ofReal havg
  have hlow : ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
      volume S ^ (1 / q) ≤ eLpNorm (M E f) (ENNReal.ofReal q) volume :=
    le_eLpNorm_of_const_le_on hSmeas
      (mul_nonneg hKpos.le (Real.rpow_nonneg hLpos.le _)) hlarge hq
  -- the volume of `S`
  have hvol : ENNReal.ofReal ((T.card : ℝ) * (c1 * δ) * V) ≤ volume S := by
    have hkey : ENNReal.ofReal ((T.card : ℝ) * (c1 * δ) * V) =
        (T.card : ENNReal) *
          (ENNReal.ofReal ((3 / 4 : ℝ) ^ (d + 1 - 1) * (δ / 2)) *
            ENNReal.ofReal V) := by
      rw [ENNReal.ofReal_mul (mul_nonneg hcard (mul_nonneg hc1pos.le hδ.le)),
        ENNReal.ofReal_mul hcard, ENNReal.ofReal_natCast, mul_assoc]
      congr 2
      rw [hc1, show d + 1 - 1 = d by omega]
      ring
    rw [hkey, ← hVeq, hS]
    exact volume_biUnion_separated_annuli_ge hd1 hδ hδ1.le
      (fun t ht => hE (hTE ht)) hsep
  -- the norm of the test function
  have hnorm : eLpNorm f (ENNReal.ofReal (((d : ℝ) + 1) / ((d : ℝ) + 1 - 1)))
      volume ≤ ENNReal.ofReal (Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))) := by
    have hcast : ((d + 1 : ℕ) : ℝ) = (d : ℝ) + 1 := Nat.cast_add_one d
    have hexpnn : (0 : ℝ) ≤ ((d : ℝ) + 1 - 1) / ((d : ℝ) + 1) := by
      rw [show ((d : ℝ) + 1 - 1) = (d : ℝ) by ring]
      positivity
    have hbound := eLpNorm_steinFun_lift_le (d := d + 1) (by omega) hδ hδ1
    rw [hcast] at hbound
    refine le_trans hbound (le_of_eq ?_)
    rw [hSm, ENNReal.ofReal_rpow_of_nonneg (surfaceMass_pos hd1).le hexpnn]
  -- exponent bookkeeping
  set A : ℝ := K * (c1 * V) ^ (1 / q) / Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))
    with hA
  have hApos : 0 < A := by
    rw [hA]
    exact div_pos (mul_pos hKpos (Real.rpow_pos_of_pos (mul_pos hc1pos hVpos) _))
      (Real.rpow_pos_of_pos hSmpos _)
  have hcoefnonneg : (0 : ℝ) ≤ A * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
      Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) :=
    mul_nonneg (mul_nonneg (mul_nonneg hApos.le (Real.rpow_nonneg hcard _))
      (Real.rpow_nonneg hδ.le _)) (Real.rpow_nonneg hLpos.le _)
  have hreal : A * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
        Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
        Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)) ≤
      K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
        ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q) := by
    have hsplit : ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q) =
        (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * (c1 * V) ^ (1 / q) := by
      rw [show (T.card : ℝ) * (c1 * δ) * V = ((T.card : ℝ) * δ) * (c1 * V) by ring,
        Real.mul_rpow (mul_nonneg hcard hδ.le) (mul_nonneg hc1pos.le hVpos.le),
        Real.mul_rpow hcard hδ.le]
    have hcancel : Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)) /
        Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)) = 1 :=
      div_self (ne_of_gt (Real.rpow_pos_of_pos hSmpos _))
    rw [hsplit, hA]
    calc K * (c1 * V) ^ (1 / q) / Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)) *
          (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
          Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
          Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))
        = K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
            ((T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * (c1 * V) ^ (1 / q)) *
            (Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1)) /
              Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))) := by ring
      _ = K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
            ((T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * (c1 * V) ^ (1 / q)) := by
          rw [hcancel, mul_one]
      _ ≤ _ := le_rfl
  calc ENNReal.ofReal (A * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
          Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
        eLpNorm f (ENNReal.ofReal (((d : ℝ) + 1) / ((d : ℝ) + 1 - 1))) volume
      ≤ ENNReal.ofReal (A * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
            Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
          ENNReal.ofReal (Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))) :=
        mul_le_mul' le_rfl hnorm
    _ = ENNReal.ofReal (A * (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) *
          Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
          Sm ^ (((d : ℝ) + 1 - 1) / ((d : ℝ) + 1))) := by
        rw [← ENNReal.ofReal_mul hcoefnonneg]
    _ ≤ ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1)) *
          ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q)) := ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
          ENNReal.ofReal (((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q)) := by
        rw [ENNReal.ofReal_mul (mul_nonneg hKpos.le (Real.rpow_nonneg hLpos.le _))]
    _ = ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
          ENNReal.ofReal ((T.card : ℝ) * (c1 * δ) * V) ^ (1 / q) := by
        rw [ENNReal.ofReal_rpow_of_nonneg
          (mul_nonneg (mul_nonneg hcard (mul_nonneg hc1pos.le hδ.le)) hVpos.le)
          hqinv]
    _ ≤ ENNReal.ofReal (K * Real.log (1 / δ) ^ (1 / ((d : ℝ) + 1))) *
          volume S ^ (1 / q) := by
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hvol hqinv)
    _ ≤ eLpNorm (M E f) (ENNReal.ofReal q) volume := hlow

/-! ## The Seeger--Wainger--Wright decomposition, BRS (4.3)

For a radial function with profile `f₀`, BRS follows [SWW] and substitutes
`g(s) = f₀(s) s^{(d-1)/p}`, which turns `L^p(s^{d-1} ds)` into the unweighted
`L^p(ds)`.  The maximal operator is then dominated by a main term `𝔐_p`,
carrying the dilations `t` comparable to the radius `r`, plus two remainders
`R₁` (small dilations) and `R₂` (large dilations). -/

/-- The substitution `g(s) = f₀(s) s^{(d-1)/p}` of BRS Lemma 4.1. -/
def brsProfileSub (d : ℕ) (p : ℝ) (f₀ : ℝ → ℂ) : ℝ → ℂ :=
  fun s => ((s ^ (((d : ℝ) - 1) / p) : ℝ) : ℂ) * f₀ s

/-- The main term `𝔐_p` of BRS (4.3): the dilations comparable to the radius.
The exponent `(d-1)/p' - 1` is written with `1/p' = 1 - 1/p`. -/
def brsMainMaximal (d : ℕ) (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r ^ (1 - (d : ℝ)) *
      ‖∫ s in |r - t|..(r + t),
        ((s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) * g s‖)

/-- The first remainder `R₁` of BRS (4.3): the dilations `t ≤ r/2`. -/
def brsRemainderOne (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ Icc (1 : ℝ) 2 ∩ Iic (r / 2),
    ENNReal.ofReal (t⁻¹ * ‖∫ s in (r - t)..(r + t), f₀ s‖)

/-- The second remainder `R₂` of BRS (4.3): the dilations `t ≥ 3r/2`. -/
def brsRemainderTwo (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ Icc (1 : ℝ) 2 ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - r)..(t + r), f₀ s‖)

theorem brsProfileSub_apply (d : ℕ) (p : ℝ) (f₀ : ℝ → ℂ) (s : ℝ) :
    brsProfileSub d p f₀ s = ((s ^ (((d : ℝ) - 1) / p) : ℝ) : ℂ) * f₀ s := rfl

/-- Undoing the substitution: on positive radii the integrand of `𝔐_p`
applied to `g = brsProfileSub d p f₀` is `s^{d-2} f₀ s`. -/
theorem brsMainMaximal_integrand {d : ℕ} {p : ℝ} (hp : 0 < p) (f₀ : ℝ → ℂ)
    {s : ℝ} (hs : 0 < s) :
    ((s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) *
        brsProfileSub d p f₀ s =
      ((s ^ ((d : ℝ) - 2) : ℝ) : ℂ) * f₀ s := by
  rw [brsProfileSub_apply]
  rw [show ((s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) *
      (((s ^ (((d : ℝ) - 1) / p) : ℝ) : ℂ) * f₀ s) =
      (((s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1) * s ^ (((d : ℝ) - 1) / p) : ℝ)) : ℂ) *
        f₀ s by push_cast; ring]
  congr 2
  rw [← Real.rpow_add hs]
  congr 1
  field_simp
  ring

/-- Each of the three pieces is monotone in the profile, in the sense that a
pointwise bound on the integrands transfers.  This is the form in which the
decomposition is used. -/
theorem brsRemainderOne_le_of_le {f₀ h₀ : ℝ → ℂ} {r : ℝ}
    (h : ∀ t ∈ Icc (1 : ℝ) 2 ∩ Iic (r / 2),
      ‖∫ s in (r - t)..(r + t), f₀ s‖ ≤ ‖∫ s in (r - t)..(r + t), h₀ s‖) :
    brsRemainderOne f₀ r ≤ brsRemainderOne h₀ r := by
  refine iSup₂_mono fun t ht => ?_
  have hpos : (0 : ℝ) ≤ t⁻¹ := by
    have : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht.1.1
    positivity
  exact ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left (h t ht) hpos)

/-- Natural powers of a positive real as real powers. -/
theorem pow_sub_eq_rpow {x : ℝ} (hx : 0 < x) {D k : ℕ} (h : k ≤ D) :
    x ^ (D - k) = x ^ ((D : ℝ) - (k : ℝ)) := by
  rw [← Real.rpow_natCast x (D - k)]
  congr 1
  push_cast [Nat.cast_sub h]
  ring

theorem brsKernel_sq_nonneg_left {t r s : ℝ} (hs0 : 0 ≤ s) (hs2 : s ≤ r + t) :
    (0 : ℝ) ≤ (r + t) ^ 2 - s ^ 2 := by
  have := pow_le_pow_left₀ hs0 hs2 2
  linarith

theorem brsKernel_sq_nonneg_right {t r s : ℝ} (hs1 : |r - t| ≤ s) :
    (0 : ℝ) ≤ s ^ 2 - (r - t) ^ 2 := by
  have h := pow_le_pow_left₀ (abs_nonneg (r - t)) hs1 2
  rw [sq_abs] at h
  linarith

/-- The product of the two square roots in the kernel (4.2) is the square root
of the product. -/
theorem brsKernel_sqrt_mul {t r s : ℝ} (hs0 : 0 ≤ s) (hs2 : s ≤ r + t) :
    Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (((r + t) ^ 2 - s ^ 2) * (s ^ 2 - (r - t) ^ 2)) :=
  (Real.sqrt_mul (brsKernel_sq_nonneg_left hs0 hs2) _).symm

/-- **The kernel bound in the main range** `r/2 < t < 3r/2` of BRS Lemma 4.1:
the kernel is at most `C r^{1-D} s^{D-2}`. -/
theorem brsKernel_le_main {D : ℕ} (hD : 3 ≤ D) {t r s : ℝ} (hr : 0 < r)
    (ht1 : r / 2 < t) (ht2 : t < 3 * r / 2) (hs0 : 0 < s) (hs2 : s ≤ r + t) :
    brsKernel D t r s ≤ ((5 / 4 : ℝ) ^ (D - 3) / 2) *
      (r ^ (1 - (D : ℝ)) * s ^ ((D : ℝ) - 2)) := by
  have htpos : 0 < t := lt_trans (by positivity) ht1
  have h4rt : 0 < 4 * r * t := by positivity
  have h4rt2 : 2 * r ^ 2 ≤ 4 * r * t := by nlinarith
  have hrt : r + t ≤ 5 * r / 2 := by linarith
  -- the bracket
  have hsq1 : Real.sqrt ((r + t) ^ 2 - s ^ 2) ≤ r + t := by
    have h := Real.sqrt_le_sqrt
      (show (r + t) ^ 2 - s ^ 2 ≤ (r + t) ^ 2 by nlinarith)
    rwa [Real.sqrt_sq (by positivity : (0 : ℝ) ≤ r + t)] at h
  have hsq2 : Real.sqrt (s ^ 2 - (r - t) ^ 2) ≤ s := by
    have h := Real.sqrt_le_sqrt
      (show s ^ 2 - (r - t) ^ 2 ≤ s ^ 2 by nlinarith)
    rwa [Real.sqrt_sq hs0.le] at h
  have hnum : Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) ≤
      (5 * r / 2) * s := by
    refine mul_le_mul (le_trans hsq1 hrt) hsq2 (Real.sqrt_nonneg _) (by positivity)
  have hbracket : Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) ≤ 5 * s / (4 * r) := by
    rw [div_le_div_iff₀ h4rt (by positivity)]
    nlinarith [Real.sqrt_nonneg ((r + t) ^ 2 - s ^ 2),
      Real.sqrt_nonneg (s ^ 2 - (r - t) ^ 2), hnum, h4rt2, hs0.le]
  have hbrnonneg : (0 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) := by positivity
  have hlast : s / (4 * r * t) ≤ s / (2 * r ^ 2) :=
    div_le_div_of_nonneg_left hs0.le (by positivity) h4rt2
  -- assemble
  have hkey : (5 * s / (4 * r)) ^ (D - 3) * (s / (2 * r ^ 2)) =
      ((5 / 4 : ℝ) ^ (D - 3) / 2) * (r ^ (1 - (D : ℝ)) * s ^ ((D : ℝ) - 2)) := by
    have hs3 : s ^ (D - 3) * s = s ^ (D - 2) := by
      rw [← pow_succ, show D - 3 + 1 = D - 2 by omega]
    have hr3 : r ^ (D - 3) * r ^ 2 = r ^ (D - 1) := by
      rw [← pow_add, show D - 3 + 2 = D - 1 by omega]
    have hsr : s ^ (D - 2) = s ^ ((D : ℝ) - 2) := by
      have := pow_sub_eq_rpow hs0 (D := D) (k := 2) (by omega)
      simpa using this
    have hrr : (r ^ (D - 1) : ℝ)⁻¹ = r ^ (1 - (D : ℝ)) := by
      have h1 : (r ^ (D - 1) : ℝ) = r ^ ((D : ℝ) - 1) := by
        have := pow_sub_eq_rpow hr (D := D) (k := 1) (by omega)
        simpa using this
      rw [h1, ← Real.rpow_neg hr.le]
      congr 1
      ring
    have hrne : r ≠ 0 := hr.ne'
    calc (5 * s / (4 * r)) ^ (D - 3) * (s / (2 * r ^ 2))
        = ((5 / 4 : ℝ) ^ (D - 3) / 2) * ((s ^ (D - 3) * s) / (r ^ (D - 3) * r ^ 2)) := by
          rw [show (5 * s / (4 * r) : ℝ) = (5 / 4) * (s / r) by ring, mul_pow, div_pow]
          ring
      _ = ((5 / 4 : ℝ) ^ (D - 3) / 2) * (s ^ (D - 2) / r ^ (D - 1)) := by
          rw [hs3, hr3]
      _ = ((5 / 4 : ℝ) ^ (D - 3) / 2) * (r ^ (1 - (D : ℝ)) * s ^ ((D : ℝ) - 2)) := by
          rw [← hrr, ← hsr]
          field_simp
  rw [brsKernel_eq_of_pos, ← hkey]
  refine mul_le_mul ?_ hlast (by positivity) (by positivity)
  exact pow_le_pow_left₀ hbrnonneg hbracket _

/-- **The kernel bound for small dilations** `t ≤ r/2` of BRS Lemma 4.1. -/
theorem brsKernel_le_small {D : ℕ} (hD : 3 ≤ D) {t r s : ℝ} (htpos : 0 < t)
    (ht : t ≤ r / 2) (hs1 : r - t ≤ s) (hs2 : s ≤ r + t) :
    brsKernel D t r s ≤ (3 * (5 / 4 : ℝ) ^ (D - 3) / 8) * t⁻¹ := by
  have hr : 0 < r := by linarith
  have h4rt : 0 < 4 * r * t := by positivity
  have hs0 : 0 ≤ s := by linarith
  have habs : |r - t| ≤ s := by
    rw [abs_le]
    constructor <;> linarith
  -- the bracket is bounded by 5/4
  have hprod : ((r + t) ^ 2 - s ^ 2) * (s ^ 2 - (r - t) ^ 2) ≤ (5 * t * r) ^ 2 := by
    have h1 : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
    have h2 : s ^ 2 - (r - t) ^ 2 = (s - r + t) * (s + r - t) := by ring
    have hb1 : r + t - s ≤ 2 * t := by linarith
    have hb2 : r + t + s ≤ 3 * r := by linarith
    have hb3 : s - r + t ≤ 2 * t := by linarith
    have hb4 : s + r - t ≤ 2 * r := by linarith
    have hn1 : 0 ≤ r + t - s := by linarith
    have hn2 : 0 ≤ s - r + t := by linarith
    have hn3 : 0 ≤ r + t + s := by linarith
    have hn4 : 0 ≤ s + r - t := by linarith
    have hAB : (r + t - s) * (r + t + s) ≤ 2 * t * (3 * r) :=
      mul_le_mul hb1 hb2 hn3 (by positivity)
    have hCD : (s - r + t) * (s + r - t) ≤ 2 * t * (2 * r) :=
      mul_le_mul hb3 hb4 hn4 (by positivity)
    rw [h1, h2]
    calc (r + t - s) * (r + t + s) * ((s - r + t) * (s + r - t))
        ≤ (2 * t * (3 * r)) * (2 * t * (2 * r)) :=
          mul_le_mul hAB hCD (mul_nonneg hn2 hn4) (by positivity)
      _ ≤ (5 * t * r) ^ 2 := by nlinarith
  have hsqrt : Real.sqrt (((r + t) ^ 2 - s ^ 2) * (s ^ 2 - (r - t) ^ 2)) ≤
      5 * t * r := by
    have h := Real.sqrt_le_sqrt hprod
    rwa [Real.sqrt_sq (by positivity : (0 : ℝ) ≤ 5 * t * r)] at h
  have hbracket : Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) ≤ 5 / 4 := by
    rw [brsKernel_sqrt_mul hs0 hs2, div_le_iff₀ h4rt]
    nlinarith [hsqrt]
  have hbrnonneg : (0 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) := by positivity
  have hlast : s / (4 * r * t) ≤ 3 / 8 * t⁻¹ := by
    have hcalc : 3 / 8 * t⁻¹ * (4 * r * t) = 3 * r / 2 := by
      field_simp
      ring
    rw [div_le_iff₀ h4rt, hcalc]
    linarith
  rw [brsKernel_eq_of_pos]
  calc (Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) /
        (4 * r * t)) ^ (D - 3) * (s / (4 * r * t))
      ≤ (5 / 4 : ℝ) ^ (D - 3) * (3 / 8 * t⁻¹) := by
        refine mul_le_mul (pow_le_pow_left₀ hbrnonneg hbracket _) hlast
          (by positivity) (by positivity)
    _ = (3 * (5 / 4 : ℝ) ^ (D - 3) / 8) * t⁻¹ := by ring

/-- **The kernel bound for large dilations** `t ≥ 3r/2` of BRS Lemma 4.1. -/
theorem brsKernel_le_large {D : ℕ} (hD : 3 ≤ D) {t r s : ℝ} (hr : 0 < r)
    (ht : 3 * r / 2 ≤ t) (hs1 : t - r ≤ s) (hs2 : s ≤ t + r) :
    brsKernel D t r s ≤ (5 * (3 / 2 : ℝ) ^ (D - 3) / 12) * r⁻¹ := by
  have htpos : 0 < t := by linarith
  have h4rt : 0 < 4 * r * t := by positivity
  have hs0 : 0 ≤ s := by linarith
  have hs2' : s ≤ r + t := by linarith
  have habs : |r - t| ≤ s := by
    rw [abs_le]
    constructor <;> linarith
  have hprod : ((r + t) ^ 2 - s ^ 2) * (s ^ 2 - (r - t) ^ 2) ≤ (6 * r * t) ^ 2 := by
    have h1 : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
    have h2 : s ^ 2 - (r - t) ^ 2 = (s - t + r) * (s + t - r) := by ring
    have hb1 : r + t - s ≤ 2 * r := by linarith
    have hb2 : r + t + s ≤ 4 * t := by linarith
    have hb3 : s - t + r ≤ 2 * r := by linarith
    have hb4 : s + t - r ≤ 2 * t := by linarith
    have hn1 : 0 ≤ r + t - s := by linarith
    have hn2 : 0 ≤ s - t + r := by linarith
    have hn3 : 0 ≤ r + t + s := by linarith
    have hn4 : 0 ≤ s + t - r := by linarith
    have hAB : (r + t - s) * (r + t + s) ≤ 2 * r * (4 * t) :=
      mul_le_mul hb1 hb2 hn3 (by positivity)
    have hCD : (s - t + r) * (s + t - r) ≤ 2 * r * (2 * t) :=
      mul_le_mul hb3 hb4 hn4 (by positivity)
    rw [h1, h2]
    calc (r + t - s) * (r + t + s) * ((s - t + r) * (s + t - r))
        ≤ (2 * r * (4 * t)) * (2 * r * (2 * t)) :=
          mul_le_mul hAB hCD (mul_nonneg hn2 hn4) (by positivity)
      _ ≤ (6 * r * t) ^ 2 := by nlinarith
  have hsqrt : Real.sqrt (((r + t) ^ 2 - s ^ 2) * (s ^ 2 - (r - t) ^ 2)) ≤
      6 * r * t := by
    have h := Real.sqrt_le_sqrt hprod
    rwa [Real.sqrt_sq (by positivity : (0 : ℝ) ≤ 6 * r * t)] at h
  have hbracket : Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) ≤ 3 / 2 := by
    rw [brsKernel_sqrt_mul hs0 hs2', div_le_iff₀ h4rt]
    nlinarith [hsqrt]
  have hbrnonneg : (0 : ℝ) ≤ Real.sqrt ((r + t) ^ 2 - s ^ 2) *
      Real.sqrt (s ^ 2 - (r - t) ^ 2) / (4 * r * t) := by positivity
  have hlast : s / (4 * r * t) ≤ 5 / 12 * r⁻¹ := by
    have hcalc : 5 / 12 * r⁻¹ * (4 * r * t) = 5 * t / 3 := by
      field_simp
      ring
    rw [div_le_iff₀ h4rt, hcalc]
    linarith
  rw [brsKernel_eq_of_pos]
  calc (Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) /
        (4 * r * t)) ^ (D - 3) * (s / (4 * r * t))
      ≤ (3 / 2 : ℝ) ^ (D - 3) * (5 / 12 * r⁻¹) := by
        refine mul_le_mul (pow_le_pow_left₀ hbrnonneg hbracket _) hlast
          (by positivity) (by positivity)
    _ = (5 * (3 / 2 : ℝ) ^ (D - 3) / 12) * r⁻¹ := by ring

/-- The pointwise modulus of a profile, as a complex-valued profile.  The
decomposition of BRS Lemma 4.1 is applied to it; this changes no `L^p` norm. -/
def absProfile (f₀ : ℝ → ℂ) : ℝ → ℂ := fun s => ((‖f₀ s‖ : ℝ) : ℂ)

theorem continuous_absProfile {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Continuous (absProfile f₀) :=
  Complex.continuous_ofReal.comp hf₀.norm

theorem norm_absProfile (f₀ : ℝ → ℂ) (s : ℝ) : ‖absProfile f₀ s‖ = ‖f₀ s‖ := by
  rw [absProfile, Complex.norm_real, Real.norm_of_nonneg (norm_nonneg _)]

/-- The main-range kernel bound, extended to `s = 0`. -/
theorem brsKernel_le_main' {D : ℕ} (hD : 3 ≤ D) {t r s : ℝ} (hr : 0 < r)
    (ht1 : r / 2 < t) (ht2 : t < 3 * r / 2) (hs0 : 0 ≤ s) (hs2 : s ≤ r + t) :
    brsKernel D t r s ≤ ((5 / 4 : ℝ) ^ (D - 3) / 2) *
      (r ^ (1 - (D : ℝ)) * s ^ ((D : ℝ) - 2)) := by
  rcases eq_or_lt_of_le hs0 with h | h
  · have hDR : (3 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
    have hexp : ((D : ℝ) - 2) ≠ 0 := by
      intro hcon
      linarith [hcon]
    have hzero : brsKernel D t r s = 0 := by
      rw [brsKernel, ← h]
      simp
    rw [hzero, ← h, Real.zero_rpow hexp]
    positivity
  · exact brsKernel_le_main hD hr ht1 ht2 h hs2

/-- Undoing the substitution `g = f₀ s^{(d-1)/p}`, valid also at `s = 0`. -/
theorem brsMainMaximal_integrand_nonneg {D : ℕ} (hD : 3 ≤ D) {p : ℝ} (hp : 0 < p)
    (f₀ : ℝ → ℂ) {s : ℝ} (hs : 0 ≤ s) :
    ((s ^ (((D : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) * brsProfileSub D p f₀ s =
      ((s ^ ((D : ℝ) - 2) : ℝ) : ℂ) * f₀ s := by
  rcases eq_or_lt_of_le hs with h | h
  · have hDR : (3 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
    have hexp1 : (((D : ℝ) - 1) / p) ≠ 0 := by
      have : (0 : ℝ) < ((D : ℝ) - 1) / p := by
        apply div_pos <;> linarith
      exact this.ne'
    have hexp2 : ((D : ℝ) - 2) ≠ 0 := by
      intro hcon
      linarith [hcon]
    rw [brsProfileSub, ← h, Real.zero_rpow hexp1, Real.zero_rpow hexp2]
    simp
  · exact brsMainMaximal_integrand hp f₀ h

/-- The norm of the integral of a nonnegative real integrand. -/
theorem norm_intervalIntegral_ofReal_nonneg {a b : ℝ} (hab : a ≤ b) (h : ℝ → ℝ)
    (hnn : ∀ s ∈ Icc a b, 0 ≤ h s) :
    ‖∫ s in a..b, ((h s : ℝ) : ℂ)‖ = ∫ s in a..b, h s := by
  rw [intervalIntegral.integral_ofReal, Complex.norm_real,
    Real.norm_of_nonneg (intervalIntegral.integral_nonneg hab hnn)]

/-- The spherical average of a radial function is dominated by the kernel
integral of the modulus of its profile. -/
theorem norm_sphericalAverage_le_kernel_integral {d : ℕ} (hd : 2 ≤ d) (f₀ : ℝ → ℂ)
    (hf₀ : Continuous f₀) {x : Euclidean (d + 1)} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ((surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2))) *
        ∫ s in |‖x‖ - t|..(‖x‖ + t), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hCpos : (0 : ℝ) <
      (surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2)) := by
    have h1 : 0 < surfaceMass d := surfaceMass_pos (by omega)
    have h2 : 0 < surfaceMass (d + 1) := surfaceMass_pos (by omega)
    positivity
  have hab : |‖x‖ - t| ≤ ‖x‖ + t := by
    rw [abs_le]
    constructor <;> linarith
  have h4rt : 0 < 4 * ‖x‖ * t := by positivity
  rw [sphericalAverage_eq_kernel_integral hd f₀ hf₀ hx ht, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg hCpos.le]
  refine mul_le_mul_of_nonneg_left ?_ hCpos.le
  calc ‖∫ s in |‖x‖ - t|..(‖x‖ + t),
        ((brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s‖
      ≤ ∫ s in |‖x‖ - t|..(‖x‖ + t),
          ‖((brsKernel (d + 1) t ‖x‖ s : ℝ)) • f₀ s‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
    _ = ∫ s in |‖x‖ - t|..(‖x‖ + t), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ := by
        refine intervalIntegral.integral_congr ?_
        intro s hs
        rw [Set.uIcc_of_le hab] at hs
        have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
        simp only []
        rw [norm_smul, Real.norm_of_nonneg (brsKernel_nonneg (d + 1) h4rt hs0)]

theorem continuous_rpow_const_of_nonneg {c : ℝ} (hc : 0 ≤ c) :
    Continuous fun s : ℝ => s ^ c :=
  continuous_iff_continuousAt.mpr fun x => Real.continuousAt_rpow_const x c (Or.inr hc)

/-- The constant of the spherical-average kernel representation. -/
def brsAvgConst (d : ℕ) : ℝ :=
  (surfaceMass (d + 1))⁻¹ * surfaceMass d * ((4 : ℝ) * 2 ^ (d - 2))

theorem brsAvgConst_pos {d : ℕ} (hd : 2 ≤ d) : 0 < brsAvgConst d := by
  have h1 : 0 < surfaceMass d := surfaceMass_pos (by omega)
  have h2 : 0 < surfaceMass (d + 1) := surfaceMass_pos (by omega)
  rw [brsAvgConst]
  positivity

/-- **The main-range estimate of BRS Lemma 4.1.**  For a dilation `t ∈ E`
comparable to the radius, the spherical average is dominated by `𝔐_p`. -/
theorem le_brsMainMaximal_of_mem {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ} {p : ℝ}
    (hp : 0 < p) (f₀ : ℝ → ℂ) (hf₀ : Continuous f₀) {x : Euclidean (d + 1)}
    (hx : x ≠ 0) {t : ℝ} (htE : t ∈ E) (ht1 : ‖x‖ / 2 < t) (ht2 : t < 3 * ‖x‖ / 2) :
    ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ENNReal.ofReal (brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
        brsMainMaximal (d + 1) E p
          (brsProfileSub (d + 1) p (absProfile f₀)) ‖x‖ := by
  have hD : 3 ≤ d + 1 := by omega
  have hDR : (3 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) := by
    have : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    push_cast
    linarith
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have htpos : 0 < t := lt_trans (by positivity) ht1
  have hab : |‖x‖ - t| ≤ ‖x‖ + t := by
    rw [abs_le]
    constructor <;> linarith
  have h4rt : 0 < 4 * ‖x‖ * t := by positivity
  have hexpnn : (0 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) - 2 := by linarith
  have hCpos : 0 < brsAvgConst d := brsAvgConst_pos hd
  have hconstpos : (0 : ℝ) < (5 / 4 : ℝ) ^ (d + 1 - 3) / 2 := by positivity
  -- integrability of the two integrands
  have hcont1 : Continuous fun s : ℝ => brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ :=
    (continuous_brsKernel (d + 1) h4rt).mul hf₀.norm
  have hcont2 : Continuous fun s : ℝ =>
      ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2) *
        (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) * s ^ (((d + 1 : ℕ) : ℝ) - 2)) * ‖f₀ s‖ :=
    ((continuous_const.mul (continuous_const.mul
      (continuous_rpow_const_of_nonneg hexpnn))).mul hf₀.norm)
  -- the kernel bound, integrated
  have hmono : (∫ s in |‖x‖ - t|..(‖x‖ + t), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖) ≤
      ∫ s in |‖x‖ - t|..(‖x‖ + t),
        ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2) *
          (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) * s ^ (((d + 1 : ℕ) : ℝ) - 2)) * ‖f₀ s‖ := by
    refine intervalIntegral.integral_mono_on hab (hcont1.intervalIntegrable _ _)
      (hcont2.intervalIntegrable _ _) ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
    exact mul_le_mul_of_nonneg_right
      (brsKernel_le_main' (D := d + 1) hD hr ht1 ht2 hs0 hs.2) (norm_nonneg _)
  have hpull : (∫ s in |‖x‖ - t|..(‖x‖ + t),
        ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2) *
          (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) * s ^ (((d + 1 : ℕ) : ℝ) - 2)) * ‖f₀ s‖) =
      ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2) *
        (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
          ∫ s in |‖x‖ - t|..(‖x‖ + t),
            s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖) := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr ?_
    intro s hs
    simp only []
    ring
  -- the term of `𝔐_p` at this `t`
  have hMterm : ‖∫ s in |‖x‖ - t|..(‖x‖ + t),
        ((s ^ ((((d + 1 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) *
          brsProfileSub (d + 1) p (absProfile f₀) s‖ =
      ∫ s in |‖x‖ - t|..(‖x‖ + t), s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖ := by
    have hcongr : (∫ s in |‖x‖ - t|..(‖x‖ + t),
          ((s ^ ((((d + 1 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) *
            brsProfileSub (d + 1) p (absProfile f₀) s) =
        ∫ s in |‖x‖ - t|..(‖x‖ + t),
          ((s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖ : ℝ) : ℂ) := by
      refine intervalIntegral.integral_congr ?_
      intro s hs
      rw [Set.uIcc_of_le hab] at hs
      have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
      simp only []
      rw [brsMainMaximal_integrand_nonneg hD hp (absProfile f₀) hs0, absProfile]
      push_cast
      ring
    rw [hcongr]
    refine norm_intervalIntegral_ofReal_nonneg hab _ ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
    have : (0 : ℝ) ≤ s ^ (((d + 1 : ℕ) : ℝ) - 2) := Real.rpow_nonneg hs0 _
    positivity
  -- the real-valued chain
  have hchain : ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      (brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
        (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
          ∫ s in |‖x‖ - t|..(‖x‖ + t),
            s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖) := by
    have h1 := norm_sphericalAverage_le_kernel_integral hd f₀ hf₀ hx htpos
    rw [← brsAvgConst] at h1
    calc ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
        ≤ brsAvgConst d *
            ∫ s in |‖x‖ - t|..(‖x‖ + t), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ := h1
      _ ≤ brsAvgConst d *
            ∫ s in |‖x‖ - t|..(‖x‖ + t),
              ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2) *
                (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
                  s ^ (((d + 1 : ℕ) : ℝ) - 2)) * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_left hmono hCpos.le
      _ = (brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
            (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
              ∫ s in |‖x‖ - t|..(‖x‖ + t),
                s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖) := by
          rw [hpull]
          ring
  -- conclude
  have hnonneg : (0 : ℝ) ≤ ‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
      ∫ s in |‖x‖ - t|..(‖x‖ + t), s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖ := by
    refine mul_nonneg (Real.rpow_nonneg hr.le _) ?_
    refine intervalIntegral.integral_nonneg hab ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
    have : (0 : ℝ) ≤ s ^ (((d + 1 : ℕ) : ℝ) - 2) := Real.rpow_nonneg hs0 _
    positivity
  calc ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
      ≤ ENNReal.ofReal ((brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
          (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
            ∫ s in |‖x‖ - t|..(‖x‖ + t),
              s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖)) :=
        ENNReal.ofReal_le_ofReal hchain
    _ = ENNReal.ofReal (brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
          ENNReal.ofReal (‖x‖ ^ (1 - ((d + 1 : ℕ) : ℝ)) *
            ∫ s in |‖x‖ - t|..(‖x‖ + t),
              s ^ (((d + 1 : ℕ) : ℝ) - 2) * ‖f₀ s‖) := by
        rw [ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (brsAvgConst d * ((5 / 4 : ℝ) ^ (d + 1 - 3) / 2)) *
          brsMainMaximal (d + 1) E p
            (brsProfileSub (d + 1) p (absProfile f₀)) ‖x‖ := by
        refine mul_le_mul' le_rfl ?_
        refine le_iSup₂_of_le t ⟨htE, ht1, ht2⟩ ?_
        rw [hMterm]

/-- **The small-dilation estimate of BRS Lemma 4.1**: for `t ≤ r/2` the
spherical average is dominated by `R₁`. -/
theorem le_brsRemainderOne_of_le {d : ℕ} (hd : 2 ≤ d) (f₀ : ℝ → ℂ)
    (hf₀ : Continuous f₀) {x : Euclidean (d + 1)} (hx : x ≠ 0) {t : ℝ}
    (ht : t ∈ Icc (1 : ℝ) 2) (htr : t ≤ ‖x‖ / 2) :
    ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ENNReal.ofReal (brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
        brsRemainderOne (absProfile f₀) ‖x‖ := by
  have hD : 3 ≤ d + 1 := by omega
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht.1
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hrt : t ≤ ‖x‖ / 2 := htr
  have habs : |‖x‖ - t| = ‖x‖ - t := abs_of_nonneg (by linarith)
  have hab : ‖x‖ - t ≤ ‖x‖ + t := by linarith
  have h4rt : 0 < 4 * ‖x‖ * t := by positivity
  have hCpos : 0 < brsAvgConst d := brsAvgConst_pos hd
  have hconstpos : (0 : ℝ) < 3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8 := by positivity
  have hcont1 : Continuous fun s : ℝ => brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ :=
    (continuous_brsKernel (d + 1) h4rt).mul hf₀.norm
  have hcont2 : Continuous fun s : ℝ =>
      (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8) * t⁻¹ * ‖f₀ s‖ :=
    continuous_const.mul hf₀.norm
  have hmono : (∫ s in (‖x‖ - t)..(‖x‖ + t),
        brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖) ≤
      ∫ s in (‖x‖ - t)..(‖x‖ + t),
        (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8) * t⁻¹ * ‖f₀ s‖ := by
    refine intervalIntegral.integral_mono_on hab (hcont1.intervalIntegrable _ _)
      (hcont2.intervalIntegrable _ _) ?_
    intro s hs
    exact mul_le_mul_of_nonneg_right
      (brsKernel_le_small (D := d + 1) hD htpos hrt hs.1 hs.2) (norm_nonneg _)
  have hpull : (∫ s in (‖x‖ - t)..(‖x‖ + t),
        (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8) * t⁻¹ * ‖f₀ s‖) =
      (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8) *
        (t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖) := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr ?_
    intro s hs
    simp only []
    ring
  have hRterm : ‖∫ s in (‖x‖ - t)..(‖x‖ + t), absProfile f₀ s‖ =
      ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖ := by
    have : (fun s : ℝ => absProfile f₀ s) = fun s : ℝ => ((‖f₀ s‖ : ℝ) : ℂ) := rfl
    rw [this]
    exact norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
  have hchain : ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      (brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
        (t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖) := by
    have h1 := norm_sphericalAverage_le_kernel_integral hd f₀ hf₀ hx htpos
    rw [← brsAvgConst, habs] at h1
    calc ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
        ≤ brsAvgConst d *
            ∫ s in (‖x‖ - t)..(‖x‖ + t), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ := h1
      _ ≤ brsAvgConst d *
            ∫ s in (‖x‖ - t)..(‖x‖ + t),
              (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8) * t⁻¹ * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_left hmono hCpos.le
      _ = (brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
            (t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖) := by
          rw [hpull]
          ring
  have hnonneg : (0 : ℝ) ≤ t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖ := by
    refine mul_nonneg (by positivity) ?_
    exact intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
  calc ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
      ≤ ENNReal.ofReal ((brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
          (t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖)) :=
        ENNReal.ofReal_le_ofReal hchain
    _ = ENNReal.ofReal (brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
          ENNReal.ofReal (t⁻¹ * ∫ s in (‖x‖ - t)..(‖x‖ + t), ‖f₀ s‖) := by
        rw [ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (brsAvgConst d * (3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8)) *
          brsRemainderOne (absProfile f₀) ‖x‖ := by
        refine mul_le_mul' le_rfl ?_
        refine le_iSup₂_of_le t ⟨ht, htr⟩ ?_
        rw [hRterm]

/-- **The large-dilation estimate of BRS Lemma 4.1**: for `t ≥ 3r/2` the
spherical average is dominated by `R₂`. -/
theorem le_brsRemainderTwo_of_le {d : ℕ} (hd : 2 ≤ d) (f₀ : ℝ → ℂ)
    (hf₀ : Continuous f₀) {x : Euclidean (d + 1)} (hx : x ≠ 0) {t : ℝ}
    (ht : t ∈ Icc (1 : ℝ) 2) (htr : 3 * ‖x‖ / 2 ≤ t) :
    ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ENNReal.ofReal (brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
        brsRemainderTwo (absProfile f₀) ‖x‖ := by
  have hD : 3 ≤ d + 1 := by omega
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht.1
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have habs : |‖x‖ - t| = t - ‖x‖ := by
    rw [abs_of_nonpos (by linarith)]
    ring
  have hab : t - ‖x‖ ≤ t + ‖x‖ := by linarith
  have hsum : ‖x‖ + t = t + ‖x‖ := by ring
  have h4rt : 0 < 4 * ‖x‖ * t := by positivity
  have hCpos : 0 < brsAvgConst d := brsAvgConst_pos hd
  have hcont1 : Continuous fun s : ℝ => brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ :=
    (continuous_brsKernel (d + 1) h4rt).mul hf₀.norm
  have hcont2 : Continuous fun s : ℝ =>
      (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12) * ‖x‖⁻¹ * ‖f₀ s‖ :=
    continuous_const.mul hf₀.norm
  have hmono : (∫ s in (t - ‖x‖)..(t + ‖x‖),
        brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖) ≤
      ∫ s in (t - ‖x‖)..(t + ‖x‖),
        (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12) * ‖x‖⁻¹ * ‖f₀ s‖ := by
    refine intervalIntegral.integral_mono_on hab (hcont1.intervalIntegrable _ _)
      (hcont2.intervalIntegrable _ _) ?_
    intro s hs
    exact mul_le_mul_of_nonneg_right
      (brsKernel_le_large (D := d + 1) hD hr htr hs.1 hs.2) (norm_nonneg _)
  have hpull : (∫ s in (t - ‖x‖)..(t + ‖x‖),
        (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12) * ‖x‖⁻¹ * ‖f₀ s‖) =
      (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12) *
        (‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖) := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr ?_
    intro s hs
    simp only []
    ring
  have hRterm : ‖∫ s in (t - ‖x‖)..(t + ‖x‖), absProfile f₀ s‖ =
      ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖ := by
    have h : (fun s : ℝ => absProfile f₀ s) = fun s : ℝ => ((‖f₀ s‖ : ℝ) : ℂ) := rfl
    rw [h]
    exact norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
  have hchain : ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      (brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
        (‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖) := by
    have h1 := norm_sphericalAverage_le_kernel_integral hd f₀ hf₀ hx htpos
    rw [← brsAvgConst, habs, hsum] at h1
    calc ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
        ≤ brsAvgConst d *
            ∫ s in (t - ‖x‖)..(t + ‖x‖), brsKernel (d + 1) t ‖x‖ s * ‖f₀ s‖ := h1
      _ ≤ brsAvgConst d *
            ∫ s in (t - ‖x‖)..(t + ‖x‖),
              (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12) * ‖x‖⁻¹ * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_left hmono hCpos.le
      _ = (brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
            (‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖) := by
          rw [hpull]
          ring
  have hnonneg : (0 : ℝ) ≤ ‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖ := by
    refine mul_nonneg (by positivity) ?_
    exact intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
  calc ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖
      ≤ ENNReal.ofReal ((brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
          (‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖)) :=
        ENNReal.ofReal_le_ofReal hchain
    _ = ENNReal.ofReal (brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
          ENNReal.ofReal (‖x‖⁻¹ * ∫ s in (t - ‖x‖)..(t + ‖x‖), ‖f₀ s‖) := by
        rw [ENNReal.ofReal_mul (by positivity)]
    _ ≤ ENNReal.ofReal (brsAvgConst d * (5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12)) *
          brsRemainderTwo (absProfile f₀) ‖x‖ := by
        refine mul_le_mul' le_rfl ?_
        refine le_iSup₂_of_le t ⟨ht, htr⟩ ?_
        rw [hRterm]

/-- **BRS Lemma 4.1** (Seeger--Wainger--Wright decomposition).  For `d + 1 ≥ 3`
and a continuous profile `f₀`, the spherical maximal function of the radial
function `f(y) = f₀(‖y‖)` is dominated pointwise by the sum of the main term
`𝔐_p`, applied to the substituted profile of `|f₀|`, and the two remainders
`R₁`, `R₂` applied to `|f₀|`. -/
theorem le_brsDecomposition {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (hp : 0 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      ∀ x : Euclidean (d + 1), x ≠ 0 →
        M E (fun y => f₀ ‖y‖) x ≤ ENNReal.ofReal C *
          (brsMainMaximal (d + 1) E p
              (brsProfileSub (d + 1) p (absProfile f₀)) ‖x‖ +
            brsRemainderOne (absProfile f₀) ‖x‖ +
            brsRemainderTwo (absProfile f₀) ‖x‖) := by
  have hCpos : 0 < brsAvgConst d := brsAvgConst_pos hd
  set c1 : ℝ := (5 / 4 : ℝ) ^ (d + 1 - 3) / 2 with hc1
  set c2 : ℝ := 3 * (5 / 4 : ℝ) ^ (d + 1 - 3) / 8 with hc2
  set c3 : ℝ := 5 * (3 / 2 : ℝ) ^ (d + 1 - 3) / 12 with hc3
  have hc1pos : 0 < c1 := by rw [hc1]; positivity
  have hc2pos : 0 < c2 := by rw [hc2]; positivity
  have hc3pos : 0 < c3 := by rw [hc3]; positivity
  refine ⟨brsAvgConst d * (c1 + c2 + c3), by positivity, ?_⟩
  intro f₀ hf₀ x hx
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  set A : ENNReal := brsMainMaximal (d + 1) E p
    (brsProfileSub (d + 1) p (absProfile f₀)) ‖x‖ with hA
  set B : ENNReal := brsRemainderOne (absProfile f₀) ‖x‖ with hB
  set C : ENNReal := brsRemainderTwo (absProfile f₀) ‖x‖ with hC
  have hmono1 : ENNReal.ofReal (brsAvgConst d * c1) * A ≤
      ENNReal.ofReal (brsAvgConst d * (c1 + c2 + c3)) * (A + B + C) := by
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) ?_
    · have : c1 ≤ c1 + c2 + c3 := by linarith
      exact mul_le_mul_of_nonneg_left this hCpos.le
    · exact le_trans (le_add_right le_rfl) (le_add_right le_rfl)
  have hmono2 : ENNReal.ofReal (brsAvgConst d * c2) * B ≤
      ENNReal.ofReal (brsAvgConst d * (c1 + c2 + c3)) * (A + B + C) := by
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) ?_
    · have : c2 ≤ c1 + c2 + c3 := by linarith
      exact mul_le_mul_of_nonneg_left this hCpos.le
    · exact le_trans (le_add_left le_rfl) (le_add_right le_rfl)
  have hmono3 : ENNReal.ofReal (brsAvgConst d * c3) * C ≤
      ENNReal.ofReal (brsAvgConst d * (c1 + c2 + c3)) * (A + B + C) := by
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) ?_
    · have : c3 ≤ c1 + c2 + c3 := by linarith
      exact mul_le_mul_of_nonneg_left this hCpos.le
    · exact le_add_left le_rfl
  unfold M _root_.Spherical.restrictedSphericalMaximal
  refine iSup₂_le fun t ht => ?_
  have htE : t ∈ E := ht.1
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  by_cases hsmall : t ≤ ‖x‖ / 2
  · refine le_trans ?_ hmono2
    rw [hB, hc2]
    exact le_brsRemainderOne_of_le hd f₀ hf₀ hx htIcc hsmall
  · push Not at hsmall
    by_cases hlarge : 3 * ‖x‖ / 2 ≤ t
    · refine le_trans ?_ hmono3
      rw [hC, hc3]
      exact le_brsRemainderTwo_of_le hd f₀ hf₀ hx htIcc hlarge
    · push Not at hlarge
      refine le_trans ?_ hmono1
      rw [hA, hc1]
      exact le_brsMainMaximal_of_mem hd hp f₀ hf₀ hx htE hsmall hlarge

/-- Enlarging the interval of integration of a nonnegative continuous
integrand. -/
theorem intervalIntegral_mono_subinterval {h : ℝ → ℝ} (hh : Continuous h)
    (hnn : ∀ s, 0 ≤ h s) {a b u v : ℝ} (hau : a ≤ u) (huv : u ≤ v) (hvb : v ≤ b) :
    (∫ s in u..v, h s) ≤ ∫ s in a..b, h s := by
  have hint : ∀ c e : ℝ, IntervalIntegrable h volume c e := fun c e =>
    hh.intervalIntegrable c e
  have hsplit1 : (∫ s in a..u, h s) + (∫ s in u..b, h s) = ∫ s in a..b, h s :=
    intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
  have hsplit2 : (∫ s in u..v, h s) + (∫ s in v..b, h s) = ∫ s in u..b, h s :=
    intervalIntegral.integral_add_adjacent_intervals (hint _ _) (hint _ _)
  have hpos1 : 0 ≤ ∫ s in a..u, h s :=
    intervalIntegral.integral_nonneg hau fun s _ => hnn s
  have hpos2 : 0 ≤ ∫ s in v..b, h s :=
    intervalIntegral.integral_nonneg hvb fun s _ => hnn s
  linarith [hsplit1, hsplit2]

/-- **The elementary bound for `R₁`.**  Since `1 ≤ t ≤ r/2`, the interval of
integration lies in the window `[r/2, 3r/2]` and the factor `t⁻¹` is at most
one, so `R₁` is dominated by the window average of `|f₀|`. -/
theorem brsRemainderOne_le_window {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderOne (absProfile f₀) r ≤
      ENNReal.ofReal (∫ s in (r / 2)..(3 * r / 2), ‖f₀ s‖) := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have htr' : t ≤ r / 2 := htr
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hr : 0 < r := by
    have h2 : (1 : ℝ) ≤ r / 2 := le_trans ht1 htr'
    linarith
  have hab : r - t ≤ r + t := by linarith
  have hRterm : ‖∫ s in (r - t)..(r + t), absProfile f₀ s‖ =
      ∫ s in (r - t)..(r + t), ‖f₀ s‖ := by
    have h : (fun s : ℝ => absProfile f₀ s) = fun s : ℝ => ((‖f₀ s‖ : ℝ) : ℂ) := rfl
    rw [h]
    exact norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
  have hwindow : (∫ s in (r - t)..(r + t), ‖f₀ s‖) ≤
      ∫ s in (r / 2)..(3 * r / 2), ‖f₀ s‖ := by
    refine intervalIntegral_mono_subinterval hf₀.norm (fun s => norm_nonneg _)
      (by linarith) hab (by linarith)
  have hinv : t⁻¹ ≤ 1 := by
    rw [inv_le_one_iff₀]
    exact Or.inr ht1
  refine ENNReal.ofReal_le_ofReal ?_
  rw [hRterm]
  calc t⁻¹ * ∫ s in (r - t)..(r + t), ‖f₀ s‖
      ≤ 1 * ∫ s in (r - t)..(r + t), ‖f₀ s‖ := by
        refine mul_le_mul_of_nonneg_right hinv ?_
        exact intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
    _ = ∫ s in (r - t)..(r + t), ‖f₀ s‖ := one_mul _
    _ ≤ ∫ s in (r / 2)..(3 * r / 2), ‖f₀ s‖ := hwindow

/-- `R₁` vanishes below the radius `2`, where no admissible dilation exists. -/
theorem brsRemainderOne_eq_zero_of_lt {f₀ : ℝ → ℂ} {r : ℝ} (hr : r < 2) :
    brsRemainderOne (absProfile f₀) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  have ht1 : (1 : ℝ) ≤ t := ht.1.1
  have htr : t ≤ r / 2 := ht.2
  linarith

theorem continuous_brsProfileSub {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 0 < p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) : Continuous (brsProfileSub d p f₀) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp : (0 : ℝ) ≤ ((d : ℝ) - 1) / p := by
    apply div_nonneg <;> linarith
  exact (Complex.continuous_ofReal.comp
    (continuous_rpow_const_of_nonneg hexp)).mul hf₀

theorem norm_brsProfileSub {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 0 < p) (f₀ : ℝ → ℂ)
    {s : ℝ} (hs : 0 ≤ s) :
    ‖brsProfileSub d p f₀ s‖ = s ^ (((d : ℝ) - 1) / p) * ‖f₀ s‖ := by
  rw [brsProfileSub, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg (Real.rpow_nonneg hs _)]

/-- The modulus of the profile, recovered from the substituted profile. -/
theorem norm_eq_of_brsProfileSub {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 0 < p)
    (f₀ : ℝ → ℂ) {s : ℝ} (hs : 0 < s) :
    ‖f₀ s‖ = s ^ (-(((d : ℝ) - 1) / p)) * ‖brsProfileSub d p f₀ s‖ := by
  rw [norm_brsProfileSub hd hp f₀ hs.le, ← mul_assoc, ← Real.rpow_add hs]
  simp

/-- **Step A of BRS Proposition 4.2.**  After the substitution
`g = f₀ s^{(d-1)/p}`, the remainder `R₁` is dominated by the unit-window
average of `|g|` times `(2/r)^{(d-1)/p}`. -/
theorem brsRemainderOne_le_substituted {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 ≤ p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderOne (absProfile f₀) r ≤
      ENNReal.ofReal ((2 / r) ^ (((d : ℝ) - 1) / p) *
        ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp : (0 : ℝ) ≤ ((d : ℝ) - 1) / p := by
    apply div_nonneg <;> linarith
  have hgcont : Continuous (brsProfileSub d p f₀) :=
    continuous_brsProfileSub hd hp0 hf₀
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have htr' : t ≤ r / 2 := htr
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hr2 : (2 : ℝ) ≤ r := by linarith
  have hrpos : 0 < r := by linarith
  have hhalf : 0 < r / 2 := by linarith
  have hab : r - t ≤ r + t := by linarith
  -- rewrite the norm of the integral
  have hRterm : ‖∫ s in (r - t)..(r + t), absProfile f₀ s‖ =
      ∫ s in (r - t)..(r + t), ‖f₀ s‖ := by
    have h : (fun s : ℝ => absProfile f₀ s) = fun s : ℝ => ((‖f₀ s‖ : ℝ) : ℂ) := rfl
    rw [h]
    exact norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
  -- the pointwise substitution bound on the range of integration
  have hpoint : ∀ s ∈ Icc (r - t) (r + t),
      ‖f₀ s‖ ≤ (2 / r) ^ (((d : ℝ) - 1) / p) * ‖brsProfileSub d p f₀ s‖ := by
    intro s hs
    have hslow : r / 2 ≤ s := by
      have := hs.1
      linarith
    have hspos : 0 < s := lt_of_lt_of_le hhalf hslow
    have hmono : s ^ (-(((d : ℝ) - 1) / p)) ≤ (r / 2) ^ (-(((d : ℝ) - 1) / p)) :=
      Real.rpow_le_rpow_of_nonpos hhalf hslow (by linarith)
    have hinv : (r / 2) ^ (-(((d : ℝ) - 1) / p)) = (2 / r) ^ (((d : ℝ) - 1) / p) := by
      rw [Real.rpow_neg hhalf.le, show (2 / r : ℝ) = (r / 2)⁻¹ by rw [inv_div],
        Real.inv_rpow hhalf.le]
    rw [norm_eq_of_brsProfileSub hd hp0 f₀ hspos, ← hinv]
    exact mul_le_mul_of_nonneg_right hmono (norm_nonneg _)
  have hint1 : (∫ s in (r - t)..(r + t), ‖f₀ s‖) ≤
      ∫ s in (r - t)..(r + t),
        (2 / r) ^ (((d : ℝ) - 1) / p) * ‖brsProfileSub d p f₀ s‖ :=
    intervalIntegral.integral_mono_on hab (hf₀.norm.intervalIntegrable _ _)
      ((continuous_const.mul hgcont.norm).intervalIntegrable _ _) hpoint
  have hint2 : (∫ s in (r - t)..(r + t),
        (2 / r) ^ (((d : ℝ) - 1) / p) * ‖brsProfileSub d p f₀ s‖) =
      (2 / r) ^ (((d : ℝ) - 1) / p) *
        ∫ s in (r - t)..(r + t), ‖brsProfileSub d p f₀ s‖ :=
    intervalIntegral.integral_const_mul _ _
  have hint3 : (∫ s in (r - t)..(r + t), ‖brsProfileSub d p f₀ s‖) ≤
      ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ :=
    intervalIntegral_mono_subinterval hgcont.norm (fun s => norm_nonneg _)
      (by linarith) hab (by linarith)
  have hinvle : t⁻¹ ≤ 1 := by
    rw [inv_le_one_iff₀]
    exact Or.inr ht1
  have hcoefnn : (0 : ℝ) ≤ (2 / r) ^ (((d : ℝ) - 1) / p) :=
    Real.rpow_nonneg (by positivity) _
  refine ENNReal.ofReal_le_ofReal ?_
  rw [hRterm]
  calc t⁻¹ * ∫ s in (r - t)..(r + t), ‖f₀ s‖
      ≤ 1 * ∫ s in (r - t)..(r + t), ‖f₀ s‖ := by
        refine mul_le_mul_of_nonneg_right hinvle ?_
        exact intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
    _ = ∫ s in (r - t)..(r + t), ‖f₀ s‖ := one_mul _
    _ ≤ (2 / r) ^ (((d : ℝ) - 1) / p) *
          ∫ s in (r - t)..(r + t), ‖brsProfileSub d p f₀ s‖ := by
        rw [← hint2]
        exact hint1
    _ ≤ (2 / r) ^ (((d : ℝ) - 1) / p) *
          ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ :=
        mul_le_mul_of_nonneg_left hint3 hcoefnn

/-- The `L^p(s^{d-1} ds)` quasi-norm of a profile.  The weight
`ENNReal.ofReal s ^ (d-1)` vanishes for `s ≤ 0`, so this is the norm over
`(0, ∞)` used throughout BRS §4. -/
def profileLpNorm (d : ℕ) (p : ℝ) (h : ℝ → ENNReal) : ENNReal :=
  (∫⁻ s, ENNReal.ofReal s ^ (d - 1) * h s ^ p) ^ (1 / p)

/-- The substitution identity in `ℝ≥0∞` form: the `p`-th power of the
substituted profile carries the weight `s^{d-1}`. -/
theorem enorm_brsProfileSub_rpow {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 0 < p)
    (f₀ : ℝ → ℂ) {s : ℝ} (hs : 0 ≤ s) :
    (ENNReal.ofReal ‖brsProfileSub d p f₀ s‖) ^ p =
      ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp : (0 : ℝ) < ((d : ℝ) - 1) / p := by
    apply div_pos <;> linarith
  have hweight : (ENNReal.ofReal (s ^ (((d : ℝ) - 1) / p))) ^ p =
      ENNReal.ofReal s ^ (d - 1) := by
    rcases eq_or_lt_of_le hs with h | h
    · rw [← h, Real.zero_rpow hexp.ne', ENNReal.ofReal_zero,
        ENNReal.zero_rpow_of_pos hp, zero_pow (by omega : d - 1 ≠ 0)]
    · have hconv : (s : ℝ) ^ ((d : ℝ) - 1) = s ^ (d - 1) := by
        have hc := pow_sub_eq_rpow h (D := d) (k := 1) (by omega)
        simpa using hc.symm
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hs _) hp.le,
        ← Real.rpow_mul hs,
        show ((d : ℝ) - 1) / p * p = (d : ℝ) - 1 by field_simp,
        hconv, ENNReal.ofReal_pow hs]
  rw [norm_brsProfileSub hd hp f₀ hs,
    ENNReal.ofReal_mul (Real.rpow_nonneg hs _),
    ENNReal.mul_rpow_of_nonneg _ _ hp.le, hweight]

/-- **The `q = ∞` endpoint of BRS Proposition 4.2.**  The remainder `R₁` is
bounded pointwise by the `L^p(s^{d-1} ds)` norm of the profile. -/
theorem brsRemainderOne_le_profileLpNorm {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 ≤ p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderOne (absProfile f₀) r ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) *
        profileLpNorm d p (fun s => ENNReal.ofReal ‖f₀ s‖) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have ha : (0 : ℝ) ≤ ((d : ℝ) - 1) / p := by
    apply div_nonneg <;> linarith
  by_cases hr2 : r < 2
  · rw [brsRemainderOne_eq_zero_of_lt hr2]
    simp
  push Not at hr2
  have hrpos : 0 < r := by linarith
  have hab : r - 2 ≤ r + 2 := by linarith
  have hgcont : Continuous (brsProfileSub d p f₀) :=
    continuous_brsProfileSub hd hp0 hf₀
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal ‖brsProfileSub d p f₀ s‖ with hΦ
  have hΦmeas : Measurable Φ := by
    rw [hΦ]
    exact hgcont.norm.measurable.ennreal_ofReal
  -- Step A, with the harmless factor `(2/r)^{(d-1)/p} ≤ 1`
  have hcoef : (2 / r) ^ (((d : ℝ) - 1) / p) ≤ 1 := by
    refine Real.rpow_le_one (by positivity) ?_ ha
    rw [div_le_one hrpos]
    exact hr2
  have hstepA : brsRemainderOne (absProfile f₀) r ≤
      ENNReal.ofReal (∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖) := by
    refine le_trans (brsRemainderOne_le_substituted hd hp hf₀ r)
      (ENNReal.ofReal_le_ofReal ?_)
    have hInn : (0 : ℝ) ≤ ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ :=
      intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
    calc (2 / r) ^ (((d : ℝ) - 1) / p) *
          ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖
        ≤ 1 * ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ :=
          mul_le_mul_of_nonneg_right hcoef hInn
      _ = ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ := one_mul _
  -- rewrite the window integral as a lintegral
  have hconv : ENNReal.ofReal (∫ s in (r - 2)..(r + 2),
      ‖brsProfileSub d p f₀ s‖) = ∫⁻ s in Icc (r - 2) (r + 2), Φ s := by
    rw [intervalIntegral.integral_of_le hab,
      ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    refine ofReal_integral_eq_lintegral_ofReal ?_ ?_
    · exact (hgcont.norm.continuousOn).integrableOn_Icc
    · exact ae_of_all _ fun s => norm_nonneg _
  -- Hölder on the window
  have hWvol : volume (Icc (r - 2) (r + 2)) = ENNReal.ofReal 4 := by
    rw [Real.volume_Icc]
    congr 1
    ring
  have hholder : (∫⁻ s in Icc (r - 2) (r + 2), Φ s) ≤
      (∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) ^ (1 / p) *
        ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) := by
    rcases eq_or_lt_of_le hp with hp1 | hp1
    · rw [← hp1]
      simp
    · have hpq := Real.HolderConjugate.conjExponent hp1
      have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
        (volume.restrict (Icc (r - 2) (r + 2))) hpq
        hΦmeas.aemeasurable (aemeasurable_const (b := (1 : ENNReal)))
      simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow] at hkey
      refine le_trans hkey ?_
      have hone : (∫⁻ _s in Icc (r - 2) (r + 2), (1 : ENNReal)) =
          ENNReal.ofReal 4 := by
        rw [setLIntegral_one, hWvol]
      rw [hone]
      refine mul_le_mul' le_rfl ?_
      have hconj : 1 / Real.conjExponent p = 1 - 1 / p := by
        rw [Real.conjExponent]
        have hpne : p ≠ 0 := hp0.ne'
        have hp1ne : p - 1 ≠ 0 := by
          intro hcon
          rw [sub_eq_zero] at hcon
          exact absurd hcon.symm hp1.ne
        field_simp
      rw [hconj, ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by
        have : 1 / p ≤ 1 := by
          rw [div_le_one hp0]
          exact hp
        linarith)]
  -- pass from the window to the whole line
  have hpow : (∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) ≤
      ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
    calc (∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p)
        = ∫⁻ s in Icc (r - 2) (r + 2),
            ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
          refine setLIntegral_congr_fun measurableSet_Icc ?_
          intro s hs
          have hs0 : 0 ≤ s := by
            have := hs.1
            linarith
          rw [hΦ]
          exact enorm_brsProfileSub_rpow hd hp0 f₀ hs0
      _ ≤ ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p :=
          setLIntegral_le_lintegral _ _
  calc brsRemainderOne (absProfile f₀) r
      ≤ ∫⁻ s in Icc (r - 2) (r + 2), Φ s := by rw [← hconv]; exact hstepA
    _ ≤ (∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) ^ (1 / p) *
          ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) := hholder
    _ ≤ (∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) *
          ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) := by
        refine mul_le_mul' (ENNReal.rpow_le_rpow hpow (by positivity)) le_rfl
    _ = ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) *
          profileLpNorm d p (fun s => ENNReal.ofReal ‖f₀ s‖) := by
        rw [profileLpNorm, mul_comm]

/-- Hölder's inequality against the constant function: on a measure space the
integral is bounded by the `L^p` norm times a power of the total mass. -/
theorem lintegral_le_rpow_mul_measure_univ {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {Φ : α → ENNReal} (hΦ : Measurable Φ) {p : ℝ} (hp : 1 ≤ p) :
    (∫⁻ s, Φ s ∂μ) ≤ (∫⁻ s, Φ s ^ p ∂μ) ^ (1 / p) * (μ univ) ^ (1 - 1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  rcases eq_or_lt_of_le hp with hp1 | hp1
  · rw [← hp1]
    simp
  · have hpq := Real.HolderConjugate.conjExponent hp1
    have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hpq hΦ.aemeasurable
      (aemeasurable_const (b := (1 : ENNReal)))
    simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow] at hkey
    refine le_trans hkey ?_
    rw [lintegral_one]
    refine mul_le_mul' le_rfl ?_
    have hconj : 1 / Real.conjExponent p = 1 - 1 / p := by
      rw [Real.conjExponent]
      have hpne : p ≠ 0 := hp0.ne'
      have hp1ne : p - 1 ≠ 0 := by
        intro hcon
        rw [sub_eq_zero] at hcon
        exact absurd hcon.symm hp1.ne
      field_simp
    rw [hconj]

/-- The weighted `p`-th power of `R₁` at radius `r` is controlled by the
`L^p` mass of the substituted profile on the window `[r-2, r+2]`; the weight
`r^{d-1}` is cancelled exactly by the factor `(2/r)^{d-1}` of the substitution
bound. -/
theorem weighted_brsRemainderOne_pow_le {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 ≤ p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    ENNReal.ofReal r ^ (d - 1) * brsRemainderOne (absProfile f₀) r ^ p ≤
      ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
        ∫⁻ s in Icc (r - 2) (r + 2) ∩ Ici (0 : ℝ),
          (ENNReal.ofReal ‖brsProfileSub d p f₀ s‖) ^ p := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have ha : (0 : ℝ) ≤ ((d : ℝ) - 1) / p := by
    apply div_nonneg <;> linarith
  by_cases hr2 : r < 2
  · rw [brsRemainderOne_eq_zero_of_lt hr2, ENNReal.zero_rpow_of_pos hp0, mul_zero]
    simp
  push Not at hr2
  have hrpos : 0 < r := by linarith
  have hab : r - 2 ≤ r + 2 := by linarith
  have hsubset : Icc (r - 2) (r + 2) ⊆ Ici (0 : ℝ) := by
    intro s hs
    have := hs.1
    simp only [mem_Ici]
    linarith
  have hset : Icc (r - 2) (r + 2) ∩ Ici (0 : ℝ) = Icc (r - 2) (r + 2) :=
    inter_eq_self_of_subset_left hsubset
  rw [hset]
  have hgcont : Continuous (brsProfileSub d p f₀) :=
    continuous_brsProfileSub hd hp0 hf₀
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal ‖brsProfileSub d p f₀ s‖ with hΦ
  have hΦmeas : Measurable Φ := by
    rw [hΦ]
    exact hgcont.norm.measurable.ennreal_ofReal
  set W : ℝ := ∫ s in (r - 2)..(r + 2), ‖brsProfileSub d p f₀ s‖ with hW
  have hWnn : 0 ≤ W := by
    rw [hW]
    exact intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
  have hconv : ENNReal.ofReal W = ∫⁻ s in Icc (r - 2) (r + 2), Φ s := by
    rw [hW, intervalIntegral.integral_of_le hab,
      ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    refine ofReal_integral_eq_lintegral_ofReal ?_ ?_
    · exact (hgcont.norm.continuousOn).integrableOn_Icc
    · exact ae_of_all _ fun s => norm_nonneg _
  -- the weight cancellation
  have hpowconv : ((2 : ℝ) / r) ^ (((d : ℝ) - 1) / p * p) = ((2 : ℝ) / r) ^ (d - 1) := by
    rw [show ((d : ℝ) - 1) / p * p = (d : ℝ) - 1 by field_simp]
    have hc := pow_sub_eq_rpow (x := (2 : ℝ) / r) (by positivity) (D := d) (k := 1)
      (by omega)
    simpa using hc.symm
  have hweight : ENNReal.ofReal r ^ (d - 1) *
      ENNReal.ofReal (((2 : ℝ) / r) ^ (d - 1)) =
        ENNReal.ofReal ((2 : ℝ) ^ (d - 1)) := by
    rw [← ENNReal.ofReal_pow hrpos.le, ← ENNReal.ofReal_mul (by positivity),
      ← mul_pow]
    congr 2
    field_simp
  -- the Hölder step
  have hholder : ENNReal.ofReal (W ^ p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (p - 1)) *
        ∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p := by
    have hWvol : (volume.restrict (Icc (r - 2) (r + 2))) univ = ENNReal.ofReal 4 := by
      rw [Measure.restrict_apply_univ, Real.volume_Icc]
      congr 1
      ring
    have h1 := lintegral_le_rpow_mul_measure_univ (μ := volume.restrict
      (Icc (r - 2) (r + 2))) hΦmeas hp
    rw [hWvol] at h1
    have h2 : (ENNReal.ofReal W) ^ p ≤
        ((∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) ^ (1 / p) *
          ENNReal.ofReal 4 ^ (1 - 1 / p)) ^ p := by
      rw [hconv]
      exact ENNReal.rpow_le_rpow h1 hp0.le
    have hexp1 : (0 : ℝ) ≤ 1 - 1 / p := by
      have h1p : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp
      linarith
    have hexp2 : (0 : ℝ) ≤ (1 - p⁻¹) * p := by
      have h1p : p⁻¹ ≤ 1 := by
        rw [inv_le_one_iff₀]
        exact Or.inr hp
      have : (0 : ℝ) ≤ 1 - p⁻¹ := by linarith
      positivity
    have h3 : ((∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) ^ (1 / p) *
          ENNReal.ofReal 4 ^ (1 - 1 / p)) ^ p =
        ENNReal.ofReal ((4 : ℝ) ^ (p - 1)) *
          ∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
        ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one,
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) hexp2,
        show (1 - p⁻¹) * p = p - 1 by field_simp]
      ring
    rw [← ENNReal.ofReal_rpow_of_nonneg hWnn hp0.le]
    exact le_trans h2 (le_of_eq h3)
  -- assemble
  have hstepA : brsRemainderOne (absProfile f₀) r ≤
      ENNReal.ofReal (((2 : ℝ) / r) ^ (((d : ℝ) - 1) / p) * W) := by
    rw [hW]
    exact brsRemainderOne_le_substituted hd hp hf₀ r
  calc ENNReal.ofReal r ^ (d - 1) * brsRemainderOne (absProfile f₀) r ^ p
      ≤ ENNReal.ofReal r ^ (d - 1) *
          (ENNReal.ofReal (((2 : ℝ) / r) ^ (((d : ℝ) - 1) / p) * W)) ^ p :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hstepA hp0.le)
    _ = ENNReal.ofReal r ^ (d - 1) *
          (ENNReal.ofReal (((2 : ℝ) / r) ^ (d - 1)) * ENNReal.ofReal (W ^ p)) := by
        congr 1
        rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hp0.le,
          Real.mul_rpow (Real.rpow_nonneg (by positivity) _) hWnn,
          ← Real.rpow_mul (by positivity), hpowconv,
          ENNReal.ofReal_mul (by positivity)]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1)) * ENNReal.ofReal (W ^ p) := by
        rw [← mul_assoc, hweight]
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal ((4 : ℝ) ^ (p - 1)) *
            ∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p) :=
        mul_le_mul' le_rfl hholder
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
          ∫⁻ s in Icc (r - 2) (r + 2), Φ s ^ p := by
        rw [ENNReal.ofReal_mul (by positivity), mul_assoc]

/-- Translating the window: the integral over `[r-2, r+2]` is the integral of
the translate over `[-2, 2]`. -/
theorem lintegral_window_translate {Ψ : ℝ → ENNReal} (hΨ : Measurable Ψ) (r : ℝ) :
    (∫⁻ s in Icc (r - 2) (r + 2), Ψ s) = ∫⁻ u in Icc (-2 : ℝ) 2, Ψ (u + r) := by
  rw [← lintegral_indicator measurableSet_Icc, ← lintegral_indicator measurableSet_Icc,
    ← lintegral_add_right_eq_self
      (fun s => (Icc (r - 2) (r + 2)).indicator Ψ s) r]
  refine lintegral_congr fun u => ?_
  by_cases hu : u ∈ Icc (-2 : ℝ) 2
  · have hmem : u + r ∈ Icc (r - 2) (r + 2) := by
      constructor <;> [linarith [hu.1]; linarith [hu.2]]
    rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hu]
  · have hnmem : u + r ∉ Icc (r - 2) (r + 2) := by
      intro hcon
      exact hu ⟨by linarith [hcon.1], by linarith [hcon.2]⟩
    rw [Set.indicator_of_notMem hnmem, Set.indicator_of_notMem hu]

/-- **Tonelli for the unit window.**  Integrating the window mass over all
radii multiplies the total mass by the window length. -/
theorem lintegral_window_swap {Ψ : ℝ → ENNReal} (hΨ : Measurable Ψ) :
    (∫⁻ r : ℝ, ∫⁻ s in Icc (r - 2) (r + 2), Ψ s) =
      ENNReal.ofReal 4 * ∫⁻ s, Ψ s := by
  have htrans : (∫⁻ r : ℝ, ∫⁻ s in Icc (r - 2) (r + 2), Ψ s) =
      ∫⁻ r : ℝ, ∫⁻ u in Icc (-2 : ℝ) 2, Ψ (u + r) :=
    lintegral_congr fun r => lintegral_window_translate hΨ r
  have hswap : (∫⁻ r : ℝ, ∫⁻ u in Icc (-2 : ℝ) 2, Ψ (u + r)) =
      ∫⁻ u in Icc (-2 : ℝ) 2, ∫⁻ r : ℝ, Ψ (u + r) := by
    refine lintegral_lintegral_swap ?_
    exact (hΨ.comp (measurable_snd.add measurable_fst)).aemeasurable
  have hinner : ∀ u : ℝ, (∫⁻ r : ℝ, Ψ (u + r)) = ∫⁻ r, Ψ r := fun u =>
    lintegral_add_left_eq_self Ψ u
  rw [htrans, hswap, lintegral_congr hinner, setLIntegral_const, Real.volume_Icc]
  rw [show (2 : ℝ) - -2 = 4 by ring]
  rw [mul_comm]

theorem setLIntegral_inter_eq_indicator {A B : Set ℝ} (hB : MeasurableSet B)
    (f : ℝ → ENNReal) :
    (∫⁻ s in A ∩ B, f s) = ∫⁻ s in A, B.indicator f s := by
  rw [lintegral_indicator hB, Measure.restrict_restrict hB, inter_comm]

/-- **The diagonal case `p = q` of BRS Proposition 4.2.** -/
theorem profileLpNorm_brsRemainderOne_le {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 ≤ p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderOne (absProfile f₀) r ^ p) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) *
        ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hgcont : Continuous (brsProfileSub d p f₀) :=
    continuous_brsProfileSub hd hp0 hf₀
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal ‖brsProfileSub d p f₀ s‖ with hΦ
  have hΦmeas : Measurable Φ := by
    rw [hΦ]
    exact hgcont.norm.measurable.ennreal_ofReal
  set Ψ : ℝ → ENNReal := (Ici (0 : ℝ)).indicator (fun s => Φ s ^ p) with hΨdef
  have hΨmeas : Measurable Ψ := by
    rw [hΨdef]
    exact (hΦmeas.pow_const p).indicator measurableSet_Ici
  -- the pointwise bound, rewritten with the indicator
  have hpoint : ∀ r : ℝ, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderOne (absProfile f₀) r ^ p ≤
        ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
          ∫⁻ s in Icc (r - 2) (r + 2), Ψ s := by
    intro r
    refine le_trans (weighted_brsRemainderOne_pow_le hd hp hf₀ r) ?_
    rw [hΨdef, ← setLIntegral_inter_eq_indicator measurableSet_Ici]
  -- integrate and swap
  have hswap := lintegral_window_swap hΨmeas
  have hΨint : (∫⁻ s, Ψ s) =
      ∫⁻ s in Ici (0 : ℝ), ENNReal.ofReal s ^ (d - 1) *
        (ENNReal.ofReal ‖f₀ s‖) ^ p := by
    rw [hΨdef, lintegral_indicator measurableSet_Ici]
    refine setLIntegral_congr_fun measurableSet_Ici ?_
    intro s hs
    rw [hΦ]
    exact enorm_brsProfileSub_rpow hd hp0 f₀ hs
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderOne (absProfile f₀) r ^ p)
      ≤ ∫⁻ r, ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
          ∫⁻ s in Icc (r - 2) (r + 2), Ψ s := lintegral_mono hpoint
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
          ∫⁻ r, ∫⁻ s in Icc (r - 2) (r + 2), Ψ s := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1)) *
          (ENNReal.ofReal 4 * ∫⁻ s, Ψ s) := by rw [hswap]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * ∫⁻ s, Ψ s := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        rw [show (2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ (p - 1) * 4 =
          (2 : ℝ) ^ (d - 1) * ((4 : ℝ) ^ (p - 1) * 4) by ring]
        congr 1
        rw [show (4 : ℝ) ^ p = (4 : ℝ) ^ (p - 1 + 1) by ring_nf,
          Real.rpow_add (by norm_num), Real.rpow_one]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) *
          ∫⁻ s in Ici (0 : ℝ), ENNReal.ofReal s ^ (d - 1) *
            (ENNReal.ofReal ‖f₀ s‖) ^ p := by rw [hΨint]
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) *
          ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
        exact mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)

/-- **BRS Proposition 4.2.**  For `1 ≤ p ≤ q < ∞` the remainder `R₁` maps
`L^p(s^{d-1} ds)` to `L^q(r^{d-1} dr)`.  The proof interpolates between the
diagonal bound and the `q = ∞` endpoint. -/
theorem prop42_brsRemainderOne {d : ℕ} (hd : 2 ≤ d) {p q : ℝ} (hp : 1 ≤ p)
    (hpq : p ≤ q) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderOne (absProfile f₀) r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (((4 : ℝ) ^ ((1 - 1 / p) * (q - p)) *
          ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p)) ^ (1 / q)) *
        (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
          (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : 0 < q := lt_of_lt_of_le hp0 hpq
  have hqp : (0 : ℝ) ≤ q - p := by linarith
  have hexp1 : (0 : ℝ) ≤ 1 - 1 / p := by
    have h1p : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp
    linarith
  have hCpos : (0 : ℝ) < ((4 : ℝ) ^ ((1 - 1 / p) * (q - p)) *
      ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p)) ^ (1 / q) := by
    have h1 : (0 : ℝ) < (4 : ℝ) ^ ((1 - 1 / p) * (q - p)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < (4 : ℝ) ^ p := Real.rpow_pos_of_pos (by norm_num) _
    have h3 : (0 : ℝ) < (2 : ℝ) ^ (d - 1) := by positivity
    exact Real.rpow_pos_of_pos (by positivity) _
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0:ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact hCpos)]
    exact le_top
  set N : ENNReal := ENNReal.ofReal ((4 : ℝ) ^ (1 - 1 / p)) * X ^ (1 / p) with hN
  have hNtop : N ≠ ⊤ := by
    rw [hN]
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hXtop
  have hNpow : N ^ (q - p) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg hqp hNtop
  -- the `q = ∞` endpoint gives a uniform pointwise bound
  have hsup : ∀ r : ℝ, brsRemainderOne (absProfile f₀) r ≤ N := by
    intro r
    have h := brsRemainderOne_le_profileLpNorm hd hp hf₀ r
    rw [profileLpNorm, ← hX, ← hN] at h
    exact h
  -- interpolation, pointwise
  have hstep : ∀ r : ℝ, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderOne (absProfile f₀) r ^ q ≤
        N ^ (q - p) *
          (ENNReal.ofReal r ^ (d - 1) * brsRemainderOne (absProfile f₀) r ^ p) := by
    intro r
    have hsplit : brsRemainderOne (absProfile f₀) r ^ q =
        brsRemainderOne (absProfile f₀) r ^ (q - p) *
          brsRemainderOne (absProfile f₀) r ^ p := by
      rw [← ENNReal.rpow_add_of_nonneg _ _ hqp hp0.le]
      congr 1
      ring
    rw [hsplit]
    calc ENNReal.ofReal r ^ (d - 1) *
          (brsRemainderOne (absProfile f₀) r ^ (q - p) *
            brsRemainderOne (absProfile f₀) r ^ p)
        ≤ ENNReal.ofReal r ^ (d - 1) *
            (N ^ (q - p) * brsRemainderOne (absProfile f₀) r ^ p) := by
          refine mul_le_mul' le_rfl (mul_le_mul' ?_ le_rfl)
          exact ENNReal.rpow_le_rpow (hsup r) hqp
      _ = N ^ (q - p) *
            (ENNReal.ofReal r ^ (d - 1) * brsRemainderOne (absProfile f₀) r ^ p) := by
          ring
  -- integrate
  have hint : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderOne (absProfile f₀) r ^ q) ≤
        N ^ (q - p) * (ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * X) := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsRemainderOne (absProfile f₀) r ^ q)
        ≤ ∫⁻ r, N ^ (q - p) *
            (ENNReal.ofReal r ^ (d - 1) *
              brsRemainderOne (absProfile f₀) r ^ p) := lintegral_mono hstep
      _ = N ^ (q - p) * ∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
            brsRemainderOne (absProfile f₀) r ^ p :=
          lintegral_const_mul' _ _ hNpow
      _ ≤ N ^ (q - p) * (ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * X) := by
          refine mul_le_mul' le_rfl ?_
          rw [hX]
          exact profileLpNorm_brsRemainderOne_le hd hp hf₀
  -- take the `q`-th root and collect the powers of `X`
  have hpowN : N ^ (q - p) = ENNReal.ofReal ((4 : ℝ) ^ ((1 - 1 / p) * (q - p))) *
      X ^ ((q - p) / p) := by
    rw [hN, ENNReal.mul_rpow_of_nonneg _ _ hqp]
    congr 1
    · rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (by norm_num) _) hqp,
        ← Real.rpow_mul (by norm_num)]
    · rw [← ENNReal.rpow_mul]
      congr 1
      field_simp
  have hXcomb : X ^ ((q - p) / p) * X = X ^ (q / p) := by
    have h1 : X ^ ((q - p) / p + 1) = X ^ ((q - p) / p) * X ^ (1 : ℝ) :=
      ENNReal.rpow_add_of_nonneg _ _ (by positivity) (by norm_num)
    rw [ENNReal.rpow_one] at h1
    rw [← h1]
    congr 1
    field_simp
    ring
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderOne (absProfile f₀) r ^ q) ^ (1 / q)
      ≤ (N ^ (q - p) *
          (ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * X)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = (ENNReal.ofReal ((4 : ℝ) ^ ((1 - 1 / p) * (q - p))) * X ^ ((q - p) / p) *
          (ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * X)) ^ (1 / q) := by
        rw [hpowN]
    _ = ENNReal.ofReal (((4 : ℝ) ^ ((1 - 1 / p) * (q - p)) *
          ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p)) ^ (1 / q)) *
          (X ^ ((q - p) / p) * X) ^ (1 / q) := by
        rw [show ENNReal.ofReal ((4 : ℝ) ^ ((1 - 1 / p) * (q - p))) *
            X ^ ((q - p) / p) *
            (ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p) * X) =
            (ENNReal.ofReal ((4 : ℝ) ^ ((1 - 1 / p) * (q - p))) *
              ENNReal.ofReal ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p)) *
              (X ^ ((q - p) / p) * X) by ring,
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
          ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _),
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    _ = ENNReal.ofReal (((4 : ℝ) ^ ((1 - 1 / p) * (q - p)) *
          ((2 : ℝ) ^ (d - 1) * (4 : ℝ) ^ p)) ^ (1 / q)) * X ^ (1 / p) := by
        congr 1
        rw [hXcomb, ← ENNReal.rpow_mul]
        congr 1
        field_simp

/-- **BRS (4.5).**  Hölder's inequality turns `R₂` into a local `L^p` average:
the admissible dilations force the integration window into `[1/4, 4]`, where
the weight `s^{d-1}` is comparable to one. -/
theorem brsRemainderTwo_le_local {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 ≤ p)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderTwo (absProfile f₀) r ≤
      ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p)) *
        (ENNReal.ofReal r⁻¹ *
          ∫⁻ s in Icc (1 / 4 : ℝ) 4,
            ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hexp1 : (0 : ℝ) ≤ 1 - 1 / p := by
    have h1p : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp
    linarith
  set Y : ENNReal := ∫⁻ s in Icc (1 / 4 : ℝ) 4,
    ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p with hY
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have htr' : 3 * r / 2 ≤ t := htr
  by_cases hr : r ≤ 0
  · have hzero : r⁻¹ * ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖ ≤ 0 := by
      have hinv : r⁻¹ ≤ 0 := inv_nonpos.mpr hr
      exact mul_nonpos_of_nonpos_of_nonneg hinv (norm_nonneg _)
    rw [ENNReal.ofReal_eq_zero.mpr hzero]
    simp
  push Not at hr
  have hrle : r ≤ 4 / 3 := by linarith
  have hab : t - r ≤ t + r := by linarith
  have hthird : t / 3 ≤ t - r := by linarith
  have hslow : ∀ s ∈ Icc (t - r) (t + r), (1 : ℝ) / 3 ≤ s := by
    intro s hs
    have h1 : t - r ≤ s := hs.1
    have h2 : (1 : ℝ) / 3 ≤ t / 3 := by linarith
    linarith
  have hsub : Icc (t - r) (t + r) ⊆ Icc (1 / 4 : ℝ) 4 := by
    intro s hs
    refine ⟨?_, ?_⟩
    · have := hslow s hs
      linarith
    · have := hs.2
      linarith
  -- the window integral as a lintegral
  have hRterm : ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖ =
      ∫ s in (t - r)..(t + r), ‖f₀ s‖ := by
    have h : (fun s : ℝ => absProfile f₀ s) = fun s : ℝ => ((‖f₀ s‖ : ℝ) : ℂ) := rfl
    rw [h]
    exact norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
  have hconv : ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖f₀ s‖) =
      ∫⁻ s in Icc (t - r) (t + r), ENNReal.ofReal ‖f₀ s‖ := by
    rw [intervalIntegral.integral_of_le hab,
      ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    refine ofReal_integral_eq_lintegral_ofReal ?_ ?_
    · exact (hf₀.norm.continuousOn).integrableOn_Icc
    · exact ae_of_all _ fun s => norm_nonneg _
  -- Hölder on the window
  have hWvol : (volume.restrict (Icc (t - r) (t + r))) univ =
      ENNReal.ofReal (2 * r) := by
    rw [Measure.restrict_apply_univ, Real.volume_Icc]
    congr 1
    ring
  have hholder := lintegral_le_rpow_mul_measure_univ
    (μ := volume.restrict (Icc (t - r) (t + r)))
    (Φ := fun s => ENNReal.ofReal ‖f₀ s‖)
    hf₀.norm.measurable.ennreal_ofReal hp
  rw [hWvol] at hholder
  -- the weight is comparable to one on the window
  have hweight : (∫⁻ s in Icc (t - r) (t + r), (ENNReal.ofReal ‖f₀ s‖) ^ p) ≤
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * Y := by
    calc (∫⁻ s in Icc (t - r) (t + r), (ENNReal.ofReal ‖f₀ s‖) ^ p)
        ≤ ∫⁻ s in Icc (t - r) (t + r), ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
            (ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) := by
          refine setLIntegral_mono' measurableSet_Icc ?_
          intro s hs
          have hs3 : (1 : ℝ) / 3 ≤ s := hslow s hs
          have hspos : 0 < s := by linarith
          have hone : (1 : ENNReal) ≤ ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
              ENNReal.ofReal s ^ (d - 1) := by
            rw [← ENNReal.ofReal_pow hspos.le, ← ENNReal.ofReal_mul (by positivity),
              ← mul_pow, ENNReal.one_le_ofReal]
            refine one_le_pow₀ ?_
            nlinarith [hs3]
          calc (ENNReal.ofReal ‖f₀ s‖) ^ p
              = 1 * (ENNReal.ofReal ‖f₀ s‖) ^ p := (one_mul _).symm
            _ ≤ (ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1)) *
                  (ENNReal.ofReal ‖f₀ s‖) ^ p := mul_le_mul' hone le_rfl
            _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
                  (ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) := by
                ring
      _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
            ∫⁻ s in Icc (t - r) (t + r), ENNReal.ofReal s ^ (d - 1) *
              (ENNReal.ofReal ‖f₀ s‖) ^ p :=
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
      _ ≤ ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * Y := by
          refine mul_le_mul' le_rfl ?_
          rw [hY]
          exact lintegral_mono_set hsub
  -- assemble
  have hfinal : ENNReal.ofReal r⁻¹ *
      ((ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * Y) ^ (1 / p) *
        ENNReal.ofReal (2 * r) ^ (1 - 1 / p)) =
      ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p)) *
        (ENNReal.ofReal r⁻¹ * Y) ^ (1 / p) := by
    have h3 : (ENNReal.ofReal ((3 : ℝ) ^ (d - 1))) ^ (1 / p) =
        ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p)) := by
      rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
      congr 1
      have hc : ((3 : ℝ) ^ (d - 1) : ℝ) = (3 : ℝ) ^ ((d : ℝ) - 1) := by
        have hc0 := pow_sub_eq_rpow (x := (3 : ℝ)) (by norm_num) (D := d) (k := 1)
          (by omega)
        simpa using hc0
      rw [hc, ← Real.rpow_mul (by norm_num)]
      congr 1
      field_simp
    have h2r : ENNReal.ofReal (2 * r) ^ (1 - 1 / p) =
        ENNReal.ofReal ((2 : ℝ) ^ (1 - 1 / p)) *
          ENNReal.ofReal (r ^ (1 - 1 / p)) := by
      rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hexp1,
        Real.mul_rpow (by norm_num) hr.le, ENNReal.ofReal_mul (by positivity)]
    have hrinv : ENNReal.ofReal r⁻¹ * ENNReal.ofReal (r ^ (1 - 1 / p)) =
        (ENNReal.ofReal r⁻¹) ^ (1 / p) := by
      rw [← ENNReal.ofReal_mul (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
      congr 1
      have hL : r⁻¹ * r ^ (1 - 1 / p) = r ^ (-(1 / p)) := by
        rw [← Real.rpow_neg_one r, ← Real.rpow_add hr]
        congr 1
        ring
      have hR : (r⁻¹) ^ (1 / p) = r ^ (-(1 / p)) := by
        rw [← Real.rpow_neg_one r, ← Real.rpow_mul hr.le]
        congr 1
        ring
      rw [hL, hR]
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p), h3, h2r]
    calc ENNReal.ofReal r⁻¹ *
          (ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p)) * Y ^ (1 / p) *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 - 1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))))
        = (ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p)) *
            ENNReal.ofReal ((2 : ℝ) ^ (1 - 1 / p))) *
            ((ENNReal.ofReal r⁻¹ * ENNReal.ofReal (r ^ (1 - 1 / p))) *
              Y ^ (1 / p)) := by ring
      _ = ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p)) *
            ((ENNReal.ofReal r⁻¹) ^ (1 / p) * Y ^ (1 / p)) := by
          rw [← ENNReal.ofReal_mul (by positivity), hrinv]
      _ = ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p)) *
            (ENNReal.ofReal r⁻¹ * Y) ^ (1 / p) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p)]
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖)
      = ENNReal.ofReal r⁻¹ *
          ∫⁻ s in Icc (t - r) (t + r), ENNReal.ofReal ‖f₀ s‖ := by
        rw [hRterm, ENNReal.ofReal_mul (by positivity), hconv]
    _ ≤ ENNReal.ofReal r⁻¹ *
          ((∫⁻ s in Icc (t - r) (t + r), (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) *
            ENNReal.ofReal (2 * r) ^ (1 - 1 / p)) := mul_le_mul' le_rfl hholder
    _ ≤ ENNReal.ofReal r⁻¹ *
          ((ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * Y) ^ (1 / p) *
            ENNReal.ofReal (2 * r) ^ (1 - 1 / p)) := by
        refine mul_le_mul' le_rfl (mul_le_mul' ?_ le_rfl)
        exact ENNReal.rpow_le_rpow hweight (by positivity)
    _ = ENNReal.ofReal ((3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p)) *
          (ENNReal.ofReal r⁻¹ * Y) ^ (1 / p) := hfinal

/-- `R₂` vanishes for `r > 4/3`: no dilation `t ≤ 2` satisfies `t ≥ 3r/2`. -/
theorem brsRemainderTwo_eq_zero_of_gt {f₀ : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) :
    brsRemainderTwo (absProfile f₀) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  have ht2 : t ≤ 2 := ht.1.2
  have htr : 3 * r / 2 ≤ t := ht.2
  linarith

/-- The weight of the `r`-integration in BRS Proposition 4.3. -/
theorem lintegral_rpow_Ioc_lt_top {a b : ℝ} (hb : 0 < b) (ha : -1 < a) :
    (∫⁻ r in Ioc (0 : ℝ) b, ENNReal.ofReal (r ^ a)) < ⊤ := by
  have hint : IntegrableOn (fun r : ℝ => r ^ a) (Ioc 0 b) volume := by
    have h := intervalIntegral.intervalIntegrable_rpow' (a := 0) (b := b) ha
    rw [intervalIntegrable_iff_integrableOn_Ioc_of_le hb.le] at h
    exact h
  have hval : ENNReal.ofReal (∫ r in Ioc (0 : ℝ) b, r ^ a) =
      ∫⁻ r in Ioc (0 : ℝ) b, ENNReal.ofReal (r ^ a) := by
    refine ofReal_integral_eq_lintegral_ofReal hint ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ioc] with r hr
    exact Real.rpow_nonneg (le_of_lt hr.1) _
  rw [← hval]
  exact ENNReal.ofReal_lt_top

/-- **BRS Proposition 4.3** for the non-endpoint range `q < pd`. -/
theorem prop43_brsRemainderTwo {d : ℕ} (hd : 2 ≤ d) {p q : ℝ} (hp : 1 ≤ p)
    (hq : 0 < q) (hqpd : q < p * d) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsRemainderTwo (absProfile f₀) r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
            (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  set C₁ : ℝ := (3 : ℝ) ^ (((d : ℝ) - 1) / p) * (2 : ℝ) ^ (1 - 1 / p) with hC₁
  have hC₁pos : 0 < C₁ := by
    rw [hC₁]
    have h1 : (0 : ℝ) < (3 : ℝ) ^ (((d : ℝ) - 1) / p) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < (2 : ℝ) ^ (1 - 1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  -- the radial weight integral is finite
  set a : ℝ := ((d : ℝ) - 1) - q / p with ha
  have hagt : -1 < a := by
    rw [ha]
    have hqp : q / p < (d : ℝ) := by
      rw [div_lt_iff₀ hp0]
      calc q < p * (d : ℝ) := hqpd
        _ = (d : ℝ) * p := by ring
    linarith
  set K : ENNReal := ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ a) with hK
  have hKtop : K ≠ ⊤ := by
    rw [hK]
    exact (lintegral_rpow_Ioc_lt_top (by norm_num) hagt).ne
  refine ⟨C₁ * (K.toReal + 1) ^ (1 / q), by positivity, ?_⟩
  intro f₀ hf₀
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        positivity)]
    exact le_top
  -- the pointwise bound, supported in `(0, 4/3]`
  have hpoint : ∀ r : ℝ, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (r ^ a) *
            ((ENNReal.ofReal C₁) ^ q * X ^ (q / p))) r := by
    intro r
    by_cases hr0 : r ≤ 0
    · have hzero : ENNReal.ofReal r ^ (d - 1) = 0 := by
        rw [ENNReal.ofReal_eq_zero.mpr hr0, zero_pow (by omega : d - 1 ≠ 0)]
      rw [hzero, zero_mul]
      simp
    push Not at hr0
    by_cases hrle : r ≤ 4 / 3
    · have hmem : r ∈ Ioc (0 : ℝ) (4 / 3) := ⟨hr0, hrle⟩
      rw [Set.indicator_of_mem hmem]
      -- (4.5) and monotonicity in the domain of integration
      have h45 := brsRemainderTwo_le_local hd hp hf₀ r
      have hY : (∫⁻ s in Icc (1 / 4 : ℝ) 4, ENNReal.ofReal s ^ (d - 1) *
          (ENNReal.ofReal ‖f₀ s‖) ^ p) ≤ X := by
        rw [hX]
        exact setLIntegral_le_lintegral _ _
      have h45' : brsRemainderTwo (absProfile f₀) r ≤
          ENNReal.ofReal C₁ * (ENNReal.ofReal r⁻¹ * X) ^ (1 / p) := by
        refine le_trans h45 ?_
        rw [hC₁]
        refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ (by positivity))
        exact mul_le_mul' le_rfl hY
      have hpow : brsRemainderTwo (absProfile f₀) r ^ q ≤
          (ENNReal.ofReal C₁) ^ q * ((ENNReal.ofReal r⁻¹) ^ (q / p) * X ^ (q / p)) := by
        calc brsRemainderTwo (absProfile f₀) r ^ q
            ≤ (ENNReal.ofReal C₁ * (ENNReal.ofReal r⁻¹ * X) ^ (1 / p)) ^ q :=
              ENNReal.rpow_le_rpow h45' hq.le
          _ = (ENNReal.ofReal C₁) ^ q *
                ((ENNReal.ofReal r⁻¹) ^ (q / p) * X ^ (q / p)) := by
              rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
                ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p * q),
                show 1 / p * q = q / p by ring]
      have hweight : ENNReal.ofReal r ^ (d - 1) * (ENNReal.ofReal r⁻¹) ^ (q / p) =
          ENNReal.ofReal (r ^ a) := by
        have h1 : ENNReal.ofReal r ^ (d - 1) = ENNReal.ofReal (r ^ ((d : ℝ) - 1)) := by
          rw [← ENNReal.ofReal_pow hr0.le]
          congr 1
          have hc := pow_sub_eq_rpow hr0 (D := d) (k := 1) (by omega)
          simpa using hc
        have h2 : (ENNReal.ofReal r⁻¹) ^ (q / p) =
            ENNReal.ofReal (r ^ (-(q / p))) := by
          rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
          congr 1
          rw [← Real.rpow_neg_one r, ← Real.rpow_mul hr0.le]
          congr 1
          ring
        rw [h1, h2, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr0.le _),
          ← Real.rpow_add hr0, ha]
        congr 1
      calc ENNReal.ofReal r ^ (d - 1) * brsRemainderTwo (absProfile f₀) r ^ q
          ≤ ENNReal.ofReal r ^ (d - 1) *
              ((ENNReal.ofReal C₁) ^ q *
                ((ENNReal.ofReal r⁻¹) ^ (q / p) * X ^ (q / p))) :=
            mul_le_mul' le_rfl hpow
        _ = (ENNReal.ofReal r ^ (d - 1) * (ENNReal.ofReal r⁻¹) ^ (q / p)) *
              ((ENNReal.ofReal C₁) ^ q * X ^ (q / p)) := by ring
        _ = ENNReal.ofReal (r ^ a) * ((ENNReal.ofReal C₁) ^ q * X ^ (q / p)) := by
            rw [hweight]
    · push Not at hrle
      rw [brsRemainderTwo_eq_zero_of_gt hrle, ENNReal.zero_rpow_of_pos hq, mul_zero]
      simp
  -- integrate the pointwise bound
  have hXpow : X ^ (q / p) ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg (by positivity) hXtop
  have hconst : (ENNReal.ofReal C₁) ^ q * X ^ (q / p) ≠ ⊤ :=
    ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg hq.le ENNReal.ofReal_ne_top) hXpow
  have hint : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q) ≤
        K * ((ENNReal.ofReal C₁) ^ q * X ^ (q / p)) := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsRemainderTwo (absProfile f₀) r ^ q)
        ≤ ∫⁻ r, (Ioc (0 : ℝ) (4 / 3)).indicator
            (fun r => ENNReal.ofReal (r ^ a) *
              ((ENNReal.ofReal C₁) ^ q * X ^ (q / p))) r := lintegral_mono hpoint
      _ = ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ a) *
            ((ENNReal.ofReal C₁) ^ q * X ^ (q / p)) :=
          lintegral_indicator measurableSet_Ioc _
      _ = K * ((ENNReal.ofReal C₁) ^ q * X ^ (q / p)) := by
          rw [hK, ← lintegral_mul_const' _ _ hconst]
  -- take the `q`-th root
  have hKle : K ≤ ENNReal.ofReal (K.toReal + 1) := by
    rw [ENNReal.ofReal_add (by positivity) (by norm_num), ENNReal.ofReal_toReal hKtop,
      ENNReal.ofReal_one]
    exact le_self_add
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderTwo (absProfile f₀) r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (K.toReal + 1) *
          ((ENNReal.ofReal C₁) ^ q * X ^ (q / p))) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (le_trans hint ?_) (by positivity)
        exact mul_le_mul' hKle le_rfl
    _ = ENNReal.ofReal (C₁ * (K.toReal + 1) ^ (1 / q)) * X ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          mul_one_div_cancel hq.ne', ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
          ENNReal.ofReal_mul hC₁pos.le]
        rw [show q / p * (1 / q) = 1 / p by field_simp]
        ring

/-- An interval integral is dominated by any `ℝ≥0∞` majorant of its integrand,
with no integrability hypothesis: if the integrand fails to be integrable the
Bochner integral vanishes by convention. -/
theorem ofReal_norm_intervalIntegral_le_lintegral {a b : ℝ} (hab : a ≤ b)
    (F : ℝ → ℂ) (H : ℝ → ENNReal)
    (hH : ∀ s ∈ Icc a b, ENNReal.ofReal ‖F s‖ ≤ H s) :
    ENNReal.ofReal ‖∫ s in a..b, F s‖ ≤ ∫⁻ s in Icc a b, H s := by
  by_cases hint : IntervalIntegrable F volume a b
  · have hnormint : IntegrableOn (fun s => ‖F s‖) (Icc a b) volume := by
      rw [← intervalIntegrable_iff_integrableOn_Icc_of_le hab]
      exact hint.norm
    calc ENNReal.ofReal ‖∫ s in a..b, F s‖
        ≤ ENNReal.ofReal (∫ s in a..b, ‖F s‖) :=
          ENNReal.ofReal_le_ofReal
            (intervalIntegral.norm_integral_le_integral_norm hab)
      _ = ∫⁻ s in Icc a b, ENNReal.ofReal ‖F s‖ := by
          rw [intervalIntegral.integral_of_le hab,
            ← MeasureTheory.integral_Icc_eq_integral_Ioc]
          exact ofReal_integral_eq_lintegral_ofReal hnormint
            (ae_of_all _ fun s => norm_nonneg _)
      _ ≤ ∫⁻ s in Icc a b, H s := setLIntegral_mono' measurableSet_Icc hH
  · rw [intervalIntegral.integral_undef hint]
    simp

/-! ### The support of the main term `𝔐_p`

The constraints `t ∈ E ⊆ [1,2]` and `r/2 < t < 3r/2` confine the radius to
`(2/3, 4)`. -/

theorem brsMainMaximal_eq_zero_of_le {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (g : ℝ → ℂ) {r : ℝ} (hr : r ≤ 2 / 3) :
    brsMainMaximal d E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  have ht1 : (1 : ℝ) ≤ t := (hE ht.1).1
  have ht2 : t < 3 * r / 2 := ht.2.2
  linarith

theorem brsMainMaximal_eq_zero_of_ge {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (g : ℝ → ℂ) {r : ℝ} (hr : 4 ≤ r) :
    brsMainMaximal d E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  have ht2 : t ≤ 2 := (hE ht.1).2
  have htr : r / 2 < t := ht.2.1
  linarith

/-- For `p > p_d = d/(d-1)` the conjugate exponent satisfies `p' < d`. -/
theorem conjExponent_lt_of_lt {d : ℕ} (hd : 2 ≤ d) {p : ℝ}
    (hpd : (d : ℝ) / ((d : ℝ) - 1) < p) : Real.conjExponent p < (d : ℝ) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hp1 : 1 < p := by
    have h1 : (1 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := by
      rw [lt_div_iff₀ hd1]
      linarith
    linarith
  rw [Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
  rw [div_lt_iff₀ hd1] at hpd
  nlinarith [hpd]

/-- The `p'`-th power of the kernel weight is integrable on `[0,6]` exactly when
`p > p_d = d/(d-1)`. -/
theorem lintegral_kernel_weight_lt_top {d : ℕ} (hd : 2 ≤ d) {p : ℝ}
    (hpd : (d : ℝ) / ((d : ℝ) - 1) < p) :
    (∫⁻ s in Icc (0 : ℝ) 6,
        ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p))) < ⊤ := by
  have hexp : -1 < ((d : ℝ) - 1) - Real.conjExponent p := by
    have := conjExponent_lt_of_lt hd hpd
    linarith
  have hint : IntegrableOn
      (fun s : ℝ => s ^ (((d : ℝ) - 1) - Real.conjExponent p)) (Icc 0 6) volume := by
    have h := intervalIntegral.intervalIntegrable_rpow' (a := 0) (b := 6) hexp
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num)] at h
    exact h
  have hval : ENNReal.ofReal
      (∫ s in Icc (0 : ℝ) 6, s ^ (((d : ℝ) - 1) - Real.conjExponent p)) =
      ∫⁻ s in Icc (0 : ℝ) 6,
        ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p)) := by
    refine ofReal_integral_eq_lintegral_ofReal hint ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Icc] with s hs
    exact Real.rpow_nonneg hs.1 _
  rw [← hval]
  exact ENNReal.ofReal_lt_top

/-- The kernel weight raised to `p'` is the power appearing above. -/
theorem kernel_weight_rpow {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp1 : 1 < p) {s : ℝ}
    (hs : 0 ≤ s) :
    (ENNReal.ofReal (s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1))) ^
        Real.conjExponent p =
      ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p)) := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hp1ne : p - 1 ≠ 0 := by
    intro hcon
    rw [sub_eq_zero] at hcon
    exact absurd hcon.symm hp1.ne
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos hp0 (by linarith)
  rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hs _) hp'pos.le,
    ← Real.rpow_mul hs]
  congr 2
  rw [Real.conjExponent]
  field_simp

theorem setLIntegral_Icc_zero_le_Ioi {b : ℝ} (H : ℝ → ENNReal) :
    (∫⁻ s in Icc (0 : ℝ) b, H s) ≤ ∫⁻ s in Ioi (0 : ℝ), H s := by
  calc (∫⁻ s in Icc (0 : ℝ) b, H s) = ∫⁻ s in Ioc (0 : ℝ) b, H s :=
        (setLIntegral_congr Ioc_ae_eq_Icc).symm
    _ ≤ ∫⁻ s in Ioi (0 : ℝ), H s := lintegral_mono_set Ioc_subset_Ioi_self

/-- **The pointwise bound of BRS Proposition 4.4.**  For `p > p_d` the kernel
weight lies in `L^{p'}` of the relevant window, so `𝔐_p g` is bounded by a
constant multiple of the `L^p` norm of `g`. -/
theorem brsMainMaximal_le_of_lt {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (hpd : (d : ℝ) / ((d : ℝ) - 1) < p)
    {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainMaximal d E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ((∫⁻ s in Icc (0 : ℝ) 6,
            ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p))) ^
              (1 / Real.conjExponent p) *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hp1 : 1 < p := by
    have h1 : (1 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := by
      rw [lt_div_iff₀ hd1]
      linarith
    linarith
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos hp0 (by linarith)
  have hpq : (Real.conjExponent p).HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp1).symm
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with hedef
  set W : ENNReal := ∫⁻ s in Icc (0 : ℝ) 6,
    ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p)) with hW
  set G : ENNReal := ∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p with hG
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have hrlow : 2 / 3 < r := by linarith
  have hrpos : 0 < r := by linarith
  have hab : |r - t| ≤ r + t := by
    rw [abs_le]
    constructor <;> linarith
  have hsub : Icc |r - t| (r + t) ⊆ Icc (0 : ℝ) 6 := by
    intro s hs
    refine ⟨le_trans (abs_nonneg _) hs.1, ?_⟩
    have := hs.2
    linarith
  -- the radial factor
  have hradial : r ^ (1 - (d : ℝ)) ≤ (2 / 3 : ℝ) ^ (1 - (d : ℝ)) := by
    refine Real.rpow_le_rpow_of_nonpos (by norm_num) hrlow.le (by linarith)
  -- the inner integral, dominated by a lintegral
  have hinner : ENNReal.ofReal
      ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc (0 : ℝ) 6,
        ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖ := by
    refine le_trans (ofReal_norm_intervalIntegral_le_lintegral hab _
      (fun s => ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ?_) ?_
    · intro s hs
      have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg hs0 _),
        ENNReal.ofReal_mul (Real.rpow_nonneg hs0 _)]
    · exact lintegral_mono_set hsub
  -- Hölder
  have hholder : (∫⁻ s in Icc (0 : ℝ) 6,
      ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ≤
      W ^ (1 / Real.conjExponent p) * G ^ (1 / p) := by
    have hmeas1 : Measurable fun s : ℝ => ENNReal.ofReal (s ^ e) := by fun_prop
    have hmeas2 : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
      hg.norm.ennreal_ofReal
    have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
      (volume.restrict (Icc (0 : ℝ) 6)) hpq hmeas1.aemeasurable hmeas2.aemeasurable
    simp only [Pi.mul_apply] at hkey
    refine le_trans hkey ?_
    have hWeq : (∫⁻ s in Icc (0 : ℝ) 6,
        (ENNReal.ofReal (s ^ e)) ^ Real.conjExponent p) = W := by
      rw [hW]
      refine setLIntegral_congr_fun measurableSet_Icc ?_
      intro s hs
      rw [hedef]
      exact kernel_weight_rpow hd hp1 hs.1
    have hGle : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal ‖g s‖) ^ p) ≤ G := by
      rw [hG]
      exact setLIntegral_Icc_zero_le_Ioi _
    rw [hWeq]
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hGle (by positivity))
  -- combine
  calc ENNReal.ofReal (r ^ (1 - (d : ℝ)) *
        ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (1 - (d : ℝ))) *
          ENNReal.ofReal ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖ := by
        rw [ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
    _ ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          (W ^ (1 / Real.conjExponent p) * G ^ (1 / p)) :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hradial) (le_trans hinner hholder)

/-- The radial weight over the support of `𝔐_p` is finite. -/
theorem lintegral_radial_weight_Ioo_lt_top {d : ℕ} :
    (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r ^ (d - 1)) < ⊤ := by
  have hbound : ∀ r ∈ Ioo (2 / 3 : ℝ) 4,
      ENNReal.ofReal r ^ (d - 1) ≤ ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) := by
    intro r hr
    rw [← ENNReal.ofReal_pow (by linarith [hr.1] : (0 : ℝ) ≤ r)]
    refine ENNReal.ofReal_le_ofReal ?_
    refine pow_le_pow_left₀ (by linarith [hr.1]) ?_ _
    exact le_of_lt hr.2
  calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r ^ (d - 1))
      ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) :=
        setLIntegral_mono' measurableSet_Ioo hbound
    _ = ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * volume (Ioo (2 / 3 : ℝ) 4) :=
        setLIntegral_const _ _
    _ < ⊤ := by
        rw [Real.volume_Ioo]
        exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top ENNReal.ofReal_lt_top

/-- **BRS Proposition 4.4.**  For `p > p_d = d/(d-1)` and every `0 < q < ∞` the
main term `𝔐_p` maps `L^p(ds)` to `L^q(r^{d-1} dr)`. -/
theorem prop44_brsMainMaximal {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hpd : (d : ℝ) / ((d : ℝ) - 1) < p)
    (hq : 0 < q) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hp1 : 1 < p := by
    have h1 : (1 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := by
      rw [lt_div_iff₀ hd1]
      linarith
    linarith
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos hp0 (by linarith)
  set W : ENNReal := ∫⁻ s in Icc (0 : ℝ) 6,
    ENNReal.ofReal (s ^ (((d : ℝ) - 1) - Real.conjExponent p)) with hW
  have hWtop : W ≠ ⊤ := by
    rw [hW]
    exact (lintegral_kernel_weight_lt_top hd hpd).ne
  set M : ENNReal := ∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r ^ (d - 1) with hM
  have hMtop : M ≠ ⊤ := by
    rw [hM]
    exact (lintegral_radial_weight_Ioo_lt_top (d := d)).ne
  set A : ℝ := (2 / 3 : ℝ) ^ (1 - (d : ℝ)) with hA
  have hApos : 0 < A := by
    rw [hA]
    exact Real.rpow_pos_of_pos (by norm_num) _
  refine ⟨A * (W.toReal + 1) ^ (1 / Real.conjExponent p) *
    (M.toReal + 1) ^ (1 / q), by positivity, ?_⟩
  intro g hg
  set G : ENNReal := ∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p with hG
  by_cases hGtop : G = ⊤
  · rw [hGtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        positivity)]
    exact le_top
  set B : ENNReal := ENNReal.ofReal A *
    (W ^ (1 / Real.conjExponent p) * G ^ (1 / p)) with hB
  have hBtop : B ≠ ⊤ := by
    rw [hB]
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top (ENNReal.mul_ne_top ?_ ?_)
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hWtop
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hGtop
  have hBpow : B ^ q ≠ ⊤ := ENNReal.rpow_ne_top_of_nonneg hq.le hBtop
  -- the pointwise bound, supported in `(2/3, 4)`
  have hpoint : ∀ r : ℝ, ENNReal.ofReal r ^ (d - 1) *
      brsMainMaximal d E p g r ^ q ≤
        (Ioo (2 / 3 : ℝ) 4).indicator
          (fun r => ENNReal.ofReal r ^ (d - 1) * B ^ q) r := by
    intro r
    by_cases hr1 : r ≤ 2 / 3
    · rw [brsMainMaximal_eq_zero_of_le hE g hr1, ENNReal.zero_rpow_of_pos hq,
        mul_zero]
      simp
    push Not at hr1
    by_cases hr2 : 4 ≤ r
    · rw [brsMainMaximal_eq_zero_of_ge hE g hr2, ENNReal.zero_rpow_of_pos hq,
        mul_zero]
      simp
    push Not at hr2
    have hmem : r ∈ Ioo (2 / 3 : ℝ) 4 := ⟨hr1, hr2⟩
    rw [Set.indicator_of_mem hmem]
    refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq.le)
    rw [hB, hA, hW, hG]
    exact brsMainMaximal_le_of_lt hd hE hpd hg r
  -- integrate
  have hint : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsMainMaximal d E p g r ^ q) ≤ M * B ^ q := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q)
        ≤ ∫⁻ r, (Ioo (2 / 3 : ℝ) 4).indicator
            (fun r => ENNReal.ofReal r ^ (d - 1) * B ^ q) r := lintegral_mono hpoint
      _ = ∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r ^ (d - 1) * B ^ q :=
          lintegral_indicator measurableSet_Ioo _
      _ = M * B ^ q := by
          rw [hM, ← lintegral_mul_const' _ _ hBpow]
  -- take the `q`-th root and bound the constants
  have hWle : W ^ (1 / Real.conjExponent p) ≤
      ENNReal.ofReal ((W.toReal + 1) ^ (1 / Real.conjExponent p)) := by
    rw [← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    refine ENNReal.rpow_le_rpow ?_ (by positivity)
    rw [ENNReal.ofReal_add (by positivity) (by norm_num), ENNReal.ofReal_toReal hWtop,
      ENNReal.ofReal_one]
    exact le_self_add
  have hMle : M ^ (1 / q) ≤ ENNReal.ofReal ((M.toReal + 1) ^ (1 / q)) := by
    rw [← ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    refine ENNReal.rpow_le_rpow ?_ (by positivity)
    rw [ENNReal.ofReal_add (by positivity) (by norm_num), ENNReal.ofReal_toReal hMtop,
      ENNReal.ofReal_one]
    exact le_self_add
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ^ (1 / q)
      ≤ (M * B ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow hint (by positivity)
    _ = M ^ (1 / q) * B := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, mul_one_div_cancel hq.ne', ENNReal.rpow_one]
    _ = M ^ (1 / q) * (ENNReal.ofReal A * W ^ (1 / Real.conjExponent p)) *
          G ^ (1 / p) := by
        rw [hB]
        ring
    _ ≤ ENNReal.ofReal ((M.toReal + 1) ^ (1 / q)) *
          (ENNReal.ofReal A *
            ENNReal.ofReal ((W.toReal + 1) ^ (1 / Real.conjExponent p))) *
          G ^ (1 / p) := by
        refine mul_le_mul' (mul_le_mul' hMle (mul_le_mul' le_rfl hWle)) le_rfl
    _ = ENNReal.ofReal (A * (W.toReal + 1) ^ (1 / Real.conjExponent p) *
          (M.toReal + 1) ^ (1 / q)) * G ^ (1 / p) := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring

/-! ## The dyadic neighbourhoods (4.6) -/

section DyadicShells

open Auto.FractalDimensions

/-! ## BRS (4.6): the dyadic neighbourhoods of the dilation set

`U_n` is the `2^{-n+1}`-neighbourhood of `E` and `D_n = U_n \ U_{n+1}` is the
dyadic shell where the distance to `E` is of size `2^{-n}`.  On `D_n` the
integration window of `𝔐_p` is cut off at `2^{-n}`, which is what makes the
`p < p_d` estimate possible. -/

/-- The `2^{-n+1}`-neighbourhood of the dilation set, BRS (4.6). -/
def brsU (E : Set ℝ) (n : ℕ) : Set ℝ :=
  {r | Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(n : ℤ))}

/-- The dyadic shell `D_n = U_n \ U_{n+1}` of BRS (4.6). -/
def brsD (E : Set ℝ) (n : ℕ) : Set ℝ := brsU E n \ brsU E (n + 1)

theorem measurableSet_brsU (E : Set ℝ) (n : ℕ) : MeasurableSet (brsU E n) := by
  have hcont : Continuous fun r : ℝ => Metric.infDist r E :=
    Metric.continuous_infDist_pt E
  exact measurableSet_le hcont.measurable measurable_const

theorem measurableSet_brsD (E : Set ℝ) (n : ℕ) : MeasurableSet (brsD E n) :=
  (measurableSet_brsU E n).diff (measurableSet_brsU E (n + 1))

/-- The neighbourhoods decrease. -/
theorem brsU_subset_of_le (E : Set ℝ) {m n : ℕ} (hmn : m ≤ n) :
    brsU E n ⊆ brsU E m := by
  intro r hr
  have hpow : (2 : ℝ) ^ (-(n : ℤ)) ≤ (2 : ℝ) ^ (-(m : ℤ)) := by
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    omega
  have h : Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(n : ℤ)) := hr
  show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(m : ℤ))
  linarith

/-- The shells `D_n` are pairwise disjoint. -/
theorem brsD_disjoint (E : Set ℝ) {m n : ℕ} (hmn : m ≠ n) :
    Disjoint (brsD E m) (brsD E n) := by
  rcases lt_or_gt_of_ne hmn with h | h
  · refine Set.disjoint_left.mpr fun r hrm hrn => ?_
    exact hrm.2 (brsU_subset_of_le E (by omega) hrn.1)
  · refine Set.disjoint_left.mpr fun r hrm hrn => ?_
    exact hrn.2 (brsU_subset_of_le E (by omega) hrm.1)

/-- Points of `U_0` outside every shell are at distance zero from `E`. -/
theorem infDist_eq_zero_of_notMem_iUnion_brsD {E : Set ℝ} {r : ℝ}
    (hr : r ∈ brsU E 0) (hnot : r ∉ ⋃ n, brsD E n) : Metric.infDist r E = 0 := by
  have hall : ∀ n : ℕ, r ∈ brsU E n := by
    intro n
    induction n with
    | zero => exact hr
    | succ k ih =>
        by_contra hcon
        exact hnot (Set.mem_iUnion.mpr ⟨k, ⟨ih, hcon⟩⟩)
  by_contra hne
  have hpos : 0 < Metric.infDist r E :=
    lt_of_le_of_ne Metric.infDist_nonneg (Ne.symm hne)
  obtain ⟨n, hn⟩ := pow_unbounded_of_one_lt (2 / Metric.infDist r E)
    (by norm_num : (1 : ℝ) < 2)
  have hpown : (0 : ℝ) < (2 : ℝ) ^ n := by positivity
  have h2 : 2 * (2 : ℝ) ^ (-(n : ℤ)) < Metric.infDist r E := by
    rw [zpow_neg, zpow_natCast, ← div_eq_mul_inv, div_lt_iff₀ hpown]
    rw [div_lt_iff₀ hpos] at hn
    nlinarith [hn]
  exact absurd (hall n) (not_le.mpr h2)

/-- **The measure of the dyadic neighbourhood**, in terms of the covering
number at the same scale. -/
theorem volume_brsU_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (n : ℕ) :
    volume (brsU E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
        (intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℝ≥0∞) := by
  set δ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hδ
  have hδpos : 0 < δ := by
    rw [hδ]
    positivity
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber hE hδpos
  have hsub : brsU E n ⊆ ⋃ a ∈ ι, Icc (a - δ / 2 - 3 * δ) (a + δ / 2 + 3 * δ) := by
    intro r hr
    have hdist : Metric.infDist r E ≤ 2 * δ := hr
    obtain ⟨t, htE, hrt⟩ : ∃ t ∈ E, dist r t < 3 * δ := by
      have hlt : Metric.infDist r E < 3 * δ := by linarith
      exact (Metric.infDist_lt_iff hEne).mp hlt
    obtain ⟨a, haι, hat⟩ : ∃ a ∈ ι, t ∈ Icc (a - δ / 2) (a + δ / 2) := by
      have hcov := hι htE
      simpa only [Set.mem_iUnion, exists_prop] using hcov
    refine Set.mem_biUnion haι ?_
    rw [Real.dist_eq, abs_lt] at hrt
    exact ⟨by linarith [hat.1, hrt.1], by linarith [hat.2, hrt.2]⟩
  calc volume (brsU E n)
      ≤ volume (⋃ a ∈ ι, Icc (a - δ / 2 - 3 * δ) (a + δ / 2 + 3 * δ)) :=
        measure_mono hsub
    _ ≤ ∑ a ∈ ι, volume (Icc (a - δ / 2 - 3 * δ) (a + δ / 2 + 3 * δ)) :=
        measure_biUnion_finset_le _ _
    _ = ∑ _a ∈ ι, ENNReal.ofReal (7 * δ) := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Real.volume_Icc]
        congr 1
        ring
    _ = (ι.card : ℝ≥0∞) * ENNReal.ofReal (7 * δ) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = ENNReal.ofReal (7 * δ) * (intervalCoveringNumber E δ : ℝ≥0∞) := by
        rw [hcard, mul_comm]

end DyadicShells

/-- On the shell `D_n` the distance to `E` exceeds `2^{-n}`. -/
theorem lt_infDist_of_mem_brsD {E : Set ℝ} {n : ℕ} {r : ℝ} (hr : r ∈ brsD E n) :
    (2 : ℝ) ^ (-(n : ℤ)) < Metric.infDist r E := by
  have hnot : ¬ (Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-((n + 1 : ℕ) : ℤ))) := hr.2
  push Not at hnot
  have hid : 2 * (2 : ℝ) ^ (-((n + 1 : ℕ) : ℤ)) = (2 : ℝ) ^ (-(n : ℤ)) := by
    have hcast : ((n + 1 : ℕ) : ℤ) = (n : ℤ) + 1 := by push_cast; ring
    rw [hcast, neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    field_simp
  rwa [hid] at hnot

/-- **The window cutoff of BRS Proposition 4.5.**  On the shell `D_n` the
integration window of `𝔐_p` starts at `2^{-n}`, since every admissible
dilation `t` satisfies `|r - t| ≥ dist(r, E) > 2^{-n}`. -/
theorem brsMainMaximal_le_on_brsD {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {n : ℕ} {r : ℝ}
    (hrD : r ∈ brsD E n) :
    brsMainMaximal d E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
          ENNReal.ofReal (s ^ (((d : ℝ) - 1) * (1 - 1 / p) - 1)) *
            ENNReal.ofReal ‖g s‖ := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with hedef
  have hdist := lt_infDist_of_mem_brsD hrD
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have hrlow : 2 / 3 < r := by linarith
  have hrpos : 0 < r := by linarith
  have hab : |r - t| ≤ r + t := by
    rw [abs_le]
    constructor <;> linarith
  -- the lower cutoff
  have hcut : (2 : ℝ) ^ (-(n : ℤ)) ≤ |r - t| := by
    have hle : Metric.infDist r E ≤ dist r t := Metric.infDist_le_dist_of_mem htE
    rw [Real.dist_eq] at hle
    linarith
  have hsub : Icc |r - t| (r + t) ⊆ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 := by
    intro s hs
    refine ⟨le_trans hcut hs.1, ?_⟩
    have := hs.2
    linarith
  -- the radial factor
  have hradial : r ^ (1 - (d : ℝ)) ≤ (2 / 3 : ℝ) ^ (1 - (d : ℝ)) :=
    Real.rpow_le_rpow_of_nonpos (by norm_num) hrlow.le (by linarith)
  -- the inner integral
  have hinner : ENNReal.ofReal
      ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
        ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖ := by
    refine le_trans (ofReal_norm_intervalIntegral_le_lintegral hab _
      (fun s => ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ?_) ?_
    · intro s hs
      have hs0 : 0 ≤ s := le_trans (abs_nonneg _) hs.1
      rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg (Real.rpow_nonneg hs0 _),
        ENNReal.ofReal_mul (Real.rpow_nonneg hs0 _)]
    · exact lintegral_mono_set hsub
  calc ENNReal.ofReal (r ^ (1 - (d : ℝ)) *
        ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (1 - (d : ℝ))) *
          ENNReal.ofReal ‖∫ s in |r - t|..(r + t), ((s ^ e : ℝ) : ℂ) * g s‖ := by
        rw [ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
    _ ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
            ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖ :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hradial) hinner

/-! ## Discrete summation tools

Proposition 4.5 needs two summation inequalities.  Both are obtained by
running the `ℝ≥0∞` integral machinery against the counting measure on `ℕ`,
which turns `lintegral` into `tsum`. -/

/-- The embedding `ℓ^p ⊆ ℓ^q` for `0 < p ≤ q`. -/
theorem tsum_rpow_le_tsum_rpow (G : ℕ → ENNReal) {p q : ℝ} (hp : 0 < p)
    (hpq : p ≤ q) :
    (∑' k, G k ^ q) ^ (1 / q) ≤ (∑' k, G k ^ p) ^ (1 / p) := by
  have hq0 : 0 < q := lt_of_lt_of_le hp hpq
  set S : ENNReal := (∑' k, G k ^ p) ^ (1 / p) with hS
  have hSpow : S ^ p = ∑' k, G k ^ p := by
    rw [hS, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne', ENNReal.rpow_one]
  have hle : ∀ k, G k ≤ S := by
    intro k
    have h1 : G k ^ p ≤ ∑' k, G k ^ p := ENNReal.le_tsum k
    calc G k = (G k ^ p) ^ (1 / p) := by
          rw [← ENNReal.rpow_mul, one_div, mul_inv_cancel₀ hp.ne', ENNReal.rpow_one]
      _ ≤ S := by
          rw [hS]
          exact ENNReal.rpow_le_rpow h1 (by positivity)
  have hstep : ∀ k, G k ^ q ≤ S ^ (q - p) * G k ^ p := by
    intro k
    have hsplit : G k ^ q = G k ^ (q - p) * G k ^ p := by
      rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) hp.le]
      congr 1
      ring
    rw [hsplit]
    exact mul_le_mul' (ENNReal.rpow_le_rpow (hle k) (by linarith)) le_rfl
  calc (∑' k, G k ^ q) ^ (1 / q)
      ≤ (∑' k, S ^ (q - p) * G k ^ p) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum hstep) (by positivity)
    _ = (S ^ (q - p) * ∑' k, G k ^ p) ^ (1 / q) := by rw [ENNReal.tsum_mul_left]
    _ = (S ^ q) ^ (1 / q) := by
        rw [← hSpow, ← ENNReal.rpow_add_of_nonneg _ _ (by linarith) hp.le]
        congr 2
        ring
    _ = S := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]

/-- The counting-measure representation of a weighted sum. -/
theorem lintegral_withDensity_count (c G : ℕ → ENNReal) :
    (∫⁻ x, G x ∂((Measure.count : Measure ℕ).withDensity c)) = ∑' x, c x * G x := by
  rw [lintegral_withDensity_eq_lintegral_mul _ (measurable_from_top) (measurable_from_top)]
  simp only [Pi.mul_apply]
  exact lintegral_count _

/-- **Weighted Hölder for sums.**  For `q ≥ 1` a weighted sum is bounded by the
weighted `ℓ^q` norm times a power of the total weight. -/
theorem tsum_weighted_le (c G : ℕ → ENNReal) {q : ℝ} (hq : 1 ≤ q) :
    (∑' j, c j * G j) ≤
      (∑' j, c j * G j ^ q) ^ (1 / q) * (∑' j, c j) ^ (1 - 1 / q) := by
  set μ : Measure ℕ := (Measure.count : Measure ℕ).withDensity c with hμ
  have huniv : μ univ = ∑' j, c j := by
    rw [hμ, withDensity_apply _ MeasurableSet.univ, Measure.restrict_univ]
    exact lintegral_count _
  have hkey := lintegral_le_rpow_mul_measure_univ (μ := μ) (Φ := G)
    measurable_from_top hq
  rw [lintegral_withDensity_count c G, huniv] at hkey
  refine le_trans hkey ?_
  refine mul_le_mul' (ENNReal.rpow_le_rpow (le_of_eq ?_) (by positivity)) le_rfl
  rw [hμ]
  have hG : (∫⁻ x, G x ^ q ∂((Measure.count : Measure ℕ).withDensity c)) =
      ∑' x, c x * G x ^ q :=
    lintegral_withDensity_count c (fun x => G x ^ q)
  exact hG

/-! ## The dyadic blocks of the profile variable

The window `[2^{-n}, 6]` of `𝔐_p` on the shell `D_n` is covered by the dyadic
blocks `[3·2^{-k}, 6·2^{-k}]`, `k ≤ n + 2`. -/

/-- The dyadic block `[3·2^{-k}, 6·2^{-k}]` of the profile variable. -/
def brsBlock (k : ℕ) : Set ℝ :=
  Icc (3 * (2 : ℝ) ^ (-(k : ℤ))) (6 * (2 : ℝ) ^ (-(k : ℤ)))

theorem brsBlock_pos {k : ℕ} {s : ℝ} (hs : s ∈ brsBlock k) : 0 < s := by
  have h := hs.1
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  nlinarith [hpow]

theorem volume_brsBlock (k : ℕ) :
    volume (brsBlock k) = ENNReal.ofReal (3 * (2 : ℝ) ^ (-(k : ℤ))) := by
  rw [brsBlock, Real.volume_Icc]
  congr 1
  ring

/-- The window on the shell `D_n` is covered by the first `n + 3` blocks. -/
theorem window_subset_iUnion_brsBlock (n : ℕ) :
    Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 ⊆ ⋃ k ∈ Finset.range (n + 3), brsBlock k := by
  intro s hs
  obtain ⟨hs1, hs2⟩ := hs
  have hspos : 0 < s := lt_of_lt_of_le (by positivity) hs1
  -- choose the block containing `s`
  have hexists : ∃ k : ℕ, k < n + 3 ∧ s ∈ brsBlock k := by
    -- the blocks `[3·2^{-k}, 6·2^{-k}]` for `k ≤ n+2` cover `[2^{-n}, 6]`
    by_contra hcon
    push Not at hcon
    have hmono : ∀ k : ℕ, k < n + 3 → s ∉ brsBlock k := by
      intro k hk
      exact hcon k hk
    -- descend from the top block to a contradiction
    have hstep : ∀ k : ℕ, k < n + 3 → s ≤ 6 * (2 : ℝ) ^ (-(k : ℤ)) →
        s < 3 * (2 : ℝ) ^ (-(k : ℤ)) := by
      intro k hk hle
      by_contra hgt
      push Not at hgt
      exact hmono k hk ⟨hgt, hle⟩
    have hall : ∀ k : ℕ, k < n + 3 → s < 3 * (2 : ℝ) ^ (-(k : ℤ)) := by
      intro k hk
      induction k with
      | zero =>
          refine hstep 0 hk ?_
          simpa using hs2
      | succ j ih =>
          refine hstep (j + 1) hk ?_
          have hj : j < n + 3 := by omega
          have hprev := ih hj
          have hid : 3 * (2 : ℝ) ^ (-(j : ℤ)) = 6 * (2 : ℝ) ^ (-((j : ℤ) + 1)) := by
            rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
            norm_num
            ring
          have hcast : ((j + 1 : ℕ) : ℤ) = (j : ℤ) + 1 := by push_cast; ring
          rw [hcast, ← hid]
          exact hprev.le
    have hlast := hall (n + 2) (by omega)
    have hid2 : 3 * (2 : ℝ) ^ (-((n + 2 : ℕ) : ℤ)) ≤ (2 : ℝ) ^ (-(n : ℤ)) := by
      have hcast : ((n + 2 : ℕ) : ℤ) = (n : ℤ) + 2 := by push_cast; ring
      have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(n : ℤ)) := by positivity
      have hsplit : (2 : ℝ) ^ (-((n : ℤ) + 2)) =
          (2 : ℝ) ^ (-(n : ℤ)) * (2 : ℝ) ^ (-2 : ℤ) := by
        rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      have h4 : (2 : ℝ) ^ (-2 : ℤ) = 1 / 4 := by norm_num
      rw [hcast, hsplit, h4]
      linarith
    linarith [hs1, hlast, hid2]
  obtain ⟨k, hk, hmem⟩ := hexists
  exact Set.mem_biUnion (Finset.mem_range.mpr hk) hmem

/-- The weight `s^e` is comparable to `(2^{-k})^e` on the block. -/
theorem rpow_le_on_brsBlock {e : ℝ} {k : ℕ} {s : ℝ} (hs : s ∈ brsBlock k) :
    s ^ e ≤ max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * ((2 : ℝ) ^ (-(k : ℤ))) ^ e := by
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  have hspos : 0 < s := brsBlock_pos hs
  set u : ℝ := s / (2 : ℝ) ^ (-(k : ℤ)) with hu
  have hu3 : 3 ≤ u := by
    rw [hu, le_div_iff₀ hpow]
    exact hs.1
  have hu6 : u ≤ 6 := by
    rw [hu, div_le_iff₀ hpow]
    exact hs.2
  have hupos : 0 < u := by linarith
  have hsu : s = u * (2 : ℝ) ^ (-(k : ℤ)) := by
    rw [hu]
    field_simp
  have hue : u ^ e ≤ max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) := by
    by_cases he : 0 ≤ e
    · refine le_trans (Real.rpow_le_rpow (by linarith) hu6 he) (le_max_right _ _)
    · push Not at he
      refine le_trans (Real.rpow_le_rpow_of_nonpos (by norm_num) hu3 he.le)
        (le_max_left _ _)
  rw [hsu, Real.mul_rpow hupos.le hpow.le]
  exact mul_le_mul_of_nonneg_right hue (Real.rpow_nonneg hpow.le _)

/-- **The per-block Hölder bound.**  On the block `[3·2^{-k}, 6·2^{-k}]` the
weighted integral is controlled by the local `L^p` norm of `g`. -/
theorem lintegral_brsBlock_le {e p : ℝ} (hp : 1 ≤ p) {g : ℝ → ℂ}
    (hg : Measurable g) (k : ℕ) :
    (∫⁻ s in brsBlock k, ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) *
          ((2 : ℝ) ^ (-(k : ℤ))) ^ e *
          (3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p)) *
        (∫⁻ s in brsBlock k, (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  set A : ℝ := max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * ((2 : ℝ) ^ (-(k : ℤ))) ^ e with hA
  have hApos : 0 < A := by
    rw [hA]
    have h3 : (0 : ℝ) < (3 : ℝ) ^ e := Real.rpow_pos_of_pos (by norm_num) _
    have h6 : (0 : ℝ) < (6 : ℝ) ^ e := Real.rpow_pos_of_pos (by norm_num) _
    have hmax : 0 < max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) := lt_max_of_lt_left h3
    positivity
  -- replace the weight by its maximum on the block
  have hstep1 : (∫⁻ s in brsBlock k,
      ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal A * ∫⁻ s in brsBlock k, ENNReal.ofReal ‖g s‖ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' (by
      rw [brsBlock]
      exact measurableSet_Icc) ?_
    intro s hs
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    rw [hA]
    exact rpow_le_on_brsBlock hs
  -- Hölder against the constant function on the block
  have hstep2 : (∫⁻ s in brsBlock k, ENNReal.ofReal ‖g s‖) ≤
      (∫⁻ s in brsBlock k, (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) *
        ENNReal.ofReal ((3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p)) := by
    have hvol : (volume.restrict (brsBlock k)) univ =
        ENNReal.ofReal (3 * (2 : ℝ) ^ (-(k : ℤ))) := by
      rw [Measure.restrict_apply_univ, volume_brsBlock]
    have h := lintegral_le_rpow_mul_measure_univ
      (μ := volume.restrict (brsBlock k))
      (Φ := fun s => ENNReal.ofReal ‖g s‖) hg.norm.ennreal_ofReal hp
    rw [hvol] at h
    refine le_trans h ?_
    refine mul_le_mul' le_rfl (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by
      have h1p : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp
      linarith)]
  calc (∫⁻ s in brsBlock k, ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖)
      ≤ ENNReal.ofReal A * ∫⁻ s in brsBlock k, ENNReal.ofReal ‖g s‖ := hstep1
    _ ≤ ENNReal.ofReal A *
          ((∫⁻ s in brsBlock k, (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) *
            ENNReal.ofReal ((3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl hstep2
    _ = ENNReal.ofReal (A * (3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p)) *
          (∫⁻ s in brsBlock k, (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
        rw [ENNReal.ofReal_mul hApos.le]
        ring

/-- The local `L^p` norm of the profile on the dyadic block `k`. -/
def brsBlockNorm (p : ℝ) (g : ℝ → ℂ) (k : ℕ) : ENNReal :=
  (∫⁻ s in brsBlock k, (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)

/-- The constant produced by the per-block Hölder bound. -/
def blockConst (e p : ℝ) (k : ℕ) : ℝ :=
  max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * ((2 : ℝ) ^ (-(k : ℤ))) ^ e *
    (3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p)

theorem blockConst_pos {e p : ℝ} (hp : 1 ≤ p) (k : ℕ) : 0 < blockConst e p k := by
  have h3 : (0 : ℝ) < (3 : ℝ) ^ e := Real.rpow_pos_of_pos (by norm_num) _
  have hmax : 0 < max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) := lt_max_of_lt_left h3
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  rw [blockConst]
  positivity

/-- The weight attached to the block `k` in the window on the shell `D_n`:
blocks beyond `n + 2` do not meet the window. -/
def brsWindowWeight (e p : ℝ) (n k : ℕ) : ENNReal :=
  if k < n + 3 then ENNReal.ofReal (blockConst e p k) else 0

/-- Blocks beyond `n + 2` lie strictly below the window on `D_n`. -/
theorem brsBlock_disjoint_window {n k : ℕ} (hk : n + 3 ≤ k) :
    brsBlock k ∩ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 = ∅ := by
  refine Set.eq_empty_iff_forall_notMem.mpr fun s hs => ?_
  obtain ⟨hsblock, hswindow⟩ := hs
  have hup : s ≤ 6 * (2 : ℝ) ^ (-(k : ℤ)) := hsblock.2
  have hlow : (2 : ℝ) ^ (-(n : ℤ)) ≤ s := hswindow.1
  have hkpow : (2 : ℝ) ^ (-(k : ℤ)) ≤ (2 : ℝ) ^ (-((n + 3 : ℕ) : ℤ)) := by
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    omega
  have hid : 6 * (2 : ℝ) ^ (-((n + 3 : ℕ) : ℤ)) < (2 : ℝ) ^ (-(n : ℤ)) := by
    have hcast : ((n + 3 : ℕ) : ℤ) = (n : ℤ) + 3 := by push_cast; ring
    have hsplit : (2 : ℝ) ^ (-((n : ℤ) + 3)) =
        (2 : ℝ) ^ (-(n : ℤ)) * (2 : ℝ) ^ (-3 : ℤ) := by
      rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    have h8 : (2 : ℝ) ^ (-3 : ℤ) = 1 / 8 := by norm_num
    have hpos : (0 : ℝ) < (2 : ℝ) ^ (-(n : ℤ)) := by positivity
    rw [hcast, hsplit, h8]
    linarith
  have hchain : s ≤ 6 * (2 : ℝ) ^ (-((n + 3 : ℕ) : ℤ)) := by
    refine le_trans hup ?_
    nlinarith [hkpow]
  linarith

/-- **Window to blocks.**  The window integral on the shell `D_n` is dominated
by the weighted sum of the local `L^p` norms over the blocks meeting it. -/
theorem lintegral_window_le_tsum_blocks {e p : ℝ} (hp : 1 ≤ p) {g : ℝ → ℂ}
    (hg : Measurable g) (n : ℕ) :
    (∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
        ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖) ≤
      ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k := by
  set F : ℝ → ENNReal := fun s => ENNReal.ofReal (s ^ e) * ENNReal.ofReal ‖g s‖
    with hF
  set A : ℕ → Set ℝ := fun k => if k < n + 3 then brsBlock k else ∅ with hA
  have hcover : Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 ⊆ ⋃ k : ℕ, A k := by
    intro s hs
    obtain ⟨k, hk, hmem⟩ : ∃ k : ℕ, k < n + 3 ∧ s ∈ brsBlock k := by
      have hcov := window_subset_iUnion_brsBlock n hs
      simp only [Set.mem_iUnion, Finset.mem_range, exists_prop] at hcov
      exact hcov
    refine Set.mem_iUnion.mpr ⟨k, ?_⟩
    rw [hA]
    simp only [if_pos hk]
    exact hmem
  have hterm : ∀ k : ℕ, (∫⁻ s in A k, F s) ≤
      brsWindowWeight e p n k * brsBlockNorm p g k := by
    intro k
    by_cases hk : k < n + 3
    · have hAk : A k = brsBlock k := by
        rw [hA]
        simp only [if_pos hk]
      rw [hAk, brsWindowWeight, if_pos hk, brsBlockNorm, blockConst, hF]
      exact lintegral_brsBlock_le hp hg k
    · have hAk : A k = ∅ := by
        rw [hA]
        simp only [if_neg hk]
      rw [hAk]
      simp
  calc (∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6, F s)
      ≤ ∫⁻ s in ⋃ k : ℕ, A k, F s := lintegral_mono_set hcover
    _ ≤ ∑' k : ℕ, ∫⁻ s in A k, F s := lintegral_iUnion_le _ _
    _ ≤ ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k :=
        ENNReal.tsum_le_tsum hterm

/-- A truncated geometric sum with ratio greater than one. -/
theorem sum_geom_le {x : ℝ} (hx : 1 < x) (m : ℕ) :
    ∑ k ∈ Finset.range m, x ^ k ≤ x ^ m / (x - 1) := by
  have hx1 : x ≠ 1 := ne_of_gt hx
  have hxpos : (0 : ℝ) < x - 1 := by linarith
  rw [geom_sum_eq hx1]
  gcongr
  linarith

/-- The constant of the per-block Hölder bound, with the `k`-dependence
factored out. -/
def blockConstBase (e p : ℝ) : ℝ :=
  max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * (3 : ℝ) ^ (1 - 1 / p)

theorem blockConstBase_pos (e p : ℝ) : 0 < blockConstBase e p := by
  have h3 : (0 : ℝ) < (3 : ℝ) ^ e := Real.rpow_pos_of_pos (by norm_num) _
  have hmax : 0 < max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) := lt_max_of_lt_left h3
  have h31 : (0 : ℝ) < (3 : ℝ) ^ (1 - 1 / p) := Real.rpow_pos_of_pos (by norm_num) _
  rw [blockConstBase]
  positivity

/-- The block constant is a geometric sequence with ratio `2^{-a}`, where
`a = e + 1 - 1/p` is the exponent that the shell estimate produces. -/
theorem blockConst_eq {e p a : ℝ} (hae : e + 1 - 1 / p = a) (k : ℕ) :
    blockConst e p k = blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ k := by
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  have hsplit : (3 * (2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p) =
      (3 : ℝ) ^ (1 - 1 / p) * ((2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p) :=
    Real.mul_rpow (by norm_num) hpow.le
  have hcombine : ((2 : ℝ) ^ (-(k : ℤ))) ^ e * ((2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p) =
      ((2 : ℝ) ^ (-(k : ℤ))) ^ a := by
    rw [← Real.rpow_add hpow]
    congr 1
    linarith [hae]
  have hzpow : ((2 : ℝ) ^ (-(k : ℤ))) ^ a = ((2 : ℝ) ^ (-a)) ^ k := by
    have h1 : (2 : ℝ) ^ (-(k : ℤ)) = (2 : ℝ) ^ (-(k : ℝ)) := by
      rw [← Real.rpow_intCast]
      push_cast
      ring_nf
    rw [h1, ← Real.rpow_mul (by norm_num), ← Real.rpow_natCast ((2 : ℝ) ^ (-a)) k,
      ← Real.rpow_mul (by norm_num)]
    congr 1
    ring
  rw [blockConst, blockConstBase, hsplit]
  calc max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * ((2 : ℝ) ^ (-(k : ℤ))) ^ e *
        ((3 : ℝ) ^ (1 - 1 / p) * ((2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p))
      = (max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * (3 : ℝ) ^ (1 - 1 / p)) *
          (((2 : ℝ) ^ (-(k : ℤ))) ^ e * ((2 : ℝ) ^ (-(k : ℤ))) ^ (1 - 1 / p)) := by
        ring
    _ = (max ((3 : ℝ) ^ e) ((6 : ℝ) ^ e) * (3 : ℝ) ^ (1 - 1 / p)) *
          ((2 : ℝ) ^ (-a)) ^ k := by
        rw [hcombine, hzpow]

/-- **The total weight of the blocks meeting the window on `D_n`.**  Since
`a < 0` the geometric sum is dominated by its largest term. -/
theorem tsum_brsWindowWeight_le {e p a : ℝ} (hp : 1 ≤ p)
    (hae : e + 1 - 1 / p = a) (ha : a < 0) (n : ℕ) :
    (∑' k : ℕ, brsWindowWeight e p n k) ≤
      ENNReal.ofReal (blockConstBase e p *
        (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) := by
  set x : ℝ := (2 : ℝ) ^ (-a) with hx
  have hx1 : 1 < x := by
    rw [hx]
    exact Real.one_lt_rpow_iff_of_pos (by norm_num) |>.mpr (Or.inl ⟨by norm_num, by linarith⟩)
  have hxpos : 0 < x := lt_trans zero_lt_one hx1
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  -- the sum is finite and equals a `Finset` sum
  have hvanish : ∀ k : ℕ, k ∉ Finset.range (n + 3) → brsWindowWeight e p n k = 0 := by
    intro k hk
    rw [Finset.mem_range] at hk
    rw [brsWindowWeight, if_neg hk]
  have hsum : (∑' k : ℕ, brsWindowWeight e p n k) =
      ∑ k ∈ Finset.range (n + 3), brsWindowWeight e p n k :=
    tsum_eq_sum hvanish
  rw [hsum]
  have hterm : ∀ k ∈ Finset.range (n + 3), brsWindowWeight e p n k =
      ENNReal.ofReal (blockConstBase e p * x ^ k) := by
    intro k hk
    rw [Finset.mem_range] at hk
    rw [brsWindowWeight, if_pos hk, blockConst_eq hae k, hx]
  rw [Finset.sum_congr rfl hterm]
  have hreal : ∑ k ∈ Finset.range (n + 3), ENNReal.ofReal (blockConstBase e p * x ^ k) =
      ENNReal.ofReal (∑ k ∈ Finset.range (n + 3), blockConstBase e p * x ^ k) := by
    rw [ENNReal.ofReal_sum_of_nonneg]
    intro k _
    positivity
  rw [hreal]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [← Finset.mul_sum]
  refine mul_le_mul_of_nonneg_left (sum_geom_le hx1 (n + 3)) hC0.le

/-- **Step 1 of Proposition 4.5.**  Composing the shell cutoff with the
window-to-blocks bound. -/
theorem brsMainMaximal_le_tsum_blocks {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (hp : 1 ≤ p) {g : ℝ → ℂ}
    (hg : Measurable g) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainMaximal d E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k := by
  refine le_trans (brsMainMaximal_le_on_brsD hd hE g hrD) ?_
  exact mul_le_mul' le_rfl (lintegral_window_le_tsum_blocks hp hg n)

/-- **Step 2 of Proposition 4.5.**  The `q`-th power of the shell bound, after
weighted Hölder in the block index. -/
theorem brsMainMaximal_rpow_le_on_brsD {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q a : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    {g : ℝ → ℂ} (hg : Measurable g) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainMaximal d E p g r ^ q ≤
      ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
          (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
            (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set c : ℕ → ENNReal := brsWindowWeight e p n with hc
  set G : ℕ → ENNReal := brsBlockNorm p g with hG
  set A : ℝ := (2 / 3 : ℝ) ^ (1 - (d : ℝ)) with hA
  have hApos : 0 < A := by
    rw [hA]
    exact Real.rpow_pos_of_pos (by norm_num) _
  -- the weighted Hölder inequality in the block index
  have hholder : (∑' k, c k * G k) ≤
      (∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q) :=
    tsum_weighted_le c G hq
  -- the total weight
  have hweight : (∑' k, c k) ≤
      ENNReal.ofReal (blockConstBase e p *
        (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) := by
    rw [hc, he]
    exact tsum_brsWindowWeight_le hp hae ha n
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  -- raise the shell bound to the `q`-th power
  have hstep := brsMainMaximal_le_tsum_blocks hd hE hp hg hrD
  rw [← he, ← hc, ← hG, ← hA] at hstep
  calc brsMainMaximal d E p g r ^ q
      ≤ (ENNReal.ofReal A * ∑' k, c k * G k) ^ q :=
        ENNReal.rpow_le_rpow hstep hq0.le
    _ = (ENNReal.ofReal A) ^ q * (∑' k, c k * G k) ^ q := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
    _ ≤ (ENNReal.ofReal A) ^ q *
          ((∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q)) ^ q := by
        refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hholder hq0.le)
    _ = (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * (∑' k, c k) ^ (q - 1)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
        congr 2
        field_simp
    _ ≤ (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * B ^ (q - 1)) := by
        refine mul_le_mul' le_rfl (mul_le_mul' le_rfl ?_)
        exact ENNReal.rpow_le_rpow hweight (by linarith)
    _ = ENNReal.ofReal (A ^ q) * B ^ (q - 1) * ∑' k, c k * G k ^ q := by
        rw [ENNReal.ofReal_rpow_of_nonneg hApos.le hq0.le]
        ring

/-- Every point of the first neighbourhood is at most `5`. -/
theorem le_five_of_mem_brsU_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {r : ℝ} (hr : r ∈ brsU E 0) : r ≤ 5 := by
  have hdist : Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) := hr
  have hdist' : Metric.infDist r E ≤ 2 := by
    simpa using hdist
  obtain ⟨t, htE, hrt⟩ := (Metric.infDist_lt_iff hEne).mp
    (lt_of_le_of_lt hdist' (by norm_num : (2 : ℝ) < 3))
  have ht2 : t ≤ 2 := (hE htE).2
  rw [Real.dist_eq, abs_lt] at hrt
  linarith [hrt.2]

/-- The radial weight is bounded on the neighbourhood of `E`. -/
theorem weight_le_of_mem_brsU_zero {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {r : ℝ} (hr : r ∈ brsU E 0) :
    ENNReal.ofReal r ^ (d - 1) ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) := by
  have hr5 : r ≤ 5 := le_five_of_mem_brsU_zero hE hEne hr
  by_cases hr0 : 0 ≤ r
  · rw [← ENNReal.ofReal_pow hr0]
    exact ENNReal.ofReal_le_ofReal (pow_le_pow_left₀ hr0 hr5 _)
  · push Not at hr0
    rw [ENNReal.ofReal_eq_zero.mpr hr0.le]
    by_cases hd1 : d - 1 = 0
    · rw [hd1, pow_zero, pow_zero]
      simp
    · rw [zero_pow hd1]
      simp

/-- **Step 3 of Proposition 4.5.**  Integrating the shell bound over `D_n`. -/
theorem lintegral_brsD_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q a : ℝ} (hp : 1 ≤ p)
    (hq : 1 ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) {g : ℝ → ℂ} (hg : Measurable g) (n : ℕ) :
    (∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
            (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
              (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
            ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
              brsBlockNorm p g k ^ q) *
        volume (brsU E n) := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
    (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) with hK
  have hpoint : ∀ r ∈ brsD E n,
      ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 := brsU_subset_of_le E (Nat.zero_le n) hr.1
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    have hmax : brsMainMaximal d E p g r ^ q ≤
        ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T := by
      rw [hB, hT, he]
      exact brsMainMaximal_rpow_le_on_brsD hd hE hp hq hae ha hg hr
    rw [hK]
    exact mul_le_mul' hweight hmax
  calc (∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q)
      ≤ ∫⁻ _r in brsD E n, K :=
        setLIntegral_mono' (measurableSet_brsD E n) hpoint
    _ = K * volume (brsD E n) := setLIntegral_const _ _
    _ ≤ K * volume (brsU E n) := by
        refine mul_le_mul' le_rfl (measure_mono ?_)
        exact fun r hr => hr.1
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) *
          volume (brsU E n) := by rw [hK]

/-- The main term vanishes off the first neighbourhood of `E`: an admissible
dilation `t` for the radius `r` is always within distance `2` of `r`. -/
theorem brsMainMaximal_eq_zero_of_notMem_brsU_zero {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {r : ℝ}
    (hr : r ∉ brsU E 0) : brsMainMaximal d E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  obtain ⟨htE, htlow, hthigh⟩ := ht
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have hclose : |r - t| < 2 := by
    rw [abs_lt]
    refine ⟨?_, ?_⟩
    · have hh : t < 3 * r / 2 := hthigh
      linarith
    · have hl : r / 2 < t := htlow
      linarith
  have hdist : Metric.infDist r E ≤ |r - t| := by
    have h : Metric.infDist r E ≤ dist r t :=
      Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  have hmem : r ∈ brsU E 0 := by
    show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ)
    have hcalc : (2 : ℝ) * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) = 2 := by norm_num
    rw [hcalc]
    linarith
  exact hr hmem

/-- **Step 4 of Proposition 4.5.**  The full radial integral is bounded by the
sum of the integrals over the shells; the leftover set lies in the closure of
`E`, which is null when `dim_M E < 1`. -/
theorem lintegral_le_tsum_brsD {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {p q : ℝ} (hq : 0 < q)
    (g : ℝ → ℂ) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ≤
      ∑' n : ℕ, ∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q := by
  set F : ℝ → ENNReal := fun r =>
    ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q with hF
  have hzero : ∀ r, r ∉ brsU E 0 → F r = 0 := by
    intro r hr
    rw [hF]
    simp only []
    rw [brsMainMaximal_eq_zero_of_notMem_brsU_zero hE g hr,
      ENNReal.zero_rpow_of_pos hq, mul_zero]
  have hcover : brsU E 0 ⊆ (⋃ n : ℕ, brsD E n) ∪ closure E := by
    intro r hr
    by_cases hmem : r ∈ ⋃ n : ℕ, brsD E n
    · exact Or.inl hmem
    · refine Or.inr ?_
      have hd0 := infDist_eq_zero_of_notMem_iUnion_brsD hr hmem
      rwa [← Metric.mem_closure_iff_infDist_zero hEne] at hd0
  calc (∫⁻ r, F r) = ∫⁻ r in brsU E 0, F r := by
        rw [← lintegral_indicator (measurableSet_brsU E 0)]
        refine lintegral_congr fun r => ?_
        by_cases hr : r ∈ brsU E 0
        · rw [Set.indicator_of_mem hr]
        · rw [Set.indicator_of_notMem hr, hzero r hr]
    _ ≤ ∫⁻ r in (⋃ n : ℕ, brsD E n) ∪ closure E, F r := lintegral_mono_set hcover
    _ ≤ (∫⁻ r in ⋃ n : ℕ, brsD E n, F r) + ∫⁻ r in closure E, F r :=
        lintegral_union_le _ _ _
    _ = ∫⁻ r in ⋃ n : ℕ, brsD E n, F r := by
        rw [setLIntegral_measure_zero _ _ hEnull, add_zero]
    _ ≤ ∑' n : ℕ, ∫⁻ r in brsD E n, F r := lintegral_iUnion_le _ _

/-- The half-open version of a dyadic block; these tile `(0, 6]`. -/
def brsBlockIoc (k : ℕ) : Set ℝ :=
  Ioc (3 * (2 : ℝ) ^ (-(k : ℤ))) (6 * (2 : ℝ) ^ (-(k : ℤ)))

theorem measurableSet_brsBlockIoc (k : ℕ) : MeasurableSet (brsBlockIoc k) := by
  rw [brsBlockIoc]
  exact measurableSet_Ioc

theorem brsBlockIoc_disjoint : Pairwise (Function.onFun Disjoint brsBlockIoc) := by
  intro m n hmn
  have hkey : ∀ i j : ℕ, i < j → Disjoint (brsBlockIoc i) (brsBlockIoc j) := by
    intro i j hij
    refine Set.disjoint_left.mpr fun s hsi hsj => ?_
    have hlow : 3 * (2 : ℝ) ^ (-(i : ℤ)) < s := hsi.1
    have hup : s ≤ 6 * (2 : ℝ) ^ (-(j : ℤ)) := hsj.2
    have hstep : (2 : ℝ) ^ (-(j : ℤ)) ≤ (2 : ℝ) ^ (-((i : ℤ) + 1)) := by
      refine zpow_le_zpow_right₀ (by norm_num) ?_
      omega
    have hid : 6 * (2 : ℝ) ^ (-((i : ℤ) + 1)) = 3 * (2 : ℝ) ^ (-(i : ℤ)) := by
      rw [neg_add, zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
      ring
    have hchain : s ≤ 3 * (2 : ℝ) ^ (-(i : ℤ)) := by
      refine le_trans hup ?_
      rw [← hid]
      nlinarith [hstep]
    linarith
  rcases lt_or_gt_of_ne hmn with h | h
  · exact hkey m n h
  · exact (hkey n m h).symm

theorem brsBlockIoc_subset_Ioi (k : ℕ) : brsBlockIoc k ⊆ Ioi (0 : ℝ) := by
  intro s hs
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℤ)) := by positivity
  have h := hs.1
  simp only [mem_Ioi]
  nlinarith [hpow]

/-- **The blocks recover the global `L^p` norm.**  The blocks overlap only in
endpoints, so the sum of the local `p`-th powers is at most the global one. -/
theorem tsum_brsBlockNorm_rpow_le {p : ℝ} (hp : 0 < p) (g : ℝ → ℂ) :
    (∑' k : ℕ, brsBlockNorm p g k ^ p) ≤
      ∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p := by
  have hterm : ∀ k : ℕ, brsBlockNorm p g k ^ p =
      ∫⁻ s in brsBlockIoc k, (ENNReal.ofReal ‖g s‖) ^ p := by
    intro k
    rw [brsBlockNorm, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne',
      ENNReal.rpow_one, brsBlock, brsBlockIoc]
    exact (setLIntegral_congr Ioc_ae_eq_Icc).symm
  rw [tsum_congr hterm,
    ← lintegral_iUnion (s := brsBlockIoc) measurableSet_brsBlockIoc
      brsBlockIoc_disjoint]
  refine lintegral_mono_set ?_
  exact Set.iUnion_subset brsBlockIoc_subset_Ioi

/-- Reindexing the tail `{n : m ≤ n}` of `ℕ`. -/
def tailEquiv (m : ℕ) : ({n : ℕ | m ≤ n} : Set ℕ) ≃ ℕ where
  toFun n := n.1 - m
  invFun j := ⟨j + m, by simp only [Set.mem_setOf_eq]; omega⟩
  left_inv := fun n => by
    obtain ⟨n, hn⟩ := n
    simp only [Set.mem_setOf_eq] at hn
    simp only [Subtype.mk.injEq]
    omega
  right_inv := fun j => by simp

/-- **The geometric tail sum.** -/
theorem tsum_geometric_tail (y : ENNReal) (m : ℕ) :
    (∑' n : ℕ, (if m ≤ n then y ^ n else 0)) = y ^ m * (1 - y)⁻¹ := by
  have hind : ∀ n : ℕ, (if m ≤ n then y ^ n else 0) =
      {n : ℕ | m ≤ n}.indicator (fun n => y ^ n) n := by
    intro n
    by_cases h : m ≤ n <;> simp [Set.indicator_apply, h]
  have hterm : ∀ j : ℕ, y ^ (j + m) = y ^ m * y ^ j := by
    intro j
    rw [pow_add]
    ring
  rw [tsum_congr hind, ← tsum_subtype]
  calc (∑' x : ({n : ℕ | m ≤ n} : Set ℕ), y ^ (x : ℕ))
      = ∑' x : ({n : ℕ | m ≤ n} : Set ℕ), y ^ ((tailEquiv m x) + m) := by
        refine tsum_congr fun x => ?_
        congr 1
        have hx : m ≤ (x : ℕ) := x.2
        simp only [tailEquiv, Equiv.coe_fn_mk]
        omega
    _ = ∑' j : ℕ, y ^ (j + m) :=
        (tailEquiv m).tsum_eq (fun j : ℕ => y ^ (j + m))
    _ = y ^ m * (1 - y)⁻¹ := by
        rw [tsum_congr hterm, ENNReal.tsum_mul_left, ENNReal.tsum_geometric]

/-- The shell weights, summed against the geometric factor `x^{-n}`, are
uniformly bounded in the block index. -/
theorem tsum_shell_weight_le {x : ℝ} (hx : 1 < x) (k : ℕ) :
    (∑' n : ℕ, (if k < n + 3 then (ENNReal.ofReal x⁻¹) ^ n else 0)) ≤
      ENNReal.ofReal (x ^ (2 : ℕ)) * (ENNReal.ofReal x⁻¹) ^ k *
        (1 - ENNReal.ofReal x⁻¹)⁻¹ := by
  set y : ENNReal := ENNReal.ofReal x⁻¹ with hy
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hcond : ∀ n : ℕ, (if k < n + 3 then y ^ n else 0) =
      (if k - 2 ≤ n then y ^ n else 0) := by
    intro n
    by_cases h : k < n + 3
    · rw [if_pos h, if_pos (by omega)]
    · rw [if_neg h, if_neg (by omega)]
  rw [tsum_congr hcond, tsum_geometric_tail]
  refine mul_le_mul' ?_ le_rfl
  rcases Nat.lt_or_ge k 2 with hk | hk
  · have hk0 : k - 2 = 0 := by omega
    rw [hk0, pow_zero]
    have hcalc : ENNReal.ofReal (x ^ (2 : ℕ)) * y ^ k =
        ENNReal.ofReal (x ^ (2 : ℕ) * (x⁻¹) ^ k) := by
      rw [hy, ← ENNReal.ofReal_pow (by positivity),
        ← ENNReal.ofReal_mul (by positivity)]
    rw [hcalc, ENNReal.one_le_ofReal, inv_pow, ← div_eq_mul_inv,
      le_div_iff₀ (by positivity : (0 : ℝ) < x ^ k), one_mul]
    exact pow_le_pow_right₀ hx.le (by omega)
  · have hsplit : y ^ k = y ^ (k - 2) * y ^ 2 := by
      rw [← pow_add]
      congr 1
      omega
    have hyx : ENNReal.ofReal (x ^ (2 : ℕ)) * y ^ 2 = 1 := by
      rw [hy, ← ENNReal.ofReal_pow (by positivity),
        ← ENNReal.ofReal_mul (by positivity)]
      rw [show x ^ (2 : ℕ) * (x⁻¹) ^ (2 : ℕ) = 1 by field_simp]
      exact ENNReal.ofReal_one
    rw [hsplit]
    calc y ^ (k - 2) = y ^ (k - 2) * 1 := (mul_one _).symm
      _ = y ^ (k - 2) * (ENNReal.ofReal (x ^ (2 : ℕ)) * y ^ 2) := by rw [hyx]
      _ = ENNReal.ofReal (x ^ (2 : ℕ)) * (y ^ (k - 2) * y ^ 2) := by ring
      _ ≤ _ := le_rfl

theorem one_lt_two_rpow_neg {a : ℝ} (ha : a < 0) : 1 < (2 : ℝ) ^ (-a) := by
  refine Real.one_lt_rpow_iff_of_pos (by norm_num) |>.mpr (Or.inl ⟨by norm_num, ?_⟩)
  linarith

/-- The weight of a single block, summed over the shells that see it, is
bounded uniformly in the block index. -/
theorem tsum_shell_single_block_le {e p a : ℝ} (hae : e + 1 - 1 / p = a)
    (ha : a < 0) (k : ℕ) :
    (∑' n : ℕ, (ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹) ^ n * brsWindowWeight e p n k) ≤
      ENNReal.ofReal (blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ (2 : ℕ)) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹)⁻¹ := by
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  have hterm : ∀ n : ℕ, (ENNReal.ofReal x⁻¹) ^ n * brsWindowWeight e p n k =
      ENNReal.ofReal (blockConstBase e p * x ^ k) *
        (if k < n + 3 then (ENNReal.ofReal x⁻¹) ^ n else 0) := by
    intro n
    by_cases hn : k < n + 3
    · rw [brsWindowWeight, if_pos hn, if_pos hn, blockConst_eq hae, hxdef, mul_comm]
    · rw [brsWindowWeight, if_neg hn, if_neg hn, mul_zero, mul_zero]
  rw [tsum_congr hterm, ENNReal.tsum_mul_left]
  refine le_trans (mul_le_mul' le_rfl (tsum_shell_weight_le hx k)) ?_
  have hpow : (ENNReal.ofReal x⁻¹) ^ k = ENNReal.ofReal ((x⁻¹) ^ k) :=
    (ENNReal.ofReal_pow (by positivity) k).symm
  have hprod : ENNReal.ofReal (blockConstBase e p * x ^ k) *
      (ENNReal.ofReal (x ^ (2 : ℕ)) * ENNReal.ofReal ((x⁻¹) ^ k)) =
      ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) := by
    rw [← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (mul_nonneg hC0.le (by positivity))]
    congr 1
    rw [show blockConstBase e p * x ^ k * (x ^ (2 : ℕ) * (x⁻¹) ^ k) =
        blockConstBase e p * x ^ (2 : ℕ) * (x ^ k * (x⁻¹) ^ k) by ring,
      show x ^ k * (x⁻¹) ^ k = 1 by
        rw [← mul_pow, mul_inv_cancel₀ hxpos.ne', one_pow],
      mul_one]
  have hcollect : ENNReal.ofReal (blockConstBase e p * x ^ k) *
      (ENNReal.ofReal (x ^ (2 : ℕ)) * (ENNReal.ofReal x⁻¹) ^ k *
        (1 - ENNReal.ofReal x⁻¹)⁻¹) =
      ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
        (1 - ENNReal.ofReal x⁻¹)⁻¹ := by
    calc ENNReal.ofReal (blockConstBase e p * x ^ k) *
          (ENNReal.ofReal (x ^ (2 : ℕ)) * (ENNReal.ofReal x⁻¹) ^ k *
            (1 - ENNReal.ofReal x⁻¹)⁻¹)
        = (ENNReal.ofReal (blockConstBase e p * x ^ k) *
            (ENNReal.ofReal (x ^ (2 : ℕ)) * ENNReal.ofReal ((x⁻¹) ^ k))) *
            (1 - ENNReal.ofReal x⁻¹)⁻¹ := by
          rw [hpow]
          ring
      _ = ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
            (1 - ENNReal.ofReal x⁻¹)⁻¹ := by rw [hprod]
  calc ENNReal.ofReal (blockConstBase e p * x ^ k) *
        (ENNReal.ofReal (x ^ (2 : ℕ)) * (ENNReal.ofReal x⁻¹) ^ k *
          (1 - ENNReal.ofReal x⁻¹)⁻¹)
      = ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
          (1 - ENNReal.ofReal x⁻¹)⁻¹ := hcollect
    _ ≤ _ := le_rfl

/-- **The double sum over shells and blocks.** -/
theorem tsum_shell_block_le {e p a q : ℝ} (hae : e + 1 - 1 / p = a) (ha : a < 0)
    (g : ℝ → ℂ) :
    (∑' n : ℕ, (ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹) ^ n *
        ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q) ≤
      ENNReal.ofReal (blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ (2 : ℕ)) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹)⁻¹ *
        ∑' k : ℕ, brsBlockNorm p g k ^ q := by
  set y : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹ with hy
  set M : ENNReal := ENNReal.ofReal (blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ (2 : ℕ)) *
    (1 - ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹)⁻¹ with hM
  calc (∑' n : ℕ, y ^ n * ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q)
      = ∑' n : ℕ, ∑' k : ℕ,
          y ^ n * (brsWindowWeight e p n k * brsBlockNorm p g k ^ q) := by
        refine tsum_congr fun n => ?_
        rw [ENNReal.tsum_mul_left]
    _ = ∑' k : ℕ, ∑' n : ℕ,
          y ^ n * (brsWindowWeight e p n k * brsBlockNorm p g k ^ q) :=
        ENNReal.tsum_comm
    _ = ∑' k : ℕ, (∑' n : ℕ, y ^ n * brsWindowWeight e p n k) *
          brsBlockNorm p g k ^ q := by
        refine tsum_congr fun k => ?_
        rw [← ENNReal.tsum_mul_right]
        refine tsum_congr fun n => ?_
        ring
    _ ≤ ∑' k : ℕ, M * brsBlockNorm p g k ^ q := by
        refine ENNReal.tsum_le_tsum fun k => ?_
        refine mul_le_mul' ?_ le_rfl
        rw [hM, hy]
        exact tsum_shell_single_block_le hae ha k
    _ = M * ∑' k : ℕ, brsBlockNorm p g k ^ q := ENNReal.tsum_mul_left

theorem two_zpow_eq_rpow (n : ℕ) : (2 : ℝ) ^ (-(n : ℤ)) = (2 : ℝ) ^ (-(n : ℝ)) := by
  rw [← Real.rpow_intCast]
  push_cast
  ring_nf

theorem two_rpow_pow (c : ℝ) (m : ℕ) : ((2 : ℝ) ^ c) ^ m = (2 : ℝ) ^ (c * m) := by
  rw [← Real.rpow_natCast ((2 : ℝ) ^ c) m, ← Real.rpow_mul (by norm_num)]

theorem two_rpow_rpow (c t : ℝ) : ((2 : ℝ) ^ c) ^ t = (2 : ℝ) ^ (c * t) :=
  (Real.rpow_mul (by norm_num) c t).symm

theorem two_rpow_inv_pow (c : ℝ) (n : ℕ) :
    (((2 : ℝ) ^ c)⁻¹) ^ n = (2 : ℝ) ^ (-c * n) := by
  rw [← Real.rpow_neg_one ((2 : ℝ) ^ c), two_rpow_rpow, two_rpow_pow]
  congr 1
  ring

/-- **The shell factor collapses.**  The `n`-dependence of the shell constant,
the radial volume and the covering bound cancel down to `x^{-n}`. -/
theorem shell_factor_identity {a q : ℝ} (n : ℕ) :
    (((2 : ℝ) ^ (-a)) ^ (n + 3)) ^ (q - 1) *
        ((2 : ℝ) ^ (-(n : ℤ)) * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) =
      ((2 : ℝ) ^ (-a)) ^ (3 * (q - 1)) * (((2 : ℝ) ^ (-a))⁻¹) ^ n := by
  rw [two_rpow_pow (-a) (n + 3), two_rpow_rpow, two_zpow_eq_rpow, two_rpow_rpow,
    two_rpow_rpow, two_rpow_inv_pow]
  simp only [← Real.rpow_add (show (0 : ℝ) < 2 by norm_num)]
  congr 1
  push_cast
  ring

/-! ## The per-shell estimate -/

section PerShell

open Auto.FractalDimensions

/-- The constant of the per-shell estimate in BRS Proposition 4.5. -/
def shellConst (d : ℕ) (p q a S : ℝ) : ℝ :=
  (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
    (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p /
      ((2 : ℝ) ^ (-a) - 1)) ^ (q - 1) * 7 * S ^ q *
    ((2 : ℝ) ^ (-a)) ^ (3 * (q - 1))

theorem shellConst_pos {d : ℕ} {p q a S : ℝ} (ha : a < 0) (hS : 0 < S) :
    0 < shellConst d p q a S := by
  have hx : 1 < (2 : ℝ) ^ (-a) := one_lt_two_rpow_neg ha
  have hC0 : 0 < blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p :=
    blockConstBase_pos _ _
  have h1 : (0 : ℝ) < ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q :=
    Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (by norm_num) _) _
  have h2 : (0 : ℝ) < (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p /
      ((2 : ℝ) ^ (-a) - 1)) ^ (q - 1) := by
    refine Real.rpow_pos_of_pos (div_pos hC0 ?_) _
    linarith
  have h3 : (0 : ℝ) < S ^ q := Real.rpow_pos_of_pos hS _
  have h4 : (0 : ℝ) < ((2 : ℝ) ^ (-a)) ^ (3 * (q - 1)) :=
    Real.rpow_pos_of_pos (Real.rpow_pos_of_pos (by norm_num) _) _
  rw [shellConst]
  positivity

/-- **The per-shell estimate of BRS Proposition 4.5.** -/
theorem lintegral_brsD_le_shell {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q a S : ℝ} (hp : 1 ≤ p)
    (hq : 1 ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} (hg : Measurable g) (n : ℕ) :
    (∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ≤
      ENNReal.ofReal (shellConst d p q a S) *
          (ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹) ^ n *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  have hA : (0 : ℝ) < (2 / 3 : ℝ) ^ (1 - (d : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  -- the volume of the shell neighbourhood
  have hvol : volume (brsU E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
        (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by
    refine le_trans (volume_brsU_le hE hEne n) ?_
    calc ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞)
        ≤ ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
            ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) :=
          mul_le_mul' le_rfl (hcov n)
      _ = ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) :=
          (ENNReal.ofReal_mul (by positivity)).symm
  -- the shell constant, with its `n`-dependence
  have hB : (ENNReal.ofReal (blockConstBase e p * (x ^ (n + 3) / (x - 1)))) ^ (q - 1) =
      ENNReal.ofReal ((blockConstBase e p / (x - 1)) ^ (q - 1) *
        (x ^ (n + 3)) ^ (q - 1)) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith)]
    congr 1
    rw [show blockConstBase e p * (x ^ (n + 3) / (x - 1)) =
        (blockConstBase e p / (x - 1)) * x ^ (n + 3) by ring,
      Real.mul_rpow (by positivity) (by positivity)]
  -- assemble
  have hstep := lintegral_brsD_le hd hE hEne hp hq hae ha hg n
  rw [← he, ← hT] at hstep
  refine le_trans hstep ?_
  rw [← hxdef, hB]
  refine le_trans (mul_le_mul' le_rfl hvol) (le_of_eq ?_)
  set A1 : ℝ := (5 : ℝ) ^ (d - 1) with hA1
  set A2 : ℝ := ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q with hA2
  set A3 : ℝ := (blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)
    with hA3
  set A4 : ℝ := 7 * (2 : ℝ) ^ (-(n : ℤ)) *
    (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) with hA4
  have h1 : 0 ≤ A1 := by rw [hA1]; positivity
  have h2 : 0 ≤ A2 := by
    rw [hA2]
    exact (Real.rpow_pos_of_pos hA _).le
  have h3 : 0 ≤ A3 := by
    rw [hA3]
    have hb1 : (0 : ℝ) < (blockConstBase e p / (x - 1)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (div_pos hC0 (by linarith)) _
    have hb2 : (0 : ℝ) < (x ^ (n + 3)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have h4 : 0 ≤ A4 := by
    rw [hA4]
    have hb1 : (0 : ℝ) < S ^ q := Real.rpow_pos_of_pos hS _
    have hb2 : (0 : ℝ) < ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have hfactor := shell_factor_identity (a := a) (q := q) n
  rw [← hxdef] at hfactor
  have hconst : A1 * A2 * A3 * A4 = shellConst d p q a S * (x⁻¹) ^ n := by
    rw [hA1, hA2, hA3, hA4, shellConst, ← he, ← hxdef]
    calc (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
          ((blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)) *
          (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
        = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            ((x ^ (n + 3)) ^ (q - 1) *
              ((2 : ℝ) ^ (-(n : ℤ)) *
                ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by ring
      _ = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            (x ^ (3 * (q - 1)) * (x⁻¹) ^ n) := by rw [hfactor]
      _ = (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q *
            x ^ (3 * (q - 1)) * (x⁻¹) ^ n := by ring
  calc ENNReal.ofReal A1 * (ENNReal.ofReal A2 * ENNReal.ofReal A3 * T) *
        ENNReal.ofReal A4
      = (ENNReal.ofReal A1 * ENNReal.ofReal A2 * ENNReal.ofReal A3 *
          ENNReal.ofReal A4) * T := by ring
    _ = ENNReal.ofReal (A1 * A2 * A3 * A4) * T := by
        rw [ENNReal.ofReal_mul (mul_nonneg (mul_nonneg h1 h2) h3),
          ENNReal.ofReal_mul (mul_nonneg h1 h2), ENNReal.ofReal_mul h1]
    _ = ENNReal.ofReal (shellConst d p q a S * (x⁻¹) ^ n) * T := by rw [hconst]
    _ = ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n * T := by
        rw [ENNReal.ofReal_mul (shellConst_pos (d := d) (p := p) (q := q) ha hS).le,
          ENNReal.ofReal_pow (by positivity)]

end PerShell

/-! ## Proposition 4.5 -/

section Prop45

open Auto.FractalDimensions

/-- The block-sum constant `M` of Proposition 4.5, as a real number. -/
theorem blockSumConst_eq {e p a : ℝ} (ha : a < 0) :
    ENNReal.ofReal (blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ (2 : ℕ)) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹)⁻¹ =
      ENNReal.ofReal (blockConstBase e p * ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) *
        (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹) := by
  have hx : 1 < (2 : ℝ) ^ (-a) := one_lt_two_rpow_neg ha
  have hxpos : (0 : ℝ) < (2 : ℝ) ^ (-a) := lt_trans zero_lt_one hx
  have hinv : ((2 : ℝ) ^ (-a))⁻¹ < 1 := by
    rw [inv_lt_one_iff₀]
    exact Or.inr hx
  have hsub : (0 : ℝ) < 1 - ((2 : ℝ) ^ (-a))⁻¹ := by linarith
  have hone : (1 : ENNReal) - ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹ =
      ENNReal.ofReal (1 - ((2 : ℝ) ^ (-a))⁻¹) := by
    rw [ENNReal.ofReal_sub _ (by positivity), ENNReal.ofReal_one]
  rw [hone, ← ENNReal.ofReal_inv_of_pos hsub, ← ENNReal.ofReal_mul (by
    have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
    positivity)]

/-- **BRS Proposition 4.5.**  For `1 ≤ p < p_d`, `p ≤ q < ∞` and a dilation set
whose dyadic covering numbers obey `N(E, 2^{-n}) ≤ S^q (2^{-n})^{-(qa+1)}`
with `a = d - 1 - d/p < 0`, the main term `𝔐_p` maps `L^p(ds)` into
`L^q(r^{d-1} dr)`. -/
theorem prop45_brsMainMaximal {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (hEnull : volume (closure E) = 0) {p q a S : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hpq : p ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hinv : x⁻¹ < 1 := by
    rw [inv_lt_one_iff₀]
    exact Or.inr hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  set Mreal : ℝ := blockConstBase e p * x ^ (2 : ℕ) * (1 - x⁻¹)⁻¹ with hMreal
  have hMpos : 0 < Mreal := by
    rw [hMreal]
    have hsub : (0 : ℝ) < 1 - x⁻¹ := by linarith
    positivity
  have hSC : 0 < shellConst d p q a S := shellConst_pos (d := d) (p := p) (q := q) ha hS
  refine ⟨(shellConst d p q a S * Mreal) ^ (1 / q), by positivity, ?_⟩
  intro g hg
  set G : ENNReal := (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) with hG
  -- the shells
  have hshell : ∀ n : ℕ, (∫⁻ r in brsD E n,
      ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n *
          ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
    intro n
    rw [he, hxdef]
    exact lintegral_brsD_le_shell hd hE hEne hp hq hae ha hS hcov hg n
  -- the block sums
  have hblocks : (∑' k : ℕ, brsBlockNorm p g k ^ q) ≤ G ^ q := by
    have h1 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤
        (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) :=
      tsum_rpow_le_tsum_rpow _ hp0 hpq
    have h2 : (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) ≤ G := by
      rw [hG]
      exact ENNReal.rpow_le_rpow (tsum_brsBlockNorm_rpow_le hp0 g) (by positivity)
    have h3 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤ G := le_trans h1 h2
    have h4 := ENNReal.rpow_le_rpow h3 hq0.le
    rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one] at h4
  -- chain everything
  have hmain : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsMainMaximal d E p g r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q)
        ≤ ∑' n : ℕ, ∫⁻ r in brsD E n,
            ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q :=
          lintegral_le_tsum_brsD hE hEne hEnull hq0 g
      _ ≤ ∑' n : ℕ, ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal x⁻¹) ^ n *
            ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q :=
          ENNReal.tsum_le_tsum hshell
      _ = ENNReal.ofReal (shellConst d p q a S) *
            ∑' n : ℕ, (ENNReal.ofReal x⁻¹) ^ n *
              ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
          rw [← ENNReal.tsum_mul_left]
          refine tsum_congr fun n => ?_
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
              (1 - ENNReal.ofReal x⁻¹)⁻¹ *
              ∑' k : ℕ, brsBlockNorm p g k ^ q) := by
          refine mul_le_mul' le_rfl ?_
          rw [hxdef]
          exact tsum_shell_block_le hae ha g
      _ = ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal *
            ∑' k : ℕ, brsBlockNorm p g k ^ q := by
          rw [hMreal, hxdef, ← blockSumConst_eq (e := e) (p := p) ha]
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal * G ^ q :=
          mul_le_mul' le_rfl hblocks
      _ = ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
          rw [ENNReal.ofReal_mul hSC.le]
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ENNReal.ofReal ((shellConst d p q a S * Mreal) ^ (1 / q)) * G := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]

end Prop45

/-! ## Logarithmic shells and blocks -/

section LogShells

open Auto.FractalDimensions

/-! ## The logarithmic shells and blocks of BRS Proposition 4.6

At the endpoint `p = p_d` the geometric gain of Proposition 4.5 disappears and
is replaced by a logarithm.  The shells are grouped dyadically in `n`, and the
profile variable is decomposed into doubly exponential blocks. -/

/-- The grouped shell `Ω_ℓ = ⋃_{2^{ℓ-1} ≤ n < 2^ℓ} D_n` of BRS §4. -/
def brsOmega (E : Set ℝ) (l : ℕ) : Set ℝ :=
  ⋃ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l), brsD E n

theorem measurableSet_brsOmega (E : Set ℝ) (l : ℕ) :
    MeasurableSet (brsOmega E l) := by
  rw [brsOmega]
  exact Finset.measurableSet_biUnion _ fun n _ => measurableSet_brsD E n

/-- The grouped shell sits inside the neighbourhood at its coarsest scale. -/
theorem brsOmega_subset_brsU {E : Set ℝ} {l : ℕ} (hl : 1 ≤ l) :
    brsOmega E l ⊆ brsU E (2 ^ (l - 1)) := by
  intro r hr
  rw [brsOmega] at hr
  obtain ⟨n, hn, hrn⟩ : ∃ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l), r ∈ brsD E n := by
    simpa only [Set.mem_iUnion, exists_prop] using hr
  rw [Finset.mem_Ico] at hn
  exact brsU_subset_of_le E hn.1 hrn.1

/-- **The measure of a grouped shell.** -/
theorem volume_brsOmega_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {l : ℕ} (hl : 1 ≤ l) :
    volume (brsOmega E l) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) := by
  refine le_trans (measure_mono (brsOmega_subset_brsU hl)) ?_
  have h := volume_brsU_le hE hEne (2 ^ (l - 1))
  have hcast : ((2 ^ (l - 1) : ℕ) : ℤ) = (2 ^ (l - 1) : ℤ) := by push_cast; ring
  rwa [hcast] at h

/-- The grouped shells are pairwise disjoint. -/
theorem brsOmega_disjoint (E : Set ℝ) {l l' : ℕ} (hl : 1 ≤ l) (hl' : 1 ≤ l')
    (hll : l ≠ l') : Disjoint (brsOmega E l) (brsOmega E l') := by
  refine Set.disjoint_left.mpr fun r hr hr' => ?_
  rw [brsOmega] at hr hr'
  obtain ⟨n, hn, hrn⟩ : ∃ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l), r ∈ brsD E n := by
    simpa only [Set.mem_iUnion, exists_prop] using hr
  obtain ⟨m, hm, hrm⟩ : ∃ m ∈ Finset.Ico (2 ^ (l' - 1)) (2 ^ l'), r ∈ brsD E m := by
    simpa only [Set.mem_iUnion, exists_prop] using hr'
  rw [Finset.mem_Ico] at hn hm
  have hnm : n ≠ m := by
    rcases lt_or_gt_of_ne hll with h | h
    · have h1 : l ≤ l' - 1 := by omega
      have h2 : (2 : ℕ) ^ l ≤ 2 ^ (l' - 1) :=
        Nat.pow_le_pow_right (by norm_num) h1
      omega
    · have h1 : l' ≤ l - 1 := by omega
      have h2 : (2 : ℕ) ^ l' ≤ 2 ^ (l - 1) :=
        Nat.pow_le_pow_right (by norm_num) h1
      omega
  exact (Set.disjoint_left.mp (brsD_disjoint E hnm)) hrn hrm

/-- The doubly exponential block `J_m = [2^{-2^{m+1}}, 2^{-2^m}]` of the
profile variable. -/
def brsLogBlock (m : ℕ) : Set ℝ :=
  Icc ((2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ))) ((2 : ℝ) ^ (-(2 ^ m : ℤ)))

theorem brsLogBlock_pos {m : ℕ} {s : ℝ} (hs : s ∈ brsLogBlock m) : 0 < s := by
  have h := hs.1
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) := by positivity
  linarith

/-- **The logarithmic length of a block.**  The measure `s^{-1} ds` gives every
block the same order of magnitude `2^m`. -/
theorem integral_inv_brsLogBlock (m : ℕ) :
    (∫ s in ((2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)))..((2 : ℝ) ^ (-(2 ^ m : ℤ))), s⁻¹) =
      (2 : ℝ) ^ m * Real.log 2 := by
  have hlow : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) := by positivity
  have hup : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ m : ℤ)) := by positivity
  rw [integral_inv_of_pos hlow hup]
  have hdiv : (2 : ℝ) ^ (-(2 ^ m : ℤ)) / (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) =
      (2 : ℝ) ^ ((2 ^ (m + 1) : ℤ) - (2 ^ m : ℤ)) := by
    rw [← zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
    congr 1
    ring
  rw [hdiv, Real.log_zpow]
  have hexp : ((2 ^ (m + 1) : ℤ) - (2 ^ m : ℤ)) = (2 ^ m : ℤ) := by
    have : (2 : ℤ) ^ (m + 1) = 2 * 2 ^ m := by ring
    rw [this]
    ring
  rw [hexp]
  push_cast
  ring

end LogShells

/-! ## BRS (4.8) -/

section Eq48

open Auto.FractalDimensions

/-- **BRS (4.8).**  With `B` the supremum of
`δ^{1/q} N(E,δ)^{1/q} (log 1/δ)^{1/d}`, the grouped shell `Ω_ℓ` has measure
`≲ B^q 2^{-ℓ q/d}`: the doubly exponential scale `δ_ℓ = 2^{-2^{ℓ-1}}` turns the
logarithmic factor into a power of `2^ℓ`. -/
theorem volume_brsOmega_le_of_cov {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {q B : ℝ} {d : ℕ} (hq : 0 < q) (hd : 2 ≤ d) (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ)))))
    {l : ℕ} (hl : 1 ≤ l) :
    volume (brsOmega E l) ≤
      ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
        ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ)))) := by
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hpow2 : (0 : ℝ) < ((2 : ℝ) ^ (l - 1)) := by positivity
  have hBq : (0 : ℝ) < B ^ q := Real.rpow_pos_of_pos hB _
  refine le_trans (volume_brsOmega_le hE hEne hl) ?_
  refine le_trans (mul_le_mul' le_rfl (hcov l hl)) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (by positivity)]
  congr 1
  -- the two doubly exponential powers cancel
  have hcancel : (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) = 1 := by
    rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hsplit : (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))) =
      ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ))) * (Real.log 2) ^ (-(q / (d : ℝ))) :=
    Real.mul_rpow hpow2.le hlog2.le
  calc 7 * (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) *
        (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))))
      = 7 * B ^ q * ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ))) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))) := by ring
    _ = 7 * B ^ q * (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))) := by
        rw [hcancel, mul_one]
    _ = 7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
          ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ))) := by
        rw [hsplit]
        ring

end Eq48

theorem measurableSet_brsLogBlock (m : ℕ) : MeasurableSet (brsLogBlock m) := by
  rw [brsLogBlock]
  exact measurableSet_Icc

/-- The `s^{-1}`-mass of a logarithmic block, as a `lintegral`. -/
theorem lintegral_inv_brsLogBlock (m : ℕ) :
    (∫⁻ s in brsLogBlock m, ENNReal.ofReal s⁻¹) =
      ENNReal.ofReal ((2 : ℝ) ^ m * Real.log 2) := by
  have hlow : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) := by positivity
  have hup : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ m : ℤ)) := by positivity
  have hle : (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) ≤ (2 : ℝ) ^ (-(2 ^ m : ℤ)) := by
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    have hpos : (0 : ℤ) < 2 ^ m := by positivity
    have h : (2 : ℤ) ^ (m + 1) = 2 * 2 ^ m := by ring
    omega
  have hint : IntegrableOn (fun s : ℝ => s⁻¹) (brsLogBlock m) volume := by
    rw [brsLogBlock]
    refine (ContinuousOn.integrableOn_Icc ?_)
    refine ContinuousOn.inv₀ continuousOn_id ?_
    intro s hs
    exact (lt_of_lt_of_le hlow hs.1).ne'
  have hval : ENNReal.ofReal (∫ s in brsLogBlock m, s⁻¹) =
      ∫⁻ s in brsLogBlock m, ENNReal.ofReal s⁻¹ := by
    refine ofReal_integral_eq_lintegral_ofReal hint ?_
    filter_upwards [self_mem_ae_restrict (measurableSet_brsLogBlock m)] with s hs
    have hspos : 0 < s := brsLogBlock_pos hs
    positivity
  rw [← hval]
  congr 1
  rw [brsLogBlock, MeasureTheory.integral_Icc_eq_integral_Ioc,
    ← intervalIntegral.integral_of_le hle]
  exact integral_inv_brsLogBlock m

/-- **The per-block Hölder bound at the endpoint `p = p_d`.**  Hölder with the
conjugate pair `(d, p_d)` turns the weight `s^{-1/d}` into the logarithmic
length of the block. -/
theorem lintegral_logBlock_le {d : ℕ} (hd : 2 ≤ d) {g : ℝ → ℂ}
    (hg : Measurable g) (m : ℕ) :
    (∫⁻ s in brsLogBlock m,
        ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((2 : ℝ) ^ m * Real.log 2) ^ (1 / (d : ℝ))) *
        (∫⁻ s in brsLogBlock m,
          (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
            (((d : ℝ) - 1) / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hd1lt : 1 < (d : ℝ) := by linarith
  -- the conjugate pair `(d, d/(d-1))`
  have hpq : (d : ℝ).HolderConjugate ((d : ℝ) / ((d : ℝ) - 1)) := by
    have h := Real.HolderConjugate.conjExponent hd1lt
    rwa [Real.conjExponent] at h
  have hmeas1 : Measurable fun s : ℝ => ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) := by
    fun_prop
  have hmeas2 : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (brsLogBlock m)) hpq hmeas1.aemeasurable hmeas2.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  -- identify the first factor with the logarithmic length
  have hweight : (∫⁻ s in brsLogBlock m,
      (ENNReal.ofReal (s ^ (-(1 / (d : ℝ))))) ^ (d : ℝ)) =
      ENNReal.ofReal ((2 : ℝ) ^ m * Real.log 2) := by
    rw [← lintegral_inv_brsLogBlock m]
    refine setLIntegral_congr_fun (measurableSet_brsLogBlock m) ?_
    intro s hs
    have hspos : 0 < s := brsLogBlock_pos hs
    simp only []
    rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hspos.le _) hdpos.le]
    congr 1
    rw [← Real.rpow_mul hspos.le,
      show -(1 / (d : ℝ)) * (d : ℝ) = -1 by field_simp, Real.rpow_neg_one]
  rw [hweight]
  refine mul_le_mul' (le_of_eq ?_) (le_of_eq ?_)
  · rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
  · congr 1
    field_simp

theorem two_zpow_pow_le {i j : ℕ} (hij : i ≤ j) :
    (2 : ℝ) ^ (-(2 ^ j : ℤ)) ≤ (2 : ℝ) ^ (-(2 ^ i : ℤ)) := by
  refine zpow_le_zpow_right₀ (by norm_num) ?_
  have h : (2 : ℤ) ^ i ≤ (2 : ℤ) ^ j := pow_le_pow_right₀ (by norm_num) hij
  omega

/-- **The logarithmic blocks tile `[2^{-2^ℓ}, 1/2]`.** -/
theorem logBlock_cover {l : ℕ} (hl : 1 ≤ l) :
    Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) (1 / 2 : ℝ) ⊆
      ⋃ m ∈ Finset.range l, brsLogBlock m := by
  intro s hs
  obtain ⟨hs1, hs2⟩ := hs
  by_contra hcon
  have hnot : ∀ m : ℕ, m < l → s ∉ brsLogBlock m := by
    intro m hm hmem
    exact hcon (Set.mem_biUnion (Finset.mem_range.mpr hm) hmem)
  -- descend through the blocks
  have hdesc : ∀ m : ℕ, m ≤ l → s ≤ (2 : ℝ) ^ (-(2 ^ m : ℤ)) := by
    intro m hm
    induction m with
    | zero =>
        have h1 : (2 : ℝ) ^ (-(2 ^ 0 : ℤ)) = 1 / 2 := by norm_num
        rw [h1]
        exact hs2
    | succ j ih =>
        have hjl : j < l := by omega
        have hprev := ih (by omega)
        by_contra hge
        push Not at hge
        exact hnot j hjl ⟨hge.le, hprev⟩
  have hfinal := hdesc l le_rfl
  have hseq : s = (2 : ℝ) ^ (-(2 ^ l : ℤ)) := le_antisymm hfinal hs1
  -- then `s` is the lower endpoint of the block `l - 1`
  refine hnot (l - 1) (by omega) ?_
  rw [brsLogBlock]
  have hl1 : l - 1 + 1 = l := by omega
  rw [hl1]
  exact ⟨le_of_eq hseq.symm, by
    rw [hseq]
    exact two_zpow_pow_le (by omega)⟩

/-- **The top piece.**  On `[1/2, 6]` the weight `s^{-1/d}` is bounded, so
Hölder against the constant function applies. -/
theorem lintegral_top_piece_le {d : ℕ} (hd : 2 ≤ d) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ s in Icc (1 / 2 : ℝ) 6,
        ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
          ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
        (∫⁻ s in Icc (1 / 2 : ℝ) 6,
          (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
            (((d : ℝ) - 1) / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd : (1 : ℝ) ≤ (d : ℝ) / ((d : ℝ) - 1) := by
    rw [le_div_iff₀ hd1]
    linarith
  -- the weight is bounded on the top piece
  have hweight : ∀ s ∈ Icc (1 / 2 : ℝ) 6,
      ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) ≤
        ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ))) := by
    intro s hs
    refine ENNReal.ofReal_le_ofReal ?_
    have hspos : (0 : ℝ) < s := by
      have := hs.1
      linarith
    have hnonpos : -(1 / (d : ℝ)) ≤ 0 := by
      simp only [neg_nonpos]
      positivity
    have hmono : s ^ (-(1 / (d : ℝ))) ≤ (1 / 2 : ℝ) ^ (-(1 / (d : ℝ))) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hs.1 hnonpos
    refine le_trans hmono (le_of_eq ?_)
    rw [show (1 / 2 : ℝ) = (2 : ℝ)⁻¹ by norm_num, ← Real.rpow_neg_one (2 : ℝ),
      ← Real.rpow_mul (by norm_num)]
    congr 1
    ring
  -- Hölder against the constant
  have hvol : (volume.restrict (Icc (1 / 2 : ℝ) 6)) univ =
      ENNReal.ofReal ((11 : ℝ) / 2) := by
    rw [Measure.restrict_apply_univ, Real.volume_Icc]
    congr 1
    norm_num
  have hholder := lintegral_le_rpow_mul_measure_univ
    (μ := volume.restrict (Icc (1 / 2 : ℝ) 6))
    (Φ := fun s => ENNReal.ofReal ‖g s‖) hg.norm.ennreal_ofReal hpd
  rw [hvol] at hholder
  set X : ENNReal := ∫⁻ s in Icc (1 / 2 : ℝ) 6,
    (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1)) with hX
  have hlast : ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ))) *
      (X ^ (1 / ((d : ℝ) / ((d : ℝ) - 1))) *
        ENNReal.ofReal ((11 : ℝ) / 2) ^ (1 - 1 / ((d : ℝ) / ((d : ℝ) - 1)))) =
      ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
        X ^ (((d : ℝ) - 1) / (d : ℝ)) := by
    have h1 : (1 : ℝ) / ((d : ℝ) / ((d : ℝ) - 1)) = ((d : ℝ) - 1) / (d : ℝ) :=
      one_div_div _ _
    have h2 : (1 : ℝ) - ((d : ℝ) - 1) / (d : ℝ) = 1 / (d : ℝ) := by
      field_simp
      ring
    rw [h1, h2,
      ENNReal.ofReal_rpow_of_nonneg (by norm_num : (0 : ℝ) ≤ 11 / 2) (by positivity),
      ENNReal.ofReal_mul
        (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ (1 / (d : ℝ)))]
    ring
  calc (∫⁻ s in Icc (1 / 2 : ℝ) 6,
        ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) * ENNReal.ofReal ‖g s‖)
      ≤ ∫⁻ s in Icc (1 / 2 : ℝ) 6,
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ))) * ENNReal.ofReal ‖g s‖ := by
        refine setLIntegral_mono' measurableSet_Icc ?_
        intro s hs
        exact mul_le_mul' (hweight s hs) le_rfl
    _ = ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ))) *
          ∫⁻ s in Icc (1 / 2 : ℝ) 6, ENNReal.ofReal ‖g s‖ :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ))) *
          (X ^ (1 / ((d : ℝ) / ((d : ℝ) - 1))) *
            ENNReal.ofReal ((11 : ℝ) / 2) ^ (1 - 1 / ((d : ℝ) / ((d : ℝ) - 1)))) := by
        refine mul_le_mul' le_rfl ?_
        rw [hX]
        exact hholder
    _ = ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
          X ^ (((d : ℝ) - 1) / (d : ℝ)) := hlast

/-- The local `L^{p_d}` norm of the profile on a logarithmic block. -/
def brsLogBlockNorm (d : ℕ) (g : ℝ → ℂ) (m : ℕ) : ENNReal :=
  (∫⁻ s in brsLogBlock m,
    (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^ (((d : ℝ) - 1) / (d : ℝ))

/-- The local `L^{p_d}` norm on the top piece `[1/2, 6]`. -/
def brsTopNorm (d : ℕ) (g : ℝ → ℂ) : ENNReal :=
  (∫⁻ s in Icc (1 / 2 : ℝ) 6,
    (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^ (((d : ℝ) - 1) / (d : ℝ))

/-- The weight attached to the logarithmic block `m` in the window of the
grouped shell `Ω_ℓ`. -/
def brsLogWeight (d : ℕ) (l m : ℕ) : ENNReal :=
  if m < l then ENNReal.ofReal (((2 : ℝ) ^ m * Real.log 2) ^ (1 / (d : ℝ))) else 0

/-- The endpoint exponent of the kernel weight: at `p = p_d` it is `-1/d`. -/
theorem brs_endpoint_exponent {d : ℕ} (hd : 2 ≤ d) :
    ((d : ℝ) - 1) * (1 - 1 / ((d : ℝ) / ((d : ℝ) - 1))) - 1 = -(1 / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  rw [one_div_div]
  field_simp
  ring

/-- **Window to blocks at the endpoint.**  The window of `𝔐_{p_d}` on the
grouped shell `Ω_ℓ` is covered by the logarithmic blocks `m < ℓ` together with
the top piece. -/
theorem lintegral_window_le_logBlocks {d : ℕ} (hd : 2 ≤ d) {g : ℝ → ℂ}
    (hg : Measurable g) {l : ℕ} (hl : 1 ≤ l) :
    (∫⁻ s in Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) 6,
        ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) * ENNReal.ofReal ‖g s‖) ≤
      (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
        ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
          brsTopNorm d g := by
  set F : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (s ^ (-(1 / (d : ℝ)))) * ENNReal.ofReal ‖g s‖ with hF
  set A : ℕ → Set ℝ := fun m => if m < l then brsLogBlock m else ∅ with hA
  -- the window splits into the blocks and the top piece
  have hcover : Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) 6 ⊆
      (⋃ m : ℕ, A m) ∪ Icc (1 / 2 : ℝ) 6 := by
    intro s hs
    by_cases htop : s ≤ 1 / 2
    · refine Or.inl ?_
      obtain ⟨m, hm, hmem⟩ : ∃ m : ℕ, m < l ∧ s ∈ brsLogBlock m := by
        have hcov := logBlock_cover hl ⟨hs.1, htop⟩
        simp only [Set.mem_iUnion, Finset.mem_range, exists_prop] at hcov
        exact hcov
      refine Set.mem_iUnion.mpr ⟨m, ?_⟩
      rw [hA]
      simp only [if_pos hm]
      exact hmem
    · push Not at htop
      exact Or.inr ⟨htop.le, hs.2⟩
  have hterm : ∀ m : ℕ, (∫⁻ s in A m, F s) ≤
      brsLogWeight d l m * brsLogBlockNorm d g m := by
    intro m
    by_cases hm : m < l
    · have hAm : A m = brsLogBlock m := by
        rw [hA]
        simp only [if_pos hm]
      rw [hAm, brsLogWeight, if_pos hm, brsLogBlockNorm, hF]
      exact lintegral_logBlock_le hd hg m
    · have hAm : A m = ∅ := by
        rw [hA]
        simp only [if_neg hm]
      rw [hAm]
      simp
  calc (∫⁻ s in Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) 6, F s)
      ≤ ∫⁻ s in (⋃ m : ℕ, A m) ∪ Icc (1 / 2 : ℝ) 6, F s := lintegral_mono_set hcover
    _ ≤ (∫⁻ s in ⋃ m : ℕ, A m, F s) + ∫⁻ s in Icc (1 / 2 : ℝ) 6, F s :=
        lintegral_union_le _ _ _
    _ ≤ (∑' m : ℕ, ∫⁻ s in A m, F s) + ∫⁻ s in Icc (1 / 2 : ℝ) 6, F s := by
        refine add_le_add ?_ le_rfl
        exact lintegral_iUnion_le _ _
    _ ≤ (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g := by
        refine add_le_add (ENNReal.tsum_le_tsum hterm) ?_
        rw [brsTopNorm, hF]
        exact lintegral_top_piece_le hd hg

/-- **The shell bound at the endpoint.**  On the grouped shell `Ω_ℓ` the main
term at `p = p_d` is bounded by the weighted sum over the logarithmic blocks
`m < ℓ` plus the top piece. -/
theorem brsMainMaximal_le_on_brsOmega {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ} (hg : Measurable g) {l : ℕ} (hl : 1 ≤ l)
    {r : ℝ} (hr : r ∈ brsOmega E l) :
    brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ((∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
            brsTopNorm d g) := by
  -- locate the shell containing `r`
  obtain ⟨n, hn, hrn⟩ : ∃ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l), r ∈ brsD E n := by
    rw [brsOmega] at hr
    simpa only [Set.mem_iUnion, exists_prop] using hr
  rw [Finset.mem_Ico] at hn
  -- the cutoff on the shell, with the endpoint exponent
  have hcut := brsMainMaximal_le_on_brsD (p := (d : ℝ) / ((d : ℝ) - 1)) hd hE g hrn
  rw [brs_endpoint_exponent hd] at hcut
  refine le_trans hcut ?_
  refine mul_le_mul' le_rfl ?_
  -- enlarge the window to the coarsest scale of the grouped shell
  have hwin : Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 ⊆ Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) 6 := by
    refine Icc_subset_Icc ?_ le_rfl
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    have hcast : ((n : ℤ)) ≤ ((2 ^ l : ℕ) : ℤ) := by
      exact_mod_cast le_of_lt hn.2
    push_cast at hcast
    omega
  refine le_trans (lintegral_mono_set hwin) ?_
  exact lintegral_window_le_logBlocks hd hg hl

/-- **Integration of the endpoint shell bound over `Ω_ℓ`.** -/
theorem lintegral_brsOmega_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q)
    {g : ℝ → ℂ} (hg : Measurable g) {l : ℕ} (hl : 1 ≤ l) :
    (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
            ((∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
              ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q *
        volume (brsOmega E l) := by
  set W : ENNReal := ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
    ((∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
      ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
        brsTopNorm d g) with hW
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q with hK
  have hpoint : ∀ r ∈ brsOmega E l,
      ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 :=
      brsU_subset_of_le E (Nat.zero_le (2 ^ (l - 1))) (brsOmega_subset_brsU hl hr)
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    have hmax : brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q ≤ W ^ q := by
      refine ENNReal.rpow_le_rpow ?_ hq.le
      rw [hW]
      exact brsMainMaximal_le_on_brsOmega hd hE hg hl hr
    rw [hK]
    exact mul_le_mul' hweight hmax
  calc (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q)
      ≤ ∫⁻ _r in brsOmega E l, K :=
        setLIntegral_mono' (measurableSet_brsOmega E l) hpoint
    _ = K * volume (brsOmega E l) := setLIntegral_const _ _
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * volume (brsOmega E l) := by
        rw [hK]

theorem one_lt_two_rpow_inv_d {d : ℕ} (hd : 2 ≤ d) : 1 < (2 : ℝ) ^ (1 / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  refine Real.one_lt_rpow_iff_of_pos (by norm_num) |>.mpr (Or.inl ⟨by norm_num, ?_⟩)
  positivity

/-- The block weight is a geometric sequence in `m` with ratio `2^{1/d}`. -/
theorem brsLogWeight_eq {d : ℕ} (hd : 2 ≤ d) {l m : ℕ} (hm : m < l) :
    brsLogWeight d l m =
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
        ((2 : ℝ) ^ (1 / (d : ℝ))) ^ m) := by
  have hlog2 : (0 : ℝ) ≤ Real.log 2 := Real.log_nonneg (by norm_num)
  rw [brsLogWeight, if_pos hm]
  congr 1
  rw [Real.mul_rpow (by positivity) hlog2, mul_comm]
  congr 1
  rw [← Real.rpow_natCast (2 : ℝ) m, ← Real.rpow_mul (by norm_num),
    ← Real.rpow_natCast ((2 : ℝ) ^ (1 / (d : ℝ))) m, ← Real.rpow_mul (by norm_num)]
  congr 1
  ring

/-- **The total block weight of a grouped shell.** -/
theorem tsum_brsLogWeight_le {d : ℕ} (hd : 2 ≤ d) (l : ℕ) :
    (∑' m : ℕ, brsLogWeight d l m) ≤
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
        (((2 : ℝ) ^ (1 / (d : ℝ))) ^ l / ((2 : ℝ) ^ (1 / (d : ℝ)) - 1))) := by
  set y : ℝ := (2 : ℝ) ^ (1 / (d : ℝ)) with hy
  have hy1 : 1 < y := by
    rw [hy]
    exact one_lt_two_rpow_inv_d hd
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlogd : (0 : ℝ) < (Real.log 2) ^ (1 / (d : ℝ)) :=
    Real.rpow_pos_of_pos hlog2 _
  have hvanish : ∀ m : ℕ, m ∉ Finset.range l → brsLogWeight d l m = 0 := by
    intro m hm
    rw [Finset.mem_range] at hm
    rw [brsLogWeight, if_neg hm]
  rw [tsum_eq_sum hvanish]
  have hterm : ∀ m ∈ Finset.range l, brsLogWeight d l m =
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) * y ^ m) := by
    intro m hm
    rw [Finset.mem_range] at hm
    rw [brsLogWeight_eq hd hm, hy]
  rw [Finset.sum_congr rfl hterm]
  rw [← ENNReal.ofReal_sum_of_nonneg (fun m _ => by positivity)]
  refine ENNReal.ofReal_le_ofReal ?_
  rw [← Finset.mul_sum]
  refine mul_le_mul_of_nonneg_left (sum_geom_le hy1 l) hlogd.le

/-- **The shell weights of a single block, summed over the shells that see
it.**  The geometric factor `2^{-ℓ/d}` makes the sum uniform in `m`. -/
theorem tsum_logShell_single_block_le {d : ℕ} (hd : 2 ≤ d) (m : ℕ) :
    (∑' l : ℕ, (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) ^ l *
        brsLogWeight d l m) ≤
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
          ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹ := by
  set y : ℝ := (2 : ℝ) ^ (1 / (d : ℝ)) with hy
  have hy1 : 1 < y := by
    rw [hy]
    exact one_lt_two_rpow_inv_d hd
  have hypos : 0 < y := lt_trans zero_lt_one hy1
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  have hlogd : (0 : ℝ) < (Real.log 2) ^ (1 / (d : ℝ)) :=
    Real.rpow_pos_of_pos hlog2 _
  set z : ENNReal := ENNReal.ofReal y⁻¹ with hz
  -- rewrite each term
  have hterm : ∀ l : ℕ, z ^ l * brsLogWeight d l m =
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) * y ^ m) *
        (if m + 1 ≤ l then z ^ l else 0) := by
    intro l
    by_cases hl : m < l
    · rw [brsLogWeight_eq hd hl, if_pos (by omega), hy, mul_comm]
    · have hl' : ¬ (m + 1 ≤ l) := by omega
      rw [brsLogWeight, if_neg hl, if_neg hl', mul_zero, mul_zero]
  rw [tsum_congr hterm, ENNReal.tsum_mul_left, tsum_geometric_tail]
  -- collect the constants
  have hzpow : z ^ (m + 1) = ENNReal.ofReal ((y⁻¹) ^ (m + 1)) := by
    rw [hz, ← ENNReal.ofReal_pow (by positivity)]
  rw [hzpow, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [show (y⁻¹) ^ (m + 1) = (y⁻¹) ^ m * y⁻¹ by rw [pow_succ]]
  rw [show (Real.log 2) ^ (1 / (d : ℝ)) * y ^ m * ((y⁻¹) ^ m * y⁻¹) =
      (Real.log 2) ^ (1 / (d : ℝ)) * y⁻¹ * (y ^ m * (y⁻¹) ^ m) by ring,
    show y ^ m * (y⁻¹) ^ m = 1 by
      rw [← mul_pow, mul_inv_cancel₀ hypos.ne', one_pow],
    mul_one]

/-- **The double sum over grouped shells and logarithmic blocks.** -/
theorem tsum_logShell_block_le {d : ℕ} (hd : 2 ≤ d) {q : ℝ} (g : ℝ → ℂ) :
    (∑' l : ℕ, (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) ^ l *
        ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q) ≤
      ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
          ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
          (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹ *
        ∑' m : ℕ, brsLogBlockNorm d g m ^ q := by
  set z : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ with hz
  set M : ENNReal := ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
    ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
    (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹ with hM
  calc (∑' l : ℕ, z ^ l *
        ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q)
      = ∑' l : ℕ, ∑' m : ℕ,
          z ^ l * (brsLogWeight d l m * brsLogBlockNorm d g m ^ q) := by
        refine tsum_congr fun l => ?_
        rw [ENNReal.tsum_mul_left]
    _ = ∑' m : ℕ, ∑' l : ℕ,
          z ^ l * (brsLogWeight d l m * brsLogBlockNorm d g m ^ q) :=
        ENNReal.tsum_comm
    _ = ∑' m : ℕ, (∑' l : ℕ, z ^ l * brsLogWeight d l m) *
          brsLogBlockNorm d g m ^ q := by
        refine tsum_congr fun m => ?_
        rw [← ENNReal.tsum_mul_right]
        refine tsum_congr fun l => ?_
        ring
    _ ≤ ∑' m : ℕ, M * brsLogBlockNorm d g m ^ q := by
        refine ENNReal.tsum_le_tsum fun m => ?_
        refine mul_le_mul' ?_ le_rfl
        rw [hM, hz]
        exact tsum_logShell_single_block_le hd m
    _ = M * ∑' m : ℕ, brsLogBlockNorm d g m ^ q := ENNReal.tsum_mul_left

/-- The half-open logarithmic block, so that the family tiles `(0, 1/2]`. -/
def brsLogBlockIoc (m : ℕ) : Set ℝ :=
  Ioc ((2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ))) ((2 : ℝ) ^ (-(2 ^ m : ℤ)))

theorem measurableSet_brsLogBlockIoc (m : ℕ) :
    MeasurableSet (brsLogBlockIoc m) := by
  rw [brsLogBlockIoc]
  exact measurableSet_Ioc

theorem brsLogBlockIoc_disjoint :
    Pairwise (Function.onFun Disjoint brsLogBlockIoc) := by
  intro i j hij
  have hkey : ∀ a b : ℕ, a < b → Disjoint (brsLogBlockIoc a) (brsLogBlockIoc b) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun s hsa hsb => ?_
    have hlow : (2 : ℝ) ^ (-(2 ^ (a + 1) : ℤ)) < s := hsa.1
    have hup : s ≤ (2 : ℝ) ^ (-(2 ^ b : ℤ)) := hsb.2
    have hstep : (2 : ℝ) ^ (-(2 ^ b : ℤ)) ≤ (2 : ℝ) ^ (-(2 ^ (a + 1) : ℤ)) :=
      two_zpow_pow_le (by omega)
    linarith
  rcases lt_or_gt_of_ne hij with h | h
  · exact hkey i j h
  · exact (hkey j i h).symm

theorem brsLogBlockIoc_subset_Ioi (m : ℕ) : brsLogBlockIoc m ⊆ Ioi (0 : ℝ) := by
  intro s hs
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ (m + 1) : ℤ)) := by positivity
  have h := hs.1
  simp only [mem_Ioi]
  linarith

/-- **The logarithmic blocks recover the global `L^{p_d}` norm.** -/
theorem tsum_brsLogBlockNorm_rpow_le {d : ℕ} (hd : 2 ≤ d) (g : ℝ → ℂ) :
    (∑' m : ℕ, brsLogBlockNorm d g m ^ ((d : ℝ) / ((d : ℝ) - 1))) ≤
      ∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd : (0 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := div_pos hdpos hd1
  have hterm : ∀ m : ℕ,
      brsLogBlockNorm d g m ^ ((d : ℝ) / ((d : ℝ) - 1)) =
        ∫⁻ s in brsLogBlockIoc m,
          (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1)) := by
    intro m
    rw [brsLogBlockNorm, ← ENNReal.rpow_mul,
      show ((d : ℝ) - 1) / (d : ℝ) * ((d : ℝ) / ((d : ℝ) - 1)) = 1 by field_simp,
      ENNReal.rpow_one, brsLogBlock, brsLogBlockIoc]
    exact (setLIntegral_congr Ioc_ae_eq_Icc).symm
  rw [tsum_congr hterm,
    ← lintegral_iUnion (s := brsLogBlockIoc) measurableSet_brsLogBlockIoc
      brsLogBlockIoc_disjoint]
  refine lintegral_mono_set ?_
  exact Set.iUnion_subset brsLogBlockIoc_subset_Ioi

/-- Splitting a `q`-th power of a sum. -/
theorem ennreal_rpow_add_le {X Y : ENNReal} {q : ℝ} (hq : 0 ≤ q) :
    (X + Y) ^ q ≤ 2 ^ q * (X ^ q + Y ^ q) := by
  have hmax : X + Y ≤ 2 * max X Y := by
    have h1 : X ≤ max X Y := le_max_left _ _
    have h2 : Y ≤ max X Y := le_max_right _ _
    calc X + Y ≤ max X Y + max X Y := add_le_add h1 h2
      _ = 2 * max X Y := by rw [two_mul]
  calc (X + Y) ^ q ≤ (2 * max X Y) ^ q := ENNReal.rpow_le_rpow hmax hq
    _ = 2 ^ q * (max X Y) ^ q := ENNReal.mul_rpow_of_nonneg _ _ hq
    _ ≤ 2 ^ q * (X ^ q + Y ^ q) := by
        refine mul_le_mul' le_rfl ?_
        rcases le_total X Y with h | h
        · rw [max_eq_right h]
          exact le_add_self
        · rw [max_eq_left h]
          exact le_self_add

/-- The zeroth grouped shell is empty. -/
theorem brsOmega_zero (E : Set ℝ) : brsOmega E 0 = ∅ := by
  rw [brsOmega]
  simp

/-- The grouped shells are pairwise disjoint, including the empty one. -/
theorem brsOmega_disjoint' (E : Set ℝ) {l l' : ℕ} (hll : l ≠ l') :
    Disjoint (brsOmega E l) (brsOmega E l') := by
  rcases Nat.eq_zero_or_pos l with hl | hl
  · rw [hl, brsOmega_zero]
    exact disjoint_bot_left
  rcases Nat.eq_zero_or_pos l' with hl' | hl'
  · rw [hl', brsOmega_zero]
    exact disjoint_bot_right
  exact brsOmega_disjoint E hl hl' hll

/-- The first neighbourhood is bounded. -/
theorem brsU_zero_subset {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) :
    brsU E 0 ⊆ Icc (-2 : ℝ) 5 := by
  intro r hr
  have hdist : Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) := hr
  have hdist' : Metric.infDist r E ≤ 2 := by simpa using hdist
  obtain ⟨t, htE, hrt⟩ := (Metric.infDist_lt_iff hEne).mp
    (lt_of_le_of_lt hdist' (by norm_num : (2 : ℝ) < 3))
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  rw [Real.dist_eq, abs_lt] at hrt
  exact ⟨by linarith [hrt.1], by linarith [hrt.2]⟩

theorem volume_brsU_zero_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) : volume (brsU E 0) ≤ ENNReal.ofReal 7 := by
  refine le_trans (measure_mono (brsU_zero_subset hE hEne)) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  norm_num

/-- **The total measure of the grouped shells.** -/
theorem tsum_volume_brsOmega_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) :
    (∑' l : ℕ, volume (brsOmega E l)) ≤ ENNReal.ofReal 7 := by
  have hdisj : Pairwise (Function.onFun Disjoint (brsOmega E)) := by
    intro l l' hll
    exact brsOmega_disjoint' E hll
  have hsub : (⋃ l : ℕ, brsOmega E l) ⊆ brsU E 0 := by
    refine Set.iUnion_subset fun l => ?_
    rcases Nat.eq_zero_or_pos l with hl | hl
    · rw [hl, brsOmega_zero]
      exact Set.empty_subset _
    · exact fun r hr =>
        brsU_subset_of_le E (Nat.zero_le (2 ^ (l - 1))) (brsOmega_subset_brsU hl hr)
  calc (∑' l : ℕ, volume (brsOmega E l))
      = volume (⋃ l : ℕ, brsOmega E l) :=
        (measure_iUnion hdisj (fun l => measurableSet_brsOmega E l)).symm
    _ ≤ volume (brsU E 0) := measure_mono hsub
    _ ≤ ENNReal.ofReal 7 := volume_brsU_zero_le hE hEne

/-- Every positive shell index lies in exactly one dyadic group. -/
theorem exists_grouped_shell {n : ℕ} (hn : 1 ≤ n) :
    ∃ l : ℕ, 1 ≤ l ∧ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l) := by
  classical
  have hex : ∃ l : ℕ, n < 2 ^ l := ⟨n, Nat.lt_two_pow_self⟩
  have hlt : n < 2 ^ Nat.find hex := Nat.find_spec hex
  have hl1 : 1 ≤ Nat.find hex := by
    rcases Nat.eq_zero_or_pos (Nat.find hex) with h | h
    · rw [h, pow_zero] at hlt
      omega
    · exact h
  have hmin : ¬ (n < 2 ^ (Nat.find hex - 1)) := Nat.find_min hex (by omega)
  exact ⟨Nat.find hex, hl1, Finset.mem_Ico.mpr ⟨by omega, hlt⟩⟩

/-- **Reduction to the zeroth shell and the grouped shells.** -/
theorem lintegral_le_brsD_zero_add_tsum_brsOmega {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q : ℝ} (hq : 0 < q) (g : ℝ → ℂ) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) ≤
      (∫⁻ r in brsD E 0,
          ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q) +
        ∑' l : ℕ, ∫⁻ r in brsOmega E l,
          ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q := by
  set F : ℝ → ENNReal := fun r =>
    ENNReal.ofReal r ^ (d - 1) * brsMainMaximal d E p g r ^ q with hF
  have hzero : ∀ r, r ∉ brsU E 0 → F r = 0 := by
    intro r hr
    rw [hF]
    simp only []
    rw [brsMainMaximal_eq_zero_of_notMem_brsU_zero hE g hr,
      ENNReal.zero_rpow_of_pos hq, mul_zero]
  have hcover : brsU E 0 ⊆ (brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l) ∪ closure E := by
    intro r hr
    by_cases hmem : r ∈ ⋃ n : ℕ, brsD E n
    · obtain ⟨n, hrn⟩ := Set.mem_iUnion.mp hmem
      refine Or.inl ?_
      rcases Nat.eq_zero_or_pos n with hn | hn
      · exact Or.inl (hn ▸ hrn)
      · obtain ⟨l, hl, hnl⟩ := exists_grouped_shell hn
        refine Or.inr (Set.mem_iUnion.mpr ⟨l, ?_⟩)
        rw [brsOmega]
        exact Set.mem_iUnion₂.mpr ⟨n, hnl, hrn⟩
    · refine Or.inr ?_
      have hd0 := infDist_eq_zero_of_notMem_iUnion_brsD hr hmem
      rwa [← Metric.mem_closure_iff_infDist_zero hEne] at hd0
  calc (∫⁻ r, F r) = ∫⁻ r in brsU E 0, F r := by
        rw [← lintegral_indicator (measurableSet_brsU E 0)]
        refine lintegral_congr fun r => ?_
        by_cases hr : r ∈ brsU E 0
        · rw [Set.indicator_of_mem hr]
        · rw [Set.indicator_of_notMem hr, hzero r hr]
    _ ≤ ∫⁻ r in (brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l) ∪ closure E, F r :=
        lintegral_mono_set hcover
    _ ≤ (∫⁻ r in brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l, F r) +
          ∫⁻ r in closure E, F r := lintegral_union_le _ _ _
    _ = ∫⁻ r in brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l, F r := by
        rw [setLIntegral_measure_zero _ _ hEnull, add_zero]
    _ ≤ (∫⁻ r in brsD E 0, F r) + ∫⁻ r in ⋃ l : ℕ, brsOmega E l, F r :=
        lintegral_union_le _ _ _
    _ ≤ (∫⁻ r in brsD E 0, F r) + ∑' l : ℕ, ∫⁻ r in brsOmega E l, F r :=
        add_le_add le_rfl (lintegral_iUnion_le _ _)

/-- On the zeroth shell the endpoint main term is controlled by the top
piece alone. -/
theorem brsMainMaximal_le_on_brsD_zero {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ}
    (hr : r ∈ brsD E 0) :
    brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
          brsTopNorm d g) := by
  have hcut := brsMainMaximal_le_on_brsD (p := (d : ℝ) / ((d : ℝ) - 1)) hd hE g hr
  rw [brs_endpoint_exponent hd] at hcut
  refine le_trans hcut ?_
  refine mul_le_mul' le_rfl ?_
  have hwin : Icc ((2 : ℝ) ^ (-(0 : ℕ) : ℤ)) 6 ⊆ Icc (1 / 2 : ℝ) 6 := by
    refine Icc_subset_Icc ?_ le_rfl
    norm_num
  refine le_trans (lintegral_mono_set hwin) ?_
  rw [brsTopNorm]
  exact lintegral_top_piece_le hd hg

/-- **The zeroth shell contributes a bounded multiple of the top norm.** -/
theorem lintegral_brsD_zero_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r in brsD E 0, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q *
        ENNReal.ofReal 7 := by
  set W : ENNReal := ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
    (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) * ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) *
      brsTopNorm d g) with hW
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q with hK
  have hpoint : ∀ r ∈ brsD E 0,
      ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 := hr.1
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    have hmax : brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q ≤ W ^ q := by
      refine ENNReal.rpow_le_rpow ?_ hq.le
      rw [hW]
      exact brsMainMaximal_le_on_brsD_zero hd hE hg hr
    rw [hK]
    exact mul_le_mul' hweight hmax
  calc (∫⁻ r in brsD E 0, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q)
      ≤ ∫⁻ _r in brsD E 0, K :=
        setLIntegral_mono' (measurableSet_brsD E 0) hpoint
    _ = K * volume (brsD E 0) := setLIntegral_const _ _
    _ ≤ K * ENNReal.ofReal 7 := by
        refine mul_le_mul' le_rfl ?_
        refine le_trans (measure_mono ?_) (volume_brsU_zero_le hE hEne)
        exact fun r hr => hr.1
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * ENNReal.ofReal 7 := by rw [hK]

section Prop46

open Auto.FractalDimensions

/-- **The endpoint shell factor collapses.**  The total block weight of the
shell, raised to the power `q - 1`, cancels against the measure bound for
`Ω_ℓ` down to the geometric factor `2^{-ℓ/d}`. -/
theorem logShell_factor_identity {d : ℕ} {q K : ℝ} (hK : 0 ≤ K) {l : ℕ}
    (hl : 1 ≤ l) :
    (K * ((2 : ℝ) ^ (1 / (d : ℝ))) ^ l) ^ (q - 1) *
        ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ))) =
      K ^ (q - 1) * ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q *
        (((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) ^ l := by
  have hcast : (((l - 1 : ℕ) : ℝ)) = (l : ℝ) - 1 := by
    have : (1 : ℕ) ≤ l := hl
    push_cast [Nat.cast_sub this]
    ring
  rw [Real.mul_rpow hK (by positivity), two_rpow_pow (1 / (d : ℝ)) l,
    two_rpow_rpow, two_rpow_rpow, two_rpow_inv_pow,
    ← Real.rpow_natCast (2 : ℝ) (l - 1), Real.rpow_natCast (2 : ℝ) (l - 1),
    ← Real.rpow_natCast (2 : ℝ) (l - 1), two_rpow_rpow]
  rw [show (K ^ (q - 1) * (2 : ℝ) ^ (1 / (d : ℝ) * ↑l * (q - 1))) *
      (2 : ℝ) ^ ((l - 1 : ℕ) * -(q / (d : ℝ))) =
      K ^ (q - 1) * ((2 : ℝ) ^ (1 / (d : ℝ) * ↑l * (q - 1)) *
        (2 : ℝ) ^ ((l - 1 : ℕ) * -(q / (d : ℝ)))) by ring,
    show K ^ (q - 1) * (2 : ℝ) ^ (1 / (d : ℝ) * q) *
        (2 : ℝ) ^ (-(1 / (d : ℝ)) * ↑l) =
      K ^ (q - 1) * ((2 : ℝ) ^ (1 / (d : ℝ) * q) *
        (2 : ℝ) ^ (-(1 / (d : ℝ)) * ↑l)) by ring]
  congr 1
  rw [← Real.rpow_add (by norm_num), ← Real.rpow_add (by norm_num), hcast]
  congr 1
  field_simp
  ring

/-- **The endpoint per-shell estimate.**  Weighted Hölder in the block index
turns the shell sum into a geometric factor times the `q`-th powers of the
block norms. -/
theorem logShell_term_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q B : ℝ} (hq : 1 ≤ q)
    (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ)))))
    (g : ℝ → ℂ) {l : ℕ} (hl : 1 ≤ l) :
    (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) ^ q *
        volume (brsOmega E l) ≤
      ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
          ((Real.log 2) ^ (1 / (d : ℝ)) / ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
          ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) ^ l *
        (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hq1 : (0 : ℝ) ≤ q - 1 := by linarith
  set y : ℝ := (2 : ℝ) ^ (1 / (d : ℝ)) with hy
  have hy1 : 1 < y := by
    rw [hy]
    exact one_lt_two_rpow_inv_d hd
  have hypos : (0 : ℝ) < y := lt_trans zero_lt_one hy1
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  set K : ℝ := (Real.log 2) ^ (1 / (d : ℝ)) / (y - 1) with hKdef
  have hKpos : (0 : ℝ) < K := by
    rw [hKdef]
    exact div_pos (Real.rpow_pos_of_pos hlog2 _) (by linarith)
  set G : ℕ → ENNReal := fun m => brsLogBlockNorm d g m with hG
  set w : ℕ → ENNReal := fun m => brsLogWeight d l m with hw
  -- weighted Hölder in the block index
  have hhol : (∑' m : ℕ, w m * G m) ^ q ≤
      (∑' m : ℕ, w m * G m ^ q) * (∑' m : ℕ, w m) ^ (q - 1) := by
    refine le_trans (ENNReal.rpow_le_rpow (tsum_weighted_le w G hq) hq0.le) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
    refine mul_le_mul' le_rfl (le_of_eq ?_)
    congr 1
    field_simp
  -- the total weight of the shell
  have hKy : (0 : ℝ) < K * y ^ l := mul_pos hKpos (pow_pos hypos l)
  have hweight : (∑' m : ℕ, w m) ^ (q - 1) ≤
      ENNReal.ofReal ((K * y ^ l) ^ (q - 1)) := by
    have hsum : (∑' m : ℕ, w m) ≤ ENNReal.ofReal (K * y ^ l) := by
      rw [hw]
      refine le_trans (tsum_brsLogWeight_le hd l) (le_of_eq ?_)
      congr 1
      rw [hKdef, hy]
      ring
    calc (∑' m : ℕ, w m) ^ (q - 1) ≤ (ENNReal.ofReal (K * y ^ l)) ^ (q - 1) :=
          ENNReal.rpow_le_rpow hsum hq1
      _ = ENNReal.ofReal ((K * y ^ l) ^ (q - 1)) :=
          ENNReal.ofReal_rpow_of_pos hKy
  -- the measure of the shell
  have hvol : volume (brsOmega E l) ≤
      ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
        ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ)))) :=
    volume_brsOmega_le_of_cov hE hEne hq0 hd hB hcov hl
  calc (∑' m : ℕ, w m * G m) ^ q * volume (brsOmega E l)
      ≤ ((∑' m : ℕ, w m * G m ^ q) * ENNReal.ofReal ((K * y ^ l) ^ (q - 1))) *
          ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
            ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ)))) :=
        mul_le_mul' (le_trans hhol (mul_le_mul' le_rfl hweight)) hvol
    _ = ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
              ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ)))) *
            ENNReal.ofReal ((K * y ^ l) ^ (q - 1)) *
          (∑' m : ℕ, w m * G m ^ q) := by ring
    _ = ENNReal.ofReal ((7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ)))) *
            ((K * y ^ l) ^ (q - 1) * ((2 : ℝ) ^ (l - 1)) ^ (-(q / (d : ℝ))))) *
          (∑' m : ℕ, w m * G m ^ q) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring
    _ = ENNReal.ofReal ((7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ)))) *
            (K ^ (q - 1) * y ^ q * (y⁻¹) ^ l)) *
          (∑' m : ℕ, w m * G m ^ q) := by
        rw [logShell_factor_identity (q := q) (K := K) hKpos.le hl]
    _ = ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
            K ^ (q - 1) * y ^ q) * ENNReal.ofReal ((y⁻¹) ^ l) *
          (∑' m : ℕ, w m * G m ^ q) := by
        rw [← ENNReal.ofReal_mul (by positivity)]
        congr 2
        ring
    _ = ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
            K ^ (q - 1) * y ^ q) * (ENNReal.ofReal y⁻¹) ^ l *
          (∑' m : ℕ, w m * G m ^ q) := by
        rw [ENNReal.ofReal_pow (by positivity)]

/-- The local norm on the top piece is dominated by the global one. -/
theorem brsTopNorm_le {d : ℕ} (hd : 2 ≤ d) (g : ℝ → ℂ) :
    brsTopNorm d g ≤
      (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
        (((d : ℝ) - 1) / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  rw [brsTopNorm]
  refine ENNReal.rpow_le_rpow (lintegral_mono_set ?_) (by positivity)
  intro s hs
  have h : (0 : ℝ) < s := lt_of_lt_of_le (by norm_num) hs.1
  exact h

/-- The `q`-th powers of the block norms sum to at most the `q`-th power of the
global `L^{p_d}` norm. -/
theorem tsum_brsLogBlockNorm_pow_le {d : ℕ} (hd : 2 ≤ d) {q : ℝ}
    (hpq : (d : ℝ) / ((d : ℝ) - 1) ≤ q) (g : ℝ → ℂ) :
    (∑' m : ℕ, brsLogBlockNorm d g m ^ q) ≤
      ((∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
        (((d : ℝ) - 1) / (d : ℝ))) ^ q := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd : (0 : ℝ) < (d : ℝ) / ((d : ℝ) - 1) := div_pos hdpos hd1
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hpd hpq
  have hinv : 1 / ((d : ℝ) / ((d : ℝ) - 1)) = ((d : ℝ) - 1) / (d : ℝ) := one_div_div _ _
  have h1 := tsum_rpow_le_tsum_rpow (brsLogBlockNorm d g) hpd hpq
  rw [hinv] at h1
  have h2 : (∑' m : ℕ, brsLogBlockNorm d g m ^ q) ^ (1 / q) ≤
      (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
        (((d : ℝ) - 1) / (d : ℝ)) := by
    refine le_trans h1 ?_
    exact ENNReal.rpow_le_rpow (tsum_brsLogBlockNorm_rpow_le hd g) (by positivity)
  calc (∑' m : ℕ, brsLogBlockNorm d g m ^ q)
      = ((∑' m : ℕ, brsLogBlockNorm d g m ^ q) ^ (1 / q)) ^ q := by
        rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
    _ ≤ _ := ENNReal.rpow_le_rpow h2 hq0.le

/-- **The grouped shells collected.** -/
theorem tsum_brsOmega_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q B : ℝ} (hq : 1 ≤ q)
    (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ)))))
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∑' l : ℕ, ∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
        (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
              ((Real.log 2) ^ (1 / (d : ℝ)) /
                ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
              ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
            (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
              (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
            (∑' m : ℕ, brsLogBlockNorm d g m ^ q) +
          ENNReal.ofReal 7 *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set A : ENNReal := ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) with hA
  set T : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
    ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g with hT
  set S : ℕ → ENNReal := fun l =>
    ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m with hS
  set D : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * A ^ q * 2 ^ q with hD
  set cst : ℝ := 7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
    ((Real.log 2) ^ (1 / (d : ℝ)) / ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
    ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q with hcst
  set M : ENNReal := ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
    ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹
    with hM
  set z : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ with hz
  -- the per-shell bound, split into the block sum and the top piece
  have hper : ∀ l : ℕ,
      (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ≤
        D * (S l ^ q * volume (brsOmega E l) + T ^ q * volume (brsOmega E l)) := by
    intro l
    rcases Nat.eq_zero_or_pos l with hl | hl
    · rw [hl, brsOmega_zero]
      simp
    · refine le_trans (lintegral_brsOmega_le hd hE hEne hq0 hg hl) ?_
      have h1 : (A * (S l + T)) ^ q ≤ A ^ q * (2 ^ q * (S l ^ q + T ^ q)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ennreal_rpow_add_le hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * (A * (S l + T)) ^ q *
            volume (brsOmega E l)
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              (A ^ q * (2 ^ q * (S l ^ q + T ^ q))) * volume (brsOmega E l) :=
            mul_le_mul' (mul_le_mul' le_rfl h1) le_rfl
        _ = D * (S l ^ q * volume (brsOmega E l) +
              T ^ q * volume (brsOmega E l)) := by
            rw [hD]
            ring
  refine le_trans (ENNReal.tsum_le_tsum hper) ?_
  rw [ENNReal.tsum_mul_left, hD]
  refine mul_le_mul' le_rfl ?_
  rw [ENNReal.tsum_add]
  refine add_le_add ?_ ?_
  · -- the block sums
    have hshell : ∀ l : ℕ, S l ^ q * volume (brsOmega E l) ≤
        ENNReal.ofReal cst *
          (z ^ l * (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q)) := by
      intro l
      rcases Nat.eq_zero_or_pos l with hl | hl
      · rw [hl, brsOmega_zero]
        simp
      · refine le_trans (logShell_term_le hd hE hEne hq hB hcov g hl) (le_of_eq ?_)
        rw [hcst, hz]
        ring
    refine le_trans (ENNReal.tsum_le_tsum hshell) ?_
    rw [ENNReal.tsum_mul_left]
    calc ENNReal.ofReal cst *
          (∑' l : ℕ, z ^ l *
            ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q)
        ≤ ENNReal.ofReal cst * (M * ∑' m : ℕ, brsLogBlockNorm d g m ^ q) := by
          refine mul_le_mul' le_rfl ?_
          rw [hz, hM]
          exact tsum_logShell_block_le hd g
      _ = ENNReal.ofReal cst * M * ∑' m : ℕ, brsLogBlockNorm d g m ^ q :=
          (mul_assoc _ _ _).symm
  · -- the top piece
    rw [ENNReal.tsum_mul_left]
    rw [mul_comm]
    exact mul_le_mul' (tsum_volume_brsOmega_le hE hEne) le_rfl

/-- **The endpoint bound with an explicit finite constant.** -/
theorem exists_endpoint_bound {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {q B : ℝ} (hpq : (d : ℝ) / ((d : ℝ) - 1) ≤ q) (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))))) :
    ∃ Λ : ENNReal, Λ ≠ ⊤ ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ≤
        Λ * ((∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
          (((d : ℝ) - 1) / (d : ℝ))) ^ q := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd1 : (1 : ℝ) ≤ (d : ℝ) / ((d : ℝ) - 1) := by
    rw [le_div_iff₀ hd1]
    linarith
  have hq : (1 : ℝ) ≤ q := le_trans hpd1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  refine ⟨ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
        (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q * ENNReal.ofReal 7 +
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
        (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
              ((Real.log 2) ^ (1 / (d : ℝ)) /
                ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
              ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
            (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
              (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) +
          ENNReal.ofReal 7 *
            ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q), ?_, ?_⟩
  · -- finiteness of the constant
    have hy1 : 1 < (2 : ℝ) ^ (1 / (d : ℝ)) := one_lt_two_rpow_inv_d hd
    have hypos : (0 : ℝ) < (2 : ℝ) ^ (1 / (d : ℝ)) := by positivity
    have hzlt : ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ < 1 := by
      rw [ENNReal.ofReal_lt_one]
      have h := (div_lt_one hypos).mpr hy1
      simpa [one_div] using h
    have hsub : (1 : ENNReal) - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ ≠ 0 := by
      intro h
      rw [tsub_eq_zero_iff_le] at h
      exact absurd hzlt (not_lt.mpr h)
    have hinv : ((1 : ENNReal) -
        ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹ ≠ ⊤ :=
      ENNReal.inv_ne_top.mpr hsub
    refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
    · refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_)
        ENNReal.ofReal_ne_top
      exact ENNReal.rpow_ne_top_of_nonneg hq0.le
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
    · refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
        ENNReal.ofReal_ne_top (ENNReal.rpow_ne_top_of_nonneg hq0.le
          ENNReal.ofReal_ne_top)) (ENNReal.rpow_ne_top_of_nonneg hq0.le
            (by simp))) ?_
      refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
      · exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
          (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hinv)
      · exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
          (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top)
  · intro g hg
    have hNtop : brsTopNorm d g ≤
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
          (((d : ℝ) - 1) / (d : ℝ)) := brsTopNorm_le hd g
    have hblocks := tsum_brsLogBlockNorm_pow_le hd hpq g
    refine le_trans (lintegral_le_brsD_zero_add_tsum_brsOmega hE hEne hEnull hq0 g) ?_
    rw [add_mul]
    refine add_le_add ?_ ?_
    · -- the zeroth shell
      refine le_trans (lintegral_brsD_zero_le hd hE hEne hq0 hg) ?_
      have hstep : (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q ≤
          (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
            ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q *
            ((∫⁻ s in Ioi (0 : ℝ),
              (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                (((d : ℝ) - 1) / (d : ℝ))) ^ q := by
        rw [← mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hNtop hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
            (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
              (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q *
            ENNReal.ofReal 7
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              ((ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
                ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                  ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q *
                ((∫⁻ s in Ioi (0 : ℝ),
                  (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                    (((d : ℝ) - 1) / (d : ℝ))) ^ q) * ENNReal.ofReal 7 :=
            mul_le_mul' (mul_le_mul' le_rfl hstep) le_rfl
        _ = _ := by ring
    · -- the grouped shells
      refine le_trans (tsum_brsOmega_le hd hE hEne hq hB hcov hg) ?_
      have htop : ENNReal.ofReal 7 *
          (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q ≤
          ENNReal.ofReal 7 *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q *
              ((∫⁻ s in Ioi (0 : ℝ),
                (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                  (((d : ℝ) - 1) / (d : ℝ))) ^ q) := by
        refine mul_le_mul' le_rfl ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hNtop hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
            ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
            (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
                  ((Real.log 2) ^ (1 / (d : ℝ)) /
                    ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
                  ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
                (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                    ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
                  (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
                (∑' m : ℕ, brsLogBlockNorm d g m ^ q) +
              ENNReal.ofReal 7 *
                (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                  ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q)
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
              (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
                    ((Real.log 2) ^ (1 / (d : ℝ)) /
                      ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
                    ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
                  (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                      ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
                    (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
                  ((∫⁻ s in Ioi (0 : ℝ),
                    (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                      (((d : ℝ) - 1) / (d : ℝ))) ^ q +
                ENNReal.ofReal 7 *
                  (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                    ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q *
                    ((∫⁻ s in Ioi (0 : ℝ),
                      (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                        (((d : ℝ) - 1) / (d : ℝ))) ^ q)) :=
            mul_le_mul' le_rfl (add_le_add (mul_le_mul' le_rfl hblocks) htop)
        _ = _ := by ring

/-- **Proposition 4.6.**  The endpoint estimate for the main term. -/
theorem prop46_brsMainMaximal {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {q B : ℝ} (hpq : (d : ℝ) / ((d : ℝ) - 1) ≤ q) (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))))) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
            (((d : ℝ) - 1) / (d : ℝ)) := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd1 : (1 : ℝ) ≤ (d : ℝ) / ((d : ℝ) - 1) := by
    rw [le_div_iff₀ hd1]
    linarith
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one (le_trans hpd1 hpq)
  obtain ⟨Λ, hΛ, hkey⟩ := exists_endpoint_bound hd hE hEne hEnull hpq hB hcov
  have hfin : Λ ^ (1 / q) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by positivity) hΛ
  have htoReal : (0 : ℝ) ≤ (Λ ^ (1 / q)).toReal := ENNReal.toReal_nonneg
  refine ⟨(Λ ^ (1 / q)).toReal + 1, by linarith, fun g hg => ?_⟩
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsMainMaximal d E ((d : ℝ) / ((d : ℝ) - 1)) g r ^ q) ^ (1 / q)
      ≤ (Λ * ((∫⁻ s in Ioi (0 : ℝ),
          (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
            (((d : ℝ) - 1) / (d : ℝ))) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (hkey g hg) (by positivity)
    _ = Λ ^ (1 / q) * (∫⁻ s in Ioi (0 : ℝ),
          (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
            (((d : ℝ) - 1) / (d : ℝ)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ ENNReal.ofReal ((Λ ^ (1 / q)).toReal + 1) *
          (∫⁻ s in Ioi (0 : ℝ),
            (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
              (((d : ℝ) - 1) / (d : ℝ)) := by
        refine mul_le_mul' ?_ le_rfl
        exact le_trans (le_of_eq (ENNReal.ofReal_toReal hfin).symm)
          (ENNReal.ofReal_le_ofReal (by linarith))

/-- The covering number decreases when the scale grows. -/
theorem intervalCoveringNumber_mono_scale {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ δ' : ℝ} (hδ : 0 < δ) (hle : δ ≤ δ') :
    intervalCoveringNumber E δ' ≤ intervalCoveringNumber E δ := by
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  rw [← hcard]
  exact intervalCoveringNumber_le_card (hι.mono_scale hle)

/-- A finite interval cover bounds the measure of the closure. -/
theorem volume_closure_le_coveringNumber_mul {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ} (hδ : 0 < δ) :
    volume (closure E) ≤
      ENNReal.ofReal ((intervalCoveringNumber E δ : ℝ) * δ) := by
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  have hclosed : IsClosed (⋃ a ∈ ι, Icc (a - δ / 2) (a + δ / 2)) := by
    refine Set.Finite.isClosed_biUnion ι.finite_toSet fun a _ => isClosed_Icc
  have hsub : closure E ⊆ ⋃ a ∈ ι, Icc (a - δ / 2) (a + δ / 2) :=
    closure_minimal hι hclosed
  calc volume (closure E) ≤ volume (⋃ a ∈ ι, Icc (a - δ / 2) (a + δ / 2)) :=
        measure_mono hsub
    _ ≤ ∑ a ∈ ι, volume (Icc (a - δ / 2) (a + δ / 2)) :=
        measure_biUnion_finset_le _ _
    _ = ∑ _a ∈ ι, ENNReal.ofReal δ := by
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [Real.volume_Icc]
        congr 1
        ring
    _ = (ι.card : ℕ) • ENNReal.ofReal δ := by rw [Finset.sum_const]
    _ = ENNReal.ofReal ((intervalCoveringNumber E δ : ℝ) * δ) := by
        rw [nsmul_eq_mul, hcard,
          ENNReal.ofReal_mul (Nat.cast_nonneg (intervalCoveringNumber E δ)),
          ENNReal.ofReal_natCast]

/-- **A set of upper Minkowski exponent `β < 1` has null closure.** -/
theorem volume_closure_eq_zero_of_minkowski {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {β : ℝ} (hβ0 : 0 ≤ β) (hβ : β < 1)
    (hM : HasUpperMinkowskiExponent E β) : volume (closure E) = 0 := by
  set ε : ℝ := (1 - β) / 2 with hε
  have hεpos : 0 < ε := by
    rw [hε]
    linarith
  obtain ⟨C, hC, hbound⟩ := intervalCoveringNumber_upper_bound_of_hasUpperMinkowskiExponent hM ε hεpos
  set γ : ℝ := 1 - (β + ε) with hγ
  have hγpos : 0 < γ := by
    rw [hγ, hε]
    linarith
  -- the scales
  have hδpos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ (-((n : ℝ) + 1)) := by
    intro n
    positivity
  have hδlt : ∀ n : ℕ, (2 : ℝ) ^ (-((n : ℝ) + 1)) < 1 := by
    intro n
    refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
    have : (0 : ℝ) ≤ (n : ℝ) := Nat.cast_nonneg n
    linarith
  have hstep : ∀ n : ℕ, volume (closure E) ≤
      ENNReal.ofReal (C * ((2 : ℝ) ^ (-γ)) ^ (n + 1)) := by
    intro n
    have h1 := volume_closure_le_coveringNumber_mul hE (hδpos n)
    have h2 : ((intervalCoveringNumber E ((2 : ℝ) ^ (-((n : ℝ) + 1))) : ℕ) : ℝ) *
        (2 : ℝ) ^ (-((n : ℝ) + 1)) ≤ C * ((2 : ℝ) ^ (-γ)) ^ (n + 1) := by
      have hcov := hbound _ (hδpos n) (hδlt n)
      have hmul := mul_le_mul_of_nonneg_right hcov (hδpos n).le
      refine le_trans hmul (le_of_eq ?_)
      rw [two_rpow_rpow, two_rpow_pow]
      rw [show (2 : ℝ) ^ (-((n : ℝ) + 1)) = (2 : ℝ) ^ (-((n : ℝ) + 1)) from rfl]
      rw [mul_assoc, ← Real.rpow_add (by norm_num)]
      congr 1
      rw [hγ]
      push_cast
      ring
    exact le_trans h1 (ENNReal.ofReal_le_ofReal h2)
  -- the scales shrink geometrically
  have hratio : (0 : ℝ) ≤ (2 : ℝ) ^ (-γ) := by positivity
  have hratio1 : (2 : ℝ) ^ (-γ) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hgeo : Tendsto (fun n : ℕ => C * ((2 : ℝ) ^ (-γ)) ^ (n + 1)) atTop
      (nhds 0) := by
    have h := tendsto_pow_atTop_nhds_zero_of_lt_one hratio hratio1
    have h2 : Tendsto (fun n : ℕ => ((2 : ℝ) ^ (-γ)) ^ (n + 1)) atTop (nhds 0) :=
      h.comp (Filter.tendsto_add_atTop_nat 1)
    simpa using h2.const_mul C
  have hlim : Tendsto (fun n : ℕ =>
      ENNReal.ofReal (C * ((2 : ℝ) ^ (-γ)) ^ (n + 1))) atTop (nhds 0) := by
    have := (ENNReal.continuous_ofReal.tendsto 0).comp hgeo
    simpa [Function.comp_def] using this
  have hle : volume (closure E) ≤ 0 :=
    ge_of_tendsto hlim (Filter.Eventually.of_forall hstep)
  exact le_antisymm hle (by simp)

/-- **(4.9).**  A Minkowski covering exponent `β` strictly below `q a + 1`
supplies the dyadic covering hypothesis of Proposition 4.5. -/
theorem exists_cov_bound_of_minkowski {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {β : ℝ} (hβ0 : 0 ≤ β) (hM : HasUpperMinkowskiExponent E β) {q a : ℝ}
    (hq : 0 < q) (hlt : β < q * a + 1) :
    ∃ S : ℝ, 0 < S ∧ ∀ n : ℕ,
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) := by
  set ε : ℝ := (q * a + 1 - β) / 2 with hε
  have hεpos : 0 < ε := by
    rw [hε]
    linarith
  have hsum : β + ε ≤ q * a + 1 := by
    rw [hε]
    linarith
  obtain ⟨C, hC, hbound⟩ :=
    intervalCoveringNumber_upper_bound_of_hasUpperMinkowskiExponent hM ε hεpos
  have hβε : 0 < β + ε := by linarith
  have htwo : (1 : ℝ) ≤ (2 : ℝ) ^ (β + ε) :=
    Real.one_le_rpow (by norm_num) hβε.le
  set A : ℝ := C * (2 : ℝ) ^ (β + ε) with hA
  have hApos : 0 < A := by
    rw [hA]
    positivity
  refine ⟨A ^ (1 / q), Real.rpow_pos_of_pos hApos _, fun n => ?_⟩
  have hAq : (A ^ (1 / q)) ^ q = A := by
    rw [← Real.rpow_mul hApos.le, one_div, inv_mul_cancel₀ hq.ne', Real.rpow_one]
  rw [hAq]
  -- the scale
  have hδ : (2 : ℝ) ^ (-(n : ℤ)) = (2 : ℝ) ^ (-(n : ℝ)) := two_zpow_eq_rpow n
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(n : ℤ)) := by positivity
  have hkey : ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ) ≤
      A * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) := by
    rcases Nat.eq_zero_or_pos n with hn | hn
    · -- the scale `1`: pass to the scale `1/2`
      subst hn
      have hhalf : (2 : ℝ) ^ (-(1 : ℝ)) ≤ (2 : ℝ) ^ (-((0 : ℕ) : ℤ)) := by
        norm_num
      have hmono := intervalCoveringNumber_mono_scale hE
        (δ := (2 : ℝ) ^ (-(1 : ℝ))) (by positivity) hhalf
      have hcov := hbound ((2 : ℝ) ^ (-(1 : ℝ))) (by positivity)
        (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by norm_num))
      have hcast : ((intervalCoveringNumber E ((2 : ℝ) ^ (-((0 : ℕ) : ℤ))) : ℕ) : ℝ) ≤
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(1 : ℝ))) : ℕ) : ℝ) := by
        exact_mod_cast hmono
      have hval : C * ((2 : ℝ) ^ (-(1 : ℝ))) ^ (-(β + ε)) = A := by
        rw [hA, two_rpow_rpow, show (-(1 : ℝ)) * (-(β + ε)) = β + ε by ring]
      have hone : ((2 : ℝ) ^ (-((0 : ℕ) : ℤ))) ^ (-(q * a + 1)) = 1 := by
        norm_num
      rw [hone, mul_one]
      exact le_trans hcast (le_trans hcov (le_of_eq hval))
    · have hlt1 : (2 : ℝ) ^ (-(n : ℤ)) < 1 := by
        rw [hδ]
        refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
        have : (1 : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
        linarith
      refine le_trans (hbound _ hδpos hlt1) ?_
      have hmono : ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(β + ε)) ≤
          ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) := by
        refine Real.rpow_le_rpow_of_exponent_ge hδpos hlt1.le ?_
        linarith
      calc C * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(β + ε))
          ≤ C * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) :=
            mul_le_mul_of_nonneg_left hmono hC.le
        _ ≤ A * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) := by
            refine mul_le_mul_of_nonneg_right ?_ (by positivity)
            rw [hA]
            nlinarith
  calc ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞)
      = ENNReal.ofReal ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ) := by
        rw [ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal (A * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) :=
        ENNReal.ofReal_le_ofReal hkey

/-- The primitive of a continuous function is continuous. -/
theorem continuous_primitive {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Continuous (fun x : ℝ => ∫ s in (0 : ℝ)..x, f₀ s) := by
  refine continuous_iff_continuousAt.mpr fun x => ?_
  have hderiv := intervalIntegral.integral_hasStrictDerivAt_right
    (hf₀.intervalIntegrable (μ := volume) 0 x)
    (hf₀.stronglyMeasurableAtFilter _ _) hf₀.continuousAt
  exact hderiv.hasDerivAt.continuousAt

/-- An interval integral of a continuous function, in terms of its primitive. -/
theorem intervalIntegral_eq_primitive_sub {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    (∫ s in a..b, f₀ s) =
      (∫ s in (0 : ℝ)..b, f₀ s) - ∫ s in (0 : ℝ)..a, f₀ s := by
  have h := intervalIntegral.integral_add_adjacent_intervals
    (a := (0 : ℝ)) (b := a) (c := b)
    (hf₀.intervalIntegrable (μ := volume) 0 a)
    (hf₀.intervalIntegrable (μ := volume) a b)
  rw [← h]
  ring

/-- Joint continuity of the two-sided window integral `∫_{y-x}^{y+x}`. -/
theorem continuous_window_integral {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Continuous (fun z : ℝ × ℝ => ∫ s in (z.2 - z.1)..(z.2 + z.1), f₀ s) := by
  have hF := continuous_primitive hf₀
  have heq : (fun z : ℝ × ℝ => ∫ s in (z.2 - z.1)..(z.2 + z.1), f₀ s) =
      fun z : ℝ × ℝ => (∫ s in (0 : ℝ)..(z.2 + z.1), f₀ s) -
        ∫ s in (0 : ℝ)..(z.2 - z.1), f₀ s := by
    funext z
    exact intervalIntegral_eq_primitive_sub hf₀ _ _
  rw [heq]
  exact (hF.comp (continuous_snd.add continuous_fst)).sub
    (hF.comp (continuous_snd.sub continuous_fst))

/-- Rationals approximate from below inside `[1, ∞)`. -/
theorem exists_rat_le_close {t δ : ℝ} (ht : 1 ≤ t) (hδ : 0 < δ) :
    ∃ c : ℚ, 1 ≤ (c : ℝ) ∧ (c : ℝ) ≤ t ∧ t - (c : ℝ) < δ := by
  rcases eq_or_lt_of_le ht with h | h
  · refine ⟨1, by norm_num, by rw [← h]; norm_num, ?_⟩
    rw [← h]
    simpa using hδ
  · obtain ⟨c, hc1, hc2⟩ := exists_rat_btwn (max_lt h (by linarith : t - δ < t))
    have hmax1 : (1 : ℝ) ≤ (c : ℝ) := le_of_lt (lt_of_le_of_lt (le_max_left _ _) hc1)
    have hmax2 : t - δ < (c : ℝ) := lt_of_le_of_lt (le_max_right (1 : ℝ) (t - δ)) hc1
    exact ⟨c, hmax1, hc2.le, by linarith⟩

/-- Rationals approximate from above inside `(-∞, 2]`. -/
theorem exists_rat_ge_close {t δ : ℝ} (ht : t ≤ 2) (hδ : 0 < δ) :
    ∃ c : ℚ, (c : ℝ) ≤ 2 ∧ t ≤ (c : ℝ) ∧ (c : ℝ) - t < δ := by
  rcases eq_or_lt_of_le ht with h | h
  · refine ⟨2, by norm_num, by rw [h]; norm_num, ?_⟩
    rw [h]
    simpa using hδ
  · obtain ⟨c, hc1, hc2⟩ := exists_rat_btwn (lt_min h (by linarith : t < t + δ))
    have hmin1 : (c : ℝ) ≤ 2 := le_of_lt (lt_of_lt_of_le hc2 (min_le_left _ _))
    have hmin2 : (c : ℝ) < t + δ := lt_of_lt_of_le hc2 (min_le_right (2 : ℝ) (t + δ))
    exact ⟨c, hmin1, hc1.le, by linarith⟩

/-- A sequence of rationals increasing to `t` from below. -/
theorem exists_rat_seq_le {t : ℝ} (ht : 1 ≤ t) :
    ∃ c : ℕ → ℚ, (∀ n, 1 ≤ ((c n : ℚ) : ℝ)) ∧ (∀ n, ((c n : ℚ) : ℝ) ≤ t) ∧
      Tendsto (fun n => ((c n : ℚ) : ℝ)) atTop (nhds t) := by
  choose c hc1 hc2 hc3 using fun n : ℕ =>
    exists_rat_le_close ht (by positivity : (0 : ℝ) < 1 / ((n : ℝ) + 1))
  refine ⟨c, hc1, hc2, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / ε)
  refine ⟨N, fun n hn => ?_⟩
  have hnN : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hpos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  have hlt : 1 / ((n : ℝ) + 1) < ε := by
    rw [div_lt_iff₀ hpos]
    have h1 : (1 / ε) < (n : ℝ) := lt_of_lt_of_le hN hnN
    rw [div_lt_iff₀ hε] at h1
    nlinarith
  have h1 := hc3 n
  have h2 := hc2 n
  rw [Real.dist_eq, abs_of_nonpos (by linarith)]
  linarith

/-- A sequence of rationals decreasing to `t` from above. -/
theorem exists_rat_seq_ge {t : ℝ} (ht : t ≤ 2) :
    ∃ c : ℕ → ℚ, (∀ n, ((c n : ℚ) : ℝ) ≤ 2) ∧ (∀ n, t ≤ ((c n : ℚ) : ℝ)) ∧
      Tendsto (fun n => ((c n : ℚ) : ℝ)) atTop (nhds t) := by
  choose c hc1 hc2 hc3 using fun n : ℕ =>
    exists_rat_ge_close ht (by positivity : (0 : ℝ) < 1 / ((n : ℝ) + 1))
  refine ⟨c, hc1, hc2, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / ε)
  refine ⟨N, fun n hn => ?_⟩
  have hnN : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hpos : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  have hlt : 1 / ((n : ℝ) + 1) < ε := by
    rw [div_lt_iff₀ hpos]
    have h1 : (1 / ε) < (n : ℝ) := lt_of_lt_of_le hN hnN
    rw [div_lt_iff₀ hε] at h1
    nlinarith
  have h1 := hc3 n
  have h2 := hc2 n
  rw [Real.dist_eq, abs_of_nonneg (by linarith)]
  linarith

/-- **The first remainder is a countable supremum.**  The dilation supremum may
be taken over the rationals, because the window integral is continuous in the
dilation parameter. -/
theorem brsRemainderOne_eq_rat_iSup {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderOne f₀ r =
      ⨆ c : ℚ, (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ (c : ℝ) ≤ r / 2 then
        ENNReal.ofReal (((c : ℝ))⁻¹ *
          ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖) else 0) := by
  refine le_antisymm ?_ ?_
  · rw [brsRemainderOne]
    refine iSup₂_le fun t ht => ?_
    obtain ⟨⟨ht1, ht2⟩, ht3⟩ := ht
    obtain ⟨c, hc1, hc2, hctend⟩ := exists_rat_seq_le ht1
    have hGcont : ContinuousAt
        (fun u : ℝ => u⁻¹ * ‖∫ s in (r - u)..(r + u), f₀ s‖) t := by
      have hwin : ContinuousAt
          (fun u : ℝ => ∫ s in (r - u)..(r + u), f₀ s) t :=
        ((continuous_window_integral hf₀).comp
          (continuous_id.prodMk (continuous_const : Continuous fun _ : ℝ => r))
            ).continuousAt
      exact (continuousAt_inv₀ (by linarith : t ≠ 0)).mul hwin.norm
    have hlim : Tendsto (fun n : ℕ => ENNReal.ofReal
        ((((c n : ℚ) : ℝ))⁻¹ *
          ‖∫ s in (r - ((c n : ℚ) : ℝ))..(r + ((c n : ℚ) : ℝ)), f₀ s‖)) atTop
        (nhds (ENNReal.ofReal (t⁻¹ * ‖∫ s in (r - t)..(r + t), f₀ s‖))) :=
      (ENNReal.continuous_ofReal.tendsto _).comp (hGcont.tendsto.comp hctend)
    refine le_of_tendsto hlim (Filter.Eventually.of_forall fun n => ?_)
    refine le_iSup_of_le (c n) ?_
    rw [if_pos ⟨⟨hc1 n, le_trans (hc2 n) ht2⟩, le_trans (hc2 n) ht3⟩]
  · refine iSup_le fun c => ?_
    by_cases hc : ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ (c : ℝ) ≤ r / 2
    · rw [if_pos hc, brsRemainderOne]
      exact le_iSup₂_of_le (c : ℝ) ⟨⟨hc.1.1, hc.1.2⟩, hc.2⟩ le_rfl
    · rw [if_neg hc]
      simp

/-- **The first remainder is measurable.** -/
theorem measurable_brsRemainderOne {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (brsRemainderOne f₀) := by
  have heq : brsRemainderOne f₀ = fun r : ℝ =>
      ⨆ c : ℚ, (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ (c : ℝ) ≤ r / 2 then
        ENNReal.ofReal (((c : ℝ))⁻¹ *
          ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖) else 0) :=
    funext (brsRemainderOne_eq_rat_iSup hf₀)
  rw [heq]
  refine Measurable.iSup fun c => ?_
  have hfun : Measurable (fun r : ℝ => ENNReal.ofReal (((c : ℝ))⁻¹ *
      ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖)) := by
    refine ENNReal.measurable_ofReal.comp ?_
    refine (continuous_const.mul ?_).measurable
    exact (((continuous_window_integral hf₀).comp
      (continuous_const.prodMk continuous_id)).norm)
  by_cases hc : (1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2
  · have hset : MeasurableSet {r : ℝ | (c : ℝ) ≤ r / 2} :=
      measurableSet_le measurable_const (measurable_id.div_const 2)
    have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ (c : ℝ) ≤ r / 2 then
          ENNReal.ofReal (((c : ℝ))⁻¹ *
            ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖) else 0)) =
        Set.indicator {r : ℝ | (c : ℝ) ≤ r / 2}
          (fun r => ENNReal.ofReal (((c : ℝ))⁻¹ *
            ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖)) := by
      funext r
      by_cases hr : (c : ℝ) ≤ r / 2
      · rw [if_pos ⟨hc, hr⟩,
          Set.indicator_of_mem (show r ∈ {r : ℝ | (c : ℝ) ≤ r / 2} from hr)]
      · rw [if_neg (by tauto),
          Set.indicator_of_notMem (show r ∉ {r : ℝ | (c : ℝ) ≤ r / 2} from hr)]
    rw [hrw]
    exact hfun.indicator hset
  · have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ (c : ℝ) ≤ r / 2 then
          ENNReal.ofReal (((c : ℝ))⁻¹ *
            ‖∫ s in (r - (c : ℝ))..(r + (c : ℝ)), f₀ s‖) else 0)) =
        fun _ : ℝ => (0 : ENNReal) := by
      funext r
      rw [if_neg (by tauto)]
    rw [hrw]
    exact measurable_const

/-- **The second remainder is a countable supremum.** -/
theorem brsRemainderTwo_eq_rat_iSup {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (r : ℝ) :
    brsRemainderTwo f₀ r =
      ⨆ c : ℚ, (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (c : ℝ) then
        ENNReal.ofReal (r⁻¹ *
          ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖) else 0) := by
  refine le_antisymm ?_ ?_
  · rw [brsRemainderTwo]
    refine iSup₂_le fun t ht => ?_
    obtain ⟨⟨ht1, ht2⟩, ht3⟩ := ht
    obtain ⟨c, hc1, hc2, hctend⟩ := exists_rat_seq_ge ht2
    have hGcont : ContinuousAt
        (fun u : ℝ => r⁻¹ * ‖∫ s in (u - r)..(u + r), f₀ s‖) t := by
      have hwin : ContinuousAt
          (fun u : ℝ => ∫ s in (u - r)..(u + r), f₀ s) t :=
        ((continuous_window_integral hf₀).comp
          ((continuous_const : Continuous fun _ : ℝ => r).prodMk continuous_id)
            ).continuousAt
      exact continuousAt_const.mul hwin.norm
    have hlim : Tendsto (fun n : ℕ => ENNReal.ofReal
        (r⁻¹ * ‖∫ s in (((c n : ℚ) : ℝ) - r)..(((c n : ℚ) : ℝ) + r), f₀ s‖))
        atTop (nhds (ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - r)..(t + r), f₀ s‖)))  :=
      (ENNReal.continuous_ofReal.tendsto _).comp (hGcont.tendsto.comp hctend)
    refine le_of_tendsto hlim (Filter.Eventually.of_forall fun n => ?_)
    refine le_iSup_of_le (c n) ?_
    rw [if_pos ⟨⟨le_trans ht1 (hc2 n), hc1 n⟩, le_trans ht3 (hc2 n)⟩]
  · refine iSup_le fun c => ?_
    by_cases hc : ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (c : ℝ)
    · rw [if_pos hc, brsRemainderTwo]
      exact le_iSup₂_of_le (c : ℝ) ⟨⟨hc.1.1, hc.1.2⟩, hc.2⟩ le_rfl
    · rw [if_neg hc]
      simp

/-- **The second remainder is measurable.** -/
theorem measurable_brsRemainderTwo {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (brsRemainderTwo f₀) := by
  have heq : brsRemainderTwo f₀ = fun r : ℝ =>
      ⨆ c : ℚ, (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (c : ℝ) then
        ENNReal.ofReal (r⁻¹ *
          ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖) else 0) :=
    funext (brsRemainderTwo_eq_rat_iSup hf₀)
  rw [heq]
  refine Measurable.iSup fun c => ?_
  have hfun : Measurable (fun r : ℝ => ENNReal.ofReal (r⁻¹ *
      ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖)) := by
    refine ENNReal.measurable_ofReal.comp ?_
    refine measurable_inv.mul ?_
    exact (((continuous_window_integral hf₀).comp
      (continuous_id.prodMk (continuous_const : Continuous fun _ : ℝ =>
        (c : ℝ)))).norm).measurable
  by_cases hc : (1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2
  · have hset : MeasurableSet {r : ℝ | 3 * r / 2 ≤ (c : ℝ)} :=
      measurableSet_le ((measurable_const.mul measurable_id).div_const 2)
        measurable_const
    have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (c : ℝ) then
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖) else 0)) =
        Set.indicator {r : ℝ | 3 * r / 2 ≤ (c : ℝ)}
          (fun r => ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖)) := by
      funext r
      by_cases hr : 3 * r / 2 ≤ (c : ℝ)
      · rw [if_pos ⟨hc, hr⟩,
          Set.indicator_of_mem (show r ∈ {r : ℝ | 3 * r / 2 ≤ (c : ℝ)} from hr)]
      · rw [if_neg (by tauto),
          Set.indicator_of_notMem
            (show r ∉ {r : ℝ | 3 * r / 2 ≤ (c : ℝ)} from hr)]
    rw [hrw]
    exact hfun.indicator hset
  · have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (c : ℝ) ∧ (c : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (c : ℝ) then
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((c : ℝ) - r)..((c : ℝ) + r), f₀ s‖) else 0)) =
        fun _ : ℝ => (0 : ENNReal) := by
      funext r
      rw [if_neg (by tauto)]
    rw [hrw]
    exact measurable_const

/-- The radial weight kills the negative half-line, so weighted integrals over
`ℝ` and over `(0,∞)` agree. -/
theorem lintegral_radial_weight_Ioi {D : ℕ} (hD : 2 ≤ D) (h : ℝ → ENNReal) :
    (∫⁻ s, ENNReal.ofReal s ^ (D - 1) * h s) =
      ∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal s ^ (D - 1) * h s := by
  rw [← lintegral_indicator measurableSet_Ioi]
  refine lintegral_congr fun s => ?_
  by_cases hs : s ∈ Ioi (0 : ℝ)
  · rw [Set.indicator_of_mem hs]
  · rw [Set.indicator_of_notMem hs]
    have hs0 : s ≤ 0 := by
      simp only [mem_Ioi, not_lt] at hs
      exact hs
    rw [ENNReal.ofReal_eq_zero.mpr hs0, zero_pow (by omega : D - 1 ≠ 0), zero_mul]

/-- **The substitution identity for the `L^p` norms.** -/
theorem lintegral_profileSub_eq {D : ℕ} (hD : 2 ≤ D) {p : ℝ} (hp : 0 < p)
    (f₀ : ℝ → ℂ) :
    (∫⁻ s in Ioi (0 : ℝ),
        (ENNReal.ofReal ‖brsProfileSub D p (absProfile f₀) s‖) ^ p) =
      ∫⁻ s, ENNReal.ofReal s ^ (D - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p := by
  rw [lintegral_radial_weight_Ioi hD]
  refine setLIntegral_congr_fun measurableSet_Ioi fun s hs => ?_
  rw [enorm_brsProfileSub_rpow hD hp _ (le_of_lt hs), norm_absProfile]

/-- Three terms: the `q`-th power of a triple sum. -/
theorem ennreal_rpow_add_three_le {X Y Z : ENNReal} {q : ℝ} (hq : 1 ≤ q) :
    (X + Y + Z) ^ q ≤ 4 ^ q * (X ^ q + Y ^ q + Z ^ q) := by
  have hq0 : (0 : ℝ) ≤ q := le_trans zero_le_one hq
  have h2 : (2 : ENNReal) ^ q * (2 : ENNReal) ^ q = (4 : ENNReal) ^ q := by
    rw [← ENNReal.mul_rpow_of_nonneg _ _ hq0]
    norm_num
  have hone : (1 : ENNReal) ≤ (2 : ENNReal) ^ q := by
    calc (1 : ENNReal) = (1 : ENNReal) ^ q := by rw [ENNReal.one_rpow]
      _ ≤ (2 : ENNReal) ^ q := ENNReal.rpow_le_rpow (by norm_num) hq0
  calc (X + Y + Z) ^ q ≤ 2 ^ q * ((X + Y) ^ q + Z ^ q) :=
        ennreal_rpow_add_le hq0
    _ ≤ 2 ^ q * (2 ^ q * (X ^ q + Y ^ q) + Z ^ q) :=
        mul_le_mul' le_rfl (add_le_add (ennreal_rpow_add_le hq0) le_rfl)
    _ ≤ 2 ^ q * (2 ^ q * (X ^ q + Y ^ q) + 2 ^ q * Z ^ q) := by
        refine mul_le_mul' le_rfl (add_le_add le_rfl ?_)
        calc Z ^ q = 1 * Z ^ q := (one_mul _).symm
          _ ≤ 2 ^ q * Z ^ q := mul_le_mul' hone le_rfl
    _ = 4 ^ q * (X ^ q + Y ^ q + Z ^ q) := by
        rw [← mul_add, ← mul_assoc, h2, add_assoc]

/-- Three terms: the `ℓ^q` norm is at most three times the `ℓ^1` norm. -/
theorem ennreal_rpow_sum_three_le {a b c : ENNReal} {q : ℝ} (hq : 1 ≤ q) :
    (a ^ q + b ^ q + c ^ q) ^ (1 / q) ≤ 3 * (a + b + c) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hmono : a ^ q + b ^ q + c ^ q ≤ 3 * (a + b + c) ^ q := by
    have ha : a ^ q ≤ (a + b + c) ^ q :=
      ENNReal.rpow_le_rpow (le_trans le_self_add le_self_add) hq0.le
    have hb : b ^ q ≤ (a + b + c) ^ q :=
      ENNReal.rpow_le_rpow (le_trans le_add_self le_self_add) hq0.le
    have hc : c ^ q ≤ (a + b + c) ^ q :=
      ENNReal.rpow_le_rpow le_add_self hq0.le
    calc a ^ q + b ^ q + c ^ q ≤ (a + b + c) ^ q + (a + b + c) ^ q +
          (a + b + c) ^ q := add_le_add (add_le_add ha hb) hc
      _ = 3 * (a + b + c) ^ q := by ring
  calc (a ^ q + b ^ q + c ^ q) ^ (1 / q)
      ≤ (3 * (a + b + c) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmono (by positivity)
    _ = 3 ^ (1 / q) * (a + b + c) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ 3 * (a + b + c) := by
        refine mul_le_mul' ?_ le_rfl
        calc (3 : ENNReal) ^ (1 / q) ≤ (3 : ENNReal) ^ (1 : ℝ) := by
              refine ENNReal.rpow_le_rpow_of_exponent_le (by norm_num) ?_
              rw [div_le_one hq0]
              exact hq
          _ = 3 := ENNReal.rpow_one 3

/-- **The three pieces of Lemma 4.1 combined.** -/
theorem exists_combined_bound {D : ℕ} (hD : 2 ≤ D) {E : Set ℝ}
    {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q) (hqpd : q < p * D)
    (hmain : ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (D - 1) * brsMainMaximal D E p g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      (∫⁻ r, ENNReal.ofReal r ^ (D - 1) *
          (brsMainMaximal D E p (brsProfileSub D p (absProfile f₀)) r +
            brsRemainderOne (absProfile f₀) r +
            brsRemainderTwo (absProfile f₀) r) ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s ^ (D - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^
            (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hq : (1 : ℝ) ≤ q := le_trans hp hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  obtain ⟨C₁, hC₁, hmainb⟩ := hmain
  obtain ⟨C₃, hC₃, hR₂⟩ := prop43_brsRemainderTwo hD hp hq0 hqpd
  set C₂ : ℝ := ((4 : ℝ) ^ ((1 - 1 / p) * (q - p)) *
    ((2 : ℝ) ^ (D - 1) * (4 : ℝ) ^ p)) ^ (1 / q) with hC₂
  have hC₂pos : 0 < C₂ := by
    rw [hC₂]
    have h1 : (0 : ℝ) < (4 : ℝ) ^ ((1 - 1 / p) * (q - p)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < (4 : ℝ) ^ p := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨12 * (C₁ + C₂ + C₃), by positivity, fun f₀ hf₀ => ?_⟩
  have hcont : Continuous (absProfile f₀) := continuous_absProfile hf₀
  set Np : ENNReal :=
    (∫⁻ s, ENNReal.ofReal s ^ (D - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p)
    with hNp
  set X : ℝ → ENNReal := fun r =>
    brsMainMaximal D E p (brsProfileSub D p (absProfile f₀)) r with hX
  set Y : ℝ → ENNReal := fun r => brsRemainderOne (absProfile f₀) r with hY
  set Z : ℝ → ENNReal := fun r => brsRemainderTwo (absProfile f₀) r with hZ
  set w : ℝ → ENNReal := fun r => ENNReal.ofReal r ^ (D - 1) with hw
  have hwmeas : Measurable w := by
    rw [hw]
    exact ENNReal.measurable_ofReal.pow_const _
  have hYmeas : Measurable (fun r => w r * Y r ^ q) := by
    refine hwmeas.mul ?_
    rw [hY]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (measurable_brsRemainderOne hcont)
  have hZmeas : Measurable (fun r => w r * Z r ^ q) := by
    refine hwmeas.mul ?_
    rw [hZ]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (measurable_brsRemainderTwo hcont)
  -- the three individual bounds
  set a : ENNReal := (∫⁻ r, w r * X r ^ q) ^ (1 / q) with ha
  set b : ENNReal := (∫⁻ r, w r * Y r ^ q) ^ (1 / q) with hb
  set c : ENNReal := (∫⁻ r, w r * Z r ^ q) ^ (1 / q) with hc
  have hbX : a ≤ ENNReal.ofReal C₁ * Np := by
    have hmeas : Measurable (brsProfileSub D p (absProfile f₀)) :=
      (continuous_brsProfileSub hD hp0 hcont).measurable
    refine le_trans (hmainb _ hmeas) ?_
    rw [hNp, lintegral_profileSub_eq hD hp0]
  have hbY : b ≤ ENNReal.ofReal C₂ * Np := by
    rw [hb, hC₂, hNp, hw, hY]
    exact prop42_brsRemainderOne hD hp hpq hf₀
  have hbZ : c ≤ ENNReal.ofReal C₃ * Np := by
    rw [hc, hNp, hw, hZ]
    exact hR₂ f₀ hf₀
  have haq : a ^ q = ∫⁻ r, w r * X r ^ q := by
    rw [ha, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hbq : b ^ q = ∫⁻ r, w r * Y r ^ q := by
    rw [hb, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hcq : c ^ q = ∫⁻ r, w r * Z r ^ q := by
    rw [hc, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hpoint : ∀ r : ℝ, w r * (X r + Y r + Z r) ^ q ≤
      4 ^ q * (w r * X r ^ q + w r * Y r ^ q + w r * Z r ^ q) := by
    intro r
    calc w r * (X r + Y r + Z r) ^ q
        ≤ w r * (4 ^ q * (X r ^ q + Y r ^ q + Z r ^ q)) :=
          mul_le_mul' le_rfl (ennreal_rpow_add_three_le hq)
      _ = 4 ^ q * (w r * X r ^ q + w r * Y r ^ q + w r * Z r ^ q) := by ring
  have h4top : (4 : ENNReal) ^ q ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg hq0.le (by norm_num)
  have hsplit : (∫⁻ r, 4 ^ q * (w r * X r ^ q + w r * Y r ^ q + w r * Z r ^ q)) =
      4 ^ q * (a ^ q + b ^ q + c ^ q) := by
    rw [lintegral_const_mul' _ _ h4top,
      lintegral_add_right' _ hZmeas.aemeasurable,
      lintegral_add_right' _ hYmeas.aemeasurable, haq, hbq, hcq]
  calc (∫⁻ r, w r * (X r + Y r + Z r) ^ q) ^ (1 / q)
      ≤ (∫⁻ r, 4 ^ q * (w r * X r ^ q + w r * Y r ^ q + w r * Z r ^ q)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpoint) (by positivity)
    _ = (4 ^ q * (a ^ q + b ^ q + c ^ q)) ^ (1 / q) := by rw [hsplit]
    _ = 4 * (a ^ q + b ^ q + c ^ q) ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ 4 * (3 * (a + b + c)) :=
        mul_le_mul' le_rfl (ennreal_rpow_sum_three_le hq)
    _ ≤ 4 * (3 * (ENNReal.ofReal C₁ * Np + ENNReal.ofReal C₂ * Np +
          ENNReal.ofReal C₃ * Np)) :=
        mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (add_le_add (add_le_add hbX hbY) hbZ))
    _ = ENNReal.ofReal (12 * (C₁ + C₂ + C₃)) * Np := by
        rw [ENNReal.ofReal_mul (by norm_num),
          ENNReal.ofReal_add (by positivity) hC₃.le,
          ENNReal.ofReal_add hC₁.le hC₂pos.le]
        rw [show ENNReal.ofReal (12 : ℝ) = (12 : ENNReal) by
          rw [show (12 : ℝ) = ((12 : ℕ) : ℝ) by norm_num,
            ENNReal.ofReal_natCast]
          norm_num]
        ring

/-- The integrand of the main term after the substitution is continuous,
because `D ≥ 2` makes the power nonnegative. -/
theorem continuous_mainIntegrand {D : ℕ} (hD : 2 ≤ D) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) :
    Continuous (fun s : ℝ => ((s ^ ((D : ℝ) - 2) : ℝ) : ℂ) * absProfile f₀ s) := by
  have hDR : (2 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
  have h1 : Continuous (fun s : ℝ => (s ^ ((D : ℝ) - 2) : ℝ)) :=
    continuous_rpow_const_of_nonneg (by linarith)
  exact (Complex.continuous_ofReal.comp h1).mul (continuous_absProfile hf₀)

/-- On a window inside `[0, ∞)` the substituted integrand of the main term may
be replaced by the continuous one. -/
theorem mainMaximal_window_eq {D : ℕ} {p : ℝ} (hp : 0 < p) (f₀ : ℝ → ℂ)
    {a b : ℝ} (ha : 0 ≤ a) (hb : 0 ≤ b) :
    (∫ s in a..b, ((s ^ (((D : ℝ) - 1) * (1 - 1 / p) - 1) : ℝ) : ℂ) *
        brsProfileSub D p (absProfile f₀) s) =
      ∫ s in a..b, ((s ^ ((D : ℝ) - 2) : ℝ) : ℂ) * absProfile f₀ s := by
  refine intervalIntegral.integral_congr_ae
    (Filter.Eventually.of_forall fun s hs => ?_)
  have hmin : (0 : ℝ) ≤ min a b := le_min ha hb
  have hs0 : 0 < s := lt_of_le_of_lt hmin (Set.mem_Ioc.mp hs).1
  exact brsMainMaximal_integrand hp (absProfile f₀) hs0

/-- **The main term is measurable.**  For a continuous profile the window
integral is continuous in the dilation parameter, so the supremum may be taken
over a countable dense subset of `E`. -/
theorem measurable_brsMainMaximal {D : ℕ} (hD : 2 ≤ D) (E : Set ℝ) {p : ℝ}
    (hp : 0 < p) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (fun r : ℝ =>
      brsMainMaximal D E p (brsProfileSub D p (absProfile f₀)) r) := by
  classical
  -- the continuous primitive of the substituted integrand
  set h : ℝ → ℂ := fun s => ((s ^ ((D : ℝ) - 2) : ℝ) : ℂ) * absProfile f₀ s with hh
  have hhcont : Continuous h := by
    rw [hh]
    exact continuous_mainIntegrand hD hf₀
  set H : ℝ → ℂ := fun x => ∫ s in (0 : ℝ)..x, h s with hH
  have hHcont : Continuous H := by
    rw [hH]
    exact continuous_primitive hhcont
  set Ψ : ℝ → ℝ → ENNReal := fun t r =>
    ENNReal.ofReal (r ^ (1 - (D : ℝ)) * ‖H (r + t) - H |r - t|‖) with hΨ
  -- the sup terms agree with `Ψ` on the admissible range
  have hterm : ∀ t r : ℝ, r / 2 < t → t < 3 * r / 2 →
      ENNReal.ofReal (r ^ (1 - (D : ℝ)) *
        ‖∫ s in |r - t|..(r + t),
          ((s ^ ((((D : ℝ) - 1) * (1 - 1 / p) - 1)) : ℝ) : ℂ) *
            brsProfileSub D p (absProfile f₀) s‖) = Ψ t r := by
    intro t r ht1 ht2
    have hr : 0 < r := by linarith
    have ht : 0 < t := by linarith
    rw [hΨ]
    congr 2
    rw [mainMaximal_window_eq hp f₀ (abs_nonneg _) (by linarith : (0:ℝ) ≤ r + t),
      intervalIntegral_eq_primitive_sub hhcont]
  -- a countable dense subset of `E`
  obtain ⟨T, hTE, hTcount, hTdense⟩ :=
    (TopologicalSpace.IsSeparable.of_separableSpace E).exists_countable_dense_subset
  haveI : Countable (↥T) := hTcount.to_subtype
  have hkey : ∀ r : ℝ,
      brsMainMaximal D E p (brsProfileSub D p (absProfile f₀)) r =
        ⨆ t : ↥T, (if r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2 then Ψ (t : ℝ) r
          else 0) := by
    intro r
    refine le_antisymm ?_ ?_
    · rw [brsMainMaximal]
      refine iSup₂_le fun t ht => ?_
      obtain ⟨htE, ht1, ht2⟩ := ht
      have hr : 0 < r := by
        have := ht1
        have := ht2
        linarith
      rw [hterm t r ht1 ht2]
      -- approximate `t` by points of `T`
      have hmem : t ∈ closure T := hTdense htE
      obtain ⟨u, huT, hutend⟩ := mem_closure_iff_seq_limit.mp hmem
      have hΨcont : ContinuousAt (fun v : ℝ => Ψ v r) t := by
        rw [hΨ]
        refine (ENNReal.continuous_ofReal.comp ?_).continuousAt
        refine continuous_const.mul ?_
        exact ((hHcont.comp (continuous_const.add continuous_id)).sub
          (hHcont.comp (continuous_abs.comp
            (continuous_const.sub continuous_id)))).norm
      have hlim : Tendsto (fun n : ℕ => Ψ (u n) r) atTop (nhds (Ψ t r)) :=
        hΨcont.tendsto.comp hutend
      have hev : ∀ᶠ n in atTop, Ψ (u n) r ≤
          ⨆ t : ↥T, (if r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2 then Ψ (t : ℝ) r
            else 0) := by
        have h1 : ∀ᶠ n in atTop, r / 2 < u n ∧ u n < 3 * r / 2 := by
          have hopen : IsOpen (Ioo (r / 2) (3 * r / 2)) := isOpen_Ioo
          have := hutend.eventually (hopen.mem_nhds (by exact ⟨ht1, ht2⟩))
          filter_upwards [this] with n hn
          exact ⟨hn.1, hn.2⟩
        filter_upwards [h1] with n hn
        refine le_iSup_of_le ⟨u n, huT n⟩ ?_
        rw [if_pos hn]
      exact le_of_tendsto hlim hev
    · refine iSup_le fun t => ?_
      by_cases hc : r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2
      · rw [if_pos hc, ← hterm (t : ℝ) r hc.1 hc.2, brsMainMaximal]
        exact le_iSup₂_of_le (t : ℝ) ⟨hTE t.2, hc.1, hc.2⟩ le_rfl
      · rw [if_neg hc]
        simp
  rw [funext hkey]
  refine Measurable.iSup fun t => ?_
  have hΨmeas : Measurable (fun r : ℝ => Ψ (t : ℝ) r) := by
    rw [hΨ]
    refine ENNReal.measurable_ofReal.comp ?_
    refine Measurable.mul ?_ ?_
    · exact (by fun_prop : Measurable fun r : ℝ => r ^ (1 - (D : ℝ)))
    · refine (Continuous.measurable ?_)
      exact ((hHcont.comp (continuous_id.add continuous_const)).sub
        (hHcont.comp (continuous_abs.comp
          (continuous_id.sub continuous_const)))).norm
  have hset : MeasurableSet {r : ℝ | r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2} := by
    have h1 : MeasurableSet {r : ℝ | r / 2 < (t : ℝ)} :=
      measurableSet_lt (measurable_id.div_const 2) measurable_const
    have h2 : MeasurableSet {r : ℝ | (t : ℝ) < 3 * r / 2} :=
      measurableSet_lt measurable_const
        ((measurable_const.mul measurable_id).div_const 2)
    exact h1.inter h2
  have hrw : (fun r : ℝ =>
      (if r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2 then Ψ (t : ℝ) r else 0)) =
      Set.indicator {r : ℝ | r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2}
        (fun r => Ψ (t : ℝ) r) := by
    funext r
    by_cases hr : r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2
    · rw [if_pos hr, Set.indicator_of_mem
        (show r ∈ {r : ℝ | r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2} from hr)]
    · rw [if_neg hr, Set.indicator_of_notMem
        (show r ∉ {r : ℝ | r / 2 < (t : ℝ) ∧ (t : ℝ) < 3 * r / 2} from hr)]
  rw [hrw]
  exact hΨmeas.indicator hset

/-- The radial lift of a profile is norm-radial. -/
theorem isNormRadial_lift (D : ℕ) (f₀ : ℝ → ℂ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial
      (fun x : Euclidean D => f₀ ‖x‖) := by
  intro x y hxy
  simp only [hxy]

/-- **The `L^p` norm of a radial lift in polar coordinates.** -/
theorem eLpNorm_lift_eq {D : ℕ} (hD : 2 ≤ D) {p : ℝ} (hp : 0 < p) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) :
    eLpNorm (fun x : Euclidean D => f₀ ‖x‖) (ENNReal.ofReal p) volume =
      ENNReal.ofReal (surfaceMass D) ^ (1 / p) *
        (∫⁻ s, ENNReal.ofReal s ^ (D - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^
          (1 / p) := by
  have hp0 : ENNReal.ofReal p ≠ 0 := by
    simp only [ne_eq, ENNReal.ofReal_eq_zero]
    exact not_le.mpr hp
  have hptop : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  set G : ℝ → ENNReal := fun r => (ENNReal.ofReal ‖f₀ r‖) ^ p with hG
  have hGmeas : Measurable G := by
    rw [hG]
    exact ENNReal.continuous_rpow_const.measurable.comp
      (hf₀.norm.measurable.ennreal_ofReal)
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hp0 hptop, ENNReal.toReal_ofReal hp.le]
  have hcongr : (∫⁻ x : Euclidean D, ‖f₀ ‖x‖‖ₑ ^ p) = ∫⁻ x : Euclidean D, G ‖x‖ := by
    refine lintegral_congr fun x => ?_
    rw [hG]
    simp only []
    rw [← ofReal_norm (f₀ ‖x‖)]
  rw [hcongr, lintegral_euclidean_radial (by omega : 0 < D) G hGmeas,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
    ← lintegral_radial_weight_Ioi hD G, hG]

/-- **The radial strong bound for continuous profiles.**  Lemma 4.1 plus the
propositions of §4, transported to the ambient Euclidean norm. -/
theorem eLpNorm_M_lift_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q)
    (hqpd : q < p * ((d + 1 : ℕ) : ℝ))
    (hmain : ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) *
          brsMainMaximal (d + 1) E p g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      eLpNorm (M E (fun y : Euclidean (d + 1) => f₀ ‖y‖)) (ENNReal.ofReal q)
          volume ≤
        ENNReal.ofReal C *
          eLpNorm (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p)
            volume := by
  have hD : 2 ≤ d + 1 := by omega
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hq : (1 : ℝ) ≤ q := le_trans hp hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hsm : 0 < surfaceMass (d + 1) := surfaceMass_pos (by omega)
  obtain ⟨C₀, hC₀, hdecomp⟩ := le_brsDecomposition hd hE hp0
  obtain ⟨K, hK, hcomb⟩ := exists_combined_bound hD (E := E) hp hpq hqpd hmain
  refine ⟨C₀ * K * surfaceMass (d + 1) ^ (1 / q - 1 / p), ?_, fun f₀ hf₀ => ?_⟩
  · have h1 : (0 : ℝ) < surfaceMass (d + 1) ^ (1 / q - 1 / p) :=
      Real.rpow_pos_of_pos hsm _
    positivity
  set S : ℝ → ENNReal := fun r =>
    brsMainMaximal (d + 1) E p (brsProfileSub (d + 1) p (absProfile f₀)) r +
      brsRemainderOne (absProfile f₀) r +
      brsRemainderTwo (absProfile f₀) r with hS
  set Np : ENNReal :=
    (∫⁻ s, ENNReal.ofReal s ^ (d + 1 - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p)
    with hNp
  have hcont : Continuous (absProfile f₀) := continuous_absProfile hf₀
  have hSmeas : Measurable (fun r : ℝ => S r ^ q) := by
    refine ENNReal.continuous_rpow_const.measurable.comp ?_
    rw [hS]
    exact ((measurable_brsMainMaximal hD E hp0 hf₀).add
      (measurable_brsRemainderOne hcont)).add (measurable_brsRemainderTwo hcont)
  -- the pointwise decomposition, away from the origin
  have hae : ∀ᵐ x : Euclidean (d + 1) ∂volume,
      ‖M E (fun y : Euclidean (d + 1) => f₀ ‖y‖) x‖ₑ ^ q ≤
        (ENNReal.ofReal C₀ * S ‖x‖) ^ q := by
    have hnull : ∀ᵐ x : Euclidean (d + 1) ∂volume, x ≠ 0 := by
      have h : volume ({(0 : Euclidean (d + 1))} : Set (Euclidean (d + 1))) = 0 := by
        simp
      rw [← compl_mem_ae_iff] at h
      filter_upwards [h] with x hx
      simpa using hx
    filter_upwards [hnull] with x hx
    refine ENNReal.rpow_le_rpow ?_ hq0.le
    have hpt := hdecomp f₀ hf₀ x hx
    rw [hS]
    simpa using hpt
  -- the radial integral
  have hbound : (∫⁻ x : Euclidean (d + 1),
      ‖M E (fun y : Euclidean (d + 1) => f₀ ‖y‖) x‖ₑ ^ q) ≤
      ENNReal.ofReal C₀ ^ q * ENNReal.ofReal (surfaceMass (d + 1)) *
        (ENNReal.ofReal K * Np) ^ q := by
    have hstep1 : (∫⁻ x : Euclidean (d + 1),
        ‖M E (fun y : Euclidean (d + 1) => f₀ ‖y‖) x‖ₑ ^ q) ≤
        ∫⁻ x : Euclidean (d + 1), ENNReal.ofReal C₀ ^ q * (S ‖x‖) ^ q := by
      refine lintegral_mono_ae ?_
      filter_upwards [hae] with x hx
      rw [← ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      exact hx
    have hstep2 : (∫⁻ x : Euclidean (d + 1),
        ENNReal.ofReal C₀ ^ q * (S ‖x‖) ^ q) =
        ENNReal.ofReal C₀ ^ q * (ENNReal.ofReal (surfaceMass (d + 1)) *
          ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) := by
      rw [lintegral_const_mul' _ _
        (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
        lintegral_euclidean_radial (by omega : 0 < d + 1)
          (fun r => S r ^ q) hSmeas]
    have hstep3 : (∫⁻ r in Ioi (0 : ℝ),
        ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) ≤ (ENNReal.ofReal K * Np) ^ q := by
      have hfull : (∫⁻ r in Ioi (0 : ℝ),
          ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) ≤
          ∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q :=
        lintegral_mono' Measure.restrict_le_self fun _ => le_rfl
      refine le_trans hfull ?_
      have hcb := hcomb f₀ hf₀
      have hraise : (∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) =
          ((∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) ^ (1 / q)) ^ q := by
        rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
      rw [hraise]
      refine ENNReal.rpow_le_rpow ?_ hq0.le
      rw [hS, hNp] at *
      exact hcb
    calc (∫⁻ x : Euclidean (d + 1),
        ‖M E (fun y : Euclidean (d + 1) => f₀ ‖y‖) x‖ₑ ^ q)
        ≤ ∫⁻ x : Euclidean (d + 1), ENNReal.ofReal C₀ ^ q * (S ‖x‖) ^ q := hstep1
      _ = ENNReal.ofReal C₀ ^ q * (ENNReal.ofReal (surfaceMass (d + 1)) *
            ∫⁻ r in Ioi (0 : ℝ), ENNReal.ofReal r ^ (d + 1 - 1) * S r ^ q) :=
          hstep2
      _ ≤ ENNReal.ofReal C₀ ^ q * (ENNReal.ofReal (surfaceMass (d + 1)) *
            (ENNReal.ofReal K * Np) ^ q) :=
          mul_le_mul' le_rfl (mul_le_mul' le_rfl hstep3)
      _ = ENNReal.ofReal C₀ ^ q * ENNReal.ofReal (surfaceMass (d + 1)) *
            (ENNReal.ofReal K * Np) ^ q := by ring
  -- take `q`-th roots and rewrite both norms
  have hq0' : ENNReal.ofReal q ≠ 0 := by
    simp only [ne_eq, ENNReal.ofReal_eq_zero]
    exact not_le.mpr hq0
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq0' ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hq0.le, eLpNorm_lift_eq hD hp0 hf₀, ← hNp]
  refine le_trans (ENNReal.rpow_le_rpow hbound (by positivity)) (le_of_eq ?_)
  have hinv : (0 : ℝ) ≤ 1 / q := by positivity
  have hsplit : (ENNReal.ofReal C₀ ^ q * ENNReal.ofReal (surfaceMass (d + 1)) *
        (ENNReal.ofReal K * Np) ^ q) ^ (1 / q) =
      (ENNReal.ofReal C₀ * ENNReal.ofReal (surfaceMass (d + 1)) ^ (1 / q) *
        ENNReal.ofReal K) * Np := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hinv, ENNReal.mul_rpow_of_nonneg _ _ hinv,
      ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne']
    simp only [ENNReal.rpow_one]
    ring
  have hscalar : ENNReal.ofReal C₀ *
        ENNReal.ofReal (surfaceMass (d + 1)) ^ (1 / q) * ENNReal.ofReal K =
      ENNReal.ofReal (C₀ * K * surfaceMass (d + 1) ^ (1 / q - 1 / p)) *
        ENNReal.ofReal (surfaceMass (d + 1)) ^ (1 / p) := by
    rw [ENNReal.ofReal_rpow_of_pos hsm, ENNReal.ofReal_rpow_of_pos hsm,
      ← ENNReal.ofReal_mul hC₀.le, ← ENNReal.ofReal_mul (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show C₀ * K * surfaceMass (d + 1) ^ (1 / q - 1 / p) *
          surfaceMass (d + 1) ^ (1 / p) =
        C₀ * K * (surfaceMass (d + 1) ^ (1 / q - 1 / p) *
          surfaceMass (d + 1) ^ (1 / p)) by ring,
      ← Real.rpow_add hsm, show (1 / q - 1 / p) + 1 / p = 1 / q by ring]
    ring
  rw [hsplit, hscalar, mul_assoc]

/-- The maximal function of a continuous radial datum is measurable. -/
theorem measurable_M_lift {D : ℕ} (E : Set ℝ) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (M E (fun y : Euclidean D => f₀ ‖y‖)) := by
  have hcont : Continuous (fun y : Euclidean D => f₀ ‖y‖) :=
    hf₀.comp continuous_norm
  change Measurable (_root_.Spherical.restrictedSphericalMaximal E
    (fun y : Euclidean D => f₀ ‖y‖))
  rw [Auto.Spherical.Bourgain.restrictedSphericalMaximal_eq_restrictedNormalizedSphericalMaximal]
  exact Auto.Spherical.PowerWeights.measurable_restrictedNormalizedSphericalMaximal
    E _ hcont

/-- **The radial strong type on the continuous-profile core.**  This is the
`§4` upper bound in its final form: given the main-term estimate in the range
under consideration, the spherical maximal operator maps radial data with a
continuous profile from `L^p` to `L^q`. -/
theorem memLp_and_eLpNorm_M_lift_le {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q)
    (hqpd : q < p * ((d + 1 : ℕ) : ℝ))
    (hmain : ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) *
          brsMainMaximal (d + 1) E p g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      MemLp (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p) volume →
        MemLp (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖)) (ENNReal.ofReal q)
            volume ∧
          eLpNorm (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖))
              (ENNReal.ofReal q) volume ≤
            ENNReal.ofReal C *
              eLpNorm (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p)
                volume := by
  obtain ⟨C, hC, hbound⟩ := eLpNorm_M_lift_le hd hE hp hpq hqpd hmain
  refine ⟨C, hC, fun f₀ hf₀ hmem => ⟨⟨?_, ?_⟩, hbound f₀ hf₀⟩⟩
  · exact (measurable_M_lift E hf₀).aestronglyMeasurable
  · refine lt_of_le_of_lt (hbound f₀ hf₀) ?_
    exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top hmem.2

/-- The exponent `a = D - 1 - D/p` of the radial main term, in the form
required by Proposition 4.5. -/
theorem brs_exponent_form {d : ℕ} {p a : ℝ} (hp : 0 < p)
    (hae : (d : ℝ) - ((d : ℝ) + 1) / p = a) :
    (((((d + 1 : ℕ) : ℝ)) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a := by
  rw [← hae]
  push_cast
  field_simp
  ring

/-- **Theorem 1.1, the upper bound below the critical exponent.**  If `E` has
upper Minkowski exponent `β < 1` and the exponent pair satisfies the strict
inequalities of `Δ_β`, then the spherical maximal operator is of strong type
on radial data with a continuous profile. -/
theorem thm11_core_small_p {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ1 : β < 1) (hM : HasUpperMinkowskiExponent E β) {p q a : ℝ}
    (hp : 1 ≤ p) (hpq : p ≤ q) (hqpd : q < p * ((d + 1 : ℕ) : ℝ))
    (hae : (d : ℝ) - ((d : ℝ) + 1) / p = a) (ha : a < 0)
    (hβlt : β < q * a + 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      MemLp (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p) volume →
        MemLp (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖)) (ENNReal.ofReal q)
            volume ∧
          eLpNorm (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖))
              (ENNReal.ofReal q) volume ≤
            ENNReal.ofReal C *
              eLpNorm (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p)
                volume := by
  have hD : 2 ≤ d + 1 := by omega
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hq : (1 : ℝ) ≤ q := le_trans hp hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hEnull : volume (closure E) = 0 :=
    volume_closure_eq_zero_of_minkowski hE hβ0 hβ1 hM
  obtain ⟨S, hS, hcov⟩ := exists_cov_bound_of_minkowski hE hβ0 hM hq0 hβlt
  have hmain := prop45_brsMainMaximal (d := d + 1) hD hE hEne hEnull hp hq hpq
    (brs_exponent_form hp0 hae) ha hS hcov
  exact memLp_and_eLpNorm_M_lift_le hd hE hp hpq hqpd hmain

/-- **Theorem 1.1, the upper bound above the critical exponent.**  For
`p > p_D` no covering hypothesis on `E` is needed. -/
theorem thm11_core_large_p {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 1 ≤ p) (hpq : p ≤ q)
    (hqpd : q < p * ((d + 1 : ℕ) : ℝ))
    (hpd : (((d + 1 : ℕ) : ℝ)) / ((((d + 1 : ℕ) : ℝ)) - 1) < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      MemLp (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p) volume →
        MemLp (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖)) (ENNReal.ofReal q)
            volume ∧
          eLpNorm (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖))
              (ENNReal.ofReal q) volume ≤
            ENNReal.ofReal C *
              eLpNorm (fun x : Euclidean (d + 1) => f₀ ‖x‖) (ENNReal.ofReal p)
                volume := by
  have hD : 2 ≤ d + 1 := by omega
  have hq0 : (0 : ℝ) < q :=
    lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hp) hpq
  have hmain := prop44_brsMainMaximal (d := d + 1) hD hE hpd hq0
  exact memLp_and_eLpNorm_M_lift_le hd hE hp hpq hqpd hmain

/-- **Theorem 1.1, the endpoint upper bound at `p = p_D`.**  Here the
logarithmic covering condition of Proposition 4.6 is used. -/
theorem thm11_core_endpoint {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ1 : β < 1) (hM : HasUpperMinkowskiExponent E β) {q B : ℝ} (hB : 0 < B)
    (hpq : (((d + 1 : ℕ) : ℝ)) / ((((d + 1 : ℕ) : ℝ)) - 1) ≤ q)
    (hqpd : q < (((d + 1 : ℕ) : ℝ)) / ((((d + 1 : ℕ) : ℝ)) - 1) *
      ((d + 1 : ℕ) : ℝ))
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / ((d + 1 : ℕ) : ℝ))))) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      MemLp (fun x : Euclidean (d + 1) => f₀ ‖x‖)
          (ENNReal.ofReal ((((d + 1 : ℕ) : ℝ)) / ((((d + 1 : ℕ) : ℝ)) - 1)))
          volume →
        MemLp (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖)) (ENNReal.ofReal q)
            volume ∧
          eLpNorm (M E (fun x : Euclidean (d + 1) => f₀ ‖x‖))
              (ENNReal.ofReal q) volume ≤
            ENNReal.ofReal C *
              eLpNorm (fun x : Euclidean (d + 1) => f₀ ‖x‖)
                (ENNReal.ofReal ((((d + 1 : ℕ) : ℝ)) /
                  ((((d + 1 : ℕ) : ℝ)) - 1))) volume := by
  have hD : 2 ≤ d + 1 := by omega
  have hDR : (2 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) := by exact_mod_cast hD
  have hD1 : (0 : ℝ) < ((d + 1 : ℕ) : ℝ) - 1 := by linarith
  have hpd1 : (1 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1) := by
    rw [le_div_iff₀ hD1]
    linarith
  have hEnull : volume (closure E) = 0 :=
    volume_closure_eq_zero_of_minkowski hE hβ0 hβ1 hM
  obtain ⟨C, hC, hb⟩ :=
    prop46_brsMainMaximal (d := d + 1) hD hE hEne hEnull hpq hB hcov
  have hmain : ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r ^ (d + 1 - 1) *
          brsMainMaximal (d + 1) E
            (((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1)) g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C *
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^
            (((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1))) ^
              (1 / (((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1))) := by
    refine ⟨C, hC, fun g hg => ?_⟩
    rw [one_div_div]
    exact hb g hg
  exact memLp_and_eLpNorm_M_lift_le hd hE hpd1 hpq hqpd hmain

/-- The three closed half-planes cutting out `Δ_β`. -/
def DeltaHalfplanes (d : ℕ) (beta : ℝ) : Set ExponentPoint :=
  {z : ExponentPoint | z.2 ≤ z.1 ∧ z.1 ≤ (d : ℝ) * z.2 ∧
    0 ≤ (1 - beta) * z.2 + ((d : ℝ) - 1) - (d : ℝ) * z.1}

theorem convex_DeltaHalfplanes (d : ℕ) (beta : ℝ) :
    Convex ℝ (DeltaHalfplanes d beta) := by
  have h1 : Convex ℝ {z : ExponentPoint | z.2 - z.1 ≤ 0} := by
    refine convex_halfSpace_le ?_ 0
    exact ⟨fun a b => by simp only [Prod.fst_add, Prod.snd_add]; ring,
      fun c a => by simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring⟩
  have h2 : Convex ℝ {z : ExponentPoint | z.1 - (d : ℝ) * z.2 ≤ 0} := by
    refine convex_halfSpace_le ?_ 0
    exact ⟨fun a b => by simp only [Prod.fst_add, Prod.snd_add]; ring,
      fun c a => by simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring⟩
  have h3 : Convex ℝ
      {z : ExponentPoint | -((1 - beta) * z.2 - (d : ℝ) * z.1) ≤ (d : ℝ) - 1} := by
    refine convex_halfSpace_le ?_ _
    exact ⟨fun a b => by simp only [Prod.fst_add, Prod.snd_add]; ring,
      fun c a => by simp only [Prod.smul_fst, Prod.smul_snd, smul_eq_mul]; ring⟩
  have hset : DeltaHalfplanes d beta =
      {z : ExponentPoint | z.2 - z.1 ≤ 0} ∩
        ({z : ExponentPoint | z.1 - (d : ℝ) * z.2 ≤ 0} ∩
          {z : ExponentPoint |
            -((1 - beta) * z.2 - (d : ℝ) * z.1) ≤ (d : ℝ) - 1}) := by
    ext z
    simp only [DeltaHalfplanes, Set.mem_setOf_eq, Set.mem_inter_iff]
    constructor
    · intro h
      exact ⟨by linarith [h.1], by linarith [h.2.1], by linarith [h.2.2]⟩
    · intro h
      exact ⟨by linarith [h.1], by linarith [h.2.1], by linarith [h.2.2]⟩
  rw [hset]
  exact h1.inter (h2.inter h3)

/-- **`Δ_β` lies in the three half-planes.** -/
theorem Delta_subset_halfplanes {d : ℕ} (hd : 2 ≤ d) {beta : ℝ} (hβ0 : 0 ≤ beta) :
    Delta d beta ⊆ DeltaHalfplanes d beta := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hA : (0 : ℝ) < (d : ℝ) - 1 + beta := by linarith
  have hB : (0 : ℝ) < (d : ℝ) ^ 2 - 1 + beta := by nlinarith
  rw [Delta]
  refine convexHull_min ?_ (convex_DeltaHalfplanes d beta)
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with h | h | h
  · rw [h, Q1]
    refine ⟨le_rfl, by norm_num, ?_⟩
    show (0 : ℝ) ≤ (1 - beta) * (0 : ℝ) + ((d : ℝ) - 1) - (d : ℝ) * (0 : ℝ)
    linarith
  · rw [h, Q2]
    refine ⟨le_rfl, ?_, ?_⟩
    · have h1 : ((d : ℝ) - 1) / ((d : ℝ) - 1 + beta) ≤
          (d : ℝ) * (((d : ℝ) - 1) / ((d : ℝ) - 1 + beta)) := by
        have hc : (0 : ℝ) ≤ ((d : ℝ) - 1) / ((d : ℝ) - 1 + beta) :=
          div_nonneg (by linarith) hA.le
        nlinarith
      exact h1
    · have hc : ((d : ℝ) - 1) / ((d : ℝ) - 1 + beta) * ((d : ℝ) - 1 + beta) =
          (d : ℝ) - 1 := div_mul_cancel₀ _ hA.ne'
      nlinarith [hc]
  · rw [h, P3rad]
    have hc : ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) * ((d : ℝ) ^ 2 - 1 + beta) =
        (d : ℝ) - 1 := div_mul_cancel₀ _ hB.ne'
    have hx : (d : ℝ) * ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) =
        (d : ℝ) * (((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta)) := by ring
    refine ⟨?_, ?_, ?_⟩
    · rw [hx]
      have hpos : (0 : ℝ) ≤ ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) :=
        div_nonneg (by linarith) hB.le
      nlinarith
    · rw [hx]
    · rw [hx]
      nlinarith [hc]

/-- **Interior points of `Δ_β` satisfy the strict inequalities.** -/
theorem interior_Delta_strict {d : ℕ} (hd : 2 ≤ d) {beta : ℝ} (hβ0 : 0 ≤ beta)
    {z : ExponentPoint} (hz : z ∈ interior (Delta d beta)) :
    z.2 < z.1 ∧ z.1 < (d : ℝ) * z.2 ∧
      0 < (1 - beta) * z.2 + ((d : ℝ) - 1) - (d : ℝ) * z.1 := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  obtain ⟨ε, hε, hball⟩ := Metric.isOpen_iff.mp isOpen_interior z hz
  have hsub : Metric.ball z ε ⊆ DeltaHalfplanes d beta := fun w hw =>
    Delta_subset_halfplanes hd hβ0 (interior_subset (hball hw))
  have hpert : ∀ t : ℝ, |t| < ε → (z.1 + t, z.2) ∈ DeltaHalfplanes d beta := by
    intro t ht
    refine hsub ?_
    rw [Metric.mem_ball, Prod.dist_eq]
    refine max_lt ?_ ?_
    · rw [Real.dist_eq]
      simpa using ht
    · simpa using hε
  have hminus := hpert (-(ε / 2)) (by
    rw [abs_of_nonpos (by linarith)]
    linarith)
  have hplus := hpert (ε / 2) (by
    rw [abs_of_nonneg (by linarith)]
    linarith)
  obtain ⟨hm1, -, -⟩ := hminus
  obtain ⟨-, hp2, hp3⟩ := hplus
  refine ⟨by simpa using (by linarith [hm1] : z.2 < z.1), ?_, ?_⟩
  · have h : z.1 + ε / 2 ≤ (d : ℝ) * z.2 := hp2
    linarith
  · have h : 0 ≤ (1 - beta) * z.2 + ((d : ℝ) - 1) - (d : ℝ) * (z.1 + ε / 2) := hp3
    nlinarith

/-- **The critical-line consequence of a radial bound.**  On the segment where
`(1-β)/q + d - 1 - d/p = 0` — the edge `[P₂,β, P₃,β^rad]` of `Δ_β` — a radial
`L^p → L^q` bound forces the entropy quantity `δ^β N(E,δ)` to stay bounded. -/
theorem sup_finite_of_hasRadialStrongType_critical {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q β : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hcrit : (1 - β) / q + (d : ℝ) - 1 - (d : ℝ) / p = 0)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ A : ℝ, 0 < A ∧ ∀ δ : ℝ, 0 < δ → δ ≤ 2 →
      δ ^ β * ((intervalCoveringNumber E δ : ℕ) : ℝ) ≤ A := by
  obtain ⟨K, hK, hbound⟩ :=
    coveringNumber_test_bound_of_hasRadialStrongType hd hE hp hq h
  have hexp : (d : ℝ) - 1 + 1 / q - (d : ℝ) / p = β / q := by
    have h1 : (1 - β) / q = 1 / q - β / q := by ring
    rw [h1] at hcrit
    linarith
  refine ⟨(2 : ℝ) ^ β * K ^ q, ?_, ?_⟩
  · have h2 : (0 : ℝ) < (2 : ℝ) ^ β := Real.rpow_pos_of_pos (by norm_num) _
    have h3 : (0 : ℝ) < K ^ q := Real.rpow_pos_of_pos hK _
    positivity
  intro δ hδ hδ2
  set δ' : ℝ := δ / 2 with hδ'
  have hδ'pos : 0 < δ' := by
    rw [hδ']
    linarith
  have hδ'1 : δ' ≤ 1 := by
    rw [hδ']
    linarith
  have hδeq : 2 * δ' = δ := by
    rw [hδ']
    ring
  have hb := hbound δ' hδ'pos hδ'1
  rw [hexp, hδeq] at hb
  -- raise the estimate to the `q`-th power
  set N : ℝ := ((intervalCoveringNumber E δ : ℕ) : ℝ) with hN
  have hN0 : 0 ≤ N := by
    rw [hN]
    exact Nat.cast_nonneg _
  have hlhs : (0 : ℝ) ≤ N ^ (1 / q) * δ' ^ (β / q) := by
    have h1 : (0 : ℝ) ≤ N ^ (1 / q) := Real.rpow_nonneg hN0 _
    have h2 : (0 : ℝ) ≤ δ' ^ (β / q) := Real.rpow_nonneg hδ'pos.le _
    positivity
  have hpow := Real.rpow_le_rpow hlhs hb hq.le
  have hexpand : (N ^ (1 / q) * δ' ^ (β / q)) ^ q = N * δ' ^ β := by
    rw [Real.mul_rpow (Real.rpow_nonneg hN0 _) (Real.rpow_nonneg hδ'pos.le _),
      ← Real.rpow_mul hN0, ← Real.rpow_mul hδ'pos.le, one_div,
      inv_mul_cancel₀ hq.ne', Real.rpow_one, div_mul_cancel₀ β hq.ne']
  rw [hexpand] at hpow
  -- undo the halving of the scale
  have hhalf : δ' ^ β = δ ^ β / (2 : ℝ) ^ β := by
    rw [hδ', Real.div_rpow hδ.le (by norm_num)]
  rw [hhalf] at hpow
  have h2pos : (0 : ℝ) < (2 : ℝ) ^ β := Real.rpow_pos_of_pos (by norm_num) _
  rw [mul_comm]
  calc N * δ ^ β = (N * (δ ^ β / (2 : ℝ) ^ β)) * (2 : ℝ) ^ β := by
        field_simp
    _ ≤ K ^ q * (2 : ℝ) ^ β := mul_le_mul_of_nonneg_right hpow h2pos.le
    _ = (2 : ℝ) ^ β * K ^ q := by ring

/-- **Theorem 1.1(ii), the failure on the critical edge.**  If the entropy
quantity `δ^β N(E,δ)` is unbounded, then no point of the edge
`[P₂,β, P₃,β^rad]` is a point of radial strong type. -/
theorem not_hasRadialStrongType_of_sup_infinite {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q β : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hcrit : (1 - β) / q + (d : ℝ) - 1 - (d : ℝ) / p = 0)
    (hsup : ∀ A : ℝ, ∃ δ : ℝ, 0 < δ ∧ δ ≤ 2 ∧
      A < δ ^ β * ((intervalCoveringNumber E δ : ℕ) : ℝ)) :
    ¬ HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q) := by
  intro h
  obtain ⟨A, -, hA⟩ :=
    sup_finite_of_hasRadialStrongType_critical hd hE hp hq hcrit h
  obtain ⟨δ, hδ, hδ2, hlt⟩ := hsup A
  exact absurd (hA δ hδ hδ2) (not_le.mpr hlt)

/-- An exponential beats every power: `2^{γ x}` dominates `x^s` with an
explicit constant, obtained from `1 + y ≤ exp y` applied `n` times. -/
theorem two_rpow_mul_le {γ s : ℝ} (hγ : 0 < γ) (hs : 0 ≤ s) :
    ∃ M : ℝ, 0 < M ∧ ∀ x : ℝ, 1 ≤ x → x ^ s ≤ M * (2 : ℝ) ^ (γ * x) := by
  obtain ⟨n, hn⟩ := exists_nat_ge s
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  set n' : ℕ := n + 1 with hn'
  have hn'pos : 0 < n' := by omega
  have hsn : s ≤ (n' : ℝ) := by
    have : (n : ℝ) ≤ (n' : ℝ) := by
      rw [hn']
      push_cast
      linarith
    linarith
  refine ⟨((n' : ℝ) / (γ * Real.log 2)) ^ n', ?_, fun x hx => ?_⟩
  · have hd : (0 : ℝ) < (n' : ℝ) / (γ * Real.log 2) := by
      refine div_pos ?_ (by positivity)
      exact_mod_cast hn'pos
    positivity
  have hx0 : (0 : ℝ) < x := lt_of_lt_of_le zero_lt_one hx
  have hn'R : (0 : ℝ) < (n' : ℝ) := by exact_mod_cast hn'pos
  -- the exponential lower bound
  have hexp : ((γ * x * Real.log 2) / (n' : ℝ)) ^ n' ≤ (2 : ℝ) ^ (γ * x) := by
    have hpos : (0 : ℝ) ≤ (γ * x * Real.log 2) / (n' : ℝ) := by positivity
    have hstep : ((γ * x * Real.log 2) / (n' : ℝ)) ^ n' ≤
        (Real.exp ((γ * x * Real.log 2) / (n' : ℝ))) ^ n' := by
      refine pow_le_pow_left₀ hpos ?_ n'
      have h := Real.add_one_le_exp ((γ * x * Real.log 2) / (n' : ℝ))
      linarith
    refine le_trans hstep (le_of_eq ?_)
    rw [← Real.exp_nat_mul, Real.rpow_def_of_pos (by norm_num : (0:ℝ) < 2)]
    congr 1
    field_simp
  -- compare the powers of `x`
  have hxs : x ^ s ≤ x ^ (n' : ℝ) := Real.rpow_le_rpow_of_exponent_le hx hsn
  have hxn : x ^ (n' : ℝ) = x ^ n' := by
    rw [Real.rpow_natCast]
  have hkey : x ^ n' ≤ ((n' : ℝ) / (γ * Real.log 2)) ^ n' *
      ((γ * x * Real.log 2) / (n' : ℝ)) ^ n' := by
    rw [← mul_pow]
    refine le_of_eq ?_
    congr 1
    field_simp
  calc x ^ s ≤ x ^ n' := by rw [← hxn]; exact hxs
    _ ≤ ((n' : ℝ) / (γ * Real.log 2)) ^ n' *
          ((γ * x * Real.log 2) / (n' : ℝ)) ^ n' := hkey
    _ ≤ ((n' : ℝ) / (γ * Real.log 2)) ^ n' * (2 : ℝ) ^ (γ * x) := by
        refine mul_le_mul_of_nonneg_left hexp ?_
        have hd : (0 : ℝ) < (n' : ℝ) / (γ * Real.log 2) := by
          refine div_pos hn'R (by positivity)
        positivity

/-- **The logarithmic covering hypothesis from `β < 1`.**  A set of upper
Minkowski exponent `β < 1` satisfies the doubly exponential covering condition
of Proposition 4.6. -/
theorem exists_logcov_bound_of_minkowski {E : Set ℝ} {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ1 : β < 1) (hM : HasUpperMinkowskiExponent E β) {q : ℝ} (hq : 0 < q)
    {D : ℕ} (hD : 2 ≤ D) :
    ∃ B : ℝ, 0 < B ∧ ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (D : ℝ)))) := by
  have hDR : (2 : ℝ) ≤ (D : ℝ) := by exact_mod_cast hD
  have hDpos : (0 : ℝ) < (D : ℝ) := by linarith
  have hlog2 : (0 : ℝ) < Real.log 2 := Real.log_pos (by norm_num)
  set ε : ℝ := (1 - β) / 2 with hε
  have hεpos : 0 < ε := by
    rw [hε]
    linarith
  set γ : ℝ := 1 - (β + ε) with hγ
  have hγpos : 0 < γ := by
    rw [hγ, hε]
    linarith
  obtain ⟨C, hC, hcov⟩ :=
    intervalCoveringNumber_upper_bound_of_hasUpperMinkowskiExponent hM ε hεpos
  obtain ⟨M, hMpos, hgrow⟩ := two_rpow_mul_le (γ := γ) (s := q / (D : ℝ)) hγpos
    (by positivity)
  -- the constant
  refine ⟨(C * M * (Real.log 2) ^ (q / (D : ℝ))) ^ (1 / q), ?_, ?_⟩
  · refine Real.rpow_pos_of_pos ?_ _
    have h1 : (0 : ℝ) < (Real.log 2) ^ (q / (D : ℝ)) :=
      Real.rpow_pos_of_pos hlog2 _
    positivity
  intro l hl
  set m : ℝ := (2 : ℝ) ^ (l - 1) with hm
  have hm1 : (1 : ℝ) ≤ m := by
    rw [hm]
    exact one_le_pow₀ (by norm_num)
  have hmpos : (0 : ℝ) < m := lt_of_lt_of_le zero_lt_one hm1
  -- the scale
  have hδeq : (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) = (2 : ℝ) ^ (-m) := by
    rw [hm, ← Real.rpow_intCast (2 : ℝ) (-(2 ^ (l - 1) : ℤ))]
    congr 1
    push_cast
    ring
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) := by positivity
  have hδlt : (2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ)) < 1 := by
    rw [hδeq]
    refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
    linarith
  have hb := hcov _ hδpos hδlt
  -- rewrite the covering bound in terms of `m`
  have hbound : ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ) ≤
      C * (2 : ℝ) ^ (m * (β + ε)) := by
    refine le_trans hb (le_of_eq ?_)
    rw [hδeq, two_rpow_rpow]
    congr 1
    ring
  -- the target, in terms of `m`
  have hsplit : (2 : ℝ) ^ (m * (β + ε)) * (2 : ℝ) ^ (γ * m) = (2 : ℝ) ^ m := by
    rw [← Real.rpow_add (by norm_num)]
    congr 1
    rw [hγ]
    ring
  have hms : (0 : ℝ) < m ^ (q / (D : ℝ)) := Real.rpow_pos_of_pos hmpos _
  have hstep : (2 : ℝ) ^ (m * (β + ε)) * m ^ (q / (D : ℝ)) ≤ M * (2 : ℝ) ^ m := by
    calc (2 : ℝ) ^ (m * (β + ε)) * m ^ (q / (D : ℝ))
        ≤ (2 : ℝ) ^ (m * (β + ε)) * (M * (2 : ℝ) ^ (γ * m)) :=
          mul_le_mul_of_nonneg_left (hgrow m hm1) (by positivity)
      _ = M * ((2 : ℝ) ^ (m * (β + ε)) * (2 : ℝ) ^ (γ * m)) := by ring
      _ = M * (2 : ℝ) ^ m := by rw [hsplit]
  have htarget : C * (2 : ℝ) ^ (m * (β + ε)) ≤
      C * M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ))) := by
    have hfin : (2 : ℝ) ^ (m * (β + ε)) ≤
        M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ))) := by
      rw [Real.rpow_neg hmpos.le, ← div_eq_mul_inv, le_div_iff₀ hms]
      exact hstep
    calc C * (2 : ℝ) ^ (m * (β + ε))
        ≤ C * (M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ)))) :=
          mul_le_mul_of_nonneg_left hfin hC.le
      _ = C * M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ))) := by ring
  -- assemble
  have hfinal : ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ) ≤
      ((C * M * (Real.log 2) ^ (q / (D : ℝ))) ^ (1 / q)) ^ q *
        (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
        (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (D : ℝ))) := by
    have hpow : ((C * M * (Real.log 2) ^ (q / (D : ℝ))) ^ (1 / q)) ^ q =
        C * M * (Real.log 2) ^ (q / (D : ℝ)) := by
      have hbase : (0 : ℝ) < C * M * (Real.log 2) ^ (q / (D : ℝ)) := by
        have h1 : (0 : ℝ) < (Real.log 2) ^ (q / (D : ℝ)) :=
          Real.rpow_pos_of_pos hlog2 _
        positivity
      rw [← Real.rpow_mul hbase.le, one_div, inv_mul_cancel₀ hq.ne', Real.rpow_one]
    have hmpow : (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) = (2 : ℝ) ^ m := by
      rw [hm, ← Real.rpow_intCast (2 : ℝ) ((2 ^ (l - 1) : ℤ))]
      congr 1
      push_cast
      ring
    have hlogsplit : (m * Real.log 2) ^ (-(q / (D : ℝ))) =
        m ^ (-(q / (D : ℝ))) * (Real.log 2) ^ (-(q / (D : ℝ))) :=
      Real.mul_rpow hmpos.le hlog2.le
    have hcancel : (Real.log 2) ^ (q / (D : ℝ)) *
        (Real.log 2) ^ (-(q / (D : ℝ))) = 1 := by
      rw [← Real.rpow_add hlog2]
      simp
    rw [hpow, hmpow, ← hm, hlogsplit]
    calc ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ)
        ≤ C * (2 : ℝ) ^ (m * (β + ε)) := hbound
      _ ≤ C * M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ))) := htarget
      _ = C * M * (Real.log 2) ^ (q / (D : ℝ)) * (2 : ℝ) ^ m *
            (m ^ (-(q / (D : ℝ))) * (Real.log 2) ^ (-(q / (D : ℝ)))) := by
          rw [show C * M * (Real.log 2) ^ (q / (D : ℝ)) * (2 : ℝ) ^ m *
                (m ^ (-(q / (D : ℝ))) * (Real.log 2) ^ (-(q / (D : ℝ)))) =
              C * M * (2 : ℝ) ^ m * m ^ (-(q / (D : ℝ))) *
                ((Real.log 2) ^ (q / (D : ℝ)) *
                  (Real.log 2) ^ (-(q / (D : ℝ)))) by ring, hcancel, mul_one]
  calc ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞)
      = ENNReal.ofReal
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ) := by
        rw [ENNReal.ofReal_natCast]
    _ ≤ _ := ENNReal.ofReal_le_ofReal hfinal

/-- **`Δ_β` lies in the unit square.** -/
theorem Delta_subset_unitSquare {d : ℕ} (hd : 2 ≤ d) {beta : ℝ} (hβ0 : 0 ≤ beta)
    (hβ1 : beta ≤ 1) :
    Delta d beta ⊆ Set.Icc (0 : ℝ) 1 ×ˢ Set.Icc (0 : ℝ) 1 := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hA : (0 : ℝ) < (d : ℝ) - 1 + beta := by linarith
  have hB : (0 : ℝ) < (d : ℝ) ^ 2 - 1 + beta := by nlinarith
  rw [Delta]
  refine convexHull_min ?_ (convex_Icc _ _|>.prod (convex_Icc _ _))
  intro z hz
  simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hz
  rcases hz with h | h | h
  · rw [h, Q1]
    exact ⟨⟨le_rfl, by norm_num⟩, ⟨le_rfl, by norm_num⟩⟩
  · rw [h, Q2]
    have hc0 : (0 : ℝ) ≤ ((d : ℝ) - 1) / ((d : ℝ) - 1 + beta) :=
      div_nonneg (by linarith) hA.le
    have hc1 : ((d : ℝ) - 1) / ((d : ℝ) - 1 + beta) ≤ 1 := by
      rw [div_le_one hA]
      linarith
    exact ⟨⟨hc0, hc1⟩, ⟨hc0, hc1⟩⟩
  · rw [h, P3rad]
    have hx0 : (0 : ℝ) ≤ (d : ℝ) * ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) := by
      refine div_nonneg ?_ hB.le
      nlinarith
    have hx1 : (d : ℝ) * ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) ≤ 1 := by
      rw [div_le_one hB]
      nlinarith
    have hy0 : (0 : ℝ) ≤ ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) :=
      div_nonneg (by linarith) hB.le
    have hy1 : ((d : ℝ) - 1) / ((d : ℝ) ^ 2 - 1 + beta) ≤ 1 := by
      rw [div_le_one hB]
      nlinarith
    exact ⟨⟨hx0, hx1⟩, ⟨hy0, hy1⟩⟩

/-- Strong `L^p_rad → L^q` boundedness on radial data with a continuous
profile.  This is the class on which the upper bounds of §4 operate: Lemma 4.1
represents the spherical average of such a datum by its kernel formula. -/
def HasRadialStrongTypeCont (D : ℕ) (E : Set ℝ) (p q : ℝ) : Prop :=
  ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
    MemLp (fun x : Euclidean D => f₀ ‖x‖) (ENNReal.ofReal p) volume →
      MemLp (M E (fun x : Euclidean D => f₀ ‖x‖)) (ENNReal.ofReal q) volume ∧
        eLpNorm (M E (fun x : Euclidean D => f₀ ‖x‖)) (ENNReal.ofReal q)
            volume ≤
          ENNReal.ofReal C *
            eLpNorm (fun x : Euclidean D => f₀ ‖x‖) (ENNReal.ofReal p) volume

/-- The type set of the continuous-profile core, in reciprocal coordinates. -/
def radialTypeSetCont (D : ℕ) (E : Set ℝ) : Set ExponentPoint :=
  {z | ∃ p q : ℝ, 1 ≤ p ∧ 1 ≤ q ∧ z = (1 / p, 1 / q) ∧
    HasRadialStrongTypeCont D E p q}

/-- The full radial type set is contained in the continuous-profile one. -/
theorem hasRadialStrongTypeCont_of_hasRadialStrongType {D : ℕ} {E : Set ℝ}
    {p q : ℝ} (h : HasRadialStrongType D E (ENNReal.ofReal p)
      (ENNReal.ofReal q)) :
    HasRadialStrongTypeCont D E p q := by
  obtain ⟨C, hC, hbound⟩ := h
  refine ⟨C, hC, fun f₀ hf₀ hmem => ?_⟩
  exact hbound _ hmem (isNormRadial_lift D f₀)

/-- **Theorem 1.1, the sufficiency half.**  Every interior point of `Δ_β` is a
point of radial strong type on the continuous-profile core. -/
theorem interior_Delta_subset_radialTypeSetCont {d : ℕ} (hd : 2 ≤ d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ}
    (hβ0 : 0 ≤ β) (hβ1 : β < 1) (hM : HasUpperMinkowskiExponent E β) :
    interior (Delta (d + 1) β) ⊆ radialTypeSetCont (d + 1) E := by
  have hD : 2 ≤ d + 1 := by omega
  have hDR : (2 : ℝ) ≤ ((d + 1 : ℕ) : ℝ) := by exact_mod_cast hD
  have hD1 : (0 : ℝ) < ((d + 1 : ℕ) : ℝ) - 1 := by linarith
  intro z hz
  obtain ⟨h1, h2, h3⟩ := interior_Delta_strict hD hβ0 hz
  obtain ⟨⟨hz10, hz11⟩, ⟨hz20, hz21⟩⟩ :=
    Delta_subset_unitSquare hD hβ0 hβ1.le (interior_subset hz)
  -- the exponents
  have hz2pos : 0 < z.2 := by
    rcases eq_or_lt_of_le hz20 with h | h
    · exfalso
      rw [← h] at h2
      simp only [mul_zero] at h2
      linarith
    · exact h
  have hz1pos : 0 < z.1 := lt_trans hz2pos h1
  set p : ℝ := 1 / z.1 with hp
  set q : ℝ := 1 / z.2 with hq
  have hp1 : 1 ≤ p := by
    rw [hp, le_div_iff₀ hz1pos]
    linarith
  have hq1 : 1 ≤ q := by
    rw [hq, le_div_iff₀ hz2pos]
    linarith
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp1
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq1
  have hzp : z.1 = 1 / p := by
    rw [hp, one_div_one_div]
  have hzq : z.2 = 1 / q := by
    rw [hq, one_div_one_div]
  have hpq : p ≤ q := by
    rw [hp, hq]
    exact one_div_le_one_div_of_le hz2pos h1.le
  have hqpd : q < p * ((d + 1 : ℕ) : ℝ) := by
    have hpD : p * ((d + 1 : ℕ) : ℝ) = ((d + 1 : ℕ) : ℝ) / z.1 := by
      rw [hp]
      field_simp
    rw [hq, hpD, div_lt_div_iff₀ hz2pos hz1pos, one_mul]
    exact h2
  refine ⟨p, q, hp1, hq1, ?_, ?_⟩
  · rw [← hzp, ← hzq]
  -- the three branches
  by_cases hcase : ((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1) < p
  · exact thm11_core_large_p hd hE hp1 hpq hqpd hcase
  · rcases eq_or_lt_of_le (not_lt.mp hcase) with hEq | hlt
    · -- the endpoint `p = p_D`
      obtain ⟨B, hB, hcov⟩ :=
        exists_logcov_bound_of_minkowski hβ0 hβ1 hM hq0 (D := d + 1) hD
      have hpq' : ((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1) ≤ q := by
        rw [← hEq]
        exact hpq
      have hqpd' : q < ((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1) *
          ((d + 1 : ℕ) : ℝ) := by
        rw [← hEq]
        exact hqpd
      have hgoal := thm11_core_endpoint hd hE hEne hβ0 hβ1 hM hB hpq' hqpd' hcov
      rw [HasRadialStrongTypeCont, hEq]
      exact hgoal
    · -- below the critical exponent
      set a : ℝ := (d : ℝ) - ((d : ℝ) + 1) / p with ha
      have hcast : ((d + 1 : ℕ) : ℝ) = (d : ℝ) + 1 := by push_cast; ring
      have hdpos : (0 : ℝ) < (d : ℝ) := by
        have h2d : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
        linarith
      have hlt' : p < ((d : ℝ) + 1) / (d : ℝ) := by
        have hkey : ((d + 1 : ℕ) : ℝ) / (((d + 1 : ℕ) : ℝ) - 1) =
            ((d : ℝ) + 1) / (d : ℝ) := by
          rw [hcast, add_sub_cancel_right]
        rw [hkey] at hlt
        exact hlt
      have hanel : a < 0 := by
        rw [ha, sub_neg, lt_div_iff₀ hp0]
        rw [lt_div_iff₀ hdpos] at hlt'
        nlinarith [hlt']
      have hβlt : β < q * a + 1 := by
        rw [hzp, hzq, hcast] at h3
        have h3' : 0 < (1 - β) * (1 / q) + a := by
          rw [ha]
          have hsimp : ((d : ℝ) + 1 - 1) = (d : ℝ) := by ring
          have hmul : ((d : ℝ) + 1) * (1 / p) = ((d : ℝ) + 1) / p := by
            field_simp
          rw [hsimp, hmul] at h3
          linarith
        have hmul := mul_lt_mul_of_pos_left h3' hq0
        rw [mul_zero] at hmul
        have hexp : q * ((1 - β) * (1 / q) + a) = (1 - β) + q * a := by
          field_simp
        rw [hexp] at hmul
        linarith
      exact thm11_core_small_p hd hE hEne hβ0 hβ1 hM hp1 hpq hqpd ha.symm hanel
        hβlt

/-- **Theorem 1.1 of BRS, both inclusions.**  For `E ⊆ [1,2]` of upper
Minkowski dimension `β < 1`, every interior point of `Δ_β` is a point of
radial strong type (on the continuous-profile core), and every point of the
radial type set lies in `Δ_β`. -/
theorem thm11_radialTypeSet {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {β : ℝ} (hβ0 : 0 ≤ β)
    (hβ1 : β < 1) (hM : HasUpperMinkowskiExponent E β)
    (hdim : upperMinkowskiDimension E = β) :
    interior (Delta (d + 1) β) ⊆ radialTypeSetCont (d + 1) E ∧
      radialTypeSet (d + 1) E ⊆ Delta (d + 1) β :=
  ⟨interior_Delta_subset_radialTypeSetCont hd hE hEne hβ0 hβ1 hM,
    radialTypeSet_subset_Delta (by omega) hE hEne hdim⟩

/-! ## The ambient-two slice identity

In the plane the equatorial sphere is `S⁰`, so the height density degenerates
to `(1 - t²)^{-1/2}`.  The repository already carries the planar height
identity in its *angular* form
(`integral_comp_last_unitSurfaceMeasure_two`), which avoids the singular
density altogether; the reflection argument transports it to an arbitrary
unit direction exactly as in ambient dimension `d + 1 ≥ 3`. -/

/-- **The planar sphere slice identity.**  Integrating a continuous function of
the height `⟪ω, e⟫` over the unit circle is the angular integral of the same
function of `cos φ`. -/
theorem integral_comp_inner_unitSurfaceMeasure_two (e : Euclidean 2)
    (he : ‖e‖ = 1) (F : ℝ → ℂ) (hF : Continuous F) :
    (∫ ω : Metric.sphere (0 : Euclidean 2) 1,
        F (inner ℝ (ω : Euclidean 2) e) ∂unitSurfaceMeasure 2) =
      (surfaceMass 1 : ℂ) * ∫ φ in (0 : ℝ)..Real.pi, F (Real.cos φ) := by
  set a : Euclidean 2 := lastAxis 1 with ha
  have hna : ‖a‖ = 1 := by
    rw [ha, lastAxis]
    exact norm_euclideanSucc_last 1
  set u : Euclidean 2 ≃ₗᵢ[ℝ] Euclidean 2 :=
    Submodule.reflection (ℝ ∙ (a - e))ᗮ with hu
  have hua : u a = e := Submodule.reflection_sub (by rw [hna, he])
  set uSphere : Metric.sphere (0 : Euclidean 2) 1 ≃ₜ
      Metric.sphere (0 : Euclidean 2) 1 :=
    u.toHomeomorph.subtype (fun x => by
      simp only [mem_sphere_zero_iff_norm, LinearIsometryEquiv.coe_toHomeomorph]
      rw [u.norm_map]) with huSphere
  have hmeasure : Measure.map uSphere (unitSurfaceMeasure 2) =
      unitSurfaceMeasure 2 := by
    simpa only [huSphere] using map_unitSurfaceMeasure_linearIsometry 2 u
  have hpres : MeasurePreserving uSphere (unitSurfaceMeasure 2)
      (unitSurfaceMeasure 2) := ⟨uSphere.continuous.measurable, hmeasure⟩
  have hcomp := hpres.integral_comp uSphere.measurableEmbedding
    (fun ω : Metric.sphere (0 : Euclidean 2) 1 =>
      F (inner ℝ (ω : Euclidean 2) e))
  calc
    (∫ ω : Metric.sphere (0 : Euclidean 2) 1,
        F (inner ℝ (ω : Euclidean 2) e) ∂unitSurfaceMeasure 2) =
        ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
          F (inner ℝ ((uSphere ω : Metric.sphere (0 : Euclidean 2) 1) :
            Euclidean 2) e) ∂unitSurfaceMeasure 2 := hcomp.symm
    _ = ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
          F ((ω : Euclidean 2) (Fin.last 1)) ∂unitSurfaceMeasure 2 := by
        apply integral_congr_ae
        filter_upwards with ω
        have hval : ((uSphere ω : Metric.sphere (0 : Euclidean 2) 1) :
            Euclidean 2) = u (ω : Euclidean 2) := rfl
        rw [hval, ← hua, u.inner_map_map]
        rw [ha, lastAxis, inner_euclideanSucc_last]
    _ = (surfaceMass 1 : ℂ) * ∫ φ in (0 : ℝ)..Real.pi, F (Real.cos φ) :=
        integral_comp_last_unitSurfaceMeasure_two F hF

/-- **The planar radial spherical average.**  For a radial datum the circular
average is the angular integral of its profile along the law of cosines. -/
theorem sphericalAverage_comp_norm_two (f₀ : ℝ → ℂ) (hf₀ : Continuous f₀)
    {x : Euclidean 2} (hx : x ≠ 0) (t : ℝ) :
    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
      (((surfaceMass 2)⁻¹ * surfaceMass 1 : ℝ) : ℂ) *
        ∫ φ in (0 : ℝ)..Real.pi,
          f₀ (Real.sqrt (‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * Real.cos φ)) := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  set e : Euclidean 2 := ‖x‖⁻¹ • x with he
  have hne : ‖e‖ = 1 := by
    rw [he, norm_smul, norm_inv, Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    field_simp
  set F : ℝ → ℂ := fun v => f₀ (Real.sqrt (‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * v))
    with hF
  have hFcont : Continuous F := by
    rw [hF]
    exact hf₀.comp (Real.continuous_sqrt.comp (by fun_prop))
  have hpoint : ∀ ω : Metric.sphere (0 : Euclidean 2) 1,
      f₀ ‖x + t • (ω : Euclidean 2)‖ = F (inner ℝ (ω : Euclidean 2) e) := by
    intro ω
    have hω : ‖(ω : Euclidean 2)‖ = 1 := by
      simpa using ω.2
    have hinner : inner ℝ (ω : Euclidean 2) e =
        ‖x‖⁻¹ * inner ℝ x (ω : Euclidean 2) := by
      rw [he, real_inner_smul_right, real_inner_comm]
    have hsq : ‖x + t • (ω : Euclidean 2)‖ ^ 2 =
        ‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * inner ℝ (ω : Euclidean 2) e := by
      rw [norm_add_sq_real, real_inner_smul_right, norm_smul, Real.norm_eq_abs, hω,
        mul_one, hinner]
      have habs : |t| ^ 2 = t ^ 2 := sq_abs t
      rw [habs]
      field_simp
      ring
    rw [hF]
    congr 1
    rw [← hsq, Real.sqrt_sq (norm_nonneg _)]
  calc
    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
        (((surfaceMass 2)⁻¹ : ℝ) : ℂ) *
          ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
            f₀ ‖x + t • (ω : Euclidean 2)‖ ∂unitSurfaceMeasure 2 := by
      rw [_root_.Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage,
        normalizedSphericalAverage, SurfaceMeasureDecay.sphericalAverage]
      push_cast
      ring
    _ = (((surfaceMass 2)⁻¹ : ℝ) : ℂ) *
          ∫ ω : Metric.sphere (0 : Euclidean 2) 1,
            F (inner ℝ (ω : Euclidean 2) e) ∂unitSurfaceMeasure 2 := by
      congr 1
      apply integral_congr_ae
      filter_upwards with ω
      exact hpoint ω
    _ = (((surfaceMass 2)⁻¹ : ℝ) : ℂ) *
          ((surfaceMass 1 : ℂ) *
            ∫ φ in (0 : ℝ)..Real.pi, F (Real.cos φ)) := by
      rw [integral_comp_inner_unitSurfaceMeasure_two e hne F hFcont]
    _ = (((surfaceMass 2)⁻¹ * surfaceMass 1 : ℝ) : ℂ) *
          ∫ φ in (0 : ℝ)..Real.pi, F (Real.cos φ) := by
      push_cast
      ring

/-- The planar kernel of (4.2): the `D = 2` case of `brsKernel`, where the
exponent `D - 3 = -1` makes the square roots appear in the denominator. -/
def brsKernelTwo (t r s : ℝ) : ℝ :=
  s / (Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2))

/-- The law of cosines, as the radius attached to an angle. -/
def cosineRadius (r t φ : ℝ) : ℝ :=
  Real.sqrt (r ^ 2 + t ^ 2 + 2 * r * t * Real.cos φ)

theorem cosineRadius_zero {r t : ℝ} (hr : 0 < r) (ht : 0 < t) :
    cosineRadius r t 0 = r + t := by
  rw [cosineRadius, Real.cos_zero]
  rw [show r ^ 2 + t ^ 2 + 2 * r * t * 1 = (r + t) ^ 2 by ring]
  exact Real.sqrt_sq (by linarith)

theorem cosineRadius_pi (r t : ℝ) : cosineRadius r t Real.pi = |r - t| := by
  rw [cosineRadius, Real.cos_pi]
  rw [show r ^ 2 + t ^ 2 + 2 * r * t * (-1) = (r - t) ^ 2 by ring]
  exact Real.sqrt_sq_eq_abs _

theorem continuous_cosineRadius (r t : ℝ) : Continuous (cosineRadius r t) := by
  unfold cosineRadius
  exact Real.continuous_sqrt.comp (by fun_prop)

/-- The radicand of the law of cosines is positive below the antipode. -/
theorem one_add_cos_pos {φ : ℝ} (hφ : φ ∈ Ioo (0 : ℝ) Real.pi) :
    0 < 1 + Real.cos φ := by
  have hhalf : 0 < Real.cos (φ / 2) := by
    refine Real.cos_pos_of_mem_Ioo ⟨by linarith [hφ.1, Real.pi_pos], by linarith [hφ.2]⟩
  have hsq : Real.cos (φ / 2) ^ 2 = 1 / 2 + Real.cos φ / 2 := by
    have h := Real.cos_sq (φ / 2)
    rw [show 2 * (φ / 2) = φ by ring] at h
    exact h
  nlinarith [hhalf, hsq]

/-- The radicand of the law of cosines is positive below the antipode. -/
theorem cosineRadius_sq_pos {r t φ : ℝ} (hr : 0 < r) (ht : 0 < t)
    (hφ : φ ∈ Ioo (0 : ℝ) Real.pi) :
    0 < r ^ 2 + t ^ 2 + 2 * r * t * Real.cos φ := by
  have hone := one_add_cos_pos hφ
  have hrt : 0 < r * t := mul_pos hr ht
  nlinarith [sq_nonneg (r - t), hone, hrt]

theorem cosineRadius_pos {r t φ : ℝ} (hr : 0 < r) (ht : 0 < t)
    (hφ : φ ∈ Ioo (0 : ℝ) Real.pi) : 0 < cosineRadius r t φ := by
  rw [cosineRadius]
  exact Real.sqrt_pos.mpr (cosineRadius_sq_pos hr ht hφ)

/-- The derivative of the law-of-cosines radius. -/
theorem hasDerivAt_cosineRadius {r t φ : ℝ} (hr : 0 < r) (ht : 0 < t)
    (hφ : φ ∈ Ioo (0 : ℝ) Real.pi) :
    HasDerivAt (cosineRadius r t)
      (-(r * t * Real.sin φ) / cosineRadius r t φ) φ := by
  have hpos := cosineRadius_sq_pos hr ht hφ
  have hinner : HasDerivAt (fun φ : ℝ => r ^ 2 + t ^ 2 + 2 * r * t * Real.cos φ)
      (2 * r * t * (-Real.sin φ)) φ := by
    have h := (Real.hasDerivAt_cos φ).const_mul (2 * r * t)
    simpa using h.const_add (r ^ 2 + t ^ 2)
  have h := hinner.sqrt (ne_of_gt hpos)
  unfold cosineRadius
  refine h.congr_deriv ?_
  field_simp

/-- The radius is strictly decreasing in the angle. -/
theorem strictAntiOn_cosineRadius {r t : ℝ} (hr : 0 < r) (ht : 0 < t) :
    StrictAntiOn (cosineRadius r t) (Icc (0 : ℝ) Real.pi) := by
  intro a ha b hb hab
  have hcos : Real.cos b < Real.cos a :=
    Real.strictAntiOn_cos ha hb hab
  have hrt : 0 < r * t := mul_pos hr ht
  have hlt : r ^ 2 + t ^ 2 + 2 * r * t * Real.cos b <
      r ^ 2 + t ^ 2 + 2 * r * t * Real.cos a := by nlinarith
  rw [cosineRadius, cosineRadius]
  refine Real.sqrt_lt_sqrt ?_ hlt
  nlinarith [sq_nonneg (r - t), Real.neg_one_le_cos b, hrt]

/-- **The angular window is the radial window.** -/
theorem image_cosineRadius {r t : ℝ} (hr : 0 < r) (ht : 0 < t) :
    cosineRadius r t '' Ioo (0 : ℝ) Real.pi = Ioo (|r - t|) (r + t) := by
  have hpi : (0 : ℝ) ≤ Real.pi := Real.pi_pos.le
  refine le_antisymm ?_ ?_
  · have hsub := (strictAntiOn_cosineRadius hr ht).image_Ioo_subset
    rw [cosineRadius_zero hr ht, cosineRadius_pi] at hsub
    exact hsub
  · have hIVT := intermediate_value_Ioo' hpi
      ((continuous_cosineRadius r t).continuousOn (s := Icc (0 : ℝ) Real.pi))
    rw [cosineRadius_zero hr ht, cosineRadius_pi] at hIVT
    exact hIVT

/-- The kernel identity behind the substitution: the Jacobian of the law of
cosines cancels the planar kernel. -/
theorem abs_deriv_mul_kernelTwo {r t φ : ℝ} (hr : 0 < r) (ht : 0 < t)
    (hφ : φ ∈ Ioo (0 : ℝ) Real.pi) :
    |(-(r * t * Real.sin φ) / cosineRadius r t φ)| *
        (2 * brsKernelTwo t r (cosineRadius r t φ)) = 1 := by
  have hspos := cosineRadius_pos hr ht hφ
  have hsin : 0 < Real.sin φ := Real.sin_pos_of_pos_of_lt_pi hφ.1 hφ.2
  have hrt : 0 < r * t := mul_pos hr ht
  set s : ℝ := cosineRadius r t φ with hs
  have hssq : s ^ 2 = r ^ 2 + t ^ 2 + 2 * r * t * Real.cos φ := by
    rw [hs, cosineRadius, Real.sq_sqrt (cosineRadius_sq_pos hr ht hφ).le]
  have hA : (r + t) ^ 2 - s ^ 2 = 2 * (r * t) * (1 - Real.cos φ) := by
    rw [hssq]
    ring
  have hB : s ^ 2 - (r - t) ^ 2 = 2 * (r * t) * (1 + Real.cos φ) := by
    rw [hssq]
    ring
  have h1c : (0 : ℝ) ≤ 1 - Real.cos φ := by linarith [Real.cos_le_one φ]
  have h2c : (0 : ℝ) ≤ 1 + Real.cos φ := (one_add_cos_pos hφ).le
  have hprod : Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      2 * (r * t) * Real.sin φ := by
    rw [hA, hB, ← Real.sqrt_mul (by
      have : (0 : ℝ) ≤ 2 * (r * t) := by positivity
      exact mul_nonneg this h1c)]
    rw [show 2 * (r * t) * (1 - Real.cos φ) * (2 * (r * t) * (1 + Real.cos φ)) =
        (2 * (r * t)) ^ 2 * (1 - Real.cos φ ^ 2) by ring]
    rw [Real.sqrt_mul (by positivity), Real.sqrt_sq (by positivity),
      show 1 - Real.cos φ ^ 2 = Real.sin φ ^ 2 by
        have := Real.sin_sq_add_cos_sq φ
        linarith, Real.sqrt_sq hsin.le]
  have habs : |(-(r * t * Real.sin φ) / s)| = r * t * Real.sin φ / s := by
    rw [abs_div, abs_neg, abs_of_nonneg (by positivity), abs_of_nonneg hspos.le]
  rw [habs, brsKernelTwo, hprod]
  field_simp

/-- **The kernel representation (4.1)–(4.2) in ambient dimension two.**  The
angular integral of the profile is the kernel integral over the radial
window. -/
theorem integral_kernelTwo_eq_angle {r t : ℝ} (hr : 0 < r) (ht : 0 < t)
    (f₀ : ℝ → ℂ) :
    (∫ s in Ioo (|r - t|) (r + t), (2 * brsKernelTwo t r s) • f₀ s) =
      ∫ φ in Ioo (0 : ℝ) Real.pi, f₀ (cosineRadius r t φ) := by
  have hderiv : ∀ φ ∈ Ioo (0 : ℝ) Real.pi,
      HasDerivWithinAt (cosineRadius r t)
        (-(r * t * Real.sin φ) / cosineRadius r t φ) (Ioo (0 : ℝ) Real.pi) φ := by
    intro φ hφ
    exact (hasDerivAt_cosineRadius hr ht hφ).hasDerivWithinAt
  have hinj : InjOn (cosineRadius r t) (Ioo (0 : ℝ) Real.pi) :=
    (strictAntiOn_cosineRadius hr ht).injOn.mono Ioo_subset_Icc_self
  have hsub := integral_image_eq_integral_abs_deriv_smul measurableSet_Ioo hderiv
    hinj (fun s => (2 * brsKernelTwo t r s) • f₀ s)
  rw [image_cosineRadius hr ht] at hsub
  rw [hsub]
  refine setIntegral_congr_fun measurableSet_Ioo fun φ hφ => ?_
  rw [smul_smul, abs_deriv_mul_kernelTwo hr ht hφ, one_smul]

/-! ## The test function of Lemma 3.5

BRS Lemma 3.5 tests the operator on the indicator of a thin annulus at the
*left endpoint* of the dilation interval `J`.  Its spherical average at radii
`|x| ≈ t - t_L` is large on a tangential cap of chordal width `√(δ/|x|)`,
which is what produces the exponent `(d-1)/2`. -/

/-- The test function `g_δ` of BRS Lemma 3.5: the indicator of the annulus of
radius `tL` and thickness `δ`. -/
def brsAnnulusTest (d : ℕ) (tL δ : ℝ) : Euclidean d → ℂ :=
  fun y => (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℂ)) ‖y‖

theorem measurable_brsAnnulusTest (d : ℕ) (tL δ : ℝ) :
    Measurable (brsAnnulusTest d tL δ) :=
  measurable_indicator_lift d _ _

theorem isNormRadial_brsAnnulusTest (d : ℕ) (tL δ : ℝ) :
    _root_.Auto.RadialFourierTransform.IsNormRadial (brsAnnulusTest d tL δ) :=
  isNormRadial_indicator_lift d _ _

theorem eLpNorm_brsAnnulusTest (d : ℕ) (tL δ : ℝ) {p : ℝ} (hp : 0 < p) :
    eLpNorm (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume =
      volume (radialAnnulusIcc d (tL - δ) (tL + δ)) ^ (1 / p) :=
  eLpNorm_indicator_lift d _ _ hp

theorem memLp_brsAnnulusTest {d : ℕ} (hd : 0 < d) {tL δ : ℝ} (htL : 1 ≤ tL)
    (htL2 : tL ≤ 2) (hδ : 0 < δ) (hδ1 : δ ≤ 1) {p : ℝ} (hp : 0 < p) :
    MemLp (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume := by
  refine ⟨(measurable_brsAnnulusTest d tL δ).aestronglyMeasurable, ?_⟩
  rw [eLpNorm_brsAnnulusTest d tL δ hp]
  refine ENNReal.rpow_lt_top_of_nonneg (by positivity) ?_
  have hvol := volume_thin_shell_le hd htL htL2 hδ hδ1
  refine (lt_of_le_of_lt hvol ?_).ne
  refine ENNReal.mul_lt_top ENNReal.ofReal_lt_top ?_
  exact (measure_mono Metric.ball_subset_closedBall).trans_lt measure_closedBall_lt_top

/-- **(3.5) of BRS.**  The interval constraint: every point of the tangential
cap of chordal radius `√(δ/(|x| t))` around the inward radial direction is
carried by the dilation `t` into the annulus of radius `t_L` and thickness
`δ`.  This is the geometric heart of Lemma 3.5. -/
theorem mem_annulus_of_mem_inwardCap {d : ℕ} {tL δ t : ℝ} (hδ : 0 < δ)
    (hδ1 : δ ≤ 1) (htL : 1 ≤ tL) {x : Euclidean d} (hxpos : 0 < ‖x‖) (htpos : 0 < t)
    (hclose : |t - ‖x‖ - tL| ≤ δ / 10) {ω : Euclidean d} (hωnorm : ‖ω‖ = 1)
    (hcapmem : dist ω (steinInwardRadialDirection x) <
      Real.sqrt (δ / (‖x‖ * t))) :
    ‖x + t • ω‖ ∈ Icc (tL - δ) (tL + δ) := by
  set a : ℝ := ‖x‖ with ha
  have hat : 0 < a * t := mul_pos hxpos htpos
  set v : Euclidean d := steinInwardRadialDirection x with hv
  have hvnorm : ‖v‖ = 1 := norm_steinInwardRadialDirection hxpos
  set h : ℝ := Real.sqrt (δ / (a * t)) with hh
  have hhsq : h ^ 2 = δ / (a * t) := by
    rw [hh, Real.sq_sqrt (by positivity)]
  have hinnerv : 1 - inner ℝ ω v < h ^ 2 / 2 := by
    have hsq : dist ω v ^ 2 = 2 - 2 * inner ℝ ω v := by
      rw [dist_eq_norm, norm_sub_sq_real, hωnorm, hvnorm]
      ring
    have hlt : dist ω v ^ 2 < h ^ 2 := by
      have hnn : 0 ≤ dist ω v := dist_nonneg
      nlinarith [hcapmem]
    rw [hsq] at hlt
    linarith
  have hinnerx : inner ℝ ω x ≤ -a * (1 - h ^ 2 / 2) := by
    have hvx : inner ℝ ω v = -(a⁻¹ * inner ℝ ω x) := by
      rw [hv, steinInwardRadialDirection, inner_neg_right, real_inner_smul_right, ha]
    rw [hvx] at hinnerv
    have hstep : a⁻¹ * inner ℝ ω x < h ^ 2 / 2 - 1 := by linarith
    have hmul := mul_lt_mul_of_pos_left hstep hxpos
    rw [← mul_assoc, mul_inv_cancel₀ hxpos.ne', one_mul] at hmul
    have heq : a * (h ^ 2 / 2 - 1) = -a * (1 - h ^ 2 / 2) := by ring
    linarith [hmul, heq.le, heq.ge]
  have hnormsq : ‖x + t • ω‖ ^ 2 = a ^ 2 + t ^ 2 + 2 * t * inner ℝ ω x := by
    rw [norm_add_sq_real, norm_smul, Real.norm_eq_abs, hωnorm, mul_one,
      real_inner_smul_right, sq_abs, ha]
    have hcomm : inner ℝ x ω = inner ℝ ω x := real_inner_comm _ _
    rw [hcomm]
    ring
  have hδeq : a * t * h ^ 2 = δ := by
    rw [hhsq]
    field_simp
  have hupper : ‖x + t • ω‖ ^ 2 ≤ (t - a) ^ 2 + δ := by
    have hstep : 2 * t * inner ℝ ω x ≤ 2 * t * (-a * (1 - h ^ 2 / 2)) :=
      mul_le_mul_of_nonneg_left hinnerx (by positivity)
    calc ‖x + t • ω‖ ^ 2 = a ^ 2 + t ^ 2 + 2 * t * inner ℝ ω x := hnormsq
      _ ≤ a ^ 2 + t ^ 2 + 2 * t * (-a * (1 - h ^ 2 / 2)) := by linarith
      _ = (t - a) ^ 2 + a * t * h ^ 2 := by ring
      _ = (t - a) ^ 2 + δ := by rw [hδeq]
  have hcs : -a ≤ inner ℝ ω x := by
    have hle := abs_real_inner_le_norm ω x
    rw [hωnorm, one_mul] at hle
    have habs := abs_le.mp hle
    rw [ha]
    exact habs.1
  have hlower : (t - a) ^ 2 ≤ ‖x + t • ω‖ ^ 2 := by
    have hstep : 2 * t * (-a) ≤ 2 * t * inner ℝ ω x :=
      mul_le_mul_of_nonneg_left hcs (by positivity)
    calc (t - a) ^ 2 = a ^ 2 + t ^ 2 + 2 * t * (-a) := by ring
      _ ≤ a ^ 2 + t ^ 2 + 2 * t * inner ℝ ω x := by linarith
      _ = ‖x + t • ω‖ ^ 2 := hnormsq.symm
  have hta : tL - δ / 10 ≤ t - a := by
    rw [abs_le] at hclose
    linarith [hclose.1]
  have hta' : t - a ≤ tL + δ / 10 := by
    rw [abs_le] at hclose
    linarith [hclose.2]
  have htapos : 0 < t - a := by
    have h1 : (0 : ℝ) < tL - δ / 10 := by linarith
    linarith
  have hnn : 0 ≤ ‖x + t • ω‖ := norm_nonneg _
  constructor
  · have hsq1 : (tL - δ) ^ 2 ≤ (t - a) ^ 2 := by
      refine pow_le_pow_left₀ (by linarith) ?_ 2
      linarith
    have hsqge : (tL - δ) ^ 2 ≤ ‖x + t • ω‖ ^ 2 := by linarith [hlower, hsq1]
    calc tL - δ = Real.sqrt ((tL - δ) ^ 2) := (Real.sqrt_sq (by linarith)).symm
      _ ≤ Real.sqrt (‖x + t • ω‖ ^ 2) := Real.sqrt_le_sqrt hsqge
      _ = ‖x + t • ω‖ := Real.sqrt_sq hnn
  · have hsq1 : (t - a) ^ 2 ≤ (tL + δ / 10) ^ 2 := pow_le_pow_left₀ htapos.le hta' 2
    have hsq2 : (tL + δ / 10) ^ 2 + δ ≤ (tL + δ) ^ 2 := by nlinarith [htL, hδ]
    have hsqle : ‖x + t • ω‖ ^ 2 ≤ (tL + δ) ^ 2 := by
      linarith [hupper, hsq1, hsq2]
    calc ‖x + t • ω‖ = Real.sqrt (‖x + t • ω‖ ^ 2) := (Real.sqrt_sq hnn).symm
      _ ≤ Real.sqrt ((tL + δ) ^ 2) := Real.sqrt_le_sqrt hsqle
      _ = tL + δ := Real.sqrt_sq (by linarith)

/-- **(3.4) of BRS.**  At radii `|x| ≈ t - t_L` the spherical average of the
annulus test function is bounded below by the measure of a tangential cap of
chordal radius `√(δ/(|x| t))`. -/
theorem le_sphericalAverage_annulusTest {d : ℕ} (hd : 0 < d) :
    ∃ c : ℝ, 0 < c ∧ ∀ tL δ t : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ tL → tL ≤ 2 → 1 ≤ t →
      t ≤ 2 → ∀ x : Euclidean d, 4 * δ ≤ ‖x‖ * t →
        |t - ‖x‖ - tL| ≤ δ / 10 →
          ENNReal.ofReal (c * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1)) ≤
            ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
              (brsAnnulusTest d tL δ) x‖ := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  obtain ⟨c₀, hc₀pos, hc₀top, hcap⟩ := exists_stein_unitSurfaceMeasure_cap_ge_power n
  have hmass : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  set c : ℝ := c₀.toReal / surfaceMass (n + 1) with hc
  have hc₀real : 0 < c₀.toReal := ENNReal.toReal_pos hc₀pos.ne' hc₀top
  have hcpos : 0 < c := by
    rw [hc]
    positivity
  refine ⟨c, hcpos, ?_⟩
  intro tL δ t hδ hδ1 htL htL2 ht1 ht2 x hδa hclose
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hxpos : 0 < ‖x‖ := by
    rcases lt_or_ge 0 ‖x‖ with h | h
    · exact h
    · exfalso
      have h0 : ‖x‖ = 0 := le_antisymm h (norm_nonneg _)
      rw [h0] at hδa
      simp only [zero_mul] at hδa
      linarith
  set a : ℝ := ‖x‖ with ha
  have hat : 0 < a * t := mul_pos hxpos htpos
  -- the cap radius
  set h : ℝ := Real.sqrt (δ / (a * t)) with hh
  have hhpos : 0 < h := by
    rw [hh]
    exact Real.sqrt_pos.mpr (div_pos hδ hat)
  have hhsq : h ^ 2 = δ / (a * t) := by
    rw [hh, Real.sq_sqrt (by positivity)]
  have hhhalf : h ≤ 1 / 2 := by
    have hle : δ / (a * t) ≤ 1 / 4 := by
      rw [div_le_div_iff₀ hat (by norm_num)]
      linarith
    have := Real.sqrt_le_sqrt hle
    rw [hh]
    refine le_trans this (le_of_eq ?_)
    rw [show (1 : ℝ) / 4 = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  -- the inward cap
  set v : Euclidean (n + 1) := steinInwardRadialDirection x with hv
  have hvnorm : ‖v‖ = 1 := norm_steinInwardRadialDirection hxpos
  set A : Set (Metric.sphere (0 : Euclidean (n + 1)) 1) :=
    steinSphericalCap (n + 1) v h with hA
  have hAmeas : MeasurableSet A := measurableSet_steinSphericalCap _ _ _
  -- the annulus is hit by the whole cap
  have hone : ∀ ω ∈ A, (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ))
      ‖x + t • (ω : Euclidean (n + 1))‖ = 1 := by
    intro ω hω
    have hωnorm : ‖(ω : Euclidean (n + 1))‖ = 1 := mem_sphere_zero_iff_norm.mp ω.2
    have hdist : dist ((ω : Euclidean (n + 1))) v < h := hω
    exact Set.indicator_of_mem
      (mem_annulus_of_mem_inwardCap hδ hδ1 htL hxpos htpos hclose hωnorm hdist) _
  -- the average dominates the cap fraction
  have hgmeas : Measurable (fun y : Euclidean (n + 1) =>
      (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖) :=
    (measurable_const.indicator measurableSet_Icc).comp continuous_norm.measurable
  have hgb : ∀ y : Euclidean (n + 1),
      ‖(Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖‖ ≤ 1 := by
    intro y
    by_cases hmem : ‖y‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
      norm_num
  have hint := stein_integrable_sphere_comp_of_bounded_measurable hgmeas hgb t x
  have hnonneg : ∀ ω : Metric.sphere (0 : Euclidean (n + 1)) 1,
      0 ≤ (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ))
        ‖x + t • (ω : Euclidean (n + 1))‖ := by
    intro ω
    by_cases hmem : ‖x + t • (ω : Euclidean (n + 1))‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
  have hfrac := stein_cap_fraction_le_ennreal_norm_normalizedSphericalAverage
    (by omega : 0 < n + 1)
    (fun y : Euclidean (n + 1) =>
      (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖)
    t x A hAmeas hint hnonneg hone
  have hcapbound := hcap v hvnorm h hhpos hhhalf
  -- the average agrees with the normalized one
  have hbridge : _root_.Spherical.sphericalAverage t (brsAnnulusTest (n + 1) tL δ) x =
      normalizedSphericalAverage (n + 1)
        (fun y : Euclidean (n + 1) =>
          (((Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖ : ℝ) : ℂ)) t x := by
    rw [_root_.Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
    congr 1
    funext y
    rw [brsAnnulusTest]
    by_cases hmem : ‖y‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem, Set.indicator_of_notMem hmem]
      norm_num
  rw [hbridge]
  have hstep1 : ENNReal.ofReal (c * h ^ (n + 1 - 1)) =
      c₀ * ENNReal.ofReal (h ^ n) / ENNReal.ofReal (surfaceMass (n + 1)) := by
    have hn : n + 1 - 1 = n := by omega
    rw [hn, hc, div_mul_eq_mul_div, ENNReal.ofReal_div_of_pos hmass,
      ENNReal.ofReal_mul (le_of_lt hc₀real), ENNReal.ofReal_toReal hc₀top]
  calc ENNReal.ofReal (c * h ^ (n + 1 - 1))
      = c₀ * ENNReal.ofReal (h ^ n) / ENNReal.ofReal (surfaceMass (n + 1)) := hstep1
    _ ≤ unitSurfaceMeasure (n + 1) A / ENNReal.ofReal (surfaceMass (n + 1)) :=
        ENNReal.div_le_div_right hcapbound _
    _ ≤ _ := hfrac

/-- An elementary lower bound for a difference of powers: the largest term of
the geometric factorization. -/
theorem mul_pow_le_pow_succ_sub_pow_succ {b c : ℝ} (hc : 0 ≤ c) (hcb : c ≤ b)
    (n : ℕ) : (b - c) * b ^ n ≤ b ^ (n + 1) - c ^ (n + 1) := by
  have hb : 0 ≤ b := le_trans hc hcb
  induction n with
  | zero => simp
  | succ k ih =>
    have hck : 0 ≤ c ^ (k + 1) := pow_nonneg hc _
    have hsplit : b ^ (k + 2) - c ^ (k + 2) =
        b * (b ^ (k + 1) - c ^ (k + 1)) + (b - c) * c ^ (k + 1) := by
      ring
    have hstep : b * ((b - c) * b ^ k) ≤ b * (b ^ (k + 1) - c ^ (k + 1)) :=
      mul_le_mul_of_nonneg_left ih hb
    have hpos : 0 ≤ (b - c) * c ^ (k + 1) :=
      mul_nonneg (by linarith) hck
    calc (b - c) * b ^ (k + 1) = b * ((b - c) * b ^ k) := by ring
      _ ≤ b * (b ^ (k + 1) - c ^ (k + 1)) := hstep
      _ ≤ b * (b ^ (k + 1) - c ^ (k + 1)) + (b - c) * c ^ (k + 1) := by linarith
      _ = b ^ (k + 2) - c ^ (k + 2) := hsplit.symm

/-- **The thin annulus at radius `a` has volume at least `δ a^{d-1}/5`.**  This
is the volume factor of the `ℭ_E(δ,J)` lower bound. -/
theorem volume_radialAnnulus_ge {d : ℕ} (hd : 0 < d) {a δ : ℝ} (hδ : 0 < δ)
    (hδa : δ / 10 ≤ a) :
    ENNReal.ofReal (δ / 5 * a ^ (d - 1)) *
        volume (Metric.ball (0 : Euclidean d) 1) ≤
      volume (radialAnnulusIcc d (a - δ / 10) (a + δ / 10)) := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  have hlow : (0 : ℝ) ≤ a - δ / 10 := by linarith
  have hle : a - δ / 10 ≤ a + δ / 10 := by linarith
  rw [volume_radialAnnulusIcc hd hlow hle]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  have hkey := mul_pow_le_pow_succ_sub_pow_succ hlow hle n
  have hdiff : (a + δ / 10) - (a - δ / 10) = δ / 5 := by ring
  rw [hdiff] at hkey
  have hmono : a ^ n ≤ (a + δ / 10) ^ n := by
    refine pow_le_pow_left₀ (by linarith) (by linarith) n
  have hstep : δ / 5 * a ^ n ≤ δ / 5 * (a + δ / 10) ^ n :=
    mul_le_mul_of_nonneg_left hmono (by linarith)
  simp only [Nat.add_sub_cancel]
  linarith [hkey, hstep]

/-- The annuli attached to `δ`-separated radii are pairwise disjoint. -/
theorem radialAnnulus_disjoint_of_separated {d : ℕ} {δ a b : ℝ} (hδ : 0 < δ)
    (hsep : δ ≤ |a - b|) :
    Disjoint (radialAnnulusIcc d (a - δ / 10) (a + δ / 10))
      (radialAnnulusIcc d (b - δ / 10) (b + δ / 10)) := by
  refine Set.disjoint_left.mpr fun x hxa hxb => ?_
  have h1 : ‖x‖ ∈ Icc (a - δ / 10) (a + δ / 10) := hxa
  have h2 : ‖x‖ ∈ Icc (b - δ / 10) (b + δ / 10) := hxb
  have hab : |a - b| ≤ δ / 5 := by
    rw [abs_le]
    constructor
    · linarith [h1.1, h1.2, h2.1, h2.2]
    · linarith [h1.1, h1.2, h2.1, h2.2]
  linarith [hsep, hab]

/-- **The union of the separated annuli of Lemma 3.5 is large.** -/
theorem volume_biUnion_annuli_ge {d : ℕ} (hd : 0 < d) {δ L tL : ℝ} (hδ : 0 < δ)
    (hδL : 10 * δ ≤ L) (T : Finset ℝ)
    (hright : ∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L)
    (hsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) :
    ENNReal.ofReal ((T.card : ℝ) * (δ / 5 * (L / 2) ^ (d - 1))) *
        volume (Metric.ball (0 : Euclidean d) 1) ≤
      volume (⋃ t ∈ T, radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
  classical
  have hLpos : 0 < L := by linarith
  have hmeas : ∀ t ∈ T,
      MeasurableSet (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) :=
    fun t _ => measurableSet_radialAnnulusIcc d _ _
  have hdisj : (↑T : Set ℝ).PairwiseDisjoint
      (fun t => radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
    intro t ht s hs hts
    have hsepts : δ ≤ |t - s| := hsep t (by simpa using ht) s (by simpa using hs) hts
    have habs : |(t - tL) - (s - tL)| = |t - s| := by
      congr 1
      ring
    have := radialAnnulus_disjoint_of_separated (d := d) hδ
      (by rw [habs]; exact hsepts)
    exact this
  rw [measure_biUnion_finset hdisj hmeas]
  have hterm : ∀ t ∈ T,
      ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1) ≤
        volume (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
    intro t ht
    obtain ⟨hlow, -⟩ := hright t ht
    have hat : δ / 10 ≤ t - tL := by linarith
    have hmono : (L / 2) ^ (d - 1) ≤ (t - tL) ^ (d - 1) := by
      refine pow_le_pow_left₀ (by linarith) (by linarith) _
    refine le_trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
      (volume_radialAnnulus_ge hd hδ hat)
    have hδ5 : (0 : ℝ) ≤ δ / 5 := by linarith
    exact mul_le_mul_of_nonneg_left hmono hδ5
  calc ENNReal.ofReal ((T.card : ℝ) * (δ / 5 * (L / 2) ^ (d - 1))) *
        volume (Metric.ball (0 : Euclidean d) 1)
      = (T.card : ℕ) • (ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1)) := by
        rw [nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg (T.card)),
          ENNReal.ofReal_natCast, mul_assoc]
    _ = ∑ _t ∈ T, ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1) := by
        rw [Finset.sum_const]
    _ ≤ ∑ t ∈ T, volume (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) :=
        Finset.sum_le_sum hterm

/-- **(3.3) of BRS.**  The `L^q` norm of the maximal function applied to the
annulus test function is bounded below by the entropy of a separated subset of
`E ∩ J` in the right half of `J`. -/
theorem le_eLpNorm_M_annulusTest {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq : 0 < q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
              ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) ≤
            eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume := by
  classical
  obtain ⟨c₀, hc₀, hcap⟩ := le_sphericalAverage_annulusTest hd
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hpow2 : (0 : ℝ) < (2 : ℝ) ^ (d - 1) := by positivity
  refine ⟨c₀ / 2 ^ (d - 1) * (V / (5 * 2 ^ (d - 1))) ^ (1 / q), ?_, ?_⟩
  · have h1 : (0 : ℝ) < V / (5 * 2 ^ (d - 1)) := by positivity
    have h2 : (0 : ℝ) < (V / (5 * 2 ^ (d - 1))) ^ (1 / q) :=
      Real.rpow_pos_of_pos h1 _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  have hLpos : 0 < L := by linarith
  have hδLpos : 0 < δ / L := div_pos hδ hLpos
  have hsq : 0 ≤ Real.sqrt (δ / L) := Real.sqrt_nonneg _
  set S : Set (Euclidean d) :=
    ⋃ t ∈ T, radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) with hS
  have hSmeas : MeasurableSet S := by
    rw [hS]
    exact Finset.measurableSet_biUnion _
      fun t _ => measurableSet_radialAnnulusIcc d _ _
  -- the maximal function is large on `S`
  have hlarge : ∀ x ∈ S,
      ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) ≤
        M E (brsAnnulusTest d tL δ) x := by
    intro x hx
    obtain ⟨t, htT, hxt⟩ : ∃ t ∈ T,
        x ∈ radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) := by
      rw [hS] at hx
      simpa only [Set.mem_iUnion, exists_prop] using hx
    obtain ⟨hlow, hhigh⟩ := hright t htT
    have htE : t ∈ E := hTE htT
    have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
    have hxmem : ‖x‖ ∈ Icc (t - tL - δ / 10) (t - tL + δ / 10) := hxt
    have hxlow : t - tL - δ / 10 ≤ ‖x‖ := hxmem.1
    have hxhigh : ‖x‖ ≤ t - tL + δ / 10 := hxmem.2
    have hclose : |t - ‖x‖ - tL| ≤ δ / 10 := by
      rw [abs_le]
      constructor
      · linarith
      · linarith
    have hxpos : 4 * δ ≤ ‖x‖ * t := by
      have h1 : L / 2 - δ / 10 ≤ ‖x‖ := by linarith
      have h2 : (1 : ℝ) ≤ t := htIcc.1
      have h3 : 4 * δ ≤ L / 2 - δ / 10 := by linarith
      nlinarith [h1, h2, h3, hδ]
    have havg := hcap tL δ t hδ hδ1 htL (by linarith) htIcc.1 htIcc.2 x hxpos hclose
    -- compare the cap radii
    have hxup : ‖x‖ * t ≤ 4 * L := by
      have h1 : ‖x‖ ≤ L + δ / 10 := by linarith
      have h2 : t ≤ 2 := htIcc.2
      have h3 : (0 : ℝ) ≤ ‖x‖ := norm_nonneg _
      nlinarith [h1, h2, h3, hδ, hδL]
    have hratio : δ / (4 * L) ≤ δ / (‖x‖ * t) := by
      refine div_le_div_of_nonneg_left hδ.le ?_ hxup
      have h1 : (0 : ℝ) < ‖x‖ * t := by
        nlinarith [hxpos, hδ]
      exact h1
    have hsqrt : Real.sqrt (δ / L) / 2 ≤ Real.sqrt (δ / (‖x‖ * t)) := by
      have hhalf : Real.sqrt (δ / (4 * L)) = Real.sqrt (δ / L) / 2 := by
        rw [show δ / (4 * L) = (δ / L) * (1 / 4) by ring, Real.sqrt_mul hδLpos.le,
          show (1 : ℝ) / 4 = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
        ring
      rw [← hhalf]
      exact Real.sqrt_le_sqrt hratio
    refine le_trans (le_trans (ENNReal.ofReal_le_ofReal ?_) havg) ?_
    · have hmono : (Real.sqrt (δ / L) / 2) ^ (d - 1) ≤
          Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1) :=
        pow_le_pow_left₀ (by positivity) hsqrt _
      calc c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)
          = c₀ * (Real.sqrt (δ / L) / 2) ^ (d - 1) := by
            rw [div_pow]
            ring
        _ ≤ c₀ * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1) :=
            mul_le_mul_of_nonneg_left hmono hc₀.le
    · unfold M _root_.Spherical.restrictedSphericalMaximal
      have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
      exact le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ le_rfl)
  have hlow := le_eLpNorm_of_const_le_on hSmeas
    (by positivity : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1))
    hlarge hq
  have hB : (0 : ℝ) ≤ V / (5 * 2 ^ (d - 1)) := by
    have h1 : (0 : ℝ) < 5 * 2 ^ (d - 1) := by positivity
    exact div_nonneg hVpos.le h1.le
  have hN : (0 : ℝ) ≤ (T.card : ℝ) * δ * L ^ (d - 1) := by
    have h1 : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
    have h2 : (0 : ℝ) ≤ L ^ (d - 1) := pow_nonneg hLpos.le _
    have h3 : (0 : ℝ) ≤ (T.card : ℝ) * δ := mul_nonneg h1 hδ.le
    exact mul_nonneg h3 h2
  have hA : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1) := by
    have h1 : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) := div_nonneg hc₀.le hpow2.le
    exact mul_nonneg h1 (pow_nonneg hsq _)
  have hqinv : (0 : ℝ) ≤ 1 / q := by positivity
  have hvol : ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
      ((T.card : ℝ) * δ * L ^ (d - 1))) ≤ volume S := by
    have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
    have hinner : (0 : ℝ) ≤ δ / 5 * (L / 2) ^ (d - 1) := by
      have h1 : (0 : ℝ) ≤ δ / 5 := by linarith
      have h2 : (0 : ℝ) ≤ (L / 2) ^ (d - 1) := pow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    refine le_trans (le_of_eq ?_) (volume_biUnion_annuli_ge hd hδ hδL T hright hsep)
    rw [hVeq, ← ENNReal.ofReal_mul (mul_nonneg hcard hinner)]
    congr 1
    rw [div_pow]
    ring
  have hconst : ENNReal.ofReal (c₀ / 2 ^ (d - 1) *
        (V / (5 * 2 ^ (d - 1))) ^ (1 / q) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
          ((T.card : ℝ) * δ * L ^ (d - 1))) ^ (1 / q) := by
    rw [show c₀ / 2 ^ (d - 1) * (V / (5 * 2 ^ (d - 1))) ^ (1 / q) *
          Real.sqrt (δ / L) ^ (d - 1) =
        (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          (V / (5 * 2 ^ (d - 1))) ^ (1 / q) by ring,
      ENNReal.ofReal_mul hA, mul_assoc]
    congr 1
    rw [← ENNReal.ofReal_rpow_of_nonneg hB hqinv,
      ← ENNReal.mul_rpow_of_nonneg _ _ hqinv, ← ENNReal.ofReal_mul hB]
  calc ENNReal.ofReal (c₀ / 2 ^ (d - 1) *
        (V / (5 * 2 ^ (d - 1))) ^ (1 / q) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q)
      = ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
            ((T.card : ℝ) * δ * L ^ (d - 1))) ^ (1 / q) := hconst
    _ ≤ ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          volume S ^ (1 / q) :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hvol (by positivity))
    _ ≤ eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume := hlow

/-- The square root, as a real power. -/
theorem sqrt_pow_eq_rpow {d : ℕ} (hd : 0 < d) {z : ℝ} (hz : 0 ≤ z) :
    Real.sqrt z ^ (d - 1) = z ^ (((d : ℝ) - 1) / 2) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast (z ^ (1 / 2 : ℝ)) (d - 1),
    ← Real.rpow_mul hz]
  congr 1
  have h1 : (1 : ℕ) ≤ d := hd
  push_cast [Nat.cast_sub h1]
  ring

/-- The `L^p` norm of the annulus test function is at most `(W δ)^{1/p}`. -/
theorem eLpNorm_brsAnnulusTest_le {d : ℕ} (hd : 0 < d) {tL δ : ℝ} (htL : 1 ≤ tL)
    (htL2 : tL ≤ 2) (hδ : 0 < δ) (hδ1 : δ ≤ 1) {p : ℝ} (hp : 0 < p) :
    eLpNorm (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((2 * d * 3 ^ (d - 1) * δ *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) ^ (1 / p)) := by
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hδW : (0 : ℝ) ≤ 2 * d * 3 ^ (d - 1) * δ := by positivity
  rw [eLpNorm_brsAnnulusTest d tL δ hp]
  refine le_trans (ENNReal.rpow_le_rpow (volume_thin_shell_le hd htL htL2 hδ hδ1)
    (by positivity)) (le_of_eq ?_)
  rw [hVeq, ← ENNReal.ofReal_mul hδW,
    ← ENNReal.ofReal_rpow_of_nonneg (mul_nonneg hδW hVpos.le) (by positivity)]

/-- **Lemma 3.5 of BRS, the entropy bound.**  A radial `L^p → L^q` bound forces
the quantity `ℭ_E(δ,J) = N(E ∩ J,δ)^{1/q} |J|^{-(d-1)(1/2-1/q)} δ^{(d-1)/2+1/q-1/p}`
to stay bounded, for every separated family in the right half of `J`. -/
theorem entropy_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ K : ℝ, 0 < K ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          (T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
              δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) ≤ K := by
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨c, hc, hlow⟩ := le_eLpNorm_M_annulusTest hd hE hq
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  set W : ℝ := 2 * d * 3 ^ (d - 1) * V with hW
  have hWpos : 0 < W := by
    rw [hW]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  refine ⟨C * W ^ (1 / p) / c, div_pos (mul_pos hC (Real.rpow_pos_of_pos hWpos _)) hc,
    ?_⟩
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  have hLpos : 0 < L := by linarith
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  have hδLpos : 0 < δ / L := div_pos hδ hLpos
  -- the operator bound applied to the test function
  have hmem := memLp_brsAnnulusTest hd htL (by linarith) hδ hδ1 hp
  have hrad := isNormRadial_brsAnnulusTest d tL δ
  have hup := (hbound _ hmem hrad).2
  have hnorm := eLpNorm_brsAnnulusTest_le hd htL (by linarith) hδ hδ1 hp
  have hlowδ := hlow δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  -- chain the two bounds
  have hchain : ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
      ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) ≤
      ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
    refine le_trans hlowδ (le_trans hup ?_)
    have hstep : ENNReal.ofReal C *
        eLpNorm (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C *
          ENNReal.ofReal ((2 * d * 3 ^ (d - 1) * δ * V) ^ (1 / p)) :=
      mul_le_mul' le_rfl hnorm
    refine le_trans hstep (le_of_eq ?_)
    rw [← ENNReal.ofReal_mul hC.le]
    congr 1
    congr 1
    rw [hW]
    ring
  -- pass to real numbers
  have hLHS : ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
      ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1) *
        ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q)) := by
    have hn : (0 : ℝ) ≤ (T.card : ℝ) * δ * L ^ (d - 1) := by
      have h1 : (0 : ℝ) ≤ (T.card : ℝ) * δ := mul_nonneg hcard hδ.le
      exact mul_nonneg h1 (pow_nonneg hLpos.le _)
    have ha : (0 : ℝ) ≤ c * Real.sqrt (δ / L) ^ (d - 1) :=
      mul_nonneg hc.le (pow_nonneg (Real.sqrt_nonneg _) _)
    rw [ENNReal.ofReal_mul ha,
      ← ENNReal.ofReal_rpow_of_nonneg hn (by positivity : (0 : ℝ) ≤ 1 / q)]
  rw [hLHS] at hchain
  have hreal := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hchain
  -- rewrite both sides in the `ℭ` form
  have hsqrt : Real.sqrt (δ / L) ^ (d - 1) =
      δ ^ (((d : ℝ) - 1) / 2) * L ^ (-((((d : ℝ) - 1) / 2))) := by
    rw [sqrt_pow_eq_rpow hd hδLpos.le, Real.div_rpow hδ.le hLpos.le,
      Real.rpow_neg hLpos.le, div_eq_mul_inv]
  have hprod : ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * L ^ ((((d : ℝ) - 1)) / q) := by
    have hLd : (L : ℝ) ^ (d - 1) = L ^ ((d : ℝ) - 1) := by
      rw [← Real.rpow_natCast L (d - 1)]
      congr 1
      have h1 : (1 : ℕ) ≤ d := hd
      push_cast [Nat.cast_sub h1]
      ring
    rw [hLd, Real.mul_rpow (mul_nonneg hcard hδ.le)
      (Real.rpow_nonneg hLpos.le _), Real.mul_rpow hcard hδ.le,
      ← Real.rpow_mul hLpos.le]
    congr 2
    ring
  have hcollect : c * (δ ^ (((d : ℝ) - 1) / 2) * L ^ (-((((d : ℝ) - 1) / 2)))) *
      ((T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * L ^ ((((d : ℝ) - 1)) / q)) =
      c * ((T.card : ℝ) ^ (1 / q) *
        L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
        δ ^ (((d : ℝ) - 1) / 2 + 1 / q)) := by
    rw [show -(((d : ℝ) - 1) * (1 / 2 - 1 / q)) =
        -((((d : ℝ) - 1) / 2)) + (((d : ℝ) - 1)) / q by ring,
      Real.rpow_add hLpos, Real.rpow_add hδ]
    ring
  rw [hsqrt, hprod, hcollect] at hreal
  -- divide by `δ^{1/p}`
  have hδp : (0 : ℝ) < δ ^ (1 / p) := Real.rpow_pos_of_pos hδ _
  have hsplit : (W * δ) ^ (1 / p) = W ^ (1 / p) * δ ^ (1 / p) :=
    Real.mul_rpow hWpos.le hδ.le
  rw [hsplit] at hreal
  rw [le_div_iff₀ hc]
  have hδsplit : δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) * δ ^ (1 / p) =
      δ ^ (((d : ℝ) - 1) / 2 + 1 / q) := by
    rw [← Real.rpow_add hδ]
    congr 1
    ring
  calc (T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
        δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) * c
      = c * ((T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
          δ ^ (((d : ℝ) - 1) / 2 + 1 / q)) / δ ^ (1 / p) := by
        rw [← hδsplit]
        field_simp
    _ ≤ (C * (W ^ (1 / p) * δ ^ (1 / p))) / δ ^ (1 / p) := by
        gcongr
    _ = C * W ^ (1 / p) := by
        field_simp

/-- Splitting a quotient power against a power of the denominator. -/
theorem div_rpow_mul_rpow {x y s e : ℝ} (hx : 0 ≤ x) (hy : 0 < y) :
    (x / y) ^ s * y ^ e = x ^ s * y ^ (e - s) := by
  rw [Real.div_rpow hx hy.le, Real.rpow_sub hy, div_mul_eq_mul_div, mul_div_assoc]

/-- **The per-annulus contribution is monotone in the radius.**  For `q ≥ 2`
the product of the `q`-th power of the cap bound `(δ/a)^{(d-1)/2}` with the
annulus volume `a^{d-1} δ` is nonincreasing in `a`, so the smallest
contribution comes from the largest radius `a = |J|`.  This is what removes
any restriction to the right half of `J`. -/
theorem annulus_contribution_mono {d : ℕ} (hd : 0 < d) {q δ a L : ℝ}
    (hq2 : 2 ≤ q) (hδ : 0 < δ) (ha : 0 < a) (haL : a ≤ L) :
    (δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) ≤
      (δ / a) ^ (q * ((d : ℝ) - 1) / 2) * a ^ ((d : ℝ) - 1) := by
  have hLpos : 0 < L := lt_of_lt_of_le ha haL
  have hd1 : (0 : ℝ) ≤ (d : ℝ) - 1 := by
    have h1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hes : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 ≤ 0 := by
    nlinarith [hd1, hq2]
  rw [div_rpow_mul_rpow hδ.le hLpos, div_rpow_mul_rpow hδ.le ha]
  refine mul_le_mul_of_nonneg_left ?_ (Real.rpow_nonneg hδ.le _)
  exact Real.rpow_le_rpow_of_nonpos ha haL hes

/-- The cap bound and the annulus volume, combined at a single radius. -/
theorem annulus_contribution_ge {d : ℕ} (hd : 0 < d) {q δ a L : ℝ}
    (hq2 : 2 ≤ q) (hδ : 0 < δ) (ha : 0 < a) (haL : a ≤ L) {c : ℝ} (hc : 0 ≤ c) :
    c * ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1)) ≤
      c * ((δ / a) ^ (q * ((d : ℝ) - 1) / 2) * a ^ ((d : ℝ) - 1)) :=
  mul_le_mul_of_nonneg_left (annulus_contribution_mono hd hq2 hδ ha haL) hc

/-- A natural power of a positive real, as a real power. -/
theorem pow_eq_rpow_natCast_sub_one {d : ℕ} (hd : 0 < d) {a : ℝ} (ha : 0 < a) :
    a ^ (d - 1) = a ^ ((d : ℝ) - 1) := by
  rw [← Real.rpow_natCast a (d - 1)]
  congr 1
  have h1 : (1 : ℕ) ≤ d := hd
  push_cast [Nat.cast_sub h1]
  ring

/-- **The per-annulus contribution to the `q`-th power of the norm.** -/
theorem le_setLIntegral_M_annulusTest {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq2 : 2 ≤ q) {c₀ : ℝ} (hc₀ : 0 < c₀)
    (hcap : ∀ tL δ t : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ tL → tL ≤ 2 → 1 ≤ t → t ≤ 2 →
      ∀ x : Euclidean d, 4 * δ ≤ ‖x‖ * t → |t - ‖x‖ - tL| ≤ δ / 10 →
        ENNReal.ofReal (c₀ * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1)) ≤
          ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
            (brsAnnulusTest d tL δ) x‖)
    {δ L tL : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hδL : 10 * δ ≤ L) (hL1 : L ≤ 1)
    (htL : 1 ≤ tL) (htLL : tL + L ≤ 2) {t : ℝ} (htE : t ∈ E)
    (hta : tL + 5 * δ ≤ t) (htb : t ≤ tL + L) :
    ENNReal.ofReal (c₀ ^ q / 5 *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal *
        (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
      ∫⁻ x in radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10),
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hde : (0 : ℝ) ≤ ((d : ℝ) - 1) / 2 := by linarith
  have hLpos : 0 < L := by linarith
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
  set a : ℝ := t - tL with ha
  have hapos : 5 * δ ≤ a := by
    rw [ha]
    linarith
  have haL : a ≤ L := by
    rw [ha]
    linarith
  have ha0 : 0 < a := by linarith
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  -- the pointwise lower bound on the annulus
  have hpoint : ∀ x ∈ radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
      ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) ≤
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q := by
    intro x hx
    have hxmem : ‖x‖ ∈ Icc (a - δ / 10) (a + δ / 10) := hx
    have hxlow : a - δ / 10 ≤ ‖x‖ := hxmem.1
    have hxhigh : ‖x‖ ≤ a + δ / 10 := hxmem.2
    have hxpos : 0 < ‖x‖ := by linarith
    have hclose : |t - ‖x‖ - tL| ≤ δ / 10 := by
      rw [abs_le]
      constructor
      · rw [ha] at hxhigh
        linarith
      · rw [ha] at hxlow
        linarith
    have h4δ : 4 * δ ≤ ‖x‖ * t := by
      have h1 : 4 * δ ≤ ‖x‖ := by linarith
      nlinarith [htIcc.1, hxpos]
    have havg := hcap tL δ t hδ hδ1 htL (by linarith) htIcc.1 htIcc.2 x h4δ hclose
    -- the maximal function dominates the single average
    have hM : ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
        (brsAnnulusTest d tL δ) x‖ ≤ M E (brsAnnulusTest d tL δ) x := by
      unfold M _root_.Spherical.restrictedSphericalMaximal
      exact le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ le_rfl)
    have hxt : ‖x‖ * t ≤ 4 * a := by
      have h1 : ‖x‖ ≤ 2 * a := by linarith
      nlinarith [htIcc.2, hxpos, ha0]
    have hratio : δ / (4 * a) ≤ δ / (‖x‖ * t) := by
      refine div_le_div_of_nonneg_left hδ.le ?_ hxt
      nlinarith [h4δ, hδ]
    have hbase : ENNReal.ofReal (c₀ * (δ / (4 * a)) ^ (((d : ℝ) - 1) / 2)) ≤
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ := by
      rw [enorm_eq_self]
      refine le_trans (le_trans (ENNReal.ofReal_le_ofReal ?_) havg) hM
      rw [sqrt_pow_eq_rpow hd (by positivity : (0:ℝ) ≤ δ / (‖x‖ * t))]
      refine mul_le_mul_of_nonneg_left ?_ hc₀.le
      exact Real.rpow_le_rpow (by positivity) hratio hde
    calc ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2))
        = (ENNReal.ofReal (c₀ * (δ / (4 * a)) ^ (((d : ℝ) - 1) / 2))) ^ q := by
          rw [ENNReal.ofReal_rpow_of_pos
            (mul_pos hc₀ (Real.rpow_pos_of_pos (by positivity) _))]
          congr 1
          rw [Real.mul_rpow hc₀.le (Real.rpow_nonneg (by positivity) _),
            ← Real.rpow_mul (by positivity)]
          congr 2
          ring
      _ ≤ ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q :=
          ENNReal.rpow_le_rpow hbase hq0.le
  -- integrate the pointwise bound
  have hvol := volume_radialAnnulus_ge hd hδ (by linarith : δ / 10 ≤ a)
  calc ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
      ≤ ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          ENNReal.ofReal (δ / 5 * a ^ (d - 1)) * ENNReal.ofReal V := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        refine ENNReal.ofReal_le_ofReal ?_
        have hsplit : (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2) =
            (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              (δ / a) ^ (q * ((d : ℝ) - 1) / 2) := by
          rw [show δ / (4 * a) = (1 / 4) * (δ / a) by ring,
            Real.mul_rpow (by norm_num) (by positivity)]
          congr 1
          rw [show (1 : ℝ) / 4 = (4 : ℝ)⁻¹ by norm_num,
            ← Real.rpow_neg_one (4 : ℝ), ← Real.rpow_mul (by norm_num)]
          congr 1
          ring
        have hmono := annulus_contribution_mono hd hq2 hδ ha0 haL
        have hpowa : a ^ (d - 1) = a ^ ((d : ℝ) - 1) :=
          pow_eq_rpow_natCast_sub_one hd ha0
        rw [hsplit, hpowa]
        have hfac : (0 : ℝ) ≤ c₀ ^ q / 5 * V *
            (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) * δ := by positivity
        nlinarith [hmono, hfac, mul_le_mul_of_nonneg_left hmono hfac]
    _ = ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          (ENNReal.ofReal (δ / 5 * a ^ (d - 1)) *
            volume (Metric.ball (0 : Euclidean d) 1)) := by
        rw [hVeq, mul_assoc]
    _ ≤ ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          volume (radialAnnulusIcc d (a - δ / 10) (a + δ / 10)) :=
        mul_le_mul' le_rfl hvol
    _ = ∫⁻ _x in radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
          ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) :=
        (setLIntegral_const _ _).symm
    _ ≤ ∫⁻ x in radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
          ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q :=
        setLIntegral_mono' (measurableSet_radialAnnulusIcc d _ _) hpoint

/-- **(3.3) of BRS, without the right-half restriction.**  Every `δ`-separated
family of dilations in `J`, away from the left endpoint, contributes to the
`q`-th power of the norm of the maximal function. -/
theorem le_eLpNorm_M_annulusTest_general {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq2 : 2 ≤ q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + 5 * δ ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          ENNReal.ofReal (c * (T.card : ℝ) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
            eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ^ q := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨c₀, hc₀, hcap⟩ := le_sphericalAverage_annulusTest hd
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  refine ⟨c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)), ?_, ?_⟩
  · have h1 : (0 : ℝ) < c₀ ^ q := Real.rpow_pos_of_pos hc₀ _
    have h2 : (0 : ℝ) < (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hLpos : 0 < L := by linarith
  set F : Euclidean d → ENNReal := M E (brsAnnulusTest d tL δ) with hF
  set A : ℝ → Set (Euclidean d) :=
    fun t => radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) with hA
  have hmeas : ∀ t ∈ T, MeasurableSet (A t) :=
    fun t _ => measurableSet_radialAnnulusIcc d _ _
  have hdisj : (↑T : Set ℝ).PairwiseDisjoint A := by
    intro t ht s hs hts
    have hsepts : δ ≤ |t - s| := hsep t (by simpa using ht) s (by simpa using hs) hts
    have habs : |(t - tL) - (s - tL)| = |t - s| := by
      congr 1
      ring
    exact radialAnnulus_disjoint_of_separated (d := d) hδ (by rw [habs]; exact hsepts)
  -- the norm as an integral
  have hnorm : eLpNorm F (ENNReal.ofReal q) volume ^ q = ∫⁻ x, ‖F x‖ₑ ^ q := by
    have hq0' : ENNReal.ofReal q ≠ 0 := by
      simp only [ne_eq, ENNReal.ofReal_eq_zero]
      exact not_le.mpr hq0
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq0' ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal hq0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  rw [hnorm]
  -- restrict to the union of the annuli
  have hunion : (∫⁻ x in ⋃ t ∈ T, A t, ‖F x‖ₑ ^ q) ≤ ∫⁻ x, ‖F x‖ₑ ^ q :=
    lintegral_mono' Measure.restrict_le_self fun _ => le_rfl
  refine le_trans ?_ hunion
  rw [lintegral_biUnion_finset hdisj hmeas]
  -- each annulus contributes the same amount
  have hterm : ∀ t ∈ T,
      ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
        ∫⁻ x in A t, ‖F x‖ₑ ^ q := by
    intro t ht
    obtain ⟨hta, htb⟩ := hrange t ht
    exact le_setLIntegral_M_annulusTest hd hE hq2 hc₀ hcap hδ hδ1 hδL hL1 htL
      htLL (hTE (by simpa using ht)) hta htb
  calc ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        (T.card : ℝ) * ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
      = (T.card : ℕ) • ENNReal.ofReal (c₀ ^ q / 5 * V *
          (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) := by
        rw [nsmul_eq_mul]
        rw [show c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              (T.card : ℝ) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ) =
            (T.card : ℝ) * (c₀ ^ q / 5 * V *
              (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
            by ring,
          ENNReal.ofReal_mul (Nat.cast_nonneg (T.card)), ENNReal.ofReal_natCast]
    _ = ∑ _t ∈ T, ENNReal.ofReal (c₀ ^ q / 5 * V *
          (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) := by
        rw [Finset.sum_const]
    _ ≤ ∑ t ∈ T, ∫⁻ x in A t, ‖F x‖ₑ ^ q := Finset.sum_le_sum hterm

/-- **Lemma 3.5 of BRS, in profile form.**  A radial `L^p → L^q` bound with
`q ≥ 2` bounds the Legendre profile `|J|^{-α} N(E ∩ J, δ)` with
`α = (d-1)(q/2-1)` by `M δ^{-B}`, `B = q(d-1)/2 + 1 - q/p`. -/
theorem profile_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + 5 * δ ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) ≤
            M * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨c, hc, hlow⟩ := le_eLpNorm_M_annulusTest_general hd hE hq2
  obtain ⟨C, hC, hbound⟩ := h
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  set W : ℝ := 2 * d * 3 ^ (d - 1) * V with hW
  have hWpos : 0 < W := by
    rw [hW]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  refine ⟨C ^ q * W ^ (q / p) / c, ?_, ?_⟩
  · have h1 : (0 : ℝ) < C ^ q := Real.rpow_pos_of_pos hC _
    have h2 : (0 : ℝ) < W ^ (q / p) := Real.rpow_pos_of_pos hWpos _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hLpos : 0 < L := by linarith
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  -- the upper bound from the operator
  have hmem := memLp_brsAnnulusTest hd htL (by linarith) hδ hδ1 hp
  have hrad := isNormRadial_brsAnnulusTest d tL δ
  have hup := (hbound _ hmem hrad).2
  have hnorm := eLpNorm_brsAnnulusTest_le hd htL (by linarith) hδ hδ1 hp
  have hupq : eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ^ q ≤
      ENNReal.ofReal (C ^ q * (W * δ) ^ (q / p)) := by
    have hstep : eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
      refine le_trans hup ?_
      refine le_trans (mul_le_mul' le_rfl hnorm) (le_of_eq ?_)
      rw [← ENNReal.ofReal_mul hC.le]
      congr 1
      rw [show W * δ = 2 * d * 3 ^ (d - 1) * δ * V by rw [hW]; ring]
    refine le_trans (ENNReal.rpow_le_rpow hstep hq0.le) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_pos
      (mul_pos hC (Real.rpow_pos_of_pos (mul_pos hWpos hδ) _))]
    congr 1
    rw [Real.mul_rpow hC.le (Real.rpow_nonneg (mul_pos hWpos hδ).le _),
      ← Real.rpow_mul (mul_pos hWpos hδ).le]
    congr 2
    field_simp
  -- combine with the lower bound
  have hlowδ := hlow δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hchain := le_trans hlowδ hupq
  have hreal := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hchain
  -- unwind the exponents
  have hsplit : (δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) =
      δ ^ (q * ((d : ℝ) - 1) / 2) *
        L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) :=
    div_rpow_mul_rpow hδ.le hLpos
  rw [hsplit] at hreal
  have hWsplit : (W * δ) ^ (q / p) = W ^ (q / p) * δ ^ (q / p) :=
    Real.mul_rpow hWpos.le hδ.le
  rw [hWsplit] at hreal
  -- solve for the profile quantity
  have hposδ : (0 : ℝ) < δ ^ (q * ((d : ℝ) - 1) / 2) * δ := by positivity
  have hpow : δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
      (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) = δ ^ (q / p) := by
    rw [show δ ^ (q * ((d : ℝ) - 1) / 2) * δ =
        δ ^ (q * ((d : ℝ) - 1) / 2 + 1) by
      rw [Real.rpow_add hδ, Real.rpow_one], ← Real.rpow_add hδ]
    congr 1
    ring
  rw [show C ^ q * W ^ (q / p) / c *
        δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) =
      (C ^ q * W ^ (q / p) * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p))) / c
      by ring, le_div_iff₀ hc]
  have hmul : L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
      (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := by
    calc L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
          (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)
        = c * (T.card : ℝ) *
            (δ ^ (q * ((d : ℝ) - 1) / 2) *
              L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * δ) := by ring
      _ ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := hreal
  have hgoal : L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c ≤
      C ^ q * W ^ (q / p) * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
    rw [← mul_le_mul_iff_of_pos_right hposδ]
    calc L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
          (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)
        ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := hmul
      _ = C ^ q * W ^ (q / p) *
            (δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
              (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)) := by
          rw [hpow]
          ring
      _ = C ^ q * W ^ (q / p) *
            δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
            (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) := by ring
  exact hgoal

/-- **The Legendre profile term is bounded, for every interval.**  This is
Lemma 3.5 in the form needed by the Legendre--Assouad function: the count of a
`δ`-separated family inside an arbitrary interval `I`, weighted by
`|I|^{-α}` with `α = (d-1)(q/2-1)`, is `O(δ^{-B})`,
`B = q(d-1)/2 + 1 - q/p`. -/
theorem profile_term_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p)
    (hq2 : 2 ≤ q) (h : HasRadialStrongType d E (ENNReal.ofReal p)
      (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ a R : ℝ, 0 < δ → δ ≤ 1 / 100 → 2 * δ ≤ R → R ≤ 1 →
      ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E ∩ Icc a (a + R) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          R ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) ≤
            M * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hqpd : q ≤ p * d := le_mul_of_hasRadialStrongType hd hE hEne hp hq0 h
  set α : ℝ := ((d : ℝ) - 1) * (q / 2 - 1) with hα
  set B : ℝ := q * ((d : ℝ) - 1) / 2 + 1 - q / p with hB
  have hαnonneg : 0 ≤ α := by
    rw [hα]
    have h1 : (0 : ℝ) ≤ (d : ℝ) - 1 := by linarith
    have h2 : (0 : ℝ) ≤ q / 2 - 1 := by linarith
    exact mul_nonneg h1 h2
  have hαB : α ≤ B := by
    rw [hα, hB]
    have hqp : q / p ≤ (d : ℝ) := by
      rw [div_le_iff₀ hp]
      linarith [hqpd]
    nlinarith [hqp, hd1]
  have hexp : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 = -α := by
    rw [hα]
    ring
  obtain ⟨M₀, hM₀, hprof⟩ := profile_bound_of_hasRadialStrongType hd hE hp hq2 h
  refine ⟨M₀ + 11, by linarith, ?_⟩
  intro δ a R hδ hδ1 hδR hR1 T hTsub hsep
  have hRpos : 0 < R := by linarith
  have hδle1 : δ ≤ 1 := by linarith
  have hTE : (↑T : Set ℝ) ⊆ E := fun t ht => (hTsub ht).1
  have hTI : ∀ t ∈ T, a ≤ t ∧ t ≤ a + R := by
    intro t ht
    have hmem := (hTsub (by simpa using ht)).2
    exact ⟨hmem.1, hmem.2⟩
  have hT12 : ∀ t ∈ T, (1 : ℝ) ≤ t ∧ t ≤ 2 := by
    intro t ht
    have hmem := hE (hTE (by simpa using ht))
    exact ⟨hmem.1, hmem.2⟩
  set u : ℝ := max a 1 with hu
  set v : ℝ := min (a + R) 2 with hv
  have hTu : ∀ t ∈ T, u ≤ t := by
    intro t ht
    rw [hu, max_le_iff]
    exact ⟨(hTI t ht).1, (hT12 t ht).1⟩
  have hTv : ∀ t ∈ T, t ≤ v := by
    intro t ht
    rw [hv, le_min_iff]
    exact ⟨(hTI t ht).2, (hT12 t ht).2⟩
  have hu1 : (1 : ℝ) ≤ u := le_max_right _ _
  have hv2 : v ≤ 2 := min_le_right _ _
  have hvu : v - u ≤ R := by
    have h1 : v ≤ a + R := min_le_left _ _
    have h2 : a ≤ u := le_max_left _ _
    linarith
  -- the two scale comparisons
  have hδα : δ ^ (-α) ≤ δ ^ (-B) :=
    Real.rpow_le_rpow_of_exponent_ge hδ hδle1 (by linarith)
  have hRα : R ^ (-α) ≤ δ ^ (-α) :=
    Real.rpow_le_rpow_of_nonpos hδ (by linarith) (by linarith)
  have hRB : R ^ (-α) ≤ δ ^ (-B) := le_trans hRα hδα
  have hRαpos : 0 < R ^ (-α) := Real.rpow_pos_of_pos hRpos _
  rw [hexp]
  by_cases hcase : v - u < 10 * δ
  · -- a short interval carries few separated points
    have hsub : ∀ t ∈ T, t ∈ Icc u (u + (10 : ℕ) * δ) := by
      intro t ht
      refine ⟨hTu t ht, ?_⟩
      have h1 := hTv t ht
      push_cast
      linarith
    have hcard := brrs_card_le_succ_of_separated_in_interval (S := T) (a := u)
      (len := δ) (n := 10) hδ hsub hsep
    have hcardR : (T.card : ℝ) ≤ 11 := by
      have : (T.card : ℝ) ≤ ((10 : ℕ) + 1 : ℕ) := by exact_mod_cast hcard
      push_cast at this
      linarith
    calc R ^ (-α) * (T.card : ℝ) ≤ R ^ (-α) * 11 :=
          mul_le_mul_of_nonneg_left hcardR hRαpos.le
      _ ≤ δ ^ (-B) * 11 := mul_le_mul_of_nonneg_right hRB (by norm_num)
      _ ≤ (M₀ + 11) * δ ^ (-B) := by
          have hδBpos : 0 < δ ^ (-B) := Real.rpow_pos_of_pos hδ _
          nlinarith [hδBpos, hM₀]
  · -- the main case
    push_neg at hcase
    set L : ℝ := v - u with hL
    have hL10 : 10 * δ ≤ L := by
      rw [hL]
      exact hcase
    have hLpos : 0 < L := by linarith
    have hL1 : L ≤ 1 := by
      rw [hL]
      linarith
    have huL : u + L ≤ 2 := by
      rw [hL]
      linarith
    set T₁ : Finset ℝ := T.filter (fun t => u + 5 * δ ≤ t) with hT₁
    set T₀ : Finset ℝ := T.filter (fun t => ¬ (u + 5 * δ ≤ t)) with hT₀
    have hsplit : T₁.card + T₀.card = T.card := by
      rw [hT₁, hT₀]
      exact Finset.card_filter_add_card_filter_not (p := fun t => u + 5 * δ ≤ t)
    have hcard₀ : (T₀.card : ℝ) ≤ 6 := by
      have hsub₀ : ∀ t ∈ T₀, t ∈ Icc u (u + (5 : ℕ) * δ) := by
        intro t ht
        rw [hT₀, Finset.mem_filter] at ht
        refine ⟨hTu t ht.1, ?_⟩
        have := ht.2
        push_cast
        linarith [not_le.mp this]
      have hsep₀ : ∀ t ∈ T₀, ∀ s ∈ T₀, t ≠ s → δ ≤ |t - s| := by
        intro t ht s hs hts
        rw [hT₀, Finset.mem_filter] at ht hs
        exact hsep t ht.1 s hs.1 hts
      have hc := brrs_card_le_succ_of_separated_in_interval (S := T₀) (a := u)
        (len := δ) (n := 5) hδ hsub₀ hsep₀
      have : (T₀.card : ℝ) ≤ ((5 : ℕ) + 1 : ℕ) := by exact_mod_cast hc
      push_cast at this
      linarith
    have hT₁E : (↑T₁ : Set ℝ) ⊆ E := by
      intro t ht
      simp only [hT₁, Finset.coe_filter, Set.mem_setOf_eq] at ht
      exact hTE (by simpa using ht.1)
    have hT₁range : ∀ t ∈ T₁, u + 5 * δ ≤ t ∧ t ≤ u + L := by
      intro t ht
      rw [hT₁, Finset.mem_filter] at ht
      refine ⟨ht.2, ?_⟩
      have := hTv t ht.1
      rw [hL]
      linarith
    have hT₁sep : ∀ t ∈ T₁, ∀ s ∈ T₁, t ≠ s → δ ≤ |t - s| := by
      intro t ht s hs hts
      rw [hT₁, Finset.mem_filter] at ht hs
      exact hsep t ht.1 s hs.1 hts
    have hprofT₁ := hprof δ L u hδ hδle1 hL10 hL1 hu1 huL T₁ hT₁E hT₁range hT₁sep
    rw [hexp] at hprofT₁
    -- compare the interval scales
    have hLR : R ^ (-α) ≤ L ^ (-α) :=
      Real.rpow_le_rpow_of_nonpos hLpos (by linarith) (by linarith)
    have hcardsplit : (T.card : ℝ) = (T₁.card : ℝ) + (T₀.card : ℝ) := by
      rw [← hsplit]
      push_cast
      ring
    have hδBpos : 0 < δ ^ (-B) := Real.rpow_pos_of_pos hδ _
    calc R ^ (-α) * (T.card : ℝ)
        = R ^ (-α) * (T₁.card : ℝ) + R ^ (-α) * (T₀.card : ℝ) := by
          rw [hcardsplit]
          ring
      _ ≤ L ^ (-α) * (T₁.card : ℝ) + R ^ (-α) * 6 := by
          have h1 : R ^ (-α) * (T₁.card : ℝ) ≤ L ^ (-α) * (T₁.card : ℝ) :=
            mul_le_mul_of_nonneg_right hLR (Nat.cast_nonneg _)
          have h2 : R ^ (-α) * (T₀.card : ℝ) ≤ R ^ (-α) * 6 :=
            mul_le_mul_of_nonneg_left hcard₀ hRαpos.le
          linarith
      _ ≤ M₀ * δ ^ (-B) + δ ^ (-B) * 6 := by
          have h2 : R ^ (-α) * 6 ≤ δ ^ (-B) * 6 :=
            mul_le_mul_of_nonneg_right hRB (by norm_num)
          linarith [hprofT₁]
      _ ≤ (M₀ + 11) * δ ^ (-B) := by nlinarith [hδBpos]

/-- **The Legendre--Assouad profile is bounded by a power of the scale.**  This
is Lemma 3.5 in exactly the shape consumed by
`brrsLegendreAssouadFunction_le_of_profile_power_bound`. -/
theorem brrsProfile_le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p)
    (hq2 : 2 ≤ q) (h : HasRadialStrongType d E (ENNReal.ofReal p)
      (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ : ℝ≥0, 0 < δ → (δ : ℝ) ≤ 1 / 100 →
      _root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadProfile E
          (((d : ℝ) - 1) * (q / 2 - 1)) δ ≤
        ENNReal.ofReal M *
          (δ : ℝ≥0∞) ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨M₀, hM₀, hterm⟩ :=
    profile_term_bound_of_hasRadialStrongType hd hE hEne hp hq2 h
  set α : ℝ := ((d : ℝ) - 1) * (q / 2 - 1) with hα
  set B : ℝ := q * ((d : ℝ) - 1) / 2 + 1 - q / p with hB
  have hexp : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 = -α := by
    rw [hα]
    ring
  refine ⟨M₀ * (2 : ℝ) ^ B, ?_, ?_⟩
  · have h2 : (0 : ℝ) < (2 : ℝ) ^ B := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  intro δ hδpos hδ100
  have hδR : (0 : ℝ) < (δ : ℝ) := hδpos
  rw [_root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadProfile]
  refine iSup_le fun a => iSup_le fun R => ?_
  obtain ⟨hRδ, hR1⟩ := R.2
  have hRposR : (0 : ℝ) < (R.1 : ℝ) := lt_of_lt_of_le hδR (by exact_mod_cast hRδ)
  have hR1R : (R.1 : ℝ) ≤ 1 := by exact_mod_cast hR1
  -- a maximal separated subset of the local piece
  set I : Set ℝ := _root_.Auto.Spherical.LegendreAssouad.brrsInterval a (R.1 : ℝ)
    with hI
  have hEI : E ∩ I ⊆ Icc (1 : ℝ) 2 := fun t ht => hE ht.1
  obtain ⟨T, hT⟩ := exists_isMaximalSeparatedSubset hEI
    (by positivity : (0 : ℝ) < ((δ / 2 : ℝ≥0) : ℝ))
  have hhalf : (2 : ℝ≥0) * (δ / 2) = δ := by
    rw [mul_comm]
    field_simp
  have hentropy : _root_.Auto.Spherical.LegendreAssouad.brrsEntropyNumber
      (E ∩ I) δ ≤ (T.card : ℝ≥0∞) := by
    have := brrsEntropyNumber_le_card_of_isMaximalSeparatedSubset
      (E := E ∩ I) (δ := δ / 2) (by positivity) hT
    rwa [hhalf] at this
  -- the real bound
  have hδ2R : (0 : ℝ) < ((δ / 2 : ℝ≥0) : ℝ) := by positivity
  have hδ2val : ((δ / 2 : ℝ≥0) : ℝ) = (δ : ℝ) / 2 := by
    push_cast
    ring
  have hTsub : (↑T : Set ℝ) ⊆ E ∩ Icc a (a + (R.1 : ℝ)) := by
    intro t ht
    have := hT.1 ht
    exact ⟨this.1, this.2⟩
  have hTsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → ((δ : ℝ) / 2) ≤ |t - s| := by
    intro t ht s hs hts
    have := hT.2.1 (by simpa using ht) (by simpa using hs) hts
    rwa [hδ2val] at this
  have hbound := hterm ((δ : ℝ) / 2) a (R.1 : ℝ) (by positivity)
    (by linarith) (by linarith [hRδ, (by exact_mod_cast hRδ : (δ : ℝ) ≤ (R.1 : ℝ))])
    hR1R T hTsub hTsep
  rw [hexp] at hbound
  -- transfer to `ℝ≥0∞`
  have hcast : ((R.1 : ℝ≥0) : ℝ≥0∞) ^ (-α) *
      _root_.Auto.Spherical.LegendreAssouad.brrsEntropyNumber (E ∩ I) δ ≤
      ENNReal.ofReal ((R.1 : ℝ) ^ (-α) * (T.card : ℝ)) := by
    have h1 : ((R.1 : ℝ≥0) : ℝ≥0∞) ^ (-α) =
        ENNReal.ofReal ((R.1 : ℝ) ^ (-α)) := by
      rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_rpow_of_pos hRposR]
    rw [h1, ENNReal.ofReal_mul (Real.rpow_nonneg hRposR.le _)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hentropy (le_of_eq ?_)
    rw [ENNReal.ofReal_natCast]
  refine le_trans hcast ?_
  -- the power of the half scale
  have hhalfpow : ((δ : ℝ) / 2) ^ (-B) = (2 : ℝ) ^ B * (δ : ℝ) ^ (-B) := by
    rw [Real.div_rpow hδR.le (by norm_num), Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2),
      div_eq_mul_inv, inv_inv]
    ring
  have hfinal : (R.1 : ℝ) ^ (-α) * (T.card : ℝ) ≤
      M₀ * (2 : ℝ) ^ B * (δ : ℝ) ^ (-B) := by
    refine le_trans hbound (le_of_eq ?_)
    rw [hhalfpow]
    ring
  refine le_trans (ENNReal.ofReal_le_ofReal hfinal) (le_of_eq ?_)
  rw [ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_coe_nnreal,
    ENNReal.ofReal_rpow_of_pos hδR]

/-- **Lemma 3.5 of BRS.**  For `q ≥ 2` a radial `L^p → L^q` bound forces the
Legendre-Assouad function to satisfy
`(1/q) ν♯((d-1)(q/2-1)) + 1/p - 1/q ≤ (d-1)/2`. -/
theorem legendreAssouad_le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ}
    (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    _root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) ≤
      q * ((d : ℝ) - 1) / 2 + 1 - q / p := by
  obtain ⟨M, hM, hprof⟩ :=
    brrsProfile_le_of_hasRadialStrongType hd hE hEne hp hq2 h
  refine _root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction_le_of_profile_power_bound
    hEne (M := M) ENNReal.ofReal_ne_top ?_
  have hmem : Set.Ioo (0 : ℝ≥0) (1 / 100) ∈ 𝓝[>] (0 : ℝ≥0) :=
    Ioo_mem_nhdsGT (by norm_num)
  filter_upwards [hmem] with δ hδ
  refine hprof δ hδ.1 ?_
  have h2 : (δ : ℝ) < ((1 / 100 : ℝ≥0) : ℝ) := by exact_mod_cast hδ.2
  push_cast at h2
  linarith

/-- The same conclusion in the normalized form printed in BRS. -/
theorem legendreAssouad_condition_of_hasRadialStrongType {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ}
    (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    (1 / q) * _root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) + 1 / p - 1 / q ≤ ((d : ℝ) - 1) / 2 := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hle := legendreAssouad_le_of_hasRadialStrongType hd hE hEne hp hq2 h
  have hmul : (1 / q) *
      _root_.Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) ≤
      (1 / q) * (q * ((d : ℝ) - 1) / 2 + 1 - q / p) :=
    mul_le_mul_of_nonneg_left hle (by positivity)
  have hsimp : (1 / q) * (q * ((d : ℝ) - 1) / 2 + 1 - q / p) =
      ((d : ℝ) - 1) / 2 + 1 / q - 1 / p := by
    field_simp
  rw [hsimp] at hmul
  linarith [hmul]

/-! ## The planar kernel, split at the two endpoint singularities

For `d = 2` the kernel `K_t(r,s) = s / (√((r+t)²-s²) √(s²-(r-t)²))` has an
inverse square-root singularity at each endpoint of the window.  On the half
of the window nearest `|r-t|` only the left singularity is active, and on the
other half only the right one; this is the source of the operators `𝔐_p^±` of
BRS Lemma 5.1. -/

/-- The distance from the window endpoints to its midpoint is `min r t`. -/
theorem window_half_width (r t : ℝ) : r + t - |r - t| = 2 * min r t := by
  rcases le_total r t with h | h
  · rw [abs_of_nonpos (by linarith), min_eq_left h]
    ring
  · rw [abs_of_nonneg (by linarith), min_eq_right h]
    ring

/-- **The planar kernel near the left endpoint.** -/
theorem brsKernelTwo_le_left {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| ≤ s) (hs2 : 2 * s ≤ |r - t| + (r + t)) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) * (Real.sqrt s / Real.sqrt (s - |r - t|)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have htpos : 0 < t := by linarith
  have hmin : r / 2 ≤ min r t := by
    rcases le_total r t with h | h
    · rw [min_eq_left h]
      linarith
    · rw [min_eq_right h]
      linarith
  have hleft : r / 2 ≤ r + t - s := by
    have hw := window_half_width r t
    have : 2 * s ≤ 2 * (r + t) - 2 * min r t := by
      rw [show 2 * (r + t) - 2 * min r t = (r + t) + (r + t - 2 * min r t) by ring,
        ← hw]
      linarith
    linarith [hmin]
  have hsum : 3 * r / 2 ≤ r + t + s := by linarith
  -- factor the two square roots
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  -- lower bounds for the harmless factors
  have hrootA : Real.sqrt (r / 2) ≤ Real.sqrt (r + t - s) :=
    Real.sqrt_le_sqrt hleft
  have hrootB : Real.sqrt (3 * r / 2) ≤ Real.sqrt (r + t + s) :=
    Real.sqrt_le_sqrt hsum
  have hrootC : Real.sqrt s ≤ Real.sqrt (s + |r - t|) :=
    Real.sqrt_le_sqrt (by linarith)
  have hprod : Real.sqrt (r / 2) * Real.sqrt (3 * r / 2) = Real.sqrt 3 * r / 2 := by
    rw [← Real.sqrt_mul (by linarith)]
    rw [show r / 2 * (3 * r / 2) = 3 * (r / 2) ^ 2 by ring,
      Real.sqrt_mul (by norm_num), Real.sqrt_sq (by linarith)]
    ring
  rcases eq_or_lt_of_le hs1 with hEq | hlt
  · -- at the left endpoint both sides vanish
    have hz : s - |r - t| = 0 := by linarith [hEq]
    rw [brsKernelTwo, hfacB, hz, Real.sqrt_zero]
    simp
  · have hpos : 0 < s - |r - t| := by linarith
    have hspos : 0 < s := lt_of_le_of_lt habs hlt
    have hrootpos : 0 < Real.sqrt (s - |r - t|) := Real.sqrt_pos.mpr hpos
    have hsrootpos : 0 < Real.sqrt s := Real.sqrt_pos.mpr hspos
    have hAB : Real.sqrt 3 * r / 2 * (Real.sqrt (s - |r - t|) * Real.sqrt s) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      rw [hfacA, hfacB, ← hprod]
      gcongr
    have hdenpos : 0 < Real.sqrt 3 * r / 2 *
        (Real.sqrt (s - |r - t|) * Real.sqrt s) := by
      have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
      positivity
    have hDpos : 0 < Real.sqrt ((r + t) ^ 2 - s ^ 2) *
        Real.sqrt (s ^ 2 - (r - t) ^ 2) := lt_of_lt_of_le hdenpos hAB
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    have hrewrite : 2 / (Real.sqrt 3 * r) *
        (Real.sqrt s / Real.sqrt (s - |r - t|)) =
        (2 * Real.sqrt s) / (Real.sqrt 3 * r * Real.sqrt (s - |r - t|)) := by
      field_simp
    rw [brsKernelTwo, hrewrite, div_le_div_iff₀ hDpos (by positivity)]
    have hssqrt : Real.sqrt s * Real.sqrt s = s := Real.mul_self_sqrt hs0
    calc s * (Real.sqrt 3 * r * Real.sqrt (s - |r - t|))
        = (Real.sqrt 3 * r / 2 * (Real.sqrt (s - |r - t|) * Real.sqrt s)) *
            (2 * Real.sqrt s) := by
          rw [show (Real.sqrt 3 * r / 2 *
              (Real.sqrt (s - |r - t|) * Real.sqrt s)) * (2 * Real.sqrt s) =
            Real.sqrt 3 * r * Real.sqrt (s - |r - t|) *
              (Real.sqrt s * Real.sqrt s) by ring, hssqrt]
          ring
      _ ≤ (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) * (2 * Real.sqrt s) := by
          refine mul_le_mul_of_nonneg_right hAB ?_
          positivity
      _ = 2 * Real.sqrt s * (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) := by ring

/-- **The planar kernel near the right endpoint.** -/
theorem brsKernelTwo_le_right {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| + (r + t) ≤ 2 * s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) * (Real.sqrt s / Real.sqrt (r + t - s)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have htpos : 0 < t := by linarith
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hmin : r / 2 ≤ min r t := by
    rcases le_total r t with h | h
    · rw [min_eq_left h]
      linarith
    · rw [min_eq_right h]
      linarith
  have hright : r / 2 ≤ s - |r - t| := by
    have hw := window_half_width r t
    have h2 : 2 * min r t ≤ 2 * s - 2 * |r - t| := by
      rw [← hw]
      linarith
    linarith [hmin]
  have hsum : 3 * r / 2 ≤ r + t + s := by
    have : (0 : ℝ) ≤ s := hs0
    linarith
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  have hprod : Real.sqrt (3 * r / 2) * Real.sqrt (r / 2) = Real.sqrt 3 * r / 2 := by
    rw [← Real.sqrt_mul (by linarith)]
    rw [show 3 * r / 2 * (r / 2) = 3 * (r / 2) ^ 2 by ring,
      Real.sqrt_mul (by norm_num), Real.sqrt_sq (by linarith)]
    ring
  rcases eq_or_lt_of_le hs2 with hEq | hlt
  · have hz : r + t - s = 0 := by linarith [hEq]
    rw [brsKernelTwo, hfacA, hz, Real.sqrt_zero]
    simp
  · have hpos : 0 < r + t - s := by linarith
    have hspos : 0 < s := by
      have : r / 2 ≤ s - |r - t| := hright
      linarith
    have hrootpos : 0 < Real.sqrt (r + t - s) := Real.sqrt_pos.mpr hpos
    have hAB : Real.sqrt 3 * r / 2 * (Real.sqrt (r + t - s) * Real.sqrt s) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      have hstep : Real.sqrt (r + t - s) * Real.sqrt (3 * r / 2) *
          (Real.sqrt (r / 2) * Real.sqrt s) ≤
          Real.sqrt (r + t - s) * Real.sqrt (r + t + s) *
            (Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|)) := by
        gcongr
        linarith
      rw [hfacA, hfacB]
      refine le_trans (le_of_eq ?_) hstep
      rw [← hprod]
      ring
    have hdenpos : 0 < Real.sqrt 3 * r / 2 *
        (Real.sqrt (r + t - s) * Real.sqrt s) := by
      have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
      have h4 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hspos
      positivity
    have hDpos : 0 < Real.sqrt ((r + t) ^ 2 - s ^ 2) *
        Real.sqrt (s ^ 2 - (r - t) ^ 2) := lt_of_lt_of_le hdenpos hAB
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    have hrewrite : 2 / (Real.sqrt 3 * r) *
        (Real.sqrt s / Real.sqrt (r + t - s)) =
        (2 * Real.sqrt s) / (Real.sqrt 3 * r * Real.sqrt (r + t - s)) := by
      field_simp
    rw [brsKernelTwo, hrewrite, div_le_div_iff₀ hDpos (by positivity)]
    have hssqrt : Real.sqrt s * Real.sqrt s = s := Real.mul_self_sqrt hs0
    calc s * (Real.sqrt 3 * r * Real.sqrt (r + t - s))
        = (Real.sqrt 3 * r / 2 * (Real.sqrt (r + t - s) * Real.sqrt s)) *
            (2 * Real.sqrt s) := by
          rw [show (Real.sqrt 3 * r / 2 *
              (Real.sqrt (r + t - s) * Real.sqrt s)) * (2 * Real.sqrt s) =
            Real.sqrt 3 * r * Real.sqrt (r + t - s) *
              (Real.sqrt s * Real.sqrt s) by ring, hssqrt]
          ring
      _ ≤ (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) * (2 * Real.sqrt s) := by
          refine mul_le_mul_of_nonneg_right hAB ?_
          positivity
      _ = 2 * Real.sqrt s * (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) := by ring

/-! ## The operators of BRS Lemma 5.1

In the plane the two endpoint singularities of the kernel are separated into
two maximal operators `𝔐_p^±`, and the dilations away from the radius give the
two remainders `R_1^±`, `R_2^±`. -/

/-- The main term `𝔐_p^-` of BRS (5.1): the left endpoint singularity. -/
def brsMainTwoLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)

/-- The main term `𝔐_p^+` of BRS (5.1): the right endpoint singularity. -/
def brsMainTwoRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)

/-- The integrand of `𝔐_p^-` applied to the substituted profile is the planar
kernel weight `√s (s - |r-t|)^{-1/2}` against the profile itself. -/
theorem brsMainTwoLeft_integrand {p : ℝ} (hp : 0 < p) (f₀ : ℝ → ℂ) {r t s : ℝ}
    (hs : 0 < s) :
    ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        brsProfileSub 2 p f₀ s =
      ((s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
  rw [brsProfileSub]
  have hcast : ((2 : ℕ) : ℝ) - 1 = 1 := by norm_num
  rw [hcast]
  have hmul : (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
      s ^ (1 / p) = s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
    rw [show s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) * s ^ (1 / p) =
        (s ^ (1 / 2 - 1 / p) * s ^ (1 / p)) *
          (s - |r - t|) ^ (-(1 / 2) : ℝ) by ring,
      ← Real.rpow_add hs]
    congr 2
    ring
  calc ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        (((s ^ (1 / p) : ℝ) : ℂ) * f₀ s)
      = ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) *
          s ^ (1 / p) : ℝ) : ℂ) * f₀ s := by
        push_cast
        ring
    _ = ((s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
        rw [hmul]

/-- The same identity for the right endpoint. -/
theorem brsMainTwoRight_integrand {p : ℝ} (hp : 0 < p) (f₀ : ℝ → ℂ) {r t s : ℝ}
    (hs : 0 < s) :
    ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        brsProfileSub 2 p f₀ s =
      ((s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
  rw [brsProfileSub]
  have hcast : ((2 : ℕ) : ℝ) - 1 = 1 := by norm_num
  rw [hcast]
  have hmul : (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
      s ^ (1 / p) = s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
    rw [show s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) * s ^ (1 / p) =
        (s ^ (1 / 2 - 1 / p) * s ^ (1 / p)) *
          (r + t - s) ^ (-(1 / 2) : ℝ) by ring,
      ← Real.rpow_add hs]
    congr 2
    ring
  calc ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        (((s ^ (1 / p) : ℝ) : ℂ) * f₀ s)
      = ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) *
          s ^ (1 / p) : ℝ) : ℂ) * f₀ s := by
        push_cast
        ring
    _ = ((s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
        rw [hmul]

/-- The planar kernel is dominated by the two half-window weights. -/
theorem brsKernelTwo_le_sum {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| ≤ s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) *
        (s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) +
          s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have hsqrt : Real.sqrt s = s ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow s
  have hleftw : Real.sqrt s / Real.sqrt (s - |r - t|) =
      s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
    rw [hsqrt, Real.sqrt_eq_rpow, div_eq_mul_inv,
      ← Real.rpow_neg_one ((s - |r - t|) ^ (1 / 2 : ℝ)),
      ← Real.rpow_mul (by linarith : (0:ℝ) ≤ s - |r - t|)]
    congr 2
    ring
  have hrightw : Real.sqrt s / Real.sqrt (r + t - s) =
      s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
    rw [hsqrt, Real.sqrt_eq_rpow, div_eq_mul_inv,
      ← Real.rpow_neg_one ((r + t - s) ^ (1 / 2 : ℝ)),
      ← Real.rpow_mul (by linarith : (0:ℝ) ≤ r + t - s)]
    congr 2
    ring
  have hconst : (0 : ℝ) < 2 / (Real.sqrt 3 * r) := by
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    positivity
  rcases le_total (2 * s) (|r - t| + (r + t)) with hcase | hcase
  · refine le_trans (brsKernelTwo_le_left hr ht1 hs1 hcase) ?_
    rw [hleftw]
    refine mul_le_mul_of_nonneg_left ?_ hconst.le
    have hnn : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    linarith
  · refine le_trans (brsKernelTwo_le_right hr ht1 hcase hs2) ?_
    rw [hrightw]
    refine mul_le_mul_of_nonneg_left ?_ hconst.le
    have hnn : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    linarith

/-- **The planar kernel, with the two harmless factors bounded below.** -/
theorem brsKernelTwo_le_generic {r t s P Q : ℝ} (hs1 : |r - t| ≤ s)
    (hs2 : s ≤ r + t) (hP : 0 < P) (hQ : 0 < Q) (hPle : P ≤ r + t + s)
    (hQle : Q ≤ s + |r - t|) :
    brsKernelTwo t r s ≤
      s / (Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|))) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  have hrootP : Real.sqrt P ≤ Real.sqrt (r + t + s) := Real.sqrt_le_sqrt hPle
  have hrootQ : Real.sqrt Q ≤ Real.sqrt (s + |r - t|) := Real.sqrt_le_sqrt hQle
  have hPpos : 0 < Real.sqrt P := Real.sqrt_pos.mpr hP
  have hQpos : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQ
  by_cases hdeg : Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|) = 0
  · rcases mul_eq_zero.mp hdeg with h | h
    · rw [brsKernelTwo, hfacA, h]
      simp [hdeg]
    · rw [brsKernelTwo, hfacB, h]
      simp [hdeg]
  · have hpos : 0 < Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|) := by
      rcases lt_or_eq_of_le (mul_nonneg (Real.sqrt_nonneg (r + t - s))
        (Real.sqrt_nonneg (s - |r - t|))) with h | h
      · exact h
      · exact absurd h.symm hdeg
    have hden : 0 < Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|)) := by positivity
    have hcompare : Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|)) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      rw [hfacA, hfacB]
      calc Real.sqrt P * Real.sqrt Q *
            (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|))
          = Real.sqrt (r + t - s) * Real.sqrt P *
              (Real.sqrt (s - |r - t|) * Real.sqrt Q) := by ring
        _ ≤ Real.sqrt (r + t - s) * Real.sqrt (r + t + s) *
              (Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|)) := by gcongr
    rw [brsKernelTwo]
    exact div_le_div_of_nonneg_left hs0 hden hcompare

/-- Dividing out one of the two singular factors. -/
theorem kernel_div_step {K s c A D C : ℝ} (hK : K ≤ s / (c * (A * D)))
    (hc : 0 < c) (hApos : 0 < A) (hD : 0 ≤ D) (hs : s ≤ C * c) :
    K ≤ C * A⁻¹ * D⁻¹ := by
  by_cases hDz : D = 0
  · rw [hDz] at hK ⊢
    simpa using hK
  · have hDpos : 0 < D := lt_of_le_of_ne hD (Ne.symm hDz)
    refine le_trans hK ?_
    rw [div_le_iff₀ (by positivity)]
    calc s ≤ C * c := hs
      _ = C * A⁻¹ * D⁻¹ * (c * (A * D)) := by
          field_simp

/-- Swapping one singular factor for a lower bound. -/
theorem kernel_swap_step {s c A A' D : ℝ} (hs0 : 0 ≤ s) (hc : 0 < c)
    (hApos : 0 < A) (hAA : A ≤ A') (hD : 0 ≤ D) :
    s / (c * (A' * D)) ≤ s / (c * (A * D)) := by
  by_cases hz : D = 0
  · rw [hz]
    simp
  · have hDpos : 0 < D := lt_of_le_of_ne hD (Ne.symm hz)
    refine div_le_div_of_nonneg_left hs0 (by positivity) ?_
    have hmono : A * D ≤ A' * D := mul_le_mul_of_nonneg_right hAA hD
    exact mul_le_mul_of_nonneg_left hmono hc.le

/-- **The planar kernel for small dilations, left half.** -/
theorem brsKernelTwo_le_small_left {r t s : ℝ} (hr : 0 < r) (ht : 0 < t)
    (htr : t ≤ r / 2) (hs1 : r - t ≤ s) (hs2 : s ≤ r) :
    brsKernelTwo t r s ≤ 1 * (Real.sqrt t)⁻¹ * (Real.sqrt (s - (r - t)))⁻¹ := by
  have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := r) (Q := r) (by rw [habs]; linarith) (by linarith) hr hr
    (by linarith) (by rw [habs]; linarith)
  rw [habs, Real.mul_self_sqrt hr.le] at hgen
  have hswap := kernel_swap_step (s := s) (c := r) (A := Real.sqrt t)
    (A' := Real.sqrt (r + t - s)) (D := Real.sqrt (s - (r - t))) hs0 hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := r) (A := Real.sqrt t)
    (D := Real.sqrt (s - (r - t))) (C := 1) (le_trans hgen hswap) hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for small dilations, right half.** -/
theorem brsKernelTwo_le_small_right {r t s : ℝ} (hr : 0 < r) (ht : 0 < t)
    (htr : t ≤ r / 2) (hs1 : r ≤ s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤ 2 * (Real.sqrt t)⁻¹ * (Real.sqrt (r + t - s))⁻¹ := by
  have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := r) (Q := r) (by rw [habs]; linarith) (by linarith) hr hr
    (by linarith) (by rw [habs]; linarith)
  rw [habs, Real.mul_self_sqrt hr.le] at hgen
  -- reorder the two singular factors
  have hcomm : s / (r * (Real.sqrt (r + t - s) * Real.sqrt (s - (r - t)))) =
      s / (r * (Real.sqrt (s - (r - t)) * Real.sqrt (r + t - s))) := by
    rw [mul_comm (Real.sqrt (r + t - s)) (Real.sqrt (s - (r - t)))]
  rw [hcomm] at hgen
  have hswap := kernel_swap_step (s := s) (c := r) (A := Real.sqrt t)
    (A' := Real.sqrt (s - (r - t))) (D := Real.sqrt (r + t - s)) hs0 hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := r) (A := Real.sqrt t)
    (D := Real.sqrt (r + t - s)) (C := 2) (le_trans hgen hswap) hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for large dilations, left half.** -/
theorem brsKernelTwo_le_large_left {r t s : ℝ} (hr : 0 < r) (htr : 3 * r / 2 ≤ t)
    (hs1 : t - r ≤ s) (hs2 : s ≤ t) :
    brsKernelTwo t r s ≤ 2 * (Real.sqrt r)⁻¹ * (Real.sqrt (s - (t - r)))⁻¹ := by
  have htpos : 0 < t := by linarith
  have habs : |r - t| = t - r := by
    rw [abs_of_nonpos (by linarith)]
    ring
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := t) (Q := t / 4) (by rw [habs]; linarith) (by linarith) htpos
    (by linarith) (by linarith) (by rw [habs]; linarith)
  rw [habs] at hgen
  have hprod : Real.sqrt t * Real.sqrt (t / 4) = t / 2 := by
    rw [← Real.sqrt_mul htpos.le]
    rw [show t * (t / 4) = (t / 2) ^ 2 by ring, Real.sqrt_sq (by linarith)]
  rw [hprod] at hgen
  have hswap := kernel_swap_step (s := s) (c := t / 2) (A := Real.sqrt r)
    (A' := Real.sqrt (r + t - s)) (D := Real.sqrt (s - (t - r))) hs0 (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := t / 2) (A := Real.sqrt r)
    (D := Real.sqrt (s - (t - r))) (C := 2) (le_trans hgen hswap) (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for large dilations, right half.** -/
theorem brsKernelTwo_le_large_right {r t s : ℝ} (hr : 0 < r)
    (htr : 3 * r / 2 ≤ t) (hs1 : t ≤ s) (hs2 : s ≤ t + r) :
    brsKernelTwo t r s ≤ 4 * (Real.sqrt r)⁻¹ * (Real.sqrt (r + t - s))⁻¹ := by
  have htpos : 0 < t := by linarith
  have habs : |r - t| = t - r := by
    rw [abs_of_nonpos (by linarith)]
    ring
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := t) (Q := t / 4) (by rw [habs]; linarith) (by linarith) htpos
    (by linarith) (by linarith) (by rw [habs]; linarith)
  rw [habs] at hgen
  have hprod : Real.sqrt t * Real.sqrt (t / 4) = t / 2 := by
    rw [← Real.sqrt_mul htpos.le]
    rw [show t * (t / 4) = (t / 2) ^ 2 by ring, Real.sqrt_sq (by linarith)]
  rw [hprod] at hgen
  have hcomm : s / (t / 2 * (Real.sqrt (r + t - s) * Real.sqrt (s - (t - r)))) =
      s / (t / 2 * (Real.sqrt (s - (t - r)) * Real.sqrt (r + t - s))) := by
    rw [mul_comm (Real.sqrt (r + t - s)) (Real.sqrt (s - (t - r)))]
  rw [hcomm] at hgen
  have hswap := kernel_swap_step (s := s) (c := t / 2) (A := Real.sqrt r)
    (A' := Real.sqrt (s - (t - r))) (D := Real.sqrt (r + t - s)) hs0 (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := t / 2) (A := Real.sqrt r)
    (D := Real.sqrt (r + t - s)) (C := 4) (le_trans hgen hswap) (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_nonneg _) (by linarith)

/-- The planar radial spherical average as a kernel integral over the window. -/
theorem sphericalAverage_two_eq_kernel_integral {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {x : Euclidean 2} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
      (((surfaceMass 2)⁻¹ * surfaceMass 1 : ℝ) : ℂ) *
        ∫ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
          (2 * brsKernelTwo t ‖x‖ s) • f₀ s := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hangle := sphericalAverage_comp_norm_two f₀ hf₀ hx t
  rw [hangle]
  congr 1
  have hpi : (0 : ℝ) ≤ Real.pi := Real.pi_pos.le
  have hset : (∫ φ in (0 : ℝ)..Real.pi,
      f₀ (Real.sqrt (‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * Real.cos φ))) =
      ∫ φ in Ioo (0 : ℝ) Real.pi, f₀ (cosineRadius ‖x‖ t φ) := by
    rw [intervalIntegral.integral_of_le hpi, ← integral_Ioc_eq_integral_Ioo]
    rfl
  rw [hset, ← integral_kernelTwo_eq_angle hr ht f₀]

/-- **The planar kernel bound for the spherical average.** -/
theorem ofReal_norm_sphericalAverage_two_le {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {x : Euclidean 2} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ENNReal.ofReal ((surfaceMass 2)⁻¹ * surfaceMass 1) *
        ∫⁻ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
          ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖) := by
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hmass2 : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  have hc : (0 : ℝ) ≤ (surfaceMass 2)⁻¹ * surfaceMass 1 := by positivity
  rw [sphericalAverage_two_eq_kernel_integral hf₀ hx ht, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg hc,
    ENNReal.ofReal_mul hc]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (le_of_eq (ofReal_norm _)) ?_
  refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
  refine setLIntegral_congr_fun measurableSet_Ioo fun s hs => ?_
  have hs0 : 0 ≤ s := le_trans (abs_nonneg _) (le_of_lt hs.1)
  have hker : 0 ≤ brsKernelTwo t ‖x‖ s := by
    rw [brsKernelTwo]
    exact div_nonneg hs0 (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  rw [← ofReal_norm ((2 * brsKernelTwo t ‖x‖ s) • f₀ s), norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (by linarith : (0:ℝ) ≤ 2 * brsKernelTwo t ‖x‖ s)]

/-- The inverse square-root singularity at the left endpoint is integrable. -/
theorem intervalIntegrable_left_weight (a b : ℝ) :
    IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ)) volume a b := by
  have hbase := intervalIntegral.intervalIntegrable_rpow'
    (a := a - a) (b := b - a) (r := (-(1 / 2) : ℝ)) (by norm_num)
  have hshift := hbase.comp_sub_right a
  simpa using hshift

/-- The inverse square-root singularity at the right endpoint is integrable. -/
theorem intervalIntegrable_right_weight (a b : ℝ) :
    IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ)) volume a b := by
  have hbase := intervalIntegral.intervalIntegrable_rpow'
    (a := b - a) (b := b - b) (r := (-(1 / 2) : ℝ)) (by norm_num)
  have hrefl := hbase.comp_sub_left b
  simpa using hrefl

/-- The `𝔐_p^-` integrand is interval integrable. -/
theorem intervalIntegrable_weight_left_mul {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable
      (fun s => (s - a) ^ (-(1 / 2) : ℝ) * (s ^ (1 / 2 : ℝ) * ‖f₀ s‖))
      volume a b :=
  (intervalIntegrable_left_weight a b).mul_continuousOn
    (((continuous_rpow_const_of_nonneg (by norm_num : (0:ℝ) ≤ 1 / 2)).mul
      hf₀.norm).continuousOn)

/-- The `𝔐_p^+` integrand is interval integrable. -/
theorem intervalIntegrable_weight_right_mul {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable
      (fun s => (b - s) ^ (-(1 / 2) : ℝ) * (s ^ (1 / 2 : ℝ) * ‖f₀ s‖))
      volume a b :=
  (intervalIntegrable_right_weight a b).mul_continuousOn
    (((continuous_rpow_const_of_nonneg (by norm_num : (0:ℝ) ≤ 1 / 2)).mul
      hf₀.norm).continuousOn)

/-- The `R_1^±` and `R_2^±` integrands are interval integrable. -/
theorem intervalIntegrable_weight_left_profile {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) volume a b :=
  (intervalIntegrable_left_weight a b).mul_continuousOn hf₀.norm.continuousOn

theorem intervalIntegrable_weight_right_profile {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) volume a b :=
  (intervalIntegrable_right_weight a b).mul_continuousOn hf₀.norm.continuousOn

/-- A nonnegative interval integral, as a lower Lebesgue integral over the open
window. -/
theorem lintegral_Ioo_eq_ofReal_intervalIntegral {F : ℝ → ℝ} {a b : ℝ}
    (hab : a ≤ b) (hint : IntervalIntegrable F volume a b)
    (hnn : ∀ s ∈ Ioo a b, 0 ≤ F s) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (F s)) =
      ENNReal.ofReal (∫ s in a..b, F s) := by
  have hIoc : IntegrableOn F (Ioc a b) volume := by
    rw [← intervalIntegrable_iff_integrableOn_Ioc_of_le hab]
    exact hint
  have hIoo : IntegrableOn F (Ioo a b) volume :=
    hIoc.mono_set Ioo_subset_Ioc_self
  have hae : 0 ≤ᵐ[volume.restrict (Ioo a b)] F := by
    refine (ae_restrict_iff' measurableSet_Ioo).mpr ?_
    filter_upwards with s hs
    exact hnn s hs
  rw [intervalIntegral.integral_of_le hab, integral_Ioc_eq_integral_Ioo,
    MeasureTheory.ofReal_integral_eq_lintegral_ofReal hIoo hae]

/-- **The main range of BRS Lemma 5.1.**  For dilations comparable to the
radius the window integral is controlled by the two main terms. -/
theorem lintegral_window_le_mainTwo {p : ℝ} (hp : 0 < p) {E : Set ℝ} {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (ht1 : r / 2 < t) (ht2 : t < 3 * r / 2) :
    (∫⁻ s in Ioo (|r - t|) (r + t),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal (4 / Real.sqrt 3) *
        (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
          brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have htpos : 0 < t := by linarith
  have hab : |r - t| ≤ r + t := by
    rw [abs_le]
    constructor <;> linarith
  have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  set c : ℝ := 4 / (Real.sqrt 3 * r) with hc
  have hcpos : 0 < c := by
    rw [hc]
    positivity
  set W₁ : ℝ → ℝ := fun s => s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ)
    with hW₁
  set W₂ : ℝ → ℝ := fun s => s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ)
    with hW₂
  have hW₁nn : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ W₁ s := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₁]
    exact mul_nonneg (Real.rpow_nonneg hs0 _)
      (Real.rpow_nonneg (by linarith [hs.1]) _)
  have hW₂nn : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ W₂ s := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₂]
    exact mul_nonneg (Real.rpow_nonneg hs0 _)
      (Real.rpow_nonneg (by linarith [hs.2]) _)
  -- the pointwise kernel bound
  have hpoint : ∀ s ∈ Ioo (|r - t|) (r + t),
      ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖) ≤
        ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) +
          ENNReal.ofReal (c * (W₂ s * ‖f₀ s‖)) := by
    intro s hs
    have hker := brsKernelTwo_le_sum hr ht1 (le_of_lt hs.1) (le_of_lt hs.2)
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    have h1nn : 0 ≤ W₁ s := hW₁nn s hs
    have h2nn : 0 ≤ W₂ s := hW₂nn s hs
    have h2K : 2 * brsKernelTwo t r s ≤ c * (W₁ s + W₂ s) := by
      have hmul := mul_le_mul_of_nonneg_left hker (by norm_num : (0:ℝ) ≤ 2)
      calc 2 * brsKernelTwo t r s
          ≤ 2 * (2 / (Real.sqrt 3 * r) *
              (s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) +
                s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ))) := hmul
        _ = c * (W₁ s + W₂ s) := by
            rw [hc, hW₁, hW₂]
            ring
    have hstep : 2 * brsKernelTwo t r s * ‖f₀ s‖ ≤
        c * (W₁ s * ‖f₀ s‖) + c * (W₂ s * ‖f₀ s‖) := by
      calc 2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ (c * (W₁ s + W₂ s)) * ‖f₀ s‖ :=
            mul_le_mul_of_nonneg_right h2K hfn
        _ = c * (W₁ s * ‖f₀ s‖) + c * (W₂ s * ‖f₀ s‖) := by ring
    refine le_trans (ENNReal.ofReal_le_ofReal hstep) (le_of_eq ?_)
    rw [ENNReal.ofReal_add (mul_nonneg hcpos.le (mul_nonneg h1nn hfn))
      (mul_nonneg hcpos.le (mul_nonneg h2nn hfn))]
  have hmono : (∫⁻ s in Ioo (|r - t|) (r + t),
      ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ∫⁻ s in Ioo (|r - t|) (r + t),
        (ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) +
          ENNReal.ofReal (c * (W₂ s * ‖f₀ s‖))) := by
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ioo] with s hs
    exact hpoint s hs
  refine le_trans hmono ?_
  -- split the two pieces
  have hmeas₁ : Measurable fun s : ℝ => ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) := by
    refine ENNReal.measurable_ofReal.comp ?_
    rw [hW₁]
    exact measurable_const.mul (((by fun_prop : Measurable fun s : ℝ =>
      s ^ (1 / 2 : ℝ)).mul
      (by fun_prop : Measurable fun s : ℝ =>
        (s - |r - t|) ^ (-(1 / 2) : ℝ))).mul hf₀.norm.measurable)
  rw [lintegral_add_left' hmeas₁.aemeasurable]
  -- each piece is an interval integral
  have hint₁ : IntervalIntegrable (fun s => c * (W₁ s * ‖f₀ s‖)) volume
      (|r - t|) (r + t) := by
    rw [hW₁]
    exact ((intervalIntegrable_weight_left_mul hf₀ (|r - t|) (r + t)).congr
      (fun s _ => by ring)).const_mul c
  have hint₂ : IntervalIntegrable (fun s => c * (W₂ s * ‖f₀ s‖)) volume
      (|r - t|) (r + t) := by
    rw [hW₂]
    exact ((intervalIntegrable_weight_right_mul hf₀ (|r - t|) (r + t)).congr
      (fun s _ => by ring)).const_mul c
  have hnn₁ : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ c * (W₁ s * ‖f₀ s‖) := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₁]
    have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
    have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.1]) _
    have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hnn₂ : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ c * (W₂ s * ‖f₀ s‖) := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₂]
    have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
    have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.2]) _
    have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  rw [lintegral_Ioo_eq_ofReal_intervalIntegral hab hint₁ hnn₁,
    lintegral_Ioo_eq_ofReal_intervalIntegral hab hint₂ hnn₂]
  -- compare with the two operators
  have hmemt : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  have hcr : c * r = 4 / Real.sqrt 3 := by
    rw [hc]
    field_simp
  have hpiece : ∀ (W : ℝ → ℝ) (Wop : ℝ → ℝ)
      (hWeq : ∀ s : ℝ, 0 < s → ((Wop s : ℝ) : ℂ) *
        brsProfileSub 2 p (absProfile f₀) s = ((W s : ℝ) : ℂ) * absProfile f₀ s)
      (hWnn : ∀ s ∈ Icc (|r - t|) (r + t), 0 ≤ W s * ‖f₀ s‖)
      (Mop : ENNReal)
      (hMop : ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s‖) ≤ Mop),
      ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W s * ‖f₀ s‖)) ≤
        ENNReal.ofReal (4 / Real.sqrt 3) * Mop := by
    intro W Wop hWeq hWnn Mop hMop
    have hcongr : (∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s) =
        ((∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ : ℝ) : ℂ) := by
      rw [← intervalIntegral.integral_ofReal]
      refine intervalIntegral.integral_congr_ae
        (Filter.Eventually.of_forall fun s hs => ?_)
      have hmin : (0 : ℝ) ≤ min (|r - t|) (r + t) := le_min habs (by linarith)
      have hs0 : 0 < s := lt_of_le_of_lt hmin (Set.mem_Ioc.mp hs).1
      rw [hWeq s hs0, absProfile]
      push_cast
      ring
    have hnorm : ‖∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s‖ =
        ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ := by
      rw [hcongr, Complex.norm_real,
        Real.norm_of_nonneg (intervalIntegral.integral_nonneg hab hWnn)]
    rw [hnorm] at hMop
    have hconst : (∫ s in |r - t|..(r + t), c * (W s * ‖f₀ s‖)) =
        c * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ := by
      rw [intervalIntegral.integral_const_mul]
    rw [hconst]
    have hsplit : c * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ =
        (4 / Real.sqrt 3) * (r⁻¹ * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖) := by
      rw [← hcr]
      field_simp
    rw [hsplit, ENNReal.ofReal_mul (by positivity)]
    exact mul_le_mul' le_rfl hMop
  have hleft := hpiece W₁ (fun s => s ^ (1 / 2 - 1 / p) *
      (s - |r - t|) ^ (-(1 / 2) : ℝ))
    (fun s hs => brsMainTwoLeft_integrand hp (absProfile f₀) hs)
    (fun s hs => by
      have hs0 : (0 : ℝ) ≤ s := le_trans habs hs.1
      rw [hW₁]
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith [hs.1]) _
      have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
      positivity)
    (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r)
    (by
      rw [brsMainTwoLeft]
      exact le_iSup₂_of_le t hmemt le_rfl)
  have hright := hpiece W₂ (fun s => s ^ (1 / 2 - 1 / p) *
      (r + t - s) ^ (-(1 / 2) : ℝ))
    (fun s hs => brsMainTwoRight_integrand hp (absProfile f₀) hs)
    (fun s hs => by
      have hs0 : (0 : ℝ) ≤ s := le_trans habs hs.1
      rw [hW₂]
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith [hs.2]) _
      have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
      positivity)
    (brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r)
    (by
      rw [brsMainTwoRight]
      exact le_iSup₂_of_le t hmemt le_rfl)
  calc ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W₁ s * ‖f₀ s‖)) +
        ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W₂ s * ‖f₀ s‖))
      ≤ ENNReal.ofReal (4 / Real.sqrt 3) *
          brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
          ENNReal.ofReal (4 / Real.sqrt 3) *
            brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r :=
        add_le_add hleft hright
    _ = ENNReal.ofReal (4 / Real.sqrt 3) *
          (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
            brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r) := by
        rw [mul_add]

/-- A window integral bounded by a weight integral. -/
theorem lintegral_subwindow_le {W : ℝ → ℝ} {f₀ : ℝ → ℂ} {r t a b C : ℝ}
    (hab : a ≤ b)
    (hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b)
    (hnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖))
    (hker : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖)) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal (∫ s in a..b, C * (W s * ‖f₀ s‖)) := by
  rw [← lintegral_Ioo_eq_ofReal_intervalIntegral hab hint hnn]
  refine lintegral_mono_ae ?_
  filter_upwards [self_mem_ae_restrict measurableSet_Ioo] with s hs
  exact ENNReal.ofReal_le_ofReal (hker s hs)

/-! ## The remainder operators of BRS Lemma 5.1 -/

/-- `R_1^-`: small dilations, left endpoint. -/
def brsRemTwoOneLeft (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in (r - t)..r,
      ((|s - (r - t)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_1^+`: small dilations, right endpoint. -/
def brsRemTwoOneRight (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in r..(r + t),
      ((|r + t - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_2^-`: large dilations, left endpoint. -/
def brsRemTwoTwoLeft (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_2^+`: large dilations, right endpoint. -/
def brsRemTwoTwoRight (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- The square root, as an inverse power. -/
theorem sqrt_inv_eq_rpow {z : ℝ} (hz : 0 ≤ z) :
    (Real.sqrt z)⁻¹ = z ^ (-(1 / 2) : ℝ) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_neg_one (z ^ (1 / 2 : ℝ)),
    ← Real.rpow_mul hz]
  congr 1
  ring

/-- **A remainder window with the singularity at the left endpoint.** -/
theorem lintegral_window_le_rem_left {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {r t a b P C : ℝ} (hab : a ≤ b) (hP : 0 < P) (hC : 0 ≤ C)
    (hker : ∀ s ∈ Ioo a b, 2 * brsKernelTwo t r s ≤
      C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ)))
    {Mop : ENNReal}
    (hop : ENNReal.ofReal (P ^ (-(1 / 2) : ℝ) * ‖∫ s in a..b,
      ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * absProfile f₀ s‖) ≤ Mop) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal C * Mop := by
  set W : ℝ → ℝ := fun s => P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ) with hW
  have hWnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    rw [hW]
    have h1 : (0 : ℝ) ≤ P ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hP.le _
    have h2 : (0 : ℝ) ≤ (s - a) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.1]) _
    have h3 : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b := by
    rw [hW]
    exact (((intervalIntegrable_weight_left_profile hf₀ a b).const_mul
      (P ^ (-(1 / 2) : ℝ))).congr (fun s _ => by ring)).const_mul C
  have hpt : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    calc 2 * brsKernelTwo t r s * ‖f₀ s‖
        ≤ (C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ))) * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_right (hker s hs) hfn
      _ = C * (W s * ‖f₀ s‖) := by
          rw [hW]
          ring
  refine le_trans (lintegral_subwindow_le hab hint hWnn hpt) ?_
  -- identify the interval integral with the operator term
  have hcongr : (∫ s in a..b, ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s) =
      ((∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s hs => ?_
    rw [uIcc_of_le hab] at hs
    rw [abs_of_nonneg (by linarith [hs.1] : (0:ℝ) ≤ s - a), absProfile]
    push_cast
    ring
  have hnorm : ‖∫ s in a..b, ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s‖ = ∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ := by
    rw [hcongr, Complex.norm_real, Real.norm_of_nonneg
      (intervalIntegral.integral_nonneg hab fun s hs =>
        mul_nonneg (Real.rpow_nonneg (by linarith [hs.1]) _) (norm_nonneg _))]
  rw [hnorm] at hop
  have hsplit : (∫ s in a..b, C * (W s * ‖f₀ s‖)) =
      C * (P ^ (-(1 / 2) : ℝ) *
        ∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) := by
    rw [hW]
    rw [show (fun s => C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ) *
        ‖f₀ s‖)) = (fun s => (C * P ^ (-(1 / 2) : ℝ)) *
          ((s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖)) by
      funext s
      ring]
    rw [intervalIntegral.integral_const_mul]
    ring
  rw [hsplit, ENNReal.ofReal_mul hC]
  exact mul_le_mul' le_rfl hop

/-- **A remainder window with the singularity at the right endpoint.** -/
theorem lintegral_window_le_rem_right {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {r t a b P C : ℝ} (hab : a ≤ b) (hP : 0 < P) (hC : 0 ≤ C)
    (hker : ∀ s ∈ Ioo a b, 2 * brsKernelTwo t r s ≤
      C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ)))
    {Mop : ENNReal}
    (hop : ENNReal.ofReal (P ^ (-(1 / 2) : ℝ) * ‖∫ s in a..b,
      ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * absProfile f₀ s‖) ≤ Mop) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal C * Mop := by
  set W : ℝ → ℝ := fun s => P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ) with hW
  have hWnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    rw [hW]
    have h1 : (0 : ℝ) ≤ P ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hP.le _
    have h2 : (0 : ℝ) ≤ (b - s) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.2]) _
    have h3 : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b := by
    rw [hW]
    exact (((intervalIntegrable_weight_right_profile hf₀ a b).const_mul
      (P ^ (-(1 / 2) : ℝ))).congr (fun s _ => by ring)).const_mul C
  have hpt : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    calc 2 * brsKernelTwo t r s * ‖f₀ s‖
        ≤ (C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ))) * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_right (hker s hs) hfn
      _ = C * (W s * ‖f₀ s‖) := by
          rw [hW]
          ring
  refine le_trans (lintegral_subwindow_le hab hint hWnn hpt) ?_
  have hcongr : (∫ s in a..b, ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s) =
      ((∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s hs => ?_
    rw [uIcc_of_le hab] at hs
    rw [abs_of_nonneg (by linarith [hs.2] : (0:ℝ) ≤ b - s), absProfile]
    push_cast
    ring
  have hnorm : ‖∫ s in a..b, ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s‖ = ∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ := by
    rw [hcongr, Complex.norm_real, Real.norm_of_nonneg
      (intervalIntegral.integral_nonneg hab fun s hs =>
        mul_nonneg (Real.rpow_nonneg (by linarith [hs.2]) _) (norm_nonneg _))]
  rw [hnorm] at hop
  have hsplit : (∫ s in a..b, C * (W s * ‖f₀ s‖)) =
      C * (P ^ (-(1 / 2) : ℝ) *
        ∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) := by
    rw [hW]
    rw [show (fun s => C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ) *
        ‖f₀ s‖)) = (fun s => (C * P ^ (-(1 / 2) : ℝ)) *
          ((b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖)) by
      funext s
      ring]
    rw [intervalIntegral.integral_const_mul]
    ring
  rw [hsplit, ENNReal.ofReal_mul hC]
  exact mul_le_mul' le_rfl hop

/-- **Small dilations, left half.** -/
theorem lintegral_small_left_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (htr : t ≤ r / 2) :
    (∫⁻ s in Ioo (r - t) r,
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 2 * brsRemTwoOneLeft E (absProfile f₀) r := by
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  refine lintegral_window_le_rem_left hf₀ (by linarith) htpos (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_small_left hr htpos htr (le_of_lt hs.1)
      (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow htpos.le,
      sqrt_inv_eq_rpow (by linarith [hs.1] : (0:ℝ) ≤ s - (r - t))] at hb
    have hfn : (0 : ℝ) ≤ t ^ (-(1 / 2) : ℝ) * (s - (r - t)) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg htpos.le _)
        (Real.rpow_nonneg (by linarith [hs.1]) _)
    linarith [hb]
  · rw [brsRemTwoOneLeft]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Small dilations, right half.** -/
theorem lintegral_small_right_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (htr : t ≤ r / 2) :
    (∫⁻ s in Ioo r (r + t),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 4 * brsRemTwoOneRight E (absProfile f₀) r := by
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  refine lintegral_window_le_rem_right hf₀ (by linarith) htpos (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_small_right hr htpos htr (le_of_lt hs.1)
      (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow htpos.le,
      sqrt_inv_eq_rpow (by linarith [hs.2] : (0:ℝ) ≤ r + t - s)] at hb
    have hfn : (0 : ℝ) ≤ t ^ (-(1 / 2) : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg htpos.le _)
        (Real.rpow_nonneg (by linarith [hs.2]) _)
    linarith [hb]
  · rw [brsRemTwoOneRight]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Large dilations, left half.** -/
theorem lintegral_large_left_le {E : Set ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {r t : ℝ}
    (hr : 0 < r) (htE : t ∈ E) (htr : 3 * r / 2 ≤ t) :
    (∫⁻ s in Ioo (t - r) t,
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 4 * brsRemTwoTwoLeft E (absProfile f₀) r := by
  refine lintegral_window_le_rem_left hf₀ (by linarith) hr (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_large_left hr htr (le_of_lt hs.1) (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow hr.le,
      sqrt_inv_eq_rpow (by linarith [hs.1] : (0:ℝ) ≤ s - (t - r))] at hb
    have hfn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) * (s - (t - r)) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hr.le _)
        (Real.rpow_nonneg (by linarith [hs.1]) _)
    linarith [hb]
  · rw [brsRemTwoTwoLeft]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Large dilations, right half.** -/
theorem lintegral_large_right_le {E : Set ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {r t : ℝ}
    (hr : 0 < r) (htE : t ∈ E) (htr : 3 * r / 2 ≤ t) :
    (∫⁻ s in Ioo t (t + r),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 8 * brsRemTwoTwoRight E (absProfile f₀) r := by
  refine lintegral_window_le_rem_right hf₀ (by linarith) hr (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_large_right hr htr (le_of_lt hs.1) (le_of_lt hs.2)
    have hrw : t + r - s = r + t - s := by ring
    rw [sqrt_inv_eq_rpow hr.le] at hb
    rw [hrw]
    rw [sqrt_inv_eq_rpow (by linarith [hs.2] : (0:ℝ) ≤ r + t - s)] at hb
    have hfn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hr.le _)
        (Real.rpow_nonneg (by linarith [hs.2]) _)
    linarith [hb]
  · rw [brsRemTwoTwoRight]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- Splitting a window integral at an interior point. -/
theorem lintegral_Ioo_split {F : ℝ → ENNReal} {a m b : ℝ} (ham : a ≤ m)
    (hmb : m ≤ b) :
    (∫⁻ s in Ioo a b, F s) ≤ (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Ioo m b, F s := by
  have hsub : Ioo a b ⊆ Ioo a m ∪ Icc m b := by
    intro s hs
    rcases lt_or_ge s m with h | h
    · exact Or.inl ⟨hs.1, h⟩
    · exact Or.inr ⟨h, le_of_lt hs.2⟩
  calc (∫⁻ s in Ioo a b, F s) ≤ ∫⁻ s in Ioo a m ∪ Icc m b, F s :=
        lintegral_mono_set hsub
    _ ≤ (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Icc m b, F s := lintegral_union_le _ _ _
    _ = (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Ioo m b, F s := by
        rw [setLIntegral_congr (Ioo_ae_eq_Icc).symm]

/-- **Lemma 5.1 of BRS.**  In the plane the spherical maximal operator on
radial data is dominated by the two main terms and the four remainders. -/
theorem le_brsDecompositionTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 0 < p) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {x : Euclidean 2}
    (hx : x ≠ 0) :
    M E (fun y : Euclidean 2 => f₀ ‖y‖) x ≤
      ENNReal.ofReal (((surfaceMass 2)⁻¹ * surfaceMass 1) * 8) *
        (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
          brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
          brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
          brsRemTwoOneRight E (absProfile f₀) ‖x‖ +
          brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
          brsRemTwoTwoRight E (absProfile f₀) ‖x‖) := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hmass2 : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  set c₂ : ℝ := (surfaceMass 2)⁻¹ * surfaceMass 1 with hc₂
  have hc₂pos : 0 < c₂ := by
    rw [hc₂]
    positivity
  set S : ENNReal :=
    brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoOneRight E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoRight E (absProfile f₀) ‖x‖ with hS
  unfold M _root_.Spherical.restrictedSphericalMaximal
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htpos⟩ := ht
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have htpos' : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  -- the kernel bound
  have hker := ofReal_norm_sphericalAverage_two_le hf₀ hx htpos'
  refine le_trans hker ?_
  -- the six summands are dominated by their total
  have hM : brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ ≤ S := by
    rw [hS]
    exact le_add_right (le_add_right (le_add_right (le_add_right le_rfl)))
  have hR1 : brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoOneRight E (absProfile f₀) ‖x‖ ≤ S := by
    rw [hS]
    exact le_add_right (le_add_right (add_le_add le_add_self le_rfl))
  have hR2 : brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoRight E (absProfile f₀) ‖x‖ ≤ S := by
    rw [hS]
    exact add_le_add le_add_self le_rfl
  have h8 : ∀ (A B X Y : ENNReal) (C₁ C₂ : ℝ), C₁ ≤ 8 → C₂ ≤ 8 → 0 ≤ C₁ →
      0 ≤ C₂ → A ≤ ENNReal.ofReal C₁ * X → B ≤ ENNReal.ofReal C₂ * Y →
      X + Y ≤ S → A + B ≤ ENNReal.ofReal 8 * S := by
    intro A B X Y C₁ C₂ hC₁ hC₂ _ _ hA hB hXY
    calc A + B ≤ ENNReal.ofReal C₁ * X + ENNReal.ofReal C₂ * Y :=
          add_le_add hA hB
      _ ≤ ENNReal.ofReal 8 * X + ENNReal.ofReal 8 * Y :=
          add_le_add (mul_le_mul' (ENNReal.ofReal_le_ofReal hC₁) le_rfl)
            (mul_le_mul' (ENNReal.ofReal_le_ofReal hC₂) le_rfl)
      _ = ENNReal.ofReal 8 * (X + Y) := by rw [mul_add]
      _ ≤ ENNReal.ofReal 8 * S := mul_le_mul' le_rfl hXY
  -- the window integral, in each range of `t`
  have hwin : (∫⁻ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
      ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 8 * S := by
    by_cases hle : t ≤ ‖x‖ / 2
    · have habs : |‖x‖ - t| = ‖x‖ - t := abs_of_nonneg (by linarith)
      rw [habs]
      refine le_trans (lintegral_Ioo_split
        (F := fun s => ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖))
        (a := ‖x‖ - t) (m := ‖x‖) (b := ‖x‖ + t) (by linarith) (by linarith)) ?_
      exact h8 _ _ _ _ 2 4 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (lintegral_small_left_le hE hf₀ hr htE hle)
        (lintegral_small_right_le hE hf₀ hr htE hle) hR1
    · have hmid : ‖x‖ / 2 < t := not_le.mp hle
      rcases lt_or_ge t (3 * ‖x‖ / 2) with hmain | hlarge
      · have hbound := lintegral_window_le_mainTwo hp hf₀ hr htE
          hmid hmain
        refine le_trans hbound ?_
        have hle : (4 : ℝ) / Real.sqrt 3 ≤ 8 := by
          have h1 : (1 : ℝ) ≤ Real.sqrt 3 := by
            rw [show (1 : ℝ) = Real.sqrt 1 by simp]
            exact Real.sqrt_le_sqrt (by norm_num)
          rw [div_le_iff₀ (by linarith)]
          linarith
        calc ENNReal.ofReal (4 / Real.sqrt 3) *
              (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
                brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖)
            ≤ ENNReal.ofReal 8 *
                (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
                  brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖) :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ ≤ ENNReal.ofReal 8 * S := mul_le_mul' le_rfl hM
      · have habs : |‖x‖ - t| = t - ‖x‖ := by
          rw [abs_of_nonpos (by linarith)]
          ring
        have hrw : ‖x‖ + t = t + ‖x‖ := by ring
        rw [habs, hrw]
        refine le_trans (lintegral_Ioo_split
          (F := fun s => ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖))
          (a := t - ‖x‖) (m := t) (b := t + ‖x‖) (by linarith) (by linarith)) ?_
        exact h8 _ _ _ _ 4 8 (by norm_num) (by norm_num) (by norm_num)
          (by norm_num) (lintegral_large_left_le hf₀ hr htE hlarge)
          (lintegral_large_right_le hf₀ hr htE hlarge) hR2
  refine le_trans (mul_le_mul' le_rfl hwin) (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul hc₂pos.le]

/-! ## (5.1): the dyadic decomposition of the operators `R_1^±` -/

/-- The dyadic scale `2^{-m}`. -/
def brsDyadic (m : ℕ) : ℝ := (1 / 2 : ℝ) ^ m

theorem brsDyadic_pos (m : ℕ) : 0 < brsDyadic m := by
  rw [brsDyadic]
  positivity

/-- Every distance in `(0, 2)` lies in exactly one dyadic block. -/
theorem exists_brsDyadic_mem {x : ℝ} (hx0 : 0 < x) (hx2 : x < 2) :
    ∃ m : ℕ, brsDyadic m ≤ x ∧ x < 2 * brsDyadic m := by
  classical
  have hex : ∃ m : ℕ, brsDyadic m ≤ x := by
    obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one hx0 (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨m, le_of_lt hm⟩
  refine ⟨Nat.find hex, Nat.find_spec hex, ?_⟩
  rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
  · rw [h0, brsDyadic]
    simpa using hx2
  · have hlt : ¬ brsDyadic (Nat.find hex - 1) ≤ x :=
      Nat.find_min hex (by omega)
    push_neg at hlt
    obtain ⟨k, hk⟩ : ∃ k : ℕ, Nat.find hex = k + 1 := ⟨Nat.find hex - 1, by omega⟩
    have hstep : brsDyadic (Nat.find hex - 1) = 2 * brsDyadic (Nat.find hex) := by
      rw [hk, brsDyadic, brsDyadic, Nat.add_sub_cancel, pow_succ]
      ring
    rw [hstep] at hlt
    exact hlt

/-- `R_1^{-,m}`: the `m`-th dyadic block of the small-dilation left remainder. -/
def brsR1PieceLeft (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m), ‖g s‖ₑ

/-- `R_1^{+,m}`: the `m`-th dyadic block of the small-dilation right remainder. -/
def brsR1PieceRight (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m), ‖g s‖ₑ

/-- The elementary weight bound on a dyadic block. -/
theorem enorm_weight_mul_le {g : ℝ → ℂ} {m : ℕ} {a s : ℝ} (ha : brsDyadic m ≤ a)
    (ha0 : 0 < a) :
    ‖((|a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ ≤
      ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
  have habs : |a| = a := abs_of_pos ha0
  have hle : a ^ (-(1 / 2) : ℝ) ≤ brsDyadic m ^ (-(1 / 2) : ℝ) :=
    Real.rpow_le_rpow_of_nonpos (brsDyadic_pos m) ha (by norm_num)
  have hnn : (0 : ℝ) ≤ a ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg ha0.le _
  rw [habs, enorm_mul, ← ofReal_norm, Complex.norm_real,
    Real.norm_of_nonneg hnn]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl

/-- **(5.1) of BRS, left half.** -/
theorem brsRemTwoOneLeft_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} :
    brsRemTwoOneLeft E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        brsR1PieceLeft E g m r := by
  rw [brsRemTwoOneLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : r - t ≤ r := by linarith
  set F : ℝ → ℂ := fun s => ((|s - (r - t)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hstep1 : ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in (r - t)..r, F s‖) ≤
      ‖∫ s in (r - t)..r, F s‖ₑ := by
    rw [← ofReal_norm]
    refine ENNReal.ofReal_le_ofReal ?_
    have h1 : t ^ (-(1 / 2) : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos ht1 (by norm_num)
    nlinarith [norm_nonneg (∫ s in (r - t)..r, F s)]
  have hstep2 : ‖∫ s in (r - t)..r, F s‖ₑ ≤ ∫⁻ s in Ioo (r - t) r, ‖F s‖ₑ := by
    rw [intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo (r - t) r ⊆
      ⋃ m : ℕ, Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := s - (r - t)) (by linarith [hs.1]) (by linarith [hs.2])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  have hstep3 : (∫⁻ s in Ioo (r - t) r, ‖F s‖ₑ) ≤
      ∑' m : ℕ, ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m),
        ‖F s‖ₑ :=
    le_trans (lintegral_mono_set hcover) (lintegral_iUnion_le _ _)
  refine le_trans hstep1 (le_trans hstep2 (le_trans hstep3
    (ENNReal.tsum_le_tsum fun m => ?_)))
  have hbound : (∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m), ‖g s‖ₑ := by
    have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
      ENNReal.ofReal_ne_top
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ico] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1])
      (by linarith [hs.1, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR1PieceLeft]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **(5.1) of BRS, right half.** -/
theorem brsRemTwoOneRight_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} :
    brsRemTwoOneRight E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        brsR1PieceRight E g m r := by
  rw [brsRemTwoOneRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : r ≤ r + t := by linarith
  set F : ℝ → ℂ := fun s => ((|r + t - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hstep1 : ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in r..(r + t), F s‖) ≤
      ‖∫ s in r..(r + t), F s‖ₑ := by
    rw [← ofReal_norm]
    refine ENNReal.ofReal_le_ofReal ?_
    have h1 : t ^ (-(1 / 2) : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos ht1 (by norm_num)
    nlinarith [norm_nonneg (∫ s in r..(r + t), F s)]
  have hstep2 : ‖∫ s in r..(r + t), F s‖ₑ ≤ ∫⁻ s in Ioo r (r + t), ‖F s‖ₑ := by
    rw [intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo r (r + t) ⊆
      ⋃ m : ℕ, Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := r + t - s) (by linarith [hs.2]) (by linarith [hs.1])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  have hstep3 : (∫⁻ s in Ioo r (r + t), ‖F s‖ₑ) ≤
      ∑' m : ℕ, ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
        ‖F s‖ₑ :=
    le_trans (lintegral_mono_set hcover) (lintegral_iUnion_le _ _)
  refine le_trans hstep1 (le_trans hstep2 (le_trans hstep3
    (ENNReal.tsum_le_tsum fun m => ?_)))
  have hbound : (∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
          ‖g s‖ₑ := by
    have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
      ENNReal.ofReal_ne_top
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ioc] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.2])
      (by linarith [hs.2, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR1PieceRight]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-! ## The centered blocks of a covering of `E` -/

/-- The window of the covering interval centered at `a`, at scale `δ`,
intersected with the region `s ≥ r/2` that the constraint `t ≤ r/2`
supplies. -/
def brsCenteredWindow (a δ r : ℝ) : Set ℝ :=
  Icc (r - a) (r - a + 3 * δ) ∩ (Ici (r / 2) ∩ Ici 1)

/-- The `L^1` mass of `g` on the centered window. -/
def brsCenteredPiece (a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∫⁻ s, (brsCenteredWindow a δ r).indicator (fun s => ‖g s‖ₑ) s

theorem measurableSet_brsCenteredWindow (a δ r : ℝ) :
    MeasurableSet (brsCenteredWindow a δ r) :=
  (measurableSet_Icc).inter (measurableSet_Ici.inter measurableSet_Ici)

theorem brsCenteredPiece_eq_setLIntegral (a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsCenteredPiece a δ g r = ∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ := by
  rw [brsCenteredPiece, lintegral_indicator (measurableSet_brsCenteredWindow a δ r)]

/-- Joint measurability of the centered blocks. -/
theorem measurable_brsCenteredPiece {a δ : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsCenteredPiece a δ g) := by
  have hset : MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} := by
    have h1 : MeasurableSet {z : ℝ × ℝ | z.1 - a ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h4 : MeasurableSet {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have : {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} =
        (({z : ℝ × ℝ | z.1 - a ≤ z.2} ∩ {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ}) ∩
          {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} := by
      ext z
      simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
        Set.mem_Icc, Set.mem_Ici]
      tauto
    rw [this]
    exact ((h1.inter h2).inter h3).inter h4
  have hfun : Measurable fun z : ℝ × ℝ =>
      (brsCenteredWindow a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2 := by
    have : (fun z : ℝ × ℝ =>
        (brsCenteredWindow a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1}.indicator
          (fun z : ℝ × ℝ => ‖g z.2‖ₑ) z := by
      funext z
      by_cases hz : z.2 ∈ brsCenteredWindow a δ z.1 <;>
        simp [Set.indicator_apply, hz]
    rw [this]
    exact (hg.comp measurable_snd).enorm.indicator hset
  exact hfun.lintegral_prod_right'

/-- Each dyadic block of `R_1^-` is dominated by the centered blocks of any
covering of `E` at the same scale. -/
theorem brsR1PieceLeft_le_iSup_centered {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ}
    (hcov : IsIntervalCover E (brsDyadic m) ι) {g : ℝ → ℂ} {r : ℝ} :
    brsR1PieceLeft E g m r ≤
      ⨆ a ∈ ι, brsCenteredPiece a (brsDyadic m) g r := by
  rw [brsR1PieceLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : t ≤ r / 2 := htr
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m) ⊆
      brsCenteredWindow a (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ico.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by linarith, by linarith⟩, ?_, ?_⟩
    · show r / 2 ≤ x
      linarith
    · show (1 : ℝ) ≤ x
      have ht1 : (1 : ℝ) ≤ t := (hE htE).1
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsCenteredPiece_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- Hölder's inequality on a window. -/
theorem lintegral_window_holder {p : ℝ} (hp : 1 < p) {W : Set ℝ}
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in W, ‖g s‖ₑ) ≤
      (∫⁻ s in W, ‖g s‖ₑ ^ p) ^ (1 / p) * volume W ^ (1 - 1 / p) := by
  have hconj : p.HolderConjugate (Real.conjExponent p) :=
    Real.HolderConjugate.conjExponent hp
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict W) hconj
    (f := fun s => ‖g s‖ₑ) (g := fun _ => (1 : ENNReal))
    hg.enorm.aemeasurable aemeasurable_const
  simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow, lintegral_const,
    Measure.restrict_apply_univ, one_mul] at h
  have hexp : 1 / Real.conjExponent p = 1 - 1 / p := by
    have h1 := hconj.one_div_add_one_div
    norm_num at h1
    rw [one_div, one_div]
    linarith
  rw [hexp] at h
  exact h

/-- The set of radii whose centered window contains a given point. -/
theorem measure_setOf_mem_brsCenteredWindow_le {a δ s : ℝ} (hδ : 0 ≤ δ) :
    volume {r : ℝ | s ∈ brsCenteredWindow a δ r} ≤ ENNReal.ofReal (3 * δ) := by
  have hsub : {r : ℝ | s ∈ brsCenteredWindow a δ r} ⊆
      Icc (s + a - 3 * δ) (s + a) := by
    intro r hr
    obtain ⟨⟨h1, h2⟩, _⟩ := hr
    exact ⟨by linarith, by linarith⟩
  refine le_trans (measure_mono hsub) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  linarith

/-- Tonelli for the centered windows: each point is seen by radii in an
interval of length `3δ`. -/
theorem lintegral_centered_window_le {a δ : ℝ} (hδ : 0 ≤ δ) {Φ : ℝ → ENNReal}
    (hΦ : Measurable Φ) :
    (∫⁻ r, ∫⁻ s, (brsCenteredWindow a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s := by
  have hset : MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} := by
    have h1 : MeasurableSet {z : ℝ × ℝ | z.1 - a ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h4 : MeasurableSet {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have hEq : {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} =
        (({z : ℝ × ℝ | z.1 - a ≤ z.2} ∩ {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ}) ∩
          {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} := by
      ext z
      simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
        Set.mem_Icc, Set.mem_Ici]
      tauto
    rw [hEq]
    exact ((h1.inter h2).inter h3).inter h4
  have hjoint : Measurable fun z : ℝ × ℝ =>
      (brsCenteredWindow a δ z.1).indicator Φ z.2 := by
    have hEq : (fun z : ℝ × ℝ => (brsCenteredWindow a δ z.1).indicator Φ z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1}.indicator
          (fun z : ℝ × ℝ => Φ z.2) z := by
      funext z
      by_cases hz : z.2 ∈ brsCenteredWindow a δ z.1 <;>
        simp [Set.indicator_apply, hz]
    rw [hEq]
    exact (hΦ.comp measurable_snd).indicator hset
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  rw [← lintegral_const_mul _ hΦ]
  refine lintegral_mono fun s => ?_
  have hind : (fun r => (brsCenteredWindow a δ r).indicator Φ s) =
      {r : ℝ | s ∈ brsCenteredWindow a δ r}.indicator (fun _ => Φ s) := by
    funext r
    by_cases hr : s ∈ brsCenteredWindow a δ r <;>
      simp [Set.indicator_apply, hr]
  have hmeas : MeasurableSet {r : ℝ | s ∈ brsCenteredWindow a δ r} := by
    have h1 : MeasurableSet {r : ℝ | r - a ≤ s} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {r : ℝ | s ≤ r - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {r : ℝ | r / 2 ≤ s} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have hEq : {r : ℝ | s ∈ brsCenteredWindow a δ r} =
        if (1 : ℝ) ≤ s then
          ({r : ℝ | r - a ≤ s} ∩ {r : ℝ | s ≤ r - a + 3 * δ}) ∩
            {r : ℝ | r / 2 ≤ s}
        else (∅ : Set ℝ) := by
      by_cases hs1 : (1 : ℝ) ≤ s
      · rw [if_pos hs1]
        ext r
        simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
          Set.mem_Icc, Set.mem_Ici]
        tauto
      · rw [if_neg hs1]
        ext r
        simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
          Set.mem_Icc, Set.mem_Ici, Set.mem_empty_iff_false, iff_false]
        tauto
    rw [hEq]
    by_cases hs1 : (1 : ℝ) ≤ s
    · rw [if_pos hs1]
      exact (h1.inter h2).inter h3
    · rw [if_neg hs1]
      exact MeasurableSet.empty
  rw [hind, lintegral_indicator_const hmeas, mul_comm (Φ s)]
  exact mul_le_mul' (measure_setOf_mem_brsCenteredWindow_le hδ) le_rfl

/-- Linearizing a power by a majorant. -/
theorem ennreal_rpow_le_mul_of_le {X M : ENNReal} {c : ℝ} (hc : 1 ≤ c)
    (hXM : X ≤ M) : X ^ c ≤ X * M ^ (c - 1) := by
  rcases eq_or_ne X 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos (by linarith : (0 : ℝ) < c), zero_mul]
  rcases eq_or_ne X ⊤ with htop | htop
  · have hM : M = ⊤ := top_le_iff.mp (htop ▸ hXM)
    rcases eq_or_lt_of_le hc with hc1 | hc1
    · rw [htop, hM, ← hc1]
      simp
    · rw [htop, hM, ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c),
        ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c - 1)]
      simp
  · have hsplit : X ^ c = X * X ^ (c - 1) := by
      have hc' : c = 1 + (c - 1) := by ring
      rw [hc', ENNReal.rpow_add _ _ h0 htop, ENNReal.rpow_one]
      congr 1
      ring
    rw [hsplit]
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hXM (by linarith))

/-- Recombining the linearized power. -/
theorem ennreal_rpow_sub_one_mul_le {M : ENNReal} {c : ℝ} (hc : 1 ≤ c) :
    M ^ (c - 1) * M ≤ M ^ c := by
  rcases eq_or_ne M 0 with h0 | h0
  · rw [h0, mul_zero]
    simp
  rcases eq_or_ne M ⊤ with htop | htop
  · rw [htop, ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c)]
    exact le_top
  · have hc' : c = c - 1 + 1 := by ring
    rw [hc', ENNReal.rpow_add _ _ h0 htop, ENNReal.rpow_one]
    have : c - 1 + 1 - 1 = c - 1 := by ring
    rw [this]

theorem volume_brsCenteredWindow_le {a δ r : ℝ} (hδ : 0 ≤ δ) :
    volume (brsCenteredWindow a δ r) ≤ ENNReal.ofReal (3 * δ) := by
  refine le_trans (measure_mono (Set.inter_subset_left)) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  linarith

/-- The `L^q(r\,dr)` bound for a single centered block. -/
theorem lintegral_brsCenteredPiece_pow_le {p q δ a : ℝ} (hp : 1 < p) (hpq : p ≤ q)
    (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q) ≤
      2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hqp : (1 : ℝ) ≤ q / p := (one_le_div hp0).mpr hpq
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ := by
    rw [hΦdef]
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      (hg.enorm.pow_const p)
  set M : ENNReal := ∫⁻ s, Φ s with hM
  -- the `L^p` mass on a window is at most the weighted global mass
  have hXM : ∀ r : ℝ, (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ≤ M := by
    intro r
    refine le_trans (setLIntegral_mono' (measurableSet_brsCenteredWindow a δ r)
      ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : (1 : ℝ) ≤ s := hs.2.2
    have : (1 : ENNReal) ≤ ENNReal.ofReal s := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal hs1
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ ENNReal.ofReal s * ‖g s‖ₑ ^ p := mul_le_mul' this le_rfl
  -- Hölder on each window
  have hPX : ∀ r : ℝ, brsCenteredPiece a δ g r ≤
      (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
        ENNReal.ofReal (3 * δ) ^ (1 - 1 / p) := by
    intro r
    rw [brsCenteredPiece_eq_setLIntegral]
    refine le_trans (lintegral_window_holder hp hg) (mul_le_mul' le_rfl ?_)
    exact ENNReal.rpow_le_rpow (volume_brsCenteredWindow_le hδ.le)
      (by rw [sub_nonneg, div_le_one hp0]; linarith)
  -- the radial weight against the window mass
  have hrX : ∀ r : ℝ, ENNReal.ofReal r *
      (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ≤
      2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s := by
    intro r
    rw [← lintegral_const_mul' _ _ (by simp : ENNReal.ofReal r ≠ ⊤),
      ← lintegral_const_mul' _ _ (by simp : (2 : ENNReal) ≠ ⊤)]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict (measurableSet_brsCenteredWindow a δ r)]
      with s hs
    have hs2 : r / 2 ≤ s := hs.2.1
    have hrs : ENNReal.ofReal r ≤ 2 * ENNReal.ofReal s := by
      rw [show (2 : ENNReal) = ENNReal.ofReal 2 by
        rw [ENNReal.ofReal_ofNat], ← ENNReal.ofReal_mul (by norm_num)]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ENNReal.ofReal r * ‖g s‖ₑ ^ p
        ≤ (2 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p := mul_le_mul' hrs le_rfl
      _ = 2 * Φ s := by rw [hΦdef, mul_assoc]
  -- the pointwise bound
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q ≤
      ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
        (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) := by
    intro r
    set X : ENNReal := ∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p with hX
    have h1 : brsCenteredPiece a δ g r ^ q ≤
        X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
      refine le_trans (ENNReal.rpow_le_rpow (hPX r) hq0.le) (le_of_eq ?_)
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
        ← ENNReal.rpow_mul]
      congr 2
      · rw [one_div]
        field_simp
      · ring
    calc ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q
        ≤ ENNReal.ofReal r *
            (X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
          mul_le_mul' le_rfl h1
      _ ≤ ENNReal.ofReal r *
            ((X * M ^ (q / p - 1)) *
              ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) := by
          exact mul_le_mul' le_rfl
            (mul_le_mul' (ennreal_rpow_le_mul_of_le hqp (hXM r)) le_rfl)
      _ = ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (ENNReal.ofReal r * X) := by ring
      _ ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) :=
          mul_le_mul' le_rfl (hrX r)
  -- integrate in the radius
  have hmass : (∫⁻ r, ∫⁻ s in brsCenteredWindow a δ r, Φ s) ≤
      ENNReal.ofReal (3 * δ) * M := by
    have hswap := lintegral_centered_window_le (a := a) (δ := δ) hδ.le hΦmeas
    refine le_trans (le_of_eq ?_) hswap
    refine lintegral_congr fun r => ?_
    rw [lintegral_indicator (measurableSet_brsCenteredWindow a δ r)]
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  have he0 : (0 : ℝ) ≤ q * (1 - 1 / p) := by
    have : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    positivity
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hMq : M ^ (q / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity)]
    have : (2 : ENNReal) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
        M ^ (q / p) = ⊤ := by
      rw [hMq]
      refine ENNReal.mul_top ?_
      refine ne_of_gt ?_
      refine ENNReal.mul_pos (by norm_num) ?_
      exact (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hδ3)
        ENNReal.ofReal_ne_top).ne'
    rw [this]
    exact le_top
  · set C : ENNReal := ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
      M ^ (q / p - 1) * 2 with hC
    have hCne : C ≠ ⊤ := by
      refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) (by simp)
      · exact ENNReal.rpow_ne_top_of_nonneg he0 ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hMtop
    calc (∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q)
        ≤ ∫⁻ r, ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) := lintegral_mono hpt
      _ = ∫⁻ r, C * ∫⁻ s in brsCenteredWindow a δ r, Φ s := by
          refine lintegral_congr fun r => ?_
          rw [hC]
          ring
      _ = C * ∫⁻ r, ∫⁻ s in brsCenteredWindow a δ r, Φ s :=
          lintegral_const_mul' _ _ hCne
      _ ≤ C * (ENNReal.ofReal (3 * δ) * M) := mul_le_mul' le_rfl hmass
      _ = 2 * (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
            ENNReal.ofReal (3 * δ)) * (M ^ (q / p - 1) * M) := by
          rw [hC]
          ring
      _ ≤ 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) * M ^ (q / p) := by
          refine mul_le_mul' (mul_le_mul' le_rfl (le_of_eq ?_))
            (ennreal_rpow_sub_one_mul_le hqp)
          rw [ENNReal.rpow_add_of_nonneg _ _ he0 (by norm_num),
            ENNReal.rpow_one]

/-- A finite supremum, raised to a power, is at most the sum of the powers. -/
theorem iSup_rpow_le_sum {q : ℝ} (hq : 0 < q) (ι : Finset ℝ) (f : ℝ → ENNReal) :
    (⨆ a ∈ ι, f a) ^ q ≤ ∑ a ∈ ι, f a ^ q := by
  have hle : (⨆ a ∈ ι, f a) ≤ (∑ a ∈ ι, f a ^ q) ^ (1 / q) := by
    refine iSup₂_le fun a ha => ?_
    have hself : f a = (f a ^ q) ^ (1 / q) := by
      rw [one_div, ENNReal.rpow_rpow_inv hq.ne']
    rw [hself]
    exact ENNReal.rpow_le_rpow (Finset.single_le_sum
      (f := fun a => f a ^ q) (fun _ _ => zero_le) ha) (by positivity)
  refine le_trans (ENNReal.rpow_le_rpow hle hq.le) (le_of_eq ?_)
  rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq.ne', ENNReal.rpow_one]

/-- The `L^q(r\,dr)` bound for a dyadic block of `R_1^-`. -/
theorem lintegral_brsR1PieceLeft_pow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp : 1 < p) (hpq : p ≤ q) (m : ℕ) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q) ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
        (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set δ := brsDyadic m with hδdef
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q := by
    intro r
    have h1 : brsR1PieceLeft E g m r ^ q ≤
        ∑ a ∈ ι, brsCenteredPiece a δ g r ^ q :=
      le_trans (ENNReal.rpow_le_rpow
        (brsR1PieceLeft_le_iSup_centered hE hcov) hq0.le)
        (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece a δ g r)
    calc ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece a δ g r ^ q :=
          mul_le_mul' le_rfl h1
      _ = ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
          Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
        lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E δ : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hcard, hK]
        ring

/-- Powers commute with countable suprema. -/
theorem ennreal_iSup_rpow {q : ℝ} (hq : 0 < q) (u : ℕ → ENNReal) :
    (⨆ n, u n) ^ q = ⨆ n, u n ^ q := by
  refine le_antisymm ?_ (iSup_le fun n => ENNReal.rpow_le_rpow (le_iSup _ n) hq.le)
  have h : (⨆ n, u n) ≤ (⨆ n, u n ^ q) ^ (1 / q) := by
    refine iSup_le fun n => ?_
    have hself : u n = (u n ^ q) ^ (1 / q) := by
      rw [one_div, ENNReal.rpow_rpow_inv hq.ne']
    rw [hself]
    exact ENNReal.rpow_le_rpow (le_iSup (fun n => u n ^ q) n) (by positivity)
  have h2 := ENNReal.rpow_le_rpow h hq.le
  rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq.ne', ENNReal.rpow_one] at h2

/-- Minkowski's inequality for a countable sum. -/
theorem lintegral_rpow_tsum_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {q : ℝ} (hq : 1 ≤ q) {F : ℕ → α → ENNReal} (hF : ∀ n, Measurable (F n)) :
    (∫⁻ x, (∑' n, F n x) ^ q ∂μ) ^ (1 / q) ≤
      ∑' n, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set B : ENNReal := ∑' n, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) with hB
  -- Minkowski for finitely many summands
  have hstep : ∀ N : ℕ,
      (∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ) ^ (1 / q) ≤
        ∑ n ∈ Finset.range N, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) := by
    intro N
    induction N with
    | zero =>
        simp only [Finset.range_zero, Finset.sum_empty]
        rw [ENNReal.zero_rpow_of_pos hq0, lintegral_zero,
          ENNReal.zero_rpow_of_pos (by positivity : (0 : ℝ) < 1 / q)]
    | succ N ih =>
        have hmeasS : AEMeasurable (fun x => ∑ n ∈ Finset.range N, F n x) μ :=
          (Finset.measurable_sum _ fun n _ => hF n).aemeasurable
        simp only [Finset.sum_range_succ]
        refine le_trans (ENNReal.lintegral_Lp_add_le hmeasS
          (hF N).aemeasurable hq) ?_
        exact add_le_add ih le_rfl
  -- monotone convergence for the partial sums
  have hmeasN : ∀ N : ℕ,
      Measurable fun x => (∑ n ∈ Finset.range N, F n x) ^ q :=
    fun N => (Finset.measurable_sum _ fun n _ => hF n).pow_const q
  have hA : (∫⁻ x, (∑' n, F n x) ^ q ∂μ) ≤ B ^ q := by
    have hrw : ∀ x, (∑' n, F n x) ^ q =
        ⨆ N, (∑ n ∈ Finset.range N, F n x) ^ q := by
      intro x
      rw [ENNReal.tsum_eq_iSup_nat, ennreal_iSup_rpow hq0]
    have hmono : Monotone fun N : ℕ => fun x => (∑ n ∈ Finset.range N, F n x) ^ q := by
      intro N M hNM x
      refine ENNReal.rpow_le_rpow ?_ hq0.le
      refine Finset.sum_le_sum_of_subset ?_
      intro i hi
      simp only [Finset.mem_range] at hi ⊢
      omega
    calc (∫⁻ x, (∑' n, F n x) ^ q ∂μ)
        = ∫⁻ x, ⨆ N, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ :=
          lintegral_congr hrw
      _ = ⨆ N, ∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ :=
          lintegral_iSup hmeasN hmono
      _ ≤ B ^ q := by
          refine iSup_le fun N => ?_
          have h3 : (∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ) ^ (1 / q) ≤ B :=
            le_trans (hstep N) (ENNReal.sum_le_tsum _)
          have h4 := ENNReal.rpow_le_rpow h3 hq0.le
          rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne',
            ENNReal.rpow_one] at h4
  have h5 := ENNReal.rpow_le_rpow hA (by positivity : (0 : ℝ) ≤ 1 / q)
  rwa [← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one] at h5

theorem brsDyadic_le_one (m : ℕ) : brsDyadic m ≤ 1 := by
  rw [brsDyadic]
  exact pow_le_one₀ (by norm_num) (by norm_num)

/-- Each dyadic block of `R_1^+` is dominated by the mirrored centered blocks
of a covering of `E` at the same scale. -/
theorem brsR1PieceRight_le_iSup_centered {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR1PieceRight E g m r ≤
      ⨆ a ∈ ι, brsCenteredPiece (3 * brsDyadic m - a) (brsDyadic m) g r := by
  rw [brsR1PieceRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : t ≤ r / 2 := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hr2 : (2 : ℝ) ≤ r := by linarith
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hδ1 : brsDyadic m ≤ 1 := brsDyadic_le_one m
  have hsub : Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m) ⊆
      brsCenteredWindow (3 * brsDyadic m - a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ioc.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by linarith, by linarith⟩, ?_, ?_⟩
    · show r / 2 ≤ x
      linarith
    · show (1 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsCenteredPiece_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- The `L^q(r\,dr)` bound for a dyadic block of `R_1^+`. -/
theorem lintegral_brsR1PieceRight_pow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp : 1 < p) (hpq : p ≤ q) (m : ℕ) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q) ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
        (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set δ := brsDyadic m with hδdef
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        brsCenteredPiece (3 * δ - a) δ g r ^ q := by
    intro r
    have h1 : brsR1PieceRight E g m r ^ q ≤
        ∑ a ∈ ι, brsCenteredPiece (3 * δ - a) δ g r ^ q :=
      le_trans (ENNReal.rpow_le_rpow
        (brsR1PieceRight_le_iSup_centered hE hcov) hq0.le)
        (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece (3 * δ - a) δ g r)
    calc ENNReal.ofReal r * brsR1PieceRight E g m r ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece (3 * δ - a) δ g r ^ q :=
          mul_le_mul' le_rfl h1
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            brsCenteredPiece (3 * δ - a) δ g r ^ q := Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece (3 * δ - a) δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          brsCenteredPiece (3 * δ - a) δ g r ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          brsCenteredPiece (3 * δ - a) δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E δ : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hcard, hK]
        ring

/-- Minkowski's inequality for a countable sum, with the radial weight. -/
theorem lintegral_weight_rpow_tsum_le {q : ℝ} (hq : 1 ≤ q) {G : ℕ → ℝ → ENNReal}
    (hG : ∀ n, Measurable (G n)) :
    (∫⁻ r, ENNReal.ofReal r * (∑' n, G n r) ^ q) ^ (1 / q) ≤
      ∑' n, (∫⁻ r, ENNReal.ofReal r * G n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hFmeas : ∀ n, Measurable fun r : ℝ =>
      ENNReal.ofReal r ^ (1 / q) * G n r := fun n =>
    (((ENNReal.measurable_ofReal.comp measurable_id)).pow_const _).mul (hG n)
  have hkey := lintegral_rpow_tsum_le (μ := (volume : Measure ℝ)) hq hFmeas
  have h1 : ∀ r : ℝ, (∑' n, ENNReal.ofReal r ^ (1 / q) * G n r) ^ q =
      ENNReal.ofReal r * (∑' n, G n r) ^ q := by
    intro r
    rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
      ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have h2 : ∀ n : ℕ, (∫⁻ r, (ENNReal.ofReal r ^ (1 / q) * G n r) ^ q) =
      ∫⁻ r, ENNReal.ofReal r * G n r ^ q := by
    intro n
    refine lintegral_congr fun r => ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  simp_rw [h1, h2] at hkey
  exact hkey

/-- The `L^q(r\,dr)` bound for the supremum of the centered blocks of a
covering. -/
theorem lintegral_iSup_centered_pow_le {ι : Finset ℝ} {p q δ : ℝ} (hp : 1 < p)
    (hpq : p ≤ q) (hδ : 0 < δ) (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q) ≤
      (ι.card : ENNReal) *
        (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q := by
    intro r
    calc ENNReal.ofReal r * (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece (c a) δ g r ^ q :=
          mul_le_mul' le_rfl
            (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece (c a) δ g r)
      _ = ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q :=
          Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          brsCenteredPiece (c a) δ g r ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          brsCenteredPiece (c a) δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (ι.card : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hK]
        ring

/-- The coefficient of the `m`-th dyadic block in BRS Proposition 5.2. -/
def brsProp52Coeff (E : Set ℝ) (p q : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1))) ^ (1 / q)

/-- Measurability of the supremum over a finite family of centered blocks. -/
theorem measurable_iSup_centered {ι : Finset ℝ} {δ : ℝ} (c : ℝ → ℝ)
    {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable fun r : ℝ => ⨆ a ∈ ι, brsCenteredPiece (c a) δ g r := by
  have : (fun r : ℝ => ⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) =
      fun r : ℝ => ⨆ a ∈ (ι : Set ℝ), brsCenteredPiece (c a) δ g r := by
    funext r
    simp
  rw [this]
  exact Measurable.biSup _ (ι : Set ℝ).to_countable
    fun a _ => measurable_brsCenteredPiece hg

/-- **BRS Proposition 5.2, left half.** -/
theorem prop52_brsRemTwoOneLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneLeft E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp52Coeff E p q m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsCenteredPiece a (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r => c m * S m r with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_centered (fun a => a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m => (hSmeas m).const_mul _
  have hpt : ∀ r, brsRemTwoOneLeft E g r ≤ ∑' m, G m r := by
    intro r
    refine le_trans (brsRemTwoOneLeft_le_tsum hE)
      (ENNReal.tsum_le_tsum fun m => ?_)
    exact mul_le_mul' le_rfl (brsR1PieceLeft_le_iSup_centered hE (hι m))
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp52Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r * S m r ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
          M ^ (q / p) := by
      have h := lintegral_iSup_centered_pow_le (ι := ι m) hp hpq
        (brsDyadic_pos m) (fun a => a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
            M ^ (q / p)) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp52Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp52Coeff, ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0:ℝ) ≤ 1 / q), ← ENNReal.rpow_mul, hc]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneLeft E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (lintegral_mono fun r => ?_) (by positivity)
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hpt r) hq0.le)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp52Coeff E p q m * M ^ (1 / p) :=
        ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp52Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **BRS Proposition 5.2, right half.** -/
theorem prop52_brsRemTwoOneRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneRight E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp52Coeff E p q m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsCenteredPiece (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r => c m * S m r with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_centered (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m => (hSmeas m).const_mul _
  have hpt : ∀ r, brsRemTwoOneRight E g r ≤ ∑' m, G m r := by
    intro r
    refine le_trans (brsRemTwoOneRight_le_tsum hE)
      (ENNReal.tsum_le_tsum fun m => ?_)
    exact mul_le_mul' le_rfl (brsR1PieceRight_le_iSup_centered hE (hι m))
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp52Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r * S m r ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
          M ^ (q / p) := by
      have h := lintegral_iSup_centered_pow_le (ι := ι m) hp hpq
        (brsDyadic_pos m) (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
            M ^ (q / p)) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp52Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp52Coeff, ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0:ℝ) ≤ 1 / q), ← ENNReal.rpow_mul, hc]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneRight E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (lintegral_mono fun r => ?_) (by positivity)
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hpt r) hq0.le)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp52Coeff E p q m * M ^ (1 / p) :=
        ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp52Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-! ## Signed centered windows, for the large-dilation remainders -/

/-- A window of length `3δ` moving with slope `σ = ±1` in the radius, cut down
to the region `s ≥ r/2`, `s ≥ 1/3` that the constraint `t ≥ 3r/2` supplies. -/
def brsWindowSigned (σ a δ r : ℝ) : Set ℝ :=
  Icc (σ * r - a) (σ * r - a + 3 * δ) ∩ (Ici (r / 2) ∩ Ici (1 / 3))

/-- The `L^1` mass of `g` on a signed window. -/
def brsPieceSigned (σ a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∫⁻ s, (brsWindowSigned σ a δ r).indicator (fun s => ‖g s‖ₑ) s

theorem measurableSet_brsWindowSigned (σ a δ r : ℝ) :
    MeasurableSet (brsWindowSigned σ a δ r) :=
  measurableSet_Icc.inter (measurableSet_Ici.inter measurableSet_Ici)

theorem brsPieceSigned_eq_setLIntegral (σ a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsPieceSigned σ a δ g r = ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ := by
  rw [brsPieceSigned,
    lintegral_indicator (measurableSet_brsWindowSigned σ a δ r)]

theorem volume_brsWindowSigned_le {σ a δ r : ℝ} (_hδ : 0 ≤ δ) :
    volume (brsWindowSigned σ a δ r) ≤ ENNReal.ofReal (3 * δ) := by
  refine le_trans (measure_mono Set.inter_subset_left) ?_
  rw [Real.volume_Icc]
  exact ENNReal.ofReal_le_ofReal (by linarith)

theorem measurableSet_prod_brsWindowSigned (σ a δ : ℝ) :
    MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1} := by
  have h1 : MeasurableSet {z : ℝ × ℝ | σ * z.1 - a ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ σ * z.1 - a + 3 * δ} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h4 : MeasurableSet {z : ℝ × ℝ | (1 / 3 : ℝ) ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have hEq : {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1} =
      (({z : ℝ × ℝ | σ * z.1 - a ≤ z.2} ∩
        {z : ℝ × ℝ | z.2 ≤ σ * z.1 - a + 3 * δ}) ∩
        {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 / 3 : ℝ) ≤ z.2} := by
    ext z
    simp only [brsWindowSigned, Set.mem_setOf_eq, Set.mem_inter_iff,
      Set.mem_Icc, Set.mem_Ici]
    tauto
  rw [hEq]
  exact ((h1.inter h2).inter h3).inter h4

theorem measurable_brsPieceSigned {σ a δ : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsPieceSigned σ a δ g) := by
  have hfun : Measurable fun z : ℝ × ℝ =>
      (brsWindowSigned σ a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2 := by
    have hEq : (fun z : ℝ × ℝ =>
        (brsWindowSigned σ a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1}.indicator
          (fun z : ℝ × ℝ => ‖g z.2‖ₑ) z := by
      funext z
      by_cases hz : z.2 ∈ brsWindowSigned σ a δ z.1 <;> simp [hz]
    rw [hEq]
    exact (hg.comp measurable_snd).enorm.indicator
      (measurableSet_prod_brsWindowSigned σ a δ)
  exact hfun.lintegral_prod_right'

/-- For a fixed point, the radii whose signed window contains it form a set of
measure at most `3δ`. -/
theorem measure_setOf_mem_brsWindowSigned_le {σ a δ s : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (_hδ : 0 ≤ δ) :
    volume {r : ℝ | s ∈ brsWindowSigned σ a δ r} ≤ ENNReal.ofReal (3 * δ) := by
  rcases hσ with hσ | hσ
  · have hsub : {r : ℝ | s ∈ brsWindowSigned σ a δ r} ⊆
        Icc (s + a - 3 * δ) (s + a) := by
      intro r hr
      obtain ⟨⟨h1, h2⟩, _⟩ := hr
      rw [hσ, one_mul] at h1 h2
      exact ⟨by linarith, by linarith⟩
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  · have hsub : {r : ℝ | s ∈ brsWindowSigned σ a δ r} ⊆
        Icc (-s - a) (-s - a + 3 * δ) := by
      intro r hr
      obtain ⟨⟨h1, h2⟩, _⟩ := hr
      rw [hσ] at h1 h2
      constructor <;> [skip; skip] <;> nlinarith [h1, h2]
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
    exact ENNReal.ofReal_le_ofReal (by linarith)

/-- Tonelli for the signed windows. -/
theorem lintegral_brsWindowSigned_le {σ a δ : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (hδ : 0 ≤ δ) {Φ : ℝ → ENNReal} (hΦ : Measurable Φ) :
    (∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s := by
  have hjoint : Measurable fun z : ℝ × ℝ =>
      (brsWindowSigned σ a δ z.1).indicator Φ z.2 := by
    have hEq : (fun z : ℝ × ℝ => (brsWindowSigned σ a δ z.1).indicator Φ z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1}.indicator
          (fun z : ℝ × ℝ => Φ z.2) z := by
      funext z
      by_cases hz : z.2 ∈ brsWindowSigned σ a δ z.1 <;> simp [hz]
    rw [hEq]
    exact (hΦ.comp measurable_snd).indicator
      (measurableSet_prod_brsWindowSigned σ a δ)
  rw [lintegral_lintegral_swap hjoint.aemeasurable,
    ← lintegral_const_mul _ hΦ]
  refine lintegral_mono fun s => ?_
  have hind : (fun r => (brsWindowSigned σ a δ r).indicator Φ s) =
      {r : ℝ | s ∈ brsWindowSigned σ a δ r}.indicator (fun _ => Φ s) := by
    funext r
    by_cases hr : s ∈ brsWindowSigned σ a δ r <;> simp [hr]
  have hmeas : MeasurableSet {r : ℝ | s ∈ brsWindowSigned σ a δ r} := by
    exact measurable_prodMk_right (measurableSet_prod_brsWindowSigned σ a δ)
  rw [hind, lintegral_indicator_const hmeas, mul_comm (Φ s)]
  exact mul_le_mul' (measure_setOf_mem_brsWindowSigned_le hσ hδ) le_rfl

/-- The elementary weight comparison on a signed window. -/
theorem rpow_weight_le_of_window {p r s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hr : 0 < r) (hrs : r / 2 ≤ s) (hs3 : (1 / 3 : ℝ) ≤ s) :
    r ^ (1 - p / 2) ≤ 2 * 3 ^ (p / 2) * s := by
  have hspos : (0 : ℝ) < s := by linarith
  have he0 : (0 : ℝ) ≤ 1 - p / 2 := by linarith
  have h1 : r ^ (1 - p / 2) ≤ (2 * s) ^ (1 - p / 2) :=
    Real.rpow_le_rpow hr.le (by linarith) he0
  have h2 : (2 * s) ^ (1 - p / 2) = 2 ^ (1 - p / 2) * s ^ (1 - p / 2) :=
    Real.mul_rpow (by norm_num) hspos.le
  have h3 : (2 : ℝ) ^ (1 - p / 2) ≤ 2 := by
    calc (2 : ℝ) ^ (1 - p / 2) ≤ 2 ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      _ = 2 := Real.rpow_one 2
  have h4 : s ^ (1 - p / 2) ≤ 3 ^ (p / 2) * s := by
    have hsplit : s ^ (1 - p / 2) = s ^ (-(p / 2)) * s := by
      have h := Real.rpow_add hspos (-(p / 2)) 1
      rw [Real.rpow_one] at h
      rw [show (1 : ℝ) - p / 2 = -(p / 2) + 1 by ring, h]
    have hbase : s ^ (-(p / 2)) ≤ (1 / 3 : ℝ) ^ (-(p / 2)) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hs3 (by linarith)
    have hval : ((1 : ℝ) / 3) ^ (-(p / 2)) = 3 ^ (p / 2) := by
      rw [one_div, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num),
        inv_inv]
    rw [hsplit]
    calc s ^ (-(p / 2)) * s ≤ ((1 : ℝ) / 3) ^ (-(p / 2)) * s :=
          mul_le_mul_of_nonneg_right hbase hspos.le
      _ = 3 ^ (p / 2) * s := by rw [hval]
  have hs0 : (0 : ℝ) ≤ s ^ (1 - p / 2) := Real.rpow_nonneg hspos.le _
  calc r ^ (1 - p / 2) ≤ 2 ^ (1 - p / 2) * s ^ (1 - p / 2) := by
        rw [← h2]; exact h1
    _ ≤ 2 * s ^ (1 - p / 2) := mul_le_mul_of_nonneg_right h3 hs0
    _ ≤ 2 * (3 ^ (p / 2) * s) := by
        exact mul_le_mul_of_nonneg_left h4 (by norm_num)
    _ = 2 * 3 ^ (p / 2) * s := by ring

/-- The diagonal `L^p(r\,dr)` bound for a signed centered block. -/
theorem lintegral_brsPieceSigned_diag_le {σ a δ p : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p) ≤
      ENNReal.ofReal (2 * 3 ^ (p / 2)) * ENNReal.ofReal (3 * δ) ^ p *
        ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ :=
    (ENNReal.measurable_ofReal.comp measurable_id).mul (hg.enorm.pow_const p)
  have hHolder : ∀ r : ℝ, brsPieceSigned σ a δ g r ^ p ≤
      ENNReal.ofReal (3 * δ) ^ (p - 1) *
        ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p := by
    intro r
    rcases eq_or_lt_of_le hp1 with hp | hp
    · rw [brsPieceSigned_eq_setLIntegral, ← hp]
      simp
    · rw [brsPieceSigned_eq_setLIntegral]
      calc (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ) ^ p
          ≤ ((∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
              volume (brsWindowSigned σ a δ r) ^ (1 - 1 / p)) ^ p :=
            ENNReal.rpow_le_rpow (lintegral_window_holder hp hg) hp0.le
        _ = (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) *
              volume (brsWindowSigned σ a δ r) ^ (p - 1) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
              ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp0.ne',
              ENNReal.rpow_one]
            congr 2
            field_simp
        _ ≤ (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) *
              ENNReal.ofReal (3 * δ) ^ (p - 1) :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
              (volume_brsWindowSigned_le hδ.le) (by linarith))
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p := by ring
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p ≤
      ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      simp
    · have hreal : r * (r ^ (-(1 / 2) : ℝ)) ^ p = r ^ (1 - p / 2) := by
        have h1 : (r ^ (-(1 / 2) : ℝ)) ^ p = r ^ (-(p / 2)) := by
          rw [← Real.rpow_mul hr.le]
          congr 1
          ring
        have h2 : r ^ (1 - p / 2) = r ^ (1 : ℝ) * r ^ (-(p / 2)) := by
          rw [← Real.rpow_add hr, sub_eq_add_neg]
        rw [h1, h2, Real.rpow_one]
      have hweight : ENNReal.ofReal r *
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p =
          ENNReal.ofReal (r ^ (1 - p / 2)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hr.le _) hp0.le,
          ← ENNReal.ofReal_mul hr.le, hreal]
      have hmono : ENNReal.ofReal (r ^ (1 - p / 2)) *
          (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ≤
          ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
        rw [lintegral_indicator (measurableSet_brsWindowSigned σ a δ r),
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_mono_ae ?_
        filter_upwards [self_mem_ae_restrict
          (measurableSet_brsWindowSigned σ a δ r)] with s hs
        have hle := rpow_weight_le_of_window hp1 hp2 hr hs.2.1 hs.2.2
        have h13 : (1 / 3 : ℝ) ≤ s := hs.2.2
        have hs0 : (0 : ℝ) ≤ s := by linarith
        calc ENNReal.ofReal (r ^ (1 - p / 2)) * ‖g s‖ₑ ^ p
            ≤ ENNReal.ofReal (2 * 3 ^ (p / 2) * s) * ‖g s‖ₑ ^ p :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) * Φ s := by
              rw [hΦdef, ENNReal.ofReal_mul (by positivity)]
              ring
      calc ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p
          = ENNReal.ofReal (r ^ (1 - p / 2)) * brsPieceSigned σ a δ g r ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← mul_assoc, hweight]
        _ ≤ ENNReal.ofReal (r ^ (1 - p / 2)) *
              (ENNReal.ofReal (3 * δ) ^ (p - 1) *
                ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) :=
            mul_le_mul' le_rfl (hHolder r)
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              (ENNReal.ofReal (r ^ (1 - p / 2)) *
                ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) := by ring
        _ ≤ ENNReal.ofReal (3 * δ) ^ (p - 1) *
              (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
                ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) :=
            mul_le_mul' le_rfl hmono
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by ring
  have hCne : ENNReal.ofReal (3 * δ) ^ (p - 1) *
      ENNReal.ofReal (2 * 3 ^ (p / 2)) ≠ ⊤ :=
    ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)
      ENNReal.ofReal_ne_top
  calc (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p)
      ≤ ∫⁻ r, ENNReal.ofReal (3 * δ) ^ (p - 1) *
          ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := lintegral_mono hpt
    _ = ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s :=
        lintegral_const_mul' _ _ hCne
    _ ≤ ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          (ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s) :=
        mul_le_mul' le_rfl (lintegral_brsWindowSigned_le hσ hδ.le hΦmeas)
    _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          (ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (3 * δ)) *
          ∫⁻ s, Φ s := by ring
    _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) * ENNReal.ofReal (3 * δ) ^ p *
          ∫⁻ s, Φ s := by
        congr 2
        have h := ENNReal.rpow_add_of_nonneg (x := ENNReal.ofReal (3 * δ))
          (y := p - 1) (z := 1) (by linarith) (by norm_num)
        rw [sub_add_cancel, ENNReal.rpow_one] at h
        exact h.symm

/-! ## The dyadic blocks of the large-dilation remainders -/

/-- `R_2^{-,m}`. -/
def brsR2PieceLeft (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m), ‖g s‖ₑ

/-- `R_2^{+,m}`. -/
def brsR2PieceRight (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t,
      ‖g s‖ₑ

/-- The dyadic decomposition of `R_2^-`. -/
theorem brsRemTwoTwoLeft_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
          brsR2PieceLeft E g m r) := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t - r ≤ t := by linarith
  set F : ℝ → ℂ := fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hsplitmul : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
      ‖∫ s in (t - r)..t, F s‖) =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖∫ s in (t - r)..t, F s‖ :=
    ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
  rw [hsplitmul, ENNReal.tsum_mul_left]
  refine mul_le_mul' le_rfl ?_
  have hstep2 : ENNReal.ofReal ‖∫ s in (t - r)..t, F s‖ ≤
      ∫⁻ s in Ioo (t - r) t, ‖F s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo (t - r) t ⊆
      ⋃ m : ℕ, Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := s - (t - r)) (by linarith [hs.1]) (by linarith [hs.2])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  refine le_trans hstep2 (le_trans (le_trans (lintegral_mono_set hcover)
    (lintegral_iUnion_le _ _)) (ENNReal.tsum_le_tsum fun m => ?_))
  have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
    ENNReal.ofReal_ne_top
  have hbound : (∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m),
          ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ico] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1])
      (by linarith [hs.1, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR2PieceLeft]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- The dyadic decomposition of `R_2^+`. -/
theorem brsRemTwoTwoRight_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
          brsR2PieceRight E g m r) := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t ≤ t + r := by linarith
  set F : ℝ → ℂ := fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hsplitmul : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
      ‖∫ s in t..(t + r), F s‖) =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖∫ s in t..(t + r), F s‖ :=
    ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
  rw [hsplitmul, ENNReal.tsum_mul_left]
  refine mul_le_mul' le_rfl ?_
  have hstep2 : ENNReal.ofReal ‖∫ s in t..(t + r), F s‖ ≤
      ∫⁻ s in Ioo t (t + r), ‖F s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo t (t + r) ⊆
      ⋃ m : ℕ, Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := t + r - s) (by linarith [hs.2]) (by linarith [hs.1])
    exact mem_iUnion.mpr ⟨m, ⟨⟨by linarith, by linarith⟩, le_of_lt hs.1⟩⟩
  refine le_trans hstep2 (le_trans (le_trans (lintegral_mono_set hcover)
    (lintegral_iUnion_le _ _)) (ENNReal.tsum_le_tsum fun m => ?_))
  have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
    ENNReal.ofReal_ne_top
  have hmeasset : MeasurableSet
      (Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t) :=
    measurableSet_Ioc.inter measurableSet_Ici
  have hbound : (∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩
      Ici t, ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t,
          ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hmeasset] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1.2])
      (by linarith [hs.1.2, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR2PieceRight]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- Domination of the blocks of `R_2^-` by signed centered blocks. -/
theorem brsR2PieceLeft_le_iSup_signed {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR2PieceLeft E g m r ≤
      ⨆ a ∈ ι, brsPieceSigned (-1) (-a) (brsDyadic m) g r := by
  rw [brsR2PieceLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m) ⊆
      brsWindowSigned (-1) (-a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ico.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by nlinarith, by nlinarith⟩, ?_, ?_⟩
    · show r / 2 ≤ x
      linarith
    · show (1 / 3 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsPieceSigned_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- Domination of the blocks of `R_2^+` by signed centered blocks. -/
theorem brsR2PieceRight_le_iSup_signed {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR2PieceRight E g m r ≤
      ⨆ a ∈ ι, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r := by
  rw [brsR2PieceRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t ⊆
      brsWindowSigned 1 (3 * brsDyadic m - a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨⟨hx1, hx2⟩, hx3⟩ := hx
    have hxt : t ≤ x := hx3
    refine ⟨Set.mem_Icc.mpr ⟨by nlinarith, by nlinarith⟩, ?_, ?_⟩
    · show r / 2 ≤ x
      linarith
    · show (1 / 3 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsPieceSigned_eq_setLIntegral]
  exact lintegral_mono_set hsub

theorem measurable_iSup_signed {ι : Finset ℝ} {σ δ : ℝ} (c : ℝ → ℝ)
    {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable fun r : ℝ => ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r := by
  have hEq : (fun r : ℝ => ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) =
      fun r : ℝ => ⨆ a ∈ (ι : Set ℝ), brsPieceSigned σ (c a) δ g r := by
    funext r
    simp
  rw [hEq]
  exact Measurable.biSup _ (ι : Set ℝ).to_countable
    fun a _ => measurable_brsPieceSigned hg

theorem measurable_rpow_neg_half :
    Measurable fun r : ℝ => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) :=
  ENNReal.measurable_ofReal.comp
    (Measurable.pow_const (measurable_id : Measurable fun r : ℝ => r)
      (-(1 / 2) : ℝ))

/-- The `L^p(r\,dr)` bound for the supremum of signed centered blocks. -/
theorem lintegral_iSup_signed_diag_le {ι : Finset ℝ} {σ δ p : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hδ : 0 < δ)
    (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p) ≤
      (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ENNReal.ofReal (3 * δ) ^ p) *
        ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  set K : ENNReal := ENNReal.ofReal (2 * 3 ^ (p / 2)) *
    ENNReal.ofReal (3 * δ) ^ p * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          brsPieceSigned σ (c a) δ g r) ^ p := by
    intro r
    have hsum := iSup_rpow_le_sum hp0 ι fun a => brsPieceSigned σ (c a) δ g r
    calc ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p
        = ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p *
            (⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, mul_assoc]
      _ ≤ ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p *
            ∑ a ∈ ι, brsPieceSigned σ (c a) δ g r ^ p :=
          mul_le_mul' le_rfl hsum
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              brsPieceSigned σ (c a) δ g r) ^ p := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, mul_assoc]
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ => ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        brsPieceSigned σ (c a) δ g r) ^ p := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_rpow_neg_half.mul (measurable_brsPieceSigned hg)).pow_const p)
  calc (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ p := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ p :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsPieceSigned_diag_le hσ hp1 hp2 hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ENNReal.ofReal (3 * δ) ^ p) *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
        rw [hK]
        ring

/-- The coefficient of the `m`-th dyadic block in BRS Lemma 5.3. -/
def brsLemma53Coeff (E : Set ℝ) (p : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ENNReal.ofReal (3 * brsDyadic m) ^ p)) ^ (1 / p)

/-- **BRS Lemma 5.3 for `1 ≤ p ≤ 2`, left half.** -/
theorem lemma53_brsRemTwoTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p) ≤
      (∑' m : ℕ, brsLemma53Coeff E p m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned (-1) (-a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => -a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ p := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hp0.le)
      refine le_trans (brsRemTwoTwoLeft_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceLeft E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceLeft_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) ≤
      brsLemma53Coeff E p m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ p ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ p) =
        c m ^ p * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ENNReal.ofReal (3 * brsDyadic m) ^ p) * M := by
      have h := lintegral_iSup_signed_diag_le (ι := ι m) (σ := (-1 : ℝ))
        (Or.inr rfl) hp1 hp2 (brsDyadic_pos m) (fun a => -a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ^ (1 / p) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p),
            ← ENNReal.rpow_mul, mul_one_div, div_self hp0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ENNReal.ofReal (3 * brsDyadic m) ^ p) * M) ^ (1 / p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsLemma53Coeff E p m * M ^ (1 / p) := by
          rw [brsLemma53Coeff, hc,
            ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p)]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) :=
        lintegral_weight_rpow_tsum_le hp1 hGmeas
    _ ≤ ∑' m, brsLemma53Coeff E p m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsLemma53Coeff E p m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **BRS Lemma 5.3 for `1 ≤ p ≤ 2`, right half.** -/
theorem lemma53_brsRemTwoTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p) ≤
      (∑' m : ℕ, brsLemma53Coeff E p m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ p := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hp0.le)
      refine le_trans (brsRemTwoTwoRight_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceRight E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceRight_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) ≤
      brsLemma53Coeff E p m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ p ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ p) =
        c m ^ p * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ENNReal.ofReal (3 * brsDyadic m) ^ p) * M := by
      have h := lintegral_iSup_signed_diag_le (ι := ι m) (σ := (1 : ℝ))
        (Or.inl rfl) hp1 hp2 (brsDyadic_pos m)
        (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ^ (1 / p) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p),
            ← ENNReal.rpow_mul, mul_one_div, div_self hp0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ENNReal.ofReal (3 * brsDyadic m) ^ p) * M) ^ (1 / p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsLemma53Coeff E p m * M ^ (1 / p) := by
          rw [brsLemma53Coeff, hc,
            ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p)]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) :=
        lintegral_weight_rpow_tsum_le hp1 hGmeas
    _ ≤ ∑' m, brsLemma53Coeff E p m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsLemma53Coeff E p m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-! ## (5.2): the localized covering quantities `ω_m^{p,q}(E,k)` -/

/-- Covering numbers are monotone in the set. -/
theorem intervalCoveringNumber_mono_set {E F : Set ℝ} (hEF : F ⊆ E) {δ : ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hδ : 0 < δ) :
    intervalCoveringNumber F δ ≤ intervalCoveringNumber E δ := by
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  have hιF : IsIntervalCover F δ ι := IsIntervalCover.mono hEF hι
  calc intervalCoveringNumber F δ ≤ ι.card := intervalCoveringNumber_le_card hιF
    _ = intervalCoveringNumber E δ := hcard

/-- **(5.2) of BRS.**  The localized covering quantity, the supremum over
intervals `J ⊆ [1,2]` of length `2^{-k}` of
`2^{-k(2/q - 1/p)} N(E ∩ J, 2^{-m-k})^{1/q}`. -/
def brsOmegaTwo (E : Set ℝ) (p q : ℝ) (m k : ℕ) : ENNReal :=
  ⨆ u ∈ Icc (1 : ℝ) (2 - brsDyadic k),
    ENNReal.ofReal (brsDyadic k ^ (2 / q - 1 / p)) *
      (intervalCoveringNumber (E ∩ Icc u (u + brsDyadic k))
        (brsDyadic (m + k)) : ENNReal) ^ (1 / q)

/-- The localized quantity is dominated by the global covering number. -/
theorem brsOmegaTwo_le_global {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hq : 0 < q) (m k : ℕ) :
    brsOmegaTwo E p q m k ≤
      ENNReal.ofReal (brsDyadic k ^ (2 / q - 1 / p)) *
        (intervalCoveringNumber E (brsDyadic (m + k)) : ENNReal) ^ (1 / q) := by
  refine iSup₂_le fun u _ => ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ (by positivity))
  exact_mod_cast Nat.cast_le.mpr (intervalCoveringNumber_mono_set
    Set.inter_subset_left hE (brsDyadic_pos (m + k)))

/-- At scale `k = 0` the localized quantity is the global one. -/
theorem brsOmegaTwo_zero_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hq : 0 < q) (m : ℕ) :
    brsOmegaTwo E p q m 0 ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) ^ (1 / q) := by
  have h := brsOmegaTwo_le_global (p := p) hE hq m 0
  simpa [brsDyadic, Real.one_rpow] using h

/-! ## Section 2 of BRS: the three covering estimates -/

/-- **(2.1) of BRS.**  The Minkowski bound, uniformly over subintervals. -/
theorem brs_cover_bound_minkowski {E : Set ℝ} {β : ℝ}
    (hβ : HasUpperMinkowskiExponent E β) {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ J : Set ℝ,
      (intervalCoveringNumber (E ∩ J) δ : ℝ) ≤ C * δ ^ (-(β + ε)) := by
  obtain ⟨C, hC, hbound⟩ := hβ ε hε
  refine ⟨C, hC, fun δ hδ hδ1 J => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hbound δ hδ hδ1
  have hcov : IsIntervalCover (E ∩ J) δ ι :=
    IsIntervalCover.mono Set.inter_subset_left hι
  calc (intervalCoveringNumber (E ∩ J) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hcov
    _ ≤ C * δ ^ (-(β + ε)) := hcard

/-- **(2.2) of BRS.**  The Assouad-spectrum bound at scale parameter `θ`. -/
theorem brs_cover_bound_assouad {E : Set ℝ} {θ γ' : ℝ}
    (hθγ : HasUpperAssouadSpectrumExponent E θ γ') :
    ∃ C : ℝ, 0 < C ∧ ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ' := by
  obtain ⟨C, hC, hbound⟩ := hθγ
  refine ⟨C, hC, fun δ a b hδ hδ1 ha hab hb hscale => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hbound δ a b hδ hδ1 ha hab hb hscale
  calc (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hι
    _ ≤ C * ((b - a) / δ) ^ γ' := hcard

/-- **(2.3) of BRS.**  The trivial bound for a short interval. -/
theorem brs_cover_bound_trivial {E : Set ℝ} {δ a b : ℝ} (hδ : 0 < δ)
    (hab : a ≤ b) :
    (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (b - a) / δ + 3 := by
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_of_subset_Icc
    (F := E ∩ Icc a b) hδ hab Set.inter_subset_right
  have hceil : (Nat.ceil ((b - a) / δ) : ℝ) ≤ (b - a) / δ + 1 :=
    (Nat.ceil_lt_add_one (by positivity)).le
  calc (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hι
    _ ≤ (Nat.ceil ((b - a) / δ) : ℝ) + 2 := hcard
    _ ≤ (b - a) / δ + 3 := by linarith

/-! ## Lemma 2.1 of BRS: two-sided bounds for `ν♯` -/

/-- The elementary inequality behind the upper bound of BRS Lemma 2.1. -/
theorem brs_legendre_term_le {α β γ θ σ : ℝ} (hα : 0 ≤ α) (hβ0 : 0 ≤ β)
    (hγ0 : 0 < γ) (hθ0 : 0 ≤ θ) (hθ1 : θ < 1) (hσ0 : 0 ≤ σ)
    (hMink : (1 - θ) * σ ≤ β) (hQA : σ ≤ γ) :
    θ * α + (1 - θ) * σ ≤ max α ((1 - β / γ) * α + β) := by
  rcases le_or_gt θ (1 - β / γ) with hcase | hcase
  · have h1 : θ * α ≤ (1 - β / γ) * α := mul_le_mul_of_nonneg_right hcase hα
    calc θ * α + (1 - θ) * σ ≤ (1 - β / γ) * α + β := by linarith
      _ ≤ max α ((1 - β / γ) * α + β) := le_max_right _ _
  · have hθpos : 0 < 1 - θ := by linarith
    have h2 : (1 - θ) * σ ≤ (1 - θ) * γ :=
      mul_le_mul_of_nonneg_left hQA hθpos.le
    rcases le_or_gt γ α with hγα | hγα
    · have h3 : (1 - θ) * γ ≤ (1 - θ) * α :=
        mul_le_mul_of_nonneg_left hγα hθpos.le
      calc θ * α + (1 - θ) * σ ≤ θ * α + (1 - θ) * α := by linarith
        _ = α := by ring
        _ ≤ max α ((1 - β / γ) * α + β) := le_max_left _ _
    · have hβγ : β / γ * γ = β := div_mul_cancel₀ β hγ0.ne'
      have h4 : θ * α + (1 - θ) * γ ≤ (1 - β / γ) * α + β := by
        have hd : (1 - β / γ) * α + β - (θ * α + (1 - θ) * γ) =
            (θ - (1 - β / γ)) * (γ - α) := by
          field_simp
          ring
        nlinarith [hd, hcase, hγα]
      calc θ * α + (1 - θ) * σ ≤ θ * α + (1 - θ) * γ := by linarith
        _ ≤ (1 - β / γ) * α + β := h4
        _ ≤ max α ((1 - β / γ) * α + β) := le_max_right _ _

/-- **BRS Lemma 2.1.**  For `α ≥ 0` the Legendre--Assouad function satisfies
`α ≤ ν♯(α) ≤ max(α, (1 - β/γ)α + β)`, where the Minkowski and quasi-Assouad
hypotheses enter through the corresponding bounds for the Assouad spectrum. -/
theorem lemma21_brs {E : Set ℝ} (hE : E.Nonempty) {α β γ : ℝ} (hα : 0 ≤ α)
    (hβ0 : 0 ≤ β) (hγ0 : 0 < γ)
    (hσ0 : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → 0 ≤ Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ)
    (hMink : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → (1 - θ) * Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ ≤ β)
    (hQA : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ ≤ γ) :
    α ≤ brrsLegendreAssouadFunction E α ∧
      brrsLegendreAssouadFunction E α ≤ max α ((1 - β / γ) * α + β) := by
  refine ⟨Auto.Spherical.LegendreAssouad.le_brrsLegendreAssouadFunction_of_nonempty hE hα, ?_⟩
  show Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction E α ≤
    max α ((1 - β / γ) * α + β)
  rw [Auto.Spherical.LegendreAssouad.brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_nonneg hE hα,
    Auto.Spherical.LegendreAssouad.brrsAssouadLegendreTransform]
  refine Real.sSup_le ?_ (le_trans hα (le_max_left _ _))
  rintro x ⟨θ, hθ, rfl⟩
  obtain ⟨hθ0, hθ1⟩ := hθ
  simp only
  by_cases h1 : θ = 1
  · have hpot : Auto.Spherical.LegendreAssouad.brrsAssouadPotential E θ = 0 := by
      simp [Auto.Spherical.LegendreAssouad.brrsAssouadPotential, h1]
    rw [hpot, h1]
    simpa using le_max_left α ((1 - β / γ) * α + β)
  · have hθlt : θ < 1 := lt_of_le_of_ne hθ1 h1
    have hpot : Auto.Spherical.LegendreAssouad.brrsAssouadPotential E θ =
        -(1 - θ) * Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ := by
      simp [Auto.Spherical.LegendreAssouad.brrsAssouadPotential, h1]
    rw [hpot]
    have hterm : θ * α - -(1 - θ) * Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ =
        θ * α + (1 - θ) * Auto.Spherical.LegendreAssouad.brrsAssouadSpectrum E θ := by ring
    rw [hterm]
    exact brs_legendre_term_le hα hβ0 hγ0 hθ0 hθlt (hσ0 θ hθ0 hθlt)
      (hMink θ hθ0 hθlt) (hQA θ hθ0 hθlt)

/-! ## (5.5): splitting `R_2^-` at the singularity -/

/-- The cutoff scale `2^{-11} r` of the BRS splitting. -/
def brsCutScale (r : ℝ) : ℝ := r / 2048

theorem brsCutScale_pos {r : ℝ} (hr : 0 < r) : 0 < brsCutScale r := by
  rw [brsCutScale]
  positivity

/-- Integrability of the singular weight against a continuous function. -/
theorem intervalIntegrable_absWeight_complex {g : ℝ → ℂ} (hg : Continuous g)
    {a b : ℝ} (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) volume a b := by
  have hreal : IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ))
      volume a b := intervalIntegrable_left_weight a b
  have habs : IntervalIntegrable (fun s => |s - a| ^ (-(1 / 2) : ℝ))
      volume a b := by
    refine hreal.congr ?_
    intro s hs
    rw [uIoc_of_le hab] at hs
    obtain ⟨hs1, hs2⟩ := hs
    show (s - a) ^ (-(1 / 2) : ℝ) = |s - a| ^ (-(1 / 2) : ℝ)
    rw [abs_of_pos (by linarith : (0 : ℝ) < s - a)]
  have hcast : IntervalIntegrable
      (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ)) volume a b :=
    ⟨habs.1.ofReal, habs.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn

/-- `𝒜`: the part of `R_2^-` near the endpoint singularity. -/
def brsANearLeft (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Iio (t - r + brsCutScale r)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ`: the part of `R_2^-` away from the endpoint singularity. -/
def brsBFarLeft (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Ici (t - r + brsCutScale r)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5) of BRS.**  `R_2^-` splits into its near and far parts. -/
theorem brsRemTwoTwoLeft_le_add {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoLeft E g r ≤ brsANearLeft E g r + brsBFarLeft E g r := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_le fun t ht => ?_
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  set F : ℝ → ℂ := fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume a t :=
    intervalIntegrable_absWeight_complex hg hab
  have hnear : IntervalIntegrable
      ((Iio (a + brsCutScale r)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Iio, hfull.2.indicator measurableSet_Iio⟩
  have hfar : IntervalIntegrable
      ((Ici (a + brsCutScale r)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Ici, hfull.2.indicator measurableSet_Ici⟩
  have hsplit : ∀ s : ℝ, F s = (Iio (a + brsCutScale r)).indicator F s +
      (Ici (a + brsCutScale r)).indicator F s := by
    intro s
    by_cases hs : s < a + brsCutScale r
    · rw [Set.indicator_of_mem (show s ∈ Iio (a + brsCutScale r) from hs),
        Set.indicator_of_notMem
          (show s ∉ Ici (a + brsCutScale r) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Iio (a + brsCutScale r) from hs),
        Set.indicator_of_mem
          (show s ∈ Ici (a + brsCutScale r) from not_lt.mp hs)]
      ring
  have hint : (∫ s in a..t, F s) =
      (∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s) +
        ∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in a..t, F s‖ ≤
      ‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖ +
        ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖ +
            ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearLeft E g r + brsBFarLeft E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearLeft]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarLeft]
          exact le_iSup₂_of_le t ht le_rfl

/-! ## (5.6): the far part of `R_2^-` -/

/-- The constant bookkeeping in the far-part bound. -/
theorem brs_far_constant_identity {p r : ℝ} (hp : 0 < p) (hr : 0 < r) :
    r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
      (3 ^ (1 / p) * r ^ (1 - 1 / p))) =
      2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ) := by
  have hcut : brsCutScale r ^ (-(1 / 2) : ℝ) =
      2048 ^ (1 / 2 : ℝ) * r ^ (-(1 / 2) : ℝ) := by
    rw [brsCutScale, Real.div_rpow hr.le (by norm_num : (0 : ℝ) ≤ 2048),
      Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2048)]
    field_simp
  have hpow : r ^ (-(1 / 2) : ℝ) * (r ^ (-(1 / 2) : ℝ) * r ^ (1 - 1 / p)) =
      r ^ (-(1 / p) : ℝ) := by
    rw [← Real.rpow_add hr, ← Real.rpow_add hr]
    congr 1
    ring
  rw [hcut]
  calc r ^ (-(1 / 2) : ℝ) * (2048 ^ (1 / 2 : ℝ) * r ^ (-(1 / 2) : ℝ) *
        (3 ^ (1 / p) * r ^ (1 - 1 / p)))
      = 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        (r ^ (-(1 / 2) : ℝ) * (r ^ (-(1 / 2) : ℝ) * r ^ (1 - 1 / p))) := by ring
    _ = 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ) := by rw [hpow]

/-- The far part vanishes for large radii. -/
theorem brsBFarLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ}
    {r : ℝ} (hr : 4 / 3 < r) : brsBFarLeft E g r = 0 := by
  rw [brsBFarLeft]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- The pointwise bound for the far part. -/
theorem brsBFarLeft_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsBFarLeft E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc a t ∩ Ici (a + brsCutScale r) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + brsCutScale r)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + brsCutScale r)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + brsCutScale r ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + brsCutScale r) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + brsCutScale r) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + brsCutScale r ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : a < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by
      have : t / 3 ≤ a := by
        rw [ha]
        linarith
      linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + brsCutScale r)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor

/-- **(5.6) of BRS.**  The far part of `R_2^-` maps `L^p(s ds)` into
`L^q(r dr)` whenever `1 < p` and `q < 2p`. -/
theorem prop56_brsBFarLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsBFarLeft E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsBFarLeft_le hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsBFarLeft E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsBFarLeft E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsBFarLeft_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp

/-! ## (5.5) and (5.6) for `R_2^+` -/

/-- Integrability of the right-endpoint singular weight. -/
theorem intervalIntegrable_absWeightRight_complex {g : ℝ → ℂ} (hg : Continuous g)
    {a b : ℝ} (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) volume a b := by
  have hreal : IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ))
      volume a b := intervalIntegrable_right_weight a b
  have habs : IntervalIntegrable (fun s => |b - s| ^ (-(1 / 2) : ℝ))
      volume a b := by
    refine hreal.congr ?_
    intro s hs
    rw [uIoc_of_le hab] at hs
    obtain ⟨hs1, hs2⟩ := hs
    show (b - s) ^ (-(1 / 2) : ℝ) = |b - s| ^ (-(1 / 2) : ℝ)
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ b - s)]
  have hcast : IntervalIntegrable
      (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ)) volume a b :=
    ⟨habs.1.ofReal, habs.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn

/-- `𝒜`: the part of `R_2^+` near the endpoint singularity. -/
def brsANearRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Ioi (t + r - brsCutScale r)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ`: the part of `R_2^+` away from the endpoint singularity. -/
def brsBFarRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Iic (t + r - brsCutScale r)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5) of BRS, right half.** -/
theorem brsRemTwoTwoRight_le_add {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoRight E g r ≤ brsANearRight E g r + brsBFarRight E g r := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  set F : ℝ → ℂ := fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume t b :=
    intervalIntegrable_absWeightRight_complex hg hab
  have hnear : IntervalIntegrable
      ((Ioi (b - brsCutScale r)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Ioi, hfull.2.indicator measurableSet_Ioi⟩
  have hfar : IntervalIntegrable
      ((Iic (b - brsCutScale r)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Iic, hfull.2.indicator measurableSet_Iic⟩
  have hsplit : ∀ s : ℝ, F s = (Ioi (b - brsCutScale r)).indicator F s +
      (Iic (b - brsCutScale r)).indicator F s := by
    intro s
    by_cases hs : b - brsCutScale r < s
    · rw [Set.indicator_of_mem (show s ∈ Ioi (b - brsCutScale r) from hs),
        Set.indicator_of_notMem
          (show s ∉ Iic (b - brsCutScale r) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (b - brsCutScale r) from hs),
        Set.indicator_of_mem
          (show s ∈ Iic (b - brsCutScale r) from not_lt.mp hs)]
      ring
  have hint : (∫ s in t..b, F s) =
      (∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s) +
        ∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in t..b, F s‖ ≤
      ‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖ +
        ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖ +
            ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearRight E g r + brsBFarRight E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearRight]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarRight]
          exact le_iSup₂_of_le t ht le_rfl

/-- The far part of `R_2^+` vanishes for large radii. -/
theorem brsBFarRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ}
    {r : ℝ} (hr : 4 / 3 < r) : brsBFarRight E g r = 0 := by
  rw [brsBFarRight]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- The pointwise bound for the far part of `R_2^+`. -/
theorem brsBFarRight_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsBFarRight E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc t b ∩ Iic (b - brsCutScale r) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in t..b,
      (Iic (b - brsCutScale r)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc t b, ‖(Iic (b - brsCutScale r)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc t b
      · by_cases h2 : s ≤ b - brsCutScale r
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - brsCutScale r) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Iic (b - brsCutScale r) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - brsCutScale r := hs.2
    have habs : |b - s| = b - s := abs_of_nonneg (by linarith)
    have hle : |b - s| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc, hb]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : t < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b,
        (Iic (b - brsCutScale r)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator
            (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor

/-- **(5.6) of BRS, right half.**  The far part of `R_2^+` maps `L^p(s ds)` into
`L^q(r dr)` whenever `1 < p` and `q < 2p`. -/
theorem prop56_brsBFarRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsBFarRight E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsBFarRight E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsBFarRight_le hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsBFarRight E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsBFarRight E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsBFarRight_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsBFarRight E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp

/-! ## The off-diagonal bound for the signed blocks, `p ≤ q ≤ 2` -/

/-- The off-diagonal `L^q(r\,dr)` bound for a signed centered block. -/
theorem lintegral_brsPieceSigned_offdiag_le {σ a δ p q : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2)
    (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q) ≤
      ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p)) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hqp : (1 : ℝ) ≤ q / p := (one_le_div hp0).mpr hpq
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ :=
    (ENNReal.measurable_ofReal.comp measurable_id).mul (hg.enorm.pow_const p)
  set M : ENNReal := ∫⁻ s, Φ s with hM
  -- the local `L^p` mass is at most three times the weighted global mass
  have hXM : ∀ r : ℝ, (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ≤
      ENNReal.ofReal 3 * M := by
    intro r
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' (measurableSet_brsWindowSigned σ a δ r)
      ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs13 : (1 / 3 : ℝ) ≤ s := hs.2.2
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num),
        show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  -- Hölder on each window
  have hHolder : ∀ r : ℝ, brsPieceSigned σ a δ g r ^ q ≤
      (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
        ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
    intro r
    rw [brsPieceSigned_eq_setLIntegral]
    calc (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ) ^ q
        ≤ ((∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
            volume (brsWindowSigned σ a δ r) ^ (1 - 1 / p)) ^ q :=
          ENNReal.rpow_le_rpow (lintegral_window_holder hp hg) hq0.le
      _ = (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
            volume (brsWindowSigned σ a δ r) ^ (q * (1 - 1 / p)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
            ← ENNReal.rpow_mul]
          congr 2 <;> ring
      _ ≤ (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
            ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
          refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
            (volume_brsWindowSigned_le hδ.le) ?_)
          have : (0 : ℝ) ≤ 1 - 1 / p := by
            rw [sub_nonneg, div_le_one hp0]
            linarith
          positivity
  -- the pointwise bound
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q ≤
      ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
        (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
        (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
          ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      exact zero_le
    · set X : ENNReal := ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p with hX
      have hreal : r * (r ^ (-(1 / 2) : ℝ)) ^ q = r ^ (1 - q / 2) := by
        have h1 : (r ^ (-(1 / 2) : ℝ)) ^ q = r ^ (-(q / 2)) := by
          rw [← Real.rpow_mul hr.le]
          congr 1
          ring
        have h2 : r ^ (1 - q / 2) = r ^ (1 : ℝ) * r ^ (-(q / 2)) := by
          rw [← Real.rpow_add hr, sub_eq_add_neg]
        rw [h1, h2, Real.rpow_one]
      have hweight : ENNReal.ofReal r *
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q =
          ENNReal.ofReal (r ^ (1 - q / 2)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hr.le _) hq0.le,
          ← ENNReal.ofReal_mul hr.le, hreal]
      have hmono : ENNReal.ofReal (r ^ (1 - q / 2)) * X ≤
          ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
        rw [hX, lintegral_indicator (measurableSet_brsWindowSigned σ a δ r),
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_mono_ae ?_
        filter_upwards [self_mem_ae_restrict
          (measurableSet_brsWindowSigned σ a δ r)] with s hs
        have hle := rpow_weight_le_of_window hq1 hq2 hr hs.2.1 hs.2.2
        have h13 : (1 / 3 : ℝ) ≤ s := hs.2.2
        calc ENNReal.ofReal (r ^ (1 - q / 2)) * ‖g s‖ₑ ^ p
            ≤ ENNReal.ofReal (2 * 3 ^ (q / 2) * s) * ‖g s‖ₑ ^ p :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ = ENNReal.ofReal (2 * 3 ^ (q / 2)) * Φ s := by
              rw [hΦdef, ENNReal.ofReal_mul (by positivity)]
              ring
      calc ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q
          = ENNReal.ofReal (r ^ (1 - q / 2)) *
              brsPieceSigned σ a δ g r ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc, hweight]
        _ ≤ ENNReal.ofReal (r ^ (1 - q / 2)) *
              (X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
            mul_le_mul' le_rfl (hHolder r)
        _ ≤ ENNReal.ofReal (r ^ (1 - q / 2)) *
              ((X * (ENNReal.ofReal 3 * M) ^ (q / p - 1)) *
                ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
            mul_le_mul' le_rfl (mul_le_mul'
              (ennreal_rpow_le_mul_of_le hqp (hXM r)) le_rfl)
        _ = ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
              (ENNReal.ofReal (r ^ (1 - q / 2)) * X) := by ring
        _ ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) :=
            mul_le_mul' le_rfl hmono
  -- integrate in the radius
  have hmass : (∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * M :=
    lintegral_brsWindowSigned_le hσ hδ.le hΦmeas
  have he0 : (0 : ℝ) ≤ q * (1 - 1 / p) := by
    have : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    positivity
  rcases eq_or_ne (ENNReal.ofReal 3 * M) ⊤ with hMtop | hMtop
  · have hMq : (ENNReal.ofReal 3 * M) ^ (q / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity)]
    have hpos : (0 : ENNReal) < ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) :=
      ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hδ3) ENNReal.ofReal_ne_top
    have htop : ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 * M) ^ (q / p)) = ⊤ := by
      rw [hMq, ENNReal.mul_top hpos.ne', ENNReal.mul_top]
      exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
    rw [htop]
    exact le_top
  · set C : ENNReal := ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
      (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
      ENNReal.ofReal (2 * 3 ^ (q / 2)) with hC
    have hCne : C ≠ ⊤ := by
      refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg he0 ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hMtop
    calc (∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q)
        ≤ ∫⁻ r, C * ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
          refine le_trans (lintegral_mono hpt) (le_of_eq (lintegral_congr ?_))
          intro r
          rw [hC]
          ring
      _ = C * ∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s :=
          lintegral_const_mul' _ _ hCne
      _ ≤ C * (ENNReal.ofReal (3 * δ) * M) := mul_le_mul' le_rfl hmass
      _ ≤ ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
              (ENNReal.ofReal 3 * M) ^ (q / p)) := by
          rw [hC]
          have hMle : M ≤ ENNReal.ofReal 3 * M := by
            refine le_mul_of_one_le_left' ?_
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
            exact ENNReal.ofReal_le_ofReal (by norm_num)
          have hpow : ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              ENNReal.ofReal (3 * δ) =
              ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) := by
            rw [ENNReal.rpow_add_of_nonneg _ _ he0 (by norm_num),
              ENNReal.rpow_one]
          calc ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * δ) * M)
              ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                  (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                  ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  (ENNReal.ofReal (3 * δ) * (ENNReal.ofReal 3 * M)) :=
                mul_le_mul' le_rfl (mul_le_mul' le_rfl hMle)
            _ = ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ((ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                    ENNReal.ofReal (3 * δ)) *
                    ((ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                      (ENNReal.ofReal 3 * M))) := by ring
            _ ≤ ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
                    (ENNReal.ofReal 3 * M) ^ (q / p)) := by
                refine mul_le_mul' le_rfl (mul_le_mul' (le_of_eq hpow)
                  (ennreal_rpow_sub_one_mul_le hqp))

/-- The off-diagonal `L^q(r\,dr)` bound for the supremum of signed blocks. -/
theorem lintegral_iSup_signed_offdiag_le {ι : Finset ℝ} {σ δ p q : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) (hδ : 0 < δ)
    (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q) ≤
      (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 *
            ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p))) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  set K : ENNReal := ENNReal.ofReal (2 * 3 ^ (q / 2)) *
    (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
      (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p))
    with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          brsPieceSigned σ (c a) δ g r) ^ q := by
    intro r
    have hsum := iSup_rpow_le_sum hq0 ι fun a => brsPieceSigned σ (c a) δ g r
    calc ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q
        = ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q *
            (⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, mul_assoc]
      _ ≤ ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q *
            ∑ a ∈ ι, brsPieceSigned σ (c a) δ g r ^ q :=
          mul_le_mul' le_rfl hsum
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              brsPieceSigned σ (c a) δ g r) ^ q := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, mul_assoc]
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ => ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        brsPieceSigned σ (c a) δ g r) ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_rpow_neg_half.mul (measurable_brsPieceSigned hg)).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsPieceSigned_offdiag_le hσ hp hpq hq2 hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]

/-- The coefficient of the `m`-th block in the off-diagonal bound for
`R_2^±`. -/
def brsProp54Coeff (E : Set ℝ) (p q : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1))) ^ (1 / q)

/-- **An off-diagonal bound for `R_2^-`** in the range `1 < p ≤ q ≤ 2`, with
the global covering numbers in place of the localized quantities of BRS
Proposition 5.4. -/
theorem prop54_brsRemTwoTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp54Coeff E p q m) *
        (ENNReal.ofReal 3 *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p
    with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned (-1) (-a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => -a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ q := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsRemTwoTwoLeft_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceLeft E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceLeft_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp54Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
              M ^ (q / p))) := by
      have h := lintegral_iSup_signed_offdiag_le (ι := ι m) (σ := (-1 : ℝ))
        (Or.inr rfl) hp hpq hq2 (brsDyadic_pos m) (fun a => -a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
              (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                M ^ (q / p)))) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp54Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp54Coeff, hc]
          rw [show ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                  M ^ (q / p)))) =
              ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
                (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ENNReal.ofReal (3 * brsDyadic m) ^
                    (q * (1 - 1 / p) + 1))) * M ^ (q / p) from by ring]
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp54Coeff E p q m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp54Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **An off-diagonal bound for `R_2^+`** in the range `1 < p ≤ q ≤ 2`, with
the global covering numbers in place of the localized quantities of BRS
Proposition 5.4. -/
theorem prop54_brsRemTwoTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp54Coeff E p q m) *
        (ENNReal.ofReal 3 *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p
    with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ q := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsRemTwoTwoRight_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceRight E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceRight_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp54Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
              M ^ (q / p))) := by
      have h := lintegral_iSup_signed_offdiag_le (ι := ι m) (σ := (1 : ℝ))
        (Or.inl rfl) hp hpq hq2 (brsDyadic_pos m) (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
              (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                M ^ (q / p)))) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp54Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp54Coeff, hc]
          rw [show ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                  M ^ (q / p)))) =
              ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
                (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ENNReal.ofReal (3 * brsDyadic m) ^
                    (q * (1 - 1 / p) + 1))) * M ^ (q / p) from by ring]
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp54Coeff E p q m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp54Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-! ## (5.7): a telescoping resolution of the identity

The `L¹`-normalized dilates of a fixed profile give an approximate identity,
and their consecutive differences are the Littlewood--Paley pieces: each has
vanishing integral, and the dilates telescope into the low-frequency piece
plus the sum of the differences.  This is the elementary half of BRS (5.7). -/

/-- The `L¹`-normalized dilate `φ_j(x) = 2^j φ(2^j x)`. -/
def brsDilate (φ : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ := 2 ^ j * φ (2 ^ j * x)

theorem brsDilate_zero (φ : ℝ → ℝ) (x : ℝ) : brsDilate φ 0 x = φ x := by
  simp [brsDilate]

theorem continuous_brsDilate {φ : ℝ → ℝ} (hφ : Continuous φ) (j : ℕ) :
    Continuous (brsDilate φ j) := by
  show Continuous fun x : ℝ => 2 ^ j * φ (2 ^ j * x)
  exact continuous_const.mul (hφ.comp (continuous_const.mul continuous_id))

theorem hasCompactSupport_brsDilate {φ : ℝ → ℝ} (hφ : HasCompactSupport φ)
    (j : ℕ) : HasCompactSupport (brsDilate φ j) := by
  have hne : (2 : ℝ) ^ j ≠ 0 := by positivity
  have hcomp : HasCompactSupport (fun x : ℝ => φ (2 ^ j * x)) := by
    have hhom : HasCompactSupport (φ ∘ fun x : ℝ => (2 : ℝ) ^ j * x) := by
      refine hφ.comp_homeomorph (Homeomorph.mulLeft₀ ((2 : ℝ) ^ j) hne)
    exact hhom
  exact hcomp.mul_left

/-- Dilation preserves the integral. -/
theorem integral_brsDilate (φ : ℝ → ℝ) (j : ℕ) :
    (∫ x, brsDilate φ j x) = ∫ x, φ x := by
  have hne : (2 : ℝ) ^ j ≠ 0 := by positivity
  show (∫ x : ℝ, 2 ^ j * φ (2 ^ j * x)) = ∫ x, φ x
  rw [integral_const_mul]
  rw [MeasureTheory.Measure.integral_comp_mul_left (fun y => φ y) ((2 : ℝ) ^ j)]
  rw [smul_eq_mul, ← mul_assoc]
  have habs : |((2 : ℝ) ^ j)⁻¹| = ((2 : ℝ) ^ j)⁻¹ :=
    abs_of_pos (by positivity)
  rw [habs, mul_inv_cancel₀ hne, one_mul]

/-- The Littlewood--Paley piece `ψ_j = φ_j - φ_{j-1}`. -/
def brsLPKernel (φ : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  brsDilate φ (j + 1) x - brsDilate φ j x

theorem continuous_brsLPKernel {φ : ℝ → ℝ} (hφ : Continuous φ) (j : ℕ) :
    Continuous (brsLPKernel φ j) :=
  (continuous_brsDilate hφ (j + 1)).sub (continuous_brsDilate hφ j)

theorem hasCompactSupport_brsLPKernel {φ : ℝ → ℝ} (hφ : HasCompactSupport φ)
    (j : ℕ) : HasCompactSupport (brsLPKernel φ j) :=
  (hasCompactSupport_brsDilate hφ (j + 1)).sub (hasCompactSupport_brsDilate hφ j)

/-- **The vanishing moment of a Littlewood--Paley piece.** -/
theorem integral_brsLPKernel_eq_zero {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (j : ℕ) :
    (∫ x, brsLPKernel φ j x) = 0 := by
  have h1 : Integrable (brsDilate φ (j + 1)) :=
    (continuous_brsDilate hφ (j + 1)).integrable_of_hasCompactSupport
      (hasCompactSupport_brsDilate hsupp (j + 1))
  have h2 : Integrable (brsDilate φ j) :=
    (continuous_brsDilate hφ j).integrable_of_hasCompactSupport
      (hasCompactSupport_brsDilate hsupp j)
  show (∫ x, brsDilate φ (j + 1) x - brsDilate φ j x) = 0
  rw [integral_sub h1 h2, integral_brsDilate, integral_brsDilate, sub_self]

/-- **The telescoping identity for the dilates.** -/
theorem brsDilate_eq_add_sum (φ : ℝ → ℝ) (J : ℕ) (x : ℝ) :
    brsDilate φ J x = brsDilate φ 0 x +
      ∑ j ∈ Finset.range J, brsLPKernel φ j x := by
  induction J with
  | zero => simp
  | succ J ih =>
      rw [Finset.sum_range_succ, ← add_assoc, ← ih]
      show brsDilate φ (J + 1) x =
        brsDilate φ J x + (brsDilate φ (J + 1) x - brsDilate φ J x)
      ring

/-- **(5.7) of BRS, in telescoping form.**  Against any bounded continuous
function, the dilate at scale `2^J` splits into the low-frequency piece and
the sum of the Littlewood--Paley pieces. -/
theorem brs_lp_resolution {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) {g : ℝ → ℂ} (hg : Continuous g)
    (J : ℕ) (x : ℝ) :
    (∫ y, (brsDilate φ J y : ℂ) * g (x - y)) =
      (∫ y, (brsDilate φ 0 y : ℂ) * g (x - y)) +
        ∑ j ∈ Finset.range J, ∫ y, (brsLPKernel φ j y : ℂ) * g (x - y) := by
  have hgc : Continuous fun y : ℝ => g (x - y) :=
    hg.comp (continuous_const.sub continuous_id)
  have hint : ∀ (ψ : ℝ → ℝ), Continuous ψ → HasCompactSupport ψ →
      Integrable (fun y => (ψ y : ℂ) * g (x - y)) := by
    intro ψ hψ hψs
    have hcont : Continuous fun y : ℝ => (ψ y : ℂ) * g (x - y) :=
      (Complex.continuous_ofReal.comp hψ).mul hgc
    refine hcont.integrable_of_hasCompactSupport ?_
    have : HasCompactSupport fun y : ℝ => (ψ y : ℂ) :=
      hψs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
    exact this.mul_right
  have hsum : ∀ y : ℝ, (brsDilate φ J y : ℂ) * g (x - y) =
      (brsDilate φ 0 y : ℂ) * g (x - y) +
        ∑ j ∈ Finset.range J, (brsLPKernel φ j y : ℂ) * g (x - y) := by
    intro y
    rw [← Finset.sum_mul, ← Complex.ofReal_sum, ← add_mul,
      ← Complex.ofReal_add, ← brsDilate_eq_add_sum φ J y]
  rw [show (∫ y, (brsDilate φ J y : ℂ) * g (x - y)) =
      ∫ y, ((brsDilate φ 0 y : ℂ) * g (x - y) +
        ∑ j ∈ Finset.range J, (brsLPKernel φ j y : ℂ) * g (x - y)) from
    integral_congr_ae (Filter.Eventually.of_forall hsum)]
  rw [integral_add (hint _ (continuous_brsDilate hφ 0)
      (hasCompactSupport_brsDilate hsupp 0))
    (integrable_finsetSum _ fun j _ =>
      hint _ (continuous_brsLPKernel hφ j) (hasCompactSupport_brsLPKernel hsupp j))]
  congr 1
  exact integral_finsetSum _ fun j _ =>
    hint _ (continuous_brsLPKernel hφ j) (hasCompactSupport_brsLPKernel hsupp j)

/-! ## The dilates form an approximate identity -/

theorem abs_brsDilate (φ : ℝ → ℝ) (j : ℕ) (y : ℝ) :
    |brsDilate φ j y| = brsDilate (fun x => |φ x|) j y := by
  show |2 ^ j * φ (2 ^ j * y)| = 2 ^ j * |φ (2 ^ j * y)|
  rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < 2 ^ j)]

theorem integral_abs_brsDilate {φ : ℝ → ℝ} (j : ℕ) :
    (∫ y, |brsDilate φ j y|) = ∫ x, |φ x| := by
  simp_rw [abs_brsDilate]
  exact integral_brsDilate (fun x => |φ x|) j

/-- Outside a shrinking neighbourhood of the origin the dilates vanish. -/
theorem brsDilate_eq_zero_of_lt {φ : ℝ → ℝ} {R : ℝ}
    (hR : tsupport φ ⊆ Metric.closedBall 0 R) (j : ℕ) {y : ℝ}
    (hy : R / 2 ^ j < |y|) : brsDilate φ j y = 0 := by
  have h2 : (0 : ℝ) < 2 ^ j := by positivity
  have hball : (2 : ℝ) ^ j * y ∉ Metric.closedBall (0 : ℝ) R := by
    simp only [Metric.mem_closedBall, dist_zero_right, Real.norm_eq_abs,
      not_le, abs_mul, abs_of_pos h2]
    rw [div_lt_iff₀ h2] at hy
    linarith [hy]
  have hsupp : (2 : ℝ) ^ j * y ∉ tsupport φ := fun hc => hball (hR hc)
  have : φ ((2 : ℝ) ^ j * y) = 0 := image_eq_zero_of_notMem_tsupport hsupp
  show 2 ^ j * φ (2 ^ j * y) = 0
  rw [this, mul_zero]

/-- **The dilates form an approximate identity.**  For a compactly supported
continuous profile of total integral one, the smoothed values converge to the
value of a continuous function. -/
theorem tendsto_brsDilate_convolution {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (hnorm : (∫ x, φ x) = 1) {g : ℝ → ℂ}
    (hg : Continuous g) (x : ℝ) :
    Tendsto (fun J : ℕ => ∫ y, (brsDilate φ J y : ℂ) * g (x - y)) atTop
      (𝓝 (g x)) := by
  obtain ⟨R, hR0, hR⟩ : ∃ R : ℝ, 0 < R ∧ tsupport φ ⊆ Metric.closedBall 0 R := by
    obtain ⟨R, hR⟩ := (hsupp.isCompact.isBounded).subset_closedBall (0 : ℝ)
    exact ⟨max R 1, lt_of_lt_of_le zero_lt_one (le_max_right _ _),
      hR.trans (Metric.closedBall_subset_closedBall (le_max_left _ _))⟩
  set L : ℝ := ∫ x, |φ x| with hL
  have hLnn : 0 ≤ L := by
    rw [hL]
    exact integral_nonneg fun x => abs_nonneg _
  have hgc : ∀ z : ℝ, Continuous fun y : ℝ => g (z - y) := fun z =>
    hg.comp (continuous_const.sub continuous_id)
  -- integrability of the smoothed integrands
  have hint : ∀ (ψ : ℝ → ℝ), Continuous ψ → HasCompactSupport ψ →
      ∀ h : ℝ → ℂ, Continuous h →
      Integrable (fun y => (ψ y : ℂ) * h y) := by
    intro ψ hψ hψs h hh
    have hcont : Continuous fun y : ℝ => (ψ y : ℂ) * h y :=
      (Complex.continuous_ofReal.comp hψ).mul hh
    refine hcont.integrable_of_hasCompactSupport ?_
    have hcs : HasCompactSupport fun y : ℝ => (ψ y : ℂ) :=
      hψs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
    exact hcs.mul_right
  have hintAbs : ∀ (ψ : ℝ → ℝ), Continuous ψ → HasCompactSupport ψ →
      Integrable fun y => |ψ y| := by
    intro ψ hψ hψs
    exact (hψ.abs).integrable_of_hasCompactSupport hψs.abs
  -- the normalization
  have hone : ∀ J : ℕ, (∫ y, (brsDilate φ J y : ℂ)) = 1 := by
    intro J
    rw [integral_complex_ofReal, integral_brsDilate, hnorm]
    simp
  refine Metric.tendsto_atTop.mpr fun ε hε => ?_
  set ε' : ℝ := ε / (2 * (L + 1)) with hε'
  have hε'pos : 0 < ε' := by
    rw [hε']
    positivity
  obtain ⟨δ, hδ0, hδ⟩ : ∃ δ : ℝ, 0 < δ ∧ ∀ y : ℝ, |y| ≤ δ →
      ‖g (x - y) - g x‖ ≤ ε' := by
    have hcont : ContinuousAt (fun y : ℝ => g (x - y)) 0 := (hgc x).continuousAt
    have : ∀ᶠ y : ℝ in 𝓝 (0 : ℝ), ‖g (x - y) - g x‖ < ε' := by
      have htend := hcont.tendsto
      simp only [sub_zero] at htend
      have hmem := htend (Metric.ball_mem_nhds (g x) hε'pos)
      rw [Filter.mem_map] at hmem
      filter_upwards [hmem] with y hy
      rw [← dist_eq_norm]
      exact hy
    obtain ⟨δ, hδ0, hδball⟩ := Metric.eventually_nhds_iff.mp this
    refine ⟨δ / 2, by positivity, fun y hy => ?_⟩
    refine le_of_lt (hδball ?_)
    rw [Real.dist_eq, sub_zero]
    linarith
  obtain ⟨N, hN⟩ : ∃ N : ℕ, R / 2 ^ N ≤ δ := by
    obtain ⟨N, hNlt⟩ := pow_unbounded_of_one_lt (R / δ) (by norm_num : (1 : ℝ) < 2)
    refine ⟨N, ?_⟩
    rw [div_le_iff₀ (by positivity : (0 : ℝ) < 2 ^ N)]
    rw [div_lt_iff₀ hδ0] at hNlt
    linarith
  refine ⟨N, fun J hJ => ?_⟩
  have hRJ : R / 2 ^ J ≤ δ := by
    refine le_trans ?_ hN
    refine div_le_div_of_nonneg_left hR0.le (by positivity) ?_
    exact pow_le_pow_right₀ (by norm_num) hJ
  -- rewrite the difference
  have hdiff : (∫ y, (brsDilate φ J y : ℂ) * g (x - y)) - g x =
      ∫ y, (brsDilate φ J y : ℂ) * (g (x - y) - g x) := by
    have h1 : Integrable fun y => (brsDilate φ J y : ℂ) * g (x - y) :=
      hint _ (continuous_brsDilate hφ J) (hasCompactSupport_brsDilate hsupp J)
        _ (hgc x)
    have h2 : Integrable fun y => (brsDilate φ J y : ℂ) * g x :=
      hint _ (continuous_brsDilate hφ J) (hasCompactSupport_brsDilate hsupp J)
        _ continuous_const
    have h3 : (∫ y, (brsDilate φ J y : ℂ) * g x) = g x := by
      rw [integral_mul_const, hone J, one_mul]
    rw [show (fun y => (brsDilate φ J y : ℂ) * (g (x - y) - g x)) =
        (fun y => (brsDilate φ J y : ℂ) * g (x - y) -
          (brsDilate φ J y : ℂ) * g x) from by
      funext y
      ring]
    rw [integral_sub h1 h2, h3]
  -- the pointwise bound
  have hptbound : ∀ y : ℝ,
      ‖(brsDilate φ J y : ℂ) * (g (x - y) - g x)‖ ≤ |brsDilate φ J y| * ε' := by
    intro y
    rcases le_or_gt |y| (R / 2 ^ J) with hy | hy
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left (hδ y (le_trans hy hRJ)) (abs_nonneg _)
    · rw [brsDilate_eq_zero_of_lt hR J hy]
      simp
  have hnormle : ‖∫ y, (brsDilate φ J y : ℂ) * (g (x - y) - g x)‖ ≤ L * ε' := by
    refine le_trans (norm_integral_le_integral_norm _) ?_
    have hint1 : Integrable fun y => ‖(brsDilate φ J y : ℂ) * (g (x - y) - g x)‖ :=
      (hint _ (continuous_brsDilate hφ J) (hasCompactSupport_brsDilate hsupp J)
        _ ((hgc x).sub continuous_const)).norm
    have hint2 : Integrable fun y => |brsDilate φ J y| * ε' :=
      (hintAbs _ (continuous_brsDilate hφ J)
        (hasCompactSupport_brsDilate hsupp J)).mul_const _
    refine le_trans (integral_mono hint1 hint2 hptbound) (le_of_eq ?_)
    rw [integral_mul_const, integral_abs_brsDilate]
  rw [dist_eq_norm, hdiff]
  have hLL : L / (L + 1) ≤ 1 := by
    rw [div_le_one (by linarith)]
    linarith
  have hsplit : L * ε' = (L / (L + 1)) * (ε / 2) := by
    rw [hε']
    field_simp
  calc ‖∫ y, (brsDilate φ J y : ℂ) * (g (x - y) - g x)‖ ≤ L * ε' := hnormle
    _ = (L / (L + 1)) * (ε / 2) := hsplit
    _ ≤ 1 * (ε / 2) := mul_le_mul_of_nonneg_right hLL (by positivity)
    _ = ε / 2 := one_mul _
    _ < ε := by linarith

/-- **(5.7) of BRS, in limit form.**  The low-frequency piece together with the
Littlewood--Paley pieces resolves the identity: the partial sums converge to
the value of the function. -/
theorem brs_lp_resolution_tendsto {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (hnorm : (∫ x, φ x) = 1) {g : ℝ → ℂ}
    (hg : Continuous g) (x : ℝ) :
    Tendsto (fun J : ℕ => (∫ y, (brsDilate φ 0 y : ℂ) * g (x - y)) +
        ∑ j ∈ Finset.range J, ∫ y, (brsLPKernel φ j y : ℂ) * g (x - y))
      atTop (𝓝 (g x)) := by
  have h := tendsto_brsDilate_convolution hφ hsupp hnorm hg x
  refine h.congr fun J => ?_
  exact brs_lp_resolution hφ hsupp hg J x

/-! ## Kernels with vanishing moments of higher order

An `N`-fold difference of a compactly supported profile has vanishing moments
of every order below `N`.  This is the ingredient BRS use through the
factorization in (5.7), and it is what powers the kernel estimates (5.11). -/

/-- The alternating binomial sum against a power vanishes below the order. -/
theorem brs_alternating_sum_pow_eq_zero {N j : ℕ} (hj : j < N) :
    ∑ k ∈ Finset.range (N + 1), (-1 : ℝ) ^ k * (N.choose k) * (k : ℝ) ^ j = 0 := by
  have hzero : (fwdDiff (1 : ℝ))^[N] (fun r : ℝ => r ^ j) = 0 :=
    fwdDiff_iter_pow_eq_zero_of_lt hj
  have hsum := fwdDiff_iter_eq_sum_shift (h := (1 : ℝ))
    (fun r : ℝ => r ^ j) N 0
  rw [hzero] at hsum
  have hsum' : (0 : ℝ) =
      ∑ k ∈ Finset.range (N + 1), ((-1 : ℤ) ^ (N - k) * (N.choose k) : ℤ) •
        ((k : ℝ) ^ j) := by
    simpa using hsum
  have hfac : ∀ k ∈ Finset.range (N + 1),
      ((-1 : ℤ) ^ (N - k) * (N.choose k) : ℤ) • ((k : ℝ) ^ j) =
        (-1 : ℝ) ^ N * ((-1 : ℝ) ^ k * (N.choose k) * (k : ℝ) ^ j) := by
    intro k hk
    have hkN : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have hpow : ((-1 : ℝ)) ^ (N - k) = (-1 : ℝ) ^ N * (-1 : ℝ) ^ k := by
      have : (-1 : ℝ) ^ N = (-1 : ℝ) ^ (N - k) * (-1 : ℝ) ^ k := by
        rw [← pow_add]
        congr 1
        omega
      rw [this]
      rw [mul_assoc, ← pow_add]
      have h2 : k + k = 2 * k := by ring
      rw [h2, pow_mul]
      norm_num
    rw [zsmul_eq_mul]
    push_cast
    rw [hpow]
    ring
  rw [Finset.sum_congr rfl hfac, ← Finset.mul_sum] at hsum'
  have hne : ((-1 : ℝ) ^ N) ≠ 0 := pow_ne_zero N (by norm_num)
  exact (mul_eq_zero.mp hsum'.symm).resolve_left hne

/-- The `N`-fold difference of a profile, at spacing `h`. -/
def brsMomentKernel (χ : ℝ → ℝ) (N : ℕ) (h : ℝ) (x : ℝ) : ℝ :=
  ∑ k ∈ Finset.range (N + 1), (-1 : ℝ) ^ k * (N.choose k) * χ (x - k * h)

theorem continuous_brsMomentKernel {χ : ℝ → ℝ} (hχ : Continuous χ) (N : ℕ)
    (h : ℝ) : Continuous (brsMomentKernel χ N h) := by
  refine continuous_finsetSum _ fun k _ => ?_
  exact continuous_const.mul (hχ.comp (continuous_id.sub continuous_const))

theorem hasCompactSupport_finsetSum {ι : Type*} {s : Finset ι}
    {f : ι → ℝ → ℝ} (hf : ∀ i ∈ s, HasCompactSupport (f i)) :
    HasCompactSupport (fun x => ∑ i ∈ s, f i x) := by
  classical
  induction s using Finset.induction with
  | empty =>
      have hz : HasCompactSupport (fun _ : ℝ => (0 : ℝ)) := by
        rw [hasCompactSupport_def]
        simp
      simpa using hz
  | insert a s ha ih =>
      have hmem : ∀ i ∈ s, HasCompactSupport (f i) := fun i hi =>
        hf i (Finset.mem_insert_of_mem hi)
      have hsum := ih hmem
      have hfa := hf a (Finset.mem_insert_self a s)
      have : (fun x => ∑ i ∈ insert a s, f i x) =
          fun x => f a x + ∑ i ∈ s, f i x := by
        funext x
        rw [Finset.sum_insert ha]
      rw [this]
      exact hfa.add hsum

theorem hasCompactSupport_brsMomentKernel {χ : ℝ → ℝ}
    (hχ : HasCompactSupport χ) (N : ℕ) (h : ℝ) :
    HasCompactSupport (brsMomentKernel χ N h) := by
  refine hasCompactSupport_finsetSum fun k _ => ?_
  refine HasCompactSupport.mul_left ?_
  exact hχ.comp_homeomorph (Homeomorph.subRight ((k : ℝ) * h))

/-- **Vanishing moments of the difference kernel.** -/
theorem integral_pow_mul_brsMomentKernel {χ : ℝ → ℝ} (hχ : Continuous χ)
    (hsupp : HasCompactSupport χ) {N j : ℕ} (hj : j < N) (h : ℝ) :
    (∫ x, x ^ j * brsMomentKernel χ N h x) = 0 := by
  -- the moments of the profile
  set m : ℕ → ℝ := fun i => ∫ y, y ^ i * χ y with hm
  have hintPow : ∀ (i : ℕ) (c : ℝ),
      Integrable fun x : ℝ => x ^ i * χ (x - c) := by
    intro i c
    have hcont : Continuous fun x : ℝ => x ^ i * χ (x - c) :=
      (continuous_pow i).mul (hχ.comp (continuous_id.sub continuous_const))
    refine hcont.integrable_of_hasCompactSupport ?_
    exact HasCompactSupport.mul_left
      (hsupp.comp_homeomorph (Homeomorph.subRight c))
  have hintPow0 : ∀ i : ℕ, Integrable fun y : ℝ => y ^ i * χ y := by
    intro i
    have := hintPow i 0
    simpa using this
  -- the shifted moment expansion
  have hshift : ∀ c : ℝ, (∫ x, x ^ j * χ (x - c)) =
      ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * c ^ (j - i) * m i := by
    intro c
    have hsub : (∫ x, ((x - c) + c) ^ j * χ (x - c)) =
        ∫ y, (y + c) ^ j * χ y :=
      integral_sub_right_eq_self (fun y => (y + c) ^ j * χ y) c
    have hlhs : (∫ x, x ^ j * χ (x - c)) = ∫ x, ((x - c) + c) ^ j * χ (x - c) := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      show x ^ j * χ (x - c) = (x - c + c) ^ j * χ (x - c)
      rw [sub_add_cancel]
    rw [hlhs, hsub]
    have hexp : ∀ y : ℝ, (y + c) ^ j * χ y =
        ∑ i ∈ Finset.range (j + 1), (j.choose i : ℝ) * c ^ (j - i) * (y ^ i * χ y) := by
      intro y
      rw [add_pow]
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      ring
    refine Eq.trans (integral_congr_ae (Filter.Eventually.of_forall hexp)) ?_
    refine Eq.trans
      (integral_finsetSum _ fun i _ => ((hintPow0 i).const_mul _)) ?_
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [integral_const_mul, hm]
  -- expand the kernel
  have hexpand : (∫ x, x ^ j * brsMomentKernel χ N h x) =
      ∑ k ∈ Finset.range (N + 1), (-1 : ℝ) ^ k * (N.choose k) *
        ∫ x, x ^ j * χ (x - k * h) := by
    have hpt : ∀ x : ℝ, x ^ j * brsMomentKernel χ N h x =
        ∑ k ∈ Finset.range (N + 1), (-1 : ℝ) ^ k * (N.choose k) *
          (x ^ j * χ (x - k * h)) := by
      intro x
      rw [brsMomentKernel, Finset.mul_sum]
      refine Finset.sum_congr rfl fun k _ => ?_
      ring
    refine Eq.trans (integral_congr_ae (Filter.Eventually.of_forall hpt)) ?_
    refine Eq.trans
      (integral_finsetSum _ fun k _ => ((hintPow j ((k : ℝ) * h)).const_mul _)) ?_
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [integral_const_mul]
  rw [hexpand]
  -- swap the two sums and use the alternating identity
  have hswap : ∑ k ∈ Finset.range (N + 1), (-1 : ℝ) ^ k * (N.choose k) *
      (∫ x, x ^ j * χ (x - k * h)) =
      ∑ k ∈ Finset.range (N + 1), ∑ i ∈ Finset.range (j + 1),
        ((-1 : ℝ) ^ k * (N.choose k)) *
          ((j.choose i : ℝ) * ((k : ℝ) * h) ^ (j - i) * m i) := by
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [hshift ((k : ℝ) * h), Finset.mul_sum]
  rw [hswap, Finset.sum_comm]
  refine Finset.sum_eq_zero fun i hi => ?_
  have hji : j - i < N := lt_of_le_of_lt (Nat.sub_le j i) hj
  have hterm : ∀ k ∈ Finset.range (N + 1),
      ((-1 : ℝ) ^ k * (N.choose k)) *
        ((j.choose i : ℝ) * ((k : ℝ) * h) ^ (j - i) * m i) =
      ((j.choose i : ℝ) * h ^ (j - i) * m i) *
        ((-1 : ℝ) ^ k * (N.choose k) * (k : ℝ) ^ (j - i)) := by
    intro k _
    rw [mul_pow]
    ring
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum,
    brs_alternating_sum_pow_eq_zero hji, mul_zero]

/-! ## Littlewood--Paley pieces with vanishing moments

If the profile itself has vanishing moments of orders `1, …, N-1` and total
mass one, then every Littlewood--Paley piece has vanishing moments of all
orders below `N`, while the dilates still resolve the identity. -/

/-- The moments of a dilate scale by the expected power. -/
theorem integral_pow_mul_brsDilate {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (i j : ℕ) :
    (∫ x, x ^ i * brsDilate φ j x) =
      ((2 : ℝ) ^ j) ^ (-(i : ℤ)) * ∫ y, y ^ i * φ y := by
  have ha : (0 : ℝ) < 2 ^ j := by positivity
  have hane : ((2 : ℝ) ^ j) ≠ 0 := ne_of_gt ha
  have hstep : (∫ x, x ^ i * φ (2 ^ j * x)) =
      |((2 : ℝ) ^ j)⁻¹| * ∫ y, (y / 2 ^ j) ^ i * φ y := by
    have hg := MeasureTheory.Measure.integral_comp_mul_left
      (fun y : ℝ => (y / 2 ^ j) ^ i * φ y) ((2 : ℝ) ^ j)
    have hlhs : (∫ x, ((2 : ℝ) ^ j * x / 2 ^ j) ^ i * φ (2 ^ j * x)) =
        ∫ x, x ^ i * φ (2 ^ j * x) := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
      show ((2 : ℝ) ^ j * x / 2 ^ j) ^ i * φ (2 ^ j * x) =
        x ^ i * φ (2 ^ j * x)
      congr 2
      field_simp
    rw [hlhs] at hg
    rw [hg, smul_eq_mul]
  have hdiv : (∫ y, (y / 2 ^ j) ^ i * φ y) =
      ((2 : ℝ) ^ j) ^ (-(i : ℤ)) * ∫ y, y ^ i * φ y := by
    have hpt : ∀ y : ℝ, (y / 2 ^ j) ^ i * φ y =
        ((2 : ℝ) ^ j) ^ (-(i : ℤ)) * (y ^ i * φ y) := by
      intro y
      rw [div_pow, zpow_neg, zpow_natCast]
      field_simp
    rw [show (∫ y, (y / 2 ^ j) ^ i * φ y) =
        ∫ y, ((2 : ℝ) ^ j) ^ (-(i : ℤ)) * (y ^ i * φ y) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    rw [integral_const_mul]
  have hfinal : (∫ x, x ^ i * brsDilate φ j x) =
      2 ^ j * ∫ x, x ^ i * φ (2 ^ j * x) := by
    have hpt : ∀ x : ℝ, x ^ i * brsDilate φ j x =
        2 ^ j * (x ^ i * φ (2 ^ j * x)) := by
      intro x
      show x ^ i * (2 ^ j * φ (2 ^ j * x)) = 2 ^ j * (x ^ i * φ (2 ^ j * x))
      ring
    rw [show (∫ x, x ^ i * brsDilate φ j x) =
        ∫ x, 2 ^ j * (x ^ i * φ (2 ^ j * x)) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    rw [integral_const_mul]
  rw [hfinal, hstep, hdiv, abs_of_pos (by positivity : (0 : ℝ) < ((2 : ℝ) ^ j)⁻¹)]
  field_simp

/-- A BRS profile of order `N`: an `L¹`-normalized compactly supported
continuous bump whose moments of orders `1, …, N-1` vanish. -/
structure IsBRSProfile (N : ℕ) (φ : ℝ → ℝ) : Prop where
  cont : Continuous φ
  supp : HasCompactSupport φ
  mass : (∫ x, φ x) = 1
  moments : ∀ i : ℕ, 1 ≤ i → i < N → (∫ x, x ^ i * φ x) = 0

/-- **The Littlewood--Paley pieces of a BRS profile have vanishing moments of
every order below `N`.** -/
theorem integral_pow_mul_brsLPKernel_eq_zero {N : ℕ} {φ : ℝ → ℝ}
    (hprof : IsBRSProfile N φ) {i : ℕ} (hi : i < N) (j : ℕ) :
    (∫ x, x ^ i * brsLPKernel φ j x) = 0 := by
  have hint : ∀ l : ℕ, Integrable fun x : ℝ => x ^ i * brsDilate φ l x := by
    intro l
    have hcont : Continuous fun x : ℝ => x ^ i * brsDilate φ l x :=
      (continuous_pow i).mul (continuous_brsDilate hprof.cont l)
    exact hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.mul_left (hasCompactSupport_brsDilate hprof.supp l))
  have hsplit : (∫ x, x ^ i * brsLPKernel φ j x) =
      (∫ x, x ^ i * brsDilate φ (j + 1) x) - ∫ x, x ^ i * brsDilate φ j x := by
    have hpt : ∀ x : ℝ, x ^ i * brsLPKernel φ j x =
        x ^ i * brsDilate φ (j + 1) x - x ^ i * brsDilate φ j x := by
      intro x
      show x ^ i * (brsDilate φ (j + 1) x - brsDilate φ j x) =
        x ^ i * brsDilate φ (j + 1) x - x ^ i * brsDilate φ j x
      ring
    rw [show (∫ x, x ^ i * brsLPKernel φ j x) =
        ∫ x, (x ^ i * brsDilate φ (j + 1) x - x ^ i * brsDilate φ j x) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    exact integral_sub (hint (j + 1)) (hint j)
  rw [hsplit, integral_pow_mul_brsDilate hprof.cont hprof.supp,
    integral_pow_mul_brsDilate hprof.cont hprof.supp]
  rcases Nat.eq_zero_or_pos i with hi0 | hipos
  · subst hi0
    simp
  · rw [hprof.moments i hipos hi]
    ring

/-- A combination of dilates of a normalized bump is a BRS profile as soon as
its coefficients satisfy the Vandermonde conditions at the nodes `2^{-l}`. -/
theorem isBRSProfile_of_coeffs {N : ℕ} {χ : ℝ → ℝ} (hχ : Continuous χ)
    (hsupp : HasCompactSupport χ) (hmass : (∫ x, χ x) = 1) (a : ℕ → ℝ)
    (h0 : ∑ l ∈ Finset.range N, a l = 1)
    (hvan : ∀ i : ℕ, 1 ≤ i → i < N →
      ∑ l ∈ Finset.range N, a l * ((2 : ℝ) ^ l) ^ (-(i : ℤ)) = 0) :
    IsBRSProfile N (fun x => ∑ l ∈ Finset.range N, a l * brsDilate χ l x) := by
  have hcontDil : ∀ l : ℕ, Continuous fun x : ℝ => a l * brsDilate χ l x :=
    fun l => continuous_const.mul (continuous_brsDilate hχ l)
  have hsuppDil : ∀ l : ℕ, HasCompactSupport fun x : ℝ => a l * brsDilate χ l x :=
    fun l => HasCompactSupport.mul_left (hasCompactSupport_brsDilate hsupp l)
  have hintDil : ∀ (i l : ℕ),
      Integrable fun x : ℝ => x ^ i * (a l * brsDilate χ l x) := by
    intro i l
    have hcont : Continuous fun x : ℝ => x ^ i * (a l * brsDilate χ l x) :=
      (continuous_pow i).mul (hcontDil l)
    exact hcont.integrable_of_hasCompactSupport
      (HasCompactSupport.mul_left (hsuppDil l))
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact continuous_finsetSum _ fun l _ => hcontDil l
  · exact hasCompactSupport_finsetSum fun l _ => hsuppDil l
  · -- total mass
    have hint : ∀ l : ℕ, Integrable fun x : ℝ => a l * brsDilate χ l x := by
      intro l
      exact (hcontDil l).integrable_of_hasCompactSupport (hsuppDil l)
    rw [integral_finsetSum _ fun l _ => hint l]
    have : ∀ l ∈ Finset.range N, (∫ x, a l * brsDilate χ l x) = a l := by
      intro l _
      rw [integral_const_mul, integral_brsDilate, hmass, mul_one]
    rw [Finset.sum_congr rfl this, h0]
  · -- vanishing moments
    intro i hi1 hiN
    have hpt : ∀ x : ℝ,
        x ^ i * ∑ l ∈ Finset.range N, a l * brsDilate χ l x =
          ∑ l ∈ Finset.range N, x ^ i * (a l * brsDilate χ l x) := by
      intro x
      rw [Finset.mul_sum]
    rw [show (∫ x, x ^ i * ∑ l ∈ Finset.range N, a l * brsDilate χ l x) =
        ∫ x, ∑ l ∈ Finset.range N, x ^ i * (a l * brsDilate χ l x) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    rw [integral_finsetSum _ fun l _ => hintDil i l]
    have hterm : ∀ l ∈ Finset.range N,
        (∫ x, x ^ i * (a l * brsDilate χ l x)) =
          (a l * ((2 : ℝ) ^ l) ^ (-(i : ℤ))) * ∫ y, y ^ i * χ y := by
      intro l _
      have hrw : ∀ x : ℝ, x ^ i * (a l * brsDilate χ l x) =
          a l * (x ^ i * brsDilate χ l x) := by
        intro x
        ring
      rw [show (∫ x, x ^ i * (a l * brsDilate χ l x)) =
          ∫ x, a l * (x ^ i * brsDilate χ l x) from
        integral_congr_ae (Filter.Eventually.of_forall hrw)]
      rw [integral_const_mul, integral_pow_mul_brsDilate hχ hsupp]
      ring
    rw [Finset.sum_congr rfl hterm, ← Finset.sum_mul, hvan i hi1 hiN, zero_mul]

/-! ## Existence of BRS profiles of every order -/

/-- The dyadic nodes `2^{-l}`. -/
def brsNode (l : ℕ) : ℝ := ((2 : ℝ) ^ l)⁻¹

theorem brsNode_pos (l : ℕ) : 0 < brsNode l := by
  rw [brsNode]
  positivity

theorem brsNode_injOn (N : ℕ) :
    Set.InjOn brsNode (Finset.range N : Finset ℕ) := by
  intro l hl k hk hlk
  rw [brsNode, brsNode] at hlk
  have h2 : ((2 : ℝ) ^ l) = ((2 : ℝ) ^ k) := by
    have hl0 : ((2 : ℝ) ^ l) ≠ 0 := by positivity
    have hk0 : ((2 : ℝ) ^ k) ≠ 0 := by positivity
    field_simp at hlk
    linarith [hlk]
  exact Nat.pow_right_injective (le_refl 2)
    (by exact_mod_cast h2 : (2 : ℕ) ^ l = (2 : ℕ) ^ k)

theorem brsNode_pow (l i : ℕ) :
    brsNode l ^ i = ((2 : ℝ) ^ l) ^ (-(i : ℤ)) := by
  rw [brsNode, zpow_neg, zpow_natCast, inv_pow]

/-- **The Vandermonde coefficients exist**: the Lagrange weights at the origin
for the dyadic nodes reproduce the value at zero of every polynomial of degree
below `N`. -/
theorem exists_brs_coeffs (N : ℕ) (hN : 0 < N) :
    ∃ a : ℕ → ℝ, (∑ l ∈ Finset.range N, a l = 1) ∧
      ∀ i : ℕ, 1 ≤ i → i < N →
        ∑ l ∈ Finset.range N, a l * ((2 : ℝ) ^ l) ^ (-(i : ℤ)) = 0 := by
  classical
  set a : ℕ → ℝ := fun l =>
    (Lagrange.basis (Finset.range N) brsNode l).eval 0 with ha
  have hkey : ∀ i : ℕ, i < N →
      ∑ l ∈ Finset.range N, brsNode l ^ i * a l = (0 : ℝ) ^ i := by
    intro i hi
    have hdeg : (Polynomial.X ^ i : Polynomial ℝ).degree < (Finset.range N).card := by
      rw [Finset.card_range]
      refine lt_of_le_of_lt (Polynomial.degree_X_pow_le i) ?_
      exact_mod_cast Nat.cast_lt.mpr hi
    have heq := Lagrange.eq_interpolate (v := brsNode)
      (s := Finset.range N) (f := (Polynomial.X ^ i : Polynomial ℝ)) (brsNode_injOn N) hdeg
    rw [Lagrange.interpolate_apply] at heq
    have h1 := congrArg (fun p : Polynomial ℝ => p.eval 0) heq
    simp only [Polynomial.eval_pow, Polynomial.eval_X, Polynomial.eval_finset_sum, Polynomial.eval_mul, Polynomial.eval_C] at h1
    rw [ha]
    exact h1.symm
  refine ⟨a, ?_, ?_⟩
  · have h := hkey 0 hN
    simpa using h
  · intro i hi1 hiN
    have h := hkey i hiN
    rw [zero_pow (by omega : i ≠ 0)] at h
    rw [← h]
    refine Finset.sum_congr rfl fun l _ => ?_
    rw [brsNode_pow]
    ring

/-- **BRS profiles of every order exist.** -/
theorem exists_isBRSProfile (N : ℕ) (hN : 0 < N) :
    ∃ φ : ℝ → ℝ, IsBRSProfile N φ := by
  obtain ⟨a, h0, hvan⟩ := exists_brs_coeffs N hN
  let f : ContDiffBump (0 : ℝ) := ⟨1, 2, one_pos, by norm_num⟩
  set χ : ℝ → ℝ := f.normed volume with hχ
  have hχcont : Continuous χ := f.continuous_normed
  have hχsupp : HasCompactSupport χ := f.hasCompactSupport_normed
  have hχmass : (∫ x, χ x) = 1 := f.integral_normed
  exact ⟨_, isBRSProfile_of_coeffs hχcont hχsupp hχmass a h0 hvan⟩

/-! ## The smoothed profile: Hölder's inequality for a convolution

This is the sup bound behind the low-frequency estimate (5.8) of BRS: the
smoothing of `f₀` at a dyadic scale is bounded by the `L^{q}` norm of the
kernel times the `L^p` norm of `f₀`. -/

/-- **Hölder for the smoothed function.** -/
theorem enorm_smoothed_le {p q : ℝ} (hpq : p.HolderConjugate q) {ψ : ℝ → ℝ}
    (hψ : Measurable ψ) {f₀ : ℝ → ℂ} (hf : Measurable f₀) (s : ℝ) :
    ‖∫ y, (ψ y : ℂ) * f₀ (s - y)‖ₑ ≤
      (∫⁻ y, ‖ψ y‖ₑ ^ q) ^ (1 / q) * (∫⁻ z, ‖f₀ z‖ₑ ^ p) ^ (1 / p) := by
  have hstep1 : ‖∫ y, (ψ y : ℂ) * f₀ (s - y)‖ₑ ≤
      ∫⁻ y, ‖(ψ y : ℂ) * f₀ (s - y)‖ₑ :=
    enorm_integral_le_lintegral_enorm _
  have hprod : ∀ y : ℝ, ‖(ψ y : ℂ) * f₀ (s - y)‖ₑ =
      ‖ψ y‖ₑ * ‖f₀ (s - y)‖ₑ := by
    intro y
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real, ofReal_norm]
  have hmeasψ : AEMeasurable (fun y : ℝ => ‖ψ y‖ₑ) volume := hψ.enorm.aemeasurable
  have hmeasf : AEMeasurable (fun y : ℝ => ‖f₀ (s - y)‖ₑ) volume :=
    ((hf.comp (measurable_const.sub measurable_id)).enorm).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure ℝ)
    hpq.symm hmeasψ hmeasf
  have htrans : (∫⁻ y, ‖f₀ (s - y)‖ₑ ^ p) = ∫⁻ z, ‖f₀ z‖ₑ ^ p :=
    lintegral_sub_left_eq_self (fun z => ‖f₀ z‖ₑ ^ p) s
  calc ‖∫ y, (ψ y : ℂ) * f₀ (s - y)‖ₑ
      ≤ ∫⁻ y, ‖(ψ y : ℂ) * f₀ (s - y)‖ₑ := hstep1
    _ = ∫⁻ y, ‖ψ y‖ₑ * ‖f₀ (s - y)‖ₑ := lintegral_congr hprod
    _ ≤ (∫⁻ y, ‖ψ y‖ₑ ^ q) ^ (1 / q) *
          (∫⁻ y, ‖f₀ (s - y)‖ₑ ^ p) ^ (1 / p) := hholder
    _ = (∫⁻ y, ‖ψ y‖ₑ ^ q) ^ (1 / q) * (∫⁻ z, ‖f₀ z‖ₑ ^ p) ^ (1 / p) := by
        rw [htrans]

/-- The `L^q` norm of a dilate scales by `2^{k(1 - 1/q)}`. -/
theorem lintegral_enorm_brsDilate_rpow {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) {q : ℝ} (hq : 0 < q) (k : ℕ) :
    (∫⁻ y, ‖brsDilate φ k y‖ₑ ^ q) =
      ENNReal.ofReal (((2 : ℝ) ^ k) ^ (q - 1)) * ∫⁻ y, ‖φ y‖ₑ ^ q := by
  have hkpos : (0 : ℝ) < 2 ^ k := by positivity
  have hkne : ((2 : ℝ) ^ k) ≠ 0 := ne_of_gt hkpos
  -- rewrite both sides as `ofReal` of real integrals
  have hreal : ∀ ψ : ℝ → ℝ, Continuous ψ → HasCompactSupport ψ →
      (∫⁻ y, ‖ψ y‖ₑ ^ q) = ENNReal.ofReal (∫ y, |ψ y| ^ q) := by
    intro ψ hψ hψs
    have hcont : Continuous fun y : ℝ => |ψ y| ^ q :=
      (continuous_rpow_const_of_nonneg hq.le).comp hψ.abs
    have hint : Integrable fun y : ℝ => |ψ y| ^ q := by
      refine hcont.integrable_of_hasCompactSupport ?_
      have hzero : ∀ y : ℝ, ψ y = 0 → |ψ y| ^ q = 0 := by
        intro y hy
        rw [hy, abs_zero, Real.zero_rpow (ne_of_gt hq)]
      refine HasCompactSupport.intro hψs.isCompact ?_
      intro y hy
      exact hzero y (image_eq_zero_of_notMem_tsupport hy)
    rw [ofReal_integral_eq_lintegral_ofReal hint
      (Filter.Eventually.of_forall fun y => Real.rpow_nonneg (abs_nonneg _) _)]
    refine lintegral_congr fun y => ?_
    rw [← ofReal_norm, Real.norm_eq_abs,
      ENNReal.ofReal_rpow_of_nonneg (abs_nonneg _) hq.le]
  have hcontDil : Continuous (brsDilate φ k) := continuous_brsDilate hφ k
  have hsuppDil : HasCompactSupport (brsDilate φ k) :=
    hasCompactSupport_brsDilate hsupp k
  rw [hreal _ hcontDil hsuppDil, hreal _ hφ hsupp]
  -- the real scaling computation
  have hscale : (∫ y, |brsDilate φ k y| ^ q) =
      ((2 : ℝ) ^ k) ^ (q - 1) * ∫ y, |φ y| ^ q := by
    have hpt : ∀ y : ℝ, |brsDilate φ k y| ^ q =
        ((2 : ℝ) ^ k) ^ q * |φ (2 ^ k * y)| ^ q := by
      intro y
      show |2 ^ k * φ (2 ^ k * y)| ^ q = ((2 : ℝ) ^ k) ^ q * |φ (2 ^ k * y)| ^ q
      rw [abs_mul, abs_of_pos hkpos,
        Real.mul_rpow (le_of_lt hkpos) (abs_nonneg _)]
    rw [show (∫ y, |brsDilate φ k y| ^ q) =
        ∫ y, ((2 : ℝ) ^ k) ^ q * |φ (2 ^ k * y)| ^ q from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    rw [integral_const_mul,
      MeasureTheory.Measure.integral_comp_mul_left (fun y => |φ y| ^ q)
        ((2 : ℝ) ^ k), smul_eq_mul,
      abs_of_pos (by positivity : (0 : ℝ) < ((2 : ℝ) ^ k)⁻¹)]
    rw [← mul_assoc]
    congr 1
    rw [Real.rpow_sub hkpos, Real.rpow_one]
    field_simp
  rw [hscale, ENNReal.ofReal_mul (by positivity)]

/-! ## Cancellation: vanishing moments against a Taylor remainder

This is the mechanism behind the kernel estimate (5.11) of BRS.  A kernel with
vanishing moments of order `< N`, supported at scale `δ`, sees only the `N`-th
order Taylor remainder of the function it is tested against. -/

/-- A function vanishing off `[-δ, δ]` has compact support. -/
theorem hasCompactSupport_of_vanishing {ψ : ℝ → ℝ} {δ : ℝ}
    (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0) : HasCompactSupport ψ := by
  refine HasCompactSupport.intro (isCompact_Icc (a := -δ) (b := δ)) ?_
  intro y hy
  refine hzero y ?_
  by_contra hcon
  push_neg at hcon
  exact hy (Set.mem_Icc.mpr ⟨by linarith [neg_abs_le y],
    by linarith [le_abs_self y]⟩)

/-- The product of a kernel with a compactly supported factor is continuous as
soon as the kernel is continuous on the relevant window. -/
theorem continuous_kernel_mul_of_vanishing {ψ : ℝ → ℝ} (hψ : Continuous ψ)
    {δ x : ℝ} (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0) {h : ℝ → ℂ}
    (hcontAt : ∀ u : ℝ, |u - x| ≤ δ → ContinuousAt h u) :
    Continuous fun y : ℝ => h (x - y) * (ψ y : ℂ) := by
  rw [continuous_iff_continuousAt]
  intro y₀
  rcases le_or_gt |y₀| δ with hy | hy
  · have hu : |(x - y₀) - x| ≤ δ := by
      rw [show x - y₀ - x = -y₀ by ring, abs_neg]
      exact hy
    have h1 : ContinuousAt (fun y : ℝ => h (x - y)) y₀ :=
      (hcontAt _ hu).comp (by fun_prop)
    exact h1.mul (Complex.continuous_ofReal.comp hψ).continuousAt
  · have hopen : IsOpen {y : ℝ | δ < |y|} :=
      isOpen_lt continuous_const continuous_abs
    have hev : (fun y : ℝ => h (x - y) * (ψ y : ℂ)) =ᶠ[nhds y₀] fun _ => 0 := by
      refine Filter.eventuallyEq_of_mem (hopen.mem_nhds hy) fun y hy' => ?_
      rw [hzero y hy']
      simp
    exact ContinuousAt.congr continuousAt_const hev.symm

/-- **The cancellation estimate.**  If `ψ` has vanishing moments below `N` and
lives at scale `δ`, then testing it against `h` only sees the Taylor remainder
of `h`. -/
theorem brs_cancellation_of_taylor {ψ : ℝ → ℝ} (hψ : Continuous ψ) {δ : ℝ}
    (hδ : 0 ≤ δ) (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N → (∫ y : ℝ, y ^ i * ψ y) = 0) {h : ℝ → ℂ}
    {x M : ℝ} (hcontAt : ∀ u : ℝ, |u - x| ≤ δ → ContinuousAt h u)
    (hM : 0 ≤ M) (c : ℕ → ℂ)
    (htaylor : ∀ y : ℝ, |y| ≤ δ →
      ‖h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i‖ ≤ M * |y| ^ N) :
    ‖∫ y : ℝ, h (x - y) * (ψ y : ℂ)‖ ≤ M * δ ^ N * ∫ y : ℝ, |ψ y| := by
  have hcs : HasCompactSupport ψ := hasCompactSupport_of_vanishing hzero
  have hcsC : HasCompactSupport fun y : ℝ => (ψ y : ℂ) :=
    hcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  have hcontC : Continuous fun y : ℝ => (ψ y : ℂ) :=
    Complex.continuous_ofReal.comp hψ
  have hprod : Continuous fun y : ℝ => h (x - y) * (ψ y : ℂ) :=
    continuous_kernel_mul_of_vanishing hψ hzero hcontAt
  -- integrability
  have hint : ∀ F : ℝ → ℂ, Continuous F →
      Integrable fun y => F y * (ψ y : ℂ) := by
    intro F hF
    exact (hF.mul hcontC).integrable_of_hasCompactSupport hcsC.mul_left
  have hintPoly : Integrable fun y : ℝ =>
      (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) := by
    refine hint _ ?_
    refine continuous_finsetSum _ fun i _ => ?_
    exact continuous_const.mul ((Complex.continuous_ofReal.comp continuous_id).pow i)
  -- the polynomial part integrates to zero
  have hpolyzero : (∫ y : ℝ, (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) *
      (ψ y : ℂ)) = 0 := by
    have hpt : ∀ y : ℝ, (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) =
        ∑ i ∈ Finset.range N, c i * ((y ^ i * ψ y : ℝ) : ℂ) := by
      intro y
      rw [Finset.sum_mul]
      refine Finset.sum_congr rfl fun i _ => ?_
      push_cast
      ring
    rw [show (∫ y : ℝ, (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ)) =
        ∫ y : ℝ, ∑ i ∈ Finset.range N, c i * ((y ^ i * ψ y : ℝ) : ℂ) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    have hintTerm : ∀ i : ℕ, Integrable fun y : ℝ =>
        c i * ((y ^ i * ψ y : ℝ) : ℂ) := by
      intro i
      have hcont : Continuous fun y : ℝ => c i * ((y ^ i * ψ y : ℝ) : ℂ) :=
        continuous_const.mul (Complex.continuous_ofReal.comp
          ((continuous_pow i).mul hψ))
      refine hcont.integrable_of_hasCompactSupport ?_
      have hreal : HasCompactSupport fun y : ℝ => y ^ i * ψ y :=
        HasCompactSupport.mul_left hcs
      have hcast : HasCompactSupport fun y : ℝ => ((y ^ i * ψ y : ℝ) : ℂ) :=
        hreal.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
      exact HasCompactSupport.mul_left hcast
    rw [integral_finsetSum _ fun i _ => hintTerm i]
    refine Finset.sum_eq_zero fun i hi => ?_
    rw [integral_const_mul, integral_complex_ofReal, hmom i (Finset.mem_range.mp hi)]
    simp
  -- reduce to the remainder
  have hsplit : (∫ y : ℝ, h (x - y) * (ψ y : ℂ)) =
      ∫ y : ℝ, (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) := by
    have hpt : ∀ y : ℝ,
        (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) =
        h (x - y) * (ψ y : ℂ) -
          (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) := by
      intro y
      ring
    rw [show (∫ y : ℝ, (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) *
        (ψ y : ℂ)) = ∫ y : ℝ, (h (x - y) * (ψ y : ℂ) -
          (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ)) from
      integral_congr_ae (Filter.Eventually.of_forall hpt)]
    rw [integral_sub (hprod.integrable_of_hasCompactSupport hcsC.mul_left)
      hintPoly, hpolyzero, sub_zero]
  rw [hsplit]
  -- the pointwise remainder bound
  have hptbound : ∀ y : ℝ,
      ‖(h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ)‖ ≤
        M * δ ^ N * |ψ y| := by
    intro y
    rcases le_or_gt |y| δ with hy | hy
    · rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
      refine mul_le_mul ?_ le_rfl (abs_nonneg _) (by positivity)
      refine le_trans (htaylor y hy) ?_
      refine mul_le_mul_of_nonneg_left ?_ hM
      exact pow_le_pow_left₀ (abs_nonneg _) hy N
    · rw [hzero y hy]
      simp
  have hintNorm : Integrable fun y : ℝ =>
      M * δ ^ N * |ψ y| := ((hψ.abs).integrable_of_hasCompactSupport
        hcs.abs).const_mul _
  calc ‖∫ y : ℝ, (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ)‖
      ≤ ∫ y : ℝ, ‖(h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) *
          (ψ y : ℂ)‖ := norm_integral_le_integral_norm _
    _ ≤ ∫ y : ℝ, M * δ ^ N * |ψ y| := by
        refine integral_mono ?_ hintNorm hptbound
        have hdiff : Continuous fun y : ℝ =>
            (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) := by
          have hpt : (fun y : ℝ =>
              (h (x - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ)) =
              fun y : ℝ => h (x - y) * (ψ y : ℂ) -
                (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) * (ψ y : ℂ) := by
            funext y
            ring
          rw [hpt]
          refine hprod.sub ?_
          exact ((continuous_finsetSum _ fun i _ => continuous_const.mul
            ((Complex.continuous_ofReal.comp continuous_id).pow i)).mul
            (Complex.continuous_ofReal.comp hψ))
        exact (hdiff.integrable_of_hasCompactSupport hcsC.mul_left).norm
    _ = M * δ ^ N * ∫ y : ℝ, |ψ y| := integral_const_mul _ _

/-! ## First-order cancellation for the singular kernel -/

/-- The first-order instance of the cancellation estimate. -/
theorem brs_cancellation_lipschitz {ψ : ℝ → ℝ} (hψ : Continuous ψ) {δ : ℝ}
    (hδ : 0 ≤ δ) (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hmom : (∫ y : ℝ, ψ y) = 0) {h : ℝ → ℂ} (hh : Continuous h) {x M : ℝ}
    (hM : 0 ≤ M) (hlip : ∀ y : ℝ, |y| ≤ δ → ‖h (x - y) - h x‖ ≤ M * |y|) :
    ‖∫ y : ℝ, h (x - y) * (ψ y : ℂ)‖ ≤ M * δ * ∫ y : ℝ, |ψ y| := by
  have hmom' : ∀ i : ℕ, i < 1 → (∫ y : ℝ, y ^ i * ψ y) = 0 := by
    intro i hi
    interval_cases i
    simpa using hmom
  have htaylor : ∀ y : ℝ, |y| ≤ δ →
      ‖h (x - y) - ∑ i ∈ Finset.range 1, (fun _ : ℕ => h x) i * (y : ℂ) ^ i‖ ≤
        M * |y| ^ 1 := by
    intro y hy
    simpa using hlip y hy
  have := brs_cancellation_of_taylor hψ hδ hzero hmom'
    (fun u _ => hh.continuousAt) hM (fun _ : ℕ => h x) htaylor
  simpa using this

/-- The derivative of the inverse square root. -/
theorem hasDerivAt_rpow_neg_half {u : ℝ} (hu : 0 < u) :
    HasDerivAt (fun t : ℝ => t ^ (-(1 / 2) : ℝ))
      (-(1 / 2) * u ^ (-(1 / 2) - 1 : ℝ)) u :=
  Real.hasDerivAt_rpow_const (p := (-(1 / 2) : ℝ)) (Or.inl (ne_of_gt hu))

/-- **A Lipschitz bound for the inverse square root away from the origin.** -/
theorem norm_sub_rpow_neg_half_le {a u v : ℝ} (ha : 0 < a) (hu : a ≤ u)
    (hv : a ≤ v) :
    |u ^ (-(1 / 2) : ℝ) - v ^ (-(1 / 2) : ℝ)| ≤
      (1 / 2) * a ^ (-(3 / 2) : ℝ) * |u - v| := by
  have hconv : Convex ℝ (Ici a) := convex_Ici a
  have hderiv : ∀ t ∈ Ici a, HasDerivAt (fun s : ℝ => s ^ (-(1 / 2) : ℝ))
      (-(1 / 2) * t ^ (-(1 / 2) - 1 : ℝ)) t := by
    intro t ht
    exact hasDerivAt_rpow_neg_half (lt_of_lt_of_le ha ht)
  have hbound : ∀ t ∈ Ici a, ‖-(1 / 2) * t ^ (-(1 / 2) - 1 : ℝ)‖ ≤
      (1 / 2) * a ^ (-(3 / 2) : ℝ) := by
    intro t ht
    have hta : a ≤ t := ht
    have htpos : 0 < t := lt_of_lt_of_le ha hta
    have hexp : (-(1 / 2) - 1 : ℝ) = -(3 / 2) := by norm_num
    rw [hexp, norm_mul, norm_neg]
    have h1 : ‖(1 / 2 : ℝ)‖ = 1 / 2 := by
      rw [Real.norm_eq_abs, abs_of_pos (by norm_num)]
    have h2 : ‖t ^ (-(3 / 2) : ℝ)‖ = t ^ (-(3 / 2) : ℝ) := by
      rw [Real.norm_eq_abs, abs_of_pos (Real.rpow_pos_of_pos htpos _)]
    rw [h1, h2]
    refine mul_le_mul_of_nonneg_left ?_ (by norm_num)
    exact Real.rpow_le_rpow_of_nonpos ha hta (by norm_num)
  have hmvt := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le
    (f := fun s : ℝ => s ^ (-(1 / 2) : ℝ))
    (f' := fun t => -(1 / 2) * t ^ (-(1 / 2) - 1 : ℝ))
    (fun t ht => (hderiv t ht).hasDerivWithinAt) hbound hu hv
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at hmvt
  rw [abs_sub_comm u v, abs_sub_comm (u ^ (-(1 / 2) : ℝ)) (v ^ (-(1 / 2) : ℝ))]
  exact hmvt

/-! ## Iterated derivatives of a power -/

/-- On the positive half-line the iterated derivatives of `t ^ p` are the
expected ones. -/
theorem iteratedDeriv_rpow_eqOn (p : ℝ) (n : ℕ) :
    Set.EqOn (iteratedDeriv n fun t : ℝ => t ^ p)
      (fun t : ℝ => (∏ i ∈ Finset.range n, (p - i)) * t ^ (p - n))
      (Ioi (0 : ℝ)) := by
  induction n with
  | zero =>
      intro x hx
      simp
  | succ n ih =>
      intro x hx
      have hxpos : (0 : ℝ) < x := hx
      have hev : (iteratedDeriv n fun t : ℝ => t ^ p) =ᶠ[𝓝 x]
          fun t : ℝ => (∏ i ∈ Finset.range n, (p - i)) * t ^ (p - n) :=
        Filter.eventuallyEq_of_mem (isOpen_Ioi.mem_nhds hx) ih
      have hd : HasDerivAt
          (fun t : ℝ => (∏ i ∈ Finset.range n, (p - i)) * t ^ (p - n))
          ((∏ i ∈ Finset.range n, (p - i)) *
            ((p - n) * x ^ (p - n - 1))) x :=
        (Real.hasDerivAt_rpow_const (p := (p - n : ℝ))
          (Or.inl (ne_of_gt hxpos))).const_mul _
      rw [iteratedDeriv_succ, hev.deriv_eq, hd.deriv]
      show (∏ i ∈ Finset.range n, (p - i)) * ((p - n) * x ^ (p - n - 1)) =
        (∏ i ∈ Finset.range (n + 1), (p - i)) * x ^ (p - (n + 1 : ℕ))
      rw [Finset.prod_range_succ]
      have hexp : p - ((n : ℝ) + 1) = p - n - 1 := by ring
      push_cast
      rw [hexp]
      ring

/-- The size of the iterated derivatives of the inverse square root. -/
theorem abs_iteratedDeriv_rpow_neg_half_le {u : ℝ} (hu : 0 < u) (N : ℕ) :
    |iteratedDeriv N (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) u| ≤
      (∏ i ∈ Finset.range N, ((1 : ℝ) / 2 + (i : ℝ))) *
        u ^ (-(1 / 2) - N : ℝ) := by
  have heq := iteratedDeriv_rpow_eqOn (-(1 / 2) : ℝ) N hu
  rw [heq]
  have habs : |(∏ i ∈ Finset.range N, (-(1 / 2) - (i : ℝ)))| =
      ∏ i ∈ Finset.range N, (1 / 2 + (i : ℝ)) := by
    rw [Finset.abs_prod]
    refine Finset.prod_congr rfl fun i _ => ?_
    have hi : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    rw [abs_of_nonpos (by linarith : (-(1 / 2) - (i : ℝ)) ≤ 0)]
    ring
  have hpow : |u ^ (-(1 / 2) - (N : ℝ))| = u ^ (-(1 / 2) - (N : ℝ)) :=
    abs_of_pos (Real.rpow_pos_of_pos hu _)
  rw [abs_mul, habs, hpow]

/-! ## The Taylor remainder of the inverse square root -/

/-- The inverse square root is smooth away from the origin. -/
theorem contDiffOn_rpow_neg_half {a b : ℝ} (ha : 0 < a) (n : ℕ) :
    ContDiffOn ℝ n (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) (Icc a b) := by
  intro x hx
  have hxne : x ≠ 0 := by
    have : a ≤ x := hx.1
    exact ne_of_gt (lt_of_lt_of_le ha this)
  exact (Real.contDiffAt_rpow_const_of_ne (n := n) (p := (-(1 / 2) : ℝ))
    hxne).contDiffWithinAt

/-- The iterated derivatives within an interval agree with the global ones. -/
theorem iteratedDerivWithin_rpow_neg_half {a b : ℝ} (ha : 0 < a) (hab : a < b)
    (n : ℕ) {y : ℝ} (hy : y ∈ Icc a b) :
    iteratedDerivWithin n (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) (Icc a b) y =
      iteratedDeriv n (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) y := by
  have hyne : y ≠ 0 := ne_of_gt (lt_of_lt_of_le ha hy.1)
  exact iteratedDerivWithin_eq_iteratedDeriv (uniqueDiffOn_Icc hab)
    (Real.contDiffAt_rpow_const_of_ne (n := n) (p := (-(1 / 2) : ℝ)) hyne) hy

/-- **The Taylor remainder bound for the inverse square root.** -/
theorem taylor_bound_rpow_neg_half {a b : ℝ} (ha : 0 < a) (hab : a < b) (N : ℕ)
    {x : ℝ} (hx : x ∈ Icc a b) :
    |x ^ (-(1 / 2) : ℝ) -
        taylorWithinEval (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) N (Icc a b) a x| ≤
      ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
          a ^ (-(1 / 2) - ((N : ℝ) + 1))) * (x - a) ^ (N + 1) / (Nat.factorial N : ℝ) := by
  set C : ℝ := (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
    a ^ (-(1 / 2) - ((N : ℝ) + 1)) with hC
  have hbound : ∀ y ∈ Icc a b,
      ‖iteratedDerivWithin (N + 1) (fun t : ℝ => t ^ (-(1 / 2) : ℝ))
        (Icc a b) y‖ ≤ C := by
    intro y hy
    have hypos : 0 < y := lt_of_lt_of_le ha hy.1
    rw [iteratedDerivWithin_rpow_neg_half ha hab (N + 1) hy, Real.norm_eq_abs]
    refine le_trans (abs_iteratedDeriv_rpow_neg_half_le hypos (N + 1)) ?_
    rw [hC]
    refine mul_le_mul_of_nonneg_left ?_ ?_
    · have hexp : (-(1 / 2) - ((N : ℝ) + 1)) ≤ 0 := by
        have : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
        linarith
      have hcast : ((N : ℝ) + 1) = (((N + 1 : ℕ) : ℝ)) := by push_cast; ring
      rw [hcast]
      exact Real.rpow_le_rpow_of_nonpos ha hy.1 (by
        have : (0 : ℝ) ≤ ((N + 1 : ℕ) : ℝ) := Nat.cast_nonneg _
        linarith)
    · refine Finset.prod_nonneg fun i _ => ?_
      have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
      linarith
  have hcd : ContDiffOn ℝ (N + 1) (fun t : ℝ => t ^ (-(1 / 2) : ℝ)) (Icc a b) :=
    contDiffOn_rpow_neg_half ha (N + 1)
  have h := taylor_mean_remainder_bound (f := fun t : ℝ => t ^ (-(1 / 2) : ℝ))
    (a := a) (b := b) (C := C) (x := x) (n := N) (le_of_lt hab) hcd hx hbound
  rw [Real.norm_eq_abs] at h
  exact h

/-! ## A two-sided Taylor bound around an interior point -/

/-- **Taylor's theorem around an interior point**, in the form needed by the
cancellation estimate: the coefficients are the global iterated derivatives at
the centre, so they do not depend on the increment. -/
theorem taylor_two_sided_bound {h : ℝ → ℝ} {x δ C : ℝ} (hδ : 0 < δ)
    (hC0 : 0 ≤ C) {N : ℕ}
    (hcd : ∀ z ∈ Icc (x - δ) (x + δ), ContDiffAt ℝ (N + 1) h z)
    (hCb : ∀ u ∈ Icc (x - δ) (x + δ), |iteratedDeriv (N + 1) h u| ≤ C)
    {y : ℝ} (hy : |y| ≤ δ) :
    |h (x - y) - ∑ i ∈ Finset.range (N + 1),
        (iteratedDeriv i h x / (Nat.factorial i : ℝ)) * (-y) ^ i| ≤
      C * |y| ^ (N + 1) / (Nat.factorial (N + 1) : ℝ) := by
  rcases eq_or_ne y 0 with hy0 | hy0
  · subst hy0
    have hsum : ∑ i ∈ Finset.range (N + 1),
        (iteratedDeriv i h x / (Nat.factorial i : ℝ)) * (-(0 : ℝ)) ^ i = h x := by
      rw [Finset.sum_eq_single 0]
      · simp
      · intro i _ hi
        rw [neg_zero, zero_pow hi, mul_zero]
      · intro hcon
        exact absurd (Finset.mem_range.mpr (Nat.succ_pos N)) hcon
    rw [sub_zero, hsum, sub_self, abs_zero]
    positivity
  · set z : ℝ := x - y with hz
    have hzx : x ≠ z := by
      rw [hz]
      intro hcon
      apply hy0
      linarith [hcon]
    have habs : |z - x| ≤ δ := by
      rw [hz, show x - y - x = -y by ring, abs_neg]
      exact hy
    have hzmem : z ∈ Icc (x - δ) (x + δ) := by
      have := abs_le.mp habs
      exact ⟨by linarith [this.1], by linarith [this.2]⟩
    have hxmem0 : x ∈ Icc (x - δ) (x + δ) := ⟨by linarith, by linarith⟩
    have hsub : uIcc x z ⊆ Icc (x - δ) (x + δ) :=
      uIcc_subset_Icc hxmem0 hzmem
    have hcdOn : ContDiffOn ℝ (N + 1) h (uIcc x z) := by
      intro w hw
      exact (hcd w (hsub hw)).contDiffWithinAt
    obtain ⟨x', hx', hxeq⟩ :=
      taylor_mean_remainder_lagrange_iteratedDeriv hzx hcdOn
    -- identify the Taylor polynomial
    have huniq : UniqueDiffOn ℝ (uIcc x z) := by
      refine uniqueDiffOn_Icc ?_
      rcases lt_or_gt_of_ne hzx with hlt | hlt
      · rw [min_eq_left (le_of_lt hlt), max_eq_right (le_of_lt hlt)]
        exact hlt
      · rw [min_eq_right (le_of_lt hlt), max_eq_left (le_of_lt hlt)]
        exact hlt
    have hxmem : x ∈ uIcc x z := left_mem_uIcc
    have hpoly : taylorWithinEval h N (uIcc x z) x z =
        ∑ i ∈ Finset.range (N + 1),
          (iteratedDeriv i h x / (Nat.factorial i : ℝ)) * (-y) ^ i := by
      rw [taylor_within_apply]
      refine Finset.sum_congr rfl fun i hi => ?_
      have hiw : iteratedDerivWithin i h (uIcc x z) x = iteratedDeriv i h x := by
        refine iteratedDerivWithin_eq_iteratedDeriv huniq ?_ hxmem
        have hxmem' : x ∈ Icc (x - δ) (x + δ) := hxmem0
        have hiN : i ≤ N + 1 :=
          Nat.le_succ_of_le (Nat.lt_succ_iff.mp (Finset.mem_range.mp hi))
        exact (hcd x hxmem').of_le (by exact_mod_cast hiN)
      rw [hiw, smul_eq_mul, hz]
      have : x - y - x = -y := by ring
      rw [this]
      ring
    rw [hpoly] at hxeq
    have hx'mem : x' ∈ Icc (x - δ) (x + δ) :=
      hsub (Set.mem_of_mem_of_subset hx' uIoo_subset_uIcc_self)
    have hzxy : z - x = -y := by
      rw [hz]
      ring
    have hfac : |((Nat.factorial (N + 1) : ℝ))| = (Nat.factorial (N + 1) : ℝ) :=
      abs_of_pos (by positivity)
    rw [hxeq, hzxy, abs_div, abs_mul, abs_pow, abs_neg, hfac]
    have hb := hCb x' hx'mem
    gcongr

/-! ## (5.11): the kernel estimate for the inverse square root -/

/-- **The cancellation estimate for the singular kernel.**  A bump at scale `δ`
with vanishing moments below `N + 1`, tested against `u ↦ u^{-1/2}` at distance
at least `x - δ` from the singularity, gains a factor `δ^{N+1}`. -/
theorem brs_kernel_cancellation {ψ : ℝ → ℝ} (hψ : Continuous ψ) {δ x : ℝ}
    (hδ : 0 < δ) (hxδ : δ < x) (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0) :
    ‖∫ y : ℝ, (((x - y) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * (ψ y : ℂ)‖ ≤
      ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
          (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
            (Nat.factorial (N + 1) : ℝ)) * δ ^ (N + 1) * ∫ y : ℝ, |ψ y| := by
  set h₀ : ℝ → ℝ := fun t : ℝ => t ^ (-(1 / 2) : ℝ) with hh₀
  set C : ℝ := (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
    (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) with hC
  have hxδpos : 0 < x - δ := by linarith
  have hCnn : 0 ≤ C := by
    rw [hC]
    have h1 : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
      refine Finset.prod_nonneg fun i _ => ?_
      have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
      linarith
    have h2 : (0 : ℝ) ≤ (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) :=
      Real.rpow_nonneg hxδpos.le _
    positivity
  -- the window avoids the singularity
  have hwin : ∀ u : ℝ, u ∈ Icc (x - δ) (x + δ) → 0 < u := fun u hu =>
    lt_of_lt_of_le hxδpos hu.1
  have hcd : ∀ z ∈ Icc (x - δ) (x + δ), ContDiffAt ℝ (N + 1) h₀ z := by
    intro z hz
    exact Real.contDiffAt_rpow_const_of_ne (n := (N + 1 : ℕ))
      (p := (-(1 / 2) : ℝ)) (ne_of_gt (hwin z hz))
  have hCb : ∀ u ∈ Icc (x - δ) (x + δ), |iteratedDeriv (N + 1) h₀ u| ≤ C := by
    intro u hu
    refine le_trans (abs_iteratedDeriv_rpow_neg_half_le (hwin u hu) (N + 1)) ?_
    rw [hC]
    refine mul_le_mul_of_nonneg_left ?_ ?_
    · have hcast : (((N + 1 : ℕ) : ℝ)) = ((N : ℝ) + 1) := by push_cast; ring
      rw [hcast]
      refine Real.rpow_le_rpow_of_nonpos hxδpos hu.1 ?_
      have : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
      linarith
    · refine Finset.prod_nonneg fun i _ => ?_
      have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
      linarith
  -- the Taylor bound, transported to the complex-valued kernel
  set c : ℕ → ℂ := fun i =>
    (((-1 : ℝ) ^ i * (iteratedDeriv i h₀ x / (Nat.factorial i : ℝ)) : ℝ) : ℂ)
    with hc
  have htaylor : ∀ y : ℝ, |y| ≤ δ →
      ‖(((x - y) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) -
          ∑ i ∈ Finset.range (N + 1), c i * (y : ℂ) ^ i‖ ≤
        (C / (Nat.factorial (N + 1) : ℝ)) * |y| ^ (N + 1) := by
    intro y hy
    have hreal := taylor_two_sided_bound (h := h₀) (x := x) (δ := δ) (C := C)
      hδ hCnn hcd hCb hy
    have hcast : (∑ i ∈ Finset.range (N + 1), c i * (y : ℂ) ^ i) =
        ((∑ i ∈ Finset.range (N + 1),
          (iteratedDeriv i h₀ x / (Nat.factorial i : ℝ)) * (-y) ^ i : ℝ) : ℂ) := by
      push_cast
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hc]
      push_cast
      rw [neg_pow]
      ring
    rw [hcast, ← Complex.ofReal_sub, Complex.norm_real, Real.norm_eq_abs]
    calc |h₀ (x - y) - ∑ i ∈ Finset.range (N + 1),
            (iteratedDeriv i h₀ x / (Nat.factorial i : ℝ)) * (-y) ^ i|
        ≤ C * |y| ^ (N + 1) / (Nat.factorial (N + 1) : ℝ) := hreal
      _ = (C / (Nat.factorial (N + 1) : ℝ)) * |y| ^ (N + 1) := by ring
  -- continuity of the kernel on the window
  have hcontAt : ∀ u : ℝ, |u - x| ≤ δ →
      ContinuousAt (fun t : ℝ => ((t ^ (-(1 / 2) : ℝ) : ℝ) : ℂ)) u := by
    intro u hu
    have hupos : 0 < u := by
      have := abs_le.mp hu
      linarith [this.1]
    exact Complex.continuous_ofReal.continuousAt.comp
      (Real.continuousAt_rpow_const u (-(1 / 2) : ℝ) (Or.inl (ne_of_gt hupos)))
  have hMnn : 0 ≤ C / (Nat.factorial (N + 1) : ℝ) := by positivity
  have hmain := brs_cancellation_of_taylor hψ hδ.le hzero hmom hcontAt hMnn c
    htaylor
  calc ‖∫ y : ℝ, (((x - y) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * (ψ y : ℂ)‖
      ≤ (C / (Nat.factorial (N + 1) : ℝ)) * δ ^ (N + 1) * ∫ y : ℝ, |ψ y| := hmain
    _ = ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
          (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
            (Nat.factorial (N + 1) : ℝ)) * δ ^ (N + 1) * ∫ y : ℝ, |ψ y| := by
        rw [hC]

/-! ## (5.12): Young's inequality for an `L¹` kernel -/

/-- Tonelli for a convolution-type double integral. -/
theorem lintegral_convolution_swap {p : ℝ} {K : ℝ → ℝ} (hK : Measurable K)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) =
      (∫⁻ y : ℝ, ‖K y‖ₑ) * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hjoint : Measurable fun z : ℝ × ℝ => ‖K z.2‖ₑ * ‖g (z.1 - z.2)‖ₑ ^ p := by
    have h1 : Measurable fun z : ℝ × ℝ => ‖K z.2‖ₑ :=
      (hK.comp measurable_snd).enorm
    have h2 : Measurable fun z : ℝ × ℝ => ‖g (z.1 - z.2)‖ₑ ^ p :=
      ((hg.comp (measurable_fst.sub measurable_snd)).enorm).pow_const p
    exact h1.mul h2
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  have hinner : ∀ y : ℝ, (∫⁻ x : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) =
      ‖K y‖ₑ * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
    intro y
    rw [lintegral_const_mul' _ _ (enorm_ne_top (x := K y))]
    congr 1
    exact lintegral_sub_right_eq_self (fun z => ‖g z‖ₑ ^ p) y
  rw [lintegral_congr hinner]
  exact lintegral_mul_const _ hK.enorm

/-- **Young's inequality** for an `L¹` kernel. -/
theorem lintegral_convolution_rpow_le {p : ℝ} (hp : 1 ≤ p) {K : ℝ → ℝ}
    (hK : Measurable K) (hA : (∫⁻ y : ℝ, ‖K y‖ₑ) ≠ ⊤) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ p) ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ) ^ p * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  set A : ENNReal := ∫⁻ y : ℝ, ‖K y‖ₑ with hAdef
  set G : ENNReal := ∫⁻ z : ℝ, ‖g z‖ₑ ^ p with hGdef
  -- the pointwise estimate
  have hpt : ∀ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ p ≤
      A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
    intro x
    have hbase : ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ≤
        ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ := by
      refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
      refine lintegral_congr fun y => ?_
      rw [enorm_mul, ← ofReal_norm, Complex.norm_real, ofReal_norm]
    rcases eq_or_lt_of_le hp with hp1 | hp1
    · rw [← hp1]
      simpa using hbase
    · -- Hölder with the conjugate exponent
      set q : ℝ := Real.conjExponent p with hq
      have hconj : q.HolderConjugate p :=
        (Real.HolderConjugate.conjExponent hp1).symm
      have hq0 : (0 : ℝ) < q := hconj.pos
      have hqinv : 1 / q + 1 / p = 1 := by
        have h1 := hconj.one_div_add_one_div
        simpa using h1
      have hsplit : ∀ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ =
          (‖K y‖ₑ ^ (1 / q)) * ((‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) := by
        intro y
        rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity)
          (by positivity), hqinv, ENNReal.rpow_one]
      have hmeas1 : AEMeasurable (fun y : ℝ => ‖K y‖ₑ ^ (1 / q)) volume :=
        (hK.enorm.pow_const _).aemeasurable
      have hmeas2 : AEMeasurable
          (fun y : ℝ => (‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) volume :=
        ((hK.enorm.pow_const _).mul
          ((hg.comp (measurable_const.sub measurable_id)).enorm)).aemeasurable
      have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure ℝ)
        hconj hmeas1 hmeas2
      simp only [Pi.mul_apply] at hholder
      have hfirst : (∫⁻ y : ℝ, (‖K y‖ₑ ^ (1 / q)) ^ q) = A := by
        refine lintegral_congr fun y => ?_
        rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
      have hsecond : (∫⁻ y : ℝ, ((‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) ^ p) =
          ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
        refine lintegral_congr fun y => ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div,
          inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
      rw [hfirst, hsecond] at hholder
      have hbase' : ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ≤
          A ^ (1 / q) * (∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) ^ (1 / p) := by
        refine le_trans hbase ?_
        rw [lintegral_congr hsplit]
        exact hholder
      calc ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ p
          ≤ (A ^ (1 / q) *
              (∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) ^ (1 / p)) ^ p :=
            ENNReal.rpow_le_rpow hbase' hp0.le
        _ = A ^ (p / q) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
              ← ENNReal.rpow_mul]
            rw [show (1 : ℝ) / p * p = 1 by field_simp, ENNReal.rpow_one]
            congr 2
            rw [one_div]
            ring
        _ = A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
            congr 2
            have h1 : 1 / q = 1 - 1 / p := by linarith [hqinv]
            have h2 : p / q = p * (1 / q) := by ring
            rw [h2, h1]
            field_simp
  -- integrate and swap
  calc (∫⁻ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ p)
      ≤ ∫⁻ x : ℝ, A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p :=
        lintegral_mono hpt
    _ = A ^ (p - 1) * ∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p :=
        lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith) hA)
    _ = A ^ (p - 1) * (A * G) := by
        rw [lintegral_convolution_swap hK hg]
    _ = A ^ (p - 1) * A * G := by ring
    _ ≤ A ^ p * G := by
        refine mul_le_mul' ?_ le_rfl
        exact ennreal_rpow_sub_one_mul_le hp

/-! ## (5.13): the maximal estimate on an interval

A differentiable function on an interval is controlled by its average plus the
total variation of its derivative.  This is the elementary Sobolev bound that
converts the fixed-scale estimates into maximal ones. -/

/-- The derivative integral over a subinterval is dominated by the total. -/
theorem abs_integral_deriv_le {F' : ℝ → ℝ} {a b s t : ℝ}
    (hint : IntervalIntegrable F' volume a b) (hs : s ∈ Icc a b)
    (ht : t ∈ Icc a b) :
    |∫ y in s..t, F' y| ≤ ∫ y in a..b, |F' y| := by
  have habs : IntervalIntegrable (fun y => |F' y|) volume a b := hint.abs
  have hsub : ∀ {u v : ℝ}, u ∈ Icc a b → v ∈ Icc a b → u ≤ v →
      (∫ y in u..v, |F' y|) ≤ ∫ y in a..b, |F' y| := by
    intro u v hu hv huv
    exact intervalIntegral.integral_mono_interval hu.1 huv hv.2
      (Filter.Eventually.of_forall fun y => abs_nonneg _) habs
  rcases le_total s t with hst | hst
  · calc |∫ y in s..t, F' y| ≤ ∫ y in s..t, |F' y| :=
          intervalIntegral.abs_integral_le_integral_abs hst
      _ ≤ ∫ y in a..b, |F' y| := hsub hs ht hst
  · have hswap : (∫ y in s..t, F' y) = -(∫ y in t..s, F' y) :=
      intervalIntegral.integral_symm _ _
    rw [hswap, abs_neg]
    calc |∫ y in t..s, F' y| ≤ ∫ y in t..s, |F' y| :=
          intervalIntegral.abs_integral_le_integral_abs hst
      _ ≤ ∫ y in a..b, |F' y| := hsub ht hs hst

/-- **The maximal estimate on an interval.** -/
theorem abs_le_average_add_integral_deriv {F F' : ℝ → ℝ} {a b : ℝ}
    (hab : a < b) (hderiv : ∀ x ∈ uIcc a b, HasDerivAt F (F' x) x)
    (hint : IntervalIntegrable F' volume a b)
    (hFint : IntervalIntegrable F volume a b) {t : ℝ} (ht : t ∈ Icc a b) :
    |F t| ≤ (1 / (b - a)) * (∫ s in a..b, |F s|) + ∫ s in a..b, |F' s| := by
  have hlen : 0 < b - a := by linarith
  set D : ℝ := ∫ y in a..b, |F' y| with hD
  have hDnn : 0 ≤ D := by
    rw [hD]
    exact intervalIntegral.integral_nonneg (le_of_lt hab)
      (fun y _ => abs_nonneg _)
  -- pointwise comparison with any other point
  have hcomp : ∀ s ∈ Icc a b, |F t| ≤ |F s| + D := by
    intro s hs
    have huIcc : ∀ x ∈ uIcc s t, HasDerivAt F (F' x) x := by
      intro x hx
      refine hderiv x ?_
      have hsub : uIcc s t ⊆ uIcc a b := by
        rw [uIcc_of_le (le_of_lt hab)]
        exact uIcc_subset_Icc hs ht
      exact hsub hx
    have hintst : IntervalIntegrable F' volume s t := by
      refine hint.mono_set ?_
      rw [uIcc_of_le (le_of_lt hab)]
      exact uIcc_subset_Icc hs ht
    have hftc : (∫ y in s..t, F' y) = F t - F s :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt huIcc hintst
    have hbound := abs_integral_deriv_le hint hs ht
    rw [hftc] at hbound
    have htri : |F t| - |F s| ≤ |F t - F s| := abs_sub_abs_le_abs_sub (F t) (F s)
    linarith [hbound, htri]
  -- average over the interval
  have haverage : (b - a) * |F t| ≤ (∫ s in a..b, |F s|) + (b - a) * D := by
    have h1 : (∫ s in a..b, |F t|) ≤ ∫ s in a..b, (|F s| + D) := by
      refine intervalIntegral.integral_mono_on (le_of_lt hab)
        (intervalIntegrable_const) (hFint.abs.add intervalIntegrable_const) ?_
      intro s hs
      exact hcomp s hs
    rw [intervalIntegral.integral_const, smul_eq_mul,
      intervalIntegral.integral_add hFint.abs intervalIntegrable_const,
      intervalIntegral.integral_const, smul_eq_mul] at h1
    linarith [h1]
  have h2 : |F t| ≤ ((∫ s in a..b, |F s|) + (b - a) * D) / (b - a) := by
    rw [le_div_iff₀ hlen]
    linarith [haverage]
  calc |F t| ≤ ((∫ s in a..b, |F s|) + (b - a) * D) / (b - a) := h2
    _ = (1 / (b - a)) * (∫ s in a..b, |F s|) + D := by
        field_simp

/-! ## Localizing a supremum over a covered set

Combining the maximal estimate on an interval with a covering of `E` bounds a
supremum over `E` by a sum over the covering intervals.  This is the
localization step of BRS (5.9). -/

/-- **The localized maximal bound.** -/
theorem iSup_enorm_le_of_cover {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℝ}
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x)
    (hint : ∀ a : ℝ, IntervalIntegrable F' volume (a - δ / 2) (a + δ / 2))
    (hFint : ∀ a : ℝ, IntervalIntegrable F volume (a - δ / 2) (a + δ / 2)) :
    (⨆ t ∈ E, ENNReal.ofReal |F t|) ≤
      ∑ a ∈ ι, ENNReal.ofReal ((1 / δ) *
        (∫ s in (a - δ / 2)..(a + δ / 2), |F s|) +
          ∫ s in (a - δ / 2)..(a + δ / 2), |F' s|) := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov ht)
  have hlt : a - δ / 2 < a + δ / 2 := by linarith
  have hlen : (a + δ / 2) - (a - δ / 2) = δ := by ring
  have hmax := abs_le_average_add_integral_deriv hlt
    (fun x _ => hderiv x) (hint a) (hFint a) hmem
  rw [hlen] at hmax
  have hterm : ENNReal.ofReal |F t| ≤
      ENNReal.ofReal ((1 / δ) * (∫ s in (a - δ / 2)..(a + δ / 2), |F s|) +
        ∫ s in (a - δ / 2)..(a + δ / 2), |F' s|) :=
    ENNReal.ofReal_le_ofReal hmax
  refine le_trans hterm ?_
  exact Finset.single_le_sum
    (f := fun a : ℝ => ENNReal.ofReal ((1 / δ) *
      (∫ s in (a - δ / 2)..(a + δ / 2), |F s|) +
        ∫ s in (a - δ / 2)..(a + δ / 2), |F' s|))
    (fun _ _ => zero_le) ha

/-! ## Differentiating the smoothed operator

The `t`-derivative of a convolution falls on the kernel, which is what lets
the maximal estimate be applied to the smoothed operators of (5.9). -/

/-- The convolution against a real kernel, in the form used here, is Mathlib's
convolution for the scalar multiplication pairing. -/
theorem convolution_eq_integral {K : ℝ → ℝ} {g : ℝ → ℂ} (x : ℝ) :
    (K ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] g) x =
      ∫ y : ℝ, (K y : ℂ) * g (x - y) := by
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp [convolution, ContinuousLinearMap.lsmul_apply, Complex.real_smul]

/-- **The derivative of the smoothed operator.** -/
theorem hasDerivAt_kernel_convolution {K : ℝ → ℝ} (hcs : HasCompactSupport K)
    (hK : ContDiff ℝ 1 K) {g : ℝ → ℂ} (hg : Continuous g) (x : ℝ) :
    HasDerivAt (fun s : ℝ => ∫ y : ℝ, (K y : ℂ) * g (s - y))
      (∫ y : ℝ, ((deriv K y : ℝ) : ℂ) * g (x - y)) x := by
  have hloc : LocallyIntegrable g volume := hg.locallyIntegrable
  have hmain := HasCompactSupport.hasDerivAt_convolution_left
    (L := (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ)) (μ := (volume : Measure ℝ))
    hcs hK hloc x
  have hfun : (K ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] g) =
      fun s : ℝ => ∫ y : ℝ, (K y : ℂ) * g (s - y) := by
    funext s
    exact convolution_eq_integral s
  have hval : (deriv K ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] g) x =
      ∫ y : ℝ, ((deriv K y : ℝ) : ℂ) * g (x - y) := convolution_eq_integral x
  rw [hfun, hval] at hmain
  exact hmain

/-! ## The maximal estimate for complex-valued functions -/

/-- The derivative integral over a subinterval is dominated by the total. -/
theorem norm_integral_deriv_le {F' : ℝ → ℂ} {a b s t : ℝ}
    (hint : IntervalIntegrable F' volume a b) (hs : s ∈ Icc a b)
    (ht : t ∈ Icc a b) :
    ‖∫ y in s..t, F' y‖ ≤ ∫ y in a..b, ‖F' y‖ := by
  have hnorm : IntervalIntegrable (fun y => ‖F' y‖) volume a b := hint.norm
  have hsub : ∀ {u v : ℝ}, u ∈ Icc a b → v ∈ Icc a b → u ≤ v →
      (∫ y in u..v, ‖F' y‖) ≤ ∫ y in a..b, ‖F' y‖ := by
    intro u v hu hv huv
    exact intervalIntegral.integral_mono_interval hu.1 huv hv.2
      (Filter.Eventually.of_forall fun y => norm_nonneg _) hnorm
  rcases le_total s t with hst | hst
  · calc ‖∫ y in s..t, F' y‖ ≤ ∫ y in s..t, ‖F' y‖ :=
          intervalIntegral.norm_integral_le_integral_norm hst
      _ ≤ ∫ y in a..b, ‖F' y‖ := hsub hs ht hst
  · have hswap : (∫ y in s..t, F' y) = -(∫ y in t..s, F' y) :=
      intervalIntegral.integral_symm _ _
    rw [hswap, norm_neg]
    calc ‖∫ y in t..s, F' y‖ ≤ ∫ y in t..s, ‖F' y‖ :=
          intervalIntegral.norm_integral_le_integral_norm hst
      _ ≤ ∫ y in a..b, ‖F' y‖ := hsub ht hs hst

/-- **The maximal estimate on an interval**, for complex-valued functions. -/
theorem norm_le_average_add_integral_deriv {F F' : ℝ → ℂ} {a b : ℝ}
    (hab : a < b) (hderiv : ∀ x ∈ uIcc a b, HasDerivAt F (F' x) x)
    (hint : IntervalIntegrable F' volume a b)
    (hFint : IntervalIntegrable F volume a b) {t : ℝ} (ht : t ∈ Icc a b) :
    ‖F t‖ ≤ (1 / (b - a)) * (∫ s in a..b, ‖F s‖) + ∫ s in a..b, ‖F' s‖ := by
  have hlen : 0 < b - a := by linarith
  set D : ℝ := ∫ y in a..b, ‖F' y‖ with hD
  have hDnn : 0 ≤ D := by
    rw [hD]
    exact intervalIntegral.integral_nonneg (le_of_lt hab)
      (fun y _ => norm_nonneg _)
  have hcomp : ∀ s ∈ Icc a b, ‖F t‖ ≤ ‖F s‖ + D := by
    intro s hs
    have huIcc : ∀ x ∈ uIcc s t, HasDerivAt F (F' x) x := by
      intro x hx
      refine hderiv x ?_
      have hsub : uIcc s t ⊆ uIcc a b := by
        rw [uIcc_of_le (le_of_lt hab)]
        exact uIcc_subset_Icc hs ht
      exact hsub hx
    have hintst : IntervalIntegrable F' volume s t := by
      refine hint.mono_set ?_
      rw [uIcc_of_le (le_of_lt hab)]
      exact uIcc_subset_Icc hs ht
    have hftc : (∫ y in s..t, F' y) = F t - F s :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt huIcc hintst
    have hbound := norm_integral_deriv_le hint hs ht
    rw [hftc] at hbound
    have htri : ‖F t‖ - ‖F s‖ ≤ ‖F t - F s‖ := norm_sub_norm_le (F t) (F s)
    linarith [hbound, htri]
  have haverage : (b - a) * ‖F t‖ ≤ (∫ s in a..b, ‖F s‖) + (b - a) * D := by
    have h1 : (∫ _s in a..b, ‖F t‖) ≤ ∫ s in a..b, (‖F s‖ + D) := by
      refine intervalIntegral.integral_mono_on (le_of_lt hab)
        (intervalIntegrable_const) (hFint.norm.add intervalIntegrable_const) ?_
      intro s hs
      exact hcomp s hs
    rw [intervalIntegral.integral_const, smul_eq_mul,
      intervalIntegral.integral_add hFint.norm intervalIntegrable_const,
      intervalIntegral.integral_const, smul_eq_mul] at h1
    linarith [h1]
  have h2 : ‖F t‖ ≤ ((∫ s in a..b, ‖F s‖) + (b - a) * D) / (b - a) := by
    rw [le_div_iff₀ hlen]
    linarith [haverage]
  calc ‖F t‖ ≤ ((∫ s in a..b, ‖F s‖) + (b - a) * D) / (b - a) := h2
    _ = (1 / (b - a)) * (∫ s in a..b, ‖F s‖) + D := by field_simp

/-- **The localized maximal bound**, for complex-valued functions. -/
theorem iSup_enorm_le_of_cover_complex {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x)
    (hint : ∀ a : ℝ, IntervalIntegrable F' volume (a - δ / 2) (a + δ / 2))
    (hFint : ∀ a : ℝ, IntervalIntegrable F volume (a - δ / 2) (a + δ / 2)) :
    (⨆ t ∈ E, ‖F t‖ₑ) ≤
      ∑ a ∈ ι, ENNReal.ofReal ((1 / δ) *
        (∫ s in (a - δ / 2)..(a + δ / 2), ‖F s‖) +
          ∫ s in (a - δ / 2)..(a + δ / 2), ‖F' s‖) := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov ht)
  have hlt : a - δ / 2 < a + δ / 2 := by linarith
  have hlen : (a + δ / 2) - (a - δ / 2) = δ := by ring
  have hmax := norm_le_average_add_integral_deriv hlt
    (fun x _ => hderiv x) (hint a) (hFint a) hmem
  rw [hlen] at hmax
  have hterm : ‖F t‖ₑ ≤
      ENNReal.ofReal ((1 / δ) * (∫ s in (a - δ / 2)..(a + δ / 2), ‖F s‖) +
        ∫ s in (a - δ / 2)..(a + δ / 2), ‖F' s‖) := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal hmax
  refine le_trans hterm ?_
  exact Finset.single_le_sum
    (f := fun a : ℝ => ENNReal.ofReal ((1 / δ) *
      (∫ s in (a - δ / 2)..(a + δ / 2), ‖F s‖) +
        ∫ s in (a - δ / 2)..(a + δ / 2), ‖F' s‖))
    (fun _ _ => zero_le) ha

/-! ## Distribution functions

The two structural facts underlying real interpolation: the layer cake
formula in the form used here, and subadditivity of the distribution
function.  These are the entry point for the endpoint cases that are
currently deferred (`Proposition 4.3` at `q = pd`, `(5.6)` at `q = 2p`). -/

/-- The distribution function of `F` with respect to `μ`. -/
def brsDistribution {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (F : α → ℂ) (t : ℝ) : ENNReal := μ {x | t < ‖F x‖}

/-- **The layer cake formula** for the `q`-th power of a norm. -/
theorem lintegral_enorm_rpow_eq_distribution {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {F : α → ℂ} (hF : AEMeasurable F μ) {q : ℝ} (hq : 0 < q) :
    (∫⁻ x, ‖F x‖ₑ ^ q ∂μ) =
      ENNReal.ofReal q *
        ∫⁻ t in Ioi (0 : ℝ), brsDistribution μ F t * ENNReal.ofReal (t ^ (q - 1)) := by
  have hnn : 0 ≤ᵐ[μ] fun x => ‖F x‖ :=
    Filter.Eventually.of_forall fun x => norm_nonneg _
  have hmble : AEMeasurable (fun x => ‖F x‖) μ := hF.norm
  have hlayer := lintegral_rpow_eq_lintegral_meas_lt_mul μ hnn hmble hq
  have hleft : (∫⁻ x, ENNReal.ofReal (‖F x‖ ^ q) ∂μ) = ∫⁻ x, ‖F x‖ₑ ^ q ∂μ := by
    refine lintegral_congr fun x => ?_
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hq.le, ofReal_norm]
  rw [hleft] at hlayer
  exact hlayer

/-- **Subadditivity of the distribution function.** -/
theorem brsDistribution_add_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (F G : α → ℂ) {t : ℝ} (ht : 0 < t) :
    brsDistribution μ (fun x => F x + G x) t ≤
      brsDistribution μ F (t / 2) + brsDistribution μ G (t / 2) := by
  have hsub : {x | t < ‖F x + G x‖} ⊆
      {x | t / 2 < ‖F x‖} ∪ {x | t / 2 < ‖G x‖} := by
    intro x hx
    by_contra hcon
    have h1 : ‖F x‖ ≤ t / 2 := by
      by_contra hc
      exact hcon (Or.inl (by simpa using not_le.mp hc))
    have h2 : ‖G x‖ ≤ t / 2 := by
      by_contra hc
      exact hcon (Or.inr (by simpa using not_le.mp hc))
    have : ‖F x + G x‖ ≤ t := by
      calc ‖F x + G x‖ ≤ ‖F x‖ + ‖G x‖ := norm_add_le _ _
        _ ≤ t / 2 + t / 2 := add_le_add h1 h2
        _ = t := by ring
    exact absurd hx (by simpa using this)
  calc brsDistribution μ (fun x => F x + G x) t
      ≤ μ ({x | t / 2 < ‖F x‖} ∪ {x | t / 2 < ‖G x‖}) := measure_mono hsub
    _ ≤ brsDistribution μ F (t / 2) + brsDistribution μ G (t / 2) :=
        measure_union_le _ _

/-- The distribution function is antitone in the level. -/
theorem brsDistribution_mono {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (F : α → ℂ) {s t : ℝ} (hst : s ≤ t) :
    brsDistribution μ F t ≤ brsDistribution μ F s := by
  refine measure_mono fun x hx => ?_
  exact lt_of_le_of_lt hst hx

/-- **Chebyshev's inequality** for the distribution function. -/
theorem brsDistribution_chebyshev {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {F : α → ℂ} (hF : AEMeasurable F μ) {p t : ℝ} (hp : 0 < p) :
    ENNReal.ofReal t ^ p * brsDistribution μ F t ≤ ∫⁻ x, ‖F x‖ₑ ^ p ∂μ := by
  have hmain := mul_meas_ge_le_lintegral₀ (μ := μ)
    (f := fun x => ‖F x‖ₑ ^ p) (hF.enorm.pow_const p) (ENNReal.ofReal t ^ p)
  refine le_trans (mul_le_mul' le_rfl ?_) hmain
  refine measure_mono fun x hx => ?_
  have h1 : ENNReal.ofReal t ≤ ‖F x‖ₑ := by
    rw [← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (le_of_lt hx)
  exact ENNReal.rpow_le_rpow h1 hp.le

/-! ## The size decomposition

Splitting a function at a threshold is the second ingredient of real
interpolation: the large part is better in a smaller exponent, the small part
in a larger one. -/

/-- The part of `f` above the threshold `c`. -/
def brsBigPart {α : Type*} (c : ℝ) (f : α → ℂ) : α → ℂ :=
  fun x => if c < ‖f x‖ then f x else 0

/-- The part of `f` below the threshold `c`. -/
def brsSmallPart {α : Type*} (c : ℝ) (f : α → ℂ) : α → ℂ :=
  fun x => if c < ‖f x‖ then 0 else f x

theorem brsBigPart_add_brsSmallPart {α : Type*} (c : ℝ) (f : α → ℂ) (x : α) :
    brsBigPart c f x + brsSmallPart c f x = f x := by
  simp only [brsBigPart, brsSmallPart]
  by_cases h : c < ‖f x‖ <;> simp [h]

theorem measurable_brsBigPart {α : Type*} [MeasurableSpace α] {c : ℝ}
    {f : α → ℂ} (hf : Measurable f) : Measurable (brsBigPart c f) := by
  refine Measurable.ite ?_ hf measurable_const
  exact measurableSet_lt measurable_const hf.norm

theorem measurable_brsSmallPart {α : Type*} [MeasurableSpace α] {c : ℝ}
    {f : α → ℂ} (hf : Measurable f) : Measurable (brsSmallPart c f) := by
  refine Measurable.ite ?_ measurable_const hf
  exact measurableSet_lt measurable_const hf.norm

/-- **The large part is better in a smaller exponent.** -/
theorem lintegral_brsBigPart_le {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℂ} {p₀ p c : ℝ} (hp₀ : 0 < p₀) (hle : p₀ ≤ p)
    (hc : 0 < c) :
    (∫⁻ x, ‖brsBigPart c f x‖ₑ ^ p₀ ∂μ) ≤
      ENNReal.ofReal (c ^ (p₀ - p)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hp : 0 < p := lt_of_lt_of_le hp₀ hle
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun x => ?_
  by_cases hx : c < ‖f x‖
  · have hbig : brsBigPart c f x = f x := by simp [brsBigPart, hx]
    rw [hbig]
    have hane : ‖f x‖ₑ ≠ 0 := by
      simp only [ne_eq, enorm_eq_zero]
      intro hzero
      rw [hzero] at hx
      simp at hx
      linarith
    have hatop : ‖f x‖ₑ ≠ ⊤ := enorm_ne_top (x := f x)
    have hsplit : ‖f x‖ₑ ^ p₀ = ‖f x‖ₑ ^ (p₀ - p) * ‖f x‖ₑ ^ p := by
      rw [← ENNReal.rpow_add _ _ hane hatop]
      congr 1
      ring
    have hcle : ENNReal.ofReal c ≤ ‖f x‖ₑ := by
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal (le_of_lt hx)
    have hcpos : (0 : ENNReal) < ENNReal.ofReal c := ENNReal.ofReal_pos.mpr hc
    have hmono : ‖f x‖ₑ ^ (p₀ - p) ≤ ENNReal.ofReal c ^ (p₀ - p) := by
      have he : (0 : ℝ) ≤ p - p₀ := by linarith
      have h1 : ENNReal.ofReal c ^ (p - p₀) ≤ ‖f x‖ₑ ^ (p - p₀) :=
        ENNReal.rpow_le_rpow hcle he
      have h2 : ‖f x‖ₑ ^ (p₀ - p) = (‖f x‖ₑ ^ (p - p₀))⁻¹ := by
        rw [show p₀ - p = -(p - p₀) by ring, ENNReal.rpow_neg]
      have h3 : ENNReal.ofReal c ^ (p₀ - p) =
          (ENNReal.ofReal c ^ (p - p₀))⁻¹ := by
        rw [show p₀ - p = -(p - p₀) by ring, ENNReal.rpow_neg]
      rw [h2, h3]
      exact ENNReal.inv_le_inv.mpr h1
    rw [hsplit]
    refine mul_le_mul' ?_ le_rfl
    rw [← ENNReal.ofReal_rpow_of_pos hc]
    exact hmono
  · have hbig : brsBigPart c f x = 0 := by simp [brsBigPart, hx]
    rw [hbig]
    simp [ENNReal.zero_rpow_of_pos hp₀]

/-- **The small part is better in a larger exponent.** -/
theorem lintegral_brsSmallPart_le {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℂ} {p₁ p c : ℝ} (hp : 0 < p) (hle : p ≤ p₁)
    (hc : 0 < c) :
    (∫⁻ x, ‖brsSmallPart c f x‖ₑ ^ p₁ ∂μ) ≤
      ENNReal.ofReal (c ^ (p₁ - p)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hp₁ : 0 < p₁ := lt_of_lt_of_le hp hle
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun x => ?_
  by_cases hx : c < ‖f x‖
  · have hsmall : brsSmallPart c f x = 0 := by simp [brsSmallPart, hx]
    rw [hsmall]
    simp [ENNReal.zero_rpow_of_pos hp₁]
  · have hsmall : brsSmallPart c f x = f x := by simp [brsSmallPart, hx]
    rw [hsmall]
    rcases eq_or_ne (‖f x‖ₑ) 0 with hzero | hane
    · rw [hzero, ENNReal.zero_rpow_of_pos hp₁]
      simp
    · have hatop : ‖f x‖ₑ ≠ ⊤ := enorm_ne_top (x := f x)
      have hsplit : ‖f x‖ₑ ^ p₁ = ‖f x‖ₑ ^ (p₁ - p) * ‖f x‖ₑ ^ p := by
        rw [← ENNReal.rpow_add _ _ hane hatop]
        congr 1
        ring
      have hcle : ‖f x‖ₑ ≤ ENNReal.ofReal c := by
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (not_lt.mp hx)
      rw [hsplit]
      refine mul_le_mul' ?_ le_rfl
      rw [← ENNReal.ofReal_rpow_of_pos hc]
      exact ENNReal.rpow_le_rpow hcle (by linarith)

/-! ## The splitting estimate

For a subadditive operator, the distribution function at level `s` is
controlled by those of the two pieces of the size decomposition at level
`s/2`.  This is the step that converts two weak-type bounds into one
distribution estimate. -/

/-- Subadditivity of an operator, in the pointwise form used here. -/
def IsSubadditiveOn {α β : Type*} (T : (α → ℂ) → β → ℂ) : Prop :=
  ∀ f g : α → ℂ, ∀ x : β, ‖T (fun y => f y + g y) x‖ ≤ ‖T f x‖ + ‖T g x‖

/-- **The splitting estimate.** -/
theorem brsDistribution_split_le {α β : Type*} [MeasurableSpace α]
    [MeasurableSpace β] {ν : Measure β} {T : (α → ℂ) → β → ℂ}
    (hsub : IsSubadditiveOn T) (f : α → ℂ) {c s : ℝ} :
    brsDistribution ν (T f) s ≤
      brsDistribution ν (T (brsBigPart c f)) (s / 2) +
        brsDistribution ν (T (brsSmallPart c f)) (s / 2) := by
  have heq : (fun y => brsBigPart c f y + brsSmallPart c f y) = f := by
    funext y
    rw [brsBigPart_add_brsSmallPart]
  have hsub' : ∀ x : β, ‖T f x‖ ≤
      ‖T (brsBigPart c f) x‖ + ‖T (brsSmallPart c f) x‖ := by
    intro x
    have h := hsub (brsBigPart c f) (brsSmallPart c f) x
    rw [heq] at h
    exact h
  have hincl : {x : β | s < ‖T f x‖} ⊆
      {x : β | s / 2 < ‖T (brsBigPart c f) x‖} ∪
        {x : β | s / 2 < ‖T (brsSmallPart c f) x‖} := by
    intro x hx
    by_contra hcon
    have h1 : ‖T (brsBigPart c f) x‖ ≤ s / 2 := by
      by_contra hc1
      exact hcon (Or.inl (by simpa using not_le.mp hc1))
    have h2 : ‖T (brsSmallPart c f) x‖ ≤ s / 2 := by
      by_contra hc2
      exact hcon (Or.inr (by simpa using not_le.mp hc2))
    have : ‖T f x‖ ≤ s := by
      calc ‖T f x‖ ≤ ‖T (brsBigPart c f) x‖ + ‖T (brsSmallPart c f) x‖ :=
            hsub' x
        _ ≤ s / 2 + s / 2 := add_le_add h1 h2
        _ = s := by ring
    exact absurd hx (by simpa using this)
  calc brsDistribution ν (T f) s
      ≤ ν ({x : β | s / 2 < ‖T (brsBigPart c f) x‖} ∪
          {x : β | s / 2 < ‖T (brsSmallPart c f) x‖}) := measure_mono hincl
    _ ≤ brsDistribution ν (T (brsBigPart c f)) (s / 2) +
          brsDistribution ν (T (brsSmallPart c f)) (s / 2) := measure_union_le _ _

/-- A weak-type bound, phrased through the distribution function. -/
def HasWeakType {α β : Type*} [MeasurableSpace α] [MeasurableSpace β]
    (T : (α → ℂ) → β → ℂ) (μ : Measure α) (ν : Measure β) (p q A : ℝ) : Prop :=
  ∀ (f : α → ℂ), ∀ s : ℝ, 0 < s →
    brsDistribution ν (T f) s ≤
      (ENNReal.ofReal (A / s)) ^ q * (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) ^ (q / p)

/-- **The splitting estimate against two weak-type bounds.** -/
theorem brsDistribution_le_of_weakType {α β : Type*} [MeasurableSpace α]
    [MeasurableSpace β] {μ : Measure α} {ν : Measure β} {T : (α → ℂ) → β → ℂ}
    (hsub : IsSubadditiveOn T) {p₀ p₁ q₀ q₁ A₀ A₁ : ℝ}
    (h₀ : HasWeakType T μ ν p₀ q₀ A₀) (h₁ : HasWeakType T μ ν p₁ q₁ A₁)
    (f : α → ℂ) {c s : ℝ} (hs : 0 < s) :
    brsDistribution ν (T f) s ≤
      (ENNReal.ofReal (A₀ / (s / 2))) ^ q₀ *
          (∫⁻ x, ‖brsBigPart c f x‖ₑ ^ p₀ ∂μ) ^ (q₀ / p₀) +
        (ENNReal.ofReal (A₁ / (s / 2))) ^ q₁ *
          (∫⁻ x, ‖brsSmallPart c f x‖ₑ ^ p₁ ∂μ) ^ (q₁ / p₁) := by
  refine le_trans (brsDistribution_split_le hsub f (c := c) (s := s)) ?_
  exact add_le_add (h₀ _ (s / 2) (by linarith)) (h₁ _ (s / 2) (by linarith))

/-! ## The two elementary level integrals

The Marcinkiewicz computation integrates the level variable against a power,
once over a finite window and once over a tail. -/

/-- The level integral over a finite window. -/
theorem lintegral_Ioo_rpow {e a : ℝ} (he : -1 < e) (ha : 0 < a) :
    (∫⁻ s in Ioo (0 : ℝ) a, ENNReal.ofReal (s ^ e)) =
      ENNReal.ofReal (a ^ (e + 1) / (e + 1)) := by
  have he1 : (0 : ℝ) < e + 1 := by linarith
  have hint : IntervalIntegrable (fun s : ℝ => s ^ e) volume 0 a :=
    intervalIntegral.intervalIntegrable_rpow' he
  rw [lintegral_Ioo_eq_ofReal_intervalIntegral ha.le hint
    (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
  congr 1
  rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne']
  simp

/-- The level integral over a tail. -/
theorem lintegral_Ioi_rpow {e a : ℝ} (he : e < -1) (ha : 0 < a) :
    (∫⁻ s in Ioi a, ENNReal.ofReal (s ^ e)) =
      ENNReal.ofReal (-a ^ (e + 1) / (e + 1)) := by
  have hint : IntegrableOn (fun s : ℝ => s ^ e) (Ioi a) volume :=
    integrableOn_Ioi_rpow_of_lt he ha
  have hnn : 0 ≤ᵐ[volume.restrict (Ioi a)] fun s : ℝ => s ^ e := by
    filter_upwards [self_mem_ae_restrict measurableSet_Ioi] with s hs
    exact Real.rpow_nonneg (le_of_lt (lt_trans ha hs)) _
  rw [← ofReal_integral_eq_lintegral_ofReal hint hnn,
    integral_Ioi_rpow_of_lt he ha]

/-! ## Exchanging the level and space integrals -/

/-- **The exchange for the large part.** -/
theorem lintegral_level_swap_big {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℂ} (hf : Measurable f) {r e : ℝ}
    (hr : 0 < r) :
    (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ e) *
        ∫⁻ x, {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ r) x ∂μ) =
      ∫⁻ x, ‖f x‖ₑ ^ r *
        (∫⁻ s in Ioo (0 : ℝ) ‖f x‖, ENNReal.ofReal (s ^ e)) ∂μ := by
  have hset : MeasurableSet {z : ℝ × α | z.1 < ‖f z.2‖} :=
    measurableSet_lt measurable_fst ((hf.comp measurable_snd).norm)
  have hjoint : Measurable fun z : ℝ × α =>
      ENNReal.ofReal (z.1 ^ e) *
        {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) z := by
    refine Measurable.mul ?_ ?_
    · exact ENNReal.measurable_ofReal.comp
        ((measurable_fst.pow_const e))
    · exact (((hf.comp measurable_snd).enorm).pow_const r).indicator hset
  -- rewrite the inner integrand as a two-variable indicator
  have hinner : ∀ s : ℝ, (ENNReal.ofReal (s ^ e) *
      ∫⁻ x, {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ r) x ∂μ) =
      ∫⁻ x, ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x) ∂μ := by
    intro s
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun x => ?_
    rfl
  rw [setLIntegral_congr_fun measurableSet_Ioi fun s _ => hinner s]
  -- swap
  rw [← lintegral_indicator measurableSet_Ioi]
  have hstep : (∫⁻ s : ℝ, (Ioi (0 : ℝ)).indicator (fun s : ℝ =>
      ∫⁻ x, ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x) ∂μ) s) =
      ∫⁻ s : ℝ, ∫⁻ x, (Ioi (0 : ℝ)).indicator
        (fun s : ℝ => ENNReal.ofReal (s ^ e) *
          {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
            (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s ∂μ := by
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Ioi (0 : ℝ)
    · rw [Set.indicator_of_mem hs]
      refine lintegral_congr fun x => ?_
      rw [Set.indicator_of_mem hs]
    · rw [Set.indicator_of_notMem hs]
      have : ∀ x : α, (Ioi (0 : ℝ)).indicator
          (fun s : ℝ => ENNReal.ofReal (s ^ e) *
            {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
              (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s = 0 := by
        intro x
        rw [Set.indicator_of_notMem hs]
      rw [lintegral_congr this, lintegral_zero]
  rw [hstep]
  have hjoint' : Measurable fun z : ℝ × α => (Ioi (0 : ℝ)).indicator
      (fun s : ℝ => ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, z.2)) z.1 := by
    have hpre : MeasurableSet {z : ℝ × α | z.1 ∈ Ioi (0 : ℝ)} :=
      measurable_fst measurableSet_Ioi
    have heq : (fun z : ℝ × α => (Ioi (0 : ℝ)).indicator
        (fun s : ℝ => ENNReal.ofReal (s ^ e) *
          {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
            (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, z.2)) z.1) =
        {z : ℝ × α | z.1 ∈ Ioi (0 : ℝ)}.indicator
          (fun z : ℝ × α => ENNReal.ofReal (z.1 ^ e) *
            {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
              (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) z) := by
      funext z
      by_cases hz : z.1 ∈ Ioi (0 : ℝ)
      · rw [Set.indicator_of_mem hz,
          Set.indicator_of_mem (show z ∈ {w : ℝ × α | w.1 ∈ Ioi (0 : ℝ)}
            from hz)]
      · rw [Set.indicator_of_notMem hz,
          Set.indicator_of_notMem (show z ∉ {w : ℝ × α | w.1 ∈ Ioi (0 : ℝ)}
            from hz)]
    rw [heq]
    exact hjoint.indicator hpre
  rw [lintegral_lintegral_swap hjoint'.aemeasurable]
  refine lintegral_congr fun x => ?_
  -- the inner level integral
  have hlevel : (∫⁻ s : ℝ, (Ioi (0 : ℝ)).indicator
      (fun s : ℝ => ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | z.1 < ‖f z.2‖}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s) =
      ∫⁻ s in Ioo (0 : ℝ) ‖f x‖, ENNReal.ofReal (s ^ e) * ‖f x‖ₑ ^ r := by
    rw [← lintegral_indicator measurableSet_Ioo]
    refine lintegral_congr fun s => ?_
    by_cases hs : 0 < s
    · by_cases hsf : s < ‖f x‖
      · rw [Set.indicator_of_mem (show s ∈ Ioi (0 : ℝ) from hs),
          Set.indicator_of_mem (show s ∈ Ioo (0 : ℝ) ‖f x‖ from ⟨hs, hsf⟩),
          Set.indicator_of_mem (show (s, x) ∈ {z : ℝ × α | z.1 < ‖f z.2‖}
            from hsf)]
      · rw [Set.indicator_of_mem (show s ∈ Ioi (0 : ℝ) from hs),
          Set.indicator_of_notMem (show s ∉ Ioo (0 : ℝ) ‖f x‖ from
            fun hc => hsf hc.2),
          Set.indicator_of_notMem (show (s, x) ∉ {z : ℝ × α | z.1 < ‖f z.2‖}
            from hsf), mul_zero]
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (0 : ℝ) from hs),
        Set.indicator_of_notMem (show s ∉ Ioo (0 : ℝ) ‖f x‖ from
          fun hc => hs hc.1)]
  rw [hlevel, lintegral_mul_const' _ _
    (ENNReal.rpow_ne_top_of_nonneg hr.le (enorm_ne_top (x := f x)))]
  ring

/-- **The exchange for the small part.** -/
theorem lintegral_level_swap_small {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℂ} (hf : Measurable f) {r e : ℝ}
    (hr : 0 < r) :
    (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ e) *
        ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ r) x ∂μ) =
      ∫⁻ x, ‖f x‖ₑ ^ r *
        (∫⁻ s in Ioi ‖f x‖, ENNReal.ofReal (s ^ e)) ∂μ := by
  have hset : MeasurableSet {z : ℝ × α | ‖f z.2‖ ≤ z.1} :=
    measurableSet_le ((hf.comp measurable_snd).norm) measurable_fst
  have hjoint : Measurable fun z : ℝ × α =>
      ENNReal.ofReal (z.1 ^ e) *
        {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) z := by
    refine Measurable.mul ?_ ?_
    · exact ENNReal.measurable_ofReal.comp
        ((measurable_fst.pow_const e))
    · exact (((hf.comp measurable_snd).enorm).pow_const r).indicator hset
  -- rewrite the inner integrand as a two-variable indicator
  have hinner : ∀ s : ℝ, (ENNReal.ofReal (s ^ e) *
      ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ r) x ∂μ) =
      ∫⁻ x, ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x) ∂μ := by
    intro s
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun x => ?_
    rfl
  rw [setLIntegral_congr_fun measurableSet_Ioi fun s _ => hinner s]
  -- swap
  rw [← lintegral_indicator measurableSet_Ioi]
  have hstep : (∫⁻ s : ℝ, (Ioi (0 : ℝ)).indicator (fun s : ℝ =>
      ∫⁻ x, ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x) ∂μ) s) =
      ∫⁻ s : ℝ, ∫⁻ x, (Ioi (0 : ℝ)).indicator
        (fun s : ℝ => ENNReal.ofReal (s ^ e) *
          {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
            (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s ∂μ := by
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Ioi (0 : ℝ)
    · rw [Set.indicator_of_mem hs]
      refine lintegral_congr fun x => ?_
      rw [Set.indicator_of_mem hs]
    · rw [Set.indicator_of_notMem hs]
      have : ∀ x : α, (Ioi (0 : ℝ)).indicator
          (fun s : ℝ => ENNReal.ofReal (s ^ e) *
            {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
              (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s = 0 := by
        intro x
        rw [Set.indicator_of_notMem hs]
      rw [lintegral_congr this, lintegral_zero]
  rw [hstep]
  have hjoint' : Measurable fun z : ℝ × α => (Ioi (0 : ℝ)).indicator
      (fun s : ℝ => ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, z.2)) z.1 := by
    have hpre : MeasurableSet {z : ℝ × α | z.1 ∈ Ioi (0 : ℝ)} :=
      measurable_fst measurableSet_Ioi
    have heq : (fun z : ℝ × α => (Ioi (0 : ℝ)).indicator
        (fun s : ℝ => ENNReal.ofReal (s ^ e) *
          {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
            (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, z.2)) z.1) =
        {z : ℝ × α | z.1 ∈ Ioi (0 : ℝ)}.indicator
          (fun z : ℝ × α => ENNReal.ofReal (z.1 ^ e) *
            {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
              (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) z) := by
      funext z
      by_cases hz : z.1 ∈ Ioi (0 : ℝ)
      · rw [Set.indicator_of_mem hz,
          Set.indicator_of_mem (show z ∈ {w : ℝ × α | w.1 ∈ Ioi (0 : ℝ)}
            from hz)]
      · rw [Set.indicator_of_notMem hz,
          Set.indicator_of_notMem (show z ∉ {w : ℝ × α | w.1 ∈ Ioi (0 : ℝ)}
            from hz)]
    rw [heq]
    exact hjoint.indicator hpre
  rw [lintegral_lintegral_swap hjoint'.aemeasurable]
  refine lintegral_congr fun x => ?_
  -- the inner level integral
  set S : Set ℝ := {t : ℝ | 0 < t ∧ ‖f x‖ ≤ t} with hS
  have hSmeas : MeasurableSet S :=
    (measurableSet_lt measurable_const measurable_id).inter
      (measurableSet_le measurable_const measurable_id)
  have hSae : S =ᵐ[volume] Ioi ‖f x‖ := by
    refine MeasureTheory.ae_eq_set.mpr ⟨?_, ?_⟩
    · refine measure_mono_null (fun t ht => ?_) (measure_singleton ‖f x‖)
      obtain ⟨⟨htpos, htge⟩, htnot⟩ := ht
      have : t = ‖f x‖ := le_antisymm (not_lt.mp htnot) htge
      simpa using this
    · have hsub : Ioi ‖f x‖ ⊆ S := by
        intro t ht
        exact ⟨lt_of_le_of_lt (norm_nonneg _) ht, le_of_lt ht⟩
      simp [Set.diff_eq_empty.mpr hsub]
  have hlevel : (∫⁻ s : ℝ, (Ioi (0 : ℝ)).indicator
      (fun s : ℝ => ENNReal.ofReal (s ^ e) *
        {z : ℝ × α | ‖f z.2‖ ≤ z.1}.indicator
          (fun z : ℝ × α => ‖f z.2‖ₑ ^ r) (s, x)) s) =
      ∫⁻ s in S, ENNReal.ofReal (s ^ e) * ‖f x‖ₑ ^ r := by
    rw [← lintegral_indicator hSmeas]
    refine lintegral_congr fun s => ?_
    by_cases hs : 0 < s
    · by_cases hsf : ‖f x‖ ≤ s
      · rw [Set.indicator_of_mem (show s ∈ Ioi (0 : ℝ) from hs),
          Set.indicator_of_mem (show s ∈ S from ⟨hs, hsf⟩),
          Set.indicator_of_mem (show (s, x) ∈ {z : ℝ × α | ‖f z.2‖ ≤ z.1}
            from hsf)]
      · rw [Set.indicator_of_mem (show s ∈ Ioi (0 : ℝ) from hs),
          Set.indicator_of_notMem (show s ∉ S from fun hc => hsf hc.2),
          Set.indicator_of_notMem (show (s, x) ∉ {z : ℝ × α | ‖f z.2‖ ≤ z.1}
            from hsf), mul_zero]
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (0 : ℝ) from hs),
        Set.indicator_of_notMem (show s ∉ S from fun hc => hs hc.1)]
  rw [hlevel, setLIntegral_congr hSae, lintegral_mul_const' _ _
    (ENNReal.rpow_ne_top_of_nonneg hr.le (enorm_ne_top (x := f x)))]
  ring

/-! ## The two terms of the Marcinkiewicz computation -/

/-- The contribution of the large parts. -/
theorem marcinkiewicz_big_term {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SFinite μ] {f : α → ℂ} (hf : Measurable f) {p₀ p : ℝ} (hp₀ : 0 < p₀)
    (hlt : p₀ < p) :
    (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ (p - 1 - p₀)) *
        ∫⁻ x, {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) =
      ENNReal.ofReal (1 / (p - p₀)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hpp₀ : (0 : ℝ) < p - p₀ := by linarith
  have he : (-1 : ℝ) < p - 1 - p₀ := by linarith
  rw [lintegral_level_swap_big hf hp₀]
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun x => ?_
  rcases eq_or_lt_of_le (norm_nonneg (f x)) with hzero | hpos
  · -- `f x = 0`: both sides vanish
    have hfx : ‖f x‖ = 0 := hzero.symm
    have hne : ‖f x‖ₑ = 0 := by
      rw [← ofReal_norm, hfx, ENNReal.ofReal_zero]
    rw [hne, ENNReal.zero_rpow_of_pos hp₀, ENNReal.zero_rpow_of_pos
      (by linarith : (0:ℝ) < p), zero_mul, mul_zero]
  · -- `f x ≠ 0`: evaluate the level integral
    have hlevel : (∫⁻ s in Ioo (0 : ℝ) ‖f x‖,
        ENNReal.ofReal (s ^ (p - 1 - p₀))) =
        ENNReal.ofReal (‖f x‖ ^ (p - p₀) / (p - p₀)) := by
      rw [lintegral_Ioo_rpow he hpos]
      congr 2
      · ring
      · ring
    rw [hlevel]
    have hne : ‖f x‖ₑ ≠ 0 := by
      simp only [ne_eq, enorm_eq_zero]
      intro hc
      rw [hc] at hpos
      simp at hpos
    have htop : ‖f x‖ₑ ≠ ⊤ := enorm_ne_top (x := f x)
    have hsplit : ENNReal.ofReal (‖f x‖ ^ (p - p₀) / (p - p₀)) =
        ENNReal.ofReal (1 / (p - p₀)) * ‖f x‖ₑ ^ (p - p₀) := by
      rw [show ‖f x‖ ^ (p - p₀) / (p - p₀) =
          (1 / (p - p₀)) * ‖f x‖ ^ (p - p₀) by ring,
        ENNReal.ofReal_mul (by positivity),
        ← ENNReal.ofReal_rpow_of_pos hpos, ofReal_norm]
    rw [hsplit]
    have hpow : ‖f x‖ₑ ^ p₀ * (ENNReal.ofReal (1 / (p - p₀)) *
        ‖f x‖ₑ ^ (p - p₀)) =
        ENNReal.ofReal (1 / (p - p₀)) * ‖f x‖ₑ ^ p := by
      have hadd : ‖f x‖ₑ ^ p₀ * ‖f x‖ₑ ^ (p - p₀) = ‖f x‖ₑ ^ p := by
        rw [← ENNReal.rpow_add _ _ hne htop]
        congr 1
        ring
      calc ‖f x‖ₑ ^ p₀ * (ENNReal.ofReal (1 / (p - p₀)) * ‖f x‖ₑ ^ (p - p₀))
          = ENNReal.ofReal (1 / (p - p₀)) *
            (‖f x‖ₑ ^ p₀ * ‖f x‖ₑ ^ (p - p₀)) := by ring
        _ = ENNReal.ofReal (1 / (p - p₀)) * ‖f x‖ₑ ^ p := by rw [hadd]
    exact hpow

/-- The contribution of the small parts. -/
theorem marcinkiewicz_small_term {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℂ} (hf : Measurable f) {p₁ p : ℝ}
    (hp : 0 < p) (hlt : p < p₁) :
    (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ (p - 1 - p₁)) *
        ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) =
      ENNReal.ofReal (1 / (p₁ - p)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
  have hp₁ : (0 : ℝ) < p₁ := lt_trans hp hlt
  have hpp₁ : (0 : ℝ) < p₁ - p := by linarith
  have he : p - 1 - p₁ < -1 := by linarith
  rw [lintegral_level_swap_small hf hp₁]
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun x => ?_
  rcases eq_or_lt_of_le (norm_nonneg (f x)) with hzero | hpos
  · have hfx : ‖f x‖ = 0 := hzero.symm
    have hne : ‖f x‖ₑ = 0 := by
      rw [← ofReal_norm, hfx, ENNReal.ofReal_zero]
    rw [hne, ENNReal.zero_rpow_of_pos hp₁, ENNReal.zero_rpow_of_pos hp,
      zero_mul, mul_zero]
  · have hlevel : (∫⁻ s in Ioi ‖f x‖, ENNReal.ofReal (s ^ (p - 1 - p₁))) =
        ENNReal.ofReal (‖f x‖ ^ (p - p₁) / (p₁ - p)) := by
      rw [lintegral_Ioi_rpow he hpos]
      congr 1
      rw [show p - 1 - p₁ + 1 = p - p₁ by ring,
        show p - p₁ = -(p₁ - p) by ring, div_neg]
      ring
    rw [hlevel]
    have hne : ‖f x‖ₑ ≠ 0 := by
      simp only [ne_eq, enorm_eq_zero]
      intro hc
      rw [hc] at hpos
      simp at hpos
    have htop : ‖f x‖ₑ ≠ ⊤ := enorm_ne_top (x := f x)
    have hsplit : ENNReal.ofReal (‖f x‖ ^ (p - p₁) / (p₁ - p)) =
        ENNReal.ofReal (1 / (p₁ - p)) * ‖f x‖ₑ ^ (p - p₁) := by
      rw [show ‖f x‖ ^ (p - p₁) / (p₁ - p) =
          (1 / (p₁ - p)) * ‖f x‖ ^ (p - p₁) by ring,
        ENNReal.ofReal_mul (by positivity),
        ← ENNReal.ofReal_rpow_of_pos hpos, ofReal_norm]
    rw [hsplit]
    have hadd : ‖f x‖ₑ ^ p₁ * ‖f x‖ₑ ^ (p - p₁) = ‖f x‖ₑ ^ p := by
      rw [← ENNReal.rpow_add _ _ hne htop]
      congr 1
      ring
    calc ‖f x‖ₑ ^ p₁ * (ENNReal.ofReal (1 / (p₁ - p)) * ‖f x‖ₑ ^ (p - p₁))
        = ENNReal.ofReal (1 / (p₁ - p)) *
          (‖f x‖ₑ ^ p₁ * ‖f x‖ₑ ^ (p - p₁)) := by ring
      _ = ENNReal.ofReal (1 / (p₁ - p)) * ‖f x‖ₑ ^ p := by rw [hadd]

/-! ## Marcinkiewicz interpolation, diagonal case -/

theorem enorm_brsBigPart_rpow {α : Type*} {f : α → ℂ} {s r : ℝ} (hr : 0 < r)
    (x : α) :
    ‖brsBigPart s f x‖ₑ ^ r =
      {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ r) x := by
  by_cases hx : s < ‖f x‖
  · rw [Set.indicator_of_mem (show x ∈ {x : α | s < ‖f x‖} from hx)]
    congr 1
    simp [brsBigPart, hx]
  · rw [Set.indicator_of_notMem (show x ∉ {x : α | s < ‖f x‖} from hx)]
    have : brsBigPart s f x = 0 := by simp [brsBigPart, hx]
    rw [this]
    simp [ENNReal.zero_rpow_of_pos hr]

theorem enorm_brsSmallPart_rpow {α : Type*} {f : α → ℂ} {s r : ℝ} (hr : 0 < r)
    (x : α) :
    ‖brsSmallPart s f x‖ₑ ^ r =
      {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ r) x := by
  by_cases hx : s < ‖f x‖
  · have hnot : x ∉ {x : α | ‖f x‖ ≤ s} := by
      simp only [Set.mem_setOf_eq, not_le]
      exact hx
    rw [Set.indicator_of_notMem hnot]
    have : brsSmallPart s f x = 0 := by simp [brsSmallPart, hx]
    rw [this]
    simp [ENNReal.zero_rpow_of_pos hr]
  · have hmem : x ∈ {x : α | ‖f x‖ ≤ s} := not_lt.mp hx
    rw [Set.indicator_of_mem hmem]
    congr 1
    simp [brsSmallPart, hx]

/-- **Marcinkiewicz interpolation**, diagonal case: two weak-type bounds at
`p₀ < p₁` give a strong-type bound at every intermediate exponent. -/
theorem marcinkiewicz_diagonal {α β : Type*} [MeasurableSpace α]
    [MeasurableSpace β] {μ : Measure α} {ν : Measure β} [SFinite μ]
    {T : (α → ℂ) → β → ℂ} (hsub : IsSubadditiveOn T) {p₀ p₁ p A₀ A₁ : ℝ}
    (hp₀ : 0 < p₀) (hlt₀ : p₀ < p) (hlt₁ : p < p₁) (hA₀ : 0 ≤ A₀)
    (hA₁ : 0 ≤ A₁) (h₀ : HasWeakType T μ ν p₀ p₀ A₀)
    (h₁ : HasWeakType T μ ν p₁ p₁ A₁) {f : α → ℂ} (hf : Measurable f)
    (hTf : AEMeasurable (T f) ν) :
    (∫⁻ y, ‖T f y‖ₑ ^ p ∂ν) ≤
      ENNReal.ofReal p *
        (ENNReal.ofReal ((2 * A₀) ^ p₀ / (p - p₀)) *
            (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) +
          ENNReal.ofReal ((2 * A₁) ^ p₁ / (p₁ - p)) *
            ∫⁻ x, ‖f x‖ₑ ^ p ∂μ) := by
  have hp : (0 : ℝ) < p := lt_trans hp₀ hlt₀
  have hp₁ : (0 : ℝ) < p₁ := lt_trans hp hlt₁
  have hpp₀ : (0 : ℝ) < p - p₀ := by linarith
  have hpp₁ : (0 : ℝ) < p₁ - p := by linarith
  rw [lintegral_enorm_rpow_eq_distribution hTf hp]
  refine mul_le_mul' le_rfl ?_
  -- the pointwise bound on the level integrand
  have hpt : ∀ s : ℝ, s ∈ Ioi (0 : ℝ) →
      brsDistribution ν (T f) s * ENNReal.ofReal (s ^ (p - 1)) ≤
        ENNReal.ofReal ((2 * A₀) ^ p₀) *
            (ENNReal.ofReal (s ^ (p - 1 - p₀)) *
              ∫⁻ x, {x : α | s < ‖f x‖}.indicator
                (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) +
          ENNReal.ofReal ((2 * A₁) ^ p₁) *
            (ENNReal.ofReal (s ^ (p - 1 - p₁)) *
              ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
                (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) := by
    intro s hs
    have hspos : (0 : ℝ) < s := hs
    have hweak := brsDistribution_le_of_weakType hsub h₀ h₁ f (c := s) hspos
    have hexp₀ : p₀ / p₀ = 1 := div_self hp₀.ne'
    have hexp₁ : p₁ / p₁ = 1 := div_self hp₁.ne'
    rw [hexp₀, hexp₁, ENNReal.rpow_one, ENNReal.rpow_one] at hweak
    have hbig : (∫⁻ x, ‖brsBigPart s f x‖ₑ ^ p₀ ∂μ) =
        ∫⁻ x, {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ p₀) x ∂μ :=
      lintegral_congr fun x => enorm_brsBigPart_rpow hp₀ x
    have hsmall : (∫⁻ x, ‖brsSmallPart s f x‖ₑ ^ p₁ ∂μ) =
        ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ p₁) x ∂μ :=
      lintegral_congr fun x => enorm_brsSmallPart_rpow hp₁ x
    rw [hbig, hsmall] at hweak
    have hconst : ∀ (A e : ℝ), 0 ≤ A → 0 < e →
        (ENNReal.ofReal (A / (s / 2))) ^ e * ENNReal.ofReal (s ^ (p - 1)) =
          ENNReal.ofReal ((2 * A) ^ e) * ENNReal.ofReal (s ^ (p - 1 - e)) := by
      intro A e hAnn he
      have hval : A / (s / 2) = (2 * A) * s⁻¹ := by
        field_simp
      have hreal : ((2 * A) * s⁻¹) ^ e * s ^ (p - 1) =
          (2 * A) ^ e * s ^ (p - 1 - e) := by
        rw [Real.mul_rpow (by positivity) (by positivity)]
        have hinv : (s⁻¹ : ℝ) ^ e = s ^ (-e) := by
          rw [Real.inv_rpow hspos.le, ← Real.rpow_neg hspos.le]
        rw [hinv, mul_assoc, ← Real.rpow_add hspos]
        congr 2
        ring
      rw [hval, ENNReal.ofReal_rpow_of_nonneg (by positivity) he.le,
        ← ENNReal.ofReal_mul (by positivity), hreal,
        ENNReal.ofReal_mul (by positivity)]
    calc brsDistribution ν (T f) s * ENNReal.ofReal (s ^ (p - 1))
        ≤ ((ENNReal.ofReal (A₀ / (s / 2))) ^ p₀ *
              ∫⁻ x, {x : α | s < ‖f x‖}.indicator
                (fun x => ‖f x‖ₑ ^ p₀) x ∂μ +
            (ENNReal.ofReal (A₁ / (s / 2))) ^ p₁ *
              ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
                (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) *
            ENNReal.ofReal (s ^ (p - 1)) := mul_le_mul' hweak le_rfl
      _ = ((ENNReal.ofReal (A₀ / (s / 2))) ^ p₀ *
              ENNReal.ofReal (s ^ (p - 1))) *
            (∫⁻ x, {x : α | s < ‖f x‖}.indicator
              (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) +
            ((ENNReal.ofReal (A₁ / (s / 2))) ^ p₁ *
              ENNReal.ofReal (s ^ (p - 1))) *
            (∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
              (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) := by ring
      _ = ENNReal.ofReal ((2 * A₀) ^ p₀) *
            (ENNReal.ofReal (s ^ (p - 1 - p₀)) *
              ∫⁻ x, {x : α | s < ‖f x‖}.indicator
                (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) +
            ENNReal.ofReal ((2 * A₁) ^ p₁) *
            (ENNReal.ofReal (s ^ (p - 1 - p₁)) *
              ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
                (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) := by
          rw [hconst A₀ p₀ hA₀ hp₀, hconst A₁ p₁ hA₁ hp₁]
          ring
  -- measurability of the two level functions
  have hBmeas : Measurable fun s : ℝ =>
      ∫⁻ x, {x : α | s < ‖f x‖}.indicator (fun x => ‖f x‖ₑ ^ p₀) x ∂μ := by
    have hset : MeasurableSet {z : ℝ × α | z.1 < ‖f z.2‖} :=
      measurableSet_lt measurable_fst ((hf.comp measurable_snd).norm)
    exact ((((hf.comp measurable_snd).enorm).pow_const p₀).indicator
      hset).lintegral_prod_right'
  have hSmeas : Measurable fun s : ℝ =>
      ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator (fun x => ‖f x‖ₑ ^ p₁) x ∂μ := by
    have hset : MeasurableSet {z : ℝ × α | ‖f z.2‖ ≤ z.1} :=
      measurableSet_le ((hf.comp measurable_snd).norm) measurable_fst
    exact ((((hf.comp measurable_snd).enorm).pow_const p₁).indicator
      hset).lintegral_prod_right'
  calc (∫⁻ s in Ioi (0 : ℝ),
        brsDistribution ν (T f) s * ENNReal.ofReal (s ^ (p - 1)))
      ≤ ∫⁻ s in Ioi (0 : ℝ),
          (ENNReal.ofReal ((2 * A₀) ^ p₀) *
              (ENNReal.ofReal (s ^ (p - 1 - p₀)) *
                ∫⁻ x, {x : α | s < ‖f x‖}.indicator
                  (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) +
            ENNReal.ofReal ((2 * A₁) ^ p₁) *
              (ENNReal.ofReal (s ^ (p - 1 - p₁)) *
                ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
                  (fun x => ‖f x‖ₑ ^ p₁) x ∂μ)) :=
        setLIntegral_mono' measurableSet_Ioi hpt
    _ = ENNReal.ofReal ((2 * A₀) ^ p₀) *
          (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ (p - 1 - p₀)) *
            ∫⁻ x, {x : α | s < ‖f x‖}.indicator
              (fun x => ‖f x‖ₑ ^ p₀) x ∂μ) +
        ENNReal.ofReal ((2 * A₁) ^ p₁) *
          (∫⁻ s in Ioi (0 : ℝ), ENNReal.ofReal (s ^ (p - 1 - p₁)) *
            ∫⁻ x, {x : α | ‖f x‖ ≤ s}.indicator
              (fun x => ‖f x‖ₑ ^ p₁) x ∂μ) := by
        have hmeas0 : AEMeasurable (fun s : ℝ =>
            ENNReal.ofReal ((2 * A₀) ^ p₀) *
              (ENNReal.ofReal (s ^ (p - 1 - p₀)) *
                ∫⁻ x, {x : α | s < ‖f x‖}.indicator
                  (fun x => ‖f x‖ₑ ^ p₀) x ∂μ))
            (volume.restrict (Ioi (0 : ℝ))) := by
          refine Measurable.aemeasurable ?_
          refine Measurable.const_mul ?_ _
          exact (ENNReal.measurable_ofReal.comp
            (measurable_id.pow_const _)).mul hBmeas
        rw [lintegral_add_left' hmeas0,
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ = ENNReal.ofReal ((2 * A₀) ^ p₀) *
          (ENNReal.ofReal (1 / (p - p₀)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ) +
        ENNReal.ofReal ((2 * A₁) ^ p₁) *
          (ENNReal.ofReal (1 / (p₁ - p)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ) := by
        rw [marcinkiewicz_big_term hf hp₀ hlt₀,
          marcinkiewicz_small_term hf hp hlt₁]
    _ = ENNReal.ofReal ((2 * A₀) ^ p₀ / (p - p₀)) * (∫⁻ x, ‖f x‖ₑ ^ p ∂μ) +
        ENNReal.ofReal ((2 * A₁) ^ p₁ / (p₁ - p)) * ∫⁻ x, ‖f x‖ₑ ^ p ∂μ := by
        rw [← mul_assoc, ← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity)]
        congr 3 <;> field_simp


/-! ## Minkowski's integral inequality

Mathlib has the two-term version (`ENNReal.lintegral_Lp_add_le`) but not the
continuous one, which is what off-diagonal interpolation needs. -/

/-- **Minkowski's integral inequality** in `ℝ≥0∞`. -/
theorem lintegral_rpow_lintegral_le {α β : Type*} [MeasurableSpace α]
    [MeasurableSpace β] {μ : Measure α} {ν : Measure β} [SFinite μ] [SFinite ν]
    {r : ℝ} (hr : 1 ≤ r) {F : α → β → ENNReal}
    (hF : Measurable (Function.uncurry F))
    (hfin : (∫⁻ x, (∫⁻ y, F x y ∂ν) ^ r ∂μ) ≠ ⊤) :
    (∫⁻ x, (∫⁻ y, F x y ∂ν) ^ r ∂μ) ^ (1 / r) ≤
      ∫⁻ y, (∫⁻ x, F x y ^ r ∂μ) ^ (1 / r) ∂ν := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  rcases eq_or_lt_of_le hr with hr1 | hr1
  · -- `r = 1` is Tonelli
    have hrr : r = 1 := hr1.symm
    subst hrr
    simp only [ENNReal.rpow_one, div_one]
    exact le_of_eq (lintegral_lintegral_swap hF.aemeasurable)
  set G : α → ENNReal := fun x => ∫⁻ y, F x y ∂ν with hGdef
  have hGmeas : Measurable G := hF.lintegral_prod_right'
  set I : ENNReal := ∫⁻ x, G x ^ r ∂μ with hIdef
  set J : ENNReal := ∫⁻ y, (∫⁻ x, F x y ^ r ∂μ) ^ (1 / r) ∂ν with hJdef
  rcases eq_or_ne I 0 with hI0 | hIne
  · rw [hI0, ENNReal.zero_rpow_of_pos (by positivity)]
    simp
  · have hIpos : 0 < I := pos_iff_ne_zero.mpr hIne
    -- `r > 1`
    have hq : r.HolderConjugate (Real.conjExponent r) :=
      Real.HolderConjugate.conjExponent hr1
    set q : ℝ := Real.conjExponent r with hqdef
    have hq0 : (0 : ℝ) < q := hq.symm.pos
    have hinvsum : 1 / r + 1 / q = 1 := by
      have h1 := hq.one_div_add_one_div
      simpa using h1
    have hqr : (r - 1) * q = r := by
      have hr' : (1 : ℝ) / r = 1 - 1 / q := by linarith
      field_simp at hr' ⊢
      nlinarith [hr', hq0, hr0]
    -- almost every `G x` is finite
    have hGfin : ∀ᵐ x ∂μ, G x ≠ ⊤ := by
      have hlt := ae_lt_top (hGmeas.pow_const r) hfin
      filter_upwards [hlt] with x hx
      intro hcon
      rw [hcon, ENNReal.top_rpow_of_pos hr0] at hx
      exact absurd hx (by simp)
    -- split the power and move the constant inside
    have hstep1 : I = ∫⁻ x, ∫⁻ y, F x y * G x ^ (r - 1) ∂ν ∂μ := by
      rw [hIdef]
      refine lintegral_congr_ae ?_
      filter_upwards [hGfin] with x hx
      have hconst : (∫⁻ y, F x y * G x ^ (r - 1) ∂ν) =
          G x * G x ^ (r - 1) := by
        rw [lintegral_mul_const' _ _
          (ENNReal.rpow_ne_top_of_nonneg (by linarith) hx), hGdef]
      rw [hconst]
      rcases eq_or_ne (G x) 0 with hz | hz
      · rw [hz, ENNReal.zero_rpow_of_pos hr0,
          ENNReal.zero_rpow_of_pos (by linarith : (0:ℝ) < r - 1), mul_zero]
      · calc G x ^ r = G x ^ (1 + (r - 1)) := by
              congr 1
              ring
          _ = G x ^ (1 : ℝ) * G x ^ (r - 1) := ENNReal.rpow_add _ _ hz hx
          _ = G x * G x ^ (r - 1) := by rw [ENNReal.rpow_one]
    -- Tonelli
    have hjoint : Measurable fun z : α × β => F z.1 z.2 * G z.1 ^ (r - 1) := by
      exact hF.mul ((hGmeas.comp measurable_fst).pow_const _)
    have hstep2 : (∫⁻ x, ∫⁻ y, F x y * G x ^ (r - 1) ∂ν ∂μ) =
        ∫⁻ y, ∫⁻ x, F x y * G x ^ (r - 1) ∂μ ∂ν :=
      lintegral_lintegral_swap hjoint.aemeasurable
    -- Hölder in `x`, for each `y`
    have hstep3 : ∀ y : β, (∫⁻ x, F x y * G x ^ (r - 1) ∂μ) ≤
        (∫⁻ x, F x y ^ r ∂μ) ^ (1 / r) * I ^ (1 / q) := by
      intro y
      have hmeas1 : AEMeasurable (fun x => F x y) μ :=
        (hF.comp (measurable_id.prodMk measurable_const)).aemeasurable
      have hmeas2 : AEMeasurable (fun x => G x ^ (r - 1)) μ :=
        (hGmeas.pow_const _).aemeasurable
      have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hq hmeas1 hmeas2
      simp only [Pi.mul_apply] at hholder
      refine le_trans hholder (mul_le_mul' le_rfl (le_of_eq ?_))
      congr 1
      rw [hIdef]
      refine lintegral_congr fun x => ?_
      rw [← ENNReal.rpow_mul, hqr]
    -- assemble
    have hIle : I ≤ J * I ^ (1 / q) := by
      conv_lhs => rw [hstep1, hstep2]
      rw [hJdef, ← lintegral_mul_const' _ _
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) hfin)]
      exact lintegral_mono hstep3
    -- cancel the common factor
    have hIfin : I ≠ ⊤ := hfin
    have hIq : I ^ (1 / q) ≠ 0 := by
      simp only [ne_eq, ENNReal.rpow_eq_zero_iff, not_or]
      refine ⟨fun h => absurd h.1 (ne_of_gt hIpos), fun h => ?_⟩
      exact absurd h.1 hIfin
    have hIqtop : I ^ (1 / q) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hIfin
    have hsplitI : I = I ^ (1 / r) * I ^ (1 / q) := by
      rw [← ENNReal.rpow_add _ _ (ne_of_gt hIpos) hIfin, hinvsum,
        ENNReal.rpow_one]
    refine (ENNReal.mul_le_mul_iff_left hIq hIqtop).mp ?_
    rw [← hsplitI]
    exact hIle


/-! ## The truncated singular kernel `h_k`

BRS write the near part of `R_2^±` as a convolution against the kernel
`|y|^{-1/2}` truncated to the scale `2^{-k}` of the radius.  All that is
needed of it downstream is the size of its `L^a` norms. -/

/-- The kernel `h_k(y) = y^{-1/2}` truncated to `(0, 2^{-k}]`. -/
def brsTruncKernel (k : ℕ) (y : ℝ) : ℝ :=
  (Ioc (0 : ℝ) (2 ^ (-(k : ℝ)))).indicator (fun y => y ^ (-(1 / 2) : ℝ)) y

theorem brsTruncKernel_nonneg (k : ℕ) (y : ℝ) : 0 ≤ brsTruncKernel k y := by
  rw [brsTruncKernel]
  by_cases hy : y ∈ Ioc (0 : ℝ) (2 ^ (-(k : ℝ)))
  · rw [Set.indicator_of_mem hy]
    exact Real.rpow_nonneg hy.1.le _
  · rw [Set.indicator_of_notMem hy]

theorem measurable_brsTruncKernel (k : ℕ) : Measurable (brsTruncKernel k) := by
  refine Measurable.indicator ?_ measurableSet_Ioc
  fun_prop

/-- **The `L^a` norm of the truncated kernel.**  It is finite exactly when
`a < 2`, and then it is comparable to `2^{-k(1/a - 1/2)}` raised to `a`. -/
theorem lintegral_brsTruncKernel_rpow (k : ℕ) {a : ℝ} (ha : 0 < a)
    (ha2 : a < 2) :
    (∫⁻ y, ENNReal.ofReal (brsTruncKernel k y) ^ a) =
      ENNReal.ofReal ((2 ^ (-(k : ℝ)) : ℝ) ^ (1 - a / 2) / (1 - a / 2)) := by
  set T : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hT
  have hTpos : 0 < T := Real.rpow_pos_of_pos (by norm_num) _
  have he : (-1 : ℝ) < -(a / 2) := by linarith
  have hstep : ∀ y : ℝ, ENNReal.ofReal (brsTruncKernel k y) ^ a =
      (Ioc (0 : ℝ) T).indicator
        (fun y => ENNReal.ofReal (y ^ (-(a / 2) : ℝ))) y := by
    intro y
    by_cases hy : y ∈ Ioc (0 : ℝ) T
    · rw [Set.indicator_of_mem hy]
      have hval : brsTruncKernel k y = y ^ (-(1 / 2) : ℝ) := by
        rw [brsTruncKernel, Set.indicator_of_mem hy]
      rw [hval, ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hy.1 _),
        ← Real.rpow_mul hy.1.le]
      congr 2
      ring
    · rw [Set.indicator_of_notMem hy]
      have hval : brsTruncKernel k y = 0 := by
        rw [brsTruncKernel, Set.indicator_of_notMem hy]
      rw [hval, ENNReal.ofReal_zero, ENNReal.zero_rpow_of_pos ha]
  rw [lintegral_congr hstep, lintegral_indicator measurableSet_Ioc]
  rw [← setLIntegral_congr (Ioo_ae_eq_Ioc (a := (0 : ℝ)) (b := T))]
  rw [lintegral_Ioo_rpow he hTpos]
  congr 2
  · ring
  · ring

/-- The `L¹` norm of the truncated kernel is `2 · 2^{-k/2}`. -/
theorem lintegral_brsTruncKernel (k : ℕ) :
    (∫⁻ y, ENNReal.ofReal (brsTruncKernel k y)) =
      ENNReal.ofReal (2 * (2 : ℝ) ^ (-(k : ℝ) / 2)) := by
  have h := lintegral_brsTruncKernel_rpow k (a := 1) one_pos (by norm_num)
  simp only [ENNReal.rpow_one] at h
  rw [h]
  congr 1
  rw [show (1 : ℝ) - 1 / 2 = 1 / 2 by norm_num,
    ← Real.rpow_mul (by norm_num : (0:ℝ) ≤ 2),
    show -(k : ℝ) * (1 / 2) = -(k : ℝ) / 2 by ring]
  ring


/-! ## Hölder for a convolution against an `L^a` kernel

The `m = 0` term of the BRS decomposition is a convolution against the
truncated singular kernel, and there the whole `t`-supremum is controlled by a
single Hölder estimate, uniformly in the translation. -/

/-- **Hölder's inequality for a convolution.**  The bound is uniform in the
translation, so it also bounds the supremum over `t`. -/
theorem enorm_convolution_le_holder {a p : ℝ} (hconj : a.HolderConjugate p)
    {h : ℝ → ℝ} (hh : Measurable h) {G : ℝ → ℂ} (hG : Measurable G) (x : ℝ) :
    ‖∫ y : ℝ, (h y : ℂ) * G (x - y)‖ₑ ≤
      (∫⁻ y : ℝ, ‖h y‖ₑ ^ a) ^ (1 / a) * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) := by
  have hbase : ‖∫ y : ℝ, (h y : ℂ) * G (x - y)‖ₑ ≤
      ∫⁻ y : ℝ, ‖h y‖ₑ * ‖G (x - y)‖ₑ := by
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun y => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real, ofReal_norm]
  refine le_trans hbase ?_
  have hmeas1 : AEMeasurable (fun y : ℝ => ‖h y‖ₑ) volume := hh.enorm.aemeasurable
  have hmeas2 : AEMeasurable (fun y : ℝ => ‖G (x - y)‖ₑ) volume :=
    ((hG.comp (measurable_const.sub measurable_id)).enorm).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure ℝ)
    hconj hmeas1 hmeas2
  simp only [Pi.mul_apply] at hholder
  refine le_trans hholder (le_of_eq ?_)
  congr 2
  exact lintegral_sub_left_eq_self (fun z => ‖G z‖ₑ ^ p) x

/-- The same bound for the supremum over a set of translations. -/
theorem iSup_enorm_convolution_le_holder {a p : ℝ} (hconj : a.HolderConjugate p)
    {h : ℝ → ℝ} (hh : Measurable h) {G : ℝ → ℂ} (hG : Measurable G)
    (S : Set ℝ) :
    (⨆ x ∈ S, ‖∫ y : ℝ, (h y : ℂ) * G (x - y)‖ₑ) ≤
      (∫⁻ y : ℝ, ‖h y‖ₑ ^ a) ^ (1 / a) * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) :=
  iSup₂_le fun x _ => enorm_convolution_le_holder hconj hh hG x


/-! ## The dyadic radius windows `I_k`

BRS localize the radius to `I_0 = [1/2, 4/3]` and `I_k = [2^{-k-1}, 2^{-k}]`.
Only the dyadic shape matters downstream, so we use the half-open windows,
which are pairwise disjoint. -/

/-- The dyadic radius window `I_k = (2^{-k-1}, 2^{-k}]`. -/
def brsRadiusWindow (k : ℕ) : Set ℝ :=
  Ioc ((2 : ℝ) ^ (-(k : ℝ) - 1)) ((2 : ℝ) ^ (-(k : ℝ)))

theorem measurableSet_brsRadiusWindow (k : ℕ) :
    MeasurableSet (brsRadiusWindow k) := measurableSet_Ioc

theorem brsRadiusWindow_pos {k : ℕ} {r : ℝ} (hr : r ∈ brsRadiusWindow k) :
    0 < r :=
  lt_of_lt_of_le (Real.rpow_pos_of_pos (by norm_num) _) hr.1.le

theorem brsRadiusWindow_le_one {k : ℕ} {r : ℝ} (hr : r ∈ brsRadiusWindow k) :
    r ≤ 1 := by
  refine le_trans hr.2 ?_
  rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
  exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_nonpos.mpr (Nat.cast_nonneg k))

/-- The windows are pairwise disjoint. -/
theorem brsRadiusWindow_disjoint {k l : ℕ} (hkl : k ≠ l) :
    Disjoint (brsRadiusWindow k) (brsRadiusWindow l) := by
  -- it suffices to treat `k < l`
  have key : ∀ m n : ℕ, m < n →
      Disjoint (brsRadiusWindow m) (brsRadiusWindow n) := by
    intro m n hmn
    refine Set.disjoint_left.mpr fun r hrm hrn => ?_
    have h1 : r ≤ (2 : ℝ) ^ (-(n : ℝ)) := hrn.2
    have h2 : (2 : ℝ) ^ (-(m : ℝ) - 1) < r := hrm.1
    have h3 : (2 : ℝ) ^ (-(n : ℝ)) ≤ (2 : ℝ) ^ (-(m : ℝ) - 1) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      have : (m : ℝ) + 1 ≤ (n : ℝ) := by exact_mod_cast hmn
      linarith
    linarith
  rcases lt_or_gt_of_ne hkl with h | h
  · exact key k l h
  · exact (key l k h).symm

/-! ## A crude bound for a power integral away from the origin -/

/-- On an interval bounded away from `0` the integral of `r ^ e` is at most the
length times the larger endpoint value. -/
theorem lintegral_Ioc_rpow_le {A B e : ℝ} (hA : 0 < A) :
    (∫⁻ r in Ioc A B, ENNReal.ofReal (r ^ e)) ≤
      ENNReal.ofReal (max (A ^ e) (B ^ e)) * ENNReal.ofReal (B - A) := by
  have hbd : ∀ r ∈ Ioc A B, ENNReal.ofReal (r ^ e) ≤
      ENNReal.ofReal (max (A ^ e) (B ^ e)) := by
    intro r hr
    refine ENNReal.ofReal_le_ofReal ?_
    rcases le_or_gt 0 e with he | he
    · exact le_trans (Real.rpow_le_rpow (hA.trans hr.1).le hr.2 he) (le_max_right _ _)
    · exact le_trans (Real.rpow_le_rpow_of_nonpos hA hr.1.le he.le)
        (le_max_left _ _)
  calc (∫⁻ r in Ioc A B, ENNReal.ofReal (r ^ e))
      ≤ ∫⁻ _ in Ioc A B, ENNReal.ofReal (max (A ^ e) (B ^ e)) :=
        setLIntegral_mono' measurableSet_Ioc hbd
    _ = ENNReal.ofReal (max (A ^ e) (B ^ e)) * volume (Ioc A B) :=
        setLIntegral_const _ _
    _ = ENNReal.ofReal (max (A ^ e) (B ^ e)) * ENNReal.ofReal (B - A) := by
        rw [Real.volume_Ioc]


/-! ## (5.8): the terms `𝒜_{k,0}`

BRS set `𝒜_{k,0} f₀(r,t) = r^{-1/2} 1_{I_k}(r) (h_k * u_k * f₀)(t - r)`.  The
low-frequency factor `u_k` is an `L¹`-normalised dilate, so
`‖u_k * f₀‖_p ≤ ‖f₀‖_p` by Young's inequality
(`lintegral_convolution_rpow_le`); everything after that depends on `u_k * f₀`
only through its `L^p` norm, so we carry it as a single function `G`. -/

/-- `𝒜_{k,0}`, as a function of the radius, with the low-frequency factor
already absorbed into `G`. -/
def brsAZero (k : ℕ) (G : ℝ → ℂ) (r : ℝ) : ENNReal :=
  (brsRadiusWindow k).indicator
    (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      ⨆ t ∈ Icc (1 : ℝ) 2,
        ‖∫ y : ℝ, (brsTruncKernel k y : ℂ) * G (t - r - y)‖ₑ) r

theorem enorm_brsTruncKernel (k : ℕ) (y : ℝ) :
    ‖brsTruncKernel k y‖ₑ = ENNReal.ofReal (brsTruncKernel k y) := by
  rw [← ofReal_norm, Real.norm_of_nonneg (brsTruncKernel_nonneg k y)]

/-- The `L^a` norm of `h_k`, as it appears in the `m = 0` estimate. -/
def brsTruncNorm (k : ℕ) (a : ℝ) : ENNReal :=
  ENNReal.ofReal ((((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - a / 2)) / (1 - a / 2)) ^ (1 / a)

/-- **The pointwise bound for `𝒜_{k,0}`.**  Hölder against the truncated
kernel is uniform in `t`, so it also bounds the maximal function. -/
theorem brsAZero_le {k : ℕ} {a p : ℝ} (hconj : a.HolderConjugate p)
    (ha2 : a < 2) {G : ℝ → ℂ} (hG : Measurable G) (r : ℝ) :
    brsAZero k G r ≤
      (brsRadiusWindow k).indicator
          (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ))) r *
        (brsTruncNorm k a * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p)) := by
  have ha0 : (0 : ℝ) < a := hconj.pos
  have hnorm : (∫⁻ y : ℝ, ‖brsTruncKernel k y‖ₑ ^ a) =
      ENNReal.ofReal ((((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - a / 2)) / (1 - a / 2)) := by
    rw [← lintegral_brsTruncKernel_rpow k ha0 ha2]
    exact lintegral_congr fun y => by rw [enorm_brsTruncKernel]
  by_cases hr : r ∈ brsRadiusWindow k
  · rw [brsAZero, Set.indicator_of_mem hr, Set.indicator_of_mem hr]
    refine mul_le_mul' le_rfl ?_
    refine iSup₂_le fun t _ => ?_
    have h := enorm_convolution_le_holder hconj (measurable_brsTruncKernel k)
      hG (t - r)
    rw [hnorm] at h
    exact h
  · rw [brsAZero, Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
      zero_mul]


/-! ## The radial `L^q(r dr)` norm of a single `𝒜_{k,0}` -/

/-- The radial integral of the `q`-th power of `𝒜_{k,0}`. -/
theorem lintegral_brsAZero_rpow_le {k : ℕ} {a p q : ℝ}
    (hconj : a.HolderConjugate p) (ha2 : a < 2) (hq : 0 < q) {G : ℝ → ℂ}
    (hG : Measurable G) :
    (∫⁻ r : ℝ, brsAZero k G r ^ q * ENNReal.ofReal r) ≤
      (brsTruncNorm k a * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p)) ^ q *
        ∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2)) := by
  set M : ENNReal := brsTruncNorm k a * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) with hM
  have hmeas : Measurable fun r : ℝ =>
      (brsRadiusWindow k).indicator
        (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r := by
    refine Measurable.indicator ?_ (measurableSet_brsRadiusWindow k)
    fun_prop
  have hpt : ∀ r : ℝ, brsAZero k G r ^ q * ENNReal.ofReal r ≤
      M ^ q * (brsRadiusWindow k).indicator
        (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r := by
    intro r
    by_cases hr : r ∈ brsRadiusWindow k
    · have hrpos : 0 < r := brsRadiusWindow_pos hr
      have hb := brsAZero_le (k := k) hconj ha2 hG r
      rw [Set.indicator_of_mem hr] at hb
      have hstep : brsAZero k G r ^ q ≤
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * M) ^ q :=
        ENNReal.rpow_le_rpow hb hq.le
      have hexp : (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * M) ^ q *
          ENNReal.ofReal r =
          M ^ q * ENNReal.ofReal (r ^ (1 - q / 2)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (M ^ q), mul_assoc]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
              rw [Real.rpow_one]
          _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
          _ = r ^ (1 - q / 2) := by
              congr 1
              ring
      rw [Set.indicator_of_mem hr, ← hexp]
      exact mul_le_mul' hstep le_rfl
    · rw [brsAZero, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, brsAZero k G r ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, M ^ q * (brsRadiusWindow k).indicator
          (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r := lintegral_mono hpt
    _ = M ^ q * ∫⁻ r : ℝ, (brsRadiusWindow k).indicator
          (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r :=
        lintegral_const_mul _ hmeas
    _ = M ^ q * ∫⁻ r in brsRadiusWindow k,
          ENNReal.ofReal (r ^ (1 - q / 2)) := by
        rw [lintegral_indicator (measurableSet_brsRadiusWindow k)]


/-! ## The dyadic size of the two factors in the `m = 0` estimate -/

/-- The weight integral over a dyadic radius window. -/
theorem lintegral_brsRadiusWindow_rpow_le (k : ℕ) (e : ℝ) :
    (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ e)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |e| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (e + 1)) := by
  set B : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hB
  set A : ℝ := (2 : ℝ) ^ (-(k : ℝ) - 1) with hA
  have hBpos : 0 < B := Real.rpow_pos_of_pos (by norm_num) _
  have hApos : 0 < A := Real.rpow_pos_of_pos (by norm_num) _
  have hunfold : brsRadiusWindow k = Ioc A B := by
    rw [brsRadiusWindow, hA, hB]
  have hhalf : A = B * (2 : ℝ) ^ (-1 : ℝ) := by
    rw [hA, hB, ← Real.rpow_add (by norm_num),
      show -(k : ℝ) + (-1 : ℝ) = -(k : ℝ) - 1 by ring]
  have habsnn : (0 : ℝ) ≤ (2 : ℝ) ^ |e| :=
    (Real.rpow_pos_of_pos (by norm_num) _).le
  have h1e : (1 : ℝ) ≤ (2 : ℝ) ^ |e| := by
    rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (abs_nonneg e)
  have hBenn : (0 : ℝ) ≤ B ^ e := Real.rpow_nonneg hBpos.le e
  have hAe : A ^ e ≤ (2 : ℝ) ^ |e| * B ^ e := by
    have hx : A ^ e = B ^ e * (2 : ℝ) ^ (-e) := by
      rw [hhalf, Real.mul_rpow hBpos.le
          (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) _).le,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2) (-1 : ℝ) e,
        show (-1 : ℝ) * e = -e by ring]
    rw [hx, mul_comm]
    refine mul_le_mul_of_nonneg_right ?_ hBenn
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_abs e)
  have hBe : B ^ e ≤ (2 : ℝ) ^ |e| * B ^ e := by nlinarith
  have hAhalf : A ≤ B := by
    rw [hA, hB]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
  calc (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ e))
      = ∫⁻ r in Ioc A B, ENNReal.ofReal (r ^ e) := by rw [hunfold]
    _ ≤ ENNReal.ofReal (max (A ^ e) (B ^ e)) * ENNReal.ofReal (B - A) :=
        lintegral_Ioc_rpow_le hApos
    _ ≤ ENNReal.ofReal ((2 : ℝ) ^ |e| * B ^ e) * ENNReal.ofReal B :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal (max_le hAe hBe))
          (ENNReal.ofReal_le_ofReal (by linarith))
    _ = ENNReal.ofReal ((2 : ℝ) ^ |e| * B ^ (e + 1)) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg habsnn hBenn)]
        congr 1
        rw [Real.rpow_add hBpos, Real.rpow_one]
        ring

/-- The `q`-th power of the kernel norm. -/
theorem brsTruncNorm_rpow (k : ℕ) {a q : ℝ} (ha : 0 < a) :
    brsTruncNorm k a ^ q =
      ENNReal.ofReal ((((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - a / 2)) / (1 - a / 2)) ^
        (q / a) := by
  rw [brsTruncNorm, ← ENNReal.rpow_mul]
  congr 1
  field_simp


/-! ## The dyadic gain of the `m = 0` terms -/

/-- The constant of the `m = 0` estimate. -/
def brsAZeroConst (a q : ℝ) : ℝ :=
  (1 - a / 2) ^ (-(q / a)) * (2 : ℝ) ^ |1 - q / 2|

theorem brsAZeroConst_pos {a q : ℝ} (ha2 : a < 2) : 0 < brsAZeroConst a q := by
  have h1 : (0 : ℝ) < 1 - a / 2 := by linarith
  rw [brsAZeroConst]
  exact mul_pos (Real.rpow_pos_of_pos h1 _) (Real.rpow_pos_of_pos (by norm_num) _)

/-- **The `m = 0` estimate at a single scale.**  The gain is
`2^{-k(2 - q/p)}`, which is summable exactly when `q < 2p`. -/
theorem lintegral_brsAZero_rpow_le' {k : ℕ} {a p q : ℝ}
    (hconj : a.HolderConjugate p) (ha2 : a < 2) (hq : 0 < q) {G : ℝ → ℂ}
    (hG : Measurable G) :
    (∫⁻ r : ℝ, brsAZero k G r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal (brsAZeroConst a q *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (2 - q / p)) *
        (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (q / p) := by
  have ha0 : (0 : ℝ) < a := hconj.pos
  have hp0 : (0 : ℝ) < p := hconj.symm.pos
  have hinv : 1 / a + 1 / p = 1 := by
    have h := hconj.one_div_add_one_div
    simpa using h
  have h1a : 1 / a = 1 - 1 / p := by linarith
  have hqa : q / a = q - q / p := by
    have h : q / a = q * (1 / a) := by ring
    rw [h, h1a]
    ring
  have hhalfa : (0 : ℝ) < 1 - a / 2 := by linarith
  set T : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hT
  have hTpos : 0 < T := Real.rpow_pos_of_pos (by norm_num) _
  set Np : ENNReal := (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) with hNp
  -- the two factors
  have hfactor : brsTruncNorm k a ^ q =
      ENNReal.ofReal ((T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a)) := by
    rw [brsTruncNorm_rpow k ha0,
      ENNReal.ofReal_rpow_of_pos (by positivity)]
  have hNpq : Np ^ q = (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (q / p) := by
    rw [hNp, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  -- the arithmetic of the exponents
  have hconstid : (T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a) *
      ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1)) =
      brsAZeroConst a q * T ^ (2 - q / p) := by
    have hsplit : (T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a) =
        T ^ ((1 - a / 2) * (q / a)) * (1 - a / 2) ^ (-(q / a)) := by
      rw [Real.div_rpow (Real.rpow_nonneg hTpos.le _) hhalfa.le,
        ← Real.rpow_mul hTpos.le, Real.rpow_neg hhalfa.le, div_eq_mul_inv]
    have hexp : (1 - a / 2) * (q / a) + (1 - q / 2 + 1) = 2 - q / p := by
      have hstep : (1 - a / 2) * (q / a) = q / a - q / 2 := by
        field_simp
      rw [hstep, hqa]
      ring
    rw [hsplit, brsAZeroConst]
    calc T ^ ((1 - a / 2) * (q / a)) * (1 - a / 2) ^ (-(q / a)) *
          ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1))
        = (1 - a / 2) ^ (-(q / a)) * (2 : ℝ) ^ |1 - q / 2| *
            (T ^ ((1 - a / 2) * (q / a)) * T ^ (1 - q / 2 + 1)) := by ring
      _ = (1 - a / 2) ^ (-(q / a)) * (2 : ℝ) ^ |1 - q / 2| * T ^ (2 - q / p) := by
          rw [← Real.rpow_add hTpos, hexp]
  calc (∫⁻ r : ℝ, brsAZero k G r ^ q * ENNReal.ofReal r)
      ≤ (brsTruncNorm k a * Np) ^ q *
          ∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2)) :=
        lintegral_brsAZero_rpow_le hconj ha2 hq hG
    _ = brsTruncNorm k a ^ q *
          (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2))) *
          Np ^ q := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le]
        ring
    _ ≤ brsTruncNorm k a ^ q *
          ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1)) *
          Np ^ q := by
        refine mul_le_mul' (mul_le_mul' le_rfl ?_) le_rfl
        exact lintegral_brsRadiusWindow_rpow_le k (1 - q / 2)
    _ = ENNReal.ofReal (brsAZeroConst a q * T ^ (2 - q / p)) *
          (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (q / p) := by
        rw [hfactor, hNpq, ← ENNReal.ofReal_mul (by positivity), hconstid]


/-! ## The `m = 0` terms have disjoint radial supports

Each `𝒜_{k,0}` lives on the dyadic window `I_k`, so summing in `k` costs
nothing pointwise: at every radius at most one term is nonzero. -/

theorem brsAZero_eq_zero_of_notMem {k : ℕ} {G : ℝ → ℂ} {r : ℝ}
    (hr : r ∉ brsRadiusWindow k) : brsAZero k G r = 0 := by
  rw [brsAZero, Set.indicator_of_notMem hr]

/-- The `q`-th power of the sum is the sum of the `q`-th powers. -/
theorem tsum_brsAZero_rpow {G : ℝ → ℂ} {q : ℝ} (hq : 0 < q) (r : ℝ) :
    (∑' k : ℕ, brsAZero k G r) ^ q = ∑' k : ℕ, brsAZero k G r ^ q := by
  by_cases h : ∃ k : ℕ, r ∈ brsRadiusWindow k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ → brsAZero k G r = 0 := by
      intro k hk
      refine brsAZero_eq_zero_of_notMem fun hr => ?_
      exact Set.disjoint_left.mp (brsRadiusWindow_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero,
      tsum_eq_single k₀ fun k hk => by
        rw [hzero k hk, ENNReal.zero_rpow_of_pos hq]]
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, brsAZero k G r = 0 := fun k =>
      brsAZero_eq_zero_of_notMem (h k)
    simp only [hall, tsum_zero, ENNReal.zero_rpow_of_pos hq]

/-- **The pointwise bound behind the `m = 0` estimate**, in the form needed for
the sum over `k`. -/
theorem brsAZero_rpow_mul_le {k : ℕ} {a p q : ℝ} (hconj : a.HolderConjugate p)
    (ha2 : a < 2) (hq : 0 < q) {G : ℝ → ℂ} (hG : Measurable G) (r : ℝ) :
    brsAZero k G r ^ q * ENNReal.ofReal r ≤
      (brsTruncNorm k a * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p)) ^ q *
        (brsRadiusWindow k).indicator
          (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r := by
  set M : ENNReal := brsTruncNorm k a * (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) with hM
  by_cases hr : r ∈ brsRadiusWindow k
  · have hrpos : 0 < r := brsRadiusWindow_pos hr
    have hb := brsAZero_le (k := k) hconj ha2 hG r
    rw [Set.indicator_of_mem hr] at hb
    have hstep : brsAZero k G r ^ q ≤
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * M) ^ q :=
      ENNReal.rpow_le_rpow hb hq.le
    have hexp : (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * M) ^ q *
        ENNReal.ofReal r = M ^ q * ENNReal.ofReal (r ^ (1 - q / 2)) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
        ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
        ← Real.rpow_mul hrpos.le]
      rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (M ^ q), mul_assoc]
      congr 1
      rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
      congr 1
      calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
            rw [Real.rpow_one]
        _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
        _ = r ^ (1 - q / 2) := by
            congr 1
            ring
    rw [Set.indicator_of_mem hr, ← hexp]
    exact mul_le_mul' hstep le_rfl
  · rw [brsAZero, Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq,
      zero_mul]
    exact zero_le


/-! ## (5.8): summing the `m = 0` terms -/

/-- The single-scale estimate, phrased through the `L^p` norm alone. -/
theorem brsAZero_scale_bound {k : ℕ} {a p q : ℝ} (hconj : a.HolderConjugate p)
    (ha2 : a < 2) (hq : 0 < q) (X : ENNReal) :
    (brsTruncNorm k a * X ^ (1 / p)) ^ q *
        (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2))) ≤
      ENNReal.ofReal (brsAZeroConst a q *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (2 - q / p)) * X ^ (q / p) := by
  have ha0 : (0 : ℝ) < a := hconj.pos
  have hp0 : (0 : ℝ) < p := hconj.symm.pos
  have hinv : 1 / a + 1 / p = 1 := by
    have h := hconj.one_div_add_one_div
    simpa using h
  have h1a : 1 / a = 1 - 1 / p := by linarith
  have hqa : q / a = q - q / p := by
    have h : q / a = q * (1 / a) := by ring
    rw [h, h1a]
    ring
  have hhalfa : (0 : ℝ) < 1 - a / 2 := by linarith
  set T : ℝ := (2 : ℝ) ^ (-(k : ℝ)) with hT
  have hTpos : 0 < T := Real.rpow_pos_of_pos (by norm_num) _
  have hfactor : brsTruncNorm k a ^ q =
      ENNReal.ofReal ((T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a)) := by
    rw [brsTruncNorm_rpow k ha0, ENNReal.ofReal_rpow_of_pos (by positivity)]
  have hNpq : (X ^ (1 / p)) ^ q = X ^ (q / p) := by
    rw [← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hconstid : (T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a) *
      ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1)) =
      brsAZeroConst a q * T ^ (2 - q / p) := by
    have hsplit : (T ^ (1 - a / 2) / (1 - a / 2)) ^ (q / a) =
        T ^ ((1 - a / 2) * (q / a)) * (1 - a / 2) ^ (-(q / a)) := by
      rw [Real.div_rpow (Real.rpow_nonneg hTpos.le _) hhalfa.le,
        ← Real.rpow_mul hTpos.le, Real.rpow_neg hhalfa.le, div_eq_mul_inv]
    have hexp : (1 - a / 2) * (q / a) + (1 - q / 2 + 1) = 2 - q / p := by
      have hstep : (1 - a / 2) * (q / a) = q / a - q / 2 := by
        field_simp
      rw [hstep, hqa]
      ring
    rw [hsplit, brsAZeroConst]
    calc T ^ ((1 - a / 2) * (q / a)) * (1 - a / 2) ^ (-(q / a)) *
          ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1))
        = (1 - a / 2) ^ (-(q / a)) * (2 : ℝ) ^ |1 - q / 2| *
            (T ^ ((1 - a / 2) * (q / a)) * T ^ (1 - q / 2 + 1)) := by ring
      _ = (1 - a / 2) ^ (-(q / a)) * (2 : ℝ) ^ |1 - q / 2| *
            T ^ (2 - q / p) := by
          rw [← Real.rpow_add hTpos, hexp]
  calc (brsTruncNorm k a * X ^ (1 / p)) ^ q *
        (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2)))
      = brsTruncNorm k a ^ q *
          (∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2))) *
          (X ^ (1 / p)) ^ q := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le]
        ring
    _ ≤ brsTruncNorm k a ^ q *
          ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| * T ^ (1 - q / 2 + 1)) *
          (X ^ (1 / p)) ^ q :=
        mul_le_mul' (mul_le_mul' le_rfl
          (lintegral_brsRadiusWindow_rpow_le k (1 - q / 2))) le_rfl
    _ = ENNReal.ofReal (brsAZeroConst a q * T ^ (2 - q / p)) * X ^ (q / p) := by
        rw [hfactor, hNpq, ← ENNReal.ofReal_mul (by positivity), hconstid]

/-- **(5.8) of BRS.**  The `m = 0` terms of the near part sum to a bounded
map into `L^q(r dr)`, provided `p > 2` (so that the truncated kernel is in
`L^{p'}`) and `q < 2p` (so that the dyadic series converges). -/
theorem brs_5_8 {a p q : ℝ} (hconj : a.HolderConjugate p) (ha2 : a < 2)
    (hq : 0 < q) (hq2p : q < 2 * p) {G : ℝ → ℂ} (hG : Measurable G) :
    (∫⁻ r : ℝ, (∑' k : ℕ, brsAZero k G r) ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal (brsAZeroConst a q /
          (1 - (2 : ℝ) ^ (-(2 - q / p)))) *
        (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := hconj.symm.pos
  set θ : ℝ := 2 - q / p with hθdef
  have hθ : 0 < θ := by
    have hqp : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    rw [hθdef]
    linarith
  set x : ℝ := (2 : ℝ) ^ (-θ) with hx
  have hxpos : 0 < x := Real.rpow_pos_of_pos (by norm_num) _
  have hx1 : x < 1 := by
    rw [hx, show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
    exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) (by linarith)
  set X : ENNReal := ∫⁻ z : ℝ, ‖G z‖ₑ ^ p with hX
  have hmeasind : ∀ k : ℕ, Measurable fun r : ℝ =>
      (brsRadiusWindow k).indicator
        (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r := by
    intro k
    refine Measurable.indicator ?_ (measurableSet_brsRadiusWindow k)
    fun_prop
  have hpt : ∀ r : ℝ, (∑' k : ℕ, brsAZero k G r) ^ q * ENNReal.ofReal r ≤
      ∑' k : ℕ, ((brsTruncNorm k a * X ^ (1 / p)) ^ q *
        (brsRadiusWindow k).indicator
          (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r) := by
    intro r
    rw [tsum_brsAZero_rpow hq, ← ENNReal.tsum_mul_right]
    exact ENNReal.tsum_le_tsum fun k => brsAZero_rpow_mul_le hconj ha2 hq hG r
  have hgeom : (∑' k : ℕ, ENNReal.ofReal (brsAZeroConst a q *
      ((2 : ℝ) ^ (-(k : ℝ))) ^ θ)) ≤
      ENNReal.ofReal (brsAZeroConst a q / (1 - x)) := by
    have hterm : ∀ k : ℕ, ENNReal.ofReal (brsAZeroConst a q *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ θ) =
        ENNReal.ofReal (brsAZeroConst a q) * ENNReal.ofReal x ^ k := by
      intro k
      rw [ENNReal.ofReal_mul (brsAZeroConst_pos ha2).le]
      congr 1
      rw [← ENNReal.ofReal_pow hxpos.le]
      congr 1
      rw [hx, ← Real.rpow_natCast ((2 : ℝ) ^ (-θ)) k,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2),
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1
      ring
    rw [tsum_congr hterm, ENNReal.tsum_mul_left, tsum_geometric]
    have hsub : (1 : ENNReal) - ENNReal.ofReal x = ENNReal.ofReal (1 - x) := by
      rw [ENNReal.ofReal_sub _ hxpos.le, ENNReal.ofReal_one]
    rw [hsub, ← ENNReal.ofReal_inv_of_pos (by linarith),
      ← ENNReal.ofReal_mul (brsAZeroConst_pos ha2).le]
    rw [div_eq_mul_inv]
  calc (∫⁻ r : ℝ, (∑' k : ℕ, brsAZero k G r) ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ∑' k : ℕ, ((brsTruncNorm k a * X ^ (1 / p)) ^ q *
          (brsRadiusWindow k).indicator
            (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r) :=
        lintegral_mono hpt
    _ = ∑' k : ℕ, ∫⁻ r : ℝ, ((brsTruncNorm k a * X ^ (1 / p)) ^ q *
          (brsRadiusWindow k).indicator
            (fun r => ENNReal.ofReal (r ^ (1 - q / 2))) r) :=
        lintegral_tsum fun k => ((hmeasind k).const_mul _).aemeasurable
    _ = ∑' k : ℕ, ((brsTruncNorm k a * X ^ (1 / p)) ^ q *
          ∫⁻ r in brsRadiusWindow k, ENNReal.ofReal (r ^ (1 - q / 2))) := by
        refine tsum_congr fun k => ?_
        rw [lintegral_const_mul _ (hmeasind k),
          lintegral_indicator (measurableSet_brsRadiusWindow k)]
    _ ≤ ∑' k : ℕ, (ENNReal.ofReal (brsAZeroConst a q *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ θ) * X ^ (q / p)) :=
        ENNReal.tsum_le_tsum fun k => brsAZero_scale_bound hconj ha2 hq X
    _ = (∑' k : ℕ, ENNReal.ofReal (brsAZeroConst a q *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ θ)) * X ^ (q / p) := ENNReal.tsum_mul_right
    _ ≤ ENNReal.ofReal (brsAZeroConst a q / (1 - x)) * X ^ (q / p) :=
        mul_le_mul' hgeom le_rfl


/-! ## The truncated kernel near its singularity

For the terms `𝒜_{k,m}` with `m ≥ 1` the bump `υ_{k+m}` lives at the scale
`δ = 2^{-k-m}`, which is much smaller than the truncation scale `2^{-k}`.  Near
the singularity there is no cancellation to exploit and the only bound is the
local `L¹` norm of the kernel, which is `2√δ`. -/

/-- The local `L¹` norm of the truncated kernel.  The worst case is an interval
starting at the singularity. -/
theorem lintegral_brsTruncKernel_Ioc_le (k : ℕ) (a : ℝ) {b : ℝ} (hb : 0 < b) :
    (∫⁻ u in Ioc a b, ENNReal.ofReal (brsTruncKernel k u)) ≤
      ENNReal.ofReal (2 * Real.sqrt b) := by
  have hpt : ∀ u : ℝ,
      (Ioc a b).indicator (fun u => ENNReal.ofReal (brsTruncKernel k u)) u ≤
      (Ioc (0 : ℝ) b).indicator
        (fun u => ENNReal.ofReal (u ^ (-(1 / 2) : ℝ))) u := by
    intro u
    by_cases hu : u ∈ Ioc a b
    · rw [Set.indicator_of_mem hu]
      by_cases hupos : 0 < u
      · rw [Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) b from ⟨hupos, hu.2⟩)]
        refine ENNReal.ofReal_le_ofReal ?_
        rw [brsTruncKernel]
        by_cases hw : u ∈ Ioc (0 : ℝ) ((2 : ℝ) ^ (-(k : ℝ)))
        · rw [Set.indicator_of_mem hw]
        · rw [Set.indicator_of_notMem hw]
          exact Real.rpow_nonneg hupos.le _
      · have hzero : brsTruncKernel k u = 0 := by
          rw [brsTruncKernel]
          refine Set.indicator_of_notMem ?_ _
          exact fun hc => hupos hc.1
        rw [hzero, ENNReal.ofReal_zero]
        exact zero_le
    · rw [Set.indicator_of_notMem hu]
      exact zero_le
  calc (∫⁻ u in Ioc a b, ENNReal.ofReal (brsTruncKernel k u))
      = ∫⁻ u : ℝ, (Ioc a b).indicator
          (fun u => ENNReal.ofReal (brsTruncKernel k u)) u :=
        (lintegral_indicator measurableSet_Ioc _).symm
    _ ≤ ∫⁻ u : ℝ, (Ioc (0 : ℝ) b).indicator
          (fun u => ENNReal.ofReal (u ^ (-(1 / 2) : ℝ))) u := lintegral_mono hpt
    _ = ∫⁻ u in Ioc (0 : ℝ) b, ENNReal.ofReal (u ^ (-(1 / 2) : ℝ)) :=
        lintegral_indicator measurableSet_Ioc _
    _ = ∫⁻ u in Ioo (0 : ℝ) b, ENNReal.ofReal (u ^ (-(1 / 2) : ℝ)) :=
        (setLIntegral_congr (Ioo_ae_eq_Ioc (a := (0 : ℝ)) (b := b))).symm
    _ = ENNReal.ofReal (b ^ (-(1 / 2) + 1 : ℝ) / (-(1 / 2) + 1 : ℝ)) :=
        lintegral_Ioo_rpow (by norm_num) hb
    _ = ENNReal.ofReal (2 * Real.sqrt b) := by
        congr 1
        rw [Real.sqrt_eq_rpow, show (-(1 / 2) + 1 : ℝ) = 1 / 2 by norm_num]
        ring

/-- **The crude bound near the singularity.**  A bump of height `M` supported in
`[-δ, δ]` tested against the truncated kernel is controlled by the local `L¹`
norm of the kernel. -/
theorem enorm_integral_brsTruncKernel_mul_le {k : ℕ} {δ M : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hbd : ∀ y : ℝ, |ψ y| ≤ M) (x : ℝ) :
    ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ ≤
      ENNReal.ofReal M *
        ∫⁻ u in Icc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u) := by
  set F : ℝ → ENNReal := fun u =>
    (Icc (x - δ) (x + δ)).indicator
      (fun u => ENNReal.ofReal (brsTruncKernel k u)) u with hF
  have hMnn : 0 ≤ M := le_trans (abs_nonneg (ψ 0)) (hbd 0)
  have hpt : ∀ y : ℝ,
      ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ ≤
        ENNReal.ofReal M * F (x - y) := by
    intro y
    have hnorm : ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ =
        ENNReal.ofReal (brsTruncKernel k (x - y)) * ENNReal.ofReal |ψ y| := by
      rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (brsTruncKernel_nonneg k (x - y)),
        ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs]
    rw [hnorm]
    by_cases hy : |y| ≤ δ
    · have hmem : x - y ∈ Icc (x - δ) (x + δ) := by
        have := abs_le.mp hy
        exact ⟨by linarith [this.2], by linarith [this.1]⟩
      rw [hF]
      simp only
      rw [Set.indicator_of_mem hmem, mul_comm (ENNReal.ofReal M)]
      exact mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (hbd y))
    · have hzero : ψ y = 0 := hsupp y (lt_of_not_ge hy)
      rw [hzero, abs_zero, ENNReal.ofReal_zero, mul_zero]
      exact zero_le
  calc ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ
      ≤ ∫⁻ y : ℝ, ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y : ℝ, ENNReal.ofReal M * F (x - y) := lintegral_mono hpt
    _ = ENNReal.ofReal M * ∫⁻ y : ℝ, F (x - y) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    _ = ENNReal.ofReal M * ∫⁻ u : ℝ, F u := by
        rw [lintegral_sub_left_eq_self F x]
    _ = ENNReal.ofReal M *
          ∫⁻ u in Icc (x - δ) (x + δ),
            ENNReal.ofReal (brsTruncKernel k u) := by
        rw [hF, lintegral_indicator measurableSet_Icc]


/-! ## The two regimes of the kernel `h_k * υ` -/

/-- **The bound near the singularity.**  On `x ≤ δ` there is no cancellation to
exploit and the size of the kernel is `δ^{-1/2}` times the `L¹` mass of the
bump: the height `M` of a bump at scale `δ` is `δ^{-1}`, and the local `L¹`
norm of the kernel is `2√(2δ)`. -/
theorem enorm_integral_brsTruncKernel_mul_le_near {k : ℕ} {δ M : ℝ}
    {ψ : ℝ → ℝ} (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hbd : ∀ y : ℝ, |ψ y| ≤ M) {x : ℝ} (hx0 : 0 < x + δ) (hx : x ≤ δ) :
    ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ ≤
      ENNReal.ofReal (M * (2 * Real.sqrt (2 * δ))) := by
  have hMnn : 0 ≤ M := le_trans (abs_nonneg (ψ 0)) (hbd 0)
  have hloc : (∫⁻ u in Icc (x - δ) (x + δ),
      ENNReal.ofReal (brsTruncKernel k u)) ≤
      ENNReal.ofReal (2 * Real.sqrt (2 * δ)) := by
    calc (∫⁻ u in Icc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u))
        = ∫⁻ u in Ioc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u) :=
          (setLIntegral_congr (Ioc_ae_eq_Icc (a := x - δ) (b := x + δ))).symm
      _ ≤ ENNReal.ofReal (2 * Real.sqrt (x + δ)) :=
          lintegral_brsTruncKernel_Ioc_le k _ hx0
      _ ≤ ENNReal.ofReal (2 * Real.sqrt (2 * δ)) := by
          refine ENNReal.ofReal_le_ofReal ?_
          have : Real.sqrt (x + δ) ≤ Real.sqrt (2 * δ) :=
            Real.sqrt_le_sqrt (by linarith)
          linarith
  calc ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ
      ≤ ENNReal.ofReal M *
          ∫⁻ u in Icc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u) :=
        enorm_integral_brsTruncKernel_mul_le hsupp hbd x
    _ ≤ ENNReal.ofReal M * ENNReal.ofReal (2 * Real.sqrt (2 * δ)) :=
        mul_le_mul' le_rfl hloc
    _ = ENNReal.ofReal (M * (2 * Real.sqrt (2 * δ))) :=
        (ENNReal.ofReal_mul hMnn).symm

/-- **Removing the truncation in the bulk.**  If the window `[x-δ, x+δ]` lies
inside `(0, 2^{-k}]`, the truncated kernel agrees with `u^{-1/2}` there, so the
cancellation estimate `brs_kernel_cancellation` applies verbatim. -/
theorem integral_brsTruncKernel_mul_eq {k : ℕ} {δ : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) {x : ℝ} (h1 : δ < x)
    (h2 : x + δ ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    (∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)) =
      ∫ y : ℝ, (((x - y) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * (ψ y : ℂ) := by
  congr 1
  funext y
  by_cases hy : |y| ≤ δ
  · have hyb := abs_le.mp hy
    have hmem : x - y ∈ Ioc (0 : ℝ) ((2 : ℝ) ^ (-(k : ℝ))) := by
      refine ⟨by linarith [hyb.2], by linarith [hyb.1]⟩
    have hval : brsTruncKernel k (x - y) = (x - y) ^ (-(1 / 2) : ℝ) := by
      rw [brsTruncKernel, Set.indicator_of_mem hmem]
    rw [hval]
  · have hzero : ψ y = 0 := hsupp y (lt_of_not_ge hy)
    rw [hzero]
    simp


/-! ## The bulk and the far edge -/

/-- Away from the singularity the truncated kernel is bounded. -/
theorem brsTruncKernel_le_of_ge {k : ℕ} {c u : ℝ} (hc : 0 < c) (hu : c ≤ u) :
    brsTruncKernel k u ≤ c ^ (-(1 / 2) : ℝ) := by
  rw [brsTruncKernel]
  by_cases hw : u ∈ Ioc (0 : ℝ) ((2 : ℝ) ^ (-(k : ℝ)))
  · rw [Set.indicator_of_mem hw]
    exact Real.rpow_le_rpow_of_nonpos hc hu (by norm_num)
  · rw [Set.indicator_of_notMem hw]
    exact Real.rpow_nonneg hc.le _

/-- **The bound by the sup of the kernel.**  Useful at the far edge of the
truncation, where the kernel is bounded but the bump has no cancellation to
exploit against a smooth factor. -/
theorem enorm_integral_brsTruncKernel_mul_le_sup {k : ℕ} {δ S : ℝ} {x : ℝ}
    {ψ : ℝ → ℝ} (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hS : ∀ u ∈ Icc (x - δ) (x + δ), brsTruncKernel k u ≤ S) :
    ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ ≤
      ENNReal.ofReal S * ∫⁻ y : ℝ, ENNReal.ofReal |ψ y| := by
  have hpt : ∀ y : ℝ,
      ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ ≤
        ENNReal.ofReal S * ENNReal.ofReal |ψ y| := by
    intro y
    have hnorm : ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ =
        ENNReal.ofReal (brsTruncKernel k (x - y)) * ENNReal.ofReal |ψ y| := by
      rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
        Real.norm_of_nonneg (brsTruncKernel_nonneg k (x - y)),
        ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs]
    rw [hnorm]
    by_cases hy : |y| ≤ δ
    · have hyb := abs_le.mp hy
      have hmem : x - y ∈ Icc (x - δ) (x + δ) :=
        ⟨by linarith [hyb.2], by linarith [hyb.1]⟩
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal (hS _ hmem)) le_rfl
    · have hzero : ψ y = 0 := hsupp y (lt_of_not_ge hy)
      rw [hzero, abs_zero, ENNReal.ofReal_zero, mul_zero]
      exact zero_le
  calc ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ
      ≤ ∫⁻ y : ℝ, ‖((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ y : ℝ, ENNReal.ofReal S * ENNReal.ofReal |ψ y| := lintegral_mono hpt
    _ = ENNReal.ofReal S * ∫⁻ y : ℝ, ENNReal.ofReal |ψ y| :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- **The bulk bound.**  Inside the truncation window the vanishing moments of
the bump gain a factor `δ^{N+1}` against the singular kernel. -/
theorem norm_integral_brsTruncKernel_mul_le_bulk {k : ℕ} {δ : ℝ} {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hδ : 0 < δ) (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0)
    {x : ℝ} (h1 : δ < x) (h2 : x + δ ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    ‖∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)‖ ≤
      ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
          (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
            (Nat.factorial (N + 1) : ℝ)) * δ ^ (N + 1) * ∫ y : ℝ, |ψ y| := by
  rw [integral_brsTruncKernel_mul_eq hsupp h1 h2]
  exact brs_kernel_cancellation hψ hδ h1 hsupp hmom


/-! ## The support of the kernel, and a shifted tail integral -/

/-- The kernel `h_k * ψ` is supported in `(-δ, 2^{-k} + δ]`. -/
theorem integral_brsTruncKernel_mul_eq_zero {k : ℕ} {δ : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) {x : ℝ}
    (hx : x ∉ Ioc (-δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ)) :
    (∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)) = 0 := by
  have hcase : x ≤ -δ ∨ (2 : ℝ) ^ (-(k : ℝ)) + δ < x := by
    by_contra hc
    simp only [not_or, not_le, not_lt] at hc
    exact hx ⟨hc.1, hc.2⟩
  have hzero : ∀ y : ℝ,
      ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ) = 0 := by
    intro y
    by_cases hy : δ < |y|
    · rw [hsupp y hy]
      simp
    · have hyb := abs_le.mp (not_lt.mp hy)
      have hk : brsTruncKernel k (x - y) = 0 := by
        rw [brsTruncKernel]
        refine Set.indicator_of_notMem ?_ _
        rcases hcase with h | h
        · exact fun hc => absurd hc.1 (by simp only [not_lt]; linarith [hyb.1])
        · exact fun hc => absurd hc.2 (by simp only [not_le]; linarith [hyb.2])
      rw [hk]
      simp
  rw [integral_congr_ae (Filter.Eventually.of_forall hzero), integral_zero]

/-- The tail integral of a shifted power. -/
theorem lintegral_Ioi_shift_rpow {c e t : ℝ} (hce : e < c) (ht : t < -1) :
    (∫⁻ x in Ioi c, ENNReal.ofReal ((x - e) ^ t)) =
      ENNReal.ofReal (-(c - e) ^ (t + 1) / (t + 1)) := by
  set F : ℝ → ENNReal := fun u =>
    (Ioi (c - e)).indicator (fun u => ENNReal.ofReal (u ^ t)) u with hF
  have hshift : ∀ x : ℝ,
      (Ioi c).indicator (fun x => ENNReal.ofReal ((x - e) ^ t)) x = F (x - e) := by
    intro x
    by_cases hx : x ∈ Ioi c
    · have hx' : c < x := hx
      rw [Set.indicator_of_mem hx, hF]
      simp only
      rw [Set.indicator_of_mem (show x - e ∈ Ioi (c - e) by
        simp only [mem_Ioi]; linarith)]
    · have hx' : x ≤ c := by
        simp only [mem_Ioi, not_lt] at hx
        exact hx
      rw [Set.indicator_of_notMem hx, hF]
      simp only
      rw [Set.indicator_of_notMem (show x - e ∉ Ioi (c - e) by
        simp only [mem_Ioi, not_lt]; linarith)]
  calc (∫⁻ x in Ioi c, ENNReal.ofReal ((x - e) ^ t))
      = ∫⁻ x : ℝ, (Ioi c).indicator
          (fun x => ENNReal.ofReal ((x - e) ^ t)) x :=
        (lintegral_indicator measurableSet_Ioi _).symm
    _ = ∫⁻ x : ℝ, F (x - e) := lintegral_congr hshift
    _ = ∫⁻ u : ℝ, F u := lintegral_sub_right_eq_self F e
    _ = ∫⁻ u in Ioi (c - e), ENNReal.ofReal (u ^ t) := by
        rw [hF, lintegral_indicator measurableSet_Ioi]
    _ = ENNReal.ofReal (-(c - e) ^ (t + 1) / (t + 1)) :=
        lintegral_Ioi_rpow ht (by linarith)


/-! ## Splitting a compactly supported integral into three windows -/

/-- A function vanishing outside `(a, d]` has its integral bounded by the sum of
the integrals over three consecutive windows. -/
theorem lintegral_le_three_regions {F : ℝ → ENNReal} {a b c d : ℝ}
    (hab : a ≤ b) (hbc : b ≤ c) (hcd : c ≤ d)
    (hzero : ∀ x : ℝ, x ∉ Ioc a d → F x = 0) :
    (∫⁻ x : ℝ, F x) ≤ (∫⁻ x in Ioc a b, F x) + (∫⁻ x in Ioc b c, F x) +
      ∫⁻ x in Ioc c d, F x := by
  have hfull : (∫⁻ x : ℝ, F x) = ∫⁻ x in Ioc a d, F x := by
    rw [← lintegral_indicator measurableSet_Ioc]
    refine lintegral_congr fun x => ?_
    by_cases hx : x ∈ Ioc a d
    · rw [Set.indicator_of_mem hx]
    · rw [Set.indicator_of_notMem hx, hzero x hx]
  have hsplit : Ioc a d = (Ioc a b ∪ Ioc b c) ∪ Ioc c d := by
    rw [Ioc_union_Ioc_eq_Ioc hab hbc, Ioc_union_Ioc_eq_Ioc (hab.trans hbc) hcd]
  rw [hfull, hsplit]
  refine le_trans (lintegral_union_le F _ _) ?_
  exact add_le_add (lintegral_union_le F _ _) le_rfl

/-- The kernel `h_k * ψ` of BRS (5.11). -/
def brsTruncConv (k : ℕ) (ψ : ℝ → ℝ) (x : ℝ) : ℂ :=
  ∫ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ)

theorem brsTruncConv_eq_zero {k : ℕ} {δ : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) {x : ℝ}
    (hx : x ∉ Ioc (-δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ)) : brsTruncConv k ψ x = 0 :=
  integral_brsTruncKernel_mul_eq_zero hsupp hx


/-! ## The three pointwise regimes of `h_k * ψ` -/

/-- Near the singularity: the local `L¹` norm of the kernel on a window of
length `B` starting at the singularity is `2√B`. -/
theorem enorm_brsTruncConv_le_near {k : ℕ} {δ M B : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hbd : ∀ y : ℝ, |ψ y| ≤ M)
    {x : ℝ} (hx0 : 0 < x + δ) (hxB : x + δ ≤ B) :
    ‖brsTruncConv k ψ x‖ₑ ≤ ENNReal.ofReal (M * (2 * Real.sqrt B)) := by
  have hMnn : 0 ≤ M := le_trans (abs_nonneg (ψ 0)) (hbd 0)
  have hloc : (∫⁻ u in Icc (x - δ) (x + δ),
      ENNReal.ofReal (brsTruncKernel k u)) ≤
      ENNReal.ofReal (2 * Real.sqrt B) := by
    calc (∫⁻ u in Icc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u))
        = ∫⁻ u in Ioc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u) :=
          (setLIntegral_congr (Ioc_ae_eq_Icc (a := x - δ) (b := x + δ))).symm
      _ ≤ ENNReal.ofReal (2 * Real.sqrt (x + δ)) :=
          lintegral_brsTruncKernel_Ioc_le k _ hx0
      _ ≤ ENNReal.ofReal (2 * Real.sqrt B) := by
          refine ENNReal.ofReal_le_ofReal ?_
          have : Real.sqrt (x + δ) ≤ Real.sqrt B := Real.sqrt_le_sqrt hxB
          linarith
  calc ‖brsTruncConv k ψ x‖ₑ
      ≤ ENNReal.ofReal M *
          ∫⁻ u in Icc (x - δ) (x + δ), ENNReal.ofReal (brsTruncKernel k u) :=
        enorm_integral_brsTruncKernel_mul_le hsupp hbd x
    _ ≤ ENNReal.ofReal M * ENNReal.ofReal (2 * Real.sqrt B) :=
        mul_le_mul' le_rfl hloc
    _ = ENNReal.ofReal (M * (2 * Real.sqrt B)) := (ENNReal.ofReal_mul hMnn).symm

/-- In the bulk: the vanishing moments give the factor `δ^{N+1}`. -/
theorem enorm_brsTruncConv_le_bulk {k : ℕ} {δ A : ℝ} {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hδ : 0 < δ) (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hA : (∫ y : ℝ, |ψ y|) ≤ A) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0)
    {x : ℝ} (h1 : δ < x) (h2 : x + δ ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    ‖brsTruncConv k ψ x‖ₑ ≤
      ENNReal.ofReal ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
          (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * A *
        (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1))) := by
  have hxδ : 0 < x - δ := by linarith
  have hPnn : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have hIntnn : (0 : ℝ) ≤ ∫ y : ℝ, |ψ y| := by
    refine integral_nonneg fun y => abs_nonneg _
  have hbase := norm_integral_brsTruncKernel_mul_le_bulk hψ hδ hsupp hmom h1 h2
  rw [← ofReal_norm]
  refine ENNReal.ofReal_le_ofReal (le_trans hbase ?_)
  have hfac : (0 : ℝ) ≤ (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
      (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
        (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) := by
    have h1' : (0 : ℝ) ≤ (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) :=
      Real.rpow_nonneg hxδ.le _
    have h2' : (0 : ℝ) ≤ δ ^ (N + 1) := by positivity
    have h3' : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
      exact_mod_cast Nat.factorial_pos (N + 1)
    positivity
  calc (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
        (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
          (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * ∫ y : ℝ, |ψ y|
      ≤ (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) *
          (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) /
            (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * A :=
        mul_le_mul_of_nonneg_left hA hfac
    _ = (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
          (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * A *
        (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) := by ring

/-- At the far edge of the truncation the kernel is bounded by `S`. -/
theorem enorm_brsTruncConv_le_far {k : ℕ} {δ S A : ℝ} {x : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hSnn : 0 ≤ S)
    (hS : ∀ u ∈ Icc (x - δ) (x + δ), brsTruncKernel k u ≤ S)
    (hA : (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A) :
    ‖brsTruncConv k ψ x‖ₑ ≤ ENNReal.ofReal (S * A) := by
  calc ‖brsTruncConv k ψ x‖ₑ
      ≤ ENNReal.ofReal S * ∫⁻ y : ℝ, ENNReal.ofReal |ψ y| :=
        enorm_integral_brsTruncKernel_mul_le_sup hsupp hS
    _ ≤ ENNReal.ofReal S * ENNReal.ofReal A := mul_le_mul' le_rfl hA
    _ = ENNReal.ofReal (S * A) := (ENNReal.ofReal_mul hSnn).symm


/-! ## The `L^r` mass of `h_k * ψ` on each of the three windows -/

/-- The constant of the bulk estimate. -/
def brsBulkConst (δ A : ℝ) (N : ℕ) : ℝ :=
  (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
    (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * A

theorem brsBulkConst_nonneg {δ A : ℝ} (hδ : 0 ≤ δ) (hA : 0 ≤ A) (N : ℕ) :
    0 ≤ brsBulkConst δ A N := by
  rw [brsBulkConst]
  have h1 : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have h2 : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos (N + 1)
  positivity

/-- Window one: `(-δ, 4δ]`, next to the singularity. -/
theorem lintegral_brsTruncConv_region_one_le {k : ℕ} {δ M r : ℝ} {ψ : ℝ → ℝ}
    (_hδ : 0 < δ) (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hbd : ∀ y : ℝ, |ψ y| ≤ M) (hr : 0 < r) :
    (∫⁻ x in Ioc (-δ) (4 * δ), ‖brsTruncConv k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
        ENNReal.ofReal (5 * δ) := by
  have hpt : ∀ x ∈ Ioc (-δ) (4 * δ), ‖brsTruncConv k ψ x‖ₑ ^ r ≤
      ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r := by
    intro x hx
    refine ENNReal.rpow_le_rpow ?_ hr.le
    exact enorm_brsTruncConv_le_near hsupp hbd (by linarith [hx.1])
      (by linarith [hx.2])
  calc (∫⁻ x in Ioc (-δ) (4 * δ), ‖brsTruncConv k ψ x‖ₑ ^ r)
      ≤ ∫⁻ _ in Ioc (-δ) (4 * δ),
          ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r :=
        setLIntegral_mono' measurableSet_Ioc hpt
    _ = ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
          volume (Ioc (-δ) (4 * δ)) := setLIntegral_const _ _
    _ = ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
          ENNReal.ofReal (5 * δ) := by
        rw [Real.volume_Ioc, show (4 : ℝ) * δ - -δ = 5 * δ by ring]

/-- Window two: the bulk `(4δ, 2^{-k} - δ]`. -/
theorem lintegral_brsTruncConv_region_two_le {k : ℕ} {δ A r : ℝ} {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hδ : 0 < δ) (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hA : (∫ y : ℝ, |ψ y|) ≤ A) (hAnn : 0 ≤ A) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0) (hr : 1 ≤ r) :
    (∫⁻ x in Ioc (4 * δ) ((2 : ℝ) ^ (-(k : ℝ)) - δ),
        ‖brsTruncConv k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (brsBulkConst δ A N) ^ r *
        ENNReal.ofReal (-(3 * δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
          ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hKnn : 0 ≤ brsBulkConst δ A N := brsBulkConst_nonneg hδ.le hAnn N
  have hNnn : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  have ht : (-(1 / 2) - ((N : ℝ) + 1)) * r < -1 := by nlinarith
  have hpt : ∀ x ∈ Ioc (4 * δ) ((2 : ℝ) ^ (-(k : ℝ)) - δ),
      ‖brsTruncConv k ψ x‖ₑ ^ r ≤
        ENNReal.ofReal (brsBulkConst δ A N) ^ r *
          ENNReal.ofReal ((x - δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r)) := by
    intro x hx
    have hxδ : 0 < x - δ := by linarith [hx.1]
    have hb := enorm_brsTruncConv_le_bulk hψ hδ hsupp hA hmom
      (by linarith [hx.1] : δ < x) (by linarith [hx.2])
    rw [show ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * δ ^ (N + 1) * A *
        (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1))) =
        brsBulkConst δ A N * (x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)) by
      rw [brsBulkConst], ENNReal.ofReal_mul hKnn] at hb
    calc ‖brsTruncConv k ψ x‖ₑ ^ r
        ≤ (ENNReal.ofReal (brsBulkConst δ A N) *
            ENNReal.ofReal ((x - δ) ^ (-(1 / 2) - ((N : ℝ) + 1)))) ^ r :=
          ENNReal.rpow_le_rpow hb hr0.le
      _ = ENNReal.ofReal (brsBulkConst δ A N) ^ r *
            ENNReal.ofReal ((x - δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le,
            ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hxδ _),
            ← Real.rpow_mul hxδ.le]
  calc (∫⁻ x in Ioc (4 * δ) ((2 : ℝ) ^ (-(k : ℝ)) - δ),
        ‖brsTruncConv k ψ x‖ₑ ^ r)
      ≤ ∫⁻ x in Ioc (4 * δ) ((2 : ℝ) ^ (-(k : ℝ)) - δ),
          ENNReal.ofReal (brsBulkConst δ A N) ^ r *
            ENNReal.ofReal ((x - δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r)) :=
        setLIntegral_mono' measurableSet_Ioc hpt
    _ ≤ ∫⁻ x in Ioi (4 * δ),
          ENNReal.ofReal (brsBulkConst δ A N) ^ r *
            ENNReal.ofReal ((x - δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r)) :=
        lintegral_mono_set Ioc_subset_Ioi_self
    _ = ENNReal.ofReal (brsBulkConst δ A N) ^ r *
          ∫⁻ x in Ioi (4 * δ),
            ENNReal.ofReal ((x - δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r)) := by
        rw [lintegral_const_mul' _ _
          (ENNReal.rpow_ne_top_of_nonneg hr0.le ENNReal.ofReal_ne_top)]
    _ = ENNReal.ofReal (brsBulkConst δ A N) ^ r *
          ENNReal.ofReal (-(3 * δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
            ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) := by
        rw [lintegral_Ioi_shift_rpow (by linarith) ht,
          show (4 : ℝ) * δ - δ = 3 * δ by ring]

/-- Window three: the far edge `(2^{-k} - δ, 2^{-k} + δ]`. -/
theorem lintegral_brsTruncConv_region_three_le {k : ℕ} {δ A r : ℝ} {ψ : ℝ → ℝ}
    (hδ : 0 < δ) (h4δ : 4 * δ ≤ (2 : ℝ) ^ (-(k : ℝ)))
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0)
    (hAe : (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A)
    (hr : 0 < r) :
    (∫⁻ x in Ioc ((2 : ℝ) ^ (-(k : ℝ)) - δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ),
        ‖brsTruncConv k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r *
        ENNReal.ofReal (2 * δ) := by
  have hSnn : (0 : ℝ) ≤ (2 * δ) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by linarith) _
  have hpt : ∀ x ∈ Ioc ((2 : ℝ) ^ (-(k : ℝ)) - δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ),
      ‖brsTruncConv k ψ x‖ₑ ^ r ≤
        ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r := by
    intro x hx
    refine ENNReal.rpow_le_rpow ?_ hr.le
    refine enorm_brsTruncConv_le_far hsupp hSnn ?_ hAe
    intro u hu
    exact brsTruncKernel_le_of_ge (by linarith) (by linarith [hu.1, hx.1])
  calc (∫⁻ x in Ioc ((2 : ℝ) ^ (-(k : ℝ)) - δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ),
        ‖brsTruncConv k ψ x‖ₑ ^ r)
      ≤ ∫⁻ _ in Ioc ((2 : ℝ) ^ (-(k : ℝ)) - δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ),
          ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r :=
        setLIntegral_mono' measurableSet_Ioc hpt
    _ = ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r *
          volume (Ioc ((2 : ℝ) ^ (-(k : ℝ)) - δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ)) :=
        setLIntegral_const _ _
    _ = ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r *
          ENNReal.ofReal (2 * δ) := by
        rw [Real.volume_Ioc,
          show (2 : ℝ) ^ (-(k : ℝ)) + δ - ((2 : ℝ) ^ (-(k : ℝ)) - δ) = 2 * δ by
            ring]


/-! ## (5.11): the `L^r` norm of the kernel `h_k * ψ`

Assembling the three windows.  All three contributions are of size
`δ^{1 - r/2}` once `M` is the height `≈ δ^{-1}` of an `L¹`-normalised bump, so
`‖h_k * ψ‖_r ≈ δ^{1/r - 1/2}`, which is BRS (5.12). -/

/-- **The `L^r` bound for `h_k * ψ`.**  Here `δ` is the scale of the bump `ψ`,
`M` bounds its height, `A` bounds its `L¹` norm, and `N + 1` is the number of
vanishing moments. -/
theorem lintegral_enorm_brsTruncConv_rpow_le {k : ℕ} {δ M A r : ℝ} {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hδ : 0 < δ)
    (h5δ : 5 * δ ≤ (2 : ℝ) ^ (-(k : ℝ)))
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hbd : ∀ y : ℝ, |ψ y| ≤ M)
    (hA : (∫ y : ℝ, |ψ y|) ≤ A) (hAnn : 0 ≤ A)
    (hAe : (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0) (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, ‖brsTruncConv k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
          ENNReal.ofReal (5 * δ) +
        ENNReal.ofReal (brsBulkConst δ A N) ^ r *
          ENNReal.ofReal (-(3 * δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
            ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) +
        ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r *
          ENNReal.ofReal (2 * δ) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hzero : ∀ x : ℝ, x ∉ Ioc (-δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ) →
      ‖brsTruncConv k ψ x‖ₑ ^ r = 0 := by
    intro x hx
    rw [brsTruncConv_eq_zero hsupp hx, enorm_zero,
      ENNReal.zero_rpow_of_pos hr0]
  refine le_trans (lintegral_le_three_regions (a := -δ) (b := 4 * δ)
    (c := (2 : ℝ) ^ (-(k : ℝ)) - δ) (d := (2 : ℝ) ^ (-(k : ℝ)) + δ)
    (by linarith) (by linarith) (by linarith) hzero) ?_
  refine add_le_add (add_le_add ?_ ?_) ?_
  · exact lintegral_brsTruncConv_region_one_le hδ hsupp hbd hr0
  · exact lintegral_brsTruncConv_region_two_le hψ hδ hsupp hA hAnn hmom hr
  · exact lintegral_brsTruncConv_region_three_le hδ (by linarith) hsupp hAe hr0


/-! ## Normalising the three windows to a single power of `δ` -/

/-- The algebraic identity behind each of the three windows. -/
theorem rpow_mul_rpow_scale {δ c d β γ r : ℝ} (hδ : 0 < δ) (hc : 0 ≤ c) :
    (c * δ ^ β) ^ r * (d * δ ^ γ) = c ^ r * d * δ ^ (β * r + γ) := by
  rw [Real.mul_rpow hc (Real.rpow_nonneg hδ.le _), ← Real.rpow_mul hδ.le]
  rw [show c ^ r * δ ^ (β * r) * (d * δ ^ γ) =
      c ^ r * d * (δ ^ (β * r) * δ ^ γ) by ring, ← Real.rpow_add hδ]

/-- Window one, normalised. -/
theorem brsTruncConv_window_one_le {δ M Mu r : ℝ} (hδ : 0 < δ) (hMnn : 0 ≤ M)
    (hMu : M * δ ≤ Mu) (hr : 0 < r) :
    ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
        ENNReal.ofReal (5 * δ) ≤
      ENNReal.ofReal (5 * (2 * Real.sqrt 5 * Mu) ^ r * δ ^ (1 - r / 2)) := by
  have hznn : 0 ≤ M * (2 * Real.sqrt (5 * δ)) := by positivity
  have hMunn : 0 ≤ Mu := le_trans (by positivity) hMu
  -- rewrite the window-one factor as `c * δ ^ (-1/2)`
  have hsq : Real.sqrt (5 * δ) = Real.sqrt 5 * δ ^ ((1 : ℝ) / 2) := by
    rw [Real.sqrt_mul (by norm_num), Real.sqrt_eq_rpow δ]
  have hhalf : δ ^ ((1 : ℝ) / 2) = δ ^ (-(1 / 2) : ℝ) * δ := by
    have h := Real.rpow_add hδ (-(1 / 2) : ℝ) 1
    rw [Real.rpow_one] at h
    rw [← h]
    congr 1
    norm_num
  have hz : M * (2 * Real.sqrt (5 * δ)) ≤
      (2 * Real.sqrt 5 * Mu) * δ ^ (-(1 / 2) : ℝ) := by
    rw [hsq, hhalf]
    have hpos : (0 : ℝ) ≤ 2 * Real.sqrt 5 * δ ^ (-(1 / 2) : ℝ) := by
      have := Real.rpow_nonneg hδ.le (-(1 / 2) : ℝ)
      have h5 : (0 : ℝ) ≤ Real.sqrt 5 := Real.sqrt_nonneg 5
      positivity
    calc M * (2 * (Real.sqrt 5 * (δ ^ (-(1 / 2) : ℝ) * δ)))
        = (2 * Real.sqrt 5 * δ ^ (-(1 / 2) : ℝ)) * (M * δ) := by ring
      _ ≤ (2 * Real.sqrt 5 * δ ^ (-(1 / 2) : ℝ)) * Mu :=
          mul_le_mul_of_nonneg_left hMu hpos
      _ = 2 * Real.sqrt 5 * Mu * δ ^ (-(1 / 2) : ℝ) := by ring
  have hkey : (M * (2 * Real.sqrt (5 * δ))) ^ r * (5 * δ) ≤
      5 * (2 * Real.sqrt 5 * Mu) ^ r * δ ^ (1 - r / 2) := by
    have hstep : (M * (2 * Real.sqrt (5 * δ))) ^ r ≤
        ((2 * Real.sqrt 5 * Mu) * δ ^ (-(1 / 2) : ℝ)) ^ r :=
      Real.rpow_le_rpow hznn hz hr.le
    have hid : ((2 * Real.sqrt 5 * Mu) * δ ^ (-(1 / 2) : ℝ)) ^ r *
        (5 * δ ^ (1 : ℝ)) =
        (2 * Real.sqrt 5 * Mu) ^ r * 5 * δ ^ ((-(1 / 2) : ℝ) * r + 1) :=
      rpow_mul_rpow_scale hδ (by positivity)
    rw [Real.rpow_one] at hid
    calc (M * (2 * Real.sqrt (5 * δ))) ^ r * (5 * δ)
        ≤ ((2 * Real.sqrt 5 * Mu) * δ ^ (-(1 / 2) : ℝ)) ^ r * (5 * δ) :=
          mul_le_mul_of_nonneg_right hstep (by linarith)
      _ = (2 * Real.sqrt 5 * Mu) ^ r * 5 * δ ^ ((-(1 / 2) : ℝ) * r + 1) := hid
      _ = 5 * (2 * Real.sqrt 5 * Mu) ^ r * δ ^ (1 - r / 2) := by
          rw [show (-(1 / 2) : ℝ) * r + 1 = 1 - r / 2 by ring]
          ring
  calc ENNReal.ofReal (M * (2 * Real.sqrt (5 * δ))) ^ r *
        ENNReal.ofReal (5 * δ)
      = ENNReal.ofReal ((M * (2 * Real.sqrt (5 * δ))) ^ r * (5 * δ)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg hznn hr.le,
          ← ENNReal.ofReal_mul (Real.rpow_nonneg hznn r)]
    _ ≤ ENNReal.ofReal (5 * (2 * Real.sqrt 5 * Mu) ^ r * δ ^ (1 - r / 2)) :=
        ENNReal.ofReal_le_ofReal hkey

/-- Window three, normalised. -/
theorem brsTruncConv_window_three_le {δ A r : ℝ} (hδ : 0 < δ) (hAnn : 0 ≤ A)
    (hr : 0 < r) :
    ENNReal.ofReal ((2 * δ) ^ (-(1 / 2) : ℝ) * A) ^ r *
        ENNReal.ofReal (2 * δ) =
      ENNReal.ofReal (2 * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r *
        δ ^ (1 - r / 2)) := by
  have hcnn : (0 : ℝ) ≤ A * (2 : ℝ) ^ (-(1 / 2) : ℝ) := by
    have := Real.rpow_nonneg (by norm_num : (0 : ℝ) ≤ 2) (-(1 / 2) : ℝ)
    positivity
  have hsplit : (2 * δ) ^ (-(1 / 2) : ℝ) * A =
      (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) * δ ^ (-(1 / 2) : ℝ) := by
    rw [Real.mul_rpow (by norm_num) hδ.le]
    ring
  have hznn : (0 : ℝ) ≤ (2 * δ) ^ (-(1 / 2) : ℝ) * A := by
    have := Real.rpow_nonneg (by linarith : (0 : ℝ) ≤ 2 * δ) (-(1 / 2) : ℝ)
    positivity
  have hid : ((A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) * δ ^ (-(1 / 2) : ℝ)) ^ r *
      (2 * δ ^ (1 : ℝ)) =
      (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r * 2 * δ ^ ((-(1 / 2) : ℝ) * r + 1) :=
    rpow_mul_rpow_scale hδ hcnn
  rw [Real.rpow_one] at hid
  rw [ENNReal.ofReal_rpow_of_nonneg hznn hr.le,
    ← ENNReal.ofReal_mul (Real.rpow_nonneg hznn r)]
  congr 1
  rw [hsplit, hid, show (-(1 / 2) : ℝ) * r + 1 = 1 - r / 2 by ring]
  ring

/-- Window two, normalised. -/
theorem brsTruncConv_window_two_le {δ A r : ℝ} (hδ : 0 < δ) (hAnn : 0 ≤ A)
    (hr : 1 ≤ r) (N : ℕ) :
    ENNReal.ofReal (brsBulkConst δ A N) ^ r *
        ENNReal.ofReal (-(3 * δ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
          ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) =
      ENNReal.ofReal (((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
            (Nat.factorial (N + 1) : ℝ) * A) ^ r *
          ((3 : ℝ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
            -((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) *
        δ ^ (1 - r / 2)) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hNnn : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  set w : ℝ := (-(1 / 2) - ((N : ℝ) + 1)) * r + 1 with hw
  have hwneg : w < 0 := by
    rw [hw]
    nlinarith
  have hPnn : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have hfacpos : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos (N + 1)
  set c : ℝ := (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
    (Nat.factorial (N + 1) : ℝ) * A with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    positivity
  have hKnn : 0 ≤ brsBulkConst δ A N := brsBulkConst_nonneg hδ.le hAnn N
  have hKform : brsBulkConst δ A N = c * δ ^ ((N : ℝ) + 1) := by
    rw [brsBulkConst, hc,
      show ((N : ℝ) + 1) = ((N + 1 : ℕ) : ℝ) by push_cast; ring,
      Real.rpow_natCast]
    ring
  have hdform : -(3 * δ) ^ w / w =
      ((3 : ℝ) ^ w / -w) * δ ^ w := by
    rw [Real.mul_rpow (by norm_num) hδ.le]
    field_simp
  have hid : (c * δ ^ ((N : ℝ) + 1)) ^ r * (((3 : ℝ) ^ w / -w) * δ ^ w) =
      c ^ r * ((3 : ℝ) ^ w / -w) * δ ^ (((N : ℝ) + 1) * r + w) :=
    rpow_mul_rpow_scale hδ hcnn
  have hexp : ((N : ℝ) + 1) * r + w = 1 - r / 2 := by
    rw [hw]
    ring
  rw [ENNReal.ofReal_rpow_of_nonneg hKnn hr0.le,
    ← ENNReal.ofReal_mul (Real.rpow_nonneg hKnn r)]
  congr 1
  rw [hKform, hdform, hid, hexp]


/-! ## (5.12): the `L^r` norm of `h_k * ψ` is `δ^{1/r - 1/2}` -/

/-- The constant of BRS (5.12).  Here `Mu` bounds `δ` times the height of the
bump, `A` bounds its `L¹` norm, and `N + 1` is its number of vanishing
moments. -/
def brsKernelConst (Mu A : ℝ) (N : ℕ) (r : ℝ) : ℝ :=
  5 * (2 * Real.sqrt 5 * Mu) ^ r +
    ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
          (Nat.factorial (N + 1) : ℝ) * A) ^ r *
        ((3 : ℝ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
          -((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) +
      2 * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r

/-- **BRS (5.12).**  The `L^r` norm of `h_k * ψ` for a bump `ψ` at scale `δ`
with `N + 1` vanishing moments is `δ^{1/r - 1/2}`, provided `5δ ≤ 2^{-k}`. -/
theorem lintegral_enorm_brsTruncConv_rpow_le_scale {k : ℕ} {δ M Mu A r : ℝ}
    {ψ : ℝ → ℝ} (hψ : Continuous ψ) (hδ : 0 < δ)
    (h5δ : 5 * δ ≤ (2 : ℝ) ^ (-(k : ℝ)))
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hbd : ∀ y : ℝ, |ψ y| ≤ M)
    (hMnn : 0 ≤ M) (hMu : M * δ ≤ Mu) (hA : (∫ y : ℝ, |ψ y|) ≤ A)
    (hAnn : 0 ≤ A)
    (hAe : (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0) (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, ‖brsTruncConv k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r * δ ^ (1 - r / 2)) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hMunn : 0 ≤ Mu := le_trans (by positivity) hMu
  have hNnn : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  have hδs : (0 : ℝ) ≤ δ ^ (1 - r / 2) := Real.rpow_nonneg hδ.le _
  set w : ℝ := (-(1 / 2) - ((N : ℝ) + 1)) * r + 1 with hw
  have hwneg : w < 0 := by
    rw [hw]
    nlinarith
  have hPnn : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have hfacpos : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos (N + 1)
  set C₁ : ℝ := 5 * (2 * Real.sqrt 5 * Mu) ^ r with hC₁
  set C₂ : ℝ := ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
      (Nat.factorial (N + 1) : ℝ) * A) ^ r *
    ((3 : ℝ) ^ w / -w) with hC₂
  set C₃ : ℝ := 2 * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r with hC₃
  have hC₁nn : 0 ≤ C₁ := by
    rw [hC₁]
    have : (0 : ℝ) ≤ (2 * Real.sqrt 5 * Mu) ^ r :=
      Real.rpow_nonneg (by positivity) _
    linarith
  have hC₂nn : 0 ≤ C₂ := by
    rw [hC₂]
    have h1 : (0 : ℝ) ≤ ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * A) ^ r :=
      Real.rpow_nonneg (by positivity) _
    have h2 : (0 : ℝ) < (3 : ℝ) ^ w := Real.rpow_pos_of_pos (by norm_num) _
    have h3 : (0 : ℝ) < -w := by linarith
    positivity
  have hC₃nn : 0 ≤ C₃ := by
    rw [hC₃]
    have h2 : (0 : ℝ) ≤ (2 : ℝ) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by norm_num) _
    have : (0 : ℝ) ≤ (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r :=
      Real.rpow_nonneg (by positivity) _
    linarith
  refine le_trans (lintegral_enorm_brsTruncConv_rpow_le hψ hδ h5δ hsupp hbd hA
    hAnn hAe hmom hr) ?_
  refine le_trans (add_le_add (add_le_add
    (brsTruncConv_window_one_le hδ hMnn hMu hr0)
    (le_of_eq (brsTruncConv_window_two_le hδ hAnn hr N)))
    (le_of_eq (brsTruncConv_window_three_le hδ hAnn hr0))) ?_
  rw [← ENNReal.ofReal_add (by positivity) (by positivity),
    ← ENNReal.ofReal_add (by positivity) (by positivity)]
  refine ENNReal.ofReal_le_ofReal (le_of_eq ?_)
  rw [brsKernelConst, ← hC₁, ← hC₂, ← hC₃]
  ring


/-! ## Hölder's inequality for three factors

Young's convolution inequality with three different exponents needs the
three-factor form of Hölder, which Mathlib does not carry. -/

/-- **Hölder's inequality for three factors** in `ℝ≥0∞`. -/
theorem lintegral_mul_mul_le_Lp_Lq_Lr {α : Type*} [MeasurableSpace α]
    (μ : Measure α) {a b c : ℝ} (ha : 1 < a) (hb : 1 < b) (hc : 1 < c)
    (habc : a⁻¹ + b⁻¹ + c⁻¹ = 1) {f g h : α → ENNReal}
    (hf : AEMeasurable f μ) (hg : AEMeasurable g μ) (hh : AEMeasurable h μ) :
    (∫⁻ x, f x * g x * h x ∂μ) ≤
      (∫⁻ x, f x ^ a ∂μ) ^ (1 / a) * (∫⁻ x, g x ^ b ∂μ) ^ (1 / b) *
        (∫⁻ x, h x ^ c ∂μ) ^ (1 / c) := by
  have ha0 : (0 : ℝ) < a := lt_trans zero_lt_one ha
  have hb0 : (0 : ℝ) < b := lt_trans zero_lt_one hb
  have hc0 : (0 : ℝ) < c := lt_trans zero_lt_one hc
  set a' : ℝ := a.conjExponent with ha'def
  have hconj : a.HolderConjugate a' := Real.HolderConjugate.conjExponent ha
  have ha'1 : 1 < a' := (Real.holderConjugate_iff.mp hconj.symm).1
  have ha'0 : (0 : ℝ) < a' := lt_trans zero_lt_one ha'1
  have hsum : a⁻¹ + a'⁻¹ = 1 := (Real.holderConjugate_iff.mp hconj).2
  have hbc : b⁻¹ + c⁻¹ = a'⁻¹ := by linarith
  -- the second pair of exponents
  have hB1 : 1 < b / a' := by
    have hcinv : (0 : ℝ) < c⁻¹ := by positivity
    have hlt : b⁻¹ < a'⁻¹ := by linarith
    have h1 : a' * b⁻¹ < 1 := by
      have h := mul_lt_mul_of_pos_left hlt ha'0
      rwa [mul_inv_cancel₀ (ne_of_gt ha'0)] at h
    have h2 : a' < b := by
      have h := mul_lt_mul_of_pos_right h1 hb0
      rwa [mul_assoc, inv_mul_cancel₀ (ne_of_gt hb0), mul_one, one_mul] at h
    exact (one_lt_div ha'0).mpr h2
  have hconj2 : (b / a').HolderConjugate (c / a') := by
    refine Real.holderConjugate_iff.mpr ⟨hB1, ?_⟩
    rw [inv_div, inv_div]
    field_simp
    field_simp at hbc
    linarith [hbc]
  -- first Hölder
  have hstep1 : (∫⁻ x, f x * (g x * h x) ∂μ) ≤
      (∫⁻ x, f x ^ a ∂μ) ^ (1 / a) *
        (∫⁻ x, (g x * h x) ^ a' ∂μ) ^ (1 / a') := by
    have := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hconj hf (hg.mul hh)
    simpa only [Pi.mul_apply] using this
  -- second Hölder
  have hstep2 : (∫⁻ x, (g x * h x) ^ a' ∂μ) ≤
      (∫⁻ x, g x ^ b ∂μ) ^ (a' / b) * (∫⁻ x, h x ^ c ∂μ) ^ (a' / c) := by
    have hmul : ∀ x : α, (g x * h x) ^ a' = g x ^ a' * h x ^ a' := fun x =>
      ENNReal.mul_rpow_of_nonneg _ _ ha'0.le
    have hh1 : AEMeasurable (fun x => g x ^ a') μ := hg.pow_const _
    have hh2 : AEMeasurable (fun x => h x ^ a') μ := hh.pow_const _
    have hol := ENNReal.lintegral_mul_le_Lp_mul_Lq μ hconj2 hh1 hh2
    simp only [Pi.mul_apply] at hol
    have hgb : (∫⁻ x, (g x ^ a') ^ (b / a') ∂μ) = ∫⁻ x, g x ^ b ∂μ := by
      refine lintegral_congr fun x => ?_
      rw [← ENNReal.rpow_mul]
      congr 1
      field_simp
    have hhc : (∫⁻ x, (h x ^ a') ^ (c / a') ∂μ) = ∫⁻ x, h x ^ c ∂μ := by
      refine lintegral_congr fun x => ?_
      rw [← ENNReal.rpow_mul]
      congr 1
      field_simp
    rw [hgb, hhc] at hol
    calc (∫⁻ x, (g x * h x) ^ a' ∂μ)
        = ∫⁻ x, g x ^ a' * h x ^ a' ∂μ := lintegral_congr hmul
      _ ≤ (∫⁻ x, g x ^ b ∂μ) ^ (1 / (b / a')) *
            (∫⁻ x, h x ^ c ∂μ) ^ (1 / (c / a')) := hol
      _ = (∫⁻ x, g x ^ b ∂μ) ^ (a' / b) * (∫⁻ x, h x ^ c ∂μ) ^ (a' / c) := by
          rw [one_div_div, one_div_div]
  -- combine
  have hpow : ((∫⁻ x, g x ^ b ∂μ) ^ (a' / b) *
      (∫⁻ x, h x ^ c ∂μ) ^ (a' / c)) ^ (1 / a') =
      (∫⁻ x, g x ^ b ∂μ) ^ (1 / b) * (∫⁻ x, h x ^ c ∂μ) ^ (1 / c) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
      ← ENNReal.rpow_mul]
    congr 2 <;> field_simp
  calc (∫⁻ x, f x * g x * h x ∂μ)
      = ∫⁻ x, f x * (g x * h x) ∂μ := by
        refine lintegral_congr fun x => ?_
        rw [mul_assoc]
    _ ≤ (∫⁻ x, f x ^ a ∂μ) ^ (1 / a) *
          (∫⁻ x, (g x * h x) ^ a' ∂μ) ^ (1 / a') := hstep1
    _ ≤ (∫⁻ x, f x ^ a ∂μ) ^ (1 / a) *
          ((∫⁻ x, g x ^ b ∂μ) ^ (a' / b) *
            (∫⁻ x, h x ^ c ∂μ) ^ (a' / c)) ^ (1 / a') :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hstep2 (by positivity))
    _ = (∫⁻ x, f x ^ a ∂μ) ^ (1 / a) * (∫⁻ x, g x ^ b ∂μ) ^ (1 / b) *
          (∫⁻ x, h x ^ c ∂μ) ^ (1 / c) := by
        rw [hpow, mul_assoc]


/-! ## Tonelli for a convolution with both factors raised to a power -/

/-- Tonelli for the double integral appearing in Young's inequality. -/
theorem lintegral_convolution_swap' {p r : ℝ} (hr : 0 ≤ r) {K : ℝ → ℝ}
    (hK : Measurable K) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) =
      (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hjoint : Measurable fun z : ℝ × ℝ =>
      ‖K z.2‖ₑ ^ r * ‖g (z.1 - z.2)‖ₑ ^ p := by
    have h1 : Measurable fun z : ℝ × ℝ => ‖K z.2‖ₑ ^ r :=
      ((hK.comp measurable_snd).enorm).pow_const r
    have h2 : Measurable fun z : ℝ × ℝ => ‖g (z.1 - z.2)‖ₑ ^ p :=
      ((hg.comp (measurable_fst.sub measurable_snd)).enorm).pow_const p
    exact h1.mul h2
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  have hinner : ∀ y : ℝ, (∫⁻ x : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) =
      ‖K y‖ₑ ^ r * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
    intro y
    rw [lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hr (enorm_ne_top (x := K y)))]
    congr 1
    exact lintegral_sub_right_eq_self (fun z => ‖g z‖ₑ ^ p) y
  rw [lintegral_congr hinner]
  exact lintegral_mul_const _ (hK.enorm.pow_const r)


/-! ## (5.12): Young's convolution inequality with three exponents

`‖K * g‖_q ≤ ‖K‖_r ‖g‖_p` when `1/p + 1/r = 1 + 1/q`.  The `r = 1` case is
`lintegral_convolution_rpow_le`; the general case needs the three-factor
Hölder inequality. -/

/-- **Young's convolution inequality.** -/
theorem lintegral_convolution_rpow_le_young {p q r : ℝ} (hp : 1 ≤ p)
    (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) {K : ℝ → ℝ} (hK : Measurable K)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q) ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) ^ (q / r) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq1 : (1 : ℝ) < q := lt_trans hr hrq
  have hq0 : (0 : ℝ) < q := lt_trans zero_lt_one hq1
  have hqr : (0 : ℝ) < q - r := by linarith
  have hqp : (0 : ℝ) < q - p := by linarith
  set R : ENNReal := ∫⁻ y : ℝ, ‖K y‖ₑ ^ r with hRdef
  set P : ENNReal := ∫⁻ z : ℝ, ‖g z‖ₑ ^ p with hPdef
  set s : ℝ := r * q / (q - r) with hsdef
  set t : ℝ := p * q / (q - p) with htdef
  have hs1 : (1 : ℝ) < s := by
    rw [hsdef, lt_div_iff₀ hqr, one_mul]
    nlinarith
  have ht1 : (1 : ℝ) < t := by
    rw [htdef, lt_div_iff₀ hqp, one_mul]
    nlinarith
  have hs0 : (0 : ℝ) < s := lt_trans zero_lt_one hs1
  have ht0 : (0 : ℝ) < t := lt_trans zero_lt_one ht1
  have hsinv : 1 / s = 1 / r - 1 / q := by
    rw [hsdef]
    field_simp
  have htinv : 1 / t = 1 / p - 1 / q := by
    rw [htdef]
    field_simp
  have hsum : q⁻¹ + s⁻¹ + t⁻¹ = 1 := by
    simp only [← one_div]
    rw [hsinv, htinv]
    linarith
  -- the two exponent identities used in the pointwise splitting
  have hKexp : r / q + r / s = 1 := by
    rw [div_eq_mul_one_div r q, div_eq_mul_one_div r s, hsinv]
    field_simp
    ring
  have hgexp : p / q + p / t = 1 := by
    rw [div_eq_mul_one_div p q, div_eq_mul_one_div p t, htinv]
    field_simp
    ring
  -- the pointwise estimate
  have hpt : ∀ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) * (R ^ (q / s) * P ^ (q / t)) := by
    intro x
    have hbase : ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ≤
        ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ := by
      refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
      refine lintegral_congr fun y => ?_
      rw [enorm_mul, ← ofReal_norm, Complex.norm_real, ofReal_norm]
    -- the triple splitting
    have hsplit : ∀ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ =
        (‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q) * ‖K y‖ₑ ^ (r / s) *
          ‖g (x - y)‖ₑ ^ (p / t) := by
      intro y
      have hA : ‖K y‖ₑ ^ (r / q) * ‖K y‖ₑ ^ (r / s) = ‖K y‖ₑ := by
        rw [← ENNReal.rpow_add_of_nonneg (r / q) (r / s) (by positivity)
          (by positivity), hKexp, ENNReal.rpow_one]
      have hB : ‖g (x - y)‖ₑ ^ (p / q) * ‖g (x - y)‖ₑ ^ (p / t) =
          ‖g (x - y)‖ₑ := by
        rw [← ENNReal.rpow_add_of_nonneg (p / q) (p / t) (by positivity)
          (by positivity), hgexp, ENNReal.rpow_one]
      have hC : (‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q) =
          ‖K y‖ₑ ^ (r / q) * ‖g (x - y)‖ₑ ^ (p / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
          show r * (1 / q) = r / q by ring, show p * (1 / q) = p / q by ring]
      calc ‖K y‖ₑ * ‖g (x - y)‖ₑ
          = (‖K y‖ₑ ^ (r / q) * ‖K y‖ₑ ^ (r / s)) *
            (‖g (x - y)‖ₑ ^ (p / q) * ‖g (x - y)‖ₑ ^ (p / t)) := by rw [hA, hB]
        _ = (‖K y‖ₑ ^ (r / q) * ‖g (x - y)‖ₑ ^ (p / q)) * ‖K y‖ₑ ^ (r / s) *
            ‖g (x - y)‖ₑ ^ (p / t) := by ring
        _ = (‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q) * ‖K y‖ₑ ^ (r / s) *
            ‖g (x - y)‖ₑ ^ (p / t) := by rw [hC]
    -- three-factor Hölder
    have hm1 : AEMeasurable
        (fun y : ℝ => (‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q)) volume :=
      (((hK.enorm.pow_const r).mul
        (((hg.comp (measurable_const.sub measurable_id)).enorm).pow_const
          p)).pow_const _).aemeasurable
    have hm2 : AEMeasurable (fun y : ℝ => ‖K y‖ₑ ^ (r / s)) volume :=
      (hK.enorm.pow_const _).aemeasurable
    have hm3 : AEMeasurable (fun y : ℝ => ‖g (x - y)‖ₑ ^ (p / t)) volume :=
      (((hg.comp (measurable_const.sub measurable_id)).enorm).pow_const
        _).aemeasurable
    have hol := lintegral_mul_mul_le_Lp_Lq_Lr (volume : Measure ℝ) hq1 hs1 ht1
      hsum hm1 hm2 hm3
    -- identify the three integrals
    have hI1 : (∫⁻ y : ℝ, ((‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q)) ^ q) =
        ∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p := by
      refine lintegral_congr fun y => ?_
      rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
    have hI2 : (∫⁻ y : ℝ, (‖K y‖ₑ ^ (r / s)) ^ s) = R := by
      rw [hRdef]
      refine lintegral_congr fun y => ?_
      rw [← ENNReal.rpow_mul, div_mul_cancel₀ _ hs0.ne']
    have hI3 : (∫⁻ y : ℝ, (‖g (x - y)‖ₑ ^ (p / t)) ^ t) = P := by
      rw [hPdef, ← lintegral_sub_left_eq_self (fun z => ‖g z‖ₑ ^ p) x]
      refine lintegral_congr fun y => ?_
      rw [← ENNReal.rpow_mul, div_mul_cancel₀ _ ht0.ne']
    rw [hI1, hI2, hI3] at hol
    have hchain : ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ≤
        (∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q) *
          R ^ (1 / s) * P ^ (1 / t) := by
      refine le_trans hbase (le_trans (le_of_eq (lintegral_congr hsplit)) hol)
    calc ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q
        ≤ ((∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) ^ (1 / q) *
            R ^ (1 / s) * P ^ (1 / t)) ^ q :=
          ENNReal.rpow_le_rpow hchain hq0.le
      _ = (∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) *
            (R ^ (q / s) * P ^ (q / t)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
            ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
            ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, one_div,
            inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
          rw [show 1 / s * q = q / s by ring, show 1 / t * q = q / t by ring,
            mul_assoc]
  -- the degenerate cases
  by_cases hR0 : R = 0
  · have hz : ∀ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q = 0 := by
      intro x
      refine le_antisymm ?_ zero_le
      have h := hpt x
      rwa [hR0, ENNReal.zero_rpow_of_pos (by positivity), zero_mul,
        mul_zero] at h
    rw [lintegral_congr hz, lintegral_zero]
    exact zero_le
  by_cases hP0 : P = 0
  · have hz : ∀ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q = 0 := by
      intro x
      refine le_antisymm ?_ zero_le
      have h := hpt x
      rwa [hP0, ENNReal.zero_rpow_of_pos (by positivity), mul_zero,
        mul_zero] at h
    rw [lintegral_congr hz, lintegral_zero]
    exact zero_le
  have hPne : P ^ (q / p) ≠ 0 := by
    simp only [ne_eq, ENNReal.rpow_eq_zero_iff, not_or]
    exact ⟨fun h => hP0 h.1,
      fun h => absurd h.2 (not_lt.mpr (by positivity : (0 : ℝ) ≤ q / p))⟩
  have hRne : R ^ (q / r) ≠ 0 := by
    simp only [ne_eq, ENNReal.rpow_eq_zero_iff, not_or]
    exact ⟨fun h => hR0 h.1,
      fun h => absurd h.2 (not_lt.mpr (by positivity : (0 : ℝ) ≤ q / r))⟩
  by_cases hRtop : R = ⊤
  · rw [hRtop, ENNReal.top_rpow_of_pos (by positivity),
      ENNReal.top_mul hPne]
    exact le_top
  by_cases hPtop : P = ⊤
  · rw [hPtop, ENNReal.top_rpow_of_pos (by positivity),
      ENNReal.mul_top hRne]
    exact le_top
  -- the main case
  have hCtop : R ^ (q / s) * P ^ (q / t) ≠ ⊤ := by
    refine ENNReal.mul_ne_top ?_ ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hRtop
    · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hPtop
  have hRsplit : R * R ^ (q / s) = R ^ (q / r) := by
    have hadd : R ^ ((1 : ℝ) + q / s) = R ^ (1 : ℝ) * R ^ (q / s) :=
      ENNReal.rpow_add_of_nonneg (1 : ℝ) (q / s) (by norm_num) (by positivity)
    rw [ENNReal.rpow_one] at hadd
    rw [← hadd]
    congr 1
    rw [show q / s = q * (1 / s) by ring, hsinv]
    field_simp
    ring
  have hPsplit : P * P ^ (q / t) = P ^ (q / p) := by
    have hadd : P ^ ((1 : ℝ) + q / t) = P ^ (1 : ℝ) * P ^ (q / t) :=
      ENNReal.rpow_add_of_nonneg (1 : ℝ) (q / t) (by norm_num) (by positivity)
    rw [ENNReal.rpow_one] at hadd
    rw [← hadd]
    congr 1
    rw [show q / t = q * (1 / t) by ring, htinv]
    field_simp
    ring
  calc (∫⁻ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q)
      ≤ ∫⁻ x : ℝ, (∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) *
          (R ^ (q / s) * P ^ (q / t)) := lintegral_mono hpt
    _ = (∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ ^ r * ‖g (x - y)‖ₑ ^ p) *
          (R ^ (q / s) * P ^ (q / t)) := lintegral_mul_const' _ _ hCtop
    _ = R * P * (R ^ (q / s) * P ^ (q / t)) := by
        rw [lintegral_convolution_swap' hr0.le hK hg, hRdef, hPdef]
    _ = (R * R ^ (q / s)) * (P * P ^ (q / t)) := by ring
    _ = R ^ (q / r) * P ^ (q / p) := by rw [hRsplit, hPsplit]


/-! ## Averaging over a window, measured in `L^q` of the translation

The maximal estimate on an interval bounds `|F(t - r)|` for `t` in a window of
length `δ` by two window averages of translates of `F` and `F'`.  Taking `L^q`
in `r` costs only `δ`, by Hölder on the window followed by Tonelli. -/

/-- **Hölder on the window, then Tonelli.**  The `L^q(dr)` norm of the window
integral of a translate is at most `δ` times the `L^q` norm. -/
theorem lintegral_setLIntegral_translate_rpow_le {q δ : ℝ} (hq : 1 ≤ q)
    (hδ : 0 < δ) (a : ℝ) {H : ℝ → ℂ} (hH : Measurable H) :
    (∫⁻ r : ℝ, (∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖H (s - r)‖ₑ) ^ q) ≤
      ENNReal.ofReal (δ ^ q) * ∫⁻ z : ℝ, ‖H z‖ₑ ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set I : Set ℝ := Icc (a - δ / 2) (a + δ / 2) with hIdef
  have hImeas : MeasurableSet I := measurableSet_Icc
  have hIvol : volume I = ENNReal.ofReal δ := by
    rw [hIdef, Real.volume_Icc]
    congr 1
    ring
  set Q : ENNReal := ∫⁻ z : ℝ, ‖H z‖ₑ ^ q with hQdef
  -- Tonelli for the `q`-th powers
  have hjoint : Measurable fun z : ℝ × ℝ =>
      {w : ℝ × ℝ | w.2 ∈ I}.indicator
        (fun w : ℝ × ℝ => ‖H (w.2 - w.1)‖ₑ ^ q) z := by
    refine Measurable.indicator ?_ (measurable_snd hImeas)
    exact ((hH.comp (measurable_snd.sub measurable_fst)).enorm).pow_const q
  have hswap : (∫⁻ r : ℝ, ∫⁻ s in I, ‖H (s - r)‖ₑ ^ q) =
      ENNReal.ofReal δ * Q := by
    have hL : ∀ r : ℝ, (∫⁻ s in I, ‖H (s - r)‖ₑ ^ q) =
        ∫⁻ s : ℝ, {w : ℝ × ℝ | w.2 ∈ I}.indicator
          (fun w : ℝ × ℝ => ‖H (w.2 - w.1)‖ₑ ^ q) (r, s) := by
      intro r
      rw [← lintegral_indicator hImeas]
      refine lintegral_congr fun s => ?_
      by_cases hs : s ∈ I
      · rw [Set.indicator_of_mem hs,
          Set.indicator_of_mem (show (r, s) ∈ {w : ℝ × ℝ | w.2 ∈ I} from hs)]
      · rw [Set.indicator_of_notMem hs,
          Set.indicator_of_notMem
            (show (r, s) ∉ {w : ℝ × ℝ | w.2 ∈ I} from hs)]
    rw [lintegral_congr hL, lintegral_lintegral_swap hjoint.aemeasurable]
    have hR : ∀ s : ℝ, (∫⁻ r : ℝ, {w : ℝ × ℝ | w.2 ∈ I}.indicator
        (fun w : ℝ × ℝ => ‖H (w.2 - w.1)‖ₑ ^ q) (r, s)) =
        I.indicator (fun _ => Q) s := by
      intro s
      by_cases hs : s ∈ I
      · rw [Set.indicator_of_mem hs, hQdef]
        rw [lintegral_congr fun r => Set.indicator_of_mem
          (show (r, s) ∈ {w : ℝ × ℝ | w.2 ∈ I} from hs) _]
        exact lintegral_sub_left_eq_self (fun z => ‖H z‖ₑ ^ q) s
      · rw [Set.indicator_of_notMem hs]
        rw [lintegral_congr fun r => Set.indicator_of_notMem
          (show (r, s) ∉ {w : ℝ × ℝ | w.2 ∈ I} from hs) _]
        exact lintegral_zero
    rw [lintegral_congr hR, lintegral_indicator hImeas, setLIntegral_const,
      hIvol, mul_comm]
  -- Hölder on the window
  have hholder : ∀ r : ℝ, (∫⁻ s in I, ‖H (s - r)‖ₑ) ^ q ≤
      ENNReal.ofReal (δ ^ (q - 1)) * ∫⁻ s in I, ‖H (s - r)‖ₑ ^ q := by
    intro r
    rcases eq_or_lt_of_le hq with hq1 | hq1
    · rw [← hq1]
      simp only [ENNReal.rpow_one, sub_self]
      rw [Real.rpow_zero, ENNReal.ofReal_one, one_mul]
    · set q' : ℝ := q.conjExponent with hq'def
      have hconj : q.HolderConjugate q' := Real.HolderConjugate.conjExponent hq1
      have hq'1 : 1 < q' := (Real.holderConjugate_iff.mp hconj.symm).1
      have hq'0 : (0 : ℝ) < q' := lt_trans zero_lt_one hq'1
      have hinv : q⁻¹ + q'⁻¹ = 1 := (Real.holderConjugate_iff.mp hconj).2
      have hmeas : AEMeasurable (fun s : ℝ => ‖H (s - r)‖ₑ)
          (volume.restrict I) :=
        ((hH.comp (measurable_id.sub measurable_const)).enorm).aemeasurable
      have hol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict I)
        hconj.symm (aemeasurable_const (b := (1 : ENNReal))) hmeas
      simp only [Pi.mul_apply, one_mul, ENNReal.one_rpow] at hol
      rw [setLIntegral_const, hIvol, one_mul] at hol
      -- raise to the power `q`
      have hstep : (∫⁻ s in I, ‖H (s - r)‖ₑ) ^ q ≤
          ((ENNReal.ofReal δ) ^ (1 / q') *
            (∫⁻ s in I, ‖H (s - r)‖ₑ ^ q) ^ (1 / q)) ^ q :=
        ENNReal.rpow_le_rpow hol hq0.le
      refine le_trans hstep (le_of_eq ?_)
      have hexp : (1 : ℝ) / q' * q = q - 1 := by
        have hq'inv : (1 : ℝ) / q' = 1 - 1 / q := by
          simp only [one_div]
          linarith
        rw [hq'inv]
        field_simp
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
        ← ENNReal.rpow_mul, show (1 : ℝ) / q * q = 1 by field_simp,
        ENNReal.rpow_one, hexp, ← ENNReal.ofReal_rpow_of_pos hδ]
  calc (∫⁻ r : ℝ, (∫⁻ s in I, ‖H (s - r)‖ₑ) ^ q)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal (δ ^ (q - 1)) *
          ∫⁻ s in I, ‖H (s - r)‖ₑ ^ q := lintegral_mono hholder
    _ = ENNReal.ofReal (δ ^ (q - 1)) *
          ∫⁻ r : ℝ, ∫⁻ s in I, ‖H (s - r)‖ₑ ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    _ = ENNReal.ofReal (δ ^ (q - 1)) * (ENNReal.ofReal δ * Q) := by rw [hswap]
    _ = ENNReal.ofReal (δ ^ q) * Q := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hδ.le _)]
        congr 2
        have h := Real.rpow_add hδ (q - 1) 1
        rw [Real.rpow_one] at h
        rw [← h]
        congr 1
        ring


/-! ## (5.13): the window maximal function and its `L^q` norm -/

/-- The measurable majorant of `sup_{t ∈ J} |F(t - r)|` for a window `J` of
length `δ` centred at `a`. -/
def brsWindowMax (F F' : ℝ → ℂ) (a δ : ℝ) (r : ℝ) : ENNReal :=
  ENNReal.ofReal (1 / δ) *
      (∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖F (s - r)‖ₑ) +
    ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖F' (s - r)‖ₑ

theorem measurable_setLIntegral_translate {H : ℝ → ℂ} (hH : Measurable H)
    (a δ : ℝ) :
    Measurable fun r : ℝ =>
      ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖H (s - r)‖ₑ := by
  have hjoint : Measurable fun w : ℝ × ℝ =>
      {w : ℝ × ℝ | w.2 ∈ Icc (a - δ / 2) (a + δ / 2)}.indicator
        (fun w : ℝ × ℝ => ‖H (w.2 - w.1)‖ₑ) w := by
    refine Measurable.indicator ?_ (measurable_snd measurableSet_Icc)
    exact (hH.comp (measurable_snd.sub measurable_fst)).enorm
  have hkey := hjoint.lintegral_prod_right' (ν := (volume : Measure ℝ))
  have heq : (fun r : ℝ => ∫⁻ y : ℝ,
      {w : ℝ × ℝ | w.2 ∈ Icc (a - δ / 2) (a + δ / 2)}.indicator
        (fun w : ℝ × ℝ => ‖H (w.2 - w.1)‖ₑ) (r, y)) =
      fun r : ℝ => ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖H (s - r)‖ₑ := by
    funext r
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Icc (a - δ / 2) (a + δ / 2)
    · rw [Set.indicator_of_mem hs, Set.indicator_of_mem
        (show (r, s) ∈ {w : ℝ × ℝ | w.2 ∈ Icc (a - δ / 2) (a + δ / 2)} from hs)]
    · rw [Set.indicator_of_notMem hs, Set.indicator_of_notMem
        (show (r, s) ∉ {w : ℝ × ℝ | w.2 ∈ Icc (a - δ / 2) (a + δ / 2)} from hs)]
  rw [← heq]
  exact hkey

theorem measurable_brsWindowMax {F F' : ℝ → ℂ} (hF : Measurable F)
    (hF' : Measurable F') (a δ : ℝ) :
    Measurable (brsWindowMax F F' a δ) := by
  refine Measurable.add ?_ (measurable_setLIntegral_translate hF' a δ)
  exact (measurable_setLIntegral_translate hF a δ).const_mul _

/-- **The window maximal bound.**  The supremum over a window of length `δ` is
dominated by the window averages of `F` and `F'`. -/
theorem iSup_enorm_translate_le_brsWindowMax {F F' : ℝ → ℂ} (hF : Continuous F)
    (hF' : Continuous F') (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x)
    {a δ : ℝ} (hδ : 0 < δ) (r : ℝ) :
    (⨆ t ∈ Icc (a - δ / 2) (a + δ / 2), ‖F (t - r)‖ₑ) ≤
      brsWindowMax F F' a δ r := by
  set G : ℝ → ℂ := fun t => F (t - r) with hG
  set G' : ℝ → ℂ := fun t => F' (t - r) with hG'
  have hGd : ∀ x : ℝ, HasDerivAt G (G' x) x := fun x =>
    HasDerivAt.comp_sub_const x r (hderiv (x - r))
  have hGc : Continuous G := hF.comp (continuous_id.sub continuous_const)
  have hG'c : Continuous G' := hF'.comp (continuous_id.sub continuous_const)
  have hlt : a - δ / 2 < a + δ / 2 := by linarith
  have hlen : a + δ / 2 - (a - δ / 2) = δ := by ring
  refine iSup₂_le fun t ht => ?_
  have hmax := norm_le_average_add_integral_deriv hlt (fun x _ => hGd x)
    (hG'c.intervalIntegrable _ _) (hGc.intervalIntegrable _ _) ht
  rw [hlen] at hmax
  -- transfer the two Bochner integrals to lower integrals
  have htrans : ∀ H : ℝ → ℂ, Continuous H →
      ENNReal.ofReal (∫ s in (a - δ / 2)..(a + δ / 2), ‖H s‖) ≤
        ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖H s‖ₑ := by
    intro H hHc
    rw [intervalIntegral.integral_of_le hlt.le]
    have hint : IntegrableOn (fun s => ‖H s‖) (Ioc (a - δ / 2) (a + δ / 2))
        volume := (hHc.norm.integrableOn_Icc).mono_set Ioc_subset_Icc_self
    have hnn : 0 ≤ᵐ[volume.restrict (Ioc (a - δ / 2) (a + δ / 2))]
        fun s => ‖H s‖ := Filter.Eventually.of_forall fun s => norm_nonneg _
    calc ENNReal.ofReal (∫ s in Ioc (a - δ / 2) (a + δ / 2), ‖H s‖)
        = ∫⁻ s in Ioc (a - δ / 2) (a + δ / 2), ENNReal.ofReal ‖H s‖ :=
          ofReal_integral_eq_lintegral_ofReal hint hnn
      _ = ∫⁻ s in Ioc (a - δ / 2) (a + δ / 2), ‖H s‖ₑ := by
          simp only [ofReal_norm]
      _ ≤ ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖H s‖ₑ :=
          lintegral_mono_set Ioc_subset_Icc_self
  have h1 := htrans G hGc
  have h2 := htrans G' hG'c
  have hstep : ‖F (t - r)‖ₑ ≤
      ENNReal.ofReal ((1 / δ) * (∫ s in (a - δ / 2)..(a + δ / 2), ‖G s‖)) +
        ENNReal.ofReal (∫ s in (a - δ / 2)..(a + δ / 2), ‖G' s‖) := by
    have : ‖F (t - r)‖ₑ = ENNReal.ofReal ‖G t‖ := by
      rw [hG, ← ofReal_norm]
    rw [this]
    exact le_trans (ENNReal.ofReal_le_ofReal hmax) ENNReal.ofReal_add_le
  refine le_trans hstep ?_
  rw [brsWindowMax]
  refine add_le_add ?_ h2
  rw [ENNReal.ofReal_mul (by positivity)]
  exact mul_le_mul' le_rfl h1

/-- **The `L^q` norm of the window maximal function.** -/
theorem lintegral_brsWindowMax_rpow_le {F F' : ℝ → ℂ} (hF : Measurable F)
    (hF' : Measurable F') {a δ q : ℝ} (hδ : 0 < δ) (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsWindowMax F F' a δ r ^ q) ^ (1 / q) ≤
      (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) +
        ENNReal.ofReal δ * (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set A : ℝ → ENNReal := fun r => ENNReal.ofReal (1 / δ) *
    ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖F (s - r)‖ₑ with hA
  set B : ℝ → ENNReal := fun r =>
    ∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖F' (s - r)‖ₑ with hB
  have hAm : AEMeasurable A volume :=
    ((measurable_setLIntegral_translate hF a δ).const_mul _).aemeasurable
  have hBm : AEMeasurable B volume :=
    (measurable_setLIntegral_translate hF' a δ).aemeasurable
  have hsum : (∫⁻ r : ℝ, brsWindowMax F F' a δ r ^ q) ^ (1 / q) ≤
      (∫⁻ r : ℝ, A r ^ q) ^ (1 / q) + (∫⁻ r : ℝ, B r ^ q) ^ (1 / q) := by
    have h := ENNReal.lintegral_Lp_add_le hAm hBm hq
    simpa only [Pi.add_apply, hA, hB, brsWindowMax] using h
  refine le_trans hsum (add_le_add ?_ ?_)
  · -- the `F` term
    have hbound : (∫⁻ r : ℝ, A r ^ q) ≤
        ENNReal.ofReal ((1 / δ) ^ q) *
          (ENNReal.ofReal (δ ^ q) * ∫⁻ z : ℝ, ‖F z‖ₑ ^ q) := by
      have hsplit : ∀ r : ℝ, A r ^ q = ENNReal.ofReal ((1 / δ) ^ q) *
          (∫⁻ s in Icc (a - δ / 2) (a + δ / 2), ‖F (s - r)‖ₑ) ^ q := by
        intro r
        rw [hA]
        simp only
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
          ENNReal.ofReal_rpow_of_pos (by positivity)]
      rw [lintegral_congr hsplit,
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      exact mul_le_mul' le_rfl
        (lintegral_setLIntegral_translate_rpow_le hq hδ a hF)
    refine le_trans (ENNReal.rpow_le_rpow hbound (by positivity)) (le_of_eq ?_)
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity),
      show ((1 / δ) ^ q * δ ^ q : ℝ) = 1 by
        rw [← Real.mul_rpow (by positivity) hδ.le]
        rw [one_div, inv_mul_cancel₀ hδ.ne', Real.one_rpow],
      ENNReal.ofReal_one, one_mul]
  · -- the `F'` term
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_setLIntegral_translate_rpow_le hq hδ a hF') (by positivity))
      (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
    congr 1
    rw [ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < δ ^ q),
      ← Real.rpow_mul hδ.le, mul_one_div, div_self hq0.ne', Real.rpow_one]


/-! ## (5.13) with the covering: the localized maximal function in `L^q`

Combining the window maximal bound with an interval cover of `E` of mesh `δ`
gives the `L^q(dr)` bound for `sup_{t ∈ E} |F(t - r)|`, with the covering number
entering as `N^{1/q}`. -/

/-- **The localized maximal estimate in `L^q`.** -/
theorem lintegral_iSup_enorm_translate_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) +
          ENNReal.ofReal δ * (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set S : ENNReal := (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) +
    ENNReal.ofReal δ * (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) with hS
  -- the pointwise majorant
  have hpt : ∀ r : ℝ, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q ≤
      ∑ a ∈ ι, brsWindowMax F F' a δ r ^ q := by
    intro r
    have hcover : (⨆ t ∈ E, ‖F (t - r)‖ₑ) ≤
        ⨆ a ∈ ι, brsWindowMax F F' a δ r := by
      refine iSup₂_le fun t ht => ?_
      obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov ht)
      refine le_trans ?_ (le_iSup₂ (f := fun a (_ : a ∈ ι) =>
        brsWindowMax F F' a δ r) a ha)
      refine le_trans ?_ (iSup_enorm_translate_le_brsWindowMax hF hF' hderiv
        hδ r)
      exact le_iSup₂ (f := fun t (_ : t ∈ Icc (a - δ / 2) (a + δ / 2)) =>
        ‖F (t - r)‖ₑ) t hmem
    refine le_trans (ENNReal.rpow_le_rpow hcover hq0.le) ?_
    exact iSup_rpow_le_sum hq0 ι (fun a => brsWindowMax F F' a δ r)
  -- integrate
  have hmeas : ∀ a ∈ ι,
      AEMeasurable (fun r : ℝ => brsWindowMax F F' a δ r ^ q) volume :=
    fun a _ =>
      ((measurable_brsWindowMax hF.measurable hF'.measurable a δ).pow_const
        q).aemeasurable
  have hterm : ∀ a : ℝ, (∫⁻ r : ℝ, brsWindowMax F F' a δ r ^ q) ≤ S ^ q := by
    intro a
    have h := lintegral_brsWindowMax_rpow_le hF.measurable hF'.measurable
      (a := a) hδ hq
    have h2 := ENNReal.rpow_le_rpow h hq0.le
    rw [← ENNReal.rpow_mul, show (1 : ℝ) / q * q = 1 by field_simp,
      ENNReal.rpow_one] at h2
    rw [hS]
    exact h2
  calc (∫⁻ r : ℝ, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q)
      ≤ ∫⁻ r : ℝ, ∑ a ∈ ι, brsWindowMax F F' a δ r ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r : ℝ, brsWindowMax F F' a δ r ^ q :=
        lintegral_finsetSum' ι hmeas
    _ ≤ ∑ _a ∈ ι, S ^ q := Finset.sum_le_sum fun a _ => hterm a
    _ = (ι.card : ENNReal) * S ^ q := by
        rw [Finset.sum_const, nsmul_eq_mul]


/-! ## The truncated kernel is integrable, and `h_k * ψ` is as smooth as `ψ` -/

theorem integrable_brsTruncKernel (k : ℕ) :
    Integrable (brsTruncKernel k) volume := by
  refine ⟨(measurable_brsTruncKernel k).aestronglyMeasurable, ?_⟩
  rw [hasFiniteIntegral_iff_enorm]
  have hval : (∫⁻ y : ℝ, ‖brsTruncKernel k y‖ₑ) =
      ENNReal.ofReal (2 * (2 : ℝ) ^ (-(k : ℝ) / 2)) := by
    rw [← lintegral_brsTruncKernel k]
    exact lintegral_congr fun y => enorm_brsTruncKernel k y
  rw [hval]
  exact ENNReal.ofReal_lt_top

theorem locallyIntegrable_brsTruncKernel (k : ℕ) :
    LocallyIntegrable (brsTruncKernel k) volume :=
  (integrable_brsTruncKernel k).locallyIntegrable

/-- The real-valued form of the kernel `h_k * ψ`. -/
def brsTruncConvReal (k : ℕ) (ψ : ℝ → ℝ) (x : ℝ) : ℝ :=
  ∫ y : ℝ, brsTruncKernel k (x - y) * ψ y

theorem brsTruncConv_eq_ofReal (k : ℕ) (ψ : ℝ → ℝ) (x : ℝ) :
    brsTruncConv k ψ x = ((brsTruncConvReal k ψ x : ℝ) : ℂ) := by
  have h : ∀ y : ℝ, ((brsTruncKernel k (x - y) : ℝ) : ℂ) * (ψ y : ℂ) =
      ((brsTruncKernel k (x - y) * ψ y : ℝ) : ℂ) := fun y => by
    rw [Complex.ofReal_mul]
  rw [brsTruncConv, brsTruncConvReal,
    integral_congr_ae (Filter.Eventually.of_forall h)]
  exact integral_ofReal

theorem enorm_brsTruncConv (k : ℕ) (ψ : ℝ → ℝ) (x : ℝ) :
    ‖brsTruncConv k ψ x‖ₑ = ‖brsTruncConvReal k ψ x‖ₑ := by
  rw [brsTruncConv_eq_ofReal, ← ofReal_norm, Complex.norm_real, ofReal_norm]

/-- `h_k * ψ` is Mathlib's convolution `ψ ⋆ h_k`. -/
theorem brsTruncConvReal_eq_convolution (k : ℕ) (ψ : ℝ → ℝ) :
    brsTruncConvReal k ψ =
      (ψ ⋆[(ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ), volume]
        brsTruncKernel k) := by
  funext x
  rw [brsTruncConvReal, convolution]
  simp only [ContinuousLinearMap.mul_apply']
  have hswap : (∫ y : ℝ, brsTruncKernel k (x - y) * ψ y) =
      ∫ y : ℝ, ψ y * brsTruncKernel k (x - y) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    ring
  rw [hswap]

/-- **`h_k * ψ` inherits the smoothness of `ψ`.** -/
theorem contDiff_brsTruncConvReal (k : ℕ) {ψ : ℝ → ℝ} {n : ℕ}
    (hψ : ContDiff ℝ n ψ) (hcs : HasCompactSupport ψ) :
    ContDiff ℝ n (brsTruncConvReal k ψ) := by
  rw [brsTruncConvReal_eq_convolution k ψ]
  exact HasCompactSupport.contDiff_convolution_left
    (ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ) hcs hψ
    (locallyIntegrable_brsTruncKernel k)


/-! ## Support and derivative of the kernel `h_k * ψ` -/

theorem hasCompactSupport_brsTruncKernel (k : ℕ) :
    HasCompactSupport (brsTruncKernel k) := by
  refine HasCompactSupport.intro
    (isCompact_Icc (a := (0 : ℝ)) (b := (2 : ℝ) ^ (-(k : ℝ)))) ?_
  intro x hx
  rw [brsTruncKernel]
  refine Set.indicator_of_notMem ?_ _
  intro hc
  exact hx ⟨hc.1.le, hc.2⟩

theorem hasCompactSupport_brsTruncConvReal (k : ℕ) {ψ : ℝ → ℝ}
    (hcs : HasCompactSupport ψ) :
    HasCompactSupport (brsTruncConvReal k ψ) := by
  rw [brsTruncConvReal_eq_convolution k ψ]
  exact HasCompactSupport.convolution
    (ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ) hcs
    (hasCompactSupport_brsTruncKernel k)

/-- **The derivative of `h_k * ψ` falls on `ψ`.** -/
theorem hasDerivAt_brsTruncConvReal (k : ℕ) {ψ : ℝ → ℝ}
    (hcs : HasCompactSupport ψ) (hψ : ContDiff ℝ 1 ψ) (x : ℝ) :
    HasDerivAt (brsTruncConvReal k ψ) (brsTruncConvReal k (deriv ψ) x) x := by
  have h := HasCompactSupport.hasDerivAt_convolution_left
    (L := (ContinuousLinearMap.mul ℝ ℝ : ℝ →L[ℝ] ℝ →L[ℝ] ℝ))
    (μ := (volume : Measure ℝ)) hcs hψ (locallyIntegrable_brsTruncKernel k) x
  rw [← brsTruncConvReal_eq_convolution k (deriv ψ),
    ← brsTruncConvReal_eq_convolution k ψ] at h
  exact h

theorem continuous_brsTruncConvReal (k : ℕ) {ψ : ℝ → ℝ}
    (hcs : HasCompactSupport ψ) (hψ : ContDiff ℝ 1 ψ) :
    Continuous (brsTruncConvReal k ψ) :=
  (contDiff_brsTruncConvReal k (n := 1) hψ hcs).continuous


/-! ## (5.9): the analytic core

The maximal function of `𝒜_{k,m}` over `E`, measured in `L^q` of the radius, is
controlled by the covering number of `E` at the scale `δ = 2^{-k-m}` of the bump
together with the `L^r` norms of the kernels `h_k * υ` and `h_k * υ'`.  The
exponents are those of Young's inequality, `1/p + 1/r = 1 + 1/q`. -/

/-- Rewriting the `L^q` bound coming out of Young's inequality. -/
theorem young_rpow_inv {A B : ENNReal} {p q r : ℝ} (hp : 0 < p) (hq : 0 < q)
    (hr : 0 < r) :
    (A ^ (q / r) * B ^ (q / p)) ^ (1 / q) = A ^ (1 / r) * B ^ (1 / p) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul, show q / r * (1 / q) = 1 / r by field_simp,
    show q / p * (1 / q) = 1 / p by field_simp]

/-- **The core of BRS (5.9).** -/
theorem brs_5_9_core {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E δ ι) (k : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, (⨆ t ∈ E, ‖∫ y : ℝ,
        ((brsTruncConvReal k υ y : ℝ) : ℂ) * g (t - x - y)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq1 : (1 : ℝ) < q := lt_trans hr hrq
  have hq0 : (0 : ℝ) < q := lt_trans zero_lt_one hq1
  set K : ℝ → ℝ := brsTruncConvReal k υ with hKdef
  set K' : ℝ → ℝ := brsTruncConvReal k (deriv υ) with hK'def
  have hKcs : HasCompactSupport K := hasCompactSupport_brsTruncConvReal k hcs
  have hKcd : ContDiff ℝ 1 K := contDiff_brsTruncConvReal k (n := 1) hυ hcs
  have hK'cs : HasCompactSupport K' := hasCompactSupport_brsTruncConvReal k hcs'
  have hK'cd : ContDiff ℝ 1 K' :=
    contDiff_brsTruncConvReal k (n := 1) hυ' hcs'
  have hKm : Measurable K := hKcd.continuous.measurable
  have hK'm : Measurable K' := hK'cd.continuous.measurable
  have hderivK : deriv K = K' := by
    funext x
    exact (hasDerivAt_brsTruncConvReal k hcs hυ x).deriv
  set F : ℝ → ℂ := fun x => ∫ y : ℝ, (K y : ℂ) * g (x - y) with hFdef
  set F' : ℝ → ℂ := fun x => ∫ y : ℝ, (K' y : ℂ) * g (x - y) with hF'def
  have hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x := by
    intro x
    have h := hasDerivAt_kernel_convolution hKcs hKcd hg x
    rw [hderivK] at h
    exact h
  have hFdiff : Differentiable ℝ F := fun x => (hderiv x).differentiableAt
  have hFcont : Continuous F := hFdiff.continuous
  have hF'cont : Continuous F' := by
    have hd2 : ∀ x : ℝ, HasDerivAt F'
        (∫ y : ℝ, ((deriv K' y : ℝ) : ℂ) * g (x - y)) x := fun x =>
      hasDerivAt_kernel_convolution hK'cs hK'cd hg x
    have hF'diff : Differentiable ℝ F' := fun x => (hd2 x).differentiableAt
    exact hF'diff.continuous
  -- the two Young bounds
  have hyoung : ∀ H : ℝ → ℝ, Measurable H →
      (∫⁻ z : ℝ, ‖∫ y : ℝ, (H y : ℂ) * g (z - y)‖ₑ ^ q) ^ (1 / q) ≤
        (∫⁻ y : ℝ, ‖H y‖ₑ ^ r) ^ (1 / r) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    intro H hH
    have h := lintegral_convolution_rpow_le_young hp hr hrq hpq hrel hH
      hg.measurable
    refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
    exact young_rpow_inv hp0 hq0 hr0
  refine le_trans (lintegral_iSup_enorm_translate_rpow_le hδ hcov hFcont
    hF'cont hderiv hq1.le) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact add_le_add (hyoung K hKm) (mul_le_mul' le_rfl (hyoung K' hK'm))


/-! ## The dilated bump, and the kernel bound in real form -/

/-- BRS (5.12) for the real-valued kernel. -/
theorem lintegral_enorm_brsTruncConvReal_rpow_le_scale {k : ℕ} {δ M Mu A r : ℝ}
    {ψ : ℝ → ℝ} (hψ : Continuous ψ) (hδ : 0 < δ)
    (h5δ : 5 * δ ≤ (2 : ℝ) ^ (-(k : ℝ)))
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) (hbd : ∀ y : ℝ, |ψ y| ≤ M)
    (hMnn : 0 ≤ M) (hMu : M * δ ≤ Mu) (hA : (∫ y : ℝ, |ψ y|) ≤ A)
    (hAnn : 0 ≤ A)
    (hAe : (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A) {N : ℕ}
    (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * ψ y) = 0) (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r * δ ^ (1 - r / 2)) := by
  have heq : (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r) =
      ∫⁻ x : ℝ, ‖brsTruncConv k ψ x‖ₑ ^ r :=
    lintegral_congr fun x => by rw [enorm_brsTruncConv k ψ x]
  rw [heq]
  exact lintegral_enorm_brsTruncConv_rpow_le_scale hψ hδ h5δ hsupp hbd hMnn hMu
    hA hAnn hAe hmom hr

/-- The height of a dilate. -/
theorem abs_brsDilate_le {φ : ℝ → ℝ} {M : ℝ} (hbd : ∀ x : ℝ, |φ x| ≤ M)
    (j : ℕ) (y : ℝ) : |brsDilate φ j y| ≤ (2 : ℝ) ^ j * M := by
  show |(2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * y)| ≤ (2 : ℝ) ^ j * M
  rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ j)]
  exact mul_le_mul_of_nonneg_left (hbd _) (by positivity)

/-- The support of a dilate, in the form used downstream. -/
theorem brsDilate_eq_zero_of_abs_gt {φ : ℝ → ℝ} {R : ℝ}
    (hR : tsupport φ ⊆ Metric.closedBall 0 R) (j : ℕ) {y : ℝ}
    (hy : R / 2 ^ j < |y|) : brsDilate φ j y = 0 :=
  brsDilate_eq_zero_of_lt hR j hy

/-- **The derivative of a dilate.** -/
theorem deriv_brsDilate {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (j : ℕ) :
    deriv (brsDilate φ j) = fun y : ℝ => (2 : ℝ) ^ j * brsDilate (deriv φ) j y := by
  have hdiff : Differentiable ℝ φ := hφ.differentiable (by norm_num)
  funext y
  have h1 : HasDerivAt (fun z : ℝ => (2 : ℝ) ^ j * z) ((2 : ℝ) ^ j) y := by
    simpa using (hasDerivAt_id y).const_mul ((2 : ℝ) ^ j)
  have h2 : HasDerivAt φ (deriv φ ((2 : ℝ) ^ j * y)) ((2 : ℝ) ^ j * y) :=
    (hdiff ((2 : ℝ) ^ j * y)).hasDerivAt
  have h3 : HasDerivAt (fun z : ℝ => φ ((2 : ℝ) ^ j * z))
      (deriv φ ((2 : ℝ) ^ j * y) * (2 : ℝ) ^ j) y := h2.comp y h1
  have h4 : HasDerivAt (brsDilate φ j)
      ((2 : ℝ) ^ j * (deriv φ ((2 : ℝ) ^ j * y) * (2 : ℝ) ^ j)) y :=
    h3.const_mul ((2 : ℝ) ^ j)
  rw [h4.deriv]
  show (2 : ℝ) ^ j * (deriv φ ((2 : ℝ) ^ j * y) * (2 : ℝ) ^ j) =
    (2 : ℝ) ^ j * ((2 : ℝ) ^ j * deriv φ ((2 : ℝ) ^ j * y))
  ring


/-! ## The kernel bound for a dilated bump -/

theorem rpow_neg_natCast_two (j : ℕ) : (2 : ℝ) ^ (-(j : ℝ)) = ((2 : ℝ) ^ j)⁻¹ := by
  rw [Real.rpow_neg (by norm_num), Real.rpow_natCast]

theorem lintegral_ofReal_abs_le_of_integrable {ψ : ℝ → ℝ}
    (h : Integrable ψ volume) {A : ℝ} (hA : (∫ y : ℝ, |ψ y|) ≤ A) :
    (∫⁻ y : ℝ, ENNReal.ofReal |ψ y|) ≤ ENNReal.ofReal A := by
  have hnn : 0 ≤ᵐ[volume] fun y : ℝ => |ψ y| :=
    Filter.Eventually.of_forall fun y => abs_nonneg _
  rw [← ofReal_integral_eq_lintegral_ofReal h.abs hnn]
  exact ENNReal.ofReal_le_ofReal hA

/-- The derivative of a dilate is again a dilate. -/
theorem deriv_brsDilate_eq {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (j : ℕ) :
    deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j := by
  rw [deriv_brsDilate hφ]
  funext y
  show (2 : ℝ) ^ j * ((2 : ℝ) ^ j * deriv φ ((2 : ℝ) ^ j * y)) =
    (2 : ℝ) ^ j * ((2 : ℝ) ^ j * deriv φ ((2 : ℝ) ^ j * y))
  rfl

/-- **BRS (5.12) for a dilated bump.**  The `L^r` norm of `h_k * υ_j` is
`(2^{-j})^{1/r - 1/2}`. -/
theorem lintegral_enorm_brsTruncConvReal_dilate_le {k j : ℕ} {υ : ℝ → ℝ}
    {Mu A r : ℝ} (hυc : Continuous υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A) (hAnn : 0 ≤ A)
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hr : 1 ≤ r) (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k (brsDilate υ j) x‖ₑ ^ r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r *
        ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 - r / 2)) := by
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hinv : (2 : ℝ) ^ (-(j : ℝ)) = ((2 : ℝ) ^ j)⁻¹ := rpow_neg_natCast_two j
  refine lintegral_enorm_brsTruncConvReal_rpow_le_scale
    (continuous_brsDilate hυc j) hδ hkj ?_ (abs_brsDilate_le hbd j)
    (by positivity) ?_ ?_ hAnn ?_ ?_ hr
  · -- the support
    intro y hy
    refine brsDilate_eq_zero_of_lt hR j ?_
    rwa [show (1 : ℝ) / 2 ^ j = (2 : ℝ) ^ (-(j : ℝ)) by rw [hinv, one_div]]
  · -- `M · δ ≤ Mu`
    rw [hinv]
    exact le_of_eq (by field_simp)
  · -- the `L¹` norm
    rw [integral_abs_brsDilate]
    exact hA
  · -- the `L¹` norm, in `ℝ≥0∞`
    refine lintegral_ofReal_abs_le_of_integrable ?_ ?_
    · exact (continuous_brsDilate hυc j).integrable_of_hasCompactSupport
        (hasCompactSupport_brsDilate hcs j)
    · rw [integral_abs_brsDilate]
      exact hA
  · -- the vanishing moments
    intro i hi
    rw [integral_pow_mul_brsDilate hυc hcs i j, hmom i hi, mul_zero]


/-! ## Homogeneity of the kernel constant, and taking the `r`-th root -/

/-- The kernel constant is homogeneous of degree `r` in the size of the bump. -/
theorem brsKernelConst_smul {Mu A lam r : ℝ} (hlam : 0 ≤ lam) (hMu : 0 ≤ Mu)
    (hA : 0 ≤ A) (N : ℕ) :
    brsKernelConst (lam * Mu) (lam * A) N r =
      lam ^ r * brsKernelConst Mu A N r := by
  have hPnn : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have hfacpos : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos (N + 1)
  have h2nn : (0 : ℝ) ≤ (2 : ℝ) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by norm_num) _
  have e1 : (2 * Real.sqrt 5 * (lam * Mu)) ^ r =
      lam ^ r * (2 * Real.sqrt 5 * Mu) ^ r := by
    rw [show 2 * Real.sqrt 5 * (lam * Mu) = lam * (2 * Real.sqrt 5 * Mu) by ring,
      Real.mul_rpow hlam (by positivity)]
  have e2 : ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * (lam * A)) ^ r =
      lam ^ r * ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * A) ^ r := by
    rw [show (∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * (lam * A) =
        lam * ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
          (Nat.factorial (N + 1) : ℝ) * A) by ring,
      Real.mul_rpow hlam (by positivity)]
  have e3 : ((lam * A) * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r =
      lam ^ r * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r := by
    rw [show lam * A * (2 : ℝ) ^ (-(1 / 2) : ℝ) =
        lam * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) by ring,
      Real.mul_rpow hlam (by positivity)]
  rw [brsKernelConst, brsKernelConst, e1, e2, e3]
  ring

/-- Taking the `r`-th root of the kernel bound. -/
theorem kernel_scale_rpow {C δ r : ℝ} (hC : 0 ≤ C) (hδ : 0 < δ) (hr : 0 < r) :
    (C * δ ^ (1 - r / 2)) ^ (1 / r) = C ^ (1 / r) * δ ^ (1 / r - 1 / 2) := by
  rw [Real.mul_rpow hC (Real.rpow_nonneg hδ.le _), ← Real.rpow_mul hδ.le]
  congr 2
  field_simp

theorem rpow_inv_of_le_ofReal {X : ENNReal} {C : ℝ} (hC : 0 ≤ C) {r : ℝ}
    (hr : 0 < r) (h : X ≤ ENNReal.ofReal C) :
    X ^ (1 / r) ≤ ENNReal.ofReal (C ^ (1 / r)) := by
  refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
  rw [ENNReal.ofReal_rpow_of_nonneg hC (by positivity)]


/-! ## Elementary properties of a rescaled bump -/

theorem contDiff_brsDilate {φ : ℝ → ℝ} {n : ℕ} (hφ : ContDiff ℝ n φ) (j : ℕ) :
    ContDiff ℝ n (brsDilate φ j) := by
  show ContDiff ℝ n fun x : ℝ => (2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * x)
  exact contDiff_const.mul (hφ.comp (contDiff_const.mul contDiff_id))

theorem support_const_mul_eq {φ : ℝ → ℝ} {c : ℝ} (hc : c ≠ 0) :
    Function.support (fun x : ℝ => c * φ x) = Function.support φ := by
  ext x
  simp only [Function.mem_support, ne_eq, mul_eq_zero, not_or]
  constructor
  · intro h
    exact h.2
  · intro h
    exact ⟨hc, h⟩

theorem tsupport_const_mul_eq {φ : ℝ → ℝ} {c : ℝ} (hc : c ≠ 0) :
    tsupport (fun x : ℝ => c * φ x) = tsupport φ := by
  rw [tsupport, tsupport, support_const_mul_eq hc]

theorem hasCompactSupport_const_mul {φ : ℝ → ℝ} {c : ℝ} (hc : c ≠ 0)
    (h : HasCompactSupport φ) : HasCompactSupport (fun x : ℝ => c * φ x) := by
  rw [HasCompactSupport, tsupport_const_mul_eq hc]
  exact h

theorem integral_abs_const_mul {φ : ℝ → ℝ} {c : ℝ} (hc : 0 ≤ c) :
    (∫ y : ℝ, |c * φ y|) = c * ∫ y : ℝ, |φ y| := by
  rw [← integral_const_mul]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  show |c * φ y| = c * |φ y|
  rw [abs_mul, abs_of_nonneg hc]


/-! ## (5.9) for a dilated bump -/

theorem brsKernelConst_nonneg {Mu A : ℝ} (hMu : 0 ≤ Mu) (hA : 0 ≤ A) (N : ℕ)
    {r : ℝ} (hr : 1 ≤ r) : 0 ≤ brsKernelConst Mu A N r := by
  have hNnn : (0 : ℝ) ≤ (N : ℝ) := Nat.cast_nonneg N
  have hwneg : (-(1 / 2) - ((N : ℝ) + 1)) * r + 1 < 0 := by nlinarith
  have hPnn : (0 : ℝ) ≤ ∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ)) := by
    refine Finset.prod_nonneg fun i _ => ?_
    have : (0 : ℝ) ≤ (i : ℝ) := Nat.cast_nonneg i
    linarith
  have hfacpos : (0 : ℝ) < (Nat.factorial (N + 1) : ℝ) := by
    exact_mod_cast Nat.factorial_pos (N + 1)
  have h1 : (0 : ℝ) ≤ 5 * (2 * Real.sqrt 5 * Mu) ^ r := by
    have : (0 : ℝ) ≤ (2 * Real.sqrt 5 * Mu) ^ r :=
      Real.rpow_nonneg (by positivity) _
    linarith
  have h2 : (0 : ℝ) ≤ ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * A) ^ r *
      ((3 : ℝ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) /
        -((-(1 / 2) - ((N : ℝ) + 1)) * r + 1)) := by
    have ha : (0 : ℝ) ≤ ((∏ i ∈ Finset.range (N + 1), ((1 : ℝ) / 2 + (i : ℝ))) /
        (Nat.factorial (N + 1) : ℝ) * A) ^ r :=
      Real.rpow_nonneg (by positivity) _
    have hb : (0 : ℝ) < (3 : ℝ) ^ ((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    have hc : (0 : ℝ) < -((-(1 / 2) - ((N : ℝ) + 1)) * r + 1) := by linarith
    positivity
  have h3 : (0 : ℝ) ≤ 2 * (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r := by
    have h2' : (0 : ℝ) ≤ (2 : ℝ) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by norm_num) _
    have : (0 : ℝ) ≤ (A * (2 : ℝ) ^ (-(1 / 2) : ℝ)) ^ r :=
      Real.rpow_nonneg (by positivity) _
    linarith
  rw [brsKernelConst]
  linarith

/-- **BRS (5.9) for a dilated bump.**  The maximal function over `E` of the
smoothed operator at scale `2^{-j}` obeys the `L^q` bound with the covering
number of `E` at that scale, and the gain `(2^{-j})^{1/r - 1/2}`. -/
theorem brs_5_9_dilate {E : Set ℝ} {ι : Finset ℝ} {k j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    (∫⁻ x : ℝ, (⨆ t ∈ E, ‖∫ y : ℝ,
        ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
          g (t - x - y)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
              brsKernelConst Mu' A' N r ^ (1 / r)) *
            ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  set δ : ℝ := (2 : ℝ) ^ (-(j : ℝ)) with hδdef
  have hδ : (0 : ℝ) < δ := Real.rpow_pos_of_pos (by norm_num) _
  have hδinv : δ = ((2 : ℝ) ^ j)⁻¹ := rpow_neg_natCast_two j
  have hδ2j : δ * (2 : ℝ) ^ j = 1 := by
    rw [hδinv]
    field_simp
  -- properties of the dilated bump and of its derivative
  have hcsD : HasCompactSupport (brsDilate υ j) := hasCompactSupport_brsDilate hcs j
  have hυD : ContDiff ℝ 1 (brsDilate υ j) := contDiff_brsDilate hυ j
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hR2 : tsupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) ⊆
      Metric.closedBall 0 1 := by
    rw [tsupport_const_mul_eq (ne_of_gt h2j)]
    exact hR'
  have hcsD' : HasCompactSupport (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact hasCompactSupport_brsDilate hcs2 j
  have hυD' : ContDiff ℝ 1 (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact contDiff_brsDilate hυ2 j
  -- the core estimate
  refine le_trans (brs_5_9_core hδ hcov k hcsD hυD hcsD' hυD' hg hp hr hrq hpq
    hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  -- the two kernel norms
  have hCnn : 0 ≤ brsKernelConst Mu A N r := brsKernelConst_nonneg hMunn hAnn N hr.le
  have hC'nn : 0 ≤ brsKernelConst Mu' A' N r :=
    brsKernelConst_nonneg hMu'nn hA'nn N hr.le
  have hK : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ.continuous hcs hR
      hbd hA hAnn hmom hr.le hkj
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow hCnn hδ hr0]
  have hK' : (∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
      (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbd2 : ∀ x : ℝ, |(2 : ℝ) ^ j * deriv υ x| ≤ (2 : ℝ) ^ j * Mu' := by
      intro x
      rw [abs_mul, abs_of_pos h2j]
      exact mul_le_mul_of_nonneg_left (hbd' x) h2j.le
    have hA2 : (∫ y : ℝ, |(2 : ℝ) ^ j * deriv υ y|) ≤ (2 : ℝ) ^ j * A' := by
      rw [integral_abs_const_mul h2j.le]
      exact mul_le_mul_of_nonneg_left hA' h2j.le
    have hmom2 : ∀ i : ℕ, i < N + 1 →
        (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) = 0 := by
      intro i hi
      have hre : (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) =
          (2 : ℝ) ^ j * ∫ y : ℝ, y ^ i * deriv υ y := by
        rw [← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        show y ^ i * ((2 : ℝ) ^ j * deriv υ y) =
          (2 : ℝ) ^ j * (y ^ i * deriv υ y)
        ring
      rw [hre, hmom' i hi, mul_zero]
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ2.continuous hcs2
      hR2 hbd2 hA2 (by positivity) hmom2 hr.le hkj
    rw [hderivD]
    rw [brsKernelConst_smul h2j.le hMu'nn hA'nn N] at hbase
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow (by positivity) hδ hr0]
    congr 2
    rw [Real.mul_rpow (Real.rpow_nonneg h2j.le _) hC'nn, ← Real.rpow_mul h2j.le,
      mul_one_div, div_self hr0.ne', Real.rpow_one]
  -- combine
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  have hstep : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) *
        G +
      ENNReal.ofReal δ *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
          (1 / r) * G) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G +
        ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G := by
    refine add_le_add (mul_le_mul' hK le_rfl) ?_
    calc ENNReal.ofReal δ *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
            (1 / r) * G)
        ≤ ENNReal.ofReal δ *
            (ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
              δ ^ (1 / r - 1 / 2)) * G) :=
          mul_le_mul' le_rfl (mul_le_mul' hK' le_rfl)
      _ = ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
            δ ^ (1 / r - 1 / 2)) * G := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hδ.le]
          congr 2
          calc δ * ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2))
              = (δ * (2 : ℝ) ^ j) * (brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2)) := by ring
            _ = brsKernelConst Mu' A' N r ^ (1 / r) * δ ^ (1 / r - 1 / 2) := by
                rw [hδ2j, one_mul]
  refine le_trans hstep (le_of_eq ?_)
  rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 2
  ring


/-! ## The radial weight on a dyadic window -/

/-- On the window `I_k` every power of the radius is comparable to the same
power of `2^{-k}`. -/
theorem rpow_le_of_mem_brsRadiusWindow {k : ℕ} {r : ℝ} (hr : r ∈ brsRadiusWindow k)
    (e : ℝ) : r ^ e ≤ (2 : ℝ) ^ |e| * ((2 : ℝ) ^ (-(k : ℝ))) ^ e := by
  have hApos : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ) - 1) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hBpos : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hrpos : 0 < r := brsRadiusWindow_pos hr
  have hBenn : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ e := Real.rpow_nonneg hBpos.le e
  have h1e : (1 : ℝ) ≤ (2 : ℝ) ^ |e| := by
    rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (abs_nonneg e)
  have hhalf : (2 : ℝ) ^ (-(k : ℝ) - 1) =
      (2 : ℝ) ^ (-(k : ℝ)) * (2 : ℝ) ^ (-1 : ℝ) := by
    rw [← Real.rpow_add (by norm_num),
      show -(k : ℝ) + (-1 : ℝ) = -(k : ℝ) - 1 by ring]
  rcases le_or_gt 0 e with he | he
  · calc r ^ e ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ e :=
          Real.rpow_le_rpow hrpos.le hr.2 he
      _ ≤ (2 : ℝ) ^ |e| * ((2 : ℝ) ^ (-(k : ℝ))) ^ e := by nlinarith
  · have hstep : r ^ e ≤ ((2 : ℝ) ^ (-(k : ℝ) - 1)) ^ e :=
      Real.rpow_le_rpow_of_nonpos hApos hr.1.le he.le
    have hval : ((2 : ℝ) ^ (-(k : ℝ) - 1)) ^ e =
        ((2 : ℝ) ^ (-(k : ℝ))) ^ e * (2 : ℝ) ^ (-e) := by
      rw [hhalf, Real.mul_rpow hBpos.le
          (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) _).le,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2) (-1 : ℝ) e,
        show (-1 : ℝ) * e = -e by ring]
    refine le_trans hstep (le_of_eq hval |>.trans ?_)
    rw [mul_comm]
    refine mul_le_mul_of_nonneg_right ?_ hBenn
    exact Real.rpow_le_rpow_of_exponent_le (by norm_num) (neg_le_abs e)

/-- `𝒜_{k,m}`, as a maximal function of the radius. -/
def brsAmMax (k j : ℕ) (υ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) : ENNReal :=
  (brsRadiusWindow k).indicator
    (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      ⨆ t ∈ E, ‖∫ y : ℝ,
        ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (t - r - y)‖ₑ) r

/-- **The radial weight costs `(2^{-k})^{1 - q/2}`.** -/
theorem lintegral_brsAmMax_rpow_le (k j : ℕ) (υ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsAmMax k j υ g E r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ∫⁻ r : ℝ, (⨆ t ∈ E, ‖∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
            g (t - r - y)‖ₑ) ^ q := by
  set C : ℝ := (2 : ℝ) ^ |1 - q / 2| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)
    with hC
  have hCnn : 0 ≤ C := by
    rw [hC]
    have h1 : (0 : ℝ) ≤ (2 : ℝ) ^ |1 - q / 2| :=
      (Real.rpow_pos_of_pos (by norm_num) _).le
    have h2 : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) :=
      Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
    positivity
  have hpt : ∀ r : ℝ, brsAmMax k j υ g E r ^ q * ENNReal.ofReal r ≤
      ENNReal.ofReal C * (⨆ t ∈ E, ‖∫ y : ℝ,
        ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
          g (t - r - y)‖ₑ) ^ q := by
    intro r
    by_cases hr : r ∈ brsRadiusWindow k
    · have hrpos : 0 < r := brsRadiusWindow_pos hr
      set S : ENNReal := ⨆ t ∈ E, ‖∫ y : ℝ,
        ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (t - r - y)‖ₑ
        with hS
      have hval : brsAmMax k j υ g E r ^ q * ENNReal.ofReal r =
          ENNReal.ofReal (r ^ (1 - q / 2)) * S ^ q := by
        rw [brsAmMax, Set.indicator_of_mem hr]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (S ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r ^ (1 - q / 2))) (S ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
              rw [Real.rpow_one]
          _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
          _ = r ^ (1 - q / 2) := by
              congr 1
              ring
      rw [hval]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (rpow_le_of_mem_brsRadiusWindow hr (1 - q / 2))) le_rfl
    · rw [brsAmMax, Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq,
        zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, brsAmMax k j υ g E r ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal C * (⨆ t ∈ E, ‖∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
            g (t - r - y)‖ₑ) ^ q := lintegral_mono hpt
    _ = ENNReal.ofReal C * ∫⁻ r : ℝ, (⨆ t ∈ E, ‖∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
            g (t - r - y)‖ₑ) ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top


/-! ## (5.9) of BRS

Putting the radial weight together with the maximal estimate.  Writing
`j = k + m`, `δ = 2^{-j}` and `1/r = 1 + 1/q - 1/p`, the two dyadic factors are
`(2^{-k})^{1 - q/2}` from the weight `r^{-1/2} r dr` on `I_k` and
`(2^{-j})^{1/r - 1/2}` from the kernel; after taking the `q`-th root they
combine into `2^{k(1/p - 2/q)} 2^{-m(1/2 + 1/q - 1/p)}`, which is exactly the
gain claimed in BRS (5.9). -/

/-- **BRS (5.9).** -/
theorem brs_5_9 {E : Set ℝ} {ι : Finset ℝ} {k j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    (∫⁻ x : ℝ, brsAmMax k j υ g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  refine le_trans (lintegral_brsAmMax_rpow_le k j υ g E hq0) ?_
  exact mul_le_mul' le_rfl
    (brs_5_9_dilate hcov hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
      hmom' hg hp hr hrq hpq hrel hkj)

/-- **BRS (5.9) with the covering number.**  Taking a minimal cover turns the
cardinality into `N(E, 2^{-k-m})`, which is the quantity appearing in
`ω_m^{p,q}(E,k)`. -/
theorem brs_5_9_covering {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {k j : ℕ}
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) :
    (∫⁻ x : ℝ, brsAmMax k j υ g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-(j : ℝ)))
  have h := brs_5_9 hcov hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
    hmom' hg hp hr hrq hpq hrel hkj
  rwa [hcard] at h


/-! ## Measurability of the maximal function

A supremum of continuous functions is lower semicontinuous, hence measurable —
no separability argument is needed, and the index set `E` may be arbitrary. -/

theorem measurable_iSup_enorm_translate {F : ℝ → ℂ} (hF : Continuous F)
    (E : Set ℝ) : Measurable fun r : ℝ => ⨆ t ∈ E, ‖F (t - r)‖ₑ := by
  have hlsc : LowerSemicontinuous fun r : ℝ => ⨆ t ∈ E, ‖F (t - r)‖ₑ := by
    refine lowerSemicontinuous_iSup fun t => ?_
    refine lowerSemicontinuous_iSup fun _ => ?_
    refine Continuous.lowerSemicontinuous ?_
    exact continuous_enorm.comp (hF.comp (continuous_const.sub continuous_id))
  exact hlsc.measurable

theorem measurable_brsAmMax (k j : ℕ) {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) :
    Measurable (brsAmMax k j υ g E) := by
  have hK : Continuous (brsTruncConvReal k (brsDilate υ j)) :=
    continuous_brsTruncConvReal k (hasCompactSupport_brsDilate hcs j)
      (contDiff_brsDilate hυ j)
  have hFcont : Continuous fun x : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (x - y) := by
    have hderiv := fun x : ℝ => hasDerivAt_kernel_convolution
      (hasCompactSupport_brsTruncConvReal k (hasCompactSupport_brsDilate hcs j))
      (contDiff_brsTruncConvReal k (n := 1) (contDiff_brsDilate hυ j)
        (hasCompactSupport_brsDilate hcs j)) hg x
    have hdiff : Differentiable ℝ fun x : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (x - y) :=
      fun x => (hderiv x).differentiableAt
    exact hdiff.continuous
  refine Measurable.indicator ?_ (measurableSet_brsRadiusWindow k)
  refine Measurable.mul ?_ (measurable_iSup_enorm_translate hFcont E)
  fun_prop


/-! ## Minkowski's inequality for a countable sum

Mathlib has the two-term triangle inequality in `L^p`; the sum over the
Littlewood--Paley index needs the countable one. -/

/-- The triangle inequality in `L^q` for a finite sum. -/
theorem lintegral_Lp_finset_sum_le {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {q : ℝ} (hq : 1 ≤ q) {f : ℕ → α → ENNReal}
    (hf : ∀ n, AEMeasurable (f n) μ) (s : Finset ℕ) :
    (∫⁻ a, (∑ n ∈ s, f n a) ^ q ∂μ) ^ (1 / q) ≤
      ∑ n ∈ s, (∫⁻ a, f n a ^ q ∂μ) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  induction s using Finset.induction with
  | empty =>
      simp only [Finset.sum_empty, ENNReal.zero_rpow_of_pos hq0, lintegral_zero,
        ENNReal.zero_rpow_of_pos (by positivity : (0 : ℝ) < 1 / q)]
      exact le_rfl
  | insert n s hn ih =>
      have hSm : AEMeasurable (fun a => ∑ m ∈ s, f m a) μ := by
        have h := Finset.aemeasurable_sum (μ := μ) s fun i _ => hf i
        have heq : (∑ i ∈ s, f i) = fun a => ∑ m ∈ s, f m a := by
          funext a
          rw [Finset.sum_apply]
        rwa [heq] at h
      have hadd := ENNReal.lintegral_Lp_add_le (μ := μ) (p := q) (hf n) hSm hq
      simp only [Pi.add_apply] at hadd
      calc (∫⁻ a, (∑ m ∈ insert n s, f m a) ^ q ∂μ) ^ (1 / q)
          = (∫⁻ a, (f n a + ∑ m ∈ s, f m a) ^ q ∂μ) ^ (1 / q) := by
            refine congrArg (fun z : ENNReal => z ^ (1 / q)) ?_
            refine lintegral_congr fun a => ?_
            rw [Finset.sum_insert hn]
        _ ≤ (∫⁻ a, f n a ^ q ∂μ) ^ (1 / q) +
              (∫⁻ a, (∑ m ∈ s, f m a) ^ q ∂μ) ^ (1 / q) := hadd
        _ ≤ (∫⁻ a, f n a ^ q ∂μ) ^ (1 / q) +
              ∑ m ∈ s, (∫⁻ a, f m a ^ q ∂μ) ^ (1 / q) := add_le_add le_rfl ih
        _ = ∑ m ∈ insert n s, (∫⁻ a, f m a ^ q ∂μ) ^ (1 / q) := by
            rw [Finset.sum_insert hn]

/-- **Minkowski's inequality for a countable sum.** -/
theorem lintegral_Lp_tsum_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {q : ℝ} (hq : 1 ≤ q) {f : ℕ → α → ENNReal} (hf : ∀ n, Measurable (f n)) :
    (∫⁻ a, (∑' n : ℕ, f n a) ^ q ∂μ) ^ (1 / q) ≤
      ∑' n : ℕ, (∫⁻ a, f n a ^ q ∂μ) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set T : ENNReal := ∑' n : ℕ, (∫⁻ a, f n a ^ q ∂μ) ^ (1 / q) with hT
  set S : ℕ → α → ENNReal := fun M a => ∑ n ∈ Finset.range M, f n a with hS
  have hSmeas : ∀ M, Measurable fun a => S M a ^ q := by
    intro M
    refine Measurable.pow_const ?_ q
    exact Finset.measurable_sum _ fun i _ => hf i
  have hSmono : Monotone fun M a => S M a ^ q := by
    intro M M' hMM' a
    refine ENNReal.rpow_le_rpow ?_ hq0.le
    have hsub : Finset.range M ⊆ Finset.range M' := by
      intro x hx
      simp only [Finset.mem_range] at hx ⊢
      omega
    exact Finset.sum_le_sum_of_subset hsub
  have hrp : ∀ a, (∑' n : ℕ, f n a) ^ q = ⨆ M : ℕ, S M a ^ q := by
    intro a
    rw [ENNReal.tsum_eq_iSup_nat]
    exact ennreal_iSup_rpow hq0 fun M => S M a
  rw [lintegral_congr hrp, lintegral_iSup hSmeas hSmono]
  have hbound : ∀ M : ℕ, (∫⁻ a, S M a ^ q ∂μ) ≤ T ^ q := by
    intro M
    have h1 : (∫⁻ a, S M a ^ q ∂μ) ^ (1 / q) ≤ T := by
      refine le_trans (lintegral_Lp_finset_sum_le hq (fun n => (hf n).aemeasurable)
        (Finset.range M)) ?_
      exact ENNReal.sum_le_tsum _
    have h2 := ENNReal.rpow_le_rpow h1 hq0.le
    rwa [← ENNReal.rpow_mul, show (1 : ℝ) / q * q = 1 by field_simp,
      ENNReal.rpow_one] at h2
  have hsup : (⨆ M : ℕ, ∫⁻ a, S M a ^ q ∂μ) ≤ T ^ q := iSup_le hbound
  refine le_trans (ENNReal.rpow_le_rpow hsup (by positivity)) (le_of_eq ?_)
  rw [← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]


/-! ## (5.10): the summation in `m`

The radial measure `r dr` of the planar problem, and the triangle inequality in
`L^q(r dr)` for the sum over the Littlewood--Paley index. -/

/-- The planar radial measure `r dr`. -/
def brsRadialMeasure : Measure ℝ := volume.withDensity fun r => ENNReal.ofReal r

theorem lintegral_brsRadialMeasure {F : ℝ → ENNReal} (hF : Measurable F) :
    (∫⁻ r : ℝ, F r ∂brsRadialMeasure) = ∫⁻ r : ℝ, F r * ENNReal.ofReal r := by
  rw [brsRadialMeasure,
    lintegral_withDensity_eq_lintegral_mul _ ENNReal.measurable_ofReal hF]
  refine lintegral_congr fun r => ?_
  show ENNReal.ofReal r * F r = F r * ENNReal.ofReal r
  ring

/-- **BRS (5.10).**  The triangle inequality in `L^q(r dr)` for the sum over the
Littlewood--Paley index. -/
theorem lintegral_radial_Lp_tsum_le {q : ℝ} (hq : 1 ≤ q) {G : ℕ → ℝ → ENNReal}
    (hG : ∀ m, Measurable (G m)) :
    (∫⁻ r : ℝ, (∑' m : ℕ, G m r) ^ q * ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∫⁻ r : ℝ, G m r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hsum : Measurable fun r : ℝ => (∑' m : ℕ, G m r) ^ q := by
    refine Measurable.pow_const ?_ q
    exact Measurable.ennreal_tsum hG
  have h := lintegral_Lp_tsum_le (μ := brsRadialMeasure) hq hG
  rw [lintegral_brsRadialMeasure hsum] at h
  refine le_trans h (le_of_eq ?_)
  refine tsum_congr fun m => ?_
  rw [lintegral_brsRadialMeasure ((hG m).pow_const q)]

/-- **(5.10) for the terms `𝒜_{k,m}`.** -/
theorem brs_5_10 {E : Set ℝ} (k : ℕ) {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) {g : ℕ → ℝ → ℂ} (hg : ∀ m, Continuous (g m))
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' m : ℕ, brsAmMax k (k + m) υ (g m) E r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∫⁻ r : ℝ, brsAmMax k (k + m) υ (g m) E r ^ q *
        ENNReal.ofReal r) ^ (1 / q) :=
  lintegral_radial_Lp_tsum_le hq fun m =>
    measurable_brsAmMax k (k + m) hυ hcs (hg m) E


/-! ## (5.14): localization by support

The kernel `h_k * υ_{k+m}` is supported in an interval of length comparable to
`2^{-k}`, so the smoothed operator at the point `x` only sees `g` on the
enlarged interval around `x`. -/

theorem brsTruncConvReal_eq_zero {k : ℕ} {δ : ℝ} {ψ : ℝ → ℝ}
    (hsupp : ∀ y : ℝ, δ < |y| → ψ y = 0) {x : ℝ}
    (hx : x ∉ Ioc (-δ) ((2 : ℝ) ^ (-(k : ℝ)) + δ)) :
    brsTruncConvReal k ψ x = 0 := by
  have h := brsTruncConv_eq_zero hsupp hx
  rw [brsTruncConv_eq_ofReal] at h
  exact_mod_cast h

/-- The support of the kernel built from a dilated bump. -/
theorem brsTruncConvReal_dilate_eq_zero {k j : ℕ} {υ : ℝ → ℝ}
    (hR : tsupport υ ⊆ Metric.closedBall 0 1) {x : ℝ}
    (hx : (2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) < |x|) :
    brsTruncConvReal k (brsDilate υ j) x = 0 := by
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkpos : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hinv : (2 : ℝ) ^ (-(j : ℝ)) = ((2 : ℝ) ^ j)⁻¹ := rpow_neg_natCast_two j
  refine brsTruncConvReal_eq_zero (δ := (2 : ℝ) ^ (-(j : ℝ))) ?_ ?_
  · intro y hy
    refine brsDilate_eq_zero_of_lt hR j ?_
    rwa [show (1 : ℝ) / 2 ^ j = (2 : ℝ) ^ (-(j : ℝ)) by rw [hinv, one_div]]
  · intro hc
    have h1 : -((2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ))) < x := by
      have := hc.1
      linarith
    have h2 : x ≤ (2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) := hc.2
    have habs : |x| ≤ (2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) :=
      abs_le.mpr ⟨h1.le, h2⟩
    linarith

/-- **BRS (5.14).**  Only the values of `g` on the enlarged interval matter. -/
theorem brs_5_14 {k j : ℕ} {υ : ℝ → ℝ}
    (hR : tsupport υ ⊆ Metric.closedBall 0 1) {g : ℝ → ℂ} {S : Set ℝ} {x : ℝ}
    (hS : Icc (x - ((2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ))))
        (x + ((2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)))) ⊆ S) :
    (∫ y : ℝ, ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
        (S.indicator g) (x - y) := by
  set c : ℝ := (2 : ℝ) ^ (-(k : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) with hc
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  show ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * g (x - y) =
    ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) * (S.indicator g) (x - y)
  by_cases hy : |y| ≤ c
  · have hyb := abs_le.mp hy
    have hmem : x - y ∈ S := hS ⟨by linarith [hyb.2], by linarith [hyb.1]⟩
    rw [Set.indicator_of_mem hmem]
  · have hz : brsTruncConvReal k (brsDilate υ j) y = 0 :=
      brsTruncConvReal_dilate_eq_zero hR (lt_of_not_ge hy)
    rw [hz]
    simp


/-! ## Superadditivity of `t ↦ t^r`, and the embedding `ℓ^2 ⊆ ℓ^p`

For `p ≥ 2` the Littlewood--Paley square function dominates the `ℓ^p` sum of
the pieces, which is the form in which the square-function theorem enters
Proposition 5.4. -/

/-- For `r ≥ 1` the map `t ↦ t^r` is superadditive on a finite sum. -/
theorem ennreal_finset_rpow_sum_le {ι : Type*} (K : Finset ι) (b : ι → ENNReal)
    {r : ℝ} (hr : 1 ≤ r) : (∑ k ∈ K, b k ^ r) ≤ (∑ k ∈ K, b k) ^ r := by
  set S : ENNReal := ∑ k ∈ K, b k with hS
  have hstep : ∀ k ∈ K, b k ^ r ≤ b k * S ^ (r - 1) := by
    intro k hk
    have hle : b k ≤ S := Finset.single_le_sum (f := b) (fun _ _ => zero_le) hk
    calc b k ^ r = b k ^ ((1 : ℝ) + (r - 1)) := by
          congr 1
          ring
      _ = b k ^ (1 : ℝ) * b k ^ (r - 1) :=
          ENNReal.rpow_add_of_nonneg (1 : ℝ) (r - 1) (by norm_num) (by linarith)
      _ = b k * b k ^ (r - 1) := by rw [ENNReal.rpow_one]
      _ ≤ b k * S ^ (r - 1) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hle (by linarith))
  calc (∑ k ∈ K, b k ^ r) ≤ ∑ k ∈ K, b k * S ^ (r - 1) :=
        Finset.sum_le_sum hstep
    _ = S * S ^ (r - 1) := by rw [← Finset.sum_mul]
    _ = S ^ r := by
        have hadd : S ^ ((1 : ℝ) + (r - 1)) = S ^ (1 : ℝ) * S ^ (r - 1) :=
          ENNReal.rpow_add_of_nonneg (1 : ℝ) (r - 1) (by norm_num) (by linarith)
        rw [ENNReal.rpow_one] at hadd
        rw [← hadd]
        congr 1
        ring

/-- **`ℓ^2 ⊆ ℓ^p` for `p ≥ 2`.**  This is the step that converts the square
function into the `ℓ^p` sum of the Littlewood--Paley pieces. -/
theorem ennreal_finset_rpow_sum_le_sq {ι : Type*} (K : Finset ι)
    (a : ι → ENNReal) {p : ℝ} (hp : 2 ≤ p) :
    (∑ k ∈ K, a k ^ p) ≤ (∑ k ∈ K, a k ^ (2 : ℝ)) ^ (p / 2) := by
  have hr : (1 : ℝ) ≤ p / 2 := by linarith
  have hterm : ∀ k : ι, a k ^ p = (a k ^ (2 : ℝ)) ^ (p / 2) := by
    intro k
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  calc (∑ k ∈ K, a k ^ p) = ∑ k ∈ K, (a k ^ (2 : ℝ)) ^ (p / 2) := by
        exact Finset.sum_congr rfl fun k _ => hterm k
    _ ≤ (∑ k ∈ K, a k ^ (2 : ℝ)) ^ (p / 2) :=
        ennreal_finset_rpow_sum_le K (fun k => a k ^ (2 : ℝ)) hr


/-! ## The square function dominates the `ℓ^p` sum, `p ≥ 2`

The real-valued form of `ennreal_finset_rpow_sum_le`, matching the
`finiteSquareEnergy` of `LeanSpherical/Auto/LittlewoodPaley.lean`. -/

/-- Superadditivity of `t ↦ t^r` on a finite sum of nonnegative reals. -/
theorem real_finset_rpow_sum_le {ι : Type*} (s : Finset ι) {b : ι → ℝ}
    (hb : ∀ i ∈ s, 0 ≤ b i) {r : ℝ} (hr : 1 ≤ r) :
    (∑ i ∈ s, b i ^ r) ≤ (∑ i ∈ s, b i) ^ r := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  set S : ℝ := ∑ i ∈ s, b i with hS
  have hSnn : 0 ≤ S := Finset.sum_nonneg hb
  rcases eq_or_lt_of_le hSnn with hS0 | hSpos
  · -- `S = 0` forces every term to vanish
    have hzero : ∀ i ∈ s, b i = 0 := by
      intro i hi
      have hle : b i ≤ S := Finset.single_le_sum hb hi
      have := hb i hi
      linarith [hS0 ▸ hle]
    have hL : (∑ i ∈ s, b i ^ r) = 0 := by
      refine Finset.sum_eq_zero fun i hi => ?_
      rw [hzero i hi, Real.zero_rpow hr0.ne']
    rw [hL, ← hS0, Real.zero_rpow hr0.ne']
  · have hstep : ∀ i ∈ s, b i ^ r ≤ b i * S ^ (r - 1) := by
      intro i hi
      have hbi := hb i hi
      have hle : b i ≤ S := Finset.single_le_sum hb hi
      rcases eq_or_lt_of_le hbi with hb0 | hbpos
      · rw [← hb0, Real.zero_rpow hr0.ne', zero_mul]
      · have hsplit : b i ^ r = b i * b i ^ (r - 1) := by
          have h := Real.rpow_add hbpos 1 (r - 1)
          rw [Real.rpow_one, show (1 : ℝ) + (r - 1) = r by ring] at h
          exact h
        rw [hsplit]
        refine mul_le_mul_of_nonneg_left ?_ hbi
        exact Real.rpow_le_rpow hbi hle (by linarith)
    calc (∑ i ∈ s, b i ^ r) ≤ ∑ i ∈ s, b i * S ^ (r - 1) :=
          Finset.sum_le_sum hstep
      _ = S * S ^ (r - 1) := by rw [← Finset.sum_mul]
      _ = S ^ r := by
          have h := Real.rpow_add hSpos 1 (r - 1)
          rw [Real.rpow_one, show (1 : ℝ) + (r - 1) = r by ring] at h
          exact h.symm

/-- **The square function dominates the `ℓ^p` sum for `p ≥ 2`.**  This is the
step that lets `Auto.MikhlinHormander.littlewoodPaley_of_mikhlin` be applied to
the `ℓ^p` sums appearing after BRS (5.10). -/
theorem finset_sum_norm_rpow_le_squareEnergy {ι X : Type*} (s : Finset ι)
    (g : ι → X → ℂ) (x : X) {p : ℝ} (hp : 2 ≤ p) :
    (∑ i ∈ s, ‖g i x‖ ^ p) ≤
      Auto.LittlewoodPaley.finiteSquareEnergy s g x ^ (p / 2) := by
  have hr : (1 : ℝ) ≤ p / 2 := by linarith
  have hterm : ∀ i : ι, ‖g i x‖ ^ p = (‖g i x‖ ^ (2 : ℕ)) ^ (p / 2) := by
    intro i
    rw [← Real.rpow_natCast ‖g i x‖ 2, ← Real.rpow_mul (norm_nonneg _)]
    congr 1
    push_cast
    ring
  have hb : ∀ i ∈ s, (0 : ℝ) ≤ ‖g i x‖ ^ (2 : ℕ) := fun i _ => by positivity
  calc (∑ i ∈ s, ‖g i x‖ ^ p) = ∑ i ∈ s, (‖g i x‖ ^ (2 : ℕ)) ^ (p / 2) :=
        Finset.sum_congr rfl fun i _ => hterm i
    _ ≤ (∑ i ∈ s, ‖g i x‖ ^ (2 : ℕ)) ^ (p / 2) := real_finset_rpow_sum_le s hb hr
    _ = Auto.LittlewoodPaley.finiteSquareEnergy s g x ^ (p / 2) := rfl


/-! ## The dyadic Littlewood--Paley pieces as Schwartz functions

`Auto.LittlewoodPaley.integerDyadicProjection` is defined as a raw function; it
is in fact Schwartz, which is what makes every power of its norm integrable and
so lets the square-function theorem be used quantitatively. -/

open scoped FourierTransform in
/-- The dyadic projection, packaged as a Schwartz map. -/
def brsDyadicSchwartz {d : ℕ} (C : Auto.LittlewoodPaley.lpCutoffs d) (n : ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) : SchwartzMap (Euclidean d) ℂ :=
  𝓕⁻ (SchwartzMap.smulLeftCLM ℂ
    (Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff n :
      Euclidean d → ℂ) (𝓕 f))

open scoped FourierTransform in
theorem brsDyadicSchwartz_apply {d : ℕ} (C : Auto.LittlewoodPaley.lpCutoffs d)
    (n : ℤ) (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    brsDyadicSchwartz C n f x =
      Auto.LittlewoodPaley.integerDyadicProjection C.cutoff n f x := by
  rw [brsDyadicSchwartz, Auto.LittlewoodPaley.integerDyadicProjection,
    SchwartzMap.fourierInv_coe]
  refine congrArg (fun h : Euclidean d → ℂ => 𝓕⁻ h x) ?_
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff n).hasTemperateGrowth]
  rfl

/-- Every positive power of the norm of a dyadic projection is integrable. -/
theorem integrable_norm_rpow_integerDyadicProjection {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (n : ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p) :
    Integrable (fun x : Euclidean d =>
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff n f x‖ ^ p)
      volume := by
  have hmem := (brsDyadicSchwartz C n f).memLp (ENNReal.ofReal p)
    (volume : Measure (Euclidean d))
  have hne : ENNReal.ofReal p ≠ 0 := by
    simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    exact hp
  have h := hmem.integrable_norm_rpow hne ENNReal.ofReal_ne_top
  rw [ENNReal.toReal_ofReal hp.le] at h
  refine h.congr ?_
  filter_upwards with x
  rw [brsDyadicSchwartz_apply]


/-! ## The `ℓ^p` form of the Littlewood--Paley theorem, `p ≥ 2` -/

/-- The reverse power-mean inequality: `(∑ b)^r ≤ card^{r-1} ∑ b^r`. -/
theorem real_finset_rpow_sum_ge {ι : Type*} (s : Finset ι) {b : ι → ℝ}
    (hb : ∀ i ∈ s, 0 ≤ b i) {r : ℝ} (hr : 1 ≤ r) :
    (∑ i ∈ s, b i) ^ r ≤ (s.card : ℝ) ^ (r - 1) * ∑ i ∈ s, b i ^ r := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  rcases Finset.eq_empty_or_nonempty s with hs | hs
  · subst hs
    simp only [Finset.sum_empty, Real.zero_rpow hr0.ne', mul_zero]
    exact le_rfl
  · have hcard : (0 : ℝ) < (s.card : ℝ) := by
      exact_mod_cast Finset.card_pos.mpr hs
    have hcardr : (0 : ℝ) < (s.card : ℝ) ^ r := Real.rpow_pos_of_pos hcard r
    have hcardrne : ((s.card : ℝ) ^ r) ≠ 0 := ne_of_gt hcardr
    have hw : ∀ i ∈ s, (0 : ℝ) ≤ ((s.card : ℝ))⁻¹ := fun _ _ => by positivity
    have hw1 : (∑ _i ∈ s, ((s.card : ℝ))⁻¹) = 1 := by
      rw [Finset.sum_const, nsmul_eq_mul]
      field_simp
    have hmean := Real.rpow_arith_mean_le_arith_mean_rpow s
      (fun _ => ((s.card : ℝ))⁻¹) b hw hw1 hb hr
    rw [← Finset.mul_sum, ← Finset.mul_sum,
      Real.mul_rpow (by positivity) (Finset.sum_nonneg hb),
      Real.inv_rpow hcard.le] at hmean
    have hstep : (∑ i ∈ s, b i) ^ r ≤
        (s.card : ℝ) ^ r * (((s.card : ℝ))⁻¹ * ∑ i ∈ s, b i ^ r) := by
      have h := mul_le_mul_of_nonneg_left hmean (le_of_lt hcardr)
      calc (∑ i ∈ s, b i) ^ r
          = (s.card : ℝ) ^ r * (((s.card : ℝ) ^ r)⁻¹ * (∑ i ∈ s, b i) ^ r) := by
            field_simp
        _ ≤ (s.card : ℝ) ^ r * (((s.card : ℝ))⁻¹ * ∑ i ∈ s, b i ^ r) := h
    have hneg1 : ((s.card : ℝ))⁻¹ = (s.card : ℝ) ^ (-1 : ℝ) := by
      rw [Real.rpow_neg hcard.le, Real.rpow_one]
    have hcc : (s.card : ℝ) ^ r * ((s.card : ℝ))⁻¹ = (s.card : ℝ) ^ (r - 1) := by
      rw [hneg1, ← Real.rpow_add hcard, show r + (-1 : ℝ) = r - 1 by ring]
    refine le_trans hstep (le_of_eq ?_)
    rw [← mul_assoc, hcc]

/-- Integrability of the `p/2`-power of the dyadic square function. -/
theorem integrable_squareEnergy_rpow {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (K : Finset ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 2 ≤ p) :
    Integrable (fun x : Euclidean d =>
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x ^ (p / 2))
      volume := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hr : (1 : ℝ) ≤ p / 2 := by linarith
  set Δ : ℤ → Euclidean d → ℂ := fun k =>
    Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f with hΔ
  have hcont : ∀ k : ℤ, Continuous (Δ k) := by
    intro k
    have h : Continuous (brsDyadicSchwartz C k f) :=
      (brsDyadicSchwartz C k f).continuous
    refine h.congr fun x => ?_
    rw [hΔ]
    exact brsDyadicSchwartz_apply C k f x
  -- the majorant
  have hmajint : Integrable (fun x : Euclidean d =>
      (K.card : ℝ) ^ (p / 2 - 1) * ∑ k ∈ K, ‖Δ k x‖ ^ p) volume := by
    refine Integrable.const_mul ?_ _
    exact integrable_finsetSum K fun k _ =>
      integrable_norm_rpow_integerDyadicProjection C k f hp0
  have hmeas : AEStronglyMeasurable (fun x : Euclidean d =>
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x ^ (p / 2))
      volume := by
    refine Continuous.aestronglyMeasurable ?_
    refine Continuous.rpow_const ?_ (fun _ => Or.inr (by linarith))
    refine continuous_finsetSum K fun k _ => ?_
    exact ((hcont k).norm).pow 2
  refine hmajint.mono' hmeas ?_
  filter_upwards with x
  have hsq : Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x =
      ∑ k ∈ K, ‖Δ k x‖ ^ (2 : ℕ) := rfl
  have hnn : (0 : ℝ) ≤
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x := by
    rw [hsq]
    exact Finset.sum_nonneg fun k _ => by positivity
  rw [Real.norm_of_nonneg (Real.rpow_nonneg hnn _), hsq]
  refine le_trans (real_finset_rpow_sum_ge K
    (fun k _ => (by positivity : (0 : ℝ) ≤ ‖Δ k x‖ ^ (2 : ℕ))) hr) ?_
  refine mul_le_mul_of_nonneg_left (le_of_eq ?_) (by positivity)
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← Real.rpow_natCast ‖Δ k x‖ 2, ← Real.rpow_mul (norm_nonneg _)]
  congr 1
  push_cast
  ring

/-- **The `ℓ^p` Littlewood--Paley bound for `p ≥ 2`.**  The sum of the `L^p`
norms of the dyadic pieces is controlled by the `L^p` norm, uniformly in the
finite set of scales. -/
theorem sum_integral_norm_rpow_dyadic_le {d : ℕ} [NeZero d]
    (C : Auto.LittlewoodPaley.lpCutoffs d) {p : ℝ} (hp : 2 ≤ p) :
    ∃ A : ℝ, 0 < A ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean d) ℂ),
      (∑ k ∈ K, ∫ x : Euclidean d,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  have hp0 : (0 : ℝ) < p := by linarith
  obtain ⟨A, hA, hLP⟩ := Auto.MikhlinHormander.littlewoodPaley_of_mikhlin C p
    (by linarith)
  refine ⟨A, hA, fun K f => ?_⟩
  have hswap : (∑ k ∈ K, ∫ x : Euclidean d,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p) =
      ∫ x : Euclidean d, ∑ k ∈ K,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p :=
    (integral_finsetSum K fun k _ =>
      integrable_norm_rpow_integerDyadicProjection C k f hp0).symm
  rw [hswap]
  refine le_trans (integral_mono_of_nonneg ?_
    (integrable_squareEnergy_rpow C K f hp) ?_) (hLP K f)
  · filter_upwards with x
    exact Finset.sum_nonneg fun k _ => Real.rpow_nonneg (norm_nonneg _) _
  · filter_upwards with x
    exact finset_sum_norm_rpow_le_squareEnergy K
      (fun k => Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f) x hp


/-! ## Identifying `Euclidean 1` with the line

The Littlewood--Paley machinery of the repository lives on `Euclidean d`; the
BRS radial reduction lives on `ℝ`.  In dimension one the two are identified by
a volume-preserving measurable equivalence. -/

/-- The volume-preserving identification `Euclidean 1 ≃ ℝ`. -/
def brsLineEquiv : Euclidean 1 ≃ᵐ ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 1 → ℝ)).symm.trans
    (MeasurableEquiv.funUnique (Fin 1) ℝ)

theorem measurePreserving_brsLineEquiv :
    MeasurePreserving brsLineEquiv (volume : Measure (Euclidean 1))
      (volume : Measure ℝ) := by
  have h1 : MeasurePreserving
      ((MeasurableEquiv.toLp 2 (Fin 1 → ℝ)).symm :
        Euclidean 1 → (Fin 1 → ℝ)) volume volume :=
    EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 1)
  have h2 : MeasurePreserving
      ((MeasurableEquiv.funUnique (Fin 1) ℝ) : (Fin 1 → ℝ) → ℝ) volume volume :=
    volume_preserving_funUnique (Fin 1) ℝ
  exact h2.comp h1

theorem lintegral_brsLineEquiv (F : ℝ → ENNReal) :
    (∫⁻ x : Euclidean 1, F (brsLineEquiv x)) = ∫⁻ y : ℝ, F y :=
  measurePreserving_brsLineEquiv.lintegral_comp_emb
    brsLineEquiv.measurableEmbedding F

theorem integral_brsLineEquiv (F : ℝ → ℝ) :
    (∫ x : Euclidean 1, F (brsLineEquiv x)) = ∫ y : ℝ, F y :=
  measurePreserving_brsLineEquiv.integral_comp
    brsLineEquiv.measurableEmbedding F

theorem lintegral_brsLineEquiv_symm (F : Euclidean 1 → ENNReal) :
    (∫⁻ y : ℝ, F (brsLineEquiv.symm y)) = ∫⁻ x : Euclidean 1, F x :=
  measurePreserving_brsLineEquiv.symm.lintegral_comp_emb
    brsLineEquiv.symm.measurableEmbedding F

theorem integral_brsLineEquiv_symm (F : Euclidean 1 → ℝ) :
    (∫ y : ℝ, F (brsLineEquiv.symm y)) = ∫ x : Euclidean 1, F x :=
  measurePreserving_brsLineEquiv.symm.integral_comp
    brsLineEquiv.symm.measurableEmbedding F


/-! ## The `ℓ^p` Littlewood--Paley bound on the line -/

/-- **The `ℓ^p` Littlewood--Paley bound, transported to `ℝ`.**  This is the
form in which the square-function theorem is available to the BRS radial
reduction. -/
theorem sum_integral_norm_rpow_dyadic_le_line
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {p : ℝ} (hp : 2 ≤ p) :
    ∃ A : ℝ, 0 < A ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean 1) ℂ),
      (∑ k ∈ K, ∫ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ ^ p) ≤
        A * ∫ y : ℝ, ‖f (brsLineEquiv.symm y)‖ ^ p := by
  obtain ⟨A, hA, hbound⟩ := sum_integral_norm_rpow_dyadic_le C hp
  refine ⟨A, hA, fun K f => ?_⟩
  have hleft : (∑ k ∈ K, ∫ y : ℝ,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
        (brsLineEquiv.symm y)‖ ^ p) =
      ∑ k ∈ K, ∫ x : Euclidean 1,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p := by
    refine Finset.sum_congr rfl fun k _ => ?_
    exact integral_brsLineEquiv_symm (fun x : Euclidean 1 =>
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p)
  have hright : (∫ y : ℝ, ‖f (brsLineEquiv.symm y)‖ ^ p) =
      ∫ x : Euclidean 1, ‖f x‖ ^ p :=
    integral_brsLineEquiv_symm (fun x : Euclidean 1 => ‖f x‖ ^ p)
  rw [hleft, hright]
  exact hbound K f


/-! ## Existence of the bump required by (5.9)

`brs_5_9` needs a smooth bump supported in the unit ball whose moments of every
order `≤ N` vanish.  Such a bump exists: take the Littlewood--Paley piece of a
BRS profile built from a `ContDiffBump` of outer radius one. -/

theorem tsupport_subset_closedBall_of_vanishing {f : ℝ → ℝ} {R : ℝ}
    (h : ∀ x : ℝ, R < |x| → f x = 0) :
    tsupport f ⊆ Metric.closedBall 0 R := by
  refine closure_minimal ?_ Metric.isClosed_closedBall
  intro x hx
  by_contra hc
  refine hx (h x ?_)
  simpa [Metric.mem_closedBall, Real.dist_eq] using hc

/-- Smoothness of a dilate, for any order. -/
theorem contDiff_brsDilate' {φ : ℝ → ℝ} {n : ℕ∞} (hφ : ContDiff ℝ (n : ℕ∞) φ)
    (j : ℕ) : ContDiff ℝ (n : ℕ∞) (brsDilate φ j) := by
  show ContDiff ℝ (n : ℕ∞) fun x : ℝ => (2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * x)
  exact contDiff_const.mul (hφ.comp (contDiff_const.mul contDiff_id))

/-- **A smooth bump in the unit ball with vanishing moments of every order at
most `N`.** -/
theorem exists_brsBump (N : ℕ) :
    ∃ υ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0 := by
  obtain ⟨a, h0, hvan⟩ := exists_brs_coeffs (N + 1) (Nat.succ_pos N)
  let fb : ContDiffBump (0 : ℝ) := ⟨1 / 2, 1, by norm_num, by norm_num⟩
  set χ : ℝ → ℝ := fb.normed volume with hχdef
  have hχsmooth : ContDiff ℝ (⊤ : ℕ∞) χ := fb.contDiff_normed
  have hχcont : Continuous χ := hχsmooth.continuous
  have hχsupp : HasCompactSupport χ := fb.hasCompactSupport_normed
  have hχmass : (∫ x, χ x) = 1 := fb.integral_normed
  have hχzero : ∀ x : ℝ, 1 < |x| → χ x = 0 := by
    intro x hx
    have hns : x ∉ Function.support χ := by
      rw [hχdef, ContDiffBump.support_normed_eq]
      simp only [Metric.mem_ball, Real.dist_eq, sub_zero, not_lt]
      exact hx.le
    exact Function.notMem_support.mp hns
  -- the profile
  set φ : ℝ → ℝ := fun x => ∑ l ∈ Finset.range (N + 1), a l * brsDilate χ l x
    with hφdef
  have hprof : IsBRSProfile (N + 1) φ :=
    isBRSProfile_of_coeffs hχcont hχsupp hχmass a h0 hvan
  have hφsmooth : ContDiff ℝ (⊤ : ℕ∞) φ := by
    rw [hφdef]
    exact ContDiff.sum fun l _ =>
      contDiff_const.mul (contDiff_brsDilate' hχsmooth l)
  have hφzero : ∀ x : ℝ, 1 < |x| → φ x = 0 := by
    intro x hx
    rw [hφdef]
    refine Finset.sum_eq_zero fun l _ => ?_
    have hdil : brsDilate χ l x = 0 := by
      show (2 : ℝ) ^ l * χ ((2 : ℝ) ^ l * x) = 0
      have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ l := one_le_pow₀ (by norm_num)
      have habs : (1 : ℝ) < |(2 : ℝ) ^ l * x| := by
        rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ l)]
        nlinarith [abs_nonneg x]
      rw [hχzero _ habs, mul_zero]
    rw [hdil, mul_zero]
  -- the Littlewood--Paley piece
  refine ⟨brsLPKernel φ 0, ?_, hasCompactSupport_brsLPKernel hprof.supp 0, ?_,
    fun i hi => integral_pow_mul_brsLPKernel_eq_zero hprof hi 0⟩
  · exact (contDiff_brsDilate' hφsmooth 1).sub (contDiff_brsDilate' hφsmooth 0)
  · refine tsupport_subset_closedBall_of_vanishing fun x hx => ?_
    have h1 : brsDilate φ 1 x = 0 := by
      show (2 : ℝ) ^ (1 : ℕ) * φ ((2 : ℝ) ^ (1 : ℕ) * x) = 0
      have habs : (1 : ℝ) < |(2 : ℝ) ^ (1 : ℕ) * x| := by
        rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ (1 : ℕ))]
        nlinarith [abs_nonneg x]
      rw [hφzero _ habs, mul_zero]
    have h0' : brsDilate φ 0 x = 0 := by
      rw [brsDilate_zero]
      exact hφzero x hx
    show brsDilate φ 1 x - brsDilate φ 0 x = 0
    rw [h1, h0', sub_zero]


/-! ## Integration by parts for a compactly supported `C¹` function -/

theorem deriv_eq_zero_of_vanishing {f : ℝ → ℝ} {R : ℝ}
    (hzero : ∀ x : ℝ, R < |x| → f x = 0) {x : ℝ} (hx : R < |x|) :
    deriv f x = 0 := by
  have hopen : IsOpen {y : ℝ | R < |y|} :=
    isOpen_lt continuous_const continuous_abs
  have hev : f =ᶠ[nhds x] fun _ => (0 : ℝ) := by
    filter_upwards [hopen.mem_nhds hx] with y hy
    exact hzero y hy
  rw [hev.deriv_eq]
  simp

/-- The integral of the derivative of a compactly supported `C¹` function
vanishes. -/
theorem integral_deriv_eq_zero_of_hasCompactSupport {f : ℝ → ℝ}
    (hf : ContDiff ℝ 1 f) (hcs : HasCompactSupport f) :
    (∫ y : ℝ, deriv f y) = 0 := by
  obtain ⟨R0, hR0⟩ := (hcs.isCompact.isBounded).subset_closedBall (0 : ℝ)
  set R : ℝ := max R0 0 with hRdef
  have hRnn : 0 ≤ R := le_max_right _ _
  have hzero : ∀ x : ℝ, R < |x| → f x = 0 := by
    intro x hx
    refine image_eq_zero_of_notMem_tsupport fun hc => ?_
    have h1 := hR0 hc
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at h1
    have h2 : |x| ≤ R := le_trans h1 (le_max_left _ _)
    linarith
  have hdzero : ∀ x : ℝ, R < |x| → deriv f x = 0 := fun x hx =>
    deriv_eq_zero_of_vanishing hzero hx
  set R' : ℝ := R + 1 with hR'
  have hlt : -R' < R' := by
    rw [hR']
    linarith
  have hdcont : Continuous (deriv f) := hf.continuous_deriv le_rfl
  have hcompl : ∀ x : ℝ, x ∉ Ioc (-R') R' → deriv f x = 0 := by
    intro x hx
    refine hdzero x ?_
    simp only [mem_Ioc, not_and_or, not_lt, not_le] at hx
    rcases hx with h | h
    · rw [abs_of_nonpos (by linarith : x ≤ 0)]
      linarith
    · rw [abs_of_pos (by linarith : (0 : ℝ) < x)]
      linarith
  have hset : (∫ y in Ioc (-R') R', deriv f y) = ∫ y : ℝ, deriv f y :=
    setIntegral_eq_integral_of_forall_compl_eq_zero hcompl
  rw [← hset, ← intervalIntegral.integral_of_le hlt.le]
  rw [intervalIntegral.integral_deriv_eq_sub
    (fun x _ => (hf.differentiable (by norm_num)) x)
    (hdcont.intervalIntegrable _ _)]
  have h1 : f R' = 0 := by
    refine hzero R' ?_
    rw [abs_of_pos (by rw [hR']; linarith)]
    rw [hR']
    linarith
  have h2 : f (-R') = 0 := by
    refine hzero (-R') ?_
    rw [abs_of_neg (by rw [hR']; linarith)]
    rw [hR']
    linarith
  rw [h1, h2, sub_zero]

/-- **Integration by parts against a monomial.** -/
theorem integral_pow_mul_deriv_eq {f : ℝ → ℝ} (hf : ContDiff ℝ 1 f)
    (hcs : HasCompactSupport f) (i : ℕ) :
    (∫ y : ℝ, y ^ i * deriv f y) =
      -(i : ℝ) * ∫ y : ℝ, y ^ (i - 1) * f y := by
  have hdcont : Continuous (deriv f) := hf.continuous_deriv le_rfl
  have hfcont : Continuous f := hf.continuous
  set g : ℝ → ℝ := fun y => y ^ i * f y with hg
  have hgcs : HasCompactSupport g := HasCompactSupport.mul_left hcs
  have hgcd : ContDiff ℝ 1 g := (contDiff_id.pow i).mul hf
  have hgderiv : ∀ y : ℝ,
      deriv g y = (i : ℝ) * y ^ (i - 1) * f y + y ^ i * deriv f y := by
    intro y
    have h1 : HasDerivAt (fun z : ℝ => z ^ i) ((i : ℝ) * y ^ (i - 1)) y :=
      hasDerivAt_pow i y
    have h2 : HasDerivAt f (deriv f y) y :=
      ((hf.differentiable (by norm_num)) y).hasDerivAt
    exact (h1.mul h2).deriv
  have hint1 : Integrable fun y : ℝ => (i : ℝ) * y ^ (i - 1) * f y := by
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (continuous_const.mul (continuous_pow (i - 1))).mul hfcont
    · exact HasCompactSupport.mul_left hcs
  have hint2 : Integrable fun y : ℝ => y ^ i * deriv f y := by
    refine Continuous.integrable_of_hasCompactSupport ?_ ?_
    · exact (continuous_pow i).mul hdcont
    · exact HasCompactSupport.mul_left hcs.deriv
  have hzero := integral_deriv_eq_zero_of_hasCompactSupport hgcd hgcs
  rw [integral_congr_ae (Filter.Eventually.of_forall hgderiv),
    integral_add hint1 hint2] at hzero
  have hconst : (∫ y : ℝ, (i : ℝ) * y ^ (i - 1) * f y) =
      (i : ℝ) * ∫ y : ℝ, y ^ (i - 1) * f y := by
    rw [← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    show (i : ℝ) * y ^ (i - 1) * f y = (i : ℝ) * (y ^ (i - 1) * f y)
    ring
  rw [hconst] at hzero
  linarith


/-! ## The hypotheses of (5.9) are satisfiable

`brs_5_9_dilate` takes a long list of hypotheses on the bump `υ` and on
`deriv υ`.  All of them hold simultaneously, so the estimate is not vacuous. -/

/-- **Every hypothesis of `brs_5_9_dilate` can be met.** -/
theorem exists_brsBumpFull (N : ℕ) :
    ∃ (υ : ℝ → ℝ) (Mu A Mu' A' : ℝ),
      ContDiff ℝ 1 υ ∧ HasCompactSupport υ ∧
        tsupport υ ⊆ Metric.closedBall 0 1 ∧
        ContDiff ℝ 1 (deriv υ) ∧ HasCompactSupport (deriv υ) ∧
        tsupport (deriv υ) ⊆ Metric.closedBall 0 1 ∧
        (∀ x : ℝ, |υ x| ≤ Mu) ∧ (∫ y : ℝ, |υ y|) ≤ A ∧ 0 ≤ A ∧
        (∀ x : ℝ, |deriv υ x| ≤ Mu') ∧ (∫ y : ℝ, |deriv υ y|) ≤ A' ∧
        0 ≤ A' ∧
        (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
        ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0 := by
  obtain ⟨υ, hsmooth, hcs, hR, hmom⟩ := exists_brsBump (N + 1)
  have hcd1 : ContDiff ℝ 1 υ := hsmooth.of_le ENat.LEInfty.out
  have hcd2 : ContDiff ℝ 2 υ := hsmooth.of_le ENat.LEInfty.out
  have hcont : Continuous υ := hcd1.continuous
  have hderivcd : ContDiff ℝ 1 (deriv υ) := by
    have h : ContDiff ℝ (1 + 1) υ := by
      rw [show ((1 : WithTop ℕ∞) + 1) = 2 by norm_num]
      exact hcd2
    exact (contDiff_succ_iff_deriv.mp h).2.2
  have hderivcs : HasCompactSupport (deriv υ) := hcs.deriv
  have hderivcont : Continuous (deriv υ) := hderivcd.continuous
  have hvanish : ∀ x : ℝ, 1 < |x| → υ x = 0 := by
    intro x hx
    refine image_eq_zero_of_notMem_tsupport fun hc => ?_
    have h1 := hR hc
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at h1
    linarith
  have hderivR : tsupport (deriv υ) ⊆ Metric.closedBall 0 1 :=
    tsupport_subset_closedBall_of_vanishing fun x hx =>
      deriv_eq_zero_of_vanishing hvanish hx
  obtain ⟨Mu, hMu⟩ := hcont.bounded_above_of_compact_support hcs
  obtain ⟨Mu', hMu'⟩ := hderivcont.bounded_above_of_compact_support hderivcs
  refine ⟨υ, Mu, ∫ y : ℝ, |υ y|, Mu', ∫ y : ℝ, |deriv υ y|, hcd1, hcs, hR,
    hderivcd, hderivcs, hderivR, ?_, le_rfl, ?_, ?_, le_rfl, ?_, ?_, ?_⟩
  · intro x
    simpa only [Real.norm_eq_abs] using hMu x
  · exact integral_nonneg fun y => abs_nonneg _
  · intro x
    simpa only [Real.norm_eq_abs] using hMu' x
  · exact integral_nonneg fun y => abs_nonneg _
  · intro i hi
    exact hmom i (by omega)
  · intro i hi
    rw [integral_pow_mul_deriv_eq hcd1 hcs i, hmom (i - 1) (by omega), mul_zero]


/-! ## (5.7) based at the scale `k`

BRS write the resolution as `δ = u_k + ∑_{m ≥ 1} υ_{k+m} * ψ_{k+m}`, with the
low-frequency piece `u_k` at the scale of the truncation.  In the telescoping
form used here the same statement reads `δ = φ_k + ∑_{m ≥ 0} Ψ_{k+m}`, where
`Ψ_j = φ_{j+1} - φ_j` is compactly supported and has vanishing moments — no
factorisation of `Ψ` is needed. -/

/-- The telescoping identity based at the scale `k`. -/
theorem brsDilate_eq_add_sum_shift (φ : ℝ → ℝ) (k M : ℕ) (x : ℝ) :
    brsDilate φ (k + M) x =
      brsDilate φ k x + ∑ m ∈ Finset.range M, brsLPKernel φ (k + m) x := by
  induction M with
  | zero => simp
  | succ M ih =>
      have h : brsDilate φ k x +
            (∑ m ∈ Finset.range M, brsLPKernel φ (k + m) x +
              brsLPKernel φ (k + M) x) =
          brsDilate φ (k + M) x + brsLPKernel φ (k + M) x := by
        rw [ih]
        ring
      rw [Finset.sum_range_succ, h]
      show brsDilate φ (k + (M + 1)) x =
        brsDilate φ (k + M) x +
          (brsDilate φ (k + M + 1) x - brsDilate φ (k + M) x)
      rw [show k + (M + 1) = k + M + 1 by ring]
      ring

/-- **(5.7) based at the scale `k`**, in telescoping form. -/
theorem brs_lp_resolution_shift {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) {g : ℝ → ℂ} (hg : Continuous g)
    (k M : ℕ) (x : ℝ) :
    (∫ y, (brsDilate φ (k + M) y : ℂ) * g (x - y)) =
      (∫ y, (brsDilate φ k y : ℂ) * g (x - y)) +
        ∑ m ∈ Finset.range M, ∫ y, (brsLPKernel φ (k + m) y : ℂ) * g (x - y) := by
  have hgc : Continuous fun y : ℝ => g (x - y) :=
    hg.comp (continuous_const.sub continuous_id)
  have hint : ∀ ψ : ℝ → ℝ, Continuous ψ → HasCompactSupport ψ →
      Integrable fun y => (ψ y : ℂ) * g (x - y) := by
    intro ψ hψ hψs
    have hcont : Continuous fun y : ℝ => (ψ y : ℂ) * g (x - y) :=
      (Complex.continuous_ofReal.comp hψ).mul hgc
    refine hcont.integrable_of_hasCompactSupport ?_
    have hc : HasCompactSupport fun y : ℝ => (ψ y : ℂ) :=
      hψs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
    exact hc.mul_right
  have hsum : ∀ y : ℝ, (brsDilate φ (k + M) y : ℂ) * g (x - y) =
      (brsDilate φ k y : ℂ) * g (x - y) +
        ∑ m ∈ Finset.range M, (brsLPKernel φ (k + m) y : ℂ) * g (x - y) := by
    intro y
    rw [← Finset.sum_mul, ← Complex.ofReal_sum, ← add_mul,
      ← Complex.ofReal_add, ← brsDilate_eq_add_sum_shift φ k M y]
  rw [show (∫ y, (brsDilate φ (k + M) y : ℂ) * g (x - y)) =
      ∫ y, ((brsDilate φ k y : ℂ) * g (x - y) +
        ∑ m ∈ Finset.range M,
          (brsLPKernel φ (k + m) y : ℂ) * g (x - y)) from
    integral_congr_ae (Filter.Eventually.of_forall hsum)]
  rw [integral_add (hint _ (continuous_brsDilate hφ k)
      (hasCompactSupport_brsDilate hsupp k))
    (integrable_finsetSum _ fun m _ =>
      hint _ (continuous_brsLPKernel hφ (k + m))
        (hasCompactSupport_brsLPKernel hsupp (k + m)))]
  congr 1
  exact integral_finsetSum _ fun m _ =>
    hint _ (continuous_brsLPKernel hφ (k + m))
      (hasCompactSupport_brsLPKernel hsupp (k + m))

/-- **The resolution converges**: the low-frequency piece at scale `k` plus the
high-frequency pieces above it recover `g`. -/
theorem brs_lp_resolution_shift_tendsto {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (hnorm : (∫ x, φ x) = 1) {g : ℝ → ℂ}
    (hg : Continuous g) (k : ℕ) (x : ℝ) :
    Tendsto (fun M : ℕ => (∫ y, (brsDilate φ k y : ℂ) * g (x - y)) +
        ∑ m ∈ Finset.range M, ∫ y, (brsLPKernel φ (k + m) y : ℂ) * g (x - y))
      atTop (𝓝 (g x)) := by
  have h := tendsto_brsDilate_convolution hφ hsupp hnorm hg x
  have hcomp : Tendsto (fun M : ℕ => k + M) atTop atTop :=
    tendsto_atTop_mono (fun M => Nat.le_add_left M k) tendsto_id
  refine (h.comp hcomp).congr fun M => ?_
  exact brs_lp_resolution_shift hφ hsupp hg k M x


/-! ## Summing the terms `𝒜_{k,m}` over `k`

For a fixed `m` the terms `𝒜_{k,m}` live on the pairwise disjoint dyadic
windows `I_k`, so the sum over `k` costs nothing: the `L^q(r dr)` norm of the
sum is the `ℓ^q` sum of the norms. -/

theorem brsAmMax_eq_zero_of_notMem {k j : ℕ} {υ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} {r : ℝ} (hr : r ∉ brsRadiusWindow k) :
    brsAmMax k j υ g E r = 0 := by
  rw [brsAmMax, Set.indicator_of_notMem hr]

/-- The `q`-th power of the sum over `k` is the sum of the `q`-th powers. -/
theorem tsum_brsAmMax_rpow (m : ℕ) {υ : ℝ → ℝ} {g : ℝ → ℂ} {E : Set ℝ} {q : ℝ}
    (hq : 0 < q) (r : ℝ) :
    (∑' k : ℕ, brsAmMax k (k + m) υ g E r) ^ q =
      ∑' k : ℕ, brsAmMax k (k + m) υ g E r ^ q := by
  by_cases h : ∃ k : ℕ, r ∈ brsRadiusWindow k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ → brsAmMax k (k + m) υ g E r = 0 := by
      intro k hk
      refine brsAmMax_eq_zero_of_notMem fun hr => ?_
      exact Set.disjoint_left.mp (brsRadiusWindow_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero,
      tsum_eq_single k₀ fun k hk => by
        rw [hzero k hk, ENNReal.zero_rpow_of_pos hq]]
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, brsAmMax k (k + m) υ g E r = 0 := fun k =>
      brsAmMax_eq_zero_of_notMem (h k)
    simp only [hall, tsum_zero, ENNReal.zero_rpow_of_pos hq]

/-- **The `k`-aggregation for a fixed `m`.**  Because the windows `I_k` are
disjoint, the radial `L^q` norm of the sum is exactly the `ℓ^q` sum. -/
theorem lintegral_tsum_brsAmMax_rpow (m : ℕ) {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ)
    {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, brsAmMax k (k + m) υ g E r) ^ q *
        ENNReal.ofReal r) =
      ∑' k : ℕ, ∫⁻ r : ℝ, brsAmMax k (k + m) υ g E r ^ q *
        ENNReal.ofReal r := by
  have hmeas : ∀ k : ℕ, AEMeasurable (fun r : ℝ =>
      brsAmMax k (k + m) υ g E r ^ q * ENNReal.ofReal r) volume := by
    intro k
    exact (((measurable_brsAmMax k (k + m) hυ hcs hg E).pow_const q).mul
      ENNReal.measurable_ofReal).aemeasurable
  have hpt : ∀ r : ℝ, (∑' k : ℕ, brsAmMax k (k + m) υ g E r) ^ q *
      ENNReal.ofReal r =
      ∑' k : ℕ, brsAmMax k (k + m) υ g E r ^ q * ENNReal.ofReal r := by
    intro r
    rw [tsum_brsAmMax_rpow m hq r, ← ENNReal.tsum_mul_right]
  rw [lintegral_congr hpt]
  exact lintegral_tsum hmeas


/-! ## The double sum of the terms `𝒜_{k,m}`

Combining the `m`-summation (5.10) with the `k`-aggregation reduces the full
double sum to the individual estimates (5.9). -/

/-- **The reduction of Proposition 5.4 to the estimates (5.9).** -/
theorem brs_5_4_core {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' m : ℕ, ∑' k : ℕ, brsAmMax k (k + m) υ g E r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsAmMax k (k + m) υ g E r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hGmeas : ∀ m : ℕ, Measurable fun r : ℝ =>
      ∑' k : ℕ, brsAmMax k (k + m) υ g E r :=
    fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsAmMax k (k + m) hυ hcs hg E
  refine le_trans (lintegral_radial_Lp_tsum_le hq hGmeas) (le_of_eq ?_)
  refine tsum_congr fun m => ?_
  rw [lintegral_tsum_brsAmMax_rpow m hυ hcs hg E hq0]


/-! ## Basing the resolution three scales below the truncation

The three-window kernel analysis needs `5 · 2^{-j} ≤ 2^{-k}`, i.e. the bump must
be at least three dyadic scales finer than the truncation.  Basing the
resolution at `k + 3` instead of `k` arranges this for every `m ≥ 0`; the
low-frequency remainder is then `φ_{k+3}` instead of `φ_k`, which changes
nothing downstream. -/

/-- The scale gap needed by `brs_5_9`. -/
theorem brs_scale_gap (k m : ℕ) :
    5 * (2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ)) := by
  have hsplit : (2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ)) =
      (2 : ℝ) ^ (-(k : ℝ)) * (2 : ℝ) ^ (-((m : ℝ) + 3)) := by
    rw [← Real.rpow_add (by norm_num)]
    congr 1
    push_cast
    ring
  have hkpos : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hsmall : 5 * (2 : ℝ) ^ (-((m : ℝ) + 3)) ≤ 1 := by
    have hm : (2 : ℝ) ^ (-((m : ℝ) + 3)) ≤ (2 : ℝ) ^ (-(3 : ℝ)) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      have : (0 : ℝ) ≤ (m : ℝ) := Nat.cast_nonneg m
      linarith
    have h3 : (2 : ℝ) ^ (-(3 : ℝ)) = 1 / 8 := by
      rw [show (-(3 : ℝ)) = ((-3 : ℤ) : ℝ) by norm_num, Real.rpow_intCast]
      norm_num
    rw [h3] at hm
    linarith
  calc 5 * (2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))
      = (2 : ℝ) ^ (-(k : ℝ)) * (5 * (2 : ℝ) ^ (-((m : ℝ) + 3))) := by
        rw [hsplit]
        ring
    _ ≤ (2 : ℝ) ^ (-(k : ℝ)) * 1 := mul_le_mul_of_nonneg_left hsmall hkpos.le
    _ = (2 : ℝ) ^ (-(k : ℝ)) := mul_one _

/-- **The reduction of Proposition 5.4 to (5.9)**, with the resolution based
`s` scales below the truncation. -/
theorem brs_5_4_shift_core (s : ℕ) {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' m : ℕ, ∑' k : ℕ, brsAmMax k (k + (m + s)) υ g E r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsAmMax k (k + (m + s)) υ g E r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hGmeas : ∀ m : ℕ, Measurable fun r : ℝ =>
      ∑' k : ℕ, brsAmMax k (k + (m + s)) υ g E r :=
    fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsAmMax k (k + (m + s)) hυ hcs hg E
  refine le_trans (lintegral_radial_Lp_tsum_le hq hGmeas) (le_of_eq ?_)
  refine tsum_congr fun m => ?_
  rw [lintegral_tsum_brsAmMax_rpow (m + s) hυ hcs hg E hq0]


/-! ## The full double sum, bounded by covering numbers

Combining `brs_5_4_shift_core` with `brs_5_9_covering` bounds the whole
`(k, m)` sum by the dyadic covering numbers of `E`.  This is the estimate
Proposition 5.4 is assembled from; the `k`-sum here is left as an `ℓ^q` sum
rather than being replaced by a supremum, which is what makes the argument
independent of the Littlewood--Paley theorem on the open range `q < 2p`. -/

/-- **The `(k, m)` aggregate bound.** -/
theorem brs_5_4_aggregate {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
          brsAmMax k (k + (m + 3)) υ g E x) ^ q * ENNReal.ofReal x) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ,
        ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
            ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
          ((intervalCoveringNumber E
                ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) : ENNReal) *
            (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                  brsKernelConst Mu' A' N r ^ (1 / r)) *
                ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q)) ^ (1 / q) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  refine le_trans (brs_5_4_shift_core 3 hυ hcs hg E hq1) ?_
  refine ENNReal.tsum_le_tsum fun m => ?_
  refine ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k => ?_) (by positivity)
  exact brs_5_9_covering hE hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn
    hmom hmom' hg hp hr hrq hpq hrel (brs_scale_gap k m)


/-! ## Dyadic geometric series

The `(k, m)` sum of Proposition 5.4 is a double geometric series; both ratios
are `2` to a negative power exactly in the interior of the type region. -/

/-- A dyadic geometric series in `ℝ≥0∞`. -/
theorem tsum_ofReal_geometric {c a : ℝ} (hc : 0 ≤ c) (ha : a < 0) :
    (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (a * (k : ℝ)))) =
      ENNReal.ofReal (c / (1 - (2 : ℝ) ^ a)) := by
  set x : ℝ := (2 : ℝ) ^ a with hx
  have hxpos : 0 < x := Real.rpow_pos_of_pos (by norm_num) _
  have hx1 : x < 1 := by
    rw [hx, show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
    exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ha
  have hterm : ∀ k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (a * (k : ℝ))) =
      ENNReal.ofReal c * ENNReal.ofReal x ^ k := by
    intro k
    rw [ENNReal.ofReal_mul hc]
    congr 1
    rw [← ENNReal.ofReal_pow hxpos.le]
    congr 1
    rw [hx, ← Real.rpow_natCast ((2 : ℝ) ^ a) k,
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
  rw [tsum_congr hterm, ENNReal.tsum_mul_left, tsum_geometric]
  have hsub : (1 : ENNReal) - ENNReal.ofReal x = ENNReal.ofReal (1 - x) := by
    rw [ENNReal.ofReal_sub _ hxpos.le, ENNReal.ofReal_one]
  rw [hsub, ← ENNReal.ofReal_inv_of_pos (by linarith), ← ENNReal.ofReal_mul hc,
    div_eq_mul_inv]

/-- The double dyadic geometric series, with the inner sum raised to the power
`1/q`. -/
theorem tsum_tsum_ofReal_geometric_rpow {c a b q : ℝ} (hc : 0 ≤ c) (ha : a < 0)
    (hb : b < 0) (hq : 0 < q) :
    (∑' m : ℕ, (∑' k : ℕ,
        ENNReal.ofReal (c * (2 : ℝ) ^ (a * (k : ℝ) + b * (m : ℝ)))) ^ (1 / q)) =
      ENNReal.ofReal ((c / (1 - (2 : ℝ) ^ a)) ^ (1 / q) /
        (1 - (2 : ℝ) ^ (b / q))) := by
  have hapos : (0 : ℝ) < 1 - (2 : ℝ) ^ a := by
    have : (2 : ℝ) ^ a < 1 := by
      rw [show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) by norm_num]
      exact Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ha
    linarith
  have hbq : b / q < 0 := div_neg_of_neg_of_pos hb hq
  -- the inner sum
  have hinner : ∀ m : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * (k : ℝ) + b * (m : ℝ)))) =
      ENNReal.ofReal ((c * (2 : ℝ) ^ (b * (m : ℝ))) / (1 - (2 : ℝ) ^ a)) := by
    intro m
    have hsplit : ∀ k : ℕ,
        c * (2 : ℝ) ^ (a * (k : ℝ) + b * (m : ℝ)) =
          (c * (2 : ℝ) ^ (b * (m : ℝ))) * (2 : ℝ) ^ (a * (k : ℝ)) := by
      intro k
      rw [Real.rpow_add (by norm_num)]
      ring
    rw [tsum_congr fun k => by rw [hsplit k]]
    exact tsum_ofReal_geometric (by positivity) ha
  -- the outer sum
  have houter : ∀ m : ℕ,
      (ENNReal.ofReal ((c * (2 : ℝ) ^ (b * (m : ℝ))) / (1 - (2 : ℝ) ^ a))) ^
          (1 / q) =
        ENNReal.ofReal ((c / (1 - (2 : ℝ) ^ a)) ^ (1 / q) *
          (2 : ℝ) ^ ((b / q) * (m : ℝ))) := by
    intro m
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [show (c * (2 : ℝ) ^ (b * (m : ℝ))) / (1 - (2 : ℝ) ^ a) =
        (c / (1 - (2 : ℝ) ^ a)) * (2 : ℝ) ^ (b * (m : ℝ)) by ring,
      Real.mul_rpow (by positivity) (by positivity),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    congr 2
    field_simp
  have hcomb : ∀ m : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * (k : ℝ) + b * (m : ℝ)))) ^ (1 / q) =
      ENNReal.ofReal ((c / (1 - (2 : ℝ) ^ a)) ^ (1 / q) *
        (2 : ℝ) ^ ((b / q) * (m : ℝ))) := by
    intro m
    rw [hinner m]
    exact houter m
  rw [tsum_congr hcomb]
  exact tsum_ofReal_geometric (by positivity) hbq


/-! ## The exponent bookkeeping of the `(k, m)` sum

Collecting the three dyadic factors of a term of `brs_5_4_aggregate` — the
radial weight `(2^{-k})^{1 - q/2}`, the covering number `2^{βj}` and the kernel
gain `(2^{-j})^{sq}` — into a single power of `2`. -/

/-- The exponent in `k`. -/
def brsSumExpK (β s q : ℝ) : ℝ := q / 2 - 1 + β - s * q

/-- The exponent in `m`. -/
def brsSumExpM (β s q : ℝ) : ℝ := β - s * q

/-- **Collecting the dyadic factors of one term.** -/
theorem brs_term_exponent_identity (K₁ Cβ Cs β s q : ℝ) (k m : ℕ) :
    K₁ * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) *
        (Cβ * (2 : ℝ) ^ (β * ((k + (m + 3) : ℕ) : ℝ))) *
        (Cs * ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) ^ (s * q)) =
      (K₁ * Cβ * Cs * (2 : ℝ) ^ (brsSumExpM β s q * 3)) *
        (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) + brsSumExpM β s q * (m : ℝ)) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hjcast : ((k + (m + 3) : ℕ) : ℝ) = (k : ℝ) + (m : ℝ) + 3 := by
    push_cast
    ring
  have e1 : ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) =
      (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) := by
    rw [← Real.rpow_mul h2.le]
  have e2 : ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) ^ (s * q) =
      (2 : ℝ) ^ (-((k : ℝ) + (m : ℝ) + 3) * (s * q)) := by
    rw [← Real.rpow_mul h2.le, hjcast]
  have e3 : (2 : ℝ) ^ (β * ((k + (m + 3) : ℕ) : ℝ)) =
      (2 : ℝ) ^ (β * ((k : ℝ) + (m : ℝ) + 3)) := by
    rw [hjcast]
  rw [e1, e2, e3]
  have hcomb : (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
      (2 : ℝ) ^ (β * ((k : ℝ) + (m : ℝ) + 3)) *
      (2 : ℝ) ^ (-((k : ℝ) + (m : ℝ) + 3) * (s * q)) =
      (2 : ℝ) ^ (brsSumExpM β s q * 3) *
        (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
          brsSumExpM β s q * (m : ℝ)) := by
    rw [← Real.rpow_add h2, ← Real.rpow_add h2, ← Real.rpow_add h2]
    congr 1
    rw [brsSumExpK, brsSumExpM]
    ring
  calc K₁ * (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
        (Cβ * (2 : ℝ) ^ (β * ((k : ℝ) + (m : ℝ) + 3))) *
        (Cs * (2 : ℝ) ^ (-((k : ℝ) + (m : ℝ) + 3) * (s * q)))
      = K₁ * Cβ * Cs *
          ((2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
            (2 : ℝ) ^ (β * ((k : ℝ) + (m : ℝ) + 3)) *
            (2 : ℝ) ^ (-((k : ℝ) + (m : ℝ) + 3) * (s * q))) := by ring
    _ = K₁ * Cβ * Cs *
          ((2 : ℝ) ^ (brsSumExpM β s q * 3) *
            (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
              brsSumExpM β s q * (m : ℝ))) := by rw [hcomb]
    _ = (K₁ * Cβ * Cs * (2 : ℝ) ^ (brsSumExpM β s q * 3)) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (m : ℝ)) := by ring


/-! ## One term of the `(k, m)` sum, in geometric form -/

/-- **A single term of `brs_5_4_aggregate` is a dyadic geometric term.** -/
theorem brs_5_4_term_le {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {Cs : ℝ} (hCs : 0 ≤ Cs) {q s : ℝ} (hq : 0 < q) (k m : ℕ) (G : ENNReal) :
    ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E
              ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal (Cs *
              ((2 : ℝ) ^ (-((k + (m + 3) : ℕ) : ℝ))) ^ s) * G) ^ q) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q *
            (2 : ℝ) ^ (brsSumExpM β s q * 3)) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (m : ℝ))) * G ^ q := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  set j : ℕ := k + (m + 3) with hj
  have hdyad : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos h2 _
  have hK₁ : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| := Real.rpow_pos_of_pos h2 _
  have hwt : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) :=
    Real.rpow_nonneg (Real.rpow_pos_of_pos h2 _).le _
  -- the `q`-th power of the kernel factor
  have hpow : (ENNReal.ofReal (Cs * ((2 : ℝ) ^ (-(j : ℝ))) ^ s) * G) ^ q =
      ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le]
    congr 2
    rw [Real.mul_rpow hCs (Real.rpow_nonneg hdyad.le _),
      ← Real.rpow_mul hdyad.le]
  rw [hpow]
  -- bound the covering number
  have hstep : ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
          (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) *
            G ^ q)) :=
    mul_le_mul' le_rfl (mul_le_mul' (hN j) le_rfl)
  refine le_trans hstep (le_of_eq ?_)
  -- merge the three constants
  rw [show ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) =
      (ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q))) * G ^ q by
    ring]
  congr 1
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [hj]
  exact brs_term_exponent_identity ((2 : ℝ) ^ |1 - q / 2|) Cβ (Cs ^ q) β s q k m


/-! ## Proposition 5.4 on the interior of the type region

Summing the `(k, m)` estimates.  Both dyadic exponents are negative exactly on
the interior of the region, and there the double geometric series converges, so
no Littlewood--Paley theorem is needed. -/

/-- **The interior form of BRS Proposition 5.4 for the near part.** -/
theorem brs_5_4_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    (∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
          brsAmMax k (k + (m + 3)) υ g E x) ^ q * ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal ((((2 : ℝ) ^ |1 - q / 2| * Cβ *
              (brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) ^ q *
              (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q * 3)) /
            (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
          (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q))) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  set s : ℝ := 1 / r - 1 / 2 with hs
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  set Cs : ℝ := brsKernelConst Mu A N r ^ (1 / r) +
    brsKernelConst Mu' A' N r ^ (1 / r) with hCs
  have hCsnn : 0 ≤ Cs := by
    rw [hCs]
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set c : ℝ := (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q *
    (2 : ℝ) ^ (brsSumExpM β s q * 3) with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCsnn _
    have h3 : (0 : ℝ) < (2 : ℝ) ^ (brsSumExpM β s q * 3) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine le_trans (brs_5_4_aggregate hE hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd'
    hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel) ?_
  refine le_trans (ENNReal.tsum_le_tsum fun m =>
    ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k =>
      brs_5_4_term_le hCβ hN hCsnn hq0 k m G) (by positivity)) ?_
  have hsum : ∀ m : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (m : ℝ))) * G ^ q) ^ (1 / q) =
      (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (m : ℝ)))) ^ (1 / q) * G := by
    intro m
    rw [ENNReal.tsum_mul_right, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]
  rw [tsum_congr hsum, ENNReal.tsum_mul_right,
    tsum_tsum_ofReal_geometric_rpow hcnn hK hM hq0]


/-! ## The near part as a convolution

`brsANearLeft` is an interval integral against `|s - a|^{-1/2}` cut off at
`a + c`.  Translating `s = a + u` turns it into an integral over the whole line
against the truncated kernel at scale `c`, which is the form in which the
kernel estimates are stated. -/

/-- The truncated kernel at an arbitrary scale. -/
def brsTruncKernelAt (c : ℝ) (y : ℝ) : ℝ :=
  (Ioc (0 : ℝ) c).indicator (fun y => y ^ (-(1 / 2) : ℝ)) y

theorem brsTruncKernel_eq_at (k : ℕ) :
    brsTruncKernel k = brsTruncKernelAt ((2 : ℝ) ^ (-(k : ℝ))) := rfl

theorem brsTruncKernelAt_nonneg (c y : ℝ) : 0 ≤ brsTruncKernelAt c y := by
  rw [brsTruncKernelAt]
  by_cases hy : y ∈ Ioc (0 : ℝ) c
  · rw [Set.indicator_of_mem hy]
    exact Real.rpow_nonneg hy.1.le _
  · rw [Set.indicator_of_notMem hy]

theorem measurable_brsTruncKernelAt (c : ℝ) :
    Measurable (brsTruncKernelAt c) := by
  refine Measurable.indicator ?_ measurableSet_Ioc
  fun_prop

theorem brsTruncKernelAt_eq_zero_of_notMem {c y : ℝ}
    (hy : y ∉ Ioc (0 : ℝ) c) : brsTruncKernelAt c y = 0 := by
  rw [brsTruncKernelAt, Set.indicator_of_notMem hy]

/-- **The near part of `R₂^-` is a convolution.** -/
theorem integral_nearPart_eq_conv {c a b : ℝ} (hc : 0 < c) (hcb : a + c ≤ b)
    {g : ℝ → ℂ} (hg : Continuous g) :
    (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (a + u) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  -- translate the interval integral
  have htrans : (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Iio (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) := by
    have h := intervalIntegral.integral_comp_add_left
      (a := (0 : ℝ)) (b := b - a) (d := a)
      (f := fun s : ℝ => (Iio (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  -- the two integrands agree off the single point `u = c`
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Iio (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (a + u) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show a + u ∈ Iio (a + c) by
        simp only [mem_Iio]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      congr 2
      rw [show a + u - a = u by ring, abs_of_pos hupos]
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show a + u ∉ Iio (a + c) by
        simp only [mem_Iio, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hne : (volume ({c} : Set ℝ)) = 0 := measure_singleton c
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simpa using hne
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Iio (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (a + u) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  -- extend the integral to the whole line
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp


/-! ## (5.5) with an arbitrary cutoff

The near/far split of `R_2^-` works for any cutoff, not just `brsCutScale r`.
Taking a cutoff that is constant on each dyadic window `I_k` is what allows the
near part to be compared with the fixed-scale truncated kernel. -/

/-- `𝒜` with an arbitrary cutoff. -/
def brsANearLeftAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Iio (t - r + c)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ` with an arbitrary cutoff. -/
def brsBFarLeftAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Ici (t - r + c)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

theorem brsANearLeft_eq_at (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsANearLeft E g r = brsANearLeftAt (brsCutScale r) E g r := rfl

theorem brsBFarLeft_eq_at (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsBFarLeft E g r = brsBFarLeftAt (brsCutScale r) E g r := rfl

/-- **(5.5) with an arbitrary cutoff.** -/
theorem brsRemTwoTwoLeft_le_add_at (c : ℝ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoLeft E g r ≤ brsANearLeftAt c E g r + brsBFarLeftAt c E g r := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_le fun t ht => ?_
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  set F : ℝ → ℂ := fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume a t :=
    intervalIntegrable_absWeight_complex hg hab
  have hnear : IntervalIntegrable ((Iio (a + c)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Iio, hfull.2.indicator measurableSet_Iio⟩
  have hfar : IntervalIntegrable ((Ici (a + c)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Ici, hfull.2.indicator measurableSet_Ici⟩
  have hsplit : ∀ s : ℝ, F s = (Iio (a + c)).indicator F s +
      (Ici (a + c)).indicator F s := by
    intro s
    by_cases hs : s < a + c
    · rw [Set.indicator_of_mem (show s ∈ Iio (a + c) from hs),
        Set.indicator_of_notMem (show s ∉ Ici (a + c) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Iio (a + c) from hs),
        Set.indicator_of_mem (show s ∈ Ici (a + c) from not_lt.mp hs)]
      ring
  have hint : (∫ s in a..t, F s) =
      (∫ s in a..t, (Iio (a + c)).indicator F s) +
        ∫ s in a..t, (Ici (a + c)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in a..t, F s‖ ≤
      ‖∫ s in a..t, (Iio (a + c)).indicator F s‖ +
        ‖∫ s in a..t, (Ici (a + c)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in a..t, (Iio (a + c)).indicator F s‖ +
            ‖∫ s in a..t, (Ici (a + c)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in a..t, (Iio (a + c)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in a..t, (Ici (a + c)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearLeftAt c E g r + brsBFarLeftAt c E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearLeftAt]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarLeftAt]
          exact le_iSup₂_of_le t ht le_rfl


/-! ## Reflection, and the maximal estimate for an abstract pair `(F, F')`

The near part of `R_2^-` is a convolution evaluated at `r - t` rather than at
`t - r`, so a reflection has to be absorbed somewhere.  Reflection preserves
every `L^q` norm, so it is cleanest to state the maximal estimate for an
abstract differentiable pair and apply it to the reflected function. -/

theorem lintegral_enorm_comp_neg (H : ℝ → ℂ) (q : ℝ) :
    (∫⁻ z : ℝ, ‖H (-z)‖ₑ ^ q) = ∫⁻ z : ℝ, ‖H z‖ₑ ^ q :=
  lintegral_neg_eq_self (fun z => ‖H z‖ₑ ^ q)

theorem hasDerivAt_comp_neg {F F' : ℝ → ℂ}
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) (z : ℝ) :
    HasDerivAt (fun w : ℝ => F (-w)) (-(F' (-z))) z := by
  have h2 := HasDerivAt.scomp z (hderiv (-z)) (hasDerivAt_neg z)
  have hval : (-1 : ℝ) • F' (-z) = -(F' (-z)) := by
    rw [neg_smul, one_smul]
  rw [hval] at h2
  exact h2

/-- **The localized maximal estimate for an abstract pair.** -/
theorem lintegral_iSup_translate_le_of_bounds {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q)
    {B B' : ENNReal} (hB : (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) ≤ B)
    (hB' : (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) ≤ B') :
    (∫⁻ r : ℝ, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) * (B + ENNReal.ofReal δ * B') ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  refine le_trans (lintegral_iSup_enorm_translate_rpow_le hδ hcov hF hF' hderiv
    hq) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact add_le_add hB (mul_le_mul' le_rfl hB')


/-! ## The near part as a maximal function of a convolution

Putting `integral_nearPart_eq_conv` and the reflection together, the near part
of `R_2^-` is exactly the weight `r^{-1/2}` times the maximal function, over
`t ∈ E`, of the reflected convolution evaluated at `t - r`.  That is the shape
the localized maximal estimate expects. -/

/-- Reflection of a function. -/
def brsRefl (g : ℝ → ℂ) : ℝ → ℂ := fun z => g (-z)

theorem brsRefl_apply (g : ℝ → ℂ) (z : ℝ) : brsRefl g z = g (-z) := rfl

theorem continuous_brsRefl {g : ℝ → ℂ} (hg : Continuous g) :
    Continuous (brsRefl g) := hg.comp continuous_neg

/-- **The near part is a maximal function of a convolution.** -/
theorem brsANearLeftAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hcr : c ≤ r) :
    brsANearLeftAt c E g r =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ t ∈ E ∩ Ici (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ := by
  have hidentify : ∀ t : ℝ,
      (∫ s in (t - r)..t, (Iio (t - r + c)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r) := by
    intro t
    rw [integral_nearPart_eq_conv hc (by linarith) hg]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t - r + u)) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (-(t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t - r + u) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) * brsRefl g (-(t - r) - u)
    rw [brsRefl_apply]
    congr 2
    ring
  have hpt : ∀ t : ℝ,
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
          (Iio (t - r + c)).indicator
            (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ := by
    intro t
    have hrnn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith) _
    rw [ENNReal.ofReal_mul hrnn, ofReal_norm, hidentify t]
  rw [brsANearLeftAt]
  rw [iSup_congr fun t => iSup_congr fun _ => hpt t]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## The maximal estimate for the reflected function

Reflection costs nothing: the localized maximal estimate holds for `brsRefl F`
with the same `L^q` bounds as for `F`. -/

/-- **The localized maximal estimate for a reflected pair.** -/
theorem lintegral_iSup_translate_refl_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q)
    {B B' : ENNReal} (hB : (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) ≤ B)
    (hB' : (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) ≤ B') :
    (∫⁻ r : ℝ, (⨆ t ∈ E, ‖brsRefl F (t - r)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) * (B + ENNReal.ofReal δ * B') ^ q := by
  have hRefl : Continuous (brsRefl F) := continuous_brsRefl hF
  have hReflDeriv : Continuous fun z : ℝ => -(F' (-z)) :=
    (hF'.comp continuous_neg).neg
  have hd : ∀ z : ℝ, HasDerivAt (brsRefl F) (-(F' (-z))) z := fun z =>
    hasDerivAt_comp_neg hderiv z
  have hBrefl : (∫⁻ z : ℝ, ‖brsRefl F z‖ₑ ^ q) ^ (1 / q) ≤ B := by
    rwa [show (∫⁻ z : ℝ, ‖brsRefl F z‖ₑ ^ q) = ∫⁻ z : ℝ, ‖F z‖ₑ ^ q from
      lintegral_enorm_comp_neg F q]
  have hB'refl : (∫⁻ z : ℝ, ‖-(F' (-z))‖ₑ ^ q) ^ (1 / q) ≤ B' := by
    have heq : (∫⁻ z : ℝ, ‖-(F' (-z))‖ₑ ^ q) = ∫⁻ z : ℝ, ‖F' z‖ₑ ^ q := by
      rw [← lintegral_enorm_comp_neg F' q]
      refine lintegral_congr fun z => ?_
      rw [enorm_neg]
    rwa [heq]
  exact lintegral_iSup_translate_le_of_bounds hδ hcov hRefl hReflDeriv hd hq
    hBrefl hB'refl


/-! ## Existence of the convolutions appearing in the associativity step

Every convolution occurring in `Ψ ⋆ (h_k ⋆ h) = (h_k * Ψ) ⋆ h` pairs an `L¹`
function with a bounded one, so all of them exist.  These are the side
conditions of Mathlib's `convolution_assoc`. -/

/-- An `L¹` function against a bounded continuous one. -/
theorem integrable_mul_shift_of_bounded {f : ℝ → ℝ} (hf : Integrable f volume)
    {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (y : ℝ) : Integrable (fun t : ℝ => (f t : ℂ) * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (norm_nonneg (g 0)) (hbd 0)
  have hmeas : AEStronglyMeasurable (fun t : ℝ => (f t : ℂ) * g (y - t))
      volume := by
    refine AEStronglyMeasurable.mul ?_ ?_
    · exact Complex.continuous_ofReal.comp_aestronglyMeasurable
        hf.aestronglyMeasurable
    · exact (hg.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  refine Integrable.mono' (hf.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  calc |f t| * ‖g (y - t)‖ ≤ |f t| * C :=
        mul_le_mul_of_nonneg_left (hbd _) (abs_nonneg _)
    _ = C * |f t| := by ring

/-- The same, with the shift on the other side. -/
theorem integrable_mul_shift_of_bounded' {f : ℝ → ℝ} (hf : Integrable f volume)
    {g : ℝ → ℝ} {C : ℝ} (hgm : Measurable g) (hbd : ∀ z : ℝ, |g z| ≤ C)
    (y : ℝ) : Integrable (fun t : ℝ => f t * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg (g 0)) (hbd 0)
  have hmeas : AEStronglyMeasurable (fun t : ℝ => f t * g (y - t)) volume :=
    hf.aestronglyMeasurable.mul
      ((hgm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
  refine Integrable.mono' (hf.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs]
  calc |f t| * |g (y - t)| ≤ |f t| * C :=
        mul_le_mul_of_nonneg_left (hbd _) (abs_nonneg _)
    _ = C * |f t| := by ring


/-! ## Boundedness of the auxiliary convolution `‖Ψ‖ ⋆ ‖h‖` -/

/-- The convolution of an `L¹` function with a bounded one is bounded. -/
theorem convolution_norm_le_of_bounded {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (u : ℝ) :
    (∫ s : ℝ, ‖Ψ s‖ * ‖h (u - s)‖) ≤ C * ∫ s : ℝ, ‖Ψ s‖ := by
  have hCnn : 0 ≤ C := le_trans (norm_nonneg (h 0)) (hbd 0)
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  have hmeas : Measurable fun z : ℝ => ‖h z‖ := hh.norm.measurable
  have hleft : Integrable (fun s : ℝ => ‖Ψ s‖ * ‖h (u - s)‖) volume :=
    integrable_mul_shift_of_bounded' hΨint.norm hmeas
      (fun z => by
        rw [abs_of_nonneg (norm_nonneg _)]
        exact hbd z) u
  have hright : Integrable (fun s : ℝ => ‖Ψ s‖ * C) volume :=
    hΨint.norm.mul_const C
  calc (∫ s : ℝ, ‖Ψ s‖ * ‖h (u - s)‖) ≤ ∫ s : ℝ, ‖Ψ s‖ * C :=
        integral_mono hleft hright fun s =>
          mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
    _ = C * ∫ s : ℝ, ‖Ψ s‖ := by
        rw [integral_mul_const]
        ring

/-- The auxiliary convolution `‖Ψ‖ ⋆ ‖h‖` is continuous. -/
theorem continuous_convolution_norm {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) :
    Continuous ((fun z : ℝ => ‖Ψ z‖) ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
      fun z : ℝ => ‖h z‖) := by
  refine HasCompactSupport.continuous_convolution_left
    (ContinuousLinearMap.mul ℝ ℝ) ?_ hΨ.norm ?_
  · exact hΨcs.norm
  · exact hh.norm.locallyIntegrable


/-! ## Associativity for the truncated kernel -/

/-- **`(h_k * Ψ) ⋆ h = h_k ⋆ (Ψ ⋆ h)`.** -/
theorem brs_conv_assoc (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    ((brsTruncKernel k ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] Ψ)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
            ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
          h)) x := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  obtain ⟨MΨ, hMΨ⟩ := hΨ.bounded_above_of_compact_support hΨcs
  have hconvbd : ∀ z : ℝ,
      |((fun w : ℝ => ‖Ψ w‖) ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
        fun w : ℝ => ‖h w‖) z| ≤ C * ∫ s : ℝ, ‖Ψ s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖Ψ w‖) ⋆[ContinuousLinearMap.mul ℝ ℝ,
        volume] fun w : ℝ => ‖h w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    exact convolution_norm_le_of_bounded hΨ hΨcs hh hbd z
  refine convolution_assoc _ _ _ _ (fun a b z => mul_smul a b z)
    hK.aestronglyMeasurable hΨint.aestronglyMeasurable hh.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hK hΨ.measurable
      (fun z => by simpa only [Real.norm_eq_abs] using hMΨ z) y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    refine integrable_mul_shift_of_bounded' (C := C) hΨint.norm
      hh.norm.measurable (fun z => ?_) u
    rw [abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hK.norm
      (continuous_convolution_norm hΨ hΨcs hh).measurable hconvbd x


/-! ## The smoothed near part, and the resolution applied to it

`h_k ⋆ h` is continuous whenever `h` is bounded and continuous, so the
resolution of the identity applies to it directly. -/

/-- The convolution with the truncated kernel is continuous. -/
theorem continuous_brsTruncKernel_convolution (k : ℕ) {h : ℝ → ℂ}
    (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) :
    Continuous (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) := by
  refine BddAbove.continuous_convolution_right_of_integrable _ ?_
    (integrable_brsTruncKernel k) hh
  refine ⟨C, ?_⟩
  rintro y ⟨z, rfl⟩
  exact hbd z

/-- **The resolution of the identity applied to the smoothed near part.** -/
theorem brs_resolution_truncConv (k s : ℕ) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (hnorm : (∫ x, φ x) = 1) {h : ℝ → ℂ}
    (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    Tendsto (fun M : ℕ =>
        (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
            (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
              ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) +
          ∑ m ∈ Finset.range M, ∫ y : ℝ,
            (brsLPKernel φ (k + s + m) y : ℂ) *
              (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
                ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y))
      atTop (𝓝 ((brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x)) :=
  brs_lp_resolution_shift_tendsto hφ hsupp hnorm
    (continuous_brsTruncKernel_convolution k hh hbd) (k + s) x


/-! ## Associativity with the bump on the outside

The resolution of the identity produces the pieces in the form `Ψ ⋆ (h_k ⋆ h)`,
so the associativity is needed with `Ψ` as the outer factor. -/

/-- A bounded function against a shifted `L¹` one. -/
theorem integrable_bounded_mul_shift {f : ℝ → ℝ} {C : ℝ} (hfm : Measurable f)
    (hbd : ∀ z : ℝ, |f z| ≤ C) {g : ℝ → ℝ} (hg : Integrable g volume)
    (y : ℝ) : Integrable (fun t : ℝ => f t * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg (f 0)) (hbd 0)
  have hshift : Integrable (fun t : ℝ => g (y - t)) volume := hg.comp_sub_left y
  have hmeas : AEStronglyMeasurable (fun t : ℝ => f t * g (y - t)) volume :=
    hfm.aestronglyMeasurable.mul hshift.aestronglyMeasurable
  refine Integrable.mono' (hshift.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_right (hbd t) (abs_nonneg _)

/-- **`(Ψ * h_k) ⋆ h = Ψ ⋆ (h_k ⋆ h)`.** -/
theorem brs_conv_assoc' (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  obtain ⟨MΨ, hMΨ⟩ := hΨ.bounded_above_of_compact_support hΨcs
  -- the auxiliary convolution `‖h_k‖ ⋆ ‖h‖` is bounded and continuous
  have hauxcont : Continuous ((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hK.norm
      hh.norm
    refine ⟨C, ?_⟩
    rintro y ⟨z, rfl⟩
    show ‖‖h z‖‖ ≤ C
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  have hauxbd : ∀ z : ℝ, |((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z| ≤
      C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖brsTruncKernel k w‖)
        ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    have hleft : Integrable (fun s : ℝ =>
        ‖brsTruncKernel k s‖ * ‖h (z - s)‖) volume :=
      integrable_mul_shift_of_bounded' (C := C) hK.norm hh.norm.measurable
        (fun w => by
          rw [abs_of_nonneg (norm_nonneg _)]
          exact hbd w) z
    have hright : Integrable (fun s : ℝ => ‖brsTruncKernel k s‖ * C) volume :=
      hK.norm.mul_const C
    calc (∫ s : ℝ, ‖brsTruncKernel k s‖ * ‖h (z - s)‖)
        ≤ ∫ s : ℝ, ‖brsTruncKernel k s‖ * C :=
          integral_mono hleft hright fun s =>
            mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
      _ = C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
          rw [integral_mul_const]
          ring
  refine convolution_assoc _ _ _ _ (fun a b z => mul_smul a b z)
    hΨint.aestronglyMeasurable hK.aestronglyMeasurable hh.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_bounded_mul_shift hΨ.measurable
      (fun z => by simpa only [Real.norm_eq_abs] using hMΨ z) hK y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    refine integrable_mul_shift_of_bounded' (C := C) hK.norm
      hh.norm.measurable (fun z => ?_) u
    rw [abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hΨint.norm hauxcont.measurable
      hauxbd x


/-! ## Each piece of the resolution has the smooth kernel `h_k * Ψ`

Testing the smoothed near part against a bump is the same as testing the input
against the smooth kernel `h_k * Ψ`.  This is what puts every piece of the
resolution into the shape that `brs_5_9` estimates. -/

/-- **The piece of the resolution, with its kernel identified.** -/
theorem brs_piece_eq (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    (∫ y : ℝ, (Ψ y : ℂ) *
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * h (x - y) := by
  have h1 : (∫ y : ℝ, (Ψ y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := (convolution_eq_integral x).symm
  have h2 : (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x =
      ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x :=
    (brs_conv_assoc' k hΨ hΨcs hh hbd x).symm
  have h3 : ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
      ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      ∫ y : ℝ, (((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
        brsTruncKernel k) y : ℝ) : ℂ) * h (x - y) := convolution_eq_integral x
  have h4 : (Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k) =
      brsTruncConvReal k Ψ := (brsTruncConvReal_eq_convolution k Ψ).symm
  rw [h1, h2, h3, h4]


/-! ## Passing from the resolution to a domination

The resolution converges, so the limit is dominated by the low-frequency term
plus the sum of the high-frequency pieces. -/

/-- **The limit of a convergent resolution is dominated by its terms.** -/
theorem enorm_le_tsum_of_tendsto {A : ℕ → ℂ} {L S : ℂ}
    (h : Tendsto (fun M : ℕ => L + ∑ m ∈ Finset.range M, A m) atTop (𝓝 S)) :
    ‖S‖ₑ ≤ ‖L‖ₑ + ∑' m : ℕ, ‖A m‖ₑ := by
  have hnorm : Tendsto (fun M : ℕ => ‖L + ∑ m ∈ Finset.range M, A m‖ₑ) atTop
      (𝓝 ‖S‖ₑ) := (continuous_enorm.tendsto S).comp h
  refine le_of_tendsto hnorm ?_
  filter_upwards with M
  calc ‖L + ∑ m ∈ Finset.range M, A m‖ₑ
      ≤ ‖L‖ₑ + ‖∑ m ∈ Finset.range M, A m‖ₑ := enorm_add_le _ _
    _ ≤ ‖L‖ₑ + ∑ m ∈ Finset.range M, ‖A m‖ₑ := by
        refine add_le_add le_rfl ?_
        exact enorm_sum_le _ _
    _ ≤ ‖L‖ₑ + ∑' m : ℕ, ‖A m‖ₑ :=
        add_le_add le_rfl (ENNReal.sum_le_tsum _)


/-! ## The maximal function of one piece -/

/-- A supremum of sums is at most the sum of the suprema. -/
theorem iSup_add_tsum_le {ι : Type*} {S : Set ι} {a : ι → ENNReal}
    {b : ℕ → ι → ENNReal} :
    (⨆ t ∈ S, (a t + ∑' m : ℕ, b m t)) ≤
      (⨆ t ∈ S, a t) + ∑' m : ℕ, ⨆ t ∈ S, b m t := by
  refine iSup₂_le fun t ht => ?_
  refine add_le_add (le_iSup₂_of_le t ht le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le t ht le_rfl

/-- The maximal function, over `t ∈ E`, of one piece of the resolution. -/
def brsNearPieceMax (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ

theorem brsRefl_bounded {g : ℝ → ℂ} {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (z : ℝ) : ‖brsRefl g z‖ ≤ C := hbd (-z)


/-! ## The near part is dominated by the pieces of the resolution -/

/-- **The near part, decomposed.**  With the truncation at the dyadic scale
`2^{-k}`, the near part of `R_2^-` is dominated by the low-frequency piece at
scale `k + s` plus the sum of the high-frequency pieces above it, each of which
carries the smooth kernel `h_k * Ψ`. -/
theorem brsANearLeftAt_le_pieces (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearLeftAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearPieceMax k (brsDilate φ (k + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax k (brsLPKernel φ (k + s + m)) g E r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  rw [brsANearLeftAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (iSup₂_mono fun t _ => ?_) iSup_add_tsum_le
  -- the resolution, evaluated at `-(t - r)`
  set x : ℝ := -(t - r) with hx
  have hres := brs_resolution_truncConv k s hφ hφcs hφnorm hgrefl hgreflbd x
  have hlow : (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq k (continuous_brsDilate hφ (k + s))
      (hasCompactSupport_brsDilate hφcs (k + s)) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel φ (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl g (x - y) := fun m =>
    brs_piece_eq k (continuous_brsLPKernel hφ (k + s + m))
      (hasCompactSupport_brsLPKernel hφcs (k + s + m)) hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres


/-! ## The maximal estimate for one piece of the resolution

This is `brs_5_9_core` in the reflected form produced by the decomposition of
the near part.  Reflection costs nothing, so the bound is the same. -/

/-- The maximal function of one piece over all of `E`. -/
def brsNearFullMax (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
    ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ

theorem brsNearPieceMax_le_full (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsNearPieceMax k Ψ g E r ≤ brsNearFullMax k Ψ g E r :=
  biSup_mono fun t ht => ht.1

/-- **The maximal estimate for one piece.** -/
theorem lintegral_brsNearFullMax_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (k : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsNearFullMax k υ g E x ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq1 : (1 : ℝ) < q := lt_trans hr hrq
  have hq0 : (0 : ℝ) < q := lt_trans zero_lt_one hq1
  have hgr : Continuous (brsRefl g) := continuous_brsRefl hg
  set K : ℝ → ℝ := brsTruncConvReal k υ with hKdef
  set K' : ℝ → ℝ := brsTruncConvReal k (deriv υ) with hK'def
  have hKcs : HasCompactSupport K := hasCompactSupport_brsTruncConvReal k hcs
  have hKcd : ContDiff ℝ 1 K := contDiff_brsTruncConvReal k (n := 1) hυ hcs
  have hK'cs : HasCompactSupport K' := hasCompactSupport_brsTruncConvReal k hcs'
  have hK'cd : ContDiff ℝ 1 K' :=
    contDiff_brsTruncConvReal k (n := 1) hυ' hcs'
  have hKm : Measurable K := hKcd.continuous.measurable
  have hK'm : Measurable K' := hK'cd.continuous.measurable
  have hderivK : deriv K = K' := by
    funext x
    exact (hasDerivAt_brsTruncConvReal k hcs hυ x).deriv
  set F : ℝ → ℂ := fun x => ∫ y : ℝ, (K y : ℂ) * brsRefl g (x - y) with hFdef
  set F' : ℝ → ℂ := fun x => ∫ y : ℝ, (K' y : ℂ) * brsRefl g (x - y) with hF'def
  have hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x := by
    intro x
    have h := hasDerivAt_kernel_convolution hKcs hKcd hgr x
    rw [hderivK] at h
    exact h
  have hFdiff : Differentiable ℝ F := fun x => (hderiv x).differentiableAt
  have hFcont : Continuous F := hFdiff.continuous
  have hF'cont : Continuous F' := by
    have hd2 : ∀ x : ℝ, HasDerivAt F'
        (∫ y : ℝ, ((deriv K' y : ℝ) : ℂ) * brsRefl g (x - y)) x := fun x =>
      hasDerivAt_kernel_convolution hK'cs hK'cd hgr x
    have hF'diff : Differentiable ℝ F' := fun x => (hd2 x).differentiableAt
    exact hF'diff.continuous
  -- the reflection does not change the `L^p` norm of `g`
  have hgp : (∫⁻ z : ℝ, ‖brsRefl g z‖ₑ ^ p) = ∫⁻ z : ℝ, ‖g z‖ₑ ^ p :=
    lintegral_enorm_comp_neg g p
  -- the two Young bounds
  have hyoung : ∀ H : ℝ → ℝ, Measurable H →
      (∫⁻ z : ℝ, ‖∫ y : ℝ, (H y : ℂ) * brsRefl g (z - y)‖ₑ ^ q) ^ (1 / q) ≤
        (∫⁻ y : ℝ, ‖H y‖ₑ ^ r) ^ (1 / r) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    intro H hH
    have h := lintegral_convolution_rpow_le_young hp hr hrq hpq hrel hH
      hgr.measurable
    rw [hgp] at h
    refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
    exact young_rpow_inv hp0 hq0 hr0
  exact lintegral_iSup_translate_refl_le hδ hcov hFcont hF'cont hderiv
    hq1.le (hyoung K hKm) (hyoung K' hK'm)




/-! ## The dyadic windows, extended to cover the whole range of radii

`R_2` vanishes for `r > 4/3`, but the dyadic windows `I_k` only cover `(0, 1]`.
Enlarging the top window to `(1/2, 4/3]` — which is still comparable to
`2^{-0} = 1` — makes the family cover `(0, 4/3]` without changing any of the
estimates: all that is used is that the windows are disjoint, that `r ≍ 2^{-k}`
on the `k`-th one, and that the truncation `2^{-(k+1)}` does not exceed `r`. -/

/-- The dyadic windows, with the top one enlarged to `(1/2, 4/3]`. -/
def brsWindowExt (k : ℕ) : Set ℝ :=
  match k with
  | 0 => Ioc (2 : ℝ)⁻¹ (4 / 3)
  | (k + 1) => brsRadiusWindow (k + 1)

theorem brsWindowExt_zero : brsWindowExt 0 = Ioc (2 : ℝ)⁻¹ (4 / 3) := rfl

theorem brsWindowExt_succ (k : ℕ) :
    brsWindowExt (k + 1) = brsRadiusWindow (k + 1) := rfl

theorem measurableSet_brsWindowExt (k : ℕ) : MeasurableSet (brsWindowExt k) := by
  cases k with
  | zero => exact measurableSet_Ioc
  | succ k => exact measurableSet_brsRadiusWindow (k + 1)

theorem brsWindowExt_pos {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) : 0 < r := by
  cases k with
  | zero =>
      have h : (2 : ℝ)⁻¹ < r := hr.1
      linarith
  | succ k => exact brsRadiusWindow_pos hr

/-- The windows of positive index sit below `1/2`. -/
theorem brsRadiusWindow_succ_le_half {k : ℕ} {r : ℝ}
    (hr : r ∈ brsRadiusWindow (k + 1)) : r ≤ (2 : ℝ)⁻¹ := by
  refine le_trans hr.2 ?_
  have h : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (-(1 : ℝ)) := by
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : (1 : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by
      push_cast
      have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
    linarith
  refine le_trans h (le_of_eq ?_)
  rw [show (-(1 : ℝ)) = ((-1 : ℤ) : ℝ) by norm_num, Real.rpow_intCast]
  norm_num

theorem brsWindowExt_disjoint {k l : ℕ} (h : k ≠ l) :
    Disjoint (brsWindowExt k) (brsWindowExt l) := by
  refine Set.disjoint_left.mpr fun r hk hl => ?_
  cases k with
  | zero =>
      cases l with
      | zero => exact h rfl
      | succ l =>
          have h1 : (2 : ℝ)⁻¹ < r := hk.1
          have h2 : r ≤ (2 : ℝ)⁻¹ := brsRadiusWindow_succ_le_half hl
          linarith
  | succ k =>
      cases l with
      | zero =>
          have h1 : (2 : ℝ)⁻¹ < r := hl.1
          have h2 : r ≤ (2 : ℝ)⁻¹ := brsRadiusWindow_succ_le_half hk
          linarith
      | succ l =>
          exact Set.disjoint_left.mp
            (brsRadiusWindow_disjoint (fun hc => h (by omega))) hk hl

/-- On every extended window the radius is comparable to `2^{-k}`. -/
theorem rpow_le_of_mem_brsWindowExt {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k)
    (e : ℝ) : r ^ e ≤ (2 : ℝ) ^ |e| * ((2 : ℝ) ^ (-(k : ℝ))) ^ e := by
  cases k with
  | zero =>
      have hlow : (2 : ℝ)⁻¹ < r := hr.1
      have hhigh : r ≤ 4 / 3 := hr.2
      have hrpos : (0 : ℝ) < r := by linarith
      have hone : ((2 : ℝ) ^ (-((0 : ℕ) : ℝ))) ^ e = 1 := by
        norm_num
      rw [hone, mul_one]
      rcases le_or_gt 0 e with he | he
      · have h1 : r ^ e ≤ (2 : ℝ) ^ e :=
          Real.rpow_le_rpow hrpos.le (by linarith) he
        rwa [abs_of_nonneg he]
      · have h1 : r ^ e ≤ ((2 : ℝ)⁻¹) ^ e :=
          Real.rpow_le_rpow_of_nonpos (by norm_num) hlow.le he.le
        have h2 : ((2 : ℝ)⁻¹) ^ e = (2 : ℝ) ^ |e| := by
          rw [Real.inv_rpow (by norm_num), abs_of_neg he,
            ← Real.rpow_neg (by norm_num)]
        rwa [h2] at h1
  | succ k => exact rpow_le_of_mem_brsRadiusWindow hr e

/-- The truncation scale never exceeds the radius. -/
theorem brsCut_le_of_mem_windowExt {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) :
    (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := by
  cases k with
  | zero =>
      have h : (2 : ℝ)⁻¹ < r := hr.1
      have hcast : (2 : ℝ) ^ (-((0 + 1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by
        norm_num
      rw [hcast]
      exact h.le
  | succ k =>
      have h : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) - 1) < r := hr.1
      have hcast : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
          (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) - 1) := by
        congr 1
        push_cast
        ring
      rw [hcast]
      exact h.le

/-! ## The radial weight on the window, for an arbitrary maximal function

On `I_k` the measure `r^{-q/2} r dr` costs `(2^{-k})^{1 - q/2}`, whatever the
maximal function it multiplies. -/

/-- **The radial weight costs `(2^{-k})^{1 - q/2}`.** -/
theorem lintegral_window_weight_rpow_le (k : ℕ) (S : ℝ → ENNReal) {q : ℝ}
    (hq : 0 < q) :
    (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) * ∫⁻ r : ℝ, S r ^ q := by
  set C : ℝ := (2 : ℝ) ^ |1 - q / 2| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)
    with hC
  have hpt : ∀ r : ℝ, ((brsWindowExt k).indicator
      (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
        ENNReal.ofReal r ≤ ENNReal.ofReal C * S r ^ q := by
    intro r
    by_cases hr : r ∈ brsWindowExt k
    · have hrpos : 0 < r := brsWindowExt_pos hr
      have hval : ((brsWindowExt k).indicator
          (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
            ENNReal.ofReal r = ENNReal.ofReal (r ^ (1 - q / 2)) * S r ^ q := by
        rw [Set.indicator_of_mem hr]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (S r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r ^ (1 - q / 2))) (S r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
              rw [Real.rpow_one]
          _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
          _ = r ^ (1 - q / 2) := by
              congr 1
              ring
      rw [hval]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (rpow_le_of_mem_brsWindowExt hr (1 - q / 2))) le_rfl
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal C * S r ^ q := lintegral_mono hpt
    _ = ENNReal.ofReal C * ∫⁻ r : ℝ, S r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- One piece of the resolution, with the window and the radial weight. -/
def brsNearMax (kw kt : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  (brsWindowExt kw).indicator
    (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      brsNearFullMax kt Ψ g E r) r

/-- **The weighted maximal estimate for one piece of the resolution.**  The
window index `kw` and the truncation index `kt` are kept apart: the cutoff must
not exceed the radius, so on `I_k` the truncation sits one scale finer. -/
theorem lintegral_brsNearMax_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (kw kt : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsNearMax kw kt υ g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal kt υ y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
              ENNReal.ofReal δ *
                ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                  (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  refine le_trans (lintegral_window_weight_rpow_le kw _ hq0) ?_
  exact mul_le_mul' le_rfl
    (lintegral_brsNearFullMax_rpow_le hδ hcov kt hcs hυ hcs' hυ' hg hp hr hrq
      hpq hrel)


/-! ## Young's inequality `L¹ ∗ L^r ⊆ L^r`

The lowest-frequency piece of the resolution carries no cancellation, so its
kernel `h_k * φ_j` has to be estimated by the plain convolution inequality.
Mathlib's Young inequality is stated for the Bochner integral with strict
exponent inequalities, so this endpoint case is proved here directly from
Hölder and Tonelli. -/

/-- `a ^ (r - 1) * a = a ^ r`, valid also at `a = 0`. -/
theorem ennreal_rpow_sub_one_mul {a : ENNReal} (ha : a ≠ ⊤) {r : ℝ}
    (hr : 1 ≤ r) : a ^ (r - 1) * a = a ^ r := by
  rcases eq_or_ne a 0 with rfl | ha0
  · rcases eq_or_lt_of_le hr with hr1 | hr1
    · rw [← hr1]
      norm_num
    · rw [ENNReal.zero_rpow_of_pos (by linarith), ENNReal.zero_rpow_of_pos
        (by linarith), mul_zero]
  · have h := ENNReal.rpow_add (x := a) (r - 1) 1 ha0 ha
    rw [ENNReal.rpow_one] at h
    rw [← h]
    congr 1
    ring

/-- The pointwise Hölder step in Young's inequality. -/
theorem lintegral_shift_mul_rpow_le_pointwise {K w : ℝ → ENNReal}
    (hK : Measurable K) (hw : Measurable w) {r : ℝ} (hr : 1 ≤ r) (x : ℝ) :
    (∫⁻ y : ℝ, K (x - y) * w y) ^ r ≤
      (∫⁻ y : ℝ, K (x - y) ^ r * w y) * (∫⁻ y : ℝ, w y) ^ (r - 1) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  rcases eq_or_lt_of_le hr with hr1 | hr1
  · rw [← hr1]
    simp only [ENNReal.rpow_one, sub_self, ENNReal.rpow_zero, mul_one]
    exact le_rfl
  · have hrinv : 1 / r < 1 := by
      rw [div_lt_one (by linarith)]
      exact hr1
    have hconj : r.HolderConjugate (Real.conjExponent r) :=
      Real.HolderConjugate.conjExponent hr1
    have hs : Real.conjExponent r = r / (r - 1) := rfl
    have hprod : ∀ y : ℝ, K (x - y) * w y =
        (K (x - y) * w y ^ (1 / r)) * w y ^ (1 - 1 / r) := by
      intro y
      rcases eq_or_ne (w y) 0 with hwy | hwy
      · rw [hwy, ENNReal.zero_rpow_of_pos (by positivity),
          ENNReal.zero_rpow_of_pos (by linarith), mul_zero, mul_zero]
      · rcases eq_or_ne (w y) ⊤ with hwt | hwt
        · rw [hwt, ENNReal.top_rpow_of_pos (by positivity),
            ENNReal.top_rpow_of_pos (by linarith), mul_assoc,
            ENNReal.top_mul_top]
        · have h := ENNReal.rpow_add (x := w y) (1 / r) (1 - 1 / r) hwy hwt
          rw [show (1 / r + (1 - 1 / r) : ℝ) = 1 by ring, ENNReal.rpow_one] at h
          rw [mul_assoc, ← h]
    have hfm : AEMeasurable (fun y : ℝ => K (x - y) * w y ^ (1 / r)) volume :=
      ((hK.comp (measurable_const.sub measurable_id)).mul
        (hw.pow_const _)).aemeasurable
    have hgm : AEMeasurable (fun y : ℝ => w y ^ (1 - 1 / r)) volume :=
      (hw.pow_const _).aemeasurable
    have hhold := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hconj hfm hgm
    simp only [Pi.mul_apply] at hhold
    rw [← lintegral_congr hprod] at hhold
    have hfr : (∫⁻ y : ℝ, (K (x - y) * w y ^ (1 / r)) ^ r) =
        ∫⁻ y : ℝ, K (x - y) ^ r * w y := by
      refine lintegral_congr fun y => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, one_div,
        inv_mul_cancel₀ (ne_of_gt hr0), ENNReal.rpow_one]
    have hgr : (∫⁻ y : ℝ, (w y ^ (1 - 1 / r)) ^ Real.conjExponent r) =
        ∫⁻ y : ℝ, w y := by
      refine lintegral_congr fun y => ?_
      rw [← ENNReal.rpow_mul, hs,
        show (1 - 1 / r) * (r / (r - 1)) = 1 by field_simp, ENNReal.rpow_one]
    rw [hfr, hgr] at hhold
    refine le_trans (ENNReal.rpow_le_rpow hhold hr0.le) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
    congr 1
    · rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ (ne_of_gt hr0),
        ENNReal.rpow_one]
    · rw [← ENNReal.rpow_mul, hs]
      congr 1
      field_simp

/-- **Young's inequality, `L¹ ∗ L^r ⊆ L^r`, in `ℝ≥0∞` form.** -/
theorem lintegral_shift_mul_rpow_le {K w : ℝ → ENNReal} (hK : Measurable K)
    (hw : Measurable w) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * w y) ^ r) ≤
      (∫⁻ y : ℝ, w y) ^ (r - 1) *
        ((∫⁻ y : ℝ, w y) * ∫⁻ u : ℝ, K u ^ r) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  set S : ENNReal := ∫⁻ y : ℝ, w y with hS
  have hjoint : Measurable
      (Function.uncurry fun x y : ℝ => K (x - y) ^ r * w y) :=
    ((hK.comp (measurable_fst.sub measurable_snd)).pow_const r).mul
      (hw.comp measurable_snd)
  have hmeas : Measurable fun x : ℝ => ∫⁻ y : ℝ, K (x - y) ^ r * w y :=
    hjoint.lintegral_prod_right' (ν := (volume : Measure ℝ))
  refine le_trans (lintegral_mono fun x =>
    lintegral_shift_mul_rpow_le_pointwise hK hw hr x) ?_
  rw [lintegral_mul_const'' _ hmeas.aemeasurable]
  rw [mul_comm (S ^ (r - 1)) (S * ∫⁻ u : ℝ, K u ^ r)]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  have hinner : ∀ y : ℝ, (∫⁻ x : ℝ, K (x - y) ^ r * w y) =
      (∫⁻ u : ℝ, K u ^ r) * w y := by
    intro y
    have hm : AEMeasurable (fun x : ℝ => K (x - y) ^ r) volume :=
      ((hK.comp (measurable_id.sub measurable_const)).pow_const r).aemeasurable
    rw [lintegral_mul_const'' (w y) (f := fun x : ℝ => K (x - y) ^ r) hm]
    congr 1
    exact lintegral_sub_right_eq_self (fun u => K u ^ r) y
  simp only [hinner]
  rw [lintegral_const_mul'' _ hw.aemeasurable, mul_comm]


/-! ## Aggregation over the dyadic windows, for an arbitrary family

The `k`-aggregation only uses that the windows `I_k` are pairwise disjoint and
that the `k`-th term vanishes off `I_k`; nothing else about the family matters.
Stating it this way lets the same argument serve both `𝒜_{k,m}` and the pieces
of the resolution of the identity. -/

/-- The `q`-th power of the sum over `k` is the sum of the `q`-th powers. -/
theorem tsum_window_rpow {A : ℕ → ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A k r = 0) {q : ℝ}
    (hq : 0 < q) (r : ℝ) :
    (∑' k : ℕ, A k r) ^ q = ∑' k : ℕ, A k r ^ q := by
  by_cases h : ∃ k : ℕ, r ∈ brsWindowExt k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ → A k r = 0 := by
      intro k hk
      refine hA k r fun hr => ?_
      exact Set.disjoint_left.mp (brsWindowExt_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero,
      tsum_eq_single k₀ fun k hk => by
        rw [hzero k hk, ENNReal.zero_rpow_of_pos hq]]
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, A k r = 0 := fun k => hA k r (h k)
    simp only [hall, tsum_zero, ENNReal.zero_rpow_of_pos hq]

/-- **The `k`-aggregation.**  Because the windows `I_k` are disjoint, the radial
`L^q` norm of the sum is exactly the `ℓ^q` sum. -/
theorem lintegral_tsum_window_rpow {A : ℕ → ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A k r = 0)
    (hmeas : ∀ k : ℕ, Measurable (A k)) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, A k r) ^ q * ENNReal.ofReal r) =
      ∑' k : ℕ, ∫⁻ r : ℝ, A k r ^ q * ENNReal.ofReal r := by
  have hmeas' : ∀ k : ℕ, AEMeasurable (fun r : ℝ =>
      A k r ^ q * ENNReal.ofReal r) volume := fun k =>
    (((hmeas k).pow_const q).mul ENNReal.measurable_ofReal).aemeasurable
  have hpt : ∀ r : ℝ, (∑' k : ℕ, A k r) ^ q * ENNReal.ofReal r =
      ∑' k : ℕ, A k r ^ q * ENNReal.ofReal r := by
    intro r
    rw [tsum_window_rpow hA hq r, ← ENNReal.tsum_mul_right]
  rw [lintegral_congr hpt]
  exact lintegral_tsum hmeas'

/-- **The double sum over the scales.** -/
theorem window_double_sum_le {A : ℕ → ℕ → ℝ → ENNReal}
    (hA : ∀ m k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A m k r = 0)
    (hmeas : ∀ m k : ℕ, Measurable (A m k)) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' m : ℕ, ∑' k : ℕ, A m k r) ^ q * ENNReal.ofReal r) ^
        (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ,
        ∫⁻ r : ℝ, A m k r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hGmeas : ∀ m : ℕ, Measurable fun r : ℝ => ∑' k : ℕ, A m k r :=
    fun m => Measurable.ennreal_tsum fun k => hmeas m k
  refine le_trans (lintegral_radial_Lp_tsum_le hq hGmeas) (le_of_eq ?_)
  refine tsum_congr fun m => ?_
  rw [lintegral_tsum_window_rpow (fun k => hA m k) (hmeas m) hq0]


/-! ## The kernel of the lowest-frequency piece

`φ_{k+s}` is an approximate identity, so `h_k * φ_{k+s}` carries no
cancellation and (5.12) does not apply.  Young's inequality gives the bound
`‖h_k * φ_j‖_r ≤ ‖φ‖₁ ‖h_k‖_r`, which is the same dyadic factor
`(2^{-k})^{1/r - 1/2}` that (5.12) produces at `j = k`. -/

/-- **`‖h_k * ψ‖_r ≤ ‖ψ‖₁ ‖h_k‖_r`.** -/
theorem lintegral_enorm_brsTruncConvReal_le_L1 (k : ℕ) {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hint : Integrable ψ volume) {A : ℝ}
    (hA : (∫ y : ℝ, |ψ y|) ≤ A) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (A ^ r) *
        ∫⁻ u : ℝ, ENNReal.ofReal (brsTruncKernel k u) ^ r := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  set K : ℝ → ENNReal := fun u => ENNReal.ofReal (brsTruncKernel k u) with hK
  set w : ℝ → ENNReal := fun y => ‖ψ y‖ₑ with hw
  have hKm : Measurable K := ENNReal.measurable_ofReal.comp
    (measurable_brsTruncKernel k)
  have hwm : Measurable w := hψ.measurable.enorm
  -- the pointwise bound
  have hpt : ∀ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ≤ ∫⁻ y : ℝ, K (x - y) * w y := by
    intro x
    rw [brsTruncConvReal]
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun y => ?_
    rw [enorm_mul, hK, hw]
    simp only
    rw [enorm_brsTruncKernel]
  -- the `L¹` mass of `ψ`
  have hS : (∫⁻ y : ℝ, w y) ≤ ENNReal.ofReal A := by
    have heq : (∫⁻ y : ℝ, w y) = ∫⁻ y : ℝ, ENNReal.ofReal |ψ y| := by
      refine lintegral_congr fun y => ?_
      rw [hw]
      simp only
      rw [← ofReal_norm, Real.norm_eq_abs]
    rw [heq]
    exact lintegral_ofReal_abs_le_of_integrable hint hA
  calc (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r)
      ≤ ∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * w y) ^ r :=
        lintegral_mono fun x => ENNReal.rpow_le_rpow (hpt x) hr0.le
    _ ≤ (∫⁻ y : ℝ, w y) ^ (r - 1) *
          ((∫⁻ y : ℝ, w y) * ∫⁻ u : ℝ, K u ^ r) :=
        lintegral_shift_mul_rpow_le hKm hwm hr
    _ ≤ ENNReal.ofReal A ^ (r - 1) *
          (ENNReal.ofReal A * ∫⁻ u : ℝ, K u ^ r) :=
        mul_le_mul' (ENNReal.rpow_le_rpow hS (by linarith))
          (mul_le_mul' hS le_rfl)
    _ = ENNReal.ofReal (A ^ r) * ∫⁻ u : ℝ, K u ^ r := by
        rw [← mul_assoc, ennreal_rpow_sub_one_mul ENNReal.ofReal_ne_top hr,
          ENNReal.ofReal_rpow_of_nonneg hAnn hr0.le]

/-- **The kernel of the lowest-frequency piece.** -/
theorem lintegral_enorm_brsTruncConvReal_dilate_le_L1 (k j : ℕ) {φ : ℝ → ℝ}
    (hφ : Continuous φ) (hcs : HasCompactSupport φ) {A : ℝ}
    (hA : (∫ y : ℝ, |φ y|) ≤ A) {r : ℝ} (hr : 1 ≤ r) (hr2 : r < 2) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k (brsDilate φ j) x‖ₑ ^ r) ≤
      ENNReal.ofReal (A ^ r *
        (((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2))) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hint : Integrable (brsDilate φ j) volume :=
    (continuous_brsDilate hφ j).integrable_of_hasCompactSupport
      (hasCompactSupport_brsDilate hcs j)
  have hA' : (∫ y : ℝ, |brsDilate φ j y|) ≤ A := by
    rw [integral_abs_brsDilate]
    exact hA
  refine le_trans (lintegral_enorm_brsTruncConvReal_le_L1 k
    (continuous_brsDilate hφ j) hint hA' hr) ?_
  rw [lintegral_brsTruncKernel_rpow k hr0 hr2]
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hAnn r)]


/-! ## The derivative of the lowest-frequency piece

Differentiating a dilate costs a factor `2^j`, which is exactly cancelled by
the factor `δ = 2^{-j}` multiplying the derivative term in the localized
maximal estimate. -/

/-- The `L¹` norm of the derivative of a dilate. -/
theorem integral_abs_deriv_brsDilate {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (j : ℕ) :
    (∫ y : ℝ, |deriv (brsDilate φ j) y|) =
      (2 : ℝ) ^ j * ∫ y : ℝ, |deriv φ y| := by
  rw [deriv_brsDilate_eq hφ j, integral_abs_brsDilate]
  have habs : ∀ y : ℝ, |(2 : ℝ) ^ j * deriv φ y| = (2 : ℝ) ^ j * |deriv φ y| := by
    intro y
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ j)]
  simp only [habs]
  exact integral_const_mul _ _

/-- **The kernel of the derivative of the lowest-frequency piece.** -/
theorem lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 (k j : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφ' : Continuous (deriv φ))
    (hcs : HasCompactSupport (deriv φ))
    {A' : ℝ} (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A') {r : ℝ} (hr : 1 ≤ r)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) x‖ₑ ^ r) ≤
      ENNReal.ofReal (((2 : ℝ) ^ j * A') ^ r *
        (((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2))) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hdcont : Continuous (deriv φ) := hφ'
  have hdilcs : HasCompactSupport (deriv (brsDilate φ j)) := by
    rw [deriv_brsDilate_eq hφ j]
    exact hasCompactSupport_brsDilate (hcs.mul_left) j
  have hdilcont : Continuous (deriv (brsDilate φ j)) := by
    rw [deriv_brsDilate_eq hφ j]
    exact continuous_brsDilate (continuous_const.mul hdcont) j
  have hint : Integrable (deriv (brsDilate φ j)) volume :=
    hdilcont.integrable_of_hasCompactSupport hdilcs
  have hAle : (∫ y : ℝ, |deriv (brsDilate φ j) y|) ≤ (2 : ℝ) ^ j * A' := by
    rw [integral_abs_deriv_brsDilate hφ j]
    exact mul_le_mul_of_nonneg_left hA' h2j.le
  refine le_trans (lintegral_enorm_brsTruncConvReal_le_L1 k hdilcont hint hAle
    hr) ?_
  rw [lintegral_brsTruncKernel_rpow k hr0 hr2]
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) r)]


/-! ## (5.9) for the lowest-frequency piece

The constant carrying the truncation scale. -/

/-- The `L^r` norm of `h_k`, to the `r`-th power. -/
def brsLowConst (k : ℕ) (r : ℝ) : ℝ :=
  ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2)

theorem brsLowConst_nonneg (k : ℕ) {r : ℝ} (hr2 : r < 2) :
    0 ≤ brsLowConst k r := by
  rw [brsLowConst]
  have h1 : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) :=
    Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
  have h2 : (0 : ℝ) < 1 - r / 2 := by linarith
  positivity

/-- **(5.9) for the lowest-frequency piece of the resolution.** -/
theorem brs_5_9_near_low {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : 0 ≤ brsLowConst kt r := brsLowConst_nonneg kt hr2
  have hCr : 0 ≤ brsLowConst kt r ^ (1 / r) := Real.rpow_nonneg hCnn _
  -- the smoothness hypotheses for the dilate
  have hdil : ContDiff ℝ 1 (brsDilate φ j) := contDiff_brsDilate hφ j
  have hdilcs : HasCompactSupport (brsDilate φ j) :=
    hasCompactSupport_brsDilate hcs j
  have hderiv : deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j := deriv_brsDilate_eq hφ j
  have hdercs : HasCompactSupport (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact hasCompactSupport_brsDilate hcs'.mul_left j
  have hdercd : ContDiff ℝ 1 (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact contDiff_brsDilate (contDiff_const.mul hφ') j
  -- the two kernel bounds
  have hker : (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_dilate_le_L1 kt j hφ.continuous hcs hA
        hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst, Real.mul_rpow (Real.rpow_nonneg hAnn r) (by positivity),
      ← Real.rpow_mul hAnn, mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  have hker' : (∫⁻ y : ℝ,
      ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 kt j hφ
        hφ'.continuous hcs' hA' hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst,
      Real.mul_rpow (Real.rpow_nonneg (by positivity) r) (by positivity),
      ← Real.rpow_mul (by positivity), mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  refine le_trans (lintegral_brsNearMax_rpow_le hδ hcov kw kt hdilcs hdil hdercs
    hdercd hg hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le))
  calc (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
              (1 / r) * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))
      ≤ ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
          ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) :=
        add_le_add (mul_le_mul' hker le_rfl)
          (mul_le_mul' le_rfl (mul_le_mul' hker' le_rfl))
    _ = ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← add_mul,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        rw [rpow_neg_natCast_two j]
        field_simp


/-! ## The kernel bracket of (5.9), on its own

The two kernel norms entering the localized maximal estimate are the same
whichever maximal function they are fed into, so the bracket is isolated here
and used both for `𝒜_{k,m}` and for the reflected pieces. -/

/-- **The kernel bracket of (5.9).** -/
theorem brs_5_9_bracket {k j : ℕ} {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {r : ℝ} (hr : 1 < r)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) (G : ENNReal) :
    (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
            (1 / r) * G) ≤
      ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r)) *
        ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) * G := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  set δ : ℝ := (2 : ℝ) ^ (-(j : ℝ)) with hδdef
  have hδ : (0 : ℝ) < δ := Real.rpow_pos_of_pos (by norm_num) _
  have hδinv : δ = ((2 : ℝ) ^ j)⁻¹ := rpow_neg_natCast_two j
  have hδ2j : δ * (2 : ℝ) ^ j = 1 := by
    rw [hδinv]
    field_simp
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hR2 : tsupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) ⊆
      Metric.closedBall 0 1 := by
    rw [tsupport_const_mul_eq (ne_of_gt h2j)]
    exact hR'
  have hCnn : 0 ≤ brsKernelConst Mu A N r := brsKernelConst_nonneg hMunn hAnn N hr.le
  have hC'nn : 0 ≤ brsKernelConst Mu' A' N r :=
    brsKernelConst_nonneg hMu'nn hA'nn N hr.le
  have hK : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ.continuous hcs hR
      hbd hA hAnn hmom hr.le hkj
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow hCnn hδ hr0]
  have hK' : (∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
      (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbd2 : ∀ x : ℝ, |(2 : ℝ) ^ j * deriv υ x| ≤ (2 : ℝ) ^ j * Mu' := by
      intro x
      rw [abs_mul, abs_of_pos h2j]
      exact mul_le_mul_of_nonneg_left (hbd' x) h2j.le
    have hA2 : (∫ y : ℝ, |(2 : ℝ) ^ j * deriv υ y|) ≤ (2 : ℝ) ^ j * A' := by
      rw [integral_abs_const_mul h2j.le]
      exact mul_le_mul_of_nonneg_left hA' h2j.le
    have hmom2 : ∀ i : ℕ, i < N + 1 →
        (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) = 0 := by
      intro i hi
      have hre : (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) =
          (2 : ℝ) ^ j * ∫ y : ℝ, y ^ i * deriv υ y := by
        rw [← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        show y ^ i * ((2 : ℝ) ^ j * deriv υ y) =
          (2 : ℝ) ^ j * (y ^ i * deriv υ y)
        ring
      rw [hre, hmom' i hi, mul_zero]
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ2.continuous hcs2
      hR2 hbd2 hA2 (by positivity) hmom2 hr.le hkj
    rw [hderivD]
    rw [brsKernelConst_smul h2j.le hMu'nn hA'nn N] at hbase
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow (by positivity) hδ hr0]
    congr 2
    rw [Real.mul_rpow (Real.rpow_nonneg h2j.le _) hC'nn, ← Real.rpow_mul h2j.le,
      mul_one_div, div_self hr0.ne', Real.rpow_one]
  have hstep : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) *
        G +
      ENNReal.ofReal δ *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
          (1 / r) * G) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G +
        ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G := by
    refine add_le_add (mul_le_mul' hK le_rfl) ?_
    calc ENNReal.ofReal δ *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
            (1 / r) * G)
        ≤ ENNReal.ofReal δ *
            (ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
              δ ^ (1 / r - 1 / 2)) * G) :=
          mul_le_mul' le_rfl (mul_le_mul' hK' le_rfl)
      _ = ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
            δ ^ (1 / r - 1 / 2)) * G := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hδ.le]
          congr 2
          calc δ * ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2))
              = (δ * (2 : ℝ) ^ j) * (brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2)) := by ring
            _ = brsKernelConst Mu' A' N r ^ (1 / r) * δ ^ (1 / r - 1 / 2) := by
                rw [hδ2j, one_mul]
  refine le_trans hstep (le_of_eq ?_)
  rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 2
  ring

/-- **(5.9) for the reflected pieces of the resolution.** -/
theorem brs_5_9_near {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ))) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  have hcsD : HasCompactSupport (brsDilate υ j) := hasCompactSupport_brsDilate hcs j
  have hυD : ContDiff ℝ 1 (brsDilate υ j) := contDiff_brsDilate hυ j
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hcsD' : HasCompactSupport (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact hasCompactSupport_brsDilate hcs2 j
  have hυD' : ContDiff ℝ 1 (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact contDiff_brsDilate hυ2 j
  refine le_trans (lintegral_brsNearMax_rpow_le hδ hcov kw kt hcsD hυD hcsD' hυD'
    hg hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl
    (ENNReal.rpow_le_rpow ?_ hq0.le))
  exact brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
    hmom' hr hkj _


/-! ## A smooth approximate identity supported in the unit ball

The resolution of the identity needs a single profile `φ` with `∫ φ = 1`
supported in `[-1, 1]`; its Littlewood--Paley pieces `Ψ_j = φ_{j+1} - φ_j` are
then dilates of the single mean-zero bump `Ψ_0`, which is what `brs_5_9_near`
takes as input. -/

/-- **A smooth unit-mass bump supported in the unit ball.** -/
theorem exists_brsUnitBump :
    ∃ φ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ ∧
      (∫ x : ℝ, φ x) = 1 ∧ ∀ x : ℝ, 1 < |x| → φ x = 0 := by
  let fb : ContDiffBump (0 : ℝ) := ⟨1 / 2, 1, by norm_num, by norm_num⟩
  refine ⟨fb.normed volume, fb.contDiff_normed, fb.hasCompactSupport_normed,
    fb.integral_normed, fun x hx => ?_⟩
  have hns : x ∉ Function.support (fb.normed volume) := by
    rw [ContDiffBump.support_normed_eq]
    simp only [Metric.mem_ball, Real.dist_eq, sub_zero, not_lt]
    exact hx.le
  exact Function.notMem_support.mp hns

/-- The Littlewood--Paley pieces of a profile are dilates of the lowest one. -/
theorem brsLPKernel_eq_dilate (φ : ℝ → ℝ) (j : ℕ) :
    brsLPKernel φ j = brsDilate (brsLPKernel φ 0) j := by
  funext x
  show (2 : ℝ) ^ (j + 1) * φ ((2 : ℝ) ^ (j + 1) * x) -
      (2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * x) =
    (2 : ℝ) ^ j * ((2 : ℝ) ^ (0 + 1) * φ ((2 : ℝ) ^ (0 + 1) * ((2 : ℝ) ^ j * x)) -
      (2 : ℝ) ^ (0 : ℕ) * φ ((2 : ℝ) ^ (0 : ℕ) * ((2 : ℝ) ^ j * x)))
  have h1 : (2 : ℝ) ^ (0 + 1 : ℕ) * ((2 : ℝ) ^ j * x) = (2 : ℝ) ^ (j + 1) * x := by
    rw [pow_succ, pow_zero, one_mul, pow_succ]
    ring
  have h2 : (2 : ℝ) ^ (0 : ℕ) * ((2 : ℝ) ^ j * x) = (2 : ℝ) ^ j * x := by
    rw [pow_zero, one_mul]
  rw [h1, h2, pow_succ, pow_zero]
  ring

/-- The Littlewood--Paley bump of a unit-mass profile vanishes off the unit
ball. -/
theorem brsLPKernel_zero_vanishing {φ : ℝ → ℝ}
    (hzero : ∀ x : ℝ, 1 < |x| → φ x = 0) {x : ℝ} (hx : 1 < |x|) :
    brsLPKernel φ 0 x = 0 := by
  have h1 : brsDilate φ 1 x = 0 := by
    show (2 : ℝ) ^ (1 : ℕ) * φ ((2 : ℝ) ^ (1 : ℕ) * x) = 0
    have habs : (1 : ℝ) < |(2 : ℝ) ^ (1 : ℕ) * x| := by
      rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ (1 : ℕ))]
      nlinarith [abs_nonneg x]
    rw [hzero _ habs, mul_zero]
  have h0 : brsDilate φ 0 x = 0 := by
    rw [brsDilate_zero]
    exact hzero x hx
  show brsDilate φ 1 x - brsDilate φ 0 x = 0
  rw [h1, h0, sub_zero]

/-- **The Littlewood--Paley bump of a unit-mass profile, packaged for
(5.9).** -/
theorem exists_brsLPBumpPackage {φ : ℝ → ℝ} (hsmooth : ContDiff ℝ (⊤ : ℕ∞) φ)
    (hcs : HasCompactSupport φ)
    (hzero : ∀ x : ℝ, 1 < |x| → φ x = 0) :
    ∃ Mu A Mu' A' : ℝ,
      ContDiff ℝ 1 (brsLPKernel φ 0) ∧ HasCompactSupport (brsLPKernel φ 0) ∧
        tsupport (brsLPKernel φ 0) ⊆ Metric.closedBall 0 1 ∧
        ContDiff ℝ 1 (deriv (brsLPKernel φ 0)) ∧
        HasCompactSupport (deriv (brsLPKernel φ 0)) ∧
        tsupport (deriv (brsLPKernel φ 0)) ⊆ Metric.closedBall 0 1 ∧
        (∀ x : ℝ, |brsLPKernel φ 0 x| ≤ Mu) ∧
        (∫ y : ℝ, |brsLPKernel φ 0 y|) ≤ A ∧ 0 ≤ A ∧
        (∀ x : ℝ, |deriv (brsLPKernel φ 0) x| ≤ Mu') ∧
        (∫ y : ℝ, |deriv (brsLPKernel φ 0) y|) ≤ A' ∧ 0 ≤ A' ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * brsLPKernel φ 0 y) = 0) ∧
        ∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * deriv (brsLPKernel φ 0) y) = 0 := by
  set υ : ℝ → ℝ := brsLPKernel φ 0 with hυdef
  have hcd1 : ContDiff ℝ 1 φ := hsmooth.of_le ENat.LEInfty.out
  have hcd2 : ContDiff ℝ 2 φ := hsmooth.of_le ENat.LEInfty.out
  have hcont : Continuous φ := hcd1.continuous
  have hυcd : ContDiff ℝ 1 υ :=
    (contDiff_brsDilate hcd1 1).sub (contDiff_brsDilate hcd1 0)
  have hυcd2 : ContDiff ℝ 2 υ :=
    (contDiff_brsDilate hcd2 1).sub (contDiff_brsDilate hcd2 0)
  have hυcs : HasCompactSupport υ := hasCompactSupport_brsLPKernel hcs 0
  have hυcont : Continuous υ := hυcd.continuous
  have hυvan : ∀ x : ℝ, 1 < |x| → υ x = 0 := fun x hx =>
    brsLPKernel_zero_vanishing hzero hx
  have hυR : tsupport υ ⊆ Metric.closedBall 0 1 :=
    tsupport_subset_closedBall_of_vanishing hυvan
  have hderivcd : ContDiff ℝ 1 (deriv υ) := by
    have h : ContDiff ℝ (1 + 1) υ := by
      rw [show ((1 : WithTop ℕ∞) + 1) = 2 by norm_num]
      exact hυcd2
    exact (contDiff_succ_iff_deriv.mp h).2.2
  have hderivcs : HasCompactSupport (deriv υ) := hυcs.deriv
  have hderivvan : ∀ x : ℝ, 1 < |x| → deriv υ x = 0 := fun x hx =>
    deriv_eq_zero_of_vanishing hυvan hx
  have hderivR : tsupport (deriv υ) ⊆ Metric.closedBall 0 1 :=
    tsupport_subset_closedBall_of_vanishing hderivvan
  obtain ⟨Mu, hMu⟩ := hυcont.bounded_above_of_compact_support hυcs
  obtain ⟨Mu', hMu'⟩ := hderivcd.continuous.bounded_above_of_compact_support
    hderivcs
  refine ⟨Mu, ∫ y : ℝ, |υ y|, Mu', ∫ y : ℝ, |deriv υ y|, hυcd, hυcs, hυR,
    hderivcd, hderivcs, hderivR, fun x => by
      simpa only [Real.norm_eq_abs] using hMu x, le_rfl,
    integral_nonneg fun y => abs_nonneg _, fun x => by
      simpa only [Real.norm_eq_abs] using hMu' x, le_rfl,
    integral_nonneg fun y => abs_nonneg _, ?_, ?_⟩
  · intro i hi
    have hi0 : i = 0 := by omega
    subst hi0
    simp only [pow_zero, one_mul]
    exact integral_brsLPKernel_eq_zero hcont hcs 0
  · intro i hi
    have hi0 : i = 0 := by omega
    subst hi0
    simp only [pow_zero, one_mul]
    exact integral_deriv_eq_zero_of_hasCompactSupport hυcd hυcs


/-! ## The near part on its window

On `I_k = (2^{-k-1}, 2^{-k}]` the cutoff has to be at most the radius, so the
truncation is taken at `2^{-k-1}`, one dyadic scale finer than the window. -/

theorem brsCut_le_of_mem_window {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) :
    (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr

/-- **The near part on `I_k`, decomposed into the pieces of the
resolution.** -/
theorem brsANearWindow_le_tsum (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_window hr
    have hmain := brsANearLeftAt_le_pieces (k + 1) s (E := E) hg hgbd hφ hφcs
      hφnorm hcr
    refine le_trans hmain ?_
    have hpieces : brsNearPieceMax (k + 1) (brsDilate φ (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r ≤
        brsNearFullMax (k + 1) (brsDilate φ (k + 1 + s)) g E r +
          ∑' m : ℕ,
            brsNearFullMax (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r :=
      add_le_add (brsNearPieceMax_le_full _ _ _ _ _)
        (ENNReal.tsum_le_tsum fun m => brsNearPieceMax_le_full _ _ _ _ _)
    refine le_trans (mul_le_mul' le_rfl hpieces) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le


/-! ## Measurability of the reflected maximal functions -/

theorem measurable_brsNearFullMax (kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) :
    Measurable (brsNearFullMax kt Ψ g E) := by
  have hgr : Continuous (brsRefl g) := continuous_brsRefl hg
  have hFcont : Continuous fun x : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl g (x - y) := by
    have hderiv := fun x : ℝ => hasDerivAt_kernel_convolution
      (hasCompactSupport_brsTruncConvReal kt hcs)
      (contDiff_brsTruncConvReal kt (n := 1) hΨ hcs) hgr x
    have hdiff : Differentiable ℝ fun x : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl g (x - y) :=
      fun x => (hderiv x).differentiableAt
    exact hdiff.continuous
  exact measurable_iSup_enorm_translate (continuous_brsRefl hFcont) E

theorem measurable_brsNearMax (kw kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) :
    Measurable (brsNearMax kw kt Ψ g E) := by
  refine Measurable.indicator ?_ (measurableSet_brsWindowExt kw)
  refine Measurable.mul ?_ (measurable_brsNearFullMax kt hΨ hcs hg E)
  fun_prop

theorem brsNearMax_eq_zero_of_notMem {kw kt : ℕ} {Ψ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} {r : ℝ} (hr : r ∉ brsWindowExt kw) :
    brsNearMax kw kt Ψ g E r = 0 := by
  rw [brsNearMax, Set.indicator_of_notMem hr]


/-! ## The family of pieces indexed by `(m, k)`

`m = 0` is the lowest-frequency piece of the resolution, `m + 1` is the
Littlewood--Paley piece at scale `2^{-(k+1+s+m)}`.  Every member vanishes off
its window `I_k`, so the generic aggregation applies. -/

/-- Splitting off the first term of a sum in `ℝ≥0∞`. -/
theorem ennreal_tsum_eq_zero_add (f : ℕ → ENNReal) :
    ∑' n : ℕ, f n = f 0 + ∑' n : ℕ, f (n + 1) :=
  tsum_eq_zero_add' ENNReal.summable

/-- The `(m, k)`-family of pieces of the near part. -/
def brsNearFamily (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (m k : ℕ)
    (r : ℝ) : ENNReal :=
  match m with
  | 0 => brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r
  | (m + 1) => brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r

theorem brsNearFamily_zero (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (k : ℕ)
    (r : ℝ) : brsNearFamily s φ g E 0 k r =
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r := rfl

theorem brsNearFamily_succ (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (m k : ℕ) (r : ℝ) : brsNearFamily s φ g E (m + 1) k r =
      brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r := rfl

theorem brsNearFamily_eq_zero_of_notMem {s : ℕ} {φ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} (m k : ℕ) {r : ℝ} (hr : r ∉ brsWindowExt k) :
    brsNearFamily s φ g E m k r = 0 := by
  cases m with
  | zero => exact brsNearMax_eq_zero_of_notMem hr
  | succ m => exact brsNearMax_eq_zero_of_notMem hr

theorem measurable_brsNearFamily (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ)
    (m k : ℕ) : Measurable (brsNearFamily s φ g E m k) := by
  cases m with
  | zero =>
      exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hcs _) hg E
  | succ m =>
      refine measurable_brsNearMax k (k + 1) ?_
        (hasCompactSupport_brsLPKernel hcs _) hg E
      exact (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)

/-- **The near part on `I_k`, bounded by the family.** -/
theorem brsANearWindow_le_tsum_family (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      ∑' m : ℕ, brsNearFamily s φ g E m k r := by
  refine le_trans (brsANearWindow_le_tsum k s hg hgbd hφ hφcs hφnorm r)
    (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add (fun m : ℕ => brsNearFamily s φ g E m k r),
    brsNearFamily_zero]
  congr 1


/-! ## The near part, aggregated over all the windows -/

/-- **The near part of `R₂^-`, reduced to the individual pieces.** -/
theorem brsNear_aggregate (s : ℕ) {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ}
    (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearFamily s φ g E m k r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hpt : ∀ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily s φ g E m k r := by
    intro r
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearWindow_le_tsum_family k s hg hgbd hφ.continuous hφcs hφnorm r) ?_
    exact le_of_eq ENNReal.tsum_comm
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow (hpt r) hq0.le) le_rfl)
    (by positivity)) ?_
  exact window_double_sum_le
    (fun m k r hr => brsNearFamily_eq_zero_of_notMem m k hr)
    (fun m k => measurable_brsNearFamily s hφ hφcs hg E m k) hq


/-! ## (5.9) for the reflected pieces, with covering numbers -/

/-- **(5.9) for the reflected pieces, with the covering number.** -/
theorem brs_5_9_near_covering {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ))) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-(j : ℝ)))
  have h := brs_5_9_near (kw := kw) (kt := kt) hcov hυ hcs hR hυ' hcs' hR' hbd
    hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel hkj
  rwa [hcard] at h

/-- **(5.9) for the lowest-frequency piece, with the covering number.** -/
theorem brs_5_9_near_low_covering {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-(j : ℝ)))
  have h := brs_5_9_near_low (kw := kw) (kt := kt) hcov hφ hcs hφ' hcs' hA hA'
    hg hp hr hrq hpq hrel hr2
  rwa [hcard] at h


/-! ## One term of the sum, with the offset left free

The near part uses the offset `a = m + 4` rather than `m + 3`, so the term
estimate is restated with the offset as a parameter. -/

/-- **Collecting the dyadic factors of one term, with a free offset.** -/
theorem brs_term_exponent_identity_gen (K₁ Cβ Cs β s q : ℝ) (k a : ℕ) :
    K₁ * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) *
        (Cβ * (2 : ℝ) ^ (β * ((k + a : ℕ) : ℝ))) *
        (Cs * ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ (s * q)) =
      (K₁ * Cβ * Cs) *
        (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) + brsSumExpM β s q * (a : ℝ)) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hjcast : ((k + a : ℕ) : ℝ) = (k : ℝ) + (a : ℝ) := by push_cast; ring
  have e1 : ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) =
      (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) := by
    rw [← Real.rpow_mul h2.le]
  have e2 : ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ (s * q) =
      (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)) := by
    rw [← Real.rpow_mul h2.le, hjcast]
  have e3 : (2 : ℝ) ^ (β * ((k + a : ℕ) : ℝ)) =
      (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) := by rw [hjcast]
  rw [e1, e2, e3]
  have hcomb : (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
      (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) *
      (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)) =
      (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (a : ℝ)) := by
    rw [← Real.rpow_add h2, ← Real.rpow_add h2]
    congr 1
    rw [brsSumExpK, brsSumExpM]
    ring
  calc K₁ * (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
        (Cβ * (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ)))) *
        (Cs * (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)))
      = K₁ * Cβ * Cs *
          ((2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
            (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) *
            (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q))) := by ring
    _ = K₁ * Cβ * Cs *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ)) := by rw [hcomb]

/-- **A single term, with a free offset, is a dyadic geometric term.** -/
theorem brs_term_le_gen {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {Cs : ℝ} (hCs : 0 ≤ Cs) {q s : ℝ} (hq : 0 < q) (k a : ℕ) (G : ENNReal) :
    ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal (Cs *
              ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ s) * G) ^ q) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ))) * G ^ q := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  set j : ℕ := k + a with hj
  have hdyad : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos h2 _
  have hpow : (ENNReal.ofReal (Cs * ((2 : ℝ) ^ (-(j : ℝ))) ^ s) * G) ^ q =
      ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le]
    congr 2
    rw [Real.mul_rpow hCs (Real.rpow_nonneg hdyad.le _),
      ← Real.rpow_mul hdyad.le]
  rw [hpow]
  have hstep : ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
          (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) *
            G ^ q)) :=
    mul_le_mul' le_rfl (mul_le_mul' (hN j) le_rfl)
  refine le_trans hstep (le_of_eq ?_)
  rw [show ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) =
      (ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q))) * G ^ q by
    ring]
  congr 1
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [hj]
  exact brs_term_exponent_identity_gen ((2 : ℝ) ^ |1 - q / 2|) Cβ (Cs ^ q) β s q
    k a


/-! ## Putting the low-frequency constant in the dyadic form -/

/-- The `L^r` norm of `h_k` in the dyadic form used by the summation. -/
theorem brsLowConst_rpow_inv (kt : ℕ) {r : ℝ} (hr0 : 0 < r) (hr2 : r < 2) :
    brsLowConst kt r ^ (1 / r) =
      (1 - r / 2) ^ (-(1 / r)) * ((2 : ℝ) ^ (-(kt : ℝ))) ^ (1 / r - 1 / 2) := by
  have hden : (0 : ℝ) < 1 - r / 2 := by linarith
  have hbase : (0 : ℝ) < (2 : ℝ) ^ (-(kt : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [brsLowConst, Real.div_rpow (Real.rpow_nonneg hbase.le _) hden.le,
    ← Real.rpow_mul hbase.le]
  rw [Real.rpow_neg hden.le, div_eq_mul_inv, mul_comm]
  congr 2
  field_simp

/-- Shifting the dyadic scale by three costs a constant. -/
theorem dyadic_shift_three_rpow (k : ℕ) (s : ℝ) :
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s =
      (2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  rw [← Real.rpow_mul h2.le, ← Real.rpow_mul h2.le, ← Real.rpow_add h2]
  congr 1
  push_cast
  ring

/-- **A single term, with the constant given only by an upper bound.** -/
theorem brs_term_le_gen' {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {Cs D : ℝ} (hCs : 0 ≤ Cs) {q s : ℝ} (hq : 0 < q) (k a : ℕ) (G : ENNReal)
    (hD : D ≤ Cs * ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ s) :
    ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal D * G) ^ q) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ))) * G ^ q := by
  refine le_trans (mul_le_mul' le_rfl (mul_le_mul' le_rfl
    (ENNReal.rpow_le_rpow (mul_le_mul' (ENNReal.ofReal_le_ofReal hD) le_rfl)
      hq.le))) ?_
  exact brs_term_le_gen hCβ hN hCs hq k a G

/-- Decreasing dyadic factors: a larger offset gives a smaller term. -/
theorem rpow_mono_of_neg_exp {b : ℝ} (hb : b < 0) {m n : ℝ} (hmn : m ≤ n) :
    (2 : ℝ) ^ (b * n) ≤ (2 : ℝ) ^ (b * m) := by
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  nlinarith


/-! ## The lowest-frequency term of the near part, in geometric form -/

/-- Replacing the offset by a smaller one only increases the term. -/
theorem ofReal_geometric_offset_le {C b eK : ℝ} (hC : 0 ≤ C) (hb : b < 0)
    {m n : ℝ} (hmn : m ≤ n) :
    ENNReal.ofReal (C * (2 : ℝ) ^ (eK + b * n)) ≤
      ENNReal.ofReal (C * (2 : ℝ) ^ (eK + b * m)) := by
  refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hC)
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  nlinarith

/-- **The `m = 0` term of the near part.** -/
theorem brsNearFamily_zero_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (A + A') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E 0 k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * ((0 : ℕ) : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  have hk4 : k + 1 + 3 = k + 4 := by omega
  have hterm : (fun x : ℝ => brsNearFamily 3 φ g E 0 k x) =
      fun x : ℝ => brsNearMax k (k + 1) (brsDilate φ (k + 4)) g E x := by
    funext x
    rw [brsNearFamily_zero, hk4]
  simp only [hterm]
  refine le_trans (brs_5_9_near_low_covering (kw := k) (kt := k + 1)
    (j := k + 4) hE hφ hcs hφ' hcs' hA hA' hg hp hr hrq hpq hrel hr2) ?_
  -- put the constant in dyadic form
  have hD : (A + A') * brsLowConst (k + 1) r ^ (1 / r) ≤
      Cs * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by
    have h1 : brsLowConst (k + 1) r ^ (1 / r) =
        (1 - r / 2) ^ (-(1 / r)) * ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s :=
      brsLowConst_rpow_inv (k + 1) hr0 hr2
    have h2 : ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s =
        (2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
      dyadic_shift_three_rpow k s
    have hbase : (0 : ℝ) ≤ ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
      Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
    rw [h1, h2]
    calc (A + A') * ((1 - r / 2) ^ (-(1 / r)) *
          ((2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s))
        = ((A + A') * ((1 - r / 2) ^ (-(1 / r)) * (2 : ℝ) ^ (3 * s))) *
            ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by ring
      _ ≤ Cs * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
          mul_le_mul_of_nonneg_right hCslow hbase
  refine le_trans (brs_term_le_gen' hCβ hN hCs hq0 k 4 G hD) ?_
  refine mul_le_mul' ?_ le_rfl
  have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine ofReal_geometric_offset_le hnn hM ?_
  push_cast
  norm_num


/-! ## The high-frequency terms of the near part, in geometric form -/

/-- **The `m + 1` terms of the near part.** -/
theorem brsNearFamily_succ_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (m k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E (m + 1) k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * ((m + 1 : ℕ) : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  have hidx : k + 1 + 3 + m = k + (m + 4) := by omega
  have hterm : (fun x : ℝ => brsNearFamily 3 φ g E (m + 1) k x) =
      fun x : ℝ => brsNearMax k (k + 1) (brsDilate υ (k + (m + 4))) g E x := by
    funext x
    rw [brsNearFamily_succ, hidx, hυeq]
  simp only [hterm]
  have hkj : 5 * (2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap (k + 1) m
    have heq : (k + 1) + (m + 3) = k + (m + 4) := by omega
    rwa [heq] at h
  refine le_trans (brs_5_9_near_covering (kw := k) (kt := k + 1)
    (j := k + (m + 4)) hE hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn
    hmom hmom' hg hp hr hrq hpq hrel hkj) ?_
  have hbase : (0 : ℝ) ≤ ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s :=
    Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
  have hD : (brsKernelConst Mu A N r ^ (1 / r) +
        brsKernelConst Mu' A' N r ^ (1 / r)) *
      ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s ≤
      Cs * ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s :=
    mul_le_mul_of_nonneg_right hCsLP hbase
  refine le_trans (brs_term_le_gen' hCβ hN hCs hq0 k (m + 4) G hD) ?_
  refine mul_le_mul' ?_ le_rfl
  have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine ofReal_geometric_offset_le hnn hM ?_
  push_cast
  linarith


/-! ## Every term of the near part is a dyadic geometric term -/

/-- **Every term of the near part.** -/
theorem brsNearFamily_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (n k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E n k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * (n : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  cases n with
  | zero =>
      exact brsNearFamily_zero_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hg
        hp hr hrq hpq hrel hr2 hCs hCslow hM k
  | succ m =>
      exact brsNearFamily_succ_term_le hE hCβ hN hυeq hυ hcs hR hυ' hcs' hR'
        hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel hCs hCsLP
        hM m k

/-- **The near part of `R₂^-` on the interior of the type region.** -/
theorem brs_near_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    (∫⁻ x : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ^ q *
        ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal ((((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
            (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
          (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q))) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  set c : ℝ := (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine le_trans (brsNear_aggregate 3 hg hgbd hφ hφcs hφnorm hq1) ?_
  refine le_trans (ENNReal.tsum_le_tsum fun n =>
    ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k =>
      brsNearFamily_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hυeq hυ hcs hR
        hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq
        hrel hr2 hCs hCslow hCsLP hM n k) (by positivity)) ?_
  have hsum : ∀ n : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ))) * G ^ q) ^ (1 / q) =
      (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ)))) ^ (1 / q) * G := by
    intro n
    rw [ENNReal.tsum_mul_right, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]
  rw [tsum_congr hsum, ENNReal.tsum_mul_right,
    tsum_tsum_ofReal_geometric_rpow hcnn hK hM hq0]


/-! ## The extended windows cover the whole range of radii -/

/-- Every radius in `(0, 4/3]` lies in one of the extended windows. -/
theorem exists_mem_brsWindowExt {r : ℝ} (hr0 : 0 < r) (hr : r ≤ 4 / 3) :
    ∃ k : ℕ, r ∈ brsWindowExt k := by
  rcases lt_or_ge (2 : ℝ)⁻¹ r with hhalf | hhalf
  · exact ⟨0, ⟨hhalf, hr⟩⟩
  -- `r ≤ 1/2`: find the dyadic index
  have hP0 : r ≤ (2 : ℝ) ^ (-((0 : ℕ) : ℝ)) := by
    norm_num
    linarith
  have hP1 : r ≤ (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have hcast : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by norm_num
    rw [hcast]
    exact hhalf
  have hex : ∃ n : ℕ, ¬ (r ≤ (2 : ℝ) ^ (-(n : ℝ))) := by
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / r)
    refine ⟨N, ?_⟩
    have h2N : (0 : ℝ) < (2 : ℝ) ^ N := by positivity
    have hNle : (N : ℝ) ≤ (2 : ℝ) ^ N := by
      have := Nat.lt_two_pow_self (n := N)
      have hcast : ((N : ℕ) : ℝ) ≤ ((2 ^ N : ℕ) : ℝ) := by
        exact_mod_cast this.le
      simpa using hcast
    have hlt : 1 / r < (2 : ℝ) ^ N := lt_of_lt_of_le hN hNle
    have hinv : ((2 : ℝ) ^ N)⁻¹ < r := by
      rw [inv_lt_comm₀ h2N hr0]
      rwa [one_div] at hlt
    rw [rpow_neg_natCast_two N]
    exact not_le.mpr hinv
  classical
  have hne0 : Nat.find hex ≠ 0 := by
    intro hc
    refine Nat.find_spec hex ?_
    rw [hc]
    exact hP0
  have hne1 : Nat.find hex ≠ 1 := by
    intro hc
    refine Nat.find_spec hex ?_
    rw [hc]
    exact hP1
  obtain ⟨k, hk1, hPk, hnotk⟩ : ∃ k : ℕ, 1 ≤ k ∧ r ≤ (2 : ℝ) ^ (-(k : ℝ)) ∧
      ¬ (r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) := by
    refine ⟨Nat.find hex - 1, by omega, ?_, ?_⟩
    · exact not_not.mp (Nat.find_min hex (m := Nat.find hex - 1) (by omega))
    · have hsucc : Nat.find hex - 1 + 1 = Nat.find hex := by omega
      rw [hsucc]
      exact Nat.find_spec hex
  refine ⟨k, ?_⟩
  obtain ⟨k', rfl⟩ : ∃ k' : ℕ, k = k' + 1 := ⟨k - 1, by omega⟩
  rw [brsWindowExt_succ]
  refine ⟨?_, hPk⟩
  have hcast : (2 : ℝ) ^ (-((k' + 1 : ℕ) : ℝ) - 1) =
      (2 : ℝ) ^ (-((k' + 1 + 1 : ℕ) : ℝ)) := by
    congr 1
    push_cast
    ring
  rw [hcast]
  exact lt_of_not_ge hnotk

/-- `R_2^-` vanishes beyond `4/3`. -/
theorem brsRemTwoTwoLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsRemTwoTwoLeft E g r = 0 := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **(5.5), summed over the windows.** -/
theorem brsRemTwoTwoLeft_le_window_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr0 : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) +
        ∑' k : ℕ, (brsWindowExt k).indicator
          (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r := by
  rcases lt_or_ge (4 / 3 : ℝ) r with hbig | hsmall
  · rw [brsRemTwoTwoLeft_eq_zero hE hbig]
    exact zero_le
  obtain ⟨k, hk⟩ := exists_mem_brsWindowExt hr0 hsmall
  refine le_trans (brsRemTwoTwoLeft_le_add_at
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) hg hr0.le) ?_
  refine add_le_add ?_ ?_
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]


/-- **The pointwise bound for the far part, at an arbitrary cutoff.** -/
theorem brsBFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarLeftAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  set W : Set ℝ := Ioc a t ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : a < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by
      have : t / 3 ≤ a := by
        rw [ha]
        linarith
      linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + c)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor



/-! ## The far part, summed over the extended windows -/

theorem brsBFarLeftAt_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {c : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsBFarLeftAt c E g r = 0 := by
  rw [brsBFarLeftAt]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- A sum of window-supported terms is bounded by any common bound. -/
theorem tsum_window_indicator_le {A : ℕ → ℝ → ENNReal} {B : ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∈ brsWindowExt k → A k r ≤ B r) (r : ℝ) :
    (∑' k : ℕ, (brsWindowExt k).indicator (A k) r) ≤ B r := by
  by_cases h : ∃ k : ℕ, r ∈ brsWindowExt k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ →
        (brsWindowExt k).indicator (A k) r = 0 := by
      intro k hk
      refine Set.indicator_of_notMem (fun hr => ?_) _
      exact Set.disjoint_left.mp (brsWindowExt_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero, Set.indicator_of_mem hk₀]
    exact hA k₀ r hk₀
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, (brsWindowExt k).indicator (A k) r = 0 := fun k =>
      Set.indicator_of_notMem (h k) _
    simp only [hall, tsum_zero]
    exact zero_le

/-- On every extended window the cut scale is at most the truncation. -/
theorem brsCutScale_le_of_mem_windowExt {k : ℕ} {r : ℝ}
    (hr : r ∈ brsWindowExt k) :
    brsCutScale r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
  cases k with
  | zero =>
      have h2 : r ≤ 4 / 3 := hr.2
      have hcast : (2 : ℝ) ^ (-((0 + 1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by norm_num
      rw [hcast, brsCutScale]
      linarith
  | succ k =>
      have h2 : r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := hr.2
      have hpos : (0 : ℝ) < (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) :=
        Real.rpow_pos_of_pos (by norm_num) _
      have hhalf : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
          (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) / 2 := by
        have hsplit : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
            (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) * (2 : ℝ) ^ (-(1 : ℝ)) := by
          rw [← Real.rpow_add (by norm_num)]
          congr 1
          push_cast
          ring
        rw [hsplit,
          show (-(1 : ℝ)) = ((-1 : ℤ) : ℝ) by norm_num, Real.rpow_intCast]
        norm_num
        ring
      rw [hhalf, brsCutScale]
      linarith

/-- The far part, summed over the extended windows. -/
def brsFarWindowSum (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∑' k : ℕ, (brsWindowExt k).indicator
    (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r

theorem brsFarWindowSum_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsFarWindowSum E g r = 0 := by
  rw [brsFarWindowSum]
  have hall : ∀ k : ℕ, (brsWindowExt k).indicator
      (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r = 0 := by
    intro k
    by_cases hk : r ∈ brsWindowExt k
    · rw [Set.indicator_of_mem hk, brsBFarLeftAt_eq_zero hE hr]
    · rw [Set.indicator_of_notMem hk]
  simp only [hall, tsum_zero]

/-- **The pointwise bound for the far part, summed over the windows.** -/
theorem brsFarWindowSum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSum E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSum]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarLeftAt_le hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')


/-! ## The far part against the unweighted `L^p` norm

The near part is estimated by Young's inequality, which produces the plain
`L^p` norm of the profile; the far part is restated against the same norm so
that the two halves of (5.5) can be added. -/

/-- **The pointwise bound for the far part, at an arbitrary cutoff.** -/
theorem brsBFarLeftAt_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarLeftAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  set W : Set ℝ := Ioc a t ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    refine le_trans (setLIntegral_le_lintegral _ _) ?_
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by norm_num)
    calc M = 1 * M := (one_mul M).symm
      _ ≤ ENNReal.ofReal 3 * M := mul_le_mul' h3 le_rfl
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + c)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor




/-- **The pointwise bound for the far part, summed over the windows.** -/
theorem brsFarWindowSum_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSum E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSum]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarLeftAt_le' hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')

/-- **(5.6) for the far part summed over the windows, unweighted.** -/
theorem prop56_brsBFarWindow' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSum E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsFarWindowSum_le' hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsFarWindowSum E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsFarWindowSum E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsFarWindowSum_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp



/-! ## The near estimate for the measurable majorant

The maximal functions themselves are indexed by a set depending on the radius,
so they are not obviously measurable; the family of pieces that dominates them
is, and that is what the additivity of the integral is applied to. -/

/-- **The family form of the near estimate.** -/
theorem brs_near_interior_family {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (_hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (_hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    (∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
          brsNearFamily 3 φ g E m k x) ^ q * ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal ((((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
            (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
          (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q))) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  set c : ℝ := (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine le_trans (window_double_sum_le
    (fun m k r hr => brsNearFamily_eq_zero_of_notMem m k hr)
    (fun m k => measurable_brsNearFamily 3 hφ hφcs hg E m k) hq1) ?_
  refine le_trans (ENNReal.tsum_le_tsum fun n =>
    ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k =>
      brsNearFamily_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hυeq hυ hcs hR
        hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq
        hrel hr2 hCs hCslow hCsLP hM n k) (by positivity)) ?_
  have hsum : ∀ n : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ))) * G ^ q) ^ (1 / q) =
      (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ)))) ^ (1 / q) * G := by
    intro n
    rw [ENNReal.tsum_mul_right, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]
  rw [tsum_congr hsum, ENNReal.tsum_mul_right,
    tsum_tsum_ofReal_geometric_rpow hcnn hK hM hq0]



/-! ## Proposition 5.4(i) for `R₂^-`

Adding the two halves of (5.5).  The elementary convexity inequality
`(a + b)^q ≤ 2^{q-1}(a^q + b^q)` is used in place of Minkowski's inequality so
that no measurability of the maximal functions themselves is needed: only the
measurable majorants are integrated. -/

/-- The pointwise splitting of `R₂^-` into two measurable majorants. -/
theorem brsRemTwoTwoLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x * brsFarWindowSum E g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hsplit := brsRemTwoTwoLeft_le_window_sum hE hg hx
  have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
      (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x := by
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearWindow_le_tsum_family k 3 hg hgbd hφ hφcs hφnorm x) ?_
    exact le_of_eq ENNReal.tsum_comm
  have hle : brsRemTwoTwoLeft E g x ≤
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) +
        brsFarWindowSum E g x :=
    le_trans hsplit (add_le_add hnear le_rfl)
  have hpow : brsRemTwoTwoLeft E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q +
          brsFarWindowSum E g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q +
            brsFarWindowSum E g x ^ q)) := mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x * brsFarWindowSum E g x ^ q) := by ring


/-! ## Adding the two halves of (5.5) -/

/-- **Adding two majorants.** -/
theorem lintegral_rpow_le_of_two_bounds {R Nm Fw : ℝ → ENNReal} {q : ℝ}
    (hq : 1 ≤ q)
    (hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x * Nm x ^ q)
    (hpt : ∀ x : ℝ, ENNReal.ofReal x * R x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Nm x ^ q) +
        (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Fw x ^ q))
    {CN CF : ℝ} (hCN : 0 ≤ CN) (hCF : 0 ≤ CF) {G : ENNReal}
    (hNb : (∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * G)
    (hFb : (∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CF * G) :
    (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((2 : ℝ) ^ ((q - 1) / q) * (CN + CF)) * G := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hq1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  set X : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q with hX
  set Y : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q with hY
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hint : (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_add_left' (hNmeas.const_mul ((2 : ENNReal) ^ (q - 1))).aemeasurable]
    rw [lintegral_const_mul' _ _ htop, lintegral_const_mul' _ _ htop]
  refine le_trans (ENNReal.rpow_le_rpow hint (by positivity)) ?_
  have hsub : ((2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y) ^
      (1 / q) ≤ ((2 : ENNReal) ^ (q - 1) * X) ^ (1 / q) +
        ((2 : ENNReal) ^ (q - 1) * Y) ^ (1 / q) :=
    ENNReal.rpow_add_le_add_rpow _ _ (by positivity) hq1
  refine le_trans hsub ?_
  have hfac : ∀ Z : ENNReal, ((2 : ENNReal) ^ (q - 1) * Z) ^ (1 / q) =
      (2 : ENNReal) ^ ((q - 1) / q) * Z ^ (1 / q) := by
    intro Z
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul]
    congr 2
    field_simp
  rw [hfac, hfac]
  have hmain : (2 : ENNReal) ^ ((q - 1) / q) * X ^ (1 / q) +
      (2 : ENNReal) ^ ((q - 1) / q) * Y ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) *
        (ENNReal.ofReal CN * G + ENNReal.ofReal CF * G) := by
    rw [mul_add]
    exact add_le_add (mul_le_mul' le_rfl hNb) (mul_le_mul' le_rfl hFb)
  refine le_trans hmain (le_of_eq ?_)
  have hpow : (2 : ENNReal) ^ ((q - 1) / q) =
      ENNReal.ofReal ((2 : ℝ) ^ ((q - 1) / q)) := by
    rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  rw [hpow, ← add_mul, ← ENNReal.ofReal_add hCN hCF, ← mul_assoc,
    ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]


/-! ## Proposition 5.4(i) for `R₂^-` -/

/-- **Proposition 5.4(i) of BRS, for `R₂^-`.**  On the interior of the type
region — where both dyadic exponents are negative — `R₂^-` maps the profile
`L^p` norm to the radial `L^q(r dr)` norm. -/
theorem prop54_brsRemTwoTwoLeft_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨CF, hCFpos, hFbound⟩ := prop56_brsBFarWindow' hE hp1 hq0 hq2p
  have hFb := hFbound g hg.measurable
  -- the near constant
  set CN : ℝ := (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
      (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
    (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q)) with hCNdef
  have hKden : (0 : ℝ) < 1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q := by
    have h : (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < 1 :=
      calc (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hK
        _ = 1 := Real.rpow_zero 2
    linarith
  have hMden : (0 : ℝ) <
      1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) := by
    have hneg : brsSumExpM β (1 / r - 1 / 2) q / q < 0 :=
      div_neg_of_neg_of_pos hM hq0
    have h : (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < 1 :=
      calc (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hneg
        _ = 1 := Real.rpow_zero 2
    linarith
  have hCNnn : 0 ≤ CN := by
    rw [hCNdef]
    have hnum : (0 : ℝ) ≤ (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
        (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) := by
      refine Real.rpow_nonneg ?_ _
      have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
        Real.rpow_pos_of_pos (by norm_num) _
      have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
      positivity
    positivity
  have hNb0 := brs_near_interior_family hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp hr hrq hpq hrel hr2 hCs hCslow hCsLP hK hM
  have hswap : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) =
      ∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
        brsNearFamily 3 φ g E m k x) ^ q * ENNReal.ofReal x :=
    lintegral_congr fun x => mul_comm _ _
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    rw [hswap]
    exact hNb0
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q := by
    refine ENNReal.measurable_ofReal.mul (Measurable.pow_const ?_ q)
    exact Measurable.ennreal_tsum fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsNearFamily 3 hφ hφcs hg E m k
  refine ⟨(2 : ℝ) ^ ((q - 1) / q) * (CN + CF), by positivity, ?_⟩
  exact lintegral_rpow_le_of_two_bounds hq1 hNmeas
    (fun x => brsRemTwoTwoLeft_rpow_le hE hφ.continuous hφcs hφnorm hg hgbd hq1 x)
    hCNnn hCFpos.le hNb hFb


/-! ## `R_2^+` at an arbitrary cutoff

The right half of (5.5), with the cutoff left free, exactly as on the left. -/

/-- `𝒜` for `R_2^+`, with an arbitrary cutoff. -/
def brsANearRightAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Ioi (t + r - c)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ` for `R_2^+`, with an arbitrary cutoff. -/
def brsBFarRightAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Iic (t + r - c)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5), right half, with an arbitrary cutoff.** -/
theorem brsRemTwoTwoRight_le_add_at (c : ℝ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoRight E g r ≤
      brsANearRightAt c E g r + brsBFarRightAt c E g r := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  set F : ℝ → ℂ := fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume t b :=
    intervalIntegrable_absWeightRight_complex hg hab
  have hnear : IntervalIntegrable
      ((Ioi (b - c)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Ioi, hfull.2.indicator measurableSet_Ioi⟩
  have hfar : IntervalIntegrable
      ((Iic (b - c)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Iic, hfull.2.indicator measurableSet_Iic⟩
  have hsplit : ∀ s : ℝ, F s = (Ioi (b - c)).indicator F s +
      (Iic (b - c)).indicator F s := by
    intro s
    by_cases hs : b - c < s
    · rw [Set.indicator_of_mem (show s ∈ Ioi (b - c) from hs),
        Set.indicator_of_notMem
          (show s ∉ Iic (b - c) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (b - c) from hs),
        Set.indicator_of_mem
          (show s ∈ Iic (b - c) from not_lt.mp hs)]
      ring
  have hint : (∫ s in t..b, F s) =
      (∫ s in t..b, (Ioi (b - c)).indicator F s) +
        ∫ s in t..b, (Iic (b - c)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in t..b, F s‖ ≤
      ‖∫ s in t..b, (Ioi (b - c)).indicator F s‖ +
        ‖∫ s in t..b, (Iic (b - c)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in t..b, (Ioi (b - c)).indicator F s‖ +
            ‖∫ s in t..b, (Iic (b - c)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in t..b, (Ioi (b - c)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in t..b, (Iic (b - c)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearRightAt c E g r + brsBFarRightAt c E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearRightAt]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarRightAt]
          exact le_iSup₂_of_le t ht le_rfl


/-- The far part of `R_2^+` vanishes for large radii, at any cutoff. -/
theorem brsBFarRightAt_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {c : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsBFarRightAt c E g r = 0 := by
  rw [brsBFarRightAt]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **The pointwise bound for the far part of `R_2^+`, arbitrary cutoff.** -/
theorem brsBFarRightAt_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarRightAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rw [brsBFarRightAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc t b ∩ Iic (b - c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in t..b,
      (Iic (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc t b, ‖(Iic (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc t b
      · by_cases h2 : s ≤ b - c
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Iic (b - c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - c := hs.2
    have habs : |b - s| = b - s := abs_of_nonneg (by linarith)
    have hle : |b - s| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc, hb]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    refine le_trans (setLIntegral_le_lintegral _ _) ?_
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by norm_num)
    calc M = 1 * M := (one_mul M).symm
      _ ≤ ENNReal.ofReal 3 * M := mul_le_mul' h3 le_rfl
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b,
        (Iic (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..b, (Iic (b - c)).indicator
            (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor


/-! ## The far part of `R_2^+`, summed over the extended windows -/

/-- The far part of `R_2^+`, summed over the extended windows. -/
def brsFarWindowSumRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∑' k : ℕ, (brsWindowExt k).indicator
    (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r

theorem brsFarWindowSumRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) :
    brsFarWindowSumRight E g r = 0 := by
  rw [brsFarWindowSumRight]
  have hall : ∀ k : ℕ, (brsWindowExt k).indicator
      (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r = 0 := by
    intro k
    by_cases hk : r ∈ brsWindowExt k
    · rw [Set.indicator_of_mem hk, brsBFarRightAt_eq_zero hE hr]
    · rw [Set.indicator_of_notMem hk]
  simp only [hall, tsum_zero]

/-- **The pointwise bound for the far part of `R_2^+`, over the windows.** -/
theorem brsFarWindowSumRight_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSumRight E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSumRight]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarRightAt_le' hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')

/-- **(5.6) for the far part of `R_2^+` summed over the windows.** -/
theorem prop56_brsBFarWindowRight' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsFarWindowSumRight_le' hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsFarWindowSumRight E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsFarWindowSumRight_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp



/-! ## The near part of `R_2^+` as a convolution

Translating `u = b - s` turns the right-endpoint near part into an integral
against the truncated kernel, exactly as `u = s - a` does on the left. -/

theorem integral_nearPartRight_eq_conv {c a b : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} (_hg : Continuous g) :
    (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) := by
    have h := intervalIntegral.integral_comp_sub_left
      (a := (0 : ℝ)) (b := b - a) (d := b)
      (f := fun s : ℝ => (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Ioi (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show b - u ∈ Ioi (b - c) by
        simp only [mem_Ioi]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      congr 2
      rw [show b - (b - u) = u by ring, abs_of_pos hupos]
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show b - u ∉ Ioi (b - c) by
        simp only [mem_Ioi, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Ioi (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp


/-! ## The resolution of one smoothed value

The decomposition of a single value of the smoothed near part into the pieces
of the resolution of the identity; both halves of (5.5) use it. -/

/-- **One value, decomposed into the pieces.** -/
theorem enorm_brsRefl_conv_le_pieces (k s : ℕ) {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) (a : ℝ) :
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (z - y)) a‖ₑ ≤
      ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
            brsRefl g (z - y)) a‖ₑ +
        ∑' m : ℕ, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
            brsRefl g (z - y)) a‖ₑ := by
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  set x : ℝ := -a with hx
  have hres := brs_resolution_truncConv k s hφ hφcs hφnorm hgrefl hgreflbd x
  have hlow : (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq k (continuous_brsDilate hφ (k + s))
      (hasCompactSupport_brsDilate hφcs (k + s)) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel φ (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl g (x - y) := fun m =>
    brs_piece_eq k (continuous_brsLPKernel hφ (k + s + m))
      (hasCompactSupport_brsLPKernel hφcs (k + s + m)) hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres

/-! ## The near part of `R_2^+`, in the reflected form -/

/-- **The near part of `R_2^+`, identified.**  Reflecting about `3/2` sends
`E ⊆ [1,2]` to itself and turns the right-endpoint near part into the same
convolution that appears on the left. -/
theorem brsANearRightAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hcr : c ≤ r) :
    brsANearRightAt c E g r =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ t ∈ E ∩ Ici (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r)‖ₑ := by
  have hidentify : ∀ t : ℝ,
      (∫ s in t..(t + r), (Ioi (t + r - c)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r) := by
    intro t
    rw [integral_nearPartRight_eq_conv hc (by linarith) hg]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t + r - u)) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (fun w : ℝ => g (3 - w)) (-(3 - t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t + r - u) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (fun w : ℝ => g (3 - w)) (-(3 - t - r) - u)
    rw [brsRefl_apply]
    congr 2
    ring
  have hpt : ∀ t : ℝ,
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
          (Ioi (t + r - c)).indicator
            (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r)‖ₑ := by
    intro t
    have hrnn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith) _
    rw [ENNReal.ofReal_mul hrnn, ofReal_norm, hidentify t]
  rw [brsANearRightAt]
  rw [iSup_congr fun t => iSup_congr fun _ => hpt t]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## The near part of `R_2^+`, decomposed -/

/-- Reflecting about `3/2` preserves `[1, 2]`. -/
theorem image_three_sub_subset_Icc {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    (fun x : ℝ => 3 - x) '' E ⊆ Icc (1 : ℝ) 2 := by
  rintro y ⟨t, htE, rfl⟩
  obtain ⟨h1, h2⟩ := hE htE
  exact ⟨by linarith, by linarith⟩

/-- **The near part of `R_2^+`, decomposed into the pieces.** -/
theorem brsANearRightAt_le_pieces (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearRightAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearFullMax k (brsDilate φ (k + s)) (fun w : ℝ => g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r +
          ∑' m : ℕ, brsNearFullMax k (brsLPKernel φ (k + s + m))
            (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  rw [brsANearRightAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine iSup₂_le fun t ht => ?_
  have hmem : (3 - t) ∈ (fun x : ℝ => 3 - x) '' E := ⟨t, ht.1, rfl⟩
  refine le_trans (enorm_brsRefl_conv_le_pieces k s hgt hgtbd hφ hφcs hφnorm
    (3 - t - r)) ?_
  refine add_le_add (le_iSup₂_of_le (3 - t) hmem le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le (3 - t) hmem le_rfl

/-- **The near part of `R_2^+` on `I_k`, decomposed.** -/
theorem brsANearRightWindow_le_tsum (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) (fun w : ℝ => g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m))
          (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr
    refine le_trans (brsANearRightAt_le_pieces (k + 1) s hg hgbd hφ hφcs hφnorm
      hcr) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **The near part of `R_2^+` on `I_k`, bounded by the family.** -/
theorem brsANearRightWindow_le_tsum_family (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      ∑' m : ℕ, brsNearFamily s φ (fun w : ℝ => g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) m k r := by
  refine le_trans (brsANearRightWindow_le_tsum k s hg hgbd hφ hφcs hφnorm r)
    (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add (fun m : ℕ => brsNearFamily s φ
    (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) m k r),
    brsNearFamily_zero]
  congr 1


/-! ## Proposition 5.4(i) for `R₂^+` -/

/-- `R_2^+` vanishes beyond `4/3`. -/
theorem brsRemTwoTwoRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsRemTwoTwoRight E g r = 0 := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **(5.5) for `R₂^+`, summed over the windows.** -/
theorem brsRemTwoTwoRight_le_window_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr0 : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) +
        ∑' k : ℕ, (brsWindowExt k).indicator
          (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r := by
  rcases lt_or_ge (4 / 3 : ℝ) r with hbig | hsmall
  · rw [brsRemTwoTwoRight_eq_zero hE hbig]
    exact zero_le
  obtain ⟨k, hk⟩ := exists_mem_brsWindowExt hr0 hsmall
  refine le_trans (brsRemTwoTwoRight_le_add_at
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) hg hr0.le) ?_
  refine add_le_add ?_ ?_
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]

/-- The pointwise splitting of `R₂^+` into two measurable majorants. -/
theorem brsRemTwoTwoRight_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
              ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x * brsFarWindowSumRight E g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hsplit := brsRemTwoTwoRight_le_window_sum hE hg hx
  have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
      (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
        ((fun y : ℝ => 3 - y) '' E) m k x := by
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearRightWindow_le_tsum_family k 3 hg hgbd hφ hφcs hφnorm x) ?_
    exact le_of_eq ENNReal.tsum_comm
  have hle : brsRemTwoTwoRight E g x ≤
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
          ((fun y : ℝ => 3 - y) '' E) m k x) +
        brsFarWindowSumRight E g x :=
    le_trans hsplit (add_le_add hnear le_rfl)
  have hpow : brsRemTwoTwoRight E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
            ((fun y : ℝ => 3 - y) '' E) m k x) ^ q +
          brsFarWindowSumRight E g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
              ((fun y : ℝ => 3 - y) '' E) m k x) ^ q +
            brsFarWindowSumRight E g x ^ q)) := mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
                ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x * brsFarWindowSumRight E g x ^ q) := by ring


/-! ## Proposition 5.4(i) for `R₂^+` -/

/-- Reflecting the profile about `3/2` does not change its `L^p` norm. -/
theorem lintegral_enorm_comp_three_sub (g : ℝ → ℂ) (p : ℝ) :
    (∫⁻ z : ℝ, ‖g (3 - z)‖ₑ ^ p) = ∫⁻ z : ℝ, ‖g z‖ₑ ^ p :=
  lintegral_sub_left_eq_self (fun z => ‖g z‖ₑ ^ p) 3

/-- **Proposition 5.4(i) of BRS, for `R₂^+`.**  The reflection `x ↦ 3 - x`
preserves `[1, 2]` and turns the right-endpoint operator into the left-endpoint
one for the reflected profile. -/
theorem prop54_brsRemTwoTwoRight_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨CF, hCFpos, hFbound⟩ := prop56_brsBFarWindowRight' hE hp1 hq0 hq2p
  have hFb := hFbound g hg.measurable
  -- the near constant
  set CN : ℝ := (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
      (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
    (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q)) with hCNdef
  have hKden : (0 : ℝ) < 1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q := by
    have h : (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < 1 :=
      calc (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hK
        _ = 1 := Real.rpow_zero 2
    linarith
  have hMden : (0 : ℝ) <
      1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) := by
    have hneg : brsSumExpM β (1 / r - 1 / 2) q / q < 0 :=
      div_neg_of_neg_of_pos hM hq0
    have h : (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < 1 :=
      calc (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hneg
        _ = 1 := Real.rpow_zero 2
    linarith
  have hCNnn : 0 ≤ CN := by
    rw [hCNdef]
    have hnum : (0 : ℝ) ≤ (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
        (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) := by
      refine Real.rpow_nonneg ?_ _
      have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
        Real.rpow_pos_of_pos (by norm_num) _
      have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
      positivity
    positivity
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  have hNb0 := brs_near_interior_family (image_three_sub_subset_Icc hE) hCβ hN
    hφ hφcs hφnorm hφd hφdcs hAφ hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn
    hbd' hA' hA'nn hmom hmom' hgt hgtbd hp hr hrq hpq hrel hr2 hCs hCslow hCsLP
    hK hM
  rw [lintegral_enorm_comp_three_sub g p] at hNb0
  have hswap : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) =
      ∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
        brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q * ENNReal.ofReal x :=
    lintegral_congr fun x => mul_comm _ _
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    rw [hswap]
    exact hNb0
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q := by
    refine ENNReal.measurable_ofReal.mul (Measurable.pow_const ?_ q)
    exact Measurable.ennreal_tsum fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsNearFamily 3 hφ hφcs hgt ((fun y : ℝ => 3 - y) '' E) m k
  refine ⟨(2 : ℝ) ^ ((q - 1) / q) * (CN + CF), by positivity, ?_⟩
  exact lintegral_rpow_le_of_two_bounds hq1 hNmeas
    (fun x => brsRemTwoTwoRight_rpow_le hE hφ.continuous hφcs hφnorm hg hgbd
      hq1 x)
    hCNnn hCFpos.le hNb hFb



/-! ## Proposition 5.4, with the bump data supplied

The resolution of the identity is an ingredient of the proof, not of the
statement, so it is discharged here once and for all. -/

/-- **The data needed to run the resolution of the identity.** -/
theorem exists_brsResolutionData {r : ℝ} (hr : 1 < r) (hr2 : r < 2) :
    ∃ (φ : ℝ → ℝ) (υ : ℝ → ℝ) (Aφ Aφ' Mu A Mu' A' Cs : ℝ),
      ContDiff ℝ 1 φ ∧ HasCompactSupport φ ∧ (∫ x : ℝ, φ x) = 1 ∧
        ContDiff ℝ 1 (deriv φ) ∧ HasCompactSupport (deriv φ) ∧
        (∫ y : ℝ, |φ y|) ≤ Aφ ∧ (∫ y : ℝ, |deriv φ y|) ≤ Aφ' ∧
        (∀ j : ℕ, brsLPKernel φ j = brsDilate υ j) ∧
        ContDiff ℝ 1 υ ∧ HasCompactSupport υ ∧
        tsupport υ ⊆ Metric.closedBall 0 1 ∧
        ContDiff ℝ 1 (deriv υ) ∧ HasCompactSupport (deriv υ) ∧
        tsupport (deriv υ) ⊆ Metric.closedBall 0 1 ∧
        (∀ x : ℝ, |υ x| ≤ Mu) ∧ (∫ y : ℝ, |υ y|) ≤ A ∧ 0 ≤ A ∧
        (∀ x : ℝ, |deriv υ x| ≤ Mu') ∧ (∫ y : ℝ, |deriv υ y|) ≤ A' ∧ 0 ≤ A' ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
        0 ≤ Cs ∧
        (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
          (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs ∧
        brsKernelConst Mu A 0 r ^ (1 / r) +
          brsKernelConst Mu' A' 0 r ^ (1 / r) ≤ Cs := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hden : (0 : ℝ) < 1 - r / 2 := by linarith
  obtain ⟨φ, hsmooth, hcs, hmass, hzero⟩ := exists_brsUnitBump
  have hcd1 : ContDiff ℝ 1 φ := hsmooth.of_le ENat.LEInfty.out
  have hcd2 : ContDiff ℝ 2 φ := hsmooth.of_le ENat.LEInfty.out
  have hφd : ContDiff ℝ 1 (deriv φ) := by
    have h : ContDiff ℝ (1 + 1) φ := by
      rw [show ((1 : WithTop ℕ∞) + 1) = 2 by norm_num]
      exact hcd2
    exact (contDiff_succ_iff_deriv.mp h).2.2
  have hφdcs : HasCompactSupport (deriv φ) := hcs.deriv
  obtain ⟨Mu, A, Mu', A', hυcd, hυcs, hυR, hderivcd, hderivcs, hderivR, hbd,
    hA, hAnn, hbd', hA', hA'nn, hmom, hmom'⟩ :=
    exists_brsLPBumpPackage hsmooth hcs hzero
  set Aφ : ℝ := ∫ y : ℝ, |φ y| with hAφdef
  set Aφ' : ℝ := ∫ y : ℝ, |deriv φ y| with hAφ'def
  have hAφnn : 0 ≤ Aφ := integral_nonneg fun y => abs_nonneg _
  have hAφ'nn : 0 ≤ Aφ' := integral_nonneg fun y => abs_nonneg _
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  set Clow : ℝ := (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
    (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) with hClowdef
  set CLP : ℝ := brsKernelConst Mu A 0 r ^ (1 / r) +
    brsKernelConst Mu' A' 0 r ^ (1 / r) with hCLPdef
  have hClownn : 0 ≤ Clow := by
    rw [hClowdef]
    have h1 : (0 : ℝ) < (1 - r / 2) ^ (-(1 / r)) := Real.rpow_pos_of_pos hden _
    have h2 : (0 : ℝ) < (2 : ℝ) ^ (3 * (1 / r - 1 / 2)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  have hCLPnn : 0 ≤ CLP := by
    rw [hCLPdef]
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A 0 r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn 0 hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' 0 r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn 0 hr.le) _
    linarith
  exact ⟨φ, brsLPKernel φ 0, Aφ, Aφ', Mu, A, Mu', A', Clow + CLP, hcd1, hcs,
    hmass, hφd, hφdcs, le_rfl, le_rfl, brsLPKernel_eq_dilate φ, hυcd, hυcs,
    hυR, hderivcd, hderivcs, hderivR, hbd, hA, hAnn, hbd', hA', hA'nn, hmom,
    hmom', by linarith, by linarith, by linarith⟩


/-! ## Proposition 5.4 in terms of the exponents alone -/

/-- **Proposition 5.4 for `R₂^-`.**  Only the exponents and the covering
estimate for `E` enter; the resolution of the identity is internal. -/
theorem prop54_brsRemTwoTwoLeft_of_exponents {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨φ, υ, Aφ, Aφ', Mu, A, Mu', A', Cs, hφ, hφcs, hφnorm, hφd, hφdcs,
    hAφ, hAφ', hυeq, hυ, hcs, hR, hυ', hcs', hR', hbd, hA, hAnn, hbd', hA',
    hA'nn, hmom, hmom', hCs, hCslow, hCsLP⟩ := exists_brsResolutionData hr hr2
  exact prop54_brsRemTwoTwoLeft_interior hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp1 hr hrq hpq hrel hr2 hq2p hCs hCslow hCsLP hK hM

/-- **Proposition 5.4 for `R₂^+`.** -/
theorem prop54_brsRemTwoTwoRight_of_exponents {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨φ, υ, Aφ, Aφ', Mu, A, Mu', A', Cs, hφ, hφcs, hφnorm, hφd, hφdcs,
    hAφ, hAφ', hυeq, hυ, hcs, hR, hυ', hcs', hR', hbd, hA, hAnn, hbd', hA',
    hA'nn, hmom, hmom', hCs, hCslow, hCsLP⟩ := exists_brsResolutionData hr hr2
  exact prop54_brsRemTwoTwoRight_interior hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp1 hr hrq hpq hrel hr2 hq2p hCs hCslow hCsLP hK hM


/-! ## Proposition 5.4 in terms of `p`, `q` and `β`

The intermediate exponent `r` is determined by `p` and `q`, and the two
summability conditions read `q/p < 2 - β` and `q/p < 1 + q/2 - β`.  This form
covers both parts of Proposition 5.4: nothing in the argument distinguishes
`q < 2` from `q ≥ 2`. -/

/-- The exponent data determined by `p` and `q`. -/
theorem brs_exponent_data {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) :
    ∃ r : ℝ, 1 < r ∧ r < q ∧ 1 / p + 1 / r = 1 + 1 / q ∧
      (1 / p - 1 / q < 1 / 2 → r < 2) ∧
      ∀ β : ℝ, brsSumExpK β (1 / r - 1 / 2) q = β - 2 + q / p ∧
        brsSumExpM β (1 / r - 1 / 2) q = β - 1 - q + q / p + q / 2 := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_trans hp0 hpq
  have hpne : p ≠ 0 := ne_of_gt hp0
  have hqne : q ≠ 0 := ne_of_gt hq0
  have hqp : 1 / q < 1 / p := one_div_lt_one_div_of_lt hp0 hpq
  have hp1' : 1 / p < 1 := by
    rw [div_lt_one hp0]
    exact hp1
  have hden : (0 : ℝ) < 1 + 1 / q - 1 / p := by
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  set r : ℝ := (1 + 1 / q - 1 / p)⁻¹ with hrdef
  have hrpos : (0 : ℝ) < r := by
    rw [hrdef]
    positivity
  have hrinv : 1 / r = 1 + 1 / q - 1 / p := by
    rw [hrdef]
    simp
  have hqinv : (0 : ℝ) < 1 / q := by positivity
  refine ⟨r, ?_, ?_, ?_, ?_, ?_⟩
  · refine (div_lt_one hrpos).mp ?_
    rw [hrinv]
    linarith
  · refine lt_of_one_div_lt_one_div hq0 ?_
    rw [hrinv]
    linarith
  · rw [hrinv]
    ring
  · intro hhalf
    refine lt_of_one_div_lt_one_div (by norm_num : (0 : ℝ) < 2) ?_
    rw [hrinv]
    linarith
  · intro β
    have hs : (1 / r - 1 / 2) * q = 1 + q - q / p - q / 2 := by
      rw [hrinv]
      field_simp
      ring
    refine ⟨?_, ?_⟩
    · rw [brsSumExpK, hs]
      ring
    · rw [brsSumExpM, hs]
      ring

/-- **Proposition 5.4 for `R₂^-`, in terms of `p`, `q` and `β`.** -/
theorem prop54_brsRemTwoTwoLeft_pq {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) (hq2p : q < 2 * p)
    (hhalf : 1 / p - 1 / q < 1 / 2) (hK : q / p < 2 - β)
    (hM : q / p < 1 + q / 2 - β) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨r, hr, hrq, hrel, hr2, hexp⟩ := brs_exponent_data hp1 hpq
  obtain ⟨hKeq, hMeq⟩ := hexp β
  refine prop54_brsRemTwoTwoLeft_of_exponents hE hCβ hN hg hgbd hp1 hr hrq hpq
    hrel (hr2 hhalf) hq2p ?_ ?_
  · rw [hKeq]
    linarith
  · rw [hMeq]
    linarith

/-- **Proposition 5.4 for `R₂^+`, in terms of `p`, `q` and `β`.** -/
theorem prop54_brsRemTwoTwoRight_pq {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) (hq2p : q < 2 * p)
    (hhalf : 1 / p - 1 / q < 1 / 2) (hK : q / p < 2 - β)
    (hM : q / p < 1 + q / 2 - β) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨r, hr, hrq, hrel, hr2, hexp⟩ := brs_exponent_data hp1 hpq
  obtain ⟨hKeq, hMeq⟩ := hexp β
  refine prop54_brsRemTwoTwoRight_of_exponents hE hCβ hN hg hgbd hp1 hr hrq hpq
    hrel (hr2 hhalf) hq2p ?_ ?_
  · rw [hKeq]
    linarith
  · rw [hMeq]
    linarith


/-! ## The radial weight on a window, for an arbitrary power

`𝔐_p^±` carries the weight `r^{-1}` rather than `r^{-1/2}`, so the window
computation is restated with the power left free. -/

/-- **The radial weight `r^e` costs `(2^{-k})^{eq+1}` on `I_k`.** -/
theorem lintegral_window_weight_rpow_le_gen (k : ℕ) (S : ℝ → ENNReal) {q e : ℝ}
    (hq : 0 < q) :
    (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ e) * S r) r) ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |e * q + 1| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (e * q + 1)) * ∫⁻ r : ℝ, S r ^ q := by
  set C : ℝ := (2 : ℝ) ^ |e * q + 1| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (e * q + 1)
    with hC
  have hpt : ∀ r : ℝ, ((brsWindowExt k).indicator
      (fun r => ENNReal.ofReal (r ^ e) * S r) r) ^ q * ENNReal.ofReal r ≤
      ENNReal.ofReal C * S r ^ q := by
    intro r
    by_cases hr : r ∈ brsWindowExt k
    · have hrpos : 0 < r := brsWindowExt_pos hr
      have hval : ((brsWindowExt k).indicator
          (fun r => ENNReal.ofReal (r ^ e) * S r) r) ^ q * ENNReal.ofReal r =
            ENNReal.ofReal (r ^ (e * q + 1)) * S r ^ q := by
        rw [Set.indicator_of_mem hr]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (e * q))) (S r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r ^ (e * q + 1))) (S r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (e * q) * r = r ^ (e * q) * r ^ (1 : ℝ) := by rw [Real.rpow_one]
          _ = r ^ (e * q + 1) := (Real.rpow_add hrpos _ _).symm
      rw [hval]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (rpow_le_of_mem_brsWindowExt hr (e * q + 1))) le_rfl
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ e) * S r) r) ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal C * S r ^ q := lintegral_mono hpt
    _ = ENNReal.ofReal C * ∫⁻ r : ℝ, S r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-! ## Integrability of the `𝔐_p^±` integrand

At the left endpoint the two singularities `s^{1/2 - 1/p}` and `(s-a)^{-1/2}`
collide when `a = 0`; their product is then `s^{-1/p}`, still integrable for
`p > 1`. -/

theorem intervalIntegrable_mainWeight_complex {p : ℝ} (hp : 1 < p) {g : ℝ → ℂ}
    (hg : Continuous g) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) volume a b := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hreal : IntervalIntegrable
      (fun s => s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) volume a b := by
    rcases eq_or_lt_of_le ha with rfl | ha0
    · have hexp : (-1 : ℝ) < -(1 / p) := by
        have : 1 / p < 1 := by
          rw [div_lt_one hp0]
          exact hp
        linarith
      have hbase : IntervalIntegrable (fun s : ℝ => s ^ (-(1 / p) : ℝ))
          volume 0 b := intervalIntegral.intervalIntegrable_rpow' hexp
      refine hbase.congr ?_
      intro s hs
      rw [uIoc_of_le hab] at hs
      obtain ⟨hs1, hs2⟩ := hs
      show s ^ (-(1 / p) : ℝ) =
        s ^ (1 / 2 - 1 / p) * (s - 0) ^ (-(1 / 2) : ℝ)
      rw [sub_zero, ← Real.rpow_add hs1]
      congr 1
      ring
    · have hcont : ContinuousOn (fun s : ℝ => s ^ (1 / 2 - 1 / p))
          (uIcc a b) := by
        rw [Set.uIcc_of_le hab]
        intro s hs
        have hspos : (0 : ℝ) < s := lt_of_lt_of_le ha0 hs.1
        exact (Real.continuousAt_rpow_const s _
          (Or.inl (ne_of_gt hspos))).continuousWithinAt
      exact (intervalIntegrable_left_weight a b).continuousOn_mul hcont
  have hcast : IntervalIntegrable
      (fun s => ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ))
      volume a b := ⟨hreal.1.ofReal, hreal.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn


/-! ## Splitting `𝔐_p^-` at its singularity

The same near/far split as (5.5), for the main term. -/

/-- The near part of `𝔐_p^-`, with an arbitrary cutoff. -/
def brsMainNearLeftAt (c : ℝ) (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      (Iio (|r - t| + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- The far part of `𝔐_p^-`, with an arbitrary cutoff. -/
def brsMainFarLeftAt (c : ℝ) (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      (Ici (|r - t| + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **The near/far split of `𝔐_p^-`.** -/
theorem brsMainTwoLeft_le_add_at (c : ℝ) {E : Set ℝ} {p : ℝ} (hp : 1 < p)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr : 0 < r) :
    brsMainTwoLeft E p g r ≤
      brsMainNearLeftAt c E p g r + brsMainFarLeftAt c E p g r := by
  rw [brsMainTwoLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htpos : (0 : ℝ) < t := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  set F : ℝ → ℂ := fun s =>
    ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume a b :=
    intervalIntegrable_mainWeight_complex hp hg hanonneg hab
  have hnear : IntervalIntegrable ((Iio (a + c)).indicator F) volume a b :=
    ⟨hfull.1.indicator measurableSet_Iio, hfull.2.indicator measurableSet_Iio⟩
  have hfar : IntervalIntegrable ((Ici (a + c)).indicator F) volume a b :=
    ⟨hfull.1.indicator measurableSet_Ici, hfull.2.indicator measurableSet_Ici⟩
  have hsplit : ∀ s : ℝ, F s = (Iio (a + c)).indicator F s +
      (Ici (a + c)).indicator F s := by
    intro s
    by_cases hs : s < a + c
    · rw [Set.indicator_of_mem (show s ∈ Iio (a + c) from hs),
        Set.indicator_of_notMem (show s ∉ Ici (a + c) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Iio (a + c) from hs),
        Set.indicator_of_mem (show s ∈ Ici (a + c) from not_lt.mp hs)]
      ring
  have hint : (∫ s in a..b, F s) =
      (∫ s in a..b, (Iio (a + c)).indicator F s) +
        ∫ s in a..b, (Ici (a + c)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in a..b, F s‖ ≤
      ‖∫ s in a..b, (Iio (a + c)).indicator F s‖ +
        ‖∫ s in a..b, (Ici (a + c)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r⁻¹ := by positivity
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, F s‖)
      ≤ ENNReal.ofReal (r⁻¹ *
          (‖∫ s in a..b, (Iio (a + c)).indicator F s‖ +
            ‖∫ s in a..b, (Ici (a + c)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r⁻¹ *
          ‖∫ s in a..b, (Iio (a + c)).indicator F s‖) +
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in a..b, (Ici (a + c)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsMainNearLeftAt c E p g r + brsMainFarLeftAt c E p g r := by
        refine add_le_add ?_ ?_
        · rw [brsMainNearLeftAt]
          exact le_iSup₂_of_le t ⟨htE, ht1, ht2⟩ le_rfl
        · rw [brsMainFarLeftAt]
          exact le_iSup₂_of_le t ⟨htE, ht1, ht2⟩ le_rfl


/-! ## Integrability of the `𝔐_p^+` integrand

Here the two singularities sit at opposite endpoints, so the interval is split
at its midpoint. -/

theorem intervalIntegrable_mainWeightRight_complex {p : ℝ} (hp : 1 < p)
    {g : ℝ → ℂ} (hg : Continuous g) {a b : ℝ} (ha : 0 ≤ a) (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) volume a b := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hexp : (-1 : ℝ) < 1 / 2 - 1 / p := by
    have h1 : 1 / p < 1 := by
      rw [div_lt_one hp0]
      exact hp
    linarith
  have hreal : IntervalIntegrable
      (fun s => s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)) volume a b := by
    rcases eq_or_lt_of_le hab with rfl | hlt
    · simp [IntervalIntegrable]
    · set m : ℝ := (a + b) / 2 with hm
      have ham : a ≤ m := by
        rw [hm]
        linarith
      have hmb : m ≤ b := by
        rw [hm]
        linarith
      have hmpos : (0 : ℝ) < m := by
        rw [hm]
        linarith
      have hlow : IntervalIntegrable
          (fun s => s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ))
          volume a m := by
        have hbase : IntervalIntegrable (fun s : ℝ => s ^ (1 / 2 - 1 / p))
            volume a m := intervalIntegral.intervalIntegrable_rpow' hexp
        refine hbase.mul_continuousOn ?_
        rw [Set.uIcc_of_le ham]
        intro s hs
        have hbs : (0 : ℝ) < b - s := by
          have : s ≤ m := hs.2
          rw [hm] at this
          linarith
        exact ((continuous_const.sub continuous_id).continuousWithinAt).rpow_const
          (Or.inl (ne_of_gt hbs))
      have hhigh : IntervalIntegrable
          (fun s => s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ))
          volume m b := by
        refine (intervalIntegrable_right_weight m b).continuousOn_mul ?_
        rw [Set.uIcc_of_le hmb]
        intro s hs
        have hspos : (0 : ℝ) < s := lt_of_lt_of_le hmpos hs.1
        exact (Real.continuousAt_rpow_const s _
          (Or.inl (ne_of_gt hspos))).continuousWithinAt
      exact hlow.trans hhigh
  have hcast : IntervalIntegrable
      (fun s => ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ))
      volume a b := ⟨hreal.1.ofReal, hreal.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn



/-! ## Splitting `𝔐_p^+` at its singularity -/

/-- The near part of `𝔐_p^+`, with an arbitrary cutoff. -/
def brsMainNearRightAt (c : ℝ) (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      (Ioi (r + t - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- The far part of `𝔐_p^+`, with an arbitrary cutoff. -/
def brsMainFarRightAt (c : ℝ) (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      (Iic (r + t - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **The near/far split of `𝔐_p^+`.** -/
theorem brsMainTwoRight_le_add_at (c : ℝ) {E : Set ℝ} {p : ℝ} (hp : 1 < p)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr : 0 < r) :
    brsMainTwoRight E p g r ≤
      brsMainNearRightAt c E p g r + brsMainFarRightAt c E p g r := by
  rw [brsMainTwoRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htpos : (0 : ℝ) < t := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  set F : ℝ → ℂ := fun s =>
    ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume a b :=
    intervalIntegrable_mainWeightRight_complex hp hg hanonneg hab
  have hnear : IntervalIntegrable ((Ioi (b - c)).indicator F) volume a b :=
    ⟨hfull.1.indicator measurableSet_Ioi, hfull.2.indicator measurableSet_Ioi⟩
  have hfar : IntervalIntegrable ((Iic (b - c)).indicator F) volume a b :=
    ⟨hfull.1.indicator measurableSet_Iic, hfull.2.indicator measurableSet_Iic⟩
  have hsplit : ∀ s : ℝ, F s = (Ioi (b - c)).indicator F s +
      (Iic (b - c)).indicator F s := by
    intro s
    by_cases hs : b - c < s
    · rw [Set.indicator_of_mem (show s ∈ Ioi (b - c) from hs),
        Set.indicator_of_notMem (show s ∉ Iic (b - c) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (b - c) from hs),
        Set.indicator_of_mem (show s ∈ Iic (b - c) from not_lt.mp hs)]
      ring
  have hint : (∫ s in a..b, F s) =
      (∫ s in a..b, (Ioi (b - c)).indicator F s) +
        ∫ s in a..b, (Iic (b - c)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in a..b, F s‖ ≤
      ‖∫ s in a..b, (Ioi (b - c)).indicator F s‖ +
        ‖∫ s in a..b, (Iic (b - c)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r⁻¹ := by positivity
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, F s‖)
      ≤ ENNReal.ofReal (r⁻¹ *
          (‖∫ s in a..b, (Ioi (b - c)).indicator F s‖ +
            ‖∫ s in a..b, (Iic (b - c)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r⁻¹ *
          ‖∫ s in a..b, (Ioi (b - c)).indicator F s‖) +
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in a..b, (Iic (b - c)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsMainNearRightAt c E p g r + brsMainFarRightAt c E p g r := by
        refine add_le_add ?_ ?_
        · rw [brsMainNearRightAt]
          exact le_iSup₂_of_le t ⟨htE, ht1, ht2⟩ le_rfl
        · rw [brsMainFarRightAt]
          exact le_iSup₂_of_le t ⟨htE, ht1, ht2⟩ le_rfl


/-! ## The main terms live on a compact range of radii

Unlike the remainders `R_2^±`, the main terms `𝔐_p^±` only see dilations
comparable to the radius, so with `E ⊆ [1,2]` the radius is confined to
`(2/3, 4)`.  In particular no dyadic decomposition of the radius is needed:
there is no small-radius divergence to control. -/

theorem brsMainWindow_empty {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {r : ℝ}
    (hr : r ∉ Ioo (2 / 3 : ℝ) 4) : E ∩ Ioo (r / 2) (3 * r / 2) = ∅ := by
  refine Set.eq_empty_iff_forall_notMem.mpr fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  obtain ⟨h1, h2⟩ := hE htE
  exact hr ⟨by linarith, by linarith⟩

theorem brsMainTwoLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainTwoLeft E p g r = 0 := by
  rw [brsMainTwoLeft, brsMainWindow_empty hE hr]
  simp

theorem brsMainTwoRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainTwoRight E p g r = 0 := by
  rw [brsMainTwoRight, brsMainWindow_empty hE hr]
  simp

theorem brsMainNearLeftAt_eq_zero {c : ℝ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainNearLeftAt c E p g r = 0 := by
  rw [brsMainNearLeftAt, brsMainWindow_empty hE hr]
  simp

theorem brsMainFarLeftAt_eq_zero {c : ℝ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainFarLeftAt c E p g r = 0 := by
  rw [brsMainFarLeftAt, brsMainWindow_empty hE hr]
  simp

theorem brsMainNearRightAt_eq_zero {c : ℝ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainNearRightAt c E p g r = 0 := by
  rw [brsMainNearRightAt, brsMainWindow_empty hE hr]
  simp

theorem brsMainFarRightAt_eq_zero {c : ℝ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainFarRightAt c E p g r = 0 := by
  rw [brsMainFarRightAt, brsMainWindow_empty hE hr]
  simp

/-- On the window the radius is comparable to `1`. -/
theorem brsMain_radius_bounds {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {r t : ℝ}
    (ht : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) : 2 / 3 < r ∧ r < 4 := by
  obtain ⟨htE, ht1, ht2⟩ := ht
  obtain ⟨h1, h2⟩ := hE htE
  exact ⟨by linarith, by linarith⟩


/-! ## The near part of the main terms, as a convolution

The extra weight `s^e` rides along with the profile: the near part of `𝔐_p^±`
is the truncated kernel against `s ↦ s^e g(s)`. -/

/-- **The near part of `𝔐_p^-`, as a convolution.** -/
theorem integral_mainNearPart_eq_conv {c a b e : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} :
    (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) := by
    have h := intervalIntegral.integral_comp_add_left
      (a := (0 : ℝ)) (b := b - a) (d := a)
      (f := fun s : ℝ => (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Iio (a + c)).indicator
          (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show a + u ∈ Iio (a + c) by
        simp only [mem_Iio]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      rw [show a + u - a = u by ring]
      push_cast
      ring
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show a + u ∉ Iio (a + c) by
        simp only [mem_Iio, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Iio (a + c)).indicator
          (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp

/-- **The near part of `𝔐_p^+`, as a convolution.** -/
theorem integral_mainNearPartRight_eq_conv {c a b e : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} :
    (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) := by
    have h := intervalIntegral.integral_comp_sub_left
      (a := (0 : ℝ)) (b := b - a) (d := b)
      (f := fun s : ℝ => (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Ioi (b - c)).indicator
          (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show b - u ∈ Ioi (b - c) by
        simp only [mem_Ioi]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      rw [show b - (b - u) = u by ring]
      push_cast
      ring
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show b - u ∉ Ioi (b - c) by
        simp only [mem_Ioi, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Ioi (b - c)).indicator
          (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp


/-! ## The near part of `𝔐_p^-`, identified

Absorbing the weight `s^e` into the profile puts the near part of the main term
into exactly the shape the resolution machinery consumes. -/

/-- The profile with the extra power absorbed. -/
def brsWeightedProfile (e : ℝ) (g : ℝ → ℂ) (z : ℝ) : ℂ := ((z ^ e : ℝ) : ℂ) * g z

theorem brsWeightedProfile_apply (e : ℝ) (g : ℝ → ℂ) (z : ℝ) :
    brsWeightedProfile e g z = ((z ^ e : ℝ) : ℂ) * g z := rfl

/-- **The near part of `𝔐_p^-`, identified.** -/
theorem brsMainNearLeftAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearLeftAt c E p g r =
      ENNReal.ofReal r⁻¹ *
        ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
              |r - t|‖ₑ := by
  have hr : (0 : ℝ) < r := lt_of_lt_of_le hc hcr
  have hrinv : (0 : ℝ) ≤ r⁻¹ := by positivity
  have hidentify : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      (∫ s in |r - t|..(r + t), (Iio (|r - t| + c)).indicator
          (fun s => ((s ^ (1 / 2 - 1 / p) *
            (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
          brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y)) |r - t| := by
    rintro t ⟨-, ht1, ht2⟩
    have hcb : |r - t| + c ≤ r + t := by
      rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
    rw [integral_mainNearPart_eq_conv hc hcb]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((|r - t| + u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (|r - t| + u))) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (-|r - t| - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((|r - t| + u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (|r - t| + u)) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (-|r - t| - u)
    rw [brsRefl_apply, brsWeightedProfile_apply,
      show -(-|r - t| - u) = |r - t| + u by ring]
  have hpt : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
          (Iio (|r - t| + c)).indicator
            (fun s => ((s ^ (1 / 2 - 1 / p) *
              (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal r⁻¹ *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
              |r - t|‖ₑ := by
    intro t ht
    rw [ENNReal.ofReal_mul hrinv, ofReal_norm, hidentify t ht]
  rw [brsMainNearLeftAt]
  rw [iSup_congr fun t => iSup_congr fun ht => hpt t ht]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## Splitting the window of the main term at `t = r`

The singular point of `𝔐_p^±` is `|r - t|`, which is `r - t` below `r` and
`t - r` above it.  Splitting there turns the maximal function into the two
shapes the localized maximal estimate already handles. -/

/-- **The two halves of the window.** -/
theorem iSup_abs_translate_le {E : Set ℝ} {F : ℝ → ℂ} (r : ℝ) {S : Set ℝ}
    (hS : S ⊆ E) :
    (⨆ t ∈ S, ‖brsRefl F |r - t|‖ₑ) ≤
      (⨆ t ∈ E, ‖F (t - r)‖ₑ) + ⨆ t ∈ E, ‖brsRefl F (t - r)‖ₑ := by
  refine iSup₂_le fun t ht => ?_
  rcases le_or_gt t r with hle | hgt
  · have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
    rw [habs, brsRefl_apply, show -(r - t) = t - r by ring]
    exact le_trans (le_iSup₂_of_le t (hS ht) le_rfl) le_self_add
  · have habs : |r - t| = t - r := by
      rw [abs_sub_comm]
      exact abs_of_nonneg (by linarith)
    rw [habs]
    exact le_trans (le_iSup₂_of_le t (hS ht) le_rfl) le_add_self

/-- **The near part of `𝔐_p^-`, split into the two standard shapes.** -/
theorem brsMainNearLeftAt_le_split {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearLeftAt c E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ((⨆ t ∈ E, ‖∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (t - r - y)‖ₑ) +
          ⨆ t ∈ E, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
                (t - r)‖ₑ) := by
  rw [brsMainNearLeftAt_eq hc hcr]
  exact mul_le_mul' le_rfl (iSup_abs_translate_le r Set.inter_subset_left)


/-! ## The unreflected decomposition

Evaluating the reflected decomposition at `-a` gives the same statement for the
convolution itself. -/

/-- **One value of the convolution, decomposed into the pieces.** -/
theorem enorm_conv_le_pieces (k s : ℕ) {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) (a : ℝ) :
    ‖∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (a - y)‖ₑ ≤
      ‖∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
          brsRefl g (a - y)‖ₑ +
        ∑' m : ℕ, ‖∫ y : ℝ,
          ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
            brsRefl g (a - y)‖ₑ := by
  have h := enorm_brsRefl_conv_le_pieces k s hg hgbd hφ hφcs hφnorm (-a)
  simp only [brsRefl_apply, neg_neg] at h
  exact h


/-! ## The near part of `𝔐_p^-`, decomposed into the pieces

The radius is confined to `(2/3, 4)`, so the truncation can be taken at the
single scale `2^{-1} = 1/2`; there is no `k`-sum.  Both halves of the window
decompose into the same two families of pieces. -/

/-- The unreflected piece maximal function. -/
def brsMainMaxU (kt : ℕ) (Ψ : ℝ → ℝ) (G : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E, ‖∫ y : ℝ, ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) *
    brsRefl G (t - r - y)‖ₑ

/-- **The near part of `𝔐_p^-`, decomposed.** -/
theorem brsMainNearLeftAt_le_pieces (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ((brsMainMaxU 1 (brsDilate φ (1 + s))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
            ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
          (brsNearFullMax 1 (brsDilate φ (1 + s))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
            ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r)) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine le_trans (brsMainNearLeftAt_le_split hc hcr) ?_
  refine mul_le_mul' le_rfl (add_le_add ?_ ?_)
  · refine le_trans (iSup₂_mono fun t _ => enorm_conv_le_pieces 1 s hG hGbd hφ
      hφcs hφnorm (t - r)) iSup_add_tsum_le
  · refine le_trans (iSup₂_mono fun t _ => enorm_brsRefl_conv_le_pieces 1 s hG
      hGbd hφ hφcs hφnorm (t - r)) iSup_add_tsum_le


/-! ## The radial weight of the main terms is bounded

On `(2/3, 4)` the weight `r^{-q} · r` of the main terms is bounded by a
constant; there is no dyadic bookkeeping to do. -/

/-- **The radial weight of `𝔐_p^±` costs only a constant.** -/
theorem lintegral_main_weight_le (T : ℝ → ENNReal) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * ∫⁻ r : ℝ, T r ^ q := by
  have hpt : ∀ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
      (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * T r ^ q := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · have hr1 : (2 : ℝ) / 3 < r := hr.1
      have hr2 : r < 4 := hr.2
      have hrpos : (0 : ℝ) < r := by linarith
      have hinv : (0 : ℝ) < r⁻¹ := by positivity
      have hinvle : r⁻¹ ≤ 3 / 2 := by
        rw [inv_le_comm₀ hrpos (by norm_num)]
        linarith
      have hval : ((Ioo (2 / 3 : ℝ) 4).indicator
          (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r =
          ENNReal.ofReal (r⁻¹ ^ q * r) * T r ^ q := by
        rw [Set.indicator_of_mem hr,
          ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos hinv]
        rw [mul_comm (ENNReal.ofReal (r⁻¹ ^ q)) (T r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r⁻¹ ^ q * r)) (T r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hinv.le _)]
      rw [hval]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      have h1 : r⁻¹ ^ q ≤ (3 / 2 : ℝ) ^ q :=
        Real.rpow_le_rpow hinv.le hinvle hq.le
      have h2 : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q :=
        Real.rpow_nonneg (by norm_num) _
      nlinarith [Real.rpow_nonneg hinv.le q]
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * T r ^ q :=
        lintegral_mono hpt
    _ = ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * ∫⁻ r : ℝ, T r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- **The near part of `𝔐_p^-`, with the radial cutoff made explicit.** -/
theorem brsMainNearLeftAt_le_indicator (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ *
          ((brsMainMaxU 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
            (brsNearFullMax 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r))) r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    have hhalf : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = 1 / 2 := by norm_num
    have hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r := by
      rw [hhalf]
      linarith [hr.1]
    exact brsMainNearLeftAt_le_pieces s hG hGbd hφ hφcs hφnorm hcr
  · rw [Set.indicator_of_notMem hr, brsMainNearLeftAt_eq_zero hE hr]


/-! ## The radial `L^q` norm of the near part of `𝔐_p^-` -/

/-- **The near part of `𝔐_p^-` in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearLeftAt_rpow_le (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ^ q *
        ENNReal.ofReal r) ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) *
        ∫⁻ r : ℝ,
          ((brsMainMaxU 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
            (brsNearFullMax 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r)) ^ q := by
  refine le_trans (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow
      (brsMainNearLeftAt_le_indicator s hE hG hGbd hφ hφcs hφnorm r) hq.le)
      le_rfl) ?_
  exact lintegral_main_weight_le _ hq

/-- The four families of pieces, as one indexed family. -/
def brsMainFamily (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (n : ℕ) (r : ℝ) : ENNReal :=
  match n with
  | 0 => brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r
  | 1 => brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r
  | (m + 2) =>
      brsMainMaxU 1 (brsLPKernel φ (1 + s + m)) (brsWeightedProfile e g) E r +
        brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
          (brsWeightedProfile e g) E r


/-! ## The four families as one -/

theorem brsMainFamily_zero (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamily s φ e g E 0 r =
      brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r := rfl

theorem brsMainFamily_one (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamily s φ e g E 1 r =
      brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r := rfl

theorem brsMainFamily_succ_succ (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ)
    (E : Set ℝ) (m : ℕ) (r : ℝ) : brsMainFamily s φ e g E (m + 1 + 1) r =
      brsMainMaxU 1 (brsLPKernel φ (1 + s + m)) (brsWeightedProfile e g) E r +
        brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
          (brsWeightedProfile e g) E r := rfl

/-- **The four families, collected into one sum.** -/
theorem brsMainFamily_tsum (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) :
    (brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r +
          ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
            (brsWeightedProfile e g) E r) +
        (brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r +
          ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
            (brsWeightedProfile e g) E r) =
      ∑' n : ℕ, brsMainFamily s φ e g E n r := by
  rw [ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamily s φ e g E n r),
    ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamily s φ e g E (n + 1) r)]
  simp only [brsMainFamily_zero, brsMainFamily_succ_succ]
  rw [ENNReal.tsum_add, brsMainFamily_one]
  ring


/-! ## Measurability of the main-term families -/

theorem measurable_brsMainMaxU (kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {G : ℝ → ℂ} (hG : Continuous G) (E : Set ℝ) :
    Measurable (brsMainMaxU kt Ψ G E) := by
  have hgr : Continuous (brsRefl G) := continuous_brsRefl hG
  have hFcont : Continuous fun x : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl G (x - y) := by
    have hderiv := fun x : ℝ => hasDerivAt_kernel_convolution
      (hasCompactSupport_brsTruncConvReal kt hcs)
      (contDiff_brsTruncConvReal kt (n := 1) hΨ hcs) hgr x
    have hdiff : Differentiable ℝ fun x : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl G (x - y) :=
      fun x => (hderiv x).differentiableAt
    exact hdiff.continuous
  exact measurable_iSup_enorm_translate hFcont E

theorem measurable_brsMainFamily (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (e : ℝ) {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) (E : Set ℝ) (n : ℕ) :
    Measurable (brsMainFamily s φ e g E n) := by
  match n with
  | 0 =>
      exact measurable_brsMainMaxU 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hG E
  | 1 =>
      exact measurable_brsNearFullMax 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hG E
  | (m + 2) =>
      have hlp : ContDiff ℝ 1 (brsLPKernel φ (1 + s + m)) :=
        (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)
      exact (measurable_brsMainMaxU 1 hlp
        (hasCompactSupport_brsLPKernel hφcs _) hG E).add
          (measurable_brsNearFullMax 1 hlp
            (hasCompactSupport_brsLPKernel hφcs _) hG E)

/-! ## The near part of `𝔐_p^-`, reduced to the individual pieces -/

/-- **The near part of `𝔐_p^-`, reduced to the pieces.** -/
theorem lintegral_brsMainNear_Lp_le (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamily s φ (1 / 2 - 1 / p) g E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_brsMainNearLeftAt_rpow_le s hE hG hGbd hφ.continuous
    hφcs hφnorm hq0
  simp only [brsMainFamily_tsum] at hstep
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamily s hφ hφcs (1 / 2 - 1 / p) hG E n)


/-! ## The localized maximal estimate for the unreflected family

`brsMainMaxU` is `brs_5_9_core`'s maximal function with the profile reflected,
so the same bracket appears; reflecting does not change the `L^p` norm. -/

/-- **The maximal estimate for the unreflected pieces.** -/
theorem lintegral_brsMainMaxU_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (kt : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {G : ℝ → ℂ} (hG : Continuous G) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainMaxU kt υ G E x ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal kt υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have h := brs_5_9_core hδ hcov kt hcs hυ hcs' hυ' (continuous_brsRefl hG) hp
    hr hrq hpq hrel
  have hnorm : (∫⁻ z : ℝ, ‖brsRefl G z‖ₑ ^ p) = ∫⁻ z : ℝ, ‖G z‖ₑ ^ p :=
    lintegral_enorm_comp_neg G p
  rwa [hnorm] at h


/-! ## The kernel bracket of the low-frequency piece, on its own

The counterpart of `brs_5_9_bracket` for the piece that carries no
cancellation. -/

/-- **The kernel bracket of the low-frequency piece.** -/
theorem brs_low_bracket (k j : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {r : ℝ} (hr : 1 ≤ r) (hr2 : r < 2) (G : ENNReal) :
    (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
            (1 / r) * G) ≤
      ENNReal.ofReal ((A + A') * brsLowConst k r ^ (1 / r)) * G := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : 0 ≤ brsLowConst k r := brsLowConst_nonneg k hr2
  have hker : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (A * brsLowConst k r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_dilate_le_L1 k j hφ.continuous hcs hA
        hr hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst, Real.mul_rpow (Real.rpow_nonneg hAnn r) (by positivity),
      ← Real.rpow_mul hAnn, mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  have hker' : (∫⁻ y : ℝ,
      ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst k r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 k j hφ
        hφ'.continuous hcs' hA' hr hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst,
      Real.mul_rpow (Real.rpow_nonneg (by positivity) r) (by positivity),
      ← Real.rpow_mul (by positivity), mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  calc (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
            (1 / r) * G)
      ≤ ENNReal.ofReal (A * brsLowConst k r ^ (1 / r)) * G +
          ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst k r ^ (1 / r)) *
              G) :=
        add_le_add (mul_le_mul' hker le_rfl)
          (mul_le_mul' le_rfl (mul_le_mul' hker' le_rfl))
    _ = ENNReal.ofReal ((A + A') * brsLowConst k r ^ (1 / r)) * G := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← add_mul,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        rw [rpow_neg_natCast_two j]
        field_simp


/-! ## The two low-frequency pieces of the main term -/

/-- The smoothness data of a dilated profile. -/
theorem brsDilate_deriv_data {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hφdcs : HasCompactSupport (deriv φ)) (j : ℕ) :
    ContDiff ℝ 1 (brsDilate φ j) ∧ HasCompactSupport (brsDilate φ j) ∧
      ContDiff ℝ 1 (deriv (brsDilate φ j)) ∧
      HasCompactSupport (deriv (brsDilate φ j)) := by
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hderiv : deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j :=
    deriv_brsDilate_eq hφ j
  refine ⟨contDiff_brsDilate hφ j, hasCompactSupport_brsDilate hφcs j, ?_, ?_⟩
  · rw [hderiv]
    exact contDiff_brsDilate (contDiff_const.mul hφ') j
  · rw [hderiv]
    exact hasCompactSupport_brsDilate hφdcs.mul_left j

/-- **The unreflected low-frequency piece.** -/
theorem lintegral_brsMainFamily_zero_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsMainMaxU_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hG hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _

/-- **The reflected low-frequency piece.** -/
theorem lintegral_brsMainFamily_one_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hG hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _


/-! ## The high-frequency pieces of the main term

Index `m + 2` of the family is the sum of the two `m`-th Littlewood--Paley
pieces, so the convexity bound costs a factor `2^q`. -/

/-- **The `m`-th Littlewood--Paley piece of `𝔐_p^-`.** -/
theorem lintegral_brsMainFamily_succ_succ_le {E : Set ℝ} {ι : Finset ℝ} (m : ℕ)
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ι)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ q *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkj : 5 * (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap 1 m
    have heq : 1 + (m + 3) = 1 + 3 + m := by omega
    rw [heq] at h
    simpa using h
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hυ hcs hυ' hcs' (1 + 3 + m)
  set U : ℝ → ENNReal := brsMainMaxU 1 (brsDilate υ (1 + 3 + m))
    (brsWeightedProfile e g) E with hU
  set R : ℝ → ENNReal := brsNearFullMax 1 (brsDilate υ (1 + 3 + m))
    (brsWeightedProfile e g) E with hRdef
  set B : ENNReal := (ι.card : ENNReal) *
    (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r)) *
        ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
      (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q with hB
  have hUb : (∫⁻ x : ℝ, U x ^ q) ≤ B := by
    refine le_trans (lintegral_brsMainMaxU_rpow_le hδ hcov 1 hdilcs hdil hdercs
      hdercd hG hp hr hrq hpq hrel) ?_
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
      (brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
        hmom' hr hkj _) hq0.le)
  have hRb : (∫⁻ x : ℝ, R x ^ q) ≤ B := by
    refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil
      hdercs hdercd hG hp hr hrq hpq hrel) ?_
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
      (brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
        hmom' hr hkj _) hq0.le)
  have hUmeas : Measurable U := measurable_brsMainMaxU 1 hdil hdilcs hG E
  have hfam : ∀ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x = U x + R x := by
    intro x
    rw [brsMainFamily_succ_succ, hU, hRdef, hυeq]
  have hpt : ∀ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (U x ^ q + R x ^ q) := by
    intro x
    rw [hfam x]
    exact ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq1
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hsum : (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * ((∫⁻ x : ℝ, U x ^ q) + ∫⁻ x : ℝ, R x ^ q) := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_const_mul' _ _ htop,
      lintegral_add_left' (hUmeas.pow_const q).aemeasurable]
  refine le_trans hsum ?_
  have hstep : (2 : ENNReal) ^ (q - 1) *
      ((∫⁻ x : ℝ, U x ^ q) + ∫⁻ x : ℝ, R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * (B + B) := mul_le_mul' le_rfl (add_le_add hUb hRb)
  refine le_trans hstep (le_of_eq ?_)
  have htwo : B + B = (2 : ENNReal) * B := by
    rw [two_mul]
  rw [htwo, ← mul_assoc]
  congr 1
  exact ennreal_rpow_sub_one_mul (by simp) hq1


/-! ## The main-term pieces, with covering numbers -/

/-- **The unreflected low-frequency piece, with the covering number.** -/
theorem lintegral_brsMainFamily_zero_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_zero_le s hcov hφ hφcs hφ' hφdcs hA hA' hG
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

/-- **The reflected low-frequency piece, with the covering number.** -/
theorem lintegral_brsMainFamily_one_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_one_le s hcov hφ hφcs hφ' hφdcs hA hA' hG
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

/-- **The `m`-th Littlewood--Paley piece, with the covering number.** -/
theorem lintegral_brsMainFamily_succ_succ_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ q *
        ((intervalCoveringNumber E
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2)
      (-((1 + 3 + m : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_succ_succ_le m hcov hυeq hυ hcs hR hυ' hcs'
    hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
  rwa [hcard] at h


/-! ## One term of the main-term sum, in geometric form

The covering number and the kernel gain combine into a single dyadic power. -/

/-- **One term, in geometric form.** -/
theorem brsMain_geometric_term {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {C s q : ℝ} (_hC : 0 ≤ C) (hq : 0 < q) (j : ℕ) (G : ENNReal) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal (C * ((2 : ℝ) ^ (-(j : ℝ))) ^ s) * G) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * C *
        (2 : ℝ) ^ ((β / q - s) * (j : ℝ))) * G := by
  have hbase : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq), ENNReal.rpow_one,
    ← mul_assoc]
  refine mul_le_mul' ?_ le_rfl
  have hNb : ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal)) ^
      (1 / q) ≤ ENNReal.ofReal ((Cβ * (2 : ℝ) ^ (β * (j : ℝ))) ^ (1 / q)) := by
    refine le_trans (ENNReal.rpow_le_rpow (hN j) (by positivity)) (le_of_eq ?_)
    exact ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)
  refine le_trans (mul_le_mul' hNb le_rfl) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _)]
  congr 1
  have h2 : (0 : ℝ) < 2 := by norm_num
  have e1 : (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) ^ (1 / q) =
      Cβ ^ (1 / q) * (2 : ℝ) ^ (β * (j : ℝ) / q) := by
    rw [Real.mul_rpow hCβ (Real.rpow_nonneg h2.le _), ← Real.rpow_mul h2.le]
    congr 2
    field_simp
  have e2 : ((2 : ℝ) ^ (-(j : ℝ))) ^ s = (2 : ℝ) ^ (-(j : ℝ) * s) := by
    rw [← Real.rpow_mul h2.le]
  rw [e1, e2]
  calc Cβ ^ (1 / q) * (2 : ℝ) ^ (β * (j : ℝ) / q) * (C * (2 : ℝ) ^ (-(j : ℝ) * s))
      = Cβ ^ (1 / q) * C *
          ((2 : ℝ) ^ (β * (j : ℝ) / q) * (2 : ℝ) ^ (-(j : ℝ) * s)) := by ring
    _ = Cβ ^ (1 / q) * C * (2 : ℝ) ^ ((β / q - s) * (j : ℝ)) := by
        rw [← Real.rpow_add h2]
        congr 2
        ring


/-! ## Each term of the main-term sum, in geometric form -/

/-- A covering term with no dyadic gain. -/
theorem brsMain_covering_term {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {C q : ℝ} (hC : 0 ≤ C) (hq : 0 < q) (j : ℕ) (G : ENNReal) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal C * G) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * C *
        (2 : ℝ) ^ (β / q * (j : ℝ))) * G := by
  have h := brsMain_geometric_term hCβ hN (C := C) (s := 0) hC hq j G
  rw [Real.rpow_zero, mul_one, sub_zero] at h
  exact h

/-- **The unreflected low-frequency term.** -/
theorem brsMainFamily_zero_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (2 : ℝ) ^ (β / q * ((1 + s : ℕ) : ℝ))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : (0 : ℝ) ≤ (A + A') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_zero_covering hE s hφ hφcs hφ' hφdcs hA hA' hG hp
      hr hrq hpq hrel hr2) (by positivity)) ?_
  exact brsMain_covering_term hCβ hN hCnn hq0 (1 + s) _

/-- **The reflected low-frequency term.** -/
theorem brsMainFamily_one_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (2 : ℝ) ^ (β / q * ((1 + s : ℕ) : ℝ))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : (0 : ℝ) ≤ (A + A') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_one_covering hE s hφ hφcs hφ' hφdcs hA hA' hG hp
      hr hrq hpq hrel hr2) (by positivity)) ?_
  exact brsMain_covering_term hCβ hN hCnn hq0 (1 + s) _


/-! ## The high-frequency terms, in geometric form -/

/-- **The `m`-th Littlewood--Paley term of the main-term sum.** -/
theorem brsMainFamily_succ_succ_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
          (brsKernelConst Mu A N r ^ (1 / r) +
            brsKernelConst Mu' A' N r ^ (1 / r)) *
          (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((1 + 3 + m : ℕ) : ℝ)))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_succ_succ_covering hE m hυeq hυ hcs hR hυ' hcs'
      hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel)
    (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0), ENNReal.rpow_one]
  refine le_trans (mul_le_mul' le_rfl
    (brsMain_geometric_term hCβ hN hCLP hq0 (1 + 3 + m) _)) (le_of_eq ?_)
  rw [← mul_assoc]
  congr 1
  rw [show ((2 : ENNReal)) = ENNReal.ofReal 2 by simp,
    ← ENNReal.ofReal_mul (by norm_num)]


/-! ## The geometric series in `m` -/

/-- The high-frequency terms sum geometrically. -/
theorem tsum_geometric_shift {c a : ℝ} (hc : 0 ≤ c) (ha : a < 0) (d : ℕ) :
    (∑' m : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((d + m : ℕ) : ℝ)))) =
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * (d : ℝ)) /
        (1 - (2 : ℝ) ^ a)) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hterm : ∀ m : ℕ, c * (2 : ℝ) ^ (a * ((d + m : ℕ) : ℝ)) =
      (c * (2 : ℝ) ^ (a * (d : ℝ))) * (2 : ℝ) ^ (a * (m : ℝ)) := by
    intro m
    rw [mul_assoc, ← Real.rpow_add h2]
    congr 2
    push_cast
    ring
  simp only [hterm]
  refine tsum_ofReal_geometric ?_ ha
  have : (0 : ℝ) < (2 : ℝ) ^ (a * (d : ℝ)) := Real.rpow_pos_of_pos h2 _
  positivity


/-! ## The whole main-term sum -/

/-- **The sum over all the pieces of the main term.** -/
theorem brsMainFamily_tsum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∑' n : ℕ, (∫⁻ x : ℝ, brsMainFamily 3 φ e g E n x ^ q) ^ (1 / q)) ≤
      (ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
              (brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r))) *
            (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
              (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set G : ENNReal := (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)
    with hGdef
  set a : ℝ := β / q - (1 / r - 1 / 2) with hadef
  set c : ℝ := 2 * (Cβ ^ (1 / q) *
    (brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r))) with hcdef
  have hcnn : 0 ≤ c := by
    rw [hcdef]
    have : (0 : ℝ) ≤ Cβ ^ (1 / q) := Real.rpow_nonneg hCβ _
    positivity
  have hT0 := brsMainFamily_zero_term_le hE hCβ hN 3 hφ hφcs hφ' hφdcs hAφ hAφ'
    hG hp hr hrq hpq hrel hr2
  have hT1 := brsMainFamily_one_term_le hE hCβ hN 3 hφ hφcs hφ' hφdcs hAφ hAφ'
    hG hp hr hrq hpq hrel hr2
  have hTm : ∀ m : ℕ,
      (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 + m : ℕ) : ℝ))) * G := by
    intro m
    have h := brsMainFamily_succ_succ_term_le hE hCβ hN m hυeq hυ hcs hR hυ'
      hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
    have hidx : (1 + 3 + m : ℕ) = (4 + m : ℕ) := by omega
    rw [hidx] at h
    refine le_trans h (le_of_eq ?_)
    congr 2
    rw [hcdef, hadef]
    ring
  have hsum : (∑' m : ℕ,
      (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ a)) * G := by
    refine le_trans (ENNReal.tsum_le_tsum hTm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right, tsum_geometric_shift hcnn hMneg 4]
  rw [ennreal_tsum_eq_zero_add
      (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamily 3 φ e g E n x ^ q) ^ (1 / q)),
    ennreal_tsum_eq_zero_add
      (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (n + 1) x ^ q) ^ (1 / q))]
  refine le_trans (add_le_add hT0 (add_le_add hT1 hsum)) (le_of_eq ?_)
  ring


/-! ## The near part of `𝔐_p^-`, bounded

Everything is in place: the radial weight is a constant, the pieces are
summed by the countable Minkowski inequality, and the sum is geometric. -/

/-- **The near part of `𝔐_p^-` maps the weighted profile to `L^q(r dr)`.** -/
theorem lintegral_brsMainNearLeftAt_final {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∫⁻ x : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g x ^ q *
        ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ((ENNReal.ofReal (Cβ ^ (1 / q) *
              ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
              (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
            ENNReal.ofReal (Cβ ^ (1 / q) *
              ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
              (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
            ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
                (brsKernelConst Mu A N r ^ (1 / r) +
                  brsKernelConst Mu' A' N r ^ (1 / r))) *
              (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
                (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^
            (1 / p)) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  refine le_trans (lintegral_brsMainNear_Lp_le 3 hE hG hGbd hφ hφcs hφnorm
    hq1) ?_
  exact mul_le_mul' le_rfl
    (brsMainFamily_tsum_le hE hCβ hN hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs hR
      hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
      hr2 hMneg)


/-! ## The far part of `𝔐_p^-`

Away from the singularity the kernel is bounded, and the weight `s^{1/2-1/p}`
is exactly what turns the profile into `G`, so the far part is a plain Hölder
estimate.  The radius is bounded, so no dyadic gain is needed. -/

theorem measurable_brsWeightedProfile {e : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsWeightedProfile e g) := by
  refine Measurable.mul ?_ hg
  exact Complex.measurable_ofReal.comp (measurable_id.pow_const e)

/-- The integrand of the far part, with the weight absorbed. -/
theorem enorm_mainWeight_eq {e a : ℝ} {g : ℝ → ℂ} {s : ℝ} (hs0 : 0 ≤ s)
    (hsa : a ≤ s) :
    ‖((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ =
      ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile e g s‖ₑ := by
  have hwnn : (0 : ℝ) ≤ s ^ e := Real.rpow_nonneg hs0 _
  have hknn : (0 : ℝ) ≤ (s - a) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by linarith) _
  rw [brsWeightedProfile, enorm_mul, enorm_mul, ← mul_assoc]
  congr 1
  rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg hwnn,
    ← ENNReal.ofReal_mul hknn]
  congr 1
  ring

/-- **The pointwise bound for the far part of `𝔐_p^-`.** -/
theorem brsMainFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c) (r : ℝ) :
    brsMainFarLeftAt c E p g r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) *
        (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
    rw [sub_nonneg, div_le_one hp0]
    exact hp.le
  have hGmeas : Measurable (brsWeightedProfile (1 / 2 - 1 / p) g) :=
    measurable_brsWeightedProfile hg
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  rw [brsMainFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨hr23, hr4⟩ := brsMain_radius_bounds hE ht
  obtain ⟨-, ht1, ht2⟩ := ht
  have hrpos : (0 : ℝ) < r := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  have hba8 : b - a ≤ 8 := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
  set W : Set ℝ := Ioc a b ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  have hstep1 : ENNReal.ofReal ‖∫ s in a..b, (Ici (a + c)).indicator
      (fun s => ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a b, ‖(Ici (a + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a b
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hcon => h2 hcon.2),
            Set.indicator_of_notMem (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hcon => h1 hcon.1)]
    rw [hset]
    refine le_of_eq (setLIntegral_congr_fun hWmeas fun s hs => ?_)
    exact enorm_mainWeight_eq (le_trans hanonneg hs.1.1.le) hs.1.1.le
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
      ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have hle : (s - a) ^ (-(1 / 2) : ℝ) ≤ c ^ (-(1 / 2) : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hc (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal 8 := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal hba8
  have hstep3 : (∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      M * ENNReal.ofReal 8 ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hGmeas) ?_
    refine mul_le_mul' ?_ (ENNReal.rpow_le_rpow hvol hexp)
    exact ENNReal.rpow_le_rpow (setLIntegral_le_lintegral _ _) (by positivity)
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hrpos (by norm_num)]
    linarith
  have h8 : ENNReal.ofReal 8 ^ (1 - 1 / p) =
      ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)) :=
    ENNReal.ofReal_rpow_of_pos (by norm_num)
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, (Ici (a + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal r⁻¹ * ENNReal.ofReal ‖∫ s in a..b,
          (Ici (a + c)).indicator (fun s => ((s ^ (1 / 2 - 1 / p) *
            (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal (3 / 2 : ℝ) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            (M * ENNReal.ofReal 8 ^ (1 - 1 / p))) :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv)
          (le_trans hstep1 (le_trans hstep2 (mul_le_mul' le_rfl hstep3)))
    _ = ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * M := by
        rw [h8]
        rw [show ENNReal.ofReal (3 / 2 : ℝ) *
            (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              (M * ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)))) =
            (ENNReal.ofReal (3 / 2 : ℝ) * ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p))) * M from by ring]
        congr 1
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
          ← ENNReal.ofReal_mul (by positivity)]


/-! ## The radial `L^q` norm of the far part of `𝔐_p^-`

The pointwise bound is uniform in `r`, and the radius lives in `(2/3, 4)`, so
the radial integral only contributes a constant. -/

/-- **The far part of `𝔐_p^-` in `L^q(r dr)`.** -/
theorem lintegral_brsMainFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c)
    {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainFarLeftAt c E p g r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal 16 *
        (ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
            (8 : ℝ) ^ (1 - 1 / p)) *
          (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
            (1 / p)) ^ q := by
  set Cf : ℝ := (3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) * (8 : ℝ) ^ (1 - 1 / p)
    with hCf
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  have hpt : ∀ r : ℝ, brsMainFarLeftAt c E p g r ^ q * ENNReal.ofReal r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => (ENNReal.ofReal Cf * M) ^ q * ENNReal.ofReal 4) r := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      exact mul_le_mul'
        (ENNReal.rpow_le_rpow (brsMainFarLeftAt_le hE hp hg hc r) hq.le)
        (ENNReal.ofReal_le_ofReal hr.2.le)
    · rw [Set.indicator_of_notMem hr, brsMainFarLeftAt_eq_zero hE hr,
        ENNReal.zero_rpow_of_pos hq, zero_mul]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_indicator measurableSet_Ioo, setLIntegral_const,
    Real.volume_Ioo]
  rw [mul_assoc, ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
    mul_comm ((ENNReal.ofReal Cf * M) ^ q) _]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal (by norm_num)) le_rfl


/-! ## Measurable majorants for the two halves of `𝔐_p^-`

The maximal functions are indexed by a set depending on the radius, so as for
`R₂^±` the additivity of the integral is applied to majorants instead. -/

/-- The measurable majorant of the near part. -/
def brsMainNearMaj (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun r => ENNReal.ofReal r⁻¹ * ∑' n : ℕ, brsMainFamily s φ e g E n r) r

/-- The measurable majorant of the far part. -/
def brsMainFarMaj (p c : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun _ => ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p)) *
      (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p)) r

theorem measurable_brsMainNearMaj (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (e : ℝ) {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) (E : Set ℝ) :
    Measurable (brsMainNearMaj s φ e g E) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine Measurable.mul ?_ ?_
  · fun_prop
  · exact Measurable.ennreal_tsum fun n =>
      measurable_brsMainFamily s hφ hφcs e hG E n

theorem measurable_brsMainFarMaj (p c : ℝ) (g : ℝ → ℂ) :
    Measurable (brsMainFarMaj p c g) :=
  measurable_const.indicator measurableSet_Ioo

/-- **The majorant of the near part, in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearMaj_Lp_le (s : ℕ) {E : Set ℝ} {φ : ℝ → ℝ}
    (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ) {e : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearMaj s φ e g E r ^ q * ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamily s φ e g E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_main_weight_le
    (fun r => ∑' n : ℕ, brsMainFamily s φ e g E n r) hq0
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamily s hφ hφcs e hG E n)


/-! ## The far majorant, and the pointwise split into majorants -/

/-- A constant supported on the radial window costs a constant. -/
theorem lintegral_indicator_const_weight_le (C : ENNReal) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C) r) ^ q *
        ENNReal.ofReal r) ≤ ENNReal.ofReal 16 * C ^ q := by
  have hpt : ∀ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C) r) ^ q *
      ENNReal.ofReal r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C ^ q * ENNReal.ofReal 4) r := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
      exact mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal hr.2.le)
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq, zero_mul]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_indicator measurableSet_Ioo, setLIntegral_const,
    Real.volume_Ioo, mul_assoc,
    ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4), mul_comm (C ^ q) _]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal (by norm_num)) le_rfl

/-- **The far majorant in `L^q(r dr)`.** -/
theorem lintegral_brsMainFarMaj_le (p c : ℝ) (g : ℝ → ℂ) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainFarMaj p c g r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal 16 *
        (ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
            (8 : ℝ) ^ (1 - 1 / p)) *
          (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
            (1 / p)) ^ q :=
  lintegral_indicator_const_weight_le _ hq

/-- **`𝔐_p^-` is dominated by the two majorants.** -/
theorem brsMainTwoLeft_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg) (r : ℝ) :
    brsMainTwoLeft E p g r ≤
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E r +
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g r := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · have hrpos : (0 : ℝ) < r := by
      have := hr.1
      linarith
    rw [brsMainNearMaj, Set.indicator_of_mem hr, brsMainFarMaj,
      Set.indicator_of_mem hr]
    refine le_trans (brsMainTwoLeft_le_add_at ((2 : ℝ) ^ (-((1 : ℕ) : ℝ)))
      hp1 hgc hrpos) (add_le_add ?_ ?_)
    · have h := brsMainNearLeftAt_le_indicator 3 hE hG hGbd hφc hφcs hφnorm r
      rw [Set.indicator_of_mem hr] at h
      rw [← brsMainFamily_tsum 3 φ (1 / 2 - 1 / p) g E r]
      exact h
    · exact brsMainFarLeftAt_le hE hp1 hgc.measurable hc r
  · rw [brsMainTwoLeft_eq_zero hE hr]
    exact zero_le


/-! ## The pointwise splitting of `𝔐_p^-` into two measurable majorants -/

/-- **`𝔐_p^-` split, with the convexity factor.** -/
theorem brsMainTwoLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hle := brsMainTwoLeft_le_maj hE hp1 hgc hφc hφcs hφnorm hG hGbd x
  have hpow : brsMainTwoLeft E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q +
          brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          (brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q +
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q)) :=
        mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by ring


/-! ## Adding two majorants, with constants in `ℝ≥0∞` -/

/-- **Adding two majorants**, with the constants left in `ℝ≥0∞`. -/
theorem lintegral_rpow_le_of_two_bounds' {R Nm Fw : ℝ → ENNReal} {q : ℝ}
    (hq : 1 ≤ q)
    (hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x * Nm x ^ q)
    (hpt : ∀ x : ℝ, ENNReal.ofReal x * R x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Nm x ^ q) +
        (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Fw x ^ q))
    {CN CF G : ENNReal}
    (hNb : (∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q) ^ (1 / q) ≤ CN * G)
    (hFb : (∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q) ^ (1 / q) ≤ CF * G) :
    (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) * (CN + CF) * G := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hq1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  set X : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q with hX
  set Y : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q with hY
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hint : (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_add_left'
      (hNmeas.const_mul ((2 : ENNReal) ^ (q - 1))).aemeasurable]
    rw [lintegral_const_mul' _ _ htop, lintegral_const_mul' _ _ htop]
  refine le_trans (ENNReal.rpow_le_rpow hint (by positivity)) ?_
  have hsub : ((2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y) ^
      (1 / q) ≤ ((2 : ENNReal) ^ (q - 1) * X) ^ (1 / q) +
        ((2 : ENNReal) ^ (q - 1) * Y) ^ (1 / q) :=
    ENNReal.rpow_add_le_add_rpow _ _ (by positivity) hq1
  refine le_trans hsub ?_
  have hfac : ∀ Z : ENNReal, ((2 : ENNReal) ^ (q - 1) * Z) ^ (1 / q) =
      (2 : ENNReal) ^ ((q - 1) / q) * Z ^ (1 / q) := by
    intro Z
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul]
    congr 2
    field_simp
  rw [hfac, hfac]
  have hmain : (2 : ENNReal) ^ ((q - 1) / q) * X ^ (1 / q) +
      (2 : ENNReal) ^ ((q - 1) / q) * Y ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) * (CN * G + CF * G) := by
    rw [mul_add]
    exact add_le_add (mul_le_mul' le_rfl hNb) (mul_le_mul' le_rfl hFb)
  refine le_trans hmain (le_of_eq ?_)
  rw [← add_mul, ← mul_assoc]


/-! ## Proposition 5.5 for `𝔐_p^-` -/

/-- **Proposition 5.5 of BRS, for `𝔐_p^-`.**  Below the critical exponent —
that is, when the single geometric series in `m` converges — the main term maps
the weighted profile to the radial `L^q(r dr)` norm. -/
theorem prop55_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q r : ℝ} (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q) ^ (1 / q) ≤
        C * (∫⁻ z : ℝ,
          ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set Gp : ENNReal :=
    (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p)
    with hGp
  set K : ENNReal := ENNReal.ofReal (Cβ ^ (1 / q) *
      ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
      (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) with hK
  set Cgeo : ENNReal := ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
        (brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r))) *
      (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2)))) with hCgeo
  set CN : ENNReal := ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
    (K + K + Cgeo) with hCN
  -- the near majorant
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) ^ (1 / q) ≤ CN * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) =
        ∫⁻ x : ℝ, brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (lintegral_brsMainNearMaj_Lp_le 3 hφ hφcs hG hq1) ?_
    rw [hCN, mul_assoc]
    exact mul_le_mul' le_rfl
      (brsMainFamily_tsum_le hE hCβ hN hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs
        hRb hυ' hcs' hRb' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq
        hpq hrel hr2 hMneg)
  -- the far majorant
  have hFb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) =
        ∫⁻ x : ℝ, brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFarMaj_le p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g hq0)
      (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0),
      ENNReal.rpow_one, ← hGp]
    exact le_of_eq (mul_assoc _ _ _).symm
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q :=
    ENNReal.measurable_ofReal.mul
      ((measurable_brsMainNearMaj 3 hφ hφcs (1 / 2 - 1 / p) hG E).pow_const q)
  refine ⟨(2 : ENNReal) ^ ((q - 1) / q) * (CN +
    ENNReal.ofReal 16 ^ (1 / q) *
      ENNReal.ofReal ((3 / 2 : ℝ) *
        ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p))), ?_, ?_⟩
  · have h1 : (2 : ENNReal) ^ ((q - 1) / q) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) (by simp)
    have h2 : CN ≠ ⊤ := by
      rw [hCN]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.add_ne_top.mpr ⟨ENNReal.add_ne_top.mpr
          ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩,
          ENNReal.ofReal_ne_top⟩)
    have h3 : ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) ≠ ⊤ :=
      ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
        ENNReal.ofReal_ne_top
    exact ENNReal.mul_ne_top h1 (ENNReal.add_ne_top.mpr ⟨h2, h3⟩)
  · exact lintegral_rpow_le_of_two_bounds' hq1 hNmeas
      (fun x => brsMainTwoLeft_rpow_le hE hp1 hgc hφ.continuous hφcs hφnorm hG
        hGbd hq1 x) hNb hFb


/-! ## The near part of `𝔐_p^+`, identified

At the right endpoint the substitution `u = b - s` gives the plain convolution
evaluated at `b = r + t`.  Writing `r + t = -( (3-t) - r ) + 3` and reflecting
the profile about `3/2` puts it in the same shape as the left endpoint, with
the index set `3 - E`, which again lies in `[1,2]`. -/

/-- **The near part of `𝔐_p^+`, identified.** -/
theorem brsMainNearRightAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearRightAt c E p g r =
      ENNReal.ofReal r⁻¹ *
        ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ =>
              brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
              (3 - t - r)‖ₑ := by
  have hr : (0 : ℝ) < r := lt_of_lt_of_le hc hcr
  have hrinv : (0 : ℝ) ≤ r⁻¹ := by positivity
  have hidentify : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      (∫ s in |r - t|..(r + t), (Ioi (r + t - c)).indicator
          (fun s => ((s ^ (1 / 2 - 1 / p) *
            (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
          brsRefl (fun w : ℝ =>
            brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
            (3 - t - r) := by
    rintro t ⟨-, ht1, ht2⟩
    have hcb : |r - t| + c ≤ r + t := by
      rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
    rw [integral_mainNearPartRight_eq_conv hc hcb]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((r + t - u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (r + t - u))) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (fun w : ℝ =>
          brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (-(3 - t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((r + t - u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (r + t - u)) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (fun w : ℝ =>
          brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (-(3 - t - r) - u)
    rw [brsRefl_apply, brsWeightedProfile,
      show (3 : ℝ) - -(-(3 - t - r) - u) = r + t - u by ring]
  have hpt : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
          (Ioi (r + t - c)).indicator
            (fun s => ((s ^ (1 / 2 - 1 / p) *
              (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal r⁻¹ *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ =>
              brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
              (3 - t - r)‖ₑ := by
    intro t ht
    rw [ENNReal.ofReal_mul hrinv, ofReal_norm, hidentify t ht]
  rw [brsMainNearRightAt]
  rw [iSup_congr fun t => iSup_congr fun ht => hpt t ht]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## The near part of `𝔐_p^+`, decomposed

Unlike the left endpoint there is no window split: the singular point is always
`3 - t - r`, so only the reflected family occurs. -/

/-- **The near part of `𝔐_p^+`, decomposed into the pieces.** -/
theorem brsMainNearRightAt_le_pieces (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        (brsNearFullMax 1 (brsDilate φ (1 + s))
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r +
          ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [brsMainNearRightAt_eq hc hcr]
  refine mul_le_mul' le_rfl ?_
  refine iSup₂_le fun t ht => ?_
  have hmem : (3 - t) ∈ (fun x : ℝ => 3 - x) '' E := ⟨t, ht.1, rfl⟩
  refine le_trans (enorm_brsRefl_conv_le_pieces 1 s hH hHbd hφ hφcs hφnorm
    (3 - t - r)) ?_
  refine add_le_add (le_iSup₂_of_le (3 - t) hmem le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le (3 - t) hmem le_rfl


/-! ## The far part of `𝔐_p^+` -/

/-- The integrand of the far part at the right endpoint. -/
theorem enorm_mainWeightRight_eq {e b : ℝ} {g : ℝ → ℂ} {s : ℝ}
    (hs0 : 0 ≤ s) (hsb : s ≤ b) :
    ‖((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ =
      ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile e g s‖ₑ := by
  have hwnn : (0 : ℝ) ≤ s ^ e := Real.rpow_nonneg hs0 _
  have hknn : (0 : ℝ) ≤ (b - s) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by linarith) _
  rw [brsWeightedProfile, enorm_mul, enorm_mul, ← mul_assoc]
  congr 1
  rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg hwnn,
    ← ENNReal.ofReal_mul hknn]
  congr 1
  ring

/-- **The pointwise bound for the far part of `𝔐_p^+`.** -/
theorem brsMainFarRightAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c) (r : ℝ) :
    brsMainFarRightAt c E p g r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) *
        (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
    rw [sub_nonneg, div_le_one hp0]
    exact hp.le
  have hGmeas : Measurable (brsWeightedProfile (1 / 2 - 1 / p) g) :=
    measurable_brsWeightedProfile hg
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  rw [brsMainFarRightAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨hr23, hr4⟩ := brsMain_radius_bounds hE ht
  obtain ⟨-, ht1, ht2⟩ := ht
  have hrpos : (0 : ℝ) < r := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  have hba8 : b - a ≤ 8 := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
  set W : Set ℝ := Ioc a b ∩ Iic (b - c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in a..b, (Iic (b - c)).indicator
      (fun s => ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a b, ‖(Iic (b - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a b
      · by_cases h2 : s ≤ b - c
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hcon => h2 hcon.2),
            Set.indicator_of_notMem (show s ∉ Iic (b - c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hcon => h1 hcon.1)]
    rw [hset]
    refine le_of_eq (setLIntegral_congr_fun hWmeas fun s hs => ?_)
    exact enorm_mainWeightRight_eq (le_trans hanonneg hs.1.1.le) hs.1.2
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
      ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - c := hs.2
    have hle : (b - s) ^ (-(1 / 2) : ℝ) ≤ c ^ (-(1 / 2) : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hc (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal 8 := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal hba8
  have hstep3 : (∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      M * ENNReal.ofReal 8 ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hGmeas) ?_
    refine mul_le_mul' ?_ (ENNReal.rpow_le_rpow hvol hexp)
    exact ENNReal.rpow_le_rpow (setLIntegral_le_lintegral _ _) (by positivity)
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hrpos (by norm_num)]
    linarith
  have h8 : ENNReal.ofReal 8 ^ (1 - 1 / p) =
      ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)) :=
    ENNReal.ofReal_rpow_of_pos (by norm_num)
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, (Iic (b - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal r⁻¹ * ENNReal.ofReal ‖∫ s in a..b,
          (Iic (b - c)).indicator (fun s => ((s ^ (1 / 2 - 1 / p) *
            (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal (3 / 2 : ℝ) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            (M * ENNReal.ofReal 8 ^ (1 - 1 / p))) :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv)
          (le_trans hstep1 (le_trans hstep2 (mul_le_mul' le_rfl hstep3)))
    _ = ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * M := by
        rw [h8]
        rw [show ENNReal.ofReal (3 / 2 : ℝ) *
            (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              (M * ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)))) =
            (ENNReal.ofReal (3 / 2 : ℝ) * ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p))) * M from by ring]
        congr 1
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
          ← ENNReal.ofReal_mul (by positivity)]



/-! ## The family of pieces at the right endpoint

Only the reflected family occurs, so the indexing is by a single sequence: `0`
is the low-frequency piece and `m + 1` the `m`-th Littlewood--Paley piece.  The
profile is left free, since at the right endpoint it is the reflection of the
weighted profile. -/

/-- The pieces of `𝔐_p^+`. -/
def brsMainFamilyR (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ) (n : ℕ)
    (r : ℝ) : ENNReal :=
  match n with
  | 0 => brsNearFullMax 1 (brsDilate φ (1 + s)) H E r
  | (m + 1) => brsNearFullMax 1 (brsLPKernel φ (1 + s + m)) H E r

theorem brsMainFamilyR_zero (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamilyR s φ H E 0 r =
      brsNearFullMax 1 (brsDilate φ (1 + s)) H E r := rfl

theorem brsMainFamilyR_succ (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ)
    (m : ℕ) (r : ℝ) : brsMainFamilyR s φ H E (m + 1) r =
      brsNearFullMax 1 (brsLPKernel φ (1 + s + m)) H E r := rfl

theorem measurable_brsMainFamilyR (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) {H : ℝ → ℂ} (hH : Continuous H) (E : Set ℝ)
    (n : ℕ) : Measurable (brsMainFamilyR s φ H E n) := by
  match n with
  | 0 =>
      exact measurable_brsNearFullMax 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hH E
  | (m + 1) =>
      refine measurable_brsNearFullMax 1 ?_
        (hasCompactSupport_brsLPKernel hφcs _) hH E
      exact (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)

/-- **The near part of `𝔐_p^+`, bounded by the family.** -/
theorem brsMainNearRightAt_le_tsum (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ∑' n : ℕ, brsMainFamilyR s φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) n r := by
  refine le_trans (brsMainNearRightAt_le_pieces s hH hHbd hφ hφcs hφnorm hcr)
    (le_of_eq ?_)
  congr 1
  rw [ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamilyR s φ
    (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    ((fun x : ℝ => 3 - x) '' E) n r), brsMainFamilyR_zero]
  congr 1


/-! ## The pieces of `𝔐_p^+`, bounded

Only the reflected family occurs, so there is no convexity factor. -/

/-- **The low-frequency piece of `𝔐_p^+`.** -/
theorem lintegral_brsMainFamilyR_zero_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamilyR s φ H E 0 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hH hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _

/-- **The `m`-th Littlewood--Paley piece of `𝔐_p^+`.** -/
theorem lintegral_brsMainFamilyR_succ_le {E : Set ℝ} {ι : Finset ℝ} (m : ℕ)
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ι)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
              brsKernelConst Mu' A' N r ^ (1 / r)) *
            ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkj : 5 * (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap 1 m
    have heq : 1 + (m + 3) = 1 + 3 + m := by omega
    rw [heq] at h
    simpa using h
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hυ hcs hυ' hcs' (1 + 3 + m)
  have hfam : ∀ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x =
      brsNearFullMax 1 (brsDilate υ (1 + 3 + m)) H E x := by
    intro x
    rw [brsMainFamilyR_succ, hυeq]
  simp only [hfam]
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hH hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_5_9_bracket hυ hcs hRb hυ' hcs' hRb' hbd hA hAnn hbd' hA' hA'nn
    hmom hmom' hr hkj _


/-! ## The pieces of `𝔐_p^+`, with covering numbers and summed -/

theorem lintegral_brsMainFamilyR_zero_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamilyR s φ H E 0 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamilyR_zero_le s hcov hφ hφcs hφ' hφdcs hA hA' hH
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

theorem lintegral_brsMainFamilyR_succ_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ≤
      (intervalCoveringNumber E
          ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
              brsKernelConst Mu' A' N r ^ (1 / r)) *
            ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2)
      (-((1 + 3 + m : ℕ) : ℝ)))
  have h := lintegral_brsMainFamilyR_succ_le m hcov hυeq hυ hcs hRb hυ' hcs'
    hRb' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hH hp hr hrq hpq hrel
  rwa [hcard] at h

/-- **The whole sum for `𝔐_p^+`.** -/
theorem brsMainFamilyR_tsum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∑' n : ℕ, (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E n x ^ q) ^ (1 / q)) ≤
      (ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal ((Cβ ^ (1 / q) *
              (brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r))) *
            (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
              (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
        (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hAφnn : 0 ≤ Aφ := le_trans (integral_nonneg fun y => abs_nonneg _) hAφ
  have hAφ'nn : 0 ≤ Aφ' := le_trans (integral_nonneg fun y => abs_nonneg _) hAφ'
  have hClow : (0 : ℝ) ≤ (Aφ + Aφ') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set G : ENNReal := (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p) with hGdef
  set a : ℝ := β / q - (1 / r - 1 / 2) with hadef
  set c : ℝ := Cβ ^ (1 / q) *
    (brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r)) with hcdef
  have hcnn : 0 ≤ c := by
    rw [hcdef]
    have : (0 : ℝ) ≤ Cβ ^ (1 / q) := Real.rpow_nonneg hCβ _
    positivity
  have hT0 : (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E 0 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) *
        ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
        (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) * G := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFamilyR_zero_covering hE 3 hφ hφcs hφ' hφdcs hAφ hAφ' hH
        hp hr hrq hpq hrel hr2) (by positivity)) ?_
    exact brsMain_covering_term hCβ hN hClow hq0 (1 + 3) _
  have hTm : ∀ m : ℕ,
      (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 + m : ℕ) : ℝ))) * G := by
    intro m
    have h := ENNReal.rpow_le_rpow
      (lintegral_brsMainFamilyR_succ_covering hE m hυeq hυ hcs hRb hυ' hcs' hRb'
        hbd hA hAnn hbd' hA' hA'nn hmom hmom' hH hp hr hrq hpq hrel)
      (by positivity : (0 : ℝ) ≤ 1 / q)
    refine le_trans h ?_
    have h2 := brsMain_geometric_term (s := 1 / r - 1 / 2) hCβ hN hCLP hq0
      (1 + 3 + m) G
    refine le_trans h2 (le_of_eq ?_)
    have hidx : (1 + 3 + m : ℕ) = (4 + m : ℕ) := by omega
    rw [hidx, hcdef, hadef]
  have hsum : (∑' m : ℕ,
      (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ a)) * G := by
    refine le_trans (ENNReal.tsum_le_tsum hTm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right, tsum_geometric_shift hcnn hMneg 4]
  rw [ennreal_tsum_eq_zero_add
    (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E n x ^ q) ^ (1 / q))]
  refine le_trans (add_le_add hT0 hsum) (le_of_eq ?_)
  rw [← add_mul]


/-! ## The near majorant at the right endpoint -/

/-- The measurable majorant of the near part of `𝔐_p^+`. -/
def brsMainNearMajR (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun r => ENNReal.ofReal r⁻¹ * ∑' n : ℕ, brsMainFamilyR s φ H E n r) r

theorem measurable_brsMainNearMajR (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) {H : ℝ → ℂ} (hH : Continuous H) (E : Set ℝ) :
    Measurable (brsMainNearMajR s φ H E) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine Measurable.mul ?_ ?_
  · fun_prop
  · exact Measurable.ennreal_tsum fun n =>
      measurable_brsMainFamilyR s hφ hφcs hH E n

/-- **The near majorant of `𝔐_p^+`, in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearMajR_Lp_le (s : ℕ) {E : Set ℝ} {φ : ℝ → ℝ}
    (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ) {H : ℝ → ℂ}
    (hH : Continuous H) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearMajR s φ H E r ^ q * ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamilyR s φ H E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_main_weight_le
    (fun r => ∑' n : ℕ, brsMainFamilyR s φ H E n r) hq0
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamilyR s hφ hφcs hH E n)

/-- **The near part of `𝔐_p^+`, with the radial cutoff made explicit.** -/
theorem brsMainNearRightAt_le_indicator (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      brsMainNearMajR s φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [brsMainNearMajR, Set.indicator_of_mem hr]
    have hhalf : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = 1 / 2 := by norm_num
    have hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r := by
      rw [hhalf]
      linarith [hr.1]
    exact brsMainNearRightAt_le_tsum s hH hHbd hφ hφcs hφnorm hcr
  · rw [brsMainNearMajR, Set.indicator_of_notMem hr,
      brsMainNearRightAt_eq_zero hE hr]


/-! ## The pointwise split of `𝔐_p^+` -/

/-- **`𝔐_p^+` is dominated by the two majorants.** -/
theorem brsMainTwoRight_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    (r : ℝ) :
    brsMainTwoRight E p g r ≤
      brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) r +
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g r := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · have hrpos : (0 : ℝ) < r := by
      have := hr.1
      linarith
    refine le_trans (brsMainTwoRight_le_add_at ((2 : ℝ) ^ (-((1 : ℕ) : ℝ)))
      hp1 hgc hrpos) (add_le_add ?_ ?_)
    · exact brsMainNearRightAt_le_indicator 3 hE hH hHbd hφc hφcs hφnorm r
    · rw [brsMainFarMaj, Set.indicator_of_mem hr]
      exact brsMainFarRightAt_le hE hp1 hgc.measurable hc r
  · rw [brsMainTwoRight_eq_zero hE hr]
    exact zero_le

/-- **`𝔐_p^+` split, with the convexity factor.** -/
theorem brsMainTwoRight_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsMainTwoRight E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainNearMajR 3 φ
              (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
              ((fun x : ℝ => 3 - x) '' E) x ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hle := brsMainTwoRight_le_maj hE hp1 hgc hφc hφcs hφnorm hH hHbd x
  have hpow : brsMainTwoRight E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (brsMainNearMajR 3 φ
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) x ^ q +
          brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsMainTwoRight E p g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          (brsMainNearMajR 3 φ
              (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
              ((fun x : ℝ => 3 - x) '' E) x ^ q +
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q)) :=
        mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainNearMajR 3 φ
                (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
                ((fun x : ℝ => 3 - x) '' E) x ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by ring


/-! ## Proposition 5.5 for `𝔐_p^+` -/

/-- **Proposition 5.5 of BRS, for `𝔐_p^+`.** -/
theorem prop55_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {q r : ℝ} (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsMainTwoRight E p g x ^ q) ^ (1 / q) ≤
        C * (∫⁻ z : ℝ,
          ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set Gp : ENNReal :=
    (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p)
    with hGp
  set K : ENNReal := ENNReal.ofReal (Cβ ^ (1 / q) *
      ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
      (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) with hK
  set Cgeo : ENNReal := ENNReal.ofReal ((Cβ ^ (1 / q) *
        (brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r))) *
      (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2)))) with hCgeo
  set CN : ENNReal := ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
    (K + Cgeo) with hCN
  have hnorm : (∫⁻ z : ℝ,
      ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ₑ ^ p) =
      ∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p :=
    lintegral_enorm_comp_three_sub _ p
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainNearMajR 3 φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) x ^ q) ^ (1 / q) ≤ CN * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) x ^ q) =
        ∫⁻ x : ℝ, brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (lintegral_brsMainNearMajR_Lp_le 3 hφ hφcs hH hq1) ?_
    have hsum := brsMainFamilyR_tsum_le (image_three_sub_subset_Icc hE) hCβ hN
      hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs hRb hυ' hcs' hRb' hbd hA hAnn hbd'
      hA' hA'nn hmom hmom' hH hp hr hrq hpq hrel hr2 hMneg
    rw [hnorm] at hsum
    rw [hCN, mul_assoc]
    exact mul_le_mul' le_rfl hsum
  have hFb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) =
        ∫⁻ x : ℝ, brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFarMaj_le p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g hq0)
      (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0),
      ENNReal.rpow_one, ← hGp]
    exact le_of_eq (mul_assoc _ _ _).symm
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      brsMainNearMajR 3 φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) x ^ q :=
    ENNReal.measurable_ofReal.mul
      ((measurable_brsMainNearMajR 3 hφ hφcs hH _).pow_const q)
  refine ⟨(2 : ENNReal) ^ ((q - 1) / q) * (CN +
    ENNReal.ofReal 16 ^ (1 / q) *
      ENNReal.ofReal ((3 / 2 : ℝ) *
        ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p))), ?_, ?_⟩
  · have h1 : (2 : ENNReal) ^ ((q - 1) / q) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) (by simp)
    have h2 : CN ≠ ⊤ := by
      rw [hCN]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩)
    have h3 : ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) ≠ ⊤ :=
      ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
        ENNReal.ofReal_ne_top
    exact ENNReal.mul_ne_top h1 (ENNReal.add_ne_top.mpr ⟨h2, h3⟩)
  · exact lintegral_rpow_le_of_two_bounds' hq1 hNmeas
      (fun x => brsMainTwoRight_rpow_le hE hp1 hgc hφ.continuous hφcs hφnorm hH
        hHbd hq1 x) hNb hFb


/-! ## Covering numbers at two scales

Refining a coarse cover interval by interval bounds the fine covering number by
the sum of the localized ones.  This is what turns the Assouad-spectrum bound
(2.2), which is local, into a global statement, and is the combinatorial step
behind the endpoint estimate. -/

/-- **The two-scale covering inequality.** -/
theorem intervalCoveringNumber_le_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ} (hcov : IsIntervalCover E Δ ι) :
    intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ := by
  classical
  choose ιa hιa hcarda using fun a : ℝ =>
    exists_intervalCover_card_eq_intervalCoveringNumber
      (E := E ∩ Icc (a - Δ / 2) (a + Δ / 2))
      (Set.inter_subset_left.trans hE) hδ
  have hcov' : IsIntervalCover E δ (ι.biUnion ιa) := by
    intro x hx
    obtain ⟨a, ha, hxa⟩ := Set.mem_iUnion₂.mp (hcov hx)
    obtain ⟨b, hb, hxb⟩ := Set.mem_iUnion₂.mp (hιa a ⟨hx, hxa⟩)
    exact Set.mem_iUnion₂.mpr ⟨b, Finset.mem_biUnion.mpr ⟨a, ha, hb⟩, hxb⟩
  calc intervalCoveringNumber E δ ≤ (ι.biUnion ιa).card :=
        intervalCoveringNumber_le_card hcov'
    _ ≤ ∑ a ∈ ι, (ιa a).card := Finset.card_biUnion_le
    _ = ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
        Finset.sum_congr rfl fun a _ => hcarda a


/-! ## Sub-multiplicativity of the covering numbers

Bounding each localized covering number by a common `M` turns the two-scale
inequality into `N(E, δ) ≤ N(E, Δ) · M`.  Iterating this is what produces the
Legendre transform. -/

/-- **The two-scale inequality, with a uniform local bound.** -/
theorem intervalCoveringNumber_le_mul {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ} (hcov : IsIntervalCover E Δ ι)
    {M : ℕ}
    (hM : ∀ a ∈ ι, intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤ M) :
    intervalCoveringNumber E δ ≤ ι.card * M := by
  refine le_trans (intervalCoveringNumber_le_sum hE hδ hcov) ?_
  calc (∑ a ∈ ι, intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ) ≤ ∑ _a ∈ ι, M :=
        Finset.sum_le_sum hM
    _ = ι.card * M := by
        rw [Finset.sum_const, smul_eq_mul]

/-- **Sub-multiplicativity of the covering numbers.** -/
theorem intervalCoveringNumber_submul {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hΔ : 0 < Δ) (hδ : 0 < δ) {M : ℕ}
    (hM : ∀ a : ℝ, intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤ M) :
    intervalCoveringNumber E δ ≤ intervalCoveringNumber E Δ * M := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ
  have h := intervalCoveringNumber_le_mul hE hδ hcov (fun a _ => hM a)
  rwa [hcard] at h


/-! ## Clipping a window to `[1,2]`

The Assouad bound (2.2) is stated for intervals inside `[1,2]`, while the
intervals of a cover of `E` need not be.  Since `E ⊆ [1,2]`, clipping changes
nothing. -/

theorem inter_Icc_clip {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (u v : ℝ) :
    E ∩ Icc u v = E ∩ Icc (max u 1) (min v 2) := by
  ext x
  constructor
  · rintro ⟨hx, hu, hv⟩
    exact ⟨hx, max_le hu (hE hx).1, le_min hv (hE hx).2⟩
  · rintro ⟨hx, hu, hv⟩
    exact ⟨hx, le_trans (le_max_left _ _) hu, le_trans hv (min_le_left _ _)⟩

theorem intervalCoveringNumber_empty (δ : ℝ) :
    intervalCoveringNumber (∅ : Set ℝ) δ = 0 := by
  have hcov : IsIntervalCover (∅ : Set ℝ) δ (∅ : Finset ℝ) := by
    intro x hx
    exact absurd hx (Set.notMem_empty x)
  exact Nat.le_zero.mp (intervalCoveringNumber_le_card hcov)

/-- **The localized covering bound.**  On any window of length `Δ ≥ δ^θ` the
Assouad bound applies after clipping; on the leftover the trivial bound does. -/
theorem intervalCoveringNumber_window_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ : 0 < Δ) (a : ℝ) :
    (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ) ≤
      C * (Δ / δ) ^ γ' + (Δ / δ + 3) := by
  set u : ℝ := max (a - Δ / 2) 1 with hu
  set v : ℝ := min (a + Δ / 2) 2 with hv
  have hclip : E ∩ Icc (a - Δ / 2) (a + Δ / 2) = E ∩ Icc u v :=
    inter_Icc_clip hE _ _
  have hCnn : (0 : ℝ) ≤ C * (Δ / δ) ^ γ' := by
    have : (0 : ℝ) ≤ (Δ / δ) ^ γ' := Real.rpow_nonneg (by positivity) _
    positivity
  have htriv : (0 : ℝ) ≤ Δ / δ + 3 := by positivity
  rcases le_or_gt u v with huv | huv
  · have hlen : v - u ≤ Δ := by
      rw [hu, hv]
      rcases max_cases (a - Δ / 2) (1 : ℝ) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
        rcases min_cases (a + Δ / 2) (2 : ℝ) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
        rw [h1, h2] <;> linarith
    rcases le_or_gt (δ ^ θ) (v - u) with hcase | hcase
    · have hbound := hass δ u v hδ hδ1 (le_max_right _ _) huv
        (min_le_right _ _) hcase
      rw [hclip]
      refine le_trans hbound ?_
      have hmono : ((v - u) / δ) ^ γ' ≤ (Δ / δ) ^ γ' :=
        Real.rpow_le_rpow (by positivity)
          (div_le_div_of_nonneg_right hlen hδ.le) hγ'
      nlinarith [hmono, hCpos]
    · have hbound := brs_cover_bound_trivial (E := E) hδ huv
      rw [hclip]
      refine le_trans hbound ?_
      have : (v - u) / δ ≤ Δ / δ := div_le_div_of_nonneg_right hlen hδ.le
      linarith
  · have hempty : E ∩ Icc u v = ∅ := by
      rw [Set.Icc_eq_empty (not_le.mpr huv), Set.inter_empty]
    rw [hclip, hempty, intervalCoveringNumber_empty]
    simp only [Nat.cast_zero]
    linarith


/-! ## Sub-multiplicativity from the Assouad spectrum

Refining a `Δ`-cover of `E` by the Assouad bound on each window gives
`N(E, δ) ≲ N(E, Δ) · (Δ/δ)^{γ'}`.  Taking `Δ = δ^θ` this is the recursion whose
optimisation over `θ` is the Legendre transform `ν♯`. -/

/-- **Sub-multiplicativity with the Assouad exponent.** -/
theorem intervalCoveringNumber_assouad_submul {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ : 0 < Δ) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E Δ : ℝ) *
        (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ
  have h1 : intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
    intervalCoveringNumber_le_sum hE hδ hcov
  have h2 : ((intervalCoveringNumber E δ : ℕ) : ℝ) ≤
      ∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) := by
    exact_mod_cast h1
  refine le_trans h2 ?_
  have h3 : ∀ a ∈ ι, ((intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) ≤
      C * (Δ / δ) ^ γ' + (Δ / δ + 3) := fun a _ =>
    intervalCoveringNumber_window_le hE hCpos hγ' hass hδ hδ1 hΔ a
  calc (∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ))
      ≤ ∑ _a ∈ ι, (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := Finset.sum_le_sum h3
    _ = (ι.card : ℝ) * (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E Δ : ℝ) *
          (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by rw [hcard]

/-- **The recursion at `Δ = δ^θ`.** -/
theorem intervalCoveringNumber_assouad_step {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E (δ ^ θ) : ℝ) *
        (C * (δ ^ (θ - 1)) ^ γ' + (δ ^ (θ - 1) + 3)) := by
  have hδθ : (0 : ℝ) < δ ^ θ := Real.rpow_pos_of_pos hδ _
  have hratio : δ ^ θ / δ = δ ^ (θ - 1) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
  have h := intervalCoveringNumber_assouad_submul hE hCpos hγ' hass hδ hδ1 hδθ
  rwa [hratio] at h


/-! ## Sliding a window into `[1,2]`

Clipping a window to `[1,2]` can shorten it below `δ^θ`, which would cost the
trivial bound; sliding it instead keeps the length exactly `Δ`, so the Assouad
bound applies to every window with no leftover term. -/

/-- Every window of length `Δ ≤ 1` can be slid into `[1,2]` without losing any
of `E`. -/
theorem exists_window_in_Icc {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {Δ : ℝ}
    (_hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1) (a : ℝ) :
    ∃ u : ℝ, 1 ≤ u ∧ u + Δ ≤ 2 ∧
      E ∩ Icc (a - Δ / 2) (a + Δ / 2) ⊆ E ∩ Icc u (u + Δ) := by
  set w : ℝ := max (a - Δ / 2) 1 with hw
  have hw1 : (1 : ℝ) ≤ w := le_max_right _ _
  refine ⟨max 1 (min w (2 - Δ)), le_max_left _ _, ?_, ?_⟩
  · have h1 : (1 : ℝ) ≤ 2 - Δ := by linarith
    have h2 : max 1 (min w (2 - Δ)) ≤ 2 - Δ :=
      max_le h1 (min_le_right _ _)
    linarith
  · rintro x ⟨hxE, hx1, hx2⟩
    obtain ⟨hxa, hxb⟩ := hE hxE
    have hwx : w ≤ x := by
      rw [hw]
      exact max_le hx1 hxa
    refine ⟨hxE, ?_, ?_⟩
    · exact max_le hxa (le_trans (min_le_left _ _) hwx)
    · rcases le_or_gt w (2 - Δ) with hcase | hcase
      · have hmin : min w (2 - Δ) = w := min_eq_left hcase
        have hmax : max 1 (min w (2 - Δ)) = w := by
          rw [hmin]
          exact max_eq_right hw1
        rw [hmax, hw]
        rcases max_cases (a - Δ / 2) (1 : ℝ) with ⟨h1, _⟩ | ⟨h1, h2⟩
        · rw [h1]
          linarith
        · rw [h1]
          linarith
      · have hmin : min w (2 - Δ) = 2 - Δ := min_eq_right hcase.le
        have hmax : max 1 (min w (2 - Δ)) = 2 - Δ := by
          rw [hmin]
          exact max_eq_right (by linarith)
        rw [hmax]
        linarith

/-- **The localized covering bound, with no leftover term.** -/
theorem intervalCoveringNumber_window_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {θ γ' C : ℝ}
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1)
    (hΔθ : δ ^ θ ≤ Δ) (a : ℝ) :
    (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ) ≤
      C * (Δ / δ) ^ γ' := by
  obtain ⟨u, hu1, hu2, hsub⟩ := exists_window_in_Icc hE hΔ0 hΔ1 a
  have hmono : intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤
      intervalCoveringNumber (E ∩ Icc u (u + Δ)) δ :=
    intervalCoveringNumber_mono_set hsub (Set.inter_subset_left.trans hE) hδ
  have hbound := hass δ u (u + Δ) hδ hδ1 hu1 (by linarith) hu2
    (by simpa using hΔθ)
  simp only [add_sub_cancel_left] at hbound
  calc (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ)
      ≤ (intervalCoveringNumber (E ∩ Icc u (u + Δ)) δ : ℝ) := by
        exact_mod_cast hmono
    _ ≤ C * (Δ / δ) ^ γ' := hbound


/-! ## The improved covering exponent

Refining a `δ^θ`-cover by the Assouad bound gives
`N(E, δ) ≲ δ^{-(θ(β+ε) + (1-θ)γ')}`, an improvement on the Minkowski exponent
`β + ε` whenever the Assouad spectrum is smaller.  This is what converts the
borderline divergence at the endpoint into convergence. -/

/-- **Sharp sub-multiplicativity.** -/
theorem intervalCoveringNumber_assouad_submul' {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ}
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1)
    (hΔθ : δ ^ θ ≤ Δ) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E Δ : ℝ) * (C * (Δ / δ) ^ γ') := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ0
  have h1 : intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
    intervalCoveringNumber_le_sum hE hδ hcov
  have h2 : ((intervalCoveringNumber E δ : ℕ) : ℝ) ≤
      ∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) := by
    exact_mod_cast h1
  refine le_trans h2 ?_
  have h3 : ∀ a ∈ ι, ((intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) ≤ C * (Δ / δ) ^ γ' :=
    fun a _ => intervalCoveringNumber_window_le' hE hass hδ hδ1 hΔ0 hΔ1 hΔθ a
  calc (∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ))
      ≤ ∑ _a ∈ ι, (C * (Δ / δ) ^ γ') := Finset.sum_le_sum h3
    _ = (ι.card : ℝ) * (C * (Δ / δ) ^ γ') := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E Δ : ℝ) * (C * (Δ / δ) ^ γ') := by rw [hcard]

/-- **The improved covering bound.** -/
theorem brs_cover_bound_improved {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {β : ℝ} (hβ : HasUpperMinkowskiExponent E β) {ε : ℝ} (hε : 0 < ε)
    {θ γ' : ℝ} (hθ0 : 0 < θ)
    (hθγ : HasUpperAssouadSpectrumExponent E θ γ') :
    ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 →
      (intervalCoveringNumber E δ : ℝ) ≤
        C * δ ^ (-(θ * (β + ε) + (1 - θ) * γ')) := by
  obtain ⟨C₁, hC₁, hmink⟩ := brs_cover_bound_minkowski hβ hε
  obtain ⟨C₂, hC₂, hass⟩ := brs_cover_bound_assouad hθγ
  refine ⟨C₁ * C₂, by positivity, fun δ hδ hδ1 => ?_⟩
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hδθ0 : (0 : ℝ) < δ ^ θ := Real.rpow_pos_of_pos hδ _
  have hδθ1 : δ ^ θ < 1 := Real.rpow_lt_one hδ.le hδ1 hθ0
  have hstep := intervalCoveringNumber_assouad_submul' hE hass hδ hδ1 hδθ0
    hδθ1.le le_rfl
  have hcoarse : (intervalCoveringNumber E (δ ^ θ) : ℝ) ≤
      C₁ * (δ ^ θ) ^ (-(β + ε)) := by
    have h := hmink (δ ^ θ) hδθ0 hδθ1 Set.univ
    rwa [Set.inter_univ] at h
  have hratio : δ ^ θ / δ = δ ^ (θ - 1) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
  have hpos : (0 : ℝ) ≤ C₂ * (δ ^ θ / δ) ^ γ' := by
    have : (0 : ℝ) ≤ (δ ^ θ / δ) ^ γ' :=
      Real.rpow_nonneg (by positivity) _
    positivity
  refine le_trans hstep ?_
  refine le_trans (mul_le_mul_of_nonneg_right hcoarse hpos) (le_of_eq ?_)
  rw [hratio, ← Real.rpow_mul hδ.le, ← Real.rpow_mul hδ.le]
  rw [show C₁ * δ ^ (θ * -(β + ε)) * (C₂ * δ ^ ((θ - 1) * γ')) =
      C₁ * C₂ * (δ ^ (θ * -(β + ε)) * δ ^ ((θ - 1) * γ')) from by ring]
  rw [← Real.rpow_add hδ]
  congr 2
  ring

/-! ## From a continuous covering bound to the dyadic hypothesis

Propositions 5.5 and 5.6 consume the covering estimate in the dyadic form
`N(E, 2^{-j}) ≤ Cβ · 2^{βj}`.  Any bound valid for all `δ ∈ (0,1)` gives it,
once the scale `δ = 1` is handled separately. -/

theorem intervalCoveringNumber_one_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    intervalCoveringNumber E 1 ≤ 1 := by
  have hcov : IsIntervalCover E 1 {(3 / 2 : ℝ)} := by
    intro x hx
    obtain ⟨h1, h2⟩ := hE hx
    refine Set.mem_iUnion₂.mpr ⟨3 / 2, Finset.mem_singleton_self _, ?_⟩
    constructor <;> norm_num <;> linarith
  simpa using intervalCoveringNumber_le_card hcov

/-- **A continuous covering bound gives the dyadic hypothesis.** -/
theorem brs_cover_dyadic_of_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {C β' : ℝ} (_hC : 0 < C) (_hβ' : 0 ≤ β')
    (hbound : ∀ δ : ℝ, 0 < δ → δ < 1 →
      (intervalCoveringNumber E δ : ℝ) ≤ C * δ ^ (-β')) (j : ℕ) :
    (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (max C 1 * (2 : ℝ) ^ (β' * (j : ℝ))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hCmax : C ≤ max C 1 := le_max_left _ _
  have h1max : (1 : ℝ) ≤ max C 1 := le_max_right _ _
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (β' * (j : ℝ)) := Real.rpow_pos_of_pos h2 _
  have hreal : (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ℝ) ≤
      max C 1 * (2 : ℝ) ^ (β' * (j : ℝ)) := by
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · have hone : (2 : ℝ) ^ (-((0 : ℕ) : ℝ)) = 1 := by norm_num
      rw [hone]
      have h := intervalCoveringNumber_one_le hE
      have hcast : (intervalCoveringNumber E 1 : ℝ) ≤ 1 := by
        exact_mod_cast h
      have hpow0 : (2 : ℝ) ^ (β' * ((0 : ℕ) : ℝ)) = 1 := by
        norm_num
      rw [hpow0, mul_one]
      linarith
    · have hδ0 : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos h2 _
      have hjpos : (0 : ℝ) < (j : ℝ) := by exact_mod_cast hj
      have hδ1 : (2 : ℝ) ^ (-(j : ℝ)) < 1 := by
        refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
        linarith
      have h := hbound _ hδ0 hδ1
      have heq : ((2 : ℝ) ^ (-(j : ℝ))) ^ (-β') = (2 : ℝ) ^ (β' * (j : ℝ)) := by
        rw [← Real.rpow_mul h2.le]
        congr 1
        ring
      rw [heq] at h
      refine le_trans h ?_
      exact mul_le_mul_of_nonneg_right hCmax hpow.le
  calc (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal)
      = ENNReal.ofReal
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ℝ)) := by
        rw [ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal (max C 1 * (2 : ℝ) ^ (β' * (j : ℝ))) :=
        ENNReal.ofReal_le_ofReal hreal

/-! ## BRS Proposition 5.5(i): the near operator `𝔐_{p,0}^±` for `p > 2`

The `s`-integral in `𝔐_p^±` is split at `s = 2|r - t|`; the far half is the
two-dimensional `𝔐_p` of §4, and the near half is `𝔐_{p,0}^±`.  For `p > 2`
the near half needs nothing about `E` at all: the weight
`s^{1/2 - 1/p}(s - |r-t|)^{-1/2}` lies in `L^{p'}` of the near window precisely
because `p' < 2`, and Hölder gives the bound `|r-t|^{1 - 2/p}‖g‖_p`. -/

/-- The shifted power integral over the near window. -/
theorem lintegral_shifted_rpow_Ioc {a c : ℝ} (ha : 0 < a) (hc : -1 < c) :
    (∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ((s - a) ^ c)) =
      ENNReal.ofReal (a ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hab : a ≤ 2 * a := by linarith
  have hint0 : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 a :=
    intervalIntegral.intervalIntegrable_rpow' hc
  have hint : IntervalIntegrable (fun s : ℝ => (s - a) ^ c) volume a (2 * a) := by
    have h := hint0.comp_sub_right a
    simpa [zero_add, show a + a = 2 * a from by ring] using h
  have hval : (∫ s in a..(2 * a), (s - a) ^ c) = a ^ (c + 1) / (c + 1) := by
    have hshift : (∫ s in a..(2 * a), (s - a) ^ c) =
        ∫ x in (0 : ℝ)..a, x ^ c := by
      have h := intervalIntegral.integral_comp_sub_right
        (a := a) (b := 2 * a) (f := fun x : ℝ => x ^ c) a
      simpa [sub_self, show 2 * a - a = a from by ring] using h
    rw [hshift, integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
    simp
  rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
    lintegral_Ioo_eq_ofReal_intervalIntegral hab hint
      (fun s hs => Real.rpow_nonneg (by linarith [hs.1]) _), hval]

/-- The constant in BRS Proposition 5.5(i). -/
def brsZeroConst (p : ℝ) : ℝ :=
  (2 : ℝ) ^ (1 / 2 - 1 / p) *
    (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p)

theorem brsZeroConst_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsZeroConst p := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : Real.conjExponent p < 2 := by
    rw [Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hden : (0 : ℝ) < 1 - Real.conjExponent p / 2 := by linarith
  rw [brsZeroConst]
  have h1 : (0 : ℝ) < (2 : ℝ) ^ (1 / 2 - 1 / p) := Real.rpow_pos_of_pos (by norm_num) _
  have h2 : (0 : ℝ) < (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p) :=
    Real.rpow_pos_of_pos (by positivity) _
  positivity

/-- **The Hölder estimate behind BRS Proposition 5.5(i).** -/
theorem lintegral_mainZero_weight_le {p : ℝ} (hp2 : 2 < p) {a : ℝ} (ha : 0 < a)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc a (2 * a),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsZeroConst p * a ^ (1 - 2 / p)) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : p' < 2 := by
    rw [hp'def, Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hinvp' : 1 / p' = 1 - 1 / p := by
    rw [hp'def, Real.conjExponent]
    have hpne : p ≠ 0 := hp0.ne'
    have hp1ne : p - 1 ≠ 0 := by
      intro hcon
      rw [sub_eq_zero] at hcon
      exact absurd hcon.symm hp1.ne
    field_simp
  set κ : ℝ := 1 / 2 - 1 / p with hκ
  have hκ0 : 0 < κ := by
    rw [hκ]
    have : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num)]
      linarith
    linarith
  have hden : (0 : ℝ) < 1 - p' / 2 := by linarith
  -- the weight, and its `L^{p'}` norm on the near window
  set w : ℝ → ℝ := fun s => s ^ κ * (s - a) ^ (-(1 / 2) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  have hWle : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal (w s)) ^ p') ≤
      ENNReal.ofReal ((2 * a) ^ (κ * p')) *
        ENNReal.ofReal (a ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have hstep : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal (w s)) ^ p') ≤
        ∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ((2 * a) ^ (κ * p')) *
          ENNReal.ofReal ((s - a) ^ (-(p' / 2))) := by
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hs0 : 0 < s := lt_trans ha hs.1
      have hsa : 0 < s - a := by linarith [hs.1]
      have hpt : (ENNReal.ofReal (w s)) ^ p' =
          ENNReal.ofReal (s ^ (κ * p') * (s - a) ^ (-(p' / 2))) := by
        rw [hw]
        simp only
        rw [ENNReal.ofReal_rpow_of_pos (by positivity :
          (0 : ℝ) < s ^ κ * (s - a) ^ (-(1 / 2) : ℝ))]
        congr 1
        rw [Real.mul_rpow (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hsa.le _),
          ← Real.rpow_mul hs0.le, ← Real.rpow_mul hsa.le]
        have hexp : -(1 / 2 : ℝ) * p' = -(p' / 2) := by ring
        rw [hexp]
      rw [hpt, ENNReal.ofReal_mul (Real.rpow_nonneg hs0.le _)]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact Real.rpow_le_rpow hs0.le hs.2 (by positivity)
    refine le_trans hstep (le_of_eq ?_)
    rw [lintegral_const_mul _ (by fun_prop),
      lintegral_shifted_rpow_Ioc ha (by linarith : (-1 : ℝ) < -(p' / 2))]
    congr 2
    ring
  -- Hölder
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Ioc a (2 * a))) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow hWle (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  -- the constant
  have hp'ne : p' ≠ 0 := hp'pos.ne'
  have hXpos : (0 : ℝ) <
      ((2 : ℝ) * a) ^ (κ * p') * (a ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have h1 : (0 : ℝ) < ((2 : ℝ) * a) ^ (κ * p') :=
      Real.rpow_pos_of_pos (by linarith) _
    have h2 : (0 : ℝ) < a ^ (1 - p' / 2) := Real.rpow_pos_of_pos ha _
    positivity
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _),
    ENNReal.ofReal_rpow_of_pos hXpos]
  congr 1
  have he1 : κ * p' * (1 / p') = 1 / 2 - 1 / p := by
    rw [mul_assoc, mul_one_div, div_self hp'ne, mul_one, hκ]
  have he2 : (κ * p' + (1 - p' / 2)) * (1 / p') = 1 - 2 / p := by
    have hexp : (κ * p' + (1 - p' / 2)) * (1 / p') = κ + (1 / p') - 1 / 2 := by
      field_simp
      ring
    rw [hexp, hinvp', hκ]
    ring
  have hprod : ((2 : ℝ) * a) ^ (κ * p') * (a ^ (1 - p' / 2) / (1 - p' / 2)) =
      ((2 : ℝ) ^ (κ * p') * (1 / (1 - p' / 2))) * a ^ (κ * p' + (1 - p' / 2)) := by
    rw [Real.mul_rpow (by norm_num) ha.le, Real.rpow_add ha]
    ring
  rw [hprod, Real.mul_rpow (by positivity) (Real.rpow_nonneg ha.le _),
    Real.mul_rpow (by positivity) (by positivity),
    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2), ← Real.rpow_mul ha.le,
    he1, he2, brsZeroConst, ← hp'def]

/-! ## The splitting `𝔐_p^± ≲ 𝔐_{p,0}^± + 𝔐_{p,∞}^±` of BRS §5.3

The `s`-integral is cut at `s = 2|r - t|`.  On the far half `s - |r-t| ≥ s/2`,
so the singular factor disappears and the weight collapses to `s^{-1/p}` — the
two-dimensional `𝔐_p` of (4.3).  All the new work is on the near half. -/

/-- **`𝔐_{p,0}^-` of BRS §5.3**: the near half of `𝔐_p^-`. -/
def brsMainZeroLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc |r - t| (2 * |r - t|),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖

/-- **`𝔐_{p,∞}^-` of BRS §5.3**: the far half of `𝔐_p^-`. -/
def brsMainInfLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc (2 * |r - t|) (r + t),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖

/-- On the far half the singular factor is harmless. -/
theorem mainWeight_far_le {p a s : ℝ} (ha : 0 ≤ a) (hs : 2 * a < s) :
    s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) ≤
      (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / p) : ℝ) := by
  have hs0 : 0 < s := lt_of_le_of_lt (by linarith) hs
  have hs2 : (0 : ℝ) < s / 2 := by linarith
  have hsa : s / 2 ≤ s - a := by linarith
  have hinv : (s - a) ^ (-(1 / 2) : ℝ) ≤ (s / 2) ^ (-(1 / 2) : ℝ) := by
    rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ s - a), Real.rpow_neg hs2.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hs2 _)
      (Real.rpow_le_rpow hs2.le hsa (by norm_num))
  have hhalf : (s / 2) ^ (-(1 / 2) : ℝ) = (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / 2) : ℝ) := by
    rw [div_eq_mul_inv, Real.mul_rpow hs0.le (by norm_num)]
    have h2 : ((2 : ℝ)⁻¹) ^ (-(1 / 2) : ℝ) = (2 : ℝ) ^ (1 / 2 : ℝ) := by
      rw [← Real.rpow_neg_one (2 : ℝ), ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    rw [h2]
    ring
  calc s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)
      ≤ s ^ (1 / 2 - 1 / p) * (s / 2) ^ (-(1 / 2) : ℝ) :=
        mul_le_mul_of_nonneg_left hinv (Real.rpow_nonneg hs0.le _)
    _ = (2 : ℝ) ^ (1 / 2 : ℝ) * (s ^ (1 / 2 - 1 / p) * s ^ (-(1 / 2) : ℝ)) := by
        rw [hhalf]; ring
    _ = (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / p) : ℝ) := by
        rw [← Real.rpow_add hs0]
        congr 2
        ring

/-- **The splitting of `𝔐_p^-`.** -/
theorem brsMainTwoLeft_le_split {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {r : ℝ}
    (hr : 0 < r) :
    brsMainTwoLeft E p g r ≤
      brsMainZeroLeft E p g r +
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * brsMainInfLeft E p g r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htmem : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  set a : ℝ := |r - t| with ha
  have ha0 : 0 ≤ a := abs_nonneg _
  have halt : a < r / 2 := by
    rw [ha, abs_lt]
    constructor <;> linarith
  have hac : a ≤ 2 * a := by linarith
  have hab : 2 * a ≤ r + t := by linarith
  have hab' : a ≤ r + t := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
      ENNReal.ofReal ‖g s‖ with hH
  have hmajor : ENNReal.ofReal
      ‖∫ s in a..(r + t),
        ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc a (r + t), H s := by
    refine ofReal_norm_intervalIntegral_le_lintegral hab' _ H ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans ha0 hs.1
    have hsa : 0 ≤ s - a := by linarith [hs.1]
    have hnn : 0 ≤ s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hs0 _) (Real.rpow_nonneg hsa _)
    rw [hH]
    simp only
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hnn,
      ENNReal.ofReal_mul hnn]
  have hIcc : (∫⁻ s in Icc a (r + t), H s) = ∫⁻ s in Ioc a (r + t), H s :=
    (setLIntegral_congr Ioc_ae_eq_Icc).symm
  have hsplit : (∫⁻ s in Ioc a (r + t), H s) ≤
      (∫⁻ s in Ioc a (2 * a), H s) + ∫⁻ s in Ioc (2 * a) (r + t), H s := by
    rw [← Set.Ioc_union_Ioc_eq_Ioc hac hab]
    exact lintegral_union_le _ _ _
  have hfar : (∫⁻ s in Ioc (2 * a) (r + t), H s) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ∫⁻ s in Ioc (2 * a) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' measurableSet_Ioc ?_
    intro s hs
    rw [hH]
    simp only
    rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal (mainWeight_far_le ha0 hs.1)) le_rfl
  -- assemble
  have hle : ENNReal.ofReal (r⁻¹ *
      ‖∫ s in a..(r + t),
        ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖) ≤
      ENNReal.ofReal r⁻¹ * ((∫⁻ s in Ioc a (2 * a), H s) +
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
          ∫⁻ s in Ioc (2 * a) (r + t),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) := by
    rw [ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hmajor ?_
    rw [hIcc]
    exact le_trans hsplit (add_le_add le_rfl hfar)
  refine le_trans hle ?_
  rw [mul_add]
  refine add_le_add ?_ ?_
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc |r - t| (2 * |r - t|),
          ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal ‖g s‖) t htmem
  · rw [show ENNReal.ofReal r⁻¹ * (ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ∫⁻ s in Ioc (2 * a) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) =
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * (ENNReal.ofReal r⁻¹ *
          ∫⁻ s in Ioc (2 * a) (r + t),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) from by ring]
    refine mul_le_mul' le_rfl ?_
    exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc (2 * |r - t|) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) t htmem

/-! ## BRS Proposition 5.5(i) for the near half

For `p > 2` the Hölder bound `lintegral_mainZero_weight_le` is uniform in the
dilation `t`, so `𝔐_{p,0}^-` is bounded by a constant multiple of `‖g‖_p` on
its support `(2/3, 4)` — no hypothesis on `E` beyond `E ⊆ [1,2]` enters. -/

/-- The constant in the pointwise bound for `𝔐_{p,0}^-`. -/
def brsMainZeroBound (p : ℝ) : ℝ := 3 * brsZeroConst p

theorem brsMainZeroBound_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsMainZeroBound p := by
  rw [brsMainZeroBound]
  have := brsZeroConst_pos hp2
  positivity

/-- **The pointwise bound for `𝔐_{p,0}^-`, `p > 2`.** -/
theorem brsMainZeroLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainZeroLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainZeroBound p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hexp : (0 : ℝ) < 1 - 2 / p := by
    have : 2 / p < 1 := by
      rw [div_lt_one hp0]
      linarith
    linarith
  have hexp1 : 1 - 2 / p ≤ 1 := by
    have : (0 : ℝ) < 2 / p := by positivity
    linarith
  have hCpos : 0 < brsZeroConst p := brsZeroConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    set a : ℝ := |r - t| with ha
    have ha0 : 0 ≤ a := abs_nonneg _
    have halt : a < r / 2 := by
      rw [ha, abs_lt]
      constructor <;> linarith
    have halt2 : a ≤ 2 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hapow : a ^ (1 - 2 / p) ≤ 2 := by
      calc a ^ (1 - 2 / p) ≤ (2 : ℝ) ^ (1 - 2 / p) :=
            Real.rpow_le_rpow ha0 halt2 hexp.le
        _ ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp1
        _ = 2 := by norm_num
    have hinner : (∫⁻ s in Ioc a (2 * a),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (brsZeroConst p * a ^ (1 - 2 / p)) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      rcases eq_or_lt_of_le ha0 with hz | hapos
      · rw [← hz]
        simp
      · exact lintegral_mainZero_weight_le hp2 hapos hg
    refine le_trans (mul_le_mul' le_rfl hinner) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    rw [brsMainZeroBound]
    have hstep : r⁻¹ * (brsZeroConst p * a ^ (1 - 2 / p)) ≤
        (3 / 2) * (brsZeroConst p * 2) := by
      refine mul_le_mul hrinv ?_ (by positivity) (by norm_num)
      exact mul_le_mul_of_nonneg_left hapow hCpos.le
    calc r⁻¹ * (brsZeroConst p * a ^ (1 - 2 / p))
        ≤ (3 / 2) * (brsZeroConst p * 2) := hstep
      _ = 3 * brsZeroConst p := by ring
  · rw [Set.indicator_of_notMem hr, brsMainZeroLeft, brsMainWindow_empty hE hr]
    simp

/-- **BRS Proposition 5.5(i) for the near half `𝔐_{p,0}^-`.** -/
theorem prop55i_brsMainZeroLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroBound p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set B : ENNReal := ENNReal.ofReal (brsMainZeroBound p) * Gp with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have h := brsMainZeroLeft_le_indicator hE hp2 hg r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at h
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at h
      rw [le_antisymm h (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ≤
      B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    refine mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (brsMainZeroBound p) * ENNReal.ofReal 14 ^ (1 / q) * Gp := by
        rw [hB]; ring

/-! ## The right endpoint: `𝔐_{p,0}^+` and `𝔐_{p,∞}^+`

For `𝔐_p^+` the singularity sits at the right end `s = r + t`, so the
`s`-domain is broken at `(r+t)/2` instead: the near half is
`((r+t)/2, r+t)`, the far half `(|r-t|, (r+t)/2)`.  On the far half
`r + t - s ≥ s`, so the weight collapses to `s^{-1/p}` with no constant at
all. -/

/-- The reflected power integral. -/
theorem lintegral_reflected_rpow_Ioc {b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Ioc (0 : ℝ) b, ENNReal.ofReal ((b - s) ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hint0 : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 b :=
    intervalIntegral.intervalIntegrable_rpow' hc
  have hint : IntervalIntegrable (fun s : ℝ => (b - s) ^ c) volume 0 b := by
    have h := (hint0.comp_sub_left b).symm
    simpa [sub_zero, sub_self] using h
  have hval : (∫ s in (0 : ℝ)..b, (b - s) ^ c) = b ^ (c + 1) / (c + 1) := by
    have hshift : (∫ s in (0 : ℝ)..b, (b - s) ^ c) = ∫ x in (0 : ℝ)..b, x ^ c := by
      have h := intervalIntegral.integral_comp_sub_left
        (a := (0 : ℝ)) (b := b) (f := fun x : ℝ => x ^ c) b
      simpa [sub_zero, sub_self] using h
    rw [hshift, integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
    simp
  rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
    lintegral_Ioo_eq_ofReal_intervalIntegral hb.le hint
      (fun s hs => Real.rpow_nonneg (by linarith [hs.2]) _), hval]

/-- **The Hölder estimate at the right endpoint.** -/
theorem lintegral_mainZeroRight_weight_le {p : ℝ} (hp2 : 2 < p) {b : ℝ}
    (hb : 0 < b) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc (b / 2) b,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsZeroConst p * b ^ (1 - 2 / p)) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : p' < 2 := by
    rw [hp'def, Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hinvp' : 1 / p' = 1 - 1 / p := by
    rw [hp'def, Real.conjExponent]
    have hpne : p ≠ 0 := hp0.ne'
    have hp1ne : p - 1 ≠ 0 := by
      intro hcon
      rw [sub_eq_zero] at hcon
      exact absurd hcon.symm hp1.ne
    field_simp
  set κ : ℝ := 1 / 2 - 1 / p with hκ
  have hκ0 : 0 < κ := by
    rw [hκ]
    have : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num)]
      linarith
    linarith
  have hden : (0 : ℝ) < 1 - p' / 2 := by linarith
  have hp'ne : p' ≠ 0 := hp'pos.ne'
  set w : ℝ → ℝ := fun s => s ^ κ * (b - s) ^ (-(1 / 2) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  -- the `L^{p'}` norm of the weight on the near window
  have hWle : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal (w s)) ^ p') ≤
      ENNReal.ofReal (b ^ (κ * p')) *
        ENNReal.ofReal (b ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have hstep : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal (w s)) ^ p') ≤
        ∫⁻ s in Ioc (0 : ℝ) b, ENNReal.ofReal (b ^ (κ * p')) *
          ENNReal.ofReal ((b - s) ^ (-(p' / 2))) := by
      refine le_trans (lintegral_mono_set
        (Set.Ioc_subset_Ioc (show (0 : ℝ) ≤ b / 2 by linarith) (le_refl b))) ?_
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hs0 : 0 < s := hs.1
      have hbs : 0 ≤ b - s := by linarith [hs.2]
      have hpt : (ENNReal.ofReal (w s)) ^ p' =
          ENNReal.ofReal (s ^ (κ * p') * (b - s) ^ (-(p' / 2))) := by
        rw [hw]
        simp only
        rw [ENNReal.ofReal_rpow_of_nonneg
          (mul_nonneg (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hbs _))
          hp'pos.le]
        congr 1
        rw [Real.mul_rpow (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hbs _),
          ← Real.rpow_mul hs0.le, ← Real.rpow_mul hbs]
        have hexp : -(1 / 2 : ℝ) * p' = -(p' / 2) := by ring
        rw [hexp]
      rw [hpt, ENNReal.ofReal_mul (Real.rpow_nonneg hs0.le _)]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact Real.rpow_le_rpow hs0.le hs.2 (by positivity)
    refine le_trans hstep (le_of_eq ?_)
    rw [lintegral_const_mul _ (by fun_prop),
      lintegral_reflected_rpow_Ioc hb (by linarith : (-1 : ℝ) < -(p' / 2))]
    congr 2
    ring
  -- Hölder
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Ioc (b / 2) b)) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow hWle (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' ?_ le_rfl
  -- the constant
  have hXpos : (0 : ℝ) < b ^ (κ * p') * (b ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have h1 : (0 : ℝ) < b ^ (κ * p') := Real.rpow_pos_of_pos hb _
    have h2 : (0 : ℝ) < b ^ (1 - p' / 2) := Real.rpow_pos_of_pos hb _
    positivity
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hb.le _),
    ENNReal.ofReal_rpow_of_pos hXpos]
  refine ENNReal.ofReal_le_ofReal ?_
  have he2 : (κ * p' + (1 - p' / 2)) * (1 / p') = 1 - 2 / p := by
    have hexp : (κ * p' + (1 - p' / 2)) * (1 / p') = κ + (1 / p') - 1 / 2 := by
      field_simp
      ring
    rw [hexp, hinvp', hκ]
    ring
  have hprod : b ^ (κ * p') * (b ^ (1 - p' / 2) / (1 - p' / 2)) =
      (1 / (1 - p' / 2)) * b ^ (κ * p' + (1 - p' / 2)) := by
    rw [Real.rpow_add hb]
    ring
  rw [hprod, Real.mul_rpow (by positivity) (Real.rpow_nonneg hb.le _),
    ← Real.rpow_mul hb.le, he2]
  refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hb.le _)
  rw [brsZeroConst, ← hp'def, ← hκ]
  have h2κ : (1 : ℝ) ≤ (2 : ℝ) ^ κ := by
    have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hκ0.le
    rwa [Real.rpow_zero] at h
  exact le_mul_of_one_le_left (Real.rpow_nonneg (by positivity) _) h2κ

/-! ## `𝔐_{p,0}^+`, `𝔐_{p,∞}^+`, and BRS Proposition 5.5(i) at the right endpoint -/

/-- **`𝔐_{p,0}^+` of BRS §5.3**: the near half of `𝔐_p^+`. -/
def brsMainZeroRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc ((r + t) / 2) (r + t),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖

/-- **`𝔐_{p,∞}^+` of BRS §5.3**: the far half of `𝔐_p^+`. -/
def brsMainInfRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc |r - t| ((r + t) / 2),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖

/-- On the far half of `𝔐_p^+` the singular factor is harmless, with no
constant at all. -/
theorem mainWeightRight_far_le {p b s : ℝ} (hs0 : 0 < s) (hsb : s ≤ b / 2) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤ s ^ (-(1 / p) : ℝ) := by
  have hbs : s ≤ b - s := by linarith
  have hinv : (b - s) ^ (-(1 / 2) : ℝ) ≤ s ^ (-(1 / 2) : ℝ) := by
    rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ b - s), Real.rpow_neg hs0.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hs0 _)
      (Real.rpow_le_rpow hs0.le hbs (by norm_num))
  calc s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)
      ≤ s ^ (1 / 2 - 1 / p) * s ^ (-(1 / 2) : ℝ) :=
        mul_le_mul_of_nonneg_left hinv (Real.rpow_nonneg hs0.le _)
    _ = s ^ (-(1 / p) : ℝ) := by
        rw [← Real.rpow_add hs0]
        congr 1
        ring

/-- **The splitting of `𝔐_p^+`.** -/
theorem brsMainTwoRight_le_split {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {r : ℝ}
    (hr : 0 < r) :
    brsMainTwoRight E p g r ≤
      brsMainZeroRight E p g r + brsMainInfRight E p g r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htmem : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have ha0 : 0 ≤ a := abs_nonneg _
  have halt : a < r / 2 := by
    rw [ha, abs_lt]
    constructor <;> linarith
  have hb0 : 0 < b := by rw [hb]; linarith
  have hac : a ≤ b / 2 := by
    rw [hb]
    linarith
  have hcb : b / 2 ≤ b := by linarith
  have hab' : a ≤ b := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)) *
      ENNReal.ofReal ‖g s‖ with hH
  have hmajor : ENNReal.ofReal
      ‖∫ s in a..b,
        ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc a b, H s := by
    refine ofReal_norm_intervalIntegral_le_lintegral hab' _ H ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans ha0 hs.1
    have hbs : 0 ≤ b - s := by linarith [hs.2]
    have hnn : 0 ≤ s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hs0 _) (Real.rpow_nonneg hbs _)
    rw [hH]
    simp only
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hnn,
      ENNReal.ofReal_mul hnn]
  have hIcc : (∫⁻ s in Icc a b, H s) = ∫⁻ s in Ioc a b, H s :=
    (setLIntegral_congr Ioc_ae_eq_Icc).symm
  have hsplit : (∫⁻ s in Ioc a b, H s) ≤
      (∫⁻ s in Ioc a (b / 2), H s) + ∫⁻ s in Ioc (b / 2) b, H s := by
    rw [← Set.Ioc_union_Ioc_eq_Ioc hac hcb]
    exact lintegral_union_le _ _ _
  have hfar : (∫⁻ s in Ioc a (b / 2), H s) ≤
      ∫⁻ s in Ioc a (b / 2),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖ := by
    refine setLIntegral_mono' measurableSet_Ioc ?_
    intro s hs
    have hs0 : 0 < s := lt_of_le_of_lt ha0 hs.1
    rw [hH]
    simp only
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal
      (mainWeightRight_far_le hs0 hs.2)) le_rfl
  have hle : ENNReal.ofReal (r⁻¹ *
      ‖∫ s in a..b,
        ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖) ≤
      ENNReal.ofReal r⁻¹ *
        ((∫⁻ s in Ioc a (b / 2),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) +
          ∫⁻ s in Ioc (b / 2) b, H s) := by
    rw [ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hmajor ?_
    rw [hIcc]
    exact le_trans hsplit (add_le_add hfar le_rfl)
  refine le_trans hle ?_
  rw [mul_add, add_comm]
  refine add_le_add ?_ ?_
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc ((r + t) / 2) (r + t),
          ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal ‖g s‖) t htmem
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc |r - t| ((r + t) / 2),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) t htmem

/-- The constant in the pointwise bound for `𝔐_{p,0}^+`. -/
def brsMainZeroBoundRight (p : ℝ) : ℝ := 9 * brsZeroConst p

theorem brsMainZeroBoundRight_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainZeroBoundRight p := by
  rw [brsMainZeroBoundRight]
  have := brsZeroConst_pos hp2
  positivity

/-- **The pointwise bound for `𝔐_{p,0}^+`, `p > 2`.** -/
theorem brsMainZeroRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainZeroRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainZeroBoundRight p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hexp : (0 : ℝ) < 1 - 2 / p := by
    have : 2 / p < 1 := by
      rw [div_lt_one hp0]
      linarith
    linarith
  have hexp1 : 1 - 2 / p ≤ 1 := by
    have : (0 : ℝ) < 2 / p := by positivity
    linarith
  have hCpos : 0 < brsZeroConst p := brsZeroConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    set b : ℝ := r + t with hb
    have hb0 : 0 < b := by rw [hb]; linarith
    have hble : b ≤ 6 := by
      rw [hb]
      linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hbpow : b ^ (1 - 2 / p) ≤ 6 := by
      calc b ^ (1 - 2 / p) ≤ (6 : ℝ) ^ (1 - 2 / p) :=
            Real.rpow_le_rpow hb0.le hble hexp.le
        _ ≤ (6 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp1
        _ = 6 := by norm_num
    have hinner := lintegral_mainZeroRight_weight_le hp2 hb0 (g := g) hg
    refine le_trans (mul_le_mul' le_rfl hinner) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    rw [brsMainZeroBoundRight]
    have hstep : r⁻¹ * (brsZeroConst p * b ^ (1 - 2 / p)) ≤
        (3 / 2) * (brsZeroConst p * 6) := by
      refine mul_le_mul hrinv ?_ (by positivity) (by norm_num)
      exact mul_le_mul_of_nonneg_left hbpow hCpos.le
    calc r⁻¹ * (brsZeroConst p * b ^ (1 - 2 / p))
        ≤ (3 / 2) * (brsZeroConst p * 6) := hstep
      _ = 9 * brsZeroConst p := by ring
  · rw [Set.indicator_of_notMem hr, brsMainZeroRight, brsMainWindow_empty hE hr]
    simp

/-- **BRS Proposition 5.5(i) for the near half `𝔐_{p,0}^+`.** -/
theorem prop55i_brsMainZeroRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set B : ENNReal := ENNReal.ofReal (brsMainZeroBoundRight p) * Gp with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have h := brsMainZeroRight_le_indicator hE hp2 hg r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at h
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at h
      rw [le_antisymm h (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ≤
      B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    refine mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (brsMainZeroBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) * Gp := by
        rw [hB]; ring

/-! ## The far halves `𝔐_{p,∞}^±`, and BRS Proposition 5.5(i)

On the far halves the weight is the plain power `s^{-1/p}`, which lies in
`L^{p'}(0,6)` exactly when `p' < p`, i.e. when `p > 2`.  So the same Hölder
argument closes the far halves too, and Proposition 5.5(i) follows with no
hypothesis on `E` beyond `E ⊆ [1,2]`. -/

/-- The radial integral, for a maximal function supported in `(2/3, 4)` and
bounded there. -/
theorem lintegral_radial_indicator_rpow_le {F : ℝ → ENNReal} {C q : ℝ}
    (hq0 : 0 < q) {G : ENNReal}
    (h : ∀ r : ℝ, F r ≤ (Ioo (2 / 3 : ℝ) 4).indicator
      (fun _ => ENNReal.ofReal C * G) r) :
    (∫⁻ r, ENNReal.ofReal r * F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal C * ENNReal.ofReal 14 ^ (1 / q) * G := by
  set B : ENNReal := ENNReal.ofReal C * G with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * F r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have hr' := h r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at hr'
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hr' hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at hr'
      rw [le_antisymm hr' (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * F r ^ q) ≤ B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    exact mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * F r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal C * ENNReal.ofReal 14 ^ (1 / q) * G := by
        rw [hB]; ring

/-- The power integral over `[0, b]`. -/
theorem lintegral_rpow_Icc_zero_eq {c b : ℝ} (hc : -1 < c) (hb : 0 < b) :
    (∫⁻ s in Icc (0 : ℝ) b, ENNReal.ofReal (s ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hint : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 b :=
    intervalIntegral.intervalIntegrable_rpow' hc
  rw [← setLIntegral_congr (Ioo_ae_eq_Icc (a := (0 : ℝ)) (b := b)),
    lintegral_Ioo_eq_ofReal_intervalIntegral hb.le hint
      (fun s hs => Real.rpow_nonneg hs.1.le _),
    integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
  simp

/-- The constant in the far-half estimate. -/
def brsMainInfConst (p : ℝ) : ℝ :=
  ((6 : ℝ) ^ (1 - Real.conjExponent p / p) / (1 - Real.conjExponent p / p)) ^
    (1 / Real.conjExponent p)

theorem brsMainInfConst_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsMainInfConst p := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos hp0 (by linarith)
  have hlt : Real.conjExponent p / p < 1 := by
    rw [Real.conjExponent, div_div, div_lt_one (by nlinarith)]
    nlinarith
  rw [brsMainInfConst]
  refine Real.rpow_pos_of_pos ?_ _
  have h6 : (0 : ℝ) < (6 : ℝ) ^ (1 - Real.conjExponent p / p) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have : (0 : ℝ) < 1 - Real.conjExponent p / p := by linarith
  positivity

/-- **The Hölder estimate on the far halves.** -/
theorem lintegral_mainInf_weight_le {p : ℝ} (hp2 : 2 < p) {u v : ℝ}
    (hu : 0 ≤ u) (hv : v ≤ 6) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc u v,
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsMainInfConst p) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos hp0 (by linarith)
  have hlt : p' / p < 1 := by
    rw [hp'def, Real.conjExponent, div_div, div_lt_one (by nlinarith)]
    nlinarith
  have hc : (-1 : ℝ) < -(p' / p) := by linarith
  have hden : (0 : ℝ) < 1 - p' / p := by linarith
  set w : ℝ → ℝ := fun s => s ^ (-(1 / p) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  have hsub : Ioc u v ⊆ Icc (0 : ℝ) 6 := by
    intro s hs
    exact ⟨le_trans hu hs.1.le, le_trans hs.2 hv⟩
  refine le_trans (lintegral_mono_set hsub) ?_
  -- the `L^{p'}` norm of the weight
  have hWeq : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal (w s)) ^ p') =
      ENNReal.ofReal ((6 : ℝ) ^ (1 - p' / p) / (1 - p' / p)) := by
    have hcongr : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal (w s)) ^ p') =
        ∫⁻ s in Icc (0 : ℝ) 6, ENNReal.ofReal (s ^ (-(p' / p))) := by
      refine setLIntegral_congr_fun measurableSet_Icc ?_
      intro s hs
      rw [hw]
      simp only
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hs.1 _) hp'pos.le,
        ← Real.rpow_mul hs.1]
      congr 1
      field_simp
    rw [hcongr, lintegral_rpow_Icc_zero_eq hc (by norm_num : (0 : ℝ) < 6)]
    congr 1
    · congr 1 <;> ring
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Icc (0 : ℝ) 6)) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow (le_of_eq hWeq) (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  rw [brsMainInfConst, ← hp'def,
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]

/-! ## BRS Proposition 5.5(i)

Assembling the two halves gives the full statement: for `p > 2` and every
`0 < q < ∞`, `‖𝔐_p^± g‖_{L^q(r dr)} ≲_p ‖g‖_p`, with no hypothesis on the
dilation set beyond `E ⊆ [1,2]`. -/

/-- **The pointwise bound for `𝔐_{p,∞}^-`.** -/
theorem brsMainInfLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainInfLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (3 / 2 * brsMainInfConst p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hCpos : 0 < brsMainInfConst p := brsMainInfConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hu : (0 : ℝ) ≤ 2 * |r - t| := by positivity
    have hv : r + t ≤ 6 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    refine le_trans (mul_le_mul' le_rfl
      (lintegral_mainInf_weight_le hp2 hu hv hg)) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    exact mul_le_mul_of_nonneg_right hrinv hCpos.le
  · rw [Set.indicator_of_notMem hr, brsMainInfLeft, brsMainWindow_empty hE hr]
    simp

/-- **The pointwise bound for `𝔐_{p,∞}^+`.** -/
theorem brsMainInfRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainInfRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (3 / 2 * brsMainInfConst p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hCpos : 0 < brsMainInfConst p := brsMainInfConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hu : (0 : ℝ) ≤ |r - t| := abs_nonneg _
    have hv : (r + t) / 2 ≤ 6 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    refine le_trans (mul_le_mul' le_rfl
      (lintegral_mainInf_weight_le hp2 hu hv hg)) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    exact mul_le_mul_of_nonneg_right hrinv hCpos.le
  · rw [Set.indicator_of_notMem hr, brsMainInfRight, brsMainWindow_empty hE hr]
    simp

/-- The constant of BRS Proposition 5.5(i) at the left endpoint. -/
def brsMainTotalBoundLeft (p : ℝ) : ℝ :=
  brsMainZeroBound p + (2 : ℝ) ^ (1 / 2 : ℝ) * (3 / 2 * brsMainInfConst p)

/-- The constant of BRS Proposition 5.5(i) at the right endpoint. -/
def brsMainTotalBoundRight (p : ℝ) : ℝ :=
  brsMainZeroBoundRight p + 3 / 2 * brsMainInfConst p

theorem brsMainTotalBoundLeft_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainTotalBoundLeft p := by
  have h1 := brsMainZeroBound_pos hp2
  have h2 := brsMainInfConst_pos hp2
  have h3 : (0 : ℝ) < (2 : ℝ) ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
  rw [brsMainTotalBoundLeft]
  positivity

theorem brsMainTotalBoundRight_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainTotalBoundRight p := by
  have h1 := brsMainZeroBoundRight_pos hp2
  have h2 := brsMainInfConst_pos hp2
  rw [brsMainTotalBoundRight]
  positivity

/-- **The pointwise bound for `𝔐_p^-`, `p > 2`.** -/
theorem brsMainTwoLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainTwoLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainTotalBoundLeft p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  have hz := brsMainZeroLeft_le_indicator hE hp2 hg r
  have hi := brsMainInfLeft_le_indicator hE hp2 hg r
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    rw [Set.indicator_of_mem hr] at hz hi
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    refine le_trans (brsMainTwoLeft_le_split hr0) ?_
    refine le_trans (add_le_add hz (mul_le_mul' le_rfl hi)) ?_
    have h2nn : (0 : ℝ) ≤ (2 : ℝ) ^ (1 / 2 : ℝ) := Real.rpow_nonneg (by norm_num) _
    have hCnn : (0 : ℝ) ≤ 3 / 2 * brsMainInfConst p := by
      have := brsMainInfConst_pos hp2
      positivity
    rw [← mul_assoc, ← ENNReal.ofReal_mul h2nn, ← add_mul,
      ← ENNReal.ofReal_add (le_of_lt (brsMainZeroBound_pos hp2))
        (mul_nonneg h2nn hCnn), brsMainTotalBoundLeft]
  · rw [Set.indicator_of_notMem hr, brsMainTwoLeft_eq_zero hE hr]

/-- **The pointwise bound for `𝔐_p^+`, `p > 2`.** -/
theorem brsMainTwoRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainTwoRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainTotalBoundRight p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  have hz := brsMainZeroRight_le_indicator hE hp2 hg r
  have hi := brsMainInfRight_le_indicator hE hp2 hg r
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    rw [Set.indicator_of_mem hr] at hz hi
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    refine le_trans (brsMainTwoRight_le_split hr0) ?_
    refine le_trans (add_le_add hz hi) ?_
    have hCnn : (0 : ℝ) ≤ 3 / 2 * brsMainInfConst p := by
      have := brsMainInfConst_pos hp2
      positivity
    rw [← add_mul, ← ENNReal.ofReal_add
      (le_of_lt (brsMainZeroBoundRight_pos hp2)) hCnn,
      brsMainTotalBoundRight]
  · rw [Set.indicator_of_notMem hr, brsMainTwoRight_eq_zero hE hr]

/-- **BRS Proposition 5.5(i), left endpoint.**  For `p > 2` the operator
`𝔐_p^-` maps `L^p` to `L^q(r dr)` for every `0 < q < ∞`, with a constant
independent of `E`. -/
theorem prop55i_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainTotalBoundLeft p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) :=
  lintegral_radial_indicator_rpow_le hq0 (brsMainTwoLeft_le_indicator hE hp2 hg)

/-- **BRS Proposition 5.5(i), right endpoint.** -/
theorem prop55i_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainTotalBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) :=
  lintegral_radial_indicator_rpow_le hq0 (brsMainTwoRight_le_indicator hE hp2 hg)

/-! ## The dyadic pieces of the near window, BRS §5.3 for `p ≤ 2`

For `p < 2` the weight `s^{1/2-1/p}(s-a)^{-1/2}` is no longer in `L^{p'}` of
the near window `(a, 2a]`, so BRS decompose that window into the dyadic pieces
`(a(1 + 2^{-m-1}), a(1 + 2^{-m})]` and estimate each separately. -/

/-- The `m`-th dyadic piece of the near window `(a, 2a]`. -/
def brsNearPieceSet (a : ℝ) (m : ℕ) : Set ℝ :=
  Ioc (a * (1 + (1 / 2 : ℝ) ^ (m + 1))) (a * (1 + (1 / 2 : ℝ) ^ m))

theorem brsNearPieceSet_subset {a : ℝ} (ha : 0 < a) (m : ℕ) :
    brsNearPieceSet a m ⊆ Ioc a (2 * a) := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 1) := by positivity
  have hpow' : (1 / 2 : ℝ) ^ m ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
  constructor
  · nlinarith
  · nlinarith

/-- The pieces exhaust the near window. -/
theorem Ioc_subset_iUnion_brsNearPieceSet {a : ℝ} (ha : 0 < a) :
    Ioc a (2 * a) ⊆ ⋃ m : ℕ, brsNearPieceSet a m := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  set x : ℝ := s / a - 1 with hx
  have hx0 : 0 < x := by
    rw [hx, sub_pos, lt_div_iff₀ ha]
    linarith
  have hx1 : x ≤ 1 := by
    rw [hx, sub_le_iff_le_add, div_le_iff₀ ha]
    linarith
  have hex : ∃ m : ℕ, (1 / 2 : ℝ) ^ (m + 1) < x := by
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hx0 (by norm_num : (1 / 2 : ℝ) < 1)
    refine ⟨n, lt_of_le_of_lt ?_ hn⟩
    exact pow_le_pow_of_le_one (by norm_num) (by norm_num) (Nat.le_succ n)
  classical
  set m : ℕ := Nat.find hex with hm
  have hlow : (1 / 2 : ℝ) ^ (m + 1) < x := Nat.find_spec hex
  have hhigh : x ≤ (1 / 2 : ℝ) ^ m := by
    rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    · rw [hm0]
      simpa using hx1
    · have hnot : ¬ ((1 / 2 : ℝ) ^ ((m - 1) + 1) < x) := by
        rw [hm]
        exact Nat.find_min hex (by omega)
      have hidx : (m - 1) + 1 = m := by omega
      rw [hidx] at hnot
      exact le_of_not_gt hnot
  have hxa : x * a = s - a := by
    rw [hx, sub_mul, div_mul_cancel₀ _ ha.ne', one_mul]
  refine Set.mem_iUnion.mpr ⟨m, ?_, ?_⟩
  · have h := mul_lt_mul_of_pos_left hlow ha
    nlinarith [hxa]
  · have h := mul_le_mul_of_nonneg_left hhigh ha.le
    nlinarith [hxa]

/-- The near-window integral is at most the sum over the dyadic pieces. -/
theorem lintegral_near_le_tsum_pieces {a : ℝ} (ha : 0 < a) (F : ℝ → ENNReal) :
    (∫⁻ s in Ioc a (2 * a), F s) ≤
      ∑' m : ℕ, ∫⁻ s in brsNearPieceSet a m, F s := by
  refine le_trans (lintegral_mono_set (Ioc_subset_iUnion_brsNearPieceSet ha)) ?_
  exact lintegral_iUnion_le _ _

/-- The volume of a dyadic piece. -/
theorem volume_brsNearPieceSet {a : ℝ} (_ha : 0 < a) (m : ℕ) :
    volume (brsNearPieceSet a m) = ENNReal.ofReal (a * (1 / 2 : ℝ) ^ (m + 1)) := by
  rw [brsNearPieceSet, Real.volume_Ioc]
  congr 1
  have : (1 / 2 : ℝ) ^ (m + 1) = (1 / 2 : ℝ) ^ m / 2 := by
    rw [pow_succ]
    ring
  rw [this]
  ring

/-- **The pointwise weight bound on a dyadic piece.**  For `p ≤ 2` the factor
`s^{1/2-1/p}` is decreasing, so both factors are controlled at the left end. -/
theorem mainWeight_piece_le {p a s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (ha : 0 < a)
    {m : ℕ} (hs : s ∈ brsNearPieceSet a m) :
    s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) ≤
      ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * a ^ (-(1 / p) : ℝ) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  obtain ⟨h1, h2⟩ := hs
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 1) := by positivity
  have hsa : a * (1 / 2 : ℝ) ^ (m + 1) < s - a := by nlinarith
  have hs0 : 0 < s := by nlinarith
  have has : a ≤ s := by nlinarith
  have hκ : 1 / 2 - 1 / p ≤ 0 := by
    have : (1 : ℝ) / 2 ≤ 1 / p := by
      rw [div_le_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  -- the first factor
  have hfirst : s ^ (1 / 2 - 1 / p) ≤ a ^ (1 / 2 - 1 / p) := by
    rw [Real.rpow_def_of_pos ha, Real.rpow_def_of_pos hs0]
    refine Real.exp_le_exp.mpr ?_
    have hlog : Real.log a ≤ Real.log s := Real.log_le_log ha has
    nlinarith
  -- the second factor
  have hsecond : (s - a) ^ (-(1 / 2) : ℝ) ≤
      (a * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) := by
    have hbase : (0 : ℝ) < a * (1 / 2 : ℝ) ^ (m + 1) := by positivity
    rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ s - a), Real.rpow_neg hbase.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hbase _)
      (Real.rpow_le_rpow hbase.le hsa.le (by norm_num))
  have hsplit : (a * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) =
      a ^ (-(1 / 2) : ℝ) * ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) :=
    Real.mul_rpow ha.le hpow.le
  calc s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)
      ≤ a ^ (1 / 2 - 1 / p) * (a * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) := by
        refine mul_le_mul hfirst hsecond (Real.rpow_nonneg (by linarith) _)
          (Real.rpow_nonneg ha.le _)
    _ = ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (a ^ (1 / 2 - 1 / p) * a ^ (-(1 / 2) : ℝ)) := by
        rw [hsplit]; ring
    _ = ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * a ^ (-(1 / p) : ℝ) := by
        rw [← Real.rpow_add ha]
        congr 2
        ring

/-! ## The per-piece Hölder bound for `p ≤ 2`

On the `m`-th dyadic piece the weight is bounded by a constant, so Hölder
against the constant function gives

`∫_{piece} w |g| ≤ 2^{(m+1)(1/p - 1/2)} · a^{1 - 2/p} · ‖g‖_{L^p(a, 2a)}`.

The `m`-dependence grows for `p < 2`; this is the estimate BRS use for the
range `m ≤ ℓ`, where the growth is absorbed by the `ℓ`-sum. -/

theorem lintegral_nearPiece_le {p a : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (ha : 0 < a)
    {g : ℝ → ℂ} (hg : Measurable g) (m : ℕ) :
    (∫⁻ s in brsNearPieceSet a m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          a ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  set θ : ℝ := (1 / 2 : ℝ) ^ (m + 1) with hθ
  have hθ0 : (0 : ℝ) < θ := by rw [hθ]; positivity
  set K : ℝ := θ ^ (-(1 / 2) : ℝ) * a ^ (-(1 / p) : ℝ) with hK
  have hK0 : (0 : ℝ) ≤ K := by
    rw [hK]
    exact mul_nonneg (Real.rpow_nonneg hθ0.le _) (Real.rpow_nonneg ha.le _)
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  -- replace the weight by the constant `K`
  have hstep : (∫⁻ s in brsNearPieceSet a m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal K * ∫⁻ s in brsNearPieceSet a m, ENNReal.ofReal ‖g s‖ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' measurableSet_Ioc ?_
    intro s hs
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal
      (mainWeight_piece_le hp1 hp2 ha hs)) le_rfl
  refine le_trans hstep ?_
  -- Hölder against the constant function on the piece
  have hholder := lintegral_le_rpow_mul_measure_univ
    (μ := volume.restrict (brsNearPieceSet a m)) hgmeas hp1
  rw [Measure.restrict_apply_univ] at hholder
  rw [volume_brsNearPieceSet ha m] at hholder
  have hmono : (∫⁻ s in brsNearPieceSet a m, (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal ‖g s‖) ^ p :=
    lintegral_mono_set (brsNearPieceSet_subset ha m)
  refine le_trans (mul_le_mul' le_rfl hholder) ?_
  refine le_trans (mul_le_mul' le_rfl
    (mul_le_mul' (ENNReal.rpow_le_rpow hmono (by positivity)) le_rfl)) ?_
  -- collect the constants
  have hconst : ENNReal.ofReal K *
      (ENNReal.ofReal (a * θ)) ^ (1 - 1 / p) =
      ENNReal.ofReal (θ ^ (1 / 2 - 1 / p) * a ^ (1 - 2 / p)) := by
    have hnn : (0 : ℝ) ≤ 1 - 1 / p := by
      have : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp1
      linarith
    rw [ENNReal.ofReal_rpow_of_nonneg (mul_nonneg ha.le hθ0.le) hnn,
      ← ENNReal.ofReal_mul hK0]
    congr 1
    rw [hK, Real.mul_rpow ha.le hθ0.le]
    have hrw : θ ^ (-(1 / 2) : ℝ) * a ^ (-(1 / p) : ℝ) *
        (a ^ (1 - 1 / p) * θ ^ (1 - 1 / p)) =
        (θ ^ (-(1 / 2) : ℝ) * θ ^ (1 - 1 / p)) *
          (a ^ (-(1 / p) : ℝ) * a ^ (1 - 1 / p)) := by ring
    rw [hrw, ← Real.rpow_add hθ0, ← Real.rpow_add ha]
    congr 2 <;> ring
  have hfinal : ENNReal.ofReal K *
      ((∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) *
        (ENNReal.ofReal (a * θ)) ^ (1 - 1 / p)) =
      ENNReal.ofReal (θ ^ (1 / 2 - 1 / p) * a ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
    rw [← hconst]
    ring
  exact le_of_eq hfinal

/-! ## Covering the dyadic neighbourhood by intervals

BRS write the shell `D_n` as a union of `≈ N(E, 2^{-n})` intervals of length
`≈ 2^{-n}`; this is the family the `r`-variable lives in for the localized
estimates of Proposition 5.5(ii)–(iii).  The cover comes straight from a
`2^{-n}`-cover of `E`, fattened by `3·2^{-n}`. -/

/-- **The interval cover of the dyadic neighbourhood.**  A `δ`-cover of `E`,
fattened to length `7δ`, covers `U_n`. -/
theorem exists_cover_brsU {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (n : ℕ) :
    ∃ ι : Finset ℝ,
      ι.card = intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) ∧
        brsU E n ⊆ ⋃ a ∈ ι,
          Icc (a - 7 * (2 : ℝ) ^ (-(n : ℤ)) / 2) (a + 7 * (2 : ℝ) ^ (-(n : ℤ)) / 2) := by
  set δ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hδ
  have hδpos : 0 < δ := by
    rw [hδ]
    positivity
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδpos
  refine ⟨ι, hcard, ?_⟩
  intro r hr
  have hdist : Metric.infDist r E ≤ 2 * δ := hr
  obtain ⟨t, htE, hrt⟩ : ∃ t ∈ E, dist r t < 3 * δ := by
    have hlt : Metric.infDist r E < 3 * δ := by linarith
    exact (Metric.infDist_lt_iff hEne).mp hlt
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ ι, t ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι htE
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  refine Set.mem_biUnion haι ?_
  rw [Real.dist_eq, abs_lt] at hrt
  constructor
  · have := hat.1
    have := hrt.1
    linarith
  · have := hat.2
    have := hrt.2
    linarith

/-- The shells are contained in the cover of the neighbourhood. -/
theorem brsD_subset_brsU (E : Set ℝ) (n : ℕ) : brsD E n ⊆ brsU E n :=
  fun _ hr => hr.1

/-- The measure of a shell, in terms of the covering number. -/
theorem volume_brsD_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (n : ℕ) :
    volume (brsD E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
        (intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℝ≥0∞) :=
  le_trans (measure_mono (brsD_subset_brsU E n)) (volume_brsU_le hE hEne n)

/-! ## Young's inequality against an indicator

Mathlib has no general Young convolution inequality, but the case needed for
BRS Proposition 5.5(ii)–(iii) — convolution with the indicator of a set — needs
none: Hölder inside the convolution reduces it to the `L^1 ∗ L^s → L^s` case,
which is `lintegral_shift_mul_rpow_le`.  Explicitly, with `s = q/p`,

`(1_Q ∗ F)(x) ≤ |Q|^{1-1/p} (1_Q ∗ F^p)(x)^{1/p}`,
`‖1_Q ∗ F^p‖_{s} ≤ |Q|^{1/s} ‖F^p‖_1`,

and multiplying out gives `‖1_Q ∗ F‖_q ≤ |Q|^{1 - 1/p + 1/q} ‖F‖_p`. -/

/-- The reflected translate of a set has the same measure. -/
theorem volume_preimage_sub_left (x : ℝ) {Q : Set ℝ} (hQ : MeasurableSet Q) :
    volume ((fun y : ℝ => x - y) ⁻¹' Q) = volume Q := by
  have hmp : MeasurePreserving (fun y : ℝ => x - y) volume volume :=
    Measure.measurePreserving_sub_left volume x
  rw [← hmp.measure_preimage hQ.nullMeasurableSet]

/-- The convolution with an indicator, written as a set integral. -/
theorem lintegral_indicator_shift {Q : Set ℝ} (hQ : MeasurableSet Q)
    (F : ℝ → ENNReal) (x : ℝ) :
    (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) =
      ∫⁻ y in (fun y : ℝ => x - y) ⁻¹' Q, F y := by
  have hpre : MeasurableSet ((fun y : ℝ => x - y) ⁻¹' Q) :=
    hQ.preimage (measurable_const.sub measurable_id)
  have hfun : (fun y : ℝ => Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y)
      = Set.indicator ((fun y : ℝ => x - y) ⁻¹' Q) F := by
    funext y
    by_cases hy : x - y ∈ Q
    · rw [Set.indicator_of_mem hy, one_mul,
        Set.indicator_of_mem (show y ∈ (fun y : ℝ => x - y) ⁻¹' Q from hy)]
    · rw [Set.indicator_of_notMem hy, zero_mul,
        Set.indicator_of_notMem (show y ∉ (fun y : ℝ => x - y) ⁻¹' Q from hy)]
  rw [hfun, lintegral_indicator hpre]

/-- **Hölder inside the convolution.** -/
theorem lintegral_indicator_conv_le_pointwise {Q : Set ℝ} (hQ : MeasurableSet Q)
    {F : ℝ → ENNReal} (hF : Measurable F) {p : ℝ} (hp1 : 1 ≤ p) (x : ℝ) :
    (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) ≤
      (volume Q) ^ (1 - 1 / p) *
        (∫⁻ y : ℝ,
          Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y ^ p) ^ (1 / p) := by
  have hpre : MeasurableSet ((fun y : ℝ => x - y) ⁻¹' Q) :=
    hQ.preimage (measurable_const.sub measurable_id)
  rw [lintegral_indicator_shift hQ F x, lintegral_indicator_shift hQ (fun y => F y ^ p) x]
  have hholder := lintegral_le_rpow_mul_measure_univ
    (μ := volume.restrict ((fun y : ℝ => x - y) ⁻¹' Q)) hF hp1
  rw [Measure.restrict_apply_univ, volume_preimage_sub_left x hQ] at hholder
  rw [mul_comm]
  exact hholder

/-- **Young's inequality against an indicator.** -/
theorem lintegral_indicator_conv_rpow_le {Q : Set ℝ} (hQ : MeasurableSet Q)
    (hQfin : volume Q ≠ ⊤) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ x : ℝ,
        (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) ^ q) ^
        (1 / q) ≤
      (volume Q) ^ (1 - 1 / p + 1 / q) * (∫⁻ y : ℝ, F y ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := q / p with hs
  have hs1 : (1 : ℝ) ≤ s := by
    rw [hs, le_div_iff₀ hp0]
    linarith
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs1
  set K : ℝ → ENNReal := fun u => Set.indicator Q (fun _ => (1 : ENNReal)) u with hK
  have hKmeas : Measurable K := by
    rw [hK]
    exact (measurable_const.indicator hQ)
  have hFp : Measurable fun y : ℝ => F y ^ p := hF.pow_const p
  -- the `L^1 ∗ L^s` step
  have hyoung := lintegral_shift_mul_rpow_le (K := K) (w := fun y => F y ^ p)
    hKmeas hFp hs1
  -- pointwise Hölder
  have hptwise : ∀ x : ℝ,
      (∫⁻ y : ℝ, K (x - y) * F y) ^ q ≤
        (volume Q) ^ ((1 - 1 / p) * q) *
          (∫⁻ y : ℝ, K (x - y) * F y ^ p) ^ s := by
    intro x
    have h := lintegral_indicator_conv_le_pointwise hQ hF hp1 x
    have h' := ENNReal.rpow_le_rpow h hq0.le
    refine le_trans h' (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    congr 2
    rw [hs]
    field_simp
  -- integrate
  have hmain : (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * F y) ^ q) ≤
      (volume Q) ^ ((1 - 1 / p) * q) *
        ((∫⁻ y : ℝ, F y ^ p) ^ (s - 1) *
          ((∫⁻ y : ℝ, F y ^ p) * ∫⁻ u : ℝ, K u ^ s)) := by
    refine le_trans (lintegral_mono hptwise) ?_
    rw [lintegral_const_mul' _ _ (by
      refine ENNReal.rpow_ne_top_of_nonneg ?_ hQfin
      have : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp1
      nlinarith)]
    exact mul_le_mul' le_rfl hyoung
  -- the `L^s` norm of the indicator
  have hKs : (∫⁻ u : ℝ, K u ^ s) = volume Q := by
    have hpt : ∀ u : ℝ, K u ^ s = K u := by
      intro u
      by_cases hu : u ∈ Q
      · simp [hK, Set.indicator_of_mem hu]
      · simp [hK, Set.indicator_of_notMem hu, ENNReal.zero_rpow_of_pos hs0]
    rw [lintegral_congr hpt]
    show (∫⁻ u : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) u) = volume Q
    rw [lintegral_indicator hQ]
    simp
  rw [hKs] at hmain
  -- assemble
  set G : ENNReal := ∫⁻ y : ℝ, F y ^ p with hG
  have hcollect : (volume Q) ^ ((1 - 1 / p) * q) *
      (G ^ (s - 1) * (G * volume Q)) =
      ((volume Q) ^ ((1 - 1 / p + 1 / q) * q)) * G ^ s := by
    rw [show G ^ (s - 1) * (G * volume Q) = (G ^ (s - 1) * G ^ (1 : ℝ)) * volume Q from by
      rw [ENNReal.rpow_one]; ring]
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) (by norm_num),
      show s - 1 + 1 = s from by ring]
    rw [show (volume Q) ^ ((1 - 1 / p) * q) * (G ^ s * volume Q) =
        ((volume Q) ^ ((1 - 1 / p) * q) * (volume Q) ^ (1 : ℝ)) * G ^ s from by
      rw [ENNReal.rpow_one]; ring]
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by
      have : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp1
      nlinarith) (by norm_num)]
    congr 2
    field_simp
  rw [hcollect] at hmain
  calc (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * F y) ^ q) ^ (1 / q)
      ≤ (((volume Q) ^ ((1 - 1 / p + 1 / q) * q)) * G ^ s) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = (volume Q) ^ (1 - 1 / p + 1 / q) * G ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]
        congr 2
        · field_simp
        · rw [hs]
          field_simp

/-! ## Linearizing the dilation supremum

Once the dilation `t` is confined to an interval `[u, v]`, the window
`(r - t + c₁, r - t + c₂]` of the `s`-integral is contained in a fixed
translate window measured from `r`, so the supremum over `t` is dominated by a
single convolution with the indicator of an interval of length
`(v - u) + (c₂ - c₁)`.  Together with `lintegral_indicator_conv_rpow_le` this is
the `m > ℓ` half of BRS Proposition 5.5(ii)–(iii). -/

/-- A supremum is bounded by the `ℓ^q` norm. -/
theorem iSup_le_rpow_tsum {ι : Type*} {X : ι → ENNReal} {q : ℝ} (hq0 : 0 < q) :
    (⨆ i, X i) ≤ (∑' i, X i ^ q) ^ (1 / q) := by
  refine iSup_le fun i => ?_
  have h1 : X i ^ q ≤ ∑' j, X j ^ q := ENNReal.le_tsum i
  calc X i = (X i ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑' j, X j ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow h1 (by positivity)

/-- A finite supremum is bounded by the `ℓ^q` norm. -/
theorem iSup_finset_le_rpow_sum {ι : Type*} {s : Finset ι} {X : ι → ENNReal}
    {q : ℝ} (hq0 : 0 < q) :
    (⨆ i ∈ s, X i) ≤ (∑ i ∈ s, X i ^ q) ^ (1 / q) := by
  refine iSup₂_le fun i hi => ?_
  have h1 : X i ^ q ≤ ∑ j ∈ s, X j ^ q :=
    Finset.single_le_sum (f := fun j => X j ^ q) (fun _ _ => zero_le) hi
  calc X i = (X i ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ j ∈ s, X j ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow h1 (by positivity)

/-- **The translation window.**  For `t` in `[u, v]` the shifted window sits
inside the reflected translate of a single interval. -/
theorem lintegral_shifted_window_le {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    (F : ℝ → ENNReal) (r : ℝ) :
    (∫⁻ s in Ioc (r - t + c₁) (r - t + c₂), F s) ≤
      ∫⁻ s : ℝ,
        Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - s) *
          F s := by
  obtain ⟨hu, hv⟩ := ht
  have hsub : Ioc (r - t + c₁) (r - t + c₂) ⊆
      (fun s : ℝ => r - s) ⁻¹' Ico (u - c₂) (v - c₁) := by
    intro s hs
    obtain ⟨h1, h2⟩ := hs
    constructor
    · have : r - s < t - c₁ := by linarith
      linarith
    · have : t - c₂ ≤ r - s := by linarith
      linarith
  rw [lintegral_indicator_shift measurableSet_Ico F r]
  exact lintegral_mono_set hsub

/-- The reflected translate window has the expected length. -/
theorem volume_shifted_window (u v c₁ c₂ : ℝ) :
    volume (Ico (u - c₂) (v - c₁)) = ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
  rw [Real.volume_Ico]
  congr 1
  ring

/-- **The `m > ℓ` estimate.**  Combining the translation window with Young's
inequality against an indicator bounds the `L^q` norm of the linearized piece
by `|window|^{1 - 1/p + 1/q} ‖F‖_p`. -/
theorem lintegral_shifted_window_rpow_le {u v c₁ c₂ : ℝ} (huv : u ≤ v)
    (hc : c₁ ≤ c₂) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v, ∫⁻ s in Ioc (r - (t : ℝ) + c₁) (r - (t : ℝ) + c₂), F s) ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hlen : (0 : ℝ) ≤ (v - u) + (c₂ - c₁) := by
    have : (0 : ℝ) ≤ v - u := by linarith
    have : (0 : ℝ) ≤ c₂ - c₁ := by linarith
    linarith
  have hptwise : ∀ r : ℝ,
      (⨆ t : Icc u v, ∫⁻ s in Ioc (r - (t : ℝ) + c₁) (r - (t : ℝ) + c₂), F s) ≤
        ∫⁻ s : ℝ,
          Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - s) *
            F s := by
    intro r
    exact iSup_le fun t => lintegral_shifted_window_le t.2 F r
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hptwise r) hq0.le)
    (by positivity)) ?_
  have hyoung := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
    measurableSet_Ico (by
      rw [volume_shifted_window]
      exact ENNReal.ofReal_ne_top) hF hp1 hpq
  rw [volume_shifted_window] at hyoung
  exact hyoung

/-! ## The mirrored translation window

`|r - t|` is `r - t` or `t - r`, and only the first is a translate of `r` in
the right direction.  For the second, reflecting the integration variable turns
it into a translate as well, at the cost of replacing `F` by `F ∘ (-·)` — this
is BRS's `Σ_±` with `h̃(s) = h(-s)`.  The reflection preserves every `L^p`
norm. -/

/-- Reflection preserves the integral. -/
theorem lintegral_comp_neg (F : ℝ → ENNReal) (hF : Measurable F) :
    (∫⁻ y : ℝ, F (-y)) = ∫⁻ y : ℝ, F y :=
  (Measure.measurePreserving_neg (volume : Measure ℝ)).lintegral_comp hF

/-- **The mirrored translation window.** -/
theorem lintegral_shifted_window_le' {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    {F : ℝ → ENNReal} (hF : Measurable F) (r : ℝ) :
    (∫⁻ s in Ioc (t - r + c₁) (t - r + c₂), F s) ≤
      ∫⁻ y : ℝ,
        Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
          F (-y) := by
  obtain ⟨hu, hv⟩ := ht
  set S : Set ℝ := Ioc (t - r + c₁) (t - r + c₂) with hS
  have hSmeas : MeasurableSet S := measurableSet_Ioc
  have hstep : (∫⁻ s in S, F s) =
      ∫⁻ y : ℝ, Set.indicator S (fun z => F z) (-y) := by
    rw [← lintegral_indicator hSmeas]
    exact (lintegral_comp_neg _ (hF.indicator hSmeas)).symm
  rw [hstep]
  refine lintegral_mono fun y => ?_
  by_cases hy : (-y) ∈ S
  · rw [Set.indicator_of_mem hy]
    obtain ⟨h1, h2⟩ := hy
    have hmem : r - y ∈ Ioc (u + c₁) (v + c₂) := by
      constructor
      · have : t - r + c₁ < -y := h1
        linarith
      · have : -y ≤ t - r + c₂ := h2
        linarith
    rw [Set.indicator_of_mem hmem, one_mul]
  · rw [Set.indicator_of_notMem hy]
    exact zero_le

/-- **The dyadic piece sits in an additive window.**  If `A/2 ≤ a < A` then the
`m`-th multiplicative piece of `(a, 2a]` lies in `(a + A·2^{-m-2}, a + A·2^{-m}]`,
whose endpoints no longer depend on `a`. -/
theorem brsNearPieceSet_subset_shift {a A : ℝ} (_hA : 0 < A) (ha1 : A / 2 ≤ a)
    (ha2 : a < A) (m : ℕ) :
    brsNearPieceSet a m ⊆
      Ioc (a + A * (1 / 2 : ℝ) ^ (m + 2)) (a + A * (1 / 2 : ℝ) ^ m) := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ m := by positivity
  have hsucc : (1 / 2 : ℝ) ^ (m + 1) = (1 / 2 : ℝ) ^ m / 2 := by
    rw [pow_succ]; ring
  have hsucc2 : (1 / 2 : ℝ) ^ (m + 2) = (1 / 2 : ℝ) ^ m / 4 := by
    rw [pow_succ, pow_succ]; ring
  constructor
  · have hlow : a + a * (1 / 2 : ℝ) ^ (m + 1) < s := by nlinarith
    have : A * (1 / 2 : ℝ) ^ (m + 2) ≤ a * (1 / 2 : ℝ) ^ (m + 1) := by
      rw [hsucc, hsucc2]
      nlinarith
    linarith
  · have hhigh : s ≤ a + a * (1 / 2 : ℝ) ^ m := by nlinarith
    have : a * (1 / 2 : ℝ) ^ m ≤ A * (1 / 2 : ℝ) ^ m := by nlinarith
    linarith

/-- The additive window has length `(3/4)·A·2^{-m}`. -/
theorem shift_window_length (a A : ℝ) (m : ℕ) :
    (a + A * (1 / 2 : ℝ) ^ m) - (a + A * (1 / 2 : ℝ) ^ (m + 2)) =
      A * (1 / 2 : ℝ) ^ m * (3 / 4) := by
  have hsucc2 : (1 / 2 : ℝ) ^ (m + 2) = (1 / 2 : ℝ) ^ m / 4 := by
    rw [pow_succ, pow_succ]; ring
  rw [hsucc2]
  ring

/-! ## The linearized window estimate, both signs

`|r - t|` is one of `r - t`, `t - r`, so the window integral is bounded by the
sum of the two signed ones, each of which is a convolution with an indicator of
an interval of length `(v - u) + (c₂ - c₁)`. -/

/-- Splitting on the sign of `r - t`. -/
theorem lintegral_abs_window_le (F : ℝ → ENNReal) (r t c₁ c₂ : ℝ) :
    (∫⁻ s in Ioc (|r - t| + c₁) (|r - t| + c₂), F s) ≤
      (∫⁻ s in Ioc (r - t + c₁) (r - t + c₂), F s) +
        ∫⁻ s in Ioc (t - r + c₁) (t - r + c₂), F s := by
  rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩
  · rw [h]
    exact le_add_right le_rfl
  · rw [h, neg_sub]
    exact le_add_left le_rfl

/-- **The mirrored Young estimate.** -/
theorem lintegral_shifted_window_rpow_le' {u v c₁ c₂ : ℝ} (_huv : u ≤ v)
    (_hc : c₁ ≤ c₂) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v,
          ∫⁻ s in Ioc ((t : ℝ) - r + c₁) ((t : ℝ) - r + c₂), F s) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  have hptwise : ∀ r : ℝ,
      (⨆ t : Icc u v, ∫⁻ s in Ioc ((t : ℝ) - r + c₁) ((t : ℝ) - r + c₂), F s) ≤
        ∫⁻ y : ℝ,
          Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
            F (-y) :=
    fun r => iSup_le fun t => lintegral_shifted_window_le' t.2 hF r
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hptwise r) hq0.le)
    (by positivity)) ?_
  have hvol : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hyoung := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
    measurableSet_Ioc (by rw [hvol]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
  rw [hvol] at hyoung
  refine le_trans hyoung (le_of_eq ?_)
  congr 1
  congr 1
  exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)

/-- The convolution with an indicator is measurable. -/
theorem measurable_indicator_conv {Q : Set ℝ} (hQ : MeasurableSet Q)
    {F : ℝ → ENNReal} (hF : Measurable F) :
    Measurable fun r : ℝ =>
      ∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (r - y) * F y := by
  have hK : Measurable (Set.indicator Q (fun _ => (1 : ENNReal))) :=
    measurable_const.indicator hQ
  have hjoint : Measurable (Function.uncurry fun r y : ℝ =>
      Set.indicator Q (fun _ => (1 : ENNReal)) (r - y) * F y) :=
    (hK.comp (measurable_fst.sub measurable_snd)).mul (hF.comp measurable_snd)
  exact hjoint.lintegral_prod_right' (ν := (volume : Measure ℝ))

/-- **The two-sided linearized window estimate.** -/
theorem lintegral_abs_window_rpow_le {u v c₁ c₂ : ℝ} (_huv : u ≤ v) (_hc : c₁ ≤ c₂)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v,
          ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q) ≤
      2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  set X : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) *
        F y with hXdef
  set Y : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
        F (-y) with hYdef
  have hXmeas : AEMeasurable X (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ico hF).aemeasurable
  have hYmeas : AEMeasurable Y (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ioc hFneg).aemeasurable
  have hsplit : ∀ r : ℝ,
      (⨆ t : Icc u v,
        ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤ X r + Y r := by
    intro r
    refine iSup_le fun t => ?_
    refine le_trans (lintegral_abs_window_le F r (t : ℝ) c₁ c₂) ?_
    exact add_le_add (lintegral_shifted_window_le t.2 F r)
      (lintegral_shifted_window_le' t.2 hF r)
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hsplit r) hq0.le)
    (by positivity)) ?_
  refine le_trans (ENNReal.lintegral_Lp_add_le hXmeas hYmeas hq1) ?_
  have hvol₁ : volume (Ico (u - c₂) (v - c₁)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have hvol₂ : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hX' : (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
      measurableSet_Ico (by rw [hvol₁]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
    rwa [hvol₁] at h
  have hY' : (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
      measurableSet_Ioc (by rw [hvol₂]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
    rw [hvol₂] at h
    refine le_trans h (le_of_eq ?_)
    congr 1
    congr 1
    exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)
  calc (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) + (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q)
      ≤ ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) +
          ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := add_le_add hX' hY'
    _ = 2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [two_mul]
        ring

/-! ## A measurable majorant for the linearized window operator

The supremum over `t` in an interval is not obviously measurable, so it is
replaced by the pair of convolutions that dominate it.  Those are measurable by
Tonelli, and carry the same `L^q` bound. -/

/-- The measurable majorant of the linearized window operator. -/
def brsWindowMaj (u v c₁ c₂ : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  (∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) * F y) +
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) * F (-y)

theorem measurable_brsWindowMaj (u v c₁ c₂ : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsWindowMaj u v c₁ c₂ F) := by
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  exact (measurable_indicator_conv measurableSet_Ico hF).add
    (measurable_indicator_conv measurableSet_Ioc hFneg)

/-- The majorant dominates the supremum over the dilation window. -/
theorem iSup_window_le_brsWindowMaj {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) (r : ℝ) :
    (⨆ t : Icc u v, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsWindowMaj u v c₁ c₂ F r := by
  refine iSup_le fun t => ?_
  refine le_trans (lintegral_abs_window_le F r (t : ℝ) c₁ c₂) ?_
  exact add_le_add (lintegral_shifted_window_le t.2 F r)
    (lintegral_shifted_window_le' t.2 hF r)

/-- The `L^q` bound for the majorant. -/
theorem lintegral_brsWindowMaj_rpow_le {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsWindowMaj u v c₁ c₂ F r ^ q) ^ (1 / q) ≤
      2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  set X : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) * F y
    with hXdef
  set Y : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) * F (-y)
    with hYdef
  have hXmeas : AEMeasurable X (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ico hF).aemeasurable
  have hYmeas : AEMeasurable Y (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ioc hFneg).aemeasurable
  have hvol₁ : volume (Ico (u - c₂) (v - c₁)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have hvol₂ : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hX' : (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
      measurableSet_Ico (by rw [hvol₁]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
    rwa [hvol₁] at h
  have hY' : (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
      measurableSet_Ioc (by rw [hvol₂]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
    rw [hvol₂] at h
    refine le_trans h (le_of_eq ?_)
    congr 1
    congr 1
    exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)
  refine le_trans (ENNReal.lintegral_Lp_add_le hXmeas hYmeas hq1) ?_
  calc (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) + (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q)
      ≤ ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) +
          ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := add_le_add hX' hY'
    _ = 2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [two_mul]
        ring

/-! ## The covered window estimate

Splitting the dilation set by a `δ`-cover turns the supremum over all of `E`
into a factor `N(E, δ)^{1/q}`.  This is the `m > ℓ` half of BRS Proposition
5.5(ii)–(iii). -/

theorem lintegral_cover_window_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (_hc : c₁ ≤ c₂) (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set M : ENNReal := 2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  -- each cover interval
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMaj_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤
        M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul' (mul_le_mul' le_rfl
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp)) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  -- the supremum over `E` is dominated by the majorants over the cover
  have hsup : ∀ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
        ⨆ a ∈ ι, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    intro r
    refine iSup_le fun t => ?_
    obtain ⟨a, haι, hat⟩ : ∃ a ∈ ι, (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
      have hcov := hι t.2
      simpa only [Set.mem_iUnion, exists_prop] using hcov
    refine le_iSup₂_of_le a haι ?_
    refine le_trans ?_ (iSup_window_le_brsWindowMaj (u := a - δ / 2)
      (v := a + δ / 2) hF r)
    exact le_iSup (fun u : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨(t : ℝ), hat⟩
  have hsum : ∀ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q ≤
        ∑ a ∈ ι, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    have h := le_trans (hsup r) (iSup_finset_le_rpow_sum (s := ι) (q := q) hq0)
    have := ENNReal.rpow_le_rpow h hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hmain : (∫⁻ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ≤
      (ι.card : ENNReal) * M ^ q := by
    refine le_trans (lintegral_mono hsum) ?_
    rw [lintegral_finsetSum' _ (fun a _ =>
      ((measurable_brsWindowMaj _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ ι, ∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ ι, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = (ι.card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ,
        (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q)
      ≤ ((ι.card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = (ι.card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The uniform per-piece bound

Once `a = |r - t|` is confined to a dyadic block `[A/2, A)`, the per-piece
Hölder bound becomes independent of `a` — and hence of `r` and `t`.  This is
the `m ≤ ℓ` half of BRS Proposition 5.5(ii)–(iii): the `L^q` norm then costs
only the measure of the shell. -/

/-- A negative power is antitone in the base. -/
theorem rpow_le_rpow_of_nonpos_exp {x y e : ℝ} (hx : 0 < x) (hxy : x ≤ y)
    (he : e ≤ 0) : y ^ e ≤ x ^ e := by
  have hy : 0 < y := lt_of_lt_of_le hx hxy
  rw [Real.rpow_def_of_pos hx, Real.rpow_def_of_pos hy]
  refine Real.exp_le_exp.mpr ?_
  have hlog : Real.log x ≤ Real.log y := Real.log_le_log hx hxy
  nlinarith

/-- **The uniform per-piece bound.** -/
theorem lintegral_nearPiece_le_uniform {p : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {A a : ℝ} (_hA : 0 < A) (ha1 : A / 2 ≤ a) (ha2 : a < A)
    {g : ℝ → ℂ} (hg : Measurable g) (m : ℕ) :
    (∫⁻ s in brsNearPieceSet a m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          (A / 2) ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hA2 : (0 : ℝ) < A / 2 := by linarith
  have ha0 : (0 : ℝ) < a := lt_of_lt_of_le hA2 ha1
  have hexp : 1 - 2 / p ≤ 0 := by
    have : (1 : ℝ) ≤ 2 / p := by
      rw [le_div_iff₀ hp0]
      linarith
    linarith
  have hθ : (0 : ℝ) < ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) :=
    Real.rpow_pos_of_pos (by positivity) _
  have hbase : a ^ (1 - 2 / p) ≤ (A / 2) ^ (1 - 2 / p) :=
    rpow_le_rpow_of_nonpos_exp hA2 ha1 hexp
  have hsub : Ioc a (2 * a) ⊆ Ioc (A / 2) (2 * A) := by
    intro s hs
    exact ⟨lt_of_le_of_lt ha1 hs.1, le_trans hs.2 (by linarith)⟩
  refine le_trans (lintegral_nearPiece_le hp1 hp2 ha0 hg m) ?_
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_)
    (ENNReal.rpow_le_rpow (lintegral_mono_set hsub) (by positivity))
  exact mul_le_mul_of_nonneg_left hbase hθ.le

/-! ## A measurable majorant for the covered window operator

The supremum over `t ∈ E` is not measurable, and the summation over `m` needs
Minkowski, which needs measurable summands.  So the supremum is replaced once
and for all by the `ℓ^q` sum of the window majorants over a chosen cover. -/

open Classical in
/-- A choice of optimal `δ`-cover of `E`. -/
def brsCoverFinset (E : Set ℝ) (δ : ℝ) : Finset ℝ :=
  if h : ∃ ι : Finset ℝ, IsIntervalCover E δ ι ∧
      ι.card = intervalCoveringNumber E δ then h.choose else ∅

theorem brsCoverFinset_spec {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) :
    IsIntervalCover E δ (brsCoverFinset E δ) ∧
      (brsCoverFinset E δ).card = intervalCoveringNumber E δ := by
  classical
  have h : ∃ ι : Finset ℝ, IsIntervalCover E δ ι ∧
      ι.card = intervalCoveringNumber E δ := by
    obtain ⟨ι, hι, hcard⟩ :=
      exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
    exact ⟨ι, hι, hcard⟩
  rw [brsCoverFinset, dif_pos h]
  exact h.choose_spec

/-- The measurable majorant of the covered window operator. -/
def brsCoverMaj (E : Set ℝ) (δ c₁ c₂ q : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  (∑ a ∈ brsCoverFinset E δ,
    brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q)

theorem measurable_brsCoverMaj (E : Set ℝ) (δ c₁ c₂ q : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsCoverMaj E δ c₁ c₂ q F) := by
  refine Measurable.pow_const ?_ (1 / q)
  exact Finset.measurable_sum _ fun a _ =>
    (measurable_brsWindowMaj _ _ _ _ hF).pow_const q

/-- The majorant dominates the supremum over `E`. -/
theorem iSup_le_brsCoverMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) {c₁ c₂ q : ℝ} (hq0 : 0 < q) {F : ℝ → ENNReal}
    (hF : Measurable F) (r : ℝ) :
    (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsCoverMaj E δ c₁ c₂ q F r := by
  obtain ⟨hι, _⟩ := brsCoverFinset_spec hE hδ
  refine iSup_le fun t => ?_
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ brsCoverFinset E δ,
      (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι t.2
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  have hle : (∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    refine le_trans ?_ (iSup_window_le_brsWindowMaj (u := a - δ / 2)
      (v := a + δ / 2) hF r)
    exact le_iSup (fun u : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨(t : ℝ), hat⟩
  refine le_trans hle ?_
  rw [brsCoverMaj]
  have hmem : brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q ≤
      ∑ b ∈ brsCoverFinset E δ,
        brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q :=
    Finset.single_le_sum
      (f := fun b => brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q)
      (fun _ _ => zero_le) haι
  calc brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r
      = (brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ b ∈ brsCoverFinset E δ,
          brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmem (by positivity)

/-- **The `L^q` bound for the covered window majorant.** -/
theorem lintegral_brsCoverMaj_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ^ (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨hι, hcard⟩ := brsCoverFinset_spec hE hδ
  set M : ENNReal := 2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMaj_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ,
        brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤ M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul' (mul_le_mul' le_rfl
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp)) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hpow : ∀ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q =
      ∑ a ∈ brsCoverFinset E δ,
        brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    rw [brsCoverMaj, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne',
      ENNReal.rpow_one]
  have hmain : (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ≤
      ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
    rw [lintegral_congr hpow,
      lintegral_finsetSum' _ (fun a _ =>
        ((measurable_brsWindowMaj _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ brsCoverFinset E δ,
          ∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ brsCoverFinset E δ, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ^ (1 / q)
      ≤ (((brsCoverFinset E δ).card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ((brsCoverFinset E δ).card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The dyadic blocks of `|r - t|`

`𝔐_{p,0}` is decomposed according to the size of `a = |r - t|`, which lies in
`(0, 2)` whenever the dilation window is non-empty.  Writing `A_j := 2·2^{-j}`,
every such `a` lies in exactly one block `[A_j/2, A_j)`. -/

/-- The dilations whose distance to `r` lies in the `j`-th dyadic block. -/
def brsBlockSet (E : Set ℝ) (A r : ℝ) : Set ℝ :=
  E ∩ {t | A / 2 ≤ |r - t| ∧ |r - t| < A}

/-- `𝔐_{p,0}^-` restricted to one dyadic block, without the radial factor. -/
def brsBlockMax (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (A r : ℝ) : ENNReal :=
  ⨆ t ∈ brsBlockSet E A r,
    ∫⁻ s in Ioc |r - t| (2 * |r - t|),
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖

/-- Every `a ∈ (0, 2)` lies in a dyadic block. -/
theorem exists_block_index {a : ℝ} (ha : 0 < a) (ha2 : a < 2) :
    ∃ j : ℕ, 2 * (1 / 2 : ℝ) ^ j / 2 ≤ a ∧ a < 2 * (1 / 2 : ℝ) ^ j := by
  classical
  have hex : ∃ j : ℕ, (1 / 2 : ℝ) ^ j ≤ a := by
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one ha (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨n, hn.le⟩
  set j : ℕ := Nat.find hex with hj
  have hlow : (1 / 2 : ℝ) ^ j ≤ a := Nat.find_spec hex
  have hhigh : a < 2 * (1 / 2 : ℝ) ^ j := by
    rcases Nat.eq_zero_or_pos j with hj0 | hjpos
    · rw [hj0]
      simpa using ha2
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, j = k + 1 := ⟨j - 1, by omega⟩
      have hklt : k < Nat.find hex := by
        rw [← hj]
        omega
      have hnot := Nat.find_min hex hklt
      have hidx : (1 / 2 : ℝ) ^ k = 2 * (1 / 2 : ℝ) ^ j := by
        rw [hk, pow_succ]
        ring
      rw [hidx] at hnot
      exact lt_of_not_ge hnot
  refine ⟨j, ?_, hhigh⟩
  have : 2 * (1 / 2 : ℝ) ^ j / 2 = (1 / 2 : ℝ) ^ j := by ring
  rw [this]
  exact hlow

/-- **The block decomposition of `𝔐_{p,0}^-`.** -/
theorem brsMainZeroLeft_le_tsum_blocks {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} (r : ℝ) :
    brsMainZeroLeft E p g r ≤
      ENNReal.ofReal r⁻¹ * ∑' j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r := by
  refine iSup₂_le fun t ht => ?_
  refine mul_le_mul' le_rfl ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  obtain ⟨htlo, hthi⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have ha2 : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  rcases eq_or_lt_of_le (abs_nonneg (r - t)) with hz | hapos
  · have hempty : Ioc |r - t| (2 * |r - t|) = (∅ : Set ℝ) := by
      rw [← hz]
      simp
    rw [hempty]
    simp
  · obtain ⟨j, hj1, hj2⟩ := exists_block_index hapos ha2
    have hmem : t ∈ brsBlockSet E (2 * (1 / 2 : ℝ) ^ j) r := ⟨htE, hj1, hj2⟩
    refine le_trans ?_ (ENNReal.le_tsum j)
    exact le_iSup₂ (f := fun t (_ : t ∈ brsBlockSet E (2 * (1 / 2 : ℝ) ^ j) r) =>
      ∫⁻ s in Ioc |r - t| (2 * |r - t|),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) t hmem

/-! ## The two bounds for a single block and piece

On the block `[A/2, A)` the `m`-th piece admits two estimates: the uniform
Hölder bound, which is constant in `r`, and the covered-window bound, which
carries the covering number at the fine scale `A·2^{-m}`.  BRS use the first for
`m ≤ ℓ` and the second for `m > ℓ`. -/

/-- `𝔐_{p,0}^-` restricted to one dyadic block and one dyadic piece. -/
def brsBlockPieceMax (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (A : ℝ) (m : ℕ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ brsBlockSet E A r,
    ∫⁻ s in brsNearPieceSet |r - t| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖

/-- The profile localized to the `s`-window of a block. -/
def brsBlockProfile (A : ℝ) (g : ℝ → ℂ) : ℝ → ENNReal :=
  Set.indicator (Ioc (A / 2) (2 * A)) (fun z => ENNReal.ofReal ‖g z‖)

theorem measurable_brsBlockProfile (A : ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsBlockProfile A g) :=
  (hg.norm.ennreal_ofReal).indicator measurableSet_Ioc

theorem lintegral_brsBlockProfile_rpow (A : ℝ) {g : ℝ → ℂ} {p : ℝ} (hp0 : 0 < p) :
    (∫⁻ s : ℝ, brsBlockProfile A g s ^ p) =
      ∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p := by
  rw [← lintegral_indicator measurableSet_Ioc]
  refine lintegral_congr fun s => ?_
  by_cases hs : s ∈ Ioc (A / 2) (2 * A)
  · rw [brsBlockProfile, Set.indicator_of_mem hs, Set.indicator_of_mem hs]
  · rw [brsBlockProfile, Set.indicator_of_notMem hs, Set.indicator_of_notMem hs,
      ENNReal.zero_rpow_of_pos hp0]

/-- The block is decomposed into the dyadic pieces. -/
theorem brsBlockMax_le_tsum {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {A : ℝ} (_hA : 0 < A)
    (r : ℝ) :
    brsBlockMax E p g A r ≤ ∑' m : ℕ, brsBlockPieceMax E p g A m r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have ha0 : (0 : ℝ) < |r - t| := lt_of_lt_of_le (by linarith) ht1
  refine le_trans (lintegral_near_le_tsum_pieces ha0 _) ?_
  refine ENNReal.tsum_le_tsum fun m => ?_
  exact le_iSup₂ (f := fun u (_ : u ∈ brsBlockSet E A r) =>
    ∫⁻ s in brsNearPieceSet |r - u| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - u|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖) t ⟨htE, ht1, ht2⟩

/-- **The uniform Hölder bound for one block and piece.**  Independent of `r`. -/
theorem brsBlockPieceMax_le_const {E : Set ℝ} {p : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {g : ℝ → ℂ} (hg : Measurable g) {A : ℝ} (hA : 0 < A) (m : ℕ) (r : ℝ) :
    brsBlockPieceMax E p g A m r ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          (A / 2) ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  exact lintegral_nearPiece_le_uniform hp1 hp2 hA ht1 ht2 hg m

/-- **The covered-window bound for one block and piece.** -/
theorem brsBlockPieceMax_le_cover {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g)
    {A : ℝ} (hA : 0 < A) (m : ℕ) (r : ℝ) :
    brsBlockPieceMax E p g A m r ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q
          (brsBlockProfile A g) r := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hA2 : (0 : ℝ) < A / 2 := by linarith
  have hδ : (0 : ℝ) < A * (1 / 2) ^ m := by positivity
  set c₁ : ℝ := A * (1 / 2 : ℝ) ^ (m + 2) with hc₁
  set c₂ : ℝ := A * (1 / 2 : ℝ) ^ m with hc₂
  set F : ℝ → ENNReal := brsBlockProfile A g with hF
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have ha0 : (0 : ℝ) < |r - t| := lt_of_lt_of_le hA2 ht1
  -- the weight is bounded on the piece
  have hweight : (∫⁻ s in brsNearPieceSet |r - t| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        ∫⁻ s in Ioc (|r - t| + c₁) (|r - t| + c₂), F s := by
    have hstep : (∫⁻ s in brsNearPieceSet |r - t| m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          ∫⁻ s in brsNearPieceSet |r - t| m, F s := by
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hsmem : s ∈ Ioc (A / 2) (2 * A) := by
        have hsub := brsNearPieceSet_subset_shift hA ht1 ht2 m
        have hmem := hsub hs
        obtain ⟨h1, h2⟩ := hmem
        constructor
        · have : (0 : ℝ) < c₁ := by rw [hc₁]; positivity
          linarith
        · have hc₂le : c₂ ≤ A := by
            rw [hc₂]
            have : (1 / 2 : ℝ) ^ m ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
            nlinarith
          linarith
      have hFs : F s = ENNReal.ofReal ‖g s‖ := by
        rw [hF, brsBlockProfile, Set.indicator_of_mem hsmem]
      rw [hFs]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      have hw := mainWeight_piece_le hp1 hp2 ha0 hs
      have hbase : |r - t| ^ (-(1 / p) : ℝ) ≤ (A / 2) ^ (-(1 / p) : ℝ) :=
        rpow_le_rpow_of_nonpos_exp hA2 ht1 (by
          have h : (0 : ℝ) < 1 / p := by positivity
          linarith)
      refine le_trans hw ?_
      exact mul_le_mul_of_nonneg_left hbase
        (Real.rpow_nonneg (by positivity) _)
    refine le_trans hstep (mul_le_mul' le_rfl ?_)
    exact lintegral_mono_set (brsNearPieceSet_subset_shift hA ht1 ht2 m)
  refine le_trans hweight (mul_le_mul' le_rfl ?_)
  -- the window is dominated by the covered majorant
  refine le_trans ?_ (iSup_le_brsCoverMaj hE hδ hq0 hFmeas r)
  exact le_iSup (fun u : E =>
    ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨t, htE⟩

/-! ## The block estimate on a shell

Summing the two per-piece bounds over `m` with Minkowski gives, for one shell
and one dyadic block, the estimate that carries all the analysis of BRS
Proposition 5.5(ii)–(iii).  Which of the two bounds is used for which `m` is
left to the arithmetic: the statement takes their minimum. -/

/-- The `L^q` norm of a constant on a set. -/
theorem lintegral_indicator_const_rpow {S : Set ℝ} (hS : MeasurableSet S)
    {c : ENNReal} {q : ℝ} (hq0 : 0 < q) :
    (∫⁻ r : ℝ, Set.indicator S (fun _ => c) r ^ q) ^ (1 / q) =
      c * volume S ^ (1 / q) := by
  have hpt : ∀ r : ℝ, Set.indicator S (fun _ => c) r ^ q =
      Set.indicator S (fun _ => c ^ q) r := by
    intro r
    by_cases hr : r ∈ S
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0]
  rw [lintegral_congr hpt, lintegral_indicator hS, setLIntegral_const,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hq0.ne', ENNReal.rpow_one]

/-- **The block estimate on a shell.** -/
theorem lintegral_brsBlockMax_shell_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hpq : p ≤ q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA : 0 < A) (n : ℕ) :
    (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) ^ (1 / q) ≤
      ∑' m : ℕ,
        min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
                (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
            (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
                (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                  (1 - 1 / p + 1 / q)))) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  set F : ℝ → ENNReal := brsBlockProfile A g with hFdef
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = GA := by
    rw [hFdef, lintegral_brsBlockProfile_rpow A hp0, hGA]
  -- the two per-piece majorants
  set CH : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p)) with hCH
  set W : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ)) with hW
  set Θ : ℕ → ℝ → ENNReal := fun m r =>
    min (Set.indicator (brsD E n) (fun _ => CH m * GA) r)
      (W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
        (A * (1 / 2) ^ m) q F r) with hΘ
  have hΘmeas : ∀ m : ℕ, Measurable (Θ m) := by
    intro m
    refine Measurable.min ?_ ?_
    · exact measurable_const.indicator (measurableSet_brsD E n)
    · exact measurable_const.mul (measurable_brsCoverMaj _ _ _ _ _ hFmeas)
  -- the pointwise bound
  have hpt : ∀ r : ℝ,
      Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ≤ ∑' m, Θ m r := by
    intro r
    by_cases hr : r ∈ brsD E n
    · rw [Set.indicator_of_mem hr]
      refine le_trans (brsBlockMax_le_tsum hA r) ?_
      refine ENNReal.tsum_le_tsum fun m => ?_
      refine le_min ?_ ?_
      · rw [Set.indicator_of_mem hr, hCH, hGA]
        exact brsBlockPieceMax_le_const hp1 hp2 hg hA m r
      · rw [hW]
        exact brsBlockPieceMax_le_cover hE hp1 hp2 hq0 hg hA m r
    · rw [Set.indicator_of_notMem hr]
      exact zero_le
  -- the two `L^q` bounds for each `Θ m`
  have hΘbound : ∀ m : ℕ, (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
      min (CH m * volume (brsD E n) ^ (1 / q))
        (W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)))) *
        GA := by
    intro m
    have hδ : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
    have hlen : A * (1 / 2 : ℝ) ^ m - A * (1 / 2 : ℝ) ^ (m + 2) ≤
        A * (1 / 2 : ℝ) ^ m := by
      have : (0 : ℝ) ≤ A * (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hb1 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        CH m * GA * volume (brsD E n) ^ (1 / q) := by
      have hmono : ∀ r : ℝ, Θ m r ≤ Set.indicator (brsD E n) (fun _ => CH m * GA) r :=
        fun r => min_le_left _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      exact le_of_eq (lintegral_indicator_const_rpow (measurableSet_brsD E n) hq0)
    have hb2 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
          GA := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r := fun r => min_le_right _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      have hconst : (∫⁻ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
          (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q) ^ (1 / q) =
          W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q) := by
        have hpull : ∀ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
            (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q =
            W m ^ q * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
              (A * (1 / 2) ^ m) q F r ^ q :=
          fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le
        rw [lintegral_congr hpull, lintegral_const_mul' _ _ (by
          refine ENNReal.rpow_ne_top_of_nonneg hq0.le ?_
          rw [hW]
          exact ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
      rw [hconst]
      have hcov := lintegral_brsCoverMaj_rpow_le hE hδ hlen hFmeas hp1 hpq
      rw [hFnorm] at hcov
      calc W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q)
          ≤ W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)) *
              GA) := mul_le_mul' le_rfl hcov
        _ = W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
              GA := by ring
    rw [← min_mul_mul_right]
    exact le_min (hb1.trans (le_of_eq (by ring))) hb2
  -- assemble
  have hrewrite : (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) =
      ∫⁻ r : ℝ,
        Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ^ q := by
    rw [← lintegral_indicator (measurableSet_brsD E n)]
    refine lintegral_congr fun r => ?_
    by_cases hr : r ∈ brsD E n
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0]
  rw [hrewrite]
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hpt r) hq0.le)
    (by positivity)) ?_
  refine le_trans (lintegral_rpow_tsum_le hq1 hΘmeas) ?_
  exact ENNReal.tsum_le_tsum hΘbound

/-! ## The two arms of the block estimate, evaluated

With the covering hypothesis of BRS (5.15) in hand, both arms of the minimum in
`lintegral_brsBlockMax_shell_le` become explicit powers of two: the covered arm
decays like `2^{-m(1/p-1/2)}` and does not see the block or the shell, while the
Hölder arm grows like `2^{m(1/p-1/2)}` but carries the factor
`(2^{-n}/A)^{2/p-1}`, which is the `ℓ`-decay. -/

theorem half_pow_eq (k : ℕ) : ((1 / 2 : ℝ) ^ k) = (2 : ℝ) ^ (-(k : ℝ)) := by
  rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]

/-- Interpolation between the two arms of a minimum. -/
theorem min_le_rpow_mul_rpow {a b : ENNReal} {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    min a b ≤ a ^ (1 - t) * b ^ t := by
  have h : min a b = (min a b) ^ (1 - t) * (min a b) ^ t := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) ht0]
    simp
  rw [h]
  exact mul_le_mul' (ENNReal.rpow_le_rpow (min_le_left a b) (by linarith))
    (ENNReal.rpow_le_rpow (min_le_right a b) ht0)

/-- **The covering hypothesis of BRS (5.15), in dyadic form.** -/
def HasBRSCoveringBound (E : Set ℝ) (p q AE : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ → δ ≤ 6 →
    (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) ≤
      ENNReal.ofReal (AE * δ ^ (-(1 - 2 / p + 1 / q)))

/-- The real identity behind the covered arm. -/
theorem brs_arm_real_identity {A : ℝ} (hA : 0 < A) {p q : ℝ} (m : ℕ) :
    (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * (A / 2) ^ (-(1 / p) : ℝ)) *
      ((A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
        (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q))) =
      (2 : ℝ) ^ (5 / 2 + 1 / q) * (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hu0 : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
  have hθ : ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) =
      (2 : ℝ) ^ (((m : ℝ) + 1) / 2) := by
    rw [half_pow_eq, ← Real.rpow_mul h2.le]
    congr 1
    push_cast
    ring
  have hA2 : (A / 2 : ℝ) ^ (-(1 / p) : ℝ) =
      A ^ (-(1 / p) : ℝ) * (2 : ℝ) ^ (1 / p) := by
    rw [div_eq_mul_inv, Real.mul_rpow hA.le (by norm_num),
      Real.inv_rpow h2.le, ← Real.rpow_neg h2.le, neg_neg]
  have hupow : ∀ e : ℝ, (A * (1 / 2 : ℝ) ^ m) ^ e =
      A ^ e * (2 : ℝ) ^ (-((m : ℝ) * e)) := by
    intro e
    rw [half_pow_eq, Real.mul_rpow hA.le (Real.rpow_nonneg h2.le _),
      ← Real.rpow_mul h2.le]
    congr 2
    ring
  have h2u : ∀ e : ℝ, (2 * (A * (1 / 2 : ℝ) ^ m)) ^ e =
      (2 : ℝ) ^ e * (A ^ e * (2 : ℝ) ^ (-((m : ℝ) * e))) := by
    intro e
    rw [Real.mul_rpow h2.le hu0.le, hupow e]
  rw [hθ, hA2, hupow (-(1 - 2 / p + 1 / q)), h2u (1 - 1 / p + 1 / q)]
  have hAcancel : A ^ (-(1 / p) : ℝ) * A ^ (-(1 - 2 / p + 1 / q)) *
      A ^ (1 - 1 / p + 1 / q) = 1 := by
    rw [← Real.rpow_add hA, ← Real.rpow_add hA]
    have hzero : -(1 / p) + -(1 - 2 / p + 1 / q) + (1 - 1 / p + 1 / q) = 0 := by
      ring
    rw [hzero, Real.rpow_zero]
  have h2one : (2 : ℝ) = (2 : ℝ) ^ (1 : ℝ) := by
    rw [Real.rpow_one]
  calc (2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (A ^ (-(1 / p) : ℝ) * (2 : ℝ) ^ (1 / p)) *
        (A ^ (-(1 - 2 / p + 1 / q)) *
            (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
          (2 * ((2 : ℝ) ^ (1 - 1 / p + 1 / q) *
            (A ^ (1 - 1 / p + 1 / q) *
              (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q)))))))
      = (A ^ (-(1 / p) : ℝ) * A ^ (-(1 - 2 / p + 1 / q)) *
            A ^ (1 - 1 / p + 1 / q)) *
          ((2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (2 : ℝ) ^ (1 / p) *
            (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
            (2 : ℝ) ^ (1 : ℝ) * (2 : ℝ) ^ (1 - 1 / p + 1 / q) *
            (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q)))) := by
        rw [← h2one]
        ring
    _ = (2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (2 : ℝ) ^ (1 / p) *
          (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
          (2 : ℝ) ^ (1 : ℝ) * (2 : ℝ) ^ (1 - 1 / p + 1 / q) *
          (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q))) := by
        rw [hAcancel, one_mul]
    _ = (2 : ℝ) ^ ((((m : ℝ) + 1) / 2) + (1 / p) +
          (-((m : ℝ) * -(1 - 2 / p + 1 / q))) + (1 : ℝ) + (1 - 1 / p + 1 / q) +
          (-((m : ℝ) * (1 - 1 / p + 1 / q)))) := by
        rw [← Real.rpow_add h2, ← Real.rpow_add h2, ← Real.rpow_add h2,
          ← Real.rpow_add h2, ← Real.rpow_add h2]
    _ = (2 : ℝ) ^ (5 / 2 + 1 / q) * (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by
        rw [← Real.rpow_add h2]
        congr 1
        ring

/-- **The covered arm.** -/
theorem brs_cover_arm_le {E : Set ℝ} {p q AE : ℝ} (hp1 : 1 ≤ p) (_hq0 : 0 < q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE)
    {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (m : ℕ) :
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
        (A / 2) ^ (-(1 / p) : ℝ)) *
      ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) ≤
      ENNReal.ofReal (AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))))) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have h2 : (0 : ℝ) < 2 := by norm_num
  set u : ℝ := A * (1 / 2 : ℝ) ^ m with hu
  have hu0 : 0 < u := by rw [hu]; positivity
  have hu1 : u ≤ 6 := by
    rw [hu]
    have hpow : (1 / 2 : ℝ) ^ m ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have hcv := hcov u hu0 hu1
  have hpow2 : ENNReal.ofReal (2 * u) ^ (1 - 1 / p + 1 / q) =
      ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q)) :=
    ENNReal.ofReal_rpow_of_pos (by positivity)
  have hnn₁ : (0 : ℝ) ≤ ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ) :=
    mul_nonneg (Real.rpow_nonneg (by positivity) _)
      (Real.rpow_nonneg (by positivity) _)
  rw [hpow2]
  calc ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        ((intervalCoveringNumber E u : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q))))
      ≤ ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          (ENNReal.ofReal (AE * u ^ (-(1 - 2 / p + 1 / q))) *
            (2 * ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q)))) :=
        mul_le_mul' le_rfl (mul_le_mul' hcv le_rfl)
    _ = ENNReal.ofReal ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          (AE * u ^ (-(1 - 2 / p + 1 / q)) *
            (2 * (2 * u) ^ (1 - 1 / p + 1 / q)))) := by
        rw [show (2 : ENNReal) = ENNReal.ofReal 2 from by
          rw [ENNReal.ofReal_ofNat]]
        rw [← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hnn₁]
    _ = ENNReal.ofReal (AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
          (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))))) := by
        congr 1
        rw [hu] at *
        calc (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * (A / 2) ^ (-(1 / p) : ℝ)) *
              (AE * (A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
                (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q)))
            = AE * ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
                (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q)))) := by
              ring
          _ = AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
                (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2)))) := by
              rw [brs_arm_real_identity hA0 m]

/-! ## The Hölder arm, evaluated

The Hölder arm is the constant bound times `|D_n|^{1/q}`; feeding
`volume_brsD_le` and the covering hypothesis at the shell scale turns it into
`2^{(m+1)(1/p-1/2)}·(2^{-n}/A)^{2/p-1}`, whose second factor is the `ℓ`-decay. -/

/-- The real identity behind the Hölder arm. -/
theorem brs_holder_real_identity {A σ : ℝ} (hA : 0 < A) (hσ : 0 < σ) {p q : ℝ}
    (m : ℕ) :
    (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
      ((7 * σ) ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q))) =
      (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * (σ / A) ^ (2 / p - 1) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hθ : ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) =
      (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) := by
    rw [half_pow_eq, ← Real.rpow_mul h2.le]
    congr 1
    push_cast
    ring
  have hA2 : (A / 2 : ℝ) ^ (1 - 2 / p) =
      A ^ (1 - 2 / p) * (2 : ℝ) ^ (2 / p - 1) := by
    rw [div_eq_mul_inv, Real.mul_rpow hA.le (by norm_num),
      Real.inv_rpow h2.le, ← Real.rpow_neg h2.le]
    congr 2
    ring
  have h7 : ((7 : ℝ) * σ) ^ (1 / q) = (7 : ℝ) ^ (1 / q) * σ ^ (1 / q) :=
    Real.mul_rpow (by norm_num) hσ.le
  have hquot : (σ / A) ^ (2 / p - 1) =
      σ ^ (2 / p - 1) * A ^ (1 - 2 / p) := by
    rw [div_eq_mul_inv, Real.mul_rpow hσ.le (by positivity),
      Real.inv_rpow hA.le, ← Real.rpow_neg hA.le]
    congr 2
    ring
  rw [hθ, hA2, h7, hquot]
  have hσcancel : σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)) = σ ^ (2 / p - 1) := by
    rw [← Real.rpow_add hσ]
    congr 1
    ring
  calc (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
        (A ^ (1 - 2 / p) * (2 : ℝ) ^ (2 / p - 1)) *
        ((7 : ℝ) ^ (1 / q) * σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)))
      = (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
          ((σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q))) * A ^ (1 - 2 / p)) := by
        ring
    _ = (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
          (σ ^ (2 / p - 1) * A ^ (1 - 2 / p)) := by
        rw [hσcancel]

/-- **The Hölder arm.** -/
theorem brs_holder_arm_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hq0 : 0 < q) (_hAE : 0 ≤ AE)
    (hcov : HasBRSCoveringBound E p q AE) {A : ℝ} (hA0 : 0 < A) (n m : ℕ) :
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
        (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q) ≤
      ENNReal.ofReal (AE * ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ (2 / p - 1))) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have h2 : (0 : ℝ) < 2 := by norm_num
  set σ : ℝ := (2 : ℝ) ^ (-(n : ℝ)) with hσdef
  have hσ0 : 0 < σ := by rw [hσdef]; positivity
  have hσ1 : σ ≤ 6 := by
    have hle : σ ≤ 1 := by
      rw [hσdef]
      refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
      simp
    linarith
  have hzpow : ((2 : ℝ) ^ (-(n : ℤ))) = σ := by
    rw [hσdef, ← Real.rpow_intCast]
    congr 1
    push_cast
    ring
  -- the shell measure
  have hvol := volume_brsD_le hE hEne n
  rw [hzpow] at hvol
  have hnn : (0 : ℝ) ≤ ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p) :=
    mul_nonneg (Real.rpow_nonneg (by positivity) _)
      (Real.rpow_nonneg (by positivity) _)
  have hstep : volume (brsD E n) ^ (1 / q) ≤
      ENNReal.ofReal ((7 * σ) ^ (1 / q)) *
        ENNReal.ofReal (AE * σ ^ (-(1 - 2 / p + 1 / q))) := by
    refine le_trans (ENNReal.rpow_le_rpow hvol (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ENNReal.ofReal_rpow_of_pos (by positivity)]
    exact mul_le_mul' le_rfl (hcov σ hσ0 hσ1)
  refine le_trans (mul_le_mul' le_rfl hstep) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hnn]
  congr 1
  calc (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
        ((7 * σ) ^ (1 / q) * (AE * σ ^ (-(1 - 2 / p + 1 / q))))
      = AE * ((((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
          ((7 * σ) ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)))) := by ring
    _ = AE * ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * (σ / A) ^ (2 / p - 1)) := by
        rw [brs_holder_real_identity hA0 hσ0 m]

/-! ## Interpolating and summing the two arms

`min u v ≤ u^{1/4} v^{3/4}` turns the growing arm `2^{(m+1)β}x^{2β}` and the
decaying arm `2^{-mβ}` into the single summable term
`2^{β/4} x^{β/2} 2^{-mβ/2}`, whose `m`-sum is geometric. -/

theorem ofReal_min_eq (u v : ℝ) :
    ENNReal.ofReal (min u v) = min (ENNReal.ofReal u) (ENNReal.ofReal v) := by
  rcases le_total u v with h | h
  · rw [min_eq_left h, min_eq_left (ENNReal.ofReal_le_ofReal h)]
  · rw [min_eq_right h, min_eq_right (ENNReal.ofReal_le_ofReal h)]

/-- The real interpolation inequality. -/
theorem min_le_rpow_mul_rpow_real {u v : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) :
    min u v ≤ u ^ ((1 : ℝ) / 4) * v ^ ((3 : ℝ) / 4) := by
  have hmin : (0 : ℝ) ≤ min u v := le_min hu hv
  have hsplit : min u v = (min u v) ^ ((1 : ℝ) / 4) * (min u v) ^ ((3 : ℝ) / 4) := by
    rw [← Real.rpow_add' hmin (by norm_num)]
    norm_num
  rw [hsplit]
  exact mul_le_mul (Real.rpow_le_rpow hmin (min_le_left u v) (by norm_num))
    (Real.rpow_le_rpow hmin (min_le_right u v) (by norm_num))
    (Real.rpow_nonneg hmin _) (Real.rpow_nonneg hu _)

/-- The geometric series in the piece index. -/
theorem tsum_two_rpow_neg_mul {β : ℝ} (hβ : 0 < β) :
    ∑' m : ℕ, (2 : ℝ) ^ (-((m : ℝ) * β)) = (1 - (2 : ℝ) ^ (-β))⁻¹ := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hr : ∀ m : ℕ, (2 : ℝ) ^ (-((m : ℝ) * β)) = ((2 : ℝ) ^ (-β)) ^ m := by
    intro m
    rw [← Real.rpow_natCast ((2 : ℝ) ^ (-β)) m, ← Real.rpow_mul h2.le]
    congr 1
    ring
  rw [tsum_congr hr]
  have hlt : (2 : ℝ) ^ (-β) < 1 := by
    refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
    linarith
  exact tsum_geometric_of_lt_one (Real.rpow_nonneg h2.le _) hlt

/-- **The interpolated per-piece bound.** -/
theorem brs_interp_term_le {C₁ C₂ β x : ℝ} (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hx : 0 < x) (m : ℕ) :
    min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
        (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β))) ≤
      C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) * x ^ (β / 2) *
        (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hu : (0 : ℝ) ≤ C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
    have h1 : (0 : ℝ) ≤ (2 : ℝ) ^ (((m : ℝ) + 1) * β) := Real.rpow_nonneg h2.le _
    have h3 : (0 : ℝ) ≤ x ^ (2 * β) := Real.rpow_nonneg hx.le _
    positivity
  have hv : (0 : ℝ) ≤ C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
    have h1 : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * β)) := Real.rpow_nonneg h2.le _
    positivity
  refine le_trans (min_le_rpow_mul_rpow_real hu hv) (le_of_eq ?_)
  have hupow : (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β)) ^ ((1 : ℝ) / 4) =
      C₁ ^ ((1 : ℝ) / 4) * (2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) * x ^ (β / 2) := by
    rw [Real.mul_rpow (by positivity) (Real.rpow_nonneg hx.le _),
      Real.mul_rpow hC₁ (Real.rpow_nonneg h2.le _),
      ← Real.rpow_mul h2.le, ← Real.rpow_mul hx.le]
    congr 2 <;> ring
  have hvpow : (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β))) ^ ((3 : ℝ) / 4) =
      C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4)) := by
    rw [Real.mul_rpow hC₂ (Real.rpow_nonneg h2.le _), ← Real.rpow_mul h2.le]
    congr 2
    ring
  rw [hupow, hvpow]
  calc C₁ ^ ((1 : ℝ) / 4) * (2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) * x ^ (β / 2) *
        (C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4)))
      = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * x ^ (β / 2) *
          ((2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) *
            (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4))) := by ring
    _ = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * x ^ (β / 2) *
          ((2 : ℝ) ^ (β / 4) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
        rw [← Real.rpow_add h2, ← Real.rpow_add h2]
        congr 1
        ring
    _ = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) * x ^ (β / 2) *
          (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring

/-! ## The block estimate on a shell, evaluated

Combining the two evaluated arms with the interpolation and the geometric sum
gives the estimate for one shell and one dyadic block, with the `ℓ`-decay
`(2^{-n}/A)^{β/2}` explicit. -/

/-- The constant of the block estimate. -/
def brsBlockConst (p q : ℝ) : ℝ :=
  ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1)) ^ ((1 : ℝ) / 4) *
      ((2 : ℝ) ^ (5 / 2 + 1 / q)) ^ ((3 : ℝ) / 4) *
      (2 : ℝ) ^ ((1 / p - 1 / 2) / 4) *
    (1 - (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)))⁻¹

theorem brsBlockConst_nonneg {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) :
    0 ≤ brsBlockConst p q := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hlt : (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hden : (0 : ℝ) < 1 - (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)) := by linarith
  rw [brsBlockConst]
  have h1 : (0 : ℝ) ≤ ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1)) ^ ((1 : ℝ) / 4) :=
    Real.rpow_nonneg (by positivity) _
  have h3 : (0 : ℝ) ≤ ((2 : ℝ) ^ (5 / 2 + 1 / q)) ^ ((3 : ℝ) / 4) :=
    Real.rpow_nonneg (by positivity) _
  have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ ((1 / p - 1 / 2) / 4) := Real.rpow_nonneg h2.le _
  positivity

/-- **The block estimate on a shell, evaluated.** -/
theorem lintegral_brsBlockMax_shell_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (n : ℕ) :
    (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ ((1 / p - 1 / 2) / 2)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hp1) hpq
  have h2 : (0 : ℝ) < 2 := by norm_num
  set β : ℝ := 1 / p - 1 / 2 with hβdef
  have hβ : 0 < β := by
    rw [hβdef]
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hβ2 : 2 * β = 2 / p - 1 := by rw [hβdef]; ring
  set x : ℝ := ((2 : ℝ) ^ (-(n : ℝ))) / A with hxdef
  have hx : 0 < x := by rw [hxdef]; positivity
  set C₁ : ℝ := (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) with hC₁
  set C₂ : ℝ := (2 : ℝ) ^ (5 / 2 + 1 / q) with hC₂
  have hC₁0 : 0 ≤ C₁ := by rw [hC₁]; positivity
  have hC₂0 : 0 ≤ C₂ := by rw [hC₂]; positivity
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the term-by-term bound
  have hterm : ∀ m : ℕ,
      min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
          (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
              (A / 2) ^ (-(1 / p) : ℝ)) *
            ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                (1 - 1 / p + 1 / q)))) ≤
        ENNReal.ofReal (AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) *
          (2 : ℝ) ^ (β / 4) * x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
    intro m
    have harm₁ := brs_holder_arm_le hE hEne hp1 hq0 hAE hcov hA0 n m
    have harm₂ := brs_cover_arm_le hp1 hq0 hAE hcov hA0 hA1 m
    have hmin := min_le_min harm₁ harm₂
    refine le_trans hmin ?_
    rw [← ofReal_min_eq]
    refine ENNReal.ofReal_le_ofReal ?_
    have hfact : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
        min (AE * a) (AE * b) = AE * min a b := by
      intro a b ha hb
      rcases le_total a b with h | h
      · rw [min_eq_left h, min_eq_left (mul_le_mul_of_nonneg_left h hAE)]
      · rw [min_eq_right h, min_eq_right (mul_le_mul_of_nonneg_left h hAE)]
    have ha0 : (0 : ℝ) ≤ (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) := by
      have : (0 : ℝ) ≤ x ^ (2 / p - 1) := Real.rpow_nonneg hx.le _
      positivity
    have hb0 : (0 : ℝ) ≤ (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by positivity
    rw [hfact _ _ ha0 hb0]
    have hshape₁ : (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) =
        C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
      rw [hC₁, hβdef, hβ2]
    have hshape₂ : (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) =
        C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
      rw [hC₂, hβdef]
    rw [hshape₁, hshape₂]
    have hinterp := brs_interp_term_le (β := β) hC₁0 hC₂0 hx m
    calc AE * min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
            (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)))
        ≤ AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) :=
          mul_le_mul_of_nonneg_left hinterp hAE
      _ = AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring
  -- the geometric sum
  set K : ℝ := AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
    x ^ (β / 2)) with hK
  have hK0 : 0 ≤ K := by
    rw [hK]
    have h1 : (0 : ℝ) ≤ C₁ ^ ((1 : ℝ) / 4) := Real.rpow_nonneg hC₁0 _
    have h3 : (0 : ℝ) ≤ C₂ ^ ((3 : ℝ) / 4) := Real.rpow_nonneg hC₂0 _
    have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ (β / 4) := Real.rpow_nonneg h2.le _
    have h5 : (0 : ℝ) ≤ x ^ (β / 2) := Real.rpow_nonneg hx.le _
    positivity
  have hsummable : Summable fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
    have hr : (fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) =
        fun m : ℕ => ((2 : ℝ) ^ (-(β / 2))) ^ m := by
      funext m
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (-(β / 2))) m, ← Real.rpow_mul h2.le]
      congr 1
      ring
    rw [hr]
    exact summable_geometric_of_lt_one (Real.rpow_nonneg h2.le _)
      (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith))
  have htsum : (∑' m : ℕ, ENNReal.ofReal (K * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))))) =
      ENNReal.ofReal (K * (1 - (2 : ℝ) ^ (-(β / 2)))⁻¹) := by
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by
      have : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := Real.rpow_nonneg h2.le _
      positivity) (hsummable.mul_left K)]
    rw [tsum_mul_left, tsum_two_rpow_neg_mul (by linarith : (0 : ℝ) < β / 2)]
  -- assemble
  refine le_trans (lintegral_brsBlockMax_shell_le hE hp1 hp2.le hpq hg hA0 n) ?_
  refine le_trans (ENNReal.tsum_le_tsum (fun m => mul_le_mul' (hterm m) le_rfl)) ?_
  rw [ENNReal.tsum_mul_right, htsum]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [hK, brsBlockConst, ← hβdef, ← hC₁, ← hC₂]
  ring

/-! ## The block majorant, as a definition

`brsBlockMax` is a supremum over an `r`-dependent uncountable set, so it cannot
be fed to Minkowski.  The `m`-sum of the two-armed majorants built inside
`lintegral_brsBlockMax_shell_le` is measurable and dominates it on the shell;
exposing it as a definition is what allows the outer sums to be taken. -/

/-- The measurable majorant of the block operator on a shell. -/
def brsBlockMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (A : ℝ) (n : ℕ) (r : ℝ) :
    ENNReal :=
  ∑' m : ℕ,
    min (Set.indicator (brsD E n)
          (fun _ => ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) *
            (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r)
        (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m)
            q (brsBlockProfile A g) r)

theorem measurable_brsBlockMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) (A : ℝ) (n : ℕ) :
    Measurable (brsBlockMaj E p q g A n) := by
  refine Measurable.tsum fun m => ?_
  refine Measurable.min ?_ ?_
  · exact measurable_const.indicator (measurableSet_brsD E n)
  · exact measurable_const.mul
      (measurable_brsCoverMaj _ _ _ _ _ (measurable_brsBlockProfile A hg))

/-- **The majorant dominates the block operator on the shell.** -/
theorem indicator_brsBlockMax_le_brsBlockMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (n : ℕ) (r : ℝ) :
    Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ≤
      brsBlockMaj E p q g A n r := by
  by_cases hr : r ∈ brsD E n
  · rw [Set.indicator_of_mem hr, brsBlockMaj]
    refine le_trans (brsBlockMax_le_tsum hA0 r) ?_
    refine ENNReal.tsum_le_tsum fun m => ?_
    refine le_min ?_ ?_
    · rw [Set.indicator_of_mem hr]
      exact brsBlockPieceMax_le_const hp1 hp2 hg hA0 m r
    · exact brsBlockPieceMax_le_cover hE hp1 hp2 hq0 hg hA0 m r
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **The `L^q` bound for the block majorant.** -/
theorem lintegral_brsBlockMaj_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (_hp2 : p ≤ 2) (hpq : p ≤ q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (n : ℕ) :
    (∫⁻ r : ℝ, brsBlockMaj E p q g A n r ^ q) ^ (1 / q) ≤
      ∑' m : ℕ,
        min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
                (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
            (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
                (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                  (1 - 1 / p + 1 / q)))) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  set F : ℝ → ENNReal := brsBlockProfile A g with hFdef
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = GA := by
    rw [hFdef, lintegral_brsBlockProfile_rpow A hp0, hGA]
  set CH : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p)) with hCH
  set W : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ)) with hW
  set Θ : ℕ → ℝ → ENNReal := fun m r =>
    min (Set.indicator (brsD E n) (fun _ => CH m * GA) r)
      (W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
        (A * (1 / 2) ^ m) q F r) with hΘ
  have hΘmeas : ∀ m : ℕ, Measurable (Θ m) := by
    intro m
    refine Measurable.min ?_ ?_
    · exact measurable_const.indicator (measurableSet_brsD E n)
    · exact measurable_const.mul (measurable_brsCoverMaj _ _ _ _ _ hFmeas)
  have hΘbound : ∀ m : ℕ, (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
      min (CH m * volume (brsD E n) ^ (1 / q))
        (W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)))) *
        GA := by
    intro m
    have hδ : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
    have hlen : A * (1 / 2 : ℝ) ^ m - A * (1 / 2 : ℝ) ^ (m + 2) ≤
        A * (1 / 2 : ℝ) ^ m := by
      have : (0 : ℝ) ≤ A * (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hb1 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        CH m * GA * volume (brsD E n) ^ (1 / q) := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          Set.indicator (brsD E n) (fun _ => CH m * GA) r :=
        fun r => min_le_left _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      exact le_of_eq (lintegral_indicator_const_rpow (measurableSet_brsD E n) hq0)
    have hb2 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
          GA := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r := fun r => min_le_right _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      have hconst : (∫⁻ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
          (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q) ^ (1 / q) =
          W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q) := by
        have hpull : ∀ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
            (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q =
            W m ^ q * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
              (A * (1 / 2) ^ m) q F r ^ q :=
          fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le
        rw [lintegral_congr hpull, lintegral_const_mul' _ _ (by
          refine ENNReal.rpow_ne_top_of_nonneg hq0.le ?_
          rw [hW]
          exact ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
      rw [hconst]
      have hcov := lintegral_brsCoverMaj_rpow_le hE hδ hlen hFmeas hp1 hpq
      rw [hFnorm] at hcov
      calc W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q)
          ≤ W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)) *
              GA) := mul_le_mul' le_rfl hcov
        _ = W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
              GA := by ring
    rw [← min_mul_mul_right]
    exact le_min (hb1.trans (le_of_eq (by ring))) hb2
  have hshape : ∀ r : ℝ, brsBlockMaj E p q g A n r = ∑' m : ℕ, Θ m r := by
    intro r
    rw [brsBlockMaj, hΘ, hCH, hW, hGA, hFdef]
  rw [lintegral_congr fun r => by rw [hshape r]]
  refine le_trans (lintegral_rpow_tsum_le hq1 hΘmeas) ?_
  exact ENNReal.tsum_le_tsum hΘbound

/-! ## Summing over disjointly supported pieces

The shells are disjoint and the block majorant vanishes off its shell, so the
`n`-sum costs nothing: the `L^q` norm of the sum is the `ℓ^q` sum of the
norms. -/

/-- **The `L^q` norm of a sum of disjointly supported functions.** -/
theorem lintegral_rpow_tsum_disjoint {S : ℕ → Set ℝ}
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (Function.onFun Disjoint S))
    {F : ℕ → ℝ → ENNReal} (_hF : ∀ i, Measurable (F i))
    (hsupp : ∀ i, ∀ r : ℝ, r ∉ S i → F i r = 0) {q : ℝ} (hq0 : 0 < q) :
    (∫⁻ r : ℝ, (∑' i : ℕ, F i r) ^ q) = ∑' i : ℕ, ∫⁻ r : ℝ, F i r ^ q := by
  have hzero : ∀ r : ℝ, r ∉ (⋃ i, S i) → (∑' i : ℕ, F i r) ^ q = 0 := by
    intro r hr
    have hall : ∀ i : ℕ, F i r = 0 := by
      intro i
      exact hsupp i r fun hi => hr (Set.mem_iUnion.mpr ⟨i, hi⟩)
    rw [tsum_congr hall, tsum_zero, ENNReal.zero_rpow_of_pos hq0]
  have hind : ∀ r : ℝ, (∑' i : ℕ, F i r) ^ q =
      Set.indicator (⋃ i, S i) (fun r => (∑' i : ℕ, F i r) ^ q) r := by
    intro r
    by_cases hr : r ∈ (⋃ i, S i)
    · rw [Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, hzero r hr]
  have hUmeas : MeasurableSet (⋃ i, S i) := MeasurableSet.iUnion hS
  rw [lintegral_congr hind, lintegral_indicator hUmeas,
    lintegral_iUnion hS hd]
  refine tsum_congr fun i => ?_
  have hres : (∫⁻ r in S i, (∑' j : ℕ, F j r) ^ q) =
      ∫⁻ r in S i, F i r ^ q := by
    refine setLIntegral_congr_fun (hS i) ?_
    intro r hr
    have hsingle : (∑' j : ℕ, F j r) = F i r := by
      refine tsum_eq_single i fun j hj => ?_
      refine hsupp j r fun hjr => ?_
      exact absurd rfl ((hd hj).ne_of_mem hjr hr)
    show (∑' j : ℕ, F j r) ^ q = F i r ^ q
    rw [hsingle]
  rw [hres]
  have houter : (∫⁻ r : ℝ, F i r ^ q) = ∫⁻ r in S i, F i r ^ q := by
    have hzero' : ∀ r : ℝ, r ∉ S i → F i r ^ q = 0 := by
      intro r hr
      rw [hsupp i r hr, ENNReal.zero_rpow_of_pos hq0]
    have hind' : ∀ r : ℝ, F i r ^ q =
        Set.indicator (S i) (fun r => F i r ^ q) r := by
      intro r
      by_cases hr : r ∈ S i
      · rw [Set.indicator_of_mem hr]
      · rw [Set.indicator_of_notMem hr, hzero' r hr]
    rw [lintegral_congr hind', lintegral_indicator (hS i)]
  rw [houter]

/-- The block majorant vanishes off its shell. -/
theorem brsBlockMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ} {A : ℝ}
    {n : ℕ} {r : ℝ} (hr : r ∉ brsD E n) : brsBlockMaj E p q g A n r = 0 := by
  rw [brsBlockMaj, ENNReal.tsum_eq_zero]
  intro m
  rw [Set.indicator_of_notMem hr]
  exact min_eq_left zero_le

/-! ## Bounded overlap of the block windows

The `s`-window of the `i`-th block is `(2^{-i}, 4·2^{-i}]`, the union of two
intervals from tiling families.  So the windows overlap at most twice and the
`i`-sum of the localized `L^p` norms costs only a factor two. -/

/-- Two tiling families cover the block window. -/
theorem block_window_eq_union (i : ℕ) :
    Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) =
      Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i) ∪
        Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) := by
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ i := by positivity
  rw [Set.Ioc_union_Ioc_eq_Ioc (by linarith) (by linarith)]

/-- The first tiling family is disjoint. -/
theorem block_window_lower_disjoint :
    Pairwise (Function.onFun Disjoint
      (fun i : ℕ => Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i))) := by
  intro i j hij
  have key : ∀ a b : ℕ, a < b →
      Disjoint (Ioc ((1 / 2 : ℝ) ^ a) (2 * (1 / 2 : ℝ) ^ a))
        (Ioc ((1 / 2 : ℝ) ^ b) (2 * (1 / 2 : ℝ) ^ b)) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun s hs hs' => ?_
    have hmono : (1 / 2 : ℝ) ^ b ≤ (1 / 2 : ℝ) ^ (a + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have hsucc : (2 : ℝ) * (1 / 2 : ℝ) ^ (a + 1) = (1 / 2 : ℝ) ^ a := by
      rw [pow_succ]; ring
    have h1 : s ≤ 2 * (1 / 2 : ℝ) ^ b := hs'.2
    have h2 : (1 / 2 : ℝ) ^ a < s := hs.1
    nlinarith
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h
  · exact (key j i h).symm

/-- The second tiling family is disjoint. -/
theorem block_window_upper_disjoint :
    Pairwise (Function.onFun Disjoint
      (fun i : ℕ => Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i))) := by
  intro i j hij
  have key : ∀ a b : ℕ, a < b →
      Disjoint (Ioc (2 * (1 / 2 : ℝ) ^ a) (4 * (1 / 2 : ℝ) ^ a))
        (Ioc (2 * (1 / 2 : ℝ) ^ b) (4 * (1 / 2 : ℝ) ^ b)) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun s hs hs' => ?_
    have hmono : (1 / 2 : ℝ) ^ b ≤ (1 / 2 : ℝ) ^ (a + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have hsucc : (4 : ℝ) * (1 / 2 : ℝ) ^ (a + 1) = 2 * (1 / 2 : ℝ) ^ a := by
      rw [pow_succ]; ring
    have h1 : s ≤ 4 * (1 / 2 : ℝ) ^ b := hs'.2
    have h2 : 2 * (1 / 2 : ℝ) ^ a < s := hs.1
    nlinarith
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h
  · exact (key j i h).symm

/-- Summing a nonnegative integrand over a disjoint family costs nothing. -/
theorem tsum_setLIntegral_le_of_disjoint {S : ℕ → Set ℝ}
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (Function.onFun Disjoint S))
    (h : ℝ → ENNReal) :
    (∑' i : ℕ, ∫⁻ s in S i, h s) ≤ ∫⁻ s : ℝ, h s := by
  rw [← lintegral_iUnion hS hd]
  exact setLIntegral_le_lintegral _ _

/-- **Bounded overlap of the block windows.** -/
theorem tsum_lintegral_block_windows_le {h : ℝ → ENNReal} :
    (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) ≤
      2 * ∫⁻ s : ℝ, h s := by
  have hsplit : ∀ i : ℕ,
      (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) ≤
        (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s := by
    intro i
    rw [block_window_eq_union i]
    exact lintegral_union_le _ _ _
  calc (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s)
      ≤ ∑' i : ℕ, ((∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) :=
        ENNReal.tsum_le_tsum hsplit
    _ = (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∑' i : ℕ, ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s :=
        ENNReal.tsum_add
    _ ≤ (∫⁻ s : ℝ, h s) + ∫⁻ s : ℝ, h s :=
        add_le_add
          (tsum_setLIntegral_le_of_disjoint (fun _ => measurableSet_Ioc)
            block_window_lower_disjoint h)
          (tsum_setLIntegral_le_of_disjoint (fun _ => measurableSet_Ioc)
            block_window_upper_disjoint h)
    _ = 2 * ∫⁻ s : ℝ, h s := by rw [two_mul]

/-! ## The block majorant estimate, evaluated

The same arithmetic as for `brsBlockMax`, applied to its measurable majorant. -/

/-- **The block majorant estimate, evaluated.** -/
theorem lintegral_brsBlockMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (n : ℕ) :
    (∫⁻ r : ℝ, brsBlockMaj E p q g A n r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ ((1 / p - 1 / 2) / 2)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hp1) hpq
  have h2 : (0 : ℝ) < 2 := by norm_num
  set β : ℝ := 1 / p - 1 / 2 with hβdef
  have hβ : 0 < β := by
    rw [hβdef]
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hβ2 : 2 * β = 2 / p - 1 := by rw [hβdef]; ring
  set x : ℝ := ((2 : ℝ) ^ (-(n : ℝ))) / A with hxdef
  have hx : 0 < x := by rw [hxdef]; positivity
  set C₁ : ℝ := (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) with hC₁
  set C₂ : ℝ := (2 : ℝ) ^ (5 / 2 + 1 / q) with hC₂
  have hC₁0 : 0 ≤ C₁ := by rw [hC₁]; positivity
  have hC₂0 : 0 ≤ C₂ := by rw [hC₂]; positivity
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the term-by-term bound
  have hterm : ∀ m : ℕ,
      min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
          (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
              (A / 2) ^ (-(1 / p) : ℝ)) *
            ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                (1 - 1 / p + 1 / q)))) ≤
        ENNReal.ofReal (AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) *
          (2 : ℝ) ^ (β / 4) * x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
    intro m
    have harm₁ := brs_holder_arm_le hE hEne hp1 hq0 hAE hcov hA0 n m
    have harm₂ := brs_cover_arm_le hp1 hq0 hAE hcov hA0 hA1 m
    have hmin := min_le_min harm₁ harm₂
    refine le_trans hmin ?_
    rw [← ofReal_min_eq]
    refine ENNReal.ofReal_le_ofReal ?_
    have hfact : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
        min (AE * a) (AE * b) = AE * min a b := by
      intro a b ha hb
      rcases le_total a b with h | h
      · rw [min_eq_left h, min_eq_left (mul_le_mul_of_nonneg_left h hAE)]
      · rw [min_eq_right h, min_eq_right (mul_le_mul_of_nonneg_left h hAE)]
    have ha0 : (0 : ℝ) ≤ (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) := by
      have : (0 : ℝ) ≤ x ^ (2 / p - 1) := Real.rpow_nonneg hx.le _
      positivity
    have hb0 : (0 : ℝ) ≤ (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by positivity
    rw [hfact _ _ ha0 hb0]
    have hshape₁ : (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) =
        C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
      rw [hC₁, hβdef, hβ2]
    have hshape₂ : (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) =
        C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
      rw [hC₂, hβdef]
    rw [hshape₁, hshape₂]
    have hinterp := brs_interp_term_le (β := β) hC₁0 hC₂0 hx m
    calc AE * min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
            (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)))
        ≤ AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) :=
          mul_le_mul_of_nonneg_left hinterp hAE
      _ = AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring
  -- the geometric sum
  set K : ℝ := AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
    x ^ (β / 2)) with hK
  have hK0 : 0 ≤ K := by
    rw [hK]
    have h1 : (0 : ℝ) ≤ C₁ ^ ((1 : ℝ) / 4) := Real.rpow_nonneg hC₁0 _
    have h3 : (0 : ℝ) ≤ C₂ ^ ((3 : ℝ) / 4) := Real.rpow_nonneg hC₂0 _
    have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ (β / 4) := Real.rpow_nonneg h2.le _
    have h5 : (0 : ℝ) ≤ x ^ (β / 2) := Real.rpow_nonneg hx.le _
    positivity
  have hsummable : Summable fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
    have hr : (fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) =
        fun m : ℕ => ((2 : ℝ) ^ (-(β / 2))) ^ m := by
      funext m
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (-(β / 2))) m, ← Real.rpow_mul h2.le]
      congr 1
      ring
    rw [hr]
    exact summable_geometric_of_lt_one (Real.rpow_nonneg h2.le _)
      (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith))
  have htsum : (∑' m : ℕ, ENNReal.ofReal (K * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))))) =
      ENNReal.ofReal (K * (1 - (2 : ℝ) ^ (-(β / 2)))⁻¹) := by
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by
      have : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := Real.rpow_nonneg h2.le _
      positivity) (hsummable.mul_left K)]
    rw [tsum_mul_left, tsum_two_rpow_neg_mul (by linarith : (0 : ℝ) < β / 2)]
  -- assemble
  refine le_trans (lintegral_brsBlockMaj_rpow_le hE hp1 hp2.le hpq hg hA0 n) ?_
  refine le_trans (ENNReal.tsum_le_tsum (fun m => mul_le_mul' (hterm m) le_rfl)) ?_
  rw [ENNReal.tsum_mul_right, htsum]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [hK, brsBlockConst, ← hβdef, ← hC₁, ← hC₂]
  ring

/-! ## The `(k, i)` reindexing

The shell index `n` and the block index `j` are replaced by `k = n - j` and
`i = j`.  The point of the change is that the `s`-window then moves with the
outer index, which is what makes the `ℓ^p ↪ ℓ^q` step work. -/

/-- The block majorant, indexed by `(k, i)`: shell `k + i`, block `A_i = 2·2^{-i}`. -/
def brsShellMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (k i : ℕ) (r : ℝ) : ENNReal :=
  brsBlockMaj E p q g (2 * (1 / 2 : ℝ) ^ i) (k + i) r

theorem measurable_brsShellMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) (k i : ℕ) : Measurable (brsShellMaj E p q g k i) :=
  measurable_brsBlockMaj E p q hg _ _

theorem brsShellMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ}
    {k i : ℕ} {r : ℝ} (hr : r ∉ brsD E (k + i)) :
    brsShellMaj E p q g k i r = 0 :=
  brsBlockMaj_eq_zero_of_notMem hr

/-- On a shell, blocks finer than the shell are empty. -/
theorem brsBlockMax_eq_zero_of_lt {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {n j : ℕ}
    (hj : n < j) {r : ℝ} (hr : r ∈ brsD E n) :
    brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (zero_le)
  exfalso
  obtain ⟨htE, ht1, ht2⟩ := ht
  have hdist := lt_infDist_of_mem_brsD hr
  have hle : Metric.infDist r E ≤ |r - t| := by
    have h := Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  have hzp : ((2 : ℝ) ^ (-(n : ℤ))) = (1 / 2 : ℝ) ^ n := by
    rw [zpow_neg, zpow_natCast, one_div, inv_pow]
  rw [hzp] at hdist
  have hmono : (1 / 2 : ℝ) ^ j ≤ (1 / 2 : ℝ) ^ (n + 1) :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have hsucc : (2 : ℝ) * (1 / 2 : ℝ) ^ (n + 1) = (1 / 2 : ℝ) ^ n := by
    rw [pow_succ]; ring
  have h1 : |r - t| < 2 * (1 / 2 : ℝ) ^ j := ht2
  nlinarith

/-- **The pointwise bound in the `(k, i)` indexing.** -/
theorem brsMainZeroLeft_le_tsum_shellMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q)
    {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : r ∉ closure E) :
    brsMainZeroLeft E p g r ≤
      ENNReal.ofReal (3 / 2) * ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r := by
  rcases Set.eq_empty_or_nonempty (E ∩ Ioo (r / 2) (3 * r / 2)) with hw | ⟨t, ht⟩
  · rw [brsMainZeroLeft, hw]
    simp
  · obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hr0 : (0 : ℝ) < r := by linarith
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith
    -- the radius sits in a shell
    have hdist : Metric.infDist r E ≤ |r - t| := by
      have h := Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    have habs : |r - t| < r / 2 := by
      rw [abs_lt]
      constructor <;> linarith
    have hU : r ∈ brsU E 0 := by
      show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-((0 : ℕ) : ℤ))
      simp only [Nat.cast_zero, neg_zero, zpow_zero, mul_one]
      linarith
    have hne : Metric.infDist r E ≠ 0 := by
      intro hzero
      exact hr ((Metric.mem_closure_iff_infDist_zero hEne).mpr hzero)
    have hmem : r ∈ ⋃ n, brsD E n := by
      by_contra hcon
      exact hne (infDist_eq_zero_of_notMem_iUnion_brsD hU hcon)
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hmem
    -- the block decomposition, reindexed
    refine le_trans (brsMainZeroLeft_le_tsum_blocks hE r) ?_
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) ?_
    have hinj : Function.Injective (fun j : ℕ => (n - j, j)) := by
      intro a b hab
      exact congrArg Prod.snd hab
    have hstep : ∀ j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r ≤
        brsShellMaj E p q g (n - j) j r := by
      intro j
      by_cases hj : j ≤ n
      · have hidx : (n - j) + j = n := by omega
        rw [brsShellMaj, hidx]
        have h := indicator_brsBlockMax_le_brsBlockMaj hE hp1 hp2 hq0 hg
          (A := 2 * (1 / 2 : ℝ) ^ j) (by positivity) n r
        rwa [Set.indicator_of_mem hn] at h
      · rw [brsBlockMax_eq_zero_of_lt (by omega) hn]
        exact zero_le
    calc (∑' j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r)
        ≤ ∑' kj : ℕ × ℕ, brsShellMaj E p q g kj.1 kj.2 r := by
          exact ENNReal.summable.tsum_le_tsum_of_inj (fun j : ℕ => (n - j, j)) hinj
            (fun c _ => zero_le) hstep ENNReal.summable
      _ = ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r :=
          ENNReal.tsum_prod (f := fun a b => brsShellMaj E p q g a b r)

/-! ## Two small tools for the final assembly -/

/-- `ℓ^1 ↪ ℓ^s` for `s ≥ 1`. -/
theorem tsum_rpow_le_rpow_tsum {a : ℕ → ENNReal} {s : ℝ} (hs : 1 ≤ s) :
    (∑' i : ℕ, a i ^ s) ≤ (∑' i : ℕ, a i) ^ s := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  set A : ENNReal := ∑' i : ℕ, a i with hA
  by_cases hAtop : A = ⊤
  · rw [hAtop, ENNReal.top_rpow_of_pos hs0]
    exact le_top
  · have hstep : ∀ i : ℕ, a i ^ s ≤ a i * A ^ (s - 1) := by
      intro i
      have hle : a i ≤ A := ENNReal.le_tsum i
      calc a i ^ s = a i ^ (1 + (s - 1)) := by congr 1; ring
        _ = a i ^ (1 : ℝ) * a i ^ (s - 1) :=
            ENNReal.rpow_add_of_nonneg _ _ zero_le_one (by linarith)
        _ = a i * a i ^ (s - 1) := by rw [ENNReal.rpow_one]
        _ ≤ a i * A ^ (s - 1) :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hle (by linarith))
    calc (∑' i : ℕ, a i ^ s) ≤ ∑' i : ℕ, a i * A ^ (s - 1) :=
          ENNReal.tsum_le_tsum hstep
      _ = A * A ^ (s - 1) := by rw [ENNReal.tsum_mul_right, ← hA]
      _ = A ^ s := by
          nth_rewrite 1 [show A = A ^ (1 : ℝ) from (ENNReal.rpow_one A).symm]
          rw [← ENNReal.rpow_add_of_nonneg _ _ zero_le_one (by linarith)]
          congr 1
          ring

/-- `𝔐_{p,0}^-` vanishes off the radial window. -/
theorem brsMainZeroLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainZeroLeft E p g r = 0 := by
  rw [brsMainZeroLeft, brsMainWindow_empty hE hr]
  simp

/-- The radial weight is bounded on the support. -/
theorem ofReal_mul_brsMainZeroLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hq0 : 0 < q) {g : ℝ → ℂ} (r : ℝ) :
    ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      ENNReal.ofReal 4 * brsMainZeroLeft E p g r ^ q := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
  · rw [brsMainZeroLeft_eq_zero hE hr, ENNReal.zero_rpow_of_pos hq0, mul_zero,
      mul_zero]

/-- The shells used by the `(k, i)` indexing are disjoint in `i`. -/
theorem brsD_shift_disjoint (E : Set ℝ) (k : ℕ) :
    Pairwise (Function.onFun Disjoint (fun i : ℕ => brsD E (k + i))) := by
  intro i j hij
  exact brsD_disjoint E (by omega)

/-! ## Dyadic powers, and the geometric sum in the outer index -/

theorem half_rpow (t : ℝ) : ((1 : ℝ) / 2) ^ t = (2 : ℝ) ^ (-t) := by
  rw [one_div, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num)]

theorem half_pow_rpow (k : ℕ) (e : ℝ) :
    ((1 / 2 : ℝ) ^ k) ^ e = ((1 / 2 : ℝ) ^ e) ^ k := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  rw [half_pow_eq, ← Real.rpow_mul h2.le, half_rpow,
    ← Real.rpow_natCast ((2 : ℝ) ^ (-e)) k, ← Real.rpow_mul h2.le]
  congr 1
  ring

/-- The geometric sum in the outer index. -/
theorem tsum_ofReal_half_pow {C ρ : ℝ} (hC : 0 ≤ C) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    (∑' k : ℕ, ENNReal.ofReal (C * ρ ^ (k + 1))) =
      ENNReal.ofReal (C * (ρ / (1 - ρ))) := by
  have hsummable : Summable fun k : ℕ => C * ρ ^ (k + 1) := by
    have h : Summable fun k : ℕ => ρ ^ k := summable_geometric_of_lt_one hρ0.le hρ1
    exact ((h.mul_left ρ).congr fun k => by rw [pow_succ]; ring).mul_left C
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun k => by positivity) hsummable,
    tsum_mul_left]
  congr 1
  congr 1
  have hshift : (∑' k : ℕ, ρ ^ (k + 1)) = ρ * ∑' k : ℕ, ρ ^ k := by
    rw [← tsum_mul_left]
    exact tsum_congr fun k => by rw [pow_succ]; ring
  rw [hshift, tsum_geometric_of_lt_one hρ0.le hρ1]
  field_simp

/-- The constant of BRS Proposition 5.5(ii) for the near half. -/
def brsMainZeroConst (p q : ℝ) : ℝ :=
  (4 : ℝ) ^ (1 / q) * (3 / 2) * brsBlockConst p q *
      ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
        (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2))) *
    (2 : ℝ) ^ (1 / p)

/-! ## The block estimate in the `(k, i)` indexing

The ratio `2^{-n}/A` becomes `2^{-(k+1)}`, depending only on the outer index,
and the `s`-window becomes `(2^{-i}, 4·2^{-i}]`, depending only on the inner
one.  That separation is the whole point of the reindexing. -/

theorem shell_ratio_eq (k i : ℕ) :
    ((2 : ℝ) ^ (-((k + i : ℕ) : ℝ))) / (2 * (1 / 2 : ℝ) ^ i) =
      (1 / 2 : ℝ) ^ (k + 1) := by
  have hi : (0 : ℝ) < (1 / 2 : ℝ) ^ i := by positivity
  rw [← half_pow_eq, pow_add, pow_succ]
  field_simp

theorem shell_window_eq (i : ℕ) :
    Ioc ((2 * (1 / 2 : ℝ) ^ i) / 2) (2 * (2 * (1 / 2 : ℝ) ^ i)) =
      Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) := by
  congr 1 <;> ring

/-- **The block estimate, reindexed.** -/
theorem lintegral_brsShellMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) (k i : ℕ) :
    (∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) *
        (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
          ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hA0 : (0 : ℝ) < 2 * (1 / 2 : ℝ) ^ i := by positivity
  have hA1 : 2 * (1 / 2 : ℝ) ^ i ≤ 2 := by
    have hpow : (1 / 2 : ℝ) ^ i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have h := lintegral_brsBlockMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg hA0 hA1
    (k + i)
  simp only [brsShellMaj]
  refine le_trans h (le_of_eq ?_)
  rw [shell_window_eq i, shell_ratio_eq k i, half_pow_rpow]

/-! ## The inner sum: one outer index, all shells

For a fixed outer index `k` the shells are disjoint, so the `L^q` norm is the
`ℓ^q` sum; and the `s`-windows have bounded overlap, so `ℓ^p ↪ ℓ^q` turns that
into `‖g‖_p`. -/

theorem lintegral_tsum_brsShellMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) (k : ℕ) :
    (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set K : ENNReal := ENNReal.ofReal (AE * brsBlockConst p q *
    ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) with hK
  set GA : ℕ → ENNReal := fun i =>
    (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
      ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the shells are disjoint, so the `L^q` norm is the `ℓ^q` sum
  have hdisj : (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) =
      ∑' i : ℕ, ∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q :=
    lintegral_rpow_tsum_disjoint (fun i => measurableSet_brsD E (k + i))
      (brsD_shift_disjoint E k) (fun i => measurable_brsShellMaj E p q hg k i)
      (fun i r hr => brsShellMaj_eq_zero_of_notMem hr) hq0
  rw [hdisj]
  -- each shell
  have hterm : ∀ i : ℕ, (∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q) ≤
      K ^ q * GA i ^ q := by
    intro i
    have h := lintegral_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k i
    have h' := ENNReal.rpow_le_rpow h hq0.le
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at h'
    refine le_trans h' (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, hK, hGA]
  refine le_trans (ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum hterm)
    (by positivity : (0 : ℝ) ≤ 1 / q)) ?_
  rw [ENNReal.tsum_mul_left]
  -- the windows have bounded overlap
  have hsq : ∀ i : ℕ, GA i ^ q =
      (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
        ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
    intro i
    rw [hGA, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hoverlap : (∑' i : ℕ, GA i ^ q) ≤
      (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
    have hqp : (1 : ℝ) ≤ q / p := by
      rw [le_div_iff₀ hp0]
      linarith
    calc (∑' i : ℕ, GA i ^ q)
        = ∑' i : ℕ, (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := tsum_congr hsq
      _ ≤ (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := tsum_rpow_le_rpow_tsum hqp
      _ ≤ (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
          refine ENNReal.rpow_le_rpow ?_ (by positivity)
          have h := tsum_lintegral_block_windows_le
            (h := fun s => ENNReal.ofReal ‖g s‖ ^ p)
          rw [show ((2 : ENNReal)) = ENNReal.ofReal 2 from by
            rw [ENNReal.ofReal_ofNat]] at h
          exact h
  refine le_trans (ENNReal.rpow_le_rpow (mul_le_mul' le_rfl hoverlap)
    (by positivity : (0 : ℝ) ≤ 1 / q)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul, show q * (1 / q) = 1 from by field_simp,
    ENNReal.rpow_one]
  congr 2
  field_simp

/-! ## BRS Proposition 5.5(ii) for the near half

Summing the outer index — the only sum that goes through Minkowski — closes the
argument: the outer factor is geometric, convergent exactly because `p < 2`. -/

theorem prop55ii_brsMainZeroLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 ≤ AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroConst p q * AE) *
        (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hCB : (0 : ℝ) ≤ brsBlockConst p q := brsBlockConst_nonneg hp1 hp2
  set ρ : ℝ := (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) with hρdef
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
  set Gk : ℕ → ℝ → ENNReal := fun k r => ∑' i : ℕ, brsShellMaj E p q g k i r
    with hGk
  have hGkmeas : ∀ k : ℕ, Measurable (Gk k) := by
    intro k
    exact Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i
  -- the pointwise bound, off the null set `closure E`
  have hae : ∀ᵐ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) * (∑' k : ℕ, Gk k r) ^ q := by
    have hnull : ∀ᵐ r : ℝ, r ∉ closure E := by
      rw [ae_iff]
      simpa using hEnull
    filter_upwards [hnull] with r hr
    have h1 := ofReal_mul_brsMainZeroLeft_rpow_le hE (p := p) (q := q) hq0 (g := g) r
    have h2 := brsMainZeroLeft_le_tsum_shellMaj hE hEne hp1 hp2.le hq0 hg hr
    calc ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q
        ≤ ENNReal.ofReal 4 * brsMainZeroLeft E p g r ^ q := h1
      _ ≤ ENNReal.ofReal 4 *
            (ENNReal.ofReal (3 / 2) * ∑' k : ℕ, Gk k r) ^ q :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h2 hq0.le)
      _ = ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) * (∑' k : ℕ, Gk k r) ^ q := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
            ENNReal.ofReal_rpow_of_pos (by norm_num),
            ← ENNReal.ofReal_mul (by norm_num)]
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ≤
      ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) *
        ∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono_ae hae
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  -- Minkowski in the outer index
  have hmink : (∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q) ^ (1 / q) ≤
      ∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hGkmeas
  have houter : (∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (AE * brsBlockConst p q * (ρ / (1 - ρ))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
    have hterm : ∀ k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (AE * brsBlockConst p q * ρ ^ (k + 1)) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      intro k
      rw [hGk, hρdef]
      exact lintegral_tsum_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k
    refine le_trans (ENNReal.tsum_le_tsum hterm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right,
      tsum_ofReal_half_pow (by positivity : (0 : ℝ) ≤ AE * brsBlockConst p q)
        hρ0 hρ1]
  refine le_trans (mul_le_mul' le_rfl (le_trans hmink houter)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [brsMainZeroConst, ← hρdef]
  have h4 : ((4 : ℝ) * (3 / 2 : ℝ) ^ q) ^ (1 / q) =
      (4 : ℝ) ^ (1 / q) * (3 / 2 : ℝ) := by
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  rw [h4]
  ring

/-! ## The shell machinery of Proposition 4.5, stated generically

Steps 2–4 of Proposition 4.5 use nothing about `𝔐_p` beyond the shell majorant
`brsMainMaximal_le_on_brsD` and the vanishing off `U_0`.  Restated for an
arbitrary function with those two properties, they apply verbatim to the far
half `𝔐_{p,∞}^-`, whose shell majorant is the same. -/

/-- **Step 2 of Proposition 4.5, generically.** -/
theorem rpow_le_on_brsD_of_maj {d : ℕ} {p q a : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    {g : ℝ → ℂ} {n : ℕ} {v : ENNReal}
    (hstep : v ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    v ^ q ≤
      ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
          (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
            (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set c : ℕ → ENNReal := brsWindowWeight e p n with hc
  set G : ℕ → ENNReal := brsBlockNorm p g with hG
  set A : ℝ := (2 / 3 : ℝ) ^ (1 - (d : ℝ)) with hA
  have hApos : 0 < A := by
    rw [hA]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hholder : (∑' k, c k * G k) ≤
      (∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q) :=
    tsum_weighted_le c G hq
  have hweight : (∑' k, c k) ≤
      ENNReal.ofReal (blockConstBase e p *
        (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) := by
    rw [hc, he]
    exact tsum_brsWindowWeight_le hp hae ha n
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  calc v ^ q
      ≤ (ENNReal.ofReal A * ∑' k, c k * G k) ^ q :=
        ENNReal.rpow_le_rpow hstep hq0.le
    _ = (ENNReal.ofReal A) ^ q * (∑' k, c k * G k) ^ q := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
    _ ≤ (ENNReal.ofReal A) ^ q *
          ((∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q)) ^ q := by
        refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hholder hq0.le)
    _ = (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * (∑' k, c k) ^ (q - 1)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
        congr 2
        field_simp
    _ ≤ (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * B ^ (q - 1)) := by
        refine mul_le_mul' le_rfl (mul_le_mul' le_rfl ?_)
        exact ENNReal.rpow_le_rpow hweight (by linarith)
    _ = ENNReal.ofReal (A ^ q) * B ^ (q - 1) * ∑' k, c k * G k ^ q := by
        rw [ENNReal.ofReal_rpow_of_nonneg hApos.le hq0.le]
        ring

/-- **Step 3 of Proposition 4.5, generically.** -/
theorem lintegral_brsD_le_of_maj {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q a : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    {g : ℝ → ℂ} {F : ℝ → ENNReal} (n : ℕ)
    (hmaj : ∀ r ∈ brsD E n, F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    (∫⁻ r in brsD E n, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
            (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
              (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
            ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
              brsBlockNorm p g k ^ q) *
        volume (brsU E n) := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
    (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) with hK
  have hpoint : ∀ r ∈ brsD E n,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 := brsU_subset_of_le E (Nat.zero_le n) hr.1
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    have hmax : F r ^ q ≤
        ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T := by
      rw [hB, hT, he]
      exact rpow_le_on_brsD_of_maj hp hq hae ha (hmaj r hr)
    rw [hK]
    exact mul_le_mul' hweight hmax
  calc (∫⁻ r in brsD E n, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
      ≤ ∫⁻ _r in brsD E n, K :=
        setLIntegral_mono' (measurableSet_brsD E n) hpoint
    _ = K * volume (brsD E n) := setLIntegral_const _ _
    _ ≤ K * volume (brsU E n) := by
        refine mul_le_mul' le_rfl (measure_mono ?_)
        exact fun r hr => hr.1
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) *
          volume (brsU E n) := by rw [hK]

/-- **Step 4 of Proposition 4.5, generically.** -/
theorem lintegral_le_tsum_brsD_of_zero {E : Set ℝ} (hEne : E.Nonempty)
    (hEnull : volume (closure E) = 0) {F : ℝ → ENNReal}
    (hzero : ∀ r, r ∉ brsU E 0 → F r = 0) :
    (∫⁻ r : ℝ, F r) ≤ ∑' n : ℕ, ∫⁻ r in brsD E n, F r := by
  have hcover : brsU E 0 ⊆ (⋃ n : ℕ, brsD E n) ∪ closure E := by
    intro r hr
    by_cases hmem : r ∈ ⋃ n : ℕ, brsD E n
    · exact Or.inl hmem
    · refine Or.inr ?_
      have hd0 := infDist_eq_zero_of_notMem_iUnion_brsD hr hmem
      rwa [← Metric.mem_closure_iff_infDist_zero hEne] at hd0
  calc (∫⁻ r, F r) = ∫⁻ r in brsU E 0, F r := by
        rw [← lintegral_indicator (measurableSet_brsU E 0)]
        refine lintegral_congr fun r => ?_
        by_cases hr : r ∈ brsU E 0
        · rw [Set.indicator_of_mem hr]
        · rw [Set.indicator_of_notMem hr, hzero r hr]
    _ ≤ ∫⁻ r in (⋃ n : ℕ, brsD E n) ∪ closure E, F r := lintegral_mono_set hcover
    _ ≤ (∫⁻ r in ⋃ n : ℕ, brsD E n, F r) + ∫⁻ r in closure E, F r :=
        lintegral_union_le _ _ _
    _ = ∫⁻ r in ⋃ n : ℕ, brsD E n, F r := by
        rw [setLIntegral_measure_zero _ _ hEnull, add_zero]
    _ ≤ ∑' n : ℕ, ∫⁻ r in brsD E n, F r := lintegral_iUnion_le _ _

/-! ## Proposition 4.5, stated generically

The whole chain applies to any function that vanishes off `U_0` and obeys the
shell majorant bound. -/

theorem lintegral_brsD_le_shell_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q a S : ℝ} (hp : 1 ≤ p)
    (hq : 1 ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} {F : ℝ → ENNReal} (n : ℕ)
    (hmaj : ∀ r ∈ brsD E n, F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    (∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal (shellConst d p q a S) *
          (ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹) ^ n *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  have hA : (0 : ℝ) < (2 / 3 : ℝ) ^ (1 - (d : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  -- the volume of the shell neighbourhood
  have hvol : volume (brsU E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
        (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by
    refine le_trans (volume_brsU_le hE hEne n) ?_
    calc ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞)
        ≤ ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
            ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) :=
          mul_le_mul' le_rfl (hcov n)
      _ = ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) :=
          (ENNReal.ofReal_mul (by positivity)).symm
  -- the shell constant, with its `n`-dependence
  have hB : (ENNReal.ofReal (blockConstBase e p * (x ^ (n + 3) / (x - 1)))) ^ (q - 1) =
      ENNReal.ofReal ((blockConstBase e p / (x - 1)) ^ (q - 1) *
        (x ^ (n + 3)) ^ (q - 1)) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith)]
    congr 1
    rw [show blockConstBase e p * (x ^ (n + 3) / (x - 1)) =
        (blockConstBase e p / (x - 1)) * x ^ (n + 3) by ring,
      Real.mul_rpow (by positivity) (by positivity)]
  -- assemble
  have hstep := lintegral_brsD_le_of_maj hE hEne hp hq hae ha n hmaj
  rw [← he, ← hT] at hstep
  refine le_trans hstep ?_
  rw [← hxdef, hB]
  refine le_trans (mul_le_mul' le_rfl hvol) (le_of_eq ?_)
  set A1 : ℝ := (5 : ℝ) ^ (d - 1) with hA1
  set A2 : ℝ := ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q with hA2
  set A3 : ℝ := (blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)
    with hA3
  set A4 : ℝ := 7 * (2 : ℝ) ^ (-(n : ℤ)) *
    (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) with hA4
  have h1 : 0 ≤ A1 := by rw [hA1]; positivity
  have h2 : 0 ≤ A2 := by
    rw [hA2]
    exact (Real.rpow_pos_of_pos hA _).le
  have h3 : 0 ≤ A3 := by
    rw [hA3]
    have hb1 : (0 : ℝ) < (blockConstBase e p / (x - 1)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (div_pos hC0 (by linarith)) _
    have hb2 : (0 : ℝ) < (x ^ (n + 3)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have h4 : 0 ≤ A4 := by
    rw [hA4]
    have hb1 : (0 : ℝ) < S ^ q := Real.rpow_pos_of_pos hS _
    have hb2 : (0 : ℝ) < ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have hfactor := shell_factor_identity (a := a) (q := q) n
  rw [← hxdef] at hfactor
  have hconst : A1 * A2 * A3 * A4 = shellConst d p q a S * (x⁻¹) ^ n := by
    rw [hA1, hA2, hA3, hA4, shellConst, ← he, ← hxdef]
    calc (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
          ((blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)) *
          (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
        = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            ((x ^ (n + 3)) ^ (q - 1) *
              ((2 : ℝ) ^ (-(n : ℤ)) *
                ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by ring
      _ = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            (x ^ (3 * (q - 1)) * (x⁻¹) ^ n) := by rw [hfactor]
      _ = (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q *
            x ^ (3 * (q - 1)) * (x⁻¹) ^ n := by ring
  calc ENNReal.ofReal A1 * (ENNReal.ofReal A2 * ENNReal.ofReal A3 * T) *
        ENNReal.ofReal A4
      = (ENNReal.ofReal A1 * ENNReal.ofReal A2 * ENNReal.ofReal A3 *
          ENNReal.ofReal A4) * T := by ring
    _ = ENNReal.ofReal (A1 * A2 * A3 * A4) * T := by
        rw [ENNReal.ofReal_mul (mul_nonneg (mul_nonneg h1 h2) h3),
          ENNReal.ofReal_mul (mul_nonneg h1 h2), ENNReal.ofReal_mul h1]
    _ = ENNReal.ofReal (shellConst d p q a S * (x⁻¹) ^ n) * T := by rw [hconst]
    _ = ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n * T := by
        rw [ENNReal.ofReal_mul (shellConst_pos (d := d) (p := p) (q := q) ha hS).le,
          ENNReal.ofReal_pow (by positivity)]

theorem prop45_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (hEnull : volume (closure E) = 0) {p q a S : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hpq : p ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} {F : ℝ → ENNReal}
    (hFzero : ∀ r : ℝ, r ∉ brsU E 0 → F r = 0)
    (hmaj : ∀ n : ℕ, ∀ r ∈ brsD E n,
      F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((shellConst d p q a S *
          (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hinv : x⁻¹ < 1 := by
    rw [inv_lt_one_iff₀]
    exact Or.inr hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  set Mreal : ℝ := blockConstBase e p * x ^ (2 : ℕ) * (1 - x⁻¹)⁻¹ with hMreal
  have hMpos : 0 < Mreal := by
    rw [hMreal]
    have hsub : (0 : ℝ) < 1 - x⁻¹ := by linarith
    positivity
  have hSC : 0 < shellConst d p q a S := shellConst_pos (d := d) (p := p) (q := q) ha hS
  set G : ENNReal := (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) with hG
  have hzeroF : ∀ r : ℝ, r ∉ brsU E 0 →
      ENNReal.ofReal r ^ (d - 1) * F r ^ q = 0 := by
    intro r hr
    rw [hFzero r hr, ENNReal.zero_rpow_of_pos hq0, mul_zero]
  -- the shells
  have hshell : ∀ n : ℕ, (∫⁻ r in brsD E n,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n *
          ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
    intro n
    rw [he, hxdef]
    exact lintegral_brsD_le_shell_of_maj hE hEne hp hq hae ha hS hcov n (hmaj n)
  -- the block sums
  have hblocks : (∑' k : ℕ, brsBlockNorm p g k ^ q) ≤ G ^ q := by
    have h1 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤
        (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) :=
      tsum_rpow_le_tsum_rpow _ hp0 hpq
    have h2 : (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) ≤ G := by
      rw [hG]
      exact ENNReal.rpow_le_rpow (tsum_brsBlockNorm_rpow_le hp0 g) (by positivity)
    have h3 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤ G := le_trans h1 h2
    have h4 := ENNReal.rpow_le_rpow h3 hq0.le
    rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one] at h4
  -- chain everything
  have hmain : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      F r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
        ≤ ∑' n : ℕ, ∫⁻ r in brsD E n,
            ENNReal.ofReal r ^ (d - 1) * F r ^ q :=
          lintegral_le_tsum_brsD_of_zero hEne hEnull hzeroF
      _ ≤ ∑' n : ℕ, ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal x⁻¹) ^ n *
            ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q :=
          ENNReal.tsum_le_tsum hshell
      _ = ENNReal.ofReal (shellConst d p q a S) *
            ∑' n : ℕ, (ENNReal.ofReal x⁻¹) ^ n *
              ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
          rw [← ENNReal.tsum_mul_left]
          refine tsum_congr fun n => ?_
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
              (1 - ENNReal.ofReal x⁻¹)⁻¹ *
              ∑' k : ℕ, brsBlockNorm p g k ^ q) := by
          refine mul_le_mul' le_rfl ?_
          rw [hxdef]
          exact tsum_shell_block_le hae ha g
      _ = ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal *
            ∑' k : ℕ, brsBlockNorm p g k ^ q := by
          rw [hMreal, hxdef, ← blockSumConst_eq (e := e) (p := p) ha]
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal * G ^ q :=
          mul_le_mul' le_rfl hblocks
      _ = ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
          rw [ENNReal.ofReal_mul hSC.le]
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ENNReal.ofReal ((shellConst d p q a S * Mreal) ^ (1 / q)) * G := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]

/-! ## The far half `𝔐_{p,∞}^-` for `p < 2`

Its shell majorant is literally the one of `𝔐_p` in dimension two, so the
generic Proposition 4.5 applies verbatim. -/

theorem brsMainInfLeft_eq_zero_of_notMem_brsU_zero {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {r : ℝ}
    (hr : r ∉ brsU E 0) : brsMainInfLeft E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hclose : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  have hdist : Metric.infDist r E ≤ |r - t| := by
    have h : Metric.infDist r E ≤ dist r t :=
      Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  refine hr ?_
  show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ)
  have hcalc : (2 : ℝ) * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) = 2 := by norm_num
  rw [hcalc]
  linarith

/-- **The shell majorant for `𝔐_{p,∞}^-`.**  It is the one of `𝔐_p` at `d = 2`. -/
theorem brsMainInfLeft_le_on_brsD {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (g : ℝ → ℂ) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainInfLeft E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) *
        ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
          ENNReal.ofReal (s ^ ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1)) *
            ENNReal.ofReal ‖g s‖ := by
  have hexp : (((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1 = -(1 / p) := by
    push_cast
    ring
  have hconst : ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) = 3 / 2 := by
    have h : (1 : ℝ) - ((2 : ℕ) : ℝ) = -1 := by push_cast; ring
    rw [h, Real.rpow_neg_one]
    norm_num
  rw [hexp, hconst]
  have hdist := lt_infDist_of_mem_brsD hrD
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hr0 (by norm_num)]
    linarith
  have hcut : (2 : ℝ) ^ (-(n : ℤ)) ≤ 2 * |r - t| := by
    have hle : Metric.infDist r E ≤ |r - t| := by
      have h : Metric.infDist r E ≤ dist r t :=
        Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
    linarith
  have hsub : Ioc (2 * |r - t|) (r + t) ⊆ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 := by
    intro s hs
    exact ⟨le_trans hcut hs.1.le, by linarith [hs.2]⟩
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) (lintegral_mono_set hsub)

/-- **BRS Proposition 5.5(ii) for the far half.** -/
theorem prop55ii_brsMainInfLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {p q a S : ℝ}
    (hp : 1 ≤ p) (hq : 1 ≤ q) (hpq : p ≤ q)
    (hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r ^ ((2 : ℕ) - 1) * brsMainInfLeft E p g r ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((shellConst 2 p q a S *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  refine prop45_of_maj (d := 2) hE hEne hEnull hp hq hpq hae ha hS hcov
    (g := g) (F := brsMainInfLeft E p g)
    (fun r hr => brsMainInfLeft_eq_zero_of_notMem_brsU_zero hE g hr) ?_
  intro n r hr
  refine le_trans (brsMainInfLeft_le_on_brsD hE g hr) ?_
  exact mul_le_mul' le_rfl (lintegral_window_le_tsum_blocks hp hg n)

/-! ## Adding two halves

Minkowski needs measurability of both summands; the convexity bound
`(a+b)^q ≤ 2^{q-1}(a^q+b^q)` plus subadditivity of `x ↦ x^{1/q}` needs it of
only one, since `lintegral_add_left` is an equality as soon as one summand is
measurable. -/

theorem lintegral_radial_rpow_add_le {A B : ℝ → ENNReal} (hA : Measurable A)
    {c : ENNReal} (hc : c ≠ ⊤) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q) ^ (1 / q) ≤
      (2 : ENNReal) ^ (1 - 1 / q) *
        ((∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) ^ (1 / q) +
          c * (∫⁻ r : ℝ, ENNReal.ofReal r * B r ^ q) ^ (1 / q)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hinv : (0 : ℝ) < 1 / q := by positivity
  have hinv1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (ENNReal.ofReal r * A r ^ q + c ^ q * (ENNReal.ofReal r * B r ^ q)) := by
    intro r
    have h := ENNReal.rpow_add_le_mul_rpow_add_rpow (A r) (c * B r) hq
    calc ENNReal.ofReal r * (A r + c * B r) ^ q
        ≤ ENNReal.ofReal r * ((2 : ENNReal) ^ (q - 1) *
            (A r ^ q + (c * B r) ^ q)) := mul_le_mul' le_rfl h
      _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal r * A r ^ q + c ^ q * (ENNReal.ofReal r * B r ^ q)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
          ring
  have hsplit : (∫⁻ r : ℝ, (ENNReal.ofReal r * A r ^ q +
      c ^ q * (ENNReal.ofReal r * B r ^ q))) =
      (∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) +
        ∫⁻ r : ℝ, c ^ q * (ENNReal.ofReal r * B r ^ q) := by
    refine lintegral_add_left ?_ _
    exact (by fun_prop : Measurable fun r : ℝ => ENNReal.ofReal r).mul
      (hA.pow_const q)
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q) ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) +
          c ^ q * ∫⁻ r : ℝ, ENNReal.ofReal r * B r ^ q) := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)), hsplit,
      lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hq0.le hc)]
  refine le_trans (ENNReal.rpow_le_rpow hmain hinv.le) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv.le, ← ENNReal.rpow_mul]
  refine mul_le_mul' (le_of_eq (by congr 1; field_simp)) ?_
  refine le_trans (ENNReal.rpow_add_le_add_rpow _ _ hinv.le hinv1) ?_
  refine add_le_add le_rfl (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv.le, ← ENNReal.rpow_mul,
    mul_one_div_cancel hq0.ne', ENNReal.rpow_one]

/-! ## The near majorant, as a measurable function

To add the two halves of `𝔐_p^-` the near half must be replaced by a
measurable majorant; the total bound for the double sum is the core of
`prop55ii_brsMainZeroLeft`, extracted. -/

/-- **The total bound for the double sum of shell majorants.** -/
theorem lintegral_tsum_shellMaj_total {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r : ℝ, (∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
            (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hCB : (0 : ℝ) ≤ brsBlockConst p q := brsBlockConst_nonneg hp1 hp2
  set ρ : ℝ := (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) with hρdef
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
  set Gk : ℕ → ℝ → ENNReal := fun k r => ∑' i : ℕ, brsShellMaj E p q g k i r
    with hGk
  have hGkmeas : ∀ k : ℕ, Measurable (Gk k) := by
    intro k
    exact Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i
  have hmink : (∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q) ^ (1 / q) ≤
      ∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hGkmeas
  have houter : (∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (AE * brsBlockConst p q * (ρ / (1 - ρ))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
    have hterm : ∀ k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (AE * brsBlockConst p q * ρ ^ (k + 1)) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      intro k
      rw [hGk, hρdef]
      exact lintegral_tsum_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k
    refine le_trans (ENNReal.tsum_le_tsum hterm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right,
      tsum_ofReal_half_pow (by positivity : (0 : ℝ) ≤ AE * brsBlockConst p q)
        hρ0 hρ1]
  exact le_trans hmink houter

/-- The measurable near majorant of `𝔐_{p,0}^-`. -/
def brsMainZeroMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ENNReal.ofReal (3 / 2) * ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r

theorem measurable_brsMainZeroMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) : Measurable (brsMainZeroMaj E p q g) := by
  refine measurable_const.mul ?_
  exact Measurable.tsum fun k =>
    Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i

theorem brsMainZeroMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ}
    {r : ℝ} (hr : r ∉ brsU E 0) : brsMainZeroMaj E p q g r = 0 := by
  rw [brsMainZeroMaj, ENNReal.tsum_eq_zero.mpr, mul_zero]
  intro k
  rw [ENNReal.tsum_eq_zero]
  intro i
  refine brsShellMaj_eq_zero_of_notMem ?_
  intro hmem
  exact hr (brsU_subset_of_le E (Nat.zero_le (k + i)) hmem.1)

/-- **The `L^q` bound for the near majorant.** -/
theorem lintegral_brsMainZeroMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (1 / q) * (3 / 2)) *
        (ENNReal.ofReal (AE * brsBlockConst p q *
            ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
              (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set S : ℝ → ENNReal := fun r => ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r
    with hS
  -- the radial weight is at most `5` on the support
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q ≤
      ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * S r ^ q := by
    intro r
    by_cases hr : r ∈ brsU E 0
    · have hr5 : r ≤ 5 := le_five_of_mem_brsU_zero hE hEne hr
      calc ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q
          ≤ ENNReal.ofReal 5 * (ENNReal.ofReal (3 / 2) * S r) ^ q := by
            refine mul_le_mul' (ENNReal.ofReal_le_ofReal hr5) ?_
            rw [brsMainZeroMaj, hS]
        _ = ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * S r ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
              ENNReal.ofReal_rpow_of_pos (by norm_num),
              ← ENNReal.ofReal_mul (by norm_num)]
    · rw [brsMainZeroMaj_eq_zero_of_notMem hr, ENNReal.zero_rpow_of_pos hq0,
        mul_zero]
      exact zero_le
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * ∫⁻ r : ℝ, S r ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hpt
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  refine mul_le_mul' (le_of_eq ?_) ?_
  · congr 1
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  · rw [hS]
    exact lintegral_tsum_shellMaj_total hE hEne hp1 hp2 hpq hAE hcov hg

/-! ## The two covering hypotheses agree

`HasBRSCoveringBound` is the `q`-th root of the dyadic hypothesis used by
Proposition 4.5. -/

theorem hasBRSCoveringBound_dyadic {E : Set ℝ} {p q AE : ℝ} (hq0 : 0 < q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {a : ℝ}
    (ha : 1 - 2 / p = a) (n : ℕ) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (AE ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) := by
  set δ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hδdef
  have hδ0 : 0 < δ := by rw [hδdef]; positivity
  have hδ1 : δ ≤ 6 := by
    rw [hδdef]
    have h1 : δ ≤ 1 := by
      rw [hδdef]
      exact zpow_le_one_of_nonpos₀ (by norm_num) (by simp)
    rw [hδdef] at h1
    linarith
  have h := hcov δ hδ0 hδ1
  have h' := ENNReal.rpow_le_rpow h (le_of_lt hq0)
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at h'
  refine le_trans h' (le_of_eq ?_)
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hq0.le]
  congr 1
  rw [Real.mul_rpow hAE (Real.rpow_nonneg hδ0.le _), ← Real.rpow_mul hδ0.le]
  congr 2
  rw [← ha]
  field_simp

theorem add_mul_le_add_mul_add {A B X Y : ENNReal} :
    A * X + B * Y ≤ (A + B) * (X + Y) := by
  rw [add_mul, mul_add, mul_add]
  exact add_le_add le_self_add le_add_self

/-! ## BRS Proposition 5.5(ii) for `𝔐_p^-`

The two halves are added with the convexity bound; the near half must go
through its measurable majorant. -/

/-- **BRS Proposition 5.5(ii), left endpoint.** -/
theorem prop55ii_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 < AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q) ^ (1 / q) ≤
        C * ((ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) +
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set a : ℝ := 1 - 2 / p with hadef
  have ha : a < 0 := by
    rw [hadef]
    have : 1 < 2 / p := by
      rw [lt_div_iff₀ hp0]
      linarith
    linarith
  have hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a := by
    rw [hadef]
    push_cast
    ring
  have hdyad := hasBRSCoveringBound_dyadic (E := E) (p := p) (q := q) (AE := AE)
    hq0 hAE.le hcov (a := a) hadef.symm
  -- the two halves
  have hnear := lintegral_brsMainZeroMaj_bound hE hEne hp1 hp2 hpq hAE.le hcov hg
  have hfar := prop55ii_brsMainInfLeft hE hEne hEnull hp1 hq1 hpq hae ha
    (by positivity : (0 : ℝ) < AE) hdyad hg
  rw [show ((2 : ℕ) - 1) = 1 from by norm_num] at hfar
  simp only [pow_one] at hfar
  -- the pointwise bound
  have hsplit : ∀ᵐ r : ℝ, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q ≤
      ENNReal.ofReal r *
        (brsMainZeroMaj E p q g r +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * brsMainInfLeft E p g r) ^ q := by
    have hnull : ∀ᵐ r : ℝ, r ∉ closure E := by
      rw [ae_iff]
      simpa using hEnull
    filter_upwards [hnull] with r hr
    by_cases hr0 : 0 < r
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsMainTwoLeft_le_split hr0) ?_
      refine add_le_add ?_ le_rfl
      rw [brsMainZeroMaj]
      exact brsMainZeroLeft_le_tsum_shellMaj hE hEne hp1 hp2.le hq0 hg hr
    · rw [ENNReal.ofReal_eq_zero.mpr (by linarith [not_lt.mp hr0]), zero_mul,
        zero_mul]
  refine ⟨(2 : ENNReal) ^ (1 - 1 / q) *
    (ENNReal.ofReal ((5 : ℝ) ^ (1 / q) * (3 / 2)) *
        ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
            (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) +
      ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal ((shellConst 2 p q a AE *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q))),
    ?_, ?_⟩
  · refine ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg ?_ (by simp)) ?_
    · have : 1 / q ≤ 1 := by
        rw [div_le_one hq0]
        exact hq1
      linarith
    · exact ENNReal.add_ne_top.mpr
        ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top,
          ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top⟩
  · refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono_ae hsplit)
      (by positivity)) ?_
    refine le_trans (lintegral_radial_rpow_add_le
      (measurable_brsMainZeroMaj E p q hg) ENNReal.ofReal_ne_top hq1) ?_
    refine le_trans (mul_le_mul' le_rfl
      (add_le_add hnear (mul_le_mul' le_rfl hfar))) ?_
    refine le_trans (mul_le_mul' (le_refl ((2 : ENNReal) ^ (1 - 1 / q))) ?_)
      (le_of_eq (mul_assoc _ _ _).symm)
    refine le_trans (le_of_eq ?_) add_mul_le_add_mul_add
    ring

/-! ## The far half `𝔐_{p,∞}^+` for `p < 2`

Its shell majorant is the same as for the `-` sign: the window
`(|r-t|, (r+t)/2]` also sits inside `[2^{-n}, 6]` on the shell `D_n`. -/

theorem brsMainInfRight_eq_zero_of_notMem_brsU_zero {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {r : ℝ}
    (hr : r ∉ brsU E 0) : brsMainInfRight E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hclose : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  have hdist : Metric.infDist r E ≤ |r - t| := by
    have h : Metric.infDist r E ≤ dist r t :=
      Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  refine hr ?_
  show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ)
  have hcalc : (2 : ℝ) * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) = 2 := by norm_num
  rw [hcalc]
  linarith

/-- **The shell majorant for `𝔐_{p,∞}^+`.** -/
theorem brsMainInfRight_le_on_brsD {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (g : ℝ → ℂ) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainInfRight E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) *
        ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
          ENNReal.ofReal (s ^ ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1)) *
            ENNReal.ofReal ‖g s‖ := by
  have hexp : (((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1 = -(1 / p) := by
    push_cast
    ring
  have hconst : ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) = 3 / 2 := by
    have h : (1 : ℝ) - ((2 : ℕ) : ℝ) = -1 := by push_cast; ring
    rw [h, Real.rpow_neg_one]
    norm_num
  rw [hexp, hconst]
  have hdist := lt_infDist_of_mem_brsD hrD
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hr0 (by norm_num)]
    linarith
  have hcut : (2 : ℝ) ^ (-(n : ℤ)) ≤ |r - t| := by
    have hle : Metric.infDist r E ≤ |r - t| := by
      have h : Metric.infDist r E ≤ dist r t :=
        Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    linarith
  have hsub : Ioc |r - t| ((r + t) / 2) ⊆ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 := by
    intro s hs
    exact ⟨le_trans hcut hs.1.le, by linarith [hs.2]⟩
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) (lintegral_mono_set hsub)

/-- **BRS Proposition 5.5(ii) for the far half, right endpoint.** -/
theorem prop55ii_brsMainInfRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {p q a S : ℝ}
    (hp : 1 ≤ p) (hq : 1 ≤ q) (hpq : p ≤ q)
    (hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r ^ ((2 : ℕ) - 1) * brsMainInfRight E p g r ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((shellConst 2 p q a S *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  refine prop45_of_maj (d := 2) hE hEne hEnull hp hq hpq hae ha hS hcov
    (g := g) (F := brsMainInfRight E p g)
    (fun r hr => brsMainInfRight_eq_zero_of_notMem_brsU_zero hE g hr) ?_
  intro n r hr
  refine le_trans (brsMainInfRight_le_on_brsD hE g hr) ?_
  exact mul_le_mul' le_rfl (lintegral_window_le_tsum_blocks hp hg n)

/-! ## The dyadic pieces at the right endpoint

For `𝔐_{p,0}^+` the singularity sits at `s = b := r + t`, which stays in
`(1, 6)`.  There is therefore no block decomposition and no shell structure:
one dyadic decomposition of the near window `(b/2, b)` suffices. -/

/-- The `m`-th dyadic piece of the right near window `(b/2, b)`. -/
def brsRightPieceSet (b : ℝ) (m : ℕ) : Set ℝ :=
  Ioc (b - b * (1 / 2 : ℝ) ^ (m + 1)) (b - b * (1 / 2 : ℝ) ^ (m + 2))

theorem brsRightPieceSet_subset {b : ℝ} (hb : 0 < b) (m : ℕ) :
    brsRightPieceSet b m ⊆ Ioc (b / 2) b := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hp1 : (1 / 2 : ℝ) ^ (m + 1) ≤ (1 / 2 : ℝ) ^ 1 :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have hp2 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  constructor
  · have : b * (1 / 2 : ℝ) ^ (m + 1) ≤ b * (1 / 2 : ℝ) := by
      have := mul_le_mul_of_nonneg_left hp1 hb.le
      simpa using this
    linarith
  · nlinarith

/-- The pieces exhaust the right near window, up to the endpoint. -/
theorem Ioc_subset_iUnion_brsRightPieceSet {b : ℝ} (hb : 0 < b) :
    Ioc (b / 2) b ⊆ (⋃ m : ℕ, brsRightPieceSet b m) ∪ {b} := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  rcases eq_or_lt_of_le h2 with heq | hlt
  · exact Or.inr (by simp [heq])
  refine Or.inl ?_
  classical
  set x : ℝ := (b - s) / b with hx
  have hx0 : 0 < x := by
    rw [hx]
    exact div_pos (by linarith) hb
  have hxhalf : x < 1 / 2 := by
    rw [hx, div_lt_iff₀ hb]
    linarith
  have hex : ∃ m : ℕ, (1 / 2 : ℝ) ^ (m + 2) ≤ x := by
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hx0 (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨n, le_of_lt (lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num)
      (by norm_num) (by omega)) hn)⟩
  set m : ℕ := Nat.find hex with hm
  have hlow : (1 / 2 : ℝ) ^ (m + 2) ≤ x := Nat.find_spec hex
  have hhigh : x < (1 / 2 : ℝ) ^ (m + 1) := by
    rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    · rw [hm0]
      simpa using hxhalf
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, m = k + 1 := ⟨m - 1, by omega⟩
      have hklt : k < Nat.find hex := by
        rw [← hm]
        omega
      have hnot := Nat.find_min hex hklt
      have hidx : k + 2 = m + 1 := by omega
      rw [hidx] at hnot
      exact lt_of_not_ge hnot
  have hxb : x * b = b - s := by
    rw [hx, div_mul_cancel₀ _ hb.ne']
  refine Set.mem_iUnion.mpr ⟨m, ?_, ?_⟩
  · have h := mul_lt_mul_of_pos_right hhigh hb
    nlinarith [hxb]
  · have h := mul_le_mul_of_nonneg_right hlow hb.le
    nlinarith [hxb]

/-- The right near-window integral is at most the sum over the dyadic pieces. -/
theorem lintegral_rightNear_le_tsum_pieces {b : ℝ} (hb : 0 < b) (F : ℝ → ENNReal) :
    (∫⁻ s in Ioc (b / 2) b, F s) ≤
      ∑' m : ℕ, ∫⁻ s in brsRightPieceSet b m, F s := by
  refine le_trans (lintegral_mono_set (Ioc_subset_iUnion_brsRightPieceSet hb)) ?_
  refine le_trans (lintegral_union_le _ _ _) ?_
  have hpt : (∫⁻ s in ({b} : Set ℝ), F s) = 0 := by
    rw [setLIntegral_measure_zero]
    simp
  rw [hpt, add_zero]
  exact lintegral_iUnion_le _ _

/-- **The pointwise weight bound on a right piece.** -/
theorem mainWeightRight_piece_le {p b s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hb : 0 < b) {m : ℕ} (hs : s ∈ brsRightPieceSet b m) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤
      (b / 2) ^ (1 / 2 - 1 / p) *
        (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hsub := brsRightPieceSet_subset hb m hs
  obtain ⟨hs1, hs2⟩ := hsub
  obtain ⟨h1, h2⟩ := hs
  have hb2 : (0 : ℝ) < b / 2 := by linarith
  have hs0 : 0 < s := lt_trans hb2 hs1
  have hκ : 1 / 2 - 1 / p ≤ 0 := by
    have : (1 : ℝ) / 2 ≤ 1 / p := by
      rw [div_le_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hbs : (0 : ℝ) < b * (1 / 2 : ℝ) ^ (m + 2) := by positivity
  have hgap : b * (1 / 2 : ℝ) ^ (m + 2) ≤ b - s := by linarith
  have hfirst : s ^ (1 / 2 - 1 / p) ≤ (b / 2) ^ (1 / 2 - 1 / p) :=
    rpow_le_rpow_of_nonpos_exp hb2 hs1.le hκ
  have hsecond : (b - s) ^ (-(1 / 2) : ℝ) ≤
      (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) :=
    rpow_le_rpow_of_nonpos_exp hbs hgap (by norm_num)
  exact mul_le_mul hfirst hsecond (Real.rpow_nonneg (by linarith) _)
    (Real.rpow_nonneg hb2.le _)

/-- **The right piece sits in an additive window.** -/
theorem brsRightPieceSet_subset_shift {b : ℝ} (hb1 : 1 ≤ b) (hb6 : b ≤ 6)
    (m : ℕ) :
    brsRightPieceSet b m ⊆
      Ioc (b - 6 * (1 / 2 : ℝ) ^ (m + 1)) (b - (1 / 2 : ℝ) ^ (m + 2)) := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hpow1 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 1) := by positivity
  have hpow2 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  constructor
  · nlinarith
  · nlinarith

/-! ## The linearized window at the right endpoint

`s ∈ (r + t - c₂, r + t - c₁]` says `r - s ∈ [c₁ - t, c₂ - t)`, so the window is
again a reflected translate — and there is only one arm, since `r + t` needs no
absolute value. -/

/-- **The translation window at the right endpoint.** -/
theorem lintegral_shifted_window_le_add {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    (F : ℝ → ENNReal) (r : ℝ) :
    (∫⁻ s in Ioc (r + t - c₂) (r + t - c₁), F s) ≤
      ∫⁻ s : ℝ,
        Set.indicator (Ico (c₁ - v) (c₂ - u)) (fun _ => (1 : ENNReal)) (r - s) *
          F s := by
  obtain ⟨hu, hv⟩ := ht
  have hsub : Ioc (r + t - c₂) (r + t - c₁) ⊆
      (fun s : ℝ => r - s) ⁻¹' Ico (c₁ - v) (c₂ - u) := by
    intro s hs
    obtain ⟨h1, h2⟩ := hs
    constructor
    · have : c₁ - t ≤ r - s := by linarith
      linarith
    · have : r - s < c₂ - t := by linarith
      linarith
  rw [lintegral_indicator_shift measurableSet_Ico F r]
  exact lintegral_mono_set hsub

/-- The measurable majorant of the right linearized window operator. -/
def brsWindowMajAdd (u v c₁ c₂ : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  ∫⁻ s : ℝ,
    Set.indicator (Ico (c₁ - v) (c₂ - u)) (fun _ => (1 : ENNReal)) (r - s) * F s

theorem measurable_brsWindowMajAdd (u v c₁ c₂ : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsWindowMajAdd u v c₁ c₂ F) :=
  measurable_indicator_conv measurableSet_Ico hF

theorem iSup_window_le_brsWindowMajAdd {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (r : ℝ) :
    (⨆ t : Icc u v, ∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsWindowMajAdd u v c₁ c₂ F r :=
  iSup_le fun t => lintegral_shifted_window_le_add t.2 F r

theorem lintegral_brsWindowMajAdd_rpow_le {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsWindowMajAdd u v c₁ c₂ F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hvol : volume (Ico (c₁ - v) (c₂ - u)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have h := lintegral_indicator_conv_rpow_le (Q := Ico (c₁ - v) (c₂ - u))
    measurableSet_Ico (by rw [hvol]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
  rwa [hvol] at h

/-- The measurable majorant of the covered right window operator. -/
def brsCoverMajAdd (E : Set ℝ) (δ c₁ c₂ q : ℝ) (F : ℝ → ENNReal) (r : ℝ) :
    ENNReal :=
  (∑ a ∈ brsCoverFinset E δ,
    brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q)

theorem measurable_brsCoverMajAdd (E : Set ℝ) (δ c₁ c₂ q : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsCoverMajAdd E δ c₁ c₂ q F) := by
  refine Measurable.pow_const ?_ (1 / q)
  exact Finset.measurable_sum _ fun a _ =>
    (measurable_brsWindowMajAdd _ _ _ _ hF).pow_const q

/-- The majorant dominates the supremum over `E`. -/
theorem iSup_le_brsCoverMajAdd {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) {c₁ c₂ q : ℝ} (hq0 : 0 < q) {F : ℝ → ENNReal} (r : ℝ) :
    (⨆ t : E, ∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsCoverMajAdd E δ c₁ c₂ q F r := by
  obtain ⟨hι, _⟩ := brsCoverFinset_spec hE hδ
  refine iSup_le fun t => ?_
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ brsCoverFinset E δ,
      (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι t.2
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  have hle : (∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    refine le_trans ?_ (iSup_window_le_brsWindowMajAdd (u := a - δ / 2)
      (v := a + δ / 2) (F := F) r)
    exact le_iSup (fun w : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (r + (w : ℝ) - c₂) (r + (w : ℝ) - c₁), F s) ⟨(t : ℝ), hat⟩
  refine le_trans hle ?_
  rw [brsCoverMajAdd]
  have hmem : brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q ≤
      ∑ b ∈ brsCoverFinset E δ,
        brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q :=
    Finset.single_le_sum
      (f := fun b => brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q)
      (fun _ _ => zero_le) haι
  calc brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r
      = (brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ b ∈ brsCoverFinset E δ,
          brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmem (by positivity)

/-- **The `L^q` bound for the covered right window majorant.** -/
theorem lintegral_brsCoverMajAdd_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ^ (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨hι, hcard⟩ := brsCoverFinset_spec hE hδ
  set M : ENNReal := ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMajAdd_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ,
        brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤ M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul'
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hpow : ∀ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q =
      ∑ a ∈ brsCoverFinset E δ,
        brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    rw [brsCoverMajAdd, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne',
      ENNReal.rpow_one]
  have hmain : (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ≤
      ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
    rw [lintegral_congr hpow,
      lintegral_finsetSum' _ (fun a _ =>
        ((measurable_brsWindowMajAdd _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ brsCoverFinset E δ,
          ∫⁻ r : ℝ, brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ brsCoverFinset E δ, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ^ (1 / q)
      ≤ (((brsCoverFinset E δ).card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ((brsCoverFinset E δ).card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The near half `𝔐_{p,0}^+` for `p < 2`

Since `b = r + t` stays in `(1, 6)`, the weight bound on the `m`-th piece is
uniform in `b`, and the `m`-sum is a single geometric series. -/

/-- The uniform weight bound on the `m`-th right piece. -/
def brsRightWeight (p : ℝ) (m : ℕ) : ℝ :=
  (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ)

theorem brsRightWeight_nonneg (p : ℝ) (m : ℕ) : 0 ≤ brsRightWeight p m := by
  rw [brsRightWeight]
  have h1 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    Real.rpow_nonneg (by norm_num) _
  have h2 : (0 : ℝ) ≤ (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by positivity) _
  positivity

/-- **The uniform weight bound on a right piece.** -/
theorem mainWeightRight_piece_le_uniform {p b s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hb1 : 1 ≤ b) (_hb6 : b ≤ 6) {m : ℕ} (hs : s ∈ brsRightPieceSet b m) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤ brsRightWeight p m := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hb0 : (0 : ℝ) < b := by linarith
  have hκ : 1 / 2 - 1 / p ≤ 0 := by
    have : (1 : ℝ) / 2 ≤ 1 / p := by
      rw [div_le_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  refine le_trans (mainWeightRight_piece_le hp1 hp2 hb0 hs) ?_
  rw [brsRightWeight]
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  have hfirst : (b / 2) ^ (1 / 2 - 1 / p) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    rpow_le_rpow_of_nonpos_exp (by norm_num) (by linarith) hκ
  have hsecond : (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) ≤
      (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ) := by
    refine rpow_le_rpow_of_nonpos_exp hpow ?_ (by norm_num)
    nlinarith
  exact mul_le_mul hfirst hsecond (Real.rpow_nonneg (by positivity) _)
    (Real.rpow_nonneg (by norm_num) _)

/-- The measurable majorant of `𝔐_{p,0}^+`. -/
def brsMainZeroRightMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  Set.indicator (Ioo (2 / 3 : ℝ) 4)
    (fun r => ENNReal.ofReal (3 / 2) *
      ∑' m : ℕ, ENNReal.ofReal (brsRightWeight p m) *
        brsCoverMajAdd E (6 * (1 / 2 : ℝ) ^ (m + 1)) ((1 / 2 : ℝ) ^ (m + 2))
          (6 * (1 / 2 : ℝ) ^ (m + 1)) q (fun s => ENNReal.ofReal ‖g s‖) r) r

theorem measurable_brsMainZeroRightMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) : Measurable (brsMainZeroRightMaj E p q g) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine measurable_const.mul ?_
  refine Measurable.tsum fun m => ?_
  exact measurable_const.mul
    (measurable_brsCoverMajAdd _ _ _ _ _ hg.norm.ennreal_ofReal)

/-- **The majorant dominates `𝔐_{p,0}^+`.** -/
theorem brsMainZeroRight_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ} (r : ℝ) :
    brsMainZeroRight E p g r ≤ brsMainZeroRightMaj E p q g r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [brsMainZeroRightMaj, Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hb1 : (1 : ℝ) ≤ r + t := by linarith [hr.1]
    have hb6 : r + t ≤ 6 := by linarith [hr.2]
    have hb0 : (0 : ℝ) < r + t := by linarith
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) ?_
    refine le_trans (lintegral_rightNear_le_tsum_pieces hb0 _) ?_
    refine ENNReal.tsum_le_tsum fun m => ?_
    -- the weight is uniform on the piece
    have hweight : (∫⁻ s in brsRightPieceSet (r + t) m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) *
          ((r + t) - s) ^ (-(1 / 2) : ℝ)) * ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (brsRightWeight p m) *
          ∫⁻ s in brsRightPieceSet (r + t) m, ENNReal.ofReal ‖g s‖ := by
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (mainWeightRight_piece_le_uniform hp1 hp2 hb1 hb6 hs)) le_rfl
    refine le_trans hweight ?_
    refine mul_le_mul' le_rfl ?_
    refine le_trans (lintegral_mono_set
      (brsRightPieceSet_subset_shift hb1 hb6 m)) ?_
    refine le_trans ?_ (iSup_le_brsCoverMajAdd hE
      (by positivity : (0 : ℝ) < 6 * (1 / 2 : ℝ) ^ (m + 1)) hq0 r)
    exact le_iSup (fun w : E =>
      ∫⁻ s in Ioc (r + (w : ℝ) - 6 * (1 / 2 : ℝ) ^ (m + 1))
        (r + (w : ℝ) - (1 / 2 : ℝ) ^ (m + 2)),
        ENNReal.ofReal ‖g s‖) ⟨t, htE⟩
  · rw [brsMainZeroRightMaj, Set.indicator_of_notMem hr, brsMainZeroRight,
      brsMainWindow_empty hE hr]
    simp

/-! ## The geometric series at the right endpoint -/

/-- The constant of the right-endpoint term. -/
def brsRightConst (p q : ℝ) : ℝ :=
  (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
    (6 : ℝ) ^ (1 - 1 / p + 1 / q)

theorem brsRightConst_nonneg (p q : ℝ) : 0 ≤ brsRightConst p q := by
  rw [brsRightConst]
  have h1 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    Real.rpow_nonneg (by norm_num) _
  have h2 : (0 : ℝ) ≤ (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) :=
    Real.rpow_nonneg (by norm_num) _
  have h3 : (0 : ℝ) ≤ (6 : ℝ) ^ (1 - 1 / p + 1 / q) :=
    Real.rpow_nonneg (by norm_num) _
  positivity

/-- **The `m`-th term at the right endpoint is geometric.** -/
theorem brs_right_term_identity {p q : ℝ} (m : ℕ) :
    brsRightWeight p m * ((6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
        (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q)) =
      brsRightConst p q * ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m := by
  set θ : ℝ := (1 / 2 : ℝ) ^ m with hθdef
  have hθ : (0 : ℝ) < θ := by rw [hθdef]; positivity
  have h1 : (6 : ℝ) * (1 / 2 : ℝ) ^ (m + 1) = 3 * θ := by
    rw [hθdef, pow_succ]; ring
  have h2 : ((1 / 2 : ℝ)) ^ (m + 2) = θ / 4 := by
    rw [hθdef, pow_succ, pow_succ]; ring
  have h3 : (2 : ℝ) * (3 * θ) = 6 * θ := by ring
  rw [brsRightWeight, brsRightConst, h1, h2, h3]
  have hq1 : (θ / 4) ^ (-(1 / 2) : ℝ) = θ ^ (-(1 / 2) : ℝ) * 2 := by
    rw [Real.div_rpow hθ.le (by norm_num)]
    have h4 : (4 : ℝ) ^ (-(1 / 2) : ℝ) = 1 / 2 := by
      rw [show (4 : ℝ) = 2 ^ (2 : ℝ) from by
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) from by norm_num, Real.rpow_natCast]
        norm_num, ← Real.rpow_mul (by norm_num)]
      norm_num
    rw [h4]
    ring
  have hq2 : ((3 : ℝ) * θ) ^ (-(1 - 2 / p + 1 / q)) =
      (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) * θ ^ (-(1 - 2 / p + 1 / q)) :=
    Real.mul_rpow (by norm_num) hθ.le
  have hq3 : ((6 : ℝ) * θ) ^ (1 - 1 / p + 1 / q) =
      (6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 - 1 / p + 1 / q) :=
    Real.mul_rpow (by norm_num) hθ.le
  rw [hq1, hq2, hq3]
  have hθpow : θ ^ (-(1 / 2) : ℝ) * θ ^ (-(1 - 2 / p + 1 / q)) *
      θ ^ (1 - 1 / p + 1 / q) = θ ^ (1 / p - 1 / 2) := by
    rw [← Real.rpow_add hθ, ← Real.rpow_add hθ]
    congr 1
    ring
  have hlast : ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m = θ ^ (1 / p - 1 / 2) := by
    rw [hθdef, half_pow_rpow]
  rw [hlast]
  calc (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * (θ ^ (-(1 / 2) : ℝ) * 2) *
        ((3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) * θ ^ (-(1 - 2 / p + 1 / q)) *
          ((6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 - 1 / p + 1 / q)))
      = (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
          (6 : ℝ) ^ (1 - 1 / p + 1 / q) *
          (θ ^ (-(1 / 2) : ℝ) * θ ^ (-(1 - 2 / p + 1 / q)) *
            θ ^ (1 - 1 / p + 1 / q)) := by ring
    _ = (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
          (6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 / p - 1 / 2) := by
        rw [hθpow]

/-! ## BRS Proposition 5.5(ii) for the near half at the right endpoint -/

theorem tsum_ofReal_geom {C ρ : ℝ} (hC : 0 ≤ C) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) :
    (∑' m : ℕ, ENNReal.ofReal (C * ρ ^ m)) = ENNReal.ofReal (C * (1 - ρ)⁻¹) := by
  have hsummable : Summable fun m : ℕ => C * ρ ^ m :=
    (summable_geometric_of_lt_one hρ0 hρ1).mul_left C
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity) hsummable,
    tsum_mul_left, tsum_geometric_of_lt_one hρ0 hρ1]

/-- The constant of the near half at the right endpoint. -/
def brsMainZeroRightTotalConst (p q : ℝ) : ℝ :=
  (4 : ℝ) ^ (1 / q) * (3 / 2) * brsRightConst p q *
    (1 - (1 / 2 : ℝ) ^ (1 / p - 1 / 2))⁻¹

/-- **BRS Proposition 5.5(ii) for `𝔐_{p,0}^+`.** -/
theorem lintegral_brsMainZeroRightMaj_bound {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2)
    (hpq : p ≤ q) (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroRightTotalConst p q * AE) *
        (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  set ρ : ℝ := (1 / 2 : ℝ) ^ (1 / p - 1 / 2) with hρdef
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) hβ
  set F : ℝ → ENNReal := fun s => ENNReal.ofReal ‖g s‖ with hF
  have hFmeas : Measurable F := hg.norm.ennreal_ofReal
  set Gp : ENNReal := (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set T : ℕ → ℝ → ENNReal := fun m r =>
    ENNReal.ofReal (brsRightWeight p m) *
      brsCoverMajAdd E (6 * (1 / 2 : ℝ) ^ (m + 1)) ((1 / 2 : ℝ) ^ (m + 2))
        (6 * (1 / 2 : ℝ) ^ (m + 1)) q F r with hT
  have hTmeas : ∀ m : ℕ, Measurable (T m) := by
    intro m
    exact measurable_const.mul (measurable_brsCoverMajAdd _ _ _ _ _ hFmeas)
  -- the radial weight is bounded on the support
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q ≤
      ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) * (∑' m : ℕ, T m r) ^ q := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [brsMainZeroRightMaj, Set.indicator_of_mem hr]
      calc ENNReal.ofReal r * (ENNReal.ofReal (3 / 2) * ∑' m : ℕ, T m r) ^ q
          ≤ ENNReal.ofReal 4 * (ENNReal.ofReal (3 / 2) * ∑' m : ℕ, T m r) ^ q :=
            mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) *
              (∑' m : ℕ, T m r) ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
              ENNReal.ofReal_rpow_of_pos (by norm_num),
              ← ENNReal.ofReal_mul (by norm_num)]
    · rw [brsMainZeroRightMaj, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0, mul_zero]
      exact zero_le
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q) ≤
      ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) *
        ∫⁻ r : ℝ, (∑' m : ℕ, T m r) ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hpt
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  -- Minkowski over the piece index
  have hmink : (∫⁻ r : ℝ, (∑' m : ℕ, T m r) ^ q) ^ (1 / q) ≤
      ∑' m : ℕ, (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hTmeas
  have hterm : ∀ m : ℕ, (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsRightConst p q * ρ ^ m) * Gp := by
    intro m
    set δ : ℝ := 6 * (1 / 2 : ℝ) ^ (m + 1) with hδdef
    have hδ0 : 0 < δ := by rw [hδdef]; positivity
    have hδ6 : δ ≤ 6 := by
      rw [hδdef]
      have hpow : (1 / 2 : ℝ) ^ (m + 1) ≤ 1 :=
        pow_le_one₀ (by norm_num) (by norm_num)
      nlinarith
    have hlen : δ - (1 / 2 : ℝ) ^ (m + 2) ≤ δ := by
      have : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hcma := lintegral_brsCoverMajAdd_rpow_le hE hδ0 hlen hFmeas hp1 hpq
    have hpull : (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) =
        ENNReal.ofReal (brsRightWeight p m) *
          (∫⁻ r : ℝ, brsCoverMajAdd E δ ((1 / 2 : ℝ) ^ (m + 2)) δ q F r ^ q) ^
            (1 / q) := by
      rw [hT]
      simp only
      rw [lintegral_congr (fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le),
        lintegral_const_mul' _ _
          (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
        mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    rw [hpull]
    refine le_trans (mul_le_mul' le_rfl hcma) ?_
    have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = Gp := by rw [hF, hGp]
    rw [hFnorm]
    have hN := hcov δ hδ0 hδ6
    have hpow2 : ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) =
        ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) :=
      ENNReal.ofReal_rpow_of_pos (by positivity)
    rw [hpow2]
    calc ENNReal.ofReal (brsRightWeight p m) *
          ((intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
            ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) * Gp)
        ≤ ENNReal.ofReal (brsRightWeight p m) *
            (ENNReal.ofReal (AE * δ ^ (-(1 - 2 / p + 1 / q))) *
              ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) * Gp) :=
          mul_le_mul' le_rfl (mul_le_mul' (mul_le_mul' hN le_rfl) le_rfl)
      _ = ENNReal.ofReal (brsRightWeight p m *
            (AE * δ ^ (-(1 - 2 / p + 1 / q)) *
              (2 * δ) ^ (1 - 1 / p + 1 / q))) * Gp := by
          rw [← ENNReal.ofReal_mul (by positivity), ← mul_assoc,
            ← ENNReal.ofReal_mul (brsRightWeight_nonneg p m)]
      _ = ENNReal.ofReal (AE * brsRightConst p q * ρ ^ m) * Gp := by
          congr 2
          rw [hδdef, hρdef]
          calc brsRightWeight p m *
                (AE * (6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
                  (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q))
              = AE * (brsRightWeight p m *
                  ((6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
                    (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q))) := by
                ring
            _ = AE * (brsRightConst p q *
                  ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m) := by
                rw [brs_right_term_identity]
            _ = AE * brsRightConst p q * ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m := by
                ring
  refine le_trans (mul_le_mul' le_rfl (le_trans hmink
    (ENNReal.tsum_le_tsum hterm))) ?_
  rw [ENNReal.tsum_mul_right,
    tsum_ofReal_geom (mul_nonneg hAE (brsRightConst_nonneg p q)) hρ0.le hρ1]
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [brsMainZeroRightTotalConst, ← hρdef]
  have h4 : ((4 : ℝ) * (3 / 2 : ℝ) ^ q) ^ (1 / q) =
      (4 : ℝ) ^ (1 / q) * (3 / 2 : ℝ) := by
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  rw [h4]
  ring

/-! ## BRS Proposition 5.5(ii), right endpoint

Adding the two halves of `𝔐_p^+`; the splitting costs no constant at all
because `r + t - s ≥ s` on the far half. -/

/-- **BRS Proposition 5.5(ii), right endpoint.** -/
theorem prop55ii_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 < AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q) ^ (1 / q) ≤
        C * ((∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) +
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set a : ℝ := 1 - 2 / p with hadef
  have ha : a < 0 := by
    rw [hadef]
    have : 1 < 2 / p := by
      rw [lt_div_iff₀ hp0]
      linarith
    linarith
  have hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a := by
    rw [hadef]
    push_cast
    ring
  have hdyad := hasBRSCoveringBound_dyadic (E := E) (p := p) (q := q) (AE := AE)
    hq0 hAE.le hcov (a := a) hadef.symm
  have hnear := lintegral_brsMainZeroRightMaj_bound hE hp1 hp2 hpq hAE.le hcov hg
  have hfar := prop55ii_brsMainInfRight hE hEne hEnull hp1 hq1 hpq hae ha
    (by positivity : (0 : ℝ) < AE) hdyad hg
  rw [show ((2 : ℕ) - 1) = 1 from by norm_num] at hfar
  simp only [pow_one] at hfar
  have hsplit : ∀ r : ℝ, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q ≤
      ENNReal.ofReal r *
        (brsMainZeroRightMaj E p q g r + 1 * brsMainInfRight E p g r) ^ q := by
    intro r
    by_cases hr0 : 0 < r
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsMainTwoRight_le_split hr0) ?_
      rw [one_mul]
      exact add_le_add (brsMainZeroRight_le_maj hE hp1 hp2.le hq0 r) le_rfl
    · rw [ENNReal.ofReal_eq_zero.mpr (by linarith [not_lt.mp hr0]), zero_mul,
        zero_mul]
  refine ⟨(2 : ENNReal) ^ (1 - 1 / q) *
    (ENNReal.ofReal (brsMainZeroRightTotalConst p q * AE) +
      ENNReal.ofReal ((shellConst 2 p q a AE *
        (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
          ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q))),
    ?_, ?_⟩
  · refine ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg ?_ (by simp)) ?_
    · have : 1 / q ≤ 1 := by
        rw [div_le_one hq0]
        exact hq1
      linarith
    · exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩
  · refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono hsplit)
      (by positivity)) ?_
    refine le_trans (lintegral_radial_rpow_add_le
      (measurable_brsMainZeroRightMaj E p q hg) (by simp) hq1) ?_
    refine le_trans (mul_le_mul' le_rfl
      (add_le_add hnear (le_trans (le_of_eq (one_mul _)) hfar))) ?_
    refine le_trans (mul_le_mul' (le_refl ((2 : ENNReal) ^ (1 - 1 / q))) ?_)
      (le_of_eq (mul_assoc _ _ _).symm)
    refine le_trans (le_of_eq ?_) add_mul_le_add_mul_add
    ring

/-! ## The tail integral behind the endpoint of Proposition 4.3

With `G(λ) = ∫_{f > λ} f dμ`, Minkowski's integral inequality in the level
variable gives `∫_0^∞ λ^{a-1} G(λ)^m dλ ≤ a^{-1}(∫ f^{1+a/m} dμ)^m`.  For
`a = m(p-1)` this is `(m(p-1))^{-1}‖f‖_p^{pm}`, which is exactly what the
endpoint `q = pd` of Proposition 4.3 needs — no interpolation theorem. -/

theorem lintegral_rpow_Ioo_zero_eq {c b : ℝ} (hc : -1 < c) (hb : 0 ≤ b) :
    (∫⁻ s in Ioo (0 : ℝ) b, ENNReal.ofReal (s ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  rcases eq_or_lt_of_le hb with hb0 | hbpos
  · rw [← hb0]
    have hc1 : (0 : ℝ) < c + 1 := by linarith
    simp [Real.zero_rpow hc1.ne']
  · rw [setLIntegral_congr Ioo_ae_eq_Icc, lintegral_rpow_Icc_zero_eq hc hbpos]

/-- The tail of `f` above the height `lam`. -/
def brsTail {α : Type*} [MeasurableSpace α] (μ : Measure α) (f : α → ℝ)
    (lam : ℝ) : ENNReal :=
  ∫⁻ x, {x : α | lam < f x}.indicator (fun x => ENNReal.ofReal (f x)) x ∂μ

/-- **The tail estimate**, by Minkowski's integral inequality. -/
theorem lintegral_brsTail_rpow_le {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℝ} (hf : Measurable f)
    (hfnn : ∀ x, 0 ≤ f x) {a m : ℝ} (hm : 1 ≤ m) (ha : 0 < a)
    (hfin : (∫⁻ lam in Ioi (0 : ℝ),
      ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ≠ ⊤) :
    (∫⁻ lam in Ioi (0 : ℝ),
        ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ^ (1 / m) ≤
      ENNReal.ofReal (a⁻¹ ^ (1 / m)) *
        ∫⁻ x, ENNReal.ofReal (f x ^ (1 + a / m)) ∂μ := by
  have hm0 : (0 : ℝ) < m := lt_of_lt_of_le zero_lt_one hm
  set F : ℝ → α → ENNReal := fun lam x =>
    ENNReal.ofReal (lam ^ ((a - 1) / m)) *
      {x : α | lam < f x}.indicator (fun x => ENNReal.ofReal (f x)) x with hF
  have hFmeas : Measurable (Function.uncurry F) := by
    have h1 : Measurable fun z : ℝ × α =>
        ENNReal.ofReal (z.1 ^ ((a - 1) / m)) := by fun_prop
    have hset : MeasurableSet {z : ℝ × α | z.1 < f z.2} :=
      measurableSet_lt measurable_fst (hf.comp measurable_snd)
    have h2 : Measurable fun z : ℝ × α =>
        {z : ℝ × α | z.1 < f z.2}.indicator
          (fun z => ENNReal.ofReal (f z.2)) z :=
      ((hf.comp measurable_snd).ennreal_ofReal).indicator hset
    have hprod : (Function.uncurry F) = fun z : ℝ × α =>
        ENNReal.ofReal (z.1 ^ ((a - 1) / m)) *
          {z : ℝ × α | z.1 < f z.2}.indicator
            (fun z => ENNReal.ofReal (f z.2)) z := by
      funext z
      rw [hF]
      simp only [Function.uncurry]
      by_cases hz : z.1 < f z.2
      · rw [Set.indicator_of_mem (show z.2 ∈ {x : α | z.1 < f x} from hz),
          Set.indicator_of_mem (show z ∈ {z : ℝ × α | z.1 < f z.2} from hz)]
      · rw [Set.indicator_of_notMem (show z.2 ∉ {x : α | z.1 < f x} from hz),
          Set.indicator_of_notMem (show z ∉ {z : ℝ × α | z.1 < f z.2} from hz)]
    rw [hprod]
    exact h1.mul h2
  -- the outer integrand, as an `m`-th power of an integral of `F`
  have hcongr : (∫⁻ lam in Ioi (0 : ℝ),
      ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) =
      ∫⁻ lam in Ioi (0 : ℝ), (∫⁻ x, F lam x ∂μ) ^ m := by
    refine setLIntegral_congr_fun measurableSet_Ioi ?_
    intro lam hlam
    have hlam0 : (0 : ℝ) < lam := hlam
    show ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m =
      (∫⁻ x, F lam x ∂μ) ^ m
    have hpull : (∫⁻ x, F lam x ∂μ) =
        ENNReal.ofReal (lam ^ ((a - 1) / m)) * brsTail μ f lam := by
      rw [hF, brsTail]
      simp only
      exact lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    rw [hpull, ENNReal.mul_rpow_of_nonneg _ _ hm0.le,
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hlam0 _),
      ← Real.rpow_mul hlam0.le, div_mul_cancel₀ _ hm0.ne']
  rw [hcongr]
  rw [hcongr] at hfin
  refine le_trans (lintegral_rpow_lintegral_le
    (μ := volume.restrict (Ioi (0 : ℝ))) (ν := μ) hm hFmeas hfin) ?_
  -- the inner integral in the level variable
  have hinner : ∀ x : α, (∫⁻ lam in Ioi (0 : ℝ), F lam x ^ m) =
      ENNReal.ofReal (a⁻¹ * f x ^ (m + a)) := by
    intro x
    have hstep : (∫⁻ lam in Ioi (0 : ℝ), F lam x ^ m) =
        ∫⁻ lam in Ioo (0 : ℝ) (f x),
          ENNReal.ofReal (lam ^ (a - 1)) * ENNReal.ofReal (f x ^ m) := by
      rw [← lintegral_indicator measurableSet_Ioo,
        ← lintegral_indicator measurableSet_Ioi]
      refine lintegral_congr fun lam => ?_
      by_cases hlam : lam ∈ Ioi (0 : ℝ)
      · rw [Set.indicator_of_mem hlam]
        have hlam0 : (0 : ℝ) < lam := hlam
        by_cases hz : lam < f x
        · rw [Set.indicator_of_mem (show lam ∈ Ioo (0 : ℝ) (f x) from ⟨hlam0, hz⟩)]
          rw [hF]
          simp only
          rw [Set.indicator_of_mem (show x ∈ {x : α | lam < f x} from hz),
            ENNReal.mul_rpow_of_nonneg _ _ hm0.le,
            ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hlam0 _),
            ← Real.rpow_mul hlam0.le, div_mul_cancel₀ _ hm0.ne',
            ENNReal.ofReal_rpow_of_nonneg (hfnn x) hm0.le]
        · rw [Set.indicator_of_notMem
            (show lam ∉ Ioo (0 : ℝ) (f x) from fun h => hz h.2)]
          rw [hF]
          simp only
          rw [Set.indicator_of_notMem (show x ∉ {x : α | lam < f x} from hz),
            mul_zero, ENNReal.zero_rpow_of_pos hm0]
      · rw [Set.indicator_of_notMem hlam,
          Set.indicator_of_notMem (show lam ∉ Ioo (0 : ℝ) (f x) from
            fun h => hlam h.1)]
    rw [hstep, lintegral_mul_const' _ _ ENNReal.ofReal_ne_top,
      lintegral_rpow_Ioo_zero_eq (by linarith : (-1 : ℝ) < a - 1) (hfnn x),
      show a - 1 + 1 = a from by ring,
      ← ENNReal.ofReal_mul (div_nonneg (Real.rpow_nonneg (hfnn x) _) ha.le)]
    congr 1
    rcases eq_or_lt_of_le (hfnn x) with hx0 | hxpos
    · rw [← hx0, Real.zero_rpow ha.ne',
        Real.zero_rpow (by positivity : m + a ≠ 0)]
      simp
    · rw [div_mul_eq_mul_div, ← Real.rpow_add hxpos, div_eq_inv_mul, add_comm]
  refine le_trans (le_of_eq (lintegral_congr fun x => by rw [hinner x])) ?_
  have hval : ∀ x : α, (ENNReal.ofReal (a⁻¹ * f x ^ (m + a))) ^ (1 / m) =
      ENNReal.ofReal (a⁻¹ ^ (1 / m)) * ENNReal.ofReal (f x ^ (1 + a / m)) := by
    intro x
    rw [ENNReal.ofReal_rpow_of_nonneg
        (mul_nonneg (inv_nonneg.mpr ha.le) (Real.rpow_nonneg (hfnn x) _))
        (by positivity),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg (inv_nonneg.mpr ha.le) _)]
    congr 1
    rw [Real.mul_rpow (inv_nonneg.mpr ha.le) (Real.rpow_nonneg (hfnn x) _),
      ← Real.rpow_mul (hfnn x)]
    congr 2
    field_simp
  rw [lintegral_congr hval, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]

/-! ## The layer-cake formula for `ℝ≥0∞`-valued functions

The repo's `lintegral_enorm_rpow_eq_distribution` is stated for `ℂ`-valued
functions; the maximal operators here are `ℝ≥0∞`-valued, so the same formula is
recorded directly. -/

theorem lintegral_ennreal_rpow_eq_meas_lt {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {F : α → ENNReal} (hF : Measurable F)
    (hfin : ∀ x, F x ≠ ⊤) {q : ℝ} (hq : 0 < q) :
    (∫⁻ x, F x ^ q ∂μ) =
      ENNReal.ofReal q *
        ∫⁻ t in Ioi (0 : ℝ),
          μ {x | ENNReal.ofReal t < F x} * ENNReal.ofReal (t ^ (q - 1)) := by
  set g : α → ℝ := fun x => (F x).toReal with hg
  have hgm : Measurable g := hF.ennreal_toReal
  have hgnn : 0 ≤ᵐ[μ] g :=
    Filter.Eventually.of_forall fun x => ENNReal.toReal_nonneg
  have hkey := lintegral_rpow_eq_lintegral_meas_lt_mul μ hgnn hgm.aemeasurable hq
  have hleft : (∫⁻ x, ENNReal.ofReal (g x ^ q) ∂μ) = ∫⁻ x, F x ^ q ∂μ := by
    refine lintegral_congr fun x => ?_
    rw [← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg hq.le,
      ENNReal.ofReal_toReal (hfin x)]
  have hset : ∀ t : ℝ, 0 < t →
      {x : α | t < g x} = {x : α | ENNReal.ofReal t < F x} := by
    intro t ht
    ext x
    simp only [Set.mem_setOf_eq, hg]
    rw [ENNReal.ofReal_lt_iff_lt_toReal ht.le (hfin x)]
  rw [hleft] at hkey
  rw [hkey]
  congr 1
  refine setLIntegral_congr_fun measurableSet_Ioi ?_
  intro t ht
  show μ {a | t < g a} * ENNReal.ofReal (t ^ (q - 1)) =
    μ {x | ENNReal.ofReal t < F x} * ENNReal.ofReal (t ^ (q - 1))
  rw [hset t ht]

/-! ## The tail estimate over a sub-domain of levels

The endpoint of Proposition 4.3 needs the Minkowski tail estimate on a bounded
range of levels, where its finiteness hypothesis is checkable. -/

/-- The level integral of the tail kernel at a fixed height `c`. -/
theorem lintegral_tail_kernel_eq {a m c : ℝ} (hm : 0 < m) (ha : 0 < a)
    (hc : 0 ≤ c) :
    (∫⁻ lam in Ioi (0 : ℝ),
        (ENNReal.ofReal (lam ^ ((a - 1) / m)) *
          (Iio c).indicator (fun _ => ENNReal.ofReal c) lam) ^ m) =
      ENNReal.ofReal (a⁻¹ * c ^ (m + a)) := by
  have hstep : (∫⁻ lam in Ioi (0 : ℝ),
      (ENNReal.ofReal (lam ^ ((a - 1) / m)) *
        (Iio c).indicator (fun _ => ENNReal.ofReal c) lam) ^ m) =
      ∫⁻ lam in Ioo (0 : ℝ) c,
        ENNReal.ofReal (lam ^ (a - 1)) * ENNReal.ofReal (c ^ m) := by
    rw [← lintegral_indicator measurableSet_Ioo,
      ← lintegral_indicator measurableSet_Ioi]
    refine lintegral_congr fun lam => ?_
    by_cases hlam : lam ∈ Ioi (0 : ℝ)
    · rw [Set.indicator_of_mem hlam]
      have hlam0 : (0 : ℝ) < lam := hlam
      by_cases hz : lam < c
      · rw [Set.indicator_of_mem (show lam ∈ Ioo (0 : ℝ) c from ⟨hlam0, hz⟩),
          Set.indicator_of_mem (show lam ∈ Iio c from hz),
          ENNReal.mul_rpow_of_nonneg _ _ hm.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hlam0 _),
          ← Real.rpow_mul hlam0.le, div_mul_cancel₀ _ hm.ne',
          ENNReal.ofReal_rpow_of_nonneg hc hm.le]
      · rw [Set.indicator_of_notMem
            (show lam ∉ Ioo (0 : ℝ) c from fun h => hz h.2),
          Set.indicator_of_notMem (show lam ∉ Iio c from hz),
          mul_zero, ENNReal.zero_rpow_of_pos hm]
    · rw [Set.indicator_of_notMem hlam,
        Set.indicator_of_notMem
          (show lam ∉ Ioo (0 : ℝ) c from fun h => hlam h.1)]
  rw [hstep, lintegral_mul_const' _ _ ENNReal.ofReal_ne_top,
    lintegral_rpow_Ioo_zero_eq (by linarith : (-1 : ℝ) < a - 1) hc,
    show a - 1 + 1 = a from by ring,
    ← ENNReal.ofReal_mul (div_nonneg (Real.rpow_nonneg hc _) ha.le)]
  congr 1
  rcases eq_or_lt_of_le hc with hc0 | hcpos
  · rw [← hc0, Real.zero_rpow ha.ne', Real.zero_rpow (by positivity : m + a ≠ 0)]
    simp
  · rw [div_mul_eq_mul_div, ← Real.rpow_add hcpos, div_eq_inv_mul, add_comm]

/-- **The tail estimate on a sub-domain of levels.** -/
theorem lintegral_brsTail_rpow_le_subset {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℝ} (hf : Measurable f)
    (hfnn : ∀ x, 0 ≤ f x) {a m : ℝ} (hm : 1 ≤ m) (ha : 0 < a)
    {S : Set ℝ} (hS : MeasurableSet S) (hSsub : S ⊆ Ioi (0 : ℝ))
    (hfin : (∫⁻ lam in S,
      ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ≠ ⊤) :
    (∫⁻ lam in S,
        ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ^ (1 / m) ≤
      ENNReal.ofReal (a⁻¹ ^ (1 / m)) *
        ∫⁻ x, ENNReal.ofReal (f x ^ (1 + a / m)) ∂μ := by
  have hm0 : (0 : ℝ) < m := lt_of_lt_of_le zero_lt_one hm
  set F : ℝ → α → ENNReal := fun lam x =>
    ENNReal.ofReal (lam ^ ((a - 1) / m)) *
      {x : α | lam < f x}.indicator (fun x => ENNReal.ofReal (f x)) x with hF
  have hind : ∀ (lam : ℝ) (x : α),
      {x : α | lam < f x}.indicator (fun x => ENNReal.ofReal (f x)) x =
        (Iio (f x)).indicator (fun _ => ENNReal.ofReal (f x)) lam := by
    intro lam x
    by_cases hz : lam < f x
    · rw [Set.indicator_of_mem (show x ∈ {x : α | lam < f x} from hz),
        Set.indicator_of_mem (show lam ∈ Iio (f x) from hz)]
    · rw [Set.indicator_of_notMem (show x ∉ {x : α | lam < f x} from hz),
        Set.indicator_of_notMem (show lam ∉ Iio (f x) from hz)]
  have hFmeas : Measurable (Function.uncurry F) := by
    have h1 : Measurable fun z : ℝ × α =>
        ENNReal.ofReal (z.1 ^ ((a - 1) / m)) := by fun_prop
    have hset : MeasurableSet {z : ℝ × α | z.1 < f z.2} :=
      measurableSet_lt measurable_fst (hf.comp measurable_snd)
    have h2 : Measurable fun z : ℝ × α =>
        {z : ℝ × α | z.1 < f z.2}.indicator
          (fun z => ENNReal.ofReal (f z.2)) z :=
      ((hf.comp measurable_snd).ennreal_ofReal).indicator hset
    have hprod : (Function.uncurry F) = fun z : ℝ × α =>
        ENNReal.ofReal (z.1 ^ ((a - 1) / m)) *
          {z : ℝ × α | z.1 < f z.2}.indicator
            (fun z => ENNReal.ofReal (f z.2)) z := by
      funext z
      rw [hF]
      simp only [Function.uncurry]
      by_cases hz : z.1 < f z.2
      · rw [Set.indicator_of_mem (show z.2 ∈ {x : α | z.1 < f x} from hz),
          Set.indicator_of_mem (show z ∈ {z : ℝ × α | z.1 < f z.2} from hz)]
      · rw [Set.indicator_of_notMem (show z.2 ∉ {x : α | z.1 < f x} from hz),
          Set.indicator_of_notMem (show z ∉ {z : ℝ × α | z.1 < f z.2} from hz)]
    rw [hprod]
    exact h1.mul h2
  have hcongr : (∫⁻ lam in S,
      ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) =
      ∫⁻ lam in S, (∫⁻ x, F lam x ∂μ) ^ m := by
    refine setLIntegral_congr_fun hS ?_
    intro lam hlam
    have hlam0 : (0 : ℝ) < lam := hSsub hlam
    show ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m =
      (∫⁻ x, F lam x ∂μ) ^ m
    have hpull : (∫⁻ x, F lam x ∂μ) =
        ENNReal.ofReal (lam ^ ((a - 1) / m)) * brsTail μ f lam := by
      rw [hF, brsTail]
      simp only
      exact lintegral_const_mul' _ _ ENNReal.ofReal_ne_top
    rw [hpull, ENNReal.mul_rpow_of_nonneg _ _ hm0.le,
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hlam0 _),
      ← Real.rpow_mul hlam0.le, div_mul_cancel₀ _ hm0.ne']
  rw [hcongr]
  rw [hcongr] at hfin
  refine le_trans (lintegral_rpow_lintegral_le
    (μ := volume.restrict S) (ν := μ) hm hFmeas hfin) ?_
  have hinner : ∀ x : α, (∫⁻ lam in S, F lam x ^ m) ≤
      ENNReal.ofReal (a⁻¹ * f x ^ (m + a)) := by
    intro x
    refine le_trans (lintegral_mono_set hSsub) (le_of_eq ?_)
    rw [← lintegral_tail_kernel_eq (a := a) (m := m) (c := f x) hm0 ha (hfnn x)]
    refine lintegral_congr fun lam => ?_
    simp only [hF, hind]
  refine le_trans (lintegral_mono fun x =>
    ENNReal.rpow_le_rpow (hinner x) (by positivity : (0 : ℝ) ≤ 1 / m)) ?_
  have hval : ∀ x : α, (ENNReal.ofReal (a⁻¹ * f x ^ (m + a))) ^ (1 / m) =
      ENNReal.ofReal (a⁻¹ ^ (1 / m)) * ENNReal.ofReal (f x ^ (1 + a / m)) := by
    intro x
    rw [ENNReal.ofReal_rpow_of_nonneg
        (mul_nonneg (inv_nonneg.mpr ha.le) (Real.rpow_nonneg (hfnn x) _))
        (by positivity),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg (inv_nonneg.mpr ha.le) _)]
    congr 1
    rw [Real.mul_rpow (inv_nonneg.mpr ha.le) (Real.rpow_nonneg (hfnn x) _),
      ← Real.rpow_mul (hfnn x)]
    congr 2
    field_simp
  rw [lintegral_congr hval, lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]

/-- Chebyshev-type bound for the tail. -/
theorem brsTail_le_lintegral_rpow {α : Type*} [MeasurableSpace α]
    {μ : Measure α} {f : α → ℝ} (hfnn : ∀ x, 0 ≤ f x) {p lam : ℝ}
    (hp : 1 ≤ p) (hlam : 0 < lam) :
    brsTail μ f lam ≤ ENNReal.ofReal (lam ^ (1 - p)) *
      ∫⁻ x, ENNReal.ofReal (f x) ^ p ∂μ := by
  rw [brsTail, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun x => ?_
  by_cases hx : lam < f x
  · rw [Set.indicator_of_mem (show x ∈ {x : α | lam < f x} from hx)]
    have hfx : 0 < f x := lt_trans hlam hx
    have h1 : f x ^ (1 - p) ≤ lam ^ (1 - p) :=
      rpow_le_rpow_of_nonpos_exp hlam hx.le (by linarith)
    have h2 : f x ^ (1 - p) * f x ^ p = f x := by
      rw [← Real.rpow_add hfx, show 1 - p + p = 1 from by ring, Real.rpow_one]
    have hstep : f x ≤ lam ^ (1 - p) * f x ^ p := by
      calc f x = f x ^ (1 - p) * f x ^ p := h2.symm
        _ ≤ lam ^ (1 - p) * f x ^ p :=
            mul_le_mul_of_nonneg_right h1 (Real.rpow_nonneg hfx.le _)
    calc ENNReal.ofReal (f x) ≤ ENNReal.ofReal (lam ^ (1 - p) * f x ^ p) :=
          ENNReal.ofReal_le_ofReal hstep
      _ = ENNReal.ofReal (lam ^ (1 - p)) * ENNReal.ofReal (f x) ^ p := by
          rw [ENNReal.ofReal_mul (Real.rpow_nonneg hlam.le _),
            ENNReal.ofReal_rpow_of_nonneg (hfnn x) (by linarith : (0:ℝ) ≤ p)]
  · rw [Set.indicator_of_notMem (show x ∉ {x : α | lam < f x} from hx)]
    simp

/-! ## The tail estimate over all levels

Monotone convergence upgrades the sub-domain estimate to the full half-line;
the finiteness hypothesis is checkable on each bounded piece by the
Chebyshev bound. -/

theorem antitone_brsTail {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (f : α → ℝ) : Antitone (fun lam : ℝ => brsTail μ f lam) := by
  intro u v huv
  refine lintegral_mono fun x => ?_
  by_cases hx : v < f x
  · rw [Set.indicator_of_mem (show x ∈ {x : α | v < f x} from hx),
      Set.indicator_of_mem (show x ∈ {x : α | u < f x} from lt_of_le_of_lt huv hx)]
  · rw [Set.indicator_of_notMem (show x ∉ {x : α | v < f x} from hx)]
    simp

theorem measurable_brsTail {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (f : α → ℝ) : Measurable (fun lam : ℝ => brsTail μ f lam) :=
  (antitone_brsTail μ f).measurable

/-- **The tail estimate over all levels.** -/
theorem lintegral_brsTail_rpow_le_total {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℝ} (hf : Measurable f)
    (hfnn : ∀ x, 0 ≤ f x) {p a m : ℝ} (hp : 1 ≤ p) (hm : 1 ≤ m) (ha : 0 < a)
    (hpa : 1 + a / m = p) :
    (∫⁻ lam in Ioi (0 : ℝ),
        ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ≤
      ENNReal.ofReal a⁻¹ * (∫⁻ x, ENNReal.ofReal (f x) ^ p ∂μ) ^ m := by
  have hm0 : (0 : ℝ) < m := lt_of_lt_of_le zero_lt_one hm
  have hp0 : (0 : ℝ) ≤ p := by linarith
  set X : ENNReal := ∫⁻ x, ENNReal.ofReal (f x) ^ p ∂μ with hX
  set F : ℝ → ENNReal := fun lam =>
    ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m with hFdef
  have hFmeas : Measurable F := by
    have h1 : Measurable fun lam : ℝ => ENNReal.ofReal (lam ^ (a - 1)) := by
      fun_prop
    have h2 : Measurable fun lam : ℝ => brsTail μ f lam ^ m :=
      ENNReal.continuous_rpow_const.measurable.comp (measurable_brsTail μ f)
    exact h1.mul h2
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos hm0,
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact inv_pos.mpr ha)]
    exact le_top
  -- the exhausting family of level windows
  set S : ℕ → Set ℝ := fun n => Ioc (((n : ℝ) + 1)⁻¹) ((n : ℝ) + 1) with hSdef
  have hSpos : ∀ n : ℕ, (0 : ℝ) < ((n : ℝ) + 1)⁻¹ := by
    intro n
    positivity
  have hSmeas : ∀ n : ℕ, MeasurableSet (S n) := fun n => measurableSet_Ioc
  have hSsub : ∀ n : ℕ, S n ⊆ Ioi (0 : ℝ) := by
    intro n lam hlam
    exact lt_trans (hSpos n) hlam.1
  have hSmono : Monotone S := by
    intro i j hij lam hlam
    have hij' : ((i : ℝ) + 1) ≤ ((j : ℝ) + 1) := by
      have : (i : ℝ) ≤ (j : ℝ) := by exact_mod_cast hij
      linarith
    refine ⟨lt_of_le_of_lt ?_ hlam.1, le_trans hlam.2 hij'⟩
    have hpos : (0 : ℝ) < (i : ℝ) + 1 := by positivity
    gcongr
  -- each window carries a finite integral
  have hfin : ∀ n : ℕ, (∫⁻ lam in S n, F lam) ≠ ⊤ := by
    intro n
    set c : ℝ := ((n : ℝ) + 1)⁻¹ with hc
    have hcpos : (0 : ℝ) < c := hSpos n
    set C : ENNReal := (ENNReal.ofReal (c ^ (1 - p)) * X) ^ m with hC
    have hCtop : C ≠ ⊤ := by
      refine ENNReal.rpow_ne_top_of_nonneg hm0.le ?_
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hXtop
    have hb : ∀ lam ∈ S n, F lam ≤ ENNReal.ofReal (lam ^ (a - 1)) * C := by
      intro lam hlam
      have hlam0 : (0 : ℝ) < lam := hSsub n hlam
      refine mul_le_mul' le_rfl ?_
      rw [hC]
      refine ENNReal.rpow_le_rpow ?_ hm0.le
      refine le_trans (brsTail_le_lintegral_rpow hfnn hp hlam0) ?_
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact rpow_le_rpow_of_nonpos_exp hcpos hlam.1.le (by linarith)
    have hweight : (∫⁻ lam in S n, ENNReal.ofReal (lam ^ (a - 1))) ≠ ⊤ := by
      refine ne_of_lt (lt_of_le_of_lt ?_
        (lintegral_rpow_Ioc_lt_top (b := (n : ℝ) + 1) (a := a - 1)
          (by positivity) (by linarith)))
      refine lintegral_mono_set ?_
      intro lam hlam
      exact ⟨lt_trans (hSpos n) hlam.1, hlam.2⟩
    refine ne_of_lt (lt_of_le_of_lt (setLIntegral_mono' (hSmeas n) hb) ?_)
    rw [lintegral_mul_const' _ _ hCtop]
    exact ENNReal.mul_lt_top (lt_of_le_of_ne le_top hweight)
      (lt_of_le_of_ne le_top hCtop)
  -- the uniform bound on each window
  have hstep : ∀ n : ℕ, (∫⁻ lam in S n, F lam) ≤ ENNReal.ofReal a⁻¹ * X ^ m := by
    intro n
    have hsub := lintegral_brsTail_rpow_le_subset hf hfnn hm ha (hSmeas n)
      (hSsub n) (hfin n)
    have hrhs : (∫⁻ x, ENNReal.ofReal (f x ^ (1 + a / m)) ∂μ) = X := by
      rw [hX]
      refine lintegral_congr fun x => ?_
      rw [hpa, ENNReal.ofReal_rpow_of_nonneg (hfnn x) hp0]
    rw [hrhs] at hsub
    have hpow := ENNReal.rpow_le_rpow hsub hm0.le
    rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hm0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hm0.le,
      ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (inv_nonneg.mpr ha.le) _)
        hm0.le,
      ← Real.rpow_mul (inv_nonneg.mpr ha.le), inv_mul_cancel₀ hm0.ne',
      Real.rpow_one] at hpow
    exact hpow
  -- monotone convergence
  have hcover : ∀ lam : ℝ,
      (Ioi (0 : ℝ)).indicator F lam = ⨆ n : ℕ, (S n).indicator F lam := by
    intro lam
    by_cases hlam : (0 : ℝ) < lam
    · rw [Set.indicator_of_mem (show lam ∈ Ioi (0 : ℝ) from hlam)]
      obtain ⟨n, hn⟩ := exists_nat_gt (max lam lam⁻¹)
      have hn1 : lam ≤ (n : ℝ) + 1 := by
        have := lt_of_le_of_lt (le_max_left lam lam⁻¹) hn
        linarith
      have hn2 : ((n : ℝ) + 1)⁻¹ < lam := by
        have hinv : lam⁻¹ < (n : ℝ) + 1 :=
          lt_trans (lt_of_le_of_lt (le_max_right lam lam⁻¹) hn) (by linarith)
        have hnn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
        rw [inv_lt_comm₀ hnn hlam]
        exact hinv
      refine le_antisymm (le_iSup_of_le n ?_) (iSup_le fun k => ?_)
      · rw [Set.indicator_of_mem (show lam ∈ S n from ⟨hn2, hn1⟩)]
      · exact Set.indicator_le_self' (fun _ _ => bot_le) lam
    · rw [Set.indicator_of_notMem (show lam ∉ Ioi (0 : ℝ) from hlam)]
      refine le_antisymm (by simp) (iSup_le fun k => ?_)
      rw [Set.indicator_of_notMem
        (show lam ∉ S k from fun h => hlam (hSsub k h))]
  have hmono' : Monotone fun n : ℕ => (S n).indicator F := by
    intro i j hij
    exact indicator_le_indicator_of_subset (hSmono hij) (fun _ => bot_le)
  have hkey : (∫⁻ lam in Ioi (0 : ℝ), F lam) = ⨆ n : ℕ, ∫⁻ lam in S n, F lam := by
    rw [← lintegral_indicator measurableSet_Ioi]
    simp only [hcover]
    rw [lintegral_iSup (fun n => hFmeas.indicator (hSmeas n)) hmono']
    exact iSup_congr fun n => lintegral_indicator (hSmeas n) _
  rw [hkey]
  exact iSup_le hstep

/-! ## Splitting `R₂` at a height

The radial measure `s^{d-1} ds` and the elementary splitting
`R₂f₀(r) ≤ 3^{d-1} r^{-1} G(λ) + 2λ` that drives the endpoint `q = pd`. -/

/-- The radial measure `s^{d-1} ds` on the line. -/
def brsWeightMeasure (d : ℕ) : Measure ℝ :=
  volume.withDensity (fun s => ENNReal.ofReal s ^ (d - 1))

instance instSFinite_brsWeightMeasure (d : ℕ) : SFinite (brsWeightMeasure d) := by
  unfold brsWeightMeasure
  infer_instance

theorem measurable_brsWeightDensity (d : ℕ) :
    Measurable (fun s : ℝ => ENNReal.ofReal s ^ (d - 1)) := by fun_prop

theorem lintegral_brsWeightMeasure {d : ℕ} {g : ℝ → ENNReal} (hg : Measurable g) :
    (∫⁻ s, g s ∂(brsWeightMeasure d)) =
      ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
  rw [brsWeightMeasure,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_brsWeightDensity d) hg]
  rfl

/-- **Splitting `R₂` at the height `lam`.** -/
theorem brsRemainderTwo_le_tail {d : ℕ} {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r lam : ℝ} (hr : 0 < r) (hlam : 0 < lam) :
    brsRemainderTwo (absProfile f₀) r ≤
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) *
          brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam +
        ENNReal.ofReal (2 * lam) := by
  have hmeasf : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set T : ENNReal := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  set g : ℝ → ENNReal := fun s =>
    {s : ℝ | lam < ‖f₀ s‖}.indicator (fun s => ENNReal.ofReal ‖f₀ s‖) s with hg
  have hgm : Measurable g := by
    rw [hg]
    exact (hmeasf.ennreal_ofReal).indicator
      (measurableSet_lt measurable_const hmeasf)
  have hTeq : T = ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
    rw [hT, brsTail]
    exact lintegral_brsWeightMeasure hgm
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have htr' : 3 * r / 2 ≤ t := htr
  have hab : t - r ≤ t + r := by linarith
  have hlow : (1 : ℝ) / 3 ≤ t - r := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * (ENNReal.ofReal s ^ (d - 1) * g s) +
      ENNReal.ofReal lam with hH
  have hHbound : ∀ s ∈ Icc (t - r) (t + r),
      ENNReal.ofReal ‖absProfile f₀ s‖ ≤ H s := by
    intro s hs
    have hs13 : (1 : ℝ) / 3 ≤ s := le_trans hlow hs.1
    have hsnn : (0 : ℝ) ≤ s := by linarith
    have hnorm : ‖absProfile f₀ s‖ = ‖f₀ s‖ := by
      rw [absProfile]
      simp
    rw [hnorm, hH]
    simp only
    by_cases hz : lam < ‖f₀ s‖
    · have hone : (1 : ENNReal) ≤
          ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1) := by
        rw [← ENNReal.ofReal_pow hsnn,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (d - 1)),
          ← mul_pow]
        refine ENNReal.one_le_ofReal.mpr ?_
        exact one_le_pow₀ (by linarith)
      calc ENNReal.ofReal ‖f₀ s‖
          = 1 * ENNReal.ofReal ‖f₀ s‖ := (one_mul _).symm
        _ ≤ (ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1)) *
              ENNReal.ofReal ‖f₀ s‖ := mul_le_mul' hone le_rfl
        _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
              (ENNReal.ofReal s ^ (d - 1) * g s) := by
            rw [hg]
            simp only
            rw [Set.indicator_of_mem (show s ∈ {s : ℝ | lam < ‖f₀ s‖} from hz)]
            ring
        _ ≤ _ := le_self_add
    · push Not at hz
      exact le_trans (ENNReal.ofReal_le_ofReal hz) le_add_self
  have hkey := ofReal_norm_intervalIntegral_le_lintegral hab (absProfile f₀) H
    hHbound
  have hHint : (∫⁻ s in Icc (t - r) (t + r), H s) ≤
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * T +
        ENNReal.ofReal lam * ENNReal.ofReal (2 * r) := by
    rw [hH]
    simp only
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      Real.volume_Icc, show t + r - (t - r) = 2 * r from by ring]
    refine add_le_add ?_ le_rfl
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hTeq]
    exact mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
  have e1 : ENNReal.ofReal r⁻¹ * ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) =
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) := by
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    ring
  have e2 : ENNReal.ofReal r⁻¹ *
      (ENNReal.ofReal lam * ENNReal.ofReal (2 * r)) =
      ENNReal.ofReal (2 * lam) := by
    rw [← ENNReal.ofReal_mul hlam.le,
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    field_simp
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖)
      = ENNReal.ofReal r⁻¹ *
          ENNReal.ofReal ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal r⁻¹ *
          (ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * T +
            ENNReal.ofReal lam * ENNReal.ofReal (2 * r)) :=
        mul_le_mul' le_rfl (le_trans hkey hHint)
    _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) * T +
          ENNReal.ofReal (2 * lam) := by
        rw [mul_add, ← mul_assoc, e1, e2]

/-! ## The level sets of `R₂`

Splitting at the height `u/4` confines `{R₂f₀ > u}` to an interval whose
length is controlled by the tail of `f₀`. -/

theorem brsRemainderTwo_eq_zero_of_nonpos {f₀ : ℝ → ℂ} {r : ℝ} (hr : r ≤ 0) :
    brsRemainderTwo (absProfile f₀) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  refine le_of_eq (ENNReal.ofReal_eq_zero.mpr ?_)
  exact mul_nonpos_of_nonpos_of_nonneg (inv_nonpos.mpr hr) (norm_nonneg _)

theorem brsWeightMeasure_Ioo {d : ℕ} (hd : 1 ≤ d) {b : ℝ} (hb : 0 ≤ b) :
    brsWeightMeasure d (Ioo 0 b) = ENNReal.ofReal (b ^ d / (d : ℝ)) := by
  have hdR : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  rw [brsWeightMeasure, withDensity_apply _ measurableSet_Ioo]
  have hc : ∀ s ∈ Ioo (0 : ℝ) b, ENNReal.ofReal s ^ (d - 1) =
      ENNReal.ofReal (s ^ ((d : ℝ) - 1)) := by
    intro s hs
    rw [← ENNReal.ofReal_pow hs.1.le]
    congr 1
    simpa using pow_sub_eq_rpow hs.1 (D := d) (k := 1) hd
  rw [setLIntegral_congr_fun measurableSet_Ioo hc,
    lintegral_rpow_Ioo_zero_eq (by linarith : (-1 : ℝ) < (d : ℝ) - 1) hb]
  congr 1
  rw [show (d : ℝ) - 1 + 1 = (d : ℝ) from by ring, Real.rpow_natCast]

/-- **The level sets of `R₂`.** -/
theorem measure_brsRemainderTwo_gt_le {d : ℕ} (hd : 2 ≤ d) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {u : ℝ} (hu : 0 < u) :
    brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} ≤
      ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) *
        brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / 4) ^ d := by
  have hune : u ≠ 0 := ne_of_gt hu
  have hdpos : (0 : ℝ) < (d : ℝ) := by
    have : (0 : ℕ) < d := by omega
    exact_mod_cast this
  have hCnonneg : (0 : ℝ) ≤ (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) :=
    div_nonneg (pow_nonneg (by positivity) d) hdpos.le
  set T := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / 4) with hT
  by_cases hTtop : T = ⊤
  · rw [hTtop, ENNReal.top_pow (by omega : d ≠ 0),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact lt_of_lt_of_le (by positivity)
          (le_of_eq (rfl : ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) =
            (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ))))]
    exact le_top
  set g : ℝ := T.toReal with hg
  have hgnn : (0 : ℝ) ≤ g := ENNReal.toReal_nonneg
  have hTg : T = ENNReal.ofReal g := (ENNReal.ofReal_toReal hTtop).symm
  set rho : ℝ := 2 * (3 : ℝ) ^ (d - 1) * g / u with hrho
  have hrhonn : (0 : ℝ) ≤ rho := by
    rw [hrho]
    positivity
  have hsub : {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} ⊆
      Ioo 0 rho := by
    intro r hr
    simp only [Set.mem_setOf_eq] at hr
    have hr0 : 0 < r := by
      by_contra hc
      push Not at hc
      rw [brsRemainderTwo_eq_zero_of_nonpos hc] at hr
      simp at hr
    have hrne : r ≠ 0 := ne_of_gt hr0
    have hsplit := brsRemainderTwo_le_tail (d := d) hf₀ hr0
      (by positivity : (0 : ℝ) < u / 4)
    rw [← hT, hTg] at hsplit
    have hlt : ENNReal.ofReal u <
        ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) * ENNReal.ofReal g +
          ENNReal.ofReal (2 * (u / 4)) := lt_of_lt_of_le hr hsplit
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (d - 1) * r⁻¹),
      ← ENNReal.ofReal_add (by positivity) (by positivity)] at hlt
    have hreal : u < (3 : ℝ) ^ (d - 1) * r⁻¹ * g + 2 * (u / 4) :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hu.le).mp hlt
    refine ⟨hr0, ?_⟩
    rw [hrho, lt_div_iff₀ hu]
    have h2 : u / 2 < (3 : ℝ) ^ (d - 1) * r⁻¹ * g := by linarith
    have h3 : r * u / 2 < (3 : ℝ) ^ (d - 1) * g := by
      calc r * u / 2 = r * (u / 2) := by ring
        _ < r * ((3 : ℝ) ^ (d - 1) * r⁻¹ * g) := mul_lt_mul_of_pos_left h2 hr0
        _ = (3 : ℝ) ^ (d - 1) * g := by field_simp
    linarith
  calc brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r}
      ≤ brsWeightMeasure d (Ioo 0 rho) := measure_mono hsub
    _ = ENNReal.ofReal (rho ^ d / (d : ℝ)) :=
        brsWeightMeasure_Ioo (by omega) hrhonn
    _ = ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) * T ^ d := by
        rw [hTg, ← ENNReal.ofReal_pow hgnn, ← ENNReal.ofReal_mul hCnonneg]
        congr 1
        rw [hrho]
        field_simp
        ring

/-! ## Proposition 4.3 at the endpoint `q = pd`

The crude bound `R₂f₀(r) ≲ r^{-1/p}‖f₀‖_p` loses a logarithm at `q = pd`.
Splitting `f₀` at a height, the layer-cake formula and Minkowski's integral
inequality replace it; no interpolation theorem is needed.  The hypothesis
`p > 1` is what makes the level integral converge. -/

theorem brsTail_smul {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (f : α → ℝ) {c : ℝ} (hc : 0 < c) (u : ℝ) :
    brsTail μ (fun x => c * f x) u =
      ENNReal.ofReal c * brsTail μ f (u / c) := by
  rw [brsTail, brsTail, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun x => ?_
  by_cases hx : u / c < f x
  · have hx' : u < c * f x := by
      rw [div_lt_iff₀ hc] at hx
      linarith
    rw [Set.indicator_of_mem (show x ∈ {x : α | u < c * f x} from hx'),
      Set.indicator_of_mem (show x ∈ {x : α | u / c < f x} from hx),
      ← ENNReal.ofReal_mul hc.le]
  · have hx' : ¬ (u < c * f x) := by
      intro hcon
      exact hx (by rw [div_lt_iff₀ hc]; linarith)
    rw [Set.indicator_of_notMem (show x ∉ {x : α | u < c * f x} from hx'),
      Set.indicator_of_notMem (show x ∉ {x : α | u / c < f x} from hx), mul_zero]

/-- **BRS Proposition 4.3 at the endpoint `q = pd`, for `p > 1`.** -/
theorem prop43_brsRemainderTwo_endpoint {d : ℕ} (hd : 2 ≤ d) {p : ℝ}
    (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsRemainderTwo (absProfile f₀) r ^ (p * (d : ℝ))) ^
            (1 / (p * (d : ℝ))) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
            (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hdnat : 0 < d := by omega
  have hdpos : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hdnat
  have hdone : (1 : ℝ) ≤ (d : ℝ) := by
    have : (1 : ℕ) ≤ d := by omega
    exact_mod_cast this
  set q : ℝ := p * (d : ℝ) with hq
  have hq0 : (0 : ℝ) < q := by rw [hq]; positivity
  set a : ℝ := (d : ℝ) * (p - 1) with ha
  have ha0 : (0 : ℝ) < a := by
    rw [ha]
    have h1 : (0 : ℝ) < p - 1 := by linarith
    positivity
  set K : ℝ := (2 * (3 : ℝ) ^ (d - 1)) ^ d / ((d : ℝ) * 4 ^ d) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  have hCpos : (0 : ℝ) < (q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q) := by
    have h4 : (0 : ℝ) < (4 : ℝ) ^ q := Real.rpow_pos_of_pos (by norm_num) _
    have : (0 : ℝ) < q * K * a⁻¹ * (4 : ℝ) ^ q := by positivity
    exact Real.rpow_pos_of_pos this _
  refine ⟨(q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q), hCpos, ?_⟩
  intro f₀ hf₀
  have hcont : Continuous (absProfile f₀) := continuous_absProfile hf₀
  have hR2meas : Measurable (brsRemainderTwo (absProfile f₀)) :=
    measurable_brsRemainderTwo hcont
  have hnormmeas : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set μ : Measure ℝ := brsWeightMeasure d with hmu
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact hCpos)]
    exact le_top
  -- `R₂` is finite
  have hR2fin : ∀ r : ℝ, brsRemainderTwo (absProfile f₀) r ≠ ⊤ := by
    intro r
    refine ne_top_of_le_ne_top ?_ (brsRemainderTwo_le_local hd hp.le hf₀ r)
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    exact ne_top_of_le_ne_top hXtop (setLIntegral_le_lintegral _ _)
  -- the two weighted integrals as integrals against `μ`
  have hmuX : X = ∫⁻ s, (ENNReal.ofReal ‖f₀ s‖) ^ p ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun s => (ENNReal.ofReal ‖f₀ s‖) ^ p)
      (ENNReal.continuous_rpow_const.measurable.comp hnormmeas.ennreal_ofReal), hX]
  have hLHS : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q) =
      ∫⁻ r, brsRemainderTwo (absProfile f₀) r ^ q ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun r => brsRemainderTwo (absProfile f₀) r ^ q)
      (ENNReal.continuous_rpow_const.measurable.comp hR2meas)]
  have hlayer := lintegral_ennreal_rpow_eq_meas_lt (μ := μ) hR2meas hR2fin hq0
  -- the pointwise bound on the level integrand
  have hpt : ∀ u ∈ Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} *
          ENNReal.ofReal (u ^ (q - 1)) ≤
        ENNReal.ofReal K * (ENNReal.ofReal (u ^ (a - 1)) *
          brsTail μ (fun s => 4 * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ)) := by
    intro u hu0
    have hu : (0 : ℝ) < u := hu0
    have hune : u ≠ 0 := ne_of_gt hu
    refine le_trans (mul_le_mul' (measure_brsRemainderTwo_gt_le hd hf₀ hu) le_rfl) ?_
    refine le_of_eq ?_
    rw [brsTail_smul (fun s => ‖f₀ s‖) (by norm_num : (0 : ℝ) < 4) u,
      ENNReal.rpow_natCast]
    set S : ENNReal := brsTail μ (fun s => ‖f₀ s‖) (u / 4) with hS
    have hAnn : (0 : ℝ) ≤ (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) :=
      div_nonneg (pow_nonneg (by positivity) d) hdpos.le
    have hupow : u ^ (q - 1) = u ^ (a - 1) * u ^ d := by
      rw [← Real.rpow_natCast u d, ← Real.rpow_add hu]
      congr 1
      rw [hq, ha]
      ring
    have ereal : (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) * u ^ (q - 1) =
        K * u ^ (a - 1) * (4 : ℝ) ^ d := by
      rw [hupow, hK, div_pow]
      field_simp
    have hL : ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) * S ^ d *
        ENNReal.ofReal (u ^ (q - 1)) =
        ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) *
          u ^ (q - 1)) * S ^ d := by
      rw [ENNReal.ofReal_mul hAnn]
      ring
    have hR : ENNReal.ofReal K *
        (ENNReal.ofReal (u ^ (a - 1)) * (ENNReal.ofReal 4 * S) ^ d) =
        ENNReal.ofReal (K * u ^ (a - 1) * (4 : ℝ) ^ d) * S ^ d := by
      rw [mul_pow, ← ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 4),
        ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * u ^ (a - 1)),
        ENNReal.ofReal_mul hKpos.le]
      ring
    rw [hL, hR, ereal]
  have hstep : (∫⁻ u in Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} *
        ENNReal.ofReal (u ^ (q - 1))) ≤
      ENNReal.ofReal K * ∫⁻ u in Ioi (0 : ℝ), ENNReal.ofReal (u ^ (a - 1)) *
        brsTail μ (fun s => 4 * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioi hpt
  -- the tail estimate
  have hhmeas : Measurable fun s : ℝ => 4 * ‖f₀ s‖ := measurable_const.mul hnormmeas
  have hhnn : ∀ s : ℝ, (0 : ℝ) ≤ 4 * ‖f₀ s‖ := fun s => by positivity
  have hpa : 1 + a / ((d : ℕ) : ℝ) = p := by
    rw [ha]
    field_simp
    ring
  have htail := lintegral_brsTail_rpow_le_total (μ := μ) hhmeas hhnn
    (p := p) (a := a) (m := ((d : ℕ) : ℝ)) hp.le hdone ha0 hpa
  have hXh : (∫⁻ s, ENNReal.ofReal (4 * ‖f₀ s‖) ^ p ∂μ) =
      ENNReal.ofReal ((4 : ℝ) ^ p) * X := by
    rw [hmuX, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun s => ?_
    rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
      ENNReal.mul_rpow_of_nonneg _ _ hp0.le,
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
  rw [hXh] at htail
  have hpow4 : (ENNReal.ofReal ((4 : ℝ) ^ p) * X) ^ ((d : ℕ) : ℝ) =
      ENNReal.ofReal ((4 : ℝ) ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ ((d : ℕ) : ℝ)),
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 4)]
  rw [hpow4] at htail
  -- assemble
  have hfinal : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q) ≤
      ENNReal.ofReal (q * K * a⁻¹ * (4 : ℝ) ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [hLHS, hlayer]
    refine le_trans (mul_le_mul' le_rfl (le_trans hstep
      (mul_le_mul' le_rfl htail))) ?_
    refine le_of_eq ?_
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K * a⁻¹),
      ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K),
      ENNReal.ofReal_mul hq0.le]
    ring
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderTwo (absProfile f₀) r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (q * K * a⁻¹ * (4 : ℝ) ^ q) *
          X ^ ((d : ℕ) : ℝ)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hfinal (by positivity)
    _ = ENNReal.ofReal ((q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q)) * X ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul,
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) <
            q * K * a⁻¹ * (4 : ℝ) ^ q),
          show ((d : ℕ) : ℝ) * (1 / q) = 1 / p from by rw [hq]; field_simp]

/-! ## The kernel `|s - a|^c` on a window with an endpoint at `a` -/

theorem measurable_kernel_shift (a c : ℝ) :
    Measurable fun s : ℝ => ENNReal.ofReal (|s - a| ^ c) := by
  fun_prop

theorem lintegral_kernel_shift_left {a b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Icc a (a + b), ENNReal.ofReal (|s - a| ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  set f : ℝ → ENNReal := fun u =>
    (Icc (0 : ℝ) b).indicator (fun u => ENNReal.ofReal (|u| ^ c)) u with hf
  have hfmeas : Measurable f := by
    rw [hf]
    refine Measurable.indicator ?_ measurableSet_Icc
    fun_prop
  have hkey : (∫⁻ s in Icc a (a + b), ENNReal.ofReal (|s - a| ^ c)) =
      ∫⁻ s : ℝ, f (s - a) := by
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Icc a (a + b)
    · rw [Set.indicator_of_mem hs, hf]
      simp only
      rw [Set.indicator_of_mem (show s - a ∈ Icc (0 : ℝ) b from
        ⟨by linarith [hs.1], by linarith [hs.2]⟩)]
    · rw [Set.indicator_of_notMem hs, hf]
      simp only
      rw [Set.indicator_of_notMem (show s - a ∉ Icc (0 : ℝ) b from fun hcon =>
        hs ⟨by linarith [hcon.1], by linarith [hcon.2]⟩)]
  rw [hkey, lintegral_sub_right_eq_self f a, hf,
    lintegral_indicator measurableSet_Icc]
  rw [show (∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (|u| ^ c)) =
      ∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (u ^ c) from
    setLIntegral_congr_fun measurableSet_Icc (fun u hu => by
      rw [abs_of_nonneg hu.1])]
  exact lintegral_rpow_Icc_zero_eq hc hb

theorem lintegral_kernel_shift_right {a b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Icc (a - b) a, ENNReal.ofReal (|a - s| ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  set f : ℝ → ENNReal := fun u =>
    (Icc (0 : ℝ) b).indicator (fun u => ENNReal.ofReal (|u| ^ c)) u with hf
  have hfmeas : Measurable f := by
    rw [hf]
    refine Measurable.indicator ?_ measurableSet_Icc
    fun_prop
  have hkey : (∫⁻ s in Icc (a - b) a, ENNReal.ofReal (|a - s| ^ c)) =
      ∫⁻ s : ℝ, f (-(s - a)) := by
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Icc (a - b) a
    · rw [Set.indicator_of_mem hs, hf]
      simp only
      rw [Set.indicator_of_mem (show -(s - a) ∈ Icc (0 : ℝ) b from
        ⟨by linarith [hs.2], by linarith [hs.1]⟩)]
      congr 2
      rw [abs_neg, abs_sub_comm]
    · rw [Set.indicator_of_notMem hs, hf]
      simp only
      rw [Set.indicator_of_notMem (show -(s - a) ∉ Icc (0 : ℝ) b from fun hcon =>
        hs ⟨by linarith [hcon.2], by linarith [hcon.1]⟩)]
  have hneg : (∫⁻ s : ℝ, f (-(s - a))) = ∫⁻ u : ℝ, f u := by
    rw [show (fun s : ℝ => f (-(s - a))) = fun s : ℝ => (fun y => f (-y)) (s - a)
      from rfl, lintegral_sub_right_eq_self (fun y => f (-y)) a]
    exact lintegral_comp_neg f hfmeas
  rw [hkey, hneg, hf, lintegral_indicator measurableSet_Icc]
  rw [show (∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (|u| ^ c)) =
      ∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (u ^ c) from
    setLIntegral_congr_fun measurableSet_Icc (fun u hu => by
      rw [abs_of_nonneg hu.1])]
  exact lintegral_rpow_Icc_zero_eq hc hb

/-! ## `R₂^±` for `p > 2`

For `p > 2` the kernel `|s - (t-r)|^{-1/2}` is in `L^{p'}` of the window, with
norm `≍ r^{1/p' - 1/2}`.  Hölder then gives the pointwise bound
`R₂^± f(r) ≤ C_p r^{-1/p} ‖f‖_{L^p}`, uniformly in the dilation `t`, and
`∫_0^{4/3} r · r^{-1} dr < ∞` finishes.  No covering number of `E` appears:
for `p > 2` the operator is bounded on `L^p(r dr)` for **every** `E ⊆ [1,2]`. -/

/-- The Hölder constant of the half-power kernel. -/
def brsR2LargeConst (p : ℝ) : ℝ :=
  (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p)

theorem brsRemTwoTwoLeft_le_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
        (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  set pc : ℝ := Real.conjExponent p with hpc
  have hconj : p.HolderConjugate pc := Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / pc = 1 := by
    have h1 := hconj.one_div_add_one_div
    simpa using h1
  have hpinv : 1 / p < 1 / 2 := by
    rw [div_lt_div_iff₀ hp0 (by norm_num)]
    linarith
  have hpcinv : 1 / 2 < 1 / pc := by linarith
  have hpc0 : (0 : ℝ) < pc := by
    by_contra hcon
    push Not at hcon
    have : 1 / pc ≤ 0 := div_nonpos_of_nonneg_of_nonpos (by norm_num) hcon
    linarith
  have hpc2 : pc < 2 := by
    by_contra hcon
    push Not at hcon
    have : 1 / pc ≤ 1 / 2 := by
      rw [div_le_div_iff₀ hpc0 (by norm_num)]
      linarith
    linarith
  set kap : ℝ := 1 - pc / 2 with hkap
  have hkap0 : (0 : ℝ) < kap := by
    rw [hkap]
    linarith
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t - r ≤ t := by linarith
  have hlow : (1 : ℝ) / 3 ≤ t - r := by linarith
  have hKmeas : Measurable fun s : ℝ =>
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) :=
    measurable_kernel_shift (t - r) _
  -- the majorant of the integrand
  have hnorm : ∀ s : ℝ,
      ENNReal.ofReal ‖((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ =
        ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
      ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
  have hint := ofReal_norm_intervalIntegral_le_lintegral hab
    (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s)
    (fun s => ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ)
    (fun s _ => le_of_eq (hnorm s))
  -- Hölder on the window
  have hholder : (∫⁻ s in Icc (t - r) t,
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) ≤
      (∫⁻ s in Icc (t - r) t,
          ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
        (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ^ (1 / p) := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq
      (volume.restrict (Icc (t - r) t)) hconj.symm
      (f := fun s => ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)))
      (g := fun s => ‖g s‖ₑ) hKmeas.aemeasurable hg.enorm.aemeasurable
    simpa only [Pi.mul_apply] using h
  -- the kernel norm
  have hkernel : (∫⁻ s in Icc (t - r) t,
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) =
      ENNReal.ofReal (r ^ kap / kap) := by
    have hrw : ∀ s : ℝ,
        ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc =
          ENNReal.ofReal (|s - (t - r)| ^ (-(pc / 2))) := by
      intro s
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
          hpc0.le, ← Real.rpow_mul (abs_nonneg _)]
      congr 1
      ring
    rw [setLIntegral_congr_fun measurableSet_Icc (fun s _ => hrw s),
      show Icc (t - r) t = Icc (t - r) ((t - r) + r) from by congr 1; ring,
      lintegral_kernel_shift_left hr (by linarith : (-1 : ℝ) < -(pc / 2)),
      show -(pc / 2) + 1 = kap from by rw [hkap]; ring]
  -- the local `L^p` norm of `g`
  have hgpiece : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    have h1 : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ≤
        ∫⁻ s in Icc (t - r) t,
          ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
      refine setLIntegral_mono' measurableSet_Icc fun s hs => ?_
      have hs13 : (1 : ℝ) / 3 ≤ s := le_trans hlow hs.1
      calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
        _ ≤ ENNReal.ofReal (3 * s) * ‖g s‖ₑ ^ p := by
            refine mul_le_mul' ?_ le_rfl
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 from by simp]
            exact ENNReal.ofReal_le_ofReal (by linarith)
        _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3)]
            ring
    refine le_trans h1 (le_trans (setLIntegral_le_lintegral _ _) ?_)
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hM]
  -- the real exponent bookkeeping
  have hkexp : kap * (1 / pc) = 1 / pc - 1 / 2 := by
    rw [hkap]
    field_simp
  have hexp : r ^ (-(1 / 2) : ℝ) * (r ^ kap / kap) ^ (1 / pc) =
      brsR2LargeConst p * r ^ (-(1 / p)) := by
    have h1 : (r ^ kap / kap) ^ (1 / pc) =
        r ^ (kap * (1 / pc)) * (1 / kap) ^ (1 / pc) := by
      rw [div_eq_mul_one_div,
        Real.mul_rpow (Real.rpow_nonneg hr.le _) (by positivity),
        ← Real.rpow_mul hr.le]
    have h2 : brsR2LargeConst p = (1 / kap) ^ (1 / pc) := by
      rw [brsR2LargeConst, ← hpc, ← hkap]
    rw [h1, h2, ← mul_assoc, ← Real.rpow_add hr]
    rw [show -(1 / 2 : ℝ) + kap * (1 / pc) = -(1 / p) from by
      rw [hkexp]; linarith]
    ring
  -- assemble
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in (t - r)..t, ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in (t - r)..t,
            ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ((∫⁻ s in Icc (t - r) t,
              ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
            (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl (le_trans hint hholder)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (r ^ kap / kap) ^ (1 / pc) *
            (ENNReal.ofReal 3 * M) ^ (1 / p)) := by
        rw [hkernel]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (ENNReal.rpow_le_rpow hgpiece (by positivity)))
    _ = ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p) := by
        rw [ENNReal.ofReal_rpow_of_nonneg
            (by positivity : (0 : ℝ) ≤ r ^ kap / kap) (by positivity),
          ← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _), hexp]

/-! ## `R₂^±` on `L^p(r dr)` for `p > 2`, with no covering numbers -/

theorem conjExponent_pos_of_two_lt {p : ℝ} (hp : 2 < p) :
    0 < Real.conjExponent p ∧ Real.conjExponent p < 2 := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  have hconj : p.HolderConjugate (Real.conjExponent p) :=
    Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / Real.conjExponent p = 1 := by
    simpa using hconj.one_div_add_one_div
  have hpinv : 1 / p < 1 / 2 := by
    rw [div_lt_div_iff₀ hp0 (by norm_num)]
    linarith
  have hpcinv : 1 / 2 < 1 / Real.conjExponent p := by linarith
  have hpc0 : (0 : ℝ) < Real.conjExponent p := by
    by_contra hcon
    push Not at hcon
    have : 1 / Real.conjExponent p ≤ 0 :=
      div_nonpos_of_nonneg_of_nonpos (by norm_num) hcon
    linarith
  refine ⟨hpc0, ?_⟩
  by_contra hcon
  push Not at hcon
  have : 1 / Real.conjExponent p ≤ 1 / 2 := by
    rw [div_le_div_iff₀ hpc0 (by norm_num)]
    linarith
  linarith

theorem brsR2LargeConst_pos {p : ℝ} (hp : 2 < p) : 0 < brsR2LargeConst p := by
  obtain ⟨hpc0, hpc2⟩ := conjExponent_pos_of_two_lt hp
  rw [brsR2LargeConst]
  refine Real.rpow_pos_of_pos ?_ _
  have : (0 : ℝ) < 1 - Real.conjExponent p / 2 := by linarith
  positivity

theorem brsRemTwoTwoRight_le_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
        (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  set pc : ℝ := Real.conjExponent p with hpc
  have hconj : p.HolderConjugate pc := Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / pc = 1 := by simpa using hconj.one_div_add_one_div
  obtain ⟨hpc0, hpc2⟩ := conjExponent_pos_of_two_lt hp
  rw [← hpc] at hpc0 hpc2
  set kap : ℝ := 1 - pc / 2 with hkap
  have hkap0 : (0 : ℝ) < kap := by
    rw [hkap]
    linarith
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  have hKmeas : Measurable fun s : ℝ =>
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) := by
    fun_prop
  have hnorm : ∀ s : ℝ,
      ENNReal.ofReal ‖((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ =
        ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
      ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
  have hint := ofReal_norm_intervalIntegral_le_lintegral hab
    (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s)
    (fun s => ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ)
    (fun s _ => le_of_eq (hnorm s))
  have hholder : (∫⁻ s in Icc t (t + r),
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) ≤
      (∫⁻ s in Icc t (t + r),
          ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
        (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ^ (1 / p) := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq
      (volume.restrict (Icc t (t + r))) hconj.symm
      (f := fun s => ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)))
      (g := fun s => ‖g s‖ₑ) hKmeas.aemeasurable hg.enorm.aemeasurable
    simpa only [Pi.mul_apply] using h
  have hkernel : (∫⁻ s in Icc t (t + r),
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) =
      ENNReal.ofReal (r ^ kap / kap) := by
    have hrw : ∀ s : ℝ,
        ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc =
          ENNReal.ofReal (|t + r - s| ^ (-(pc / 2))) := by
      intro s
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
          hpc0.le, ← Real.rpow_mul (abs_nonneg _)]
      congr 1
      ring
    rw [setLIntegral_congr_fun measurableSet_Icc (fun s _ => hrw s),
      show Icc t (t + r) = Icc ((t + r) - r) (t + r) from by congr 1; ring,
      lintegral_kernel_shift_right hr (by linarith : (-1 : ℝ) < -(pc / 2)),
      show -(pc / 2) + 1 = kap from by rw [hkap]; ring]
  have hgpiece : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ≤
      ENNReal.ofReal 3 * M := by
    have h1 : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ≤
        ∫⁻ s in Icc t (t + r),
          ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
      refine setLIntegral_mono' measurableSet_Icc fun s hs => ?_
      have hs13 : (1 : ℝ) / 3 ≤ s := by
        have := hs.1
        linarith
      calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
        _ ≤ ENNReal.ofReal (3 * s) * ‖g s‖ₑ ^ p := by
            refine mul_le_mul' ?_ le_rfl
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 from by simp]
            exact ENNReal.ofReal_le_ofReal (by linarith)
        _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3)]
            ring
    refine le_trans h1 (le_trans (setLIntegral_le_lintegral _ _) ?_)
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hM]
  have hkexp : kap * (1 / pc) = 1 / pc - 1 / 2 := by
    rw [hkap]
    field_simp
  have hexp : r ^ (-(1 / 2) : ℝ) * (r ^ kap / kap) ^ (1 / pc) =
      brsR2LargeConst p * r ^ (-(1 / p)) := by
    have h1 : (r ^ kap / kap) ^ (1 / pc) =
        r ^ (kap * (1 / pc)) * (1 / kap) ^ (1 / pc) := by
      rw [div_eq_mul_one_div,
        Real.mul_rpow (Real.rpow_nonneg hr.le _) (by positivity),
        ← Real.rpow_mul hr.le]
    have h2 : brsR2LargeConst p = (1 / kap) ^ (1 / pc) := by
      rw [brsR2LargeConst, ← hpc, ← hkap]
    rw [h1, h2, ← mul_assoc, ← Real.rpow_add hr]
    rw [show -(1 / 2 : ℝ) + kap * (1 / pc) = -(1 / p) from by
      rw [hkexp]; linarith]
    ring
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in t..(t + r), ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..(t + r),
            ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ((∫⁻ s in Icc t (t + r),
              ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
            (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl (le_trans hint hholder)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (r ^ kap / kap) ^ (1 / pc) *
            (ENNReal.ofReal 3 * M) ^ (1 / p)) := by
        rw [hkernel]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (ENNReal.rpow_le_rpow hgpiece (by positivity)))
    _ = ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p) := by
        rw [ENNReal.ofReal_rpow_of_nonneg
            (by positivity : (0 : ℝ) ≤ r ^ kap / kap) (by positivity),
          ← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _), hexp]

/-! ## `R₂^±` is bounded on `L^p(r dr)` for every `p > 2`

BRS state Lemma 5.3 for all `1 ≤ p < ∞` and refer to [21, Prop. 5.3] for the
proof.  For `p ≤ 2` the covering-number form is proved above; for `p > 2` the
half-power kernel is in `L^{p'}` of the window and Hölder gives boundedness
with **no** covering number at all, which is stronger. -/

theorem lemma53_brsRemTwoTwoLeft_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 / p) * brsR2LargeConst p) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hC : 0 < brsR2LargeConst p := brsR2LargeConst_pos hp
  set C : ℝ := brsR2LargeConst p with hCdef
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p ≤
      (Ioc (0 : ℝ) (4 / 3)).indicator
        (fun _ => ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M)) r := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      exact zero_le
    have hrne : r ≠ 0 := ne_of_gt hr
    rcases le_or_gt r (4 / 3) with hrle | hrgt
    · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hrle⟩)]
      have hb := brsRemTwoTwoLeft_le_of_two_lt hE hp hg hr
      have hval : ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p =
          ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
          show (1 : ℝ) / p * p = 1 from by field_simp, ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_pos
            (by positivity : (0 : ℝ) < C * r ^ (-(1 / p))),
          ← mul_assoc, ← ENNReal.ofReal_mul hr.le]
        congr 2
        rw [Real.mul_rpow hC.le (Real.rpow_nonneg hr.le _),
          ← Real.rpow_mul hr.le,
          show -(1 / p) * p = -1 from by field_simp, Real.rpow_neg_one]
        field_simp
      calc ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p
          ≤ ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
              (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hb hp0.le)
        _ = ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := hval
    · rw [brsRemTwoTwoLeft_eq_zero hE hrgt, ENNReal.zero_rpow_of_pos hp0,
        mul_zero]
      exact zero_le
  have hint : (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ≤
      ENNReal.ofReal (4 * C ^ p) * M := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioc, setLIntegral_const,
      Real.volume_Ioc, show (4 : ℝ) / 3 - 0 = 4 / 3 from by ring,
      show ENNReal.ofReal (4 * C ^ p) =
          ENNReal.ofReal (C ^ p) * ENNReal.ofReal 3 * ENNReal.ofReal (4 / 3) from by
        rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p),
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p * 3)]
        congr 1
        ring]
    exact le_of_eq (by ring)
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p)
      ≤ (ENNReal.ofReal (4 * C ^ p) * M) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal ((4 : ℝ) ^ (1 / p) * C) * M ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < 4 * C ^ p)]
        congr 2
        rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 4) (by positivity),
          ← Real.rpow_mul hC.le,
          show p * (1 / p) = 1 from by field_simp, Real.rpow_one]

theorem lemma53_brsRemTwoTwoRight_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p) ≤
