theorem prop54_brsRemTwoTwoRight_assouad_unif {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ} {p q : ℝ}
