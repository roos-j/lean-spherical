    congr 1
    field_simp
  have hfactor1 : eLpNorm (fun x => ‖g x‖ ^ (1 - lam))
      (ENNReal.ofReal (q1 / (1 - lam))) μ =
      (eLpNorm g (ENNReal.ofReal q1) μ) ^ (1 - lam) := by
