private theorem exists_coordinateWaveRadiusDerivativeAmplitude_middle_scaled_power
    {d : Nat} (L : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u‖ ≤
        C / s ^ L := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_decay d 1 (L + 1)
  refine ⟨(80 * Real.pi) * C, mul_pos (by positivity) hC, ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsrhalf : (1 / 2 : Real) ≤ s * r := by
    calc
      (1 / 2 : Real) = 1 * (1 / 2 : Real) := by ring
      _ ≤ s * r := mul_le_mul hs hr.1 (by positivity) (by positivity)
  have hsrpos : 0 < s * r := lt_of_lt_of_le (by norm_num) hsrhalf
  have hsrne : s * r ≠ 0 := hsrpos.ne'
  have huover : ‖((u / (s * r) : Real) : Complex)‖ ≤ 16 := by
    rw [Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (div_nonneg (by linarith [hu.1]) hsrpos.le)]
    apply (div_le_iff₀ hsrpos).2
    nlinarith [hu.2, hsrhalf]
  have hformula :
      coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u =
        ((u / (s * r) : Real) : Complex) *
          iteratedDeriv 1
            (fun z : Real => coordinateWaveRadialAmplitude d .middle (s * r) z) u := by
    unfold coordinateWaveRadiusDerivativeAmplitude
    rw [deriv_coordinateWaveRadialAmplitude_radius_eq_div_mul_iteratedDeriv
      d .middle hsrne u]
    simp [coordinateWavePhaseSlope]
  have hmiddle :
      ‖iteratedDeriv 1
        (fun z : Real => coordinateWaveRadialAmplitude d .middle (s * r) z) u‖ ≤
        C * |2 * Real.pi * (s * r)| /
          |(2 * Real.pi * (s * r)) * u| ^ (L + 1) := by
    simpa using hbound (s * r) u hfreq
  have hden : s ^ (L + 1) ≤ |(2 * Real.pi * (s * r)) * u| ^ (L + 1) :=
    pow_le_pow_left₀ (zero_le_one.trans hs) hscale _
  have hnum : C * |2 * Real.pi * (s * r)| ≤ C * ((5 * Real.pi) * s) :=
    mul_le_mul_of_nonneg_left hamp hC.le
  have hquot :
      C * |2 * Real.pi * (s * r)| /
          |(2 * Real.pi * (s * r)) * u| ^ (L + 1) ≤
        C * ((5 * Real.pi) * s) / s ^ (L + 1) := by
    calc
      C * |2 * Real.pi * (s * r)| /
          |(2 * Real.pi * (s * r)) * u| ^ (L + 1) ≤
          C * |2 * Real.pi * (s * r)| / s ^ (L + 1) :=
        div_le_div_of_nonneg_left
          (mul_nonneg hC.le (abs_nonneg _)) (pow_pos hspos _) hden
      _ ≤ C * ((5 * Real.pi) * s) / s ^ (L + 1) :=
        div_le_div_of_nonneg_right hnum (pow_pos hspos _).le
  rw [hformula, norm_mul]
  calc
    ‖((u / (s * r) : Real) : Complex)‖ *
        ‖iteratedDeriv 1
          (fun z : Real => coordinateWaveRadialAmplitude d .middle (s * r) z) u‖ ≤
        16 * (C * |2 * Real.pi * (s * r)| /
          |(2 * Real.pi * (s * r)) * u| ^ (L + 1)) := by
      exact mul_le_mul huover hmiddle (norm_nonneg _) (by positivity)
    _ ≤ 16 * (C * ((5 * Real.pi) * s) / s ^ (L + 1)) :=
      mul_le_mul_of_nonneg_left hquot (by norm_num)
    _ = ((80 * Real.pi) * C) / s ^ L := by
      rw [show L + 1 = Nat.succ L by omega, pow_succ]
      field_simp [hspos.ne']
      ring

private theorem exists_coordinateWaveRadiusDerivativeMultiplierPairAmplitude_oneMiddle_scaled
    {d : Nat} (hd : 2 ≤ d) (L : Nat) (q t : CoordinateWavePart)
    (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadiusDerivativeMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
        C / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
  rcases hmiddle with hq | ht
  · subst q
    obtain ⟨A, hA, hAbound⟩ :=
      exists_coordinateWaveRadiusDerivativeAmplitude_middle_scaled_power (d := d) L
    obtain ⟨B, hB, hBbound⟩ :=
      exists_uniform_coordinateWaveRadiusDerivativeAmplitude_scaled (d := d) (N := 0) hd t
    let M : Real := ‖(surfaceMass d : Complex)⁻¹‖
    have hM : 0 ≤ M := by
      dsimp [M]
      exact norm_nonneg _
    refine ⟨M ^ 2 * A * B + 1, by positivity, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hAbound s r u hs hr hu
    have htbound := hBbound 0 le_rfl s r' u hs hr' hu
    simp only [iteratedDeriv_zero] at htbound
    have hQpos : 0 < (Real.sqrt s) ^ (d - 1) :=
      pow_pos (Real.sqrt_pos.2 hspos) _
    unfold coordinateWaveRadiusDerivativeMultiplierPairAmplitude
    simp only [norm_mul, starRingEnd_apply, norm_star]
    change M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u‖ *
        (M * ‖coordinateWaveRadiusDerivativeAmplitude d t (s * r') u‖) ≤ _
    calc
      M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u‖ *
          (M * ‖coordinateWaveRadiusDerivativeAmplitude d t (s * r') u‖) ≤
          M * (A / s ^ L) *
            (M * (B / (Real.sqrt s) ^ (d - 1))) := by
        gcongr
      _ = (M ^ 2 * A * B) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hspos.ne', hQpos.ne']
      _ ≤ (M ^ 2 * A * B + 1) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        apply div_le_div_of_nonneg_right
        · linarith
        · positivity
  · subst t
    obtain ⟨A, hA, hAbound⟩ :=
      exists_coordinateWaveRadiusDerivativeAmplitude_middle_scaled_power (d := d) L
    obtain ⟨B, hB, hBbound⟩ :=
      exists_uniform_coordinateWaveRadiusDerivativeAmplitude_scaled (d := d) (N := 0) hd q
    let M : Real := ‖(surfaceMass d : Complex)⁻¹‖
    have hM : 0 ≤ M := by
      dsimp [M]
      exact norm_nonneg _
    refine ⟨M ^ 2 * B * A + 1, by positivity, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hBbound 0 le_rfl s r u hs hr hu
    simp only [iteratedDeriv_zero] at hqbound
    have htbound := hAbound s r' u hs hr' hu
    have hQpos : 0 < (Real.sqrt s) ^ (d - 1) :=
      pow_pos (Real.sqrt_pos.2 hspos) _
    unfold coordinateWaveRadiusDerivativeMultiplierPairAmplitude
    simp only [norm_mul, starRingEnd_apply, norm_star]
    change M * ‖coordinateWaveRadiusDerivativeAmplitude d q (s * r) u‖ *
        (M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r') u‖) ≤ _
    calc
      M * ‖coordinateWaveRadiusDerivativeAmplitude d q (s * r) u‖ *
          (M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r') u‖) ≤
          M * (B / (Real.sqrt s) ^ (d - 1)) * (M * (A / s ^ L)) := by
        gcongr
      _ = (M ^ 2 * B * A) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hspos.ne', hQpos.ne']
      _ ≤ (M ^ 2 * B * A + 1) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        apply div_le_div_of_nonneg_right
        · linarith
        · positivity

private theorem exists_oneMiddle_coordinateRadiusDerivativeTripleWaveIntegral_bound
    {d : Nat} (hd : 3 ≤ d) (L : Nat)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean d, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        coordinateRadiusDerivativeTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_coordinateTripleWaveFixedAmplitude_bound (d := d) (N := 0)
      (by omega) phi hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_coordinateWaveRadiusDerivativeMultiplierPairAmplitude_oneMiddle_scaled
      (d := d) (by omega) L q t hmiddle
  refine ⟨3 * A * B, mul_pos (mul_pos (by norm_num) hA) hB, ?_⟩
  intro s r r' hs hr hr' v x hv
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hdenpos : 0 < s ^ L * (Real.sqrt s) ^ (d - 1) := by positivity
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖coordinateRadiusDerivativeTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by
      constructor <;> linarith [hu.1, hu.2]
    have hfixed := hAbound v x hv 0 le_rfl u huwide
    have hpair := hBbound s r r' u hs hr hr' huwide
    have hfactor := coordinateRadiusDerivativeTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one, norm_mul]
    calc
      ‖coordinateTripleWaveFixedAmplitude phi v x p u‖ *
          ‖coordinateWaveRadiusDerivativeMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
          A * (B / (s ^ L * (Real.sqrt s) ^ (d - 1))) := by
        exact mul_le_mul hfixed hpair (norm_nonneg _) hA.le
      _ = (A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hdenpos.ne']
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateRadiusDerivativeTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1))) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
      norm_num
      ring

private theorem exists_coordinateRadiusDerivativeTripleWaveIntegral_crude_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
