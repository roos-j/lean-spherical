      _ = B0 ^ q0 *
          (eLpNorm (eval g) (ENNReal.ofReal p0) mu) ^ q0 := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
  have hweak1 : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
      ENNReal.ofReal (s ^ q1) * nu {x | s < T g x} ≤
        B1 ^ q1 *
          (eLpNorm (eval g) (ENNReal.ofReal p1) mu) ^ q1 := by
    intro g hg s hs
    have hcheb := weak_distribution_of_eLpNorm (T g) (hTmeas g hg)
      hq1 hs (B1 * eLpNorm (eval g) (ENNReal.ofReal p1) mu)
