/-- Real-valued version of `rawDyadicSurfaceMaximal`, used by the usual
strong-type and subadditivity interfaces. -/
def rawDyadicSurfaceMaximalReal
    (d : Nat) (E : Set Real) (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : Euclidean d -> Complex) (x : Euclidean d) : Real :=
  (rawDyadicSurfaceMaximal d E psi hpsiCompact f x).toReal

/-- The integrand defining the raw one-radius convolution is strongly
measurable for every strongly measurable input.  This is the key fact which
makes the operator available on hard cutoffs. -/
theorem aestronglyMeasurable_rawDyadicSurfaceKernelApply_integrand
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (r : Real) (f : Euclidean d -> Complex)
    (hf : AEStronglyMeasurable f volume) (x : Euclidean d) :
    AEStronglyMeasurable
      (fun y => rawDyadicSurfaceKernel psi hpsiCompact r (x - y) * f y)
      volume := by
  let k : SchwartzMap (Euclidean d) Complex :=
    𝓕⁻ (q4DyadicSurfaceSchwartzMultiplier psi hpsiCompact r)
  change AEStronglyMeasurable
    (fun y => (k : Euclidean d -> Complex) (x - y) * f y) volume
  exact ((k.continuous.comp
    (continuous_const.sub continuous_id)).aestronglyMeasurable).mul hf

/-- A pointwise bound on the literal one-radius kernel gives the raw
`L¹ → L∞` estimate. -/
theorem norm_rawDyadicSurfaceKernelApply_le_of_bound
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (r : Real) (f : Euclidean d -> Complex) (x : Euclidean d)
    {A : Real} (hf : Integrable f volume)
    (hfmeas : AEStronglyMeasurable f volume)
    (hkernel : ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A) :
    ‖rawDyadicSurfaceKernelApply psi hpsiCompact r f x‖ ≤
      A * ∫ y, ‖f y‖ := by
  simpa only [rawDyadicSurfaceKernelApply, q4PairwiseKernelApply] using
    (norm_q4PairwiseKernelApply_le_of_bound
      (i := ()) (j := ()) (f := f) (x := x) volume
      (fun (_ _ : Unit) => rawDyadicSurfaceKernel psi hpsiCompact r)
      hf
      (by
        simpa only using
          aestronglyMeasurable_rawDyadicSurfaceKernelApply_integrand
            psi hpsiCompact r f hfmeas x)
      (by
        intro z
        simpa only using hkernel z))

/-- A uniform bound for the literal one-radius kernels yields the raw
normalized maximal `L¹ → L∞` endpoint.  The input is an arbitrary
integrable, strongly measurable function; in particular it may be a hard
amplitude cutoff. -/
theorem rawDyadicSurfaceMaximal_le_of_uniform_kernel_bound
    {d : Nat} (E : Set Real) (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : Euclidean d -> Complex) {A : Real}
    (hf : Integrable f volume) (hfmeas : AEStronglyMeasurable f volume)
    (hkernel : ∀ r ∈ E, ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A)
    (x : Euclidean d) :
    rawDyadicSurfaceMaximal d E psi hpsiCompact f x ≤
      ENNReal.ofReal
        (‖((surfaceMass d)⁻¹ : Complex)‖ * A * ∫ y, ‖f y‖) := by
  unfold rawDyadicSurfaceMaximal
  refine iSup_le fun r => ?_
  have hraw := norm_rawDyadicSurfaceKernelApply_le_of_bound
    psi hpsiCompact r.1 f x hf hfmeas (hkernel r.1 r.2)
  have hscaled :
      ‖((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x‖ ≤
        ‖((surfaceMass d)⁻¹ : Complex)‖ *
          (A * ∫ y, ‖f y‖) := by
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left hraw (norm_nonneg _)
  calc
    ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
        rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x‖ ≤
        ENNReal.ofReal (‖((surfaceMass d)⁻¹ : Complex)‖ *
          (A * ∫ y, ‖f y‖)) := ENNReal.ofReal_le_ofReal hscaled
    _ = ENNReal.ofReal
        (‖((surfaceMass d)⁻¹ : Complex)‖ * A * ∫ y, ‖f y‖) := by ring

/-- Real-valued form of the preceding literal endpoint. -/
theorem rawDyadicSurfaceMaximalReal_le_of_uniform_kernel_bound
    {d : Nat} (E : Set Real) (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : Euclidean d -> Complex) {A : Real} (hA : 0 ≤ A)
    (hf : Integrable f volume) (hfmeas : AEStronglyMeasurable f volume)
    (hkernel : ∀ r ∈ E, ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A)
    (x : Euclidean d) :
    rawDyadicSurfaceMaximalReal d E psi hpsiCompact f x ≤
      ‖((surfaceMass d)⁻¹ : Complex)‖ * A * ∫ y, ‖f y‖ := by
  let R : Real := ‖((surfaceMass d)⁻¹ : Complex)‖ * A * ∫ y, ‖f y‖
  have hR : 0 ≤ R := by
    dsimp only [R]
    exact mul_nonneg (mul_nonneg (norm_nonneg _) hA)
      (integral_nonneg fun y => norm_nonneg _)
  have hraw : rawDyadicSurfaceMaximal d E psi hpsiCompact f x ≤
      ENNReal.ofReal R := by
    simpa only [R] using
      (rawDyadicSurfaceMaximal_le_of_uniform_kernel_bound
        E psi hpsiCompact f hf hfmeas hkernel x)
  have hfinite : rawDyadicSurfaceMaximal d E psi hpsiCompact f x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hraw
  unfold rawDyadicSurfaceMaximalReal
  have hreal :=
    (ENNReal.toReal_le_toReal hfinite ENNReal.ofReal_ne_top).mpr hraw
  simpa only [ENNReal.toReal_ofReal hR] using hreal

/-- Under a pointwise kernel bound, the displayed raw convolution integrand
is integrable on every integrable input. -/
theorem integrable_rawDyadicSurfaceKernelApply_integrand_of_bound
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (r : Real) (f : Euclidean d -> Complex) (x : Euclidean d)
    {A : Real} (hf : Integrable f volume)
    (hfmeas : AEStronglyMeasurable f volume)
    (hkernel : ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A) :
    Integrable
      (fun y => rawDyadicSurfaceKernel psi hpsiCompact r (x - y) * f y)
      volume := by
  have hmajor : Integrable (fun y => A * ‖f y‖) volume :=
    hf.norm.const_mul A
  refine hmajor.mono'
    (aestronglyMeasurable_rawDyadicSurfaceKernelApply_integrand
      psi hpsiCompact r f hfmeas x)
    (Filter.Eventually.of_forall fun y => ?_)
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_right (hkernel (x - y)) (norm_nonneg _)

/-- The raw maximal operator is subadditive on the literal integrable
carrier.  This is the closure fact needed if one chooses to use hard
amplitude cutoffs instead of the rational Schwartz split. -/
theorem rawDyadicSurfaceMaximal_add_le_of_uniform_kernel_bound
    {d : Nat} (E : Set Real) (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f g : Euclidean d -> Complex) {A : Real}
    (hf : Integrable f volume) (hg : Integrable g volume)
    (hfmeas : AEStronglyMeasurable f volume)
    (hgmeas : AEStronglyMeasurable g volume)
    (hkernel : ∀ r ∈ E, ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A)
    (x : Euclidean d) :
    rawDyadicSurfaceMaximal d E psi hpsiCompact (f + g) x ≤
      rawDyadicSurfaceMaximal d E psi hpsiCompact f x +
        rawDyadicSurfaceMaximal d E psi hpsiCompact g x := by
  unfold rawDyadicSurfaceMaximal
  refine iSup_le fun r => ?_
  have hfi := integrable_rawDyadicSurfaceKernelApply_integrand_of_bound
    psi hpsiCompact r.1 f x hf hfmeas (hkernel r.1 r.2)
  have hgi := integrable_rawDyadicSurfaceKernelApply_integrand_of_bound
    psi hpsiCompact r.1 g x hg hgmeas (hkernel r.1 r.2)
  have happly :
      rawDyadicSurfaceKernelApply psi hpsiCompact r.1 (f + g) x =
        rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x +
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 g x := by
    unfold rawDyadicSurfaceKernelApply
    have hintegrand :
        (fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) *
          (f + g) y) =
          (fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * f y) +
            (fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * g y) := by
      funext y
      simp only [Pi.add_apply, mul_add]
    rw [hintegrand]
    rw [show ((fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * f y) +
        (fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * g y)) =
        (fun y => rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * f y +
          rawDyadicSurfaceKernel psi hpsiCompact r.1 (x - y) * g y) from rfl]
    rw [integral_add hfi hgi]
  have hscaled :
      ((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 (f + g) x =
        ((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x +
        ((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 g x := by
    rw [happly]
    ring
  rw [hscaled]
  calc
    ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
        rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x +
        ((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 g x‖ ≤
        ENNReal.ofReal
          (‖((surfaceMass d)⁻¹ : Complex) *
            rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x‖ +
          ‖((surfaceMass d)⁻¹ : Complex) *
            rawDyadicSurfaceKernelApply psi hpsiCompact r.1 g x‖) :=
      ENNReal.ofReal_le_ofReal (norm_add_le _ _)
    _ = ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 f x‖ +
        ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact r.1 g x‖ := by
      rw [ENNReal.ofReal_add (norm_nonneg _) (norm_nonneg _)]
    _ ≤ (⨆ s : E, ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact s.1 f x‖) +
        ⨆ s : E, ENNReal.ofReal ‖((surfaceMass d)⁻¹ : Complex) *
          rawDyadicSurfaceKernelApply psi hpsiCompact s.1 g x‖ := by
      gcongr
      · exact le_iSup (fun s : E => ENNReal.ofReal
          ‖((surfaceMass d)⁻¹ : Complex) *
            rawDyadicSurfaceKernelApply psi hpsiCompact s.1 f x‖) r
      · exact le_iSup (fun s : E => ENNReal.ofReal
          ‖((surfaceMass d)⁻¹ : Complex) *
            rawDyadicSurfaceKernelApply psi hpsiCompact s.1 g x‖) r

/-- The raw convolution is exactly the literal one-radius Fourier piece on
Schwartz input. -/
theorem q4DyadicSurfacePiece_eq_rawDyadicSurfaceKernelApply
    {d : Nat} (psi f : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (r : Real) (x : Euclidean d) :
    q4DyadicSurfacePiece psi f r x =
      rawDyadicSurfaceKernelApply psi hpsiCompact r
        (f : Euclidean d -> Complex) x := by
  let m : SchwartzMap (Euclidean d) Complex :=
    q4DyadicSurfaceSchwartzMultiplier psi hpsiCompact r
  have hm : ∀ xi : Euclidean d, m xi = q4DyadicSurfaceMultiplier psi r xi := by
    intro xi
    exact q4DyadicSurfaceSchwartzMultiplier_spec psi hpsiCompact r xi
  have hconv :
      q4DyadicSurfacePiece psi f r x =
        (((𝓕⁻ m : SchwartzMap (Euclidean d) Complex) :
          Euclidean d -> Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (f : Euclidean d -> Complex)) x := by
    unfold q4DyadicSurfacePiece
    have hrewrite :
        (fun xi : Euclidean d => q4DyadicSurfaceMultiplier psi r xi *
          𝓕 (f : Euclidean d -> Complex) xi) =
          fun xi : Euclidean d => m xi *
            𝓕 (f : Euclidean d -> Complex) xi := by
      funext xi
      rw [hm xi]
    rw [hrewrite, fourierInv_schwartz_multiplier_eq_convolution]
  have hpair := q4PairwiseKernelApply_eq_convolution
    (fun (_ _ : Unit) => ((𝓕⁻ m : SchwartzMap (Euclidean d) Complex) :
      Euclidean d -> Complex)) () () (f : Euclidean d -> Complex) x
  calc
    q4DyadicSurfacePiece psi f r x =
        (((𝓕⁻ m : SchwartzMap (Euclidean d) Complex) :
          Euclidean d -> Complex)
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
            (f : Euclidean d -> Complex)) x := hconv
    _ = q4PairwiseKernelApply volume
        (fun (_ _ : Unit) => ((𝓕⁻ m : SchwartzMap (Euclidean d) Complex) :
          Euclidean d -> Complex)) () () (f : Euclidean d -> Complex) x :=
      hpair.symm
    _ = rawDyadicSurfaceKernelApply psi hpsiCompact r
        (f : Euclidean d -> Complex) x := by
      simp only [rawDyadicSurfaceKernelApply, rawDyadicSurfaceKernel, m,
        q4PairwiseKernelApply]

/-- On Schwartz data, the raw normalized maximal operator is literally the
existing dyadic bandpass maximal operator. -/
theorem fractalDyadicBandpassMaximal_eq_rawDyadicSurfaceMaximalReal
    {d : Nat} (E : Set Real) (psi f : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (x : Euclidean d) :
    fractalDyadicBandpassMaximal d E psi f x =
      rawDyadicSurfaceMaximalReal d E psi hpsiCompact
        (f : Euclidean d -> Complex) x := by
  unfold fractalDyadicBandpassMaximal fractalSphericalMaximalReal
    fractalSphericalMaximal rawDyadicSurfaceMaximalReal rawDyadicSurfaceMaximal
  apply congrArg ENNReal.toReal
  apply iSup_congr
  intro r
  congr 2
  rw [normalizedSphericalAverage,
    sphericalAverage_dyadicBandpassProjection_eq_q4DyadicSurfacePiece,
    q4DyadicSurfacePiece_eq_rawDyadicSurfaceKernelApply psi f hpsiCompact]

/-- Schwartz-facing form of the literal raw endpoint.  It accepts any
proved uniform bound for the actual one-radius physical kernel, so later
arguments never need to introduce an abstract strong-type premise. -/
theorem fractalDyadicBandpassMaximal_le_of_uniform_kernel_bound
    {d : Nat} (E : Set Real) (psi f : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {A : Real} (hA : 0 ≤ A)
    (hkernel : ∀ r ∈ E, ∀ z : Euclidean d,
      ‖rawDyadicSurfaceKernel psi hpsiCompact r z‖ ≤ A)
    (x : Euclidean d) :
    fractalDyadicBandpassMaximal d E psi f x ≤
      ‖((surfaceMass d)⁻¹ : Complex)‖ * A *
        ∫ y, ‖(f : Euclidean d -> Complex) y‖ := by
  rw [fractalDyadicBandpassMaximal_eq_rawDyadicSurfaceMaximalReal
    E psi f hpsiCompact x]
  exact rawDyadicSurfaceMaximalReal_le_of_uniform_kernel_bound
    E psi hpsiCompact (f : Euclidean d -> Complex) hA f.integrable
    f.continuous.aestronglyMeasurable hkernel x

/-- The compact one-radius kernel for the canonical absolute dyadic
bandpass satisfies the crude physical endpoint used on the Minkowski side
of the paper.  This is a one-radius estimate, not a `TT*` pair estimate. -/
theorem norm_rawDyadicSurfaceKernel_absoluteDyadicBandpass_le_volume_of_sharp_on_half
    {n : Nat} (C : Real) (hC : 0 < C)
    (hdecay : ∀ z : Euclidean (n + 1), 1 ≤ ‖z‖ →
      ‖surfaceFourier (n + 1) z‖ ≤ C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ z, ‖z‖ ≤ 1 → phi z = 1)
    (hphiZero : ∀ z, 2 ≤ ‖z‖ → phi z = 0)
    (hphiNorm : ∀ z, ‖phi z‖ ≤ 1)
    (j : Nat) (hj : 1 ≤ j) (r : Real)
    (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (x : Euclidean (n + 1)) :
    ‖rawDyadicSurfaceKernel (absoluteDyadicBandpass phi hphiOne hphiZero j)
        (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) r x‖ ≤
      q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j *
        (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal := by
  let m : SchwartzMap (Euclidean (n + 1)) Complex :=
    q4DyadicSurfaceSchwartzMultiplier
      (absoluteDyadicBandpass phi hphiOne hphiZero j)
      (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) r
  let B : Real := q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j
  have hB : 0 ≤ B := by
    dsimp only [B, q4EnlargedSurfaceMultiplierBound]
    refine mul_nonneg (by norm_num)
      (div_nonneg hC.le (Real.rpow_nonneg ?_ _))
    have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
      _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
    linarith
  have hpoint : ∀ xi : Euclidean (n + 1), ‖m xi‖ ≤ B := by
    intro xi
    rw [show m xi = q4DyadicSurfaceMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) r xi by
      exact q4DyadicSurfaceSchwartzMultiplier_spec
        (absoluteDyadicBandpass phi hphiOne hphiZero j)
        (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) r xi]
    unfold q4DyadicSurfaceMultiplier
    exact norm_surfaceFourier_neg_smul_mul_absoluteDyadicBandpass_le_of_sharp_on_half
      C hC hdecay phi hphiOne hphiZero hphiNorm j hj r hr xi
  have hzero : ∀ xi : Euclidean (n + 1),
      (2 : Real) ^ (j + 2) ≤ ‖xi‖ → m xi = 0 := by
    intro xi hxi
    rw [show m xi = q4DyadicSurfaceMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) r xi by
      exact q4DyadicSurfaceSchwartzMultiplier_spec
        (absoluteDyadicBandpass phi hphiOne hphiZero j)
        (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) r xi]
    have hpsiZero : absoluteDyadicBandpass phi hphiOne hphiZero j xi = 0 := by
      rw [absoluteDyadicBandpass_spec]
      exact smooth_dyadic_bandpass_eq_zero_of_le_norm hphiZero hxi
    unfold q4DyadicSurfaceMultiplier
    rw [hpsiZero]
    simp
  simpa only [rawDyadicSurfaceKernel, m, B, SchwartzMap.fourierInv_coe] using
    (norm_fourierInv_schwartz_le_of_norm_le_of_eq_zero_outside_ball m hB
      (pow_pos (by norm_num) _) hpoint hzero x)

/-- Explicit fixed-frequency `L¹ → L∞` endpoint for the literal raw
dyadic maximal operator.  Radii in `E ⊆ [1,2]` are a fortiori in the
enlarged interval required by the one-radius Fourier estimate. -/
theorem rawDyadicSurfaceMaximalReal_absoluteDyadicBandpass_le_of_sharp
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C)
    (hdecay : ∀ z : Euclidean (n + 1), 1 ≤ ‖z‖ →
      ‖surfaceFourier (n + 1) z‖ ≤ C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ z, ‖z‖ ≤ 1 → phi z = 1)
    (hphiZero : ∀ z, 2 ≤ ‖z‖ → phi z = 0)
    (hphiNorm : ∀ z, ‖phi z‖ ≤ 1)
    (j : Nat) (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : Real) 2)
    (f : Euclidean (n + 1) → Complex) {x : Euclidean (n + 1)}
    (hf : Integrable f volume) (hfmeas : AEStronglyMeasurable f volume) :
    rawDyadicSurfaceMaximalReal (n + 1) E
      (absoluteDyadicBandpass phi hphiOne hphiZero j)
      (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) f x ≤
      ‖((surfaceMass (n + 1))⁻¹ : Complex)‖ *
        (q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j *
          (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal) *
        ∫ y, ‖f y‖ := by
  let A : Real := q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j *
    (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal
  have hB : 0 ≤ q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j := by
    dsimp only [q4EnlargedSurfaceMultiplierBound]
    refine mul_nonneg (by norm_num)
      (div_nonneg hC.le (Real.rpow_nonneg ?_ _))
    have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
      _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
    linarith
  have hvol : 0 ≤
      (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal :=
    ENNReal.toReal_nonneg
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact mul_nonneg hB hvol
  apply rawDyadicSurfaceMaximalReal_le_of_uniform_kernel_bound (A := A)
    E (absoluteDyadicBandpass phi hphiOne hphiZero j)
    (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) f hA hf hfmeas
  intro r hr z
  apply norm_rawDyadicSurfaceKernel_absoluteDyadicBandpass_le_volume_of_sharp_on_half
    C hC hdecay phi hphiOne hphiZero hphiNorm j hj r
  constructor
  · exact le_trans (by norm_num) (hE hr).1
  · exact le_trans (hE hr).2 (by norm_num)

/-- The same literal fixed-frequency endpoint in the original
Schwartz-facing API.  This is the form used with the rational low/high
Schwartz decomposition in the interpolation argument. -/
def absoluteDyadicSurfaceL1EndpointConstant (n : Nat) (C : Real) (j : Nat) : Real :=
  ‖((surfaceMass (n + 1))⁻¹ : Complex)‖ *
    (q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j *
      (volume (ball (0 : Euclidean (n + 1)) ((2 : Real) ^ (j + 2)))).toReal)

/-- Positivity of the explicit literal `L¹ → L∞` coefficient. -/
theorem absoluteDyadicSurfaceL1EndpointConstant_nonneg
    (n : Nat) {C : Real} (hC : 0 ≤ C) (j : Nat) :
    0 ≤ absoluteDyadicSurfaceL1EndpointConstant n C j := by
  unfold absoluteDyadicSurfaceL1EndpointConstant
  apply mul_nonneg (norm_nonneg _)
  apply mul_nonneg
  · unfold q4EnlargedSurfaceMultiplierBound
    refine mul_nonneg (by norm_num)
      (div_nonneg hC (Real.rpow_nonneg ?_ _))
    have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
      _root_.Auto.Spherical.SurfaceCore.dyadicScale_pos j
    linarith
  · exact ENNReal.toReal_nonneg

theorem fractalDyadicBandpassMaximal_absoluteDyadicBandpass_le_of_sharp
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C)
    (hdecay : ∀ z : Euclidean (n + 1), 1 ≤ ‖z‖ →
      ‖surfaceFourier (n + 1) z‖ ≤ C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ z, ‖z‖ ≤ 1 → phi z = 1)
    (hphiZero : ∀ z, 2 ≤ ‖z‖ → phi z = 0)
    (hphiNorm : ∀ z, ‖phi z‖ ≤ 1)
