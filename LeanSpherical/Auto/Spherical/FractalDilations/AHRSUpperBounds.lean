        psi hpsiCompact j (dyadicLeft j i + u)) G2
  let R : Real := (q4FibreLpMoment volume s p G) ^ (1 / p)
  have hR : 0 <= R := by
    exact Real.rpow_nonneg (q4FibreLpMoment_nonneg volume s p G) _
