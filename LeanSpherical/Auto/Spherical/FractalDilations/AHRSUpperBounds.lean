    fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≤
        normalizedSphericalMaximal d (f : Euclidean d → ℂ) x :=
      fractalSphericalMaximal_le_normalizedSphericalMaximal E hE _ x
    _ ≤ ENNReal.ofReal a :=
      normalizedSphericalMaximal_le_of_norm_le hd _ x hfa

/-- A diagonal strong `L^q` bound supplies the weak estimate needed by the
smooth-split Marcinkiewicz theorem. -/
private theorem fractalSphericalMaximalReal_weak_of_strong
    {d : ℕ} (E : Set ℝ) {q : ℝ} (hq : 0 < q)
    (hstrong : HasFractalSphericalStrongType d E q q) :
    ∃ Cq : ℝ, 0 < Cq ∧ ∀ (f : SchwartzMap (Euclidean d) ℂ) {s : ℝ}, 0 < s →
      (ENNReal.ofReal s) ^ q * volume {x | s < fractalSphericalMaximalReal d E f x} ≤
        ENNReal.ofReal Cq *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ q := by
  obtain ⟨C, hC, hstrong⟩ := hstrong
  refine ⟨C ^ q, Real.rpow_pos_of_pos hC _, ?_⟩
  intro f s hs
  obtain ⟨hmem, hnorm⟩ := hstrong f
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq
  have hqET : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have hf_pow :
      eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal q) volume ^ q =
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ q := by
    rw [eLpNorm_eq_eLpNorm' hqE0 hqET, ENNReal.toReal_ofReal hq.le]
    simpa only [ofReal_norm] using
      (lintegral_rpow_enorm_eq_rpow_eLpNorm' (μ := volume)
        (f := (f : Euclidean d → ℂ)) hq).symm
  calc
    (ENNReal.ofReal s) ^ q * volume {x | s < fractalSphericalMaximalReal d E f x} ≤
        (ENNReal.ofReal s) ^ q * volume
          {x | ENNReal.ofReal s ≤ ‖fractalSphericalMaximalReal d E f x‖ₑ} := by
      apply mul_le_mul_right
      apply measure_mono
      intro x hx
      change ENNReal.ofReal s ≤
        ‖(fractalSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal‖ₑ
      rw [Real.enorm_eq_ofReal ENNReal.toReal_nonneg]
      change s < (fractalSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal at hx
      exact ENNReal.ofReal_le_ofReal hx.le
    _ ≤ eLpNorm (fractalSphericalMaximalReal d E f) (ENNReal.ofReal q) volume ^ q :=
      by
        simpa only [ENNReal.toReal_ofReal hq.le] using
          (mul_meas_ge_le_pow_eLpNorm' volume hqE0 hqET hmem.aestronglyMeasurable
            (ENNReal.ofReal s))
    _ ≤ (ENNReal.ofReal C *
          eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal q) volume) ^ q :=
      ENNReal.rpow_le_rpow hnorm (by positivity)
    _ = ENNReal.ofReal (C ^ q) *
          ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ q := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
        ENNReal.ofReal_rpow_of_pos hC, hf_pow]

/-- Interpolate a diagonal strong bound with the pointwise `L∞` contraction.
The proof is the all-range smooth truncation argument already used by the
spherical maximal development, specialized to the restricted operator. -/
private theorem fractalSphericalStrongType_of_diagonal_and_top
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Ioi (0 : ℝ))
    {q p : ℝ} (hq : 0 < q) (hqp : q < p)
    (hstrong : HasFractalSphericalStrongType d E q q) :
    HasFractalSphericalStrongType d E p p := by
  have hp0 : 0 < p := hq.trans hqp
  have hdiff : 0 < p - q := sub_pos.mpr hqp
  obtain ⟨Cq, hCq, hweak⟩ :=
    fractalSphericalMaximalReal_weak_of_strong E hq hstrong
  let Atail : ℝ := (p - q)⁻¹ * (4 : ℝ) ^ (p - q)
  let A : ℝ := p * (2 : ℝ) ^ q * Cq * Atail
  have hAtail : 0 < Atail := by
    dsimp only [Atail]
    positivity
  have hA : 0 < A := by
    dsimp only [A]
    positivity
  refine ⟨A ^ p⁻¹, Real.rpow_pos_of_pos hA _, ?_⟩
  intro f
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_smooth_low_high_family f
  let J : ℝ := ∫ x : Euclidean d, ‖f x‖ ^ p
  have hinput : (∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p) =
      ENNReal.ofReal J := by
    dsimp only [J]
    exact absolute_schwartz_lintegral_rpow_eq_ofReal_integral f hp0
  let Aq : ℝ := Atail * J
  have hAq : 0 ≤ Aq := by
    dsimp only [Aq]
    exact mul_nonneg hAtail.le
      (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p)
  have htail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x : Euclidean d, (ENNReal.ofReal ‖high t x‖) ^ q) *
          (ENNReal.ofReal t) ^ (p - q - 1)) ≤ ENNReal.ofReal Aq := by
    have h := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
      (q := q) (p := p) hq hqp
    rw [hinput] at h
    have htail_eq :
        (ENNReal.ofReal (p - q))⁻¹ * (ENNReal.ofReal (4 : ℝ)) ^ (p - q) *
            ENNReal.ofReal J = ENNReal.ofReal Aq := by
      dsimp only [Aq, Atail]
      rw [← ENNReal.ofReal_inv_of_pos hdiff]
      rw [ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
      rw [← ENNReal.ofReal_mul (inv_nonneg.mpr hdiff.le)]
      rw [← ENNReal.ofReal_mul
        (mul_nonneg (inv_nonneg.mpr hdiff.le)
          (Real.rpow_nonneg (by norm_num) _))]
    rw [htail_eq] at h
    exact h
  have hlin :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        ENNReal.ofReal (p * (2 : ℝ) ^ q * Cq * Aq * (1 : ℝ) ^ (p - q)) := by
    apply marcinkiewicz_weak_q_top_on_additive_split_real_top_scaled
      (D := Set.univ) (eval := fun g : SchwartzMap (Euclidean d) ℂ =>
        (g : Euclidean d → ℂ)) (T := fractalSphericalMaximalReal d E) (q := q)
        (Cq := Cq) (Ctop := (1 : ℝ)) (p := p) (f := f)
        (low := low) (high := high) (Aq := Aq)
    · intro g x
      exact ENNReal.toReal_nonneg
    · intro g h _ _ x
      exact fractalSphericalMaximalReal_schwartz_add_le hd E hE g h x
    · exact hq
    · norm_num
    · intro g _ s hs
      exact hweak g hs
    · intro g _ a ha hga x
      simpa using fractalSphericalMaximalReal_le_of_norm_le hd E hE g ha hga x
    · exact hqp
    · exact (measurable_fractalSphericalMaximalReal E f).aemeasurable
    · intro t
      simp
    · intro t
      simp
    · intro t
      ext x
      exact hsplit t x
    · intro t ht x
      exact smooth_low_norm_le_half_height f (low t) ht (hlow t) x
    · exact measurable_smooth_high_profile_lintegrals f low high hlow hhigh q
    · exact htail
    · exact hAq
  have hcoeff :
      p * (2 : ℝ) ^ q * Cq * Aq * (1 : ℝ) ^ (p - q) = A * J := by
    dsimp only [A, Aq]
    rw [Real.one_rpow]
    ring
  rw [hcoeff] at hlin
  have hAJ : 0 ≤ A * J := by
    exact mul_nonneg hA.le
      (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p)
  have hmem : MemLp (fractalSphericalMaximalReal d E f) (ENNReal.ofReal p) volume :=
    (memLp_and_integral_of_lintegral_rpow_bound
      (fractalSphericalMaximalReal d E f)
      (measurable_fractalSphericalMaximalReal E f).aestronglyMeasurable
      (fun _ => ENNReal.toReal_nonneg) hp0 hlin hAJ).1
  refine ⟨hmem, ?_⟩
  have hlin' :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        ENNReal.ofReal A * ∫⁻ x : Euclidean d,
          (ENNReal.ofReal ‖f x‖) ^ p := by
    rw [hinput, ← ENNReal.ofReal_mul hA.le]
    exact hlin
  have hnorm := eLpNorm_le_of_lintegral_real_rpow_bound hp0
    (fractalSphericalMaximalReal d E f) f (fun _ => ENNReal.toReal_nonneg)
    (ENNReal.ofReal A) hlin'
  simpa only [ENNReal.ofReal_rpow_of_pos hA] using hnorm

/-- The non-endpoint diagonal Minkowski estimate in the plane, conditional
only on the sharp circle Fourier and radial-derivative estimates. -/
theorem circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent_of_sharp
    (hcircle : HasCircleSurfaceFourierSharpBounds)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {α p : ℝ} (hα : 0 ≤ α) (hM : HasUpperMinkowskiExponent E α)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : α < p - 1) :
    HasFractalSphericalStrongType 2 E p p := by
  let η : ℝ := (p - 1 - α) / 2
  let a : ℝ := α + η
  let κ : ℝ := p - 1 - a
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hη : 0 < η := by
    dsimp only [η]
    linarith
  have ha : 0 ≤ a := by
    dsimp only [a]
    exact add_nonneg hα hη.le
  have hκ : 0 < κ := by
    dsimp only [κ, a, η]
    linarith
  have he : a + 1 - p = -κ := by
    dsimp only [κ]
    ring
  obtain ⟨C, hC, hCovers⟩ :=
    exists_positive_intervalCovers_of_hasUpperMinkowskiExponent hE hM η hη
  obtain ⟨phi, psi, hphi_one, hphi_zero, hphi_norm, hpsi, -⟩ :=
    exists_smooth_absolute_dyadic_bandpass_family 2
  rcases hcircle with ⟨C0, C1, hC0, hC1, hdecay, hderiv⟩
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  obtain ⟨B, hB, hregular⟩ :=
    absolute_lowpass_strong_type (d := 2) (by norm_num) E hE
      phi hphi_zero hphi_norm hp1 hp2
  let a₁ : ℝ := (p - 1)⁻¹ + (3 - p)⁻¹
  let a₂ : ℝ := ((1 : ℝ) / 4) * p⁻¹ + (2 - p)⁻¹
  let B₁ : ℝ := surfaceMass 2 *
    ((∫ x : Euclidean 2, ‖(𝓕⁻ psi : SchwartzMap (Euclidean 2) ℂ) x‖) +
      ∫ x : Euclidean 2,
        ‖fderiv ℝ ((𝓕⁻ psi : SchwartzMap (Euclidean 2) ℂ) :
          Euclidean 2 → ℂ) x‖)
  let B₂ : ℝ := 8 * C0 ^ 2 + 32 * C1 ^ 2
  let D : ℝ := C * (2 : ℝ) ^ a
  let P : ℝ := ((surfaceMass 2)⁻¹) ^ p *
    (p * (4 * (D * B₂) * a₂ + 2 * (D * B₁) * a₁))
  let A : ℝ := P + 1
  have hpminus : 0 < p - 1 := by linarith
  have htwo_pos : 0 < 2 - p := by linarith
  have hthree : 0 < 3 - p := by linarith
  have ha₁ : 0 ≤ a₁ := by
    dsimp only [a₁]
    exact add_nonneg (inv_nonneg.mpr hpminus.le) (inv_nonneg.mpr hthree.le)
  have ha₂ : 0 ≤ a₂ := by
    dsimp only [a₂]
    exact add_nonneg
      (mul_nonneg (by norm_num) (inv_nonneg.mpr hp0.le))
      (inv_nonneg.mpr htwo_pos.le)
  have hB₁ : 0 ≤ B₁ := by
    dsimp only [B₁]
    apply mul_nonneg (surfaceMass_pos (by norm_num)).le
    exact add_nonneg
      (integral_nonneg fun _ => norm_nonneg _)
      (integral_nonneg fun _ => norm_nonneg _)
  have hB₂ : 0 ≤ B₂ := by
    dsimp only [B₂]
    positivity
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact mul_nonneg hC.le (Real.rpow_nonneg (by norm_num) _)
  have hmass : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  have hP : 0 ≤ P := by
    dsimp only [P]
    apply mul_nonneg (Real.rpow_nonneg (inv_nonneg.mpr hmass.le) _)
    apply mul_nonneg hp0.le
    apply add_nonneg
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (mul_nonneg hD hB₂)) ha₂
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (mul_nonneg hD hB₁)) ha₁
  have hA : 0 < A := by
    dsimp only [A]
    linarith
  have hP_le_A : P ≤ A := by
    dsimp only [A]
    linarith
  apply absolute_reassembly_from_estimates
    (d := 2) (p := p) (by norm_num) hp1 E hEpos phi hphi_one hphi_zero
    ⟨B, hB, hregular⟩
  refine ⟨A, κ, hA, hκ, ?_⟩
  intro j f
  let R : ℝ := Auto.Spherical.SurfaceCore.dyadicScale j
  let δ : ℝ := (2 * R)⁻¹
  have hR : 0 < R := by
    dsimp only [R]
    exact Auto.Spherical.SurfaceCore.dyadicScale_pos j
  have hRone : 1 ≤ R := by
    dsimp only [R]
    exact one_le_absolute_dyadicScale j
  have hδ : 0 < δ := by
    dsimp only [δ]
    exact inv_pos.mpr (mul_pos (by norm_num) hR)
  have hδone : δ < 1 := by
    dsimp only [δ]
    apply inv_lt_one_of_one_lt₀
    nlinarith
  have hδR : δ ≤ R⁻¹ := by
    calc
      δ = R⁻¹ * (2 : ℝ)⁻¹ := by
        dsimp only [δ]
        rw [mul_inv_rev]
      _ ≤ R⁻¹ * 1 := by
        apply mul_le_mul_of_nonneg_left
        · norm_num
        · exact inv_nonneg.mpr hR.le
      _ = R⁻¹ := by ring
  obtain ⟨ι, hcover, hcard, -⟩ := hCovers δ hδ hδone
  have hδscale : C * δ ^ (-a) = D * R ^ a := by
    dsimp only [δ, D]
    rw [inv_rpow_neg_eq_rpow, Real.mul_rpow (by norm_num) hR.le]
    ring
  have hendpoints : ∀ g : SchwartzMap (Euclidean (1 + 1)) ℂ,
      MemLp (unnormalizedFractalDyadicBandpassMaximal (1 + 1) E
        (absoluteDyadicBandpass phi hphi_one hphi_zero j) g) 1 volume ∧
      (∫ x : Euclidean (1 + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (1 + 1) E
          (absoluteDyadicBandpass phi hphi_one hphi_zero j) g x‖) ≤
        (C * δ ^ (-a)) * B₁ * ∫ x : Euclidean (1 + 1), ‖g x‖ ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal (1 + 1) E
        (absoluteDyadicBandpass phi hphi_one hphi_zero j) g) 2 volume ∧
      (∫ x : Euclidean (1 + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (1 + 1) E
          (absoluteDyadicBandpass phi hphi_one hphi_zero j) g x‖ ^ (2 : ℕ)) ≤
        (C * δ ^ (-a)) * (B₂ * R ^ (-((1 : ℕ) : ℝ))) *
          ∫ x : Euclidean (1 + 1), ‖g x‖ ^ (2 : ℕ) := by
    intro g
    have hendpoint := absolute_dyadic_minkowski_endpoints_of_cover_of_local_l2
      (n := 1) (E := E) (R := R) (δ := δ) (α := a) (C := C)
      (by norm_num) hE hEne hR hRone hδ hδone hδR
      ι hcover (by simpa only [a] using hcard)
      psi g (absoluteDyadicBandpass phi hphi_one hphi_zero j)
      (by
        intro xi
        simpa only [R, Auto.Spherical.SurfaceCore.dyadicScale] using
          smooth_dyadic_bandpass_eq_scaled_base phi psi
            (absoluteDyadicBandpass phi hphi_one hphi_zero j) hpsi j
            (absoluteDyadicBandpass_spec phi hphi_one hphi_zero j) xi)
      hB₂ (by
        intro u v huv huvinterval hlen
        rcases sphericalIntervalMaximalRaw_memLp_two_of_circle_sharp
          C0 C1 hC0 hC1 hdecay hderiv phi g
          (absoluteDyadicBandpass phi hphi_one hphi_zero j)
          hphi_one hphi_zero hphi_norm j
          (absoluteDyadicBandpass_spec phi hphi_one hphi_zero j)
          (absoluteDyadicBandpass_compact phi hphi_one hphi_zero j)
          huv huvinterval with ⟨hmem, hbound⟩
        refine ⟨hmem, hbound.trans ?_⟩
        apply mul_le_mul_of_nonneg_right
          (by
            simpa [R, Auto.Spherical.SurfaceCore.dyadicScale, B₂, Nat.cast_one] using
              circle_short_interval_l2_coefficient_le_frequency_decay
                C0 C1 hC0.le hC1.le hR hRone (sub_nonneg.mpr huv) hlen)
          (integral_nonneg fun _ => sq_nonneg _))
    simpa [B₁, B₂, Nat.cast_one] using hendpoint
  have hpiece := normalized_absolute_minkowski_moment_of_cover_endpoints_of_pos
    (n := 1) (E := E) (R := R) (δ := δ) (α := a) (C := C) (D := D)
    (B₁ := B₁) (B₂ := B₂) (p := p)
    (by norm_num) hR ha hD hB₁ hB₂ hp1 hp2 hδscale
    (absoluteDyadicBandpass phi hphi_one hphi_zero j) hEpos hendpoints f
  have hpiece' :
      MemLp (fractalDyadicBandpassMaximal 2 E
        (absoluteDyadicBandpass phi hphi_one hphi_zero j) f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean 2,
        (fractalDyadicBandpassMaximal 2 E
          (absoluteDyadicBandpass phi hphi_one hphi_zero j) f x) ^ p) ≤
        P * R ^ (a + 1 - p) * ∫ x : Euclidean 2, ‖f x‖ ^ p := by
    simpa [a₁, a₂, P, Nat.cast_one] using hpiece
  have hRpow : R ^ (a + 1 - p) =
      (2 : ℝ) ^ (-κ * (j : ℝ)) := by
    rw [he]
    dsimp only [R, Auto.Spherical.SurfaceCore.dyadicScale]
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
    congr 1
    ring
  refine ⟨hpiece'.1, ?_⟩
  have hI : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ p :=
    integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _
  calc
    (∫ x : Euclidean 2,
      (fractalDyadicBandpassMaximal 2 E
        (absoluteDyadicBandpass phi hphi_one hphi_zero j) f x) ^ p) ≤
        P * R ^ (a + 1 - p) * ∫ x : Euclidean 2, ‖f x‖ ^ p := hpiece'.2
    _ = P * (2 : ℝ) ^ (-κ * j) * ∫ x : Euclidean 2, ‖f x‖ ^ p := by
      rw [hRpow]
    _ ≤ A * (2 : ℝ) ^ (-κ * j) * ∫ x : Euclidean 2, ‖f x‖ ^ p := by
      apply mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hP_le_A
          (Real.rpow_nonneg (by norm_num) _)) hI

/-- The non-endpoint planar diagonal theorem with no analytic hypothesis:
the required circle Fourier decay and radial derivative bounds are supplied
by the angular circle development. -/
theorem circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {α p : ℝ} (hα : 0 ≤ α) (hM : HasUpperMinkowskiExponent E α)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : α < p - 1) :
    HasFractalSphericalStrongType 2 E p p :=
  circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent_of_sharp
    hasCircleSurfaceFourierSharpBounds E hE hEne hα hM hp1 hp2 hcritical

/-- The sub-`L²` planar diagonal estimate in terms of equality of upper
Minkowski dimension.  As usual, take a small admissible exponent loss before
applying the covering estimate. -/
theorem circle_minkowski_diagonal_strong_type_of_upperMinkowskiDimension_eq
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
    {β p : ℝ} (hβ : 0 ≤ β)
    (hMinkowski : upperMinkowskiDimension E = β)
    (hp1 : 1 < p) (hp2 : p < 2) (hcritical : β < p - 1) :
    HasFractalSphericalStrongType 2 E p p := by
  rcases eq_empty_or_nonempty E with rfl | hEne
  · refine ⟨1, zero_lt_one, ?_⟩
    intro f
    have hzero : fractalSphericalMaximalReal 2 (∅ : Set ℝ) f = 0 := by
      funext x
      simp [fractalSphericalMaximalReal, fractalSphericalMaximal]
    rw [hzero]
    simp
  let ε : ℝ := (p - 1 - β) / 2
  let α : ℝ := β + ε
  have hε : 0 < ε := by
    dsimp only [ε]
    linarith
  have hα : 0 ≤ α := by
    dsimp only [α]
    exact add_nonneg hβ hε.le
  have hαcritical : α < p - 1 := by
    dsimp only [α, ε]
    linarith
  have hM : HasUpperMinkowskiExponent E α := by
    simpa only [α] using
      hasUpperMinkowskiExponent_add_of_upperMinkowskiDimension_eq hE hMinkowski hε
  exact circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent
    E hE hEne hα hM hp1 hp2 hαcritical

/-- The planar diagonal estimate above the `L²` line.  A strictly
subcritical Minkowski exponent admits an auxiliary exponent in `(1,2)`;
the result then follows from the preceding direct circle estimate and the
pointwise `L∞` contraction. -/
theorem circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent_ge_two
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {α p : ℝ} (hα : 0 ≤ α) (hαone : α < 1)
    (hM : HasUpperMinkowskiExponent E α) (hp : 2 ≤ p) :
    HasFractalSphericalStrongType 2 E p p := by
  let q : ℝ := (α + 3) / 2
  have hqone : 1 < q := by
    dsimp only [q]
    linarith
  have hqtwo : q < 2 := by
    dsimp only [q]
    linarith
  have hqpos : 0 < q := lt_trans zero_lt_one hqone
  have hcritical : α < q - 1 := by
    dsimp only [q]
    linarith
  have hqp : q < p := hqtwo.trans_le hp
  have hEpos : E ⊆ Ioi (0 : ℝ) := by
    intro r hr
    exact lt_of_lt_of_le zero_lt_one (hE hr).1
  have hqstrong : HasFractalSphericalStrongType 2 E q q :=
    circle_minkowski_diagonal_strong_type_of_hasUpperMinkowskiExponent
