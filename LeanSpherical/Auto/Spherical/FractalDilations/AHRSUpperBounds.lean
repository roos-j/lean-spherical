The absolute dyadic cutoff at level `j` is the fixed level-zero annular
cutoff evaluated at `2^{-j} xi`.  After this identity is inserted in the
actual `A_j A_j^*` multiplier, Fourier scaling turns the pair kernel into a
fixed-annulus kernel with radii and physical variable multiplied by `2^j`.

This is the normalization used in the paper's cone split.  It is recorded
here as an equality, so no scale-uniform kernel estimate is silently assumed.
-/

namespace Auto.Spherical.FractalDilations.AbsoluteDyadicPairScaling

open FourierTransform
open scoped FourierTransform

noncomputable section

/-- The literal absolute bandpass is a frequency dilation of its level-zero
profile. -/
theorem absoluteDyadicBandpass_eq_levelZero_comp_inv_smul
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (j : Nat) (xi : Euclidean d) :
    absoluteDyadicBandpass phi hphiOne hphiZero j xi =
      absoluteDyadicBandpass phi hphiOne hphiZero 0
        (((2 : Real) ^ j)⁻¹ • xi) := by
  rw [absoluteDyadicBandpass_spec, absoluteDyadicBandpass_spec]
  simp only [pow_zero, pow_one, inv_one, one_smul, smul_smul]
  have hj : (2 : Real) ^ j ≠ 0 := pow_ne_zero _ (by norm_num)
  congr 2 <;> field_simp [hj] <;> ring

/-- Under the same frequency dilation, the two literal spherical factors
acquire the scaled radii. -/
theorem q4DyadicPairMultiplier_absoluteDyadicBandpass_eq_levelZero_scaled
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (j : Nat) (r r' : Real) (xi : Euclidean d) :
    q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero j) r r' xi =
      q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        ((2 : Real) ^ j * r) ((2 : Real) ^ j * r')
        (((2 : Real) ^ j)⁻¹ • xi) := by
  let s : Real := (2 : Real) ^ j
  have hs : s ≠ 0 := by
    dsimp [s]
    exact pow_ne_zero _ (by norm_num)
  have hsurface (t : Real) :
      -(s * t) • (s⁻¹ • xi) = -t • xi := by
    rw [smul_smul]
    congr 1
    field_simp [hs]
  unfold q4DyadicPairMultiplier q4DyadicSurfaceMultiplier
  rw [absoluteDyadicBandpass_eq_levelZero_comp_inv_smul phi hphiOne hphiZero j xi]
  rw [hsurface r, hsurface r']

/-- Exact physical-space scaling of the actual dyadic pair kernel.  The
right hand side has a fixed (`j = 0`) annular cutoff, while the radii and
physical variable have been multiplied by the true frequency scale `2^j`. -/
theorem q4DyadicPairKernel_absoluteDyadicBandpass_eq_levelZero_scaled
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (j : Nat) (r r' : Real) (x : Euclidean d) :
    q4DyadicPairKernel (absoluteDyadicBandpass phi hphiOne hphiZero j) r r' x =
      ((2 : Real) ^ j) ^ d •
        q4DyadicPairKernel (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          ((2 : Real) ^ j * r) ((2 : Real) ^ j * r')
          ((2 : Real) ^ j • x) := by
  let s : Real := (2 : Real) ^ j
  have hs : 0 < s := by
    dsimp [s]
    positivity
  unfold q4DyadicPairKernel
  rw [show
      q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero j) r r' =
        fun xi : Euclidean d =>
          q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') (s⁻¹ • xi) by
      funext xi
      exact q4DyadicPairMultiplier_absoluteDyadicBandpass_eq_levelZero_scaled
        phi hphiOne hphiZero j r r' xi]
  simpa only [s, finrank_euclideanSpace_fin] using
    (fourierInv_comp_inv_smul
      (g := q4DyadicPairMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) (s * r) (s * r')) hs x)

end

end Auto.Spherical.FractalDilations.AbsoluteDyadicPairScaling
end Former_AbsoluteDyadicPairScaling

