/-- The actual `Q4` dyadic maximal bridge, with the full product estimate
proved by finite canonical-shell reassembly.  Its only norm-estimate inputs
are the all-dimensional stationary pair-kernel decay, the finite shell
strong estimates which use that endpoint, and the scaled derivative
variation bound.  All intervening steps are literal finite-product `TT*`,
finite maxima, and the active-cell sampling inequality.
-/
theorem fractalDyadicBandpassMaximal_eLpNorm_le_of_stationary_geometric_TTStar
    {d : Nat} {E : Set Real} {j : Nat}
    (hd : 1 ≤ d) (hj : 1 ≤ j)
    (hE : E ⊆ Set.Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : Nat → SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport ((psi j : SchwartzMap (Euclidean d) Complex) :
      Euclidean d → Complex))
    (f : SchwartzMap (Euclidean d) Complex)
    (T Tstar : Int → (Euclidean d → Complex) →ₗ[Complex]
      (Euclidean d → Complex))
    {q qdual A F Cstationary Cderivative : Real} {B : ENNReal}
    (u : Euclidean d → Complex)
    (hCstationary : 0 ≤ Cstationary)
    (hpsiRadial : ∀ k, IsNormRadial (psi k))
    (hstationary : (∀ k, IsNormRadial (psi k)) →
      HasQ4DyadicPairKernelGapDecayOn d psi
        (1 / 2 : Real) (5 / 2) Cstationary)
    (hderivativeStationary : (∀ k, IsNormRadial (psi k)) →
      HasQ4ScaledNormalizedDyadicSurfaceRadiusDerivativePairKernelGapDecayOn
        d psi (1 / 2 : Real) (5 / 2) Cderivative)
