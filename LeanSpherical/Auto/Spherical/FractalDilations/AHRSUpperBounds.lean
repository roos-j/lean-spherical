/-- The finite coordinate-triple summands are interval integrable on the
fixed annulus.  This is used only to make the 27-term triangle inequality an
actual equality/inequality of interval integrals. -/
private theorem intervalIntegrable_coordinateTripleWaveTerm
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean d)
    (p q t : CoordinateWavePart) :
    IntervalIntegrable (fun u : Real =>
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ r r') u)
      volume (1 : Real) 4 := by
  have hcoefficient : Continuous (fun u : Real =>
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u) :=
    (contDiff_coordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0) r r' v x p q t).continuous
  have hphase : Continuous
      (oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ r r')) := by
    unfold oscillatoryExp
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul
        continuous_const)
  exact (hcoefficient.mul hphase).intervalIntegrable _ _

/-- The actual finite `27`-term stationary calculation gives a literal
radius-gap bound in every dimension at least three.  No selector, maximal
operator, or abstract kernel-class hypothesis appears in this statement. -/
theorem exists_hasQ4DyadicPairKernelGapDecayOn_absoluteDyadicBandpass_of_three_le
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hphiRadial : IsNormRadial phi) :
    ∃ C : Real, 0 < C ∧
      HasQ4DyadicPairKernelGapDecayOn d
        (fun j => absoluteDyadicBandpass phi hphiOne hphiZero j)
        (1 / 2 : Real) (5 / 2) C := by
  have hterm : ∀ p q t : CoordinateWavePart, ∃ C : Real, 0 < C ∧
      ∀ s r r' : Real, 1 ≤ s →
        r ∈ Icc (1 / 2 : Real) (5 / 2) →
        r' ∈ Icc (1 / 2 : Real) (5 / 2) →
        ∀ v x : Euclidean d, ‖v‖ = 1 →
        ‖∫ u in (1 : Real)..4,
          coordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) p q t u *
            oscillatoryExp
              (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
          C / s ^ (d - 1) *
            (1 + s * |r - r'|) ^ (-q4StationaryExponent d) := by
    intro p q t
    exact exists_coordinateTripleWaveIntegral_stationaryGap_bound
      hd phi hphiOne hphiZero hphiRadial p q t
  choose C hCpos hCbound using hterm
  let parts3 : Finset (CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart)) :=
    coordinateWaveParts.product (coordinateWaveParts.product coordinateWaveParts)
  let K : Real := ∑ z ∈ parts3, C z.1 z.2.1 z.2.2
  have hparts0 : (.outgoing : CoordinateWavePart) ∈ coordinateWaveParts := by
    simp [coordinateWaveParts]
  let z0 : CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart) :=
    (.outgoing, (.outgoing, .outgoing))
  have hz0 : z0 ∈ parts3 := by
    dsimp [parts3, z0]
    simp [coordinateWaveParts]
  have hKpos : 0 < K := by
    have hle : C z0.1 z0.2.1 z0.2.2 ≤ K := by
      dsimp [K]
      exact Finset.single_le_sum
        (fun z hz => (hCpos z.1 z.2.1 z.2.2).le) hz0
    exact lt_of_lt_of_le (hCpos z0.1 z0.2.1 z0.2.2) hle
  refine ⟨K, hKpos, ?_⟩
  intro j r r' x hr hr'
  let s : Real := (2 : Real) ^ j
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have hs : 1 ≤ s := by
    dsimp [s]
    exact one_le_pow₀ (by norm_num)
  have hrpos : 0 < r := lt_of_lt_of_le (by norm_num) hr.1
  have hr'pos : 0 < r' := lt_of_lt_of_le (by norm_num) hr'.1
  let i : Fin d := ⟨0, by omega⟩
  let v : Euclidean d := EuclideanSpace.single i (1 : Real)
  have hv : ‖v‖ = 1 := by
    dsimp [v]
    simpa using (EuclideanSpace.norm_single i (1 : Real))
  have hsum (u : Real) :
      ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
        ∑ t ∈ coordinateWaveParts,
          coordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) p q t u *
            oscillatoryExp
              (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u =
        ∑ z ∈ parts3,
          coordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
            oscillatoryExp
              (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
                (s * r) (s * r')) u := by
    simp [parts3, Finset.sum_product]
  have hintegrable (z : CoordinateWavePart × (CoordinateWavePart × CoordinateWavePart))
      (hz : z ∈ parts3) :
      IntervalIntegrable (fun u : Real =>
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2 u *
          oscillatoryExp
            (coordinateTripleWavePhase z.1 z.2.1 z.2.2 ‖s • x‖
              (s * r) (s * r')) u)
        volume (1 : Real) 4 :=
    intervalIntegrable_coordinateTripleWaveTerm phi hphiOne hphiZero
      (s * r) (s * r') v (s • x) z.1 z.2.1 z.2.2
  have hsumBound :
      ‖∫ u in (1 : Real)..4,
        ∑ p ∈ coordinateWaveParts, ∑ q ∈ coordinateWaveParts,
          ∑ t ∈ coordinateWaveParts,
            coordinateTripleWaveCoefficient
