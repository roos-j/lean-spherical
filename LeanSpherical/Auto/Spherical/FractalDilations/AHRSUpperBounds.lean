for the surrounding radius-gap shell; the preceding filter inclusion is the
only comparison, so no cancellation is lost in the kernel operator itself. -/
theorem q4ActiveDyadicProductLevel_card_le_of_hasSubpowerAssouadCoverBound
    {E : Set ℝ} {γ η C : ℝ} {j n : ℕ} {i : ℤ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hcover : HasSubpowerAssouadCoverBound E γ η C)
    (hC : 0 ≤ C) (hγ : 0 ≤ γ)
    (hδone : dyadicScale j < 1)
    (hi : i ∈ activeDyadicIndices E j) (hn : 0 < n) :
    (((activeDyadicIndices E j).filter
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n i)).card : ℝ) ≤
      6 * C * (dyadicScale j) ^ (-η) *
        ((2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j) ^ γ := by
  let u : ℝ := (2 : ℝ) ^ (n - 1) * dyadicScale j
  let L : ℝ := (2 : ℝ) ^ n * dyadicScale j
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (pow_nonneg (by norm_num) _) (dyadicScale_pos j).le
  calc
    (((activeDyadicIndices E j).filter
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n i)).card : ℝ) ≤
        (((activeDyadicIndices E j).filter
          (radiusGapShellNeighbors u L (dyadicLeft j i) ∘ dyadicLeft j)).card : ℝ) := by
      simpa only [u, L] using
        q4ActiveDyadicProductLevel_card_le_radiusGapCard i hn
    _ = ((activeDyadicRadiusGapNeighbors E j u L i).card : ℝ) := by
      rfl
    _ ≤ 6 * C * (dyadicScale j) ^ (-η) *
        ((2 * (L + dyadicScale j)) / dyadicScale j) ^ γ :=
      activeDyadicRadiusGapNeighbors_card_le_of_hasSubpowerAssouadCoverBound
        hE hcover hC hγ hδone hL hi
    _ = 6 * C * (dyadicScale j) ^ (-η) *
        ((2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j) ^ γ := by
      rfl

/-- The relation-restricted square estimate for one *actual* active dyadic
gap level, now expressed on `Euclidean d × activeDyadicIndices E j` with
Lebesgue times counting measure.  The degree constant is obtained directly
from the upper Assouad-spectrum cell-covering bound; no auxiliary separated
set of radii is introduced. -/
theorem q4ActiveDyadicProductLevel_sq_integral_le_of_pairwise_bound
    {d : ℕ} {E : Set ℝ} {γ η C : ℝ} {j n : ℕ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    (hcover : HasSubpowerAssouadCoverBound E γ η C)
    (hC : 0 ≤ C) (hγ : 0 ≤ γ)
    (hδone : dyadicScale j < 1) (hn : 0 < n)
    (K : ℤ → ℤ → Euclidean d → ℂ)
    (g : Euclidean d × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {B : ℝ} (hB : 0 ≤ B)
    (hgmem : ∀ i ∈ activeDyadicIndices E j,
      MemLp (q4FiniteProductToFibres (activeDyadicIndices E j) g i) 2 volume)
    (hpairmem : ∀ i l,
      q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n i l →
      MemLp (q4PairwiseKernelApply volume K i l
        (q4FiniteProductToFibres (activeDyadicIndices E j) g l)) 2 volume)
    (hpair : ∀ i l,
      q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n i l →
      lpNorm (q4PairwiseKernelApply volume K i l
        (q4FiniteProductToFibres (activeDyadicIndices E j) g l)) 2 volume ≤
        B * lpNorm (q4FiniteProductToFibres (activeDyadicIndices E j) g l) 2 volume)
    (hgmeas : Measurable g)
    (hgintegrable : Integrable (fun z => ‖g z‖ ^ (2 : ℕ))
      (q4ActiveDyadicProductCountingMeasure d E j))
    (hginfib : ∀ i ∈ activeDyadicIndices E j,
      Integrable (fun x =>
        ‖q4FiniteProductToFibres (activeDyadicIndices E j) g i x‖ ^ (2 : ℕ)) volume)
    (houtmeas : Measurable
      (q4FiniteProductKernelShell volume (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g))
    (houtintegrable : Integrable
      (fun z => ‖q4FiniteProductKernelShell volume (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g z‖ ^ (2 : ℕ))
      (q4ActiveDyadicProductCountingMeasure d E j))
    (houtfib : ∀ i ∈ activeDyadicIndices E j,
      Integrable (fun x =>
        ‖q4FiniteProductToFibres (activeDyadicIndices E j)
          (q4FiniteProductKernelShell volume (activeDyadicIndices E j)
            (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
              activeDyadicGapLevel n) K g) i x‖ ^ (2 : ℕ)) volume) :
    (∫ z, ‖q4FiniteProductKernelShell volume (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g z‖ ^ (2 : ℕ)
      ∂q4ActiveDyadicProductCountingMeasure d E j) ≤
      (B * (6 * C * (dyadicScale j) ^ (-η) *
        ((2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j) ^ γ)) ^ 2 *
        ∫ z, ‖g z‖ ^ (2 : ℕ) ∂q4ActiveDyadicProductCountingMeasure d E j := by
  let D : ℝ := 6 * C * (dyadicScale j) ^ (-η) *
    ((2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
      dyadicScale j) ^ γ
  have hD : 0 ≤ D := by
    have hscale : 0 < dyadicScale j := dyadicScale_pos j
    have hratio : 0 ≤
        (2 * ((2 : ℝ) ^ n * dyadicScale j + dyadicScale j)) /
          dyadicScale j := by
      apply div_nonneg
      · apply mul_nonneg (by norm_num)
        exact add_nonneg
          (mul_nonneg (pow_nonneg (by norm_num) _) hscale.le) hscale.le
      · exact hscale.le
    dsimp only [D]
    exact mul_nonneg
      (mul_nonneg (mul_nonneg (by norm_num) hC)
        (Real.rpow_nonneg (dyadicScale_pos j).le _))
      (Real.rpow_nonneg hratio _)
  have hdegree : ∀ i ∈ activeDyadicIndices E j,
      (((activeDyadicIndices E j).filter
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n i)).card : ℝ) ≤ D := by
    intro i hi
    simpa only [D] using
      q4ActiveDyadicProductLevel_card_le_of_hasSubpowerAssouadCoverBound
        hE hcover hC hγ hδone hi hn
  exact q4FiniteProductKernelShell_sq_integral_le_of_pairwise_bound_on_relation
    volume (activeDyadicIndices E j)
    (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
      activeDyadicGapLevel n)
    (q4ActiveDyadicProductLevel_symm E j n) D hD hdegree K g hB
    hgmem hpairmem hpair hgmeas hgintegrable hginfib houtmeas houtintegrable houtfib

/-- On a literal field indexed by the active subtype, the unrestricted
finite-product relation and the active-pair relation give the same kernel
shell.  The equality is pointwise and exact: the output index and every
summation index are already members of `activeDyadicIndices E j`. -/
theorem q4FiniteProductKernelShell_full_eq_activeDyadicRelation
    {X : Type*} [Sub X] [MeasurableSpace X]
    (E : Set ℝ) (j : ℕ) (μ : Measure X)
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    (z : X × {i // i ∈ activeDyadicIndices E j}) :
    q4FiniteProductKernelShell μ (activeDyadicIndices E j) (fun _ _ => True) K g z =
      q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4ActiveDyadicProductRelation E j) K g z := by
  classical
  unfold q4FiniteProductKernelShell q4KernelTTStarShell
  have hfilter : (activeDyadicIndices E j).filter
      (q4ActiveDyadicProductRelation E j z.2.1) = activeDyadicIndices E j := by
    apply Finset.filter_true_of_mem
    intro l hl
    exact ⟨z.2.2, hl⟩
  rw [Finset.filter_true, hfilter]

/-- The scalar selected shell has the same exact active-relation reduction as
the literal finite product.  The selector already takes values in the active
finite family, so an unrestricted sum over that family contains no inactive
pair. -/
theorem q4SelectedKernelTTStarShell_full_eq_activeDyadicRelation
    {X : Type*} [Sub X] [MeasurableSpace X]
    (E : Set Real) (j : Nat) (mu : Measure X)
    (K : Int -> Int -> X -> Complex) (rho : X -> Int)
    (hrho : forall x, rho x ∈ activeDyadicIndices E j)
    (g : X -> Complex) (x : X) :
    q4SelectedKernelTTStarShell mu (activeDyadicIndices E j)
      (fun _ _ => True) K rho g x =
      q4SelectedKernelTTStarShell mu (activeDyadicIndices E j)
        (q4ActiveDyadicProductRelation E j) K rho g x := by
  classical
  unfold q4SelectedKernelTTStarShell q4KernelTTStarShell
  have hfilter : (activeDyadicIndices E j).filter
      (q4ActiveDyadicProductRelation E j (rho x)) = activeDyadicIndices E j := by
    apply Finset.filter_true_of_mem
    intro l hl
    exact ⟨hrho x, hl⟩
  rw [Finset.filter_true, hfilter]

/-- The literal full selected active-dyadic shell is exactly the finite sum
of canonical levels `0, …, j + 2`.  This is the scalar counterpart of the
finite-product reassembly and is the form used before taking the selected
maximal linearization back to the dyadic spherical operator. -/
theorem q4SelectedKernelTTStarShell_activeDyadic_eq_sum_gapLevels
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set Real} {j : Nat}
    (hj : 1 <= j) (hE : E ⊆ Icc (1 : Real) 2)
    (mu : Measure X) (K : Int -> Int -> X -> Complex)
    (rho : X -> Int) (hrho : forall x, rho x ∈ activeDyadicIndices E j)
    (g : X -> Complex) (x : X) :
    q4SelectedKernelTTStarShell mu (activeDyadicIndices E j)
      (fun _ _ => True) K rho g x =
      ∑ n ∈ Finset.range (j + 3),
        q4SelectedKernelTTStarShell mu (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K rho g x := by
  rw [q4SelectedKernelTTStarShell_full_eq_activeDyadicRelation E j mu K rho hrho g x]
  exact q4SelectedKernelTTStarShell_eq_sum_levelShells
    mu (activeDyadicIndices E j) (q4ActiveDyadicProductRelation E j)
    activeDyadicGapLevel (Finset.range (j + 3))
    (by
      intro i l hactive
      exact activeDyadicGapLevel_mem_range_add_three
        hj hE hactive.1 hactive.2)
    K rho g x

/-- The literal active-dyadic full product shell is the exact finite sum of
its canonical gap-level shells.  The finite range is supplied by the proved
active-cell diameter bound, not assumed as an external cutoff. -/
theorem q4FiniteProductKernelShell_activeDyadic_eq_sum_gapLevels
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X) (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    (z : X × {i // i ∈ activeDyadicIndices E j}) :
    q4FiniteProductKernelShell μ (activeDyadicIndices E j) (fun _ _ => True) K g z =
      ∑ n ∈ Finset.range (j + 3),
        q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g z := by
  classical
  rw [q4FiniteProductKernelShell_full_eq_activeDyadicRelation E j μ K g z]
  exact q4FiniteProductKernelShell_eq_sum_levelShells
    μ (activeDyadicIndices E j) (q4ActiveDyadicProductRelation E j)
    activeDyadicGapLevel (Finset.range (j + 3))
    (by
      intro i l hactive
      exact activeDyadicGapLevel_mem_range_add_three
        hj hE hactive.1 hactive.2)
    K g z

/-- The non-endpoint finite-product shell summation used in Section 3.

Each level is the literal active-pair kernel shell, and the conclusion is a
strong `L^p` estimate for the literal *full* product shell.  The only
summation step is Minkowski followed by the ordinary finite geometric series.
In particular there is no restricted-weak-type or Bourgain summation here.
The exact range is `n < j + 3`, so it remains finite in the planar critical
case `d = 2`, `γ = 1 / 2` as well. -/
theorem q4ActiveDyadicFullProduct_eLpNorm_le_of_geometric_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    (C ρ : ENNReal)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤ C * ρ ^ n) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤ C * (1 - ρ)⁻¹ := by
  let F : ℕ → X × {i // i ∈ activeDyadicIndices E j} → ℂ := fun n =>
    q4FiniteProductKernelShell μ (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν =
        eLpNorm (fun z => ∑ n ∈ Finset.range (j + 3), F n z) q ν := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      exact q4FiniteProductKernelShell_activeDyadic_eq_sum_gapLevels
          hj hE μ K g z
    _ ≤ C * (1 - ρ)⁻¹ :=
      eLpNorm_sum_range_le_geometric ν q hq F
        (fun n => by simpa only [F] using hmeas n)
        C ρ (fun n => by simpa only [F] using hlevel n) (j + 3)

/-- Operator-norm form of the preceding finite-product geometric summation.
At the strict `Q4` exponents take `p = q'`; the per-level estimates supplied
by literal `L¹ → L∞`/`L² → L²` interpolation then give the displayed strong
`L^{q'} → L^q` bound for the full active radius family. -/
theorem q4ActiveDyadicFullProduct_strong_le_of_geometric_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {p q : ENNReal} (hq : 1 ≤ q)
    (C ρ : ENNReal)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
          C * ρ ^ n * eLpNorm g p ν) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      (C * (1 - ρ)⁻¹) * eLpNorm g p ν := by
  have hsum := q4ActiveDyadicFullProduct_eLpNorm_le_of_geometric_level_bounds
    hj hE μ ν K g hq (C * eLpNorm g p ν) ρ hmeas
    (fun n => by
      simpa only [mul_assoc, mul_left_comm, mul_comm] using hlevel n)
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
        (C * eLpNorm g p ν) * (1 - ρ)⁻¹ := hsum
    _ = (C * (1 - ρ)⁻¹) * eLpNorm g p ν := by
      ac_rfl

/-- Reassembly of a literal Q4 level normal form in the ordinary
strict-gap regime.  The hypothesis is the exponential coefficient obtained
after inserting the physical pair-kernel, Fourier multiplier, and
upper-spectrum counting estimates into the crossed shell calculation.  This
lemma performs only the exact finite level reassembly: it separates the
frequency factor from the gap ratio and invokes ordinary Minkowski/geometric
summation. -/
theorem q4ActiveDyadicFullProduct_eLpNorm_le_of_strict_exponential_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    {d : ℕ} {gamma eta C theta : ℝ} (hC : 0 ≤ C)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
        ENNReal.ofReal (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ) +
            q4GapExponent d gamma theta * (n : ℝ)))) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      ENNReal.ofReal
        (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ))) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^
          q4GapExponent d gamma theta))⁻¹ := by
  let a : ℝ := q4FrequencyExponentWithSubpowerLoss d theta eta
  let b : ℝ := q4GapExponent d gamma theta
  let Cj : ENNReal := ENNReal.ofReal (C * (2 : ℝ) ^ (a * (j : ℝ)))
  let rho : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ b)
  have hr : 0 ≤ (2 : ℝ) ^ b := Real.rpow_nonneg (by norm_num) _
  have hlevel' : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤ Cj * rho ^ n := by
    intro n
    calc
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
          ENNReal.ofReal (C * (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ) +
              q4GapExponent d gamma theta * (n : ℝ))) := hlevel n
      _ = Cj * rho ^ n := by
        have hCj : 0 ≤ C * (2 : ℝ) ^ (a * (j : ℝ)) :=
          mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
        change ENNReal.ofReal (C * (2 : ℝ) ^
          (a * (j : ℝ) + b * (n : ℝ))) =
            ENNReal.ofReal (C * (2 : ℝ) ^ (a * (j : ℝ))) *
              (ENNReal.ofReal ((2 : ℝ) ^ b)) ^ n
        rw [← ENNReal.ofReal_pow hr n, ← ENNReal.ofReal_mul hCj]
        congr 1
        rw [← Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) b n, mul_assoc,
          ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  have hsum := q4ActiveDyadicFullProduct_eLpNorm_le_of_geometric_level_bounds
    hj hE μ ν K g hq Cj rho hmeas hlevel'
  simpa only [a, b, Cj, rho] using hsum

/-- The finite-range planar-critical reassembly.  This is the `d = 2`,
`gamma = 1/2` alternative to the ordinary decreasing-gap geometric series:
the actual active relation has exactly `n < j + 3`, and the *increasing*
gap progression is summed at its last level.  The resulting dyadic base is
strictly below one as soon as `theta > 1/2`.

The conclusion is for the literal full finite-product kernel on the concrete
active radius subtype; no selected positive majorant is inserted. -/
theorem q4ActiveDyadicFullProduct_eLpNorm_le_of_planar_critical_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    {theta C : ℝ} (htheta : 1 / 2 < theta) (hC : 0 ≤ C)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
        ENNReal.ofReal (C * (2 : ℝ) ^
          (q4FrequencyExponent 2 theta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ)))) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      ENNReal.ofReal
        (C * (((2 : ℝ) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : ℝ) ^ (theta - 1 / 2) - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 - theta))) ^ j := by
  let F : ℕ → X × {i // i ∈ activeDyadicIndices E j} → ℂ := fun n =>
    q4FiniteProductKernelShell μ (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g
  let b : ℝ := theta - 1 / 2
  let r : ℝ := (2 : ℝ) ^ (1 / 2 - theta)
  let D : ℝ := ((2 : ℝ) ^ b) ^ 3 / ((2 : ℝ) ^ b - 1)
