    D T hTnonneg hTsub hq (B0 ^ q0) (B1 ^ q1)
    (fun g => (eLpNorm (eval g) (ENNReal.ofReal p0) mu) ^ q0)
    (fun g => (eLpNorm (eval g) (ENNReal.ofReal p1) mu) ^ q1)
    hweak0 hweak1 f hTf low high hlow_mem hhigh_mem hsplit
    hlowI_meas hhighI_meas A0 A1 hhigh_tail hlow_tail

/-- Convert a nonnegative output moment bound into the associated extended
`L^q` norm bound. -/
theorem eLpNorm_le_of_nonnegative_moment
    {beta F : Type*} [MeasurableSpace beta] {nu : Measure beta}
    (T : F → beta → Real) (f : F) {q : Real} (hq : 0 < q)
    (hTnonneg : ∀ x, 0 ≤ T f x) (M : ENNReal)
    (hmoment : (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂nu) ≤ M) :
    eLpNorm (T f) (ENNReal.ofReal q) nu ≤ M ^ q⁻¹ := by
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq
  have hqET : ENNReal.ofReal q ≠ ∞ := ENNReal.ofReal_ne_top
  have hqinv : (1 : Real) / q = q⁻¹ := by field_simp
  have hmoment' : (∫⁻ x, ‖T f x‖ₑ ^ q ∂nu) ≤ M := by
    calc
      (∫⁻ x, ‖T f x‖ₑ ^ q ∂nu) =
          ∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂nu := by
            apply lintegral_congr
            intro x
            rw [Real.enorm_eq_ofReal (hTnonneg x),
              ENNReal.ofReal_rpow_of_nonneg (hTnonneg x) hq.le]
      _ ≤ M := hmoment
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hqE0 hqET,
    ENNReal.toReal_ofReal hq.le, hqinv]
  exact ENNReal.rpow_le_rpow hmoment' (by positivity)

/-- A finite nonnegative source--output moment bound gives both `MemLp` and
the corresponding `eLpNorm` estimate on the output space. -/
theorem memLp_and_eLpNorm_of_twoPair_moment_le
    {beta F : Type*} [MeasurableSpace beta] {nu : Measure beta}
    (T : F → beta → Real) (f : F) {q : Real} (hq : 0 < q)
    (hTnonneg : ∀ x, 0 ≤ T f x) (hTf : AEMeasurable (T f) nu)
    (M : ENNReal) (hMtop : M < ⊤)
    (hmoment : (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂nu) ≤ M) :
    MemLp (T f) (ENNReal.ofReal q) nu ∧
      eLpNorm (T f) (ENNReal.ofReal q) nu ≤ M ^ q⁻¹ := by
  constructor
  · exact memLp_of_lintegral_ofReal_rpow_lt_top (T f) hTf hTnonneg hq
      (lt_of_le_of_lt hmoment hMtop)
  · exact eLpNorm_le_of_nonnegative_moment T f hq hTnonneg M hmoment

end

