The Minkowski argument is most transparent after the cutoff is expanded in
*absolute* frequency annuli.  This file packages that Schwartz-preserving
projection and the corresponding restricted maximal operator.  It is kept
separate from the relative-frequency decomposition used by the existing
proof of Stein's theorem.
-/

namespace Auto.Spherical.FractalDilations.AbsoluteDyadic

open Filter MeasureTheory FourierTransform Metric Set
open scoped FourierTransform

noncomputable section


/-- Every literal smooth dyadic annulus is a dilation of the annulus at
scale zero.  This is the Fourier-side scaling identity required to apply the
uniform short-interval `L¹` estimate. -/
theorem smooth_dyadic_bandpass_eq_scaled_base
    {d : ℕ} (phi psi ψj : SchwartzMap (Euclidean d) ℂ)
    (hpsi : ∀ η : Euclidean d,
      psi η = phi (((2 : ℝ) ^ (0 + 1))⁻¹ • η) -
        phi (((2 : ℝ) ^ 0)⁻¹ • η))
    (j : ℕ)
    (hψj : ∀ ξ : Euclidean d,
      ψj ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
        phi (((2 : ℝ) ^ j)⁻¹ • ξ))
    (ξ : Euclidean d) :
    ψj ξ = psi (((2 : ℝ) ^ j)⁻¹ • ξ) := by
  rw [hψj ξ, hpsi (((2 : ℝ) ^ j)⁻¹ • ξ)]
  simp only [zero_add, pow_one, pow_zero, inv_one, one_smul]
  have hscalar : (2 : ℝ)⁻¹ * ((2 : ℝ) ^ j)⁻¹ =
      ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [pow_succ, mul_inv_rev]
  have hfirst : (2 : ℝ)⁻¹ • (((2 : ℝ) ^ j)⁻¹ • ξ) =
      ((2 : ℝ) ^ (j + 1))⁻¹ • ξ := by
    calc
      (2 : ℝ)⁻¹ • (((2 : ℝ) ^ j)⁻¹ • ξ) =
          ((2 : ℝ)⁻¹ * ((2 : ℝ) ^ j)⁻¹) • ξ := smul_smul _ _ _
      _ = _ := by rw [hscalar]
  rw [hfirst]

/-- Choose, at any absolute dyadic frequency, a compact smooth annulus and a
single scale-zero annulus to which it is exactly conjugate by dilation. -/
theorem exists_smooth_absolute_dyadic_bandpass_data
    (d j : ℕ) :
    ∃ (phi psi ψj : SchwartzMap (Euclidean d) ℂ),
      (∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1) ∧
      (∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0) ∧
      (∀ ξ, ‖phi ξ‖ ≤ 1) ∧
      (∀ η : Euclidean d,
        psi η = phi (((2 : ℝ) ^ (0 + 1))⁻¹ • η) -
          phi (((2 : ℝ) ^ 0)⁻¹ • η)) ∧
      (∀ ξ : Euclidean d,
        ψj ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
          phi (((2 : ℝ) ^ j)⁻¹ • ξ)) ∧
      HasCompactSupport (ψj : Euclidean d → ℂ) ∧
      (∀ ξ : Euclidean d,
        ψj ξ = psi ((Auto.Spherical.SurfaceCore.dyadicScale j)⁻¹ • ξ)) := by
  obtain ⟨phi, hphi_one, hphi_zero, hphi_norm⟩ :=
    exists_schwartz_frequency_cutoff_norm_le_one d
  obtain ⟨psi, hpsi⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  obtain ⟨ψj, hψj, hψj_compact, _⟩ :=
    exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      phi hphi_one hphi_zero j
  refine ⟨phi, psi, ψj, hphi_one, hphi_zero, hphi_norm, hpsi, hψj,
    hψj_compact, ?_⟩
  intro ξ
  simpa only [Auto.Spherical.SurfaceCore.dyadicScale] using
    smooth_dyadic_bandpass_eq_scaled_base phi psi ψj hpsi j hψj ξ

/-- The cutoff and its scale-zero annulus can be fixed once and for all;
only the compact annular representative changes with the dyadic frequency. -/
theorem exists_smooth_absolute_dyadic_bandpass_family
    (d : ℕ) :
    ∃ (phi psi : SchwartzMap (Euclidean d) ℂ),
      (∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1) ∧
      (∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0) ∧
      (∀ ξ, ‖phi ξ‖ ≤ 1) ∧
      (∀ η : Euclidean d,
        psi η = phi (((2 : ℝ) ^ (0 + 1))⁻¹ • η) -
          phi (((2 : ℝ) ^ 0)⁻¹ • η)) ∧
      ∀ j : ℕ, ∃ ψj : SchwartzMap (Euclidean d) ℂ,
        (∀ ξ : Euclidean d,
          ψj ξ = phi (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) -
            phi (((2 : ℝ) ^ j)⁻¹ • ξ)) ∧
        HasCompactSupport (ψj : Euclidean d → ℂ) ∧
        (∀ ξ : Euclidean d,
          ψj ξ = psi ((Auto.Spherical.SurfaceCore.dyadicScale j)⁻¹ • ξ)) := by
  obtain ⟨phi, hphi_one, hphi_zero, hphi_norm⟩ :=
    exists_schwartz_frequency_cutoff_norm_le_one d
  obtain ⟨psi, hpsi⟩ := exists_schwartzMap_smooth_dyadic_bandpass phi 0
  refine ⟨phi, psi, hphi_one, hphi_zero, hphi_norm, hpsi, ?_⟩
  intro j
  obtain ⟨ψj, hψj, hψj_compact, _⟩ :=
    exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      phi hphi_one hphi_zero j
  refine ⟨ψj, hψj, hψj_compact, ?_⟩
  intro ξ
  simpa only [Auto.Spherical.SurfaceCore.dyadicScale] using
    smooth_dyadic_bandpass_eq_scaled_base phi psi ψj hpsi j hψj ξ

/-- The absolute dyadic frequency scale is at least one. -/
theorem one_le_absolute_dyadicScale (j : ℕ) :
    1 ≤ Auto.Spherical.SurfaceCore.dyadicScale j := by
  calc
    1 = Auto.Spherical.SurfaceCore.dyadicScale 0 := by
      simp [Auto.Spherical.SurfaceCore.dyadicScale]
    _ ≤ Auto.Spherical.SurfaceCore.dyadicScale j :=
      Auto.Spherical.SurfaceCore.dyadicScale_mono (Nat.zero_le _)

/-- Positive dyadic levels have reciprocal scale strictly below one. -/
theorem inv_absolute_dyadicScale_lt_one {j : ℕ} (hj : 1 ≤ j) :
    (Auto.Spherical.SurfaceCore.dyadicScale j)⁻¹ < 1 := by
  apply inv_lt_one_of_one_lt₀
  calc
    1 < Auto.Spherical.SurfaceCore.dyadicScale 1 := by
      norm_num [Auto.Spherical.SurfaceCore.dyadicScale]
    _ ≤ Auto.Spherical.SurfaceCore.dyadicScale j :=
      Auto.Spherical.SurfaceCore.dyadicScale_mono hj

/-- Replacing a covering scale by the reciprocal frequency scale reverses
the sign in its real power exactly. -/
theorem inv_rpow_neg_eq_rpow {R α : ℝ} :
    (R⁻¹) ^ (-α) = R ^ α := by
  rw [Real.rpow_neg_eq_inv_rpow, inv_inv]

/-- The square-endpoint power at the Minkowski balancing scale `R^n`. -/
theorem minkowski_balance_two_power
    {n : ℕ} {R α p : ℝ} (hR : 0 < R) :
    ENNReal.ofReal (R ^ (α - n)) *
        (ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) =
      (ENNReal.ofReal R) ^ (α + n - n * p) := by
  have hrpow (a : ℝ) : ENNReal.ofReal (R ^ a) =
      (ENNReal.ofReal R) ^ a :=
    (ENNReal.ofReal_rpow_of_pos hR).symm
  have hR0 : ENNReal.ofReal R ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hR
  have hRT : ENNReal.ofReal R ≠ ⊤ := ENNReal.ofReal_ne_top
  rw [hrpow, hrpow, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_add _ _ hR0 hRT]
  congr 1
  ring

/-- The one-endpoint power at the same Minkowski balancing scale. -/
theorem minkowski_balance_one_power
    {n : ℕ} {R α p : ℝ} (hR : 0 < R) :
    ENNReal.ofReal (R ^ α) *
        (ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) =
      (ENNReal.ofReal R) ^ (α + n - n * p) := by
  have hrpow (a : ℝ) : ENNReal.ofReal (R ^ a) =
      (ENNReal.ofReal R) ^ a :=
    (ENNReal.ofReal_rpow_of_pos hR).symm
  have hR0 : ENNReal.ofReal R ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hR
  have hRT : ENNReal.ofReal R ≠ ⊤ := ENNReal.ofReal_ne_top
  rw [hrpow, hrpow, ← ENNReal.rpow_mul,
    ← ENNReal.rpow_add _ _ hR0 hRT]
  congr 1
  ring

/-- Collect the two interpolated endpoint contributions at the Minkowski
balancing scale.  The common power is `R^(α + n - n p)`. -/
theorem minkowski_balance_one_two
    {n : ℕ} {R α p c₁ c₂ a₁ a₂ : ℝ} (hR : 0 < R) (hp0 : 0 < p)
    (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂) (ha₁ : 0 ≤ a₁) (ha₂ : 0 ≤ a₂)
    (I : ENNReal) :
    ENNReal.ofReal p *
      (4 * ENNReal.ofReal (c₂ * R ^ (α - n)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) +
        2 * ENNReal.ofReal (c₁ * R ^ α) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I))) =
      ENNReal.ofReal (p * (4 * c₂ * a₂ + 2 * c₁ * a₁)) *
        (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
  have hbal₂ := minkowski_balance_two_power (n := n) (α := α) (p := p) hR
  have hbal₁ := minkowski_balance_one_power (n := n) (α := α) (p := p) hR
  have hterm₂ :
      4 * ENNReal.ofReal (c₂ * R ^ (α - n)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) =
        (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
          (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
    rw [ENNReal.ofReal_mul hc₂]
    calc
      4 * (ENNReal.ofReal c₂ * ENNReal.ofReal (R ^ (α - n))) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p) *
            (ENNReal.ofReal a₂ * I)) =
          (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
            (ENNReal.ofReal (R ^ (α - n)) *
              (ENNReal.ofReal (R ^ (n : ℝ))) ^ (2 - p)) * I := by ring
      _ = _ := by rw [hbal₂]
  have hterm₁ :
      2 * ENNReal.ofReal (c₁ * R ^ α) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I)) =
        (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
          (ENNReal.ofReal R) ^ (α + n - n * p) * I := by
    rw [ENNReal.ofReal_mul hc₁]
    calc
      2 * (ENNReal.ofReal c₁ * ENNReal.ofReal (R ^ α)) *
          ((ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p) *
            (ENNReal.ofReal a₁ * I)) =
          (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
            (ENNReal.ofReal (R ^ α) *
              (ENNReal.ofReal (R ^ (n : ℝ))) ^ (1 - p)) * I := by ring
      _ = _ := by rw [hbal₁]
  have hconst₂ : 4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ =
      ENNReal.ofReal (4 * c₂ * a₂) := by
    calc
      4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ =
          ENNReal.ofReal (4 : ℝ) * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ := by norm_num
      _ = ENNReal.ofReal ((4 : ℝ) * c₂) * ENNReal.ofReal a₂ := by
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
      _ = ENNReal.ofReal ((4 : ℝ) * c₂ * a₂) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg (by norm_num) hc₂)]
  have hconst₁ : 2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ =
      ENNReal.ofReal (2 * c₁ * a₁) := by
    calc
      2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ =
          ENNReal.ofReal (2 : ℝ) * ENNReal.ofReal c₁ * ENNReal.ofReal a₁ := by norm_num
      _ = ENNReal.ofReal ((2 : ℝ) * c₁) * ENNReal.ofReal a₁ := by
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 2)]
      _ = ENNReal.ofReal ((2 : ℝ) * c₁ * a₁) := by
        rw [← ENNReal.ofReal_mul (mul_nonneg (by norm_num) hc₁)]
  have hcoeff : ENNReal.ofReal p *
      (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ +
        2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) =
      ENNReal.ofReal (p * (4 * c₂ * a₂ + 2 * c₁ * a₁)) := by
    rw [hconst₂, hconst₁]
    rw [← ENNReal.ofReal_add
      (mul_nonneg (mul_nonneg (by norm_num) hc₂) ha₂)
      (mul_nonneg (mul_nonneg (by norm_num) hc₁) ha₁)]
    rw [← ENNReal.ofReal_mul hp0.le]
  rw [hterm₂, hterm₁]
  calc
    ENNReal.ofReal p *
        ((4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂) *
            (ENNReal.ofReal R) ^ (α + n - n * p) * I +
          (2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁) *
            (ENNReal.ofReal R) ^ (α + n - n * p) * I) =
        (ENNReal.ofReal p *
          (4 * ENNReal.ofReal c₂ * ENNReal.ofReal a₂ +
            2 * ENNReal.ofReal c₁ * ENNReal.ofReal a₁)) *
          (ENNReal.ofReal R) ^ (α + n - n * p) * I := by ring
    _ = _ := by rw [hcoeff]
theorem fractalDyadicBandpassMaximal_add_le
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Ioi (0 : ℝ))
    (ψ f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalDyadicBandpassMaximal d E ψ (f + g) x ≤
      fractalDyadicBandpassMaximal d E ψ f x +
        fractalDyadicBandpassMaximal d E ψ g x := by
  unfold fractalDyadicBandpassMaximal
  rw [dyadicBandpassProjection_add]
  exact fractalSphericalMaximalReal_schwartz_add_le hd E hE _ _ x

theorem unnormalizedFractalDyadicBandpassMaximal_add_le
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Ioi (0 : ℝ))
    (ψ f g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    unnormalizedFractalDyadicBandpassMaximal d E ψ (f + g) x ≤
      unnormalizedFractalDyadicBandpassMaximal d E ψ f x +
        unnormalizedFractalDyadicBandpassMaximal d E ψ g x := by
  unfold unnormalizedFractalDyadicBandpassMaximal
  calc
    surfaceMass d * fractalDyadicBandpassMaximal d E ψ (f + g) x ≤
        surfaceMass d * (fractalDyadicBandpassMaximal d E ψ f x +
          fractalDyadicBandpassMaximal d E ψ g x) :=
      mul_le_mul_of_nonneg_left
        (fractalDyadicBandpassMaximal_add_le hd E hE ψ f g x)
        ENNReal.toReal_nonneg
    _ = _ := by ring


/-- The local `L¹` estimate from `SmoothDyadicIntervalL1`, expressed through
the absolute projection used in this file. -/
theorem sphericalIntervalMaximalRaw_memLp_one_of_scaled
    {d : ℕ} (hd : 0 < d)
    (ψ ψj f : SchwartzMap (Euclidean d) ℂ)
    {R a b : ℝ} (hR : 0 < R) (hab : a ≤ b)
    (hψj : ∀ ξ : Euclidean d, ψj ξ = ψ (R⁻¹ • ξ)) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f)) 1 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) x‖) ≤
        surfaceMass d *
          ((∫ x : Euclidean d, ‖f x‖) *
            (∫ x : Euclidean d, ‖(𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) x‖) +
            (b - a) * R * (∫ x : Euclidean d, ‖f x‖) *
              (∫ x : Euclidean d,
                ‖fderiv ℝ ((𝓕⁻ ψ : SchwartzMap (Euclidean d) ℂ) :
                  Euclidean d → ℂ) x‖)) := by
  have hproj (x : Euclidean d) :
      dyadicBandpassProjection ψj f x =
        𝓕⁻ (fun ξ : Euclidean d => ψ (R⁻¹ • ξ) *
          𝓕 (f : Euclidean d → ℂ) ξ) x := by
    rw [dyadicBandpassProjection_apply]
    apply congrArg (fun h : Euclidean d → ℂ => 𝓕⁻ h x)
    funext ξ
    rw [hψj ξ]
  have hfunc : sphericalIntervalMaximalRaw a b (dyadicBandpassProjection ψj f) =
      fun x : Euclidean d =>
        (⨆ r : Icc a b, ENNReal.ofReal ‖sphericalAverage d
          (𝓕⁻ (fun ξ : Euclidean d => ψ (R⁻¹ • ξ) *
            𝓕 (f : Euclidean d → ℂ) ξ)) r.1 x‖).toReal := by
    funext x
    unfold sphericalIntervalMaximalRaw
    congr 1
    apply iSup_congr
    intro r
    congr 2
    apply congrArg (fun g : Euclidean d → ℂ =>
      sphericalAverage d g r.1 x)
    funext y
    exact hproj y
  have hlocal := scaled_schwartz_sphericalInterval_memLp_one hd ψ f hR hab
  rw [hfunc]
  exact hlocal

/-- The sharp local `L²` estimate from `SmoothDyadicIntervalL2`, expressed
through `dyadicBandpassProjection`. -/
theorem sphericalIntervalMaximalRaw_memLp_two_of_sharp
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (n + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((n : ℝ) / 2 - 1))
    (phi f psi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : ℝ) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : Euclidean (n + 1) → ℂ))
    {a b : ℝ} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : ℝ) 2) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / (dyadicScale j) ^ ((n : ℝ) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            ((2 * C1) / (dyadicScale j) ^ ((n : ℝ) / 2 - 1)) ^ 2) *
          ∫ x : Euclidean (n + 1), ‖f x‖ ^ 2 := by
  unfold sphericalIntervalMaximalRaw
  exact smooth_dyadic_sphericalInterval_memLp_two_of_sharp_of_bandpass
    hn C0 C1 hC0 hC1 hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm
    j hpsi hpsi_compact hab hinterval

/-- The coefficient in the short-radius `L²` estimate has the full
`R^{-n}` decay once the radius interval has length at most `R^{-1}`. -/
theorem short_interval_l2_coefficient_le_frequency_decay
    {n : ℕ} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 ≤ C0) (hC1 : 0 ≤ C1)
    {R L : ℝ} (hR : 0 < R) (hRone : 1 ≤ R)
    (hL : 0 ≤ L) (hLR : L ≤ R⁻¹) :
    2 * ((2 * C0) / R ^ ((n : ℝ) / 2)) ^ 2 +
        2 * L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
      (8 * C0 ^ 2 + 8 * C1 ^ 2) * R ^ (-(n : ℝ)) := by
  have hR0 : 0 ≤ R := hR.le
  have hinv : 0 ≤ R⁻¹ := inv_nonneg.mpr hR0
  have hpow0 (e : ℝ) : 0 ≤ R ^ e := Real.rpow_nonneg hR0 e
  have hLsq : L ^ 2 ≤ (R⁻¹) ^ 2 :=
    (sq_le_sq₀ hL hinv).2 hLR
  have hfirst :
      ((2 * C0) / R ^ ((n : ℝ) / 2)) ^ 2 =
        (2 * C0) ^ 2 * R ^ (-(n : ℝ)) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg hR0, mul_pow]
    congr 1
    rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
    congr 1
    ring
  have hsecond_eq :
      (R⁻¹) ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 =
        (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
    have hinvsq : (R⁻¹) ^ 2 = R ^ (-2 : ℝ) := by
      rw [show R⁻¹ = R ^ (-1 : ℝ) by rw [Real.rpow_neg_one]]
      rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
      congr 1
      norm_num
    rw [hinvsq]
    calc
      R ^ (-2 : ℝ) * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 =
          R ^ (-2 : ℝ) *
            ((2 * C1) ^ 2 * R ^ (-(((n : ℝ) / 2 - 1) * 2)) ) := by
            congr 1
            rw [div_eq_mul_inv, ← Real.rpow_neg hR0, mul_pow]
            congr 1
            rw [← Real.rpow_natCast, ← Real.rpow_mul hR0]
            congr 1
            ring
      _ = (2 * C1) ^ 2 *
            (R ^ (-2 : ℝ) * R ^ (-(((n : ℝ) / 2 - 1) * 2))) := by ring
      _ = (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
        rw [← Real.rpow_add hR]
        congr 1
        ring
  have hsecond :
      L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
        (2 * C1) ^ 2 * R ^ (-(n : ℝ)) := by
    calc
      L ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 ≤
          (R⁻¹) ^ 2 * ((2 * C1) / R ^ ((n : ℝ) / 2 - 1)) ^ 2 :=
        mul_le_mul_of_nonneg_right hLsq (sq_nonneg _)
      _ = _ := hsecond_eq
  rw [hfirst]
  have hbase0 : 0 ≤ R ^ (-(n : ℝ)) := hpow0 _
  have hC0sq : 0 ≤ (2 * C0) ^ 2 := sq_nonneg _
  have hC1sq : 0 ≤ (2 * C1) ^ 2 := sq_nonneg _
  nlinarith

