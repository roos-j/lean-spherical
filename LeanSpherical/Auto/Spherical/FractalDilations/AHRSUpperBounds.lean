  by_cases htop : X = ⊤
  · subst htop
    rw [ENNReal.top_rpow_of_pos hlam0, ENNReal.top_rpow_of_pos hmu]
    simp
  · rw [← ENNReal.rpow_add _ _ hzero htop]
    simpa using ENNReal.rpow_one X

