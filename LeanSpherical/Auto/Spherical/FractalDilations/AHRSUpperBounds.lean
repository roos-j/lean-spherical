  refine ⟨⟨hTmeas j f, lt_of_le_of_lt hle ?_⟩, hle⟩
  apply ENNReal.mul_lt_top _ hXtop
  apply ENNReal.mul_lt_top
  · exact ENNReal.mul_lt_top
