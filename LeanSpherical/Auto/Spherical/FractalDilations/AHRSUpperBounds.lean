/-- Strong bounds pass to a smaller set of radii.  This is the formal bridge
which lets the fractal development reuse any already established maximal
estimate without changing the existing Stein theorem. -/
theorem HasFractalSphericalStrongType.mono_radii
    {d : ℕ} {E F : Set ℝ} {p q : ℝ} (hd : 0 < d)
    (hEF : E ⊆ F) (hFpos : F ⊆ Ioi (0 : ℝ))
    (hF : HasFractalSphericalStrongType d F p q) :
    HasFractalSphericalStrongType d E p q := by
  obtain ⟨C, hC, hbound⟩ := hF
  refine ⟨C, hC, fun f => ?_⟩
  obtain ⟨hmem, hnorm⟩ := hbound f
  have hpoint (x : Euclidean d) :
      fractalSphericalMaximalReal d E f x ≤ fractalSphericalMaximalReal d F f x :=
    fractalSphericalMaximalReal_mono hd hEF hFpos f x
  have hE_nonneg (x : Euclidean d) : 0 ≤ fractalSphericalMaximalReal d E f x := by
    unfold fractalSphericalMaximalReal
    exact ENNReal.toReal_nonneg
  have hF_nonneg (x : Euclidean d) : 0 ≤ fractalSphericalMaximalReal d F f x := by
    unfold fractalSphericalMaximalReal
    exact ENNReal.toReal_nonneg
  have hmemE : MemLp (fractalSphericalMaximalReal d E f) (ENNReal.ofReal q) volume :=
    hmem.mono
      (measurable_fractalSphericalMaximalReal E f).aestronglyMeasurable
      (Filter.Eventually.of_forall fun x => by
        calc
          ‖fractalSphericalMaximalReal d E f x‖ =
              fractalSphericalMaximalReal d E f x := Real.norm_of_nonneg (hE_nonneg x)
          _ ≤ fractalSphericalMaximalReal d F f x := hpoint x
          _ = ‖fractalSphericalMaximalReal d F f x‖ :=
            (Real.norm_of_nonneg (hF_nonneg x)).symm)
  refine ⟨hmemE, (eLpNorm_mono fun x => ?_).trans hnorm⟩
  calc
    ‖fractalSphericalMaximalReal d E f x‖ =
        fractalSphericalMaximalReal d E f x := Real.norm_of_nonneg (hE_nonneg x)
    _ ≤ fractalSphericalMaximalReal d F f x := hpoint x
    _ = ‖fractalSphericalMaximalReal d F f x‖ :=
      (Real.norm_of_nonneg (hF_nonneg x)).symm

end
end Auto.Spherical.FractalDilations.Definitions
end Former_DefinitionsMono

