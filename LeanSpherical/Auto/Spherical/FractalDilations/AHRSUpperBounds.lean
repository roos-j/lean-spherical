/-- Source--output strong-endpoint form of the two-pair calculation.  The
two endpoint bounds may have unrelated input and output measure spaces; the
only common datum is the additive input carrier. -/
theorem two_pair_marcinkiewicz_moment_of_strong_endpoints_and_split_tails
    {alpha beta E F : Type*} [MeasurableSpace alpha] [MeasurableSpace beta]
    [NormedAddCommGroup E] [Add F]
    {mu : Measure alpha} {nu : Measure beta} [SFinite mu] [SFinite nu]
    (D : Set F) (eval : F → alpha → E) (T : F → beta → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, g ∈ D → AEStronglyMeasurable (T g) nu)
    {p0 p1 q0 q q1 : Real}
    (hq0 : 0 < q0) (hq1 : 0 < q1) (hq : 0 < q)
    (B0 B1 : ENNReal)
    (hstrong0 : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q0) nu ≤
        B0 * eLpNorm (eval g) (ENNReal.ofReal p0) mu)
    (hstrong1 : ∀ g, g ∈ D →
      eLpNorm (T g) (ENNReal.ofReal q1) nu ≤
        B1 * eLpNorm (eval g) (ENNReal.ofReal p1) mu)
    (f : F) (hTf : AEMeasurable (T f) nu)
    (low high : Real → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hlowI_meas : Measurable (fun t =>
      (eLpNorm (eval (low t)) (ENNReal.ofReal p1) mu) ^ q1))
    (hhighI_meas : Measurable (fun t =>
      (eLpNorm (eval (high t)) (ENNReal.ofReal p0) mu) ^ q0))
    (A0 A1 : ENNReal)
    (hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (high t)) (ENNReal.ofReal p0) mu) ^ q0 *
          (ENNReal.ofReal t) ^ (q - q0 - 1)) ≤ A0)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : Real),
        (eLpNorm (eval (low t)) (ENNReal.ofReal p1) mu) ^ q1 *
          (ENNReal.ofReal t) ^ (q - q1 - 1)) ≤ A1) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂nu) ≤
      twoPairMarcinkiewiczMomentCoefficient q q0 q1
        (B0 ^ q0) (B1 ^ q1) A0 A1 := by
  have hweak0 : ∀ g, g ∈ D → ∀ ⦃s : Real⦄, 0 < s →
