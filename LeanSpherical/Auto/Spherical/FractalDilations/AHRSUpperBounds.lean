          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) +
        A0 * (ENNReal.ofReal ((4 : Real) ^ ((p - r0) / r0)) *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :=
      add_le_add (mul_le_mul_right hlowNorm _) (mul_le_mul_right hhighNorm _)
