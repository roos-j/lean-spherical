            rw [ENNReal.ofReal_rpow_of_pos hs]
            ac_rfl
      _ ≤ (B1 * eLpNorm (eval g) (ENNReal.ofReal p1) mu) ^ q1 := hcheb
      _ = B1 ^ q1 *
          (eLpNorm (eval g) (ENNReal.ofReal p1) mu) ^ q1 := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq1.le]
