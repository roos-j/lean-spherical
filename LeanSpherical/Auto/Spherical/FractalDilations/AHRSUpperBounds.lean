    q4ScaledNormalizedDyadicSurfaceRadiusDerivativeL2Piece
      psi hpsiCompact j (dyadicLeft j i + u)
  let Tstar : Int -> Lp Complex 2 (volume : Measure (Euclidean d)) →L[Complex]
