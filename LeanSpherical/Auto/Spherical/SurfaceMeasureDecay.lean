    _ = g b * (Q b * E b) - g a * (Q a * E a) -
        (∫ t in a..b, g' t * Q t * E t) -
        ∫ t in a..b, g t * Q' t * E t := by
      have hgv : (∫ t in a..b, g' t * (Q t * E t)) =
          ∫ t in a..b, g' t * Q t * E t := by
        apply intervalIntegral.integral_congr
        intro t ht
        ring
      rw [hgv]
    _ = _ := by
      dsimp [Q, Q', E]
      ring

private theorem intervalIntegral_inv_sq_pos {a b : ℝ} (ha : 0 < a) (hab : a ≤ b) :
    (∫ t in a..b, (t ^ 2)⁻¹) = a⁻¹ - b⁻¹ := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hcont : ContinuousOn (fun x : ℝ => (x ^ 2)⁻¹) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hderiv : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (-(fun y : ℝ => y⁻¹)) ((x ^ 2)⁻¹) x := by
    intro x hx
    simpa using (hasDerivAt_inv (ne_of_gt (hpos x hx))).neg
  have h := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := fun _ : ℝ => (1 : ℝ)) (u' := fun _ : ℝ => (0 : ℝ))
    (v := -(fun y : ℝ => y⁻¹)) (v' := fun y : ℝ => (y ^ 2)⁻¹)
    (fun _ _ => hasDerivAt_const _ (1 : ℝ)) hderiv
    (Continuous.intervalIntegrable (by fun_prop) a b)
    hcont.intervalIntegrable
  simp only [one_mul, Pi.neg_apply, zero_mul, intervalIntegral.integral_zero, sub_zero] at h
  calc
    (∫ t in a..b, (t ^ 2)⁻¹) = -b⁻¹ - -a⁻¹ := h
    _ = a⁻¹ - b⁻¹ := by ring

private theorem quadratic_phase_weighted_tail_norm_le
    {a b c M N : ℝ} (ha : 0 < a) (hab : a ≤ b) (hb : b ≤ 1) (hc : 0 < c)
    (hM : 0 ≤ M) (hN : 0 ≤ N) (g g' : ℝ → ℂ)
    (hg : ∀ x ∈ Set.uIcc a b, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a b))
    (hg_bound : ∀ x ∈ Set.uIcc a b, ‖g x‖ ≤ M)
    (hg'_bound : ∀ x ∈ Set.uIcc a b, ‖g' x‖ ≤ N) :
    ‖∫ t in a..b, g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
      (3 * M + N) / (2 * c * a) := by
  have hpos : ∀ x ∈ Set.uIcc a b, 0 < x := by
    intro x hx
    have hx' : x ∈ Set.Icc a b := by
      simpa [Set.uIcc_of_le hab] using hx
    exact lt_of_lt_of_le ha hx'.1
  have hca : 0 < 2 * c * a := by positivity
  have hbpos : 0 < b := lt_of_lt_of_le ha hab
  have hcb : 0 < 2 * c * b := by positivity
  have htwoc : 0 < 2 * c := by positivity
  have hbase_ne : ∀ x ∈ Set.uIcc a b,
      ((2 * c * x : ℝ) : ℂ) * Complex.I ≠ 0 := by
    intro x hx
    have hx0 : x ≠ 0 := ne_of_gt (hpos x hx)
    have hcx : (2 * c * x : ℝ) ≠ 0 :=
      mul_ne_zero (mul_ne_zero (by norm_num) hc.ne') hx0
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr hcx) Complex.I_ne_zero
  have hQnorm : ∀ x ∈ Set.uIcc a b,
      ‖(((2 * c * x : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * x ^ 2 : ℝ) : ℂ) * Complex.I)‖ = (2 * c * x)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_inv, norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_pos (mul_pos (mul_pos (by norm_num) hc) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
  have hQ'norm : ∀ x ∈ Set.uIcc a b,
      ‖(-(((2 * c : ℝ) : ℂ) * Complex.I) /
          ((((2 * c * x : ℝ) : ℂ) * Complex.I) ^ 2)) *
          Complex.exp (((c * x ^ 2 : ℝ) : ℂ) * Complex.I)‖ =
        (2 * c)⁻¹ * (x ^ 2)⁻¹ := by
    intro x hx
    rw [norm_mul, norm_div, norm_neg, norm_mul, norm_pow, norm_mul,
      Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs,
      abs_of_pos (mul_pos (by norm_num) hc),
      abs_of_pos (mul_pos (mul_pos (by norm_num) hc) (hpos x hx)),
      Complex.norm_exp_ofReal_mul_I]
    simp [Complex.norm_I]
    field_simp
  have hgintegrable : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hQcont : ContinuousOn
      (fun t : ℝ => (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹) (Set.uIcc a b) := by
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn (fun t : ℝ =>
      -(((2 * c : ℝ) : ℂ) * Complex.I) /
        ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) (Set.uIcc a b) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn
      (fun t : ℝ => Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.uIcc a b) := by
    fun_prop
  have hendpoint_a :
      ‖g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ M / (2 * c * a) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm a Set.left_mem_uIcc]
    simpa [div_eq_mul_inv] using
      mul_le_mul_of_nonneg_right (hg_bound a Set.left_mem_uIcc) (inv_nonneg.mpr hca.le)
  have hendpoint_b :
      ‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ M / (2 * c * a) := by
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm b Set.right_mem_uIcc]
    calc
      ‖g b‖ * (2 * c * b)⁻¹ ≤ M * (2 * c * b)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg_bound b Set.right_mem_uIcc) (inv_nonneg.mpr hcb.le)
      _ ≤ M * (2 * c * a)⁻¹ :=
        mul_le_mul_of_nonneg_left (inv_anti₀ hca (by gcongr)) hM
      _ = M / (2 * c * a) := by rw [div_eq_mul_inv]
  have hg'point : ∀ x ∈ Set.Icc a b,
      ‖g' x * (((2 * c * x : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * x ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        N * (2 * c * a)⁻¹ := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by simpa [Set.uIcc_of_le hab] using hx
    have hscale : 2 * c * a ≤ 2 * c * x := by
      nlinarith [htwoc, hx.1]
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQnorm x hx']
    calc
      ‖g' x‖ * (2 * c * x)⁻¹ ≤ N * (2 * c * x)⁻¹ :=
        mul_le_mul_of_nonneg_right (hg'_bound x hx')
          (inv_nonneg.mpr (mul_pos (mul_pos (by norm_num) hc) (hpos x hx')).le)
      _ ≤ N * (2 * c * a)⁻¹ :=
        mul_le_mul_of_nonneg_left (inv_anti₀ hca hscale) hN
  have hg'integrable : IntervalIntegrable
      (fun t : ℝ => ‖g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
        Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖) volume a b :=
    ((hg'cont.mul hQcont).mul hEcont).norm.intervalIntegrable
  have hconst_integrable : IntervalIntegrable (fun _ : ℝ => N * (2 * c * a)⁻¹)
      volume a b := Continuous.intervalIntegrable (by fun_prop) a b
  have hg'bound :
      ‖∫ t in a..b,
        g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        N / (2 * c * a) := by
    calc
      ‖∫ t in a..b,
        g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ _ in a..b, N * (2 * c * a)⁻¹ :=
        intervalIntegral.integral_mono_on hab hg'integrable hconst_integrable hg'point
      _ = (b - a) * (N * (2 * c * a)⁻¹) := by
        rw [intervalIntegral.integral_const, smul_eq_mul]
      _ ≤ N * (2 * c * a)⁻¹ := by
        have hlength : 0 ≤ b - a := sub_nonneg.mpr hab
        have hlength_one : b - a ≤ 1 := by linarith
        nlinarith [mul_nonneg hN (inv_nonneg.mpr hca.le)]
      _ = N / (2 * c * a) := by rw [div_eq_mul_inv]
  have hgremainder_point : ∀ x ∈ Set.Icc a b,
      ‖g x *
          (-(((2 * c : ℝ) : ℂ) * Complex.I) /
            ((((2 * c * x : ℝ) : ℂ) * Complex.I) ^ 2)) *
            Complex.exp (((c * x ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        M * ((2 * c)⁻¹ * (x ^ 2)⁻¹) := by
    intro x hx
    have hx' : x ∈ Set.uIcc a b := by simpa [Set.uIcc_of_le hab] using hx
    conv_lhs => rw [mul_assoc]
    rw [norm_mul, hQ'norm x hx']
    exact mul_le_mul_of_nonneg_right (hg_bound x hx')
      (mul_nonneg (inv_nonneg.mpr htwoc.le) (inv_nonneg.mpr (sq_nonneg x)))
  have hgremainder_integrable : IntervalIntegrable (fun t : ℝ =>
      ‖g t *
        (-(((2 * c : ℝ) : ℂ) * Complex.I) /
          ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
          Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖) volume a b :=
    ((hgintegrable.mul hQ'cont).mul hEcont).norm.intervalIntegrable
  have hinvsq_cont : ContinuousOn (fun t : ℝ => (t ^ 2)⁻¹) (Set.uIcc a b) := by
    refine (continuous_id.pow 2).continuousOn.inv₀ ?_
    intro x hx
    exact pow_ne_zero 2 (ne_of_gt (hpos x hx))
  have hinvsq_integrable : IntervalIntegrable
      (fun t : ℝ => M * ((2 * c)⁻¹ * (t ^ 2)⁻¹)) volume a b :=
    by
      have hh : ContinuousOn (fun t : ℝ => (M * (2 * c)⁻¹) * (t ^ 2)⁻¹)
          (Set.uIcc a b) := continuousOn_const.mul hinvsq_cont
      have hh' : ContinuousOn (fun t : ℝ => M * ((2 * c)⁻¹ * (t ^ 2)⁻¹))
          (Set.uIcc a b) := by
        convert hh using 1
        ext t
        ring
      exact hh'.intervalIntegrable
  have hgremainder_bound :
      ‖∫ t in a..b,
        g t *
          (-(((2 * c : ℝ) : ℂ) * Complex.I) /
            ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
            Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        M / (2 * c * a) := by
    calc
      ‖∫ t in a..b,
        g t *
          (-(((2 * c : ℝ) : ℂ) * Complex.I) /
            ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
            Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
          ∫ t in a..b,
            ‖g t *
              (-(((2 * c : ℝ) : ℂ) * Complex.I) /
                ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
                Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm hab
      _ ≤ ∫ t in a..b, M * ((2 * c)⁻¹ * (t ^ 2)⁻¹) :=
        intervalIntegral.integral_mono_on hab hgremainder_integrable hinvsq_integrable
          hgremainder_point
      _ = M * (2 * c)⁻¹ * (a⁻¹ - b⁻¹) := by
        have hfactor : (fun t : ℝ => M * ((2 * c)⁻¹ * (t ^ 2)⁻¹)) =
            fun t => (M * (2 * c)⁻¹) * (t ^ 2)⁻¹ := by
          funext t
          ring
        rw [hfactor, intervalIntegral.integral_const_mul,
          intervalIntegral_inv_sq_pos ha hab]
      _ ≤ M * (2 * c)⁻¹ * a⁻¹ := by
        have hsub : a⁻¹ - b⁻¹ ≤ a⁻¹ := sub_le_self _ (inv_nonneg.mpr (by positivity))
        exact mul_le_mul_of_nonneg_left hsub
          (mul_nonneg hM (inv_nonneg.mpr htwoc.le))
      _ = M / (2 * c * a) := by
        field_simp
  have hid := quadratic_phase_weighted_integration_by_parts ha hab hc.ne' g g' hg hg'cont
  rw [hid]
  calc
    ‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I) -
        g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I) -
        (∫ t in a..b,
          g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
            Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)) -
        ∫ t in a..b,
          g t *
            (-(((2 * c : ℝ) : ℂ) * Complex.I) /
              ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        ‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
        ‖g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
        ‖∫ t in a..b,
          g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
            Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
        ‖∫ t in a..b,
          g t *
            (-(((2 * c : ℝ) : ℂ) * Complex.I) /
              ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ := by
      calc
        _ ≤ ‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I) -
          g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
            Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I) -
          (∫ t in a..b,
            g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))‖ +
          ‖∫ t in a..b,
            g t *
              (-(((2 * c : ℝ) : ℂ) * Complex.I) /
                ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
                Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ := norm_sub_le _ _
        _ ≤ (‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I) -
          g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
            Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
          ‖∫ t in a..b,
            g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * c : ℝ) : ℂ) * Complex.I) /
                ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
                Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ :=
          add_le_add_left (norm_sub_le _ _) _
        _ ≤ ((‖g b * (((2 * c * b : ℝ) : ℂ) * Complex.I)⁻¹ *
          Complex.exp (((c * b ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
          ‖g a * (((2 * c * a : ℝ) : ℂ) * Complex.I)⁻¹ *
            Complex.exp (((c * a ^ 2 : ℝ) : ℂ) * Complex.I)‖) +
          ‖∫ t in a..b,
            g' t * (((2 * c * t : ℝ) : ℂ) * Complex.I)⁻¹ *
              Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖) +
          ‖∫ t in a..b,
            g t *
              (-(((2 * c : ℝ) : ℂ) * Complex.I) /
                ((((2 * c * t : ℝ) : ℂ) * Complex.I) ^ 2)) *
                Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ := by
          gcongr
          exact norm_sub_le _ _
        _ = _ := by ring
    _ ≤ M / (2 * c * a) + M / (2 * c * a) +
        N / (2 * c * a) + M / (2 * c * a) := by gcongr
    _ = (3 * M + N) / (2 * c * a) := by ring

theorem quadratic_phase_weighted_unit_norm_le
    {a c M N : ℝ} (ha : 0 < a) (ha_one : a ≤ 1) (hc : 0 < c)
    (hscale : c * a ^ 2 = 1) (hM : 0 ≤ M) (hN : 0 ≤ N)
    (g g' : ℝ → ℂ) (hgcont : ContinuousOn g (Set.Icc 0 1))
    (hg : ∀ x ∈ Set.uIcc a 1, HasDerivAt g (g' x) x)
    (hg'cont : ContinuousOn g' (Set.uIcc a 1))
    (hg_bound : ∀ x ∈ Set.Icc 0 1, ‖g x‖ ≤ M)
    (hg'_bound : ∀ x ∈ Set.uIcc a 1, ‖g' x‖ ≤ N) :
    ‖∫ t in (0 : ℝ)..1,
      g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
      ((5 * M + N) / 2) * a := by
  have hphase_cont : ContinuousOn
      (fun t : ℝ => Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.Icc 0 1) := by fun_prop
  have hge_cont : ContinuousOn
      (fun t : ℝ => g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.Icc 0 1) := hgcont.mul hphase_cont
  have hge_cont' : ContinuousOn
      (fun t : ℝ => g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.uIcc 0 1) := by
    simpa [Set.uIcc_of_le] using hge_cont
  have hge_integrable : IntervalIntegrable
      (fun t : ℝ => g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      volume 0 1 := hge_cont'.intervalIntegrable
  have hge_0a_cont : ContinuousOn
      (fun t : ℝ => g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.uIcc 0 a) := by
    simpa [Set.uIcc_of_le ha.le] using
      hge_cont.mono (Set.Icc_subset_Icc le_rfl ha_one)
  have hge_a1_cont : ContinuousOn
      (fun t : ℝ => g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I))
      (Set.uIcc a 1) := by
    simpa [Set.uIcc_of_le ha_one] using
      hge_cont.mono (Set.Icc_subset_Icc (le_of_lt ha) le_rfl)
  have hsplit := intervalIntegral.integral_add_adjacent_intervals (μ := volume)
    hge_0a_cont.intervalIntegrable hge_a1_cont.intervalIntegrable
  have hnear_point : ∀ x ∈ Set.Icc 0 a,
      ‖g x * Complex.exp (((c * x ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ M := by
    intro x hx
    rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    exact hg_bound x ⟨hx.1, hx.2.trans ha_one⟩
  have hnear_integrable : IntervalIntegrable
      (fun t : ℝ => ‖g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖)
      volume 0 a := hge_0a_cont.norm.intervalIntegrable
  have hM_integrable : IntervalIntegrable (fun _ : ℝ => M) volume 0 a :=
    Continuous.intervalIntegrable (by fun_prop) 0 a
  have hnear :
      ‖∫ t in (0 : ℝ)..a,
        g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ M * a := by
    calc
      ‖∫ t in (0 : ℝ)..a,
        g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
          ∫ t in (0 : ℝ)..a,
            ‖g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ :=
        intervalIntegral.norm_integral_le_integral_norm ha.le
      _ ≤ ∫ _ in (0 : ℝ)..a, M :=
        intervalIntegral.integral_mono_on ha.le hnear_integrable hM_integrable hnear_point
      _ = a * M := by rw [intervalIntegral.integral_const, smul_eq_mul, sub_zero]
      _ = M * a := by ring
  have htail_bound : ∀ x ∈ Set.uIcc a 1, ‖g x‖ ≤ M := by
    intro x hx
    have hx' : x ∈ Set.Icc a 1 := by simpa [Set.uIcc_of_le ha_one] using hx
    exact hg_bound x ⟨le_trans (le_of_lt ha) hx'.1, hx'.2⟩
  have htail := quadratic_phase_weighted_tail_norm_le ha ha_one le_rfl hc hM hN
    g g' hg hg'cont htail_bound hg'_bound
  have htail' :
      ‖∫ t in a..1,
        g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        ((3 * M + N) / 2) * a := by
    calc
      ‖∫ t in a..1,
        g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
          (3 * M + N) / (2 * c * a) := htail
      _ = ((3 * M + N) / 2) * a := by
        have hca : c * a ≠ 0 := mul_ne_zero hc.ne' ha.ne'
        field_simp [hca]
        nlinarith [hscale]
  rw [← hsplit]
  calc
    ‖(∫ t in (0 : ℝ)..a,
      g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)) +
      ∫ t in a..1,
        g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        ‖∫ t in (0 : ℝ)..a,
          g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ +
        ‖∫ t in a..1,
          g t * Complex.exp (((c * t ^ 2 : ℝ) : ℂ) * Complex.I)‖ := norm_add_le _ _
    _ ≤ M * a + ((3 * M + N) / 2) * a := by gcongr
    _ = ((5 * M + N) / 2) * a := by ring

private theorem one_le_sqrt_two_sub_sq (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    1 ≤ Real.sqrt (2 - u ^ 2) := by
  have husq : u ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hu0 (sub_nonneg.mpr hu1)]
  rw [← Real.sqrt_one]
  gcongr
  linarith

private theorem endpoint_amplitude_hasDerivAt (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    HasDerivAt
      (fun x : ℝ => 2 * (1 - x ^ 2) / Real.sqrt (2 - x ^ 2))
      (2 * u * (u ^ 2 - 3) / Real.sqrt (2 - u ^ 2) ^ 3) u := by
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hspos : 0 < Real.sqrt (2 - u ^ 2) := lt_of_lt_of_le (by norm_num) hs
  have hargpos : 0 < 2 - u ^ 2 := by
    have := Real.sqrt_pos.1 hspos
    exact this
  have hq : HasDerivAt (fun x : ℝ => 1 - x ^ 2) (-2 * u) u := by
    convert! (hasDerivAt_pow 2 u).neg.const_add (1 : ℝ) using 1; ring
  have hsqrt : HasDerivAt (fun x : ℝ => Real.sqrt (2 - x ^ 2))
      ((-2 * u) / (2 * Real.sqrt (2 - u ^ 2))) u := by
    apply HasDerivAt.sqrt
    · convert! (hasDerivAt_pow 2 u).neg.const_add (2 : ℝ) using 1; ring
    · exact ne_of_gt hargpos
  have hnum : HasDerivAt (fun x : ℝ => 2 * (1 - x ^ 2)) (2 * (-2 * u)) u := by
    simpa using hq.const_mul 2
  have h := hnum.div hsqrt (ne_of_gt hspos)
  convert h using 1 <;> try rfl
  have hsne : Real.sqrt (2 - u ^ 2) ≠ 0 := ne_of_gt hspos
  have hargne : 2 - u ^ 2 ≠ 0 := ne_of_gt hargpos
  field_simp [hsne, hargne, Real.sq_sqrt hargpos.le]
  rw [Real.sq_sqrt hargpos.le]
  ring

private theorem endpoint_amplitude_nonneg_le_two (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    0 ≤ 2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) ∧
      2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) ≤ 2 := by
  have husq : u ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hu0 (sub_nonneg.mpr hu1)]
  have hq : 0 ≤ 1 - u ^ 2 := by linarith
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hspos : 0 < Real.sqrt (2 - u ^ 2) := lt_of_lt_of_le (by norm_num) hs
  constructor
  · exact div_nonneg (mul_nonneg (by norm_num) hq) hspos.le
  · apply (div_le_iff₀ hspos).2
    nlinarith

private theorem norm_endpoint_amplitude_le_two (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    ‖((2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ)‖ ≤ 2 := by
  rw [Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (endpoint_amplitude_nonneg_le_two u hu0 hu1).1]
  exact (endpoint_amplitude_nonneg_le_two u hu0 hu1).2

private theorem norm_endpoint_amplitude_deriv_le_six
    (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    ‖((2 * u * (u ^ 2 - 3) / Real.sqrt (2 - u ^ 2) ^ 3 : ℝ) : ℂ)‖ ≤ 6 := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_div]
  have husq : u ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hu0 (sub_nonneg.mpr hu1)]
  have hdiff : |u ^ 2 - 3| ≤ 3 := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg u]
  have hnum : |2 * u * (u ^ 2 - 3)| ≤ 6 := by
    rw [abs_mul, abs_mul, abs_of_nonneg hu0]
    norm_num
    nlinarith [mul_nonneg (sub_nonneg.mpr hu1) (sub_nonneg.mpr hdiff)]
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hden : 1 ≤ |Real.sqrt (2 - u ^ 2) ^ 3| := by
    rw [abs_of_nonneg (pow_nonneg (Real.sqrt_nonneg _) _)]
    simpa using (pow_le_pow_left₀ (by positivity) hs 3)
  have hdenpos : 0 < |Real.sqrt (2 - u ^ 2) ^ 3| := lt_of_lt_of_le (by norm_num) hden
  calc
    |2 * u * (u ^ 2 - 3)| / |Real.sqrt (2 - u ^ 2) ^ 3| ≤
        6 / |Real.sqrt (2 - u ^ 2) ^ 3| :=
      div_le_div_of_nonneg_right hnum hdenpos.le
    _ ≤ 6 := (div_le_iff₀ hdenpos).2 (by nlinarith)

private theorem arcsin_one_div_sqrt_two :
    Real.arcsin (1 / Real.sqrt 2) = Real.pi / 4 := by
  apply Real.arcsin_eq_of_sin_eq
  · rw [Real.sin_pi_div_four]
    have hspos : 0 < Real.sqrt 2 := by positivity
    field_simp [hspos.ne']
    nlinarith [Real.sq_sqrt (by norm_num : (0 : ℝ) ≤ 2)]
  · constructor <;> nlinarith [Real.pi_pos]

private theorem upper_meridian_eq_quadratic (l : ℝ) :
    (∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
        ∫ u in (0 : ℝ)..1,
          ((2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
            Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
  let φ : ℝ → ℝ := fun u => Real.pi / 2 - 2 * Real.arcsin (u / Real.sqrt 2)
  let F : ℝ → ℂ := fun θ =>
    ((Real.sin θ : ℝ) : ℂ) *
      Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)
  have hφ0 : φ 0 = Real.pi / 2 := by simp [φ]
  have hφ1 : φ 1 = 0 := by
    dsimp [φ]
    rw [arcsin_one_div_sqrt_two]
    ring
  have hφderiv : ∀ u ∈ Set.uIcc (0 : ℝ) 1,
      HasDerivAt φ (-2 / Real.sqrt (2 - u ^ 2)) u := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      simpa [Set.uIcc_of_le] using hu
    exact hasDerivAt_pi_div_two_sub_two_arcsin_div_sqrt_two hu'.1 hu'.2
  have hφ'cont : ContinuousOn (fun u : ℝ => -2 / Real.sqrt (2 - u ^ 2))
      (Set.uIcc (0 : ℝ) 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      simpa [Set.uIcc_of_le] using hu
    exact ne_of_gt (lt_of_lt_of_le (by norm_num)
      (one_le_sqrt_two_sub_sq u hu'.1 hu'.2))
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hsubst := intervalIntegral.integral_deriv_smul_comp
    (a := (0 : ℝ)) (b := (1 : ℝ)) (f := φ)
    (f' := fun u => -2 / Real.sqrt (2 - u ^ 2)) (g := F)
    hφderiv hφ'cont hF
  rw [hφ0, hφ1, intervalIntegral.integral_symm] at hsubst
  rw [intervalIntegral.integral_symm] at hsubst
  simp only [neg_neg] at hsubst
  change (∫ θ in (0 : ℝ)..(Real.pi / 2), F θ) = _
  calc
    (∫ θ in (0 : ℝ)..(Real.pi / 2), F θ) =
        -(∫ θ in (Real.pi / 2)..(0 : ℝ), F θ) := by
      rw [intervalIntegral.integral_symm]
    _ = -(∫ u in (0 : ℝ)..1,
        (-2 / Real.sqrt (2 - u ^ 2)) • (F ∘ φ) u) := by rw [← hsubst]
    _ = Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
        ∫ u in (0 : ℝ)..1,
          ((2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
            Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
      rw [← intervalIntegral.integral_neg, ← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro u hu
      have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
        simpa [Set.uIcc_of_le] using hu
      have hsin := sin_pi_div_two_sub_two_arcsin_div_sqrt_two hu'.1 hu'.2
      have hspos : 0 < Real.sqrt (2 - u ^ 2) :=
        lt_of_lt_of_le (by norm_num) (one_le_sqrt_two_sub_sq u hu'.1 hu'.2)
      have hexp :
          Complex.exp (((-l * (1 - u ^ 2) : ℝ) : ℂ) * Complex.I) =
            Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
              Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      dsimp [F, φ, Function.comp_apply]
      rw [hsin, hexp]
      push_cast
      field_simp [ne_of_gt hspos]

private theorem norm_endpoint_quadratic_integral_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ u in (0 : ℝ)..1,
      ((2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
        Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
      8 / Real.sqrt l := by
  let A : ℝ → ℂ := fun u =>
    ((2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ)
  let A' : ℝ → ℂ := fun u =>
    ((2 * u * (u ^ 2 - 3) / Real.sqrt (2 - u ^ 2) ^ 3 : ℝ) : ℂ)
  have hlpos : 0 < l := lt_of_lt_of_le (by norm_num) hl
  have hsqrtpos : 0 < Real.sqrt l := Real.sqrt_pos.2 hlpos
  have ha : 0 < 1 / Real.sqrt l := one_div_pos.mpr hsqrtpos
  have ha_one : 1 / Real.sqrt l ≤ 1 := by
    rw [div_le_iff₀ hsqrtpos]
    simpa using Real.one_le_sqrt.mpr hl
  have hscale : l * (1 / Real.sqrt l) ^ 2 = 1 := by
    have hsq : Real.sqrt l ^ 2 = l := Real.sq_sqrt hlpos.le
    field_simp [hsqrtpos.ne']
    nlinarith
  have hden_nonzero : ∀ u ∈ Set.Icc (0 : ℝ) 1,
      Real.sqrt (2 - u ^ 2) ≠ 0 := by
    intro u hu
    exact ne_of_gt (lt_of_lt_of_le (by norm_num)
      (one_le_sqrt_two_sub_sq u hu.1 hu.2))
  have hAreal_cont : ContinuousOn
      (fun u : ℝ => 2 * (1 - u ^ 2) / Real.sqrt (2 - u ^ 2))
      (Set.Icc 0 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) hden_nonzero
  have hAcont : ContinuousOn A (Set.Icc 0 1) := by
    exact Complex.continuous_ofReal.comp_continuousOn hAreal_cont
  have hA'den_nonzero : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1,
      Real.sqrt (2 - u ^ 2) ^ 3 ≠ 0 := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    exact pow_ne_zero 3 (hden_nonzero u hu')
  have hA'real_cont : ContinuousOn
      (fun u : ℝ => 2 * u * (u ^ 2 - 3) / Real.sqrt (2 - u ^ 2) ^ 3)
      (Set.uIcc (1 / Real.sqrt l) 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) hA'den_nonzero
  have hA'cont : ContinuousOn A' (Set.uIcc (1 / Real.sqrt l) 1) := by
    exact Complex.continuous_ofReal.comp_continuousOn hA'real_cont
  have hAderiv : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1,
      HasDerivAt A (A' u) u := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    dsimp [A, A']
    exact (endpoint_amplitude_hasDerivAt u hu'.1 hu'.2).ofReal_comp
  have hAbound : ∀ u ∈ Set.Icc (0 : ℝ) 1, ‖A u‖ ≤ 2 := by
    intro u hu
    dsimp [A]
    exact norm_endpoint_amplitude_le_two u hu.1 hu.2
  have hA'bound : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1, ‖A' u‖ ≤ 6 := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    dsimp [A']
    exact norm_endpoint_amplitude_deriv_le_six u hu'.1 hu'.2
  have hmodel := quadratic_phase_weighted_unit_norm_le
    (a := 1 / Real.sqrt l) (c := l) (M := 2) (N := 6)
    ha ha_one hlpos hscale (by norm_num) (by norm_num) A A'
    hAcont hAderiv hA'cont hAbound hA'bound
  change ‖∫ u in (0 : ℝ)..1,
      A u * Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ _
  calc
    ‖∫ u in (0 : ℝ)..1,
      A u * Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        ((5 * 2 + 6) / 2) * (1 / Real.sqrt l) := hmodel
    _ = 8 / Real.sqrt l := by ring

private theorem upper_meridian_plus_eq_conj (l : ℝ) :
    (∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      conj
        (∫ θ in (0 : ℝ)..(Real.pi / 2),
          ((Real.sin θ : ℝ) : ℂ) *
            Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) := by
  rw [← intervalIntegral.intervalIntegral_conj]
  apply intervalIntegral.integral_congr
  intro θ hθ
  dsimp
  rw [map_mul, ← Complex.exp_conj]
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  congr 1
  push_cast
  ring_nf

private theorem norm_upper_meridian_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)‖ ≤
      8 / Real.sqrt l := by
  rw [upper_meridian_eq_quadratic, norm_mul,
    Complex.norm_exp_ofReal_mul_I, one_mul]
  exact norm_endpoint_quadratic_integral_le l hl

private theorem lower_meridian_eq_neg_upper_plus (l : ℝ) :
    (∫ θ in (-(Real.pi / 2) : ℝ)..0,
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      -(∫ θ in (0 : ℝ)..(Real.pi / 2),
        ((Real.sin θ : ℝ) : ℂ) *
          Complex.exp (((l * Real.sin θ : ℝ) : ℂ) * Complex.I)) := by
  let F : ℝ → ℂ := fun θ =>
    ((Real.sin θ : ℝ) : ℂ) *
      Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)
  have hcomp := intervalIntegral.integral_comp_neg
    (a := (0 : ℝ)) (b := Real.pi / 2) (f := F)
  rw [neg_zero] at hcomp
  change (∫ θ in (-(Real.pi / 2) : ℝ)..0, F θ) = _
  rw [← hcomp]
  rw [← intervalIntegral.integral_neg]
  apply intervalIntegral.integral_congr
  intro θ hθ
  dsimp [F]
  rw [Real.sin_neg]
  push_cast
  ring_nf

private theorem norm_lower_meridian_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ θ in (-(Real.pi / 2) : ℝ)..0,
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)‖ ≤
      8 / Real.sqrt l := by
  rw [lower_meridian_eq_neg_upper_plus, norm_neg,
    upper_meridian_plus_eq_conj, RCLike.norm_conj]
  exact norm_upper_meridian_le l hl

private theorem norm_meridian_sin_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
      ((Real.sin θ : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)‖ ≤
      16 / Real.sqrt l := by
  let F : ℝ → ℂ := fun θ =>
    ((Real.sin θ : ℝ) : ℂ) *
      Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hsplit := intervalIntegral.integral_add_adjacent_intervals (μ := volume)
    (hF.intervalIntegrable (-(Real.pi / 2) : ℝ) 0)
    (hF.intervalIntegrable 0 (Real.pi / 2))
  have hlow : ‖∫ θ in (-(Real.pi / 2) : ℝ)..0, F θ‖ ≤ 8 / Real.sqrt l := by
    dsimp [F]
    exact norm_lower_meridian_le l hl
  have hupp : ‖∫ θ in (0 : ℝ)..(Real.pi / 2), F θ‖ ≤ 8 / Real.sqrt l := by
    dsimp [F]
    exact norm_upper_meridian_le l hl
  change ‖∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2), F θ‖ ≤ _
  rw [← hsplit]
  calc
    ‖(∫ θ in (-(Real.pi / 2) : ℝ)..0, F θ) +
        ∫ θ in (0 : ℝ)..(Real.pi / 2), F θ‖ ≤
        ‖∫ θ in (-(Real.pi / 2) : ℝ)..0, F θ‖ +
          ‖∫ θ in (0 : ℝ)..(Real.pi / 2), F θ‖ := norm_add_le _ _
    _ ≤ 8 / Real.sqrt l + 8 / Real.sqrt l := by gcongr
    _ = 16 / Real.sqrt l := by ring

/-- The Fourier transform of the semicircle density has the endpoint decay
`O(l⁻³ᐟ²)` for positive frequencies. -/
theorem norm_intervalIntegral_semicircle_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ t in (-1 : ℝ)..1,
      ((Real.sqrt (1 - t ^ 2) : ℝ) : ℂ) *
        Complex.exp (((-l * t : ℝ) : ℂ) * Complex.I)‖ ≤
      16 / (l * Real.sqrt l) := by
  have hlpos : 0 < l := lt_of_lt_of_le (by norm_num) hl
  have hsqrtpos : 0 < Real.sqrt l := Real.sqrt_pos.2 hlpos
  have hfactor : ‖((l⁻¹ : ℝ) : ℂ) * Complex.I‖ = 1 / l := by
    rw [norm_mul, Complex.norm_real,
      Real.norm_of_nonneg (inv_nonneg.mpr hlpos.le), Complex.norm_I, mul_one]
    ring
  rw [intervalIntegral_semicircle_eq_meridian,
    intervalIntegral_meridian_cos_sq_eq l hlpos.ne']
  rw [norm_mul, hfactor]
  calc
    (1 / l) *
        ‖∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.sin θ : ℝ) : ℂ) *
            Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)‖ ≤
        (1 / l) * (16 / Real.sqrt l) :=
      mul_le_mul_of_nonneg_left (norm_meridian_sin_le l hl) (by positivity)
    _ = 16 / (l * Real.sqrt l) := by
      field_simp [hlpos.ne', hsqrtpos.ne']

/-- The endpoint amplitude arising after one integration by parts in the
weighted semicircle integral has an explicit derivative. -/
private theorem endpoint_cos_two_amplitude_hasDerivAt
    (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    HasDerivAt
      (fun x : ℝ => 2 * (1 - 2 * (1 - x ^ 2) ^ 2) / Real.sqrt (2 - x ^ 2))
      (2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4) / Real.sqrt (2 - u ^ 2) ^ 3) u := by
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hspos : 0 < Real.sqrt (2 - u ^ 2) := lt_of_lt_of_le (by norm_num) hs
  have hargpos : 0 < 2 - u ^ 2 := by
    have := Real.sqrt_pos.1 hspos
    exact this
  have hv : HasDerivAt (fun x : ℝ => 1 - x ^ 2) (-2 * u) u := by
    convert! (hasDerivAt_pow 2 u).neg.const_add (1 : ℝ) using 1
    all_goals ring_nf
  have hq : HasDerivAt (fun x : ℝ => 1 - 2 * (1 - x ^ 2) ^ 2)
      (8 * u * (1 - u ^ 2)) u := by
    have hpow := hv.pow 2
    have h := (hasDerivAt_const u (1 : ℝ)).sub (HasDerivAt.const_mul (2 : ℝ) hpow)
    change HasDerivAt (fun x : ℝ => 1 - 2 * (1 - x ^ 2) ^ 2)
      (0 - 2 * (2 * (1 - u ^ 2) ^ (2 - 1) * (-2 * u))) u at h
    norm_num at h
    convert h using 1
    all_goals ring_nf
  have hsqrt : HasDerivAt (fun x : ℝ => Real.sqrt (2 - x ^ 2))
      ((-2 * u) / (2 * Real.sqrt (2 - u ^ 2))) u := by
    apply HasDerivAt.sqrt
    · convert! (hasDerivAt_pow 2 u).neg.const_add (2 : ℝ) using 1
      all_goals ring_nf
    · exact ne_of_gt hargpos
  have hnum : HasDerivAt (fun x : ℝ => 2 * (1 - 2 * (1 - x ^ 2) ^ 2))
      (2 * (8 * u * (1 - u ^ 2))) u := by
    simpa using hq.const_mul 2
  have h := hnum.div hsqrt (ne_of_gt hspos)
  convert h using 1 <;> try rfl
  have hsne : Real.sqrt (2 - u ^ 2) ≠ 0 := ne_of_gt hspos
  have hargne : 2 - u ^ 2 ≠ 0 := ne_of_gt hargpos
  field_simp [hsne, hargne, Real.sq_sqrt hargpos.le]
  rw [Real.sq_sqrt hargpos.le]
  ring

private theorem norm_endpoint_cos_two_amplitude_le_two
    (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    ‖((2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ)‖ ≤ 2 := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_div]
  have husq : u ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hu0 (sub_nonneg.mpr hu1)]
  have hq : |1 - 2 * (1 - u ^ 2) ^ 2| ≤ 1 := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg (1 - u ^ 2)]
  have hnum : |2 * (1 - 2 * (1 - u ^ 2) ^ 2)| ≤ 2 := by
    rw [abs_mul, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
    nlinarith
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hspos : 0 < |Real.sqrt (2 - u ^ 2)| := by
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    exact lt_of_lt_of_le (by norm_num) hs
  have hden : 1 ≤ |Real.sqrt (2 - u ^ 2)| := by
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    exact hs
  calc
    |2 * (1 - 2 * (1 - u ^ 2) ^ 2)| / |Real.sqrt (2 - u ^ 2)| ≤
        2 / |Real.sqrt (2 - u ^ 2)| :=
      div_le_div_of_nonneg_right hnum hspos.le
    _ ≤ 2 := (div_le_iff₀ hspos).2 (by nlinarith)

private theorem norm_endpoint_cos_two_amplitude_deriv_le_eighty_two
    (u : ℝ) (hu0 : 0 ≤ u) (hu1 : u ≤ 1) :
    ‖((2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4) /
      Real.sqrt (2 - u ^ 2) ^ 3 : ℝ) : ℂ)‖ ≤ 82 := by
  rw [Complex.norm_real, Real.norm_eq_abs, abs_div]
  have husq : u ^ 2 ≤ 1 := by
    nlinarith [mul_nonneg hu0 (sub_nonneg.mpr hu1)]
  have hu4 : u ^ 4 ≤ 1 := by nlinarith [sq_nonneg (u ^ 2 - 1)]
  have hp : |15 - 20 * u ^ 2 + 6 * u ^ 4| ≤ 41 := by
    rw [abs_le]
    constructor <;> nlinarith [sq_nonneg u, sq_nonneg (u ^ 2)]
  have hnum : |2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4)| ≤ 82 := by
    rw [abs_mul, abs_mul, abs_of_nonneg hu0]
    norm_num
    have hprod : u * |15 - 20 * u ^ 2 + 6 * u ^ 4| ≤ 1 * 41 :=
      mul_le_mul hu1 hp (abs_nonneg _) (by norm_num)
    calc
      2 * u * |15 - 20 * u ^ 2 + 6 * u ^ 4| =
          2 * (u * |15 - 20 * u ^ 2 + 6 * u ^ 4|) := by ring
      _ ≤ 2 * (1 * 41) := mul_le_mul_of_nonneg_left hprod (by norm_num)
      _ = 82 := by norm_num
  have hs : 1 ≤ Real.sqrt (2 - u ^ 2) := one_le_sqrt_two_sub_sq u hu0 hu1
  have hden : 1 ≤ |Real.sqrt (2 - u ^ 2) ^ 3| := by
    rw [abs_of_nonneg (pow_nonneg (Real.sqrt_nonneg _) _)]
    simpa using (pow_le_pow_left₀ (by positivity) hs 3)
  have hdenpos : 0 < |Real.sqrt (2 - u ^ 2) ^ 3| := lt_of_lt_of_le (by norm_num) hden
  calc
    |2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4)| /
        |Real.sqrt (2 - u ^ 2) ^ 3| ≤
        82 / |Real.sqrt (2 - u ^ 2) ^ 3| :=
      div_le_div_of_nonneg_right hnum hdenpos.le
    _ ≤ 82 := (div_le_iff₀ hdenpos).2 (by nlinarith [le_of_lt hdenpos])

private theorem intervalIntegral_meridian_sin_cos_sq_eq (l : ℝ) (hl : l ≠ 0) :
    (∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
      ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      -(((l⁻¹ : ℝ) : ℂ) * Complex.I) *
        ∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
            Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I) := by
  let E : ℝ → ℂ := fun θ =>
    Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)
  have hu : ∀ θ ∈ Set.uIcc (-(Real.pi / 2) : ℝ) (Real.pi / 2),
      HasDerivAt (fun x : ℝ => (Real.sin x : ℂ) * Real.cos x)
        ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) θ := by
    intro θ _
    have hsin : HasDerivAt (fun x : ℝ => ((Real.sin x : ℝ) : ℂ))
        ((Real.cos θ : ℝ) : ℂ) θ := (Real.hasDerivAt_sin θ).ofReal_comp
    have hcos : HasDerivAt (fun x : ℝ => ((Real.cos x : ℝ) : ℂ))
        ((-Real.sin θ : ℝ) : ℂ) θ := (Real.hasDerivAt_cos θ).ofReal_comp
    have h := hsin.mul hcos
    have hderiv :
        ((Real.cos θ : ℂ) * (Real.cos θ : ℂ) +
          (Real.sin θ : ℂ) * ((-Real.sin θ : ℝ) : ℂ)) =
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) := by
      push_cast
      ring
    rw [hderiv] at h
    exact h
  have hE : ∀ θ ∈ Set.uIcc (-(Real.pi / 2) : ℝ) (Real.pi / 2),
      HasDerivAt E (E θ * (((-l * Real.cos θ : ℝ) : ℂ) * Complex.I)) θ := by
    intro θ _
    exact hasDerivAt_meridian_phase l θ
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := fun θ : ℝ => (Real.sin θ : ℂ) * Real.cos θ)
    (u' := fun θ => ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ))
    (v := E) (v' := fun θ => E θ * (((-l * Real.cos θ : ℝ) : ℂ) * Complex.I))
    hu hE
    (Continuous.intervalIntegrable (by fun_prop)
      (-(Real.pi / 2) : ℝ) (Real.pi / 2))
    (Continuous.intervalIntegrable (by fun_prop)
      (-(Real.pi / 2) : ℝ) (Real.pi / 2))
  have hboundary :
      ((Real.sin (Real.pi / 2) : ℂ) * Real.cos (Real.pi / 2)) * E (Real.pi / 2) -
        ((Real.sin (-(Real.pi / 2)) : ℂ) * Real.cos (-(Real.pi / 2))) *
          E (-(Real.pi / 2)) = 0 := by
    rw [Real.cos_pi_div_two, Real.cos_neg, Real.cos_pi_div_two]
    simp
  rw [hboundary] at hparts
  have hparts' :
      (-l : ℂ) * Complex.I *
          (∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
            ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) * E θ) =
        -(∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) * E θ) := by
    calc
      (-l : ℂ) * Complex.I *
          (∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
            ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) * E θ) =
          ∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
            ((Real.sin θ : ℂ) * Real.cos θ) *
              (E θ * (((-l * Real.cos θ : ℝ) : ℂ) * Complex.I)) := by
        rw [← intervalIntegral.integral_const_mul]
        apply intervalIntegral.integral_congr
        intro θ hθ
        dsimp
        push_cast
        ring
      _ = -(∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) * E θ) := by
        rw [hparts]
        simp only [zero_sub]
  have hlinv : ((l⁻¹ : ℝ) : ℂ) * Complex.I * ((-l : ℂ) * Complex.I) = 1 := by
    rw [Complex.ofReal_inv]
    calc
      (↑l)⁻¹ * Complex.I * (-↑l * Complex.I) =
          ((↑l)⁻¹ * ↑l) * (-(Complex.I * Complex.I)) := by ring
      _ = 1 := by
        rw [inv_mul_cancel₀ (Complex.ofReal_ne_zero.mpr hl), Complex.I_mul_I]
        norm_num
  calc
    (∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
      ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
        ((l⁻¹ : ℝ) : ℂ) * Complex.I *
          ((-l : ℂ) * Complex.I *
            (∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
              ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) * E θ)) := by
      dsimp [E]
      rw [← mul_assoc, hlinv, one_mul]
    _ = ((l⁻¹ : ℝ) : ℂ) * Complex.I *
        (-(∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) * E θ)) := by rw [hparts']
    _ = -(((l⁻¹ : ℝ) : ℂ) * Complex.I) *
        ∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) * E θ := by ring
    _ = _ := by rfl

private theorem intervalIntegral_t_mul_semicircle_eq_meridian (l : ℝ) :
    (∫ t in (-1 : ℝ)..1,
      ((Real.sqrt (1 - t ^ 2) : ℝ) : ℂ) *
        Complex.exp (((-l * t : ℝ) : ℂ) * Complex.I) * ((t : ℝ) : ℂ)) =
      ∫ θ in (-(Real.pi / 2) : ℝ)..(Real.pi / 2),
        ((Real.sin θ * Real.cos θ ^ 2 : ℝ) : ℂ) *
          Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I) := by
  let g : ℝ → ℂ := fun t =>
    ((Real.sqrt (1 - t ^ 2) : ℝ) : ℂ) *
      Complex.exp (((-l * t : ℝ) : ℂ) * Complex.I) * ((t : ℝ) : ℂ)
  have hg : Continuous g := by
    dsimp [g]
    fun_prop
  have hsubst := intervalIntegral.integral_deriv_smul_comp
    (a := (-(Real.pi / 2) : ℝ)) (b := (Real.pi / 2 : ℝ))
    (f := Real.sin) (f' := Real.cos) (g := g)
    (fun x _ => Real.hasDerivAt_sin x) (by fun_prop) hg
  change (∫ t in (-1 : ℝ)..1, g t) = _
  rw [← Real.sin_pi_div_two, ← Real.sin_neg]
  rw [← hsubst]
  apply intervalIntegral.integral_congr
  intro θ hθ
  have hab : -(Real.pi / 2 : ℝ) ≤ Real.pi / 2 :=
    neg_le_self (le_of_lt (div_pos Real.pi_pos (by norm_num)))
  have hθ' : θ ∈ Set.Icc (-(Real.pi / 2) : ℝ) (Real.pi / 2) := by
    simpa [Set.uIcc_of_le hab] using hθ
  change Real.cos θ •
      ((((Real.sqrt (1 - Real.sin θ ^ 2) : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) *
          ((Real.sin θ : ℝ) : ℂ)) = _
  rw [← Real.cos_eq_sqrt_one_sub_sin_sq hθ'.1 hθ'.2]
  push_cast
  rw [Complex.real_smul]
  rw [← Complex.ofReal_cos]
  ring

private theorem upper_meridian_cos_sq_sub_sin_sq_eq_quadratic (l : ℝ) :
    (∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
        ∫ u in (0 : ℝ)..1,
          ((2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
            Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
  let φ : ℝ → ℝ := fun u => Real.pi / 2 - 2 * Real.arcsin (u / Real.sqrt 2)
  let F : ℝ → ℂ := fun θ =>
    ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
      Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)
  have hφ0 : φ 0 = Real.pi / 2 := by simp [φ]
  have hφ1 : φ 1 = 0 := by
    dsimp [φ]
    rw [arcsin_one_div_sqrt_two]
    ring
  have hφderiv : ∀ u ∈ Set.uIcc (0 : ℝ) 1,
      HasDerivAt φ (-2 / Real.sqrt (2 - u ^ 2)) u := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      simpa [Set.uIcc_of_le] using hu
    exact hasDerivAt_pi_div_two_sub_two_arcsin_div_sqrt_two hu'.1 hu'.2
  have hφ'cont : ContinuousOn (fun u : ℝ => -2 / Real.sqrt (2 - u ^ 2))
      (Set.uIcc (0 : ℝ) 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      simpa [Set.uIcc_of_le] using hu
    exact ne_of_gt (lt_of_lt_of_le (by norm_num)
      (one_le_sqrt_two_sub_sq u hu'.1 hu'.2))
  have hF : Continuous F := by
    dsimp [F]
    fun_prop
  have hsubst := intervalIntegral.integral_deriv_smul_comp
    (a := (0 : ℝ)) (b := (1 : ℝ)) (f := φ)
    (f' := fun u => -2 / Real.sqrt (2 - u ^ 2)) (g := F)
    hφderiv hφ'cont hF
  rw [hφ0, hφ1, intervalIntegral.integral_symm] at hsubst
  rw [intervalIntegral.integral_symm] at hsubst
  simp only [neg_neg] at hsubst
  change (∫ θ in (0 : ℝ)..(Real.pi / 2), F θ) = _
  calc
    (∫ θ in (0 : ℝ)..(Real.pi / 2), F θ) =
        -(∫ θ in (Real.pi / 2)..(0 : ℝ), F θ) := by
      rw [intervalIntegral.integral_symm]
    _ = -(∫ u in (0 : ℝ)..1,
        (-2 / Real.sqrt (2 - u ^ 2)) • (F ∘ φ) u) := by rw [← hsubst]
    _ = Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
        ∫ u in (0 : ℝ)..1,
          ((2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
            Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
      rw [← intervalIntegral.integral_neg, ← intervalIntegral.integral_const_mul]
      apply intervalIntegral.integral_congr
      intro u hu
      have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
        simpa [Set.uIcc_of_le] using hu
      have hsin := sin_pi_div_two_sub_two_arcsin_div_sqrt_two hu'.1 hu'.2
      have hcos_sq : Real.cos (φ u) ^ 2 = 1 - (1 - u ^ 2) ^ 2 := by
        nlinarith [Real.sin_sq_add_cos_sq (φ u)]
      have hspos : 0 < Real.sqrt (2 - u ^ 2) :=
        lt_of_lt_of_le (by norm_num) (one_le_sqrt_two_sub_sq u hu'.1 hu'.2)
      have hexp :
          Complex.exp (((-l * (1 - u ^ 2) : ℝ) : ℂ) * Complex.I) =
            Complex.exp (((-l : ℝ) : ℂ) * Complex.I) *
              Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I) := by
        rw [← Complex.exp_add]
        congr 1
        push_cast
        ring
      dsimp [F, φ, Function.comp_apply]
      rw [hsin, hcos_sq, hexp]
      push_cast
      field_simp [ne_of_gt hspos]
      ring

private theorem norm_endpoint_cos_two_quadratic_integral_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ u in (0 : ℝ)..1,
      ((2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ) *
        Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
      46 / Real.sqrt l := by
  let A : ℝ → ℂ := fun u =>
    ((2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2) : ℝ) : ℂ)
  let A' : ℝ → ℂ := fun u =>
    ((2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4) /
      Real.sqrt (2 - u ^ 2) ^ 3 : ℝ) : ℂ)
  have hlpos : 0 < l := lt_of_lt_of_le (by norm_num) hl
  have hsqrtpos : 0 < Real.sqrt l := Real.sqrt_pos.2 hlpos
  have ha : 0 < 1 / Real.sqrt l := one_div_pos.mpr hsqrtpos
  have ha_one : 1 / Real.sqrt l ≤ 1 := by
    rw [div_le_iff₀ hsqrtpos]
    simpa using Real.one_le_sqrt.mpr hl
  have hscale : l * (1 / Real.sqrt l) ^ 2 = 1 := by
    have hsq : Real.sqrt l ^ 2 = l := Real.sq_sqrt hlpos.le
    field_simp [hsqrtpos.ne']
    nlinarith
  have hden_nonzero : ∀ u ∈ Set.Icc (0 : ℝ) 1,
      Real.sqrt (2 - u ^ 2) ≠ 0 := by
    intro u hu
    exact ne_of_gt (lt_of_lt_of_le (by norm_num)
      (one_le_sqrt_two_sub_sq u hu.1 hu.2))
  have hAreal_cont : ContinuousOn
      (fun u : ℝ => 2 * (1 - 2 * (1 - u ^ 2) ^ 2) / Real.sqrt (2 - u ^ 2))
      (Set.Icc 0 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) hden_nonzero
  have hAcont : ContinuousOn A (Set.Icc 0 1) := by
    exact Complex.continuous_ofReal.comp_continuousOn hAreal_cont
  have hA'den_nonzero : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1,
      Real.sqrt (2 - u ^ 2) ^ 3 ≠ 0 := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    exact pow_ne_zero 3 (hden_nonzero u hu')
  have hA'real_cont : ContinuousOn
      (fun u : ℝ => 2 * u * (15 - 20 * u ^ 2 + 6 * u ^ 4) /
        Real.sqrt (2 - u ^ 2) ^ 3)
      (Set.uIcc (1 / Real.sqrt l) 1) := by
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) hA'den_nonzero
  have hA'cont : ContinuousOn A' (Set.uIcc (1 / Real.sqrt l) 1) := by
    exact Complex.continuous_ofReal.comp_continuousOn hA'real_cont
  have hAderiv : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1,
      HasDerivAt A (A' u) u := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    dsimp [A, A']
    exact (endpoint_cos_two_amplitude_hasDerivAt u hu'.1 hu'.2).ofReal_comp
  have hAbound : ∀ u ∈ Set.Icc (0 : ℝ) 1, ‖A u‖ ≤ 2 := by
    intro u hu
    dsimp [A]
    exact norm_endpoint_cos_two_amplitude_le_two u hu.1 hu.2
  have hA'bound : ∀ u ∈ Set.uIcc (1 / Real.sqrt l) 1, ‖A' u‖ ≤ 82 := by
    intro u hu
    have hu' : u ∈ Set.Icc (0 : ℝ) 1 := by
      have hu'' : u ∈ Set.Icc (1 / Real.sqrt l) 1 := by
        change u ∈ Set.uIcc (1 / Real.sqrt l) 1 at hu
        rw [Set.uIcc_of_le ha_one] at hu
        exact hu
      exact ⟨le_trans ha.le hu''.1, hu''.2⟩
    dsimp [A']
    exact norm_endpoint_cos_two_amplitude_deriv_le_eighty_two u hu'.1 hu'.2
  have hmodel := quadratic_phase_weighted_unit_norm_le
    (a := 1 / Real.sqrt l) (c := l) (M := 2) (N := 82)
    ha ha_one hlpos hscale (by norm_num) (by norm_num) A A'
    hAcont hAderiv hA'cont hAbound hA'bound
  change ‖∫ u in (0 : ℝ)..1,
      A u * Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤ _
  calc
    ‖∫ u in (0 : ℝ)..1,
      A u * Complex.exp (((l * u ^ 2 : ℝ) : ℂ) * Complex.I)‖ ≤
        ((5 * 2 + 82) / 2) * (1 / Real.sqrt l) := hmodel
    _ = 46 / Real.sqrt l := by ring

private theorem upper_meridian_cos_sq_sub_sin_sq_plus_eq_conj (l : ℝ) :
    (∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
        Complex.exp (((l * Real.sin θ : ℝ) : ℂ) * Complex.I)) =
      conj
        (∫ θ in (0 : ℝ)..(Real.pi / 2),
          ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
            Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)) := by
  rw [← intervalIntegral.intervalIntegral_conj]
  apply intervalIntegral.integral_congr
  intro θ hθ
  dsimp
  rw [map_mul, ← Complex.exp_conj]
  simp only [map_mul, Complex.conj_ofReal, Complex.conj_I]
  congr 1
  push_cast
  ring_nf

private theorem norm_upper_meridian_cos_sq_sub_sin_sq_le (l : ℝ) (hl : 1 ≤ l) :
    ‖∫ θ in (0 : ℝ)..(Real.pi / 2),
      ((Real.cos θ ^ 2 - Real.sin θ ^ 2 : ℝ) : ℂ) *
        Complex.exp (((-l * Real.sin θ : ℝ) : ℂ) * Complex.I)‖ ≤
      46 / Real.sqrt l := by
