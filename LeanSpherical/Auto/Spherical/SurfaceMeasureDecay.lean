        ∫ x : EuclideanSpace ℝ (Fin d), ‖f t‖ * ‖g (x - t)‖ := by
      exact integral_integral_swap hprodNorm
    _ = ∫ t : EuclideanSpace ℝ (Fin d), ‖f t‖ *
        ∫ x : EuclideanSpace ℝ (Fin d), ‖g x‖ := by
