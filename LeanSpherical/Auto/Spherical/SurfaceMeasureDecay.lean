    simpa only [id_eq] using
      (contDiff_id.neg : ContDiff ℝ (↑(⊤ : ℕ∞))
        (fun ξ : Euclidean d => -ξ))
  let K : Euclidean d → Euclidean d → ℂ := fun _ => surfaceFourier d
  have hK : ContDiff ℝ (↑(⊤ : ℕ∞)) (Function.uncurry K) := by
    change ContDiff ℝ (↑(⊤ : ℕ∞))
      (fun q : Euclidean d × Euclidean d => surfaceFourier d q.2)
