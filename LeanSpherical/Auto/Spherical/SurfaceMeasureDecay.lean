    convert h using 1 <;> try rfl
    have hne := hbase_ne x hx
    have hcancel : Q x *
        (E x * (((2 * c * x : ℝ) : ℂ) * Complex.I)) = E x := by
      dsimp [Q]
      have hscalar : ((2 * c * x : ℝ) : ℂ) ≠ 0 := by
        apply Complex.ofReal_ne_zero.mpr
        exact mul_ne_zero (mul_ne_zero (by norm_num) hc) (ne_of_gt (hpos x hx))
      field_simp [hne, hscalar]
    rw [hcancel]
  have hQcont : ContinuousOn Q (Set.uIcc a b) := by
    dsimp [Q]
    refine ContinuousOn.inv₀ (by fun_prop) ?_
    intro x hx
    exact hbase_ne x hx
  have hQ'cont : ContinuousOn Q' (Set.uIcc a b) := by
    dsimp [Q']
    refine ContinuousOn.div₀ (by fun_prop) (by fun_prop) ?_
    intro x hx
    exact pow_ne_zero 2 (hbase_ne x hx)
  have hEcont : ContinuousOn E (Set.uIcc a b) := by
    dsimp [E]
    fun_prop
  have hgcont : ContinuousOn g (Set.uIcc a b) := by
    intro x hx
    exact (hg x hx).continuousAt.continuousWithinAt
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
