  have hD : ContDiff ℝ (↑(⊤ : ℕ∞)) D := by
    dsimp only [D]
    simpa only [K] using hK.fderiv_apply harg hvec (by simp)
  have hcompact : HasCompactSupport g := by
    exact hψcompact.mul_right
  have hsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) g := by
