    (2 * C₁) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)
  rw [norm_mul]
  calc
    ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • ξ)) r‖ * ‖q‖ ≤
        (C₁ / (dyadicScale j) ^ ((d : ℝ) / 2 - 1)) * 2 :=
