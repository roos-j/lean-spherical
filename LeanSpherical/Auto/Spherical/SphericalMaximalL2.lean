        C1 / ‖xi‖ ^ ((1 : ℝ) / 2 - 1))
    (phi f psi : SchwartzMap (Euclidean 2) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : Euclidean 2,
      psi xi = phi (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : ℝ) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : Euclidean 2 → ℂ))
    {a b : ℝ} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : ℝ) 2) :
    MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f)) 2 volume ∧
    (∫ x : Euclidean 2,
      ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
      (2 * ((2 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2)) ^ 2 +
        2 * (b - a) ^ 2 *
          (4 * C1 * (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2)) ^ 2) *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  refine sphericalIntervalMaximalRaw_memLp_two_of_multiplier_bounds (d := 1)
    ((2 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2))
    (4 * C1 * (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2))
    ?_ ?_ f psi hpsi_compact hab ?_ ?_
  · exact div_nonneg (mul_nonneg (by norm_num) hC0.le)
      (Real.rpow_nonneg (Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j).le _)
  · exact mul_nonneg (mul_nonneg (by norm_num) hC1.le)
      (Real.rpow_nonneg (Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j).le _)
  · intro t ht xi
    rw [hpsi xi]
    simpa using
      norm_circle_surfaceFourier_smul_mul_smooth_dyadic_bandpass_le_of_sharp
        C0 hC0 hdecay hphi_one hphi_zero hphi_norm j t (hinterval ht) xi
  · intro t ht xi
    rw [hpsi xi]
    simpa using
      norm_deriv_circle_surfaceFourier_smul_mul_smooth_dyadic_bandpass_le_of_sharp
        C1 hC1 hderiv hphi_one hphi_zero hphi_norm j t (hinterval ht) xi

/-- The preceding local estimate is available directly from the bundled
circle sharp-bounds interface. -/
theorem sphericalIntervalMaximalRaw_memLp_two_of_hasCircleSurfaceFourierSharpBounds
    (hcircle : HasCircleSurfaceFourierSharpBounds)
    (phi f psi : SchwartzMap (Euclidean 2) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : Euclidean 2,
      psi xi = phi (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : ℝ) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : Euclidean 2 → ℂ))
    {a b : ℝ} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : ℝ) 2) :
    ∃ C0 C1 : ℝ, 0 < C0 ∧ 0 < C1 ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : Euclidean 2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            (4 * C1 * (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((1 : ℝ) / 2)) ^ 2) *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  rcases hcircle with ⟨C0, C1, hC0, hC1, hdecay, hderiv⟩
  exact ⟨C0, C1, hC0, hC1,
    sphericalIntervalMaximalRaw_memLp_two_of_circle_sharp C0 C1 hC0 hC1
      hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
      hab hinterval⟩

/-- At reciprocal frequency-radius length, the circle estimate has the same
full `R⁻¹` decay as the higher-dimensional short-interval estimate. -/
theorem circle_short_interval_l2_coefficient_le_frequency_decay
    (C0 C1 : ℝ) (hC0 : 0 ≤ C0) (hC1 : 0 ≤ C1)
    {R L : ℝ} (hR : 0 < R) (hRone : 1 ≤ R)
    (hL : 0 ≤ L) (hLR : L ≤ R⁻¹) :
    2 * ((2 * C0) / R ^ ((1 : ℝ) / 2)) ^ 2 +
        2 * L ^ 2 * (4 * C1 * R ^ ((1 : ℝ) / 2)) ^ 2 ≤
      (8 * C0 ^ 2 + 32 * C1 ^ 2) * R ^ (-(1 : ℝ)) := by
  have hcoeff :
      4 * C1 * R ^ ((1 : ℝ) / 2) =
        (2 * (2 * C1)) / R ^ ((1 : ℝ) / 2 - 1) := by
    symm
    rw [show (1 : ℝ) / 2 - 1 = -((1 : ℝ) / 2) by ring, div_eq_mul_inv]
    calc
      2 * (2 * C1) * (R ^ (-((1 : ℝ) / 2)))⁻¹ =
          2 * (2 * C1) * R ^ ((1 : ℝ) / 2) := by
            rw [← Real.rpow_neg hR.le]
            congr 2
            ring
      _ = 4 * C1 * R ^ ((1 : ℝ) / 2) := by ring
  have hbase :=
    short_interval_l2_coefficient_le_frequency_decay_of_any_dimension
      (n := 1) C0 (2 * C1) hC0 (mul_nonneg (by norm_num) hC1)
      hR hRone hL hLR
  calc
    2 * ((2 * C0) / R ^ ((1 : ℝ) / 2)) ^ 2 +
        2 * L ^ 2 * (4 * C1 * R ^ ((1 : ℝ) / 2)) ^ 2 =
        2 * ((2 * C0) / R ^ (((1 : ℕ) : ℝ) / 2)) ^ 2 +
          2 * L ^ 2 *
            ((2 * (2 * C1)) / R ^ (((1 : ℕ) : ℝ) / 2 - 1)) ^ 2 := by
          rw [hcoeff]
          norm_num
    _ ≤ (8 * C0 ^ 2 + 8 * (2 * C1) ^ 2) * R ^ (-((1 : ℕ) : ℝ)) := hbase
    _ = (8 * C0 ^ 2 + 32 * C1 ^ 2) * R ^ (-(1 : ℝ)) := by ring

end
end Former_CircleDyadicL2

end

