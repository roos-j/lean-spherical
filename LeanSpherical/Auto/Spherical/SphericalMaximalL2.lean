      dyadicScale j = 1 * dyadicScale j := by ring
      _ ≤ r * dyadicScale j :=
        mul_le_mul_of_nonneg_right hr.1 hscale.le
      _ ≤ r * ‖ξ‖ :=
        mul_le_mul_of_nonneg_left hξ.1 hrpos.le
