/- ===== Foundational finite-cover closure from AbsoluteDyadic.lean ===== -/
section Former_AbsoluteDyadicBourgainCore
open Filter MeasureTheory FourierTransform Metric Set
open scoped FourierTransform
open Auto.Spherical.Auxiliary
open Auto.Spherical.SurfaceMeasureDecay
noncomputable section

theorem fractalDyadicBandpassMaximal_nonneg {d : ℕ} (E : Set ℝ)
    (ψ f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    0 ≤ fractalDyadicBandpassMaximal d E ψ f x := by
  exact ENNReal.toReal_nonneg

theorem unnormalizedFractalDyadicBandpassMaximal_nonneg {d : ℕ} (E : Set ℝ)
    (ψ f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    0 ≤ unnormalizedFractalDyadicBandpassMaximal d E ψ f x := by
  unfold unnormalizedFractalDyadicBandpassMaximal
  exact mul_nonneg ENNReal.toReal_nonneg
    (fractalDyadicBandpassMaximal_nonneg E ψ f x)

theorem measurable_fractalDyadicBandpassMaximal {d : ℕ} (E : Set ℝ)
    (ψ f : SchwartzMap (Euclidean d) ℂ) :
    Measurable (fractalDyadicBandpassMaximal d E ψ f) := by
  exact measurable_fractalSphericalMaximalReal E (dyadicBandpassProjection ψ f)

theorem measurable_unnormalizedFractalDyadicBandpassMaximal {d : ℕ} (E : Set ℝ)
    (ψ f : SchwartzMap (Euclidean d) ℂ) :
    Measurable (unnormalizedFractalDyadicBandpassMaximal d E ψ f) := by
  unfold unnormalizedFractalDyadicBandpassMaximal
  exact measurable_const.mul (measurable_fractalDyadicBandpassMaximal E ψ f)

/-- Normalization of surface measure costs exactly one fixed inverse mass.
We state the direction needed for the finite-cover endpoint estimates. -/
theorem fractalSphericalMaximalReal_interval_le_inv_surfaceMass_mul_raw
    {d : ℕ} (hd : 0 < d) {a b : ℝ} (hab : a ≤ b)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalSphericalMaximalReal d (Icc a b) f x ≤
      (surfaceMass d)⁻¹ * sphericalIntervalMaximalRaw a b f x := by
  let Q : ENNReal := ⨆ r : Icc a b,
    ENNReal.ofReal ‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖
  let P : ENNReal := ⨆ r : Icc a b,
    ENNReal.ofReal ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd
  have hinv : 0 ≤ (surfaceMass d)⁻¹ := inv_nonneg.mpr hmass.le
  have hterm (r : Icc a b) :
      ENNReal.ofReal ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ =
        ENNReal.ofReal ((surfaceMass d)⁻¹) *
          ENNReal.ofReal ‖sphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ := by
    rw [normalizedSphericalAverage, norm_mul, norm_inv, Complex.norm_real,
      Real.norm_eq_abs, abs_of_pos hmass]
    rw [ENNReal.ofReal_mul hinv]
  have hPQ : P ≤ ENNReal.ofReal ((surfaceMass d)⁻¹) * Q := by
    rw [ENNReal.mul_iSup]
    apply iSup_le
    intro r
    rw [hterm r]
    exact le_iSup (fun s : Icc a b =>
      ENNReal.ofReal ((surfaceMass d)⁻¹) *
        ENNReal.ofReal ‖sphericalAverage d (f : Euclidean d → ℂ) s.1 x‖) r
  have hQfinite : Q ≠ ⊤ :=
    iSup_ennreal_norm_sphericalAverage_ne_top (f : Euclidean d → ℂ) f.continuous
      hab x
  have hPfinite : P ≠ ⊤ := by
    exact ne_top_of_le_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hQfinite) hPQ
  have hreal := (ENNReal.toReal_le_toReal hPfinite
    (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hQfinite)).mpr hPQ
  change P.toReal ≤ (surfaceMass d)⁻¹ * Q.toReal
  simpa only [ENNReal.toReal_mul, ENNReal.toReal_ofReal hinv] using hreal

/-- A finite family of positive radius sets dominates the real-valued
restricted maximal operator whenever it covers the original set.  This is a
version of the usual interval-cover reduction whose members may be clipped
intervals rather than translates of one common interval. -/
theorem fractalSphericalMaximalReal_le_finset_sup_of_cover
    {d : ℕ} {ι : Type*} {E : Set ℝ} (hd : 0 < d)
    (s : Finset ι) (hs : s.Nonempty) (A : ι → Set ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, A i)
    (_hEpos : E ⊆ Ioi (0 : ℝ))
    (hApos : ∀ i ∈ s, A i ⊆ Ioi (0 : ℝ))
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalSphericalMaximalReal d E f x ≤
      s.sup' hs (fun i => fractalSphericalMaximalReal d (A i) f x) := by
  have hraw : fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≤
      s.sup' hs (fun i => fractalSphericalMaximal d (A i)
        (f : Euclidean d → ℂ) x) := by
    apply iSup_le
    intro r
    rcases Set.mem_iUnion.mp (hcover r.2) with ⟨i, hAi⟩
    rcases Set.mem_iUnion.mp hAi with ⟨hi, hri⟩
    exact (normalizedSphericalAverage_le_fractalSphericalMaximal (A i)
      (f : Euclidean d → ℂ) hri x).trans
      (Finset.le_sup' (fun k => fractalSphericalMaximal d (A k)
        (f : Euclidean d → ℂ) x) hi)
  rcases s.exists_mem_eq_sup' hs (fun i => fractalSphericalMaximal d (A i)
      (f : Euclidean d → ℂ) x) with ⟨i, hi, hmax⟩
  have hright : s.sup' hs (fun i => fractalSphericalMaximal d (A i)
      (f : Euclidean d → ℂ) x) ≠ ⊤ := by
    rw [hmax]
    exact fractalSphericalMaximal_ne_top hd (A i) (hApos i hi) f x
  have hleft : fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≠ ⊤ :=
    ne_top_of_le_ne_top hright hraw
  have hreal := (ENNReal.toReal_le_toReal hleft hright).mpr hraw
  calc
    fractalSphericalMaximalReal d E f x ≤
        (s.sup' hs (fun i => fractalSphericalMaximal d (A i)
          (f : Euclidean d → ℂ) x)).toReal := by
          exact hreal
    _ = fractalSphericalMaximalReal d (A i) f x := by
      rw [hmax]
      rfl
    _ ≤ s.sup' hs (fun i => fractalSphericalMaximalReal d (A i) f x) :=
      Finset.le_sup' (fun k => fractalSphericalMaximalReal d (A k) f x) hi

/-- Multiply the preceding cover estimate by the surface mass and replace
each normalized local maximum by its unnormalised counterpart. -/
theorem surfaceMass_mul_fractalSphericalMaximalReal_le_finset_sup_raw_of_cover
    {d : ℕ} {ι : Type*} {E : Set ℝ} (hd : 0 < d)
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hEpos : E ⊆ Ioi (0 : ℝ))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Ioi (0 : ℝ))
    (hab : ∀ i ∈ s, a i ≤ b i)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    surfaceMass d * fractalSphericalMaximalReal d E f x ≤
      s.sup' hs (fun i => sphericalIntervalMaximalRaw (a i) (b i) f x) := by
  have hcoverReal := fractalSphericalMaximalReal_le_finset_sup_of_cover hd s hs
    (fun i => Icc (a i) (b i)) hcover hEpos hinterval f x
  rcases s.exists_mem_eq_sup' hs (fun i =>
      fractalSphericalMaximalReal d (Icc (a i) (b i)) f x) with ⟨i, hi, hmax⟩
  rw [hmax] at hcoverReal
  calc
    surfaceMass d * fractalSphericalMaximalReal d E f x ≤
        surfaceMass d * fractalSphericalMaximalReal d (Icc (a i) (b i)) f x :=
      mul_le_mul_of_nonneg_left hcoverReal (surfaceMass_pos hd).le
    _ ≤ surfaceMass d * ((surfaceMass d)⁻¹ *
          sphericalIntervalMaximalRaw (a i) (b i) f x) :=
      mul_le_mul_of_nonneg_left
        (fractalSphericalMaximalReal_interval_le_inv_surfaceMass_mul_raw hd
          (hab i hi) f x)
        (surfaceMass_pos hd).le
    _ = sphericalIntervalMaximalRaw (a i) (b i) f x := by
      rw [← mul_assoc, mul_inv_cancel₀ (surfaceMass_ne_zero hd), one_mul]
    _ ≤ s.sup' hs (fun k => sphericalIntervalMaximalRaw (a k) (b k) f x) :=
      Finset.le_sup' (fun k => sphericalIntervalMaximalRaw (a k) (b k) f x) hi

theorem unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
    {d : ℕ} {ι : Type*} (hd : 0 < d)
    (E : Set ℝ) (ψ : SchwartzMap (Euclidean d) ℂ)
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → ℝ)
    (hcover : E ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hEpos : E ⊆ Ioi (0 : ℝ))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Ioi (0 : ℝ))
    (hab : ∀ i ∈ s, a i ≤ b i)
    (f : SchwartzMap (Euclidean d) ℂ) {B : ℝ}
    (hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection ψ f)) 2 volume ∧
      (∫ x : Euclidean d,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection ψ f) x‖ ^ 2) ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ 2) :
    MemLp (unnormalizedFractalDyadicBandpassMaximal d E ψ f) 2 volume ∧
      (∫ x : Euclidean d,
        ‖unnormalizedFractalDyadicBandpassMaximal d E ψ f x‖ ^ 2) ≤
        (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ ^ 2 := by
  let U : Euclidean d → ℝ := unnormalizedFractalDyadicBandpassMaximal d E ψ f
  let u : ι → Euclidean d → ℝ := fun i =>
    sphericalIntervalMaximalRaw (a i) (b i) (dyadicBandpassProjection ψ f)
  have hUmeas : Measurable U :=
    measurable_unnormalizedFractalDyadicBandpassMaximal E ψ f
  have hUnonneg (x : Euclidean d) : 0 ≤ U x :=
    unnormalizedFractalDyadicBandpassMaximal_nonneg E ψ f x
  have hunonneg : ∀ i ∈ s, ∀ x : Euclidean d, 0 ≤ u i x := by
    intro i hi x
    exact sphericalIntervalMaximalRaw_nonneg (a i) (b i)
      (dyadicBandpassProjection ψ f) x
  have humeas : ∀ i ∈ s, Measurable (u i) := by
    intro i hi
    exact sphericalIntervalMaximalRaw_measurable (dyadicBandpassProjection ψ f)
  have huInt : ∀ i ∈ s, Integrable (fun x => (u i x) ^ (2 : ℕ)) volume := by
    intro i hi
    have h := (memLp_two_iff_integrable_sq_norm (humeas i hi).aestronglyMeasurable).mp
      (hlocal i hi).1
    have heq : (fun x : Euclidean d => (u i x) ^ (2 : ℕ)) =
        fun x => ‖u i x‖ ^ (2 : ℕ) := by
      funext x
      rw [Real.norm_of_nonneg (hunonneg i hi x)]
    rw [heq]
    exact h
  have hle : ∀ x : Euclidean d, U x ≤ s.sup' hs (fun i => u i x) := by
    intro x
    exact surfaceMass_mul_fractalSphericalMaximalReal_le_finset_sup_raw_of_cover
      hd s hs a b hcover hEpos hinterval hab
      (dyadicBandpassProjection ψ f) x
  have hmain := memLp_two_of_le_finset_sup_of_local_sq
    s hs U u hUmeas hUnonneg hunonneg humeas huInt hle
  refine ⟨hmain.1, ?_⟩
  calc
    (∫ x : Euclidean d, ‖U x‖ ^ (2 : ℕ)) ≤
        ∑ i ∈ s, ∫ x : Euclidean d, (u i x) ^ (2 : ℕ) := hmain.2
    _ ≤ ∑ _i ∈ s, B * ∫ x : Euclidean d, ‖f x‖ ^ (2 : ℕ) := by
      apply Finset.sum_le_sum
      intro i hi
      calc
        (∫ x : Euclidean d, (u i x) ^ (2 : ℕ)) =
            ∫ x : Euclidean d, ‖u i x‖ ^ (2 : ℕ) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [Real.norm_of_nonneg (hunonneg i hi x)]
        _ ≤ _ := (hlocal i hi).2
    _ = (s.card : ℝ) * B * ∫ x : Euclidean d, ‖f x‖ ^ (2 : ℕ) := by
      simp [nsmul_eq_mul]
      ring

end
end Former_AbsoluteDyadicBourgainCore

