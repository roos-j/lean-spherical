/- ===== Foundational finiteness core from Maximal.lean ===== -/
section Former_MaximalFinitenessCore
open MeasureTheory Set
open Auto.Spherical.SurfaceMeasureDecay
open Auto.Spherical.Auxiliary
noncomputable section

/-- If all radii in `E` are positive, the fractal operator is pointwise
dominated by the global normalized spherical maximal operator. -/
theorem fractalSphericalMaximal_le_normalizedSphericalMaximal
    {d : ℕ} (E : Set ℝ) (hE : E ⊆ Ioi (0 : ℝ)) (f : Euclidean d → ℂ)
    (x : Euclidean d) :
    fractalSphericalMaximal d E f x ≤ normalizedSphericalMaximal d f x := by
  unfold fractalSphericalMaximal
  refine iSup_le fun t => ?_
  exact normalizedSphericalAverage_le_normalizedSphericalMaximal d f t.1
    (hE t.2) x

/-- On Schwartz data in positive dimension, the local maximal supremum is
finite whenever the set of radii is positive. -/
theorem fractalSphericalMaximal_ne_top
    {d : ℕ} (hd : 0 < d) (E : Set ℝ) (hE : E ⊆ Ioi (0 : ℝ))
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≠ ⊤ := by
  refine ne_top_of_le_ne_top
    (ENNReal.ofReal_ne_top : ENNReal.ofReal ‖f.toBoundedContinuousFunction‖ ≠ ⊤) ?_
  calc
    fractalSphericalMaximal d E (f : Euclidean d → ℂ) x ≤
        normalizedSphericalMaximal d (f : Euclidean d → ℂ) x :=
      fractalSphericalMaximal_le_normalizedSphericalMaximal E hE _ x
    _ ≤ ENNReal.ofReal ‖f.toBoundedContinuousFunction‖ :=
      normalizedSphericalMaximal_le_of_norm_le hd _ x
        (fun y => by
          change ‖f.toBoundedContinuousFunction y‖ ≤ ‖f.toBoundedContinuousFunction‖
          exact BoundedContinuousFunction.norm_coe_le_norm _ _)


end
end Former_MaximalFinitenessCore

