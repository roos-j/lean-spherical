  have hpow : (dyadicScale j) ^ ((d : ℝ) / 2) ≤
      ‖r • ξ‖ ^ ((d : ℝ) / 2) :=
    Real.rpow_le_rpow hscale.le hscale_le (by positivity)
  have hpow_pos : 0 < (dyadicScale j) ^ ((d : ℝ) / 2) :=
    Real.rpow_pos_of_pos hscale _
