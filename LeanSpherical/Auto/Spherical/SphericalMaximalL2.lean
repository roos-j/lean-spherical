      ξ ∈ dyadicAnnulus (d + 1) j →
      ‖surfaceFourier (d + 1) (r • ξ)‖ ≤
        C / (dyadicScale j) ^ ((d : ℝ) / 2) := by
  obtain ⟨C₀, C₁, hC₀, hC₁, hdecay, hderiv⟩ :=
    exists_sharp_surfaceFourier_succ_decay_and_deriv hd
