  have ha : 0 ≤ (d : ℝ) / 2 - 1 := by
    have hd' : (2 : ℝ) ≤ d := by exact_mod_cast hd
    linarith
  have hscale : 0 < dyadicScale j := dyadicScale_pos j
  have hscale_one : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
