    (fun g hg u hu => hweak_s g hg hu) f hTf low high hlow_mem hhigh_mem hsplit hhigh_killed
    hlowI_meas A hlow_tail

/-- Attach the literal `L¹ → L∞` endpoint to the generalized crossed
layer-cake calculation. -/
theorem crossed_marcinkiewicz_strong_of_lone_ls_split
    {α E F : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [Add F] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} [SFinite μ]
    (D : Set F) (eval : F → α → E) (T : F → α → ℝ)
    (hT_nonneg : ∀ g x, 0 ≤ T g x)
    (hT_subadd : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (C₁ : ℝ) (_hC₁ : 0 ≤ C₁)
    (hstrong_one_top : ∀ (g : F), g ∈ D → ∀ x,
      T g x ≤ C₁ * ∫ y, ‖eval g y‖ ∂μ)
    {s : ℝ} (hs : 0 < s) (Cs : ENNReal)
    (hweak_s : ∀ (g : F), g ∈ D → ∀ {u : ℝ}, 0 < u →
      ENNReal.ofReal (u ^ s) * μ {x | u < T g x} ≤
        Cs * (∫⁻ x, ENNReal.ofReal (‖eval g x‖ ^ s) ∂μ))
    {q : ℝ} (hsq : s < q)
    (f : F) (hTf : AEMeasurable (T f) μ)
    (low high : ℝ → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hhigh_lone : ∀ t, 0 < t →
      C₁ * (∫ y, ‖eval (high t) y‖ ∂μ) ≤ t / 2)
    (hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ s) ∂μ))
    (A : ENNReal)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ s) ∂μ) *
          (ENNReal.ofReal t) ^ (q - s - 1)) ≤ A) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂μ) ≤
      ENNReal.ofReal q * ((ENNReal.ofReal (2 : ℝ)) ^ s * Cs * A) := by
  apply crossed_marcinkiewicz_strong_of_killed_ls_split D eval T hT_nonneg hT_subadd
    hs Cs hweak_s hsq f hTf low high hlow_mem hhigh_mem hsplit ?_ hlowI_meas A hlow_tail
  intro t ht x
  calc
    T (high t) x ≤ C₁ * ∫ y, ‖eval (high t) y‖ ∂μ :=
      hstrong_one_top (high t) (hhigh_mem t) x
    _ ≤ t / 2 := hhigh_lone t ht

/-- The scalar power-tail identity for the `Lˢ` crossed interpolation.
The exponent relation is precisely the line joining `(1,0)` and `(1/s,1/s)`
in reciprocal coordinates. -/
theorem crossed_power_cutoff_tail_pointwise_s
    {u p q s K : ℝ} (hu : 0 ≤ u) (hp1 : 1 < p) (hps : p < s)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K) :
    ENNReal.ofReal (u ^ s) *
        (∫⁻ t in Ioc (0 : ℝ) (K / u ^ (p - 1)),
          (ENNReal.ofReal t) ^ (q - s - 1)) =
      (ENNReal.ofReal (q - s))⁻¹ *
        (ENNReal.ofReal K) ^ (q - s) * (ENNReal.ofReal u) ^ p := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hpminus : 0 < p - 1 := by linarith
  have hqs : 0 < q - s := by
    rw [hq]
    have hcalc : p * (s - 1) - s * (p - 1) = s - p := by ring
    have hden : 0 < p - 1 := hpminus
    rw [sub_pos, lt_div_iff₀ hden]
    nlinarith
  rcases hu.eq_or_lt with rfl | hu
  · simp [Real.zero_rpow (by linarith : s ≠ 0),
      ENNReal.zero_rpow_of_pos hp0]
  have hupow : 0 < u ^ (p - 1) := Real.rpow_pos_of_pos hu _
  have hthreshold : 0 ≤ K / u ^ (p - 1) := by positivity
  rw [show q - s - 1 = ((q - s + 1) - 2) by ring]
  rw [lintegral_rpow_Ioc_eq (p := q - s + 1) (by linarith) hthreshold]
  have hreal :
      u ^ s * ((K / u ^ (p - 1)) ^ (q - s) / (q - s)) =
        (K ^ (q - s) / (q - s)) * u ^ p := by
    rw [Real.div_rpow hK.le hupow.le]
    rw [div_eq_mul_inv]
    have hpq : s + (1 - p) * (q - s) = p := by
      rw [hq]
      field_simp [hpminus.ne']
      ring
    have hden : (u ^ (p - 1)) ^ (q - s) =
        u ^ ((p - 1) * (q - s)) := by
      rw [← Real.rpow_mul hu.le]
    rw [hden, div_eq_mul_inv]
    have hinv : (u ^ ((p - 1) * (q - s)))⁻¹ =
        u ^ ((1 - p) * (q - s)) := by
      rw [← Real.rpow_neg hu.le]
      congr 1
      ring
    rw [hinv]
    calc
      u ^ s * (K ^ (q - s) * u ^ ((1 - p) * (q - s)) *
          (q - s)⁻¹) =
          K ^ (q - s) * (q - s)⁻¹ *
            (u ^ s * u ^ ((1 - p) * (q - s))) := by ring
      _ = K ^ (q - s) * (q - s)⁻¹ * u ^ p := by
        rw [← Real.rpow_add hu]
        rw [hpq]
      _ = K ^ (q - s) / (q - s) * u ^ p := by ring
  rw [show q - s + 1 - 1 = q - s by ring]
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hu.le _), hreal]
  have hA : 0 ≤ K ^ (q - s) / (q - s) :=
    div_nonneg (Real.rpow_nonneg hK.le _) hqs.le
  rw [ENNReal.ofReal_mul hA]
  rw [ENNReal.ofReal_div_of_pos hqs]
  rw [ENNReal.ofReal_rpow_of_pos hK]
  rw [ENNReal.ofReal_rpow_of_pos hu]
  simp only [div_eq_mul_inv]
  ring

/-- Tonelli form of `crossed_power_cutoff_tail_pointwise_s`.  It is the hard
part of the rational Schwartz cutoff: the remaining rational residue is
handled separately in the spherical application. -/
theorem crossed_low_tail_of_power_cutoff_s
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} [SFinite μ]
    (u : α → ℝ) (hu : Measurable u) (hu_nonneg : ∀ x, 0 ≤ u x)
    {p q s K : ℝ} (hp1 : 1 < p) (hps : p < s)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K)
    (low : ℝ → α → E)
    (hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ s) ∂μ))
    (hlow_bound : ∀ t x, 0 < t →
      ENNReal.ofReal (‖low t x‖ ^ s) ≤
        ({x | t * (u x) ^ (p - 1) ≤ K}.indicator
          (fun x => ENNReal.ofReal ((u x) ^ s)) x)) :
    (∫⁻ t in Ioi (0 : ℝ),
      (∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ s) ∂μ) *
        (ENNReal.ofReal t) ^ (q - s - 1)) ≤
      (ENNReal.ofReal (q - s))⁻¹ * (ENNReal.ofReal K) ^ (q - s) *
        ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
  let a : α → ℝ := fun x => K / (u x) ^ (p - 1)
  let v : α → ENNReal := fun x => ENNReal.ofReal ((u x) ^ s)
  let w : ℝ → ENNReal := fun t => (ENNReal.ofReal t) ^ (q - s - 1)
  let lowI : ℝ → ENNReal := fun t =>
    ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ s) ∂μ
  have hpminus : 0 < p - 1 := by linarith
  have hpow : Measurable (fun x => (u x) ^ (p - 1)) := by
    exact (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hu
  have ha : Measurable a := by
    exact measurable_const.div hpow
  have ha_nonneg : ∀ x, 0 ≤ a x := by
    intro x
    exact div_nonneg hK.le (Real.rpow_nonneg (hu_nonneg x) _)
  have hsnonneg : 0 ≤ s := by linarith
  have hv : Measurable v := by
    exact ENNReal.continuous_ofReal.measurable.comp
      ((continuous_id.rpow_const (fun _ => Or.inr hsnonneg)).measurable.comp hu)
  have hw : Measurable w := by
    exact ENNReal.continuous_rpow_const.measurable.comp measurable_id.ennreal_ofReal
  have hlowI : Measurable lowI := by
    simpa only [lowI] using hlowI_meas
  have hindicator (t : ℝ) (ht : 0 < t) (x : α) :
      ({x | t * (u x) ^ (p - 1) ≤ K}.indicator v x) ≤
        ({x | t ≤ a x}.indicator v x) := by
    by_cases hzero : u x = 0
    · have hvzero : v x = 0 := by simp [v, hzero, Real.zero_rpow (by linarith : s ≠ 0)]
      simp [Set.indicator_apply, hvzero]
    · have hupos : 0 < u x := lt_of_le_of_ne (hu_nonneg x) (Ne.symm hzero)
      have hupow : 0 < (u x) ^ (p - 1) := Real.rpow_pos_of_pos hupos _
      have heq : t * (u x) ^ (p - 1) ≤ K ↔ t ≤ a x := by
        dsimp only [a]
        exact (le_div_iff₀ hupow).symm
      simp only [Set.indicator_apply, mem_setOf_eq]
      by_cases hmem : t * (u x) ^ (p - 1) ≤ K
      · simp [hmem, heq.mp hmem]
      · simp [hmem]
  have hpoint (t : ℝ) (ht : 0 < t) :
      lowI t ≤ ∫⁻ x in {x | t ≤ a x}, v x ∂μ := by
    calc
      lowI t ≤ ∫⁻ x,
          ({x | t * (u x) ^ (p - 1) ≤ K}.indicator v x) ∂μ := by
        apply lintegral_mono
        intro x
        exact hlow_bound t x ht
      _ ≤ ∫⁻ x, ({x | t ≤ a x}.indicator v x) ∂μ := by
        apply lintegral_mono
        intro x
        exact hindicator t ht x
      _ = ∫⁻ x in {x | t ≤ a x}, v x ∂μ := by
        rw [lintegral_indicator (measurableSet_le measurable_const ha)]
  have houter :
      (∫⁻ t in Ioi (0 : ℝ), lowI t * w t) ≤
        ∫⁻ t in Ioi (0 : ℝ),
          (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    simpa only [mul_comm] using mul_le_mul_right (hpoint t ht) (w t)
  have hswap :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t) =
        ∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t) =
          ∫⁻ t in Ioi (0 : ℝ),
            w t * (∫⁻ x in {x | t ≤ a x}, v x ∂μ) := by
          apply lintegral_congr
          intro t
          exact mul_comm _ _
      _ = _ := lintegral_swap_indicator_le a ha v hv w hw
  have hpointwise :
      (∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ) =
        (ENNReal.ofReal (q - s))⁻¹ * (ENNReal.ofReal K) ^ (q - s) *
          ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
    let C : ENNReal := (ENNReal.ofReal (q - s))⁻¹ *
      (ENNReal.ofReal K) ^ (q - s)
    have hpowu : Measurable (fun x => (ENNReal.ofReal (u x)) ^ p) :=
      ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal
    calc
      (∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ) =
          ∫⁻ x, C * (ENNReal.ofReal (u x)) ^ p ∂μ := by
            apply lintegral_congr
            intro x
            dsimp only [a, v, w, C]
            exact crossed_power_cutoff_tail_pointwise_s
              (hu_nonneg x) hp1 hps hq hK
      _ = C * ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ :=
        lintegral_const_mul C hpowu
      _ = _ := by rfl
  simpa only [lowI, w] using houter.trans_eq (hswap.trans hpointwise)

/-- The height-dependent amplitude used by the smooth Schwartz split in the
`Lˢ` crossed argument. -/
def crossedLsAmplitudeScale (p K t : ℝ) : ℝ :=
  (K / t) ^ ((p - 1)⁻¹)

theorem crossedLsAmplitudeScale_pos
    {p K t : ℝ} (_hp1 : 1 < p) (hK : 0 < K) (ht : 0 < t) :
    0 < crossedLsAmplitudeScale p K t := by
  unfold crossedLsAmplitudeScale
  exact Real.rpow_pos_of_pos (div_pos hK ht) _

theorem crossedLsAmplitudeScale_rpow_one_sub
    {p K t : ℝ} (hp1 : 1 < p) (hK : 0 < K) (ht : 0 < t) :
    (crossedLsAmplitudeScale p K t) ^ (1 - p) = t / K := by
  unfold crossedLsAmplitudeScale
  have hpminus : p - 1 ≠ 0 := by linarith
  have hbase : 0 ≤ K / t := (div_pos hK ht).le
  rw [← Real.rpow_mul hbase]
  have hpower : (p - 1)⁻¹ * (1 - p) = (-1 : ℝ) := by
    field_simp [hpminus]
    ring
  rw [hpower, Real.rpow_neg_one]
  field_simp [hK.ne', ht.ne']

theorem measurable_crossedLsAmplitudeScale
    {p K : ℝ} (hp1 : 1 < p) :
    Measurable (crossedLsAmplitudeScale p K) := by
  unfold crossedLsAmplitudeScale
  have hexp : 0 ≤ (p - 1)⁻¹ :=
    inv_nonneg.mpr (by linarith)
  exact (continuous_id.rpow_const (fun _ => Or.inr hexp)).measurable.comp
    (measurable_const.div measurable_id)

/-- The purely analytic part of the generalized crossed argument on the
Schwartz carrier.  The final tail hypothesis is separated out so that the
rational-tail calculation can be reused independently of the spherical
operator. -/
theorem crossed_schwartz_moment_of_lone_weak_ls_and_rational_tail
    {d : Nat} (T : SchwartzMap (Euclidean d) Complex → Euclidean d → ℝ)
    (hT_nonneg : ∀ g x, 0 ≤ T g x)
    (hT_subadd : ∀ g h x, T (g + h) x ≤ T g x + T h x)
    (hT_meas : ∀ g, AEMeasurable (T g) volume)
    {A : ℝ} (hA : 0 ≤ A)
    (hLone : ∀ g x, T g x ≤ A * ∫ y, ‖g y‖)
    {s : ℝ} (hs : 0 < s) (Cs : ENNReal)
    (hweak_s : ∀ (g : SchwartzMap (Euclidean d) Complex) {u : ℝ}, 0 < u →
      ENNReal.ofReal (u ^ s) * volume {x | u < T g x} ≤
        Cs * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ s))
    {p q K I : ℝ} (hp1 : 1 < p) (hps : p < s) (hs2 : s < 2)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K)
    (f : SchwartzMap (Euclidean d) Complex)
    (hI : I = ∫ x, ‖f x‖ ^ p) (hbalance : 2 * A * I ≤ K)
    (Atail : ENNReal)
    (hRationalTail : ∀
      (low high : ℝ → SchwartzMap (Euclidean d) Complex),
      (∀ t x, low t x =
        ((1 + ‖(t⁻¹ : ℝ) • f x‖ ^ 2) ^ (-1 : ℝ)) • f x) →
      (∀ t, high t = f - low t) →
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal
          (‖low (crossedLsAmplitudeScale p K t) x‖ ^ s)) *
          (ENNReal.ofReal t) ^ (q - s - 1)) ≤ Atail) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q)) ≤
      ENNReal.ofReal q *
        ((ENNReal.ofReal (2 : ℝ)) ^ s * Cs * Atail) := by
  rcases exists_schwartz_rational_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hp2 : p < 2 := hps.trans hs2
  have hqs : s < q := by
    rw [hq]
    have hden : 0 < p - 1 := by linarith
    rw [lt_div_iff₀ hden]
    have : s * (p - 1) < p * (s - 1) := by
      nlinarith [mul_pos (show 0 < s - p by linarith) (show 0 < p - 1 by linarith)]
    exact this
  have hsplit' : ∀ t : ℝ,
      f = low (crossedLsAmplitudeScale p K t) +
        high (crossedLsAmplitudeScale p K t) := by
    intro t
    exact SchwartzMap.ext fun x => hsplit (crossedLsAmplitudeScale p K t) x
  have hhigh_lone : ∀ t : ℝ, 0 < t →
      A * ∫ y, ‖high (crossedLsAmplitudeScale p K t) y‖ ≤ t / 2 := by
    intro t ht
    have hscale : 0 < crossedLsAmplitudeScale p K t :=
      crossedLsAmplitudeScale_pos hp1 hK ht
    have hhigh_bound := q4_rational_high_integral_le f
      (low (crossedLsAmplitudeScale p K t))
      (high (crossedLsAmplitudeScale p K t)) hscale hp1 hp2
      (hlow (crossedLsAmplitudeScale p K t))
      (hhigh (crossedLsAmplitudeScale p K t))
    have hAI : A * I ≤ K / 2 := by nlinarith [hbalance]
    have hAI_div : A * I / K ≤ (1 : ℝ) / 2 := by
      apply (div_le_iff₀ hK).mpr
      calc
        A * I ≤ K / 2 := hAI
        _ = ((1 : ℝ) / 2) * K := by ring
    calc
      A * ∫ y, ‖high (crossedLsAmplitudeScale p K t) y‖ ≤
          A * ((crossedLsAmplitudeScale p K t) ^ (1 - p) *
            ∫ y, ‖f y‖ ^ p) :=
        mul_le_mul_of_nonneg_left hhigh_bound hA
      _ = A * ((crossedLsAmplitudeScale p K t) ^ (1 - p) * I) := by rw [hI]
      _ = A * ((t / K) * I) := by
        rw [crossedLsAmplitudeScale_rpow_one_sub hp1 hK ht]
      _ = t * (A * I / K) := by
        field_simp [hK.ne']
      _ ≤ t * ((1 : ℝ) / 2) := mul_le_mul_of_nonneg_left hAI_div ht.le
      _ = t / 2 := by ring
  have hprofiles := measurable_rational_low_high_profile_lintegrals
    (μ := volume) f low high hlow hhigh
  have hscale_meas : Measurable (crossedLsAmplitudeScale p K) :=
    measurable_crossedLsAmplitudeScale hp1
  have hlowProfile_s : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ s)) := by
    have hliteral : Measurable (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal
          (‖((1 + ‖(z.1⁻¹ : ℝ) • f z.2‖ ^ 2) ^ (-1 : ℝ)) • f z.2‖ ^ s)) :=
      ENNReal.continuous_ofReal.measurable.comp
        ((continuous_id.rpow_const (fun _ => Or.inr hs.le)).measurable.comp
          (measurable_rational_low_family f).norm)
    have hchoice : (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal (‖low z.1 z.2‖ ^ s)) =
        (fun z : ℝ × Euclidean d =>
          ENNReal.ofReal
            (‖((1 + ‖(z.1⁻¹ : ℝ) • f z.2‖ ^ 2) ^ (-1 : ℝ)) • f z.2‖ ^ s)) := by
      funext z
      rw [hlow z.1 z.2]
    have hprod : Measurable (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal (‖low z.1 z.2‖ ^ s)) := by
      rw [hchoice]
      exact hliteral
    exact hprod.lintegral_prod_right
  apply crossed_marcinkiewicz_strong_of_lone_ls_split
    Set.univ (fun (g : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d) => g x)
    T hT_nonneg (fun g h _ _ x => hT_subadd g h x)
    A hA (fun g _ x => hLone g x) hs Cs
    (fun g _ u hu => hweak_s g hu) hqs f (hT_meas f)
    (fun t => low (crossedLsAmplitudeScale p K t))
    (fun t => high (crossedLsAmplitudeScale p K t))
    (fun _ => Set.mem_univ _) (fun _ => Set.mem_univ _) hsplit'
    hhigh_lone
    (by simpa only [Function.comp_def] using hlowProfile_s.comp hscale_meas)
    Atail
  simpa only [Function.comp_def] using hRationalTail low high hlow hhigh

/-- Scalar residue of the rational Schwartz cutoff at a general diagonal
exponent `s`.  This is the calculation which keeps the non-hard part of the
cutoff inside the Schwartz class. -/
theorem crossed_rational_residual_tail_scalar_s
    {u p q s K : ℝ} (hu : 0 < u) (hp1 : 1 < p) (_hps : p < s)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K) :
    ENNReal.ofReal (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
        (∫⁻ t in Ioi (K / u ^ (p - 1)),
          (ENNReal.ofReal t) ^ (q - s - 1 - s / (p - 1))) =
      ENNReal.ofReal
        (((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s) * u ^ p) := by
  have hpminus : 0 < p - 1 := by linarith
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hpconj : 0 < p / (p - 1) := div_pos hp0 hpminus
  have hupow : 0 < u ^ (p - 1) := Real.rpow_pos_of_pos hu _
  have hthreshold : 0 < K / u ^ (p - 1) := div_pos hK hupow
  have hexponent : q - s - 1 - s / (p - 1) =
      (2 - p / (p - 1)) - 3 := by
    rw [hq]
    field_simp [hpminus.ne']
    ring
  rw [hexponent]
  rw [lintegral_rpow_Ioi_eq (p := 2 - p / (p - 1)) (by linarith) hthreshold]
  have hthreshold_pow :
      (K / u ^ (p - 1)) ^ ((2 - p / (p - 1)) - 2) =
        K ^ (-(p / (p - 1))) * u ^ p := by
    have hpow : (u ^ (p - 1)) ^ (p / (p - 1)) = u ^ p := by
      rw [← Real.rpow_mul hu.le]
      congr 1
      field_simp [hpminus.ne']
    rw [show (2 - p / (p - 1)) - 2 = -(p / (p - 1)) by ring]
    rw [Real.div_rpow hK.le hupow.le]
    rw [Real.rpow_neg hK.le, Real.rpow_neg hupow.le, hpow, div_eq_mul_inv, inv_inv]
  have hKpow : K ^ (s / (p - 1)) * K ^ (-(p / (p - 1))) =
      K ^ (q - s) := by
    rw [← Real.rpow_add hK]
    congr 1
    rw [hq]
    field_simp [hpminus.ne']
    ring
  have hreal :
      (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
          ((K / u ^ (p - 1)) ^ ((2 - p / (p - 1)) - 2) /
            (2 - (2 - p / (p - 1)))) =
        ((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s) * u ^ p := by
    rw [hthreshold_pow]
    rw [show 2 - (2 - p / (p - 1)) = p / (p - 1) by ring]
    calc
      (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
          (K ^ (-(p / (p - 1))) * u ^ p / (p / (p - 1))) =
          ((K ^ (s / (p - 1)) * K ^ (-(p / (p - 1)))) /
            ((2 : ℝ) ^ s * (p / (p - 1)))) * u ^ p := by ring
      _ = (K ^ (q - s) / ((2 : ℝ) ^ s * (p / (p - 1))) * u ^ p) := by
        rw [hKpow]
      _ = _ := by
        rw [Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2)]
        have h2ne : ((2 : ℝ) ^ s)⁻¹ ≠ 0 :=
          inv_ne_zero (Real.rpow_pos_of_pos (by norm_num) s).ne'
        have h2ne' : (2 : ℝ) ^ s ≠ 0 := (Real.rpow_pos_of_pos (by norm_num) s).ne'
        field_simp
  rw [← ENNReal.ofReal_mul
    (div_nonneg (Real.rpow_nonneg hK.le _) (Real.rpow_nonneg (by norm_num) _))]
  rw [hreal]

/-- Rewrite the residual after inserting the height-dependent amplitude
scale. -/
theorem crossed_rational_rescaled_weight_s
    {p q s K t : ℝ} (hp1 : 1 < p) (hK : 0 < K) (ht : 0 < t) :
    ENNReal.ofReal
        ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s) *
        (ENNReal.ofReal t) ^ (q - s - 1) =
      ENNReal.ofReal (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
        (ENNReal.ofReal t) ^ (q - s - 1 - s / (p - 1)) := by
  have hpminus : p - 1 ≠ 0 := by linarith
  have hbase : 0 < K / t := div_pos hK ht
  have hpow :
      (((K / t) ^ ((p - 1)⁻¹)) ^ s) = (K / t) ^ (s / (p - 1)) := by
    rw [← Real.rpow_mul hbase.le]
    congr 1
    field_simp [hpminus]
  have hreal :
      ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s) * t ^ (q - s - 1) =
        (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
          t ^ (q - s - 1 - s / (p - 1)) := by
    have key : ∀ A T B C : ℝ, A / T / C * B = A / C * (B / T) := by
      intro A T B C
      ring
    rw [hpow, Real.div_rpow hK.le ht.le]
    conv_rhs => rw [Real.rpow_sub ht]
    exact key _ _ _ _
  rw [ENNReal.ofReal_rpow_of_pos ht, ENNReal.ofReal_rpow_of_pos ht,
    ← ENNReal.ofReal_mul (div_nonneg
      (Real.rpow_nonneg (Real.rpow_nonneg hbase.le _) _)
      (Real.rpow_nonneg (by norm_num) _)),
    ← ENNReal.ofReal_mul (div_nonneg (Real.rpow_nonneg hK.le _)
      (Real.rpow_nonneg (by norm_num) _)), hreal]

/-- Tonelli estimate for the non-hard residual of the rational low cutoff.
The threshold is `K < t * u^(p-1)`; at that threshold the smooth low part
is at most half the amplitude scale. -/
theorem crossed_rational_residual_tail_s
    {α : Type*} [MeasurableSpace α] {μ : Measure α} [SFinite μ]
    (u : α → ℝ) (hu : Measurable u) (hu_nonneg : ∀ x, 0 ≤ u x)
    {p q s K : ℝ} (hp1 : 1 < p) (hps : p < s)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K) :
    (∫⁻ t in Ioi (0 : ℝ),
      ((∫⁻ x,
        {x | K < t * (u x) ^ (p - 1)}.indicator
          (fun _ => ENNReal.ofReal
            ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ∂μ) *
        (ENNReal.ofReal t) ^ (q - s - 1))) ≤
      ENNReal.ofReal (((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s)) *
        ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
  let a : α → ℝ := fun x => K / (u x) ^ (p - 1)
  let v : α → ENNReal := fun x =>
    ({x | 0 < u x}.indicator (fun _ => (1 : ENNReal)) x)
  let w : ℝ → ENNReal := fun t =>
    ENNReal.ofReal (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
      (ENNReal.ofReal t) ^ (q - s - 1 - s / (p - 1))
  have hpminus : 0 < p - 1 := by linarith
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hpow : Measurable (fun x => (u x) ^ (p - 1)) := by
    exact (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hu
  have ha : Measurable a := measurable_const.div hpow
  have ha_nonneg : ∀ x, 0 ≤ a x := by
    intro x
    exact div_nonneg hK.le (Real.rpow_nonneg (hu_nonneg x) _)
  have hv : Measurable v := by
    exact measurable_const.indicator (measurableSet_lt measurable_const hu)
  have hw : Measurable w := by
    exact measurable_const.mul
      (ENNReal.continuous_rpow_const.measurable.comp
        ENNReal.continuous_ofReal.measurable)
  have hcut_meas (t : ℝ) : Measurable (fun x =>
      {x | K < t * (u x) ^ (p - 1)}.indicator
        (fun _ => ENNReal.ofReal
          ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x) := by
    exact measurable_const.indicator
      (measurableSet_lt measurable_const (measurable_const.mul hpow))
  have hpoint (t : ℝ) (ht : 0 < t) (x : α) :
      (ENNReal.ofReal t) ^ (q - s - 1) *
          {x | K < t * (u x) ^ (p - 1)}.indicator
            (fun _ => ENNReal.ofReal
              ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ≤
        w t * ({x | a x < t}.indicator v x) := by
    by_cases hzero : u x = 0
    · have hpowzero : (u x) ^ (p - 1) = 0 := by
        rw [hzero, Real.zero_rpow hpminus.ne']
      have hnotcut : ¬ K < t * (u x) ^ (p - 1) := by
        rw [hpowzero]
        linarith
      have hind : ({x | K < t * (u x) ^ (p - 1)}.indicator
          (fun _ => ENNReal.ofReal
            ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x) = 0 := by
        apply Set.indicator_of_notMem
        simpa only [Set.mem_setOf_eq] using hnotcut
      rw [hind, mul_zero]
      exact zero_le
    · have hupos : 0 < u x := lt_of_le_of_ne (hu_nonneg x) (Ne.symm hzero)
      have hupow : 0 < (u x) ^ (p - 1) := Real.rpow_pos_of_pos hupos _
      have hcut : K < t * (u x) ^ (p - 1) ↔ a x < t := by
        dsimp only [a]
        exact (div_lt_iff₀ hupow).symm
      by_cases hmem : K < t * (u x) ^ (p - 1)
      · have hvone : v x = 1 := by simp [v, hupos]
        have hscale := crossed_rational_rescaled_weight_s hp1 hK ht (q := q) (s := s)
        rw [show {x | K < t * (u x) ^ (p - 1)}.indicator
              (fun _ => ENNReal.ofReal
                ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x =
              ENNReal.ofReal ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s) from by
              simp [hmem]]
        rw [show ({x | a x < t}.indicator v x) = 1 from by
          simp [hcut.mp hmem, hvone]]
        simp only [mul_one, w]
        rw [mul_comm, hscale]
      · have hnot : ¬ a x < t := by simpa only [hcut] using hmem
        simp [hmem, hnot]
  have houter :
      (∫⁻ t in Ioi (0 : ℝ),
        ((∫⁻ x,
          {x | K < t * (u x) ^ (p - 1)}.indicator
            (fun _ => ENNReal.ofReal
              ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ∂μ) *
          (ENNReal.ofReal t) ^ (q - s - 1))) ≤
        ∫⁻ t in Ioi (0 : ℝ),
          w t * ∫⁻ x in {x | a x < t}, v x ∂μ := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    have hleft :
        (∫⁻ x,
          {x | K < t * (u x) ^ (p - 1)}.indicator
            (fun _ => ENNReal.ofReal
              ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ∂μ) *
            (ENNReal.ofReal t) ^ (q - s - 1) =
          ∫⁻ x, (ENNReal.ofReal t) ^ (q - s - 1) *
            {x | K < t * (u x) ^ (p - 1)}.indicator
              (fun _ => ENNReal.ofReal
                ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ∂μ := by
      rw [mul_comm, ← lintegral_const_mul _ (hcut_meas t)]
    have hright :
        (∫⁻ x, w t * ({x | a x < t}.indicator v x) ∂μ) =
          w t * ∫⁻ x in {x | a x < t}, v x ∂μ := by
      calc
        (∫⁻ x, w t * ({x | a x < t}.indicator v x) ∂μ) =
            w t * ∫⁻ x, ({x | a x < t}.indicator v x) ∂μ :=
          lintegral_const_mul _ (hv.indicator (measurableSet_lt ha measurable_const))
        _ = w t * ∫⁻ x in {x | a x < t}, v x ∂μ := by
          rw [lintegral_indicator (measurableSet_lt ha measurable_const)]
    rw [hleft, ← hright]
    apply lintegral_mono
    intro x
    exact hpoint t ht x
  have hswap :
      (∫⁻ t in Ioi (0 : ℝ),
          w t * ∫⁻ x in {x | a x < t}, v x ∂μ) =
        ∫⁻ x, v x * (∫⁻ t in Ioi (a x), w t) ∂μ := by
    exact lintegral_swap_indicator_lt a ha ha_nonneg v hv w hw
  have hpointwise (x : α) :
      v x * (∫⁻ t in Ioi (a x), w t) ≤
        ENNReal.ofReal (((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s)) *
          (ENNReal.ofReal (u x)) ^ p := by
    by_cases hzero : u x = 0
    · simp [v, hzero]
    · have hupos : 0 < u x := lt_of_le_of_ne (hu_nonneg x) (Ne.symm hzero)
      have hvone : v x = 1 := by simp [v, hupos]
      rw [hvone, one_mul]
      change (∫⁻ t in Ioi (K / (u x) ^ (p - 1)),
        ENNReal.ofReal (K ^ (s / (p - 1)) / (2 : ℝ) ^ s) *
          (ENNReal.ofReal t) ^ (q - s - 1 - s / (p - 1))) ≤ _
      rw [lintegral_const_mul _ (show Measurable
        (fun t : ℝ => (ENNReal.ofReal t) ^ (q - s - 1 - s / (p - 1))) from
        ENNReal.continuous_rpow_const.measurable.comp
          ENNReal.continuous_ofReal.measurable)]
      rw [crossed_rational_residual_tail_scalar_s hupos hp1 hps hq hK]
      have hconstant : 0 ≤ ((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s) := by
        exact mul_nonneg
          (div_nonneg (Real.rpow_nonneg (by norm_num) _)
            (div_nonneg hp0.le hpminus.le))
          (Real.rpow_nonneg hK.le _)
      rw [ENNReal.ofReal_mul hconstant, ENNReal.ofReal_rpow_of_pos hupos]
  calc
    (∫⁻ t in Ioi (0 : ℝ),
      ((∫⁻ x,
        {x | K < t * (u x) ^ (p - 1)}.indicator
          (fun _ => ENNReal.ofReal
            ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x ∂μ) *
        (ENNReal.ofReal t) ^ (q - s - 1))) ≤
        ∫⁻ t in Ioi (0 : ℝ),
          w t * ∫⁻ x in {x | a x < t}, v x ∂μ := houter
    _ = ∫⁻ x, v x * (∫⁻ t in Ioi (a x), w t) ∂μ := hswap
    _ ≤ ∫⁻ x,
        ENNReal.ofReal (((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s)) *
          (ENNReal.ofReal (u x)) ^ p ∂μ := by
      apply lintegral_mono
      intro x
      exact hpointwise x
    _ = _ := lintegral_const_mul _
      (ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal)

/-- The rational Schwartz low member, evaluated at the crossed amplitude
scale, has the weighted `Lˢ` tail required by the generalized layer-cake
argument.  The first summand is the hard power cutoff and the second is the
rational residue from `crossed_rational_residual_tail_s`. -/
theorem crossed_rational_schwartz_low_tail_s
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex)
    (low high : ℝ → SchwartzMap (Euclidean d) Complex)
    (hlow : ∀ t x, low t x =
      ((1 + ‖(t⁻¹ : ℝ) • f x‖ ^ 2) ^ (-1 : ℝ)) • f x)
    (_hhigh : ∀ t, high t = f - low t)
    {p q s K : ℝ} (hp1 : 1 < p) (hps : p < s)
    (hq : q = p * (s - 1) / (p - 1)) (hK : 0 < K) :
    (∫⁻ t in Ioi (0 : ℝ),
      (∫⁻ x, ENNReal.ofReal
        (‖low (crossedLsAmplitudeScale p K t) x‖ ^ s)) *
        (ENNReal.ofReal t) ^ (q - s - 1)) ≤
      (((ENNReal.ofReal (q - s))⁻¹ * (ENNReal.ofReal K) ^ (q - s)) +
        ENNReal.ofReal (((2 : ℝ) ^ (-s) / (p / (p - 1))) * K ^ (q - s))) *
        ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
  let u : Euclidean d → ℝ := fun x => ‖f x‖
  let cut : ℝ → Euclidean d → ℝ := fun t x => q4PowerCutoffLow p K t u x
  let residual : ℝ → Euclidean d → ENNReal := fun t x =>
    ({x | K < t * (u x) ^ (p - 1)}.indicator
      (fun _ => ENNReal.ofReal
        ((((K / t) ^ ((p - 1)⁻¹)) ^ s) / (2 : ℝ) ^ s)) x)
  let w : ℝ → ENNReal := fun t => (ENNReal.ofReal t) ^ (q - s - 1)
  let lowI : ℝ → ENNReal := fun t =>
    ∫⁻ x, ENNReal.ofReal (‖low (crossedLsAmplitudeScale p K t) x‖ ^ s)
  let cutI : ℝ → ENNReal := fun t =>
    ∫⁻ x, ENNReal.ofReal (‖cut t x‖ ^ s)
  let residualI : ℝ → ENNReal := fun t => ∫⁻ x, residual t x
  have hpminus : 0 < p - 1 := by linarith
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hs0 : 0 < s := hp0.trans hps
  have hsnonneg : 0 ≤ s := hs0.le
  have hu : Measurable u := by
    simpa only [u] using f.continuous.norm.measurable
  have hunonneg : ∀ x, 0 ≤ u x := fun x => norm_nonneg _
  have habs : ∀ x, |u x| = u x := fun x => abs_of_nonneg (hunonneg x)
  have hscale_meas : Measurable (crossedLsAmplitudeScale p K) :=
    measurable_crossedLsAmplitudeScale hp1
  have hlowProfile : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ s)) := by
    have hliteral : Measurable (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal
          (‖((1 + ‖(z.1⁻¹ : ℝ) • f z.2‖ ^ 2) ^ (-1 : ℝ)) • f z.2‖ ^ s)) := by
      exact ENNReal.continuous_ofReal.measurable.comp
        ((continuous_id.rpow_const (fun _ => Or.inr hsnonneg)).measurable.comp
          (measurable_rational_low_family f).norm)
    have hchoice : (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal (‖low z.1 z.2‖ ^ s)) =
        (fun z : ℝ × Euclidean d =>
          ENNReal.ofReal
            (‖((1 + ‖(z.1⁻¹ : ℝ) • f z.2‖ ^ 2) ^ (-1 : ℝ)) • f z.2‖ ^ s)) := by
      funext z
      rw [hlow z.1 z.2]
    have hprod : Measurable (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal (‖low z.1 z.2‖ ^ s)) := by
      rw [hchoice]
      exact hliteral
    exact hprod.lintegral_prod_right
  have hlowI_meas : Measurable lowI := by
    simpa only [lowI, Function.comp_def] using hlowProfile.comp hscale_meas
  have hcutProd_meas : Measurable (fun z : ℝ × Euclidean d =>
      ENNReal.ofReal (‖cut z.1 z.2‖ ^ s)) := by
    let S : Set (ℝ × Euclidean d) :=
      {z | z.1 * (u z.2) ^ (p - 1) ≤ K}
    have hS : MeasurableSet S :=
      measurableSet_le
        (measurable_fst.mul
          ((continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp
            (hu.comp measurable_snd))) measurable_const
    have hbase : Measurable (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal ((u z.2) ^ s)) :=
      ENNReal.continuous_ofReal.measurable.comp
        ((continuous_id.rpow_const (fun _ => Or.inr hsnonneg)).measurable.comp
          (hu.comp measurable_snd))
    have heq : (fun z : ℝ × Euclidean d =>
        ENNReal.ofReal (‖cut z.1 z.2‖ ^ s)) =
        S.indicator (fun z => ENNReal.ofReal ((u z.2) ^ s)) := by
      funext z
      by_cases hz : z ∈ S
      · have hzS : z ∈ S := hz
        simp only [S, Set.mem_setOf_eq] at hz
        simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hz,
          Set.indicator_of_mem hzS]
      · have hzS : z ∉ S := hz
        simp only [S, Set.mem_setOf_eq] at hz
        simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hz,
          Set.indicator_of_notMem hzS, Real.zero_rpow hs0.ne']
    rw [heq]
    exact hbase.indicator hS
  have hcutI_meas : Measurable cutI := by
    simpa only [cutI] using hcutProd_meas.lintegral_prod_right
  have hcut_fun_meas (t : ℝ) : Measurable (fun x =>
      ENNReal.ofReal (‖cut t x‖ ^ s)) := by
    have hset : MeasurableSet {x : Euclidean d |
        t * (u x) ^ (p - 1) ≤ K} :=
      measurableSet_le (measurable_const.mul
        ((continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hu))
        measurable_const
    have hbase : Measurable (fun x : Euclidean d =>
        ENNReal.ofReal ((u x) ^ s)) :=
      ENNReal.continuous_ofReal.measurable.comp
        ((continuous_id.rpow_const (fun _ => Or.inr hsnonneg)).measurable.comp hu)
    have heq : (fun x => ENNReal.ofReal (‖cut t x‖ ^ s)) =
        ({x | t * (u x) ^ (p - 1) ≤ K}.indicator
          (fun x => ENNReal.ofReal ((u x) ^ s)) : Euclidean d → ENNReal) := by
      funext x
      by_cases hx : t * (u x) ^ (p - 1) ≤ K
      · simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hx]
      · simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hx,
          Real.zero_rpow hs0.ne']
    rw [heq]
    exact hbase.indicator hset
  have hw : Measurable w :=
    ENNReal.continuous_rpow_const.measurable.comp ENNReal.continuous_ofReal.measurable
  have hcut_tail := crossed_low_tail_of_power_cutoff_s
    (μ := volume) u hu hunonneg hp1 hps hq hK cut hcutI_meas (by
      intro t x ht
      by_cases hcut : t * (u x) ^ (p - 1) ≤ K
      · simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hcut]
      · simp [cut, q4PowerCutoffLow, Real.norm_eq_abs, habs, hcut,
          Real.zero_rpow hs0.ne'])
  have hresidual_tail := crossed_rational_residual_tail_s
    (μ := volume) u hu hunonneg hp1 hps hq hK
  have hnorm_le_u (t : ℝ) (ht : 0 < t) (x : Euclidean d) :
      ‖low (crossedLsAmplitudeScale p K t) x‖ ≤ u x := by
    have hscale : 0 < crossedLsAmplitudeScale p K t :=
      crossedLsAmplitudeScale_pos hp1 hK ht
    have hsq : ‖low (crossedLsAmplitudeScale p K t) x‖ ^ 2 ≤ (u x) ^ 2 := by
      rw [hlow (crossedLsAmplitudeScale p K t) x,
        norm_rational_low_amplitude (f x) hscale]
      exact (rational_low_amplitude_sq_le_min (norm_nonneg _) hscale).trans
        (min_le_left _ _)
    exact (sq_le_sq₀ (norm_nonneg _) (hunonneg x)).mp hsq
  have hnorm_le_scale_half (t : ℝ) (ht : 0 < t) (x : Euclidean d) :
      ‖low (crossedLsAmplitudeScale p K t) x‖ ≤
        crossedLsAmplitudeScale p K t / 2 := by
    have hscale : 0 < crossedLsAmplitudeScale p K t :=
      crossedLsAmplitudeScale_pos hp1 hK ht
    have hsq : ‖low (crossedLsAmplitudeScale p K t) x‖ ^ 2 ≤
        (crossedLsAmplitudeScale p K t / 2) ^ 2 := by
      rw [hlow (crossedLsAmplitudeScale p K t) x,
        norm_rational_low_amplitude (f x) hscale]
      calc
        (‖f x‖ / (1 + (‖f x‖ / crossedLsAmplitudeScale p K t) ^ 2)) ^ 2 ≤
            (crossedLsAmplitudeScale p K t ^ 2 / 4) :=
          (rational_low_amplitude_sq_le_min (norm_nonneg _) hscale).trans
            (min_le_right _ _)
        _ = (crossedLsAmplitudeScale p K t / 2) ^ 2 := by ring
    exact (sq_le_sq₀ (norm_nonneg _)
      (by positivity : 0 ≤ crossedLsAmplitudeScale p K t / 2)).mp hsq
  have hpoint (t : ℝ) (ht : 0 < t) (x : Euclidean d) :
      ENNReal.ofReal (‖low (crossedLsAmplitudeScale p K t) x‖ ^ s) ≤
        ENNReal.ofReal (‖cut t x‖ ^ s) + residual t x := by
    by_cases hcut : t * (u x) ^ (p - 1) ≤ K
    · have hpow : ‖low (crossedLsAmplitudeScale p K t) x‖ ^ s ≤ (u x) ^ s :=
        Real.rpow_le_rpow (norm_nonneg _) (hnorm_le_u t ht x) hsnonneg
      have hcut_eq : cut t x = u x := by
        have hmem : x ∈ {y : Euclidean d | t * ‖u y‖ ^ (p - 1) ≤ K} := by
          simpa only [Set.mem_setOf_eq, Real.norm_eq_abs, habs] using hcut
        simp only [cut, q4PowerCutoffLow, Set.indicator_of_mem hmem]
      have hresidual_zero : residual t x = 0 := by
        have hnot : ¬ K < t * (u x) ^ (p - 1) := not_lt_of_ge hcut
        simp [residual, hnot]
      rw [hcut_eq, hresidual_zero]
      simpa [u, Real.norm_eq_abs, abs_of_nonneg (hunonneg x)] using
