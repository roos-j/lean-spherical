    {q : ENNReal} (hq : 1 ≤ q)
    (C ρ : ENNReal)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤ C * ρ ^ n) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤ C * (1 - ρ)⁻¹ := by
  let F : ℕ → X × {i // i ∈ activeDyadicIndices E j} → ℂ := fun n =>
    q4FiniteProductKernelShell μ (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν =
        eLpNorm (fun z => ∑ n ∈ Finset.range (j + 3), F n z) q ν := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      exact q4FiniteProductKernelShell_activeDyadic_eq_sum_gapLevels
          hj hE μ K g z
    _ ≤ C * (1 - ρ)⁻¹ :=
      eLpNorm_sum_range_le_geometric ν q hq F
        (fun n => by simpa only [F] using hmeas n)
        C ρ (fun n => by simpa only [F] using hlevel n) (j + 3)

/-- Operator-norm form of the preceding finite-product geometric summation.
At the strict `Q4` exponents take `p = q'`; the per-level estimates supplied
by literal `L¹ → L∞`/`L² → L²` interpolation then give the displayed strong
`L^{q'} → L^q` bound for the full active radius family. -/
theorem q4ActiveDyadicFullProduct_strong_le_of_geometric_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {p q : ENNReal} (hq : 1 ≤ q)
    (C ρ : ENNReal)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
          C * ρ ^ n * eLpNorm g p ν) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      (C * (1 - ρ)⁻¹) * eLpNorm g p ν := by
  have hsum := q4ActiveDyadicFullProduct_eLpNorm_le_of_geometric_level_bounds
    hj hE μ ν K g hq (C * eLpNorm g p ν) ρ hmeas
    (fun n => by
      simpa only [mul_assoc, mul_left_comm, mul_comm] using hlevel n)
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
        (C * eLpNorm g p ν) * (1 - ρ)⁻¹ := hsum
    _ = (C * (1 - ρ)⁻¹) * eLpNorm g p ν := by
      ac_rfl

/-- Reassembly of a literal Q4 level normal form in the ordinary
strict-gap regime.  The hypothesis is the exponential coefficient obtained
after inserting the physical pair-kernel, Fourier multiplier, and
upper-spectrum counting estimates into the crossed shell calculation.  This
lemma performs only the exact finite level reassembly: it separates the
frequency factor from the gap ratio and invokes ordinary Minkowski/geometric
summation. -/
theorem q4ActiveDyadicFullProduct_eLpNorm_le_of_strict_exponential_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    {d : ℕ} {gamma eta C theta : ℝ} (hC : 0 ≤ C)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
        ENNReal.ofReal (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ) +
            q4GapExponent d gamma theta * (n : ℝ)))) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      ENNReal.ofReal
        (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ))) *
        (1 - ENNReal.ofReal ((2 : ℝ) ^
          q4GapExponent d gamma theta))⁻¹ := by
  let a : ℝ := q4FrequencyExponentWithSubpowerLoss d theta eta
  let b : ℝ := q4GapExponent d gamma theta
  let Cj : ENNReal := ENNReal.ofReal (C * (2 : ℝ) ^ (a * (j : ℝ)))
  let rho : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ b)
  have hr : 0 ≤ (2 : ℝ) ^ b := Real.rpow_nonneg (by norm_num) _
  have hlevel' : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤ Cj * rho ^ n := by
    intro n
    calc
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
          ENNReal.ofReal (C * (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss d theta eta * (j : ℝ) +
              q4GapExponent d gamma theta * (n : ℝ))) := hlevel n
      _ = Cj * rho ^ n := by
        have hCj : 0 ≤ C * (2 : ℝ) ^ (a * (j : ℝ)) :=
          mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
        change ENNReal.ofReal (C * (2 : ℝ) ^
          (a * (j : ℝ) + b * (n : ℝ))) =
            ENNReal.ofReal (C * (2 : ℝ) ^ (a * (j : ℝ))) *
              (ENNReal.ofReal ((2 : ℝ) ^ b)) ^ n
        rw [← ENNReal.ofReal_pow hr n, ← ENNReal.ofReal_mul hCj]
        congr 1
        rw [← Real.rpow_mul_natCast (by norm_num : (0 : ℝ) ≤ 2) b n, mul_assoc,
          ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  have hsum := q4ActiveDyadicFullProduct_eLpNorm_le_of_geometric_level_bounds
    hj hE μ ν K g hq Cj rho hmeas hlevel'
  simpa only [a, b, Cj, rho] using hsum

/-- The finite-range planar-critical reassembly.  This is the `d = 2`,
`gamma = 1/2` alternative to the ordinary decreasing-gap geometric series:
the actual active relation has exactly `n < j + 3`, and the *increasing*
gap progression is summed at its last level.  The resulting dyadic base is
strictly below one as soon as `theta > 1/2`.

The conclusion is for the literal full finite-product kernel on the concrete
active radius subtype; no selected positive majorant is inserted. -/
theorem q4ActiveDyadicFullProduct_eLpNorm_le_of_planar_critical_level_bounds
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    {theta C : ℝ} (htheta : 1 / 2 < theta) (hC : 0 ≤ C)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
        ENNReal.ofReal (C * (2 : ℝ) ^
          (q4FrequencyExponent 2 theta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ)))) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      ENNReal.ofReal
        (C * (((2 : ℝ) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : ℝ) ^ (theta - 1 / 2) - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 - theta))) ^ j := by
  let F : ℕ → X × {i // i ∈ activeDyadicIndices E j} → ℂ := fun n =>
    q4FiniteProductKernelShell μ (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g
  let b : ℝ := theta - 1 / 2
  let r : ℝ := (2 : ℝ) ^ (1 / 2 - theta)
  let D : ℝ := ((2 : ℝ) ^ b) ^ 3 / ((2 : ℝ) ^ b - 1)
  have hbpos : 0 < b := by
    dsimp [b]
    linarith
  have hbasegt : 1 < (2 : ℝ) ^ b :=
    Real.one_lt_rpow (by norm_num) hbpos
  have hD : 0 ≤ D := by
    dsimp [D]
    exact div_nonneg
      (pow_nonneg (Real.rpow_nonneg (by norm_num) _) _)
      (sub_pos.mpr hbasegt).le
  have hr : 0 ≤ r := by
    dsimp [r]
    exact Real.rpow_nonneg (by norm_num) _
  have hscalar :
      (∑ n ∈ Finset.range (j + 3),
        (2 : ℝ) ^
          (q4FrequencyExponent 2 theta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ))) ≤ D * r ^ j := by
    simpa only [D, b, r] using
      q4_planar_critical_finite_level_sum_le htheta j
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν =
        eLpNorm (fun z => ∑ n ∈ Finset.range (j + 3), F n z) q ν := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      exact q4FiniteProductKernelShell_activeDyadic_eq_sum_gapLevels
          hj hE μ K g z
    _ ≤ ∑ n ∈ Finset.range (j + 3), eLpNorm (F n) q ν := by
      have hfun : (fun z => ∑ n ∈ Finset.range (j + 3), F n z)
          = ∑ n ∈ Finset.range (j + 3), F n := by
        funext z
        simp [Finset.sum_apply]
      rw [hfun]
      exact eLpNorm_sum_le hq
    _ ≤ ∑ n ∈ Finset.range (j + 3), ENNReal.ofReal
        (C * (2 : ℝ) ^
          (q4FrequencyExponent 2 theta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ))) := by
      exact Finset.sum_le_sum fun n hn => hlevel n
    _ = ENNReal.ofReal
        (C * ∑ n ∈ Finset.range (j + 3),
          (2 : ℝ) ^
            (q4FrequencyExponent 2 theta * (j : ℝ) +
              q4GapExponent 2 (1 / 2) theta * (n : ℝ))) := by
      rw [← ENNReal.ofReal_sum_of_nonneg]
      · rw [Finset.mul_sum]
      · intro n hn
        exact mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
    _ ≤ ENNReal.ofReal (C * (D * r ^ j)) := by
      apply ENNReal.ofReal_le_ofReal
      exact mul_le_mul_of_nonneg_left hscalar hC
    _ = ENNReal.ofReal
        (C * (((2 : ℝ) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : ℝ) ^ (theta - 1 / 2) - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 - theta))) ^ j := by
      change ENNReal.ofReal (C * (D * r ^ j)) =
        ENNReal.ofReal (C * D) * (ENNReal.ofReal r) ^ j
      calc
        ENNReal.ofReal (C * (D * r ^ j)) =
            ENNReal.ofReal ((C * D) * (r ^ j)) := by
          congr 1
          ring
        _ = ENNReal.ofReal (C * D) * ENNReal.ofReal (r ^ j) :=
          ENNReal.ofReal_mul (mul_nonneg hC hD)
        _ = ENNReal.ofReal (C * D) * (ENNReal.ofReal r) ^ j := by
          rw [ENNReal.ofReal_pow hr j]

/-- The planar-critical finite reassembly with the quasi-Assouad subpower
loss retained in the frequency exponent.  This is the form used by the
literal Q4 shell calculation: the cover loss is paid before summing the
finite range `n < j + 3`, and the increasing gap progression is absorbed at
its final allowed level. -/
theorem q4ActiveDyFullProd_eLpNorm_le_of_plan_critical_level_bounds_with_subpower_loss
    {X : Type*} [Sub X] [MeasurableSpace X]
    {E : Set ℝ} {j : ℕ}
    (hj : 1 ≤ j) (hE : E ⊆ Icc (1 : ℝ) 2)
    (μ : Measure X)
    (ν : Measure (X × {i // i ∈ activeDyadicIndices E j}))
    (K : ℤ → ℤ → X → ℂ)
    (g : X × {i // i ∈ activeDyadicIndices E j} → ℂ)
    {q : ENNReal} (hq : 1 ≤ q)
    {theta eta C : ℝ} (htheta : 1 / 2 < theta) (hC : 0 ≤ C)
    (hmeas : ∀ n, AEStronglyMeasurable
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
          activeDyadicGapLevel n) K g) ν)
    (hlevel : ∀ n,
      eLpNorm
        (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
          (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
            activeDyadicGapLevel n) K g) q ν ≤
        ENNReal.ofReal (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ)))) :
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν ≤
      ENNReal.ofReal
        (C * (((2 : ℝ) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : ℝ) ^ (theta - 1 / 2) - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta))) ^ j := by
  let F : ℕ → X × {i // i ∈ activeDyadicIndices E j} → ℂ := fun n =>
    q4FiniteProductKernelShell μ (activeDyadicIndices E j)
      (q4LevelShellRelation (q4ActiveDyadicProductRelation E j)
        activeDyadicGapLevel n) K g
  let b : ℝ := theta - 1 / 2
  let r : ℝ := (2 : ℝ) ^
    (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
      q4GapExponent 2 (1 / 2) theta)
  let D : ℝ := ((2 : ℝ) ^ b) ^ 3 / ((2 : ℝ) ^ b - 1)
  have hbpos : 0 < b := by
    dsimp [b]
    linarith
  have hbasegt : 1 < (2 : ℝ) ^ b :=
    Real.one_lt_rpow (by norm_num) hbpos
  have hD : 0 ≤ D := by
    dsimp [D]
    exact div_nonneg
      (pow_nonneg (Real.rpow_nonneg (by norm_num) _) _)
      (sub_pos.mpr hbasegt).le
  have hr : 0 ≤ r := by
    dsimp [r]
    exact Real.rpow_nonneg (by norm_num) _
  have hscalar :
      (∑ n ∈ Finset.range (j + 3),
        (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ))) ≤ D * r ^ j := by
    simpa only [D, b, r] using
      q4_planar_critical_finite_level_sum_with_subpower_loss_le htheta j
  calc
    eLpNorm
      (q4FiniteProductKernelShell μ (activeDyadicIndices E j)
        (fun _ _ => True) K g) q ν =
        eLpNorm (fun z => ∑ n ∈ Finset.range (j + 3), F n z) q ν := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      exact q4FiniteProductKernelShell_activeDyadic_eq_sum_gapLevels
          hj hE μ K g z
    _ ≤ ∑ n ∈ Finset.range (j + 3), eLpNorm (F n) q ν := by
      have hfun : (fun z => ∑ n ∈ Finset.range (j + 3), F n z)
          = ∑ n ∈ Finset.range (j + 3), F n := by
        funext z
        simp [Finset.sum_apply]
      rw [hfun]
      exact eLpNorm_sum_le hq
    _ ≤ ∑ n ∈ Finset.range (j + 3), ENNReal.ofReal
        (C * (2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : ℝ) +
            q4GapExponent 2 (1 / 2) theta * (n : ℝ))) := by
      exact Finset.sum_le_sum fun n hn => hlevel n
    _ = ENNReal.ofReal
        (C * ∑ n ∈ Finset.range (j + 3),
          (2 : ℝ) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : ℝ) +
              q4GapExponent 2 (1 / 2) theta * (n : ℝ))) := by
      rw [← ENNReal.ofReal_sum_of_nonneg]
      · rw [Finset.mul_sum]
      · intro n hn
        exact mul_nonneg hC (Real.rpow_nonneg (by norm_num) _)
    _ ≤ ENNReal.ofReal (C * (D * r ^ j)) := by
      apply ENNReal.ofReal_le_ofReal
      exact mul_le_mul_of_nonneg_left hscalar hC
    _ = ENNReal.ofReal
        (C * (((2 : ℝ) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : ℝ) ^ (theta - 1 / 2) - 1))) *
        (ENNReal.ofReal ((2 : ℝ) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta))) ^ j := by
      change ENNReal.ofReal (C * (D * r ^ j)) =
        ENNReal.ofReal (C * D) * (ENNReal.ofReal r) ^ j
      calc
        ENNReal.ofReal (C * (D * r ^ j)) =
            ENNReal.ofReal ((C * D) * (r ^ j)) := by
              congr 1
              ring
        _ = ENNReal.ofReal (C * D) * ENNReal.ofReal (r ^ j) :=
          ENNReal.ofReal_mul (mul_nonneg hC hD)
        _ = ENNReal.ofReal (C * D) * (ENNReal.ofReal r) ^ j := by
          rw [ENNReal.ofReal_pow hr j]

end
end Former_Q4ActiveProductReassembly


