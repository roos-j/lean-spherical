    (fun i l => radiusGapShellNeighbors u L (dyadicLeft j i) (dyadicLeft j l))
    (q4ActiveDyadicPairKernel (absoluteDyadicBandpass phi hphiOne hphiZero j) j)
    (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)

/-- Expanded form of membership in the actual selected-shell domain. -/
theorem mem_q4MeasurableActiveDyadicAbsoluteEndpointShellDomain_iff
    {d : Nat} (E : Set Real) (j : Nat) (u L : Real)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex) (g : Euclidean d -> Complex) :
    g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
      phi hphiOne hphiZero f ↔
      ∀ i l x, Integrable
        (fun y => q4ActiveDyadicPairKernel
          (absoluteDyadicBandpass phi hphiOne hphiZero j) j i l (x - y) *
            q4SelectedFibre
              (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
                phi hphiOne hphiZero f) g l y)
        volume := Iff.rfl

/-- Each tie-broken endpoint-selection fibre is a measurable set. -/
theorem measurableSet_measurableActiveDyadicAbsoluteQ4EndpointSelector_eq
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex) (i : Int) :
    MeasurableSet {x : Euclidean d |
      measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
        phi hphiOne hphiZero f x = i} := by
  have hpre : MeasurableSet
      ((measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
        phi hphiOne hphiZero f) ⁻¹' ({i} : Set Int)) :=
    (measurable_measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
      phi hphiOne hphiZero f) (measurableSet_singleton i)
  convert hpre using 1
  ext x
  simp

/-- A measurable scalar input has measurable fibres for the actual
deterministic endpoint selector. -/
theorem measurable_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (hg : Measurable g) (i : Int) :
    Measurable (q4SelectedFibre
      (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
      g i) := by
  let rho := measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f
  have hset : MeasurableSet {x : Euclidean d | rho x = i} :=
    measurableSet_measurableActiveDyadicAbsoluteQ4EndpointSelector_eq E j hs
      phi hphiOne hphiZero f i
  change Measurable (fun x => if rho x = i then g x else 0)
  exact Measurable.ite hset hg measurable_const

/-- An integrable scalar input has integrable selected fibres for the actual
measurable endpoint selector. -/
theorem integrable_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (hg : Integrable g volume) (i : Int) :
    Integrable (q4SelectedFibre
      (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
      g i) volume := by
  let rho := measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f
  let P : Set (Euclidean d) := {x | rho x = i}
  have hP : MeasurableSet P := by
    simpa only [P] using
      (measurableSet_measurableActiveDyadicAbsoluteQ4EndpointSelector_eq E j hs
        phi hphiOne hphiZero f i)
  have hfun : q4SelectedFibre rho g i = P.indicator g := by
    funext x
    by_cases hx : rho x = i
    · simp [q4SelectedFibre, P, hx]
    · simp [q4SelectedFibre, P, hx]
  change Integrable (q4SelectedFibre rho g i) volume
  rw [hfun]
  exact hg.indicator hP

/-- Square-integrability of a scalar input passes to every selected endpoint
fibre.  This is the exact fibrewise integrability used by the active-cell
square-energy estimate. -/
theorem integrable_norm_sq_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex)
    (hg : Integrable (fun x => ‖g x‖ ^ (2 : Nat)) volume) (i : Int) :
    Integrable (fun x => ‖q4SelectedFibre
      (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
      g i x‖ ^ (2 : Nat)) volume := by
  let rho := measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f
  let P : Set (Euclidean d) := {x | rho x = i}
  have hP : MeasurableSet P := by
    simpa only [P] using
      (measurableSet_measurableActiveDyadicAbsoluteQ4EndpointSelector_eq E j hs
        phi hphiOne hphiZero f i)
  have hfun : (fun x => ‖q4SelectedFibre rho g i x‖ ^ (2 : Nat)) =
      P.indicator (fun x => ‖g x‖ ^ (2 : Nat)) := by
    funext x
    by_cases hx : rho x = i
    · simp [q4SelectedFibre, P, hx]
    · simp [q4SelectedFibre, P, hx]
  change Integrable (fun x => ‖q4SelectedFibre rho g i x‖ ^ (2 : Nat)) volume
  rw [hfun]
  exact hg.indicator hP

/-- A measurable `L²` input has square-integrable fibres for the actual
measurable endpoint selector.  This packages the elementary restriction
step in the form required by the active-cell energy estimate. -/
theorem integrable_norm_sq_q4SelectedFibre_measActiveDyAbsEndptSelector_of_memLp_two
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (hgmeas : Measurable g)
    (hg : MemLp g 2 volume) (i : Int) :
    Integrable (fun x => ‖q4SelectedFibre
      (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
      g i x‖ ^ (2 : Nat)) volume := by
  apply integrable_norm_sq_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
    E j hs phi hphiOne hphiZero f g _ i
  exact (memLp_two_iff_integrable_sq_norm hgmeas.aestronglyMeasurable).mp hg

/-- The actual selected endpoint fibres preserve `L²` membership of a
measurable input. -/
theorem memLp_two_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (hgmeas : Measurable g)
    (hg : MemLp g 2 volume) (i : Int) :
    MemLp (q4SelectedFibre
      (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
      g i) 2 volume := by
  apply (memLp_two_iff_integrable_sq_norm
    (measurable_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
      E j hs phi hphiOne hphiZero f g hgmeas i).aestronglyMeasurable).mpr
  exact integrable_norm_sq_q4SelectedFibre_measActiveDyAbsEndptSelector_of_memLp_two
    E j hs phi hphiOne hphiZero f g hgmeas hg i

/-- A compactly localized literal pair kernel is bounded, so multiplying it
by any integrable selected fibre is again integrable.  This discharges the
Bochner-integrability side condition in the actual shell domain directly
from the Schwartz realization of the pair multiplier. -/
theorem integrable_q4ActiveDyadicPairKernel_mul_q4SelectedFibre_of_compact
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (rho : Euclidean d -> Int) (g : Euclidean d -> Complex)
    (hg : ∀ l, Integrable (q4SelectedFibre rho g l) volume)
    (i l : Int) (x : Euclidean d) :
    Integrable (fun y => q4ActiveDyadicPairKernel psi j i l (x - y) *
      q4SelectedFibre rho g l y) volume := by
  let k : SchwartzMap (Euclidean d) Complex :=
    𝓕⁻ (q4ActiveDyadicPairMultiplier psi hpsiCompact j i l)
  have hk (z : Euclidean d) : (k : Euclidean d -> Complex) z =
      q4ActiveDyadicPairKernel psi j i l z := by
    simpa only [k, q4ActiveDyadicSchwartzKernel] using
      q4ActiveDyadicSchwartzKernel_eq_pairKernel psi hpsiCompact j i l z
  have hkmeas : AEStronglyMeasurable
      (fun y : Euclidean d => (k : Euclidean d -> Complex) (x - y)) volume :=
    (k.continuous.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  have hkbound : ∀ᵐ y : Euclidean d ∂volume,
      ‖(k : Euclidean d -> Complex) (x - y)‖ ≤ ‖k.toBoundedContinuousFunction‖ :=
    Filter.Eventually.of_forall fun y => by
      change ‖k.toBoundedContinuousFunction (x - y)‖ ≤
        ‖k.toBoundedContinuousFunction‖
      exact BoundedContinuousFunction.norm_coe_le_norm _ _
  have hprod := (hg l).bdd_mul hkmeas hkbound
  refine hprod.congr (Filter.Eventually.of_forall fun y => ?_)
  change k (x - y) * q4SelectedFibre rho g l y =
    q4ActiveDyadicPairKernel psi j i l (x - y) * q4SelectedFibre rho g l y
  rw [hk (x - y)]

/-- Every integrable input belongs to the literal actual endpoint-shell
domain.  In particular, the Schwartz datum used to choose the measurable
endpoint selector automatically belongs to that domain; it is not an extra
analytic assumption in the `TT*` argument. -/
theorem mem_q4MeasurableActiveDyadicAbsoluteEndpointShellDomain_of_integrable
    {d : Nat} (E : Set Real) (j : Nat) (u L : Real)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (hg : Integrable g volume) :
    g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
      phi hphiOne hphiZero f := by
  rw [mem_q4MeasurableActiveDyadicAbsoluteEndpointShellDomain_iff]
  intro i l x
  exact integrable_q4ActiveDyadicPairKernel_mul_q4SelectedFibre_of_compact
    (absoluteDyadicBandpass phi hphiOne hphiZero j)
    (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) j
    (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f)
    g
    (fun k =>
      integrable_q4SelectedFibre_measurableActiveDyadicAbsoluteEndpointSelector
        E j hs phi hphiOne hphiZero f g hg k)
    i l x

/-- The Schwartz datum which defines the endpoint selector satisfies the
actual shell-domain condition automatically. -/
theorem self_mem_q4MeasurableActiveDyadicAbsoluteEndpointShellDomain
    {d : Nat} (E : Set Real) (j : Nat) (u L : Real)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex) :
    (f : Euclidean d -> Complex) ∈
      q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f :=
  mem_q4MeasurableActiveDyadicAbsoluteEndpointShellDomain_of_integrable
    E j u L hs phi hphiOne hphiZero f (f : Euclidean d -> Complex) f.integrable

/-- The actual endpoint pair shell is pointwise the generic selected kernel
shell with the active dyadic gap relation. -/
theorem q4MeasurableActiveDyadicAbsoluteEndpointPairShell_eq_selectedKernelTTStarShell
    {d : Nat} (E : Set Real) (j : Nat) (u L : Real)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (g : Euclidean d -> Complex) (x : Euclidean d) :
    q4MeasurableActiveDyadicAbsoluteEndpointPairShell E j u L hs
      phi hphiOne hphiZero f g x =
      q4SelectedKernelTTStarShell volume (activeDyadicIndices E j)
        (fun i l => radiusGapShellNeighbors u L (dyadicLeft j i) (dyadicLeft j l))
        (q4ActiveDyadicPairKernel (absoluteDyadicBandpass phi hphiOne hphiZero j) j)
        (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
          phi hphiOne hphiZero f) g x := by
  exact q4MeasurableActiveDyadicAbsoluteEndpointPairShell_eq_q4SelectedKernelTTStarShell
    E j u L hs phi hphiOne hphiZero f g x

/-- Apply the literal crossed `TT*` assembly to the genuine measurable
endpoint selector and the actual absolute-dyadic pair kernel.  The selector
range and the measurability of every pair integrand are discharged here;
the remaining hypotheses are the literal pairwise/selected integrability
conditions, the pointwise kernel estimate, and the square-energy input
needed from the paper's stationary-phase and quasi-Assouad arguments. -/
theorem q4MeasurableActiveDyAbsEndpointPairShell_crossed_strong_of_literal_endpoints
    {d : Nat} {E : Set Real} {j : Nat} {u L A B : Real}
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (hA : 0 < A)
    (hkernel : ∀ i l z, ‖q4ActiveDyadicPairKernel
      (absoluteDyadicBandpass phi hphiOne hphiZero j) j i l z‖ ≤ A)
    (hB : 0 ≤ B)
    (hDfibres : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        ∀ i ∈ activeDyadicIndices E j, Integrable (q4SelectedFibre
          (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
            phi hphiOne hphiZero f) g i) volume)
    (hDoutput : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        Integrable (fun x => ‖q4MeasurableActiveDyadicAbsoluteEndpointPairShell E j u L hs
          phi hphiOne hphiZero f g x‖ ^ (2 : Nat)) volume)
    (hDinput : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        Integrable (fun x => ‖g x‖ ^ (2 : Nat)) volume)
    (henergy : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        (∫ x, ‖q4MeasurableActiveDyadicAbsoluteEndpointPairShell E j u L hs
          phi hphiOne hphiZero f g x‖ ^ (2 : Nat)) ≤
          B * ∫ x, ‖g x‖ ^ (2 : Nat))
    {p q cutoff I₀ : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (hfD : (f : Euclidean d -> Complex) ∈
      q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f)
    (hI₀ : I₀ = ∫ x, ‖f x‖ ^ p) (hI₀pos : 0 < I₀)
    (hcutoff : cutoff = 2 * A * I₀) :
    (∫⁻ x, ENNReal.ofReal
      (‖q4MeasurableActiveDyadicAbsoluteEndpointPairShell E j u L hs
        phi hphiOne hphiZero f (f : Euclidean d -> Complex) x‖ ^ q)) ≤
      ENNReal.ofReal q * (4 * ENNReal.ofReal B *
        ((ENNReal.ofReal (q - 2))⁻¹ *
          (ENNReal.ofReal cutoff) ^ (q - 2) *
            ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p)) := by
  classical
  let s : Finset Int := activeDyadicIndices E j
  let R : Int -> Int -> Prop :=
    fun i l => radiusGapShellNeighbors u L (dyadicLeft j i) (dyadicLeft j l)
  let kernel : Int -> Int -> Euclidean d -> Complex :=
    q4ActiveDyadicPairKernel (absoluteDyadicBandpass phi hphiOne hphiZero j) j
  let rho : Euclidean d -> Int :=
    measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs phi hphiOne hphiZero f
  have hrho : ∀ x, rho x ∈ s := by
    intro x
    exact measurableActiveDyadicAbsoluteQ4EndpointSelector_mem E j hs
      phi hphiOne hphiZero f x
  have hdomain (g : Euclidean d -> Complex) :
      g ∈ q4SelectedShellDomain volume s R kernel rho ↔
        g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
          phi hphiOne hphiZero f := by
    rfl
  have hDpairmeas : ∀ g : Euclidean d -> Complex,
      g ∈ q4SelectedShellDomain volume s R kernel rho →
        ∀ i l x, AEStronglyMeasurable
          (fun y => kernel i l (x - y) * q4SelectedFibre rho g l y) volume := by
    intro g hg i l x
    exact (hg i l x).aestronglyMeasurable
  have hfmeas : Measurable (f : Euclidean d -> Complex) := f.continuous.measurable
  have hfint : Integrable (f : Euclidean d -> Complex) volume := f.integrable
  have hfp : Integrable (fun x : Euclidean d => ‖f x‖ ^ p) volume := by
    have hmem : MemLp (f : Euclidean d -> Complex) (ENNReal.ofReal p) volume :=
      f.memLp (ENNReal.ofReal p) volume
    have hp : 0 < p := by linarith
    have hpow := hmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp.le] using hpow
  have hDfibres' : ∀ g : Euclidean d -> Complex,
      g ∈ q4SelectedShellDomain volume s R kernel rho →
        ∀ i ∈ s, Integrable (q4SelectedFibre rho g i) volume := by
    intro g hg
    exact hDfibres g ((hdomain g).mp hg)
  have hDoutput' : ∀ g : Euclidean d -> Complex,
      g ∈ q4SelectedShellDomain volume s R kernel rho →
        Integrable (fun x => ‖q4SelectedKernelTTStarShell volume s R kernel rho g x‖ ^
          (2 : Nat)) volume := by
    intro g hg
    simpa only [s, R, kernel, rho,
      ← q4MeasurableActiveDyadicAbsoluteEndpointPairShell_eq_selectedKernelTTStarShell]
      using hDoutput g ((hdomain g).mp hg)
  have hDinput' : ∀ g : Euclidean d -> Complex,
      g ∈ q4SelectedShellDomain volume s R kernel rho →
        Integrable (fun x => ‖g x‖ ^ (2 : Nat)) volume := by
    intro g hg
    exact hDinput g ((hdomain g).mp hg)
  have henergy' : ∀ g : Euclidean d -> Complex,
      g ∈ q4SelectedShellDomain volume s R kernel rho →
        (∫ x, ‖q4SelectedKernelTTStarShell volume s R kernel rho g x‖ ^ (2 : Nat)) ≤
          B * ∫ x, ‖g x‖ ^ (2 : Nat) := by
    intro g hg
    simpa only [s, R, kernel, rho,
      ← q4MeasurableActiveDyadicAbsoluteEndpointPairShell_eq_selectedKernelTTStarShell]
      using henergy g ((hdomain g).mp hg)
  have hfD' : (f : Euclidean d -> Complex) ∈
      q4SelectedShellDomain volume s R kernel rho := by
    exact (hdomain (f : Euclidean d -> Complex)).mpr hfD
  have hcore := q4SelectedKernelTTStarShell_crossed_strong_of_literal_endpoints
    (μ := volume) s R kernel rho hrho A hA hkernel B hB hDfibres' hDpairmeas
      hDoutput' hDinput' henergy' hp1 hp2 hq (f : Euclidean d -> Complex)
      hfmeas hfint hfp hfD' hI₀ hI₀pos hcutoff
  simpa only [s, R, kernel, rho,
    ← q4MeasurableActiveDyadicAbsoluteEndpointPairShell_eq_selectedKernelTTStarShell]
    using hcore

/-- The actual crossed strong estimate after the quasi-Assouad active-cell
count has been applied.  This is the paper's finite-shell `TT*` step with no
abstract selected operator left over: its hypotheses are the literal
pairwise `L²` estimates for the actual absolute-dyadic kernel, and the
conclusion is for the measurable endpoint selector which linearizes the
dyadic maximal function.

The factor
`6 C δ⁻ᵉᵗᵃ ((2 (L + δ)) / δ)^γ` is precisely the upper
quasi-Assouad active-cell degree bound. -/
theorem q4MeasActiveDyAbsEndptPairShell_crossed_strong_of_active_cell_pw_endpoints
    {d : Nat} {E : Set Real} {gamma eta C u L A B : Real} {j : Nat}
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta C)
    (hC : 0 ≤ C) (hgamma : 0 ≤ gamma)
    (hdeltaone : dyadicScale j < 1) (hL : 0 ≤ L)
    (hs : (activeDyadicIndices E j).Nonempty)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ -> phi xi = 0)
    (f : SchwartzMap (Euclidean d) Complex)
    (hA : 0 < A)
    (hkernel : ∀ i l z, ‖q4ActiveDyadicPairKernel
      (absoluteDyadicBandpass phi hphiOne hphiZero j) j i l z‖ ≤ A)
    (hB : 0 ≤ B)
    (hDfibres : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        ∀ i ∈ activeDyadicIndices E j, Integrable (q4SelectedFibre
          (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
            phi hphiOne hphiZero f) g i) volume)
    (hDoutput : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        Integrable (fun x => ‖q4MeasurableActiveDyadicAbsoluteEndpointPairShell E j u L hs
          phi hphiOne hphiZero f g x‖ ^ (2 : Nat)) volume)
    (hDinput : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        Integrable (fun x => ‖g x‖ ^ (2 : Nat)) volume)
    (hDfibreOutput : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
        phi hphiOne hphiZero f →
        ∀ i ∈ activeDyadicIndices E j, Integrable (fun x =>
          ‖q4ActiveDyadicKernelTTStarShell E j u L volume
            (q4ActiveDyadicPairKernel
              (absoluteDyadicBandpass phi hphiOne hphiZero j) j)
            (q4SelectedFibre
              (measurableActiveDyadicAbsoluteQ4EndpointSelector E j hs
                phi hphiOne hphiZero f) g) i x‖ ^ (2 : Nat)) volume)
    (hDfibreMemLp : ∀ g : Euclidean d -> Complex,
      g ∈ q4MeasurableActiveDyadicAbsoluteEndpointShellDomain E j u L hs
