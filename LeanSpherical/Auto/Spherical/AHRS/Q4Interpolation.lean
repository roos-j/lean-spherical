      rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x)]
    have hnorm' : ENNReal.ofReal ((∫ x : Euclidean d, g x ^ p) ^ p⁻¹) ≤
        D * ENNReal.ofReal (I ^ p⁻¹) := by
      rw [← hnormEq]
      exact hnorm
    calc
      (∫ x : Euclidean d, g x ^ p) ^ p⁻¹ =
          (ENNReal.ofReal ((∫ x : Euclidean d, g x ^ p) ^ p⁻¹)).toReal := by
            rw [ENNReal.toReal_ofReal (Real.rpow_nonneg hint0 _)]
      _ ≤ (D * ENNReal.ofReal (I ^ p⁻¹)).toReal :=
        (ENNReal.toReal_le_toReal ENNReal.ofReal_ne_top
          (ENNReal.mul_ne_top hDtop ENNReal.ofReal_ne_top)).mpr hnorm'
      _ = D.toReal * (I ^ p⁻¹) := by
        simp only [ENNReal.toReal_mul,
          ENNReal.toReal_ofReal (Real.rpow_nonneg hI _)]
  have hraised := Real.rpow_le_rpow
    (Real.rpow_nonneg hint0 _) hrootbound hpNN
  calc
    (∫ x : Euclidean d, g x ^ p) =
        ((∫ x : Euclidean d, g x ^ p) ^ p⁻¹) ^ p := by
          rw [Real.rpow_inv_rpow hint0 (ne_of_gt hp0)]
    _ ≤ (D.toReal * (I ^ p⁻¹)) ^ p := hraised
    _ = D.toReal ^ p * I := by
      rw [Real.mul_rpow ENNReal.toReal_nonneg (Real.rpow_nonneg hI _)]
      rw [Real.rpow_inv_rpow hI (ne_of_gt hp0)]
    _ ≤ C * I := mul_le_mul_of_nonneg_right hcoefficient hI

private theorem absolute_eLpNorm_le_of_bandpass_moment_bound
    {d : ℕ} {p A ε I : ℝ} (hp0 : 0 < p)
    (g : Euclidean d → ℝ) (f : Euclidean d → ℂ)
    (hg0 : ∀ x, 0 ≤ g x) (hA : 0 ≤ A) (_hI : 0 ≤ I) (j : ℕ)
    (hbound : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p)) ≤
      ENNReal.ofReal (A * (2 : ℝ) ^ (-ε * j)) *
        ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p) :
    eLpNorm g (ENNReal.ofReal p) volume ≤
      (ENNReal.ofReal (A ^ p⁻¹) *
        eLpNorm f (ENNReal.ofReal p) volume) *
        ENNReal.ofReal ((2 : ℝ) ^ (-ε / p)) ^ j := by
  calc
    eLpNorm g (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal (A * (2 : ℝ) ^ (-ε * j)) ^ p⁻¹ *
          eLpNorm f (ENNReal.ofReal p) volume :=
      eLpNorm_le_of_lintegral_real_rpow_bound hp0 g f hg0
        (ENNReal.ofReal (A * (2 : ℝ) ^ (-ε * j))) hbound
    _ = (ENNReal.ofReal (A ^ p⁻¹) *
          eLpNorm f (ENNReal.ofReal p) volume) *
          ENNReal.ofReal ((2 : ℝ) ^ (-ε / p)) ^ j := by
        have hbase : 0 ≤ A * (2 : ℝ) ^ (-ε * j) :=
          mul_nonneg hA (Real.rpow_nonneg (by norm_num) _)
        have hreal :
            (A * (2 : ℝ) ^ (-ε * (j : ℝ))) ^ p⁻¹ =
              A ^ p⁻¹ * ((2 : ℝ) ^ (-ε / p)) ^ j := by
          rw [Real.mul_rpow hA (Real.rpow_nonneg (by norm_num) _)]
          rw [← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
          congr 1
          rw [show (-ε * (j : ℝ)) * p⁻¹ = (-ε / p) * (j : ℝ) by
            field_simp]
          exact Real.rpow_mul_natCast (by norm_num) _ _
        rw [ENNReal.ofReal_rpow_of_nonneg hbase (inv_nonneg.mpr hp0.le), hreal]
        rw [ENNReal.ofReal_mul (Real.rpow_nonneg hA _),
          ENNReal.ofReal_pow (Real.rpow_nonneg (by norm_num) _) j]
        ring

/-- Each fixed spherical average of the absolute smooth cutoff converges to
the corresponding spherical average of the original Schwartz function. -/
theorem absolute_cutoff_tendsto_spherical_average
    {d : ℕ} (hd0 : 0 < d) (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (r : ℝ) (x : Euclidean d) :
    Tendsto (fun N : ℕ =>
      sphericalAverage d (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r x)
      atTop (𝓝 (sphericalAverage d (f : Euclidean d → ℂ) r x)) := by
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd0
  have hφbound (ξ : Euclidean d) : ‖φ ξ‖ ≤ ‖φ.toBoundedContinuousFunction‖ := by
    change ‖φ.toBoundedContinuousFunction ξ‖ ≤ ‖φ.toBoundedContinuousFunction‖
    exact BoundedContinuousFunction.norm_coe_le_norm _ _
  have hchar (ξ : Euclidean d) :
      ‖(Real.fourierChar (inner ℝ ξ x) : ℂ)‖ = 1 := by
    rw [Real.fourierChar_apply]
    exact Complex.norm_exp_ofReal_mul_I _
  have hchar_cont : Continuous
      (fun ξ : Euclidean d => (Real.fourierChar (inner ℝ ξ x) : ℂ)) :=
    (Real.continuous_fourierChar.comp
      (continuous_id.inner (continuous_const : Continuous fun _ : Euclidean d => x))
      |> continuous_subtype_val.comp)
  let F : ℕ → Euclidean d → ℂ := fun N ξ =>
    (Real.fourierChar (inner ℝ ξ x) : ℂ) *
      (surfaceFourier d (-r • ξ) *
        φ (((2 : ℝ) ^ N)⁻¹ • ξ) *
        𝓕 (f : Euclidean d → ℂ) ξ)
  let G : Euclidean d → ℂ := fun ξ =>
    (Real.fourierChar (inner ℝ ξ x) : ℂ) *
      (surfaceFourier d (-r • ξ) * 𝓕 (f : Euclidean d → ℂ) ξ)
  have hFmeas (N : ℕ) : AEStronglyMeasurable (F N) volume := by
    dsimp only [F]
    have hsurf : Continuous (fun ξ : Euclidean d => surfaceFourier d (-r • ξ)) :=
      (continuous_surfaceFourier d).comp
        ((continuous_const : Continuous fun _ : Euclidean d => -r).smul continuous_id)
    have hcut : Continuous (fun ξ : Euclidean d =>
        φ (((2 : ℝ) ^ N)⁻¹ • ξ)) :=
      φ.continuous.comp
        ((continuous_const : Continuous fun _ : Euclidean d => ((2 : ℝ) ^ N)⁻¹).smul
          continuous_id)
    exact (hchar_cont.mul ((hsurf.mul hcut).mul (𝓕 f).continuous)).aestronglyMeasurable
  let B : ℝ := surfaceMass d * ‖φ.toBoundedContinuousFunction‖
  have hB : 0 ≤ B := by
    dsimp only [B]
    positivity
  have hbound_int : Integrable (fun ξ : Euclidean d =>
      B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖) volume :=
    (𝓕 f).integrable.norm.const_mul B
  have hbound (N : ℕ) : ∀ᵐ ξ : Euclidean d ∂volume,
      ‖F N ξ‖ ≤ B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖ := by
    filter_upwards with ξ
    dsimp only [F]
    rw [norm_mul, hchar, one_mul, norm_mul, norm_mul]
    apply mul_le_mul_of_nonneg_right
    · exact mul_le_mul
        (by simpa [surfaceMass] using
          norm_surfaceFourier_le_surfaceMass d (-r • ξ))
        (hφbound _)
        (norm_nonneg _) hmass.le
    · exact norm_nonneg _
  have hscale (ξ : Euclidean d) : Tendsto (fun N : ℕ =>
      ((2 : ℝ) ^ N)⁻¹ • ξ) atTop (𝓝 0) := by
    have hpow : Tendsto (fun N : ℕ => ((2 : ℝ)⁻¹) ^ N) atTop (𝓝 0) :=
      tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
    have hconst : Tendsto (fun _ : ℕ => ξ) atTop (𝓝 ξ) := tendsto_const_nhds
    simpa [inv_pow] using hpow.smul hconst
  have hφlim (ξ : Euclidean d) : Tendsto (fun N : ℕ =>
      φ (((2 : ℝ) ^ N)⁻¹ • ξ)) atTop (𝓝 (1 : ℂ)) := by
    have hzero : φ (0 : Euclidean d) = 1 := hφone 0 (by simp)
    rw [← hzero]
    exact φ.continuous.tendsto 0 |>.comp (hscale ξ)
  have hFlim : ∀ᵐ ξ : Euclidean d ∂volume,
      Tendsto (fun N : ℕ => F N ξ) atTop (𝓝 (G ξ)) := by
    filter_upwards with ξ
    dsimp only [F, G]
    have hchar' : Tendsto
        (fun _ : ℕ => (Real.fourierChar (inner ℝ ξ x) : ℂ)) atTop
        (𝓝 (Real.fourierChar (inner ℝ ξ x) : ℂ)) := tendsto_const_nhds
    have hsurf' : Tendsto (fun _ : ℕ => surfaceFourier d (-r • ξ)) atTop
        (𝓝 (surfaceFourier d (-r • ξ))) := tendsto_const_nhds
    have hfourier' : Tendsto (fun _ : ℕ => 𝓕 (f : Euclidean d → ℂ) ξ) atTop
        (𝓝 (𝓕 (f : Euclidean d → ℂ) ξ)) := tendsto_const_nhds
    simpa using hchar'.mul ((hsurf'.mul (hφlim ξ)).mul hfourier')
  have hInt := tendsto_integral_of_dominated_convergence
    (F := F) (f := G) (fun ξ : Euclidean d =>
      B * ‖𝓕 (f : Euclidean d → ℂ) ξ‖)
    hFmeas hbound_int hbound hFlim
  rw [show (fun N : ℕ =>
      sphericalAverage d (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r x) =
      fun N => ∫ ξ : Euclidean d, F N ξ by
        funext N
        rw [sphericalAverage_absoluteCutoffProjection, Real.fourierInv_eq]
        rfl,
    show sphericalAverage d (f : Euclidean d → ℂ) r x =
      ∫ ξ : Euclidean d, G ξ by
        rw [sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz f r,
          Real.fourierInv_eq]
        rfl]
  exact hInt

private theorem absolute_cutoff_tendsto_normalized_spherical_average
    {d : ℕ} (hd0 : 0 < d) (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (r : ℝ) (x : Euclidean d) :
    Tendsto (fun N : ℕ => normalizedSphericalAverage d
      (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r x)
      atTop (𝓝 (normalizedSphericalAverage d (f : Euclidean d → ℂ) r x)) := by
  unfold normalizedSphericalAverage
  exact tendsto_const_nhds.mul
    (absolute_cutoff_tendsto_spherical_average hd0 φ hφone f r x)

private theorem normalized_spherical_average_power_le_liminf_absolute_cutoff
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hpNN : 0 ≤ p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ)
    (r : E) (x : Euclidean d) :
    ENNReal.ofReal (‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p) ≤
      liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
  let W : ℕ → ℂ := fun N => normalizedSphericalAverage d
    (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r.1 x
  have hW : Tendsto W atTop
      (𝓝 (normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x)) := by
    simpa only [W] using
      absolute_cutoff_tendsto_normalized_spherical_average hd0 φ hφone f r.1 x
  have hE : Tendsto (fun N : ℕ => ENNReal.ofReal ‖W N‖) atTop
      (𝓝 (ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)) :=
    (ENNReal.continuous_ofReal.tendsto _).comp hW.norm
  have hPow : Tendsto (fun N : ℕ => (ENNReal.ofReal ‖W N‖) ^ p) atTop
      (𝓝 ((ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p)) :=
    (ENNReal.continuous_rpow_const.tendsto _).comp hE
  have hPow' : Tendsto (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop
      (𝓝 (ENNReal.ofReal
        (‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p))) := by
    simpa only [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN] using hPow
  have hle (N : ℕ) : ENNReal.ofReal (‖W N‖ ^ p) ≤
      ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) := by
    have hU_nonneg : 0 ≤ fractalAbsoluteCutoffMaximal d E φ N f x :=
      fractalAbsoluteCutoffMaximal_nonneg E φ N f x
    rw [← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN,
      ← ENNReal.ofReal_rpow_of_nonneg hU_nonneg hpNN]
    apply ENNReal.rpow_le_rpow _ hpNN
    rw [show ENNReal.ofReal (fractalAbsoluteCutoffMaximal d E φ N f x) =
        fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x by
      change ENNReal.ofReal
        ((fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x).toReal) =
        fractalSphericalMaximal d E
          (absoluteCutoffProjection φ N f : Euclidean d → ℂ) x
      exact ENNReal.ofReal_toReal
        (fractalSphericalMaximal_ne_top hd0 E hEpos
          (absoluteCutoffProjection φ N f) x)]
    dsimp only [W]
    exact normalizedSphericalAverage_le_fractalSphericalMaximal E
      (absoluteCutoffProjection φ N f : Euclidean d → ℂ) r.2 x
  calc
    ENNReal.ofReal (‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖ ^ p) =
        liminf (fun N : ℕ => ENNReal.ofReal (‖W N‖ ^ p)) atTop :=
      hPow'.liminf_eq.symm
    _ ≤ liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
      Filter.liminf_le_liminf (Filter.Eventually.of_forall hle)

/-- The pointwise Fatou comparison used by both diagonal and off-diagonal
absolute-frequency reassembly. -/
theorem fractal_spherical_maximal_power_le_liminf_absolute_cutoff
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hp0 : 0 < p) (hpNN : 0 ≤ p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p) ≤
      liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
  let V : SchwartzMap (Euclidean d) ℂ → Euclidean d → ℝ :=
    fun g x => fractalSphericalMaximalReal d E g x
  have hVtop (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
      fractalSphericalMaximal d E (g : Euclidean d → ℂ) x ≠ ⊤ :=
    fractalSphericalMaximal_ne_top hd0 E hEpos g x
  have hV_eq (g : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
      ENNReal.ofReal (V g x) = fractalSphericalMaximal d E (g : Euclidean d → ℂ) x := by
    exact ENNReal.ofReal_toReal (hVtop g x)
  have hpoint : ENNReal.ofReal ((V f x) ^ p) ≤
      liminf (fun N : ℕ =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
    have hVnonneg : 0 ≤ V f x := ENNReal.toReal_nonneg
    rw [← ENNReal.ofReal_rpow_of_nonneg hVnonneg hpNN, hV_eq]
    unfold fractalSphericalMaximal
    have hpowmax :
        (⨆ r : E, ENNReal.ofReal
          ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p =
          ⨆ r : E, (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) ^ p := by
      let e : ENNReal ≃o ENNReal :=
        (ENNReal.strictMono_rpow_of_pos hp0).orderIsoOfSurjective _
          (ENNReal.rpow_left_bijective hp0.ne.symm).2
      change e (⨆ r : E, ENNReal.ofReal
        ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖) =
          ⨆ r : E, e (ENNReal.ofReal
            ‖normalizedSphericalAverage d (f : Euclidean d → ℂ) r.1 x‖)
      exact e.map_iSup _
    rw [hpowmax]
    apply iSup_le
    intro r
    rw [ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hpNN]
    exact normalized_spherical_average_power_le_liminf_absolute_cutoff
      hd0 hpNN E hEpos φ hφone f r x
  simpa only [V] using hpoint

/-- Uniform strong estimates for the finite absolute cutoffs pass to the
restricted spherical maximal operator.  This is the Fatou step for the
absolute-frequency decomposition. -/
theorem absolute_reassembly_limit
    {d : ℕ} {p : ℝ} (hd0 : 0 < d) (hp0 : 0 < p)
    (E : Set ℝ) (hEpos : E ⊆ Ioi (0 : ℝ))
    (φ : SchwartzMap (Euclidean d) ℂ)
    (hφone : ∀ ξ, ‖ξ‖ ≤ 1 → φ ξ = 1)
    (A : ℝ) (hA : 0 < A)
    (hfinite : ∀ (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ),
      MemLp (fractalAbsoluteCutoffMaximal d E φ N f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) ≤
        A * ∫ x : Euclidean d, ‖f x‖ ^ p) :
    HasFractalSphericalStrongType d E p p := by
  have hpNN : 0 ≤ p := hp0.le
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hUmeas (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      AEMeasurable (fun x : Euclidean d =>
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) volume := by
    have hmeas : AEMeasurable (fun x : Euclidean d =>
        (ENNReal.ofReal (fractalAbsoluteCutoffMaximal d E φ N f x)) ^ p) volume :=
      ENNReal.continuous_rpow_const.measurable.comp_aemeasurable
        ((hfinite N f).1.1.aemeasurable.ennreal_ofReal)
    convert hmeas using 1
    funext x
    exact (ENNReal.ofReal_rpow_of_nonneg
      (fractalAbsoluteCutoffMaximal_nonneg E φ N f x) hpNN).symm
  have hUPowInt (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      Integrable (fun x : Euclidean d =>
        (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) volume := by
    have h := (hfinite N f).1.integrable_norm_rpow hpEN0 hpENT
    convert h using 1
    funext x
    rw [Real.norm_eq_abs,
      abs_of_nonneg (fractalAbsoluteCutoffMaximal_nonneg E φ N f x),
      ENNReal.toReal_ofReal hpNN]
  have hUint (N : ℕ) (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
    calc
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) =
          ENNReal.ofReal (∫ x : Euclidean d,
            (fractalAbsoluteCutoffMaximal d E φ N f x) ^ p) := by
          rw [ofReal_integral_eq_lintegral_ofReal (hUPowInt N f)]
          exact Filter.Eventually.of_forall fun x =>
            Real.rpow_nonneg (fractalAbsoluteCutoffMaximal_nonneg E φ N f x) p
      _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
        ENNReal.ofReal_le_ofReal (hfinite N f).2
  have hFatou (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop := by
    calc
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
          ∫⁻ x : Euclidean d,
            liminf (fun N : ℕ =>
              ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
        lintegral_mono (fun x =>
          fractal_spherical_maximal_power_le_liminf_absolute_cutoff
            hd0 hp0 hpNN E hEpos φ hφone f x)
      _ ≤ liminf (fun N : ℕ =>
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop :=
        lintegral_liminf_le' fun N => hUmeas N f
  have hLiminfBound (f : SchwartzMap (Euclidean d) ℂ) :
      liminf (fun N : ℕ =>
        ∫⁻ x : Euclidean d,
          ENNReal.ofReal ((fractalAbsoluteCutoffMaximal d E φ N f x) ^ p)) atTop ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
    Filter.liminf_le_of_frequently_le'
      (Filter.Frequently.of_forall fun N => hUint N f)
  have hlin (f : SchwartzMap (Euclidean d) ℂ) :
      (∫⁻ x : Euclidean d,
        ENNReal.ofReal ((fractalSphericalMaximalReal d E f x) ^ p)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean d, ‖f x‖ ^ p) :=
    (hFatou f).trans (hLiminfBound f)
  apply HasFractalSphericalMomentStrongType.toStrongType hp0
  refine ⟨A, hA, ?_⟩
  intro f
  have hmaxmeas : AEStronglyMeasurable (fractalSphericalMaximalReal d E f) volume :=
    (measurable_fractalSphericalMaximalReal E f).aestronglyMeasurable
  have hmaxnonneg : ∀ x, 0 ≤ fractalSphericalMaximalReal d E f x := by
    intro x
    exact ENNReal.toReal_nonneg
  have hright : 0 ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ p :=
    mul_nonneg hA.le (integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) p)
  rcases memLp_and_integral_of_lintegral_rpow_bound
    (fractalSphericalMaximalReal d E f) hmaxmeas hmaxnonneg hp0 (hlin f) hright with
      ⟨hmem, hmoment⟩
  refine ⟨hmem, ?_⟩
  calc
    (∫ x : Euclidean d, ‖fractalSphericalMaximalReal d E f x‖ ^ p) =
        ∫ x : Euclidean d, (fractalSphericalMaximalReal d E f x) ^ p := by
          apply integral_congr_ae
          filter_upwards with x
          rw [Real.norm_of_nonneg (hmaxnonneg x)]
    _ ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ p := hmoment

/-- The level-zero absolute cutoff has a uniform restricted-maximal
strong-type estimate.  The proof only uses the smooth local lowpass bound;
the restriction `E ⊆ [1,2]` is used to compare it with the raw interval
maximal function. -/
theorem absolute_lowpass_strong_type
    {d : ℕ} (hd0 : 0 < d) (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2)
