      rw [← ENNReal.ofReal_mul
        (mul_nonneg (inv_nonneg.mpr hdiff.le)
          (Real.rpow_nonneg (by norm_num) _))]
    rw [htail_eq] at h
    exact h
  have hlin :
      (∫⁻ x : Euclidean d, ENNReal.ofReal ((T f x) ^ p)) <=
        ENNReal.ofReal
          (p * (2 : Real) ^ r * (C ^ r) * Aq * Ctop ^ (p - r)) := by
    apply marcinkiewicz_weak_q_top_on_additive_split_real_top_scaled
      (D := Set.univ) (eval := fun g : SchwartzMap (Euclidean d) Complex =>
        (g : Euclidean d -> Complex)) (T := T) (q := r)
        (Cq := C ^ r) (Ctop := Ctop) (p := p) (f := f)
        (low := low) (high := high) (Aq := Aq)
    · intro g x
      exact hTnonneg g x
    · intro g h _ _ x
      exact hTsub g h x
    · exact hr
    · exact hCtop
    · intro g _ s hs
      exact hweak g hs
    · intro g _ a ha hga x
      exact htop g a ha hga x
    · exact hrp
    · exact (hTmeas f).aemeasurable
    · intro t
      simp
    · intro t
      simp
    · intro t
      ext x
      exact hsplit t x
    · intro t ht x
      exact smooth_low_norm_le_half_height f (low t) ht (hlow t) x
    · exact measurable_smooth_high_profile_lintegrals f low high hlow hhigh r
    · exact htail
    · exact hAq
  have hcoeff :
      p * (2 : Real) ^ r * (C ^ r) * Aq * Ctop ^ (p - r) = A * J := by
    dsimp only [A, Aq]
    ring
  rw [hcoeff] at hlin
  have hAJ : 0 <= A * J := by
    exact mul_nonneg hA.le
      (integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p)
  have hmem : MemLp (T f) (ENNReal.ofReal p) volume :=
    (memLp_and_integral_of_lintegral_rpow_bound
      (T f) (hTmeas f) (hTnonneg f) hp0 hlin hAJ).1
  refine ⟨hmem, ?_⟩
  have hlin' :
      (∫⁻ x : Euclidean d, ENNReal.ofReal ((T f x) ^ p)) <=
        ENNReal.ofReal A * ∫⁻ x : Euclidean d,
          (ENNReal.ofReal ‖f x‖) ^ p := by
    rw [hinput, ← ENNReal.ofReal_mul hA.le]
    exact hlin
  have hnorm := eLpNorm_le_of_lintegral_real_rpow_bound hp0
    (T f) f (hTnonneg f) (ENNReal.ofReal A) hlin'
  simpa only [A, Atail, ENNReal.ofReal_rpow_of_pos hA] using hnorm

/-- Existential form of
`schwartz_operator_strong_above_of_diagonal_top_with_constant`, retained for
the compact lowpass development. -/
private theorem schwartz_operator_strong_above_of_diagonal_top
    {d : Nat} (T : SchwartzMap (Euclidean d) Complex -> Euclidean d -> Real)
    {r p C Ctop : Real} (hr : 0 < r) (hrp : r < p)
    (hC : 0 < C) (hCtop : 0 < Ctop)
    (hTmeas : ∀ f : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (T f) volume)
    (hTnonneg : ∀ (f : SchwartzMap (Euclidean d) Complex) x, 0 <= T f x)
    (hTsub : ∀ (f g : SchwartzMap (Euclidean d) Complex) x,
      T (f + g) x <= T f x + T g x)
    (hstrong : ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (T f) (ENNReal.ofReal r) volume /\
      eLpNorm (T f) (ENNReal.ofReal r) volume <=
        ENNReal.ofReal C *
          eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal r) volume)
    (htop : ∀ (f : SchwartzMap (Euclidean d) Complex) (a : Real), 0 <= a ->
      (∀ x, ‖f x‖ <= a) -> ∀ x, T f x <= Ctop * a) :
    ∃ A : Real, 0 < A ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (T f) (ENNReal.ofReal p) volume /\
      eLpNorm (T f) (ENNReal.ofReal p) volume <=
        ENNReal.ofReal (A ^ p⁻¹) *
          eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal p) volume := by
  let Atail : Real := (p - r)⁻¹ * (4 : Real) ^ (p - r)
  let A : Real := p * (2 : Real) ^ r * (C ^ r) * Atail * Ctop ^ (p - r)
  have hAtail : 0 < Atail := by
    dsimp only [Atail]
    have hpr : 0 < p - r := sub_pos.mpr hrp
    exact mul_pos (inv_pos.mpr hpr) (Real.rpow_pos_of_pos (by norm_num) _)
  have hA : 0 < A := by
    dsimp only [A]
    have hp0 : 0 < p := lt_trans hr hrp
    exact mul_pos (mul_pos (mul_pos (mul_pos hp0
      (Real.rpow_pos_of_pos (by norm_num) _))
      (Real.rpow_pos_of_pos hC _)) hAtail) (Real.rpow_pos_of_pos hCtop _)
  refine ⟨A, hA, ?_⟩
  intro f
  simpa only [A, Atail] using
    (schwartz_operator_strong_above_of_diagonal_top_with_constant
      T hr hrp hC hCtop hTmeas hTnonneg hTsub hstrong htop f)

/-- The level-zero absolute cutoff has a diagonal strong estimate at every
finite exponent bigger than one.  Below two this is the local `L¹/L²`
calculation already proved for the compact interval.  At and above two we
apply the preceding smooth-split argument to the actual compact cutoff and
its literal Schwartz-kernel top endpoint. -/
private theorem absolute_lowpass_diagonal_all_exponents
    {d : Nat} (hd : 0 < d) (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiZero : ∀ xi, 2 <= ‖xi‖ -> phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ <= 1)
    {p : Real} (hp : 1 < p) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalSphericalMaximalReal d E
        (absoluteCutoffProjection phi 0 f)) (ENNReal.ofReal p) volume /\
      eLpNorm (fractalSphericalMaximalReal d E
        (absoluteCutoffProjection phi 0 f)) (ENNReal.ofReal p) volume <=
        ENNReal.ofReal C *
          eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  by_cases hp2 : p < 2
  · obtain ⟨B, hB, hregular⟩ :=
      absolute_lowpass_strong_type hd E hE phi hphiZero hphiNorm hp hp2
    refine ⟨B ^ p⁻¹, Real.rpow_pos_of_pos hB _, ?_⟩
    intro f
    obtain ⟨hmem, hmoment⟩ := hregular f
    refine ⟨hmem, ?_⟩
    exact lowpass_eLpNorm_le_of_diagonal_moment hp0
      (fractalSphericalMaximalReal d E (absoluteCutoffProjection phi 0 f)) f
      hmem (fun _ => ENNReal.toReal_nonneg) hB.le hmoment
  · have hpge : 2 <= p := le_of_not_gt hp2
    let r : Real := (3 : Real) / 2
    have hr : 0 < r := by
      dsimp only [r]
      norm_num
    have hr1 : 1 < r := by
      dsimp only [r]
      norm_num
    have hr2 : r < 2 := by
      dsimp only [r]
      norm_num
    have hrp : r < p := by
      calc
        r < 2 := hr2
        _ <= p := hpge
    obtain ⟨B, hB, hregular⟩ :=
      absolute_lowpass_strong_type hd E hE phi hphiZero hphiNorm hr1 hr2
    have hEpos : E ⊆ Ioi (0 : Real) := by
      intro t ht
      exact lt_of_lt_of_le zero_lt_one (hE ht).1
    let T : SchwartzMap (Euclidean d) Complex -> Euclidean d -> Real :=
      fun f => fractalSphericalMaximalReal d E (absoluteCutoffProjection phi 0 f)
    have hTmeas : ∀ f : SchwartzMap (Euclidean d) Complex,
        AEStronglyMeasurable (T f) volume := by
      intro f
      dsimp only [T]
      exact (measurable_fractalSphericalMaximalReal E
        (absoluteCutoffProjection phi 0 f)).aestronglyMeasurable
    have hTnonneg : ∀ (f : SchwartzMap (Euclidean d) Complex) x, 0 <= T f x := by
      intro f x
      exact ENNReal.toReal_nonneg
    have hTsub : ∀ (f g : SchwartzMap (Euclidean d) Complex) x,
        T (f + g) x <= T f x + T g x := by
      intro f g x
      dsimp only [T]
      have hprojection : absoluteCutoffProjection phi 0 (f + g) =
          absoluteCutoffProjection phi 0 f + absoluteCutoffProjection phi 0 g := by
        change dyadicBandpassProjection (absoluteCutoffMultiplier phi 0) (f + g) =
          dyadicBandpassProjection (absoluteCutoffMultiplier phi 0) f +
            dyadicBandpassProjection (absoluteCutoffMultiplier phi 0) g
        exact dyadicBandpassProjection_add (absoluteCutoffMultiplier phi 0) f g
      rw [hprojection]
      exact Auto.Spherical.AHRS.fractalSphericalMaximalReal_schwartz_add_le hd E hEpos _ _ x
    let C : Real := B ^ r⁻¹
    have hC : 0 < C := by
      dsimp only [C]
      exact Real.rpow_pos_of_pos hB _
    have hstrong : ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (T f) (ENNReal.ofReal r) volume /\
        eLpNorm (T f) (ENNReal.ofReal r) volume <=
          ENNReal.ofReal C *
            eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal r) volume := by
      intro f
      obtain ⟨hmem, hmoment⟩ := hregular f
      refine ⟨by simpa only [T] using hmem, ?_⟩
      dsimp only [C]
      exact lowpass_eLpNorm_le_of_diagonal_moment hr
        (fractalSphericalMaximalReal d E (absoluteCutoffProjection phi 0 f)) f
        hmem (fun _ => ENNReal.toReal_nonneg) hB.le hmoment
    obtain ⟨Ctop, hCtop, htop⟩ :=
      absolute_lowpass_top_endpoint hd E hEpos phi
    obtain ⟨A, hA, hAstrong⟩ :=
      schwartz_operator_strong_above_of_diagonal_top T hr hrp hC hCtop
        hTmeas hTnonneg hTsub hstrong
        (by
          intro f a ha hfa x
          simpa only [T] using htop f a ha hfa x)
    exact ⟨A ^ p⁻¹, Real.rpow_pos_of_pos hA _, by
      intro f
      simpa only [T] using hAstrong f⟩

/-- Convert the homogeneous off-diagonal moment estimate produced by the
compact-kernel argument into the corresponding extended-real norm estimate.
The input exponent and output exponent are deliberately different here. -/
private theorem lowpass_eLpNorm_le_of_off_diagonal_moment
    {d : Nat} {p q A : Real} (hp0 : 0 < p) (hq0 : 0 < q)
    (g : Euclidean d → Real) (f : SchwartzMap (Euclidean d) Complex)
    (hgmem : MemLp g (ENNReal.ofReal q) volume) (hg0 : ∀ x, 0 ≤ g x)
    (hA : 0 ≤ A)
    (hmoment : (∫ x : Euclidean d, g x ^ q) ≤
      A * (∫ x : Euclidean d, ‖f x‖ ^ p) ^ (q / p)) :
    eLpNorm g (ENNReal.ofReal q) volume ≤
      ENNReal.ofReal (A ^ q⁻¹) *
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let I : Real := ∫ x : Euclidean d, ‖f x‖ ^ p
  have hpNN : 0 ≤ p := hp0.le
  have hqNN : 0 ≤ q := hq0.le
  have hpE0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpET : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq0
  have hqET : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p
  have hfmem : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  calc
    eLpNorm g (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal ((A * I ^ (q / p)) ^ q⁻¹) := by
      rw [hgmem.eLpNorm_eq_integral_rpow_norm hqE0 hqET]
      apply ENNReal.ofReal_le_ofReal
      rw [ENNReal.toReal_ofReal hqNN]
      apply Real.rpow_le_rpow
      · exact integral_nonneg fun x => by
          rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x)]
          exact Real.rpow_nonneg (hg0 x) q
      · calc
          (∫ x : Euclidean d, ‖g x‖ ^ q) = ∫ x : Euclidean d, g x ^ q := by
            apply integral_congr_ae
            filter_upwards with x
            rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x)]
          _ ≤ A * I ^ (q / p) := by simpa only [I] using hmoment
      · exact inv_nonneg.mpr hqNN
    _ = ENNReal.ofReal (A ^ q⁻¹) *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
      rw [show (A * I ^ (q / p)) ^ q⁻¹ =
          A ^ q⁻¹ * I ^ p⁻¹ by
        rw [Real.mul_rpow hA (Real.rpow_nonneg hI _)]
        rw [← Real.rpow_mul hI]
        congr 1
        field_simp]
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg hA _)]
      rw [hfmem.eLpNorm_eq_integral_rpow_norm hpE0 hpET,
        ENNReal.toReal_ofReal hpNN]

/-- The compact frequency cutoff is genuinely improving.  This is the
literal low-frequency input for the final off-diagonal reassembly: a
Schwartz kernel gives a global `L^p → L^∞` bound, while the compact-radius
argument supplies its diagonal `L^p` control.  Interpolating those two
*concrete* estimates by the elementary power inequality below gives every
strict `p < q`; no all-radius maximal theorem and no restricted-weak-type
premise is used. -/
theorem absolute_lowpass_improving_eLpNorm
    {d : Nat} {p q : Real} (hd : 0 < d)
    (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hp : 1 < p) (hpq : p < q) :
    ∃ CR : ENNReal, CR < ⊤ ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalSphericalMaximalReal d E
        (absoluteCutoffProjection phi 0 f)) (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalSphericalMaximalReal d E
        (absoluteCutoffProjection phi 0 f)) (ENNReal.ofReal q) volume ≤
        CR * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hq0 : 0 < q := lt_trans hp0 hpq
  have hdiff : 0 ≤ q - p := sub_nonneg.mpr hpq.le
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  obtain ⟨C, hC, hdiagonal⟩ :=
    absolute_lowpass_diagonal_all_exponents hd E hE phi hphiZero hphiNorm hp
  let p' : Real := p / (p - 1)
  let K : Real := (∫ y : Euclidean d,
      ‖(𝓕⁻ phi : SchwartzMap (Euclidean d) Complex) y‖ ^ p') ^ p'⁻¹
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact Real.rpow_nonneg
      (integral_nonneg fun y => Real.rpow_nonneg (norm_nonneg _) p') _
  let A : Real := K ^ (q - p) * C ^ p
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact mul_nonneg (Real.rpow_nonneg hK _) (Real.rpow_nonneg hC.le _)
  refine ⟨ENNReal.ofReal (A ^ q⁻¹), ENNReal.ofReal_lt_top, ?_⟩
  intro f
  let g : Euclidean d → Real := fractalSphericalMaximalReal d E
    (absoluteCutoffProjection phi 0 f)
  let I : Real := ∫ x : Euclidean d, ‖f x‖ ^ p
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p
  have hg0 : ∀ x, 0 ≤ g x := fun x => ENNReal.toReal_nonneg
  have hgmeas : AEStronglyMeasurable g volume := by
    dsimp only [g]
    exact (measurable_fractalSphericalMaximalReal E
      (absoluteCutoffProjection phi 0 f)).aestronglyMeasurable
  have hpmem : MemLp g (ENNReal.ofReal p) volume := by
    simpa only [g] using (hdiagonal f).1
  have hpnorm : eLpNorm g (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal C * eLpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal p) volume := by
    simpa only [g] using (hdiagonal f).2
  have hpMomentRaw := off_diagonal_moment_bound_of_eLpNorm
    (p := p) (q := p) hp0 hp0 g hpmem hg0 f (ENNReal.ofReal C)
      ENNReal.ofReal_ne_top hpnorm
  have hpMoment : (∫ x : Euclidean d, g x ^ p) ≤ C ^ p * I := by
    simpa only [ENNReal.toReal_ofReal hC.le,
      div_self (ne_of_gt hp0), Real.rpow_one, I] using hpMomentRaw
  have hpoint : ∀ x : Euclidean d, g x ≤ K * I ^ p⁻¹ := by
    intro x
    dsimp only [g, K, I, p']
    simpa only using
      fractal_lowpass_pointwise_le_lp_conj hd E hEpos hp phi f x
  let H : Real := K * I ^ p⁻¹
  have hH : 0 ≤ H := by
    dsimp only [H]
    exact mul_nonneg hK (Real.rpow_nonneg hI _)
  have hpointH : ∀ x : Euclidean d, g x ≤ H := by
    intro x
    simpa only [H] using hpoint x
  have hpower : ∀ x : Euclidean d,
      g x ^ q ≤ H ^ (q - p) * g x ^ p := by
    intro x
    calc
      g x ^ q = g x ^ ((q - p) + p) := by congr 1; ring
      _ = g x ^ (q - p) * g x ^ p :=
        Real.rpow_add_of_nonneg (hg0 x) hdiff hp0.le
      _ ≤ H ^ (q - p) * g x ^ p := by
        apply mul_le_mul_of_nonneg_right
        · exact Real.rpow_le_rpow (hg0 x) (hpointH x) hdiff
        · exact Real.rpow_nonneg (hg0 x) p
  have hpowerENN : ∀ x : Euclidean d,
      ENNReal.ofReal (g x ^ q) ≤
        ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) := by
    intro x
    calc
      ENNReal.ofReal (g x ^ q) ≤
          ENNReal.ofReal (H ^ (q - p) * g x ^ p) :=
        ENNReal.ofReal_le_ofReal (hpower x)
      _ = ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hH _)
  have hpE0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpET : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hgpint : Integrable (fun x : Euclidean d => g x ^ p) volume := by
    have h := hpmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x),
      ENNReal.toReal_ofReal hp0.le]
  have hgpLin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p)) =
      ENNReal.ofReal (∫ x : Euclidean d, g x ^ p) :=
    (ofReal_integral_eq_lintegral_ofReal hgpint
      (Filter.Eventually.of_forall fun x =>
        Real.rpow_nonneg (hg0 x) p)).symm
  have hgpfin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p)) < ⊤ := by
    rw [hgpLin]
    exact ENNReal.ofReal_lt_top
  have hqLin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) ≤
      ENNReal.ofReal (H ^ (q - p)) *
        ∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p) := by
    calc
      (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) ≤
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) :=
        lintegral_mono (fun x => hpowerENN x)
      _ = ENNReal.ofReal (H ^ (q - p)) *
          ∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  have hqfin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) < ⊤ :=
    hqLin.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hgpfin)
  have hqmem : MemLp g (ENNReal.ofReal q) volume :=
    memLp_of_lintegral_ofReal_rpow_lt_top g hgmeas.aemeasurable hg0 hq0 hqfin
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq0
  have hqET : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have hqint : Integrable (fun x : Euclidean d => g x ^ q) volume := by
    have h := hqmem.integrable_norm_rpow hqE0 hqET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x),
      ENNReal.toReal_ofReal hq0.le]
  have hqMomentPre : (∫ x : Euclidean d, g x ^ q) ≤
      H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := by
    calc
      (∫ x : Euclidean d, g x ^ q) ≤
          ∫ x : Euclidean d, H ^ (q - p) * g x ^ p :=
        integral_mono hqint (hgpint.const_mul (H ^ (q - p))) (hpower)
      _ = H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := by
        rw [integral_const_mul]
  have hIpowexp : 0 ≤ p⁻¹ * (q - p) :=
    mul_nonneg (inv_nonneg.mpr hp0.le) hdiff
  have hIpower : (I ^ p⁻¹) ^ (q - p) * I = I ^ (q / p) := by
    calc
      (I ^ p⁻¹) ^ (q - p) * I =
          I ^ (p⁻¹ * (q - p)) * I ^ (1 : Real) := by
        rw [← Real.rpow_mul hI, Real.rpow_one]
      _ = I ^ (p⁻¹ * (q - p) + 1) :=
        (Real.rpow_add_of_nonneg hI hIpowexp zero_le_one).symm
      _ = I ^ (q / p) := by
        congr 1
        field_simp [ne_of_gt hp0]; ring
  have hfactor : H ^ (q - p) * (C ^ p * I) =
      A * I ^ (q / p) := by
    dsimp only [H, A]
    rw [Real.mul_rpow hK (Real.rpow_nonneg hI _)]
    rw [show (K ^ (q - p) * (I ^ p⁻¹) ^ (q - p)) * (C ^ p * I) =
        (K ^ (q - p) * C ^ p) * ((I ^ p⁻¹) ^ (q - p) * I) by ring]
    rw [hIpower]
  have hqMoment : (∫ x : Euclidean d, g x ^ q) ≤ A * I ^ (q / p) := by
    calc
      (∫ x : Euclidean d, g x ^ q) ≤
          H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := hqMomentPre
      _ ≤ H ^ (q - p) * (C ^ p * I) :=
        mul_le_mul_of_nonneg_left hpMoment
          (Real.rpow_nonneg hH _)
      _ = A * I ^ (q / p) := hfactor
  refine ⟨by simpa only [g] using hqmem, ?_⟩
  simpa only [g, A, I] using
    lowpass_eLpNorm_le_of_off_diagonal_moment hp0 hq0 g f hqmem hg0 hA hqMoment

/-! ## A fixed compact bandpass -/

/-- The physical Schwartz kernel gives the same literal `L^p -> L^∞`
bound for an arbitrary fixed compact bandpass.  Unlike the lowpass lemma
above, this statement makes no support-radius or multiplier-size
normalization: those are part of the actual Schwartz multiplier `psi`. -/
theorem fractal_dyadicBandpass_pointwise_le_lp_conj
    {d : Nat} (hd : 0 < d) (E : Set Real) (hE : E ⊆ Ioi (0 : Real))
    {p : Real} (hp : 1 < p)
    (psi f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    fractalDyadicBandpassMaximal d E psi f x <=
      (∫ y : Euclidean d,
        ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) y‖ ^
          (p / (p - 1))) ^ (p / (p - 1))⁻¹ *
      (∫ y : Euclidean d, ‖f y‖ ^ p) ^ p⁻¹ := by
  let C : Real :=
    (∫ y : Euclidean d,
      ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) y‖ ^
        (p / (p - 1))) ^ (p / (p - 1))⁻¹ *
    (∫ y : Euclidean d, ‖f y‖ ^ p) ^ p⁻¹
  have hC : 0 <= C := by
    dsimp only [C]
    exact mul_nonneg
      (Real.rpow_nonneg (integral_nonneg fun _ =>
        Real.rpow_nonneg (norm_nonneg _) _) _)
      (Real.rpow_nonneg (integral_nonneg fun _ =>
        Real.rpow_nonneg (norm_nonneg _) _) _)
  have hprojection : ∀ y : Euclidean d,
      ‖dyadicBandpassProjection psi f y‖ <= C := by
    intro y
    simpa only [C] using norm_dyadicBandpassProjection_le_lp_conj hp psi f y
  change (fractalSphericalMaximal d E
    (dyadicBandpassProjection psi f : Euclidean d -> Complex) x).toReal <= C
  rw [← ENNReal.toReal_ofReal hC]
  apply (ENNReal.toReal_le_toReal
    (fractalSphericalMaximal_ne_top hd E hE
      (dyadicBandpassProjection psi f) x) ENNReal.ofReal_ne_top).mpr
  calc
    fractalSphericalMaximal d E
        (dyadicBandpassProjection psi f : Euclidean d -> Complex) x <=
        normalizedSphericalMaximal d
          (dyadicBandpassProjection psi f : Euclidean d -> Complex) x :=
      fractalSphericalMaximal_le_normalizedSphericalMaximal E hE _ x
    _ <= ENNReal.ofReal C :=
      normalizedSphericalMaximal_le_of_norm_le hd _ x hprojection

/-- A literal diagonal moment estimate for one fixed Schwartz bandpass,
together with its physical kernel bound, yields every strict improving
estimate `p -> q`.  This is the compact `j = 0` reassembly principle used
for the absolute dyadic decomposition.  It does not appeal to a global
spherical maximal theorem. -/
theorem compact_bandpass_improving_eLpNorm_of_diagonal_moment
    {d : Nat} {p q : Real} (hd : 0 < d)
    (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hp : 1 < p) (hpq : p < q)
    (hdiagonal : ∃ B : Real, 0 < B ∧
      ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (fractalDyadicBandpassMaximal d E psi f)
          (ENNReal.ofReal p) volume ∧
        (∫ x : Euclidean d,
          (fractalDyadicBandpassMaximal d E psi f x) ^ p) <=
          B * ∫ x : Euclidean d, ‖f x‖ ^ p) :
    ∃ CR : ENNReal, CR < ⊤ ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E psi f)
        (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E psi f)
        (ENNReal.ofReal q) volume <=
        CR * eLpNorm (f : Euclidean d -> Complex) (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hq0 : 0 < q := lt_trans hp0 hpq
  have hdiff : 0 <= q - p := sub_nonneg.mpr hpq.le
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  obtain ⟨B, hB, hdiagonal⟩ := hdiagonal
  let C : Real := B ^ p⁻¹
  have hC : 0 < C := Real.rpow_pos_of_pos hB _
  let p' : Real := p / (p - 1)
  let K : Real := (∫ y : Euclidean d,
      ‖(𝓕⁻ psi : SchwartzMap (Euclidean d) Complex) y‖ ^ p') ^ p'⁻¹
  have hK : 0 <= K := by
    dsimp only [K]
    exact Real.rpow_nonneg
      (integral_nonneg fun y => Real.rpow_nonneg (norm_nonneg _) p') _
  let A : Real := K ^ (q - p) * C ^ p
  have hA : 0 <= A := by
    dsimp only [A]
    exact mul_nonneg (Real.rpow_nonneg hK _) (Real.rpow_nonneg hC.le _)
  refine ⟨ENNReal.ofReal (A ^ q⁻¹), ENNReal.ofReal_lt_top, ?_⟩
  intro f
  let g : Euclidean d -> Real := fractalDyadicBandpassMaximal d E psi f
  let I : Real := ∫ x : Euclidean d, ‖f x‖ ^ p
  have hI : 0 <= I := by
    dsimp only [I]
    exact integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p
  have hg0 : ∀ x, 0 <= g x := fun x => ENNReal.toReal_nonneg
  have hgmeas : AEStronglyMeasurable g volume := by
    dsimp only [g]
    exact (measurable_fractalDyadicBandpassMaximal E psi f).aestronglyMeasurable
  have hpmem : MemLp g (ENNReal.ofReal p) volume := by
    simpa only [g] using (hdiagonal f).1
  have hpMomentGiven : (∫ x : Euclidean d, g x ^ p) <= B * I := by
    simpa only [g, I] using (hdiagonal f).2
  have hpnorm : eLpNorm g (ENNReal.ofReal p) volume <=
      ENNReal.ofReal C * eLpNorm (f : Euclidean d -> Complex)
        (ENNReal.ofReal p) volume := by
    dsimp only [C]
    exact lowpass_eLpNorm_le_of_diagonal_moment hp0 g f hpmem hg0 hB.le
      hpMomentGiven
  have hpMomentRaw := off_diagonal_moment_bound_of_eLpNorm
    (p := p) (q := p) hp0 hp0 g hpmem hg0 f (ENNReal.ofReal C)
      ENNReal.ofReal_ne_top hpnorm
  have hpMoment : (∫ x : Euclidean d, g x ^ p) <= C ^ p * I := by
    simpa only [ENNReal.toReal_ofReal hC.le,
      div_self (ne_of_gt hp0), Real.rpow_one, I] using hpMomentRaw
  have hpoint : ∀ x : Euclidean d, g x <= K * I ^ p⁻¹ := by
    intro x
    dsimp only [g, K, I, p']
    simpa only using
      fractal_dyadicBandpass_pointwise_le_lp_conj hd E hEpos hp psi f x
  let H : Real := K * I ^ p⁻¹
  have hH : 0 <= H := by
    dsimp only [H]
    exact mul_nonneg hK (Real.rpow_nonneg hI _)
  have hpointH : ∀ x : Euclidean d, g x <= H := by
    intro x
    simpa only [H] using hpoint x
  have hpower : ∀ x : Euclidean d,
      g x ^ q <= H ^ (q - p) * g x ^ p := by
    intro x
    calc
      g x ^ q = g x ^ ((q - p) + p) := by congr 1; ring
      _ = g x ^ (q - p) * g x ^ p :=
        Real.rpow_add_of_nonneg (hg0 x) hdiff hp0.le
      _ <= H ^ (q - p) * g x ^ p := by
        apply mul_le_mul_of_nonneg_right
        · exact Real.rpow_le_rpow (hg0 x) (hpointH x) hdiff
        · exact Real.rpow_nonneg (hg0 x) p
  have hpowerENN : ∀ x : Euclidean d,
      ENNReal.ofReal (g x ^ q) <=
        ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) := by
    intro x
    calc
      ENNReal.ofReal (g x ^ q) <=
          ENNReal.ofReal (H ^ (q - p) * g x ^ p) :=
        ENNReal.ofReal_le_ofReal (hpower x)
      _ = ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hH _)
  have hpE0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpET : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hgpint : Integrable (fun x : Euclidean d => g x ^ p) volume := by
    have h := hpmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x),
      ENNReal.toReal_ofReal hp0.le]
  have hgpLin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p)) =
      ENNReal.ofReal (∫ x : Euclidean d, g x ^ p) :=
    (ofReal_integral_eq_lintegral_ofReal hgpint
      (Filter.Eventually.of_forall fun x =>
        Real.rpow_nonneg (hg0 x) p)).symm
  have hgpfin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p)) < ⊤ := by
    rw [hgpLin]
    exact ENNReal.ofReal_lt_top
  have hqLin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) <=
      ENNReal.ofReal (H ^ (q - p)) *
        ∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p) := by
    calc
      (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) <=
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal (H ^ (q - p)) * ENNReal.ofReal (g x ^ p) :=
        lintegral_mono (fun x => hpowerENN x)
      _ = ENNReal.ofReal (H ^ (q - p)) *
          ∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ p) := by
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  have hqfin : (∫⁻ x : Euclidean d, ENNReal.ofReal (g x ^ q)) < ⊤ :=
    hqLin.trans_lt (ENNReal.mul_lt_top ENNReal.ofReal_lt_top hgpfin)
  have hqmem : MemLp g (ENNReal.ofReal q) volume :=
    memLp_of_lintegral_ofReal_rpow_lt_top g hgmeas.aemeasurable hg0 hq0 hqfin
  have hqE0 : ENNReal.ofReal q ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hq0
  have hqET : ENNReal.ofReal q ≠ ⊤ := ENNReal.ofReal_ne_top
  have hqint : Integrable (fun x : Euclidean d => g x ^ q) volume := by
    have h := hqmem.integrable_norm_rpow hqE0 hqET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hg0 x),
      ENNReal.toReal_ofReal hq0.le]
  have hqMomentPre : (∫ x : Euclidean d, g x ^ q) <=
      H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := by
    calc
      (∫ x : Euclidean d, g x ^ q) <=
          ∫ x : Euclidean d, H ^ (q - p) * g x ^ p :=
        integral_mono hqint (hgpint.const_mul (H ^ (q - p))) (hpower)
      _ = H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := by
        rw [integral_const_mul]
  have hIpowexp : 0 <= p⁻¹ * (q - p) :=
    mul_nonneg (inv_nonneg.mpr hp0.le) hdiff
  have hIpower : (I ^ p⁻¹) ^ (q - p) * I = I ^ (q / p) := by
    calc
      (I ^ p⁻¹) ^ (q - p) * I =
          I ^ (p⁻¹ * (q - p)) * I ^ (1 : Real) := by
        rw [← Real.rpow_mul hI, Real.rpow_one]
      _ = I ^ (p⁻¹ * (q - p) + 1) :=
        (Real.rpow_add_of_nonneg hI hIpowexp zero_le_one).symm
      _ = I ^ (q / p) := by
        congr 1
        field_simp [ne_of_gt hp0]; ring
  have hfactor : H ^ (q - p) * (C ^ p * I) =
      A * I ^ (q / p) := by
    dsimp only [H, A]
    rw [Real.mul_rpow hK (Real.rpow_nonneg hI _)]
    rw [show (K ^ (q - p) * (I ^ p⁻¹) ^ (q - p)) * (C ^ p * I) =
        (K ^ (q - p) * C ^ p) * ((I ^ p⁻¹) ^ (q - p) * I) by ring]
    rw [hIpower]
  have hqMoment : (∫ x : Euclidean d, g x ^ q) <= A * I ^ (q / p) := by
    calc
      (∫ x : Euclidean d, g x ^ q) <=
          H ^ (q - p) * ∫ x : Euclidean d, g x ^ p := hqMomentPre
      _ <= H ^ (q - p) * (C ^ p * I) :=
        mul_le_mul_of_nonneg_left hpMoment
          (Real.rpow_nonneg hH _)
      _ = A * I ^ (q / p) := hfactor
  refine ⟨by simpa only [g] using hqmem, ?_⟩
  simpa only [g, A, I] using
    lowpass_eLpNorm_le_of_off_diagonal_moment hp0 hq0 g f hqmem hg0 hA hqMoment

/-- A fixed compact dyadic multiplier has a diagonal strong estimate below
two once its literal unnormalised interval endpoints are supplied.  This is
public because the `j = 0` band in the Q4 reassembly is a single such compact
multiplier; its finite constant is absorbed into the global dyadic constant.
The theorem is radius-agnostic and contains no all-radius maximal input. -/
theorem compact_bandpass_diagonal_below_two_of_unnormalized_endpoints
    {d : Nat} (hd : 0 < d) (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (psi : SchwartzMap (Euclidean d) Complex) {c₁ c₂ : Real}
    (hc₁ : 0 ≤ c₁) (hc₂ : 0 ≤ c₂)
    (hone : ∀ g : SchwartzMap (Euclidean d) Complex,
      MemLp (unnormalizedFractalDyadicBandpassMaximal d E psi g) 1 volume ∧
      (∫ x : Euclidean d,
        ‖unnormalizedFractalDyadicBandpassMaximal d E psi g x‖) ≤
          c₁ * ∫ x : Euclidean d, ‖g x‖)
    (htwo : ∀ g : SchwartzMap (Euclidean d) Complex,
      MemLp (unnormalizedFractalDyadicBandpassMaximal d E psi g) 2 volume ∧
      (∫ x : Euclidean d,
        ‖unnormalizedFractalDyadicBandpassMaximal d E psi g x‖ ^ (2 : Nat)) ≤
          c₂ * ∫ x : Euclidean d, ‖g x‖ ^ (2 : Nat))
    {p : Real} (hp1 : 1 < p) (hp2 : p < 2) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E psi f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        (fractalDyadicBandpassMaximal d E psi f x) ^ p) ≤
          B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  let K : ENNReal := ENNReal.ofReal p *
    (4 * ENNReal.ofReal c₂ *
      (ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
        (ENNReal.ofReal (2 - p))⁻¹) +
      2 * ENNReal.ofReal c₁ *
        ((ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹))
  have hp0 : 0 < p := lt_trans zero_lt_one hp1
  have hKtop : K < ⊤ := by
    have hp_pos : 0 < ENNReal.ofReal p := ENNReal.ofReal_pos.mpr hp0
    have htwo_pos : 0 < ENNReal.ofReal (2 - p) :=
      ENNReal.ofReal_pos.mpr (by linarith)
    have hone_pos : 0 < ENNReal.ofReal (p - 1) :=
      ENNReal.ofReal_pos.mpr (by linarith)
    have hthree_pos : 0 < ENNReal.ofReal (3 - p) :=
      ENNReal.ofReal_pos.mpr (by linarith)
    dsimp only [K]
    apply ENNReal.mul_lt_top ENNReal.ofReal_lt_top
    apply ENNReal.add_lt_top.mpr
    constructor
    · apply ENNReal.mul_lt_top
      · exact ENNReal.mul_lt_top (by norm_num) ENNReal.ofReal_lt_top
      · apply ENNReal.add_lt_top.mpr
        constructor
        · exact ENNReal.mul_lt_top ENNReal.ofReal_lt_top
            (ENNReal.inv_lt_top.mpr hp_pos)
        · exact ENNReal.inv_lt_top.mpr htwo_pos
    · apply ENNReal.mul_lt_top
      · exact ENNReal.mul_lt_top (by norm_num) ENNReal.ofReal_lt_top
      · apply ENNReal.add_lt_top.mpr
        exact ⟨ENNReal.inv_lt_top.mpr hone_pos,
          ENNReal.inv_lt_top.mpr hthree_pos⟩
  let C : Real := K.toReal + 1
  have hC : 0 < C := by
    dsimp only [C]
    linarith [ENNReal.toReal_nonneg (a := K)]
  have hmass : 0 < surfaceMass d := surfaceMass_pos hd
  let k : Real := (surfaceMass d)⁻¹
  have hk : 0 < k := by
    dsimp only [k]
    exact inv_pos.mpr hmass
  refine ⟨k ^ p * C, mul_pos (Real.rpow_pos_of_pos hk _) hC, ?_⟩
  intro f
  let U : Euclidean d → Real := unnormalizedFractalDyadicBandpassMaximal d E psi f
  let M : Euclidean d → Real := fractalDyadicBandpassMaximal d E psi f
  have hU0 : ∀ x, 0 ≤ U x := fun x =>
    unnormalizedFractalDyadicBandpassMaximal_nonneg E psi f x
  have hM0 : ∀ x, 0 ≤ M x := fun x =>
    fractalDyadicBandpassMaximal_nonneg E psi f x
  have hlin := unnormalizedFractalDyadicBandpass_lintegral_of_one_two
    hd hEpos psi hc₁ hc₂ hone htwo hp1 hp2 f 1 (by norm_num : (0 : Real) < 1)
  have hlinK : (∫⁻ x : Euclidean d, ENNReal.ofReal ((U x) ^ p)) ≤
      K * ∫⁻ x : Euclidean d, (ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖) ^ p := by
    calc
      (∫⁻ x : Euclidean d, ENNReal.ofReal ((U x) ^ p)) ≤ _ := by
        simpa only [U] using hlin
      _ = K * ∫⁻ x : Euclidean d,
          (ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖) ^ p := by
            dsimp only [K]
            simp only [ENNReal.ofReal_one, ENNReal.one_rpow, one_mul]
            ring
  let I : Real := ∫ x : Euclidean d, ‖(f : Euclidean d → Complex) x‖ ^ p
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) p
  have hfmem : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have hfint : Integrable (fun x : Euclidean d =>
      ‖(f : Euclidean d → Complex) x‖ ^ p) volume := by
    have h := hfmem.integrable_norm_rpow
      (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top
    simpa only [ENNReal.toReal_ofReal hp0.le] using h
  have hinput : (∫⁻ x : Euclidean d,
      (ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖) ^ p) = ENNReal.ofReal I := by
    calc
      (∫⁻ x : Euclidean d,
        (ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖) ^ p) =
          ∫⁻ x : Euclidean d,
            ENNReal.ofReal (‖(f : Euclidean d → Complex) x‖ ^ p) := by
              apply lintegral_congr
              intro x
              exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le
      _ = ENNReal.ofReal I := by
        rw [show I = ∫ x : Euclidean d,
            ‖(f : Euclidean d → Complex) x‖ ^ p by rfl]
        exact (ofReal_integral_eq_lintegral_ofReal hfint
          (Filter.Eventually.of_forall fun x =>
            Real.rpow_nonneg (norm_nonneg _) p)).symm
  have hlinC : (∫⁻ x : Euclidean d, ENNReal.ofReal ((U x) ^ p)) ≤
      ENNReal.ofReal (C * I) := by
    rw [hinput] at hlinK
    calc
      (∫⁻ x : Euclidean d, ENNReal.ofReal ((U x) ^ p)) ≤ K * ENNReal.ofReal I :=
        hlinK
      _ = ENNReal.ofReal K.toReal * ENNReal.ofReal I := by
        rw [ENNReal.ofReal_toReal hKtop.ne]
      _ = ENNReal.ofReal (K.toReal * I) := by
        rw [ENNReal.ofReal_mul ENNReal.toReal_nonneg]
      _ ≤ ENNReal.ofReal ((K.toReal + 1) * I) := by
        apply ENNReal.ofReal_le_ofReal
        apply mul_le_mul_of_nonneg_right
        · linarith [ENNReal.toReal_nonneg (a := K)]
        · exact hI
      _ = ENNReal.ofReal (C * I) := by rfl
  have hUmemMoment := memLp_and_integral_of_lintegral_rpow_bound U
    (measurable_unnormalizedFractalDyadicBandpassMaximal E psi f).aestronglyMeasurable
    hU0 hp0 hlinC
    (mul_nonneg (by linarith [ENNReal.toReal_nonneg (a := K)]) hI)
  have hpoint : ∀ x, M x ≤ k * U x := by
    intro x
    dsimp only [M, U, k, unnormalizedFractalDyadicBandpassMaximal,
      fractalDyadicBandpassMaximal]
    rw [← mul_assoc, inv_mul_cancel₀ hmass.ne', one_mul]
  have hscaledmem : MemLp (fun x : Euclidean d => k * U x)
      (ENNReal.ofReal p) volume := hUmemMoment.1.const_mul k
  have hMmem : MemLp M (ENNReal.ofReal p) volume := by
    apply hscaledmem.mono
      (measurable_fractalSphericalMaximalReal E
        (dyadicBandpassProjection psi f)).aestronglyMeasurable
    filter_upwards with x
    change ‖M x‖ ≤ ‖k * U x‖
    calc
      ‖M x‖ = M x := by
        rw [Real.norm_eq_abs, abs_of_nonneg (hM0 x)]
      _ ≤ k * U x := hpoint x
      _ = ‖k * U x‖ := by
        rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hk.le (hU0 x))]
  have hpE0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpET : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hMint : Integrable (fun x : Euclidean d => M x ^ p) volume := by
    have h := hMmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hM0 x),
      ENNReal.toReal_ofReal hp0.le]
  have hUint : Integrable (fun x : Euclidean d => (k * U x) ^ p) volume := by
    have h := hscaledmem.integrable_norm_rpow hpE0 hpET
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hk.le (hU0 x)),
      ENNReal.toReal_ofReal hp0.le]
  refine ⟨by simpa only [M] using hMmem, ?_⟩
  calc
    (∫ x : Euclidean d, M x ^ p) ≤ ∫ x : Euclidean d, (k * U x) ^ p :=
      integral_mono hMint hUint (fun x =>
        Real.rpow_le_rpow (hM0 x) (hpoint x) hp0.le)
    _ = k ^ p * ∫ x : Euclidean d, U x ^ p := by
      rw [show (fun x : Euclidean d => (k * U x) ^ p) =
          fun x => k ^ p * U x ^ p by
        funext x
        rw [Real.mul_rpow hk.le (hU0 x)]]
      rw [integral_const_mul]
    _ ≤ k ^ p * (C * I) := by
      apply mul_le_mul_of_nonneg_left hUmemMoment.2
        (Real.rpow_nonneg hk.le _)
    _ = (k ^ p * C) * ∫ x : Euclidean d,
        ‖(f : Euclidean d → Complex) x‖ ^ p := by
      dsimp only [I]
      ring

/-- The fixed Schwartz bandpass has a literal top endpoint.  Its constant
is the `L¹` norm of its physical kernel, enlarged by one only to keep the
later smooth-amplitude interpolation strictly positive. -/
theorem fractalDyadicBandpassMaximal_compact_top_endpoint
