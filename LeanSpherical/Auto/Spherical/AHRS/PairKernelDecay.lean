/-- For Schwartz data, each literal active radius piece has an integrable
`q`-power for every positive finite `q`.  This is not an extra restriction:
the compact Fourier multiplier sends a Schwartz input to a Schwartz output,
and the displayed equality identifies that output with the literal physical
`Q4` piece. -/
theorem integrable_norm_q4DyadicSurfacePiece_rpow_of_schwartz
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (r : Real) (f : SchwartzMap (Euclidean d) Complex)
    {q : Real} (hq : 0 < q) :
    Integrable (fun x : Euclidean d => ‖q4DyadicSurfacePiece psi f r x‖ ^ q) volume := by
  have hschwartz : MemLp
      (q4DyadicSurfaceSchwartzPiece psi hpsiCompact r f : Euclidean d -> Complex)
      (ENNReal.ofReal q) volume :=
    (q4DyadicSurfaceSchwartzPiece psi hpsiCompact r f).memLp (ENNReal.ofReal q) volume
  have hphysical : MemLp (fun x : Euclidean d => q4DyadicSurfacePiece psi f r x)
      (ENNReal.ofReal q) volume := by
    apply hschwartz.ae_eq
    filter_upwards with x
    exact q4DyadicSurfaceSchwartzPiece_apply_eq_q4DyadicSurfacePiece
      psi hpsiCompact r f x
  have hpower := hphysical.integrable_norm_rpow
    (ENNReal.ofReal_ne_zero_iff.mpr hq) ENNReal.ofReal_ne_top
  simpa only [ENNReal.toReal_ofReal hq.le] using hpower

/-- The norm of the measurable active endpoint is measurable on Schwartz
data.  We prove this through its finite-maximum realization, so no
measurability assertion about a non-canonical argmax is used. -/
theorem measurable_norm_q4MeasurableActiveDyadicEndpointPiece
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi f : SchwartzMap (Euclidean d) Complex) :
    Measurable (fun x : Euclidean d =>
      ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖) := by
  have hmax : Measurable
      (q4FiniteProductMaximal (activeDyadicIndices E j) hs
        (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x)) := by
    unfold q4FiniteProductMaximal
    have happly :
        ((activeDyadicIndices E j).sup' hs
          (fun i => fun x : Euclidean d =>
            ‖q4DyadicSurfacePiece psi f (dyadicLeft j i) x‖) :
          Euclidean d -> Real) =
        fun x => (activeDyadicIndices E j).sup' hs
          (fun i => ‖q4DyadicSurfacePiece psi f (dyadicLeft j i) x‖) := by
      funext x
      exact Finset.sup'_apply hs _ x
    rw [← happly]
    exact Finset.measurable_sup' hs (fun i _ =>
      (continuous_q4DyadicSurfacePiece psi f (dyadicLeft j i)).norm.measurable)
  have heq :
      (fun x : Euclidean d => ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖) =
        q4FiniteProductMaximal (activeDyadicIndices E j) hs
          (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x) := by
    funext x
    symm
    exact q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x
  rw [heq]
  exact hmax

/-- The finite active endpoint has an integrable `q`-power on Schwartz data.
It follows from the finite sum of the preceding individual Schwartz bounds.
-/
theorem integrable_norm_q4MeasurableActiveDyadicEndpointPiece_rpow_of_schwartz
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : SchwartzMap (Euclidean d) Complex)
    {q : Real} (hq : 0 < q) :
    Integrable (fun x : Euclidean d =>
      ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q) volume := by
  let pieces : Int -> Euclidean d -> Complex :=
    fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x
  have hfibre : ∀ i ∈ activeDyadicIndices E j,
      Integrable (fun x => ‖pieces i x‖ ^ q) volume := by
    intro i hi
    simpa only [pieces] using
      integrable_norm_q4DyadicSurfacePiece_rpow_of_schwartz
        psi hpsiCompact (dyadicLeft j i) f hq
  have hsum : Integrable (fun x => ∑ i ∈ activeDyadicIndices E j,
      ‖pieces i x‖ ^ q) volume :=
    integrable_finsetSum (activeDyadicIndices E j) hfibre
  have hmaxmeas : Measurable
      (q4FiniteProductMaximal (activeDyadicIndices E j) hs pieces) := by
    unfold q4FiniteProductMaximal
    have happly :
        ((activeDyadicIndices E j).sup' hs
          (fun i => fun x : Euclidean d => ‖pieces i x‖) : Euclidean d -> Real) =
        fun x => (activeDyadicIndices E j).sup' hs (fun i => ‖pieces i x‖) := by
      funext x
      exact Finset.sup'_apply hs _ x
    rw [← happly]
    exact Finset.measurable_sup' hs (fun i _ =>
      (continuous_q4DyadicSurfacePiece psi f (dyadicLeft j i)).norm.measurable)
  have hmaxint : Integrable
      (fun x => q4FiniteProductMaximal (activeDyadicIndices E j) hs pieces x ^ q) volume := by
    apply Integrable.mono' hsum
    · exact (((Real.continuous_rpow_const hq.le).measurable.comp
        hmaxmeas).aestronglyMeasurable)
    · filter_upwards with x
      rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg
        (q4FiniteProductMaximal_nonneg (activeDyadicIndices E j) hs pieces x) q)]
      exact q4FiniteProductMaximal_rpow_le_fibreSum
        (activeDyadicIndices E j) hs q pieces x
  refine hmaxint.congr ?_
  filter_upwards with x
  rw [q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x]

/-- The finite endpoint moment gives the actual finite `L^q` membership of
its real norm; this packages the purely measure-theoretic conversion needed
by the final Minkowski step. -/
theorem memLp_norm_q4MeasurableActiveDyadicEndpointPiece_of_schwartz
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : SchwartzMap (Euclidean d) Complex)
    {q : Real} (hq : 0 < q) :
    MemLp (fun x : Euclidean d =>
      ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖)
      (ENNReal.ofReal q) volume := by
  apply (integrable_norm_rpow_iff
    (measurable_norm_q4MeasurableActiveDyadicEndpointPiece E j hs psi f).aestronglyMeasurable
    (ENNReal.ofReal_ne_zero_iff.mpr hq) ENNReal.ofReal_ne_top).mp
  simpa only [ENNReal.toReal_ofReal hq.le, norm_norm] using
    (integrable_norm_q4MeasurableActiveDyadicEndpointPiece_rpow_of_schwartz
      E j hs psi hpsiCompact f hq)

/-- A real root-moment estimate converts directly to the corresponding
extended `L^q` seminorm estimate. -/
theorem eLpNorm_le_of_rpow_root_moment
    {X V : Type*} [MeasurableSpace X] [NormedAddCommGroup V]
    (mu : Measure X) (g : X -> V) {q B : Real} (hq : 0 < q)
    (hmem : MemLp g (ENNReal.ofReal q) mu)
    (hmoment : (∫ x, ‖g x‖ ^ q ∂mu) ^ (1 / q) <= B) :
    eLpNorm g (ENNReal.ofReal q) mu <= ENNReal.ofReal B := by
  rw [hmem.eLpNorm_eq_integral_rpow_norm
    (ENNReal.ofReal_ne_zero_iff.mpr hq) ENNReal.ofReal_ne_top,
    ENNReal.toReal_ofReal hq.le]
  apply ENNReal.ofReal_le_ofReal
  simpa only [one_div] using hmoment

/-- The true normalized derivative variation term left by the active-cell
sampling inequality. -/
def q4ActiveDyadicVariationTerm
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi f : SchwartzMap (Euclidean d) Complex) : Euclidean d -> Real :=
  fun x => ∫ u in (0 : Real)..dyadicScale j,
    activeDyadicDerivativeSup E j hs
      (fun t => q4NormalizedDyadicSurfaceRadiusDerivative psi f t x) u

/-- The active derivative variation term is pointwise nonnegative. -/
theorem q4ActiveDyadicVariationTerm_nonneg
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    0 <= q4ActiveDyadicVariationTerm E j hs psi f x := by
  unfold q4ActiveDyadicVariationTerm
  exact intervalIntegral.integral_nonneg (dyadicScale_pos j).le
    (fun u _ => activeDyadicDerivativeSup_nonneg E j hs _ u)

/-- The active-cell sampling inequality, in finite `eLpNorm` form.  The
endpoint root moment is the output of the literal full-product `TT*`
argument.  The sole new analytic input is the displayed `L^q` estimate for
the genuine normalized radius-derivative variation term. -/
theorem fractalDyadicBandpassMaximal_eLpNorm_le_of_endpointMoment
    {d : Nat} {E : Set Real} {j : Nat}
    (hd : 0 < d) (hE : E ⊆ Set.Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : SchwartzMap (Euclidean d) Complex)
    {q A : Real} {B : ENNReal} (hq : 1 < q)
    (hendpoint :
      (∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume) ^
        (1 / q) <= A)
    (hvariation :
      MemLp (q4ActiveDyadicVariationTerm E j hs psi f) (ENNReal.ofReal q) volume ∧
      eLpNorm (q4ActiveDyadicVariationTerm E j hs psi f)
        (ENNReal.ofReal q) volume <= B) :
    MemLp (fractalDyadicBandpassMaximal d E psi f) (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E psi f)
        (ENNReal.ofReal q) volume <=
        ENNReal.ofReal ‖(surfaceMass d : Complex)⁻¹‖ * ENNReal.ofReal A + B := by
  let endpoint : Euclidean d -> Real :=
    fun x => ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖
  let variation : Euclidean d -> Real := q4ActiveDyadicVariationTerm E j hs psi f
  let c : Real := ‖(surfaceMass d : Complex)⁻¹‖
  let majorant : Euclidean d -> Real := fun x => c * endpoint x + variation x
  have hq0 : 0 < q := lt_trans zero_lt_one hq
  have hqENN : (1 : ENNReal) <= ENNReal.ofReal q := by
    rw [← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hq.le
  have hendpoint_mem : MemLp endpoint (ENNReal.ofReal q) volume := by
    simpa only [endpoint] using
      (memLp_norm_q4MeasurableActiveDyadicEndpointPiece_of_schwartz
        E j hs psi hpsiCompact f hq0)
  have hendpoint_norm : eLpNorm endpoint (ENNReal.ofReal q) volume <= ENNReal.ofReal A := by
    apply eLpNorm_le_of_rpow_root_moment volume endpoint hq0 hendpoint_mem
    simpa only [endpoint, norm_norm] using hendpoint
  have hmajorant_mem : MemLp majorant (ENNReal.ofReal q) volume := by
    have hscaled : MemLp (fun x => c * endpoint x) (ENNReal.ofReal q) volume :=
      hendpoint_mem.const_mul c
    exact hscaled.add (by simpa only [variation] using hvariation.1)
  have hmajorant_nonneg (x : Euclidean d) : 0 <= majorant x := by
    dsimp [majorant, c, endpoint, variation]
    exact add_nonneg
      (mul_nonneg (norm_nonneg _) (norm_nonneg _))
      (by simpa only [variation] using
        q4ActiveDyadicVariationTerm_nonneg E j hs psi f x)
  have hpointwise (x : Euclidean d) :
      fractalDyadicBandpassMaximal d E psi f x <= majorant x := by
    dsimp only [majorant, c, endpoint, variation]
    simpa only [q4MeasurableActiveDyadicEndpointPiece, q4ActiveDyadicVariationTerm,
      normdSphericalAverageRadDeriv_dyBandpassProjection_eq_q4NormdDySurfaceRadDeriv]
      using (fractalDyadicBandpassMaximal_le_measurableActiveQ4Endpoint_add_variation
        hd hE hEne psi f x)
  have hmax_mem : MemLp (fractalDyadicBandpassMaximal d E psi f)
      (ENNReal.ofReal q) volume := by
    apply hmajorant_mem.mono
      (measurable_fractalDyadicBandpassMaximal E psi f).aestronglyMeasurable
    filter_upwards with x
    change ‖fractalDyadicBandpassMaximal d E psi f x‖ <= ‖majorant x‖
    rw [Real.norm_eq_abs,
      abs_of_nonneg (fractalDyadicBandpassMaximal_nonneg E psi f x),
      Real.norm_eq_abs, abs_of_nonneg (hmajorant_nonneg x)]
    exact hpointwise x
  refine ⟨hmax_mem, ?_⟩
  have hscaled_norm : eLpNorm (fun x => c * endpoint x) (ENNReal.ofReal q) volume <=
      ENNReal.ofReal c * ENNReal.ofReal A := by
    calc
      eLpNorm (fun x => c * endpoint x) (ENNReal.ofReal q) volume =
          ‖c‖ₑ * eLpNorm endpoint (ENNReal.ofReal q) volume := by
        change eLpNorm (c • endpoint) (ENNReal.ofReal q) volume = _
        rw [eLpNorm_const_smul]
      _ <= ‖c‖ₑ * ENNReal.ofReal A :=
        mul_le_mul_right hendpoint_norm _
      _ = ENNReal.ofReal c * ENNReal.ofReal A := by
        rw [Real.enorm_eq_ofReal (norm_nonneg _)]
  calc
    eLpNorm (fractalDyadicBandpassMaximal d E psi f) (ENNReal.ofReal q) volume <=
        eLpNorm majorant (ENNReal.ofReal q) volume := by
      apply eLpNorm_mono
      intro x
      change ‖fractalDyadicBandpassMaximal d E psi f x‖ <= ‖majorant x‖
      rw [Real.norm_eq_abs,
        abs_of_nonneg (fractalDyadicBandpassMaximal_nonneg E psi f x),
        Real.norm_eq_abs, abs_of_nonneg (hmajorant_nonneg x)]
      exact hpointwise x
    _ <= eLpNorm (fun x => c * endpoint x) (ENNReal.ofReal q) volume +
        eLpNorm variation (ENNReal.ofReal q) volume := by
      change eLpNorm ((fun x => c * endpoint x) + variation) (ENNReal.ofReal q) volume <= _
      exact eLpNorm_add_le (hendpoint_mem.const_mul c).1
        (by simpa only [variation] using hvariation.1.1) hqENN
    _ <= ENNReal.ofReal ‖(surfaceMass d : Complex)⁻¹‖ * ENNReal.ofReal A + B := by
      apply add_le_add hscaled_norm
      simpa only [variation] using hvariation.2

/-- A moment estimate for the finite active family is therefore a moment
estimate for the literal measurable endpoint appearing in the dyadic
sampling argument. -/
theorem q4MeasurableActiveDyadicEndpointPiece_moment_le_of_fibreLpMoment
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi f : SchwartzMap (Euclidean d) Complex)
    {q A : Real} (hq : 0 < q)
    (hmoment :
      (q4FibreLpMoment volume (activeDyadicIndices E j) q
        (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x)) ^ (1 / q) <= A)
    (hendpoint : Integrable
      (fun x => ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q) volume)
    (hfibre : ∀ i ∈ activeDyadicIndices E j,
      Integrable (fun x => ‖q4DyadicSurfacePiece psi f (dyadicLeft j i) x‖ ^ q) volume) :
    (∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume) ^
        (1 / q) <= A := by
  let pieces : Int -> Euclidean d -> Complex :=
    fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x
  have hmax : Integrable
      (fun x => q4FiniteProductMaximal (activeDyadicIndices E j) hs pieces x ^ q) volume := by
    refine hendpoint.congr ?_
    filter_upwards with x
    rw [q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x]
  have hmoment' :
      (∫ x, q4FiniteProductMaximal (activeDyadicIndices E j) hs pieces x ^ q ∂volume) ^
          (1 / q) <= A := by
    exact q4FiniteProductMaximal_moment_le_of_fibreLpMoment
      volume (activeDyadicIndices E j) hs q pieces hq (by simpa only [pieces] using hmoment)
      hmax (by simpa only [pieces] using hfibre)
  have hintegral :
      (∫ x, q4FiniteProductMaximal (activeDyadicIndices E j) hs pieces x ^ q ∂volume) =
        ∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume := by
    apply integral_congr_ae
    filter_upwards with x
    rw [q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x]
  rw [hintegral] at hmoment'
  exact hmoment'

/-- The concrete endpoint form of the full-product `TT*` step.  If the raw
analysis family is the literal active dyadic surface family on the input
under consideration, then an unrestricted physical product-kernel strong
estimate gives the `L^q` moment of the selected active endpoint.  The
physical/L2 theorem
`q4ActiveDyadicSchwartzPowerDualFullKernel_ae_eq_l2AnalysisSynthesis`
certifies the full-kernel premise on the canonical Schwartz power-dual
carrier; the remaining input here is precisely the paper's full-product
strong estimate and the derivative/variation estimate used after sampling. -/
theorem q4MeasurableActiveDyadicEndpointPiece_moment_le_of_fullKernelStrongMoment
    {d : Nat} (E : Set Real) (j : Nat)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi f : SchwartzMap (Euclidean d) Complex)
    (K : Int -> Int -> Euclidean d -> Complex)
    (T Tstar : Int -> (Euclidean d -> Complex) →ₗ[Complex]
      (Euclidean d -> Complex))
    {q qdual A F : Real} (carrier : Set (Int -> Euclidean d -> Complex))
    (hcomp : IsQ4FiniteProductPairComposition volume K T Tstar)
    (hadj : ∀ (v : Euclidean d -> Complex) (g : Int -> Euclidean d -> Complex),
      g ∈ carrier ->
      q4FiniteProductPairing volume (activeDyadicIndices E j) (fun i => T i v) g =
        ∫ x, v x * starRingEnd Complex
          (q4FiniteFibreSynthesis (activeDyadicIndices E j) Tstar g x) ∂volume)
    (hsynthesis_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      MemLp (q4FiniteFibreSynthesis (activeDyadicIndices E j) Tstar g) 2 volume)
    (hA : 0 <= A)
    (hinput_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      ∀ i ∈ activeDyadicIndices E j, MemLp (g i) (ENNReal.ofReal qdual) volume)
    (houtput_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      ∀ i ∈ activeDyadicIndices E j, MemLp
        (q4FiniteProductToFibres (activeDyadicIndices E j)
          (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True) K
            (q4FibresToFiniteProduct (activeDyadicIndices E j) g)) i)
        (ENNReal.ofReal q) volume)
    (hstrong : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      (q4FibreLpMoment volume (activeDyadicIndices E j) q
        (q4FiniteProductToFibres (activeDyadicIndices E j)
          (q4FiniteProductKernelShell volume (activeDyadicIndices E j) (fun _ _ => True) K
            (q4FibresToFiniteProduct (activeDyadicIndices E j) g)))) ^ (1 / q) <=
        A * A * (q4FibreLpMoment volume (activeDyadicIndices E j) qdual g) ^ (1 / qdual))
    (u : Euclidean d -> Complex) (hq : 1 < q) (hqdual : 0 < qdual)
    (hconj : 1 / q + 1 / qdual = 1) (hAF : 0 <= A * F)
    (hF : 0 <= F) (hu : MemLp u 2 volume)
    (hsource : √(∫ x, ‖u x‖ ^ 2 ∂volume) <= F)
    (hpower : q4PowerDualField q (fun i => T i u) ∈ carrier)
    (hpieces : ∀ i ∈ activeDyadicIndices E j,
      T i u = fun x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x)
    (hendpoint : Integrable
      (fun x => ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q) volume)
    (hfibre : ∀ i ∈ activeDyadicIndices E j,
      Integrable (fun x => ‖q4DyadicSurfacePiece psi f (dyadicLeft j i) x‖ ^ q) volume) :
    (∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume) ^
        (1 / q) <= A * F := by
  have hmax_eq :
      q4FiniteProductMaximal (activeDyadicIndices E j) hs (fun i => T i u) =
        q4FiniteProductMaximal (activeDyadicIndices E j) hs
          (fun i x => q4DyadicSurfacePiece psi f (dyadicLeft j i) x) := by
    funext x
    unfold q4FiniteProductMaximal
    refine Finset.sup'_congr hs rfl ?_
    intro i hi
    dsimp only
    rw [hpieces i hi]
  have hrawmoment :
      (∫ x, q4FiniteProductMaximal (activeDyadicIndices E j) hs (fun i => T i u) x ^ q
        ∂volume) ^ (1 / q) <= A * F := by
    apply q4FiniteProductMaximal_moment_le_of_fullKernelStrongMoment
      volume (activeDyadicIndices E j) hs K T Tstar carrier hcomp hadj hsynthesis_mem hA
      hinput_mem houtput_mem hstrong u hq hqdual hconj hAF hF hu hsource hpower
    · refine hendpoint.congr ?_
      filter_upwards with x
      rw [hmax_eq]
      rw [q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x]
    · intro i hi
      simpa only [hpieces i hi] using hfibre i hi
  have hintegral :
      (∫ x, q4FiniteProductMaximal (activeDyadicIndices E j) hs (fun i => T i u) x ^ q
        ∂volume) =
        ∫ x, ‖q4MeasurableActiveDyadicEndpointPiece E j hs psi f x‖ ^ q ∂volume := by
    apply integral_congr_ae
    filter_upwards with x
    rw [hmax_eq]
    rw [q4FiniteProductMaximal_activeDyadic_eq_norm_measurableEndpoint E j hs psi f x]
  rw [hintegral] at hrawmoment
  exact hrawmoment

/-- A concrete dyadic `L^q` estimate obtained from the literal unrestricted
finite product kernel.  The endpoint and individual-radius integrability
requirements of the abstract finite-product bridge are discharged here from
the Schwartz realization of the actual radius pieces.  Consequently the
only additional analytic datum after the full product strong estimate is the
stated bound for the true normalized derivative variation term. -/
theorem fractalDyadicBandpassMaximal_eLpNorm_le_of_fullKernelStrongMoment
    {d : Nat} {E : Set Real} {j : Nat}
    (hd : 0 < d) (hE : E ⊆ Set.Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hs : (activeDyadicIndices E j).Nonempty)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (f : SchwartzMap (Euclidean d) Complex)
    (K : Int -> Int -> Euclidean d -> Complex)
    (T Tstar : Int -> (Euclidean d -> Complex) →ₗ[Complex]
      (Euclidean d -> Complex))
    {q qdual A F : Real} {B : ENNReal} (carrier : Set (Int -> Euclidean d -> Complex))
    (hcomp : IsQ4FiniteProductPairComposition volume K T Tstar)
    (hadj : ∀ (v : Euclidean d -> Complex) (g : Int -> Euclidean d -> Complex),
      g ∈ carrier ->
      q4FiniteProductPairing volume (activeDyadicIndices E j) (fun i => T i v) g =
        ∫ x, v x * starRingEnd Complex
          (q4FiniteFibreSynthesis (activeDyadicIndices E j) Tstar g x) ∂volume)
    (hsynthesis_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      MemLp (q4FiniteFibreSynthesis (activeDyadicIndices E j) Tstar g) 2 volume)
    (hA : 0 <= A)
    (hinput_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
      ∀ i ∈ activeDyadicIndices E j, MemLp (g i) (ENNReal.ofReal qdual) volume)
    (houtput_mem : ∀ g : Int -> Euclidean d -> Complex, g ∈ carrier ->
