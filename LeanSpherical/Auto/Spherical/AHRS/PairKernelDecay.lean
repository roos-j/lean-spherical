      (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
  have hs0 : 0 ≤ s := zero_le_one.trans hs
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hspos hlambda
  have hnum : C * |a| ^ k ≤ C * (L * s) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  have hden : s ^ (d + k) ≤ lambda ^ (d + k) :=
    pow_le_pow_left₀ hs0 hlambda _
  have hsdenpos : 0 < s ^ (d + k) := pow_pos hspos _
  have hlambdadenpos : 0 < lambda ^ (d + k) := pow_pos hlambdapos _
  have hquot : C * |a| ^ k / lambda ^ (d + k) ≤
      C * (L * s) ^ k / s ^ (d + k) := by
    calc
      C * |a| ^ k / lambda ^ (d + k) ≤
          C * (L * s) ^ k / lambda ^ (d + k) :=
        div_le_div_of_nonneg_right hnum hlambdadenpos.le
      _ ≤ C * (L * s) ^ k / s ^ (d + k) :=
        div_le_div_of_nonneg_left (mul_nonneg hC (pow_nonneg (mul_nonneg hL hs0) _))
          hsdenpos hden
  have hsqrts : Real.sqrt s ≤ s := (Real.sqrt_le_self_iff).2 (Or.inr hs)
  have hrootpow : (Real.sqrt s) ^ (d - 1) ≤ s ^ (d - 1) :=
    pow_le_pow_left₀ (Real.sqrt_nonneg _) hsqrts _
  have hsd : s ^ (d - 1) ≤ s ^ d := by
    calc
      s ^ (d - 1) = s ^ (d - 1) * 1 := by ring
      _ ≤ s ^ (d - 1) * s := by
        exact mul_le_mul_of_nonneg_left hs (pow_nonneg hs0 _)
      _ = s ^ d := by
        rw [← pow_succ]
        congr 1
        omega
  have hrootden : (Real.sqrt s) ^ (d - 1) ≤ s ^ d := hrootpow.trans hsd
  have hrootpos : 0 < (Real.sqrt s) ^ (d - 1) :=
    pow_pos (Real.sqrt_pos.2 hspos) _
  calc
    C * |a| ^ k / lambda ^ (d + k) ≤ C * (L * s) ^ k / s ^ (d + k) := hquot
    _ = (C * L ^ k) / s ^ d := by
      rw [mul_pow, show d + k = k + d by omega, pow_add]
      field_simp [hspos.ne']
    _ ≤ (C * L ^ k) / (Real.sqrt s) ^ (d - 1) := by
      apply div_le_div_of_nonneg_left
      · exact mul_nonneg hC (pow_nonneg hL _)
      · exact hrootpos
      · exact hrootden

/-- A multiplier-side outgoing endpoint wave has the expected normalized
stationary size after every finite radial derivative. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_scaled
    {d k : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .outgoing (s * r) t) u‖ ≤
        C / (Real.sqrt s) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_decay d k
  refine ⟨C * (5 * Real.pi) ^ k, mul_pos hC (pow_pos (by positivity) _), ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  have hfreqpos : 0 < |(2 * Real.pi * (s * r)) * u| :=
    lt_of_lt_of_le zero_lt_one hfreq
  calc
    ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .outgoing (s * r) t) u‖ ≤
        C * |2 * Real.pi * (s * r)| ^ k /
          quadraticMomentScale (d - 2 + 2 * k)
            |(2 * Real.pi * (s * r)) * u| :=
      hbound (s * r) u hfreq
    _ ≤ (C * (5 * Real.pi) ^ k) / (Real.sqrt s) ^ (d - 1) :=
      endpoint_stationary_denominator_le_dyadic_scale hd hs hC.le (by positivity)
        hamp hfreqpos hsqrt

/-- The reflected multiplier-side endpoint satisfies the same normalized
stationary derivative estimate. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_scaled
    {d k : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .incoming (s * r) t) u‖ ≤
        C / (Real.sqrt s) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_decay d k
  refine ⟨C * (5 * Real.pi) ^ k, mul_pos hC (pow_pos (by positivity) _), ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  have hfreqpos : 0 < |(2 * Real.pi * (s * r)) * u| :=
    lt_of_lt_of_le zero_lt_one hfreq
  have hsign : |(-(2 * Real.pi * (s * r)) * u)| =
      |(2 * Real.pi * (s * r)) * u| := by
    rw [show (-(2 * Real.pi * (s * r)) * u) =
      -((2 * Real.pi * (s * r)) * u) by ring, abs_neg]
  have hsignAmp : |-(2 * Real.pi * (s * r))| = |2 * Real.pi * (s * r)| := by
    rw [abs_neg]
  calc
    ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .incoming (s * r) t) u‖ ≤
        C * |-(2 * Real.pi * (s * r))| ^ k /
          quadraticMomentScale (d - 2 + 2 * k)
            |(-(2 * Real.pi * (s * r)) * u)| :=
      hbound (s * r) u (by simpa [hsign] using hfreq)
    _ = C * |2 * Real.pi * (s * r)| ^ k /
          quadraticMomentScale (d - 2 + 2 * k)
            |(2 * Real.pi * (s * r)) * u| := by rw [hsignAmp, hsign]
    _ ≤ (C * (5 * Real.pi) ^ k) / (Real.sqrt s) ^ (d - 1) :=
      endpoint_stationary_denominator_le_dyadic_scale hd hs hC.le (by positivity)
        hamp hfreqpos hsqrt

/-- A multiplier-side middle meridian wave has arbitrarily rapid decay, and
therefore in particular the same dyadic stationary scale as an endpoint
wave. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_scaled
    {d k : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .middle (s * r) t) u‖ ≤
        C / (Real.sqrt s) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_decay d k (d + k)
  refine ⟨C * (5 * Real.pi) ^ k, mul_pos hC (pow_pos (by positivity) _), ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  calc
    ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .middle (s * r) t) u‖ ≤
        C * |2 * Real.pi * (s * r)| ^ k /
          |(2 * Real.pi * (s * r)) * u| ^ (d + k) :=
      hbound (s * r) u hfreq
    _ ≤ (C * (5 * Real.pi) ^ k) / (Real.sqrt s) ^ (d - 1) :=
      rapid_middle_denominator_le_dyadic_scale hd hs hC.le (by positivity)
        hamp hscale

/-- Uniform finite-order multiplier-side coordinate-wave bounds on the
fixed annulus.  Exported for the literal radius-differentiated normal form. -/
theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_scaled
    {d k : Nat} (hd : 2 ≤ d) (part : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d part (s * r) t) u‖ ≤
        C / (Real.sqrt s) ^ (d - 1) := by
  cases part with
  | outgoing =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_scaled hd
  | incoming =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_scaled hd
  | middle =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_scaled hd

/-- On the fixed annulus, an endpoint stationary symbol and each of its
radial derivatives are uniformly bounded when its physical frequency is
allowed to vary. -/
theorem endpoint_stationary_denominator_le_uniform
    {d k : Nat} {a lambda C : Real}
    (hd : 2 ≤ d) (hC : 0 ≤ C) (hlambda : 1 ≤ lambda)
    (ha : |a| ≤ 2 * lambda) :
    C * |a| ^ k / quadraticMomentScale (d - 2 + 2 * k) lambda ≤
      C * 2 ^ k := by
  have hlambda0 : 0 ≤ lambda := zero_le_one.trans hlambda
  have hlambdapos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hsqrtone : 1 ≤ Real.sqrt lambda := by
    simpa using Real.sqrt_le_sqrt hlambda
  have hfactor : 1 ≤ (Real.sqrt lambda) ^ (d - 1) := one_le_pow₀ hsqrtone
  have hdenrewrite : quadraticMomentScale (d - 2 + 2 * k) lambda =
      (Real.sqrt lambda) ^ (d - 1) * lambda ^ k := by
    unfold quadraticMomentScale
    rw [show d - 2 + 2 * k + 1 = d - 1 + 2 * k by omega,
      sqrt_pow_stationary_split hlambda0 d k]
  have hden : lambda ^ k ≤ quadraticMomentScale (d - 2 + 2 * k) lambda := by
    rw [hdenrewrite]
    calc
      lambda ^ k = 1 * lambda ^ k := by ring
      _ ≤ (Real.sqrt lambda) ^ (d - 1) * lambda ^ k :=
        mul_le_mul_of_nonneg_right hfactor (pow_nonneg hlambda0 _)
  have hdenpos : 0 < quadraticMomentScale (d - 2 + 2 * k) lambda := by
    rw [hdenrewrite]
    positivity
  have hsmallpos : 0 < lambda ^ k := pow_pos hlambdapos _
  have hnum : C * |a| ^ k ≤ C * (2 * lambda) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  calc
    C * |a| ^ k / quadraticMomentScale (d - 2 + 2 * k) lambda ≤
        C * (2 * lambda) ^ k / quadraticMomentScale (d - 2 + 2 * k) lambda :=
      div_le_div_of_nonneg_right hnum hdenpos.le
    _ ≤ C * (2 * lambda) ^ k / lambda ^ k :=
      div_le_div_of_nonneg_left (mul_nonneg hC (pow_nonneg (by linarith) _))
        hsmallpos hden
    _ = C * 2 ^ k := by
      rw [mul_pow]
      field_simp [hlambdapos.ne']

/-- The rapid middle meridian estimate has the same elementary uniform
consequence on the fixed annulus. -/
theorem rapid_middle_denominator_le_uniform
    {k : Nat} {a lambda C : Real}
    (hC : 0 ≤ C) (hlambda : 1 ≤ lambda)
    (ha : |a| ≤ 2 * lambda) :
    C * |a| ^ k / lambda ^ k ≤ C * 2 ^ k := by
  have hlambdapos : 0 < lambda := lt_of_lt_of_le zero_lt_one hlambda
  have hdenpos : 0 < lambda ^ k := pow_pos hlambdapos _
  have hnum : C * |a| ^ k ≤ C * (2 * lambda) ^ k := by
    apply mul_le_mul_of_nonneg_left
    · exact pow_le_pow_left₀ (abs_nonneg _) ha _
    · exact hC
  calc
    C * |a| ^ k / lambda ^ k ≤ C * (2 * lambda) ^ k / lambda ^ k :=
      div_le_div_of_nonneg_right hnum hdenpos.le
    _ = C * 2 ^ k := by
      rw [mul_pow]
      field_simp [hlambdapos.ne']

/-- The frequency of a physical coordinate wave is either below one, in
which case its chain-rule factor is bounded by two, or above one, in which
case stationary decay supplies the same bound. -/
theorem physical_coordinate_frequency_le_two_of_small
    {a u : Real} (_ha : 0 ≤ a) (hu : u ∈ Icc (1 / 2 : Real) 8)
    (hsmall : |(2 * Real.pi * a) * u| < 1) :
    |2 * Real.pi * a| ≤ 2 := by
  have hu0 : 0 < u := lt_of_lt_of_le (by norm_num) hu.1
  have hamp0 : 0 ≤ |2 * Real.pi * a| := abs_nonneg _
  have hprod : |2 * Real.pi * a| * u < 1 := by
    rw [← abs_of_pos hu0, ← abs_mul]
    exact hsmall
  have htwou : 1 ≤ 2 * u := by linarith [hu.1]
  have hlt : |2 * Real.pi * a| * u < 2 * u := lt_of_lt_of_le hprod htwou
  exact le_of_lt (lt_of_mul_lt_mul_right hlt hu0.le)

/-- On the fixed positive annulus, the unscaled coordinate frequency is at
most twice the full radial frequency. -/
theorem physical_coordinate_frequency_le_two_mul_frequency
    {a u : Real} (hu : u ∈ Icc (1 / 2 : Real) 8) :
    |2 * Real.pi * a| ≤ 2 * |(2 * Real.pi * a) * u| := by
  have hu0 : 0 < u := lt_of_lt_of_le (by norm_num) hu.1
  have htwou : 1 ≤ 2 * u := by linarith [hu.1]
  have heq : |(2 * Real.pi * a) * u| = |2 * Real.pi * a| * u := by
    rw [abs_mul, abs_of_pos hu0]
  calc
    |2 * Real.pi * a| = |2 * Real.pi * a| * 1 := by ring
    _ ≤ |2 * Real.pi * a| * (2 * u) := by
      exact mul_le_mul_of_nonneg_left htwou (abs_nonneg _)
    _ = 2 * (|2 * Real.pi * a| * u) := by ring
    _ = 2 * |(2 * Real.pi * a) * u| := by rw [heq]

/-- Uniform derivative bound for an outgoing physical coordinate wave. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_physical
    {d k : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 0 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .outgoing a t) u‖ ≤ C := by
  obtain ⟨Clow, hClow, hlow⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_le d k
  obtain ⟨Chigh, hChigh, hhigh⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_decay d k
  refine ⟨(Clow + Chigh) * 2 ^ k, mul_pos (add_pos hClow hChigh)
    (pow_pos (by norm_num) _), ?_⟩
  intro a u ha hu
  by_cases hlarge : 1 ≤ |(2 * Real.pi * a) * u|
  · calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .outgoing a t) u‖ ≤
          Chigh * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (d - 2 + 2 * k)
              |(2 * Real.pi * a) * u| := hhigh a u hlarge
      _ ≤ Chigh * 2 ^ k :=
        endpoint_stationary_denominator_le_uniform hd hChigh.le hlarge
          (physical_coordinate_frequency_le_two_mul_frequency hu)
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith
  · have hsmall : |(2 * Real.pi * a) * u| < 1 := lt_of_not_ge hlarge
    calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .outgoing a t) u‖ ≤
          Clow * |2 * Real.pi * a| ^ k := hlow a u
      _ ≤ Clow * 2 ^ k := by
        gcongr
        exact physical_coordinate_frequency_le_two_of_small ha hu hsmall
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith

/-- Uniform derivative bound for an incoming physical coordinate wave. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_physical
    {d k : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 0 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .incoming a t) u‖ ≤ C := by
  obtain ⟨Clow, hClow, hlow⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_le d k
  obtain ⟨Chigh, hChigh, hhigh⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_decay d k
  refine ⟨(Clow + Chigh) * 2 ^ k, mul_pos (add_pos hClow hChigh)
    (pow_pos (by norm_num) _), ?_⟩
  intro a u ha hu
  by_cases hlarge : 1 ≤ |(2 * Real.pi * a) * u|
  · have hsign : |(-(2 * Real.pi * a)) * u| = |(2 * Real.pi * a) * u| := by
      rw [show (-(2 * Real.pi * a)) * u = -((2 * Real.pi * a) * u) by ring,
        abs_neg]
    have hsignAmp : |-(2 * Real.pi * a)| = |2 * Real.pi * a| := by rw [abs_neg]
    calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .incoming a t) u‖ ≤
          Chigh * |-(2 * Real.pi * a)| ^ k /
            quadraticMomentScale (d - 2 + 2 * k)
              |(-(2 * Real.pi * a) * u)| :=
        hhigh a u (by simpa [hsign] using hlarge)
      _ = Chigh * |2 * Real.pi * a| ^ k /
            quadraticMomentScale (d - 2 + 2 * k)
              |(2 * Real.pi * a) * u| := by rw [hsignAmp, hsign]
      _ ≤ Chigh * 2 ^ k :=
        endpoint_stationary_denominator_le_uniform hd hChigh.le hlarge
          (physical_coordinate_frequency_le_two_mul_frequency hu)
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith
  · have hsmall : |(2 * Real.pi * a) * u| < 1 := lt_of_not_ge hlarge
    calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .incoming a t) u‖ ≤
          Clow * |2 * Real.pi * a| ^ k := hlow a u
      _ ≤ Clow * 2 ^ k := by
        gcongr
        exact physical_coordinate_frequency_le_two_of_small ha hu hsmall
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith

/-- Uniform derivative bound for a middle physical coordinate wave. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_physical
    {d k : Nat} (_hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 0 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d .middle a t) u‖ ≤ C := by
  obtain ⟨Clow, hClow, hlow⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_le d k
  obtain ⟨Chigh, hChigh, hhigh⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_decay d k k
  refine ⟨(Clow + Chigh) * 2 ^ k, mul_pos (add_pos hClow hChigh)
    (pow_pos (by norm_num) _), ?_⟩
  intro a u ha hu
  by_cases hlarge : 1 ≤ |(2 * Real.pi * a) * u|
  · calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .middle a t) u‖ ≤
          Chigh * |2 * Real.pi * a| ^ k /
            |(2 * Real.pi * a) * u| ^ k := hhigh a u hlarge
      _ ≤ Chigh * 2 ^ k :=
        rapid_middle_denominator_le_uniform hChigh.le hlarge
          (physical_coordinate_frequency_le_two_mul_frequency hu)
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith
  · have hsmall : |(2 * Real.pi * a) * u| < 1 := lt_of_not_ge hlarge
    calc
      ‖iteratedDeriv k (fun t : Real =>
          coordinateWaveRadialAmplitude d .middle a t) u‖ ≤
          Clow * |2 * Real.pi * a| ^ k := hlow a u
      _ ≤ Clow * 2 ^ k := by
        gcongr
        exact physical_coordinate_frequency_le_two_of_small ha hu hsmall
      _ ≤ (Clow + Chigh) * 2 ^ k := by
        gcongr
        linarith

/-- Case-free uniform physical coordinate-wave derivative bound. -/
private theorem exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_physical
    {d k : Nat} (hd : 2 ≤ d) (part : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 0 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d part a t) u‖ ≤ C := by
  cases part with
  | outgoing =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_physical hd
  | incoming =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_physical hd
  | middle =>
      exact exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_physical hd

/-- A single constant controls all multiplier-side coordinate-wave
derivatives needed for a fixed finite integration-by-parts order. -/
theorem exists_uniform_coordinateWaveRadialAmplitude_scaled
    {d N : Nat} (hd : 2 ≤ d) (part : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d part (s * r) t) u‖ ≤
        C / (Real.sqrt s) ^ (d - 1) := by
  choose C hCpos hCbound using fun k : Nat =>
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_scaled hd (k := k) part
  let C' : Real := ∑ k ∈ Finset.range (N + 1), C k
  have hC' : 0 < C' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : C 0 ≤ C' := by
      dsimp [C']
      exact Finset.single_le_sum (fun k hk => (hCpos k).le) hzero
    exact lt_of_lt_of_le (hCpos 0) hle
  refine ⟨C', hC', ?_⟩
  intro k hk s r u hs hr hu
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : C k ≤ C' := by
    dsimp [C']
    exact Finset.single_le_sum (fun l hl => (hCpos l).le) hkmem
  have hdenpos : 0 < (Real.sqrt s) ^ (d - 1) := by
    apply pow_pos
    exact Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hs)
  exact (hCbound k s r u hs hr hu).trans
    (div_le_div_of_nonneg_right hle hdenpos.le)

/-- A single constant controls all physical coordinate-wave derivatives
needed for a fixed finite integration-by-parts order. -/
private theorem exists_uniform_coordinateWaveRadialAmplitude_physical
    {d N : Nat} (hd : 2 ≤ d) (part : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ a u : Real, 0 ≤ a →
      u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k (fun t : Real =>
        coordinateWaveRadialAmplitude d part a t) u‖ ≤ C := by
  choose C hCpos hCbound using fun k : Nat =>
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_physical hd (k := k) part
  let C' : Real := ∑ k ∈ Finset.range (N + 1), C k
  have hC' : 0 < C' := by
    have hzero : 0 ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    have hle : C 0 ≤ C' := by
      dsimp [C']
      exact Finset.single_le_sum (fun k hk => (hCpos k).le) hzero
    exact lt_of_lt_of_le (hCpos 0) hle
  refine ⟨C', hC', ?_⟩
  intro k hk a u ha hu
  have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
  have hle : C k ≤ C' := by
    dsimp [C']
    exact Finset.single_le_sum (fun l hl => (hCpos l).le) hkmem
  exact (hCbound k a u ha hu).trans hle

/-- The two multiplier-side coordinate waves, before inserting the literal
radial cutoff.  The adjoint is kept visibly as complex conjugation. -/
private def coordinateWaveMultiplierPairAmplitude
    (d : Nat) (q t : CoordinateWavePart) (R R' : Real) (u : Real) : Complex :=
  coordinateWaveRadialAmplitude d q R u *
    starRingEnd Complex (coordinateWaveRadialAmplitude d t R' u)

/-- The product of the two literal level-zero dyadic cutoff factors along a
unit ray. -/
def normalizedDyadicCutoffSquare
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (v : Euclidean d) (u : Real) : Complex :=
  normalizedDyadicRadialBandpass phi v u *
    starRingEnd Complex (normalizedDyadicRadialBandpass phi v u)

private theorem contDiff_coordinateWaveMultiplierPairAmplitude
    (d : Nat) (q t : CoordinateWavePart) (R R' : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (coordinateWaveMultiplierPairAmplitude d q t R R') := by
  unfold coordinateWaveMultiplierPairAmplitude
  apply (contDiff_coordinateWaveRadialAmplitude d q R).mul
  have hbase := contDiff_coordinateWaveRadialAmplitude d t R'
  have heq : (fun u : Real =>
      starRingEnd Complex (coordinateWaveRadialAmplitude d t R' u)) =
      (Complex.conjCLE : Complex → Complex) ∘
        (fun u : Real => coordinateWaveRadialAmplitude d t R' u) := by
    funext u
    simpa only [Function.comp_apply] using
      (Complex.conjCLE_apply (coordinateWaveRadialAmplitude d t R' u)).symm
  rw [heq]
  exact Complex.conjCLE.contDiff.comp hbase

theorem contDiff_normalizedDyadicCutoffSquare
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (v : Euclidean d) :
    ContDiff Real (⊤ : ℕ∞) (normalizedDyadicCutoffSquare phi v) := by
  unfold normalizedDyadicCutoffSquare
  apply (contDiff_normalizedDyadicRadialBandpass phi v).mul
  have hbase := contDiff_normalizedDyadicRadialBandpass phi v
  have heq : (fun u : Real =>
      starRingEnd Complex (normalizedDyadicRadialBandpass phi v u)) =
      (Complex.conjCLE : Complex → Complex) ∘ normalizedDyadicRadialBandpass phi v := by
    funext u
    simpa only [Function.comp_apply] using
      (Complex.conjCLE_apply (normalizedDyadicRadialBandpass phi v u)).symm
  rw [heq]
  exact Complex.conjCLE.contDiff.comp hbase

/-- Radiality makes the normalized literal cutoff independent of the chosen
unit ray. -/
theorem normalizedDyadicRadialBandpass_eq_of_unit
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (v w : Euclidean d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    normalizedDyadicRadialBandpass phi v = normalizedDyadicRadialBandpass phi w := by
  funext u
  have hvzero := absoluteDyadicBandpass_smul_dyadicScale_eq_normalizedDyadicRadialBandpass
    phi hphiOne hphiZero 0 v u
  have hwzero := absoluteDyadicBandpass_smul_dyadicScale_eq_normalizedDyadicRadialBandpass
    phi hphiOne hphiZero 0 w u
  norm_num at hvzero hwzero
  rw [← hvzero, ← hwzero]
  apply isNormRadial_absoluteDyadicBandpass phi hphiOne hphiZero hphiRadial 0
  rw [norm_smul, norm_smul, Real.norm_eq_abs, hv, hw]

/-- The squared normalized cutoff inherits the same unit-ray invariance. -/
theorem normalizedDyadicCutoffSquare_eq_of_unit
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (v w : Euclidean d) (hv : ‖v‖ = 1) (hw : ‖w‖ = 1) :
    normalizedDyadicCutoffSquare phi v = normalizedDyadicCutoffSquare phi w := by
  have h := normalizedDyadicRadialBandpass_eq_of_unit
    phi hphiOne hphiZero hphiRadial v w hv hw
  unfold normalizedDyadicCutoffSquare
  rw [h]

/-- Uniform compact-annulus derivative bounds for the literal normalized
cutoff, independent of the unit ray because the original low-pass is radial. -/
theorem exists_uniform_normalizedDyadicCutoffSquare_bound_on_unit
    {d N : Nat} (hd : 1 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi) :
    ∃ C : Real, 0 < C ∧ ∀ v : Euclidean d, ‖v‖ = 1 →
      ∀ k : Nat, k ≤ N → ∀ u ∈ Icc (1 / 2 : Real) 8,
        ‖iteratedDeriv k (normalizedDyadicCutoffSquare phi v) u‖ ≤ C := by
  let i : Fin d := ⟨0, by omega⟩
  let v0 : Euclidean d := EuclideanSpace.single i (1 : Real)
  have hv0 : ‖v0‖ = 1 := by
    dsimp [v0]
    simp
  obtain ⟨C, hC, hbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus
      (normalizedDyadicCutoffSquare phi v0)
      (contDiff_normalizedDyadicCutoffSquare phi v0) N
  refine ⟨C, hC, ?_⟩
  intro v hv k hk u hu
  have heq : normalizedDyadicCutoffSquare phi v = normalizedDyadicCutoffSquare phi v0 :=
    normalizedDyadicCutoffSquare_eq_of_unit
      phi hphiOne hphiZero hphiRadial v v0 hv hv0
  rw [heq]
  exact hbound k hk u hu

/-- The product of the two stationary square-root denominators is the
integer dyadic power.  Exported for differentiated multiplier pairs. -/
theorem sq_sqrt_stationary_scale
    {s : Real} (hs : 0 ≤ s) (d : Nat) :
    ((Real.sqrt s) ^ (d - 1)) ^ 2 = s ^ (d - 1) := by
  rw [← pow_mul, show (d - 1) * 2 = 2 * (d - 1) by ring, pow_mul,
    Real.sq_sqrt hs]

/-- Algebraic factoring of the finite Leibniz constant through a common
positive denominator. -/
theorem tripleWaveLeibnizConstant_div_div
    (n : Nat) (A B q : Real) (hq : q ≠ 0) :
    tripleWaveLeibnizConstant n (A / q) (B / q) =
      tripleWaveLeibnizConstant n A B / q ^ 2 := by
  unfold tripleWaveLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq]

/-- Uniform all-order bound for the literal pair of multiplier-side
coordinate waves.  It is the source of the crucial `s^(-(d-1))` factor. -/
private theorem exists_uniform_coordinateWaveMultiplierPairAmplitude_scaled
    {d N : Nat} (hd : 2 ≤ d) (q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N → ∀ s r r' u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖iteratedDeriv k
        (coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r')) u‖ ≤
        C / s ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_coordinateWaveRadialAmplitude_scaled (N := N) hd q
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_coordinateWaveRadialAmplitude_scaled (N := N) hd t
  let C : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk s r r' u hs hr hr' hu
  let Q : Real := (Real.sqrt s) ^ (d - 1)
  have hQpos : 0 < Q := by
    dsimp [Q]
    apply pow_pos
    exact Real.sqrt_pos.2 (lt_of_lt_of_le zero_lt_one hs)
  have hqbound : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (fun z : Real =>
        coordinateWaveRadialAmplitude d q (s * r) z) u‖ ≤ A / Q := by
    intro i hi
    dsimp [Q]
    exact hAbound i (hi.trans hk) s r u hs hr hu
  have htbound : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (fun z : Real =>
        starRingEnd Complex (coordinateWaveRadialAmplitude d t (s * r') z)) u‖ ≤ B / Q := by
    intro i hi
    rw [norm_iteratedDeriv_starRingEnd
      (fun z : Real => coordinateWaveRadialAmplitude d t (s * r') z)
      (contDiff_coordinateWaveRadialAmplitude d t (s * r')) i u]
    dsimp [Q]
    exact hBbound i (hi.trans hk) s r' u hs hr' hu
  have hproduct := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
    (n := k)
    (contDiff_coordinateWaveRadialAmplitude d q (s * r))
    (by
      have hbase := contDiff_coordinateWaveRadialAmplitude d t (s * r')
      have heq : (fun z : Real =>
          starRingEnd Complex (coordinateWaveRadialAmplitude d t (s * r') z)) =
          (Complex.conjCLE : Complex → Complex) ∘
            (fun z : Real => coordinateWaveRadialAmplitude d t (s * r') z) := by
        funext z
        simpa only [Function.comp_apply] using
          (Complex.conjCLE_apply (coordinateWaveRadialAmplitude d t (s * r') z)).symm
      rw [heq]
      exact Complex.conjCLE.contDiff.comp hbase)
    (div_nonneg hA.le hQpos.le) (div_nonneg hB.le hQpos.le)
    hqbound htbound
  unfold coordinateWaveMultiplierPairAmplitude
  change ‖iteratedDeriv k
      (fun z : Real => coordinateWaveRadialAmplitude d q (s * r) z *
        starRingEnd Complex (coordinateWaveRadialAmplitude d t (s * r') z)) u‖ ≤ _
  calc
    ‖iteratedDeriv k
        (fun z : Real => coordinateWaveRadialAmplitude d q (s * r) z *
          starRingEnd Complex (coordinateWaveRadialAmplitude d t (s * r') z)) u‖ ≤
        tripleWaveLeibnizConstant k (A / Q) (B / Q) := hproduct
    _ = tripleWaveLeibnizConstant k A B / Q ^ 2 :=
      tripleWaveLeibnizConstant_div_div k A B Q hQpos.ne'
    _ ≤ C / Q ^ 2 := by
      apply div_le_div_of_nonneg_right
      · unfold C
        have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
        exact Finset.single_le_sum
          (fun l hl => tripleWaveLeibnizConstant_nonneg l hA.le hB.le) hkmem
      · positivity
    _ ≤ (C + 1) / s ^ (d - 1) := by
      dsimp [Q]
      rw [sq_sqrt_stationary_scale (zero_le_one.trans hs) d]
      apply div_le_div_of_nonneg_right
      · linarith
      · positivity

/-- The physical/cutoff factor common to the ordinary and
radius-differentiated all-dimensional triple coefficients. -/
def coordinateTripleWaveFixedAmplitude
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (v x : Euclidean d) (p : CoordinateWavePart) (u : Real) : Complex :=
  ((u ^ (d - 1) : Real) : Complex) *
    coordinateWaveRadialAmplitude d p ‖x‖ u *
      normalizedDyadicCutoffSquare phi v u

/-- Smoothness of the common physical/cutoff triple factor. -/
theorem contDiff_coordinateTripleWaveFixedAmplitude
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (v x : Euclidean d) (p : CoordinateWavePart) :
    ContDiff Real (⊤ : ℕ∞)
      (coordinateTripleWaveFixedAmplitude phi v x p) := by
  unfold coordinateTripleWaveFixedAmplitude
  exact (((contDiff_ofReal_pow (d - 1)).mul
        (contDiff_coordinateWaveRadialAmplitude d p ‖x‖)).mul
      (contDiff_normalizedDyadicCutoffSquare phi v))

/-- Uniform compact-annulus derivative bounds for the common physical/cutoff
triple factor. -/
theorem exists_uniform_coordinateTripleWaveFixedAmplitude_bound
    {d N : Nat} (hd : 2 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ v x : Euclidean d, ‖v‖ = 1 →
      ∀ k : Nat, k ≤ N → ∀ u ∈ Icc (1 / 2 : Real) 8,
        ‖iteratedDeriv k (coordinateTripleWaveFixedAmplitude phi v x p) u‖ ≤ C := by
  let i : Fin d := ⟨0, by omega⟩
  let v0 : Euclidean d := EuclideanSpace.single i (1 : Real)
  have hv0 : ‖v0‖ = 1 := by
    dsimp [v0]
    simp
  let density : Real → Complex := fun u : Real => ((u ^ (d - 1) : Real) : Complex)
  let cutoff0 : Real → Complex := normalizedDyadicCutoffSquare phi v0
  have hdensity : ContDiff Real (⊤ : ℕ∞) density := by
    dsimp only [density]
    exact contDiff_ofReal_pow (d - 1)
  have hcutoff0 : ContDiff Real (⊤ : ℕ∞) cutoff0 := by
    dsimp [cutoff0]
    exact contDiff_normalizedDyadicCutoffSquare phi v0
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus density hdensity N
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_coordinateWaveRadialAmplitude_physical (N := N) hd p
  obtain ⟨D, hD, hDbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus cutoff0 hcutoff0 N
  let E : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l A B
  have hEnonneg : 0 ≤ E := by
    dsimp [E]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hA.le hB.le
  let F : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l E D
  have hFnonneg : 0 ≤ F := by
    dsimp [F]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hEnonneg hD.le
  refine ⟨F + 1, by linarith, ?_⟩
  intro v x hv k hk u hu
  let physical : Real → Complex := fun z : Real =>
    coordinateWaveRadialAmplitude d p ‖x‖ z
  let cutoff : Real → Complex := normalizedDyadicCutoffSquare phi v
  have hphysical : ContDiff Real (⊤ : ℕ∞) physical := by
    dsimp [physical]
    exact contDiff_coordinateWaveRadialAmplitude d p ‖x‖
  have hcutoff : ContDiff Real (⊤ : ℕ∞) cutoff := by
    dsimp [cutoff]
    exact contDiff_normalizedDyadicCutoffSquare phi v
  have hcutoffEq : cutoff = cutoff0 := by
    dsimp [cutoff, cutoff0]
    exact normalizedDyadicCutoffSquare_eq_of_unit
      phi hphiOne hphiZero hphiRadial v v0 hv hv0
  have hfirst : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (fun z : Real => density z * physical z) u‖ ≤ E := by
    intro i hi
    have hprod := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
      (n := i) hdensity hphysical hA.le hB.le
      (fun l hl => hAbound l (hl.trans (hi.trans hk)) u hu)
      (fun l hl => hBbound l (hl.trans (hi.trans hk)) ‖x‖ u (norm_nonneg _) hu)
    calc
      ‖iteratedDeriv i (fun z : Real => density z * physical z) u‖ ≤
          tripleWaveLeibnizConstant i A B := hprod
      _ ≤ E := by
        unfold E
        have himem : i ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
        exact Finset.single_le_sum
          (fun l hl => tripleWaveLeibnizConstant_nonneg l hA.le hB.le) himem
  have htotal := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
    (n := k) (hdensity.mul hphysical) hcutoff hEnonneg hD.le hfirst
    (fun l hl => by
      rw [hcutoffEq]
      exact hDbound l (hl.trans hk) u hu)
  have hFbound : tripleWaveLeibnizConstant k E D ≤ F := by
    unfold F
    have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
    exact Finset.single_le_sum
      (fun l hl => tripleWaveLeibnizConstant_nonneg l hEnonneg hD.le) hkmem
  unfold coordinateTripleWaveFixedAmplitude
  change ‖iteratedDeriv k (fun z : Real =>
      density z * physical z * cutoff z) u‖ ≤ F + 1
  calc
    ‖iteratedDeriv k (fun z : Real => density z * physical z * cutoff z) u‖ ≤
        tripleWaveLeibnizConstant k E D := htotal
    _ ≤ F + 1 := by linarith

/-- At level zero, the literal absolute bandpass on a unit ray is precisely
the normalized radial cutoff used in the compact integration-by-parts
argument. -/
theorem absoluteDyadicBandpass_zero_smul_eq_normalized
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (v : Euclidean d) (u : Real) :
    absoluteDyadicBandpass phi hphiOne hphiZero 0 (u • v) =
      normalizedDyadicRadialBandpass phi v u := by
  have h := absoluteDyadicBandpass_smul_dyadicScale_eq_normalizedDyadicRadialBandpass
    phi hphiOne hphiZero 0 v u
  norm_num at h
  simpa using h

/-- Exact factorization of a literal level-zero triple coefficient into its
fixed physical/cutoff part and its two multiplier-side stationary waves. -/
private theorem coordinateTripleWaveCoefficient_eq_fixed_mul_pair
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (R R' : Real) (v x : Euclidean d)
    (p q t : CoordinateWavePart) (u : Real) :
    coordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      R R' v x p q t u =
      coordinateTripleWaveFixedAmplitude phi v x p u *
        coordinateWaveMultiplierPairAmplitude d q t R R' u := by
  have hcutoff := absoluteDyadicBandpass_zero_smul_eq_normalized
    phi hphiOne hphiZero v u
  unfold coordinateTripleWaveCoefficient coordinateTripleWaveFixedAmplitude
    coordinateWaveMultiplierPairAmplitude normalizedDyadicCutoffSquare
  rw [hcutoff, map_mul]
  ring

/-- Factoring one common positive denominator out of the right input of the
finite Leibniz constant. -/
theorem tripleWaveLeibnizConstant_right_div
    (n : Nat) (A B q : Real) (hq : q ≠ 0) :
    tripleWaveLeibnizConstant n A (B / q) =
      tripleWaveLeibnizConstant n A B / q := by
  unfold tripleWaveLeibnizConstant
  rw [Finset.sum_div]
  apply Finset.sum_congr rfl
  intro i hi
  field_simp [hq]

/-- The literal higher-dimensional coefficient has the exact pair-side
stationary scale uniformly through any prescribed finite derivative order. -/
private theorem exists_uniform_coordinateTripleWaveCoefficient_scaled
    {d N : Nat} (hd : 2 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ k : Nat, k ≤ N →
      ∀ s r r' u : Real, 1 ≤ s →
        r ∈ Icc (1 / 2 : Real) (5 / 2) →
        r' ∈ Icc (1 / 2 : Real) (5 / 2) →
        ∀ v x : Euclidean d, ‖v‖ = 1 → u ∈ Icc (1 / 2 : Real) 8 →
        ‖iteratedDeriv k (fun z : Real =>
          coordinateTripleWaveCoefficient
            (absoluteDyadicBandpass phi hphiOne hphiZero 0)
            (s * r) (s * r') v x p q t z) u‖ ≤ C / s ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_coordinateTripleWaveFixedAmplitude_bound (N := N) hd phi
      hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_coordinateWaveMultiplierPairAmplitude_scaled (N := N) hd q t
  let C : Real := ∑ l ∈ Finset.range (N + 1), tripleWaveLeibnizConstant l A B
  have hCnonneg : 0 ≤ C := by
    dsimp [C]
    apply Finset.sum_nonneg
    intro l hl
    exact tripleWaveLeibnizConstant_nonneg l hA.le hB.le
  refine ⟨C + 1, by linarith, ?_⟩
  intro k hk s r r' u hs hr hr' v x hv hu
  have hfixed : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i (coordinateTripleWaveFixedAmplitude phi v x p) u‖ ≤ A := by
    intro i hi
    exact hAbound v x hv i (hi.trans hk) u hu
  have hpair : ∀ i : Nat, i ≤ k →
      ‖iteratedDeriv i
        (coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r')) u‖ ≤
        B / s ^ (d - 1) := by
    intro i hi
    exact hBbound i (hi.trans hk) s r r' u hs hr hr' hu
  have hprod := norm_iteratedDeriv_mul_le_tripleWaveLeibnizConstant
    (n := k) (contDiff_coordinateTripleWaveFixedAmplitude phi v x p)
      (contDiff_coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r'))
      hA.le (div_nonneg hB.le (pow_nonneg (zero_le_one.trans hs) _)) hfixed hpair
  have hfactorfun : (fun z : Real =>
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t z) =
      fun z : Real => coordinateTripleWaveFixedAmplitude phi v x p z *
        coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') z := by
    funext z
    exact coordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t z
  rw [hfactorfun]
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsdenpos : 0 < s ^ (d - 1) := pow_pos hspos _
  calc
    ‖iteratedDeriv k (fun z : Real =>
        coordinateTripleWaveFixedAmplitude phi v x p z *
          coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') z) u‖ ≤
        tripleWaveLeibnizConstant k A (B / s ^ (d - 1)) := hprod
    _ = tripleWaveLeibnizConstant k A B / s ^ (d - 1) := by
      rw [tripleWaveLeibnizConstant_right_div k A B
        (s ^ (d - 1)) hsdenpos.ne']
    _ ≤ C / s ^ (d - 1) := by
      apply div_le_div_of_nonneg_right
      · have hkmem : k ∈ Finset.range (N + 1) := Finset.mem_range.mpr (by omega)
        unfold C
        exact Finset.single_le_sum
          (fun l hl => tripleWaveLeibnizConstant_nonneg l hA.le hB.le) hkmem
      · exact hsdenpos.le
    _ ≤ (C + 1) / s ^ (d - 1) := by
      apply div_le_div_of_nonneg_right
      · linarith
      · exact hsdenpos.le

/-- The extracted coordinate-wave phase is homogeneous in all three radial
parameters. -/
theorem coordinateTripleWavePhase_scale
    (s u r r' : Real) (p q t : CoordinateWavePart) :
    coordinateTripleWavePhase p q t (s * u) (s * r) (s * r') =
      s * coordinateTripleWavePhase p q t u r r' := by
  cases p <;> cases q <;> cases t <;>
    simp [coordinateTripleWavePhase, coordinateWaveRadialPhase] <;> ring

/-- A literal higher-dimensional triple coefficient vanishes in a
neighbourhood of the left endpoint of the enlarged compact annulus. -/
private theorem coordinateTripleWaveCoefficient_eventuallyEq_zero_left
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean d) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) :
    coordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      r r' v x p q t =ᶠ[𝓝 (1 / 2 : Real)] 0 := by
  filter_upwards [Metric.ball_mem_nhds (1 / 2 : Real)
      (by norm_num : (0 : Real) < 1 / 4)] with u hu
  rw [mem_ball, Real.dist_eq] at hu
  have huabs : |u - 1 / 2| < 1 / 4 := hu
  have hu0 : 0 ≤ u := by
    have := (abs_lt.mp huabs).1
    linarith
  have huone : u ≤ 1 := by
    have := (abs_lt.mp huabs).2
    linarith
  exact coordinateTripleWaveCoefficient_absoluteDyadicBandpass_eq_zero_unit
    phi hphiOne hphiZero r r' v x hv p q t ⟨hu0, huone⟩

/-- Right-endpoint counterpart of the preceding literal cutoff support
statement. -/
private theorem coordinateTripleWaveCoefficient_eventuallyEq_zero_right
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean d) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) :
    coordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      r r' v x p q t =ᶠ[𝓝 (8 : Real)] 0 := by
  filter_upwards [Metric.ball_mem_nhds (8 : Real)
      (by norm_num : (0 : Real) < 1)] with u hu
  rw [mem_ball, Real.dist_eq] at hu
  have huabs : |u - 8| < 1 := hu
  have hufour : 4 ≤ u := by
    have := (abs_lt.mp huabs).1
    linarith
  have hscale := absoluteDyadicBandpass_smul_dyadicScale_eq_normalizedDyadicRadialBandpass
    phi hphiOne hphiZero 0 v u
  norm_num at hscale
  have hzero : absoluteDyadicBandpass phi hphiOne hphiZero 0 (u • v) = 0 := by
    rw [hscale]
    exact normalizedDyadicRadialBandpass_eq_zero_of_four_le
      phi hphiZero v hv hufour
  unfold coordinateTripleWaveCoefficient
  rw [hzero]
  simp

/-- The exact compact integration-by-parts chain for every literal triple
coefficient, with no suppressed endpoint term. -/
private theorem hasOscillatoryIBPChain_coordinateTripleWaveCoefficient
    {d : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean d) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) (N : Nat) :
    HasOscillatoryIBPChain (1 / 2 : Real) 8
      (fun k => iteratedDeriv k
        (coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          r r' v x p q t)) N := by
  apply hasOscillatoryIBPChain_iteratedDeriv_of_contDiff
  · exact contDiff_coordinateTripleWaveCoefficient
      (absoluteDyadicBandpass phi hphiOne hphiZero 0) r r' v x p q t
  · exact coordinateTripleWaveCoefficient_eventuallyEq_zero_left
      phi hphiOne hphiZero r r' v x hv p q t
  · exact coordinateTripleWaveCoefficient_eventuallyEq_zero_right
      phi hphiOne hphiZero r r' v x hv p q t

/-- The literal coefficient extension and its exact compact IBP chain give
this finite-order nonstationary estimate on the original `[1,4]` annulus. -/
private theorem norm_intervalIntegral_coordinateTripleWaveCoefficient_le_iterated
    {d N : Nat} (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (r r' : Real) (v x : Euclidean d) (hv : ‖v‖ = 1)
    (p q t : CoordinateWavePart) (freq M : Real)
    (hfreq : freq ≠ 0) (hM : 0 ≤ M)
    (hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv N (coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t) u‖ ≤ M) :
    ‖∫ u in (1 : Real)..4,
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        r r' v x p q t u * oscillatoryExp freq u‖ ≤
      (1 / |freq|) ^ N * ((8 - (1 / 2 : Real)) * M) := by
  rw [intervalIntegral_coordinateTripleWaveCoefficient_eq_expanded
    phi hphiOne hphiZero r r' v x hv p q t]
  exact norm_intervalIntegral_mul_oscillatoryExp_le_iterated
    (by norm_num) hfreq
    (hasOscillatoryIBPChain_coordinateTripleWaveCoefficient
      phi hphiOne hphiZero r r' v x hv p q t N)
    hM hbound

/-- In the inner cone, an endpoint triple has a genuinely nonstationary
phase.  Combining the exact coefficient derivative bound with compact IBP
gives arbitrary radius-gap decay for that literal summand. -/
private theorem exists_inner_endpoint_coordinateTripleWaveIntegral_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart)
    (hp : p ≠ .middle) (hq : q ≠ .middle) (ht : t ≠ .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → r ≠ r' →
      ∀ v x : Euclidean d, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) p q t u *
          oscillatoryExp
            (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        (4 / (s * |r - r'|)) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_uniform_coordinateTripleWaveCoefficient_scaled (N := d) (by omega)
      phi hphiOne hphiZero hphiRadial p q t
  refine ⟨C, hC, ?_⟩
  intro s r r' hs hr hr' hrr v x hv hxcone
  let y : Euclidean d := s • x
  let freq : Real := coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hgap : 0 < |r - r'| := abs_pos.mpr (sub_ne_zero.mpr hrr)
  have hscalednorm : ‖y‖ = s * ‖x‖ := by
    dsimp [y]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
  have horig : |r - r'| / 4 ≤
      |coordinateTripleWavePhase p q t ‖x‖ r r'| :=
    abs_coordinateTripleWavePhase_ge_quarter_gap_of_endpoints hp hq ht hr hr'
      (norm_nonneg _) hxcone
  have hfreqscale : freq =
      s * coordinateTripleWavePhase p q t ‖x‖ r r' := by
    dsimp [freq]
    rw [hscalednorm]
    exact coordinateTripleWavePhase_scale s ‖x‖ r r' p q t
  have hfreqlower : s * |r - r'| / 4 ≤ |freq| := by
    rw [hfreqscale, abs_mul, abs_of_pos hspos]
    calc
      s * |r - r'| / 4 = s * (|r - r'| / 4) := by ring
      _ ≤ s * |coordinateTripleWavePhase p q t ‖x‖ r r'| :=
        mul_le_mul_of_nonneg_left horig hspos.le
  have hfreqpos : 0 < |freq| := by
    have : 0 < s * |r - r'| / 4 := by positivity
    exact lt_of_lt_of_le this hfreqlower
  have hinv : 1 / |freq| ≤ 4 / (s * |r - r'|) := by
    calc
      1 / |freq| ≤ 1 / (s * |r - r'| / 4) :=
        div_le_div_of_nonneg_left zero_le_one
          (by positivity) hfreqlower
      _ = 4 / (s * |r - r'|) := by
        field_simp [hspos.ne', hgap.ne']
  have hM : 0 ≤ C / s ^ (d - 1) := by
    exact div_nonneg hC.le (pow_nonneg hspos.le _)
  have hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv d (coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y p q t) u‖ ≤ C / s ^ (d - 1) := by
    intro u hu
    exact hCbound d le_rfl s r r' u hs hr hr' v y hv hu
  have hIBP := norm_intervalIntegral_coordinateTripleWaveCoefficient_le_iterated
    (N := d) phi hphiOne hphiZero (s * r) (s * r') v y hv p q t freq
    (C / s ^ (d - 1)) (abs_pos.mp hfreqpos) hM hbound
  change ‖∫ u in (1 : Real)..4,
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y p q t u * oscillatoryExp freq u‖ ≤ _
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v y p q t u * oscillatoryExp freq u‖ ≤
        (1 / |freq|) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := hIBP
    _ ≤ (4 / (s * |r - r'|)) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := by
      apply mul_le_mul_of_nonneg_right
      · exact pow_le_pow_left₀ (by positivity) hinv _
      · positivity

/-- If the physical factor is a middle meridian wave, it carries no
extracted phase; the two multiplier-side endpoint waves still give the same
inner-cone radius-gap separation. -/
private theorem exists_inner_physicalMiddle_coordinateTripleWaveIntegral_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (q t : CoordinateWavePart) (hq : q ≠ .middle) (ht : t ≠ .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → r ≠ r' →
      ∀ v x : Euclidean d, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) .middle q t u *
          oscillatoryExp
            (coordinateTripleWavePhase .middle q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        (4 / (s * |r - r'|)) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := by
  obtain ⟨C, hC, hCbound⟩ :=
    exists_uniform_coordinateTripleWaveCoefficient_scaled (N := d) (by omega)
      phi hphiOne hphiZero hphiRadial .middle q t
  refine ⟨C, hC, ?_⟩
  intro s r r' hs hr hr' hrr v x hv hxcone
  let y : Euclidean d := s • x
  let freq : Real := coordinateTripleWavePhase .middle q t ‖y‖ (s * r) (s * r')
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hgap : 0 < |r - r'| := abs_pos.mpr (sub_ne_zero.mpr hrr)
  have horig : |r - r'| / 4 ≤
      |coordinateTripleWavePhase .middle q t 0 r r'| :=
    abs_coordinateTripleWavePhase_ge_quarter_gap_of_physical_middle hq ht hr hr'
  have hmiddlephase (a b c : Real) :
      coordinateTripleWavePhase .middle q t a b c =
        coordinateTripleWavePhase .middle q t 0 b c := by
    simp [coordinateTripleWavePhase, coordinateWaveRadialPhase]
  have hfreqscale : freq =
      s * coordinateTripleWavePhase .middle q t 0 r r' := by
    dsimp [freq]
    rw [hmiddlephase]
    exact coordinateTripleWavePhase_scale s 0 r r' .middle q t
  have hfreqlower : s * |r - r'| / 4 ≤ |freq| := by
    rw [hfreqscale, abs_mul, abs_of_pos hspos]
    calc
      s * |r - r'| / 4 = s * (|r - r'| / 4) := by ring
      _ ≤ s * |coordinateTripleWavePhase .middle q t 0 r r'| :=
        mul_le_mul_of_nonneg_left horig hspos.le
  have hfreqpos : 0 < |freq| := by
    have : 0 < s * |r - r'| / 4 := by positivity
    exact lt_of_lt_of_le this hfreqlower
  have hinv : 1 / |freq| ≤ 4 / (s * |r - r'|) := by
    calc
      1 / |freq| ≤ 1 / (s * |r - r'| / 4) :=
        div_le_div_of_nonneg_left zero_le_one
          (by positivity) hfreqlower
      _ = 4 / (s * |r - r'|) := by
        field_simp [hspos.ne', hgap.ne']
  have hM : 0 ≤ C / s ^ (d - 1) :=
    div_nonneg hC.le (pow_nonneg hspos.le _)
  have hbound : ∀ u ∈ Icc (1 / 2 : Real) 8,
      ‖iteratedDeriv d (coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y .middle q t) u‖ ≤ C / s ^ (d - 1) := by
    intro u hu
    exact hCbound d le_rfl s r r' u hs hr hr' v y hv hu
  have hIBP := norm_intervalIntegral_coordinateTripleWaveCoefficient_le_iterated
    (N := d) phi hphiOne hphiZero (s * r) (s * r') v y hv .middle q t freq
    (C / s ^ (d - 1)) (abs_pos.mp hfreqpos) hM hbound
  change ‖∫ u in (1 : Real)..4,
      coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v y .middle q t u * oscillatoryExp freq u‖ ≤ _
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v y .middle q t u * oscillatoryExp freq u‖ ≤
        (1 / |freq|) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := hIBP
    _ ≤ (4 / (s * |r - r'|)) ^ d *
          ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) := by
      apply mul_le_mul_of_nonneg_right
      · exact pow_le_pow_left₀ (by positivity) hinv _
      · positivity

/-- A multiplier-side middle wave has as much additional dyadic decay as is
needed for the nonoscillatory middle-term part of the cone argument. -/
private theorem exists_coordinateWaveRadialAmplitude_middle_scaled_power
    {d L : Nat} :
    ∃ C : Real, 0 < C ∧ ∀ s r u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadialAmplitude d .middle (s * r) u‖ ≤ C / s ^ L := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_decay d 0 L
  refine ⟨C, hC, ?_⟩
  intro s r u hs hr hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry hs hr hu
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hden : s ^ L ≤ |(2 * Real.pi * (s * r)) * u| ^ L :=
    pow_le_pow_left₀ (zero_le_one.trans hs) hscale _
  calc
    ‖coordinateWaveRadialAmplitude d .middle (s * r) u‖ ≤
        C * |2 * Real.pi * (s * r)| ^ 0 /
          |(2 * Real.pi * (s * r)) * u| ^ L := hbound (s * r) u hfreq
    _ = C / |(2 * Real.pi * (s * r)) * u| ^ L := by simp
    _ ≤ C / s ^ L :=
      div_le_div_of_nonneg_left hC.le (pow_pos hspos _) hden

/-- If either multiplier-side wave is a middle term, its rapid meridian
decay supplies an extra full dyadic power beyond the stationary pair scale. -/
private theorem exists_coordinateWaveMultiplierPairAmplitude_oneMiddle_scaled
    {d L : Nat} (hd : 2 ≤ d) (q t : CoordinateWavePart)
    (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' u : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
        C / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
  rcases hmiddle with hq | ht
  · subst q
    obtain ⟨A, hA, hAbound⟩ :=
      exists_coordinateWaveRadialAmplitude_middle_scaled_power (d := d) (L := L)
    obtain ⟨B, hB, hBbound⟩ :=
      exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_scaled
        (d := d) (k := 0) hd t
    refine ⟨A * B, mul_pos hA hB, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hAbound s r u hs hr hu
    have htbound := hBbound s r' u hs hr' hu
    have hQpos : 0 < (Real.sqrt s) ^ (d - 1) := by
      apply pow_pos
      exact Real.sqrt_pos.2 hspos
    unfold coordinateWaveMultiplierPairAmplitude
    try simp only [iteratedDeriv_zero] at hqbound
    try simp only [iteratedDeriv_zero] at htbound
    rw [norm_mul, starRingEnd_apply, norm_star]
    calc
      ‖coordinateWaveRadialAmplitude d .middle (s * r) u‖ *
          ‖coordinateWaveRadialAmplitude d t (s * r') u‖ ≤
          (A / s ^ L) * (B / (Real.sqrt s) ^ (d - 1)) := by
        exact mul_le_mul hqbound htbound (norm_nonneg _) (div_nonneg hA.le (pow_nonneg hspos.le _))
      _ = (A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hspos.ne', hQpos.ne']
  · subst t
    obtain ⟨A, hA, hAbound⟩ :=
      exists_coordinateWaveRadialAmplitude_middle_scaled_power (d := d) (L := L)
    obtain ⟨B, hB, hBbound⟩ :=
      exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_scaled
        (d := d) (k := 0) hd q
    refine ⟨B * A, mul_pos hB hA, ?_⟩
    intro s r r' u hs hr hr' hu
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hqbound := hBbound s r u hs hr hu
    have htbound := hAbound s r' u hs hr' hu
    have hQpos : 0 < (Real.sqrt s) ^ (d - 1) := by
      apply pow_pos
      exact Real.sqrt_pos.2 hspos
    unfold coordinateWaveMultiplierPairAmplitude
    try simp only [iteratedDeriv_zero] at hqbound
    try simp only [iteratedDeriv_zero] at htbound
    rw [norm_mul, starRingEnd_apply, norm_star]
    calc
      ‖coordinateWaveRadialAmplitude d q (s * r) u‖ *
          ‖coordinateWaveRadialAmplitude d .middle (s * r') u‖ ≤
          (B / (Real.sqrt s) ^ (d - 1)) * (A / s ^ L) := by
        exact mul_le_mul hqbound htbound (norm_nonneg _)
          (div_nonneg hB.le (pow_nonneg (Real.sqrt_nonneg _) _))
      _ = (B * A) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hspos.ne', hQpos.ne']

/-- A literal triple containing a multiplier-side middle wave is bounded
absolutely; its rapid decay already dominates the desired gap gain. -/
private theorem exists_oneMiddle_coordinateTripleWaveIntegral_bound
    {d L : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) (hmiddle : q = .middle ∨ t = .middle) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean d, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_coordinateTripleWaveFixedAmplitude_bound (N := 0) (by omega)
      phi hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_coordinateWaveMultiplierPairAmplitude_oneMiddle_scaled (d := d) (L := L)
      (by omega) q t hmiddle
  refine ⟨3 * A * B, mul_pos (mul_pos (by norm_num) hA) hB, ?_⟩
  intro s r r' hs hr hr' v x hv
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hdenpos : 0 < s ^ L * (Real.sqrt s) ^ (d - 1) := by positivity
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by constructor <;> linarith [hu.1, hu.2]
    have hfixed := hAbound v x hv 0 le_rfl u huwide
    have hpair := hBbound s r r' u hs hr hr' huwide
    have hfactor := coordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one, norm_mul]
    calc
      ‖coordinateTripleWaveFixedAmplitude phi v x p u‖ *
          ‖coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
          A * (B / (s ^ L * (Real.sqrt s) ^ (d - 1))) := by
        exact mul_le_mul hfixed hpair (norm_nonneg _) hA.le
      _ = (A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hdenpos.ne']
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1))) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * B) / (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
      norm_num
      ring

/-- The diagonal-size bound for one literal triple coefficient.  This is
the small-gap half of the stationary kernel estimate. -/
private theorem exists_coordinateTripleWaveIntegral_crude_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean d, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / s ^ (d - 1) := by
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_coordinateTripleWaveFixedAmplitude_bound (N := 0) (by omega)
      phi hphiOne hphiZero hphiRadial p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_coordinateWaveMultiplierPairAmplitude_scaled (d := d) (N := 0)
      (by omega) q t
  refine ⟨3 * A * B, mul_pos (mul_pos (by norm_num) hA) hB, ?_⟩
  intro s r r' hs hr hr' v x hv
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hdenpos : 0 < s ^ (d - 1) := pow_pos hspos _
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * B) / s ^ (d - 1) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by constructor <;> linarith [hu.1, hu.2]
    have hfixed := hAbound v x hv 0 le_rfl u huwide
    have hpair := hBbound 0 le_rfl s r r' u hs hr hr' huwide
    have hfactor := coordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one, norm_mul]
    calc
      ‖coordinateTripleWaveFixedAmplitude phi v x p u‖ *
          ‖coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
          A * (B / s ^ (d - 1)) := by
        exact mul_le_mul hfixed hpair (norm_nonneg _) hA.le
      _ = (A * B) / s ^ (d - 1) := by
        field_simp [hdenpos.ne']
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * B) / s ^ (d - 1)) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * B) / s ^ (d - 1) := by
      norm_num
      ring

/-- A physical outgoing endpoint wave has stationary decay once its radial
frequency is at least one. -/
private theorem exists_coordinateWaveRadialAmplitude_outgoing_physical_decay
    {d : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 1 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadialAmplitude d .outgoing a u‖ ≤
        C / (Real.sqrt a) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_outgoing_decay d 0
  refine ⟨C, hC, ?_⟩
  intro a u ha hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry (s := a) (r := 1) ha
      (by constructor <;> norm_num) hu
  have hfreqpos : 0 < |(2 * Real.pi * (a * 1)) * u| :=
    lt_of_lt_of_le zero_lt_one hfreq
  calc
    ‖coordinateWaveRadialAmplitude d .outgoing a u‖ ≤
        C * |2 * Real.pi * a| ^ 0 /
          quadraticMomentScale (d - 2) |(2 * Real.pi * a) * u| := by
      simpa using hbound a u (by simpa using hfreq)
    _ ≤ (C * (5 * Real.pi) ^ 0) / (Real.sqrt a) ^ (d - 1) :=
      endpoint_stationary_denominator_le_dyadic_scale hd ha hC.le (by positivity)
        (by simpa using hamp) (by simpa using hfreqpos) (by simpa using hsqrt)
    _ = C / (Real.sqrt a) ^ (d - 1) := by simp

/-- Reflected physical endpoint waves have the same stationary decay. -/
private theorem exists_coordinateWaveRadialAmplitude_incoming_physical_decay
    {d : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 1 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadialAmplitude d .incoming a u‖ ≤
        C / (Real.sqrt a) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_incoming_decay d 0
  refine ⟨C, hC, ?_⟩
  intro a u ha hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry (s := a) (r := 1) ha
      (by constructor <;> norm_num) hu
  have hfreqpos : 0 < |(2 * Real.pi * (a * 1)) * u| :=
    lt_of_lt_of_le zero_lt_one hfreq
  have hsign : |(-(2 * Real.pi * a)) * u| = |(2 * Real.pi * a) * u| := by
    rw [show (-(2 * Real.pi * a)) * u = -((2 * Real.pi * a) * u) by ring,
      abs_neg]
  have hsignAmp : |-(2 * Real.pi * a)| = |2 * Real.pi * a| := by rw [abs_neg]
  calc
    ‖coordinateWaveRadialAmplitude d .incoming a u‖ ≤
        C * |-(2 * Real.pi * a)| ^ 0 /
          quadraticMomentScale (d - 2) |(-(2 * Real.pi * a)) * u| :=
      hbound a u (by simpa [hsign] using hfreq)
    _ = C * |2 * Real.pi * a| ^ 0 /
          quadraticMomentScale (d - 2) |(2 * Real.pi * a) * u| := by
      rw [hsignAmp, hsign]
    _ ≤ (C * (5 * Real.pi) ^ 0) / (Real.sqrt a) ^ (d - 1) :=
      endpoint_stationary_denominator_le_dyadic_scale hd ha hC.le (by positivity)
        (by simpa using hamp) (by simpa using hfreqpos) (by simpa using hsqrt)
    _ = C / (Real.sqrt a) ^ (d - 1) := by simp

/-- The physical middle meridian wave has rapid decay and hence the same
stationary upper bound. -/
private theorem exists_coordinateWaveRadialAmplitude_middle_physical_decay
    {d : Nat} (hd : 2 ≤ d) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 1 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadialAmplitude d .middle a u‖ ≤
        C / (Real.sqrt a) ^ (d - 1) := by
  obtain ⟨C, hC, hbound⟩ :=
    exists_norm_iteratedDeriv_coordinateWaveRadialAmplitude_middle_decay d 0 d
  refine ⟨C, hC, ?_⟩
  intro a u ha hu
  obtain ⟨hfreq, hamp, hscale, hsqrt⟩ :=
    scaled_coordinate_frequency_geometry (s := a) (r := 1) ha
      (by constructor <;> norm_num) hu
  calc
    ‖coordinateWaveRadialAmplitude d .middle a u‖ ≤
        C * |2 * Real.pi * a| ^ 0 / |(2 * Real.pi * a) * u| ^ d :=
      hbound a u (by simpa using hfreq)
    _ ≤ (C * (5 * Real.pi) ^ 0) / (Real.sqrt a) ^ (d - 1) :=
      rapid_middle_denominator_le_dyadic_scale hd ha hC.le (by positivity)
        (by simpa using hamp) (by simpa using hscale)
    _ = C / (Real.sqrt a) ^ (d - 1) := by simp

/-- Literal physical coordinate-wave stationary decay, shared by ordinary
and differentiated outer-cone estimates. -/
theorem exists_coordinateWaveRadialAmplitude_physical_decay
    {d : Nat} (hd : 2 ≤ d) (p : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ a u : Real, 1 ≤ a → u ∈ Icc (1 / 2 : Real) 8 →
      ‖coordinateWaveRadialAmplitude d p a u‖ ≤
        C / (Real.sqrt a) ^ (d - 1) := by
  cases p with
  | outgoing => exact exists_coordinateWaveRadialAmplitude_outgoing_physical_decay hd
  | incoming => exact exists_coordinateWaveRadialAmplitude_incoming_physical_decay hd
  | middle => exact exists_coordinateWaveRadialAmplitude_middle_physical_decay hd

/-- In the outer cone, absolute stationary decay of the physical coordinate
wave supplies the radius-gap factor without any integration by parts. -/
private theorem exists_outer_coordinateTripleWaveIntegral_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean d, ‖v‖ = 1 → 1 ≤ ‖x‖ →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        C / (s ^ (d - 1) * (Real.sqrt ‖x‖) ^ (d - 1)) := by
  let density : Real → Complex := fun u : Real => ((u ^ (d - 1) : Real) : Complex)
  have hdensity : ContDiff Real (⊤ : ℕ∞) density := by
    dsimp only [density]
    exact contDiff_ofReal_pow (d - 1)
  obtain ⟨A, hA, hAbound⟩ :=
    exists_uniform_iteratedDeriv_bound_on_fixedAnnulus density hdensity 0
  obtain ⟨D, hD, hDbound⟩ :=
    exists_uniform_normalizedDyadicCutoffSquare_bound_on_unit (N := 0) (by omega)
      phi hphiOne hphiZero hphiRadial
  obtain ⟨P, hP, hPbound⟩ :=
    exists_coordinateWaveRadialAmplitude_physical_decay (d := d) (by omega) p
  obtain ⟨B, hB, hBbound⟩ :=
    exists_uniform_coordinateWaveMultiplierPairAmplitude_scaled (d := d) (N := 0)
      (by omega) q t
  refine ⟨3 * A * P * D * B,
    mul_pos (mul_pos (mul_pos (mul_pos (by norm_num) hA) hP) hD) hB, ?_⟩
  intro s r r' hs hr hr' v x hv hx
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hxpos : 0 < ‖x‖ := lt_of_lt_of_le zero_lt_one hx
  have hsdenpos : 0 < s ^ (d - 1) := pow_pos hspos _
  have hxdenpos : 0 < (Real.sqrt ‖x‖) ^ (d - 1) := by
    apply pow_pos
    exact Real.sqrt_pos.2 hxpos
  have hpoint : ∀ u ∈ Icc (1 : Real) 4,
      ‖coordinateTripleWaveCoefficient
        (absoluteDyadicBandpass phi hphiOne hphiZero 0)
        (s * r) (s * r') v x p q t u *
        oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        (A * P * D * B) /
          (s ^ (d - 1) * (Real.sqrt ‖x‖) ^ (d - 1)) := by
    intro u hu
    have huwide : u ∈ Icc (1 / 2 : Real) 8 := by constructor <;> linarith [hu.1, hu.2]
    have hden := hAbound 0 le_rfl u huwide
    have hcut := hDbound v hv 0 le_rfl u huwide
    have hphysical := hPbound ‖x‖ u hx huwide
    have hpair := hBbound 0 le_rfl s r r' u hs hr hr' huwide
    simp only [iteratedDeriv_zero] at hden hcut hpair
    have hfactor := coordinateTripleWaveCoefficient_eq_fixed_mul_pair
      phi hphiOne hphiZero (s * r) (s * r') v x p q t u
    rw [hfactor, norm_mul, norm_oscillatoryExp, mul_one]
    unfold coordinateTripleWaveFixedAmplitude
    rw [norm_mul, norm_mul, norm_mul]
    calc
      ‖density u‖ * ‖coordinateWaveRadialAmplitude d p ‖x‖ u‖ *
          ‖normalizedDyadicCutoffSquare phi v u‖ *
            ‖coordinateWaveMultiplierPairAmplitude d q t (s * r) (s * r') u‖ ≤
          A * (P / (Real.sqrt ‖x‖) ^ (d - 1)) * D *
            (B / s ^ (d - 1)) := by
        gcongr
      _ = (A * P * D * B) /
          (s ^ (d - 1) * (Real.sqrt ‖x‖) ^ (d - 1)) := by
        field_simp [hsdenpos.ne', hxdenpos.ne']
  calc
    ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v x p q t u *
          oscillatoryExp (coordinateTripleWavePhase p q t ‖x‖ (s * r) (s * r')) u‖ ≤
        ((A * P * D * B) /
          (s ^ (d - 1) * (Real.sqrt ‖x‖) ^ (d - 1))) * |4 - (1 : Real)| := by
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro u hu
      have hu' : u ∈ Icc (1 : Real) 4 := by
        rw [uIoc_of_le (by norm_num : (1 : Real) ≤ 4)] at hu
        exact ⟨hu.1.le, hu.2⟩
      exact hpoint u hu'
    _ = (3 * A * P * D * B) /
          (s ^ (d - 1) * (Real.sqrt ‖x‖) ^ (d - 1)) := by
      norm_num
      ring
/-! ## Numerical conversion to the stationary gap weight -/

/-- The stationary exponent occurring in the literal `Q4` gap weight.  It
is kept in a local abbreviation in the conic calculation only; the public
statement below unfolds it back to `q4PairKernelGapWeight`. -/
def q4StationaryExponent (d : Nat) : Real := ((d : Real) - 1) / 2

theorem q4StationaryExponent_nonneg {d : Nat} (hd : 1 ≤ d) :
    0 ≤ q4StationaryExponent d := by
  unfold q4StationaryExponent
  have hd' : (1 : Real) ≤ d := by exact_mod_cast hd
  linarith

theorem q4StationaryExponent_le_dimension {d : Nat} (hd : 1 ≤ d) :
    q4StationaryExponent d ≤ d := by
  unfold q4StationaryExponent
  have hd' : (1 : Real) ≤ d := by exact_mod_cast hd
  nlinarith

/-- On a bounded normalized gap, the stationary weight is bounded below by
an integer-power reciprocal.  Choosing an integer power is convenient: the
constant can later be folded into the finite 27-term sum without introducing
an implicit asymptotic notation. -/
theorem q4StationaryWeight_lower_of_one_add_le
    {d : Nat} {T L : Real} (hd : 1 ≤ d) (hT : 0 ≤ T)
    (hL : 1 ≤ L) (hbase : 1 + T ≤ L) :
    L ^ (-(d : Real)) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
  have hbasepos : 0 < 1 + T := by linarith
  have hexp : -(d : Real) ≤ -q4StationaryExponent d := by
    have h := q4StationaryExponent_le_dimension hd
    linarith
  have hpower : L ^ (-(d : Real)) ≤ L ^ (-q4StationaryExponent d) :=
    Real.rpow_le_rpow_of_exponent_le hL hexp
  have hdecreasing : L ^ (-q4StationaryExponent d) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    exact Real.rpow_le_rpow_of_nonpos hbasepos hbase
      (neg_nonpos.mpr (q4StationaryExponent_nonneg hd))
  exact hpower.trans hdecreasing

/-- In the off-diagonal regime, the desired stationary gap weight dominates
the normalized power `T^(-(d-1)/2)` up to the harmless integer constant
`2^d`. -/
theorem q4StationaryPower_le_twoPow_dimension_mul_weight
    {d : Nat} {T : Real} (hd : 1 ≤ d) (hT : 1 ≤ T) :
    T ^ (-q4StationaryExponent d) ≤
      (2 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) := by
  have hTpos : 0 < T := lt_of_lt_of_le zero_lt_one hT
  have hbase : 1 + T ≤ 2 * T := by linarith
  have htwopos : 0 < (2 : Real) := by norm_num
  have ha : 0 ≤ q4StationaryExponent d := q4StationaryExponent_nonneg hd
  have hdim : q4StationaryExponent d ≤ d :=
    q4StationaryExponent_le_dimension hd
  have htwo : (2 : Real) ^ (-(d : Real)) ≤
      (2 : Real) ^ (-q4StationaryExponent d) := by
    apply Real.rpow_le_rpow_of_exponent_le
    · norm_num
    · linarith
  have hphase : (2 * T) ^ (-q4StationaryExponent d) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    exact Real.rpow_le_rpow_of_nonpos (by linarith) hbase (by linarith)
  have hproduct : (2 : Real) ^ (-(d : Real)) *
      T ^ (-q4StationaryExponent d) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    calc
      (2 : Real) ^ (-(d : Real)) * T ^ (-q4StationaryExponent d) ≤
          (2 : Real) ^ (-q4StationaryExponent d) *
            T ^ (-q4StationaryExponent d) := by
        exact mul_le_mul_of_nonneg_right htwo
          (Real.rpow_nonneg (zero_le_one.trans hT) _)
      _ = (2 * T) ^ (-q4StationaryExponent d) := by
        rw [Real.mul_rpow (by norm_num : (0 : Real) ≤ 2) (zero_le_one.trans hT)]
      _ ≤ (1 + T) ^ (-q4StationaryExponent d) := hphase
  have htwoPowPos : 0 < (2 : Real) ^ d := by positivity
  have htworewrite : (2 : Real) ^ (-(d : Real)) =
      ((2 : Real) ^ d)⁻¹ := by
    rw [Real.rpow_neg (by norm_num : (0 : Real) ≤ 2), Real.rpow_natCast]
  have hdiv : T ^ (-q4StationaryExponent d) / (2 : Real) ^ d ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    rw [div_eq_mul_inv, ← htworewrite]
    simpa [mul_comm] using hproduct
  have h := (div_le_iff₀ htwoPowPos).mp hdiv
  simpa [mul_comm] using h

/-- Extra integer decay is stronger than the stationary decay on the large
normalized-gap regime. -/
theorem q4IntegerGapPower_le_stationaryPower
    {d : Nat} {T : Real} (hd : 1 ≤ d) (hT : 1 ≤ T) :
    T ^ (-(d : Real)) ≤ T ^ (-q4StationaryExponent d) := by
  apply Real.rpow_le_rpow_of_exponent_le hT
  have h := q4StationaryExponent_le_dimension hd
  linarith

/-- The integer reciprocal used by the compact IBP estimate is the same
real power written with a natural exponent. -/
theorem q4_inv_natPow_eq_rpow_neg_dimension
    {d : Nat} {T : Real} (hT : 0 < T) :
    1 / T ^ d = T ^ (-(d : Real)) := by
  rw [Real.rpow_neg hT.le, Real.rpow_natCast]
  ring

/-- The physical stationary denominator is exactly the real stationary
power.  This is what joins the outer-cone estimate to the same gap weight as
the inner integration-by-parts estimate. -/
theorem q4_inv_sqrt_natPow_eq_rpow_neg_stationary
    {d : Nat} {X : Real} (hd : 1 ≤ d) (hX : 0 < X) :
    1 / (Real.sqrt X) ^ (d - 1) = X ^ (-q4StationaryExponent d) := by
  have hcast : ((d : Real) - 1) = ((d - 1 : Nat) : Real) := by
    rw [Nat.cast_sub hd]
    norm_num
  rw [Real.rpow_neg hX.le, one_div]
  congr 1
  unfold q4StationaryExponent
  rw [hcast, Real.rpow_div_two_eq_sqrt _ hX.le, Real.rpow_natCast]

/-- Moving from the outer physical cone `X ≥ T/4` to the gap scale costs at
most the integer constant `4^d`. -/
theorem q4_outer_stationaryPower_le_fourPow_dimension_mul
    {d : Nat} {T X : Real} (hd : 1 ≤ d) (hT : 0 < T)
    (hX : T / 4 ≤ X) :
    X ^ (-q4StationaryExponent d) ≤
      (4 : Real) ^ d * T ^ (-q4StationaryExponent d) := by
  have hTfourpos : 0 < T / 4 := by positivity
  have ha : 0 ≤ q4StationaryExponent d := q4StationaryExponent_nonneg hd
  have hdim : q4StationaryExponent d ≤ d :=
    q4StationaryExponent_le_dimension hd
  have hmono : X ^ (-q4StationaryExponent d) ≤
      (T / 4) ^ (-q4StationaryExponent d) := by
    exact Real.rpow_le_rpow_of_nonpos hTfourpos hX (by linarith)
  have hfour : (4 : Real) ^ q4StationaryExponent d ≤ (4 : Real) ^ d := by
    have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : Real) ≤ 4) hdim
    rwa [Real.rpow_natCast] at h
  have hrewrite : (T / 4) ^ (-q4StationaryExponent d) =
      T ^ (-q4StationaryExponent d) * (4 : Real) ^ q4StationaryExponent d := by
    rw [Real.div_rpow hT.le (by norm_num : (0 : Real) ≤ 4)]
    rw [Real.rpow_neg (x := (4 : Real)) (by norm_num) (q4StationaryExponent d)]
    field_simp [(Real.rpow_pos_of_pos (by norm_num : (0 : Real) < 4)
      (q4StationaryExponent d)).ne']
  calc
    X ^ (-q4StationaryExponent d) ≤
        (T / 4) ^ (-q4StationaryExponent d) := hmono
    _ = T ^ (-q4StationaryExponent d) *
          (4 : Real) ^ q4StationaryExponent d := hrewrite
    _ ≤ T ^ (-q4StationaryExponent d) * (4 : Real) ^ d := by
      exact mul_le_mul_of_nonneg_left hfour (Real.rpow_nonneg hT.le _)
    _ = (4 : Real) ^ d * T ^ (-q4StationaryExponent d) := by ring

/-- Small normalized gaps are handled by the diagonal-size estimate.  The
integer constant `5^d` is intentionally generous and records the sole loss
in replacing the bounded gap weight by one. -/
theorem q4_crude_scale_le_stationaryWeight
    {d : Nat} {C s T : Real} (hd : 1 ≤ d) (hs : 1 ≤ s)
    (hC : 0 ≤ C) (hT : 0 ≤ T) (hsmall : T ≤ 4) :
    C / s ^ (d - 1) ≤
      (C * (5 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsdenpos : 0 < s ^ (d - 1) := pow_pos hspos _
  have hweight : (5 : Real) ^ (-(d : Real)) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    apply q4StationaryWeight_lower_of_one_add_le hd hT (by norm_num)
    linarith
  have hfivepos : 0 < (5 : Real) ^ d := by positivity
  have hinv : 1 / (5 : Real) ^ d ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    rw [q4_inv_natPow_eq_rpow_neg_dimension (d := d) (T := (5 : Real))
      (by norm_num)]
    exact hweight
  have hone : 1 ≤ (5 : Real) ^ d *
      (1 + T) ^ (-q4StationaryExponent d) := by
    have h := (div_le_iff₀ hfivepos).mp hinv
    simpa [mul_comm] using h
  have hleft : 0 ≤ C / s ^ (d - 1) :=
    div_nonneg hC (pow_nonneg hspos.le _)
  calc
    C / s ^ (d - 1) = (C / s ^ (d - 1)) * 1 := by ring
    _ ≤ (C / s ^ (d - 1)) *
        ((5 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d)) :=
      mul_le_mul_of_nonneg_left hone hleft
    _ = (C * (5 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by ring

/-- The `d` integrations by parts in the inner cone beat the stationary
gap exponent.  This is the elementary numerical part of the radius-gap
argument after the analytic IBP estimate has supplied `(4/T)^d`. -/
theorem q4_inner_ibp_scale_le_stationaryWeight
    {d : Nat} {C s T : Real} (hd : 1 ≤ d) (hs : 1 ≤ s)
    (hC : 0 ≤ C) (hT : 1 ≤ T) :
    (4 / T) ^ d * ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) ≤
      ((8 - (1 / 2 : Real)) * C * (8 : Real) ^ d) /
        s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) := by
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hTpos : 0 < T := lt_of_lt_of_le zero_lt_one hT
  have hscale : 0 ≤ (8 - (1 / 2 : Real)) * (C / s ^ (d - 1)) := by
    positivity
  have hinteger : T ^ (-(d : Real)) ≤
      T ^ (-q4StationaryExponent d) :=
    q4IntegerGapPower_le_stationaryPower hd hT
  have hstationary : T ^ (-q4StationaryExponent d) ≤
      (2 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) :=
    q4StationaryPower_le_twoPow_dimension_mul_weight hd hT
  have hbase : (4 / T) ^ d ≤
      (8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) := by
    calc
      (4 / T) ^ d = (4 : Real) ^ d * (1 / T ^ d) := by
        rw [div_pow]
        field_simp [pow_ne_zero _ hTpos.ne']
      _ = (4 : Real) ^ d * T ^ (-(d : Real)) := by
        rw [q4_inv_natPow_eq_rpow_neg_dimension (d := d) hTpos]
      _ ≤ (4 : Real) ^ d * T ^ (-q4StationaryExponent d) := by
        exact mul_le_mul_of_nonneg_left hinteger (pow_nonneg (by norm_num) _)
      _ ≤ (4 : Real) ^ d *
          ((2 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d)) := by
        exact mul_le_mul_of_nonneg_left hstationary (pow_nonneg (by norm_num) _)
      _ = (8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) := by
        rw [← mul_assoc, ← mul_pow]
        norm_num
  have hright : 0 ≤ (8 : Real) ^ d *
      (1 + T) ^ (-q4StationaryExponent d) := by positivity
  calc
    (4 / T) ^ d * ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) ≤
        ((8 - (1 / 2 : Real)) * (C / s ^ (d - 1))) *
          ((8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d)) := by
      nlinarith [mul_le_mul_of_nonneg_right hbase hscale]
    _ = ((8 - (1 / 2 : Real)) * C * (8 : Real) ^ d) /
          s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) := by
      field_simp [pow_ne_zero _ hspos.ne']

/-- The outer physical stationary denominator gives the same gap weight.
The factor `8^d` combines the `T/4` outer-cone comparison and the harmless
`1+T` replacement. -/
theorem q4_outer_scale_le_stationaryWeight
    {d : Nat} {C s T X : Real} (hd : 1 ≤ d) (hs : 1 ≤ s)
    (hC : 0 ≤ C) (hT : 1 ≤ T) (hX : T / 4 ≤ X) :
    C / (s ^ (d - 1) * (Real.sqrt X) ^ (d - 1)) ≤
      (C * (8 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hTpos : 0 < T := lt_of_lt_of_le zero_lt_one hT
  have hXpos : 0 < X := lt_of_lt_of_le (by positivity : 0 < T / 4) hX
  have hphysical : X ^ (-q4StationaryExponent d) ≤
      (4 : Real) ^ d * T ^ (-q4StationaryExponent d) :=
    q4_outer_stationaryPower_le_fourPow_dimension_mul hd hTpos hX
  have hstationary : T ^ (-q4StationaryExponent d) ≤
      (2 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) :=
    q4StationaryPower_le_twoPow_dimension_mul_weight hd hT
  have hsqrtpos : 0 < Real.sqrt X := Real.sqrt_pos.2 hXpos
  have hpower : 1 / (Real.sqrt X) ^ (d - 1) ≤
      (8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) := by
    rw [q4_inv_sqrt_natPow_eq_rpow_neg_stationary hd hXpos]
    calc
      X ^ (-q4StationaryExponent d) ≤
          (4 : Real) ^ d * T ^ (-q4StationaryExponent d) := hphysical
      _ ≤ (4 : Real) ^ d *
          ((2 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d)) := by
        exact mul_le_mul_of_nonneg_left hstationary (pow_nonneg (by norm_num) _)
      _ = (8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d) := by
        rw [← mul_assoc, ← mul_pow]
        norm_num
  have hleft : 0 ≤ C / s ^ (d - 1) :=
    div_nonneg hC (pow_nonneg hspos.le _)
  calc
    C / (s ^ (d - 1) * (Real.sqrt X) ^ (d - 1)) =
        (C / s ^ (d - 1)) * (1 / (Real.sqrt X) ^ (d - 1)) := by
      field_simp [pow_ne_zero _ hspos.ne', pow_ne_zero _ hsqrtpos.ne']
    _ ≤ (C / s ^ (d - 1)) *
        ((8 : Real) ^ d * (1 + T) ^ (-q4StationaryExponent d)) :=
      mul_le_mul_of_nonneg_left hpower hleft
    _ = (C * (8 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by ring

/-- A multiplier-side middle wave is made rapidly decreasing before the
finite conic sum is taken.  At order `2d` its remaining dyadic decay is more
than enough to pay the stationary gap weight on the bounded radius shell. -/
theorem q4_middle_scale_le_stationaryWeight
    {d : Nat} {C s T : Real} (hd : 1 ≤ d) (hs : 1 ≤ s)
    (hC : 0 ≤ C) (hT : 0 ≤ T) (hTscale : T ≤ 2 * s) :
    C / (s ^ (2 * d) * (Real.sqrt s) ^ (d - 1)) ≤
      (C * (3 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hsqrtone : 1 ≤ Real.sqrt s := by
    simpa using Real.sqrt_le_sqrt hs
  have hsqrtpowone : 1 ≤ (Real.sqrt s) ^ (d - 1) :=
    one_le_pow₀ hsqrtone
  have hbase : 1 + T ≤ 3 * s := by linarith
  have hthreeScale : 1 ≤ 3 * s := by linarith
  have hweight : (3 * s) ^ (-(d : Real)) ≤
      (1 + T) ^ (-q4StationaryExponent d) :=
    q4StationaryWeight_lower_of_one_add_le hd hT hthreeScale hbase
  have hthreeSpos : 0 < 3 * s := by positivity
  have hinv : 1 / ((3 : Real) ^ d * s ^ d) ≤
      (1 + T) ^ (-q4StationaryExponent d) := by
    calc
      1 / ((3 : Real) ^ d * s ^ d) = 1 / (3 * s) ^ d := by
        rw [mul_pow]
      _ = (3 * s) ^ (-(d : Real)) :=
        q4_inv_natPow_eq_rpow_neg_dimension hthreeSpos
      _ ≤ (1 + T) ^ (-q4StationaryExponent d) := hweight
  have hdencomp : s ^ (2 * d - 1) ≤
      s ^ (2 * d) * (Real.sqrt s) ^ (d - 1) := by
    have hpow : s ^ (2 * d - 1) ≤ s ^ (2 * d) := by
      calc
        s ^ (2 * d - 1) = s ^ (2 * d - 1) * 1 := by ring
        _ ≤ s ^ (2 * d - 1) * s := by
          exact mul_le_mul_of_nonneg_left hs (pow_nonneg hspos.le _)
        _ = s ^ (2 * d) := by
          rw [← pow_succ]
          congr 1
          omega
    calc
      s ^ (2 * d - 1) ≤ s ^ (2 * d) := hpow
      _ = s ^ (2 * d) * 1 := by ring
      _ ≤ s ^ (2 * d) * (Real.sqrt s) ^ (d - 1) :=
        mul_le_mul_of_nonneg_left hsqrtpowone (pow_nonneg hspos.le _)
  have hsmall : C / (s ^ (2 * d) * (Real.sqrt s) ^ (d - 1)) ≤
      C / s ^ (2 * d - 1) := by
    apply div_le_div_of_nonneg_left hC
    · exact pow_pos hspos _
    · exact hdencomp
  have hfactor : 0 ≤ (C * (3 : Real) ^ d) / s ^ (d - 1) := by positivity
  have htarget : C / s ^ (2 * d - 1) ≤
      (C * (3 : Real) ^ d) / s ^ (d - 1) *
        (1 + T) ^ (-q4StationaryExponent d) := by
    calc
      C / s ^ (2 * d - 1) =
          (C * (3 : Real) ^ d) / s ^ (d - 1) *
            (1 / ((3 : Real) ^ d * s ^ d)) := by
        have hpow : s ^ (d - 1) * s ^ d = s ^ (2 * d - 1) := by
          rw [← pow_add]
          congr 1
          omega
        field_simp [pow_ne_zero _ hspos.ne']
        rw [mul_assoc, hpow]
      _ ≤ (C * (3 : Real) ^ d) / s ^ (d - 1) *
          (1 + T) ^ (-q4StationaryExponent d) :=
        mul_le_mul_of_nonneg_left hinv hfactor
  exact hsmall.trans htarget

/-- Monotonicity in the harmless finite coefficient multiplying the common
stationary weight. -/
theorem q4_scaleWeight_mono
    {d : Nat} {A B s T : Real} (hs : 1 ≤ s) (hT : 0 ≤ T)
    (hAB : A ≤ B) :
    A / s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) ≤
      B / s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) := by
  have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
  have hdenpos : 0 < s ^ (d - 1) := pow_pos hspos _
  have hweight : 0 ≤ (1 + T) ^ (-q4StationaryExponent d) := by positivity
  have hfactor : 0 ≤ (1 / s ^ (d - 1)) *
      (1 + T) ^ (-q4StationaryExponent d) := by positivity
  calc
    A / s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) =
        A * ((1 / s ^ (d - 1)) *
          (1 + T) ^ (-q4StationaryExponent d)) := by ring
    _ ≤ B * ((1 / s ^ (d - 1)) *
          (1 + T) ^ (-q4StationaryExponent d)) :=
      mul_le_mul_of_nonneg_right hAB hfactor
    _ = B / s ^ (d - 1) * (1 + T) ^ (-q4StationaryExponent d) := by ring

/-- Every one of the twenty-seven literal higher-dimensional coordinate
triples satisfies the stationary radius-gap estimate.  The proof is the
paper's cone split, written term by term: a bounded normalized gap is crude,
the outer cone uses physical stationary decay, endpoint triples in the inner
cone are integrated by parts, and a multiplier-side middle wave is made
rapidly decreasing before summation. -/
private theorem exists_coordinateTripleWaveIntegral_stationaryGap_bound
    {d : Nat} (hd : 3 ≤ d)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiRadial : IsNormRadial phi)
    (p q t : CoordinateWavePart) :
    ∃ C : Real, 0 < C ∧ ∀ s r r' : Real, 1 ≤ s →
      r ∈ Icc (1 / 2 : Real) (5 / 2) →
      r' ∈ Icc (1 / 2 : Real) (5 / 2) →
      ∀ v x : Euclidean d, ‖v‖ = 1 →
      ‖∫ u in (1 : Real)..4,
        coordinateTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
          (s * r) (s * r') v (s • x) p q t u *
          oscillatoryExp
            (coordinateTripleWavePhase p q t ‖s • x‖ (s * r) (s * r')) u‖ ≤
        C / s ^ (d - 1) *
          (1 + s * |r - r'|) ^ (-q4StationaryExponent d) := by
  obtain ⟨Csmall, hCsmall, hsmall⟩ :=
    exists_coordinateTripleWaveIntegral_crude_bound hd phi hphiOne hphiZero hphiRadial p q t
  obtain ⟨Couter, hCouter, houter⟩ :=
    exists_outer_coordinateTripleWaveIntegral_bound hd phi hphiOne hphiZero hphiRadial p q t
  by_cases hmiddle : q = .middle ∨ t = .middle
  · obtain ⟨Cmiddle, hCmiddle, hmiddleBound⟩ :=
      exists_oneMiddle_coordinateTripleWaveIntegral_bound (L := 2 * d) hd
        phi hphiOne hphiZero hphiRadial p q t hmiddle
    let C : Real := Csmall * (5 : Real) ^ d + Couter * (8 : Real) ^ d +
      Cmiddle * (3 : Real) ^ d
    have hCnonneg : 0 ≤ C := by
      dsimp [C]
      positivity
    refine ⟨C + 1, by linarith, ?_⟩
    intro s r r' hs hr hr' v x hv
    let g : Real := |r - r'|
    let T : Real := s * g
    let y : Euclidean d := s • x
    have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
    have hg : 0 ≤ g := abs_nonneg _
    have hgupper : g ≤ 2 := by
      dsimp [g]
      apply (abs_le).2
      constructor <;> linarith [hr.1, hr.2, hr'.1, hr'.2]
    have hT : 0 ≤ T := by dsimp [T]; positivity
    have hTscale : T ≤ 2 * s := by
      dsimp [T]
      calc
        s * g ≤ s * 2 := mul_le_mul_of_nonneg_left hgupper (zero_le_one.trans hs)
        _ = 2 * s := by ring
    have hyNorm : ‖y‖ = s * ‖x‖ := by
      dsimp [y]
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
    by_cases hsmallGap : T ≤ 4
    · have hcrude := hsmall s r r' hs hr hr' v y hv
      have hnum := q4_crude_scale_le_stationaryWeight (d := d)
        (C := Csmall) (by omega) hs hCsmall.le hT hsmallGap
      calc
        ‖∫ u in (1 : Real)..4,
            coordinateTripleWaveCoefficient
              (absoluteDyadicBandpass phi hphiOne hphiZero 0)
              (s * r) (s * r') v y p q t u *
              oscillatoryExp
                (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
            Csmall / s ^ (d - 1) := hcrude
        _ ≤ (Csmall * (5 : Real) ^ d) / s ^ (d - 1) *
            (1 + T) ^ (-q4StationaryExponent d) := hnum
        _ ≤ (C + 1) / s ^ (d - 1) *
            (1 + T) ^ (-q4StationaryExponent d) := by
          apply q4_scaleWeight_mono hs hT
          dsimp [C]
          nlinarith [pow_pos (show (0 : Real) < 5 by norm_num) d,
            pow_pos (show (0 : Real) < 8 by norm_num) d,
            pow_pos (show (0 : Real) < 3 by norm_num) d]
    · have hlarge : 4 < T := lt_of_not_ge hsmallGap
      have hTone : 1 ≤ T := by linarith
      by_cases hphysical : g / 4 ≤ ‖x‖
      · have hyOuter : T / 4 ≤ ‖y‖ := by
          rw [hyNorm]
          dsimp [T]
          calc
            s * g / 4 = s * (g / 4) := by ring
            _ ≤ s * ‖x‖ := mul_le_mul_of_nonneg_left hphysical (zero_le_one.trans hs)
        have hyOne : 1 ≤ ‖y‖ := by
          calc
            (1 : Real) ≤ T / 4 := by linarith
            _ ≤ ‖y‖ := hyOuter
        have hphysicalBound := houter s r r' hs hr hr' v y hv hyOne
        have hnum := q4_outer_scale_le_stationaryWeight (d := d)
          (C := Couter) (by omega) hs hCouter.le hTone hyOuter
        calc
          ‖∫ u in (1 : Real)..4,
              coordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Couter / (s ^ (d - 1) * (Real.sqrt ‖y‖) ^ (d - 1)) :=
            hphysicalBound
          _ ≤ (Couter * (8 : Real) ^ d) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := hnum
          _ ≤ (C + 1) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := by
            apply q4_scaleWeight_mono hs hT
            dsimp [C]
            nlinarith [pow_pos (show (0 : Real) < 5 by norm_num) d,
              pow_pos (show (0 : Real) < 8 by norm_num) d,
              pow_pos (show (0 : Real) < 3 by norm_num) d]
      · have hinner : ‖x‖ ≤ g / 4 := le_of_lt (lt_of_not_ge hphysical)
        have hmiddleBound' := hmiddleBound s r r' hs hr hr' v y hv
        have hnum := q4_middle_scale_le_stationaryWeight (d := d)
          (C := Cmiddle) (by omega) hs hCmiddle.le hT hTscale
        calc
          ‖∫ u in (1 : Real)..4,
              coordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y p q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase p q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Cmiddle / (s ^ (2 * d) * (Real.sqrt s) ^ (d - 1)) :=
            hmiddleBound'
          _ ≤ (Cmiddle * (3 : Real) ^ d) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := hnum
          _ ≤ (C + 1) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := by
            apply q4_scaleWeight_mono hs hT
            dsimp [C]
            nlinarith [pow_pos (show (0 : Real) < 5 by norm_num) d,
              pow_pos (show (0 : Real) < 8 by norm_num) d,
              pow_pos (show (0 : Real) < 3 by norm_num) d]
  · have hq : q ≠ .middle := by
      intro hq
      exact hmiddle (Or.inl hq)
    have ht : t ≠ .middle := by
      intro ht
      exact hmiddle (Or.inr ht)
    by_cases hp : p = .middle
    · subst p
      obtain ⟨Cinner, hCinner, hinnerBound⟩ :=
        exists_inner_physicalMiddle_coordinateTripleWaveIntegral_bound hd
          phi hphiOne hphiZero hphiRadial q t hq ht
      let C : Real := Csmall * (5 : Real) ^ d + Couter * (8 : Real) ^ d +
        ((8 - (1 / 2 : Real)) * Cinner * (8 : Real) ^ d)
      have hCnonneg : 0 ≤ C := by
        dsimp [C]
        positivity
      refine ⟨C + 1, by linarith, ?_⟩
      intro s r r' hs hr hr' v x hv
      let g : Real := |r - r'|
      let T : Real := s * g
      let y : Euclidean d := s • x
      have hspos : 0 < s := lt_of_lt_of_le zero_lt_one hs
      have hg : 0 ≤ g := abs_nonneg _
      have hT : 0 ≤ T := by dsimp [T]; positivity
      have hyNorm : ‖y‖ = s * ‖x‖ := by
        dsimp [y]
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos hspos]
      by_cases hsmallGap : T ≤ 4
      · have hcrude := hsmall s r r' hs hr hr' v y hv
        have hnum := q4_crude_scale_le_stationaryWeight (d := d)
          (C := Csmall) (by omega) hs hCsmall.le hT hsmallGap
        calc
          ‖∫ u in (1 : Real)..4,
              coordinateTripleWaveCoefficient
                (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                (s * r) (s * r') v y .middle q t u *
                oscillatoryExp
                  (coordinateTripleWavePhase .middle q t ‖y‖ (s * r) (s * r')) u‖ ≤
              Csmall / s ^ (d - 1) := hcrude
          _ ≤ (Csmall * (5 : Real) ^ d) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := hnum
          _ ≤ (C + 1) / s ^ (d - 1) *
              (1 + T) ^ (-q4StationaryExponent d) := by
            apply q4_scaleWeight_mono hs hT
            dsimp [C]
            nlinarith [pow_pos (show (0 : Real) < 5 by norm_num) d,
              pow_pos (show (0 : Real) < 8 by norm_num) d,
              pow_pos (show (0 : Real) < 3 by norm_num) d]
      · have hlarge : 4 < T := lt_of_not_ge hsmallGap
        have hTone : 1 ≤ T := by linarith
        by_cases hphysical : g / 4 ≤ ‖x‖
        · have hyOuter : T / 4 ≤ ‖y‖ := by
            rw [hyNorm]
            dsimp [T]
            calc
              s * g / 4 = s * (g / 4) := by ring
              _ ≤ s * ‖x‖ := mul_le_mul_of_nonneg_left hphysical (zero_le_one.trans hs)
          have hyOne : 1 ≤ ‖y‖ := by linarith
          have hphysicalBound := houter s r r' hs hr hr' v y hv hyOne
          have hnum := q4_outer_scale_le_stationaryWeight (d := d)
            (C := Couter) (by omega) hs hCouter.le hTone hyOuter
          calc
            ‖∫ u in (1 : Real)..4,
                coordinateTripleWaveCoefficient
                  (absoluteDyadicBandpass phi hphiOne hphiZero 0)
                  (s * r) (s * r') v y .middle q t u *
                  oscillatoryExp
                    (coordinateTripleWavePhase .middle q t ‖y‖ (s * r) (s * r')) u‖ ≤
                Couter / (s ^ (d - 1) * (Real.sqrt ‖y‖) ^ (d - 1)) :=
              hphysicalBound
            _ ≤ (Couter * (8 : Real) ^ d) / s ^ (d - 1) *
                (1 + T) ^ (-q4StationaryExponent d) := hnum
            _ ≤ (C + 1) / s ^ (d - 1) *
                (1 + T) ^ (-q4StationaryExponent d) := by
              apply q4_scaleWeight_mono hs hT
              dsimp [C]
              nlinarith [pow_pos (show (0 : Real) < 5 by norm_num) d,
                pow_pos (show (0 : Real) < 8 by norm_num) d,
                pow_pos (show (0 : Real) < 3 by norm_num) d]
        · have hinner : ‖x‖ ≤ g / 4 := le_of_lt (lt_of_not_ge hphysical)
          have hIBP := hinnerBound s r r' hs hr hr'
            (by
              intro hrr
              have hzero : g = 0 := by
                dsimp [g]
                exact abs_eq_zero.mpr (sub_eq_zero.mpr hrr)
              dsimp [T] at hlarge
              rw [hzero, mul_zero] at hlarge
