      ∀ v x : Euclidean d, ‖v‖ = 1 → ‖x‖ ≤ |r - r'| / 4 →
      ‖∫ u in (1 : Real)..4,
        coordinateRadiusDerivativeTripleWaveCoefficient
          (absoluteDyadicBandpass phi hphiOne hphiZero 0)
