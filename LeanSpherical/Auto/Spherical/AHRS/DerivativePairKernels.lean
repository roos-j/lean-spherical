    unfold coordinateWaveRadiusDerivativeMultiplierPairAmplitude
    simp only [norm_mul, starRingEnd_apply, norm_star]
    change M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u‖ *
        (M * ‖coordinateWaveRadiusDerivativeAmplitude d t (s * r') u‖) ≤ _
    calc
      M * ‖coordinateWaveRadiusDerivativeAmplitude d .middle (s * r) u‖ *
          (M * ‖coordinateWaveRadiusDerivativeAmplitude d t (s * r') u‖) ≤
          M * (A / s ^ L) *
            (M * (B / (Real.sqrt s) ^ (d - 1))) := by
        gcongr
      _ = (M ^ 2 * A * B) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        field_simp [hspos.ne', hQpos.ne']
      _ ≤ (M ^ 2 * A * B + 1) /
          (s ^ L * (Real.sqrt s) ^ (d - 1)) := by
        apply div_le_div_of_nonneg_right
        · linarith
        · positivity
  · subst t
    obtain ⟨A, hA, hAbound⟩ :=
      exists_coordinateWaveRadiusDerivativeAmplitude_middle_scaled_power (d := d) L
    obtain ⟨B, hB, hBbound⟩ :=
      exists_uniform_coordinateWaveRadiusDerivativeAmplitude_scaled (d := d) (N := 0) hd q
    let M : Real := ‖(surfaceMass d : Complex)⁻¹‖
