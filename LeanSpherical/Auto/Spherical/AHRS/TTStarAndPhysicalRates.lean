        dsimp only [A, q4ActiveDyadicPositiveGapKernelConstant]
        have hpow : 0 < (2 : Real) ^ j := pow_pos (by norm_num) _
        have hbase : 0 < (2 : Real) ^ (n - 1 : Nat) := pow_pos (by norm_num) _
        exact mul_pos (mul_pos hCkernel hpow) (Real.rpow_pos_of_pos hbase _)
      have hkernel : forall i l z,
          q4LevelShellRelation R level n i l -> ‖K i l z‖ <= A := by
        intro i l z hlevel
        have hactive := hlevel.1
        rw [show K i l z =
            q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u i l z by
          exact q4ActiveDyadicScaledNormalizedDerivativeRestrictedPairKernel_eq_of_mem
            psi j u hactive.1 hactive.2 z]
        simpa only [A, q4ActiveDyadicPositiveGapKernelConstant, R, level,
          q4LevelShellRelation, if_neg hnzero] using hstationary n i l z hlevel
      change eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (q4LevelShellRelation R level n) K g z‖)
        (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <= _
      simpa only [hHB, A, D, q4ActiveDyadicLevelStrongConstant, eLpNorm_norm, if_neg hnzero,
        q4ActiveDyadicPositiveGapStrongConstant,
        q4ActiveDyadicPositiveGapSquareConstant] using
        q4ActiveDyadicProductLevel_strong_of_literal_endpoints
          (q4LevelShellRelation R level n)
          (q4ActiveDyadicProductLevel_symm E j n) D hD hdegree
          K A hA hkernel H hp1 hp2 hq g (hdomain n) hgp hI0 hI0pos
  calc
    eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) g z‖)
