  unfold q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
  apply measurable_q4FibresToFiniteProduct_of_continuous
  intro i
  exact (q4PowerDualField_mem_Q4PhysicalDualCarrier q hq
    (fun k => q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
      psi hpsiCompact j (dyadicLeft j k + u) f) i).2.2.1

/-- The canonical derivative dual product is integrable on the literal
physical-times-counting product. -/
theorem integrable_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
