/-- Homogeneous form of the literal scaled-derivative full-product estimate.
The underlying crossed decomposition is stated for a positive input moment.
When that moment is zero, the actual finite convolution shell is identically
zero by `q4FiniteProductKernelShell_eq_zero_of_integral_norm_rpow_eq_zero`.
Thus no artificial nonvanishing hypothesis remains in the interface consumed
by the radius-variation argument. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeFullProductPairShell_eLpNorm_le_levelSum_of_active_multiplier_homogeneous
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real} {j : Nat}
    (hd : 1 <= d) (hj : 1 <= j)
    (hE : E ⊆ Icc (1 : Real) 2)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma)
    (hdeltaone : dyadicScale j < 1)
    (u : Real) (hu : u ∈ Icc (0 : Real) (dyadicScale j))
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    {Ckernel B : Real} (hCkernel : 0 < Ckernel)
    {psiFam : Nat -> SchwartzMap (Euclidean d) Complex}
    (hdecay : HasQ4ScaledNormalizedDyadicSurfaceRadiusDerivativePairKernelGapDecayOn
      d psiFam (1 / 2 : Real) (5 / 2) Ckernel)
    (hpsiFam : psi = psiFam j)
    (hB : 0 <= B)
    (hmultiplier : ∀ i ∈ activeDyadicIndices E j,
      ∀ l ∈ activeDyadicIndices E j, forall xi : Euclidean d,
        ‖q4ActiveDyadicScaledNormalizedDerivativePairMultiplier
          psi hpsiCompact j u i l xi‖ <= B)
    {p q I0 : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1))
    (g : Euclidean d × {i // i ∈ activeDyadicIndices E j} -> Complex)
    (hgmeas : Measurable g)
    (hgint : Integrable g (q4ActiveDyadicProductCountingMeasure d E j))
    (hgsq : Integrable (fun z => ‖g z‖ ^ (2 : Nat))
      (q4ActiveDyadicProductCountingMeasure d E j))
    (hfib : ∀ i ∈ activeDyadicIndices E j,
      Integrable (q4FiniteProductToFibres (activeDyadicIndices E j) g i) volume /\
        MemLp (q4FiniteProductToFibres (activeDyadicIndices E j) g i) 2 volume)
    (hgp : Integrable (fun z => ‖g z‖ ^ p)
      (q4ActiveDyadicProductCountingMeasure d E j))
    (hI0 : I0 = ∫ z, ‖g z‖ ^ p ∂q4ActiveDyadicProductCountingMeasure d E j) :
    eLpNorm (fun z => ‖q4FiniteProductKernelShell volume
      (activeDyadicIndices E j) (fun _ _ => True)
      (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) g z‖)
      (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) <=
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Ckernel B j n q) *
          eLpNorm g (ENNReal.ofReal p) (q4ActiveDyadicProductCountingMeasure d E j) := by
  by_cases hI0pos : 0 < I0
  · exact
      q4ActiveDyadicScaledNormalizedDerivativeFullProductPairShell_eLpNorm_le_levelSum_of_active_multiplier
        hd hj hE hcover hCcover hgamma hdeltaone u hu psi hpsiCompact hCkernel hdecay hpsiFam hB
        hmultiplier hp1 hp2 hq g hgmeas hgint hgsq hfib hgp hI0 hI0pos
  · have hI0nonneg : 0 <= I0 := by
      rw [hI0]
      exact integral_nonneg fun z => Real.rpow_nonneg (norm_nonneg (g z)) _
    have hI0zero : I0 = 0 := le_antisymm (le_of_not_gt hI0pos) hI0nonneg
    have hzero : (∫ z, ‖g z‖ ^ p ∂q4ActiveDyadicProductCountingMeasure d E j) = 0 :=
      hI0.symm.trans hI0zero
    have hshellzero : q4FiniteProductKernelShell volume
        (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) g = 0 := by
      exact q4FiniteProductKernelShell_eq_zero_of_integral_norm_rpow_eq_zero
        volume (activeDyadicIndices E j) (fun _ _ => True)
        (q4ActiveDyadicScaledNormalizedDerivativePairKernel psi j u) g (by linarith) hgp hzero
    rw [hshellzero]
    simp

/-! ### Canonical dual-product regularity

The finite-product argument is applied only to the canonical norming field of
the actual derivative analysis outputs.  The following definitions and
lemmas discharge all of the physical product regularity from Schwartz data;
they are deliberately separate from the shell estimate so a later selected
variation theorem has no hidden membership premise. -/

/-- The actual shifted scaled-derivative analysis family on the Schwartz
core, written as ordinary functions so it can be inserted into the literal
counting product. -/
noncomputable def q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (u : Real) (f : SchwartzMap (Euclidean d) Complex) :
    Int -> Euclidean d -> Complex :=
  fun i =>
    (q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
      psi hpsiCompact j (dyadicLeft j i + u) f : Euclidean d -> Complex)

/-- Pointwise form of the literal derivative analysis family. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField_eq
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (u : Real) (f : SchwartzMap (Euclidean d) Complex) :
    q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
        psi hpsiCompact j u f =
      fun k : Int =>
        ((q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece
          psi hpsiCompact j (dyadicLeft j k + u) f :
          SchwartzMap (Euclidean d) Complex) : Euclidean d -> Complex) := rfl

/-- The Schwartz analysis family is pointwise the literal scaled derivative
which appears in the FTOC correction. -/
theorem q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField_apply
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (u : Real) (f : SchwartzMap (Euclidean d) Complex)
    (i : Int) (x : Euclidean d) :
    q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
      psi hpsiCompact j u f i x =
      q4ScaledNormalizedDyadicSurfaceRadiusDerivative psi f j (dyadicLeft j i + u) x := by
  simpa only [q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField] using
    q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzPiece_apply_eq
      psi hpsiCompact j (dyadicLeft j i + u) f x

/-- The literal physical-times-counting product used to test the derivative
analysis family by its canonical `L^q` power dual. -/
noncomputable def q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (f : SchwartzMap (Euclidean d) Complex) :
    Euclidean d × {i // i ∈ activeDyadicIndices E j} -> Complex :=
  q4FibresToFiniteProduct (activeDyadicIndices E j)
    (q4PowerDualField q
      (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
        psi hpsiCompact j u f))

/-- On an active fibre, the physical dual product is exactly the canonical
power dual of the corresponding actual derivative output. -/
theorem q4FiniteProductToFibres_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (f : SchwartzMap (Euclidean d) Complex)
    (i : Int) (hi : i ∈ activeDyadicIndices E j) :
    q4FiniteProductToFibres (activeDyadicIndices E j)
      (q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
        E j psi hpsiCompact u q f) i =
      q4PowerDualField q
        (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
          psi hpsiCompact j u f) i := by
  funext x
  exact q4FiniteProductToFibres_q4FibresToFiniteProduct_apply
    (activeDyadicIndices E j)
    (q4PowerDualField q
      (q4ActiveDyadicScaledNormalizedDerivativeSchwartzAnalysisField
        psi hpsiCompact j u f)) i hi x

/-- Measurability of the actual canonical dual product follows from the
continuous Schwartz power-dual fibres. -/
theorem measurable_q4ActiveDyadicScaledNormalizedDerivativePowerDualProductField
    {d : Nat} (E : Set Real) (j : Nat)
    (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (u q : Real) (hq : 2 <= q) (f : SchwartzMap (Euclidean d) Complex) :
