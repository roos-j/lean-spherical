          (ENNReal.ofReal q) (q4ActiveDyadicProductCountingMeasure d E j) := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      rw [q4FiniteProductKernelShell_full_eq_activeDyadicRelation E j volume K g z]
