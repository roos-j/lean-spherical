        dsimp only [delta]
        rw [mul_inv_rev]
      _ ≤ R⁻¹ * 1 := by
        apply mul_le_mul_of_nonneg_left
        · norm_num
        · exact inv_nonneg.mpr hR.le
      _ = R⁻¹ := by ring
  obtain ⟨cover, hcover, hcard, -⟩ := hCovers delta hdelta hdeltaone
  have hdeltascale : Ccover * delta ^ (-a) = D * R ^ a := by
    dsimp only [delta, D]
    rw [inv_rpow_neg_eq_rpow, Real.mul_rpow (by norm_num) hR.le]
    ring
  have hendpoints : ∀ g : SchwartzMap (Euclidean (n + 1)) Complex,
      MemLp (unnormalizedFractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g) 1 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) g x‖) ≤
        (Ccover * delta ^ (-a)) * B1 * ∫ x, ‖g x‖ ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) g) 2 volume ∧
      (∫ x : Euclidean (n + 1),
        ‖unnormalizedFractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) g x‖ ^ (2 : Nat)) ≤
        (Ccover * delta ^ (-a)) * (B2 * R ^ (-(n : Real))) *
          ∫ x, ‖g x‖ ^ (2 : Nat) := by
    intro g
    have hendpoint := absolute_dyadic_minkowski_endpoints_of_cover
      hn C0 C1 hC0 hC1 hdecay hderiv hE hEne hR hRone hdelta hdeltaone hdeltaR
      cover hcover (by simpa only [a] using hcard)
      phi g psi (absoluteDyadicBandpass phi hphiOne hphiZero j)
      hphiOne hphiZero hphiNorm j
      (absoluteDyadicBandpass_spec phi hphiOne hphiZero j)
      (absoluteDyadicBandpass_compact phi hphiOne hphiZero j)
      (by rfl) (by
        intro xi
        simpa only [R, Auto.Spherical.SurfaceMeasureDecay.dyadicScale] using
          smooth_dyadic_bandpass_eq_scaled_base phi psi
            (absoluteDyadicBandpass phi hphiOne hphiZero j) hpsi j
            (absoluteDyadicBandpass_spec phi hphiOne hphiZero j) xi)
    simpa only [B1, B2] using hendpoint
  have hpiece := normalized_absolute_minkowski_moment_of_cover_endpoints
    (n := n) (E := E) (R := R) (δ := delta) (α := a) (C := Ccover) (D := D)
    (B₁ := B1) (B₂ := B2) (p := p)
    hn hR ha hD hB1 hB2 hp1 hp2 hdeltascale
    (absoluteDyadicBandpass phi hphiOne hphiZero j) hEpos hendpoints f
  have hpiece' :
      MemLp (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean (n + 1),
        (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f x) ^ p) ≤
        P * R ^ (a + n - n * p) * ∫ x, ‖f x‖ ^ p := by
    simpa only [a1, a2, P] using hpiece
  have hRpow : R ^ (a + n - n * p) =
      (2 : Real) ^ (-kappa * (j : Real)) := by
    rw [he]
    dsimp only [R, Auto.Spherical.SurfaceMeasureDecay.dyadicScale]
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
    congr 1
    ring
  have hmoment :
      (∫ x : Euclidean (n + 1),
        (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f x) ^ p) ≤
        A * (2 : Real) ^ (-kappa * j) * ∫ x, ‖f x‖ ^ p := by
    have hI : 0 ≤ ∫ x : Euclidean (n + 1), ‖f x‖ ^ p :=
      integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _
    calc
      (∫ x : Euclidean (n + 1),
        (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f x) ^ p) ≤
          P * R ^ (a + n - n * p) * ∫ x, ‖f x‖ ^ p := hpiece'.2
      _ = P * (2 : Real) ^ (-kappa * j) * ∫ x, ‖f x‖ ^ p := by rw [hRpow]
      _ ≤ A * (2 : Real) ^ (-kappa * j) * ∫ x, ‖f x‖ ^ p := by
        apply mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_right hP_le_A
            (Real.rpow_nonneg (by norm_num) _)) hI
  refine ⟨hpiece'.1, ?_⟩
  have hnorm := absolute_eLpNorm_le_of_bandpass_real_moment_bound
    (d := n + 1) (p := p) (A := A) (ε := kappa)
    (I := ∫ x : Euclidean (n + 1), ‖f x‖ ^ p)
    hp0 _ hpiece'.1
    (fun x => fractalDyadicBandpassMaximal_nonneg E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f x)
    hA.le (integral_nonneg fun _ => Real.rpow_nonneg (norm_nonneg _) _) j hmoment
  have hinput := eLpNorm_schwartz_eq_sameOutputInputScale
    (d := n + 1) (p := p) (I := ∫ x : Euclidean (n + 1), ‖f x‖ ^ p)
    hp0 f rfl
  rw [hinput]
  calc
    eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
      (ENNReal.ofReal p) volume ≤
        (ENNReal.ofReal (A ^ p⁻¹) *
          ENNReal.ofReal ((∫ x : Euclidean (n + 1), ‖f x‖ ^ p) ^ p⁻¹)) *
          ENNReal.ofReal ((2 : Real) ^ (-kappa / p)) ^ j := hnorm
    _ = C * rho ^ j *
          ENNReal.ofReal ((∫ x : Euclidean (n + 1), ‖f x‖ ^ p) ^ p⁻¹) := by
      dsimp only [C, rho]
      ring

/-- The half-gap specialization of the quantitative Q2 estimate.  It is a
convenient default for diagonal-only applications; the T123 physical branch
uses the preceding loss-parametrized version instead. -/
theorem q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent_with_ratio
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {alpha p : Real} (halpha : 0 ≤ alpha)
    (hM : HasUpperMinkowskiExponent E alpha)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : alpha < n * (p - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi)) :
    ∃ C rho : ENNReal, 0 < C ∧ C < ∞ ∧ 0 < rho ∧ rho < 1 ∧
      rho = ENNReal.ofReal (q2PhysicalMinkowskiRatio n alpha p) ∧
      ∀ j : Nat, ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ≤
          C * rho ^ j *
            eLpNorm (f : Euclidean (n + 1) → Complex)
              (ENNReal.ofReal p) volume := by
  let eta : Real := (n * (p - 1) - alpha) / 2
  have heta : 0 < eta := by
    dsimp only [eta]
    linarith
  have hcritical' : alpha + eta < n * (p - 1) := by
    dsimp only [eta]
    linarith
  obtain ⟨C, rho, hC, hCtop, hrho, hrho_lt, hratio, hbound⟩ :=
    q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent_with_loss_and_ratio
      hn hE hEne halpha hM hp1 hp2 heta hcritical'
      phi psi hphiOne hphiZero hphiNorm hpsi
  refine ⟨C, rho, hC, hCtop, hrho, hrho_lt, ?_, hbound⟩
  calc
    rho = ENNReal.ofReal (q2PhysicalMinkowskiRatioWithLoss n alpha eta p) := hratio
    _ = ENNReal.ofReal (q2PhysicalMinkowskiRatio n alpha p) := by
      congr 1
      unfold q2PhysicalMinkowskiRatioWithLoss q2PhysicalMinkowskiRatio
      congr 1
      unfold q2PhysicalMinkowskiKappaWithLoss q2PhysicalMinkowskiKappa
      dsimp only [eta]
      ring

/-- The compatibility form of the literal higher-dimensional strict `Q₂`
estimate.  The quantitative version above is used by the physical crossed
argument; this wrapper preserves the earlier public interface used by the
diagonal and top-endpoint files. -/
theorem q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {alpha p : Real} (halpha : 0 ≤ alpha)
    (hM : HasUpperMinkowskiExponent E alpha)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : alpha < n * (p - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi)) :
    ∃ C rho : ENNReal, 0 < C ∧ C < ∞ ∧ 0 < rho ∧ rho < 1 ∧
      ∀ j : Nat, ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ≤
          C * rho ^ j *
            eLpNorm (f : Euclidean (n + 1) → Complex)
              (ENNReal.ofReal p) volume := by
  obtain ⟨C, rho, hC, hCtop, hrho, hrho_lt, -, hbound⟩ :=
    q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent_with_ratio
      hn hE hEne halpha hM hp1 hp2 hcritical
      phi psi hphiOne hphiZero hphiNorm hpsi
  exact ⟨C, rho, hC, hCtop, hrho, hrho_lt, hbound⟩

/-- Replace equality of upper Minkowski dimension by one admissible
covering exponent while retaining a literal shared-cutoff Q2 rate. -/
theorem q2_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta p : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hcritical : beta < n * (p - 1))
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi)) :
    ∃ C rho : ENNReal, 0 < C ∧ C < ∞ ∧ 0 < rho ∧ rho < 1 ∧
      ∀ j : Nat, ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal p) volume ≤
          C * rho ^ j *
            eLpNorm (f : Euclidean (n + 1) → Complex)
              (ENNReal.ofReal p) volume := by
  let eps : Real := (n * (p - 1) - beta) / 2
  have heps : 0 < eps := by
    dsimp only [eps]
    linarith
  have hM : HasUpperMinkowskiExponent E (beta + eps) :=
    hasUpperMinkowskiExponent_add_of_upperMinkowskiDimension_eq
      hE hMinkowski heps
  have halpha : 0 ≤ beta + eps := add_nonneg hbeta heps.le
  have hcritical' : beta + eps < n * (p - 1) := by
    dsimp only [eps]
    linarith
  exact q2_physical_strict_normalized_dyadic_rate_of_hasUpperMinkowskiExponent
    hn hE hEne halpha hM hp1 hp2 hcritical'
    phi psi hphiOne hphiZero hphiNorm hpsi

/-- The scale-independent part of the diagonal-to-top upgrade. -/
def q2TopDyadicRateConstant (r s c L : Real) : Real :=
  (s * (2 : Real) ^ r * c ^ r *
      ((s - r)⁻¹ * (4 : Real) ^ (s - r)) * L ^ (s - r)) ^ s⁻¹

/-- The geometric ratio after the diagonal-to-top upgrade. -/
def q2TopDyadicRateRatio (r s rho : Real) : Real := rho ^ (r / s)

theorem q2TopDyadicRateConstant_pos
    {r s c L : Real} (hr : 0 < r) (hrs : r < s)
    (hc : 0 < c) (hL : 0 < L) :
    0 < q2TopDyadicRateConstant r s c L := by
  have hs : 0 < s := lt_trans hr hrs
  have hdiff : 0 < s - r := sub_pos.mpr hrs
  have htwo : 0 < (2 : Real) ^ r := Real.rpow_pos_of_pos (by norm_num) _
  have hc' : 0 < c ^ r := Real.rpow_pos_of_pos hc _
  have htail : 0 < (s - r)⁻¹ * (4 : Real) ^ (s - r) :=
    mul_pos (inv_pos.mpr hdiff) (Real.rpow_pos_of_pos (by norm_num) _)
  have hL' : 0 < L ^ (s - r) := Real.rpow_pos_of_pos hL _
  unfold q2TopDyadicRateConstant
  exact Real.rpow_pos_of_pos
    (mul_pos (mul_pos (mul_pos (mul_pos hs htwo) hc') htail) hL') _

theorem q2TopDyadicRateRatio_mem_Ioo
    {r s rho : Real} (hr : 0 < r) (hrs : r < s)
    (hrho : 0 < rho) (hrhoOne : rho < 1) :
    q2TopDyadicRateRatio r s rho ∈ Ioo 0 1 := by
  have hs : 0 < s := lt_trans hr hrs
  have hratio : 0 < r / s := div_pos hr hs
  constructor
  · unfold q2TopDyadicRateRatio
    exact Real.rpow_pos_of_pos hrho _
  · unfold q2TopDyadicRateRatio
    exact Real.rpow_lt_one hrho.le hrhoOne hratio

/-- The scalar identity which preserves a geometric rate through the
fixed-frequency diagonal-to-top interpolation. -/
theorem q2TopDyadicRateCoefficient_eq
    {r s c rho L : Real} (hr : 0 < r) (hrs : r < s)
    (hc : 0 < c) (hrho : 0 < rho) (hL : 0 < L) (j : Nat) :
    (s * (2 : Real) ^ r * (c * rho ^ j) ^ r *
        ((s - r)⁻¹ * (4 : Real) ^ (s - r)) * L ^ (s - r)) ^ s⁻¹ =
      q2TopDyadicRateConstant r s c L *
        q2TopDyadicRateRatio r s rho ^ j := by
  have hs : 0 < s := lt_trans hr hrs
  have hdiff : 0 < s - r := sub_pos.mpr hrs
  let K : Real := s * (2 : Real) ^ r * c ^ r *
    ((s - r)⁻¹ * (4 : Real) ^ (s - r)) * L ^ (s - r)
  have htwo : 0 < (2 : Real) ^ r := Real.rpow_pos_of_pos (by norm_num) _
  have hc' : 0 < c ^ r := Real.rpow_pos_of_pos hc _
  have htail : 0 < (s - r)⁻¹ * (4 : Real) ^ (s - r) :=
    mul_pos (inv_pos.mpr hdiff) (Real.rpow_pos_of_pos (by norm_num) _)
  have hL' : 0 < L ^ (s - r) := Real.rpow_pos_of_pos hL _
  have hK : 0 < K := by
    dsimp only [K]
    exact mul_pos (mul_pos (mul_pos (mul_pos hs htwo) hc') htail) hL'
  have hpow : (rho ^ j) ^ r = rho ^ ((j : Real) * r) := by
    calc
      (rho ^ j) ^ r = (rho ^ (j : Real)) ^ r := by
        rw [Real.rpow_natCast]
      _ = rho ^ ((j : Real) * r) := by
        rw [← Real.rpow_mul hrho.le]
  have hfactor :
      s * (2 : Real) ^ r * (c * rho ^ j) ^ r *
          ((s - r)⁻¹ * (4 : Real) ^ (s - r)) * L ^ (s - r) =
        K * rho ^ ((j : Real) * r) := by
    rw [Real.mul_rpow hc.le (pow_nonneg hrho.le j), hpow]
    dsimp only [K]
    ring
  have hexp : ((j : Real) * r) * s⁻¹ = (r / s) * (j : Real) := by
    field_simp [hs.ne']
  calc
    (s * (2 : Real) ^ r * (c * rho ^ j) ^ r *
        ((s - r)⁻¹ * (4 : Real) ^ (s - r)) * L ^ (s - r)) ^ s⁻¹ =
        (K * rho ^ ((j : Real) * r)) ^ s⁻¹ := by rw [hfactor]
    _ = K ^ s⁻¹ * (rho ^ ((j : Real) * r)) ^ s⁻¹ := by
      rw [Real.mul_rpow hK.le (Real.rpow_nonneg hrho.le _)]
    _ = K ^ s⁻¹ * rho ^ (((j : Real) * r) * s⁻¹) := by
      rw [← Real.rpow_mul hrho.le]
    _ = K ^ s⁻¹ * rho ^ ((r / s) * (j : Real)) := by rw [hexp]
    _ = K ^ s⁻¹ * (rho ^ (r / s)) ^ j := by
      rw [Real.rpow_mul_natCast hrho.le]
    _ = q2TopDyadicRateConstant r s c L *
        q2TopDyadicRateRatio r s rho ^ j := by
      rfl

/-- Upgrade a real-valued strict diagonal dyadic rate by the literal physical
`L∞` endpoint of the same absolute multiplier. -/
theorem literal_absolute_dyadic_top_rate_of_real_diagonal_rate
    {d : Nat} (hd : 0 < d) (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    {r s c rho : Real} (hr : 0 < r) (hrs : r < s)
    (hc : 0 < c) (hrho : 0 < rho) (hrhoOne : rho < 1)
    (hsource : ∀ j : Nat, ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal r) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal (c * rho ^ j) *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal r) volume) :
    ∃ C R : ENNReal, 0 < C ∧ C < ⊤ ∧ 0 < R ∧ R < 1 ∧
      ∀ j : Nat, ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal s) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal s) volume ≤
          C * R ^ j *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal s) volume := by
  let L : Real := absoluteDyadicBandpassLInfinityConstant phi hphiOne hphiZero + 1
  have hK : 0 ≤ absoluteDyadicBandpassLInfinityConstant phi hphiOne hphiZero :=
    absoluteDyadicBandpassLInfinityConstant_nonneg phi hphiOne hphiZero
  have hL : 0 < L := by
    dsimp only [L]
    linarith
  let C : ENNReal := ENNReal.ofReal (q2TopDyadicRateConstant r s c L)
  let R : ENNReal := ENNReal.ofReal (q2TopDyadicRateRatio r s rho)
  have hCreal : 0 < q2TopDyadicRateConstant r s c L :=
    q2TopDyadicRateConstant_pos hr hrs hc hL
  have hRreal := q2TopDyadicRateRatio_mem_Ioo hr hrs hrho hrhoOne
  have hC : 0 < C := ENNReal.ofReal_pos.mpr hCreal
  have hCtop : C < ⊤ := ENNReal.ofReal_lt_top
  have hR : 0 < R := ENNReal.ofReal_pos.mpr hRreal.1
  have hRone : R < 1 := ENNReal.ofReal_lt_one.mpr hRreal.2
  refine ⟨C, R, hC, hCtop, hR, hRone, ?_⟩
  intro j f
  let T : SchwartzMap (Euclidean d) Complex → Euclidean d → Real :=
    fun g => fractalDyadicBandpassMaximal d E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g
  have hTmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (T g) volume := by
    intro g
    dsimp only [T]
    exact (measurable_fractalDyadicBandpassMaximal E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g).aestronglyMeasurable
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    dsimp only [T]
    exact fractalDyadicBandpassMaximal_nonneg E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g x
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  have hTsub : ∀ g h : SchwartzMap (Euclidean d) Complex, ∀ x,
      T (g + h) x ≤ T g x + T h x := by
    intro g h x
    dsimp only [T]
    exact fractalDyadicBandpassMaximal_add_le hd E hEpos
      (absoluteDyadicBandpass phi hphiOne hphiZero j) g h x
  have hstrong : ∀ g : SchwartzMap (Euclidean d) Complex,
      MemLp (T g) (ENNReal.ofReal r) volume ∧
      eLpNorm (T g) (ENNReal.ofReal r) volume ≤
        ENNReal.ofReal (c * rho ^ j) *
          eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal r) volume := by
    intro g
    simpa only [T] using hsource j g
  have hcj : 0 < c * rho ^ j := mul_pos hc (pow_pos hrho j)
  have htop : ∀ (g : SchwartzMap (Euclidean d) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ L * a := by
    intro g a ha hga x
    have hbase := fractalDyadicBandpassMaximal_absoluteDyadicBandpass_le_of_uniform_norm
      hd E hE phi hphiOne hphiZero j g hga x
    calc
      T g x ≤ absoluteDyadicBandpassLInfinityConstant phi hphiOne hphiZero * a := by
        simpa only [T] using hbase
      _ ≤ L * a := by
        apply mul_le_mul_of_nonneg_right
          (le_add_of_nonneg_right (by norm_num)) ha
