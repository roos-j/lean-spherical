      ((2 : Real) ^ (a / 2)) ^ j := by
  rw [Real.sqrt_eq_rpow]
  rw [← Real.rpow_mul (by norm_num : (0 : Real) <= 2)]
  rw [← Real.rpow_mul_natCast (by norm_num : (0 : Real) <= 2) (a / 2) j]
  congr 1
  ring

/-- The real frequency ratio obtained after the `TT*` square root is
strictly below one whenever the frequency exponent is negative. -/
theorem q4_sqrt_frequency_ratio_mem_Ioo
    {a : Real} (ha : a < 0) :
    (2 : Real) ^ (a / 2) ∈ Ioo 0 1 := by
  constructor
  · exact Real.rpow_pos_of_pos (by norm_num) _
  · exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)

/-- The scalar coefficient appearing after summing one of the endpoint or
derivative families of Q4 level constants. -/
def q4StrictShellSummationConstant (A b : Real) : Real :=
  A * (1 - (2 : Real) ^ b)⁻¹

theorem q4StrictShellSummationConstant_nonneg
    {A b : Real} (hA : 0 <= A) (hb : b < 0) :
    0 <= q4StrictShellSummationConstant A b := by
  unfold q4StrictShellSummationConstant
  apply mul_nonneg hA
  exact inv_nonneg.mpr (sub_nonneg.mpr
    (le_of_lt (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) hb)))

/-- The `ENNReal`-level form of the preceding finite shell sum bound. -/
theorem q4_finset_sum_toReal_le_strict_normalForm'
    {A a b : Real} (hA : 0 <= A) (hb : b < 0) (j : Nat)
    (L : Nat -> ENNReal)
    (hL : ∀ n : Nat, L n <= ENNReal.ofReal
      (A * (2 : Real) ^ (a * (j : Real) + b * (n : Real)))) :
    (∑ n ∈ Finset.range (j + 3), L n).toReal <=
      q4StrictShellSummationConstant A b *
        (2 : Real) ^ (a * (j : Real)) := by
  have hfin : ∀ n ∈ Finset.range (j + 3), L n ≠ ∞ := fun n _ =>
    ne_of_lt (lt_of_le_of_lt (hL n) ENNReal.ofReal_lt_top)
  rw [ENNReal.toReal_sum hfin]
  simpa only [q4StrictShellSummationConstant] using
    q4_finset_sum_toReal_le_strict_normalForm hA hb j L hL

/-- The finite active-cell shell sum has the displayed dyadic rate whenever
the gap exponent is negative.  The frequency exponent may have either sign:
at the Q4 endpoint the resulting rate is allowed to grow, exactly as in
Corollary 3.2 of the paper.  The strict version below is the special case
whose ratio is less than one. -/
theorem q4ActiveDyadicLtwoRealConstant_le_dyadic_rate_of_negative_gap
    {d : Nat} {gamma eta Ccover : Real}
    {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative a b r : Real}
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (hb : b < 0)
    (hendpoint : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r <=
        ENNReal.ofReal
          (Aendpoint * (2 : Real) ^
            (a * (j : Real) + b * (n : Real))))
    (hderivative : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r <=
        ENNReal.ofReal
          (Aderivative * (2 : Real) ^
            (a * (j : Real) + b * (n : Real))))
    (j : Nat) :
    q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j r <=
      (‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (q4StrictShellSummationConstant Aendpoint b) +
        Real.sqrt (q4StrictShellSummationConstant Aderivative b)) *
        ((2 : Real) ^ (a / 2)) ^ j := by
  let Kendpoint : Real := q4StrictShellSummationConstant Aendpoint b
  let Kderivative : Real := q4StrictShellSummationConstant Aderivative b
  have hKendpoint : 0 <= Kendpoint := by
    dsimp only [Kendpoint]
    exact q4StrictShellSummationConstant_nonneg hAendpoint hb
  have hKderivative : 0 <= Kderivative := by
    dsimp only [Kderivative]
    exact q4StrictShellSummationConstant_nonneg hAderivative hb
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cendpoint Bendpoint j n r).toReal <=
        Kendpoint * (2 : Real) ^ (a * (j : Real)) := by
    dsimp only [Kendpoint]
    exact q4_finset_sum_toReal_le_strict_normalForm' hAendpoint hb j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r) (hendpoint j)
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cderivative Bderivative j n r).toReal <=
        Kderivative * (2 : Real) ^ (a * (j : Real)) := by
    dsimp only [Kderivative]
    exact q4_finset_sum_toReal_le_strict_normalForm' hAderivative hb j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r) (hderivative j)
  have hfrequency : 0 <= (2 : Real) ^ (a * (j : Real)) :=
    Real.rpow_nonneg (by norm_num) _
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
                Cendpoint Bendpoint j n r).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
              Cderivative Bderivative j n r).toReal <=
        ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (Kendpoint * (2 : Real) ^ (a * (j : Real))) +
        Real.sqrt (Kderivative * (2 : Real) ^ (a * (j : Real))) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Kendpoint +
          Real.sqrt Kderivative) * ((2 : Real) ^ (a / 2)) ^ j := by
      rw [Real.sqrt_mul hKendpoint,
        Real.sqrt_mul hKderivative,
        q4_sqrt_two_rpow_frequency_eq]
      ring

/-- The target-frequency form of the negative-gap shell estimate.  The
multiplier constants in the literal pair-kernel argument are themselves
frequency dependent, so the level estimates need only be supplied at the
frequency `j` which is being reassembled.  This is the form used by the
fixed-cutoff Q4 source theorem. -/
theorem q4ActiveDyadicLtwoRealConstant_le_dyadic_rate_of_negative_gap_at
    {d : Nat} {gamma eta Ccover : Real}
    {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative a b r : Real} (j : Nat)
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (hb : b < 0)
    (hendpoint : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r <=
        ENNReal.ofReal
          (Aendpoint * (2 : Real) ^
            (a * (j : Real) + b * (n : Real))))
    (hderivative : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r <=
        ENNReal.ofReal
          (Aderivative * (2 : Real) ^
            (a * (j : Real) + b * (n : Real)))) :
    q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j r <=
      (‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (q4StrictShellSummationConstant Aendpoint b) +
        Real.sqrt (q4StrictShellSummationConstant Aderivative b)) *
        ((2 : Real) ^ (a / 2)) ^ j := by
  let Kendpoint : Real := q4StrictShellSummationConstant Aendpoint b
  let Kderivative : Real := q4StrictShellSummationConstant Aderivative b
  have hKendpoint : 0 <= Kendpoint := by
    dsimp only [Kendpoint]
    exact q4StrictShellSummationConstant_nonneg hAendpoint hb
  have hKderivative : 0 <= Kderivative := by
    dsimp only [Kderivative]
    exact q4StrictShellSummationConstant_nonneg hAderivative hb
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cendpoint Bendpoint j n r).toReal <=
        Kendpoint * (2 : Real) ^ (a * (j : Real)) := by
    dsimp only [Kendpoint]
    exact q4_finset_sum_toReal_le_strict_normalForm' hAendpoint hb j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r) hendpoint
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cderivative Bderivative j n r).toReal <=
        Kderivative * (2 : Real) ^ (a * (j : Real)) := by
    dsimp only [Kderivative]
    exact q4_finset_sum_toReal_le_strict_normalForm' hAderivative hb j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r) hderivative
  have hfrequency : 0 <= (2 : Real) ^ (a * (j : Real)) :=
    Real.rpow_nonneg (by norm_num) _
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
                Cendpoint Bendpoint j n r).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
              Cderivative Bderivative j n r).toReal <=
        ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (Kendpoint * (2 : Real) ^ (a * (j : Real))) +
        Real.sqrt (Kderivative * (2 : Real) ^ (a * (j : Real))) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Kendpoint +
          Real.sqrt Kderivative) * ((2 : Real) ^ (a / 2)) ^ j := by
      rw [Real.sqrt_mul hKendpoint,
        Real.sqrt_mul hKderivative,
        q4_sqrt_two_rpow_frequency_eq]
      ring

/-! ## The zero-gap endpoint shell -/

/-- At the balancing Q4 parameter the gap exponent is zero.  The literal
finite range has exactly `j + 3` terms; this lemma retains that factor rather
than replacing the endpoint by a fictitious convergent geometric series. -/
theorem q4_finset_sum_toReal_le_zero_gap_normalForm
    {A a : Real} (hA : 0 <= A) (j : Nat) (L : Nat -> ENNReal)
    (hL : ∀ n : Nat, L n <= ENNReal.ofReal
      (A * (2 : Real) ^ (a * (j : Real)))) :
    (∑ n ∈ Finset.range (j + 3), (L n).toReal) <=
      ((j + 3 : Nat) : Real) * A *
        (2 : Real) ^ (a * (j : Real)) := by
  have hterm : 0 <= A * (2 : Real) ^ (a * (j : Real)) :=
    mul_nonneg hA (Real.rpow_nonneg (by norm_num) _)
  calc
    (∑ n ∈ Finset.range (j + 3), (L n).toReal) <=
        ∑ n ∈ Finset.range (j + 3),
          A * (2 : Real) ^ (a * (j : Real)) := by
      apply Finset.sum_le_sum
      intro n hn
      simpa only [zero_mul, add_zero] using
        q4_toReal_le_normalForm (a := a) (b := 0) (j := j) (n := n) hA (by
          simpa only [zero_mul, add_zero] using hL n)
    _ = ((j + 3 : Nat) : Real) * A *
        (2 : Real) ^ (a * (j : Real)) := by
      rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
      ring

/-- The `ENNReal`-level form of the zero-gap finite shell sum bound. -/
theorem q4_finset_sum_toReal_le_zero_gap_normalForm'
    {A a : Real} (hA : 0 <= A) (j : Nat) (L : Nat -> ENNReal)
    (hL : ∀ n : Nat, L n <= ENNReal.ofReal
      (A * (2 : Real) ^ (a * (j : Real)))) :
    (∑ n ∈ Finset.range (j + 3), L n).toReal <=
      ((j + 3 : Nat) : Real) * A *
        (2 : Real) ^ (a * (j : Real)) := by
  have hfin : ∀ n ∈ Finset.range (j + 3), L n ≠ ∞ := fun n _ =>
    ne_of_lt (lt_of_le_of_lt (hL n) ENNReal.ofReal_lt_top)
  rw [ENNReal.toReal_sum hfin]
  exact q4_finset_sum_toReal_le_zero_gap_normalForm hA j L hL

/-- The exact finite zero-gap shell estimate.  The square root in the
literal `TT*` bound produces `sqrt (j + 3)` and the usual half frequency
exponent.  This is the endpoint calculation underlying the paper's allowed
subpower loss. -/
theorem q4ActiveDyadicLtwoRealConstant_le_zero_gap_dyadic_rate
    {d : Nat} {gamma eta Ccover : Real}
    {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative a r : Real}
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (hendpoint : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r <=
        ENNReal.ofReal (Aendpoint * (2 : Real) ^ (a * (j : Real))))
    (hderivative : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r <=
        ENNReal.ofReal (Aderivative * (2 : Real) ^ (a * (j : Real))))
    (j : Nat) :
    q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j r <=
      (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Aendpoint +
        Real.sqrt Aderivative) * Real.sqrt ((j + 3 : Nat) : Real) *
        ((2 : Real) ^ (a / 2)) ^ j := by
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cendpoint Bendpoint j n r).toReal <=
        ((j + 3 : Nat) : Real) * Aendpoint *
          (2 : Real) ^ (a * (j : Real)) :=
    q4_finset_sum_toReal_le_zero_gap_normalForm' hAendpoint j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r) (hendpoint j)
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cderivative Bderivative j n r).toReal <=
        ((j + 3 : Nat) : Real) * Aderivative *
          (2 : Real) ^ (a * (j : Real)) :=
    q4_finset_sum_toReal_le_zero_gap_normalForm' hAderivative j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r) (hderivative j)
  have hj : 0 <= ((j + 3 : Nat) : Real) := by positivity
  have hfrequency : 0 <= (2 : Real) ^ (a * (j : Real)) :=
    Real.rpow_nonneg (by norm_num) _
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
                Cendpoint Bendpoint j n r).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
              Cderivative Bderivative j n r).toReal <=
        ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (((j + 3 : Nat) : Real) * Aendpoint *
            (2 : Real) ^ (a * (j : Real))) +
        Real.sqrt (((j + 3 : Nat) : Real) * Aderivative *
          (2 : Real) ^ (a * (j : Real))) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Aendpoint +
          Real.sqrt Aderivative) * Real.sqrt ((j + 3 : Nat) : Real) *
          ((2 : Real) ^ (a / 2)) ^ j := by
      rw [show ((j + 3 : Nat) : Real) * Aendpoint *
            (2 : Real) ^ (a * (j : Real)) =
          ((j + 3 : Nat) : Real) *
            (Aendpoint * (2 : Real) ^ (a * (j : Real))) by ring,
        show ((j + 3 : Nat) : Real) * Aderivative *
            (2 : Real) ^ (a * (j : Real)) =
          ((j + 3 : Nat) : Real) *
            (Aderivative * (2 : Real) ^ (a * (j : Real))) by ring,
        Real.sqrt_mul hj,
        Real.sqrt_mul hj,
        Real.sqrt_mul hAendpoint,
        Real.sqrt_mul hAderivative,
        q4_sqrt_two_rpow_frequency_eq]
      ring

/-- The target-frequency zero-gap shell estimate.  Unlike the uniform
version above, its hypotheses retain the multiplier constants at the single
frequency which occurs in the literal active-cell sum. -/
theorem q4ActiveDyadicLtwoRealConstant_le_zero_gap_dyadic_rate_at
    {d : Nat} {gamma eta Ccover : Real}
    {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative a r : Real} (j : Nat)
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (hendpoint : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r <=
        ENNReal.ofReal (Aendpoint * (2 : Real) ^ (a * (j : Real))))
    (hderivative : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r <=
        ENNReal.ofReal (Aderivative * (2 : Real) ^ (a * (j : Real)))) :
    q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j r <=
      (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Aendpoint +
        Real.sqrt Aderivative) * Real.sqrt ((j + 3 : Nat) : Real) *
        ((2 : Real) ^ (a / 2)) ^ j := by
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cendpoint Bendpoint j n r).toReal <=
        ((j + 3 : Nat) : Real) * Aendpoint *
          (2 : Real) ^ (a * (j : Real)) :=
    q4_finset_sum_toReal_le_zero_gap_normalForm' hAendpoint j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r) hendpoint
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
          Cderivative Bderivative j n r).toReal <=
        ((j + 3 : Nat) : Real) * Aderivative *
          (2 : Real) ^ (a * (j : Real)) :=
    q4_finset_sum_toReal_le_zero_gap_normalForm' hAderivative j
      (fun n => q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r) hderivative
  have hj : 0 <= ((j + 3 : Nat) : Real) := by positivity
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
                Cendpoint Bendpoint j n r).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
              Cderivative Bderivative j n r).toReal <=
        ‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (((j + 3 : Nat) : Real) * Aendpoint *
            (2 : Real) ^ (a * (j : Real))) +
        Real.sqrt (((j + 3 : Nat) : Real) * Aderivative *
          (2 : Real) ^ (a * (j : Real))) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass d)⁻¹ : Complex)‖ * Real.sqrt Aendpoint +
          Real.sqrt Aderivative) * Real.sqrt ((j + 3 : Nat) : Real) *
          ((2 : Real) ^ (a / 2)) ^ j := by
      rw [show ((j + 3 : Nat) : Real) * Aendpoint *
            (2 : Real) ^ (a * (j : Real)) =
          ((j + 3 : Nat) : Real) *
            (Aendpoint * (2 : Real) ^ (a * (j : Real))) by ring,
        show ((j + 3 : Nat) : Real) * Aderivative *
            (2 : Real) ^ (a * (j : Real)) =
          ((j + 3 : Nat) : Real) *
            (Aderivative * (2 : Real) ^ (a * (j : Real))) by ring,
        Real.sqrt_mul hj,
        Real.sqrt_mul hj,
        Real.sqrt_mul hAendpoint,
        Real.sqrt_mul hAderivative,
        q4_sqrt_two_rpow_frequency_eq]
      ring

/-- A square-root finite-shell factor is absorbed by every strictly growing
geometric progression.  This elementary estimate is kept explicit because it
is exactly what turns the zero-gap endpoint shell into the arbitrary
`2^(epsilon * j)` loss in Corollary 3.2. -/
theorem exists_sqrt_nat_add_le_geometric
    {R : Real} (hR : 1 < R) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat,
      Real.sqrt ((j + 3 : Nat) : Real) <= C * R ^ j := by
  have hRsub : 0 < R - 1 := sub_pos.mpr hR
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / (R - 1))
  have hNpos : 0 < (N : Real) := by
    have hleft : 0 < 1 / (R - 1) := one_div_pos.mpr hRsub
    exact lt_trans hleft hN
  let t : Real := 1 / (N : Real)
  have ht : 0 <= t := by
    dsimp only [t]
    exact (one_div_pos.mpr hNpos).le
  have hNinv : t < R - 1 := by
    dsimp only [t]
    apply (div_lt_iff₀ hNpos).mpr
    have hN' : 1 < (N : Real) * (R - 1) :=
      (div_lt_iff₀ hRsub).mp hN
    nlinarith
  have hbase : 1 + t <= R := by linarith
  have hbaseNonneg : 0 <= 1 + t := by linarith
  have hbernoulli : ∀ j : Nat,
      1 + (j : Real) * t <= (1 + t) ^ j := by
    intro j
    induction j with
    | zero => norm_num
    | succ j hj =>
      calc
        1 + ((Nat.succ j : Nat) : Real) * t <=
            (1 + (j : Real) * t) * (1 + t) := by
              rw [Nat.cast_succ]
              have hnonneg : 0 <= (j : Real) * t ^ 2 :=
                mul_nonneg (by positivity) (sq_nonneg t)
              nlinarith
        _ <= (1 + t) ^ j * (1 + t) :=
            mul_le_mul_of_nonneg_right hj hbaseNonneg
        _ = (1 + t) ^ (Nat.succ j) := by rw [pow_succ]
  refine ⟨(N : Real) + 3, by positivity, ?_⟩
  intro j
  have hpow : (1 + t) ^ j <= R ^ j :=
    pow_le_pow_left₀ hbaseNonneg hbase j
  have hlinear : (j : Real) * t <= R ^ j := by
    calc
      (j : Real) * t <= 1 + (j : Real) * t := by linarith
      _ <= (1 + t) ^ j := hbernoulli j
      _ <= R ^ j := hpow
  have hjle : (j : Real) <= (N : Real) * R ^ j := by
    have hmul := mul_le_mul_of_nonneg_left hlinear hNpos.le
    dsimp only [t] at hmul
    calc
      (j : Real) = (N : Real) * ((j : Real) * (1 / (N : Real))) := by
        field_simp [hNpos.ne']
      _ <= (N : Real) * R ^ j := hmul
  have hpowone : 1 <= R ^ j := one_le_pow₀ hR.le
  have hthree : (3 : Real) <= 3 * R ^ j := by
    nlinarith
  have hlinearAdd : ((j + 3 : Nat) : Real) <= ((N : Real) + 3) * R ^ j := by
    norm_num [Nat.cast_add, Nat.cast_ofNat]
    nlinarith [hjle, hthree]
  have hargone : 1 <= ((j + 3 : Nat) : Real) := by
    have hj0 : (0 : Real) <= (j : Real) := Nat.cast_nonneg j
    push_cast
    linarith
  exact (Real.sqrt_le_self_iff).2 (Or.inr hargone) |>.trans hlinearAdd

/-- The product of the endpoint frequency ratio with the small geometric
factor used to absorb `sqrt (j + 3)` is one dyadic power. -/
theorem q4_zero_gap_loss_frequency_factorization
    (a epsilon : Real) (j : Nat) :
    ((2 : Real) ^ epsilon) ^ j * ((2 : Real) ^ (a / 2)) ^ j =
      ((2 : Real) ^ ((a + 2 * epsilon) / 2)) ^ j := by
  rw [← mul_pow, ← Real.rpow_add (by norm_num : (0 : Real) < 2)]
  congr 2
  ring

/-- Absorb the literal `sqrt (j + 3)` zero-gap factor into an arbitrarily
small dyadic loss.  This lemma is deliberately independent of kernels and
maximal operators, so both stationary-phase branches use exactly the same
endpoint calculation. -/
theorem q4_zero_gap_coefficient_le_with_subpower_loss
    {K a epsilon : Real} (hK : 0 <= K) (hepsilon : 0 < epsilon)
    (X : Nat -> Real)
    (hX : ∀ j : Nat,
      X j <= K * Real.sqrt ((j + 3 : Nat) : Real) *
        ((2 : Real) ^ (a / 2)) ^ j) :
    ∃ C : Real, 0 < C ∧ ∀ j : Nat,
      X j <= C * ((2 : Real) ^ ((a + 2 * epsilon) / 2)) ^ j := by
  have hR : 1 < (2 : Real) ^ epsilon :=
    Real.one_lt_rpow (by norm_num) hepsilon
  obtain ⟨D, hD, hpoly⟩ := exists_sqrt_nat_add_le_geometric hR
  refine ⟨K * D + 1, by nlinarith [mul_nonneg hK hD.le], ?_⟩
  intro j
  have hfrequency : 0 <= ((2 : Real) ^ (a / 2)) ^ j :=
    pow_nonneg (Real.rpow_nonneg (by norm_num) _) _
  have hratio : 0 <= ((2 : Real) ^ epsilon) ^ j :=
    pow_nonneg (Real.rpow_nonneg (by norm_num) _) _
  calc
    X j <= K * Real.sqrt ((j + 3 : Nat) : Real) *
        ((2 : Real) ^ (a / 2)) ^ j := hX j
    _ <= (K * D + 1) *
        (((2 : Real) ^ epsilon) ^ j *
          ((2 : Real) ^ (a / 2)) ^ j) := by
      have hroot := hpoly j
      have hleft : K * Real.sqrt ((j + 3 : Nat) : Real) <=
          K * (D * ((2 : Real) ^ epsilon) ^ j) :=
        mul_le_mul_of_nonneg_left hroot hK
      calc
        K * Real.sqrt ((j + 3 : Nat) : Real) *
            ((2 : Real) ^ (a / 2)) ^ j <=
            (K * (D * ((2 : Real) ^ epsilon) ^ j)) *
              ((2 : Real) ^ (a / 2)) ^ j :=
          mul_le_mul_of_nonneg_right hleft hfrequency
        _ <= (K * D + 1) *
            (((2 : Real) ^ epsilon) ^ j *
              ((2 : Real) ^ (a / 2)) ^ j) := by
          have hKD : K * D <= K * D + 1 := by linarith
          calc
            (K * (D * ((2 : Real) ^ epsilon) ^ j)) *
                ((2 : Real) ^ (a / 2)) ^ j =
                (K * D) *
                  (((2 : Real) ^ epsilon) ^ j *
                    ((2 : Real) ^ (a / 2)) ^ j) := by ring
            _ <= (K * D + 1) *
                (((2 : Real) ^ epsilon) ^ j *
                  ((2 : Real) ^ (a / 2)) ^ j) :=
              mul_le_mul_of_nonneg_right hKD (mul_nonneg hratio hfrequency)
    _ = (K * D + 1) *
        ((2 : Real) ^ ((a + 2 * epsilon) / 2)) ^ j := by
      rw [q4_zero_gap_loss_frequency_factorization]

/-- The strict-gain form of the preceding finite shell reassembly.  Keeping
this wrapper preserves the source interface used away from the Q4 endpoint,
while the more general theorem above is used for the permitted Q4 loss. -/
theorem q4ActiveDyadicLtwoRealConstant_le_strict_dyadic_rate
    {d : Nat} {gamma eta Ccover : Real}
    {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative a b r : Real}
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (_ha : a < 0) (hb : b < 0)
    (hendpoint : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cendpoint Bendpoint j n r <=
        ENNReal.ofReal
          (Aendpoint * (2 : Real) ^
            (a * (j : Real) + b * (n : Real))))
    (hderivative : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant d gamma eta Ccover
        Cderivative Bderivative j n r <=
        ENNReal.ofReal
          (Aderivative * (2 : Real) ^
            (a * (j : Real) + b * (n : Real))))
    (j : Nat) :
    q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j r <=
      (‖((surfaceMass d)⁻¹ : Complex)‖ *
          Real.sqrt (q4StrictShellSummationConstant Aendpoint b) +
        Real.sqrt (q4StrictShellSummationConstant Aderivative b)) *
        ((2 : Real) ^ (a / 2)) ^ j :=
  q4ActiveDyadicLtwoRealConstant_le_dyadic_rate_of_negative_gap
    hAendpoint hAderivative hb hendpoint hderivative j

/-! ## The planar critical finite gap range -/

/-- In the allowed planar critical case the gap ratio is increasing.  The
literal relation `n < j + 3` absorbs it into this finite shell constant. -/
def q4PlanarCriticalShellSummationConstant (A theta : Real) : Real :=
  A * (((2 : Real) ^ (theta - 1 / 2)) ^ 3 /
    ((2 : Real) ^ (theta - 1 / 2) - 1))

theorem q4PlanarCriticalShellSummationConstant_nonneg
    {A theta : Real} (hA : 0 <= A) (htheta : 1 / 2 < theta) :
    0 <= q4PlanarCriticalShellSummationConstant A theta := by
  unfold q4PlanarCriticalShellSummationConstant
  apply mul_nonneg hA
  apply div_nonneg
  · exact pow_nonneg (Real.rpow_nonneg (by norm_num) _) _
  · exact (sub_pos.mpr
      (Real.one_lt_rpow (by norm_num) (by linarith : 0 < theta - 1 / 2))).le

/-- The literal finite planar critical range has the combined strictly
decaying frequency ratio from the paper. -/
theorem q4_planar_critical_real_shell_sum_le
    {A theta eta : Real} (hA : 0 <= A) (htheta : 1 / 2 < theta)
    (j : Nat) :
    (∑ n ∈ Finset.range (j + 3),
      A * (2 : Real) ^
        (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
          q4GapExponent 2 (1 / 2) theta * (n : Real))) <=
      q4PlanarCriticalShellSummationConstant A theta *
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta)) ^ j := by
  have hscalar :=
    q4_planar_critical_finite_level_sum_with_subpower_loss_le (eta := eta) htheta j
  calc
    (∑ n ∈ Finset.range (j + 3),
        A * (2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
            q4GapExponent 2 (1 / 2) theta * (n : Real))) =
        A * ∑ n ∈ Finset.range (j + 3),
          (2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
              q4GapExponent 2 (1 / 2) theta * (n : Real)) := by
      rw [Finset.mul_sum]
    _ <= A *
        ((((2 : Real) ^ (theta - 1 / 2)) ^ 3 /
          ((2 : Real) ^ (theta - 1 / 2) - 1)) *
          ((2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
              q4GapExponent 2 (1 / 2) theta)) ^ j) :=
      mul_le_mul_of_nonneg_left hscalar hA
    _ = q4PlanarCriticalShellSummationConstant A theta *
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta)) ^ j := by
      unfold q4PlanarCriticalShellSummationConstant
      ring

/-- Real level coefficients can be summed in the critical planar range just
as in the ordinary decreasing-gap range. -/
theorem q4_finset_sum_toReal_le_planar_critical_normalForm
    {A theta eta : Real} (hA : 0 <= A) (htheta : 1 / 2 < theta)
    (j : Nat) (L : Nat -> ENNReal)
    (hL : ∀ n : Nat, L n <= ENNReal.ofReal
      (A * (2 : Real) ^
        (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
          q4GapExponent 2 (1 / 2) theta * (n : Real)))) :
    (∑ n ∈ Finset.range (j + 3), (L n).toReal) <=
      q4PlanarCriticalShellSummationConstant A theta *
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta)) ^ j := by
  calc
    (∑ n ∈ Finset.range (j + 3), (L n).toReal) <=
        ∑ n ∈ Finset.range (j + 3), A * (2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
            q4GapExponent 2 (1 / 2) theta * (n : Real)) := by
      apply Finset.sum_le_sum
      intro n hn
      exact q4_toReal_le_normalForm hA (hL n)
    _ <= q4PlanarCriticalShellSummationConstant A theta *
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta)) ^ j :=
      q4_planar_critical_real_shell_sum_le hA htheta j

/-- The `ENNReal`-level form of the planar critical finite shell sum bound. -/
theorem q4_finset_sum_toReal_le_planar_critical_normalForm'
    {A theta eta : Real} (hA : 0 <= A) (htheta : 1 / 2 < theta)
    (j : Nat) (L : Nat -> ENNReal)
    (hL : ∀ n : Nat, L n <= ENNReal.ofReal
      (A * (2 : Real) ^
        (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
          q4GapExponent 2 (1 / 2) theta * (n : Real)))) :
    (∑ n ∈ Finset.range (j + 3), L n).toReal <=
      q4PlanarCriticalShellSummationConstant A theta *
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta)) ^ j := by
  have hfin : ∀ n ∈ Finset.range (j + 3), L n ≠ ∞ := fun n _ =>
    ne_of_lt (lt_of_le_of_lt (hL n) ENNReal.ofReal_lt_top)
  rw [ENNReal.toReal_sum hfin]
  exact q4_finset_sum_toReal_le_planar_critical_normalForm hA htheta j L hL

theorem q4_sqrt_planar_critical_frequency_eq
    (a : Real) (j : Nat) :
    Real.sqrt (((2 : Real) ^ a) ^ j) = ((2 : Real) ^ (a / 2)) ^ j := by
  rw [← Real.rpow_mul_natCast (by norm_num : (0 : Real) <= 2) a j]
  exact q4_sqrt_two_rpow_frequency_eq a j

/-- The actual planar critical Q4 level coefficient still has a strict
dyadic rate: the increasing gap sum is first absorbed at `n = j + 3`, then
the `TT*` square root supplies the half exponent. -/
theorem q4ActiveDyadicLtwoRealConstant_le_planar_critical_dyadic_rate
    {eta Ccover : Real} {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative theta : Real}
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (htheta : 1 / 2 < theta)
    (hcombined : q4FrequencyExponentWithSubpowerLoss 2 theta eta +
      q4GapExponent 2 (1 / 2) theta < 0)
    (hendpoint : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cendpoint Bendpoint j n (2 / theta) <= ENNReal.ofReal
          (Aendpoint * (2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
              q4GapExponent 2 (1 / 2) theta * (n : Real))))
    (hderivative : ∀ j n : Nat,
      q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cderivative Bderivative j n (2 / theta) <= ENNReal.ofReal
          (Aderivative * (2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
              q4GapExponent 2 (1 / 2) theta * (n : Real))))
    (j : Nat) :
    q4ActiveDyadicLtwoRealConstant 2 (1 / 2) eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j (2 / theta) <=
      (‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt (q4PlanarCriticalShellSummationConstant Aendpoint theta) +
        Real.sqrt (q4PlanarCriticalShellSummationConstant Aderivative theta)) *
        ((2 : Real) ^
          ((q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta) / 2)) ^ j := by
  let Kendpoint : Real := q4PlanarCriticalShellSummationConstant Aendpoint theta
  let Kderivative : Real := q4PlanarCriticalShellSummationConstant Aderivative theta
  let combined : Real := q4FrequencyExponentWithSubpowerLoss 2 theta eta +
    q4GapExponent 2 (1 / 2) theta
  have hKendpoint : 0 <= Kendpoint := by
    dsimp only [Kendpoint]
    exact q4PlanarCriticalShellSummationConstant_nonneg hAendpoint htheta
  have hKderivative : 0 <= Kderivative := by
    dsimp only [Kderivative]
    exact q4PlanarCriticalShellSummationConstant_nonneg hAderivative htheta
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
          Cendpoint Bendpoint j n (2 / theta)).toReal <=
        Kendpoint * ((2 : Real) ^ combined) ^ j := by
    dsimp only [Kendpoint, combined]
    exact q4_finset_sum_toReal_le_planar_critical_normalForm'
      hAendpoint htheta j
      (fun n => q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cendpoint Bendpoint j n (2 / theta)) (hendpoint j)
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
          Cderivative Bderivative j n (2 / theta)).toReal <=
        Kderivative * ((2 : Real) ^ combined) ^ j := by
    dsimp only [Kderivative, combined]
    exact q4_finset_sum_toReal_le_planar_critical_normalForm'
      hAderivative htheta j
      (fun n => q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cderivative Bderivative j n (2 / theta)) (hderivative j)
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
                Cendpoint Bendpoint j n (2 / theta)).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
              Cderivative Bderivative j n (2 / theta)).toReal <=
        ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt (Kendpoint * ((2 : Real) ^ combined) ^ j) +
        Real.sqrt (Kderivative * ((2 : Real) ^ combined) ^ j) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass 2)⁻¹ : Complex)‖ * Real.sqrt Kendpoint +
          Real.sqrt Kderivative) * ((2 : Real) ^ (combined / 2)) ^ j := by
      rw [Real.sqrt_mul hKendpoint,
        Real.sqrt_mul hKderivative,
        q4_sqrt_planar_critical_frequency_eq]
      ring

/-- The target-frequency version of the planar critical shell calculation.
The literal multiplier estimates have a separate enlargement constant at
each dyadic frequency, so this is the form which can be inserted directly
into the fixed-cutoff maximal estimate. -/
theorem q4ActiveDyadicLtwoRealConstant_le_planar_critical_dyadic_rate_at
    {eta Ccover : Real} {Cendpoint Bendpoint Cderivative Bderivative : Real}
    {Aendpoint Aderivative theta : Real} (j : Nat)
    (hAendpoint : 0 <= Aendpoint) (hAderivative : 0 <= Aderivative)
    (htheta : 1 / 2 < theta)
    (hcombined : q4FrequencyExponentWithSubpowerLoss 2 theta eta +
      q4GapExponent 2 (1 / 2) theta < 0)
    (hendpoint : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cendpoint Bendpoint j n (2 / theta) <= ENNReal.ofReal
          (Aendpoint * (2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
              q4GapExponent 2 (1 / 2) theta * (n : Real))))
    (hderivative : ∀ n : Nat,
      q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cderivative Bderivative j n (2 / theta) <= ENNReal.ofReal
          (Aderivative * (2 : Real) ^
            (q4FrequencyExponentWithSubpowerLoss 2 theta eta * (j : Real) +
              q4GapExponent 2 (1 / 2) theta * (n : Real)))) :
    q4ActiveDyadicLtwoRealConstant 2 (1 / 2) eta Ccover
      Cendpoint Bendpoint Cderivative Bderivative j (2 / theta) <=
      (‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt (q4PlanarCriticalShellSummationConstant Aendpoint theta) +
        Real.sqrt (q4PlanarCriticalShellSummationConstant Aderivative theta)) *
        ((2 : Real) ^
          ((q4FrequencyExponentWithSubpowerLoss 2 theta eta +
            q4GapExponent 2 (1 / 2) theta) / 2)) ^ j := by
  let Kendpoint : Real := q4PlanarCriticalShellSummationConstant Aendpoint theta
  let Kderivative : Real := q4PlanarCriticalShellSummationConstant Aderivative theta
  let combined : Real := q4FrequencyExponentWithSubpowerLoss 2 theta eta +
    q4GapExponent 2 (1 / 2) theta
  have hKendpoint : 0 <= Kendpoint := by
    dsimp only [Kendpoint]
    exact q4PlanarCriticalShellSummationConstant_nonneg hAendpoint htheta
  have hKderivative : 0 <= Kderivative := by
    dsimp only [Kderivative]
    exact q4PlanarCriticalShellSummationConstant_nonneg hAderivative htheta
  have hsumEndpoint :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
          Cendpoint Bendpoint j n (2 / theta)).toReal <=
        Kendpoint * ((2 : Real) ^ combined) ^ j := by
    dsimp only [Kendpoint, combined]
    exact q4_finset_sum_toReal_le_planar_critical_normalForm'
      hAendpoint htheta j
      (fun n => q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cendpoint Bendpoint j n (2 / theta)) hendpoint
  have hsumDerivative :
      (∑ n ∈ Finset.range (j + 3),
        q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
          Cderivative Bderivative j n (2 / theta)).toReal <=
        Kderivative * ((2 : Real) ^ combined) ^ j := by
    dsimp only [Kderivative, combined]
    exact q4_finset_sum_toReal_le_planar_critical_normalForm'
      hAderivative htheta j
      (fun n => q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
        Cderivative Bderivative j n (2 / theta)) hderivative
  unfold q4ActiveDyadicLtwoRealConstant
  calc
    ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt
            (∑ n ∈ Finset.range (j + 3),
              q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
                Cendpoint Bendpoint j n (2 / theta)).toReal +
        Real.sqrt
          (∑ n ∈ Finset.range (j + 3),
            q4ActiveDyadicLevelStrongConstant 2 (1 / 2) eta Ccover
              Cderivative Bderivative j n (2 / theta)).toReal <=
        ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          Real.sqrt (Kendpoint * ((2 : Real) ^ combined) ^ j) +
        Real.sqrt (Kderivative * ((2 : Real) ^ combined) ^ j) := by
          apply add_le_add
          · exact mul_le_mul_of_nonneg_left
              (Real.sqrt_le_sqrt hsumEndpoint) (norm_nonneg _)
          · exact Real.sqrt_le_sqrt hsumDerivative
    _ = (‖((surfaceMass 2)⁻¹ : Complex)‖ * Real.sqrt Kendpoint +
          Real.sqrt Kderivative) * ((2 : Real) ^ (combined / 2)) ^ j := by
      rw [Real.sqrt_mul hKendpoint,
        Real.sqrt_mul hKderivative,
        q4_sqrt_planar_critical_frequency_eq]
      ring

/-- Convert a real strict coefficient bound into the `ENNReal` form used by
the dyadic off-diagonal reassembly.  This tiny lemma is kept explicit so the
source-level theorem below never needs to hide an endpoint estimate behind a
cast. -/
theorem q4_active_ltwo_eLpNorm_le_of_ltwoReal_strict_rate
    {d : Nat} {E : Set Real} {psi f : SchwartzMap (Euclidean d) Complex}
    {gamma eta Ccover Cendpoint Bendpoint Cderivative Bderivative : Real}
    {j : Nat} {r C a : Real}
    (hC : 0 <= C)
    (hcoefficient :
      q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
        Cendpoint Bendpoint Cderivative Bderivative j r <=
        C * ((2 : Real) ^ (a / 2)) ^ j)
    (hbase :
      eLpNorm (fractalDyadicBandpassMaximal d E psi f)
          (ENNReal.ofReal r) volume <=
        ENNReal.ofReal
          (q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
            Cendpoint Bendpoint Cderivative Bderivative j r) *
          ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat)))) :
    eLpNorm (fractalDyadicBandpassMaximal d E psi f)
        (ENNReal.ofReal r) volume <=
      ENNReal.ofReal C *
        (ENNReal.ofReal ((2 : Real) ^ (a / 2))) ^ j *
          ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
  have hrho : 0 <= (2 : Real) ^ (a / 2) :=
    Real.rpow_nonneg (by norm_num) _
  have hright : 0 <= C * ((2 : Real) ^ (a / 2)) ^ j :=
    mul_nonneg hC (pow_nonneg hrho _)
  calc
    eLpNorm (fractalDyadicBandpassMaximal d E psi f)
        (ENNReal.ofReal r) volume <=
        ENNReal.ofReal
          (q4ActiveDyadicLtwoRealConstant d gamma eta Ccover
            Cendpoint Bendpoint Cderivative Bderivative j r) *
          ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) :=
      hbase
    _ <= ENNReal.ofReal (C * ((2 : Real) ^ (a / 2)) ^ j) *
          ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
      apply mul_le_mul_left
      exact ENNReal.ofReal_le_ofReal hcoefficient
    _ = ENNReal.ofReal C *
        (ENNReal.ofReal ((2 : Real) ^ (a / 2))) ^ j *
          ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
      rw [ENNReal.ofReal_mul hC,
        ENNReal.ofReal_pow hrho j]

end
