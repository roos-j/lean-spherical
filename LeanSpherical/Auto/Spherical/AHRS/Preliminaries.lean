    (D : Set F) (eval : F → α → E) (T : F → α → ℝ)
    (hT_nonneg : ∀ g x, 0 ≤ T g x)
    (hT_subadd : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (C₂ : ENNReal)
    (hweak_two : ∀ (g : F), g ∈ D → ∀ {s : ℝ}, 0 < s →
      ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < T g x} ≤
        C₂ * (∫⁻ x, ENNReal.ofReal (‖eval g x‖ ^ (2 : ℕ)) ∂μ))
    {q : ℝ} (hq : 2 < q)
    (f : F) (hTf : AEMeasurable (T f) μ)
    (low high : ℝ → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hhigh_killed : ∀ t, 0 < t → ∀ x, T (high t) x ≤ t / 2)
    (hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ (2 : ℕ)) ∂μ))
    (A : ENNReal)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (q - 3)) ≤ A) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂μ) ≤
      ENNReal.ofReal q * (4 * C₂ * A) := by
  have hengine := sourceOutput_marcinkiewicz_moment_of_killed_split (ν := μ) D T hT_nonneg
    (fun g h hg hh => Filter.Eventually.of_forall (hT_subadd hg hh)) (s := 2) (by norm_num) hq
    C₂ (fun g => ∫⁻ x, ENNReal.ofReal (‖eval g x‖ ^ (2 : ℕ)) ∂μ)
    (fun g hg u hu => by rw [Real.rpow_two]; exact hweak_two g hg hu)
    f hTf low high hlow_mem hhigh_mem hsplit hhigh_killed hlowI_meas A
    (by rw [show q - 2 - 1 = q - 3 by ring]; exact hlow_tail)
  refine hengine.trans (le_of_eq ?_)
  rw [ENNReal.rpow_two, ENNReal.ofReal_ofNat]
  norm_num

/-- The `L¹ → L∞` endpoint supplies the killed-high hypothesis used by
`crossed_marcinkiewicz_strong_of_killed_split`. -/
theorem crossed_marcinkiewicz_strong_of_lone_ltwo_split
    {α E F : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [Add F] [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} [SFinite μ]
    (D : Set F) (eval : F → α → E) (T : F → α → ℝ)
    (hT_nonneg : ∀ g x, 0 ≤ T g x)
    (hT_subadd : ∀ ⦃g h : F⦄, g ∈ D → h ∈ D →
      ∀ x, T (g + h) x ≤ T g x + T h x)
    (C₁ : ℝ) (_hC₁ : 0 ≤ C₁)
    (hstrong_one_top : ∀ (g : F), g ∈ D → ∀ x,
      T g x ≤ C₁ * ∫ y, ‖eval g y‖ ∂μ)
    (C₂ : ENNReal)
    (hweak_two : ∀ (g : F), g ∈ D → ∀ {s : ℝ}, 0 < s →
      ENNReal.ofReal (s ^ (2 : ℕ)) * μ {x | s < T g x} ≤
        C₂ * (∫⁻ x, ENNReal.ofReal (‖eval g x‖ ^ (2 : ℕ)) ∂μ))
    {q : ℝ} (hq : 2 < q)
    (f : F) (hTf : AEMeasurable (T f) μ)
    (low high : ℝ → F)
    (hlow_mem : ∀ t, low t ∈ D) (hhigh_mem : ∀ t, high t ∈ D)
    (hsplit : ∀ t, f = low t + high t)
    (hhigh_lone : ∀ t, 0 < t →
      C₁ * (∫ y, ‖eval (high t) y‖ ∂μ) ≤ t / 2)
    (hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ (2 : ℕ)) ∂μ))
    (A : ENNReal)
    (hlow_tail :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x, ENNReal.ofReal (‖eval (low t) x‖ ^ (2 : ℕ)) ∂μ) *
          (ENNReal.ofReal t) ^ (q - 3)) ≤ A) :
    (∫⁻ x, ENNReal.ofReal ((T f x) ^ q) ∂μ) ≤
      ENNReal.ofReal q * (4 * C₂ * A) := by
  apply crossed_marcinkiewicz_strong_of_killed_split D eval T hT_nonneg hT_subadd C₂
    hweak_two hq f hTf low high hlow_mem hhigh_mem hsplit ?_ hlowI_meas A hlow_tail
  intro t ht x
  calc
    T (high t) x ≤ C₁ * ∫ y, ‖eval (high t) y‖ ∂μ :=
      hstrong_one_top (high t) (hhigh_mem t) x
    _ ≤ t / 2 := hhigh_lone t ht

/-- The one-dimensional power-tail computation in the crossed interpolation
argument.  The input-amplitude cutoff is parametrised as
`t * u^(p - 1) ≤ K`; this avoids any inverse-power change of variables.

The algebra uses `q = p / (p - 1)`.  It is exactly the calculation that
turns the square-function endpoint into the strict crossed `Lᵖ → Lᑫ`
estimate. -/
theorem crossed_power_cutoff_tail_pointwise
    {u p q K : ℝ} (hu : 0 ≤ u) (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1)) (hK : 0 < K) :
    ENNReal.ofReal (u ^ (2 : ℕ)) *
        (∫⁻ t in Ioc (0 : ℝ) (K / u ^ (p - 1)),
          (ENNReal.ofReal t) ^ (q - 3)) =
      (ENNReal.ofReal (q - 2))⁻¹ *
        (ENNReal.ofReal K) ^ (q - 2) * (ENNReal.ofReal u) ^ p := by
  have hq2 : 2 < q := by
    rw [hq]
    have hpminus : 0 < p - 1 := by linarith
    apply (lt_div_iff₀ hpminus).mpr
    nlinarith
  have hqminus : 0 < q - 2 := by linarith
  have hqtail : 1 < q - 1 := by linarith
  rcases hu.eq_or_lt with rfl | hu
  · simp [show 0 < p by linarith]
  have hu_pow : 0 < u ^ (p - 1) := Real.rpow_pos_of_pos hu _
  have hthreshold : 0 ≤ K / u ^ (p - 1) := by positivity
  rw [show q - 3 = (q - 1) - 2 by ring]
  rw [lintegral_rpow_Ioc_eq hqtail hthreshold]
  have hreal :
      u ^ (2 : ℕ) * ((K / u ^ (p - 1)) ^ (q - 2) / (q - 2)) =
        (K ^ (q - 2) / (q - 2)) * u ^ p := by
    rw [Real.div_rpow hK.le hu_pow.le]
    rw [div_eq_mul_inv]
    have hpq : 2 + (1 - p) * (q - 2) = p := by
      rw [hq]
      field_simp [show p - 1 ≠ 0 by linarith]
      ring
    have hu_two : u ^ (2 : ℕ) = u ^ (2 : ℝ) := (Real.rpow_natCast u 2).symm
    rw [hu_two]
    have hden : (u ^ (p - 1)) ^ (q - 2) = u ^ ((p - 1) * (q - 2)) := by
      rw [← Real.rpow_mul hu.le]
    rw [hden]
    rw [div_eq_mul_inv]
    have hinv : (u ^ ((p - 1) * (q - 2)))⁻¹ =
        u ^ ((1 - p) * (q - 2)) := by
      rw [← Real.rpow_neg (le_of_lt hu)]
      congr 1
      ring
    rw [hinv]
    have hcomb : u ^ (2 : ℝ) * u ^ ((1 - p) * (q - 2)) = u ^ p := by
      rw [← Real.rpow_add hu]
      rw [hpq]
    calc
      u ^ (2 : ℝ) * (K ^ (q - 2) * u ^ ((1 - p) * (q - 2)) *
          (q - 2)⁻¹) =
          K ^ (q - 2) * (q - 2)⁻¹ *
            (u ^ (2 : ℝ) * u ^ ((1 - p) * (q - 2))) := by ring
      _ = K ^ (q - 2) * (q - 2)⁻¹ * u ^ p := by rw [hcomb]
      _ = K ^ (q - 2) / (q - 2) * u ^ p := by ring
  have hqcalc : q - 1 - 1 = q - 2 := by ring
  rw [hqcalc]
  rw [← ENNReal.ofReal_mul (sq_nonneg u), hreal]
  have hA : 0 ≤ K ^ (q - 2) / (q - 2) :=
    div_nonneg (Real.rpow_nonneg hK.le _) hqminus.le
  rw [ENNReal.ofReal_mul hA]
  rw [ENNReal.ofReal_div_of_pos hqminus]
  rw [ENNReal.ofReal_rpow_of_pos hK]
  rw [ENNReal.ofReal_rpow_of_pos hu]
  simp only [div_eq_mul_inv]
  ring

/-- The low-amplitude tail needed for crossed Marcinkiewicz interpolation.
The cutoff is expressed by the measurable predicate
`t * u(x)^(p - 1) ≤ K`.  Tonelli and the preceding scalar identity convert
it directly to the `Lᵖ` moment, so no positivity of the operator is used. -/
theorem crossed_low_tail_of_power_cutoff
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} [SFinite μ]
    (u : α → ℝ) (hu : Measurable u) (hu_nonneg : ∀ x, 0 ≤ u x)
    {p q K : ℝ} (hp1 : 1 < p) (hp2 : p < 2)
    (hq : q = p / (p - 1)) (hK : 0 < K)
    (low : ℝ → α → E)
    (hlowI_meas : Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ∂μ))
    (hlow_bound : ∀ t x, 0 < t →
      ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ≤
        ({x | t * (u x) ^ (p - 1) ≤ K}.indicator
          (fun x => ENNReal.ofReal ((u x) ^ (2 : ℕ))) x)) :
    (∫⁻ t in Ioi (0 : ℝ),
      (∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ∂μ) *
        (ENNReal.ofReal t) ^ (q - 3)) ≤
      (ENNReal.ofReal (q - 2))⁻¹ *
        (ENNReal.ofReal K) ^ (q - 2) *
          ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
  let a : α → ℝ := fun x => K / (u x) ^ (p - 1)
  let v : α → ENNReal := fun x => ENNReal.ofReal ((u x) ^ (2 : ℕ))
  let w : ℝ → ENNReal := fun t => (ENNReal.ofReal t) ^ (q - 3)
  let lowI : ℝ → ENNReal := fun t =>
    ∫⁻ x, ENNReal.ofReal (‖low t x‖ ^ (2 : ℕ)) ∂μ
  have hpminus : 0 < p - 1 := by linarith
  have hpow : Measurable (fun x => (u x) ^ (p - 1)) := by
    exact (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hu
  have ha : Measurable a := by
    exact measurable_const.div hpow
  have ha_nonneg : ∀ x, 0 ≤ a x := by
    intro x
    exact div_nonneg hK.le (Real.rpow_nonneg (hu_nonneg x) _)
  have hv : Measurable v := by
    exact ENNReal.continuous_ofReal.measurable.comp (hu.pow_const 2)
  have hw : Measurable w := by
    exact ENNReal.continuous_rpow_const.measurable.comp measurable_id.ennreal_ofReal
  have hlowI : Measurable lowI := by
    simpa only [lowI] using hlowI_meas
  have hindicator (t : ℝ) (ht : 0 < t) (x : α) :
      ({x | t * (u x) ^ (p - 1) ≤ K}.indicator v x) ≤
        ({x | t ≤ a x}.indicator v x) := by
    by_cases hzero : u x = 0
    · have hvzero : v x = 0 := by simp [v, hzero]
      simp [Set.indicator_apply, hvzero]
    · have hupos : 0 < u x := lt_of_le_of_ne (hu_nonneg x) (Ne.symm hzero)
      have hupow : 0 < (u x) ^ (p - 1) := Real.rpow_pos_of_pos hupos _
      have heq : t * (u x) ^ (p - 1) ≤ K ↔ t ≤ a x := by
        dsimp only [a]
        exact (le_div_iff₀ hupow).symm
      simp only [Set.indicator_apply, mem_setOf_eq]
      by_cases hmem : t * (u x) ^ (p - 1) ≤ K
      · simp [hmem, heq.mp hmem]
      · simp [hmem]
  have hpoint (t : ℝ) (ht : 0 < t) :
      lowI t ≤ ∫⁻ x in {x | t ≤ a x}, v x ∂μ := by
    calc
      lowI t ≤ ∫⁻ x, ({x | t * (u x) ^ (p - 1) ≤ K}.indicator v x) ∂μ := by
        apply lintegral_mono
        intro x
        exact hlow_bound t x ht
      _ ≤ ∫⁻ x, ({x | t ≤ a x}.indicator v x) ∂μ := by
        apply lintegral_mono
        intro x
        exact hindicator t ht x
      _ = ∫⁻ x in {x | t ≤ a x}, v x ∂μ := by
        rw [lintegral_indicator (measurableSet_le measurable_const ha)]
  have houter :
      (∫⁻ t in Ioi (0 : ℝ), lowI t * w t) ≤
        ∫⁻ t in Ioi (0 : ℝ),
          (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t := by
    apply lintegral_mono_ae
    filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
    simpa only [mul_comm] using mul_le_mul_right (hpoint t ht) (w t)
  have hswap :
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t) =
        ∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ := by
    calc
      (∫⁻ t in Ioi (0 : ℝ),
        (∫⁻ x in {x | t ≤ a x}, v x ∂μ) * w t) =
        ∫⁻ t in Ioi (0 : ℝ),
          w t * (∫⁻ x in {x | t ≤ a x}, v x ∂μ) := by
          apply lintegral_congr
          intro t
          exact mul_comm _ _
      _ = _ := lintegral_swap_indicator_le a ha v hv w hw
  have hpointwise :
      (∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ) =
        (ENNReal.ofReal (q - 2))⁻¹ *
          (ENNReal.ofReal K) ^ (q - 2) *
            ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ := by
    let C : ENNReal := (ENNReal.ofReal (q - 2))⁻¹ *
      (ENNReal.ofReal K) ^ (q - 2)
    have hpowu : Measurable (fun x => (ENNReal.ofReal (u x)) ^ p) :=
      ENNReal.continuous_rpow_const.measurable.comp hu.ennreal_ofReal
    calc
      (∫⁻ x, v x * (∫⁻ t in Ioc (0 : ℝ) (a x), w t) ∂μ) =
          ∫⁻ x, C * (ENNReal.ofReal (u x)) ^ p ∂μ := by
            apply lintegral_congr
            intro x
            dsimp only [a, v, w, C]
            exact crossed_power_cutoff_tail_pointwise
              (hu_nonneg x) hp1 hp2 hq hK
      _ = C * ∫⁻ x, (ENNReal.ofReal (u x)) ^ p ∂μ :=
        lintegral_const_mul C hpowu
      _ = _ := by rfl
  simpa only [lowI, w] using houter.trans_eq (hswap.trans hpointwise)

/-- The hard power cutoff used to instantiate the crossed interpolation
lemma on a genuine selected shell.  It is deliberately defined on ordinary
functions rather than on a positive `TT*` factor. -/
def q4PowerCutoffLow
    {α E : Type*} [NormedAddCommGroup E]
    (p K t : ℝ) (f : α → E) : α → E :=
  {x | t * ‖f x‖ ^ (p - 1) ≤ K}.indicator f

/-- The complementary high-amplitude part of `q4PowerCutoffLow`. -/
def q4PowerCutoffHigh
    {α E : Type*} [NormedAddCommGroup E]
    (p K t : ℝ) (f : α → E) : α → E :=
  f - q4PowerCutoffLow p K t f

/-- Pointwise `L¹` control of the high part of the power cutoff. -/
theorem norm_q4PowerCutoffHigh_le
    {α E : Type*} [NormedAddCommGroup E]
    {p K t : ℝ} (hp1 : 1 < p) (hK : 0 < K) (ht : 0 < t)
    (f : α → E) (x : α) :
    ‖q4PowerCutoffHigh p K t f x‖ ≤ (t / K) * ‖f x‖ ^ p := by
  let P : Set α := {x | t * ‖f x‖ ^ (p - 1) ≤ K}
  by_cases hx : x ∈ P
  · simpa [q4PowerCutoffHigh, q4PowerCutoffLow, P, hx] using
      (mul_nonneg (div_nonneg ht.le hK.le) (Real.rpow_nonneg (norm_nonneg _) _))
  · have hnot : ¬ t * ‖f x‖ ^ (p - 1) ≤ K := by simpa [P] using hx
    have hlt : K < t * ‖f x‖ ^ (p - 1) := lt_of_not_ge hnot
    have hfxpos : 0 < ‖f x‖ := by
      by_contra h
      have hzero : ‖f x‖ = 0 := le_antisymm (le_of_not_gt h) (norm_nonneg _)
      rw [hzero, Real.zero_rpow (by linarith : p - 1 ≠ 0)] at hlt
      linarith
    have hpower : ‖f x‖ * ‖f x‖ ^ (p - 1) = ‖f x‖ ^ p := by
      calc
        ‖f x‖ * ‖f x‖ ^ (p - 1) = ‖f x‖ ^ (1 : ℝ) * ‖f x‖ ^ (p - 1) := by
          rw [Real.rpow_one]
        _ = ‖f x‖ ^ ((1 : ℝ) + (p - 1)) := (Real.rpow_add hfxpos _ _).symm
        _ = ‖f x‖ ^ p := by congr 1; ring
    have hmul : K * ‖f x‖ < t * ‖f x‖ ^ p := by
      calc
        K * ‖f x‖ < (t * ‖f x‖ ^ (p - 1)) * ‖f x‖ :=
          mul_lt_mul_of_pos_right hlt hfxpos
        _ = t * ‖f x‖ ^ p := by
          rw [mul_assoc, mul_comm (‖f x‖ ^ (p - 1)), hpower]
    have hbound : ‖f x‖ ≤ (t / K) * ‖f x‖ ^ p := by
      calc
        ‖f x‖ = (K * ‖f x‖) / K := by field_simp [hK.ne']
        _ ≤ (t * ‖f x‖ ^ p) / K := (div_le_div_iff_of_pos_right hK).mpr hmul.le
        _ = (t / K) * ‖f x‖ ^ p := by ring
    simpa [q4PowerCutoffHigh, q4PowerCutoffLow, P, hx] using hbound

/-- The low cutoff has exactly the pointwise square majorant required by
`crossed_low_tail_of_power_cutoff`. -/
theorem q4PowerCutoffLow_squared_le
    {α E : Type*} [NormedAddCommGroup E]
    (p K t : ℝ) (f : α → E) (x : α) :
    ENNReal.ofReal (‖q4PowerCutoffLow p K t f x‖ ^ (2 : ℕ)) ≤
      ({x | t * ‖f x‖ ^ (p - 1) ≤ K}.indicator
        (fun x => ENNReal.ofReal (‖f x‖ ^ (2 : ℕ))) x) := by
  by_cases hx : t * ‖f x‖ ^ (p - 1) ≤ K
  · simp [q4PowerCutoffLow, hx]
  · simp [q4PowerCutoffLow, hx]

/-- Integrating the pointwise high-amplitude estimate.  The explicit
integrability hypotheses are the ordinary Schwartz-data facts in the shell
application. -/
theorem integral_norm_q4PowerCutoffHigh_le
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {p K t : ℝ}
    (hp1 : 1 < p) (hK : 0 < K) (ht : 0 < t) (f : α → E)
    (hhigh : Integrable (q4PowerCutoffHigh p K t f) μ)
    (hmajor : Integrable (fun x => (t / K) * ‖f x‖ ^ p) μ) :
    (∫ x, ‖q4PowerCutoffHigh p K t f x‖ ∂μ) ≤
      (t / K) * ∫ x, ‖f x‖ ^ p ∂μ := by
  calc
    (∫ x, ‖q4PowerCutoffHigh p K t f x‖ ∂μ) ≤
        ∫ x, (t / K) * ‖f x‖ ^ p ∂μ := by
          apply integral_mono hhigh.norm hmajor
          intro x
          exact norm_q4PowerCutoffHigh_le hp1 hK ht f x
    _ = (t / K) * ∫ x, ‖f x‖ ^ p ∂μ := by rw [integral_const_mul]

/-- A measurable input has a measurable low-cutoff square profile.  This is
the only parameter measurability needed by the layer-cake proof. -/
theorem measurable_lintegral_q4PowerCutoffLow_sq
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} [SFinite μ]
    {p : ℝ} (hp1 : 1 < p) (K : ℝ) (f : α → E)
    (hf : Measurable f) :
    Measurable (fun t : ℝ =>
      ∫⁻ x, ENNReal.ofReal (‖q4PowerCutoffLow p K t f x‖ ^ (2 : ℕ)) ∂μ) := by
  let u : α → ℝ := fun x => ‖f x‖
  let P : Set (ℝ × α) := {z | z.1 * (u z.2) ^ (p - 1) ≤ K}
  have hpminus : 0 < p - 1 := by linarith
  have hu : Measurable u := by
    simpa only [u] using hf.norm
  have hpow : Measurable (fun x => (u x) ^ (p - 1)) :=
    (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hu
  have hP : MeasurableSet P := by
    exact measurableSet_le
      (measurable_fst.mul (hpow.comp measurable_snd)) measurable_const
  let H : ℝ → α → ENNReal := fun t x =>
    P.indicator (fun z : ℝ × α => ENNReal.ofReal ((u z.2) ^ (2 : ℕ))) (t, x)
  have hbase : Measurable (fun z : ℝ × α =>
      ENNReal.ofReal ((u z.2) ^ (2 : ℕ))) :=
    ENNReal.continuous_ofReal.measurable.comp ((hu.comp measurable_snd).pow_const 2)
  have hH : Measurable (Function.uncurry H) := by
    change Measurable (P.indicator (fun z : ℝ × α =>
      ENNReal.ofReal ((u z.2) ^ (2 : ℕ))))
    exact hbase.indicator hP
  have hprofile : Measurable (fun t : ℝ => ∫⁻ x, H t x ∂μ) :=
    Measurable.lintegral_prod_right hH
  convert hprofile using 1
  funext t
  apply lintegral_congr
  intro x
  dsimp only [H, P, u]
  by_cases hcut : t * ‖f x‖ ^ (p - 1) ≤ K <;>
    simp [q4PowerCutoffLow, hcut]

/-- Integrability is preserved by the complementary hard cutoff. -/
theorem integrable_q4PowerCutoffHigh_of_integrable
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    [MeasurableSpace E] [BorelSpace E]
    {μ : Measure α} {p : ℝ} (hp1 : 1 < p) (K t : ℝ)
    (f : α → E) (hfmeas : Measurable f) (hf : Integrable f μ) :
    Integrable (q4PowerCutoffHigh p K t f) μ := by
  let P : Set α := {x | t * ‖f x‖ ^ (p - 1) ≤ K}
  have hpminus : 0 < p - 1 := by linarith
  have hpow : Measurable (fun x => ‖f x‖ ^ (p - 1)) :=
    (continuous_id.rpow_const (fun _ => Or.inr hpminus.le)).measurable.comp hfmeas.norm
  have hP : MeasurableSet P := by
    exact measurableSet_le (measurable_const.mul hpow) measurable_const
  have hfun : q4PowerCutoffHigh p K t f = Pᶜ.indicator f := by
    funext x
    dsimp only [P]
    by_cases hcut : t * ‖f x‖ ^ (p - 1) ≤ K <;>
