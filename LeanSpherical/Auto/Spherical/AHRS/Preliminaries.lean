/-!
# Finite neighbor counting for the `TT*` argument

The analytic `Q4` estimate decomposes a finite radius family according to the
distance between two radii.  At one distance scale, the only combinatorial
input to its square estimate is that the symmetric neighbor relation has
bounded degree.  This file isolates that calculation from the oscillatory
kernel estimates.
-/
open scoped BigOperators

noncomputable section

/-- A symmetric finite neighbor relation of degree at most `K` has `ℓ²`
operator norm at most `K` for its unweighted adjacency sum.  This is the
Cauchy--Schwarz/counting step in the `TT*` estimate at a fixed radius-gap
scale. -/
theorem sum_sq_neighbor_sum_le
    {ι : Type*} (s : Finset ι) (R : ι → ι → Prop) [DecidableRel R]
    (hR : Std.Symm R) (K : ℕ)
    (hdegree : ∀ i ∈ s, (s.filter (R i)).card ≤ K) (a : ι → ℝ) :
    (∑ i ∈ s, (∑ j ∈ s.filter (R i), a j) ^ 2) ≤
      (K : ℝ) ^ 2 * ∑ i ∈ s, a i ^ 2 := by
  classical
  have hpoint (i : ι) (hi : i ∈ s) :
      (∑ j ∈ s.filter (R i), a j) ^ 2 ≤
        (K : ℝ) * ∑ j ∈ s.filter (R i), a j ^ 2 := by
    calc
      (∑ j ∈ s.filter (R i), a j) ^ 2 ≤
          ((s.filter (R i)).card : ℝ) * ∑ j ∈ s.filter (R i), a j ^ 2 :=
        sq_sum_le_card_mul_sum_sq
      _ ≤ (K : ℝ) * ∑ j ∈ s.filter (R i), a j ^ 2 := by
        apply mul_le_mul_of_nonneg_right
        · exact_mod_cast hdegree i hi
        · exact Finset.sum_nonneg fun j hj => sq_nonneg (a j)
  have hrow :
      (∑ i ∈ s, (∑ j ∈ s.filter (R i), a j) ^ 2) ≤
        (K : ℝ) * ∑ i ∈ s, ∑ j ∈ s.filter (R i), a j ^ 2 := by
    calc
      (∑ i ∈ s, (∑ j ∈ s.filter (R i), a j) ^ 2) ≤
          ∑ i ∈ s, (K : ℝ) * ∑ j ∈ s.filter (R i), a j ^ 2 := by
        exact Finset.sum_le_sum fun i hi => hpoint i hi
      _ = (K : ℝ) * ∑ i ∈ s, ∑ j ∈ s.filter (R i), a j ^ 2 := by
        rw [Finset.mul_sum]
  have hdouble :
      (∑ i ∈ s, ∑ j ∈ s.filter (R i), a j ^ 2) =
        ∑ j ∈ s, ∑ i ∈ s.filter (R j), a j ^ 2 := by
    calc
      (∑ i ∈ s, ∑ j ∈ s.filter (R i), a j ^ 2) =
          ∑ i ∈ s, ∑ j ∈ s, if R i j then a j ^ 2 else 0 := by
        apply Finset.sum_congr rfl
        intro i hi
        rw [Finset.sum_filter]
      _ = ∑ j ∈ s, ∑ i ∈ s, if R i j then a j ^ 2 else 0 := by
        exact Finset.sum_comm
      _ = ∑ j ∈ s, ∑ i ∈ s, if R j i then a j ^ 2 else 0 := by
        apply Finset.sum_congr rfl
        intro j hj
        apply Finset.sum_congr rfl
        intro i hi
        by_cases hij : R i j
        · simp [hij, hR.symm i j hij]
        · have hji : ¬ R j i := fun hji => hij (hR.symm j i hji)
          simp [hij, hji]
      _ = ∑ j ∈ s, ∑ i ∈ s.filter (R j), a j ^ 2 := by
        apply Finset.sum_congr rfl
        intro j hj
        rw [Finset.sum_filter]
  have hcolumn (j : ι) (hj : j ∈ s) :
      (∑ i ∈ s.filter (R j), a j ^ 2) ≤ (K : ℝ) * a j ^ 2 := by
    calc
      (∑ _i ∈ s.filter (R j), a j ^ 2) =
          ((s.filter (R j)).card : ℝ) * a j ^ 2 := by
        simp [nsmul_eq_mul]
      _ ≤ (K : ℝ) * a j ^ 2 := by
        apply mul_le_mul_of_nonneg_right
        · exact_mod_cast hdegree j hj
        · exact sq_nonneg (a j)
  have hcolumn_sum :
      (∑ j ∈ s, ∑ i ∈ s.filter (R j), a j ^ 2) ≤
        (K : ℝ) * ∑ j ∈ s, a j ^ 2 := by
    calc
      (∑ j ∈ s, ∑ i ∈ s.filter (R j), a j ^ 2) ≤
          ∑ j ∈ s, (K : ℝ) * a j ^ 2 := by
        exact Finset.sum_le_sum fun j hj => hcolumn j hj
      _ = (K : ℝ) * ∑ j ∈ s, a j ^ 2 := by
        rw [Finset.mul_sum]
  calc
    (∑ i ∈ s, (∑ j ∈ s.filter (R i), a j) ^ 2) ≤
        (K : ℝ) * ∑ i ∈ s, ∑ j ∈ s.filter (R i), a j ^ 2 := hrow
    _ = (K : ℝ) * ∑ j ∈ s, ∑ i ∈ s.filter (R j), a j ^ 2 := by rw [hdouble]
    _ ≤ (K : ℝ) * ((K : ℝ) * ∑ j ∈ s, a j ^ 2) := by
      exact mul_le_mul_of_nonneg_left hcolumn_sum (Nat.cast_nonneg K)
    _ = (K : ℝ) ^ 2 * ∑ i ∈ s, a i ^ 2 := by ring

/-- Normed-space form of `sum_sq_neighbor_sum_le`.  In a `TT*` application,
`v i` is the fibre indexed by the second radius and the triangle inequality
reduces the operator estimate to the scalar neighbor-counting lemma above. -/
theorem sum_sq_norm_neighbor_sum_le
    {ι V : Type*} [NormedAddCommGroup V]
    (s : Finset ι) (R : ι → ι → Prop) [DecidableRel R]
    (hR : Std.Symm R) (K : ℕ)
    (hdegree : ∀ i ∈ s, (s.filter (R i)).card ≤ K) (v : ι → V) :
    (∑ i ∈ s, ‖∑ j ∈ s.filter (R i), v j‖ ^ 2) ≤
      (K : ℝ) ^ 2 * ∑ i ∈ s, ‖v i‖ ^ 2 := by
  have hpoint (i : ι) (hi : i ∈ s) :
      ‖∑ j ∈ s.filter (R i), v j‖ ^ 2 ≤
        (∑ j ∈ s.filter (R i), ‖v j‖) ^ 2 := by
    apply (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg fun j hj => norm_nonneg _)).mpr
    exact norm_sum_le _ _
  calc
    (∑ i ∈ s, ‖∑ j ∈ s.filter (R i), v j‖ ^ 2) ≤
        ∑ i ∈ s, (∑ j ∈ s.filter (R i), ‖v j‖) ^ 2 := by
      exact Finset.sum_le_sum fun i hi => hpoint i hi
    _ ≤ (K : ℝ) ^ 2 * ∑ i ∈ s, ‖v i‖ ^ 2 :=
      sum_sq_neighbor_sum_le s R hR K hdegree fun i => ‖v i‖

end
