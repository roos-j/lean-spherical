/-- A strict point on the `Q1`--`Q3`--`Q4` side has a strict Minkowski
point directly above it on the vertical (common-input) line.  This is the
elementary common-input part of the nonendpoint assembly: the first
reciprocal exponent is unchanged, while the output reciprocal exponent is
increased. -/
theorem exists_strictTriangle123_vertical_above_of_strictTriangle134
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 3 ≤ d ∨ d = 2 ∧ gamma ≤ 1 / 2)
    (hbeta : 0 ≤ beta) (hbeta_gamma : beta ≤ gamma) (hgamma_one : gamma ≤ 1)
    (hx : StrictTriangle134Combination d beta gamma x) :
    ∃ z : ExponentPoint,
      StrictTriangle123Combination d beta z ∧
        z.1 = x.1 ∧ x.2 < z.2 ∧ 0 < z.1 ∧ 0 < z.2 := by
  rcases hx with ⟨a, b, c, ha, hb, hc, habc, hrepr⟩
  have hd2 : 2 ≤ d := by
    rcases hd with hd | hd <;> omega
  have hD : (2 : Real) ≤ (d : Real) := by exact_mod_cast hd2
  have hbeta_one : beta ≤ 1 := hbeta_gamma.trans hgamma_one
  have hgamma : 0 ≤ gamma := hbeta.trans hbeta_gamma
  have hDminus : 0 < (d : Real) - 1 := by linarith
  have hB3 : 0 < (d : Real) - beta + 1 := by linarith
  have hT : 0 < (d : Real) ^ 2 + 2 * gamma - 1 := by
    nlinarith [sq_nonneg ((d : Real) - 2)]
  have hK : 0 < (d : Real) - 1 - beta :=
    theoremOne_diagonal_gap_pos hd hbeta_gamma hgamma_one
  let A : Real := (d : Real) - beta
  have hAone : 1 < A := by
    dsimp only [A]
    linarith
  have hA : 0 < A := by linarith
  have hxfst :
      x.1 = a * Q1.1 + b * (Q3 d beta).1 + c * (Q4 d gamma).1 := by
    have hfst := congrArg Prod.fst hrepr
    simpa only [Prod.smul_fst, Prod.fst_add, smul_eq_mul] using hfst.symm
  have hxsnd :
      x.2 = a * Q1.2 + b * (Q3 d beta).2 + c * (Q4 d gamma).2 := by
    have hsnd := congrArg Prod.snd hrepr
    simpa only [Prod.smul_snd, Prod.snd_add, smul_eq_mul] using hsnd.symm
  have hq3fst : 0 < (Q3 d beta).1 := by
    dsimp [Q3]
    exact div_pos (by linarith) hB3
  have hq4fst : 0 < (Q4 d gamma).1 := by
    dsimp [Q4]
    exact div_pos (mul_pos (by linarith) hDminus) hT
  have hxpos : 0 < x.1 := by
    rw [hxfst]
    simpa [Q1] using add_pos (mul_pos hb hq3fst) (mul_pos hc hq4fst)
  let G : ExponentPoint → Real := fun u =>
    (1 - beta) * u.2 + ((d : Real) - 1) - (d : Real) * u.1
  have hq1gap : 0 < G Q1 := by
    dsimp [G, Q1]
    linarith
  have hq3gap : 0 ≤ G (Q3 d beta) := by
    dsimp only [G]
    linarith [Q3_annulus_identity hd2 hbeta_one]
  have hq4gap : 0 ≤ G (Q4 d gamma) := by
    dsimp only [G]
    linarith [Q4_annulus_le hd2 hbeta hbeta_gamma]
  have hxgap_identity :
      G x = a * G Q1 + b * G (Q3 d beta) + c * G (Q4 d gamma) := by
    dsimp only [G]
    rw [hxfst, hxsnd]
    linear_combination -((d : Real) - 1) * habc
  have hxgap : 0 < G x := by
    rw [hxgap_identity]
