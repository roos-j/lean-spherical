        A * (t ^ (1 - p) * ∫ x, ‖f x‖ ^ p) := by
  obtain ⟨low, high, hlow, hhigh, hsplit⟩ :=
    exists_schwartz_rational_low_high f t
  have hlowBound := q4_sqrt_rational_low_integral_sq_le
    f low high ht hp1 hp2 hlow hhigh
  have hhighBound := q4_rational_high_integral_le
    f low high ht hp1 hp2 hlow hhigh
  have hsplit' : f = low + high := by
    ext x
    exact hsplit x
  have hsub : ∀ g h : SchwartzMap (Euclidean d) ℂ,
      ‖U (g + h)‖ ≤ ‖U g‖ + ‖U h‖ := by
    intro g h
    rw [U.map_add]
    exact norm_add_le _ _
  exact norm_le_of_one_two_amplitude_split U
    (fun g => ∫ x : Euclidean d, ‖g x‖)
    (fun g => √(∫ x : Euclidean d, ‖g x‖ ^ (2 : ℕ)))
    A B (∫ x : Euclidean d, ‖f x‖ ^ p) p t
    (fun _ => low) (fun _ => high) f
    hsub hone htwo hA hB hsplit' hlowBound hhighBound

/-- The value of the balanced amplitude expression at the canonical scale.
This is purely the real-power algebra needed to turn the preceding
fixed-scale estimate into a homogeneous `Lᵖ` estimate. -/
theorem q4_balanced_amplitude_rhs_eq
    {A B I p : ℝ} (hA : 0 < A) (hB : 0 < B) (hI : 0 < I) (hp : p ≠ 0) :
    let t := (A * I ^ ((1 : ℝ) / 2) / B) ^ (2 / p)
    2 * (B * (t ^ ((2 - p) / 2) * I ^ ((1 : ℝ) / 2))) =
      2 * (A ^ (2 / p - 1) * B ^ (2 - 2 / p) * I ^ (1 / p)) := by
  dsimp
  let X : ℝ := A * I ^ ((1 : ℝ) / 2) / B
  have hX : 0 < X := by
    dsimp [X]
    exact div_pos (mul_pos hA (Real.rpow_pos_of_pos hI _)) hB
  have hpow :
      (X ^ (2 / p)) ^ ((2 - p) / 2) = X ^ (2 / p - 1) := by
    rw [← Real.rpow_mul hX.le]
    congr 1
    field_simp
  rw [hpow]
  change 2 * (B * (X ^ (2 / p - 1) * I ^ ((1 : ℝ) / 2))) = _
  rw [show X = (A * I ^ ((1 : ℝ) / 2)) / B by rfl]
  rw [Real.div_rpow (mul_nonneg hA.le (Real.rpow_nonneg hI.le _)) hB.le]
  rw [Real.mul_rpow hA.le (Real.rpow_nonneg hI.le _)]
  rw [← Real.rpow_mul hI.le]
  rw [div_eq_mul_inv, ← Real.rpow_neg hB.le]
  have hBcombine : B * B ^ (-(2 / p - 1)) = B ^ (2 - 2 / p) := by
    calc
      B * B ^ (-(2 / p - 1)) = B ^ (1 : ℝ) * B ^ (-(2 / p - 1)) := by
        rw [Real.rpow_one]
      _ = B ^ (1 + -(2 / p - 1)) := (Real.rpow_add hB 1 _).symm
      _ = B ^ (2 - 2 / p) := by
        congr 1
        ring
  have hIcombine :
      I ^ ((1 / 2) * (2 / p - 1)) * I ^ ((1 : ℝ) / 2) = I ^ (1 / p) := by
    calc
      I ^ ((1 / 2) * (2 / p - 1)) * I ^ ((1 : ℝ) / 2) =
          I ^ ((1 / 2) * (2 / p - 1) + (1 : ℝ) / 2) :=
        (Real.rpow_add hI _ _).symm
      _ = I ^ (1 / p) := by
        congr 1
        field_simp
        ring
  calc
    2 * (B * (A ^ (2 / p - 1) * I ^ ((1 / 2) * (2 / p - 1)) *
        B ^ (-(2 / p - 1)) * I ^ ((1 : ℝ) / 2))) =
        2 * (A ^ (2 / p - 1) *
          (B * B ^ (-(2 / p - 1))) *
          (I ^ ((1 / 2) * (2 / p - 1)) * I ^ ((1 : ℝ) / 2))) := by ring
    _ = 2 * (A ^ (2 / p - 1) * B ^ (2 - 2 / p) * I ^ (1 / p)) := by
      rw [hBcombine, hIcombine]

/-- The homogeneous version of
`q4_linear_schwartz_one_two_amplitude_bound` when the input `p`-moment and
the two endpoint constants are positive.  It is a bona fide interior strong
estimate for the common-target factor; the only remaining `TT*` step is the
separate duality/factorization argument. -/
theorem q4_linear_schwartz_one_two_strong_bound_of_pos
    {d : Nat} {H : Type*} [NormedAddCommGroup H] [NormedSpace ℝ H]
    (U : SchwartzMap (Euclidean d) ℂ →ₗ[ℝ] H)
    {A B p : ℝ} (hA : 0 < A) (hB : 0 < B)
    (hone : ∀ g : SchwartzMap (Euclidean d) ℂ,
      ‖U g‖ ≤ A * ∫ x, ‖g x‖)
    (htwo : ∀ g : SchwartzMap (Euclidean d) ℂ,
      ‖U g‖ ≤ B * √(∫ x, ‖g x‖ ^ (2 : ℕ)))
    (f : SchwartzMap (Euclidean d) ℂ)
    (hp1 : 1 < p) (hp2 : p < 2)
    (hI : 0 < ∫ x : Euclidean d, ‖f x‖ ^ p) :
    ‖U f‖ ≤
      2 * (A ^ (2 / p - 1) * B ^ (2 - 2 / p) *
        (∫ x : Euclidean d, ‖f x‖ ^ p) ^ (1 / p)) := by
  let I : ℝ := ∫ x : Euclidean d, ‖f x‖ ^ p
  let t : ℝ := (A * I ^ ((1 : ℝ) / 2) / B) ^ (2 / p)
  have hp : p ≠ 0 := by linarith
  have hX : 0 < A * I ^ ((1 : ℝ) / 2) / B := by
    exact div_pos (mul_pos hA (Real.rpow_pos_of_pos (by simpa [I] using hI) _)) hB
  have ht : 0 < t := by
    dsimp [t]
    exact Real.rpow_pos_of_pos hX _
  have hraw := q4_linear_schwartz_one_two_amplitude_bound U hA.le hB.le
    hone htwo f ht hp1 hp2
  have hpower : t ^ (p / 2) = A * I ^ ((1 : ℝ) / 2) / B := by
    dsimp [t]
    exact canonical_one_two_amplitude_scale hA hB (by simpa [I] using hI) hp
  have hbalance :
      B * (t ^ ((2 - p) / 2) * I ^ ((1 : ℝ) / 2)) =
        A * (t ^ (1 - p) * I) :=
    one_two_amplitude_balance_of_rpow (by simpa [I] using hI) ht hB hpower
  have hhomogeneous :
      2 * (B * (t ^ ((2 - p) / 2) * I ^ ((1 : ℝ) / 2))) =
        2 * (A ^ (2 / p - 1) * B ^ (2 - 2 / p) * I ^ (1 / p)) := by
    exact q4_balanced_amplitude_rhs_eq hA hB (by simpa [I] using hI) hp
  change ‖U f‖ ≤
    2 * (A ^ (2 / p - 1) * B ^ (2 - 2 / p) * I ^ (1 / p))
  calc
    ‖U f‖ ≤ B * (t ^ ((2 - p) / 2) * I ^ ((1 : ℝ) / 2)) +
        A * (t ^ (1 - p) * I) := by
      simpa only [I, t] using hraw
    _ = 2 * (B * (t ^ ((2 - p) / 2) * I ^ ((1 : ℝ) / 2))) := by
      rw [← hbalance]
      ring
    _ = _ := hhomogeneous

end
