/-- Strict barycentric coordinates in the quasi-Assouad triangle from the
strict cap, diagonal, and clustered-edge inequalities. -/
theorem strictTriangle134Combination_of_strict_halfspaces
    {d : Nat} {beta gamma : Real} {x : ExponentPoint}
    (hd : 2 ≤ d) (hbeta : 0 < beta) (hbeta_one : beta ≤ 1)
    (hbeta_gamma : beta ≤ gamma)
    (hcap : x.1 < (d : Real) * x.2)
    (hdiagonal : ((d : Real) - beta) * x.2 < x.1)
    (hcluster : 0 < clusterEdgeFunctional d (beta / gamma) beta x) :
    StrictTriangle134Combination d beta gamma x := by
  let D : Real := d
  let H : Real := D - 1
  let A : Real := D - beta
  let B : Real := A + 1
  let T : Real := D ^ 2 + 2 * gamma - 1
  let alpha : Real := beta / gamma
  let C : Real := alpha / 2 * H
  let w3 : Real := (D * x.2 - x.1) * B / beta
  let w4 : Real := (x.1 - A * x.2) * T / (beta * H)
  let w1 : Real := 1 - w3 - w4
  have hD : 2 ≤ D := by
    simpa only [D] using (show (2 : Real) ≤ (d : Real) by exact_mod_cast hd)
  have hgamma : 0 < gamma := lt_of_lt_of_le hbeta hbeta_gamma
  have hH : 0 < H := by dsimp [H]; linarith
  have hB : 0 < B := by dsimp [B, A]; linarith
  have hT : 0 < T := by
    dsimp [T]
    nlinarith [sq_nonneg (D - 2)]
  have halpha : 0 < alpha := by dsimp [alpha]; exact div_pos hbeta hgamma
  have hC : 0 < C := by
    dsimp [C]
    exact mul_pos (div_pos halpha (by norm_num)) hH
  have hD0 : (d : Real) - 1 ≠ 0 := by linarith
  have hB0 : (d : Real) - beta + 1 ≠ 0 := by linarith
  have hT0 : (d : Real) ^ 2 + 2 * gamma - 1 ≠ 0 := by
    change D ^ 2 + 2 * gamma - 1 ≠ 0
    exact hT.ne'
  have hgamma0 : gamma ≠ 0 := hgamma.ne'
  have hw3 : 0 < w3 := by
    apply div_pos
    · exact mul_pos (by dsimp [D]; linarith) hB
    · exact hbeta
  have hw4 : 0 < w4 := by
    apply div_pos
    · exact mul_pos (by dsimp [A]; linarith) hT
    · exact mul_pos hbeta hH
  have hweight_identity : clusterEdgeFunctional d (beta / gamma) beta x = C * w1 := by
    dsimp [D, H, A, B, T, alpha, C, w1, w3, w4, clusterEdgeFunctional]
    field_simp [hD0, hB0, hT0, hgamma0, hbeta.ne']
    ring
  have hw1 : 0 < w1 := by
    rw [hweight_identity] at hcluster
    nlinarith
  have hsum : w1 + w3 + w4 = 1 := by
    dsimp [w1]
    ring
  have hrepr : w1 • Q1 + w3 • Q3 d beta + w4 • Q4 d gamma = x := by
    ext <;> dsimp [D, H, A, B, T, alpha, C, w1, w3, w4, Q1, Q3, Q4]
    all_goals field_simp [hD0, hB0, hT0, hgamma0, hbeta.ne']
    all_goals ring
  exact ⟨w1, w3, w4, hw1, hw3, hw4, hsum, hrepr⟩

