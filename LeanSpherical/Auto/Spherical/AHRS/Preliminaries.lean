/-!
# Passing a radius cover to the maximal operator

The analytic estimates in the fractal-dilation argument are applied on each
member of a finite radius cover.  This file contains the elementary
order-theoretic reduction from the maximal operator over a covered set to the
finite family of interval maximal operators.  No Fourier estimate is used
here.
-/
open Set

noncomputable section

/-- A finite interval cover of the radius set dominates its spherical
maximal operator by the supremum of the interval maximal operators. -/
theorem fractalSphericalMaximal_le_iSup_intervalCover
    {d : ℕ} {E : Set ℝ} {δ : ℝ} {ι : Finset ℝ}
    (hcover : IsIntervalCover E δ ι)
    (f : Euclidean d → ℂ) (x : Euclidean d) :
    fractalSphericalMaximal d E f x ≤
      ⨆ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x := by
  apply iSup_le
  intro t
  have htcover : t.1 ∈ ⋃ c ∈ ι, Icc (c - δ / 2) (c + δ / 2) :=
    hcover t.2
  rcases Set.mem_iUnion.mp htcover with ⟨c, htcover⟩
  rcases Set.mem_iUnion.mp htcover with ⟨hc, hct⟩
  calc
    ENNReal.ofReal ‖normalizedSphericalAverage d f t.1 x‖ ≤
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x :=
      le_iSup (fun r : Icc (c - δ / 2) (c + δ / 2) =>
        ENNReal.ofReal ‖normalizedSphericalAverage d f r.1 x‖) ⟨t.1, hct⟩
    _ ≤ ⨆ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x :=
      le_iSup_of_le c (le_iSup_of_le hc le_rfl)

/-- The finite supremum on the right of the cover reduction is bounded by
the corresponding finite sum. -/
theorem iSup_intervalCover_le_sum
    {d : ℕ} {δ : ℝ} (ι : Finset ℝ)
    (f : Euclidean d → ℂ) (x : Euclidean d) :
    (⨆ c ∈ ι,
      fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x) ≤
      ∑ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x := by
  apply iSup_le
  intro c
  apply iSup_le
  intro hc
  apply Finset.single_le_sum
    (s := ι)
    (f := fun c : ℝ =>
      fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x)
  · intro i hi
    simp
  · exact hc

/-- Combining the two elementary reductions gives a finite-sum majorant for
the maximal operator over any interval-covered radius set. -/
theorem fractalSphericalMaximal_le_sum_intervalCover
    {d : ℕ} {E : Set ℝ} {δ : ℝ} {ι : Finset ℝ}
    (hcover : IsIntervalCover E δ ι)
    (f : Euclidean d → ℂ) (x : Euclidean d) :
    fractalSphericalMaximal d E f x ≤
      ∑ c ∈ ι,
        fractalSphericalMaximal d (Icc (c - δ / 2) (c + δ / 2)) f x :=
  (fractalSphericalMaximal_le_iSup_intervalCover hcover f x).trans
    (iSup_intervalCover_le_sum (δ := δ) ι f x)

end
