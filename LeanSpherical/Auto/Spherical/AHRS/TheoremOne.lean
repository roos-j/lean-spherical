    obtain ⟨Cderivative, hCderivative, hderivativeDecay⟩ :=
      exists_hasQ4ScaledNormdDySurfRadDerivPairKernelGapDecayOn_absDyBp_of_three_le
        hd3 phi hphiOne hphiZero hphiNorm hphiRadial
    let Bendpoint : Nat -> Real := fun j =>
      q4EnlargedPairMultiplierBound C0 (((d - 1 : Nat) : Real) / 2) j
