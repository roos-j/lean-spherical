/-- The strict-gain specialization of
`q4_active_ltwo_dyadic_rate_of_fixed_normRadial_cutoff`.  This keeps the
older source interface available for the parts of the proof that reassemble
a summable dyadic series. -/
theorem q4_active_ltwo_strict_dyadic_rate_of_fixed_normRadial_cutoff
    {d : Nat} {E : Set Real} {gamma eta Ccover : Real}
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ <= 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 <= ‖xi‖ -> phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ <= 1)
    (hphiRadial : IsNormRadial phi)
    (hd : 3 <= d ∨ d = 2 ∧ gamma <= 1 / 2)
    (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma) (heta : 0 <= eta)
    {u r : Real} (hu1 : 1 < u) (hu2 : u < 2)
    (hr : r = u / (u - 1))
    (ha : q4FrequencyExponentWithSubpowerLoss d (2 / r) eta < 0)
    (hb : q4GapExponent d gamma (2 / r) < 0) :
    ∃ CT rho : ENNReal, 0 < CT ∧ CT < ⊤ ∧ rho < 1 ∧
      rho = ENNReal.ofReal
        ((2 : Real) ^
          (q4FrequencyExponentWithSubpowerLoss d (2 / r) eta / 2)) ∧
      ∀ j : Nat, 1 <= j -> ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal r) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal r) volume <=
          CT * rho ^ j * ENNReal.ofReal
            (Real.sqrt (∫ x, ‖(f : Euclidean d -> Complex) x‖ ^ (2 : Nat))) := by
  obtain ⟨CT, rho, hCT, hCTtop, hrhotop, hrhoeq, hbound⟩ :=
    q4_active_ltwo_dyadic_rate_of_fixed_normRadial_cutoff
      phi hphiOne hphiZero hphiNorm hphiRadial hd hE hEne hcover hCcover
      hgamma heta hu1 hu2 hr hb
  refine ⟨CT, rho, hCT, hCTtop, ?_, hrhoeq, hbound⟩
  have hrhoReal := q4_sqrt_frequency_ratio_mem_Ioo ha
  rw [hrhoeq, ← ENNReal.ofReal_one]
  exact (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hrhoReal.1.le).mpr hrhoReal.2

/-- The literal zero-gap Q4 endpoint estimate with a prescribed dyadic
subpower loss.  At the balancing parameter the finite range `n < j + 3`
produces a `sqrt (j + 3)` factor.  The proof below uses the exact finite-shell
calculation from `Q4LtwoDyadicRate` and absorbs that factor into the supplied
loss; no restricted weak-type endpoint principle is invoked. -/
theorem q4_active_ltwo_zero_gap_loss_of_fixed_normRadial_cutoff
    {d : Nat} {E : Set Real} {gamma eta epsilon Ccover : Real}
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ <= 1 -> phi xi = 1)
    (hphiZero : ∀ xi, 2 <= ‖xi‖ -> phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ <= 1)
    (hphiRadial : IsNormRadial phi)
    (hd : 3 <= d ∨ d = 2 ∧ gamma <= 1 / 2)
    (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    (hcover : HasSubpowerAssouadCoverBound E gamma eta Ccover)
    (hCcover : 0 <= Ccover) (hgamma : 0 <= gamma) (heta : 0 <= eta)
    {u r : Real} (hu1 : 1 < u) (hu2 : u < 2)
    (hr : r = u / (u - 1))
    (hgap : q4GapExponent d gamma (2 / r) = 0)
    (hepsilon : 0 < epsilon) :
    ∃ CT rho : ENNReal, 0 < CT ∧ CT < ⊤ ∧ rho < ⊤ ∧
      rho = ENNReal.ofReal
        ((2 : Real) ^
          ((q4FrequencyExponentWithSubpowerLoss d (2 / r) eta +
            2 * epsilon) / 2)) ∧
      ∀ j : Nat, 1 <= j -> ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal r) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
