        C2 * rho2 ^ j *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal r1) volume)
    {Czero : ENNReal} (hCzerotop : Czero < ⊤)
    (hzero : ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal q) volume ≤
        Czero * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :
    HasFractalSphericalStrongType d E p q := by
  have hp0 : 0 < p := lt_trans (lt_trans zero_lt_one hr0one) hr0p
  have hp1 : 1 < p := lt_trans hr0one hr0p
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  obtain ⟨C, rho, hCtop, hrho, hinter⟩ :=
    strict_triangle123_dyadic_rate_of_literal_q2_q3_rates
      hd E hE phi hphiOne hphiZero
      hr0one hr0p hpr1 hq hC3top hC2top hrho3 hrho2 hQ3 hQ2
  obtain ⟨CR, hCRtop, hregular⟩ :=
    absolute_lowpass_improving_eLpNorm hd E hE phi hphiZero hphiNorm hp1 hpq
  let CT : ENNReal := Czero + C
  have hCTtop : CT < ⊤ := by
    dsimp only [CT]
    exact ENNReal.add_lt_top.mpr ⟨hCzerotop, hCtop⟩
  apply absolute_off_diagonal_reassembly_from_eLpNorm
    hd hp0 hq E hEpos phi hphiOne hphiZero CR CT rho
      hCRtop hCTtop hrho hregular
  intro j f
  by_cases hj : j = 0
  · subst j
    obtain ⟨hmem, hbound⟩ := hzero f
    refine ⟨hmem, ?_⟩
    simpa only [pow_zero, mul_one] using
      hbound.trans (mul_le_mul_left
        (le_add_of_nonneg_right bot_le) _)
  · have hjone : 1 ≤ j := by omega
    obtain ⟨hmem, hbound⟩ := hinter j hjone f
    refine ⟨hmem, ?_⟩
    have hcoef : C ≤ CT := by
      dsimp only [CT]
      exact le_add_of_nonneg_left bot_le
    calc
      eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ≤
          (C * rho ^ j) *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
        by simpa only [mul_assoc] using hbound
      _ = C * (rho ^ j *
              eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) := by
        ring
      _ ≤ CT * (rho ^ j *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :=
        mul_le_mul_left hcoef _
      _ = _ := by ring

/-- The complementary strict dyadic interpolation in the Minkowski triangle.

Here the input exponent is fixed.  The lower output endpoint is the strict
diagonal Q2 estimate and the upper endpoint is the strict Q3 estimate.  In
reciprocal coordinates this is exactly the portion on the Q2 side of the
line through `Q1` and `Q3` (equivalently, the portion with `1 / p + 1 / q`
above one).  It is an ordinary strong interpolation step; the physical
`L¹ -> L∞` argument has already been used in the literal Q3 estimate.

Keeping this as a separate theorem is essential: the common-output argument
above only covers the other side of that line. -/
theorem strict_triangle123_dyadic_rate_of_literal_q2_q3_common_input_rates
    {d : Nat}
    (E : Set Real)
    (phi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    {p q0 q q1 : Real}
    (hp : 0 < p) (hq0 : 0 < q0) (hq0q : q0 < q) (hqq1 : q < q1)
    {C2 rho2 C3 rho3 : ENNReal}
    (hC2top : C2 < ⊤) (hC3top : C3 < ⊤)
    (hrho2 : rho2 < 1) (hrho3 : rho3 < 1)
    (hQ2 : ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q0) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q0) volume ≤
        C2 * rho2 ^ j *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume)
    (hQ3 : ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q1) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q1) volume ≤
        C3 * rho3 ^ j *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :
    ∃ C rho : ENNReal, C < ⊤ ∧ rho < 1 ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ≤
          (C * rho ^ j) *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let T : Nat → SchwartzMap (Euclidean d) Complex → Euclidean d → Real :=
    fun j f => fractalDyadicBandpassMaximal d E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f
  have hTmeas : ∀ j f, AEStronglyMeasurable (T j f) volume := by
    intro j f
    dsimp only [T]
    exact (measurable_fractalDyadicBandpassMaximal E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f).aestronglyMeasurable
  have hTnonneg : ∀ j f x, 0 ≤ T j f x := by
    intro j f x
    dsimp only [T]
    exact fractalDyadicBandpassMaximal_nonneg E
      (absoluteDyadicBandpass phi hphiOne hphiZero j) f x
  obtain ⟨C, rho, hCtop, hrho, hinter⟩ :=
    memLp_and_eLpNorm_schwartz_of_two_strong_output_dyadic_rates
      T hTmeas hTnonneg hp hq0 hq0q hqq1 hC2top hC3top hrho2 hrho3
      (by
        intro j hj f
        simpa only [T] using hQ2 j hj f)
      (by
        intro j hj f
        simpa only [T] using hQ3 j hj f)
  exact ⟨C, rho, hCtop, hrho, by
    intro j hj f
    simpa only [T] using hinter j hj f⟩

/-- Reassembly for the fixed-input part of the strict Q1--Q2--Q3 triangle.
The high-frequency rate is the preceding ordinary interpolation argument;
the zeroth band is supplied by the compact physical lowpass estimate. -/
theorem strict_triangle123_strong_type_of_literal_q2_q3_common_input_rates
    {d : Nat} (hd : 0 < d)
    (E : Set Real) (hE : E ⊆ Icc (1 : Real) 2)
    (phi psi : SchwartzMap (Euclidean d) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (_hpsi : ∀ xi : Euclidean d,
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q0 q q1 : Real}
    (hpone : 1 < p) (hq0 : 0 < q0) (hq0q : q0 < q)
    (hqq1 : q < q1) (hpq : p < q) (hqq : 1 ≤ q)
    {C2 rho2 C3 rho3 : ENNReal}
    (hC2top : C2 < ⊤) (hC3top : C3 < ⊤)
    (hrho2 : rho2 < 1) (hrho3 : rho3 < 1)
    (hQ2 : ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q0) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q0) volume ≤
        C2 * rho2 ^ j *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume)
    (hQ3 : ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q1) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
        (ENNReal.ofReal q1) volume ≤
        C3 * rho3 ^ j *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume)
    {Czero : ENNReal} (hCzerotop : Czero < ⊤)
    (hzero : ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal q) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal d E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal q) volume ≤
        Czero * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :
    HasFractalSphericalStrongType d E p q := by
  have hp0 : 0 < p := lt_trans zero_lt_one hpone
  have hEpos : E ⊆ Ioi (0 : Real) := by
    intro t ht
    exact lt_of_lt_of_le zero_lt_one (hE ht).1
  obtain ⟨C, rho, hCtop, hrho, hinter⟩ :=
    strict_triangle123_dyadic_rate_of_literal_q2_q3_common_input_rates
      E phi hphiOne hphiZero hp0 hq0 hq0q hqq1
      hC2top hC3top hrho2 hrho3 hQ2 hQ3
  obtain ⟨CR, hCRtop, hregular⟩ :=
    absolute_lowpass_improving_eLpNorm hd E hE phi hphiZero hphiNorm hpone hpq
  let CT : ENNReal := Czero + C
  have hCTtop : CT < ⊤ := by
    dsimp only [CT]
    exact ENNReal.add_lt_top.mpr ⟨hCzerotop, hCtop⟩
  apply absolute_off_diagonal_reassembly_from_eLpNorm
    hd hp0 hqq E hEpos phi hphiOne hphiZero CR CT rho
      hCRtop hCTtop hrho hregular
  intro j f
  by_cases hj : j = 0
  · subst j
    obtain ⟨hmem, hbound⟩ := hzero f
    refine ⟨hmem, ?_⟩
    simpa only [pow_zero, mul_one] using
      hbound.trans (mul_le_mul_left
        (le_add_of_nonneg_right bot_le) _)
  · have hjone : 1 ≤ j := by omega
    obtain ⟨hmem, hbound⟩ := hinter j hjone f
    refine ⟨hmem, ?_⟩
    have hcoef : C ≤ CT := by
      dsimp only [CT]
      exact le_add_of_nonneg_left bot_le
    calc
      eLpNorm (fractalDyadicBandpassMaximal d E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ≤
          (C * rho ^ j) *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
        by simpa only [mul_assoc] using hbound
      _ = C * (rho ^ j *
              eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) := by
        ring
      _ ≤ CT * (rho ^ j *
            eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :=
        mul_le_mul_left hcoef _
      _ = _ := by ring

/-- Higher-dimensional physical Q1--Q2--Q3 assembly at an arbitrary strict
vertical source.  `p3` is the Q3 input exponent, while `rQ` and `rP` are
strictly sub-`L²` diagonal exponents used to obtain the Q2 estimates at the
common output and at the level-zero input respectively.  This formulation is
particularly useful when the final Q3--Q4 interpolation chooses a nearby
vertical source before absorbing the Q4 subpower loss. -/
theorem strict_triangle123_higher_strong_type_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (_hphiRadial : ∀ xi eta : Euclidean (n + 1), ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q p3 rQ rP eps3 : Real}
    (hp3one : 1 < p3) (hp3two : p3 < 2)
    (hqconj : q = p3 / (p3 - 1)) (heps3 : 0 < eps3)
    (hQ3strict : q < (n : Real) + 2 - (beta + eps3))
    (hp3p : p3 < p) (hpq : p < q) (hqone : 1 ≤ q)
    (hrQone : 1 < rQ) (hrQtwo : rQ < 2) (hrQcrit : beta < n * (rQ - 1))
    (hrQq : rQ < q)
    (hrPone : 1 < rP) (hrPtwo : rP < 2) (hrPcrit : beta < n * (rP - 1))
    (hrPp : rP < p) :
    HasFractalSphericalStrongType (n + 1) E p q := by
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hMinkowski heps3 hp3one hp3two hqconj hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrQone hrQtwo hrQcrit hrQq
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨CP, rhoP, hCP, hCPtop, hrhoP, hrhoPone, hPall⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrPone hrPtwo hrPcrit hrPp
        phi psi hphiOne hphiZero hphiNorm hpsi
  let cP : Real := CP.toReal
  have hcP : 0 < cP := by
    dsimp only [cP]
    exact ENNReal.toReal_pos hCP.ne' hCPtop.ne
  have hdiagP : ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
      MemLp (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal cP *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
    intro f
    obtain ⟨hmem, hbound⟩ := hPall 0 f
    refine ⟨hmem, ?_⟩
    simpa only [cP, pow_zero, mul_one, ENNReal.ofReal_toReal hCPtop.ne] using hbound
  obtain ⟨Czero, hCzerotop, hzero⟩ :=
    compact_bandpass_improving_eLpNorm_of_diagonal
      (d := n + 1) (p := p) (q := q) (by omega) E hE
      (absoluteDyadicBandpass phi hphiOne hphiZero 0)
      (lt_trans hp3one hp3p) hpq ⟨cP, hcP, hdiagP⟩
  exact strict_triangle123_strong_type_of_literal_q2_q3_rates
    (d := n + 1) (r0 := p3) (p := p) (r1 := q) (q := q)
    (by omega) E hE phi psi hphiOne hphiZero hphiNorm hpsi
    hp3one hp3p hpq hpq hqone hC3top hC2top hrho3 hrho2one
    (by
      intro j hj f
      exact hQ3 j hj f)
    (by
      intro j hj f
      exact hQ2all j f)
    hCzerotop hzero

/-- Rate-level version of the common-output physical T123 construction.

This intentionally stops before low-frequency reassembly.  The Q134 argument
needs precisely this literal estimate for the caller-supplied common cutoff
when it interpolates with its Q4 rate. -/
theorem strict_triangle123_higher_common_output_dyadic_rate_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q p3 rQ eps3 : Real}
    (hp3one : 1 < p3) (hp3two : p3 < 2)
    (hqconj : q = p3 / (p3 - 1)) (heps3 : 0 < eps3)
    (hQ3strict : q < (n : Real) + 2 - (beta + eps3))
    (hp3p : p3 < p) (hprQ : p < rQ) (hqone : 1 ≤ q)
    (hrQone : 1 < rQ) (hrQtwo : rQ < 2)
    (hrQcrit : beta < n * (rQ - 1)) (hrQq : rQ < q) :
    ∃ C rho : ENNReal, C < ⊤ ∧ rho < 1 ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
        MemLp (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ∧
        eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
          (absoluteDyadicBandpass phi hphiOne hphiZero j) f)
          (ENNReal.ofReal q) volume ≤
          (C * rho ^ j) *
            eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hMinkowski heps3 hp3one hp3two hqconj hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrQone hrQtwo hrQcrit hrQq
        phi psi hphiOne hphiZero hphiNorm hpsi
  exact strict_triangle123_dyadic_rate_of_literal_q2_q3_rates
    (d := n + 1) (by omega) E hE phi hphiOne hphiZero
    hp3one hp3p (lt_trans hprQ hrQq) hqone hC3top hC2top hrho3 hrho2one
    (by
      intro j hj f
      exact hQ3 j hj f)
    (by
      intro j hj f
      exact hQ2all j f)

/-- Higher-dimensional physical assembly on the Q2 side of the strict
Q1--Q2--Q3 triangle.  The Q2 rate is used at the final input exponent `p`,
while the physical Q3 argument gives the conjugate output `p / (p - 1)` at
that same input.  Ordinary same-input interpolation fills every strict
intermediate output. -/
theorem strict_triangle123_higher_common_input_strong_type_of_physical_parameters
    {n : Nat} (hn : 2 ≤ n)
    {E : Set Real} (hE : E ⊆ Icc (1 : Real) 2) (hEne : E.Nonempty)
    {beta : Real} (hbeta : 0 ≤ beta)
    (hMinkowski : upperMinkowskiDimension E = beta)
    (phi psi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1)
    (_hphiRadial : ∀ xi eta : Euclidean (n + 1), ‖xi‖ = ‖eta‖ → phi xi = phi eta)
    (hpsi : ∀ xi : Euclidean (n + 1),
      psi xi = phi (((2 : Real) ^ (0 + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ 0)⁻¹ • xi))
    {p q r eps3 : Real}
    (hpone : 1 < p) (hptwo : p < 2) (hpq : p < q)
    (hqpconj : q < p / (p - 1))
    (heps3 : 0 < eps3)
    (hQ3strict : p / (p - 1) < (n : Real) + 2 - (beta + eps3))
    (hrone : 1 < r) (hrtwo : r < 2)
    (hrcrit : beta < n * (r - 1)) (hrp : r < p) :
    HasFractalSphericalStrongType (n + 1) E p q := by
  obtain ⟨C2, rho2, hC2, hC2top, hrho2, hrho2one, hQ2all⟩ :=
    q2_physical_upper_diagonal_dyadic_rate_of_upperMinkowskiDimension_eq
      hn hE hEne hbeta hMinkowski hrone hrtwo hrcrit hrp
        phi psi hphiOne hphiZero hphiNorm hpsi
  obtain ⟨C3, rho3, hC3, hC3top, hrho3, -, hQ3⟩ :=
    q3_physical_strict_normalized_dyadic_rate_of_upperMinkowskiDimension_eq
      (p := p) (q := p / (p - 1))
      hn hE hEne hMinkowski heps3 hpone hptwo (by rfl) hQ3strict
        phi psi hphiOne hphiZero hphiNorm hpsi
  let cP : Real := C2.toReal
  have hcP : 0 < cP := by
    dsimp only [cP]
    exact ENNReal.toReal_pos hC2.ne' hC2top.ne
  have hdiagP : ∀ f : SchwartzMap (Euclidean (n + 1)) Complex,
      MemLp (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ∧
      eLpNorm (fractalDyadicBandpassMaximal (n + 1) E
        (absoluteDyadicBandpass phi hphiOne hphiZero 0) f)
        (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal cP *
          eLpNorm (f : Euclidean (n + 1) → Complex) (ENNReal.ofReal p) volume := by
    intro f
    obtain ⟨hmem, hbound⟩ := hQ2all 0 f
    refine ⟨hmem, ?_⟩
    simpa only [cP, pow_zero, mul_one, ENNReal.ofReal_toReal hC2top.ne] using hbound
