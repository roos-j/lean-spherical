          (Ckernel := Cendpoint) (C := C0) (q := r)
          hrgtwo hCendpoint hCcover hgamma heta k n
      simpa only [Bendpoint, Aendpoint, E0, a, b, hb, zero_mul, add_zero, Nat.cast_ofNat,
          Nat.cast_sub hdpos, Nat.cast_one, (show (2 : Real) - 1 = 1 from by norm_num)] using hraw
    have hlevelDerivative : ∀ k n : Nat,
        q4ActiveDyadicLevelStrongConstant d gamma eta Ccover Cderivative
          (Bderivative k) k n r <=
          ENNReal.ofReal (Aderivative * (2 : Real) ^ (a * (k : Real))) := by
