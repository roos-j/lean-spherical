  have hdsource : 3 <= d ∨ d = 2 ∧ gamma <= 1 / 2 := by
    rcases hd with hd3 | htwo
    · exact Or.inl hd3
    · exact Or.inr htwo
  obtain ⟨C0, hC0, hdecay0⟩ :=
    (exists_theoremOneSharpSurfaceFourierInput
      (d := d) (gamma := gamma) hdsource).decay
