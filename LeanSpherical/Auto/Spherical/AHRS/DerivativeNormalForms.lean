  have hnorm : ‖r • xi‖ = r * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos]
  have hlower : R / 2 <= ‖r • xi‖ := by
    rw [hnorm]
    calc
      R / 2 = (1 / 2 : Real) * R := by ring
      _ <= r * R := mul_le_mul_of_nonneg_right hr.1 hRpos.le
      _ <= r * ‖xi‖ := mul_le_mul_of_nonneg_left hxi.le hrpos.le
  have hargOne : 1 <= ‖r • xi‖ := by
    calc
      (1 : Real) <= R / 2 := by linarith
      _ <= ‖r • xi‖ := hlower
  have hbasepos : 0 < (R / 2) ^ a :=
    Real.rpow_pos_of_pos (by positivity) _
  have hpow : (R / 2) ^ a <= ‖r • xi‖ ^ a :=
    Real.rpow_le_rpow (by positivity) hlower ha
  have hsurface : ‖surfaceFourier (n + 1) (r • xi)‖ <= C / (R / 2) ^ a := by
    calc
      ‖surfaceFourier (n + 1) (r • xi)‖ <= C / ‖r • xi‖ ^ a := by
        simpa only [a] using hdecay (r • xi) hargOne
      _ <= C / (R / 2) ^ a :=
        div_le_div_of_nonneg_left hC.le hbasepos hpow
  have hbnorm : ‖b‖ <= 2 := by
    dsimp only [b]
    rw [absoluteDyadicBandpass_spec]
    exact norm_smooth_dyadic_bandpass_le_two hphiNorm j xi
  change ‖surfaceFourier (n + 1) (r • xi) * b‖ <= _
  rw [norm_mul]
  calc
    ‖surfaceFourier (n + 1) (r • xi)‖ * ‖b‖ <=
        (C / (R / 2) ^ a) * 2 :=
      mul_le_mul hsurface hbnorm (norm_nonneg _)
        (div_nonneg hC.le hden)
    _ = q4EnlargedSurfaceMultiplierBound C a j := by
      dsimp only [q4EnlargedSurfaceMultiplierBound, R]
      ring

/-- The preceding enlarged-radius estimate with the sign convention of the
literal spherical multiplier. -/
theorem norm_surfaceFourier_neg_smul_mul_absoluteDyadicBandpass_le_of_sharp_on_half
    {n : Nat} (C : Real) (hC : 0 < C)
    (hdecay : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖surfaceFourier (n + 1) z‖ <= C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r : Real) (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖surfaceFourier (n + 1) (-r • xi) *
        absoluteDyadicBandpass phi hphiOne hphiZero j xi‖ <=
      q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j := by
  rw [show (-r : Real) • xi = -(r • xi) by rw [neg_smul], surfaceFourier_neg]
  exact norm_surfaceFourier_smul_mul_absoluteDyadicBandpass_le_of_sharp_on_half
    C hC hdecay phi hphiOne hphiZero hphiNorm j hj r hr xi

/-- The corresponding pair multiplier constant.  It is the square of the
one-radius bound because the formal adjoint contributes the complex
conjugate multiplier. -/
def q4EnlargedPairMultiplierBound (C : Real) (a : Real) (j : Nat) : Real :=
  (q4EnlargedSurfaceMultiplierBound C a j) ^ 2

/-- The literal `A_j A_j^*` multiplier has the expected product bound on the
enlarged compact radius interval. -/
theorem norm_q4DyadicPairMultiplier_absoluteDyadicBandpass_le_of_sharp_on_half
    {n : Nat} (C : Real) (hC : 0 < C)
    (hdecay : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖surfaceFourier (n + 1) z‖ <= C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r r' : Real)
    (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (hr' : r' ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero j)
        r r' xi‖ <= q4EnlargedPairMultiplierBound C ((n : Real) / 2) j := by
  let B : Real := q4EnlargedSurfaceMultiplierBound C ((n : Real) / 2) j
  have hB : 0 <= B := by
    dsimp only [B, q4EnlargedSurfaceMultiplierBound]
    apply mul_nonneg
    · norm_num
    · refine div_nonneg hC.le (Real.rpow_nonneg ?_ _)
      have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
        _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j
      linarith
  have hsingle (t : Real) (ht : t ∈ Icc (1 / 2 : Real) (5 / 2))
      (z : Euclidean (n + 1)) :
      ‖q4DyadicSurfaceMultiplier
          (absoluteDyadicBandpass phi hphiOne hphiZero j) t z‖ <= B := by
    unfold q4DyadicSurfaceMultiplier
    exact norm_surfaceFourier_neg_smul_mul_absoluteDyadicBandpass_le_of_sharp_on_half
      C hC hdecay phi hphiOne hphiZero hphiNorm j hj t ht z
  calc
    ‖q4DyadicPairMultiplier (absoluteDyadicBandpass phi hphiOne hphiZero j)
        r r' xi‖ <= B * B :=
      norm_q4DyadicPairMultiplier_le_of_bounds
        (absoluteDyadicBandpass phi hphiOne hphiZero j) r r' hB
        (fun z => hsingle r hr z) (fun z => hsingle r' hr' z) xi
    _ = q4EnlargedPairMultiplierBound C ((n : Real) / 2) j := by
      dsimp only [q4EnlargedPairMultiplierBound, B]
      ring

/-- The preceding literal pair-multiplier estimate transferred to active
dyadic left endpoints.  This is the exact pointwise bound consumed by the
completed physical `L²` pair operator. -/
theorem norm_q4ActiveDyadicPairMultiplier_absoluteDyadicBandpass_le_of_sharp
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C)
    (hdecay : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖surfaceFourier (n + 1) z‖ <= C / ‖z‖ ^ ((n : Real) / 2))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (hE : E ⊆ Icc (1 : Real) 2)
    (i l : Int) (hi : i ∈ activeDyadicIndices E j)
    (hl : l ∈ activeDyadicIndices E j)
    (xi : Euclidean (n + 1)) :
    ‖q4ActiveDyadicPairMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j)
        (absoluteDyadicBandpass_compact phi hphiOne hphiZero j) j i l xi‖ <=
      q4EnlargedPairMultiplierBound C ((n : Real) / 2) j := by
  rw [q4ActiveDyadicPairMultiplier_spec]
  apply norm_q4DyadicPairMultiplier_absoluteDyadicBandpass_le_of_sharp_on_half
    C hC hdecay phi hphiOne hphiZero hphiNorm j hj
  · have h := dyadicLeft_mem_Icc_half_two_of_mem_activeDyadicIndices hj hE hi
    exact ⟨h.1, h.2.trans (by norm_num)⟩
  · have h := dyadicLeft_mem_Icc_half_two_of_mem_activeDyadicIndices hj hE hl
    exact ⟨h.1, h.2.trans (by norm_num)⟩

/-- The one-radius derivative multiplier constant before the cell-length and
surface-mass normalizations are inserted. -/
def q4EnlargedSurfaceDerivativeMultiplierBound
    (C : Real) (a : Real) (j : Nat) : Real :=
  4 * (C / ((q4AbsoluteFrequencyScale j) / 2) ^ a)

/-- The sharp radial derivative estimate at scale one gives a uniform bound
for an unnormalised radius derivative on the enlarged active-grid interval.
The rescaling identity is used explicitly, so the derivative is not treated
as a black-box variation term. -/
theorem norm_deriv_surfaceFourier_smul_mul_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
    {n : Nat} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r : Real) (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r *
        absoluteDyadicBandpass phi hphiOne hphiZero j xi‖ <=
      q4EnlargedSurfaceDerivativeMultiplierBound C a j := by
  let R : Real := q4AbsoluteFrequencyScale j
  let b : Complex := absoluteDyadicBandpass phi hphiOne hphiZero j xi
  let D : Real := C / (R / 2) ^ a
  have hRpos : 0 < R := by
    dsimp only [R, q4AbsoluteFrequencyScale]
    exact _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j
  have hRtwo : (2 : Real) <= R := by
    calc
      (2 : Real) = q4AbsoluteFrequencyScale 1 := by
        norm_num [q4AbsoluteFrequencyScale,
          _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale]
      _ <= q4AbsoluteFrequencyScale j :=
        _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale_mono hj
      _ = R := rfl
  have hden : 0 <= (R / 2) ^ a :=
    Real.rpow_nonneg (by positivity) _
  have hD : 0 <= D := div_nonneg hC.le hden
  by_cases hb : b = 0
  · change ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r * b‖ <= _
    rw [hb, mul_zero, norm_zero]
    dsimp only [q4EnlargedSurfaceDerivativeMultiplierBound]
    exact mul_nonneg (by norm_num) hD
  have hb' :
      phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
          phi (((2 : Real) ^ j)⁻¹ • xi) ≠ 0 := by
    simpa only [b, absoluteDyadicBandpass_spec] using hb
  have hsupp := smooth_dyadic_bandpass_norm_bounds_of_ne_zero
    hphiOne hphiZero hb'
  have hxi : R < ‖xi‖ := by
    simpa only [R, q4AbsoluteFrequencyScale,
      _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale] using hsupp.1
  have hrpos : 0 < r := by linarith [hr.1]
  have hnorm : ‖r • xi‖ = r * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos]
  have hlower : R / 2 <= ‖r • xi‖ := by
    rw [hnorm]
    calc
      R / 2 = (1 / 2 : Real) * R := by ring
      _ <= r * R := mul_le_mul_of_nonneg_right hr.1 hRpos.le
      _ <= r * ‖xi‖ := mul_le_mul_of_nonneg_left hxi.le hrpos.le
  have hargOne : 1 <= ‖r • xi‖ := by
    calc
      (1 : Real) <= R / 2 := by linarith
      _ <= ‖r • xi‖ := hlower
  have hbasepos : 0 < (R / 2) ^ a :=
    Real.rpow_pos_of_pos (by positivity) _
  have hpow : (R / 2) ^ a <= ‖r • xi‖ ^ a :=
    Real.rpow_le_rpow (by positivity) hlower ha
  have hscaled := hderiv (r • xi) hargOne
  rw [deriv_surfaceFourier_radial_rescale] at hscaled
  have hscaled' : r * ‖deriv (fun s : Real =>
      surfaceFourier (n + 1) (s • xi)) r‖ <= D := by
    calc
      r * ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r‖ =
          ‖r • deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_pos hrpos]
      _ <= C / ‖r • xi‖ ^ a := hscaled
      _ <= D := by
        dsimp only [D]
        exact div_le_div_of_nonneg_left hC.le hbasepos hpow
  have hderivBound : ‖deriv (fun s : Real =>
      surfaceFourier (n + 1) (s • xi)) r‖ <= 2 * D := by
    calc
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r‖ =
          1 * ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r‖ := by ring
      _ <= 2 * (r * ‖deriv (fun s : Real =>
          surfaceFourier (n + 1) (s • xi)) r‖) := by
        have hnormnonneg : 0 <= ‖deriv (fun s : Real =>
          surfaceFourier (n + 1) (s • xi)) r‖ := norm_nonneg _
        nlinarith [hr.1]
      _ <= 2 * D := mul_le_mul_of_nonneg_left hscaled' (by norm_num)
  have hbnorm : ‖b‖ <= 2 := by
    dsimp only [b]
    rw [absoluteDyadicBandpass_spec]
    exact norm_smooth_dyadic_bandpass_le_two hphiNorm j xi
  change ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r * b‖ <= _
  rw [norm_mul]
  calc
    ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • xi)) r‖ * ‖b‖ <=
        (2 * D) * 2 :=
      mul_le_mul hderivBound hbnorm (norm_nonneg _) (mul_nonneg (by norm_num) hD)
    _ = q4EnlargedSurfaceDerivativeMultiplierBound C a j := by
      dsimp only [q4EnlargedSurfaceDerivativeMultiplierBound, D, R]
      ring

/-- The derivative estimate with the sign convention in the literal
normalized spherical multiplier. -/
theorem norm_deriv_surfaceFourier_neg_smul_mul_absoluteDyBp_le_of_sharp_at_one_on_half
    {n : Nat} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r : Real) (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • (-xi))) r *
        absoluteDyadicBandpass phi hphiOne hphiZero j xi‖ <=
      q4EnlargedSurfaceDerivativeMultiplierBound C a j := by
  have hfun : (fun s : Real => surfaceFourier (n + 1) (s • (-xi))) =
      fun s : Real => surfaceFourier (n + 1) (s • xi) := by
    funext s
    rw [smul_neg, surfaceFourier_neg]
  rw [hfun]
  exact norm_deriv_surfaceFourier_smul_mul_absoluteDyadicBandpass_le_of_sharp_at_one_on_half
    C hC ha hderiv phi hphiOne hphiZero hphiNorm j hj r hr xi

/-- The complete one-radius multiplier constant for the scaled normalized
derivative used by the cellwise fundamental-theorem-of-calculus term. -/
def q4EnlargedScaledNormalizedDerivativeMultiplierBound
    (d : Nat) (C a : Real) (j : Nat) : Real :=
  dyadicScale j * ‖(surfaceMass d : Complex)⁻¹‖ *
    q4EnlargedSurfaceDerivativeMultiplierBound C a j

/-- After multiplication by the radius-cell length, the literal normalized
radius derivative has the displayed uniform Fourier multiplier bound. -/
theorem norm_q4ScaledNormdDySurfRadDerivMult_absoluteDyBp_le_of_sharp_at_one_on_half
    {n : Nat} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r : Real) (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) j r xi‖ <=
      q4EnlargedScaledNormalizedDerivativeMultiplierBound (n + 1) C a j := by
  let psi : SchwartzMap (Euclidean (n + 1)) Complex :=
    absoluteDyadicBandpass phi hphiOne hphiZero j
  let B : Real := q4EnlargedSurfaceDerivativeMultiplierBound C a j
  have hB : 0 <= B := by
    dsimp only [B, q4EnlargedSurfaceDerivativeMultiplierBound]
    apply mul_nonneg
    · norm_num
    · refine div_nonneg hC.le (Real.rpow_nonneg ?_ _)
      have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
        _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j
      linarith
  have hderivB : ‖deriv (fun s : Real =>
      surfaceFourier (n + 1) (s • (-xi))) r * psi xi‖ <= B := by
    dsimp only [psi, B]
    exact norm_deriv_surfaceFourier_neg_smul_mul_absoluteDyBp_le_of_sharp_at_one_on_half
      C hC ha hderiv phi hphiOne hphiZero hphiNorm j hj r hr xi
  have hcell : 0 <= dyadicScale j := (dyadicScale_pos j).le
  have hcoeff : 0 <= dyadicScale j * ‖(surfaceMass (n + 1) : Complex)⁻¹‖ :=
    mul_nonneg hcell (norm_nonneg _)
  change ‖(dyadicScale j : Complex) *
      ((surfaceMass (n + 1) : Complex)⁻¹ *
        deriv (fun s : Real => surfaceFourier (n + 1) (s • (-xi))) r * psi xi)‖ <= _
  calc
    ‖(dyadicScale j : Complex) *
        ((surfaceMass (n + 1) : Complex)⁻¹ *
          deriv (fun s : Real => surfaceFourier (n + 1) (s • (-xi))) r * psi xi)‖ =
        (dyadicScale j * ‖(surfaceMass (n + 1) : Complex)⁻¹‖) *
          ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • (-xi))) r * psi xi‖ := by
            rw [norm_mul, Complex.norm_real,
              Real.norm_eq_abs, abs_of_pos (dyadicScale_pos j),
              mul_assoc ((surfaceMass (n + 1) : Complex)⁻¹), norm_mul]
            ring
    _ <= (dyadicScale j * ‖(surfaceMass (n + 1) : Complex)⁻¹‖) * B :=
      mul_le_mul_of_nonneg_left hderivB hcoeff
    _ = q4EnlargedScaledNormalizedDerivativeMultiplierBound (n + 1) C a j := by
      dsimp only [q4EnlargedScaledNormalizedDerivativeMultiplierBound, B]

/-- The `TT*` multiplier constant for two scaled normalized derivatives. -/
def q4EnlargedScaledNormalizedDerivativePairMultiplierBound
    (d : Nat) (C a : Real) (j : Nat) : Real :=
  (q4EnlargedScaledNormalizedDerivativeMultiplierBound d C a j) ^ 2

/-- The literal pair of scaled normalized derivatives has the square of the
one-radius enlarged-range multiplier bound. -/
theorem norm_q4ScaledNormdDySurfRadDerivPairMult_absDyBp_le_of_sharp_at_one_on_half
    {n : Nat} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (r r' : Real)
    (hr : r ∈ Icc (1 / 2 : Real) (5 / 2))
    (hr' : r' ∈ Icc (1 / 2 : Real) (5 / 2))
    (xi : Euclidean (n + 1)) :
    ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) j r r' xi‖ <=
      q4EnlargedScaledNormalizedDerivativePairMultiplierBound (n + 1) C a j := by
  let B : Real := q4EnlargedScaledNormalizedDerivativeMultiplierBound (n + 1) C a j
  have hB : 0 <= B := by
    dsimp only [B, q4EnlargedScaledNormalizedDerivativeMultiplierBound]
    exact mul_nonneg
      (mul_nonneg (dyadicScale_pos j).le (norm_nonneg _))
      (by
        dsimp only [q4EnlargedSurfaceDerivativeMultiplierBound]
        refine mul_nonneg (by norm_num)
          (div_nonneg hC.le (Real.rpow_nonneg ?_ _))
        have h2 : (0 : Real) < q4AbsoluteFrequencyScale j :=
          _root_.Auto.Spherical.SurfaceMeasureDecay.dyadicScale_pos j
        linarith)
  have hsingle (t : Real) (ht : t ∈ Icc (1 / 2 : Real) (5 / 2)) :
      ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
          (absoluteDyadicBandpass phi hphiOne hphiZero j) j t xi‖ <= B := by
    exact norm_q4ScaledNormdDySurfRadDerivMult_absoluteDyBp_le_of_sharp_at_one_on_half
      C hC ha hderiv phi hphiOne hphiZero hphiNorm j hj t ht xi
  rw [q4ScaledNormalizedDyadicSurfaceRadiusDerivativePairMultiplier,
    norm_mul, starRingEnd_apply, norm_star]
  calc
    ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
        (absoluteDyadicBandpass phi hphiOne hphiZero j) j r xi‖ *
        ‖q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
          (absoluteDyadicBandpass phi hphiOne hphiZero j) j r' xi‖ <= B * B :=
      mul_le_mul (hsingle r hr) (hsingle r' hr') (norm_nonneg _) hB
    _ = q4EnlargedScaledNormalizedDerivativePairMultiplierBound (n + 1) C a j := by
      dsimp only [q4EnlargedScaledNormalizedDerivativePairMultiplierBound, B]
      ring

/-- The derivative pair bound at literal active cells and a common local
offset.  The radius inclusion is proved from the active-cell geometry, not
assumed for the left endpoints. -/
theorem norm_q4ActiveDyScaledNormdDerivPairMult_absDyBp_le_of_sharp_at_one_on_half
    {n : Nat} {E : Set Real} (C : Real) (hC : 0 < C) {a : Real} (ha : 0 <= a)
    (hderiv : forall z : Euclidean (n + 1), 1 <= ‖z‖ ->
      ‖deriv (fun s : Real => surfaceFourier (n + 1) (s • z)) 1‖ <=
        C / ‖z‖ ^ a)
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : forall z, ‖z‖ <= 1 -> phi z = 1)
    (hphiZero : forall z, 2 <= ‖z‖ -> phi z = 0)
    (hphiNorm : forall z, ‖phi z‖ <= 1)
    (j : Nat) (hj : 1 <= j) (hE : E ⊆ Icc (1 : Real) 2)
    (u : Real) (hu : u ∈ Icc (0 : Real) (dyadicScale j))
    (i l : Int) (hi : i ∈ activeDyadicIndices E j)
    (hl : l ∈ activeDyadicIndices E j)
    (xi : Euclidean (n + 1)) :
