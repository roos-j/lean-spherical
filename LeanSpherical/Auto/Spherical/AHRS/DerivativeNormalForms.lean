/-- A compact Schwartz realization of one scaled normalized radius-derivative
multiplier.  We retain compact support because the formal adjoint is obtained
by complex conjugation on the Schwartz core. -/
theorem exists_compactSchwartz_q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
    {d : Nat} (psi : SchwartzMap (Euclidean d) Complex)
    (hpsiCompact : HasCompactSupport (psi : Euclidean d -> Complex))
    (j : Nat) (r : Real) :
    ∃ m : SchwartzMap (Euclidean d) Complex,
      HasCompactSupport (m : Euclidean d -> Complex) ∧
      ∀ xi : Euclidean d, m xi =
        q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier psi j r xi := by
  rcases exists_schwartz_compactSupport_mul_surfaceFourier_radius_deriv
      psi hpsiCompact r with ⟨m, hm⟩
  let c : Complex := (dyadicScale j : Complex) * (surfaceMass d : Complex)⁻¹
  let m' : SchwartzMap (Euclidean d) Complex := c • m
  have hm' (xi : Euclidean d) : m' xi =
      q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier psi j r xi := by
    change c * m xi = _
    rw [hm xi]
    dsimp only [c]
    unfold q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier
      q4NormalizedDyadicSurfaceRadiusDerivativeMultiplier
    ring
  have hm'compact : HasCompactSupport (m' : Euclidean d -> Complex) := by
    have hfun : (m' : Euclidean d -> Complex) = fun xi => c *
        (psi xi * deriv (fun s : Real => surfaceFourier d (s • (-xi))) r) := by
      funext xi
      change c * m xi = _
      rw [hm xi]
    have hbase : HasCompactSupport
        (fun xi : Euclidean d => (psi : Euclidean d -> Complex) xi *
          deriv (fun s : Real => surfaceFourier d (s • (-xi))) r) :=
      hpsiCompact.mul_right
    rw [hfun]
    exact hbase.mul_left
  exact ⟨m', hm'compact, hm'⟩

