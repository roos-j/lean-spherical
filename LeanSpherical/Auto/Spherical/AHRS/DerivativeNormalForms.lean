    rw [hg]
    exact Complex.conjCLE.contDiff.comp (m.smooth (⊤ : ℕ∞))
  refine ⟨hcompact.toSchwartzMap hsmooth, ?_, ?_⟩
  · change HasCompactSupport g
    exact hcompact
  · intro xi
    change starRingEnd Complex (m xi) = starRingEnd Complex
      (q4ScaledNormalizedDyadicSurfaceRadiusDerivativeMultiplier psi j r xi)
    rw [q4ScaledNormalizedDyadicSurfaceRadiusDerivativeSchwartzMultiplier_spec]

