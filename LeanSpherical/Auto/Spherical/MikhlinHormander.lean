    ∀ i ≤ N, ∀ x : Euclidean d,
      ‖x‖ ^ i * ‖iteratedFDeriv Real i (fun z => χ (a • z)) x‖ ≤ A := by
  intro i hi x
  have hderiv : iteratedFDeriv Real i (fun z => χ (a • z)) x =
      a ^ i • iteratedFDeriv Real i χ (a • x) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul a
        (hχ.of_le (by exact_mod_cast hi))) x
