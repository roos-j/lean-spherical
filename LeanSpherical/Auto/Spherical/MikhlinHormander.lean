    ‖x‖ ^ i * (‖a ^ i‖ * ‖iteratedFDeriv Real i χ (a • x)‖) =
        ‖a • x‖ ^ i * ‖iteratedFDeriv Real i χ (a • x)‖ := by
      rw [norm_smul, norm_pow, mul_pow]
