  · positivity
  rw [hexpand v]
  calc
    ‖∑ σ : Fin n → Fin d,
        (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i))‖ ≤
        ∑ σ : Fin n → Fin d,
          ‖(∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i))‖ :=
      norm_sum_le _ _
    _ = ∑ σ : Fin n → Fin d,
        (∏ i, ‖(b.repr (v i)) (σ i)‖) * ‖T (fun i => b (σ i))‖ := by
      apply Finset.sum_congr rfl
      intro σ hσ
      simp only [norm_smul, norm_prod]
    _ ≤ ∑ σ : Fin n → Fin d,
        (∏ i, ‖v i‖) * B := by
      refine Finset.sum_le_sum fun σ hσ => ?_
      have hprod : (∏ i, ‖(b.repr (v i)) (σ i)‖) ≤ ∏ i, ‖v i‖ :=
        Finset.prod_le_prod
          (fun i hi => norm_nonneg _)
          (fun i hi =>
            (PiLp.norm_apply_le (b.repr (v i)) (σ i)).trans_eq (b.repr.norm_map _))
      calc
        (∏ i, ‖(b.repr (v i)) (σ i)‖) * ‖T (fun i => b (σ i))‖ ≤
            (∏ i, ‖(b.repr (v i)) (σ i)‖) * B :=
