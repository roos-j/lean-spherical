theorem integral_norm_le_uniform_and_power_decay
    {d N : Nat} {E : Type*} [NormedAddCommGroup E]
    {f : Euclidean d → E} (hNd : d < N)
    (hf_meas : AEStronglyMeasurable f volume)
    {A B : Real} (hB : ∀ x, ‖f x‖ ≤ B)
    (hA : ∀ x, ‖x‖ ^ N * ‖f x‖ ≤ A) :
    (∫ x : Euclidean d, ‖f x‖) ≤
      ((2 : Real) ^ N * (B + A)) *
        (∫ x : Euclidean d, (1 + ‖x‖) ^ (-(N : Real))) := by
  have hNpos : 0 < N := lt_of_le_of_lt (Nat.zero_le d) hNd
  have hBnonneg : 0 ≤ B := (norm_nonneg (f 0)).trans (hB 0)
  have hAnonneg : 0 ≤ A := by
    simpa [Nat.ne_of_gt hNpos] using hA 0
  have hdim : (Module.finrank Real (Euclidean d) : Real) < (N : Real) := by
    simpa using (show (d : Real) < (N : Real) by exact_mod_cast hNd)
  have hweight : Integrable (fun x : Euclidean d =>
      (1 + ‖x‖) ^ (-(N : Real))) volume :=
    integrable_one_add_norm hdim
  let M : Real := (2 : Real) ^ N * (B + A)
  have hpoint : ∀ x : Euclidean d, ‖f x‖ ≤
      M * (1 + ‖x‖) ^ (-(N : Real)) := by
    intro x
    simpa [M] using
      (pow_mul_le_of_le_of_pow_mul_le (k := 0) (l := N)
        (norm_nonneg x) (norm_nonneg (f x)) (hB x) (by simpa using hA x))
  have hfInt : Integrable f volume :=
    (hweight.const_mul M).mono' hf_meas (Filter.Eventually.of_forall hpoint)
  have hMweight : Integrable (fun x : Euclidean d =>
      M * (1 + ‖x‖) ^ (-(N : Real))) volume := hweight.const_mul M
  have hmono := integral_mono_ae hfInt.norm hMweight
    (Filter.Eventually.of_forall hpoint)
  calc
    (∫ x : Euclidean d, ‖f x‖) ≤
        ∫ x : Euclidean d, M * (1 + ‖x‖) ^ (-(N : Real)) := hmono
    _ = M * (∫ x : Euclidean d, (1 + ‖x‖) ^ (-(N : Real))) := by
      rw [integral_const_mul]
    _ = ((2 : Real) ^ N * (B + A)) *
        (∫ x : Euclidean d, (1 + ‖x‖) ^ (-(N : Real))) := by rfl

noncomputable def normalizedMikhlinKernelFrequencyL1Bound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  (A * schwartzWeightedCutoffDerivativeConstant (N := N)
    (integerDyadicBandpassPrototype C.cutoff)) *
    (volume (Metric.closedBall (0 : Euclidean d) 4)).toReal

noncomputable def normalizedMikhlinKernelIBPBound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
    (A * schwartzWeightedCutoffDerivativeConstant (N := N)
      (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n) *
      (volume (Metric.closedBall (0 : Euclidean d) 4)).toReal

noncomputable def normalizedMikhlinKernelL1Bound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  (2 : Real) ^ N *
    (normalizedMikhlinKernelFrequencyL1Bound (N := N) C A +
      normalizedMikhlinKernelIBPBound (N := N) C A) *
    ∫ x : Euclidean d, (1 + ‖x‖) ^ (-(N : Real))

theorem integral_norm_fourierInv_normalizedIntDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N) (k : Int) :
    (∫ x : Euclidean d, ‖fourierInv
      (normalizedIntDyadicMikhlinPiece C m k) x‖) ≤
      normalizedMikhlinKernelL1Bound (N := N) C A := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  have hG := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m k hm
  have hGInt : Integrable G volume :=
    hG.1.continuous.integrable_of_hasCompactSupport hG.2
  have hKInt : Integrable (fourierInv G) volume :=
    compact_cN_fourierInv_integrable G hG.1 hG.2 hNd
  have hB : ∀ x : Euclidean d, ‖fourierInv G x‖ ≤
      normalizedMikhlinKernelFrequencyL1Bound (N := N) C A := by
    intro x
    rw [Real.fourierInv_eq_fourier_neg]
    change ‖VectorFourier.fourierIntegral Real.fourierChar volume
      (innerSL Real).toLinearMap₁₂ G (-x)‖ ≤ _
    calc
      ‖VectorFourier.fourierIntegral Real.fourierChar volume
        (innerSL Real).toLinearMap₁₂ G (-x)‖ ≤
          ∫ v : Euclidean d, ‖G v‖ :=
        VectorFourier.norm_fourierIntegral_le_integral_norm
          Real.fourierChar volume (innerSL Real).toLinearMap₁₂ G (-x)
      _ ≤ normalizedMikhlinKernelFrequencyL1Bound (N := N) C A := by
        simpa [G, normalizedMikhlinKernelFrequencyL1Bound] using
          (integral_norm_iteratedFDeriv_normalizedIntDyadicMikhlinPiece_le
            C m hm hA k (n := 0) (by omega))
  have hdecay : ∀ x : Euclidean d, ‖x‖ ^ N * ‖fourierInv G x‖ ≤
      normalizedMikhlinKernelIBPBound (N := N) C A := by
    intro x
    simpa only [G, normalizedMikhlinKernelIBPBound] using
      pow_norm_fourierInv_normalizedIntDyadicMikhlinPiece_le C m hm hA k x
  simpa only [normalizedMikhlinKernelL1Bound] using
    (integral_norm_le_uniform_and_power_decay hNd hKInt.aestronglyMeasurable
      hB hdecay)

noncomputable def normalizedMikhlinKernelDerivativeFrequencyL1Bound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  ((2 * Real.pi) ^ 1 * (2 * 1 + 2 : Real) ^ 0 *
    ‖(-innerSL Real : Euclidean d →L[Real] Euclidean d →L[Real] Real)‖ ^ 1 *
    (4 * A * schwartzWeightedCutoffDerivativeConstant (N := N)
      (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ N)) *
    (volume (Metric.closedBall (0 : Euclidean d) 4)).toReal

noncomputable def normalizedMikhlinKernelDerivativeIBPBound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
    ((2 * Real.pi) ^ 1 * (2 * 1 + 2 : Real) ^ n *
      ‖(-innerSL Real : Euclidean d →L[Real] Euclidean d →L[Real] Real)‖ ^ 1 *
      (4 * A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ N)) *
      (volume (Metric.closedBall (0 : Euclidean d) 4)).toReal

noncomputable def normalizedMikhlinKernelDerivativeL1Bound
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  (2 : Real) ^ N *
    (normalizedMikhlinKernelDerivativeFrequencyL1Bound (N := N) C A +
      normalizedMikhlinKernelDerivativeIBPBound (N := N) C A) *
    ∫ x : Euclidean d, (1 + ‖x‖) ^ (-(N : Real))

theorem integral_norm_fderiv_fourierInv_normalizedIntDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N) (k : Int) :
    (∫ x : Euclidean d, ‖fderiv Real
      (fourierInv (normalizedIntDyadicMikhlinPiece C m k)) x‖) ≤
      normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let Phi := VectorFourier.fourierSMulRight (-innerSL Real) G
  have hG := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m k hm
  have hGInt : Integrable G volume :=
    hG.1.continuous.integrable_of_hasCompactSupport hG.2
  have hGweight : Integrable (fun v : Euclidean d => ‖v‖ * ‖G v‖) volume := by
    refine (continuous_norm.mul hG.1.continuous.norm).integrable_of_hasCompactSupport ?_
    exact hG.2.norm.mul_left
  have hPhi : ContDiff Real N Phi := contDiff_fourierSMulRight_one G hG.1
  have hPhiSupp : HasCompactSupport Phi := hasCompactSupport_fourierSMulRight_one G hG.2
  have hPhiKInt : Integrable (fourierInv Phi) volume :=
    compact_cN_fourierInv_integrable Phi hPhi hPhiSupp hNd
  have hB : ∀ x : Euclidean d, ‖fourierInv Phi x‖ ≤
      normalizedMikhlinKernelDerivativeFrequencyL1Bound (N := N) C A := by
    intro x
    rw [Real.fourierInv_eq_fourier_neg]
    change ‖VectorFourier.fourierIntegral Real.fourierChar volume
      (innerSL Real).toLinearMap₁₂ Phi (-x)‖ ≤ _
    calc
      ‖VectorFourier.fourierIntegral Real.fourierChar volume
        (innerSL Real).toLinearMap₁₂ Phi (-x)‖ ≤
          ∫ v : Euclidean d, ‖Phi v‖ :=
        VectorFourier.norm_fourierIntegral_le_integral_norm
          Real.fourierChar volume (innerSL Real).toLinearMap₁₂ Phi (-x)
      _ ≤ normalizedMikhlinKernelDerivativeFrequencyL1Bound (N := N) C A := by
        simpa [Phi, normalizedMikhlinKernelDerivativeFrequencyL1Bound] using
          (integral_norm_iteratedFDeriv_fourierSMulRight_normalizedIntDyadicMikhlinPiece_le
            C m hm hA k (n := 0) (by omega))
  have hdecay : ∀ x : Euclidean d, ‖x‖ ^ N * ‖fourierInv Phi x‖ ≤
      normalizedMikhlinKernelDerivativeIBPBound (N := N) C A := by
    intro x
    simpa only [Phi, normalizedMikhlinKernelDerivativeIBPBound] using
      pow_norm_fourierInv_fourierSMulRight_normalizedIntDyadicMikhlinPiece_le
        C m hm hA k x
  rw [fderiv_fourierInv_eq_fourierInv_fourierSMulRight G hGInt hGweight]
  simpa only [normalizedMikhlinKernelDerivativeL1Bound] using
    (integral_norm_le_uniform_and_power_decay hNd hPhiKInt.aestronglyMeasurable
      hB hdecay)

theorem contDiff_one_fourierInv_normalizedIntDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) :
    ContDiff Real 1 (fourierInv (normalizedIntDyadicMikhlinPiece C m 0)) := by
  have hG := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m 0 hm
  have hGInt : Integrable (normalizedIntDyadicMikhlinPiece C m 0) volume :=
    hG.1.continuous.integrable_of_hasCompactSupport hG.2
  have hFone : ContDiff Real 1
      (fourier (normalizedIntDyadicMikhlinPiece C m 0)) := by
    apply Real.contDiff_fourier
    intro n hn
    exact (continuous_norm.pow n).mul hG.1.continuous.norm
      |>.integrable_of_hasCompactSupport hG.2.norm.mul_left
  have hEq : fourierInv (normalizedIntDyadicMikhlinPiece C m 0) =
      fun x => fourier (normalizedIntDyadicMikhlinPiece C m 0) (-x) := by
    funext x
    exact Real.fourierInv_eq_fourier_neg _ x
  rw [hEq]
  simpa [Function.comp_def] using hFone.comp contDiff_neg

theorem contDiff_one_fourierInv_normalizedIntDyadicMikhlinPiece_at
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (k : Int) :
    ContDiff Real 1 (fourierInv (normalizedIntDyadicMikhlinPiece C m k)) := by
  have hG := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m k hm
  have hFone : ContDiff Real 1
      (fourier (normalizedIntDyadicMikhlinPiece C m k)) := by
    apply Real.contDiff_fourier
    intro n hn
    exact (continuous_norm.pow n).mul hG.1.continuous.norm
      |>.integrable_of_hasCompactSupport hG.2.norm.mul_left
  have hEq : fourierInv (normalizedIntDyadicMikhlinPiece C m k) =
      fun x => fourier (normalizedIntDyadicMikhlinPiece C m k) (-x) := by
    funext x
    exact Real.fourierInv_eq_fourier_neg _ x
  rw [hEq]
  simpa [Function.comp_def] using hFone.comp contDiff_neg

theorem integral_norm_fderiv_fourierInv_intDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N) (k : Int) :
    (∫ x : Euclidean d, ‖fderiv Real
      (fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)) x‖) ≤
      (integerDyadicFrequencyScale k).1⁻¹ *
        normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let R : Real := (integerDyadicFrequencyScale k).1⁻¹
  have hR : 0 < R := by
    dsimp only [R]
    exact inv_pos.mpr (integerDyadicFrequencyScale k).2
  have hscale : fourierInv (fun xi : Euclidean d =>
      intDyadicBandpassMultiplier C.cutoff k xi * m xi) =
      fun x => (R ^ d) • fourierInv G (R • x) := by
    funext x
    simpa only [G, R, Complex.real_smul] using
      fourierInv_intDyadicMikhlinPiece_eq_normalized_scale C m k x
  have hKone : ContDiff Real 1 (fourierInv G) :=
    contDiff_one_fourierInv_normalizedIntDyadicMikhlinPiece_at C m hm hNd k
  calc
    (∫ x : Euclidean d, ‖fderiv Real
        (fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)) x‖) =
        ∫ x : Euclidean d, ‖fderiv Real (fun y =>
          (R ^ d) • fourierInv G (R • y)) x‖ := by rw [hscale]
    _ = R * ∫ x : Euclidean d, ‖fderiv Real (fourierInv G) x‖ :=
      integral_norm_fderiv_dilate_eq (fourierInv G) hKone hR
    _ ≤ R * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
      apply mul_le_mul_of_nonneg_left
      · exact integral_norm_fderiv_fourierInv_normalizedIntDyadicMikhlinPiece_le
          C m hm hA hNd k
      · exact hR.le

theorem integral_norm_sub_translate_fourierInv_intDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (k : Int) (h : Euclidean d) :
    (∫ x : Euclidean d, ‖fourierInv
      (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
        fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖) ≤
      ‖h‖ * (integerDyadicFrequencyScale k).1⁻¹ *
        normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
  let psi : Euclidean d → Complex :=
    fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi
  have hpsi := contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm
  calc
    (∫ x : Euclidean d, ‖fourierInv psi (x + h) - fourierInv psi x‖) ≤
        ‖h‖ * ∫ x : Euclidean d, ‖fderiv Real (fourierInv psi) x‖ :=
      integral_norm_sub_translate_compact_cN_fourierInv_le psi hpsi.1 hpsi.2 hNd h
    _ ≤ ‖h‖ * ((integerDyadicFrequencyScale k).1⁻¹ *
        normalizedMikhlinKernelDerivativeL1Bound (N := N) C A) :=
      mul_le_mul_of_nonneg_left
        (integral_norm_fderiv_fourierInv_intDyadicMikhlinPiece_le
          C m hm hA hNd k) (norm_nonneg h)
    _ = ‖h‖ * (integerDyadicFrequencyScale k).1⁻¹ *
        normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by ring

theorem norm_fourierInv_intDyadicMikhlinPiece_le_tail
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {z : Euclidean d} (hz : z ≠ 0) :
    ‖fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) z‖ ≤
      ((integerDyadicFrequencyScale k).1⁻¹ ^ d *
        normalizedMikhlinKernelIBPBound (N := N) C A) /
        ((integerDyadicFrequencyScale k).1⁻¹ * ‖z‖) ^ N := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let R : Real := (integerDyadicFrequencyScale k).1⁻¹
  have hR : 0 < R := by
    dsimp only [R]
    exact inv_pos.mpr (integerDyadicFrequencyScale k).2
  have hRz : 0 < R * ‖z‖ := mul_pos hR (norm_pos_iff.mpr hz)
  have hdecay := pow_norm_fourierInv_normalizedIntDyadicMikhlinPiece_le
    C m hm hA k (R • z)
  have hnorm : ‖fourierInv G (R • z)‖ ≤
      normalizedMikhlinKernelIBPBound (N := N) C A /
        (R * ‖z‖) ^ N := by
    apply (le_div_iff₀ (pow_pos hRz _)).mpr
    rw [mul_comm]
    have hRz_norm : ‖R • z‖ = R * ‖z‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos hR]
    rw [hRz_norm] at hdecay
    simpa only [G, normalizedMikhlinKernelIBPBound] using hdecay
  rw [fourierInv_intDyadicMikhlinPiece_eq_normalized_scale C m k z]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg (pow_nonneg hR.le _)]
  calc
    R ^ d * ‖fourierInv G (R • z)‖ ≤
        R ^ d * (normalizedMikhlinKernelIBPBound (N := N) C A /
          (R * ‖z‖) ^ N) :=
      mul_le_mul_of_nonneg_left hnorm (pow_nonneg hR.le _)
    _ = (R ^ d * normalizedMikhlinKernelIBPBound (N := N) C A) /
        (R * ‖z‖) ^ N := by ring

/-
## Raw Mikhlin symmetric reassembly

The kernel estimates above concern one normalized dyadic piece.  The following
finite symmetric truncations provide the separate Fourier-side reassembly
bridge: exact finite dyadic sums converge pointwise to the literal punctured
multiplier, and uniform finite-`L^p` estimates pass to that multiplier by
Fatou.
-/

/-- The symmetric finite homogeneous Littlewood--Paley cutoff. -/
def symmetricIntegerDyadicCutoff {d : Nat} (C : lpCutoffs d) (N : Nat)
    (xi : Euclidean d) : Complex :=
  ∑ i ∈ Finset.range (2 * N + 1),
    intDyadicBandpassMultiplier C.cutoff (-(N : Int) + i) xi

/-- A finite symmetric truncation of the literal punctured multiplier. -/
def finiteSymmetricMikhlinTruncation {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (N : Nat)
    (f : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex :=
  𝓕⁻ (fun xi => symmetricIntegerDyadicCutoff C N xi *
    aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi)

theorem finiteSymmetricMikhlinTruncation_apply {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (N : Nat)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSymmetricMikhlinTruncation C m N f x =
      𝓕⁻ (fun xi => symmetricIntegerDyadicCutoff C N xi *
        aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) x := rfl

theorem symmetricIntegerDyadicCutoff_eq_lowpass_difference {d : Nat}
    (C : lpCutoffs d) (N : Nat) (xi : Euclidean d) :
    symmetricIntegerDyadicCutoff C N xi =
      intDyadicLowpassMultiplier C.cutoff ((N : Int) + 1) xi -
        intDyadicLowpassMultiplier C.cutoff (-(N : Int)) xi := by
  exact finiteSymmetricIntegerDyadicResolution C N xi

theorem norm_symmetricIntegerDyadicCutoff_le_two {d : Nat}
    (C : lpCutoffs d) (N : Nat) (xi : Euclidean d) :
    ‖symmetricIntegerDyadicCutoff C N xi‖ ≤ 2 := by
  rw [symmetricIntegerDyadicCutoff_eq_lowpass_difference]
  calc
    ‖intDyadicLowpassMultiplier C.cutoff ((N : Int) + 1) xi -
        intDyadicLowpassMultiplier C.cutoff (-(N : Int)) xi‖ ≤
        ‖intDyadicLowpassMultiplier C.cutoff ((N : Int) + 1) xi‖ +
          ‖intDyadicLowpassMultiplier C.cutoff (-(N : Int)) xi‖ := norm_sub_le _ _
    _ ≤ 1 + 1 := by
      gcongr
      · rw [intDyadicLowpassMultiplier_apply]
        exact C.norm_le_one _
      · rw [intDyadicLowpassMultiplier_apply]
        exact C.norm_le_one _
    _ = 2 := by norm_num

theorem norm_symmetricIntegerDyadicCutoff_sub_one_le_three {d : Nat}
    (C : lpCutoffs d) (N : Nat) (xi : Euclidean d) :
    ‖symmetricIntegerDyadicCutoff C N xi - 1‖ ≤ 3 := by
  calc
    ‖symmetricIntegerDyadicCutoff C N xi - 1‖ ≤
        ‖symmetricIntegerDyadicCutoff C N xi‖ + ‖(1 : Complex)‖ := norm_sub_le _ _
    _ ≤ 2 + 1 := by
      gcongr
      · exact norm_symmetricIntegerDyadicCutoff_le_two C N xi
      · norm_num
    _ = 3 := by norm_num

theorem symmetricIntegerDyadicCutoff_eq_one_of_bounds {d : Nat}
    (C : lpCutoffs d) (N : Nat) (xi : Euclidean d)
    (hupper : ‖xi‖ ≤ (2 : Real) ^ ((N : Int) + 1))
    (hlower : (2 : Real) ^ (-(N : Int) + 1) ≤ ‖xi‖) :
    symmetricIntegerDyadicCutoff C N xi = 1 := by
  rw [symmetricIntegerDyadicCutoff_eq_lowpass_difference,
    intDyadicLowpass_eq_one_of_norm_le C hupper,
    intDyadicLowpass_eq_zero_of_le_norm C hlower]
  norm_num

theorem eventually_norm_le_upper_symmetric_dyadic_scale {d : Nat}
    (xi : Euclidean d) :
    ∀ᶠ N : Nat in atTop, ‖xi‖ ≤ (2 : Real) ^ ((N : Int) + 1) := by
  have hpow : Tendsto (fun N : Nat => (2 : Real) ^ N) atTop atTop :=
    tendsto_pow_atTop_atTop_of_one_lt (by norm_num)
  filter_upwards [hpow.eventually_ge_atTop ‖xi‖] with N hN
  calc
    ‖xi‖ ≤ (2 : Real) ^ N := hN
    _ = (2 : Real) ^ (N : Int) := by simp
    _ ≤ (2 : Real) ^ ((N : Int) + 1) :=
      (zpow_right_strictMono₀ (by norm_num : (1 : Real) < 2)).monotone (by omega)

theorem symmetric_lower_dyadic_scale_eq {N : Nat} :
    (2 : Real) ^ (-(N : Int) + 1) = 2 * ((1 / 2 : Real) ^ N) := by
  rw [show (-(N : Int) + 1) = 1 + (-(N : Int)) by ring,
    zpow_add₀ (by norm_num : (2 : Real) ≠ 0)]
  norm_num
  rw [show (1 / 2 : Real) = (2 : Real)⁻¹ by norm_num, inv_pow]

theorem eventually_lower_symmetric_dyadic_scale_le_norm {d : Nat}
    {xi : Euclidean d} (hxi : xi ≠ 0) :
    ∀ᶠ N : Nat in atTop, (2 : Real) ^ (-(N : Int) + 1) ≤ ‖xi‖ := by
  have hpow : Tendsto (fun N : Nat => (1 / 2 : Real) ^ N) atTop (𝓝 0) :=
    tendsto_pow_atTop_nhds_zero_of_lt_one (by norm_num) (by norm_num)
  have hscaled : Tendsto (fun N : Nat => 2 * ((1 / 2 : Real) ^ N)) atTop (𝓝 0) := by
    simpa using hpow.const_mul 2
  have hx : 0 < ‖xi‖ := norm_pos_iff.mpr hxi
  filter_upwards [hscaled.eventually_le_const hx] with N hN
  rw [symmetric_lower_dyadic_scale_eq]
  exact hN

theorem eventually_symmetricIntegerDyadicCutoff_eq_one {d : Nat}
    (C : lpCutoffs d) {xi : Euclidean d} (hxi : xi ≠ 0) :
    ∀ᶠ N : Nat in atTop, symmetricIntegerDyadicCutoff C N xi = 1 := by
  filter_upwards [eventually_norm_le_upper_symmetric_dyadic_scale xi,
    eventually_lower_symmetric_dyadic_scale_le_norm hxi] with N hupper hlower
  exact symmetricIntegerDyadicCutoff_eq_one_of_bounds C N xi hupper hlower

theorem tendsto_symmetricIntegerDyadicCutoff {d : Nat}
    (C : lpCutoffs d) {xi : Euclidean d} (hxi : xi ≠ 0) :
    Tendsto (fun N : Nat => symmetricIntegerDyadicCutoff C N xi) atTop (𝓝 1) := by
  apply tendsto_const_nhds.congr'
  filter_upwards [eventually_symmetricIntegerDyadicCutoff_eq_one C hxi] with N hN
  exact hN.symm

/-- A Fourier-side dominated convergence lemma, stated so that the dyadic
reassembly only has to verify a pointwise multiplier bound. -/
theorem tendsto_fourierInv_of_dominated_convergence
    {d : Nat} (F : Nat → Euclidean d → Complex) (g : Euclidean d → Complex)
    (B : Euclidean d → Real)
    (hFmeas : ∀ N, AEStronglyMeasurable (F N) volume)
    (hBint : Integrable B volume)
    (hbound : ∀ N, ∀ᵐ xi : Euclidean d ∂volume, ‖F N xi‖ ≤ B xi)
    (hlim : ∀ᵐ xi : Euclidean d ∂volume,
      Tendsto (fun N => F N xi) atTop (𝓝 (g xi)))
    (x : Euclidean d) :
    Tendsto (fun N => 𝓕⁻ (F N) x) atTop (𝓝 (𝓕⁻ g x)) := by
  let H : Nat → Euclidean d → Complex := fun N xi =>
    Real.fourierChar (inner Real xi x) • F N xi
  let h : Euclidean d → Complex := fun xi =>
    Real.fourierChar (inner Real xi x) • g xi
  have hHmeas : ∀ N, AEStronglyMeasurable (H N) volume := by
    intro N
    exact (Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
      (hFmeas N)
  have hHbound : ∀ N, ∀ᵐ xi : Euclidean d ∂volume, ‖H N xi‖ ≤ B xi := by
    intro N
    filter_upwards [hbound N] with xi hxi
    simpa only [H, Circle.norm_smul] using hxi
  have hHlim : ∀ᵐ xi : Euclidean d ∂volume,
      Tendsto (fun N => H N xi) atTop (𝓝 (h xi)) := by
    filter_upwards [hlim] with xi hxi
    exact (tendsto_const_nhds.smul hxi)
  have h := tendsto_integral_of_dominated_convergence B hHmeas hBint hHbound hHlim
  simpa only [Real.fourierInv_eq] using h

theorem continuous_symmetricIntegerDyadicCutoff {d : Nat}
    (C : lpCutoffs d) (N : Nat) :
    Continuous (symmetricIntegerDyadicCutoff C N) := by
  unfold symmetricIntegerDyadicCutoff
  fun_prop

theorem integrable_intDyadicBandpass_mul_punctured_fourier
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (_hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (k : Int) (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun xi : Euclidean d =>
      intDyadicBandpassMultiplier C.cutoff k xi * aux_puncturedSymbol m xi *
        𝓕 (f : Euclidean d → Complex) xi) volume := by
  refine Integrable.mono'
    ((fourier f).integrable.norm.const_mul (2 * A)) ?_ ?_
  · exact (((intDyadicBandpassMultiplier C.cutoff k).continuous.aestronglyMeasurable).mul hm).mul
      (fourier f).continuous.aestronglyMeasurable
  · filter_upwards with xi
    calc
      ‖intDyadicBandpassMultiplier C.cutoff k xi * aux_puncturedSymbol m xi *
          𝓕 (f : Euclidean d → Complex) xi‖ =
          ‖intDyadicBandpassMultiplier C.cutoff k xi‖ *
            ‖aux_puncturedSymbol m xi‖ * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
              rw [norm_mul, norm_mul]
      _ ≤ 2 * A * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
        gcongr
        exact norm_intDyadicBandpassMultiplier_le_two C k xi
        exact hmA xi

theorem integrable_symmetricIntegerDyadicCutoff_mul_punctured_fourier
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (_hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (N : Nat) (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun xi : Euclidean d =>
      symmetricIntegerDyadicCutoff C N xi * aux_puncturedSymbol m xi *
        𝓕 (f : Euclidean d → Complex) xi) volume := by
  refine Integrable.mono'
    ((fourier f).integrable.norm.const_mul (2 * A)) ?_ ?_
  · exact ((continuous_symmetricIntegerDyadicCutoff C N).aestronglyMeasurable.mul hm).mul
      (fourier f).continuous.aestronglyMeasurable
  · filter_upwards with xi
    calc
      ‖symmetricIntegerDyadicCutoff C N xi * aux_puncturedSymbol m xi *
          𝓕 (f : Euclidean d → Complex) xi‖ =
          ‖symmetricIntegerDyadicCutoff C N xi‖ *
            ‖aux_puncturedSymbol m xi‖ * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
              rw [norm_mul, norm_mul]
      _ ≤ 2 * A * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
        gcongr
        exact norm_symmetricIntegerDyadicCutoff_le_two C N xi
        exact hmA xi

theorem continuous_finiteSymmetricMikhlinTruncation
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (N : Nat) (f : SchwartzMap (Euclidean d) Complex) :
    Continuous (finiteSymmetricMikhlinTruncation C m N f) := by
  let g : Euclidean d → Complex := fun xi =>
    symmetricIntegerDyadicCutoff C N xi * aux_puncturedSymbol m xi *
      𝓕 (f : Euclidean d → Complex) xi
  have hg : Integrable g volume := by
    exact integrable_symmetricIntegerDyadicCutoff_mul_punctured_fourier C m hm hA hmA N f
  have hfourier : Continuous (𝓕 g) := by
    exact VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
      (innerSL Real).continuous₂ hg
  rw [show finiteSymmetricMikhlinTruncation C m N f = 𝓕⁻ g by rfl]
  rw [show 𝓕⁻ g = fun x => 𝓕 g (-x) by
    funext x
    exact Real.fourierInv_eq_fourier_neg g x]
  exact hfourier.comp continuous_neg

theorem fourierInv_finset_sum_of_integrable
    {d : Nat} {ι : Type*} (s : Finset ι) (q : ι → Euclidean d → Complex)
    (hq : ∀ i ∈ s, Integrable (q i) volume) (x : Euclidean d) :
    𝓕⁻ (fun xi => ∑ i ∈ s, q i xi) x =
      ∑ i ∈ s, 𝓕⁻ (q i) x := by
  have hqchar : ∀ i ∈ s, Integrable
      (fun xi : Euclidean d => Real.fourierChar (inner Real xi x) • q i xi) volume := by
    intro i hi
    refine Integrable.mono' (hq i hi).norm ?_ ?_
    · exact (Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
        (hq i hi).aestronglyMeasurable
    · filter_upwards with xi
      simp
  rw [Real.fourierInv_eq]
  change (∫ xi : Euclidean d,
      Real.fourierChar (inner Real xi x) • (∑ i ∈ s, q i xi)) = _
  rw [show (fun xi : Euclidean d =>
      Real.fourierChar (inner Real xi x) • (∑ i ∈ s, q i xi)) =
        fun xi => ∑ i ∈ s, Real.fourierChar (inner Real xi x) • q i xi by
      funext xi
      rw [Finset.smul_sum],
    MeasureTheory.integral_finsetSum s hqchar]
  simp only [Real.fourierInv_eq]

theorem finiteSymmetricMikhlinTruncation_eq_sum_dyadic_pieces
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (N : Nat) (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSymmetricMikhlinTruncation C m N f x =
      ∑ i ∈ Finset.range (2 * N + 1),
        𝓕⁻ (fun xi : Euclidean d =>
          intDyadicBandpassMultiplier C.cutoff (-(N : Int) + i) xi *
            aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) x := by
  rw [finiteSymmetricMikhlinTruncation_apply]
  rw [show (fun xi : Euclidean d => symmetricIntegerDyadicCutoff C N xi *
      aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) =
        fun xi => ∑ i ∈ Finset.range (2 * N + 1),
          intDyadicBandpassMultiplier C.cutoff (-(N : Int) + i) xi *
            aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi by
      funext xi
      unfold symmetricIntegerDyadicCutoff
      rw [Finset.sum_mul, Finset.sum_mul]]
  exact fourierInv_finset_sum_of_integrable (Finset.range (2 * N + 1))
    (fun i xi => intDyadicBandpassMultiplier C.cutoff (-(N : Int) + i) xi *
      aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi)
    (fun i hi => integrable_intDyadicBandpass_mul_punctured_fourier C m hm hA hmA
      (-(N : Int) + i) f) x

/-- Each band-pass factor vanishes at the origin, so it may be paired with the
literal symbol instead of its punctured representative. -/
theorem intDyadicBandpassMultiplier_mul_aux_puncturedSymbol_eq
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int)
    (xi : Euclidean d) :
    intDyadicBandpassMultiplier C.cutoff k xi * aux_puncturedSymbol m xi =
      intDyadicBandpassMultiplier C.cutoff k xi * m xi := by
  by_cases hxi : xi = 0
  · subst xi
    have hband : intDyadicBandpassMultiplier C.cutoff k (0 : Euclidean d) = 0 := by
      apply intDyadicBandpassMultiplier_zero_on_ball C k
      rw [Metric.mem_ball, dist_zero_right]
      simpa using (zpow_pos (by norm_num : (0 : Real) < 2) k)
    simp [aux_puncturedSymbol, hband]
  · simp [aux_puncturedSymbol, hxi]

/-- The finite truncation written with the literal raw symbol in every
localized dyadic piece. This is the form consumed by the raw-piece kernel
estimates. -/
theorem finiteSymmetricMikhlinTruncation_eq_sum_raw_dyadic_pieces
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (N : Nat) (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSymmetricMikhlinTruncation C m N f x =
      ∑ i ∈ Finset.range (2 * N + 1),
        𝓕⁻ (fun xi : Euclidean d =>
          intDyadicBandpassMultiplier C.cutoff (-(N : Int) + i) xi *
            m xi * 𝓕 (f : Euclidean d → Complex) xi) x := by
  rw [finiteSymmetricMikhlinTruncation_eq_sum_dyadic_pieces C m hm hA hmA N f x]
  apply Finset.sum_congr rfl
  intro i hi
  apply congrArg (fun q : Euclidean d → Complex => 𝓕⁻ q x)
  funext xi
  rw [intDyadicBandpassMultiplier_mul_aux_puncturedSymbol_eq]

theorem measurable_aux_puncturedSymbol_of_mikhlin
    {d N : Nat} {m : Euclidean d → Complex} {A : Real}
    (hM : MikhlinCondition N m A) :
    Measurable (aux_puncturedSymbol m) := by
  have hmmeas : Measurable m := by
    apply hM.1.continuousOn.measurable_of_countable_compl
    simpa only [compl_compl] using (Set.countable_singleton (0 : Euclidean d))
  unfold aux_puncturedSymbol
  apply Measurable.ite
  · rw [Set.setOf_eq_eq_singleton]
    exact measurableSet_singleton _
  · exact measurable_const
  · exact hmmeas

theorem norm_aux_puncturedSymbol_le_of_mikhlin
    {d N : Nat} (m : Euclidean d → Complex) {A : Real} (hA : 0 ≤ A)
    (hM : MikhlinCondition N m A) (xi : Euclidean d) :
    ‖aux_puncturedSymbol m xi‖ ≤ A := by
  by_cases hxi : xi = 0
  · simp [aux_puncturedSymbol, hxi, hA]
  · simpa [aux_puncturedSymbol, hxi] using hM.2 0 (Nat.zero_le N) xi hxi

/-- Bounded punctured symbols can be reassembled from symmetric finite dyadic
truncations at every spatial point. This is a literal Fourier-integral
dominated-convergence statement, independent of the C--Z estimates used to
bound the finite truncations. -/
theorem tendsto_finiteSymmetricMikhlinTruncation
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (_hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    Tendsto (fun N : Nat => finiteSymmetricMikhlinTruncation C m N f x)
      atTop (𝓝 (mikhlinMultiplier m f x)) := by
  let F : Nat → Euclidean d → Complex := fun N xi =>
    symmetricIntegerDyadicCutoff C N xi * aux_puncturedSymbol m xi *
      𝓕 (f : Euclidean d → Complex) xi
  let g : Euclidean d → Complex := fun xi =>
    aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi
  let B : Euclidean d → Real :=
    fun xi => 2 * A * ‖𝓕 (f : Euclidean d → Complex) xi‖
  have hFmeas : ∀ N, AEStronglyMeasurable (F N) volume := by
    intro N
    exact ((continuous_symmetricIntegerDyadicCutoff C N).aestronglyMeasurable.mul hm).mul
      (fourier f).continuous.aestronglyMeasurable
  have hBint : Integrable B volume := by
    exact (fourier f).integrable.norm.const_mul (2 * A)
  have hbound : ∀ N, ∀ᵐ xi : Euclidean d ∂volume, ‖F N xi‖ ≤ B xi := by
    intro N
    filter_upwards with xi
    dsimp only [F, B]
    calc
      ‖symmetricIntegerDyadicCutoff C N xi * aux_puncturedSymbol m xi *
          𝓕 (f : Euclidean d → Complex) xi‖ =
          ‖symmetricIntegerDyadicCutoff C N xi‖ *
            ‖aux_puncturedSymbol m xi‖ * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
              rw [norm_mul, norm_mul]
      _ ≤ 2 * A * ‖𝓕 (f : Euclidean d → Complex) xi‖ := by
        gcongr
        exact norm_symmetricIntegerDyadicCutoff_le_two C N xi
        exact hmA xi
  have hlim : ∀ᵐ xi : Euclidean d ∂volume,
      Tendsto (fun N => F N xi) atTop (𝓝 (g xi)) := by
    filter_upwards with xi
    by_cases hxi : xi = 0
    · have hzero : ∀ N : Nat, F N xi = 0 := by
        intro N
        dsimp only [F]
        simp [aux_puncturedSymbol, hxi]
      have htarget : g xi = 0 := by
        dsimp only [g]
        simp [aux_puncturedSymbol, hxi]
      rw [htarget]
      exact tendsto_const_nhds.congr'
        (Filter.Eventually.of_forall fun N => (hzero N).symm)
    · dsimp only [F, g]
      simpa only [one_mul] using
        ((tendsto_symmetricIntegerDyadicCutoff C hxi).mul tendsto_const_nhds).mul
          tendsto_const_nhds
  have h := tendsto_fourierInv_of_dominated_convergence F g B hFmeas hBint hbound hlim x
  simpa only [finiteSymmetricMikhlinTruncation, mikhlinMultiplier, F, g] using h

/-- Fatou/lower-semicontinuity reassembly: any uniform finite-truncation
`L^p` bound passes to the literal raw multiplier. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (finiteSymmetricMikhlinTruncation C m n f) p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  refine Lp.eLpNorm_le_of_ae_tendsto
    (u := Filter.atTop) (f := fun n : Nat => finiteSymmetricMikhlinTruncation C m n f)
    (g := mikhlinMultiplier m f) (C := B)
    (Filter.Eventually.of_forall hfinite) ?_ ?_
  · intro n
    exact (continuous_finiteSymmetricMikhlinTruncation C m hm hA hmA n f).aestronglyMeasurable
  · filter_upwards with x
    exact tendsto_finiteSymmetricMikhlinTruncation C m hm hA hmA f x

/-- A cardinality-independent finite-truncation strong bound transfers to the
literal multiplier with the same finite constant. -/
theorem exists_eLpNorm_mikhlinMultiplier_of_uniform_finiteSymmetricMikhlinTruncation
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (p : ENNReal)
    (hfinite : ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ n : Nat, ∀ f : SchwartzMap (Euclidean d) Complex,
        eLpNorm (finiteSymmetricMikhlinTruncation C m n f) p volume ≤
          B * eLpNorm (f : Euclidean d → Complex) p volume) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ f : SchwartzMap (Euclidean d) Complex,
        eLpNorm (mikhlinMultiplier m f) p volume ≤
          B * eLpNorm (f : Euclidean d → Complex) p volume := by
  rcases hfinite with ⟨B, hBtop, hfinite⟩
  refine ⟨B, hBtop, ?_⟩
  intro f
  exact eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation
    C m hm hA hmA p (B * eLpNorm (f : Euclidean d → Complex) p volume) f
    (fun n => hfinite n f)

/-- A version of the reassembly step whose hypothesis is the literal finite
dyadic sum. This is the form supplied by finite-scale Calderón--Zygmund
arguments. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_dyadic_pieces
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) x)
        p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  apply eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation
    C m hm hA hmA p B f
  intro n
  rw [show finiteSymmetricMikhlinTruncation C m n f =
      fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) x by
    funext x
    exact finiteSymmetricMikhlinTruncation_eq_sum_dyadic_pieces C m hm hA hmA n f x]
  exact hfinite n

/-- The raw-symbol form of the finite dyadic reassembly transfer. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_raw_dyadic_pieces
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : AEStronglyMeasurable (aux_puncturedSymbol m) volume)
    (hA : 0 ≤ A) (hmA : ∀ xi, ‖aux_puncturedSymbol m xi‖ ≤ A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              m xi * 𝓕 (f : Euclidean d → Complex) xi) x)
        p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  apply eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation
    C m hm hA hmA p B f
  intro n
  rw [show finiteSymmetricMikhlinTruncation C m n f =
      fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              m xi * 𝓕 (f : Euclidean d → Complex) xi) x by
    funext x
    exact finiteSymmetricMikhlinTruncation_eq_sum_raw_dyadic_pieces C m hm hA hmA n f x]
  exact hfinite n

/-- Mikhlin-condition specialization of the finite-truncation Fatou step. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation_of_mikhlin
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (finiteSymmetricMikhlinTruncation C m n f) p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  exact eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation C m
    (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) p B f hfinite

/-- Mikhlin-condition specialization preserving a uniform finite strong
constant through symmetric reassembly. -/
theorem exists_eLpNorm_mikhlinMultiplier_of_uniform_finiteSymmetricMikhlinTruncation_of_mikhlin
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (p : ENNReal)
    (hfinite : ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ n : Nat, ∀ f : SchwartzMap (Euclidean d) Complex,
        eLpNorm (finiteSymmetricMikhlinTruncation C m n f) p volume ≤
          B * eLpNorm (f : Euclidean d → Complex) p volume) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ f : SchwartzMap (Euclidean d) Complex,
        eLpNorm (mikhlinMultiplier m f) p volume ≤
          B * eLpNorm (f : Euclidean d → Complex) p volume := by
  exact exists_eLpNorm_mikhlinMultiplier_of_uniform_finiteSymmetricMikhlinTruncation
    C m (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) p hfinite

/-- Mikhlin-condition specialization in the literal finite dyadic-sum form. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_dyadic_pieces_of_mikhlin
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              aux_puncturedSymbol m xi * 𝓕 (f : Euclidean d → Complex) xi) x)
        p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  exact eLpNorm_mikhlinMultiplier_le_of_uniform_dyadic_pieces C m
    (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) p B f hfinite

/-- Mikhlin-condition specialization in the literal raw-symbol finite
dyadic-sum form. -/
theorem eLpNorm_mikhlinMultiplier_le_of_uniform_raw_dyadic_pieces_of_mikhlin
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (p B : ENNReal) (f : SchwartzMap (Euclidean d) Complex)
    (hfinite : ∀ n : Nat,
      eLpNorm (fun x : Euclidean d =>
        ∑ i ∈ Finset.range (2 * n + 1),
          𝓕⁻ (fun xi : Euclidean d =>
            intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi *
              m xi * 𝓕 (f : Euclidean d → Complex) xi) x)
        p volume ≤ B) :
    eLpNorm (mikhlinMultiplier m f) p volume ≤ B := by
  exact eLpNorm_mikhlinMultiplier_le_of_uniform_raw_dyadic_pieces C m
    (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) p B f hfinite

theorem tendsto_finiteSymmetricMikhlinTruncation_of_mikhlin
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    Tendsto (fun n : Nat => finiteSymmetricMikhlinTruncation C m n f x)
      atTop (𝓝 (mikhlinMultiplier m f x)) := by
  exact tendsto_finiteSymmetricMikhlinTruncation C m
    (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) f x

/-- The physical finite signed kernel obtained by summing the normalized
integer dyadic band-pass kernels. -/
def finiteSignedIntegerDyadicBandpassKernel {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (a : Int → Complex) : Euclidean d → Complex := fun x =>
  ∑ k ∈ K, a k * integerDyadicBandpassKernel C.cutoff k x

/-- The inverse Fourier kernel of the finite signed multiplier is exactly
the finite physical sum of its normalized dyadic kernels. -/
theorem finiteSignedIntegerDyadicMultiplierKernel_eq_bandpassKernel {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) (x : Euclidean d) :
    finiteSignedIntegerDyadicMultiplierKernel C K a x =
      finiteSignedIntegerDyadicBandpassKernel C K a x := by
  calc
    finiteSignedIntegerDyadicMultiplierKernel C K a x =
        (∑ k ∈ K, a k •
          (fourierInv (intDyadicBandpassMultiplier C.cutoff k) :
            SchwartzMap (Euclidean d) Complex)) x := by
      rw [finiteSignedIntegerDyadicMultiplierKernel_eq_sum]
    _ = ∑ k ∈ K, (a k •
          (fourierInv (intDyadicBandpassMultiplier C.cutoff k) :
            SchwartzMap (Euclidean d) Complex)) x := by
      change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex)
          (∑ k ∈ K, a k •
            (fourierInv (intDyadicBandpassMultiplier C.cutoff k) :
              SchwartzMap (Euclidean d) Complex)) x =
        ∑ k ∈ K, (FunLike.coeAddMonoidHom
          (SchwartzMap (Euclidean d) Complex) (Euclidean d) Complex)
          (a k • (fourierInv (intDyadicBandpassMultiplier C.cutoff k) :
            SchwartzMap (Euclidean d) Complex)) x
      rw [map_sum, Finset.sum_apply]
    _ = finiteSignedIntegerDyadicBandpassKernel C K a x := by
      unfold finiteSignedIntegerDyadicBandpassKernel
      apply Finset.sum_congr rfl
      intro k hk
      rw [smul_apply, smul_eq_mul,
        fourierInv_intDyadicBandpassMultiplier_eq_integerDyadicBandpassKernel]

/-- Pointwise finite-sum control of the translation difference of the signed
dyadic kernel.  The right-hand side keeps every dyadic scale visible, which
is the datum needed for a Calderón--Zygmund tail split. -/
theorem norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (h x : Euclidean d) :
    ‖finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x‖ ≤
      ∑ k ∈ K, ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ := by
  classical
  unfold finiteSignedIntegerDyadicBandpassKernel
  calc
    ‖(∑ k ∈ K, a k * integerDyadicBandpassKernel C.cutoff k (x + h)) -
        ∑ k ∈ K, a k * integerDyadicBandpassKernel C.cutoff k x‖ =
        ‖∑ k ∈ K, a k *
          (integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x)‖ := by
      congr 1
      rw [← Finset.sum_sub_distrib]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    _ ≤ ∑ k ∈ K, ‖a k *
          (integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x)‖ :=
      norm_sum_le K _
    _ = ∑ k ∈ K, ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [norm_mul]

/-- With coefficients of norm at most one, the finite signed translation
difference is pointwise dominated by the unsigned sum of scale differences. -/
theorem norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum_one
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (h x : Euclidean d) :
    ‖finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x‖ ≤
      ∑ k ∈ K,
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ := by
  calc
    ‖finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x‖ ≤
      ∑ k ∈ K, ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ :=
      norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum C K a h x
    _ ≤ ∑ k ∈ K,
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ := by
      apply Finset.sum_le_sum
      intro k hk
      calc
        ‖a k‖ * ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x‖ ≤
          1 * ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x‖ :=
          mul_le_mul_of_nonneg_right (ha k hk) (norm_nonneg _)
        _ = ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x‖ := one_mul _

/-- The finite signed physical kernel is integrable. -/
theorem integrable_finiteSignedIntegerDyadicBandpassKernel {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) :
    Integrable (finiteSignedIntegerDyadicBandpassKernel C K a) volume := by
  classical
  unfold finiteSignedIntegerDyadicBandpassKernel
  apply integrable_finsetSum K
  intro k hk
  simpa only [smul_eq_mul] using
    (integrable_integerDyadicBandpassKernel C.cutoff k).const_mul (a k)

/-- The translation difference of a finite signed physical kernel is
integrable. -/
theorem integrable_finiteSignedIntegerDyadicBandpassKernel_sub_translate
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (h : Euclidean d) :
    Integrable (fun x : Euclidean d =>
      finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x) volume := by
  exact (integrable_finiteSignedIntegerDyadicBandpassKernel C K a).comp_add_right h |>.sub
    (integrable_finiteSignedIntegerDyadicBandpassKernel C K a)

/-- Integrability of the nonnegative finite-sum majorant for the signed
kernel translation difference. -/
theorem integrable_finiteSignedIntegerDyadicBandpassKernel_translation_majorant
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (h : Euclidean d) :
    Integrable (fun x : Euclidean d =>
      ∑ k ∈ K, ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖) volume := by
  classical
  apply integrable_finsetSum K
  intro k hk
  exact ((integrable_integerDyadicBandpassKernel C.cutoff k).comp_add_right h |>.sub
    (integrable_integerDyadicBandpassKernel C.cutoff k)).norm.const_mul ‖a k‖

/-- Integrating the pointwise finite-sum bound gives the exact signed-kernel
translation estimate before any scale splitting. -/
theorem integral_norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x‖) ≤
      ∑ k ∈ K, ‖a k‖ * (∫ x : Euclidean d,
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖) := by
  classical
  have hsingle (k : Int) (hk : k ∈ K) :
      Integrable (fun x : Euclidean d => ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖) volume :=
    ((integrable_integerDyadicBandpassKernel C.cutoff k).comp_add_right h |>.sub
      (integrable_integerDyadicBandpassKernel C.cutoff k)).norm.const_mul ‖a k‖
  calc
    (∫ x : Euclidean d,
      ‖finiteSignedIntegerDyadicBandpassKernel C K a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C K a x‖) ≤
        ∫ x : Euclidean d, ∑ k ∈ K, ‖a k‖ *
          ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
            integerDyadicBandpassKernel C.cutoff k x‖ :=
      integral_mono
        (integrable_finiteSignedIntegerDyadicBandpassKernel_sub_translate C K a h).norm
        (integrable_finiteSignedIntegerDyadicBandpassKernel_translation_majorant C K a h)
        (norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum C K a h)
    _ = ∑ k ∈ K, ∫ x : Euclidean d, ‖a k‖ *
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖ := by
      rw [integral_finsetSum K hsingle]
    _ = ∑ k ∈ K, ‖a k‖ * (∫ x : Euclidean d,
        ‖integerDyadicBandpassKernel C.cutoff k (x + h) -
          integerDyadicBandpassKernel C.cutoff k x‖) := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [integral_const_mul]

/-- Bounded coefficients give a cardinality-free pointwise bound for the
finite signed homogeneous dyadic symbol. -/
theorem norm_finiteSignedIntegerDyadicMultiplierSymbol_le_four {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (xi : Euclidean d) :
    ‖finiteSignedIntegerDyadicMultiplierSymbol C K a xi‖ ≤ 4 := by
  rw [finiteSignedIntegerDyadicMultiplierSymbol_apply]
  calc
    ‖∑ k ∈ K, a k * intDyadicBandpassMultiplier C.cutoff k xi‖ ≤
        ∑ k ∈ K, ‖a k * intDyadicBandpassMultiplier C.cutoff k xi‖ :=
      norm_sum_le K _
    _ = ∑ k ∈ K, ‖a k‖ * ‖intDyadicBandpassMultiplier C.cutoff k xi‖ := by
      apply Finset.sum_congr rfl
      intro k hk
      rw [norm_mul]
    _ ≤ ∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi‖ := by
      apply Finset.sum_le_sum
      intro k hk
      calc
        ‖a k‖ * ‖intDyadicBandpassMultiplier C.cutoff k xi‖ ≤
            1 * ‖intDyadicBandpassMultiplier C.cutoff k xi‖ :=
          mul_le_mul_of_nonneg_right (ha k hk) (norm_nonneg _)
        _ = ‖intDyadicBandpassMultiplier C.cutoff k xi‖ := one_mul _
    _ ≤ 4 := finite_sum_norm_intDyadicBandpassMultiplier_le_four C K xi

/-- The physical-space finite signed homogeneous dyadic Fourier multiplier. -/
def finiteSignedIntegerDyadicMultiplier {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (a : Int → Complex) (f : SchwartzMap (Euclidean d) Complex) :
    Euclidean d → Complex := fun x =>
  fourierInv (fun xi : Euclidean d =>
    finiteSignedIntegerDyadicMultiplierSymbol C K a xi *
      fourier (f : Euclidean d → Complex) xi) x

/-- The finite signed multiplier is convolution with its literal inverse
Fourier Schwartz kernel.  This is an algebraic identity; no Calderón--
Zygmund endpoint estimate is used here. -/
theorem finiteSignedIntegerDyadicMultiplier_eq_convolution_kernel {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSignedIntegerDyadicMultiplier C K a f x =
      ((finiteSignedIntegerDyadicMultiplierKernel C K a :
          Euclidean d → Complex)
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x := by
  unfold finiteSignedIntegerDyadicMultiplier
  simpa only [finiteSignedIntegerDyadicMultiplierKernel] using
    fourierInv_schwartz_multiplier_eq_convolution
      (finiteSignedIntegerDyadicMultiplierSymbol C K a) f x

/-- The literal signed Fourier multiplier is exactly the corresponding finite
linear combination of the existing homogeneous dyadic projections. -/
theorem finiteSignedIntegerDyadicMultiplier_eq_sum_integerDyadicProjection
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSignedIntegerDyadicMultiplier C K a f x =
      ∑ k ∈ K, a k * integerDyadicProjection C.cutoff k f x := by
  let F : SchwartzMap (Euclidean d) Complex := fourier f
  let g : Int → SchwartzMap (Euclidean d) Complex := fun k =>
    SchwartzMap.smulLeftCLM Complex
      (intDyadicBandpassMultiplier C.cutoff k : Euclidean d → Complex) F
  have hg (k : Int) (xi : Euclidean d) :
      g k xi = intDyadicBandpassMultiplier C.cutoff k xi * F xi := by
    dsimp [g]
    simp only [SchwartzMap.smulLeftCLM_apply
      (intDyadicBandpassMultiplier C.cutoff k).hasTemperateGrowth, smul_eq_mul]
  have hginv (k : Int) (y : Euclidean d) :
      (fourierInv (g k) : SchwartzMap (Euclidean d) Complex) y =
        fourierInv (fun xi : Euclidean d =>
          intDyadicBandpassMultiplier C.cutoff k xi *
            fourier (f : Euclidean d → Complex) xi) y := by
    rw [SchwartzMap.fourierInv_coe]
    dsimp [g, F]
    apply congrArg (fun h : Euclidean d → Complex => fourierInv h y)
    funext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (intDyadicBandpassMultiplier C.cutoff k).hasTemperateGrowth]
    rfl
  have hdata :
      SchwartzMap.smulLeftCLM Complex
        (finiteSignedIntegerDyadicMultiplierSymbol C K a : Euclidean d → Complex) F =
          ∑ k ∈ K, a k • g k := by
    have hsum_apply (xi : Euclidean d) :
        (∑ k ∈ K, a k • g k : SchwartzMap (Euclidean d) Complex) xi =
          ∑ k ∈ K, (a k • g k : SchwartzMap (Euclidean d) Complex) xi := by
      change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex)
          (∑ k ∈ K, a k • g k) xi =
        ∑ k ∈ K,
          (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
            (Euclidean d) Complex) (a k • g k) xi
      simpa only [Finset.sum_apply] using
        congrFun (map_sum (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex) (fun k => a k • g k) K) xi
    ext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (finiteSignedIntegerDyadicMultiplierSymbol C K a).hasTemperateGrowth]
    simp only [smul_eq_mul]
    rw [finiteSignedIntegerDyadicMultiplierSymbol_apply]
    rw [hsum_apply]
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro k hk
    rw [smul_apply, smul_eq_mul, hg]
    ring
  have hfun : (fun xi : Euclidean d =>
      finiteSignedIntegerDyadicMultiplierSymbol C K a xi * F xi) =
      (SchwartzMap.smulLeftCLM Complex
        (finiteSignedIntegerDyadicMultiplierSymbol C K a : Euclidean d → Complex) F :
          Euclidean d → Complex) := by
    funext xi
    rw [SchwartzMap.smulLeftCLM_apply
      (finiteSignedIntegerDyadicMultiplierSymbol C K a).hasTemperateGrowth]
    rfl
  change fourierInv (fun xi : Euclidean d =>
    finiteSignedIntegerDyadicMultiplierSymbol C K a xi * F xi) x = _
  rw [hfun]
  rw [← SchwartzMap.fourierInv_coe]
  rw [hdata, fourierInv_sum]
  have hinvsum_apply (y : Euclidean d) :
      (∑ k ∈ K, fourierInv (a k • g k) : SchwartzMap (Euclidean d) Complex) y =
        ∑ k ∈ K, (fourierInv (a k • g k) : SchwartzMap (Euclidean d) Complex) y := by
    change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
        (Euclidean d) Complex)
        (∑ k ∈ K, fourierInv (a k • g k)) y =
      ∑ k ∈ K,
        (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
          (Euclidean d) Complex) (fourierInv (a k • g k)) y
    simpa only [Finset.sum_apply] using
      congrFun (map_sum (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
        (Euclidean d) Complex) (fun k => fourierInv (a k • g k)) K) y
  rw [hinvsum_apply]
  apply Finset.sum_congr rfl
  intro k hk
  rw [fourierInv_smul, smul_apply, smul_eq_mul, hginv]
  rfl

/-- Finite signed homogeneous dyadic multipliers satisfy a genuine,
cardinality-free strong `(2,2)` estimate.  This is the Plancherel endpoint
of the signed Mikhlin problem. -/
theorem integral_norm_sq_finiteSignedIntegerDyadicMultiplier_le {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d, ‖finiteSignedIntegerDyadicMultiplier C K a f x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  have hbound := integral_norm_sq_fourierInv_schwartz_multiplier_le
    (finiteSignedIntegerDyadicMultiplierSymbol C K a) (fourier f)
    (by norm_num : (0 : Real) ≤ 4)
    (norm_finiteSignedIntegerDyadicMultiplierSymbol_le_four C K a ha)
  change (∫ x : Euclidean d, ‖fourierInv (fun xi : Euclidean d =>
      finiteSignedIntegerDyadicMultiplierSymbol C K a xi *
        fourier (f : Euclidean d → Complex) xi) x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)
  calc
    (∫ x : Euclidean d, ‖fourierInv (fun xi : Euclidean d =>
        finiteSignedIntegerDyadicMultiplierSymbol C K a xi *
          fourier (f : Euclidean d → Complex) xi) x‖ ^ (2 : Nat)) ≤
        (4 : Real) ^ (2 : Nat) * ∫ xi : Euclidean d, ‖fourier f xi‖ ^ (2 : Nat) :=
      hbound
    _ = 16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
      rw [show (4 : Real) ^ (2 : Nat) = 16 by norm_num,
        SchwartzMap.fourier_coe, integral_norm_sq_fourier_schwartz_eq]

/-- Direct projection-sum form of the uniform finite signed dyadic `L²`
estimate.  Its constant does not depend on the number or location of the
integer dyadic scales. -/
theorem integral_norm_sq_sum_integerDyadicProjection_le {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      ‖∑ k ∈ K, a k * integerDyadicProjection C.cutoff k f x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  calc
    (∫ x : Euclidean d,
      ‖∑ k ∈ K, a k * integerDyadicProjection C.cutoff k f x‖ ^ (2 : Nat)) =
        ∫ x : Euclidean d,
          ‖finiteSignedIntegerDyadicMultiplier C K a f x‖ ^ (2 : Nat) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [finiteSignedIntegerDyadicMultiplier_eq_sum_integerDyadicProjection]
    _ ≤ 16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) :=
      integral_norm_sq_finiteSignedIntegerDyadicMultiplier_le C K a ha f

/-! ### Schwartz adjoints and cubic tests for finite multipliers

The endpoint interpolation argument is applied to a finite signed multiplier
and its formal adjoint.  The following small, entirely Schwartz-space layer
keeps that duality literal.  In particular, it does not identify a complex
conjugate with a complex-linear map: conjugation is deliberately installed as
a real-linear postcomposition on Schwartz functions.
-/

/-- Complex conjugation preserves the Schwartz class.  The use of the real
scalar field is essential here, since complex conjugation is anti-linear over
`Complex`. -/
noncomputable def conjugateSchwartz {d : Nat}
    (f : SchwartzMap (Euclidean d) Complex) : SchwartzMap (Euclidean d) Complex :=
  f.postcompCLM (𝕜 := Real) (Complex.conjCLE : Complex →L[Real] Complex)

@[simp]
theorem conjugateSchwartz_apply {d : Nat}
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    conjugateSchwartz f x = starRingEnd Complex (f x) := by
  change (Complex.conjCLE : Complex →L[Real] Complex) (f x) = star (f x)
  exact (Complex.conjCLE_apply (f x)).trans
    (congrFun Complex.star_def (f x)).symm

/-- Pointwise multiplication of two complex Schwartz functions. -/
noncomputable def multiplySchwartz {d : Nat}
    (f g : SchwartzMap (Euclidean d) Complex) : SchwartzMap (Euclidean d) Complex :=
  SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f g

@[simp]
theorem multiplySchwartz_apply {d : Nat}
    (f g : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    multiplySchwartz f g x = f x * g x := rfl

/-- The cubic Schwartz test function whose conjugate pairs with `f` to give
`‖f‖⁴`.  This is the test used in the direct duality proof of the `L⁴`
endpoint. -/
noncomputable def fourthPowerTestSchwartz {d : Nat}
    (f : SchwartzMap (Euclidean d) Complex) : SchwartzMap (Euclidean d) Complex :=
  multiplySchwartz f (multiplySchwartz (conjugateSchwartz f) f)

@[simp]
theorem fourthPowerTestSchwartz_apply {d : Nat}
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    fourthPowerTestSchwartz f x = f x * (starRingEnd Complex (f x) * f x) := by
  simp only [fourthPowerTestSchwartz, multiplySchwartz_apply,
    conjugateSchwartz_apply]

/-- The cubic test gives exactly the fourth power after the pairing
conjugation. -/
theorem mul_star_fourthPowerTestSchwartz {d : Nat}
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    f x * starRingEnd Complex (fourthPowerTestSchwartz f x) = ‖f x‖ ^ (4 : Nat) := by
  rw [fourthPowerTestSchwartz_apply]
  simp only [map_mul, starRingEnd_apply, star_star]
  rw [Complex.star_def]
  calc
    f x * (conj (f x) * (f x * conj (f x))) =
        (f x * conj (f x)) * (f x * conj (f x)) := by ring
    _ = (‖f x‖ ^ (2 : Nat) : Complex) * (‖f x‖ ^ (2 : Nat) : Complex) := by
      simp only [Complex.mul_conj']
    _ = ‖f x‖ ^ (4 : Nat) := by norm_cast; ring

/-- The Schwartz realization of a finite signed dyadic multiplier. -/
noncomputable def finiteSignedIntegerDyadicMultiplierSchwartz {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) :
    SchwartzMap (Euclidean d) Complex →L[Complex]
      SchwartzMap (Euclidean d) Complex :=
  SchwartzMap.fourierMultiplierCLM Complex
    (finiteSignedIntegerDyadicMultiplierSymbol C K a : Euclidean d → Complex)

/-- The bundled Schwartz multiplier agrees pointwise with the literal
finite signed Fourier multiplier used above. -/
theorem finiteSignedIntegerDyadicMultiplierSchwartz_apply {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSignedIntegerDyadicMultiplierSchwartz C K a f x =
      finiteSignedIntegerDyadicMultiplier C K a f x := by
  let m : SchwartzMap (Euclidean d) Complex :=
    finiteSignedIntegerDyadicMultiplierSymbol C K a
  have hm : (m : Euclidean d → Complex).HasTemperateGrowth := m.hasTemperateGrowth
  change ((SchwartzMap.fourierMultiplierCLM Complex
    (m : Euclidean d → Complex) f : SchwartzMap (Euclidean d) Complex) :
      Euclidean d → Complex) x = _
  rw [SchwartzMap.fourierMultiplierCLM_apply, SchwartzMap.fourierInv_coe]
  have hsymbol :
      (SchwartzMap.smulLeftCLM Complex (m : Euclidean d → Complex)
        (FourierTransform.fourier f) : Euclidean d → Complex) =
        fun xi : Euclidean d => m xi *
          FourierTransform.fourier (f : Euclidean d → Complex) xi := by
    funext xi
    rw [SchwartzMap.smulLeftCLM_apply hm]
    rfl
  rw [hsymbol]
  rfl

/-- ENNReal lower-integral form of the cardinality-free signed dyadic `L²`
endpoint.  This is the exact square endpoint consumed by real interpolation. -/
theorem lintegral_norm_sq_finiteSignedIntegerDyadicMultiplierSchwartz_le {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex) :
    (∫⁻ x : Euclidean d, ENNReal.ofReal
      (‖finiteSignedIntegerDyadicMultiplierSchwartz C K a f x‖ ^ (2 : Nat))) ≤
      16 * ∫⁻ x : Euclidean d, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
  let T : SchwartzMap (Euclidean d) Complex :=
    finiteSignedIntegerDyadicMultiplierSchwartz C K a f
  have hTint : Integrable (fun x : Euclidean d => ‖T x‖ ^ (2 : Nat)) volume := by
    have hmem : MemLp (T : Euclidean d → Complex) 2 volume := T.memLp 2 volume
    simpa using hmem.integrable_norm_rpow (by norm_num) ENNReal.ofNat_ne_top
  have hfint : Integrable (fun x : Euclidean d => ‖f x‖ ^ (2 : Nat)) volume := by
    have hmem : MemLp (f : Euclidean d → Complex) 2 volume := f.memLp 2 volume
    simpa using hmem.integrable_norm_rpow (by norm_num) ENNReal.ofNat_ne_top
  have hsq := integral_norm_sq_finiteSignedIntegerDyadicMultiplier_le C K a ha f
  have hsqT : (∫ x : Euclidean d, ‖T x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
    simpa only [T, finiteSignedIntegerDyadicMultiplierSchwartz_apply] using hsq
  calc
    (∫⁻ x : Euclidean d, ENNReal.ofReal (‖T x‖ ^ (2 : Nat))) =
        ENNReal.ofReal (∫ x : Euclidean d, ‖T x‖ ^ (2 : Nat)) :=
      (ofReal_integral_eq_lintegral_ofReal hTint
        (Filter.Eventually.of_forall fun x => pow_nonneg (norm_nonneg _) _)).symm
    _ ≤ ENNReal.ofReal (16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) :=
      ENNReal.ofReal_le_ofReal hsqT
    _ = 16 * ∫⁻ x : Euclidean d, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
      have hfconvert : ENNReal.ofReal (∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) =
          ∫⁻ x : Euclidean d, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) :=
        ofReal_integral_eq_lintegral_ofReal hfint
          (Filter.Eventually.of_forall fun x => pow_nonneg (norm_nonneg _) _)
      rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 16), hfconvert]
      norm_num

/-- The pointwise conjugate of a Schwartz multiplier is its formal adjoint
symbol. -/
noncomputable def adjointSchwartzMultiplier {d : Nat}
    (m : SchwartzMap (Euclidean d) Complex) : SchwartzMap (Euclidean d) Complex :=
  conjugateSchwartz m

@[simp]
theorem adjointSchwartzMultiplier_apply {d : Nat}
    (m : SchwartzMap (Euclidean d) Complex) (xi : Euclidean d) :
    adjointSchwartzMultiplier m xi = starRingEnd Complex (m xi) :=
  conjugateSchwartz_apply m xi

/-- Conjugating the cutoff preserves all Littlewood--Paley cutoff axioms.
This packages the formal adjoint of a signed dyadic multiplier in the same
dimension-generic cutoff class without imposing an artificial reality
assumption on the original cutoff. -/
noncomputable def conjugateLpCutoffs {d : Nat} (C : lpCutoffs d) : lpCutoffs d where
  cutoff := conjugateSchwartz C.cutoff
  cutoff_one := by
    intro ξ hξ
    rw [conjugateSchwartz_apply, C.cutoff_one ξ hξ]
    norm_num
  cutoff_zero := by
    intro ξ hξ
    rw [conjugateSchwartz_apply, C.cutoff_zero ξ hξ]
    norm_num
  norm_le_one := by
    intro ξ
    rw [conjugateSchwartz_apply]
    change ‖star (C.cutoff ξ)‖ ≤ 1
    rw [norm_star]
    exact C.norm_le_one ξ

/-- Integer dyadic band-passes commute with conjugation of their cutoff. -/
theorem intDyadicBandpassMultiplier_conjugateLpCutoffs_apply {d : Nat}
    (C : lpCutoffs d) (k : Int) (ξ : Euclidean d) :
    intDyadicBandpassMultiplier (conjugateLpCutoffs C).cutoff k ξ =
      starRingEnd Complex (intDyadicBandpassMultiplier C.cutoff k ξ) := by
  rw [intDyadicBandpassMultiplier_apply, intDyadicBandpassMultiplier_apply]
  simp only [conjugateLpCutoffs, conjugateSchwartz_apply, map_sub,
    starRingEnd_apply]

/-- The formal adjoint of a finite signed dyadic symbol is another literal
finite signed dyadic symbol, now formed with the conjugate cutoff and
conjugate coefficients. -/
theorem adjoint_finiteSignedIntegerDyadicMultiplierSymbol_eq {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) :
    adjointSchwartzMultiplier (finiteSignedIntegerDyadicMultiplierSymbol C K a) =
      finiteSignedIntegerDyadicMultiplierSymbol (conjugateLpCutoffs C) K
        (fun k => starRingEnd Complex (a k)) := by
  ext ξ
  rw [adjointSchwartzMultiplier_apply,
    finiteSignedIntegerDyadicMultiplierSymbol_apply,
    finiteSignedIntegerDyadicMultiplierSymbol_apply]
  simp only [map_sum, map_mul]
  apply Finset.sum_congr rfl
  intro k hk
  rw [intDyadicBandpassMultiplier_conjugateLpCutoffs_apply]

/-- Fourier-side formula for a Schwartz Fourier multiplier. -/
theorem fourier_schwartzFourierMultiplier {d : Nat}
    (m f : SchwartzMap (Euclidean d) Complex) (xi : Euclidean d) :
    FourierTransform.fourier
      ((SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f :
        SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) xi =
      m xi * FourierTransform.fourier (f : Euclidean d → Complex) xi := by
  change FourierTransform.fourier
      ((SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f :
        SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) xi = _
  rw [SchwartzMap.fourierMultiplierCLM_apply]
  have hfourier : FourierTransform.fourier
      ((FourierTransform.fourierInv
        (SchwartzMap.smulLeftCLM Complex (m : Euclidean d → Complex)
          (FourierTransform.fourier f)) : SchwartzMap (Euclidean d) Complex) :
        Euclidean d → Complex) =
      (SchwartzMap.smulLeftCLM Complex (m : Euclidean d → Complex)
        (FourierTransform.fourier f) : Euclidean d → Complex) := by
    rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [hfourier]
  simp only [SchwartzMap.smulLeftCLM_apply m.hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

/-- Fourier-side multiplier duality on the Schwartz core. -/
theorem integral_schwartzFourierMultiplier_mul_star_eq {d : Nat}
    (m f g : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      (SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f) x *
        starRingEnd Complex (g x)) =
      ∫ x : Euclidean d, f x * starRingEnd Complex
        ((SchwartzMap.fourierMultiplierCLM Complex
          (adjointSchwartzMultiplier m : Euclidean d → Complex) g) x) := by
  have hinner : (∫ x : Euclidean d, inner Complex (g x)
      (SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f x)) =
      ∫ x : Euclidean d, inner Complex
        ((SchwartzMap.fourierMultiplierCLM Complex
          (adjointSchwartzMultiplier m : Euclidean d → Complex) g) x) (f x) := by
    rw [← SchwartzMap.integral_inner_fourier_fourier g
      (SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f)]
    rw [← SchwartzMap.integral_inner_fourier_fourier
      (SchwartzMap.fourierMultiplierCLM Complex
        (adjointSchwartzMultiplier m : Euclidean d → Complex) g) f]
    apply integral_congr_ae
    filter_upwards with xi
    change inner Complex (FourierTransform.fourier (g : Euclidean d → Complex) xi)
        (FourierTransform.fourier
          ((SchwartzMap.fourierMultiplierCLM Complex (m : Euclidean d → Complex) f :
            SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) xi) =
      inner Complex
        (FourierTransform.fourier
          ((SchwartzMap.fourierMultiplierCLM Complex
            (adjointSchwartzMultiplier m : Euclidean d → Complex) g :
              SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) xi)
        (FourierTransform.fourier (f : Euclidean d → Complex) xi)
    rw [fourier_schwartzFourierMultiplier,
      fourier_schwartzFourierMultiplier]
    simp only [RCLike.inner_apply, starRingEnd_apply, map_mul, star_star]
    rw [adjointSchwartzMultiplier_apply]
    simp only [starRingEnd_apply, star_star]
    ring
  simpa only [RCLike.inner_apply, starRingEnd_apply] using hinner

/-- Literal Schwartz-core adjoint pairing for finite signed dyadic
multipliers.  No reality hypothesis on the cutoff is hidden here: the
adjoint uses `conjugateLpCutoffs C` and conjugate coefficients explicitly. -/
theorem integral_finiteSignedIntegerDyadicMultiplier_mul_star_eq {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (f g : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      finiteSignedIntegerDyadicMultiplierSchwartz C K a f x *
        starRingEnd Complex (g x)) =
      ∫ x : Euclidean d, f x * starRingEnd Complex
        (finiteSignedIntegerDyadicMultiplierSchwartz (conjugateLpCutoffs C) K
          (fun k => starRingEnd Complex (a k)) g x) := by
  change (∫ x : Euclidean d,
      (SchwartzMap.fourierMultiplierCLM Complex
        (finiteSignedIntegerDyadicMultiplierSymbol C K a : Euclidean d → Complex) f) x *
        starRingEnd Complex (g x)) = _
  rw [integral_schwartzFourierMultiplier_mul_star_eq]
  rw [adjoint_finiteSignedIntegerDyadicMultiplierSymbol_eq]
  rfl

/-! ### Dimension-generic weak-one/square interpolation on the Schwartz core -/

/-- An additive measurable Schwartz-core operator with weak type (1,1) and
square-function endpoints has a genuine strong bound at every exponent
strictly between one and two.  This is the lower half of the finite signed
dyadic multiplier argument, but is stated without any dyadic or
dimension-specific hypothesis. -/
theorem lowerLp_of_schwartz_additive_weak_one_square
    {d : Nat}
    (S : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hSadd : ∀ (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      S (g + h) x = S g x + S h x)
    (hSmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (S g) volume)
    (C₁ C₂ : ENNReal) (hC₁top : C₁ ≠ ∞) (hC₂top : C₂ ≠ ∞)
    (hweak_one : ∀ (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖S g x‖} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, ENNReal.ofReal (‖S g x‖ ^ (2 : Nat))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    {p : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) Complex) :
    MemLp (S f) (ENNReal.ofReal p) volume ∧
      eLpNorm (S f) (ENNReal.ofReal p) volume ≤
        (weakOneSquareMomentCoefficient p C₁ C₂) ^ p⁻¹ *
          eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let A : ENNReal := weakOneSquareMomentCoefficient p C₁ C₂
  have hp : 0 < p := lt_trans zero_lt_one hp1
  have hAtop : A ≠ ∞ := by
    dsimp only [A]
    exact weakOneSquareMomentCoefficient_ne_top hp1 hp2 hC₁top hC₂top
  have hmoment :
      (∫⁻ x, ENNReal.ofReal (‖S f x‖ ^ p)) ≤
        A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p := by
    simpa only [A] using
      schwartz_lintegral_rpow_of_weak_one_and_square_factorized
        (fun g x => ‖S g x‖)
        (fun _ _ => norm_nonneg _)
        (by
          intro g h
          filter_upwards with x
          rw [hSadd]
          exact norm_add_le _ _)
        (fun g => (hSmeas g).norm.aemeasurable)
        C₁ C₂ hweak_one hsquare hp1 hp2 f
  have hinput_eq :
      (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) =
        (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p :=
    lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp (f : Euclidean d → Complex)
  have hinput_fin : (∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) < ∞ := by
    rw [hinput_eq]
    exact ENNReal.rpow_lt_top_of_nonneg hp.le
      (f.memLp (ENNReal.ofReal p) volume).eLpNorm_ne_top
  have hmoment_fin : (∫⁻ x, ENNReal.ofReal (‖S f x‖ ^ p)) < ∞ :=
    hmoment.trans_lt (ENNReal.mul_lt_top hAtop.lt_top hinput_fin)
  have hnorm_mem : MemLp (fun x : Euclidean d => ‖S f x‖) (ENNReal.ofReal p) volume :=
    Auto.Spherical.InterpolationTail.memLp_of_lintegral_ofReal_rpow_lt_top
      (fun x : Euclidean d => ‖S f x‖) (hSmeas f).norm.aemeasurable
      (fun _ => norm_nonneg _) hp hmoment_fin
  have hout_mem : MemLp (S f) (ENNReal.ofReal p) volume :=
    (memLp_norm_iff (hSmeas f)).mp hnorm_mem
  refine ⟨hout_mem, ?_⟩
  calc
    eLpNorm (S f) (ENNReal.ofReal p) volume =
        eLpNorm (fun x : Euclidean d => ‖S f x‖) (ENNReal.ofReal p) volume :=
      (eLpNorm_norm _).symm
    _ ≤ (A * ∫⁻ x, (ENNReal.ofReal ‖f x‖) ^ p) ^ p⁻¹ :=
      eLpNorm_real_nonneg_le_of_lintegral_ofReal_rpow_le volume
        (fun x : Euclidean d => ‖S f x‖) hp (fun _ => norm_nonneg _) hmoment
    _ = A ^ p⁻¹ * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
      rw [hinput_eq, ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
        ← ENNReal.rpow_mul]
      have hmul : p * p⁻¹ = 1 := by field_simp [hp.ne']
      rw [hmul, ENNReal.rpow_one]
    _ = _ := by rfl

/-- Real-norm form of Schwartz-core upper-exponent duality.  A lower bound
for the formal adjoint at the conjugate exponent controls the original
operator at every exponent above two. -/
private theorem lpNorm_schwartzCore_le_of_formalAdjoint_lower
    {d : Nat} {p A : Real} (hp : 2 < p) (hA : 0 ≤ A)
    (T Tstar : SchwartzMap (Euclidean d) Complex →
      SchwartzMap (Euclidean d) Complex)
    (hpair : ∀ f g : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, T f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar g x))
    (hTstar : ∀ g : SchwartzMap (Euclidean d) Complex,
      lpNorm (Tstar g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume ≤
        A * lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume)
    (f : SchwartzMap (Euclidean d) Complex) :
    lpNorm (T f : Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  letI : Fact (1 ≤ ENNReal.ofReal p) :=
    ⟨by rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp1.le⟩
  letI : Fact (1 ≤ ENNReal.ofReal p.conjExponent) :=
    ⟨one_le_ofReal_conjExponent p hp1⟩
  letI : ENNReal.HolderConjugate (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) :=
    ofReal_holderConjugate p hp1
  have hholder (u v : SchwartzMap (Euclidean d) Complex) :
      ‖∫ x : Euclidean d, u x * starRingEnd Complex (v x)‖ ≤
        lpNorm (u : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          lpNorm (v : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume := by
    let hu : MemLp (u : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
      u.memLp _ volume
    let hv : MemLp (v : Euclidean d → Complex)
        (ENNReal.ofReal p.conjExponent) volume := v.memLp _ volume
    let hsv : MemLp (fun x : Euclidean d => starRingEnd Complex (v x))
        (ENNReal.ofReal p.conjExponent) volume :=
      hv.congr_norm
        (Complex.continuous_conj.comp_aestronglyMeasurable
          v.continuous.aestronglyMeasurable)
        (Filter.Eventually.of_forall fun x => (Complex.norm_conj (v x)).symm)
    have henorm := enorm_integral_mul_le_eLpNorm_p_pconj_mul
      hp1 (u : Euclidean d → Complex) (fun x => starRingEnd Complex (v x)) hu hsv
    have hright :
        eLpNorm (u : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          eLpNorm (fun x => starRingEnd Complex (v x))
            (ENNReal.ofReal p.conjExponent) volume ≠ ∞ :=
      ENNReal.mul_ne_top hu.2.ne hsv.2.ne
    have hreal := (ENNReal.toReal_le_toReal ENNReal.coe_ne_top hright).mpr henorm
    change ‖∫ x : Euclidean d, u x * starRingEnd Complex (v x)‖ ≤ _ at hreal
    rw [ENNReal.toReal_mul, toReal_eLpNorm hu.1,
      toReal_eLpNorm hsv.1] at hreal
    have hstar_norm :
        lpNorm (fun x : Euclidean d => starRingEnd Complex (v x))
          (ENNReal.ofReal p.conjExponent) volume =
        lpNorm (v : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
      rw [← toReal_eLpNorm hsv.1, ← toReal_eLpNorm hv.1]
      apply congrArg ENNReal.toReal
      apply eLpNorm_congr_norm_ae
      exact Filter.Eventually.of_forall fun x => Complex.norm_conj (v x)
    simpa only [hstar_norm] using hreal
  let y : SchwartzMap (Euclidean d) Complex := T f
  let hy : MemLp (y : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    y.memLp _ volume
  let Φ : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d)) →L[Complex] Complex :=
    (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
      (hy.toLp y)
  have hconjugate_lp (g : SchwartzMap (Euclidean d) Complex) :
      lpNorm (conjugateSchwartz g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume =
        lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    rw [← toReal_eLpNorm (conjugateSchwartz g).continuous.aestronglyMeasurable,
      ← toReal_eLpNorm g.continuous.aestronglyMeasurable]
    congr 1
    apply eLpNorm_congr_norm_ae
    exact Filter.Eventually.of_forall fun x => by
      rw [conjugateSchwartz_apply, Complex.norm_conj]
  have hnorm_toLp (g : SchwartzMap (Euclidean d) Complex) :
      ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ =
        lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    rw [SchwartzMap.norm_toLp, toReal_eLpNorm g.continuous.aestronglyMeasurable]
  have hPhi_schwartz (g : SchwartzMap (Euclidean d) Complex) :
      ‖Φ (g.toLp (ENNReal.ofReal p.conjExponent) volume)‖ ≤
        (A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) *
          ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ := by
    have hraw : Φ (g.toLp (ENNReal.ofReal p.conjExponent) volume) =
        ∫ x : Euclidean d, T f x * g x := by
      rw [show Φ =
        (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
          (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
          (hy.toLp y) by rfl,
        lpPairing_apply_toLp_eq_integral hy]
      apply integral_congr_ae
      filter_upwards [g.coeFn_toLp (ENNReal.ofReal p.conjExponent) volume] with x hx
      rw [hx]
    rw [hraw]
    calc
      ‖∫ x : Euclidean d, T f x * g x‖ =
          ‖∫ x : Euclidean d, T f x *
            starRingEnd Complex (conjugateSchwartz g x)‖ := by
            congr 1
            apply integral_congr_ae
            filter_upwards with x
            rw [conjugateSchwartz_apply]
            simp
      _ = ‖∫ x : Euclidean d, f x * starRingEnd Complex
          (Tstar (conjugateSchwartz g) x)‖ := by
            rw [hpair f (conjugateSchwartz g)]
      _ ≤ lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          lpNorm (Tstar (conjugateSchwartz g) : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume :=
          hholder f (Tstar (conjugateSchwartz g))
      _ ≤ lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          (A * lpNorm (conjugateSchwartz g : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume) := by
            exact mul_le_mul_of_nonneg_left (hTstar (conjugateSchwartz g))
              lpNorm_nonneg
      _ = (A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) *
          ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ := by
            rw [hconjugate_lp g, hnorm_toLp g]
            ring
  have hPhi (g : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d))) :
      ‖Φ g‖ ≤ (A * lpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal p) volume) * ‖g‖ := by
    refine (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := Complex)
      (p := ENNReal.ofReal p.conjExponent) ENNReal.ofReal_ne_top).induction_on g ?_ ?_
    · exact isClosed_le Φ.continuous.norm
        (continuous_const.mul continuous_id.norm)
    · intro g
      simpa only [SchwartzMap.toLpCLM_apply] using hPhi_schwartz g
  have hKnonneg : 0 ≤ A * lpNorm (f : Euclidean d → Complex)
      (ENNReal.ofReal p) volume := mul_nonneg hA lpNorm_nonneg
  change lpNorm (y : Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
    A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume
  refine lpNorm_le_of_simple_test_pairing_bound hp1 hKnonneg hy ?_
  intro g
  have hraw : Φ (g : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d))) =
      ∫ x : Euclidean d, y x *
        (g : Lp Complex (ENNReal.ofReal p.conjExponent)
          (volume : Measure (Euclidean d))) x := by
    rw [show Φ =
      (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
        (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
        (hy.toLp y) by rfl,
      lpPairing_apply_toLp_eq_integral hy]
  rw [← hraw]
  exact hPhi (g : Lp Complex (ENNReal.ofReal p.conjExponent)
    (volume : Measure (Euclidean d)))

/-- ENNReal strong-norm form of the dimension-generic upper-half
Schwartz-core duality bridge. -/
theorem eLpNorm_schwartzCore_le_of_formalAdjoint_lower
    {d : Nat} {p A : Real} (hp : 2 < p) (hA : 0 ≤ A)
    (T Tstar : SchwartzMap (Euclidean d) Complex →
      SchwartzMap (Euclidean d) Complex)
    (hpair : ∀ f g : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, T f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar g x))
    (hTstar : ∀ g : SchwartzMap (Euclidean d) Complex,
      eLpNorm (Tstar g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume ≤
        ENNReal.ofReal A * eLpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (T f : Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal A * eLpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  have hTstar_real (g : SchwartzMap (Euclidean d) Complex) :
      lpNorm (Tstar g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume ≤
        A * lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    let hg : MemLp (g : Euclidean d → Complex)
        (ENNReal.ofReal p.conjExponent) volume := g.memLp _ volume
    let hTg : MemLp (Tstar g : Euclidean d → Complex)
        (ENNReal.ofReal p.conjExponent) volume := (Tstar g).memLp _ volume
    have hright : ENNReal.ofReal A *
        eLpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume ≠ ∞ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top hg.2.ne
    have hreal := (ENNReal.toReal_le_toReal hTg.2.ne hright).mpr (hTstar g)
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hA,
      toReal_eLpNorm hTg.1, toReal_eLpNorm hg.1] at hreal
    exact hreal
  have hreal := lpNorm_schwartzCore_le_of_formalAdjoint_lower hp hA T Tstar hpair
    hTstar_real f
  let hf : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp _ volume
  let hTf : MemLp (T f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    (T f).memLp _ volume
  have hright : ENNReal.ofReal A *
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hf.2.ne
  apply (ENNReal.toReal_le_toReal hTf.2.ne hright).mp
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hA,
    toReal_eLpNorm hTf.1, toReal_eLpNorm hf.1]
  exact hreal

/-! ### Generic finite convolution Calderón--Zygmund datum

The lacunary stopping-time development is phrased for arbitrary integrable
functions and finite dyadic-cube families.  The following small interface
extracts the genuinely kernel-generic part of that machinery: algebraic
good--bad splitting and the level-set reduction to an `L²` good term plus a
summed exterior mean-zero tail.  It is deliberately independent of spherical
averages.
-/

/-- The literal convolution operator associated with a physical kernel, in
the ordering used by the dyadic-cube Calderón--Zygmund bridge. -/
def finiteConvolutionKernelOperator {d : Nat} (K : Euclidean d → Complex)
    (g : Euclidean d → Complex) (x : Euclidean d) : Complex :=
  ∫ y : Euclidean d, g y * K (x - y)

/-- The finite sum of absolute bad-atom outputs for a literal convolution
kernel. -/
def finiteConvolutionKernelBadTail {d : Nat} (K : Euclidean d → Complex)
    (f : Euclidean d → Complex) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (x : Euclidean d) : Real :=
  ∑ q ∈ U, ‖finiteConvolutionKernelOperator K
    (lacunaryCZDyadicCubeBadAtom f q) x‖

/-- The convolution operator respects the finite dyadic-cube good--bad
decomposition.  This is a direct reuse of the existing generic operator
bridge, rather than a spherical-specialized identity. -/
theorem finiteConvolutionKernelOperator_decomposition {d : Nat}
    (K : Euclidean d → Complex) (hK : Continuous K) {C : Real}
    (hKbound : ∀ z, ‖K z‖ ≤ C) (f : Euclidean d → Complex)
    (hf : Integrable f volume) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (x : Euclidean d) :
    finiteConvolutionKernelOperator K f x =
      finiteConvolutionKernelOperator K (lacunaryCZDyadicCubeGoodPart f U) x +
        ∑ q ∈ U, finiteConvolutionKernelOperator K
          (lacunaryCZDyadicCubeBadAtom f q) x := by
  simpa only [finiteConvolutionKernelOperator] using
    lacunaryCZDyadicCube_kernel_integral_decomposition K hK hKbound f hf U x

/-- Pointwise reduction of a literal convolution to its good contribution
and the unsigned finite bad tail. -/
theorem norm_finiteConvolutionKernelOperator_le_good_add_badTail {d : Nat}
    (K : Euclidean d → Complex) (hK : Continuous K) {C : Real}
    (hKbound : ∀ z, ‖K z‖ ≤ C) (f : Euclidean d → Complex)
    (hf : Integrable f volume) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (x : Euclidean d) :
    ‖finiteConvolutionKernelOperator K f x‖ ≤
      ‖finiteConvolutionKernelOperator K
        (lacunaryCZDyadicCubeGoodPart f U) x‖ +
        finiteConvolutionKernelBadTail K f U x := by
  rw [finiteConvolutionKernelOperator_decomposition K hK hKbound f hf U x]
  unfold finiteConvolutionKernelBadTail
  exact (norm_add_le _ _).trans
    (add_le_add_right (norm_sum_le U _) _)

/-- The standard Calderón--Zygmund level-set split for any bounded
continuous physical kernel.  The only analytic information still needed for
a weak endpoint is an `L²` good bound and an exterior estimate for the
explicit tail above. -/
theorem finiteConvolutionKernel_level_subset_good_union_badTail {d : Nat}
    (K : Euclidean d → Complex) (hK : Continuous K) {C lambda : Real}
    (hKbound : ∀ z, ‖K z‖ ≤ C) (f : Euclidean d → Complex)
    (hf : Integrable f volume) (U : Finset (LacunaryCZDyadicCubeIndex d))
    (E : Set (Euclidean d)) :
    ({x | lambda < ‖finiteConvolutionKernelOperator K f x‖} ∩ Eᶜ) ⊆
      {x | lambda / 2 < ‖finiteConvolutionKernelOperator K
        (lacunaryCZDyadicCubeGoodPart f U) x‖} ∪
        ({x | lambda / 2 < finiteConvolutionKernelBadTail K f U x} ∩ Eᶜ) := by
  intro x hx
  by_cases hgood : lambda / 2 < ‖finiteConvolutionKernelOperator K
      (lacunaryCZDyadicCubeGoodPart f U) x‖
  · exact Or.inl hgood
  · right
    refine ⟨?_, hx.2⟩
    change lambda / 2 < finiteConvolutionKernelBadTail K f U x
    by_contra hbad
    have hpoint := norm_finiteConvolutionKernelOperator_le_good_add_badTail
      K hK hKbound f hf U x
    have hgood' : ‖finiteConvolutionKernelOperator K
        (lacunaryCZDyadicCubeGoodPart f U) x‖ ≤ lambda / 2 :=
      le_of_not_gt hgood
    have hbad' : finiteConvolutionKernelBadTail K f U x ≤ lambda / 2 :=
      le_of_not_gt hbad
    have hle : ‖finiteConvolutionKernelOperator K f x‖ ≤ lambda := by
      linarith
    exact (not_lt_of_ge hle) hx.1

/-- The abstract strong `L²` datum required of a literal convolution kernel
in the generic finite Calderón--Zygmund argument. -/
def HasFiniteConvolutionKernelL2Bound {d : Nat} (K : Euclidean d → Complex)
    (C₂ : Real) : Prop :=
  ∀ (g : Euclidean d → Complex) (_hg : Integrable g volume)
    (hg₂ : MemLp g 2 volume),
    ∃ hT : MemLp (fun x : Euclidean d =>
      ‖finiteConvolutionKernelOperator K g x‖) 2 volume,
      ‖hT.toLp (fun x : Euclidean d =>
        ‖finiteConvolutionKernelOperator K g x‖)‖ ≤ C₂ * ‖hg₂.toLp g‖

/-- The `L²` datum actually used for the bounded Calderón--Zygmund good
part.  Keeping this weaker version separate is important: a multiplier
initially constructed on a Schwartz core need only be identified with its
literal physical convolution on bounded integrable inputs. -/
def HasFiniteConvolutionKernelGoodL2Bound {d : Nat} (K : Euclidean d → Complex)
    (C₂ : Real) : Prop :=
  ∀ (g : Euclidean d → Complex) (_hg : Integrable g volume)
    (hg₂ : MemLp g 2 volume) (B : Real), 0 ≤ B →
    (∀ x, ‖g x‖ ≤ B) →
    ∃ hT : MemLp (fun x : Euclidean d =>
      ‖finiteConvolutionKernelOperator K g x‖) 2 volume,
      ‖hT.toLp (fun x : Euclidean d =>
        ‖finiteConvolutionKernelOperator K g x‖)‖ ≤ C₂ * ‖hg₂.toLp g‖

/-- A full literal convolution `L²` bound supplies the bounded-good-part
version required by the finite Calderón--Zygmund argument. -/
theorem HasFiniteConvolutionKernelL2Bound.to_good {d : Nat}
    {K : Euclidean d → Complex} {C₂ : Real}
    (h : HasFiniteConvolutionKernelL2Bound K C₂) :
    HasFiniteConvolutionKernelGoodL2Bound K C₂ := by
  intro g hg hg₂ B _hB _hgB
  exact h g hg hg₂

/-! ### Extending a Schwartz-core multiplier to bounded good parts

The generic finite Calderón--Zygmund argument only applies its `L²` input to
bounded integrable good parts.  This short density bridge therefore starts
from a literal convolution multiplier on the Schwartz core, extends it in
`L²`, and identifies that extension with physical convolution by testing
against Schwartz functions. -/

private theorem memLp_two_convolutionPhysicalAdjoint_schwartz
    {d : Nat} (K : Euclidean d → Complex) (h : SchwartzMap (Euclidean d) Complex)
    (hK : Integrable K volume) :
    MemLp (convolutionPhysicalAdjoint K h) 2 volume := by
  let Kstar : Euclidean d → Complex := fun z => conj (K (-z))
  have hKneg : Integrable (fun z : Euclidean d => K (-z)) volume := by
    simpa using hK.comp_neg
  have hKstar : Integrable Kstar volume := by
    change Integrable (fun z : Euclidean d =>
      (Complex.conjCLE : Complex →L[Real] Complex) (K (-z))) volume
    exact (Complex.conjCLE : Complex →L[Real] Complex).integrable_comp hKneg
  have hconv := memLp_two_convolution_of_integrable_of_norm_le Kstar
    (h : Euclidean d → Complex) hKstar h.integrable
    ‖h.toBoundedContinuousFunction‖ (norm_nonneg _)
    (fun x => BoundedContinuousFunction.norm_coe_le_norm h.toBoundedContinuousFunction x)
  have heq : convolutionPhysicalAdjoint K h = fun y : Euclidean d =>
      ∫ x : Euclidean d, h x * Kstar (y - x) := by
    funext y
    apply integral_congr_ae
    filter_upwards with x
    dsimp [convolutionPhysicalAdjoint, Kstar]
    congr 2
    congr 1
    abel
  rw [heq]
  exact hconv

private theorem inner_convolution_eq_physicalAdjoint
    {d : Nat} (K g : Euclidean d → Complex) (h : SchwartzMap (Euclidean d) Complex)
    (hK : Integrable K volume) (hg : Integrable g volume)
    (hg₂ : MemLp g 2 volume)
    (hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume)
    (hA : MemLp (convolutionPhysicalAdjoint K h) 2 volume) :
    inner Complex (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)) =
      inner Complex (hg₂.toLp g) (hA.toLp (convolutionPhysicalAdjoint K h)) := by
  rw [L2.inner_def, L2.inner_def]
  have hleft :
      (∫ x : Euclidean d,
        inner Complex (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) x)
          ((h.memLp 2 volume).toLp (h : Euclidean d → Complex) x)) =
        ∫ x : Euclidean d, h x * conj (∫ y : Euclidean d, g y * K (x - y)) := by
    apply integral_congr_ae
    filter_upwards [hP.coeFn_toLp, (h.memLp 2 volume).coeFn_toLp] with x hPx hhx
    rw [hPx, hhx, RCLike.inner_apply]
  have hright :
      (∫ y : Euclidean d,
        inner Complex (hg₂.toLp g y) (hA.toLp (convolutionPhysicalAdjoint K h) y)) =
        ∫ y : Euclidean d, convolutionPhysicalAdjoint K h y * conj (g y) := by
    apply integral_congr_ae
    filter_upwards [hg₂.coeFn_toLp, hA.coeFn_toLp] with y hgy hAy
    rw [hgy, hAy, RCLike.inner_apply]
  rw [hleft, hright]
  exact integral_schwartz_mul_star_convolution_eq K g h hK hg

private theorem lipschitz_extension_eq_physical_convolution
    {d : Nat} (K : Euclidean d → Complex)
    (Tbar : Lp Complex 2 (volume : Measure (Euclidean d)) → Lp Complex 2 volume)
    (hTbarCont : Continuous Tbar) (hK : Integrable K volume)
    (hTbarCore : ∀ f : SchwartzMap (Euclidean d) Complex,
      Tbar (f.toLp 2 volume) =
        (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → Complex)
          hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
          (fun x => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction x)).toLp
          (fun x : Euclidean d => ∫ y : Euclidean d, f y * K (x - y)))
    (g : Euclidean d → Complex) (hg : Integrable g volume) (hg₂ : MemLp g 2 volume)
    (B : Real) (hB : 0 ≤ B) (hgB : ∀ x, ‖g x‖ ≤ B) :
    Tbar (hg₂.toLp g) =
      (memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB).toLp
        (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) := by
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  let hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume :=
    memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB
  let hA : ∀ h : SchwartzMap (Euclidean d) Complex,
      MemLp (convolutionPhysicalAdjoint K h) 2 volume := fun h =>
    memLp_two_convolutionPhysicalAdjoint_schwartz K h hK
  apply (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := Complex)
    (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).eq_of_inner_left Complex
  intro h
  have hcorePair (f : SchwartzMap (Euclidean d) Complex) :
      inner Complex (Tbar (f.toLp 2 volume))
          ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)) =
        inner Complex (f.toLp 2 volume)
          ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    rw [hTbarCore f]
    exact inner_convolution_eq_physicalAdjoint K (f : Euclidean d → Complex) h hK f.integrable
      (f.memLp 2 volume)
      (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → Complex)
        hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
        (fun x => BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction x))
      (hA h)
  have hpairs (G : Lp Complex 2 (volume : Measure (Euclidean d))) :
      inner Complex (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)) =
        inner Complex G ((hA h).toLp (convolutionPhysicalAdjoint K h)) := by
    let left : Lp Complex 2 (volume : Measure (Euclidean d)) → Complex := fun G =>
      inner Complex (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → Complex))
    let right : Lp Complex 2 (volume : Measure (Euclidean d)) → Complex := fun G =>
      inner Complex G ((hA h).toLp (convolutionPhysicalAdjoint K h))
    have hleftCont : Continuous left := by
      change Continuous (fun G : Lp Complex 2 (volume : Measure (Euclidean d)) =>
        inner Complex (Tbar G) ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)))
      exact continuous_inner.comp (hTbarCont.prodMk continuous_const)
    have hrightCont : Continuous right := by
      change Continuous (fun G : Lp Complex 2 (volume : Measure (Euclidean d)) =>
        inner Complex G ((hA h).toLp (convolutionPhysicalAdjoint K h)))
      exact continuous_inner.comp (continuous_id.prodMk continuous_const)
    have heq : left ∘ (fun f : SchwartzMap (Euclidean d) Complex => f.toLp 2 volume) =
        right ∘ (fun f : SchwartzMap (Euclidean d) Complex => f.toLp 2 volume) := by
      funext f
      exact hcorePair f
    change left G = right G
    exact congrFun
      ((SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := Complex)
        (p := (2 : ENNReal)) ENNReal.ofNat_ne_top).equalizer hleftCont hrightCont heq) G
  calc
    inner Complex (Tbar (hg₂.toLp g)) ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)) =
        inner Complex (hg₂.toLp g) ((hA h).toLp (convolutionPhysicalAdjoint K h)) :=
      hpairs (hg₂.toLp g)
    _ = inner Complex (hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)))
        ((h.memLp 2 volume).toLp (h : Euclidean d → Complex)) :=
      (inner_convolution_eq_physicalAdjoint K g h hK hg hg₂ hP (hA h)).symm

/-- A Schwartz-core linear multiplier with a strong `(2,2)` bound and a
literal integrable convolution kernel supplies the `L²` good-part datum
needed by the finite Calderón--Zygmund argument.  The conclusion deliberately
requires only bounded integrable physical inputs, which is the precise range
of the stopping-time good part. -/
theorem hasFiniteConvolutionKernelGoodL2Bound_of_schwartz_core
    {d : Nat} (K : Euclidean d → Complex) (hK : Integrable K volume)
    (C : Real) (hC : 0 ≤ C)
    (Tcore : SchwartzMap (Euclidean d) Complex → Lp Complex 2 volume)
    (hTcore_sub : ∀ f g : SchwartzMap (Euclidean d) Complex,
      Tcore (f - g) = Tcore f - Tcore g)
    (hTcore_bound : ∀ f : SchwartzMap (Euclidean d) Complex,
      ‖Tcore f‖ ≤ C * ‖f.toLp 2 volume‖)
    (hTcore_physical : ∀ f : SchwartzMap (Euclidean d) Complex,
      Tcore f =
        (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → Complex)
          hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
          (fun x => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction x)).toLp
          (fun x : Euclidean d => ∫ y : Euclidean d, f y * K (x - y))) :
    HasFiniteConvolutionKernelGoodL2Bound K C := by
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  have hTcore_zero : Tcore 0 = 0 := by
    apply norm_eq_zero.mp
    apply le_antisymm
    · have hzero : (0 : SchwartzMap (Euclidean d) Complex).toLp 2 volume = 0 := by
        change (SchwartzMap.toLpCLM Real Complex 2 volume) 0 = 0
        exact map_zero _
      simpa [hzero] using hTcore_bound (0 : SchwartzMap (Euclidean d) Complex)
    · exact norm_nonneg _
  have hTcore_lip (f g : SchwartzMap (Euclidean d) Complex) :
      dist (Tcore f) (Tcore g) ≤ C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
    calc
      dist (Tcore f) (Tcore g) = ‖Tcore f - Tcore g‖ := by
        rw [Lp.dist_eq_norm]
        rw [show -Tcore f + Tcore g = -(Tcore f - Tcore g) by abel, norm_neg]
      _ = ‖Tcore (f - g)‖ := by rw [hTcore_sub]
      _ ≤ C * ‖(f - g).toLp 2 volume‖ := hTcore_bound (f - g)
      _ = C * dist (f.toLp 2 volume) (g.toLp 2 volume) := by
        have htoLp_sub : (f - g).toLp 2 volume =
            f.toLp 2 volume - g.toLp 2 volume := by
          change (SchwartzMap.toLpCLM Real Complex 2 volume) (f - g) =
            (SchwartzMap.toLpCLM Real Complex 2 volume) f -
              (SchwartzMap.toLpCLM Real Complex 2 volume) g
          exact map_sub _ _ _
        rw [htoLp_sub, Lp.dist_eq_norm]
        rw [show -f.toLp 2 volume + g.toLp 2 volume =
          -(f.toLp 2 volume - g.toLp 2 volume) by abel, norm_neg]
  obtain ⟨Tbar, hagree, hLip, hTbarBound⟩ :=
    exists_lipschitz_extension_of_denseRange_norm_bound
      (e := fun f : SchwartzMap (Euclidean d) Complex => f.toLp 2 volume)
      (a0 := (0 : SchwartzMap (Euclidean d) Complex))
      (SchwartzMap.denseRange_toLpCLM ENNReal.ofNat_ne_top)
      (by
        simpa only [SchwartzMap.toLpCLM_apply] using
          (SchwartzMap.injective_toLp (E := Euclidean d) (F := Complex) 2 volume))
      Tcore C hC
      (by
        change (SchwartzMap.toLpCLM Real Complex 2 volume) 0 = 0
        exact map_zero _)
      hTcore_zero hTcore_lip
  intro g hg hg₂ B hB hgB
  let hP : MemLp (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) 2 volume :=
    memLp_two_convolution_of_integrable_of_norm_le K g hK hg B hB hgB
  have hTbarCore : ∀ f : SchwartzMap (Euclidean d) Complex,
      Tbar (f.toLp 2 volume) =
        (memLp_two_convolution_of_integrable_of_norm_le K (f : Euclidean d → Complex)
          hK f.integrable ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
          (fun x => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction x)).toLp
          (fun x : Euclidean d => ∫ y : Euclidean d, f y * K (x - y)) := by
    intro f
    rw [hagree f]
    exact hTcore_physical f
  have hphysical : Tbar (hg₂.toLp g) = hP.toLp
      (fun x : Euclidean d => ∫ y : Euclidean d, g y * K (x - y)) := by
    exact lipschitz_extension_eq_physical_convolution K Tbar hLip.continuous hK
      hTbarCore g hg hg₂ B hB hgB
  change ∃ hT : MemLp (fun x : Euclidean d =>
      ‖∫ y : Euclidean d, g y * K (x - y)‖) 2 volume,
      ‖hT.toLp (fun x : Euclidean d => ‖∫ y : Euclidean d,
        g y * K (x - y)‖)‖ ≤ C * ‖hg₂.toLp g‖
  refine ⟨hP.norm, ?_⟩
  calc
    ‖hP.norm.toLp (fun x : Euclidean d => ‖∫ y : Euclidean d,
        g y * K (x - y)‖)‖ =
        ‖hP.toLp (fun x : Euclidean d => ∫ y : Euclidean d,
          g y * K (x - y))‖ := by
      rw [Lp.norm_toLp, Lp.norm_toLp, eLpNorm_norm]
    _ = ‖Tbar (hg₂.toLp g)‖ := by rw [hphysical]
    _ ≤ C * ‖hg₂.toLp g‖ := hTbarBound (hg₂.toLp g)

/-- The Schwartz realization of a finite signed dyadic multiplier agrees
with physical convolution by its literal finite signed kernel. -/
private theorem finiteSignedIntegerDyadicMultiplierSchwartz_physical
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSignedIntegerDyadicMultiplierSchwartz C K a f x =
      ∫ y : Euclidean d, f y *
        finiteSignedIntegerDyadicBandpassKernel C K a (x - y) := by
  rw [finiteSignedIntegerDyadicMultiplierSchwartz_apply,
    finiteSignedIntegerDyadicMultiplier_eq_convolution_kernel,
    convolution_mul_swap]
  apply integral_congr_ae
  filter_upwards with y
  rw [finiteSignedIntegerDyadicMultiplierKernel_eq_bandpassKernel, mul_comm]

/-- The finite signed dyadic multiplier has the literal L² operator norm
bound 4 on the Schwartz core. -/
private theorem norm_finiteSignedIntegerDyadicMultiplierSchwartz_toLp_le_four
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex) :
    ‖(finiteSignedIntegerDyadicMultiplierSchwartz C K a f).toLp 2 volume‖ ≤
      4 * ‖f.toLp 2 volume‖ := by
  let q : SchwartzMap (Euclidean d) Complex :=
    finiteSignedIntegerDyadicMultiplierSchwartz C K a f
  have hsq := integral_norm_sq_finiteSignedIntegerDyadicMultiplier_le C K a ha f
  change ‖q.toLp 2 volume‖ ≤ 4 * ‖f.toLp 2 volume‖
  have hqnorm : ‖q.toLp 2 volume‖ =
      √(∫ x : Euclidean d, ‖q x‖ ^ (2 : Nat)) := by
    rw [SchwartzMap.norm_toLp' (p := 2) (μ := volume) (by norm_num) (by norm_num)]
    norm_num [Real.sqrt_eq_rpow]
  have hfnorm : ‖f.toLp 2 volume‖ =
      √(∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) := by
    rw [SchwartzMap.norm_toLp' (p := 2) (μ := volume) (by norm_num) (by norm_num)]
    norm_num [Real.sqrt_eq_rpow]
  rw [hqnorm, hfnorm]
  have hsq' : (∫ x : Euclidean d, ‖q x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
    calc
      (∫ x : Euclidean d, ‖q x‖ ^ (2 : Nat)) =
          ∫ x : Euclidean d, ‖finiteSignedIntegerDyadicMultiplier C K a f x‖ ^ (2 : Nat) := by
        apply integral_congr_ae
        filter_upwards with x
        rw [show q x = finiteSignedIntegerDyadicMultiplier C K a f x by
          exact finiteSignedIntegerDyadicMultiplierSchwartz_apply C K a f x]
      _ ≤ 16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := hsq
  calc
    √(∫ x : Euclidean d, ‖q x‖ ^ (2 : Nat)) ≤
        √(16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) := Real.sqrt_le_sqrt hsq'
    _ = 4 * √(∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) := by
      rw [Real.sqrt_mul (by norm_num : (0 : Real) ≤ 16)]
      have h16 : √(16 : Real) = 4 := by
        rw [show (16 : Real) = 4 ^ (2 : Nat) by norm_num,
          Real.sqrt_sq_eq_abs]
        norm_num
      rw [h16]

/-- Finite signed dyadic band-pass kernels satisfy the bounded-good-part
L² datum with a cardinality-free constant.  This is the physical
Calderón--Zygmund interface for their Plancherel estimate. -/
theorem hasFiniteConvolutionKernelGoodL2Bound_finiteSignedIntegerDyadicBandpassKernel
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) :
    HasFiniteConvolutionKernelGoodL2Bound
      (finiteSignedIntegerDyadicBandpassKernel C K a) 4 := by
  apply hasFiniteConvolutionKernelGoodL2Bound_of_schwartz_core
    (K := finiteSignedIntegerDyadicBandpassKernel C K a)
    (C := 4)
    (integrable_finiteSignedIntegerDyadicBandpassKernel C K a)
    (by norm_num)
    (Tcore := fun f =>
      (finiteSignedIntegerDyadicMultiplierSchwartz C K a f).toLp 2 volume)
  · intro f g
    change (SchwartzMap.toLpCLM Real Complex 2 volume)
        (finiteSignedIntegerDyadicMultiplierSchwartz C K a (f - g)) = _
    calc
      (SchwartzMap.toLpCLM Real Complex 2 volume)
          (finiteSignedIntegerDyadicMultiplierSchwartz C K a (f - g)) =
        (SchwartzMap.toLpCLM Real Complex 2 volume)
          (finiteSignedIntegerDyadicMultiplierSchwartz C K a f -
            finiteSignedIntegerDyadicMultiplierSchwartz C K a g) := by rw [map_sub]
      _ = (finiteSignedIntegerDyadicMultiplierSchwartz C K a f).toLp 2 volume -
          (finiteSignedIntegerDyadicMultiplierSchwartz C K a g).toLp 2 volume := by
          simpa only [SchwartzMap.toLpCLM_apply] using
            (map_sub (SchwartzMap.toLpCLM Real Complex 2 volume)
              (finiteSignedIntegerDyadicMultiplierSchwartz C K a f)
              (finiteSignedIntegerDyadicMultiplierSchwartz C K a g))
  · intro f
    exact norm_finiteSignedIntegerDyadicMultiplierSchwartz_toLp_le_four C K a ha f
  · intro f
    apply Lp.ext
    filter_upwards [SchwartzMap.coeFn_toLp
        (finiteSignedIntegerDyadicMultiplierSchwartz C K a f) 2 volume,
      (memLp_two_convolution_of_integrable_of_norm_le
        (finiteSignedIntegerDyadicBandpassKernel C K a) (f : Euclidean d → Complex)
        (integrable_finiteSignedIntegerDyadicBandpassKernel C K a) f.integrable
        ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
        (fun x => BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction x)).coeFn_toLp]
      with x hx1 hx2
    rw [hx1, hx2]
    exact finiteSignedIntegerDyadicMultiplierSchwartz_physical C K a f x

/-- A summed exterior mean-zero tail datum for the literal finite
convolution kernel.  The three atom hypotheses are exactly those supplied by
the dyadic-cube Calderón--Zygmund decomposition. -/
def HasFiniteConvolutionKernelCZTail {d : Nat} (K : Euclidean d → Complex)
    (B : Real) : Prop :=
  ∀ (f : Euclidean d → Complex) (U : Finset (LacunaryCZDyadicCubeIndex d)),
    (∀ q ∈ U, Integrable (lacunaryCZDyadicCubeBadAtom f q) volume) →
    (∀ q ∈ U, (∫ x : Euclidean d, lacunaryCZDyadicCubeBadAtom f q x) = 0) →
    (∀ q ∈ U, ∀ x : Euclidean d,
      lacunaryCZDyadicCubeBadAtom f q x ≠ 0 →
        ‖x - lacunaryCZDyadicCubeCenter q‖ ≤ lacunaryCZDyadicCubeRadius q) →
    Integrable (finiteConvolutionKernelBadTail K f U) volume ∧
    (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      finiteConvolutionKernelBadTail K f U x) ≤
      B * ∑ q ∈ U, ∫ x : Euclidean d,
        ‖lacunaryCZDyadicCubeBadAtom f q x‖

/-- A translation-invariant integral Hörmander bound can be recentered at
two arbitrary points.  This is the exact kernel estimate used by the
mean-zero atom argument, and is independent of the ambient dimension. -/
theorem integral_norm_kernel_sub_shift_le_of_hormander
    {d : Nat} (K : Euclidean d → Complex) (B : Real)
    (htrans : ∀ h : Euclidean d,
      ∫ x : Euclidean d, ‖K (x + h) - K x‖ ≤ B)
    (y c : Euclidean d) :
    (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤ B := by
  let F : Euclidean d → Real := fun z => ‖K (z + (c - y)) - K z‖
  have hEq : (fun x : Euclidean d => ‖K (x - y) - K (x - c)‖) =
      fun x => F (x - c) := by
    funext x
    dsimp [F]
    congr 2 <;> abel
  rw [hEq, integral_sub_right_eq_self]
  exact htrans (c - y)

/-- A globally uniform integral Hörmander estimate gives the usual
mean-zero atom bound for a literal convolution kernel.  This is the
dimension-generic cancellation step underlying the finite
Calderón--Zygmund tail datum. -/
theorem integral_norm_mean_zero_kernel_convolution_le_of_hormander
    {d : Nat} (K : Euclidean d → Complex) (hK : Integrable K volume)
    (B : Real)
    (htrans : ∀ h : Euclidean d,
      ∫ x : Euclidean d, ‖K (x + h) - K x‖ ≤ B)
    (b : Euclidean d → Complex) (hb : Integrable b volume)
    (hzero : (∫ y : Euclidean d, b y) = 0) (c : Euclidean d) :
    (∫ x : Euclidean d,
      ‖∫ y : Euclidean d, b y * K (x - y)‖) ≤
      B * ∫ y : Euclidean d, ‖b y‖ := by
  let F : Euclidean d × Euclidean d → Complex := fun p =>
    b p.2 * K (p.1 - p.2)
  let G : Euclidean d × Euclidean d → Complex := fun p =>
    b p.2 * K (p.1 - c)
  have hF : Integrable F (volume.prod volume) := by
    simpa only [F, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul Complex Complex) hK
  have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
    hK.comp_sub_right c
  have hGmeas : AEStronglyMeasurable G (volume.prod volume) := by
    exact hb.aestronglyMeasurable.comp_snd.mul
      hKshift.aestronglyMeasurable.comp_fst
  have hG : Integrable G (volume.prod volume) := by
    apply (integrable_prod_iff hGmeas).mpr
    constructor
    · filter_upwards with x
      exact hb.mul_const (K (x - c))
    · have houter : Integrable (fun x : Euclidean d =>
          (∫ y : Euclidean d, ‖b y‖) * ‖K (x - c)‖) volume :=
        hKshift.norm.const_mul _
      convert houter using 1
      funext x
      change (∫ y : Euclidean d, ‖b y * K (x - c)‖) = _
      calc
        (∫ y : Euclidean d, ‖b y * K (x - c)‖) =
            ∫ y : Euclidean d, ‖b y‖ * ‖K (x - c)‖ := by
              apply integral_congr_ae
              filter_upwards with y
              rw [norm_mul]
        _ = _ := integral_mul_const (‖K (x - c)‖)
          (fun y : Euclidean d => ‖b y‖)
  have hdiff : Integrable (F - G) (volume.prod volume) := hF.sub hG
  have hR0 : Integrable (fun y : Euclidean d =>
      ∫ x : Euclidean d, ‖(F - G) (x, y)‖) :=
    hdiff.norm.integral_prod_right
  have hReq : (fun y : Euclidean d =>
      ∫ x : Euclidean d, ‖(F - G) (x, y)‖) =
      fun y => ‖b y‖ * ∫ x : Euclidean d,
        ‖K (x - y) - K (x - c)‖ := by
    funext y
    change (∫ x : Euclidean d,
      ‖b y * K (x - y) - b y * K (x - c)‖) = _
    calc
      (∫ x : Euclidean d,
        ‖b y * K (x - y) - b y * K (x - c)‖) =
          ∫ x : Euclidean d, ‖b y‖ * ‖K (x - y) - K (x - c)‖ := by
            apply integral_congr_ae
            filter_upwards with x
            rw [← mul_sub, norm_mul]
      _ = _ := integral_const_mul (‖b y‖)
        (fun x : Euclidean d => ‖K (x - y) - K (x - c)‖)
  rw [hReq] at hR0
  have hBint : Integrable (fun y : Euclidean d => ‖b y‖ * B) := by
    simpa [mul_comm] using hb.norm.const_mul B
  have hRle : (fun y : Euclidean d => ‖b y‖ *
      ∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) ≤
      fun y => ‖b y‖ * B := by
    intro y
    exact mul_le_mul_of_nonneg_left
      (integral_norm_kernel_sub_shift_le_of_hormander K B htrans y c)
      (norm_nonneg _)
  calc
    (∫ x : Euclidean d,
      ‖∫ y : Euclidean d, b y * K (x - y)‖) ≤
        ∫ y : Euclidean d, ‖b y‖ *
          (∫ x : Euclidean d, ‖K (x - y) - K (x - c)‖) :=
      Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integral_norm_mean_zero_kernel_convolution_le
        K hK b hb hzero c
    _ ≤ ∫ y : Euclidean d, ‖b y‖ * B :=
      integral_mono hR0 hBint hRle
    _ = B * ∫ y : Euclidean d, ‖b y‖ := by
      rw [integral_mul_const]
      ring

/-- The mean-zero convolution estimate remains valid after restricting the
outer variable to an arbitrary measurable region.  This is the Fubini form
needed when the Hörmander bound is available only on the exterior of an
atom ball. -/
theorem restricted_mean_zero_kernel_convolution
    {d : Nat} (K : Euclidean d -> Complex) (hK : Integrable K volume)
    (b : Euclidean d -> Complex) (hb : Integrable b volume)
    (hzero : (integral volume b) = 0) (c : Euclidean d)
    (E : Set (Euclidean d)) :
    integral (volume.restrict E)
      (fun x => norm (integral volume (fun y => b y * K (x - y)))) <=
      integral volume (fun y => norm (b y) *
        integral (volume.restrict E)
          (fun x => norm (K (x - y) - K (x - c)))) := by
  let mu : Measure (Euclidean d) := volume.restrict E
  let F : Euclidean d × Euclidean d → Complex := fun p =>
    b p.2 * K (p.1 - p.2)
  let G : Euclidean d × Euclidean d → Complex := fun p =>
    b p.2 * K (p.1 - c)
  have hF0 : Integrable F (volume.prod volume) := by
    simpa only [F, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul Complex Complex) hK
  have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
    hK.comp_sub_right c
  have hGmeas0 : AEStronglyMeasurable G (volume.prod volume) := by
    exact hb.aestronglyMeasurable.comp_snd.mul
      hKshift.aestronglyMeasurable.comp_fst
  have hG0 : Integrable G (volume.prod volume) := by
    apply (integrable_prod_iff hGmeas0).mpr
    constructor
    · filter_upwards with x
      exact hb.mul_const (K (x - c))
    · have houter : Integrable (fun x : Euclidean d =>
          (integral volume fun y => norm (b y)) * norm (K (x - c))) volume :=
        hKshift.norm.const_mul _
      convert houter using 1
      funext x
      change (integral volume fun y => norm (b y * K (x - c))) = _
      calc
        (integral volume fun y => norm (b y * K (x - c))) =
            integral volume (fun y => norm (b y) * norm (K (x - c))) := by
              apply integral_congr_ae
              filter_upwards with y
              rw [norm_mul]
        _ = _ := integral_mul_const (norm (K (x - c)) : Real)
          (fun y : Euclidean d => norm (b y))
  have hF : Integrable F (mu.prod volume) := by
    exact hF0.mono_measure (Measure.prod_mono Measure.restrict_le_self le_rfl)
  have hG : Integrable G (mu.prod volume) := by
    exact hG0.mono_measure (Measure.prod_mono Measure.restrict_le_self le_rfl)
  have hdiff : Integrable (F - G) (mu.prod volume) := hF.sub hG
  have hFib : ∀ᵐ x : Euclidean d ∂mu,
      Integrable (fun y : Euclidean d => F (x, y)) volume :=
    (integrable_prod_iff hF.aestronglyMeasurable).mp hF |>.1
  have hcancel : ∀ᵐ x : Euclidean d ∂mu,
      (integral volume fun y => F (x, y)) =
        integral volume (fun y => (F - G) (x, y)) := by
    filter_upwards [hFib] with x hx
    change (integral volume fun y => F (x, y)) =
      integral volume (fun y => F (x, y) - G (x, y))
    rw [integral_sub hx (hb.mul_const (K (x - c)))]
    have hGint : (integral volume fun y => G (x, y)) = 0 := by
      change (integral volume fun y => b y * K (x - c)) = 0
      rw [integral_mul_const, hzero, zero_mul]
    rw [hGint, sub_zero]
  have hright : Integrable (fun x : Euclidean d =>
      integral volume (fun y => norm ((F - G) (x, y)))) mu :=
    hdiff.norm.integral_prod_left
  have hleft : Integrable (fun x : Euclidean d =>
      norm (integral volume fun y => F (x, y))) mu :=
    hF.integral_prod_left.norm
  change (integral mu fun x => norm (integral volume fun y => b y * K (x - y))) <= _
  calc
    (integral mu fun x => norm (integral volume fun y => b y * K (x - y))) =
        integral mu (fun x => norm (integral volume fun y => F (x, y))) := by rfl
    _ <= integral mu (fun x => integral volume (fun y => norm ((F - G) (x, y)))) := by
      apply integral_mono_ae hleft hright
      filter_upwards [hcancel] with x hxc
      exact (congrArg norm hxc).trans_le (norm_integral_le_integral_norm _)
    _ = integral volume (fun y => integral mu (fun x => norm ((F - G) (x, y)))) := by
      exact integral_integral_swap hdiff.norm
    _ = integral volume (fun y => norm (b y) *
        integral mu (fun x => norm (K (x - y) - K (x - c)))) := by
      apply integral_congr_ae
      filter_upwards with y
      change (integral mu fun x => norm (b y * K (x - y) - b y * K (x - c))) = _
      calc
        (integral mu fun x => norm (b y * K (x - y) - b y * K (x - c))) =
            integral mu (fun x => norm (b y) * norm (K (x - y) - K (x - c))) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [<- mul_sub, norm_mul]
        _ = _ := integral_const_mul (norm (b y) : Real)
          (fun x => norm (K (x - y) - K (x - c)))

theorem restricted_mean_zero_kernel_convolution_le_of_local_hormander
    {d : Nat} (K : Euclidean d -> Complex) (hK : Integrable K volume)
    {B : Real} (b : Euclidean d -> Complex) (hb : Integrable b volume)
    (hzero : (integral volume b) = 0) (c : Euclidean d)
    (E : Set (Euclidean d))
    (htrans : ∀ y : Euclidean d, b y ≠ 0 →
      integral (volume.restrict E)
        (fun x => norm (K (x - y) - K (x - c))) <= B) :
    integral (volume.restrict E)
      (fun x => norm (integral volume (fun y => b y * K (x - y)))) <=
      B * integral volume (fun y => norm (b y)) := by
  have hfirst := restricted_mean_zero_kernel_convolution K hK b hb hzero c E
  have hR0 : Integrable (fun y : Euclidean d => norm (b y) *
      integral (volume.restrict E)
        (fun x => norm (K (x - y) - K (x - c)))) volume := by
    -- This is exactly the final Fubini fibre from the preceding proof.
    let mu : Measure (Euclidean d) := volume.restrict E
    let F : Euclidean d × Euclidean d → Complex := fun p =>
      b p.2 * K (p.1 - p.2)
    let G : Euclidean d × Euclidean d → Complex := fun p =>
      b p.2 * K (p.1 - c)
    have hF0 : Integrable F (volume.prod volume) := by
      simpa only [F, ContinuousLinearMap.mul_apply'] using
        hb.convolution_integrand (ContinuousLinearMap.mul Complex Complex) hK
    have hKshift : Integrable (fun x : Euclidean d => K (x - c)) volume :=
      hK.comp_sub_right c
    have hGmeas0 : AEStronglyMeasurable G (volume.prod volume) := by
      exact hb.aestronglyMeasurable.comp_snd.mul
        hKshift.aestronglyMeasurable.comp_fst
    have hG0 : Integrable G (volume.prod volume) := by
      apply (integrable_prod_iff hGmeas0).mpr
      constructor
      · filter_upwards with x
        exact hb.mul_const (K (x - c))
      · have houter : Integrable (fun x : Euclidean d =>
            (integral volume fun y => norm (b y)) * norm (K (x - c))) volume :=
          hKshift.norm.const_mul _
        convert houter using 1
        funext x
        change (integral volume fun y => norm (b y * K (x - c))) = _
        calc
          (integral volume fun y => norm (b y * K (x - c))) =
              integral volume (fun y => norm (b y) * norm (K (x - c))) := by
                apply integral_congr_ae
                filter_upwards with y
                rw [norm_mul]
          _ = _ := integral_mul_const (norm (K (x - c)) : Real)
            (fun y : Euclidean d => norm (b y))
    have hF : Integrable F (mu.prod volume) := by
      exact hF0.mono_measure (Measure.prod_mono Measure.restrict_le_self le_rfl)
    have hG : Integrable G (mu.prod volume) := by
      exact hG0.mono_measure (Measure.prod_mono Measure.restrict_le_self le_rfl)
    have hdiff : Integrable (F - G) (mu.prod volume) := hF.sub hG
    have hR0' : Integrable (fun y : Euclidean d =>
        integral mu (fun x => norm ((F - G) (x, y)))) volume :=
      hdiff.norm.integral_prod_right
    convert hR0' using 1
    funext y
    symm
    change (integral mu fun x => norm (b y * K (x - y) - b y * K (x - c))) = _
    calc
      (integral mu fun x => norm (b y * K (x - y) - b y * K (x - c))) =
          integral mu (fun x => norm (b y) * norm (K (x - y) - K (x - c))) := by
            apply integral_congr_ae
            filter_upwards with x
            rw [<- mul_sub, norm_mul]
      _ = _ := integral_const_mul (norm (b y) : Real)
        (fun x => norm (K (x - y) - K (x - c)))
  have hBint : Integrable (fun y : Euclidean d => norm (b y) * B) volume := by
    simpa [mul_comm] using hb.norm.const_mul B
  have hRle : (fun y : Euclidean d => norm (b y) *
      integral (volume.restrict E)
        (fun x => norm (K (x - y) - K (x - c)))) <=
      fun y => norm (b y) * B := by
    intro y
    by_cases hy : b y = 0
    · simp [hy]
    · exact mul_le_mul_of_nonneg_left (htrans y hy) (norm_nonneg _)
  calc
    integral (volume.restrict E)
      (fun x => norm (integral volume (fun y => b y * K (x - y)))) <=
        integral volume (fun y => norm (b y) *
          integral (volume.restrict E)
            (fun x => norm (K (x - y) - K (x - c)))) := hfirst
    _ <= integral volume (fun y => norm (b y) * B) :=
      integral_mono hR0 hBint hRle
    _ = B * integral volume (fun y => norm (b y)) := by
      rw [integral_mul_const]
      ring
/-- Reindex the low physical frequencies below the cube scale by natural offsets. -/
def signedDyadicLowOffsets (S : Finset Int) (q : Int) : Finset Nat :=
  (S.filter fun k => k <= -q).image fun k => (-q - k).toNat

/-- Reindex the high physical frequencies above the cube scale by natural offsets. -/
def signedDyadicHighOffsets (S : Finset Int) (q : Int) : Finset Nat :=
  (S.filter fun k => -q < k).image fun k => (k + q).toNat

noncomputable def exactDyadicRadius (k : Int) : PositiveRadius :=
  ⟨(2 : Real) ^ k, zpow_pos (by norm_num : (0 : Real) < 2) k⟩

theorem exactDyadicRadius_selector : IsDyadicLacunaryRadiusSelector exactDyadicRadius := by
  intro k
  dsimp [exactDyadicRadius]
  constructor
  · exact le_rfl
  · have hpow : 0 <= (2 : Real) ^ k := zpow_nonneg (by norm_num) _
    nlinarith

theorem integerDyadicPhysicalFrequency_eq_zpow (k : Int) :
    integerDyadicPhysicalFrequency k = (2 : Real) ^ k := by
  unfold integerDyadicPhysicalFrequency integerDyadicFrequencyScale
  simp

theorem sum_signedDyadicLowOffsets_eq {alpha : Type*} [AddCommMonoid alpha]
    (S : Finset Int) (q : Int) (F : Int -> alpha) :
    (Finset.sum (signedDyadicLowOffsets S q) fun n => F (-q - (n : Int))) =
      Finset.sum (S.filter fun k => k <= -q) F := by
  classical
  let T : Finset Int := S.filter fun k => k <= -q
  let e : Int -> Nat := fun k => (-q - k).toNat
  have he : Set.InjOn e (T : Set Int) := by
    intro k hk l hl hkl
    have hkq : k <= -q := (Finset.mem_filter.mp hk).2
    have hlq : l <= -q := (Finset.mem_filter.mp hl).2
    dsimp only [e] at hkl
    have hcast : ((-q - k).toNat : Int) = ((-q - l).toNat : Int) :=
      congrArg (fun n : Nat => (n : Int)) hkl
    have hkto : ((-q - k).toNat : Int) = -q - k := by
      rw [Int.toNat_of_nonneg (sub_nonneg.mpr hkq)]
    have hlto : ((-q - l).toNat : Int) = -q - l := by
      rw [Int.toNat_of_nonneg (sub_nonneg.mpr hlq)]
    rw [hkto, hlto] at hcast
    omega
  change (Finset.sum (T.image e) fun n => F (-q - (n : Int))) = Finset.sum T F
  rw [Finset.sum_image he]
  apply Finset.sum_congr rfl
  intro k hk
  have hkq : k <= -q := (Finset.mem_filter.mp hk).2
  rw [Int.toNat_sub_of_le hkq]
  ring

theorem sum_signedDyadicHighOffsets_eq {alpha : Type*} [AddCommMonoid alpha]
    (S : Finset Int) (q : Int) (F : Int -> alpha) :
    (Finset.sum (signedDyadicHighOffsets S q) fun n => F (-q + (n : Int))) =
      Finset.sum (S.filter fun k => -q < k) F := by
  classical
  let T : Finset Int := S.filter fun k => -q < k
  let e : Int -> Nat := fun k => (k + q).toNat
  have he : Set.InjOn e (T : Set Int) := by
    intro k hk l hl hkl
    have hkq : -q < k := (Finset.mem_filter.mp hk).2
    have hlq : -q < l := (Finset.mem_filter.mp hl).2
    dsimp only [e] at hkl
    have hcast : ((k + q).toNat : Int) = ((l + q).toNat : Int) :=
      congrArg (fun n : Nat => (n : Int)) hkl
    have hkto : ((k + q).toNat : Int) = k + q := by
      rw [Int.toNat_of_nonneg (by omega)]
    have hlto : ((l + q).toNat : Int) = l + q := by
      rw [Int.toNat_of_nonneg (by omega)]
    rw [hkto, hlto] at hcast
    omega
  change (Finset.sum (T.image e) fun n => F (-q + (n : Int))) = Finset.sum T F
  rw [Finset.sum_image he]
  apply Finset.sum_congr rfl
  intro k hk
  have hkq : -q < k := (Finset.mem_filter.mp hk).2
  rw [Int.toNat_of_nonneg (by omega)]
  ring

theorem sum_low_physicalFrequency_le (S : Finset Int) (q : Int) :
    Finset.sum (S.filter fun k => k <= -q) integerDyadicPhysicalFrequency <=
      2 * (2 : Real) ^ (-q) := by
  classical
  have htail := dyadic_lacunary_selector_finset_tail_le
    exactDyadicRadius exactDyadicRadius_selector 0 q (signedDyadicLowOffsets S q)
  have hleft :
      Finset.sum (signedDyadicLowOffsets S q)
          (fun n => integerDyadicPhysicalFrequency (-q - (n : Int))) =
      Finset.sum (signedDyadicLowOffsets S q)
          (fun n => 1 / ((2 : Real) ^ (0 : Int) *
            (exactDyadicRadius (q + (n : Int)) : Real))) := by
    apply Finset.sum_congr rfl
    intro n hn
    rw [integerDyadicPhysicalFrequency_eq_zpow]
    dsimp [exactDyadicRadius]
    have he : -q - (n : Int) = -(q + (n : Int)) := by ring
    rw [he, zpow_neg]
    field_simp
  calc
    Finset.sum (S.filter fun k => k <= -q) integerDyadicPhysicalFrequency =
        Finset.sum (signedDyadicLowOffsets S q)
          (fun n => integerDyadicPhysicalFrequency (-q - (n : Int))) :=
      (sum_signedDyadicLowOffsets_eq S q integerDyadicPhysicalFrequency).symm
    _ = Finset.sum (signedDyadicLowOffsets S q)
          (fun n => 1 / ((2 : Real) ^ (0 : Int) *
            (exactDyadicRadius (q + (n : Int)) : Real))) := hleft
    _ <= 2 * (2 : Real) ^ (0 : Int) * ((2 : Real) ^ q)⁻¹ := by
      simpa [one_div] using htail
    _ = 2 * (2 : Real) ^ (-q) := by
      rw [zpow_neg]
      ring

theorem sum_high_physicalFrequency_inv_sq_le (S : Finset Int) (q : Int) :
    Finset.sum (S.filter fun k => -q < k)
      (fun k => (1 / integerDyadicPhysicalFrequency k) ^ 2) <=
      (16 / 3 : Real) * ((2 : Real) ^ q) ^ 2 := by
  classical
  have htail := dyadic_lacunary_selector_finset_past_sq_le
    exactDyadicRadius exactDyadicRadius_selector q (signedDyadicHighOffsets S q)
  have hleft :
      Finset.sum (signedDyadicHighOffsets S q)
          (fun n => (1 / integerDyadicPhysicalFrequency (-q + (n : Int))) ^ 2) =
      Finset.sum (signedDyadicHighOffsets S q)
          (fun n => (exactDyadicRadius (q - (n : Int)) : Real) ^ 2) := by
    apply Finset.sum_congr rfl
    intro n hn
    rw [integerDyadicPhysicalFrequency_eq_zpow]
    dsimp [exactDyadicRadius]
    have he : -q + (n : Int) = -(q - (n : Int)) := by ring
    rw [he, zpow_neg]
    field_simp
  calc
    Finset.sum (S.filter fun k => -q < k)
        (fun k => (1 / integerDyadicPhysicalFrequency k) ^ 2) =
        Finset.sum (signedDyadicHighOffsets S q)
          (fun n => (1 / integerDyadicPhysicalFrequency (-q + (n : Int))) ^ 2) :=
      (sum_signedDyadicHighOffsets_eq S q
        (fun k => (1 / integerDyadicPhysicalFrequency k) ^ 2)).symm
    _ = Finset.sum (signedDyadicHighOffsets S q)
          (fun n => (exactDyadicRadius (q - (n : Int)) : Real) ^ 2) := hleft
    _ <= (16 / 3 : Real) * ((2 : Real) ^ q) ^ 2 := htail

/-- A pointwise exterior kernel majorant can be integrated through an
integrable atom without requiring a global convolution bound. -/
theorem setIntegral_norm_kernel_convolution_le_of_pointwise_tail
    {d : Nat} (K : Euclidean d -> Complex) (hK : Integrable K volume)
    (b : Euclidean d -> Complex) (hb : Integrable b volume)
    (E : Set (Euclidean d)) (hE : MeasurableSet E) (T : Euclidean d -> Real)
    (hT : IntegrableOn T E volume)
    (hpoint : forall x, x ∈ E -> forall y, b y ≠ 0 ->
      norm (K (x - y)) <= T x) :
    integral (volume.restrict E)
      (fun x => norm (integral volume (fun y => b y * K (x - y)))) <=
      (integral (volume.restrict E) T) * integral volume (fun y => norm (b y)) := by
  let L : Real := integral volume (fun y => norm (b y))
  have hL : 0 <= L := by
    dsimp [L]
    exact integral_nonneg fun _ => norm_nonneg _
  have hout : Integrable (fun x : Euclidean d =>
      norm (integral volume (fun y => b y * K (x - y))) ) volume := by
    exact Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
      K hK b hb
  have hmaj : IntegrableOn (fun x : Euclidean d => T x * L) E volume := by
    change Integrable (fun x : Euclidean d => T x * L) (volume.restrict E)
    exact (hT.const_mul L).congr (Filter.Eventually.of_forall fun x => by ring)
  have hpointout (x : Euclidean d) (hx : x ∈ E) :
      norm (integral volume (fun y => b y * K (x - y))) <= T x * L := by
    have hprodBound (y : Euclidean d) :
        norm (b y * K (x - y)) <= T x * norm (b y) := by
      by_cases hy : b y = 0
      · simp [hy]
      · rw [norm_mul]
        simpa [mul_comm] using
          (mul_le_mul_of_nonneg_left (hpoint x hx y hy) (norm_nonneg (b y)))
    have hprodInt : Integrable (fun y : Euclidean d => b y * K (x - y)) volume := by
      apply (hb.norm.const_mul (T x)).mono'
      · exact hb.aestronglyMeasurable.mul
          (hK.comp_sub_left x).aestronglyMeasurable
      · filter_upwards with y
        exact hprodBound y
    calc
      norm (integral volume (fun y => b y * K (x - y))) <=
          integral volume (fun y => norm (b y * K (x - y))) :=
        norm_integral_le_integral_norm _
      _ <= integral volume (fun y => T x * norm (b y)) :=
        integral_mono hprodInt.norm (hb.norm.const_mul (T x)) hprodBound
      _ = T x * L := by
        dsimp [L]
        rw [integral_const_mul]
  calc
    integral (volume.restrict E)
      (fun x => norm (integral volume (fun y => b y * K (x - y)))) <=
        integral (volume.restrict E) (fun x => T x * L) := by
      apply integral_mono_ae hout.integrableOn hmaj
      filter_upwards [ae_restrict_mem hE] with x hx
      exact hpointout x hx
    _ = (integral (volume.restrict E) T) * L := by
      rw [integral_mul_const]
    _ = (integral (volume.restrict E) T) *
        integral volume (fun y => norm (b y)) := by rfl

theorem norm_sub_ge_third
    {d : Nat} {c x y : Euclidean d} {rho : Real}
    (hrho : 0 <= rho) (hx : 3 * rho < norm (x - c))
    (hy : norm (y - c) <= rho) :
    norm (x - c) / 3 <= norm (x - y) := by
  have htri : norm (x - c) <= norm (x - y) + norm (y - c) := by
    calc
      norm (x - c) = norm ((x - y) + (y - c)) := by congr 1 <;> abel
      _ <= norm (x - y) + norm (y - c) := norm_add_le _ _
  nlinarith

theorem integerDyadicBandpassPrototype_tail_seminorm_nonneg
    {d : Nat} (chi : SchwartzMap (Euclidean d) Complex) :
    0 <= SchwartzMap.seminorm Complex (d + 2) 0
      (fourierInv (integerDyadicBandpassPrototype chi)) := by
  calc
    0 <= norm (0 : Euclidean d) ^ (d + 2) *
        norm ((fourierInv (integerDyadicBandpassPrototype chi) :
          SchwartzMap (Euclidean d) Complex) 0) := by positivity
    _ <= SchwartzMap.seminorm Complex (d + 2) 0
        (fourierInv (integerDyadicBandpassPrototype chi)) :=
      SchwartzMap.norm_pow_mul_le_seminorm Complex
        (fourierInv (integerDyadicBandpassPrototype chi) :
          SchwartzMap (Euclidean d) Complex) (d + 2) 0

theorem one_scale_exterior_tail
    {d : Nat} (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    {c x y : Euclidean d} {rho A : Real}
    (hA : A = SchwartzMap.seminorm Complex (d + 2) 0
      (fourierInv (integerDyadicBandpassPrototype chi)))
    (hAnonneg : 0 <= A) (hrho : 0 <= rho)
    (hx : 3 * rho < norm (x - c))
    (hy : norm (y - c) <= rho) :
    norm (integerDyadicBandpassKernel chi k (x - y)) <=
      (integerDyadicPhysicalFrequency k ^ d * A) /
        (integerDyadicPhysicalFrequency k * (norm (x - c) / 3)) ^ (d + 2) := by
  let s : Real := integerDyadicPhysicalFrequency k
  have hs : 0 < s := by
    dsimp [s]
    unfold integerDyadicPhysicalFrequency
    exact inv_pos.mpr (integerDyadicFrequencyScale k).2
  have hgeo : norm (x - c) / 3 <= norm (x - y) :=
    norm_sub_ge_third hrho hx hy
  have hrad : 0 < norm (x - c) / 3 := by
    have : 0 < norm (x - c) := by nlinarith
    positivity
  have hxy : x - y ≠ 0 := by
    intro hzero
    rw [hzero, norm_zero] at hgeo
    linarith
  have hpow :
      (s * (norm (x - c) / 3)) ^ (d + 2) <=
        (s * norm (x - y)) ^ (d + 2) := by
    gcongr
  have hnum : 0 <= s ^ d * A :=
    mul_nonneg (pow_nonneg hs.le _) hAnonneg
  have hden : 0 < (s * (norm (x - c) / 3)) ^ (d + 2) :=
    pow_pos (mul_pos hs hrad) _
  have htail := norm_integerDyadicBandpassKernel_le_physicalFrequency_tail chi k hxy
  rw [<- hA] at htail
  change norm (integerDyadicBandpassKernel chi k (x - y)) <=
    (s ^ d * A) / (s * norm (x - y)) ^ (d + 2) at htail
  calc
    norm (integerDyadicBandpassKernel chi k (x - y)) <=
        (s ^ d * A) / (s * norm (x - y)) ^ (d + 2) := htail
    _ <= (s ^ d * A) / (s * (norm (x - c) / 3)) ^ (d + 2) :=
      div_le_div_of_nonneg_left hnum hden hpow

theorem physical_tail_algebra (d : Nat) {s R A : Real}
    (hs : 0 < s) (hR : 0 < R) :
    (s ^ d * A) / (s * R) ^ (d + 2) =
      (A * (1 / s) ^ 2) / R ^ (d + 2) := by
  rw [mul_pow]
  field_simp [hs.ne', hR.ne']
  ring

theorem finiteSignedIntegerDyadicBandpassKernel_split_at
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (q : Int) (x : Euclidean d) :
    finiteSignedIntegerDyadicBandpassKernel C K a x =
      finiteSignedIntegerDyadicBandpassKernel C
        (K.filter fun k => k <= -q) a x +
      finiteSignedIntegerDyadicBandpassKernel C
        (K.filter fun k => -q < k) a x := by
  classical
  unfold finiteSignedIntegerDyadicBandpassKernel
  rw [<- Finset.sum_filter_add_sum_filter_not
    (p := fun k : Int => k <= -q)]
  simp only [not_le]

theorem low_signedDyadic_translation_bound
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1) (q : Int) (h : Euclidean d) :
    integral volume (fun x : Euclidean d =>
      norm (finiteSignedIntegerDyadicBandpassKernel C
        (K.filter fun k => k <= -q) a (x + h) -
        finiteSignedIntegerDyadicBandpassKernel C
          (K.filter fun k => k <= -q) a x)) <=
      norm h *
        relativeSchwartzMultiplierKernelHormanderSize
          (integerDyadicBandpassPrototype C.cutoff) *
        Finset.sum (K.filter fun k => k <= -q) integerDyadicPhysicalFrequency := by
  classical
  let L : Finset Int := K.filter fun k => k <= -q
  let H : Real := relativeSchwartzMultiplierKernelHormanderSize
    (integerDyadicBandpassPrototype C.cutoff)
  calc
    integral volume (fun x : Euclidean d =>
        norm (finiteSignedIntegerDyadicBandpassKernel C L a (x + h) -
          finiteSignedIntegerDyadicBandpassKernel C L a x)) <=
        Finset.sum L (fun k => norm (a k) *
          integral volume (fun x : Euclidean d =>
            norm (integerDyadicBandpassKernel C.cutoff k (x + h) -
              integerDyadicBandpassKernel C.cutoff k x))) := by
      exact integral_norm_finiteSignedIntegerDyadicBandpassKernel_sub_translate_le_sum
        C L a h
    _ <= Finset.sum L (fun k => norm h * integerDyadicPhysicalFrequency k * H) := by
      apply Finset.sum_le_sum
      intro k hk
      calc
        norm (a k) *
            integral volume (fun x : Euclidean d =>
              norm (integerDyadicBandpassKernel C.cutoff k (x + h) -
                integerDyadicBandpassKernel C.cutoff k x)) <=
            1 * integral volume (fun x : Euclidean d =>
              norm (integerDyadicBandpassKernel C.cutoff k (x + h) -
                integerDyadicBandpassKernel C.cutoff k x)) :=
          mul_le_mul_of_nonneg_right
            (ha k (Finset.mem_filter.mp hk).1)
            (integral_nonneg fun _ => norm_nonneg _)
        _ = integral volume (fun x : Euclidean d =>
              norm (integerDyadicBandpassKernel C.cutoff k (x + h) -
                integerDyadicBandpassKernel C.cutoff k x)) := one_mul _
        _ <= norm h * integerDyadicPhysicalFrequency k * H := by
          simpa only [integerDyadicPhysicalFrequency, H] using
            integral_norm_integerDyadicBandpassKernel_sub_translate_le C.cutoff k h
    _ = norm h * H * Finset.sum L integerDyadicPhysicalFrequency := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      ring

theorem integral_norm_kernel_sub_shift_eq
    {d : Nat} (K : Euclidean d -> Complex) (y c : Euclidean d) :
    integral volume (fun x : Euclidean d => norm (K (x - y) - K (x - c))) =
      integral volume (fun x : Euclidean d =>
        norm (K (x + (c - y)) - K x)) := by
  let F : Euclidean d -> Real := fun z => norm (K (z + (c - y)) - K z)
  have hEq : (fun x : Euclidean d => norm (K (x - y) - K (x - c))) =
      fun x => F (x - c) := by
    funext x
    dsimp [F]
    congr 2 <;> abel
  rw [hEq, integral_sub_right_eq_self]

theorem low_signedDyadic_atom_tail_le
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1)
    (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d -> Complex)
    (hb : Integrable b volume) (hzero : integral volume b = 0)
    (hsupp : ∀ y, b y ≠ 0 ->
      norm (y - lacunaryCZDyadicCubeCenter q) <= lacunaryCZDyadicCubeRadius q)
    (E : Set (Euclidean d)) :
    integral (volume.restrict E) (fun x =>
      norm (integral volume (fun y => b y *
        finiteSignedIntegerDyadicBandpassKernel C
          (K.filter fun k => k <= -q.scale) a (x - y)))) <=
      (2 * (d : Real) *
        relativeSchwartzMultiplierKernelHormanderSize
          (integerDyadicBandpassPrototype C.cutoff)) *
        integral volume (fun y => norm (b y)) := by
  let L : Finset Int := K.filter fun k => k <= -q.scale
  let KL : Euclidean d -> Complex :=
    finiteSignedIntegerDyadicBandpassKernel C L a
  let H : Real := relativeSchwartzMultiplierKernelHormanderSize
    (integerDyadicBandpassPrototype C.cutoff)
  let rho : Real := lacunaryCZDyadicCubeRadius q
  have hKL : Integrable KL volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C L a
  have hH : 0 <= H :=
    relativeSchwartzMultiplierKernelHormanderSize_nonneg _
  have hrho : 0 <= rho := (lacunaryCZDyadicCubeRadius_pos q).le
  have hsum_nonneg : 0 <= Finset.sum L integerDyadicPhysicalFrequency :=
    Finset.sum_nonneg fun k hk => by
      unfold integerDyadicPhysicalFrequency
      exact inv_nonneg.mpr (integerDyadicFrequencyScale k).2.le
  have hsum : Finset.sum L integerDyadicPhysicalFrequency <=
      2 * (2 : Real) ^ (-q.scale) := by
    simpa only [L] using sum_low_physicalFrequency_le K q.scale
  have hconst : rho * H * (2 * (2 : Real) ^ (-q.scale)) = 2 * (d : Real) * H := by
    dsimp [rho]
    unfold lacunaryCZDyadicCubeRadius
    have hd0 : (d : Real) ≠ 0 := by exact_mod_cast NeZero.ne d
    have hq0 : (2 : Real) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
    rw [zpow_neg]
    field_simp [hq0]
  apply restricted_mean_zero_kernel_convolution_le_of_local_hormander
    KL hKL b hb hzero (lacunaryCZDyadicCubeCenter q) E
  intro y hy
  have hdiff : Integrable (fun x : Euclidean d =>
      norm (KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q))) volume :=
    ((hKL.comp_sub_right y).sub
      (hKL.comp_sub_right (lacunaryCZDyadicCubeCenter q))).norm
  have hrestrict : integral (volume.restrict E) (fun x : Euclidean d =>
      norm (KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q))) <=
      integral volume (fun x : Euclidean d =>
        norm (KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q))) := by
    exact integral_mono_measure Measure.restrict_le_self
      (Filter.Eventually.of_forall fun x => norm_nonneg _) hdiff
  have hyc : norm (lacunaryCZDyadicCubeCenter q - y) <= rho := by
    rw [show lacunaryCZDyadicCubeCenter q - y =
      -(y - lacunaryCZDyadicCubeCenter q) by abel, norm_neg]
    exact hsupp y hy
  have htrans := low_signedDyadic_translation_bound C K a ha q.scale
    (lacunaryCZDyadicCubeCenter q - y)
  have hmul1 : norm (lacunaryCZDyadicCubeCenter q - y) * H *
      Finset.sum L integerDyadicPhysicalFrequency <=
      rho * H * Finset.sum L integerDyadicPhysicalFrequency := by
    apply mul_le_mul_of_nonneg_right _ hsum_nonneg
    simpa [mul_comm] using mul_le_mul_of_nonneg_left hyc hH
  have hmul2 : rho * H * Finset.sum L integerDyadicPhysicalFrequency <=
      rho * H * (2 * (2 : Real) ^ (-q.scale)) := by
    exact mul_le_mul_of_nonneg_left hsum (mul_nonneg hrho hH)
  calc
    integral (volume.restrict E) (fun x : Euclidean d =>
        norm (KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q))) <=
        integral volume (fun x : Euclidean d =>
          norm (KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q))) := hrestrict
    _ = integral volume (fun x : Euclidean d =>
        norm (KL (x + (lacunaryCZDyadicCubeCenter q - y)) - KL x)) :=
      integral_norm_kernel_sub_shift_eq KL y (lacunaryCZDyadicCubeCenter q)
    _ <= norm (lacunaryCZDyadicCubeCenter q - y) * H *
        Finset.sum L integerDyadicPhysicalFrequency := by
      simpa only [L, KL, H] using htrans
    _ <= rho * H * Finset.sum L integerDyadicPhysicalFrequency := hmul1
    _ <= rho * H * (2 * (2 : Real) ^ (-q.scale)) := hmul2
    _ = 2 * (d : Real) * H := hconst

theorem high_signedDyadic_kernel_exterior_tail
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1) (q : Int)
    {c x y : Euclidean d} {rho : Real}
    (hrho : 0 <= rho) (hx : 3 * rho < norm (x - c))
    (hy : norm (y - c) <= rho) :
    norm (finiteSignedIntegerDyadicBandpassKernel C
      (K.filter fun k => -q < k) a (x - y)) <=
      (SchwartzMap.seminorm Complex (d + 2) 0
        (fourierInv (integerDyadicBandpassPrototype C.cutoff)) *
        ((16 / 3 : Real) * ((2 : Real) ^ q) ^ 2)) /
        (norm (x - c) / 3) ^ (d + 2) := by
  classical
  let J : Finset Int := K.filter fun k => -q < k
  let A : Real := SchwartzMap.seminorm Complex (d + 2) 0
    (fourierInv (integerDyadicBandpassPrototype C.cutoff))
  let R : Real := norm (x - c) / 3
  have hA : 0 <= A := integerDyadicBandpassPrototype_tail_seminorm_nonneg C.cutoff
  have hR : 0 < R := by
    dsimp [R]
    have hxc : 0 < norm (x - c) := by nlinarith
    positivity
  have hRpow : 0 <= R ^ (d + 2) := pow_nonneg hR.le _
  have hcoeff : 0 <= A / R ^ (d + 2) := div_nonneg hA hRpow
  have hsum : Finset.sum J (fun k =>
      (1 / integerDyadicPhysicalFrequency k) ^ 2) <=
      (16 / 3 : Real) * ((2 : Real) ^ q) ^ 2 := by
    simpa only [J] using sum_high_physicalFrequency_inv_sq_le K q
  have hterm (k : Int) (hk : k ∈ J) :
      norm (a k * integerDyadicBandpassKernel C.cutoff k (x - y)) <=
        A * (1 / integerDyadicPhysicalFrequency k) ^ 2 / R ^ (d + 2) := by
    have hs : 0 < integerDyadicPhysicalFrequency k := by
      unfold integerDyadicPhysicalFrequency
      exact inv_pos.mpr (integerDyadicFrequencyScale k).2
    have htail := one_scale_exterior_tail C.cutoff k (A := A) rfl hA hrho hx hy
    calc
      norm (a k * integerDyadicBandpassKernel C.cutoff k (x - y)) <=
          1 * norm (integerDyadicBandpassKernel C.cutoff k (x - y)) := by
        rw [norm_mul]
        exact mul_le_mul_of_nonneg_right
          (ha k (Finset.mem_filter.mp hk).1) (norm_nonneg _)
      _ = norm (integerDyadicBandpassKernel C.cutoff k (x - y)) := one_mul _
      _ <= (integerDyadicPhysicalFrequency k ^ d * A) /
          (integerDyadicPhysicalFrequency k * R) ^ (d + 2) := by
        simpa only [R] using htail
      _ = A * (1 / integerDyadicPhysicalFrequency k) ^ 2 / R ^ (d + 2) :=
        physical_tail_algebra d hs hR
  calc
    norm (finiteSignedIntegerDyadicBandpassKernel C J a (x - y)) <=
        Finset.sum J (fun k =>
          norm (a k * integerDyadicBandpassKernel C.cutoff k (x - y))) := by
      unfold finiteSignedIntegerDyadicBandpassKernel
      exact norm_sum_le J _
    _ <= Finset.sum J (fun k =>
        A * (1 / integerDyadicPhysicalFrequency k) ^ 2 / R ^ (d + 2)) := by
      exact Finset.sum_le_sum hterm
    _ = (A / R ^ (d + 2)) * Finset.sum J (fun k =>
        (1 / integerDyadicPhysicalFrequency k) ^ 2) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    _ <= (A / R ^ (d + 2)) *
        ((16 / 3 : Real) * ((2 : Real) ^ q) ^ 2) :=
      mul_le_mul_of_nonneg_left hsum hcoeff
    _ = (A * ((16 / 3 : Real) * ((2 : Real) ^ q) ^ 2)) /
        R ^ (d + 2) := by ring

noncomputable def finiteSignedIntegerDyadicHighTailConstant {d : Nat}
    (C : lpCutoffs d) : Real :=
  SchwartzMap.seminorm Complex (d + 2) 0
      (fourierInv (integerDyadicBandpassPrototype C.cutoff)) *
    (16 / 3 : Real) * surfaceMass d * (3 : Real) ^ d /
      (2 * (d : Real) ^ 2)

theorem high_signedDyadic_atom_tail_le
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1)
    (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d -> Complex)
    (hb : Integrable b volume)
    (hsupp : ∀ y, b y ≠ 0 ->
      norm (y - lacunaryCZDyadicCubeCenter q) <= lacunaryCZDyadicCubeRadius q) :
    integral (volume.restrict
      ((Metric.closedBall (lacunaryCZDyadicCubeCenter q)
        (3 * lacunaryCZDyadicCubeRadius q))ᶜ))
      (fun x => norm (integral volume (fun y => b y *
        finiteSignedIntegerDyadicBandpassKernel C
          (K.filter fun k => -q.scale < k) a (x - y)))) <=
      finiteSignedIntegerDyadicHighTailConstant C *
        integral volume (fun y => norm (b y)) := by
  let c : Euclidean d := lacunaryCZDyadicCubeCenter q
  let rho : Real := lacunaryCZDyadicCubeRadius q
  let E : Set (Euclidean d) := (Metric.closedBall c (3 * rho))ᶜ
  let A : Real := SchwartzMap.seminorm Complex (d + 2) 0
    (fourierInv (integerDyadicBandpassPrototype C.cutoff))
  let gamma : Real := (16 / 3 : Real) * ((2 : Real) ^ q.scale) ^ 2
  let C0 : Real := A * gamma
  let T : Euclidean d -> Real := fun x =>
    C0 / (norm (x - c) / 3) ^ (d + 2)
  have hdpos : 0 < d := Nat.pos_of_ne_zero (NeZero.ne d)
  have hrho : 0 < rho := lacunaryCZDyadicCubeRadius_pos q
  have hE : MeasurableSet E := Metric.isClosed_closedBall.measurableSet.compl
  have hT : IntegrableOn T E volume := by
    dsimp only [T, E]
    change Integrable (fun x : Euclidean d =>
      C0 / (norm (x - c) / 3) ^ (d + 2))
      (volume.restrict (Metric.closedBall c (3 * rho))ᶜ)
    refine (integrableOn_lacunary_exterior_kernel_tail hdpos hrho c).const_mul C0 |>.congr ?_
    filter_upwards with x
    rw [div_eq_mul_inv]
    ring
  have hK : Integrable
      (finiteSignedIntegerDyadicBandpassKernel C
        (K.filter fun k => -q.scale < k) a) volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C
      (K.filter fun k => -q.scale < k) a
  have hpoint : ∀ x, x ∈ E -> ∀ y, b y ≠ 0 ->
      norm (finiteSignedIntegerDyadicBandpassKernel C
        (K.filter fun k => -q.scale < k) a (x - y)) <= T x := by
    intro x hx y hy
    have hx' : 3 * rho < norm (x - c) := by
      rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_eq_norm_sub] at hx
      exact lt_of_not_ge hx
    have hy' : norm (y - c) <= rho := by
      simpa only [c, rho] using hsupp y hy
    have htail := high_signedDyadic_kernel_exterior_tail C K a ha q.scale
      hrho.le hx' hy'
    simpa only [T, C0, gamma, A, c, rho] using htail
  have htail := setIntegral_norm_kernel_convolution_le_of_pointwise_tail
    (finiteSignedIntegerDyadicBandpassKernel C
      (K.filter fun k => -q.scale < k) a) hK b hb E hE T hT hpoint
  have hTint : integral (volume.restrict E) T =
      C0 * (surfaceMass d * (3 : Real) ^ d / (2 * rho ^ 2)) := by
    dsimp only [T, E]
    have hEq : (fun x : Euclidean d =>
        C0 / (norm (x - c) / 3) ^ (d + 2)) =
        fun x => C0 * (1 / (norm (x - c) / 3) ^ (d + 2)) := by
      funext x
      simp only [div_eq_mul_inv, one_mul]
    rw [hEq]
    rw [integral_const_mul]
    rw [integral_lacunary_exterior_kernel_tail hdpos hrho c]
  have hconst : C0 * (surfaceMass d * (3 : Real) ^ d / (2 * rho ^ 2)) =
      finiteSignedIntegerDyadicHighTailConstant C := by
    dsimp [C0, gamma, A, rho, finiteSignedIntegerDyadicHighTailConstant]
    unfold lacunaryCZDyadicCubeRadius
    have hd0 : (d : Real) ≠ 0 := by exact_mod_cast NeZero.ne d
    have hq0 : (2 : Real) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
    field_simp [hd0, hq0]
  calc
    integral (volume.restrict
      ((Metric.closedBall (lacunaryCZDyadicCubeCenter q)
        (3 * lacunaryCZDyadicCubeRadius q))ᶜ))
      (fun x => norm (integral volume (fun y => b y *
        finiteSignedIntegerDyadicBandpassKernel C
          (K.filter fun k => -q.scale < k) a (x - y)))) <=
        (integral (volume.restrict E) T) *
          integral volume (fun y => norm (b y)) := by
      simpa only [E, c, rho] using htail
    _ = (C0 * (surfaceMass d * (3 : Real) ^ d / (2 * rho ^ 2))) *
          integral volume (fun y => norm (b y)) := by rw [hTint]
    _ = finiteSignedIntegerDyadicHighTailConstant C *
          integral volume (fun y => norm (b y)) := by rw [hconst]

theorem setIntegral_norm_kernel_convolution_le_add_of_kernel_eq
    {d : Nat} (K K1 K2 : Euclidean d -> Complex)
    (hKeq : ∀ z, K z = K1 z + K2 z)
    (hK : Integrable K volume) (hK1 : Integrable K1 volume)
    (hK2 : Integrable K2 volume)
    (b : Euclidean d -> Complex) (hb : Integrable b volume)
    (E : Set (Euclidean d)) :
    integral (volume.restrict E) (fun x =>
      norm (integral volume (fun y => b y * K (x - y)))) <=
      integral (volume.restrict E) (fun x =>
        norm (integral volume (fun y => b y * K1 (x - y)))) +
      integral (volume.restrict E) (fun x =>
        norm (integral volume (fun y => b y * K2 (x - y)))) := by
  let F1 : Euclidean d × Euclidean d -> Complex := fun p =>
    b p.2 * K1 (p.1 - p.2)
  let F2 : Euclidean d × Euclidean d -> Complex := fun p =>
    b p.2 * K2 (p.1 - p.2)
  have hF1 : Integrable F1 (volume.prod volume) := by
    simpa only [F1, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul Complex Complex) hK1
  have hF2 : Integrable F2 (volume.prod volume) := by
    simpa only [F2, ContinuousLinearMap.mul_apply'] using
      hb.convolution_integrand (ContinuousLinearMap.mul Complex Complex) hK2
  have hFib1 : ∀ᵐ x : Euclidean d ∂volume,
      Integrable (fun y : Euclidean d => F1 (x, y)) volume :=
    (integrable_prod_iff hF1.aestronglyMeasurable).mp hF1 |>.1
  have hFib2 : ∀ᵐ x : Euclidean d ∂volume,
      Integrable (fun y : Euclidean d => F2 (x, y)) volume :=
    (integrable_prod_iff hF2.aestronglyMeasurable).mp hF2 |>.1
  have hsplit : ∀ᵐ x : Euclidean d ∂volume,
      integral volume (fun y => b y * K (x - y)) =
        integral volume (fun y => b y * K1 (x - y)) +
          integral volume (fun y => b y * K2 (x - y)) := by
    filter_upwards [hFib1, hFib2] with x hx1 hx2
    have hfun : (fun y : Euclidean d => b y * K (x - y)) =
        fun y => b y * K1 (x - y) + b y * K2 (x - y) := by
      funext y
      rw [hKeq]
      ring
    rw [hfun, integral_add hx1 hx2]
  have hOut : Integrable (fun x : Euclidean d =>
      norm (integral volume (fun y => b y * K (x - y)))) volume :=
    Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
      K hK b hb
  have hOut1 : Integrable (fun x : Euclidean d =>
      norm (integral volume (fun y => b y * K1 (x - y)))) volume :=
    Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
      K1 hK1 b hb
  have hOut2 : Integrable (fun x : Euclidean d =>
      norm (integral volume (fun y => b y * K2 (x - y)))) volume :=
    Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
      K2 hK2 b hb
  have hAE : ∀ᵐ x : Euclidean d ∂(volume.restrict E),
      norm (integral volume (fun y => b y * K (x - y))) <=
        norm (integral volume (fun y => b y * K1 (x - y))) +
          norm (integral volume (fun y => b y * K2 (x - y))) := by
    filter_upwards [hsplit.filter_mono (ae_mono Measure.restrict_le_self)] with x hx
    rw [hx]
    exact norm_add_le _ _
  calc
    integral (volume.restrict E) (fun x =>
        norm (integral volume (fun y => b y * K (x - y)))) <=
        integral (volume.restrict E) (fun x =>
          norm (integral volume (fun y => b y * K1 (x - y))) +
            norm (integral volume (fun y => b y * K2 (x - y)))) :=
      integral_mono_ae hOut.integrableOn (hOut1.add hOut2).integrableOn hAE
    _ = integral (volume.restrict E) (fun x =>
          norm (integral volume (fun y => b y * K1 (x - y)))) +
        integral (volume.restrict E) (fun x =>
          norm (integral volume (fun y => b y * K2 (x - y)))) :=
      integral_add hOut1.integrableOn hOut2.integrableOn

noncomputable def finiteSignedIntegerDyadicBandpassCZTailConstant {d : Nat}
    (C : lpCutoffs d) : Real :=
  2 * (d : Real) *
      relativeSchwartzMultiplierKernelHormanderSize
        (integerDyadicBandpassPrototype C.cutoff) +
    finiteSignedIntegerDyadicHighTailConstant C

theorem finiteSignedIntegerDyadicBandpassKernel_atom_tail_le
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1)
    (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d -> Complex)
    (hb : Integrable b volume) (hzero : integral volume b = 0)
    (hsupp : ∀ y, b y ≠ 0 ->
      norm (y - lacunaryCZDyadicCubeCenter q) <= lacunaryCZDyadicCubeRadius q) :
    integral (volume.restrict
      ((Metric.closedBall (lacunaryCZDyadicCubeCenter q)
        (3 * lacunaryCZDyadicCubeRadius q))ᶜ))
      (fun x => norm (integral volume (fun y => b y *
        finiteSignedIntegerDyadicBandpassKernel C K a (x - y)))) <=
      finiteSignedIntegerDyadicBandpassCZTailConstant C *
        integral volume (fun y => norm (b y)) := by
  let E : Set (Euclidean d) :=
    (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ
  let Klow : Euclidean d -> Complex := finiteSignedIntegerDyadicBandpassKernel C
    (K.filter fun k => k <= -q.scale) a
  let Khigh : Euclidean d -> Complex := finiteSignedIntegerDyadicBandpassKernel C
    (K.filter fun k => -q.scale < k) a
  let Kall : Euclidean d -> Complex := finiteSignedIntegerDyadicBandpassKernel C K a
  have hKall : Integrable Kall volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C K a
  have hKlow : Integrable Klow volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C
      (K.filter fun k => k <= -q.scale) a
  have hKhigh : Integrable Khigh volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C
      (K.filter fun k => -q.scale < k) a
  have hKeq : ∀ z, Kall z = Klow z + Khigh z := by
    intro z
    simpa only [Kall, Klow, Khigh] using
      finiteSignedIntegerDyadicBandpassKernel_split_at C K a q.scale z
  have hsplit := setIntegral_norm_kernel_convolution_le_add_of_kernel_eq
    Kall Klow Khigh hKeq hKall hKlow hKhigh b hb E
  have hlow := low_signedDyadic_atom_tail_le C K a ha q b hb hzero hsupp E
  have hhigh := high_signedDyadic_atom_tail_le C K a ha q b hb hsupp
  calc
    integral (volume.restrict
      ((Metric.closedBall (lacunaryCZDyadicCubeCenter q)
        (3 * lacunaryCZDyadicCubeRadius q))ᶜ))
      (fun x => norm (integral volume (fun y => b y *
        finiteSignedIntegerDyadicBandpassKernel C K a (x - y)))) <=
        integral (volume.restrict E) (fun x => norm (integral volume (fun y => b y * Klow (x - y)))) +
          integral (volume.restrict E) (fun x => norm (integral volume (fun y => b y * Khigh (x - y)))) := by
      simpa only [E, Kall] using hsplit
    _ <=
        (2 * (d : Real) *
          relativeSchwartzMultiplierKernelHormanderSize
            (integerDyadicBandpassPrototype C.cutoff)) *
          integral volume (fun y => norm (b y)) +
        finiteSignedIntegerDyadicHighTailConstant C *
          integral volume (fun y => norm (b y)) := by
      apply add_le_add
      · simpa only [Klow] using hlow
      · simpa only [E, Khigh] using hhigh
    _ = finiteSignedIntegerDyadicBandpassCZTailConstant C *
        integral volume (fun y => norm (b y)) := by
      unfold finiteSignedIntegerDyadicBandpassCZTailConstant
      ring

theorem finiteSignedIntegerDyadicBandpassKernel_hasFiniteConvolutionKernelCZTail
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int -> Complex)
    (ha : ∀ k ∈ K, norm (a k) <= 1) :
    HasFiniteConvolutionKernelCZTail
      (finiteSignedIntegerDyadicBandpassKernel C K a)
      (finiteSignedIntegerDyadicBandpassCZTailConstant C) := by
  intro f U hAtom hzero hsupp
  have hK : Integrable (finiteSignedIntegerDyadicBandpassKernel C K a) volume :=
    integrable_finiteSignedIntegerDyadicBandpassKernel C K a
  have hqInt : ∀ q ∈ U, Integrable (fun x : Euclidean d =>
      norm (finiteConvolutionKernelOperator
        (finiteSignedIntegerDyadicBandpassKernel C K a)
        (lacunaryCZDyadicCubeBadAtom f q) x)) volume := by
    intro q hq
    simpa only [finiteConvolutionKernelOperator] using
      Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
        (finiteSignedIntegerDyadicBandpassKernel C K a) hK
        (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq)
  have hqBound : ∀ q ∈ U,
      integral (volume.restrict (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ)
        (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
          (finiteSignedIntegerDyadicBandpassKernel C K a)
          (lacunaryCZDyadicCubeBadAtom f q) x)) <=
        finiteSignedIntegerDyadicBandpassCZTailConstant C *
          integral volume (fun y : Euclidean d =>
            norm (lacunaryCZDyadicCubeBadAtom f q y)) := by
    intro q hq
    have hsubset : (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ ⊆
        (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
          (3 * lacunaryCZDyadicCubeRadius q))ᶜ := by
      intro x hx hball
      apply hx
      exact Set.mem_iUnion₂.mpr ⟨q, hq, hball⟩
    have hmono : integral (volume.restrict (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ)
        (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
          (finiteSignedIntegerDyadicBandpassKernel C K a)
          (lacunaryCZDyadicCubeBadAtom f q) x)) <=
        integral (volume.restrict (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
          (3 * lacunaryCZDyadicCubeRadius q))ᶜ)
        (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
          (finiteSignedIntegerDyadicBandpassKernel C K a)
          (lacunaryCZDyadicCubeBadAtom f q) x)) := by
      exact integral_mono_measure (Measure.restrict_mono hsubset le_rfl)
        (Filter.Eventually.of_forall fun x => norm_nonneg _)
        ((hqInt q hq).mono_measure Measure.restrict_le_self)
    calc
      integral (volume.restrict (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ)
          (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
            (finiteSignedIntegerDyadicBandpassKernel C K a)
            (lacunaryCZDyadicCubeBadAtom f q) x)) <=
          integral (volume.restrict (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
            (3 * lacunaryCZDyadicCubeRadius q))ᶜ)
          (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
            (finiteSignedIntegerDyadicBandpassKernel C K a)
            (lacunaryCZDyadicCubeBadAtom f q) x)) := hmono
      _ <= finiteSignedIntegerDyadicBandpassCZTailConstant C *
          integral volume (fun y : Euclidean d =>
            norm (lacunaryCZDyadicCubeBadAtom f q y)) := by
        simpa only [finiteConvolutionKernelOperator] using
          finiteSignedIntegerDyadicBandpassKernel_atom_tail_le C K a ha q
            (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq) (hzero q hq)
            (hsupp q hq)
  have hTailInt : Integrable
      (finiteConvolutionKernelBadTail
        (finiteSignedIntegerDyadicBandpassKernel C K a) f U) volume := by
    unfold finiteConvolutionKernelBadTail
    exact integrable_finsetSum U hqInt
  refine ⟨hTailInt, ?_⟩
  unfold finiteConvolutionKernelBadTail
  rw [integral_finsetSum U fun q hq => (hqInt q hq).integrableOn]
  calc
    (∑ q ∈ U, integral (volume.restrict (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ)
      (fun x : Euclidean d => norm (finiteConvolutionKernelOperator
        (finiteSignedIntegerDyadicBandpassKernel C K a)
        (lacunaryCZDyadicCubeBadAtom f q) x))) <=
        ∑ q ∈ U, finiteSignedIntegerDyadicBandpassCZTailConstant C *
          integral volume (fun y : Euclidean d =>
            norm (lacunaryCZDyadicCubeBadAtom f q y)) := by
      exact Finset.sum_le_sum fun q hq => hqBound q hq
   _ = finiteSignedIntegerDyadicBandpassCZTailConstant C *
       ∑ q ∈ U, integral volume (fun y : Euclidean d =>
         norm (lacunaryCZDyadicCubeBadAtom f q y)) := by
     rw [Finset.mul_sum]
/-! ### Raw finite Mikhlin kernels and uniform Calderón--Zygmund tails

The dyadic profiles in this package vary with the scale.  The estimates
below retain the full raw symbol and sum the low and high scales directly;
the high tail uses the dimension-generic summability exponent `N - d`.
-/

def rawFiniteIntDyadicMikhlinKernel {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (K : Finset Int) : Euclidean d → Complex := fun x =>
  ∑ k ∈ K, fourierInv
    (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x

theorem integrable_fourierInv_intDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (k : Int) :
    Integrable (fourierInv
      (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)) volume := by
  exact compact_cN_fourierInv_integrable
    (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)
    (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm).1
    (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm).2 hNd

theorem integrable_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (K : Finset Int) :
    Integrable (rawFiniteIntDyadicMikhlinKernel C m K) volume := by
  classical
  unfold rawFiniteIntDyadicMikhlinKernel
  apply integrable_finsetSum K
  intro k _
  exact integrable_fourierInv_intDyadicMikhlinPiece C m hm hNd k

theorem norm_rawFiniteIntDyadicMikhlinKernel_sub_translate_le_sum
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (h x : Euclidean d) :
    ‖rawFiniteIntDyadicMikhlinKernel C m K (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m K x‖ ≤
      ∑ k ∈ K, ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ := by
  classical
  unfold rawFiniteIntDyadicMikhlinKernel
  calc
    ‖(∑ k ∈ K, fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h)) -
        ∑ k ∈ K, fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ =
        ‖∑ k ∈ K, (fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x)‖ := by
      congr 1
      rw [← Finset.sum_sub_distrib]
    _ ≤ ∑ k ∈ K, ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ :=
      norm_sum_le K _

theorem integrable_rawFiniteIntDyadicMikhlinKernel_sub_translate
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (K : Finset Int)
    (h : Euclidean d) :
    Integrable (fun x : Euclidean d =>
      rawFiniteIntDyadicMikhlinKernel C m K (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m K x) volume := by
  exact (integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd K).comp_add_right h |>.sub
    (integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd K)

theorem integrable_rawFiniteIntDyadicMikhlinKernel_translation_majorant
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (K : Finset Int)
    (h : Euclidean d) :
    Integrable (fun x : Euclidean d =>
      ∑ k ∈ K, ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖) volume := by
  classical
  apply integrable_finsetSum K
  intro k _
  exact ((integrable_fourierInv_intDyadicMikhlinPiece C m hm hNd k).comp_add_right h |>.sub
    (integrable_fourierInv_intDyadicMikhlinPiece C m hm hNd k)).norm

theorem integral_norm_rawFiniteIntDyadicMikhlinKernel_sub_translate_le_sum
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hNd : d < N) (K : Finset Int)
    (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖rawFiniteIntDyadicMikhlinKernel C m K (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m K x‖) ≤
      ∑ k ∈ K, ∫ x : Euclidean d, ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ := by
  classical
  have hsingle (k : Int) (hk : k ∈ K) :
      Integrable (fun x : Euclidean d => ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖) volume :=
    ((integrable_fourierInv_intDyadicMikhlinPiece C m hm hNd k).comp_add_right h |>.sub
      (integrable_fourierInv_intDyadicMikhlinPiece C m hm hNd k)).norm
  calc
    (∫ x : Euclidean d,
      ‖rawFiniteIntDyadicMikhlinKernel C m K (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m K x‖) ≤
        ∫ x : Euclidean d, ∑ k ∈ K, ‖fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
            fourierInv
              (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ :=
      integral_mono
        (integrable_rawFiniteIntDyadicMikhlinKernel_sub_translate C m hm hNd K h).norm
        (integrable_rawFiniteIntDyadicMikhlinKernel_translation_majorant C m hm hNd K h)
        (norm_rawFiniteIntDyadicMikhlinKernel_sub_translate_le_sum C m K h)
    _ = ∑ k ∈ K, ∫ x : Euclidean d, ‖fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
          fourierInv
            (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ := by
      rw [integral_finsetSum K hsingle]

theorem low_rawFiniteIntDyadicMikhlinKernel_translation_bound
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) (q : Int) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => k ≤ -q) (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => k ≤ -q) x‖) ≤
      ‖h‖ * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A *
        ∑ k ∈ K.filter fun k => k ≤ -q, integerDyadicPhysicalFrequency k := by
  classical
  let L : Finset Int := K.filter fun k => k ≤ -q
  calc
    (∫ x : Euclidean d,
      ‖rawFiniteIntDyadicMikhlinKernel C m L (x + h) -
        rawFiniteIntDyadicMikhlinKernel C m L x‖) ≤
        ∑ k ∈ L, ∫ x : Euclidean d, ‖fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x + h) -
            fourierInv
              (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ :=
      integral_norm_rawFiniteIntDyadicMikhlinKernel_sub_translate_le_sum
        C m hm hNd L h
    _ ≤ ∑ k ∈ L, ‖h‖ * integerDyadicPhysicalFrequency k *
        normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
      apply Finset.sum_le_sum
      intro k _
      simpa only [integerDyadicPhysicalFrequency] using
        integral_norm_sub_translate_fourierInv_intDyadicMikhlinPiece_le
          C m hm hA hNd k h
    _ = ‖h‖ * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A *
        ∑ k ∈ L, integerDyadicPhysicalFrequency k := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k _
      ring

theorem rawFiniteIntDyadicMikhlinKernel_split_at
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (q : Int) (x : Euclidean d) :
    rawFiniteIntDyadicMikhlinKernel C m K x =
      rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => k ≤ -q) x +
      rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => -q < k) x := by
  classical
  unfold rawFiniteIntDyadicMikhlinKernel
  rw [← Finset.sum_filter_add_sum_filter_not
    (p := fun k : Int => k ≤ -q)]
  simp only [not_le]

theorem normalizedMikhlinKernelDerivativeL1Bound_nonneg
    {d N : Nat} (C : lpCutoffs d) {A : Real} (hA : 0 ≤ A) :
    0 ≤ normalizedMikhlinKernelDerivativeL1Bound (N := N) C A := by
  unfold normalizedMikhlinKernelDerivativeL1Bound
    normalizedMikhlinKernelDerivativeFrequencyL1Bound
    normalizedMikhlinKernelDerivativeIBPBound
    schwartzWeightedCutoffDerivativeConstant
  positivity

theorem low_rawFiniteIntDyadicMikhlinKernel_atom_tail_le
    {d N : Nat} [NeZero d] (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d → Complex)
    (hb : Integrable b volume) (hzero : ∫ y : Euclidean d, b y = 0)
    (hsupp : ∀ y, b y ≠ 0 →
      ‖y - lacunaryCZDyadicCubeCenter q‖ ≤ lacunaryCZDyadicCubeRadius q)
    (E : Set (Euclidean d)) :
    (∫ x in E,
      ‖∫ y : Euclidean d, b y *
        rawFiniteIntDyadicMikhlinKernel C m
          (K.filter fun k => k ≤ -q.scale) (x - y)‖) ≤
      (2 * (d : Real) * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A) *
        ∫ y : Euclidean d, ‖b y‖ := by
  let L : Finset Int := K.filter fun k => k ≤ -q.scale
  let KL : Euclidean d → Complex := rawFiniteIntDyadicMikhlinKernel C m L
  let H : Real := normalizedMikhlinKernelDerivativeL1Bound (N := N) C A
  let rho : Real := lacunaryCZDyadicCubeRadius q
  have hKL : Integrable KL volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd L
  have hH : 0 ≤ H := normalizedMikhlinKernelDerivativeL1Bound_nonneg C hA
  have hrho : 0 ≤ rho := (lacunaryCZDyadicCubeRadius_pos q).le
  have hsum_nonneg : 0 ≤ ∑ k ∈ L, integerDyadicPhysicalFrequency k :=
    Finset.sum_nonneg fun k hk => by
      unfold integerDyadicPhysicalFrequency
      exact inv_nonneg.mpr (integerDyadicFrequencyScale k).2.le
  have hsum : ∑ k ∈ L, integerDyadicPhysicalFrequency k ≤
      2 * (2 : Real) ^ (-q.scale) := by
    simpa only [L] using sum_low_physicalFrequency_le K q.scale
  have hconst : rho * H * (2 * (2 : Real) ^ (-q.scale)) = 2 * (d : Real) * H := by
    dsimp [rho]
    unfold lacunaryCZDyadicCubeRadius
    have hd0 : (d : Real) ≠ 0 := by exact_mod_cast NeZero.ne d
    have hq0 : (2 : Real) ^ q.scale ≠ 0 := zpow_ne_zero _ (by norm_num)
    rw [zpow_neg]
    field_simp [hq0, hd0]
  apply restricted_mean_zero_kernel_convolution_le_of_local_hormander
    KL hKL b hb hzero (lacunaryCZDyadicCubeCenter q) E
  intro y hy
  have hdiff : Integrable (fun x : Euclidean d =>
      ‖KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q)‖) volume :=
    ((hKL.comp_sub_right y).sub
      (hKL.comp_sub_right (lacunaryCZDyadicCubeCenter q))).norm
  have hrestrict : (∫ x in E,
      ‖KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q)‖) ≤
      ∫ x : Euclidean d,
        ‖KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q)‖ := by
    exact integral_mono_measure Measure.restrict_le_self
      (Filter.Eventually.of_forall fun x => norm_nonneg _) hdiff
  have hyc : ‖lacunaryCZDyadicCubeCenter q - y‖ ≤ rho := by
    rw [show lacunaryCZDyadicCubeCenter q - y =
      -(y - lacunaryCZDyadicCubeCenter q) by abel, norm_neg]
    exact hsupp y hy
  have htrans := low_rawFiniteIntDyadicMikhlinKernel_translation_bound C m hm hA hNd K
    q.scale (lacunaryCZDyadicCubeCenter q - y)
  have hmul1 : ‖lacunaryCZDyadicCubeCenter q - y‖ * H *
      ∑ k ∈ L, integerDyadicPhysicalFrequency k ≤
      rho * H * ∑ k ∈ L, integerDyadicPhysicalFrequency k := by
    apply mul_le_mul_of_nonneg_right _ hsum_nonneg
    simpa [mul_comm] using mul_le_mul_of_nonneg_left hyc hH
  have hmul2 : rho * H * ∑ k ∈ L, integerDyadicPhysicalFrequency k ≤
      rho * H * (2 * (2 : Real) ^ (-q.scale)) := by
    exact mul_le_mul_of_nonneg_left hsum (mul_nonneg hrho hH)
  calc
    (∫ x in E,
      ‖KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q)‖) ≤
        ∫ x : Euclidean d,
          ‖KL (x - y) - KL (x - lacunaryCZDyadicCubeCenter q)‖ := hrestrict
    _ = ∫ x : Euclidean d,
        ‖KL (x + (lacunaryCZDyadicCubeCenter q - y)) - KL x‖ :=
      integral_norm_kernel_sub_shift_eq KL y (lacunaryCZDyadicCubeCenter q)
    _ ≤ ‖lacunaryCZDyadicCubeCenter q - y‖ * H *
        ∑ k ∈ L, integerDyadicPhysicalFrequency k := by
      simpa only [L, KL, H] using htrans
    _ ≤ rho * H * ∑ k ∈ L, integerDyadicPhysicalFrequency k := hmul1
    _ ≤ rho * H * (2 * (2 : Real) ^ (-q.scale)) := hmul2
    _ = 2 * (d : Real) * H := hconst
theorem raw_physical_tail_algebra (d N : Nat) (hdN : d ≤ N) {s R A : Real}
    (hs : 0 < s) (hR : 0 < R) :
    (s ^ d * A) / (s * R) ^ N =
      (A * (1 / s) ^ (N - d)) / R ^ N := by
  have hN : N = d + (N - d) := (Nat.add_sub_of_le hdN).symm
  have hsdivide : s ^ d / s ^ N = (1 / s) ^ (N - d) := by
    rw [hN, pow_add, one_div, inv_pow]
    field_simp [hs.ne']
    simp
  calc
    (s ^ d * A) / (s * R) ^ N = A * (s ^ d / s ^ N) / R ^ N := by
      rw [mul_pow]
      field_simp [hs.ne', hR.ne']
    _ = (A * (1 / s) ^ (N - d)) / R ^ N := by rw [hsdivide]

theorem high_dyadic_inverse_power_term
    (q : Int) (n ell : Nat) :
    (1 / integerDyadicPhysicalFrequency (-q + (n : Int))) ^ ell =
      ((2 : Real) ^ q) ^ ell * (((1 : Real) / 2) ^ ell) ^ n := by
  rw [integerDyadicPhysicalFrequency_eq_zpow]
  have hindex : -q + (n : Int) = -(q - (n : Int)) := by ring
  rw [hindex, zpow_neg]
  simp only [div_eq_mul_inv, one_mul, inv_inv]
  rw [zpow_sub₀ (by norm_num : (2 : Real) ≠ 0)]
  rw [zpow_natCast]
  rw [div_pow, ← pow_mul, Nat.mul_comm]
  field_simp
  rw [← pow_mul]
  rw [Nat.mul_comm ell n]
  rw [← mul_pow]
  norm_num

theorem sum_high_physicalFrequency_inv_pow_le
    (S : Finset Int) (q : Int) {ell : Nat} (hell : 1 ≤ ell) :
    ∑ k ∈ S.filter (fun k => -q < k),
      (1 / integerDyadicPhysicalFrequency k) ^ ell ≤
      2 * ((2 : Real) ^ q) ^ ell := by
  classical
  have hgeo : ∑ n ∈ signedDyadicHighOffsets S q,
      (((1 : Real) / 2) ^ ell) ^ n ≤ 2 := by
    calc
      ∑ n ∈ signedDyadicHighOffsets S q,
          (((1 : Real) / 2) ^ ell) ^ n ≤
          ∑ n ∈ signedDyadicHighOffsets S q, ((1 : Real) / 2) ^ n := by
        apply Finset.sum_le_sum
        intro n _
        have hbase : (0 : Real) ≤ (1 / 2 : Real) := by norm_num
        have hpow : ((1 : Real) / 2) ^ ell ≤ (1 : Real) / 2 := by
          calc
            ((1 : Real) / 2) ^ ell ≤ ((1 : Real) / 2) ^ 1 :=
              pow_le_pow_of_le_one hbase (by norm_num) hell
            _ = (1 : Real) / 2 := by ring
        exact pow_le_pow_left₀ (pow_nonneg hbase _) hpow n
      _ ≤ ∑' n : Nat, ((1 : Real) / 2) ^ n :=
        summable_geometric_two.sum_le_tsum _ (fun n _ => pow_nonneg (by norm_num) n)
      _ = 2 := tsum_geometric_two
  calc
    ∑ k ∈ S.filter (fun k => -q < k),
        (1 / integerDyadicPhysicalFrequency k) ^ ell =
        ∑ n ∈ signedDyadicHighOffsets S q,
          (1 / integerDyadicPhysicalFrequency (-q + (n : Int))) ^ ell :=
      (sum_signedDyadicHighOffsets_eq S q
        (fun k => (1 / integerDyadicPhysicalFrequency k) ^ ell)).symm
    _ = ∑ n ∈ signedDyadicHighOffsets S q,
        ((2 : Real) ^ q) ^ ell * (((1 : Real) / 2) ^ ell) ^ n := by
      apply Finset.sum_congr rfl
      intro n _
      exact high_dyadic_inverse_power_term q n ell
    _ = ((2 : Real) ^ q) ^ ell *
        ∑ n ∈ signedDyadicHighOffsets S q,
          (((1 : Real) / 2) ^ ell) ^ n := by
      rw [Finset.mul_sum]
    _ ≤ ((2 : Real) ^ q) ^ ell * 2 := by
      apply mul_le_mul_of_nonneg_left hgeo
      positivity
    _ = 2 * ((2 : Real) ^ q) ^ ell := by ring

theorem normalizedMikhlinKernelIBPBound_nonneg
    {d N : Nat} (C : lpCutoffs d) {A : Real} (hA : 0 ≤ A) :
    0 ≤ normalizedMikhlinKernelIBPBound (N := N) C A := by
  unfold normalizedMikhlinKernelIBPBound schwartzWeightedCutoffDerivativeConstant
  positivity

theorem high_rawFiniteIntDyadicMikhlinKernel_exterior_tail
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) (q : Int) {c x y : Euclidean d} {rho : Real}
    (hrho : 0 ≤ rho) (hx : 3 * rho < ‖x - c‖)
    (hy : ‖y - c‖ ≤ rho) :
    ‖rawFiniteIntDyadicMikhlinKernel C m
      (K.filter fun k => -q < k) (x - y)‖ ≤
      (normalizedMikhlinKernelIBPBound (N := N) C A *
        (2 * ((2 : Real) ^ q) ^ (N - d))) /
        (‖x - c‖ / 3) ^ N := by
  classical
  let J : Finset Int := K.filter fun k => -q < k
  let Q : Real := normalizedMikhlinKernelIBPBound (N := N) C A
  let R : Real := ‖x - c‖ / 3
  let ell : Nat := N - d
  have hdN : d ≤ N := Nat.le_of_lt hNd
  have hell : 1 ≤ ell := by
    dsimp [ell]
    omega
  have hQ : 0 ≤ Q := normalizedMikhlinKernelIBPBound_nonneg C hA
  have hR : 0 < R := by
    dsimp [R]
    have hxc : 0 < ‖x - c‖ := by linarith
    positivity
  have hRpow : 0 ≤ R ^ N := pow_nonneg hR.le _
  have hcoeff : 0 ≤ Q / R ^ N := div_nonneg hQ hRpow
  have hsum : ∑ k ∈ J, (1 / integerDyadicPhysicalFrequency k) ^ ell ≤
      2 * ((2 : Real) ^ q) ^ ell := by
    simpa only [J] using sum_high_physicalFrequency_inv_pow_le K q hell
  have hterm (k : Int) (hk : k ∈ J) :
      ‖fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)
          (x - y)‖ ≤ Q * (1 / integerDyadicPhysicalFrequency k) ^ ell / R ^ N := by
    have hs : 0 < integerDyadicPhysicalFrequency k := by
      unfold integerDyadicPhysicalFrequency
      exact inv_pos.mpr (integerDyadicFrequencyScale k).2
    have hgeo : ‖x - c‖ / 3 ≤ ‖x - y‖ := norm_sub_ge_third hrho hx hy
    have hxy : x - y ≠ 0 := by
      intro hzero
      rw [hzero, norm_zero] at hgeo
      have : 0 < ‖x - c‖ / 3 := hR
      linarith
    have hpow : (integerDyadicPhysicalFrequency k * R) ^ N ≤
        (integerDyadicPhysicalFrequency k * ‖x - y‖) ^ N := by
      gcongr
    have hnum : 0 ≤ integerDyadicPhysicalFrequency k ^ d * Q :=
      mul_nonneg (pow_nonneg hs.le _) hQ
    have hden : 0 < (integerDyadicPhysicalFrequency k * R) ^ N :=
      pow_pos (mul_pos hs hR) _
    have htail := norm_fourierInv_intDyadicMikhlinPiece_le_tail C m hm hA k hxy
    calc
      ‖fourierInv (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi)
          (x - y)‖ ≤
          (integerDyadicPhysicalFrequency k ^ d * Q) /
            (integerDyadicPhysicalFrequency k * ‖x - y‖) ^ N := by
        simpa only [integerDyadicPhysicalFrequency] using htail
      _ ≤ (integerDyadicPhysicalFrequency k ^ d * Q) /
          (integerDyadicPhysicalFrequency k * R) ^ N :=
        div_le_div_of_nonneg_left hnum hden hpow
      _ = Q * (1 / integerDyadicPhysicalFrequency k) ^ ell / R ^ N := by
        dsimp [ell]
        exact raw_physical_tail_algebra d N hdN hs hR
  calc
    ‖rawFiniteIntDyadicMikhlinKernel C m J (x - y)‖ ≤
        ∑ k ∈ J, ‖fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) (x - y)‖ := by
      unfold rawFiniteIntDyadicMikhlinKernel
      exact norm_sum_le J _
    _ ≤ ∑ k ∈ J, Q * (1 / integerDyadicPhysicalFrequency k) ^ ell / R ^ N := by
      exact Finset.sum_le_sum hterm
    _ = (Q / R ^ N) * ∑ k ∈ J,
        (1 / integerDyadicPhysicalFrequency k) ^ ell := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro k hk
      ring
    _ ≤ (Q / R ^ N) * (2 * ((2 : Real) ^ q) ^ ell) :=
      mul_le_mul_of_nonneg_left hsum hcoeff
    _ = (Q * (2 * ((2 : Real) ^ q) ^ ell)) / R ^ N := by ring
    _ = (normalizedMikhlinKernelIBPBound (N := N) C A *
        (2 * ((2 : Real) ^ q) ^ (N - d))) / (‖x - c‖ / 3) ^ N := by
      rfl
noncomputable def rawExteriorPowerTail {d : Nat} (N : Nat) :
    Euclidean d → Real :=
  (Metric.closedBall 0 3)ᶜ.indicator (fun x => 1 / (‖x‖ / 3) ^ N)

theorem rawExteriorPowerTail_nonneg {d N : Nat} (x : Euclidean d) :
    0 ≤ rawExteriorPowerTail (d := d) N x := by
  unfold rawExteriorPowerTail
  by_cases hx : x ∈ (Metric.closedBall (0 : Euclidean d) 3)ᶜ
  · rw [Set.indicator_of_mem hx]
    exact div_nonneg (by norm_num)
      (pow_nonneg (div_nonneg (norm_nonneg x) (by norm_num)) _)
  · simp [Set.indicator_of_notMem hx]

theorem measurable_rawExteriorPowerTail {d N : Nat} :
    Measurable (rawExteriorPowerTail (d := d) N) := by
  unfold rawExteriorPowerTail
  apply Measurable.indicator
  · exact measurable_const.div
      ((continuous_norm.measurable.div measurable_const).pow_const N)
  · exact Metric.isClosed_closedBall.measurableSet.compl

theorem integrable_rawExteriorPowerTail {d N : Nat} (hNd : d < N) :
    Integrable (rawExteriorPowerTail (d := d) N) volume := by
  refine integrable_of_uniform_and_power_decay hNd
    measurable_rawExteriorPowerTail.aestronglyMeasurable (A := (3 : Real) ^ N)
    (B := 1) ?_ ?_
  · intro x
    rw [Real.norm_eq_abs, abs_of_nonneg (rawExteriorPowerTail_nonneg (N := N) x)]
    unfold rawExteriorPowerTail
    by_cases hx : x ∈ (Metric.closedBall (0 : Euclidean d) 3)ᶜ
    · rw [Set.indicator_of_mem hx]
      have hthree : 3 < ‖x‖ := by
        rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_zero_right] at hx
        exact lt_of_not_ge hx
      have hden : 1 ≤ (‖x‖ / 3) ^ N := one_le_pow₀ (by nlinarith)
      calc
        1 / (‖x‖ / 3) ^ N ≤ 1 / 1 :=
          one_div_le_one_div_of_le (by norm_num) hden
        _ = 1 := by norm_num
    · simp [Set.indicator_of_notMem hx]
  · intro x
    rw [Real.norm_eq_abs, abs_of_nonneg (rawExteriorPowerTail_nonneg (N := N) x)]
    unfold rawExteriorPowerTail
    by_cases hx : x ∈ (Metric.closedBall (0 : Euclidean d) 3)ᶜ
    · rw [Set.indicator_of_mem hx]
      have hx0 : ‖x‖ ≠ 0 := by
        have hthree : 3 < ‖x‖ := by
          rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_zero_right] at hx
          exact lt_of_not_ge hx
        positivity
      rw [div_pow]
      field_simp [hx0]
      norm_num
    · simp [Set.indicator_of_notMem hx]

noncomputable def rawExteriorPowerTailAt {d : Nat} (N : Nat)
    (rho : Real) (c : Euclidean d) : Euclidean d → Real :=
  (Metric.closedBall c (3 * rho))ᶜ.indicator
    (fun x => 1 / (‖x - c‖ / 3) ^ N)

theorem rawExteriorPowerTailAt_eq_scaled
    {d N : Nat} {rho : Real} (hrho : 0 < rho) (c x : Euclidean d) :
    rawExteriorPowerTailAt N rho c x =
      rho⁻¹ ^ N * rawExteriorPowerTail N (rho⁻¹ • (x - c)) := by
  let A0 : Set (Euclidean d) := (Metric.closedBall 0 3)ᶜ
  let Ac : Set (Euclidean d) := (Metric.closedBall c (3 * rho))ᶜ
  have hmem : x ∈ Ac ↔ rho⁻¹ • (x - c) ∈ A0 := by
    rw [Set.mem_compl_iff, Set.mem_compl_iff,
      Metric.mem_closedBall, Metric.mem_closedBall, dist_eq_norm_sub, dist_zero_right]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrho)]
    constructor
    · intro h
      rw [not_le] at h ⊢
      calc
        3 = rho⁻¹ * (3 * rho) := by field_simp [hrho.ne']
        _ < rho⁻¹ * ‖x - c‖ := mul_lt_mul_of_pos_left h (inv_pos.mpr hrho)
    · intro h
      rw [not_le] at h ⊢
      calc
        3 * rho = rho * 3 := by ring
        _ < rho * (rho⁻¹ * ‖x - c‖) := mul_lt_mul_of_pos_left h hrho
        _ = ‖x - c‖ := by field_simp [hrho.ne']
  unfold rawExteriorPowerTailAt rawExteriorPowerTail
  change Ac.indicator (fun z : Euclidean d => 1 / (‖z - c‖ / 3) ^ N) x =
    rho⁻¹ ^ N * A0.indicator (fun z : Euclidean d => 1 / (‖z‖ / 3) ^ N)
      (rho⁻¹ • (x - c))
  by_cases hx : x ∈ Ac
  · rw [Set.indicator_of_mem hx, Set.indicator_of_mem (hmem.mp hx)]
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrho)]
    have hnorm : ‖x - c‖ ≠ 0 := by
      have hthree : 3 * rho < ‖x - c‖ := by
        rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_eq_norm_sub] at hx
        exact lt_of_not_ge hx
      intro hzero
      rw [hzero] at hthree
      have hpos : 0 < 3 * rho := mul_pos (by norm_num) hrho
      linarith
    rw [show rho⁻¹ * ‖x - c‖ / 3 = rho⁻¹ * (‖x - c‖ / 3) by ring]
    rw [mul_pow]
    have hden : (‖x - c‖ / 3) ^ N ≠ 0 :=
      pow_ne_zero N (div_ne_zero hnorm (by norm_num))
    have hinv : rho⁻¹ ^ N ≠ 0 := pow_ne_zero N (inv_ne_zero hrho.ne')
    simp only [div_eq_mul_inv, one_mul, mul_inv_rev]
    let t : Real := (‖x - c‖ * 3⁻¹) ^ N
    have ht : t ≠ 0 := by simpa [t, div_eq_mul_inv] using hden
    change t⁻¹ = rho⁻¹ ^ N * (t⁻¹ * (rho⁻¹ ^ N)⁻¹)
    rw [mul_comm t⁻¹, ← mul_assoc, mul_inv_cancel₀ hinv, one_mul]
  · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem (by
      intro h
      exact hx (hmem.mpr h))]
    ring

theorem integrable_rawExteriorPowerTailAt
    {d N : Nat} (hNd : d < N) {rho : Real} (hrho : 0 < rho)
    (c : Euclidean d) :
    Integrable (rawExteriorPowerTailAt (d := d) N rho c) volume := by
  have hbase := integrable_rawExteriorPowerTail (d := d) (N := N) hNd
  have hscale : Integrable (fun x : Euclidean d =>
      rawExteriorPowerTail N (rho⁻¹ • (x - c))) volume :=
    (hbase.comp_smul (inv_ne_zero hrho.ne')).comp_sub_right c
  have hmul := hscale.const_mul (rho⁻¹ ^ N)
  apply hmul.congr
  filter_upwards with x
  exact (rawExteriorPowerTailAt_eq_scaled hrho c x).symm

theorem integral_rawExteriorPowerTailAt
    {d N : Nat} {rho : Real} (hrho : 0 < rho) (c : Euclidean d) :
    (∫ x : Euclidean d, rawExteriorPowerTailAt N rho c x) =
      (rho⁻¹ ^ N * (rho⁻¹ ^ d)⁻¹) *
        ∫ x : Euclidean d, rawExteriorPowerTail N x := by
  have hEq : (fun x : Euclidean d => rawExteriorPowerTailAt N rho c x) =
      fun x => rho⁻¹ ^ N * rawExteriorPowerTail N (rho⁻¹ • (x - c)) := by
    funext x
    exact rawExteriorPowerTailAt_eq_scaled hrho c x
  let H : Euclidean d → Real := fun x => rawExteriorPowerTail N (rho⁻¹ • x)
  calc
    (∫ x : Euclidean d, rawExteriorPowerTailAt N rho c x) =
        rho⁻¹ ^ N * ∫ x : Euclidean d,
          rawExteriorPowerTail N (rho⁻¹ • (x - c)) := by
      rw [hEq, integral_const_mul]
    _ = rho⁻¹ ^ N * ∫ x : Euclidean d, H (x - c) := by rfl
    _ = rho⁻¹ ^ N * ∫ x : Euclidean d, H x := by
      rw [integral_sub_right_eq_self]
    _ = (rho⁻¹ ^ N * (rho⁻¹ ^ d)⁻¹) *
        ∫ x : Euclidean d, rawExteriorPowerTail N x := by
      rw [show (∫ x : Euclidean d, H x) =
        (rho⁻¹ ^ Module.finrank Real (Euclidean d))⁻¹ •
          ∫ x : Euclidean d, rawExteriorPowerTail N x by
          exact Measure.integral_comp_smul_of_nonneg volume
            (rawExteriorPowerTail N) rho⁻¹ (hR := (inv_pos.mpr hrho).le)]
      simp only [finrank_euclideanSpace_fin, smul_eq_mul]
      ring

theorem raw_high_scale_cancellation
    (d N : Nat) [NeZero d] (hNd : d < N) (q : Int) :
    let rho : Real := (d : Real) * (2 : Real) ^ q
    let ell : Nat := N - d
    (2 * ((2 : Real) ^ q) ^ ell) *
        (rho⁻¹ ^ N * (rho⁻¹ ^ d)⁻¹) =
      2 * ((d : Real)⁻¹) ^ ell := by
  dsimp
  let D : Real := d
  let r : Real := (2 : Real) ^ q
  let ell : Nat := N - d
  have hD : D ≠ 0 := by
    dsimp [D]
    exact_mod_cast NeZero.ne d
  have hr : r ≠ 0 := by
    dsimp [r]
    exact zpow_ne_zero _ (by norm_num)
  have hN : N = d + ell := by
    dsimp [ell]
    exact (Nat.add_sub_of_le (Nat.le_of_lt hNd)).symm
  rw [hN, pow_add]
  field_simp [D, r, hD, hr]
  simp only [Nat.add_sub_cancel_left]
  rw [← mul_pow]
  field_simp [D, r, hD, hr]
noncomputable def rawFiniteIntDyadicMikhlinHighTailConstant
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  normalizedMikhlinKernelIBPBound (N := N) C A *
    (2 * ((d : Real)⁻¹) ^ (N - d)) *
    ∫ x : Euclidean d, rawExteriorPowerTail N x

theorem high_rawFiniteIntDyadicMikhlinKernel_atom_tail_le
    {d N : Nat} [NeZero d] (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d → Complex)
    (hb : Integrable b volume)
    (hsupp : ∀ y, b y ≠ 0 →
      ‖y - lacunaryCZDyadicCubeCenter q‖ ≤ lacunaryCZDyadicCubeRadius q) :
    (∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
      ‖∫ y : Euclidean d, b y *
        rawFiniteIntDyadicMikhlinKernel C m
          (K.filter fun k => -q.scale < k) (x - y)‖) ≤
      rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A *
        ∫ y : Euclidean d, ‖b y‖ := by
  let c : Euclidean d := lacunaryCZDyadicCubeCenter q
  let rho : Real := lacunaryCZDyadicCubeRadius q
  let E : Set (Euclidean d) := (Metric.closedBall c (3 * rho))ᶜ
  let Q : Real := normalizedMikhlinKernelIBPBound (N := N) C A
  let ell : Nat := N - d
  let C0 : Real := Q * (2 * ((2 : Real) ^ q.scale) ^ ell)
  let T : Euclidean d → Real := fun x => C0 / (‖x - c‖ / 3) ^ N
  have hrho : 0 < rho := lacunaryCZDyadicCubeRadius_pos q
  have hE : MeasurableSet E := Metric.isClosed_closedBall.measurableSet.compl
  have hTbase : Integrable (rawExteriorPowerTailAt N rho c) volume :=
    integrable_rawExteriorPowerTailAt hNd hrho c
  have hT : IntegrableOn T E volume := by
    apply (hTbase.const_mul C0).integrableOn.congr
    filter_upwards [ae_restrict_mem hE] with x hx
    dsimp only [T]
    unfold rawExteriorPowerTailAt
    rw [Set.indicator_of_mem hx]
    ring
  have hK : Integrable
      (rawFiniteIntDyadicMikhlinKernel C m
        (K.filter fun k => -q.scale < k)) volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd
      (K.filter fun k => -q.scale < k)
  have hpoint : ∀ x, x ∈ E → ∀ y, b y ≠ 0 →
      ‖rawFiniteIntDyadicMikhlinKernel C m
        (K.filter fun k => -q.scale < k) (x - y)‖ ≤ T x := by
    intro x hx y hy
    have hx' : 3 * rho < ‖x - c‖ := by
      rw [Set.mem_compl_iff, Metric.mem_closedBall, dist_eq_norm_sub] at hx
      exact lt_of_not_ge hx
    have hy' : ‖y - c‖ ≤ rho := by
      simpa only [c, rho] using hsupp y hy
    have htail := high_rawFiniteIntDyadicMikhlinKernel_exterior_tail
      C m hm hA hNd K q.scale hrho.le hx' hy'
    simpa only [T, C0, Q, ell, c, rho] using htail
  have htail := setIntegral_norm_kernel_convolution_le_of_pointwise_tail
    (rawFiniteIntDyadicMikhlinKernel C m
      (K.filter fun k => -q.scale < k)) hK b hb E hE T hT hpoint
  have hTint : (∫ x in E, T x) =
      C0 * ((rho⁻¹ ^ N * (rho⁻¹ ^ d)⁻¹) *
        ∫ x : Euclidean d, rawExteriorPowerTail N x) := by
    dsimp only [T]
    rw [show (fun x : Euclidean d => C0 / (‖x - c‖ / 3) ^ N) =
      fun x => C0 * (1 / (‖x - c‖ / 3) ^ N) by
        funext x
        ring]
    rw [integral_const_mul]
    congr 1
    rw [← MeasureTheory.integral_indicator hE]
    change (∫ x : Euclidean d, rawExteriorPowerTailAt N rho c x) = _
    exact integral_rawExteriorPowerTailAt (N := N) hrho c
  have hconst : C0 * ((rho⁻¹ ^ N * (rho⁻¹ ^ d)⁻¹) *
      ∫ x : Euclidean d, rawExteriorPowerTail N x) =
      rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A := by
    dsimp [C0, Q, ell, rho, rawFiniteIntDyadicMikhlinHighTailConstant]
    rw [show (lacunaryCZDyadicCubeRadius q : Real) =
      (d : Real) * (2 : Real) ^ q.scale by
      unfold lacunaryCZDyadicCubeRadius
      rfl]
    calc
      (normalizedMikhlinKernelIBPBound (N := N) C A *
          (2 * ((2 : Real) ^ q.scale) ^ (N - d))) *
          ((((d : Real) * (2 : Real) ^ q.scale)⁻¹ ^ N *
            (((d : Real) * (2 : Real) ^ q.scale)⁻¹ ^ d)⁻¹) *
              ∫ x : Euclidean d, rawExteriorPowerTail N x) =
          normalizedMikhlinKernelIBPBound (N := N) C A *
            ((2 * ((2 : Real) ^ q.scale) ^ (N - d)) *
              (((d : Real) * (2 : Real) ^ q.scale)⁻¹ ^ N *
                (((d : Real) * (2 : Real) ^ q.scale)⁻¹ ^ d)⁻¹)) *
              ∫ x : Euclidean d, rawExteriorPowerTail N x := by ring
      _ = normalizedMikhlinKernelIBPBound (N := N) C A *
          (2 * ((d : Real)⁻¹) ^ (N - d)) *
            ∫ x : Euclidean d, rawExteriorPowerTail N x := by
        rw [raw_high_scale_cancellation d N hNd q.scale]
  calc
    (∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
      ‖∫ y : Euclidean d, b y *
        rawFiniteIntDyadicMikhlinKernel C m
          (K.filter fun k => -q.scale < k) (x - y)‖) ≤
        (∫ x in E, T x) * ∫ y : Euclidean d, ‖b y‖ := by
      simpa only [E, c, rho] using htail
    _ = rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A *
          ∫ y : Euclidean d, ‖b y‖ := by rw [hTint, hconst]

noncomputable def rawFiniteIntDyadicMikhlinKernelCZTailConstant
    {d N : Nat} (C : lpCutoffs d) (A : Real) : Real :=
  2 * (d : Real) * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A +
    rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A

theorem rawFiniteIntDyadicMikhlinHighTailConstant_nonneg
    {d N : Nat} (C : lpCutoffs d) {A : Real} (hA : 0 ≤ A) :
    0 ≤ rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A := by
  unfold rawFiniteIntDyadicMikhlinHighTailConstant
  have hQ : 0 ≤ normalizedMikhlinKernelIBPBound (N := N) C A :=
    normalizedMikhlinKernelIBPBound_nonneg C hA
  have hd : 0 ≤ ((d : Real)⁻¹) ^ (N - d) := by positivity
  have hI : 0 ≤ ∫ x : Euclidean d, rawExteriorPowerTail N x :=
    integral_nonneg fun x => rawExteriorPowerTail_nonneg (N := N) x
  positivity

theorem rawFiniteIntDyadicMikhlinKernelCZTailConstant_nonneg
    {d N : Nat} (C : lpCutoffs d) {A : Real} (hA : 0 ≤ A) :
    0 ≤ rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A := by
  unfold rawFiniteIntDyadicMikhlinKernelCZTailConstant
  apply add_nonneg
  · have htwo_d : 0 ≤ (2 : Real) * (d : Real) :=
      mul_nonneg (by norm_num) (Nat.cast_nonneg d)
    exact mul_nonneg htwo_d (normalizedMikhlinKernelDerivativeL1Bound_nonneg C hA)
  · exact rawFiniteIntDyadicMikhlinHighTailConstant_nonneg C hA
theorem rawFiniteIntDyadicMikhlinKernel_atom_tail_le
    {d N : Nat} [NeZero d] (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) (q : LacunaryCZDyadicCubeIndex d) (b : Euclidean d → Complex)
    (hb : Integrable b volume) (hzero : ∫ y : Euclidean d, b y = 0)
    (hsupp : ∀ y, b y ≠ 0 →
      ‖y - lacunaryCZDyadicCubeCenter q‖ ≤ lacunaryCZDyadicCubeRadius q) :
    (∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
      ‖∫ y : Euclidean d, b y *
        rawFiniteIntDyadicMikhlinKernel C m K (x - y)‖) ≤
      rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
        ∫ y : Euclidean d, ‖b y‖ := by
  let E : Set (Euclidean d) :=
    (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ
  let Klow : Euclidean d → Complex := rawFiniteIntDyadicMikhlinKernel C m
    (K.filter fun k => k ≤ -q.scale)
  let Khigh : Euclidean d → Complex := rawFiniteIntDyadicMikhlinKernel C m
    (K.filter fun k => -q.scale < k)
  let Kall : Euclidean d → Complex := rawFiniteIntDyadicMikhlinKernel C m K
  have hKall : Integrable Kall volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd K
  have hKlow : Integrable Klow volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd
      (K.filter fun k => k ≤ -q.scale)
  have hKhigh : Integrable Khigh volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd
      (K.filter fun k => -q.scale < k)
  have hKeq : ∀ z, Kall z = Klow z + Khigh z := by
    intro z
    simpa only [Kall, Klow, Khigh] using
      rawFiniteIntDyadicMikhlinKernel_split_at C m K q.scale z
  have hsplit := setIntegral_norm_kernel_convolution_le_add_of_kernel_eq
    Kall Klow Khigh hKeq hKall hKlow hKhigh b hb E
  have hlow := low_rawFiniteIntDyadicMikhlinKernel_atom_tail_le C m hm hA hNd K q
    b hb hzero hsupp E
  have hhigh := high_rawFiniteIntDyadicMikhlinKernel_atom_tail_le C m hm hA hNd K q
    b hb hsupp
  have hlow' : (∫ x in E, ‖∫ y : Euclidean d, b y * Klow (x - y)‖) ≤
      (2 * (d : Real) * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A) *
        ∫ y : Euclidean d, ‖b y‖ := by
    change (∫ x in E, ‖∫ y : Euclidean d, b y *
      rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => k ≤ -q.scale) (x - y)‖) ≤ _
    exact hlow
  have hhigh' : (∫ x in E, ‖∫ y : Euclidean d, b y * Khigh (x - y)‖) ≤
      rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A *
        ∫ y : Euclidean d, ‖b y‖ := by
    change (∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
      ‖∫ y : Euclidean d, b y *
        rawFiniteIntDyadicMikhlinKernel C m (K.filter fun k => -q.scale < k) (x - y)‖) ≤ _
    exact hhigh
  calc
    (∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
      (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
      ‖∫ y : Euclidean d, b y * rawFiniteIntDyadicMikhlinKernel C m K (x - y)‖) ≤
        (∫ x in E, ‖∫ y : Euclidean d, b y * Klow (x - y)‖) +
          ∫ x in E, ‖∫ y : Euclidean d, b y * Khigh (x - y)‖ := by
      simpa only [E, Kall] using hsplit
    _ ≤ (2 * (d : Real) * normalizedMikhlinKernelDerivativeL1Bound (N := N) C A) *
          (∫ y : Euclidean d, ‖b y‖) +
        rawFiniteIntDyadicMikhlinHighTailConstant (N := N) C A *
          (∫ y : Euclidean d, ‖b y‖) := by
      exact add_le_add hlow' hhigh'
    _ = rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
          ∫ y : Euclidean d, ‖b y‖ := by
      unfold rawFiniteIntDyadicMikhlinKernelCZTailConstant
      ring

theorem rawFiniteIntDyadicMikhlinKernel_hasFiniteConvolutionKernelCZTail
    {d N : Nat} [NeZero d] (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (hNd : d < N)
    (K : Finset Int) :
    HasFiniteConvolutionKernelCZTail
      (rawFiniteIntDyadicMikhlinKernel C m K)
      (rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A) := by
  intro f U hAtom hzero hsupp
  have hK : Integrable (rawFiniteIntDyadicMikhlinKernel C m K) volume :=
    integrable_rawFiniteIntDyadicMikhlinKernel C m hm hNd K
  have hqInt : ∀ q ∈ U, Integrable (fun x : Euclidean d =>
      ‖finiteConvolutionKernelOperator
        (rawFiniteIntDyadicMikhlinKernel C m K)
        (lacunaryCZDyadicCubeBadAtom f q) x‖) volume := by
    intro q hq
    simpa only [finiteConvolutionKernelOperator] using
      Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution
        (rawFiniteIntDyadicMikhlinKernel C m K) hK
        (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq)
  have hqBound : ∀ q ∈ U,
      (∫ x in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
        ‖finiteConvolutionKernelOperator
          (rawFiniteIntDyadicMikhlinKernel C m K)
          (lacunaryCZDyadicCubeBadAtom f q) x‖) ≤
        rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
          ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
    intro q hq
    have hsubset : (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ ⊆
        (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
          (3 * lacunaryCZDyadicCubeRadius q))ᶜ := by
      intro x hx hball
      apply hx
      exact Set.mem_iUnion₂.mpr ⟨q, hq, hball⟩
    have hmono : (∫ x in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
        ‖finiteConvolutionKernelOperator
          (rawFiniteIntDyadicMikhlinKernel C m K)
          (lacunaryCZDyadicCubeBadAtom f q) x‖) ≤
        ∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
          (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
          ‖finiteConvolutionKernelOperator
            (rawFiniteIntDyadicMikhlinKernel C m K)
            (lacunaryCZDyadicCubeBadAtom f q) x‖ := by
      exact integral_mono_measure (Measure.restrict_mono hsubset le_rfl)
        (Filter.Eventually.of_forall fun x => norm_nonneg _)
        ((hqInt q hq).mono_measure Measure.restrict_le_self)
    calc
      (∫ x in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
        ‖finiteConvolutionKernelOperator
          (rawFiniteIntDyadicMikhlinKernel C m K)
          (lacunaryCZDyadicCubeBadAtom f q) x‖) ≤
          ∫ x in (Metric.closedBall (lacunaryCZDyadicCubeCenter q)
            (3 * lacunaryCZDyadicCubeRadius q))ᶜ,
            ‖finiteConvolutionKernelOperator
              (rawFiniteIntDyadicMikhlinKernel C m K)
              (lacunaryCZDyadicCubeBadAtom f q) x‖ := hmono
      _ ≤ rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
          ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
        simpa only [finiteConvolutionKernelOperator] using
          rawFiniteIntDyadicMikhlinKernel_atom_tail_le C m hm hA hNd K q
            (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq) (hzero q hq)
            (hsupp q hq)
  have hTailInt : Integrable
      (finiteConvolutionKernelBadTail
        (rawFiniteIntDyadicMikhlinKernel C m K) f U) volume := by
    unfold finiteConvolutionKernelBadTail
    exact integrable_finsetSum U hqInt
  refine ⟨hTailInt, ?_⟩
  unfold finiteConvolutionKernelBadTail
  rw [integral_finsetSum U fun q hq => (hqInt q hq).integrableOn]
  calc
    (∑ q ∈ U, ∫ x in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      ‖finiteConvolutionKernelOperator
        (rawFiniteIntDyadicMikhlinKernel C m K)
        (lacunaryCZDyadicCubeBadAtom f q) x‖) ≤
        ∑ q ∈ U, rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
          ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
      exact Finset.sum_le_sum fun q hq => hqBound q hq
    _ = rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A *
        ∑ q ∈ U, ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
      rw [Finset.mul_sum]




/-- The finite raw Mikhlin frequency symbol associated to a finite set of
dyadic bands. -/
def rawFiniteIntDyadicMikhlinSymbol {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (K : Finset Int) : Euclidean d → Complex :=
  fun xi => ∑ k ∈ K, intDyadicBandpassMultiplier C.cutoff k xi * m xi

/-- The literal inverse-Fourier realization of a finite raw Mikhlin
multiplier on the Schwartz core. -/
def rawFiniteIntDyadicMikhlinMultiplier {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (K : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex :=
  fun x => fourierInv (fun xi => rawFiniteIntDyadicMikhlinSymbol C m K xi *
    fourier (f : Euclidean d → Complex) xi) x

private theorem rawFiniteIntDyadicMikhlinSymbol_mul_fourier_eq_sum
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) :
    (fun xi : Euclidean d => rawFiniteIntDyadicMikhlinSymbol C m K xi *
      fourier (f : Euclidean d → Complex) xi) =
      fun xi => ∑ k ∈ K,
        (intDyadicBandpassMultiplier C.cutoff k xi * m xi) *
          fourier (f : Euclidean d → Complex) xi := by
  funext xi
  unfold rawFiniteIntDyadicMikhlinSymbol
  rw [Finset.sum_mul]

private theorem integrable_rawFiniteIntDyadicMikhlinSymbol_mul_fourier
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A)
    (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun xi : Euclidean d => rawFiniteIntDyadicMikhlinSymbol C m K xi *
      fourier (f : Euclidean d → Complex) xi) volume := by
  rw [rawFiniteIntDyadicMikhlinSymbol_mul_fourier_eq_sum]
  apply integrable_finsetSum
  intro k hk
  have hpiece := contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM
  have hfourier : ContDiff Real N
      (fourier (f : Euclidean d → Complex)) := by
    rw [← SchwartzMap.fourier_coe]
    exact (fourier f).smooth (N : ENat)
  exact (hpiece.1.mul hfourier).continuous.integrable_of_hasCompactSupport
    (hpiece.2.mul_right)

private theorem integrable_fourier_of_compact_cN
    {d N : Nat} (psi : Euclidean d → Complex) (hpsi : ContDiff Real N psi)
    (hpsi_supp : HasCompactSupport psi) (hNd : d < N) :
    Integrable (fourier psi) volume := by
  have hinv : Integrable (fourierInv psi) volume :=
    compact_cN_fourierInv_integrable psi hpsi hpsi_supp hNd
  rw [show fourier psi = fun x : Euclidean d => fourierInv psi (-x) by
    funext x
    rw [Real.fourierInv_eq_fourier_neg psi (-x), neg_neg]]
  simpa using hinv.comp_neg

/-- Exact Fourier-side identification of the literal finite raw kernel. -/
theorem fourier_rawFiniteIntDyadicMikhlinKernel_eq_symbol
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (xi : Euclidean d) :
    fourier (rawFiniteIntDyadicMikhlinKernel C m K) xi =
      rawFiniteIntDyadicMikhlinSymbol C m K xi := by
  unfold rawFiniteIntDyadicMikhlinKernel rawFiniteIntDyadicMikhlinSymbol
  have hqchar : ∀ k ∈ K, Integrable (fun x : Euclidean d =>
      Real.fourierChar (-inner Real x xi) • fourierInv
        (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z) x) volume := by
    intro k hk
    refine Integrable.mono'
      (compact_cN_fourierInv_integrable
        (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z)
        (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1
        (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).2 hNd).norm ?_ ?_
    · exact (Real.continuous_fourierChar.comp (by fun_prop)).aestronglyMeasurable.smul
        (compact_cN_fourierInv_integrable
          (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z)
          (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1
          (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).2 hNd).aestronglyMeasurable
    · filter_upwards with x
      simp
  rw [Real.fourier_eq]
  change (∫ x : Euclidean d, Real.fourierChar (-inner Real x xi) •
      (∑ k ∈ K, fourierInv
        (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z) x)) = _
  rw [show (fun x : Euclidean d => Real.fourierChar (-inner Real x xi) •
      (∑ k ∈ K, fourierInv
        (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z) x)) =
        fun x => ∑ k ∈ K, Real.fourierChar (-inner Real x xi) • fourierInv
          (fun z : Euclidean d => intDyadicBandpassMultiplier C.cutoff k z * m z) x by
      funext x
      rw [Finset.smul_sum],
    MeasureTheory.integral_finsetSum K hqchar]
  apply Finset.sum_congr rfl
  intro k hk
  rw [← Real.fourier_eq]
  have hpieceCont : Continuous (fun z : Euclidean d =>
      intDyadicBandpassMultiplier C.cutoff k z * m z) :=
    (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1.continuous
  have hpieceInt : Integrable (fun z : Euclidean d =>
      intDyadicBandpassMultiplier C.cutoff k z * m z) volume :=
    hpieceCont.integrable_of_hasCompactSupport
      (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).2
  exact congrFun (Continuous.fourier_fourierInv_eq
    hpieceCont hpieceInt
    (integrable_fourier_of_compact_cN
      (fun z => intDyadicBandpassMultiplier C.cutoff k z * m z)
      (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1
      (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).2 hNd)) xi

private theorem fourierInv_multiplier_eq_finiteConvolutionKernelOperator_of_fourier
    {d : Nat} (K psi : Euclidean d → Complex) (hK : Integrable K volume)
    (hFourierK : ∀ xi : Euclidean d, fourier K xi = psi xi)
    (f : SchwartzMap (Euclidean d) Complex)
    (hproduct : Integrable (fun xi : Euclidean d =>
      psi xi * fourier (f : Euclidean d → Complex) xi) volume)
    (x : Euclidean d) :
    fourierInv (fun xi : Euclidean d => psi xi * fourier (f : Euclidean d → Complex) xi) x =
      finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x := by
  let P : Euclidean d → Complex :=
    K ⋆[ContinuousLinearMap.mul Complex Complex, volume] (f : Euclidean d → Complex)
  have hPint : Integrable P volume := by
    exact hK.integrable_convolution (ContinuousLinearMap.mul Complex Complex) f.integrable
  have hfBounded : BddAbove (Set.range fun z : Euclidean d =>
      ‖(f : Euclidean d → Complex) z‖) := by
    refine ⟨‖f.toBoundedContinuousFunction‖, ?_⟩
    rintro _ ⟨z, rfl⟩
    exact BoundedContinuousFunction.norm_coe_le_norm f.toBoundedContinuousFunction z
  have hPcont : Continuous P := by
    dsimp [P]
    apply BddAbove.continuous_convolution_right_of_integrable
    · exact hfBounded
    · exact hK
    · exact f.continuous
  have hFourierP (xi : Euclidean d) :
      fourier P xi = psi xi * fourier (f : Euclidean d → Complex) xi := by
    dsimp [P]
    rw [Real.fourier_mul_convolution_eq hK f.integrable, hFourierK]
  have hPfourierInt : Integrable (fourier P) volume := by
    rw [show fourier P = fun xi : Euclidean d =>
        psi xi * fourier (f : Euclidean d → Complex) xi by
      funext xi
      exact hFourierP xi]
    exact hproduct
  have hInv : fourierInv (fourier P) = P :=
    hPcont.fourierInv_fourier_eq hPint hPfourierInt
  calc
    fourierInv (fun xi : Euclidean d =>
        psi xi * fourier (f : Euclidean d → Complex) xi) x =
        fourierInv (fourier P) x := by
      apply congrArg (fun q : Euclidean d → Complex => fourierInv q x)
      funext xi
      exact (hFourierP xi).symm
    _ = P x := congrFun hInv x
    _ = finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x := by
      dsimp [P, finiteConvolutionKernelOperator]
      rw [convolution_mul_swap]
      apply integral_congr_ae
      filter_upwards with y
      ring

/-- The literal raw finite multiplier is exactly physical convolution by the
literal raw finite kernel. -/
theorem rawFiniteIntDyadicMikhlinMultiplier_eq_convolution
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    rawFiniteIntDyadicMikhlinMultiplier C m K f x =
      finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x := by
  unfold rawFiniteIntDyadicMikhlinMultiplier
  exact fourierInv_multiplier_eq_finiteConvolutionKernelOperator_of_fourier
    (rawFiniteIntDyadicMikhlinKernel C m K) (rawFiniteIntDyadicMikhlinSymbol C m K)
    (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K)
    (fourier_rawFiniteIntDyadicMikhlinKernel_eq_symbol C m K hM hNd)
    f (integrable_rawFiniteIntDyadicMikhlinSymbol_mul_fourier C m K hM f) x

/-- The injective integer indexing of a symmetric finite dyadic truncation. -/
def symmetricRawFiniteIntDyadicMikhlinEmbedding (n : Nat) : Nat ↪ Int where
  toFun i := -(n : Int) + i
  inj' := by
    intro i j hij
    have hcast : (i : Int) = (j : Int) := by
      linarith
    exact_mod_cast hcast

/-- The finite integer range `[-n,n]`, presented in the summation order used
by the symmetric raw truncation. -/
def symmetricRawFiniteIntDyadicMikhlinIndex (n : Nat) : Finset Int :=
  (Finset.range (2 * n + 1)).map (symmetricRawFiniteIntDyadicMikhlinEmbedding n)

private theorem rawFiniteIntDyadicMikhlinMultiplier_eq_sum_symmetric_raw_pieces
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hM : MikhlinCondition N m A) (n : Nat)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    rawFiniteIntDyadicMikhlinMultiplier C m (symmetricRawFiniteIntDyadicMikhlinIndex n) f x =
      ∑ i ∈ Finset.range (2 * n + 1),
        fourierInv (fun xi : Euclidean d =>
          intDyadicBandpassMultiplier C.cutoff (-(n : Int) + i) xi * m xi *
            fourier (f : Euclidean d → Complex) xi) x := by
  unfold rawFiniteIntDyadicMikhlinMultiplier rawFiniteIntDyadicMikhlinSymbol
  rw [show (fun xi : Euclidean d =>
      (∑ k ∈ symmetricRawFiniteIntDyadicMikhlinIndex n,
        intDyadicBandpassMultiplier C.cutoff k xi * m xi) *
          fourier (f : Euclidean d → Complex) xi) =
        fun xi => ∑ k ∈ symmetricRawFiniteIntDyadicMikhlinIndex n,
          (intDyadicBandpassMultiplier C.cutoff k xi * m xi) *
            fourier (f : Euclidean d → Complex) xi by
      funext xi
      rw [Finset.sum_mul]]
  rw [fourierInv_finset_sum_of_integrable (symmetricRawFiniteIntDyadicMikhlinIndex n)
    (fun k xi => (intDyadicBandpassMultiplier C.cutoff k xi * m xi) *
      fourier (f : Euclidean d → Complex) xi)
    (fun k hk => by
      have hpiece := contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM
      have hfourier : ContDiff Real N
          (fourier (f : Euclidean d → Complex)) := by
        rw [← SchwartzMap.fourier_coe]
        exact (fourier f).smooth (N : ENat)
      exact (hpiece.1.mul hfourier).continuous.integrable_of_hasCompactSupport
        (hpiece.2.mul_right)) x]
  simp only [symmetricRawFiniteIntDyadicMikhlinIndex, Finset.sum_map]
  apply Finset.sum_congr rfl
  intro i hi
  rfl

/-- A symmetric literal raw Mikhlin truncation is physical convolution by
the corresponding finite raw kernel. -/
theorem finiteSymmetricMikhlinTruncation_eq_rawFiniteIntDyadicMikhlinConvolution
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (n : Nat) (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteSymmetricMikhlinTruncation C m n f x =
      finiteConvolutionKernelOperator
        (rawFiniteIntDyadicMikhlinKernel C m (symmetricRawFiniteIntDyadicMikhlinIndex n))
        (f : Euclidean d → Complex) x := by
  rw [finiteSymmetricMikhlinTruncation_eq_sum_raw_dyadic_pieces C m
    (measurable_aux_puncturedSymbol_of_mikhlin hM).aestronglyMeasurable hA
    (norm_aux_puncturedSymbol_le_of_mikhlin m hA hM) n f x]
  rw [← rawFiniteIntDyadicMikhlinMultiplier_eq_sum_symmetric_raw_pieces C m hM n f x]
  exact rawFiniteIntDyadicMikhlinMultiplier_eq_convolution C m
    (symmetricRawFiniteIntDyadicMikhlinIndex n) hM hNd f x


private theorem star_fourierInv_neg_eq_fourierInv_star
    {d : Nat} (psi : Euclidean d → Complex) (x : Euclidean d) :
    starRingEnd Complex (fourierInv psi (-x)) =
      fourierInv (fun xi => starRingEnd Complex (psi xi)) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← integral_conj]
  apply integral_congr_ae
  filter_upwards with xi
  have hchar :
      starRingEnd Complex
          ((Real.fourierChar (inner Real xi (-x)) : Circle) : Complex) =
        ((Real.fourierChar (inner Real xi x) : Circle) : Complex) := by
    rw [Real.fourierChar_apply, Real.fourierChar_apply, ← Complex.exp_conj]
    congr 1
    simp only [inner_neg_right, map_mul, Complex.conj_ofReal,
      Complex.conj_I]
    norm_num
  rw [Circle.smul_def, Circle.smul_def, smul_eq_mul, smul_eq_mul, map_mul, hchar]

/-- Reflecting and conjugating a finite raw Mikhlin kernel produces the raw
kernel for the conjugated cutoff and frequency symbol. -/
theorem star_neg_rawFiniteIntDyadicMikhlinKernel_eq
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (x : Euclidean d) :
    starRingEnd Complex (rawFiniteIntDyadicMikhlinKernel C m K (-x)) =
      rawFiniteIntDyadicMikhlinKernel (conjugateLpCutoffs C)
        (fun xi => starRingEnd Complex (m xi)) K x := by
  unfold rawFiniteIntDyadicMikhlinKernel
  rw [map_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [star_fourierInv_neg_eq_fourierInv_star]
  apply congrArg (fun q : Euclidean d → Complex => fourierInv q x)
  funext xi
  rw [intDyadicBandpassMultiplier_conjugateLpCutoffs_apply]
  exact map_mul (starRingEnd Complex)
    (intDyadicBandpassMultiplier C.cutoff k xi) (m xi)

/-- The physical adjoint of a finite raw Mikhlin kernel is convolution by
the finite raw kernel attached to the conjugate cutoff and symbol. -/
theorem convolutionPhysicalAdjoint_rawFiniteIntDyadicMikhlinKernel_eq
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (g : Euclidean d → Complex) (y : Euclidean d) :
    convolutionPhysicalAdjoint (rawFiniteIntDyadicMikhlinKernel C m K) g y =
      finiteConvolutionKernelOperator
        (rawFiniteIntDyadicMikhlinKernel (conjugateLpCutoffs C)
          (fun xi => starRingEnd Complex (m xi)) K) g y := by
  unfold convolutionPhysicalAdjoint finiteConvolutionKernelOperator
  apply integral_congr_ae
  filter_upwards with x
  have h := star_neg_rawFiniteIntDyadicMikhlinKernel_eq C m K (y - x)
  rw [show -(y - x) = x - y by abel] at h
  rw [h]


/-! ### Raw finite Mikhlin `L²` endpoint -/

/-- The distributional Fourier transform of an `L¹` function is represented
by any `Lᵖ` realization of its classical Fourier transform.  This Fubini
bridge is used only to compare a literal finite kernel with its `L²` Fourier
multiplier realization. -/
private theorem rawFiniteMikhlin_fourier_toTemperedDistribution_eq_of_memLp_one
    {d : Nat} {p : ENNReal} [Fact (1 ≤ p)]
    {f h : Euclidean d → Complex}
    (hf : MemLp f 1 volume) (hh : MemLp h p volume)
    (hfourier : ∀ xi : Euclidean d, FourierTransform.fourier f xi = h xi) :
    FourierTransform.fourier
      ((hf.toLp f : Lp Complex 1 (volume : Measure (Euclidean d))) :
        TemperedDistribution (Euclidean d) Complex) =
      ((hh.toLp h : Lp Complex p (volume : Measure (Euclidean d))) :
        TemperedDistribution (Euclidean d) Complex) := by
  ext u
  simp only [TemperedDistribution.fourier_apply,
    MeasureTheory.Lp.toTemperedDistribution_apply]
  have hfint : Integrable f volume := memLp_one_iff_integrable.mp hf
  have hduality := VectorFourier.integral_fourierIntegral_smul_eq_flip
    (L := innerₗ (Euclidean d)) Real.continuous_fourierChar continuous_inner
      hfint (u.integrable (μ := volume))
  calc
    (∫ x : Euclidean d, FourierTransform.fourier u x •
        (hf.toLp f : Euclidean d → Complex) x) =
        ∫ x : Euclidean d, f x • FourierTransform.fourier u x := by
      apply integral_congr_ae
      filter_upwards [hf.coeFn_toLp] with x hx
      rw [hx]
      simpa only [smul_eq_mul] using
        (mul_comm (FourierTransform.fourier u x) (f x))
    _ = ∫ xi : Euclidean d, FourierTransform.fourier f xi • u xi := by
      change (∫ x : Euclidean d, f x •
        VectorFourier.fourierIntegral 𝐞 volume (innerₗ (Euclidean d)) u x) =
        ∫ xi : Euclidean d,
          VectorFourier.fourierIntegral 𝐞 volume (innerₗ (Euclidean d)) f xi • u xi
      simpa using hduality.symm
    _ = ∫ xi : Euclidean d, u xi • h xi := by
      apply integral_congr_ae
      filter_upwards with xi
      rw [hfourier xi]
      simpa only [smul_eq_mul] using
        (mul_comm (h xi) (u xi))
    _ = ∫ xi : Euclidean d, u xi •
        (hh.toLp h : Euclidean d → Complex) xi := by
      apply integral_congr_ae
      filter_upwards [hh.coeFn_toLp] with xi hxi
      rw [hxi]

/-- A bounded measurable symbol which is the literal Fourier transform of
an integrable kernel has the expected `L²` realization on the Schwartz
core. -/
private theorem rawFiniteMikhlin_convolution_ae_eq_aux_multiplierL2_of_fourier
    {d : Nat} (K ψ : Euclidean d → Complex) (hK : Integrable K volume)
    (hψ : AEStronglyMeasurable ψ volume) (B : Real) (_hB : 0 ≤ B)
    (hψB : ∀ xi : Euclidean d, ‖ψ xi‖ ≤ B)
    (hFourierK : ∀ xi : Euclidean d, FourierTransform.fourier K xi = ψ xi)
    (f : SchwartzMap (Euclidean d) Complex) :
    (K ⋆[ContinuousLinearMap.mul Complex Complex, volume]
      (f : Euclidean d → Complex)) =ᵐ[volume]
      ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d))) :
        Euclidean d → Complex) := by
  letI : Fact (1 ≤ (2 : ENNReal)) := ⟨by norm_num⟩
  let Ff : Euclidean d → Complex := FourierTransform.fourier f
  let h : Euclidean d → Complex := fun xi => ψ xi * Ff xi
  have hψTop : MemLp ψ ⊤ volume := memLp_top_of_bound hψ B
    (Filter.Eventually.of_forall hψB)
  have hFfTwo : MemLp Ff 2 volume := by
    exact (FourierTransform.fourier f).memLp 2 volume
  have hh : MemLp h 2 volume := by
    change MemLp (ψ • Ff) 2 volume
    simpa only [Pi.smul_apply, smul_eq_mul] using MemLp.smul hFfTwo hψTop
  have hproductLp :
      ((hψTop.toLp ψ • FourierTransform.fourier (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d)))) = hh.toLp h := by
    rw [SchwartzMap.toLp_fourier_eq]
    apply Lp.ext
    filter_upwards [Lp.coeFn_lpSMul (p := ⊤) (q := 2) (r := 2)
      (hψTop.toLp ψ) ((FourierTransform.fourier f).toLp 2 volume),
      hψTop.coeFn_toLp, SchwartzMap.coeFn_toLp (FourierTransform.fourier f) 2 volume,
      hh.coeFn_toLp] with x hsmul hψx hFfx hhx
    rw [hsmul]
    simp only [Pi.mul_apply, smul_eq_mul]
    rw [hψx, hFfx, hhx]
  have hFourierMultiplier :
      FourierTransform.fourier
        ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
          Lp Complex 2 (volume : Measure (Euclidean d))) :
          TemperedDistribution (Euclidean d) Complex) =
      ((hh.toLp h : Lp Complex 2 (volume : Measure (Euclidean d))) :
        TemperedDistribution (Euclidean d) Complex) := by
    unfold aux_multiplierL2
    rw [← MeasureTheory.Lp.fourierInv_toTemperedDistribution_eq]
    rw [FourierTransform.fourier_fourierInv_eq]
    exact congrArg (fun q : Lp Complex 2 (volume : Measure (Euclidean d)) =>
      (q : TemperedDistribution (Euclidean d) Complex)) hproductLp
  let P : Euclidean d → Complex :=
    K ⋆[ContinuousLinearMap.mul Complex Complex, volume] (f : Euclidean d → Complex)
  have hPint : Integrable P volume := by
    exact hK.integrable_convolution (ContinuousLinearMap.mul Complex Complex) f.integrable
  have hPone : MemLp P 1 volume := memLp_one_iff_integrable.mpr hPint
  have hFourierP (xi : Euclidean d) : FourierTransform.fourier P xi = h xi := by
    dsimp [P, h, Ff]
    rw [Real.fourier_mul_convolution_eq hK f.integrable, hFourierK,
      ← SchwartzMap.fourier_coe]
  have hFourierPhysical :
      FourierTransform.fourier
        ((hPone.toLp P : Lp Complex 1 (volume : Measure (Euclidean d))) :
          TemperedDistribution (Euclidean d) Complex) =
      ((hh.toLp h : Lp Complex 2 (volume : Measure (Euclidean d))) :
        TemperedDistribution (Euclidean d) Complex) := by
    exact rawFiniteMikhlin_fourier_toTemperedDistribution_eq_of_memLp_one
      hPone hh hFourierP
  have hTD :
      ((hPone.toLp P : Lp Complex 1 (volume : Measure (Euclidean d))) :
          TemperedDistribution (Euclidean d) Complex) =
      ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d))) :
        TemperedDistribution (Euclidean d) Complex) := by
    calc
      ((hPone.toLp P : Lp Complex 1 (volume : Measure (Euclidean d))) :
          TemperedDistribution (Euclidean d) Complex) =
          FourierTransform.fourierInv (FourierTransform.fourier
            ((hPone.toLp P : Lp Complex 1 (volume : Measure (Euclidean d))) :
              TemperedDistribution (Euclidean d) Complex)) :=
        (FourierTransform.fourierInv_fourier_eq _).symm
      _ = FourierTransform.fourierInv (FourierTransform.fourier
          ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
            Lp Complex 2 (volume : Measure (Euclidean d))) :
            TemperedDistribution (Euclidean d) Complex)) := by
          rw [hFourierPhysical, hFourierMultiplier]
      _ = ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
          Lp Complex 2 (volume : Measure (Euclidean d))) :
          TemperedDistribution (Euclidean d) Complex) :=
        FourierTransform.fourierInv_fourier_eq _
  refine ae_eq_of_integral_contDiff_smul_eq hPint.locallyIntegrable
    ((Lp.memLp _).locallyIntegrable (by norm_num)) ?_
  intro phi hphiDiff hphiCompact
  let u : SchwartzMap (Euclidean d) Complex :=
    (hphiCompact.comp_left (g := Complex.ofRealCLM) rfl).toSchwartzMap
      (Complex.ofRealCLM.contDiff.comp hphiDiff)
  have htest := congrArg
    (fun T : TemperedDistribution (Euclidean d) Complex => T u) hTD
  have htest' :
      (∫ x : Euclidean d, u x • P x) =
        ∫ x : Euclidean d, u x •
          ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
            Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d → Complex) x := by
    calc
      (∫ x : Euclidean d, u x • P x) =
          ∫ x : Euclidean d, u x •
            (hPone.toLp P : Euclidean d → Complex) x := by
          apply integral_congr_ae
          filter_upwards [hPone.coeFn_toLp] with x hx
          rw [hx]
      _ = ∫ x : Euclidean d, u x •
          ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
            Lp Complex 2 (volume : Measure (Euclidean d))) :
            Euclidean d → Complex) x := by
          simpa only [MeasureTheory.Lp.toTemperedDistribution_apply] using htest
  change (∫ x : Euclidean d, u x • P x) =
    ∫ x : Euclidean d, u x •
      ((aux_multiplierL2 ψ hψ B hψB (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d))) :
        Euclidean d → Complex) x
  exact htest'

/-- The finite raw symbol is continuous, since each localized summand is a
compactly supported smooth Mikhlin piece. -/
theorem continuous_rawFiniteIntDyadicMikhlinSymbol
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) :
    Continuous (rawFiniteIntDyadicMikhlinSymbol C m K) := by
  unfold rawFiniteIntDyadicMikhlinSymbol
  refine continuous_finsetSum K ?_
  intro k hk
  exact (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1.continuous

theorem aestronglyMeasurable_rawFiniteIntDyadicMikhlinSymbol
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) :
    AEStronglyMeasurable (rawFiniteIntDyadicMikhlinSymbol C m K) volume :=
  (continuous_rawFiniteIntDyadicMikhlinSymbol C m K hM).aestronglyMeasurable

/-- At every frequency, only uniformly boundedly many integer dyadic
bandpasses overlap.  This gives the cardinality-free symbol estimate. -/
theorem norm_rawFiniteIntDyadicMikhlinSymbol_le_four_mul
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (xi : Euclidean d) :
    ‖rawFiniteIntDyadicMikhlinSymbol C m K xi‖ ≤ 4 * A := by
  unfold rawFiniteIntDyadicMikhlinSymbol
  by_cases hxi : xi = 0
  · subst xi
    have hzero (k : Int) : intDyadicBandpassMultiplier C.cutoff k (0 : Euclidean d) = 0 := by
      apply intDyadicBandpassMultiplier_zero_on_ball C k
      rw [Metric.mem_ball, dist_zero_right]
      simpa using (zpow_pos (by norm_num : (0 : Real) < 2) k)
    simpa [hzero] using hA
  · have hm : ‖m xi‖ ≤ A := by
      simpa using hM.2 0 (Nat.zero_le N) xi hxi
    calc
      ‖∑ k ∈ K, intDyadicBandpassMultiplier C.cutoff k xi * m xi‖ ≤
          ∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi * m xi‖ :=
        norm_sum_le K _
      _ = ∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi‖ * ‖m xi‖ := by
        apply Finset.sum_congr rfl
        intro k hk
        rw [norm_mul]
      _ ≤ (∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi‖) * A := by
        rw [Finset.sum_mul]
        apply Finset.sum_le_sum
        intro k hk
        exact mul_le_mul_of_nonneg_left hm (norm_nonneg _)
      _ ≤ 4 * A := by
        exact mul_le_mul_of_nonneg_right
          (finite_sum_norm_intDyadicBandpassMultiplier_le_four C K xi) hA

/-- The cardinality-free `L²` realization of a finite raw dyadic Mikhlin
sum. -/
def rawFiniteIntDyadicMikhlinL2 {d N : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (K : Finset Int) {A : Real}
    (hA : 0 ≤ A) (hM : MikhlinCondition N m A) :
    Lp Complex 2 (volume : Measure (Euclidean d)) →
      Lp Complex 2 (volume : Measure (Euclidean d)) :=
  aux_multiplierL2 (rawFiniteIntDyadicMikhlinSymbol C m K)
    (aestronglyMeasurable_rawFiniteIntDyadicMikhlinSymbol C m K hM)
    (4 * A) (norm_rawFiniteIntDyadicMikhlinSymbol_le_four_mul C m K hA hM)

theorem norm_rawFiniteIntDyadicMikhlinL2_le_four_mul
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (f : Lp Complex 2 (volume : Measure (Euclidean d))) :
    ‖rawFiniteIntDyadicMikhlinL2 C m K hA hM f‖ ≤ (4 * A) * ‖f‖ := by
  unfold rawFiniteIntDyadicMikhlinL2
  exact aux_multiplierL2_norm_le _ _ _ (by positivity) _ f

private theorem rawFiniteIntDyadicMikhlinL2_sub
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (f g : SchwartzMap (Euclidean d) Complex) :
    rawFiniteIntDyadicMikhlinL2 C m K hA hM ((f - g).toLp 2 volume) =
      rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume) -
        rawFiniteIntDyadicMikhlinL2 C m K hA hM (g.toLp 2 volume) := by
  change aux_multiplierL2 _ _ _ _
      ((SchwartzMap.toLpCLM Real Complex 2 volume) (f - g)) = _
  rw [map_sub]
  unfold aux_multiplierL2
  simp only [sub_eq_add_neg, FourierTransform.fourier_add,
    FourierTransform.fourier_neg]
  rw [Lp.add_smul, Lp.smul_neg, FourierTransform.fourierInv_add,
    FourierTransform.fourierInv_neg]
  rfl

/-- On a Schwartz input, convolution by the literal finite raw kernel is
almost everywhere the bounded Fourier-side `L²` realization. -/
theorem rawFiniteIntDyadicMikhlinKernel_ae_eq_l2
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    (rawFiniteIntDyadicMikhlinKernel C m K ⋆[
      ContinuousLinearMap.mul Complex Complex, volume] (f : Euclidean d → Complex)) =ᵐ[volume]
      ((rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d))) : Euclidean d → Complex) := by
  exact rawFiniteMikhlin_convolution_ae_eq_aux_multiplierL2_of_fourier
    (rawFiniteIntDyadicMikhlinKernel C m K)
    (rawFiniteIntDyadicMikhlinSymbol C m K)
    (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K)
    (aestronglyMeasurable_rawFiniteIntDyadicMikhlinSymbol C m K hM)
    (4 * A) (by positivity)
    (norm_rawFiniteIntDyadicMikhlinSymbol_le_four_mul C m K hA hM)
    (fourier_rawFiniteIntDyadicMikhlinKernel_eq_symbol C m K hM hNd) f

/-- The same raw endpoint in the literal physical-convolution orientation
used by the finite Calderón--Zygmund machinery. -/
theorem finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_ae_eq_l2
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex) =ᵐ[volume]
      ((rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume) :
        Lp Complex 2 (volume : Measure (Euclidean d))) : Euclidean d → Complex) := by
  filter_upwards [rawFiniteIntDyadicMikhlinKernel_ae_eq_l2 C m K hA hM hNd f]
    with x hx
  calc
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x =
        (rawFiniteIntDyadicMikhlinKernel C m K ⋆[
          ContinuousLinearMap.mul Complex Complex, volume] (f : Euclidean d → Complex)) x := by
      unfold finiteConvolutionKernelOperator
      rw [convolution_mul_swap]
      apply integral_congr_ae
      filter_upwards with y
      rw [mul_comm]
    _ = _ := hx

/-- The finite raw kernel satisfies the bounded-good-part `L²` datum used
by the finite Calderón--Zygmund weak endpoint, with the same cardinality-free
constant as its Fourier symbol. -/
theorem hasFiniteConvolutionKernelGoodL2Bound_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N) :
    HasFiniteConvolutionKernelGoodL2Bound
      (rawFiniteIntDyadicMikhlinKernel C m K) (4 * A) := by
  apply hasFiniteConvolutionKernelGoodL2Bound_of_schwartz_core
    (K := rawFiniteIntDyadicMikhlinKernel C m K)
    (C := 4 * A)
    (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K)
    (by positivity)
    (Tcore := fun f => rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume))
  · intro f g
    exact rawFiniteIntDyadicMikhlinL2_sub C m K hA hM f g
  · intro f
    exact norm_rawFiniteIntDyadicMikhlinL2_le_four_mul C m K hA hM (f.toLp 2 volume)
  · intro f
    apply Lp.ext
    filter_upwards [
      (rawFiniteIntDyadicMikhlinKernel_ae_eq_l2 C m K hA hM hNd f).symm,
      (memLp_two_convolution_of_integrable_of_norm_le
        (rawFiniteIntDyadicMikhlinKernel C m K) (f : Euclidean d → Complex)
        (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K) f.integrable
        ‖f.toBoundedContinuousFunction‖ (norm_nonneg _)
        (fun x => by
          change ‖f.toBoundedContinuousFunction x‖ ≤ ‖f.toBoundedContinuousFunction‖
          exact BoundedContinuousFunction.norm_coe_le_norm _ _)).coeFn_toLp]
      with x hxL2 hxPhysical
    rw [hxL2, hxPhysical, convolution_mul_swap]
    apply integral_congr_ae
    filter_upwards with y
    rw [mul_comm]

private theorem rawFiniteMikhlin_finiteConvolutionKernelOperator_eq_convolution
    {d : Nat} (K f : Euclidean d → Complex) (x : Euclidean d) :
    finiteConvolutionKernelOperator K f x =
      (K ⋆[ContinuousLinearMap.mul Complex Complex, volume] f) x := by
  unfold finiteConvolutionKernelOperator
  rw [convolution_mul_swap]
  apply integral_congr_ae
  filter_upwards with y
  rw [mul_comm]

/-- Literal raw finite-kernel convolution is integrable on every Schwartz
input. -/
theorem integrable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)) volume := by
  have hEq : finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex) =
      rawFiniteIntDyadicMikhlinKernel C m K ⋆[
        ContinuousLinearMap.mul Complex Complex, volume] (f : Euclidean d → Complex) := by
    funext x
    exact rawFiniteMikhlin_finiteConvolutionKernelOperator_eq_convolution _ _ x
  rw [hEq]
  exact (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K).integrable_convolution
    (ContinuousLinearMap.mul Complex Complex) f.integrable

theorem aestronglyMeasurable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable
      (finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex)) volume :=
  (integrable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
    C m K hM hNd f).aestronglyMeasurable

/-- Additivity of the literal raw finite convolution on the Schwartz core. -/
theorem finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_add
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f g : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      ((f + g : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) x =
      finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x +
        finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
          (g : Euclidean d → Complex) x := by
  unfold finiteConvolutionKernelOperator
  rw [← integral_add
    (integrable_convolution_integrand_of_norm_le
      (rawFiniteIntDyadicMikhlinKernel C m K) (f : Euclidean d → Complex)
      (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K) f.integrable
      ‖f.toBoundedContinuousFunction‖
      (fun z => BoundedContinuousFunction.norm_coe_le_norm
        f.toBoundedContinuousFunction z) x)
    (integrable_convolution_integrand_of_norm_le
      (rawFiniteIntDyadicMikhlinKernel C m K) (g : Euclidean d → Complex)
      (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K) g.integrable
      ‖g.toBoundedContinuousFunction‖
      (fun z => BoundedContinuousFunction.norm_coe_le_norm
        g.toBoundedContinuousFunction z) x)]
  apply integral_congr_ae
  filter_upwards with y
  change (f y + g y) * rawFiniteIntDyadicMikhlinKernel C m K (x - y) = _
  ring

private theorem rawFiniteMikhlin_lintegral_norm_sq_le_of_memLp_two_bound
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {C : Real} (hC : 0 ≤ C) (y f : α → E)
    (hy : MemLp y 2 μ) (hf : MemLp f 2 μ)
    (hbound : ‖hy.toLp y‖ ≤ C * ‖hf.toLp f‖) :
    (∫⁻ x, ENNReal.ofReal (‖y x‖ ^ (2 : Nat)) ∂μ) ≤
      (ENNReal.ofReal C) ^ (2 : Nat) *
        ∫⁻ x, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) ∂μ := by
  have hyint : Integrable (fun x => ‖y x‖ ^ (2 : Nat)) μ := by
    simpa using hy.integrable_norm_rpow (by norm_num : (2 : ENNReal) ≠ 0)
      ENNReal.ofNat_ne_top
  have hfint : Integrable (fun x => ‖f x‖ ^ (2 : Nat)) μ := by
    simpa using hf.integrable_norm_rpow (by norm_num : (2 : ENNReal) ≠ 0)
      ENNReal.ofNat_ne_top
  have hy_nonneg : 0 ≤ ∫ x, ‖y x‖ ^ (2 : Nat) ∂μ :=
    integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hf_nonneg : 0 ≤ ∫ x, ‖f x‖ ^ (2 : Nat) ∂μ :=
    integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hroot : √(∫ x, ‖y x‖ ^ (2 : Nat) ∂μ) ≤
      C * √(∫ x, ‖f x‖ ^ (2 : Nat) ∂μ) := by
    rw [Auto.Spherical.PowerWeights.LacunaryCZFiniteWeak.norm_toLp_two_eq_sqrt_integral_norm_sq_general,
      Auto.Spherical.PowerWeights.LacunaryCZFiniteWeak.norm_toLp_two_eq_sqrt_integral_norm_sq_general] at hbound
    exact hbound
  have hsquare : (√(∫ x, ‖y x‖ ^ (2 : Nat) ∂μ)) ^ (2 : Nat) ≤
      (C * √(∫ x, ‖f x‖ ^ (2 : Nat) ∂μ)) ^ (2 : Nat) :=
    (sq_le_sq₀ (Real.sqrt_nonneg _) (mul_nonneg hC (Real.sqrt_nonneg _))).mpr hroot
  have hreal : (∫ x, ‖y x‖ ^ (2 : Nat) ∂μ) ≤
      C ^ (2 : Nat) * ∫ x, ‖f x‖ ^ (2 : Nat) ∂μ := by
    calc
      (∫ x, ‖y x‖ ^ (2 : Nat) ∂μ) =
          (√(∫ x, ‖y x‖ ^ (2 : Nat) ∂μ)) ^ (2 : Nat) :=
        (Real.sq_sqrt hy_nonneg).symm
      _ ≤ (C * √(∫ x, ‖f x‖ ^ (2 : Nat) ∂μ)) ^ (2 : Nat) := hsquare
      _ = C ^ (2 : Nat) * (√(∫ x, ‖f x‖ ^ (2 : Nat) ∂μ)) ^ (2 : Nat) := by ring
      _ = C ^ (2 : Nat) * ∫ x, ‖f x‖ ^ (2 : Nat) ∂μ := by
        rw [Real.sq_sqrt hf_nonneg]
  have hlin := Auto.Spherical.InterpolationCore.lintegral_ofReal_sq_le_of_integral_sq_le
    (fun z : (α → E) × (α → E) => z.2) (fun z x => ‖z.1 x‖) (y, f)
    (C ^ (2 : Nat)) (sq_nonneg C) hyint hfint hreal
  simpa only using hlin.trans_eq (by rw [ENNReal.ofReal_pow hC])

/-- ENNReal square-endpoint form of the literal raw finite convolution. -/
theorem lintegral_norm_sq_rawFiniteIntDyadicMikhlinKernelOperator_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    (∫⁻ x : Euclidean d, ENNReal.ofReal
      (‖finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x‖ ^ (2 : Nat))) ≤
      (ENNReal.ofReal (4 * A)) ^ (2 : Nat) *
        ∫⁻ x : Euclidean d, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
  let P : Euclidean d → Complex :=
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)
  let T : Lp Complex 2 (volume : Measure (Euclidean d)) :=
    rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume)
  have hPae : P =ᵐ[volume] (T : Euclidean d → Complex) := by
    dsimp [P, T]
    exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_ae_eq_l2
      C m K hA hM hNd f
  have hP : MemLp P 2 volume :=
    MemLp.ae_eq hPae.symm (Lp.memLp T)
  have hPtoLp : hP.toLp P = T := by
    apply Lp.ext
    filter_upwards [hP.coeFn_toLp, hPae] with x hxP hxAe
    rw [hxP, hxAe]
  have hbound : ‖hP.toLp P‖ ≤ (4 * A) * ‖f.toLp 2 volume‖ := by
    rw [hPtoLp]
    exact norm_rawFiniteIntDyadicMikhlinL2_le_four_mul C m K hA hM
      (f.toLp 2 volume)
  simpa only [P] using rawFiniteMikhlin_lintegral_norm_sq_le_of_memLp_two_bound
    (by positivity) P (f : Euclidean d → Complex) hP (f.memLp 2 volume) hbound

private theorem rawFiniteMikhlin_memLp_of_two_and_top
    {α E : Type*} [MeasurableSpace α] [NormedAddCommGroup E]
    {μ : Measure α} {r : Real} (hr : 2 < r) (y : α → E)
    (hy2 : MemLp y 2 μ) (hyTop : MemLp y ⊤ μ) :
    MemLp y (ENNReal.ofReal r) μ := by
  let θ : Real := 1 - 2 / r
  have hθ0 : 0 < θ := by
    dsimp [θ]
    rw [sub_pos]
    exact (div_lt_one₀ (by linarith)).mpr (by linarith)
  have hθ1 : θ < 1 := by
    dsimp [θ]
    have : 0 < 2 / r := by positivity
    linarith
  apply Auto.Spherical.LpSpaceFacts.memLp_of_power_interpolation
    (P₀ := (2 : ENNReal)) (P₁ := ⊤)
    hθ0 hθ1 ?_ hy2 hyTop
  dsimp [θ]
  rw [show 1 - (1 - 2 / r) = 2 / r by ring]
  have hr0 : 0 < r := by linarith
  have hdiv0 : 0 < 2 / r := by positivity
  have hfirst : (2 / ENNReal.ofReal (2 / r))⁻¹ = (ENNReal.ofReal r)⁻¹ := by
    rw [ENNReal.inv_div (Or.inl ENNReal.ofReal_ne_top)
      (Or.inl (ENNReal.ofReal_pos.mpr hdiv0).ne')]
    rw [ENNReal.ofReal_div_of_pos hr0]
    simp only [ENNReal.div_eq_inv_mul]
    rw [show ENNReal.ofReal (2 : Real) = (2 : ENNReal) by norm_num]
    calc
      (2 : ENNReal)⁻¹ * ((ENNReal.ofReal r)⁻¹ * 2) =
          (ENNReal.ofReal r)⁻¹ * (2 * (2 : ENNReal)⁻¹) := by ring
      _ = (ENNReal.ofReal r)⁻¹ := by
        rw [ENNReal.mul_inv_cancel (by norm_num) (by norm_num), mul_one]
  have hsecond : (⊤ / ENNReal.ofReal (1 - 2 / r))⁻¹ = 0 := by
    rw [ENNReal.top_div]
    simp
  rw [hfirst, hsecond, add_zero]

/-- Every finite exponent above two contains the literal finite raw
convolution of a Schwartz input. -/
theorem memLp_rawFiniteIntDyadicMikhlinKernelOperator
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A r : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (hr : 2 < r) (f : SchwartzMap (Euclidean d) Complex) :
    MemLp (finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)) (ENNReal.ofReal r) volume := by
  let P : Euclidean d → Complex :=
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)
  let T : Lp Complex 2 (volume : Measure (Euclidean d)) :=
    rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume)
  have hPae : P =ᵐ[volume] (T : Euclidean d → Complex) := by
    dsimp [P, T]
    exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_ae_eq_l2
      C m K hA hM hNd f
  have hPtwo : MemLp P 2 volume :=
    MemLp.ae_eq hPae.symm (Lp.memLp T)
  have hPint : Integrable P volume := by
    dsimp [P]
    exact integrable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
      C m K hM hNd f
  have hPtop : MemLp P ⊤ volume :=
    memLp_top_of_bound hPint.aestronglyMeasurable
      ((∫ y : Euclidean d, ‖rawFiniteIntDyadicMikhlinKernel C m K y‖) *
        ‖f.toBoundedContinuousFunction‖)
      (Filter.Eventually.of_forall fun x => by
        dsimp [P]
        rw [rawFiniteMikhlin_finiteConvolutionKernelOperator_eq_convolution]
        exact norm_convolution_mul_le_integral_norm_mul_bound
          (rawFiniteIntDyadicMikhlinKernel C m K) (f : Euclidean d → Complex)
          (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K) f.continuous
          (fun y => BoundedContinuousFunction.norm_coe_le_norm
            f.toBoundedContinuousFunction y) x)
  exact rawFiniteMikhlin_memLp_of_two_and_top hr P hPtwo hPtop

private theorem rawFiniteMikhlin_continuous_fourierInv_of_integrable
    {d : Nat} (q : Euclidean d → Complex) (hq : Integrable q volume) :
    Continuous (fourierInv q) := by
  change Continuous (VectorFourier.fourierIntegral 𝐞 volume
    (-innerₗ (Euclidean d)) q)
  apply VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
  · change Continuous (fun p : Euclidean d × Euclidean d => -inner Real p.1 p.2)
    fun_prop
  · exact hq

/-- The literal finite raw kernel is continuous.  No uniformity in the
finite index set is needed for this qualitative fact. -/
theorem continuous_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) :
    Continuous (rawFiniteIntDyadicMikhlinKernel C m K) := by
  unfold rawFiniteIntDyadicMikhlinKernel
  refine continuous_finsetSum K ?_
  intro k hk
  apply rawFiniteMikhlin_continuous_fourierInv_of_integrable
  exact (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).1.continuous
    |>.integrable_of_hasCompactSupport
      (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hM).2

private theorem rawFiniteMikhlin_norm_fourierInv_le_integral_norm
    {d : Nat} (q : Euclidean d → Complex) (x : Euclidean d) :
    ‖fourierInv q x‖ ≤ ∫ y : Euclidean d, ‖q y‖ := by
  rw [Real.fourierInv_eq]
  calc
    ‖∫ y : Euclidean d, Real.fourierChar (inner Real y x) • q y‖ ≤
        ∫ y : Euclidean d, ‖Real.fourierChar (inner Real y x) • q y‖ :=
      norm_integral_le_integral_norm _
    _ = ∫ y : Euclidean d, ‖q y‖ := by
      apply integral_congr_ae
      filter_upwards with y
      simp

/-- A qualitative finite-set supremum bound for the raw kernel.  Its value
may depend on the finite index set, but the generic weak-one constant does
not, so this is exactly the continuity/boundedness input needed there. -/
noncomputable def rawFiniteIntDyadicMikhlinKernelBound
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int) : Real :=
  ∑ k ∈ K, ∫ xi : Euclidean d,
    ‖intDyadicBandpassMultiplier C.cutoff k xi * m xi‖

theorem norm_rawFiniteIntDyadicMikhlinKernel_le_kernelBound
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    (x : Euclidean d) :
    ‖rawFiniteIntDyadicMikhlinKernel C m K x‖ ≤
      rawFiniteIntDyadicMikhlinKernelBound C m K := by
  unfold rawFiniteIntDyadicMikhlinKernel rawFiniteIntDyadicMikhlinKernelBound
  calc
    ‖∑ k ∈ K, fourierInv
        (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ ≤
        ∑ k ∈ K, ‖fourierInv
          (fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi) x‖ :=
      norm_sum_le K _
    _ ≤ ∑ k ∈ K, ∫ xi : Euclidean d,
        ‖intDyadicBandpassMultiplier C.cutoff k xi * m xi‖ := by
      apply Finset.sum_le_sum
      intro k hk
      exact rawFiniteMikhlin_norm_fourierInv_le_integral_norm _ x

/-- `eLpNorm` form of the literal raw finite `L²` endpoint, for the central
branch of the all-exponent raw-core assembly. -/
theorem eLpNorm_two_rawFiniteIntDyadicMikhlinKernelOperator_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A) (hNd : d < N)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)) (ENNReal.ofReal (2 : Real)) volume ≤
      ENNReal.ofReal (4 * A) * eLpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal (2 : Real)) volume := by
  norm_num only [ENNReal.ofReal_ofNat]
  let P : Euclidean d → Complex :=
    finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
      (f : Euclidean d → Complex)
  let T : Lp Complex 2 (volume : Measure (Euclidean d)) :=
    rawFiniteIntDyadicMikhlinL2 C m K hA hM (f.toLp 2 volume)
  have hPae : P =ᵐ[volume] (T : Euclidean d → Complex) := by
    dsimp [P, T]
    exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_ae_eq_l2
      C m K hA hM hNd f
  have hP : MemLp P 2 volume := MemLp.ae_eq hPae.symm (Lp.memLp T)
  have hPtoLp : hP.toLp P = T := by
    apply Lp.ext
    filter_upwards [hP.coeFn_toLp, hPae] with x hxP hxAe
    rw [hxP, hxAe]
  have hbound : ‖hP.toLp P‖ ≤ (4 * A) * ‖f.toLp 2 volume‖ := by
    rw [hPtoLp]
    exact norm_rawFiniteIntDyadicMikhlinL2_le_four_mul C m K hA hM
      (f.toLp 2 volume)
  change eLpNorm P 2 volume ≤ ENNReal.ofReal (4 * A) *
    eLpNorm (f : Euclidean d → Complex) 2 volume
  have hright : ENNReal.ofReal (4 * A) *
      eLpNorm (f : Euclidean d → Complex) 2 volume ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top (f.memLp 2 volume).eLpNorm_ne_top
  apply (ENNReal.toReal_le_toReal hP.eLpNorm_ne_top hright).mp
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity),
    ← Lp.norm_toLp P hP,
    ← Lp.norm_toLp (f : Euclidean d → Complex) (f.memLp 2 volume)]
  exact hbound

/-- Complex conjugation preserves the dimension-generic Mikhlin condition
with exactly the same constant. -/
theorem mikhlinCondition_conj
    {d N : Nat} (m : Euclidean d → Complex) {A : Real}
    (hM : MikhlinCondition N m A) :
    MikhlinCondition N (fun xi => starRingEnd Complex (m xi)) A := by
  refine ⟨?_, ?_⟩
  · have hcomp : ContDiffOn Real N
        ((Complex.conjCLE : Complex → Complex) ∘ m) ({0}ᶜ : Set (Euclidean d)) :=
      (Complex.conjCLE.contDiff.contDiffOn.comp hM.1 (mapsTo_univ _ _))
    have heq : ((Complex.conjCLE : Complex → Complex) ∘ m) =
        fun xi : Euclidean d => starRingEnd Complex (m xi) := by
      funext xi
      exact Complex.conjCLE_apply (m xi)
    rw [← heq]
    exact hcomp
  · intro k hk xi hxi
    have hxi_mem : xi ∈ ({0}ᶜ : Set (Euclidean d)) := by
      simpa only [Set.mem_compl_iff, Set.mem_singleton_iff] using hxi
    have hlocal : ContDiffAt Real N m xi :=
      hM.1.contDiffAt
        ((isClosed_singleton.isOpen_compl.mem_nhds) hxi_mem)
    have hderiv :
        iteratedFDeriv Real k (fun z : Euclidean d => starRingEnd Complex (m z)) xi =
          Complex.conjCLE.toContinuousLinearMap.compContinuousMultilinearMap
            (iteratedFDeriv Real k m xi) := by
      rw [show (fun z : Euclidean d => starRingEnd Complex (m z)) =
        Complex.conjCLE.toContinuousLinearMap ∘ m by
          funext z
          exact (Complex.conjCLE_apply (m z)).symm]
      exact Complex.conjCLE.toContinuousLinearMap.iteratedFDeriv_comp_left hlocal
        (by exact_mod_cast hk)
    rw [hderiv]
    change ‖xi‖ ^ k *
      ‖Complex.conjLIE.toLinearIsometry.toContinuousLinearMap.compContinuousMultilinearMap
        (iteratedFDeriv Real k m xi)‖ ≤ A
    rw [LinearIsometry.norm_compContinuousMultilinearMap Complex.conjLIE.toLinearIsometry]
    exact hM.2 k hk xi hxi

/-- Additivity of the literal raw finite multiplier on the Schwartz core. -/
theorem rawFiniteIntDyadicMikhlinMultiplier_add
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f g : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    rawFiniteIntDyadicMikhlinMultiplier C m K (f + g) x =
      rawFiniteIntDyadicMikhlinMultiplier C m K f x +
        rawFiniteIntDyadicMikhlinMultiplier C m K g x := by
  rw [rawFiniteIntDyadicMikhlinMultiplier_eq_convolution C m K hM hNd (f + g) x,
    rawFiniteIntDyadicMikhlinMultiplier_eq_convolution C m K hM hNd f x,
    rawFiniteIntDyadicMikhlinMultiplier_eq_convolution C m K hM hNd g x]
  exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_add
    C m K hM hNd f g x

-- END FINITE SIGNED DYADIC CZ TAIL PACKAGE

-- END FINITE SIGNED DYADIC CZ TAIL PACKAGE
theorem HasFiniteConvolutionKernelCZTail_of_translation_bound
    {d : Nat} (K : Euclidean d → Complex) (hK : Integrable K volume)
    {B : Real} (_hB : 0 ≤ B)
    (htrans : ∀ h : Euclidean d,
      ∫ x : Euclidean d, ‖K (x + h) - K x‖ ≤ B) :
    HasFiniteConvolutionKernelCZTail K B := by
  intro f U hAtom hzero _hsupp
  have hqInt : ∀ q ∈ U, Integrable (fun x : Euclidean d =>
      ‖finiteConvolutionKernelOperator K
        (lacunaryCZDyadicCubeBadAtom f q) x‖) volume := by
    intro q hq
    simpa only [finiteConvolutionKernelOperator] using
      Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integrable_norm_kernel_convolution K hK
        (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq)
  have hqBound : ∀ q ∈ U,
      (∫ x : Euclidean d, ‖finiteConvolutionKernelOperator K
        (lacunaryCZDyadicCubeBadAtom f q) x‖) ≤
        B * ∫ y : Euclidean d, ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
    intro q hq
    simpa only [finiteConvolutionKernelOperator] using
      integral_norm_mean_zero_kernel_convolution_le_of_hormander K hK B htrans
        (lacunaryCZDyadicCubeBadAtom f q) (hAtom q hq) (hzero q hq)
        (lacunaryCZDyadicCubeCenter q)
  have hTailInt : Integrable (finiteConvolutionKernelBadTail K f U) volume := by
    unfold finiteConvolutionKernelBadTail
    exact integrable_finsetSum U hqInt
  refine ⟨hTailInt, ?_⟩
  have hset : (∫ x : Euclidean d in
      (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      finiteConvolutionKernelBadTail K f U x) ≤
      ∫ x : Euclidean d, finiteConvolutionKernelBadTail K f U x := by
    simpa only [Measure.restrict_univ] using
      (setIntegral_mono_set
        (s := (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ) (t := Set.univ)
        hTailInt.integrableOn
        (Filter.Eventually.of_forall fun x => by
          unfold finiteConvolutionKernelBadTail
          exact Finset.sum_nonneg fun q hq => norm_nonneg _)
        (Filter.Eventually.of_forall fun x => fun _ => Set.mem_univ x))
  calc
    (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      finiteConvolutionKernelBadTail K f U x) ≤
        ∫ x : Euclidean d, finiteConvolutionKernelBadTail K f U x := hset
    _ = ∑ q ∈ U, ∫ x : Euclidean d,
        ‖finiteConvolutionKernelOperator K
          (lacunaryCZDyadicCubeBadAtom f q) x‖ := by
          unfold finiteConvolutionKernelBadTail
          exact integral_finsetSum U hqInt
    _ ≤ ∑ q ∈ U, B * ∫ y : Euclidean d,
        ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
          exact Finset.sum_le_sum fun q hq => hqBound q hq
    _ = B * ∑ q ∈ U, ∫ y : Euclidean d,
        ‖lacunaryCZDyadicCubeBadAtom f q y‖ := by
          rw [Finset.mul_sum]

/-- Compact `C^N` Fourier symbols, with `N > d`, supply the complete
dimension-generic finite Calderón--Zygmund tail datum for their
inverse-Fourier kernels. -/
theorem compact_cN_fourierInv_hasFiniteConvolutionKernelCZTail
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) (hNd : d < N) :
    HasFiniteConvolutionKernelCZTail (𝓕⁻ ψ)
      ((2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
        (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖)) := by
  apply HasFiniteConvolutionKernelCZTail_of_translation_bound
  · exact compact_cN_fourierInv_integrable ψ hψ hψ_supp hNd
  · positivity
  · intro h
    exact integral_norm_sub_translate_compact_cN_fourierInv_le_hormander
      ψ hψ hψ_supp hNd h

/-- A raw Mikhlin symbol localized away from the origin has the literal
finite Calderón--Zygmund tail datum.  The displayed constant is qualitative;
the remaining scaling step of the full theorem is responsible for bounding
it uniformly across dyadic annuli. -/
theorem cutoff_mul_punctured_mikhlin_hasFiniteConvolutionKernelCZTail
    {d N : Nat} (χ m : Euclidean d → Complex) (r : Real) (hr : 0 < r)
    (hχ : ContDiff Real N χ) (hχ_supp : HasCompactSupport χ)
    (hχ_zero : ∀ x : Euclidean d, x ∈ Metric.ball 0 r → χ x = 0)
    {C : Real} (hm : MikhlinCondition N m C) (hNd : d < N) :
    HasFiniteConvolutionKernelCZTail
      (𝓕⁻ (fun x => χ x * m x))
      ((2 * (∫ x : Euclidean d, ‖𝓕⁻ (fun x => χ x * m x) x‖)) +
        (∫ x : Euclidean d,
          ‖fderiv Real (𝓕⁻ (fun x => χ x * m x)) x‖)) := by
  obtain ⟨hprod, hprod_supp⟩ :=
    contDiff_hasCompactSupport_cutoff_mul_punctured χ m r hr hχ hχ_supp
      hχ_zero hm.1
  exact compact_cN_fourierInv_hasFiniteConvolutionKernelCZTail
    (fun x => χ x * m x) hprod hprod_supp hNd

/-- The finite bad tail is pointwise nonnegative. -/
theorem finiteConvolutionKernelBadTail_nonneg {d : Nat}
    (K : Euclidean d → Complex) (f : Euclidean d → Complex)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) (x : Euclidean d) :
    0 ≤ finiteConvolutionKernelBadTail K f U x := by
  unfold finiteConvolutionKernelBadTail
  exact Finset.sum_nonneg fun q hq => norm_nonneg _

/-- Chebyshev converts an integrable exterior finite bad tail into the
weak-one distributional estimate used by the generic CZ assembly. -/
theorem finiteConvolutionKernelBadTail_weak_one_of_integral_bound {d : Nat}
    (K : Euclidean d → Complex) (f : Euclidean d → Complex)
    (U : Finset (LacunaryCZDyadicCubeIndex d)) {B a : Real}
    (_hB : 0 ≤ B) (_ha : 0 < a)
    (htailInt : Integrable (finiteConvolutionKernelBadTail K f U) volume)
    (htail : (∫ x : Euclidean d in (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ,
      finiteConvolutionKernelBadTail K f U x) ≤
      B * ∑ q ∈ U, ∫ x : Euclidean d,
        ‖lacunaryCZDyadicCubeBadAtom f q x‖) :
    ENNReal.ofReal a * volume
      ({x | a < finiteConvolutionKernelBadTail K f U x} ∩
        (lacunaryCZDyadicCubeExceptionalTriple U)ᶜ) ≤
      ENNReal.ofReal
        (B * ∑ q ∈ U, ∫ x : Euclidean d,
          ‖lacunaryCZDyadicCubeBadAtom f q x‖) := by
  let E : Set (Euclidean d) := lacunaryCZDyadicCubeExceptionalTriple U
  let T : Euclidean d → Real := finiteConvolutionKernelBadTail K f U
  have hTE : Integrable T (volume.restrict Eᶜ) := by
    dsimp only [T]
    exact htailInt.mono_measure Measure.restrict_le_self
  have hmarkov := mul_meas_ge_le_lintegral₀ hTE.1.aemeasurable.ennreal_ofReal
    (ENNReal.ofReal a)
  have hTnon : 0 ≤ᵐ[volume.restrict Eᶜ] T :=
    Filter.Eventually.of_forall fun x => finiteConvolutionKernelBadTail_nonneg K f U x
  have htailE : (∫⁻ x in Eᶜ, ENNReal.ofReal (T x)) ≤
      ENNReal.ofReal
        (B * ∑ q ∈ U, ∫ x : Euclidean d,
          ‖lacunaryCZDyadicCubeBadAtom f q x‖) := by
    calc
      (∫⁻ x in Eᶜ, ENNReal.ofReal (T x)) =
          ENNReal.ofReal (∫ x in Eᶜ, T x) :=
        (ofReal_integral_eq_lintegral_ofReal hTE hTnon).symm
      _ ≤ ENNReal.ofReal
          (B * ∑ q ∈ U, ∫ x : Euclidean d,
            ‖lacunaryCZDyadicCubeBadAtom f q x‖) :=
        ENNReal.ofReal_le_ofReal (by simpa only [E, T] using htail)
  have hsub : ({x | a < T x} ∩ Eᶜ) ⊆
      {x | ENNReal.ofReal a ≤ ENNReal.ofReal (T x)} ∩ Eᶜ := by
    intro x hx
    exact ⟨ENNReal.ofReal_le_ofReal hx.1.le, hx.2⟩
  calc
    ENNReal.ofReal a * volume ({x | a < T x} ∩ Eᶜ) ≤
        ENNReal.ofReal a *
          (volume.restrict Eᶜ)
            {x | ENNReal.ofReal a ≤ ENNReal.ofReal (T x)} := by
      apply mul_le_mul_right
      exact (measure_mono hsub).trans (Measure.le_restrict_apply Eᶜ _)
    _ ≤ ∫⁻ x, ENNReal.ofReal (T x) ∂(volume.restrict Eᶜ) := hmarkov
    _ = ∫⁻ x in Eᶜ, ENNReal.ofReal (T x) := rfl
    _ ≤ _ := htailE

/-- The `L²` part of the generic finite convolution Calderón--Zygmund
argument, in the scale-normalized form needed at a stopping height. -/
theorem finiteConvolutionKernel_good_level_ennreal {d : Nat}
    (K : Euclidean d → Complex) (C₂ : Real) (hC₂ : 0 ≤ C₂)
    (hL2 : HasFiniteConvolutionKernelGoodL2Bound K C₂)
    (g : Euclidean d → Complex) (hg : Integrable g volume)
    (hg₂ : MemLp g 2 volume) (B : Real) (hB : 0 ≤ B)
    (hgB : ∀ x, ‖g x‖ ≤ B) (a A F : ENNReal)
    (ha : a ≠ 0) (hatop : a ≠ ∞)
    (hlin : (∫⁻ x : Euclidean d, ENNReal.ofReal (‖g x‖ ^ (2 : Nat))) ≤
      A * a * F) :
    (2 * a) * volume {x | a.toReal <
      ‖finiteConvolutionKernelOperator K g x‖} ≤
      (2 * A * (ENNReal.ofReal C₂) ^ (2 : Nat)) * F := by
  obtain ⟨hTg, hTgbound⟩ := hL2 g hg hg₂ B hB hgB
  have hweak := weak_two_of_memLp_toLp_bound volume
    (fun u : Euclidean d → Complex => fun x : Euclidean d =>
      ‖finiteConvolutionKernelOperator K u x‖)
    (fun u x => norm_nonneg (finiteConvolutionKernelOperator K u x))
    C₂ hC₂ g hg₂ hTg hTgbound
    (show 0 < a.toReal by exact ENNReal.toReal_pos ha hatop)
  have haPow : a ^ (2 : Nat) = ENNReal.ofReal ((a.toReal) ^ (2 : Nat)) := by
    rw [ENNReal.ofReal_pow ENNReal.toReal_nonneg, ENNReal.ofReal_toReal hatop]
  have hCPow : (ENNReal.ofReal C₂) ^ (2 : Nat) =
      ENNReal.ofReal (C₂ ^ (2 : Nat)) := by
    rw [ENNReal.ofReal_pow hC₂]
  have hmain : a ^ (2 : Nat) * volume {x | a.toReal <
      ‖finiteConvolutionKernelOperator K g x‖} ≤
      (ENNReal.ofReal C₂) ^ (2 : Nat) * (A * a * F) := by
    calc
      a ^ (2 : Nat) * volume {x | a.toReal <
          ‖finiteConvolutionKernelOperator K g x‖} =
          ENNReal.ofReal ((a.toReal) ^ (2 : Nat)) * volume {x | a.toReal <
            ‖finiteConvolutionKernelOperator K g x‖} := by rw [haPow]
      _ ≤ (ENNReal.ofReal C₂) ^ (2 : Nat) *
          ∫⁻ x : Euclidean d, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)) := by
        rw [hCPow]
        exact hweak
      _ ≤ (ENNReal.ofReal C₂) ^ (2 : Nat) * (A * a * F) :=
        mul_le_mul_right hlin _
  rw [← ENNReal.mul_le_mul_iff_right ha hatop]
  calc
    a * ((2 * a) * volume {x | a.toReal <
        ‖finiteConvolutionKernelOperator K g x‖}) =
        2 * (a ^ (2 : Nat) * volume {x | a.toReal <
          ‖finiteConvolutionKernelOperator K g x‖}) := by ring
    _ ≤ 2 * ((ENNReal.ofReal C₂) ^ (2 : Nat) * (A * a * F)) :=
      mul_le_mul_right hmain _
    _ = a * ((2 * A * (ENNReal.ofReal C₂) ^ (2 : Nat)) * F) := by ring

/-- The explicit weak-one constant generated by the generic finite
convolution Calderón--Zygmund argument: exceptional cubes, the `L²` good
part, and the exterior mean-zero tail. -/
def finiteConvolutionKernelWeakOneConstant {d : Nat}
    (C₂ B : Real) : ENNReal :=
  2 * ENNReal.ofReal
      ((volume (Metric.ball (0 : Euclidean d) 1)).toReal *
        (3 : Real) ^ d * (d : Real) ^ d) +
    (2 * ENNReal.ofReal (3 * (2 : Real) ^ d) *
      (ENNReal.ofReal C₂) ^ (2 : Nat)) +
      2 * ENNReal.ofReal (2 * B)

/-- A generic finite convolution kernel is weak type `(1,1)` on Schwartz
inputs once it has the `L²` estimate needed for bounded Calderón--Zygmund
good parts and a summed exterior mean-zero atom-tail bound.  This theorem is
entirely independent of the spherical lacunary operator: the existing
dyadic-cube stopping decomposition supplies the geometry, while the two
displayed kernel data are its only analytic inputs. -/
theorem weak_one_finiteConvolutionKernel_of_goodL2_and_CZTail {d : Nat} [NeZero d]
    (K : Euclidean d → Complex) (hK : Continuous K) {C C₂ B : Real}
    (hKbound : ∀ z, ‖K z‖ ≤ C) (hC₂ : 0 ≤ C₂) (hB : 0 ≤ B)
    (hL2 : HasFiniteConvolutionKernelGoodL2Bound K C₂)
    (hTail : HasFiniteConvolutionKernelCZTail K B)
    (f : SchwartzMap (Euclidean d) Complex) {lambda : Real}
    (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x | lambda <
      ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ≤
      finiteConvolutionKernelWeakOneConstant (d := d) C₂ B *
        ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  have hf : Integrable (f : Euclidean d → Complex) volume := f.integrable
  obtain ⟨U, hdisj, hbad, houtside, havg, hgoodBound, hatomInt, hzero,
    hsupp, hsum, hgoodInt, hgoodL2, hL1, hside, hradius⟩ :=
    exists_lacunaryCZDyadicCube_continuous_decay_decomposition
      (f : Euclidean d → Complex) lambda hlambda f.continuous hf
      f.tendsto_cocompact
  obtain ⟨htailInt, htail⟩ := hTail (f : Euclidean d → Complex) U
    hatomInt hzero hsupp
  let E : Set (Euclidean d) := lacunaryCZDyadicCubeExceptionalTriple U
  let g : Euclidean d → Complex :=
    lacunaryCZDyadicCubeGoodPart (f : Euclidean d → Complex) U
  let aR : Real := lambda / 2
  let a : ENNReal := ENNReal.ofReal aR
  let A : ENNReal := ENNReal.ofReal (3 * (2 : Real) ^ d)
  let F : ENNReal := ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖
  let Bgood : Real := (2 : Real) ^ d * aR
  have haRpos : 0 < aR := by
    dsimp only [aR]
    linarith
  have haRnonneg : 0 ≤ aR := haRpos.le
  have haPos : 0 < a := by
    dsimp only [a]
    exact ENNReal.ofReal_pos.mpr haRpos
  have ha : a ≠ 0 := haPos.ne'
  have haTop : a ≠ ∞ := by
    dsimp only [a]
    exact ENNReal.ofReal_ne_top
  have hBgood : 0 ≤ Bgood := by
    dsimp only [Bgood]
    exact mul_nonneg (pow_nonneg (by norm_num) _) haRnonneg
  have hgB : ∀ x, ‖g x‖ ≤ Bgood := by
    intro x
    simpa only [g, Bgood, aR] using hgoodBound x
  have hg2 : MemLp g 2 volume := by
    apply (memLp_two_iff_integrable_sq_norm
      (by simpa only [g] using hgoodInt.aestronglyMeasurable)).2
    refine (hgoodInt.norm.const_mul Bgood).mono' ?_
      (Filter.Eventually.of_forall fun x => ?_)
    · exact hgoodInt.aestronglyMeasurable.norm.pow 2
    · have hpoint : ‖g x‖ ^ (2 : Nat) ≤ Bgood * ‖g x‖ := by
        calc
          ‖g x‖ ^ (2 : Nat) = ‖g x‖ * ‖g x‖ := by ring
          _ ≤ Bgood * ‖g x‖ :=
            mul_le_mul_of_nonneg_right (hgB x) (norm_nonneg _)
      simpa [Real.norm_eq_abs,
        abs_of_nonneg (mul_nonneg hBgood (norm_nonneg _))] using hpoint
  have hgSq : Integrable (fun x => ‖g x‖ ^ (2 : Nat)) volume := by
    simpa using hg2.integrable_norm_rpow (by norm_num) ENNReal.ofNat_ne_top
  have hFreal : ENNReal.ofReal (∫ x, ‖(f : Euclidean d → Complex) x‖) = F := by
    dsimp only [F]
    exact ofReal_integral_eq_lintegral_ofReal hf.norm
      (Filter.Eventually.of_forall fun x => norm_nonneg _)
  have hgoodLin : (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat))) ≤
      A * a * F := by
    calc
      (∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat))) =
          ENNReal.ofReal (∫ x, ‖g x‖ ^ (2 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hgSq
          (Filter.Eventually.of_forall fun x => sq_nonneg _)).symm
      _ ≤ ENNReal.ofReal ((3 * Bgood) * ∫ x,
          ‖(f : Euclidean d → Complex) x‖) :=
        ENNReal.ofReal_le_ofReal (by
          simpa only [g, Bgood, aR, mul_assoc] using hgoodL2)
      _ = A * a * F := by
        have hAreal : 0 ≤ 3 * (2 : Real) ^ d :=
          mul_nonneg (by norm_num) (pow_nonneg (by norm_num) _)
        rw [show 3 * Bgood = (3 * (2 : Real) ^ d) * aR by
          dsimp only [Bgood]
          ring,
          ENNReal.ofReal_mul (mul_nonneg hAreal haRnonneg),
          ENNReal.ofReal_mul hAreal, hFreal]
  have hgood := finiteConvolutionKernel_good_level_ennreal K C₂ hC₂ hL2
    g (by simpa only [g] using hgoodInt) hg2 Bgood hBgood hgB
    a A F ha haTop hgoodLin
  have hlambdaE : ENNReal.ofReal lambda = 2 * a := by
    rw [show lambda = 2 * aR by dsimp [aR]; ring,
      ENNReal.ofReal_mul (by norm_num)]
    norm_num [a]
  have hgood' : ENNReal.ofReal lambda * volume {x | lambda / 2 <
      ‖finiteConvolutionKernelOperator K g x‖} ≤
      (2 * A * (ENNReal.ofReal C₂) ^ (2 : Nat)) * F := by
    rw [hlambdaE]
    simpa only [a, ENNReal.toReal_ofReal haRnonneg] using hgood
  have hbad := finiteConvolutionKernelBadTail_weak_one_of_integral_bound
    K (f : Euclidean d → Complex) U hB haRpos htailInt htail
  have htailReal : B * (∑ q ∈ U, ∫ x : Euclidean d,
      ‖lacunaryCZDyadicCubeBadAtom (f : Euclidean d → Complex) q x‖) ≤
      (2 * B) * ∫ x, ‖(f : Euclidean d → Complex) x‖ := by
    calc
      B * (∑ q ∈ U, ∫ x : Euclidean d,
          ‖lacunaryCZDyadicCubeBadAtom (f : Euclidean d → Complex) q x‖) ≤
          B * (2 * ∫ x, ‖(f : Euclidean d → Complex) x‖) :=
        mul_le_mul_of_nonneg_left hL1 hB
      _ = (2 * B) * ∫ x, ‖(f : Euclidean d → Complex) x‖ := by ring
  have htailENN : ENNReal.ofReal
      (B * ∑ q ∈ U, ∫ x : Euclidean d,
        ‖lacunaryCZDyadicCubeBadAtom (f : Euclidean d → Complex) q x‖) ≤
      ENNReal.ofReal (2 * B) * F := by
    calc
      ENNReal.ofReal (B * ∑ q ∈ U, ∫ x : Euclidean d,
          ‖lacunaryCZDyadicCubeBadAtom (f : Euclidean d → Complex) q x‖) ≤
          ENNReal.ofReal ((2 * B) * ∫ x,
            ‖(f : Euclidean d → Complex) x‖) :=
        ENNReal.ofReal_le_ofReal htailReal
      _ = ENNReal.ofReal (2 * B) * F := by
        rw [ENNReal.ofReal_mul (mul_nonneg (by norm_num) hB), hFreal]
  have hbad' : ENNReal.ofReal lambda * volume
      ({x | lambda / 2 < finiteConvolutionKernelBadTail K
        (f : Euclidean d → Complex) U x} ∩ Eᶜ) ≤
      (2 * ENNReal.ofReal (2 * B)) * F := by
    rw [hlambdaE]
    calc
      (2 * a) * volume ({x | lambda / 2 < finiteConvolutionKernelBadTail K
          (f : Euclidean d → Complex) U x} ∩ Eᶜ) =
          2 * (a * volume ({x | aR < finiteConvolutionKernelBadTail K
            (f : Euclidean d → Complex) U x} ∩ Eᶜ)) := by
        rw [show lambda / 2 = aR by rfl]
        ring
      _ ≤ 2 * ENNReal.ofReal
          (B * ∑ q ∈ U, ∫ x : Euclidean d,
            ‖lacunaryCZDyadicCubeBadAtom (f : Euclidean d → Complex) q x‖) :=
        mul_le_mul_right hbad _
      _ ≤ 2 * (ENNReal.ofReal (2 * B) * F) :=
        mul_le_mul_of_nonneg_left htailENN (by positivity)
      _ = (2 * ENNReal.ofReal (2 * B)) * F := by ring
  let D : Real :=
    (volume (Metric.ball (0 : Euclidean d) 1)).toReal *
      (3 : Real) ^ d * (d : Real) ^ d
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hEreal : volume.real E ≤ D * aR⁻¹ *
      ∫ x, ‖(f : Euclidean d → Complex) x‖ := by
    calc
      volume.real E ≤
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (3 : Real) ^ d *
            ((d : Real) ^ d * (aR⁻¹ * ∫ x,
              ‖(f : Euclidean d → Complex) x‖)) := by
        simpa only [E, aR] using
          volume_real_lacunaryCZDyadicCubeExceptionalTriple_le_of_radius_sum U hradius
      _ = D * aR⁻¹ * ∫ x, ‖(f : Euclidean d → Complex) x‖ := by
        dsimp only [D]
        ring
  have hEtop : volume E ≠ ∞ := by
    let Q : LacunaryCZDyadicCubeIndex d → Set (Euclidean d) := fun q =>
      Metric.closedBall (lacunaryCZDyadicCubeCenter q)
        (3 * lacunaryCZDyadicCubeRadius q)
    have hmeasure : volume E ≤ ∑ q ∈ U, volume (Q q) := by
      simpa only [E, Q, lacunaryCZDyadicCubeExceptionalTriple] using
        (measure_biUnion_finset_le (μ := volume) U Q)
    have hsumlt : (∑ q ∈ U, volume (Q q)) < ∞ :=
      ENNReal.sum_lt_top.mpr fun q hq => measure_closedBall_lt_top
    exact (lt_of_le_of_lt hmeasure hsumlt).ne
  have hEupper : 0 ≤ D * aR⁻¹ * ∫ x,
      ‖(f : Euclidean d → Complex) x‖ :=
    mul_nonneg (mul_nonneg hD (inv_nonneg.mpr haRnonneg))
      (integral_nonneg fun _ => norm_nonneg _)
  have hEraw : volume E ≤ ENNReal.ofReal (D * aR⁻¹ * ∫ x,
      ‖(f : Euclidean d → Complex) x‖) := by
    apply (ENNReal.toReal_le_toReal hEtop ENNReal.ofReal_ne_top).mp
    simpa only [Measure.real, ENNReal.toReal_ofReal hEupper] using hEreal
  have hE : volume E ≤ ENNReal.ofReal D * a⁻¹ * F := by
    calc
      volume E ≤ ENNReal.ofReal (D * aR⁻¹ * ∫ x,
          ‖(f : Euclidean d → Complex) x‖) := hEraw
      _ = ENNReal.ofReal D * a⁻¹ * F := by
        rw [ENNReal.ofReal_mul (mul_nonneg hD (inv_nonneg.mpr haRnonneg)),
          ENNReal.ofReal_mul hD, ENNReal.ofReal_inv_of_pos haRpos, hFreal]
  have hE' : ENNReal.ofReal lambda * volume E ≤
      (2 * ENNReal.ofReal D) * F := by
    rw [hlambdaE]
    calc
      (2 * a) * volume E ≤ (2 * a) * (ENNReal.ofReal D * a⁻¹ * F) :=
        mul_le_mul_of_nonneg_left hE (by positivity)
      _ = (2 * ENNReal.ofReal D) * F := by
        rw [show 2 * a * (ENNReal.ofReal D * a⁻¹ * F) =
          (2 * ENNReal.ofReal D) * (a * a⁻¹) * F by ring,
          ENNReal.mul_inv_cancel ha haTop, mul_one]
  have hlevel := finiteConvolutionKernel_level_subset_good_union_badTail
    K hK (lambda := lambda) hKbound (f : Euclidean d → Complex) hf U E
  have hlevel' : {x | lambda <
      ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ⊆ E ∪
        ({x | lambda / 2 < ‖finiteConvolutionKernelOperator K g x‖} ∪
          ({x | lambda / 2 < finiteConvolutionKernelBadTail K
            (f : Euclidean d → Complex) U x} ∩ Eᶜ)) := by
    intro x hx
    by_cases hxE : x ∈ E
    · exact Or.inl hxE
    · exact Or.inr (hlevel ⟨hx, by simpa only [Set.mem_compl_iff] using hxE⟩)
  have hunion : volume {x | lambda <
      ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ≤
      volume E + (volume {x | lambda / 2 <
        ‖finiteConvolutionKernelOperator K g x‖} +
        volume ({x | lambda / 2 < finiteConvolutionKernelBadTail K
          (f : Euclidean d → Complex) U x} ∩ Eᶜ)) := by
    calc
      volume {x | lambda <
          ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ≤
          volume (E ∪ ({x | lambda / 2 <
            ‖finiteConvolutionKernelOperator K g x‖} ∪
              ({x | lambda / 2 < finiteConvolutionKernelBadTail K
                (f : Euclidean d → Complex) U x} ∩ Eᶜ))) := measure_mono hlevel'
      _ ≤ volume E + volume ({x | lambda / 2 <
          ‖finiteConvolutionKernelOperator K g x‖} ∪
            ({x | lambda / 2 < finiteConvolutionKernelBadTail K
              (f : Euclidean d → Complex) U x} ∩ Eᶜ)) := measure_union_le _ _
      _ ≤ volume E + (volume {x | lambda / 2 <
          ‖finiteConvolutionKernelOperator K g x‖} +
          volume ({x | lambda / 2 < finiteConvolutionKernelBadTail K
            (f : Euclidean d → Complex) U x} ∩ Eᶜ)) :=
        add_le_add le_rfl (measure_union_le _ _)
  calc
    ENNReal.ofReal lambda * volume {x | lambda <
        ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ≤
        ENNReal.ofReal lambda * (volume E +
          (volume {x | lambda / 2 < ‖finiteConvolutionKernelOperator K g x‖} +
          volume ({x | lambda / 2 < finiteConvolutionKernelBadTail K
            (f : Euclidean d → Complex) U x} ∩ Eᶜ))) :=
      mul_le_mul_right hunion _
    _ = ENNReal.ofReal lambda * volume E +
        (ENNReal.ofReal lambda * volume {x | lambda / 2 <
          ‖finiteConvolutionKernelOperator K g x‖} +
        ENNReal.ofReal lambda * volume ({x | lambda / 2 <
          finiteConvolutionKernelBadTail K (f : Euclidean d → Complex) U x} ∩ Eᶜ)) := by
      ring
    _ ≤ (2 * ENNReal.ofReal D) * F +
        ((2 * A * (ENNReal.ofReal C₂) ^ (2 : Nat)) * F +
        (2 * ENNReal.ofReal (2 * B)) * F) :=
      add_le_add hE' (add_le_add hgood' hbad')
    _ = finiteConvolutionKernelWeakOneConstant (d := d) C₂ B * F := by
      simp only [finiteConvolutionKernelWeakOneConstant, D, A]
      ring

/-- The literal raw finite convolution has a weak `(1,1)` bound.  The
displayed constant is independent of the finite scale set; the qualitative
kernel bound used internally drops out of the generic CZ estimate. -/
theorem weak_one_rawFiniteIntDyadicMikhlinKernel
    {d N : Nat} [NeZero d] (C : lpCutoffs d) (m : Euclidean d → Complex)
    (K : Finset Int) {A : Real} (hA : 0 ≤ A) (hM : MikhlinCondition N m A)
    (hNd : d < N) (f : SchwartzMap (Euclidean d) Complex) {lambda : Real}
    (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x | lambda <
      ‖finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x‖} ≤
      finiteConvolutionKernelWeakOneConstant (d := d) (4 * A)
        (rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A) *
        ∫⁻ x, ENNReal.ofReal ‖f x‖ := by
  exact weak_one_finiteConvolutionKernel_of_goodL2_and_CZTail
    (rawFiniteIntDyadicMikhlinKernel C m K)
    (continuous_rawFiniteIntDyadicMikhlinKernel C m K hM)
    (norm_rawFiniteIntDyadicMikhlinKernel_le_kernelBound C m K)
    (by positivity)
    (rawFiniteIntDyadicMikhlinKernelCZTailConstant_nonneg C hA)
    (hasFiniteConvolutionKernelGoodL2Bound_rawFiniteIntDyadicMikhlinKernel
      C m K hA hM hNd)
    (rawFiniteIntDyadicMikhlinKernel_hasFiniteConvolutionKernelCZTail
      C m hM hA hNd K)
    f hlambda

/-- The original strong literal-convolution `L²` datum is a convenient
special case of the bounded-good-part C--Z theorem. -/
theorem weak_one_finiteConvolutionKernel_of_L2_and_CZTail {d : Nat} [NeZero d]
    (K : Euclidean d → Complex) (hK : Continuous K) {C C₂ B : Real}
    (hKbound : ∀ z, ‖K z‖ ≤ C) (hC₂ : 0 ≤ C₂) (hB : 0 ≤ B)
    (hL2 : HasFiniteConvolutionKernelL2Bound K C₂)
    (hTail : HasFiniteConvolutionKernelCZTail K B)
    (f : SchwartzMap (Euclidean d) Complex) {lambda : Real}
    (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x | lambda <
      ‖finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x‖} ≤
      finiteConvolutionKernelWeakOneConstant (d := d) C₂ B *
        ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  exact weak_one_finiteConvolutionKernel_of_goodL2_and_CZTail K hK hKbound
    hC₂ hB hL2.to_good hTail f hlambda

/-- The generic C--Z weak endpoint applied to a finite signed integer-dyadic
multiplier.  This statement keeps the kernel tail datum explicit so it can be
reused for any uniform kernel construction. -/
theorem weak_one_finiteSignedIntegerDyadicMultiplier_of_CZTail
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) {B : Real} (hB : 0 ≤ B)
    (hTail : HasFiniteConvolutionKernelCZTail
      (finiteSignedIntegerDyadicBandpassKernel C K a) B)
    (f : SchwartzMap (Euclidean d) Complex) {lambda : Real} (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x | lambda <
      ‖finiteSignedIntegerDyadicMultiplierSchwartz C K a f x‖} ≤
      finiteConvolutionKernelWeakOneConstant (d := d) 4 B *
        ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  let kschwartz : SchwartzMap (Euclidean d) Complex :=
    finiteSignedIntegerDyadicMultiplierKernel C K a
  have hkernel : finiteSignedIntegerDyadicBandpassKernel C K a =
      (kschwartz : Euclidean d → Complex) := by
    funext x
    exact (finiteSignedIntegerDyadicMultiplierKernel_eq_bandpassKernel C K a x).symm
  have hcont : Continuous (finiteSignedIntegerDyadicBandpassKernel C K a) := by
    rw [hkernel]
    exact kschwartz.continuous
  have hbound : ∀ z, ‖finiteSignedIntegerDyadicBandpassKernel C K a z‖ ≤
      SchwartzMap.seminorm Complex 0 0 kschwartz := by
    intro z
    rw [hkernel]
    exact SchwartzMap.norm_le_seminorm Complex kschwartz z
  have hweak := weak_one_finiteConvolutionKernel_of_goodL2_and_CZTail
    (finiteSignedIntegerDyadicBandpassKernel C K a) hcont hbound
    (by norm_num : (0 : Real) ≤ 4) hB
    (hasFiniteConvolutionKernelGoodL2Bound_finiteSignedIntegerDyadicBandpassKernel
      C K a ha)
    hTail f hlambda
  have hpoint (x : Euclidean d) :
      finiteConvolutionKernelOperator (finiteSignedIntegerDyadicBandpassKernel C K a)
        (f : Euclidean d → Complex) x =
      finiteSignedIntegerDyadicMultiplierSchwartz C K a f x := by
    symm
    rw [finiteSignedIntegerDyadicMultiplierSchwartz_apply,
      finiteSignedIntegerDyadicMultiplier_eq_convolution_kernel,
      convolution_mul_swap]
    change (∫ y : Euclidean d,
      finiteSignedIntegerDyadicMultiplierKernel C K a (x - y) * f y) = _
    apply integral_congr_ae
    filter_upwards with y
    rw [finiteSignedIntegerDyadicMultiplierKernel_eq_bandpassKernel, mul_comm]
  simpa only [hpoint] using hweak

/-- The finite signed-dyadic C--Z tail constant is nonnegative. -/
theorem finiteSignedIntegerDyadicBandpassCZTailConstant_nonneg
    {d : Nat} (C : lpCutoffs d) :
    0 ≤ finiteSignedIntegerDyadicBandpassCZTailConstant C := by
  unfold finiteSignedIntegerDyadicBandpassCZTailConstant
  apply add_nonneg
  · apply mul_nonneg
    · exact mul_nonneg (by norm_num) (by positivity)
    · exact relativeSchwartzMultiplierKernelHormanderSize_nonneg _
  · unfold finiteSignedIntegerDyadicHighTailConstant
    have hseminorm : 0 ≤ SchwartzMap.seminorm Complex (d + 2) 0
        (fourierInv (integerDyadicBandpassPrototype C.cutoff)) :=
      apply_nonneg _ _
    have hmass : 0 ≤ surfaceMass d := measureReal_nonneg
    exact div_nonneg
      (mul_nonneg (mul_nonneg (mul_nonneg hseminorm (by norm_num)) hmass) (by positivity))
      (by positivity)

/-- Uniform weak type `(1,1)` for every finite signed integer-dyadic
multiplier.  The constant depends only on the cutoff family and the ambient
dimension, never on the finite set of scales or on the signs. -/
theorem weak_one_finiteSignedIntegerDyadicMultiplier
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1)
    (f : SchwartzMap (Euclidean d) Complex) {lambda : Real} (hlambda : 0 < lambda) :
    ENNReal.ofReal lambda * volume {x | lambda <
      ‖finiteSignedIntegerDyadicMultiplierSchwartz C K a f x‖} ≤
      finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C) *
        ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  exact weak_one_finiteSignedIntegerDyadicMultiplier_of_CZTail C K a ha
    (finiteSignedIntegerDyadicBandpassCZTailConstant_nonneg C)
    (finiteSignedIntegerDyadicBandpassKernel_hasFiniteConvolutionKernelCZTail C K a ha)
    f hlambda

private theorem finiteConvolutionKernelWeakOneConstant_ne_top
    {d : Nat} (C₂ B : Real) :
    finiteConvolutionKernelWeakOneConstant (d := d) C₂ B ≠ ∞ := by
  dsimp [finiteConvolutionKernelWeakOneConstant]
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.add_ne_top.mpr
    constructor
    · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top

/-- Lower-range strong type for a finite signed dyadic multiplier from an
explicit uniform C--Z tail.  This is valid in every positive dimension and
for every `1 < p < 2`. -/
theorem lowerLp_finiteSignedIntegerDyadicMultiplier_of_CZTail
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) {B : Real} (hB : 0 ≤ B)
    (hTail : HasFiniteConvolutionKernelCZTail
      (finiteSignedIntegerDyadicBandpassKernel C K a) B)
    {p : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
      Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      (weakOneSquareMomentCoefficient p
        (finiteConvolutionKernelWeakOneConstant (d := d) 4 B) 16) ^ p⁻¹ *
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let S : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex :=
    fun g => finiteSignedIntegerDyadicMultiplierSchwartz C K a g
  let C₁ : ENNReal := finiteConvolutionKernelWeakOneConstant (d := d) 4 B
  have hSadd : ∀ (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      S (g + h) x = S g x + S h x := by
    intro g h x
    simp only [S]
    exact congrArg (fun q : SchwartzMap (Euclidean d) Complex => q x)
      (map_add (finiteSignedIntegerDyadicMultiplierSchwartz C K a) g h)
  have hSmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (S g) volume := by
    intro g
    simpa only [S] using
      (finiteSignedIntegerDyadicMultiplierSchwartz C K a g).continuous.aestronglyMeasurable
  have hC₁top : C₁ ≠ ∞ := by
    exact finiteConvolutionKernelWeakOneConstant_ne_top 4 B
  have hweak : ∀ (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖S g x‖} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖ := by
    intro g s hs
    simpa only [S, C₁] using
      (weak_one_finiteSignedIntegerDyadicMultiplier_of_CZTail
        C K a ha hB hTail g hs)
  have hsquare : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, ENNReal.ofReal (‖S g x‖ ^ (2 : Nat))) ≤
        (16 : ENNReal) * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)) := by
    intro g
    simpa only [S, ENNReal.ofReal_ofNat] using
      (lintegral_norm_sq_finiteSignedIntegerDyadicMultiplierSchwartz_le C K a ha g)
  exact (lowerLp_of_schwartz_additive_weak_one_square S hSadd hSmeas C₁ 16
    hC₁top (by norm_num) hweak hsquare hp1 hp2 f).2

/-- Unconditional lower-exponent signed-dyadic multiplier estimate.  Its
constant is uniform in both the finite scale set and the coefficients. -/
theorem lowerLp_finiteSignedIntegerDyadicMultiplier
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) {p : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
      Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      (weakOneSquareMomentCoefficient p
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C)) 16) ^ p⁻¹ *
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  exact lowerLp_finiteSignedIntegerDyadicMultiplier_of_CZTail C K a ha
    (finiteSignedIntegerDyadicBandpassCZTailConstant_nonneg C)
    (finiteSignedIntegerDyadicBandpassKernel_hasFiniteConvolutionKernelCZTail C K a ha)
    hp1 hp2 f

/-- The Plancherel endpoint in `eLpNorm` form. -/
theorem eLpNorm_two_finiteSignedIntegerDyadicMultiplier
    {d : Nat} (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
      Euclidean d → Complex) (ENNReal.ofReal (2 : Real)) volume ≤
      ENNReal.ofReal 4 * eLpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal (2 : Real)) volume := by
  norm_num only [ENNReal.ofReal_ofNat]
  let T : SchwartzMap (Euclidean d) Complex :=
    finiteSignedIntegerDyadicMultiplierSchwartz C K a f
  let hT : MemLp (T : Euclidean d → Complex) 2 volume := T.memLp 2 volume
  let hf : MemLp (f : Euclidean d → Complex) 2 volume := f.memLp 2 volume
  have hsqraw := integral_norm_sq_finiteSignedIntegerDyadicMultiplier_le C K a ha f
  have hsq : (∫ x : Euclidean d, ‖T x‖ ^ (2 : Nat)) ≤
      16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
    calc
      (∫ x : Euclidean d, ‖T x‖ ^ (2 : Nat)) =
          ∫ x : Euclidean d,
            ‖finiteSignedIntegerDyadicMultiplier C K a f x‖ ^ (2 : Nat) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [show T x = finiteSignedIntegerDyadicMultiplierSchwartz C K a f x by rfl,
                finiteSignedIntegerDyadicMultiplierSchwartz_apply]
      _ ≤ 16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := hsqraw
  have hnorm : ‖hT.toLp (T : Euclidean d → Complex)‖ ≤
      4 * ‖hf.toLp (f : Euclidean d → Complex)‖ := by
    rw [norm_toLp_two_eq_sqrt_integral_norm_sq_general volume T hT,
      norm_toLp_two_eq_sqrt_integral_norm_sq_general volume f hf]
    calc
      √(∫ x : Euclidean d, ‖T x‖ ^ (2 : Nat)) ≤
          √(16 * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) :=
        Real.sqrt_le_sqrt hsq
      _ = 4 * √(∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat)) := by
        rw [Real.sqrt_mul (by norm_num : (0 : Real) ≤ 16)]
        have h16 : √(16 : Real) = 4 := by
          rw [show (16 : Real) = 4 ^ (2 : Nat) by norm_num,
            Real.sqrt_sq_eq_abs]
          norm_num
        rw [h16]
  change eLpNorm (T : Euclidean d → Complex) 2 volume ≤
    (4 : ENNReal) * eLpNorm (f : Euclidean d → Complex) 2 volume
  have hright : (4 : ENNReal) *
      eLpNorm (f : Euclidean d → Complex) 2 volume ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.coe_ne_top hf.eLpNorm_ne_top
  apply (ENNReal.toReal_le_toReal hT.eLpNorm_ne_top hright).mp
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofNat,
    ← Lp.norm_toLp (T : Euclidean d → Complex) hT,
    ← Lp.norm_toLp (f : Euclidean d → Complex) hf]
  exact hnorm

/-- Upper-range strong type for a finite signed dyadic multiplier, obtained
by applying the lower-range result to its literal formal adjoint. -/
theorem upperLp_finiteSignedIntegerDyadicMultiplier
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) {p : Real} (hp : 2 < p)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
      Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      (weakOneSquareMomentCoefficient p.conjExponent
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant (conjugateLpCutoffs C)))
        16) ^ (p.conjExponent)⁻¹ *
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let q : Real := p.conjExponent
  let Cstar : lpCutoffs d := conjugateLpCutoffs C
  let astar : Int → Complex := fun k => starRingEnd Complex (a k)
  let L : ENNReal :=
    (weakOneSquareMomentCoefficient q
      (finiteConvolutionKernelWeakOneConstant (d := d) 4
        (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar)) 16) ^ q⁻¹
  have hp1 : 1 < p := by linarith
  have hpden : 0 < p - 1 := by linarith
  have hq1 : 1 < q := by
    rw [show q = p / (p - 1) by rfl]
    rw [lt_div_iff₀ hpden]
    linarith
  have hq2 : q < 2 := by
    rw [show q = p / (p - 1) by rfl]
    rw [div_lt_iff₀ hpden]
    linarith
  have hastar : ∀ k ∈ K, ‖astar k‖ ≤ 1 := by
    intro k hk
    simpa only [astar, starRingEnd_apply, norm_star] using ha k hk
  have hWtop : weakOneSquareMomentCoefficient q
      (finiteConvolutionKernelWeakOneConstant (d := d) 4
        (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar)) 16 ≠ ∞ :=
    weakOneSquareMomentCoefficient_ne_top hq1 hq2
      (finiteConvolutionKernelWeakOneConstant_ne_top 4
        (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar))
      (by norm_num)
  have hLtop : L ≠ ∞ := by
    dsimp [L]
    exact ENNReal.rpow_ne_top_of_nonneg
      (by positivity) hWtop
  have hA : 0 ≤ L.toReal := ENNReal.toReal_nonneg
  have hTstar (g : SchwartzMap (Euclidean d) Complex) :
      eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz Cstar K astar g :
        Euclidean d → Complex) (ENNReal.ofReal p.conjExponent) volume ≤
        ENNReal.ofReal L.toReal * eLpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    have hlow : eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz Cstar K astar g :
        Euclidean d → Complex) (ENNReal.ofReal q) volume ≤
        L * eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal q) volume := by
      simpa only [L] using
        (lowerLp_finiteSignedIntegerDyadicMultiplier
          Cstar K astar hastar hq1 hq2 g)
    rw [ENNReal.ofReal_toReal hLtop]
    simpa only [q] using hlow
  have hpair : ∀ u v : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d,
        finiteSignedIntegerDyadicMultiplierSchwartz C K a u x *
          starRingEnd Complex (v x)) =
        ∫ x : Euclidean d, u x * starRingEnd Complex
          (finiteSignedIntegerDyadicMultiplierSchwartz Cstar K astar v x) := by
    intro u v
    simpa only [Cstar, astar] using
      (integral_finiteSignedIntegerDyadicMultiplier_mul_star_eq C K a u v)
  have hupper := eLpNorm_schwartzCore_le_of_formalAdjoint_lower hp hA
    (finiteSignedIntegerDyadicMultiplierSchwartz C K a)
    (finiteSignedIntegerDyadicMultiplierSchwartz Cstar K astar)
    hpair hTstar f
  rw [ENNReal.ofReal_toReal hLtop] at hupper
  simpa only [L, q, Cstar] using hupper

/-- Full dimension-generic strong `Lᵖ` conclusion for finite signed dyadic
multipliers.  The finite coefficient depends only on the ambient cutoff datum
and exponent, never on the selected scales or their coefficients. -/
theorem exists_strongLp_finiteSignedIntegerDyadicMultiplier
    {d : Nat} [NeZero d] (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex)
    (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) {p : Real} (hp1 : 1 < p) :
    ∃ A : ENNReal, A ≠ ∞ ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
        Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
        A * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  rcases lt_trichotomy p 2 with hp2 | hp2 | hp2
  · let A : ENNReal :=
      (weakOneSquareMomentCoefficient p
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C)) 16) ^ p⁻¹
    refine ⟨A, ?_, ?_⟩
    · dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hp1 hp2
        (finiteConvolutionKernelWeakOneConstant_ne_top 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C))
        (by norm_num)
    · intro f
      simpa only [A] using
        (lowerLp_finiteSignedIntegerDyadicMultiplier C K a ha hp1 hp2 f)
  · subst p
    refine ⟨(4 : ENNReal), ENNReal.coe_ne_top, ?_⟩
    intro f
    simpa only [ENNReal.ofReal_ofNat] using
      (eLpNorm_two_finiteSignedIntegerDyadicMultiplier C K a ha f)
  · let Cstar : lpCutoffs d := conjugateLpCutoffs C
    let q : Real := p.conjExponent
    let A : ENNReal :=
      (weakOneSquareMomentCoefficient q
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar)) 16) ^ q⁻¹
    have hpden : 0 < p - 1 := by linarith
    have hq1 : 1 < q := by
      rw [show q = p / (p - 1) by rfl]
      rw [lt_div_iff₀ hpden]
      linarith
    have hq2 : q < 2 := by
      rw [show q = p / (p - 1) by rfl]
      rw [div_lt_iff₀ hpden]
      linarith
    refine ⟨A, ?_, ?_⟩
    · dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hq1 hq2
        (finiteConvolutionKernelWeakOneConstant_ne_top 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar))
        (by norm_num)
    · intro f
      simpa only [A, q, Cstar] using
        (upperLp_finiteSignedIntegerDyadicMultiplier C K a ha hp2 f)

/-- A uniform form of the finite signed dyadic strong `Lᵖ` bound.  In
particular, its coefficient is independent of both the selected finite set of
scales and their unit-bounded coefficients. -/
theorem exists_uniform_strongLp_finiteSignedIntegerDyadicMultiplier
    {d : Nat} [NeZero d] (C : lpCutoffs d) {p : Real} (hp1 : 1 < p) :
    ∃ A : ENNReal, A ≠ ∞ ∧ ∀ (K : Finset Int) (a : Int → Complex)
      (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex),
      eLpNorm (finiteSignedIntegerDyadicMultiplierSchwartz C K a f :
        Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
        A * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  rcases lt_trichotomy p 2 with hp2 | hp2 | hp2
  · let A : ENNReal :=
      (weakOneSquareMomentCoefficient p
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C)) 16) ^ p⁻¹
    refine ⟨A, ?_, ?_⟩
    · dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hp1 hp2
        (finiteConvolutionKernelWeakOneConstant_ne_top 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant C))
        (by norm_num)
    · intro K a ha f
      simpa only [A] using
        (lowerLp_finiteSignedIntegerDyadicMultiplier C K a ha hp1 hp2 f)
  · subst p
    refine ⟨(4 : ENNReal), ENNReal.coe_ne_top, ?_⟩
    intro K a ha f
    simpa only [ENNReal.ofReal_ofNat] using
      (eLpNorm_two_finiteSignedIntegerDyadicMultiplier C K a ha f)
  · let Cstar : lpCutoffs d := conjugateLpCutoffs C
    let q : Real := p.conjExponent
    let A : ENNReal :=
      (weakOneSquareMomentCoefficient q
        (finiteConvolutionKernelWeakOneConstant (d := d) 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar)) 16) ^ q⁻¹
    have hpden : 0 < p - 1 := by linarith
    have hq1 : 1 < q := by
      rw [show q = p / (p - 1) by rfl]
      rw [lt_div_iff₀ hpden]
      linarith
    have hq2 : q < 2 := by
      rw [show q = p / (p - 1) by rfl]
      rw [div_lt_iff₀ hpden]
      linarith
    refine ⟨A, ?_, ?_⟩
    · dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hq1 hq2
        (finiteConvolutionKernelWeakOneConstant_ne_top 4
          (finiteSignedIntegerDyadicBandpassCZTailConstant Cstar))
        (by norm_num)
    · intro K a ha f
      simpa only [A, q, Cstar] using
        (upperLp_finiteSignedIntegerDyadicMultiplier C K a ha hp2 f)

private theorem schwartz_integral_norm_rpow_eq_eLpNorm_toReal_rpow
    {d : Nat} (f : SchwartzMap (Euclidean d) Complex) {p : Real} (hp : 0 < p) :
    (∫ x : Euclidean d, ‖f x‖ ^ p) =
      (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume).toReal ^ p := by
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  have hpENT : ENNReal.ofReal p ≠ ∞ := ENNReal.ofReal_ne_top
  have hmem : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have hint : Integrable (fun x : Euclidean d => ‖f x‖ ^ p) volume := by
    have h := hmem.integrable_norm_rpow hpEN0 hpENT
    simpa only [ENNReal.toReal_ofReal hp.le] using h
  have hlin : (∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p) =
      (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) ^ p :=
    lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow hp (f : Euclidean d → Complex)
  have hof : (∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p) =
      ENNReal.ofReal (∫ x : Euclidean d, ‖f x‖ ^ p) := by
    calc
      (∫⁻ x : Euclidean d, (ENNReal.ofReal ‖f x‖) ^ p) =
          ∫⁻ x : Euclidean d, ENNReal.ofReal (‖f x‖ ^ p) := by
            apply lintegral_congr
            intro x
            exact ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le
      _ = ENNReal.ofReal (∫ x : Euclidean d, ‖f x‖ ^ p) :=
        (ofReal_integral_eq_lintegral_ofReal hint
          (Filter.Eventually.of_forall fun x =>
            Real.rpow_nonneg (norm_nonneg _) p)).symm
  have hnonneg : 0 ≤ ∫ x : Euclidean d, ‖f x‖ ^ p :=
    integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _
  have h := congrArg ENNReal.toReal (hof.symm.trans hlin)
  simpa only [ENNReal.toReal_ofReal hnonneg, ENNReal.toReal_rpow] using h

private theorem schwartz_integral_norm_rpow_le_of_eLpNorm_le
    {d : Nat} {p : Real} (hp : 0 < p) {A : ENNReal} (hAtop : A ≠ ∞)
    (f g : SchwartzMap (Euclidean d) Complex)
    (hbound : eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal p) volume ≤
      A * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) :
    Integrable (fun x : Euclidean d => ‖g x‖ ^ p) volume ∧
      (∫ x : Euclidean d, ‖g x‖ ^ p) ≤
        (A.toReal ^ p + 1) * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp
  have hpENT : ENNReal.ofReal p ≠ ∞ := ENNReal.ofReal_ne_top
  have hf : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp (ENNReal.ofReal p) volume
  have hg : MemLp (g : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    g.memLp (ENNReal.ofReal p) volume
  have hgint : Integrable (fun x : Euclidean d => ‖g x‖ ^ p) volume := by
    have h := hg.integrable_norm_rpow hpEN0 hpENT
    simpa only [ENNReal.toReal_ofReal hp.le] using h
  refine ⟨hgint, ?_⟩
  have hright : A * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top hAtop hf.eLpNorm_ne_top
  have hreal :
      (eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal p) volume).toReal ≤
        A.toReal * (eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal p) volume).toReal := by
    calc
      (eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal p) volume).toReal ≤
          (A * eLpNorm (f : Euclidean d → Complex)
            (ENNReal.ofReal p) volume).toReal :=
              (ENNReal.toReal_le_toReal hg.eLpNorm_ne_top hright).mpr hbound
      _ = A.toReal * (eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal p) volume).toReal := ENNReal.toReal_mul
  have hrpow := Real.rpow_le_rpow ENNReal.toReal_nonneg hreal hp.le
  have hNfpow : 0 ≤
      (eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume).toReal ^ p :=
    Real.rpow_nonneg ENNReal.toReal_nonneg p
  rw [schwartz_integral_norm_rpow_eq_eLpNorm_toReal_rpow g hp,
    schwartz_integral_norm_rpow_eq_eLpNorm_toReal_rpow f hp]
  calc
    (eLpNorm (g : Euclidean d → Complex) (ENNReal.ofReal p) volume).toReal ^ p ≤
        (A.toReal * (eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal p) volume).toReal) ^ p := hrpow
    _ = A.toReal ^ p *
        (eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal p) volume).toReal ^ p := by
          rw [Real.mul_rpow ENNReal.toReal_nonneg ENNReal.toReal_nonneg]
    _ ≤ (A.toReal ^ p + 1) *
        (eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal p) volume).toReal ^ p := by
          apply mul_le_mul_of_nonneg_right
          · linarith
          · exact hNfpow

/-- A Rademacher-sign finite square-function sum is the corresponding finite
signed dyadic multiplier. -/
theorem finiteRademacherIntegerDyadicSum_eq_signedMultiplier
    {d : Nat} (C : lpCutoffs d) (K u : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    finiteRademacherIntegerDyadicSum C K u f x =
      finiteSignedIntegerDyadicMultiplierSchwartz C K
        (fun k => rademacherSign u k) f x := by
  rw [finiteSignedIntegerDyadicMultiplierSchwartz_apply,
    finiteSignedIntegerDyadicMultiplier_eq_sum_integerDyadicProjection]
  simp only [finiteRademacherIntegerDyadicSum, rademacherSignedSum]

/-- Every finite Rademacher sign has unit modulus. -/
theorem rademacherSign_norm_le_one {I : Type*} [DecidableEq I]
    (u : Finset I) (i : I) : ‖rademacherSign u i‖ ≤ (1 : Real) := by
  by_cases hi : i ∈ u <;> simp [rademacherSign, hi]

/-- The uniform signed-dyadic strong bound in real moment form.  This is the
direct input for the all-`Lᵖ` Littlewood--Paley Rademacher reduction. -/
theorem exists_uniform_signed_dyadic_moment_bound
    {d : Nat} [NeZero d] (C : lpCutoffs d) {p : Real} (hp : 1 < p) :
    ∃ B : Real, 0 < B ∧ ∀ (K : Finset Int) (a : Int → Complex)
      (ha : ∀ k ∈ K, ‖a k‖ ≤ 1) (f : SchwartzMap (Euclidean d) Complex),
      Integrable (fun x : Euclidean d =>
        ‖finiteSignedIntegerDyadicMultiplierSchwartz C K a f x‖ ^ p) volume ∧
        (∫ x : Euclidean d,
          ‖finiteSignedIntegerDyadicMultiplierSchwartz C K a f x‖ ^ p) ≤
          B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  rcases exists_uniform_strongLp_finiteSignedIntegerDyadicMultiplier C hp with
    ⟨A, hAtop, hstrong⟩
  refine ⟨A.toReal ^ p + 1, by positivity, ?_⟩
  intro K a ha f
  exact schwartz_integral_norm_rpow_le_of_eLpNorm_le
    (by linarith) hAtop f
    (finiteSignedIntegerDyadicMultiplierSchwartz C K a f)
    (hstrong K a ha f)

/-- Output-valued Schwartz-core upper-exponent duality.  Unlike the bundled
Schwartz version, this only asks that the two raw core outputs belong to the
relevant `Lᵖ` spaces.  It is therefore suited to finite `Cᴺ` Fourier kernels,
whose convolutions need not themselves be Schwartz. -/
private theorem lpNorm_rawCoreOutput_le_of_formalAdjoint_lower
    {d : Nat} {p A : Real} (hp : 2 < p) (hA : 0 ≤ A)
    (T Tstar : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hTmem : ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (T f) (ENNReal.ofReal p) volume)
    (hTstarmem : ∀ g : SchwartzMap (Euclidean d) Complex,
      MemLp (Tstar g) (ENNReal.ofReal p.conjExponent) volume)
    (hpair : ∀ f g : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, T f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar g x))
    (hTstar : ∀ g : SchwartzMap (Euclidean d) Complex,
      lpNorm (Tstar g) (ENNReal.ofReal p.conjExponent) volume ≤
        A * lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume)
    (f : SchwartzMap (Euclidean d) Complex) :
    lpNorm (T f) (ENNReal.ofReal p) volume ≤
      A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  letI : Fact (1 ≤ ENNReal.ofReal p) :=
    ⟨by rw [← ENNReal.ofReal_one]; exact ENNReal.ofReal_le_ofReal hp1.le⟩
  letI : Fact (1 ≤ ENNReal.ofReal p.conjExponent) :=
    ⟨one_le_ofReal_conjExponent p hp1⟩
  letI : ENNReal.HolderConjugate (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) :=
    ofReal_holderConjugate p hp1
  have hholder (u : SchwartzMap (Euclidean d) Complex)
      (v : Euclidean d → Complex)
      (hv : MemLp v (ENNReal.ofReal p.conjExponent) volume) :
      ‖∫ x : Euclidean d, u x * starRingEnd Complex (v x)‖ ≤
        lpNorm (u : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          lpNorm v (ENNReal.ofReal p.conjExponent) volume := by
    let hu : MemLp (u : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
      u.memLp _ volume
    let hsv : MemLp (fun x : Euclidean d => starRingEnd Complex (v x))
        (ENNReal.ofReal p.conjExponent) volume :=
      hv.congr_norm
        (Complex.continuous_conj.comp_aestronglyMeasurable hv.1)
        (Filter.Eventually.of_forall fun x => (Complex.norm_conj (v x)).symm)
    have henorm := enorm_integral_mul_le_eLpNorm_p_pconj_mul
      hp1 (u : Euclidean d → Complex) (fun x => starRingEnd Complex (v x)) hu hsv
    have hright :
        eLpNorm (u : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          eLpNorm (fun x => starRingEnd Complex (v x))
            (ENNReal.ofReal p.conjExponent) volume ≠ ∞ :=
      ENNReal.mul_ne_top hu.2.ne hsv.2.ne
    have hreal := (ENNReal.toReal_le_toReal ENNReal.coe_ne_top hright).mpr henorm
    change ‖∫ x : Euclidean d, u x * starRingEnd Complex (v x)‖ ≤ _ at hreal
    rw [ENNReal.toReal_mul, toReal_eLpNorm hu.1,
      toReal_eLpNorm hsv.1] at hreal
    have hstar_norm :
        lpNorm (fun x : Euclidean d => starRingEnd Complex (v x))
          (ENNReal.ofReal p.conjExponent) volume =
        lpNorm v (ENNReal.ofReal p.conjExponent) volume := by
      rw [← toReal_eLpNorm hsv.1, ← toReal_eLpNorm hv.1]
      apply congrArg ENNReal.toReal
      apply eLpNorm_congr_norm_ae
      exact Filter.Eventually.of_forall fun x => Complex.norm_conj (v x)
    simpa only [hstar_norm] using hreal
  let y : Euclidean d → Complex := T f
  let hy : MemLp y (ENNReal.ofReal p) volume := hTmem f
  let Φ : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d)) →L[Complex] Complex :=
    (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
      (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
      (hy.toLp y)
  have hconjugate_lp (g : SchwartzMap (Euclidean d) Complex) :
      lpNorm (conjugateSchwartz g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume =
        lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    rw [← toReal_eLpNorm (conjugateSchwartz g).continuous.aestronglyMeasurable,
      ← toReal_eLpNorm g.continuous.aestronglyMeasurable]
    congr 1
    apply eLpNorm_congr_norm_ae
    exact Filter.Eventually.of_forall fun x => by
      rw [conjugateSchwartz_apply, Complex.norm_conj]
  have hnorm_toLp (g : SchwartzMap (Euclidean d) Complex) :
      ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ =
        lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    rw [SchwartzMap.norm_toLp, toReal_eLpNorm g.continuous.aestronglyMeasurable]
  have hΦ_schwartz (g : SchwartzMap (Euclidean d) Complex) :
      ‖Φ (g.toLp (ENNReal.ofReal p.conjExponent) volume)‖ ≤
        (A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) *
          ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ := by
    have hraw : Φ (g.toLp (ENNReal.ofReal p.conjExponent) volume) =
        ∫ x : Euclidean d, T f x * g x := by
      rw [show Φ =
        (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
          (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
          (hy.toLp y) by rfl,
        lpPairing_apply_toLp_eq_integral hy]
      apply integral_congr_ae
      filter_upwards [g.coeFn_toLp (ENNReal.ofReal p.conjExponent) volume] with x hx
      rw [hx]
    rw [hraw]
    calc
      ‖∫ x : Euclidean d, T f x * g x‖ =
          ‖∫ x : Euclidean d, T f x *
            starRingEnd Complex (conjugateSchwartz g x)‖ := by
            congr 1
            apply integral_congr_ae
            filter_upwards with x
            rw [conjugateSchwartz_apply]
            simp
      _ = ‖∫ x : Euclidean d, f x * starRingEnd Complex
          (Tstar (conjugateSchwartz g) x)‖ := by
            rw [hpair f (conjugateSchwartz g)]
      _ ≤ lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          lpNorm (Tstar (conjugateSchwartz g))
            (ENNReal.ofReal p.conjExponent) volume :=
          hholder f (Tstar (conjugateSchwartz g)) (hTstarmem (conjugateSchwartz g))
      _ ≤ lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume *
          (A * lpNorm (conjugateSchwartz g : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume) := by
            exact mul_le_mul_of_nonneg_left (hTstar (conjugateSchwartz g))
              lpNorm_nonneg
      _ = (A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) *
          ‖g.toLp (ENNReal.ofReal p.conjExponent) volume‖ := by
            rw [hconjugate_lp g, hnorm_toLp g]
            ring
  have hΦ (g : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d))) :
      ‖Φ g‖ ≤ (A * lpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal p) volume) * ‖g‖ := by
    refine (SchwartzMap.denseRange_toLpCLM (E := Euclidean d) (F := Complex)
      (p := ENNReal.ofReal p.conjExponent) ENNReal.ofReal_ne_top).induction_on g ?_ ?_
    · exact isClosed_le Φ.continuous.norm
        (continuous_const.mul continuous_id.norm)
    · intro g
      simpa only [SchwartzMap.toLpCLM_apply] using hΦ_schwartz g
  have hKnonneg : 0 ≤ A * lpNorm (f : Euclidean d → Complex)
      (ENNReal.ofReal p) volume := mul_nonneg hA lpNorm_nonneg
  change lpNorm y (ENNReal.ofReal p) volume ≤
    A * lpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume
  refine lpNorm_le_of_simple_test_pairing_bound hp1 hKnonneg hy ?_
  intro g
  have hraw : Φ (g : Lp Complex (ENNReal.ofReal p.conjExponent)
      (volume : Measure (Euclidean d))) =
      ∫ x : Euclidean d, y x *
        (g : Lp Complex (ENNReal.ofReal p.conjExponent)
          (volume : Measure (Euclidean d))) x := by
    rw [show Φ =
      (ContinuousLinearMap.lpPairing volume (ENNReal.ofReal p)
        (ENNReal.ofReal p.conjExponent) (ContinuousLinearMap.mul Complex Complex))
        (hy.toLp y) by rfl,
      lpPairing_apply_toLp_eq_integral hy]
  rw [← hraw]
  exact hΦ (g : Lp Complex (ENNReal.ofReal p.conjExponent)
    (volume : Measure (Euclidean d)))

/-- ENNReal form of output-valued Schwartz-core upper-exponent duality. -/
theorem eLpNorm_rawCoreOutput_le_of_formalAdjoint_lower
    {d : Nat} {p A : Real} (hp : 2 < p) (hA : 0 ≤ A)
    (T Tstar : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hTmem : ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (T f) (ENNReal.ofReal p) volume)
    (hTstarmem : ∀ g : SchwartzMap (Euclidean d) Complex,
      MemLp (Tstar g) (ENNReal.ofReal p.conjExponent) volume)
    (hpair : ∀ f g : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, T f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar g x))
    (hTstar : ∀ g : SchwartzMap (Euclidean d) Complex,
      eLpNorm (Tstar g) (ENNReal.ofReal p.conjExponent) volume ≤
        ENNReal.ofReal A * eLpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal A * eLpNorm (f : Euclidean d → Complex)
        (ENNReal.ofReal p) volume := by
  have hp1 : 1 < p := by linarith
  have hTstar_real (g : SchwartzMap (Euclidean d) Complex) :
      lpNorm (Tstar g) (ENNReal.ofReal p.conjExponent) volume ≤
        A * lpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume := by
    let hg : MemLp (g : Euclidean d → Complex)
        (ENNReal.ofReal p.conjExponent) volume := g.memLp _ volume
    let hTg : MemLp (Tstar g) (ENNReal.ofReal p.conjExponent) volume :=
      hTstarmem g
    have hright : ENNReal.ofReal A *
        eLpNorm (g : Euclidean d → Complex)
          (ENNReal.ofReal p.conjExponent) volume ≠ ∞ :=
      ENNReal.mul_ne_top ENNReal.ofReal_ne_top hg.2.ne
    have hreal := (ENNReal.toReal_le_toReal hTg.2.ne hright).mpr (hTstar g)
    rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hA,
      toReal_eLpNorm hTg.1, toReal_eLpNorm hg.1] at hreal
    exact hreal
  have hreal := lpNorm_rawCoreOutput_le_of_formalAdjoint_lower hp hA T Tstar
    hTmem hTstarmem hpair hTstar_real f
  let hf : MemLp (f : Euclidean d → Complex) (ENNReal.ofReal p) volume :=
    f.memLp _ volume
  let hTf : MemLp (T f) (ENNReal.ofReal p) volume := hTmem f
  have hright : ENNReal.ofReal A *
      eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top ENNReal.ofReal_ne_top hf.2.ne
  apply (ENNReal.toReal_le_toReal hTf.2.ne hright).mp
  rw [ENNReal.toReal_mul, ENNReal.toReal_ofReal hA,
    toReal_eLpNorm hTf.1, toReal_eLpNorm hf.1]
  exact hreal

/-- The lower half of the raw finite-kernel multiplier argument.  The
operator is only function-valued on the Schwartz core; no Schwartz-output
regularity is assumed. -/
theorem lowerLp_rawCore_of_weak_one_square
    {d : Nat}
    (T : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hTadd : ∀ (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T (g + h) x = T g x + T h x)
    (hTmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (T g) volume)
    (C₁ C₂ : ENNReal) (hC₁top : C₁ ≠ ∞) (hC₂top : C₂ ≠ ∞)
    (hweak : ∀ (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖T g x‖} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, ENNReal.ofReal (‖T g x‖ ^ (2 : Nat))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    {p : Real} (hp1 : 1 < p) (hp2 : p < 2)
    (f : SchwartzMap (Euclidean d) Complex) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      (weakOneSquareMomentCoefficient p C₁ C₂) ^ p⁻¹ *
        eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  exact (lowerLp_of_schwartz_additive_weak_one_square T hTadd hTmeas C₁ C₂
    hC₁top hC₂top hweak hsquare hp1 hp2 f).2

/-- Full all-exponent assembly for a finite raw Fourier multiplier.  The
finite-family kernel work supplies weak `(1,1)`, square, and formal-adjoint
data; finite-kernel convolution supplies `hTmem` for each individual
Schwartz input.  The resulting coefficient is uniform whenever those input
data are uniform. -/
theorem exists_strongLp_rawCore_of_weak_one_square_adjoint
    {d : Nat}
    (T Tstar : SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hTadd : ∀ (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T (g + h) x = T g x + T h x)
    (hTmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (T g) volume)
    (hTstaradd : ∀ (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      Tstar (g + h) x = Tstar g x + Tstar h x)
    (hTstarmeas : ∀ g : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (Tstar g) volume)
    (hTmem : ∀ (r : Real), 2 < r →
      ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (T f) (ENNReal.ofReal r) volume)
    (C₁ C₂ C₁star C₂star L₂ : ENNReal)
    (hC₁top : C₁ ≠ ∞) (hC₂top : C₂ ≠ ∞)
    (hC₁startop : C₁star ≠ ∞) (hC₂startop : C₂star ≠ ∞)
    (hL₂top : L₂ ≠ ∞)
    (hweak : ∀ (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖T g x‖} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, ENNReal.ofReal (‖T g x‖ ^ (2 : Nat))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    (hweakstar : ∀ (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖Tstar g x‖} ≤
        C₁star * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquarestar : ∀ g : SchwartzMap (Euclidean d) Complex,
      (∫⁻ x, ENNReal.ofReal (‖Tstar g x‖ ^ (2 : Nat))) ≤
        C₂star * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    (hL₂ : ∀ f : SchwartzMap (Euclidean d) Complex,
      eLpNorm (T f) (ENNReal.ofReal (2 : Real)) volume ≤
        L₂ * eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal (2 : Real)) volume)
    (hpair : ∀ f g : SchwartzMap (Euclidean d) Complex,
      (∫ x : Euclidean d, T f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar g x))
    {p : Real} (hp1 : 1 < p) :
    ∃ A : ENNReal, A ≠ ∞ ∧
      ∀ f : SchwartzMap (Euclidean d) Complex,
        eLpNorm (T f) (ENNReal.ofReal p) volume ≤
          A * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  rcases lt_trichotomy p 2 with hp2 | hp2 | hp2
  · let A : ENNReal := (weakOneSquareMomentCoefficient p C₁ C₂) ^ p⁻¹
    refine ⟨A, ?_, ?_⟩
    · dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hp1 hp2 hC₁top hC₂top
    · intro f
      simpa only [A] using
        (lowerLp_rawCore_of_weak_one_square T hTadd hTmeas C₁ C₂
          hC₁top hC₂top hweak hsquare hp1 hp2 f)
  · subst p
    refine ⟨L₂, hL₂top, ?_⟩
    intro f
    simpa only [ENNReal.ofReal_ofNat] using hL₂ f
  · let q : Real := p.conjExponent
    let A : ENNReal := (weakOneSquareMomentCoefficient q C₁star C₂star) ^ q⁻¹
    have hpden : 0 < p - 1 := by linarith
    have hq1 : 1 < q := by
      rw [show q = p / (p - 1) by rfl]
      rw [lt_div_iff₀ hpden]
      linarith
    have hq2 : q < 2 := by
      rw [show q = p / (p - 1) by rfl]
      rw [div_lt_iff₀ hpden]
      linarith
    have hAtop : A ≠ ∞ := by
      dsimp [A]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hq1 hq2 hC₁startop hC₂startop
    refine ⟨A, hAtop, ?_⟩
    intro f
    have hTstarmem (g : SchwartzMap (Euclidean d) Complex) :
        MemLp (Tstar g) (ENNReal.ofReal p.conjExponent) volume := by
      have hlow := lowerLp_of_schwartz_additive_weak_one_square
        Tstar hTstaradd hTstarmeas C₁star C₂star hC₁startop hC₂startop
          hweakstar hsquarestar hq1 hq2 g
      simpa only [q] using hlow.1
    have hTstarbound (g : SchwartzMap (Euclidean d) Complex) :
        eLpNorm (Tstar g) (ENNReal.ofReal p.conjExponent) volume ≤
          ENNReal.ofReal A.toReal * eLpNorm (g : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume := by
      have hlow := lowerLp_of_schwartz_additive_weak_one_square
        Tstar hTstaradd hTstarmeas C₁star C₂star hC₁startop hC₂startop
          hweakstar hsquarestar hq1 hq2 g
      rw [ENNReal.ofReal_toReal hAtop]
      simpa only [A, q] using hlow.2
    have hupper := eLpNorm_rawCoreOutput_le_of_formalAdjoint_lower hp2
      ENNReal.toReal_nonneg T Tstar (hTmem p hp2) hTstarmem hpair hTstarbound f
    rw [ENNReal.ofReal_toReal hAtop] at hupper
    simpa only [A] using hupper

/-- Uniform-index version of the raw-core all-exponent assembly.  The
endpoint constants are shared by every index, so the chosen strong constant
is genuinely uniform (in particular, over finite truncations and over a
parameter family of symbols). -/
theorem exists_uniform_strongLp_rawCore_of_weak_one_square_adjoint
    {d : Nat} {ι : Type*}
    (T Tstar : ι → SchwartzMap (Euclidean d) Complex → Euclidean d → Complex)
    (hTadd : ∀ u (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T u (g + h) x = T u g x + T u h x)
    (hTmeas : ∀ u (g : SchwartzMap (Euclidean d) Complex),
      AEStronglyMeasurable (T u g) volume)
    (hTstaradd : ∀ u (g h : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      Tstar u (g + h) x = Tstar u g x + Tstar u h x)
    (hTstarmeas : ∀ u (g : SchwartzMap (Euclidean d) Complex),
      AEStronglyMeasurable (Tstar u g) volume)
    (hTmem : ∀ u (r : Real), 2 < r →
      ∀ f : SchwartzMap (Euclidean d) Complex,
        MemLp (T u f) (ENNReal.ofReal r) volume)
    (C₁ C₂ C₁star C₂star L₂ : ENNReal)
    (hC₁top : C₁ ≠ ∞) (hC₂top : C₂ ≠ ∞)
    (hC₁startop : C₁star ≠ ∞) (hC₂startop : C₂star ≠ ∞)
    (hL₂top : L₂ ≠ ∞)
    (hweak : ∀ u (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖T u g x‖} ≤
        C₁ * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquare : ∀ u (g : SchwartzMap (Euclidean d) Complex),
      (∫⁻ x, ENNReal.ofReal (‖T u g x‖ ^ (2 : Nat))) ≤
        C₂ * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    (hweakstar : ∀ u (g : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < ‖Tstar u g x‖} ≤
        C₁star * ∫⁻ x, ENNReal.ofReal ‖g x‖)
    (hsquarestar : ∀ u (g : SchwartzMap (Euclidean d) Complex),
      (∫⁻ x, ENNReal.ofReal (‖Tstar u g x‖ ^ (2 : Nat))) ≤
        C₂star * ∫⁻ x, ENNReal.ofReal (‖g x‖ ^ (2 : Nat)))
    (hL₂ : ∀ u (f : SchwartzMap (Euclidean d) Complex),
      eLpNorm (T u f) (ENNReal.ofReal (2 : Real)) volume ≤
        L₂ * eLpNorm (f : Euclidean d → Complex)
          (ENNReal.ofReal (2 : Real)) volume)
    (hpair : ∀ u (f g : SchwartzMap (Euclidean d) Complex),
      (∫ x : Euclidean d, T u f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d, f x * starRingEnd Complex (Tstar u g x))
    {p : Real} (hp1 : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ u f, eLpNorm (T u f) (ENNReal.ofReal p) volume ≤
        B * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  rcases lt_trichotomy p 2 with hp2 | hp2 | hp2
  · let B : ENNReal := (weakOneSquareMomentCoefficient p C₁ C₂) ^ p⁻¹
    refine ⟨B, ?_, ?_⟩
    · dsimp [B]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hp1 hp2 hC₁top hC₂top
    · intro u f
      simpa only [B] using
        (lowerLp_rawCore_of_weak_one_square (T u) (hTadd u) (hTmeas u) C₁ C₂
          hC₁top hC₂top (hweak u) (hsquare u) hp1 hp2 f)
  · subst p
    refine ⟨L₂, hL₂top, ?_⟩
    intro u f
    simpa only [ENNReal.ofReal_ofNat] using hL₂ u f
  · let q : Real := p.conjExponent
    let B : ENNReal := (weakOneSquareMomentCoefficient q C₁star C₂star) ^ q⁻¹
    have hpden : 0 < p - 1 := by linarith
    have hq1 : 1 < q := by
      rw [show q = p / (p - 1) by rfl]
      rw [lt_div_iff₀ hpden]
      linarith
    have hq2 : q < 2 := by
      rw [show q = p / (p - 1) by rfl]
      rw [div_lt_iff₀ hpden]
      linarith
    have hBtop : B ≠ ∞ := by
      dsimp [B]
      apply ENNReal.rpow_ne_top_of_nonneg (by positivity)
      exact weakOneSquareMomentCoefficient_ne_top hq1 hq2 hC₁startop hC₂startop
    refine ⟨B, hBtop, ?_⟩
    intro u f
    have hTstarmem (g : SchwartzMap (Euclidean d) Complex) :
        MemLp (Tstar u g) (ENNReal.ofReal p.conjExponent) volume := by
      have hlow := lowerLp_of_schwartz_additive_weak_one_square
        (Tstar u) (hTstaradd u) (hTstarmeas u) C₁star C₂star
          hC₁startop hC₂startop (hweakstar u) (hsquarestar u) hq1 hq2 g
      simpa only [q] using hlow.1
    have hTstarbound (g : SchwartzMap (Euclidean d) Complex) :
        eLpNorm (Tstar u g) (ENNReal.ofReal p.conjExponent) volume ≤
          ENNReal.ofReal B.toReal * eLpNorm (g : Euclidean d → Complex)
            (ENNReal.ofReal p.conjExponent) volume := by
      have hlow := lowerLp_of_schwartz_additive_weak_one_square
        (Tstar u) (hTstaradd u) (hTstarmeas u) C₁star C₂star
          hC₁startop hC₂startop (hweakstar u) (hsquarestar u) hq1 hq2 g
      rw [ENNReal.ofReal_toReal hBtop]
      simpa only [B, q] using hlow.2
    have hupper := eLpNorm_rawCoreOutput_le_of_formalAdjoint_lower hp2
      ENNReal.toReal_nonneg (T u) (Tstar u) (hTmem u p hp2) hTstarmem
      (hpair u) hTstarbound f
    rw [ENNReal.ofReal_toReal hBtop] at hupper
    simpa only [B] using hupper

/-- The physical formal-adjoint identity needed by the raw finite-family
assembly.  The adjoint kernel is `z ↦ conj (K (-z))`, written through the
existing `convolutionPhysicalAdjoint` interface. -/
theorem integral_finiteConvolutionKernel_mul_star_eq_physicalAdjoint
    {d : Nat} (K : Euclidean d → Complex)
    (f g : SchwartzMap (Euclidean d) Complex) (hK : Integrable K volume) :
    (∫ x : Euclidean d,
      finiteConvolutionKernelOperator K (f : Euclidean d → Complex) x *
        starRingEnd Complex (g x)) =
      ∫ y : Euclidean d, f y * starRingEnd Complex
        (convolutionPhysicalAdjoint K (g : Euclidean d → Complex) y) := by
  have hbase := integral_schwartz_mul_star_convolution_eq K
    (f : Euclidean d → Complex) g hK f.integrable
  have hconj := congrArg (starRingEnd Complex) hbase
  rw [← integral_conj, ← integral_conj] at hconj
  simpa only [finiteConvolutionKernelOperator, convolutionPhysicalAdjoint,
    starRingEnd_apply, map_mul, star_star, mul_comm] using hconj

/-- Literal physical-convolution adjoint pairing for a finite raw Mikhlin
kernel. -/
theorem integral_rawFiniteIntDyadicMikhlinConvolution_mul_star_eq
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f g : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
        (f : Euclidean d → Complex) x * starRingEnd Complex (g x)) =
      ∫ y : Euclidean d, f y * starRingEnd Complex
        (finiteConvolutionKernelOperator
          (rawFiniteIntDyadicMikhlinKernel (conjugateLpCutoffs C)
            (fun xi => starRingEnd Complex (m xi)) K)
          (g : Euclidean d → Complex) y) := by
  rw [integral_finiteConvolutionKernel_mul_star_eq_physicalAdjoint
    (rawFiniteIntDyadicMikhlinKernel C m K) f g
    (integrable_rawFiniteIntDyadicMikhlinKernel C m hM hNd K)]
  apply integral_congr_ae
  filter_upwards with y
  rw [convolutionPhysicalAdjoint_rawFiniteIntDyadicMikhlinKernel_eq]

/-- Literal Fourier-side finite raw multipliers obey the same formal-adjoint
pairing as their physical convolution realization. -/
theorem integral_rawFiniteIntDyadicMikhlinMultiplier_mul_star_eq
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (K : Finset Int)
    {A : Real} (hM : MikhlinCondition N m A) (hNd : d < N)
    (f g : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      rawFiniteIntDyadicMikhlinMultiplier C m K f x * starRingEnd Complex (g x)) =
      ∫ y : Euclidean d, f y * starRingEnd Complex
        (rawFiniteIntDyadicMikhlinMultiplier (conjugateLpCutoffs C)
          (fun xi => starRingEnd Complex (m xi)) K g y) := by
  calc
    (∫ x : Euclidean d,
      rawFiniteIntDyadicMikhlinMultiplier C m K f x * starRingEnd Complex (g x)) =
        ∫ x : Euclidean d,
          finiteConvolutionKernelOperator (rawFiniteIntDyadicMikhlinKernel C m K)
            (f : Euclidean d → Complex) x * starRingEnd Complex (g x) := by
          apply integral_congr_ae
          filter_upwards with x
          rw [rawFiniteIntDyadicMikhlinMultiplier_eq_convolution C m K hM hNd f x]
    _ = ∫ y : Euclidean d, f y * starRingEnd Complex
        (finiteConvolutionKernelOperator
          (rawFiniteIntDyadicMikhlinKernel (conjugateLpCutoffs C)
            (fun xi => starRingEnd Complex (m xi)) K)
          (g : Euclidean d → Complex) y) :=
      integral_rawFiniteIntDyadicMikhlinConvolution_mul_star_eq C m K hM hNd f g
    _ = ∫ y : Euclidean d, f y * starRingEnd Complex
        (rawFiniteIntDyadicMikhlinMultiplier (conjugateLpCutoffs C)
          (fun xi => starRingEnd Complex (m xi)) K g y) := by
          apply integral_congr_ae
          filter_upwards with y
          rw [rawFiniteIntDyadicMikhlinMultiplier_eq_convolution
            (conjugateLpCutoffs C) (fun xi => starRingEnd Complex (m xi)) K
            (mikhlinCondition_conj m hM) hNd g y]

/-- Uniform all-`L^p` control for every literal finite raw Mikhlin kernel in
a parameter family.  The coefficient is independent both of the family
parameter and of the finite set of dyadic scales. -/
theorem exists_uniform_strongLp_rawFiniteIntDyadicMikhlinKernelOperator
    {d N : Nat} [NeZero d] (C : lpCutoffs d) {ι : Type*}
    (m : ι → Euclidean d → Complex) {A : Real} (hA : 0 ≤ A)
    (hM : ∀ u, MikhlinCondition N (m u) A) (hNd : d < N)
    {p : Real} (hp : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (u : ι) (K : Finset Int) (f : SchwartzMap (Euclidean d) Complex),
        eLpNorm
          (finiteConvolutionKernelOperator
            (rawFiniteIntDyadicMikhlinKernel C (m u) K)
            (f : Euclidean d → Complex))
          (ENNReal.ofReal p) volume ≤
          B * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let Cstar : lpCutoffs d := conjugateLpCutoffs C
  let mstar : ι → Euclidean d → Complex :=
    fun u xi => starRingEnd Complex (m u xi)
  let T : (ι × Finset Int) →
      SchwartzMap (Euclidean d) Complex → Euclidean d → Complex :=
    fun v f => finiteConvolutionKernelOperator
      (rawFiniteIntDyadicMikhlinKernel C (m v.1) v.2)
      (f : Euclidean d → Complex)
  let Tstar : (ι × Finset Int) →
      SchwartzMap (Euclidean d) Complex → Euclidean d → Complex :=
    fun v f => finiteConvolutionKernelOperator
      (rawFiniteIntDyadicMikhlinKernel Cstar (mstar v.1) v.2)
      (f : Euclidean d → Complex)
  let C₁ : ENNReal := finiteConvolutionKernelWeakOneConstant (d := d) (4 * A)
    (rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) C A)
  let C₂ : ENNReal := (ENNReal.ofReal (4 * A)) ^ (2 : Nat)
  let C₁star : ENNReal := finiteConvolutionKernelWeakOneConstant (d := d) (4 * A)
    (rawFiniteIntDyadicMikhlinKernelCZTailConstant (N := N) Cstar A)
  let C₂star : ENNReal := (ENNReal.ofReal (4 * A)) ^ (2 : Nat)
  let L₂ : ENNReal := ENNReal.ofReal (4 * A)
  have hMstar : ∀ u, MikhlinCondition N (mstar u) A := by
    intro u
    exact mikhlinCondition_conj (m u) (hM u)
  have hC₁top : C₁ ≠ ∞ := by
    dsimp [C₁]
    dsimp [finiteConvolutionKernelWeakOneConstant]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.add_ne_top.mpr
      constructor
      · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
      · apply ENNReal.mul_ne_top
        · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
        · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
  have hC₂top : C₂ ≠ ∞ := by
    dsimp [C₂]
    exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  have hC₁startop : C₁star ≠ ∞ := by
    dsimp [C₁star]
    dsimp [finiteConvolutionKernelWeakOneConstant]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.add_ne_top.mpr
      constructor
      · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
      · apply ENNReal.mul_ne_top
        · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
        · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
    · exact ENNReal.mul_ne_top ENNReal.coe_ne_top ENNReal.ofReal_ne_top
  have hC₂startop : C₂star ≠ ∞ := by
    dsimp [C₂star]
    exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
  have hL₂top : L₂ ≠ ∞ := by
    dsimp [L₂]
    exact ENNReal.ofReal_ne_top
  rcases exists_uniform_strongLp_rawCore_of_weak_one_square_adjoint T Tstar
    (fun v g h x => by
      exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_add
        C (m v.1) v.2 (hM v.1) hNd g h x)
    (fun v g => by
      exact aestronglyMeasurable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
        C (m v.1) v.2 (hM v.1) hNd g)
    (fun v g h x => by
      exact finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel_add
        Cstar (mstar v.1) v.2 (hMstar v.1) hNd g h x)
    (fun v g => by
      exact aestronglyMeasurable_finiteConvolutionKernelOperator_rawFiniteIntDyadicMikhlinKernel
        Cstar (mstar v.1) v.2 (hMstar v.1) hNd g)
    (fun v r hr f => by
      exact memLp_rawFiniteIntDyadicMikhlinKernelOperator
        C (m v.1) v.2 hA (hM v.1) hNd hr f)
    C₁ C₂ C₁star C₂star L₂ hC₁top hC₂top hC₁startop hC₂startop hL₂top
    (fun v g s hs => by
      exact weak_one_rawFiniteIntDyadicMikhlinKernel
        C (m v.1) v.2 hA (hM v.1) hNd g hs)
    (fun v g => by
      exact lintegral_norm_sq_rawFiniteIntDyadicMikhlinKernelOperator_le
        C (m v.1) v.2 hA (hM v.1) hNd g)
    (fun v g s hs => by
      exact weak_one_rawFiniteIntDyadicMikhlinKernel
        Cstar (mstar v.1) v.2 hA (hMstar v.1) hNd g hs)
    (fun v g => by
      exact lintegral_norm_sq_rawFiniteIntDyadicMikhlinKernelOperator_le
        Cstar (mstar v.1) v.2 hA (hMstar v.1) hNd g)
    (fun v f => by
      exact eLpNorm_two_rawFiniteIntDyadicMikhlinKernelOperator_le
        C (m v.1) v.2 hA (hM v.1) hNd f)
    (fun v f g => by
      exact integral_rawFiniteIntDyadicMikhlinConvolution_mul_star_eq
        C (m v.1) v.2 (hM v.1) hNd f g)
    hp with ⟨B, hBtop, hB⟩
  refine ⟨B, hBtop, ?_⟩
  intro u K f
  exact hB (u, K) f

/-- With fixed Littlewood--Paley cutoffs, the uniform literal finite-kernel
bound passes by Fatou to the raw Mikhlin multiplier itself. -/
theorem exists_uniform_strongLp_mikhlinMultiplier_withCutoffs
    {d N : Nat} [NeZero d] (C : lpCutoffs d) {ι : Type*}
    (m : ι → Euclidean d → Complex) {A : Real} (hA : 0 ≤ A)
    (hM : ∀ u, MikhlinCondition N (m u) A) (hNd : d < N)
    {p : Real} (hp : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex),
        eLpNorm (mikhlinMultiplier (m u) f) (ENNReal.ofReal p) volume ≤
          B * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  rcases exists_uniform_strongLp_rawFiniteIntDyadicMikhlinKernelOperator
    C m hA hM hNd hp with ⟨B, hBtop, hB⟩
  refine ⟨B, hBtop, ?_⟩
  intro u f
  apply eLpNorm_mikhlinMultiplier_le_of_uniform_finiteSymmetricMikhlinTruncation_of_mikhlin
    C (m u) hA (hM u) (ENNReal.ofReal p)
      (B * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume) f
  intro n
  rw [show finiteSymmetricMikhlinTruncation C (m u) n f =
      fun x : Euclidean d => finiteConvolutionKernelOperator
        (rawFiniteIntDyadicMikhlinKernel C (m u)
          (symmetricRawFiniteIntDyadicMikhlinIndex n))
        (f : Euclidean d → Complex) x by
      funext x
      exact finiteSymmetricMikhlinTruncation_eq_rawFiniteIntDyadicMikhlinConvolution
        C (m u) hA (hM u) hNd n f x]
  exact hB u (symmetricRawFiniteIntDyadicMikhlinIndex n) f

/-- The dimension-generic parameter-uniform Mikhlin multiplier theorem.
Specializing to `d = 2` and `N = 3` gives the blueprint's planar
third-order form. -/
theorem mikhlin
    {d N : Nat} [NeZero d] {ι : Type*}
    (m : ι → Euclidean d → Complex) {A : Real} (hA : 0 ≤ A)
    (hM : ∀ u, MikhlinCondition N (m u) A) (hNd : d < N)
    {p : Real} (hp : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex),
        eLpNorm (mikhlinMultiplier (m u) f) (ENNReal.ofReal p) volume ≤
          B * eLpNorm (f : Euclidean d → Complex) (ENNReal.ofReal p) volume := by
  let C : lpCutoffs d := Classical.choice (exists_lpCutoffs d)
  exact exists_uniform_strongLp_mikhlinMultiplier_withCutoffs C m hA hM hNd hp

/-- The direct planar third-order form of `mikhlin`. -/
theorem mikhlin_two
    {ι : Type*} (m : ι → Euclidean 2 → Complex) {A : Real} (hA : 0 ≤ A)
    (hM : ∀ u, MikhlinCondition 3 (m u) A)
    {p : Real} (hp : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean 2) Complex),
        eLpNorm (mikhlinMultiplier (m u) f) (ENNReal.ofReal p) volume ≤
          B * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  exact mikhlin m hA hM (by norm_num) hp

/-- The blueprint-facing planar Mikhlin theorem from coordinate-directional
third-order hypotheses. -/
theorem mikhlin_two_of_coordinateMikhlinCondition
    {ι : Type*} (m : ι → Euclidean 2 → Complex) {C : Real} (hC : 0 ≤ C)
    (hM : ∀ u, PlanarCoordinateMikhlinCondition (m u) C)
    {p : Real} (hp : 1 < p) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean 2) Complex),
        eLpNorm (mikhlinMultiplier (m u) f) (ENNReal.ofReal p) volume ≤
          B * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  exact mikhlin_two m (by positivity)
    (planarCoordinateMikhlinCondition_family_to_mikhlinCondition hM) hp

theorem littlewoodPaley_of_mikhlin
    {d : Nat} [NeZero d] (C : lpCutoffs d) :
    littlewoodPaley C := by
  apply littlewoodPaley_of_uniform_signed C
  intro p hp
  rcases exists_uniform_signed_dyadic_moment_bound C hp with ⟨B, hB, hmoment⟩
  refine ⟨B, hB, ?_⟩
  intro K u f hu
  have hsign : ∀ k ∈ K, ‖rademacherSign u k‖ ≤ (1 : Real) := by
    intro k hk
    exact rademacherSign_norm_le_one u k
  have h := hmoment K (fun k => rademacherSign u k) hsign f
  have heq : finiteRademacherIntegerDyadicSum C K u f =
      finiteSignedIntegerDyadicMultiplierSchwartz C K
        (fun k => rademacherSign u k) f := by
    funext x
    exact finiteRademacherIntegerDyadicSum_eq_signedMultiplier C K u f x
  simpa only [heq] using h

end

