  rcases h with ⟨hC, hcont, hderiv⟩
  refine ⟨hcont, ?_⟩
  intro k hk ξ hξ
  let T : Euclidean d [×k]→L[Real] Complex :=
    (‖ξ‖ ^ k) • iteratedFDeriv Real k m ξ
  have hTcoord : ∀ σ : Fin k → Fin d,
      ‖T (fun i => EuclideanSpace.basisFun (Fin d) Real (σ i))‖ ≤ C := by
    intro σ
    simpa [T, norm_smul, Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)] using
      hderiv k hk ξ hξ σ
