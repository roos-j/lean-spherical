      T v = ∑ σ : Fin n → Fin d,
        (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i)) := by
    calc
      T v = T (fun i => ∑ j, (b.repr (v i)) j • b j) := by
        congr 1
        funext i
        exact (b.sum_repr (v i)).symm
      _ = ∑ σ : Fin n → Fin d,
          T (fun i => (b.repr (v i)) (σ i) • b (σ i)) := by
        rw [T.map_sum]
      _ = ∑ σ : Fin n → Fin d,
          (∏ i, (b.repr (v i)) (σ i)) • T (fun i => b (σ i)) := by
        apply Finset.sum_congr rfl
        intro σ hσ
        rw [T.map_smul_univ]
