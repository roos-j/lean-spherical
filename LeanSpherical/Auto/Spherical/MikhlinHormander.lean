theorem intDyadicMikhlinPiece_eq_normalized_scale {d : Nat}
    (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int) (xi : Euclidean d) :
    intDyadicBandpassMultiplier C.cutoff k xi * m xi =
      normalizedIntDyadicMikhlinPiece C m k
        ((integerDyadicFrequencyScale k).1 • xi) := by
  unfold normalizedIntDyadicMikhlinPiece
  have hs : (integerDyadicFrequencyScale k).1 ≠ 0 :=
    ne_of_gt (integerDyadicFrequencyScale k).2
  rw [smul_smul, inv_mul_cancel₀ hs, one_smul]

theorem fourierInv_intDyadicMikhlinPiece_eq_normalized_scale {d : Nat}
    (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int) (x : Euclidean d) :
