    norm_continuousMultilinearMap_le_of_basis_coordinates T hC hTcoord
  have hdNat : 1 ≤ d := (Nat.one_le_iff_ne_zero).2 (NeZero.ne d)
  have hd : (1 : Real) ≤ d := by exact_mod_cast hdNat
  have hpow : (d : Real) ^ k ≤ (d : Real) ^ N := pow_le_pow_right₀ hd hk
  calc
    ‖ξ‖ ^ k * ‖iteratedFDeriv Real k m ξ‖ = ‖T‖ := by
      simp [T, norm_smul, Real.norm_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    _ ≤ (d : Real) ^ k * C := hTnorm
    _ ≤ (d : Real) ^ N * C := mul_le_mul_of_nonneg_right hpow hC

