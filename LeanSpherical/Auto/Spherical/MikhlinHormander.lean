    dsimp only [s]
    exact (integerDyadicFrequencyScale k).2
  have hscale : (fun xi : Euclidean d =>
      normalizedIntDyadicMikhlinPiece C m k ((s⁻¹)⁻¹ • xi)) =
        fun xi => intDyadicBandpassMultiplier C.cutoff k xi * m xi := by
    funext xi
    simpa only [s, inv_inv] using
      (intDyadicMikhlinPiece_eq_normalized_scale C m k xi).symm
  rw [← hscale]
  simpa [s, finrank_euclideanSpace_fin] using
    (fourierInv_comp_inv_smul
      (g := normalizedIntDyadicMikhlinPiece C m k)
      (inv_pos.mpr hs) x)

theorem weighted_deriv_normalizedIntDyadicMikhlinPiece_le_uniform
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {i j : Nat} (hi : i ≤ N) (hj : j ≤ 1) (x : Euclidean d) :
    ‖x‖ ^ j * ‖iteratedFDeriv Real i
      (normalizedIntDyadicMikhlinPiece C m k) x‖ ≤
      4 * A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ N := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let D : Real := schwartzWeightedCutoffDerivativeConstant (N := N)
    (integerDyadicBandpassPrototype C.cutoff)
  have hD : 0 ≤ D := by
    dsimp only [D]
    unfold schwartzWeightedCutoffDerivativeConstant
    exact Finset.sum_nonneg fun r hr =>
      (show 0 ≤ ‖(0 : Euclidean d)‖ ^ r *
        ‖iteratedFDeriv Real r (integerDyadicBandpassPrototype C.cutoff) 0‖ by positivity).trans
        (SchwartzMap.le_seminorm Real r r
          (integerDyadicBandpassPrototype C.cutoff) 0)
  have hB : 0 ≤ A * D * (2 : Real) ^ i :=
    mul_nonneg (mul_nonneg hA hD) (pow_nonneg (by norm_num) _)
  by_cases hzero : iteratedFDeriv Real i G x = 0
  · rw [hzero, norm_zero, mul_zero]
    positivity
  · have hxsupport : x ∈ Function.support (iteratedFDeriv Real i G) :=
      Function.mem_support.mpr hzero
    have hxannulus : 1 ≤ ‖x‖ ∧ ‖x‖ ≤ 4 :=
      ((support_iteratedFDeriv_subset i).trans
        (tsupport_normalizedIntDyadicMikhlinPiece_subset_unit_annulus C m k)) hxsupport
    have hpow : ‖x‖ ^ j ≤ 4 := by
      have hjcases : j = 0 ∨ j = 1 := by omega
      rcases hjcases with rfl | rfl
      · norm_num
      · simpa using hxannulus.2
    have hderiv := deriv_normalizedIntDyadicMikhlinPiece_le
      C m hm hA k hi x
    have htwopow : (2 : Real) ^ i ≤ (2 : Real) ^ N := by
      exact pow_le_pow_right₀ (by norm_num) hi
    change ‖x‖ ^ j * ‖iteratedFDeriv Real i G x‖ ≤ 4 * A * D * (2 : Real) ^ N
    calc
      ‖x‖ ^ j * ‖iteratedFDeriv Real i G x‖ ≤
          ‖x‖ ^ j * (A * D * (2 : Real) ^ i) :=
        mul_le_mul_of_nonneg_left hderiv (pow_nonneg (norm_nonneg x) _)
      _ ≤ 4 * (A * D * (2 : Real) ^ i) :=
        mul_le_mul_of_nonneg_right hpow hB
      _ ≤ 4 * (A * D * (2 : Real) ^ N) := by
        apply mul_le_mul_of_nonneg_left
        apply mul_le_mul_of_nonneg_left htwopow
        exact mul_nonneg hA hD
        norm_num
      _ = 4 * A * D * (2 : Real) ^ N := by ring

