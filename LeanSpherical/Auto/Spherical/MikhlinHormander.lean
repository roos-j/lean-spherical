  exact norm_iteratedFDeriv_dilated_cutoff_mul_mikhlin_le (χ : Euclidean d → Complex)
    m hχ hm hC
    (fun i hi x => weighted_deriv_le_schwartzWeightedCutoffDerivativeConstant χ hi x)
    a hx hn

/-! ## Finite-regularity compact kernels

The localization step in a Mikhlin proof produces compactly supported symbols
with only finitely many controlled derivatives.  This layer is intentionally
dimension-generic: an order `N` integration-by-parts estimate is useful in
every dimension, and integrability is obtained later from the natural
assumption `d < N`.
-/

/-- The finite sum of derivative `L¹` norms which occurs in the order-`N`
Fourier integration-by-parts bound. -/
def compactFourierIBPConstant {d N : Nat} {E : Type*}
    [NormedAddCommGroup E] [NormedSpace Complex E]
    (ψ : Euclidean d → E) : Real :=
  (2 : Real) ^ N *
    ∑ n ∈ Finset.range (N + 1), ∫ ξ, ‖iteratedFDeriv Real n ψ ξ‖

/-- A uniform pointwise bound integrates over any finite measurable support
container.  This elementary estimate is stated in arbitrary Euclidean
dimension so compact frequency-side bounds can be converted to literal
Fourier `L¹` bounds without introducing a dimension-specific radial formula. -/
theorem integral_norm_le_of_support_subset_of_norm_le
    {d : Nat} {E : Type*} [NormedAddCommGroup E]
    (f : Euclidean d → E) (K : Set (Euclidean d))
    (hK : MeasurableSet K) (hKfinite : volume K ≠ (⊤ : ENNReal))
    {B : Real}
    (hf : Integrable (fun x => ‖f x‖) volume)
    (hpoint : ∀ x : Euclidean d, ‖f x‖ ≤ B)
    (hsupport : Function.support f ⊆ K) :
    (∫ x : Euclidean d, ‖f x‖) ≤ B * (volume K).toReal := by
  have hind : Integrable (K.indicator (fun _ : Euclidean d => B)) volume := by
    rw [integrable_indicator_iff hK]
    exact integrableOn_const hKfinite (by finiteness)
  have hdom : (fun x : Euclidean d => ‖f x‖) ≤
      K.indicator (fun _ : Euclidean d => B) := by
    intro x
    by_cases hx : x ∈ K
    · rw [Set.indicator_of_mem hx]
      exact hpoint x
    · rw [Set.indicator_of_notMem hx]
      have hzero : f x = 0 := by
        by_contra hne
        exact hx (hsupport (Function.mem_support.mpr hne))
      simp [hzero]
  calc
    (∫ x : Euclidean d, ‖f x‖) ≤
        ∫ x : Euclidean d, K.indicator (fun _ : Euclidean d => B) x :=
      integral_mono hf hind hdom
    _ = (volume K).toReal * B := by
      simpa only [Measure.real_def, smul_eq_mul] using
        (integral_indicator_const (μ := volume) (e := B) hK)
    _ = B * (volume K).toReal := by ring

/-- On any Euclidean annulus bounded away from the origin, each fixed
iterated derivative of the norm has a finite uniform bound.  This is
dimension-generic compactness, stated in the form needed for radial
multiplier composition estimates. -/
theorem exists_norm_iteratedFDeriv_norm_bound_on_annulus
    {d : Nat} (n : Nat) {r R : Real} (hr : 0 < r) :
    ∃ D : Real, 0 < D ∧ ∀ x : Euclidean d,
      r ≤ ‖x‖ → ‖x‖ ≤ R →
      ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x‖ ≤ D := by
  let K : Set (Euclidean d) := Metric.closedBall 0 R ∩ {x | r ≤ ‖x‖}
  have hKcompact : IsCompact K :=
    (isCompact_closedBall (0 : Euclidean d) R).inter_right
      (isClosed_le continuous_const continuous_norm)
  have hKcont : ContinuousOn
      (fun x : Euclidean d => ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x‖) K := by
    intro x hx
    have hxnorm : r ≤ ‖x‖ := hx.2
    have hxne : x ≠ 0 := by
      intro hzero
      subst x
      exact (not_le_of_gt hr) (by simpa using hxnorm)
    have hn : ((n : ENat) : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) :=
      WithTop.coe_le_coe.mpr le_top
    exact ((contDiffAt_norm Real hxne).continuousAt_iteratedFDeriv hn).norm.continuousWithinAt
  obtain ⟨D, hD⟩ := Metric.isBounded_iff_subset_closedBall (0 : Real) |>.mp
    (hKcompact.image_of_continuousOn hKcont).isBounded
  let D' : Real := max D 0 + 1
  have hD' : 0 < D' := by
    dsimp [D']
    linarith [le_max_right D 0]
  refine ⟨D', hD', ?_⟩
  intro x hxinner hxouter
  have hxK : x ∈ K := by
    constructor
    · rw [Metric.mem_closedBall, dist_zero_right]
      exact hxouter
    · exact hxinner
  have hDx := hD (Set.mem_image_of_mem _ hxK)
  have hDle : D ≤ D' := by
    dsimp [D']
    linarith [le_max_left D 0]
  have hDx' : ‖iteratedFDeriv Real n (fun y : Euclidean d => ‖y‖) x‖ ≤ D := by
    rw [Metric.mem_closedBall, dist_zero_right, Real.norm_of_nonneg (norm_nonneg _)] at hDx
    exact hDx
  exact hDx'.trans hDle

/-- A common compact support container and uniform derivative bounds give an
explicit bound for the finite Fourier integration-by-parts constant.  This is
the frequency-side packaging used when a fixed annular family has controlled
derivatives through a finite order. -/
theorem compactFourierIBPConstant_le_of_support_subset_of_uniform_deriv_bound
    {d N : Nat} {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E]
    (ψ : Euclidean d → E) (hψ : ContDiff Real N ψ)
    {R : Real} (hsupp : Function.support ψ ⊆ Metric.closedBall 0 R)
    (B : Nat → Real)
    (hB : ∀ n ≤ N, ∀ x : Euclidean d,
      ‖iteratedFDeriv Real n ψ x‖ ≤ B n) :
    compactFourierIBPConstant (N := N) ψ ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        B n * (volume (Metric.closedBall (0 : Euclidean d) R)).toReal := by
  have hψ_comp : HasCompactSupport ψ :=
    HasCompactSupport.of_support_subset_isCompact
      (isCompact_closedBall (0 : Euclidean d) R) hsupp
  have htsupp : tsupport ψ ⊆ Metric.closedBall (0 : Euclidean d) R :=
    closure_minimal hsupp Metric.isClosed_closedBall
  unfold compactFourierIBPConstant
  apply mul_le_mul_of_nonneg_left
  · apply Finset.sum_le_sum
    intro n hn
    have hnN : n ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hn)
    apply integral_norm_le_of_support_subset_of_norm_le
    · exact Metric.isClosed_closedBall.measurableSet
    · exact measure_closedBall_lt_top.ne
    · have hcont : Continuous (iteratedFDeriv Real n ψ) :=
        hψ.continuous_iteratedFDeriv (by exact_mod_cast hnN)
      simpa using
        ((hcont.integrable_of_hasCompactSupport (μ := volume)
          (hψ_comp.iteratedFDeriv n)).norm)
    · exact hB n hnN
    · exact (support_iteratedFDeriv_subset n).trans htsupp
  · positivity

/-- A dimension-generic order-`N` decay estimate for an inverse Fourier
transform.  It needs only finite differentiability together with integrability
of the derivatives that appear in the integration-by-parts formula. -/
theorem pow_norm_fourierInv_le_compactFourierIBPConstant
    {d N : Nat} {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E]
    (ψ : Euclidean d → E) (hψ : ContDiff Real N ψ)
    (hψ_int : ∀ n ≤ N, Integrable (fun ξ => ‖iteratedFDeriv Real n ψ ξ‖))
    (x : Euclidean d) :
    ‖x‖ ^ N * ‖𝓕⁻ ψ x‖ ≤ compactFourierIBPConstant (N := N) ψ := by
  have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
    (f := ψ) (K := 0) (N := N) hψ
    (fun k n hk hn => by
      have hk' : k = 0 := by simpa using hk
      subst k
      simpa using hψ_int n (by simpa using hn))
    (k := 0) (n := N) (by simp) (by simp) (-x)
  simpa [compactFourierIBPConstant, Real.fourierInv_eq_fourier_neg] using h

/-- Compact support turns finite `Cᴺ` regularity into the derivative
integrability required by `pow_norm_fourierInv_le_compactFourierIBPConstant`.
Consequently every compact `Cᴺ` symbol has order-`N` inverse-Fourier decay,
in every Euclidean dimension. -/
theorem compact_cN_fourierInv_decay
    {d N : Nat} {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E]
    (ψ : Euclidean d → E) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) :
    ∃ A : Real, ∀ x : Euclidean d, ‖x‖ ^ N * ‖𝓕⁻ ψ x‖ ≤ A := by
  refine ⟨compactFourierIBPConstant (N := N) ψ, fun x =>
    pow_norm_fourierInv_le_compactFourierIBPConstant ψ hψ ?_ x⟩
  intro n hn
  have hcont : Continuous (iteratedFDeriv Real n ψ) :=
    hψ.continuous_iteratedFDeriv (by exact_mod_cast hn)
  simpa using
    ((hcont.integrable_of_hasCompactSupport (μ := volume)
      (hψ_supp.iteratedFDeriv n)).norm)

/-- A uniformly bounded Euclidean kernel with order-`N` power decay is
integrable once the decay order exceeds the ambient dimension. -/
theorem integrable_of_uniform_and_power_decay
    {d N : Nat} {E : Type*} [NormedAddCommGroup E]
    {f : Euclidean d → E} (hNd : d < N)
    (hf_meas : AEStronglyMeasurable f volume)
    {A B : Real} (hB : ∀ x, ‖f x‖ ≤ B)
    (hA : ∀ x, ‖x‖ ^ N * ‖f x‖ ≤ A) :
    Integrable f volume := by
  have hNpos : 0 < N := lt_of_le_of_lt (Nat.zero_le d) hNd
  have hBnonneg : 0 ≤ B := (norm_nonneg (f 0)).trans (hB 0)
  have hAnonneg : 0 ≤ A := by
    simpa [Nat.ne_of_gt hNpos] using hA 0
  have hdim : (Module.finrank Real (Euclidean d) : Real) < (N : Real) := by
    simpa using (show (d : Real) < (N : Real) by exact_mod_cast hNd)
  have hweight : Integrable (fun x : Euclidean d =>
      (1 + ‖x‖) ^ (-(N : Real))) volume :=
    integrable_one_add_norm hdim
  refine (hweight.const_mul ((2 : Real) ^ N * (B + A))).mono' hf_meas ?_
  filter_upwards with x
  have hpoint : ‖f x‖ ≤
      (2 : Real) ^ N * (B + A) * (1 + ‖x‖) ^ (-(N : Real)) := by
    simpa using
      (pow_mul_le_of_le_of_pow_mul_le (k := 0) (l := N)
        (norm_nonneg x) (norm_nonneg (f x)) (hB x) (by simpa using hA x))
  have hnonneg : 0 ≤
      (2 : Real) ^ N * (B + A) * (1 + ‖x‖) ^ (-(N : Real)) := by
    positivity
  simpa [smul_eq_mul, abs_of_nonneg hnonneg] using hpoint

/-- In every Euclidean dimension, the inverse Fourier transform of a compact
`C^N` symbol is integrable as soon as `N` is strictly larger than the
dimension. -/
theorem compact_cN_fourierInv_integrable
    {d N : Nat} {E : Type*} [NormedAddCommGroup E] [NormedSpace Complex E]
    (ψ : Euclidean d → E) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) (hNd : d < N) :
    Integrable (𝓕⁻ ψ) volume := by
  have hψ_int : Integrable ψ volume :=
    hψ.continuous.integrable_of_hasCompactSupport (μ := volume) hψ_supp
  have hFcont : Continuous (𝓕 ψ) := by
    exact VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
      (innerSL Real).continuous₂ hψ_int
  have hKcont : Continuous (𝓕⁻ ψ) := by
    have hEq : 𝓕⁻ ψ = fun x => 𝓕 ψ (-x) := by
      funext x
      exact Real.fourierInv_eq_fourier_neg ψ x
    rw [hEq]
    exact hFcont.comp continuous_neg
  rcases compact_cN_fourierInv_decay ψ hψ hψ_supp with ⟨A, hA⟩
  apply integrable_of_uniform_and_power_decay hNd hKcont.aestronglyMeasurable
  · intro x
    rw [Real.fourierInv_eq_fourier_neg]
    change ‖VectorFourier.fourierIntegral Real.fourierChar volume
      (innerSL Real).toLinearMap₁₂ ψ (-x)‖ ≤ ∫ v, ‖ψ v‖
    exact VectorFourier.norm_fourierIntegral_le_integral_norm
      Real.fourierChar volume (innerSL Real).toLinearMap₁₂ ψ (-x)
  · exact hA

/-- The spatial Fréchet derivative of an inverse Fourier kernel is the
inverse transform of the standard linear Fourier-side factor. -/
theorem fderiv_fourierInv_eq_fourierInv_fourierSMulRight
    {d : Nat} (ψ : Euclidean d → Complex)
    (hψ_int : Integrable ψ volume)
    (hψ_weight : Integrable (fun v : Euclidean d => ‖v‖ * ‖ψ v‖)) :
    fderiv Real (𝓕⁻ ψ) =
      𝓕⁻ (VectorFourier.fourierSMulRight (-innerSL Real) ψ) := by
  change fderiv Real
      (VectorFourier.fourierIntegral Real.fourierChar volume
        (-innerSL Real).toLinearMap₁₂ ψ) =
    VectorFourier.fourierIntegral Real.fourierChar volume
      (-innerSL Real).toLinearMap₁₂
        (VectorFourier.fourierSMulRight (-innerSL Real) ψ)
  exact VectorFourier.fderiv_fourierIntegral (-innerSL Real) hψ_int hψ_weight

/-- The Fourier-side first-derivative factor preserves finite real
differentiability. -/
theorem contDiff_fourierSMulRight_one
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ) :
    ContDiff Real N (VectorFourier.fourierSMulRight (-innerSL Real) ψ) := by
  let C := continuousMultilinearCurryFin1 Real (Euclidean d) Complex
  have hEq : VectorFourier.fourierSMulRight (-innerSL Real) ψ =
      fun v => C (VectorFourier.fourierPowSMulRight (-innerSL Real) ψ v 1) := by
    funext v
    ext w
    simp [C, VectorFourier.fourierPowSMulRight_apply,
      VectorFourier.fourierSMulRight_apply]
  rw [hEq]
  exact C.contDiff.comp (hψ.fourierPowSMulRight (L := -innerSL Real) 1)

/-- The Fourier-side first-derivative factor has no larger support than its
original symbol. -/
theorem hasCompactSupport_fourierSMulRight_one
    {d : Nat} (ψ : Euclidean d → Complex) (hψ_supp : HasCompactSupport ψ) :
    HasCompactSupport (VectorFourier.fourierSMulRight (-innerSL Real) ψ) := by
  rw [hasCompactSupport_iff_eventuallyEq] at hψ_supp ⊢
  filter_upwards [hψ_supp] with x hx
  simp [VectorFourier.fourierSMulRight, hx]

/-- A compact Fourier-side derivative factor gives an integrable spatial
derivative of the inverse-Fourier kernel, provided its available derivative
order exceeds the ambient dimension. -/
theorem integrable_fderiv_fourierInv_of_compact_fourierSMulRight
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ)
    (hfactor_supp : HasCompactSupport
      (VectorFourier.fourierSMulRight (-innerSL Real) ψ))
    (hNd : d < N) :
    Integrable (fderiv Real (𝓕⁻ ψ)) volume := by
  have hψ_int : Integrable ψ volume :=
    hψ.continuous.integrable_of_hasCompactSupport (μ := volume) hψ_supp
  have hψ_weight : Integrable (fun v : Euclidean d => ‖v‖ * ‖ψ v‖) volume := by
    refine (continuous_norm.mul hψ.continuous.norm).integrable_of_hasCompactSupport
      (μ := volume) ?_
    exact hψ_supp.norm.mul_left
  rw [fderiv_fourierInv_eq_fourierInv_fourierSMulRight ψ hψ_int hψ_weight]
  have hfactor_diff : ContDiff Real N
      (VectorFourier.fourierSMulRight (-innerSL Real) ψ) :=
    contDiff_fourierSMulRight_one ψ hψ
  exact compact_cN_fourierInv_integrable
    (VectorFourier.fourierSMulRight (-innerSL Real) ψ)
    hfactor_diff hfactor_supp hNd

/-- A compact `C^N` symbol with `N > d` has an inverse-Fourier kernel whose
spatial derivative is integrable. -/
theorem integrable_fderiv_compact_cN_fourierInv
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) (hNd : d < N) :
    Integrable (fderiv Real (𝓕⁻ ψ)) volume := by
  apply integrable_fderiv_fourierInv_of_compact_fourierSMulRight ψ hψ hψ_supp
    (hasCompactSupport_fourierSMulRight_one ψ hψ_supp) hNd

/-- The inverse-Fourier kernel of a compact `C^N` symbol has the global
translation estimate needed in the Calderón--Zygmund kernel argument. -/
theorem integral_norm_sub_translate_compact_cN_fourierInv_le
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) (hNd : d < N) (h : Euclidean d) :
    (∫ x : Euclidean d, ‖𝓕⁻ ψ (x + h) - 𝓕⁻ ψ x‖) ≤
      ‖h‖ * ∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖ := by
  have hFone : ContDiff Real 1 (𝓕 ψ) := by
    apply Real.contDiff_fourier
    intro n hn
    exact (continuous_norm.pow n).mul hψ.continuous.norm |>.integrable_of_hasCompactSupport
      (μ := volume) hψ_supp.norm.mul_left
  have hKone : ContDiff Real 1 (𝓕⁻ ψ) := by
    have hEq : 𝓕⁻ ψ = fun x => 𝓕 ψ (-x) := by
      funext x
      exact Real.fourierInv_eq_fourier_neg ψ x
    rw [hEq]
    simpa [Function.comp_def] using hFone.comp contDiff_neg
  exact Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
      (𝓕⁻ ψ) hKone (integrable_fderiv_compact_cN_fourierInv ψ hψ hψ_supp hNd) h

/-- Every integrable kernel has the coarse, translation-uniform `L¹`
difference bound obtained from the triangle inequality. -/
theorem integral_norm_sub_translate_le_two_integral_norm
    {d : Nat} (f : Euclidean d → Complex) (hf : Integrable f volume)
    (h : Euclidean d) :
    (∫ x : Euclidean d, ‖f (x + h) - f x‖) ≤
      2 * ∫ x : Euclidean d, ‖f x‖ := by
  have hshift : Integrable (fun x : Euclidean d => ‖f (x + h)‖) :=
    hf.norm.comp_add_right h
  have hsum : Integrable (fun x : Euclidean d => ‖f (x + h)‖ + ‖f x‖) :=
    hshift.add hf.norm
  calc
    (∫ x : Euclidean d, ‖f (x + h) - f x‖) ≤
        ∫ x : Euclidean d, ‖f (x + h)‖ + ‖f x‖ := by
          apply integral_mono_ae
          · exact (hf.comp_add_right h).sub hf |>.norm
          · exact hsum
          filter_upwards with x
          exact norm_sub_le _ _
    _ = (∫ x : Euclidean d, ‖f (x + h)‖) +
          ∫ x : Euclidean d, ‖f x‖ := by
          rw [integral_add hshift hf.norm]
    _ = 2 * ∫ x : Euclidean d, ‖f x‖ := by
          have heq : (∫ x : Euclidean d, ‖f (x + h)‖) =
              ∫ x : Euclidean d, ‖f x‖ :=
            integral_add_right_eq_self (fun x : Euclidean d => ‖f x‖) h
          rw [heq]
          ring

/-- Combining the local derivative estimate with the coarse `L¹` estimate
gives a translation-uniform integral Hörmander bound for every compact
finite-regularity inverse-Fourier kernel. -/
theorem integral_norm_sub_translate_compact_cN_fourierInv_le_hormander
    {d N : Nat} (ψ : Euclidean d → Complex) (hψ : ContDiff Real N ψ)
    (hψ_supp : HasCompactSupport ψ) (hNd : d < N) (h : Euclidean d) :
    (∫ x : Euclidean d, ‖𝓕⁻ ψ (x + h) - 𝓕⁻ ψ x‖) ≤
      (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
        (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) := by
  by_cases hh : ‖h‖ ≤ 1
  · calc
      (∫ x : Euclidean d, ‖𝓕⁻ ψ (x + h) - 𝓕⁻ ψ x‖) ≤
          ‖h‖ * (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) :=
            integral_norm_sub_translate_compact_cN_fourierInv_le ψ hψ hψ_supp hNd h
      _ ≤ (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
          (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) := by
            have hderivnonneg : 0 ≤ ∫ x : Euclidean d,
                ‖fderiv Real (𝓕⁻ ψ) x‖ :=
              integral_nonneg fun _ => norm_nonneg _
            have hknonneg : 0 ≤ 2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖) := by
              positivity
            have hsmall : ‖h‖ * (∫ x : Euclidean d,
                ‖fderiv Real (𝓕⁻ ψ) x‖) ≤
                ∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖ := by
              simpa using mul_le_mul_of_nonneg_right hh hderivnonneg
            exact hsmall.trans <| by
              calc
                (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) =
                    0 + ∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖ := by ring
                _ ≤ (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
                    (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) :=
                  add_le_add_left hknonneg
                    (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖)
  · calc
      (∫ x : Euclidean d, ‖𝓕⁻ ψ (x + h) - 𝓕⁻ ψ x‖) ≤
          2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖) :=
            integral_norm_sub_translate_le_two_integral_norm (𝓕⁻ ψ)
              (compact_cN_fourierInv_integrable ψ hψ hψ_supp hNd) h
      _ ≤ (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
          (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) :=
            by
              have hderivnonneg : 0 ≤ ∫ x : Euclidean d,
                  ‖fderiv Real (𝓕⁻ ψ) x‖ :=
                integral_nonneg fun _ => norm_nonneg _
              calc
                2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖) =
                    (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) + 0 := by ring
                _ ≤ (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖)) +
                    (∫ x : Euclidean d, ‖fderiv Real (𝓕⁻ ψ) x‖) :=
                  add_le_add_right hderivnonneg
                    (2 * (∫ x : Euclidean d, ‖𝓕⁻ ψ x‖))

/-- Multiplying a punctured finite-regularity symbol by a compact cutoff
which vanishes near the origin produces a globally compact `C^N` symbol.
This is the regularity-and-support half of the dyadic localization in the
dimension-generic Mikhlin argument. -/
theorem contDiff_hasCompactSupport_cutoff_mul_punctured
    {d N : Nat} (χ m : Euclidean d → Complex) (r : Real) (hr : 0 < r)
    (hχ : ContDiff Real N χ) (hχ_supp : HasCompactSupport χ)
    (hχ_zero : ∀ x : Euclidean d, x ∈ Metric.ball 0 r → χ x = 0)
    (hm : ContDiffOn Real N m ({0}ᶜ : Set (Euclidean d))) :
    ContDiff Real N (fun x => χ x * m x) ∧
      HasCompactSupport (fun x => χ x * m x) := by
  have hoff : ContDiffOn Real N (fun x => χ x * m x) ({0}ᶜ : Set (Euclidean d)) :=
    hχ.contDiffOn.mul hm
  have hnear : ContDiffOn Real N (fun x => χ x * m x) (Metric.ball 0 r) := by
    have hzero : ContDiffOn Real N (fun _ : Euclidean d => (0 : Complex))
        (Metric.ball 0 r) :=
      (contDiff_const : ContDiff Real N (fun _ : Euclidean d =>
        (0 : Complex))).contDiffOn
    exact hzero.congr fun x hx => by simp [hχ_zero x hx]
  have hunion : ({0}ᶜ : Set (Euclidean d)) ∪ Metric.ball 0 r = Set.univ := by
    apply Set.eq_univ_of_forall
    intro x
    by_cases hx : x = 0
    · exact Set.mem_union_right _ (by simpa [hx] using hr)
    · exact Set.mem_union_left _ hx
  have hglobalOn : ContDiffOn Real N (fun x => χ x * m x) Set.univ := by
    rw [← hunion]
    exact hoff.union_of_isOpen hnear isOpen_compl_singleton Metric.isOpen_ball
  refine ⟨contDiffOn_univ.mp hglobalOn, ?_⟩
  exact hχ_supp.mul_right

/-! ## Smooth compact multiplier kernels

The full Mikhlin theorem will be obtained by summing dyadic pieces.  The
following elementary layer is useful independently: a Schwartz multiplier
and all of its positive dilates are dominated by the dyadic
Hardy--Littlewood maximal function.  Unlike the spherical lowpass theorem,
there is no surface multiplier in this statement.
-/

/-- The maximal family generated by a Schwartz Fourier multiplier at all
positive frequency scales. -/
def relativeSchwartzMultiplierRaw {d : Nat} (φ : SchwartzMap (Euclidean d) Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : ENNReal :=
  ⨆ r : Ioi (0 : Real), ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
    φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖

/-- The real-valued version of `relativeSchwartzMultiplierRaw`. -/
def relativeSchwartzMultiplier {d : Nat} (φ : SchwartzMap (Euclidean d) Complex)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : Real :=
  (relativeSchwartzMultiplierRaw φ f x).toReal

/- The dimensional constant from the physical-space Schwartz-kernel bound. -/
private def relativeSchwartzMultiplierConstant {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) : Real :=
  2 * ((SchwartzMap.seminorm Complex 0 0 (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) +
    SchwartzMap.seminorm Complex (d + 2) 0 (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex)) *
    (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (2 : Real) ^ (2 * d))

private theorem relativeSchwartzMultiplier_fixed_radius_majorant
    {d : Nat} (φ f : SchwartzMap (Euclidean d) Complex)
    (r : Ioi (0 : Real)) (x : Euclidean d) :
    ‖𝓕⁻ (fun ξ : Euclidean d =>
        φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖ ≤
      (relativeSchwartzMultiplierConstant φ + 1) *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  have hphysical :
      𝓕⁻ (fun ξ : Euclidean d =>
        φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x =
        ((fun y : Euclidean d => (r.1⁻¹) ^ d •
          (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) (r.1⁻¹ • y))
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x := by
    simpa using fourierInv_relative_lowpass_eq_convolution φ f r.2 x
  have hconv := norm_scaled_schwartz_convolution_le_dyadic_average_sup
    (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) f r.2 x
  have hC : 0 ≤ relativeSchwartzMultiplierConstant φ := by
    dsimp only [relativeSchwartzMultiplierConstant]
    positivity
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  calc
    ‖𝓕⁻ (fun ξ : Euclidean d =>
        φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖ =
        ‖((fun y : Euclidean d => (r.1⁻¹) ^ d •
          (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) (r.1⁻¹ • y))
          ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x‖ := congrArg norm hphysical
    _ ≤ 2 * ((SchwartzMap.seminorm Complex 0 0
          (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) +
        SchwartzMap.seminorm Complex (d + 2) 0
          (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex)) *
        (dyadicBallMaximal d (f : Euclidean d → Complex) x *
          (volume (Metric.ball (0 : Euclidean d) 1)).toReal) *
        (2 : Real) ^ (2 * d)) := by
          simpa only [dyadicBallMaximal, dyadicBallMaximalRaw] using hconv
    _ = relativeSchwartzMultiplierConstant φ *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by
          dsimp only [relativeSchwartzMultiplierConstant]
          ring
    _ ≤ (relativeSchwartzMultiplierConstant φ + 1) *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by
          apply mul_le_mul_of_nonneg_right
          · linarith
          · exact hH

/-- Uniform positive-scale Schwartz multipliers are pointwise dominated by a
dyadic Hardy--Littlewood maximal function. -/
theorem exists_relativeSchwartzMultiplier_majorant {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), relativeSchwartzMultiplier φ f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  let K : Real := relativeSchwartzMultiplierConstant φ + 1
  have hC : 0 ≤ relativeSchwartzMultiplierConstant φ := by
    dsimp only [relativeSchwartzMultiplierConstant]
    positivity
  have hK : 0 < K := by
    dsimp only [K]
    linarith
  refine ⟨K, hK, ?_⟩
  intro f x
  have hsup : relativeSchwartzMultiplierRaw φ f x ≤
      ENNReal.ofReal (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
    apply iSup_le
    intro r
    exact ENNReal.ofReal_le_ofReal
      (relativeSchwartzMultiplier_fixed_radius_majorant φ f r x)
  calc
    relativeSchwartzMultiplier φ f x =
        (relativeSchwartzMultiplierRaw φ f x).toReal := rfl
    _ ≤ (ENNReal.ofReal (K * dyadicBallMaximal d
        (f : Euclidean d → Complex) x)).toReal :=
      (ENNReal.toReal_le_toReal
        (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hsup)
        ENNReal.ofReal_ne_top).2 hsup
    _ = K * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
      ENNReal.toReal_ofReal
        (mul_nonneg hK.le ENNReal.toReal_nonneg)

/-- The positive-scale Schwartz multiplier maximal family is measurable on
Schwartz inputs. -/
theorem relativeSchwartzMultiplier_aestronglyMeasurable {d : Nat}
    (φ f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable (relativeSchwartzMultiplier φ f) volume := by
  let R : Euclidean d → Real := fun x =>
    (⨆ r : Ioi (0 : Real), ENNReal.ofReal ‖𝓕⁻ (fun ξ : Euclidean d =>
      φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖).toReal
  change AEStronglyMeasurable R volume
  apply (ENNReal.measurable_toReal.comp ?_).aestronglyMeasurable
  apply LowerSemicontinuous.measurable
  apply lowerSemicontinuous_iSup
  intro r
  have hrinv : 0 < r.1⁻¹ := inv_pos.mpr r.2
  have hcont : Continuous (fun x : Euclidean d =>
      𝓕⁻ (fun ξ : Euclidean d => φ (r.1 • ξ) *
        𝓕 (f : Euclidean d → Complex) ξ) x) := by
    simpa [inv_inv] using
      (continuous_fourierInv_scaled_schwartz_multiplier φ f hrinv)
  exact (ENNReal.continuous_ofReal.comp hcont.norm).lowerSemicontinuous

/-! ### Calderón--Zygmund endpoint transfer

The physical Schwartz-kernel estimate above is stronger than an individual
Young inequality: it controls the supremum over every relative frequency
scale by the dyadic Hardy--Littlewood maximal function.  The following
small transfer lemma records the resulting weak `(1,1)` endpoint in a form
which can be reused by both scalar and parameter-uniform multiplier
families.  It deliberately does not assume measurability of `T`; a pointwise
majorant is enough for the distributional estimate.
-/

/-- A pointwise dyadic-maximal majorant transfers to a weak `(1,1)` bound.
The constant is explicit and does not depend on the particular Schwartz
input. -/
theorem weak_one_of_dyadicBall_majorant_fixed
    {d : Nat} (hd : 0 < d) {K : Real} (hK : 0 < K)
    (T : SchwartzMap (Euclidean d) Complex → Euclidean d → Real)
    (hmajor : ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T f x ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∀ (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
      ENNReal.ofReal s * volume {x | s < T f x} ≤
        (ENNReal.ofReal K * (ENNReal.ofReal (4 : Real)) ^ d) *
          ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  intro f s hs
  let I : ENNReal := ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖
  have hweak : ∀ {t : Real}, 0 < t →
      ENNReal.ofReal t * volume {x | t <
        dyadicBallMaximal d (f : Euclidean d → Complex) x} ≤
        (ENNReal.ofReal (4 : Real)) ^ d * I := by
    intro t ht
    simpa only [I] using
      (dyadic_ball_maximal_toReal_weak_one hd
        (f : Euclidean d → Complex) ht)
  have hscaled :=
    Auto.Spherical.InterpolationCore.marcinkiewicz_scale_weak_one
      (dyadicBallMaximal d) ((ENNReal.ofReal (4 : Real)) ^ d) I
      (f : Euclidean d → Complex) hweak K s hK hs
  have hset : {x | s < T f x} ⊆
      {x | s < K * dyadicBallMaximal d (f : Euclidean d → Complex) x} := by
    intro x hx
    exact hx.trans_le (hmajor f x)
  calc
    ENNReal.ofReal s * volume {x | s < T f x} ≤
        ENNReal.ofReal s * volume
          {x | s < K * dyadicBallMaximal d (f : Euclidean d → Complex) x} :=
      mul_le_mul_of_nonneg_left (measure_mono hset) (by positivity)
    _ ≤ (ENNReal.ofReal K * (ENNReal.ofReal (4 : Real)) ^ d) * I := hscaled
    _ = (ENNReal.ofReal K * (ENNReal.ofReal (4 : Real)) ^ d) *
          ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
      rfl

/-- Existential-constant version of
`weak_one_of_dyadicBall_majorant_fixed`. -/
theorem weak_one_of_dyadicBall_majorant
    {d : Nat} (hd : 0 < d) {K : Real} (hK : 0 < K)
    (T : SchwartzMap (Euclidean d) Complex → Euclidean d → Real)
    (hmajor : ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T f x ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
        ENNReal.ofReal s * volume {x | s < T f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  let C : ENNReal := ENNReal.ofReal K * (ENNReal.ofReal (4 : Real)) ^ d
  have hCpos : 0 < C := by
    dsimp only [C]
    exact ENNReal.mul_pos
      (ne_of_gt (ENNReal.ofReal_pos.mpr hK))
      (ne_of_gt (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _))
  have hCtop : C ≠ ∞ := by
    dsimp only [C]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
  refine ⟨C, hCpos, hCtop, ?_⟩
  intro f s hs
  simpa only [C] using
    weak_one_of_dyadicBall_majorant_fixed hd hK T hmajor f hs

/-- Positive-scale Schwartz multiplier maximal families satisfy weak
`(1,1)`.  This is the compact-kernel Calderón--Zygmund endpoint complementary
to `relativeSchwartzMultiplier_strong_type`. -/
theorem relativeSchwartzMultiplier_weak_one
    {d : Nat} (hd : 0 < d) (φ : SchwartzMap (Euclidean d) Complex) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
        ENNReal.ofReal s * volume {x | s < relativeSchwartzMultiplier φ f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  obtain ⟨K, hK, hmajor⟩ := exists_relativeSchwartzMultiplier_majorant φ
  exact weak_one_of_dyadicBall_majorant hd hK
    (fun f x => relativeSchwartzMultiplier φ f x) hmajor

/-- Every positive-scale Schwartz multiplier maximal family has a strong
`(p,p)` estimate in every positive dimension for `p > 1`. -/
theorem relativeSchwartzMultiplier_strong_type
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p)
    (φ : SchwartzMap (Euclidean d) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (relativeSchwartzMultiplier φ f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (relativeSchwartzMultiplier φ f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨K, hK, hmajor⟩ := exists_relativeSchwartzMultiplier_majorant φ
  obtain ⟨B, hB, hball⟩ :=
    dyadic_hardy_littlewood_maximal_strong_type_schwartz hd hp
  refine ⟨K ^ p * B, mul_pos (Real.rpow_pos_of_pos hK _) hB, ?_⟩
  intro f
  have hballf := hball f
  have hp0 : 0 < p := by linarith
  have hRnonneg (x : Euclidean d) : 0 ≤ relativeSchwartzMultiplier φ f x :=
    ENNReal.toReal_nonneg
  have hHnonneg (x : Euclidean d) :
      0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  have hRmem : MemLp (relativeSchwartzMultiplier φ f) (ENNReal.ofReal p) volume :=
    (hballf.1.const_mul K).mono
      (relativeSchwartzMultiplier_aestronglyMeasurable φ f)
      (Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hRnonneg x), Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg hK.le (hHnonneg x))]
        exact hmajor f x)
  refine ⟨hRmem, ?_⟩
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hKHmem : MemLp (fun x : Euclidean d =>
      K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
      (ENNReal.ofReal p) volume := hballf.1.const_mul K
  have hKHPowInt : Integrable (fun x : Euclidean d =>
      (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) volume := by
    have h := hKHmem.integrable_norm_rpow hpEN0 hpENT
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hK.le (hHnonneg x)),
      ENNReal.toReal_ofReal hp0.le]
  calc
    (∫ x : Euclidean d, (relativeSchwartzMultiplier φ f x) ^ p) ≤
        ∫ x : Euclidean d,
          (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_nonneg (hRnonneg x) p
          · exact hKHPowInt
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_le_rpow (hRnonneg x) (hmajor f x) hp0.le
    _ = K ^ p * ∫ x : Euclidean d,
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          rw [show (fun x : Euclidean d =>
              (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) =
              fun x => K ^ p *
                (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p by
                funext x
                exact Real.mul_rpow hK.le (hHnonneg x)]
          rw [integral_const_mul]
    _ ≤ K ^ p * (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
          exact mul_le_mul_of_nonneg_left hballf.2 (Real.rpow_nonneg hK.le p)
    _ = (K ^ p * B) * ∫ x : Euclidean d, ‖f x‖ ^ p := by ring

/-! ### Uniform Schwartz multiplier families

The cutoff multipliers in the circular-maximal argument occur in finite
families depending on a radius or a sign.  Their kernels are uniformly
Schwartz, so the preceding maximal-function proof is uniform as soon as the
two kernel seminorms which occur in it are uniform.  This is the compact
smooth, parameter-uniform part of the Mikhlin mechanism.
-/

/-- The two physical-space Schwartz seminorms used by the radial-kernel
majorant. -/
def relativeSchwartzMultiplierKernelSize {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) : Real :=
  SchwartzMap.seminorm Complex 0 0 (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex) +
    SchwartzMap.seminorm Complex (d + 2) 0
      (𝓕⁻ φ : SchwartzMap (Euclidean d) Complex)

/-- A finite Fourier-side estimate for the two physical Schwartz seminorms
used by the relative multiplier majorant.  It is dimension-generic: the
zeroth physical bound is Fourier `L¹`, while the weighted one is supplied by
`d + 2` integrations by parts. -/
theorem relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) :
    relativeSchwartzMultiplierKernelSize φ ≤
      (∫ ξ : Euclidean d, ‖φ ξ‖) +
        compactFourierIBPConstant (N := d + 2) (φ : Euclidean d → Complex) := by
  unfold relativeSchwartzMultiplierKernelSize
  apply add_le_add
  · apply SchwartzMap.seminorm_le_bound Complex 0 0 (fourierInv φ)
      (integral_nonneg fun _ => norm_nonneg _)
    intro x
    simp only [pow_zero, one_mul, norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖fourierInv (φ : Euclidean d → Complex) x‖ ≤ _
    rw [Real.fourierInv_eq_fourier_neg]
    change ‖VectorFourier.fourierIntegral Real.fourierChar volume
      (innerSL Real).toLinearMap₁₂ (φ : Euclidean d → Complex) (-x)‖ ≤ _
    exact VectorFourier.norm_fourierIntegral_le_integral_norm
      Real.fourierChar volume (innerSL Real).toLinearMap₁₂
        (φ : Euclidean d → Complex) (-x)
  · apply SchwartzMap.seminorm_le_bound Complex (d + 2) 0 (fourierInv φ)
      (by
        unfold compactFourierIBPConstant
        exact mul_nonneg (by positivity)
          (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _))
    intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ (d + 2) * ‖fourierInv (φ : Euclidean d → Complex) x‖ ≤ _
    exact pow_norm_fourierInv_le_compactFourierIBPConstant
      (φ : Euclidean d → Complex)
      (by
        have htop : ((d + 2 : Nat) : WithTop ENat) ≤
            ((⊤ : ENat) : WithTop ENat) := by
          exact WithTop.coe_le_coe.mpr le_top
        exact (φ.smooth (⊤ : ENat)).of_le (by
          simpa only [Nat.cast_add, Nat.cast_ofNat] using htop))
      (fun n _ => by
        simpa using φ.integrable_pow_mul_iteratedFDeriv volume 0 n)
      x

/-- The dimensional factor in the physical-space Schwartz-kernel majorant. -/
def relativeSchwartzMultiplierGeometricFactor (d : Nat) : Real :=
  2 * (volume (Metric.ball (0 : Euclidean d) 1)).toReal * (2 : Real) ^ (2 * d)

/-- The literal physical kernel of the relative multiplier
`ξ ↦ φ (r • ξ)`.  Its spatial scale is `r`, hence its dilation parameter is
`r⁻¹`. -/
def relativeSchwartzMultiplierKernel {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) (r : Real) :
    Euclidean d → Complex := fun y =>
  (r⁻¹) ^ d • (fourierInv φ : SchwartzMap (Euclidean d) Complex) (r⁻¹ • y)

/-- The derivative `L¹` size controlling translations of a compact smooth
multiplier kernel.  This is the quantitative Hörmander datum used after
mean-zero cancellation. -/
def relativeSchwartzMultiplierKernelHormanderSize {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) : Real :=
  ∫ x : Euclidean d, ‖fderiv Real
    ((fourierInv φ : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) x‖

/-- The derivative of the inverse-Fourier Schwartz kernel is integrable. -/
theorem integrable_fderiv_fourierInv_schwartzMultiplierKernel
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) :
    Integrable (fderiv Real
      ((fourierInv φ : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex))
      volume := by
  let D : SchwartzMap (Euclidean d) (Euclidean d →L[Real] Complex) :=
    (SchwartzMap.fderivCLM Complex (Euclidean d) Complex) (fourierInv φ)
  have hD : (D : Euclidean d → (Euclidean d →L[Real] Complex)) =
      fderiv Real
        ((fourierInv φ : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex) := by
    funext x
    exact SchwartzMap.fderivCLM_apply Complex (fourierInv φ) x
  rw [← hD]
  exact D.integrable

/-- The Hörmander size is nonnegative. -/
theorem relativeSchwartzMultiplierKernelHormanderSize_nonneg
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) :
    0 ≤ relativeSchwartzMultiplierKernelHormanderSize φ := by
  exact integral_nonneg fun _ => norm_nonneg _

/-- The relative Fourier multiplier is convolution with its literal
physical kernel. -/
theorem fourierInv_relativeSchwartzMultiplier_eq_convolution
    {d : Nat} (φ f : SchwartzMap (Euclidean d) Complex) {r : Real}
    (hr : 0 < r) (x : Euclidean d) :
    fourierInv (fun ξ : Euclidean d =>
      φ (r • ξ) * fourier (f : Euclidean d → Complex) ξ) x =
      (relativeSchwartzMultiplierKernel φ r
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x := by
  change fourierInv (fun ξ : Euclidean d =>
      φ (r • ξ) * fourier (f : Euclidean d → Complex) ξ) x =
    ((fun y : Euclidean d => (r⁻¹) ^ d •
      (fourierInv φ : SchwartzMap (Euclidean d) Complex) (r⁻¹ • y))
      ⋆[ContinuousLinearMap.mul Complex Complex, volume]
        (f : Euclidean d → Complex)) x
  exact fourierInv_relative_lowpass_eq_convolution φ f hr x

/-- Translation of a relative Schwartz multiplier kernel loses exactly one
inverse frequency scale.  This is the standard integral Hörmander estimate
for one dyadic kernel; it is dimension-generic. -/
theorem integral_norm_relativeSchwartzMultiplierKernel_sub_translate_le
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) {r : Real}
    (hr : 0 < r) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖relativeSchwartzMultiplierKernel φ r (x + h) -
        relativeSchwartzMultiplierKernel φ r x‖) ≤
      ‖h‖ * r⁻¹ * relativeSchwartzMultiplierKernelHormanderSize φ := by
  let A : Euclidean d ≃L[Real] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 r⁻¹ (inv_ne_zero hr.ne'))
  let K : SchwartzMap (Euclidean d) Complex :=
    (r⁻¹) ^ d • (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) (fourierInv φ)
  have hKform (y : Euclidean d) : K y =
      relativeSchwartzMultiplierKernel φ r y := by
    change (r⁻¹) ^ d • (fourierInv φ : SchwartzMap (Euclidean d) Complex) (A y) = _
    simp [A, relativeSchwartzMultiplierKernel]
  have hKdiff : ContDiff Real 1 (K : Euclidean d → Complex) := by
    simpa using K.smooth (1 : ℕ∞)
  have hKderiv : Integrable (fderiv Real (K : Euclidean d → Complex)) volume := by
    let DK : SchwartzMap (Euclidean d) (Euclidean d →L[Real] Complex) :=
      (SchwartzMap.fderivCLM Complex (Euclidean d) Complex) K
    have hDK : (DK : Euclidean d → (Euclidean d →L[Real] Complex)) =
        fderiv Real (K : Euclidean d → Complex) := by
      funext x
      exact SchwartzMap.fderivCLM_apply Complex K x
    rw [← hDK]
    exact DK.integrable
  have htranslate :
      (∫ x : Euclidean d, ‖K (x + h) - K x‖) ≤
        ‖h‖ * ∫ x : Euclidean d, ‖fderiv Real (K : Euclidean d → Complex) x‖ :=
    Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.integral_norm_sub_translate_le_norm_mul_integral_norm_fderiv
        (K : Euclidean d → Complex) hKdiff hKderiv h
  have hderiv :
      (∫ x : Euclidean d, ‖fderiv Real (K : Euclidean d → Complex) x‖) =
        r⁻¹ * relativeSchwartzMultiplierKernelHormanderSize φ := by
    rw [show (K : Euclidean d → Complex) =
        fun y : Euclidean d => (r⁻¹) ^ d •
          (fourierInv φ : SchwartzMap (Euclidean d) Complex) (r⁻¹ • y) by
      funext y
      simpa only [relativeSchwartzMultiplierKernel] using hKform y]
    exact integral_norm_fderiv_dilate_eq
      ((fourierInv φ : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex)
      (by simpa using (fourierInv φ).smooth (1 : ℕ∞)) (inv_pos.mpr hr)
  calc
    (∫ x : Euclidean d,
      ‖relativeSchwartzMultiplierKernel φ r (x + h) -
        relativeSchwartzMultiplierKernel φ r x‖) =
        ∫ x : Euclidean d, ‖K (x + h) - K x‖ := by
          apply integral_congr_ae
          filter_upwards with x
          rw [hKform (x + h), hKform x]
    _ ≤ ‖h‖ * ∫ x : Euclidean d, ‖fderiv Real (K : Euclidean d → Complex) x‖ :=
      htranslate
    _ = ‖h‖ * r⁻¹ * relativeSchwartzMultiplierKernelHormanderSize φ := by
      rw [hderiv]
      ring

/-- Uniform derivative-kernel data gives one uniform Hörmander translation
bound for a whole multiplier family. -/
theorem uniform_integral_norm_relativeSchwartzMultiplierKernel_sub_translate_le
    {d : Nat} {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    {A : Real}
    (hφ : ∀ u, relativeSchwartzMultiplierKernelHormanderSize (φ u) ≤ A)
    (u : ι) {r : Real} (hr : 0 < r) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖relativeSchwartzMultiplierKernel (φ u) r (x + h) -
        relativeSchwartzMultiplierKernel (φ u) r x‖) ≤
      ‖h‖ * r⁻¹ * A := by
  calc
    (∫ x : Euclidean d,
      ‖relativeSchwartzMultiplierKernel (φ u) r (x + h) -
        relativeSchwartzMultiplierKernel (φ u) r x‖) ≤
        ‖h‖ * r⁻¹ * relativeSchwartzMultiplierKernelHormanderSize (φ u) :=
      integral_norm_relativeSchwartzMultiplierKernel_sub_translate_le (φ u) hr h
    _ ≤ ‖h‖ * r⁻¹ * A := by
      apply mul_le_mul_of_nonneg_left (hφ u)
      exact mul_nonneg (norm_nonneg _) (inv_nonneg.mpr hr.le)

private theorem relativeSchwartzMultiplierConstant_eq
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) :
    relativeSchwartzMultiplierConstant φ =
      relativeSchwartzMultiplierGeometricFactor d *
        relativeSchwartzMultiplierKernelSize φ := by
  simp only [relativeSchwartzMultiplierConstant,
    relativeSchwartzMultiplierGeometricFactor,
    relativeSchwartzMultiplierKernelSize]
  ring

/-- A uniform bound on the two kernel seminorms gives a uniform
Hardy--Littlewood majorant for a Schwartz multiplier family. -/
theorem relativeSchwartzMultiplier_majorant_of_kernel_bound
    {d : Nat} (φ : SchwartzMap (Euclidean d) Complex) {A : Real}
    (hA : 0 ≤ A) (hφ : relativeSchwartzMultiplierKernelSize φ ≤ A) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), relativeSchwartzMultiplier φ f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  let G : Real := relativeSchwartzMultiplierGeometricFactor d
  let K : Real := G * A + 1
  have hG : 0 ≤ G := by
    dsimp only [G, relativeSchwartzMultiplierGeometricFactor]
    positivity
  have hconstant : relativeSchwartzMultiplierConstant φ ≤ G * A := by
    rw [relativeSchwartzMultiplierConstant_eq]
    exact mul_le_mul_of_nonneg_left hφ hG
  have hK : 0 < K := by
    dsimp only [K]
    have : 0 ≤ G * A := mul_nonneg hG hA
    linarith
  refine ⟨K, hK, ?_⟩
  intro f x
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  have hsup : relativeSchwartzMultiplierRaw φ f x ≤
      ENNReal.ofReal (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
    apply iSup_le
    intro r
    apply ENNReal.ofReal_le_ofReal
    calc
      ‖𝓕⁻ (fun ξ : Euclidean d =>
          φ (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖ ≤
          (relativeSchwartzMultiplierConstant φ + 1) *
            dyadicBallMaximal d (f : Euclidean d → Complex) x :=
        relativeSchwartzMultiplier_fixed_radius_majorant φ f r x
      _ ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
        apply mul_le_mul_of_nonneg_right _ hH
        dsimp only [K]
        linarith
  calc
    relativeSchwartzMultiplier φ f x =
        (relativeSchwartzMultiplierRaw φ f x).toReal := rfl
    _ ≤ (ENNReal.ofReal (K * dyadicBallMaximal d
        (f : Euclidean d → Complex) x)).toReal :=
      (ENNReal.toReal_le_toReal
        (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hsup)
        ENNReal.ofReal_ne_top).2 hsup
    _ = K * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
      ENNReal.toReal_ofReal
        (mul_nonneg hK.le ENNReal.toReal_nonneg)

/-- A uniformly bounded family of Schwartz kernels has one common
Hardy--Littlewood majorant at every positive frequency scale. -/
theorem uniform_relativeSchwartzMultiplier_majorant_of_kernel_bound
    {d : Nat} {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ K : Real, 0 < K ∧ ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), relativeSchwartzMultiplier (φ u) f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  let G : Real := relativeSchwartzMultiplierGeometricFactor d
  let K : Real := G * A + 1
  have hG : 0 ≤ G := by
    dsimp only [G, relativeSchwartzMultiplierGeometricFactor]
    positivity
  have hK : 0 < K := by
    dsimp only [K]
    have : 0 ≤ G * A := mul_nonneg hG hA
    linarith
  refine ⟨K, hK, ?_⟩
  intro u f x
  have hconstant : relativeSchwartzMultiplierConstant (φ u) ≤ G * A := by
    rw [relativeSchwartzMultiplierConstant_eq]
    exact mul_le_mul_of_nonneg_left (hφ u) hG
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  have hsup : relativeSchwartzMultiplierRaw (φ u) f x ≤
      ENNReal.ofReal (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
    apply iSup_le
    intro r
    apply ENNReal.ofReal_le_ofReal
    calc
      ‖𝓕⁻ (fun ξ : Euclidean d =>
          φ u (r.1 • ξ) * 𝓕 (f : Euclidean d → Complex) ξ) x‖ ≤
          (relativeSchwartzMultiplierConstant (φ u) + 1) *
            dyadicBallMaximal d (f : Euclidean d → Complex) x :=
        relativeSchwartzMultiplier_fixed_radius_majorant (φ u) f r x
      _ ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
        apply mul_le_mul_of_nonneg_right _ hH
        dsimp only [K]
        linarith
  calc
    relativeSchwartzMultiplier (φ u) f x =
        (relativeSchwartzMultiplierRaw (φ u) f x).toReal := rfl
    _ ≤ (ENNReal.ofReal (K * dyadicBallMaximal d
        (f : Euclidean d → Complex) x)).toReal :=
      (ENNReal.toReal_le_toReal
        (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hsup)
        ENNReal.ofReal_ne_top).2 hsup
    _ = K * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
      ENNReal.toReal_ofReal
        (mul_nonneg hK.le ENNReal.toReal_nonneg)

/- A common Hardy--Littlewood majorant gives a common strong `Lᵖ` bound for
a family of positive-scale Schwartz multipliers. -/
/-- A common dyadic-maximal majorant gives a common weak `(1,1)` endpoint
for a parameter family of compact smooth multipliers. -/
theorem uniform_relativeSchwartzMultiplier_weak_one_of_majorant
    {d : Nat} (hd : 0 < d) {K : Real} (hK : 0 < K)
    {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    (hmajor : ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), relativeSchwartzMultiplier (φ u) f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
        ENNReal.ofReal s * volume {x | s < relativeSchwartzMultiplier (φ u) f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  let C : ENNReal := ENNReal.ofReal K * (ENNReal.ofReal (4 : Real)) ^ d
  have hCpos : 0 < C := by
    dsimp only [C]
    exact ENNReal.mul_pos
      (ne_of_gt (ENNReal.ofReal_pos.mpr hK))
      (ne_of_gt (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by norm_num)) _))
  have hCtop : C ≠ ∞ := by
    dsimp only [C]
    exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      (ENNReal.pow_ne_top ENNReal.ofReal_ne_top)
  refine ⟨C, hCpos, hCtop, ?_⟩
  intro u f s hs
  simpa only [C] using
    weak_one_of_dyadicBall_majorant_fixed hd hK
      (fun g x => relativeSchwartzMultiplier (φ u) g x)
      (fun g x => hmajor u g x) f hs

/-- The kernel-seminorm form of the uniform weak `(1,1)` compact multiplier
endpoint. -/
theorem uniform_relativeSchwartzMultiplier_weak_one_of_kernel_bound
    {d : Nat} (hd : 0 < d) {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) {A : Real}
    (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
        ENNReal.ofReal s * volume {x | s < relativeSchwartzMultiplier (φ u) f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  obtain ⟨K, hK, hmajor⟩ :=
    uniform_relativeSchwartzMultiplier_majorant_of_kernel_bound φ hA hφ
  exact uniform_relativeSchwartzMultiplier_weak_one_of_majorant
    hd hK φ hmajor

/-- A common Hardy--Littlewood majorant gives a common strong `Lᵖ` bound for
a family of positive-scale Schwartz multipliers. -/
theorem uniform_relativeSchwartzMultiplier_strong_type_of_majorant
    {d : Nat} (hd : 0 < d) {p K : Real} (hp : 1 < p) (hK : 0 < K)
    {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    (hmajor : ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), relativeSchwartzMultiplier (φ u) f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : Real, 0 < C ∧ ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex),
      MemLp (relativeSchwartzMultiplier (φ u) f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (relativeSchwartzMultiplier (φ u) f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨B, hB, hball⟩ :=
    dyadic_hardy_littlewood_maximal_strong_type_schwartz hd hp
  refine ⟨K ^ p * B, mul_pos (Real.rpow_pos_of_pos hK _) hB, ?_⟩
  intro u f
  have hballf := hball f
  have hp0 : 0 < p := by linarith
  have hRnonneg (x : Euclidean d) :
      0 ≤ relativeSchwartzMultiplier (φ u) f x := ENNReal.toReal_nonneg
  have hHnonneg (x : Euclidean d) :
      0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  have hRmem : MemLp (relativeSchwartzMultiplier (φ u) f)
      (ENNReal.ofReal p) volume :=
    (hballf.1.const_mul K).mono
      (relativeSchwartzMultiplier_aestronglyMeasurable (φ u) f)
      (Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hRnonneg x), Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg hK.le (hHnonneg x))]
        exact hmajor u f x)
  refine ⟨hRmem, ?_⟩
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ⊤ := ENNReal.ofReal_ne_top
  have hKHmem : MemLp (fun x : Euclidean d =>
      K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
      (ENNReal.ofReal p) volume := hballf.1.const_mul K
  have hKHPowInt : Integrable (fun x : Euclidean d =>
      (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) volume := by
    have h := hKHmem.integrable_norm_rpow hpEN0 hpENT
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hK.le (hHnonneg x)),
      ENNReal.toReal_ofReal hp0.le]
  calc
    (∫ x : Euclidean d, (relativeSchwartzMultiplier (φ u) f x) ^ p) ≤
        ∫ x : Euclidean d,
          (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_nonneg (hRnonneg x) p
          · exact hKHPowInt
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_le_rpow (hRnonneg x) (hmajor u f x) hp0.le
    _ = K ^ p * ∫ x : Euclidean d,
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          rw [show (fun x : Euclidean d =>
              (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) =
              fun x => K ^ p *
                (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p by
                funext x
                exact Real.mul_rpow hK.le (hHnonneg x)]
          rw [integral_const_mul]
    _ ≤ K ^ p * (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
          exact mul_le_mul_of_nonneg_left hballf.2 (Real.rpow_nonneg hK.le p)
    _ = (K ^ p * B) * ∫ x : Euclidean d, ‖f x‖ ^ p := by ring

/-- The parameter-uniform compact smooth multiplier theorem.  It is the
Schwartz-kernel form of Mikhlin used for annularly localized symbols. -/
theorem uniform_relativeSchwartzMultiplier_strong_type_of_kernel_bound
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p) {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) {A : Real}
    (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex),
      MemLp (relativeSchwartzMultiplier (φ u) f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (relativeSchwartzMultiplier (φ u) f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨K, hK, hmajor⟩ :=
    uniform_relativeSchwartzMultiplier_majorant_of_kernel_bound φ hA hφ
  exact uniform_relativeSchwartzMultiplier_strong_type_of_majorant hd hp hK φ hmajor

/-- A measurable nonnegative operator dominated by the dyadic maximal
function has the same strong `(p,p)` range.  This is the reusable real-variable
endpoint transfer behind the compact multiplier estimates. -/
theorem strong_type_of_dyadicBall_majorant
    {d : Nat} (hd : 0 < d) {p K : Real} (hp : 1 < p) (hK : 0 < K)
    (T : SchwartzMap (Euclidean d) Complex → Euclidean d → Real)
    (hTnonneg : ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      0 ≤ T f x)
    (hTmeas : ∀ f : SchwartzMap (Euclidean d) Complex,
      AEStronglyMeasurable (T f) volume)
    (hmajor : ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      T f x ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (T f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (T f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨B, hB, hball⟩ :=
    dyadic_hardy_littlewood_maximal_strong_type_schwartz hd hp
  refine ⟨K ^ p * B, mul_pos (Real.rpow_pos_of_pos hK _) hB, ?_⟩
  intro f
  have hballf := hball f
  have hp0 : 0 < p := by linarith
  have hHnonneg (x : Euclidean d) :
      0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  have hTmem : MemLp (T f) (ENNReal.ofReal p) volume :=
    (hballf.1.const_mul K).mono
      (hTmeas f)
      (Filter.Eventually.of_forall fun x => by
        rw [Real.norm_eq_abs, abs_of_nonneg (hTnonneg f x), Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg hK.le (hHnonneg x))]
        exact hmajor f x)
  refine ⟨hTmem, ?_⟩
  have hpEN0 : ENNReal.ofReal p ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hp0
  have hpENT : ENNReal.ofReal p ≠ ∞ := ENNReal.ofReal_ne_top
  have hKHmem : MemLp (fun x : Euclidean d =>
      K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
      (ENNReal.ofReal p) volume := hballf.1.const_mul K
  have hKHPowInt : Integrable (fun x : Euclidean d =>
      (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) volume := by
    have h := hKHmem.integrable_norm_rpow hpEN0 hpENT
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hK.le (hHnonneg x)),
      ENNReal.toReal_ofReal hp0.le]
  calc
    (∫ x : Euclidean d, (T f x) ^ p) ≤
        ∫ x : Euclidean d,
          (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_nonneg (hTnonneg f x) p
          · exact hKHPowInt
          · exact Filter.Eventually.of_forall fun x =>
              Real.rpow_le_rpow (hTnonneg f x) (hmajor f x) hp0.le
    _ = K ^ p * ∫ x : Euclidean d,
        (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p := by
          rw [show (fun x : Euclidean d =>
              (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p) =
              fun x => K ^ p *
                (dyadicBallMaximal d (f : Euclidean d → Complex) x) ^ p by
                funext x
                exact Real.mul_rpow hK.le (hHnonneg x)]
          rw [integral_const_mul]
    _ ≤ K ^ p * (B * ∫ x : Euclidean d, ‖f x‖ ^ p) := by
          exact mul_le_mul_of_nonneg_left hballf.2 (Real.rpow_nonneg hK.le p)
    _ = (K ^ p * B) * ∫ x : Euclidean d, ‖f x‖ ^ p := by ring

/-- One member of a relative multiplier family at a specified positive
frequency scale. -/
def relativeSchwartzMultiplierAt {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) (r : Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) : Euclidean d → Complex := fun x =>
  fourierInv (fun ξ : Euclidean d =>
    φ (r.1 • ξ) * fourier (f : Euclidean d → Complex) ξ) x

/-- The Schwartz frequency symbol underlying one member of a relative
multiplier family.  Packaging the dilation as a `SchwartzMap` allows the
finite vector-valued `L²` calculation to use Plancherel without estimating
the members one at a time. -/
def relativeSchwartzMultiplierSymbol {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) (r : Ioi (0 : Real)) :
    SchwartzMap (Euclidean d) Complex :=
  let A : Euclidean d ≃L[Real] Euclidean d :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 r.1 (ne_of_gt r.2))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) φ

/-- Literal formula for the dilated Schwartz symbol. -/
theorem relativeSchwartzMultiplierSymbol_apply {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) (r : Ioi (0 : Real))
    (ξ : Euclidean d) :
    relativeSchwartzMultiplierSymbol φ r ξ = φ (r.1 • ξ) := by
  simp [relativeSchwartzMultiplierSymbol]

/-- Rewriting a relative multiplier through its packaged Schwartz symbol. -/
theorem relativeSchwartzMultiplierAt_eq_fourierInv_symbol {d : Nat}
    (φ : SchwartzMap (Euclidean d) Complex) (r : Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    relativeSchwartzMultiplierAt φ r f x =
      fourierInv (fun ξ : Euclidean d =>
        relativeSchwartzMultiplierSymbol φ r ξ *
          fourier (f : Euclidean d → Complex) ξ) x := by
  simp only [relativeSchwartzMultiplierAt,
    relativeSchwartzMultiplierSymbol_apply]

/-- The pointwise square energy of a finite family of relative Schwartz
multipliers.  This is the natural vector-valued quantity: unlike a norm of
the sum, its `L²` norm only sees the Fourier-side square overlap. -/
def finiteRelativeSchwartzMultiplierSquareEnergy {d : Nat} {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) : Real :=
  ∑ u ∈ s, ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ^ (2 : Nat)

/-- The finite square function associated to a relative Schwartz multiplier
family. -/
noncomputable def finiteRelativeSchwartzMultiplierSquareFunction {d : Nat} {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) : Real :=
  √(finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x)

/-- The finite vector energy is pointwise nonnegative. -/
theorem finiteRelativeSchwartzMultiplierSquareEnergy_nonneg {d : Nat} {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) :
    0 ≤ finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x := by
  unfold finiteRelativeSchwartzMultiplierSquareEnergy
  exact Finset.sum_nonneg fun u hu => sq_nonneg _

/-- Squaring the finite relative multiplier square function recovers its
literal finite energy. -/
theorem sq_finiteRelativeSchwartzMultiplierSquareFunction {d : Nat} {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) :
    finiteRelativeSchwartzMultiplierSquareFunction s φ r f x ^ (2 : Nat) =
      finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x := by
  unfold finiteRelativeSchwartzMultiplierSquareFunction
  exact Real.sq_sqrt
    (finiteRelativeSchwartzMultiplierSquareEnergy_nonneg s φ r f x)

/-- Exact finite Plancherel identity for relative multiplier vector energy.
This is kept before applying any overlap estimate, so it can also be used
with nonuniform multiplier families. -/
theorem integral_finiteRelativeSchwartzMultiplierSquareEnergy_eq_frequency
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) =
      ∑ u ∈ s, ∫ ξ : Euclidean d,
        ‖relativeSchwartzMultiplierSymbol (φ u) (r u) ξ *
          fourier (f : Euclidean d → Complex) ξ‖ ^ (2 : Nat) := by
  calc
    (∫ x : Euclidean d,
        finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) =
        ∑ u ∈ s, ∫ x : Euclidean d,
          ‖fourierInv (fun ξ : Euclidean d =>
            relativeSchwartzMultiplierSymbol (φ u) (r u) ξ *
              fourier (f : Euclidean d → Complex) ξ) x‖ ^ (2 : Nat) := by
        simp only [finiteRelativeSchwartzMultiplierSquareEnergy,
          relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
        apply integral_finsetSum
        intro u hu
        simpa only [SchwartzMap.fourier_coe] using
          (integrable_norm_sq_fourierInv_schwartz_multiplier
            (relativeSchwartzMultiplierSymbol (φ u) (r u)) (𝓕 f))
    _ = ∑ u ∈ s, ∫ ξ : Euclidean d,
        ‖relativeSchwartzMultiplierSymbol (φ u) (r u) ξ *
          fourier (f : Euclidean d → Complex) ξ‖ ^ (2 : Nat) := by
      apply Finset.sum_congr rfl
      intro u hu
      simpa only [SchwartzMap.fourier_coe] using
        (integral_norm_sq_fourierInv_schwartz_multiplier_eq
          (relativeSchwartzMultiplierSymbol (φ u) (r u)) (𝓕 f))

/-- The finite relative multiplier energy is exactly the Fourier energy
weighted by the pointwise multiplier square overlap. -/
theorem integral_finiteRelativeSchwartzMultiplierSquareEnergy_eq_frequency_overlap
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d,
      finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) =
      ∫ ξ : Euclidean d,
        (∑ u ∈ s, ‖relativeSchwartzMultiplierSymbol (φ u) (r u) ξ‖ ^ (2 : Nat)) *
          ‖fourier (f : Euclidean d → Complex) ξ‖ ^ (2 : Nat) := by
  let m : ι → SchwartzMap (Euclidean d) Complex :=
    fun u => relativeSchwartzMultiplierSymbol (φ u) (r u)
  let g : SchwartzMap (Euclidean d) Complex := 𝓕 f
  have hfreq (u : ι) (hu : u ∈ s) :
      Integrable (fun ξ : Euclidean d => ‖m u ξ * g ξ‖ ^ (2 : Nat)) volume := by
    let h : SchwartzMap (Euclidean d) Complex :=
      SchwartzMap.smulLeftCLM Complex (m u : Euclidean d → Complex) g
    have hsq : Integrable (fun ξ : Euclidean d => ‖h ξ‖ ^ (2 : Nat)) volume :=
      (memLp_two_iff_integrable_sq_norm h.continuous.aestronglyMeasurable).mp
        (h.memLp 2 volume)
    simpa only [h, SchwartzMap.smulLeftCLM_apply (m u).hasTemperateGrowth,
      smul_eq_mul] using hsq
  have hfreq' (u : ι) (hu : u ∈ s) :
      Integrable (fun ξ : Euclidean d =>
        ‖m u ξ‖ ^ (2 : Nat) * ‖g ξ‖ ^ (2 : Nat)) volume := by
    apply (hfreq u hu).congr
    filter_upwards with ξ
    rw [norm_mul, mul_pow]
  calc
    (∫ x : Euclidean d,
        finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) =
        ∑ u ∈ s, ∫ ξ : Euclidean d,
          ‖m u ξ * g ξ‖ ^ (2 : Nat) := by
        simpa only [m, g, SchwartzMap.fourier_coe] using
          integral_finiteRelativeSchwartzMultiplierSquareEnergy_eq_frequency s φ r f
    _ = ∑ u ∈ s, ∫ ξ : Euclidean d,
          ‖m u ξ‖ ^ (2 : Nat) * ‖g ξ‖ ^ (2 : Nat) := by
        apply Finset.sum_congr rfl
        intro u hu
        apply integral_congr_ae
        filter_upwards with ξ
        rw [norm_mul, mul_pow]
    _ = ∫ ξ : Euclidean d,
        ∑ u ∈ s, ‖m u ξ‖ ^ (2 : Nat) * ‖g ξ‖ ^ (2 : Nat) := by
        exact (integral_finsetSum s hfreq').symm
    _ = ∫ ξ : Euclidean d,
        (∑ u ∈ s, ‖m u ξ‖ ^ (2 : Nat)) * ‖g ξ‖ ^ (2 : Nat) := by
        apply integral_congr_ae
        filter_upwards with ξ
        rw [Finset.sum_mul]
    _ = ∫ ξ : Euclidean d,
        (∑ u ∈ s, ‖relativeSchwartzMultiplierSymbol (φ u) (r u) ξ‖ ^ (2 : Nat)) *
          ‖fourier (f : Euclidean d → Complex) ξ‖ ^ (2 : Nat) := by
        simp only [m, g, SchwartzMap.fourier_coe]

/-- A finite relative multiplier family satisfies the exact Plancherel
square-function estimate under a pointwise Fourier-side square-overlap
bound.  In particular, the constant is independent of the cardinality of
the finite family. -/
theorem integral_finiteRelativeSchwartzMultiplierSquareEnergy_le_of_square_overlap
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    {C : Real}
    (hoverlap : ∀ ξ : Euclidean d,
      ∑ u ∈ s, ‖relativeSchwartzMultiplierSymbol (φ u) (r u) ξ‖ ^ (2 : Nat) ≤ C) :
    (∫ x : Euclidean d,
      finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  calc
    (∫ x : Euclidean d,
        finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) =
        ∑ u ∈ s, ∫ x : Euclidean d,
          ‖fourierInv (fun ξ : Euclidean d =>
            relativeSchwartzMultiplierSymbol (φ u) (r u) ξ *
              fourier (f : Euclidean d → Complex) ξ) x‖ ^ (2 : Nat) := by
        simp only [finiteRelativeSchwartzMultiplierSquareEnergy,
          relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
        apply integral_finsetSum
        intro u hu
        simpa only [SchwartzMap.fourier_coe] using
          (integrable_norm_sq_fourierInv_schwartz_multiplier
            (relativeSchwartzMultiplierSymbol (φ u) (r u)) (𝓕 f))
    _ ≤ C * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) :=
      sum_integral_norm_sq_fourierInv_schwartz_multipliers_le s
        (fun u => relativeSchwartzMultiplierSymbol (φ u) (r u)) f hoverlap

/-- The same finite vector-valued `L²` bound in the literal scaled-symbol
form.  This is the version used for dyadic decompositions: the hypothesis is
an overlap bound on `φ u (r u • ξ)` itself. -/
theorem integral_finiteRelativeSchwartzMultiplierSquareEnergy_le_of_scaled_square_overlap
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    {C : Real}
    (hoverlap : ∀ ξ : Euclidean d,
      ∑ u ∈ s, ‖φ u ((r u).1 • ξ)‖ ^ (2 : Nat) ≤ C) :
    (∫ x : Euclidean d,
      finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  apply integral_finiteRelativeSchwartzMultiplierSquareEnergy_le_of_square_overlap
    s φ r f
  intro ξ
  simpa only [relativeSchwartzMultiplierSymbol_apply] using hoverlap ξ

/-- The conventional finite relative multiplier square function has the
same cardinality-free `L²` estimate under scaled Fourier-side overlap. -/
theorem integral_sq_finiteRelativeSchwartzMultiplierSquareFunction_le_of_scaled_square_overlap
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    {C : Real}
    (hoverlap : ∀ ξ : Euclidean d,
      ∑ u ∈ s, ‖φ u ((r u).1 • ξ)‖ ^ (2 : Nat) ≤ C) :
    (∫ x : Euclidean d,
      finiteRelativeSchwartzMultiplierSquareFunction s φ r f x ^ (2 : Nat)) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ (2 : Nat) := by
  rw [show (fun x : Euclidean d =>
      finiteRelativeSchwartzMultiplierSquareFunction s φ r f x ^ (2 : Nat)) =
      fun x => finiteRelativeSchwartzMultiplierSquareEnergy s φ r f x by
        funext x
        exact sq_finiteRelativeSchwartzMultiplierSquareFunction s φ r f x]
  exact integral_finiteRelativeSchwartzMultiplierSquareEnergy_le_of_scaled_square_overlap
    s φ r f hoverlap

/-- A finite dyadic block of compact smooth relative multipliers.  This is a
literal partial sum, so it is suitable for the finite truncations occurring
before a Calderón--Zygmund limiting argument. -/
def finiteRelativeSchwartzMultiplier {d : Nat} {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) : Real :=
  ‖∑ u ∈ s, relativeSchwartzMultiplierAt (φ u) (r u) f x‖

/-- A fixed relative Schwartz multiplier is continuous in the spatial
variable. -/
theorem continuous_relativeSchwartzMultiplierAt
    {d : Nat} (φ f : SchwartzMap (Euclidean d) Complex)
    (r : Ioi (0 : Real)) :
    Continuous (relativeSchwartzMultiplierAt φ r f) := by
  change Continuous (fun x => fourierInv (fun ξ : Euclidean d =>
    φ (r.1 • ξ) * fourier (f : Euclidean d → Complex) ξ) x)
  simpa only [inv_inv] using
    (continuous_fourierInv_scaled_schwartz_multiplier φ f
      (inv_pos.mpr r.2))

/-- Finite dyadic blocks of relative Schwartz multipliers are continuous. -/
theorem continuous_finiteRelativeSchwartzMultiplier
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex) :
    Continuous (finiteRelativeSchwartzMultiplier s φ r f) := by
  unfold finiteRelativeSchwartzMultiplier
  apply (continuous_finsetSum s ?_).norm
  intro u hu
  exact continuous_relativeSchwartzMultiplierAt (φ u) f (r u)

/-- Uniform physical kernel-size data bounds every individual member of a
finite dyadic multiplier block by one dyadic Hardy--Littlewood maximal
function. -/
theorem uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
    {d : Nat} {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ K : Real, 0 < K ∧ ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (r : Ioi (0 : Real)) (x : Euclidean d),
      ‖relativeSchwartzMultiplierAt (φ u) r f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  let G : Real := relativeSchwartzMultiplierGeometricFactor d
  let K : Real := G * A + 1
  have hG : 0 ≤ G := by
    dsimp only [G, relativeSchwartzMultiplierGeometricFactor]
    positivity
  have hK : 0 < K := by
    dsimp only [K]
    have : 0 ≤ G * A := mul_nonneg hG hA
    linarith
  refine ⟨K, hK, ?_⟩
  intro u f r x
  have hconstant : relativeSchwartzMultiplierConstant (φ u) ≤ G * A := by
    rw [relativeSchwartzMultiplierConstant_eq]
    exact mul_le_mul_of_nonneg_left (hφ u) hG
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  calc
    ‖relativeSchwartzMultiplierAt (φ u) r f x‖ =
        ‖fourierInv (fun ξ : Euclidean d =>
          φ u (r.1 • ξ) * fourier (f : Euclidean d → Complex) ξ) x‖ := rfl
    _ ≤ (relativeSchwartzMultiplierConstant (φ u) + 1) *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by
          simpa only [relativeSchwartzMultiplierAt] using
            relativeSchwartzMultiplier_fixed_radius_majorant (φ u) f r x
    _ ≤ K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
      apply mul_le_mul_of_nonneg_right _ hH
      dsimp only [K]
      linarith

/-- A finite block is dominated by the dyadic maximal function whenever each
of its terms is.  The harmless `+ 1` keeps the majorant positive even for an
empty block. -/
theorem finiteRelativeSchwartzMultiplier_majorant_of_term_majorant
    {d : Nat} {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {K : Real}
    (hterm : ∀ u ∈ s, ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      finiteRelativeSchwartzMultiplier s φ r f x ≤
        ((s.card : Real) * K + 1) *
          dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  intro f x
  have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
    ENNReal.toReal_nonneg
  unfold finiteRelativeSchwartzMultiplier
  calc
    ‖∑ u ∈ s, relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        ∑ u ∈ s, ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ :=
      norm_sum_le s _
    _ ≤ ∑ _u ∈ s, K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
      apply Finset.sum_le_sum
      intro u hu
      exact hterm u hu f x
    _ = (s.card : Real) *
        (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
      rw [Finset.sum_const, nsmul_eq_mul]
    _ = ((s.card : Real) * K) *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by ring
    _ ≤ ((s.card : Real) * K + 1) *
        dyadicBallMaximal d (f : Euclidean d → Complex) x := by
      apply mul_le_mul_of_nonneg_right
      · linarith
      · exact hH

/-- Finite dyadic blocks of compact smooth multipliers have strong `(p,p)`
bounds for every `p > 1` whenever their individual terms share a dyadic
maximal majorant. -/
theorem finiteRelativeSchwartzMultiplier_strong_type_of_term_majorant
    {d : Nat} (hd : 0 < d) {p K : Real} (hp : 1 < p) (hK : 0 < K)
    {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real))
    (hterm : ∀ u ∈ s, ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (finiteRelativeSchwartzMultiplier s φ r f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (finiteRelativeSchwartzMultiplier s φ r f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  let L : Real := (s.card : Real) * K + 1
  have hcard : 0 ≤ (s.card : Real) := Nat.cast_nonneg _
  have hL : 0 < L := by
    dsimp only [L]
    have : 0 ≤ (s.card : Real) * K := mul_nonneg hcard hK.le
    linarith
  exact strong_type_of_dyadicBall_majorant hd hp hL
    (fun f x => finiteRelativeSchwartzMultiplier s φ r f x)
    (fun _f _x => norm_nonneg _)
    (fun f => (continuous_finiteRelativeSchwartzMultiplier s φ r f).aestronglyMeasurable)
    (by
      intro f x
      simpa only [L] using
        finiteRelativeSchwartzMultiplier_majorant_of_term_majorant s φ r hterm f x)

/-- Kernel-size controlled finite dyadic blocks have the full strong
`(p,p)` range above one. -/
theorem finiteRelativeSchwartzMultiplier_strong_type_of_kernel_bound
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p) {ι : Type*}
    (s : Finset ι) (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (finiteRelativeSchwartzMultiplier s φ r f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (finiteRelativeSchwartzMultiplier s φ r f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨K, hK, hterm⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound φ hA hφ
  exact finiteRelativeSchwartzMultiplier_strong_type_of_term_majorant
    hd hp hK s φ r (fun u hu f x => hterm u f (r u) x)

/-- Finite dyadic blocks of compact smooth multipliers have a weak `(1,1)`
bound from individual dyadic-maximal majorants. -/
theorem finiteRelativeSchwartzMultiplier_weak_one_of_term_majorant
    {d : Nat} (hd : 0 < d) {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {K : Real} (hK : 0 < K)
    (hterm : ∀ u ∈ s, ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (f : SchwartzMap (Euclidean d) Complex) {t : Real}, 0 < t →
        ENNReal.ofReal t * volume
          {x | t < finiteRelativeSchwartzMultiplier s φ r f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  let L : Real := (s.card : Real) * K + 1
  have hcard : 0 ≤ (s.card : Real) := Nat.cast_nonneg _
  have hL : 0 < L := by
    dsimp only [L]
    have : 0 ≤ (s.card : Real) * K := mul_nonneg hcard hK.le
    linarith
  apply weak_one_of_dyadicBall_majorant hd hL
    (fun f x => finiteRelativeSchwartzMultiplier s φ r f x)
  intro f x
  simpa only [L] using
    finiteRelativeSchwartzMultiplier_majorant_of_term_majorant s φ r hterm f x

/-- Kernel-size controlled finite dyadic blocks satisfy weak `(1,1)` with a
constant depending only on the finite block cardinality and the common
physical kernel bound. -/
theorem finiteRelativeSchwartzMultiplier_weak_one_of_kernel_bound
    {d : Nat} (hd : 0 < d) {ι : Type*} (s : Finset ι)
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (f : SchwartzMap (Euclidean d) Complex) {t : Real}, 0 < t →
        ENNReal.ofReal t * volume
          {x | t < finiteRelativeSchwartzMultiplier s φ r f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  obtain ⟨K, hK, hterm⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound φ hA hφ
  exact finiteRelativeSchwartzMultiplier_weak_one_of_term_majorant
    hd s φ r hK (fun u hu f x => hterm u f (r u) x)

/-! ### Absolutely summable compact multiplier families

The finite-block statements above are enough for a fixed truncation, but the
dyadic decomposition in the multiplier argument also produces genuinely
countable families.  The following layer records the elementary passage to
an absolutely summable family.  It is deliberately formulated with explicit
coefficient summability: this is the hypothesis which lets the physical
Hardy--Littlewood majorant pass through the infinite sum without any
unproved interchange of an integral and a series.
-/

/-- The literal countable sum of weighted relative Schwartz multipliers.
The coefficients are real because this is the form needed for a dyadic
partition of unity; the output remains complex-valued. -/
def countableRelativeSchwartzMultiplier {d : Nat}
    (a : ℕ → Real) (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) : Complex :=
  ∑' n : ℕ, (a n : Complex) * relativeSchwartzMultiplierAt (φ n) (r n) f x

/-- Absolute summability of the coefficients, together with a common
pointwise dyadic-maximal majorant, gives absolute convergence at each spatial
point. -/
theorem summable_countableRelativeSchwartzMultiplier_terms
    {d : Nat} (a : ℕ → Real)
    (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real)) {K : Real}
    (ha : Summable fun n : ℕ => ‖a n‖)
    (hterm : ∀ (n : ℕ) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ n) (r n) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    Summable (fun n : ℕ =>
      (a n : Complex) * relativeSchwartzMultiplierAt (φ n) (r n) f x) := by
  refine (ha.mul_right
    (K * dyadicBallMaximal d (f : Euclidean d → Complex) x)).of_norm_bounded ?_
  intro n
  rw [norm_mul, Complex.norm_real]
  exact mul_le_mul_of_nonneg_left (hterm n f x) (norm_nonneg _)

/-- The countable weighted multiplier is the limit of its finite initial
blocks.  This gives the precise convergence statement used when a dyadic
truncation is removed. -/
theorem tendsto_sum_range_countableRelativeSchwartzMultiplier
    {d : Nat} (a : ℕ → Real)
    (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real)) {K : Real}
    (ha : Summable fun n : ℕ => ‖a n‖)
    (hterm : ∀ (n : ℕ) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ n) (r n) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    Filter.Tendsto
      (fun N : ℕ => ∑ n ∈ Finset.range N,
        (a n : Complex) * relativeSchwartzMultiplierAt (φ n) (r n) f x)
      Filter.atTop (𝓝 (countableRelativeSchwartzMultiplier a φ r f x)) := by
  simpa only [countableRelativeSchwartzMultiplier] using
    (summable_countableRelativeSchwartzMultiplier_terms a φ r ha hterm f x).hasSum.tendsto_sum_nat

/-- Countable weighted multiplier sums are measurable on Schwartz inputs.
Measurability uses the general measurable-`tsum` theorem, while the previous
result supplies the stronger absolute-convergence information. -/
theorem measurable_countableRelativeSchwartzMultiplier
    {d : Nat} (a : ℕ → Real)
    (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real)) (f : SchwartzMap (Euclidean d) Complex) :
    Measurable (countableRelativeSchwartzMultiplier a φ r f) := by
  unfold countableRelativeSchwartzMultiplier
  apply Measurable.tsum
  intro n
  exact ((continuous_relativeSchwartzMultiplierAt (φ n) f (r n)).const_mul
    (a n : Complex)).measurable

/-- The absolute-sum maximal majorant for a countable relative multiplier
family. -/
theorem norm_countableRelativeSchwartzMultiplier_le
    {d : Nat} (a : ℕ → Real)
    (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real)) {K : Real}
    (ha : Summable fun n : ℕ => ‖a n‖)
    (hterm : ∀ (n : ℕ) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ n) (r n) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    ‖countableRelativeSchwartzMultiplier a φ r f x‖ ≤
      (∑' n : ℕ, ‖a n‖) *
        (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
  let g : ℕ → Complex := fun n =>
    (a n : Complex) * relativeSchwartzMultiplierAt (φ n) (r n) f x
  have hg : Summable g := by
    exact summable_countableRelativeSchwartzMultiplier_terms a φ r ha hterm f x
  have hgnorm : Summable (fun n : ℕ => ‖g n‖) := hg.norm
  have hmajorSum : Summable (fun n : ℕ => ‖a n‖ *
      (K * dyadicBallMaximal d (f : Euclidean d → Complex) x)) :=
    ha.mul_right _
  calc
    ‖countableRelativeSchwartzMultiplier a φ r f x‖ = ‖∑' n : ℕ, g n‖ := by
      rfl
    _ ≤ ∑' n : ℕ, ‖g n‖ := norm_tsum_le_tsum_norm hgnorm
    _ ≤ ∑' n : ℕ, ‖a n‖ *
        (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
      apply Summable.tsum_le_tsum _ hgnorm hmajorSum
      intro n
      change ‖(a n : Complex) *
        relativeSchwartzMultiplierAt (φ n) (r n) f x‖ ≤ _
      rw [norm_mul, Complex.norm_real]
      exact mul_le_mul_of_nonneg_left (hterm n f x) (norm_nonneg _)
    _ = (∑' n : ℕ, ‖a n‖) *
        (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
      exact tsum_mul_right

/-- An absolutely summable countable family of compact relative multipliers
has the full strong `(p,p)` range above one.  The proof passes the common
dyadic Hardy--Littlewood majorant through the absolutely convergent series,
then invokes the already established real-variable transfer lemma. -/
theorem countableRelativeSchwartzMultiplier_strong_type_of_term_majorant
    {d : Nat} (hd : 0 < d) {p K : Real} (hp : 1 < p) (hK : 0 < K)
    (a : ℕ → Real) (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real))
    (ha : Summable fun n : ℕ => ‖a n‖)
    (hterm : ∀ (n : ℕ) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ n) (r n) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fun x => ‖countableRelativeSchwartzMultiplier a φ r f x‖)
        (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        ‖countableRelativeSchwartzMultiplier a φ r f x‖ ^ p) ≤
          C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  let S : Real := ∑' n : ℕ, ‖a n‖
  let L : Real := S * K + 1
  have hS : 0 ≤ S := by
    dsimp only [S]
    exact tsum_nonneg fun n => norm_nonneg (a n)
  have hSK : 0 ≤ S * K := mul_nonneg hS hK.le
  have hL : 0 < L := by
    dsimp only [L]
    linarith
  exact strong_type_of_dyadicBall_majorant hd hp hL
    (fun f x => ‖countableRelativeSchwartzMultiplier a φ r f x‖)
    (fun _f _x => norm_nonneg _)
    (fun f =>
      (measurable_countableRelativeSchwartzMultiplier a φ r f).norm.aestronglyMeasurable)
    (by
      intro f x
      have hH : 0 ≤ dyadicBallMaximal d (f : Euclidean d → Complex) x :=
        ENNReal.toReal_nonneg
      calc
        ‖countableRelativeSchwartzMultiplier a φ r f x‖ ≤
            S * (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
              simpa only [S] using
                norm_countableRelativeSchwartzMultiplier_le a φ r ha hterm f x
        _ = (S * K) * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
              ring
        _ ≤ L * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
              apply mul_le_mul_of_nonneg_right
              · dsimp only [L]
                linarith
              · exact hH)

/-- Kernel-size controlled absolutely summable families of compact relative
multipliers have uniform strong `(p,p)` bounds. -/
theorem countableRelativeSchwartzMultiplier_strong_type_of_kernel_bound
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p)
    (a : ℕ → Real) (φ : ℕ → SchwartzMap (Euclidean d) Complex)
    (r : ℕ → Ioi (0 : Real))
    (ha : Summable fun n : ℕ => ‖a n‖) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ n, relativeSchwartzMultiplierKernelSize (φ n) ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fun x => ‖countableRelativeSchwartzMultiplier a φ r f x‖)
        (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d,
        ‖countableRelativeSchwartzMultiplier a φ r f x‖ ^ p) ≤
          C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨K, hK, hterm⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound φ hA hφ
  exact countableRelativeSchwartzMultiplier_strong_type_of_term_majorant
    hd hp hK a φ r ha (fun n f x => hterm n f (r n) x)

/-! ### Uniform annular Schwartz multiplier families

The preceding statements keep one multiplier parameter fixed.  The endpoint
pieces in the circular argument also carry a compact parameter (the time,
or one of the two oscillatory signs).  For a genuinely uniform kernel bound,
the supremum over that parameter is still controlled by the same dyadic
Hardy--Littlewood maximal function.  This is a compact-annular multiplier
theorem, not the full classical Mikhlin theorem: the symbols are explicitly
given as scaled Schwartz functions and the physical kernel seminorm bound is
an explicit hypothesis.
-/

/-- The pointwise maximal family of scaled compact Schwartz multipliers.
Each member has frequency symbol `φ u (r u • ξ)`, so it is the
natural form of a compact annular multiplier at the scale `r u⁻¹`. -/
def annularSchwartzMultiplierRaw {d : Nat} {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) (r : ι → Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : ENNReal :=
  ⨆ u : ι, ENNReal.ofReal ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖

/-- The real-valued compact-annular multiplier maximal family. -/
def annularSchwartzMultiplier {d : Nat} {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) (r : ι → Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : Real :=
  (annularSchwartzMultiplierRaw φ r f x).toReal

/-- Compact-annular multiplier maximal families are nonnegative. -/
theorem annularSchwartzMultiplier_nonneg {d : Nat} {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) (r : ι → Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    0 ≤ annularSchwartzMultiplier φ r f x := by
  exact ENNReal.toReal_nonneg

/-- The maximal family is measurable even for an arbitrary parameter type:
it is the supremum of continuous nonnegative functions. -/
theorem annularSchwartzMultiplier_aestronglyMeasurable {d : Nat} {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex) (r : ι → Ioi (0 : Real))
    (f : SchwartzMap (Euclidean d) Complex) :
    AEStronglyMeasurable (annularSchwartzMultiplier φ r f) volume := by
  let R : Euclidean d → Real := fun x =>
    (⨆ u : ι, ENNReal.ofReal ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖).toReal
  change AEStronglyMeasurable R volume
  apply (ENNReal.measurable_toReal.comp ?_).aestronglyMeasurable
  apply LowerSemicontinuous.measurable
  apply lowerSemicontinuous_iSup
  intro u
  exact (ENNReal.continuous_ofReal.comp
    (continuous_relativeSchwartzMultiplierAt (φ u) f (r u)).norm).lowerSemicontinuous

/-- A common termwise dyadic-maximal majorant controls the supremum of an
arbitrary compact-annular Schwartz multiplier family. -/
theorem annularSchwartzMultiplier_majorant_of_term_majorant
    {d : Nat} {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {K : Real} (hK : 0 < K)
    (hterm : ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∀ (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d),
      annularSchwartzMultiplier φ r f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  intro f x
  have hsup : annularSchwartzMultiplierRaw φ r f x ≤
      ENNReal.ofReal (K * dyadicBallMaximal d (f : Euclidean d → Complex) x) := by
    apply iSup_le
    intro u
    exact ENNReal.ofReal_le_ofReal (hterm u f x)
  calc
    annularSchwartzMultiplier φ r f x =
        (annularSchwartzMultiplierRaw φ r f x).toReal := rfl
    _ ≤ (ENNReal.ofReal (K * dyadicBallMaximal d
        (f : Euclidean d → Complex) x)).toReal :=
      (ENNReal.toReal_le_toReal
        (ne_top_of_le_ne_top ENNReal.ofReal_ne_top hsup)
        ENNReal.ofReal_ne_top).2 hsup
    _ = K * dyadicBallMaximal d (f : Euclidean d → Complex) x :=
      ENNReal.toReal_ofReal
        (mul_nonneg hK.le ENNReal.toReal_nonneg)

/-- A uniform bound on the two inverse-Fourier Schwartz seminorms supplies
one dyadic-maximal majorant for the whole compact-annular family. -/
theorem annularSchwartzMultiplier_majorant_of_kernel_bound
    {d : Nat} {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ K : Real, 0 < K ∧ ∀ (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), annularSchwartzMultiplier φ r f x ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x := by
  obtain ⟨K, hK, hterm⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound φ hA hφ
  refine ⟨K, hK, ?_⟩
  exact annularSchwartzMultiplier_majorant_of_term_majorant φ r hK
    (fun u f x => hterm u f (r u) x)

/-- Uniform compact-annular multiplier families have the full strong
`(p,p)` range above one under a common physical-kernel majorant. -/
theorem annularSchwartzMultiplier_strong_type_of_term_majorant
    {d : Nat} (hd : 0 < d) {p K : Real} (hp : 1 < p) (hK : 0 < K)
    {ι : Type*} (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real))
    (hterm : ∀ (u : ι) (f : SchwartzMap (Euclidean d) Complex)
      (x : Euclidean d), ‖relativeSchwartzMultiplierAt (φ u) (r u) f x‖ ≤
        K * dyadicBallMaximal d (f : Euclidean d → Complex) x) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (annularSchwartzMultiplier φ r f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (annularSchwartzMultiplier φ r f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  exact strong_type_of_dyadicBall_majorant hd hp hK
    (fun f x => annularSchwartzMultiplier φ r f x)
    (fun f x => annularSchwartzMultiplier_nonneg φ r f x)
    (fun f => annularSchwartzMultiplier_aestronglyMeasurable φ r f)
    (annularSchwartzMultiplier_majorant_of_term_majorant φ r hK hterm)

/-- The explicit-kernel-seminorm form of the uniform compact-annular
Schwartz multiplier theorem.  This is the form intended for a smooth
endpoint amplitude after multiplication by a fat annular cutoff. -/
theorem annularSchwartzMultiplier_strong_type_of_kernel_bound
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p) {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (annularSchwartzMultiplier φ r f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (annularSchwartzMultiplier φ r f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  obtain ⟨K, hK, hterm⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound φ hA hφ
  exact annularSchwartzMultiplier_strong_type_of_term_majorant hd hp hK φ r
    (fun u f x => hterm u f (r u) x)

/-- Uniform compact-annular multiplier families also satisfy a weak `(1,1)`
endpoint under the same explicit kernel-seminorm hypothesis. -/
theorem annularSchwartzMultiplier_weak_one_of_kernel_bound
    {d : Nat} (hd : 0 < d) {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : ENNReal, 0 < C ∧ C ≠ ∞ ∧
      ∀ (f : SchwartzMap (Euclidean d) Complex) {s : Real}, 0 < s →
        ENNReal.ofReal s * volume {x | s < annularSchwartzMultiplier φ r f x} ≤
          C * ∫⁻ x, ENNReal.ofReal ‖(f : Euclidean d → Complex) x‖ := by
  obtain ⟨K, hK, hmajor⟩ :=
    annularSchwartzMultiplier_majorant_of_kernel_bound φ r hA hφ
  exact weak_one_of_dyadicBall_majorant hd hK
    (fun f x => annularSchwartzMultiplier φ r f x) hmajor

/-- Dimension-generic parameter-uniform Mikhlin theorem in the compact
annular Schwartz form used by the wave and circle decompositions.  The
inverse-Fourier kernel seminorm is the concrete finite collection of symbol
seminorms on the fixed annulus; after dilation it is invariant in the
frequency scale.  The conclusion controls the supremum over the parameter
family, and therefore in particular every individual multiplier. -/
theorem compactAnnularSchwartzMultiplier_strong_type
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p) {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean d) Complex)
    (r : ι → Ioi (0 : Real)) {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, relativeSchwartzMultiplierKernelSize (φ u) ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (annularSchwartzMultiplier φ r f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (annularSchwartzMultiplier φ r f x) ^ p) ≤
        C * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  exact annularSchwartzMultiplier_strong_type_of_kernel_bound
    hd hp φ r hA hφ

/-! ### Fat Littlewood--Paley annuli

The compact-annular theorem above is phrased in relative scale.  The fat
cutoff used by the dyadic circular pieces has exactly that form: it is one
fixed Schwartz annulus evaluated at the reciprocal dyadic frequency scale.
The following identities expose that normal form for downstream endpoint
multiplier estimates.
-/

/-- The positive reciprocal frequency scale associated to a natural dyadic
index. -/
def dyadicFrequencyScale (j : Nat) : Ioi (0 : Real) :=
  ⟨((2 : Real) ^ j)⁻¹, by
    exact inv_pos.mpr (pow_pos (by norm_num : (0 : Real) < 2) j)⟩

/-- The unit-scale Schwartz profile whose dyadic dilates are the fat
Littlewood--Paley annuli. -/
def fatDyadicBandpassPrototype {d : Nat} (χ : SchwartzMap (Euclidean d) Complex) :
    SchwartzMap (Euclidean d) Complex :=
  intDyadicLowpassMultiplier χ (3 : Int) - intDyadicLowpassMultiplier χ (-2 : Int)

/-- The fixed fat annular profile vanishes on its inner stabilized low-pass
region.  The numerical radii are independent of the ambient dimension. -/
theorem fatDyadicBandpassPrototype_eq_zero_of_norm_le
    {d : Nat} (C : lpCutoffs d) {ξ : Euclidean d}
    (hξ : ‖ξ‖ ≤ (2 : Real) ^ (-2 : Int)) :
    fatDyadicBandpassPrototype C.cutoff ξ = 0 := by
  unfold fatDyadicBandpassPrototype
  simp only [sub_apply]
  have hsmall : (2 : Real) ^ (-2 : Int) ≤ (2 : Real) ^ (3 : Int) := by
    norm_num [zpow_neg]
  rw [intDyadicLowpass_eq_one_of_norm_le C (hξ.trans hsmall),
    intDyadicLowpass_eq_one_of_norm_le C hξ]
  ring

/-- The fixed fat annular profile vanishes outside a fixed compact ball. -/
theorem fatDyadicBandpassPrototype_eq_zero_of_le_norm
    {d : Nat} (C : lpCutoffs d) {ξ : Euclidean d}
    (hξ : (2 : Real) ^ (4 : Int) ≤ ‖ξ‖) :
    fatDyadicBandpassPrototype C.cutoff ξ = 0 := by
  unfold fatDyadicBandpassPrototype
  simp only [sub_apply]
  have hsmall : (2 : Real) ^ ((-2 : Int) + 1) ≤ (2 : Real) ^ (4 : Int) := by
    norm_num [zpow_neg]
  rw [intDyadicLowpass_eq_zero_of_le_norm C (by simpa using hξ),
    intDyadicLowpass_eq_zero_of_le_norm C (hsmall.trans hξ)]
  ring

/-- The fixed fat annular profile has compact support, uniformly in the
Littlewood--Paley cutoff data and in the ambient dimension. -/
theorem hasCompactSupport_fatDyadicBandpassPrototype
    {d : Nat} (C : lpCutoffs d) :
    HasCompactSupport (fatDyadicBandpassPrototype C.cutoff : Euclidean d → Complex) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean d) ((2 : Real) ^ (4 : Int)))
  intro ξ hξ
  have hnorm : (2 : Real) ^ (4 : Int) ≤ ‖ξ‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    exact le_of_not_ge hξ
  exact fatDyadicBandpassPrototype_eq_zero_of_le_norm C hnorm

/-- Integer dyadic low-pass cutoffs commute exactly with a relative dyadic
scaling. -/
theorem intDyadicLowpassMultiplier_add_apply {d : Nat}
    (χ : SchwartzMap (Euclidean d) Complex) (j k : Int) (ξ : Euclidean d) :
    intDyadicLowpassMultiplier χ (j + k) ξ =
      intDyadicLowpassMultiplier χ k (((2 : Real) ^ j)⁻¹ • ξ) := by
  rw [intDyadicLowpassMultiplier_apply, intDyadicLowpassMultiplier_apply,
    smul_smul, zpow_add₀ (by norm_num : (2 : Real) ≠ 0), mul_inv_rev]

/-- The fat cutoff at level `j` is the relative multiplier associated with
the fixed unit-scale annular Schwartz profile. -/
theorem fatDyadicBandpassMultiplier_eq_prototype_scale {d : Nat}
    (C : lpCutoffs d) (j : Nat) (ξ : Euclidean d) :
    fatDyadicBandpassMultiplier C j ξ =
      fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • ξ) := by
  unfold fatDyadicBandpassMultiplier shiftedFatMultiplier fatDyadicBandpassPrototype
  simp only [sub_apply, sub_zero]
  rw [show (j : Int) - 2 = (j : Int) + (-2) by ring,
    intDyadicLowpassMultiplier_add_apply C.cutoff (j : Int) 3 ξ,
    intDyadicLowpassMultiplier_add_apply C.cutoff (j : Int) (-2) ξ]
  simp only [zpow_natCast]

/-- The literal fat dyadic Fourier multiplier is the relative compact
annular multiplier generated by `fatDyadicBandpassPrototype`. -/
theorem fourierInv_fatDyadicBandpassMultiplier_eq_relativeSchwartzMultiplierAt
    {d : Nat} (C : lpCutoffs d) (j : Nat)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    fourierInv (fun ξ : Euclidean d =>
      fatDyadicBandpassMultiplier C j ξ * fourier (f : Euclidean d → Complex) ξ) x =
      relativeSchwartzMultiplierAt (fatDyadicBandpassPrototype C.cutoff)
        (dyadicFrequencyScale j) f x := by
  unfold relativeSchwartzMultiplierAt
  apply congrArg (fun g : Euclidean d → Complex => fourierInv g x)
  funext ξ
  rw [fatDyadicBandpassMultiplier_eq_prototype_scale]
  simp only [dyadicFrequencyScale]

/-- The maximal family of literal fat dyadic Littlewood--Paley Fourier
multipliers.  This presentation is convenient when an endpoint amplitude is
first multiplied by the fat annular cutoff. -/
def fatDyadicBandpassMultiplierMaximal {d : Nat} (C : lpCutoffs d)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) : Real :=
  (⨆ j : Nat, ENNReal.ofReal ‖fourierInv (fun ξ : Euclidean d =>
    fatDyadicBandpassMultiplier C j ξ * fourier (f : Euclidean d → Complex) ξ) x‖).toReal

/-- The literal fat dyadic maximal family is precisely the compact-annular
Schwartz family generated by the fixed fat prototype. -/
theorem fatDyadicBandpassMultiplierMaximal_eq_annularSchwartzMultiplier
    {d : Nat} (C : lpCutoffs d) (f : SchwartzMap (Euclidean d) Complex)
    (x : Euclidean d) :
    fatDyadicBandpassMultiplierMaximal C f x =
      annularSchwartzMultiplier
        (fun _ : Nat => fatDyadicBandpassPrototype C.cutoff)
        dyadicFrequencyScale f x := by
  unfold fatDyadicBandpassMultiplierMaximal annularSchwartzMultiplier
    annularSchwartzMultiplierRaw
  congr 1
  apply iSup_congr
  intro j
  rw [fourierInv_fatDyadicBandpassMultiplier_eq_relativeSchwartzMultiplierAt]

/-- The fat annular Littlewood--Paley maximal family has a genuine strong
`(p,p)` estimate for every `p > 1`, in every positive dimension.  Its
constant is independent of the dyadic scale. -/
theorem fatDyadicBandpassMultiplierMaximal_strong_type
    {d : Nat} (hd : 0 < d) {p : Real} (hp : 1 < p) (C : lpCutoffs d) :
    ∃ B : Real, 0 < B ∧ ∀ f : SchwartzMap (Euclidean d) Complex,
      MemLp (fatDyadicBandpassMultiplierMaximal C f) (ENNReal.ofReal p) volume ∧
      (∫ x : Euclidean d, (fatDyadicBandpassMultiplierMaximal C f x) ^ p) ≤
        B * ∫ x : Euclidean d, ‖f x‖ ^ p := by
  let A : Real := relativeSchwartzMultiplierKernelSize
    (fatDyadicBandpassPrototype C.cutoff)
  have hA : 0 ≤ A := by
    dsimp only [A, relativeSchwartzMultiplierKernelSize]
    positivity
  obtain ⟨B, hB, hbound⟩ :=
    annularSchwartzMultiplier_strong_type_of_kernel_bound hd hp
      (fun _ : Nat => fatDyadicBandpassPrototype C.cutoff)
      dyadicFrequencyScale hA (fun _ => le_rfl)
  refine ⟨B, hB, ?_⟩
  intro f
  have heq : fatDyadicBandpassMultiplierMaximal C f =
      annularSchwartzMultiplier
        (fun _ : Nat => fatDyadicBandpassPrototype C.cutoff)
        dyadicFrequencyScale f := by
    funext x
    exact fatDyadicBandpassMultiplierMaximal_eq_annularSchwartzMultiplier C f x
  rw [heq]
  exact hbound f

/-! ### Finite signed homogeneous dyadic multipliers

The compact-annular maximal theorem controls one frequency scale at a time.
For Littlewood--Paley randomisation one instead needs finite signed sums of
the homogeneous dyadic bands.  The full uniform `L^p` statement is the
Calderon--Zygmund/Mikhlin step.  The elementary `L^2` endpoint below is
already cardinality-free: at every nonzero frequency at most two integer
dyadic bands can occur. -/

/-- At a fixed frequency, the absolute sum of an arbitrary finite block of
homogeneous dyadic band-pass multipliers is at most four. -/
theorem finite_sum_norm_intDyadicBandpassMultiplier_le_four {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (xi : Euclidean d) :
    (∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi‖) ≤ 4 := by
  classical
  let q : Int → Complex := fun k => intDyadicBandpassMultiplier C.cutoff k xi
  let S : Finset Int := K.filter fun k => q k ≠ 0
  have hSsub : S ⊆ K := Finset.filter_subset _ _
  have hzero : ∀ k ∈ K, k ∉ S → ‖q k‖ = 0 := by
    intro k hk hks
    have hq : q k = 0 := by
      by_contra hq
      exact hks (Finset.mem_filter.mpr ⟨hk, hq⟩)
    simp [hq]
  have hsum : (∑ k ∈ K, ‖q k‖) = ∑ k ∈ S, ‖q k‖ := by
    exact (Finset.sum_subset hSsub hzero).symm
  by_cases hxi : xi = 0
  · have hqzero : ∀ k, q k = 0 := by
      intro k
      dsimp [q]
      rw [intDyadicBandpassMultiplier_apply]
      have hchi : C.cutoff (0 : Euclidean d) = 1 :=
        C.cutoff_one 0 (by simp)
      simpa [hxi] using sub_self hchi
    simp only [show (fun k => ‖intDyadicBandpassMultiplier C.cutoff k xi‖) =
        fun k => ‖q k‖ by rfl]
    simp [hqzero]
  have hxipos : 0 < ‖xi‖ := norm_pos_iff.mpr hxi
  obtain ⟨n, hnlo, hnhi⟩ :=
    exists_mem_Ico_zpow (x := ‖xi‖) (y := (2 : Real)) hxipos (by norm_num)
  have hScard : S.card ≤ 2 := by
    have hSrange : S ⊆ Finset.Icc (n - 1) n := by
      intro k hk
      have hq : q k ≠ 0 := (Finset.mem_filter.mp hk).2
      have hsupp := intDyadicBandpass_norm_bounds_of_ne_zero C
        (by simpa only [q] using hq)
      have hleftpow : (2 : Real) ^ k < (2 : Real) ^ (n + 1) :=
        lt_of_lt_of_le hsupp.1 hnhi.le
      have hrightpow : (2 : Real) ^ n < (2 : Real) ^ (k + 2) :=
        lt_of_le_of_lt hnlo hsupp.2
      have hleft : k < n + 1 := by
        rw [zpow_lt_zpow_iff_right₀ (by norm_num : (1 : Real) < 2)] at hleftpow
        exact hleftpow
      have hright : n < k + 2 := by
        rw [zpow_lt_zpow_iff_right₀ (by norm_num : (1 : Real) < 2)] at hrightpow
        exact hrightpow
      exact Finset.mem_Icc.mpr (by omega)
    calc
      S.card ≤ (Finset.Icc (n - 1) n).card := Finset.card_le_card hSrange
      _ = 2 := by
        rw [Int.card_Icc]
        have hcard : n + 1 - (n - 1) = 2 := by omega
        rw [hcard]
        rfl
  have hterm : ∀ k ∈ S, ‖q k‖ ≤ (2 : Real) := by
    intro k hk
    dsimp [q]
    exact norm_intDyadicBandpassMultiplier_le_two C k xi
  calc
    (∑ k ∈ K, ‖intDyadicBandpassMultiplier C.cutoff k xi‖) =
        ∑ k ∈ K, ‖q k‖ := by rfl
    _ = ∑ k ∈ S, ‖q k‖ := hsum
    _ ≤ S.card • (2 : Real) := Finset.sum_le_card_nsmul S _ 2 hterm
    _ ≤ 2 • (2 : Real) := by gcongr
    _ = 4 := by norm_num

/-- The unit-scale profile of the homogeneous integer dyadic band-pass
family. -/
def integerDyadicBandpassPrototype {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) : SchwartzMap (Euclidean d) Complex :=
  intDyadicBandpassMultiplier chi 0

/-- The relative frequency scale which realizes the `k`th homogeneous dyadic
band-pass from the fixed unit profile. -/
def integerDyadicFrequencyScale (k : Int) : Ioi (0 : Real) :=
  Subtype.mk (((2 : Real) ^ k)⁻¹) (by
    exact inv_pos.mpr (zpow_pos (by norm_num : (0 : Real) < 2) k))

/-- Every integer dyadic band-pass is a relative dilation of one fixed
Schwartz profile. -/
theorem intDyadicBandpassMultiplier_eq_prototype_scale {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int) (xi : Euclidean d) :
    intDyadicBandpassMultiplier chi k xi =
      integerDyadicBandpassPrototype chi
        ((integerDyadicFrequencyScale k).1 • xi) := by
  unfold integerDyadicBandpassPrototype
  simp only [intDyadicBandpassMultiplier_apply, integerDyadicFrequencyScale]
  rw [smul_smul, smul_smul]
  have hfirst : ((2 : Real) ^ (k + 1))⁻¹ =
      ((2 : Real) ^ (0 + 1))⁻¹ * ((2 : Real) ^ k)⁻¹ := by
    rw [show k + 1 = k + (1 : Int) by ring,
      zpow_add₀ (by norm_num : (2 : Real) ≠ 0)]
    norm_num
  have hsecond : ((2 : Real) ^ k)⁻¹ =
      ((2 : Real) ^ (0 : Int))⁻¹ * ((2 : Real) ^ k)⁻¹ := by norm_num
  rw [hfirst, hsecond]
  simp

/-- The existing integer dyadic projection is the corresponding relative
Schwartz multiplier at its literal dyadic frequency scale. -/
theorem integerDyadicProjection_eq_relativeSchwartzMultiplierAt {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    integerDyadicProjection chi k f x =
      relativeSchwartzMultiplierAt (integerDyadicBandpassPrototype chi)
        (integerDyadicFrequencyScale k) f x := by
  unfold integerDyadicProjection relativeSchwartzMultiplierAt
  apply congrArg (fun g : Euclidean d → Complex => fourierInv g x)
  funext xi
  rw [intDyadicBandpassMultiplier_eq_prototype_scale]

/-- The literal physical kernel of the `k`th homogeneous integer dyadic
band-pass. -/
def integerDyadicBandpassKernel {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int) :
    Euclidean d → Complex :=
  relativeSchwartzMultiplierKernel (integerDyadicBandpassPrototype chi)
    (integerDyadicFrequencyScale k).1

/-- The `k`th homogeneous dyadic projection is convolution with its literal
relative Schwartz kernel. -/
theorem integerDyadicProjection_eq_convolution_kernel {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    integerDyadicProjection chi k f x =
      (integerDyadicBandpassKernel chi k
        ⋆[ContinuousLinearMap.mul Complex Complex, volume]
          (f : Euclidean d → Complex)) x := by
  rw [integerDyadicProjection_eq_relativeSchwartzMultiplierAt]
  exact fourierInv_relativeSchwartzMultiplier_eq_convolution
    (integerDyadicBandpassPrototype chi) f
    (integerDyadicFrequencyScale k).2 x

/-- The exact one-scale translation/Hörmander estimate for an integer dyadic
band-pass kernel.  This identifies the scale factor which must be summed by
the missing signed Calderón--Zygmund argument. -/
theorem integral_norm_integerDyadicBandpassKernel_sub_translate_le {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int) (h : Euclidean d) :
    (∫ x : Euclidean d,
      ‖integerDyadicBandpassKernel chi k (x + h) -
        integerDyadicBandpassKernel chi k x‖) ≤
      ‖h‖ * (integerDyadicFrequencyScale k).1⁻¹ *
        relativeSchwartzMultiplierKernelHormanderSize
          (integerDyadicBandpassPrototype chi) := by
  exact integral_norm_relativeSchwartzMultiplierKernel_sub_translate_le
    (integerDyadicBandpassPrototype chi)
    (integerDyadicFrequencyScale k).2 h

/-- Each normalized integer dyadic band-pass kernel is integrable. -/
theorem integrable_integerDyadicBandpassKernel {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int) :
    Integrable (integerDyadicBandpassKernel chi k) volume := by
  unfold integerDyadicBandpassKernel relativeSchwartzMultiplierKernel
  simpa only [Complex.real_smul, smul_eq_mul] using
    (Auto.Spherical.PowerWeights.LacunaryCancellation.integrable_scaled_fourierInv
      (integerDyadicBandpassPrototype chi)
      (inv_pos.mpr (integerDyadicFrequencyScale k).2))

/-- The physical frequency of the `k`th integer dyadic kernel.  Naming this
inverse scale keeps the two halves of the Calderón--Zygmund tail split
literal: low physical frequencies are controlled by cancellation, while high
physical frequencies are controlled by rapid kernel decay. -/
def integerDyadicPhysicalFrequency (k : Int) : Real :=
  (integerDyadicFrequencyScale k).1⁻¹

/-- The normalized integer dyadic kernel is the literal physical dilation at
its physical frequency. -/
theorem integerDyadicBandpassKernel_eq_physicalFrequency_scale {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    (z : Euclidean d) :
    integerDyadicBandpassKernel chi k z =
      ((integerDyadicPhysicalFrequency k ^ d : Real) : Complex) •
        (fourierInv (integerDyadicBandpassPrototype chi) :
          SchwartzMap (Euclidean d) Complex)
          (integerDyadicPhysicalFrequency k • z) := by
  unfold integerDyadicBandpassKernel integerDyadicPhysicalFrequency
  simp only [relativeSchwartzMultiplierKernel, Complex.real_smul, smul_eq_mul]

/-- Away from the origin, a single integer dyadic kernel has the rapid
Schwartz decay estimate used for the high-frequency half of an atom tail. -/
theorem norm_integerDyadicBandpassKernel_le_physicalFrequency_tail {d : Nat}
    (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    {z : Euclidean d} (hz : z ≠ 0) :
    ‖integerDyadicBandpassKernel chi k z‖ ≤
      (integerDyadicPhysicalFrequency k ^ d *
        SchwartzMap.seminorm Complex (d + 2) 0
          (fourierInv (integerDyadicBandpassPrototype chi))) /
        (integerDyadicPhysicalFrequency k * ‖z‖) ^ (d + 2) := by
  have hs : 0 < integerDyadicPhysicalFrequency k := by
    unfold integerDyadicPhysicalFrequency
    exact inv_pos.mpr (integerDyadicFrequencyScale k).2
  have hz' : 0 < integerDyadicPhysicalFrequency k * ‖z‖ :=
    mul_pos hs (norm_pos_iff.mpr hz)
  rw [integerDyadicBandpassKernel_eq_physicalFrequency_scale]
  exact Auto.Spherical.PowerWeights.GlobalLacunaryEndpoint.norm_complexScaled_fourierInv_le_seminorm_div_distance_pow
    (integerDyadicBandpassPrototype chi) hs hz'

/-- The Schwartz symbol of a finite signed homogeneous dyadic multiplier. -/
def finiteSignedIntegerDyadicMultiplierSymbol {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (a : Int → Complex) : SchwartzMap (Euclidean d) Complex :=
  ∑ k ∈ K, a k • intDyadicBandpassMultiplier C.cutoff k

/-- Literal expansion of a finite signed homogeneous dyadic symbol. -/
theorem finiteSignedIntegerDyadicMultiplierSymbol_apply {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) (xi : Euclidean d) :
    finiteSignedIntegerDyadicMultiplierSymbol C K a xi =
      ∑ k ∈ K, a k * intDyadicBandpassMultiplier C.cutoff k xi := by
  unfold finiteSignedIntegerDyadicMultiplierSymbol
  change (FunLike.coeAddMonoidHom (SchwartzMap (Euclidean d) Complex)
      (Euclidean d) Complex)
      (∑ k ∈ K, a k • intDyadicBandpassMultiplier C.cutoff k) xi = _
  rw [map_sum]
  rw [Finset.sum_apply]
  apply Finset.sum_congr rfl
  intro k hk
  rfl

/-- At each frequency, the signed dyadic multiplier is the literal finite
sum of the fixed-profile dyadic symbols. -/
theorem finiteSignedIntegerDyadicMultiplierSymbol_eq_sum_dyadicSymbols {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) (xi : Euclidean d) :
    finiteSignedIntegerDyadicMultiplierSymbol C K a xi =
      ∑ k ∈ K, a k *
        integerDyadicBandpassPrototype C.cutoff
          ((integerDyadicFrequencyScale k).1 • xi) := by
  rw [finiteSignedIntegerDyadicMultiplierSymbol_apply]
  apply Finset.sum_congr rfl
  intro k hk
  rw [← intDyadicBandpassMultiplier_eq_prototype_scale]

/-- The literal inverse-Fourier kernel of the finite signed homogeneous
dyadic symbol.  Keeping this as a Schwartz map makes its integrability and
the exact convolution identity available without any endpoint argument. -/
def finiteSignedIntegerDyadicMultiplierKernel {d : Nat} (C : lpCutoffs d)
    (K : Finset Int) (a : Int → Complex) : SchwartzMap (Euclidean d) Complex :=
  fourierInv (finiteSignedIntegerDyadicMultiplierSymbol C K a)

/-- Inverse Fourier transformation of the finite signed symbol distributes
over its finite dyadic expansion. -/
theorem finiteSignedIntegerDyadicMultiplierKernel_eq_sum {d : Nat}
    (C : lpCutoffs d) (K : Finset Int) (a : Int → Complex) :
    finiteSignedIntegerDyadicMultiplierKernel C K a =
      ∑ k ∈ K, a k •
        (fourierInv (intDyadicBandpassMultiplier C.cutoff k) :
          SchwartzMap (Euclidean d) Complex) := by
  unfold finiteSignedIntegerDyadicMultiplierKernel
  rw [finiteSignedIntegerDyadicMultiplierSymbol, fourierInv_sum]
  apply Finset.sum_congr rfl
  intro k hk
  rw [fourierInv_smul]

/-- The inverse Fourier Schwartz kernel of one integer dyadic band-pass is
the literal normalized physical dilation of the fixed unit-scale profile. -/
theorem fourierInv_intDyadicBandpassMultiplier_eq_integerDyadicBandpassKernel
    {d : Nat} (chi : SchwartzMap (Euclidean d) Complex) (k : Int)
    (x : Euclidean d) :
    (fourierInv (intDyadicBandpassMultiplier chi k) :
      SchwartzMap (Euclidean d) Complex) x =
        integerDyadicBandpassKernel chi k x := by
  let s : Real := (2 : Real) ^ k
  have hs : 0 < s := by
    dsimp only [s]
    exact zpow_pos (by norm_num : (0 : Real) < 2) k
  rw [SchwartzMap.fourierInv_coe]
  rw [show (intDyadicBandpassMultiplier chi k : Euclidean d → Complex) =
      fun xi : Euclidean d => integerDyadicBandpassPrototype chi (s⁻¹ • xi) by
    funext xi
    rw [intDyadicBandpassMultiplier_eq_prototype_scale]
    simp only [integerDyadicFrequencyScale, s]
    ]
  unfold integerDyadicBandpassKernel relativeSchwartzMultiplierKernel
  rw [SchwartzMap.fourierInv_coe]
  simpa [integerDyadicBandpassKernel, relativeSchwartzMultiplierKernel,
    integerDyadicFrequencyScale, s, finrank_euclideanSpace_fin] using
    (fourierInv_comp_inv_smul
      (g := (integerDyadicBandpassPrototype chi : Euclidean d → Complex)) hs x)

theorem hasCompactSupport_integerDyadicBandpassPrototype {d : Nat}
    (C : lpCutoffs d) :
    HasCompactSupport (integerDyadicBandpassPrototype C.cutoff :
      Euclidean d → Complex) := by
  rw [HasCompactSupport]
  apply (isCompact_closedBall (0 : Euclidean d) 4).of_isClosed_subset isClosed_closure
  apply closure_minimal
  · intro x hx
    rw [Function.mem_support] at hx
    have hbounds := intDyadicBandpass_norm_bounds_of_ne_zero C hx
    rw [Metric.mem_closedBall, dist_zero_right]
    norm_num at hbounds ⊢
    exact hbounds.2.le
  · exact Metric.isClosed_closedBall

theorem integerDyadicBandpassPrototype_zero_on_ball {d : Nat}
    (C : lpCutoffs d) {x : Euclidean d} (hx : x ∈ Metric.ball 0 1) :
    integerDyadicBandpassPrototype C.cutoff x = 0 := by
  unfold integerDyadicBandpassPrototype
  rw [intDyadicBandpassMultiplier_apply]
  have hxnorm : ‖x‖ ≤ 1 := by
    rw [Metric.mem_ball, dist_zero_right] at hx
    exact hx.le
  have hfirst : C.cutoff (((2 : Real) ^ ((0 : Int) + 1))⁻¹ • x) = 1 := by
    apply C.cutoff_one
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos]
    · norm_num
      calc
        (1 / 2 : Real) * ‖x‖ ≤ 1 * ‖x‖ := by gcongr; norm_num
        _ ≤ 1 := by simpa using hxnorm
    · positivity
  have hsecond : C.cutoff (((2 : Real) ^ (0 : Int))⁻¹ • x) = 1 := by
    apply C.cutoff_one
    simpa using hxnorm
  rw [hfirst, hsecond, sub_self]

theorem hasCompactSupport_intDyadicBandpassMultiplier {d : Nat}
    (C : lpCutoffs d) (k : Int) :
    HasCompactSupport (intDyadicBandpassMultiplier C.cutoff k :
      Euclidean d → Complex) := by
  rw [show (intDyadicBandpassMultiplier C.cutoff k : Euclidean d → Complex) =
      fun x => integerDyadicBandpassPrototype C.cutoff
        ((integerDyadicFrequencyScale k).1 • x) by
      funext x
      exact intDyadicBandpassMultiplier_eq_prototype_scale C.cutoff k x]
  exact hasCompactSupport_integerDyadicBandpassPrototype C |>.comp_smul
    (ne_of_gt (integerDyadicFrequencyScale k).2)

theorem intDyadicBandpassMultiplier_zero_on_ball {d : Nat}
    (C : lpCutoffs d) (k : Int) {x : Euclidean d}
    (hx : x ∈ Metric.ball 0 ((2 : Real) ^ k)) :
    intDyadicBandpassMultiplier C.cutoff k x = 0 := by
  rw [intDyadicBandpassMultiplier]
  have hxnorm : ‖x‖ ≤ (2 : Real) ^ k := by
    rw [Metric.mem_ball, dist_zero_right] at hx
    exact hx.le
  have htop : intDyadicLowpassMultiplier C.cutoff (k + 1) x = 1 := by
    apply intDyadicLowpass_eq_one_of_norm_le C
    have hmono : (2 : Real) ^ k ≤ (2 : Real) ^ (k + 1) :=
      (zpow_right_strictMono₀ (by norm_num : (1 : Real) < 2)).monotone (by omega)
    exact hxnorm.trans hmono
  have hbottom : intDyadicLowpassMultiplier C.cutoff k x = 1 :=
    intDyadicLowpass_eq_one_of_norm_le C hxnorm
  simp [Pi.sub_apply, htop, hbottom]

theorem contDiff_hasCompactSupport_intDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int)
    {A : Real} (hm : MikhlinCondition N m A) :
    ContDiff Real N (fun x => intDyadicBandpassMultiplier C.cutoff k x * m x) ∧
      HasCompactSupport (fun x => intDyadicBandpassMultiplier C.cutoff k x * m x) := by
  exact contDiff_hasCompactSupport_cutoff_mul_punctured
    (intDyadicBandpassMultiplier C.cutoff k) m ((2 : Real) ^ k)
    (zpow_pos (by norm_num) _) (SchwartzMap.smooth _ (N : ENat))
    (hasCompactSupport_intDyadicBandpassMultiplier C k)
    (fun x hx => intDyadicBandpassMultiplier_zero_on_ball C k hx) hm.1

theorem weighted_deriv_intDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {x : Euclidean d} (hx : x ≠ 0) {n : Nat} (hn : n ≤ N) :
    ‖x‖ ^ n * ‖iteratedFDeriv Real n
      (fun y => intDyadicBandpassMultiplier C.cutoff k y * m y) x‖ ≤
      A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n := by
  simpa only [intDyadicBandpassMultiplier_eq_prototype_scale] using
    (norm_iteratedFDeriv_dilated_schwartz_cutoff_mul_mikhlin_le
      (integerDyadicBandpassPrototype C.cutoff) m hm hA
      (integerDyadicFrequencyScale k).1 hx hn)

def normalizedIntDyadicMikhlinPiece {d : Nat} (C : lpCutoffs d)
    (m : Euclidean d → Complex) (k : Int) : Euclidean d → Complex :=
  fun x => (fun y => intDyadicBandpassMultiplier C.cutoff k y * m y)
    ((integerDyadicFrequencyScale k).1⁻¹ • x)

theorem normalizedIntDyadicMikhlinPiece_apply {d : Nat}
    (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int) (x : Euclidean d) :
    normalizedIntDyadicMikhlinPiece C m k x =
      integerDyadicBandpassPrototype C.cutoff x *
        m ((integerDyadicFrequencyScale k).1⁻¹ • x) := by
  unfold normalizedIntDyadicMikhlinPiece
  change intDyadicBandpassMultiplier C.cutoff k
      ((integerDyadicFrequencyScale k).1⁻¹ • x) *
        m ((integerDyadicFrequencyScale k).1⁻¹ • x) = _
  rw [intDyadicBandpassMultiplier_eq_prototype_scale]
  have hs : (integerDyadicFrequencyScale k).1 ≠ 0 :=
    ne_of_gt (integerDyadicFrequencyScale k).2
  rw [smul_smul, mul_inv_cancel₀ hs, one_smul]

theorem contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int)
    {A : Real} (hm : MikhlinCondition N m A) :
    ContDiff Real N (normalizedIntDyadicMikhlinPiece C m k) ∧
      HasCompactSupport (normalizedIntDyadicMikhlinPiece C m k) := by
  have hraw := contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm
  have hs : (integerDyadicFrequencyScale k).1 ≠ 0 :=
    ne_of_gt (integerDyadicFrequencyScale k).2
  constructor
  · change ContDiff Real N (fun x : Euclidean d =>
      (intDyadicBandpassMultiplier C.cutoff k
        ((integerDyadicFrequencyScale k).1⁻¹ • x)) *
        m ((integerDyadicFrequencyScale k).1⁻¹ • x))
    simpa only [Function.comp_def] using
      hraw.1.comp (contDiff_const_smul ((integerDyadicFrequencyScale k).1⁻¹)
        : ContDiff Real N fun x : Euclidean d =>
          (integerDyadicFrequencyScale k).1⁻¹ • x)
  · exact hraw.2.comp_smul (inv_ne_zero hs)

theorem tsupport_normalizedIntDyadicMikhlinPiece_subset_unit_annulus
    {d : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) (k : Int) :
    tsupport (normalizedIntDyadicMikhlinPiece C m k) ⊆
      {x : Euclidean d | 1 ≤ ‖x‖ ∧ ‖x‖ ≤ 4} := by
  apply closure_minimal
  · intro x hx
    rw [Function.mem_support] at hx
    rw [normalizedIntDyadicMikhlinPiece_apply] at hx
    have hprototype : integerDyadicBandpassPrototype C.cutoff x ≠ 0 := by
      intro hzero
      apply hx
      simp [hzero]
    have hbounds := intDyadicBandpass_norm_bounds_of_ne_zero C
      (k := 0) (by simpa [integerDyadicBandpassPrototype] using hprototype)
    norm_num at hbounds ⊢
    exact ⟨hbounds.1.le, hbounds.2.le⟩
  · exact (isClosed_le continuous_const continuous_norm).inter
      (isClosed_le continuous_norm continuous_const)

theorem weighted_deriv_normalizedIntDyadicMikhlinPiece
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {x : Euclidean d} (hx : x ≠ 0) {n : Nat} (hn : n ≤ N) :
    ‖x‖ ^ n * ‖iteratedFDeriv Real n
      (normalizedIntDyadicMikhlinPiece C m k) x‖ ≤
      A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n := by
  let s : Real := (integerDyadicFrequencyScale k).1
  let F : Euclidean d → Complex :=
    fun y => intDyadicBandpassMultiplier C.cutoff k y * m y
  have hF : ContDiff Real N F :=
    (contDiff_hasCompactSupport_intDyadicMikhlinPiece C m k hm).1
  have hs : s ≠ 0 := by
    dsimp only [s]
    exact ne_of_gt (integerDyadicFrequencyScale k).2
  have hchain : iteratedFDeriv Real n (fun z : Euclidean d => F (s⁻¹ • z)) x =
      s⁻¹ ^ n • iteratedFDeriv Real n F (s⁻¹ • x) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul s⁻¹
        (hF.of_le (by exact_mod_cast hn))) x
  have hsx : s⁻¹ • x ≠ 0 := smul_ne_zero (inv_ne_zero hs) hx
  have hraw := weighted_deriv_intDyadicMikhlinPiece C m hm hA k hsx hn
  change ‖x‖ ^ n * ‖iteratedFDeriv Real n (fun z : Euclidean d => F (s⁻¹ • z)) x‖ ≤ _
  calc
    ‖x‖ ^ n * ‖iteratedFDeriv Real n (fun z : Euclidean d => F (s⁻¹ • z)) x‖ =
        ‖s⁻¹ • x‖ ^ n * ‖iteratedFDeriv Real n F (s⁻¹ • x)‖ := by
      rw [hchain, norm_smul, norm_pow, norm_smul, mul_pow]
      ring
    _ ≤ _ := hraw

theorem deriv_normalizedIntDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {n : Nat} (hn : n ≤ N) (x : Euclidean d) :
    ‖iteratedFDeriv Real n (normalizedIntDyadicMikhlinPiece C m k) x‖ ≤
      A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let B : Real := A * schwartzWeightedCutoffDerivativeConstant (N := N)
    (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n
  have hcutoff : 0 ≤ schwartzWeightedCutoffDerivativeConstant (N := N)
      (integerDyadicBandpassPrototype C.cutoff) := by
    unfold schwartzWeightedCutoffDerivativeConstant
    exact Finset.sum_nonneg fun i hi =>
      (show 0 ≤ ‖(0 : Euclidean d)‖ ^ i *
        ‖iteratedFDeriv Real i (integerDyadicBandpassPrototype C.cutoff) 0‖ by positivity).trans
        (SchwartzMap.le_seminorm Real i i
          (integerDyadicBandpassPrototype C.cutoff) 0)
  by_cases hzero : iteratedFDeriv Real n G x = 0
  · rw [hzero, norm_zero]
    exact mul_nonneg (mul_nonneg hA hcutoff) (pow_nonneg (by norm_num) _)
  · have hxsupport : x ∈ Function.support (iteratedFDeriv Real n G) :=
      Function.mem_support.mpr hzero
    have hxannulus : 1 ≤ ‖x‖ ∧ ‖x‖ ≤ 4 :=
      ((support_iteratedFDeriv_subset n).trans
        (tsupport_normalizedIntDyadicMikhlinPiece_subset_unit_annulus C m k)) hxsupport
    have hxne : x ≠ 0 := by
      intro hx
      subst x
      norm_num at hxannulus
    have hweighted := weighted_deriv_normalizedIntDyadicMikhlinPiece
      C m hm hA k hxne hn
    change ‖iteratedFDeriv Real n G x‖ ≤ B
    calc
      ‖iteratedFDeriv Real n G x‖ = 1 * ‖iteratedFDeriv Real n G x‖ := by ring
      _ ≤ ‖x‖ ^ n * ‖iteratedFDeriv Real n G x‖ :=
        mul_le_mul_of_nonneg_right (one_le_pow₀ hxannulus.1) (norm_nonneg _)
      _ ≤ B := hweighted

theorem integral_norm_iteratedFDeriv_normalizedIntDyadicMikhlinPiece_le
    {d N : Nat} (C : lpCutoffs d) (m : Euclidean d → Complex) {A : Real}
    (hm : MikhlinCondition N m A) (hA : 0 ≤ A) (k : Int)
    {n : Nat} (hn : n ≤ N) :
    (∫ x : Euclidean d, ‖iteratedFDeriv Real n
      (normalizedIntDyadicMikhlinPiece C m k) x‖) ≤
      (A * schwartzWeightedCutoffDerivativeConstant (N := N)
        (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n) *
        (volume (Metric.closedBall (0 : Euclidean d) 4)).toReal := by
  let G := normalizedIntDyadicMikhlinPiece C m k
  let B : Real := A * schwartzWeightedCutoffDerivativeConstant (N := N)
    (integerDyadicBandpassPrototype C.cutoff) * (2 : Real) ^ n
  let S : Set (Euclidean d) := Metric.closedBall 0 4
  change (∫ x : Euclidean d, ‖iteratedFDeriv Real n G x‖) ≤
    B * (volume S).toReal
  have hG := contDiff_hasCompactSupport_normalizedIntDyadicMikhlinPiece C m k hm
  have hSmeas : MeasurableSet S := Metric.isClosed_closedBall.measurableSet
  have hind : Integrable (S.indicator (fun _ : Euclidean d => B)) volume :=
    (integrable_indicator_iff hSmeas).mpr
      (integrableOn_const (hs := (measure_closedBall_lt_top).ne))
  have hderivInt : Integrable (fun x : Euclidean d =>
      ‖iteratedFDeriv Real n G x‖) volume := by
    have hcont : Continuous (fun x : Euclidean d =>
        ‖iteratedFDeriv Real n G x‖) :=
      (hG.1.continuous_iteratedFDeriv (by exact_mod_cast hn)).norm
    exact hcont.integrable_of_hasCompactSupport ((hG.2.iteratedFDeriv n).norm)
  have hderivSupport : Function.support (iteratedFDeriv Real n G) ⊆ S := by
    intro x hx
    have hxannulus : 1 ≤ ‖x‖ ∧ ‖x‖ ≤ 4 :=
      ((support_iteratedFDeriv_subset n).trans
        (tsupport_normalizedIntDyadicMikhlinPiece_subset_unit_annulus C m k)) hx
    simpa only [S, Metric.mem_closedBall, dist_zero_right] using hxannulus.2
  have hpoint : ∀ x : Euclidean d, ‖iteratedFDeriv Real n G x‖ ≤
      S.indicator (fun _ : Euclidean d => B) x := by
    intro x
    by_cases hxS : x ∈ S
    · rw [Set.indicator_of_mem hxS]
      exact deriv_normalizedIntDyadicMikhlinPiece_le C m hm hA k hn x
    · have hzero : iteratedFDeriv Real n G x = 0 := by
        by_contra hne
        exact hxS (hderivSupport (Function.mem_support.mpr hne))
      simp [hxS, hzero]
  have hmono := integral_mono_ae hderivInt hind
    (Filter.Eventually.of_forall hpoint)
  calc
    (∫ x : Euclidean d, ‖iteratedFDeriv Real n G x‖) ≤
        ∫ x : Euclidean d, S.indicator (fun _ : Euclidean d => B) x := hmono
    _ = (volume S).toReal * B := by
      simpa only [Measure.real_def, smul_eq_mul] using
        (integral_indicator_const (μ := volume) (e := B) hSmeas)
    _ = B * (volume S).toReal := by ring

