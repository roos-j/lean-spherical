                ∫⁻ y in Metric.ball x ((2 : ℝ) ^ n), ENNReal.ofReal ‖f y‖)).toReal *
              (volume (Metric.ball (0 : Euclidean d) 1)).toReal) := by
  obtain ⟨D, hD, hraw⟩ :=
    exists_iSup_ennreal_norm_relative_surface_scaled_schwartz_multiplier_le_dyadic_average_sup hd ψ
  refine ⟨D, hD, ?_⟩
  intro j f x
  let M : ℝ :=
