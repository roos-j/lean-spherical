    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q)
    {B B' : ENNReal} (hB : (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) ≤ B)
    (hB' : (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) ≤ B') :
    (∫⁻ r : ℝ, (⨆ t ∈ E, ‖brsRefl F (t - r)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) * (B + ENNReal.ofReal δ * B') ^ q := by
  have hRefl : Continuous (brsRefl F) := continuous_brsRefl hF
  have hReflDeriv : Continuous fun z : ℝ => -(F' (-z)) :=
    (hF'.comp continuous_neg).neg
  have hd : ∀ z : ℝ, HasDerivAt (brsRefl F) (-(F' (-z))) z := fun z =>
    hasDerivAt_comp_neg hderiv z
  have hBrefl : (∫⁻ z : ℝ, ‖brsRefl F z‖ₑ ^ q) ^ (1 / q) ≤ B := by
    rwa [show (∫⁻ z : ℝ, ‖brsRefl F z‖ₑ ^ q) = ∫⁻ z : ℝ, ‖F z‖ₑ ^ q from
      lintegral_enorm_comp_neg F q]
  have hB'refl : (∫⁻ z : ℝ, ‖-(F' (-z))‖ₑ ^ q) ^ (1 / q) ≤ B' := by
    have heq : (∫⁻ z : ℝ, ‖-(F' (-z))‖ₑ ^ q) = ∫⁻ z : ℝ, ‖F' z‖ₑ ^ q := by
      rw [← lintegral_enorm_comp_neg F' q]
      refine lintegral_congr fun z => ?_
      rw [enorm_neg]
    rwa [heq]
  exact lintegral_iSup_translate_le_of_bounds hδ hcov hRefl hReflDeriv hd hq
    hBrefl hB'refl


/-! ## Existence of the convolutions appearing in the associativity step

Every convolution occurring in `Ψ ⋆ (h_k ⋆ h) = (h_k * Ψ) ⋆ h` pairs an `L¹`
function with a bounded one, so all of them exist.  These are the side
conditions of Mathlib's `convolution_assoc`. -/

/-- An `L¹` function against a bounded continuous one. -/
theorem integrable_mul_shift_of_bounded {f : ℝ → ℝ} (hf : Integrable f volume)
    {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (y : ℝ) : Integrable (fun t : ℝ => (f t : ℂ) * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (norm_nonneg (g 0)) (hbd 0)
  have hmeas : AEStronglyMeasurable (fun t : ℝ => (f t : ℂ) * g (y - t))
      volume := by
    refine AEStronglyMeasurable.mul ?_ ?_
    · exact Complex.continuous_ofReal.comp_aestronglyMeasurable
        hf.aestronglyMeasurable
    · exact (hg.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
  refine Integrable.mono' (hf.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
  calc |f t| * ‖g (y - t)‖ ≤ |f t| * C :=
        mul_le_mul_of_nonneg_left (hbd _) (abs_nonneg _)
    _ = C * |f t| := by ring

/-- The same, with the shift on the other side. -/
theorem integrable_mul_shift_of_bounded' {f : ℝ → ℝ} (hf : Integrable f volume)
    {g : ℝ → ℝ} {C : ℝ} (hgm : Measurable g) (hbd : ∀ z : ℝ, |g z| ≤ C)
    (y : ℝ) : Integrable (fun t : ℝ => f t * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg (g 0)) (hbd 0)
  have hmeas : AEStronglyMeasurable (fun t : ℝ => f t * g (y - t)) volume :=
    hf.aestronglyMeasurable.mul
      ((hgm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
  refine Integrable.mono' (hf.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs]
  calc |f t| * |g (y - t)| ≤ |f t| * C :=
        mul_le_mul_of_nonneg_left (hbd _) (abs_nonneg _)
    _ = C * |f t| := by ring


/-! ## Boundedness of the auxiliary convolution `‖Ψ‖ ⋆ ‖h‖` -/

/-- The convolution of an `L¹` function with a bounded one is bounded. -/
theorem convolution_norm_le_of_bounded {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (u : ℝ) :
    (∫ s : ℝ, ‖Ψ s‖ * ‖h (u - s)‖) ≤ C * ∫ s : ℝ, ‖Ψ s‖ := by
  have hCnn : 0 ≤ C := le_trans (norm_nonneg (h 0)) (hbd 0)
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  have hmeas : Measurable fun z : ℝ => ‖h z‖ := hh.norm.measurable
  have hleft : Integrable (fun s : ℝ => ‖Ψ s‖ * ‖h (u - s)‖) volume :=
    integrable_mul_shift_of_bounded' hΨint.norm hmeas
      (fun z => by
        rw [abs_of_nonneg (norm_nonneg _)]
        exact hbd z) u
  have hright : Integrable (fun s : ℝ => ‖Ψ s‖ * C) volume :=
    hΨint.norm.mul_const C
  calc (∫ s : ℝ, ‖Ψ s‖ * ‖h (u - s)‖) ≤ ∫ s : ℝ, ‖Ψ s‖ * C :=
        integral_mono hleft hright fun s =>
          mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
    _ = C * ∫ s : ℝ, ‖Ψ s‖ := by
        rw [integral_mul_const]
        ring

/-- The auxiliary convolution `‖Ψ‖ ⋆ ‖h‖` is continuous. -/
theorem continuous_convolution_norm {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) :
    Continuous ((fun z : ℝ => ‖Ψ z‖) ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
      fun z : ℝ => ‖h z‖) := by
  refine HasCompactSupport.continuous_convolution_left
    (ContinuousLinearMap.mul ℝ ℝ) ?_ hΨ.norm ?_
  · exact hΨcs.norm
  · exact hh.norm.locallyIntegrable


/-! ## Associativity for the truncated kernel -/

/-- **`(h_k * Ψ) ⋆ h = h_k ⋆ (Ψ ⋆ h)`.** -/
theorem brs_conv_assoc (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    ((brsTruncKernel k ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] Ψ)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
            ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
          h)) x := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  obtain ⟨MΨ, hMΨ⟩ := hΨ.bounded_above_of_compact_support hΨcs
  have hconvbd : ∀ z : ℝ,
      |((fun w : ℝ => ‖Ψ w‖) ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
        fun w : ℝ => ‖h w‖) z| ≤ C * ∫ s : ℝ, ‖Ψ s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖Ψ w‖) ⋆[ContinuousLinearMap.mul ℝ ℝ,
        volume] fun w : ℝ => ‖h w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    exact convolution_norm_le_of_bounded hΨ hΨcs hh hbd z
  refine convolution_assoc _ _ _ _ (fun a b z => mul_smul a b z)
    hK.aestronglyMeasurable hΨint.aestronglyMeasurable hh.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hK hΨ.measurable
      (fun z => by simpa only [Real.norm_eq_abs] using hMΨ z) y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    refine integrable_mul_shift_of_bounded' (C := C) hΨint.norm
      hh.norm.measurable (fun z => ?_) u
    rw [abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hK.norm
      (continuous_convolution_norm hΨ hΨcs hh).measurable hconvbd x


/-! ## The smoothed near part, and the resolution applied to it

`h_k ⋆ h` is continuous whenever `h` is bounded and continuous, so the
resolution of the identity applies to it directly. -/

/-- The convolution with the truncated kernel is continuous. -/
theorem continuous_brsTruncKernel_convolution (k : ℕ) {h : ℝ → ℂ}
    (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) :
    Continuous (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) := by
  refine BddAbove.continuous_convolution_right_of_integrable _ ?_
    (integrable_brsTruncKernel k) hh
  refine ⟨C, ?_⟩
  rintro y ⟨z, rfl⟩
  exact hbd z

/-- **The resolution of the identity applied to the smoothed near part.** -/
theorem brs_resolution_truncConv (k s : ℕ) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hsupp : HasCompactSupport φ) (hnorm : (∫ x, φ x) = 1) {h : ℝ → ℂ}
    (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    Tendsto (fun M : ℕ =>
        (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
            (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
              ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) +
          ∑ m ∈ Finset.range M, ∫ y : ℝ,
            (brsLPKernel φ (k + s + m) y : ℂ) *
              (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
                ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y))
      atTop (𝓝 ((brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x)) :=
  brs_lp_resolution_shift_tendsto hφ hsupp hnorm
    (continuous_brsTruncKernel_convolution k hh hbd) (k + s) x


/-! ## Associativity with the bump on the outside

The resolution of the identity produces the pieces in the form `Ψ ⋆ (h_k ⋆ h)`,
so the associativity is needed with `Ψ` as the outer factor. -/

/-- A bounded function against a shifted `L¹` one. -/
theorem integrable_bounded_mul_shift {f : ℝ → ℝ} {C : ℝ} (hfm : Measurable f)
    (hbd : ∀ z : ℝ, |f z| ≤ C) {g : ℝ → ℝ} (hg : Integrable g volume)
    (y : ℝ) : Integrable (fun t : ℝ => f t * g (y - t)) volume := by
  have hCnn : 0 ≤ C := le_trans (abs_nonneg (f 0)) (hbd 0)
  have hshift : Integrable (fun t : ℝ => g (y - t)) volume := hg.comp_sub_left y
  have hmeas : AEStronglyMeasurable (fun t : ℝ => f t * g (y - t)) volume :=
    hfm.aestronglyMeasurable.mul hshift.aestronglyMeasurable
  refine Integrable.mono' (hshift.norm.const_mul C) hmeas ?_
  filter_upwards with t
  rw [Real.norm_eq_abs, abs_mul, Real.norm_eq_abs]
  exact mul_le_mul_of_nonneg_right (hbd t) (abs_nonneg _)

/-- **`(Ψ * h_k) ⋆ h = Ψ ⋆ (h_k ⋆ h)`.** -/
theorem brs_conv_assoc' (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  have hΨint : Integrable Ψ volume := hΨ.integrable_of_hasCompactSupport hΨcs
  obtain ⟨MΨ, hMΨ⟩ := hΨ.bounded_above_of_compact_support hΨcs
  -- the auxiliary convolution `‖h_k‖ ⋆ ‖h‖` is bounded and continuous
  have hauxcont : Continuous ((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hK.norm
      hh.norm
    refine ⟨C, ?_⟩
    rintro y ⟨z, rfl⟩
    show ‖‖h z‖‖ ≤ C
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  have hauxbd : ∀ z : ℝ, |((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z| ≤
      C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖brsTruncKernel k w‖)
        ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    have hleft : Integrable (fun s : ℝ =>
        ‖brsTruncKernel k s‖ * ‖h (z - s)‖) volume :=
      integrable_mul_shift_of_bounded' (C := C) hK.norm hh.norm.measurable
        (fun w => by
          rw [abs_of_nonneg (norm_nonneg _)]
          exact hbd w) z
    have hright : Integrable (fun s : ℝ => ‖brsTruncKernel k s‖ * C) volume :=
      hK.norm.mul_const C
    calc (∫ s : ℝ, ‖brsTruncKernel k s‖ * ‖h (z - s)‖)
        ≤ ∫ s : ℝ, ‖brsTruncKernel k s‖ * C :=
          integral_mono hleft hright fun s =>
            mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
      _ = C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
          rw [integral_mul_const]
          ring
  refine convolution_assoc _ _ _ _ (fun a b z => mul_smul a b z)
    hΨint.aestronglyMeasurable hK.aestronglyMeasurable hh.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_bounded_mul_shift hΨ.measurable
      (fun z => by simpa only [Real.norm_eq_abs] using hMΨ z) hK y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    refine integrable_mul_shift_of_bounded' (C := C) hK.norm
      hh.norm.measurable (fun z => ?_) u
    rw [abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hΨint.norm hauxcont.measurable
      hauxbd x


/-! ## Each piece of the resolution has the smooth kernel `h_k * Ψ`

Testing the smoothed near part against a bump is the same as testing the input
against the smooth kernel `h_k * Ψ`.  This is what puts every piece of the
resolution into the shape that `brs_5_9` estimates. -/

/-- **The piece of the resolution, with its kernel identified.** -/
theorem brs_piece_eq (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨcs : HasCompactSupport Ψ) {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (x : ℝ) :
    (∫ y : ℝ, (Ψ y : ℂ) *
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * h (x - y) := by
  have h1 : (∫ y : ℝ, (Ψ y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := (convolution_eq_integral x).symm
  have h2 : (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x =
      ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x :=
    (brs_conv_assoc' k hΨ hΨcs hh hbd x).symm
  have h3 : ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
      ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      ∫ y : ℝ, (((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
        brsTruncKernel k) y : ℝ) : ℂ) * h (x - y) := convolution_eq_integral x
  have h4 : (Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k) =
      brsTruncConvReal k Ψ := (brsTruncConvReal_eq_convolution k Ψ).symm
  rw [h1, h2, h3, h4]


/-! ## Passing from the resolution to a domination

The resolution converges, so the limit is dominated by the low-frequency term
plus the sum of the high-frequency pieces. -/

/-- **The limit of a convergent resolution is dominated by its terms.** -/
theorem enorm_le_tsum_of_tendsto {A : ℕ → ℂ} {L S : ℂ}
    (h : Tendsto (fun M : ℕ => L + ∑ m ∈ Finset.range M, A m) atTop (𝓝 S)) :
    ‖S‖ₑ ≤ ‖L‖ₑ + ∑' m : ℕ, ‖A m‖ₑ := by
  have hnorm : Tendsto (fun M : ℕ => ‖L + ∑ m ∈ Finset.range M, A m‖ₑ) atTop
      (𝓝 ‖S‖ₑ) := (continuous_enorm.tendsto S).comp h
  refine le_of_tendsto hnorm ?_
  filter_upwards with M
  calc ‖L + ∑ m ∈ Finset.range M, A m‖ₑ
      ≤ ‖L‖ₑ + ‖∑ m ∈ Finset.range M, A m‖ₑ := enorm_add_le _ _
    _ ≤ ‖L‖ₑ + ∑ m ∈ Finset.range M, ‖A m‖ₑ := by
        refine add_le_add le_rfl ?_
        exact enorm_sum_le _ _
    _ ≤ ‖L‖ₑ + ∑' m : ℕ, ‖A m‖ₑ :=
        add_le_add le_rfl (ENNReal.sum_le_tsum _)


/-! ## The maximal function of one piece -/

/-- A supremum of sums is at most the sum of the suprema. -/
theorem iSup_add_tsum_le {ι : Type*} {S : Set ι} {a : ι → ENNReal}
    {b : ℕ → ι → ENNReal} :
    (⨆ t ∈ S, (a t + ∑' m : ℕ, b m t)) ≤
      (⨆ t ∈ S, a t) + ∑' m : ℕ, ⨆ t ∈ S, b m t := by
  refine iSup₂_le fun t ht => ?_
  refine add_le_add (le_iSup₂_of_le t ht le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le t ht le_rfl

/-- The maximal function, over `t ∈ E`, of one piece of the resolution. -/
def brsNearPieceMax (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ

theorem brsRefl_bounded {g : ℝ → ℂ} {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (z : ℝ) : ‖brsRefl g z‖ ≤ C := hbd (-z)


/-! ## The near part is dominated by the pieces of the resolution -/

/-- **The near part, decomposed.**  With the truncation at the dyadic scale
`2^{-k}`, the near part of `R_2^-` is dominated by the low-frequency piece at
scale `k + s` plus the sum of the high-frequency pieces above it, each of which
carries the smooth kernel `h_k * Ψ`. -/
theorem brsANearLeftAt_le_pieces (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearLeftAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearPieceMax k (brsDilate φ (k + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax k (brsLPKernel φ (k + s + m)) g E r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  rw [brsANearLeftAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (iSup₂_mono fun t _ => ?_) iSup_add_tsum_le
  -- the resolution, evaluated at `-(t - r)`
  set x : ℝ := -(t - r) with hx
  have hres := brs_resolution_truncConv k s hφ hφcs hφnorm hgrefl hgreflbd x
  have hlow : (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq k (continuous_brsDilate hφ (k + s))
      (hasCompactSupport_brsDilate hφcs (k + s)) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel φ (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl g (x - y) := fun m =>
    brs_piece_eq k (continuous_brsLPKernel hφ (k + s + m))
      (hasCompactSupport_brsLPKernel hφcs (k + s + m)) hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres


/-! ## The maximal estimate for one piece of the resolution

This is `brs_5_9_core` in the reflected form produced by the decomposition of
the near part.  Reflection costs nothing, so the bound is the same. -/

/-- The maximal function of one piece over all of `E`. -/
def brsNearFullMax (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
    ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ

theorem brsNearPieceMax_le_full (k : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsNearPieceMax k Ψ g E r ≤ brsNearFullMax k Ψ g E r :=
  biSup_mono fun t ht => ht.1

/-- **The maximal estimate for one piece.** -/
theorem lintegral_brsNearFullMax_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (k : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsNearFullMax k υ g E x ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq1 : (1 : ℝ) < q := lt_trans hr hrq
  have hq0 : (0 : ℝ) < q := lt_trans zero_lt_one hq1
  have hgr : Continuous (brsRefl g) := continuous_brsRefl hg
  set K : ℝ → ℝ := brsTruncConvReal k υ with hKdef
  set K' : ℝ → ℝ := brsTruncConvReal k (deriv υ) with hK'def
  have hKcs : HasCompactSupport K := hasCompactSupport_brsTruncConvReal k hcs
  have hKcd : ContDiff ℝ 1 K := contDiff_brsTruncConvReal k (n := 1) hυ hcs
  have hK'cs : HasCompactSupport K' := hasCompactSupport_brsTruncConvReal k hcs'
  have hK'cd : ContDiff ℝ 1 K' :=
    contDiff_brsTruncConvReal k (n := 1) hυ' hcs'
  have hKm : Measurable K := hKcd.continuous.measurable
  have hK'm : Measurable K' := hK'cd.continuous.measurable
  have hderivK : deriv K = K' := by
    funext x
    exact (hasDerivAt_brsTruncConvReal k hcs hυ x).deriv
  set F : ℝ → ℂ := fun x => ∫ y : ℝ, (K y : ℂ) * brsRefl g (x - y) with hFdef
  set F' : ℝ → ℂ := fun x => ∫ y : ℝ, (K' y : ℂ) * brsRefl g (x - y) with hF'def
  have hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x := by
    intro x
    have h := hasDerivAt_kernel_convolution hKcs hKcd hgr x
    rw [hderivK] at h
    exact h
  have hFdiff : Differentiable ℝ F := fun x => (hderiv x).differentiableAt
  have hFcont : Continuous F := hFdiff.continuous
  have hF'cont : Continuous F' := by
    have hd2 : ∀ x : ℝ, HasDerivAt F'
        (∫ y : ℝ, ((deriv K' y : ℝ) : ℂ) * brsRefl g (x - y)) x := fun x =>
      hasDerivAt_kernel_convolution hK'cs hK'cd hgr x
    have hF'diff : Differentiable ℝ F' := fun x => (hd2 x).differentiableAt
    exact hF'diff.continuous
  -- the reflection does not change the `L^p` norm of `g`
  have hgp : (∫⁻ z : ℝ, ‖brsRefl g z‖ₑ ^ p) = ∫⁻ z : ℝ, ‖g z‖ₑ ^ p :=
    lintegral_enorm_comp_neg g p
  -- the two Young bounds
  have hyoung : ∀ H : ℝ → ℝ, Measurable H →
      (∫⁻ z : ℝ, ‖∫ y : ℝ, (H y : ℂ) * brsRefl g (z - y)‖ₑ ^ q) ^ (1 / q) ≤
        (∫⁻ y : ℝ, ‖H y‖ₑ ^ r) ^ (1 / r) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    intro H hH
    have h := lintegral_convolution_rpow_le_young hp hr hrq hpq hrel hH
      hgr.measurable
    rw [hgp] at h
    refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
    exact young_rpow_inv hp0 hq0 hr0
  exact lintegral_iSup_translate_refl_le hδ hcov hFcont hF'cont hderiv
    hq1.le (hyoung K hKm) (hyoung K' hK'm)




/-! ## The dyadic windows, extended to cover the whole range of radii

`R_2` vanishes for `r > 4/3`, but the dyadic windows `I_k` only cover `(0, 1]`.
Enlarging the top window to `(1/2, 4/3]` — which is still comparable to
`2^{-0} = 1` — makes the family cover `(0, 4/3]` without changing any of the
estimates: all that is used is that the windows are disjoint, that `r ≍ 2^{-k}`
on the `k`-th one, and that the truncation `2^{-(k+1)}` does not exceed `r`. -/

/-- The dyadic windows, with the top one enlarged to `(1/2, 4/3]`. -/
def brsWindowExt (k : ℕ) : Set ℝ :=
  match k with
  | 0 => Ioc (2 : ℝ)⁻¹ (4 / 3)
  | (k + 1) => brsRadiusWindow (k + 1)

theorem brsWindowExt_zero : brsWindowExt 0 = Ioc (2 : ℝ)⁻¹ (4 / 3) := rfl

theorem brsWindowExt_succ (k : ℕ) :
    brsWindowExt (k + 1) = brsRadiusWindow (k + 1) := rfl

theorem measurableSet_brsWindowExt (k : ℕ) : MeasurableSet (brsWindowExt k) := by
  cases k with
  | zero => exact measurableSet_Ioc
  | succ k => exact measurableSet_brsRadiusWindow (k + 1)

theorem brsWindowExt_pos {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) : 0 < r := by
  cases k with
  | zero =>
      have h : (2 : ℝ)⁻¹ < r := hr.1
      linarith
  | succ k => exact brsRadiusWindow_pos hr

/-- The windows of positive index sit below `1/2`. -/
theorem brsRadiusWindow_succ_le_half {k : ℕ} {r : ℝ}
    (hr : r ∈ brsRadiusWindow (k + 1)) : r ≤ (2 : ℝ)⁻¹ := by
  refine le_trans hr.2 ?_
  have h : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (-(1 : ℝ)) := by
    refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
    have : (1 : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by
      push_cast
      have : (0 : ℝ) ≤ (k : ℝ) := Nat.cast_nonneg k
      linarith
    linarith
  refine le_trans h (le_of_eq ?_)
  rw [show (-(1 : ℝ)) = ((-1 : ℤ) : ℝ) by norm_num, Real.rpow_intCast]
  norm_num

theorem brsWindowExt_disjoint {k l : ℕ} (h : k ≠ l) :
    Disjoint (brsWindowExt k) (brsWindowExt l) := by
  refine Set.disjoint_left.mpr fun r hk hl => ?_
  cases k with
  | zero =>
      cases l with
      | zero => exact h rfl
      | succ l =>
          have h1 : (2 : ℝ)⁻¹ < r := hk.1
          have h2 : r ≤ (2 : ℝ)⁻¹ := brsRadiusWindow_succ_le_half hl
          linarith
  | succ k =>
      cases l with
      | zero =>
          have h1 : (2 : ℝ)⁻¹ < r := hl.1
          have h2 : r ≤ (2 : ℝ)⁻¹ := brsRadiusWindow_succ_le_half hk
          linarith
      | succ l =>
          exact Set.disjoint_left.mp
            (brsRadiusWindow_disjoint (fun hc => h (by omega))) hk hl

/-- On every extended window the radius is comparable to `2^{-k}`. -/
theorem rpow_le_of_mem_brsWindowExt {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k)
    (e : ℝ) : r ^ e ≤ (2 : ℝ) ^ |e| * ((2 : ℝ) ^ (-(k : ℝ))) ^ e := by
  cases k with
  | zero =>
      have hlow : (2 : ℝ)⁻¹ < r := hr.1
      have hhigh : r ≤ 4 / 3 := hr.2
      have hrpos : (0 : ℝ) < r := by linarith
      have hone : ((2 : ℝ) ^ (-((0 : ℕ) : ℝ))) ^ e = 1 := by
        norm_num
      rw [hone, mul_one]
      rcases le_or_gt 0 e with he | he
      · have h1 : r ^ e ≤ (2 : ℝ) ^ e :=
          Real.rpow_le_rpow hrpos.le (by linarith) he
        rwa [abs_of_nonneg he]
      · have h1 : r ^ e ≤ ((2 : ℝ)⁻¹) ^ e :=
          Real.rpow_le_rpow_of_nonpos (by norm_num) hlow.le he.le
        have h2 : ((2 : ℝ)⁻¹) ^ e = (2 : ℝ) ^ |e| := by
          rw [Real.inv_rpow (by norm_num), abs_of_neg he,
            ← Real.rpow_neg (by norm_num)]
        rwa [h2] at h1
  | succ k => exact rpow_le_of_mem_brsRadiusWindow hr e

/-- The truncation scale never exceeds the radius. -/
theorem brsCut_le_of_mem_windowExt {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) :
    (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := by
  cases k with
  | zero =>
      have h : (2 : ℝ)⁻¹ < r := hr.1
      have hcast : (2 : ℝ) ^ (-((0 + 1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by
        norm_num
      rw [hcast]
      exact h.le
  | succ k =>
      have h : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) - 1) < r := hr.1
      have hcast : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
          (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) - 1) := by
        congr 1
        push_cast
        ring
      rw [hcast]
      exact h.le

/-! ## The radial weight on the window, for an arbitrary maximal function

On `I_k` the measure `r^{-q/2} r dr` costs `(2^{-k})^{1 - q/2}`, whatever the
maximal function it multiplies. -/

/-- **The radial weight costs `(2^{-k})^{1 - q/2}`.** -/
theorem lintegral_window_weight_rpow_le (k : ℕ) (S : ℝ → ENNReal) {q : ℝ}
    (hq : 0 < q) :
    (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) * ∫⁻ r : ℝ, S r ^ q := by
  set C : ℝ := (2 : ℝ) ^ |1 - q / 2| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)
    with hC
  have hpt : ∀ r : ℝ, ((brsWindowExt k).indicator
      (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
        ENNReal.ofReal r ≤ ENNReal.ofReal C * S r ^ q := by
    intro r
    by_cases hr : r ∈ brsWindowExt k
    · have hrpos : 0 < r := brsWindowExt_pos hr
      have hval : ((brsWindowExt k).indicator
          (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
            ENNReal.ofReal r = ENNReal.ofReal (r ^ (1 - q / 2)) * S r ^ q := by
        rw [Set.indicator_of_mem hr]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (S r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r ^ (1 - q / 2))) (S r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
              rw [Real.rpow_one]
          _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
          _ = r ^ (1 - q / 2) := by
              congr 1
              ring
      rw [hval]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (rpow_le_of_mem_brsWindowExt hr (1 - q / 2))) le_rfl
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal C * S r ^ q := lintegral_mono hpt
    _ = ENNReal.ofReal C * ∫⁻ r : ℝ, S r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- One piece of the resolution, with the window and the radial weight. -/
def brsNearMax (kw kt : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  (brsWindowExt kw).indicator
    (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      brsNearFullMax kt Ψ g E r) r

/-- **The weighted maximal estimate for one piece of the resolution.**  The
window index `kw` and the truncation index `kt` are kept apart: the cutoff must
not exceed the radius, so on `I_k` the truncation sits one scale finer. -/
theorem lintegral_brsNearMax_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (kw kt : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsNearMax kw kt υ g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal kt υ y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
              ENNReal.ofReal δ *
                ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                  (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  refine le_trans (lintegral_window_weight_rpow_le kw _ hq0) ?_
  exact mul_le_mul' le_rfl
    (lintegral_brsNearFullMax_rpow_le hδ hcov kt hcs hυ hcs' hυ' hg hp hr hrq
      hpq hrel)


/-! ## Young's inequality `L¹ ∗ L^r ⊆ L^r`

The lowest-frequency piece of the resolution carries no cancellation, so its
kernel `h_k * φ_j` has to be estimated by the plain convolution inequality.
Mathlib's Young inequality is stated for the Bochner integral with strict
exponent inequalities, so this endpoint case is proved here directly from
Hölder and Tonelli. -/

/-- `a ^ (r - 1) * a = a ^ r`, valid also at `a = 0`. -/
theorem ennreal_rpow_sub_one_mul {a : ENNReal} (ha : a ≠ ⊤) {r : ℝ}
    (hr : 1 ≤ r) : a ^ (r - 1) * a = a ^ r := by
  rcases eq_or_ne a 0 with rfl | ha0
  · rcases eq_or_lt_of_le hr with hr1 | hr1
    · rw [← hr1]
      norm_num
    · rw [ENNReal.zero_rpow_of_pos (by linarith), ENNReal.zero_rpow_of_pos
        (by linarith), mul_zero]
  · have h := ENNReal.rpow_add (x := a) (r - 1) 1 ha0 ha
    rw [ENNReal.rpow_one] at h
    rw [← h]
    congr 1
    ring

/-- The pointwise Hölder step in Young's inequality. -/
theorem lintegral_shift_mul_rpow_le_pointwise {K w : ℝ → ENNReal}
    (hK : Measurable K) (hw : Measurable w) {r : ℝ} (hr : 1 ≤ r) (x : ℝ) :
    (∫⁻ y : ℝ, K (x - y) * w y) ^ r ≤
      (∫⁻ y : ℝ, K (x - y) ^ r * w y) * (∫⁻ y : ℝ, w y) ^ (r - 1) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  rcases eq_or_lt_of_le hr with hr1 | hr1
  · rw [← hr1]
    simp only [ENNReal.rpow_one, sub_self, ENNReal.rpow_zero, mul_one]
    exact le_rfl
  · have hrinv : 1 / r < 1 := by
      rw [div_lt_one (by linarith)]
      exact hr1
    have hconj : r.HolderConjugate (Real.conjExponent r) :=
      Real.HolderConjugate.conjExponent hr1
    have hs : Real.conjExponent r = r / (r - 1) := rfl
    have hprod : ∀ y : ℝ, K (x - y) * w y =
        (K (x - y) * w y ^ (1 / r)) * w y ^ (1 - 1 / r) := by
      intro y
      rcases eq_or_ne (w y) 0 with hwy | hwy
      · rw [hwy, ENNReal.zero_rpow_of_pos (by positivity),
          ENNReal.zero_rpow_of_pos (by linarith), mul_zero, mul_zero]
      · rcases eq_or_ne (w y) ⊤ with hwt | hwt
        · rw [hwt, ENNReal.top_rpow_of_pos (by positivity),
            ENNReal.top_rpow_of_pos (by linarith), mul_assoc,
            ENNReal.top_mul_top]
        · have h := ENNReal.rpow_add (x := w y) (1 / r) (1 - 1 / r) hwy hwt
          rw [show (1 / r + (1 - 1 / r) : ℝ) = 1 by ring, ENNReal.rpow_one] at h
          rw [mul_assoc, ← h]
    have hfm : AEMeasurable (fun y : ℝ => K (x - y) * w y ^ (1 / r)) volume :=
      ((hK.comp (measurable_const.sub measurable_id)).mul
        (hw.pow_const _)).aemeasurable
    have hgm : AEMeasurable (fun y : ℝ => w y ^ (1 - 1 / r)) volume :=
      (hw.pow_const _).aemeasurable
    have hhold := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hconj hfm hgm
    simp only [Pi.mul_apply] at hhold
    rw [← lintegral_congr hprod] at hhold
    have hfr : (∫⁻ y : ℝ, (K (x - y) * w y ^ (1 / r)) ^ r) =
        ∫⁻ y : ℝ, K (x - y) ^ r * w y := by
      refine lintegral_congr fun y => ?_
      rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le, ← ENNReal.rpow_mul, one_div,
        inv_mul_cancel₀ (ne_of_gt hr0), ENNReal.rpow_one]
    have hgr : (∫⁻ y : ℝ, (w y ^ (1 - 1 / r)) ^ Real.conjExponent r) =
        ∫⁻ y : ℝ, w y := by
      refine lintegral_congr fun y => ?_
      rw [← ENNReal.rpow_mul, hs,
        show (1 - 1 / r) * (r / (r - 1)) = 1 by field_simp, ENNReal.rpow_one]
    rw [hfr, hgr] at hhold
    refine le_trans (ENNReal.rpow_le_rpow hhold hr0.le) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hr0.le]
    congr 1
    · rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ (ne_of_gt hr0),
        ENNReal.rpow_one]
    · rw [← ENNReal.rpow_mul, hs]
      congr 1
      field_simp

/-- **Young's inequality, `L¹ ∗ L^r ⊆ L^r`, in `ℝ≥0∞` form.** -/
theorem lintegral_shift_mul_rpow_le {K w : ℝ → ENNReal} (hK : Measurable K)
    (hw : Measurable w) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * w y) ^ r) ≤
      (∫⁻ y : ℝ, w y) ^ (r - 1) *
        ((∫⁻ y : ℝ, w y) * ∫⁻ u : ℝ, K u ^ r) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  set S : ENNReal := ∫⁻ y : ℝ, w y with hS
  have hjoint : Measurable
      (Function.uncurry fun x y : ℝ => K (x - y) ^ r * w y) :=
    ((hK.comp (measurable_fst.sub measurable_snd)).pow_const r).mul
      (hw.comp measurable_snd)
  have hmeas : Measurable fun x : ℝ => ∫⁻ y : ℝ, K (x - y) ^ r * w y :=
    hjoint.lintegral_prod_right' (ν := (volume : Measure ℝ))
  refine le_trans (lintegral_mono fun x =>
    lintegral_shift_mul_rpow_le_pointwise hK hw hr x) ?_
  rw [lintegral_mul_const'' _ hmeas.aemeasurable]
  rw [mul_comm (S ^ (r - 1)) (S * ∫⁻ u : ℝ, K u ^ r)]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  have hinner : ∀ y : ℝ, (∫⁻ x : ℝ, K (x - y) ^ r * w y) =
      (∫⁻ u : ℝ, K u ^ r) * w y := by
    intro y
    have hm : AEMeasurable (fun x : ℝ => K (x - y) ^ r) volume :=
      ((hK.comp (measurable_id.sub measurable_const)).pow_const r).aemeasurable
    rw [lintegral_mul_const'' (w y) (f := fun x : ℝ => K (x - y) ^ r) hm]
    congr 1
    exact lintegral_sub_right_eq_self (fun u => K u ^ r) y
  simp only [hinner]
  rw [lintegral_const_mul'' _ hw.aemeasurable, mul_comm]


/-! ## Aggregation over the dyadic windows, for an arbitrary family

The `k`-aggregation only uses that the windows `I_k` are pairwise disjoint and
that the `k`-th term vanishes off `I_k`; nothing else about the family matters.
Stating it this way lets the same argument serve both `𝒜_{k,m}` and the pieces
of the resolution of the identity. -/

/-- The `q`-th power of the sum over `k` is the sum of the `q`-th powers. -/
theorem tsum_window_rpow {A : ℕ → ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A k r = 0) {q : ℝ}
    (hq : 0 < q) (r : ℝ) :
    (∑' k : ℕ, A k r) ^ q = ∑' k : ℕ, A k r ^ q := by
  by_cases h : ∃ k : ℕ, r ∈ brsWindowExt k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ → A k r = 0 := by
      intro k hk
      refine hA k r fun hr => ?_
      exact Set.disjoint_left.mp (brsWindowExt_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero,
      tsum_eq_single k₀ fun k hk => by
        rw [hzero k hk, ENNReal.zero_rpow_of_pos hq]]
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, A k r = 0 := fun k => hA k r (h k)
    simp only [hall, tsum_zero, ENNReal.zero_rpow_of_pos hq]

/-- **The `k`-aggregation.**  Because the windows `I_k` are disjoint, the radial
`L^q` norm of the sum is exactly the `ℓ^q` sum. -/
theorem lintegral_tsum_window_rpow {A : ℕ → ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A k r = 0)
    (hmeas : ∀ k : ℕ, Measurable (A k)) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, A k r) ^ q * ENNReal.ofReal r) =
      ∑' k : ℕ, ∫⁻ r : ℝ, A k r ^ q * ENNReal.ofReal r := by
  have hmeas' : ∀ k : ℕ, AEMeasurable (fun r : ℝ =>
      A k r ^ q * ENNReal.ofReal r) volume := fun k =>
    (((hmeas k).pow_const q).mul ENNReal.measurable_ofReal).aemeasurable
  have hpt : ∀ r : ℝ, (∑' k : ℕ, A k r) ^ q * ENNReal.ofReal r =
      ∑' k : ℕ, A k r ^ q * ENNReal.ofReal r := by
    intro r
    rw [tsum_window_rpow hA hq r, ← ENNReal.tsum_mul_right]
  rw [lintegral_congr hpt]
  exact lintegral_tsum hmeas'

/-- **The double sum over the scales.** -/
theorem window_double_sum_le {A : ℕ → ℕ → ℝ → ENNReal}
    (hA : ∀ m k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A m k r = 0)
    (hmeas : ∀ m k : ℕ, Measurable (A m k)) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' m : ℕ, ∑' k : ℕ, A m k r) ^ q * ENNReal.ofReal r) ^
        (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ,
        ∫⁻ r : ℝ, A m k r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hGmeas : ∀ m : ℕ, Measurable fun r : ℝ => ∑' k : ℕ, A m k r :=
    fun m => Measurable.ennreal_tsum fun k => hmeas m k
  refine le_trans (lintegral_radial_Lp_tsum_le hq hGmeas) (le_of_eq ?_)
  refine tsum_congr fun m => ?_
  rw [lintegral_tsum_window_rpow (fun k => hA m k) (hmeas m) hq0]


/-! ## The kernel of the lowest-frequency piece

`φ_{k+s}` is an approximate identity, so `h_k * φ_{k+s}` carries no
cancellation and (5.12) does not apply.  Young's inequality gives the bound
`‖h_k * φ_j‖_r ≤ ‖φ‖₁ ‖h_k‖_r`, which is the same dyadic factor
`(2^{-k})^{1/r - 1/2}` that (5.12) produces at `j = k`. -/

/-- **`‖h_k * ψ‖_r ≤ ‖ψ‖₁ ‖h_k‖_r`.** -/
theorem lintegral_enorm_brsTruncConvReal_le_L1 (k : ℕ) {ψ : ℝ → ℝ}
    (hψ : Continuous ψ) (hint : Integrable ψ volume) {A : ℝ}
    (hA : (∫ y : ℝ, |ψ y|) ≤ A) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r) ≤
      ENNReal.ofReal (A ^ r) *
        ∫⁻ u : ℝ, ENNReal.ofReal (brsTruncKernel k u) ^ r := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  set K : ℝ → ENNReal := fun u => ENNReal.ofReal (brsTruncKernel k u) with hK
  set w : ℝ → ENNReal := fun y => ‖ψ y‖ₑ with hw
  have hKm : Measurable K := ENNReal.measurable_ofReal.comp
    (measurable_brsTruncKernel k)
  have hwm : Measurable w := hψ.measurable.enorm
  -- the pointwise bound
  have hpt : ∀ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ≤ ∫⁻ y : ℝ, K (x - y) * w y := by
    intro x
    rw [brsTruncConvReal]
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun y => ?_
    rw [enorm_mul, hK, hw]
    simp only
    rw [enorm_brsTruncKernel]
  -- the `L¹` mass of `ψ`
  have hS : (∫⁻ y : ℝ, w y) ≤ ENNReal.ofReal A := by
    have heq : (∫⁻ y : ℝ, w y) = ∫⁻ y : ℝ, ENNReal.ofReal |ψ y| := by
      refine lintegral_congr fun y => ?_
      rw [hw]
      simp only
      rw [← ofReal_norm, Real.norm_eq_abs]
    rw [heq]
    exact lintegral_ofReal_abs_le_of_integrable hint hA
  calc (∫⁻ x : ℝ, ‖brsTruncConvReal k ψ x‖ₑ ^ r)
      ≤ ∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * w y) ^ r :=
        lintegral_mono fun x => ENNReal.rpow_le_rpow (hpt x) hr0.le
    _ ≤ (∫⁻ y : ℝ, w y) ^ (r - 1) *
          ((∫⁻ y : ℝ, w y) * ∫⁻ u : ℝ, K u ^ r) :=
        lintegral_shift_mul_rpow_le hKm hwm hr
    _ ≤ ENNReal.ofReal A ^ (r - 1) *
          (ENNReal.ofReal A * ∫⁻ u : ℝ, K u ^ r) :=
        mul_le_mul' (ENNReal.rpow_le_rpow hS (by linarith))
          (mul_le_mul' hS le_rfl)
    _ = ENNReal.ofReal (A ^ r) * ∫⁻ u : ℝ, K u ^ r := by
        rw [← mul_assoc, ennreal_rpow_sub_one_mul ENNReal.ofReal_ne_top hr,
          ENNReal.ofReal_rpow_of_nonneg hAnn hr0.le]

/-- **The kernel of the lowest-frequency piece.** -/
theorem lintegral_enorm_brsTruncConvReal_dilate_le_L1 (k j : ℕ) {φ : ℝ → ℝ}
    (hφ : Continuous φ) (hcs : HasCompactSupport φ) {A : ℝ}
    (hA : (∫ y : ℝ, |φ y|) ≤ A) {r : ℝ} (hr : 1 ≤ r) (hr2 : r < 2) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k (brsDilate φ j) x‖ₑ ^ r) ≤
      ENNReal.ofReal (A ^ r *
        (((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2))) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hint : Integrable (brsDilate φ j) volume :=
    (continuous_brsDilate hφ j).integrable_of_hasCompactSupport
      (hasCompactSupport_brsDilate hcs j)
  have hA' : (∫ y : ℝ, |brsDilate φ j y|) ≤ A := by
    rw [integral_abs_brsDilate]
    exact hA
  refine le_trans (lintegral_enorm_brsTruncConvReal_le_L1 k
    (continuous_brsDilate hφ j) hint hA' hr) ?_
  rw [lintegral_brsTruncKernel_rpow k hr0 hr2]
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hAnn r)]


/-! ## The derivative of the lowest-frequency piece

Differentiating a dilate costs a factor `2^j`, which is exactly cancelled by
the factor `δ = 2^{-j}` multiplying the derivative term in the localized
maximal estimate. -/

/-- The `L¹` norm of the derivative of a dilate. -/
theorem integral_abs_deriv_brsDilate {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (j : ℕ) :
    (∫ y : ℝ, |deriv (brsDilate φ j) y|) =
      (2 : ℝ) ^ j * ∫ y : ℝ, |deriv φ y| := by
  rw [deriv_brsDilate_eq hφ j, integral_abs_brsDilate]
  have habs : ∀ y : ℝ, |(2 : ℝ) ^ j * deriv φ y| = (2 : ℝ) ^ j * |deriv φ y| := by
    intro y
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ j)]
  simp only [habs]
  exact integral_const_mul _ _

/-- **The kernel of the derivative of the lowest-frequency piece.** -/
theorem lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 (k j : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφ' : Continuous (deriv φ))
    (hcs : HasCompactSupport (deriv φ))
    {A' : ℝ} (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A') {r : ℝ} (hr : 1 ≤ r)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) x‖ₑ ^ r) ≤
      ENNReal.ofReal (((2 : ℝ) ^ j * A') ^ r *
        (((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2))) := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hdcont : Continuous (deriv φ) := hφ'
  have hdilcs : HasCompactSupport (deriv (brsDilate φ j)) := by
    rw [deriv_brsDilate_eq hφ j]
    exact hasCompactSupport_brsDilate (hcs.mul_left) j
  have hdilcont : Continuous (deriv (brsDilate φ j)) := by
    rw [deriv_brsDilate_eq hφ j]
    exact continuous_brsDilate (continuous_const.mul hdcont) j
  have hint : Integrable (deriv (brsDilate φ j)) volume :=
    hdilcont.integrable_of_hasCompactSupport hdilcs
  have hAle : (∫ y : ℝ, |deriv (brsDilate φ j) y|) ≤ (2 : ℝ) ^ j * A' := by
    rw [integral_abs_deriv_brsDilate hφ j]
    exact mul_le_mul_of_nonneg_left hA' h2j.le
  refine le_trans (lintegral_enorm_brsTruncConvReal_le_L1 k hdilcont hint hAle
    hr) ?_
  rw [lintegral_brsTruncKernel_rpow k hr0 hr2]
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) r)]


/-! ## (5.9) for the lowest-frequency piece

The constant carrying the truncation scale. -/

/-- The `L^r` norm of `h_k`, to the `r`-th power. -/
def brsLowConst (k : ℕ) (r : ℝ) : ℝ :=
  ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) / (1 - r / 2)

theorem brsLowConst_nonneg (k : ℕ) {r : ℝ} (hr2 : r < 2) :
    0 ≤ brsLowConst k r := by
  rw [brsLowConst]
  have h1 : (0 : ℝ) ≤ ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - r / 2) :=
    Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
  have h2 : (0 : ℝ) < 1 - r / 2 := by linarith
  positivity

/-- **(5.9) for the lowest-frequency piece of the resolution.** -/
theorem brs_5_9_near_low {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : 0 ≤ brsLowConst kt r := brsLowConst_nonneg kt hr2
  have hCr : 0 ≤ brsLowConst kt r ^ (1 / r) := Real.rpow_nonneg hCnn _
  -- the smoothness hypotheses for the dilate
  have hdil : ContDiff ℝ 1 (brsDilate φ j) := contDiff_brsDilate hφ j
  have hdilcs : HasCompactSupport (brsDilate φ j) :=
    hasCompactSupport_brsDilate hcs j
  have hderiv : deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j := deriv_brsDilate_eq hφ j
  have hdercs : HasCompactSupport (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact hasCompactSupport_brsDilate hcs'.mul_left j
  have hdercd : ContDiff ℝ 1 (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact contDiff_brsDilate (contDiff_const.mul hφ') j
  -- the two kernel bounds
  have hker : (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_dilate_le_L1 kt j hφ.continuous hcs hA
        hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst, Real.mul_rpow (Real.rpow_nonneg hAnn r) (by positivity),
      ← Real.rpow_mul hAnn, mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  have hker' : (∫⁻ y : ℝ,
      ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 kt j hφ
        hφ'.continuous hcs' hA' hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst,
      Real.mul_rpow (Real.rpow_nonneg (by positivity) r) (by positivity),
      ← Real.rpow_mul (by positivity), mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  refine le_trans (lintegral_brsNearMax_rpow_le hδ hcov kw kt hdilcs hdil hdercs
    hdercd hg hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le))
  calc (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
              (1 / r) * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p))
      ≤ ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) +
          ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) *
              (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) :=
        add_le_add (mul_le_mul' hker le_rfl)
          (mul_le_mul' le_rfl (mul_le_mul' hker' le_rfl))
    _ = ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← add_mul,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        rw [rpow_neg_natCast_two j]
        field_simp


/-! ## The kernel bracket of (5.9), on its own

The two kernel norms entering the localized maximal estimate are the same
whichever maximal function they are fed into, so the bracket is isolated here
and used both for `𝒜_{k,m}` and for the reflected pieces. -/

/-- **The kernel bracket of (5.9).** -/
theorem brs_5_9_bracket {k j : ℕ} {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {r : ℝ} (hr : 1 < r)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(k : ℝ))) (G : ENNReal) :
    (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
            (1 / r) * G) ≤
      ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r)) *
        ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) * G := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  set δ : ℝ := (2 : ℝ) ^ (-(j : ℝ)) with hδdef
  have hδ : (0 : ℝ) < δ := Real.rpow_pos_of_pos (by norm_num) _
  have hδinv : δ = ((2 : ℝ) ^ j)⁻¹ := rpow_neg_natCast_two j
  have hδ2j : δ * (2 : ℝ) ^ j = 1 := by
    rw [hδinv]
    field_simp
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hR2 : tsupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) ⊆
      Metric.closedBall 0 1 := by
    rw [tsupport_const_mul_eq (ne_of_gt h2j)]
    exact hR'
  have hCnn : 0 ≤ brsKernelConst Mu A N r := brsKernelConst_nonneg hMunn hAnn N hr.le
  have hC'nn : 0 ≤ brsKernelConst Mu' A' N r :=
    brsKernelConst_nonneg hMu'nn hA'nn N hr.le
  have hK : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ.continuous hcs hR
      hbd hA hAnn hmom hr.le hkj
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow hCnn hδ hr0]
  have hK' : (∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
      (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
        δ ^ (1 / r - 1 / 2)) := by
    have hbd2 : ∀ x : ℝ, |(2 : ℝ) ^ j * deriv υ x| ≤ (2 : ℝ) ^ j * Mu' := by
      intro x
      rw [abs_mul, abs_of_pos h2j]
      exact mul_le_mul_of_nonneg_left (hbd' x) h2j.le
    have hA2 : (∫ y : ℝ, |(2 : ℝ) ^ j * deriv υ y|) ≤ (2 : ℝ) ^ j * A' := by
      rw [integral_abs_const_mul h2j.le]
      exact mul_le_mul_of_nonneg_left hA' h2j.le
    have hmom2 : ∀ i : ℕ, i < N + 1 →
        (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) = 0 := by
      intro i hi
      have hre : (∫ y : ℝ, y ^ i * ((2 : ℝ) ^ j * deriv υ y)) =
          (2 : ℝ) ^ j * ∫ y : ℝ, y ^ i * deriv υ y := by
        rw [← integral_const_mul]
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        show y ^ i * ((2 : ℝ) ^ j * deriv υ y) =
          (2 : ℝ) ^ j * (y ^ i * deriv υ y)
        ring
      rw [hre, hmom' i hi, mul_zero]
    have hbase := lintegral_enorm_brsTruncConvReal_dilate_le hυ2.continuous hcs2
      hR2 hbd2 hA2 (by positivity) hmom2 hr.le hkj
    rw [hderivD]
    rw [brsKernelConst_smul h2j.le hMu'nn hA'nn N] at hbase
    refine le_trans (rpow_inv_of_le_ofReal (by positivity) hr0 hbase)
      (le_of_eq ?_)
    rw [kernel_scale_rpow (by positivity) hδ hr0]
    congr 2
    rw [Real.mul_rpow (Real.rpow_nonneg h2j.le _) hC'nn, ← Real.rpow_mul h2j.le,
      mul_one_div, div_self hr0.ne', Real.rpow_one]
  have hstep : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate υ j) y‖ₑ ^ r) ^ (1 / r) *
        G +
      ENNReal.ofReal δ *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
          (1 / r) * G) ≤
      ENNReal.ofReal (brsKernelConst Mu A N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G +
        ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
          δ ^ (1 / r - 1 / 2)) * G := by
    refine add_le_add (mul_le_mul' hK le_rfl) ?_
    calc ENNReal.ofReal δ *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate υ j)) y‖ₑ ^ r) ^
            (1 / r) * G)
        ≤ ENNReal.ofReal δ *
            (ENNReal.ofReal ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
              δ ^ (1 / r - 1 / 2)) * G) :=
          mul_le_mul' le_rfl (mul_le_mul' hK' le_rfl)
      _ = ENNReal.ofReal (brsKernelConst Mu' A' N r ^ (1 / r) *
            δ ^ (1 / r - 1 / 2)) * G := by
          rw [← mul_assoc, ← ENNReal.ofReal_mul hδ.le]
          congr 2
          calc δ * ((2 : ℝ) ^ j * brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2))
              = (δ * (2 : ℝ) ^ j) * (brsKernelConst Mu' A' N r ^ (1 / r) *
                δ ^ (1 / r - 1 / 2)) := by ring
            _ = brsKernelConst Mu' A' N r ^ (1 / r) * δ ^ (1 / r - 1 / 2) := by
                rw [hδ2j, one_mul]
  refine le_trans hstep (le_of_eq ?_)
  rw [← add_mul, ← ENNReal.ofReal_add (by positivity) (by positivity)]
  congr 2
  ring

/-- **(5.9) for the reflected pieces of the resolution.** -/
theorem brs_5_9_near {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ))) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  have hcsD : HasCompactSupport (brsDilate υ j) := hasCompactSupport_brsDilate hcs j
  have hυD : ContDiff ℝ 1 (brsDilate υ j) := contDiff_brsDilate hυ j
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hcsD' : HasCompactSupport (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact hasCompactSupport_brsDilate hcs2 j
  have hυD' : ContDiff ℝ 1 (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact contDiff_brsDilate hυ2 j
  refine le_trans (lintegral_brsNearMax_rpow_le hδ hcov kw kt hcsD hυD hcsD' hυD'
    hg hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl
    (ENNReal.rpow_le_rpow ?_ hq0.le))
  exact brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
    hmom' hr hkj _


/-! ## A smooth approximate identity supported in the unit ball

The resolution of the identity needs a single profile `φ` with `∫ φ = 1`
supported in `[-1, 1]`; its Littlewood--Paley pieces `Ψ_j = φ_{j+1} - φ_j` are
then dilates of the single mean-zero bump `Ψ_0`, which is what `brs_5_9_near`
takes as input. -/

/-- **A smooth unit-mass bump supported in the unit ball.** -/
theorem exists_brsUnitBump :
    ∃ φ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) φ ∧ HasCompactSupport φ ∧
      (∫ x : ℝ, φ x) = 1 ∧ ∀ x : ℝ, 1 < |x| → φ x = 0 := by
  let fb : ContDiffBump (0 : ℝ) := ⟨1 / 2, 1, by norm_num, by norm_num⟩
  refine ⟨fb.normed volume, fb.contDiff_normed, fb.hasCompactSupport_normed,
    fb.integral_normed, fun x hx => ?_⟩
  have hns : x ∉ Function.support (fb.normed volume) := by
    rw [ContDiffBump.support_normed_eq]
    simp only [Metric.mem_ball, Real.dist_eq, sub_zero, not_lt]
    exact hx.le
  exact Function.notMem_support.mp hns

/-- The Littlewood--Paley pieces of a profile are dilates of the lowest one. -/
theorem brsLPKernel_eq_dilate (φ : ℝ → ℝ) (j : ℕ) :
    brsLPKernel φ j = brsDilate (brsLPKernel φ 0) j := by
  funext x
  show (2 : ℝ) ^ (j + 1) * φ ((2 : ℝ) ^ (j + 1) * x) -
      (2 : ℝ) ^ j * φ ((2 : ℝ) ^ j * x) =
    (2 : ℝ) ^ j * ((2 : ℝ) ^ (0 + 1) * φ ((2 : ℝ) ^ (0 + 1) * ((2 : ℝ) ^ j * x)) -
      (2 : ℝ) ^ (0 : ℕ) * φ ((2 : ℝ) ^ (0 : ℕ) * ((2 : ℝ) ^ j * x)))
  have h1 : (2 : ℝ) ^ (0 + 1 : ℕ) * ((2 : ℝ) ^ j * x) = (2 : ℝ) ^ (j + 1) * x := by
    rw [pow_succ, pow_zero, one_mul, pow_succ]
    ring
  have h2 : (2 : ℝ) ^ (0 : ℕ) * ((2 : ℝ) ^ j * x) = (2 : ℝ) ^ j * x := by
    rw [pow_zero, one_mul]
  rw [h1, h2, pow_succ, pow_zero]
  ring

/-- The Littlewood--Paley bump of a unit-mass profile vanishes off the unit
ball. -/
theorem brsLPKernel_zero_vanishing {φ : ℝ → ℝ}
    (hzero : ∀ x : ℝ, 1 < |x| → φ x = 0) {x : ℝ} (hx : 1 < |x|) :
    brsLPKernel φ 0 x = 0 := by
  have h1 : brsDilate φ 1 x = 0 := by
    show (2 : ℝ) ^ (1 : ℕ) * φ ((2 : ℝ) ^ (1 : ℕ) * x) = 0
    have habs : (1 : ℝ) < |(2 : ℝ) ^ (1 : ℕ) * x| := by
      rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (2 : ℝ) ^ (1 : ℕ))]
      nlinarith [abs_nonneg x]
    rw [hzero _ habs, mul_zero]
  have h0 : brsDilate φ 0 x = 0 := by
    rw [brsDilate_zero]
    exact hzero x hx
  show brsDilate φ 1 x - brsDilate φ 0 x = 0
  rw [h1, h0, sub_zero]

/-- **The Littlewood--Paley bump of a unit-mass profile, packaged for
(5.9).** -/
theorem exists_brsLPBumpPackage {φ : ℝ → ℝ} (hsmooth : ContDiff ℝ (⊤ : ℕ∞) φ)
    (hcs : HasCompactSupport φ)
    (hzero : ∀ x : ℝ, 1 < |x| → φ x = 0) :
    ∃ Mu A Mu' A' : ℝ,
      ContDiff ℝ 1 (brsLPKernel φ 0) ∧ HasCompactSupport (brsLPKernel φ 0) ∧
        tsupport (brsLPKernel φ 0) ⊆ Metric.closedBall 0 1 ∧
        ContDiff ℝ 1 (deriv (brsLPKernel φ 0)) ∧
        HasCompactSupport (deriv (brsLPKernel φ 0)) ∧
        tsupport (deriv (brsLPKernel φ 0)) ⊆ Metric.closedBall 0 1 ∧
        (∀ x : ℝ, |brsLPKernel φ 0 x| ≤ Mu) ∧
        (∫ y : ℝ, |brsLPKernel φ 0 y|) ≤ A ∧ 0 ≤ A ∧
        (∀ x : ℝ, |deriv (brsLPKernel φ 0) x| ≤ Mu') ∧
        (∫ y : ℝ, |deriv (brsLPKernel φ 0) y|) ≤ A' ∧ 0 ≤ A' ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * brsLPKernel φ 0 y) = 0) ∧
        ∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * deriv (brsLPKernel φ 0) y) = 0 := by
  set υ : ℝ → ℝ := brsLPKernel φ 0 with hυdef
  have hcd1 : ContDiff ℝ 1 φ := hsmooth.of_le ENat.LEInfty.out
  have hcd2 : ContDiff ℝ 2 φ := hsmooth.of_le ENat.LEInfty.out
  have hcont : Continuous φ := hcd1.continuous
  have hυcd : ContDiff ℝ 1 υ :=
    (contDiff_brsDilate hcd1 1).sub (contDiff_brsDilate hcd1 0)
  have hυcd2 : ContDiff ℝ 2 υ :=
    (contDiff_brsDilate hcd2 1).sub (contDiff_brsDilate hcd2 0)
  have hυcs : HasCompactSupport υ := hasCompactSupport_brsLPKernel hcs 0
  have hυcont : Continuous υ := hυcd.continuous
  have hυvan : ∀ x : ℝ, 1 < |x| → υ x = 0 := fun x hx =>
    brsLPKernel_zero_vanishing hzero hx
  have hυR : tsupport υ ⊆ Metric.closedBall 0 1 :=
    tsupport_subset_closedBall_of_vanishing hυvan
  have hderivcd : ContDiff ℝ 1 (deriv υ) := by
    have h : ContDiff ℝ (1 + 1) υ := by
      rw [show ((1 : WithTop ℕ∞) + 1) = 2 by norm_num]
      exact hυcd2
    exact (contDiff_succ_iff_deriv.mp h).2.2
  have hderivcs : HasCompactSupport (deriv υ) := hυcs.deriv
  have hderivvan : ∀ x : ℝ, 1 < |x| → deriv υ x = 0 := fun x hx =>
    deriv_eq_zero_of_vanishing hυvan hx
  have hderivR : tsupport (deriv υ) ⊆ Metric.closedBall 0 1 :=
    tsupport_subset_closedBall_of_vanishing hderivvan
  obtain ⟨Mu, hMu⟩ := hυcont.bounded_above_of_compact_support hυcs
  obtain ⟨Mu', hMu'⟩ := hderivcd.continuous.bounded_above_of_compact_support
    hderivcs
  refine ⟨Mu, ∫ y : ℝ, |υ y|, Mu', ∫ y : ℝ, |deriv υ y|, hυcd, hυcs, hυR,
    hderivcd, hderivcs, hderivR, fun x => by
      simpa only [Real.norm_eq_abs] using hMu x, le_rfl,
    integral_nonneg fun y => abs_nonneg _, fun x => by
      simpa only [Real.norm_eq_abs] using hMu' x, le_rfl,
    integral_nonneg fun y => abs_nonneg _, ?_, ?_⟩
  · intro i hi
    have hi0 : i = 0 := by omega
    subst hi0
    simp only [pow_zero, one_mul]
    exact integral_brsLPKernel_eq_zero hcont hcs 0
  · intro i hi
    have hi0 : i = 0 := by omega
    subst hi0
    simp only [pow_zero, one_mul]
    exact integral_deriv_eq_zero_of_hasCompactSupport hυcd hυcs


/-! ## The near part on its window

On `I_k = (2^{-k-1}, 2^{-k}]` the cutoff has to be at most the radius, so the
truncation is taken at `2^{-k-1}`, one dyadic scale finer than the window. -/

theorem brsCut_le_of_mem_window {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) :
    (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr

/-- **The near part on `I_k`, decomposed into the pieces of the
resolution.** -/
theorem brsANearWindow_le_tsum (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_window hr
    have hmain := brsANearLeftAt_le_pieces (k + 1) s (E := E) hg hgbd hφ hφcs
      hφnorm hcr
    refine le_trans hmain ?_
    have hpieces : brsNearPieceMax (k + 1) (brsDilate φ (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r ≤
        brsNearFullMax (k + 1) (brsDilate φ (k + 1 + s)) g E r +
          ∑' m : ℕ,
            brsNearFullMax (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r :=
      add_le_add (brsNearPieceMax_le_full _ _ _ _ _)
        (ENNReal.tsum_le_tsum fun m => brsNearPieceMax_le_full _ _ _ _ _)
    refine le_trans (mul_le_mul' le_rfl hpieces) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le


/-! ## Measurability of the reflected maximal functions -/

theorem measurable_brsNearFullMax (kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) :
    Measurable (brsNearFullMax kt Ψ g E) := by
  have hgr : Continuous (brsRefl g) := continuous_brsRefl hg
  have hFcont : Continuous fun x : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl g (x - y) := by
    have hderiv := fun x : ℝ => hasDerivAt_kernel_convolution
      (hasCompactSupport_brsTruncConvReal kt hcs)
      (contDiff_brsTruncConvReal kt (n := 1) hΨ hcs) hgr x
    have hdiff : Differentiable ℝ fun x : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl g (x - y) :=
      fun x => (hderiv x).differentiableAt
    exact hdiff.continuous
  exact measurable_iSup_enorm_translate (continuous_brsRefl hFcont) E

theorem measurable_brsNearMax (kw kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) :
    Measurable (brsNearMax kw kt Ψ g E) := by
  refine Measurable.indicator ?_ (measurableSet_brsWindowExt kw)
  refine Measurable.mul ?_ (measurable_brsNearFullMax kt hΨ hcs hg E)
  fun_prop

theorem brsNearMax_eq_zero_of_notMem {kw kt : ℕ} {Ψ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} {r : ℝ} (hr : r ∉ brsWindowExt kw) :
    brsNearMax kw kt Ψ g E r = 0 := by
  rw [brsNearMax, Set.indicator_of_notMem hr]


/-! ## The family of pieces indexed by `(m, k)`

`m = 0` is the lowest-frequency piece of the resolution, `m + 1` is the
Littlewood--Paley piece at scale `2^{-(k+1+s+m)}`.  Every member vanishes off
its window `I_k`, so the generic aggregation applies. -/

/-- Splitting off the first term of a sum in `ℝ≥0∞`. -/
theorem ennreal_tsum_eq_zero_add (f : ℕ → ENNReal) :
    ∑' n : ℕ, f n = f 0 + ∑' n : ℕ, f (n + 1) :=
  tsum_eq_zero_add' ENNReal.summable

/-- The `(m, k)`-family of pieces of the near part. -/
def brsNearFamily (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (m k : ℕ)
    (r : ℝ) : ENNReal :=
  match m with
  | 0 => brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r
  | (m + 1) => brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r

theorem brsNearFamily_zero (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (k : ℕ)
    (r : ℝ) : brsNearFamily s φ g E 0 k r =
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) g E r := rfl

theorem brsNearFamily_succ (s : ℕ) (φ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (m k : ℕ) (r : ℝ) : brsNearFamily s φ g E (m + 1) k r =
      brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m)) g E r := rfl

theorem brsNearFamily_eq_zero_of_notMem {s : ℕ} {φ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} (m k : ℕ) {r : ℝ} (hr : r ∉ brsWindowExt k) :
    brsNearFamily s φ g E m k r = 0 := by
  cases m with
  | zero => exact brsNearMax_eq_zero_of_notMem hr
  | succ m => exact brsNearMax_eq_zero_of_notMem hr

theorem measurable_brsNearFamily (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ)
    (m k : ℕ) : Measurable (brsNearFamily s φ g E m k) := by
  cases m with
  | zero =>
      exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hcs _) hg E
  | succ m =>
      refine measurable_brsNearMax k (k + 1) ?_
        (hasCompactSupport_brsLPKernel hcs _) hg E
      exact (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)

/-- **The near part on `I_k`, bounded by the family.** -/
theorem brsANearWindow_le_tsum_family (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      ∑' m : ℕ, brsNearFamily s φ g E m k r := by
  refine le_trans (brsANearWindow_le_tsum k s hg hgbd hφ hφcs hφnorm r)
    (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add (fun m : ℕ => brsNearFamily s φ g E m k r),
    brsNearFamily_zero]
  congr 1


/-! ## The near part, aggregated over all the windows -/

/-- **The near part of `R₂^-`, reduced to the individual pieces.** -/
theorem brsNear_aggregate (s : ℕ) {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ}
    (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearFamily s φ g E m k r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hpt : ∀ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily s φ g E m k r := by
    intro r
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearWindow_le_tsum_family k s hg hgbd hφ.continuous hφcs hφnorm r) ?_
    exact le_of_eq ENNReal.tsum_comm
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow (hpt r) hq0.le) le_rfl)
    (by positivity)) ?_
  exact window_double_sum_le
    (fun m k r hr => brsNearFamily_eq_zero_of_notMem m k hr)
    (fun m k => measurable_brsNearFamily s hφ hφcs hg E m k) hq


/-! ## (5.9) for the reflected pieces, with covering numbers -/

/-- **(5.9) for the reflected pieces, with the covering number.** -/
theorem brs_5_9_near_covering {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ)
    (hcs : HasCompactSupport υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ))) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-(j : ℝ)))
  have h := brs_5_9_near (kw := kw) (kt := kt) hcov hυ hcs hR hυ' hcs' hR' hbd
    hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel hkj
  rwa [hcard] at h

/-- **(5.9) for the lowest-frequency piece, with the covering number.** -/
theorem brs_5_9_near_low_covering {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-(j : ℝ)))
  have h := brs_5_9_near_low (kw := kw) (kt := kt) hcov hφ hcs hφ' hcs' hA hA'
    hg hp hr hrq hpq hrel hr2
  rwa [hcard] at h


/-! ## One term of the sum, with the offset left free

The near part uses the offset `a = m + 4` rather than `m + 3`, so the term
estimate is restated with the offset as a parameter. -/

/-- **Collecting the dyadic factors of one term, with a free offset.** -/
theorem brs_term_exponent_identity_gen (K₁ Cβ Cs β s q : ℝ) (k a : ℕ) :
    K₁ * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) *
        (Cβ * (2 : ℝ) ^ (β * ((k + a : ℕ) : ℝ))) *
        (Cs * ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ (s * q)) =
      (K₁ * Cβ * Cs) *
        (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) + brsSumExpM β s q * (a : ℝ)) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hjcast : ((k + a : ℕ) : ℝ) = (k : ℝ) + (a : ℝ) := by push_cast; ring
  have e1 : ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2) =
      (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) := by
    rw [← Real.rpow_mul h2.le]
  have e2 : ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ (s * q) =
      (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)) := by
    rw [← Real.rpow_mul h2.le, hjcast]
  have e3 : (2 : ℝ) ^ (β * ((k + a : ℕ) : ℝ)) =
      (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) := by rw [hjcast]
  rw [e1, e2, e3]
  have hcomb : (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
      (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) *
      (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)) =
      (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (a : ℝ)) := by
    rw [← Real.rpow_add h2, ← Real.rpow_add h2]
    congr 1
    rw [brsSumExpK, brsSumExpM]
    ring
  calc K₁ * (2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
        (Cβ * (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ)))) *
        (Cs * (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q)))
      = K₁ * Cβ * Cs *
          ((2 : ℝ) ^ (-(k : ℝ) * (1 - q / 2)) *
            (2 : ℝ) ^ (β * ((k : ℝ) + (a : ℝ))) *
            (2 : ℝ) ^ (-((k : ℝ) + (a : ℝ)) * (s * q))) := by ring
    _ = K₁ * Cβ * Cs *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ)) := by rw [hcomb]

/-- **A single term, with a free offset, is a dyadic geometric term.** -/
theorem brs_term_le_gen {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {Cs : ℝ} (hCs : 0 ≤ Cs) {q s : ℝ} (hq : 0 < q) (k a : ℕ) (G : ENNReal) :
    ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal (Cs *
              ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ s) * G) ^ q) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ))) * G ^ q := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  set j : ℕ := k + a with hj
  have hdyad : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos h2 _
  have hpow : (ENNReal.ofReal (Cs * ((2 : ℝ) ^ (-(j : ℝ))) ^ s) * G) ^ q =
      ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le]
    congr 2
    rw [Real.mul_rpow hCs (Real.rpow_nonneg hdyad.le _),
      ← Real.rpow_mul hdyad.le]
  rw [hpow]
  have hstep : ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
          (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) *
            G ^ q)) :=
    mul_le_mul' le_rfl (mul_le_mul' (hN j) le_rfl)
  refine le_trans hstep (le_of_eq ?_)
  rw [show ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
        ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
      (ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        (ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q)) * G ^ q)) =
      (ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) *
        ENNReal.ofReal (Cs ^ q * ((2 : ℝ) ^ (-(j : ℝ))) ^ (s * q))) * G ^ q by
    ring]
  congr 1
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [hj]
  exact brs_term_exponent_identity_gen ((2 : ℝ) ^ |1 - q / 2|) Cβ (Cs ^ q) β s q
    k a


/-! ## Putting the low-frequency constant in the dyadic form -/

/-- The `L^r` norm of `h_k` in the dyadic form used by the summation. -/
theorem brsLowConst_rpow_inv (kt : ℕ) {r : ℝ} (hr0 : 0 < r) (hr2 : r < 2) :
    brsLowConst kt r ^ (1 / r) =
      (1 - r / 2) ^ (-(1 / r)) * ((2 : ℝ) ^ (-(kt : ℝ))) ^ (1 / r - 1 / 2) := by
  have hden : (0 : ℝ) < 1 - r / 2 := by linarith
  have hbase : (0 : ℝ) < (2 : ℝ) ^ (-(kt : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [brsLowConst, Real.div_rpow (Real.rpow_nonneg hbase.le _) hden.le,
    ← Real.rpow_mul hbase.le]
  rw [Real.rpow_neg hden.le, div_eq_mul_inv, mul_comm]
  congr 2
  field_simp

/-- Shifting the dyadic scale by three costs a constant. -/
theorem dyadic_shift_three_rpow (k : ℕ) (s : ℝ) :
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s =
      (2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  rw [← Real.rpow_mul h2.le, ← Real.rpow_mul h2.le, ← Real.rpow_add h2]
  congr 1
  push_cast
  ring

/-- **A single term, with the constant given only by an upper bound.** -/
theorem brs_term_le_gen' {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {Cs D : ℝ} (hCs : 0 ≤ Cs) {q s : ℝ} (hq : 0 < q) (k a : ℕ) (G : ENNReal)
    (hD : D ≤ Cs * ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) ^ s) :
    ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ((intervalCoveringNumber E ((2 : ℝ) ^ (-((k + a : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal D * G) ^ q) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
            brsSumExpM β s q * (a : ℝ))) * G ^ q := by
  refine le_trans (mul_le_mul' le_rfl (mul_le_mul' le_rfl
    (ENNReal.rpow_le_rpow (mul_le_mul' (ENNReal.ofReal_le_ofReal hD) le_rfl)
      hq.le))) ?_
  exact brs_term_le_gen hCβ hN hCs hq k a G

/-- Decreasing dyadic factors: a larger offset gives a smaller term. -/
theorem rpow_mono_of_neg_exp {b : ℝ} (hb : b < 0) {m n : ℝ} (hmn : m ≤ n) :
    (2 : ℝ) ^ (b * n) ≤ (2 : ℝ) ^ (b * m) := by
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  nlinarith


/-! ## The lowest-frequency term of the near part, in geometric form -/

/-- Replacing the offset by a smaller one only increases the term. -/
theorem ofReal_geometric_offset_le {C b eK : ℝ} (hC : 0 ≤ C) (hb : b < 0)
    {m n : ℝ} (hmn : m ≤ n) :
    ENNReal.ofReal (C * (2 : ℝ) ^ (eK + b * n)) ≤
      ENNReal.ofReal (C * (2 : ℝ) ^ (eK + b * m)) := by
  refine ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left ?_ hC)
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  nlinarith

/-- **The `m = 0` term of the near part.** -/
theorem brsNearFamily_zero_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (A + A') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E 0 k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * ((0 : ℕ) : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  have hk4 : k + 1 + 3 = k + 4 := by omega
  have hterm : (fun x : ℝ => brsNearFamily 3 φ g E 0 k x) =
      fun x : ℝ => brsNearMax k (k + 1) (brsDilate φ (k + 4)) g E x := by
    funext x
    rw [brsNearFamily_zero, hk4]
  simp only [hterm]
  refine le_trans (brs_5_9_near_low_covering (kw := k) (kt := k + 1)
    (j := k + 4) hE hφ hcs hφ' hcs' hA hA' hg hp hr hrq hpq hrel hr2) ?_
  -- put the constant in dyadic form
  have hD : (A + A') * brsLowConst (k + 1) r ^ (1 / r) ≤
      Cs * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by
    have h1 : brsLowConst (k + 1) r ^ (1 / r) =
        (1 - r / 2) ^ (-(1 / r)) * ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s :=
      brsLowConst_rpow_inv (k + 1) hr0 hr2
    have h2 : ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) ^ s =
        (2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
      dyadic_shift_three_rpow k s
    have hbase : (0 : ℝ) ≤ ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
      Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
    rw [h1, h2]
    calc (A + A') * ((1 - r / 2) ^ (-(1 / r)) *
          ((2 : ℝ) ^ (3 * s) * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s))
        = ((A + A') * ((1 - r / 2) ^ (-(1 / r)) * (2 : ℝ) ^ (3 * s))) *
            ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s := by ring
      _ ≤ Cs * ((2 : ℝ) ^ (-((k + 4 : ℕ) : ℝ))) ^ s :=
          mul_le_mul_of_nonneg_right hCslow hbase
  refine le_trans (brs_term_le_gen' hCβ hN hCs hq0 k 4 G hD) ?_
  refine mul_le_mul' ?_ le_rfl
  have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine ofReal_geometric_offset_le hnn hM ?_
  push_cast
  norm_num


/-! ## The high-frequency terms of the near part, in geometric form -/

/-- **The `m + 1` terms of the near part.** -/
theorem brsNearFamily_succ_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (m k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E (m + 1) k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * ((m + 1 : ℕ) : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  have hidx : k + 1 + 3 + m = k + (m + 4) := by omega
  have hterm : (fun x : ℝ => brsNearFamily 3 φ g E (m + 1) k x) =
      fun x : ℝ => brsNearMax k (k + 1) (brsDilate υ (k + (m + 4))) g E x := by
    funext x
    rw [brsNearFamily_succ, hidx, hυeq]
  simp only [hterm]
  have hkj : 5 * (2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap (k + 1) m
    have heq : (k + 1) + (m + 3) = k + (m + 4) := by omega
    rwa [heq] at h
  refine le_trans (brs_5_9_near_covering (kw := k) (kt := k + 1)
    (j := k + (m + 4)) hE hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn
    hmom hmom' hg hp hr hrq hpq hrel hkj) ?_
  have hbase : (0 : ℝ) ≤ ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s :=
    Real.rpow_nonneg (Real.rpow_pos_of_pos (by norm_num) _).le _
  have hD : (brsKernelConst Mu A N r ^ (1 / r) +
        brsKernelConst Mu' A' N r ^ (1 / r)) *
      ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s ≤
      Cs * ((2 : ℝ) ^ (-((k + (m + 4) : ℕ) : ℝ))) ^ s :=
    mul_le_mul_of_nonneg_right hCsLP hbase
  refine le_trans (brs_term_le_gen' hCβ hN hCs hq0 k (m + 4) G hD) ?_
  refine mul_le_mul' ?_ le_rfl
  have hnn : (0 : ℝ) ≤ (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q := by
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine ofReal_geometric_offset_le hnn hM ?_
  push_cast
  linarith


/-! ## Every term of the near part is a dyadic geometric term -/

/-- **Every term of the near part.** -/
theorem brsNearFamily_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) (n k : ℕ) :
    (∫⁻ x : ℝ, brsNearFamily 3 φ g E n k x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) *
          (2 : ℝ) ^ (brsSumExpK β (1 / r - 1 / 2) q * (k : ℝ) +
            brsSumExpM β (1 / r - 1 / 2) q * (n : ℝ))) *
        ((∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  cases n with
  | zero =>
      exact brsNearFamily_zero_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hg
        hp hr hrq hpq hrel hr2 hCs hCslow hM k
  | succ m =>
      exact brsNearFamily_succ_term_le hE hCβ hN hυeq hυ hcs hR hυ' hcs' hR'
        hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel hCs hCsLP
        hM m k

/-- **The near part of `R₂^-` on the interior of the type region.** -/
theorem brs_near_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    (∫⁻ x : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ^ q *
        ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal ((((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
            (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
          (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q))) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  set c : ℝ := (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine le_trans (brsNear_aggregate 3 hg hgbd hφ hφcs hφnorm hq1) ?_
  refine le_trans (ENNReal.tsum_le_tsum fun n =>
    ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k =>
      brsNearFamily_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hυeq hυ hcs hR
        hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq
        hrel hr2 hCs hCslow hCsLP hM n k) (by positivity)) ?_
  have hsum : ∀ n : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ))) * G ^ q) ^ (1 / q) =
      (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ)))) ^ (1 / q) * G := by
    intro n
    rw [ENNReal.tsum_mul_right, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]
  rw [tsum_congr hsum, ENNReal.tsum_mul_right,
    tsum_tsum_ofReal_geometric_rpow hcnn hK hM hq0]


/-! ## The extended windows cover the whole range of radii -/

/-- Every radius in `(0, 4/3]` lies in one of the extended windows. -/
theorem exists_mem_brsWindowExt {r : ℝ} (hr0 : 0 < r) (hr : r ≤ 4 / 3) :
    ∃ k : ℕ, r ∈ brsWindowExt k := by
  rcases lt_or_ge (2 : ℝ)⁻¹ r with hhalf | hhalf
  · exact ⟨0, ⟨hhalf, hr⟩⟩
  -- `r ≤ 1/2`: find the dyadic index
  have hP0 : r ≤ (2 : ℝ) ^ (-((0 : ℕ) : ℝ)) := by
    norm_num
    linarith
  have hP1 : r ≤ (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have hcast : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by norm_num
    rw [hcast]
    exact hhalf
  have hex : ∃ n : ℕ, ¬ (r ≤ (2 : ℝ) ^ (-(n : ℝ))) := by
    obtain ⟨N, hN⟩ := exists_nat_gt (1 / r)
    refine ⟨N, ?_⟩
    have h2N : (0 : ℝ) < (2 : ℝ) ^ N := by positivity
    have hNle : (N : ℝ) ≤ (2 : ℝ) ^ N := by
      have := Nat.lt_two_pow_self (n := N)
      have hcast : ((N : ℕ) : ℝ) ≤ ((2 ^ N : ℕ) : ℝ) := by
        exact_mod_cast this.le
      simpa using hcast
    have hlt : 1 / r < (2 : ℝ) ^ N := lt_of_lt_of_le hN hNle
    have hinv : ((2 : ℝ) ^ N)⁻¹ < r := by
      rw [inv_lt_comm₀ h2N hr0]
      rwa [one_div] at hlt
    rw [rpow_neg_natCast_two N]
    exact not_le.mpr hinv
  classical
  have hne0 : Nat.find hex ≠ 0 := by
    intro hc
    refine Nat.find_spec hex ?_
    rw [hc]
    exact hP0
  have hne1 : Nat.find hex ≠ 1 := by
    intro hc
    refine Nat.find_spec hex ?_
    rw [hc]
    exact hP1
  obtain ⟨k, hk1, hPk, hnotk⟩ : ∃ k : ℕ, 1 ≤ k ∧ r ≤ (2 : ℝ) ^ (-(k : ℝ)) ∧
      ¬ (r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) := by
    refine ⟨Nat.find hex - 1, by omega, ?_, ?_⟩
    · exact not_not.mp (Nat.find_min hex (m := Nat.find hex - 1) (by omega))
    · have hsucc : Nat.find hex - 1 + 1 = Nat.find hex := by omega
      rw [hsucc]
      exact Nat.find_spec hex
  refine ⟨k, ?_⟩
  obtain ⟨k', rfl⟩ : ∃ k' : ℕ, k = k' + 1 := ⟨k - 1, by omega⟩
  rw [brsWindowExt_succ]
  refine ⟨?_, hPk⟩
  have hcast : (2 : ℝ) ^ (-((k' + 1 : ℕ) : ℝ) - 1) =
      (2 : ℝ) ^ (-((k' + 1 + 1 : ℕ) : ℝ)) := by
    congr 1
    push_cast
    ring
  rw [hcast]
  exact lt_of_not_ge hnotk

/-- `R_2^-` vanishes beyond `4/3`. -/
theorem brsRemTwoTwoLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsRemTwoTwoLeft E g r = 0 := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **(5.5), summed over the windows.** -/
theorem brsRemTwoTwoLeft_le_window_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr0 : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) +
        ∑' k : ℕ, (brsWindowExt k).indicator
          (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r := by
  rcases lt_or_ge (4 / 3 : ℝ) r with hbig | hsmall
  · rw [brsRemTwoTwoLeft_eq_zero hE hbig]
    exact zero_le
  obtain ⟨k, hk⟩ := exists_mem_brsWindowExt hr0 hsmall
  refine le_trans (brsRemTwoTwoLeft_le_add_at
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) hg hr0.le) ?_
  refine add_le_add ?_ ?_
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]


/-- **The pointwise bound for the far part, at an arbitrary cutoff.** -/
theorem brsBFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarLeftAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  set W : Set ℝ := Ioc a t ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : a < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by
      have : t / 3 ≤ a := by
        rw [ha]
        linarith
      linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + c)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor



/-! ## The far part, summed over the extended windows -/

theorem brsBFarLeftAt_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {c : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsBFarLeftAt c E g r = 0 := by
  rw [brsBFarLeftAt]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- A sum of window-supported terms is bounded by any common bound. -/
theorem tsum_window_indicator_le {A : ℕ → ℝ → ENNReal} {B : ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∈ brsWindowExt k → A k r ≤ B r) (r : ℝ) :
    (∑' k : ℕ, (brsWindowExt k).indicator (A k) r) ≤ B r := by
  by_cases h : ∃ k : ℕ, r ∈ brsWindowExt k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ →
        (brsWindowExt k).indicator (A k) r = 0 := by
      intro k hk
      refine Set.indicator_of_notMem (fun hr => ?_) _
      exact Set.disjoint_left.mp (brsWindowExt_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero, Set.indicator_of_mem hk₀]
    exact hA k₀ r hk₀
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, (brsWindowExt k).indicator (A k) r = 0 := fun k =>
      Set.indicator_of_notMem (h k) _
    simp only [hall, tsum_zero]
    exact zero_le

/-- On every extended window the cut scale is at most the truncation. -/
theorem brsCutScale_le_of_mem_windowExt {k : ℕ} {r : ℝ}
    (hr : r ∈ brsWindowExt k) :
    brsCutScale r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
  cases k with
  | zero =>
      have h2 : r ≤ 4 / 3 := hr.2
      have hcast : (2 : ℝ) ^ (-((0 + 1 : ℕ) : ℝ)) = (2 : ℝ)⁻¹ := by norm_num
      rw [hcast, brsCutScale]
      linarith
  | succ k =>
      have h2 : r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := hr.2
      have hpos : (0 : ℝ) < (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) :=
        Real.rpow_pos_of_pos (by norm_num) _
      have hhalf : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
          (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) / 2 := by
        have hsplit : (2 : ℝ) ^ (-((k + 1 + 1 : ℕ) : ℝ)) =
            (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) * (2 : ℝ) ^ (-(1 : ℝ)) := by
          rw [← Real.rpow_add (by norm_num)]
          congr 1
          push_cast
          ring
        rw [hsplit,
          show (-(1 : ℝ)) = ((-1 : ℤ) : ℝ) by norm_num, Real.rpow_intCast]
        norm_num
        ring
      rw [hhalf, brsCutScale]
      linarith

/-- The far part, summed over the extended windows. -/
def brsFarWindowSum (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∑' k : ℕ, (brsWindowExt k).indicator
    (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r

theorem brsFarWindowSum_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsFarWindowSum E g r = 0 := by
  rw [brsFarWindowSum]
  have hall : ∀ k : ℕ, (brsWindowExt k).indicator
      (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r = 0 := by
    intro k
    by_cases hk : r ∈ brsWindowExt k
    · rw [Set.indicator_of_mem hk, brsBFarLeftAt_eq_zero hE hr]
    · rw [Set.indicator_of_notMem hk]
  simp only [hall, tsum_zero]

/-- **The pointwise bound for the far part, summed over the windows.** -/
theorem brsFarWindowSum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSum E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSum]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarLeftAt_le hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')


/-! ## The far part against the unweighted `L^p` norm

The near part is estimated by Young's inequality, which produces the plain
`L^p` norm of the profile; the far part is restated against the same norm so
that the two halves of (5.5) can be added. -/

/-- **The pointwise bound for the far part, at an arbitrary cutoff.** -/
theorem brsBFarLeftAt_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarLeftAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  set W : Set ℝ := Ioc a t ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + c)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    refine le_trans (setLIntegral_le_lintegral _ _) ?_
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by norm_num)
    calc M = 1 * M := (one_mul M).symm
      _ ≤ ENNReal.ofReal 3 * M := mul_le_mul' h3 le_rfl
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + c)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + c)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor




/-- **The pointwise bound for the far part, summed over the windows.** -/
theorem brsFarWindowSum_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSum E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSum]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarLeftAt_le' hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')

/-- **(5.6) for the far part summed over the windows, unweighted.** -/
theorem prop56_brsBFarWindow' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSum E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsFarWindowSum_le' hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsFarWindowSum E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsFarWindowSum E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsFarWindowSum_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp



/-! ## The near estimate for the measurable majorant

The maximal functions themselves are indexed by a set depending on the radius,
so they are not obviously measurable; the family of pieces that dominates them
is, and that is what the additivity of the integral is applied to. -/

/-- **The family form of the near estimate.** -/
theorem brs_near_interior_family {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (_hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (_hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    (∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
          brsNearFamily 3 φ g E m k x) ^ q * ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal ((((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
            (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
          (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q))) *
        (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := 1 / r - 1 / 2 with hsdef
  set G : ENNReal := (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) with hG
  set c : ℝ := (2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q with hc
  have hcnn : 0 ≤ c := by
    rw [hc]
    have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
      Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
    positivity
  refine le_trans (window_double_sum_le
    (fun m k r hr => brsNearFamily_eq_zero_of_notMem m k hr)
    (fun m k => measurable_brsNearFamily 3 hφ hφcs hg E m k) hq1) ?_
  refine le_trans (ENNReal.tsum_le_tsum fun n =>
    ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum fun k =>
      brsNearFamily_term_le hE hCβ hN hφ hφcs hφd hφdcs hAφ hAφ' hυeq hυ hcs hR
        hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq
        hrel hr2 hCs hCslow hCsLP hM n k) (by positivity)) ?_
  have hsum : ∀ n : ℕ, (∑' k : ℕ,
      ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ))) * G ^ q) ^ (1 / q) =
      (∑' k : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (brsSumExpK β s q * (k : ℝ) +
        brsSumExpM β s q * (n : ℝ)))) ^ (1 / q) * G := by
    intro n
    rw [ENNReal.tsum_mul_right, ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ← ENNReal.rpow_mul, show q * (1 / q) = 1 by field_simp, ENNReal.rpow_one]
  rw [tsum_congr hsum, ENNReal.tsum_mul_right,
    tsum_tsum_ofReal_geometric_rpow hcnn hK hM hq0]



/-! ## Proposition 5.4(i) for `R₂^-`

Adding the two halves of (5.5).  The elementary convexity inequality
`(a + b)^q ≤ 2^{q-1}(a^q + b^q)` is used in place of Minkowski's inequality so
that no measurability of the maximal functions themselves is needed: only the
measurable majorants are integrated. -/

/-- The pointwise splitting of `R₂^-` into two measurable majorants. -/
theorem brsRemTwoTwoLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x * brsFarWindowSum E g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hsplit := brsRemTwoTwoLeft_le_window_sum hE hg hx
  have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
      (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x := by
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearWindow_le_tsum_family k 3 hg hgbd hφ hφcs hφnorm x) ?_
    exact le_of_eq ENNReal.tsum_comm
  have hle : brsRemTwoTwoLeft E g x ≤
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) +
        brsFarWindowSum E g x :=
    le_trans hsplit (add_le_add hnear le_rfl)
  have hpow : brsRemTwoTwoLeft E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q +
          brsFarWindowSum E g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q +
            brsFarWindowSum E g x ^ q)) := mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x * brsFarWindowSum E g x ^ q) := by ring


/-! ## Adding the two halves of (5.5) -/

/-- **Adding two majorants.** -/
theorem lintegral_rpow_le_of_two_bounds {R Nm Fw : ℝ → ENNReal} {q : ℝ}
    (hq : 1 ≤ q)
    (hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x * Nm x ^ q)
    (hpt : ∀ x : ℝ, ENNReal.ofReal x * R x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Nm x ^ q) +
        (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Fw x ^ q))
    {CN CF : ℝ} (hCN : 0 ≤ CN) (hCF : 0 ≤ CF) {G : ENNReal}
    (hNb : (∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * G)
    (hFb : (∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CF * G) :
    (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((2 : ℝ) ^ ((q - 1) / q) * (CN + CF)) * G := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hq1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  set X : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q with hX
  set Y : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q with hY
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hint : (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_add_left' (hNmeas.const_mul ((2 : ENNReal) ^ (q - 1))).aemeasurable]
    rw [lintegral_const_mul' _ _ htop, lintegral_const_mul' _ _ htop]
  refine le_trans (ENNReal.rpow_le_rpow hint (by positivity)) ?_
  have hsub : ((2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y) ^
      (1 / q) ≤ ((2 : ENNReal) ^ (q - 1) * X) ^ (1 / q) +
        ((2 : ENNReal) ^ (q - 1) * Y) ^ (1 / q) :=
    ENNReal.rpow_add_le_add_rpow _ _ (by positivity) hq1
  refine le_trans hsub ?_
  have hfac : ∀ Z : ENNReal, ((2 : ENNReal) ^ (q - 1) * Z) ^ (1 / q) =
      (2 : ENNReal) ^ ((q - 1) / q) * Z ^ (1 / q) := by
    intro Z
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul]
    congr 2
    field_simp
  rw [hfac, hfac]
  have hmain : (2 : ENNReal) ^ ((q - 1) / q) * X ^ (1 / q) +
      (2 : ENNReal) ^ ((q - 1) / q) * Y ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) *
        (ENNReal.ofReal CN * G + ENNReal.ofReal CF * G) := by
    rw [mul_add]
    exact add_le_add (mul_le_mul' le_rfl hNb) (mul_le_mul' le_rfl hFb)
  refine le_trans hmain (le_of_eq ?_)
  have hpow : (2 : ENNReal) ^ ((q - 1) / q) =
      ENNReal.ofReal ((2 : ℝ) ^ ((q - 1) / q)) := by
    rw [← ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
    norm_num
  rw [hpow, ← add_mul, ← ENNReal.ofReal_add hCN hCF, ← mul_assoc,
    ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]


/-! ## Proposition 5.4(i) for `R₂^-` -/

/-- **Proposition 5.4(i) of BRS, for `R₂^-`.**  On the interior of the type
region — where both dyadic exponents are negative — `R₂^-` maps the profile
`L^p` norm to the radial `L^q(r dr)` norm. -/
theorem prop54_brsRemTwoTwoLeft_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨CF, hCFpos, hFbound⟩ := prop56_brsBFarWindow' hE hp1 hq0 hq2p
  have hFb := hFbound g hg.measurable
  -- the near constant
  set CN : ℝ := (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
      (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
    (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q)) with hCNdef
  have hKden : (0 : ℝ) < 1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q := by
    have h : (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < 1 :=
      calc (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hK
        _ = 1 := Real.rpow_zero 2
    linarith
  have hMden : (0 : ℝ) <
      1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) := by
    have hneg : brsSumExpM β (1 / r - 1 / 2) q / q < 0 :=
      div_neg_of_neg_of_pos hM hq0
    have h : (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < 1 :=
      calc (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hneg
        _ = 1 := Real.rpow_zero 2
    linarith
  have hCNnn : 0 ≤ CN := by
    rw [hCNdef]
    have hnum : (0 : ℝ) ≤ (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
        (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) := by
      refine Real.rpow_nonneg ?_ _
      have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
        Real.rpow_pos_of_pos (by norm_num) _
      have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
      positivity
    positivity
  have hNb0 := brs_near_interior_family hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp hr hrq hpq hrel hr2 hCs hCslow hCsLP hK hM
  have hswap : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) =
      ∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
        brsNearFamily 3 φ g E m k x) ^ q * ENNReal.ofReal x :=
    lintegral_congr fun x => mul_comm _ _
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    rw [hswap]
    exact hNb0
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ g E m k x) ^ q := by
    refine ENNReal.measurable_ofReal.mul (Measurable.pow_const ?_ q)
    exact Measurable.ennreal_tsum fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsNearFamily 3 hφ hφcs hg E m k
  refine ⟨(2 : ℝ) ^ ((q - 1) / q) * (CN + CF), by positivity, ?_⟩
  exact lintegral_rpow_le_of_two_bounds hq1 hNmeas
    (fun x => brsRemTwoTwoLeft_rpow_le hE hφ.continuous hφcs hφnorm hg hgbd hq1 x)
    hCNnn hCFpos.le hNb hFb


/-! ## `R_2^+` at an arbitrary cutoff

The right half of (5.5), with the cutoff left free, exactly as on the left. -/

/-- `𝒜` for `R_2^+`, with an arbitrary cutoff. -/
def brsANearRightAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Ioi (t + r - c)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ` for `R_2^+`, with an arbitrary cutoff. -/
def brsBFarRightAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Iic (t + r - c)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5), right half, with an arbitrary cutoff.** -/
theorem brsRemTwoTwoRight_le_add_at (c : ℝ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoRight E g r ≤
      brsANearRightAt c E g r + brsBFarRightAt c E g r := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  set F : ℝ → ℂ := fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume t b :=
    intervalIntegrable_absWeightRight_complex hg hab
  have hnear : IntervalIntegrable
      ((Ioi (b - c)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Ioi, hfull.2.indicator measurableSet_Ioi⟩
  have hfar : IntervalIntegrable
      ((Iic (b - c)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Iic, hfull.2.indicator measurableSet_Iic⟩
  have hsplit : ∀ s : ℝ, F s = (Ioi (b - c)).indicator F s +
      (Iic (b - c)).indicator F s := by
    intro s
    by_cases hs : b - c < s
    · rw [Set.indicator_of_mem (show s ∈ Ioi (b - c) from hs),
        Set.indicator_of_notMem
          (show s ∉ Iic (b - c) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (b - c) from hs),
        Set.indicator_of_mem
          (show s ∈ Iic (b - c) from not_lt.mp hs)]
      ring
  have hint : (∫ s in t..b, F s) =
      (∫ s in t..b, (Ioi (b - c)).indicator F s) +
        ∫ s in t..b, (Iic (b - c)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in t..b, F s‖ ≤
      ‖∫ s in t..b, (Ioi (b - c)).indicator F s‖ +
        ‖∫ s in t..b, (Iic (b - c)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in t..b, (Ioi (b - c)).indicator F s‖ +
            ‖∫ s in t..b, (Iic (b - c)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in t..b, (Ioi (b - c)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in t..b, (Iic (b - c)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearRightAt c E g r + brsBFarRightAt c E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearRightAt]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarRightAt]
          exact le_iSup₂_of_le t ht le_rfl


/-- The far part of `R_2^+` vanishes for large radii, at any cutoff. -/
theorem brsBFarRightAt_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {c : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsBFarRightAt c E g r = 0 := by
  rw [brsBFarRightAt]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **The pointwise bound for the far part of `R_2^+`, arbitrary cutoff.** -/
theorem brsBFarRightAt_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarRightAt c E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rw [brsBFarRightAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc t b ∩ Iic (b - c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in t..b,
      (Iic (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc t b, ‖(Iic (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc t b
      · by_cases h2 : s ≤ b - c
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Iic (b - c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - c := hs.2
    have habs : |b - s| = b - s := abs_of_nonneg (by linarith)
    have hle : |b - s| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc, hb]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    refine le_trans (setLIntegral_le_lintegral _ _) ?_
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by norm_num)
    calc M = 1 * M := (one_mul M).symm
      _ ≤ ENNReal.ofReal 3 * M := mul_le_mul' h3 le_rfl
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b,
        (Iic (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..b, (Iic (b - c)).indicator
            (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor


/-! ## The far part of `R_2^+`, summed over the extended windows -/

/-- The far part of `R_2^+`, summed over the extended windows. -/
def brsFarWindowSumRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∑' k : ℕ, (brsWindowExt k).indicator
    (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r

theorem brsFarWindowSumRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) :
    brsFarWindowSumRight E g r = 0 := by
  rw [brsFarWindowSumRight]
  have hall : ∀ k : ℕ, (brsWindowExt k).indicator
      (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r = 0 := by
    intro k
    by_cases hk : r ∈ brsWindowExt k
    · rw [Set.indicator_of_mem hk, brsBFarRightAt_eq_zero hE hr]
    · rw [Set.indicator_of_notMem hk]
  simp only [hall, tsum_zero]

/-- **The pointwise bound for the far part of `R_2^+`, over the windows.** -/
theorem brsFarWindowSumRight_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (_hr : 0 < r) :
    brsFarWindowSumRight E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  rw [brsFarWindowSumRight]
  refine tsum_window_indicator_le
    (A := fun k => brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g)
    (B := fun r => ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
      r ^ (-(1 / p) : ℝ)) * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p))
    (fun k r' hr' => ?_) r
  exact brsBFarRightAt_le' hE hp hg (brsWindowExt_pos hr')
    (brsCutScale_le_of_mem_windowExt hr')

/-- **(5.6) for the far part of `R_2^+` summed over the windows.** -/
theorem prop56_brsBFarWindowRight' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsFarWindowSumRight_le' hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsFarWindowSumRight E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsFarWindowSumRight_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp



/-! ## The near part of `R_2^+` as a convolution

Translating `u = b - s` turns the right-endpoint near part into an integral
against the truncated kernel, exactly as `u = s - a` does on the left. -/

theorem integral_nearPartRight_eq_conv {c a b : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} (_hg : Continuous g) :
    (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) := by
    have h := intervalIntegral.integral_comp_sub_left
      (a := (0 : ℝ)) (b := b - a) (d := b)
      (f := fun s : ℝ => (Ioi (b - c)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Ioi (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show b - u ∈ Ioi (b - c) by
        simp only [mem_Ioi]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      congr 2
      rw [show b - (b - u) = u by ring, abs_of_pos hupos]
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show b - u ∉ Ioi (b - c) by
        simp only [mem_Ioi, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Ioi (b - c)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) * g (b - u) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp


/-! ## The resolution of one smoothed value

The decomposition of a single value of the smoothed near part into the pieces
of the resolution of the identity; both halves of (5.5) use it. -/

/-- **One value, decomposed into the pieces.** -/
theorem enorm_brsRefl_conv_le_pieces (k s : ℕ) {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) (a : ℝ) :
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (z - y)) a‖ₑ ≤
      ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
            brsRefl g (z - y)) a‖ₑ +
        ∑' m : ℕ, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
            brsRefl g (z - y)) a‖ₑ := by
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  set x : ℝ := -a with hx
  have hres := brs_resolution_truncConv k s hφ hφcs hφnorm hgrefl hgreflbd x
  have hlow : (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq k (continuous_brsDilate hφ (k + s))
      (hasCompactSupport_brsDilate hφcs (k + s)) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel φ (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl g (x - y) := fun m =>
    brs_piece_eq k (continuous_brsLPKernel hφ (k + s + m))
      (hasCompactSupport_brsLPKernel hφcs (k + s + m)) hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres

/-! ## The near part of `R_2^+`, in the reflected form -/

/-- **The near part of `R_2^+`, identified.**  Reflecting about `3/2` sends
`E ⊆ [1,2]` to itself and turns the right-endpoint near part into the same
convolution that appears on the left. -/
theorem brsANearRightAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hcr : c ≤ r) :
    brsANearRightAt c E g r =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ t ∈ E ∩ Ici (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r)‖ₑ := by
  have hidentify : ∀ t : ℝ,
      (∫ s in t..(t + r), (Ioi (t + r - c)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r) := by
    intro t
    rw [integral_nearPartRight_eq_conv hc (by linarith) hg]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t + r - u)) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (fun w : ℝ => g (3 - w)) (-(3 - t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t + r - u) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (fun w : ℝ => g (3 - w)) (-(3 - t - r) - u)
    rw [brsRefl_apply]
    congr 2
    ring
  have hpt : ∀ t : ℝ,
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
          (Ioi (t + r - c)).indicator
            (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (fun w : ℝ => g (3 - w)) (z - y)) (3 - t - r)‖ₑ := by
    intro t
    have hrnn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith) _
    rw [ENNReal.ofReal_mul hrnn, ofReal_norm, hidentify t]
  rw [brsANearRightAt]
  rw [iSup_congr fun t => iSup_congr fun _ => hpt t]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## The near part of `R_2^+`, decomposed -/

/-- Reflecting about `3/2` preserves `[1, 2]`. -/
theorem image_three_sub_subset_Icc {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    (fun x : ℝ => 3 - x) '' E ⊆ Icc (1 : ℝ) 2 := by
  rintro y ⟨t, htE, rfl⟩
  obtain ⟨h1, h2⟩ := hE htE
  exact ⟨by linarith, by linarith⟩

/-- **The near part of `R_2^+`, decomposed into the pieces.** -/
theorem brsANearRightAt_le_pieces (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearRightAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearFullMax k (brsDilate φ (k + s)) (fun w : ℝ => g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r +
          ∑' m : ℕ, brsNearFullMax k (brsLPKernel φ (k + s + m))
            (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  rw [brsANearRightAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine iSup₂_le fun t ht => ?_
  have hmem : (3 - t) ∈ (fun x : ℝ => 3 - x) '' E := ⟨t, ht.1, rfl⟩
  refine le_trans (enorm_brsRefl_conv_le_pieces k s hgt hgtbd hφ hφcs hφnorm
    (3 - t - r)) ?_
  refine add_le_add (le_iSup₂_of_le (3 - t) hmem le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le (3 - t) hmem le_rfl

/-- **The near part of `R_2^+` on `I_k`, decomposed.** -/
theorem brsANearRightWindow_le_tsum (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate φ (k + 1 + s)) (fun w : ℝ => g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsLPKernel φ (k + 1 + s + m))
          (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr
    refine le_trans (brsANearRightAt_le_pieces (k + 1) s hg hgbd hφ hφcs hφnorm
      hcr) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **The near part of `R_2^+` on `I_k`, bounded by the family.** -/
theorem brsANearRightWindow_le_tsum_family (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      ∑' m : ℕ, brsNearFamily s φ (fun w : ℝ => g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) m k r := by
  refine le_trans (brsANearRightWindow_le_tsum k s hg hgbd hφ hφcs hφnorm r)
    (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add (fun m : ℕ => brsNearFamily s φ
    (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) m k r),
    brsNearFamily_zero]
  congr 1


/-! ## Proposition 5.4(i) for `R₂^+` -/

/-- `R_2^+` vanishes beyond `4/3`. -/
theorem brsRemTwoTwoRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 4 / 3 < r) : brsRemTwoTwoRight E g r = 0 := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- **(5.5) for `R₂^+`, summed over the windows.** -/
theorem brsRemTwoTwoRight_le_window_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr0 : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) +
        ∑' k : ℕ, (brsWindowExt k).indicator
          (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r := by
  rcases lt_or_ge (4 / 3 : ℝ) r with hbig | hsmall
  · rw [brsRemTwoTwoRight_eq_zero hE hbig]
    exact zero_le
  obtain ⟨k, hk⟩ := exists_mem_brsWindowExt hr0 hsmall
  refine le_trans (brsRemTwoTwoRight_le_add_at
    ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) hg hr0.le) ?_
  refine add_le_add ?_ ?_
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]
  · refine le_trans (le_of_eq ?_) (ENNReal.le_tsum k)
    rw [Set.indicator_of_mem hk]

/-- The pointwise splitting of `R₂^+` into two measurable majorants. -/
theorem brsRemTwoTwoRight_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
              ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x * brsFarWindowSumRight E g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hsplit := brsRemTwoTwoRight_le_window_sum hE hg hx
  have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
      (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) x) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
        ((fun y : ℝ => 3 - y) '' E) m k x := by
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearRightWindow_le_tsum_family k 3 hg hgbd hφ hφcs hφnorm x) ?_
    exact le_of_eq ENNReal.tsum_comm
  have hle : brsRemTwoTwoRight E g x ≤
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
          ((fun y : ℝ => 3 - y) '' E) m k x) +
        brsFarWindowSumRight E g x :=
    le_trans hsplit (add_le_add hnear le_rfl)
  have hpow : brsRemTwoTwoRight E g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
            ((fun y : ℝ => 3 - y) '' E) m k x) ^ q +
          brsFarWindowSumRight E g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          ((∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
              ((fun y : ℝ => 3 - y) '' E) m k x) ^ q +
            brsFarWindowSumRight E g x ^ q)) := mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w))
                ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x * brsFarWindowSumRight E g x ^ q) := by ring


/-! ## Proposition 5.4(i) for `R₂^+` -/

/-- Reflecting the profile about `3/2` does not change its `L^p` norm. -/
theorem lintegral_enorm_comp_three_sub (g : ℝ → ℂ) (p : ℝ) :
    (∫⁻ z : ℝ, ‖g (3 - z)‖ₑ ^ p) = ∫⁻ z : ℝ, ‖g z‖ₑ ^ p :=
  lintegral_sub_left_eq_self (fun z => ‖g z‖ₑ ^ p) 3

/-- **Proposition 5.4(i) of BRS, for `R₂^+`.**  The reflection `x ↦ 3 - x`
preserves `[1, 2]` and turns the right-endpoint operator into the left-endpoint
one for the reflected profile. -/
theorem prop54_brsRemTwoTwoRight_interior {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφd : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    {Cs : ℝ} (hCs : 0 ≤ Cs)
    (hCslow : (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
      (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs)
    (hCsLP : brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) ≤ Cs)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨CF, hCFpos, hFbound⟩ := prop56_brsBFarWindowRight' hE hp1 hq0 hq2p
  have hFb := hFbound g hg.measurable
  -- the near constant
  set CN : ℝ := (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
      (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) /
    (1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q)) with hCNdef
  have hKden : (0 : ℝ) < 1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q := by
    have h : (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < 1 :=
      calc (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hK
        _ = 1 := Real.rpow_zero 2
    linarith
  have hMden : (0 : ℝ) <
      1 - (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) := by
    have hneg : brsSumExpM β (1 / r - 1 / 2) q / q < 0 :=
      div_neg_of_neg_of_pos hM hq0
    have h : (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < 1 :=
      calc (2 : ℝ) ^ (brsSumExpM β (1 / r - 1 / 2) q / q) < (2 : ℝ) ^ (0 : ℝ) :=
            Real.rpow_lt_rpow_of_exponent_lt (by norm_num) hneg
        _ = 1 := Real.rpow_zero 2
    linarith
  have hCNnn : 0 ≤ CN := by
    rw [hCNdef]
    have hnum : (0 : ℝ) ≤ (((2 : ℝ) ^ |1 - q / 2| * Cβ * Cs ^ q) /
        (1 - (2 : ℝ) ^ brsSumExpK β (1 / r - 1 / 2) q)) ^ (1 / q) := by
      refine Real.rpow_nonneg ?_ _
      have h1 : (0 : ℝ) < (2 : ℝ) ^ |1 - q / 2| :=
        Real.rpow_pos_of_pos (by norm_num) _
      have h2 : (0 : ℝ) ≤ Cs ^ q := Real.rpow_nonneg hCs _
      positivity
    positivity
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  have hNb0 := brs_near_interior_family (image_three_sub_subset_Icc hE) hCβ hN
    hφ hφcs hφnorm hφd hφdcs hAφ hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn
    hbd' hA' hA'nn hmom hmom' hgt hgtbd hp hr hrq hpq hrel hr2 hCs hCslow hCsLP
    hK hM
  rw [lintegral_enorm_comp_three_sub g p] at hNb0
  have hswap : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) =
      ∫⁻ x : ℝ, (∑' m : ℕ, ∑' k : ℕ,
        brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q * ENNReal.ofReal x :=
    lintegral_congr fun x => mul_comm _ _
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal CN * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
    rw [hswap]
    exact hNb0
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      (∑' m : ℕ, ∑' k : ℕ, brsNearFamily 3 φ (fun w : ℝ => g (3 - w)) ((fun y : ℝ => 3 - y) '' E) m k x) ^ q := by
    refine ENNReal.measurable_ofReal.mul (Measurable.pow_const ?_ q)
    exact Measurable.ennreal_tsum fun m => Measurable.ennreal_tsum fun k =>
      measurable_brsNearFamily 3 hφ hφcs hgt ((fun y : ℝ => 3 - y) '' E) m k
  refine ⟨(2 : ℝ) ^ ((q - 1) / q) * (CN + CF), by positivity, ?_⟩
  exact lintegral_rpow_le_of_two_bounds hq1 hNmeas
    (fun x => brsRemTwoTwoRight_rpow_le hE hφ.continuous hφcs hφnorm hg hgbd
      hq1 x)
    hCNnn hCFpos.le hNb hFb



/-! ## Proposition 5.4, with the bump data supplied

The resolution of the identity is an ingredient of the proof, not of the
statement, so it is discharged here once and for all. -/

/-- **The data needed to run the resolution of the identity.** -/
theorem exists_brsResolutionData {r : ℝ} (hr : 1 < r) (hr2 : r < 2) :
    ∃ (φ : ℝ → ℝ) (υ : ℝ → ℝ) (Aφ Aφ' Mu A Mu' A' Cs : ℝ),
      ContDiff ℝ 1 φ ∧ HasCompactSupport φ ∧ (∫ x : ℝ, φ x) = 1 ∧
        ContDiff ℝ 1 (deriv φ) ∧ HasCompactSupport (deriv φ) ∧
        (∫ y : ℝ, |φ y|) ≤ Aφ ∧ (∫ y : ℝ, |deriv φ y|) ≤ Aφ' ∧
        (∀ j : ℕ, brsLPKernel φ j = brsDilate υ j) ∧
        ContDiff ℝ 1 υ ∧ HasCompactSupport υ ∧
        tsupport υ ⊆ Metric.closedBall 0 1 ∧
        ContDiff ℝ 1 (deriv υ) ∧ HasCompactSupport (deriv υ) ∧
        tsupport (deriv υ) ⊆ Metric.closedBall 0 1 ∧
        (∀ x : ℝ, |υ x| ≤ Mu) ∧ (∫ y : ℝ, |υ y|) ≤ A ∧ 0 ≤ A ∧
        (∀ x : ℝ, |deriv υ x| ≤ Mu') ∧ (∫ y : ℝ, |deriv υ y|) ≤ A' ∧ 0 ≤ A' ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
        (∀ i : ℕ, i < 0 + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
        0 ≤ Cs ∧
        (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
          (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) ≤ Cs ∧
        brsKernelConst Mu A 0 r ^ (1 / r) +
          brsKernelConst Mu' A' 0 r ^ (1 / r) ≤ Cs := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hden : (0 : ℝ) < 1 - r / 2 := by linarith
  obtain ⟨φ, hsmooth, hcs, hmass, hzero⟩ := exists_brsUnitBump
  have hcd1 : ContDiff ℝ 1 φ := hsmooth.of_le ENat.LEInfty.out
  have hcd2 : ContDiff ℝ 2 φ := hsmooth.of_le ENat.LEInfty.out
  have hφd : ContDiff ℝ 1 (deriv φ) := by
    have h : ContDiff ℝ (1 + 1) φ := by
      rw [show ((1 : WithTop ℕ∞) + 1) = 2 by norm_num]
      exact hcd2
    exact (contDiff_succ_iff_deriv.mp h).2.2
  have hφdcs : HasCompactSupport (deriv φ) := hcs.deriv
  obtain ⟨Mu, A, Mu', A', hυcd, hυcs, hυR, hderivcd, hderivcs, hderivR, hbd,
    hA, hAnn, hbd', hA', hA'nn, hmom, hmom'⟩ :=
    exists_brsLPBumpPackage hsmooth hcs hzero
  set Aφ : ℝ := ∫ y : ℝ, |φ y| with hAφdef
  set Aφ' : ℝ := ∫ y : ℝ, |deriv φ y| with hAφ'def
  have hAφnn : 0 ≤ Aφ := integral_nonneg fun y => abs_nonneg _
  have hAφ'nn : 0 ≤ Aφ' := integral_nonneg fun y => abs_nonneg _
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  set Clow : ℝ := (Aφ + Aφ') * ((1 - r / 2) ^ (-(1 / r)) *
    (2 : ℝ) ^ (3 * (1 / r - 1 / 2))) with hClowdef
  set CLP : ℝ := brsKernelConst Mu A 0 r ^ (1 / r) +
    brsKernelConst Mu' A' 0 r ^ (1 / r) with hCLPdef
  have hClownn : 0 ≤ Clow := by
    rw [hClowdef]
    have h1 : (0 : ℝ) < (1 - r / 2) ^ (-(1 / r)) := Real.rpow_pos_of_pos hden _
    have h2 : (0 : ℝ) < (2 : ℝ) ^ (3 * (1 / r - 1 / 2)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  have hCLPnn : 0 ≤ CLP := by
    rw [hCLPdef]
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A 0 r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn 0 hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' 0 r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn 0 hr.le) _
    linarith
  exact ⟨φ, brsLPKernel φ 0, Aφ, Aφ', Mu, A, Mu', A', Clow + CLP, hcd1, hcs,
    hmass, hφd, hφdcs, le_rfl, le_rfl, brsLPKernel_eq_dilate φ, hυcd, hυcs,
    hυR, hderivcd, hderivcs, hderivR, hbd, hA, hAnn, hbd', hA', hA'nn, hmom,
    hmom', by linarith, by linarith, by linarith⟩


/-! ## Proposition 5.4 in terms of the exponents alone -/

/-- **Proposition 5.4 for `R₂^-`.**  Only the exponents and the covering
estimate for `E` enter; the resolution of the identity is internal. -/
theorem prop54_brsRemTwoTwoLeft_of_exponents {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨φ, υ, Aφ, Aφ', Mu, A, Mu', A', Cs, hφ, hφcs, hφnorm, hφd, hφdcs,
    hAφ, hAφ', hυeq, hυ, hcs, hR, hυ', hcs', hR', hbd, hA, hAnn, hbd', hA',
    hA'nn, hmom, hmom', hCs, hCslow, hCsLP⟩ := exists_brsResolutionData hr hr2
  exact prop54_brsRemTwoTwoLeft_interior hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp1 hr hrq hpq hrel hr2 hq2p hCs hCslow hCsLP hK hM

/-- **Proposition 5.4 for `R₂^+`.** -/
theorem prop54_brsRemTwoTwoRight_of_exponents {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q r : ℝ} (hp1 : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) (hq2p : q < 2 * p)
    (hK : brsSumExpK β (1 / r - 1 / 2) q < 0)
    (hM : brsSumExpM β (1 / r - 1 / 2) q < 0) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨φ, υ, Aφ, Aφ', Mu, A, Mu', A', Cs, hφ, hφcs, hφnorm, hφd, hφdcs,
    hAφ, hAφ', hυeq, hυ, hcs, hR, hυ', hcs', hR', hbd, hA, hAnn, hbd', hA',
    hA'nn, hmom, hmom', hCs, hCslow, hCsLP⟩ := exists_brsResolutionData hr hr2
  exact prop54_brsRemTwoTwoRight_interior hE hCβ hN hφ hφcs hφnorm hφd hφdcs hAφ
    hAφ' hυeq hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hg
    hgbd hp1 hr hrq hpq hrel hr2 hq2p hCs hCslow hCsLP hK hM


/-! ## Proposition 5.4 in terms of `p`, `q` and `β`

The intermediate exponent `r` is determined by `p` and `q`, and the two
summability conditions read `q/p < 2 - β` and `q/p < 1 + q/2 - β`.  This form
covers both parts of Proposition 5.4: nothing in the argument distinguishes
`q < 2` from `q ≥ 2`. -/

/-- The exponent data determined by `p` and `q`. -/
theorem brs_exponent_data {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) :
    ∃ r : ℝ, 1 < r ∧ r < q ∧ 1 / p + 1 / r = 1 + 1 / q ∧
      (1 / p - 1 / q < 1 / 2 → r < 2) ∧
      ∀ β : ℝ, brsSumExpK β (1 / r - 1 / 2) q = β - 2 + q / p ∧
        brsSumExpM β (1 / r - 1 / 2) q = β - 1 - q + q / p + q / 2 := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_trans hp0 hpq
  have hpne : p ≠ 0 := ne_of_gt hp0
  have hqne : q ≠ 0 := ne_of_gt hq0
  have hqp : 1 / q < 1 / p := one_div_lt_one_div_of_lt hp0 hpq
  have hp1' : 1 / p < 1 := by
    rw [div_lt_one hp0]
    exact hp1
  have hden : (0 : ℝ) < 1 + 1 / q - 1 / p := by
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  set r : ℝ := (1 + 1 / q - 1 / p)⁻¹ with hrdef
  have hrpos : (0 : ℝ) < r := by
    rw [hrdef]
    positivity
  have hrinv : 1 / r = 1 + 1 / q - 1 / p := by
    rw [hrdef]
    simp
  have hqinv : (0 : ℝ) < 1 / q := by positivity
  refine ⟨r, ?_, ?_, ?_, ?_, ?_⟩
  · refine (div_lt_one hrpos).mp ?_
    rw [hrinv]
    linarith
  · refine lt_of_one_div_lt_one_div hq0 ?_
    rw [hrinv]
    linarith
  · rw [hrinv]
    ring
  · intro hhalf
    refine lt_of_one_div_lt_one_div (by norm_num : (0 : ℝ) < 2) ?_
    rw [hrinv]
    linarith
  · intro β
    have hs : (1 / r - 1 / 2) * q = 1 + q - q / p - q / 2 := by
      rw [hrinv]
      field_simp
      ring
    refine ⟨?_, ?_⟩
    · rw [brsSumExpK, hs]
      ring
    · rw [brsSumExpM, hs]
      ring

/-- **Proposition 5.4 for `R₂^-`, in terms of `p`, `q` and `β`.** -/
theorem prop54_brsRemTwoTwoLeft_pq {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) (hq2p : q < 2 * p)
    (hhalf : 1 / p - 1 / q < 1 / 2) (hK : q / p < 2 - β)
    (hM : q / p < 1 + q / 2 - β) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨r, hr, hrq, hrel, hr2, hexp⟩ := brs_exponent_data hp1 hpq
  obtain ⟨hKeq, hMeq⟩ := hexp β
  refine prop54_brsRemTwoTwoLeft_of_exponents hE hCβ hN hg hgbd hp1 hr hrq hpq
    hrel (hr2 hhalf) hq2p ?_ ?_
  · rw [hKeq]
    linarith
  · rw [hMeq]
    linarith

/-- **Proposition 5.4 for `R₂^+`, in terms of `p`, `q` and `β`.** -/
theorem prop54_brsRemTwoTwoRight_pq {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {p q : ℝ} (hp1 : 1 < p) (hpq : p < q) (hq2p : q < 2 * p)
    (hhalf : 1 / p - 1 / q < 1 / 2) (hK : q / p < 2 - β)
    (hM : q / p < 1 + q / 2 - β) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨r, hr, hrq, hrel, hr2, hexp⟩ := brs_exponent_data hp1 hpq
  obtain ⟨hKeq, hMeq⟩ := hexp β
  refine prop54_brsRemTwoTwoRight_of_exponents hE hCβ hN hg hgbd hp1 hr hrq hpq
    hrel (hr2 hhalf) hq2p ?_ ?_
  · rw [hKeq]
    linarith
  · rw [hMeq]
    linarith



end Prop46
