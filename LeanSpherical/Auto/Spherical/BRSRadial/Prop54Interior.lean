/-! ## Reflection, and the maximal estimate for an abstract pair `(F, F')`

The near part of `R_2^-` is a convolution evaluated at `r - t` rather than at
`t - r`, so a reflection has to be absorbed somewhere.  Reflection preserves
every `L^q` norm, so it is cleanest to state the maximal estimate for an
abstract differentiable pair and apply it to the reflected function. -/

theorem lintegral_enorm_comp_neg (H : ℝ → ℂ) (q : ℝ) :
    (∫⁻ z : ℝ, ‖H (-z)‖ₑ ^ q) = ∫⁻ z : ℝ, ‖H z‖ₑ ^ q :=
  lintegral_neg_eq_self (fun z => ‖H z‖ₑ ^ q)

theorem hasDerivAt_comp_neg {F F' : ℝ → ℂ}
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) (z : ℝ) :
    HasDerivAt (fun w : ℝ => F (-w)) (-(F' (-z))) z := by
  have h2 := HasDerivAt.scomp z (hderiv (-z)) (hasDerivAt_neg z)
  have hval : (-1 : ℝ) • F' (-z) = -(F' (-z)) := by
    rw [neg_smul, one_smul]
  rw [hval] at h2
  exact h2

/-- **The localized maximal estimate for an abstract pair.** -/
theorem lintegral_iSup_translate_le_of_bounds {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q)
    {B B' : ENNReal} (hB : (∫⁻ z : ℝ, ‖F z‖ₑ ^ q) ^ (1 / q) ≤ B)
    (hB' : (∫⁻ z : ℝ, ‖F' z‖ₑ ^ q) ^ (1 / q) ≤ B') :
    (∫⁻ r : ℝ, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q) ≤
      (ι.card : ENNReal) * (B + ENNReal.ofReal δ * B') ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  refine le_trans (lintegral_iSup_enorm_translate_rpow_le hδ hcov hF hF' hderiv
    hq) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact add_le_add hB (mul_le_mul' le_rfl hB')


/-! ## The near part as a maximal function of a convolution

Putting `integral_nearPart_eq_conv` and the reflection together, the near part
of `R_2^-` is exactly the weight `r^{-1/2}` times the maximal function, over
`t ∈ E`, of the reflected convolution evaluated at `t - r`.  That is the shape
the localized maximal estimate expects. -/

/-- Reflection of a function. -/
def brsRefl (g : ℝ → ℂ) : ℝ → ℂ := fun z => g (-z)

theorem brsRefl_apply (g : ℝ → ℂ) (z : ℝ) : brsRefl g z = g (-z) := rfl

theorem continuous_brsRefl {g : ℝ → ℂ} (hg : Continuous g) :
    Continuous (brsRefl g) := hg.comp continuous_neg

/-- **The near part is a maximal function of a convolution.** -/
theorem brsANearLeftAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {r : ℝ} (hcr : c ≤ r) :
    brsANearLeftAt c E g r =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ t ∈ E ∩ Ici (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r)‖ₑ := by
  have hidentify : ∀ t : ℝ,
      (∫ s in (t - r)..t, (Iio (t - r + c)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (z - y)) (t - r) := by
    intro t
    rw [integral_nearPart_eq_conv hc (by linarith) hg]
    show (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t - r + u)) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) * brsRefl g (-(t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    show ((brsTruncKernelAt c u : ℝ) : ℂ) * g (t - r + u) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) * brsRefl g (-(t - r) - u)
    rw [brsRefl_apply]
    congr 2
    ring
  have hpt : ∀ t : ℝ,
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
          (Iio (t - r + c)).indicator
            (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
