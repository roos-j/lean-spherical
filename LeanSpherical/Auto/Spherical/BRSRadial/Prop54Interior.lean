    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Iio (t - r + c)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ` with an arbitrary cutoff. -/
def brsBFarLeftAt (c : ℝ) (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Ici (t - r + c)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

