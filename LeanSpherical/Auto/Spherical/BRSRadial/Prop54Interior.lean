    brsANearLeft E g r = brsANearLeftAt (brsCutScale r) E g r := rfl

theorem brsBFarLeft_eq_at (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsBFarLeft E g r = brsBFarLeftAt (brsCutScale r) E g r := rfl

