    have hhc : Continuous h := continuous_brsLocalize hg
    obtain ⟨Cg, hhbd⟩ : ∃ C : ℝ, ∀ z : ℝ, ‖h z‖ ≤ C := by
      obtain ⟨C, hC⟩ := exists_bound_brsLocalize hg
