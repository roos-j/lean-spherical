    (by linarith : p < 2 * p) hrel (le_refl (2 * p)) hA₀top hA₀ hgeom
  refine ⟨ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
    C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p))), ?_, fun g hg => ?_⟩
