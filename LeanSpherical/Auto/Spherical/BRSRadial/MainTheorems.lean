            (2 * p / p)) ≤
        A₀ * (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (2 * p / p)) :
    ∃ C : ENNReal, C ≠ ⊤ ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoRight E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
