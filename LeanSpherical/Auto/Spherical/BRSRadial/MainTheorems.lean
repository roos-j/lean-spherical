            ENNReal.ofReal r) ^ (1 / (2 * p)) +
          ((∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
                brsRemTwoCent (absProfile h) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
              ENNReal.ofReal r) ^ (1 / (2 * p)) +
