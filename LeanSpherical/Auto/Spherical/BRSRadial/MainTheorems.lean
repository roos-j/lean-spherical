    have hloc : (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ (2 * p)) =
        ∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E h x ^ (2 * p) := by
      refine lintegral_congr fun x => ?_
      rcases le_or_gt x 0 with hx | hx
