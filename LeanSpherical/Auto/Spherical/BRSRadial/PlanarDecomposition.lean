      _ ≤ Real.sqrt (‖x + t • ω‖ ^ 2) := Real.sqrt_le_sqrt hsqge
      _ = ‖x + t • ω‖ := Real.sqrt_sq hnn
  · have hsq1 : (t - a) ^ 2 ≤ (tL + δ / 10) ^ 2 := pow_le_pow_left₀ htapos.le hta' 2
    have hsq2 : (tL + δ / 10) ^ 2 + δ ≤ (tL + δ) ^ 2 := by nlinarith [htL, hδ]
    have hsqle : ‖x + t • ω‖ ^ 2 ≤ (tL + δ) ^ 2 := by
      linarith [hupper, hsq1, hsq2]
    calc ‖x + t • ω‖ = Real.sqrt (‖x + t • ω‖ ^ 2) := (Real.sqrt_sq hnn).symm
      _ ≤ Real.sqrt ((tL + δ) ^ 2) := Real.sqrt_le_sqrt hsqle
      _ = tL + δ := Real.sqrt_sq (by linarith)

/-- **(3.4) of BRS.**  At radii `|x| ≈ t - t_L` the spherical average of the
annulus test function is bounded below by the measure of a tangential cap of
chordal radius `√(δ/(|x| t))`. -/
theorem le_sphericalAverage_annulusTest {d : ℕ} (hd : 0 < d) :
    ∃ c : ℝ, 0 < c ∧ ∀ tL δ t : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ tL → tL ≤ 2 → 1 ≤ t →
      t ≤ 2 → ∀ x : Euclidean d, 4 * δ ≤ ‖x‖ * t →
        |t - ‖x‖ - tL| ≤ δ / 10 →
          ENNReal.ofReal (c * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1)) ≤
            ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
              (brsAnnulusTest d tL δ) x‖ := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  obtain ⟨c₀, hc₀pos, hc₀top, hcap⟩ := exists_stein_unitSurfaceMeasure_cap_ge_power n
  have hmass : 0 < surfaceMass (n + 1) := surfaceMass_pos (by omega)
  set c : ℝ := c₀.toReal / surfaceMass (n + 1) with hc
  have hc₀real : 0 < c₀.toReal := ENNReal.toReal_pos hc₀pos.ne' hc₀top
  have hcpos : 0 < c := by
    rw [hc]
    positivity
  refine ⟨c, hcpos, ?_⟩
  intro tL δ t hδ hδ1 htL htL2 ht1 ht2 x hδa hclose
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  have hxpos : 0 < ‖x‖ := by
    rcases lt_or_ge 0 ‖x‖ with h | h
    · exact h
    · exfalso
      have h0 : ‖x‖ = 0 := le_antisymm h (norm_nonneg _)
      rw [h0] at hδa
      simp only [zero_mul] at hδa
      linarith
  set a : ℝ := ‖x‖ with ha
  have hat : 0 < a * t := mul_pos hxpos htpos
  -- the cap radius
  set h : ℝ := Real.sqrt (δ / (a * t)) with hh
  have hhpos : 0 < h := by
    rw [hh]
    exact Real.sqrt_pos.mpr (div_pos hδ hat)
  have hhsq : h ^ 2 = δ / (a * t) := by
    rw [hh, Real.sq_sqrt (by positivity)]
  have hhhalf : h ≤ 1 / 2 := by
    have hle : δ / (a * t) ≤ 1 / 4 := by
      rw [div_le_div_iff₀ hat (by norm_num)]
      linarith
    have := Real.sqrt_le_sqrt hle
    rw [hh]
    refine le_trans this (le_of_eq ?_)
    rw [show (1 : ℝ) / 4 = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
  -- the inward cap
  set v : Euclidean (n + 1) := steinInwardRadialDirection x with hv
  have hvnorm : ‖v‖ = 1 := norm_steinInwardRadialDirection hxpos
  set A : Set (Metric.sphere (0 : Euclidean (n + 1)) 1) :=
    steinSphericalCap (n + 1) v h with hA
  have hAmeas : MeasurableSet A := measurableSet_steinSphericalCap _ _ _
  -- the annulus is hit by the whole cap
  have hone : ∀ ω ∈ A, (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ))
      ‖x + t • (ω : Euclidean (n + 1))‖ = 1 := by
    intro ω hω
    have hωnorm : ‖(ω : Euclidean (n + 1))‖ = 1 := mem_sphere_zero_iff_norm.mp ω.2
    have hdist : dist ((ω : Euclidean (n + 1))) v < h := hω
    exact Set.indicator_of_mem
      (mem_annulus_of_mem_inwardCap hδ hδ1 htL hxpos htpos hclose hωnorm hdist) _
  -- the average dominates the cap fraction
  have hgmeas : Measurable (fun y : Euclidean (n + 1) =>
      (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖) :=
    (measurable_const.indicator measurableSet_Icc).comp continuous_norm.measurable
  have hgb : ∀ y : Euclidean (n + 1),
      ‖(Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖‖ ≤ 1 := by
    intro y
    by_cases hmem : ‖y‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
      norm_num
  have hint := stein_integrable_sphere_comp_of_bounded_measurable hgmeas hgb t x
  have hnonneg : ∀ ω : Metric.sphere (0 : Euclidean (n + 1)) 1,
      0 ≤ (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ))
        ‖x + t • (ω : Euclidean (n + 1))‖ := by
    intro ω
    by_cases hmem : ‖x + t • (ω : Euclidean (n + 1))‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem]
  have hfrac := stein_cap_fraction_le_ennreal_norm_normalizedSphericalAverage
    (by omega : 0 < n + 1)
    (fun y : Euclidean (n + 1) =>
      (Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖)
    t x A hAmeas hint hnonneg hone
  have hcapbound := hcap v hvnorm h hhpos hhhalf
  -- the average agrees with the normalized one
  have hbridge : _root_.Spherical.sphericalAverage t (brsAnnulusTest (n + 1) tL δ) x =
      normalizedSphericalAverage (n + 1)
        (fun y : Euclidean (n + 1) =>
          (((Icc (tL - δ) (tL + δ)).indicator (fun _ => (1 : ℝ)) ‖y‖ : ℝ) : ℂ)) t x := by
    rw [_root_.Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
    congr 1
    funext y
    rw [brsAnnulusTest]
    by_cases hmem : ‖y‖ ∈ Icc (tL - δ) (tL + δ)
    · rw [Set.indicator_of_mem hmem, Set.indicator_of_mem hmem]
      norm_num
    · rw [Set.indicator_of_notMem hmem, Set.indicator_of_notMem hmem]
      norm_num
  rw [hbridge]
  have hstep1 : ENNReal.ofReal (c * h ^ (n + 1 - 1)) =
      c₀ * ENNReal.ofReal (h ^ n) / ENNReal.ofReal (surfaceMass (n + 1)) := by
    have hn : n + 1 - 1 = n := by omega
    rw [hn, hc, div_mul_eq_mul_div, ENNReal.ofReal_div_of_pos hmass,
      ENNReal.ofReal_mul (le_of_lt hc₀real), ENNReal.ofReal_toReal hc₀top]
  calc ENNReal.ofReal (c * h ^ (n + 1 - 1))
      = c₀ * ENNReal.ofReal (h ^ n) / ENNReal.ofReal (surfaceMass (n + 1)) := hstep1
    _ ≤ unitSurfaceMeasure (n + 1) A / ENNReal.ofReal (surfaceMass (n + 1)) :=
        ENNReal.div_le_div_right hcapbound _
    _ ≤ _ := hfrac

/-- An elementary lower bound for a difference of powers: the largest term of
the geometric factorization. -/
theorem mul_pow_le_pow_succ_sub_pow_succ {b c : ℝ} (hc : 0 ≤ c) (hcb : c ≤ b)
    (n : ℕ) : (b - c) * b ^ n ≤ b ^ (n + 1) - c ^ (n + 1) := by
  have hb : 0 ≤ b := le_trans hc hcb
  induction n with
  | zero => simp
  | succ k ih =>
    have hck : 0 ≤ c ^ (k + 1) := pow_nonneg hc _
    have hsplit : b ^ (k + 2) - c ^ (k + 2) =
        b * (b ^ (k + 1) - c ^ (k + 1)) + (b - c) * c ^ (k + 1) := by
      ring
    have hstep : b * ((b - c) * b ^ k) ≤ b * (b ^ (k + 1) - c ^ (k + 1)) :=
      mul_le_mul_of_nonneg_left ih hb
    have hpos : 0 ≤ (b - c) * c ^ (k + 1) :=
      mul_nonneg (by linarith) hck
    calc (b - c) * b ^ (k + 1) = b * ((b - c) * b ^ k) := by ring
      _ ≤ b * (b ^ (k + 1) - c ^ (k + 1)) := hstep
      _ ≤ b * (b ^ (k + 1) - c ^ (k + 1)) + (b - c) * c ^ (k + 1) := by linarith
      _ = b ^ (k + 2) - c ^ (k + 2) := hsplit.symm

/-- **The thin annulus at radius `a` has volume at least `δ a^{d-1}/5`.**  This
is the volume factor of the `ℭ_E(δ,J)` lower bound. -/
theorem volume_radialAnnulus_ge {d : ℕ} (hd : 0 < d) {a δ : ℝ} (hδ : 0 < δ)
    (hδa : δ / 10 ≤ a) :
    ENNReal.ofReal (δ / 5 * a ^ (d - 1)) *
        volume (Metric.ball (0 : Euclidean d) 1) ≤
      volume (radialAnnulusIcc d (a - δ / 10) (a + δ / 10)) := by
  obtain ⟨n, rfl⟩ : ∃ n, d = n + 1 := ⟨d - 1, by omega⟩
  have hlow : (0 : ℝ) ≤ a - δ / 10 := by linarith
  have hle : a - δ / 10 ≤ a + δ / 10 := by linarith
  rw [volume_radialAnnulusIcc hd hlow hle]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  have hkey := mul_pow_le_pow_succ_sub_pow_succ hlow hle n
  have hdiff : (a + δ / 10) - (a - δ / 10) = δ / 5 := by ring
  rw [hdiff] at hkey
  have hmono : a ^ n ≤ (a + δ / 10) ^ n := by
    refine pow_le_pow_left₀ (by linarith) (by linarith) n
  have hstep : δ / 5 * a ^ n ≤ δ / 5 * (a + δ / 10) ^ n :=
    mul_le_mul_of_nonneg_left hmono (by linarith)
  simp only [Nat.add_sub_cancel]
  linarith [hkey, hstep]

/-- The annuli attached to `δ`-separated radii are pairwise disjoint. -/
theorem radialAnnulus_disjoint_of_separated {d : ℕ} {δ a b : ℝ} (hδ : 0 < δ)
    (hsep : δ ≤ |a - b|) :
    Disjoint (radialAnnulusIcc d (a - δ / 10) (a + δ / 10))
      (radialAnnulusIcc d (b - δ / 10) (b + δ / 10)) := by
  refine Set.disjoint_left.mpr fun x hxa hxb => ?_
  have h1 : ‖x‖ ∈ Icc (a - δ / 10) (a + δ / 10) := hxa
  have h2 : ‖x‖ ∈ Icc (b - δ / 10) (b + δ / 10) := hxb
  have hab : |a - b| ≤ δ / 5 := by
    rw [abs_le]
    constructor
    · linarith [h1.1, h1.2, h2.1, h2.2]
    · linarith [h1.1, h1.2, h2.1, h2.2]
  linarith [hsep, hab]

/-- **The union of the separated annuli of Lemma 3.5 is large.** -/
theorem volume_biUnion_annuli_ge {d : ℕ} (hd : 0 < d) {δ L tL : ℝ} (hδ : 0 < δ)
    (hδL : 10 * δ ≤ L) (T : Finset ℝ)
    (hright : ∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L)
    (hsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) :
    ENNReal.ofReal ((T.card : ℝ) * (δ / 5 * (L / 2) ^ (d - 1))) *
        volume (Metric.ball (0 : Euclidean d) 1) ≤
      volume (⋃ t ∈ T, radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
  classical
  have hLpos : 0 < L := by linarith
  have hmeas : ∀ t ∈ T,
      MeasurableSet (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) :=
    fun t _ => measurableSet_radialAnnulusIcc d _ _
  have hdisj : (↑T : Set ℝ).PairwiseDisjoint
      (fun t => radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
    intro t ht s hs hts
    have hsepts : δ ≤ |t - s| := hsep t (by simpa using ht) s (by simpa using hs) hts
    have habs : |(t - tL) - (s - tL)| = |t - s| := by
      congr 1
      ring
    have := radialAnnulus_disjoint_of_separated (d := d) hδ
      (by rw [habs]; exact hsepts)
    exact this
  rw [measure_biUnion_finset hdisj hmeas]
  have hterm : ∀ t ∈ T,
      ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1) ≤
        volume (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) := by
    intro t ht
    obtain ⟨hlow, -⟩ := hright t ht
    have hat : δ / 10 ≤ t - tL := by linarith
    have hmono : (L / 2) ^ (d - 1) ≤ (t - tL) ^ (d - 1) := by
      refine pow_le_pow_left₀ (by linarith) (by linarith) _
    refine le_trans (mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl)
      (volume_radialAnnulus_ge hd hδ hat)
    have hδ5 : (0 : ℝ) ≤ δ / 5 := by linarith
    exact mul_le_mul_of_nonneg_left hmono hδ5
  calc ENNReal.ofReal ((T.card : ℝ) * (δ / 5 * (L / 2) ^ (d - 1))) *
        volume (Metric.ball (0 : Euclidean d) 1)
      = (T.card : ℕ) • (ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1)) := by
        rw [nsmul_eq_mul, ENNReal.ofReal_mul (Nat.cast_nonneg (T.card)),
          ENNReal.ofReal_natCast, mul_assoc]
    _ = ∑ _t ∈ T, ENNReal.ofReal (δ / 5 * (L / 2) ^ (d - 1)) *
          volume (Metric.ball (0 : Euclidean d) 1) := by
        rw [Finset.sum_const]
    _ ≤ ∑ t ∈ T, volume (radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10)) :=
        Finset.sum_le_sum hterm

/-- **(3.3) of BRS.**  The `L^q` norm of the maximal function applied to the
annulus test function is bounded below by the entropy of a separated subset of
`E ∩ J` in the right half of `J`. -/
theorem le_eLpNorm_M_annulusTest {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq : 0 < q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
              ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) ≤
            eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume := by
  classical
  obtain ⟨c₀, hc₀, hcap⟩ := le_sphericalAverage_annulusTest hd
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hpow2 : (0 : ℝ) < (2 : ℝ) ^ (d - 1) := by positivity
  refine ⟨c₀ / 2 ^ (d - 1) * (V / (5 * 2 ^ (d - 1))) ^ (1 / q), ?_, ?_⟩
  · have h1 : (0 : ℝ) < V / (5 * 2 ^ (d - 1)) := by positivity
    have h2 : (0 : ℝ) < (V / (5 * 2 ^ (d - 1))) ^ (1 / q) :=
      Real.rpow_pos_of_pos h1 _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  have hLpos : 0 < L := by linarith
  have hδLpos : 0 < δ / L := div_pos hδ hLpos
  have hsq : 0 ≤ Real.sqrt (δ / L) := Real.sqrt_nonneg _
  set S : Set (Euclidean d) :=
    ⋃ t ∈ T, radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) with hS
  have hSmeas : MeasurableSet S := by
    rw [hS]
    exact Finset.measurableSet_biUnion _
      fun t _ => measurableSet_radialAnnulusIcc d _ _
  -- the maximal function is large on `S`
  have hlarge : ∀ x ∈ S,
      ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) ≤
        M E (brsAnnulusTest d tL δ) x := by
    intro x hx
    obtain ⟨t, htT, hxt⟩ : ∃ t ∈ T,
        x ∈ radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) := by
      rw [hS] at hx
      simpa only [Set.mem_iUnion, exists_prop] using hx
    obtain ⟨hlow, hhigh⟩ := hright t htT
    have htE : t ∈ E := hTE htT
    have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
    have hxmem : ‖x‖ ∈ Icc (t - tL - δ / 10) (t - tL + δ / 10) := hxt
    have hxlow : t - tL - δ / 10 ≤ ‖x‖ := hxmem.1
    have hxhigh : ‖x‖ ≤ t - tL + δ / 10 := hxmem.2
    have hclose : |t - ‖x‖ - tL| ≤ δ / 10 := by
      rw [abs_le]
      constructor
      · linarith
      · linarith
    have hxpos : 4 * δ ≤ ‖x‖ * t := by
      have h1 : L / 2 - δ / 10 ≤ ‖x‖ := by linarith
      have h2 : (1 : ℝ) ≤ t := htIcc.1
      have h3 : 4 * δ ≤ L / 2 - δ / 10 := by linarith
      nlinarith [h1, h2, h3, hδ]
    have havg := hcap tL δ t hδ hδ1 htL (by linarith) htIcc.1 htIcc.2 x hxpos hclose
    -- compare the cap radii
    have hxup : ‖x‖ * t ≤ 4 * L := by
      have h1 : ‖x‖ ≤ L + δ / 10 := by linarith
      have h2 : t ≤ 2 := htIcc.2
      have h3 : (0 : ℝ) ≤ ‖x‖ := norm_nonneg _
      nlinarith [h1, h2, h3, hδ, hδL]
    have hratio : δ / (4 * L) ≤ δ / (‖x‖ * t) := by
      refine div_le_div_of_nonneg_left hδ.le ?_ hxup
      have h1 : (0 : ℝ) < ‖x‖ * t := by
        nlinarith [hxpos, hδ]
      exact h1
    have hsqrt : Real.sqrt (δ / L) / 2 ≤ Real.sqrt (δ / (‖x‖ * t)) := by
      have hhalf : Real.sqrt (δ / (4 * L)) = Real.sqrt (δ / L) / 2 := by
        rw [show δ / (4 * L) = (δ / L) * (1 / 4) by ring, Real.sqrt_mul hδLpos.le,
          show (1 : ℝ) / 4 = (1 / 2) ^ 2 by norm_num, Real.sqrt_sq (by norm_num)]
        ring
      rw [← hhalf]
      exact Real.sqrt_le_sqrt hratio
    refine le_trans (le_trans (ENNReal.ofReal_le_ofReal ?_) havg) ?_
    · have hmono : (Real.sqrt (δ / L) / 2) ^ (d - 1) ≤
          Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1) :=
        pow_le_pow_left₀ (by positivity) hsqrt _
      calc c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)
          = c₀ * (Real.sqrt (δ / L) / 2) ^ (d - 1) := by
            rw [div_pow]
            ring
        _ ≤ c₀ * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1) :=
            mul_le_mul_of_nonneg_left hmono hc₀.le
    · unfold M _root_.Spherical.restrictedSphericalMaximal
      have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
      exact le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ le_rfl)
  have hlow := le_eLpNorm_of_const_le_on hSmeas
    (by positivity : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1))
    hlarge hq
  have hB : (0 : ℝ) ≤ V / (5 * 2 ^ (d - 1)) := by
    have h1 : (0 : ℝ) < 5 * 2 ^ (d - 1) := by positivity
    exact div_nonneg hVpos.le h1.le
  have hN : (0 : ℝ) ≤ (T.card : ℝ) * δ * L ^ (d - 1) := by
    have h1 : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
    have h2 : (0 : ℝ) ≤ L ^ (d - 1) := pow_nonneg hLpos.le _
    have h3 : (0 : ℝ) ≤ (T.card : ℝ) * δ := mul_nonneg h1 hδ.le
    exact mul_nonneg h3 h2
  have hA : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1) := by
    have h1 : (0 : ℝ) ≤ c₀ / 2 ^ (d - 1) := div_nonneg hc₀.le hpow2.le
    exact mul_nonneg h1 (pow_nonneg hsq _)
  have hqinv : (0 : ℝ) ≤ 1 / q := by positivity
  have hvol : ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
      ((T.card : ℝ) * δ * L ^ (d - 1))) ≤ volume S := by
    have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
    have hinner : (0 : ℝ) ≤ δ / 5 * (L / 2) ^ (d - 1) := by
      have h1 : (0 : ℝ) ≤ δ / 5 := by linarith
      have h2 : (0 : ℝ) ≤ (L / 2) ^ (d - 1) := pow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    refine le_trans (le_of_eq ?_) (volume_biUnion_annuli_ge hd hδ hδL T hright hsep)
    rw [hVeq, ← ENNReal.ofReal_mul (mul_nonneg hcard hinner)]
    congr 1
    rw [div_pow]
    ring
  have hconst : ENNReal.ofReal (c₀ / 2 ^ (d - 1) *
        (V / (5 * 2 ^ (d - 1))) ^ (1 / q) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
          ((T.card : ℝ) * δ * L ^ (d - 1))) ^ (1 / q) := by
    rw [show c₀ / 2 ^ (d - 1) * (V / (5 * 2 ^ (d - 1))) ^ (1 / q) *
          Real.sqrt (δ / L) ^ (d - 1) =
        (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          (V / (5 * 2 ^ (d - 1))) ^ (1 / q) by ring,
      ENNReal.ofReal_mul hA, mul_assoc]
    congr 1
    rw [← ENNReal.ofReal_rpow_of_nonneg hB hqinv,
      ← ENNReal.mul_rpow_of_nonneg _ _ hqinv, ← ENNReal.ofReal_mul hB]
  calc ENNReal.ofReal (c₀ / 2 ^ (d - 1) *
        (V / (5 * 2 ^ (d - 1))) ^ (1 / q) * Real.sqrt (δ / L) ^ (d - 1)) *
        ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q)
      = ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          ENNReal.ofReal ((V / (5 * 2 ^ (d - 1))) *
            ((T.card : ℝ) * δ * L ^ (d - 1))) ^ (1 / q) := hconst
    _ ≤ ENNReal.ofReal (c₀ / 2 ^ (d - 1) * Real.sqrt (δ / L) ^ (d - 1)) *
          volume S ^ (1 / q) :=
        mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hvol (by positivity))
    _ ≤ eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume := hlow

/-- The square root, as a real power. -/
theorem sqrt_pow_eq_rpow {d : ℕ} (hd : 0 < d) {z : ℝ} (hz : 0 ≤ z) :
    Real.sqrt z ^ (d - 1) = z ^ (((d : ℝ) - 1) / 2) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_natCast (z ^ (1 / 2 : ℝ)) (d - 1),
    ← Real.rpow_mul hz]
  congr 1
  have h1 : (1 : ℕ) ≤ d := hd
  push_cast [Nat.cast_sub h1]
  ring

/-- The `L^p` norm of the annulus test function is at most `(W δ)^{1/p}`. -/
theorem eLpNorm_brsAnnulusTest_le {d : ℕ} (hd : 0 < d) {tL δ : ℝ} (htL : 1 ≤ tL)
    (htL2 : tL ≤ 2) (hδ : 0 < δ) (hδ1 : δ ≤ 1) {p : ℝ} (hp : 0 < p) :
    eLpNorm (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal ((2 * d * 3 ^ (d - 1) * δ *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal) ^ (1 / p)) := by
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  have hδW : (0 : ℝ) ≤ 2 * d * 3 ^ (d - 1) * δ := by positivity
  rw [eLpNorm_brsAnnulusTest d tL δ hp]
  refine le_trans (ENNReal.rpow_le_rpow (volume_thin_shell_le hd htL htL2 hδ hδ1)
    (by positivity)) (le_of_eq ?_)
  rw [hVeq, ← ENNReal.ofReal_mul hδW,
    ← ENNReal.ofReal_rpow_of_nonneg (mul_nonneg hδW hVpos.le) (by positivity)]

/-- **Lemma 3.5 of BRS, the entropy bound.**  A radial `L^p → L^q` bound forces
the quantity `ℭ_E(δ,J) = N(E ∩ J,δ)^{1/q} |J|^{-(d-1)(1/2-1/q)} δ^{(d-1)/2+1/q-1/p}`
to stay bounded, for every separated family in the right half of `J`. -/
theorem entropy_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq : 0 < q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ K : ℝ, 0 < K ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + L / 2 ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          (T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
              δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) ≤ K := by
  obtain ⟨C, hC, hbound⟩ := h
  obtain ⟨c, hc, hlow⟩ := le_eLpNorm_M_annulusTest hd hE hq
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  set W : ℝ := 2 * d * 3 ^ (d - 1) * V with hW
  have hWpos : 0 < W := by
    rw [hW]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  refine ⟨C * W ^ (1 / p) / c, div_pos (mul_pos hC (Real.rpow_pos_of_pos hWpos _)) hc,
    ?_⟩
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  have hLpos : 0 < L := by linarith
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  have hδLpos : 0 < δ / L := div_pos hδ hLpos
  -- the operator bound applied to the test function
  have hmem := memLp_brsAnnulusTest hd htL (by linarith) hδ hδ1 hp
  have hrad := isNormRadial_brsAnnulusTest d tL δ
  have hup := (hbound _ hmem hrad).2
  have hnorm := eLpNorm_brsAnnulusTest_le hd htL (by linarith) hδ hδ1 hp
  have hlowδ := hlow δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hright hsep
  -- chain the two bounds
  have hchain : ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
      ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) ≤
      ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
    refine le_trans hlowδ (le_trans hup ?_)
    have hstep : ENNReal.ofReal C *
        eLpNorm (brsAnnulusTest d tL δ) (ENNReal.ofReal p) volume ≤
        ENNReal.ofReal C *
          ENNReal.ofReal ((2 * d * 3 ^ (d - 1) * δ * V) ^ (1 / p)) :=
      mul_le_mul' le_rfl hnorm
    refine le_trans hstep (le_of_eq ?_)
    rw [← ENNReal.ofReal_mul hC.le]
    congr 1
    congr 1
    rw [hW]
    ring
  -- pass to real numbers
  have hLHS : ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1)) *
      ENNReal.ofReal ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      ENNReal.ofReal (c * Real.sqrt (δ / L) ^ (d - 1) *
        ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q)) := by
    have hn : (0 : ℝ) ≤ (T.card : ℝ) * δ * L ^ (d - 1) := by
      have h1 : (0 : ℝ) ≤ (T.card : ℝ) * δ := mul_nonneg hcard hδ.le
      exact mul_nonneg h1 (pow_nonneg hLpos.le _)
    have ha : (0 : ℝ) ≤ c * Real.sqrt (δ / L) ^ (d - 1) :=
      mul_nonneg hc.le (pow_nonneg (Real.sqrt_nonneg _) _)
    rw [ENNReal.ofReal_mul ha,
      ← ENNReal.ofReal_rpow_of_nonneg hn (by positivity : (0 : ℝ) ≤ 1 / q)]
  rw [hLHS] at hchain
  have hreal := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hchain
  -- rewrite both sides in the `ℭ` form
  have hsqrt : Real.sqrt (δ / L) ^ (d - 1) =
      δ ^ (((d : ℝ) - 1) / 2) * L ^ (-((((d : ℝ) - 1) / 2))) := by
    rw [sqrt_pow_eq_rpow hd hδLpos.le, Real.div_rpow hδ.le hLpos.le,
      Real.rpow_neg hLpos.le, div_eq_mul_inv]
  have hprod : ((T.card : ℝ) * δ * L ^ (d - 1)) ^ (1 / q) =
      (T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * L ^ ((((d : ℝ) - 1)) / q) := by
    have hLd : (L : ℝ) ^ (d - 1) = L ^ ((d : ℝ) - 1) := by
      rw [← Real.rpow_natCast L (d - 1)]
      congr 1
      have h1 : (1 : ℕ) ≤ d := hd
      push_cast [Nat.cast_sub h1]
      ring
    rw [hLd, Real.mul_rpow (mul_nonneg hcard hδ.le)
      (Real.rpow_nonneg hLpos.le _), Real.mul_rpow hcard hδ.le,
      ← Real.rpow_mul hLpos.le]
    congr 2
    ring
  have hcollect : c * (δ ^ (((d : ℝ) - 1) / 2) * L ^ (-((((d : ℝ) - 1) / 2)))) *
      ((T.card : ℝ) ^ (1 / q) * δ ^ (1 / q) * L ^ ((((d : ℝ) - 1)) / q)) =
      c * ((T.card : ℝ) ^ (1 / q) *
        L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
        δ ^ (((d : ℝ) - 1) / 2 + 1 / q)) := by
    rw [show -(((d : ℝ) - 1) * (1 / 2 - 1 / q)) =
        -((((d : ℝ) - 1) / 2)) + (((d : ℝ) - 1)) / q by ring,
      Real.rpow_add hLpos, Real.rpow_add hδ]
    ring
  rw [hsqrt, hprod, hcollect] at hreal
  -- divide by `δ^{1/p}`
  have hδp : (0 : ℝ) < δ ^ (1 / p) := Real.rpow_pos_of_pos hδ _
  have hsplit : (W * δ) ^ (1 / p) = W ^ (1 / p) * δ ^ (1 / p) :=
    Real.mul_rpow hWpos.le hδ.le
  rw [hsplit] at hreal
  rw [le_div_iff₀ hc]
  have hδsplit : δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) * δ ^ (1 / p) =
      δ ^ (((d : ℝ) - 1) / 2 + 1 / q) := by
    rw [← Real.rpow_add hδ]
    congr 1
    ring
  calc (T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
        δ ^ (((d : ℝ) - 1) / 2 + 1 / q - 1 / p) * c
      = c * ((T.card : ℝ) ^ (1 / q) * L ^ (-(((d : ℝ) - 1) * (1 / 2 - 1 / q))) *
          δ ^ (((d : ℝ) - 1) / 2 + 1 / q)) / δ ^ (1 / p) := by
        rw [← hδsplit]
        field_simp
    _ ≤ (C * (W ^ (1 / p) * δ ^ (1 / p))) / δ ^ (1 / p) := by
        gcongr
    _ = C * W ^ (1 / p) := by
        field_simp

/-- Splitting a quotient power against a power of the denominator. -/
theorem div_rpow_mul_rpow {x y s e : ℝ} (hx : 0 ≤ x) (hy : 0 < y) :
    (x / y) ^ s * y ^ e = x ^ s * y ^ (e - s) := by
  rw [Real.div_rpow hx hy.le, Real.rpow_sub hy, div_mul_eq_mul_div, mul_div_assoc]

/-- **The per-annulus contribution is monotone in the radius.**  For `q ≥ 2`
the product of the `q`-th power of the cap bound `(δ/a)^{(d-1)/2}` with the
annulus volume `a^{d-1} δ` is nonincreasing in `a`, so the smallest
contribution comes from the largest radius `a = |J|`.  This is what removes
any restriction to the right half of `J`. -/
theorem annulus_contribution_mono {d : ℕ} (hd : 0 < d) {q δ a L : ℝ}
    (hq2 : 2 ≤ q) (hδ : 0 < δ) (ha : 0 < a) (haL : a ≤ L) :
    (δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) ≤
      (δ / a) ^ (q * ((d : ℝ) - 1) / 2) * a ^ ((d : ℝ) - 1) := by
  have hLpos : 0 < L := lt_of_lt_of_le ha haL
  have hd1 : (0 : ℝ) ≤ (d : ℝ) - 1 := by
    have h1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
    linarith
  have hes : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 ≤ 0 := by
    nlinarith [hd1, hq2]
  rw [div_rpow_mul_rpow hδ.le hLpos, div_rpow_mul_rpow hδ.le ha]
  refine mul_le_mul_of_nonneg_left ?_ (Real.rpow_nonneg hδ.le _)
  exact Real.rpow_le_rpow_of_nonpos ha haL hes

/-- The cap bound and the annulus volume, combined at a single radius. -/
theorem annulus_contribution_ge {d : ℕ} (hd : 0 < d) {q δ a L : ℝ}
    (hq2 : 2 ≤ q) (hδ : 0 < δ) (ha : 0 < a) (haL : a ≤ L) {c : ℝ} (hc : 0 ≤ c) :
    c * ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1)) ≤
      c * ((δ / a) ^ (q * ((d : ℝ) - 1) / 2) * a ^ ((d : ℝ) - 1)) :=
  mul_le_mul_of_nonneg_left (annulus_contribution_mono hd hq2 hδ ha haL) hc

/-- A natural power of a positive real, as a real power. -/
theorem pow_eq_rpow_natCast_sub_one {d : ℕ} (hd : 0 < d) {a : ℝ} (_ha : 0 < a) :
    a ^ (d - 1) = a ^ ((d : ℝ) - 1) := by
  rw [← Real.rpow_natCast a (d - 1)]
  congr 1
  have h1 : (1 : ℕ) ≤ d := hd
  push_cast [Nat.cast_sub h1]
  ring

/-- **The per-annulus contribution to the `q`-th power of the norm.** -/
theorem le_setLIntegral_M_annulusTest {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq2 : 2 ≤ q) {c₀ : ℝ} (hc₀ : 0 < c₀)
    (hcap : ∀ tL δ t : ℝ, 0 < δ → δ ≤ 1 → 1 ≤ tL → tL ≤ 2 → 1 ≤ t → t ≤ 2 →
      ∀ x : Euclidean d, 4 * δ ≤ ‖x‖ * t → |t - ‖x‖ - tL| ≤ δ / 10 →
        ENNReal.ofReal (c₀ * Real.sqrt (δ / (‖x‖ * t)) ^ (d - 1)) ≤
          ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
            (brsAnnulusTest d tL δ) x‖)
    {δ L tL : ℝ} (hδ : 0 < δ) (hδ1 : δ ≤ 1) (hδL : 10 * δ ≤ L) (hL1 : L ≤ 1)
    (htL : 1 ≤ tL) (htLL : tL + L ≤ 2) {t : ℝ} (htE : t ∈ E)
    (hta : tL + 5 * δ ≤ t) (htb : t ≤ tL + L) :
    ENNReal.ofReal (c₀ ^ q / 5 *
        (volume (Metric.ball (0 : Euclidean d) 1)).toReal *
        (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
      ∫⁻ x in radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10),
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hde : (0 : ℝ) ≤ ((d : ℝ) - 1) / 2 := by linarith
  have hLpos : 0 < L := by linarith
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have htpos : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one htIcc.1
  set a : ℝ := t - tL with ha
  have hapos : 5 * δ ≤ a := by
    rw [ha]
    linarith
  have haL : a ≤ L := by
    rw [ha]
    linarith
  have ha0 : 0 < a := by linarith
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  have hVeq : volume (Metric.ball (0 : Euclidean d) 1) = ENNReal.ofReal V := by
    rw [hV, ENNReal.ofReal_toReal hVtop]
  -- the pointwise lower bound on the annulus
  have hpoint : ∀ x ∈ radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
      ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) ≤
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q := by
    intro x hx
    have hxmem : ‖x‖ ∈ Icc (a - δ / 10) (a + δ / 10) := hx
    have hxlow : a - δ / 10 ≤ ‖x‖ := hxmem.1
    have hxhigh : ‖x‖ ≤ a + δ / 10 := hxmem.2
    have hxpos : 0 < ‖x‖ := by linarith
    have hclose : |t - ‖x‖ - tL| ≤ δ / 10 := by
      rw [abs_le]
      constructor
      · rw [ha] at hxhigh
        linarith
      · rw [ha] at hxlow
        linarith
    have h4δ : 4 * δ ≤ ‖x‖ * t := by
      have h1 : 4 * δ ≤ ‖x‖ := by linarith
      nlinarith [htIcc.1, hxpos]
    have havg := hcap tL δ t hδ hδ1 htL (by linarith) htIcc.1 htIcc.2 x h4δ hclose
    -- the maximal function dominates the single average
    have hM : ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t
        (brsAnnulusTest d tL δ) x‖ ≤ M E (brsAnnulusTest d tL δ) x := by
      unfold M _root_.Spherical.restrictedSphericalMaximal
      exact le_iSup_of_le t (le_iSup_of_le ⟨htE, htpos⟩ le_rfl)
    have hxt : ‖x‖ * t ≤ 4 * a := by
      have h1 : ‖x‖ ≤ 2 * a := by linarith
      nlinarith [htIcc.2, hxpos, ha0]
    have hratio : δ / (4 * a) ≤ δ / (‖x‖ * t) := by
      refine div_le_div_of_nonneg_left hδ.le ?_ hxt
      nlinarith [h4δ, hδ]
    have hbase : ENNReal.ofReal (c₀ * (δ / (4 * a)) ^ (((d : ℝ) - 1) / 2)) ≤
        ‖M E (brsAnnulusTest d tL δ) x‖ₑ := by
      rw [enorm_eq_self]
      refine le_trans (le_trans (ENNReal.ofReal_le_ofReal ?_) havg) hM
      rw [sqrt_pow_eq_rpow hd (by positivity : (0:ℝ) ≤ δ / (‖x‖ * t))]
      refine mul_le_mul_of_nonneg_left ?_ hc₀.le
      exact Real.rpow_le_rpow (by positivity) hratio hde
    calc ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2))
        = (ENNReal.ofReal (c₀ * (δ / (4 * a)) ^ (((d : ℝ) - 1) / 2))) ^ q := by
          rw [ENNReal.ofReal_rpow_of_pos
            (mul_pos hc₀ (Real.rpow_pos_of_pos (by positivity) _))]
          congr 1
          rw [Real.mul_rpow hc₀.le (Real.rpow_nonneg (by positivity) _),
            ← Real.rpow_mul (by positivity)]
          congr 2
          ring
      _ ≤ ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q :=
          ENNReal.rpow_le_rpow hbase hq0.le
  -- integrate the pointwise bound
  have hvol := volume_radialAnnulus_ge hd hδ (by linarith : δ / 10 ≤ a)
  calc ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
      ≤ ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          ENNReal.ofReal (δ / 5 * a ^ (d - 1)) * ENNReal.ofReal V := by
        rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
        refine ENNReal.ofReal_le_ofReal ?_
        have hsplit : (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2) =
            (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              (δ / a) ^ (q * ((d : ℝ) - 1) / 2) := by
          rw [show δ / (4 * a) = (1 / 4) * (δ / a) by ring,
            Real.mul_rpow (by norm_num) (by positivity)]
          congr 1
          rw [show (1 : ℝ) / 4 = (4 : ℝ)⁻¹ by norm_num,
            ← Real.rpow_neg_one (4 : ℝ), ← Real.rpow_mul (by norm_num)]
          congr 1
          ring
        have hmono := annulus_contribution_mono hd hq2 hδ ha0 haL
        have hpowa : a ^ (d - 1) = a ^ ((d : ℝ) - 1) :=
          pow_eq_rpow_natCast_sub_one hd ha0
        rw [hsplit, hpowa]
        have hfac : (0 : ℝ) ≤ c₀ ^ q / 5 * V *
            (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) * δ := by positivity
        nlinarith [hmono, hfac, mul_le_mul_of_nonneg_left hmono hfac]
    _ = ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          (ENNReal.ofReal (δ / 5 * a ^ (d - 1)) *
            volume (Metric.ball (0 : Euclidean d) 1)) := by
        rw [hVeq, mul_assoc]
    _ ≤ ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) *
          volume (radialAnnulusIcc d (a - δ / 10) (a + δ / 10)) :=
        mul_le_mul' le_rfl hvol
    _ = ∫⁻ _x in radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
          ENNReal.ofReal (c₀ ^ q * (δ / (4 * a)) ^ (q * ((d : ℝ) - 1) / 2)) :=
        (setLIntegral_const _ _).symm
    _ ≤ ∫⁻ x in radialAnnulusIcc d (a - δ / 10) (a + δ / 10),
          ‖M E (brsAnnulusTest d tL δ) x‖ₑ ^ q :=
        setLIntegral_mono' (measurableSet_radialAnnulusIcc d _ _) hpoint

/-- **(3.3) of BRS, without the right-half restriction.**  Every `δ`-separated
family of dilations in `J`, away from the left endpoint, contributes to the
`q`-th power of the norm of the maximal function. -/
theorem le_eLpNorm_M_annulusTest_general {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {q : ℝ} (hq2 : 2 ≤ q) :
    ∃ c : ℝ, 0 < c ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + 5 * δ ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          ENNReal.ofReal (c * (T.card : ℝ) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
            eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ^ q := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨c₀, hc₀, hcap⟩ := le_sphericalAverage_annulusTest hd
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  refine ⟨c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)), ?_, ?_⟩
  · have h1 : (0 : ℝ) < c₀ ^ q := Real.rpow_pos_of_pos hc₀ _
    have h2 : (0 : ℝ) < (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hLpos : 0 < L := by linarith
  set F : Euclidean d → ENNReal := M E (brsAnnulusTest d tL δ) with hF
  set A : ℝ → Set (Euclidean d) :=
    fun t => radialAnnulusIcc d (t - tL - δ / 10) (t - tL + δ / 10) with hA
  have hmeas : ∀ t ∈ T, MeasurableSet (A t) :=
    fun t _ => measurableSet_radialAnnulusIcc d _ _
  have hdisj : (↑T : Set ℝ).PairwiseDisjoint A := by
    intro t ht s hs hts
    have hsepts : δ ≤ |t - s| := hsep t (by simpa using ht) s (by simpa using hs) hts
    have habs : |(t - tL) - (s - tL)| = |t - s| := by
      congr 1
      ring
    exact radialAnnulus_disjoint_of_separated (d := d) hδ (by rw [habs]; exact hsepts)
  -- the norm as an integral
  have hnorm : eLpNorm F (ENNReal.ofReal q) volume ^ q = ∫⁻ x, ‖F x‖ₑ ^ q := by
    have hq0' : ENNReal.ofReal q ≠ 0 := by
      simp only [ne_eq, ENNReal.ofReal_eq_zero]
      exact not_le.mpr hq0
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hq0' ENNReal.ofReal_ne_top,
      ENNReal.toReal_ofReal hq0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  rw [hnorm]
  -- restrict to the union of the annuli
  have hunion : (∫⁻ x in ⋃ t ∈ T, A t, ‖F x‖ₑ ^ q) ≤ ∫⁻ x, ‖F x‖ₑ ^ q :=
    lintegral_mono' Measure.restrict_le_self fun _ => le_rfl
  refine le_trans ?_ hunion
  rw [lintegral_biUnion_finset hdisj hmeas]
  -- each annulus contributes the same amount
  have hterm : ∀ t ∈ T,
      ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) ≤
        ∫⁻ x in A t, ‖F x‖ₑ ^ q := by
    intro t ht
    obtain ⟨hta, htb⟩ := hrange t ht
    exact le_setLIntegral_M_annulusTest hd hE hq2 hc₀ hcap hδ hδ1 hδL hL1 htL
      htLL (hTE (by simpa using ht)) hta htb
  calc ENNReal.ofReal (c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
        (T.card : ℝ) * ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
      = (T.card : ℕ) • ENNReal.ofReal (c₀ ^ q / 5 * V *
          (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) := by
        rw [nsmul_eq_mul]
        rw [show c₀ ^ q / 5 * V * (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              (T.card : ℝ) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ) =
            (T.card : ℝ) * (c₀ ^ q / 5 * V *
              (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
              ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ))
            by ring,
          ENNReal.ofReal_mul (Nat.cast_nonneg (T.card)), ENNReal.ofReal_natCast]
    _ = ∑ _t ∈ T, ENNReal.ofReal (c₀ ^ q / 5 * V *
          (4 : ℝ) ^ (-(q * ((d : ℝ) - 1) / 2)) *
          ((δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) * δ)) := by
        rw [Finset.sum_const]
    _ ≤ ∑ t ∈ T, ∫⁻ x in A t, ‖F x‖ₑ ^ q := Finset.sum_le_sum hterm

/-- **Lemma 3.5 of BRS, in profile form.**  A radial `L^p → L^q` bound with
`q ≥ 2` bounds the Legendre profile `|J|^{-α} N(E ∩ J, δ)` with
`α = (d-1)(q/2-1)` by `M δ^{-B}`, `B = q(d-1)/2 + 1 - q/p`. -/
theorem profile_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ} (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ L tL : ℝ, 0 < δ → δ ≤ 1 → 10 * δ ≤ L → L ≤ 1 →
      1 ≤ tL → tL + L ≤ 2 → ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E →
        (∀ t ∈ T, tL + 5 * δ ≤ t ∧ t ≤ tL + L) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) ≤
            M * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨c, hc, hlow⟩ := le_eLpNorm_M_annulusTest_general hd hE hq2
  obtain ⟨C, hC, hbound⟩ := h
  set V : ℝ := (volume (Metric.ball (0 : Euclidean d) 1)).toReal with hV
  have hVtop : volume (Metric.ball (0 : Euclidean d) 1) ≠ ⊤ :=
    ((measure_mono Metric.ball_subset_closedBall).trans_lt
      measure_closedBall_lt_top).ne
  have hVpos : 0 < V :=
    ENNReal.toReal_pos
      (ne_of_gt (Metric.measure_ball_pos volume (0 : Euclidean d) one_pos)) hVtop
  set W : ℝ := 2 * d * 3 ^ (d - 1) * V with hW
  have hWpos : 0 < W := by
    rw [hW]
    have hdpos : (0 : ℝ) < d := by exact_mod_cast hd
    positivity
  refine ⟨C ^ q * W ^ (q / p) / c, ?_, ?_⟩
  · have h1 : (0 : ℝ) < C ^ q := Real.rpow_pos_of_pos hC _
    have h2 : (0 : ℝ) < W ^ (q / p) := Real.rpow_pos_of_pos hWpos _
    positivity
  intro δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hLpos : 0 < L := by linarith
  have hcard : (0 : ℝ) ≤ (T.card : ℝ) := Nat.cast_nonneg _
  -- the upper bound from the operator
  have hmem := memLp_brsAnnulusTest hd htL (by linarith) hδ hδ1 hp
  have hrad := isNormRadial_brsAnnulusTest d tL δ
  have hup := (hbound _ hmem hrad).2
  have hnorm := eLpNorm_brsAnnulusTest_le hd htL (by linarith) hδ hδ1 hp
  have hupq : eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ^ q ≤
      ENNReal.ofReal (C ^ q * (W * δ) ^ (q / p)) := by
    have hstep : eLpNorm (M E (brsAnnulusTest d tL δ)) (ENNReal.ofReal q) volume ≤
        ENNReal.ofReal (C * (W * δ) ^ (1 / p)) := by
      refine le_trans hup ?_
      refine le_trans (mul_le_mul' le_rfl hnorm) (le_of_eq ?_)
      rw [← ENNReal.ofReal_mul hC.le]
      congr 1
      rw [show W * δ = 2 * d * 3 ^ (d - 1) * δ * V by rw [hW]; ring]
    refine le_trans (ENNReal.rpow_le_rpow hstep hq0.le) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_pos
      (mul_pos hC (Real.rpow_pos_of_pos (mul_pos hWpos hδ) _))]
    congr 1
    rw [Real.mul_rpow hC.le (Real.rpow_nonneg (mul_pos hWpos hδ).le _),
      ← Real.rpow_mul (mul_pos hWpos hδ).le]
    congr 2
    field_simp
  -- combine with the lower bound
  have hlowδ := hlow δ L tL hδ hδ1 hδL hL1 htL htLL T hTE hrange hsep
  have hchain := le_trans hlowδ hupq
  have hreal := (ENNReal.ofReal_le_ofReal_iff (by positivity)).mp hchain
  -- unwind the exponents
  have hsplit : (δ / L) ^ (q * ((d : ℝ) - 1) / 2) * L ^ ((d : ℝ) - 1) =
      δ ^ (q * ((d : ℝ) - 1) / 2) *
        L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) :=
    div_rpow_mul_rpow hδ.le hLpos
  rw [hsplit] at hreal
  have hWsplit : (W * δ) ^ (q / p) = W ^ (q / p) * δ ^ (q / p) :=
    Real.mul_rpow hWpos.le hδ.le
  rw [hWsplit] at hreal
  -- solve for the profile quantity
  have hposδ : (0 : ℝ) < δ ^ (q * ((d : ℝ) - 1) / 2) * δ := by positivity
  have hpow : δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
      (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) = δ ^ (q / p) := by
    rw [show δ ^ (q * ((d : ℝ) - 1) / 2) * δ =
        δ ^ (q * ((d : ℝ) - 1) / 2 + 1) by
      rw [Real.rpow_add hδ, Real.rpow_one], ← Real.rpow_add hδ]
    congr 1
    ring
  rw [show C ^ q * W ^ (q / p) / c *
        δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) =
      (C ^ q * W ^ (q / p) * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p))) / c
      by ring, le_div_iff₀ hc]
  have hmul : L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
      (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := by
    calc L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
          (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)
        = c * (T.card : ℝ) *
            (δ ^ (q * ((d : ℝ) - 1) / 2) *
              L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * δ) := by ring
      _ ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := hreal
  have hgoal : L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c ≤
      C ^ q * W ^ (q / p) * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
    rw [← mul_le_mul_iff_of_pos_right hposδ]
    calc L ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) * c *
          (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)
        ≤ C ^ q * (W ^ (q / p) * δ ^ (q / p)) := hmul
      _ = C ^ q * W ^ (q / p) *
            (δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
              (δ ^ (q * ((d : ℝ) - 1) / 2) * δ)) := by
          rw [hpow]
          ring
      _ = C ^ q * W ^ (q / p) *
            δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) *
            (δ ^ (q * ((d : ℝ) - 1) / 2) * δ) := by ring
  exact hgoal

/-- **The Legendre profile term is bounded, for every interval.**  This is
Lemma 3.5 in the form needed by the Legendre--Assouad function: the count of a
`δ`-separated family inside an arbitrary interval `I`, weighted by
`|I|^{-α}` with `α = (d-1)(q/2-1)`, is `O(δ^{-B})`,
`B = q(d-1)/2 + 1 - q/p`. -/
theorem profile_term_bound_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p)
    (hq2 : 2 ≤ q) (h : HasRadialStrongType d E (ENNReal.ofReal p)
      (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ a R : ℝ, 0 < δ → δ ≤ 1 / 100 → 2 * δ ≤ R → R ≤ 1 →
      ∀ T : Finset ℝ, (↑T : Set ℝ) ⊆ E ∩ Icc a (a + R) →
        (∀ t ∈ T, ∀ s ∈ T, t ≠ s → δ ≤ |t - s|) →
          R ^ (((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2) * (T.card : ℝ) ≤
            M * δ ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hd1 : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hqpd : q ≤ p * d := le_mul_of_hasRadialStrongType hd hE hEne hp hq0 h
  set α : ℝ := ((d : ℝ) - 1) * (q / 2 - 1) with hα
  set B : ℝ := q * ((d : ℝ) - 1) / 2 + 1 - q / p with hB
  have hαnonneg : 0 ≤ α := by
    rw [hα]
    have h1 : (0 : ℝ) ≤ (d : ℝ) - 1 := by linarith
    have h2 : (0 : ℝ) ≤ q / 2 - 1 := by linarith
    exact mul_nonneg h1 h2
  have hαB : α ≤ B := by
    rw [hα, hB]
    have hqp : q / p ≤ (d : ℝ) := by
      rw [div_le_iff₀ hp]
      linarith [hqpd]
    nlinarith [hqp, hd1]
  have hexp : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 = -α := by
    rw [hα]
    ring
  obtain ⟨M₀, hM₀, hprof⟩ := profile_bound_of_hasRadialStrongType hd hE hp hq2 h
  refine ⟨M₀ + 11, by linarith, ?_⟩
  intro δ a R hδ hδ1 hδR hR1 T hTsub hsep
  have hRpos : 0 < R := by linarith
  have hδle1 : δ ≤ 1 := by linarith
  have hTE : (↑T : Set ℝ) ⊆ E := fun t ht => (hTsub ht).1
  have hTI : ∀ t ∈ T, a ≤ t ∧ t ≤ a + R := by
    intro t ht
    have hmem := (hTsub (by simpa using ht)).2
    exact ⟨hmem.1, hmem.2⟩
  have hT12 : ∀ t ∈ T, (1 : ℝ) ≤ t ∧ t ≤ 2 := by
    intro t ht
    have hmem := hE (hTE (by simpa using ht))
    exact ⟨hmem.1, hmem.2⟩
  set u : ℝ := max a 1 with hu
  set v : ℝ := min (a + R) 2 with hv
  have hTu : ∀ t ∈ T, u ≤ t := by
    intro t ht
    rw [hu, max_le_iff]
    exact ⟨(hTI t ht).1, (hT12 t ht).1⟩
  have hTv : ∀ t ∈ T, t ≤ v := by
    intro t ht
    rw [hv, le_min_iff]
    exact ⟨(hTI t ht).2, (hT12 t ht).2⟩
  have hu1 : (1 : ℝ) ≤ u := le_max_right _ _
  have hv2 : v ≤ 2 := min_le_right _ _
  have hvu : v - u ≤ R := by
    have h1 : v ≤ a + R := min_le_left _ _
    have h2 : a ≤ u := le_max_left _ _
    linarith
  -- the two scale comparisons
  have hδα : δ ^ (-α) ≤ δ ^ (-B) :=
    Real.rpow_le_rpow_of_exponent_ge hδ hδle1 (by linarith)
  have hRα : R ^ (-α) ≤ δ ^ (-α) :=
    Real.rpow_le_rpow_of_nonpos hδ (by linarith) (by linarith)
  have hRB : R ^ (-α) ≤ δ ^ (-B) := le_trans hRα hδα
  have hRαpos : 0 < R ^ (-α) := Real.rpow_pos_of_pos hRpos _
  rw [hexp]
  by_cases hcase : v - u < 10 * δ
  · -- a short interval carries few separated points
    have hsub : ∀ t ∈ T, t ∈ Icc u (u + (10 : ℕ) * δ) := by
      intro t ht
      refine ⟨hTu t ht, ?_⟩
      have h1 := hTv t ht
      push_cast
      linarith
    have hcard := brrs_card_le_succ_of_separated_in_interval (S := T) (a := u)
      (len := δ) (n := 10) hδ hsub hsep
    have hcardR : (T.card : ℝ) ≤ 11 := by
      have : (T.card : ℝ) ≤ ((10 : ℕ) + 1 : ℕ) := by exact_mod_cast hcard
      push_cast at this
      linarith
    calc R ^ (-α) * (T.card : ℝ) ≤ R ^ (-α) * 11 :=
          mul_le_mul_of_nonneg_left hcardR hRαpos.le
      _ ≤ δ ^ (-B) * 11 := mul_le_mul_of_nonneg_right hRB (by norm_num)
      _ ≤ (M₀ + 11) * δ ^ (-B) := by
          have hδBpos : 0 < δ ^ (-B) := Real.rpow_pos_of_pos hδ _
          nlinarith [hδBpos, hM₀]
  · -- the main case
    push Not at hcase
    set L : ℝ := v - u with hL
    have hL10 : 10 * δ ≤ L := by
      rw [hL]
      exact hcase
    have hLpos : 0 < L := by linarith
    have hL1 : L ≤ 1 := by
      rw [hL]
      linarith
    have huL : u + L ≤ 2 := by
      rw [hL]
      linarith
    set T₁ : Finset ℝ := T.filter (fun t => u + 5 * δ ≤ t) with hT₁
    set T₀ : Finset ℝ := T.filter (fun t => ¬ (u + 5 * δ ≤ t)) with hT₀
    have hsplit : T₁.card + T₀.card = T.card := by
      rw [hT₁, hT₀]
      exact Finset.card_filter_add_card_filter_not (p := fun t => u + 5 * δ ≤ t)
    have hcard₀ : (T₀.card : ℝ) ≤ 6 := by
      have hsub₀ : ∀ t ∈ T₀, t ∈ Icc u (u + (5 : ℕ) * δ) := by
        intro t ht
        rw [hT₀, Finset.mem_filter] at ht
        refine ⟨hTu t ht.1, ?_⟩
        have := ht.2
        push_cast
        linarith [not_le.mp this]
      have hsep₀ : ∀ t ∈ T₀, ∀ s ∈ T₀, t ≠ s → δ ≤ |t - s| := by
        intro t ht s hs hts
        rw [hT₀, Finset.mem_filter] at ht hs
        exact hsep t ht.1 s hs.1 hts
      have hc := brrs_card_le_succ_of_separated_in_interval (S := T₀) (a := u)
        (len := δ) (n := 5) hδ hsub₀ hsep₀
      have : (T₀.card : ℝ) ≤ ((5 : ℕ) + 1 : ℕ) := by exact_mod_cast hc
      push_cast at this
      linarith
    have hT₁E : (↑T₁ : Set ℝ) ⊆ E := by
      intro t ht
      simp only [hT₁, Finset.coe_filter, Set.mem_setOf_eq] at ht
      exact hTE (by simpa using ht.1)
    have hT₁range : ∀ t ∈ T₁, u + 5 * δ ≤ t ∧ t ≤ u + L := by
      intro t ht
      rw [hT₁, Finset.mem_filter] at ht
      refine ⟨ht.2, ?_⟩
      have := hTv t ht.1
      rw [hL]
      linarith
    have hT₁sep : ∀ t ∈ T₁, ∀ s ∈ T₁, t ≠ s → δ ≤ |t - s| := by
      intro t ht s hs hts
      rw [hT₁, Finset.mem_filter] at ht hs
      exact hsep t ht.1 s hs.1 hts
    have hprofT₁ := hprof δ L u hδ hδle1 hL10 hL1 hu1 huL T₁ hT₁E hT₁range hT₁sep
    rw [hexp] at hprofT₁
    -- compare the interval scales
    have hLR : R ^ (-α) ≤ L ^ (-α) :=
      Real.rpow_le_rpow_of_nonpos hLpos (by linarith) (by linarith)
    have hcardsplit : (T.card : ℝ) = (T₁.card : ℝ) + (T₀.card : ℝ) := by
      rw [← hsplit]
      push_cast
      ring
    have hδBpos : 0 < δ ^ (-B) := Real.rpow_pos_of_pos hδ _
    calc R ^ (-α) * (T.card : ℝ)
        = R ^ (-α) * (T₁.card : ℝ) + R ^ (-α) * (T₀.card : ℝ) := by
          rw [hcardsplit]
          ring
      _ ≤ L ^ (-α) * (T₁.card : ℝ) + R ^ (-α) * 6 := by
          have h1 : R ^ (-α) * (T₁.card : ℝ) ≤ L ^ (-α) * (T₁.card : ℝ) :=
            mul_le_mul_of_nonneg_right hLR (Nat.cast_nonneg _)
          have h2 : R ^ (-α) * (T₀.card : ℝ) ≤ R ^ (-α) * 6 :=
            mul_le_mul_of_nonneg_left hcard₀ hRαpos.le
          linarith
      _ ≤ M₀ * δ ^ (-B) + δ ^ (-B) * 6 := by
          have h2 : R ^ (-α) * 6 ≤ δ ^ (-B) * 6 :=
            mul_le_mul_of_nonneg_right hRB (by norm_num)
          linarith [hprofT₁]
      _ ≤ (M₀ + 11) * δ ^ (-B) := by nlinarith [hδBpos]

/-- **The Legendre--Assouad profile is bounded by a power of the scale.**  This
is Lemma 3.5 in exactly the shape consumed by
`brrsLegendreAssouadFunction_le_of_profile_power_bound`. -/
theorem brrsProfile_le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ} (hp : 0 < p)
    (hq2 : 2 ≤ q) (h : HasRadialStrongType d E (ENNReal.ofReal p)
      (ENNReal.ofReal q)) :
    ∃ M : ℝ, 0 < M ∧ ∀ δ : ℝ≥0, 0 < δ → (δ : ℝ) ≤ 1 / 100 →
      _root_.Auto.Spherical.BRRS.brrsLegendreAssouadProfile E
          (((d : ℝ) - 1) * (q / 2 - 1)) δ ≤
        ENNReal.ofReal M *
          (δ : ℝ≥0∞) ^ (-(q * ((d : ℝ) - 1) / 2 + 1 - q / p)) := by
  classical
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  obtain ⟨M₀, hM₀, hterm⟩ :=
    profile_term_bound_of_hasRadialStrongType hd hE hEne hp hq2 h
  set α : ℝ := ((d : ℝ) - 1) * (q / 2 - 1) with hα
  set B : ℝ := q * ((d : ℝ) - 1) / 2 + 1 - q / p with hB
  have hexp : ((d : ℝ) - 1) - q * ((d : ℝ) - 1) / 2 = -α := by
    rw [hα]
    ring
  refine ⟨M₀ * (2 : ℝ) ^ B, ?_, ?_⟩
  · have h2 : (0 : ℝ) < (2 : ℝ) ^ B := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  intro δ hδpos hδ100
  have hδR : (0 : ℝ) < (δ : ℝ) := hδpos
  rw [_root_.Auto.Spherical.BRRS.brrsLegendreAssouadProfile]
  refine iSup_le fun a => iSup_le fun R => ?_
  obtain ⟨hRδ, hR1⟩ := R.2
  have hRposR : (0 : ℝ) < (R.1 : ℝ) := lt_of_lt_of_le hδR (by exact_mod_cast hRδ)
  have hR1R : (R.1 : ℝ) ≤ 1 := by exact_mod_cast hR1
  -- a maximal separated subset of the local piece
  set I : Set ℝ := _root_.Auto.Spherical.BRRS.brrsInterval a (R.1 : ℝ)
    with hI
  have hEI : E ∩ I ⊆ Icc (1 : ℝ) 2 := fun t ht => hE ht.1
  obtain ⟨T, hT⟩ := exists_isMaximalSeparatedSubset hEI
    (by positivity : (0 : ℝ) < ((δ / 2 : ℝ≥0) : ℝ))
  have hhalf : (2 : ℝ≥0) * (δ / 2) = δ := by
    rw [mul_comm]
    field_simp
  have hentropy : _root_.Auto.Spherical.BRRS.brrsEntropyNumber
      (E ∩ I) δ ≤ (T.card : ℝ≥0∞) := by
    have := brrsEntropyNumber_le_card_of_isMaximalSeparatedSubset
      (E := E ∩ I) (δ := δ / 2) (by positivity) hT
    rwa [hhalf] at this
  -- the real bound
  have hδ2R : (0 : ℝ) < ((δ / 2 : ℝ≥0) : ℝ) := by positivity
  have hδ2val : ((δ / 2 : ℝ≥0) : ℝ) = (δ : ℝ) / 2 := by
    push_cast
    ring
  have hTsub : (↑T : Set ℝ) ⊆ E ∩ Icc a (a + (R.1 : ℝ)) := by
    intro t ht
    have := hT.1 ht
    exact ⟨this.1, this.2⟩
  have hTsep : ∀ t ∈ T, ∀ s ∈ T, t ≠ s → ((δ : ℝ) / 2) ≤ |t - s| := by
    intro t ht s hs hts
    have := hT.2.1 (by simpa using ht) (by simpa using hs) hts
    rwa [hδ2val] at this
  have hbound := hterm ((δ : ℝ) / 2) a (R.1 : ℝ) (by positivity)
    (by linarith) (by linarith [hRδ, (by exact_mod_cast hRδ : (δ : ℝ) ≤ (R.1 : ℝ))])
    hR1R T hTsub hTsep
  rw [hexp] at hbound
  -- transfer to `ℝ≥0∞`
  have hcast : ((R.1 : ℝ≥0) : ℝ≥0∞) ^ (-α) *
      _root_.Auto.Spherical.BRRS.brrsEntropyNumber (E ∩ I) δ ≤
      ENNReal.ofReal ((R.1 : ℝ) ^ (-α) * (T.card : ℝ)) := by
    have h1 : ((R.1 : ℝ≥0) : ℝ≥0∞) ^ (-α) =
        ENNReal.ofReal ((R.1 : ℝ) ^ (-α)) := by
      rw [← ENNReal.ofReal_coe_nnreal, ← ENNReal.ofReal_rpow_of_pos hRposR]
    rw [h1, ENNReal.ofReal_mul (Real.rpow_nonneg hRposR.le _)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hentropy (le_of_eq ?_)
    rw [ENNReal.ofReal_natCast]
  refine le_trans hcast ?_
  -- the power of the half scale
  have hhalfpow : ((δ : ℝ) / 2) ^ (-B) = (2 : ℝ) ^ B * (δ : ℝ) ^ (-B) := by
    rw [Real.div_rpow hδR.le (by norm_num), Real.rpow_neg (by norm_num : (0:ℝ) ≤ 2),
      div_eq_mul_inv, inv_inv]
    ring
  have hfinal : (R.1 : ℝ) ^ (-α) * (T.card : ℝ) ≤
      M₀ * (2 : ℝ) ^ B * (δ : ℝ) ^ (-B) := by
    refine le_trans hbound (le_of_eq ?_)
    rw [hhalfpow]
    ring
  refine le_trans (ENNReal.ofReal_le_ofReal hfinal) (le_of_eq ?_)
  rw [ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_coe_nnreal,
    ENNReal.ofReal_rpow_of_pos hδR]

/-- **Lemma 3.5 of BRS.**  For `q ≥ 2` a radial `L^p → L^q` bound forces the
Legendre-Assouad function to satisfy
`(1/q) ν♯((d-1)(q/2-1)) + 1/p - 1/q ≤ (d-1)/2`. -/
theorem legendreAssouad_le_of_hasRadialStrongType {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ}
    (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    _root_.Auto.Spherical.BRRS.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) ≤
      q * ((d : ℝ) - 1) / 2 + 1 - q / p := by
  obtain ⟨M, hM, hprof⟩ :=
    brrsProfile_le_of_hasRadialStrongType hd hE hEne hp hq2 h
  refine _root_.Auto.Spherical.BRRS.brrsLegendreAssouadFunction_le_of_profile_power_bound
    hEne (M := M) ENNReal.ofReal_ne_top ?_
  have hmem : Set.Ioo (0 : ℝ≥0) (1 / 100) ∈ 𝓝[>] (0 : ℝ≥0) :=
    Ioo_mem_nhdsGT (by norm_num)
  filter_upwards [hmem] with δ hδ
  refine hprof δ hδ.1 ?_
  have h2 : (δ : ℝ) < ((1 / 100 : ℝ≥0) : ℝ) := by exact_mod_cast hδ.2
  push_cast at h2
  linarith

/-- The same conclusion in the normalized form printed in BRS. -/
theorem legendreAssouad_condition_of_hasRadialStrongType {d : ℕ} (hd : 0 < d)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q : ℝ}
    (hp : 0 < p) (hq2 : 2 ≤ q)
    (h : HasRadialStrongType d E (ENNReal.ofReal p) (ENNReal.ofReal q)) :
    (1 / q) * _root_.Auto.Spherical.BRRS.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) + 1 / p - 1 / q ≤ ((d : ℝ) - 1) / 2 := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (by norm_num) hq2
  have hle := legendreAssouad_le_of_hasRadialStrongType hd hE hEne hp hq2 h
  have hmul : (1 / q) *
      _root_.Auto.Spherical.BRRS.brrsLegendreAssouadFunction E
        (((d : ℝ) - 1) * (q / 2 - 1)) ≤
      (1 / q) * (q * ((d : ℝ) - 1) / 2 + 1 - q / p) :=
    mul_le_mul_of_nonneg_left hle (by positivity)
  have hsimp : (1 / q) * (q * ((d : ℝ) - 1) / 2 + 1 - q / p) =
      ((d : ℝ) - 1) / 2 + 1 / q - 1 / p := by
    field_simp
  rw [hsimp] at hmul
  linarith [hmul]

/-! ## The planar kernel, split at the two endpoint singularities

For `d = 2` the kernel `K_t(r,s) = s / (√((r+t)²-s²) √(s²-(r-t)²))` has an
inverse square-root singularity at each endpoint of the window.  On the half
of the window nearest `|r-t|` only the left singularity is active, and on the
other half only the right one; this is the source of the operators `𝔐_p^±` of
BRS Lemma 5.1. -/

/-- The distance from the window endpoints to its midpoint is `min r t`. -/
theorem window_half_width (r t : ℝ) : r + t - |r - t| = 2 * min r t := by
  rcases le_total r t with h | h
  · rw [abs_of_nonpos (by linarith), min_eq_left h]
    ring
  · rw [abs_of_nonneg (by linarith), min_eq_right h]
    ring

/-- **The planar kernel near the left endpoint.** -/
theorem brsKernelTwo_le_left {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| ≤ s) (hs2 : 2 * s ≤ |r - t| + (r + t)) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) * (Real.sqrt s / Real.sqrt (s - |r - t|)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have htpos : 0 < t := by linarith
  have hmin : r / 2 ≤ min r t := by
    rcases le_total r t with h | h
    · rw [min_eq_left h]
      linarith
    · rw [min_eq_right h]
      linarith
  have hleft : r / 2 ≤ r + t - s := by
    have hw := window_half_width r t
    have : 2 * s ≤ 2 * (r + t) - 2 * min r t := by
      rw [show 2 * (r + t) - 2 * min r t = (r + t) + (r + t - 2 * min r t) by ring,
        ← hw]
      linarith
    linarith [hmin]
  have hsum : 3 * r / 2 ≤ r + t + s := by linarith
  -- factor the two square roots
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  -- lower bounds for the harmless factors
  have hrootA : Real.sqrt (r / 2) ≤ Real.sqrt (r + t - s) :=
    Real.sqrt_le_sqrt hleft
  have hrootB : Real.sqrt (3 * r / 2) ≤ Real.sqrt (r + t + s) :=
    Real.sqrt_le_sqrt hsum
  have hrootC : Real.sqrt s ≤ Real.sqrt (s + |r - t|) :=
    Real.sqrt_le_sqrt (by linarith)
  have hprod : Real.sqrt (r / 2) * Real.sqrt (3 * r / 2) = Real.sqrt 3 * r / 2 := by
    rw [← Real.sqrt_mul (by linarith)]
    rw [show r / 2 * (3 * r / 2) = 3 * (r / 2) ^ 2 by ring,
      Real.sqrt_mul (by norm_num), Real.sqrt_sq (by linarith)]
    ring
  rcases eq_or_lt_of_le hs1 with hEq | hlt
  · -- at the left endpoint both sides vanish
    have hz : s - |r - t| = 0 := by linarith [hEq]
    rw [brsKernelTwo, hfacB, hz, Real.sqrt_zero]
    simp
  · have hpos : 0 < s - |r - t| := by linarith
    have hspos : 0 < s := lt_of_le_of_lt habs hlt
    have hrootpos : 0 < Real.sqrt (s - |r - t|) := Real.sqrt_pos.mpr hpos
    have hsrootpos : 0 < Real.sqrt s := Real.sqrt_pos.mpr hspos
    have hAB : Real.sqrt 3 * r / 2 * (Real.sqrt (s - |r - t|) * Real.sqrt s) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      rw [hfacA, hfacB, ← hprod]
      gcongr
    have hdenpos : 0 < Real.sqrt 3 * r / 2 *
        (Real.sqrt (s - |r - t|) * Real.sqrt s) := by
      have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
      positivity
    have hDpos : 0 < Real.sqrt ((r + t) ^ 2 - s ^ 2) *
        Real.sqrt (s ^ 2 - (r - t) ^ 2) := lt_of_lt_of_le hdenpos hAB
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    have hrewrite : 2 / (Real.sqrt 3 * r) *
        (Real.sqrt s / Real.sqrt (s - |r - t|)) =
        (2 * Real.sqrt s) / (Real.sqrt 3 * r * Real.sqrt (s - |r - t|)) := by
      field_simp
    rw [brsKernelTwo, hrewrite, div_le_div_iff₀ hDpos (by positivity)]
    have hssqrt : Real.sqrt s * Real.sqrt s = s := Real.mul_self_sqrt hs0
    calc s * (Real.sqrt 3 * r * Real.sqrt (s - |r - t|))
        = (Real.sqrt 3 * r / 2 * (Real.sqrt (s - |r - t|) * Real.sqrt s)) *
            (2 * Real.sqrt s) := by
          rw [show (Real.sqrt 3 * r / 2 *
              (Real.sqrt (s - |r - t|) * Real.sqrt s)) * (2 * Real.sqrt s) =
            Real.sqrt 3 * r * Real.sqrt (s - |r - t|) *
              (Real.sqrt s * Real.sqrt s) by ring, hssqrt]
          ring
      _ ≤ (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) * (2 * Real.sqrt s) := by
          refine mul_le_mul_of_nonneg_right hAB ?_
          positivity
      _ = 2 * Real.sqrt s * (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) := by ring

/-- **The planar kernel near the right endpoint.** -/
theorem brsKernelTwo_le_right {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| + (r + t) ≤ 2 * s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) * (Real.sqrt s / Real.sqrt (r + t - s)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have htpos : 0 < t := by linarith
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hmin : r / 2 ≤ min r t := by
    rcases le_total r t with h | h
    · rw [min_eq_left h]
      linarith
    · rw [min_eq_right h]
      linarith
  have hright : r / 2 ≤ s - |r - t| := by
    have hw := window_half_width r t
    have h2 : 2 * min r t ≤ 2 * s - 2 * |r - t| := by
      rw [← hw]
      linarith
    linarith [hmin]
  have hsum : 3 * r / 2 ≤ r + t + s := by
    have : (0 : ℝ) ≤ s := hs0
    linarith
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  have hprod : Real.sqrt (3 * r / 2) * Real.sqrt (r / 2) = Real.sqrt 3 * r / 2 := by
    rw [← Real.sqrt_mul (by linarith)]
    rw [show 3 * r / 2 * (r / 2) = 3 * (r / 2) ^ 2 by ring,
      Real.sqrt_mul (by norm_num), Real.sqrt_sq (by linarith)]
    ring
  rcases eq_or_lt_of_le hs2 with hEq | hlt
  · have hz : r + t - s = 0 := by linarith [hEq]
    rw [brsKernelTwo, hfacA, hz, Real.sqrt_zero]
    simp
  · have hpos : 0 < r + t - s := by linarith
    have hspos : 0 < s := by
      have : r / 2 ≤ s - |r - t| := hright
      linarith
    have hrootpos : 0 < Real.sqrt (r + t - s) := Real.sqrt_pos.mpr hpos
    have hAB : Real.sqrt 3 * r / 2 * (Real.sqrt (r + t - s) * Real.sqrt s) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      have hstep : Real.sqrt (r + t - s) * Real.sqrt (3 * r / 2) *
          (Real.sqrt (r / 2) * Real.sqrt s) ≤
          Real.sqrt (r + t - s) * Real.sqrt (r + t + s) *
            (Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|)) := by
        gcongr
        linarith
      rw [hfacA, hfacB]
      refine le_trans (le_of_eq ?_) hstep
      rw [← hprod]
      ring
    have hdenpos : 0 < Real.sqrt 3 * r / 2 *
        (Real.sqrt (r + t - s) * Real.sqrt s) := by
      have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
      have h4 : (0 : ℝ) < Real.sqrt s := Real.sqrt_pos.mpr hspos
      positivity
    have hDpos : 0 < Real.sqrt ((r + t) ^ 2 - s ^ 2) *
        Real.sqrt (s ^ 2 - (r - t) ^ 2) := lt_of_lt_of_le hdenpos hAB
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    have hrewrite : 2 / (Real.sqrt 3 * r) *
        (Real.sqrt s / Real.sqrt (r + t - s)) =
        (2 * Real.sqrt s) / (Real.sqrt 3 * r * Real.sqrt (r + t - s)) := by
      field_simp
    rw [brsKernelTwo, hrewrite, div_le_div_iff₀ hDpos (by positivity)]
    have hssqrt : Real.sqrt s * Real.sqrt s = s := Real.mul_self_sqrt hs0
    calc s * (Real.sqrt 3 * r * Real.sqrt (r + t - s))
        = (Real.sqrt 3 * r / 2 * (Real.sqrt (r + t - s) * Real.sqrt s)) *
            (2 * Real.sqrt s) := by
          rw [show (Real.sqrt 3 * r / 2 *
              (Real.sqrt (r + t - s) * Real.sqrt s)) * (2 * Real.sqrt s) =
            Real.sqrt 3 * r * Real.sqrt (r + t - s) *
              (Real.sqrt s * Real.sqrt s) by ring, hssqrt]
          ring
      _ ≤ (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) * (2 * Real.sqrt s) := by
          refine mul_le_mul_of_nonneg_right hAB ?_
          positivity
      _ = 2 * Real.sqrt s * (Real.sqrt ((r + t) ^ 2 - s ^ 2) *
            Real.sqrt (s ^ 2 - (r - t) ^ 2)) := by ring

/-! ## The operators of BRS Lemma 5.1

In the plane the two endpoint singularities of the kernel are separated into
two maximal operators `𝔐_p^±`, and the dilations away from the radius give the
two remainders `R_1^±`, `R_2^±`. -/

/-- The main term `𝔐_p^-` of BRS (5.1): the left endpoint singularity. -/
def brsMainTwoLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)

/-- The main term `𝔐_p^+` of BRS (5.1): the right endpoint singularity. -/
def brsMainTwoRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
      ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)

/-- The integrand of `𝔐_p^-` applied to the substituted profile is the planar
kernel weight `√s (s - |r-t|)^{-1/2}` against the profile itself. -/
theorem brsMainTwoLeft_integrand {p : ℝ} (_hp : 0 < p) (f₀ : ℝ → ℂ) {r t s : ℝ}
    (hs : 0 < s) :
    ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        brsProfileSub 2 p f₀ s =
      ((s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
  rw [brsProfileSub]
  have hcast : ((2 : ℕ) : ℝ) - 1 = 1 := by norm_num
  rw [hcast]
  have hmul : (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
      s ^ (1 / p) = s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
    rw [show s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) * s ^ (1 / p) =
        (s ^ (1 / 2 - 1 / p) * s ^ (1 / p)) *
          (s - |r - t|) ^ (-(1 / 2) : ℝ) by ring,
      ← Real.rpow_add hs]
    congr 2
    ring
  calc ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        (((s ^ (1 / p) : ℝ) : ℂ) * f₀ s)
      = ((s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ) *
          s ^ (1 / p) : ℝ) : ℂ) * f₀ s := by
        push_cast
        ring
    _ = ((s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
        rw [hmul]

/-- The same identity for the right endpoint. -/
theorem brsMainTwoRight_integrand {p : ℝ} (_hp : 0 < p) (f₀ : ℝ → ℂ) {r t s : ℝ}
    (hs : 0 < s) :
    ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        brsProfileSub 2 p f₀ s =
      ((s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
  rw [brsProfileSub]
  have hcast : ((2 : ℕ) : ℝ) - 1 = 1 := by norm_num
  rw [hcast]
  have hmul : (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
      s ^ (1 / p) = s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
    rw [show s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) * s ^ (1 / p) =
        (s ^ (1 / 2 - 1 / p) * s ^ (1 / p)) *
          (r + t - s) ^ (-(1 / 2) : ℝ) by ring,
      ← Real.rpow_add hs]
    congr 2
    ring
  calc ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        (((s ^ (1 / p) : ℝ) : ℂ) * f₀ s)
      = ((s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ) *
          s ^ (1 / p) : ℝ) : ℂ) * f₀ s := by
        push_cast
        ring
    _ = ((s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s := by
        rw [hmul]

/-- The planar kernel is dominated by the two half-window weights. -/
theorem brsKernelTwo_le_sum {r t s : ℝ} (hr : 0 < r) (ht1 : r / 2 < t)
    (hs1 : |r - t| ≤ s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤
      2 / (Real.sqrt 3 * r) *
        (s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) +
          s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ)) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have hsqrt : Real.sqrt s = s ^ (1 / 2 : ℝ) := Real.sqrt_eq_rpow s
  have hleftw : Real.sqrt s / Real.sqrt (s - |r - t|) =
      s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
    rw [hsqrt, Real.sqrt_eq_rpow, div_eq_mul_inv,
      ← Real.rpow_neg_one ((s - |r - t|) ^ (1 / 2 : ℝ)),
      ← Real.rpow_mul (by linarith : (0:ℝ) ≤ s - |r - t|)]
    congr 2
    ring
  have hrightw : Real.sqrt s / Real.sqrt (r + t - s) =
      s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
    rw [hsqrt, Real.sqrt_eq_rpow, div_eq_mul_inv,
      ← Real.rpow_neg_one ((r + t - s) ^ (1 / 2 : ℝ)),
      ← Real.rpow_mul (by linarith : (0:ℝ) ≤ r + t - s)]
    congr 2
    ring
  have hconst : (0 : ℝ) < 2 / (Real.sqrt 3 * r) := by
    have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
    positivity
  rcases le_total (2 * s) (|r - t| + (r + t)) with hcase | hcase
  · refine le_trans (brsKernelTwo_le_left hr ht1 hs1 hcase) ?_
    rw [hleftw]
    refine mul_le_mul_of_nonneg_left ?_ hconst.le
    have hnn : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) := by
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    linarith
  · refine le_trans (brsKernelTwo_le_right hr ht1 hcase hs2) ?_
    rw [hrightw]
    refine mul_le_mul_of_nonneg_left ?_ hconst.le
    have hnn : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) := by
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith) _
      exact mul_nonneg h1 h2
    linarith

/-- **The planar kernel, with the two harmless factors bounded below.** -/
theorem brsKernelTwo_le_generic {r t s P Q : ℝ} (hs1 : |r - t| ≤ s)
    (hs2 : s ≤ r + t) (hP : 0 < P) (hQ : 0 < Q) (hPle : P ≤ r + t + s)
    (hQle : Q ≤ s + |r - t|) :
    brsKernelTwo t r s ≤
      s / (Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|))) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have hs0 : (0 : ℝ) ≤ s := le_trans habs hs1
  have hA : (r + t) ^ 2 - s ^ 2 = (r + t - s) * (r + t + s) := by ring
  have hB : s ^ 2 - (r - t) ^ 2 = (s - |r - t|) * (s + |r - t|) := by
    rw [show (r - t) ^ 2 = |r - t| ^ 2 by rw [sq_abs]]
    ring
  have hfacA : Real.sqrt ((r + t) ^ 2 - s ^ 2) =
      Real.sqrt (r + t - s) * Real.sqrt (r + t + s) := by
    rw [hA, Real.sqrt_mul (by linarith)]
  have hfacB : Real.sqrt (s ^ 2 - (r - t) ^ 2) =
      Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|) := by
    rw [hB, Real.sqrt_mul (by linarith)]
  have hrootP : Real.sqrt P ≤ Real.sqrt (r + t + s) := Real.sqrt_le_sqrt hPle
  have hrootQ : Real.sqrt Q ≤ Real.sqrt (s + |r - t|) := Real.sqrt_le_sqrt hQle
  have hPpos : 0 < Real.sqrt P := Real.sqrt_pos.mpr hP
  have hQpos : 0 < Real.sqrt Q := Real.sqrt_pos.mpr hQ
  by_cases hdeg : Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|) = 0
  · rcases mul_eq_zero.mp hdeg with h | h
    · rw [brsKernelTwo, hfacA, h]
      simp
    · rw [brsKernelTwo, hfacB, h]
      simp
  · have hpos : 0 < Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|) := by
      rcases lt_or_eq_of_le (mul_nonneg (Real.sqrt_nonneg (r + t - s))
        (Real.sqrt_nonneg (s - |r - t|))) with h | h
      · exact h
      · exact absurd h.symm hdeg
    have hden : 0 < Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|)) := by positivity
    have hcompare : Real.sqrt P * Real.sqrt Q *
        (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|)) ≤
        Real.sqrt ((r + t) ^ 2 - s ^ 2) * Real.sqrt (s ^ 2 - (r - t) ^ 2) := by
      rw [hfacA, hfacB]
      calc Real.sqrt P * Real.sqrt Q *
            (Real.sqrt (r + t - s) * Real.sqrt (s - |r - t|))
          = Real.sqrt (r + t - s) * Real.sqrt P *
              (Real.sqrt (s - |r - t|) * Real.sqrt Q) := by ring
        _ ≤ Real.sqrt (r + t - s) * Real.sqrt (r + t + s) *
              (Real.sqrt (s - |r - t|) * Real.sqrt (s + |r - t|)) := by gcongr
    rw [brsKernelTwo]
    exact div_le_div_of_nonneg_left hs0 hden hcompare

/-- Dividing out one of the two singular factors. -/
theorem kernel_div_step {K s c A D C : ℝ} (hK : K ≤ s / (c * (A * D)))
    (hc : 0 < c) (hApos : 0 < A) (hD : 0 ≤ D) (hs : s ≤ C * c) :
    K ≤ C * A⁻¹ * D⁻¹ := by
  by_cases hDz : D = 0
  · rw [hDz] at hK ⊢
    simpa using hK
  · have hDpos : 0 < D := lt_of_le_of_ne hD (Ne.symm hDz)
    refine le_trans hK ?_
    rw [div_le_iff₀ (by positivity)]
    calc s ≤ C * c := hs
      _ = C * A⁻¹ * D⁻¹ * (c * (A * D)) := by
          field_simp

/-- Swapping one singular factor for a lower bound. -/
theorem kernel_swap_step {s c A A' D : ℝ} (hs0 : 0 ≤ s) (hc : 0 < c)
    (hApos : 0 < A) (hAA : A ≤ A') (hD : 0 ≤ D) :
    s / (c * (A' * D)) ≤ s / (c * (A * D)) := by
  by_cases hz : D = 0
  · rw [hz]
    simp
  · have hDpos : 0 < D := lt_of_le_of_ne hD (Ne.symm hz)
    refine div_le_div_of_nonneg_left hs0 (by positivity) ?_
    have hmono : A * D ≤ A' * D := mul_le_mul_of_nonneg_right hAA hD
    exact mul_le_mul_of_nonneg_left hmono hc.le

/-- **The planar kernel for small dilations, left half.** -/
theorem brsKernelTwo_le_small_left {r t s : ℝ} (hr : 0 < r) (ht : 0 < t)
    (htr : t ≤ r / 2) (hs1 : r - t ≤ s) (hs2 : s ≤ r) :
    brsKernelTwo t r s ≤ 1 * (Real.sqrt t)⁻¹ * (Real.sqrt (s - (r - t)))⁻¹ := by
  have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := r) (Q := r) (by rw [habs]; linarith) (by linarith) hr hr
    (by linarith) (by rw [habs]; linarith)
  rw [habs, Real.mul_self_sqrt hr.le] at hgen
  have hswap := kernel_swap_step (s := s) (c := r) (A := Real.sqrt t)
    (A' := Real.sqrt (r + t - s)) (D := Real.sqrt (s - (r - t))) hs0 hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := r) (A := Real.sqrt t)
    (D := Real.sqrt (s - (r - t))) (C := 1) (le_trans hgen hswap) hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for small dilations, right half.** -/
theorem brsKernelTwo_le_small_right {r t s : ℝ} (hr : 0 < r) (ht : 0 < t)
    (htr : t ≤ r / 2) (hs1 : r ≤ s) (hs2 : s ≤ r + t) :
    brsKernelTwo t r s ≤ 2 * (Real.sqrt t)⁻¹ * (Real.sqrt (r + t - s))⁻¹ := by
  have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := r) (Q := r) (by rw [habs]; linarith) (by linarith) hr hr
    (by linarith) (by rw [habs]; linarith)
  rw [habs, Real.mul_self_sqrt hr.le] at hgen
  -- reorder the two singular factors
  have hcomm : s / (r * (Real.sqrt (r + t - s) * Real.sqrt (s - (r - t)))) =
      s / (r * (Real.sqrt (s - (r - t)) * Real.sqrt (r + t - s))) := by
    rw [mul_comm (Real.sqrt (r + t - s)) (Real.sqrt (s - (r - t)))]
  rw [hcomm] at hgen
  have hswap := kernel_swap_step (s := s) (c := r) (A := Real.sqrt t)
    (A' := Real.sqrt (s - (r - t))) (D := Real.sqrt (r + t - s)) hs0 hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := r) (A := Real.sqrt t)
    (D := Real.sqrt (r + t - s)) (C := 2) (le_trans hgen hswap) hr
    (Real.sqrt_pos.mpr ht) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for large dilations, left half.** -/
theorem brsKernelTwo_le_large_left {r t s : ℝ} (hr : 0 < r) (htr : 3 * r / 2 ≤ t)
    (hs1 : t - r ≤ s) (hs2 : s ≤ t) :
    brsKernelTwo t r s ≤ 2 * (Real.sqrt r)⁻¹ * (Real.sqrt (s - (t - r)))⁻¹ := by
  have htpos : 0 < t := by linarith
  have habs : |r - t| = t - r := by
    rw [abs_of_nonpos (by linarith)]
    ring
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := t) (Q := t / 4) (by rw [habs]; linarith) (by linarith) htpos
    (by linarith) (by linarith) (by rw [habs]; linarith)
  rw [habs] at hgen
  have hprod : Real.sqrt t * Real.sqrt (t / 4) = t / 2 := by
    rw [← Real.sqrt_mul htpos.le]
    rw [show t * (t / 4) = (t / 2) ^ 2 by ring, Real.sqrt_sq (by linarith)]
  rw [hprod] at hgen
  have hswap := kernel_swap_step (s := s) (c := t / 2) (A := Real.sqrt r)
    (A' := Real.sqrt (r + t - s)) (D := Real.sqrt (s - (t - r))) hs0 (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := t / 2) (A := Real.sqrt r)
    (D := Real.sqrt (s - (t - r))) (C := 2) (le_trans hgen hswap) (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_nonneg _) (by linarith)

/-- **The planar kernel for large dilations, right half.** -/
theorem brsKernelTwo_le_large_right {r t s : ℝ} (hr : 0 < r)
    (htr : 3 * r / 2 ≤ t) (hs1 : t ≤ s) (hs2 : s ≤ t + r) :
    brsKernelTwo t r s ≤ 4 * (Real.sqrt r)⁻¹ * (Real.sqrt (r + t - s))⁻¹ := by
  have htpos : 0 < t := by linarith
  have habs : |r - t| = t - r := by
    rw [abs_of_nonpos (by linarith)]
    ring
  have hs0 : (0 : ℝ) ≤ s := by linarith
  have hgen := brsKernelTwo_le_generic (r := r) (t := t) (s := s)
    (P := t) (Q := t / 4) (by rw [habs]; linarith) (by linarith) htpos
    (by linarith) (by linarith) (by rw [habs]; linarith)
  rw [habs] at hgen
  have hprod : Real.sqrt t * Real.sqrt (t / 4) = t / 2 := by
    rw [← Real.sqrt_mul htpos.le]
    rw [show t * (t / 4) = (t / 2) ^ 2 by ring, Real.sqrt_sq (by linarith)]
  rw [hprod] at hgen
  have hcomm : s / (t / 2 * (Real.sqrt (r + t - s) * Real.sqrt (s - (t - r)))) =
      s / (t / 2 * (Real.sqrt (s - (t - r)) * Real.sqrt (r + t - s))) := by
    rw [mul_comm (Real.sqrt (r + t - s)) (Real.sqrt (s - (t - r)))]
  rw [hcomm] at hgen
  have hswap := kernel_swap_step (s := s) (c := t / 2) (A := Real.sqrt r)
    (A' := Real.sqrt (s - (t - r))) (D := Real.sqrt (r + t - s)) hs0 (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_le_sqrt (by linarith)) (Real.sqrt_nonneg _)
  refine kernel_div_step (c := t / 2) (A := Real.sqrt r)
    (D := Real.sqrt (r + t - s)) (C := 4) (le_trans hgen hswap) (by linarith)
    (Real.sqrt_pos.mpr hr) (Real.sqrt_nonneg _) (by linarith)

/-- The planar radial spherical average as a kernel integral over the window. -/
theorem sphericalAverage_two_eq_kernel_integral {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {x : Euclidean 2} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
      (((surfaceMass 2)⁻¹ * surfaceMass 1 : ℝ) : ℂ) *
        ∫ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
          (2 * brsKernelTwo t ‖x‖ s) • f₀ s := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hangle := sphericalAverage_comp_norm_two f₀ hf₀ hx t
  rw [hangle]
  congr 1
  have hpi : (0 : ℝ) ≤ Real.pi := Real.pi_pos.le
  have hset : (∫ φ in (0 : ℝ)..Real.pi,
      f₀ (Real.sqrt (‖x‖ ^ 2 + t ^ 2 + 2 * ‖x‖ * t * Real.cos φ))) =
      ∫ φ in Ioo (0 : ℝ) Real.pi, f₀ (cosineRadius ‖x‖ t φ) := by
    rw [intervalIntegral.integral_of_le hpi, ← integral_Ioc_eq_integral_Ioo]
    rfl
  rw [hset, ← integral_kernelTwo_eq_angle hr ht f₀]

/-- **The planar kernel bound for the spherical average.** -/
theorem ofReal_norm_sphericalAverage_two_le {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {x : Euclidean 2} (hx : x ≠ 0) {t : ℝ} (ht : 0 < t) :
    ENNReal.ofReal ‖_root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x‖ ≤
      ENNReal.ofReal ((surfaceMass 2)⁻¹ * surfaceMass 1) *
        ∫⁻ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
          ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖) := by
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hmass2 : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  have hc : (0 : ℝ) ≤ (surfaceMass 2)⁻¹ * surfaceMass 1 := by positivity
  rw [sphericalAverage_two_eq_kernel_integral hf₀ hx ht, norm_mul,
    Complex.norm_real, Real.norm_of_nonneg hc,
    ENNReal.ofReal_mul hc]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (le_of_eq (ofReal_norm _)) ?_
  refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
  refine setLIntegral_congr_fun measurableSet_Ioo fun s hs => ?_
  have hs0 : 0 ≤ s := le_trans (abs_nonneg _) (le_of_lt hs.1)
  have hker : 0 ≤ brsKernelTwo t ‖x‖ s := by
    rw [brsKernelTwo]
    exact div_nonneg hs0 (mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _))
  rw [← ofReal_norm ((2 * brsKernelTwo t ‖x‖ s) • f₀ s), norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (by linarith : (0:ℝ) ≤ 2 * brsKernelTwo t ‖x‖ s)]

/-- The inverse square-root singularity at the left endpoint is integrable. -/
theorem intervalIntegrable_left_weight (a b : ℝ) :
    IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ)) volume a b := by
  have hbase := intervalIntegral.intervalIntegrable_rpow'
    (a := a - a) (b := b - a) (r := (-(1 / 2) : ℝ)) (by norm_num)
  have hshift := hbase.comp_sub_right a
  simpa using hshift

/-- The inverse square-root singularity at the right endpoint is integrable. -/
theorem intervalIntegrable_right_weight (a b : ℝ) :
    IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ)) volume a b := by
  have hbase := intervalIntegral.intervalIntegrable_rpow'
    (a := b - a) (b := b - b) (r := (-(1 / 2) : ℝ)) (by norm_num)
  have hrefl := hbase.comp_sub_left b
  simpa using hrefl

/-- The `𝔐_p^-` integrand is interval integrable. -/
theorem intervalIntegrable_weight_left_mul {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable
      (fun s => (s - a) ^ (-(1 / 2) : ℝ) * (s ^ (1 / 2 : ℝ) * ‖f₀ s‖))
      volume a b :=
  (intervalIntegrable_left_weight a b).mul_continuousOn
    (((continuous_rpow_const_of_nonneg (by norm_num : (0:ℝ) ≤ 1 / 2)).mul
      hf₀.norm).continuousOn)

/-- The `𝔐_p^+` integrand is interval integrable. -/
theorem intervalIntegrable_weight_right_mul {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable
      (fun s => (b - s) ^ (-(1 / 2) : ℝ) * (s ^ (1 / 2 : ℝ) * ‖f₀ s‖))
      volume a b :=
  (intervalIntegrable_right_weight a b).mul_continuousOn
    (((continuous_rpow_const_of_nonneg (by norm_num : (0:ℝ) ≤ 1 / 2)).mul
      hf₀.norm).continuousOn)

/-- The `R_1^±` and `R_2^±` integrands are interval integrable. -/
theorem intervalIntegrable_weight_left_profile {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) volume a b :=
  (intervalIntegrable_left_weight a b).mul_continuousOn hf₀.norm.continuousOn

theorem intervalIntegrable_weight_right_profile {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (a b : ℝ) :
    IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) volume a b :=
  (intervalIntegrable_right_weight a b).mul_continuousOn hf₀.norm.continuousOn

/-- A nonnegative interval integral, as a lower Lebesgue integral over the open
window. -/
theorem lintegral_Ioo_eq_ofReal_intervalIntegral {F : ℝ → ℝ} {a b : ℝ}
    (hab : a ≤ b) (hint : IntervalIntegrable F volume a b)
    (hnn : ∀ s ∈ Ioo a b, 0 ≤ F s) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (F s)) =
      ENNReal.ofReal (∫ s in a..b, F s) := by
  have hIoc : IntegrableOn F (Ioc a b) volume := by
    rw [← intervalIntegrable_iff_integrableOn_Ioc_of_le hab]
    exact hint
  have hIoo : IntegrableOn F (Ioo a b) volume :=
    hIoc.mono_set Ioo_subset_Ioc_self
  have hae : 0 ≤ᵐ[volume.restrict (Ioo a b)] F := by
    refine (ae_restrict_iff' measurableSet_Ioo).mpr ?_
    filter_upwards with s hs
    exact hnn s hs
  rw [intervalIntegral.integral_of_le hab, integral_Ioc_eq_integral_Ioo,
    MeasureTheory.ofReal_integral_eq_lintegral_ofReal hIoo hae]

/-- **The main range of BRS Lemma 5.1.**  For dilations comparable to the
radius the window integral is controlled by the two main terms. -/
theorem lintegral_window_le_mainTwo {p : ℝ} (hp : 0 < p) {E : Set ℝ} {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (ht1 : r / 2 < t) (ht2 : t < 3 * r / 2) :
    (∫⁻ s in Ioo (|r - t|) (r + t),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal (4 / Real.sqrt 3) *
        (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
          brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r) := by
  have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
  have htpos : 0 < t := by linarith
  have hab : |r - t| ≤ r + t := by
    rw [abs_le]
    constructor <;> linarith
  have h3 : (0 : ℝ) < Real.sqrt 3 := Real.sqrt_pos.mpr (by norm_num)
  set c : ℝ := 4 / (Real.sqrt 3 * r) with hc
  have hcpos : 0 < c := by
    rw [hc]
    positivity
  set W₁ : ℝ → ℝ := fun s => s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ)
    with hW₁
  set W₂ : ℝ → ℝ := fun s => s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ)
    with hW₂
  have hW₁nn : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ W₁ s := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₁]
    exact mul_nonneg (Real.rpow_nonneg hs0 _)
      (Real.rpow_nonneg (by linarith [hs.1]) _)
  have hW₂nn : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ W₂ s := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₂]
    exact mul_nonneg (Real.rpow_nonneg hs0 _)
      (Real.rpow_nonneg (by linarith [hs.2]) _)
  -- the pointwise kernel bound
  have hpoint : ∀ s ∈ Ioo (|r - t|) (r + t),
      ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖) ≤
        ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) +
          ENNReal.ofReal (c * (W₂ s * ‖f₀ s‖)) := by
    intro s hs
    have hker := brsKernelTwo_le_sum hr ht1 (le_of_lt hs.1) (le_of_lt hs.2)
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    have h1nn : 0 ≤ W₁ s := hW₁nn s hs
    have h2nn : 0 ≤ W₂ s := hW₂nn s hs
    have h2K : 2 * brsKernelTwo t r s ≤ c * (W₁ s + W₂ s) := by
      have hmul := mul_le_mul_of_nonneg_left hker (by norm_num : (0:ℝ) ≤ 2)
      calc 2 * brsKernelTwo t r s
          ≤ 2 * (2 / (Real.sqrt 3 * r) *
              (s ^ (1 / 2 : ℝ) * (s - |r - t|) ^ (-(1 / 2) : ℝ) +
                s ^ (1 / 2 : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ))) := hmul
        _ = c * (W₁ s + W₂ s) := by
            rw [hc, hW₁, hW₂]
            ring
    have hstep : 2 * brsKernelTwo t r s * ‖f₀ s‖ ≤
        c * (W₁ s * ‖f₀ s‖) + c * (W₂ s * ‖f₀ s‖) := by
      calc 2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ (c * (W₁ s + W₂ s)) * ‖f₀ s‖ :=
            mul_le_mul_of_nonneg_right h2K hfn
        _ = c * (W₁ s * ‖f₀ s‖) + c * (W₂ s * ‖f₀ s‖) := by ring
    refine le_trans (ENNReal.ofReal_le_ofReal hstep) (le_of_eq ?_)
    rw [ENNReal.ofReal_add (mul_nonneg hcpos.le (mul_nonneg h1nn hfn))
      (mul_nonneg hcpos.le (mul_nonneg h2nn hfn))]
  have hmono : (∫⁻ s in Ioo (|r - t|) (r + t),
      ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ∫⁻ s in Ioo (|r - t|) (r + t),
        (ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) +
          ENNReal.ofReal (c * (W₂ s * ‖f₀ s‖))) := by
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ioo] with s hs
    exact hpoint s hs
  refine le_trans hmono ?_
  -- split the two pieces
  have hmeas₁ : Measurable fun s : ℝ => ENNReal.ofReal (c * (W₁ s * ‖f₀ s‖)) := by
    refine ENNReal.measurable_ofReal.comp ?_
    rw [hW₁]
    exact measurable_const.mul (((by fun_prop : Measurable fun s : ℝ =>
      s ^ (1 / 2 : ℝ)).mul
      (by fun_prop : Measurable fun s : ℝ =>
        (s - |r - t|) ^ (-(1 / 2) : ℝ))).mul hf₀.norm.measurable)
  rw [lintegral_add_left' hmeas₁.aemeasurable]
  -- each piece is an interval integral
  have hint₁ : IntervalIntegrable (fun s => c * (W₁ s * ‖f₀ s‖)) volume
      (|r - t|) (r + t) := by
    rw [hW₁]
    exact ((intervalIntegrable_weight_left_mul hf₀ (|r - t|) (r + t)).congr
      (fun s _ => by ring)).const_mul c
  have hint₂ : IntervalIntegrable (fun s => c * (W₂ s * ‖f₀ s‖)) volume
      (|r - t|) (r + t) := by
    rw [hW₂]
    exact ((intervalIntegrable_weight_right_mul hf₀ (|r - t|) (r + t)).congr
      (fun s _ => by ring)).const_mul c
  have hnn₁ : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ c * (W₁ s * ‖f₀ s‖) := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₁]
    have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
    have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.1]) _
    have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hnn₂ : ∀ s ∈ Ioo (|r - t|) (r + t), 0 ≤ c * (W₂ s * ‖f₀ s‖) := by
    intro s hs
    have hs0 : (0 : ℝ) ≤ s := le_trans habs (le_of_lt hs.1)
    rw [hW₂]
    have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
    have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.2]) _
    have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  rw [lintegral_Ioo_eq_ofReal_intervalIntegral hab hint₁ hnn₁,
    lintegral_Ioo_eq_ofReal_intervalIntegral hab hint₂ hnn₂]
  -- compare with the two operators
  have hmemt : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  have hcr : c * r = 4 / Real.sqrt 3 := by
    rw [hc]
    field_simp
  have hpiece : ∀ (W : ℝ → ℝ) (Wop : ℝ → ℝ)
      (hWeq : ∀ s : ℝ, 0 < s → ((Wop s : ℝ) : ℂ) *
        brsProfileSub 2 p (absProfile f₀) s = ((W s : ℝ) : ℂ) * absProfile f₀ s)
      (hWnn : ∀ s ∈ Icc (|r - t|) (r + t), 0 ≤ W s * ‖f₀ s‖)
      (Mop : ENNReal)
      (hMop : ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s‖) ≤ Mop),
      ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W s * ‖f₀ s‖)) ≤
        ENNReal.ofReal (4 / Real.sqrt 3) * Mop := by
    intro W Wop hWeq hWnn Mop hMop
    have hcongr : (∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s) =
        ((∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ : ℝ) : ℂ) := by
      rw [← intervalIntegral.integral_ofReal]
      refine intervalIntegral.integral_congr_ae
        (Filter.Eventually.of_forall fun s hs => ?_)
      have hmin : (0 : ℝ) ≤ min (|r - t|) (r + t) := le_min habs (by linarith)
      have hs0 : 0 < s := lt_of_le_of_lt hmin (Set.mem_Ioc.mp hs).1
      rw [hWeq s hs0, absProfile]
      push_cast
      ring
    have hnorm : ‖∫ s in |r - t|..(r + t),
        ((Wop s : ℝ) : ℂ) * brsProfileSub 2 p (absProfile f₀) s‖ =
        ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ := by
      rw [hcongr, Complex.norm_real,
        Real.norm_of_nonneg (intervalIntegral.integral_nonneg hab hWnn)]
    rw [hnorm] at hMop
    have hconst : (∫ s in |r - t|..(r + t), c * (W s * ‖f₀ s‖)) =
        c * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ := by
      rw [intervalIntegral.integral_const_mul]
    rw [hconst]
    have hsplit : c * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖ =
        (4 / Real.sqrt 3) * (r⁻¹ * ∫ s in |r - t|..(r + t), W s * ‖f₀ s‖) := by
      rw [← hcr]
      field_simp
    rw [hsplit, ENNReal.ofReal_mul (by positivity)]
    exact mul_le_mul' le_rfl hMop
  have hleft := hpiece W₁ (fun s => s ^ (1 / 2 - 1 / p) *
      (s - |r - t|) ^ (-(1 / 2) : ℝ))
    (fun s hs => brsMainTwoLeft_integrand hp (absProfile f₀) hs)
    (fun s hs => by
      have hs0 : (0 : ℝ) ≤ s := le_trans habs hs.1
      rw [hW₁]
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (s - |r - t|) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith [hs.1]) _
      have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
      positivity)
    (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r)
    (by
      rw [brsMainTwoLeft]
      exact le_iSup₂_of_le t hmemt le_rfl)
  have hright := hpiece W₂ (fun s => s ^ (1 / 2 - 1 / p) *
      (r + t - s) ^ (-(1 / 2) : ℝ))
    (fun s hs => brsMainTwoRight_integrand hp (absProfile f₀) hs)
    (fun s hs => by
      have hs0 : (0 : ℝ) ≤ s := le_trans habs hs.1
      rw [hW₂]
      have h1 : (0 : ℝ) ≤ s ^ (1 / 2 : ℝ) := Real.rpow_nonneg hs0 _
      have h2 : (0 : ℝ) ≤ (r + t - s) ^ (-(1 / 2) : ℝ) :=
        Real.rpow_nonneg (by linarith [hs.2]) _
      have h3' : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
      positivity)
    (brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r)
    (by
      rw [brsMainTwoRight]
      exact le_iSup₂_of_le t hmemt le_rfl)
  calc ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W₁ s * ‖f₀ s‖)) +
        ENNReal.ofReal (∫ s in |r - t|..(r + t), c * (W₂ s * ‖f₀ s‖))
      ≤ ENNReal.ofReal (4 / Real.sqrt 3) *
          brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
          ENNReal.ofReal (4 / Real.sqrt 3) *
            brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r :=
        add_le_add hleft hright
    _ = ENNReal.ofReal (4 / Real.sqrt 3) *
          (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) r +
            brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) r) := by
        rw [mul_add]

/-- A window integral bounded by a weight integral. -/
theorem lintegral_subwindow_le {W : ℝ → ℝ} {f₀ : ℝ → ℂ} {r t a b C : ℝ}
    (hab : a ≤ b)
    (hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b)
    (hnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖))
    (hker : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖)) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal (∫ s in a..b, C * (W s * ‖f₀ s‖)) := by
  rw [← lintegral_Ioo_eq_ofReal_intervalIntegral hab hint hnn]
  refine lintegral_mono_ae ?_
  filter_upwards [self_mem_ae_restrict measurableSet_Ioo] with s hs
  exact ENNReal.ofReal_le_ofReal (hker s hs)

/-! ## The remainder operators of BRS Lemma 5.1 -/

/-- `R_1^-`: small dilations, left endpoint. -/
def brsRemTwoOneLeft (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in (r - t)..r,
      ((|s - (r - t)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_1^+`: small dilations, right endpoint. -/
def brsRemTwoOneRight (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in r..(r + t),
      ((|r + t - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_2^-`: large dilations, left endpoint. -/
def brsRemTwoTwoLeft (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- `R_2^+`: large dilations, right endpoint. -/
def brsRemTwoTwoRight (E : Set ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * f₀ s‖)

/-- The square root, as an inverse power. -/
theorem sqrt_inv_eq_rpow {z : ℝ} (hz : 0 ≤ z) :
    (Real.sqrt z)⁻¹ = z ^ (-(1 / 2) : ℝ) := by
  rw [Real.sqrt_eq_rpow, ← Real.rpow_neg_one (z ^ (1 / 2 : ℝ)),
    ← Real.rpow_mul hz]
  congr 1
  ring

/-- **A remainder window with the singularity at the left endpoint.** -/
theorem lintegral_window_le_rem_left {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {r t a b P C : ℝ} (hab : a ≤ b) (hP : 0 < P) (hC : 0 ≤ C)
    (hker : ∀ s ∈ Ioo a b, 2 * brsKernelTwo t r s ≤
      C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ)))
    {Mop : ENNReal}
    (hop : ENNReal.ofReal (P ^ (-(1 / 2) : ℝ) * ‖∫ s in a..b,
      ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * absProfile f₀ s‖) ≤ Mop) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal C * Mop := by
  set W : ℝ → ℝ := fun s => P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ) with hW
  have hWnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    rw [hW]
    have h1 : (0 : ℝ) ≤ P ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hP.le _
    have h2 : (0 : ℝ) ≤ (s - a) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.1]) _
    have h3 : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b := by
    rw [hW]
    exact (((intervalIntegrable_weight_left_profile hf₀ a b).const_mul
      (P ^ (-(1 / 2) : ℝ))).congr (fun s _ => by ring)).const_mul C
  have hpt : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    calc 2 * brsKernelTwo t r s * ‖f₀ s‖
        ≤ (C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ))) * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_right (hker s hs) hfn
      _ = C * (W s * ‖f₀ s‖) := by
          rw [hW]
          ring
  refine le_trans (lintegral_subwindow_le hab hint hWnn hpt) ?_
  -- identify the interval integral with the operator term
  have hcongr : (∫ s in a..b, ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s) =
      ((∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s hs => ?_
    rw [uIcc_of_le hab] at hs
    rw [abs_of_nonneg (by linarith [hs.1] : (0:ℝ) ≤ s - a), absProfile]
    push_cast
    ring
  have hnorm : ‖∫ s in a..b, ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s‖ = ∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ := by
    rw [hcongr, Complex.norm_real, Real.norm_of_nonneg
      (intervalIntegral.integral_nonneg hab fun s hs =>
        mul_nonneg (Real.rpow_nonneg (by linarith [hs.1]) _) (norm_nonneg _))]
  rw [hnorm] at hop
  have hsplit : (∫ s in a..b, C * (W s * ‖f₀ s‖)) =
      C * (P ^ (-(1 / 2) : ℝ) *
        ∫ s in a..b, (s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) := by
    rw [hW]
    rw [show (fun s => C * (P ^ (-(1 / 2) : ℝ) * (s - a) ^ (-(1 / 2) : ℝ) *
        ‖f₀ s‖)) = (fun s => (C * P ^ (-(1 / 2) : ℝ)) *
          ((s - a) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖)) by
      funext s
      ring]
    rw [intervalIntegral.integral_const_mul]
    ring
  rw [hsplit, ENNReal.ofReal_mul hC]
  exact mul_le_mul' le_rfl hop

/-- **A remainder window with the singularity at the right endpoint.** -/
theorem lintegral_window_le_rem_right {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    {r t a b P C : ℝ} (hab : a ≤ b) (hP : 0 < P) (hC : 0 ≤ C)
    (hker : ∀ s ∈ Ioo a b, 2 * brsKernelTwo t r s ≤
      C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ)))
    {Mop : ENNReal}
    (hop : ENNReal.ofReal (P ^ (-(1 / 2) : ℝ) * ‖∫ s in a..b,
      ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * absProfile f₀ s‖) ≤ Mop) :
    (∫⁻ s in Ioo a b, ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal C * Mop := by
  set W : ℝ → ℝ := fun s => P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ) with hW
  have hWnn : ∀ s ∈ Ioo a b, 0 ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    rw [hW]
    have h1 : (0 : ℝ) ≤ P ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hP.le _
    have h2 : (0 : ℝ) ≤ (b - s) ^ (-(1 / 2) : ℝ) :=
      Real.rpow_nonneg (by linarith [hs.2]) _
    have h3 : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    positivity
  have hint : IntervalIntegrable (fun s => C * (W s * ‖f₀ s‖)) volume a b := by
    rw [hW]
    exact (((intervalIntegrable_weight_right_profile hf₀ a b).const_mul
      (P ^ (-(1 / 2) : ℝ))).congr (fun s _ => by ring)).const_mul C
  have hpt : ∀ s ∈ Ioo a b,
      2 * brsKernelTwo t r s * ‖f₀ s‖ ≤ C * (W s * ‖f₀ s‖) := by
    intro s hs
    have hfn : (0 : ℝ) ≤ ‖f₀ s‖ := norm_nonneg _
    calc 2 * brsKernelTwo t r s * ‖f₀ s‖
        ≤ (C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ))) * ‖f₀ s‖ :=
          mul_le_mul_of_nonneg_right (hker s hs) hfn
      _ = C * (W s * ‖f₀ s‖) := by
          rw [hW]
          ring
  refine le_trans (lintegral_subwindow_le hab hint hWnn hpt) ?_
  have hcongr : (∫ s in a..b, ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s) =
      ((∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ : ℝ) : ℂ) := by
    rw [← intervalIntegral.integral_ofReal]
    refine intervalIntegral.integral_congr fun s hs => ?_
    rw [uIcc_of_le hab] at hs
    rw [abs_of_nonneg (by linarith [hs.2] : (0:ℝ) ≤ b - s), absProfile]
    push_cast
    ring
  have hnorm : ‖∫ s in a..b, ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
      absProfile f₀ s‖ = ∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖ := by
    rw [hcongr, Complex.norm_real, Real.norm_of_nonneg
      (intervalIntegral.integral_nonneg hab fun s hs =>
        mul_nonneg (Real.rpow_nonneg (by linarith [hs.2]) _) (norm_nonneg _))]
  rw [hnorm] at hop
  have hsplit : (∫ s in a..b, C * (W s * ‖f₀ s‖)) =
      C * (P ^ (-(1 / 2) : ℝ) *
        ∫ s in a..b, (b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖) := by
    rw [hW]
    rw [show (fun s => C * (P ^ (-(1 / 2) : ℝ) * (b - s) ^ (-(1 / 2) : ℝ) *
        ‖f₀ s‖)) = (fun s => (C * P ^ (-(1 / 2) : ℝ)) *
          ((b - s) ^ (-(1 / 2) : ℝ) * ‖f₀ s‖)) by
      funext s
      ring]
    rw [intervalIntegral.integral_const_mul]
    ring
  rw [hsplit, ENNReal.ofReal_mul hC]
  exact mul_le_mul' le_rfl hop

/-- **Small dilations, left half.** -/
theorem lintegral_small_left_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (htr : t ≤ r / 2) :
    (∫⁻ s in Ioo (r - t) r,
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 2 * brsRemTwoOneLeft E (absProfile f₀) r := by
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  refine lintegral_window_le_rem_left hf₀ (by linarith) htpos (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_small_left hr htpos htr (le_of_lt hs.1)
      (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow htpos.le,
      sqrt_inv_eq_rpow (by linarith [hs.1] : (0:ℝ) ≤ s - (r - t))] at hb
    have hfn : (0 : ℝ) ≤ t ^ (-(1 / 2) : ℝ) * (s - (r - t)) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg htpos.le _)
        (Real.rpow_nonneg (by linarith [hs.1]) _)
    linarith [hb]
  · rw [brsRemTwoOneLeft]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Small dilations, right half.** -/
theorem lintegral_small_right_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r t : ℝ} (hr : 0 < r) (htE : t ∈ E)
    (htr : t ≤ r / 2) :
    (∫⁻ s in Ioo r (r + t),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 4 * brsRemTwoOneRight E (absProfile f₀) r := by
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  refine lintegral_window_le_rem_right hf₀ (by linarith) htpos (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_small_right hr htpos htr (le_of_lt hs.1)
      (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow htpos.le,
      sqrt_inv_eq_rpow (by linarith [hs.2] : (0:ℝ) ≤ r + t - s)] at hb
    have hfn : (0 : ℝ) ≤ t ^ (-(1 / 2) : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg htpos.le _)
        (Real.rpow_nonneg (by linarith [hs.2]) _)
    linarith [hb]
  · rw [brsRemTwoOneRight]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Large dilations, left half.** -/
theorem lintegral_large_left_le {E : Set ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {r t : ℝ}
    (hr : 0 < r) (htE : t ∈ E) (htr : 3 * r / 2 ≤ t) :
    (∫⁻ s in Ioo (t - r) t,
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 4 * brsRemTwoTwoLeft E (absProfile f₀) r := by
  refine lintegral_window_le_rem_left hf₀ (by linarith) hr (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_large_left hr htr (le_of_lt hs.1) (le_of_lt hs.2)
    rw [sqrt_inv_eq_rpow hr.le,
      sqrt_inv_eq_rpow (by linarith [hs.1] : (0:ℝ) ≤ s - (t - r))] at hb
    have hfn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) * (s - (t - r)) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hr.le _)
        (Real.rpow_nonneg (by linarith [hs.1]) _)
    linarith [hb]
  · rw [brsRemTwoTwoLeft]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **Large dilations, right half.** -/
theorem lintegral_large_right_le {E : Set ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {r t : ℝ}
    (hr : 0 < r) (htE : t ∈ E) (htr : 3 * r / 2 ≤ t) :
    (∫⁻ s in Ioo t (t + r),
        ENNReal.ofReal (2 * brsKernelTwo t r s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 8 * brsRemTwoTwoRight E (absProfile f₀) r := by
  refine lintegral_window_le_rem_right hf₀ (by linarith) hr (by norm_num)
    (fun s hs => ?_) ?_
  · have hb := brsKernelTwo_le_large_right hr htr (le_of_lt hs.1) (le_of_lt hs.2)
    have hrw : t + r - s = r + t - s := by ring
    rw [sqrt_inv_eq_rpow hr.le] at hb
    rw [hrw]
    rw [sqrt_inv_eq_rpow (by linarith [hs.2] : (0:ℝ) ≤ r + t - s)] at hb
    have hfn : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) * (r + t - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hr.le _)
        (Real.rpow_nonneg (by linarith [hs.2]) _)
    linarith [hb]
  · rw [brsRemTwoTwoRight]
    exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- Splitting a window integral at an interior point. -/
theorem lintegral_Ioo_split {F : ℝ → ENNReal} {a m b : ℝ} (_ham : a ≤ m)
    (_hmb : m ≤ b) :
    (∫⁻ s in Ioo a b, F s) ≤ (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Ioo m b, F s := by
  have hsub : Ioo a b ⊆ Ioo a m ∪ Icc m b := by
    intro s hs
    rcases lt_or_ge s m with h | h
    · exact Or.inl ⟨hs.1, h⟩
    · exact Or.inr ⟨h, le_of_lt hs.2⟩
  calc (∫⁻ s in Ioo a b, F s) ≤ ∫⁻ s in Ioo a m ∪ Icc m b, F s :=
        lintegral_mono_set hsub
    _ ≤ (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Icc m b, F s := lintegral_union_le _ _ _
    _ = (∫⁻ s in Ioo a m, F s) + ∫⁻ s in Ioo m b, F s := by
        rw [setLIntegral_congr (Ioo_ae_eq_Icc).symm]

/-- **Lemma 5.1 of BRS.**  In the plane the spherical maximal operator on
radial data is dominated by the two main terms and the four remainders. -/
theorem le_brsDecompositionTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 0 < p) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {x : Euclidean 2}
    (hx : x ≠ 0) :
    M E (fun y : Euclidean 2 => f₀ ‖y‖) x ≤
      ENNReal.ofReal (((surfaceMass 2)⁻¹ * surfaceMass 1) * 8) *
        (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
          brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
          brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
          brsRemTwoOneRight E (absProfile f₀) ‖x‖ +
          brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
          brsRemTwoTwoRight E (absProfile f₀) ‖x‖) := by
  have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hmass2 : 0 < surfaceMass 2 := surfaceMass_pos (by norm_num)
  set c₂ : ℝ := (surfaceMass 2)⁻¹ * surfaceMass 1 with hc₂
  have hc₂pos : 0 < c₂ := by
    rw [hc₂]
    positivity
  set S : ENNReal :=
    brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoOneRight E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoRight E (absProfile f₀) ‖x‖ with hS
  unfold M _root_.Spherical.restrictedSphericalMaximal
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htpos⟩ := ht
  have htIcc : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have ht2 : t ≤ 2 := htIcc.2
  have htpos' : 0 < t := lt_of_lt_of_le zero_lt_one ht1
  -- the kernel bound
  have hker := ofReal_norm_sphericalAverage_two_le hf₀ hx htpos'
  refine le_trans hker ?_
  -- the six summands are dominated by their total
  have hM : brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
      brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ ≤ S := by
    rw [hS]
    exact le_add_right (le_add_right (le_add_right (le_add_right le_rfl)))
  have hR1 : brsRemTwoOneLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoOneRight E (absProfile f₀) ‖x‖ ≤ S := by
    rw [hS]
    exact le_add_right (le_add_right (add_le_add le_add_self le_rfl))
  have hR2 : brsRemTwoTwoLeft E (absProfile f₀) ‖x‖ +
      brsRemTwoTwoRight E (absProfile f₀) ‖x‖ ≤ S := by
    rw [hS]
    exact add_le_add le_add_self le_rfl
  have h8 : ∀ (A B X Y : ENNReal) (C₁ C₂ : ℝ), C₁ ≤ 8 → C₂ ≤ 8 → 0 ≤ C₁ →
      0 ≤ C₂ → A ≤ ENNReal.ofReal C₁ * X → B ≤ ENNReal.ofReal C₂ * Y →
      X + Y ≤ S → A + B ≤ ENNReal.ofReal 8 * S := by
    intro A B X Y C₁ C₂ hC₁ hC₂ _ _ hA hB hXY
    calc A + B ≤ ENNReal.ofReal C₁ * X + ENNReal.ofReal C₂ * Y :=
          add_le_add hA hB
      _ ≤ ENNReal.ofReal 8 * X + ENNReal.ofReal 8 * Y :=
          add_le_add (mul_le_mul' (ENNReal.ofReal_le_ofReal hC₁) le_rfl)
            (mul_le_mul' (ENNReal.ofReal_le_ofReal hC₂) le_rfl)
      _ = ENNReal.ofReal 8 * (X + Y) := by rw [mul_add]
      _ ≤ ENNReal.ofReal 8 * S := mul_le_mul' le_rfl hXY
  -- the window integral, in each range of `t`
  have hwin : (∫⁻ s in Ioo (|‖x‖ - t|) (‖x‖ + t),
      ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖)) ≤
      ENNReal.ofReal 8 * S := by
    by_cases hle : t ≤ ‖x‖ / 2
    · have habs : |‖x‖ - t| = ‖x‖ - t := abs_of_nonneg (by linarith)
      rw [habs]
      refine le_trans (lintegral_Ioo_split
        (F := fun s => ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖))
        (a := ‖x‖ - t) (m := ‖x‖) (b := ‖x‖ + t) (by linarith) (by linarith)) ?_
      exact h8 _ _ _ _ 2 4 (by norm_num) (by norm_num) (by norm_num) (by norm_num)
        (lintegral_small_left_le hE hf₀ hr htE hle)
        (lintegral_small_right_le hE hf₀ hr htE hle) hR1
    · have hmid : ‖x‖ / 2 < t := not_le.mp hle
      rcases lt_or_ge t (3 * ‖x‖ / 2) with hmain | hlarge
      · have hbound := lintegral_window_le_mainTwo hp hf₀ hr htE
          hmid hmain
        refine le_trans hbound ?_
        have hle : (4 : ℝ) / Real.sqrt 3 ≤ 8 := by
          have h1 : (1 : ℝ) ≤ Real.sqrt 3 := by
            rw [show (1 : ℝ) = Real.sqrt 1 by simp]
            exact Real.sqrt_le_sqrt (by norm_num)
          rw [div_le_iff₀ (by linarith)]
          linarith
        calc ENNReal.ofReal (4 / Real.sqrt 3) *
              (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
                brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖)
            ≤ ENNReal.ofReal 8 *
                (brsMainTwoLeft E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖ +
                  brsMainTwoRight E p (brsProfileSub 2 p (absProfile f₀)) ‖x‖) :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ ≤ ENNReal.ofReal 8 * S := mul_le_mul' le_rfl hM
      · have habs : |‖x‖ - t| = t - ‖x‖ := by
          rw [abs_of_nonpos (by linarith)]
          ring
        have hrw : ‖x‖ + t = t + ‖x‖ := by ring
        rw [habs, hrw]
        refine le_trans (lintegral_Ioo_split
          (F := fun s => ENNReal.ofReal (2 * brsKernelTwo t ‖x‖ s * ‖f₀ s‖))
          (a := t - ‖x‖) (m := t) (b := t + ‖x‖) (by linarith) (by linarith)) ?_
        exact h8 _ _ _ _ 4 8 (by norm_num) (by norm_num) (by norm_num)
          (by norm_num) (lintegral_large_left_le hf₀ hr htE hlarge)
          (lintegral_large_right_le hf₀ hr htE hlarge) hR2
  refine le_trans (mul_le_mul' le_rfl hwin) (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul hc₂pos.le]

/-! ## (5.1): the dyadic decomposition of the operators `R_1^±` -/

/-- The dyadic scale `2^{-m}`. -/
def brsDyadic (m : ℕ) : ℝ := (1 / 2 : ℝ) ^ m

theorem brsDyadic_pos (m : ℕ) : 0 < brsDyadic m := by
  rw [brsDyadic]
  positivity

/-- Every distance in `(0, 2)` lies in exactly one dyadic block. -/
theorem exists_brsDyadic_mem {x : ℝ} (hx0 : 0 < x) (hx2 : x < 2) :
    ∃ m : ℕ, brsDyadic m ≤ x ∧ x < 2 * brsDyadic m := by
  classical
  have hex : ∃ m : ℕ, brsDyadic m ≤ x := by
    obtain ⟨m, hm⟩ := exists_pow_lt_of_lt_one hx0 (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨m, le_of_lt hm⟩
  refine ⟨Nat.find hex, Nat.find_spec hex, ?_⟩
  rcases Nat.eq_zero_or_pos (Nat.find hex) with h0 | hpos
  · rw [h0, brsDyadic]
    simpa using hx2
  · have hlt : ¬ brsDyadic (Nat.find hex - 1) ≤ x :=
      Nat.find_min hex (by omega)
    push Not at hlt
    obtain ⟨k, hk⟩ : ∃ k : ℕ, Nat.find hex = k + 1 := ⟨Nat.find hex - 1, by omega⟩
    have hstep : brsDyadic (Nat.find hex - 1) = 2 * brsDyadic (Nat.find hex) := by
      rw [hk, brsDyadic, brsDyadic, Nat.add_sub_cancel, pow_succ]
      ring
    rw [hstep] at hlt
    exact hlt

/-- `R_1^{-,m}`: the `m`-th dyadic block of the small-dilation left remainder. -/
def brsR1PieceLeft (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m), ‖g s‖ₑ

/-- `R_1^{+,m}`: the `m`-th dyadic block of the small-dilation right remainder. -/
def brsR1PieceRight (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Iic (r / 2),
    ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m), ‖g s‖ₑ

/-- The elementary weight bound on a dyadic block. -/
theorem enorm_weight_mul_le {g : ℝ → ℂ} {m : ℕ} {a s : ℝ} (ha : brsDyadic m ≤ a)
    (ha0 : 0 < a) :
    ‖((|a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ ≤
      ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
  have habs : |a| = a := abs_of_pos ha0
  have hle : a ^ (-(1 / 2) : ℝ) ≤ brsDyadic m ^ (-(1 / 2) : ℝ) :=
    Real.rpow_le_rpow_of_nonpos (brsDyadic_pos m) ha (by norm_num)
  have hnn : (0 : ℝ) ≤ a ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg ha0.le _
  rw [habs, enorm_mul, ← ofReal_norm, Complex.norm_real,
    Real.norm_of_nonneg hnn]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl

/-- **(5.1) of BRS, left half.** -/
theorem brsRemTwoOneLeft_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} :
    brsRemTwoOneLeft E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        brsR1PieceLeft E g m r := by
  rw [brsRemTwoOneLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : r - t ≤ r := by linarith
  set F : ℝ → ℂ := fun s => ((|s - (r - t)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hstep1 : ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in (r - t)..r, F s‖) ≤
      ‖∫ s in (r - t)..r, F s‖ₑ := by
    rw [← ofReal_norm]
    refine ENNReal.ofReal_le_ofReal ?_
    have h1 : t ^ (-(1 / 2) : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos ht1 (by norm_num)
    nlinarith [norm_nonneg (∫ s in (r - t)..r, F s)]
  have hstep2 : ‖∫ s in (r - t)..r, F s‖ₑ ≤ ∫⁻ s in Ioo (r - t) r, ‖F s‖ₑ := by
    rw [intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo (r - t) r ⊆
      ⋃ m : ℕ, Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := s - (r - t)) (by linarith [hs.1]) (by linarith [hs.2])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  have hstep3 : (∫⁻ s in Ioo (r - t) r, ‖F s‖ₑ) ≤
      ∑' m : ℕ, ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m),
        ‖F s‖ₑ :=
    le_trans (lintegral_mono_set hcover) (lintegral_iUnion_le _ _)
  refine le_trans hstep1 (le_trans hstep2 (le_trans hstep3
    (ENNReal.tsum_le_tsum fun m => ?_)))
  have hbound : (∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m), ‖g s‖ₑ := by
    have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
      ENNReal.ofReal_ne_top
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ico] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1])
      (by linarith [hs.1, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR1PieceLeft]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- **(5.1) of BRS, right half.** -/
theorem brsRemTwoOneRight_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} :
    brsRemTwoOneRight E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        brsR1PieceRight E g m r := by
  rw [brsRemTwoOneRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : r ≤ r + t := by linarith
  set F : ℝ → ℂ := fun s => ((|r + t - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hstep1 : ENNReal.ofReal (t ^ (-(1 / 2) : ℝ) * ‖∫ s in r..(r + t), F s‖) ≤
      ‖∫ s in r..(r + t), F s‖ₑ := by
    rw [← ofReal_norm]
    refine ENNReal.ofReal_le_ofReal ?_
    have h1 : t ^ (-(1 / 2) : ℝ) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos ht1 (by norm_num)
    nlinarith [norm_nonneg (∫ s in r..(r + t), F s)]
  have hstep2 : ‖∫ s in r..(r + t), F s‖ₑ ≤ ∫⁻ s in Ioo r (r + t), ‖F s‖ₑ := by
    rw [intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo r (r + t) ⊆
      ⋃ m : ℕ, Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := r + t - s) (by linarith [hs.2]) (by linarith [hs.1])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  have hstep3 : (∫⁻ s in Ioo r (r + t), ‖F s‖ₑ) ≤
      ∑' m : ℕ, ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
        ‖F s‖ₑ :=
    le_trans (lintegral_mono_set hcover) (lintegral_iUnion_le _ _)
  refine le_trans hstep1 (le_trans hstep2 (le_trans hstep3
    (ENNReal.tsum_le_tsum fun m => ?_)))
  have hbound : (∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m),
          ‖g s‖ₑ := by
    have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
      ENNReal.ofReal_ne_top
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ioc] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.2])
      (by linarith [hs.2, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR1PieceRight]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-! ## The centered blocks of a covering of `E` -/

/-- The window of the covering interval centered at `a`, at scale `δ`,
intersected with the region `s ≥ r/2` that the constraint `t ≤ r/2`
supplies. -/
def brsCenteredWindow (a δ r : ℝ) : Set ℝ :=
  Icc (r - a) (r - a + 3 * δ) ∩ (Ici (r / 2) ∩ Ici 1)

/-- The `L^1` mass of `g` on the centered window. -/
def brsCenteredPiece (a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∫⁻ s, (brsCenteredWindow a δ r).indicator (fun s => ‖g s‖ₑ) s

theorem measurableSet_brsCenteredWindow (a δ r : ℝ) :
    MeasurableSet (brsCenteredWindow a δ r) :=
  (measurableSet_Icc).inter (measurableSet_Ici.inter measurableSet_Ici)

theorem brsCenteredPiece_eq_setLIntegral (a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsCenteredPiece a δ g r = ∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ := by
  rw [brsCenteredPiece, lintegral_indicator (measurableSet_brsCenteredWindow a δ r)]

/-- Joint measurability of the centered blocks. -/
theorem measurable_brsCenteredPiece {a δ : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsCenteredPiece a δ g) := by
  have hset : MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} := by
    have h1 : MeasurableSet {z : ℝ × ℝ | z.1 - a ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h4 : MeasurableSet {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have : {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} =
        (({z : ℝ × ℝ | z.1 - a ≤ z.2} ∩ {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ}) ∩
          {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} := by
      ext z
      simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
        Set.mem_Icc, Set.mem_Ici]
      tauto
    rw [this]
    exact ((h1.inter h2).inter h3).inter h4
  have hfun : Measurable fun z : ℝ × ℝ =>
      (brsCenteredWindow a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2 := by
    have : (fun z : ℝ × ℝ =>
        (brsCenteredWindow a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1}.indicator
          (fun z : ℝ × ℝ => ‖g z.2‖ₑ) z := by
      funext z
      by_cases hz : z.2 ∈ brsCenteredWindow a δ z.1 <;>
        simp [hz]
    rw [this]
    exact (hg.comp measurable_snd).enorm.indicator hset
  exact hfun.lintegral_prod_right'

/-- Each dyadic block of `R_1^-` is dominated by the centered blocks of any
covering of `E` at the same scale. -/
theorem brsR1PieceLeft_le_iSup_centered {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ}
    (hcov : IsIntervalCover E (brsDyadic m) ι) {g : ℝ → ℂ} {r : ℝ} :
    brsR1PieceLeft E g m r ≤
      ⨆ a ∈ ι, brsCenteredPiece a (brsDyadic m) g r := by
  rw [brsR1PieceLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : t ≤ r / 2 := htr
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ico (r - t + brsDyadic m) (r - t + 2 * brsDyadic m) ⊆
      brsCenteredWindow a (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ico.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by linarith, by linarith⟩, ?_, ?_⟩
    · change r / 2 ≤ x
      linarith
    · change (1 : ℝ) ≤ x
      have ht1 : (1 : ℝ) ≤ t := (hE htE).1
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsCenteredPiece_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- Hölder's inequality on a window. -/
theorem lintegral_window_holder {p : ℝ} (hp : 1 < p) {W : Set ℝ}
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in W, ‖g s‖ₑ) ≤
      (∫⁻ s in W, ‖g s‖ₑ ^ p) ^ (1 / p) * volume W ^ (1 - 1 / p) := by
  have hconj : p.HolderConjugate (Real.conjExponent p) :=
    Real.HolderConjugate.conjExponent hp
  have h := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume.restrict W) hconj
    (f := fun s => ‖g s‖ₑ) (g := fun _ => (1 : ENNReal))
    hg.enorm.aemeasurable aemeasurable_const
  simp only [Pi.mul_apply, mul_one, ENNReal.one_rpow, lintegral_const,
    Measure.restrict_apply_univ, one_mul] at h
  have hexp : 1 / Real.conjExponent p = 1 - 1 / p := by
    have h1 := hconj.one_div_add_one_div
    norm_num at h1
    rw [one_div, one_div]
    linarith
  rw [hexp] at h
  exact h

/-- The set of radii whose centered window contains a given point. -/
theorem measure_setOf_mem_brsCenteredWindow_le {a δ s : ℝ} (_hδ : 0 ≤ δ) :
    volume {r : ℝ | s ∈ brsCenteredWindow a δ r} ≤ ENNReal.ofReal (3 * δ) := by
  have hsub : {r : ℝ | s ∈ brsCenteredWindow a δ r} ⊆
      Icc (s + a - 3 * δ) (s + a) := by
    intro r hr
    obtain ⟨⟨h1, h2⟩, _⟩ := hr
    exact ⟨by linarith, by linarith⟩
  refine le_trans (measure_mono hsub) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  linarith

/-- Tonelli for the centered windows: each point is seen by radii in an
interval of length `3δ`. -/
theorem lintegral_centered_window_le {a δ : ℝ} (hδ : 0 ≤ δ) {Φ : ℝ → ENNReal}
    (hΦ : Measurable Φ) :
    (∫⁻ r, ∫⁻ s, (brsCenteredWindow a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s := by
  have hset : MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} := by
    have h1 : MeasurableSet {z : ℝ × ℝ | z.1 - a ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h4 : MeasurableSet {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have hEq : {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1} =
        (({z : ℝ × ℝ | z.1 - a ≤ z.2} ∩ {z : ℝ × ℝ | z.2 ≤ z.1 - a + 3 * δ}) ∩
          {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 : ℝ) ≤ z.2} := by
      ext z
      simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
        Set.mem_Icc, Set.mem_Ici]
      tauto
    rw [hEq]
    exact ((h1.inter h2).inter h3).inter h4
  have hjoint : Measurable fun z : ℝ × ℝ =>
      (brsCenteredWindow a δ z.1).indicator Φ z.2 := by
    have hEq : (fun z : ℝ × ℝ => (brsCenteredWindow a δ z.1).indicator Φ z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsCenteredWindow a δ z.1}.indicator
          (fun z : ℝ × ℝ => Φ z.2) z := by
      funext z
      by_cases hz : z.2 ∈ brsCenteredWindow a δ z.1 <;>
        simp [hz]
    rw [hEq]
    exact (hΦ.comp measurable_snd).indicator hset
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  rw [← lintegral_const_mul _ hΦ]
  refine lintegral_mono fun s => ?_
  have hind : (fun r => (brsCenteredWindow a δ r).indicator Φ s) =
      {r : ℝ | s ∈ brsCenteredWindow a δ r}.indicator (fun _ => Φ s) := by
    funext r
    by_cases hr : s ∈ brsCenteredWindow a δ r <;>
      simp [hr]
  have hmeas : MeasurableSet {r : ℝ | s ∈ brsCenteredWindow a δ r} := by
    have h1 : MeasurableSet {r : ℝ | r - a ≤ s} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h2 : MeasurableSet {r : ℝ | s ≤ r - a + 3 * δ} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have h3 : MeasurableSet {r : ℝ | r / 2 ≤ s} :=
      measurableSet_le (by fun_prop) (by fun_prop)
    have hEq : {r : ℝ | s ∈ brsCenteredWindow a δ r} =
        if (1 : ℝ) ≤ s then
          ({r : ℝ | r - a ≤ s} ∩ {r : ℝ | s ≤ r - a + 3 * δ}) ∩
            {r : ℝ | r / 2 ≤ s}
        else (∅ : Set ℝ) := by
      by_cases hs1 : (1 : ℝ) ≤ s
      · rw [if_pos hs1]
        ext r
        simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
          Set.mem_Icc, Set.mem_Ici]
        tauto
      · rw [if_neg hs1]
        ext r
        simp only [brsCenteredWindow, Set.mem_setOf_eq, Set.mem_inter_iff,
          Set.mem_Icc, Set.mem_Ici, Set.mem_empty_iff_false, iff_false]
        tauto
    rw [hEq]
    by_cases hs1 : (1 : ℝ) ≤ s
    · rw [if_pos hs1]
      exact (h1.inter h2).inter h3
    · rw [if_neg hs1]
      exact MeasurableSet.empty
  rw [hind, lintegral_indicator_const hmeas, mul_comm (Φ s)]
  exact mul_le_mul' (measure_setOf_mem_brsCenteredWindow_le hδ) le_rfl

/-- Linearizing a power by a majorant. -/
theorem ennreal_rpow_le_mul_of_le {X M : ENNReal} {c : ℝ} (hc : 1 ≤ c)
    (hXM : X ≤ M) : X ^ c ≤ X * M ^ (c - 1) := by
  rcases eq_or_ne X 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos (by linarith : (0 : ℝ) < c), zero_mul]
  rcases eq_or_ne X ⊤ with htop | htop
  · have hM : M = ⊤ := top_le_iff.mp (htop ▸ hXM)
    rcases eq_or_lt_of_le hc with hc1 | hc1
    · rw [htop, hM, ← hc1]
      simp
    · rw [htop, hM, ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c),
        ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c - 1)]
      simp
  · have hsplit : X ^ c = X * X ^ (c - 1) := by
      have hc' : c = 1 + (c - 1) := by ring
      rw [hc', ENNReal.rpow_add _ _ h0 htop, ENNReal.rpow_one]
      congr 1
      ring
    rw [hsplit]
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hXM (by linarith))

/-- Recombining the linearized power. -/
theorem ennreal_rpow_sub_one_mul_le {M : ENNReal} {c : ℝ} (hc : 1 ≤ c) :
    M ^ (c - 1) * M ≤ M ^ c := by
  rcases eq_or_ne M 0 with h0 | h0
  · rw [h0, mul_zero]
    simp
  rcases eq_or_ne M ⊤ with htop | htop
  · rw [htop, ENNReal.top_rpow_of_pos (by linarith : (0 : ℝ) < c)]
    exact le_top
  · have hc' : c = c - 1 + 1 := by ring
    rw [hc', ENNReal.rpow_add _ _ h0 htop, ENNReal.rpow_one]
    have : c - 1 + 1 - 1 = c - 1 := by ring
    rw [this]

theorem volume_brsCenteredWindow_le {a δ r : ℝ} (_hδ : 0 ≤ δ) :
    volume (brsCenteredWindow a δ r) ≤ ENNReal.ofReal (3 * δ) := by
  refine le_trans (measure_mono (Set.inter_subset_left)) ?_
  rw [Real.volume_Icc]
  refine ENNReal.ofReal_le_ofReal ?_
  linarith

/-- The `L^q(r\,dr)` bound for a single centered block. -/
theorem lintegral_brsCenteredPiece_pow_le {p q δ a : ℝ} (hp : 1 < p) (hpq : p ≤ q)
    (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q) ≤
      2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hqp : (1 : ℝ) ≤ q / p := (one_le_div hp0).mpr hpq
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ := by
    rw [hΦdef]
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      (hg.enorm.pow_const p)
  set M : ENNReal := ∫⁻ s, Φ s with hM
  -- the `L^p` mass on a window is at most the weighted global mass
  have hXM : ∀ r : ℝ, (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ≤ M := by
    intro r
    refine le_trans (setLIntegral_mono' (measurableSet_brsCenteredWindow a δ r)
      ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : (1 : ℝ) ≤ s := hs.2.2
    have : (1 : ENNReal) ≤ ENNReal.ofReal s := by
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal hs1
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ ENNReal.ofReal s * ‖g s‖ₑ ^ p := mul_le_mul' this le_rfl
  -- Hölder on each window
  have hPX : ∀ r : ℝ, brsCenteredPiece a δ g r ≤
      (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
        ENNReal.ofReal (3 * δ) ^ (1 - 1 / p) := by
    intro r
    rw [brsCenteredPiece_eq_setLIntegral]
    refine le_trans (lintegral_window_holder hp hg) (mul_le_mul' le_rfl ?_)
    exact ENNReal.rpow_le_rpow (volume_brsCenteredWindow_le hδ.le)
      (by rw [sub_nonneg, div_le_one hp0]; linarith)
  -- the radial weight against the window mass
  have hrX : ∀ r : ℝ, ENNReal.ofReal r *
      (∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p) ≤
      2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s := by
    intro r
    rw [← lintegral_const_mul' _ _ (by simp : ENNReal.ofReal r ≠ ⊤),
      ← lintegral_const_mul' _ _ (by simp : (2 : ENNReal) ≠ ⊤)]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict (measurableSet_brsCenteredWindow a δ r)]
      with s hs
    have hs2 : r / 2 ≤ s := hs.2.1
    have hrs : ENNReal.ofReal r ≤ 2 * ENNReal.ofReal s := by
      rw [show (2 : ENNReal) = ENNReal.ofReal 2 by
        rw [ENNReal.ofReal_ofNat], ← ENNReal.ofReal_mul (by norm_num)]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ENNReal.ofReal r * ‖g s‖ₑ ^ p
        ≤ (2 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p := mul_le_mul' hrs le_rfl
      _ = 2 * Φ s := by rw [hΦdef, mul_assoc]
  -- the pointwise bound
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q ≤
      ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
        (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) := by
    intro r
    set X : ENNReal := ∫⁻ s in brsCenteredWindow a δ r, ‖g s‖ₑ ^ p with hX
    have h1 : brsCenteredPiece a δ g r ^ q ≤
        X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
      refine le_trans (ENNReal.rpow_le_rpow (hPX r) hq0.le) (le_of_eq ?_)
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
        ← ENNReal.rpow_mul]
      congr 2
      · rw [one_div]
        field_simp
      · ring
    calc ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q
        ≤ ENNReal.ofReal r *
            (X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
          mul_le_mul' le_rfl h1
      _ ≤ ENNReal.ofReal r *
            ((X * M ^ (q / p - 1)) *
              ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) := by
          exact mul_le_mul' le_rfl
            (mul_le_mul' (ennreal_rpow_le_mul_of_le hqp (hXM r)) le_rfl)
      _ = ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (ENNReal.ofReal r * X) := by ring
      _ ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) :=
          mul_le_mul' le_rfl (hrX r)
  -- integrate in the radius
  have hmass : (∫⁻ r, ∫⁻ s in brsCenteredWindow a δ r, Φ s) ≤
      ENNReal.ofReal (3 * δ) * M := by
    have hswap := lintegral_centered_window_le (a := a) (δ := δ) hδ.le hΦmeas
    refine le_trans (le_of_eq ?_) hswap
    refine lintegral_congr fun r => ?_
    rw [lintegral_indicator (measurableSet_brsCenteredWindow a δ r)]
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  have he0 : (0 : ℝ) ≤ q * (1 - 1 / p) := by
    have : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    positivity
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hMq : M ^ (q / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity)]
    have : (2 : ENNReal) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
        M ^ (q / p) = ⊤ := by
      rw [hMq]
      refine ENNReal.mul_top ?_
      refine ne_of_gt ?_
      refine ENNReal.mul_pos (by norm_num) ?_
      exact (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hδ3)
        ENNReal.ofReal_ne_top).ne'
    rw [this]
    exact le_top
  · set C : ENNReal := ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
      M ^ (q / p - 1) * 2 with hC
    have hCne : C ≠ ⊤ := by
      refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) (by simp)
      · exact ENNReal.rpow_ne_top_of_nonneg he0 ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hMtop
    calc (∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q)
        ≤ ∫⁻ r, ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) * M ^ (q / p - 1) *
            (2 * ∫⁻ s in brsCenteredWindow a δ r, Φ s) := lintegral_mono hpt
      _ = ∫⁻ r, C * ∫⁻ s in brsCenteredWindow a δ r, Φ s := by
          refine lintegral_congr fun r => ?_
          rw [hC]
          ring
      _ = C * ∫⁻ r, ∫⁻ s in brsCenteredWindow a δ r, Φ s :=
          lintegral_const_mul' _ _ hCne
      _ ≤ C * (ENNReal.ofReal (3 * δ) * M) := mul_le_mul' le_rfl hmass
      _ = 2 * (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
            ENNReal.ofReal (3 * δ)) * (M ^ (q / p - 1) * M) := by
          rw [hC]
          ring
      _ ≤ 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) * M ^ (q / p) := by
          refine mul_le_mul' (mul_le_mul' le_rfl (le_of_eq ?_))
            (ennreal_rpow_sub_one_mul_le hqp)
          rw [ENNReal.rpow_add_of_nonneg _ _ he0 (by norm_num),
            ENNReal.rpow_one]

/-- A finite supremum, raised to a power, is at most the sum of the powers. -/
theorem iSup_rpow_le_sum {q : ℝ} (hq : 0 < q) (ι : Finset ℝ) (f : ℝ → ENNReal) :
    (⨆ a ∈ ι, f a) ^ q ≤ ∑ a ∈ ι, f a ^ q := by
  have hle : (⨆ a ∈ ι, f a) ≤ (∑ a ∈ ι, f a ^ q) ^ (1 / q) := by
    refine iSup₂_le fun a ha => ?_
    have hself : f a = (f a ^ q) ^ (1 / q) := by
      rw [one_div, ENNReal.rpow_rpow_inv hq.ne']
    rw [hself]
    exact ENNReal.rpow_le_rpow (Finset.single_le_sum
      (f := fun a => f a ^ q) (fun _ _ => zero_le) ha) (by positivity)
  refine le_trans (ENNReal.rpow_le_rpow hle hq.le) (le_of_eq ?_)
  rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq.ne', ENNReal.rpow_one]

/-- The `L^q(r\,dr)` bound for a dyadic block of `R_1^-`. -/
theorem lintegral_brsR1PieceLeft_pow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp : 1 < p) (hpq : p ≤ q) (m : ℕ) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q) ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
        (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set δ := brsDyadic m with hδdef
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q := by
    intro r
    have h1 : brsR1PieceLeft E g m r ^ q ≤
        ∑ a ∈ ι, brsCenteredPiece a δ g r ^ q :=
      le_trans (ENNReal.rpow_le_rpow
        (brsR1PieceLeft_le_iSup_centered hE hcov) hq0.le)
        (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece a δ g r)
    calc ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece a δ g r ^ q :=
          mul_le_mul' le_rfl h1
      _ = ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
          Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * brsR1PieceLeft E g m r ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
        lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r * brsCenteredPiece a δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E δ : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hcard, hK]
        ring

/-- Powers commute with countable suprema. -/
theorem ennreal_iSup_rpow {q : ℝ} (hq : 0 < q) (u : ℕ → ENNReal) :
    (⨆ n, u n) ^ q = ⨆ n, u n ^ q := by
  refine le_antisymm ?_ (iSup_le fun n => ENNReal.rpow_le_rpow (le_iSup _ n) hq.le)
  have h : (⨆ n, u n) ≤ (⨆ n, u n ^ q) ^ (1 / q) := by
    refine iSup_le fun n => ?_
    have hself : u n = (u n ^ q) ^ (1 / q) := by
      rw [one_div, ENNReal.rpow_rpow_inv hq.ne']
    rw [hself]
    exact ENNReal.rpow_le_rpow (le_iSup (fun n => u n ^ q) n) (by positivity)
  have h2 := ENNReal.rpow_le_rpow h hq.le
  rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq.ne', ENNReal.rpow_one] at h2

/-- Minkowski's inequality for a countable sum. -/
theorem lintegral_rpow_tsum_le {α : Type*} [MeasurableSpace α] {μ : Measure α}
    {q : ℝ} (hq : 1 ≤ q) {F : ℕ → α → ENNReal} (hF : ∀ n, Measurable (F n)) :
    (∫⁻ x, (∑' n, F n x) ^ q ∂μ) ^ (1 / q) ≤
      ∑' n, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set B : ENNReal := ∑' n, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) with hB
  -- Minkowski for finitely many summands
  have hstep : ∀ N : ℕ,
      (∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ) ^ (1 / q) ≤
        ∑ n ∈ Finset.range N, (∫⁻ x, F n x ^ q ∂μ) ^ (1 / q) := by
    intro N
    induction N with
    | zero =>
        simp only [Finset.range_zero, Finset.sum_empty]
        rw [ENNReal.zero_rpow_of_pos hq0, lintegral_zero,
          ENNReal.zero_rpow_of_pos (by positivity : (0 : ℝ) < 1 / q)]
    | succ N ih =>
        have hmeasS : AEMeasurable (fun x => ∑ n ∈ Finset.range N, F n x) μ :=
          (Finset.measurable_sum _ fun n _ => hF n).aemeasurable
        simp only [Finset.sum_range_succ]
        refine le_trans (ENNReal.lintegral_Lp_add_le hmeasS
          (hF N).aemeasurable hq) ?_
        exact add_le_add ih le_rfl
  -- monotone convergence for the partial sums
  have hmeasN : ∀ N : ℕ,
      Measurable fun x => (∑ n ∈ Finset.range N, F n x) ^ q :=
    fun N => (Finset.measurable_sum _ fun n _ => hF n).pow_const q
  have hA : (∫⁻ x, (∑' n, F n x) ^ q ∂μ) ≤ B ^ q := by
    have hrw : ∀ x, (∑' n, F n x) ^ q =
        ⨆ N, (∑ n ∈ Finset.range N, F n x) ^ q := by
      intro x
      rw [ENNReal.tsum_eq_iSup_nat, ennreal_iSup_rpow hq0]
    have hmono : Monotone fun N : ℕ => fun x => (∑ n ∈ Finset.range N, F n x) ^ q := by
      intro N M hNM x
      refine ENNReal.rpow_le_rpow ?_ hq0.le
      refine Finset.sum_le_sum_of_subset ?_
      intro i hi
      simp only [Finset.mem_range] at hi ⊢
      omega
    calc (∫⁻ x, (∑' n, F n x) ^ q ∂μ)
        = ∫⁻ x, ⨆ N, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ :=
          lintegral_congr hrw
      _ = ⨆ N, ∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ :=
          lintegral_iSup hmeasN hmono
      _ ≤ B ^ q := by
          refine iSup_le fun N => ?_
          have h3 : (∫⁻ x, (∑ n ∈ Finset.range N, F n x) ^ q ∂μ) ^ (1 / q) ≤ B :=
            le_trans (hstep N) (ENNReal.sum_le_tsum _)
          have h4 := ENNReal.rpow_le_rpow h3 hq0.le
          rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne',
            ENNReal.rpow_one] at h4
  have h5 := ENNReal.rpow_le_rpow hA (by positivity : (0 : ℝ) ≤ 1 / q)
  rwa [← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one] at h5

theorem brsDyadic_le_one (m : ℕ) : brsDyadic m ≤ 1 := by
  rw [brsDyadic]
  exact pow_le_one₀ (by norm_num) (by norm_num)

/-- Each dyadic block of `R_1^+` is dominated by the mirrored centered blocks
of a covering of `E` at the same scale. -/
theorem brsR1PieceRight_le_iSup_centered {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR1PieceRight E g m r ≤
      ⨆ a ∈ ι, brsCenteredPiece (3 * brsDyadic m - a) (brsDyadic m) g r := by
  rw [brsR1PieceRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : t ≤ r / 2 := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hr2 : (2 : ℝ) ≤ r := by linarith
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hδ1 : brsDyadic m ≤ 1 := brsDyadic_le_one m
  have hsub : Ioc (r + t - 2 * brsDyadic m) (r + t - brsDyadic m) ⊆
      brsCenteredWindow (3 * brsDyadic m - a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ioc.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by linarith, by linarith⟩, ?_, ?_⟩
    · change r / 2 ≤ x
      linarith
    · change (1 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsCenteredPiece_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- The `L^q(r\,dr)` bound for a dyadic block of `R_1^+`. -/
theorem lintegral_brsR1PieceRight_pow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp : 1 < p) (hpq : p ≤ q) (m : ℕ) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q) ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
        (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set δ := brsDyadic m with hδdef
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        brsCenteredPiece (3 * δ - a) δ g r ^ q := by
    intro r
    have h1 : brsR1PieceRight E g m r ^ q ≤
        ∑ a ∈ ι, brsCenteredPiece (3 * δ - a) δ g r ^ q :=
      le_trans (ENNReal.rpow_le_rpow
        (brsR1PieceRight_le_iSup_centered hE hcov) hq0.le)
        (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece (3 * δ - a) δ g r)
    calc ENNReal.ofReal r * brsR1PieceRight E g m r ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece (3 * δ - a) δ g r ^ q :=
          mul_le_mul' le_rfl h1
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            brsCenteredPiece (3 * δ - a) δ g r ^ q := Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece (3 * δ - a) δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * brsR1PieceRight E g m r ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          brsCenteredPiece (3 * δ - a) δ g r ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          brsCenteredPiece (3 * δ - a) δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E δ : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hcard, hK]
        ring

/-- Minkowski's inequality for a countable sum, with the radial weight. -/
theorem lintegral_weight_rpow_tsum_le {q : ℝ} (hq : 1 ≤ q) {G : ℕ → ℝ → ENNReal}
    (hG : ∀ n, Measurable (G n)) :
    (∫⁻ r, ENNReal.ofReal r * (∑' n, G n r) ^ q) ^ (1 / q) ≤
      ∑' n, (∫⁻ r, ENNReal.ofReal r * G n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hFmeas : ∀ n, Measurable fun r : ℝ =>
      ENNReal.ofReal r ^ (1 / q) * G n r := fun n =>
    (((ENNReal.measurable_ofReal.comp measurable_id)).pow_const _).mul (hG n)
  have hkey := lintegral_rpow_tsum_le (μ := (volume : Measure ℝ)) hq hFmeas
  have h1 : ∀ r : ℝ, (∑' n, ENNReal.ofReal r ^ (1 / q) * G n r) ^ q =
      ENNReal.ofReal r * (∑' n, G n r) ^ q := by
    intro r
    rw [ENNReal.tsum_mul_left, ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
      ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have h2 : ∀ n : ℕ, (∫⁻ r, (ENNReal.ofReal r ^ (1 / q) * G n r) ^ q) =
      ∫⁻ r, ENNReal.ofReal r * G n r ^ q := by
    intro n
    refine lintegral_congr fun r => ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul, one_div,
      inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  simp_rw [h1, h2] at hkey
  exact hkey

/-- The `L^q(r\,dr)` bound for the supremum of the centered blocks of a
covering. -/
theorem lintegral_iSup_centered_pow_le {ι : Finset ℝ} {p q δ : ℝ} (hp : 1 < p)
    (hpq : p ≤ q) (hδ : 0 < δ) (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q) ≤
      (ι.card : ENNReal) *
        (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  set K : ENNReal := 2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
    (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q := by
    intro r
    calc ENNReal.ofReal r * (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q
        ≤ ENNReal.ofReal r * ∑ a ∈ ι, brsCenteredPiece (c a) δ g r ^ q :=
          mul_le_mul' le_rfl
            (iSup_rpow_le_sum hq0 ι fun a => brsCenteredPiece (c a) δ g r)
      _ = ∑ a ∈ ι, ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q :=
          Finset.mul_sum _ _ _
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ =>
      ENNReal.ofReal r * brsCenteredPiece (c a) δ g r ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_brsCenteredPiece hg).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * (⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          brsCenteredPiece (c a) δ g r ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          brsCenteredPiece (c a) δ g r ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsCenteredPiece_pow_le hp hpq hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (ι.card : ENNReal) *
          (2 * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1)) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p) := by
        rw [hK]
        ring

/-- The coefficient of the `m`-th dyadic block in BRS Proposition 5.2. -/
def brsProp52Coeff (E : Set ℝ) (p q : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1))) ^ (1 / q)

/-- Measurability of the supremum over a finite family of centered blocks. -/
theorem measurable_iSup_centered {ι : Finset ℝ} {δ : ℝ} (c : ℝ → ℝ)
    {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable fun r : ℝ => ⨆ a ∈ ι, brsCenteredPiece (c a) δ g r := by
  have : (fun r : ℝ => ⨆ a ∈ ι, brsCenteredPiece (c a) δ g r) =
      fun r : ℝ => ⨆ a ∈ (ι : Set ℝ), brsCenteredPiece (c a) δ g r := by
    funext r
    simp
  rw [this]
  exact Measurable.biSup _ (ι : Set ℝ).to_countable
    fun a _ => measurable_brsCenteredPiece hg

/-- **BRS Proposition 5.2, left half.** -/
theorem prop52_brsRemTwoOneLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneLeft E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp52Coeff E p q m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsCenteredPiece a (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r => c m * S m r with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_centered (fun a => a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m => (hSmeas m).const_mul _
  have hpt : ∀ r, brsRemTwoOneLeft E g r ≤ ∑' m, G m r := by
    intro r
    refine le_trans (brsRemTwoOneLeft_le_tsum hE)
      (ENNReal.tsum_le_tsum fun m => ?_)
    exact mul_le_mul' le_rfl (brsR1PieceLeft_le_iSup_centered hE (hι m))
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp52Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r * S m r ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
          M ^ (q / p) := by
      have h := lintegral_iSup_centered_pow_le (ι := ι m) hp hpq
        (brsDyadic_pos m) (fun a => a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
            M ^ (q / p)) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp52Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp52Coeff, ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0:ℝ) ≤ 1 / q), ← ENNReal.rpow_mul, hc]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneLeft E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (lintegral_mono fun r => ?_) (by positivity)
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hpt r) hq0.le)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp52Coeff E p q m * M ^ (1 / p) :=
        ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp52Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **BRS Proposition 5.2, right half.** -/
theorem prop52_brsRemTwoOneRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneRight E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp52Coeff E p q m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsCenteredPiece (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r => c m * S m r with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_centered (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m => (hSmeas m).const_mul _
  have hpt : ∀ r, brsRemTwoOneRight E g r ≤ ∑' m, G m r := by
    intro r
    refine le_trans (brsRemTwoOneRight_le_tsum hE)
      (ENNReal.tsum_le_tsum fun m => ?_)
    exact mul_le_mul' le_rfl (brsR1PieceRight_le_iSup_centered hE (hι m))
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp52Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r * S m r ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
          M ^ (q / p) := by
      have h := lintegral_iSup_centered_pow_le (ι := ι m) hp hpq
        (brsDyadic_pos m) (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r * S m r ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (2 * ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1)) *
            M ^ (q / p)) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp52Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp52Coeff, ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0:ℝ) ≤ 1 / q), ← ENNReal.rpow_mul, hc]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoOneRight E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) := by
        refine ENNReal.rpow_le_rpow (lintegral_mono fun r => ?_) (by positivity)
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hpt r) hq0.le)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp52Coeff E p q m * M ^ (1 / p) :=
        ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp52Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-! ## Signed centered windows, for the large-dilation remainders -/

/-- A window of length `3δ` moving with slope `σ = ±1` in the radius, cut down
to the region `s ≥ r/2`, `s ≥ 1/3` that the constraint `t ≥ 3r/2` supplies. -/
def brsWindowSigned (σ a δ r : ℝ) : Set ℝ :=
  Icc (σ * r - a) (σ * r - a + 3 * δ) ∩ (Ici (r / 2) ∩ Ici (1 / 3))

/-- The `L^1` mass of `g` on a signed window. -/
def brsPieceSigned (σ a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ∫⁻ s, (brsWindowSigned σ a δ r).indicator (fun s => ‖g s‖ₑ) s

theorem measurableSet_brsWindowSigned (σ a δ r : ℝ) :
    MeasurableSet (brsWindowSigned σ a δ r) :=
  measurableSet_Icc.inter (measurableSet_Ici.inter measurableSet_Ici)

theorem brsPieceSigned_eq_setLIntegral (σ a δ : ℝ) (g : ℝ → ℂ) (r : ℝ) :
    brsPieceSigned σ a δ g r = ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ := by
  rw [brsPieceSigned,
    lintegral_indicator (measurableSet_brsWindowSigned σ a δ r)]

theorem volume_brsWindowSigned_le {σ a δ r : ℝ} (_hδ : 0 ≤ δ) :
    volume (brsWindowSigned σ a δ r) ≤ ENNReal.ofReal (3 * δ) := by
  refine le_trans (measure_mono Set.inter_subset_left) ?_
  rw [Real.volume_Icc]
  exact ENNReal.ofReal_le_ofReal (by linarith)

theorem measurableSet_prod_brsWindowSigned (σ a δ : ℝ) :
    MeasurableSet {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1} := by
  have h1 : MeasurableSet {z : ℝ × ℝ | σ * z.1 - a ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h2 : MeasurableSet {z : ℝ × ℝ | z.2 ≤ σ * z.1 - a + 3 * δ} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h3 : MeasurableSet {z : ℝ × ℝ | z.1 / 2 ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have h4 : MeasurableSet {z : ℝ × ℝ | (1 / 3 : ℝ) ≤ z.2} :=
    measurableSet_le (by fun_prop) (by fun_prop)
  have hEq : {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1} =
      (({z : ℝ × ℝ | σ * z.1 - a ≤ z.2} ∩
        {z : ℝ × ℝ | z.2 ≤ σ * z.1 - a + 3 * δ}) ∩
        {z : ℝ × ℝ | z.1 / 2 ≤ z.2}) ∩ {z : ℝ × ℝ | (1 / 3 : ℝ) ≤ z.2} := by
    ext z
    simp only [brsWindowSigned, Set.mem_setOf_eq, Set.mem_inter_iff,
      Set.mem_Icc, Set.mem_Ici]
    tauto
  rw [hEq]
  exact ((h1.inter h2).inter h3).inter h4

theorem measurable_brsPieceSigned {σ a δ : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsPieceSigned σ a δ g) := by
  have hfun : Measurable fun z : ℝ × ℝ =>
      (brsWindowSigned σ a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2 := by
    have hEq : (fun z : ℝ × ℝ =>
        (brsWindowSigned σ a δ z.1).indicator (fun s => ‖g s‖ₑ) z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1}.indicator
          (fun z : ℝ × ℝ => ‖g z.2‖ₑ) z := by
      funext z
      by_cases hz : z.2 ∈ brsWindowSigned σ a δ z.1 <;> simp [hz]
    rw [hEq]
    exact (hg.comp measurable_snd).enorm.indicator
      (measurableSet_prod_brsWindowSigned σ a δ)
  exact hfun.lintegral_prod_right'

/-- For a fixed point, the radii whose signed window contains it form a set of
measure at most `3δ`. -/
theorem measure_setOf_mem_brsWindowSigned_le {σ a δ s : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (_hδ : 0 ≤ δ) :
    volume {r : ℝ | s ∈ brsWindowSigned σ a δ r} ≤ ENNReal.ofReal (3 * δ) := by
  rcases hσ with hσ | hσ
  · have hsub : {r : ℝ | s ∈ brsWindowSigned σ a δ r} ⊆
        Icc (s + a - 3 * δ) (s + a) := by
      intro r hr
      obtain ⟨⟨h1, h2⟩, _⟩ := hr
      rw [hσ, one_mul] at h1 h2
      exact ⟨by linarith, by linarith⟩
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  · have hsub : {r : ℝ | s ∈ brsWindowSigned σ a δ r} ⊆
        Icc (-s - a) (-s - a + 3 * δ) := by
      intro r hr
      obtain ⟨⟨h1, h2⟩, _⟩ := hr
      rw [hσ] at h1 h2
      constructor <;> [skip; skip] <;> nlinarith [h1, h2]
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
    exact ENNReal.ofReal_le_ofReal (by linarith)

/-- Tonelli for the signed windows. -/
theorem lintegral_brsWindowSigned_le {σ a δ : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (hδ : 0 ≤ δ) {Φ : ℝ → ENNReal} (hΦ : Measurable Φ) :
    (∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s := by
  have hjoint : Measurable fun z : ℝ × ℝ =>
      (brsWindowSigned σ a δ z.1).indicator Φ z.2 := by
    have hEq : (fun z : ℝ × ℝ => (brsWindowSigned σ a δ z.1).indicator Φ z.2) =
        fun z : ℝ × ℝ => {z : ℝ × ℝ | z.2 ∈ brsWindowSigned σ a δ z.1}.indicator
          (fun z : ℝ × ℝ => Φ z.2) z := by
      funext z
      by_cases hz : z.2 ∈ brsWindowSigned σ a δ z.1 <;> simp [hz]
    rw [hEq]
    exact (hΦ.comp measurable_snd).indicator
      (measurableSet_prod_brsWindowSigned σ a δ)
  rw [lintegral_lintegral_swap hjoint.aemeasurable,
    ← lintegral_const_mul _ hΦ]
  refine lintegral_mono fun s => ?_
  have hind : (fun r => (brsWindowSigned σ a δ r).indicator Φ s) =
      {r : ℝ | s ∈ brsWindowSigned σ a δ r}.indicator (fun _ => Φ s) := by
    funext r
    by_cases hr : s ∈ brsWindowSigned σ a δ r <;> simp [hr]
  have hmeas : MeasurableSet {r : ℝ | s ∈ brsWindowSigned σ a δ r} := by
    exact measurable_prodMk_right (measurableSet_prod_brsWindowSigned σ a δ)
  rw [hind, lintegral_indicator_const hmeas, mul_comm (Φ s)]
  exact mul_le_mul' (measure_setOf_mem_brsWindowSigned_le hσ hδ) le_rfl

/-- The elementary weight comparison on a signed window. -/
theorem rpow_weight_le_of_window {p r s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hr : 0 < r) (hrs : r / 2 ≤ s) (hs3 : (1 / 3 : ℝ) ≤ s) :
    r ^ (1 - p / 2) ≤ 2 * 3 ^ (p / 2) * s := by
  have hspos : (0 : ℝ) < s := by linarith
  have he0 : (0 : ℝ) ≤ 1 - p / 2 := by linarith
  have h1 : r ^ (1 - p / 2) ≤ (2 * s) ^ (1 - p / 2) :=
    Real.rpow_le_rpow hr.le (by linarith) he0
  have h2 : (2 * s) ^ (1 - p / 2) = 2 ^ (1 - p / 2) * s ^ (1 - p / 2) :=
    Real.mul_rpow (by norm_num) hspos.le
  have h3 : (2 : ℝ) ^ (1 - p / 2) ≤ 2 := by
    calc (2 : ℝ) ^ (1 - p / 2) ≤ 2 ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      _ = 2 := Real.rpow_one 2
  have h4 : s ^ (1 - p / 2) ≤ 3 ^ (p / 2) * s := by
    have hsplit : s ^ (1 - p / 2) = s ^ (-(p / 2)) * s := by
      have h := Real.rpow_add hspos (-(p / 2)) 1
      rw [Real.rpow_one] at h
      rw [show (1 : ℝ) - p / 2 = -(p / 2) + 1 by ring, h]
    have hbase : s ^ (-(p / 2)) ≤ (1 / 3 : ℝ) ^ (-(p / 2)) :=
      Real.rpow_le_rpow_of_nonpos (by norm_num) hs3 (by linarith)
    have hval : ((1 : ℝ) / 3) ^ (-(p / 2)) = 3 ^ (p / 2) := by
      rw [one_div, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num),
        inv_inv]
    rw [hsplit]
    calc s ^ (-(p / 2)) * s ≤ ((1 : ℝ) / 3) ^ (-(p / 2)) * s :=
          mul_le_mul_of_nonneg_right hbase hspos.le
      _ = 3 ^ (p / 2) * s := by rw [hval]
  have hs0 : (0 : ℝ) ≤ s ^ (1 - p / 2) := Real.rpow_nonneg hspos.le _
  calc r ^ (1 - p / 2) ≤ 2 ^ (1 - p / 2) * s ^ (1 - p / 2) := by
        rw [← h2]; exact h1
    _ ≤ 2 * s ^ (1 - p / 2) := mul_le_mul_of_nonneg_right h3 hs0
    _ ≤ 2 * (3 ^ (p / 2) * s) := by
        exact mul_le_mul_of_nonneg_left h4 (by norm_num)
    _ = 2 * 3 ^ (p / 2) * s := by ring

/-- The diagonal `L^p(r\,dr)` bound for a signed centered block. -/
theorem lintegral_brsPieceSigned_diag_le {σ a δ p : ℝ} (hσ : σ = 1 ∨ σ = -1)
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p) ≤
      ENNReal.ofReal (2 * 3 ^ (p / 2)) * ENNReal.ofReal (3 * δ) ^ p *
        ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ :=
    (ENNReal.measurable_ofReal.comp measurable_id).mul (hg.enorm.pow_const p)
  have hHolder : ∀ r : ℝ, brsPieceSigned σ a δ g r ^ p ≤
      ENNReal.ofReal (3 * δ) ^ (p - 1) *
        ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p := by
    intro r
    rcases eq_or_lt_of_le hp1 with hp | hp
    · rw [brsPieceSigned_eq_setLIntegral, ← hp]
      simp
    · rw [brsPieceSigned_eq_setLIntegral]
      calc (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ) ^ p
          ≤ ((∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
              volume (brsWindowSigned σ a δ r) ^ (1 - 1 / p)) ^ p :=
            ENNReal.rpow_le_rpow (lintegral_window_holder hp hg) hp0.le
        _ = (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) *
              volume (brsWindowSigned σ a δ r) ^ (p - 1) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
              ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp0.ne',
              ENNReal.rpow_one]
            congr 2
            field_simp
        _ ≤ (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) *
              ENNReal.ofReal (3 * δ) ^ (p - 1) :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
              (volume_brsWindowSigned_le hδ.le) (by linarith))
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p := by ring
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p ≤
      ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      simp
    · have hreal : r * (r ^ (-(1 / 2) : ℝ)) ^ p = r ^ (1 - p / 2) := by
        have h1 : (r ^ (-(1 / 2) : ℝ)) ^ p = r ^ (-(p / 2)) := by
          rw [← Real.rpow_mul hr.le]
          congr 1
          ring
        have h2 : r ^ (1 - p / 2) = r ^ (1 : ℝ) * r ^ (-(p / 2)) := by
          rw [← Real.rpow_add hr, sub_eq_add_neg]
        rw [h1, h2, Real.rpow_one]
      have hweight : ENNReal.ofReal r *
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p =
          ENNReal.ofReal (r ^ (1 - p / 2)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hr.le _) hp0.le,
          ← ENNReal.ofReal_mul hr.le, hreal]
      have hmono : ENNReal.ofReal (r ^ (1 - p / 2)) *
          (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ≤
          ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
        rw [lintegral_indicator (measurableSet_brsWindowSigned σ a δ r),
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_mono_ae ?_
        filter_upwards [self_mem_ae_restrict
          (measurableSet_brsWindowSigned σ a δ r)] with s hs
        have hle := rpow_weight_le_of_window hp1 hp2 hr hs.2.1 hs.2.2
        have h13 : (1 / 3 : ℝ) ≤ s := hs.2.2
        have hs0 : (0 : ℝ) ≤ s := by linarith
        calc ENNReal.ofReal (r ^ (1 - p / 2)) * ‖g s‖ₑ ^ p
            ≤ ENNReal.ofReal (2 * 3 ^ (p / 2) * s) * ‖g s‖ₑ ^ p :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) * Φ s := by
              rw [hΦdef, ENNReal.ofReal_mul (by positivity)]
              ring
      calc ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p
          = ENNReal.ofReal (r ^ (1 - p / 2)) * brsPieceSigned σ a δ g r ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← mul_assoc, hweight]
        _ ≤ ENNReal.ofReal (r ^ (1 - p / 2)) *
              (ENNReal.ofReal (3 * δ) ^ (p - 1) *
                ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) :=
            mul_le_mul' le_rfl (hHolder r)
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              (ENNReal.ofReal (r ^ (1 - p / 2)) *
                ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) := by ring
        _ ≤ ENNReal.ofReal (3 * δ) ^ (p - 1) *
              (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
                ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) :=
            mul_le_mul' le_rfl hmono
        _ = ENNReal.ofReal (3 * δ) ^ (p - 1) *
              ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by ring
  have hCne : ENNReal.ofReal (3 * δ) ^ (p - 1) *
      ENNReal.ofReal (2 * 3 ^ (p / 2)) ≠ ⊤ :=
    ENNReal.mul_ne_top
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) ENNReal.ofReal_ne_top)
      ENNReal.ofReal_ne_top
  calc (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ p)
      ≤ ∫⁻ r, ENNReal.ofReal (3 * δ) ^ (p - 1) *
          ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := lintegral_mono hpt
    _ = ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s :=
        lintegral_const_mul' _ _ hCne
    _ ≤ ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          (ENNReal.ofReal (3 * δ) * ∫⁻ s, Φ s) :=
        mul_le_mul' le_rfl (lintegral_brsWindowSigned_le hσ hδ.le hΦmeas)
    _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          (ENNReal.ofReal (3 * δ) ^ (p - 1) * ENNReal.ofReal (3 * δ)) *
          ∫⁻ s, Φ s := by ring
    _ = ENNReal.ofReal (2 * 3 ^ (p / 2)) * ENNReal.ofReal (3 * δ) ^ p *
          ∫⁻ s, Φ s := by
        congr 2
        have h := ENNReal.rpow_add_of_nonneg (x := ENNReal.ofReal (3 * δ))
          (y := p - 1) (z := 1) (by linarith) (by norm_num)
        rw [sub_add_cancel, ENNReal.rpow_one] at h
        exact h.symm

/-! ## The dyadic blocks of the large-dilation remainders -/

/-- `R_2^{-,m}`. -/
def brsR2PieceLeft (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m), ‖g s‖ₑ

/-- `R_2^{+,m}`. -/
def brsR2PieceRight (E : Set ℝ) (g : ℝ → ℂ) (m : ℕ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t,
      ‖g s‖ₑ

/-- The dyadic decomposition of `R_2^-`. -/
theorem brsRemTwoTwoLeft_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
          brsR2PieceLeft E g m r) := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t - r ≤ t := by linarith
  set F : ℝ → ℂ := fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hsplitmul : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
      ‖∫ s in (t - r)..t, F s‖) =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖∫ s in (t - r)..t, F s‖ :=
    ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
  rw [hsplitmul, ENNReal.tsum_mul_left]
  refine mul_le_mul' le_rfl ?_
  have hstep2 : ENNReal.ofReal ‖∫ s in (t - r)..t, F s‖ ≤
      ∫⁻ s in Ioo (t - r) t, ‖F s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo (t - r) t ⊆
      ⋃ m : ℕ, Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m) := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := s - (t - r)) (by linarith [hs.1]) (by linarith [hs.2])
    exact mem_iUnion.mpr ⟨m, ⟨by linarith, by linarith⟩⟩
  refine le_trans hstep2 (le_trans (le_trans (lintegral_mono_set hcover)
    (lintegral_iUnion_le _ _)) (ENNReal.tsum_le_tsum fun m => ?_))
  have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
    ENNReal.ofReal_ne_top
  have hbound : (∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m),
      ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m),
          ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict measurableSet_Ico] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1])
      (by linarith [hs.1, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR2PieceLeft]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- The dyadic decomposition of `R_2^+`. -/
theorem brsRemTwoTwoRight_le_tsum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      ∑' m : ℕ, ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
          brsR2PieceRight E g m r) := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t ≤ t + r := by linarith
  set F : ℝ → ℂ := fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    with hF
  have hsplitmul : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
      ‖∫ s in t..(t + r), F s‖) =
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖∫ s in t..(t + r), F s‖ :=
    ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
  rw [hsplitmul, ENNReal.tsum_mul_left]
  refine mul_le_mul' le_rfl ?_
  have hstep2 : ENNReal.ofReal ‖∫ s in t..(t + r), F s‖ ≤
      ∫⁻ s in Ioo t (t + r), ‖F s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    exact le_trans (enorm_integral_le_lintegral_enorm _)
      (le_of_eq (setLIntegral_congr (Ioo_ae_eq_Ioc).symm))
  have hcover : Ioo t (t + r) ⊆
      ⋃ m : ℕ, Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t := by
    intro s hs
    obtain ⟨m, hm1, hm2⟩ := exists_brsDyadic_mem
      (x := t + r - s) (by linarith [hs.2]) (by linarith [hs.1])
    exact mem_iUnion.mpr ⟨m, ⟨⟨by linarith, by linarith⟩, le_of_lt hs.1⟩⟩
  refine le_trans hstep2 (le_trans (le_trans (lintegral_mono_set hcover)
    (lintegral_iUnion_le _ _)) (ENNReal.tsum_le_tsum fun m => ?_))
  have hne : ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) ≠ ⊤ :=
    ENNReal.ofReal_ne_top
  have hmeasset : MeasurableSet
      (Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t) :=
    measurableSet_Ioc.inter measurableSet_Ici
  have hbound : (∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩
      Ici t, ‖F s‖ₑ) ≤ ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t,
          ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ hne]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hmeasset] with s hs
    simp only [hF]
    exact enorm_weight_mul_le (by linarith [hs.1.2])
      (by linarith [hs.1.2, brsDyadic_pos m])
  refine le_trans hbound (mul_le_mul' le_rfl ?_)
  rw [brsR2PieceRight]
  exact le_iSup₂_of_le t ⟨htE, htr⟩ le_rfl

/-- Domination of the blocks of `R_2^-` by signed centered blocks. -/
theorem brsR2PieceLeft_le_iSup_signed {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR2PieceLeft E g m r ≤
      ⨆ a ∈ ι, brsPieceSigned (-1) (-a) (brsDyadic m) g r := by
  rw [brsR2PieceLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ico (t - r + brsDyadic m) (t - r + 2 * brsDyadic m) ⊆
      brsWindowSigned (-1) (-a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨hx1, hx2⟩ := Set.mem_Ico.mp hx
    refine ⟨Set.mem_Icc.mpr ⟨by nlinarith, by nlinarith⟩, ?_, ?_⟩
    · change r / 2 ≤ x
      linarith
    · change (1 / 3 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsPieceSigned_eq_setLIntegral]
  exact lintegral_mono_set hsub

/-- Domination of the blocks of `R_2^+` by signed centered blocks. -/
theorem brsR2PieceRight_le_iSup_signed {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {ι : Finset ℝ} {m : ℕ} (hcov : IsIntervalCover E (brsDyadic m) ι)
    {g : ℝ → ℂ} {r : ℝ} :
    brsR2PieceRight E g m r ≤
      ⨆ a ∈ ι, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r := by
  rw [brsR2PieceRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov htE)
  obtain ⟨hm1, hm2⟩ := Set.mem_Icc.mp hmem
  have hδ : 0 < brsDyadic m := brsDyadic_pos m
  have hsub : Ioc (t + r - 2 * brsDyadic m) (t + r - brsDyadic m) ∩ Ici t ⊆
      brsWindowSigned 1 (3 * brsDyadic m - a) (brsDyadic m) r := by
    intro x hx
    obtain ⟨⟨hx1, hx2⟩, hx3⟩ := hx
    have hxt : t ≤ x := hx3
    refine ⟨Set.mem_Icc.mpr ⟨by nlinarith, by nlinarith⟩, ?_, ?_⟩
    · change r / 2 ≤ x
      linarith
    · change (1 / 3 : ℝ) ≤ x
      linarith
  refine le_iSup₂_of_le a ha ?_
  rw [brsPieceSigned_eq_setLIntegral]
  exact lintegral_mono_set hsub

theorem measurable_iSup_signed {ι : Finset ℝ} {σ δ : ℝ} (c : ℝ → ℝ)
    {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable fun r : ℝ => ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r := by
  have hEq : (fun r : ℝ => ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) =
      fun r : ℝ => ⨆ a ∈ (ι : Set ℝ), brsPieceSigned σ (c a) δ g r := by
    funext r
    simp
  rw [hEq]
  exact Measurable.biSup _ (ι : Set ℝ).to_countable
    fun a _ => measurable_brsPieceSigned hg

theorem measurable_rpow_neg_half :
    Measurable fun r : ℝ => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) :=
  ENNReal.measurable_ofReal.comp
    (Measurable.pow_const (measurable_id : Measurable fun r : ℝ => r)
      (-(1 / 2) : ℝ))

/-- The `L^p(r\,dr)` bound for the supremum of signed centered blocks. -/
theorem lintegral_iSup_signed_diag_le {ι : Finset ℝ} {σ δ p : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hδ : 0 < δ)
    (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p) ≤
      (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ENNReal.ofReal (3 * δ) ^ p) *
        ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  set K : ENNReal := ENNReal.ofReal (2 * 3 ^ (p / 2)) *
    ENNReal.ofReal (3 * δ) ^ p * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          brsPieceSigned σ (c a) δ g r) ^ p := by
    intro r
    have hsum := iSup_rpow_le_sum hp0 ι fun a => brsPieceSigned σ (c a) δ g r
    calc ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p
        = ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p *
            (⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, mul_assoc]
      _ ≤ ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ p *
            ∑ a ∈ ι, brsPieceSigned σ (c a) δ g r ^ p :=
          mul_le_mul' le_rfl hsum
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              brsPieceSigned σ (c a) δ g r) ^ p := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, mul_assoc]
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ => ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        brsPieceSigned σ (c a) δ g r) ^ p := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_rpow_neg_half.mul (measurable_brsPieceSigned hg)).pow_const p)
  calc (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ p)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ p := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ p :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsPieceSigned_diag_le hσ hp1 hp2 hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
          ENNReal.ofReal (3 * δ) ^ p) *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
        rw [hK]
        ring

/-- The coefficient of the `m`-th dyadic block in BRS Lemma 5.3. -/
def brsLemma53Coeff (E : Set ℝ) (p : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
        ENNReal.ofReal (3 * brsDyadic m) ^ p)) ^ (1 / p)

/-- **BRS Lemma 5.3 for `1 ≤ p ≤ 2`, left half.** -/
theorem lemma53_brsRemTwoTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p) ≤
      (∑' m : ℕ, brsLemma53Coeff E p m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned (-1) (-a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => -a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ p := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hp0.le)
      refine le_trans (brsRemTwoTwoLeft_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceLeft E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceLeft_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) ≤
      brsLemma53Coeff E p m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ p ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ p) =
        c m ^ p * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ENNReal.ofReal (3 * brsDyadic m) ^ p) * M := by
      have h := lintegral_iSup_signed_diag_le (ι := ι m) (σ := (-1 : ℝ))
        (Or.inr rfl) hp1 hp2 (brsDyadic_pos m) (fun a => -a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ^ (1 / p) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p),
            ← ENNReal.rpow_mul, mul_one_div, div_self hp0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ENNReal.ofReal (3 * brsDyadic m) ^ p) * M) ^ (1 / p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsLemma53Coeff E p m * M ^ (1 / p) := by
          rw [brsLemma53Coeff, hc,
            ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p)]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) :=
        lintegral_weight_rpow_tsum_le hp1 hGmeas
    _ ≤ ∑' m, brsLemma53Coeff E p m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsLemma53Coeff E p m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **BRS Lemma 5.3 for `1 ≤ p ≤ 2`, right half.** -/
theorem lemma53_brsRemTwoTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p) ≤
      (∑' m : ℕ, brsLemma53Coeff E p m) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ p := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hp0.le)
      refine le_trans (brsRemTwoTwoRight_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceRight E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceRight_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) ≤
      brsLemma53Coeff E p m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ p ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hp0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ p) =
        c m ^ p * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
            ENNReal.ofReal (3 * brsDyadic m) ^ p) * M := by
      have h := lintegral_iSup_signed_diag_le (ι := ι m) (σ := (1 : ℝ))
        (Or.inl rfl) hp1 hp2 (brsDyadic_pos m)
        (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ p) ^ (1 / p) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p),
            ← ENNReal.rpow_mul, mul_one_div, div_self hp0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (p / 2)) *
              ENNReal.ofReal (3 * brsDyadic m) ^ p) * M) ^ (1 / p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsLemma53Coeff E p m * M ^ (1 / p) := by
          rw [brsLemma53Coeff, hc,
            ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p)]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ p) ^ (1 / p) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ p) ^ (1 / p) :=
        lintegral_weight_rpow_tsum_le hp1 hGmeas
    _ ≤ ∑' m, brsLemma53Coeff E p m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsLemma53Coeff E p m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-! ## (5.2): the localized covering quantities `ω_m^{p,q}(E,k)` -/

/-- Covering numbers are monotone in the set. -/
theorem intervalCoveringNumber_mono_set {E F : Set ℝ} (hEF : F ⊆ E) {δ : ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hδ : 0 < δ) :
    intervalCoveringNumber F δ ≤ intervalCoveringNumber E δ := by
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  have hιF : IsIntervalCover F δ ι := IsIntervalCover.mono hEF hι
  calc intervalCoveringNumber F δ ≤ ι.card := intervalCoveringNumber_le_card hιF
    _ = intervalCoveringNumber E δ := hcard

/-- **(5.2) of BRS.**  The localized covering quantity, the supremum over
intervals `J ⊆ [1,2]` of length `2^{-k}` of
`2^{-k(2/q - 1/p)} N(E ∩ J, 2^{-m-k})^{1/q}`. -/
def brsOmegaTwo (E : Set ℝ) (p q : ℝ) (m k : ℕ) : ENNReal :=
  ⨆ u ∈ Icc (1 : ℝ) (2 - brsDyadic k),
    ENNReal.ofReal (brsDyadic k ^ (2 / q - 1 / p)) *
      (intervalCoveringNumber (E ∩ Icc u (u + brsDyadic k))
        (brsDyadic (m + k)) : ENNReal) ^ (1 / q)

/-- The localized quantity is dominated by the global covering number. -/
theorem brsOmegaTwo_le_global {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hq : 0 < q) (m k : ℕ) :
    brsOmegaTwo E p q m k ≤
      ENNReal.ofReal (brsDyadic k ^ (2 / q - 1 / p)) *
        (intervalCoveringNumber E (brsDyadic (m + k)) : ENNReal) ^ (1 / q) := by
  refine iSup₂_le fun u _ => ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ (by positivity))
  exact_mod_cast Nat.cast_le.mpr (intervalCoveringNumber_mono_set
    Set.inter_subset_left hE (brsDyadic_pos (m + k)))

/-- At scale `k = 0` the localized quantity is the global one. -/
theorem brsOmegaTwo_zero_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hq : 0 < q) (m : ℕ) :
    brsOmegaTwo E p q m 0 ≤
      (intervalCoveringNumber E (brsDyadic m) : ENNReal) ^ (1 / q) := by
  have h := brsOmegaTwo_le_global (p := p) hE hq m 0
  simpa [brsDyadic, Real.one_rpow] using h

/-! ## Section 2 of BRS: the three covering estimates -/

/-- **(2.1) of BRS.**  The Minkowski bound, uniformly over subintervals. -/
theorem brs_cover_bound_minkowski {E : Set ℝ} {β : ℝ}
    (hβ : HasUpperMinkowskiExponent E β) {ε : ℝ} (hε : 0 < ε) :
    ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 → ∀ J : Set ℝ,
      (intervalCoveringNumber (E ∩ J) δ : ℝ) ≤ C * δ ^ (-(β + ε)) := by
  obtain ⟨C, hC, hbound⟩ := hβ ε hε
  refine ⟨C, hC, fun δ hδ hδ1 J => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hbound δ hδ hδ1
  have hcov : IsIntervalCover (E ∩ J) δ ι :=
    IsIntervalCover.mono Set.inter_subset_left hι
  calc (intervalCoveringNumber (E ∩ J) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hcov
    _ ≤ C * δ ^ (-(β + ε)) := hcard

/-- **(2.2) of BRS.**  The Assouad-spectrum bound at scale parameter `θ`. -/
theorem brs_cover_bound_assouad {E : Set ℝ} {θ γ' : ℝ}
    (hθγ : HasUpperAssouadSpectrumExponent E θ γ') :
    ∃ C : ℝ, 0 < C ∧ ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ' := by
  obtain ⟨C, hC, hbound⟩ := hθγ
  refine ⟨C, hC, fun δ a b hδ hδ1 ha hab hb hscale => ?_⟩
  obtain ⟨ι, hι, hcard⟩ := hbound δ a b hδ hδ1 ha hab hb hscale
  calc (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hι
    _ ≤ C * ((b - a) / δ) ^ γ' := hcard

/-- **(2.3) of BRS.**  The trivial bound for a short interval. -/
theorem brs_cover_bound_trivial {E : Set ℝ} {δ a b : ℝ} (hδ : 0 < δ)
    (hab : a ≤ b) :
    (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (b - a) / δ + 3 := by
  obtain ⟨ι, hι, hcard⟩ := exists_intervalCover_of_subset_Icc
    (F := E ∩ Icc a b) hδ hab Set.inter_subset_right
  have hceil : (Nat.ceil ((b - a) / δ) : ℝ) ≤ (b - a) / δ + 1 :=
    (Nat.ceil_lt_add_one (by positivity)).le
  calc (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ (ι.card : ℝ) := by
        exact_mod_cast intervalCoveringNumber_le_card hι
    _ ≤ (Nat.ceil ((b - a) / δ) : ℝ) + 2 := hcard
    _ ≤ (b - a) / δ + 3 := by linarith

/-! ## Lemma 2.1 of BRS: two-sided bounds for `ν♯` -/

/-- The elementary inequality behind the upper bound of BRS Lemma 2.1. -/
theorem brs_legendre_term_le {α β γ θ σ : ℝ} (hα : 0 ≤ α) (_hβ0 : 0 ≤ β)
    (hγ0 : 0 < γ) (_hθ0 : 0 ≤ θ) (hθ1 : θ < 1) (_hσ0 : 0 ≤ σ)
    (hMink : (1 - θ) * σ ≤ β) (hQA : σ ≤ γ) :
    θ * α + (1 - θ) * σ ≤ max α ((1 - β / γ) * α + β) := by
  rcases le_or_gt θ (1 - β / γ) with hcase | hcase
  · have h1 : θ * α ≤ (1 - β / γ) * α := mul_le_mul_of_nonneg_right hcase hα
    calc θ * α + (1 - θ) * σ ≤ (1 - β / γ) * α + β := by linarith
      _ ≤ max α ((1 - β / γ) * α + β) := le_max_right _ _
  · have hθpos : 0 < 1 - θ := by linarith
    have h2 : (1 - θ) * σ ≤ (1 - θ) * γ :=
      mul_le_mul_of_nonneg_left hQA hθpos.le
    rcases le_or_gt γ α with hγα | hγα
    · have h3 : (1 - θ) * γ ≤ (1 - θ) * α :=
        mul_le_mul_of_nonneg_left hγα hθpos.le
      calc θ * α + (1 - θ) * σ ≤ θ * α + (1 - θ) * α := by linarith
        _ = α := by ring
        _ ≤ max α ((1 - β / γ) * α + β) := le_max_left _ _
    · have hβγ : β / γ * γ = β := div_mul_cancel₀ β hγ0.ne'
      have h4 : θ * α + (1 - θ) * γ ≤ (1 - β / γ) * α + β := by
        have hd : (1 - β / γ) * α + β - (θ * α + (1 - θ) * γ) =
            (θ - (1 - β / γ)) * (γ - α) := by
          field_simp
          ring
        nlinarith [hd, hcase, hγα]
      calc θ * α + (1 - θ) * σ ≤ θ * α + (1 - θ) * γ := by linarith
        _ ≤ (1 - β / γ) * α + β := h4
        _ ≤ max α ((1 - β / γ) * α + β) := le_max_right _ _

/-- **BRS Lemma 2.1.**  For `α ≥ 0` the Legendre--Assouad function satisfies
`α ≤ ν♯(α) ≤ max(α, (1 - β/γ)α + β)`, where the Minkowski and quasi-Assouad
hypotheses enter through the corresponding bounds for the Assouad spectrum. -/
theorem lemma21_brs {E : Set ℝ} (hE : E.Nonempty) {α β γ : ℝ} (hα : 0 ≤ α)
    (hβ0 : 0 ≤ β) (hγ0 : 0 < γ)
    (hσ0 : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → 0 ≤ Auto.Spherical.BRRS.brrsAssouadSpectrum E θ)
    (hMink : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → (1 - θ) * Auto.Spherical.BRRS.brrsAssouadSpectrum E θ ≤ β)
    (hQA : ∀ θ : ℝ, 0 ≤ θ → θ < 1 → Auto.Spherical.BRRS.brrsAssouadSpectrum E θ ≤ γ) :
    α ≤ brrsLegendreAssouadFunction E α ∧
      brrsLegendreAssouadFunction E α ≤ max α ((1 - β / γ) * α + β) := by
  refine ⟨Auto.Spherical.BRRS.le_brrsLegendreAssouadFunction_of_nonempty hE hα, ?_⟩
  show Auto.Spherical.BRRS.brrsLegendreAssouadFunction E α ≤
    max α ((1 - β / γ) * α + β)
  rw [brrsLegendreAssouadFunction_eq_brrsAssouadLegendreTransform_of_nonempty_of_nonneg hE hα,
    Auto.Spherical.BRRS.brrsAssouadLegendreTransform]
  refine Real.sSup_le ?_ (le_trans hα (le_max_left _ _))
  rintro x ⟨θ, hθ, rfl⟩
  obtain ⟨hθ0, hθ1⟩ := hθ
  simp only
  by_cases h1 : θ = 1
  · have hpot : Auto.Spherical.BRRS.brrsAssouadPotential E θ = 0 := by
      simp [Auto.Spherical.BRRS.brrsAssouadPotential, h1]
    rw [hpot, h1]
    simp
  · have hθlt : θ < 1 := lt_of_le_of_ne hθ1 h1
    have hpot : Auto.Spherical.BRRS.brrsAssouadPotential E θ =
        -(1 - θ) * Auto.Spherical.BRRS.brrsAssouadSpectrum E θ := by
      simp [Auto.Spherical.BRRS.brrsAssouadPotential, h1]
    rw [hpot]
    have hterm : θ * α - -(1 - θ) * Auto.Spherical.BRRS.brrsAssouadSpectrum E θ =
        θ * α + (1 - θ) * Auto.Spherical.BRRS.brrsAssouadSpectrum E θ := by ring
    rw [hterm]
    exact brs_legendre_term_le hα hβ0 hγ0 hθ0 hθlt (hσ0 θ hθ0 hθlt)
      (hMink θ hθ0 hθlt) (hQA θ hθ0 hθlt)

/-! ## (5.5): splitting `R_2^-` at the singularity -/

/-- The cutoff scale `2^{-11} r` of the BRS splitting. -/
def brsCutScale (r : ℝ) : ℝ := r / 2048

theorem brsCutScale_pos {r : ℝ} (hr : 0 < r) : 0 < brsCutScale r := by
  rw [brsCutScale]
  positivity

/-- Integrability of the singular weight against a continuous function. -/
theorem intervalIntegrable_absWeight_complex {g : ℝ → ℂ} (hg : Continuous g)
    {a b : ℝ} (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) volume a b := by
  have hreal : IntervalIntegrable (fun s => (s - a) ^ (-(1 / 2) : ℝ))
      volume a b := intervalIntegrable_left_weight a b
  have habs : IntervalIntegrable (fun s => |s - a| ^ (-(1 / 2) : ℝ))
      volume a b := by
    refine hreal.congr ?_
    intro s hs
    rw [uIoc_of_le hab] at hs
    obtain ⟨hs1, hs2⟩ := hs
    change (s - a) ^ (-(1 / 2) : ℝ) = |s - a| ^ (-(1 / 2) : ℝ)
    rw [abs_of_pos (by linarith : (0 : ℝ) < s - a)]
  have hcast : IntervalIntegrable
      (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ)) volume a b :=
    ⟨habs.1.ofReal, habs.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn

/-- `𝒜`: the part of `R_2^-` near the endpoint singularity. -/
def brsANearLeft (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Iio (t - r + brsCutScale r)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ`: the part of `R_2^-` away from the endpoint singularity. -/
def brsBFarLeft (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in (t - r)..t,
      (Ici (t - r + brsCutScale r)).indicator
        (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5) of BRS.**  `R_2^-` splits into its near and far parts. -/
theorem brsRemTwoTwoLeft_le_add {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoLeft E g r ≤ brsANearLeft E g r + brsBFarLeft E g r := by
  rw [brsRemTwoTwoLeft]
  refine iSup₂_le fun t ht => ?_
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  set F : ℝ → ℂ := fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume a t :=
    intervalIntegrable_absWeight_complex hg hab
  have hnear : IntervalIntegrable
      ((Iio (a + brsCutScale r)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Iio, hfull.2.indicator measurableSet_Iio⟩
  have hfar : IntervalIntegrable
      ((Ici (a + brsCutScale r)).indicator F) volume a t :=
    ⟨hfull.1.indicator measurableSet_Ici, hfull.2.indicator measurableSet_Ici⟩
  have hsplit : ∀ s : ℝ, F s = (Iio (a + brsCutScale r)).indicator F s +
      (Ici (a + brsCutScale r)).indicator F s := by
    intro s
    by_cases hs : s < a + brsCutScale r
    · rw [Set.indicator_of_mem (show s ∈ Iio (a + brsCutScale r) from hs),
        Set.indicator_of_notMem
          (show s ∉ Ici (a + brsCutScale r) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Iio (a + brsCutScale r) from hs),
        Set.indicator_of_mem
          (show s ∈ Ici (a + brsCutScale r) from not_lt.mp hs)]
      ring
  have hint : (∫ s in a..t, F s) =
      (∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s) +
        ∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in a..t, F s‖ ≤
      ‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖ +
        ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖ +
            ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in a..t, (Iio (a + brsCutScale r)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearLeft E g r + brsBFarLeft E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearLeft]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarLeft]
          exact le_iSup₂_of_le t ht le_rfl

/-! ## (5.6): the far part of `R_2^-` -/

/-- The constant bookkeeping in the far-part bound. -/
theorem brs_far_constant_identity {p r : ℝ} (_hp : 0 < p) (hr : 0 < r) :
    r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
      (3 ^ (1 / p) * r ^ (1 - 1 / p))) =
      2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ) := by
  have hcut : brsCutScale r ^ (-(1 / 2) : ℝ) =
      2048 ^ (1 / 2 : ℝ) * r ^ (-(1 / 2) : ℝ) := by
    rw [brsCutScale, Real.div_rpow hr.le (by norm_num : (0 : ℝ) ≤ 2048),
      Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2048)]
    field_simp
  have hpow : r ^ (-(1 / 2) : ℝ) * (r ^ (-(1 / 2) : ℝ) * r ^ (1 - 1 / p)) =
      r ^ (-(1 / p) : ℝ) := by
    rw [← Real.rpow_add hr, ← Real.rpow_add hr]
    congr 1
    ring
  rw [hcut]
  calc r ^ (-(1 / 2) : ℝ) * (2048 ^ (1 / 2 : ℝ) * r ^ (-(1 / 2) : ℝ) *
        (3 ^ (1 / p) * r ^ (1 - 1 / p)))
      = 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        (r ^ (-(1 / 2) : ℝ) * (r ^ (-(1 / 2) : ℝ) * r ^ (1 - 1 / p))) := by ring
    _ = 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ) := by rw [hpow]

/-- The far part vanishes for large radii. -/
theorem brsBFarLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ}
    {r : ℝ} (hr : 4 / 3 < r) : brsBFarLeft E g r = 0 := by
  rw [brsBFarLeft]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- The pointwise bound for the far part. -/
theorem brsBFarLeft_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsBFarLeft E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t - r ≤ t := by linarith
  set a : ℝ := t - r with ha
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc a t ∩ Ici (a + brsCutScale r) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  -- the integral of the far piece is supported in `W`
  have hstep1 : ENNReal.ofReal ‖∫ s in a..t,
      (Ici (a + brsCutScale r)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a t, ‖(Ici (a + brsCutScale r)).indicator
        (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a t
      · by_cases h2 : a + brsCutScale r ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem
              (show s ∈ Ici (a + brsCutScale r) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Ici (a + brsCutScale r) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  -- the weight is bounded on `W`
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|s - a| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + brsCutScale r ≤ s := hs.2
    have habs : |s - a| = s - a := abs_of_nonneg (by linarith)
    have hle : |s - a| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  -- Hölder on `W`
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : a < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by
      have : t / 3 ≤ a := by
        rw [ha]
        linarith
      linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  -- combine
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in a..t,
        (Ici (a + brsCutScale r)).indicator
          (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in a..t, (Ici (a + brsCutScale r)).indicator
            (fun s => ((|s - a| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor

/-- **(5.6) of BRS.**  The far part of `R_2^-` maps `L^p(s ds)` into
`L^q(r dr)` whenever `1 < p` and `q < 2p`. -/
theorem prop56_brsBFarLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsBFarLeft E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsBFarLeft_le hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsBFarLeft E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsBFarLeft E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsBFarLeft_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp

/-! ## (5.5) and (5.6) for `R_2^+` -/

/-- Integrability of the right-endpoint singular weight. -/
theorem intervalIntegrable_absWeightRight_complex {g : ℝ → ℂ} (hg : Continuous g)
    {a b : ℝ} (hab : a ≤ b) :
    IntervalIntegrable
      (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) volume a b := by
  have hreal : IntervalIntegrable (fun s => (b - s) ^ (-(1 / 2) : ℝ))
      volume a b := intervalIntegrable_right_weight a b
  have habs : IntervalIntegrable (fun s => |b - s| ^ (-(1 / 2) : ℝ))
      volume a b := by
    refine hreal.congr ?_
    intro s hs
    rw [uIoc_of_le hab] at hs
    obtain ⟨hs1, hs2⟩ := hs
    change (b - s) ^ (-(1 / 2) : ℝ) = |b - s| ^ (-(1 / 2) : ℝ)
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ b - s)]
  have hcast : IntervalIntegrable
      (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ)) volume a b :=
    ⟨habs.1.ofReal, habs.2.ofReal⟩
  exact hcast.mul_continuousOn hg.continuousOn

/-- `𝒜`: the part of `R_2^+` near the endpoint singularity. -/
def brsANearRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Ioi (t + r - brsCutScale r)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- `ℬ`: the part of `R_2^+` away from the endpoint singularity. -/
def brsBFarRight (E : Set ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..(t + r),
      (Iic (t + r - brsCutScale r)).indicator
        (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)

/-- **(5.5) of BRS, right half.** -/
theorem brsRemTwoTwoRight_le_add {E : Set ℝ} {g : ℝ → ℂ} (hg : Continuous g)
    {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoRight E g r ≤ brsANearRight E g r + brsBFarRight E g r := by
  rw [brsRemTwoTwoRight]
  refine iSup₂_le fun t ht => ?_
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  set F : ℝ → ℂ := fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s with hF
  have hfull : IntervalIntegrable F volume t b :=
    intervalIntegrable_absWeightRight_complex hg hab
  have hnear : IntervalIntegrable
      ((Ioi (b - brsCutScale r)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Ioi, hfull.2.indicator measurableSet_Ioi⟩
  have hfar : IntervalIntegrable
      ((Iic (b - brsCutScale r)).indicator F) volume t b :=
    ⟨hfull.1.indicator measurableSet_Iic, hfull.2.indicator measurableSet_Iic⟩
  have hsplit : ∀ s : ℝ, F s = (Ioi (b - brsCutScale r)).indicator F s +
      (Iic (b - brsCutScale r)).indicator F s := by
    intro s
    by_cases hs : b - brsCutScale r < s
    · rw [Set.indicator_of_mem (show s ∈ Ioi (b - brsCutScale r) from hs),
        Set.indicator_of_notMem
          (show s ∉ Iic (b - brsCutScale r) from not_le.mpr hs)]
      ring
    · rw [Set.indicator_of_notMem (show s ∉ Ioi (b - brsCutScale r) from hs),
        Set.indicator_of_mem
          (show s ∈ Iic (b - brsCutScale r) from not_lt.mp hs)]
      ring
  have hint : (∫ s in t..b, F s) =
      (∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s) +
        ∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s := by
    rw [← intervalIntegral.integral_add hnear hfar]
    exact intervalIntegral.integral_congr fun s _ => hsplit s
  have hnorm : ‖∫ s in t..b, F s‖ ≤
      ‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖ +
        ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖ := by
    rw [hint]
    exact norm_add_le _ _
  have hw : (0 : ℝ) ≤ r ^ (-(1 / 2) : ℝ) := Real.rpow_nonneg hr _
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b, F s‖)
      ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          (‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖ +
            ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_left hnorm hw)
    _ = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
          ‖∫ s in t..b, (Ioi (b - brsCutScale r)).indicator F s‖) +
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
            ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator F s‖) := by
        rw [mul_add, ENNReal.ofReal_add (by positivity) (by positivity)]
    _ ≤ brsANearRight E g r + brsBFarRight E g r := by
        refine add_le_add ?_ ?_
        · rw [brsANearRight]
          exact le_iSup₂_of_le t ht le_rfl
        · rw [brsBFarRight]
          exact le_iSup₂_of_le t ht le_rfl

/-- The far part of `R_2^+` vanishes for large radii. -/
theorem brsBFarRight_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ}
    {r : ℝ} (hr : 4 / 3 < r) : brsBFarRight E g r = 0 := by
  rw [brsBFarRight]
  refine iSup₂_eq_bot.mpr fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have h2 : t ≤ 2 := (hE htE).2
  linarith

/-- The pointwise bound for the far part of `R_2^+`. -/
theorem brsBFarRight_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsBFarRight E g r ≤
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) * r ^ (-(1 / p) : ℝ)) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rw [brsBFarRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have h1 : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  set b : ℝ := t + r with hb
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  set W : Set ℝ := Ioc t b ∩ Iic (b - brsCutScale r) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in t..b,
      (Iic (b - brsCutScale r)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc t b, ‖(Iic (b - brsCutScale r)).indicator
        (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc t b
      · by_cases h2 : s ≤ b - brsCutScale r
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - brsCutScale r) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hc => h2 hc.2),
            Set.indicator_of_notMem
              (show s ∉ Iic (b - brsCutScale r) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hc => h1 hc.1)]
    rw [hset]
    refine le_of_eq ?_
    refine setLIntegral_congr_fun hWmeas fun s hs => ?_
    rw [enorm_mul, ← ofReal_norm, Complex.norm_real,
      Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)]
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal (|b - s| ^ (-(1 / 2) : ℝ)) *
      ‖g s‖ₑ) ≤ ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - brsCutScale r := hs.2
    have habs : |b - s| = b - s := abs_of_nonneg (by linarith)
    have hle : |b - s| ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) := by
      rw [habs]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal r := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc, hb]
    exact ENNReal.ofReal_le_ofReal (by linarith)
  have hmass : (∫⁻ s in W, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' hWmeas ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs1 : t < s := hs.1.1
    have hs13 : (1 : ℝ) / 3 ≤ s := by linarith
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num)]
      rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  have hstep3 : (∫⁻ s in W, ‖g s‖ₑ) ≤
      (ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hg) ?_
    refine mul_le_mul' (ENNReal.rpow_le_rpow hmass (by positivity))
      (ENNReal.rpow_le_rpow hvol ?_)
    rw [sub_nonneg, div_le_one hp0]
    linarith
  have hfactor : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ((ENNReal.ofReal 3 * M) ^ (1 / p) * ENNReal.ofReal r ^ (1 - 1 / p))) =
      ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
        r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := by
    have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    have h1 : (ENNReal.ofReal 3 * M) ^ (1 / p) =
        ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
        ENNReal.ofReal_rpow_of_nonneg (by norm_num) (by positivity)]
    have h2 : ENNReal.ofReal r ^ (1 - 1 / p) =
        ENNReal.ofReal (r ^ (1 - 1 / p)) :=
      ENNReal.ofReal_rpow_of_nonneg hr.le hexp
    rw [h1, h2]
    rw [show ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (3 ^ (1 / p)) * M ^ (1 / p) *
            ENNReal.ofReal (r ^ (1 - 1 / p)))) =
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (3 ^ (1 / p)) *
              ENNReal.ofReal (r ^ (1 - 1 / p))) * M ^ (1 / p) from by ring]
    congr 1
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul (by positivity)]
    congr 1
    rw [show r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) *
        3 ^ (1 / p) * r ^ (1 - 1 / p) =
        r ^ (-(1 / 2) : ℝ) * (brsCutScale r ^ (-(1 / 2) : ℝ) *
          (3 ^ (1 / p) * r ^ (1 - 1 / p))) from by ring]
    exact brs_far_constant_identity hp0 hr
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) * ‖∫ s in t..b,
        (Iic (b - brsCutScale r)).indicator
          (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..b, (Iic (b - brsCutScale r)).indicator
            (fun s => ((|b - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ((ENNReal.ofReal 3 * M) ^ (1 / p) *
              ENNReal.ofReal r ^ (1 - 1 / p))) :=
        mul_le_mul' le_rfl (le_trans hstep1 (le_trans hstep2
          (mul_le_mul' le_rfl hstep3)))
    _ ≤ ENNReal.ofReal (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
          r ^ (-(1 / p) : ℝ)) * M ^ (1 / p) := le_of_eq hfactor

/-- **(5.6) of BRS, right half.**  The far part of `R_2^+` maps `L^p(s ds)` into
`L^q(r dr)` whenever `1 < p` and `q < 2p`. -/
theorem prop56_brsBFarRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hq : 0 < q) (hq2p : q < 2 * p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Measurable g →
      (∫⁻ r, ENNReal.ofReal r * brsBFarRight E g r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set e : ℝ := 1 - q / p with he_def
  have he : (-1 : ℝ) < e := by
    rw [he_def]
    have : q / p < 2 := by
      rw [div_lt_iff₀ hp0]
      linarith
    linarith
  have he1 : (0 : ℝ) < e + 1 := by linarith
  set A : ℝ := ((4 / 3 : ℝ) ^ (e + 1)) / (e + 1) with hA_def
  have hApos : 0 < A := by
    rw [hA_def]
    have : (0 : ℝ) < (4 / 3 : ℝ) ^ (e + 1) :=
      Real.rpow_pos_of_pos (by norm_num) _
    positivity
  set K : ℝ := 2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) with hK_def
  have hKpos : 0 < K := by
    rw [hK_def]
    have h1 : (0 : ℝ) < 2048 ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
    have h2 : (0 : ℝ) < 3 ^ (1 / p) := Real.rpow_pos_of_pos (by norm_num) _
    positivity
  refine ⟨K * A ^ (1 / q), by positivity, fun g hg => ?_⟩
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  rcases eq_or_ne M ⊤ with hMtop | hMtop
  · have hCpos : (0 : ENNReal) < ENNReal.ofReal (K * A ^ (1 / q)) :=
      ENNReal.ofReal_pos.mpr (by positivity)
    have : ENNReal.ofReal (K * A ^ (1 / q)) * M ^ (1 / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity), ENNReal.mul_top hCpos.ne']
    rw [this]
    exact le_top
  · -- the pointwise bound, in indicator form
    have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsBFarRight E g r ^ q ≤
        (Ioc (0 : ℝ) (4 / 3)).indicator
          (fun r => ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p)) r := by
      intro r
      rcases le_or_gt r 0 with hr | hr
      · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
        exact zero_le
      rcases le_or_gt r (4 / 3) with hr43 | hr43
      · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hr43⟩)]
        have hb := brsBFarRight_le hE hp hg hr
        have hreal : (2048 ^ (1 / 2 : ℝ) * 3 ^ (1 / p) *
            r ^ (-(1 / p) : ℝ)) ^ q = K ^ q * r ^ (-(q / p) : ℝ) := by
          rw [hK_def, Real.mul_rpow (by positivity) (Real.rpow_nonneg hr.le _),
            ← Real.rpow_mul hr.le]
          congr 2
          field_simp
        have hbq : brsBFarRight E g r ^ q ≤
            ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p) := by
          refine le_trans (ENNReal.rpow_le_rpow hb hq.le) (le_of_eq ?_)
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ← ENNReal.rpow_mul,
            ENNReal.ofReal_rpow_of_nonneg (by positivity) hq.le, hreal]
          congr 1
          rw [show (1 : ℝ) / p * q = q / p by ring]
        have hrw : r * (K ^ q * r ^ (-(q / p) : ℝ)) = K ^ q * r ^ e := by
          have hsum : r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ) = r ^ (1 - q / p) := by
            rw [← Real.rpow_add hr, sub_eq_add_neg]
          rw [he_def]
          calc r * (K ^ q * r ^ (-(q / p) : ℝ))
              = K ^ q * (r ^ (1 : ℝ) * r ^ (-(q / p) : ℝ)) := by
                rw [Real.rpow_one]
                ring
            _ = K ^ q * r ^ (1 - q / p) := by rw [hsum]
        calc ENNReal.ofReal r * brsBFarRight E g r ^ q
            ≤ ENNReal.ofReal r *
                (ENNReal.ofReal (K ^ q * r ^ (-(q / p) : ℝ)) * M ^ (q / p)) :=
              mul_le_mul' le_rfl hbq
          _ = ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) := by
              rw [← mul_assoc, ← ENNReal.ofReal_mul hr.le, hrw]
      · rw [brsBFarRight_eq_zero hE hr43, ENNReal.zero_rpow_of_pos hq, mul_zero]
        exact zero_le
    -- the radial integral
    have hint : IntervalIntegrable (fun r : ℝ => r ^ e) volume 0 (4 / 3) :=
      intervalIntegral.intervalIntegrable_rpow' he
    have hAeq : (∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e)) =
        ENNReal.ofReal A := by
      rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
        lintegral_Ioo_eq_ofReal_intervalIntegral (by norm_num) hint
          (fun s hs => Real.rpow_nonneg (le_of_lt hs.1) _)]
      congr 1
      rw [integral_rpow (Or.inl he), Real.zero_rpow he1.ne', hA_def]
      simp
    have hMq : M ^ (q / p) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) hMtop
    have hmain : (∫⁻ r, ENNReal.ofReal r * brsBFarRight E g r ^ q) ≤
        ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
      refine le_trans (lintegral_mono hpt) ?_
      rw [lintegral_indicator measurableSet_Ioc]
      have hsplit : ∀ r : ℝ, ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p) =
          (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) := by
        intro r
        rw [ENNReal.ofReal_mul (by positivity)]
        ring
      calc (∫⁻ r in Ioc (0 : ℝ) (4 / 3),
            ENNReal.ofReal (K ^ q * r ^ e) * M ^ (q / p))
          = ∫⁻ r in Ioc (0 : ℝ) (4 / 3),
              (ENNReal.ofReal (K ^ q) * M ^ (q / p)) * ENNReal.ofReal (r ^ e) :=
            lintegral_congr fun r => hsplit r
        _ = (ENNReal.ofReal (K ^ q) * M ^ (q / p)) *
              ∫⁻ r in Ioc (0 : ℝ) (4 / 3), ENNReal.ofReal (r ^ e) :=
            lintegral_const_mul' _ _ (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hMq)
        _ = ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := by
            rw [hAeq]
            ring
        _ ≤ ENNReal.ofReal (K ^ q) * ENNReal.ofReal A * M ^ (q / p) := le_rfl
    refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul,
      ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
      ENNReal.ofReal_rpow_of_nonneg hApos.le (by positivity),
      ← ENNReal.ofReal_mul (by positivity)]
    congr 2
    · rw [← Real.rpow_mul hKpos.le, mul_one_div, div_self hq.ne', Real.rpow_one]
    · field_simp

/-! ## The off-diagonal bound for the signed blocks, `p ≤ q ≤ 2` -/

/-- The off-diagonal `L^q(r\,dr)` bound for a signed centered block. -/
theorem lintegral_brsPieceSigned_offdiag_le {σ a δ p q : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2)
    (hδ : 0 < δ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q) ≤
      ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p)) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hqp : (1 : ℝ) ≤ q / p := (one_le_div hp0).mpr hpq
  have hδ3 : (0 : ℝ) < 3 * δ := by linarith
  set Φ : ℝ → ENNReal := fun s => ENNReal.ofReal s * ‖g s‖ₑ ^ p with hΦdef
  have hΦmeas : Measurable Φ :=
    (ENNReal.measurable_ofReal.comp measurable_id).mul (hg.enorm.pow_const p)
  set M : ENNReal := ∫⁻ s, Φ s with hM
  -- the local `L^p` mass is at most three times the weighted global mass
  have hXM : ∀ r : ℝ, (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ≤
      ENNReal.ofReal 3 * M := by
    intro r
    rw [hM, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine le_trans (setLIntegral_mono' (measurableSet_brsWindowSigned σ a δ r)
      ?_) (setLIntegral_le_lintegral _ _)
    intro s hs
    have hs13 : (1 / 3 : ℝ) ≤ s := hs.2.2
    have h3 : (1 : ENNReal) ≤ ENNReal.ofReal 3 * ENNReal.ofReal s := by
      rw [← ENNReal.ofReal_mul (by norm_num),
        show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
      exact ENNReal.ofReal_le_ofReal (by linarith)
    calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 3 * ENNReal.ofReal s) * ‖g s‖ₑ ^ p :=
          mul_le_mul' h3 le_rfl
      _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by ring
  -- Hölder on each window
  have hHolder : ∀ r : ℝ, brsPieceSigned σ a δ g r ^ q ≤
      (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
        ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
    intro r
    rw [brsPieceSigned_eq_setLIntegral]
    calc (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ) ^ q
        ≤ ((∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (1 / p) *
            volume (brsWindowSigned σ a δ r) ^ (1 - 1 / p)) ^ q :=
          ENNReal.rpow_le_rpow (lintegral_window_holder hp hg) hq0.le
      _ = (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
            volume (brsWindowSigned σ a δ r) ^ (q * (1 - 1 / p)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
            ← ENNReal.rpow_mul]
          congr 2 <;> ring
      _ ≤ (∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p) ^ (q / p) *
            ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) := by
          refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
            (volume_brsWindowSigned_le hδ.le) ?_)
          have : (0 : ℝ) ≤ 1 - 1 / p := by
            rw [sub_nonneg, div_le_one hp0]
            linarith
          positivity
  -- the pointwise bound
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q ≤
      ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
        (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
        (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
          ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      exact zero_le
    · set X : ENNReal := ∫⁻ s in brsWindowSigned σ a δ r, ‖g s‖ₑ ^ p with hX
      have hreal : r * (r ^ (-(1 / 2) : ℝ)) ^ q = r ^ (1 - q / 2) := by
        have h1 : (r ^ (-(1 / 2) : ℝ)) ^ q = r ^ (-(q / 2)) := by
          rw [← Real.rpow_mul hr.le]
          congr 1
          ring
        have h2 : r ^ (1 - q / 2) = r ^ (1 : ℝ) * r ^ (-(q / 2)) := by
          rw [← Real.rpow_add hr, sub_eq_add_neg]
        rw [h1, h2, Real.rpow_one]
      have hweight : ENNReal.ofReal r *
          ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q =
          ENNReal.ofReal (r ^ (1 - q / 2)) := by
        rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hr.le _) hq0.le,
          ← ENNReal.ofReal_mul hr.le, hreal]
      have hmono : ENNReal.ofReal (r ^ (1 - q / 2)) * X ≤
          ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
        rw [hX, lintegral_indicator (measurableSet_brsWindowSigned σ a δ r),
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
          ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        refine lintegral_mono_ae ?_
        filter_upwards [self_mem_ae_restrict
          (measurableSet_brsWindowSigned σ a δ r)] with s hs
        have hle := rpow_weight_le_of_window hq1 hq2 hr hs.2.1 hs.2.2
        have h13 : (1 / 3 : ℝ) ≤ s := hs.2.2
        calc ENNReal.ofReal (r ^ (1 - q / 2)) * ‖g s‖ₑ ^ p
            ≤ ENNReal.ofReal (2 * 3 ^ (q / 2) * s) * ‖g s‖ₑ ^ p :=
              mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
          _ = ENNReal.ofReal (2 * 3 ^ (q / 2)) * Φ s := by
              rw [hΦdef, ENNReal.ofReal_mul (by positivity)]
              ring
      calc ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q
          = ENNReal.ofReal (r ^ (1 - q / 2)) *
              brsPieceSigned σ a δ g r ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc, hweight]
        _ ≤ ENNReal.ofReal (r ^ (1 - q / 2)) *
              (X ^ (q / p) * ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
            mul_le_mul' le_rfl (hHolder r)
        _ ≤ ENNReal.ofReal (r ^ (1 - q / 2)) *
              ((X * (ENNReal.ofReal 3 * M) ^ (q / p - 1)) *
                ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p))) :=
            mul_le_mul' le_rfl (mul_le_mul'
              (ennreal_rpow_le_mul_of_le hqp (hXM r)) le_rfl)
        _ = ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
              (ENNReal.ofReal (r ^ (1 - q / 2)) * X) := by ring
        _ ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) :=
            mul_le_mul' le_rfl hmono
  -- integrate in the radius
  have hmass : (∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s) ≤
      ENNReal.ofReal (3 * δ) * M :=
    lintegral_brsWindowSigned_le hσ hδ.le hΦmeas
  have he0 : (0 : ℝ) ≤ q * (1 - 1 / p) := by
    have : (0 : ℝ) ≤ 1 - 1 / p := by
      rw [sub_nonneg, div_le_one hp0]
      linarith
    positivity
  rcases eq_or_ne (ENNReal.ofReal 3 * M) ⊤ with hMtop | hMtop
  · have hMq : (ENNReal.ofReal 3 * M) ^ (q / p) = ⊤ := by
      rw [hMtop, ENNReal.top_rpow_of_pos (by positivity)]
    have hpos : (0 : ENNReal) < ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) :=
      ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hδ3) ENNReal.ofReal_ne_top
    have htop : ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 * M) ^ (q / p)) = ⊤ := by
      rw [hMq, ENNReal.mul_top hpos.ne', ENNReal.mul_top]
      exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
    rw [htop]
    exact le_top
  · set C : ENNReal := ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
      (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
      ENNReal.ofReal (2 * 3 ^ (q / 2)) with hC
    have hCne : C ≠ ⊤ := by
      refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg he0 ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hMtop
    calc (∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * brsPieceSigned σ a δ g r) ^ q)
        ≤ ∫⁻ r, C * ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s := by
          refine le_trans (lintegral_mono hpt) (le_of_eq (lintegral_congr ?_))
          intro r
          rw [hC]
          ring
      _ = C * ∫⁻ r, ∫⁻ s, (brsWindowSigned σ a δ r).indicator Φ s :=
          lintegral_const_mul' _ _ hCne
      _ ≤ C * (ENNReal.ofReal (3 * δ) * M) := mul_le_mul' le_rfl hmass
      _ ≤ ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
              (ENNReal.ofReal 3 * M) ^ (q / p)) := by
          rw [hC]
          have hMle : M ≤ ENNReal.ofReal 3 * M := by
            refine le_mul_of_one_le_left' ?_
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 by simp]
            exact ENNReal.ofReal_le_ofReal (by norm_num)
          have hpow : ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
              ENNReal.ofReal (3 * δ) =
              ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) := by
            rw [ENNReal.rpow_add_of_nonneg _ _ he0 (by norm_num),
              ENNReal.rpow_one]
          calc ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * δ) * M)
              ≤ ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                  (ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                  ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  (ENNReal.ofReal (3 * δ) * (ENNReal.ofReal 3 * M)) :=
                mul_le_mul' le_rfl (mul_le_mul' le_rfl hMle)
            _ = ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ((ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p)) *
                    ENNReal.ofReal (3 * δ)) *
                    ((ENNReal.ofReal 3 * M) ^ (q / p - 1) *
                      (ENNReal.ofReal 3 * M))) := by ring
            _ ≤ ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
                    (ENNReal.ofReal 3 * M) ^ (q / p)) := by
                refine mul_le_mul' le_rfl (mul_le_mul' (le_of_eq hpow)
                  (ennreal_rpow_sub_one_mul_le hqp))

/-- The off-diagonal `L^q(r\,dr)` bound for the supremum of signed blocks. -/
theorem lintegral_iSup_signed_offdiag_le {ι : Finset ℝ} {σ δ p q : ℝ}
    (hσ : σ = 1 ∨ σ = -1) (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) (hδ : 0 < δ)
    (c : ℝ → ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q) ≤
      (ι.card : ENNReal) * (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
          (ENNReal.ofReal 3 *
            ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p))) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  set K : ENNReal := ENNReal.ofReal (2 * 3 ^ (q / 2)) *
    (ENNReal.ofReal (3 * δ) ^ (q * (1 - 1 / p) + 1) *
      (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (q / p))
    with hK
  have hpt : ∀ r : ℝ, ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q ≤
      ∑ a ∈ ι, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          brsPieceSigned σ (c a) δ g r) ^ q := by
    intro r
    have hsum := iSup_rpow_le_sum hq0 ι fun a => brsPieceSigned σ (c a) δ g r
    calc ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q
        = ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q *
            (⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, mul_assoc]
      _ ≤ ENNReal.ofReal r * ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) ^ q *
            ∑ a ∈ ι, brsPieceSigned σ (c a) δ g r ^ q :=
          mul_le_mul' le_rfl hsum
      _ = ∑ a ∈ ι, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              brsPieceSigned σ (c a) δ g r) ^ q := by
          rw [Finset.mul_sum]
          refine Finset.sum_congr rfl fun a _ => ?_
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, mul_assoc]
  have hmeas : ∀ a ∈ ι, Measurable fun r : ℝ => ENNReal.ofReal r *
      (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        brsPieceSigned σ (c a) δ g r) ^ q := by
    intro a _
    exact (ENNReal.measurable_ofReal.comp measurable_id).mul
      ((measurable_rpow_neg_half.mul (measurable_brsPieceSigned hg)).pow_const q)
  calc (∫⁻ r, ENNReal.ofReal r * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        ⨆ a ∈ ι, brsPieceSigned σ (c a) δ g r) ^ q)
      ≤ ∫⁻ r, ∑ a ∈ ι, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ q := lintegral_mono hpt
    _ = ∑ a ∈ ι, ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            brsPieceSigned σ (c a) δ g r) ^ q :=
        lintegral_finsetSum' _ (fun a ha => (hmeas a ha).aemeasurable)
    _ ≤ ∑ _a ∈ ι, K := by
        refine Finset.sum_le_sum fun a _ => ?_
        rw [hK]
        exact lintegral_brsPieceSigned_offdiag_le hσ hp hpq hq2 hδ hg
    _ = (ι.card : ENNReal) * K := by
        rw [Finset.sum_const, nsmul_eq_mul]

/-- The coefficient of the `m`-th block in the off-diagonal bound for
`R_2^±`. -/
def brsProp54Coeff (E : Set ℝ) (p q : ℝ) (m : ℕ) : ENNReal :=
  ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
    ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
      (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
        ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1))) ^ (1 / q)

/-- **An off-diagonal bound for `R_2^-`** in the range `1 < p ≤ q ≤ 2`, with
the global covering numbers in place of the localized quantities of BRS
Proposition 5.4. -/
theorem prop54_brsRemTwoTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp54Coeff E p q m) *
        (ENNReal.ofReal 3 *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p
    with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned (-1) (-a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => -a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ q := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsRemTwoTwoLeft_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceLeft E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceLeft_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp54Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
              M ^ (q / p))) := by
      have h := lintegral_iSup_signed_offdiag_le (ι := ι m) (σ := (-1 : ℝ))
        (Or.inr rfl) hp hpq hq2 (brsDyadic_pos m) (fun a => -a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
              (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                M ^ (q / p)))) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp54Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp54Coeff, hc]
          rw [show ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                  M ^ (q / p)))) =
              ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
                (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ENNReal.ofReal (3 * brsDyadic m) ^
                    (q * (1 - 1 / p) + 1))) * M ^ (q / p) from by ring]
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp54Coeff E p q m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp54Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right

/-- **An off-diagonal bound for `R_2^+`** in the range `1 < p ≤ q ≤ 2`, with
the global covering numbers in place of the localized quantities of BRS
Proposition 5.4. -/
theorem prop54_brsRemTwoTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp : 1 < p) (hpq : p ≤ q) (hq2 : q ≤ 2) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, brsProp54Coeff E p q m) *
        (ENNReal.ofReal 3 *
          ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp0 hpq
  have hq1 : (1 : ℝ) ≤ q := le_trans hp.le hpq
  have hcovex : ∀ m : ℕ, ∃ ι : Finset ℝ, IsIntervalCover E (brsDyadic m) ι ∧
      ι.card = intervalCoveringNumber E (brsDyadic m) := fun m =>
    exists_intervalCover_card_eq_intervalCoveringNumber hE (brsDyadic_pos m)
  choose ι hι hcard using hcovex
  set M : ENNReal := ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p
    with hM
  set c : ℕ → ENNReal := fun m => ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ))
    with hc
  set S : ℕ → ℝ → ENNReal := fun m r =>
    ⨆ a ∈ ι m, brsPieceSigned 1 (3 * brsDyadic m - a) (brsDyadic m) g r with hS
  set G : ℕ → ℝ → ENNReal := fun m r =>
    c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) with hG
  have hSmeas : ∀ m, Measurable (S m) := fun m =>
    measurable_iSup_signed (fun a => 3 * brsDyadic m - a) hg
  have hGmeas : ∀ m, Measurable (G m) := fun m =>
    (measurable_rpow_neg_half.mul (hSmeas m)).const_mul _
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q ≤
      ENNReal.ofReal r * (∑' m, G m r) ^ q := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, zero_mul]
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsRemTwoTwoRight_le_tsum hE hr)
        (ENNReal.tsum_le_tsum fun m => ?_)
      rw [hG]
      calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
            (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) *
              brsR2PieceRight E g m r)
          ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
              (ENNReal.ofReal (brsDyadic m ^ (-(1 / 2) : ℝ)) * S m r) :=
            mul_le_mul' le_rfl (mul_le_mul' le_rfl
              (brsR2PieceRight_le_iSup_signed hE (hι m)))
        _ = c m * (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) := by
            rw [hc]
            ring
  have hterm : ∀ m : ℕ, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) ≤
      brsProp54Coeff E p q m * M ^ (1 / p) := by
    intro m
    have hcne : c m ^ q ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top
    have hI : (∫⁻ r, ENNReal.ofReal r * G m r ^ q) =
        c m ^ q * ∫⁻ r, ENNReal.ofReal r *
          (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q := by
      rw [← lintegral_const_mul' _ _ hcne]
      refine lintegral_congr fun r => ?_
      rw [hG]
      simp only
      rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
      ring
    have hbound : (∫⁻ r, ENNReal.ofReal r *
        (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ≤
        (intervalCoveringNumber E (brsDyadic m) : ENNReal) *
          (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
            (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
              M ^ (q / p))) := by
      have h := lintegral_iSup_signed_offdiag_le (ι := ι m) (σ := (1 : ℝ))
        (Or.inl rfl) hp hpq hq2 (brsDyadic_pos m) (fun a => 3 * brsDyadic m - a) hg
      rw [hcard m] at h
      exact h
    calc (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q)
        = c m * (∫⁻ r, ENNReal.ofReal r *
            (ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S m r) ^ q) ^ (1 / q) := by
          rw [hI, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one]
      _ ≤ c m * ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
            (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
              (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                M ^ (q / p)))) ^ (1 / q) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hbound (by positivity))
      _ = brsProp54Coeff E p q m * M ^ (1 / p) := by
          rw [brsProp54Coeff, hc]
          rw [show ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
              (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                (ENNReal.ofReal (3 * brsDyadic m) ^ (q * (1 - 1 / p) + 1) *
                  M ^ (q / p)))) =
              ((intervalCoveringNumber E (brsDyadic m) : ENNReal) *
                (ENNReal.ofReal (2 * 3 ^ (q / 2)) *
                  ENNReal.ofReal (3 * brsDyadic m) ^
                    (q * (1 - 1 / p) + 1))) * M ^ (q / p) from by ring]
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / q),
            ← ENNReal.rpow_mul]
          have hexp : q / p * (1 / q) = 1 / p := by
            field_simp
          rw [hexp]
          ring
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q) ^ (1 / q)
      ≤ (∫⁻ r, ENNReal.ofReal r * (∑' m, G m r) ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (lintegral_mono hpt) (by positivity)
    _ ≤ ∑' m, (∫⁻ r, ENNReal.ofReal r * G m r ^ q) ^ (1 / q) :=
        lintegral_weight_rpow_tsum_le hq1 hGmeas
    _ ≤ ∑' m, brsProp54Coeff E p q m * M ^ (1 / p) := ENNReal.tsum_le_tsum hterm
    _ = (∑' m, brsProp54Coeff E p q m) * M ^ (1 / p) := ENNReal.tsum_mul_right


end Prop46
