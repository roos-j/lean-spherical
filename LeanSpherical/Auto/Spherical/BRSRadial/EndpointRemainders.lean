    · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hrle⟩)]
      have hb := brsRemTwoTwoRight_le_of_two_lt hE hp hg hr
      have hval : ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p =
          ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
          show (1 : ℝ) / p * p = 1 from by field_simp, ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_pos
            (by positivity : (0 : ℝ) < C * r ^ (-(1 / p))),
          ← mul_assoc, ← ENNReal.ofReal_mul hr.le]
        congr 2
        rw [Real.mul_rpow hC.le (Real.rpow_nonneg hr.le _),
          ← Real.rpow_mul hr.le,
          show -(1 / p) * p = -1 from by field_simp, Real.rpow_neg_one]
        field_simp
      calc ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p
          ≤ ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
              (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hb hp0.le)
        _ = ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := hval
    · rw [brsRemTwoTwoRight_eq_zero hE hrgt, ENNReal.zero_rpow_of_pos hp0,
        mul_zero]
      exact zero_le
  have hint : (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ≤
      ENNReal.ofReal (4 * C ^ p) * M := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioc, setLIntegral_const,
      Real.volume_Ioc, show (4 : ℝ) / 3 - 0 = 4 / 3 from by ring,
      show ENNReal.ofReal (4 * C ^ p) =
          ENNReal.ofReal (C ^ p) * ENNReal.ofReal 3 * ENNReal.ofReal (4 / 3) from by
        rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p),
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p * 3)]
        congr 1
        ring]
    exact le_of_eq (by ring)
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p)
      ≤ (ENNReal.ofReal (4 * C ^ p) * M) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal ((4 : ℝ) ^ (1 / p) * C) * M ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < 4 * C ^ p)]
        congr 2
        rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 4) (by positivity),
          ← Real.rpow_mul hC.le,
          show p * (1 / p) = 1 from by field_simp, Real.rpow_one]

/-! ## The far parts `ℬ^±` are dominated by `R₂` of §4

On the far piece the kernel is bounded by `(r/2048)^{-1/2}`, so the whole
operator is at most `2048^{1/2} r^{-1} ∫_{t-r}^{t+r}|g|`, which is exactly
`2048^{1/2}` times the `d = 2` remainder `R₂` of §4.  The endpoint `q = 2p`
of (5.6) is then Proposition 4.3 at its endpoint, in dimension two. -/

theorem cutScale_rpow_mul {r : ℝ} (hr : 0 < r) :
    r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) =
      (2048 : ℝ) ^ (1 / 2 : ℝ) * r⁻¹ := by
  have h2048 : (0 : ℝ) < (2048 : ℝ) ^ (1 / 2 : ℝ) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have h1 : (r / 2048 : ℝ) ^ (-(1 / 2) : ℝ) =
      r ^ (-(1 / 2) : ℝ) * (2048 : ℝ) ^ (1 / 2 : ℝ) := by
    rw [Real.div_rpow hr.le (by norm_num : (0 : ℝ) ≤ 2048),
      show (-(1 / 2) : ℝ) = -(1 / 2 : ℝ) from rfl,
      Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2048)]
    field_simp
  rw [brsCutScale, h1, ← mul_assoc, ← Real.rpow_add hr,
    show -(1 / 2 : ℝ) + -(1 / 2 : ℝ) = -1 from by norm_num, Real.rpow_neg_one]
  ring

theorem brsBFarLeft_le_brsRemainderTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr : 0 < r) :
    brsBFarLeft E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  rw [brsBFarLeft]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have hab : t - r ≤ t := by linarith
  have hab2 : t - r ≤ t + r := by linarith
  have hInn : (0 : ℝ) ≤ ∫ s in (t - r)..(t + r), ‖g s‖ :=
    intervalIntegral.integral_nonneg hab2 fun s _ => norm_nonneg _
  have hRterm : ‖∫ s in (t - r)..(t + r), absProfile g s‖ =
      ∫ s in (t - r)..(t + r), ‖g s‖ :=
    norm_intervalIntegral_ofReal_nonneg hab2 _ fun s _ => norm_nonneg _
  have hlow : ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) ≤
      brsRemainderTwo (absProfile g) r := by
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hHle : ∀ s ∈ Icc (t - r) t,
      ENNReal.ofReal ‖(Ici (t - r + brsCutScale r)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
        ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s hs
    by_cases hmem : t - r + brsCutScale r ≤ s
    · rw [Set.indicator_of_mem (show s ∈ Ici (t - r + brsCutScale r) from hmem),
        norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
        ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [abs_of_nonneg (by linarith [hs.1] : (0 : ℝ) ≤ s - (t - r))]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    · rw [Set.indicator_of_notMem
        (show s ∉ Ici (t - r + brsCutScale r) from hmem)]
      simp
  have hupper := ofReal_norm_intervalIntegral_le_lintegral hab
    ((Ici (t - r + brsCutScale r)).indicator
      (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s))
    (fun s => ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) hHle
  have hint : IntegrableOn (fun s => ‖g s‖) (Icc (t - r) (t + r)) volume :=
    hg.norm.integrableOn_Icc
  have heq : (∫⁻ s in Icc (t - r) (t + r), ‖g s‖ₑ) =
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [intervalIntegral.integral_of_le hab2, ← integral_Icc_eq_integral_Ioc,
      ofReal_integral_eq_lintegral_ofReal hint
        (Filter.Eventually.of_forall fun s => norm_nonneg _)]
    exact lintegral_congr fun s => (ofReal_norm (g s)).symm
  have hmass : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ) ≤
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← heq]
    exact lintegral_mono_set (Icc_subset_Icc le_rfl (by linarith))
  have hprod : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) =
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hcut.le _),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (2048 : ℝ) ^ (1 / 2 : ℝ))]
    congr 1
    rw [← mul_assoc, cutScale_rpow_mul hr, mul_assoc]
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in (t - r)..t, (Ici (t - r + brsCutScale r)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in (t - r)..t,
            (Ici (t - r + brsCutScale r)).indicator
              (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) := by
        refine mul_le_mul' le_rfl (le_trans hupper ?_)
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        exact mul_le_mul' le_rfl hmass
    _ = ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := hprod
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          brsRemainderTwo (absProfile g) r := mul_le_mul' le_rfl hlow

theorem brsBFarRight_le_brsRemainderTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r : ℝ} (hr : 0 < r) :
    brsBFarRight E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  rw [brsBFarRight]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have hab : t ≤ t + r := by linarith
  have hab2 : t - r ≤ t + r := by linarith
  have hRterm : ‖∫ s in (t - r)..(t + r), absProfile g s‖ =
      ∫ s in (t - r)..(t + r), ‖g s‖ :=
    norm_intervalIntegral_ofReal_nonneg hab2 _ fun s _ => norm_nonneg _
  have hlow : ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) ≤
      brsRemainderTwo (absProfile g) r := by
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hHle : ∀ s ∈ Icc t (t + r),
      ENNReal.ofReal ‖(Iic (t + r - brsCutScale r)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
        ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s hs
    by_cases hmem : s ≤ t + r - brsCutScale r
    · rw [Set.indicator_of_mem (show s ∈ Iic (t + r - brsCutScale r) from hmem),
        norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
        ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [abs_of_nonneg (by linarith [hs.2] : (0 : ℝ) ≤ t + r - s)]
      exact Real.rpow_le_rpow_of_nonpos hcut (by linarith) (by norm_num)
    · rw [Set.indicator_of_notMem
        (show s ∉ Iic (t + r - brsCutScale r) from hmem)]
      simp
  have hupper := ofReal_norm_intervalIntegral_le_lintegral hab
    ((Iic (t + r - brsCutScale r)).indicator
      (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s))
    (fun s => ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) hHle
  have hint : IntegrableOn (fun s => ‖g s‖) (Icc (t - r) (t + r)) volume :=
    hg.norm.integrableOn_Icc
  have heq : (∫⁻ s in Icc (t - r) (t + r), ‖g s‖ₑ) =
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [intervalIntegral.integral_of_le hab2, ← integral_Icc_eq_integral_Ioc,
      ofReal_integral_eq_lintegral_ofReal hint
        (Filter.Eventually.of_forall fun s => norm_nonneg _)]
    exact lintegral_congr fun s => (ofReal_norm (g s)).symm
  have hmass : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ) ≤
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← heq]
    exact lintegral_mono_set (Icc_subset_Icc (by linarith) le_rfl)
  have hprod : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) =
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hcut.le _),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (2048 : ℝ) ^ (1 / 2 : ℝ))]
    congr 1
    rw [← mul_assoc, cutScale_rpow_mul hr, mul_assoc]
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in t..(t + r), (Iic (t + r - brsCutScale r)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..(t + r),
            (Iic (t + r - brsCutScale r)).indicator
              (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (brsCutScale r ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) := by
        refine mul_le_mul' le_rfl (le_trans hupper ?_)
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        exact mul_le_mul' le_rfl hmass
    _ = ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := hprod
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          brsRemainderTwo (absProfile g) r := mul_le_mul' le_rfl hlow

/-! ## (5.6) at the endpoint `q = 2p`

The pointwise domination of `ℬ^±` by `R₂` turns the endpoint of (5.6) into
Proposition 4.3 at its endpoint in dimension two. -/

/-- **(5.6) at the endpoint `q = 2p`, left half.** -/
theorem prop56_brsBFarLeft_endpoint {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ (2 * p)) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨C, hCpos, hbound⟩ :=
    prop43_brsRemainderTwo_endpoint (d := 2) (by norm_num) hp
  have hKpos : (0 : ℝ) < (2048 : ℝ) ^ (1 / 2 : ℝ) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine ⟨(2048 : ℝ) ^ (1 / 2 : ℝ) * C, by positivity, ?_⟩
  intro g hg
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set K : ℝ := (2048 : ℝ) ^ (1 / 2 : ℝ) with hK
  have hb := hbound g hg
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hb
  have hdom : ∀ r : ℝ, ENNReal.ofReal r * brsBFarLeft E g r ^ (2 * p) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        (ENNReal.ofReal r * brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      simp
    · have h := brsBFarLeft_le_brsRemainderTwo hE hg hr
      calc ENNReal.ofReal r * brsBFarLeft E g r ^ (2 * p)
          ≤ ENNReal.ofReal r *
              (ENNReal.ofReal K * brsRemainderTwo (absProfile g) r) ^ (2 * p) :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
        _ = ENNReal.ofReal (K ^ (2 * p)) *
              (ENNReal.ofReal r *
                brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
              ENNReal.ofReal_rpow_of_pos hKpos]
            ring
  have hint : (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ (2 * p)) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        ∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hdom
  calc (∫⁻ r, ENNReal.ofReal r * brsBFarLeft E g r ^ (2 * p)) ^ (1 / (2 * p))
      ≤ (ENNReal.ofReal (K ^ (2 * p)) *
          ∫⁻ r, ENNReal.ofReal r *
            brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal K * (∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / (2 * p)),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < K ^ (2 * p)),
          ← Real.rpow_mul hKpos.le,
          show 2 * p * (1 / (2 * p)) = 1 from by field_simp, Real.rpow_one]
    _ ≤ ENNReal.ofReal K *
          (ENNReal.ofReal C *
            (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl hb
    _ = ENNReal.ofReal (K * C) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
        rw [ENNReal.ofReal_mul hKpos.le, mul_assoc]

