  · rw [Set.indicator_of_mem (show x ∈ {x : α | v < f x} from hx),
      Set.indicator_of_mem (show x ∈ {x : α | u < f x} from lt_of_le_of_lt huv hx)]
  · rw [Set.indicator_of_notMem (show x ∉ {x : α | v < f x} from hx)]
    simp

theorem measurable_brsTail {α : Type*} [MeasurableSpace α] (μ : Measure α)
    (f : α → ℝ) : Measurable (fun lam : ℝ => brsTail μ f lam) :=
  (antitone_brsTail μ f).measurable

/-- **The tail estimate over all levels.** -/
theorem lintegral_brsTail_rpow_le_total {α : Type*} [MeasurableSpace α]
    {μ : Measure α} [SFinite μ] {f : α → ℝ} (hf : Measurable f)
    (hfnn : ∀ x, 0 ≤ f x) {p a m : ℝ} (hp : 1 ≤ p) (hm : 1 ≤ m) (ha : 0 < a)
    (hpa : 1 + a / m = p) :
    (∫⁻ lam in Ioi (0 : ℝ),
        ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m) ≤
      ENNReal.ofReal a⁻¹ * (∫⁻ x, ENNReal.ofReal (f x) ^ p ∂μ) ^ m := by
  have hm0 : (0 : ℝ) < m := lt_of_lt_of_le zero_lt_one hm
  have hp0 : (0 : ℝ) ≤ p := by linarith
  set X : ENNReal := ∫⁻ x, ENNReal.ofReal (f x) ^ p ∂μ with hX
  set F : ℝ → ENNReal := fun lam =>
    ENNReal.ofReal (lam ^ (a - 1)) * brsTail μ f lam ^ m with hFdef
  have hFmeas : Measurable F := by
    have h1 : Measurable fun lam : ℝ => ENNReal.ofReal (lam ^ (a - 1)) := by
      fun_prop
    have h2 : Measurable fun lam : ℝ => brsTail μ f lam ^ m :=
      ENNReal.continuous_rpow_const.measurable.comp (measurable_brsTail μ f)
    exact h1.mul h2
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos hm0,
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact inv_pos.mpr ha)]
    exact le_top
  -- the exhausting family of level windows
  set S : ℕ → Set ℝ := fun n => Ioc (((n : ℝ) + 1)⁻¹) ((n : ℝ) + 1) with hSdef
  have hSpos : ∀ n : ℕ, (0 : ℝ) < ((n : ℝ) + 1)⁻¹ := by
    intro n
    positivity
  have hSmeas : ∀ n : ℕ, MeasurableSet (S n) := fun n => measurableSet_Ioc
  have hSsub : ∀ n : ℕ, S n ⊆ Ioi (0 : ℝ) := by
    intro n lam hlam
    exact lt_trans (hSpos n) hlam.1
  have hSmono : Monotone S := by
    intro i j hij lam hlam
    have hij' : ((i : ℝ) + 1) ≤ ((j : ℝ) + 1) := by
      have : (i : ℝ) ≤ (j : ℝ) := by exact_mod_cast hij
      linarith
    refine ⟨lt_of_le_of_lt ?_ hlam.1, le_trans hlam.2 hij'⟩
    have hpos : (0 : ℝ) < (i : ℝ) + 1 := by positivity
    gcongr
  -- each window carries a finite integral
  have hfin : ∀ n : ℕ, (∫⁻ lam in S n, F lam) ≠ ⊤ := by
    intro n
    set c : ℝ := ((n : ℝ) + 1)⁻¹ with hc
    have hcpos : (0 : ℝ) < c := hSpos n
    set C : ENNReal := (ENNReal.ofReal (c ^ (1 - p)) * X) ^ m with hC
    have hCtop : C ≠ ⊤ := by
      refine ENNReal.rpow_ne_top_of_nonneg hm0.le ?_
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hXtop
    have hb : ∀ lam ∈ S n, F lam ≤ ENNReal.ofReal (lam ^ (a - 1)) * C := by
      intro lam hlam
      have hlam0 : (0 : ℝ) < lam := hSsub n hlam
      refine mul_le_mul' le_rfl ?_
      rw [hC]
      refine ENNReal.rpow_le_rpow ?_ hm0.le
      refine le_trans (brsTail_le_lintegral_rpow hfnn hp hlam0) ?_
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact rpow_le_rpow_of_nonpos_exp hcpos hlam.1.le (by linarith)
    have hweight : (∫⁻ lam in S n, ENNReal.ofReal (lam ^ (a - 1))) ≠ ⊤ := by
      refine ne_of_lt (lt_of_le_of_lt ?_
        (lintegral_rpow_Ioc_lt_top (b := (n : ℝ) + 1) (a := a - 1)
          (by positivity) (by linarith)))
      refine lintegral_mono_set ?_
      intro lam hlam
      exact ⟨lt_trans (hSpos n) hlam.1, hlam.2⟩
    refine ne_of_lt (lt_of_le_of_lt (setLIntegral_mono' (hSmeas n) hb) ?_)
    rw [lintegral_mul_const' _ _ hCtop]
    exact ENNReal.mul_lt_top (lt_of_le_of_ne le_top hweight)
      (lt_of_le_of_ne le_top hCtop)
  -- the uniform bound on each window
  have hstep : ∀ n : ℕ, (∫⁻ lam in S n, F lam) ≤ ENNReal.ofReal a⁻¹ * X ^ m := by
    intro n
    have hsub := lintegral_brsTail_rpow_le_subset hf hfnn hm ha (hSmeas n)
      (hSsub n) (hfin n)
    have hrhs : (∫⁻ x, ENNReal.ofReal (f x ^ (1 + a / m)) ∂μ) = X := by
      rw [hX]
      refine lintegral_congr fun x => ?_
      rw [hpa, ENNReal.ofReal_rpow_of_nonneg (hfnn x) hp0]
    rw [hrhs] at hsub
    have hpow := ENNReal.rpow_le_rpow hsub hm0.le
    rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hm0.ne', ENNReal.rpow_one,
      ENNReal.mul_rpow_of_nonneg _ _ hm0.le,
      ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (inv_nonneg.mpr ha.le) _)
        hm0.le,
      ← Real.rpow_mul (inv_nonneg.mpr ha.le), inv_mul_cancel₀ hm0.ne',
      Real.rpow_one] at hpow
    exact hpow
  -- monotone convergence
  have hcover : ∀ lam : ℝ,
      (Ioi (0 : ℝ)).indicator F lam = ⨆ n : ℕ, (S n).indicator F lam := by
    intro lam
    by_cases hlam : (0 : ℝ) < lam
    · rw [Set.indicator_of_mem (show lam ∈ Ioi (0 : ℝ) from hlam)]
      obtain ⟨n, hn⟩ := exists_nat_gt (max lam lam⁻¹)
      have hn1 : lam ≤ (n : ℝ) + 1 := by
        have := lt_of_le_of_lt (le_max_left lam lam⁻¹) hn
        linarith
      have hn2 : ((n : ℝ) + 1)⁻¹ < lam := by
        have hinv : lam⁻¹ < (n : ℝ) + 1 :=
          lt_trans (lt_of_le_of_lt (le_max_right lam lam⁻¹) hn) (by linarith)
        have hnn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
        rw [inv_lt_comm₀ hnn hlam]
        exact hinv
      refine le_antisymm (le_iSup_of_le n ?_) (iSup_le fun k => ?_)
      · rw [Set.indicator_of_mem (show lam ∈ S n from ⟨hn2, hn1⟩)]
      · exact Set.indicator_le_self' (fun _ _ => bot_le) lam
    · rw [Set.indicator_of_notMem (show lam ∉ Ioi (0 : ℝ) from hlam)]
      refine le_antisymm (by simp) (iSup_le fun k => ?_)
      rw [Set.indicator_of_notMem
        (show lam ∉ S k from fun h => hlam (hSsub k h))]
  have hmono' : Monotone fun n : ℕ => (S n).indicator F := by
    intro i j hij
    exact indicator_le_indicator_of_subset (hSmono hij) (fun _ => bot_le)
  have hkey : (∫⁻ lam in Ioi (0 : ℝ), F lam) = ⨆ n : ℕ, ∫⁻ lam in S n, F lam := by
    rw [← lintegral_indicator measurableSet_Ioi]
    simp only [hcover]
    rw [lintegral_iSup (fun n => hFmeas.indicator (hSmeas n)) hmono']
    exact iSup_congr fun n => lintegral_indicator (hSmeas n) _
  rw [hkey]
  exact iSup_le hstep

/-! ## Splitting `R₂` at a height

The radial measure `s^{d-1} ds` and the elementary splitting
`R₂f₀(r) ≤ 3^{d-1} r^{-1} G(λ) + 2λ` that drives the endpoint `q = pd`. -/

/-- The radial measure `s^{d-1} ds` on the line. -/
def brsWeightMeasure (d : ℕ) : Measure ℝ :=
  volume.withDensity (fun s => ENNReal.ofReal s ^ (d - 1))

instance instSFinite_brsWeightMeasure (d : ℕ) : SFinite (brsWeightMeasure d) := by
  unfold brsWeightMeasure
  infer_instance

theorem measurable_brsWeightDensity (d : ℕ) :
    Measurable (fun s : ℝ => ENNReal.ofReal s ^ (d - 1)) := by fun_prop

theorem lintegral_brsWeightMeasure {d : ℕ} {g : ℝ → ENNReal} (hg : Measurable g) :
    (∫⁻ s, g s ∂(brsWeightMeasure d)) =
      ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
  rw [brsWeightMeasure,
    lintegral_withDensity_eq_lintegral_mul _ (measurable_brsWeightDensity d) hg]
  rfl

/-- **Splitting `R₂` at the height `lam`.** -/
theorem brsRemainderTwo_le_tail {d : ℕ} {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r lam : ℝ} (hr : 0 < r) (hlam : 0 < lam) :
    brsRemainderTwo (absProfile f₀) r ≤
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) *
          brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam +
        ENNReal.ofReal (2 * lam) := by
  have hmeasf : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set T : ENNReal := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  set g : ℝ → ENNReal := fun s =>
    {s : ℝ | lam < ‖f₀ s‖}.indicator (fun s => ENNReal.ofReal ‖f₀ s‖) s with hg
  have hgm : Measurable g := by
    rw [hg]
    exact (hmeasf.ennreal_ofReal).indicator
      (measurableSet_lt measurable_const hmeasf)
  have hTeq : T = ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
    rw [hT, brsTail]
    exact lintegral_brsWeightMeasure hgm
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have htr' : 3 * r / 2 ≤ t := htr
  have hab : t - r ≤ t + r := by linarith
  have hlow : (1 : ℝ) / 3 ≤ t - r := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * (ENNReal.ofReal s ^ (d - 1) * g s) +
      ENNReal.ofReal lam with hH
  have hHbound : ∀ s ∈ Icc (t - r) (t + r),
      ENNReal.ofReal ‖absProfile f₀ s‖ ≤ H s := by
    intro s hs
    have hs13 : (1 : ℝ) / 3 ≤ s := le_trans hlow hs.1
    have hsnn : (0 : ℝ) ≤ s := by linarith
    have hnorm : ‖absProfile f₀ s‖ = ‖f₀ s‖ := by
      rw [absProfile]
      simp
    rw [hnorm, hH]
    simp only
    by_cases hz : lam < ‖f₀ s‖
    · have hone : (1 : ENNReal) ≤
          ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1) := by
        rw [← ENNReal.ofReal_pow hsnn,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (d - 1)),
          ← mul_pow]
        refine ENNReal.one_le_ofReal.mpr ?_
        exact one_le_pow₀ (by linarith)
      calc ENNReal.ofReal ‖f₀ s‖
          = 1 * ENNReal.ofReal ‖f₀ s‖ := (one_mul _).symm
        _ ≤ (ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1)) *
              ENNReal.ofReal ‖f₀ s‖ := mul_le_mul' hone le_rfl
        _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) *
              (ENNReal.ofReal s ^ (d - 1) * g s) := by
            rw [hg]
            simp only
            rw [Set.indicator_of_mem (show s ∈ {s : ℝ | lam < ‖f₀ s‖} from hz)]
            ring
        _ ≤ _ := le_self_add
    · push Not at hz
      exact le_trans (ENNReal.ofReal_le_ofReal hz) le_add_self
  have hkey := ofReal_norm_intervalIntegral_le_lintegral hab (absProfile f₀) H
    hHbound
  have hHint : (∫⁻ s in Icc (t - r) (t + r), H s) ≤
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * T +
        ENNReal.ofReal lam * ENNReal.ofReal (2 * r) := by
    rw [hH]
    simp only
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      Real.volume_Icc, show t + r - (t - r) = 2 * r from by ring]
    refine add_le_add ?_ le_rfl
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hTeq]
    exact mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
  have e1 : ENNReal.ofReal r⁻¹ * ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) =
      ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) := by
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    ring
  have e2 : ENNReal.ofReal r⁻¹ *
      (ENNReal.ofReal lam * ENNReal.ofReal (2 * r)) =
      ENNReal.ofReal (2 * lam) := by
    rw [← ENNReal.ofReal_mul hlam.le,
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    field_simp
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖)
      = ENNReal.ofReal r⁻¹ *
          ENNReal.ofReal ‖∫ s in (t - r)..(t + r), absProfile f₀ s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal r⁻¹ *
          (ENNReal.ofReal ((3 : ℝ) ^ (d - 1)) * T +
            ENNReal.ofReal lam * ENNReal.ofReal (2 * r)) :=
        mul_le_mul' le_rfl (le_trans hkey hHint)
    _ = ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) * T +
          ENNReal.ofReal (2 * lam) := by
        rw [mul_add, ← mul_assoc, e1, e2]

/-! ## The level sets of `R₂`

Splitting at the height `u/4` confines `{R₂f₀ > u}` to an interval whose
length is controlled by the tail of `f₀`. -/

theorem brsRemainderTwo_eq_zero_of_nonpos {f₀ : ℝ → ℂ} {r : ℝ} (hr : r ≤ 0) :
    brsRemainderTwo (absProfile f₀) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  refine le_of_eq (ENNReal.ofReal_eq_zero.mpr ?_)
  exact mul_nonpos_of_nonpos_of_nonneg (inv_nonpos.mpr hr) (norm_nonneg _)

theorem brsWeightMeasure_Ioo {d : ℕ} (hd : 1 ≤ d) {b : ℝ} (hb : 0 ≤ b) :
    brsWeightMeasure d (Ioo 0 b) = ENNReal.ofReal (b ^ d / (d : ℝ)) := by
  have hdR : (1 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  rw [brsWeightMeasure, withDensity_apply _ measurableSet_Ioo]
  have hc : ∀ s ∈ Ioo (0 : ℝ) b, ENNReal.ofReal s ^ (d - 1) =
      ENNReal.ofReal (s ^ ((d : ℝ) - 1)) := by
    intro s hs
    rw [← ENNReal.ofReal_pow hs.1.le]
    congr 1
    simpa using pow_sub_eq_rpow hs.1 (D := d) (k := 1) hd
  rw [setLIntegral_congr_fun measurableSet_Ioo hc,
    lintegral_rpow_Ioo_zero_eq (by linarith : (-1 : ℝ) < (d : ℝ) - 1) hb]
  congr 1
  rw [show (d : ℝ) - 1 + 1 = (d : ℝ) from by ring, Real.rpow_natCast]

/-- **The level sets of `R₂`.** -/
theorem measure_brsRemainderTwo_gt_le {d : ℕ} (hd : 2 ≤ d) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {u : ℝ} (hu : 0 < u) :
    brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} ≤
      ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) *
        brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / 4) ^ d := by
  have hune : u ≠ 0 := ne_of_gt hu
  have hdpos : (0 : ℝ) < (d : ℝ) := by
    have : (0 : ℕ) < d := by omega
    exact_mod_cast this
  have hCnonneg : (0 : ℝ) ≤ (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) :=
    div_nonneg (pow_nonneg (by positivity) d) hdpos.le
  set T := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / 4) with hT
  by_cases hTtop : T = ⊤
  · rw [hTtop, ENNReal.top_pow (by omega : d ≠ 0),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact lt_of_lt_of_le (by positivity)
          (le_of_eq (rfl : ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) =
            (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ))))]
    exact le_top
  set g : ℝ := T.toReal with hg
  have hgnn : (0 : ℝ) ≤ g := ENNReal.toReal_nonneg
  have hTg : T = ENNReal.ofReal g := (ENNReal.ofReal_toReal hTtop).symm
  set rho : ℝ := 2 * (3 : ℝ) ^ (d - 1) * g / u with hrho
  have hrhonn : (0 : ℝ) ≤ rho := by
    rw [hrho]
    positivity
  have hsub : {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} ⊆
      Ioo 0 rho := by
    intro r hr
    simp only [Set.mem_setOf_eq] at hr
    have hr0 : 0 < r := by
      by_contra hc
      push Not at hc
      rw [brsRemainderTwo_eq_zero_of_nonpos hc] at hr
      simp at hr
    have hrne : r ≠ 0 := ne_of_gt hr0
    have hsplit := brsRemainderTwo_le_tail (d := d) hf₀ hr0
      (by positivity : (0 : ℝ) < u / 4)
    rw [← hT, hTg] at hsplit
    have hlt : ENNReal.ofReal u <
        ENNReal.ofReal ((3 : ℝ) ^ (d - 1) * r⁻¹) * ENNReal.ofReal g +
          ENNReal.ofReal (2 * (u / 4)) := lt_of_lt_of_le hr hsplit
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (3 : ℝ) ^ (d - 1) * r⁻¹),
      ← ENNReal.ofReal_add (by positivity) (by positivity)] at hlt
    have hreal : u < (3 : ℝ) ^ (d - 1) * r⁻¹ * g + 2 * (u / 4) :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hu.le).mp hlt
    refine ⟨hr0, ?_⟩
    rw [hrho, lt_div_iff₀ hu]
    have h2 : u / 2 < (3 : ℝ) ^ (d - 1) * r⁻¹ * g := by linarith
    have h3 : r * u / 2 < (3 : ℝ) ^ (d - 1) * g := by
      calc r * u / 2 = r * (u / 2) := by ring
        _ < r * ((3 : ℝ) ^ (d - 1) * r⁻¹ * g) := mul_lt_mul_of_pos_left h2 hr0
        _ = (3 : ℝ) ^ (d - 1) * g := by field_simp
    linarith
  calc brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r}
      ≤ brsWeightMeasure d (Ioo 0 rho) := measure_mono hsub
    _ = ENNReal.ofReal (rho ^ d / (d : ℝ)) :=
        brsWeightMeasure_Ioo (by omega) hrhonn
    _ = ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) * T ^ d := by
        rw [hTg, ← ENNReal.ofReal_pow hgnn, ← ENNReal.ofReal_mul hCnonneg]
        congr 1
        rw [hrho]
        field_simp
        ring

/-! ## Proposition 4.3 at the endpoint `q = pd`

The crude bound `R₂f₀(r) ≲ r^{-1/p}‖f₀‖_p` loses a logarithm at `q = pd`.
Splitting `f₀` at a height, the layer-cake formula and Minkowski's integral
inequality replace it; no interpolation theorem is needed.  The hypothesis
`p > 1` is what makes the level integral converge. -/

theorem brsTail_smul {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (f : α → ℝ) {c : ℝ} (hc : 0 < c) (u : ℝ) :
    brsTail μ (fun x => c * f x) u =
      ENNReal.ofReal c * brsTail μ f (u / c) := by
  rw [brsTail, brsTail, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun x => ?_
  by_cases hx : u / c < f x
  · have hx' : u < c * f x := by
      rw [div_lt_iff₀ hc] at hx
      linarith
    rw [Set.indicator_of_mem (show x ∈ {x : α | u < c * f x} from hx'),
      Set.indicator_of_mem (show x ∈ {x : α | u / c < f x} from hx),
      ← ENNReal.ofReal_mul hc.le]
  · have hx' : ¬ (u < c * f x) := by
      intro hcon
      exact hx (by rw [div_lt_iff₀ hc]; linarith)
    rw [Set.indicator_of_notMem (show x ∉ {x : α | u < c * f x} from hx'),
      Set.indicator_of_notMem (show x ∉ {x : α | u / c < f x} from hx), mul_zero]

/-- **BRS Proposition 4.3 at the endpoint `q = pd`, for `p > 1`.** -/
theorem prop43_brsRemainderTwo_endpoint {d : ℕ} (hd : 2 ≤ d) {p : ℝ}
    (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
          brsRemainderTwo (absProfile f₀) r ^ (p * (d : ℝ))) ^
            (1 / (p * (d : ℝ))) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
            (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hdnat : 0 < d := by omega
  have hdpos : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hdnat
  have hdone : (1 : ℝ) ≤ (d : ℝ) := by
    have : (1 : ℕ) ≤ d := by omega
    exact_mod_cast this
  set q : ℝ := p * (d : ℝ) with hq
  have hq0 : (0 : ℝ) < q := by rw [hq]; positivity
  set a : ℝ := (d : ℝ) * (p - 1) with ha
  have ha0 : (0 : ℝ) < a := by
    rw [ha]
    have h1 : (0 : ℝ) < p - 1 := by linarith
    positivity
  set K : ℝ := (2 * (3 : ℝ) ^ (d - 1)) ^ d / ((d : ℝ) * 4 ^ d) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  have hCpos : (0 : ℝ) < (q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q) := by
    have h4 : (0 : ℝ) < (4 : ℝ) ^ q := Real.rpow_pos_of_pos (by norm_num) _
    have : (0 : ℝ) < q * K * a⁻¹ * (4 : ℝ) ^ q := by positivity
    exact Real.rpow_pos_of_pos this _
  refine ⟨(q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q), hCpos, ?_⟩
  intro f₀ hf₀
  have hcont : Continuous (absProfile f₀) := continuous_absProfile hf₀
  have hR2meas : Measurable (brsRemainderTwo (absProfile f₀)) :=
    measurable_brsRemainderTwo hcont
  have hnormmeas : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set μ : Measure ℝ := brsWeightMeasure d with hmu
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact hCpos)]
    exact le_top
  -- `R₂` is finite
  have hR2fin : ∀ r : ℝ, brsRemainderTwo (absProfile f₀) r ≠ ⊤ := by
    intro r
    refine ne_top_of_le_ne_top ?_ (brsRemainderTwo_le_local hd hp.le hf₀ r)
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    exact ne_top_of_le_ne_top hXtop (setLIntegral_le_lintegral _ _)
  -- the two weighted integrals as integrals against `μ`
  have hmuX : X = ∫⁻ s, (ENNReal.ofReal ‖f₀ s‖) ^ p ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun s => (ENNReal.ofReal ‖f₀ s‖) ^ p)
      (ENNReal.continuous_rpow_const.measurable.comp hnormmeas.ennreal_ofReal), hX]
  have hLHS : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q) =
      ∫⁻ r, brsRemainderTwo (absProfile f₀) r ^ q ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun r => brsRemainderTwo (absProfile f₀) r ^ q)
      (ENNReal.continuous_rpow_const.measurable.comp hR2meas)]
  have hlayer := lintegral_ennreal_rpow_eq_meas_lt (μ := μ) hR2meas hR2fin hq0
  -- the pointwise bound on the level integrand
  have hpt : ∀ u ∈ Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} *
          ENNReal.ofReal (u ^ (q - 1)) ≤
        ENNReal.ofReal K * (ENNReal.ofReal (u ^ (a - 1)) *
          brsTail μ (fun s => 4 * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ)) := by
    intro u hu0
    have hu : (0 : ℝ) < u := hu0
    have hune : u ≠ 0 := ne_of_gt hu
    refine le_trans (mul_le_mul' (measure_brsRemainderTwo_gt_le hd hf₀ hu) le_rfl) ?_
    refine le_of_eq ?_
    rw [brsTail_smul (fun s => ‖f₀ s‖) (by norm_num : (0 : ℝ) < 4) u,
      ENNReal.rpow_natCast]
    set S : ENNReal := brsTail μ (fun s => ‖f₀ s‖) (u / 4) with hS
    have hAnn : (0 : ℝ) ≤ (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) :=
      div_nonneg (pow_nonneg (by positivity) d) hdpos.le
    have hupow : u ^ (q - 1) = u ^ (a - 1) * u ^ d := by
      rw [← Real.rpow_natCast u d, ← Real.rpow_add hu]
      congr 1
      rw [hq, ha]
      ring
    have ereal : (2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) * u ^ (q - 1) =
        K * u ^ (a - 1) * (4 : ℝ) ^ d := by
      rw [hupow, hK, div_pow]
      field_simp
    have hL : ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) * S ^ d *
        ENNReal.ofReal (u ^ (q - 1)) =
        ENNReal.ofReal ((2 * (3 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ) *
          u ^ (q - 1)) * S ^ d := by
      rw [ENNReal.ofReal_mul hAnn]
      ring
    have hR : ENNReal.ofReal K *
        (ENNReal.ofReal (u ^ (a - 1)) * (ENNReal.ofReal 4 * S) ^ d) =
        ENNReal.ofReal (K * u ^ (a - 1) * (4 : ℝ) ^ d) * S ^ d := by
      rw [mul_pow, ← ENNReal.ofReal_pow (by norm_num : (0 : ℝ) ≤ 4),
        ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * u ^ (a - 1)),
        ENNReal.ofReal_mul hKpos.le]
      ring
    rw [hL, hR, ereal]
  have hstep : (∫⁻ u in Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < brsRemainderTwo (absProfile f₀) r} *
        ENNReal.ofReal (u ^ (q - 1))) ≤
      ENNReal.ofReal K * ∫⁻ u in Ioi (0 : ℝ), ENNReal.ofReal (u ^ (a - 1)) *
        brsTail μ (fun s => 4 * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioi hpt
  -- the tail estimate
  have hhmeas : Measurable fun s : ℝ => 4 * ‖f₀ s‖ := measurable_const.mul hnormmeas
  have hhnn : ∀ s : ℝ, (0 : ℝ) ≤ 4 * ‖f₀ s‖ := fun s => by positivity
  have hpa : 1 + a / ((d : ℕ) : ℝ) = p := by
    rw [ha]
    field_simp
    ring
  have htail := lintegral_brsTail_rpow_le_total (μ := μ) hhmeas hhnn
    (p := p) (a := a) (m := ((d : ℕ) : ℝ)) hp.le hdone ha0 hpa
  have hXh : (∫⁻ s, ENNReal.ofReal (4 * ‖f₀ s‖) ^ p ∂μ) =
      ENNReal.ofReal ((4 : ℝ) ^ p) * X := by
    rw [hmuX, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun s => ?_
    rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
      ENNReal.mul_rpow_of_nonneg _ _ hp0.le,
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
  rw [hXh] at htail
  have hpow4 : (ENNReal.ofReal ((4 : ℝ) ^ p) * X) ^ ((d : ℕ) : ℝ) =
      ENNReal.ofReal ((4 : ℝ) ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ ((d : ℕ) : ℝ)),
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 4)]
  rw [hpow4] at htail
  -- assemble
  have hfinal : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      brsRemainderTwo (absProfile f₀) r ^ q) ≤
      ENNReal.ofReal (q * K * a⁻¹ * (4 : ℝ) ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [hLHS, hlayer]
    refine le_trans (mul_le_mul' le_rfl (le_trans hstep
      (mul_le_mul' le_rfl htail))) ?_
    refine le_of_eq ?_
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K * a⁻¹),
      ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K),
      ENNReal.ofReal_mul hq0.le]
    ring
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
        brsRemainderTwo (absProfile f₀) r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (q * K * a⁻¹ * (4 : ℝ) ^ q) *
          X ^ ((d : ℕ) : ℝ)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hfinal (by positivity)
    _ = ENNReal.ofReal ((q * K * a⁻¹ * (4 : ℝ) ^ q) ^ (1 / q)) * X ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul,
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) <
            q * K * a⁻¹ * (4 : ℝ) ^ q),
          show ((d : ℕ) : ℝ) * (1 / q) = 1 / p from by rw [hq]; field_simp]

/-! ## The kernel `|s - a|^c` on a window with an endpoint at `a` -/

theorem measurable_kernel_shift (a c : ℝ) :
    Measurable fun s : ℝ => ENNReal.ofReal (|s - a| ^ c) := by
  fun_prop

theorem lintegral_kernel_shift_left {a b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Icc a (a + b), ENNReal.ofReal (|s - a| ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  set f : ℝ → ENNReal := fun u =>
    (Icc (0 : ℝ) b).indicator (fun u => ENNReal.ofReal (|u| ^ c)) u with hf
  have hfmeas : Measurable f := by
    rw [hf]
    refine Measurable.indicator ?_ measurableSet_Icc
    fun_prop
  have hkey : (∫⁻ s in Icc a (a + b), ENNReal.ofReal (|s - a| ^ c)) =
      ∫⁻ s : ℝ, f (s - a) := by
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Icc a (a + b)
    · rw [Set.indicator_of_mem hs, hf]
      simp only
      rw [Set.indicator_of_mem (show s - a ∈ Icc (0 : ℝ) b from
        ⟨by linarith [hs.1], by linarith [hs.2]⟩)]
    · rw [Set.indicator_of_notMem hs, hf]
      simp only
      rw [Set.indicator_of_notMem (show s - a ∉ Icc (0 : ℝ) b from fun hcon =>
        hs ⟨by linarith [hcon.1], by linarith [hcon.2]⟩)]
  rw [hkey, lintegral_sub_right_eq_self f a, hf,
    lintegral_indicator measurableSet_Icc]
  rw [show (∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (|u| ^ c)) =
      ∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (u ^ c) from
    setLIntegral_congr_fun measurableSet_Icc (fun u hu => by
      rw [abs_of_nonneg hu.1])]
  exact lintegral_rpow_Icc_zero_eq hc hb

theorem lintegral_kernel_shift_right {a b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Icc (a - b) a, ENNReal.ofReal (|a - s| ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  set f : ℝ → ENNReal := fun u =>
    (Icc (0 : ℝ) b).indicator (fun u => ENNReal.ofReal (|u| ^ c)) u with hf
  have hfmeas : Measurable f := by
    rw [hf]
    refine Measurable.indicator ?_ measurableSet_Icc
    fun_prop
  have hkey : (∫⁻ s in Icc (a - b) a, ENNReal.ofReal (|a - s| ^ c)) =
      ∫⁻ s : ℝ, f (-(s - a)) := by
    rw [← lintegral_indicator measurableSet_Icc]
    refine lintegral_congr fun s => ?_
    by_cases hs : s ∈ Icc (a - b) a
    · rw [Set.indicator_of_mem hs, hf]
      simp only
      rw [Set.indicator_of_mem (show -(s - a) ∈ Icc (0 : ℝ) b from
        ⟨by linarith [hs.2], by linarith [hs.1]⟩)]
      congr 2
      rw [abs_neg, abs_sub_comm]
    · rw [Set.indicator_of_notMem hs, hf]
      simp only
      rw [Set.indicator_of_notMem (show -(s - a) ∉ Icc (0 : ℝ) b from fun hcon =>
        hs ⟨by linarith [hcon.2], by linarith [hcon.1]⟩)]
  have hneg : (∫⁻ s : ℝ, f (-(s - a))) = ∫⁻ u : ℝ, f u := by
    rw [show (fun s : ℝ => f (-(s - a))) = fun s : ℝ => (fun y => f (-y)) (s - a)
      from rfl, lintegral_sub_right_eq_self (fun y => f (-y)) a]
    exact lintegral_comp_neg f hfmeas
  rw [hkey, hneg, hf, lintegral_indicator measurableSet_Icc]
  rw [show (∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (|u| ^ c)) =
      ∫⁻ u in Icc (0 : ℝ) b, ENNReal.ofReal (u ^ c) from
    setLIntegral_congr_fun measurableSet_Icc (fun u hu => by
      rw [abs_of_nonneg hu.1])]
  exact lintegral_rpow_Icc_zero_eq hc hb

/-! ## `R₂^±` for `p > 2`

For `p > 2` the kernel `|s - (t-r)|^{-1/2}` is in `L^{p'}` of the window, with
norm `≍ r^{1/p' - 1/2}`.  Hölder then gives the pointwise bound
`R₂^± f(r) ≤ C_p r^{-1/p} ‖f‖_{L^p}`, uniformly in the dilation `t`, and
`∫_0^{4/3} r · r^{-1} dr < ∞` finishes.  No covering number of `E` appears:
for `p > 2` the operator is bounded on `L^p(r dr)` for **every** `E ⊆ [1,2]`. -/

/-- The Hölder constant of the half-power kernel. -/
def brsR2LargeConst (p : ℝ) : ℝ :=
  (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p)

theorem brsRemTwoTwoLeft_le_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoLeft E g r ≤
      ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
        (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  set pc : ℝ := Real.conjExponent p with hpc
  have hconj : p.HolderConjugate pc := Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / pc = 1 := by
    have h1 := hconj.one_div_add_one_div
    simpa using h1
  have hpinv : 1 / p < 1 / 2 := by
    rw [div_lt_div_iff₀ hp0 (by norm_num)]
    linarith
  have hpcinv : 1 / 2 < 1 / pc := by linarith
  have hpc0 : (0 : ℝ) < pc := by
    by_contra hcon
    push Not at hcon
    have : 1 / pc ≤ 0 := div_nonpos_of_nonneg_of_nonpos (by norm_num) hcon
    linarith
  have hpc2 : pc < 2 := by
    by_contra hcon
    push Not at hcon
    have : 1 / pc ≤ 1 / 2 := by
      rw [div_le_div_iff₀ hpc0 (by norm_num)]
      linarith
    linarith
  set kap : ℝ := 1 - pc / 2 with hkap
  have hkap0 : (0 : ℝ) < kap := by
    rw [hkap]
    linarith
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have ht2 : t ≤ 2 := (hE htE).2
  have hab : t - r ≤ t := by linarith
  have hlow : (1 : ℝ) / 3 ≤ t - r := by linarith
  have hKmeas : Measurable fun s : ℝ =>
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) :=
    measurable_kernel_shift (t - r) _
  -- the majorant of the integrand
  have hnorm : ∀ s : ℝ,
      ENNReal.ofReal ‖((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ =
        ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
      ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
  have hint := ofReal_norm_intervalIntegral_le_lintegral hab
    (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s)
    (fun s => ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ)
    (fun s _ => le_of_eq (hnorm s))
  -- Hölder on the window
  have hholder : (∫⁻ s in Icc (t - r) t,
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) ≤
      (∫⁻ s in Icc (t - r) t,
          ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
        (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ^ (1 / p) := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq
      (volume.restrict (Icc (t - r) t)) hconj.symm
      (f := fun s => ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)))
      (g := fun s => ‖g s‖ₑ) hKmeas.aemeasurable hg.enorm.aemeasurable
    simpa only [Pi.mul_apply] using h
  -- the kernel norm
  have hkernel : (∫⁻ s in Icc (t - r) t,
      ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) =
      ENNReal.ofReal (r ^ kap / kap) := by
    have hrw : ∀ s : ℝ,
        ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc =
          ENNReal.ofReal (|s - (t - r)| ^ (-(pc / 2))) := by
      intro s
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
          hpc0.le, ← Real.rpow_mul (abs_nonneg _)]
      congr 1
      ring
    rw [setLIntegral_congr_fun measurableSet_Icc (fun s _ => hrw s),
      show Icc (t - r) t = Icc (t - r) ((t - r) + r) from by congr 1; ring,
      lintegral_kernel_shift_left hr (by linarith : (-1 : ℝ) < -(pc / 2)),
      show -(pc / 2) + 1 = kap from by rw [hkap]; ring]
  -- the local `L^p` norm of `g`
  have hgpiece : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ≤ ENNReal.ofReal 3 * M := by
    have h1 : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ≤
        ∫⁻ s in Icc (t - r) t,
          ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
      refine setLIntegral_mono' measurableSet_Icc fun s hs => ?_
      have hs13 : (1 : ℝ) / 3 ≤ s := le_trans hlow hs.1
      calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
        _ ≤ ENNReal.ofReal (3 * s) * ‖g s‖ₑ ^ p := by
            refine mul_le_mul' ?_ le_rfl
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 from by simp]
            exact ENNReal.ofReal_le_ofReal (by linarith)
        _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3)]
            ring
    refine le_trans h1 (le_trans (setLIntegral_le_lintegral _ _) ?_)
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hM]
  -- the real exponent bookkeeping
  have hkexp : kap * (1 / pc) = 1 / pc - 1 / 2 := by
    rw [hkap]
    field_simp
  have hexp : r ^ (-(1 / 2) : ℝ) * (r ^ kap / kap) ^ (1 / pc) =
      brsR2LargeConst p * r ^ (-(1 / p)) := by
    have h1 : (r ^ kap / kap) ^ (1 / pc) =
        r ^ (kap * (1 / pc)) * (1 / kap) ^ (1 / pc) := by
      rw [div_eq_mul_one_div,
        Real.mul_rpow (Real.rpow_nonneg hr.le _) (by positivity),
        ← Real.rpow_mul hr.le]
    have h2 : brsR2LargeConst p = (1 / kap) ^ (1 / pc) := by
      rw [brsR2LargeConst, ← hpc, ← hkap]
    rw [h1, h2, ← mul_assoc, ← Real.rpow_add hr]
    rw [show -(1 / 2 : ℝ) + kap * (1 / pc) = -(1 / p) from by
      rw [hkexp]; linarith]
    ring
  -- assemble
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in (t - r)..t, ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in (t - r)..t,
            ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ((∫⁻ s in Icc (t - r) t,
              ENNReal.ofReal (|s - (t - r)| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
            (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl (le_trans hint hholder)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (r ^ kap / kap) ^ (1 / pc) *
            (ENNReal.ofReal 3 * M) ^ (1 / p)) := by
        rw [hkernel]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (ENNReal.rpow_le_rpow hgpiece (by positivity)))
    _ = ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p) := by
        rw [ENNReal.ofReal_rpow_of_nonneg
            (by positivity : (0 : ℝ) ≤ r ^ kap / kap) (by positivity),
          ← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _), hexp]

/-! ## `R₂^±` on `L^p(r dr)` for `p > 2`, with no covering numbers -/

theorem conjExponent_pos_of_two_lt {p : ℝ} (hp : 2 < p) :
    0 < Real.conjExponent p ∧ Real.conjExponent p < 2 := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  have hconj : p.HolderConjugate (Real.conjExponent p) :=
    Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / Real.conjExponent p = 1 := by
    simpa using hconj.one_div_add_one_div
  have hpinv : 1 / p < 1 / 2 := by
    rw [div_lt_div_iff₀ hp0 (by norm_num)]
    linarith
  have hpcinv : 1 / 2 < 1 / Real.conjExponent p := by linarith
  have hpc0 : (0 : ℝ) < Real.conjExponent p := by
    by_contra hcon
    push Not at hcon
    have : 1 / Real.conjExponent p ≤ 0 :=
      div_nonpos_of_nonneg_of_nonpos (by norm_num) hcon
    linarith
  refine ⟨hpc0, ?_⟩
  by_contra hcon
  push Not at hcon
  have : 1 / Real.conjExponent p ≤ 1 / 2 := by
    rw [div_le_div_iff₀ hpc0 (by norm_num)]
    linarith
  linarith

theorem brsR2LargeConst_pos {p : ℝ} (hp : 2 < p) : 0 < brsR2LargeConst p := by
  obtain ⟨hpc0, hpc2⟩ := conjExponent_pos_of_two_lt hp
  rw [brsR2LargeConst]
  refine Real.rpow_pos_of_pos ?_ _
  have : (0 : ℝ) < 1 - Real.conjExponent p / 2 := by linarith
  positivity

theorem brsRemTwoTwoRight_le_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : 0 < r) :
    brsRemTwoTwoRight E g r ≤
      ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
        (ENNReal.ofReal 3 * ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp0 : (0 : ℝ) < p := by linarith
  set pc : ℝ := Real.conjExponent p with hpc
  have hconj : p.HolderConjugate pc := Real.HolderConjugate.conjExponent hp1
  have hsum : 1 / p + 1 / pc = 1 := by simpa using hconj.one_div_add_one_div
  obtain ⟨hpc0, hpc2⟩ := conjExponent_pos_of_two_lt hp
  rw [← hpc] at hpc0 hpc2
  set kap : ℝ := 1 - pc / 2 with hkap
  have hkap0 : (0 : ℝ) < kap := by
    rw [hkap]
    linarith
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have ht1 : (1 : ℝ) ≤ t := (hE htE).1
  have hab : t ≤ t + r := by linarith
  have hKmeas : Measurable fun s : ℝ =>
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) := by
    fun_prop
  have hnorm : ∀ s : ℝ,
      ENNReal.ofReal ‖((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ =
        ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
      ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
  have hint := ofReal_norm_intervalIntegral_le_lintegral hab
    (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s)
    (fun s => ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ)
    (fun s _ => le_of_eq (hnorm s))
  have hholder : (∫⁻ s in Icc t (t + r),
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) ≤
      (∫⁻ s in Icc t (t + r),
          ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
        (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ^ (1 / p) := by
    have h := ENNReal.lintegral_mul_le_Lp_mul_Lq
      (volume.restrict (Icc t (t + r))) hconj.symm
      (f := fun s => ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)))
      (g := fun s => ‖g s‖ₑ) hKmeas.aemeasurable hg.enorm.aemeasurable
    simpa only [Pi.mul_apply] using h
  have hkernel : (∫⁻ s in Icc t (t + r),
      ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) =
      ENNReal.ofReal (r ^ kap / kap) := by
    have hrw : ∀ s : ℝ,
        ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc =
          ENNReal.ofReal (|t + r - s| ^ (-(pc / 2))) := by
      intro s
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _)
          hpc0.le, ← Real.rpow_mul (abs_nonneg _)]
      congr 1
      ring
    rw [setLIntegral_congr_fun measurableSet_Icc (fun s _ => hrw s),
      show Icc t (t + r) = Icc ((t + r) - r) (t + r) from by congr 1; ring,
      lintegral_kernel_shift_right hr (by linarith : (-1 : ℝ) < -(pc / 2)),
      show -(pc / 2) + 1 = kap from by rw [hkap]; ring]
  have hgpiece : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ≤
      ENNReal.ofReal 3 * M := by
    have h1 : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ≤
        ∫⁻ s in Icc t (t + r),
          ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
      refine setLIntegral_mono' measurableSet_Icc fun s hs => ?_
      have hs13 : (1 : ℝ) / 3 ≤ s := by
        have := hs.1
        linarith
      calc ‖g s‖ₑ ^ p = 1 * ‖g s‖ₑ ^ p := (one_mul _).symm
        _ ≤ ENNReal.ofReal (3 * s) * ‖g s‖ₑ ^ p := by
            refine mul_le_mul' ?_ le_rfl
            rw [show (1 : ENNReal) = ENNReal.ofReal 1 from by simp]
            exact ENNReal.ofReal_le_ofReal (by linarith)
        _ = ENNReal.ofReal 3 * (ENNReal.ofReal s * ‖g s‖ₑ ^ p) := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3)]
            ring
    refine le_trans h1 (le_trans (setLIntegral_le_lintegral _ _) ?_)
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hM]
  have hkexp : kap * (1 / pc) = 1 / pc - 1 / 2 := by
    rw [hkap]
    field_simp
  have hexp : r ^ (-(1 / 2) : ℝ) * (r ^ kap / kap) ^ (1 / pc) =
      brsR2LargeConst p * r ^ (-(1 / p)) := by
    have h1 : (r ^ kap / kap) ^ (1 / pc) =
        r ^ (kap * (1 / pc)) * (1 / kap) ^ (1 / pc) := by
      rw [div_eq_mul_one_div,
        Real.mul_rpow (Real.rpow_nonneg hr.le _) (by positivity),
        ← Real.rpow_mul hr.le]
    have h2 : brsR2LargeConst p = (1 / kap) ^ (1 / pc) := by
      rw [brsR2LargeConst, ← hpc, ← hkap]
    rw [h1, h2, ← mul_assoc, ← Real.rpow_add hr]
    rw [show -(1 / 2 : ℝ) + kap * (1 / pc) = -(1 / p) from by
      rw [hkexp]; linarith]
    ring
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in t..(t + r), ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..(t + r),
            ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ((∫⁻ s in Icc t (t + r),
              ENNReal.ofReal (|t + r - s| ^ (-(1 / 2) : ℝ)) ^ pc) ^ (1 / pc) *
            (∫⁻ s in Icc t (t + r), ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl (le_trans hint hholder)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (r ^ kap / kap) ^ (1 / pc) *
            (ENNReal.ofReal 3 * M) ^ (1 / p)) := by
        rw [hkernel]
        exact mul_le_mul' le_rfl (mul_le_mul' le_rfl
          (ENNReal.rpow_le_rpow hgpiece (by positivity)))
    _ = ENNReal.ofReal (brsR2LargeConst p * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p) := by
        rw [ENNReal.ofReal_rpow_of_nonneg
            (by positivity : (0 : ℝ) ≤ r ^ kap / kap) (by positivity),
          ← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _), hexp]

/-! ## `R₂^±` is bounded on `L^p(r dr)` for every `p > 2`

BRS state Lemma 5.3 for all `1 ≤ p < ∞` and refer to [21, Prop. 5.3] for the
proof.  For `p ≤ 2` the covering-number form is proved above; for `p > 2` the
half-power kernel is in `L^{p'}` of the window and Hölder gives boundedness
with **no** covering number at all, which is stronger. -/

theorem lemma53_brsRemTwoTwoLeft_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 / p) * brsR2LargeConst p) *
        (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hC : 0 < brsR2LargeConst p := brsR2LargeConst_pos hp
  set C : ℝ := brsR2LargeConst p with hCdef
  set M : ENNReal := ∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p with hM
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p ≤
      (Ioc (0 : ℝ) (4 / 3)).indicator
        (fun _ => ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M)) r := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul]
      exact zero_le
    have hrne : r ≠ 0 := ne_of_gt hr
    rcases le_or_gt r (4 / 3) with hrle | hrgt
    · rw [Set.indicator_of_mem (show r ∈ Ioc (0 : ℝ) (4 / 3) from ⟨hr, hrle⟩)]
      have hb := brsRemTwoTwoLeft_le_of_two_lt hE hp hg hr
      have hval : ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
          (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p =
          ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
          show (1 : ℝ) / p * p = 1 from by field_simp, ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_pos
            (by positivity : (0 : ℝ) < C * r ^ (-(1 / p))),
          ← mul_assoc, ← ENNReal.ofReal_mul hr.le]
        congr 2
        rw [Real.mul_rpow hC.le (Real.rpow_nonneg hr.le _),
          ← Real.rpow_mul hr.le,
          show -(1 / p) * p = -1 from by field_simp, Real.rpow_neg_one]
        field_simp
      calc ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p
          ≤ ENNReal.ofReal r * (ENNReal.ofReal (C * r ^ (-(1 / p))) *
              (ENNReal.ofReal 3 * M) ^ (1 / p)) ^ p :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hb hp0.le)
        _ = ENNReal.ofReal (C ^ p) * (ENNReal.ofReal 3 * M) := hval
    · rw [brsRemTwoTwoLeft_eq_zero hE hrgt, ENNReal.zero_rpow_of_pos hp0,
        mul_zero]
      exact zero_le
  have hint : (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ≤
      ENNReal.ofReal (4 * C ^ p) * M := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioc, setLIntegral_const,
      Real.volume_Ioc, show (4 : ℝ) / 3 - 0 = 4 / 3 from by ring,
      show ENNReal.ofReal (4 * C ^ p) =
          ENNReal.ofReal (C ^ p) * ENNReal.ofReal 3 * ENNReal.ofReal (4 / 3) from by
        rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p),
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ C ^ p * 3)]
        congr 1
        ring]
    exact le_of_eq (by ring)
  calc (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p)
      ≤ (ENNReal.ofReal (4 * C ^ p) * M) ^ (1 / p) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal ((4 : ℝ) ^ (1 / p) * C) * M ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < 4 * C ^ p)]
        congr 2
        rw [Real.mul_rpow (by norm_num : (0 : ℝ) ≤ 4) (by positivity),
          ← Real.rpow_mul hC.le,
          show p * (1 / p) = 1 from by field_simp, Real.rpow_one]

theorem lemma53_brsRemTwoTwoRight_of_two_lt {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p) ≤
