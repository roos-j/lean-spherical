/-! ## The diagonal `q = p` of Proposition 5.4

The coefficient of Lemma 5.3 is geometric as soon as `β < p/2`, which is the
condition Proposition 5.4 imposes on the diagonal. -/

theorem brsDyadic_eq_rpow (m : ℕ) : brsDyadic m = (2 : ℝ) ^ (-(m : ℝ)) := by
  rw [brsDyadic, show (1 / 2 : ℝ) = (2 : ℝ) ^ (-1 : ℝ) from by
      rw [Real.rpow_neg_one]
      norm_num,
    ← Real.rpow_natCast ((2 : ℝ) ^ (-1 : ℝ)) m,
    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
  congr 1
  ring

theorem brsLemma53Coeff_le_geom {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) {p : ℝ} (hp0 : 0 < p)
    (m : ℕ) :
    brsLemma53Coeff E p m ≤
      ENNReal.ofReal (3 * (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) *
        ((2 : ℝ) ^ (β / p - 1 / 2)) ^ m) := by
  have hδpos : 0 < brsDyadic m := brsDyadic_pos m
  set δ : ℝ := brsDyadic m with hδdef
  have hδ : δ = (2 : ℝ) ^ (-(m : ℝ)) := brsDyadic_eq_rpow m
  have hNm : (intervalCoveringNumber E δ : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (m : ℝ))) := by
    rw [hδ]
    exact hN m
  have hA : ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (m : ℝ))) *
      (ENNReal.ofReal (2 * 3 ^ (p / 2)) * ENNReal.ofReal (3 * δ) ^ p) =
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (m : ℝ)) * (2 * 3 ^ (p / 2)) *
        (3 * δ) ^ p) := by
    rw [ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < 3 * δ),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ 2 * 3 ^ (p / 2)),
      ← ENNReal.ofReal_mul (by positivity :
        (0 : ℝ) ≤ Cβ * (2 : ℝ) ^ (β * (m : ℝ)))]
    congr 1
    ring
  have hreal : δ ^ (-(1 / 2) : ℝ) *
      (Cβ * (2 : ℝ) ^ (β * (m : ℝ)) * (2 * 3 ^ (p / 2)) * (3 * δ) ^ p) ^
        (1 / p) =
      3 * (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) *
        ((2 : ℝ) ^ (β / p - 1 / 2)) ^ m := by
    have e1 : (3 * δ : ℝ) ^ p = 3 ^ p * δ ^ p :=
      Real.mul_rpow (by norm_num) hδpos.le
    have e2 : Cβ * (2 : ℝ) ^ (β * (m : ℝ)) * (2 * 3 ^ (p / 2)) *
        (3 ^ p * δ ^ p) =
        (2 * Cβ * 3 ^ (p / 2)) * (2 : ℝ) ^ (β * (m : ℝ)) * (3 ^ p * δ ^ p) := by
      ring
    have hX : (0 : ℝ) ≤ 2 * Cβ * 3 ^ (p / 2) := by positivity
    have e3 : ((2 * Cβ * 3 ^ (p / 2)) * (2 : ℝ) ^ (β * (m : ℝ)) *
        (3 ^ p * δ ^ p)) ^ (1 / p) =
        (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) * (2 : ℝ) ^ (β * (m : ℝ) / p) *
          (3 * δ) := by
      rw [Real.mul_rpow (by positivity) (by positivity),
        Real.mul_rpow hX (Real.rpow_nonneg (by norm_num) _),
        Real.mul_rpow (Real.rpow_nonneg (by norm_num) _)
          (Real.rpow_nonneg hδpos.le _),
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2),
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3),
        ← Real.rpow_mul hδpos.le,
        show p * (1 / p) = 1 from by field_simp, Real.rpow_one, Real.rpow_one]
      ring_nf
    rw [e1, e2, e3]
    have e4 : δ ^ (-(1 / 2) : ℝ) * δ = δ ^ (1 / 2 : ℝ) := by
      nth_rewrite 2 [show δ = δ ^ (1 : ℝ) from (Real.rpow_one δ).symm]
      rw [← Real.rpow_add hδpos]
      congr 1
      ring
    have e5 : δ ^ (1 / 2 : ℝ) = (2 : ℝ) ^ (-(m : ℝ) / 2) := by
      rw [hδ, ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1
      ring
    have e6 : (2 : ℝ) ^ (β * (m : ℝ) / p) * (2 : ℝ) ^ (-(m : ℝ) / 2) =
        ((2 : ℝ) ^ (β / p - 1 / 2)) ^ m := by
      rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2),
        ← Real.rpow_natCast ((2 : ℝ) ^ (β / p - 1 / 2)) m,
        ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      congr 1
      field_simp
      ring
    calc δ ^ (-(1 / 2) : ℝ) *
          ((2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) * (2 : ℝ) ^ (β * (m : ℝ) / p) *
            (3 * δ))
        = (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) * 3 *
            ((2 : ℝ) ^ (β * (m : ℝ) / p) * (δ ^ (-(1 / 2) : ℝ) * δ)) := by ring
      _ = (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) * 3 *
            ((2 : ℝ) ^ (β * (m : ℝ) / p) * (2 : ℝ) ^ (-(m : ℝ) / 2)) := by
          rw [e4, e5]
      _ = 3 * (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) *
            ((2 : ℝ) ^ (β / p - 1 / 2)) ^ m := by
          rw [e6]
          ring
  rw [brsLemma53Coeff, ← hδdef]
  refine le_trans (mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
    (mul_le_mul' hNm le_rfl) (by positivity : (0 : ℝ) ≤ 1 / p))) ?_
  rw [hA, ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity),
    ← ENNReal.ofReal_mul (Real.rpow_nonneg hδpos.le _)]
  exact ENNReal.ofReal_le_ofReal (le_of_eq hreal)

theorem tsum_brsLemma53Coeff_ne_top {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) {p : ℝ} (hp0 : 0 < p)
    (hβ : β < p / 2) : (∑' m : ℕ, brsLemma53Coeff E p m) ≠ ⊤ := by
  set ρ : ℝ := (2 : ℝ) ^ (β / p - 1 / 2) with hρdef
  have hρ0 : (0 : ℝ) ≤ ρ := (Real.rpow_pos_of_pos (by norm_num) _).le
  have hρ1 : ρ < 1 := by
    rw [hρdef, show (1 : ℝ) = (2 : ℝ) ^ (0 : ℝ) from (Real.rpow_zero 2).symm]
    refine Real.rpow_lt_rpow_of_exponent_lt (by norm_num) ?_
    rw [sub_neg]
    rw [div_lt_div_iff₀ hp0 (by norm_num)]
    linarith
  have hCsum : (0 : ℝ) ≤ 3 * (2 * Cβ * 3 ^ (p / 2)) ^ (1 / p) := by positivity
  refine ne_of_lt (lt_of_le_of_lt
    (ENNReal.tsum_le_tsum (brsLemma53Coeff_le_geom hCβ hN hp0)) ?_)
  rw [tsum_ofReal_geom hCsum hρ0 hρ1]
  exact ENNReal.ofReal_lt_top

/-! ## Proposition 5.4 on the diagonal `q = p`

`prop54_brsRemTwoTwo{Left,Right}_pq` needs `p < q` (the interpolation exponent
`r = (1 + 1/q - 1/p)⁻¹` exceeds `1` only then).  The missing diagonal is
Lemma 5.3: for `p ≤ 2` its coefficient is geometric exactly when `β < p/2`,
which is what Proposition 5.4's hypothesis `q/p < 1 + q/2 - β` says at `q = p`;
for `p > 2` the `E`-free bound applies with no condition at all. -/

/-- **Proposition 5.4 on the diagonal, `R₂^-`.** -/
theorem prop54_brsRemTwoTwoLeft_diag {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {p : ℝ} (hp1 : 1 < p) (hβ : β < p / 2) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ p) ^ (1 / p) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp1
  rcases le_or_gt p 2 with hp2 | hp2
  · have hsum := tsum_brsLemma53Coeff_ne_top hCβ hN hp0 hβ
    refine ⟨(∑' m : ℕ, brsLemma53Coeff E p m).toReal, ENNReal.toReal_nonneg, ?_⟩
    rw [ENNReal.ofReal_toReal hsum]
    exact lemma53_brsRemTwoTwoLeft hE hp1.le hp2 hg
  · have hC := brsR2LargeConst_pos hp2
    refine ⟨(4 : ℝ) ^ (1 / p) * brsR2LargeConst p,
      mul_nonneg (Real.rpow_nonneg (by norm_num) _) hC.le, ?_⟩
    exact lemma53_brsRemTwoTwoLeft_of_two_lt hE hp2 hg

/-- **Proposition 5.4 on the diagonal, `R₂^+`.** -/
theorem prop54_brsRemTwoTwoRight_diag {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {p : ℝ} (hp1 : 1 < p) (hβ : β < p / 2) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ℝ, 0 ≤ C ∧
      (∫⁻ r, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ p) ^ (1 / p) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp1
  rcases le_or_gt p 2 with hp2 | hp2
  · have hsum := tsum_brsLemma53Coeff_ne_top hCβ hN hp0 hβ
    refine ⟨(∑' m : ℕ, brsLemma53Coeff E p m).toReal, ENNReal.toReal_nonneg, ?_⟩
    rw [ENNReal.ofReal_toReal hsum]
    exact lemma53_brsRemTwoTwoRight hE hp1.le hp2 hg
  · have hC := brsR2LargeConst_pos hp2
    refine ⟨(4 : ℝ) ^ (1 / p) * brsR2LargeConst p,
      mul_nonneg (Real.rpow_nonneg (by norm_num) _) hC.le, ?_⟩
    exact lemma53_brsRemTwoTwoRight_of_two_lt hE hp2 hg

/-! ## Foundations for the localized covering estimate

BRS's `ω_m^{p,q}(E,k)` replaces the global covering number `N(E,δ)` by
`sup_{|J|=2^{-k}} N(E ∩ J, δ)`.  The gain comes from two facts: a convolution
with a compactly supported kernel, restricted to a window `V`, only sees the
data on a neighbourhood `W` of `V`; and the resulting local `L^p` masses may be
summed with the `ℓ^p ↪ ℓ^q` embedding rather than added crudely. -/

/-- **Young's inequality, localized.**  On a window `V` the convolution only
sees `g` on any `W` containing `V` thickened by the support radius of `K`. -/
theorem lintegral_convolution_rpow_le_young_local {p q r : ℝ} (hp : 1 ≤ p)
    (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) {K : ℝ → ℝ} (hK : Measurable K)
    {g : ℝ → ℂ} (hg : Measurable g) {L : ℝ} (hL : ∀ y : ℝ, L < |y| → K y = 0)
    {V W : Set ℝ} (hV : MeasurableSet V) (hW : MeasurableSet W)
    (hVW : ∀ x ∈ V, ∀ y : ℝ, |y| ≤ L → x - y ∈ W) :
    (∫⁻ x in V, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q) ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) ^ (q / r) *
        (∫⁻ z in W, ‖g z‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  set gW : ℝ → ℂ := W.indicator g with hgW
  have hgWm : Measurable gW := hg.indicator hW
  have heq : ∀ x ∈ V, (∫ y : ℝ, (K y : ℂ) * g (x - y)) =
      ∫ y : ℝ, (K y : ℂ) * gW (x - y) := by
    intro x hx
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    change (K y : ℂ) * g (x - y) = (K y : ℂ) * gW (x - y)
    rw [hgW]
    by_cases hy : |y| ≤ L
    · rw [Set.indicator_of_mem (hVW x hx y hy)]
    · push Not at hy
      rw [hL y hy]
      simp
  have hnorm : (∫⁻ z : ℝ, ‖gW z‖ₑ ^ p) = ∫⁻ z in W, ‖g z‖ₑ ^ p := by
    rw [← lintegral_indicator hW]
    refine lintegral_congr fun z => ?_
    by_cases hz : z ∈ W
    · rw [Set.indicator_of_mem hz, hgW, Set.indicator_of_mem hz]
    · rw [Set.indicator_of_notMem hz, hgW, Set.indicator_of_notMem hz,
        enorm_zero, ENNReal.zero_rpow_of_pos hp0]
  calc (∫⁻ x in V, ‖∫ y : ℝ, (K y : ℂ) * g (x - y)‖ₑ ^ q)
      = ∫⁻ x in V, ‖∫ y : ℝ, (K y : ℂ) * gW (x - y)‖ₑ ^ q := by
        refine setLIntegral_congr_fun hV fun x hx => ?_
        rw [heq x hx]
    _ ≤ ∫⁻ x : ℝ, ‖∫ y : ℝ, (K y : ℂ) * gW (x - y)‖ₑ ^ q :=
        setLIntegral_le_lintegral _ _
    _ ≤ (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) ^ (q / r) *
          (∫⁻ z : ℝ, ‖gW z‖ₑ ^ p) ^ (q / p) :=
        lintegral_convolution_rpow_le_young hp hr hrq hpq hrel hK hgWm
    _ = (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) ^ (q / r) *
          (∫⁻ z in W, ‖g z‖ₑ ^ p) ^ (q / p) := by rw [hnorm]

/-- **Bounded overlap.**  A family whose indicators sum to at most `C`
contributes at most `C` times the global integral. -/
theorem tsum_setLIntegral_le_of_overlap {W : ℕ → Set ℝ}
    (hW : ∀ n, MeasurableSet (W n)) {C : ENNReal}
    (hov : ∀ x : ℝ,
      (∑' n : ℕ, (W n).indicator (fun _ => (1 : ENNReal)) x) ≤ C)
    {f : ℝ → ENNReal} (hf : Measurable f) :
    (∑' n : ℕ, ∫⁻ x in W n, f x) ≤ C * ∫⁻ x : ℝ, f x := by
  have hstep : ∀ n : ℕ, (∫⁻ x in W n, f x) =
      ∫⁻ x : ℝ, (W n).indicator (fun _ => (1 : ENNReal)) x * f x := by
    intro n
    rw [← lintegral_indicator (hW n)]
    refine lintegral_congr fun x => ?_
    by_cases hx : x ∈ W n
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, one_mul]
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul]
  have hmeas : ∀ n : ℕ, AEMeasurable
      (fun x : ℝ => (W n).indicator (fun _ => (1 : ENNReal)) x * f x) volume :=
    fun n => (((measurable_const : Measurable fun _ : ℝ => (1 : ENNReal)).indicator
      (hW n)).mul hf).aemeasurable
  have hswap : (∑' n : ℕ, ∫⁻ x : ℝ,
      (W n).indicator (fun _ => (1 : ENNReal)) x * f x) =
      ∫⁻ x : ℝ, ∑' n : ℕ,
        (W n).indicator (fun _ => (1 : ENNReal)) x * f x :=
    (lintegral_tsum hmeas).symm
  rw [tsum_congr hstep, hswap]
  refine le_trans (lintegral_mono fun x => ?_)
    (le_of_eq (lintegral_const_mul C hf))
  rw [ENNReal.tsum_mul_right]
  exact mul_le_mul' (hov x) le_rfl

/-! ## The window maximal estimate, localized to a range of radii

Restricting the radius to `V` means the translated window only meets `A`, so
the estimate may be run against `A.indicator F` and costs only the local norm
of `F`. -/

theorem lintegral_enorm_indicator_rpow {A : Set ℝ} (hA : MeasurableSet A)
    (H : ℝ → ℂ) {q : ℝ} (hq : 0 < q) :
    (∫⁻ z : ℝ, ‖A.indicator H z‖ₑ ^ q) = ∫⁻ z in A, ‖H z‖ₑ ^ q := by
  rw [← lintegral_indicator hA]
  refine lintegral_congr fun z => ?_
  by_cases hz : z ∈ A
  · rw [Set.indicator_of_mem hz, Set.indicator_of_mem hz]
  · rw [Set.indicator_of_notMem hz, Set.indicator_of_notMem hz, enorm_zero,
      ENNReal.zero_rpow_of_pos hq]

/-- **The window maximal estimate, localized.** -/
theorem lintegral_brsWindowMax_rpow_le_local {F F' : ℝ → ℂ} (hF : Measurable F)
    (hF' : Measurable F') {a δ q : ℝ} (hδ : 0 < δ) (hq : 1 ≤ q)
    {V A : Set ℝ} (hV : MeasurableSet V) (hA : MeasurableSet A)
    (hVA : ∀ s ∈ Icc (a - δ / 2) (a + δ / 2), ∀ r ∈ V, s - r ∈ A) :
    (∫⁻ r in V, brsWindowMax F F' a δ r ^ q) ^ (1 / q) ≤
      (∫⁻ z in A, ‖F z‖ₑ ^ q) ^ (1 / q) +
        ENNReal.ofReal δ * (∫⁻ z in A, ‖F' z‖ₑ ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hFA : Measurable (A.indicator F) := hF.indicator hA
  have hF'A : Measurable (A.indicator F') := hF'.indicator hA
  have hcongr : ∀ r ∈ V, brsWindowMax F F' a δ r =
      brsWindowMax (A.indicator F) (A.indicator F') a δ r := by
    intro r hr
    rw [brsWindowMax, brsWindowMax]
    congr 1
    · congr 1
      refine setLIntegral_congr_fun measurableSet_Icc fun s hs => ?_
      rw [Set.indicator_of_mem (hVA s hs r hr)]
    · refine setLIntegral_congr_fun measurableSet_Icc fun s hs => ?_
      rw [Set.indicator_of_mem (hVA s hs r hr)]
  calc (∫⁻ r in V, brsWindowMax F F' a δ r ^ q) ^ (1 / q)
      = (∫⁻ r in V,
          brsWindowMax (A.indicator F) (A.indicator F') a δ r ^ q) ^ (1 / q) := by
        congr 1
        refine setLIntegral_congr_fun hV fun r hr => ?_
        rw [hcongr r hr]
    _ ≤ (∫⁻ r : ℝ,
          brsWindowMax (A.indicator F) (A.indicator F') a δ r ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow (setLIntegral_le_lintegral _ _) (by positivity)
    _ ≤ (∫⁻ z : ℝ, ‖A.indicator F z‖ₑ ^ q) ^ (1 / q) +
          ENNReal.ofReal δ * (∫⁻ z : ℝ, ‖A.indicator F' z‖ₑ ^ q) ^ (1 / q) :=
        lintegral_brsWindowMax_rpow_le hFA hF'A hδ hq
    _ = (∫⁻ z in A, ‖F z‖ₑ ^ q) ^ (1 / q) +
          ENNReal.ofReal δ * (∫⁻ z in A, ‖F' z‖ₑ ^ q) ^ (1 / q) := by
        rw [lintegral_enorm_indicator_rpow hA F hq0,
          lintegral_enorm_indicator_rpow hA F' hq0]

/-! ## The covering estimate with a two-level cover

Grouping the cover points of `E` into blocks and keeping the radius confined
to `V` replaces the global count `#ι` by the largest count in a single block,
at the price of measuring `F` only on the block's own window. -/

/-- The pointwise covering bound behind the maximal estimate. -/
theorem iSup_enorm_translate_rpow_le_sum {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q) (r : ℝ) :
    (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q ≤ ∑ a ∈ ι, brsWindowMax F F' a δ r ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hcover : (⨆ t ∈ E, ‖F (t - r)‖ₑ) ≤
      ⨆ a ∈ ι, brsWindowMax F F' a δ r := by
    refine iSup₂_le fun t ht => ?_
    obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hcov ht)
    refine le_trans ?_ (le_iSup₂ (f := fun a (_ : a ∈ ι) =>
      brsWindowMax F F' a δ r) a ha)
    refine le_trans ?_ (iSup_enorm_translate_le_brsWindowMax hF hF' hderiv hδ r)
    exact le_iSup₂ (f := fun t (_ : t ∈ Icc (a - δ / 2) (a + δ / 2)) =>
      ‖F (t - r)‖ₑ) t hmem
  refine le_trans (ENNReal.rpow_le_rpow hcover hq0.le) ?_
  exact iSup_rpow_le_sum hq0 ι (fun a => brsWindowMax F F' a δ r)

/-- **The maximal estimate with a two-level cover.** -/
theorem lintegral_iSup_enorm_translate_rpow_le_local {E : Set ℝ} {δ : ℝ}
    (hδ : 0 < δ) {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) {F F' : ℝ → ℂ}
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x) {q : ℝ} (hq : 1 ≤ q)
    {V : Set ℝ} (hV : MeasurableSet V) {M Nloc : ℕ} {bl : ℝ → ℕ}
    (hbl : ∀ a ∈ ι, bl a ∈ Finset.range M)
    (hfib : ∀ i : ℕ, (ι.filter fun a => bl a = i).card ≤ Nloc)
    {A : ℕ → Set ℝ} (hA : ∀ i : ℕ, MeasurableSet (A i))
    (hVA : ∀ a ∈ ι, ∀ s ∈ Icc (a - δ / 2) (a + δ / 2), ∀ r ∈ V,
      s - r ∈ A (bl a)) :
    (∫⁻ r in V, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q) ≤
      (Nloc : ENNReal) * ∑ i ∈ Finset.range M,
        ((∫⁻ z in A i, ‖F z‖ₑ ^ q) ^ (1 / q) +
          ENNReal.ofReal δ * (∫⁻ z in A i, ‖F' z‖ₑ ^ q) ^ (1 / q)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set S : ℕ → ENNReal := fun i =>
    (∫⁻ z in A i, ‖F z‖ₑ ^ q) ^ (1 / q) +
      ENNReal.ofReal δ * (∫⁻ z in A i, ‖F' z‖ₑ ^ q) ^ (1 / q) with hS
  have hmeas : ∀ a ∈ ι, AEMeasurable
      (fun r : ℝ => brsWindowMax F F' a δ r ^ q) (volume.restrict V) :=
    fun a _ => ((measurable_brsWindowMax hF.measurable hF'.measurable a
      δ).pow_const q).aemeasurable
  have hterm : ∀ a ∈ ι, (∫⁻ r in V, brsWindowMax F F' a δ r ^ q) ≤
      S (bl a) ^ q := by
    intro a ha
    have h := lintegral_brsWindowMax_rpow_le_local hF.measurable hF'.measurable
      hδ hq hV (hA (bl a)) (hVA a ha)
    have h2 := ENNReal.rpow_le_rpow h hq0.le
    rw [← ENNReal.rpow_mul, show (1 : ℝ) / q * q = 1 by field_simp,
      ENNReal.rpow_one] at h2
    exact h2
  have hfiber : (∑ a ∈ ι, S (bl a) ^ q) ≤
      (Nloc : ENNReal) * ∑ i ∈ Finset.range M, S i ^ q := by
    rw [← Finset.sum_fiberwise_of_maps_to hbl (fun a => S (bl a) ^ q),
      Finset.mul_sum]
    refine Finset.sum_le_sum fun i _ => ?_
    have hcongr : ∀ a ∈ ι.filter fun a => bl a = i, S (bl a) ^ q = S i ^ q := by
      intro a ha
      rw [(Finset.mem_filter.mp ha).2]
    rw [Finset.sum_congr rfl hcongr, Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul' (by exact_mod_cast hfib i) le_rfl
  calc (∫⁻ r in V, (⨆ t ∈ E, ‖F (t - r)‖ₑ) ^ q)
      ≤ ∫⁻ r in V, ∑ a ∈ ι, brsWindowMax F F' a δ r ^ q :=
        lintegral_mono (fun r =>
          iSup_enorm_translate_rpow_le_sum hδ hcov hF hF' hderiv hq r)
    _ = ∑ a ∈ ι, ∫⁻ r in V, brsWindowMax F F' a δ r ^ q :=
        lintegral_finsetSum' ι hmeas
    _ ≤ ∑ a ∈ ι, S (bl a) ^ q := Finset.sum_le_sum hterm
    _ ≤ (Nloc : ENNReal) * ∑ i ∈ Finset.range M, S i ^ q := hfiber

/-! ## The reflected convolution on a window

`brsRefl (K ⋆ ǧ) z = ∫ K y · g (z + y) dy`, so on a set `A` it only sees `g`
on `A` thickened by the support radius of `K`. -/

theorem setLIntegral_comp_neg (A : Set ℝ) (f : ℝ → ENNReal) :
    (∫⁻ z in A, f (-z)) = ∫⁻ u in (fun x : ℝ => -x) ⁻¹' A, f u := by
  have hmp : MeasurePreserving (fun x : ℝ => -x) volume volume :=
    Measure.measurePreserving_neg volume
  have hemb : MeasurableEmbedding (fun x : ℝ => -x) :=
    (Homeomorph.neg ℝ).measurableEmbedding
  have h := hmp.setLIntegral_comp_preimage_emb hemb f ((fun x : ℝ => -x) ⁻¹' A)
  rw [show (fun x : ℝ => -x) ⁻¹' ((fun x : ℝ => -x) ⁻¹' A) = A from by
    ext z
    simp] at h
  exact h

/-- **Young's inequality for the reflected convolution, localized.** -/
theorem lintegral_reflconv_rpow_le_young_local {p q r : ℝ} (hp : 1 ≤ p)
    (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) {K : ℝ → ℝ} (hK : Measurable K)
    {g : ℝ → ℂ} (hg : Measurable g) {L : ℝ} (hL : ∀ y : ℝ, L < |y| → K y = 0)
    {A W : Set ℝ} (hA : MeasurableSet A) (hW : MeasurableSet W)
    (hAW : ∀ z ∈ A, ∀ y : ℝ, |y| ≤ L → z + y ∈ W) :
    (∫⁻ z in A, ‖brsRefl (fun w : ℝ => ∫ y : ℝ,
        (K y : ℂ) * brsRefl g (w - y)) z‖ₑ ^ q) ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ ^ r) ^ (q / r) *
        (∫⁻ z in W, ‖g z‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hgr : Measurable (brsRefl g) := hg.comp measurable_neg
  have hAneg : MeasurableSet ((fun x : ℝ => -x) ⁻¹' A) := measurable_neg hA
  have hWneg : MeasurableSet ((fun x : ℝ => -x) ⁻¹' W) := measurable_neg hW
  have hstep : (∫⁻ z in A, ‖brsRefl (fun w : ℝ => ∫ y : ℝ,
      (K y : ℂ) * brsRefl g (w - y)) z‖ₑ ^ q) =
      ∫⁻ u in (fun x : ℝ => -x) ⁻¹' A,
        ‖∫ y : ℝ, (K y : ℂ) * brsRefl g (u - y)‖ₑ ^ q :=
    setLIntegral_comp_neg A
      (fun u : ℝ => ‖∫ y : ℝ, (K y : ℂ) * brsRefl g (u - y)‖ₑ ^ q)
  have hVW : ∀ u ∈ (fun x : ℝ => -x) ⁻¹' A, ∀ y : ℝ, |y| ≤ L →
      u - y ∈ (fun x : ℝ => -x) ⁻¹' W := by
    intro u hu y hy
    have hz : -u ∈ A := hu
    have hmem := hAW (-u) hz y hy
    change -(u - y) ∈ W
    have heq : -(u - y) = -u + y := by ring
    rwa [heq]
  have hgW : (∫⁻ z in (fun x : ℝ => -x) ⁻¹' W, ‖brsRefl g z‖ₑ ^ p) =
      ∫⁻ z in W, ‖g z‖ₑ ^ p := by
    have h := setLIntegral_comp_neg ((fun x : ℝ => -x) ⁻¹' W)
      (fun u : ℝ => ‖g u‖ₑ ^ p)
    rw [show (fun x : ℝ => -x) ⁻¹' ((fun x : ℝ => -x) ⁻¹' W) = W from by
      ext z
      simp] at h
    exact h
  rw [hstep]
  refine le_trans (lintegral_convolution_rpow_le_young_local hp hr hrq hpq hrel
    hK hgr hL hAneg hWneg hVW) ?_
  rw [hgW]

/-! ## The near maximal function, localized

The two-level cover and the localized Young inequality combine into the
localized form of `lintegral_brsNearFullMax_rpow_le`: the global count `#ι`
becomes the largest count in one block, and the `L^p` norm of `g` becomes its
norm on that block's own window. -/

theorem lintegral_brsNearFullMax_rpow_le_local {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (k : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    {L : ℝ} (hL : ∀ y : ℝ, L < |y| → brsTruncConvReal k υ y = 0)
    (hL' : ∀ y : ℝ, L < |y| → brsTruncConvReal k (deriv υ) y = 0)
    {V : Set ℝ} (hV : MeasurableSet V) {M Nloc : ℕ} {bl : ℝ → ℕ}
    (hbl : ∀ a ∈ ι, bl a ∈ Finset.range M)
    (hfib : ∀ i : ℕ, (ι.filter fun a => bl a = i).card ≤ Nloc)
    {A W : ℕ → Set ℝ} (hA : ∀ i : ℕ, MeasurableSet (A i))
    (hW : ∀ i : ℕ, MeasurableSet (W i))
    (hVA : ∀ a ∈ ι, ∀ s ∈ Icc (a - δ / 2) (a + δ / 2), ∀ x ∈ V,
      s - x ∈ A (bl a))
    (hAW : ∀ i : ℕ, ∀ z ∈ A i, ∀ y : ℝ, |y| ≤ L → z + y ∈ W i) :
    (∫⁻ x in V, brsNearFullMax k υ g E x ^ q) ≤
      (Nloc : ENNReal) * ∑ i ∈ Finset.range M,
        ((∫⁻ y : ℝ, ‖brsTruncConvReal k υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hq1 : (1 : ℝ) < q := lt_trans hr hrq
  have hq0 : (0 : ℝ) < q := lt_trans zero_lt_one hq1
  have hgr : Continuous (brsRefl g) := continuous_brsRefl hg
  set K : ℝ → ℝ := brsTruncConvReal k υ with hKdef
  set K' : ℝ → ℝ := brsTruncConvReal k (deriv υ) with hK'def
  have hKcs : HasCompactSupport K := hasCompactSupport_brsTruncConvReal k hcs
  have hKcd : ContDiff ℝ 1 K := contDiff_brsTruncConvReal k (n := 1) hυ hcs
  have hK'cs : HasCompactSupport K' := hasCompactSupport_brsTruncConvReal k hcs'
  have hK'cd : ContDiff ℝ 1 K' :=
    contDiff_brsTruncConvReal k (n := 1) hυ' hcs'
  have hKm : Measurable K := hKcd.continuous.measurable
  have hK'm : Measurable K' := hK'cd.continuous.measurable
  have hderivK : deriv K = K' := by
    funext x
    exact (hasDerivAt_brsTruncConvReal k hcs hυ x).deriv
  set F : ℝ → ℂ := fun x => ∫ y : ℝ, (K y : ℂ) * brsRefl g (x - y) with hFdef
  set F' : ℝ → ℂ := fun x => ∫ y : ℝ, (K' y : ℂ) * brsRefl g (x - y) with hF'def
  have hderiv : ∀ x : ℝ, HasDerivAt F (F' x) x := by
    intro x
    have h := hasDerivAt_kernel_convolution hKcs hKcd hgr x
    rw [hderivK] at h
    exact h
  have hFdiff : Differentiable ℝ F := fun x => (hderiv x).differentiableAt
  have hFcont : Continuous F := hFdiff.continuous
  have hF'cont : Continuous F' := by
    have hd2 : ∀ x : ℝ, HasDerivAt F'
        (∫ y : ℝ, ((deriv K' y : ℝ) : ℂ) * brsRefl g (x - y)) x := fun x =>
      hasDerivAt_kernel_convolution hK'cs hK'cd hgr x
    have hF'diff : Differentiable ℝ F' := fun x => (hd2 x).differentiableAt
    exact hF'diff.continuous
  -- the reflected pair
  have hReflCont : Continuous (brsRefl F) := continuous_brsRefl hFcont
  have hReflDeriv : Continuous fun z : ℝ => -(F' (-z)) :=
    (hF'cont.comp continuous_neg).neg
  have hd : ∀ z : ℝ, HasDerivAt (brsRefl F) (-(F' (-z))) z := fun z =>
    hasDerivAt_comp_neg hderiv z
  have hmain := lintegral_iSup_enorm_translate_rpow_le_local hδ hcov hReflCont
    hReflDeriv hd hq1.le hV hbl hfib hA hVA
  refine le_trans hmain ?_
  refine mul_le_mul' le_rfl (Finset.sum_le_sum fun i _ => ?_)
  refine ENNReal.rpow_le_rpow (add_le_add ?_ (mul_le_mul' le_rfl ?_)) hq0.le
  · have h := lintegral_reflconv_rpow_le_young_local hp hr hrq hpq hrel hKm
      hg.measurable hL (hA i) (hW i) (hAW i)
    refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
    exact young_rpow_inv hp0 hq0 hr0
  · have heq : (∫⁻ z in A i, ‖-(F' (-z))‖ₑ ^ q) =
        ∫⁻ z in A i, ‖brsRefl F' z‖ₑ ^ q := by
      refine lintegral_congr fun z => ?_
      rw [enorm_neg]
      rfl
    rw [heq]
    have h := lintegral_reflconv_rpow_le_young_local hp hr hrq hpq hrel hK'm
      hg.measurable hL' (hA i) (hW i) (hAW i)
    refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
    exact young_rpow_inv hp0 hq0 hr0

/-! ## The radial weight, keeping the window

The localized covering estimate needs the radius to stay inside the window, so
the weight is extracted without discarding the restriction. -/

theorem lintegral_window_weight_rpow_le_local (k : ℕ) (S : ℝ → ENNReal) {q : ℝ}
    (hq : 0 < q) :
    (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)) *
        ∫⁻ r in brsWindowExt k, S r ^ q := by
  set C : ℝ := (2 : ℝ) ^ |1 - q / 2| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 - q / 2)
    with hC
  have hpt : ∀ r : ℝ, ((brsWindowExt k).indicator
      (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
        ENNReal.ofReal r ≤
      (brsWindowExt k).indicator (fun r => ENNReal.ofReal C * S r ^ q) r := by
    intro r
    by_cases hr : r ∈ brsWindowExt k
    · have hrpos : 0 < r := brsWindowExt_pos hr
      have hval : ((brsWindowExt k).indicator
          (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
            ENNReal.ofReal r = ENNReal.ofReal (r ^ (1 - q / 2)) * S r ^ q := by
        rw [Set.indicator_of_mem hr]
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hrpos _),
          ← Real.rpow_mul hrpos.le]
        rw [mul_comm (ENNReal.ofReal (r ^ (-(1 / 2) * q))) (S r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r ^ (1 - q / 2))) (S r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hrpos.le _)]
        congr 1
        calc r ^ (-(1 / 2) * q) * r = r ^ (-(1 / 2) * q) * r ^ (1 : ℝ) := by
              rw [Real.rpow_one]
          _ = r ^ (-(1 / 2) * q + 1) := (Real.rpow_add hrpos _ _).symm
          _ = r ^ (1 - q / 2) := by
              congr 1
              ring
      rw [hval, Set.indicator_of_mem hr]
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (rpow_le_of_mem_brsWindowExt hr (1 - q / 2))) le_rfl
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((brsWindowExt k).indicator
        (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) * S r) r) ^ q *
          ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ,
          (brsWindowExt k).indicator (fun r => ENNReal.ofReal C * S r ^ q) r :=
        lintegral_mono hpt
    _ = ∫⁻ r in brsWindowExt k, ENNReal.ofReal C * S r ^ q :=
        lintegral_indicator (measurableSet_brsWindowExt k) _
    _ = ENNReal.ofReal C * ∫⁻ r in brsWindowExt k, S r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- **The weighted maximal estimate for one piece, localized.** -/
theorem lintegral_brsNearMax_rpow_le_local {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (kw kt : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    {L : ℝ} (hL : ∀ y : ℝ, L < |y| → brsTruncConvReal kt υ y = 0)
    (hL' : ∀ y : ℝ, L < |y| → brsTruncConvReal kt (deriv υ) y = 0)
    {M Nloc : ℕ} {bl : ℝ → ℕ} (hbl : ∀ a ∈ ι, bl a ∈ Finset.range M)
    (hfib : ∀ i : ℕ, (ι.filter fun a => bl a = i).card ≤ Nloc)
    {A W : ℕ → Set ℝ} (hA : ∀ i : ℕ, MeasurableSet (A i))
    (hW : ∀ i : ℕ, MeasurableSet (W i))
    (hVA : ∀ a ∈ ι, ∀ s ∈ Icc (a - δ / 2) (a + δ / 2),
      ∀ x ∈ brsWindowExt kw, s - x ∈ A (bl a))
    (hAW : ∀ i : ℕ, ∀ z ∈ A i, ∀ y : ℝ, |y| ≤ L → z + y ∈ W i) :
    (∫⁻ x : ℝ, brsNearMax kw kt υ g E x ^ q * ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((Nloc : ENNReal) * ∑ i ∈ Finset.range M,
          ((∫⁻ y : ℝ, ‖brsTruncConvReal kt υ y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p) +
              ENNReal.ofReal δ *
                ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                  (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p))) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  refine le_trans (lintegral_window_weight_rpow_le_local kw _ hq0) ?_
  exact mul_le_mul' le_rfl
    (lintegral_brsNearFullMax_rpow_le_local hδ hcov kt hcs hυ hcs' hυ' hg hp hr
      hrq hpq hrel hL hL' (measurableSet_brsWindowExt kw) hbl hfib hA hW hVA hAW)

/-! ## (5.9) for one piece, localized -/

/-- `ℓ^1 ↪ ℓ^t` for `t ≥ 1`, over a finite index set. -/
theorem finset_sum_rpow_le_rpow_sum {α : Type*} (s : Finset α) (a : α → ENNReal)
    {t : ℝ} (ht : 1 ≤ t) : (∑ i ∈ s, a i ^ t) ≤ (∑ i ∈ s, a i) ^ t := by
  classical
  have ht0 : (0 : ℝ) < t := lt_of_lt_of_le zero_lt_one ht
  refine Finset.induction_on s ?_ ?_
  · simp [ENNReal.zero_rpow_of_pos ht0]
  · intro x s hx ih
    rw [Finset.sum_insert hx, Finset.sum_insert hx]
    exact le_trans (add_le_add le_rfl ih) (ENNReal.add_rpow_le_rpow_add _ _ ht)

/-- **(5.9) for one piece of the resolution, with a two-level cover.** -/
theorem brs_5_9_near_local {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ)))
    {M Nloc : ℕ} {bl : ℝ → ℕ} (hbl : ∀ a ∈ ι, bl a ∈ Finset.range M)
    (hfib : ∀ i : ℕ, (ι.filter fun a => bl a = i).card ≤ Nloc)
    {Aset W : ℕ → Set ℝ} (hAm : ∀ i : ℕ, MeasurableSet (Aset i))
    (hWm : ∀ i : ℕ, MeasurableSet (W i))
    (hVA : ∀ a ∈ ι, ∀ s ∈ Icc (a - (2 : ℝ) ^ (-(j : ℝ)) / 2)
        (a + (2 : ℝ) ^ (-(j : ℝ)) / 2),
      ∀ x ∈ brsWindowExt kw, s - x ∈ Aset (bl a))
    (hAW : ∀ i : ℕ, ∀ z ∈ Aset i, ∀ y : ℝ,
      |y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) → z + y ∈ W i) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q *
        ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((Nloc : ENNReal) * ∑ i ∈ Finset.range M,
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hcsD : HasCompactSupport (brsDilate υ j) :=
    hasCompactSupport_brsDilate hcs j
  have hυD : ContDiff ℝ 1 (brsDilate υ j) := contDiff_brsDilate hυ j
  have hderivD : deriv (brsDilate υ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) j := deriv_brsDilate_eq hυ j
  have hcs2 : HasCompactSupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    hasCompactSupport_const_mul (ne_of_gt h2j) hcs'
  have hυ2 : ContDiff ℝ 1 (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) :=
    contDiff_const.mul hυ'
  have hcsD' : HasCompactSupport (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact hasCompactSupport_brsDilate hcs2 j
  have hυD' : ContDiff ℝ 1 (deriv (brsDilate υ j)) := by
    rw [hderivD]
    exact contDiff_brsDilate hυ2 j
  have hR2 : tsupport (fun x : ℝ => (2 : ℝ) ^ j * deriv υ x) ⊆
      Metric.closedBall 0 1 := by
    refine subset_trans (closure_mono ?_) hR'
    intro x hx hc
    exact hx (show (2 : ℝ) ^ j * deriv υ x = 0 by rw [hc, mul_zero])
  have hL : ∀ y : ℝ,
      (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) < |y| →
      brsTruncConvReal kt (brsDilate υ j) y = 0 := fun y hy =>
    brsTruncConvReal_dilate_eq_zero hR hy
  have hL' : ∀ y : ℝ,
      (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) < |y| →
      brsTruncConvReal kt (deriv (brsDilate υ j)) y = 0 := by
    intro y hy
    rw [hderivD]
    exact brsTruncConvReal_dilate_eq_zero hR2 hy
  refine le_trans (lintegral_brsNearMax_rpow_le_local hδ hcov kw kt hcsD hυD
    hcsD' hυD' hg hp hr hrq hpq hrel hL hL' hbl hfib hAm hWm hVA hAW) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl (Finset.sum_le_sum fun i _ => ?_))
  refine ENNReal.rpow_le_rpow ?_ hq0.le
  exact brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
    hmom' hr hkj _

/-! ## Bookkeeping for the two-level cover

Assembling per-block covers into a single cover with a block-index function,
and the finite-overlap count for a family of equally spaced intervals. -/

/-- The union of per-block covers carries a block index. -/
theorem exists_blockIndex (M : ℕ) (ιf : ℕ → Finset ℝ) :
    ∃ bl : ℝ → ℕ, ∀ a ∈ (Finset.range M).biUnion ιf,
      bl a ∈ Finset.range M ∧ a ∈ ιf (bl a) := by
  classical
  refine ⟨fun a => if h : ∃ i, i < M ∧ a ∈ ιf i then Nat.find h else 0, ?_⟩
  intro a ha
  obtain ⟨i, hi, hai⟩ := Finset.mem_biUnion.mp ha
  have hex : ∃ i, i < M ∧ a ∈ ιf i := ⟨i, Finset.mem_range.mp hi, hai⟩
  have hval : (if h : ∃ i, i < M ∧ a ∈ ιf i then Nat.find h else 0) =
      Nat.find hex := dif_pos hex
  constructor
  · change (if h : ∃ i, i < M ∧ a ∈ ιf i then Nat.find h else 0) ∈
      Finset.range M
    rw [hval]
    exact Finset.mem_range.mpr (Nat.find_spec hex).1
  · change a ∈ ιf (if h : ∃ i, i < M ∧ a ∈ ιf i then Nat.find h else 0)
    rw [hval]
    exact (Nat.find_spec hex).2

/-- Each fibre of the block index sits inside that block's own cover. -/
theorem card_filter_blockIndex_le {M : ℕ} {ιf : ℕ → Finset ℝ} {bl : ℝ → ℕ}
    (hbl : ∀ a ∈ (Finset.range M).biUnion ιf,
      bl a ∈ Finset.range M ∧ a ∈ ιf (bl a)) (i : ℕ) :
    (((Finset.range M).biUnion ιf).filter fun a => bl a = i).card ≤
      (ιf i).card := by
  classical
  refine Finset.card_le_card fun a ha => ?_
  obtain ⟨ha1, ha2⟩ := Finset.mem_filter.mp ha
  have hmem := (hbl a ha1).2
  rwa [ha2] at hmem

/-- A finite set of naturals whose elements are pairwise within `D` has at
most `D + 1` elements. -/
theorem card_le_of_pairwise_close {s : Finset ℕ} {D : ℕ}
    (h : ∀ i ∈ s, ∀ i' ∈ s, i ≤ i' + D) : s.card ≤ D + 1 := by
  classical
  rcases s.eq_empty_or_nonempty with rfl | hne
  · simp
  · obtain ⟨m, hm, hmin⟩ := s.exists_min_image id hne
    have hsub : s ⊆ Finset.Icc m (m + D) := by
      intro i hi
      exact Finset.mem_Icc.mpr ⟨hmin i hi, h i hi m hm⟩
    refine le_trans (Finset.card_le_card hsub) ?_
    rw [Nat.card_Icc]
    omega

/-! ## The block windows of the two-level cover

At radius scale `2^{-kw}` the blocks of dilations have length `2^{-kw}`, and
the piece of `g` each block can see is the block widened by a fixed multiple of
that length.  Those widened windows overlap at most nine times. -/

/-- The `g`-window of the `i`-th block at radius scale `2^{-kw}`. -/
def brsBlockWindow (kw i : ℕ) : Set ℝ :=
  Icc (1 + (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) - 4 * (2 : ℝ) ^ (-(kw : ℝ)))
    (1 + (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) + 4 * (2 : ℝ) ^ (-(kw : ℝ)))

theorem measurableSet_brsBlockWindow (kw i : ℕ) :
    MeasurableSet (brsBlockWindow kw i) := measurableSet_Icc

open Classical in
/-- **The block windows overlap at most nine times.** -/
theorem card_filter_brsBlockWindow_le (kw M : ℕ) (x : ℝ) :
    ((Finset.range M).filter fun i => x ∈ brsBlockWindow kw i).card ≤ 9 := by
  classical
  have hΔ : (0 : ℝ) < (2 : ℝ) ^ (-(kw : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine card_le_of_pairwise_close (D := 8) fun i hi i' hi' => ?_
  have hmi : x ∈ brsBlockWindow kw i := (Finset.mem_filter.mp hi).2
  have hmi' : x ∈ brsBlockWindow kw i' := (Finset.mem_filter.mp hi').2
  rw [brsBlockWindow, Set.mem_Icc] at hmi hmi'
  have hstep : (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) ≤
      (i' : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) + 8 * (2 : ℝ) ^ (-(kw : ℝ)) := by
    have h1 := hmi.1
    have h2 := hmi'.2
    linarith
  have hcast : (i : ℝ) ≤ (i' : ℝ) + 8 := by
    have hmul : ((i : ℝ) - ((i' : ℝ) + 8)) * (2 : ℝ) ^ (-(kw : ℝ)) ≤ 0 := by
      nlinarith
    nlinarith
  exact_mod_cast hcast

/-- **Finite overlap of the block windows.** -/
theorem sum_setLIntegral_brsBlockWindow_le (kw M : ℕ) {f : ℝ → ENNReal}
    (hf : Measurable f) :
    (∑ i ∈ Finset.range M, ∫⁻ x in brsBlockWindow kw i, f x) ≤
      9 * ∫⁻ x : ℝ, f x := by
  classical
  have hstep : ∀ i : ℕ, (∫⁻ x in brsBlockWindow kw i, f x) =
      ∫⁻ x : ℝ, (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x *
        f x := by
    intro i
    rw [← lintegral_indicator (measurableSet_brsBlockWindow kw i)]
    refine lintegral_congr fun x => ?_
    by_cases hx : x ∈ brsBlockWindow kw i
    · rw [Set.indicator_of_mem hx, Set.indicator_of_mem hx, one_mul]
    · rw [Set.indicator_of_notMem hx, Set.indicator_of_notMem hx, zero_mul]
  have hmeas : ∀ i ∈ Finset.range M, Measurable
      (fun x : ℝ => (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x *
        f x) := fun i _ =>
    ((measurable_const : Measurable fun _ : ℝ => (1 : ENNReal)).indicator
      (measurableSet_brsBlockWindow kw i)).mul hf
  have hswap : (∑ i ∈ Finset.range M, ∫⁻ x : ℝ,
      (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x * f x) =
      ∫⁻ x : ℝ, ∑ i ∈ Finset.range M,
        (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x * f x :=
    (lintegral_finsetSum (Finset.range M) hmeas).symm
  have hpt : ∀ x : ℝ, (∑ i ∈ Finset.range M,
      (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x * f x) ≤
      9 * f x := by
    intro x
    have hcount : (∑ i ∈ Finset.range M,
        (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x) ≤ 9 := by
      have heq : (∑ i ∈ Finset.range M,
          (brsBlockWindow kw i).indicator (fun _ => (1 : ENNReal)) x) =
          (((Finset.range M).filter fun i => x ∈ brsBlockWindow kw i).card :
            ENNReal) := by
        rw [← Finset.sum_boole]
        refine Finset.sum_congr rfl fun i _ => ?_
        by_cases hx : x ∈ brsBlockWindow kw i
        · rw [Set.indicator_of_mem hx, if_pos hx]
        · rw [Set.indicator_of_notMem hx, if_neg hx]
      rw [heq]
      exact_mod_cast card_filter_brsBlockWindow_le kw M x
    rw [← Finset.sum_mul]
    exact mul_le_mul' hcount le_rfl
  rw [Finset.sum_congr rfl (fun i _ => hstep i), hswap]
  refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
  exact lintegral_const_mul 9 hf

/-! ## The two-level cover

The dilation set is cut into blocks of the radius scale, each block is covered
at the fine scale, and the pieces are assembled into one cover carrying a block
index. -/

/-- The `i`-th block of dilations at radius scale `2^{-kw}`. -/
def brsDilBlock (kw i : ℕ) : Set ℝ :=
  Icc (1 + (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)))
    (1 + ((i : ℝ) + 1) * (2 : ℝ) ^ (-(kw : ℝ)))

theorem two_pow_mul_rpow_neg (kw : ℕ) :
    ((2 : ℝ) ^ kw) * (2 : ℝ) ^ (-(kw : ℝ)) = 1 := by
  rw [← Real.rpow_natCast (2 : ℝ) kw, ← Real.rpow_add (by norm_num : (0:ℝ) < 2)]
  norm_num

/-- Every point of `[1,2]` lies in one of the first `2^kw + 1` blocks. -/
theorem exists_brsDilBlock_mem {kw : ℕ} {t : ℝ} (ht : t ∈ Icc (1 : ℝ) 2) :
    ∃ i : ℕ, i ∈ Finset.range (2 ^ kw + 1) ∧ t ∈ brsDilBlock kw i := by
  have hΔ : (0 : ℝ) < (2 : ℝ) ^ (-(kw : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  set Δ : ℝ := (2 : ℝ) ^ (-(kw : ℝ)) with hΔdef
  set u : ℝ := (t - 1) / Δ with hu
  have hu0 : 0 ≤ u := by
    rw [hu]
    exact div_nonneg (by linarith [ht.1]) hΔ.le
  have hutop : u ≤ ((2 : ℝ) ^ kw) := by
    rw [hu, div_le_iff₀ hΔ, hΔdef, two_pow_mul_rpow_neg kw]
    linarith [ht.2]
  refine ⟨⌊u⌋₊, ?_, ?_⟩
  · refine Finset.mem_range.mpr ?_
    have h1 : (⌊u⌋₊ : ℝ) ≤ ((2 : ℝ) ^ kw) := le_trans (Nat.floor_le hu0) hutop
    have h2 : ⌊u⌋₊ ≤ 2 ^ kw := by
      have : ((⌊u⌋₊ : ℕ) : ℝ) ≤ ((2 ^ kw : ℕ) : ℝ) := by
        push_cast
        exact h1
      exact_mod_cast this
    omega
  · constructor
    · have h := Nat.floor_le hu0
      rw [hu, le_div_iff₀ hΔ] at h
      linarith
    · have h := Nat.lt_floor_add_one u
      rw [hu, div_lt_iff₀ hΔ] at h
      linarith

/-- **The two-level cover.** -/
theorem exists_twoLevelCover {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) (kw : ℕ) :
    ∃ ιf : ℕ → Finset ℝ,
      IsIntervalCover E δ ((Finset.range (2 ^ kw + 1)).biUnion ιf) ∧
      (∀ i : ℕ, (ιf i).card ≤
        intervalCoveringNumber (E ∩ brsDilBlock kw i) δ) ∧
      (∀ i : ℕ, ∀ a ∈ ιf i, ∃ e ∈ E ∩ brsDilBlock kw i, |e - a| ≤ δ / 2) := by
  classical
  have hsub : ∀ i : ℕ, E ∩ brsDilBlock kw i ⊆ Icc (1 : ℝ) 2 := fun i =>
    subset_trans Set.inter_subset_left hE
  choose ι hι hcard using fun i : ℕ =>
    exists_intervalCover_card_eq_intervalCoveringNumber (hsub i) hδ
  refine ⟨fun i => (ι i).filter fun a =>
    ∃ e ∈ E ∩ brsDilBlock kw i, |e - a| ≤ δ / 2, ?_, ?_, ?_⟩
  · intro t ht
    obtain ⟨i, hi, hti⟩ := exists_brsDilBlock_mem (kw := kw) (hE ht)
    obtain ⟨a, ha, hmem⟩ := Set.mem_iUnion₂.mp (hι i ⟨ht, hti⟩)
    obtain ⟨hl, hr⟩ := Set.mem_Icc.mp hmem
    have habs : |t - a| ≤ δ / 2 := by
      rw [abs_le]
      constructor <;> linarith
    refine Set.mem_iUnion₂.mpr ⟨a, ?_, hmem⟩
    refine Finset.mem_biUnion.mpr ⟨i, hi, ?_⟩
    exact Finset.mem_filter.mpr ⟨ha, ⟨t, ⟨ht, hti⟩, habs⟩⟩
  · intro i
    rw [← hcard i]
    exact Finset.card_filter_le _ _
  · intro i a ha
    exact (Finset.mem_filter.mp ha).2

/-! ## The lowest-frequency piece, localized -/

/-- **The kernel bracket of the lowest-frequency piece.** -/
theorem brs_5_9_low_bracket {kt j : ℕ} {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {r : ℝ} (hr : 1 < r) (hr2 : r < 2) (G : ENNReal) :
    (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ,
              ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) *
            G) ≤
      ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) * G := by
  have hr0 : (0 : ℝ) < r := lt_trans zero_lt_one hr
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : 0 ≤ brsLowConst kt r := brsLowConst_nonneg kt hr2
  have hCr : 0 ≤ brsLowConst kt r ^ (1 / r) := Real.rpow_nonneg hCnn _
  have hker : (∫⁻ y : ℝ,
      ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_dilate_le_L1 kt j hφ.continuous hcs hA
        hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst, Real.mul_rpow (Real.rpow_nonneg hAnn r) (by positivity),
      ← Real.rpow_mul hAnn, mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  have hker' : (∫⁻ y : ℝ,
      ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 kt j hφ
        hφ'.continuous hcs' hA' hr.le hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst,
      Real.mul_rpow (Real.rpow_nonneg (by positivity) r) (by positivity),
      ← Real.rpow_mul (by positivity), mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  calc (∫⁻ y : ℝ, ‖brsTruncConvReal kt (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ,
              ‖brsTruncConvReal kt (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) *
            G)
      ≤ ENNReal.ofReal (A * brsLowConst kt r ^ (1 / r)) * G +
          ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst kt r ^ (1 / r)) *
              G) :=
        add_le_add (mul_le_mul' hker le_rfl)
          (mul_le_mul' le_rfl (mul_le_mul' hker' le_rfl))
    _ = ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) * G := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← add_mul,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        rw [rpow_neg_natCast_two j]
        field_simp

/-- **(5.9) for the lowest-frequency piece, with a two-level cover.** -/
theorem brs_5_9_near_low_local {E : Set ℝ} {ι : Finset ℝ} {kw kt j : ℕ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-(j : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hR : tsupport φ ⊆ Metric.closedBall 0 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    (hR' : tsupport (deriv φ) ⊆ Metric.closedBall 0 1)
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2)
    {M Nloc : ℕ} {bl : ℝ → ℕ} (hbl : ∀ a ∈ ι, bl a ∈ Finset.range M)
    (hfib : ∀ i : ℕ, (ι.filter fun a => bl a = i).card ≤ Nloc)
    {Aset W : ℕ → Set ℝ} (hAm : ∀ i : ℕ, MeasurableSet (Aset i))
    (hWm : ∀ i : ℕ, MeasurableSet (W i))
    (hVA : ∀ a ∈ ι, ∀ s ∈ Icc (a - (2 : ℝ) ^ (-(j : ℝ)) / 2)
        (a + (2 : ℝ) ^ (-(j : ℝ)) / 2),
      ∀ x ∈ brsWindowExt kw, s - x ∈ Aset (bl a))
    (hAW : ∀ i : ℕ, ∀ z ∈ Aset i, ∀ y : ℝ,
      |y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) → z + y ∈ W i) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q *
        ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((Nloc : ENNReal) * ∑ i ∈ Finset.range M,
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r)) *
            (∫⁻ z in W i, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hdil : ContDiff ℝ 1 (brsDilate φ j) := contDiff_brsDilate hφ j
  have hdilcs : HasCompactSupport (brsDilate φ j) :=
    hasCompactSupport_brsDilate hcs j
  have hderiv : deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j := deriv_brsDilate_eq hφ j
  have hdercs : HasCompactSupport (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact hasCompactSupport_brsDilate hcs'.mul_left j
  have hdercd : ContDiff ℝ 1 (deriv (brsDilate φ j)) := by
    rw [hderiv]
    exact contDiff_brsDilate (contDiff_const.mul hφ') j
  have hR2 : tsupport (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) ⊆
      Metric.closedBall 0 1 := by
    refine subset_trans (closure_mono ?_) hR'
    intro x hx hc
    exact hx (show (2 : ℝ) ^ j * deriv φ x = 0 by rw [hc, mul_zero])
  have hL : ∀ y : ℝ,
      (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) < |y| →
      brsTruncConvReal kt (brsDilate φ j) y = 0 := fun y hy =>
    brsTruncConvReal_dilate_eq_zero hR hy
  have hL' : ∀ y : ℝ,
      (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) < |y| →
      brsTruncConvReal kt (deriv (brsDilate φ j)) y = 0 := by
    intro y hy
    rw [hderiv]
    exact brsTruncConvReal_dilate_eq_zero hR2 hy
  refine le_trans (lintegral_brsNearMax_rpow_le_local hδ hcov kw kt hdilcs hdil
    hdercs hdercd hg hp hr hrq hpq hrel hL hL' hbl hfib hAm hWm hVA hAW) ?_
  refine mul_le_mul' le_rfl (mul_le_mul' le_rfl (Finset.sum_le_sum fun i _ => ?_))
  refine ENNReal.rpow_le_rpow ?_ hq0.le
  exact brs_5_9_low_bracket hφ hcs hφ' hcs' hA hA' hr hr2 _

/-! ## The geometry of the two-level cover

At radius scale `2^{-kw}`, with the fine scale `2^{-j}` at least eight times
smaller and the truncation `2^{-kt}` at most half the radius scale, the window
seen by one block of dilations stays inside a fixed dilate of the block. -/

theorem brsWindowExt_le_two_mul (kw : ℕ) {x : ℝ} (hx : x ∈ brsWindowExt kw) :
    x ≤ 2 * (2 : ℝ) ^ (-(kw : ℝ)) := by
  cases kw with
  | zero =>
      have h : x ≤ 4 / 3 := hx.2
      have he : (2 : ℝ) ^ (-((0 : ℕ) : ℝ)) = 1 := by norm_num
      rw [he]
      linarith
  | succ k =>
      have h : x ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := hx.2
      have hpos : (0 : ℝ) < (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) :=
        Real.rpow_pos_of_pos (by norm_num) _
      linarith

/-- The set of arguments the `i`-th block can reach. -/
def brsBlockReach (kw i : ℕ) : Set ℝ :=
  Icc (1 + (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) - 3 * (2 : ℝ) ^ (-(kw : ℝ)))
    (1 + (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) + 3 * (2 : ℝ) ^ (-(kw : ℝ)))

theorem measurableSet_brsBlockReach (kw i : ℕ) :
    MeasurableSet (brsBlockReach kw i) := measurableSet_Icc

theorem rpow_neg_le_of_le {a b : ℕ} (hab : a ≤ b) :
    (2 : ℝ) ^ (-(b : ℝ)) ≤ (2 : ℝ) ^ (-(a : ℝ)) := by
  refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
  have : (a : ℝ) ≤ (b : ℝ) := by exact_mod_cast hab
  linarith

theorem rpow_neg_add_three (kw : ℕ) :
    (2 : ℝ) ^ (-((kw + 3 : ℕ) : ℝ)) = (2 : ℝ) ^ (-(kw : ℝ)) / 8 := by
  rw [show ((kw + 3 : ℕ) : ℝ) = (kw : ℝ) + 3 from by push_cast; ring,
    show -((kw : ℝ) + 3) = -(kw : ℝ) + -3 from by ring,
    Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  congr 1
  rw [show (-3 : ℝ) = ((-3 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
  norm_num

theorem rpow_neg_add_one (kw : ℕ) :
    (2 : ℝ) ^ (-((kw + 1 : ℕ) : ℝ)) = (2 : ℝ) ^ (-(kw : ℝ)) / 2 := by
  rw [show ((kw + 1 : ℕ) : ℝ) = (kw : ℝ) + 1 from by push_cast; ring,
    show -((kw : ℝ) + 1) = -(kw : ℝ) + -1 from by ring,
    Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  congr 1
  rw [Real.rpow_neg_one]

/-- Every argument reached from a cover point of the `i`-th block lies in
`brsBlockReach kw i`. -/
theorem mem_brsBlockReach {kw i j : ℕ} (hj : kw + 3 ≤ j) {a e s x : ℝ}
    (he : e ∈ brsDilBlock kw i)
    (hae : |e - a| ≤ (2 : ℝ) ^ (-(j : ℝ)) / 2)
    (hs : s ∈ Icc (a - (2 : ℝ) ^ (-(j : ℝ)) / 2) (a + (2 : ℝ) ^ (-(j : ℝ)) / 2))
    (hx : x ∈ brsWindowExt kw) : s - x ∈ brsBlockReach kw i := by
  have hΔ : (0 : ℝ) < (2 : ℝ) ^ (-(kw : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hδΔ : (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kw : ℝ)) / 8 := by
    rw [← rpow_neg_add_three kw]
    exact rpow_neg_le_of_le hj
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hx0 : 0 < x := brsWindowExt_pos hx
  have hx2 : x ≤ 2 * (2 : ℝ) ^ (-(kw : ℝ)) := brsWindowExt_le_two_mul kw hx
  obtain ⟨he1, he2⟩ := Set.mem_Icc.mp he
  obtain ⟨hs1, hs2⟩ := Set.mem_Icc.mp hs
  obtain ⟨hae1, hae2⟩ := abs_le.mp hae
  have hring : ((i : ℝ) + 1) * (2 : ℝ) ^ (-(kw : ℝ)) =
      (i : ℝ) * (2 : ℝ) ^ (-(kw : ℝ)) + (2 : ℝ) ^ (-(kw : ℝ)) := by ring
  rw [brsBlockReach]
  refine Set.mem_Icc.mpr ⟨by linarith, by linarith⟩

/-- Thickening `brsBlockReach` by the kernel radius stays inside the block
window. -/
theorem mem_brsBlockWindow {kw i j kt : ℕ} (hkt : kw + 1 ≤ kt)
    (hj : kw + 3 ≤ j) {z y : ℝ} (hz : z ∈ brsBlockReach kw i)
    (hy : |y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ))) :
    z + y ∈ brsBlockWindow kw i := by
  have hΔ : (0 : ℝ) < (2 : ℝ) ^ (-(kw : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkt' : (2 : ℝ) ^ (-(kt : ℝ)) ≤ (2 : ℝ) ^ (-(kw : ℝ)) / 2 := by
    rw [← rpow_neg_add_one kw]
    exact rpow_neg_le_of_le hkt
  have hδΔ : (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kw : ℝ)) / 8 := by
    rw [← rpow_neg_add_three kw]
    exact rpow_neg_le_of_le hj
  obtain ⟨hz1, hz2⟩ := Set.mem_Icc.mp hz
  obtain ⟨hy1, hy2⟩ := abs_le.mp hy
  rw [brsBlockWindow]
  refine Set.mem_Icc.mpr ⟨by linarith, by linarith⟩

/-! ## (5.9) with the localized covering number

Assembling the two-level cover, the block geometry and the `ℓ^p ↪ ℓ^q` step:
the global count `N(E, 2^{-j})` is replaced by the largest count in a single
block of length `2^{-kw}`, at the cost of a fixed overlap constant. -/

/-- The block sum collapses by `ℓ^p ↪ ℓ^q` and finite overlap. -/
theorem sum_blockWindow_rpow_le {kw M : ℕ} {g : ℝ → ℂ} (hg : Continuous g)
    {p q : ℝ} (hp : 0 < p) (hpq : p ≤ q) (C : ENNReal) :
    (∑ i ∈ Finset.range M,
      (C * (∫⁻ z in brsBlockWindow kw i, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q) ≤
      C ^ q * (9 * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (q / p) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le hp hpq
  have hqp : (1 : ℝ) ≤ q / p := by
    rw [le_div_iff₀ hp]
    linarith
  have hterm : ∀ i : ℕ,
      (C * (∫⁻ z in brsBlockWindow kw i, ‖g z‖ₑ ^ p) ^ (1 / p)) ^ q =
      C ^ q * (∫⁻ z in brsBlockWindow kw i, ‖g z‖ₑ ^ p) ^ (q / p) := by
    intro i
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
      show 1 / p * q = q / p from by ring]
  rw [Finset.sum_congr rfl (fun i _ => hterm i), ← Finset.mul_sum]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (finset_sum_rpow_le_rpow_sum (Finset.range M)
    (fun i => ∫⁻ z in brsBlockWindow kw i, ‖g z‖ₑ ^ p) hqp) ?_
  refine ENNReal.rpow_le_rpow ?_ (by positivity)
  exact sum_setLIntegral_brsBlockWindow_le kw M
    ((hg.measurable.enorm).pow_const p)

/-- **(5.9) for one piece, with the localized covering number.** -/
theorem brs_5_9_near_covering_local {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} (hkt : kw + 1 ≤ kt) (hj : kw + 3 ≤ j)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hkj : 5 * (2 : ℝ) ^ (-(j : ℝ)) ≤ (2 : ℝ) ^ (-(kt : ℝ)))
    {Nloc : ℕ} (hNloc : ∀ i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock kw i)
        ((2 : ℝ) ^ (-(j : ℝ))) ≤ Nloc) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate υ j) g E x ^ q *
        ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((Nloc : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-(j : ℝ))) ^ (1 / r - 1 / 2))) ^ q *
          (9 * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (q / p)) := by
  classical
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨ιf, hcov, hcard, hnear⟩ := exists_twoLevelCover hE hδ kw
  obtain ⟨bl, hbl⟩ := exists_blockIndex (2 ^ kw + 1) ιf
  have hblrange : ∀ a ∈ (Finset.range (2 ^ kw + 1)).biUnion ιf,
      bl a ∈ Finset.range (2 ^ kw + 1) := fun a ha => (hbl a ha).1
  have hfib : ∀ i : ℕ,
      (((Finset.range (2 ^ kw + 1)).biUnion ιf).filter fun a => bl a = i).card ≤
        Nloc := by
    intro i
    exact le_trans (card_filter_blockIndex_le hbl i)
      (le_trans (hcard i) (hNloc i))
  have hVA : ∀ a ∈ (Finset.range (2 ^ kw + 1)).biUnion ιf,
      ∀ s ∈ Icc (a - (2 : ℝ) ^ (-(j : ℝ)) / 2) (a + (2 : ℝ) ^ (-(j : ℝ)) / 2),
      ∀ x ∈ brsWindowExt kw, s - x ∈ brsBlockReach kw (bl a) := by
    intro a ha s hs x hx
    obtain ⟨e, he, hae⟩ := hnear (bl a) a (hbl a ha).2
    exact mem_brsBlockReach hj he.2 hae hs hx
  have hAW : ∀ i : ℕ, ∀ z ∈ brsBlockReach kw i, ∀ y : ℝ,
      |y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) →
      z + y ∈ brsBlockWindow kw i := fun i z hz y hy =>
    mem_brsBlockWindow hkt hj hz hy
  refine le_trans (brs_5_9_near_local hcov hυ hcs hR hυ' hcs' hR' hbd hA hAnn
    hbd' hA' hA'nn hmom hmom' hg hp hr hrq hpq hrel hkj hblrange hfib
    (fun i => measurableSet_brsBlockReach kw i)
    (fun i => measurableSet_brsBlockWindow kw i) hVA hAW) ?_
  refine mul_le_mul' le_rfl ?_
  rw [mul_assoc]
  exact mul_le_mul' le_rfl (sum_blockWindow_rpow_le hg hp0 hpq.le _)

/-! ## (5.9) for the lowest-frequency piece, with the localized covering
number -/

theorem brs_5_9_near_low_covering_local {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {kw kt j : ℕ} (hkt : kw + 1 ≤ kt) (hj : kw + 3 ≤ j)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hcs : HasCompactSupport φ)
    (hR : tsupport φ ⊆ Metric.closedBall 0 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hcs' : HasCompactSupport (deriv φ))
    (hR' : tsupport (deriv φ) ⊆ Metric.closedBall 0 1)
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {g : ℝ → ℂ} (hg : Continuous g) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q)
    (hr2 : r < 2)
    {Nloc : ℕ} (hNloc : ∀ i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock kw i)
        ((2 : ℝ) ^ (-(j : ℝ))) ≤ Nloc) :
    (∫⁻ x : ℝ, brsNearMax kw kt (brsDilate φ j) g E x ^ q *
        ENNReal.ofReal x) ≤
      ENNReal.ofReal ((2 : ℝ) ^ |1 - q / 2| *
          ((2 : ℝ) ^ (-(kw : ℝ))) ^ (1 - q / 2)) *
        ((Nloc : ENNReal) *
          (ENNReal.ofReal ((A + A') * brsLowConst kt r ^ (1 / r))) ^ q *
          (9 * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (q / p)) := by
  classical
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨ιf, hcov, hcard, hnear⟩ := exists_twoLevelCover hE hδ kw
  obtain ⟨bl, hbl⟩ := exists_blockIndex (2 ^ kw + 1) ιf
  have hblrange : ∀ a ∈ (Finset.range (2 ^ kw + 1)).biUnion ιf,
      bl a ∈ Finset.range (2 ^ kw + 1) := fun a ha => (hbl a ha).1
  have hfib : ∀ i : ℕ,
      (((Finset.range (2 ^ kw + 1)).biUnion ιf).filter fun a => bl a = i).card ≤
        Nloc := fun i =>
    le_trans (card_filter_blockIndex_le hbl i)
      (le_trans (hcard i) (hNloc i))
  have hVA : ∀ a ∈ (Finset.range (2 ^ kw + 1)).biUnion ιf,
      ∀ s ∈ Icc (a - (2 : ℝ) ^ (-(j : ℝ)) / 2) (a + (2 : ℝ) ^ (-(j : ℝ)) / 2),
      ∀ x ∈ brsWindowExt kw, s - x ∈ brsBlockReach kw (bl a) := by
    intro a ha s hs x hx
    obtain ⟨e, he, hae⟩ := hnear (bl a) a (hbl a ha).2
    exact mem_brsBlockReach hj he.2 hae hs hx
  have hAW : ∀ i : ℕ, ∀ z ∈ brsBlockReach kw i, ∀ y : ℝ,
      |y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) →
      z + y ∈ brsBlockWindow kw i := fun i z hz y hy =>
    mem_brsBlockWindow hkt hj hz hy
  refine le_trans (brs_5_9_near_low_local hcov hφ hcs hR hφ' hcs' hR' hA hA' hg
    hp hr hrq hpq hrel hr2 hblrange hfib
    (fun i => measurableSet_brsBlockReach kw i)
    (fun i => measurableSet_brsBlockWindow kw i) hVA hAW) ?_
  refine mul_le_mul' le_rfl ?_
  rw [mul_assoc]
  exact mul_le_mul' le_rfl (sum_blockWindow_rpow_le hg hp0 hpq.le _)

/-! ## The two sequence-space steps of BRS (5.10)

Summing the Littlewood--Paley pieces in `k` uses only two elementary facts:
`ℓ² ↪ ℓ^q` for `q ≥ 2`, and Minkowski's integral inequality with the counting
measure, which is the `ℓ^q`-valued Minkowski inequality. -/

/-- **`ℓ² ↪ ℓ^q` for `q ≥ 2`.** -/
theorem tsum_rpow_le_rpow_tsum_sq {a : ℕ → ENNReal} {q : ℝ} (hq : 2 ≤ q) :
    (∑' k : ℕ, a k ^ q) ≤ (∑' k : ℕ, a k ^ (2 : ℝ)) ^ (q / 2) := by
  have hq2 : (1 : ℝ) ≤ q / 2 := by linarith
  have h := tsum_rpow_le_rpow_tsum (a := fun k => a k ^ (2 : ℝ)) (s := q / 2) hq2
  have hterm : ∀ k : ℕ, (a k ^ (2 : ℝ)) ^ (q / 2) = a k ^ q := by
    intro k
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  rwa [tsum_congr hterm] at h

/-- **Minkowski's integral inequality against the counting measure**: the
`ℓ^r`-valued Minkowski inequality. -/
theorem tsum_lintegral_rpow_le_lintegral_tsum {f : ℕ → ℝ → ENNReal}
    (hf : ∀ k : ℕ, Measurable (f k)) {r : ℝ} (hr : 1 ≤ r)
    (hfin : (∑' k : ℕ, (∫⁻ x : ℝ, f k x) ^ r) ≠ ⊤) :
    (∑' k : ℕ, (∫⁻ x : ℝ, f k x) ^ r) ^ (1 / r) ≤
      ∫⁻ x : ℝ, (∑' k : ℕ, f k x ^ r) ^ (1 / r) := by
  have hFmeas : Measurable (Function.uncurry f) := by
    refine measurable_from_prod_countable_right fun k => ?_
    exact hf k
  have hleft : (∫⁻ k : ℕ, (∫⁻ x : ℝ, f k x) ^ r ∂Measure.count) =
      ∑' k : ℕ, (∫⁻ x : ℝ, f k x) ^ r := lintegral_count _
  have hright : (∫⁻ x : ℝ,
      (∫⁻ k : ℕ, f k x ^ r ∂Measure.count) ^ (1 / r)) =
      ∫⁻ x : ℝ, (∑' k : ℕ, f k x ^ r) ^ (1 / r) := by
    refine lintegral_congr fun x => ?_
    congr 1
    exact lintegral_count _
  have hfin' : (∫⁻ k : ℕ, (∫⁻ x : ℝ, f k x) ^ r ∂Measure.count) ≠ ⊤ := by
    rw [hleft]
    exact hfin
  have h := lintegral_rpow_lintegral_le (μ := (Measure.count : Measure ℕ))
    (ν := (volume : Measure ℝ)) hr hFmeas hfin'
  rwa [hleft, hright] at h

/-! ## The Rademacher bridge, for an arbitrary family

`Auto.LittlewoodPaley` proves the passage from uniform bounds on signed sums to
the square function, but the generic core of that passage is `private` there,
and widening its visibility would force a rebuild of everything downstream of
`LittlewoodPaley.lean`.  The generic statements are therefore restated here,
with the proofs of `Auto.LittlewoodPaley`. -/

theorem brs_rademacher_quartic_pair_upper (a x : Complex) :
    ‖-a + x‖ ^ (4 : Nat) + ‖a + x‖ ^ (4 : Nat) ≤
      2 * (‖x‖ ^ (4 : Nat) + 6 * ‖x‖ ^ (2 : Nat) * ‖a‖ ^ (2 : Nat) +
        ‖a‖ ^ (4 : Nat)) := by
  have hsq : (a * starRingEnd Complex x).re ^ (2 : Nat) ≤
      Complex.normSq a * Complex.normSq x := by
    calc
      (a * starRingEnd Complex x).re ^ (2 : Nat) ≤
          Complex.normSq (a * starRingEnd Complex x) := by
            simpa [pow_two] using Complex.re_sq_le_normSq (a * starRingEnd Complex x)
      _ = Complex.normSq a * Complex.normSq x := by
            rw [Complex.normSq_mul, Complex.normSq_conj]
  have hfour (z : Complex) : ‖z‖ ^ (4 : Nat) = (‖z‖ ^ (2 : Nat)) ^ (2 : Nat) := by
    ring
  rw [hfour, hfour, hfour, hfour]
  rw [show -a + x = x - a by ring, Complex.sq_norm, Complex.sq_norm,
    Complex.normSq_sub, Complex.normSq_add]
  have hre : (x * starRingEnd Complex a).re =
      (a * starRingEnd Complex x).re := by
    simp [Complex.mul_re]
    ring
  rw [hre]
  rw [Complex.sq_norm, Complex.sq_norm]
  nlinarith [Complex.normSq_nonneg a, Complex.normSq_nonneg x]

theorem brs_signed_sum_insert_absent {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (hu : u ⊆ s)
    (z : I → Complex) :
    _root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) u z =
      -z a + _root_.Auto.LittlewoodPaley.rademacherSignedSum s u z := by
  have hau : a ∉ u := fun hau => ha (hu hau)
  unfold _root_.Auto.LittlewoodPaley.rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [_root_.Auto.LittlewoodPaley.rademacherSign, hau, if_false, neg_one_mul]

theorem brs_signed_sum_insert_present {I : Type*} [DecidableEq I]
    {s u : Finset I} {a : I} (ha : a ∉ s) (z : I → Complex) :
    _root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) (insert a u) z =
      z a + _root_.Auto.LittlewoodPaley.rademacherSignedSum s u z := by
  unfold _root_.Auto.LittlewoodPaley.rademacherSignedSum
  rw [Finset.sum_insert ha]
  simp only [_root_.Auto.LittlewoodPaley.rademacherSign, Finset.mem_insert, true_or, if_true,
      one_mul]
  congr 1
  apply Finset.sum_congr rfl
  intro i hi
  have hia : i ≠ a := by
    intro h
    apply ha
    simpa [h] using hi
  simp [hia]

theorem brs_rademacher_fourth_moment_upper {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) :
    ∑ u ∈ s.powerset, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ (4 : Nat) ≤
      3 * (s.powerset.card : Real) *
        (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by
  classical
  induction s using Finset.induction_on with
  | empty => simp [_root_.Auto.LittlewoodPaley.rademacherSignedSum]
  | @insert a s ha ih =>
      rw [Finset.sum_powerset_insert ha]
      let X : Finset I → Complex := fun u => _root_.Auto.LittlewoodPaley.rademacherSignedSum s u z
      let S : Real := ∑ i ∈ s, ‖z i‖ ^ (2 : Nat)
      let A : Real := ‖z a‖ ^ (2 : Nat)
      have hminus (u : Finset I) (hu : u ∈ s.powerset) :
          _root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) u z = -z a + X u := by
        exact brs_signed_sum_insert_absent ha (Finset.mem_powerset.mp hu) z
      have hplus (u : Finset I) (hu : u ∈ s.powerset) :
          _root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) (insert a u) z = z a + X u :=
              by
        exact brs_signed_sum_insert_present ha z
      have hpair (u : Finset I) (hu : u ∈ s.powerset) :
          ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) u z‖ ^ (4 : Nat) +
              ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) (insert a u) z‖ ^
                  (4 : Nat) ≤
            2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
        rw [hminus u hu, hplus u hu]
        calc
          ‖-z a + X u‖ ^ (4 : Nat) + ‖z a + X u‖ ^ (4 : Nat) ≤
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * ‖z a‖ ^ (2 : Nat) +
                ‖z a‖ ^ (4 : Nat)) := brs_rademacher_quartic_pair_upper (z a) (X u)
          _ = 2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
            dsimp [A]
            ring
      have hpairsum :
          (∑ u ∈ s.powerset,
            (‖_root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) u z‖ ^ (4 : Nat) +
              ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum (insert a s) (insert a u) z‖ ^
                  (4 : Nat))) ≤
            ∑ u ∈ s.powerset,
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat)) := by
        apply Finset.sum_le_sum
        intro u hu
        exact hpair u hu
      have hXfour :
          (∑ u ∈ s.powerset, ‖X u‖ ^ (4 : Nat)) ≤
            3 * (s.powerset.card : Real) * S ^ (2 : Nat) := by
        simpa only [X, S] using ih
      have hXsecond :
          (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) =
            (s.powerset.card : Real) * S := by
        simpa only [X, S] using _root_.Auto.LittlewoodPaley.rademacherSecondMoment s z
      have hcard : 0 ≤ (s.powerset.card : Real) := Nat.cast_nonneg _
      have hS : 0 ≤ S := by
        dsimp [S]
        exact Finset.sum_nonneg fun i hi => sq_nonneg _
      have hA : 0 ≤ A := by
        dsimp [A]
        exact sq_nonneg _
      have hsum :
          (∑ u ∈ s.powerset,
              2 * (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat))) ≤
            6 * (s.powerset.card : Real) * S ^ (2 : Nat) +
              12 * (s.powerset.card : Real) * S * A +
                2 * (s.powerset.card : Real) * A ^ (2 : Nat) := by
        rw [← Finset.mul_sum]
        have hsplit :
            (∑ u ∈ s.powerset,
              (‖X u‖ ^ (4 : Nat) + 6 * ‖X u‖ ^ (2 : Nat) * A + A ^ (2 : Nat))) =
              (∑ u ∈ s.powerset, ‖X u‖ ^ (4 : Nat)) +
                6 * A * (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) +
                  (s.powerset.card : Real) * A ^ (2 : Nat) := by
          rw [Finset.sum_add_distrib, Finset.sum_add_distrib]
          have hmiddle :
              (∑ u ∈ s.powerset, 6 * ‖X u‖ ^ (2 : Nat) * A) =
                6 * A * (∑ u ∈ s.powerset, ‖X u‖ ^ (2 : Nat)) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro u hu
            ring
          rw [hmiddle, Finset.sum_const, nsmul_eq_mul]
        rw [hsplit, hXsecond]
        nlinarith [hXfour]
      have hcard_insert : ((insert a s).powerset.card : Real) =
          2 * (s.powerset.card : Real) := by
        simp only [Finset.card_powerset, Finset.card_insert_of_notMem ha,
          pow_succ, Nat.cast_mul, Nat.cast_ofNat]
        ring
      have hinsert_sum :
          (∑ i ∈ insert a s, ‖z i‖ ^ (2 : Nat)) = A + S := by
        simp only [Finset.sum_insert ha, A, S]
      have htarget :
          6 * (s.powerset.card : Real) * S ^ (2 : Nat) +
              12 * (s.powerset.card : Real) * S * A +
                2 * (s.powerset.card : Real) * A ^ (2 : Nat) ≤
            3 * ((insert a s).powerset.card : Real) *
              (∑ i ∈ insert a s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by
        rw [hcard_insert, hinsert_sum]
        nlinarith
      rw [← Finset.sum_add_distrib]
      exact hpairsum.trans (hsum.trans htarget)

/-- The finite Paley--Zygmund lower moment estimate for complex Rademacher
signs.  The numerical constant is deliberately crude but independent of the
cardinality of `s`. -/
theorem brs_rademacher_lower_moment {I : Type*} [DecidableEq I]
    (s : Finset I) (z : I → Complex) {p : Real} (hp : 0 ≤ p) :
    (s.powerset.card : Real) / 12 *
        ((∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) / 2) ^ (p / 2) ≤
      ∑ u ∈ s.powerset, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
  classical
  let X : Finset I → Real := fun u => ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^
      (2 : Nat)
  let S : Real := ∑ i ∈ s, ‖z i‖ ^ (2 : Nat)
  let n : Real := s.powerset.card
  let good : Finset (Finset I) := s.powerset.filter (fun u => S / 2 ≤ X u)
  let bad : Finset (Finset I) := s.powerset.filter (fun u => ¬ S / 2 ≤ X u)
  have hXnonneg (u : Finset I) : 0 ≤ X u := by
    dsimp [X]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have hn : 0 < n := by
    dsimp [n]
    positivity
  have hgoodsub : good ⊆ s.powerset := by
    dsimp [good]
    exact Finset.filter_subset _ _
  have hbadsub : bad ⊆ s.powerset := by
    dsimp [bad]
    exact Finset.filter_subset _ _
  have hbadbound : (∑ u ∈ bad, X u) ≤ n * (S / 2) := by
    calc
      (∑ u ∈ bad, X u) ≤ ∑ u ∈ bad, S / 2 := by
        apply Finset.sum_le_sum
        intro u hu
        have hbad : ¬ S / 2 ≤ X u := by
          exact (Finset.mem_filter.mp hu).2
        exact le_of_lt (lt_of_not_ge hbad)
      _ = (bad.card : Real) * (S / 2) := by
        rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ n * (S / 2) := by
        apply mul_le_mul_of_nonneg_right
        · dsimp [n]
          exact_mod_cast Finset.card_le_card hbadsub
        · positivity
  have htotal : (∑ u ∈ s.powerset, X u) = n * S := by
    simpa only [X, n, S] using _root_.Auto.LittlewoodPaley.rademacherSecondMoment s z
  have hsplit :
      (∑ u ∈ good, X u) + (∑ u ∈ bad, X u) =
        ∑ u ∈ s.powerset, X u := by
    dsimp [good, bad]
    rw [Finset.sum_filter_add_sum_filter_not]
  have hgoodsum : n * S / 2 ≤ ∑ u ∈ good, X u := by
    nlinarith [hbadbound, hsplit, htotal]
  have hfour :
      (∑ u ∈ s.powerset, X u ^ (2 : Nat)) ≤ 3 * n * S ^ (2 : Nat) := by
    dsimp [X, n, S]
    calc
      (∑ u ∈ s.powerset,
          (‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ (2 : Nat)) ^ (2 : Nat)) =
          ∑ u ∈ s.powerset, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ (4 : Nat) :=
              by
            apply Finset.sum_congr rfl
            intro u hu
            ring
      _ ≤ 3 * (s.powerset.card : Real) *
          (∑ i ∈ s, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) :=
            brs_rademacher_fourth_moment_upper s z
  have hgoodfour :
      (∑ u ∈ good, X u ^ (2 : Nat)) ≤ 3 * n * S ^ (2 : Nat) := by
    calc
      (∑ u ∈ good, X u ^ (2 : Nat)) ≤
          ∑ u ∈ s.powerset, X u ^ (2 : Nat) := by
            apply Finset.sum_le_sum_of_subset_of_nonneg hgoodsub
            intro u hu hnot
            positivity
      _ ≤ 3 * n * S ^ (2 : Nat) := hfour
  have hgoodcard : n / 12 ≤ (good.card : Real) := by
    by_cases hSzero : S = 0
    · have hgoodeq : good = s.powerset := by
        apply Finset.Subset.antisymm hgoodsub
        intro u hu
        dsimp only [good]
        apply Finset.mem_filter.mpr
        refine ⟨hu, ?_⟩
        simpa [hSzero] using hXnonneg u
      rw [hgoodeq]
      dsimp [n]
      have hnnonneg : (0 : Real) ≤ (s.powerset.card : Real) := Nat.cast_nonneg _
      nlinarith
    · have hSpos : 0 < S := lt_of_le_of_ne hS (Ne.symm hSzero)
      have hGnonneg : 0 ≤ ∑ u ∈ good, X u :=
        Finset.sum_nonneg fun u hu => hXnonneg u
      have hleftnonneg : 0 ≤ n * S / 2 := by positivity
      have hsquare : (n * S / 2) ^ (2 : Nat) ≤
          (∑ u ∈ good, X u) ^ (2 : Nat) :=
        (sq_le_sq₀ hleftnonneg hGnonneg).mpr hgoodsum
      have hcs := sq_sum_le_card_mul_sum_sq (s := good) (f := X)
      have hcs' : (∑ u ∈ good, X u) ^ (2 : Nat) ≤
          (good.card : Real) * (3 * n * S ^ (2 : Nat)) := by
        calc
          (∑ u ∈ good, X u) ^ (2 : Nat) ≤
              (good.card : Real) * ∑ u ∈ good, X u ^ (2 : Nat) := hcs
          _ ≤ (good.card : Real) * (3 * n * S ^ (2 : Nat)) := by
              exact mul_le_mul_of_nonneg_left hgoodfour (Nat.cast_nonneg _)
      have hfactor :
          (n * S ^ (2 : Nat)) * (n / 4) ≤
            (n * S ^ (2 : Nat)) * (3 * (good.card : Real)) := by
        calc
          (n * S ^ (2 : Nat)) * (n / 4) = (n * S / 2) ^ (2 : Nat) := by ring
          _ ≤ (∑ u ∈ good, X u) ^ (2 : Nat) := hsquare
          _ ≤ (good.card : Real) * (3 * n * S ^ (2 : Nat)) := hcs'
          _ = (n * S ^ (2 : Nat)) * (3 * (good.card : Real)) := by ring
      have hfactorpos : 0 < n * S ^ (2 : Nat) :=
        mul_pos hn (sq_pos_of_pos hSpos)
      have hlinear : n / 4 ≤ 3 * (good.card : Real) :=
        le_of_mul_le_mul_left hfactor hfactorpos
      nlinarith
  have hpoint (u : Finset I) (hu : u ∈ good) :
      (S / 2) ^ (p / 2) ≤ ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
    have hthreshold : S / 2 ≤ X u := (Finset.mem_filter.mp hu).2
    have hq : 0 ≤ p / 2 := by positivity
    have hpow := Real.rpow_le_rpow (by positivity : 0 ≤ S / 2) hthreshold hq
    calc
      (S / 2) ^ (p / 2) ≤ (X u) ^ (p / 2) := hpow
      _ = (‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ (2 : Nat)) ^ (p / 2) := by rfl
      _ = ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
        rw [← Real.rpow_natCast, ← Real.rpow_mul (norm_nonneg _)]
        congr 1
        ring
  have hgoodmoment :
      (good.card : Real) * (S / 2) ^ (p / 2) ≤
        ∑ u ∈ good, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
    calc
      (good.card : Real) * (S / 2) ^ (p / 2) =
          ∑ u ∈ good, (S / 2) ^ (p / 2) := by
            rw [Finset.sum_const, nsmul_eq_mul]
      _ ≤ ∑ u ∈ good, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
        apply Finset.sum_le_sum
        intro u hu
        exact hpoint u hu
  have hfullmoment :
      (∑ u ∈ good, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p) ≤
        ∑ u ∈ s.powerset, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hgoodsub
    intro u hu hnot
    exact Real.rpow_nonneg (norm_nonneg _) _
  calc
    n / 12 * (S / 2) ^ (p / 2) ≤
        (good.card : Real) * (S / 2) ^ (p / 2) :=
          mul_le_mul_of_nonneg_right hgoodcard (Real.rpow_nonneg (by positivity) _)
    _ ≤ ∑ u ∈ good, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := hgoodmoment
    _ ≤ ∑ u ∈ s.powerset, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u z‖ ^ p := hfullmoment

theorem brs_integral_rademacher_lower_moment
    {I X : Type*} [DecidableEq I] [MeasurableSpace X]
    (μ : Measure X) (s : Finset I) (g : I → X → Complex)
    {p : Real} (hp : 0 ≤ p)
    (hsign : ∀ u ∈ s.powerset,
      Integrable (fun x => ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^
          p) μ) :
    (s.powerset.card : Real) / 12 *
        (∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ) ≤
      ∑ u ∈ s.powerset,
        ∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
  have henergy_nonneg (x : X) : 0 ≤ _root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x := by
    dsimp [_root_.Auto.LittlewoodPaley.finiteSquareEnergy]
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have hright : Integrable (fun x =>
      ∑ u ∈ s.powerset,
        ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^ p) μ :=
    integrable_finsetSum s.powerset hsign
  have hpoint (x : X) :
      (s.powerset.card : Real) / 12 *
          (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^ (p / 2) ≤
        ∑ u ∈ s.powerset,
          ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^ p := by
    simpa only [_root_.Auto.LittlewoodPaley.finiteSquareEnergy] using
      brs_rademacher_lower_moment s (fun i => g i x) hp
  calc
    (s.powerset.card : Real) / 12 *
        (∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ) =
          ∫ x, (s.powerset.card : Real) / 12 *
            (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ := by
              rw [integral_const_mul]
    _ ≤ ∫ x, ∑ u ∈ s.powerset,
        ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              mul_nonneg (by positivity)
                (Real.rpow_nonneg (div_nonneg (henergy_nonneg x) (by norm_num)) _)
          · exact hright
          · exact Filter.Eventually.of_forall hpoint
    _ = ∑ u ∈ s.powerset,
        ∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u (fun i => g i x)‖ ^ p ∂μ := by
          rw [integral_finsetSum s.powerset hsign]

/-! ## Uniform signed bounds give the square function, for an arbitrary family

This is `littlewoodPaley_of_uniform_signed` with the dyadic projections
replaced by an arbitrary family: exactly what BRS (5.10) needs for the
compactly supported bumps `{ψ_j}`. -/

theorem brs_squareEnergy_le_of_uniform_signed {I X : Type*} [DecidableEq I]
    [MeasurableSpace X] {μ : Measure X} (s : Finset I) (g : I → X → Complex)
    {p B : Real} (hp : 0 ≤ p) (_hB : 0 ≤ B)
    (hint : ∀ u ∈ s.powerset, Integrable
      (fun x => ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u
        (fun i => g i x)‖ ^ p) μ)
    (hbnd : ∀ u ∈ s.powerset,
      (∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u
        (fun i => g i x)‖ ^ p ∂μ) ≤ B) :
    (∫ x, _root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x ^ (p / 2) ∂μ) ≤
      12 * 2 ^ (p / 2) * B := by
  have hEnn : ∀ x : X,
      0 ≤ _root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x := by
    intro x
    dsimp [_root_.Auto.LittlewoodPaley.finiteSquareEnergy]
    exact Finset.sum_nonneg fun i _ => by positivity
  have hcardnat : 0 < s.powerset.card :=
    Finset.card_pos.mpr ⟨∅, Finset.empty_mem_powerset s⟩
  have hcard : (0 : Real) < (s.powerset.card : Real) := by exact_mod_cast hcardnat
  have hmoment := brs_integral_rademacher_lower_moment μ s g hp hint
  have hsum : (∑ u ∈ s.powerset,
      ∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u
        (fun i => g i x)‖ ^ p ∂μ) ≤ (s.powerset.card : Real) * B := by
    calc (∑ u ∈ s.powerset,
          ∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u
            (fun i => g i x)‖ ^ p ∂μ)
        ≤ ∑ _u ∈ s.powerset, B := Finset.sum_le_sum hbnd
      _ = (s.powerset.card : Real) * B := by
          rw [Finset.sum_const, nsmul_eq_mul]
  have hhalf : (∫ x,
      (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^ (p / 2) ∂μ) ≤
      12 * B := by
    have hfac : (s.powerset.card : Real) *
        (∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
          (p / 2) ∂μ) ≤ (s.powerset.card : Real) * (12 * B) := by
      calc (s.powerset.card : Real) *
            (∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
              (p / 2) ∂μ)
          = 12 * ((s.powerset.card : Real) / 12 *
              ∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
                (p / 2) ∂μ) := by ring
        _ ≤ 12 * (∑ u ∈ s.powerset,
              ∫ x, ‖_root_.Auto.LittlewoodPaley.rademacherSignedSum s u
                (fun i => g i x)‖ ^ p ∂μ) := by
              exact mul_le_mul_of_nonneg_left hmoment (by norm_num)
        _ ≤ 12 * ((s.powerset.card : Real) * B) :=
              mul_le_mul_of_nonneg_left hsum (by norm_num)
        _ = (s.powerset.card : Real) * (12 * B) := by ring
    exact le_of_mul_le_mul_left hfac hcard
  have hscale : ∀ x : X,
      _root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x ^ (p / 2) =
        (2 : Real) ^ (p / 2) *
          (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
            (p / 2) := by
    intro x
    rw [Real.div_rpow (hEnn x) (by norm_num)]
    field_simp
  calc (∫ x, _root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x ^ (p / 2) ∂μ)
      = ∫ x, (2 : Real) ^ (p / 2) *
          (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
            (p / 2) ∂μ := by
        refine integral_congr_ae ?_
        filter_upwards with x
        rw [hscale x]
    _ = (2 : Real) ^ (p / 2) *
          ∫ x, (_root_.Auto.LittlewoodPaley.finiteSquareEnergy s g x / 2) ^
            (p / 2) ∂μ := integral_const_mul _ _
    _ ≤ (2 : Real) ^ (p / 2) * (12 * B) :=
        mul_le_mul_of_nonneg_left hhalf (by positivity)
    _ = 12 * 2 ^ (p / 2) * B := by ring

/-! ## The Fourier transform of a bump with vanishing moments

Near the origin the vanishing moments force the Fourier transform to vanish to
the same order: the Taylor remainder of the character is what the kernel sees.
This is the same cancellation mechanism as `brs_cancellation_of_taylor`, with
the character in place of the singular kernel. -/

/-- The character, as a function of the base point. -/
def brsChar (η : ℝ) : ℝ → ℂ :=
  fun u => Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (u : ℂ))

theorem brsChar_apply (η u : ℝ) :
    brsChar η u =
      Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (u : ℂ)) := rfl

theorem brsChar_neg (η y : ℝ) :
    brsChar η (0 - y) =
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) := by
  rw [brsChar_apply]
  congr 1
  push_cast
  ring

theorem continuous_brsChar (η : ℝ) : Continuous (brsChar η) := by
  have : brsChar η = fun u : ℝ =>
      Complex.exp (2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (u : ℂ)) := rfl
  rw [this]
  exact Complex.continuous_exp.comp (by fun_prop)

theorem norm_brsCharArg (η y : ℝ) :
    ‖-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))‖ =
      2 * Real.pi * |η| * |y| := by
  rw [norm_neg]
  simp only [norm_mul, Complex.norm_I, Complex.norm_real, Real.norm_eq_abs,
    Complex.norm_ofNat, mul_one]
  rw [abs_of_pos Real.pi_pos]

/-- **The Fourier transform of a kernel with vanishing moments vanishes to the
same order at the origin.** -/
theorem norm_fourierBump_le_of_moments {ψ : ℝ → ℝ} (hψ : Continuous ψ)
    {δ : ℝ} (hδ : 0 ≤ δ) (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0)
    {N : ℕ} (hN : 0 < N) (hmom : ∀ i : ℕ, i < N → (∫ y : ℝ, y ^ i * ψ y) = 0)
    {η : ℝ} (hη : 2 * Real.pi * |η| * δ ≤ 1) :
    ‖∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (ψ y : ℂ)‖ ≤
      ((2 * Real.pi * |η|) ^ N *
          ((N.succ : ℝ) * ((N.factorial : ℝ) * (N : ℝ))⁻¹)) * δ ^ N *
        ∫ y : ℝ, |ψ y| := by
  set M : ℝ := (2 * Real.pi * |η|) ^ N *
    ((N.succ : ℝ) * ((N.factorial : ℝ) * (N : ℝ))⁻¹) with hM
  have hMnn : 0 ≤ M := by
    rw [hM]
    positivity
  set c : ℕ → ℂ := fun i =>
    (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ))) ^ i / (i.factorial : ℂ)
    with hc
  have hcont : ∀ u : ℝ, |u - 0| ≤ δ → ContinuousAt (brsChar η) u :=
    fun u _ => (continuous_brsChar η).continuousAt
  have htaylor : ∀ y : ℝ, |y| ≤ δ →
      ‖brsChar η (0 - y) - ∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i‖ ≤
        M * |y| ^ N := by
    intro y hy
    have hnormz := norm_brsCharArg η y
    have hz1 : ‖-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))‖ ≤ 1 := by
      rw [hnormz]
      calc 2 * Real.pi * |η| * |y| ≤ 2 * Real.pi * |η| * δ :=
            mul_le_mul_of_nonneg_left hy (by positivity)
        _ ≤ 1 := hη
    have hexp := Complex.exp_bound hz1 hN
    have hsum : (∑ i ∈ Finset.range N, c i * (y : ℂ) ^ i) =
        ∑ i ∈ Finset.range N,
          (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) ^ i /
            (i.factorial : ℂ) := by
      refine Finset.sum_congr rfl fun i _ => ?_
      rw [hc]
      simp only
      rw [div_mul_eq_mul_div, ← mul_pow]
      congr 2
      ring
    rw [brsChar_neg, hsum]
    refine le_trans hexp (le_of_eq ?_)
    rw [hnormz, hM, mul_pow]
    ring
  have hkey := brs_cancellation_of_taylor hψ hδ hzero hmom hcont hMnn c htaylor
  have hcongr : (∫ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
        (ψ y : ℂ)) = ∫ y : ℝ, brsChar η (0 - y) * (ψ y : ℂ) := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    change Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
      (ψ y : ℂ) = brsChar η (0 - y) * (ψ y : ℂ)
    rw [brsChar_neg]
  rw [hcongr]
  exact hkey

/-! ## Integration by parts against the character

For a compactly supported `C¹` kernel, `𝓕(ψ') = 2πiη 𝓕(ψ)`; iterating gives
the decay of `𝓕ψ` at infinity that the Mikhlin condition needs. -/

/-- A compactly supported function vanishes off a closed ball, and so does its
derivative. -/
theorem exists_radius_of_hasCompactSupport {ψ : ℝ → ℝ}
    (hcs : HasCompactSupport ψ) :
    ∃ R : ℝ, 0 < R ∧ (∀ y : ℝ, R ≤ |y| → ψ y = 0) ∧
      (∀ y : ℝ, R ≤ |y| → deriv ψ y = 0) := by
  obtain ⟨R₀, hR₀⟩ := hcs.isCompact.isBounded.subset_closedBall 0
  refine ⟨max R₀ 1 + 1, by positivity, ?_, ?_⟩
  · intro y hy
    refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
    have := hR₀ hmem
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at this
    have : |y| ≤ max R₀ 1 := le_trans this (le_max_left R₀ 1)
    linarith
  · intro y hy
    have hzero : ∀ z : ℝ, max R₀ 1 < |z| → ψ z = 0 := by
      intro z hz
      refine image_eq_zero_of_notMem_tsupport fun hmem => ?_
      have hb := hR₀ hmem
      rw [Metric.mem_closedBall, Real.dist_eq, sub_zero] at hb
      exact absurd (le_trans hb (le_max_left R₀ 1)) (not_le.mpr hz)
    have hopen : IsOpen {z : ℝ | max R₀ 1 < |z|} :=
      isOpen_lt continuous_const continuous_abs
    have hymem : y ∈ {z : ℝ | max R₀ 1 < |z|} := by
      have : max R₀ 1 + 1 ≤ |y| := hy
      change max R₀ 1 < |y|
      linarith
    have hev : ψ =ᶠ[nhds y] fun _ => (0 : ℝ) :=
      Filter.eventuallyEq_of_mem (hopen.mem_nhds hymem) fun z hz => hzero z hz
    rw [hev.deriv_eq]
    exact deriv_const y 0

/-- **Integration by parts against the character.** -/
theorem fourierBump_deriv_eq {ψ : ℝ → ℝ} (hψ : ContDiff ℝ 1 ψ)
    (hcs : HasCompactSupport ψ) (η : ℝ) :
    (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          ((deriv ψ y : ℝ) : ℂ)) =
      (2 * (Real.pi : ℂ) * Complex.I * (η : ℂ)) *
        ∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
            (ψ y : ℂ) := by
  obtain ⟨R, hR0, hzero, hzero'⟩ := exists_radius_of_hasCompactSupport hcs
  set a : ℂ := -(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ)) with ha
  set F : ℝ → ℂ := fun y => Complex.exp (a * (y : ℂ)) * (ψ y : ℂ) with hF
  set G : ℝ → ℂ := fun y =>
    a * (Complex.exp (a * (y : ℂ)) * (ψ y : ℂ)) +
      Complex.exp (a * (y : ℂ)) * ((deriv ψ y : ℝ) : ℂ) with hG
  have hψd : ∀ y : ℝ, HasDerivAt ψ (deriv ψ y) y := by
    intro y
    exact (hψ.differentiable (by norm_num) y).hasDerivAt
  have hderiv : ∀ y : ℝ, HasDerivAt F (G y) y := by
    intro y
    have h1 : HasDerivAt (fun z : ℝ => Complex.exp (a * (z : ℂ)))
        (a * Complex.exp (a * (y : ℂ))) y := by
      have hlin : HasDerivAt (fun z : ℝ => a * (z : ℂ)) a y := by
        simpa using ((Complex.ofRealCLM.hasDerivAt (x := y)).const_mul a)
      simpa [mul_comm] using hlin.cexp
    have h2 : HasDerivAt (fun z : ℝ => ((ψ z : ℝ) : ℂ))
        ((deriv ψ y : ℝ) : ℂ) y := (hψd y).ofReal_comp
    have h3 := h1.mul h2
    have heq : a * Complex.exp (a * (y : ℂ)) * (ψ y : ℂ) +
        Complex.exp (a * (y : ℂ)) * ((deriv ψ y : ℝ) : ℂ) =
        a * (Complex.exp (a * (y : ℂ)) * (ψ y : ℂ)) +
          Complex.exp (a * (y : ℂ)) * ((deriv ψ y : ℝ) : ℂ) := by ring
    rw [heq] at h3
    rw [hF, hG]
    exact h3
  have hGcont : Continuous G := by
    have hc1 : Continuous fun y : ℝ => Complex.exp (a * (y : ℂ)) :=
      Complex.continuous_exp.comp (by fun_prop)
    have hc2 : Continuous fun y : ℝ => (ψ y : ℂ) :=
      Complex.continuous_ofReal.comp hψ.continuous
    have hc3 : Continuous fun y : ℝ => ((deriv ψ y : ℝ) : ℂ) :=
      Complex.continuous_ofReal.comp
        (hψ.continuous_deriv (by norm_num))
    rw [hG]
    exact (hc1.mul hc2).const_mul a |>.add (hc1.mul hc3)
  have hGzero : ∀ y : ℝ, y ∉ Icc (-R) R → G y = 0 := by
    intro y hy
    have habs : R ≤ |y| := by
      rcases le_or_gt |y| R with h | h
      · exact absurd (Set.mem_Icc.mpr ⟨by linarith [neg_abs_le y],
          by linarith [le_abs_self y]⟩) hy
      · exact h.le
    rw [hG]
    simp only
    rw [hzero y habs, hzero' y habs]
    simp
  have hFtb : F R - F (-R) = 0 := by
    have h1 : ψ R = 0 := hzero R (by rw [abs_of_pos hR0])
    have h2 : ψ (-R) = 0 := hzero (-R) (by
      rw [abs_neg, abs_of_pos hR0])
    rw [hF]
    simp only
    rw [h1, h2]
    simp
  have hint : (∫ y : ℝ, G y) = 0 := by
    have hsub : (∫ y in Icc (-R) R, G y) = ∫ y : ℝ, G y :=
      setIntegral_eq_integral_of_forall_compl_eq_zero hGzero
    have hIcc : (∫ y in Icc (-R) R, G y) = ∫ y in (-R)..R, G y := by
      rw [intervalIntegral.integral_of_le (by linarith),
        ← MeasureTheory.integral_Icc_eq_integral_Ioc]
    have hftc : (∫ y in (-R)..R, G y) = F R - F (-R) :=
      intervalIntegral.integral_eq_sub_of_hasDerivAt (fun y _ => hderiv y)
        (hGcont.intervalIntegrable _ _)
    rw [← hsub, hIcc, hftc, hFtb]
  have hsplit : (∫ y : ℝ, G y) =
      a * (∫ y : ℝ, Complex.exp (a * (y : ℂ)) * (ψ y : ℂ)) +
        ∫ y : ℝ, Complex.exp (a * (y : ℂ)) * ((deriv ψ y : ℝ) : ℂ) := by
    have hi1 : Integrable
        (fun y : ℝ => Complex.exp (a * (y : ℂ)) * (ψ y : ℂ)) volume := by
      have hc : Continuous fun y : ℝ =>
          Complex.exp (a * (y : ℂ)) * (ψ y : ℂ) :=
        (Complex.continuous_exp.comp (by fun_prop)).mul
          (Complex.continuous_ofReal.comp hψ.continuous)
      refine hc.integrable_of_hasCompactSupport ?_
      exact (hcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)).mul_left
    have hi2 : Integrable
        (fun y : ℝ => Complex.exp (a * (y : ℂ)) *
          ((deriv ψ y : ℝ) : ℂ)) volume := by
      have hc : Continuous fun y : ℝ =>
          Complex.exp (a * (y : ℂ)) * ((deriv ψ y : ℝ) : ℂ) :=
        (Complex.continuous_exp.comp (by fun_prop)).mul
          (Complex.continuous_ofReal.comp (hψ.continuous_deriv (by norm_num)))
      refine hc.integrable_of_hasCompactSupport ?_
      exact ((hcs.deriv).comp_left (g := fun z : ℝ => (z : ℂ))
        (by simp)).mul_left
    rw [hG]
    rw [integral_add (hi1.const_mul a) hi2, integral_const_mul]
  rw [hsplit] at hint
  have hfin : (∫ y : ℝ, Complex.exp (a * (y : ℂ)) *
      ((deriv ψ y : ℝ) : ℂ)) =
      -a * ∫ y : ℝ, Complex.exp (a * (y : ℂ)) * (ψ y : ℂ) := by
    linear_combination hint
  rw [ha] at hfin
  simpa using hfin

/-! ## Decay of the Fourier transform at infinity

Iterating `fourierBump_deriv_eq` gives `|η|^M |𝓕ψ(η)| ≤ (2π)^{-M}∫|ψ^{(M)}|`
for a compactly supported `C^M` kernel. -/

theorem norm_brsCharExp (η y : ℝ) :
    ‖Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ)))‖ = 1 := by
  have hz : (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) =
      ((-(2 * Real.pi * η * y) : ℝ) : ℂ) * Complex.I := by
    push_cast
    ring
  rw [hz, Complex.norm_exp_ofReal_mul_I]

/-- The trivial bound on the Fourier transform. -/
theorem norm_fourierBump_le_integral {ψ : ℝ → ℝ} (_hψ : Continuous ψ)
    (_hcs : HasCompactSupport ψ) (η : ℝ) :
    ‖∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (ψ y : ℂ)‖ ≤ ∫ y : ℝ, |ψ y| := by
  have hbound := norm_integral_le_integral_norm
    (f := fun y : ℝ =>
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
        (ψ y : ℂ)) (μ := (volume : Measure ℝ))
  refine le_trans hbound (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change ‖Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
    (ψ y : ℂ)‖ = |ψ y|
  rw [norm_mul, norm_brsCharExp, one_mul, Complex.norm_real, Real.norm_eq_abs]

/-- **Decay of the Fourier transform of a compactly supported `C^M` kernel.** -/
theorem norm_fourierBump_pow_le_iteratedDeriv :
    ∀ (M : ℕ) {ψ : ℝ → ℝ}, ContDiff ℝ M ψ → HasCompactSupport ψ → ∀ η : ℝ,
      (2 * Real.pi * |η|) ^ M *
          ‖∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
              (y : ℂ))) * (ψ y : ℂ)‖ ≤
        ∫ y : ℝ, |iteratedDeriv M ψ y| := by
  intro M
  induction M with
  | zero =>
      intro ψ hψ hcs η
      simpa [iteratedDeriv_zero] using
        norm_fourierBump_le_integral hψ.continuous hcs η
  | succ M ih =>
      intro ψ hψ hcs η
      have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by
        exact_mod_cast Nat.one_le_iff_ne_zero.mpr (Nat.succ_ne_zero M))
      have hderivψ : ContDiff ℝ M (deriv ψ) := by
        have := (contDiff_succ_iff_deriv (n := M) (f := ψ)).mp hψ
        exact this.2.2
      have hcsd : HasCompactSupport (deriv ψ) := hcs.deriv
      have hih := ih hderivψ hcsd η
      have hIBP := fourierBump_deriv_eq hψ1 hcs η
      have hnorm : ‖∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
            (y : ℂ))) * ((deriv ψ y : ℝ) : ℂ)‖ =
          2 * Real.pi * |η| *
            ‖∫ y : ℝ, Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I *
              (η : ℂ) * (y : ℂ))) * (ψ y : ℂ)‖ := by
        rw [hIBP, norm_mul]
        congr 1
        simp only [norm_mul, Complex.norm_I, Complex.norm_real,
          Real.norm_eq_abs, Complex.norm_ofNat, mul_one]
        rw [abs_of_pos Real.pi_pos]
      rw [hnorm] at hih
      have hiter : (∫ y : ℝ, |iteratedDeriv M (deriv ψ) y|) =
          ∫ y : ℝ, |iteratedDeriv (M + 1) ψ y| := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        rw [iteratedDeriv_succ']
      rw [hiter] at hih
      refine le_trans (le_of_eq ?_) hih
      ring

/-! ## Two-sided geometric summation

A quantity that decays like `t^a` for small `t` and like `t^{-b}` for large `t`
sums to a bounded amount along any geometric sequence, uniformly in the
starting point.  This is what turns the two ends of the decay of `𝓕ψ` into a
Mikhlin bound for `Σ_j ε_j ψ̂(2^{-j}·)`. -/

theorem sum_min_geometric_le {ρ a b c : ℝ} (hρ0 : 0 < ρ) (hρ1 : ρ < 1)
    (ha : 0 < a) (hb : 0 < b) (hc : 0 < c) (K : Finset ℕ) :
    (∑ k ∈ K, min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b))) ≤
      (1 - ρ ^ a)⁻¹ + (1 - ρ ^ b)⁻¹ := by
  classical
  have hρa0 : 0 < ρ ^ a := Real.rpow_pos_of_pos hρ0 _
  have hρb0 : 0 < ρ ^ b := Real.rpow_pos_of_pos hρ0 _
  have hρa1 : ρ ^ a < 1 := Real.rpow_lt_one hρ0.le hρ1 ha
  have hρb1 : ρ ^ b < 1 := Real.rpow_lt_one hρ0.le hρ1 hb
  have hex : ∃ k : ℕ, ρ ^ k * c ≤ 1 := by
    obtain ⟨n, hn⟩ :=
      exists_pow_lt_of_lt_one (by positivity : (0 : ℝ) < c⁻¹) hρ1
    refine ⟨n, ?_⟩
    calc ρ ^ n * c ≤ c⁻¹ * c := mul_le_mul_of_nonneg_right hn.le hc.le
      _ = 1 := inv_mul_cancel₀ hc.ne'
  set k₀ : ℕ := Nat.find hex with hk₀
  have hk₀spec : ρ ^ k₀ * c ≤ 1 := Nat.find_spec hex
  have hk₀min : ∀ k : ℕ, k < k₀ → 1 < ρ ^ k * c := by
    intro k hk
    exact not_le.mp (Nat.find_min hex hk)
  have hbig : (∑ k ∈ K.filter fun k => k₀ ≤ k,
      min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b))) ≤ (1 - ρ ^ a)⁻¹ := by
    have hterm : ∀ k ∈ K.filter fun k => k₀ ≤ k,
        min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)) ≤ (ρ ^ a) ^ (k - k₀) := by
      intro k hk
      have hle : k₀ ≤ k := (Finset.mem_filter.mp hk).2
      have hfac : ρ ^ k * c = ρ ^ (k - k₀) * (ρ ^ k₀ * c) := by
        rw [← mul_assoc, ← pow_add]
        congr 2
        omega
      have hbound : ρ ^ k * c ≤ ρ ^ (k - k₀) := by
        rw [hfac]
        calc ρ ^ (k - k₀) * (ρ ^ k₀ * c) ≤ ρ ^ (k - k₀) * 1 :=
              mul_le_mul_of_nonneg_left hk₀spec (by positivity)
          _ = ρ ^ (k - k₀) := by ring
      calc min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)) ≤ (ρ ^ k * c) ^ a :=
            min_le_left _ _
        _ ≤ (ρ ^ (k - k₀)) ^ a := Real.rpow_le_rpow (by positivity) hbound ha.le
        _ = (ρ ^ a) ^ (k - k₀) := by
            rw [← Real.rpow_natCast ρ (k - k₀), ← Real.rpow_mul hρ0.le,
              ← Real.rpow_natCast (ρ ^ a) (k - k₀), ← Real.rpow_mul hρ0.le]
            congr 1
            ring
    refine le_trans (Finset.sum_le_sum hterm) ?_
    have hinj : ∀ x ∈ K.filter fun k => k₀ ≤ k, ∀ y ∈ K.filter fun k => k₀ ≤ k,
        x - k₀ = y - k₀ → x = y := by
      intro x hx y hy hxy
      have h1 : k₀ ≤ x := (Finset.mem_filter.mp hx).2
      have h2 : k₀ ≤ y := (Finset.mem_filter.mp hy).2
      omega
    rw [← Finset.sum_image (f := fun i : ℕ => (ρ ^ a) ^ i) hinj]
    refine le_trans ((summable_geometric_of_lt_one hρa0.le hρa1).sum_le_tsum _
      (fun i _ => by positivity)) ?_
    rw [tsum_geometric_of_lt_one hρa0.le hρa1]
  have hsmall : (∑ k ∈ K.filter fun k => ¬ k₀ ≤ k,
      min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b))) ≤ (1 - ρ ^ b)⁻¹ := by
    have hterm : ∀ k ∈ K.filter fun k => ¬ k₀ ≤ k,
        min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)) ≤
          (ρ ^ b) ^ (k₀ - 1 - k) := by
      intro k hk
      have hlt : k < k₀ := by
        have := (Finset.mem_filter.mp hk).2
        omega
      have hprev : 1 < ρ ^ (k₀ - 1) * c := hk₀min (k₀ - 1) (by omega)
      have hfac : ρ ^ (k₀ - 1) * c = ρ ^ (k₀ - 1 - k) * (ρ ^ k * c) := by
        rw [← mul_assoc, ← pow_add]
        congr 2
        omega
      have hupos : (0 : ℝ) < ρ ^ (k₀ - 1 - k) := by positivity
      have htpos : (0 : ℝ) < ρ ^ k * c := by positivity
      have hone : 1 ≤ ρ ^ (k₀ - 1 - k) * (ρ ^ k * c) := by
        rw [← hfac]
        linarith
      have hlow : (ρ ^ (k₀ - 1 - k))⁻¹ ≤ ρ ^ k * c := by
        rw [inv_le_iff_one_le_mul₀ hupos]
        linarith [hone]
      have hstep : (ρ ^ k * c) ^ (-b) ≤ ((ρ ^ (k₀ - 1 - k))⁻¹) ^ (-b) :=
        rpow_le_rpow_of_nonpos_exp (by positivity) hlow (by linarith)
      have hval : ((ρ ^ (k₀ - 1 - k))⁻¹) ^ (-b) = (ρ ^ b) ^ (k₀ - 1 - k) := by
        rw [← Real.rpow_neg_one (ρ ^ (k₀ - 1 - k)), ← Real.rpow_mul hupos.le,
          ← Real.rpow_natCast ρ (k₀ - 1 - k), ← Real.rpow_mul hρ0.le,
          ← Real.rpow_natCast (ρ ^ b) (k₀ - 1 - k), ← Real.rpow_mul hρ0.le]
        congr 1
        ring
      calc min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)) ≤ (ρ ^ k * c) ^ (-b) :=
            min_le_right _ _
        _ ≤ ((ρ ^ (k₀ - 1 - k))⁻¹) ^ (-b) := hstep
        _ = (ρ ^ b) ^ (k₀ - 1 - k) := hval
    refine le_trans (Finset.sum_le_sum hterm) ?_
    have hinj : ∀ x ∈ K.filter fun k => ¬ k₀ ≤ k,
        ∀ y ∈ K.filter fun k => ¬ k₀ ≤ k,
        k₀ - 1 - x = k₀ - 1 - y → x = y := by
      intro x hx y hy hxy
      have h1 : x < k₀ := by
        have := (Finset.mem_filter.mp hx).2
        omega
      have h2 : y < k₀ := by
        have := (Finset.mem_filter.mp hy).2
        omega
      omega
    rw [← Finset.sum_image (f := fun i : ℕ => (ρ ^ b) ^ i) hinj]
    refine le_trans ((summable_geometric_of_lt_one hρb0.le hρb1).sum_le_tsum _
      (fun i _ => by positivity)) ?_
    rw [tsum_geometric_of_lt_one hρb0.le hρb1]
  calc (∑ k ∈ K, min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)))
      = (∑ k ∈ K.filter fun k => k₀ ≤ k,
            min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b))) +
          ∑ k ∈ K.filter fun k => ¬ k₀ ≤ k,
            min ((ρ ^ k * c) ^ a) ((ρ ^ k * c) ^ (-b)) :=
        (Finset.sum_filter_add_sum_filter_not K _ _).symm
    _ ≤ (1 - ρ ^ a)⁻¹ + (1 - ρ ^ b)⁻¹ := add_le_add hbig hsmall

/-! ## Two-sided decay summed along the dyadic dilates

The bridge between the decay estimates for `𝓕ψ` and the Mikhlin bound: a
quantity with two-sided power decay sums to a bound independent of the
frequency along any dyadic family of dilates. -/

theorem min_mul_le_add_mul_min {A B u v : ℝ} (hA : 0 ≤ A) (hB : 0 ≤ B)
    (hu : 0 ≤ u) (hv : 0 ≤ v) : min (A * u) (B * v) ≤ (A + B) * min u v := by
  rcases le_total u v with h | h
  · rw [min_eq_left h]
    calc min (A * u) (B * v) ≤ A * u := min_le_left _ _
      _ ≤ (A + B) * u := by nlinarith
  · rw [min_eq_right h]
    calc min (A * u) (B * v) ≤ B * v := min_le_right _ _
      _ ≤ (A + B) * v := by nlinarith

/-- **Two-sided decay, summed along dyadic dilates.** -/
theorem sum_dyadic_dilate_le {A B a b : ℝ} (ha : 0 < a) (hb : 0 < b)
    (hA : 0 ≤ A) (hB : 0 ≤ B) {G : ℝ → ℝ}
    (hGa : ∀ η : ℝ, G η ≤ A * |η| ^ a)
    (hGb : ∀ η : ℝ, G η ≤ B * |η| ^ (-b))
    {ξ : ℝ} (hξ : ξ ≠ 0) (m : ℕ) (K : Finset ℕ) :
    (∑ k ∈ K, G ((1 / 2 : ℝ) ^ (k + m) * ξ)) ≤
      (A + B) * ((1 - (1 / 2 : ℝ) ^ a)⁻¹ + (1 - (1 / 2 : ℝ) ^ b)⁻¹) := by
  have hξ0 : 0 < |ξ| := abs_pos.mpr hξ
  set c : ℝ := (1 / 2 : ℝ) ^ m * |ξ| with hc
  have hc0 : 0 < c := by
    rw [hc]
    positivity
  have habs : ∀ k : ℕ, |(1 / 2 : ℝ) ^ (k + m) * ξ| = (1 / 2 : ℝ) ^ k * c := by
    intro k
    rw [abs_mul, abs_of_pos (by positivity : (0 : ℝ) < (1 / 2 : ℝ) ^ (k + m)),
      hc, pow_add]
    ring
  have hterm : ∀ k ∈ K, G ((1 / 2 : ℝ) ^ (k + m) * ξ) ≤
      (A + B) * min (((1 / 2 : ℝ) ^ k * c) ^ a)
        (((1 / 2 : ℝ) ^ k * c) ^ (-b)) := by
    intro k _
    have h1 := hGa ((1 / 2 : ℝ) ^ (k + m) * ξ)
    have h2 := hGb ((1 / 2 : ℝ) ^ (k + m) * ξ)
    rw [habs k] at h1 h2
    refine le_trans (le_min h1 h2) ?_
    exact min_mul_le_add_mul_min hA hB (by positivity) (by positivity)
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.mul_sum]
  refine mul_le_mul_of_nonneg_left ?_ (by linarith)
  exact sum_min_geometric_le (by norm_num) (by norm_num) ha hb hc0 K

/-! ## The origin estimate for the derivatives of `𝓕ψ`

The `k`-th derivative of `𝓕ψ` is the Fourier transform of `(-2πix)^k ψ`, and
that kernel still has vanishing moments — of order `N - k` rather than `N`.
So the same cancellation estimate applies, with `k` orders of decay lost. -/

/-- Multiplying by `y^k` shifts the vanishing moments down by `k`. -/
theorem moments_mul_pow {ψ : ℝ → ℝ} {N : ℕ}
    (hmom : ∀ i : ℕ, i < N → (∫ y : ℝ, y ^ i * ψ y) = 0) (k : ℕ) :
    ∀ i : ℕ, i < N - k → (∫ y : ℝ, y ^ i * (y ^ k * ψ y)) = 0 := by
  intro i hi
  have hik : i + k < N := by omega
  have hcongr : (∫ y : ℝ, y ^ i * (y ^ k * ψ y)) =
      ∫ y : ℝ, y ^ (i + k) * ψ y := by
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    change y ^ i * (y ^ k * ψ y) = y ^ (i + k) * ψ y
    rw [pow_add]
    ring
  rw [hcongr]
  exact hmom (i + k) hik

/-- The kernel `y^k ψ` still vanishes off the support of `ψ`. -/
theorem vanishing_mul_pow {ψ : ℝ → ℝ} {δ : ℝ}
    (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0) (k : ℕ) :
    ∀ y : ℝ, δ < |y| → y ^ k * ψ y = 0 := by
  intro y hy
  rw [hzero y hy, mul_zero]

/-- **The origin estimate for `𝓕(y^k ψ)`.** -/
theorem norm_fourierBump_mul_pow_le_of_moments {ψ : ℝ → ℝ} (hψ : Continuous ψ)
    {δ : ℝ} (hδ : 0 ≤ δ) (hzero : ∀ y : ℝ, δ < |y| → ψ y = 0)
    {N k : ℕ} (hk : k < N)
    (hmom : ∀ i : ℕ, i < N → (∫ y : ℝ, y ^ i * ψ y) = 0)
    {η : ℝ} (hη : 2 * Real.pi * |η| * δ ≤ 1) :
    ‖∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          ((y ^ k * ψ y : ℝ) : ℂ)‖ ≤
      ((2 * Real.pi * |η|) ^ (N - k) *
          (((N - k).succ : ℝ) * (((N - k).factorial : ℝ) * ((N - k : ℕ) : ℝ))⁻¹)) *
        δ ^ (N - k) * ∫ y : ℝ, |y ^ k * ψ y| := by
  have hcont : Continuous fun y : ℝ => y ^ k * ψ y :=
    (continuous_pow k).mul hψ
  exact norm_fourierBump_le_of_moments hcont hδ (vanishing_mul_pow hzero k)
    (by omega : 0 < N - k) (moments_mul_pow hmom k) hη

/-! ## The moments of a derivative

The `n`-th derivative of a compactly supported smooth function has vanishing
moments of every order below `n`.  This is the construction behind a bump whose
Fourier transform is non-vanishing away from the origin: if `υ = χ^{(n)}` then
`𝓕υ(ξ) = (2πiξ)^n 𝓕χ(ξ)`, which is non-zero wherever `ξ ≠ 0` and
`𝓕χ(ξ) ≠ 0`. -/

theorem hasCompactSupport_iteratedDeriv {ψ : ℝ → ℝ}
    (hcs : HasCompactSupport ψ) (n : ℕ) :
    HasCompactSupport (iteratedDeriv n ψ) := by
  induction n with
  | zero =>
      rw [iteratedDeriv_zero]
      exact hcs
  | succ m ih =>
      rw [iteratedDeriv_succ]
      exact ih.deriv

theorem contDiff_iteratedDeriv_of_top {ψ : ℝ → ℝ}
    (hψ : ContDiff ℝ (⊤ : ℕ∞) ψ) (n : ℕ) :
    ContDiff ℝ (⊤ : ℕ∞) (iteratedDeriv n ψ) := by
  induction n with
  | zero =>
      rw [iteratedDeriv_zero]
      exact hψ
  | succ m ih =>
      rw [iteratedDeriv_succ]
      exact (contDiff_infty_iff_deriv.mp ih).2

/-- **The moments of an `n`-th derivative vanish below `n`.** -/
theorem integral_pow_mul_iteratedDeriv_eq_zero :
    ∀ (n : ℕ) {ψ : ℝ → ℝ}, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ →
      ∀ i : ℕ, i < n → (∫ y : ℝ, y ^ i * iteratedDeriv n ψ y) = 0 := by
  intro n
  induction n with
  | zero =>
      intro ψ _ _ i hi
      omega
  | succ n ih =>
      intro ψ hψ hcs i hi
      have hgcs : HasCompactSupport (iteratedDeriv n ψ) :=
        hasCompactSupport_iteratedDeriv hcs n
      have hgcd : ContDiff ℝ 1 (iteratedDeriv n ψ) :=
        (contDiff_iteratedDeriv_of_top hψ n).of_le (by exact_mod_cast le_top)
      have hrw : (∫ y : ℝ, y ^ i * iteratedDeriv (n + 1) ψ y) =
          ∫ y : ℝ, y ^ i * deriv (iteratedDeriv n ψ) y := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        change y ^ i * iteratedDeriv (n + 1) ψ y =
          y ^ i * deriv (iteratedDeriv n ψ) y
        rw [iteratedDeriv_succ]
      rw [hrw, integral_pow_mul_deriv_eq hgcd hgcs i]
      rcases Nat.eq_zero_or_pos i with hi0 | hipos
      · subst hi0
        simp
      · have hIH : (∫ y : ℝ, y ^ (i - 1) * iteratedDeriv n ψ y) = 0 :=
          ih hψ hcs (i - 1) (by omega)
        rw [hIH, mul_zero]

/-! ## The Fourier transform of an iterated derivative

`𝓕(ψ^{(n)})(η) = (2πiη)^n 𝓕ψ(η)`, by iterating the integration by parts. -/

theorem fourierBump_iteratedDeriv_eq :
    ∀ (n : ℕ) {ψ : ℝ → ℝ}, ContDiff ℝ (⊤ : ℕ∞) ψ → HasCompactSupport ψ →
      ∀ η : ℝ,
      (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          ((iteratedDeriv n ψ y : ℝ) : ℂ)) =
        (2 * (Real.pi : ℂ) * Complex.I * (η : ℂ)) ^ n *
          ∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
              (y : ℂ))) * (ψ y : ℂ) := by
  intro n
  induction n with
  | zero =>
      intro ψ _ _ η
      simp [iteratedDeriv_zero]
  | succ n ih =>
      intro ψ hψ hcs η
      have hψ1 : ContDiff ℝ 1 ψ := hψ.of_le (by exact_mod_cast le_top)
      have hderivsmooth : ContDiff ℝ (⊤ : ℕ∞) (deriv ψ) :=
        (contDiff_infty_iff_deriv.mp hψ).2
      have hderivcs : HasCompactSupport (deriv ψ) := hcs.deriv
      have hstep : (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
            (y : ℂ))) * ((iteratedDeriv (n + 1) ψ y : ℝ) : ℂ)) =
          ∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
              (y : ℂ))) * ((iteratedDeriv n (deriv ψ) y : ℝ) : ℂ) := by
        refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
        change Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
            (y : ℂ))) * ((iteratedDeriv (n + 1) ψ y : ℝ) : ℂ) =
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) *
            (y : ℂ))) * ((iteratedDeriv n (deriv ψ) y : ℝ) : ℂ)
        rw [iteratedDeriv_succ']
      rw [hstep, ih hderivsmooth hderivcs η, fourierBump_deriv_eq hψ1 hcs η]
      ring

/-! ## The explicit Fourier integral is Mathlib's `𝓕`

Identifying the integral used in the kernel estimates with `𝓕` gives access to
its continuity, its value at the origin, and the dilation identity — the three
facts behind the choice of a bump whose Fourier transform does not vanish on an
annulus. -/

open scoped FourierTransform in
theorem brsFourier_eq (ψ : ℝ → ℝ) (η : ℝ) :
    (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (ψ y : ℂ)) = 𝓕 (fun y : ℝ => (ψ y : ℂ)) η := by
  rw [Real.fourier_eq']
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
      (ψ y : ℂ) =
    Complex.exp (((-2 * Real.pi * (inner ℝ y η : ℝ) : ℝ) : ℂ) * Complex.I) •
      ((ψ y : ℝ) : ℂ)
  rw [smul_eq_mul, Real.inner_apply]
  congr 2
  push_cast
  ring

open scoped FourierTransform in
theorem continuous_brsFourier {ψ : ℝ → ℝ} (hψ : Continuous ψ)
    (hcs : HasCompactSupport ψ) :
    Continuous (fun η : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (ψ y : ℂ)) := by
  have hint : Integrable (fun y : ℝ => (ψ y : ℂ)) volume := by
    refine (Complex.continuous_ofReal.comp hψ).integrable_of_hasCompactSupport ?_
    exact hcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  have hcong : (fun η : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (ψ y : ℂ)) = 𝓕 (fun y : ℝ => (ψ y : ℂ)) := by
    funext η
    exact brsFourier_eq ψ η
  rw [hcong]
  have hunfold : (𝓕 (fun y : ℝ => (ψ y : ℂ))) =
      VectorFourier.fourierIntegral Real.fourierChar volume (innerₗ ℝ)
        (fun y : ℝ => (ψ y : ℂ)) := rfl
  rw [hunfold]
  exact VectorFourier.fourierIntegral_continuous Real.continuous_fourierChar
    (by fun_prop) hint

theorem brsFourier_zero (ψ : ℝ → ℝ) :
    (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
          (y : ℂ))) * (ψ y : ℂ)) = ((∫ y : ℝ, ψ y : ℝ) : ℂ) := by
  rw [brsFourier_eq ψ 0, Real.fourier_eq']
  rw [← integral_complex_ofReal]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change Complex.exp (((-2 * Real.pi * (inner ℝ y (0 : ℝ) : ℝ) : ℝ) : ℂ) *
      Complex.I) • ((ψ y : ℝ) : ℂ) = ((ψ y : ℝ) : ℂ)
  rw [Real.inner_apply]
  norm_num

/-- **The dilation identity.** -/
theorem brsFourier_dilate {ψ : ℝ → ℝ} {lam : ℝ} (hlam : 0 < lam) (η : ℝ) :
    (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          ((lam * ψ (lam * y) : ℝ) : ℂ)) =
      ∫ u : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((η / lam : ℝ) : ℂ) *
          (u : ℂ))) * (ψ u : ℂ) := by
  set g : ℝ → ℂ := fun u : ℝ =>
    Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((η / lam : ℝ) : ℂ) *
      (u : ℂ))) * (ψ u : ℂ) with hg
  have hpt : ∀ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
        ((lam * ψ (lam * y) : ℝ) : ℂ) = (lam : ℂ) * g (lam * y) := by
    intro y
    rw [hg]
    simp only
    have hlamC : (lam : ℂ) ≠ 0 := by
      exact_mod_cast hlam.ne'
    have hexp : (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) =
        -(2 * (Real.pi : ℂ) * Complex.I * ((η / lam : ℝ) : ℂ) *
          ((lam * y : ℝ) : ℂ)) := by
      push_cast
      field_simp
    rw [hexp]
    push_cast
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt), integral_const_mul,
    Measure.integral_comp_mul_left g lam,
    abs_of_pos (inv_pos.mpr hlam), Complex.real_smul, ← mul_assoc]
  rw [show (lam : ℂ) * ((lam : ℝ)⁻¹ : ℝ) = 1 from by
    push_cast
    field_simp
    exact div_self (by exact_mod_cast hlam.ne' : (lam : ℂ) ≠ 0), one_mul]

/-! ## A bump with vanishing moments and non-vanishing Fourier transform

The kernel behind the Littlewood–Paley factorization: a compactly supported
smooth `υ` whose moments vanish to order `N` and whose Fourier transform stays
away from zero on the annulus `1/2 ≤ |ξ| ≤ 2`.  Start from a bump `χ` of unit
mass; its Fourier transform is continuous and equals `1` at the origin, so a
dilate `λχ(λ·)` has Fourier transform `𝓕χ(ξ/λ)` bounded away from zero on
`|ξ| ≤ 2` once `λ` is large.  Differentiating `N + 1` times supplies the
vanishing moments and multiplies the Fourier transform by `(2πiξ)^{N+1}`, which
is harmless away from the origin. -/

theorem exists_brsBumpBase :
    ∃ χ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧
      (∫ y : ℝ, χ y) = 1 := by
  let f : ContDiffBump (0 : ℝ) := ⟨1, 2, one_pos, by norm_num⟩
  exact ⟨f.normed volume, f.contDiff_normed, f.hasCompactSupport_normed,
    f.integral_normed⟩

/-- **The bump used in the Littlewood–Paley factorization.** -/
theorem exists_brsBumpNonvanishing (N : ℕ) :
    ∃ υ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      ∀ ξ : ℝ, 1 / 2 ≤ |ξ| → |ξ| ≤ 2 →
        (∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
              (υ y : ℂ)) ≠ 0 := by
  obtain ⟨χ, hχ, hχcs, hχint⟩ := exists_brsBumpBase
  have hFcont : Continuous (fun η : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) := continuous_brsFourier hχ.continuous hχcs
  have hF0 : (∫ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
        (y : ℂ))) * (χ y : ℂ)) = 1 := by
    rw [brsFourier_zero χ, hχint]
    norm_num
  obtain ⟨δ, hδ, hball⟩ :=
    Metric.continuousAt_iff.mp (hFcont.continuousAt (x := (0 : ℝ))) 1 one_pos
  have hδ0 : δ ≠ 0 := ne_of_gt hδ
  have hFne : ∀ η : ℝ, |η| < δ →
      (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) ≠ 0 := by
    intro η hη hzero
    have hd : dist η (0 : ℝ) < δ := by
      rwa [Real.dist_eq, sub_zero]
    have hb : dist
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
            (χ y : ℂ))
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
            (y : ℂ))) * (χ y : ℂ)) < 1 := hball hd
    rw [hzero, hF0, dist_eq_norm] at hb
    norm_num at hb
  obtain ⟨lam, hlam, hlamlt⟩ :
      ∃ lam : ℝ, 0 < lam ∧ ∀ ξ : ℝ, |ξ| ≤ 2 → |ξ / lam| < δ := by
    refine ⟨4 / δ, by positivity, fun ξ hξ => ?_⟩
    rw [abs_div, abs_of_pos (show (0 : ℝ) < 4 / δ by positivity),
      div_lt_iff₀ (show (0 : ℝ) < 4 / δ by positivity),
      show δ * (4 / δ) = 4 from by field_simp]
    linarith
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => lam * χ (lam * y)) :=
    contDiff_const.mul (hχ.comp (contDiff_const.mul contDiff_id))
  have hcs : HasCompactSupport (fun y : ℝ => lam * χ (lam * y)) :=
    (hχcs.comp_homeomorph (Homeomorph.mulLeft₀ lam hlam.ne')).mul_left
  refine ⟨iteratedDeriv (N + 1) (fun y : ℝ => lam * χ (lam * y)),
    contDiff_iteratedDeriv_of_top hsmooth (N + 1),
    hasCompactSupport_iteratedDeriv hcs (N + 1), ?_, ?_⟩
  · intro i hi
    exact integral_pow_mul_iteratedDeriv_eq_zero (N + 1) hsmooth hcs i hi
  · intro ξ hξ1 hξ2
    have hξ0 : ξ ≠ 0 := by
      intro h
      rw [h] at hξ1
      norm_num at hξ1
    rw [fourierBump_iteratedDeriv_eq (N + 1) hsmooth hcs ξ,
      brsFourier_dilate (ψ := χ) hlam ξ]
    refine mul_ne_zero (pow_ne_zero _ ?_) (hFne (ξ / lam) (hlamlt ξ hξ2))
    refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero)
      (Complex.ofReal_ne_zero.mpr hξ0)
    exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero

/-! ## `ℓ²(L^p) ≤ L^p(ℓ²)` for `p ≤ 2`

For `p ≤ 2` Minkowski's integral inequality runs the other way from the
familiar `p ≥ 2` case: the sequence of `L^p` norms is controlled by the `L^p`
norm of the square function.  This is the form of Minkowski needed to sum the
Littlewood--Paley pieces in `k` when `p < 2`, where the `ℓ^p` bound
`Σ_k ‖Δ_k f‖_p^p ≲ ‖f‖_p^p` is false. -/

/-- Minkowski's integral inequality against the counting measure on an
arbitrary countable index type. -/
theorem tsum_lintegral_rpow_le_lintegral_tsum' {ι : Type*} [Countable ι]
    [MeasurableSpace ι] [MeasurableSingletonClass ι] {f : ι → ℝ → ENNReal}
    (hf : ∀ k : ι, Measurable (f k)) {r : ℝ} (hr : 1 ≤ r)
    (hfin : (∑' k : ι, (∫⁻ x : ℝ, f k x) ^ r) ≠ ⊤) :
    (∑' k : ι, (∫⁻ x : ℝ, f k x) ^ r) ^ (1 / r) ≤
      ∫⁻ x : ℝ, (∑' k : ι, f k x ^ r) ^ (1 / r) := by
  have hFmeas : Measurable (Function.uncurry f) := by
    refine measurable_from_prod_countable_right fun k => ?_
    exact hf k
  have hleft : (∫⁻ k : ι, (∫⁻ x : ℝ, f k x) ^ r ∂Measure.count) =
      ∑' k : ι, (∫⁻ x : ℝ, f k x) ^ r := lintegral_count _
  have hright : (∫⁻ x : ℝ,
      (∫⁻ k : ι, f k x ^ r ∂Measure.count) ^ (1 / r)) =
      ∫⁻ x : ℝ, (∑' k : ι, f k x ^ r) ^ (1 / r) := by
    refine lintegral_congr fun x => ?_
    congr 1
    exact lintegral_count _
  have hfin' : (∫⁻ k : ι, (∫⁻ x : ℝ, f k x) ^ r ∂Measure.count) ≠ ⊤ := by
    rw [hleft]
    exact hfin
  have h := lintegral_rpow_lintegral_le (μ := (Measure.count : Measure ι))
    (ν := (volume : Measure ℝ)) hr hFmeas hfin'
  rwa [hleft, hright] at h

/-- **`ℓ²(L^p) ≤ L^p(ℓ²)` for `0 < p ≤ 2`.** -/
theorem tsum_lintegral_rpow_le_lintegral_sq {ι : Type*} [Countable ι]
    [MeasurableSpace ι] [MeasurableSingletonClass ι] {f : ι → ℝ → ENNReal}
    (hf : ∀ k : ι, Measurable (f k)) {p : ℝ} (hp : 0 < p) (hp2 : p ≤ 2)
    (hfin : (∑' k : ι, (∫⁻ x : ℝ, f k x ^ p) ^ (2 / p)) ≠ ⊤) :
    (∑' k : ι, (∫⁻ x : ℝ, f k x ^ p) ^ (2 / p)) ^ (p / 2) ≤
      (∫⁻ x : ℝ, (∑' k : ι, f k x ^ (2 : ℝ)) ^ (p / 2)) := by
  have hu : (1 : ℝ) ≤ 2 / p := (one_le_div hp).mpr hp2
  have hinv : 1 / (2 / p) = p / 2 := by
    rw [one_div_div]
  have hmeas : ∀ k : ι, Measurable fun x : ℝ => f k x ^ p := fun k =>
    (hf k).pow_const p
  have h := tsum_lintegral_rpow_le_lintegral_tsum'
    (f := fun k => fun x : ℝ => f k x ^ p) hmeas hu hfin
  rw [hinv] at h
  refine le_trans h (le_of_eq (lintegral_congr fun x => ?_))
  congr 1
  refine tsum_congr fun k => ?_
  rw [← ENNReal.rpow_mul]
  congr 1
  field_simp

/-! ## Integrability of the square function at exponents below two

For `p ≤ 2` the power `S^{p/2}` of the dyadic square function is dominated by
the plain sum `Σ_k ‖Δ_k f‖^p`, because `t ↦ t^{p/2}` is subadditive.  That is a
simpler majorant than the one needed for `p ≥ 2`. -/

/-- Subadditivity of `t ↦ t^s` on finite sums, for `0 < s ≤ 1`. -/
theorem real_finset_rpow_sum_le_sum_rpow {ι : Type*} (s : Finset ι) {b : ι → ℝ}
    (hb : ∀ i, 0 ≤ b i) {t : ℝ} (ht0 : 0 < t) (ht : t ≤ 1) :
    (∑ i ∈ s, b i) ^ t ≤ ∑ i ∈ s, b i ^ t := by
  classical
  refine Finset.induction_on s ?_ ?_
  · simp [Real.zero_rpow ht0.ne']
  · intro x s hx ih
    rw [Finset.sum_insert hx, Finset.sum_insert hx]
    refine le_trans (Real.rpow_add_le_add_rpow (hb x)
      (Finset.sum_nonneg fun i _ => hb i) ht0.le ht) ?_
    exact add_le_add le_rfl ih

/-- Integrability of the `p/2`-power of the dyadic square function, `p ≤ 2`. -/
theorem integrable_squareEnergy_rpow_le_two {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (K : Finset ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p) (hp2 : p ≤ 2) :
    Integrable (fun x : Euclidean d =>
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x ^ (p / 2))
      volume := by
  set Δ : ℤ → Euclidean d → ℂ := fun k =>
    Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f with hΔ
  have hcont : ∀ k : ℤ, Continuous (Δ k) := by
    intro k
    have h : Continuous (brsDyadicSchwartz C k f) :=
      (brsDyadicSchwartz C k f).continuous
    refine h.congr fun x => ?_
    rw [hΔ]
    exact brsDyadicSchwartz_apply C k f x
  have hmajint : Integrable (fun x : Euclidean d => ∑ k ∈ K, ‖Δ k x‖ ^ p)
      volume :=
    integrable_finsetSum K fun k _ =>
      integrable_norm_rpow_integerDyadicProjection C k f hp
  have hmeas : AEStronglyMeasurable (fun x : Euclidean d =>
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x ^ (p / 2))
      volume := by
    refine Continuous.aestronglyMeasurable ?_
    refine Continuous.rpow_const ?_ (fun _ => Or.inr (by positivity))
    refine continuous_finsetSum K fun k _ => ?_
    exact ((hcont k).norm).pow 2
  refine hmajint.mono' hmeas ?_
  filter_upwards with x
  have hsq : Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x =
      ∑ k ∈ K, ‖Δ k x‖ ^ (2 : ℕ) := rfl
  have hnn : (0 : ℝ) ≤
      Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x := by
    rw [hsq]
    exact Finset.sum_nonneg fun k _ => by positivity
  rw [Real.norm_of_nonneg (Real.rpow_nonneg hnn _), hsq]
  refine le_trans (real_finset_rpow_sum_le_sum_rpow K
    (fun k => (by positivity : (0 : ℝ) ≤ ‖Δ k x‖ ^ (2 : ℕ)))
    (by positivity) (by linarith)) ?_
  refine le_of_eq (Finset.sum_congr rfl fun k _ => ?_)
  rw [← Real.rpow_natCast ‖Δ k x‖ 2, ← Real.rpow_mul (norm_nonneg _)]
  congr 1
  push_cast
  ring

/-! ## The square-function bound on the line, in `ENNReal`

The BRS chain runs entirely in `ENNReal`, so the Littlewood--Paley bound is
restated there, transported to `ℝ` through `brsLineEquiv`.  This is the form of
`littlewoodPaley_of_mikhlin` used to sum the pieces in `k`. -/

theorem integrable_norm_rpow_schwartz {d : ℕ}
    (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p) :
    Integrable (fun x : Euclidean d => ‖f x‖ ^ p) volume := by
  have hmem := f.memLp (ENNReal.ofReal p) (volume : Measure (Euclidean d))
  have hne : ENNReal.ofReal p ≠ 0 := by
    simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
    exact hp
  have h := hmem.integrable_norm_rpow hne ENNReal.ofReal_ne_top
  rwa [ENNReal.toReal_ofReal hp.le] at h

/-- The square function, as an `ENNReal` sum. -/
theorem enorm_squareEnergy_eq {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (K : Finset ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) (x : Euclidean d) :
    (∑ k ∈ K, ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ₑ ^
        (2 : ℝ)) =
      ENNReal.ofReal
        (Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x) := by
  have hsq : Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x =
      ∑ k ∈ K,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^
          (2 : ℕ) := rfl
  rw [hsq, ENNReal.ofReal_sum_of_nonneg (fun k _ => by positivity)]
  refine Finset.sum_congr rfl fun k _ => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _)
    (by norm_num : (0 : ℝ) ≤ 2), ← Real.rpow_natCast
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ 2]
  norm_num

/-- **The Littlewood--Paley square-function bound on the line, in `ENNReal`.** -/
theorem lintegral_squareEnergy_rpow_le_line
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {p : ℝ} (hp : 1 < p) (hp2 : p ≤ 2) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean 1) ℂ),
      (∫⁻ y : ℝ, (∑ k ∈ K,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ (2 : ℝ)) ^ (p / 2)) ≤
        A * ∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨A, hA, hLP⟩ := Auto.MikhlinHormander.littlewoodPaley_of_mikhlin C p hp
  refine ⟨ENNReal.ofReal A, ENNReal.ofReal_ne_top, fun K f => ?_⟩
  set S : Euclidean 1 → ℝ := fun x =>
    Auto.LittlewoodPaley.finiteIntegerDyadicSquareEnergy C K f x with hS
  have hSnn : ∀ x : Euclidean 1, 0 ≤ S x := by
    intro x
    exact Finset.sum_nonneg fun k _ => by positivity
  have hSint : Integrable (fun x : Euclidean 1 => S x ^ (p / 2)) volume :=
    integrable_squareEnergy_rpow_le_two C K f hp0 hp2
  have hfint : Integrable (fun x : Euclidean 1 => ‖f x‖ ^ p) volume :=
    integrable_norm_rpow_schwartz f hp0
  -- the left side, transported to `Euclidean 1` and to a Bochner integral
  have hleft : (∫⁻ y : ℝ, (∑ k ∈ K,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
        (brsLineEquiv.symm y)‖ₑ ^ (2 : ℝ)) ^ (p / 2)) =
      ENNReal.ofReal (∫ x : Euclidean 1, S x ^ (p / 2)) := by
    rw [lintegral_brsLineEquiv_symm (fun x : Euclidean 1 =>
      (∑ k ∈ K,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ₑ ^
          (2 : ℝ)) ^ (p / 2))]
    rw [ofReal_integral_eq_lintegral_ofReal hSint
      (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (hSnn x) _)]
    refine lintegral_congr fun x => ?_
    rw [enorm_squareEnergy_eq C K f x,
      ENNReal.ofReal_rpow_of_nonneg (hSnn x) (by positivity)]
  -- the right side
  have hright : (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) =
      ENNReal.ofReal (∫ x : Euclidean 1, ‖f x‖ ^ p) := by
    rw [lintegral_brsLineEquiv_symm (fun x : Euclidean 1 => ‖f x‖ₑ ^ p)]
    rw [ofReal_integral_eq_lintegral_ofReal hfint
      (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) _)]
    refine lintegral_congr fun x => ?_
    rw [← ofReal_norm,
      ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp0.le]
  rw [hleft, hright, ← ENNReal.ofReal_mul hA.le]
  exact ENNReal.ofReal_le_ofReal (hLP K f)

/-! ## Summing the dyadic pieces in `ℓ²`, for `1 < p ≤ 2`

Minkowski's inequality in the direction valid below exponent two turns the
square-function bound into an `ℓ²`-summability statement for the `L^p` norms of
the dyadic pieces.  This is the substitute, for `p < 2`, of the `ℓ^p` bound
`sum_integral_norm_rpow_dyadic_le_line`, which is false there. -/

theorem continuous_integerDyadicProjection {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (k : ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) :
    Continuous
      (Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f) := by
  refine (brsDyadicSchwartz C k f).continuous.congr fun x => ?_
  exact brsDyadicSchwartz_apply C k f x

theorem lintegral_enorm_rpow_dyadic_ne_top {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (k : ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) {p : ℝ} (hp : 0 < p) :
    (∫⁻ x : Euclidean d,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ₑ ^ p) ≠
      ⊤ := by
  have h := (integrable_norm_rpow_integerDyadicProjection C k f hp).hasFiniteIntegral
  have hcong : (∫⁻ x : Euclidean d,
      ‖(‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^
        p : ℝ)‖ₑ) =
      ∫⁻ x : Euclidean d,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ₑ ^ p := by
    refine lintegral_congr fun x => ?_
    rw [Real.enorm_eq_ofReal (Real.rpow_nonneg (norm_nonneg _) _),
      ← ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le, ofReal_norm]
  rw [MeasureTheory.hasFiniteIntegral_iff_enorm, hcong] at h
  exact h.ne

/-- **`ℓ²`-summability of the `L^p` norms of the dyadic pieces, `1 < p ≤ 2`.** -/
theorem sum_lintegral_rpow_dyadic_sq_le_line
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {p : ℝ} (hp : 1 < p) (hp2 : p ≤ 2) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean 1) ℂ),
      (∑ k ∈ K, (∫⁻ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ p) ^ (2 / p)) ^ (p / 2) ≤
        A * ∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p := by
  classical
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have h2p : (0 : ℝ) < 2 / p := by positivity
  obtain ⟨A, hA, hLP⟩ := lintegral_squareEnergy_rpow_le_line C hp hp2
  refine ⟨A, hA, fun K f => ?_⟩
  set Δ : ℤ → ℝ → ENNReal := fun k y =>
    ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
      (brsLineEquiv.symm y)‖ₑ with hΔ
  have hΔmeas : ∀ k : ℤ, Measurable (Δ k) := by
    intro k
    exact (((continuous_integerDyadicProjection C k f).measurable.comp
      brsLineEquiv.symm.measurable)).enorm
  have hΔtop : ∀ k : ℤ, (∫⁻ y : ℝ, Δ k y ^ p) ≠ ⊤ := by
    intro k
    rw [hΔ]
    change (∫⁻ y : ℝ,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
        (brsLineEquiv.symm y)‖ₑ ^ p) ≠ ⊤
    rw [lintegral_brsLineEquiv_symm (fun x : Euclidean 1 =>
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ₑ ^ p)]
    exact lintegral_enorm_rpow_dyadic_ne_top C k f hp0
  -- the truncated family
  set g : ℤ → ℝ → ENNReal := fun k y => if k ∈ K then Δ k y else 0 with hg
  have hgmeas : ∀ k : ℤ, Measurable (g k) := by
    intro k
    rw [hg]
    by_cases hk : k ∈ K
    · simpa [hk] using hΔmeas k
    · simp only [hk, if_false]
      exact measurable_const
  have hzero : ∀ k : ℤ, k ∉ K → (∫⁻ y : ℝ, g k y ^ p) ^ (2 / p) = 0 := by
    intro k hk
    have : (∫⁻ y : ℝ, g k y ^ p) = 0 := by
      rw [hg]
      simp [hk, ENNReal.zero_rpow_of_pos hp0]
    rw [this, ENNReal.zero_rpow_of_pos h2p]
  have hsum : (∑' k : ℤ, (∫⁻ y : ℝ, g k y ^ p) ^ (2 / p)) =
      ∑ k ∈ K, (∫⁻ y : ℝ, Δ k y ^ p) ^ (2 / p) := by
    rw [tsum_eq_sum (s := K) hzero]
    refine Finset.sum_congr rfl fun k hk => ?_
    congr 1
    refine lintegral_congr fun y => ?_
    rw [hg]
    simp [hk]
  have hfin : (∑' k : ℤ, (∫⁻ y : ℝ, g k y ^ p) ^ (2 / p)) ≠ ⊤ := by
    rw [hsum]
    refine ENNReal.sum_ne_top.mpr fun k _ => ?_
    exact ENNReal.rpow_ne_top_of_nonneg h2p.le (hΔtop k)
  have hmink := tsum_lintegral_rpow_le_lintegral_sq hgmeas hp0 hp2 hfin
  rw [hsum] at hmink
  refine le_trans hmink (le_trans (le_of_eq (lintegral_congr fun y => ?_))
    (hLP K f))
  congr 1
  rw [tsum_eq_sum (s := K) (fun k hk => by rw [hg]; simp [hk,
    ENNReal.zero_rpow_of_pos (by norm_num : (0 : ℝ) < 2)])]
  refine Finset.sum_congr rfl fun k hk => ?_
  rw [hg, hΔ]
  simp [hk]

/-! ## The `ℓ^p` square-function bound on the line, in `ENNReal`

The companion of `sum_lintegral_rpow_dyadic_sq_le_line` above exponent two. -/

/-- A Bochner `L^p` integral on `Euclidean 1`, as a lower integral on `ℝ`. -/
theorem lintegral_enorm_rpow_symm_eq {F : Euclidean 1 → ℂ} {p : ℝ} (hp : 0 < p)
    (hint : Integrable (fun x : Euclidean 1 => ‖F x‖ ^ p) volume) :
    (∫⁻ y : ℝ, ‖F (brsLineEquiv.symm y)‖ₑ ^ p) =
      ENNReal.ofReal (∫ x : Euclidean 1, ‖F x‖ ^ p) := by
  rw [lintegral_brsLineEquiv_symm (fun x : Euclidean 1 => ‖F x‖ₑ ^ p),
    ofReal_integral_eq_lintegral_ofReal hint
      (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) _)]
  refine lintegral_congr fun x => ?_
  rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hp.le]

/-- **`ℓ^p`-summability of the `L^p` norms of the dyadic pieces, `p ≥ 2`.** -/
theorem sum_lintegral_rpow_dyadic_le_line
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {p : ℝ} (hp : 2 ≤ p) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean 1) ℂ),
      (∑ k ∈ K, ∫⁻ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ p) ≤
        A * ∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := by linarith
  obtain ⟨A, hA, hLP⟩ := sum_integral_norm_rpow_dyadic_le C hp
  refine ⟨ENNReal.ofReal A, ENNReal.ofReal_ne_top, fun K f => ?_⟩
  have hleft : (∑ k ∈ K, ∫⁻ y : ℝ,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
        (brsLineEquiv.symm y)‖ₑ ^ p) =
      ENNReal.ofReal (∑ k ∈ K, ∫ x : Euclidean 1,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f x‖ ^ p) := by
    rw [ENNReal.ofReal_sum_of_nonneg]
    · refine Finset.sum_congr rfl fun k _ => ?_
      exact lintegral_enorm_rpow_symm_eq hp0
        (integrable_norm_rpow_integerDyadicProjection C k f hp0)
    · intro k _
      exact integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) _
  rw [hleft, lintegral_enorm_rpow_symm_eq hp0 (integrable_norm_rpow_schwartz f hp0),
    ← ENNReal.ofReal_mul hA.le]
  exact ENNReal.ofReal_le_ofReal (hLP K f)

/-! ## The `ℓ^q` form used to close the `k`-sum

For `q ≥ 2` and `q ≥ p` the `L^p` norms of the dyadic pieces are `ℓ^q`-summable,
whichever side of `2` the exponent `p` lies on.  Below `2` the bridge is the
square function; above `2` it is the `ℓ^p` bound. -/

/-- **`ℓ^q`-summability of the `L^p` norms of the dyadic pieces.** -/
theorem sum_lintegral_rpow_dyadic_lq_le_line
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q)
    (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (K : Finset ℤ) (f : SchwartzMap (Euclidean 1) ℂ),
      (∑ k ∈ K, (∫⁻ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p)) ≤
        A * (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  rcases le_or_gt p 2 with hp2 | hp2
  · -- below exponent two: through the square function
    obtain ⟨A, hA, hLP⟩ := sum_lintegral_rpow_dyadic_sq_le_line C hp hp2
    refine ⟨A ^ (q / p), ENNReal.rpow_ne_top_of_nonneg (by positivity) hA,
      fun K f => ?_⟩
    set a : ℤ → ENNReal := fun k =>
      (∫⁻ y : ℝ,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
          (brsLineEquiv.symm y)‖ₑ ^ p) ^ (2 / p) with ha
    have hstep : (∑ k ∈ K, a k) ≤ A ^ (2 / p) *
        (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) ^ (2 / p) := by
      have h := hLP K f
      have hmono := ENNReal.rpow_le_rpow h (by positivity : (0 : ℝ) ≤ 2 / p)
      rw [← ENNReal.rpow_mul, show p / 2 * (2 / p) = 1 from by field_simp,
        ENNReal.rpow_one, ENNReal.mul_rpow_of_nonneg _ _ (by positivity)] at hmono
      exact hmono
    calc (∑ k ∈ K, (∫⁻ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p))
        = ∑ k ∈ K, a k ^ (q / 2) := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [ha, ← ENNReal.rpow_mul]
          congr 1
          field_simp
      _ ≤ (∑ k ∈ K, a k) ^ (q / 2) :=
          finset_sum_rpow_le_rpow_sum K a (by linarith)
      _ ≤ (A ^ (2 / p) *
            (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) ^ (2 / p)) ^ (q / 2) :=
          ENNReal.rpow_le_rpow hstep (by linarith)
      _ = A ^ (q / p) *
            (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ (by linarith : (0 : ℝ) ≤ q / 2),
            ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
            show 2 / p * (q / 2) = q / p from by field_simp]
  · -- above exponent two: through the `ℓ^p` bound
    obtain ⟨A, hA, hLP⟩ := sum_lintegral_rpow_dyadic_le_line C hp2.le
    refine ⟨A ^ (q / p), ENNReal.rpow_ne_top_of_nonneg (by positivity) hA,
      fun K f => ?_⟩
    set b : ℤ → ENNReal := fun k =>
      ∫⁻ y : ℝ,
        ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
          (brsLineEquiv.symm y)‖ₑ ^ p with hb
    calc (∑ k ∈ K, (∫⁻ y : ℝ,
          ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k f
            (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p))
        = ∑ k ∈ K, b k ^ (q / p) := rfl
      _ ≤ (∑ k ∈ K, b k) ^ (q / p) :=
          finset_sum_rpow_le_rpow_sum K b ((one_le_div hp0).mpr hpq)
      _ ≤ (A * (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p)) ^ (q / p) :=
          ENNReal.rpow_le_rpow (hLP K f) (by positivity)
      _ = A ^ (q / p) *
            (∫⁻ y : ℝ, ‖f (brsLineEquiv.symm y)‖ₑ ^ p) ^ (q / p) :=
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity)

/-! ## The bump of (5.9), with a non-vanishing Fourier transform

`brs_5_9_near_covering_local` needs a bump supported in the unit ball whose
moments *and* whose derivative's moments vanish to order `N`.  The
non-vanishing construction above supplies all of that: it is an iterated
derivative of a dilate of a `ContDiffBump`, so shrinking the dilation parameter
puts the support inside the unit ball, and one more derivative is again an
iterated derivative of the same function. -/

theorem tsupport_iteratedDeriv_subset {ψ : ℝ → ℝ} (n : ℕ) :
    tsupport (iteratedDeriv n ψ) ⊆ tsupport ψ := by
  induction n with
  | zero =>
      rw [iteratedDeriv_zero]
  | succ m ih =>
      rw [iteratedDeriv_succ]
      exact le_trans tsupport_deriv_subset ih

/-- **The bump required by (5.9), with `𝓕υ` non-vanishing on the annulus.** -/
theorem exists_brsBumpNonvanishing_unitBall (N : ℕ) :
    ∃ υ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      ∀ ξ : ℝ, 1 / 2 ≤ |ξ| → |ξ| ≤ 2 →
        (∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
              (υ y : ℂ)) ≠ 0 := by
  obtain ⟨χ, hχ, hχcs, hχint⟩ := exists_brsBumpBase
  have hFcont : Continuous (fun η : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) := continuous_brsFourier hχ.continuous hχcs
  have hF0 : (∫ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
        (y : ℂ))) * (χ y : ℂ)) = 1 := by
    rw [brsFourier_zero χ, hχint]
    norm_num
  obtain ⟨δ, hδ, hball⟩ :=
    Metric.continuousAt_iff.mp (hFcont.continuousAt (x := (0 : ℝ))) 1 one_pos
  have hδ0 : δ ≠ 0 := ne_of_gt hδ
  have hFne : ∀ η : ℝ, |η| < δ →
      (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) ≠ 0 := by
    intro η hη hzero
    have hd : dist η (0 : ℝ) < δ := by
      rwa [Real.dist_eq, sub_zero]
    have hb : dist
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
            (χ y : ℂ))
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
            (y : ℂ))) * (χ y : ℂ)) < 1 := hball hd
    rw [hzero, hF0, dist_eq_norm] at hb
    norm_num at hb
  -- the support of the base bump
  obtain ⟨R, hRpos, hRzero, -⟩ := exists_radius_of_hasCompactSupport hχcs
  obtain ⟨lam, hlam, hlamlt, hlamR⟩ :
      ∃ lam : ℝ, 0 < lam ∧ (∀ ξ : ℝ, |ξ| ≤ 2 → |ξ / lam| < δ) ∧ R ≤ lam := by
    refine ⟨max (4 / δ) R, lt_of_lt_of_le (by positivity) (le_max_left _ _),
      fun ξ hξ => ?_, le_max_right _ _⟩
    have hpos : (0 : ℝ) < max (4 / δ) R :=
      lt_of_lt_of_le (by positivity) (le_max_left _ _)
    have hge : 4 / δ ≤ max (4 / δ) R := le_max_left _ _
    rw [abs_div, abs_of_pos hpos]
    have hd : (0 : ℝ) < 4 / δ := by positivity
    have hstep : |ξ| / max (4 / δ) R ≤ 2 / (4 / δ) := by
      calc |ξ| / max (4 / δ) R ≤ 2 / max (4 / δ) R := by gcongr
        _ ≤ 2 / (4 / δ) := by gcongr
    have h2 : 2 / (4 / δ) = δ / 2 := by
      field_simp
      norm_num
    rw [h2] at hstep
    linarith
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => lam * χ (lam * y)) :=
    contDiff_const.mul (hχ.comp (contDiff_const.mul contDiff_id))
  have hcs : HasCompactSupport (fun y : ℝ => lam * χ (lam * y)) :=
    (hχcs.comp_homeomorph (Homeomorph.mulLeft₀ lam hlam.ne')).mul_left
  have hball1 : tsupport (fun y : ℝ => lam * χ (lam * y)) ⊆
      Metric.closedBall 0 1 := by
    refine tsupport_subset_closedBall_of_vanishing fun y hy => ?_
    have habs : R ≤ |lam * y| := by
      rw [abs_mul, abs_of_pos hlam]
      nlinarith [abs_nonneg y]
    change lam * χ (lam * y) = 0
    rw [hRzero _ habs, mul_zero]
  refine ⟨iteratedDeriv (N + 1) (fun y : ℝ => lam * χ (lam * y)),
    contDiff_iteratedDeriv_of_top hsmooth (N + 1),
    hasCompactSupport_iteratedDeriv hcs (N + 1),
    le_trans (tsupport_iteratedDeriv_subset (N + 1)) hball1, ?_, ?_, ?_⟩
  · intro i hi
    exact integral_pow_mul_iteratedDeriv_eq_zero (N + 1) hsmooth hcs i hi
  · intro i hi
    have h2 := integral_pow_mul_iteratedDeriv_eq_zero (N + 1 + 1) hsmooth hcs i
      (by omega)
    rw [iteratedDeriv_succ] at h2
    exact h2
  · intro ξ hξ1 hξ2
    have hξ0 : ξ ≠ 0 := by
      intro h
      rw [h] at hξ1
      norm_num at hξ1
    rw [fourierBump_iteratedDeriv_eq (N + 1) hsmooth hcs ξ,
      brsFourier_dilate (ψ := χ) hlam ξ]
    refine mul_ne_zero (pow_ne_zero _ ?_) (hFne (ξ / lam) (hlamlt ξ hξ2))
    refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero)
      (Complex.ofReal_ne_zero.mpr hξ0)
    exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero

/-! ## The Fourier transform of a bump, on any ball

Two upgrades of the non-vanishing bump.  First, `𝓕υ` is smooth — it is the
Fourier transform of a Schwartz function, so it is Schwartz.  Second, the
non-vanishing range is a parameter: the dilation `λ` is chosen from the ball
radius, so `𝓕υ` can be made non-zero on `0 < |ξ| ≤ B` for any `B`. -/

open scoped FourierTransform in
/-- The Fourier transform of a compactly supported smooth function is smooth. -/
theorem contDiff_brsFourierHat {υ : ℝ → ℝ} (hυ : ContDiff ℝ (⊤ : ℕ∞) υ)
    (hcs : HasCompactSupport υ) :
    ContDiff ℝ (⊤ : ℕ∞) (fun ξ : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
          (υ y : ℂ)) := by
  have h1 : HasCompactSupport (fun y : ℝ => (υ y : ℂ)) :=
    hcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  have h2 : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => (υ y : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp hυ
  have h3 : ContDiff ℝ (⊤ : ℕ∞)
      ((SchwartzMap.fourierTransformCLM ℂ (h1.toSchwartzMap h2)) : ℝ → ℂ) :=
    (SchwartzMap.fourierTransformCLM ℂ (h1.toSchwartzMap h2)).smooth _
  have h4 : ((SchwartzMap.fourierTransformCLM ℂ (h1.toSchwartzMap h2)) :
      ℝ → ℂ) = 𝓕 (fun y : ℝ => (υ y : ℂ)) := by
    rw [SchwartzMap.fourierTransformCLM_apply]
    rfl
  rw [h4] at h3
  have heq : (fun ξ : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
          (υ y : ℂ)) = 𝓕 (fun y : ℝ => (υ y : ℂ)) := by
    funext ξ
    exact brsFourier_eq υ ξ
  rw [heq]
  exact h3

/-- **The bump of (5.9) with `𝓕υ` non-vanishing on a ball of any radius.** -/
theorem exists_brsBump_fourier_ne_zero (N : ℕ) (B : ℝ) :
    ∃ υ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      ∀ ξ : ℝ, ξ ≠ 0 → |ξ| ≤ B →
        (∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
              (υ y : ℂ)) ≠ 0 := by
  obtain ⟨χ, hχ, hχcs, hχint⟩ := exists_brsBumpBase
  have hFcont : Continuous (fun η : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) := continuous_brsFourier hχ.continuous hχcs
  have hF0 : (∫ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
        (y : ℂ))) * (χ y : ℂ)) = 1 := by
    rw [brsFourier_zero χ, hχint]
    norm_num
  obtain ⟨δ, hδ, hball⟩ :=
    Metric.continuousAt_iff.mp (hFcont.continuousAt (x := (0 : ℝ))) 1 one_pos
  have hδ0 : δ ≠ 0 := ne_of_gt hδ
  have hFne : ∀ η : ℝ, |η| < δ →
      (∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
          (χ y : ℂ)) ≠ 0 := by
    intro η hη hzero
    have hd : dist η (0 : ℝ) < δ := by
      rwa [Real.dist_eq, sub_zero]
    have hb : dist
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (η : ℂ) * (y : ℂ))) *
            (χ y : ℂ))
        (∫ y : ℝ,
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * ((0 : ℝ) : ℂ) *
            (y : ℂ))) * (χ y : ℂ)) < 1 := hball hd
    rw [hzero, hF0, dist_eq_norm] at hb
    norm_num at hb
  obtain ⟨R, hRpos, hRzero, -⟩ := exists_radius_of_hasCompactSupport hχcs
  set B' : ℝ := max B 1 with hB'
  have hB'pos : (0 : ℝ) < B' := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  obtain ⟨lam, hlam, hlamlt, hlamR⟩ :
      ∃ lam : ℝ, 0 < lam ∧ (∀ ξ : ℝ, |ξ| ≤ B → |ξ / lam| < δ) ∧ R ≤ lam := by
    refine ⟨max (2 * B' / δ) (R + 1),
      lt_of_lt_of_le (by positivity) (le_max_left _ _), fun ξ hξ => ?_,
      le_trans (by linarith) (le_max_right _ _)⟩
    have hpos : (0 : ℝ) < max (2 * B' / δ) (R + 1) :=
      lt_of_lt_of_le (by positivity) (le_max_left _ _)
    have hge : 2 * B' / δ ≤ max (2 * B' / δ) (R + 1) := le_max_left _ _
    have hd : (0 : ℝ) < 2 * B' / δ := by positivity
    have hξB : |ξ| ≤ B' := le_trans hξ (le_max_left _ _)
    rw [abs_div, abs_of_pos hpos]
    have hstep : |ξ| / max (2 * B' / δ) (R + 1) ≤ B' / (2 * B' / δ) := by
      calc |ξ| / max (2 * B' / δ) (R + 1) ≤ B' / max (2 * B' / δ) (R + 1) := by
            gcongr
        _ ≤ B' / (2 * B' / δ) := by gcongr
    have h2 : B' / (2 * B' / δ) = δ / 2 := by
      field_simp
    rw [h2] at hstep
    linarith
  have hsmooth : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => lam * χ (lam * y)) :=
    contDiff_const.mul (hχ.comp (contDiff_const.mul contDiff_id))
  have hcs : HasCompactSupport (fun y : ℝ => lam * χ (lam * y)) :=
    (hχcs.comp_homeomorph (Homeomorph.mulLeft₀ lam hlam.ne')).mul_left
  have hball1 : tsupport (fun y : ℝ => lam * χ (lam * y)) ⊆
      Metric.closedBall 0 1 := by
    refine tsupport_subset_closedBall_of_vanishing fun y hy => ?_
    have habs : R ≤ |lam * y| := by
      rw [abs_mul, abs_of_pos hlam]
      nlinarith [abs_nonneg y]
    change lam * χ (lam * y) = 0
    rw [hRzero _ habs, mul_zero]
  refine ⟨iteratedDeriv (N + 1) (fun y : ℝ => lam * χ (lam * y)),
    contDiff_iteratedDeriv_of_top hsmooth (N + 1),
    hasCompactSupport_iteratedDeriv hcs (N + 1),
    le_trans (tsupport_iteratedDeriv_subset (N + 1)) hball1, ?_, ?_, ?_⟩
  · intro i hi
    exact integral_pow_mul_iteratedDeriv_eq_zero (N + 1) hsmooth hcs i hi
  · intro i hi
    have h2 := integral_pow_mul_iteratedDeriv_eq_zero (N + 1 + 1) hsmooth hcs i
      (by omega)
    rw [iteratedDeriv_succ] at h2
    exact h2
  · intro ξ hξ0 hξB
    rw [fourierBump_iteratedDeriv_eq (N + 1) hsmooth hcs ξ,
      brsFourier_dilate (ψ := χ) hlam ξ]
    refine mul_ne_zero (pow_ne_zero _ ?_) (hFne (ξ / lam) (hlamlt ξ hξB))
    refine mul_ne_zero (mul_ne_zero (mul_ne_zero two_ne_zero ?_) Complex.I_ne_zero)
      (Complex.ofReal_ne_zero.mpr hξ0)
    exact Complex.ofReal_ne_zero.mpr Real.pi_ne_zero

/-! ## Smooth division by a factor that vanishes only off the support

The second factor of the BRS resolution is `ψ̂ = θ̂ / υ̂`, and `υ̂` is non-zero
only on an annulus containing the support of `θ̂`.  Naively the quotient is
smooth only there, and gluing it to zero needs an argument.  The following
device avoids the gluing entirely: multiply numerator and denominator by
`conj υ̂`, and interpolate the denominator with `1` through a cutoff `ρ` which
is `1` on the support of `θ̂` and vanishes where `υ̂` might.  The denominator
`|υ̂|²ρ + (1 − ρ)` is then a *strictly positive* smooth real function, so the
quotient is smooth on all of `ℝ`, and the identity `υ̂ ψ̂ = θ̂` is untouched. -/

theorem exists_brsSmoothQuotient {θ u : ℝ → ℂ} {ρ : ℝ → ℝ}
    (hθ : ContDiff ℝ (⊤ : ℕ∞) θ) (hu : ContDiff ℝ (⊤ : ℕ∞) u)
    (hρ : ContDiff ℝ (⊤ : ℕ∞) ρ) (hρ0 : ∀ ξ : ℝ, 0 ≤ ρ ξ)
    (hρ1 : ∀ ξ : ℝ, ρ ξ ≤ 1) (hune : ∀ ξ : ℝ, ρ ξ ≠ 0 → u ξ ≠ 0)
    (hone : ∀ ξ : ℝ, θ ξ ≠ 0 → ρ ξ = 1) :
    ∃ w : ℝ → ℂ, ContDiff ℝ (⊤ : ℕ∞) w ∧ (∀ ξ : ℝ, u ξ * w ξ = θ ξ) ∧
      (∀ ξ : ℝ, θ ξ = 0 → w ξ = 0) := by
  set D : ℝ → ℂ := fun ξ =>
    u ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) + (1 - (ρ ξ : ℂ)) with hD
  have hDreal : ∀ ξ : ℝ,
      D ξ = ((Complex.normSq (u ξ) * ρ ξ + (1 - ρ ξ) : ℝ) : ℂ) := by
    intro ξ
    rw [hD]
    change u ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) + (1 - (ρ ξ : ℂ)) = _
    rw [Complex.mul_conj]
    push_cast
    ring
  have hDpos : ∀ ξ : ℝ,
      0 < Complex.normSq (u ξ) * ρ ξ + (1 - ρ ξ) := by
    intro ξ
    by_cases hz : ρ ξ = 0
    · rw [hz]
      norm_num
    · have hpos : 0 < ρ ξ := lt_of_le_of_ne (hρ0 ξ) (Ne.symm hz)
      have hnz : 0 < Complex.normSq (u ξ) :=
        Complex.normSq_pos.mpr (hune ξ hz)
      have h1 : 0 ≤ 1 - ρ ξ := by linarith [hρ1 ξ]
      nlinarith
  have hDne : ∀ ξ : ℝ, D ξ ≠ 0 := by
    intro ξ
    rw [hDreal ξ]
    exact Complex.ofReal_ne_zero.mpr (hDpos ξ).ne'
  have hconj : ContDiff ℝ (⊤ : ℕ∞) fun ξ : ℝ => (starRingEnd ℂ) (u ξ) :=
    Complex.conjCLE.contDiff.comp hu
  have hρc : ContDiff ℝ (⊤ : ℕ∞) fun ξ : ℝ => (ρ ξ : ℂ) :=
    Complex.ofRealCLM.contDiff.comp hρ
  have hDsmooth : ContDiff ℝ (⊤ : ℕ∞) D := by
    rw [hD]
    exact ((hu.mul hconj).mul hρc).add (contDiff_const.sub hρc)
  refine ⟨fun ξ => θ ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) / D ξ, ?_, ?_, ?_⟩
  · have hinv : ContDiff ℝ (⊤ : ℕ∞) fun ξ : ℝ => (D ξ)⁻¹ := hDsmooth.inv hDne
    simpa [div_eq_mul_inv] using ((hθ.mul hconj).mul hρc).mul hinv
  · intro ξ
    by_cases hθz : θ ξ = 0
    · change u ξ * (θ ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) / D ξ) = θ ξ
      rw [hθz]
      simp
    · have hr1 : ρ ξ = 1 := hone ξ hθz
      have hrc : (ρ ξ : ℂ) = 1 := by
        rw [hr1]
        norm_num
      have hune' : u ξ ≠ 0 := hune ξ (by rw [hr1]; norm_num)
      have hcne : (starRingEnd ℂ) (u ξ) ≠ 0 := by
        simpa using hune'
      have hDval : D ξ = u ξ * (starRingEnd ℂ) (u ξ) := by
        rw [hD]
        change u ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) + (1 - (ρ ξ : ℂ)) = _
        rw [hrc]
        ring
      change u ξ * (θ ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) / D ξ) = θ ξ
      rw [hDval, hrc, mul_one]
      field_simp
  · intro ξ hθz
    change θ ξ * (starRingEnd ℂ) (u ξ) * (ρ ξ : ℂ) / D ξ = 0
    rw [hθz]
    simp

/-! ## A smooth cutoff for the annulus

The cutoff `ρ` of `exists_brsSmoothQuotient`, for the annulus
`1/2 ≤ |ξ| ≤ 2` carrying the dyadic band: it is `1` there and vanishes outside
`0 < |ξ| ≤ 3`, which is where `𝓕υ` is guaranteed non-zero.  Composing a
`ContDiffBump` with `ξ ↦ ξ²` produces it without any case analysis on the sign
of `ξ`. -/

theorem exists_brsAnnulusCutoff :
    ∃ ρ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ (∀ ξ : ℝ, 0 ≤ ρ ξ) ∧
      (∀ ξ : ℝ, ρ ξ ≤ 1) ∧
      (∀ ξ : ℝ, 1 / 2 ≤ |ξ| → |ξ| ≤ 2 → ρ ξ = 1) ∧
      (∀ ξ : ℝ, ρ ξ ≠ 0 → ξ ≠ 0 ∧ |ξ| ≤ 3) := by
  let b : ContDiffBump (17 / 8 : ℝ) := ⟨15 / 8, 2, by norm_num, by norm_num⟩
  refine ⟨fun ξ : ℝ => b (ξ ^ 2), ?_, ?_, ?_, ?_, ?_⟩
  · exact b.contDiff.comp (contDiff_id.pow 2)
  · intro ξ
    exact ContDiffBump.nonneg' b (ξ ^ 2)
  · intro ξ
    exact ContDiffBump.le_one b
  · intro ξ h1 h2
    refine ContDiffBump.one_of_mem_closedBall b ?_
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    have hlow : (1 : ℝ) / 4 ≤ ξ ^ 2 := by
      rw [hsq]
      nlinarith [abs_nonneg ξ]
    have hhigh : ξ ^ 2 ≤ 4 := by
      rw [hsq]
      nlinarith [abs_nonneg ξ]
    rw [Metric.mem_closedBall, Real.dist_eq]
    change |ξ ^ 2 - 17 / 8| ≤ 15 / 8
    rw [abs_le]
    constructor <;> linarith
  · intro ξ hρ
    have hdist : dist (ξ ^ 2) (17 / 8 : ℝ) < 2 := by
      by_contra hc
      exact hρ (ContDiffBump.zero_of_le_dist b (not_lt.mp hc))
    rw [Real.dist_eq, abs_lt] at hdist
    obtain ⟨hlo, hhi⟩ := hdist
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    constructor
    · intro hz
      rw [hz] at hlo
      norm_num at hlo
    · nlinarith [abs_nonneg ξ, hsq ▸ hhi]

/-! ## The BRS factorization of a dyadic band

Given a band symbol `θ` supported in the annulus `1/2 ≤ |ξ| ≤ 2`, BRS split it
as `θ = 𝓕υ · ψ̂` with `υ` compactly supported in the unit ball and with
vanishing moments — the factor that meets the singular kernel and supplies the
localization of (5.14) — and `ψ̂` supported inside the band, the factor fed to
the square function.  All the ingredients are now in place: a bump whose
Fourier transform does not vanish on `0 < |ξ| ≤ 3`, an annulus cutoff, and the
smooth-division device. -/

/-- **The band factorization `θ = 𝓕υ · ψ̂`.** -/
theorem exists_brsBumpFactorization (N : ℕ) {θ : ℝ → ℂ}
    (hθ : ContDiff ℝ (⊤ : ℕ∞) θ)
    (hθsupp : ∀ ξ : ℝ, θ ξ ≠ 0 → 1 / 2 ≤ |ξ| ∧ |ξ| ≤ 2) :
    ∃ υ : ℝ → ℝ, ∃ w : ℝ → ℂ,
      ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      ContDiff ℝ (⊤ : ℕ∞) w ∧
      (∀ ξ : ℝ, w ξ ≠ 0 → θ ξ ≠ 0) ∧
      ∀ ξ : ℝ,
        (∫ y : ℝ,
            Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
              (υ y : ℂ)) * w ξ = θ ξ := by
  obtain ⟨υ, hυ, hυcs, hυball, hmom, hmom', hne⟩ :=
    exists_brsBump_fourier_ne_zero N 3
  obtain ⟨ρ, hρ, hρ0, hρ1, hρone, hρsupp⟩ := exists_brsAnnulusCutoff
  have husmooth : ContDiff ℝ (⊤ : ℕ∞) (fun ξ : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
          (υ y : ℂ)) := contDiff_brsFourierHat hυ hυcs
  obtain ⟨w, hw, hprod, hzero⟩ :=
    exists_brsSmoothQuotient hθ husmooth hρ hρ0 hρ1
      (fun ξ hξ => hne ξ (hρsupp ξ hξ).1 (hρsupp ξ hξ).2)
      (fun ξ hξ => hρone ξ (hθsupp ξ hξ).1 (hθsupp ξ hξ).2)
  exact ⟨υ, w, hυ, hυcs, hυball, hmom, hmom', hw,
    fun ξ hwξ hθξ => hwξ (hzero ξ hθξ), hprod⟩

/-! ## The second factor is a Schwartz function

`ψ̂` is smooth and supported inside the band, hence Schwartz, and so is its
inverse Fourier transform `ψ`.  That is the form in which the second factor is
fed to the square function. -/

open scoped FourierTransform in
theorem hasCompactSupport_of_support_subset_ball {F : ℝ → ℂ} {R : ℝ}
    (h : ∀ ξ : ℝ, F ξ ≠ 0 → |ξ| ≤ R) : HasCompactSupport F := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) R) ?_
  intro x hx
  by_contra hne
  refine hx ?_
  rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]
  exact h x hne

open scoped FourierTransform in
/-- **The band factorization, with the second factor as a Schwartz map.** -/
theorem exists_brsBandFactorization (N : ℕ) {θ : ℝ → ℂ}
    (hθ : ContDiff ℝ (⊤ : ℕ∞) θ)
    (hθsupp : ∀ ξ : ℝ, θ ξ ≠ 0 → 1 / 2 ≤ |ξ| ∧ |ξ| ≤ 2) :
    ∃ (υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ),
      ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      (∀ ξ : ℝ, 𝓕 (S : ℝ → ℂ) ξ ≠ 0 → θ ξ ≠ 0) ∧
      ∀ ξ : ℝ,
        𝓕 (fun y : ℝ => (υ y : ℂ)) ξ * 𝓕 (S : ℝ → ℂ) ξ = θ ξ := by
  obtain ⟨υ, w, hυ, hυcs, hυball, hmom, hmom', hw, hwsupp, hprod⟩ :=
    exists_brsBumpFactorization N hθ hθsupp
  have hwcs : HasCompactSupport w :=
    hasCompactSupport_of_support_subset_ball
      (fun ξ hξ => (hθsupp ξ (hwsupp ξ hξ)).2)
  set S : SchwartzMap ℝ ℂ := 𝓕⁻ (hwcs.toSchwartzMap hw) with hS
  have hSf : 𝓕 (S : ℝ → ℂ) = w := by
    rw [hS, ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
    rfl
  refine ⟨υ, S, hυ, hυcs, hυball, hmom, hmom', ?_, ?_⟩
  · intro ξ hξ
    rw [hSf] at hξ
    exact hwsupp ξ hξ
  · intro ξ
    rw [hSf, ← brsFourier_eq υ ξ]
    exact hprod ξ

/-! ## The factorization as a convolution

Transporting `θ = 𝓕υ · 𝓕ψ` through the Fourier inversion theorem turns the
factorization of the band symbol into a factorization of the band kernel:
`𝓕⁻θ = υ ∗ ψ`.  This is the identity that lets `brs_5_9_near_covering_local`
— which already takes an arbitrary compactly supported `υ` — be applied with
the Littlewood--Paley piece `ψ ∗ g` in place of `g`. -/

open scoped FourierTransform in
/-- **The band kernel factors as `υ ∗ ψ`.** -/
theorem exists_brsBandConvolution (N : ℕ) {θ : ℝ → ℂ}
    (hθ : ContDiff ℝ (⊤ : ℕ∞) θ)
    (hθsupp : ∀ ξ : ℝ, θ ξ ≠ 0 → 1 / 2 ≤ |ξ| ∧ |ξ| ≤ 2) :
    ∃ (υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ),
      ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (S : ℝ → ℂ)) = 𝓕⁻ θ := by
  obtain ⟨υ, S, hυ, hυcs, hυball, hmom, hmom', -, hprod⟩ :=
    exists_brsBandFactorization N hθ hθsupp
  have hυC : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => (υ y : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp hυ
  have hυcsC : HasCompactSupport (fun y : ℝ => (υ y : ℂ)) :=
    hυcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  set US : SchwartzMap ℝ ℂ := hυcsC.toSchwartzMap hυC with hUS
  have hUSc : (US : ℝ → ℂ) = fun y : ℝ => (υ y : ℂ) := rfl
  set F : SchwartzMap ℝ ℂ :=
    SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) US S with hF
  have hFapp : (F : ℝ → ℂ) =
      ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (S : ℝ → ℂ)) := by
    funext x
    rw [hF]
    exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul ℂ ℂ) US S x
  have hFourier : 𝓕 (F : ℝ → ℂ) = θ := by
    funext ξ
    rw [hFapp]
    rw [Real.fourier_mul_convolution_eq (R := ℂ) (by
        simpa [hUSc] using US.integrable) S.integrable ξ]
    rw [← hUSc]
    exact hprod ξ
  refine ⟨υ, S, hυ, hυcs, hυball, hmom, hmom', ?_⟩
  rw [← hFapp, ← hFourier, ← SchwartzMap.fourier_coe, ← SchwartzMap.fourierInv_coe,
    FourierTransform.fourierInv_fourier_eq]

/-! ## Convolution commutes with the `L¹`-normalized dilation

`(f_λ) ∗ (g_λ) = (f ∗ g)_λ` for `h_λ(x) = λh(λx)`, by a single change of
variables.  This is what turns the factorization `𝓕⁻θ = υ ∗ ψ` of one band into
the factorization of every dyadic band. -/

theorem convolution_mul_apply (F G : ℝ → ℂ) (z : ℝ) :
    (F ⋆[ContinuousLinearMap.mul ℂ ℂ] G) z = ∫ t : ℝ, F t * G (z - t) := rfl

/-- **Convolution commutes with the `L¹`-normalized dilation.** -/
theorem convolution_mul_dilate (f g : ℝ → ℂ) {lam : ℝ} (hlam : 0 < lam)
    (x : ℝ) :
    ((fun y : ℝ => (lam : ℂ) * f (lam * y)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (fun y : ℝ => (lam : ℂ) * g (lam * y))) x =
      (lam : ℂ) * (f ⋆[ContinuousLinearMap.mul ℂ ℂ] g) (lam * x) := by
  have hlamC : (lam : ℂ) ≠ 0 := by
    exact_mod_cast hlam.ne'
  set H : ℝ → ℂ := fun u : ℝ =>
    (lam : ℂ) ^ 2 * (f u * g (lam * x - u)) with hH
  rw [convolution_mul_apply, convolution_mul_apply]
  have hpt : ∀ t : ℝ,
      ((lam : ℂ) * f (lam * t)) * ((lam : ℂ) * g (lam * (x - t))) =
        H (lam * t) := by
    intro t
    rw [hH]
    change ((lam : ℂ) * f (lam * t)) * ((lam : ℂ) * g (lam * (x - t))) =
      (lam : ℂ) ^ 2 * (f (lam * t) * g (lam * x - lam * t))
    rw [show lam * (x - t) = lam * x - lam * t from by ring]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
    Measure.integral_comp_mul_left H lam, hH]
  rw [integral_const_mul, abs_of_pos (inv_pos.mpr hlam), Complex.real_smul]
  push_cast
  field_simp

/-! ## The band factorization on an arbitrary annulus

The resolution profile fixes the annulus carrying the band symbol, and it need
not be `1/2 ≤ |ξ| ≤ 2`: the telescoping profile `p = 𝓕⁻χ` produces
`θ(ξ) = χ(ξ/2) − χ(ξ)`, supported in `1 ≤ |ξ| ≤ 4`.  The construction is
therefore restated with the two radii as parameters. -/

/-- A smooth cutoff which is `1` on the annulus `a ≤ |ξ| ≤ b` and vanishes
outside `0 < |ξ| < 2b`. -/
theorem exists_brsAnnulusCutoff' {a b : ℝ} (ha : 0 < a) (hab : a < b) :
    ∃ ρ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) ρ ∧ (∀ ξ : ℝ, 0 ≤ ρ ξ) ∧
      (∀ ξ : ℝ, ρ ξ ≤ 1) ∧
      (∀ ξ : ℝ, a ≤ |ξ| → |ξ| ≤ b → ρ ξ = 1) ∧
      (∀ ξ : ℝ, ρ ξ ≠ 0 → ξ ≠ 0 ∧ |ξ| ≤ 2 * b) := by
  have hb : 0 < b := lt_trans ha hab
  have hin : (0 : ℝ) < (b ^ 2 - a ^ 2) / 2 := by nlinarith
  have hlt : (b ^ 2 - a ^ 2) / 2 < b ^ 2 / 2 := by nlinarith
  let bp : ContDiffBump ((a ^ 2 + b ^ 2) / 2 : ℝ) :=
    ⟨(b ^ 2 - a ^ 2) / 2, b ^ 2 / 2, hin, hlt⟩
  refine ⟨fun ξ : ℝ => bp (ξ ^ 2), ?_, ?_, ?_, ?_, ?_⟩
  · exact bp.contDiff.comp (contDiff_id.pow 2)
  · intro ξ
    exact ContDiffBump.nonneg' bp (ξ ^ 2)
  · intro ξ
    exact ContDiffBump.le_one bp
  · intro ξ h1 h2
    refine ContDiffBump.one_of_mem_closedBall bp ?_
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    have hlow : a ^ 2 ≤ ξ ^ 2 := by
      rw [hsq]
      nlinarith [abs_nonneg ξ]
    have hhigh : ξ ^ 2 ≤ b ^ 2 := by
      rw [hsq]
      nlinarith [abs_nonneg ξ]
    rw [Metric.mem_closedBall, Real.dist_eq]
    change |ξ ^ 2 - (a ^ 2 + b ^ 2) / 2| ≤ (b ^ 2 - a ^ 2) / 2
    rw [abs_le]
    constructor <;> linarith
  · intro ξ hρ
    have hdist : dist (ξ ^ 2) ((a ^ 2 + b ^ 2) / 2 : ℝ) < b ^ 2 / 2 := by
      by_contra hc
      exact hρ (ContDiffBump.zero_of_le_dist bp (not_lt.mp hc))
    rw [Real.dist_eq, abs_lt] at hdist
    obtain ⟨hlo, hhi⟩ := hdist
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    have hlo' : a ^ 2 / 2 < ξ ^ 2 := by linarith
    constructor
    · intro hz
      rw [hz] at hlo'
      nlinarith
    · have hhi' : |ξ| ^ 2 < a ^ 2 / 2 + b ^ 2 := by
        rw [← hsq]
        linarith
      nlinarith [abs_nonneg ξ]

open scoped FourierTransform in
/-- **The band kernel factors as `υ ∗ ψ`, on an arbitrary annulus.** -/
theorem exists_brsBandConvolution' (N : ℕ) {a b : ℝ} (ha : 0 < a) (hab : a < b)
    {θ : ℝ → ℂ} (hθ : ContDiff ℝ (⊤ : ℕ∞) θ)
    (hθsupp : ∀ ξ : ℝ, θ ξ ≠ 0 → a ≤ |ξ| ∧ |ξ| ≤ b) :
    ∃ (υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ),
      ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      (∀ ξ : ℝ, 𝓕 (S : ℝ → ℂ) ξ ≠ 0 → a ≤ |ξ| ∧ |ξ| ≤ b) ∧
      ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (S : ℝ → ℂ)) = 𝓕⁻ θ := by
  obtain ⟨υ, hυ, hυcs, hυball, hmom, hmom', hne⟩ :=
    exists_brsBump_fourier_ne_zero N (2 * b)
  obtain ⟨ρ, hρ, hρ0, hρ1, hρone, hρsupp⟩ := exists_brsAnnulusCutoff' ha hab
  have husmooth : ContDiff ℝ (⊤ : ℕ∞) (fun ξ : ℝ =>
      ∫ y : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
          (υ y : ℂ)) := contDiff_brsFourierHat hυ hυcs
  obtain ⟨w, hw, hprod, hzero⟩ :=
    exists_brsSmoothQuotient hθ husmooth hρ hρ0 hρ1
      (fun ξ hξ => hne ξ (hρsupp ξ hξ).1 (hρsupp ξ hξ).2)
      (fun ξ hξ => hρone ξ (hθsupp ξ hξ).1 (hθsupp ξ hξ).2)
  have hwsupp : ∀ ξ : ℝ, w ξ ≠ 0 → θ ξ ≠ 0 := fun ξ hwξ hθξ => hwξ (hzero ξ hθξ)
  have hwcs : HasCompactSupport w :=
    hasCompactSupport_of_support_subset_ball
      (fun ξ hξ => (hθsupp ξ (hwsupp ξ hξ)).2)
  set S : SchwartzMap ℝ ℂ := 𝓕⁻ (hwcs.toSchwartzMap hw) with hS
  have hSf : 𝓕 (S : ℝ → ℂ) = w := by
    rw [hS, ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
    rfl
  have hυC : ContDiff ℝ (⊤ : ℕ∞) (fun y : ℝ => (υ y : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp hυ
  have hυcsC : HasCompactSupport (fun y : ℝ => (υ y : ℂ)) :=
    hυcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  set US : SchwartzMap ℝ ℂ := hυcsC.toSchwartzMap hυC with hUS
  have hUSc : (US : ℝ → ℂ) = fun y : ℝ => (υ y : ℂ) := rfl
  set F : SchwartzMap ℝ ℂ :=
    SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) US S with hF
  have hFapp : (F : ℝ → ℂ) =
      ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (S : ℝ → ℂ)) := by
    funext x
    rw [hF]
    exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul ℂ ℂ) US S x
  have hFourier : 𝓕 (F : ℝ → ℂ) = θ := by
    funext ξ
    rw [hFapp]
    rw [Real.fourier_mul_convolution_eq (R := ℂ) (by
        simpa [hUSc] using US.integrable) S.integrable ξ]
    rw [hSf, ← hUSc]
    change 𝓕 (US : ℝ → ℂ) ξ * w ξ = θ ξ
    rw [hUSc, ← brsFourier_eq υ ξ]
    exact hprod ξ
  refine ⟨υ, S, hυ, hυcs, hυball, hmom, hmom',
    fun ξ hξ => hθsupp ξ (hwsupp ξ (by rwa [hSf] at hξ)), ?_⟩
  rw [← hFapp, ← hFourier, ← SchwartzMap.fourier_coe, ← SchwartzMap.fourierInv_coe,
    FourierTransform.fourierInv_fourier_eq]

/-! ## The resolution profile of the Calderón formula

The telescoping resolution of (5.7) with the *Schwartz* profile `p = 𝓕⁻χ`, for
a frequency cutoff `χ` equal to `1` on `|ξ| ≤ 1` and `0` on `|ξ| ≥ 2`, is
exactly the Calderón reproducing formula: `𝓕(p_{j+1} − p_j)(ξ) = θ(2^{-j}ξ)`
with `θ(ξ) = χ(ξ/2) − χ(ξ)` supported in the annulus `1 ≤ |ξ| ≤ 4`.  The
profile is real because `χ` is real and even, and has unit mass because
`∫p = 𝓕p(0) = χ(0) = 1`. -/

open scoped FourierTransform in
theorem fourier_apply_zero (F : ℝ → ℂ) : 𝓕 F 0 = ∫ y : ℝ, F y := by
  rw [Real.fourier_eq']
  simp

theorem integral_comp_neg_real (f : ℝ → ℂ) :
    (∫ x : ℝ, f (-x)) = ∫ x : ℝ, f x := by
  have h := MeasureTheory.Measure.integral_comp_mul_left f (-1)
  simp only [neg_one_mul] at h
  rw [h]
  norm_num

open scoped FourierTransform in
theorem fourierInv_apply' (f : ℝ → ℂ) (x : ℝ) :
    𝓕⁻ f x = ∫ y : ℝ,
      Complex.exp (((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I) * f y := by
  rw [Real.fourierInv_eq']
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change Complex.exp (((2 * Real.pi * (inner ℝ y x : ℝ) : ℝ) : ℂ) * Complex.I) •
    f y = _
  rw [smul_eq_mul, Real.inner_apply]

open scoped FourierTransform in
/-- **The inverse Fourier transform of a real, even function is real.** -/
theorem fourierInv_conj_eq_self {f : ℝ → ℂ}
    (hreal : ∀ ξ : ℝ, (starRingEnd ℂ) (f ξ) = f ξ)
    (heven : ∀ ξ : ℝ, f (-ξ) = f ξ) (x : ℝ) :
    (starRingEnd ℂ) (𝓕⁻ f x) = 𝓕⁻ f x := by
  set G : ℝ → ℂ := fun y : ℝ =>
    Complex.exp (-(((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I)) * f y with hG
  rw [fourierInv_apply' f x, ← integral_conj]
  have h1 : ∀ y : ℝ,
      (starRingEnd ℂ)
        (Complex.exp (((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I) * f y) =
      G y := by
    intro y
    rw [hG]
    change (starRingEnd ℂ)
        (Complex.exp (((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I) * f y) =
      Complex.exp (-(((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I)) * f y
    rw [map_mul, hreal, ← Complex.exp_conj]
    congr 2
    rw [map_mul, Complex.conj_ofReal, Complex.conj_I]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall h1),
    ← integral_comp_neg_real G]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change G (-y) = Complex.exp (((2 * Real.pi * (y * x) : ℝ) : ℂ) * Complex.I) * f y
  rw [hG]
  change Complex.exp (-(((2 * Real.pi * ((-y) * x) : ℝ) : ℂ) * Complex.I)) *
      f (-y) = _
  rw [heven y]
  congr 2
  push_cast
  ring

/-- **A smooth frequency cutoff on `ℝ`.** -/
theorem exists_brsFrequencyCutoff :
    ∃ χ : ℝ → ℝ, ContDiff ℝ (⊤ : ℕ∞) χ ∧ HasCompactSupport χ ∧
      (∀ ξ : ℝ, |ξ| ≤ 1 → χ ξ = 1) ∧ (∀ ξ : ℝ, 2 ≤ |ξ| → χ ξ = 0) ∧
      (∀ ξ : ℝ, χ (-ξ) = χ ξ) := by
  let bp : ContDiffBump (0 : ℝ) := ⟨1, 4, one_pos, by norm_num⟩
  refine ⟨fun ξ : ℝ => bp (ξ ^ 2), bp.contDiff.comp (contDiff_id.pow 2), ?_,
    ?_, ?_, ?_⟩
  · refine HasCompactSupport.intro (isCompact_closedBall (0 : ℝ) 2) ?_
    intro x hx
    have hx2 : 2 < |x| := by
      by_contra hc
      exact hx (by
        rw [Metric.mem_closedBall, Real.dist_eq, sub_zero]
        exact not_lt.mp hc)
    refine ContDiffBump.zero_of_le_dist bp ?_
    rw [Real.dist_eq, sub_zero]
    have hsq : x ^ 2 = |x| ^ 2 := (sq_abs x).symm
    rw [abs_of_nonneg (by positivity : (0 : ℝ) ≤ x ^ 2), hsq]
    nlinarith
  · intro ξ hξ
    refine ContDiffBump.one_of_mem_closedBall bp ?_
    rw [Metric.mem_closedBall, Real.dist_eq, sub_zero,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ξ ^ 2)]
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    rw [hsq]
    nlinarith [abs_nonneg ξ]
  · intro ξ hξ
    refine ContDiffBump.zero_of_le_dist bp ?_
    rw [Real.dist_eq, sub_zero,
      abs_of_nonneg (by positivity : (0 : ℝ) ≤ ξ ^ 2)]
    have hsq : ξ ^ 2 = |ξ| ^ 2 := (sq_abs ξ).symm
    rw [hsq]
    nlinarith
  · intro ξ
    change bp ((-ξ) ^ 2) = bp (ξ ^ 2)
    rw [neg_pow]
    norm_num

/-! ## The Calderón resolution profile

`p := 𝓕⁻χ` for the frequency cutoff `χ` above: a real-valued Schwartz profile
of unit mass whose Fourier transform is the cutoff itself.  Its dilates
telescope exactly as the compactly supported profiles of (5.7) do, but the
consecutive differences now have Fourier transform supported in an annulus,
which is what the band factorization needs. -/

open scoped FourierTransform in
/-- **The resolution profile of the Calderón formula.** -/
theorem exists_brsCalderonProfile :
    ∃ (p χ : ℝ → ℝ) (Cp : ℝ),
      ContDiff ℝ (⊤ : ℕ∞) p ∧ Integrable p volume ∧ (∫ x : ℝ, p x) = 1 ∧
      0 < Cp ∧ (∀ x : ℝ, |p x| ≤ Cp) ∧ (∀ x : ℝ, x ^ 2 * |p x| ≤ Cp) ∧
      ContDiff ℝ (⊤ : ℕ∞) χ ∧
      (∀ ξ : ℝ, |ξ| ≤ 1 → χ ξ = 1) ∧ (∀ ξ : ℝ, 2 ≤ |ξ| → χ ξ = 0) ∧
      ∀ ξ : ℝ, 𝓕 (fun x : ℝ => (p x : ℂ)) ξ = (χ ξ : ℂ) := by
  obtain ⟨χ, hχ, hχcs, hχone, hχzero, hχeven⟩ := exists_brsFrequencyCutoff
  have hχC : ContDiff ℝ (⊤ : ℕ∞) (fun ξ : ℝ => (χ ξ : ℂ)) :=
    Complex.ofRealCLM.contDiff.comp hχ
  have hχcsC : HasCompactSupport (fun ξ : ℝ => (χ ξ : ℂ)) :=
    hχcs.comp_left (g := fun z : ℝ => (z : ℂ)) (by simp)
  set XS : SchwartzMap ℝ ℂ := hχcsC.toSchwartzMap hχC with hXS
  have hXSc : (XS : ℝ → ℂ) = fun ξ : ℝ => (χ ξ : ℂ) := rfl
  set P : SchwartzMap ℝ ℂ := 𝓕⁻ XS with hP
  have hPc : (P : ℝ → ℂ) = 𝓕⁻ (fun ξ : ℝ => (χ ξ : ℂ)) := by
    rw [hP, SchwartzMap.fourierInv_coe, hXSc]
  have hPreal : ∀ x : ℝ, (starRingEnd ℂ) (P x) = P x := by
    intro x
    have h := fourierInv_conj_eq_self
      (f := fun ξ : ℝ => (χ ξ : ℂ))
      (fun ξ => Complex.conj_ofReal (χ ξ))
      (fun ξ => by rw [hχeven ξ]) x
    have hval : (P : ℝ → ℂ) x = 𝓕⁻ (fun ξ : ℝ => (χ ξ : ℂ)) x := by
      rw [hPc]
    rw [hval]
    exact h
  set p : ℝ → ℝ := fun x => (P x).re with hp
  have hpc : ∀ x : ℝ, ((p x : ℝ) : ℂ) = P x := by
    intro x
    change (((P x).re : ℝ) : ℂ) = P x
    exact Complex.conj_eq_iff_re.mp (hPreal x)
  have hPsmooth : ContDiff ℝ (⊤ : ℕ∞) (P : ℝ → ℂ) := P.smooth _
  obtain ⟨C0, hC0, hbd0⟩ := P.decay 0 0
  obtain ⟨C2, hC2, hbd2⟩ := P.decay 2 0
  have hdec0 : ∀ x : ℝ, |p x| ≤ max C0 C2 := by
    intro x
    have h := hbd0 x
    rw [norm_iteratedFDeriv_zero] at h
    simp only [pow_zero, one_mul] at h
    exact le_trans (le_trans (Complex.abs_re_le_norm (P x)) h) (le_max_left _ _)
  have hdec2 : ∀ x : ℝ, x ^ 2 * |p x| ≤ max C0 C2 := by
    intro x
    have h := hbd2 x
    rw [norm_iteratedFDeriv_zero, Real.norm_eq_abs, sq_abs] at h
    exact le_trans (le_trans (mul_le_mul_of_nonneg_left
      (Complex.abs_re_le_norm (P x)) (by positivity : (0 : ℝ) ≤ x ^ 2)) h)
      (le_max_right _ _)
  refine ⟨p, χ, max C0 C2, ?_, ?_, ?_, lt_of_lt_of_le hC0 (le_max_left _ _),
    hdec0, hdec2, hχ, hχone, hχzero, ?_⟩
  · exact Complex.reCLM.contDiff.comp hPsmooth
  · exact (P.integrable (μ := volume)).re
  · have hone : 𝓕 (P : ℝ → ℂ) 0 = 1 := by
      rw [hP, ← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq,
        hXSc]
      change ((χ 0 : ℝ) : ℂ) = 1
      rw [hχone 0 (by norm_num)]
      norm_num
    rw [fourier_apply_zero] at hone
    have h2 : (∫ y : ℝ, (P : ℝ → ℂ) y) = ((∫ y : ℝ, p y : ℝ) : ℂ) := by
      rw [← integral_complex_ofReal]
      refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
      exact (hpc y).symm
    rw [h2] at hone
    exact_mod_cast hone
  · intro ξ
    have hcong : (fun x : ℝ => ((p x : ℝ) : ℂ)) = (P : ℝ → ℂ) := by
      funext x
      exact hpc x
    rw [hcong, hP, ← SchwartzMap.fourier_coe,
      FourierTransform.fourier_fourierInv_eq, hXSc]

/-! ## The Fourier transform of a telescoping piece

`𝓕(p_{j+1} − p_j)(ξ) = 𝓕p(ξ/2^{j+1}) − 𝓕p(ξ/2^j)`, so with the Calderón
profile the pieces of (5.7) carry exactly the annulus symbols of the dyadic
partition. -/

theorem integrable_brsChar_mul {g : ℝ → ℝ} (hg : Integrable g volume) (ξ : ℝ) :
    Integrable (fun y : ℝ =>
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
        (g y : ℂ)) volume := by
  refine Integrable.bdd_mul (c := 1) hg.ofReal ?_ ?_
  · refine Continuous.aestronglyMeasurable ?_
    refine Complex.continuous_exp.comp ?_
    exact (continuous_const.mul Complex.continuous_ofReal).neg
  · filter_upwards with y
    exact le_of_eq (norm_brsCharExp ξ y)

theorem integrable_brsDilate {p : ℝ → ℝ} (hp : Integrable p volume) (j : ℕ) :
    Integrable (brsDilate p j) volume := by
  have hne : ((2 : ℝ) ^ j) ≠ 0 := by positivity
  have h : Integrable (fun y : ℝ => p ((2 : ℝ) ^ j * y)) volume :=
    (hp.comp_mul_left' hne)
  exact h.const_mul _

open scoped FourierTransform in
/-- The Fourier transform of a dilate. -/
theorem fourier_brsDilate {p χ : ℝ → ℝ}
    (hFp : ∀ ξ : ℝ, 𝓕 (fun x : ℝ => (p x : ℂ)) ξ = (χ ξ : ℂ)) (j : ℕ)
    (ξ : ℝ) :
    𝓕 (fun x : ℝ => ((brsDilate p j x : ℝ) : ℂ)) ξ = (χ (ξ / 2 ^ j) : ℂ) := by
  have hd : (∫ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
        ((brsDilate p j y : ℝ) : ℂ)) =
      ∫ u : ℝ,
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I *
          (((ξ / 2 ^ j : ℝ)) : ℂ) * (u : ℂ))) * (p u : ℂ) :=
    brsFourier_dilate (ψ := p) (lam := (2 : ℝ) ^ j) (by positivity) ξ
  rw [← brsFourier_eq (brsDilate p j) ξ, hd, brsFourier_eq p (ξ / 2 ^ j), hFp]

open scoped FourierTransform in
/-- **The Fourier transform of a telescoping piece.** -/
theorem fourier_brsLPKernel {p χ : ℝ → ℝ} (hpint : Integrable p volume)
    (hFp : ∀ ξ : ℝ, 𝓕 (fun x : ℝ => (p x : ℂ)) ξ = (χ ξ : ℂ)) (ξ : ℝ) :
    𝓕 (fun x : ℝ => ((brsLPKernel p 0 x : ℝ) : ℂ)) ξ =
      (χ (ξ / 2) : ℂ) - (χ ξ : ℂ) := by
  have h1 := integrable_brsChar_mul (integrable_brsDilate hpint 1) ξ
  have h2 := integrable_brsChar_mul (integrable_brsDilate hpint 0) ξ
  have hpt : ∀ y : ℝ,
      Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
          ((brsLPKernel p 0 y : ℝ) : ℂ) =
        Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
            ((brsDilate p 1 y : ℝ) : ℂ) -
          Complex.exp (-(2 * (Real.pi : ℂ) * Complex.I * (ξ : ℂ) * (y : ℂ))) *
            ((brsDilate p 0 y : ℝ) : ℂ) := by
    intro y
    have hker : brsLPKernel p 0 y = brsDilate p 1 y - brsDilate p 0 y := rfl
    rw [hker]
    push_cast
    ring
  rw [← brsFourier_eq (brsLPKernel p 0) ξ,
    integral_congr_ae (Filter.Eventually.of_forall hpt), integral_sub h1 h2,
    brsFourier_eq (brsDilate p 1) ξ, brsFourier_eq (brsDilate p 0) ξ,
    fourier_brsDilate hFp 1 ξ, fourier_brsDilate hFp 0 ξ]
  norm_num

/-! ## The Calderón resolution, with its pieces factored

The capstone of the factorization programme: a resolution profile `p` of unit
mass whose telescoping piece `Ψ = p₁ − p₀` splits as `υ ∗ ψ`, with `υ` smooth,
supported in the unit ball, and carrying vanishing moments to order `N` for
itself and for its derivative — exactly the hypotheses of
`brs_5_9_near_covering_local` — and `ψ` a Schwartz function whose Fourier
transform lives in the annulus `1 ≤ |ξ| ≤ 4`. -/

open scoped FourierTransform in
/-- **The resolution of (5.7) with factored pieces.** -/
theorem exists_brsCalderonFactorization (N : ℕ) :
    ∃ (p υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ) (Cp : ℝ),
      ContDiff ℝ (⊤ : ℕ∞) p ∧ Integrable p volume ∧ (∫ x : ℝ, p x) = 1 ∧
      0 < Cp ∧ (∀ x : ℝ, |p x| ≤ Cp) ∧ (∀ x : ℝ, x ^ 2 * |p x| ≤ Cp) ∧
      ContDiff ℝ (⊤ : ℕ∞) υ ∧ HasCompactSupport υ ∧
      tsupport υ ⊆ Metric.closedBall 0 1 ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0) ∧
      (∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0) ∧
      (∀ ξ : ℝ, 𝓕 (S : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4) ∧
      ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel p 0 x : ℝ) : ℂ) := by
  obtain ⟨p, χ, Cp, hp, hpint, hpmass, hCppos, hCp0, hCp2, hχ, hχone, hχzero,
    hFp⟩ := exists_brsCalderonProfile
  set θ : ℝ → ℂ := fun ξ : ℝ => (χ (ξ / 2) : ℂ) - (χ ξ : ℂ) with hθdef
  have hθ : ContDiff ℝ (⊤ : ℕ∞) θ := by
    rw [hθdef]
    exact (Complex.ofRealCLM.contDiff.comp
      (hχ.comp (contDiff_id.div_const 2))).sub
      (Complex.ofRealCLM.contDiff.comp hχ)
  have hθsupp : ∀ ξ : ℝ, θ ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4 := by
    intro ξ hξ
    constructor
    · by_contra hc
      refine hξ ?_
      have h1 : |ξ| ≤ 1 := le_of_lt (not_le.mp hc)
      have h2 : |ξ / 2| ≤ 1 := by
        rw [abs_div]
        rw [show |(2 : ℝ)| = 2 from by norm_num]
        linarith
      rw [hθdef]
      change (χ (ξ / 2) : ℂ) - (χ ξ : ℂ) = 0
      rw [hχone _ h2, hχone _ h1, sub_self]
    · by_contra hc
      refine hξ ?_
      have h1 : (4 : ℝ) < |ξ| := not_le.mp hc
      have h2 : (2 : ℝ) ≤ |ξ / 2| := by
        rw [abs_div, show |(2 : ℝ)| = 2 from by norm_num]
        linarith
      rw [hθdef]
      change (χ (ξ / 2) : ℂ) - (χ ξ : ℂ) = 0
      rw [hχzero _ h2, hχzero _ (by linarith)]
      norm_num
  -- the telescoping piece and its Fourier transform
  set F : ℝ → ℂ := fun x : ℝ => ((brsLPKernel p 0 x : ℝ) : ℂ) with hF
  have hFcont : Continuous F :=
    Complex.continuous_ofReal.comp (continuous_brsLPKernel hp.continuous 0)
  have hFint : Integrable F volume := by
    have hr : Integrable (brsLPKernel p 0) volume := by
      have h : Integrable
          (fun y : ℝ => brsDilate p 1 y - brsDilate p 0 y) volume :=
        (integrable_brsDilate hpint 1).sub (integrable_brsDilate hpint 0)
      exact h
    exact hr.ofReal
  have hFF : 𝓕 F = θ := by
    funext ξ
    rw [hF, hθdef]
    exact fourier_brsLPKernel hpint hFp ξ
  have hθcs : HasCompactSupport θ :=
    hasCompactSupport_of_support_subset_ball (fun ξ hξ => (hθsupp ξ hξ).2)
  have hθint : Integrable θ volume :=
    hθ.continuous.integrable_of_hasCompactSupport hθcs
  have hinv : 𝓕⁻ θ = F := by
    rw [← hFF]
    exact hFcont.fourierInv_fourier_eq hFint (by rw [hFF]; exact hθint)
  obtain ⟨υ, S, hυ, hυcs, hυball, hmom, hmom', hSsupp, hconv⟩ :=
    exists_brsBandConvolution' N (a := 1) (b := 4) one_pos (by norm_num) hθ
      hθsupp
  exact ⟨p, υ, S, Cp, hp, hpint, hpmass, hCppos, hCp0, hCp2, hυ, hυcs, hυball,
    hmom, hmom', hSsupp, by rw [hconv, hinv]⟩

/-! ## The approximate identity for an integrable profile

The resolution profile of the Calderón formula is Schwartz, not compactly
supported, so the approximate-identity step of (5.7) has to be redone without
the support hypothesis.  Against a *bounded* continuous function — and the
chain's `h_k ⋆ h` is bounded — dominated convergence does it in one step: the
integrand `φ(u)(g(x − 2^{-J}u) − g(x))` tends to zero pointwise and is
dominated by `2C|φ(u)|`. -/

/-- The change of variables putting the dilation on the argument of `g`. -/
theorem integral_brsDilate_convolution_eq {φ : ℝ → ℝ} {g : ℝ → ℂ} (x : ℝ)
    (J : ℕ) :
    (∫ y : ℝ, ((brsDilate φ J y : ℝ) : ℂ) * g (x - y)) =
      ∫ u : ℝ, (φ u : ℂ) * g (x - u / 2 ^ J) := by
  have hpos : (0 : ℝ) < (2 : ℝ) ^ J := by positivity
  set G : ℝ → ℂ := fun u : ℝ =>
    (((2 : ℝ) ^ J : ℝ) : ℂ) * ((φ u : ℂ) * g (x - u / 2 ^ J)) with hG
  have hpt : ∀ y : ℝ,
      ((brsDilate φ J y : ℝ) : ℂ) * g (x - y) = G ((2 : ℝ) ^ J * y) := by
    intro y
    rw [hG]
    change ((2 ^ J * φ (2 ^ J * y) : ℝ) : ℂ) * g (x - y) =
      (((2 : ℝ) ^ J : ℝ) : ℂ) *
        ((φ ((2 : ℝ) ^ J * y) : ℂ) * g (x - (2 : ℝ) ^ J * y / 2 ^ J))
    rw [show (2 : ℝ) ^ J * y / 2 ^ J = y from by field_simp]
    push_cast
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
    Measure.integral_comp_mul_left G ((2 : ℝ) ^ J), hG, integral_const_mul,
    abs_of_pos (inv_pos.mpr hpos), Complex.real_smul, ← mul_assoc]
  rw [show (((((2 : ℝ) ^ J)⁻¹ : ℝ)) : ℂ) * (((2 : ℝ) ^ J : ℝ) : ℂ) = 1 from by
    push_cast
    field_simp, one_mul]

/-- **The approximate identity, for an integrable profile and a bounded
continuous function.** -/
theorem tendsto_brsDilate_convolution_bdd {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hint : Integrable φ volume) (hnorm : (∫ x, φ x) = 1) {g : ℝ → ℂ}
    (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C) (x : ℝ) :
    Tendsto (fun J : ℕ => ∫ y : ℝ, ((brsDilate φ J y : ℝ) : ℂ) * g (x - y))
      atTop (𝓝 (g x)) := by
  have hCnn : (0 : ℝ) ≤ C := le_trans (norm_nonneg _) (hbd 0)
  have hφC : Continuous fun u : ℝ => (φ u : ℂ) :=
    Complex.continuous_ofReal.comp hφ
  set F : ℕ → ℝ → ℂ := fun J u => (φ u : ℂ) * (g (x - u / 2 ^ J) - g x)
    with hF
  have hcontF : ∀ J : ℕ, Continuous (F J) := by
    intro J
    rw [hF]
    exact hφC.mul (((hg.comp (continuous_const.sub
      (continuous_id.div_const ((2 : ℝ) ^ J))))).sub continuous_const)
  -- the dominating function
  have hbound : Integrable (fun u : ℝ => 2 * C * |φ u|) volume := by
    have h := hint.abs
    exact h.const_mul (2 * C)
  have hdom : ∀ J : ℕ, ∀ᵐ u : ℝ, ‖F J u‖ ≤ 2 * C * |φ u| := by
    intro J
    filter_upwards with u
    rw [hF]
    change ‖(φ u : ℂ) * (g (x - u / 2 ^ J) - g x)‖ ≤ 2 * C * |φ u|
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have hdiff : ‖g (x - u / 2 ^ J) - g x‖ ≤ 2 * C :=
      le_trans (norm_sub_le _ _) (by linarith [hbd (x - u / 2 ^ J), hbd x])
    calc |φ u| * ‖g (x - u / 2 ^ J) - g x‖ ≤ |φ u| * (2 * C) := by
          exact mul_le_mul_of_nonneg_left hdiff (abs_nonneg _)
      _ = 2 * C * |φ u| := by ring
  have hlim : ∀ᵐ u : ℝ, Tendsto (fun J : ℕ => F J u) atTop (𝓝 0) := by
    filter_upwards with u
    have hu : Tendsto (fun J : ℕ => x - u / 2 ^ J) atTop (𝓝 x) := by
      have h2 : Tendsto (fun J : ℕ => u * (1 / 2 : ℝ) ^ J) atTop (𝓝 (u * 0)) :=
        tendsto_const_nhds.mul (tendsto_pow_atTop_nhds_zero_of_lt_one
          (by norm_num : (0 : ℝ) ≤ 1 / 2) (by norm_num : (1 : ℝ) / 2 < 1))
      rw [mul_zero] at h2
      have h3 : ∀ J : ℕ, u * (1 / 2 : ℝ) ^ J = u / 2 ^ J := by
        intro J
        rw [div_pow, one_pow]
        ring
      have h4 : Tendsto (fun J : ℕ => u / 2 ^ J) atTop (𝓝 0) := h2.congr h3
      simpa using tendsto_const_nhds.sub h4
    have hgl : Tendsto (fun J : ℕ => g (x - u / 2 ^ J)) atTop (𝓝 (g x)) :=
      (hg.tendsto x).comp hu
    have : Tendsto (fun J : ℕ => (φ u : ℂ) * (g (x - u / 2 ^ J) - g x)) atTop
        (𝓝 ((φ u : ℂ) * (g x - g x))) :=
      tendsto_const_nhds.mul (hgl.sub tendsto_const_nhds)
    simpa using this
  have hDCT := tendsto_integral_of_dominated_convergence
    (F := F) (f := fun _ : ℝ => (0 : ℂ))
    (fun u : ℝ => 2 * C * |φ u|)
    (fun J => (hcontF J).aestronglyMeasurable) hbound hdom hlim
  simp only [integral_zero] at hDCT
  -- rewrite the original sequence
  have hsplit : ∀ J : ℕ,
      (∫ y : ℝ, ((brsDilate φ J y : ℝ) : ℂ) * g (x - y)) =
        (∫ u : ℝ, F J u) + g x := by
    intro J
    rw [integral_brsDilate_convolution_eq x J, hF]
    have h1 : Integrable (fun u : ℝ => (φ u : ℂ) * g (x - u / 2 ^ J)) volume :=
      hint.ofReal.mul_bdd
        ((hg.comp (continuous_const.sub
          (continuous_id.div_const ((2 : ℝ) ^ J)))).aestronglyMeasurable)
        (Filter.Eventually.of_forall fun u => hbd _)
    have h2 : Integrable (fun u : ℝ => (φ u : ℂ) * g x) volume :=
      hint.ofReal.mul_bdd continuous_const.aestronglyMeasurable
        (Filter.Eventually.of_forall fun _ => hbd x)
    have hcong : (∫ u : ℝ, (φ u : ℂ) * (g (x - u / 2 ^ J) - g x)) =
        (∫ u : ℝ, (φ u : ℂ) * g (x - u / 2 ^ J)) -
          ∫ u : ℝ, (φ u : ℂ) * g x := by
      rw [← integral_sub h1 h2]
      refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
      ring
    have hone : (∫ u : ℝ, (φ u : ℂ) * g x) = g x := by
      rw [integral_mul_const, integral_complex_ofReal, hnorm]
      norm_num
    change (∫ u : ℝ, (φ u : ℂ) * g (x - u / 2 ^ J)) =
      (∫ u : ℝ, (φ u : ℂ) * (g (x - u / 2 ^ J) - g x)) + g x
    rw [hcong, hone]
    ring
  have hres : Tendsto (fun J : ℕ => (∫ u : ℝ, F J u) + g x) atTop
      (𝓝 (0 + g x)) := hDCT.add tendsto_const_nhds
  rw [zero_add] at hres
  exact hres.congr fun J => (hsplit J).symm

/-! ## (5.7) for an integrable profile

The telescoping resolution, restated for a profile that is only integrable —
the Calderón profile is Schwartz, not compactly supported — and tested against
a bounded continuous function. -/

theorem integrable_ofReal_mul_shift {ψ : ℝ → ℝ} (hψ : Integrable ψ volume)
    {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (x : ℝ) :
    Integrable (fun y : ℝ => (ψ y : ℂ) * g (x - y)) volume :=
  hψ.ofReal.mul_bdd
    (hg.comp (continuous_const.sub continuous_id)).aestronglyMeasurable
    (Filter.Eventually.of_forall fun _ => hbd _)

theorem integrable_brsLPKernel {φ : ℝ → ℝ} (hint : Integrable φ volume)
    (j : ℕ) : Integrable (brsLPKernel φ j) volume :=
  (integrable_brsDilate hint (j + 1)).sub (integrable_brsDilate hint j)

/-- The integral of a telescoping piece, as a difference. -/
theorem integral_brsLPKernel_convolution {φ : ℝ → ℝ}
    (hint : Integrable φ volume) {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ}
    (hbd : ∀ z : ℝ, ‖g z‖ ≤ C) (j : ℕ) (x : ℝ) :
    (∫ y : ℝ, ((brsLPKernel φ j y : ℝ) : ℂ) * g (x - y)) =
      (∫ y : ℝ, ((brsDilate φ (j + 1) y : ℝ) : ℂ) * g (x - y)) -
        ∫ y : ℝ, ((brsDilate φ j y : ℝ) : ℂ) * g (x - y) := by
  have h1 := integrable_ofReal_mul_shift (integrable_brsDilate hint j) hg hbd x
  have h2 :=
    integrable_ofReal_mul_shift (integrable_brsDilate hint (j + 1)) hg hbd x
  rw [← integral_sub h2 h1]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change ((brsLPKernel φ j y : ℝ) : ℂ) * g (x - y) =
    ((brsDilate φ (j + 1) y : ℝ) : ℂ) * g (x - y) -
      ((brsDilate φ j y : ℝ) : ℂ) * g (x - y)
  have hker : brsLPKernel φ j y = brsDilate φ (j + 1) y - brsDilate φ j y := rfl
  rw [hker]
  push_cast
  ring

/-- **(5.7) in telescoping form, for an integrable profile.** -/
theorem brs_lp_resolution_int {φ : ℝ → ℝ} (hint : Integrable φ volume)
    {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (J : ℕ) (x : ℝ) :
    (∫ y : ℝ, ((brsDilate φ J y : ℝ) : ℂ) * g (x - y)) =
      (∫ y : ℝ, ((brsDilate φ 0 y : ℝ) : ℂ) * g (x - y)) +
        ∑ j ∈ Finset.range J,
          ∫ y : ℝ, ((brsLPKernel φ j y : ℝ) : ℂ) * g (x - y) := by
  induction J with
  | zero => simp
  | succ J ih =>
      rw [Finset.sum_range_succ, ← add_assoc, ← ih,
        integral_brsLPKernel_convolution hint hg hbd J x]
      ring

/-- **(5.7) based at the scale `k`, for an integrable profile.** -/
theorem brs_lp_resolution_shift_int {φ : ℝ → ℝ} (hint : Integrable φ volume)
    {g : ℝ → ℂ} (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C)
    (k M : ℕ) (x : ℝ) :
    (∫ y : ℝ, ((brsDilate φ (k + M) y : ℝ) : ℂ) * g (x - y)) =
      (∫ y : ℝ, ((brsDilate φ k y : ℝ) : ℂ) * g (x - y)) +
        ∑ m ∈ Finset.range M,
          ∫ y : ℝ, ((brsLPKernel φ (k + m) y : ℝ) : ℂ) * g (x - y) := by
  induction M with
  | zero => simp
  | succ M ih =>
      have hstep := integral_brsLPKernel_convolution hint hg hbd (k + M) x
      rw [Finset.sum_range_succ, hstep,
        show k + (M + 1) = k + M + 1 from by ring, ih]
      ring

/-- **The resolution converges, for an integrable profile.** -/
theorem brs_lp_resolution_shift_tendsto_int {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hint : Integrable φ volume) (hnorm : (∫ x, φ x) = 1) {g : ℝ → ℂ}
    (hg : Continuous g) {C : ℝ} (hbd : ∀ z : ℝ, ‖g z‖ ≤ C) (k : ℕ) (x : ℝ) :
    Tendsto (fun M : ℕ =>
        (∫ y : ℝ, ((brsDilate φ k y : ℝ) : ℂ) * g (x - y)) +
          ∑ m ∈ Finset.range M,
            ∫ y : ℝ, ((brsLPKernel φ (k + m) y : ℝ) : ℂ) * g (x - y))
      atTop (𝓝 (g x)) := by
  have h := tendsto_brsDilate_convolution_bdd hφ hint hnorm hg hbd x
  have hcomp : Tendsto (fun M : ℕ => k + M) atTop atTop :=
    tendsto_atTop_mono (fun M => Nat.le_add_left M k) tendsto_id
  refine (h.comp hcomp).congr fun M => ?_
  exact brs_lp_resolution_shift_int hint hg hbd k M x

/-- **The resolution applied to the smoothed near part, for an integrable
profile.** -/
theorem brs_resolution_truncConv_int (k s : ℕ) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hint : Integrable φ volume) (hnorm : (∫ x, φ x) = 1) {h : ℝ → ℂ}
    (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) {D : ℝ}
    (hbd' : ∀ z : ℝ, ‖(brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) z‖ ≤ D) (x : ℝ) :
    Tendsto (fun M : ℕ =>
        (∫ y : ℝ, ((brsDilate φ (k + s) y : ℝ) : ℂ) *
            (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
              ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) +
          ∑ m ∈ Finset.range M, ∫ y : ℝ,
            ((brsLPKernel φ (k + s + m) y : ℝ) : ℂ) *
              (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
                ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y))
      atTop (𝓝 ((brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x)) :=
  brs_lp_resolution_shift_tendsto_int hφ hint hnorm
    (continuous_brsTruncKernel_convolution k hh hbd) hbd' (k + s) x

/-! ## Associativity for an integrable, bounded bump

`brs_conv_assoc'` and `brs_piece_eq` use the compact support of the bump only
through integrability and boundedness, so they hold verbatim for the Schwartz
profile of the Calderón resolution. -/

theorem abs_brsLPKernel_le {φ : ℝ → ℝ} {M : ℝ} (hM : ∀ x : ℝ, |φ x| ≤ M)
    (j : ℕ) (x : ℝ) : |brsLPKernel φ j x| ≤ 2 ^ (j + 1) * M + 2 ^ j * M := by
  change |brsDilate φ (j + 1) x - brsDilate φ j x| ≤ _
  refine le_trans (abs_sub _ _) ?_
  exact add_le_add (abs_brsDilate_le hM (j + 1) x) (abs_brsDilate_le hM j x)

/-- **Associativity with the bump on the outside**, for an integrable and
bounded bump. -/
theorem brs_conv_assoc'_int (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨint : Integrable Ψ volume) {MΨ : ℝ} (hMΨ : ∀ x : ℝ, |Ψ x| ≤ MΨ)
    {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C)
    (x : ℝ) :
    ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  have hauxcont : Continuous ((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hK.norm
      hh.norm
    refine ⟨C, ?_⟩
    rintro y ⟨z, rfl⟩
    change ‖‖h z‖‖ ≤ C
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  have hauxbd : ∀ z : ℝ, |((fun w : ℝ => ‖brsTruncKernel k w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z| ≤
      C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖brsTruncKernel k w‖)
        ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖h w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    have hleft : Integrable (fun s : ℝ =>
        ‖brsTruncKernel k s‖ * ‖h (z - s)‖) volume :=
      integrable_mul_shift_of_bounded' (C := C) hK.norm hh.norm.measurable
        (fun w => by
          rw [abs_of_nonneg (norm_nonneg _)]
          exact hbd w) z
    have hright : Integrable (fun s : ℝ => ‖brsTruncKernel k s‖ * C) volume :=
      hK.norm.mul_const C
    calc (∫ s : ℝ, ‖brsTruncKernel k s‖ * ‖h (z - s)‖)
        ≤ ∫ s : ℝ, ‖brsTruncKernel k s‖ * C :=
          integral_mono hleft hright fun s =>
            mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
      _ = C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
          rw [integral_mul_const]
          ring
  refine convolution_assoc _ _ _ _ (fun a b z => mul_smul a b z)
    hΨint.aestronglyMeasurable hK.aestronglyMeasurable hh.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_bounded_mul_shift hΨ.measurable
      (fun z => by simpa only [Real.norm_eq_abs] using hMΨ z) hK y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    refine integrable_mul_shift_of_bounded' (C := C) hK.norm
      hh.norm.measurable (fun z => ?_) u
    rw [abs_of_nonneg (norm_nonneg _)]
    exact hbd z
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' hΨint.norm hauxcont.measurable
      hauxbd x

/-- **The piece of the resolution, with its kernel identified**, for an
integrable and bounded bump. -/
theorem brs_piece_eq_int (k : ℕ) {Ψ : ℝ → ℝ} (hΨ : Continuous Ψ)
    (hΨint : Integrable Ψ volume) {MΨ : ℝ} (hMΨ : ∀ x : ℝ, |Ψ x| ≤ MΨ)
    {h : ℝ → ℂ} (hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C)
    (x : ℝ) :
    (∫ y : ℝ, (Ψ y : ℂ) *
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k Ψ y : ℝ) : ℂ) * h (x - y) := by
  have h1 : (∫ y : ℝ, (Ψ y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) (x - y)) =
      (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x := (convolution_eq_integral x).symm
  have h2 : (Ψ ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume]
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h)) x =
      ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
        ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x :=
    (brs_conv_assoc'_int k hΨ hΨint hMΨ hh hbd x).symm
  have h3 : ((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k)
      ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) x =
      ∫ y : ℝ, (((Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume]
        brsTruncKernel k) y : ℝ) : ℂ) * h (x - y) := convolution_eq_integral x
  have h4 : (Ψ ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] brsTruncKernel k) =
      brsTruncConvReal k Ψ := (brsTruncConvReal_eq_convolution k Ψ).symm
  rw [h1, h2, h3, h4]

/-- The convolution with the truncated kernel is bounded. -/
theorem norm_brsTruncKernel_convolution_le (k : ℕ) {h : ℝ → ℂ}
    (_hh : Continuous h) {C : ℝ} (hbd : ∀ z : ℝ, ‖h z‖ ≤ C) (z : ℝ) :
    ‖(brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] h) z‖ ≤
      C * ∫ s : ℝ, ‖brsTruncKernel k s‖ := by
  have hK : Integrable (brsTruncKernel k) volume := integrable_brsTruncKernel k
  rw [convolution]
  have hbound : ∀ s : ℝ,
      ‖(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ)
        (brsTruncKernel k s) (h (z - s))‖ ≤ ‖brsTruncKernel k s‖ * C := by
    intro s
    simp only [ContinuousLinearMap.lsmul_apply, norm_smul]
    exact mul_le_mul_of_nonneg_left (hbd _) (norm_nonneg _)
  have hright : Integrable (fun s : ℝ => ‖brsTruncKernel k s‖ * C) volume :=
    hK.norm.mul_const C
  refine le_trans (norm_integral_le_of_norm_le hright
    (Filter.Eventually.of_forall hbound)) (le_of_eq ?_)
  rw [integral_mul_const]
  ring

/-! ## The near part, decomposed by an integrable profile

The domination of the near part by the pieces of the resolution, with the
compact-support hypothesis on the profile replaced by integrability and
boundedness.  This is what allows the Calderón profile — Schwartz, hence not
compactly supported — to drive the decomposition. -/

/-- **The near part, decomposed**, for an integrable and bounded profile. -/
theorem brsANearLeftAt_le_pieces_int (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφint : Integrable φ volume)
    {Mφ : ℝ} (hφbd : ∀ x : ℝ, |φ x| ≤ Mφ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearLeftAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearPieceMax k (brsDilate φ (k + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax k (brsLPKernel φ (k + s + m)) g E r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  rw [brsANearLeftAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (iSup₂_mono fun t _ => ?_) iSup_add_tsum_le
  set x : ℝ := -(t - r) with hx
  have hres := brs_resolution_truncConv_int k s hφ hφint hφnorm hgrefl hgreflbd
    (norm_brsTruncKernel_convolution_le k hgrefl hgreflbd) x
  have hlow : (∫ y : ℝ, (brsDilate φ (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq_int k (continuous_brsDilate hφ (k + s))
      (integrable_brsDilate hφint (k + s))
      (fun z => abs_brsDilate_le hφbd (k + s) z) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel φ (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl g (x - y) := fun m =>
    brs_piece_eq_int k (continuous_brsLPKernel hφ (k + s + m))
      (integrable_brsLPKernel hφint (k + s + m))
      (fun z => abs_brsLPKernel_le hφbd (k + s + m) z) hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres

/-! ## The line as a one-dimensional inner product space

`brsLineEquiv` is only a measurable equivalence, which is enough to transport
integrals but not enough to transport the Fourier transform: for that the
identification has to preserve the inner product.  It does — it is the
orthonormal basis of `ℝ` indexed by `Fin 1` — and the resulting linear isometry
carries `𝓕` across. -/

/-- The identification `ℝ ≃ₗᵢ Euclidean 1`. -/
def brsLineIso : ℝ ≃ₗᵢ[ℝ] Euclidean 1 :=
  (OrthonormalBasis.singleton (Fin 1) ℝ).repr

theorem brsLineIso_apply (x : ℝ) (i : Fin 1) : brsLineIso x i = x := by
  rw [brsLineIso]
  exact OrthonormalBasis.singleton_repr x i

theorem brsLineIso_eq_symm (x : ℝ) : brsLineIso x = brsLineEquiv.symm x := by
  ext i
  rw [brsLineIso_apply]
  change x = (brsLineEquiv.symm x) i
  have : (brsLineEquiv.symm x : Euclidean 1) i = x := by
    simp [brsLineEquiv, MeasurableEquiv.funUnique, MeasurableEquiv.toLp]
    rfl
  rw [this]

theorem brsLineIso_symm_apply (v : Euclidean 1) :
    brsLineIso.symm v = brsLineEquiv v := by
  have h : brsLineIso (brsLineEquiv v) = v := by
    rw [brsLineIso_eq_symm]
    exact brsLineEquiv.symm_apply_apply v
  conv_lhs => rw [← h]
  rw [LinearIsometryEquiv.symm_apply_apply]

open scoped FourierTransform in
/-- **The Fourier transform commutes with the identification of `ℝ` with
`Euclidean 1`.** -/
theorem fourier_brsLineIso (f : Euclidean 1 → ℂ) (w : ℝ) :
    𝓕 (fun x : ℝ => f (brsLineIso x)) w = 𝓕 f (brsLineIso w) :=
  Real.fourier_comp_linearIsometry brsLineIso f w

open scoped FourierTransform in
/-- The same, phrased through `brsLineEquiv`. -/
theorem fourier_brsLineEquiv_symm (f : Euclidean 1 → ℂ) (w : ℝ) :
    𝓕 (fun x : ℝ => f (brsLineEquiv.symm x)) w = 𝓕 f (brsLineEquiv.symm w) := by
  have hcong : (fun x : ℝ => f (brsLineEquiv.symm x)) =
      fun x : ℝ => f (brsLineIso x) := by
    funext x
    rw [brsLineIso_eq_symm]
  rw [hcong, fourier_brsLineIso, brsLineIso_eq_symm]

/-! ## Young's inequality along the dilates

The `L¹` norm is dilation-invariant, so Young's inequality for the family
`{ψ_j}` carries the *same* constant `‖ψ‖₁` at every scale.  This is the bound
that turns the Littlewood--Paley pieces `ψ_j ∗ g` into a summable family. -/

theorem lintegral_comp_mul_left_ennreal {F : ℝ → ENNReal} (hF : Measurable F)
    {a : ℝ} (ha : a ≠ 0) :
    (∫⁻ x : ℝ, F (a * x)) = ENNReal.ofReal |a⁻¹| * ∫⁻ y : ℝ, F y := by
  rw [← lintegral_map hF (measurable_const_mul a), Real.map_volume_mul_left ha,
    lintegral_smul_measure, smul_eq_mul]

/-- **The `L¹` norm is dilation invariant.** -/
theorem lintegral_enorm_brsDilate {ψ : ℝ → ℝ} (hψ : Measurable ψ) (j : ℕ) :
    (∫⁻ y : ℝ, ‖brsDilate ψ j y‖ₑ) = ∫⁻ y : ℝ, ‖ψ y‖ₑ := by
  have hpos : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hne : ((2 : ℝ) ^ j) ≠ 0 := ne_of_gt hpos
  have hpt : ∀ y : ℝ, ‖brsDilate ψ j y‖ₑ =
      ENNReal.ofReal ((2 : ℝ) ^ j) * ‖ψ ((2 : ℝ) ^ j * y)‖ₑ := by
    intro y
    change ‖(2 : ℝ) ^ j * ψ ((2 : ℝ) ^ j * y)‖ₑ = _
    rw [enorm_mul, Real.enorm_eq_ofReal hpos.le]
  have hm : Measurable fun a : ℝ => ‖ψ ((2 : ℝ) ^ j * a)‖ₑ :=
    (hψ.comp (measurable_const_mul ((2 : ℝ) ^ j))).enorm
  rw [lintegral_congr hpt, lintegral_const_mul _ hm,
    lintegral_comp_mul_left_ennreal hψ.enorm hne,
    abs_of_pos (inv_pos.mpr hpos), ← mul_assoc]
  rw [← ENNReal.ofReal_mul hpos.le, mul_inv_cancel₀ hne, ENNReal.ofReal_one,
    one_mul]

/-- **Young's inequality along the dilates**, with a scale-independent
constant. -/
theorem lintegral_convolution_brsDilate_rpow_le {p : ℝ} (hp : 1 ≤ p)
    {ψ : ℝ → ℝ} (hψ : Measurable ψ) (hA : (∫⁻ y : ℝ, ‖ψ y‖ₑ) ≠ ⊤) (j : ℕ)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ x : ℝ, ‖∫ y : ℝ, ((brsDilate ψ j y : ℝ) : ℂ) * g (x - y)‖ₑ ^ p) ≤
      (∫⁻ y : ℝ, ‖ψ y‖ₑ) ^ p * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hmeas : Measurable (brsDilate ψ j) := by
    change Measurable fun y : ℝ => (2 : ℝ) ^ j * ψ ((2 : ℝ) ^ j * y)
    exact measurable_const.mul (hψ.comp (measurable_const_mul _))
  have hA' : (∫⁻ y : ℝ, ‖brsDilate ψ j y‖ₑ) ≠ ⊤ := by
    rw [lintegral_enorm_brsDilate hψ j]
    exact hA
  have h := lintegral_convolution_rpow_le hp hmeas hA' hg
  rwa [lintegral_enorm_brsDilate hψ j] at h

/-! ## An annulus meets only three dyadic bands

A frequency in `2^j ≤ ‖ξ‖ ≤ 2^{j+2}` — the annulus carrying `𝓕ψ_j` — is seen
by the dyadic bands `k = j−1, j, j+1` and by no others, so the resolution of
the identity restricted to those three scales is exactly `1` there.  This is
what lets a Littlewood--Paley piece `ψ_j ∗ f` be written as a sum of `O(1)`
dyadic projections of `f`. -/

/-- Only three dyadic bands meet the annulus `2^j ≤ ‖ξ‖ ≤ 2^{j+2}`. -/
theorem intDyadicBandpass_index_mem_Icc {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) {j k : ℤ} {ξ : Euclidean d}
    (hlo : (2 : ℝ) ^ j ≤ ‖ξ‖) (hhi : ‖ξ‖ ≤ (2 : ℝ) ^ (j + 2))
    (h : Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k ξ ≠ 0) :
    k ∈ Finset.Icc (j - 1) (j + 1) := by
  obtain ⟨h1, h2⟩ :=
    Auto.LittlewoodPaley.intDyadicBandpass_norm_bounds_of_ne_zero C h
  have hbase : (1 : ℝ) < 2 := by norm_num
  have hk : k < j + 2 := by
    have : (2 : ℝ) ^ k < (2 : ℝ) ^ (j + 2) := lt_of_lt_of_le h1 hhi
    exact (zpow_lt_zpow_iff_right₀ hbase).mp this
  have hj : j < k + 2 := by
    have : (2 : ℝ) ^ j < (2 : ℝ) ^ (k + 2) := lt_of_le_of_lt hlo h2
    exact (zpow_lt_zpow_iff_right₀ hbase).mp this
  rw [Finset.mem_Icc]
  omega

/-- **The three-band reconstruction on the annulus `2^j ≤ ‖ξ‖ ≤ 2^{j+2}`.** -/
theorem sum_intDyadicBandpass_Icc_eq_one {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) {j : ℤ} {ξ : Euclidean d}
    (hlo : (2 : ℝ) ^ j ≤ ‖ξ‖) (hhi : ‖ξ‖ ≤ (2 : ℝ) ^ (j + 2)) :
    ∑ k ∈ Finset.Icc (j - 1) (j + 1),
      Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k ξ = 1 := by
  have hpos : (0 : ℝ) < (2 : ℝ) ^ j := zpow_pos (by norm_num) _
  have hξ : ξ ≠ 0 := by
    intro hz
    rw [hz, norm_zero] at hlo
    linarith
  have hzero : ∀ k ∉ Finset.Icc (j - 1) (j + 1),
      Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k ξ = 0 := by
    intro k hk
    by_contra hne
    exact hk (intDyadicBandpass_index_mem_Icc C hlo hhi hne)
  have h := Auto.LittlewoodPaley.homogeneousDyadicResolution C hξ
  rw [tsum_eq_sum (s := Finset.Icc (j - 1) (j + 1)) hzero] at h
  exact h

/-! ## Transporting Schwartz functions between `ℝ` and `Euclidean 1`

The Littlewood--Paley machinery lives on `Euclidean 1` and the BRS chain on
`ℝ`; `brsLineIso` moves Schwartz functions between them, and the Fourier
transform follows. -/

/-- A Schwartz function on `Euclidean 1`, read on the line. -/
def brsSchwartzToLine : SchwartzMap (Euclidean 1) ℂ →L[ℂ] SchwartzMap ℝ ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ brsLineIso.toContinuousLinearEquiv

/-- A Schwartz function on the line, read on `Euclidean 1`. -/
def brsSchwartzOfLine : SchwartzMap ℝ ℂ →L[ℂ] SchwartzMap (Euclidean 1) ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
    brsLineIso.symm.toContinuousLinearEquiv

theorem brsSchwartzToLine_apply (f : SchwartzMap (Euclidean 1) ℂ) (x : ℝ) :
    brsSchwartzToLine f x = f (brsLineIso x) := rfl

theorem brsSchwartzOfLine_apply (G : SchwartzMap ℝ ℂ) (v : Euclidean 1) :
    brsSchwartzOfLine G v = G (brsLineIso.symm v) := rfl

theorem brsSchwartzToLine_ofLine (G : SchwartzMap ℝ ℂ) (x : ℝ) :
    brsSchwartzToLine (brsSchwartzOfLine G) x = G x := by
  rw [brsSchwartzToLine_apply, brsSchwartzOfLine_apply,
    LinearIsometryEquiv.symm_apply_apply]

open scoped FourierTransform in
/-- **The Fourier transform of a dilate**, for a complex-valued function. -/
theorem fourier_dilate_complex (F : ℝ → ℂ) {lam : ℝ} (hlam : 0 < lam) (w : ℝ) :
    𝓕 (fun y : ℝ => (lam : ℂ) * F (lam * y)) w = 𝓕 F (w / lam) := by
  have hlamC : (lam : ℂ) ≠ 0 := by
    exact_mod_cast hlam.ne'
  rw [Real.fourier_eq', Real.fourier_eq']
  set G : ℝ → ℂ := fun u : ℝ =>
    Complex.exp (((-2 * Real.pi * (u * (w / lam)) : ℝ) : ℂ) * Complex.I) • F u
    with hG
  have hpt : ∀ y : ℝ,
      Complex.exp (((-2 * Real.pi * (inner ℝ y w : ℝ) : ℝ) : ℂ) * Complex.I) •
          ((lam : ℂ) * F (lam * y)) = (lam : ℂ) * G (lam * y) := by
    intro y
    rw [hG]
    change Complex.exp (((-2 * Real.pi * (inner ℝ y w : ℝ) : ℝ) : ℂ) *
        Complex.I) • ((lam : ℂ) * F (lam * y)) =
      (lam : ℂ) *
        (Complex.exp (((-2 * Real.pi * ((lam * y) * (w / lam)) : ℝ) : ℂ) *
          Complex.I) • F (lam * y))
    rw [Real.inner_apply, smul_eq_mul, smul_eq_mul,
      show lam * y * (w / lam) = y * w from by field_simp]
    ring
  have hgoal : ∀ u : ℝ,
      Complex.exp (((-2 * Real.pi * (inner ℝ u (w / lam) : ℝ) : ℝ) : ℂ) *
        Complex.I) • F u = G u := by
    intro u
    rw [hG, Real.inner_apply]
  rw [integral_congr_ae (Filter.Eventually.of_forall hpt),
    integral_congr_ae (Filter.Eventually.of_forall hgoal), integral_const_mul,
    Measure.integral_comp_mul_left G lam, abs_of_pos (inv_pos.mpr hlam),
    Complex.real_smul, ← mul_assoc]
  rw [show (lam : ℂ) * ((lam : ℝ)⁻¹ : ℝ) = 1 from by
    push_cast
    field_simp, one_mul]

/-! ## The symbol of a dyadic projection

The dyadic projection is the Fourier multiplier with symbol
`intDyadicBandpassMultiplier`, and the identification of `ℝ` with `Euclidean 1`
carries that statement to the line. -/

open scoped FourierTransform in
/-- **The symbol of a dyadic projection.** -/
theorem fourier_brsDyadicSchwartz {d : ℕ}
    (C : Auto.LittlewoodPaley.lpCutoffs d) (n : ℤ)
    (f : SchwartzMap (Euclidean d) ℂ) (ξ : Euclidean d) :
    𝓕 ((brsDyadicSchwartz C n f : Euclidean d → ℂ)) ξ =
      Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff n ξ *
        𝓕 (f : Euclidean d → ℂ) ξ := by
  rw [← SchwartzMap.fourier_coe, brsDyadicSchwartz,
    FourierTransform.fourier_fourierInv_eq,
    SchwartzMap.smulLeftCLM_apply
      (Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff
        n).hasTemperateGrowth, ← SchwartzMap.fourier_coe]
  rfl

open scoped FourierTransform in
/-- **The symbol of a dyadic projection, read on the line.** -/
theorem fourier_dyadicProjection_line (C : Auto.LittlewoodPaley.lpCutoffs 1)
    (k : ℤ) (G : SchwartzMap ℝ ℂ) (w : ℝ) :
    𝓕 (fun x : ℝ =>
        Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k
          (brsSchwartzOfLine G) (brsLineIso x)) w =
      Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k
        (brsLineIso w) * 𝓕 (G : ℝ → ℂ) w := by
  have hcong : (fun x : ℝ =>
      Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k
        (brsSchwartzOfLine G) (brsLineIso x)) =
      fun x : ℝ =>
        (brsDyadicSchwartz C k (brsSchwartzOfLine G) : Euclidean 1 → ℂ)
          (brsLineIso x) := by
    funext x
    exact (brsDyadicSchwartz_apply C k (brsSchwartzOfLine G) _).symm
  rw [hcong, fourier_brsLineIso, fourier_brsDyadicSchwartz]
  congr 1
  have hG : (fun x : ℝ => (brsSchwartzOfLine G : Euclidean 1 → ℂ)
      (brsLineIso x)) = (G : ℝ → ℂ) := by
    funext x
    exact brsSchwartzToLine_ofLine G x
  rw [← hG, fourier_brsLineIso]

/-! ## The annulus carried by a dilated band

If `𝓕ψ` lives in `1 ≤ |ξ| ≤ 4` then `𝓕ψ_j` lives in `2^j ≤ |ξ| ≤ 2^{j+2}`,
which is exactly the annulus met by the three dyadic bands
`k = j−1, j, j+1`. -/

theorem norm_brsLineIso (w : ℝ) : ‖brsLineIso w‖ = |w| := by
  rw [LinearIsometryEquiv.norm_map]
  exact Real.norm_eq_abs w

open scoped FourierTransform in
/-- **The annulus carried by `𝓕ψ_j`.** -/
theorem fourier_dilate_support_annulus {ψ : ℝ → ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 ψ ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4) (j : ℕ) {w : ℝ}
    (h : 𝓕 (fun y : ℝ => (((2 : ℝ) ^ j : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j * y)) w ≠ 0) :
    (2 : ℝ) ^ (j : ℤ) ≤ ‖brsLineIso w‖ ∧
      ‖brsLineIso w‖ ≤ (2 : ℝ) ^ ((j : ℤ) + 2) := by
  have hpos : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  rw [fourier_dilate_complex ψ hpos] at h
  obtain ⟨h1, h2⟩ := hψsupp _ h
  rw [abs_div, abs_of_pos hpos] at h1 h2
  rw [norm_brsLineIso]
  have hz1 : (2 : ℝ) ^ (j : ℤ) = (2 : ℝ) ^ j := zpow_natCast 2 j
  have hz2 : (2 : ℝ) ^ ((j : ℤ) + 2) = 4 * (2 : ℝ) ^ j := by
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0), hz1]
    norm_num
    ring
  rw [hz1, hz2]
  constructor
  · rw [le_div_iff₀ hpos] at h1
    linarith
  · rw [div_le_iff₀ hpos] at h2
    linarith

/-! ## The dilate of a Schwartz function, and its dyadic band

The second factor of the BRS resolution, bundled as a Schwartz map at every
scale, together with the dyadic projections of the input read on the line. -/

/-- The `L¹`-normalized dilate of a Schwartz function. -/
def brsSchwartzDilate (ψ : SchwartzMap ℝ ℂ) (j : ℕ) : SchwartzMap ℝ ℂ :=
  (((2 : ℝ) ^ j : ℝ) : ℂ) •
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ
      (ContinuousLinearEquiv.smulLeft
        (Units.mk0 ((2 : ℝ) ^ j) (by positivity))) ψ

theorem brsSchwartzDilate_apply (ψ : SchwartzMap ℝ ℂ) (j : ℕ) (x : ℝ) :
    brsSchwartzDilate ψ j x =
      (((2 : ℝ) ^ j : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j * x) := rfl

/-- The `k`-th dyadic projection of a Schwartz function on the line. -/
def brsLineProjection (C : Auto.LittlewoodPaley.lpCutoffs 1) (k : ℤ)
    (G : SchwartzMap ℝ ℂ) : SchwartzMap ℝ ℂ :=
  brsSchwartzToLine (brsDyadicSchwartz C k (brsSchwartzOfLine G))

theorem brsLineProjection_apply (C : Auto.LittlewoodPaley.lpCutoffs 1) (k : ℤ)
    (G : SchwartzMap ℝ ℂ) (x : ℝ) :
    brsLineProjection C k G x =
      Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k
        (brsSchwartzOfLine G) (brsLineIso x) := by
  rw [brsLineProjection, brsSchwartzToLine_apply]
  exact brsDyadicSchwartz_apply C k (brsSchwartzOfLine G) _

open scoped FourierTransform in
theorem fourier_brsLineProjection (C : Auto.LittlewoodPaley.lpCutoffs 1)
    (k : ℤ) (G : SchwartzMap ℝ ℂ) (w : ℝ) :
    𝓕 ((brsLineProjection C k G : ℝ → ℂ)) w =
      Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k
        (brsLineIso w) * 𝓕 (G : ℝ → ℂ) w := by
  have hcong : ((brsLineProjection C k G : ℝ → ℂ)) =
      fun x : ℝ =>
        Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k
          (brsSchwartzOfLine G) (brsLineIso x) := by
    funext x
    exact brsLineProjection_apply C k G x
  rw [hcong]
  exact fourier_dyadicProjection_line C k G w

/-! ## Additivity of the Fourier transform over a finite sum -/

open scoped FourierTransform in
theorem fourier_finset_sum {ι : Type*} (K : Finset ι) (F : ι → ℝ → ℂ)
    (hF : ∀ k ∈ K, Integrable (F k) volume) (w : ℝ) :
    𝓕 (fun x : ℝ => ∑ k ∈ K, F k x) w = ∑ k ∈ K, 𝓕 (F k) w := by
  classical
  induction K using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty]
      rw [Real.fourier_eq']
      simp
  | insert a s ha ih =>
      have hFa : Integrable (F a) volume := hF a (Finset.mem_insert_self a s)
      have hFs : ∀ k ∈ s, Integrable (F k) volume := fun k hk =>
        hF k (Finset.mem_insert_of_mem hk)
      have hsum : Integrable (fun x : ℝ => ∑ k ∈ s, F k x) volume :=
        integrable_finsetSum s hFs
      have hsplit : (fun x : ℝ => ∑ k ∈ insert a s, F k x) =
          F a + fun x : ℝ => ∑ k ∈ s, F k x := by
        funext x
        rw [Finset.sum_insert ha]
        rfl
      rw [hsplit]
      have hadd : 𝓕 (F a + fun x : ℝ => ∑ k ∈ s, F k x) =
          𝓕 (F a) + 𝓕 (fun x : ℝ => ∑ k ∈ s, F k x) :=
        VectorFourier.fourierIntegral_add Real.continuous_fourierChar
          (by fun_prop) hFa hsum
      rw [hadd]
      change 𝓕 (F a) w + 𝓕 (fun x : ℝ => ∑ k ∈ s, F k x) w = _
      rw [ih hFs, Finset.sum_insert ha]

/-! ## A dilated band meets only three dyadic projections

`𝓕ψ_j` lives on an annulus met by the bands `k = j−1, j, j+1`, so
`ψ_j ∗ G = Σ_{k=j−1}^{j+1} ψ_j ∗ Δ_k G`.  Comparing Fourier transforms and
inverting is the whole proof: the symbols agree because the three bands sum to
`1` wherever `𝓕ψ_j` is non-zero. -/

open scoped FourierTransform in
/-- **A dilated band is carried by three dyadic projections.** -/
theorem brsSchwartzDilate_conv_eq_sum (C : Auto.LittlewoodPaley.lpCutoffs 1)
    {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    (j : ℕ) (G : SchwartzMap ℝ ℂ) (x : ℝ) :
    ((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (G : ℝ → ℂ)) x =
      ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1),
        ((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
          (brsLineProjection C k G : ℝ → ℂ)) x := by
  classical
  set ψj : SchwartzMap ℝ ℂ := brsSchwartzDilate ψ j with hψjdef
  set K : Finset ℤ := Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1) with hKdef
  set A : SchwartzMap ℝ ℂ :=
    SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) ψj G with hAdef
  set Bk : ℤ → SchwartzMap ℝ ℂ := fun k =>
    SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) ψj
      (brsLineProjection C k G) with hBkdef
  have hAf : (A : ℝ → ℂ) =
      ((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) := by
    funext y
    exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul ℂ ℂ) ψj G y
  have hBf : ∀ k : ℤ, (Bk k : ℝ → ℂ) =
      ((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (brsLineProjection C k G : ℝ → ℂ)) := by
    intro k
    funext y
    exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul ℂ ℂ) ψj
      (brsLineProjection C k G) y
  set H : ℝ → ℂ := fun y : ℝ => ∑ k ∈ K, (Bk k : ℝ → ℂ) y with hHdef
  -- the Fourier transforms
  have hFA : ∀ w : ℝ, 𝓕 (A : ℝ → ℂ) w =
      𝓕 (ψj : ℝ → ℂ) w * 𝓕 (G : ℝ → ℂ) w := by
    intro w
    rw [hAf]
    exact Real.fourier_mul_convolution_eq (R := ℂ) ψj.integrable G.integrable w
  have hFB : ∀ (k : ℤ) (w : ℝ), 𝓕 (Bk k : ℝ → ℂ) w =
      𝓕 (ψj : ℝ → ℂ) w * 𝓕 (brsLineProjection C k G : ℝ → ℂ) w := by
    intro k w
    rw [hBf k]
    exact Real.fourier_mul_convolution_eq (R := ℂ) ψj.integrable
      (brsLineProjection C k G).integrable w
  have hFH : ∀ w : ℝ, 𝓕 H w = ∑ k ∈ K, 𝓕 (Bk k : ℝ → ℂ) w := by
    intro w
    exact fourier_finset_sum K (fun k => (Bk k : ℝ → ℂ))
      (fun k _ => (Bk k).integrable) w
  have hψjfun : (ψj : ℝ → ℂ) =
      fun y : ℝ => (((2 : ℝ) ^ j : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j * y) := by
    funext y
    rw [hψjdef]
    exact brsSchwartzDilate_apply ψ j y
  have hEq : 𝓕 (A : ℝ → ℂ) = 𝓕 H := by
    funext w
    rw [hFA w, hFH w]
    simp only [hFB]
    by_cases hz : 𝓕 (ψj : ℝ → ℂ) w = 0
    · rw [hz]
      simp
    · have hz' : 𝓕 (fun y : ℝ =>
          (((2 : ℝ) ^ j : ℝ) : ℂ) * ψ ((2 : ℝ) ^ j * y)) w ≠ 0 := by
        rw [← hψjfun]
        exact hz
      obtain ⟨h1, h2⟩ := fourier_dilate_support_annulus hψsupp j hz'
      have hsum := sum_intDyadicBandpass_Icc_eq_one C h1 h2
      have hpt : ∀ k ∈ K, 𝓕 (ψj : ℝ → ℂ) w *
          𝓕 (brsLineProjection C k G : ℝ → ℂ) w =
          (Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff k
            (brsLineIso w)) *
            (𝓕 (ψj : ℝ → ℂ) w * 𝓕 (G : ℝ → ℂ) w) := by
        intro k _
        rw [fourier_brsLineProjection]
        ring
      rw [Finset.sum_congr rfl hpt, ← Finset.sum_mul, hKdef, hsum, one_mul]
  -- inversion
  have hAint : Integrable (A : ℝ → ℂ) volume := A.integrable
  have hHint : Integrable H volume :=
    integrable_finsetSum K fun k _ => (Bk k).integrable
  have hFAint : Integrable (𝓕 (A : ℝ → ℂ)) volume := by
    rw [← SchwartzMap.fourier_coe]
    exact (𝓕 A).integrable
  have hHcont : Continuous H := by
    rw [hHdef]
    exact continuous_finsetSum K fun k _ => (Bk k).continuous
  have hres : (A : ℝ → ℂ) = H := by
    have h1 : 𝓕⁻ (𝓕 (A : ℝ → ℂ)) = (A : ℝ → ℂ) :=
      A.continuous.fourierInv_fourier_eq hAint hFAint
    have h2 : 𝓕⁻ (𝓕 H) = H :=
      hHcont.fourierInv_fourier_eq hHint (by rw [← hEq]; exact hFAint)
    rw [← h1, hEq, h2]
  have hgoal := congrFun hres x
  rw [hAf, hHdef] at hgoal
  simp only [hBf] at hgoal
  exact hgoal

/-! ## Young's inequality for a complex kernel

The same statement as `lintegral_convolution_rpow_le`, for a complex-valued
kernel: the second factor of the BRS resolution is complex, so the real-kernel
version does not apply to it directly. -/

/-- Tonelli for a convolution-type double integral. -/
theorem lintegral_convolution_swap_complex {p : ℝ} {K : ℝ → ℂ} (hK : Measurable K)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) =
      (∫⁻ y : ℝ, ‖K y‖ₑ) * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hjoint : Measurable fun z : ℝ × ℝ => ‖K z.2‖ₑ * ‖g (z.1 - z.2)‖ₑ ^ p := by
    have h1 : Measurable fun z : ℝ × ℝ => ‖K z.2‖ₑ :=
      (hK.comp measurable_snd).enorm
    have h2 : Measurable fun z : ℝ × ℝ => ‖g (z.1 - z.2)‖ₑ ^ p :=
      ((hg.comp (measurable_fst.sub measurable_snd)).enorm).pow_const p
    exact h1.mul h2
  rw [lintegral_lintegral_swap hjoint.aemeasurable]
  have hinner : ∀ y : ℝ, (∫⁻ x : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) =
      ‖K y‖ₑ * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
    intro y
    rw [lintegral_const_mul' _ _ (enorm_ne_top (x := K y))]
    congr 1
    exact lintegral_sub_right_eq_self (fun z => ‖g z‖ₑ ^ p) y
  rw [lintegral_congr hinner]
  exact lintegral_mul_const _ hK.enorm

/-- **Young's inequality** for an `L¹` kernel. -/
theorem lintegral_convolution_rpow_le_complex {p : ℝ} (hp : 1 ≤ p) {K : ℝ → ℂ}
    (hK : Measurable K) (hA : (∫⁻ y : ℝ, ‖K y‖ₑ) ≠ ⊤) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ x : ℝ, ‖∫ y : ℝ, K y * g (x - y)‖ₑ ^ p) ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ) ^ p * ∫⁻ z : ℝ, ‖g z‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  set A : ENNReal := ∫⁻ y : ℝ, ‖K y‖ₑ with hAdef
  set G : ENNReal := ∫⁻ z : ℝ, ‖g z‖ₑ ^ p with hGdef
  -- the pointwise estimate
  have hpt : ∀ x : ℝ, ‖∫ y : ℝ, K y * g (x - y)‖ₑ ^ p ≤
      A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
    intro x
    have hbase : ‖∫ y : ℝ, K y * g (x - y)‖ₑ ≤
        ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ := by
      refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
      refine lintegral_congr fun y => ?_
      rw [enorm_mul]
    rcases eq_or_lt_of_le hp with hp1 | hp1
    · rw [← hp1]
      simpa using hbase
    · -- Hölder with the conjugate exponent
      set q : ℝ := Real.conjExponent p with hq
      have hconj : q.HolderConjugate p :=
        (Real.HolderConjugate.conjExponent hp1).symm
      have hq0 : (0 : ℝ) < q := hconj.pos
      have hqinv : 1 / q + 1 / p = 1 := by
        have h1 := hconj.one_div_add_one_div
        simpa using h1
      have hsplit : ∀ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ =
          (‖K y‖ₑ ^ (1 / q)) * ((‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) := by
        intro y
        rw [← mul_assoc, ← ENNReal.rpow_add_of_nonneg _ _ (by positivity)
          (by positivity), hqinv, ENNReal.rpow_one]
      have hmeas1 : AEMeasurable (fun y : ℝ => ‖K y‖ₑ ^ (1 / q)) volume :=
        (hK.enorm.pow_const _).aemeasurable
      have hmeas2 : AEMeasurable
          (fun y : ℝ => (‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) volume :=
        ((hK.enorm.pow_const _).mul
          ((hg.comp (measurable_const.sub measurable_id)).enorm)).aemeasurable
      have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure ℝ)
        hconj hmeas1 hmeas2
      simp only [Pi.mul_apply] at hholder
      have hfirst : (∫⁻ y : ℝ, (‖K y‖ₑ ^ (1 / q)) ^ q) = A := by
        refine lintegral_congr fun y => ?_
        rw [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
      have hsecond : (∫⁻ y : ℝ, ((‖K y‖ₑ ^ (1 / p)) * ‖g (x - y)‖ₑ) ^ p) =
          ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
        refine lintegral_congr fun y => ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul, one_div,
          inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
      rw [hfirst, hsecond] at hholder
      have hbase' : ‖∫ y : ℝ, K y * g (x - y)‖ₑ ≤
          A ^ (1 / q) * (∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) ^ (1 / p) := by
        refine le_trans hbase ?_
        rw [lintegral_congr hsplit]
        exact hholder
      calc ‖∫ y : ℝ, K y * g (x - y)‖ₑ ^ p
          ≤ (A ^ (1 / q) *
              (∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p) ^ (1 / p)) ^ p :=
            ENNReal.rpow_le_rpow hbase' hp0.le
        _ = A ^ (p / q) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le, ← ENNReal.rpow_mul,
              ← ENNReal.rpow_mul]
            rw [show (1 : ℝ) / p * p = 1 by field_simp, ENNReal.rpow_one]
            congr 2
            rw [one_div]
            ring
        _ = A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p := by
            congr 2
            have h1 : 1 / q = 1 - 1 / p := by linarith [hqinv]
            have h2 : p / q = p * (1 / q) := by ring
            rw [h2, h1]
            field_simp
  -- integrate and swap
  calc (∫⁻ x : ℝ, ‖∫ y : ℝ, K y * g (x - y)‖ₑ ^ p)
      ≤ ∫⁻ x : ℝ, A ^ (p - 1) * ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p :=
        lintegral_mono hpt
    _ = A ^ (p - 1) * ∫⁻ x : ℝ, ∫⁻ y : ℝ, ‖K y‖ₑ * ‖g (x - y)‖ₑ ^ p :=
        lintegral_const_mul' _ _ (ENNReal.rpow_ne_top_of_nonneg (by linarith) hA)
    _ = A ^ (p - 1) * (A * G) := by
        rw [lintegral_convolution_swap_complex hK hg]
    _ = A ^ (p - 1) * A * G := by ring
    _ ≤ A ^ p * G := by
        refine mul_le_mul' ?_ le_rfl
        exact ennreal_rpow_sub_one_mul_le hp

/-! ## Young's inequality along the Schwartz dilates

The `L¹` norm of `ψ_j` does not depend on `j`, so every scale of the second
factor of the BRS resolution obeys Young's inequality with the same
constant. -/

theorem lintegral_enorm_schwartzDilate (ψ : SchwartzMap ℝ ℂ) (j : ℕ) :
    (∫⁻ y : ℝ, ‖(brsSchwartzDilate ψ j : ℝ → ℂ) y‖ₑ) =
      ∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ := by
  have hpos : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hne : ((2 : ℝ) ^ j) ≠ 0 := ne_of_gt hpos
  have hconst : ‖((((2 : ℝ) ^ j : ℝ)) : ℂ)‖ₑ = ENNReal.ofReal ((2 : ℝ) ^ j) := by
    rw [← ofReal_norm, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpos]
  have hpt : ∀ y : ℝ, ‖(brsSchwartzDilate ψ j : ℝ → ℂ) y‖ₑ =
      ENNReal.ofReal ((2 : ℝ) ^ j) * ‖(ψ : ℝ → ℂ) ((2 : ℝ) ^ j * y)‖ₑ := by
    intro y
    rw [brsSchwartzDilate_apply, enorm_mul, hconst]
  have hm : Measurable fun a : ℝ => ‖(ψ : ℝ → ℂ) ((2 : ℝ) ^ j * a)‖ₑ :=
    ((ψ.continuous.measurable).comp (measurable_const_mul ((2 : ℝ) ^ j))).enorm
  rw [lintegral_congr hpt, lintegral_const_mul _ hm,
    lintegral_comp_mul_left_ennreal ψ.continuous.measurable.enorm hne,
    abs_of_pos (inv_pos.mpr hpos), ← mul_assoc, ← ENNReal.ofReal_mul hpos.le,
    mul_inv_cancel₀ hne, ENNReal.ofReal_one, one_mul]

theorem lintegral_enorm_schwartz_ne_top (ψ : SchwartzMap ℝ ℂ) :
    (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ≠ ⊤ := by
  have h := (ψ.integrable (μ := volume)).hasFiniteIntegral
  rw [MeasureTheory.hasFiniteIntegral_iff_enorm] at h
  exact h.ne

/-- **Young's inequality along the Schwartz dilates.** -/
theorem lintegral_conv_schwartzDilate_rpow_le {p : ℝ} (hp : 1 ≤ p)
    (ψ : SchwartzMap ℝ ℂ) (j : ℕ) (h : SchwartzMap ℝ ℂ) :
    (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (h : ℝ → ℂ)) x‖ₑ ^ p) ≤
      (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ^ p * ∫⁻ z : ℝ, ‖(h : ℝ → ℂ) z‖ₑ ^ p := by
  have hcong : ∀ x : ℝ,
      ((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (h : ℝ → ℂ)) x =
      ∫ y : ℝ, (brsSchwartzDilate ψ j : ℝ → ℂ) y * (h : ℝ → ℂ) (x - y) :=
    fun x => convolution_mul_apply _ _ x
  have hA : (∫⁻ y : ℝ, ‖(brsSchwartzDilate ψ j : ℝ → ℂ) y‖ₑ) ≠ ⊤ := by
    rw [lintegral_enorm_schwartzDilate]
    exact lintegral_enorm_schwartz_ne_top ψ
  have hmain := lintegral_convolution_rpow_le_complex hp
    (brsSchwartzDilate ψ j).continuous.measurable hA h.continuous.measurable
  rw [lintegral_enorm_schwartzDilate] at hmain
  refine le_trans (le_of_eq (lintegral_congr fun x => ?_)) hmain
  rw [hcong x]

/-! ## The power-mean inequality in `ENNReal`

`(∑ a)^r ≤ card^{r−1} ∑ a^r` for `r ≥ 1`, the `ENNReal` companion of
`real_finset_rpow_sum_ge`.  It is what converts the three-term band
decomposition into a bound on the `p`-th powers. -/

theorem ennreal_rpow_finset_sum_le_card_mul {ι : Type*} (s : Finset ι) (a : ι → ENNReal)
    {r : ℝ} (hr : 1 ≤ r) :
    (∑ i ∈ s, a i) ^ r ≤ (s.card : ENNReal) ^ (r - 1) * ∑ i ∈ s, a i ^ r := by
  classical
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  rcases Finset.eq_empty_or_nonempty s with rfl | hs
  · simp [ENNReal.zero_rpow_of_pos hr0]
  · set N : ENNReal := (s.card : ENNReal) with hNdef
    have hcardpos : 0 < s.card := Finset.card_pos.mpr hs
    have hN0 : N ≠ 0 := by
      rw [hNdef]
      exact Nat.cast_ne_zero.mpr hcardpos.ne'
    have hNt : N ≠ ⊤ := by
      rw [hNdef]
      exact ENNReal.natCast_ne_top _
    have hw : (∑ _i ∈ s, N⁻¹) = 1 := by
      rw [Finset.sum_const, nsmul_eq_mul, hNdef, ENNReal.mul_inv_cancel hN0 hNt]
    have hmean := ENNReal.rpow_arith_mean_le_arith_mean_rpow s
      (fun _ => N⁻¹) a hw hr
    rw [← Finset.mul_sum, ← Finset.mul_sum,
      ENNReal.mul_rpow_of_nonneg _ _ hr0.le] at hmean
    have hstep : (∑ i ∈ s, a i) ^ r ≤ N ^ r * (N⁻¹ * ∑ i ∈ s, a i ^ r) := by
      have h := mul_le_mul' (le_refl (N ^ r)) hmean
      rwa [← mul_assoc, ← ENNReal.mul_rpow_of_nonneg _ _ hr0.le,
        ENNReal.mul_inv_cancel hN0 hNt, ENNReal.one_rpow, one_mul] at h
    refine le_trans hstep (le_of_eq ?_)
    rw [← mul_assoc]
    congr 1
    rw [← ENNReal.rpow_neg_one N, ← ENNReal.rpow_add _ _ hN0 hNt,
      show r + (-1 : ℝ) = r - 1 from by ring]

/-! ## One scale of the Littlewood--Paley piece

Combining the three-band decomposition with Young's inequality bounds the
`L^p` norm of `ψ_j ∗ G` by the `L^p` norms of the three dyadic projections it
meets, with a constant independent of the scale. -/

theorem continuous_schwartzDilate_conv (ψ : SchwartzMap ℝ ℂ) (j : ℕ)
    (h : SchwartzMap ℝ ℂ) :
    Continuous ((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (h : ℝ → ℂ)) := by
  refine (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ)
    (brsSchwartzDilate ψ j) h).continuous.congr fun x => ?_
  exact SchwartzMap.convolution_apply (ContinuousLinearMap.mul ℂ ℂ)
    (brsSchwartzDilate ψ j) h x

theorem card_Icc_sub_one_add_one (j : ℕ) :
    ((Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1)).card : ENNReal) = 3 := by
  rw [Int.card_Icc]
  have h : ((j : ℤ) + 1 + 1 - ((j : ℤ) - 1)) = 3 := by ring
  rw [h]
  rfl

open scoped FourierTransform in
/-- **One scale of the Littlewood--Paley piece.** -/
theorem lintegral_psiDilate_conv_rpow_le_sum
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p : ℝ} (hp : 1 ≤ p) (j : ℕ) (G : SchwartzMap ℝ ℂ) :
    (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (G : ℝ → ℂ)) x‖ₑ ^ p) ≤
      (3 : ENNReal) ^ (p - 1) * (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ^ p *
        ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1),
          ∫⁻ x : ℝ, ‖(brsLineProjection C k G : ℝ → ℂ) x‖ₑ ^ p := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  set K : Finset ℤ := Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1) with hKdef
  set ψj : SchwartzMap ℝ ℂ := brsSchwartzDilate ψ j with hψjdef
  have hmeas : ∀ k : ℤ, Measurable fun x : ℝ =>
      ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (brsLineProjection C k G : ℝ → ℂ)) x‖ₑ ^ p := by
    intro k
    exact ((continuous_schwartzDilate_conv ψ j
      (brsLineProjection C k G)).measurable.enorm).pow_const p
  have hpt : ∀ x : ℝ,
      ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) x‖ₑ ^ p ≤
        ((K.card : ENNReal)) ^ (p - 1) *
          ∑ k ∈ K, ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
            (brsLineProjection C k G : ℝ → ℂ)) x‖ₑ ^ p := by
    intro x
    rw [brsSchwartzDilate_conv_eq_sum C hψsupp j G x]
    refine le_trans (ENNReal.rpow_le_rpow (enorm_sum_le _ _) hp0.le) ?_
    exact ennreal_rpow_finset_sum_le_card_mul K _ hp
  have hcard : ((K.card : ENNReal)) = 3 := by
    rw [hKdef]
    exact card_Icc_sub_one_add_one j
  calc (∫⁻ x : ℝ, ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (G : ℝ → ℂ)) x‖ₑ ^ p)
      ≤ ∫⁻ x : ℝ, ((K.card : ENNReal)) ^ (p - 1) *
          ∑ k ∈ K, ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
            (brsLineProjection C k G : ℝ → ℂ)) x‖ₑ ^ p := lintegral_mono hpt
    _ = ((K.card : ENNReal)) ^ (p - 1) * ∫⁻ x : ℝ,
          ∑ k ∈ K, ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
            (brsLineProjection C k G : ℝ → ℂ)) x‖ₑ ^ p := by
        refine lintegral_const_mul' _ _ ?_
        rw [hcard]
        exact ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
    _ = ((K.card : ENNReal)) ^ (p - 1) * ∑ k ∈ K, ∫⁻ x : ℝ,
          ‖((ψj : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
            (brsLineProjection C k G : ℝ → ℂ)) x‖ₑ ^ p := by
        rw [lintegral_finsetSum K fun k _ => hmeas k]
    _ ≤ ((K.card : ENNReal)) ^ (p - 1) * ∑ k ∈ K,
          (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ^ p *
            ∫⁻ x : ℝ, ‖(brsLineProjection C k G : ℝ → ℂ) x‖ₑ ^ p := by
        refine mul_le_mul' le_rfl (Finset.sum_le_sum fun k _ => ?_)
        exact lintegral_conv_schwartzDilate_rpow_le hp ψ j
          (brsLineProjection C k G)
    _ = (3 : ENNReal) ^ (p - 1) * (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ^ p *
          ∑ k ∈ K, ∫⁻ x : ℝ,
            ‖(brsLineProjection C k G : ℝ → ℂ) x‖ₑ ^ p := by
        rw [← Finset.mul_sum, hcard, mul_assoc]

/-! ## Bounded overlap of the three-band windows

Each dyadic scale `k` belongs to at most three of the windows
`{j−1, j, j+1}`, so summing the windows over `j` costs a factor of `3`. -/

theorem Icc_sub_one_add_one_eq (j : ℤ) :
    Finset.Icc (j - 1) (j + 1) = {j - 1, j, j + 1} := by
  ext k
  simp only [Finset.mem_Icc, Finset.mem_insert, Finset.mem_singleton]
  omega

theorem sum_Icc_sub_one_add_one (c : ℤ → ENNReal) (j : ℤ) :
    (∑ k ∈ Finset.Icc (j - 1) (j + 1), c k) = c (j - 1) + c j + c (j + 1) := by
  rw [Icc_sub_one_add_one_eq j]
  rw [Finset.sum_insert (by simp; omega), Finset.sum_insert (by simp),
    Finset.sum_singleton, ← add_assoc]

/-- **Bounded overlap of the three-band windows.** -/
theorem sum_window_le_three_mul (J : Finset ℕ) (c : ℤ → ENNReal) :
    (∑ j ∈ J, ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1), c k) ≤
      3 * ∑ k ∈ J.biUnion
        (fun j : ℕ => Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1)), c k := by
  classical
  set K : Finset ℤ :=
    J.biUnion (fun j : ℕ => Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1)) with hK
  have hshift : ∀ i : ℤ, (∀ j ∈ J, (j : ℤ) + i ∈ K) →
      (∑ j ∈ J, c ((j : ℤ) + i)) ≤ ∑ k ∈ K, c k := by
    intro i hi
    have hinj : ∀ a ∈ J, ∀ b ∈ J, (a : ℤ) + i = (b : ℤ) + i → a = b := by
      intro a _ b _ hab
      have : (a : ℤ) = (b : ℤ) := by omega
      exact_mod_cast this
    rw [← Finset.sum_image hinj]
    refine Finset.sum_le_sum_of_subset ?_
    intro k hk
    obtain ⟨j, hj, rfl⟩ := Finset.mem_image.mp hk
    exact hi j hj
  have hmem : ∀ i : ℤ, -1 ≤ i → i ≤ 1 → ∀ j ∈ J, (j : ℤ) + i ∈ K := by
    intro i h1 h2 j hj
    rw [hK]
    refine Finset.mem_biUnion.mpr ⟨j, hj, ?_⟩
    rw [Finset.mem_Icc]
    omega
  have hsplit : (∑ j ∈ J, ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1), c k) =
      (∑ j ∈ J, c ((j : ℤ) + (-1))) + (∑ j ∈ J, c ((j : ℤ) + 0)) +
        ∑ j ∈ J, c ((j : ℤ) + 1) := by
    rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [sum_Icc_sub_one_add_one c (j : ℤ),
      show (j : ℤ) + (-1) = (j : ℤ) - 1 from by ring,
      show (j : ℤ) + 0 = (j : ℤ) from by ring]
  rw [hsplit]
  have h1 := hshift (-1) (hmem (-1) (by norm_num) (by norm_num))
  have h2 := hshift 0 (hmem 0 (by norm_num) (by norm_num))
  have h3 := hshift 1 (hmem 1 (by norm_num) (by norm_num))
  calc (∑ j ∈ J, c ((j : ℤ) + (-1))) + (∑ j ∈ J, c ((j : ℤ) + 0)) +
        ∑ j ∈ J, c ((j : ℤ) + 1)
      ≤ (∑ k ∈ K, c k) + (∑ k ∈ K, c k) + ∑ k ∈ K, c k :=
        add_le_add (add_le_add h1 h2) h3
    _ = 3 * ∑ k ∈ K, c k := by ring

/-! ## Summing the Littlewood--Paley pieces, for Schwartz data

The three-band decomposition, Young's inequality with a scale-independent
constant, the bounded overlap of the windows, and the `ℓ^q` Littlewood--Paley
bound combine into the estimate that closes the `k`-sum of BRS (5.10). -/

open scoped FourierTransform in
/-- **`Σ_j ‖ψ_j ∗ G‖_p^q ≲ ‖G‖_p^q` for Schwartz `G`.** -/
theorem sum_lintegral_psiDilate_conv_le
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q) (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (J : Finset ℕ) (G : SchwartzMap ℝ ℂ),
      (∑ j ∈ J, (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ)
          ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) x‖ₑ ^ p) ^ (q / p)) ≤
        A * (∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p) ^ (q / p) := by
  classical
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hqp : (1 : ℝ) ≤ q / p := (one_le_div hp0).mpr hpq
  have hqp0 : (0 : ℝ) ≤ q / p := by linarith
  obtain ⟨A₀, hA₀, hLP⟩ := sum_lintegral_rpow_dyadic_lq_le_line C hp hq hpq
  set Cψ : ENNReal :=
    (3 : ENNReal) ^ (p - 1) * (∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ) ^ p with hCψ
  have hCψtop : Cψ ≠ ⊤ := by
    rw [hCψ]
    refine ENNReal.mul_ne_top ?_ ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
    · exact ENNReal.rpow_ne_top_of_nonneg hp0.le
        (lintegral_enorm_schwartz_ne_top ψ)
  refine ⟨Cψ ^ (q / p) * (3 : ENNReal) ^ (q / p - 1) * 3 * A₀, ?_, ?_⟩
  · refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_)
      (by norm_num)) hA₀
    · exact ENNReal.rpow_ne_top_of_nonneg hqp0 hCψtop
    · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) (by norm_num)
  intro J G
  set b : ℤ → ENNReal := fun k =>
    ∫⁻ x : ℝ, ‖(brsLineProjection C k G : ℝ → ℂ) x‖ₑ ^ p with hb
  have hstep1 : ∀ j ∈ J,
      (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ)
          ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) x‖ₑ ^ p) ^ (q / p) ≤
        Cψ ^ (q / p) * ((3 : ENNReal) ^ (q / p - 1) *
          ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1), b k ^ (q / p)) := by
    intro j _
    have h1 := lintegral_psiDilate_conv_rpow_le_sum C hψsupp hp.le j G
    refine le_trans (ENNReal.rpow_le_rpow h1 hqp0) ?_
    rw [hCψ, ENNReal.mul_rpow_of_nonneg _ _ hqp0]
    refine mul_le_mul' le_rfl ?_
    have h2 := ennreal_rpow_finset_sum_le_card_mul
      (Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1)) b hqp
    rwa [card_Icc_sub_one_add_one j] at h2
  have hbeq : ∀ k : ℤ, b k = ∫⁻ y : ℝ,
      ‖Auto.LittlewoodPaley.integerDyadicProjection C.cutoff k
        (brsSchwartzOfLine G) (brsLineEquiv.symm y)‖ₑ ^ p := by
    intro k
    rw [hb]
    refine lintegral_congr fun y => ?_
    rw [brsLineProjection_apply, brsLineIso_eq_symm]
  have hGeq : (∫⁻ y : ℝ,
      ‖(brsSchwartzOfLine G : Euclidean 1 → ℂ) (brsLineEquiv.symm y)‖ₑ ^ p) =
      ∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p := by
    refine lintegral_congr fun y => ?_
    rw [← brsLineIso_eq_symm, brsSchwartzOfLine_apply,
      LinearIsometryEquiv.symm_apply_apply]
  set K' : Finset ℤ :=
    J.biUnion (fun j : ℕ => Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1)) with hK'
  have hfinal : (∑ k ∈ K', b k ^ (q / p)) ≤
      A₀ * (∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p) ^ (q / p) := by
    have h := hLP K' (brsSchwartzOfLine G)
    rw [hGeq] at h
    refine le_trans (le_of_eq (Finset.sum_congr rfl fun k _ => ?_)) h
    rw [hbeq k]
  calc (∑ j ∈ J, (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ)
        ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) x‖ₑ ^ p) ^ (q / p))
      ≤ ∑ j ∈ J, Cψ ^ (q / p) * ((3 : ENNReal) ^ (q / p - 1) *
          ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1), b k ^ (q / p)) :=
        Finset.sum_le_sum hstep1
    _ = Cψ ^ (q / p) * (3 : ENNReal) ^ (q / p - 1) *
          ∑ j ∈ J, ∑ k ∈ Finset.Icc ((j : ℤ) - 1) ((j : ℤ) + 1),
            b k ^ (q / p) := by
        rw [← Finset.mul_sum, ← Finset.mul_sum, mul_assoc]
    _ ≤ Cψ ^ (q / p) * (3 : ENNReal) ^ (q / p - 1) *
          (3 * ∑ k ∈ K', b k ^ (q / p)) := by
        refine mul_le_mul' le_rfl ?_
        exact sum_window_le_three_mul J (fun k => b k ^ (q / p))
    _ ≤ Cψ ^ (q / p) * (3 : ENNReal) ^ (q / p - 1) *
          (3 * (A₀ * (∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p) ^ (q / p))) := by
        refine mul_le_mul' le_rfl (mul_le_mul' le_rfl hfinal)
    _ = Cψ ^ (q / p) * (3 : ENNReal) ^ (q / p - 1) * 3 * A₀ *
          (∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p) ^ (q / p) := by
        ring

/-! ## Young's inequality in `eLpNorm` form

The density argument that carries the Littlewood--Paley sum from Schwartz data
to the `L^p` functions of the chain runs through Minkowski's inequality, which
Mathlib states for `eLpNorm`.  These are the translations. -/

theorem eLpNorm_ofReal_eq (f : ℝ → ℂ) {p : ℝ} (hp : 0 < p)
    (hf : AEStronglyMeasurable f volume) :
    eLpNorm f (ENNReal.ofReal p) volume =
      (∫⁻ x : ℝ, ‖f x‖ₑ ^ p) ^ (1 / p) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (by simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]; exact hp)
    ENNReal.ofReal_ne_top hf, ENNReal.toReal_ofReal hp.le]

/-- **Young's inequality, in `eLpNorm` form.** -/
theorem eLpNorm_convolution_le {p : ℝ} (hp : 1 ≤ p) {K : ℝ → ℂ}
    (hK : Measurable K) (hA : (∫⁻ y : ℝ, ‖K y‖ₑ) ≠ ⊤) {g : ℝ → ℂ}
    (hg : Measurable g) :
    eLpNorm (fun x : ℝ => ∫ y : ℝ, K y * g (x - y)) (ENNReal.ofReal p)
        volume ≤
      (∫⁻ y : ℝ, ‖K y‖ₑ) * eLpNorm g (ENNReal.ofReal p) volume := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp
  have hjoint : Measurable (fun z : ℝ × ℝ => K z.2 * g (z.1 - z.2)) :=
    (hK.comp measurable_snd).mul (hg.comp (measurable_fst.sub measurable_snd))
  rw [eLpNorm_ofReal_eq (fun x : ℝ => ∫ y : ℝ, K y * g (x - y)) hp0
      (hjoint.stronglyMeasurable.integral_prod_right' (ν := volume)).aestronglyMeasurable,
    eLpNorm_ofReal_eq _ hp0 hg.aestronglyMeasurable]
  have h := lintegral_convolution_rpow_le_complex hp hK hA hg
  refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
    ← ENNReal.rpow_mul, mul_one_div, div_self hp0.ne', ENNReal.rpow_one]

/-! ## Linearity of the convolution against a bounded function

The chain's input is bounded as well as continuous, so the integrand
`y ↦ K y · g(x−y)` is dominated by `‖g‖_∞ |K|` and no Hölder argument is needed
to split the convolution over a difference. -/

theorem integrable_kernel_mul_bdd_shift {K : ℝ → ℂ} (hK : Integrable K volume)
    {g : ℝ → ℂ} (hg : Measurable g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    (x : ℝ) : Integrable (fun y : ℝ => K y * g (x - y)) volume :=
  hK.mul_bdd (hg.comp (measurable_const.sub measurable_id)).aestronglyMeasurable
    (Filter.Eventually.of_forall fun _ => hgbd _)

/-- **The convolution splits over a difference.** -/
theorem convolution_sub_bdd {K : ℝ → ℂ} (hK : Integrable K volume)
    {g G : ℝ → ℂ} (hg : Measurable g) (hG : Measurable G)
    {Cg CG : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG)
    (x : ℝ) :
    (∫ y : ℝ, K y * g (x - y)) - ∫ y : ℝ, K y * G (x - y) =
      ∫ y : ℝ, K y * ((g - G) (x - y)) := by
  rw [← integral_sub (integrable_kernel_mul_bdd_shift hK hg hgbd x)
    (integrable_kernel_mul_bdd_shift hK hG hGbd x)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  change K y * g (x - y) - K y * G (x - y) = K y * (g (x - y) - G (x - y))
  ring

theorem integrable_schwartzDilate (ψ : SchwartzMap ℝ ℂ) (j : ℕ) :
    Integrable ((brsSchwartzDilate ψ j : ℝ → ℂ)) volume :=
  (brsSchwartzDilate ψ j).integrable

/-! ## The Littlewood--Paley sum in `eLpNorm` form

The Schwartz statement, restated for `eLpNorm`, together with the limiting
device used to remove the approximation error. -/

/-- If `X ≤ B + c·ε` for every `ε > 0` and `c` is finite, then `X ≤ B`. -/
theorem ennreal_le_of_forall_add_mul {X B c : ENNReal} (hc : c ≠ ⊤)
    (h : ∀ ε : ℝ, 0 < ε → X ≤ B + c * ENNReal.ofReal ε) : X ≤ B := by
  have hlim : Tendsto
      (fun n : ℕ => B + c * ENNReal.ofReal (1 / (n + 1 : ℝ))) atTop (𝓝 B) := by
    have h1 : Tendsto (fun n : ℕ => (1 / (n + 1 : ℝ))) atTop (𝓝 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have h2 : Tendsto (fun n : ℕ => ENNReal.ofReal (1 / (n + 1 : ℝ))) atTop
        (𝓝 0) := by
      rw [show (0 : ENNReal) = ENNReal.ofReal 0 from by simp]
      exact (ENNReal.continuous_ofReal.tendsto 0).comp h1
    have h3 : Tendsto (fun n : ℕ => c * ENNReal.ofReal (1 / (n + 1 : ℝ))) atTop
        (𝓝 0) := by
      have := ENNReal.Tendsto.const_mul h2 (Or.inr hc)
      simpa using this
    have h4 := h3.const_add B
    simpa using h4
  refine ge_of_tendsto hlim ?_
  filter_upwards with n
  exact h (1 / (n + 1 : ℝ)) (by positivity)

open scoped FourierTransform in
/-- The Littlewood--Paley sum for Schwartz data, in `eLpNorm` form. -/
theorem sum_eLpNorm_psiDilate_conv_schwartz
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q) (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (J : Finset ℕ) (G : SchwartzMap ℝ ℂ),
      (∑ j ∈ J, (eLpNorm (fun x : ℝ => ∫ y : ℝ,
          (brsSchwartzDilate ψ j : ℝ → ℂ) y * (G : ℝ → ℂ) (x - y))
            (ENNReal.ofReal p) volume) ^ q) ≤
        A * (eLpNorm (G : ℝ → ℂ) (ENNReal.ofReal p) volume) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨A, hA, hmain⟩ := sum_lintegral_psiDilate_conv_le C hψsupp hp hq hpq
  refine ⟨A, hA, fun J G => ?_⟩
  have hconv : ∀ j : ℕ, (fun x : ℝ => ∫ y : ℝ,
      (brsSchwartzDilate ψ j : ℝ → ℂ) y * (G : ℝ → ℂ) (x - y)) =
      ((brsSchwartzDilate ψ j : ℝ → ℂ) ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (G : ℝ → ℂ)) := by
    intro j
    funext x
    exact (convolution_mul_apply _ _ x).symm
  have hpow : ∀ (h : ℝ → ℂ), AEStronglyMeasurable h volume →
      (eLpNorm h (ENNReal.ofReal p) volume) ^ q =
        (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (q / p) := by
    intro h hh
    rw [eLpNorm_ofReal_eq h hp0 hh, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  calc (∑ j ∈ J, (eLpNorm (fun x : ℝ => ∫ y : ℝ,
        (brsSchwartzDilate ψ j : ℝ → ℂ) y * (G : ℝ → ℂ) (x - y))
          (ENNReal.ofReal p) volume) ^ q)
      = ∑ j ∈ J, (∫⁻ x : ℝ, ‖((brsSchwartzDilate ψ j : ℝ → ℂ)
          ⋆[ContinuousLinearMap.mul ℂ ℂ] (G : ℝ → ℂ)) x‖ₑ ^ p) ^ (q / p) := by
        refine Finset.sum_congr rfl fun j _ => ?_
        rw [hconv j, hpow _ ((brsSchwartzDilate ψ j).continuous.aestronglyMeasurable.convolution
          _ G.continuous.aestronglyMeasurable)]
    _ ≤ A * (∫⁻ x : ℝ, ‖(G : ℝ → ℂ) x‖ₑ ^ p) ^ (q / p) := hmain J G
    _ = A * (eLpNorm (G : ℝ → ℂ) (ENNReal.ofReal p) volume) ^ q := by
        rw [hpow _ G.continuous.aestronglyMeasurable]

/-! ## The Littlewood--Paley sum for the chain's input

The chain's input is bounded and continuous, not Schwartz.  Smooth compactly
supported functions are dense in `L^p`, the convolution splits over the
difference, and Young's inequality controls the error uniformly in the scale;
Minkowski's inequality in `ℓ^q` then absorbs the error, which vanishes in the
limit. -/

theorem continuous_kernel_conv_bdd {K : ℝ → ℂ} (hK : Integrable K volume)
    {h : ℝ → ℂ} (hh : Continuous h) {Ch : ℝ} (hhbd : ∀ z : ℝ, ‖h z‖ ≤ Ch) :
    Continuous (fun x : ℝ => ∫ y : ℝ, K y * h (x - y)) := by
  have hcont : Continuous
      (K ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] h) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hK hh
    refine ⟨Ch, ?_⟩
    rintro y ⟨z, rfl⟩
    exact hhbd z
  refine hcont.congr fun x => ?_
  exact convolution_mul_apply K h x

open scoped FourierTransform in
/-- **`Σ_j ‖ψ_j ∗ g‖_p^q ≲ ‖g‖_p^q` for bounded continuous `g`.** -/
theorem sum_eLpNorm_psiDilate_conv_le_bdd
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q) (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (J : Finset ℕ) (g : ℝ → ℂ) (Cg : ℝ),
      Continuous g → (∀ z : ℝ, ‖g z‖ ≤ Cg) →
      (∑ j ∈ J, (eLpNorm (fun x : ℝ => ∫ y : ℝ,
          (brsSchwartzDilate ψ j : ℝ → ℂ) y * g (x - y))
            (ENNReal.ofReal p) volume) ^ q) ≤
        A * (eLpNorm g (ENNReal.ofReal p) volume) ^ q := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq1 : (1 : ℝ) ≤ q := le_trans one_le_two hq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨A₁, hA₁, hSch⟩ :=
    sum_eLpNorm_psiDilate_conv_schwartz C hψsupp hp hq hpq
  set L : ENNReal := ∫⁻ y : ℝ, ‖(ψ : ℝ → ℂ) y‖ₑ with hLdef
  have hLtop : L ≠ ⊤ := lintegral_enorm_schwartz_ne_top ψ
  refine ⟨A₁ + 1, ENNReal.add_ne_top.mpr ⟨hA₁, by norm_num⟩, ?_⟩
  intro J g Cg hgc hgbd
  set P : ENNReal := ENNReal.ofReal p with hPdef
  have hP1 : (1 : ENNReal) ≤ P := by
    rw [hPdef, ← ENNReal.ofReal_one]
    exact ENNReal.ofReal_le_ofReal hp.le
  have hPtop : P ≠ ⊤ := ENNReal.ofReal_ne_top
  set N : ENNReal := eLpNorm g P volume with hNdef
  set Kj : ℕ → ℝ → ℂ := fun j => (brsSchwartzDilate ψ j : ℝ → ℂ) with hKjdef
  set Φ : ℕ → (ℝ → ℂ) → ℝ → ℂ := fun j h x => ∫ y : ℝ, Kj j y * h (x - y)
    with hΦdef
  have hKint : ∀ j : ℕ, Integrable (Kj j) volume := fun j =>
    (brsSchwartzDilate ψ j).integrable
  have hKmeas : ∀ j : ℕ, Measurable (Kj j) := fun j =>
    (brsSchwartzDilate ψ j).continuous.measurable
  have hKnorm : ∀ j : ℕ, (∫⁻ y : ℝ, ‖Kj j y‖ₑ) = L := fun j =>
    lintegral_enorm_schwartzDilate ψ j
  by_cases hNtop : N = ⊤
  · rw [hNtop, ENNReal.top_rpow_of_pos hq0]
    rw [ENNReal.mul_top (by simp : (A₁ + 1) ≠ 0)]
    exact le_top
  · have hmem : MemLp g P volume :=
      lt_top_iff_ne_top.mpr hNtop
    -- the ε-approximation bound
    have hkey : ∀ ε : ℝ, 0 < ε →
        (∑ j ∈ J, (eLpNorm (Φ j g) P volume) ^ q) ^ (1 / q) ≤
          A₁ ^ (1 / q) * N +
            (A₁ ^ (1 / q) + (J.card : ENNReal) ^ (1 / q) * L) *
              ENNReal.ofReal ε := by
      intro ε hε
      obtain ⟨G, hGcs, hGsm, hGapp⟩ := hmem.exist_eLpNorm_sub_le hPtop hP1 hε
      obtain ⟨CG, hCG⟩ :=
        hGsm.continuous.bounded_above_of_compact_support hGcs
      set GS : SchwartzMap ℝ ℂ := hGcs.toSchwartzMap hGsm with hGSdef
      have hGSc : (GS : ℝ → ℂ) = G := rfl
      have hdiffbd : ∀ z : ℝ, ‖(g - G) z‖ ≤ Cg + CG := by
        intro z
        change ‖g z - G z‖ ≤ Cg + CG
        exact le_trans (norm_sub_le _ _) (add_le_add (hgbd z) (hCG z))
      have hdiffcont : Continuous (g - G) := hgc.sub hGsm.continuous
      have hsplit : ∀ j : ℕ, Φ j g = Φ j G + Φ j (g - G) := by
        intro j
        funext x
        have h := convolution_sub_bdd (hKint j) hgc.measurable
          hGsm.continuous.measurable hgbd hCG x
        change (∫ y : ℝ, Kj j y * g (x - y)) =
          (∫ y : ℝ, Kj j y * G (x - y)) + ∫ y : ℝ, Kj j y * ((g - G) (x - y))
        rw [← h]
        ring
      have hstep : ∀ j : ℕ,
          eLpNorm (Φ j g) P volume ≤
            eLpNorm (Φ j G) P volume + L * ENNReal.ofReal ε := by
        intro j
        rw [hsplit j]
        refine le_trans (eLpNorm_add_le hP1) ?_
        refine add_le_add le_rfl ?_
        refine le_trans (eLpNorm_convolution_le hp.le (hKmeas j)
          (by rw [hKnorm j]; exact hLtop) hdiffcont.measurable) ?_
        rw [hKnorm j]
        exact mul_le_mul' le_rfl hGapp
      -- Minkowski in `ℓ^q`
      have hmono : (∑ j ∈ J, (eLpNorm (Φ j g) P volume) ^ q) ≤
          ∑ j ∈ J, (eLpNorm (Φ j G) P volume + L * ENNReal.ofReal ε) ^ q := by
        refine Finset.sum_le_sum fun j _ => ?_
        exact ENNReal.rpow_le_rpow (hstep j) hq0.le
      have hMink := ENNReal.Lp_add_le J
        (fun j => eLpNorm (Φ j G) P volume)
        (fun _ => L * ENNReal.ofReal ε) hq1
      have hconst : (∑ _j ∈ J, (L * ENNReal.ofReal ε) ^ q) ^ (1 / q) =
          (J.card : ENNReal) ^ (1 / q) * (L * ENNReal.ofReal ε) := by
        rw [Finset.sum_const, nsmul_eq_mul,
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, one_div, mul_inv_cancel₀ hq0.ne', ENNReal.rpow_one]
      have hGnorm : eLpNorm G P volume ≤ N + ENNReal.ofReal ε := by
        have hGG : G = g - (g - G) := by
          funext z
          change G z = g z - (g z - G z)
          ring
        rw [hGG]
        refine le_trans (eLpNorm_sub_le hP1) ?_
        exact add_le_add le_rfl hGapp
      have hSchG : (∑ j ∈ J, (eLpNorm (Φ j G) P volume) ^ q) ^ (1 / q) ≤
          A₁ ^ (1 / q) * (N + ENNReal.ofReal ε) := by
        have h := hSch J GS
        have hcong : ∀ j : ℕ, Φ j G = fun x : ℝ => ∫ y : ℝ,
            (brsSchwartzDilate ψ j : ℝ → ℂ) y * (GS : ℝ → ℂ) (x - y) := by
          intro j
          rw [hGSc]
        simp only [hcong] at *
        refine le_trans (ENNReal.rpow_le_rpow h (by positivity)) ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, one_div, mul_inv_cancel₀ hq0.ne', ENNReal.rpow_one,
          hGSc]
        exact mul_le_mul' le_rfl hGnorm
      calc (∑ j ∈ J, (eLpNorm (Φ j g) P volume) ^ q) ^ (1 / q)
          ≤ (∑ j ∈ J,
              (eLpNorm (Φ j G) P volume + L * ENNReal.ofReal ε) ^ q) ^ (1 / q) :=
            ENNReal.rpow_le_rpow hmono (by positivity)
        _ ≤ (∑ j ∈ J, (eLpNorm (Φ j G) P volume) ^ q) ^ (1 / q) +
              (∑ _j ∈ J, (L * ENNReal.ofReal ε) ^ q) ^ (1 / q) := hMink
        _ = (∑ j ∈ J, (eLpNorm (Φ j G) P volume) ^ q) ^ (1 / q) +
              (J.card : ENNReal) ^ (1 / q) * (L * ENNReal.ofReal ε) := by
            rw [hconst]
        _ ≤ A₁ ^ (1 / q) * (N + ENNReal.ofReal ε) +
              (J.card : ENNReal) ^ (1 / q) * (L * ENNReal.ofReal ε) :=
            add_le_add hSchG le_rfl
        _ = A₁ ^ (1 / q) * N +
              (A₁ ^ (1 / q) + (J.card : ENNReal) ^ (1 / q) * L) *
                ENNReal.ofReal ε := by
            rw [mul_add, add_mul, ← mul_assoc]
            ring
    have hX : (∑ j ∈ J, (eLpNorm (Φ j g) P volume) ^ q) ^ (1 / q) ≤
        A₁ ^ (1 / q) * N := by
      refine ennreal_le_of_forall_add_mul ?_ hkey
      refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
      · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hA₁
      · exact ENNReal.mul_ne_top
          (ENNReal.rpow_ne_top_of_nonneg (by positivity)
            (ENNReal.natCast_ne_top _)) hLtop
    have hfin : (∑ j ∈ J, (eLpNorm (Φ j g) P volume) ^ q) ≤ A₁ * N ^ q := by
      have h := ENNReal.rpow_le_rpow hX hq0.le
      rw [← ENNReal.rpow_mul, ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
        ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne',
        ENNReal.rpow_one, ENNReal.rpow_one] at h
      exact h
    exact le_trans hfin (mul_le_mul' (by exact le_self_add) le_rfl)

/-! ## The Littlewood--Paley sum, in the form the chain consumes

The BRS chain works with `∫⁻ ‖·‖ₑ^p` rather than `eLpNorm`; this is the same
statement in that language. -/

open scoped FourierTransform in
/-- **`Σ_j ‖ψ_j ∗ g‖_p^q ≲ ‖g‖_p^q`, in `∫⁻` form.** -/
theorem sum_lintegral_psiDilate_conv_le_bdd
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q) (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (J : Finset ℕ) (g : ℝ → ℂ) (Cg : ℝ),
      Continuous g → (∀ z : ℝ, ‖g z‖ ≤ Cg) →
      (∑ j ∈ J, (∫⁻ x : ℝ, ‖∫ y : ℝ,
          (brsSchwartzDilate ψ j : ℝ → ℂ) y * g (x - y)‖ₑ ^ p) ^ (q / p)) ≤
        A * (∫⁻ x : ℝ, ‖g x‖ₑ ^ p) ^ (q / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨A, hA, hmain⟩ := sum_eLpNorm_psiDilate_conv_le_bdd C hψsupp hp hq hpq
  refine ⟨A, hA, fun J g Cg hgc hgbd => ?_⟩
  have hpow : ∀ h : ℝ → ℂ, AEStronglyMeasurable h volume →
      (eLpNorm h (ENNReal.ofReal p) volume) ^ q =
        (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (q / p) := by
    intro h hh
    rw [eLpNorm_ofReal_eq h hp0 hh, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  have h := hmain J g Cg hgc hgbd
  rw [hpow g hgc.aestronglyMeasurable] at h
  refine le_trans (le_of_eq (Finset.sum_congr rfl fun j _ => ?_)) h
  rw [hpow _ (continuous_kernel_conv_bdd (brsSchwartzDilate ψ j).integrable hgc
    hgbd).aestronglyMeasurable]

/-! ## Associativity of the complex convolution

`(a ∗ b) ∗ G = a ∗ (b ∗ G)` for `a`, `b` integrable with `a` bounded and `G`
bounded continuous.  This is the identity that turns the resolution piece
`Ψ_j = υ_j ∗ ψ_j` acting on `G` into `υ_j` acting on the Littlewood--Paley
piece `ψ_j ∗ G`. -/

theorem integrable_bounded_mul_shift_complex {f : ℝ → ℂ} {C : ℝ}
    (hfm : Measurable f) (hbd : ∀ z : ℝ, ‖f z‖ ≤ C) {g : ℝ → ℂ}
    (hg : Integrable g volume) (y : ℝ) :
    Integrable (fun t : ℝ => f t * g (y - t)) volume := by
  have hshift : Integrable (fun t : ℝ => g (y - t)) volume := hg.comp_sub_left y
  exact hshift.bdd_mul hfm.aestronglyMeasurable
    (Filter.Eventually.of_forall hbd)

theorem integrable_mul_shift_of_bounded_complex {f : ℝ → ℂ}
    (hf : Integrable f volume) {g : ℝ → ℂ} {C : ℝ} (hgm : Measurable g)
    (hbd : ∀ z : ℝ, ‖g z‖ ≤ C) (y : ℝ) :
    Integrable (fun t : ℝ => f t * g (y - t)) volume :=
  hf.mul_bdd
    ((hgm.comp (measurable_const.sub measurable_id)).aestronglyMeasurable)
    (Filter.Eventually.of_forall fun _ => hbd _)

/-- **Associativity of the complex convolution.** -/
theorem brs_conv_assoc_mul {a b : ℝ → ℂ} (hameas : Measurable a)
    (ha : Integrable a volume) (hb : Integrable b volume) {Ma : ℝ}
    (hMa : ∀ z : ℝ, ‖a z‖ ≤ Ma) {G : ℝ → ℂ} (hG : Continuous G) {CG : ℝ}
    (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    ((a ⋆[ContinuousLinearMap.mul ℂ ℂ] b)
        ⋆[ContinuousLinearMap.mul ℂ ℂ] G) x =
      (a ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (b ⋆[ContinuousLinearMap.mul ℂ ℂ] G)) x := by
  have hauxcont : Continuous ((fun w : ℝ => ‖b w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hb.norm
      hG.norm
    refine ⟨CG, ?_⟩
    rintro y ⟨z, rfl⟩
    change ‖‖G z‖‖ ≤ CG
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hGbd z
  have hauxbd : ∀ z : ℝ, |((fun w : ℝ => ‖b w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) z| ≤
      CG * ∫ s : ℝ, ‖b s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖b w‖)
        ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    have hleft : Integrable (fun s : ℝ => ‖b s‖ * ‖G (z - s)‖) volume :=
      integrable_mul_shift_of_bounded' (C := CG) hb.norm hG.norm.measurable
        (fun w => by
          rw [abs_of_nonneg (norm_nonneg _)]
          exact hGbd w) z
    have hright : Integrable (fun s : ℝ => ‖b s‖ * CG) volume :=
      hb.norm.mul_const CG
    calc (∫ s : ℝ, ‖b s‖ * ‖G (z - s)‖)
        ≤ ∫ s : ℝ, ‖b s‖ * CG :=
          integral_mono hleft hright fun s =>
            mul_le_mul_of_nonneg_left (hGbd _) (norm_nonneg _)
      _ = CG * ∫ s : ℝ, ‖b s‖ := by
          rw [integral_mul_const]
          ring
  refine convolution_assoc _ _ _ _ (fun u v w => mul_assoc u v w)
    ha.aestronglyMeasurable hb.aestronglyMeasurable hG.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_bounded_mul_shift_complex hameas hMa hb y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' (C := CG) hb.norm hG.norm.measurable
      (fun w => by
        rw [abs_of_nonneg (norm_nonneg _)]
        exact hGbd w) u
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' ha.norm hauxcont.measurable hauxbd x

/-! ## The telescoping piece at scale `j`, factored

Dilating the factorization of the piece at scale `0` gives the factorization at
every scale: `Ψ_j = υ_j ∗ ψ_j`. -/

theorem brsDilate_brsDilate (φ : ℝ → ℝ) (i j : ℕ) (x : ℝ) :
    brsDilate (brsDilate φ i) j x = brsDilate φ (i + j) x := by
  change (2 : ℝ) ^ j * ((2 : ℝ) ^ i * φ ((2 : ℝ) ^ i * ((2 : ℝ) ^ j * x))) =
    (2 : ℝ) ^ (i + j) * φ ((2 : ℝ) ^ (i + j) * x)
  rw [show (2 : ℝ) ^ i * ((2 : ℝ) ^ j * x) = (2 : ℝ) ^ (i + j) * x from by
    rw [pow_add]
    ring, pow_add]
  ring

theorem brsDilate_brsLPKernel (φ : ℝ → ℝ) (j : ℕ) (x : ℝ) :
    brsDilate (brsLPKernel φ 0) j x = brsLPKernel φ j x := by
  have hsub : brsDilate (brsLPKernel φ 0) j x =
      brsDilate (brsDilate φ 1) j x - brsDilate (brsDilate φ 0) j x := by
    change (2 : ℝ) ^ j * (brsDilate φ 1 ((2 : ℝ) ^ j * x) -
        brsDilate φ 0 ((2 : ℝ) ^ j * x)) =
      (2 : ℝ) ^ j * brsDilate φ 1 ((2 : ℝ) ^ j * x) -
        (2 : ℝ) ^ j * brsDilate φ 0 ((2 : ℝ) ^ j * x)
    ring
  rw [hsub, brsDilate_brsDilate, brsDilate_brsDilate]
  change brsDilate φ (1 + j) x - brsDilate φ (0 + j) x =
    brsDilate φ (j + 1) x - brsDilate φ j x
  rw [show 1 + j = j + 1 from by omega, show 0 + j = j from by omega]

/-- **The factorization of the telescoping piece at scale `j`.** -/
theorem brsLPKernel_eq_conv_dilate {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    {pf : ℝ → ℝ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (j : ℕ) (x : ℝ) :
    ((fun y : ℝ => ((brsDilate υ j y : ℝ) : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ]
      ((brsSchwartzDilate S j : ℝ → ℂ))) x =
      ((brsLPKernel pf j x : ℝ) : ℂ) := by
  have hlam : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have h1 : (fun y : ℝ => ((brsDilate υ j y : ℝ) : ℂ)) =
      fun y : ℝ => (((2 : ℝ) ^ j : ℝ) : ℂ) * ((υ ((2 : ℝ) ^ j * y) : ℝ) : ℂ) := by
    funext y
    change ((2 ^ j * υ (2 ^ j * y) : ℝ) : ℂ) = _
    push_cast
    ring
  have h2 : ((brsSchwartzDilate S j : ℝ → ℂ)) =
      fun y : ℝ => (((2 : ℝ) ^ j : ℝ) : ℂ) * (S : ℝ → ℂ) ((2 : ℝ) ^ j * y) := by
    funext y
    exact brsSchwartzDilate_apply S j y
  rw [h1, h2]
  have hdil := convolution_mul_dilate (fun u : ℝ => (υ u : ℂ))
    ((S : ℝ → ℂ)) hlam x
  rw [hdil, hfac]
  change (((2 : ℝ) ^ j : ℝ) : ℂ) *
      ((brsLPKernel pf 0 ((2 : ℝ) ^ j * x) : ℝ) : ℂ) = _
  rw [← brsDilate_brsLPKernel pf j x]
  change _ = ((2 ^ j * brsLPKernel pf 0 (2 ^ j * x) : ℝ) : ℂ)
  push_cast
  ring

/-! ## The resolution piece, tested through the Littlewood--Paley factor

`Ψ_j ∗ G = υ_j ∗ (ψ_j ∗ G)`: the piece of the resolution acting on the input is
the compactly supported factor acting on the Littlewood--Paley piece.  This is
the identity that lets `brs_5_9_near_covering_local` — which takes an arbitrary
`υ` — be applied with `ψ_j ∗ G` in place of `G`. -/

/-- **The resolution piece, factored through the Littlewood--Paley piece.** -/
theorem brs_piece_factor {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ} {pf : ℝ → ℝ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) {G : ℝ → ℂ} (hG : Continuous G) {CG : ℝ}
    (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (j : ℕ) (x : ℝ) :
    (∫ y : ℝ, ((brsLPKernel pf j y : ℝ) : ℂ) * G (x - y)) =
      ∫ y : ℝ, ((brsDilate υ j y : ℝ) : ℂ) *
        ∫ w : ℝ, (brsSchwartzDilate S j : ℝ → ℂ) w * G (x - y - w) := by
  set a : ℝ → ℂ := fun y : ℝ => ((brsDilate υ j y : ℝ) : ℂ) with hadef
  set b : ℝ → ℂ := (brsSchwartzDilate S j : ℝ → ℂ) with hbdef
  have hameas : Measurable a := by
    rw [hadef]
    exact (Complex.continuous_ofReal.comp
      (continuous_brsDilate hυcont j)).measurable
  have haint : Integrable a volume := by
    rw [hadef]
    exact (integrable_brsDilate hυint j).ofReal
  have habd : ∀ z : ℝ, ‖a z‖ ≤ (2 : ℝ) ^ j * Mυ := by
    intro z
    rw [hadef]
    change ‖((brsDilate υ j z : ℝ) : ℂ)‖ ≤ _
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_brsDilate_le hυbd j z
  have hbint : Integrable b volume := by
    rw [hbdef]
    exact (brsSchwartzDilate S j).integrable
  -- the two convolution identities
  have hL : (∫ y : ℝ, ((brsLPKernel pf j y : ℝ) : ℂ) * G (x - y)) =
      ((a ⋆[ContinuousLinearMap.mul ℂ ℂ] b)
        ⋆[ContinuousLinearMap.mul ℂ ℂ] G) x := by
    rw [convolution_mul_apply]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    change ((brsLPKernel pf j y : ℝ) : ℂ) * G (x - y) =
      (a ⋆[ContinuousLinearMap.mul ℂ ℂ] b) y * G (x - y)
    congr 1
    rw [hadef, hbdef]
    exact (brsLPKernel_eq_conv_dilate hfac j y).symm
  have hR : (a ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (b ⋆[ContinuousLinearMap.mul ℂ ℂ] G)) x =
      ∫ y : ℝ, a y * ∫ w : ℝ, b w * G (x - y - w) := by
    rw [convolution_mul_apply]
    refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
    change a y * (b ⋆[ContinuousLinearMap.mul ℂ ℂ] G) (x - y) =
      a y * ∫ w : ℝ, b w * G (x - y - w)
    rw [convolution_mul_apply b G (x - y)]
  rw [hL, brs_conv_assoc_mul hameas haint hbint habd hG hGbd x, hR]

/-! ## Associativity with the bound on the middle factor, and commutativity

The truncated kernel `h_k` is integrable but unbounded, so the associativity
lemma has to be available in the form where the *middle* factor carries the
sup bound. -/

theorem convolution_mul_comm (f g : ℝ → ℂ) :
    (f ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] g) =
      (g ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] f) := by
  have hflip : (ContinuousLinearMap.mul ℂ ℂ).flip =
      ContinuousLinearMap.mul ℂ ℂ :=
    ContinuousLinearMap.ext fun a =>
      ContinuousLinearMap.ext fun b => by
        change b * a = a * b
        ring
  rw [← convolution_flip (L := ContinuousLinearMap.mul ℂ ℂ) (f := f) (g := g),
    hflip]

/-- **Associativity of the complex convolution**, with the bound on the
middle factor instead of the outer one. -/
theorem brs_conv_assoc_mul' {a b : ℝ → ℂ} (hbmeas : Measurable b)
    (ha : Integrable a volume) (hb : Integrable b volume) {Mb : ℝ}
    (hMb : ∀ z : ℝ, ‖b z‖ ≤ Mb) {G : ℝ → ℂ} (hG : Continuous G) {CG : ℝ}
    (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    ((a ⋆[ContinuousLinearMap.mul ℂ ℂ] b)
        ⋆[ContinuousLinearMap.mul ℂ ℂ] G) x =
      (a ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (b ⋆[ContinuousLinearMap.mul ℂ ℂ] G)) x := by
  have hauxcont : Continuous ((fun w : ℝ => ‖b w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) := by
    refine BddAbove.continuous_convolution_right_of_integrable _ ?_ hb.norm
      hG.norm
    refine ⟨CG, ?_⟩
    rintro y ⟨z, rfl⟩
    change ‖‖G z‖‖ ≤ CG
    rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
    exact hGbd z
  have hauxbd : ∀ z : ℝ, |((fun w : ℝ => ‖b w‖)
      ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) z| ≤
      CG * ∫ s : ℝ, ‖b s‖ := by
    intro z
    have hnn : (0 : ℝ) ≤ ((fun w : ℝ => ‖b w‖)
        ⋆[ContinuousLinearMap.mul ℝ ℝ, volume] fun w : ℝ => ‖G w‖) z := by
      rw [convolution]
      refine integral_nonneg fun s => ?_
      simp only [ContinuousLinearMap.mul_apply']
      positivity
    rw [abs_of_nonneg hnn, convolution]
    simp only [ContinuousLinearMap.mul_apply']
    have hleft : Integrable (fun s : ℝ => ‖b s‖ * ‖G (z - s)‖) volume :=
      integrable_mul_shift_of_bounded' (C := CG) hb.norm hG.norm.measurable
        (fun w => by
          rw [abs_of_nonneg (norm_nonneg _)]
          exact hGbd w) z
    have hright : Integrable (fun s : ℝ => ‖b s‖ * CG) volume :=
      hb.norm.mul_const CG
    calc (∫ s : ℝ, ‖b s‖ * ‖G (z - s)‖)
        ≤ ∫ s : ℝ, ‖b s‖ * CG :=
          integral_mono hleft hright fun s =>
            mul_le_mul_of_nonneg_left (hGbd _) (norm_nonneg _)
      _ = CG * ∫ s : ℝ, ‖b s‖ := by
          rw [integral_mul_const]
          ring
  refine convolution_assoc _ _ _ _ (fun u v w => mul_assoc u v w)
    ha.aestronglyMeasurable hb.aestronglyMeasurable hG.aestronglyMeasurable
    ?_ ?_ ?_
  · filter_upwards with y
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded_complex ha hbmeas hMb y
  · filter_upwards with u
    simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' (C := CG) hb.norm hG.norm.measurable
      (fun w => by
        rw [abs_of_nonneg (norm_nonneg _)]
        exact hGbd w) u
  · simp only [ConvolutionExistsAt, ContinuousLinearMap.mul_apply']
    exact integrable_mul_shift_of_bounded' ha.norm hauxcont.measurable hauxbd x

/-! ## Commuting the Littlewood--Paley factor past the truncated kernel

`ψ_j ∗ (h_k ∗ G) = h_k ∗ (ψ_j ∗ G)`.  The truncated kernel is integrable but
unbounded, so the two associativity lemmas have to be used from opposite
sides, joined by commutativity. -/

theorem exists_bound_schwartz (f : SchwartzMap ℝ ℂ) :
    ∃ C : ℝ, ∀ x : ℝ, ‖f x‖ ≤ C := by
  obtain ⟨C, -, hC⟩ := f.decay 0 0
  refine ⟨C, fun x => ?_⟩
  have h := hC x
  rwa [pow_zero, one_mul, norm_iteratedFDeriv_zero] at h

theorem convolution_lsmul_eq_mul (K : ℝ → ℝ) (G : ℝ → ℂ) (x : ℝ) :
    (K ⋆[(ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] G) x =
      ((fun y : ℝ => (K y : ℂ))
        ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] G) x := by
  rw [convolution, convolution_mul_apply]
  refine integral_congr_ae (Filter.Eventually.of_forall fun t => ?_)
  change (ContinuousLinearMap.lsmul ℝ ℝ : ℝ →L[ℝ] ℂ →L[ℝ] ℂ) (K t) (G (x - t)) =
    ((K t : ℝ) : ℂ) * G (x - t)
  simp only [ContinuousLinearMap.lsmul_apply]
  rw [Complex.real_smul]

/-- **The Littlewood--Paley factor commutes past the truncated kernel.** -/
theorem conv_swap_middle {ψk hk : ℝ → ℂ} (hψmeas : Measurable ψk)
    (hψint : Integrable ψk volume) {Mψ : ℝ} (hψbd : ∀ z : ℝ, ‖ψk z‖ ≤ Mψ)
    (hkint : Integrable hk volume) {G : ℝ → ℂ} (hG : Continuous G) {CG : ℝ}
    (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    (ψk ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (hk ⋆[ContinuousLinearMap.mul ℂ ℂ] G)) x =
      (hk ⋆[ContinuousLinearMap.mul ℂ ℂ]
        (ψk ⋆[ContinuousLinearMap.mul ℂ ℂ] G)) x := by
  rw [← brs_conv_assoc_mul hψmeas hψint hkint hψbd hG hGbd x,
    ← brs_conv_assoc_mul' hψmeas hkint hψint hψbd hG hGbd x,
    convolution_mul_comm ψk hk]

/-! ## The resolution piece with the Littlewood--Paley factor extracted

`∫ Ψ_j · (h_k ∗ G) = ∫ (h_k ∗ υ_j) · (ψ_j ∗ G)`: the piece of the resolution,
tested against the input, is the compactly supported bump's truncated kernel
tested against the Littlewood--Paley piece.  This is the form
`brs_5_9_near_covering_local` estimates. -/

theorem norm_kernel_conv_bdd_le {K : ℝ → ℂ} (hK : Integrable K volume)
    {G : ℝ → ℂ} {CG : ℝ} (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG)
    (_hGmeas : Measurable G) (x : ℝ) :
    ‖∫ y : ℝ, K y * G (x - y)‖ ≤ CG * ∫ s : ℝ, ‖K s‖ := by
  have hbound : ∀ y : ℝ, ‖K y * G (x - y)‖ ≤ ‖K y‖ * CG := by
    intro y
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hGbd _) (norm_nonneg _)
  have hright : Integrable (fun y : ℝ => ‖K y‖ * CG) volume :=
    hK.norm.mul_const CG
  refine le_trans (norm_integral_le_of_norm_le hright
    (Filter.Eventually.of_forall hbound)) (le_of_eq ?_)
  rw [integral_mul_const]
  ring

/-- **The resolution piece, with the Littlewood--Paley factor extracted.** -/
theorem brs_piece_eq_lp (k j : ℕ) {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    {pf : ℝ → ℝ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) {G : ℝ → ℂ} (hG : Continuous G) {CG : ℝ}
    (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    (∫ y : ℝ, ((brsLPKernel pf j y : ℝ) : ℂ) *
        (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
          ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] G) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate υ j) y : ℝ) : ℂ) *
        ∫ w : ℝ, (brsSchwartzDilate S j : ℝ → ℂ) w * G (x - y - w) := by
  set ψj : ℝ → ℂ := (brsSchwartzDilate S j : ℝ → ℂ) with hψjdef
  set hkC : ℝ → ℂ := fun y : ℝ => ((brsTruncKernel k y : ℝ) : ℂ) with hkCdef
  set H : ℝ → ℂ := brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
    ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] G with hHdef
  set Q : ℝ → ℂ := fun z : ℝ => ∫ w : ℝ, ψj w * G (z - w) with hQdef
  -- basic facts
  obtain ⟨Mψ, hMψ⟩ := exists_bound_schwartz (brsSchwartzDilate S j)
  have hψint : Integrable ψj volume := (brsSchwartzDilate S j).integrable
  have hψmeas : Measurable ψj := (brsSchwartzDilate S j).continuous.measurable
  have hkint : Integrable hkC volume := (integrable_brsTruncKernel k).ofReal
  have hHcont : Continuous H := continuous_brsTruncKernel_convolution k hG hGbd
  have hHbd : ∀ z : ℝ, ‖H z‖ ≤ CG * ∫ s : ℝ, ‖brsTruncKernel k s‖ :=
    norm_brsTruncKernel_convolution_le k hG hGbd
  have hQcont : Continuous Q := by
    rw [hQdef]
    exact continuous_kernel_conv_bdd hψint hG hGbd
  have hQbd : ∀ z : ℝ, ‖Q z‖ ≤ CG * ∫ s : ℝ, ‖ψj s‖ := by
    intro z
    rw [hQdef]
    exact norm_kernel_conv_bdd_le hψint hGbd hG.measurable z
  -- Step 1: factor the piece
  have hstep1 := brs_piece_factor hfac hυcont hυint hυbd hHcont hHbd j x
  -- Step 2: commute `ψ_j` past `h_k`
  have hHeq : H = (hkC ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] G) := by
    funext z
    rw [hHdef, hkCdef]
    exact convolution_lsmul_eq_mul (brsTruncKernel k) G z
  have hstep2 : ∀ y : ℝ, (∫ w : ℝ, ψj w * H (x - y - w)) =
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] Q) (x - y) := by
    intro y
    have h1 : (∫ w : ℝ, ψj w * H (x - y - w)) =
        (ψj ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] H) (x - y) :=
      (convolution_mul_apply ψj H (x - y)).symm
    have hQeq : (ψj ⋆[ContinuousLinearMap.mul ℂ ℂ, volume] G) = Q := by
      funext z
      rw [hQdef]
      exact convolution_mul_apply ψj G z
    rw [h1, hHeq, conv_swap_middle hψmeas hψint hMψ hkint hG hGbd (x - y),
      convolution_lsmul_eq_mul (brsTruncKernel k) Q (x - y), hkCdef, hQeq]
  -- Step 3: put the truncated kernel on the bump
  have hstep3 := brs_piece_eq_int k (continuous_brsDilate hυcont j)
    (integrable_brsDilate hυint j) (fun z => abs_brsDilate_le hυbd j z)
    hQcont hQbd x
  rw [hstep1]
  refine Eq.trans (integral_congr_ae (Filter.Eventually.of_forall fun y => ?_))
    hstep3
  change ((brsDilate υ j y : ℝ) : ℂ) * (∫ w : ℝ, ψj w * H (x - y - w)) =
    ((brsDilate υ j y : ℝ) : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] Q) (x - y)
  rw [hstep2 y]

/-! ## The near part, decomposed with the Littlewood--Paley factor

The domination of the near part by the pieces of the resolution, with each
piece now carrying the compactly supported bump `υ` as its kernel and the
Littlewood--Paley piece `ψ_j ∗ g` as its input.  This is the form in which
`brs_5_9_near_covering_local` applies, and in which the `k`-sum closes at the
endpoint. -/

theorem brsRefl_brsRefl (g : ℝ → ℂ) : brsRefl (brsRefl g) = g := by
  funext z
  change g (-(-z)) = g z
  rw [neg_neg]

/-- The Littlewood--Paley piece of the input, reflected. -/
def brsLPInput (S : SchwartzMap ℝ ℂ) (j : ℕ) (g : ℝ → ℂ) : ℝ → ℂ :=
  brsRefl fun z : ℝ => ∫ w : ℝ,
    (brsSchwartzDilate S j : ℝ → ℂ) w * brsRefl g (z - w)

theorem brsRefl_brsLPInput (S : SchwartzMap ℝ ℂ) (j : ℕ) (g : ℝ → ℂ) :
    brsRefl (brsLPInput S j g) =
      fun z : ℝ => ∫ w : ℝ,
        (brsSchwartzDilate S j : ℝ → ℂ) w * brsRefl g (z - w) := by
  rw [brsLPInput, brsRefl_brsRefl]

/-- **The near part, decomposed with the Littlewood--Paley factor.** -/
theorem brsANearLeftAt_le_pieces_lp (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearLeftAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearPieceMax k (brsDilate pf (k + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax k (brsDilate υ (k + s + m))
            (brsLPInput S (k + s + m) g) E r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  rw [brsANearLeftAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine le_trans (iSup₂_mono fun t _ => ?_) iSup_add_tsum_le
  set x : ℝ := -(t - r) with hx
  have hres := brs_resolution_truncConv_int k s hpf hpfint hpfnorm hgrefl
    hgreflbd (norm_brsTruncKernel_convolution_le k hgrefl hgreflbd) x
  have hlow : (∫ y : ℝ, (brsDilate pf (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate pf (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq_int k (continuous_brsDilate hpf (k + s))
      (integrable_brsDilate hpfint (k + s))
      (fun z => abs_brsDilate_le hpfbd (k + s) z) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel pf (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate υ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl (brsLPInput S (k + s + m) g) (x - y) := by
    intro m
    rw [brsRefl_brsLPInput]
    exact brs_piece_eq_lp k (k + s + m) hfac hυcont hυint hυbd hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres

/-! ## The Littlewood--Paley input: size and regularity

`brsLPInput S j g` is bounded and continuous, and its `L^p` norm is that of
`ψ_j ∗ g` — reflection changes nothing. -/

theorem lintegral_enorm_rpow_neg {F : ℝ → ℂ} (hF : Measurable F) (p : ℝ) :
    (∫⁻ x : ℝ, ‖F (-x)‖ₑ ^ p) = ∫⁻ x : ℝ, ‖F x‖ₑ ^ p := by
  have hmeas : Measurable fun x : ℝ => ‖F x‖ₑ ^ p := hF.enorm.pow_const p
  have h := lintegral_comp_mul_left_ennreal (F := fun x : ℝ => ‖F x‖ₑ ^ p)
    hmeas (a := (-1 : ℝ)) (by norm_num)
  simp only [neg_one_mul] at h
  rw [h]
  norm_num

theorem lintegral_enorm_rpow_brsRefl {F : ℝ → ℂ} (hF : Measurable F) (p : ℝ) :
    (∫⁻ x : ℝ, ‖brsRefl F x‖ₑ ^ p) = ∫⁻ x : ℝ, ‖F x‖ₑ ^ p :=
  lintegral_enorm_rpow_neg hF p

theorem continuous_brsLPInput (S : SchwartzMap ℝ ℂ) (j : ℕ) {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    Continuous (brsLPInput S j g) := by
  rw [brsLPInput]
  refine continuous_brsRefl ?_
  exact continuous_kernel_conv_bdd (brsSchwartzDilate S j).integrable
    (continuous_brsRefl hg) (fun z => brsRefl_bounded hgbd z)

theorem norm_brsLPInput_le (S : SchwartzMap ℝ ℂ) (j : ℕ) {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) (z : ℝ) :
    ‖brsLPInput S j g z‖ ≤
      Cg * ∫ s : ℝ, ‖(brsSchwartzDilate S j : ℝ → ℂ) s‖ := by
  rw [brsLPInput]
  change ‖∫ w : ℝ,
    (brsSchwartzDilate S j : ℝ → ℂ) w * brsRefl g (-z - w)‖ ≤ _
  exact norm_kernel_conv_bdd_le (brsSchwartzDilate S j).integrable
    (fun y => brsRefl_bounded hgbd y) (continuous_brsRefl hg).measurable (-z)

/-- **The `L^p` norm of the Littlewood--Paley input.** -/
theorem lintegral_enorm_brsLPInput_eq (S : SchwartzMap ℝ ℂ) (j : ℕ)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    (p : ℝ) :
    (∫⁻ x : ℝ, ‖brsLPInput S j g x‖ₑ ^ p) =
      ∫⁻ x : ℝ, ‖∫ w : ℝ, (brsSchwartzDilate S j : ℝ → ℂ) w *
        brsRefl g (x - w)‖ₑ ^ p := by
  rw [brsLPInput]
  exact lintegral_enorm_rpow_brsRefl
    (continuous_kernel_conv_bdd (brsSchwartzDilate S j).integrable
      (continuous_brsRefl hg) (fun z => brsRefl_bounded hgbd z)).measurable p

/-! ## The near part on `I_k`, with the Littlewood--Paley factor

The window form of `brsANearLeftAt_le_pieces_lp`, in which each piece is a
`brsNearMax` with the compactly supported bump as kernel and the
Littlewood--Paley piece as input. -/

/-- **The near part on `I_k`, decomposed with the Littlewood--Paley
factor.** -/
theorem brsANearWindow_le_tsum_lp (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) g E r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
          (brsLPInput S (k + 1 + s + m) g) E r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_window hr
    have hmain := brsANearLeftAt_le_pieces_lp (k + 1) s (E := E) hg hgbd hpf
      hpfint hpfbd hpfnorm hfac hυcont hυint hυbd hcr
    refine le_trans hmain ?_
    have hpieces : brsNearPieceMax (k + 1) (brsDilate pf (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax (k + 1) (brsDilate υ (k + 1 + s + m))
            (brsLPInput S (k + 1 + s + m) g) E r ≤
        brsNearFullMax (k + 1) (brsDilate pf (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearFullMax (k + 1) (brsDilate υ (k + 1 + s + m))
            (brsLPInput S (k + 1 + s + m) g) E r :=
      add_le_add (brsNearPieceMax_le_full _ _ _ _ _)
        (ENNReal.tsum_le_tsum fun m => brsNearPieceMax_le_full _ _ _ _ _)
    refine le_trans (mul_le_mul' le_rfl hpieces) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-! ## The `(m, k)`-family with the Littlewood--Paley factor

The near part of `R₂^-`, aggregated over all the windows, with each piece
carrying the compactly supported bump as kernel and the Littlewood--Paley
piece as input. -/

/-- The `(m, k)`-family of pieces of the near part, with the Littlewood--Paley
factor. -/
def brsNearFamilyLP (s : ℕ) (pf υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ) (g : ℝ → ℂ)
    (E : Set ℝ) (m k : ℕ) (r : ℝ) : ENNReal :=
  match m with
  | 0 => brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) g E r
  | (m + 1) => brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
      (brsLPInput S (k + 1 + s + m) g) E r

theorem brsNearFamilyLP_zero (s : ℕ) (pf υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ)
    (g : ℝ → ℂ) (E : Set ℝ) (k : ℕ) (r : ℝ) :
    brsNearFamilyLP s pf υ S g E 0 k r =
      brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) g E r := rfl

theorem brsNearFamilyLP_succ (s : ℕ) (pf υ : ℝ → ℝ) (S : SchwartzMap ℝ ℂ)
    (g : ℝ → ℂ) (E : Set ℝ) (m k : ℕ) (r : ℝ) :
    brsNearFamilyLP s pf υ S g E (m + 1) k r =
      brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
        (brsLPInput S (k + 1 + s + m) g) E r := rfl

theorem brsNearFamilyLP_eq_zero_of_notMem {s : ℕ} {pf υ : ℝ → ℝ}
    {S : SchwartzMap ℝ ℂ} {g : ℝ → ℂ} {E : Set ℝ} (m k : ℕ) {r : ℝ}
    (hr : r ∉ brsWindowExt k) : brsNearFamilyLP s pf υ S g E m k r = 0 := by
  cases m with
  | zero => exact brsNearMax_eq_zero_of_notMem hr
  | succ m => exact brsNearMax_eq_zero_of_notMem hr

theorem measurable_brsNearFamilyLP (s : ℕ) {pf υ : ℝ → ℝ}
    (hpf : ContDiff ℝ 1 pf) (hpfcs : HasCompactSupport pf)
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ) (S : SchwartzMap ℝ ℂ)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    (E : Set ℝ) (m k : ℕ) :
    Measurable (brsNearFamilyLP s pf υ S g E m k) := by
  cases m with
  | zero =>
      exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hpf _)
        (hasCompactSupport_brsDilate hpfcs _) hg E
  | succ m =>
      exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hυ _)
        (hasCompactSupport_brsDilate hυcs _)
        (continuous_brsLPInput S (k + 1 + s + m) hg hgbd) E

/-- **The near part on `I_k`, bounded by the Littlewood--Paley family.** -/
theorem brsANearWindow_le_tsum_family_lp (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      ∑' m : ℕ, brsNearFamilyLP s pf υ S g E m k r := by
  refine le_trans (brsANearWindow_le_tsum_lp k s hg hgbd hpf hpfint hpfbd
    hpfnorm hfac hυcont hυint hυbd r) (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add
    (fun m : ℕ => brsNearFamilyLP s pf υ S g E m k r), brsNearFamilyLP_zero]
  congr 1

/-- **The near part of `R₂^-`, reduced to the Littlewood--Paley pieces.** -/
theorem brsNear_aggregate_lp (s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : ContDiff ℝ 1 pf) (hpfcs : HasCompactSupport pf)
    (hpfint : Integrable pf volume) {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ)
    (hυint : Integrable υ volume) {Mυ : ℝ} (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearFamilyLP s pf υ S g E m k r ^ q * ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hpt : ∀ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
      ∑' m : ℕ, ∑' k : ℕ, brsNearFamilyLP s pf υ S g E m k r := by
    intro r
    refine le_trans (ENNReal.tsum_le_tsum fun k =>
      brsANearWindow_le_tsum_family_lp k s hg hgbd hpf.continuous hpfint hpfbd
        hpfnorm hfac hυ.continuous hυint hυbd r) ?_
    exact le_of_eq ENNReal.tsum_comm
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow (hpt r) hq0.le) le_rfl)
    (by positivity)) ?_
  exact window_double_sum_le
    (fun m k r hr => brsNearFamilyLP_eq_zero_of_notMem m k hr)
    (fun m k => measurable_brsNearFamilyLP s hpf hpfcs hυ hυcs S hg hgbd E m k)
    hq

/-! ## The Littlewood--Paley sum over all scales

The finite-scale bound extends to the infinite sum, and along any arithmetic
progression of scales — the `k`-sum of the chain runs over `j = k + offset`. -/

open scoped FourierTransform in
/-- **The Littlewood--Paley sum over all scales.** -/
theorem tsum_lintegral_psiDilate_conv_le_bdd
    (C : Auto.LittlewoodPaley.lpCutoffs 1) {ψ : SchwartzMap ℝ ℂ}
    (hψsupp : ∀ ξ : ℝ, 𝓕 (ψ : ℝ → ℂ) ξ ≠ 0 → 1 ≤ |ξ| ∧ |ξ| ≤ 4)
    {p q : ℝ} (hp : 1 < p) (hq : 2 ≤ q) (hpq : p ≤ q) :
    ∃ A : ENNReal, A ≠ ⊤ ∧ ∀ (offset : ℕ) (g : ℝ → ℂ) (Cg : ℝ),
      Continuous g → (∀ z : ℝ, ‖g z‖ ≤ Cg) →
      (∑' k : ℕ, (∫⁻ x : ℝ, ‖∫ y : ℝ,
          (brsSchwartzDilate ψ (k + offset) : ℝ → ℂ) y *
            g (x - y)‖ₑ ^ p) ^ (q / p)) ≤
        A * (∫⁻ x : ℝ, ‖g x‖ₑ ^ p) ^ (q / p) := by
  classical
  obtain ⟨A, hA, hmain⟩ := sum_lintegral_psiDilate_conv_le_bdd C hψsupp hp hq hpq
  refine ⟨A, hA, fun offset g Cg hgc hgbd => ?_⟩
  set F : ℕ → ENNReal := fun j : ℕ => (∫⁻ x : ℝ, ‖∫ y : ℝ,
    (brsSchwartzDilate ψ j : ℝ → ℂ) y * g (x - y)‖ₑ ^ p) ^ (q / p) with hF
  change (∑' k : ℕ, F (k + offset)) ≤ A * (∫⁻ x : ℝ, ‖g x‖ₑ ^ p) ^ (q / p)
  rw [ENNReal.tsum_eq_iSup_sum]
  refine iSup_le fun s => ?_
  have hinj : ∀ a ∈ s, ∀ b ∈ s, a + offset = b + offset → a = b := by
    intro a _ b _ hab
    omega
  have himg : (∑ k ∈ s, F (k + offset)) =
      ∑ j ∈ s.image (fun k : ℕ => k + offset), F j :=
    (Finset.sum_image hinj).symm
  rw [himg, hF]
  exact hmain (s.image (fun k : ℕ => k + offset)) g Cg hgc hgbd


end Prop46
end
end Auto.Spherical.BRSRadial
