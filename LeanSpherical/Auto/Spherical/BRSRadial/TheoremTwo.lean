/-! ## Proposition 5.4 in terms of `p`, `q`, `β`, with a uniform constant -/

theorem prop54_brsRemTwoTwoLeft_pq_unif {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
