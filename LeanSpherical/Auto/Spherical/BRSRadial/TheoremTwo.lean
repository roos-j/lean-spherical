    hυC.continuous.integrable_of_hasCompactSupport hυcs
  obtain ⟨Mu, hbd⟩ : ∃ M : ℝ, ∀ x : ℝ, |υ x| ≤ M := by
    obtain ⟨C, hC⟩ := hυcs.exists_bound_of_continuous hυC.continuous
