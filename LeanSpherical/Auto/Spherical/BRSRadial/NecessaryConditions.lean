    _root_.Spherical.sphericalAverage t (fun y => f₀ ‖y‖) x =
        (((surfaceMass (d + 1))⁻¹ : ℝ) : ℂ) *
          ∫ ω : Metric.sphere (0 : Euclidean (d + 1)) 1,
            f₀ ‖x + t • (ω : Euclidean (d + 1))‖ ∂unitSurfaceMeasure (d + 1) := by
