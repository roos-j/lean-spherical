/-! ## The pieces of `𝔐_p^+`, with covering numbers and summed -/

theorem lintegral_brsMainFamilyR_zero_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamilyR s φ H E 0 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamilyR_zero_le s hcov hφ hφcs hφ' hφdcs hA hA' hH
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

theorem lintegral_brsMainFamilyR_succ_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
