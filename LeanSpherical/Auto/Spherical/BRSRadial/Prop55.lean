  exact ⟨by linarith, by linarith⟩


/-! ## The near part of the main terms, as a convolution

The extra weight `s^e` rides along with the profile: the near part of `𝔐_p^±`
is the truncated kernel against `s ↦ s^e g(s)`. -/

/-- **The near part of `𝔐_p^-`, as a convolution.** -/
theorem integral_mainNearPart_eq_conv {c a b e : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} :
    (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) := by
    have h := intervalIntegral.integral_comp_add_left
      (a := (0 : ℝ)) (b := b - a) (d := a)
      (f := fun s : ℝ => (Iio (a + c)).indicator
        (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Iio (a + c)).indicator
          (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show a + u ∈ Iio (a + c) by
        simp only [mem_Iio]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      rw [show a + u - a = u by ring]
      push_cast
      ring
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show a + u ∉ Iio (a + c) by
        simp only [mem_Iio, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Iio (a + c)).indicator
          (fun s => ((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (a + u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((a + u) ^ e : ℝ) : ℂ) * g (a + u)) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp

/-- **The near part of `𝔐_p^+`, as a convolution.** -/
theorem integral_mainNearPartRight_eq_conv {c a b e : ℝ} (hc : 0 < c)
    (hcb : a + c ≤ b) {g : ℝ → ℂ} :
    (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
  have hba : (0 : ℝ) ≤ b - a := by linarith
  have htrans : (∫ s in a..b, (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
      ∫ u in (0 : ℝ)..(b - a), (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) := by
    have h := intervalIntegral.integral_comp_sub_left
      (a := (0 : ℝ)) (b := b - a) (d := b)
      (f := fun s : ℝ => (Ioi (b - c)).indicator
        (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s)
    rw [h]
    congr 1 <;> ring
  rw [htrans]
  have hpt : ∀ u : ℝ, u ≠ c → 0 < u →
      (Ioi (b - c)).indicator
          (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
    intro u hune hupos
    by_cases huc : u < c
    · rw [Set.indicator_of_mem (show b - u ∈ Ioi (b - c) by
        simp only [mem_Ioi]
        linarith)]
      rw [brsTruncKernelAt,
        Set.indicator_of_mem (show u ∈ Ioc (0 : ℝ) c from ⟨hupos, huc.le⟩)]
      rw [show b - (b - u) = u by ring]
      push_cast
      ring
    · have hgt : c < u := lt_of_le_of_ne (not_lt.mp huc) (Ne.symm hune)
      rw [Set.indicator_of_notMem (show b - u ∉ Ioi (b - c) by
        simp only [mem_Ioi, not_lt]
        linarith)]
      rw [brsTruncKernelAt_eq_zero_of_notMem
        (show u ∉ Ioc (0 : ℝ) c from fun hcon => absurd hcon.2 (not_le.mpr hgt))]
      simp
  have hnull : ∀ᵐ u : ℝ, u ≠ c := by
    rw [ae_iff]
    simp
  have hae : ∀ᵐ u : ℝ, u ∈ Set.uIoc (0 : ℝ) (b - a) →
      (Ioi (b - c)).indicator
          (fun s => ((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) (b - u) =
        ((brsTruncKernelAt c u : ℝ) : ℂ) *
          ((((b - u) ^ e : ℝ) : ℂ) * g (b - u)) := by
    filter_upwards [hnull] with u hune humem
    rw [Set.uIoc_of_le hba] at humem
    exact hpt u hune humem.1
  rw [intervalIntegral.integral_congr_ae hae]
  rw [intervalIntegral.integral_of_le hba]
  refine setIntegral_eq_integral_of_forall_compl_eq_zero fun u hu => ?_
  have hzero : brsTruncKernelAt c u = 0 := by
    refine brsTruncKernelAt_eq_zero_of_notMem fun hcon => ?_
    exact hu ⟨hcon.1, by linarith [hcon.2]⟩
  rw [hzero]
  simp


/-! ## The near part of `𝔐_p^-`, identified

Absorbing the weight `s^e` into the profile puts the near part of the main term
into exactly the shape the resolution machinery consumes. -/

/-- The profile with the extra power absorbed. -/
def brsWeightedProfile (e : ℝ) (g : ℝ → ℂ) (z : ℝ) : ℂ := ((z ^ e : ℝ) : ℂ) * g z

theorem brsWeightedProfile_apply (e : ℝ) (g : ℝ → ℂ) (z : ℝ) :
    brsWeightedProfile e g z = ((z ^ e : ℝ) : ℂ) * g z := rfl

/-- **The near part of `𝔐_p^-`, identified.** -/
theorem brsMainNearLeftAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearLeftAt c E p g r =
      ENNReal.ofReal r⁻¹ *
        ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
              |r - t|‖ₑ := by
  have hr : (0 : ℝ) < r := lt_of_lt_of_le hc hcr
  have hrinv : (0 : ℝ) ≤ r⁻¹ := by positivity
  have hidentify : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      (∫ s in |r - t|..(r + t), (Iio (|r - t| + c)).indicator
          (fun s => ((s ^ (1 / 2 - 1 / p) *
            (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
          brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y)) |r - t| := by
    rintro t ⟨-, ht1, ht2⟩
    have hcb : |r - t| + c ≤ r + t := by
      rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
    rw [integral_mainNearPart_eq_conv hc hcb]
    change (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((|r - t| + u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (|r - t| + u))) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (-|r - t| - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    change ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((|r - t| + u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (|r - t| + u)) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (-|r - t| - u)
    rw [brsRefl_apply, brsWeightedProfile_apply,
      show -(-|r - t| - u) = |r - t| + u by ring]
  have hpt : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
          (Iio (|r - t| + c)).indicator
            (fun s => ((s ^ (1 / 2 - 1 / p) *
              (s - |r - t|) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal r⁻¹ *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
              |r - t|‖ₑ := by
    intro t ht
    rw [ENNReal.ofReal_mul hrinv, ofReal_norm, hidentify t ht]
  rw [brsMainNearLeftAt]
  rw [iSup_congr fun t => iSup_congr fun ht => hpt t ht]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## Splitting the window of the main term at `t = r`

The singular point of `𝔐_p^±` is `|r - t|`, which is `r - t` below `r` and
`t - r` above it.  Splitting there turns the maximal function into the two
shapes the localized maximal estimate already handles. -/

/-- **The two halves of the window.** -/
theorem iSup_abs_translate_le {E : Set ℝ} {F : ℝ → ℂ} (r : ℝ) {S : Set ℝ}
    (hS : S ⊆ E) :
    (⨆ t ∈ S, ‖brsRefl F |r - t|‖ₑ) ≤
      (⨆ t ∈ E, ‖F (t - r)‖ₑ) + ⨆ t ∈ E, ‖brsRefl F (t - r)‖ₑ := by
  refine iSup₂_le fun t ht => ?_
  rcases le_or_gt t r with hle | hgt
  · have habs : |r - t| = r - t := abs_of_nonneg (by linarith)
    rw [habs, brsRefl_apply, show -(r - t) = t - r by ring]
    exact le_trans (le_iSup₂_of_le t (hS ht) le_rfl) le_self_add
  · have habs : |r - t| = t - r := by
      rw [abs_sub_comm]
      exact abs_of_nonneg (by linarith)
    rw [habs]
    exact le_trans (le_iSup₂_of_le t (hS ht) le_rfl) le_add_self

/-- **The near part of `𝔐_p^-`, split into the two standard shapes.** -/
theorem brsMainNearLeftAt_le_split {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearLeftAt c E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ((⨆ t ∈ E, ‖∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (t - r - y)‖ₑ) +
          ⨆ t ∈ E, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
            ((brsTruncKernelAt c y : ℝ) : ℂ) *
              brsRefl (brsWeightedProfile (1 / 2 - 1 / p) g) (z - y))
                (t - r)‖ₑ) := by
  rw [brsMainNearLeftAt_eq hc hcr]
  exact mul_le_mul' le_rfl (iSup_abs_translate_le r Set.inter_subset_left)


/-! ## The unreflected decomposition

Evaluating the reflected decomposition at `-a` gives the same statement for the
convolution itself. -/

/-- **One value of the convolution, decomposed into the pieces.** -/
theorem enorm_conv_le_pieces (k s : ℕ) {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) {φ : ℝ → ℝ} (hφ : Continuous φ)
    (hφcs : HasCompactSupport φ) (hφnorm : (∫ x : ℝ, φ x) = 1) (a : ℝ) :
    ‖∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (a - y)‖ₑ ≤
      ‖∫ y : ℝ, ((brsTruncConvReal k (brsDilate φ (k + s)) y : ℝ) : ℂ) *
          brsRefl g (a - y)‖ₑ +
        ∑' m : ℕ, ‖∫ y : ℝ,
          ((brsTruncConvReal k (brsLPKernel φ (k + s + m)) y : ℝ) : ℂ) *
            brsRefl g (a - y)‖ₑ := by
  have h := enorm_brsRefl_conv_le_pieces k s hg hgbd hφ hφcs hφnorm (-a)
  simp only [brsRefl_apply, neg_neg] at h
  exact h


/-! ## The near part of `𝔐_p^-`, decomposed into the pieces

The radius is confined to `(2/3, 4)`, so the truncation can be taken at the
single scale `2^{-1} = 1/2`; there is no `k`-sum.  Both halves of the window
decompose into the same two families of pieces. -/

/-- The unreflected piece maximal function. -/
def brsMainMaxU (kt : ℕ) (Ψ : ℝ → ℝ) (G : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ E, ‖∫ y : ℝ, ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) *
    brsRefl G (t - r - y)‖ₑ

/-- **The near part of `𝔐_p^-`, decomposed.** -/
theorem brsMainNearLeftAt_le_pieces (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ((brsMainMaxU 1 (brsDilate φ (1 + s))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
            ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
          (brsNearFullMax 1 (brsDilate φ (1 + s))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
            ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
              (brsWeightedProfile (1 / 2 - 1 / p) g) E r)) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine le_trans (brsMainNearLeftAt_le_split hc hcr) ?_
  refine mul_le_mul' le_rfl (add_le_add ?_ ?_)
  · refine le_trans (iSup₂_mono fun t _ => enorm_conv_le_pieces 1 s hG hGbd hφ
      hφcs hφnorm (t - r)) iSup_add_tsum_le
  · refine le_trans (iSup₂_mono fun t _ => enorm_brsRefl_conv_le_pieces 1 s hG
      hGbd hφ hφcs hφnorm (t - r)) iSup_add_tsum_le


/-! ## The radial weight of the main terms is bounded

On `(2/3, 4)` the weight `r^{-q} · r` of the main terms is bounded by a
constant; there is no dyadic bookkeeping to do. -/

/-- **The radial weight of `𝔐_p^±` costs only a constant.** -/
theorem lintegral_main_weight_le (T : ℝ → ENNReal) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * ∫⁻ r : ℝ, T r ^ q := by
  have hpt : ∀ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
      (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * T r ^ q := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · have hr1 : (2 : ℝ) / 3 < r := hr.1
      have hr2 : r < 4 := hr.2
      have hrpos : (0 : ℝ) < r := by linarith
      have hinv : (0 : ℝ) < r⁻¹ := by positivity
      have hinvle : r⁻¹ ≤ 3 / 2 := by
        rw [inv_le_comm₀ hrpos (by norm_num)]
        linarith
      have hval : ((Ioo (2 / 3 : ℝ) 4).indicator
          (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r =
          ENNReal.ofReal (r⁻¹ ^ q * r) * T r ^ q := by
        rw [Set.indicator_of_mem hr,
          ENNReal.mul_rpow_of_nonneg _ _ hq.le,
          ENNReal.ofReal_rpow_of_pos hinv]
        rw [mul_comm (ENNReal.ofReal (r⁻¹ ^ q)) (T r ^ q), mul_assoc]
        rw [mul_comm (ENNReal.ofReal (r⁻¹ ^ q * r)) (T r ^ q)]
        congr 1
        rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hinv.le _)]
      rw [hval]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      have h1 : r⁻¹ ^ q ≤ (3 / 2 : ℝ) ^ q :=
        Real.rpow_le_rpow hinv.le hinvle hq.le
      have h2 : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q :=
        Real.rpow_nonneg (by norm_num) _
      nlinarith [Real.rpow_nonneg hinv.le q]
    · rw [Set.indicator_of_notMem hr, ENNReal.zero_rpow_of_pos hq, zero_mul]
      exact zero_le
  calc (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ * T r) r) ^ q * ENNReal.ofReal r)
      ≤ ∫⁻ r : ℝ, ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * T r ^ q :=
        lintegral_mono hpt
    _ = ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) * ∫⁻ r : ℝ, T r ^ q :=
        lintegral_const_mul' _ _ ENNReal.ofReal_ne_top

/-- **The near part of `𝔐_p^-`, with the radial cutoff made explicit.** -/
theorem brsMainNearLeftAt_le_indicator (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r => ENNReal.ofReal r⁻¹ *
          ((brsMainMaxU 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
            (brsNearFullMax 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r))) r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    have hhalf : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = 1 / 2 := by norm_num
    have hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r := by
      rw [hhalf]
      linarith [hr.1]
    exact brsMainNearLeftAt_le_pieces s hG hGbd hφ hφcs hφnorm hcr
  · rw [Set.indicator_of_notMem hr, brsMainNearLeftAt_eq_zero hE hr]


/-! ## The radial `L^q` norm of the near part of `𝔐_p^-` -/

/-- **The near part of `𝔐_p^-` in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearLeftAt_rpow_le (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ^ q *
        ENNReal.ofReal r) ≤
      ENNReal.ofReal ((3 / 2 : ℝ) ^ q * 4) *
        ∫⁻ r : ℝ,
          ((brsMainMaxU 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r) +
            (brsNearFullMax 1 (brsDilate φ (1 + s))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r +
              ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
                (brsWeightedProfile (1 / 2 - 1 / p) g) E r)) ^ q := by
  refine le_trans (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow
      (brsMainNearLeftAt_le_indicator s hE hG hGbd hφ hφcs hφnorm r) hq.le)
      le_rfl) ?_
  exact lintegral_main_weight_le _ hq

/-- The four families of pieces, as one indexed family. -/
def brsMainFamily (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (n : ℕ) (r : ℝ) : ENNReal :=
  match n with
  | 0 => brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r
  | 1 => brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r
  | (m + 2) =>
      brsMainMaxU 1 (brsLPKernel φ (1 + s + m)) (brsWeightedProfile e g) E r +
        brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
          (brsWeightedProfile e g) E r


/-! ## The four families as one -/

theorem brsMainFamily_zero (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamily s φ e g E 0 r =
      brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r := rfl

theorem brsMainFamily_one (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamily s φ e g E 1 r =
      brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r := rfl

theorem brsMainFamily_succ_succ (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ)
    (E : Set ℝ) (m : ℕ) (r : ℝ) : brsMainFamily s φ e g E (m + 1 + 1) r =
      brsMainMaxU 1 (brsLPKernel φ (1 + s + m)) (brsWeightedProfile e g) E r +
        brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
          (brsWeightedProfile e g) E r := rfl

/-- **The four families, collected into one sum.** -/
theorem brsMainFamily_tsum (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) :
    (brsMainMaxU 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r +
          ∑' m : ℕ, brsMainMaxU 1 (brsLPKernel φ (1 + s + m))
            (brsWeightedProfile e g) E r) +
        (brsNearFullMax 1 (brsDilate φ (1 + s)) (brsWeightedProfile e g) E r +
          ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
            (brsWeightedProfile e g) E r) =
      ∑' n : ℕ, brsMainFamily s φ e g E n r := by
  rw [ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamily s φ e g E n r),
    ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamily s φ e g E (n + 1) r)]
  simp only [brsMainFamily_zero, brsMainFamily_succ_succ]
  rw [ENNReal.tsum_add, brsMainFamily_one]
  ring


/-! ## Measurability of the main-term families -/

theorem measurable_brsMainMaxU (kt : ℕ) {Ψ : ℝ → ℝ} (hΨ : ContDiff ℝ 1 Ψ)
    (hcs : HasCompactSupport Ψ) {G : ℝ → ℂ} (hG : Continuous G) (E : Set ℝ) :
    Measurable (brsMainMaxU kt Ψ G E) := by
  have hgr : Continuous (brsRefl G) := continuous_brsRefl hG
  have hFcont : Continuous fun x : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl G (x - y) := by
    have hderiv := fun x : ℝ => hasDerivAt_kernel_convolution
      (hasCompactSupport_brsTruncConvReal kt hcs)
      (contDiff_brsTruncConvReal kt (n := 1) hΨ hcs) hgr x
    have hdiff : Differentiable ℝ fun x : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal kt Ψ y : ℝ) : ℂ) * brsRefl G (x - y) :=
      fun x => (hderiv x).differentiableAt
    exact hdiff.continuous
  exact measurable_iSup_enorm_translate hFcont E

theorem measurable_brsMainFamily (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (e : ℝ) {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) (E : Set ℝ) (n : ℕ) :
    Measurable (brsMainFamily s φ e g E n) := by
  match n with
  | 0 =>
      exact measurable_brsMainMaxU 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hG E
  | 1 =>
      exact measurable_brsNearFullMax 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hG E
  | (m + 2) =>
      have hlp : ContDiff ℝ 1 (brsLPKernel φ (1 + s + m)) :=
        (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)
      exact (measurable_brsMainMaxU 1 hlp
        (hasCompactSupport_brsLPKernel hφcs _) hG E).add
          (measurable_brsNearFullMax 1 hlp
            (hasCompactSupport_brsLPKernel hφcs _) hG E)

/-! ## The near part of `𝔐_p^-`, reduced to the individual pieces -/

/-- **The near part of `𝔐_p^-`, reduced to the pieces.** -/
theorem lintegral_brsMainNear_Lp_le (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamily s φ (1 / 2 - 1 / p) g E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_brsMainNearLeftAt_rpow_le s hE hG hGbd hφ.continuous
    hφcs hφnorm hq0
  simp only [brsMainFamily_tsum] at hstep
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamily s hφ hφcs (1 / 2 - 1 / p) hG E n)


/-! ## The localized maximal estimate for the unreflected family

`brsMainMaxU` is `brs_5_9_core`'s maximal function with the profile reflected,
so the same bracket appears; reflecting does not change the `L^p` norm. -/

/-- **The maximal estimate for the unreflected pieces.** -/
theorem lintegral_brsMainMaxU_rpow_le {E : Set ℝ} {δ : ℝ} (hδ : 0 < δ)
    {ι : Finset ℝ} (hcov : IsIntervalCover E δ ι) (kt : ℕ) {υ : ℝ → ℝ}
    (hcs : HasCompactSupport υ) (hυ : ContDiff ℝ 1 υ)
    (hcs' : HasCompactSupport (deriv υ)) (hυ' : ContDiff ℝ 1 (deriv υ))
    {G : ℝ → ℂ} (hG : Continuous G) {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r)
    (hrq : r < q) (hpq : p < q) (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainMaxU kt υ G E x ^ q) ≤
      (ι.card : ENNReal) *
        ((∫⁻ y : ℝ, ‖brsTruncConvReal kt υ y‖ₑ ^ r) ^ (1 / r) *
              (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p) +
            ENNReal.ofReal δ *
              ((∫⁻ y : ℝ, ‖brsTruncConvReal kt (deriv υ) y‖ₑ ^ r) ^ (1 / r) *
                (∫⁻ z : ℝ, ‖G z‖ₑ ^ p) ^ (1 / p))) ^ q := by
  have h := brs_5_9_core hδ hcov kt hcs hυ hcs' hυ' (continuous_brsRefl hG) hp
    hr hrq hpq hrel
  have hnorm : (∫⁻ z : ℝ, ‖brsRefl G z‖ₑ ^ p) = ∫⁻ z : ℝ, ‖G z‖ₑ ^ p :=
    lintegral_enorm_comp_neg G p
  rwa [hnorm] at h


/-! ## The kernel bracket of the low-frequency piece, on its own

The counterpart of `brs_5_9_bracket` for the piece that carries no
cancellation. -/

/-- **The kernel bracket of the low-frequency piece.** -/
theorem brs_low_bracket (k j : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hcs' : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {r : ℝ} (hr : 1 ≤ r) (hr2 : r < 2) (G : ENNReal) :
    (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
            (1 / r) * G) ≤
      ENNReal.ofReal ((A + A') * brsLowConst k r ^ (1 / r)) * G := by
  have hr0 : (0 : ℝ) < r := lt_of_lt_of_le zero_lt_one hr
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : 0 ≤ brsLowConst k r := brsLowConst_nonneg k hr2
  have hker : (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal (A * brsLowConst k r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_dilate_le_L1 k j hφ.continuous hcs hA
        hr hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst, Real.mul_rpow (Real.rpow_nonneg hAnn r) (by positivity),
      ← Real.rpow_mul hAnn, mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  have hker' : (∫⁻ y : ℝ,
      ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^ (1 / r) ≤
      ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst k r ^ (1 / r)) := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsTruncConvReal_deriv_dilate_le_L1 k j hφ
        hφ'.continuous hcs' hA' hr hr2) (by positivity)) (le_of_eq ?_)
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]
    congr 1
    rw [brsLowConst,
      Real.mul_rpow (Real.rpow_nonneg (by positivity) r) (by positivity),
      ← Real.rpow_mul (by positivity), mul_one_div, div_self (ne_of_gt hr0),
      Real.rpow_one]
  calc (∫⁻ y : ℝ, ‖brsTruncConvReal k (brsDilate φ j) y‖ₑ ^ r) ^ (1 / r) * G +
        ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
          ((∫⁻ y : ℝ, ‖brsTruncConvReal k (deriv (brsDilate φ j)) y‖ₑ ^ r) ^
            (1 / r) * G)
      ≤ ENNReal.ofReal (A * brsLowConst k r ^ (1 / r)) * G +
          ENNReal.ofReal ((2 : ℝ) ^ (-(j : ℝ))) *
            (ENNReal.ofReal ((2 : ℝ) ^ j * A' * brsLowConst k r ^ (1 / r)) *
              G) :=
        add_le_add (mul_le_mul' hker le_rfl)
          (mul_le_mul' le_rfl (mul_le_mul' hker' le_rfl))
    _ = ENNReal.ofReal ((A + A') * brsLowConst k r ^ (1 / r)) * G := by
        rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← add_mul,
          ← ENNReal.ofReal_add (by positivity) (by positivity)]
        congr 2
        rw [rpow_neg_natCast_two j]
        field_simp


/-! ## The two low-frequency pieces of the main term -/

/-- The smoothness data of a dilated profile. -/
theorem brsDilate_deriv_data {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (hφ' : ContDiff ℝ 1 (deriv φ))
    (hφdcs : HasCompactSupport (deriv φ)) (j : ℕ) :
    ContDiff ℝ 1 (brsDilate φ j) ∧ HasCompactSupport (brsDilate φ j) ∧
      ContDiff ℝ 1 (deriv (brsDilate φ j)) ∧
      HasCompactSupport (deriv (brsDilate φ j)) := by
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hderiv : deriv (brsDilate φ j) =
      brsDilate (fun x : ℝ => (2 : ℝ) ^ j * deriv φ x) j :=
    deriv_brsDilate_eq hφ j
  refine ⟨contDiff_brsDilate hφ j, hasCompactSupport_brsDilate hφcs j, ?_, ?_⟩
  · rw [hderiv]
    exact contDiff_brsDilate (contDiff_const.mul hφ') j
  · rw [hderiv]
    exact hasCompactSupport_brsDilate hφdcs.mul_left j

/-- **The unreflected low-frequency piece.** -/
theorem lintegral_brsMainFamily_zero_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsMainMaxU_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hG hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _

/-- **The reflected low-frequency piece.** -/
theorem lintegral_brsMainFamily_one_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hG hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _


/-! ## The high-frequency pieces of the main term

Index `m + 2` of the family is the sum of the two `m`-th Littlewood--Paley
pieces, so the convexity bound costs a factor `2^q`. -/

/-- **The `m`-th Littlewood--Paley piece of `𝔐_p^-`.** -/
theorem lintegral_brsMainFamily_succ_succ_le {E : Set ℝ} {ι : Finset ℝ} (m : ℕ)
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ι)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ q *
        ((ι.card : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkj : 5 * (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap 1 m
    have heq : 1 + (m + 3) = 1 + 3 + m := by omega
    rw [heq] at h
    simpa using h
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hυ hcs hυ' hcs' (1 + 3 + m)
  set U : ℝ → ENNReal := brsMainMaxU 1 (brsDilate υ (1 + 3 + m))
    (brsWeightedProfile e g) E with hU
  set R : ℝ → ENNReal := brsNearFullMax 1 (brsDilate υ (1 + 3 + m))
    (brsWeightedProfile e g) E with hRdef
  set B : ENNReal := (ι.card : ENNReal) *
    (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r)) *
        ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
      (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q with hB
  have hUb : (∫⁻ x : ℝ, U x ^ q) ≤ B := by
    refine le_trans (lintegral_brsMainMaxU_rpow_le hδ hcov 1 hdilcs hdil hdercs
      hdercd hG hp hr hrq hpq hrel) ?_
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
      (brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
        hmom' hr hkj _) hq0.le)
  have hRb : (∫⁻ x : ℝ, R x ^ q) ≤ B := by
    refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil
      hdercs hdercd hG hp hr hrq hpq hrel) ?_
    exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow
      (brs_5_9_bracket hυ hcs hR hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom
        hmom' hr hkj _) hq0.le)
  have hUmeas : Measurable U := measurable_brsMainMaxU 1 hdil hdilcs hG E
  have hfam : ∀ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x = U x + R x := by
    intro x
    rw [brsMainFamily_succ_succ, hU, hRdef, hυeq]
  have hpt : ∀ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (U x ^ q + R x ^ q) := by
    intro x
    rw [hfam x]
    exact ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq1
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hsum : (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * ((∫⁻ x : ℝ, U x ^ q) + ∫⁻ x : ℝ, R x ^ q) := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_const_mul' _ _ htop,
      lintegral_add_left' (hUmeas.pow_const q).aemeasurable]
  refine le_trans hsum ?_
  have hstep : (2 : ENNReal) ^ (q - 1) *
      ((∫⁻ x : ℝ, U x ^ q) + ∫⁻ x : ℝ, R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * (B + B) := mul_le_mul' le_rfl (add_le_add hUb hRb)
  refine le_trans hstep (le_of_eq ?_)
  have htwo : B + B = (2 : ENNReal) * B := by
    rw [two_mul]
  rw [htwo, ← mul_assoc]
  congr 1
  exact ennreal_rpow_sub_one_mul (by simp) hq1


/-! ## The main-term pieces, with covering numbers -/

/-- **The unreflected low-frequency piece, with the covering number.** -/
theorem lintegral_brsMainFamily_zero_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_zero_le s hcov hφ hφcs hφ' hφdcs hA hA' hG
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

/-- **The reflected low-frequency piece, with the covering number.** -/
theorem lintegral_brsMainFamily_one_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ≤
      (intervalCoveringNumber E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2) (-((1 + s : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_one_le s hcov hφ hφcs hφ' hφdcs hA hA' hG
    hp hr hrq hpq hrel hr2
  rwa [hcard] at h

/-- **The `m`-th Littlewood--Paley piece, with the covering number.** -/
theorem lintegral_brsMainFamily_succ_succ_covering {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ≤
      (2 : ENNReal) ^ q *
        ((intervalCoveringNumber E
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) : ENNReal) *
          (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r)) *
              ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
            (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)) ^ q) := by
  obtain ⟨ι, hcov, hcard⟩ := exists_intervalCover_card_eq_intervalCoveringNumber
    hE (Real.rpow_pos_of_pos (by norm_num : (0 : ℝ) < 2)
      (-((1 + 3 + m : ℕ) : ℝ)))
  have h := lintegral_brsMainFamily_succ_succ_le m hcov hυeq hυ hcs hR hυ' hcs'
    hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
  rwa [hcard] at h


/-! ## One term of the main-term sum, in geometric form

The covering number and the kernel gain combine into a single dyadic power. -/

/-- **One term, in geometric form.** -/
theorem brsMain_geometric_term {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {C s q : ℝ} (_hC : 0 ≤ C) (hq : 0 < q) (j : ℕ) (G : ENNReal) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal (C * ((2 : ℝ) ^ (-(j : ℝ))) ^ s) * G) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * C *
        (2 : ℝ) ^ ((β / q - s) * (j : ℝ))) * G := by
  have hbase : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq), ENNReal.rpow_one,
    ← mul_assoc]
  refine mul_le_mul' ?_ le_rfl
  have hNb : ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal)) ^
      (1 / q) ≤ ENNReal.ofReal ((Cβ * (2 : ℝ) ^ (β * (j : ℝ))) ^ (1 / q)) := by
    refine le_trans (ENNReal.rpow_le_rpow (hN j) (by positivity)) (le_of_eq ?_)
    exact ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)
  refine le_trans (mul_le_mul' hNb le_rfl) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _)]
  congr 1
  have h2 : (0 : ℝ) < 2 := by norm_num
  have e1 : (Cβ * (2 : ℝ) ^ (β * (j : ℝ))) ^ (1 / q) =
      Cβ ^ (1 / q) * (2 : ℝ) ^ (β * (j : ℝ) / q) := by
    rw [Real.mul_rpow hCβ (Real.rpow_nonneg h2.le _), ← Real.rpow_mul h2.le]
    congr 2
    field_simp
  have e2 : ((2 : ℝ) ^ (-(j : ℝ))) ^ s = (2 : ℝ) ^ (-(j : ℝ) * s) := by
    rw [← Real.rpow_mul h2.le]
  rw [e1, e2]
  calc Cβ ^ (1 / q) * (2 : ℝ) ^ (β * (j : ℝ) / q) * (C * (2 : ℝ) ^ (-(j : ℝ) * s))
      = Cβ ^ (1 / q) * C *
          ((2 : ℝ) ^ (β * (j : ℝ) / q) * (2 : ℝ) ^ (-(j : ℝ) * s)) := by ring
    _ = Cβ ^ (1 / q) * C * (2 : ℝ) ^ ((β / q - s) * (j : ℝ)) := by
        rw [← Real.rpow_add h2]
        congr 2
        ring


/-! ## Each term of the main-term sum, in geometric form -/

/-- A covering term with no dyadic gain. -/
theorem brsMain_covering_term {E : Set ℝ} {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {C q : ℝ} (hC : 0 ≤ C) (hq : 0 < q) (j : ℕ) (G : ENNReal) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) *
        (ENNReal.ofReal C * G) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * C *
        (2 : ℝ) ^ (β / q * (j : ℝ))) * G := by
  have h := brsMain_geometric_term hCβ hN (C := C) (s := 0) hC hq j G
  rw [Real.rpow_zero, mul_one, sub_zero] at h
  exact h

/-- **The unreflected low-frequency term.** -/
theorem brsMainFamily_zero_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 0 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (2 : ℝ) ^ (β / q * ((1 + s : ℕ) : ℝ))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : (0 : ℝ) ≤ (A + A') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_zero_covering hE s hφ hφcs hφ' hφdcs hA hA' hG hp
      hr hrq hpq hrel hr2) (by positivity)) ?_
  exact brsMain_covering_term hCβ hN hCnn hq0 (1 + s) _

/-- **The reflected low-frequency term.** -/
theorem brsMainFamily_one_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (s : ℕ)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamily s φ e g E 1 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) * ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (2 : ℝ) ^ (β / q * ((1 + s : ℕ) : ℝ))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hAnn : 0 ≤ A := le_trans (integral_nonneg fun y => abs_nonneg _) hA
  have hA'nn : 0 ≤ A' := le_trans (integral_nonneg fun y => abs_nonneg _) hA'
  have hCnn : (0 : ℝ) ≤ (A + A') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_one_covering hE s hφ hφcs hφ' hφdcs hA hA' hG hp
      hr hrq hpq hrel hr2) (by positivity)) ?_
  exact brsMain_covering_term hCβ hN hCnn hq0 (1 + s) _


/-! ## The high-frequency terms, in geometric form -/

/-- **The `m`-th Littlewood--Paley term of the main-term sum.** -/
theorem brsMainFamily_succ_succ_term_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ)))) (m : ℕ)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
          (brsKernelConst Mu A N r ^ (1 / r) +
            brsKernelConst Mu' A' N r ^ (1 / r)) *
          (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((1 + 3 + m : ℕ) : ℝ)))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_brsMainFamily_succ_succ_covering hE m hυeq hυ hcs hR hυ' hcs'
      hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel)
    (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0), ENNReal.rpow_one]
  refine le_trans (mul_le_mul' le_rfl
    (brsMain_geometric_term hCβ hN hCLP hq0 (1 + 3 + m) _)) (le_of_eq ?_)
  rw [← mul_assoc]
  congr 1
  rw [show ((2 : ENNReal)) = ENNReal.ofReal 2 by simp,
    ← ENNReal.ofReal_mul (by norm_num)]


/-! ## The geometric series in `m` -/

/-- The high-frequency terms sum geometrically. -/
theorem tsum_geometric_shift {c a : ℝ} (hc : 0 ≤ c) (ha : a < 0) (d : ℕ) :
    (∑' m : ℕ, ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((d + m : ℕ) : ℝ)))) =
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * (d : ℝ)) /
        (1 - (2 : ℝ) ^ a)) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hterm : ∀ m : ℕ, c * (2 : ℝ) ^ (a * ((d + m : ℕ) : ℝ)) =
      (c * (2 : ℝ) ^ (a * (d : ℝ))) * (2 : ℝ) ^ (a * (m : ℝ)) := by
    intro m
    rw [mul_assoc, ← Real.rpow_add h2]
    congr 2
    push_cast
    ring
  simp only [hterm]
  refine tsum_ofReal_geometric ?_ ha
  have : (0 : ℝ) < (2 : ℝ) ^ (a * (d : ℝ)) := Real.rpow_pos_of_pos h2 _
  positivity


/-! ## The whole main-term sum -/

/-- **The sum over all the pieces of the main term.** -/
theorem brsMainFamily_tsum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {e : ℝ} {g : ℝ → ℂ} (hG : Continuous (brsWeightedProfile e g))
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∑' n : ℕ, (∫⁻ x : ℝ, brsMainFamily 3 φ e g E n x ^ q) ^ (1 / q)) ≤
      (ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
              (brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r))) *
            (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
              (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
        (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set G : ENNReal := (∫⁻ z : ℝ, ‖brsWeightedProfile e g z‖ₑ ^ p) ^ (1 / p)
    with hGdef
  set a : ℝ := β / q - (1 / r - 1 / 2) with hadef
  set c : ℝ := 2 * (Cβ ^ (1 / q) *
    (brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r))) with hcdef
  have hcnn : 0 ≤ c := by
    rw [hcdef]
    have : (0 : ℝ) ≤ Cβ ^ (1 / q) := Real.rpow_nonneg hCβ _
    positivity
  have hT0 := brsMainFamily_zero_term_le hE hCβ hN 3 hφ hφcs hφ' hφdcs hAφ hAφ'
    hG hp hr hrq hpq hrel hr2
  have hT1 := brsMainFamily_one_term_le hE hCβ hN 3 hφ hφcs hφ' hφdcs hAφ hAφ'
    hG hp hr hrq hpq hrel hr2
  have hTm : ∀ m : ℕ,
      (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 + m : ℕ) : ℝ))) * G := by
    intro m
    have h := brsMainFamily_succ_succ_term_le hE hCβ hN m hυeq hυ hcs hR hυ'
      hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
    have hidx : (1 + 3 + m : ℕ) = (4 + m : ℕ) := by omega
    rw [hidx] at h
    refine le_trans h (le_of_eq ?_)
    congr 2
    rw [hcdef, hadef]
    ring
  have hsum : (∑' m : ℕ,
      (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (m + 1 + 1) x ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ a)) * G := by
    refine le_trans (ENNReal.tsum_le_tsum hTm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right, tsum_geometric_shift hcnn hMneg 4]
  rw [ennreal_tsum_eq_zero_add
      (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamily 3 φ e g E n x ^ q) ^ (1 / q)),
    ennreal_tsum_eq_zero_add
      (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamily 3 φ e g E (n + 1) x ^ q) ^ (1 / q))]
  refine le_trans (add_le_add hT0 (add_le_add hT1 hsum)) (le_of_eq ?_)
  ring


/-! ## The near part of `𝔐_p^-`, bounded

Everything is in place: the radial weight is a constant, the pieces are
summed by the countable Minkowski inequality, and the sum is geometric. -/

/-- **The near part of `𝔐_p^-` maps the weighted profile to `L^q(r dr)`.** -/
theorem lintegral_brsMainNearLeftAt_final {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∫⁻ x : ℝ, brsMainNearLeftAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g x ^ q *
        ENNReal.ofReal x) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ((ENNReal.ofReal (Cβ ^ (1 / q) *
              ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
              (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
            ENNReal.ofReal (Cβ ^ (1 / q) *
              ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
              (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
            ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
                (brsKernelConst Mu A N r ^ (1 / r) +
                  brsKernelConst Mu' A' N r ^ (1 / r))) *
              (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
                (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
          (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^
            (1 / p)) := by
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  refine le_trans (lintegral_brsMainNear_Lp_le 3 hE hG hGbd hφ hφcs hφnorm
    hq1) ?_
  exact mul_le_mul' le_rfl
    (brsMainFamily_tsum_le hE hCβ hN hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs hR
      hυ' hcs' hR' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq hpq hrel
      hr2 hMneg)


/-! ## The far part of `𝔐_p^-`

Away from the singularity the kernel is bounded, and the weight `s^{1/2-1/p}`
is exactly what turns the profile into `G`, so the far part is a plain Hölder
estimate.  The radius is bounded, so no dyadic gain is needed. -/

theorem measurable_brsWeightedProfile {e : ℝ} {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsWeightedProfile e g) := by
  refine Measurable.mul ?_ hg
  exact Complex.measurable_ofReal.comp (measurable_id.pow_const e)

/-- The integrand of the far part, with the weight absorbed. -/
theorem enorm_mainWeight_eq {e a : ℝ} {g : ℝ → ℂ} {s : ℝ} (hs0 : 0 ≤ s)
    (hsa : a ≤ s) :
    ‖((s ^ e * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ =
      ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile e g s‖ₑ := by
  have hwnn : (0 : ℝ) ≤ s ^ e := Real.rpow_nonneg hs0 _
  have hknn : (0 : ℝ) ≤ (s - a) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by linarith) _
  rw [brsWeightedProfile, enorm_mul, enorm_mul, ← mul_assoc]
  congr 1
  rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg hwnn,
    ← ENNReal.ofReal_mul hknn]
  congr 1
  ring

/-- **The pointwise bound for the far part of `𝔐_p^-`.** -/
theorem brsMainFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c) (r : ℝ) :
    brsMainFarLeftAt c E p g r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) *
        (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
    rw [sub_nonneg, div_le_one hp0]
    exact hp.le
  have hGmeas : Measurable (brsWeightedProfile (1 / 2 - 1 / p) g) :=
    measurable_brsWeightedProfile hg
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  rw [brsMainFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨hr23, hr4⟩ := brsMain_radius_bounds hE ht
  obtain ⟨-, ht1, ht2⟩ := ht
  have hrpos : (0 : ℝ) < r := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  have hba8 : b - a ≤ 8 := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
  set W : Set ℝ := Ioc a b ∩ Ici (a + c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Ici
  have hstep1 : ENNReal.ofReal ‖∫ s in a..b, (Ici (a + c)).indicator
      (fun s => ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a b, ‖(Ici (a + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a b
      · by_cases h2 : a + c ≤ s
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Ici (a + c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hcon => h2 hcon.2),
            Set.indicator_of_notMem (show s ∉ Ici (a + c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hcon => h1 hcon.1)]
    rw [hset]
    refine le_of_eq (setLIntegral_congr_fun hWmeas fun s hs => ?_)
    exact enorm_mainWeight_eq (le_trans hanonneg hs.1.1.le) hs.1.1.le
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal ((s - a) ^ (-(1 / 2) : ℝ)) *
      ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : a + c ≤ s := hs.2
    have hle : (s - a) ^ (-(1 / 2) : ℝ) ≤ c ^ (-(1 / 2) : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hc (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal 8 := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal hba8
  have hstep3 : (∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      M * ENNReal.ofReal 8 ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hGmeas) ?_
    refine mul_le_mul' ?_ (ENNReal.rpow_le_rpow hvol hexp)
    exact ENNReal.rpow_le_rpow (setLIntegral_le_lintegral _ _) (by positivity)
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hrpos (by norm_num)]
    linarith
  have h8 : ENNReal.ofReal 8 ^ (1 - 1 / p) =
      ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)) :=
    ENNReal.ofReal_rpow_of_pos (by norm_num)
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, (Ici (a + c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal r⁻¹ * ENNReal.ofReal ‖∫ s in a..b,
          (Ici (a + c)).indicator (fun s => ((s ^ (1 / 2 - 1 / p) *
            (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal (3 / 2 : ℝ) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            (M * ENNReal.ofReal 8 ^ (1 - 1 / p))) :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv)
          (le_trans hstep1 (le_trans hstep2 (mul_le_mul' le_rfl hstep3)))
    _ = ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * M := by
        rw [h8]
        rw [show ENNReal.ofReal (3 / 2 : ℝ) *
            (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              (M * ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)))) =
            (ENNReal.ofReal (3 / 2 : ℝ) * ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p))) * M from by ring]
        congr 1
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
          ← ENNReal.ofReal_mul (by positivity)]


/-! ## The radial `L^q` norm of the far part of `𝔐_p^-`

The pointwise bound is uniform in `r`, and the radius lives in `(2/3, 4)`, so
the radial integral only contributes a constant. -/

/-- **The far part of `𝔐_p^-` in `L^q(r dr)`.** -/
theorem lintegral_brsMainFarLeftAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c)
    {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainFarLeftAt c E p g r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal 16 *
        (ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
            (8 : ℝ) ^ (1 - 1 / p)) *
          (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
            (1 / p)) ^ q := by
  set Cf : ℝ := (3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) * (8 : ℝ) ^ (1 - 1 / p)
    with hCf
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  have hpt : ∀ r : ℝ, brsMainFarLeftAt c E p g r ^ q * ENNReal.ofReal r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => (ENNReal.ofReal Cf * M) ^ q * ENNReal.ofReal 4) r := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      exact mul_le_mul'
        (ENNReal.rpow_le_rpow (brsMainFarLeftAt_le hE hp hg hc r) hq.le)
        (ENNReal.ofReal_le_ofReal hr.2.le)
    · rw [Set.indicator_of_notMem hr, brsMainFarLeftAt_eq_zero hE hr,
        ENNReal.zero_rpow_of_pos hq, zero_mul]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_indicator measurableSet_Ioo, setLIntegral_const,
    Real.volume_Ioo]
  rw [mul_assoc, ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4),
    mul_comm ((ENNReal.ofReal Cf * M) ^ q) _]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal (by norm_num)) le_rfl


/-! ## Measurable majorants for the two halves of `𝔐_p^-`

The maximal functions are indexed by a set depending on the radius, so as for
`R₂^±` the additivity of the integral is applied to majorants instead. -/

/-- The measurable majorant of the near part. -/
def brsMainNearMaj (s : ℕ) (φ : ℝ → ℝ) (e : ℝ) (g : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun r => ENNReal.ofReal r⁻¹ * ∑' n : ℕ, brsMainFamily s φ e g E n r) r

/-- The measurable majorant of the far part. -/
def brsMainFarMaj (p c : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun _ => ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p)) *
      (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p)) r

theorem measurable_brsMainNearMaj (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) (e : ℝ) {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) (E : Set ℝ) :
    Measurable (brsMainNearMaj s φ e g E) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine Measurable.mul ?_ ?_
  · fun_prop
  · exact Measurable.tsum fun n =>
      measurable_brsMainFamily s hφ hφcs e hG E n

theorem measurable_brsMainFarMaj (p c : ℝ) (g : ℝ → ℂ) :
    Measurable (brsMainFarMaj p c g) :=
  measurable_const.indicator measurableSet_Ioo

/-- **The majorant of the near part, in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearMaj_Lp_le (s : ℕ) {E : Set ℝ} {φ : ℝ → ℝ}
    (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ) {e : ℝ} {g : ℝ → ℂ}
    (hG : Continuous (brsWeightedProfile e g)) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearMaj s φ e g E r ^ q * ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamily s φ e g E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_main_weight_le
    (fun r => ∑' n : ℕ, brsMainFamily s φ e g E n r) hq0
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamily s hφ hφcs e hG E n)


/-! ## The far majorant, and the pointwise split into majorants -/

/-- A constant supported on the radial window costs a constant. -/
theorem lintegral_indicator_const_weight_le (C : ENNReal) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C) r) ^ q *
        ENNReal.ofReal r) ≤ ENNReal.ofReal 16 * C ^ q := by
  have hpt : ∀ r : ℝ, ((Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C) r) ^ q *
      ENNReal.ofReal r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator (fun _ => C ^ q * ENNReal.ofReal 4) r := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
      exact mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal hr.2.le)
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq, zero_mul]
  refine le_trans (lintegral_mono hpt) ?_
  rw [lintegral_indicator measurableSet_Ioo, setLIntegral_const,
    Real.volume_Ioo, mul_assoc,
    ← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4), mul_comm (C ^ q) _]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal (by norm_num)) le_rfl

/-- **The far majorant in `L^q(r dr)`.** -/
theorem lintegral_brsMainFarMaj_le (p c : ℝ) (g : ℝ → ℂ) {q : ℝ} (hq : 0 < q) :
    (∫⁻ r : ℝ, brsMainFarMaj p c g r ^ q * ENNReal.ofReal r) ≤
      ENNReal.ofReal 16 *
        (ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
            (8 : ℝ) ^ (1 - 1 / p)) *
          (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
            (1 / p)) ^ q :=
  lintegral_indicator_const_weight_le _ hq

/-- **`𝔐_p^-` is dominated by the two majorants.** -/
theorem brsMainTwoLeft_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg) (r : ℝ) :
    brsMainTwoLeft E p g r ≤
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E r +
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g r := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · have hrpos : (0 : ℝ) < r := by
      have := hr.1
      linarith
    rw [brsMainNearMaj, Set.indicator_of_mem hr, brsMainFarMaj,
      Set.indicator_of_mem hr]
    refine le_trans (brsMainTwoLeft_le_add_at ((2 : ℝ) ^ (-((1 : ℕ) : ℝ)))
      hp1 hgc hrpos) (add_le_add ?_ ?_)
    · have h := brsMainNearLeftAt_le_indicator 3 hE hG hGbd hφc hφcs hφnorm r
      rw [Set.indicator_of_mem hr] at h
      rw [← brsMainFamily_tsum 3 φ (1 / 2 - 1 / p) g E r]
      exact h
    · exact brsMainFarLeftAt_le hE hp1 hgc.measurable hc r
  · rw [brsMainTwoLeft_eq_zero hE hr]
    exact zero_le


/-! ## The pointwise splitting of `𝔐_p^-` into two measurable majorants -/

/-- **`𝔐_p^-` split, with the convexity factor.** -/
theorem brsMainTwoLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hle := brsMainTwoLeft_le_maj hE hp1 hgc hφc hφcs hφnorm hG hGbd x
  have hpow : brsMainTwoLeft E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q +
          brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          (brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q +
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q)) :=
        mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by ring


/-! ## Adding two majorants, with constants in `ℝ≥0∞` -/

/-- **Adding two majorants**, with the constants left in `ℝ≥0∞`. -/
theorem lintegral_rpow_le_of_two_bounds' {R Nm Fw : ℝ → ENNReal} {q : ℝ}
    (hq : 1 ≤ q)
    (hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x * Nm x ^ q)
    (hpt : ∀ x : ℝ, ENNReal.ofReal x * R x ^ q ≤
      (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Nm x ^ q) +
        (2 : ENNReal) ^ (q - 1) * (ENNReal.ofReal x * Fw x ^ q))
    {CN CF G : ENNReal}
    (hNb : (∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q) ^ (1 / q) ≤ CN * G)
    (hFb : (∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q) ^ (1 / q) ≤ CF * G) :
    (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) * (CN + CF) * G := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hq1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  set X : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Nm x ^ q with hX
  set Y : ENNReal := ∫⁻ x : ℝ, ENNReal.ofReal x * Fw x ^ q with hY
  have htop : (2 : ENNReal) ^ (q - 1) ≠ ⊤ :=
    ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)
  have hint : (∫⁻ x : ℝ, ENNReal.ofReal x * R x ^ q) ≤
      (2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y := by
    refine le_trans (lintegral_mono hpt) (le_of_eq ?_)
    rw [lintegral_add_left'
      (hNmeas.const_mul ((2 : ENNReal) ^ (q - 1))).aemeasurable]
    rw [lintegral_const_mul' _ _ htop, lintegral_const_mul' _ _ htop]
  refine le_trans (ENNReal.rpow_le_rpow hint (by positivity)) ?_
  have hsub : ((2 : ENNReal) ^ (q - 1) * X + (2 : ENNReal) ^ (q - 1) * Y) ^
      (1 / q) ≤ ((2 : ENNReal) ^ (q - 1) * X) ^ (1 / q) +
        ((2 : ENNReal) ^ (q - 1) * Y) ^ (1 / q) :=
    ENNReal.rpow_add_le_add_rpow _ _ (by positivity) hq1
  refine le_trans hsub ?_
  have hfac : ∀ Z : ENNReal, ((2 : ENNReal) ^ (q - 1) * Z) ^ (1 / q) =
      (2 : ENNReal) ^ ((q - 1) / q) * Z ^ (1 / q) := by
    intro Z
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul]
    congr 2
    field_simp
  rw [hfac, hfac]
  have hmain : (2 : ENNReal) ^ ((q - 1) / q) * X ^ (1 / q) +
      (2 : ENNReal) ^ ((q - 1) / q) * Y ^ (1 / q) ≤
      (2 : ENNReal) ^ ((q - 1) / q) * (CN * G + CF * G) := by
    rw [mul_add]
    exact add_le_add (mul_le_mul' le_rfl hNb) (mul_le_mul' le_rfl hFb)
  refine le_trans hmain (le_of_eq ?_)
  rw [← add_mul, ← mul_assoc]


/-! ## Proposition 5.5 for `𝔐_p^-` -/

/-- **Proposition 5.5 of BRS, for `𝔐_p^-`.**  Below the critical exponent —
that is, when the single geometric series in `m` converges — the main term maps
the weighted profile to the radial `L^q(r dr)` norm. -/
theorem prop55_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    (hG : Continuous (brsWeightedProfile (1 / 2 - 1 / p) g)) {Cg : ℝ}
    (hGbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ ≤ Cg)
    {q r : ℝ} (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsMainTwoLeft E p g x ^ q) ^ (1 / q) ≤
        C * (∫⁻ z : ℝ,
          ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set Gp : ENNReal :=
    (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p)
    with hGp
  set K : ENNReal := ENNReal.ofReal (Cβ ^ (1 / q) *
      ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
      (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) with hK
  set Cgeo : ENNReal := ENNReal.ofReal (2 * (Cβ ^ (1 / q) *
        (brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r))) *
      (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2)))) with hCgeo
  set CN : ENNReal := ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
    (K + K + Cgeo) with hCN
  -- the near majorant
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) ^ (1 / q) ≤ CN * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q) =
        ∫⁻ x : ℝ, brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (lintegral_brsMainNearMaj_Lp_le 3 hφ hφcs hG hq1) ?_
    rw [hCN, mul_assoc]
    exact mul_le_mul' le_rfl
      (brsMainFamily_tsum_le hE hCβ hN hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs
        hRb hυ' hcs' hRb' hbd hA hAnn hbd' hA' hA'nn hmom hmom' hG hp hr hrq
        hpq hrel hr2 hMneg)
  -- the far majorant
  have hFb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) =
        ∫⁻ x : ℝ, brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFarMaj_le p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g hq0)
      (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0),
      ENNReal.rpow_one, ← hGp]
    exact le_of_eq (mul_assoc _ _ _).symm
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      brsMainNearMaj 3 φ (1 / 2 - 1 / p) g E x ^ q :=
    ENNReal.measurable_ofReal.mul
      ((measurable_brsMainNearMaj 3 hφ hφcs (1 / 2 - 1 / p) hG E).pow_const q)
  refine ⟨(2 : ENNReal) ^ ((q - 1) / q) * (CN +
    ENNReal.ofReal 16 ^ (1 / q) *
      ENNReal.ofReal ((3 / 2 : ℝ) *
        ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p))), ?_, ?_⟩
  · have h1 : (2 : ENNReal) ^ ((q - 1) / q) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) (by simp)
    have h2 : CN ≠ ⊤ := by
      rw [hCN]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.add_ne_top.mpr ⟨ENNReal.add_ne_top.mpr
          ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩,
          ENNReal.ofReal_ne_top⟩)
    have h3 : ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) ≠ ⊤ :=
      ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
        ENNReal.ofReal_ne_top
    exact ENNReal.mul_ne_top h1 (ENNReal.add_ne_top.mpr ⟨h2, h3⟩)
  · exact lintegral_rpow_le_of_two_bounds' hq1 hNmeas
      (fun x => brsMainTwoLeft_rpow_le hE hp1 hgc hφ.continuous hφcs hφnorm hG
        hGbd hq1 x) hNb hFb


/-! ## The near part of `𝔐_p^+`, identified

At the right endpoint the substitution `u = b - s` gives the plain convolution
evaluated at `b = r + t`.  Writing `r + t = -( (3-t) - r ) + 3` and reflecting
the profile about `3/2` puts it in the same shape as the left endpoint, with
the index set `3 - E`, which again lies in `[1,2]`. -/

/-- **The near part of `𝔐_p^+`, identified.** -/
theorem brsMainNearRightAt_eq {c : ℝ} (hc : 0 < c) {E : Set ℝ} {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hcr : c ≤ r) :
    brsMainNearRightAt c E p g r =
      ENNReal.ofReal r⁻¹ *
        ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ =>
              brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
              (3 - t - r)‖ₑ := by
  have hr : (0 : ℝ) < r := lt_of_lt_of_le hc hcr
  have hrinv : (0 : ℝ) ≤ r⁻¹ := by positivity
  have hidentify : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      (∫ s in |r - t|..(r + t), (Ioi (r + t - c)).indicator
          (fun s => ((s ^ (1 / 2 - 1 / p) *
            (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s) =
        brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
          brsRefl (fun w : ℝ =>
            brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
            (3 - t - r) := by
    rintro t ⟨-, ht1, ht2⟩
    have hcb : |r - t| + c ≤ r + t := by
      rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
    rw [integral_mainNearPartRight_eq_conv hc hcb]
    change (∫ u : ℝ, ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((r + t - u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (r + t - u))) =
      ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
        brsRefl (fun w : ℝ =>
          brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (-(3 - t - r) - y)
    refine integral_congr_ae (Filter.Eventually.of_forall fun u => ?_)
    change ((brsTruncKernelAt c u : ℝ) : ℂ) *
        ((((r + t - u) ^ (1 / 2 - 1 / p) : ℝ) : ℂ) * g (r + t - u)) =
      ((brsTruncKernelAt c u : ℝ) : ℂ) *
        brsRefl (fun w : ℝ =>
          brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (-(3 - t - r) - u)
    rw [brsRefl_apply, brsWeightedProfile,
      show (3 : ℝ) - -(-(3 - t - r) - u) = r + t - u by ring]
  have hpt : ∀ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
      ENNReal.ofReal (r⁻¹ * ‖∫ s in |r - t|..(r + t),
          (Ioi (r + t - c)).indicator
            (fun s => ((s ^ (1 / 2 - 1 / p) *
              (r + t - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖) =
        ENNReal.ofReal r⁻¹ *
          ‖brsRefl (fun z : ℝ => ∫ y : ℝ, ((brsTruncKernelAt c y : ℝ) : ℂ) *
            brsRefl (fun w : ℝ =>
              brsWeightedProfile (1 / 2 - 1 / p) g (3 - w)) (z - y))
              (3 - t - r)‖ₑ := by
    intro t ht
    rw [ENNReal.ofReal_mul hrinv, ofReal_norm, hidentify t ht]
  rw [brsMainNearRightAt]
  rw [iSup_congr fun t => iSup_congr fun ht => hpt t ht]
  rw [ENNReal.mul_iSup]
  refine iSup_congr fun t => ?_
  rw [ENNReal.mul_iSup]


/-! ## The near part of `𝔐_p^+`, decomposed

Unlike the left endpoint there is no window split: the singular point is always
`3 - t - r`, so only the reflected family occurs. -/

/-- **The near part of `𝔐_p^+`, decomposed into the pieces.** -/
theorem brsMainNearRightAt_le_pieces (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        (brsNearFullMax 1 (brsDilate φ (1 + s))
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r +
          ∑' m : ℕ, brsNearFullMax 1 (brsLPKernel φ (1 + s + m))
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  rw [brsMainNearRightAt_eq hc hcr]
  refine mul_le_mul' le_rfl ?_
  refine iSup₂_le fun t ht => ?_
  have hmem : (3 - t) ∈ (fun x : ℝ => 3 - x) '' E := ⟨t, ht.1, rfl⟩
  refine le_trans (enorm_brsRefl_conv_le_pieces 1 s hH hHbd hφ hφcs hφnorm
    (3 - t - r)) ?_
  refine add_le_add (le_iSup₂_of_le (3 - t) hmem le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le (3 - t) hmem le_rfl


/-! ## The far part of `𝔐_p^+` -/

/-- The integrand of the far part at the right endpoint. -/
theorem enorm_mainWeightRight_eq {e b : ℝ} {g : ℝ → ℂ} {s : ℝ}
    (hs0 : 0 ≤ s) (hsb : s ≤ b) :
    ‖((s ^ e * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ =
      ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile e g s‖ₑ := by
  have hwnn : (0 : ℝ) ≤ s ^ e := Real.rpow_nonneg hs0 _
  have hknn : (0 : ℝ) ≤ (b - s) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by linarith) _
  rw [brsWeightedProfile, enorm_mul, enorm_mul, ← mul_assoc]
  congr 1
  rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real, Complex.norm_real,
    Real.norm_of_nonneg (by positivity), Real.norm_of_nonneg hwnn,
    ← ENNReal.ofReal_mul hknn]
  congr 1
  ring

/-- **The pointwise bound for the far part of `𝔐_p^+`.** -/
theorem brsMainFarRightAt_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp : 1 < p) {g : ℝ → ℂ} (hg : Measurable g) {c : ℝ} (hc : 0 < c) (r : ℝ) :
    brsMainFarRightAt c E p g r ≤
      ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) *
        (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hexp : (0 : ℝ) ≤ 1 - 1 / p := by
    rw [sub_nonneg, div_le_one hp0]
    exact hp.le
  have hGmeas : Measurable (brsWeightedProfile (1 / 2 - 1 / p) g) :=
    measurable_brsWeightedProfile hg
  set M : ENNReal := (∫⁻ s : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ ^ p) ^
    (1 / p) with hM
  rw [brsMainFarRightAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨hr23, hr4⟩ := brsMain_radius_bounds hE ht
  obtain ⟨-, ht1, ht2⟩ := ht
  have hrpos : (0 : ℝ) < r := by linarith
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have hanonneg : (0 : ℝ) ≤ a := abs_nonneg _
  have hab : a ≤ b := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> linarith
  have hba8 : b - a ≤ 8 := by
    rw [ha, hb]
    rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩ <;> rw [h] <;> linarith
  set W : Set ℝ := Ioc a b ∩ Iic (b - c) with hW
  have hWmeas : MeasurableSet W := measurableSet_Ioc.inter measurableSet_Iic
  have hstep1 : ENNReal.ofReal ‖∫ s in a..b, (Iic (b - c)).indicator
      (fun s => ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) *
        g s) s‖ ≤
      ∫⁻ s in W, ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
        ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [ofReal_norm, intervalIntegral.integral_of_le hab]
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have hset : (∫⁻ s in Ioc a b, ‖(Iic (b - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ₑ) =
        ∫⁻ s in W, ‖((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ₑ := by
      rw [← lintegral_indicator measurableSet_Ioc,
        ← lintegral_indicator hWmeas]
      refine lintegral_congr fun s => ?_
      by_cases h1 : s ∈ Ioc a b
      · by_cases h2 : s ≤ b - c
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_mem (show s ∈ W from ⟨h1, h2⟩),
            Set.indicator_of_mem (show s ∈ Iic (b - c) from h2)]
        · rw [Set.indicator_of_mem h1,
            Set.indicator_of_notMem (show s ∉ W from fun hcon => h2 hcon.2),
            Set.indicator_of_notMem (show s ∉ Iic (b - c) from h2)]
          simp
      · rw [Set.indicator_of_notMem h1,
          Set.indicator_of_notMem (show s ∉ W from fun hcon => h1 hcon.1)]
    rw [hset]
    refine le_of_eq (setLIntegral_congr_fun hWmeas fun s hs => ?_)
    exact enorm_mainWeightRight_eq (le_trans hanonneg hs.1.1.le) hs.1.2
  have hstep2 : (∫⁻ s in W, ENNReal.ofReal ((b - s) ^ (-(1 / 2) : ℝ)) *
      ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_mono_ae ?_
    filter_upwards [self_mem_ae_restrict hWmeas] with s hs
    have hs2 : s ≤ b - c := hs.2
    have hle : (b - s) ^ (-(1 / 2) : ℝ) ≤ c ^ (-(1 / 2) : ℝ) :=
      Real.rpow_le_rpow_of_nonpos hc (by linarith) (by norm_num)
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal hle) le_rfl
  have hvol : volume W ≤ ENNReal.ofReal 8 := by
    refine le_trans (measure_mono Set.inter_subset_left) ?_
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_le_ofReal hba8
  have hstep3 : (∫⁻ s in W, ‖brsWeightedProfile (1 / 2 - 1 / p) g s‖ₑ) ≤
      M * ENNReal.ofReal 8 ^ (1 - 1 / p) := by
    refine le_trans (lintegral_window_holder hp hGmeas) ?_
    refine mul_le_mul' ?_ (ENNReal.rpow_le_rpow hvol hexp)
    exact ENNReal.rpow_le_rpow (setLIntegral_le_lintegral _ _) (by positivity)
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hrpos (by norm_num)]
    linarith
  have h8 : ENNReal.ofReal 8 ^ (1 - 1 / p) =
      ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)) :=
    ENNReal.ofReal_rpow_of_pos (by norm_num)
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in a..b, (Iic (b - c)).indicator
        (fun s => ((s ^ (1 / 2 - 1 / p) *
          (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal r⁻¹ * ENNReal.ofReal ‖∫ s in a..b,
          (Iic (b - c)).indicator (fun s => ((s ^ (1 / 2 - 1 / p) *
            (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal (3 / 2 : ℝ) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            (M * ENNReal.ofReal 8 ^ (1 - 1 / p))) :=
        mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv)
          (le_trans hstep1 (le_trans hstep2 (mul_le_mul' le_rfl hstep3)))
    _ = ENNReal.ofReal ((3 / 2 : ℝ) * c ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * M := by
        rw [h8]
        rw [show ENNReal.ofReal (3 / 2 : ℝ) *
            (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              (M * ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p)))) =
            (ENNReal.ofReal (3 / 2 : ℝ) * ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
              ENNReal.ofReal ((8 : ℝ) ^ (1 - 1 / p))) * M from by ring]
        congr 1
        rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
          ← ENNReal.ofReal_mul (by positivity)]



/-! ## The family of pieces at the right endpoint

Only the reflected family occurs, so the indexing is by a single sequence: `0`
is the low-frequency piece and `m + 1` the `m`-th Littlewood--Paley piece.  The
profile is left free, since at the right endpoint it is the reflection of the
weighted profile. -/

/-- The pieces of `𝔐_p^+`. -/
def brsMainFamilyR (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ) (n : ℕ)
    (r : ℝ) : ENNReal :=
  match n with
  | 0 => brsNearFullMax 1 (brsDilate φ (1 + s)) H E r
  | (m + 1) => brsNearFullMax 1 (brsLPKernel φ (1 + s + m)) H E r

theorem brsMainFamilyR_zero (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ)
    (r : ℝ) : brsMainFamilyR s φ H E 0 r =
      brsNearFullMax 1 (brsDilate φ (1 + s)) H E r := rfl

theorem brsMainFamilyR_succ (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ)
    (m : ℕ) (r : ℝ) : brsMainFamilyR s φ H E (m + 1) r =
      brsNearFullMax 1 (brsLPKernel φ (1 + s + m)) H E r := rfl

theorem measurable_brsMainFamilyR (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) {H : ℝ → ℂ} (hH : Continuous H) (E : Set ℝ)
    (n : ℕ) : Measurable (brsMainFamilyR s φ H E n) := by
  match n with
  | 0 =>
      exact measurable_brsNearFullMax 1 (contDiff_brsDilate hφ _)
        (hasCompactSupport_brsDilate hφcs _) hH E
  | (m + 1) =>
      refine measurable_brsNearFullMax 1 ?_
        (hasCompactSupport_brsLPKernel hφcs _) hH E
      exact (contDiff_brsDilate hφ _).sub (contDiff_brsDilate hφ _)

/-- **The near part of `𝔐_p^+`, bounded by the family.** -/
theorem brsMainNearRightAt_le_tsum (s : ℕ) {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      ENNReal.ofReal r⁻¹ *
        ∑' n : ℕ, brsMainFamilyR s φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) n r := by
  refine le_trans (brsMainNearRightAt_le_pieces s hH hHbd hφ hφcs hφnorm hcr)
    (le_of_eq ?_)
  congr 1
  rw [ennreal_tsum_eq_zero_add (fun n : ℕ => brsMainFamilyR s φ
    (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    ((fun x : ℝ => 3 - x) '' E) n r), brsMainFamilyR_zero]
  congr 1


/-! ## The pieces of `𝔐_p^+`, bounded

Only the reflected family occurs, so there is no convexity factor. -/

/-- **The low-frequency piece of `𝔐_p^+`.** -/
theorem lintegral_brsMainFamilyR_zero_le {E : Set ℝ} (s : ℕ) {ι : Finset ℝ}
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + s : ℕ) : ℝ))) ι)
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {A A' : ℝ} (hA : (∫ y : ℝ, |φ y|) ≤ A) (hA' : (∫ y : ℝ, |deriv φ y|) ≤ A')
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2) :
    (∫⁻ x : ℝ, brsMainFamilyR s φ H E 0 x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((A + A') * brsLowConst 1 r ^ (1 / r)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + s : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hφ hφcs hφ' hφdcs (1 + s)
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
    hdercd hH hp hr hrq hpq hrel) ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
  exact brs_low_bracket 1 (1 + s) hφ hφcs hφ' hφdcs hA hA' hr.le hr2 _

/-- **The `m`-th Littlewood--Paley piece of `𝔐_p^+`.** -/
theorem lintegral_brsMainFamilyR_succ_le {E : Set ℝ} {ι : Finset ℝ} (m : ℕ)
    (hcov : IsIntervalCover E ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ι)
    {φ υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) :
    (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ≤
      (ι.card : ENNReal) *
        (ENNReal.ofReal ((brsKernelConst Mu A N r ^ (1 / r) +
              brsKernelConst Mu' A' N r ^ (1 / r)) *
            ((2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ))) ^ (1 / r - 1 / 2)) *
          (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p)) ^ q := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkj : 5 * (2 : ℝ) ^ (-((1 + 3 + m : ℕ) : ℝ)) ≤
      (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) := by
    have h := brs_scale_gap 1 m
    have heq : 1 + (m + 3) = 1 + 3 + m := by omega
    rw [heq] at h
    simpa using h
  obtain ⟨hdil, hdilcs, hdercd, hdercs⟩ :=
    brsDilate_deriv_data hυ hcs hυ' hcs' (1 + 3 + m)
  have hfam : ∀ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x =
      brsNearFullMax 1 (brsDilate υ (1 + 3 + m)) H E x := by
    intro x
    rw [brsMainFamilyR_succ, hυeq]
  simp only [hfam]
  refine le_trans (lintegral_brsNearFullMax_rpow_le hδ hcov 1 hdilcs hdil hdercs
