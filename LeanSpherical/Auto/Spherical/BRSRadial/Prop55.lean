/-- **The whole sum for `𝔐_p^+`.** -/
theorem brsMainFamilyR_tsum_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {H : ℝ → ℂ} (hH : Continuous H)
    {p q r : ℝ} (hp : 1 ≤ p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    (∑' n : ℕ, (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E n x ^ q) ^ (1 / q)) ≤
      (ENNReal.ofReal (Cβ ^ (1 / q) *
            ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
            (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) +
          ENNReal.ofReal ((Cβ ^ (1 / q) *
              (brsKernelConst Mu A N r ^ (1 / r) +
                brsKernelConst Mu' A' N r ^ (1 / r))) *
            (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
              (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2))))) *
        (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p) := by
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : 0 ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  have hMu'nn : 0 ≤ Mu' := le_trans (abs_nonneg _) (hbd' 0)
  have hAφnn : 0 ≤ Aφ := le_trans (integral_nonneg fun y => abs_nonneg _) hAφ
  have hAφ'nn : 0 ≤ Aφ' := le_trans (integral_nonneg fun y => abs_nonneg _) hAφ'
  have hClow : (0 : ℝ) ≤ (Aφ + Aφ') * brsLowConst 1 r ^ (1 / r) := by
    have : (0 : ℝ) ≤ brsLowConst 1 r ^ (1 / r) :=
      Real.rpow_nonneg (brsLowConst_nonneg 1 hr2) _
    positivity
  have hCLP : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r) := by
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set G : ENNReal := (∫⁻ z : ℝ, ‖H z‖ₑ ^ p) ^ (1 / p) with hGdef
  set a : ℝ := β / q - (1 / r - 1 / 2) with hadef
  set c : ℝ := Cβ ^ (1 / q) *
    (brsKernelConst Mu A N r ^ (1 / r) +
      brsKernelConst Mu' A' N r ^ (1 / r)) with hcdef
  have hcnn : 0 ≤ c := by
    rw [hcdef]
    have : (0 : ℝ) ≤ Cβ ^ (1 / q) := Real.rpow_nonneg hCβ _
    positivity
  have hT0 : (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E 0 x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (Cβ ^ (1 / q) *
        ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
        (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) * G := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFamilyR_zero_covering hE 3 hφ hφcs hφ' hφdcs hAφ hAφ' hH
        hp hr hrq hpq hrel hr2) (by positivity)) ?_
    exact brsMain_covering_term hCβ hN hClow hq0 (1 + 3) _
  have hTm : ∀ m : ℕ,
      (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 + m : ℕ) : ℝ))) * G := by
    intro m
    have h := ENNReal.rpow_le_rpow
      (lintegral_brsMainFamilyR_succ_covering hE m hυeq hυ hcs hRb hυ' hcs' hRb'
        hbd hA hAnn hbd' hA' hA'nn hmom hmom' hH hp hr hrq hpq hrel)
      (by positivity : (0 : ℝ) ≤ 1 / q)
    refine le_trans h ?_
    have h2 := brsMain_geometric_term (s := 1 / r - 1 / 2) hCβ hN hCLP hq0
      (1 + 3 + m) G
    refine le_trans h2 (le_of_eq ?_)
    have hidx : (1 + 3 + m : ℕ) = (4 + m : ℕ) := by omega
    rw [hidx, hcdef, hadef]
  have hsum : (∑' m : ℕ,
      (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E (m + 1) x ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (c * (2 : ℝ) ^ (a * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ a)) * G := by
    refine le_trans (ENNReal.tsum_le_tsum hTm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right, tsum_geometric_shift hcnn hMneg 4]
  rw [ennreal_tsum_eq_zero_add
    (fun n : ℕ => (∫⁻ x : ℝ, brsMainFamilyR 3 φ H E n x ^ q) ^ (1 / q))]
  refine le_trans (add_le_add hT0 hsum) (le_of_eq ?_)
  rw [← add_mul]


/-! ## The near majorant at the right endpoint -/

/-- The measurable majorant of the near part of `𝔐_p^+`. -/
def brsMainNearMajR (s : ℕ) (φ : ℝ → ℝ) (H : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  (Ioo (2 / 3 : ℝ) 4).indicator
    (fun r => ENNReal.ofReal r⁻¹ * ∑' n : ℕ, brsMainFamilyR s φ H E n r) r

theorem measurable_brsMainNearMajR (s : ℕ) {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ)
    (hφcs : HasCompactSupport φ) {H : ℝ → ℂ} (hH : Continuous H) (E : Set ℝ) :
    Measurable (brsMainNearMajR s φ H E) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine Measurable.mul ?_ ?_
  · fun_prop
  · exact Measurable.tsum fun n =>
      measurable_brsMainFamilyR s hφ hφcs hH E n

/-- **The near majorant of `𝔐_p^+`, in `L^q(r dr)`.** -/
theorem lintegral_brsMainNearMajR_Lp_le (s : ℕ) {E : Set ℝ} {φ : ℝ → ℝ}
    (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ) {H : ℝ → ℂ}
    (hH : Continuous H) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, brsMainNearMajR s φ H E r ^ q * ENNReal.ofReal r) ^ (1 / q) ≤
      ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
        ∑' n : ℕ, (∫⁻ r : ℝ,
          brsMainFamilyR s φ H E n r ^ q) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hCnn : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q * 4 := by
    have : (0 : ℝ) ≤ (3 / 2 : ℝ) ^ q := Real.rpow_nonneg (by norm_num) _
    linarith
  have hstep := lintegral_main_weight_le
    (fun r => ∑' n : ℕ, brsMainFamilyR s φ H E n r) hq0
  refine le_trans (ENNReal.rpow_le_rpow hstep (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_nonneg hCnn (by positivity)]
  refine mul_le_mul' le_rfl ?_
  exact lintegral_Lp_tsum_le hq
    (fun n => measurable_brsMainFamilyR s hφ hφcs hH E n)

/-- **The near part of `𝔐_p^+`, with the radial cutoff made explicit.** -/
theorem brsMainNearRightAt_le_indicator (s : ℕ) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} {g : ℝ → ℂ}
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {φ : ℝ → ℝ} (hφ : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1) (r : ℝ) :
    brsMainNearRightAt ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) E p g r ≤
      brsMainNearMajR s φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [brsMainNearMajR, Set.indicator_of_mem hr]
    have hhalf : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) = 1 / 2 := by norm_num
    have hcr : (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) ≤ r := by
      rw [hhalf]
      linarith [hr.1]
    exact brsMainNearRightAt_le_tsum s hH hHbd hφ hφcs hφnorm hcr
  · rw [brsMainNearMajR, Set.indicator_of_notMem hr,
      brsMainNearRightAt_eq_zero hE hr]


/-! ## The pointwise split of `𝔐_p^+` -/

/-- **`𝔐_p^+` is dominated by the two majorants.** -/
theorem brsMainTwoRight_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    (r : ℝ) :
    brsMainTwoRight E p g r ≤
      brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) r +
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g r := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-((1 : ℕ) : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · have hrpos : (0 : ℝ) < r := by
      have := hr.1
      linarith
    refine le_trans (brsMainTwoRight_le_add_at ((2 : ℝ) ^ (-((1 : ℕ) : ℝ)))
      hp1 hgc hrpos) (add_le_add ?_ ?_)
    · exact brsMainNearRightAt_le_indicator 3 hE hH hHbd hφc hφcs hφnorm r
    · rw [brsMainFarMaj, Set.indicator_of_mem hr]
      exact brsMainFarRightAt_le hE hp1 hgc.measurable hc r
  · rw [brsMainTwoRight_eq_zero hE hr]
    exact zero_le

/-- **`𝔐_p^+` split, with the convexity factor.** -/
theorem brsMainTwoRight_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    {φ : ℝ → ℝ} (hφc : Continuous φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {q : ℝ} (hq : 1 ≤ q) (x : ℝ) :
    ENNReal.ofReal x * brsMainTwoRight E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainNearMajR 3 φ
              (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
              ((fun x : ℝ => 3 - x) '' E) x ^ q) +
        (2 : ENNReal) ^ (q - 1) *
          (ENNReal.ofReal x *
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  rcases le_or_gt x 0 with hx | hx
  · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul]
    exact zero_le
  have hle := brsMainTwoRight_le_maj hE hp1 hgc hφc hφcs hφnorm hH hHbd x
  have hpow : brsMainTwoRight E p g x ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (brsMainNearMajR 3 φ
            (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) x ^ q +
          brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) :=
    le_trans (ENNReal.rpow_le_rpow hle hq0.le)
      (ENNReal.rpow_add_le_mul_rpow_add_rpow _ _ hq)
  calc ENNReal.ofReal x * brsMainTwoRight E p g x ^ q
      ≤ ENNReal.ofReal x * ((2 : ENNReal) ^ (q - 1) *
          (brsMainNearMajR 3 φ
              (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
              ((fun x : ℝ => 3 - x) '' E) x ^ q +
            brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q)) :=
        mul_le_mul' le_rfl hpow
    _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainNearMajR 3 φ
                (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
                ((fun x : ℝ => 3 - x) '' E) x ^ q) +
          (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal x *
              brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) := by ring


/-! ## Proposition 5.5 for `𝔐_p^+` -/

/-- **Proposition 5.5 of BRS, for `𝔐_p^+`.** -/
theorem prop55_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cβ β : ℝ} (hCβ : 0 ≤ Cβ)
    (hN : ∀ j : ℕ, (intervalCoveringNumber ((fun x : ℝ => 3 - x) '' E)
        ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (Cβ * (2 : ℝ) ^ (β * (j : ℝ))))
    {φ : ℝ → ℝ} (hφ : ContDiff ℝ 1 φ) (hφcs : HasCompactSupport φ)
    (hφnorm : (∫ x : ℝ, φ x) = 1)
    (hφ' : ContDiff ℝ 1 (deriv φ)) (hφdcs : HasCompactSupport (deriv φ))
    {Aφ Aφ' : ℝ} (hAφ : (∫ y : ℝ, |φ y|) ≤ Aφ)
    (hAφ' : (∫ y : ℝ, |deriv φ y|) ≤ Aφ')
    {υ : ℝ → ℝ} (hυeq : ∀ j : ℕ, brsLPKernel φ j = brsDilate υ j)
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hRb : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hRb' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hA : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {p : ℝ} (hp1 : 1 < p) {g : ℝ → ℂ} (hgc : Continuous g)
    (hH : Continuous fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
    {Cg : ℝ}
    (hHbd : ∀ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ ≤ Cg)
    {q r : ℝ} (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hr2 : r < 2)
    (hMneg : β / q - (1 / r - 1 / 2) < 0) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x * brsMainTwoRight E p g x ^ q) ^ (1 / q) ≤
        C * (∫⁻ z : ℝ,
          ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p) := by
  have hp : (1 : ℝ) ≤ p := hp1.le
  have hq1 : (1 : ℝ) ≤ q := le_of_lt (lt_trans hr hrq)
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set Gp : ENNReal :=
    (∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p) ^ (1 / p)
    with hGp
  set K : ENNReal := ENNReal.ofReal (Cβ ^ (1 / q) *
      ((Aφ + Aφ') * brsLowConst 1 r ^ (1 / r)) *
      (2 : ℝ) ^ (β / q * ((1 + 3 : ℕ) : ℝ))) with hK
  set Cgeo : ENNReal := ENNReal.ofReal ((Cβ ^ (1 / q) *
        (brsKernelConst Mu A N r ^ (1 / r) +
          brsKernelConst Mu' A' N r ^ (1 / r))) *
      (2 : ℝ) ^ ((β / q - (1 / r - 1 / 2)) * ((4 : ℕ) : ℝ)) /
        (1 - (2 : ℝ) ^ (β / q - (1 / r - 1 / 2)))) with hCgeo
  set CN : ENNReal := ENNReal.ofReal (((3 / 2 : ℝ) ^ q * 4) ^ (1 / q)) *
    (K + Cgeo) with hCN
  have hnorm : (∫⁻ z : ℝ,
      ‖brsWeightedProfile (1 / 2 - 1 / p) g (3 - z)‖ₑ ^ p) =
      ∫⁻ z : ℝ, ‖brsWeightedProfile (1 / 2 - 1 / p) g z‖ₑ ^ p :=
    lintegral_enorm_comp_three_sub _ p
  have hNb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainNearMajR 3 φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) x ^ q) ^ (1 / q) ≤ CN * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) x ^ q) =
        ∫⁻ x : ℝ, brsMainNearMajR 3 φ
          (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (lintegral_brsMainNearMajR_Lp_le 3 hφ hφcs hH hq1) ?_
    have hsum := brsMainFamilyR_tsum_le (image_three_sub_subset_Icc hE) hCβ hN
      hφ hφcs hφ' hφdcs hAφ hAφ' hυeq hυ hcs hRb hυ' hcs' hRb' hbd hA hAnn hbd'
      hA' hA'nn hmom hmom' hH hp hr hrq hpq hrel hr2 hMneg
    rw [hnorm] at hsum
    rw [hCN, mul_assoc]
    exact mul_le_mul' le_rfl hsum
  have hFb : (∫⁻ x : ℝ, ENNReal.ofReal x *
      brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) ^ (1 / q) ≤
      ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) * Gp := by
    have hcomm : (∫⁻ x : ℝ, ENNReal.ofReal x *
        brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q) =
        ∫⁻ x : ℝ, brsMainFarMaj p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g x ^ q *
          ENNReal.ofReal x := lintegral_congr fun x => mul_comm _ _
    rw [hcomm]
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_brsMainFarMaj_le p ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) g hq0)
      (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
      ← ENNReal.rpow_mul, mul_one_div, div_self (ne_of_gt hq0),
      ENNReal.rpow_one, ← hGp]
    exact le_of_eq (mul_assoc _ _ _).symm
  have hNmeas : Measurable fun x : ℝ => ENNReal.ofReal x *
      brsMainNearMajR 3 φ
        (fun w : ℝ => brsWeightedProfile (1 / 2 - 1 / p) g (3 - w))
        ((fun x : ℝ => 3 - x) '' E) x ^ q :=
    ENNReal.measurable_ofReal.mul
      ((measurable_brsMainNearMajR 3 hφ hφcs hH _).pow_const q)
  refine ⟨(2 : ENNReal) ^ ((q - 1) / q) * (CN +
    ENNReal.ofReal 16 ^ (1 / q) *
      ENNReal.ofReal ((3 / 2 : ℝ) *
        ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
        (8 : ℝ) ^ (1 - 1 / p))), ?_, ?_⟩
  · have h1 : (2 : ENNReal) ^ ((q - 1) / q) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by positivity) (by simp)
    have h2 : CN ≠ ⊤ := by
      rw [hCN]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        (ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩)
    have h3 : ENNReal.ofReal 16 ^ (1 / q) *
        ENNReal.ofReal ((3 / 2 : ℝ) *
          ((2 : ℝ) ^ (-((1 : ℕ) : ℝ))) ^ (-(1 / 2) : ℝ) *
          (8 : ℝ) ^ (1 - 1 / p)) ≠ ⊤ :=
      ENNReal.mul_ne_top
        (ENNReal.rpow_ne_top_of_nonneg (by positivity) ENNReal.ofReal_ne_top)
        ENNReal.ofReal_ne_top
    exact ENNReal.mul_ne_top h1 (ENNReal.add_ne_top.mpr ⟨h2, h3⟩)
  · exact lintegral_rpow_le_of_two_bounds' hq1 hNmeas
      (fun x => brsMainTwoRight_rpow_le hE hp1 hgc hφ.continuous hφcs hφnorm hH
        hHbd hq1 x) hNb hFb


/-! ## Covering numbers at two scales

Refining a coarse cover interval by interval bounds the fine covering number by
the sum of the localized ones.  This is what turns the Assouad-spectrum bound
(2.2), which is local, into a global statement, and is the combinatorial step
behind the endpoint estimate. -/

/-- **The two-scale covering inequality.** -/
theorem intervalCoveringNumber_le_sum {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ} (hcov : IsIntervalCover E Δ ι) :
    intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ := by
  classical
  choose ιa hιa hcarda using fun a : ℝ =>
    exists_intervalCover_card_eq_intervalCoveringNumber
      (E := E ∩ Icc (a - Δ / 2) (a + Δ / 2))
      (Set.inter_subset_left.trans hE) hδ
  have hcov' : IsIntervalCover E δ (ι.biUnion ιa) := by
    intro x hx
    obtain ⟨a, ha, hxa⟩ := Set.mem_iUnion₂.mp (hcov hx)
    obtain ⟨b, hb, hxb⟩ := Set.mem_iUnion₂.mp (hιa a ⟨hx, hxa⟩)
    exact Set.mem_iUnion₂.mpr ⟨b, Finset.mem_biUnion.mpr ⟨a, ha, hb⟩, hxb⟩
  calc intervalCoveringNumber E δ ≤ (ι.biUnion ιa).card :=
        intervalCoveringNumber_le_card hcov'
    _ ≤ ∑ a ∈ ι, (ιa a).card := Finset.card_biUnion_le
    _ = ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
        Finset.sum_congr rfl fun a _ => hcarda a


/-! ## Sub-multiplicativity of the covering numbers

Bounding each localized covering number by a common `M` turns the two-scale
inequality into `N(E, δ) ≤ N(E, Δ) · M`.  Iterating this is what produces the
Legendre transform. -/

/-- **The two-scale inequality, with a uniform local bound.** -/
theorem intervalCoveringNumber_le_mul {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hδ : 0 < δ) {ι : Finset ℝ} (hcov : IsIntervalCover E Δ ι)
    {M : ℕ}
    (hM : ∀ a ∈ ι, intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤ M) :
    intervalCoveringNumber E δ ≤ ι.card * M := by
  refine le_trans (intervalCoveringNumber_le_sum hE hδ hcov) ?_
  calc (∑ a ∈ ι, intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ) ≤ ∑ _a ∈ ι, M :=
        Finset.sum_le_sum hM
    _ = ι.card * M := by
        rw [Finset.sum_const, smul_eq_mul]

/-- **Sub-multiplicativity of the covering numbers.** -/
theorem intervalCoveringNumber_submul {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Δ δ : ℝ} (hΔ : 0 < Δ) (hδ : 0 < δ) {M : ℕ}
    (hM : ∀ a : ℝ, intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤ M) :
    intervalCoveringNumber E δ ≤ intervalCoveringNumber E Δ * M := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ
  have h := intervalCoveringNumber_le_mul hE hδ hcov (fun a _ => hM a)
  rwa [hcard] at h


/-! ## Clipping a window to `[1,2]`

The Assouad bound (2.2) is stated for intervals inside `[1,2]`, while the
intervals of a cover of `E` need not be.  Since `E ⊆ [1,2]`, clipping changes
nothing. -/

theorem inter_Icc_clip {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (u v : ℝ) :
    E ∩ Icc u v = E ∩ Icc (max u 1) (min v 2) := by
  ext x
  constructor
  · rintro ⟨hx, hu, hv⟩
    exact ⟨hx, max_le hu (hE hx).1, le_min hv (hE hx).2⟩
  · rintro ⟨hx, hu, hv⟩
    exact ⟨hx, le_trans (le_max_left _ _) hu, le_trans hv (min_le_left _ _)⟩

theorem intervalCoveringNumber_empty (δ : ℝ) :
    intervalCoveringNumber (∅ : Set ℝ) δ = 0 := by
  have hcov : IsIntervalCover (∅ : Set ℝ) δ (∅ : Finset ℝ) := by
    intro x hx
    exact absurd hx (Set.notMem_empty x)
  exact Nat.le_zero.mp (intervalCoveringNumber_le_card hcov)

/-- **The localized covering bound.**  On any window of length `Δ ≥ δ^θ` the
Assouad bound applies after clipping; on the leftover the trivial bound does. -/
theorem intervalCoveringNumber_window_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ : 0 < Δ) (a : ℝ) :
    (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ) ≤
      C * (Δ / δ) ^ γ' + (Δ / δ + 3) := by
  set u : ℝ := max (a - Δ / 2) 1 with hu
  set v : ℝ := min (a + Δ / 2) 2 with hv
  have hclip : E ∩ Icc (a - Δ / 2) (a + Δ / 2) = E ∩ Icc u v :=
    inter_Icc_clip hE _ _
  have hCnn : (0 : ℝ) ≤ C * (Δ / δ) ^ γ' := by
    have : (0 : ℝ) ≤ (Δ / δ) ^ γ' := Real.rpow_nonneg (by positivity) _
    positivity
  have htriv : (0 : ℝ) ≤ Δ / δ + 3 := by positivity
  rcases le_or_gt u v with huv | huv
  · have hlen : v - u ≤ Δ := by
      rw [hu, hv]
      rcases max_cases (a - Δ / 2) (1 : ℝ) with ⟨h1, _⟩ | ⟨h1, _⟩ <;>
        rcases min_cases (a + Δ / 2) (2 : ℝ) with ⟨h2, _⟩ | ⟨h2, _⟩ <;>
        rw [h1, h2] <;> linarith
    rcases le_or_gt (δ ^ θ) (v - u) with hcase | hcase
    · have hbound := hass δ u v hδ hδ1 (le_max_right _ _) huv
        (min_le_right _ _) hcase
      rw [hclip]
      refine le_trans hbound ?_
      have hmono : ((v - u) / δ) ^ γ' ≤ (Δ / δ) ^ γ' :=
        Real.rpow_le_rpow (by positivity)
          (div_le_div_of_nonneg_right hlen hδ.le) hγ'
      nlinarith [hmono, hCpos]
    · have hbound := brs_cover_bound_trivial (E := E) hδ huv
      rw [hclip]
      refine le_trans hbound ?_
      have : (v - u) / δ ≤ Δ / δ := div_le_div_of_nonneg_right hlen hδ.le
      linarith
  · have hempty : E ∩ Icc u v = ∅ := by
      rw [Set.Icc_eq_empty (not_le.mpr huv), Set.inter_empty]
    rw [hclip, hempty, intervalCoveringNumber_empty]
    simp only [Nat.cast_zero]
    linarith


/-! ## Sub-multiplicativity from the Assouad spectrum

Refining a `Δ`-cover of `E` by the Assouad bound on each window gives
`N(E, δ) ≲ N(E, Δ) · (Δ/δ)^{γ'}`.  Taking `Δ = δ^θ` this is the recursion whose
optimisation over `θ` is the Legendre transform `ν♯`. -/

/-- **Sub-multiplicativity with the Assouad exponent.** -/
theorem intervalCoveringNumber_assouad_submul {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ : 0 < Δ) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E Δ : ℝ) *
        (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ
  have h1 : intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
    intervalCoveringNumber_le_sum hE hδ hcov
  have h2 : ((intervalCoveringNumber E δ : ℕ) : ℝ) ≤
      ∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) := by
    exact_mod_cast h1
  refine le_trans h2 ?_
  have h3 : ∀ a ∈ ι, ((intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) ≤
      C * (Δ / δ) ^ γ' + (Δ / δ + 3) := fun a _ =>
    intervalCoveringNumber_window_le hE hCpos hγ' hass hδ hδ1 hΔ a
  calc (∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ))
      ≤ ∑ _a ∈ ι, (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := Finset.sum_le_sum h3
    _ = (ι.card : ℝ) * (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E Δ : ℝ) *
          (C * (Δ / δ) ^ γ' + (Δ / δ + 3)) := by rw [hcard]

/-- **The recursion at `Δ = δ^θ`.** -/
theorem intervalCoveringNumber_assouad_step {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ} (hCpos : 0 < C) (hγ' : 0 ≤ γ')
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E (δ ^ θ) : ℝ) *
        (C * (δ ^ (θ - 1)) ^ γ' + (δ ^ (θ - 1) + 3)) := by
  have hδθ : (0 : ℝ) < δ ^ θ := Real.rpow_pos_of_pos hδ _
  have hratio : δ ^ θ / δ = δ ^ (θ - 1) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
  have h := intervalCoveringNumber_assouad_submul hE hCpos hγ' hass hδ hδ1 hδθ
  rwa [hratio] at h


/-! ## Sliding a window into `[1,2]`

Clipping a window to `[1,2]` can shorten it below `δ^θ`, which would cost the
trivial bound; sliding it instead keeps the length exactly `Δ`, so the Assouad
bound applies to every window with no leftover term. -/

/-- Every window of length `Δ ≤ 1` can be slid into `[1,2]` without losing any
of `E`. -/
theorem exists_window_in_Icc {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {Δ : ℝ}
    (_hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1) (a : ℝ) :
    ∃ u : ℝ, 1 ≤ u ∧ u + Δ ≤ 2 ∧
      E ∩ Icc (a - Δ / 2) (a + Δ / 2) ⊆ E ∩ Icc u (u + Δ) := by
  set w : ℝ := max (a - Δ / 2) 1 with hw
  have hw1 : (1 : ℝ) ≤ w := le_max_right _ _
  refine ⟨max 1 (min w (2 - Δ)), le_max_left _ _, ?_, ?_⟩
  · have h1 : (1 : ℝ) ≤ 2 - Δ := by linarith
    have h2 : max 1 (min w (2 - Δ)) ≤ 2 - Δ :=
      max_le h1 (min_le_right _ _)
    linarith
  · rintro x ⟨hxE, hx1, hx2⟩
    obtain ⟨hxa, hxb⟩ := hE hxE
    have hwx : w ≤ x := by
      rw [hw]
      exact max_le hx1 hxa
    refine ⟨hxE, ?_, ?_⟩
    · exact max_le hxa (le_trans (min_le_left _ _) hwx)
    · rcases le_or_gt w (2 - Δ) with hcase | hcase
      · have hmin : min w (2 - Δ) = w := min_eq_left hcase
        have hmax : max 1 (min w (2 - Δ)) = w := by
          rw [hmin]
          exact max_eq_right hw1
        rw [hmax, hw]
        rcases max_cases (a - Δ / 2) (1 : ℝ) with ⟨h1, _⟩ | ⟨h1, h2⟩
        · rw [h1]
          linarith
        · rw [h1]
          linarith
      · have hmin : min w (2 - Δ) = 2 - Δ := min_eq_right hcase.le
        have hmax : max 1 (min w (2 - Δ)) = 2 - Δ := by
          rw [hmin]
          exact max_eq_right (by linarith)
        rw [hmax]
        linarith

/-- **The localized covering bound, with no leftover term.** -/
theorem intervalCoveringNumber_window_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {θ γ' C : ℝ}
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1)
    (hΔθ : δ ^ θ ≤ Δ) (a : ℝ) :
    (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ) ≤
      C * (Δ / δ) ^ γ' := by
  obtain ⟨u, hu1, hu2, hsub⟩ := exists_window_in_Icc hE hΔ0 hΔ1 a
  have hmono : intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ ≤
      intervalCoveringNumber (E ∩ Icc u (u + Δ)) δ :=
    intervalCoveringNumber_mono_set hsub (Set.inter_subset_left.trans hE) hδ
  have hbound := hass δ u (u + Δ) hδ hδ1 hu1 (by linarith) hu2
    (by simpa using hΔθ)
  simp only [add_sub_cancel_left] at hbound
  calc (intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℝ)
      ≤ (intervalCoveringNumber (E ∩ Icc u (u + Δ)) δ : ℝ) := by
        exact_mod_cast hmono
    _ ≤ C * (Δ / δ) ^ γ' := hbound


/-! ## The improved covering exponent

Refining a `δ^θ`-cover by the Assouad bound gives
`N(E, δ) ≲ δ^{-(θ(β+ε) + (1-θ)γ')}`, an improvement on the Minkowski exponent
`β + ε` whenever the Assouad spectrum is smaller.  This is what converts the
borderline divergence at the endpoint into convergence. -/

/-- **Sharp sub-multiplicativity.** -/
theorem intervalCoveringNumber_assouad_submul' {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {θ γ' C : ℝ}
    (hass : ∀ δ a b : ℝ, 0 < δ → δ < 1 → 1 ≤ a → a ≤ b → b ≤ 2 →
      δ ^ θ ≤ b - a →
      (intervalCoveringNumber (E ∩ Icc a b) δ : ℝ) ≤ C * ((b - a) / δ) ^ γ')
    {δ Δ : ℝ} (hδ : 0 < δ) (hδ1 : δ < 1) (hΔ0 : 0 < Δ) (hΔ1 : Δ ≤ 1)
    (hΔθ : δ ^ θ ≤ Δ) :
    (intervalCoveringNumber E δ : ℝ) ≤
      (intervalCoveringNumber E Δ : ℝ) * (C * (Δ / δ) ^ γ') := by
  obtain ⟨ι, hcov, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hΔ0
  have h1 : intervalCoveringNumber E δ ≤
      ∑ a ∈ ι, intervalCoveringNumber (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ :=
    intervalCoveringNumber_le_sum hE hδ hcov
  have h2 : ((intervalCoveringNumber E δ : ℕ) : ℝ) ≤
      ∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) := by
    exact_mod_cast h1
  refine le_trans h2 ?_
  have h3 : ∀ a ∈ ι, ((intervalCoveringNumber
      (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ) ≤ C * (Δ / δ) ^ γ' :=
    fun a _ => intervalCoveringNumber_window_le' hE hass hδ hδ1 hΔ0 hΔ1 hΔθ a
  calc (∑ a ∈ ι, ((intervalCoveringNumber
        (E ∩ Icc (a - Δ / 2) (a + Δ / 2)) δ : ℕ) : ℝ))
      ≤ ∑ _a ∈ ι, (C * (Δ / δ) ^ γ') := Finset.sum_le_sum h3
    _ = (ι.card : ℝ) * (C * (Δ / δ) ^ γ') := by
        rw [Finset.sum_const, nsmul_eq_mul]
    _ = (intervalCoveringNumber E Δ : ℝ) * (C * (Δ / δ) ^ γ') := by rw [hcard]

/-- **The improved covering bound.** -/
theorem brs_cover_bound_improved {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {β : ℝ} (hβ : HasUpperMinkowskiExponent E β) {ε : ℝ} (hε : 0 < ε)
    {θ γ' : ℝ} (hθ0 : 0 < θ)
    (hθγ : HasUpperAssouadSpectrumExponent E θ γ') :
    ∃ C : ℝ, 0 < C ∧ ∀ δ : ℝ, 0 < δ → δ < 1 →
      (intervalCoveringNumber E δ : ℝ) ≤
        C * δ ^ (-(θ * (β + ε) + (1 - θ) * γ')) := by
  obtain ⟨C₁, hC₁, hmink⟩ := brs_cover_bound_minkowski hβ hε
  obtain ⟨C₂, hC₂, hass⟩ := brs_cover_bound_assouad hθγ
  refine ⟨C₁ * C₂, by positivity, fun δ hδ hδ1 => ?_⟩
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hδθ0 : (0 : ℝ) < δ ^ θ := Real.rpow_pos_of_pos hδ _
  have hδθ1 : δ ^ θ < 1 := Real.rpow_lt_one hδ.le hδ1 hθ0
  have hstep := intervalCoveringNumber_assouad_submul' hE hass hδ hδ1 hδθ0
    hδθ1.le le_rfl
  have hcoarse : (intervalCoveringNumber E (δ ^ θ) : ℝ) ≤
      C₁ * (δ ^ θ) ^ (-(β + ε)) := by
    have h := hmink (δ ^ θ) hδθ0 hδθ1 Set.univ
    rwa [Set.inter_univ] at h
  have hratio : δ ^ θ / δ = δ ^ (θ - 1) := by
    rw [div_eq_mul_inv, ← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
  have hpos : (0 : ℝ) ≤ C₂ * (δ ^ θ / δ) ^ γ' := by
    have : (0 : ℝ) ≤ (δ ^ θ / δ) ^ γ' :=
      Real.rpow_nonneg (by positivity) _
    positivity
  refine le_trans hstep ?_
  refine le_trans (mul_le_mul_of_nonneg_right hcoarse hpos) (le_of_eq ?_)
  rw [hratio, ← Real.rpow_mul hδ.le, ← Real.rpow_mul hδ.le]
  rw [show C₁ * δ ^ (θ * -(β + ε)) * (C₂ * δ ^ ((θ - 1) * γ')) =
      C₁ * C₂ * (δ ^ (θ * -(β + ε)) * δ ^ ((θ - 1) * γ')) from by ring]
  rw [← Real.rpow_add hδ]
  congr 2
  ring

/-! ## From a continuous covering bound to the dyadic hypothesis

Propositions 5.5 and 5.6 consume the covering estimate in the dyadic form
`N(E, 2^{-j}) ≤ Cβ · 2^{βj}`.  Any bound valid for all `δ ∈ (0,1)` gives it,
once the scale `δ = 1` is handled separately. -/

theorem intervalCoveringNumber_one_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) :
    intervalCoveringNumber E 1 ≤ 1 := by
  have hcov : IsIntervalCover E 1 {(3 / 2 : ℝ)} := by
    intro x hx
    obtain ⟨h1, h2⟩ := hE hx
    refine Set.mem_iUnion₂.mpr ⟨3 / 2, Finset.mem_singleton_self _, ?_⟩
    constructor <;> norm_num <;> linarith
  simpa using intervalCoveringNumber_le_card hcov

/-- **A continuous covering bound gives the dyadic hypothesis.** -/
theorem brs_cover_dyadic_of_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {C β' : ℝ} (_hC : 0 < C) (_hβ' : 0 ≤ β')
    (hbound : ∀ δ : ℝ, 0 < δ → δ < 1 →
      (intervalCoveringNumber E δ : ℝ) ≤ C * δ ^ (-β')) (j : ℕ) :
    (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal) ≤
      ENNReal.ofReal (max C 1 * (2 : ℝ) ^ (β' * (j : ℝ))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hCmax : C ≤ max C 1 := le_max_left _ _
  have h1max : (1 : ℝ) ≤ max C 1 := le_max_right _ _
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (β' * (j : ℝ)) := Real.rpow_pos_of_pos h2 _
  have hreal : (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ℝ) ≤
      max C 1 * (2 : ℝ) ^ (β' * (j : ℝ)) := by
    rcases Nat.eq_zero_or_pos j with rfl | hj
    · have hone : (2 : ℝ) ^ (-((0 : ℕ) : ℝ)) = 1 := by norm_num
      rw [hone]
      have h := intervalCoveringNumber_one_le hE
      have hcast : (intervalCoveringNumber E 1 : ℝ) ≤ 1 := by
        exact_mod_cast h
      have hpow0 : (2 : ℝ) ^ (β' * ((0 : ℕ) : ℝ)) = 1 := by
        norm_num
      rw [hpow0, mul_one]
      linarith
    · have hδ0 : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) := Real.rpow_pos_of_pos h2 _
      have hjpos : (0 : ℝ) < (j : ℝ) := by exact_mod_cast hj
      have hδ1 : (2 : ℝ) ^ (-(j : ℝ)) < 1 := by
        refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
        linarith
      have h := hbound _ hδ0 hδ1
      have heq : ((2 : ℝ) ^ (-(j : ℝ))) ^ (-β') = (2 : ℝ) ^ (β' * (j : ℝ)) := by
        rw [← Real.rpow_mul h2.le]
        congr 1
        ring
      rw [heq] at h
      refine le_trans h ?_
      exact mul_le_mul_of_nonneg_right hCmax hpow.le
  calc (intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ENNReal)
      = ENNReal.ofReal
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(j : ℝ))) : ℝ)) := by
        rw [ENNReal.ofReal_natCast]
    _ ≤ ENNReal.ofReal (max C 1 * (2 : ℝ) ^ (β' * (j : ℝ))) :=
        ENNReal.ofReal_le_ofReal hreal

/-! ## BRS Proposition 5.5(i): the near operator `𝔐_{p,0}^±` for `p > 2`

The `s`-integral in `𝔐_p^±` is split at `s = 2|r - t|`; the far half is the
two-dimensional `𝔐_p` of §4, and the near half is `𝔐_{p,0}^±`.  For `p > 2`
the near half needs nothing about `E` at all: the weight
`s^{1/2 - 1/p}(s - |r-t|)^{-1/2}` lies in `L^{p'}` of the near window precisely
because `p' < 2`, and Hölder gives the bound `|r-t|^{1 - 2/p}‖g‖_p`. -/

/-- The shifted power integral over the near window. -/
theorem lintegral_shifted_rpow_Ioc {a c : ℝ} (ha : 0 < a) (hc : -1 < c) :
    (∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ((s - a) ^ c)) =
      ENNReal.ofReal (a ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hab : a ≤ 2 * a := by linarith
  have hint0 : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 a :=
    intervalIntegral.intervalIntegrable_rpow' hc
  have hint : IntervalIntegrable (fun s : ℝ => (s - a) ^ c) volume a (2 * a) := by
    have h := hint0.comp_sub_right a
    simpa [zero_add, show a + a = 2 * a from by ring] using h
  have hval : (∫ s in a..(2 * a), (s - a) ^ c) = a ^ (c + 1) / (c + 1) := by
    have hshift : (∫ s in a..(2 * a), (s - a) ^ c) =
        ∫ x in (0 : ℝ)..a, x ^ c := by
      have h := intervalIntegral.integral_comp_sub_right
        (a := a) (b := 2 * a) (f := fun x : ℝ => x ^ c) a
      simpa [sub_self, show 2 * a - a = a from by ring] using h
    rw [hshift, integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
    simp
  rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
    lintegral_Ioo_eq_ofReal_intervalIntegral hab hint
      (fun s hs => Real.rpow_nonneg (by linarith [hs.1]) _), hval]

/-- The constant in BRS Proposition 5.5(i). -/
def brsZeroConst (p : ℝ) : ℝ :=
  (2 : ℝ) ^ (1 / 2 - 1 / p) *
    (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p)

theorem brsZeroConst_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsZeroConst p := by
  have hp1 : (1 : ℝ) < p := by linarith
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : Real.conjExponent p < 2 := by
    rw [Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hden : (0 : ℝ) < 1 - Real.conjExponent p / 2 := by linarith
  rw [brsZeroConst]
  have h1 : (0 : ℝ) < (2 : ℝ) ^ (1 / 2 - 1 / p) := Real.rpow_pos_of_pos (by norm_num) _
  have h2 : (0 : ℝ) < (1 / (1 - Real.conjExponent p / 2)) ^ (1 / Real.conjExponent p) :=
    Real.rpow_pos_of_pos (by positivity) _
  positivity

/-- **The Hölder estimate behind BRS Proposition 5.5(i).** -/
theorem lintegral_mainZero_weight_le {p : ℝ} (hp2 : 2 < p) {a : ℝ} (ha : 0 < a)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc a (2 * a),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsZeroConst p * a ^ (1 - 2 / p)) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : p' < 2 := by
    rw [hp'def, Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hinvp' : 1 / p' = 1 - 1 / p := by
    rw [hp'def, Real.conjExponent]
    have hpne : p ≠ 0 := hp0.ne'
    have hp1ne : p - 1 ≠ 0 := by
      intro hcon
      rw [sub_eq_zero] at hcon
      exact absurd hcon.symm hp1.ne
    field_simp
  set κ : ℝ := 1 / 2 - 1 / p with hκ
  have hκ0 : 0 < κ := by
    rw [hκ]
    have : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num)]
      linarith
    linarith
  have hden : (0 : ℝ) < 1 - p' / 2 := by linarith
  -- the weight, and its `L^{p'}` norm on the near window
  set w : ℝ → ℝ := fun s => s ^ κ * (s - a) ^ (-(1 / 2) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  have hWle : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal (w s)) ^ p') ≤
      ENNReal.ofReal ((2 * a) ^ (κ * p')) *
        ENNReal.ofReal (a ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have hstep : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal (w s)) ^ p') ≤
        ∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ((2 * a) ^ (κ * p')) *
          ENNReal.ofReal ((s - a) ^ (-(p' / 2))) := by
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hs0 : 0 < s := lt_trans ha hs.1
      have hsa : 0 < s - a := by linarith [hs.1]
      have hpt : (ENNReal.ofReal (w s)) ^ p' =
          ENNReal.ofReal (s ^ (κ * p') * (s - a) ^ (-(p' / 2))) := by
        rw [hw]
        simp only
        rw [ENNReal.ofReal_rpow_of_pos (by positivity :
          (0 : ℝ) < s ^ κ * (s - a) ^ (-(1 / 2) : ℝ))]
        congr 1
        rw [Real.mul_rpow (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hsa.le _),
          ← Real.rpow_mul hs0.le, ← Real.rpow_mul hsa.le]
        have hexp : -(1 / 2 : ℝ) * p' = -(p' / 2) := by ring
        rw [hexp]
      rw [hpt, ENNReal.ofReal_mul (Real.rpow_nonneg hs0.le _)]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact Real.rpow_le_rpow hs0.le hs.2 (by positivity)
    refine le_trans hstep (le_of_eq ?_)
    rw [lintegral_const_mul _ (by fun_prop),
      lintegral_shifted_rpow_Ioc ha (by linarith : (-1 : ℝ) < -(p' / 2))]
    congr 2
    ring
  -- Hölder
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Ioc a (2 * a))) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Ioc a (2 * a), (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow hWle (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  -- the constant
  have hp'ne : p' ≠ 0 := hp'pos.ne'
  have hXpos : (0 : ℝ) <
      ((2 : ℝ) * a) ^ (κ * p') * (a ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have h1 : (0 : ℝ) < ((2 : ℝ) * a) ^ (κ * p') :=
      Real.rpow_pos_of_pos (by linarith) _
    have h2 : (0 : ℝ) < a ^ (1 - p' / 2) := Real.rpow_pos_of_pos ha _
    positivity
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by positivity) _),
    ENNReal.ofReal_rpow_of_pos hXpos]
  congr 1
  have he1 : κ * p' * (1 / p') = 1 / 2 - 1 / p := by
    rw [mul_assoc, mul_one_div, div_self hp'ne, mul_one, hκ]
  have he2 : (κ * p' + (1 - p' / 2)) * (1 / p') = 1 - 2 / p := by
    have hexp : (κ * p' + (1 - p' / 2)) * (1 / p') = κ + (1 / p') - 1 / 2 := by
      field_simp
      ring
    rw [hexp, hinvp', hκ]
    ring
  have hprod : ((2 : ℝ) * a) ^ (κ * p') * (a ^ (1 - p' / 2) / (1 - p' / 2)) =
      ((2 : ℝ) ^ (κ * p') * (1 / (1 - p' / 2))) * a ^ (κ * p' + (1 - p' / 2)) := by
    rw [Real.mul_rpow (by norm_num) ha.le, Real.rpow_add ha]
    ring
  rw [hprod, Real.mul_rpow (by positivity) (Real.rpow_nonneg ha.le _),
    Real.mul_rpow (by positivity) (by positivity),
    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2), ← Real.rpow_mul ha.le,
    he1, he2, brsZeroConst, ← hp'def]

/-! ## The splitting `𝔐_p^± ≲ 𝔐_{p,0}^± + 𝔐_{p,∞}^±` of BRS §5.3

The `s`-integral is cut at `s = 2|r - t|`.  On the far half `s - |r-t| ≥ s/2`,
so the singular factor disappears and the weight collapses to `s^{-1/p}` — the
two-dimensional `𝔐_p` of (4.3).  All the new work is on the near half. -/

/-- **`𝔐_{p,0}^-` of BRS §5.3**: the near half of `𝔐_p^-`. -/
def brsMainZeroLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc |r - t| (2 * |r - t|),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖

/-- **`𝔐_{p,∞}^-` of BRS §5.3**: the far half of `𝔐_p^-`. -/
def brsMainInfLeft (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc (2 * |r - t|) (r + t),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖

/-- On the far half the singular factor is harmless. -/
theorem mainWeight_far_le {p a s : ℝ} (ha : 0 ≤ a) (hs : 2 * a < s) :
    s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) ≤
      (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / p) : ℝ) := by
  have hs0 : 0 < s := lt_of_le_of_lt (by linarith) hs
  have hs2 : (0 : ℝ) < s / 2 := by linarith
  have hsa : s / 2 ≤ s - a := by linarith
  have hinv : (s - a) ^ (-(1 / 2) : ℝ) ≤ (s / 2) ^ (-(1 / 2) : ℝ) := by
    rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ s - a), Real.rpow_neg hs2.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hs2 _)
      (Real.rpow_le_rpow hs2.le hsa (by norm_num))
  have hhalf : (s / 2) ^ (-(1 / 2) : ℝ) = (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / 2) : ℝ) := by
    rw [div_eq_mul_inv, Real.mul_rpow hs0.le (by norm_num)]
    have h2 : ((2 : ℝ)⁻¹) ^ (-(1 / 2) : ℝ) = (2 : ℝ) ^ (1 / 2 : ℝ) := by
      rw [← Real.rpow_neg_one (2 : ℝ), ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)]
      norm_num
    rw [h2]
    ring
  calc s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)
      ≤ s ^ (1 / 2 - 1 / p) * (s / 2) ^ (-(1 / 2) : ℝ) :=
        mul_le_mul_of_nonneg_left hinv (Real.rpow_nonneg hs0.le _)
    _ = (2 : ℝ) ^ (1 / 2 : ℝ) * (s ^ (1 / 2 - 1 / p) * s ^ (-(1 / 2) : ℝ)) := by
        rw [hhalf]; ring
    _ = (2 : ℝ) ^ (1 / 2 : ℝ) * s ^ (-(1 / p) : ℝ) := by
        rw [← Real.rpow_add hs0]
        congr 2
        ring

/-- **The splitting of `𝔐_p^-`.** -/
theorem brsMainTwoLeft_le_split {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {r : ℝ}
    (hr : 0 < r) :
    brsMainTwoLeft E p g r ≤
      brsMainZeroLeft E p g r +
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * brsMainInfLeft E p g r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htmem : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  set a : ℝ := |r - t| with ha
  have ha0 : 0 ≤ a := abs_nonneg _
  have halt : a < r / 2 := by
    rw [ha, abs_lt]
    constructor <;> linarith
  have hac : a ≤ 2 * a := by linarith
  have hab : 2 * a ≤ r + t := by linarith
  have hab' : a ≤ r + t := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
      ENNReal.ofReal ‖g s‖ with hH
  have hmajor : ENNReal.ofReal
      ‖∫ s in a..(r + t),
        ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc a (r + t), H s := by
    refine ofReal_norm_intervalIntegral_le_lintegral hab' _ H ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans ha0 hs.1
    have hsa : 0 ≤ s - a := by linarith [hs.1]
    have hnn : 0 ≤ s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hs0 _) (Real.rpow_nonneg hsa _)
    rw [hH]
    simp only
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hnn,
      ENNReal.ofReal_mul hnn]
  have hIcc : (∫⁻ s in Icc a (r + t), H s) = ∫⁻ s in Ioc a (r + t), H s :=
    (setLIntegral_congr Ioc_ae_eq_Icc).symm
  have hsplit : (∫⁻ s in Ioc a (r + t), H s) ≤
      (∫⁻ s in Ioc a (2 * a), H s) + ∫⁻ s in Ioc (2 * a) (r + t), H s := by
    rw [← Set.Ioc_union_Ioc_eq_Ioc hac hab]
    exact lintegral_union_le _ _ _
  have hfar : (∫⁻ s in Ioc (2 * a) (r + t), H s) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ∫⁻ s in Ioc (2 * a) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine setLIntegral_mono' measurableSet_Ioc ?_
    intro s hs
    rw [hH]
    simp only
    rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal (mainWeight_far_le ha0 hs.1)) le_rfl
  -- assemble
  have hle : ENNReal.ofReal (r⁻¹ *
      ‖∫ s in a..(r + t),
        ((s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖) ≤
      ENNReal.ofReal r⁻¹ * ((∫⁻ s in Ioc a (2 * a), H s) +
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
          ∫⁻ s in Ioc (2 * a) (r + t),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) := by
    rw [ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hmajor ?_
    rw [hIcc]
    exact le_trans hsplit (add_le_add le_rfl hfar)
  refine le_trans hle ?_
  rw [mul_add]
  refine add_le_add ?_ ?_
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc |r - t| (2 * |r - t|),
          ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal ‖g s‖) t htmem
  · rw [show ENNReal.ofReal r⁻¹ * (ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ∫⁻ s in Ioc (2 * a) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) =
        ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * (ENNReal.ofReal r⁻¹ *
          ∫⁻ s in Ioc (2 * a) (r + t),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) from by ring]
    refine mul_le_mul' le_rfl ?_
    exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc (2 * |r - t|) (r + t),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) t htmem

/-! ## BRS Proposition 5.5(i) for the near half

For `p > 2` the Hölder bound `lintegral_mainZero_weight_le` is uniform in the
dilation `t`, so `𝔐_{p,0}^-` is bounded by a constant multiple of `‖g‖_p` on
its support `(2/3, 4)` — no hypothesis on `E` beyond `E ⊆ [1,2]` enters. -/

/-- The constant in the pointwise bound for `𝔐_{p,0}^-`. -/
def brsMainZeroBound (p : ℝ) : ℝ := 3 * brsZeroConst p

theorem brsMainZeroBound_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsMainZeroBound p := by
  rw [brsMainZeroBound]
  have := brsZeroConst_pos hp2
  positivity

/-- **The pointwise bound for `𝔐_{p,0}^-`, `p > 2`.** -/
theorem brsMainZeroLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainZeroLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainZeroBound p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hexp : (0 : ℝ) < 1 - 2 / p := by
    have : 2 / p < 1 := by
      rw [div_lt_one hp0]
      linarith
    linarith
  have hexp1 : 1 - 2 / p ≤ 1 := by
    have : (0 : ℝ) < 2 / p := by positivity
    linarith
  have hCpos : 0 < brsZeroConst p := brsZeroConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    set a : ℝ := |r - t| with ha
    have ha0 : 0 ≤ a := abs_nonneg _
    have halt : a < r / 2 := by
      rw [ha, abs_lt]
      constructor <;> linarith
    have halt2 : a ≤ 2 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hapow : a ^ (1 - 2 / p) ≤ 2 := by
      calc a ^ (1 - 2 / p) ≤ (2 : ℝ) ^ (1 - 2 / p) :=
            Real.rpow_le_rpow ha0 halt2 hexp.le
        _ ≤ (2 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp1
        _ = 2 := by norm_num
    have hinner : (∫⁻ s in Ioc a (2 * a),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (brsZeroConst p * a ^ (1 - 2 / p)) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      rcases eq_or_lt_of_le ha0 with hz | hapos
      · rw [← hz]
        simp
      · exact lintegral_mainZero_weight_le hp2 hapos hg
    refine le_trans (mul_le_mul' le_rfl hinner) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    rw [brsMainZeroBound]
    have hstep : r⁻¹ * (brsZeroConst p * a ^ (1 - 2 / p)) ≤
        (3 / 2) * (brsZeroConst p * 2) := by
      refine mul_le_mul hrinv ?_ (by positivity) (by norm_num)
      exact mul_le_mul_of_nonneg_left hapow hCpos.le
    calc r⁻¹ * (brsZeroConst p * a ^ (1 - 2 / p))
        ≤ (3 / 2) * (brsZeroConst p * 2) := hstep
      _ = 3 * brsZeroConst p := by ring
  · rw [Set.indicator_of_notMem hr, brsMainZeroLeft, brsMainWindow_empty hE hr]
    simp

/-- **BRS Proposition 5.5(i) for the near half `𝔐_{p,0}^-`.** -/
theorem prop55i_brsMainZeroLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroBound p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set B : ENNReal := ENNReal.ofReal (brsMainZeroBound p) * Gp with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have h := brsMainZeroLeft_le_indicator hE hp2 hg r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at h
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at h
      rw [le_antisymm h (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ≤
      B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    refine mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (brsMainZeroBound p) * ENNReal.ofReal 14 ^ (1 / q) * Gp := by
        rw [hB]; ring

/-! ## The right endpoint: `𝔐_{p,0}^+` and `𝔐_{p,∞}^+`

For `𝔐_p^+` the singularity sits at the right end `s = r + t`, so the
`s`-domain is broken at `(r+t)/2` instead: the near half is
`((r+t)/2, r+t)`, the far half `(|r-t|, (r+t)/2)`.  On the far half
`r + t - s ≥ s`, so the weight collapses to `s^{-1/p}` with no constant at
all. -/

/-- The reflected power integral. -/
theorem lintegral_reflected_rpow_Ioc {b c : ℝ} (hb : 0 < b) (hc : -1 < c) :
    (∫⁻ s in Ioc (0 : ℝ) b, ENNReal.ofReal ((b - s) ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hint0 : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 b :=
    intervalIntegral.intervalIntegrable_rpow' hc
  have hint : IntervalIntegrable (fun s : ℝ => (b - s) ^ c) volume 0 b := by
    have h := (hint0.comp_sub_left b).symm
    simpa [sub_zero, sub_self] using h
  have hval : (∫ s in (0 : ℝ)..b, (b - s) ^ c) = b ^ (c + 1) / (c + 1) := by
    have hshift : (∫ s in (0 : ℝ)..b, (b - s) ^ c) = ∫ x in (0 : ℝ)..b, x ^ c := by
      have h := intervalIntegral.integral_comp_sub_left
        (a := (0 : ℝ)) (b := b) (f := fun x : ℝ => x ^ c) b
      simpa [sub_zero, sub_self] using h
    rw [hshift, integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
    simp
  rw [setLIntegral_congr (Ioo_ae_eq_Ioc).symm,
    lintegral_Ioo_eq_ofReal_intervalIntegral hb.le hint
      (fun s hs => Real.rpow_nonneg (by linarith [hs.2]) _), hval]

/-- **The Hölder estimate at the right endpoint.** -/
theorem lintegral_mainZeroRight_weight_le {p : ℝ} (hp2 : 2 < p) {b : ℝ}
    (hb : 0 < b) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc (b / 2) b,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsZeroConst p * b ^ (1 - 2 / p)) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos (by linarith) (by linarith)
  have hp'2 : p' < 2 := by
    rw [hp'def, Real.conjExponent, div_lt_iff₀ (by linarith : (0 : ℝ) < p - 1)]
    linarith
  have hinvp' : 1 / p' = 1 - 1 / p := by
    rw [hp'def, Real.conjExponent]
    have hpne : p ≠ 0 := hp0.ne'
    have hp1ne : p - 1 ≠ 0 := by
      intro hcon
      rw [sub_eq_zero] at hcon
      exact absurd hcon.symm hp1.ne
    field_simp
  set κ : ℝ := 1 / 2 - 1 / p with hκ
  have hκ0 : 0 < κ := by
    rw [hκ]
    have : 1 / p < 1 / 2 := by
      rw [div_lt_div_iff₀ hp0 (by norm_num)]
      linarith
    linarith
  have hden : (0 : ℝ) < 1 - p' / 2 := by linarith
  have hp'ne : p' ≠ 0 := hp'pos.ne'
  set w : ℝ → ℝ := fun s => s ^ κ * (b - s) ^ (-(1 / 2) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  -- the `L^{p'}` norm of the weight on the near window
  have hWle : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal (w s)) ^ p') ≤
      ENNReal.ofReal (b ^ (κ * p')) *
        ENNReal.ofReal (b ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have hstep : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal (w s)) ^ p') ≤
        ∫⁻ s in Ioc (0 : ℝ) b, ENNReal.ofReal (b ^ (κ * p')) *
          ENNReal.ofReal ((b - s) ^ (-(p' / 2))) := by
      refine le_trans (lintegral_mono_set
        (Set.Ioc_subset_Ioc (show (0 : ℝ) ≤ b / 2 by linarith) (le_refl b))) ?_
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hs0 : 0 < s := hs.1
      have hbs : 0 ≤ b - s := by linarith [hs.2]
      have hpt : (ENNReal.ofReal (w s)) ^ p' =
          ENNReal.ofReal (s ^ (κ * p') * (b - s) ^ (-(p' / 2))) := by
        rw [hw]
        simp only
        rw [ENNReal.ofReal_rpow_of_nonneg
          (mul_nonneg (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hbs _))
          hp'pos.le]
        congr 1
        rw [Real.mul_rpow (Real.rpow_nonneg hs0.le _) (Real.rpow_nonneg hbs _),
          ← Real.rpow_mul hs0.le, ← Real.rpow_mul hbs]
        have hexp : -(1 / 2 : ℝ) * p' = -(p' / 2) := by ring
        rw [hexp]
      rw [hpt, ENNReal.ofReal_mul (Real.rpow_nonneg hs0.le _)]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      exact Real.rpow_le_rpow hs0.le hs.2 (by positivity)
    refine le_trans hstep (le_of_eq ?_)
    rw [lintegral_const_mul _ (by fun_prop),
      lintegral_reflected_rpow_Ioc hb (by linarith : (-1 : ℝ) < -(p' / 2))]
    congr 2
    ring
  -- Hölder
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Ioc (b / 2) b)) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Ioc (b / 2) b, (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow hWle (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' ?_ le_rfl
  -- the constant
  have hXpos : (0 : ℝ) < b ^ (κ * p') * (b ^ (1 - p' / 2) / (1 - p' / 2)) := by
    have h1 : (0 : ℝ) < b ^ (κ * p') := Real.rpow_pos_of_pos hb _
    have h2 : (0 : ℝ) < b ^ (1 - p' / 2) := Real.rpow_pos_of_pos hb _
    positivity
  rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hb.le _),
    ENNReal.ofReal_rpow_of_pos hXpos]
  refine ENNReal.ofReal_le_ofReal ?_
  have he2 : (κ * p' + (1 - p' / 2)) * (1 / p') = 1 - 2 / p := by
    have hexp : (κ * p' + (1 - p' / 2)) * (1 / p') = κ + (1 / p') - 1 / 2 := by
      field_simp
      ring
    rw [hexp, hinvp', hκ]
    ring
  have hprod : b ^ (κ * p') * (b ^ (1 - p' / 2) / (1 - p' / 2)) =
      (1 / (1 - p' / 2)) * b ^ (κ * p' + (1 - p' / 2)) := by
    rw [Real.rpow_add hb]
    ring
  rw [hprod, Real.mul_rpow (by positivity) (Real.rpow_nonneg hb.le _),
    ← Real.rpow_mul hb.le, he2]
  refine mul_le_mul_of_nonneg_right ?_ (Real.rpow_nonneg hb.le _)
  rw [brsZeroConst, ← hp'def, ← hκ]
  have h2κ : (1 : ℝ) ≤ (2 : ℝ) ^ κ := by
    have h := Real.rpow_le_rpow_of_exponent_le (by norm_num : (1 : ℝ) ≤ 2) hκ0.le
    rwa [Real.rpow_zero] at h
  exact le_mul_of_one_le_left (Real.rpow_nonneg (by positivity) _) h2κ

/-! ## `𝔐_{p,0}^+`, `𝔐_{p,∞}^+`, and BRS Proposition 5.5(i) at the right endpoint -/

/-- **`𝔐_{p,0}^+` of BRS §5.3**: the near half of `𝔐_p^+`. -/
def brsMainZeroRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc ((r + t) / 2) (r + t),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖

/-- **`𝔐_{p,∞}^+` of BRS §5.3**: the far half of `𝔐_p^+`. -/
def brsMainInfRight (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ E ∩ Ioo (r / 2) (3 * r / 2),
    ENNReal.ofReal r⁻¹ *
      ∫⁻ s in Ioc |r - t| ((r + t) / 2),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖

/-- On the far half of `𝔐_p^+` the singular factor is harmless, with no
constant at all. -/
theorem mainWeightRight_far_le {p b s : ℝ} (hs0 : 0 < s) (hsb : s ≤ b / 2) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤ s ^ (-(1 / p) : ℝ) := by
  have hbs : s ≤ b - s := by linarith
  have hinv : (b - s) ^ (-(1 / 2) : ℝ) ≤ s ^ (-(1 / 2) : ℝ) := by
    rw [Real.rpow_neg (by linarith : (0 : ℝ) ≤ b - s), Real.rpow_neg hs0.le]
    exact inv_anti₀ (Real.rpow_pos_of_pos hs0 _)
      (Real.rpow_le_rpow hs0.le hbs (by norm_num))
  calc s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)
      ≤ s ^ (1 / 2 - 1 / p) * s ^ (-(1 / 2) : ℝ) :=
        mul_le_mul_of_nonneg_left hinv (Real.rpow_nonneg hs0.le _)
    _ = s ^ (-(1 / p) : ℝ) := by
        rw [← Real.rpow_add hs0]
        congr 1
        ring

/-- **The splitting of `𝔐_p^+`.** -/
theorem brsMainTwoRight_le_split {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {r : ℝ}
    (hr : 0 < r) :
    brsMainTwoRight E p g r ≤
      brsMainZeroRight E p g r + brsMainInfRight E p g r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have htmem : t ∈ E ∩ Ioo (r / 2) (3 * r / 2) := ⟨htE, ht1, ht2⟩
  set a : ℝ := |r - t| with ha
  set b : ℝ := r + t with hb
  have ha0 : 0 ≤ a := abs_nonneg _
  have halt : a < r / 2 := by
    rw [ha, abs_lt]
    constructor <;> linarith
  have hb0 : 0 < b := by rw [hb]; linarith
  have hac : a ≤ b / 2 := by
    rw [hb]
    linarith
  have hcb : b / 2 ≤ b := by linarith
  have hab' : a ≤ b := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ)) *
      ENNReal.ofReal ‖g s‖ with hH
  have hmajor : ENNReal.ofReal
      ‖∫ s in a..b,
        ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖ ≤
      ∫⁻ s in Icc a b, H s := by
    refine ofReal_norm_intervalIntegral_le_lintegral hab' _ H ?_
    intro s hs
    have hs0 : 0 ≤ s := le_trans ha0 hs.1
    have hbs : 0 ≤ b - s := by linarith [hs.2]
    have hnn : 0 ≤ s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) :=
      mul_nonneg (Real.rpow_nonneg hs0 _) (Real.rpow_nonneg hbs _)
    rw [hH]
    simp only
    rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hnn,
      ENNReal.ofReal_mul hnn]
  have hIcc : (∫⁻ s in Icc a b, H s) = ∫⁻ s in Ioc a b, H s :=
    (setLIntegral_congr Ioc_ae_eq_Icc).symm
  have hsplit : (∫⁻ s in Ioc a b, H s) ≤
      (∫⁻ s in Ioc a (b / 2), H s) + ∫⁻ s in Ioc (b / 2) b, H s := by
    rw [← Set.Ioc_union_Ioc_eq_Ioc hac hcb]
    exact lintegral_union_le _ _ _
  have hfar : (∫⁻ s in Ioc a (b / 2), H s) ≤
      ∫⁻ s in Ioc a (b / 2),
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖ := by
    refine setLIntegral_mono' measurableSet_Ioc ?_
    intro s hs
    have hs0 : 0 < s := lt_of_le_of_lt ha0 hs.1
    rw [hH]
    simp only
    exact mul_le_mul' (ENNReal.ofReal_le_ofReal
      (mainWeightRight_far_le hs0 hs.2)) le_rfl
  have hle : ENNReal.ofReal (r⁻¹ *
      ‖∫ s in a..b,
        ((s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s‖) ≤
      ENNReal.ofReal r⁻¹ *
        ((∫⁻ s in Ioc a (b / 2),
            ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) +
          ∫⁻ s in Ioc (b / 2) b, H s) := by
    rw [ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    refine le_trans hmajor ?_
    rw [hIcc]
    exact le_trans hsplit (add_le_add hfar le_rfl)
  refine le_trans hle ?_
  rw [mul_add, add_comm]
  refine add_le_add ?_ ?_
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc ((r + t) / 2) (r + t),
          ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (r + t - s) ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal ‖g s‖) t htmem
  · exact le_iSup₂ (f := fun t (_ : t ∈ E ∩ Ioo (r / 2) (3 * r / 2)) =>
      ENNReal.ofReal r⁻¹ *
        ∫⁻ s in Ioc |r - t| ((r + t) / 2),
          ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) t htmem

/-- The constant in the pointwise bound for `𝔐_{p,0}^+`. -/
def brsMainZeroBoundRight (p : ℝ) : ℝ := 9 * brsZeroConst p

theorem brsMainZeroBoundRight_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainZeroBoundRight p := by
  rw [brsMainZeroBoundRight]
  have := brsZeroConst_pos hp2
  positivity

/-- **The pointwise bound for `𝔐_{p,0}^+`, `p > 2`.** -/
theorem brsMainZeroRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainZeroRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainZeroBoundRight p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hexp : (0 : ℝ) < 1 - 2 / p := by
    have : 2 / p < 1 := by
      rw [div_lt_one hp0]
      linarith
    linarith
  have hexp1 : 1 - 2 / p ≤ 1 := by
    have : (0 : ℝ) < 2 / p := by positivity
    linarith
  have hCpos : 0 < brsZeroConst p := brsZeroConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    set b : ℝ := r + t with hb
    have hb0 : 0 < b := by rw [hb]; linarith
    have hble : b ≤ 6 := by
      rw [hb]
      linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hbpow : b ^ (1 - 2 / p) ≤ 6 := by
      calc b ^ (1 - 2 / p) ≤ (6 : ℝ) ^ (1 - 2 / p) :=
            Real.rpow_le_rpow hb0.le hble hexp.le
        _ ≤ (6 : ℝ) ^ (1 : ℝ) :=
            Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp1
        _ = 6 := by norm_num
    have hinner := lintegral_mainZeroRight_weight_le hp2 hb0 (g := g) hg
    refine le_trans (mul_le_mul' le_rfl hinner) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    rw [brsMainZeroBoundRight]
    have hstep : r⁻¹ * (brsZeroConst p * b ^ (1 - 2 / p)) ≤
        (3 / 2) * (brsZeroConst p * 6) := by
      refine mul_le_mul hrinv ?_ (by positivity) (by norm_num)
      exact mul_le_mul_of_nonneg_left hbpow hCpos.le
    calc r⁻¹ * (brsZeroConst p * b ^ (1 - 2 / p))
        ≤ (3 / 2) * (brsZeroConst p * 6) := hstep
      _ = 9 * brsZeroConst p := by ring
  · rw [Set.indicator_of_notMem hr, brsMainZeroRight, brsMainWindow_empty hE hr]
    simp

/-- **BRS Proposition 5.5(i) for the near half `𝔐_{p,0}^+`.** -/
theorem prop55i_brsMainZeroRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set B : ENNReal := ENNReal.ofReal (brsMainZeroBoundRight p) * Gp with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have h := brsMainZeroRight_le_indicator hE hp2 hg r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at h
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at h
      rw [le_antisymm h (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ≤
      B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    refine mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * brsMainZeroRight E p g r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal (brsMainZeroBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) * Gp := by
        rw [hB]; ring

/-! ## The far halves `𝔐_{p,∞}^±`, and BRS Proposition 5.5(i)

On the far halves the weight is the plain power `s^{-1/p}`, which lies in
`L^{p'}(0,6)` exactly when `p' < p`, i.e. when `p > 2`.  So the same Hölder
argument closes the far halves too, and Proposition 5.5(i) follows with no
hypothesis on `E` beyond `E ⊆ [1,2]`. -/

/-- The radial integral, for a maximal function supported in `(2/3, 4)` and
bounded there. -/
theorem lintegral_radial_indicator_rpow_le {F : ℝ → ENNReal} {C q : ℝ}
    (hq0 : 0 < q) {G : ENNReal}
    (h : ∀ r : ℝ, F r ≤ (Ioo (2 / 3 : ℝ) 4).indicator
      (fun _ => ENNReal.ofReal C * G) r) :
    (∫⁻ r, ENNReal.ofReal r * F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal C * ENNReal.ofReal 14 ^ (1 / q) * G := by
  set B : ENNReal := ENNReal.ofReal C * G with hB
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * F r ^ q ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun r : ℝ => ENNReal.ofReal r * B ^ q) r := by
    intro r
    have hr' := h r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [Set.indicator_of_mem hr]
      rw [Set.indicator_of_mem hr] at hr'
      exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hr' hq0.le)
    · rw [Set.indicator_of_notMem hr]
      rw [Set.indicator_of_notMem hr] at hr'
      rw [le_antisymm hr' (zero_le), ENNReal.zero_rpow_of_pos hq0, mul_zero]
  have hmain : (∫⁻ r, ENNReal.ofReal r * F r ^ q) ≤ B ^ q * ENNReal.ofReal 14 := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_indicator measurableSet_Ioo]
    have hbd : (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q) ≤
        ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
      calc (∫⁻ r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal r * B ^ q)
          ≤ ∫⁻ _r in Ioo (2 / 3 : ℝ) 4, ENNReal.ofReal 4 * B ^ q := by
            refine setLIntegral_mono' measurableSet_Ioo ?_
            intro r hr
            exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal 4 * B ^ q * volume (Ioo (2 / 3 : ℝ) 4) := by
            rw [setLIntegral_const]
    refine le_trans hbd ?_
    have hvol : volume (Ioo (2 / 3 : ℝ) 4) = ENNReal.ofReal (4 - 2 / 3) := by
      rw [Real.volume_Ioo]
    rw [hvol, mul_comm (ENNReal.ofReal 4) (B ^ q), mul_assoc,
      ← ENNReal.ofReal_mul (by norm_num)]
    exact mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal (by norm_num))
  calc (∫⁻ r, ENNReal.ofReal r * F r ^ q) ^ (1 / q)
      ≤ (B ^ q * ENNReal.ofReal 14) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = B * ENNReal.ofReal 14 ^ (1 / q) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = ENNReal.ofReal C * ENNReal.ofReal 14 ^ (1 / q) * G := by
        rw [hB]; ring

/-- The power integral over `[0, b]`. -/
theorem lintegral_rpow_Icc_zero_eq {c b : ℝ} (hc : -1 < c) (hb : 0 < b) :
    (∫⁻ s in Icc (0 : ℝ) b, ENNReal.ofReal (s ^ c)) =
      ENNReal.ofReal (b ^ (c + 1) / (c + 1)) := by
  have hc1 : (0 : ℝ) < c + 1 := by linarith
  have hint : IntervalIntegrable (fun x : ℝ => x ^ c) volume 0 b :=
    intervalIntegral.intervalIntegrable_rpow' hc
  rw [← setLIntegral_congr (Ioo_ae_eq_Icc (a := (0 : ℝ)) (b := b)),
    lintegral_Ioo_eq_ofReal_intervalIntegral hb.le hint
      (fun s hs => Real.rpow_nonneg hs.1.le _),
    integral_rpow (Or.inl hc), Real.zero_rpow hc1.ne']
  simp

/-- The constant in the far-half estimate. -/
def brsMainInfConst (p : ℝ) : ℝ :=
  ((6 : ℝ) ^ (1 - Real.conjExponent p / p) / (1 - Real.conjExponent p / p)) ^
    (1 / Real.conjExponent p)

theorem brsMainInfConst_pos {p : ℝ} (hp2 : 2 < p) : 0 < brsMainInfConst p := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp'pos : 0 < Real.conjExponent p := by
    rw [Real.conjExponent]
    exact div_pos hp0 (by linarith)
  have hlt : Real.conjExponent p / p < 1 := by
    rw [Real.conjExponent, div_div, div_lt_one (by nlinarith)]
    nlinarith
  rw [brsMainInfConst]
  refine Real.rpow_pos_of_pos ?_ _
  have h6 : (0 : ℝ) < (6 : ℝ) ^ (1 - Real.conjExponent p / p) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have : (0 : ℝ) < 1 - Real.conjExponent p / p := by linarith
  positivity

/-- **The Hölder estimate on the far halves.** -/
theorem lintegral_mainInf_weight_le {p : ℝ} (hp2 : 2 < p) {u v : ℝ}
    (hu : 0 ≤ u) (hv : v ≤ 6) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ s in Ioc u v,
        ENNReal.ofReal (s ^ (-(1 / p) : ℝ)) * ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (brsMainInfConst p) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := by linarith
  have hp1 : (1 : ℝ) < p := by linarith
  set p' : ℝ := Real.conjExponent p with hp'def
  have hp'pos : 0 < p' := by
    rw [hp'def, Real.conjExponent]
    exact div_pos hp0 (by linarith)
  have hlt : p' / p < 1 := by
    rw [hp'def, Real.conjExponent, div_div, div_lt_one (by nlinarith)]
    nlinarith
  have hc : (-1 : ℝ) < -(p' / p) := by linarith
  have hden : (0 : ℝ) < 1 - p' / p := by linarith
  set w : ℝ → ℝ := fun s => s ^ (-(1 / p) : ℝ) with hw
  have hwmeas : Measurable fun s : ℝ => ENNReal.ofReal (w s) := by
    rw [hw]; fun_prop
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  have hsub : Ioc u v ⊆ Icc (0 : ℝ) 6 := by
    intro s hs
    exact ⟨le_trans hu hs.1.le, le_trans hs.2 hv⟩
  refine le_trans (lintegral_mono_set hsub) ?_
  -- the `L^{p'}` norm of the weight
  have hWeq : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal (w s)) ^ p') =
      ENNReal.ofReal ((6 : ℝ) ^ (1 - p' / p) / (1 - p' / p)) := by
    have hcongr : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal (w s)) ^ p') =
        ∫⁻ s in Icc (0 : ℝ) 6, ENNReal.ofReal (s ^ (-(p' / p))) := by
      refine setLIntegral_congr_fun measurableSet_Icc ?_
      intro s hs
      rw [hw]
      simp only
      rw [ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg hs.1 _) hp'pos.le,
        ← Real.rpow_mul hs.1]
      congr 1
      field_simp
    rw [hcongr, lintegral_rpow_Icc_zero_eq hc (by norm_num : (0 : ℝ) < 6)]
    congr 1
    · congr 1 <;> ring
  have hpq : Real.HolderConjugate p' p := by
    rw [hp'def]
    exact (Real.HolderConjugate.conjExponent hp1).symm
  have hkey := ENNReal.lintegral_mul_le_Lp_mul_Lq
    (volume.restrict (Icc (0 : ℝ) 6)) hpq hwmeas.aemeasurable hgmeas.aemeasurable
  simp only [Pi.mul_apply] at hkey
  refine le_trans hkey ?_
  have hGle : (∫⁻ s in Icc (0 : ℝ) 6, (ENNReal.ofReal ‖g s‖) ^ p) ≤
      ∫⁻ s, (ENNReal.ofReal ‖g s‖) ^ p := setLIntegral_le_lintegral _ _
  refine le_trans (mul_le_mul' (ENNReal.rpow_le_rpow (le_of_eq hWeq) (by positivity))
    (ENNReal.rpow_le_rpow hGle (by positivity))) ?_
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  rw [brsMainInfConst, ← hp'def,
    ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]

/-! ## BRS Proposition 5.5(i)

Assembling the two halves gives the full statement: for `p > 2` and every
`0 < q < ∞`, `‖𝔐_p^± g‖_{L^q(r dr)} ≲_p ‖g‖_p`, with no hypothesis on the
dilation set beyond `E ⊆ [1,2]`. -/

/-- **The pointwise bound for `𝔐_{p,∞}^-`.** -/
theorem brsMainInfLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainInfLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (3 / 2 * brsMainInfConst p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hCpos : 0 < brsMainInfConst p := brsMainInfConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hu : (0 : ℝ) ≤ 2 * |r - t| := by positivity
    have hv : r + t ≤ 6 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    refine le_trans (mul_le_mul' le_rfl
      (lintegral_mainInf_weight_le hp2 hu hv hg)) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    exact mul_le_mul_of_nonneg_right hrinv hCpos.le
  · rw [Set.indicator_of_notMem hr, brsMainInfLeft, brsMainWindow_empty hE hr]
    simp

/-- **The pointwise bound for `𝔐_{p,∞}^+`.** -/
theorem brsMainInfRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainInfRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (3 / 2 * brsMainInfConst p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  have hCpos : 0 < brsMainInfConst p := brsMainInfConst_pos hp2
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hu : (0 : ℝ) ≤ |r - t| := abs_nonneg _
    have hv : (r + t) / 2 ≤ 6 := by linarith [hr.2]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    refine le_trans (mul_le_mul' le_rfl
      (lintegral_mainInf_weight_le hp2 hu hv hg)) ?_
    rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
    exact mul_le_mul_of_nonneg_right hrinv hCpos.le
  · rw [Set.indicator_of_notMem hr, brsMainInfRight, brsMainWindow_empty hE hr]
    simp

/-- The constant of BRS Proposition 5.5(i) at the left endpoint. -/
def brsMainTotalBoundLeft (p : ℝ) : ℝ :=
  brsMainZeroBound p + (2 : ℝ) ^ (1 / 2 : ℝ) * (3 / 2 * brsMainInfConst p)

/-- The constant of BRS Proposition 5.5(i) at the right endpoint. -/
def brsMainTotalBoundRight (p : ℝ) : ℝ :=
  brsMainZeroBoundRight p + 3 / 2 * brsMainInfConst p

theorem brsMainTotalBoundLeft_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainTotalBoundLeft p := by
  have h1 := brsMainZeroBound_pos hp2
  have h2 := brsMainInfConst_pos hp2
  have h3 : (0 : ℝ) < (2 : ℝ) ^ (1 / 2 : ℝ) := Real.rpow_pos_of_pos (by norm_num) _
  rw [brsMainTotalBoundLeft]
  positivity

theorem brsMainTotalBoundRight_pos {p : ℝ} (hp2 : 2 < p) :
    0 < brsMainTotalBoundRight p := by
  have h1 := brsMainZeroBoundRight_pos hp2
  have h2 := brsMainInfConst_pos hp2
  rw [brsMainTotalBoundRight]
  positivity

/-- **The pointwise bound for `𝔐_p^-`, `p > 2`.** -/
theorem brsMainTwoLeft_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainTwoLeft E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainTotalBoundLeft p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  have hz := brsMainZeroLeft_le_indicator hE hp2 hg r
  have hi := brsMainInfLeft_le_indicator hE hp2 hg r
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    rw [Set.indicator_of_mem hr] at hz hi
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    refine le_trans (brsMainTwoLeft_le_split hr0) ?_
    refine le_trans (add_le_add hz (mul_le_mul' le_rfl hi)) ?_
    have h2nn : (0 : ℝ) ≤ (2 : ℝ) ^ (1 / 2 : ℝ) := Real.rpow_nonneg (by norm_num) _
    have hCnn : (0 : ℝ) ≤ 3 / 2 * brsMainInfConst p := by
      have := brsMainInfConst_pos hp2
      positivity
    rw [← mul_assoc, ← ENNReal.ofReal_mul h2nn, ← add_mul,
      ← ENNReal.ofReal_add (le_of_lt (brsMainZeroBound_pos hp2))
        (mul_nonneg h2nn hCnn), brsMainTotalBoundLeft]
  · rw [Set.indicator_of_notMem hr, brsMainTwoLeft_eq_zero hE hr]

/-- **The pointwise bound for `𝔐_p^+`, `p > 2`.** -/
theorem brsMainTwoRight_le_indicator {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp2 : 2 < p) {g : ℝ → ℂ} (hg : Measurable g) (r : ℝ) :
    brsMainTwoRight E p g r ≤
      (Ioo (2 / 3 : ℝ) 4).indicator
        (fun _ => ENNReal.ofReal (brsMainTotalBoundRight p) *
          (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r := by
  set Gp : ENNReal := (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  have hz := brsMainZeroRight_le_indicator hE hp2 hg r
  have hi := brsMainInfRight_le_indicator hE hp2 hg r
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [Set.indicator_of_mem hr]
    rw [Set.indicator_of_mem hr] at hz hi
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    refine le_trans (brsMainTwoRight_le_split hr0) ?_
    refine le_trans (add_le_add hz hi) ?_
    have hCnn : (0 : ℝ) ≤ 3 / 2 * brsMainInfConst p := by
      have := brsMainInfConst_pos hp2
      positivity
    rw [← add_mul, ← ENNReal.ofReal_add
      (le_of_lt (brsMainZeroBoundRight_pos hp2)) hCnn,
      brsMainTotalBoundRight]
  · rw [Set.indicator_of_notMem hr, brsMainTwoRight_eq_zero hE hr]

/-- **BRS Proposition 5.5(i), left endpoint.**  For `p > 2` the operator
`𝔐_p^-` maps `L^p` to `L^q(r dr)` for every `0 < q < ∞`, with a constant
independent of `E`. -/
theorem prop55i_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainTotalBoundLeft p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) :=
  lintegral_radial_indicator_rpow_le hq0 (brsMainTwoLeft_le_indicator hE hp2 hg)

/-- **BRS Proposition 5.5(i), right endpoint.** -/
theorem prop55i_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp2 : 2 < p) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainTotalBoundRight p) * ENNReal.ofReal 14 ^ (1 / q) *
        (∫⁻ s, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) :=
  lintegral_radial_indicator_rpow_le hq0 (brsMainTwoRight_le_indicator hE hp2 hg)


end Prop46
