    {B X T : ENNReal}
    (hT : T ≤ (ENNReal.ofReal E1 * Nloc *
      (ENNReal.ofReal (KC * ((2 : ℝ) ^ (-(a : ℝ))) ^ Sv)) ^ q * B) *
      X ^ (q / p)) :
    T ^ (1 / q) ≤
      (ENNReal.ofReal ((E1 * Cγ * KC ^ q) ^ (1 / q)) * B ^ (1 / q)) *
        ENNReal.ofReal ((2 : ℝ) ^ (((γ - Sv * q) / q) * (a : ℝ))) *
        X ^ (1 / p) := by
  rw [rpow_div_eq_rpow_inv_rpow X hp0] at hT
  have h1 := rpow_inv_of_le_mul_rpow hq0 hT
  refine le_trans h1 ?_
  refine mul_le_mul' ?_ le_rfl
  refine le_trans (endpoint_const_le hq0 hE1 hKC hCγ hN B) (le_of_eq ?_)
  ring

/-! ## The `m`-sum of the endpoint terms

Each term contributes `2^{(4+n)(γ-Sq)/q}`, so the sum over `m` is geometric
with ratio `2^{(γ-Sq)/q}`, convergent exactly when `γ < Sq`. -/

theorem two_rpow_mul_add_four (b : ℝ) (n : ℕ) :
    (2 : ℝ) ^ (b * ((4 + n : ℕ) : ℝ)) =
      (2 : ℝ) ^ (b * 4) * (2 : ℝ) ^ (b * (n : ℝ)) := by
  rw [← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
  congr 1
  push_cast
  ring

/-- **The `m`-sum of the endpoint terms.** -/
theorem tsum_endpoint_m_le {p q : ℝ} (hp0 : 0 < p) (hq0 : 0 < q)
    {E1 KC Cγ γ Sv : ℝ} (hE1 : 0 ≤ E1) (hKC : 0 ≤ KC) (hCγ : 0 ≤ Cγ)
    (hb : (γ - Sv * q) / q < 0) {Nloc : ℕ → ENNReal}
    (hN : ∀ n : ℕ, Nloc n ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {B X : ENNReal} {T : ℕ → ENNReal}
    (hT : ∀ n : ℕ, T n ≤ (ENNReal.ofReal E1 * Nloc n *
      (ENNReal.ofReal (KC * ((2 : ℝ) ^ (-((4 + n : ℕ) : ℝ))) ^ Sv)) ^ q * B) *
      X ^ (q / p)) :
    (∑' n : ℕ, (T n) ^ (1 / q)) ≤
      (ENNReal.ofReal ((E1 * Cγ * KC ^ q) ^ (1 / q)) * B ^ (1 / q) *
          ENNReal.ofReal ((2 : ℝ) ^ (((γ - Sv * q) / q) * 4))) *
        ENNReal.ofReal (1 / (1 - (2 : ℝ) ^ ((γ - Sv * q) / q))) *
        X ^ (1 / p) := by
  set b : ℝ := (γ - Sv * q) / q with hbdef
  refine tsum_m_geometric_le' hb ?_
  intro n
  have h := endpoint_term_le hp0 hq0 hE1 hKC hCγ (hN n) (hT n)
  refine le_trans h (le_of_eq ?_)
  rw [hbdef, two_rpow_mul_add_four ((γ - Sv * q) / q) n,
    ENNReal.ofReal_mul (le_of_lt (Real.rpow_pos_of_pos (by norm_num) _))]
  ring

/-! ## The sup norm of the smoothed truncated kernel

`‖h_k ∗ ψ‖_∞ ≤ ‖ψ‖_∞ ‖h_k‖₁ = 2·2^{-k/2}‖ψ‖_∞`.  With `ψ = υ_j` this is the
`2^{k/2}` bound BRS use for the low-frequency term `𝒜_{k,0}`. -/

theorem integral_brsTruncKernel (k : ℕ) :
    (∫ y : ℝ, brsTruncKernel k y) = 2 * (2 : ℝ) ^ (-(k : ℝ) / 2) := by
  have hint := integrable_brsTruncKernel k
  have hnn : 0 ≤ᵐ[volume] brsTruncKernel k :=
    Filter.Eventually.of_forall (brsTruncKernel_nonneg k)
  rw [integral_eq_lintegral_of_nonneg_ae hnn hint.aestronglyMeasurable]
  have hcong : (∫⁻ y : ℝ, ENNReal.ofReal (brsTruncKernel k y)) =
      ENNReal.ofReal (2 * (2 : ℝ) ^ (-(k : ℝ) / 2)) := lintegral_brsTruncKernel k
  rw [hcong, ENNReal.toReal_ofReal (by positivity)]

/-- **The sup norm of the smoothed truncated kernel.** -/
theorem abs_brsTruncConvReal_le {k : ℕ} {ψ : ℝ → ℝ} {M : ℝ}
    (hψ : Continuous ψ) (hbd : ∀ y : ℝ, |ψ y| ≤ M) (x : ℝ) :
    |brsTruncConvReal k ψ x| ≤ M * (2 * (2 : ℝ) ^ (-(k : ℝ) / 2)) := by
  have hMnn : (0 : ℝ) ≤ M := le_trans (abs_nonneg (ψ 0)) (hbd 0)
  have hKint : Integrable (fun y : ℝ => brsTruncKernel k (x - y)) volume :=
    (integrable_brsTruncKernel k).comp_sub_left x
  have hprod : Integrable (fun y : ℝ => brsTruncKernel k (x - y) * ψ y)
      volume :=
    hKint.mul_bdd hψ.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_eq_abs]
        exact hbd y)
  have hshift : (∫ y : ℝ, brsTruncKernel k (x - y)) =
      ∫ y : ℝ, brsTruncKernel k y :=
    integral_sub_left_eq_self (brsTruncKernel k) volume x
  have hbound : ∀ y : ℝ, ‖brsTruncKernel k (x - y) * ψ y‖ ≤
      brsTruncKernel k (x - y) * M := by
    intro y
    rw [Real.norm_eq_abs, abs_mul,
      abs_of_nonneg (brsTruncKernel_nonneg k (x - y))]
    exact mul_le_mul_of_nonneg_left (hbd y) (brsTruncKernel_nonneg k (x - y))
  have hright : Integrable (fun y : ℝ => brsTruncKernel k (x - y) * M) volume :=
    hKint.mul_const M
  show |∫ y : ℝ, brsTruncKernel k (x - y) * ψ y| ≤ _
  rw [← Real.norm_eq_abs]
  refine le_trans (norm_integral_le_of_norm_le hright
    (Filter.Eventually.of_forall hbound)) (le_of_eq ?_)
  rw [integral_mul_const, hshift, integral_brsTruncKernel]
  ring

/-! ## The low-frequency piece as an average

`|h_k ∗ υ_j ∗ G (x)| ≤ ‖h_k ∗ υ_j‖_∞ ∫_{supp} ‖G(x - y)‖ dy`, with the support
contained in `(-2^{-j}, 2^{-k} + 2^{-j}]` and the sup norm at most
`2^j‖υ‖_∞ · 2·2^{-k/2}`.  This is the form in which the `m = 0` term is
compared with an average of `‖G‖`. -/

theorem norm_integral_truncConvDilate_mul_le {kt j : ℕ} {υ : ℝ → ℝ}
    (hυ : Continuous υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    {Mu : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) {G : ℝ → ℂ} (hG : Continuous G)
    {CG : ℝ} (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    ‖∫ y : ℝ, ((brsTruncConvReal kt (brsDilate υ j) y : ℝ) : ℂ) *
        G (x - y)‖ ≤
      ((2 : ℝ) ^ j * Mu * (2 * (2 : ℝ) ^ (-(kt : ℝ) / 2))) *
        ∫ y in Ioc (-((2 : ℝ) ^ (-(j : ℝ))))
          ((2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ))), ‖G (x - y)‖ := by
  classical
  set δ : ℝ := (2 : ℝ) ^ (-(j : ℝ)) with hδ
  set Sset : Set ℝ := Ioc (-δ) ((2 : ℝ) ^ (-(kt : ℝ)) + δ) with hSset
  set C : ℝ := (2 : ℝ) ^ j * Mu * (2 * (2 : ℝ) ^ (-(kt : ℝ) / 2)) with hC
  have hMunn : (0 : ℝ) ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hCnn : (0 : ℝ) ≤ C := by
    rw [hC]
    positivity
  have hdilcont : Continuous (brsDilate υ j) := continuous_brsDilate hυ j
  have hKbd : ∀ y : ℝ, |brsTruncConvReal kt (brsDilate υ j) y| ≤ C := by
    intro y
    exact abs_brsTruncConvReal_le hdilcont (fun z => abs_brsDilate_le hbd j z) y
  have hKsupp : ∀ y : ℝ, y ∉ Sset →
      brsTruncConvReal kt (brsDilate υ j) y = 0 := by
    intro y hy
    refine brsTruncConvReal_eq_zero (δ := δ) ?_ hy
    intro z hz
    refine brsDilate_eq_zero_of_lt hR j ?_
    rwa [show (1 : ℝ) / 2 ^ j = δ from by
      rw [hδ, rpow_neg_natCast_two j, one_div]]
  -- the pointwise majorant
  have hcontshift : Continuous fun y : ℝ => ‖G (x - y)‖ :=
    (hG.comp (continuous_const.sub continuous_id)).norm
  have hmajint : Integrable
      (fun y : ℝ => C * Sset.indicator (fun y : ℝ => ‖G (x - y)‖) y) volume := by
    refine Integrable.const_mul ?_ C
    refine (IntegrableOn.integrable_indicator ?_ measurableSet_Ioc)
    refine Measure.integrableOn_of_bounded (M := CG) ?_
      hcontshift.aestronglyMeasurable ?_
    · rw [hSset, Real.volume_Ioc]
      exact ENNReal.ofReal_ne_top
    · filter_upwards with y
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      exact hGbd _
  have hbound : ∀ y : ℝ,
      ‖((brsTruncConvReal kt (brsDilate υ j) y : ℝ) : ℂ) * G (x - y)‖ ≤
        C * Sset.indicator (fun y : ℝ => ‖G (x - y)‖) y := by
    intro y
    by_cases hy : y ∈ Sset
    · rw [Set.indicator_of_mem hy, norm_mul, Complex.norm_real,
        Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_right (hKbd y) (norm_nonneg _)
    · rw [Set.indicator_of_notMem hy, hKsupp y hy]
      simp
  refine le_trans (norm_integral_le_of_norm_le hmajint
    (Filter.Eventually.of_forall hbound)) (le_of_eq ?_)
  rw [integral_const_mul, integral_indicator measurableSet_Ioc]

/-! ## The low-frequency piece as an interval average

Undoing the reflection in the variable of integration turns the bound of
`norm_integral_truncConvDilate_mul_le` into an average of `‖G‖` over an
interval to the left of `x`, which is the shape `brsRemainderTwo`
compares with. -/

theorem setIntegral_norm_shift (G : ℝ → ℂ) (x : ℝ) {a b : ℝ} (hab : a ≤ b) :
    (∫ y in Ioc a b, ‖G (x - y)‖) = ∫ s in (x - b)..(x - a), ‖G s‖ := by
  rw [← intervalIntegral.integral_of_le hab]
  exact intervalIntegral.integral_comp_sub_left (fun s => ‖G s‖) x

/-- **The low-frequency piece as an interval average.** -/
theorem norm_integral_truncConvDilate_mul_le_interval {kt j : ℕ} {υ : ℝ → ℝ}
    (hυ : Continuous υ) (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    {Mu : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) {G : ℝ → ℂ} (hG : Continuous G)
    {CG : ℝ} (hGbd : ∀ z : ℝ, ‖G z‖ ≤ CG) (x : ℝ) :
    ‖∫ y : ℝ, ((brsTruncConvReal kt (brsDilate υ j) y : ℝ) : ℂ) *
        G (x - y)‖ ≤
      ((2 : ℝ) ^ j * Mu * (2 * (2 : ℝ) ^ (-(kt : ℝ) / 2))) *
        ∫ s in (x - ((2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ))))..
          (x + (2 : ℝ) ^ (-(j : ℝ))), ‖G s‖ := by
  have hδ : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hkt : (0 : ℝ) < (2 : ℝ) ^ (-(kt : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hab : -((2 : ℝ) ^ (-(j : ℝ))) ≤
      (2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)) := by linarith
  have hshift := setIntegral_norm_shift G x hab
  rw [show x - -((2 : ℝ) ^ (-(j : ℝ))) = x + (2 : ℝ) ^ (-(j : ℝ)) from by
    ring] at hshift
  rw [← hshift]
  exact norm_integral_truncConvDilate_mul_le hυ hR hbd hG hGbd x

/-! ## A widened remainder

The `m = 0` piece of the near part samples the input on an interval slightly
wider than `[t-r, t+r]`.  The layer-cake argument of Proposition 4.3 tolerates
widening the left end by any factor `c < 3/2`: the constraint `t ≥ 3r/2`
gives `t - c r ≥ t(1 - 2c/3)`, which stays bounded away from `0` exactly in
that range. -/

/-- The remainder `R₂` with the left end of the averaging interval widened. -/
def brsRemTwoWide (c : ℝ) (f₀ : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ⨆ t ∈ Icc (1 : ℝ) 2 ∩ Ici (3 * r / 2),
    ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - c * r)..(t + r), f₀ s‖)

/-- **The widened remainder, split by the layer-cake height `lam`.** -/
theorem brsRemTwoWide_le_tail {d : ℕ} {c : ℝ} (hc0 : 0 ≤ c) (hc : c < 3 / 2)
    {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {r lam : ℝ} (hr : 0 < r)
    (hlam : 0 < lam) :
    brsRemTwoWide c (absProfile f₀) r ≤
      ENNReal.ofReal (((1 - 2 * c / 3)⁻¹) ^ (d - 1) * r⁻¹) *
          brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam +
        ENNReal.ofReal ((1 + c) * lam) := by
  set κ : ℝ := 1 - 2 * c / 3 with hκdef
  have hκpos : (0 : ℝ) < κ := by
    rw [hκdef]
    linarith
  have hmeasf : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set T : ENNReal := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  set g : ℝ → ENNReal := fun s =>
    {s : ℝ | lam < ‖f₀ s‖}.indicator (fun s => ENNReal.ofReal ‖f₀ s‖) s with hg
  have hgm : Measurable g := by
    rw [hg]
    exact (hmeasf.ennreal_ofReal).indicator
      (measurableSet_lt measurable_const hmeasf)
  have hTeq : T = ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
    rw [hT, brsTail]
    exact lintegral_brsWeightMeasure hgm
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htIcc, htr⟩ := ht
  have ht1 : (1 : ℝ) ≤ t := htIcc.1
  have htr' : 3 * r / 2 ≤ t := htr
  have hab : t - c * r ≤ t + r := by nlinarith
  have hlow : κ ≤ t - c * r := by
    rw [hκdef]
    nlinarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal (κ⁻¹ ^ (d - 1)) * (ENNReal.ofReal s ^ (d - 1) * g s) +
      ENNReal.ofReal lam with hH
  have hHbound : ∀ s ∈ Icc (t - c * r) (t + r),
      ENNReal.ofReal ‖absProfile f₀ s‖ ≤ H s := by
    intro s hs
    have hsκ : κ ≤ s := le_trans hlow hs.1
    have hsnn : (0 : ℝ) ≤ s := by linarith
    have hnorm : ‖absProfile f₀ s‖ = ‖f₀ s‖ := by
      rw [absProfile]
      simp
    rw [hnorm, hH]
    simp only
    by_cases hz : lam < ‖f₀ s‖
    · have hone : (1 : ENNReal) ≤
          ENNReal.ofReal (κ⁻¹ ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1) := by
        rw [← ENNReal.ofReal_pow hsnn,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ κ⁻¹ ^ (d - 1)),
          ← mul_pow]
        refine ENNReal.one_le_ofReal.mpr ?_
        refine one_le_pow₀ ?_
        rw [inv_mul_eq_div, le_div_iff₀ hκpos, one_mul]
        exact hsκ
      calc ENNReal.ofReal ‖f₀ s‖
          = 1 * ENNReal.ofReal ‖f₀ s‖ := (one_mul _).symm
        _ ≤ (ENNReal.ofReal (κ⁻¹ ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1)) *
              ENNReal.ofReal ‖f₀ s‖ := mul_le_mul' hone le_rfl
        _ = ENNReal.ofReal (κ⁻¹ ^ (d - 1)) *
              (ENNReal.ofReal s ^ (d - 1) * g s) := by
            rw [hg]
            simp only
            rw [Set.indicator_of_mem (show s ∈ {s : ℝ | lam < ‖f₀ s‖} from hz)]
            ring
        _ ≤ _ := le_self_add
    · push Not at hz
      exact le_trans (ENNReal.ofReal_le_ofReal hz) le_add_self
  have hkey := ofReal_norm_intervalIntegral_le_lintegral hab (absProfile f₀) H
    hHbound
  have hHint : (∫⁻ s in Icc (t - c * r) (t + r), H s) ≤
      ENNReal.ofReal (κ⁻¹ ^ (d - 1)) * T +
        ENNReal.ofReal lam * ENNReal.ofReal ((1 + c) * r) := by
    rw [hH]
    simp only
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      Real.volume_Icc, show t + r - (t - c * r) = (1 + c) * r from by ring]
    refine add_le_add ?_ le_rfl
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hTeq]
    exact mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
  have e1 : ENNReal.ofReal r⁻¹ * ENNReal.ofReal (κ⁻¹ ^ (d - 1)) =
      ENNReal.ofReal (κ⁻¹ ^ (d - 1) * r⁻¹) := by
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    ring
  have e2 : ENNReal.ofReal r⁻¹ *
      (ENNReal.ofReal lam * ENNReal.ofReal ((1 + c) * r)) =
      ENNReal.ofReal ((1 + c) * lam) := by
    rw [← ENNReal.ofReal_mul hlam.le,
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ r⁻¹)]
    congr 1
    field_simp
  calc ENNReal.ofReal (r⁻¹ * ‖∫ s in (t - c * r)..(t + r), absProfile f₀ s‖)
      = ENNReal.ofReal r⁻¹ *
          ENNReal.ofReal ‖∫ s in (t - c * r)..(t + r), absProfile f₀ s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal r⁻¹ *
          (ENNReal.ofReal (κ⁻¹ ^ (d - 1)) * T +
            ENNReal.ofReal lam * ENNReal.ofReal ((1 + c) * r)) :=
        mul_le_mul' le_rfl (le_trans hkey hHint)
    _ = ENNReal.ofReal (κ⁻¹ ^ (d - 1) * r⁻¹) * T +
          ENNReal.ofReal ((1 + c) * lam) := by
        rw [mul_add, ← mul_assoc, e1, e2]

/-! ## The level sets of the widened remainder

The same splitting as for `R₂`: at height `u`, taking the layer-cake cut at
`u/(2(1+c))` confines the level set to an interval of length controlled by the
tail. -/

theorem brsRemTwoWide_eq_zero_of_nonpos {c : ℝ} {f₀ : ℝ → ℂ} {r : ℝ}
    (hr : r ≤ 0) : brsRemTwoWide c (absProfile f₀) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  refine le_of_eq (ENNReal.ofReal_eq_zero.mpr ?_)
  exact mul_nonpos_of_nonpos_of_nonneg (inv_nonpos.mpr hr) (norm_nonneg _)

/-- **The level sets of the widened remainder.** -/
theorem measure_brsRemTwoWide_gt_le {d : ℕ} (hd : 2 ≤ d) {c : ℝ} (hc0 : 0 ≤ c)
    (hc : c < 3 / 2) {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) {u : ℝ} (hu : 0 < u) :
    brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemTwoWide c (absProfile f₀) r} ≤
      ENNReal.ofReal ((2 * ((1 - 2 * c / 3)⁻¹) ^ (d - 1) / u) ^ d / (d : ℝ)) *
        brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖)
          (u / (2 * (1 + c))) ^ d := by
  have hκpos : (0 : ℝ) < 1 - 2 * c / 3 := by linarith
  set K : ℝ := ((1 - 2 * c / 3)⁻¹) ^ (d - 1) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  have hcpos : (0 : ℝ) < 1 + c := by linarith
  set lam : ℝ := u / (2 * (1 + c)) with hlamdef
  have hlampos : (0 : ℝ) < lam := by
    rw [hlamdef]
    positivity
  have hlamid : (1 + c) * lam = u / 2 := by
    rw [hlamdef]
    field_simp
  have hdpos : (0 : ℝ) < (d : ℝ) := by
    have : (0 : ℕ) < d := by omega
    exact_mod_cast this
  have hCnonneg : (0 : ℝ) ≤ (2 * K / u) ^ d / (d : ℝ) :=
    div_nonneg (pow_nonneg (by positivity) d) hdpos.le
  set T := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  by_cases hTtop : T = ⊤
  · rw [hTtop, ENNReal.top_pow (by omega : d ≠ 0),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        positivity)]
    exact le_top
  set g : ℝ := T.toReal with hg
  have hgnn : (0 : ℝ) ≤ g := ENNReal.toReal_nonneg
  have hTg : T = ENNReal.ofReal g := (ENNReal.ofReal_toReal hTtop).symm
  set rho : ℝ := 2 * K * g / u with hrho
  have hrhonn : (0 : ℝ) ≤ rho := by
    rw [hrho]
    positivity
  have hsub : {r : ℝ | ENNReal.ofReal u < brsRemTwoWide c (absProfile f₀) r} ⊆
      Ioo 0 rho := by
    intro r hr
    simp only [Set.mem_setOf_eq] at hr
    have hr0 : 0 < r := by
      by_contra hcon
      push Not at hcon
      rw [brsRemTwoWide_eq_zero_of_nonpos hcon] at hr
      simp at hr
    have hsplit := brsRemTwoWide_le_tail (d := d) hc0 hc hf₀ hr0 hlampos
    rw [← hT, hTg] at hsplit
    have hlt : ENNReal.ofReal u <
        ENNReal.ofReal (K * r⁻¹) * ENNReal.ofReal g +
          ENNReal.ofReal ((1 + c) * lam) := lt_of_lt_of_le hr hsplit
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * r⁻¹),
      ← ENNReal.ofReal_add (by positivity) (by positivity)] at hlt
    have hreal : u < K * r⁻¹ * g + (1 + c) * lam :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hu.le).mp hlt
    rw [hlamid] at hreal
    refine ⟨hr0, ?_⟩
    rw [hrho, lt_div_iff₀ hu]
    have h2 : u / 2 < K * r⁻¹ * g := by linarith
    have h3 : r * u / 2 < K * g := by
      calc r * u / 2 = r * (u / 2) := by ring
        _ < r * (K * r⁻¹ * g) := mul_lt_mul_of_pos_left h2 hr0
        _ = K * g := by field_simp
    linarith
  calc brsWeightMeasure d
        {r : ℝ | ENNReal.ofReal u < brsRemTwoWide c (absProfile f₀) r}
      ≤ brsWeightMeasure d (Ioo 0 rho) := measure_mono hsub
    _ = ENNReal.ofReal (rho ^ d / (d : ℝ)) :=
        brsWeightMeasure_Ioo (by omega) hrhonn
    _ = ENNReal.ofReal ((2 * K / u) ^ d / (d : ℝ)) * T ^ d := by
        rw [hTg, ← ENNReal.ofReal_pow hgnn, ← ENNReal.ofReal_mul hCnonneg]
        congr 1
        rw [hrho]
        field_simp
        ring

/-! ## The low-frequency piece, in terms of the input

Undoing the reflection shows the piece of `brsNearFullMax` at `t - r` samples
`g` on `(t - r - 2^{-j}, t - r + 2^{-kt} + 2^{-j}]`: the overhang to the left
of `t - r` is only `2^{-j}`. -/

theorem intervalIntegral_norm_brsRefl (g : ℝ → ℂ) (a b : ℝ) :
    (∫ s in a..b, ‖brsRefl g s‖) = ∫ u in (-b)..(-a), ‖g u‖ := by
  have h : (∫ s in a..b, ‖brsRefl g s‖) = ∫ s in a..b, ‖g (-s)‖ := rfl
  rw [h, intervalIntegral.integral_comp_neg fun u => ‖g u‖]

/-- **The low-frequency piece, as an average of `‖g‖` around `x`.** -/
theorem norm_low_piece_le_interval {kt j : ℕ} {pf : ℝ → ℝ}
    (hpf : Continuous pf) (hR : tsupport pf ⊆ Metric.closedBall 0 1)
    {Mu : ℝ} (hbd : ∀ x : ℝ, |pf x| ≤ Mu) {g : ℝ → ℂ} (hg : Continuous g)
    {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) (x : ℝ) :
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal kt (brsDilate pf j) y : ℝ) : ℂ) *
          brsRefl g (z - y)) x‖ ≤
      ((2 : ℝ) ^ j * Mu * (2 * (2 : ℝ) ^ (-(kt : ℝ) / 2))) *
        ∫ u in (x - (2 : ℝ) ^ (-(j : ℝ)))..
          (x + ((2 : ℝ) ^ (-(kt : ℝ)) + (2 : ℝ) ^ (-(j : ℝ)))), ‖g u‖ := by
  have hmain := norm_integral_truncConvDilate_mul_le_interval (kt := kt) (j := j)
    hpf hR hbd (continuous_brsRefl hg) (fun z => brsRefl_bounded hgbd z) (-x)
  have hrefl : ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal kt (brsDilate pf j) y : ℝ) : ℂ) *
        brsRefl g (z - y)) x‖ =
      ‖∫ y : ℝ, ((brsTruncConvReal kt (brsDilate pf j) y : ℝ) : ℂ) *
        brsRefl g (-x - y)‖ := rfl
  rw [hrefl]
  refine le_trans hmain (le_of_eq ?_)
  congr 1
  rw [intervalIntegral_norm_brsRefl]
  congr 1 <;> ring

/-! ## The `m = 0` piece is dominated by the widened remainder

On `I_k` with `k ≥ 1` the constraint `t ≥ 3r/2` is automatic, and the interval
`[t - r - 2^{-j}, t - r + 2^{-(k+1)} + 2^{-j}]` on which the low-frequency
piece samples `g` sits inside `[t - (9/8) r, t + r]` as soon as `s ≥ 3`. -/

theorem brsNearMax_low_le_brsRemTwoWide {k s : ℕ} (hk : 1 ≤ k) (hs : 3 ≤ s)
    {pf : ℝ → ℝ} (hpf : Continuous pf)
    (hR : tsupport pf ⊆ Metric.closedBall 0 1)
    {Mu : ℝ} (hbd : ∀ x : ℝ, |pf x| ≤ Mu)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (r : ℝ) :
    brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ENNReal.ofReal (Mu * 2 ^ (s + 2)) *
        brsRemTwoWide (9 / 8) (absProfile g) r := by
  have hMu : (0 : ℝ) ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  rw [brsNearMax]
  by_cases hr : r ∈ brsWindowExt k
  swap
  · rw [Set.indicator_of_notMem hr]
    exact zero_le
  rw [Set.indicator_of_mem hr]
  have hr0 : (0 : ℝ) < r := brsWindowExt_pos hr
  set R : ℝ := (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) with hRdef
  set δ : ℝ := (2 : ℝ) ^ (-((k + 1 + s : ℕ) : ℝ)) with hδdef
  have hRpos : (0 : ℝ) < R := Real.rpow_pos_of_pos (by norm_num) _
  have hδpos : (0 : ℝ) < δ := Real.rpow_pos_of_pos (by norm_num) _
  have hRr : R ≤ r := brsCut_le_of_mem_windowExt hr
  -- `δ = R · 2^{-s} ≤ R/8`
  have hδR : δ ≤ R / 8 := by
    have hsplit : δ = R * (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [hδdef, hRdef, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      push_cast
      ring
    have h8 : (2 : ℝ) ^ (-(s : ℝ)) ≤ (2 : ℝ) ^ (-(3 : ℝ)) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      have : (3 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs
      linarith
    have h8' : (2 : ℝ) ^ (-(3 : ℝ)) = 1 / 8 := by
      rw [show (-(3 : ℝ)) = ((-3 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
      norm_num
    have h8'' : (2 : ℝ) ^ (-(s : ℝ)) ≤ 1 / 8 := le_trans h8 (le_of_eq h8')
    rw [hsplit]
    nlinarith [hRpos]
  have hδr : δ ≤ r / 8 := le_trans hδR (by linarith)
  -- on `I_k` with `k ≥ 1` the radius is at most `1/2`
  have hrhalf : r ≤ 1 / 2 := by
    obtain ⟨k, rfl⟩ : ∃ m : ℕ, k = m + 1 := ⟨k - 1, by omega⟩
    have h : r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := hr.2
    have h2 : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (-(1 : ℝ)) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      have : (1 : ℝ) ≤ ((k + 1 : ℕ) : ℝ) := by exact_mod_cast Nat.one_le_iff_ne_zero.mpr (by omega)
      linarith
    have h3 : (2 : ℝ) ^ (-(1 : ℝ)) = 1 / 2 := by
      rw [show (-(1 : ℝ)) = ((-1 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
      norm_num
    linarith [h.trans (h2.trans_eq h3)]
  set F : ℝ := (2 : ℝ) ^ (k + 1 + s) * Mu *
    (2 * (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2)) with hFdef
  have hFnn : (0 : ℝ) ≤ F := by
    rw [hFdef]
    positivity
  set W : ENNReal := brsRemTwoWide (9 / 8) (absProfile g) r with hW
  -- the per-`t` bound
  have hb : ∀ t ∈ E, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
        brsRefl g (z - y)) (t - r)‖ₑ ≤ ENNReal.ofReal (F * r) * W := by
    intro t htE
    have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
    have ht1 : (1 : ℝ) ≤ t := htI.1
    have htr : 3 * r / 2 ≤ t := by linarith
    have hmain := norm_low_piece_le_interval (kt := k + 1) (j := k + 1 + s)
      hpf hR hbd hg hgbd (t - r)
    have hab : t - 9 / 8 * r ≤ t + r := by linarith
    have hmono : (∫ u in (t - r - δ)..(t - r + (R + δ)), ‖g u‖) ≤
        ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ := by
      refine intervalIntegral.integral_mono_interval (by linarith) (by linarith)
        (by linarith) ?_ (hg.norm.intervalIntegrable _ _)
      exact Filter.Eventually.of_forall fun u => norm_nonneg _
    have hInn : (0 : ℝ) ≤ ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ :=
      intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
    have hstep : ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ ≤
        F * ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ := by
      refine le_trans hmain ?_
      refine mul_le_mul_of_nonneg_left ?_ hFnn
      exact le_trans (le_of_eq (by rw [hRdef, hδdef])) hmono
    rw [← ofReal_norm]
    refine le_trans (ENNReal.ofReal_le_ofReal hstep) ?_
    have hfac : F * (∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖) =
        (F * r) * (r⁻¹ * ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖) := by
      field_simp
    rw [hfac, ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    have hRterm : ‖∫ s in (t - 9 / 8 * r)..(t + r), absProfile g s‖ =
        ∫ s in (t - 9 / 8 * r)..(t + r), ‖g s‖ :=
      norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
    rw [hW, brsRemTwoWide]
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hfull : brsNearFullMax (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ENNReal.ofReal (F * r) * W := by
    rw [brsNearFullMax]
    exact iSup₂_le hb
  refine le_trans (mul_le_mul' le_rfl hfull) ?_
  rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr0.le _)]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  -- the constant
  have h2pos : (0 : ℝ) < 2 := by norm_num
  have hcomb : ∀ a b c : ℝ,
      (2 : ℝ) ^ a * ((2 : ℝ) ^ b * (2 : ℝ) ^ c) = (2 : ℝ) ^ (a + b + c) := by
    intro a b c
    rw [← Real.rpow_add h2pos, ← Real.rpow_add h2pos]
    congr 1
    ring
  have hhalf : r ^ (-(1 / 2) : ℝ) * (F * r) = F * r ^ (1 / 2 : ℝ) := by
    have hrr : r ^ (-(1 / 2) : ℝ) * r = r ^ (1 / 2 : ℝ) := by
      nth_rewrite 2 [show r = r ^ (1 : ℝ) from (Real.rpow_one r).symm]
      rw [← Real.rpow_add hr0]
      norm_num
    calc r ^ (-(1 / 2) : ℝ) * (F * r) = F * (r ^ (-(1 / 2) : ℝ) * r) := by ring
      _ = F * r ^ (1 / 2 : ℝ) := by rw [hrr]
  rw [hhalf]
  have hrhalf' : r ^ (1 / 2 : ℝ) ≤
      (2 : ℝ) ^ |(1 / 2 : ℝ)| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 / 2 : ℝ) :=
    rpow_le_of_mem_brsWindowExt hr (1 / 2)
  rw [show |(1 / 2 : ℝ)| = 1 / 2 from by norm_num,
    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)] at hrhalf'
  have halg : ∀ A B C P Q N : ℝ, A * C = B → B * B * P = 1 →
      (P * Q * N * (2 * A)) * (C * B) = N * (2 * Q) := by
    intro A B C P Q N h1 h2
    calc (P * Q * N * (2 * A)) * (C * B)
        = N * 2 * Q * (P * (A * C * B)) := by ring
      _ = N * 2 * Q * (P * (B * B)) := by rw [h1]
      _ = N * 2 * Q * (B * B * P) := by ring
      _ = N * (2 * Q) := by rw [h2]; ring
  have hAC : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2) * (2 : ℝ) ^ (1 / 2 : ℝ) =
      (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) := by
    rw [← Real.rpow_add h2pos]
    congr 1
    push_cast
    ring
  have hBB : (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) *
      (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) * ((2 : ℝ) ^ k) = 1 := by
    rw [← Real.rpow_natCast (2 : ℝ) k, ← Real.rpow_add h2pos,
      ← Real.rpow_add h2pos,
      show -(k : ℝ) * (1 / 2 : ℝ) + -(k : ℝ) * (1 / 2 : ℝ) + (k : ℝ) = 0 from by
        ring,
      Real.rpow_zero]
  have hNsplit : (2 : ℝ) ^ (k + 1 + s) = (2 : ℝ) ^ k * (2 : ℝ) ^ (1 + s) := by
    rw [← pow_add]
    congr 1
    omega
  have hMsplit : Mu * (2 : ℝ) ^ (s + 2) = Mu * (2 * (2 : ℝ) ^ (1 + s)) := by
    rw [show s + 2 = 1 + (1 + s) from by omega, pow_add]
    ring
  calc F * r ^ (1 / 2 : ℝ)
      ≤ F * ((2 : ℝ) ^ (1 / 2 : ℝ) * (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ))) :=
        mul_le_mul_of_nonneg_left hrhalf' hFnn
    _ = Mu * (2 : ℝ) ^ (s + 2) := by
        rw [hFdef, hNsplit, hMsplit]
        exact halg _ _ _ _ _ _ hAC hBB

/-! ## The endpoint estimate for anything dominated by the widened remainder

The layer cake runs on the dominated function itself — which is measurable in
the applications — and only the level sets are compared with those of
`brsRemTwoWide`, for which `measure_mono` suffices. -/

/-- **Proposition 4.3 at the endpoint `q = pd`, for a function dominated by the
widened remainder.** -/
theorem prop43_dominated_endpoint {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 < p)
    {c : ℝ} (hc0 : 0 ≤ c) (hc : c < 3 / 2) {C₀ : ℝ} (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ f₀ : ℝ → ℂ, Continuous f₀ → ∀ M : ℝ → ENNReal,
      Measurable M → (∀ r : ℝ, M r ≠ ⊤) →
      (∀ r : ℝ, M r ≤ ENNReal.ofReal C₀ * brsRemTwoWide c (absProfile f₀) r) →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ (p * (d : ℝ))) ^
          (1 / (p * (d : ℝ))) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
            (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hdnat : 0 < d := by omega
  have hdpos : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hdnat
  have hdone : (1 : ℝ) ≤ (d : ℝ) := by
    have : (1 : ℕ) ≤ d := by omega
    exact_mod_cast this
  have hkpos : (0 : ℝ) < 1 - 2 * c / 3 := by linarith
  set q : ℝ := p * (d : ℝ) with hq
  have hq0 : (0 : ℝ) < q := by rw [hq]; positivity
  set a : ℝ := (d : ℝ) * (p - 1) with ha
  have ha0 : (0 : ℝ) < a := by
    rw [ha]
    have h1 : (0 : ℝ) < p - 1 := by linarith
    positivity
  set Kp : ℝ := ((1 - 2 * c / 3)⁻¹) ^ (d - 1) with hKp
  have hKppos : (0 : ℝ) < Kp := by
    rw [hKp]
    positivity
  set A : ℝ := 2 * Kp * C₀ with hA
  have hApos : (0 : ℝ) < A := by rw [hA]; positivity
  set B : ℝ := 2 * C₀ * (1 + c) with hB
  have hBpos : (0 : ℝ) < B := by
    rw [hB]
    have : (0 : ℝ) < 1 + c := by linarith
    positivity
  set K : ℝ := A ^ d / ((d : ℝ) * B ^ d) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  have hBq : (0 : ℝ) < B ^ q := Real.rpow_pos_of_pos hBpos _
  have hCpos : (0 : ℝ) < (q * K * a⁻¹ * B ^ q) ^ (1 / q) := by
    have : (0 : ℝ) < q * K * a⁻¹ * B ^ q := by positivity
    exact Real.rpow_pos_of_pos this _
  refine ⟨(q * K * a⁻¹ * B ^ q) ^ (1 / q), hCpos, ?_⟩
  intro f₀ hf₀ M hMmeas hMfin hMdom
  have hnormmeas : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set μ : Measure ℝ := brsWeightMeasure d with hmu
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact hCpos)]
    exact le_top
  have hmuX : X = ∫⁻ s, (ENNReal.ofReal ‖f₀ s‖) ^ p ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun s => (ENNReal.ofReal ‖f₀ s‖) ^ p)
      (ENNReal.continuous_rpow_const.measurable.comp hnormmeas.ennreal_ofReal), hX]
  have hLHS : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) =
      ∫⁻ r, M r ^ q ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d) (g := fun r => M r ^ q)
      (ENNReal.continuous_rpow_const.measurable.comp hMmeas)]
  have hlayer := lintegral_ennreal_rpow_eq_meas_lt (μ := μ) hMmeas hMfin hq0
  -- the level sets of `M` sit inside those of the widened remainder
  have hlevel : ∀ u : ℝ, 0 < u → {r : ℝ | ENNReal.ofReal u < M r} ⊆
      {r : ℝ | ENNReal.ofReal (u / C₀) <
        brsRemTwoWide c (absProfile f₀) r} := by
    intro u hu r hr
    simp only [Set.mem_setOf_eq] at hr ⊢
    by_contra hcon
    push Not at hcon
    have h1 : ENNReal.ofReal C₀ * brsRemTwoWide c (absProfile f₀) r ≤
        ENNReal.ofReal C₀ * ENNReal.ofReal (u / C₀) := mul_le_mul' le_rfl hcon
    rw [← ENNReal.ofReal_mul hC₀.le,
      show C₀ * (u / C₀) = u from by field_simp] at h1
    exact absurd (lt_of_lt_of_le hr (le_trans (hMdom r) h1)) (lt_irrefl _)
  -- the pointwise bound on the level integrand
  have hpt : ∀ u ∈ Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < M r} * ENNReal.ofReal (u ^ (q - 1)) ≤
        ENNReal.ofReal K * (ENNReal.ofReal (u ^ (a - 1)) *
          brsTail μ (fun s => B * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ)) := by
    intro u hu0
    have hu : (0 : ℝ) < u := hu0
    have huC : (0 : ℝ) < u / C₀ := by positivity
    have hmeas := le_trans (measure_mono (hlevel u hu))
      (measure_brsRemTwoWide_gt_le (d := d) hd hc0 hc hf₀ huC)
    have hAeq : 2 * ((1 - 2 * c / 3)⁻¹) ^ (d - 1) / (u / C₀) = A / u := by
      rw [hA, hKp]
      field_simp
    have hBeq : u / C₀ / (2 * (1 + c)) = u / B := by
      rw [hB]
      field_simp
    rw [hAeq, hBeq, ← hmu] at hmeas
    refine le_trans (mul_le_mul' hmeas le_rfl) ?_
    refine le_of_eq ?_
    rw [brsTail_smul (fun s => ‖f₀ s‖) hBpos u, ENNReal.rpow_natCast]
    set S : ENNReal := brsTail μ (fun s => ‖f₀ s‖) (u / B) with hS
    have hAnn : (0 : ℝ) ≤ (A / u) ^ d / (d : ℝ) :=
      div_nonneg (pow_nonneg (by positivity) d) hdpos.le
    have hupow : u ^ (q - 1) = u ^ (a - 1) * u ^ d := by
      rw [← Real.rpow_natCast u d, ← Real.rpow_add hu]
      congr 1
      rw [hq, ha]
      ring
    have ereal : (A / u) ^ d / (d : ℝ) * u ^ (q - 1) =
        K * u ^ (a - 1) * B ^ d := by
      rw [hupow, hK, div_pow]
      field_simp
    have hL : ENNReal.ofReal ((A / u) ^ d / (d : ℝ)) * S ^ d *
        ENNReal.ofReal (u ^ (q - 1)) =
        ENNReal.ofReal ((A / u) ^ d / (d : ℝ) * u ^ (q - 1)) * S ^ d := by
      rw [ENNReal.ofReal_mul hAnn]
      ring
    have hR : ENNReal.ofReal K *
        (ENNReal.ofReal (u ^ (a - 1)) * (ENNReal.ofReal B * S) ^ d) =
        ENNReal.ofReal (K * u ^ (a - 1) * B ^ d) * S ^ d := by
      rw [mul_pow, ← ENNReal.ofReal_pow hBpos.le,
        ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * u ^ (a - 1)),
        ENNReal.ofReal_mul hKpos.le]
      ring
    rw [hL, hR, ereal]
  have hstep : (∫⁻ u in Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < M r} * ENNReal.ofReal (u ^ (q - 1))) ≤
      ENNReal.ofReal K * ∫⁻ u in Ioi (0 : ℝ), ENNReal.ofReal (u ^ (a - 1)) *
        brsTail μ (fun s => B * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioi hpt
  have hhmeas : Measurable fun s : ℝ => B * ‖f₀ s‖ :=
    measurable_const.mul hnormmeas
  have hhnn : ∀ s : ℝ, (0 : ℝ) ≤ B * ‖f₀ s‖ := fun s => by positivity
  have hpa : 1 + a / ((d : ℕ) : ℝ) = p := by
    rw [ha]
    field_simp
    ring
  have htail := lintegral_brsTail_rpow_le_total (μ := μ) hhmeas hhnn
    (p := p) (a := a) (m := ((d : ℕ) : ℝ)) hp.le hdone ha0 hpa
  have hXh : (∫⁻ s, ENNReal.ofReal (B * ‖f₀ s‖) ^ p ∂μ) =
      ENNReal.ofReal (B ^ p) * X := by
    rw [hmuX, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun s => ?_
    rw [ENNReal.ofReal_mul hBpos.le, ENNReal.mul_rpow_of_nonneg _ _ hp0.le,
      ENNReal.ofReal_rpow_of_pos hBpos]
  rw [hXh] at htail
  have hpowB : (ENNReal.ofReal (B ^ p) * X) ^ ((d : ℕ) : ℝ) =
      ENNReal.ofReal (B ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ ((d : ℕ) : ℝ)),
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hBpos _),
      ← Real.rpow_mul hBpos.le]
  rw [hpowB] at htail
  have hfinal : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) ≤
      ENNReal.ofReal (q * K * a⁻¹ * B ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [hLHS, hlayer]
    refine le_trans (mul_le_mul' le_rfl (le_trans hstep
      (mul_le_mul' le_rfl htail))) ?_
    refine le_of_eq ?_
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K * a⁻¹),
      ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K),
      ENNReal.ofReal_mul hq0.le]
    ring
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (q * K * a⁻¹ * B ^ q) * X ^ ((d : ℕ) : ℝ)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hfinal (by positivity)
    _ = ENNReal.ofReal ((q * K * a⁻¹ * B ^ q) ^ (1 / q)) * X ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul,
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) <
            q * K * a⁻¹ * B ^ q),
          show ((d : ℕ) : ℝ) * (1 / q) = 1 / p from by rw [hq]; field_simp]

/-! ## The widened remainder is measurable

Exactly as for `brsRemainderTwo`: the supremum over `t` is a countable
supremum, because the window integral is continuous in `t`. -/

/-- Joint continuity of the widened window integral. -/
theorem continuous_wide_window_integral {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (c : ℝ) :
    Continuous (fun z : ℝ × ℝ => ∫ s in (z.2 - c * z.1)..(z.2 + z.1), f₀ s) := by
  have hF := continuous_primitive hf₀
  have heq : (fun z : ℝ × ℝ => ∫ s in (z.2 - c * z.1)..(z.2 + z.1), f₀ s) =
      fun z : ℝ × ℝ => (∫ s in (0 : ℝ)..(z.2 + z.1), f₀ s) -
        ∫ s in (0 : ℝ)..(z.2 - c * z.1), f₀ s := by
    funext z
    exact intervalIntegral_eq_primitive_sub hf₀ _ _
  rw [heq]
  exact (hF.comp (continuous_snd.add continuous_fst)).sub
    (hF.comp (continuous_snd.sub (continuous_const.mul continuous_fst)))

/-- **The widened remainder is a countable supremum.** -/
theorem brsRemTwoWide_eq_rat_iSup {c : ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (r : ℝ) :
    brsRemTwoWide c f₀ r =
      ⨆ b : ℚ, (if ((1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (b : ℝ) then
        ENNReal.ofReal (r⁻¹ *
          ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖) else 0) := by
  refine le_antisymm ?_ ?_
  · rw [brsRemTwoWide]
    refine iSup₂_le fun t ht => ?_
    obtain ⟨⟨ht1, ht2⟩, ht3⟩ := ht
    obtain ⟨b, hb1, hb2, hbtend⟩ := exists_rat_seq_ge ht2
    have hGcont : ContinuousAt
        (fun u : ℝ => r⁻¹ * ‖∫ s in (u - c * r)..(u + r), f₀ s‖) t := by
      have hwin : ContinuousAt
          (fun u : ℝ => ∫ s in (u - c * r)..(u + r), f₀ s) t :=
        ((continuous_wide_window_integral hf₀ c).comp
          ((continuous_const : Continuous fun _ : ℝ => r).prodMk continuous_id)
            ).continuousAt
      exact continuousAt_const.mul hwin.norm
    have hlim : Tendsto (fun n : ℕ => ENNReal.ofReal
        (r⁻¹ * ‖∫ s in (((b n : ℚ) : ℝ) - c * r)..(((b n : ℚ) : ℝ) + r), f₀ s‖))
        atTop (nhds (ENNReal.ofReal
          (r⁻¹ * ‖∫ s in (t - c * r)..(t + r), f₀ s‖))) :=
      (ENNReal.continuous_ofReal.tendsto _).comp (hGcont.tendsto.comp hbtend)
    refine le_of_tendsto hlim (Filter.Eventually.of_forall fun n => ?_)
    refine le_iSup_of_le (b n) ?_
    rw [if_pos ⟨⟨le_trans ht1 (hb2 n), hb1 n⟩, le_trans ht3 (hb2 n)⟩]
  · refine iSup_le fun b => ?_
    by_cases hb : ((1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (b : ℝ)
    · rw [if_pos hb, brsRemTwoWide]
      exact le_iSup₂_of_le (b : ℝ) ⟨⟨hb.1.1, hb.1.2⟩, hb.2⟩ le_rfl
    · rw [if_neg hb]
      simp

/-- **The widened remainder is measurable.** -/
theorem measurable_brsRemTwoWide {c : ℝ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (brsRemTwoWide c f₀) := by
  have heq : brsRemTwoWide c f₀ = fun r : ℝ =>
      ⨆ b : ℚ, (if ((1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (b : ℝ) then
        ENNReal.ofReal (r⁻¹ *
          ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖) else 0) :=
    funext (brsRemTwoWide_eq_rat_iSup hf₀)
  rw [heq]
  refine Measurable.iSup fun b => ?_
  have hfun : Measurable (fun r : ℝ => ENNReal.ofReal (r⁻¹ *
      ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖)) := by
    refine ENNReal.measurable_ofReal.comp ?_
    refine measurable_inv.mul ?_
    exact (((continuous_wide_window_integral hf₀ c).comp
      (continuous_id.prodMk (continuous_const : Continuous fun _ : ℝ =>
        (b : ℝ)))).norm).measurable
  by_cases hb : (1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2
  · have hset : MeasurableSet {r : ℝ | 3 * r / 2 ≤ (b : ℝ)} :=
      measurableSet_le ((measurable_const.mul measurable_id).div_const 2)
        measurable_const
    have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (b : ℝ) then
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖) else 0)) =
        Set.indicator {r : ℝ | 3 * r / 2 ≤ (b : ℝ)}
          (fun r => ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖)) := by
      funext r
      by_cases hr : 3 * r / 2 ≤ (b : ℝ)
      · rw [if_pos ⟨hb, hr⟩,
          Set.indicator_of_mem (show r ∈ {r : ℝ | 3 * r / 2 ≤ (b : ℝ)} from hr)]
      · rw [if_neg (by tauto),
          Set.indicator_of_notMem
            (show r ∉ {r : ℝ | 3 * r / 2 ≤ (b : ℝ)} from hr)]
    rw [hrw]
    exact hfun.indicator hset
  · have hrw : (fun r : ℝ =>
        (if ((1 : ℝ) ≤ (b : ℝ) ∧ (b : ℝ) ≤ 2) ∧ 3 * r / 2 ≤ (b : ℝ) then
          ENNReal.ofReal (r⁻¹ *
            ‖∫ s in ((b : ℝ) - c * r)..((b : ℝ) + r), f₀ s‖) else 0)) =
        fun _ : ℝ => (0 : ENNReal) := by
      funext r
      rw [if_neg (by tauto)]
    rw [hrw]
    exact measurable_const

/-! ## The widened remainder is finite

The averaging interval stays inside a fixed compact set, on which a continuous
`f₀` is bounded. -/

theorem brsRemTwoWide_ne_top {c : ℝ} (hc0 : 0 ≤ c) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) {r : ℝ} (hr : 0 < r) :
    brsRemTwoWide c (absProfile f₀) r ≠ ⊤ := by
  obtain ⟨M, hM⟩ := (isCompact_Icc (a := 1 - c * r) (b := 2 + r)).exists_bound_of_continuousOn
    (hf₀.norm.continuousOn)
  refine ne_top_of_le_ne_top
    (b := ENNReal.ofReal (r⁻¹ * (M * |(1 + c) * r|))) ENNReal.ofReal_ne_top ?_
  refine iSup₂_le fun t ht => ?_
  obtain ⟨⟨ht1, ht2⟩, ht3⟩ := ht
  refine ENNReal.ofReal_le_ofReal ?_
  refine mul_le_mul_of_nonneg_left ?_ (by positivity)
  have hsub : uIoc (t - c * r) (t + r) ⊆ Icc (1 - c * r) (2 + r) := by
    have hab : t - c * r ≤ t + r := by nlinarith
    rw [uIoc_of_le hab]
    refine Ioc_subset_Icc_self.trans (Icc_subset_Icc (by nlinarith) (by linarith))
  have hbd : ∀ x ∈ uIoc (t - c * r) (t + r), ‖absProfile f₀ x‖ ≤ M := by
    intro x hx
    rw [norm_absProfile]
    have hx' := hM x (hsub hx)
    rwa [Real.norm_of_nonneg (norm_nonneg _)] at hx'
  have h := intervalIntegral.norm_integral_le_of_norm_le_const hbd
  refine le_trans h (le_of_eq ?_)
  congr 1
  congr 1
  ring

/-! ## The endpoint bound for anything dominated by the widened remainder

Since `brsRemTwoWide` is itself measurable and finite, the domination may be
used first, and no regularity at all is needed of the dominated object. -/

/-- **The `L^p → L^{2p}` endpoint bound for anything dominated by the widened
remainder.** -/
theorem endpoint_of_le_brsRemTwoWide {p : ℝ} (hp : 1 < p) {c : ℝ}
    (hc0 : 0 ≤ c) (hc : c < 3 / 2) {C₀ : ℝ} (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g → ∀ M : ℝ → ENNReal,
      (∀ r : ℝ, M r ≤ ENNReal.ofReal C₀ * brsRemTwoWide c (absProfile g) r) →
      (∫⁻ r, ENNReal.ofReal r * M r ^ (2 * p)) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  obtain ⟨C, hCpos, hbound⟩ :=
    prop43_dominated_endpoint (d := 2) (by norm_num) hp hc0 hc hC₀
  refine ⟨C, hCpos, ?_⟩
  intro g hg M hMdom
  have hq0 : (0 : ℝ) < 2 * p := by linarith [lt_trans zero_lt_one hp]
  set W : ℝ → ENNReal := fun r => ENNReal.ofReal C₀ *
    brsRemTwoWide c (absProfile g) r with hW
  have hWmeas : Measurable W := by
    rw [hW]
    exact measurable_const.mul (measurable_brsRemTwoWide (continuous_absProfile hg))
  have hWfin : ∀ r : ℝ, W r ≠ ⊤ := by
    intro r
    rw [hW]
    refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
    rcases le_or_gt r 0 with hr | hr
    · rw [brsRemTwoWide_eq_zero_of_nonpos hr]
      exact ENNReal.zero_ne_top
    · exact brsRemTwoWide_ne_top hc0 hg hr
  have hb := hbound g hg W hWmeas hWfin (fun r => le_rfl)
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hb
  have hmono : (∫⁻ r, ENNReal.ofReal r * M r ^ (2 * p)) ≤
      ∫⁻ r, ENNReal.ofReal r * W r ^ (2 * p) :=
    lintegral_mono fun r =>
      mul_le_mul' le_rfl (ENNReal.rpow_le_rpow (hMdom r) hq0.le)
  exact le_trans (ENNReal.rpow_le_rpow hmono (by positivity)) hb

/-! ## One piece of the resolution, keeping the constraint `t ≥ 3r/2`

`brsNearMax` drops the constraint `t ≥ 3r/2` that the near part carries, which
is harmless for the covering-number estimates but not for the `m = 0` term: the
constraint is what keeps the averaging interval away from the origin.  The
variant that keeps it is compared with `brsRemTwoWide` at every scale. -/

/-- One piece of the resolution, with the window, the radial weight, and the
constraint `t ≥ 3r/2`. -/
def brsNearMaxP (kw kt : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ) (E : Set ℝ) (r : ℝ) :
    ENNReal :=
  (brsWindowExt kw).indicator
    (fun r => ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      brsNearPieceMax kt Ψ g E r) r

theorem brsNearMaxP_le_brsNearMax (kw kt : ℕ) (Ψ : ℝ → ℝ) (g : ℝ → ℂ)
    (E : Set ℝ) (r : ℝ) :
    brsNearMaxP kw kt Ψ g E r ≤ brsNearMax kw kt Ψ g E r := by
  rw [brsNearMaxP, brsNearMax]
  exact Set.indicator_le_indicator
    (mul_le_mul' le_rfl (brsNearPieceMax_le_full _ _ _ _ _))

theorem brsNearMaxP_eq_zero_of_notMem {kw kt : ℕ} {Ψ : ℝ → ℝ} {g : ℝ → ℂ}
    {E : Set ℝ} {r : ℝ} (hr : r ∉ brsWindowExt kw) :
    brsNearMaxP kw kt Ψ g E r = 0 := Set.indicator_of_notMem hr _

/-- **The `m = 0` piece is dominated by the widened remainder.**  The interval
`[t - r - 2^{-j}, t - r + 2^{-(k+1)} + 2^{-j}]` on which the low-frequency piece
samples `g` sits inside `[t - (9/8) r, t + r]` as soon as `s ≥ 3`. -/
theorem brsNearMaxP_low_le_brsRemTwoWide {k s : ℕ} (hs : 3 ≤ s)
    {pf : ℝ → ℝ} (hpf : Continuous pf)
    (hR : tsupport pf ⊆ Metric.closedBall 0 1)
    {Mu : ℝ} (hbd : ∀ x : ℝ, |pf x| ≤ Mu)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (r : ℝ) :
    brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ENNReal.ofReal (Mu * 2 ^ (s + 2)) *
        brsRemTwoWide (9 / 8) (absProfile g) r := by
  have hMu : (0 : ℝ) ≤ Mu := le_trans (abs_nonneg _) (hbd 0)
  rw [brsNearMaxP]
  by_cases hr : r ∈ brsWindowExt k
  swap
  · rw [Set.indicator_of_notMem hr]
    exact zero_le
  rw [Set.indicator_of_mem hr]
  have hr0 : (0 : ℝ) < r := brsWindowExt_pos hr
  set R : ℝ := (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) with hRdef
  set δ : ℝ := (2 : ℝ) ^ (-((k + 1 + s : ℕ) : ℝ)) with hδdef
  have hRpos : (0 : ℝ) < R := Real.rpow_pos_of_pos (by norm_num) _
  have hδpos : (0 : ℝ) < δ := Real.rpow_pos_of_pos (by norm_num) _
  have hRr : R ≤ r := brsCut_le_of_mem_windowExt hr
  -- `δ = R · 2^{-s} ≤ R/8`
  have hδR : δ ≤ R / 8 := by
    have hsplit : δ = R * (2 : ℝ) ^ (-(s : ℝ)) := by
      rw [hδdef, hRdef, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
      congr 1
      push_cast
      ring
    have h8 : (2 : ℝ) ^ (-(s : ℝ)) ≤ (2 : ℝ) ^ (-(3 : ℝ)) := by
      refine Real.rpow_le_rpow_of_exponent_le (by norm_num) ?_
      have : (3 : ℝ) ≤ (s : ℝ) := by exact_mod_cast hs
      linarith
    have h8' : (2 : ℝ) ^ (-(3 : ℝ)) = 1 / 8 := by
      rw [show (-(3 : ℝ)) = ((-3 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
      norm_num
    have h8'' : (2 : ℝ) ^ (-(s : ℝ)) ≤ 1 / 8 := le_trans h8 (le_of_eq h8')
    rw [hsplit]
    nlinarith [hRpos]
  have hδr : δ ≤ r / 8 := le_trans hδR (by linarith)
  set F : ℝ := (2 : ℝ) ^ (k + 1 + s) * Mu *
    (2 * (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2)) with hFdef
  have hFnn : (0 : ℝ) ≤ F := by
    rw [hFdef]
    positivity
  set W : ENNReal := brsRemTwoWide (9 / 8) (absProfile g) r with hW
  -- the per-`t` bound
  have hb : ∀ t ∈ E ∩ Ici (3 * r / 2), ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
      ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
        brsRefl g (z - y)) (t - r)‖ₑ ≤ ENNReal.ofReal (F * r) * W := by
    intro t ht
    have htI : t ∈ Icc (1 : ℝ) 2 := hE ht.1
    have ht1 : (1 : ℝ) ≤ t := htI.1
    have htr : 3 * r / 2 ≤ t := ht.2
    have hmain := norm_low_piece_le_interval (kt := k + 1) (j := k + 1 + s)
      hpf hR hbd hg hgbd (t - r)
    have hab : t - 9 / 8 * r ≤ t + r := by linarith
    have hmono : (∫ u in (t - r - δ)..(t - r + (R + δ)), ‖g u‖) ≤
        ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ := by
      refine intervalIntegral.integral_mono_interval (by linarith) (by linarith)
        (by linarith) ?_ (hg.norm.intervalIntegrable _ _)
      exact Filter.Eventually.of_forall fun u => norm_nonneg _
    have hInn : (0 : ℝ) ≤ ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ :=
      intervalIntegral.integral_nonneg hab fun s _ => norm_nonneg _
    have hstep : ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ ≤
        F * ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖ := by
      refine le_trans hmain ?_
      refine mul_le_mul_of_nonneg_left ?_ hFnn
      exact le_trans (le_of_eq (by rw [hRdef, hδdef])) hmono
    rw [← ofReal_norm]
    refine le_trans (ENNReal.ofReal_le_ofReal hstep) ?_
    have hfac : F * (∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖) =
        (F * r) * (r⁻¹ * ∫ u in (t - 9 / 8 * r)..(t + r), ‖g u‖) := by
      field_simp
    rw [hfac, ENNReal.ofReal_mul (by positivity)]
    refine mul_le_mul' le_rfl ?_
    have hRterm : ‖∫ s in (t - 9 / 8 * r)..(t + r), absProfile g s‖ =
        ∫ s in (t - 9 / 8 * r)..(t + r), ‖g s‖ :=
      norm_intervalIntegral_ofReal_nonneg hab _ fun s _ => norm_nonneg _
    rw [hW, brsRemTwoWide]
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hfull : brsNearPieceMax (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ENNReal.ofReal (F * r) * W := by
    rw [brsNearPieceMax]
    exact iSup₂_le hb
  refine le_trans (mul_le_mul' le_rfl hfull) ?_
  rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr0.le _)]
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
  -- the constant
  have h2pos : (0 : ℝ) < 2 := by norm_num
  have hcomb : ∀ a b c : ℝ,
      (2 : ℝ) ^ a * ((2 : ℝ) ^ b * (2 : ℝ) ^ c) = (2 : ℝ) ^ (a + b + c) := by
    intro a b c
    rw [← Real.rpow_add h2pos, ← Real.rpow_add h2pos]
    congr 1
    ring
  have hhalf : r ^ (-(1 / 2) : ℝ) * (F * r) = F * r ^ (1 / 2 : ℝ) := by
    have hrr : r ^ (-(1 / 2) : ℝ) * r = r ^ (1 / 2 : ℝ) := by
      nth_rewrite 2 [show r = r ^ (1 : ℝ) from (Real.rpow_one r).symm]
      rw [← Real.rpow_add hr0]
      norm_num
    calc r ^ (-(1 / 2) : ℝ) * (F * r) = F * (r ^ (-(1 / 2) : ℝ) * r) := by ring
      _ = F * r ^ (1 / 2 : ℝ) := by rw [hrr]
  rw [hhalf]
  have hrhalf' : r ^ (1 / 2 : ℝ) ≤
      (2 : ℝ) ^ |(1 / 2 : ℝ)| * ((2 : ℝ) ^ (-(k : ℝ))) ^ (1 / 2 : ℝ) :=
    rpow_le_of_mem_brsWindowExt hr (1 / 2)
  rw [show |(1 / 2 : ℝ)| = 1 / 2 from by norm_num,
    ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 2)] at hrhalf'
  have halg : ∀ A B C P Q N : ℝ, A * C = B → B * B * P = 1 →
      (P * Q * N * (2 * A)) * (C * B) = N * (2 * Q) := by
    intro A B C P Q N h1 h2
    calc (P * Q * N * (2 * A)) * (C * B)
        = N * 2 * Q * (P * (A * C * B)) := by ring
      _ = N * 2 * Q * (P * (B * B)) := by rw [h1]
      _ = N * 2 * Q * (B * B * P) := by ring
      _ = N * (2 * Q) := by rw [h2]; ring
  have hAC : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2) * (2 : ℝ) ^ (1 / 2 : ℝ) =
      (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) := by
    rw [← Real.rpow_add h2pos]
    congr 1
    push_cast
    ring
  have hBB : (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) *
      (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ)) * ((2 : ℝ) ^ k) = 1 := by
    rw [← Real.rpow_natCast (2 : ℝ) k, ← Real.rpow_add h2pos,
      ← Real.rpow_add h2pos,
      show -(k : ℝ) * (1 / 2 : ℝ) + -(k : ℝ) * (1 / 2 : ℝ) + (k : ℝ) = 0 from by
        ring,
      Real.rpow_zero]
  have hNsplit : (2 : ℝ) ^ (k + 1 + s) = (2 : ℝ) ^ k * (2 : ℝ) ^ (1 + s) := by
    rw [← pow_add]
    congr 1
    omega
  have hMsplit : Mu * (2 : ℝ) ^ (s + 2) = Mu * (2 * (2 : ℝ) ^ (1 + s)) := by
    rw [show s + 2 = 1 + (1 + s) from by omega, pow_add]
    ring
  calc F * r ^ (1 / 2 : ℝ)
      ≤ F * ((2 : ℝ) ^ (1 / 2 : ℝ) * (2 : ℝ) ^ (-(k : ℝ) * (1 / 2 : ℝ))) :=
        mul_le_mul_of_nonneg_left hrhalf' hFnn
    _ = Mu * (2 : ℝ) ^ (s + 2) := by
        rw [hFdef, hNsplit, hMsplit]
        exact halg _ _ _ _ _ _ hAC hBB

/-! ## A family supported on the windows is dominated termwise

Because the windows are disjoint, at each radius at most one member of a
window-supported family is nonzero, so a termwise bound is a bound for the
sum. -/

theorem tsum_window_le {A : ℕ → ℝ → ENNReal}
    (hA : ∀ k : ℕ, ∀ r : ℝ, r ∉ brsWindowExt k → A k r = 0)
    {V : ℝ → ENNReal} (hle : ∀ k : ℕ, ∀ r : ℝ, A k r ≤ V r) (r : ℝ) :
    (∑' k : ℕ, A k r) ≤ V r := by
  by_cases h : ∃ k : ℕ, r ∈ brsWindowExt k
  · obtain ⟨k₀, hk₀⟩ := h
    have hzero : ∀ k : ℕ, k ≠ k₀ → A k r = 0 := by
      intro k hk
      refine hA k r fun hr => ?_
      exact Set.disjoint_left.mp (brsWindowExt_disjoint hk) hr hk₀
    rw [tsum_eq_single k₀ hzero]
    exact hle k₀ r
  · simp only [not_exists] at h
    have hall : ∀ k : ℕ, A k r = 0 := fun k => hA k r (h k)
    simp only [hall, tsum_zero]
    exact zero_le

/-! ## The near part on `I_k`, keeping the constraint at `m = 0`

`brsANearWindow_le_tsum_lp` with the low-frequency term left as a
`brsNearMaxP`, so that the constraint `t ≥ 3r/2` survives into the `m = 0`
estimate. -/

/-- **The near part on `I_k`, with the constraint kept at `m = 0`.** -/
theorem brsANearWindow_le_tsum_lp_piece (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + s)) g E r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
          (brsLPInput S (k + 1 + s + m) g) E r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_window hr
    have hmain := brsANearLeftAt_le_pieces_lp (k + 1) s (E := E) hg hgbd hpf
      hpfint hpfbd hpfnorm hfac hυcont hυint hυbd hcr
    refine le_trans hmain ?_
    have hpieces : brsNearPieceMax (k + 1) (brsDilate pf (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearPieceMax (k + 1) (brsDilate υ (k + 1 + s + m))
            (brsLPInput S (k + 1 + s + m) g) E r ≤
        brsNearPieceMax (k + 1) (brsDilate pf (k + 1 + s)) g E r +
          ∑' m : ℕ, brsNearFullMax (k + 1) (brsDilate υ (k + 1 + s + m))
            (brsLPInput S (k + 1 + s + m) g) E r :=
      add_le_add le_rfl
        (ENNReal.tsum_le_tsum fun m => brsNearPieceMax_le_full _ _ _ _ _)
    refine le_trans (mul_le_mul' le_rfl hpieces) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMaxP, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-! ## The near part at the endpoint, aggregated

The `m = 0` term is pulled out and replaced by the widened remainder — its
`k`-sum collapses because the windows are disjoint — and the `m ≥ 1` terms are
left in the form the Littlewood--Paley `k`-sum consumes. -/

/-- **The near part of `R₂^-` at the endpoint, aggregated over the
windows.** -/
theorem brsNear_aggregate_lp_endpoint {s : ℕ} (hs : 3 ≤ s) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf)
    (hpfR : tsupport pf ⊆ Metric.closedBall 0 1)
    (hpfint : Integrable pf volume) {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ)
    (hυint : Integrable υ volume) {Mυ : ℝ} (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ^ q *
        ENNReal.ofReal r) ^ (1 / q) ≤
      (∫⁻ r : ℝ, (ENNReal.ofReal (Mpf * 2 ^ (s + 2)) *
            brsRemTwoWide (9 / 8) (absProfile g) r) ^ q *
          ENNReal.ofReal r) ^ (1 / q) +
        ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
          brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
            (brsLPInput S (k + 1 + s + m) g) E r ^ q *
              ENNReal.ofReal r) ^ (1 / q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set B : ℕ → ℕ → ℝ → ENNReal := fun m k r =>
    brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
      (brsLPInput S (k + 1 + s + m) g) E r with hB
  set G : ℕ → ℝ → ENNReal := fun m =>
    match m with
    | 0 => fun r => ENNReal.ofReal (Mpf * 2 ^ (s + 2)) *
        brsRemTwoWide (9 / 8) (absProfile g) r
    | (m + 1) => fun r => ∑' k : ℕ, B m k r with hG
  have hBmeas : ∀ m k : ℕ, Measurable (B m k) := by
    intro m k
    exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hυ _)
      (hasCompactSupport_brsDilate hυcs _)
      (continuous_brsLPInput S (k + 1 + s + m) hg hgbd) E
  have hGmeas : ∀ m : ℕ, Measurable (G m) := by
    intro m
    cases m with
    | zero =>
        exact measurable_const.mul
          (measurable_brsRemTwoWide (continuous_absProfile hg))
    | succ m => exact Measurable.ennreal_tsum fun k => hBmeas m k
  -- the pointwise bound
  have hpt : ∀ r : ℝ, (∑' k : ℕ, (brsWindowExt k).indicator
      (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
      ∑' m : ℕ, G m r := by
    intro r
    have hstep : ∀ k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
        brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + s)) g E r +
          ∑' m : ℕ, B m k r := fun k =>
      brsANearWindow_le_tsum_lp_piece k s hg hgbd hpf hpfint hpfbd hpfnorm
        hfac hυ.continuous hυint hυbd r
    refine le_trans (ENNReal.tsum_le_tsum hstep) ?_
    rw [ENNReal.tsum_add]
    have hlow : (∑' k : ℕ,
        brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + s)) g E r) ≤ G 0 r := by
      refine tsum_window_le (fun k r hr => brsNearMaxP_eq_zero_of_notMem hr)
        (fun k r => ?_) r
      exact brsNearMaxP_low_le_brsRemTwoWide hs hpf hpfR hpfbd hg hgbd hE r
    have hhigh : (∑' k : ℕ, ∑' m : ℕ, B m k r) = ∑' m : ℕ, G (m + 1) r := by
      rw [ENNReal.tsum_comm]
    rw [hhigh, ennreal_tsum_eq_zero_add (fun m : ℕ => G m r)]
    exact add_le_add hlow le_rfl
  -- take the radial `L^q` norm
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono fun r =>
    mul_le_mul' (ENNReal.rpow_le_rpow (hpt r) hq0.le) le_rfl)
    (by positivity)) ?_
  refine le_trans (lintegral_radial_Lp_tsum_le hq hGmeas) (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add
    (fun m : ℕ => (∫⁻ r : ℝ, G m r ^ q * ENNReal.ofReal r) ^ (1 / q))]
  congr 1
  refine tsum_congr fun m => ?_
  congr 1
  exact lintegral_tsum_window_rpow (fun k r hr => brsNearMax_eq_zero_of_notMem hr)
    (fun k => hBmeas m k) hq0

/-! ## The far part at an arbitrary cutoff, against the remainder

`brsBFarLeft_le_brsRemainderTwo` only uses that the cutoff is at least
`brsCutScale r`; a coarser cutoff makes the kernel bound better. -/

theorem cutScale_rpow_mul_le {r c : ℝ} (hr : 0 < r) (hc : brsCutScale r ≤ c) :
    r ^ (-(1 / 2) : ℝ) * c ^ (-(1 / 2) : ℝ) ≤ (2048 : ℝ) ^ (1 / 2 : ℝ) * r⁻¹ := by
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  have h1 : c ^ (-(1 / 2) : ℝ) ≤ brsCutScale r ^ (-(1 / 2) : ℝ) :=
    Real.rpow_le_rpow_of_nonpos hcut hc (by norm_num)
  have h2 : r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) =
      (2048 : ℝ) ^ (1 / 2 : ℝ) * r⁻¹ := cutScale_rpow_mul hr
  calc r ^ (-(1 / 2) : ℝ) * c ^ (-(1 / 2) : ℝ)
      ≤ r ^ (-(1 / 2) : ℝ) * brsCutScale r ^ (-(1 / 2) : ℝ) :=
        mul_le_mul_of_nonneg_left h1 (Real.rpow_nonneg hr.le _)
    _ = (2048 : ℝ) ^ (1 / 2 : ℝ) * r⁻¹ := h2

/-- **The far part at an arbitrary cutoff is dominated by `R₂`.** -/
theorem brsBFarLeftAt_le_brsRemainderTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarLeftAt c E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  rw [brsBFarLeftAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have hab : t - r ≤ t := by linarith
  have hab2 : t - r ≤ t + r := by linarith
  have hInn : (0 : ℝ) ≤ ∫ s in (t - r)..(t + r), ‖g s‖ :=
    intervalIntegral.integral_nonneg hab2 fun s _ => norm_nonneg _
  have hRterm : ‖∫ s in (t - r)..(t + r), absProfile g s‖ =
      ∫ s in (t - r)..(t + r), ‖g s‖ :=
    norm_intervalIntegral_ofReal_nonneg hab2 _ fun s _ => norm_nonneg _
  have hlow : ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) ≤
      brsRemainderTwo (absProfile g) r := by
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hHle : ∀ s ∈ Icc (t - r) t,
      ENNReal.ofReal ‖(Ici (t - r + c)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
        ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s hs
    by_cases hmem : t - r + c ≤ s
    · rw [Set.indicator_of_mem (show s ∈ Ici (t - r + c) from hmem),
        norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
        ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [abs_of_nonneg (by linarith [hs.1] : (0 : ℝ) ≤ s - (t - r))]
      exact Real.rpow_le_rpow_of_nonpos hcpos (by linarith) (by norm_num)
    · rw [Set.indicator_of_notMem (show s ∉ Ici (t - r + c) from hmem)]
      simp
  have hupper := ofReal_norm_intervalIntegral_le_lintegral hab
    ((Ici (t - r + c)).indicator
      (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s))
    (fun s => ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) hHle
  have hint : IntegrableOn (fun s => ‖g s‖) (Icc (t - r) (t + r)) volume :=
    hg.norm.integrableOn_Icc
  have heq : (∫⁻ s in Icc (t - r) (t + r), ‖g s‖ₑ) =
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [intervalIntegral.integral_of_le hab2, ← integral_Icc_eq_integral_Ioc,
      ofReal_integral_eq_lintegral_ofReal hint
        (Filter.Eventually.of_forall fun s => norm_nonneg _)]
    exact lintegral_congr fun s => (ofReal_norm (g s)).symm
  have hmass : (∫⁻ s in Icc (t - r) t, ‖g s‖ₑ) ≤
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← heq]
    exact lintegral_mono_set (Icc_subset_Icc le_rfl (by linarith))
  have hprod : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hcpos.le _),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (2048 : ℝ) ^ (1 / 2 : ℝ))]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [← mul_assoc, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (cutScale_rpow_mul_le hr hc) hInn
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in (t - r)..t, (Ici (t - r + c)).indicator
          (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in (t - r)..t,
            (Ici (t - r + c)).indicator
              (fun s => ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) := by
        refine mul_le_mul' le_rfl (le_trans hupper ?_)
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        exact mul_le_mul' le_rfl hmass
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := hprod
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          brsRemainderTwo (absProfile g) r := mul_le_mul' le_rfl hlow

/-! ## The far part, summed over the windows, at the endpoint

The dyadic cutoff `2^{-(k+1)}` is coarser than `brsCutScale r` on `I_k`, so the
domination by `R₂` applies at every window, and the windows are disjoint. -/

theorem brsCutScale_le_window_cut {k : ℕ} {r : ℝ} (hr : r ∈ brsWindowExt k) :
    brsCutScale r ≤ (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
  have hr0 : 0 < r := brsWindowExt_pos hr
  have hup : r ≤ 2 * (2 : ℝ) ^ (-(k : ℝ)) := brsWindowExt_le_two_mul k hr
  have hpos : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hcast : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) = (2 : ℝ) ^ (-(k : ℝ)) / 2 := by
    rw [show (-((k + 1 : ℕ) : ℝ)) = -(k : ℝ) + -1 from by push_cast; ring,
      Real.rpow_add (by norm_num : (0 : ℝ) < 2),
      show (-1 : ℝ) = ((-1 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
    norm_num
    ring
  rw [brsCutScale, hcast]
  linarith

/-- **The far window sum is dominated by `R₂`.** -/
theorem brsFarWindowSum_le_brsRemainderTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) (r : ℝ) :
    brsFarWindowSum E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  rw [brsFarWindowSum]
  refine tsum_window_le
    (A := fun k r => (brsWindowExt k).indicator
      (brsBFarLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r)
    (V := fun r => ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
      brsRemainderTwo (absProfile g) r)
    (fun k r hr => Set.indicator_of_notMem hr _) (fun k r => ?_) r
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    exact brsBFarLeftAt_le_brsRemainderTwo hE hg (brsWindowExt_pos hr)
      (brsCutScale_le_window_cut hr)
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **(5.6) at the endpoint `q = 2p`, for the far window sum.** -/
theorem prop56_brsFarWindowSum_endpoint {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ (2 * p)) ^
          (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨C, hCpos, hbound⟩ :=
    prop43_brsRemainderTwo_endpoint (d := 2) (by norm_num) hp
  have hKpos : (0 : ℝ) < (2048 : ℝ) ^ (1 / 2 : ℝ) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine ⟨(2048 : ℝ) ^ (1 / 2 : ℝ) * C, by positivity, ?_⟩
  intro g hg
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set K : ℝ := (2048 : ℝ) ^ (1 / 2 : ℝ) with hK
  have hb := hbound g hg
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hb
  have hdom : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSum E g r ^ (2 * p) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        (ENNReal.ofReal r * brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
    intro r
    have h := brsFarWindowSum_le_brsRemainderTwo hE hg r
    calc ENNReal.ofReal r * brsFarWindowSum E g r ^ (2 * p)
        ≤ ENNReal.ofReal r *
            (ENNReal.ofReal K * brsRemainderTwo (absProfile g) r) ^ (2 * p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
      _ = ENNReal.ofReal (K ^ (2 * p)) *
            (ENNReal.ofReal r *
              brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
            ENNReal.ofReal_rpow_of_pos hKpos]
          ring
  have hint : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ (2 * p)) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        ∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hdom
  calc (∫⁻ r, ENNReal.ofReal r * brsFarWindowSum E g r ^ (2 * p)) ^
        (1 / (2 * p))
      ≤ (ENNReal.ofReal (K ^ (2 * p)) *
          ∫⁻ r, ENNReal.ofReal r *
            brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal K * (∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0 : ℝ) ≤ 1 / (2 * p)),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < K ^ (2 * p)),
          ← Real.rpow_mul hKpos.le,
          show 2 * p * (1 / (2 * p)) = 1 from by field_simp, Real.rpow_one]
    _ ≤ ENNReal.ofReal K *
          (ENNReal.ofReal C *
            (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl hb
    _ = ENNReal.ofReal (K * C) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
        rw [ENNReal.ofReal_mul hKpos.le, mul_assoc]

/-! ## The high-frequency terms of the near part, summed

`tsum_brsNearMax_lp_le` closes the `k`-sum at offset `a = 4 + m` by
Littlewood--Paley; `tsum_endpoint_m_le` sums the resulting geometric series in
`m`, which converges exactly when the localized covering exponent `γ` is
smaller than `(1/r - 1/2) q`. -/

/-- **The `m ≥ 1` terms of the near part at the endpoint.** -/
theorem tsum_near_high_endpoint {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {υ : ℝ → ℝ} (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hAι : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {S : SchwartzMap ℝ ℂ} {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ}
    (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p q r : ℝ} (hp : 1 < p) (hr : 1 < r) (hrq : r < q) (hpq : p < q)
    (hrel : 1 / p + 1 / r = 1 + 1 / q) (hq2p : q ≤ 2 * p)
    {A₀ : ENNReal} (hA₀top : A₀ ≠ ⊤)
    (hA₀ : ∀ offset : ℕ, (∑' k : ℕ, (∫⁻ x : ℝ, ‖∫ y : ℝ,
        (brsSchwartzDilate S (k + offset) : ℝ → ℂ) y *
          brsRefl g (x - y)‖ₑ ^ p) ^ (q / p)) ≤
      A₀ * (∫⁻ x : ℝ, ‖brsRefl g x‖ₑ ^ p) ^ (q / p))
    (hgeom : (γ - (1 / r - 1 / 2) * q) / q < 0) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∑' m : ℕ, (∑' k : ℕ, ∫⁻ x : ℝ,
        brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
          (brsLPInput S (k + (4 + m)) g) E x ^ q *
            ENNReal.ofReal x) ^ (1 / q)) ≤
        C * (∫⁻ z : ℝ, ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < q := lt_trans (lt_trans zero_lt_one hr) hrq
  have hMunn : (0 : ℝ) ≤ Mu := le_trans (abs_nonneg (υ 0)) (hbd 0)
  have hMu'nn : (0 : ℝ) ≤ Mu' := le_trans (abs_nonneg (deriv υ 0)) (hbd' 0)
  set E1 : ℝ := (2 : ℝ) ^ |1 - q / 2| with hE1def
  have hE1nn : (0 : ℝ) ≤ E1 := by
    rw [hE1def]
    positivity
  set KC : ℝ := brsKernelConst Mu A N r ^ (1 / r) +
    brsKernelConst Mu' A' N r ^ (1 / r) with hKCdef
  have hKCnn : (0 : ℝ) ≤ KC := by
    rw [hKCdef]
    have h1 : (0 : ℝ) ≤ brsKernelConst Mu A N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMunn hAnn N hr.le) _
    have h2 : (0 : ℝ) ≤ brsKernelConst Mu' A' N r ^ (1 / r) :=
      Real.rpow_nonneg (brsKernelConst_nonneg hMu'nn hA'nn N hr.le) _
    linarith
  set Sv : ℝ := 1 / r - 1 / 2 with hSvdef
  set X : ENNReal := ∫⁻ x : ℝ, ‖brsRefl g x‖ₑ ^ p with hX
  set B : ENNReal := (9 : ENNReal) ^ (q / p) * A₀ with hBdef
  have hBtop : B ≠ ⊤ := by
    refine ENNReal.mul_ne_top ?_ hA₀top
    exact ENNReal.rpow_ne_top_of_nonneg (by positivity) (by norm_num)
  set T : ℕ → ENNReal := fun m => ∑' k : ℕ, ∫⁻ x : ℝ,
    brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
      (brsLPInput S (k + (4 + m)) g) E x ^ q * ENNReal.ofReal x with hT
  have hTle : ∀ n : ℕ, T n ≤ (ENNReal.ofReal E1 * ((Nloc n : ℕ) : ENNReal) *
      (ENNReal.ofReal (KC * ((2 : ℝ) ^ (-((4 + n : ℕ) : ℝ))) ^ Sv)) ^ q * B) *
      X ^ (q / p) := by
    intro n
    have h := tsum_brsNearMax_lp_le (a := 4 + n) hE (by omega) hυ hcs hR hυ'
      hcs' hR' hbd hAι hAnn hbd' hA' hA'nn hmom hmom' hg hgbd (hNloc n) hp hr
      hrq hpq hrel hq2p (hA₀ (4 + n))
    refine le_trans h (le_of_eq ?_)
    rw [hBdef, hX]
    ring
  obtain ⟨Ccst, hCcst⟩ : ∃ Ccst : ENNReal, Ccst =
      (ENNReal.ofReal ((E1 * Cγ * KC ^ q) ^ (1 / q)) * B ^ (1 / q) *
          ENNReal.ofReal ((2 : ℝ) ^ (((γ - Sv * q) / q) * 4))) *
        ENNReal.ofReal (1 / (1 - (2 : ℝ) ^ ((γ - Sv * q) / q))) := ⟨_, rfl⟩
  refine ⟨Ccst, ?_, ?_⟩
  · rw [hCcst]
    refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
      ENNReal.ofReal_ne_top ?_) ENNReal.ofReal_ne_top) ENNReal.ofReal_ne_top
    exact ENNReal.rpow_ne_top_of_nonneg (by positivity) hBtop
  · have hmain := tsum_endpoint_m_le (p := p) (q := q) hp0 hq0 hE1nn hKCnn hCγ
      hgeom (Nloc := fun n => ((Nloc n : ℕ) : ENNReal)) hNbd (B := B) (X := X)
      (T := T) hTle
    rw [hCcst]
    refine le_trans hmain (le_of_eq ?_)
    rw [hX, lintegral_enorm_rpow_brsRefl hg.measurable p]

/-! ## `R₂^-` at the endpoint, as one family

Far part, `m = 0` near part and `m ≥ 1` near parts are assembled into a single
countable family of *measurable* functions dominating `R₂^-`, so that the
radial Minkowski inequality applies without any measurability question about
the maximal functions themselves. -/

/-- **`R₂^-` at the endpoint, split into the three families.** -/
theorem brsRemTwoTwoLeft_endpoint_family_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf)
    (hpfR : tsupport pf ⊆ Metric.closedBall 0 1)
    (hpfint : Integrable pf volume) {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ)
    (hυint : Integrable υ volume) {Mυ : ℝ} (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q) ≤
      (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
            brsRemainderTwo (absProfile g) r) ^ q * ENNReal.ofReal r) ^ (1 / q) +
        ((∫⁻ r : ℝ, (ENNReal.ofReal (Mpf * 2 ^ (3 + 2)) *
              brsRemTwoWide (9 / 8) (absProfile g) r) ^ q *
            ENNReal.ofReal r) ^ (1 / q) +
          ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
            brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
              (brsLPInput S (k + (4 + m)) g) E r ^ q *
                ENNReal.ofReal r) ^ (1 / q)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hidx : ∀ k m : ℕ, k + 1 + 3 + m = k + (4 + m) := by
    intro k m
    omega
  set B : ℕ → ℕ → ℝ → ENNReal := fun m k r =>
    brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
      (brsLPInput S (k + (4 + m)) g) E r with hB
  set H : ℕ → ℝ → ENNReal := fun m =>
    match m with
    | 0 => fun r => ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r
    | 1 => fun r => ENNReal.ofReal (Mpf * 2 ^ (3 + 2)) *
        brsRemTwoWide (9 / 8) (absProfile g) r
    | (m + 2) => fun r => ∑' k : ℕ, B m k r with hH
  have hBmeas : ∀ m k : ℕ, Measurable (B m k) := by
    intro m k
    exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hυ _)
      (hasCompactSupport_brsDilate hυcs _)
      (continuous_brsLPInput S (k + (4 + m)) hg hgbd) E
  have hHmeas : ∀ m : ℕ, Measurable (H m) := by
    intro m
    match m with
    | 0 =>
        exact measurable_const.mul
          (measurable_brsRemainderTwo (continuous_absProfile hg))
    | 1 =>
        exact measurable_const.mul
          (measurable_brsRemTwoWide (continuous_absProfile hg))
    | (m + 2) => exact Measurable.ennreal_tsum fun k => hBmeas m k
  -- the pointwise bound on the integrand
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q ≤
      (∑' m : ℕ, H m r) ^ q * ENNReal.ofReal r := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, mul_zero]
    have hsplit := brsRemTwoTwoLeft_le_window_sum hE hg hr
    have hfar : brsFarWindowSum E g r ≤ H 0 r :=
      brsFarWindowSum_le_brsRemainderTwo hE hg r
    have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
        H 1 r + ∑' m : ℕ, H (m + 2) r := by
      have hstep : ∀ k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
          brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + 3)) g E r +
            ∑' m : ℕ, B m k r := by
        intro k
        have h := brsANearWindow_le_tsum_lp_piece (E := E) k 3 hg hgbd hpf hpfint hpfbd
          hpfnorm hfac hυ.continuous hυint hυbd r
        refine le_trans h (le_of_eq ?_)
        congr 1
        refine tsum_congr fun m => ?_
        rw [hB, hidx k m]
      refine le_trans (ENNReal.tsum_le_tsum hstep) ?_
      rw [ENNReal.tsum_add]
      refine add_le_add ?_ (le_of_eq ENNReal.tsum_comm)
      refine tsum_window_le
        (A := fun k r => brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + 3)) g E r)
        (V := fun r => ENNReal.ofReal (Mpf * 2 ^ (3 + 2)) *
          brsRemTwoWide (9 / 8) (absProfile g) r)
        (fun k r hr => brsNearMaxP_eq_zero_of_notMem hr) (fun k r => ?_) r
      exact brsNearMaxP_low_le_brsRemTwoWide (by omega) hpf hpfR hpfbd hg hgbd
        hE r
    have hle : brsRemTwoTwoLeft E g r ≤ ∑' m : ℕ, H m r := by
      refine le_trans hsplit ?_
      rw [ennreal_tsum_eq_zero_add (fun m : ℕ => H m r),
        ennreal_tsum_eq_zero_add (fun m : ℕ => H (m + 1) r)]
      rw [add_comm ((∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r))]
      exact add_le_add hfar hnear
    rw [mul_comm (ENNReal.ofReal r)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow hle hq0.le) le_rfl
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono hpt)
    (by positivity)) ?_
  refine le_trans (lintegral_radial_Lp_tsum_le hq hHmeas) (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H m r ^ q * ENNReal.ofReal r) ^ (1 / q)),
    ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H (m + 1) r ^ q * ENNReal.ofReal r) ^ (1 / q))]
  congr 1
  congr 1
  refine tsum_congr fun m => ?_
  congr 1
  exact lintegral_tsum_window_rpow
    (fun k r hr => brsNearMax_eq_zero_of_notMem hr) (fun k => hBmeas m k) hq0

/-! ## Localization of the profile

`R_2^{\pm}` only sees `f₀` on `[1/3, 2]`, so `f₀` may be replaced by its
product with a cutoff supported in `[1/4, 3]`.  On that support the radial
weight `s` is bounded below, so the unweighted `L^p` norm of the localized
profile is controlled by the weighted `L^p` norm of the original — which is
what lets the Littlewood--Paley half of the estimate (unweighted) and the
layer-cake half (weighted) be added. -/

/-- A continuous cutoff, `1` on `[1/3, 2]` and supported in `[1/4, 3]`. -/
def brsLocCutoff (s : ℝ) : ℝ :=
  max 0 (min 1 (min (12 * (s - 1 / 4)) (3 * (4 - s))))

theorem continuous_brsLocCutoff : Continuous brsLocCutoff := by
  show Continuous fun s : ℝ =>
    max 0 (min 1 (min (12 * (s - 1 / 4)) (3 * (4 - s))))
  fun_prop

theorem brsLocCutoff_nonneg (s : ℝ) : 0 ≤ brsLocCutoff s := le_max_left _ _

theorem brsLocCutoff_le_one (s : ℝ) : brsLocCutoff s ≤ 1 :=
  max_le zero_le_one (le_trans (min_le_left _ _) le_rfl)

theorem brsLocCutoff_eq_one {s : ℝ} (hs : s ∈ Icc (1 / 3 : ℝ) (10 / 3)) :
    brsLocCutoff s = 1 := by
  obtain ⟨h1, h2⟩ := hs
  have ha : (1 : ℝ) ≤ 12 * (s - 1 / 4) := by linarith
  have hb : (1 : ℝ) ≤ 3 * (4 - s) := by linarith
  rw [brsLocCutoff, min_eq_left (le_min ha hb), max_eq_right zero_le_one]

theorem brsLocCutoff_eq_zero_of_notMem {s : ℝ} (hs : s ∉ Icc (1 / 4 : ℝ) 4) :
    brsLocCutoff s = 0 := by
  rw [brsLocCutoff, max_eq_left]
  rcases lt_or_ge s (1 / 4 : ℝ) with h | h
  · exact le_trans (min_le_right _ _) (le_trans (min_le_left _ _) (by linarith))
  · have h3 : (4 : ℝ) < s := by
      by_contra hc
      exact hs ⟨h, le_of_not_gt hc⟩
    exact le_trans (min_le_right _ _) (le_trans (min_le_right _ _) (by linarith))

/-- The profile, localized to `[1/4, 3]`. -/
def brsLocalize (g : ℝ → ℂ) : ℝ → ℂ := fun s => ((brsLocCutoff s : ℝ) : ℂ) * g s

theorem continuous_brsLocalize {g : ℝ → ℂ} (hg : Continuous g) :
    Continuous (brsLocalize g) :=
  (Complex.continuous_ofReal.comp continuous_brsLocCutoff).mul hg

theorem norm_brsLocalize_le (g : ℝ → ℂ) (s : ℝ) :
    ‖brsLocalize g s‖ ≤ ‖g s‖ := by
  rw [brsLocalize, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg (brsLocCutoff_nonneg s)]
  exact mul_le_of_le_one_left (norm_nonneg _) (brsLocCutoff_le_one s)

theorem brsLocalize_bounded {g : ℝ → ℂ} {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    (z : ℝ) : ‖brsLocalize g z‖ ≤ Cg :=
  le_trans (norm_brsLocalize_le g z) (hgbd z)

theorem brsLocalize_eq_of_mem {g : ℝ → ℂ} {s : ℝ}
    (hs : s ∈ Icc (1 / 3 : ℝ) (10 / 3)) :
    brsLocalize g s = g s := by
  rw [brsLocalize, brsLocCutoff_eq_one hs]
  norm_num

theorem brsLocalize_eq_zero_of_notMem {g : ℝ → ℂ} {s : ℝ}
    (hs : s ∉ Icc (1 / 4 : ℝ) 4) : brsLocalize g s = 0 := by
  rw [brsLocalize, brsLocCutoff_eq_zero_of_notMem hs]
  norm_num

/-- **The unweighted `L^p` norm of the localized profile is controlled by the
weighted `L^p` norm.** -/
theorem lintegral_enorm_brsLocalize_le {g : ℝ → ℂ} {p : ℝ} (hp : 0 < p) :
    (∫⁻ z : ℝ, ‖brsLocalize g z‖ₑ ^ p) ≤
      ENNReal.ofReal 4 * ∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun z => ?_
  by_cases hz : z ∈ Icc (1 / 4 : ℝ) 4
  · have hz4 : (1 : ℝ) ≤ 4 * z := by
      have := hz.1
      linarith
    have hone : (1 : ENNReal) ≤ ENNReal.ofReal 4 * ENNReal.ofReal z := by
      rw [← ENNReal.ofReal_mul (by norm_num : (0 : ℝ) ≤ 4)]
      exact ENNReal.one_le_ofReal.mpr hz4
    calc ‖brsLocalize g z‖ₑ ^ p
        ≤ ‖g z‖ₑ ^ p := by
          refine ENNReal.rpow_le_rpow ?_ hp.le
          rw [← ofReal_norm, ← ofReal_norm]
          exact ENNReal.ofReal_le_ofReal (norm_brsLocalize_le g z)
      _ = 1 * ‖g z‖ₑ ^ p := (one_mul _).symm
      _ ≤ (ENNReal.ofReal 4 * ENNReal.ofReal z) * ‖g z‖ₑ ^ p :=
          mul_le_mul' hone le_rfl
      _ = ENNReal.ofReal 4 * (ENNReal.ofReal z * ‖g z‖ₑ ^ p) := by ring
  · rw [brsLocalize_eq_zero_of_notMem hz]
    simp [ENNReal.zero_rpow_of_pos hp]

/-- **The weighted `L^p` norm only decreases under localization.** -/
theorem lintegral_weighted_brsLocalize_le {g : ℝ → ℂ} {p : ℝ} (hp : 0 < p) :
    (∫⁻ s : ℝ, ENNReal.ofReal s * ‖brsLocalize g s‖ₑ ^ p) ≤
      ∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p := by
  refine lintegral_mono fun s => ?_
  refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hp.le)
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (norm_brsLocalize_le g s)

/-- **`R₂^-` does not see the localization.** -/
theorem brsRemTwoTwoLeft_brsLocalize {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (g : ℝ → ℂ) {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoLeft E (brsLocalize g) r = brsRemTwoTwoLeft E g r := by
  rw [brsRemTwoTwoLeft, brsRemTwoTwoLeft]
  refine iSup_congr fun t => ?_
  refine iSup_congr fun ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htI.1
  have ht2 : t ≤ 2 := htI.2
  have htr' : 3 * r / 2 ≤ t := htr
  have hsub : ∀ s ∈ uIcc (t - r) t, s ∈ Icc (1 / 3 : ℝ) (10 / 3) := by
    intro s hs
    rw [uIcc_of_le (by linarith)] at hs
    exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
  have hInt : (∫ s in (t - r)..t,
        ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * brsLocalize g s) =
      ∫ s in (t - r)..t,
        ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s := by
    refine intervalIntegral.integral_congr fun s hs => ?_
    show ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * brsLocalize g s =
      ((|s - (t - r)| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    rw [brsLocalize_eq_of_mem (hsub s hs)]
  rw [hInt]

/-! ## The two layer-cake families, in the form the assembly needs -/

theorem lintegral_const_mul_rpow_weight {K : ℝ} (hK : 0 < K) {q : ℝ}
    (hq : 0 < q) (R : ℝ → ENNReal) :
    (∫⁻ r : ℝ, (ENNReal.ofReal K * R r) ^ q * ENNReal.ofReal r) =
      ENNReal.ofReal (K ^ q) * ∫⁻ r : ℝ, ENNReal.ofReal r * R r ^ q := by
  rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_congr fun r => ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ hq.le, ENNReal.ofReal_rpow_of_pos hK]
  ring

theorem rpow_inv_const_mul {K : ℝ} (hK : 0 < K) {q : ℝ} (hq : 0 < q)
    (Y : ENNReal) :
    (ENNReal.ofReal (K ^ q) * Y) ^ (1 / q) = ENNReal.ofReal K * Y ^ (1 / q) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hK q), ← Real.rpow_mul hK.le,
    mul_one_div, div_self hq.ne', Real.rpow_one]

/-- **The far family at the endpoint.** -/
theorem endpoint_const_mul_brsRemainderTwo {p : ℝ} (hp : 1 < p) {K : ℝ}
    (hK : 0 < K) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ r : ℝ, (ENNReal.ofReal K * brsRemainderTwo (absProfile g) r) ^
          (2 * p) * ENNReal.ofReal r) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  obtain ⟨C, hCpos, hbound⟩ :=
    prop43_brsRemainderTwo_endpoint (d := 2) (by norm_num) hp
  refine ⟨K * C, by positivity, fun g hg => ?_⟩
  have hb := hbound g hg
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hb
  rw [lintegral_const_mul_rpow_weight hK hq0, rpow_inv_const_mul hK hq0]
  calc ENNReal.ofReal K *
        (∫⁻ r : ℝ, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p))
      ≤ ENNReal.ofReal K * (ENNReal.ofReal C *
          (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl hb
    _ = ENNReal.ofReal (K * C) *
          (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
        rw [ENNReal.ofReal_mul hK.le, mul_assoc]

/-- **The `m = 0` near family at the endpoint.** -/
theorem endpoint_const_mul_brsRemTwoWide {p : ℝ} (hp : 1 < p) {c : ℝ}
    (hc0 : 0 ≤ c) (hc : c < 3 / 2) {C₀ : ℝ} (hC₀ : 0 < C₀) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ r : ℝ, (ENNReal.ofReal C₀ * brsRemTwoWide c (absProfile g) r) ^
          (2 * p) * ENNReal.ofReal r) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  obtain ⟨C, hCpos, hbound⟩ := endpoint_of_le_brsRemTwoWide hp hc0 hc hC₀
  refine ⟨C, hCpos, fun g hg => ?_⟩
  have hb := hbound g hg (fun r => ENNReal.ofReal C₀ *
    brsRemTwoWide c (absProfile g) r) (fun r => le_rfl)
  refine le_trans (le_of_eq ?_) hb
  refine congrArg (fun z : ENNReal => z ^ (1 / (2 * p))) ?_
  refine lintegral_congr fun r => ?_
  ring

/-! ## Proposition 5.4(i) at the endpoint `q = 2p`, left half

The three families are estimated separately — far part and `m = 0` near part by
the layer cake, `m ≥ 1` near parts by Littlewood--Paley — and the profile is
localized first so that all three land on the same weighted `L^p` norm. -/

/-- **Proposition 5.4(i) at the endpoint `q = 2p` for `R₂^-`.** -/
theorem prop54_brsRemTwoTwoLeft_endpoint_interior {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    {pf : ℝ → ℝ} (hpf : Continuous pf)
    (hpfR : tsupport pf ⊆ Metric.closedBall 0 1)
    (hpfint : Integrable pf volume) {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    (hυint : Integrable υ volume)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hAι : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p rr : ℝ} (hp : 1 < p) (hr : 1 < rr) (hrq : rr < 2 * p)
    (hrel : 1 / p + 1 / rr = 1 + 1 / (2 * p))
    (hgeom : (γ - (1 / rr - 1 / 2) * (2 * p)) / (2 * p) < 0)
    {A₀ : ENNReal} (hA₀top : A₀ ≠ ⊤)
    (hA₀ : ∀ (offset : ℕ) (h : ℝ → ℂ) (Ch : ℝ), Continuous h →
      (∀ z : ℝ, ‖h z‖ ≤ Ch) →
      (∑' k : ℕ, (∫⁻ x : ℝ, ‖∫ y : ℝ,
          (brsSchwartzDilate S (k + offset) : ℝ → ℂ) y * h (x - y)‖ₑ ^ p) ^
            (2 * p / p)) ≤
        A₀ * (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (2 * p / p))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoLeft E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
        C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set Y : ENNReal := (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) with hY
  -- localize
  set h : ℝ → ℂ := brsLocalize g with hh
  have hhc : Continuous h := continuous_brsLocalize hg
  have hhbd : ∀ z : ℝ, ‖h z‖ ≤ Cg := fun z => brsLocalize_bounded hgbd z
  have hloc : (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ (2 * p)) =
      ∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E h x ^ (2 * p) := by
    refine lintegral_congr fun x => ?_
    rcases le_or_gt x 0 with hx | hx
    · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul, zero_mul]
    · rw [hh, brsRemTwoTwoLeft_brsLocalize hE g hx.le]
  -- the constant for the `m = 0` family
  set Mp : ℝ := max Mpf 1 with hMp
  have hMppos : (0 : ℝ) < Mp := lt_of_lt_of_le zero_lt_one (le_max_right _ _)
  have hpfbd' : ∀ x : ℝ, |pf x| ≤ Mp := fun x =>
    le_trans (hpfbd x) (le_max_left _ _)
  have hC₀pos : (0 : ℝ) < Mp * 2 ^ (3 + 2) := by positivity
  -- the three families
  have hfam := brsRemTwoTwoLeft_endpoint_family_le hE hhc hhbd hpf hpfR hpfint
    hpfbd' hpfnorm hfac hυ hcs hυint hbd hq1
  obtain ⟨C1, hC1pos, hC1⟩ := endpoint_const_mul_brsRemainderTwo hp
    (K := (2048 : ℝ) ^ (1 / 2 : ℝ)) (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨C2, hC2pos, hC2⟩ := endpoint_const_mul_brsRemTwoWide hp
    (c := 9 / 8) (by norm_num) (by norm_num) hC₀pos
  obtain ⟨C3, hC3top, hC3⟩ := tsum_near_high_endpoint hE hυ hcs hR hυ' hcs' hR'
    hbd hAι hAnn hbd' hA' hA'nn hmom hmom' hhc hhbd hCγ hNloc hNbd hp hr hrq
    (by linarith : p < 2 * p) hrel (le_refl (2 * p)) hA₀top
    (fun offset => hA₀ offset (brsRefl h) Cg (continuous_brsRefl hhc)
      (fun z => brsRefl_bounded hhbd z)) hgeom
  -- the weighted and unweighted norms of the localized profile
  have hw : (∫⁻ s : ℝ, ENNReal.ofReal s * ‖h s‖ₑ ^ p) ^ (1 / p) ≤ Y := by
    rw [hY]
    exact ENNReal.rpow_le_rpow (lintegral_weighted_brsLocalize_le hp0)
      (by positivity)
  have hu : (∫⁻ z : ℝ, ‖h z‖ₑ ^ p) ^ (1 / p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsLocalize_le (g := g) hp0) (by positivity)) ?_
    rw [hY, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
  refine ⟨ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
    C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p))), ?_, ?_⟩
  · refine ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ?_⟩
    exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top,
      ENNReal.mul_ne_top hC3top ENNReal.ofReal_ne_top⟩
  · rw [hloc]
    refine le_trans hfam ?_
    have h1 : (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile h) r) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C1 * Y :=
      le_trans (hC1 h hhc) (mul_le_mul' le_rfl hw)
    have h2 : (∫⁻ r : ℝ, (ENNReal.ofReal (Mp * 2 ^ (3 + 2)) *
        brsRemTwoWide (9 / 8) (absProfile h) r) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C2 * Y :=
      le_trans (hC2 h hhc) (mul_le_mul' le_rfl hw)
    have h3 : (∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
          (brsLPInput S (k + (4 + m)) h) E r ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p))) ≤
        C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
      refine le_trans hC3 ?_
      rw [mul_assoc]
      exact mul_le_mul' le_rfl hu
    calc (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
              brsRemainderTwo (absProfile h) r) ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p)) +
          ((∫⁻ r : ℝ, (ENNReal.ofReal (Mp * 2 ^ (3 + 2)) *
                brsRemTwoWide (9 / 8) (absProfile h) r) ^ (2 * p) *
              ENNReal.ofReal r) ^ (1 / (2 * p)) +
            ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
              brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
                (brsLPInput S (k + (4 + m)) h) E r ^ (2 * p) *
                  ENNReal.ofReal r) ^ (1 / (2 * p)))
        ≤ ENNReal.ofReal C1 * Y +
            (ENNReal.ofReal C2 * Y + C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y) :=
          add_le_add h1 (add_le_add h2 h3)
      _ = (ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
            C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)))) * Y := by ring

/-! ## The layer cake, with the level-set bound abstracted

Everything in Proposition 4.3 downstream of the level-set estimate depends only
on the two constants `A` and `B` in it, so the argument is written once here
and instantiated for each maximal function. -/

/-- **Proposition 4.3 at the endpoint `q = pd`, from a level-set bound.** -/
theorem prop43_abstract_endpoint {d : ℕ} (hd : 2 ≤ d) {p : ℝ} (hp : 1 < p)
    {A B : ℝ} (hApos : 0 < A) (hBpos : 0 < B) {f₀ : ℝ → ℂ}
    (hf₀ : Measurable f₀)
    {M : ℝ → ENNReal} (hMmeas : Measurable M) (hMfin : ∀ r : ℝ, M r ≠ ⊤)
    (hlev : ∀ u : ℝ, 0 < u →
      brsWeightMeasure d {r : ℝ | ENNReal.ofReal u < M r} ≤
        ENNReal.ofReal ((A / u) ^ d / (d : ℝ)) *
          brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / B) ^ d) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ (p * (d : ℝ))) ^
        (1 / (p * (d : ℝ))) ≤
      ENNReal.ofReal ((p * (d : ℝ) * (A ^ d / ((d : ℝ) * B ^ d)) *
          ((d : ℝ) * (p - 1))⁻¹ * B ^ (p * (d : ℝ))) ^ (1 / (p * (d : ℝ)))) *
        (∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
          (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hdnat : 0 < d := by omega
  have hdpos : (0 : ℝ) < (d : ℝ) := by exact_mod_cast hdnat
  have hdone : (1 : ℝ) ≤ (d : ℝ) := by
    have : (1 : ℕ) ≤ d := by omega
    exact_mod_cast this
  set q : ℝ := p * (d : ℝ) with hq
  have hq0 : (0 : ℝ) < q := by rw [hq]; positivity
  set a : ℝ := (d : ℝ) * (p - 1) with ha
  have ha0 : (0 : ℝ) < a := by
    rw [ha]
    have h1 : (0 : ℝ) < p - 1 := by linarith
    positivity
  set K : ℝ := A ^ d / ((d : ℝ) * B ^ d) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  have hBq : (0 : ℝ) < B ^ q := Real.rpow_pos_of_pos hBpos _
  have hCpos : (0 : ℝ) < (q * K * a⁻¹ * B ^ q) ^ (1 / q) := by
    have : (0 : ℝ) < q * K * a⁻¹ * B ^ q := by positivity
    exact Real.rpow_pos_of_pos this _
  show (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) ^ (1 / q) ≤
    ENNReal.ofReal ((q * K * a⁻¹ * B ^ q) ^ (1 / q)) *
      (∫⁻ s, ENNReal.ofReal s ^ (d - 1) * (ENNReal.ofReal ‖f₀ s‖) ^ p) ^ (1 / p)
  have hnormmeas : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm
  set μ : Measure ℝ := brsWeightMeasure d with hmu
  set X : ENNReal := ∫⁻ s, ENNReal.ofReal s ^ (d - 1) *
    (ENNReal.ofReal ‖f₀ s‖) ^ p with hX
  by_cases hXtop : X = ⊤
  · rw [hXtop, ENNReal.top_rpow_of_pos (by positivity : (0 : ℝ) < 1 / p),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        exact hCpos)]
    exact le_top
  have hmuX : X = ∫⁻ s, (ENNReal.ofReal ‖f₀ s‖) ^ p ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d)
      (g := fun s => (ENNReal.ofReal ‖f₀ s‖) ^ p)
      (ENNReal.continuous_rpow_const.measurable.comp hnormmeas.ennreal_ofReal), hX]
  have hLHS : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) =
      ∫⁻ r, M r ^ q ∂μ := by
    rw [hmu, lintegral_brsWeightMeasure (d := d) (g := fun r => M r ^ q)
      (ENNReal.continuous_rpow_const.measurable.comp hMmeas)]
  have hlayer := lintegral_ennreal_rpow_eq_meas_lt (μ := μ) hMmeas hMfin hq0
  -- the pointwise bound on the level integrand
  have hpt : ∀ u ∈ Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < M r} * ENNReal.ofReal (u ^ (q - 1)) ≤
        ENNReal.ofReal K * (ENNReal.ofReal (u ^ (a - 1)) *
          brsTail μ (fun s => B * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ)) := by
    intro u hu0
    have hu : (0 : ℝ) < u := hu0
    have hmeas := hlev u hu
    refine le_trans (mul_le_mul' hmeas le_rfl) ?_
    refine le_of_eq ?_
    rw [brsTail_smul (fun s => ‖f₀ s‖) hBpos u, ENNReal.rpow_natCast]
    set S : ENNReal := brsTail μ (fun s => ‖f₀ s‖) (u / B) with hS
    have hAnn : (0 : ℝ) ≤ (A / u) ^ d / (d : ℝ) :=
      div_nonneg (pow_nonneg (by positivity) d) hdpos.le
    have hupow : u ^ (q - 1) = u ^ (a - 1) * u ^ d := by
      rw [← Real.rpow_natCast u d, ← Real.rpow_add hu]
      congr 1
      rw [hq, ha]
      ring
    have ereal : (A / u) ^ d / (d : ℝ) * u ^ (q - 1) =
        K * u ^ (a - 1) * B ^ d := by
      rw [hupow, hK, div_pow]
      field_simp
    have hL : ENNReal.ofReal ((A / u) ^ d / (d : ℝ)) * S ^ d *
        ENNReal.ofReal (u ^ (q - 1)) =
        ENNReal.ofReal ((A / u) ^ d / (d : ℝ) * u ^ (q - 1)) * S ^ d := by
      rw [ENNReal.ofReal_mul hAnn]
      ring
    have hR : ENNReal.ofReal K *
        (ENNReal.ofReal (u ^ (a - 1)) * (ENNReal.ofReal B * S) ^ d) =
        ENNReal.ofReal (K * u ^ (a - 1) * B ^ d) * S ^ d := by
      rw [mul_pow, ← ENNReal.ofReal_pow hBpos.le,
        ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * u ^ (a - 1)),
        ENNReal.ofReal_mul hKpos.le]
      ring
    rw [hL, hR, ereal]
  have hstep : (∫⁻ u in Ioi (0 : ℝ),
      μ {r : ℝ | ENNReal.ofReal u < M r} * ENNReal.ofReal (u ^ (q - 1))) ≤
      ENNReal.ofReal K * ∫⁻ u in Ioi (0 : ℝ), ENNReal.ofReal (u ^ (a - 1)) *
        brsTail μ (fun s => B * ‖f₀ s‖) u ^ ((d : ℕ) : ℝ) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact setLIntegral_mono' measurableSet_Ioi hpt
  have hhmeas : Measurable fun s : ℝ => B * ‖f₀ s‖ :=
    measurable_const.mul hnormmeas
  have hhnn : ∀ s : ℝ, (0 : ℝ) ≤ B * ‖f₀ s‖ := fun s => by positivity
  have hpa : 1 + a / ((d : ℕ) : ℝ) = p := by
    rw [ha]
    field_simp
    ring
  have htail := lintegral_brsTail_rpow_le_total (μ := μ) hhmeas hhnn
    (p := p) (a := a) (m := ((d : ℕ) : ℝ)) hp.le hdone ha0 hpa
  have hXh : (∫⁻ s, ENNReal.ofReal (B * ‖f₀ s‖) ^ p ∂μ) =
      ENNReal.ofReal (B ^ p) * X := by
    rw [hmuX, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun s => ?_
    rw [ENNReal.ofReal_mul hBpos.le, ENNReal.mul_rpow_of_nonneg _ _ hp0.le,
      ENNReal.ofReal_rpow_of_pos hBpos]
  rw [hXh] at htail
  have hpowB : (ENNReal.ofReal (B ^ p) * X) ^ ((d : ℕ) : ℝ) =
      ENNReal.ofReal (B ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ ((d : ℕ) : ℝ)),
      ENNReal.ofReal_rpow_of_pos (Real.rpow_pos_of_pos hBpos _),
      ← Real.rpow_mul hBpos.le]
  rw [hpowB] at htail
  have hfinal : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) ≤
      ENNReal.ofReal (q * K * a⁻¹ * B ^ q) * X ^ ((d : ℕ) : ℝ) := by
    rw [hLHS, hlayer]
    refine le_trans (mul_le_mul' le_rfl (le_trans hstep
      (mul_le_mul' le_rfl htail))) ?_
    refine le_of_eq ?_
    rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K * a⁻¹),
      ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ q * K),
      ENNReal.ofReal_mul hq0.le]
    ring
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * M r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (q * K * a⁻¹ * B ^ q) * X ^ ((d : ℕ) : ℝ)) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hfinal (by positivity)
    _ = ENNReal.ofReal ((q * K * a⁻¹ * B ^ q) ^ (1 / q)) * X ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul,
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) <
            q * K * a⁻¹ * B ^ q),
          show ((d : ℕ) : ℝ) * (1 / q) = 1 / p from by rw [hq]; field_simp]

/-! ## The centred maximal average

For a profile supported in `[1/4, ∞)` the layer-cake argument no longer needs
the constraint `t ≥ 3r/2`: the lower bound on the averaging interval that keeps
the radial weight under control comes from the support instead.  That frees the
centre to range over all of `[1/3, 2]` and the width to be arbitrary, which is
what the Schwartz tail of the low-frequency profile requires. -/

/-- The maximal average of `f₀` at scale `ρ`, over centres in `[1/3, 2]`. -/
def brsRemTwoCent (f₀ : ℝ → ℂ) (ρ : ℝ) : ENNReal :=
  ⨆ x : ℝ, ENNReal.ofReal (ρ⁻¹ * ‖∫ s in (x - ρ)..(x + ρ), f₀ s‖)

theorem brsRemTwoCent_eq_zero_of_nonpos {f₀ : ℝ → ℂ} {ρ : ℝ} (hρ : ρ ≤ 0) :
    brsRemTwoCent (absProfile f₀) ρ = 0 := by
  refine le_antisymm (iSup_le fun x => ?_) (by simp)
  refine le_of_eq (ENNReal.ofReal_eq_zero.mpr ?_)
  exact mul_nonpos_of_nonpos_of_nonneg (inv_nonpos.mpr hρ) (norm_nonneg _)

/-- **Splitting the centred average at the height `lam`.** -/
theorem brsRemTwoCent_le_tail {d : ℕ} {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀)
    (hsupp : ∀ s : ℝ, s < 1 / 4 → f₀ s = 0) {ρ lam : ℝ} (hρ : 0 < ρ)
    (hlam : 0 < lam) :
    brsRemTwoCent (absProfile f₀) ρ ≤
      ENNReal.ofReal ((4 : ℝ) ^ (d - 1) * ρ⁻¹) *
          brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam +
        ENNReal.ofReal (2 * lam) := by
  have hmeasf : Measurable fun s : ℝ => ‖f₀ s‖ := hf₀.norm.measurable
  set T : ENNReal := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  set g : ℝ → ENNReal := fun s =>
    {s : ℝ | lam < ‖f₀ s‖}.indicator (fun s => ENNReal.ofReal ‖f₀ s‖) s with hg
  have hgm : Measurable g := by
    rw [hg]
    exact (hmeasf.ennreal_ofReal).indicator
      (measurableSet_lt measurable_const hmeasf)
  have hTeq : T = ∫⁻ s, ENNReal.ofReal s ^ (d - 1) * g s := by
    rw [hT, brsTail]
    exact lintegral_brsWeightMeasure hgm
  refine iSup_le fun x => ?_
  have hab : x - ρ ≤ x + ρ := by linarith
  set H : ℝ → ENNReal := fun s =>
    ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * (ENNReal.ofReal s ^ (d - 1) * g s) +
      ENNReal.ofReal lam with hH
  have hHbound : ∀ s ∈ Icc (x - ρ) (x + ρ),
      ENNReal.ofReal ‖absProfile f₀ s‖ ≤ H s := by
    intro s _
    have hnorm : ‖absProfile f₀ s‖ = ‖f₀ s‖ := norm_absProfile f₀ s
    rw [hnorm, hH]
    simp only
    rcases lt_or_ge s (1 / 4 : ℝ) with hs | hs
    · rw [hsupp s hs]
      simp
    have hsnn : (0 : ℝ) ≤ s := by linarith
    by_cases hz : lam < ‖f₀ s‖
    · have hone : (1 : ENNReal) ≤
          ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1) := by
        rw [← ENNReal.ofReal_pow hsnn,
          ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (4 : ℝ) ^ (d - 1)),
          ← mul_pow]
        refine ENNReal.one_le_ofReal.mpr ?_
        refine one_le_pow₀ ?_
        linarith
      calc ENNReal.ofReal ‖f₀ s‖
          = 1 * ENNReal.ofReal ‖f₀ s‖ := (one_mul _).symm
        _ ≤ (ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * ENNReal.ofReal s ^ (d - 1)) *
              ENNReal.ofReal ‖f₀ s‖ := mul_le_mul' hone le_rfl
        _ = ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) *
              (ENNReal.ofReal s ^ (d - 1) * g s) := by
            rw [hg]
            simp only
            rw [Set.indicator_of_mem (show s ∈ {s : ℝ | lam < ‖f₀ s‖} from hz)]
            ring
        _ ≤ _ := le_self_add
    · push Not at hz
      exact le_trans (ENNReal.ofReal_le_ofReal hz) le_add_self
  have hkey := ofReal_norm_intervalIntegral_le_lintegral hab (absProfile f₀) H
    hHbound
  have hHint : (∫⁻ s in Icc (x - ρ) (x + ρ), H s) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * T +
        ENNReal.ofReal lam * ENNReal.ofReal (2 * ρ) := by
    rw [hH]
    simp only
    rw [lintegral_add_right _ measurable_const, setLIntegral_const,
      Real.volume_Icc, show x + ρ - (x - ρ) = 2 * ρ from by ring]
    refine add_le_add ?_ le_rfl
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top, hTeq]
    exact mul_le_mul' le_rfl (setLIntegral_le_lintegral _ _)
  have e1 : ENNReal.ofReal ρ⁻¹ * ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) =
      ENNReal.ofReal ((4 : ℝ) ^ (d - 1) * ρ⁻¹) := by
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ⁻¹)]
    congr 1
    ring
  have e2 : ENNReal.ofReal ρ⁻¹ *
      (ENNReal.ofReal lam * ENNReal.ofReal (2 * ρ)) =
      ENNReal.ofReal (2 * lam) := by
    rw [← ENNReal.ofReal_mul hlam.le,
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ ρ⁻¹)]
    congr 1
    field_simp
  calc ENNReal.ofReal (ρ⁻¹ * ‖∫ s in (x - ρ)..(x + ρ), absProfile f₀ s‖)
      = ENNReal.ofReal ρ⁻¹ *
          ENNReal.ofReal ‖∫ s in (x - ρ)..(x + ρ), absProfile f₀ s‖ :=
        ENNReal.ofReal_mul (by positivity)
    _ ≤ ENNReal.ofReal ρ⁻¹ *
          (ENNReal.ofReal ((4 : ℝ) ^ (d - 1)) * T +
            ENNReal.ofReal lam * ENNReal.ofReal (2 * ρ)) :=
        mul_le_mul' le_rfl (le_trans hkey hHint)
    _ = ENNReal.ofReal ((4 : ℝ) ^ (d - 1) * ρ⁻¹) * T +
          ENNReal.ofReal (2 * lam) := by
        rw [mul_add, ← mul_assoc, e1, e2]

/-- **The level sets of the centred average.** -/
theorem measure_brsRemTwoCent_gt_le {d : ℕ} (hd : 2 ≤ d) {f₀ : ℝ → ℂ}
    (hf₀ : Continuous f₀) (hsupp : ∀ s : ℝ, s < 1 / 4 → f₀ s = 0) {u : ℝ}
    (hu : 0 < u) :
    brsWeightMeasure d
        {ρ : ℝ | ENNReal.ofReal u < brsRemTwoCent (absProfile f₀) ρ} ≤
      ENNReal.ofReal ((2 * (4 : ℝ) ^ (d - 1) / u) ^ d / (d : ℝ)) *
        brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) (u / 4) ^ d := by
  set K : ℝ := (4 : ℝ) ^ (d - 1) with hK
  have hKpos : (0 : ℝ) < K := by
    rw [hK]
    positivity
  set lam : ℝ := u / 4 with hlamdef
  have hlampos : (0 : ℝ) < lam := by
    rw [hlamdef]
    positivity
  have hlamid : 2 * lam = u / 2 := by
    rw [hlamdef]
    ring
  have hdpos : (0 : ℝ) < (d : ℝ) := by
    have : (0 : ℕ) < d := by omega
    exact_mod_cast this
  have hCnonneg : (0 : ℝ) ≤ (2 * K / u) ^ d / (d : ℝ) :=
    div_nonneg (pow_nonneg (by positivity) d) hdpos.le
  set T := brsTail (brsWeightMeasure d) (fun s => ‖f₀ s‖) lam with hT
  by_cases hTtop : T = ⊤
  · rw [hTtop, ENNReal.top_pow (by omega : d ≠ 0),
      ENNReal.mul_top (by
        simp only [ne_eq, ENNReal.ofReal_eq_zero, not_le]
        positivity)]
    exact le_top
  set gt : ℝ := T.toReal with hgt
  have hgnn : (0 : ℝ) ≤ gt := ENNReal.toReal_nonneg
  have hTg : T = ENNReal.ofReal gt := (ENNReal.ofReal_toReal hTtop).symm
  set rho : ℝ := 2 * K * gt / u with hrho
  have hrhonn : (0 : ℝ) ≤ rho := by
    rw [hrho]
    positivity
  have hsub : {ρ : ℝ | ENNReal.ofReal u < brsRemTwoCent (absProfile f₀) ρ} ⊆
      Ioo 0 rho := by
    intro ρ hr
    simp only [Set.mem_setOf_eq] at hr
    have hr0 : 0 < ρ := by
      by_contra hcon
      push Not at hcon
      rw [brsRemTwoCent_eq_zero_of_nonpos hcon] at hr
      simp at hr
    have hsplit := brsRemTwoCent_le_tail (d := d) hf₀ hsupp hr0 hlampos
    rw [← hT, hTg] at hsplit
    have hlt : ENNReal.ofReal u <
        ENNReal.ofReal (K * ρ⁻¹) * ENNReal.ofReal gt +
          ENNReal.ofReal (2 * lam) := lt_of_lt_of_le hr hsplit
    rw [← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ K * ρ⁻¹),
      ← ENNReal.ofReal_add (by positivity) (by positivity)] at hlt
    have hreal : u < K * ρ⁻¹ * gt + 2 * lam :=
      (ENNReal.ofReal_lt_ofReal_iff_of_nonneg hu.le).mp hlt
    rw [hlamid] at hreal
    refine ⟨hr0, ?_⟩
    rw [hrho, lt_div_iff₀ hu]
    have h2 : u / 2 < K * ρ⁻¹ * gt := by linarith
    have h3 : ρ * u / 2 < K * gt := by
      calc ρ * u / 2 = ρ * (u / 2) := by ring
        _ < ρ * (K * ρ⁻¹ * gt) := mul_lt_mul_of_pos_left h2 hr0
        _ = K * gt := by field_simp
    linarith
  calc brsWeightMeasure d
        {ρ : ℝ | ENNReal.ofReal u < brsRemTwoCent (absProfile f₀) ρ}
      ≤ brsWeightMeasure d (Ioo 0 rho) := measure_mono hsub
    _ = ENNReal.ofReal (rho ^ d / (d : ℝ)) :=
        brsWeightMeasure_Ioo (by omega) hrhonn
    _ = ENNReal.ofReal ((2 * K / u) ^ d / (d : ℝ)) * T ^ d := by
        rw [hTg, ← ENNReal.ofReal_pow hgnn, ← ENNReal.ofReal_mul hCnonneg]
        congr 1
        rw [hrho]
        field_simp
        ring

/-! ## The centred average is measurable and finite -/

theorem exists_rat_seq_tendsto (x : ℝ) :
    ∃ b : ℕ → ℚ, Tendsto (fun n => ((b n : ℚ) : ℝ)) atTop (nhds x) := by
  have hchoice : ∀ n : ℕ, ∃ q : ℚ, |((q : ℚ) : ℝ) - x| < 1 / ((n : ℝ) + 1) := by
    intro n
    have hpos : (0 : ℝ) < 1 / ((n : ℝ) + 1) := by positivity
    obtain ⟨q, hq1, hq2⟩ :=
      exists_rat_btwn (show x - 1 / ((n : ℝ) + 1) < x + 1 / ((n : ℝ) + 1) from
        by linarith)
    exact ⟨q, abs_lt.mpr ⟨by linarith, by linarith⟩⟩
  choose b hb using hchoice
  refine ⟨b, ?_⟩
  rw [Metric.tendsto_atTop]
  intro ε hε
  obtain ⟨N, hN⟩ := exists_nat_gt (1 / ε)
  refine ⟨N, fun n hn => ?_⟩
  have hnN : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
  have hposn : (0 : ℝ) < (n : ℝ) + 1 := by positivity
  have hlt : 1 / ((n : ℝ) + 1) < ε := by
    rw [div_lt_iff₀ hposn]
    have h1 : (1 / ε) < (n : ℝ) := lt_of_lt_of_le hN hnN
    rw [div_lt_iff₀ hε] at h1
    nlinarith
  exact lt_of_lt_of_le (lt_of_le_of_lt (le_of_eq (Real.dist_eq _ _)) (hb n))
    hlt.le

theorem brsRemTwoCent_eq_rat_iSup {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) (ρ : ℝ) :
    brsRemTwoCent f₀ ρ =
      ⨆ b : ℚ, ENNReal.ofReal (ρ⁻¹ *
        ‖∫ s in ((b : ℝ) - ρ)..((b : ℝ) + ρ), f₀ s‖) := by
  refine le_antisymm ?_ ?_
  · rw [brsRemTwoCent]
    refine iSup_le fun x => ?_
    obtain ⟨b, hbtend⟩ := exists_rat_seq_tendsto x
    have hGcont : ContinuousAt
        (fun u : ℝ => ρ⁻¹ * ‖∫ s in (u - ρ)..(u + ρ), f₀ s‖) x := by
      have hwin : ContinuousAt
          (fun u : ℝ => ∫ s in (u - ρ)..(u + ρ), f₀ s) x :=
        ((continuous_window_integral hf₀).comp
          ((continuous_const : Continuous fun _ : ℝ => ρ).prodMk continuous_id)
            ).continuousAt
      exact continuousAt_const.mul hwin.norm
    have hlim : Tendsto (fun n : ℕ => ENNReal.ofReal
        (ρ⁻¹ * ‖∫ s in (((b n : ℚ) : ℝ) - ρ)..(((b n : ℚ) : ℝ) + ρ), f₀ s‖))
        atTop (nhds (ENNReal.ofReal
          (ρ⁻¹ * ‖∫ s in (x - ρ)..(x + ρ), f₀ s‖))) :=
      (ENNReal.continuous_ofReal.tendsto _).comp (hGcont.tendsto.comp hbtend)
    refine le_of_tendsto hlim (Filter.Eventually.of_forall fun n => ?_)
    exact le_iSup (fun c : ℚ => ENNReal.ofReal (ρ⁻¹ *
      ‖∫ s in ((c : ℝ) - ρ)..((c : ℝ) + ρ), f₀ s‖)) (b n)
  · refine iSup_le fun b => ?_
    rw [brsRemTwoCent]
    exact le_iSup (fun x : ℝ => ENNReal.ofReal (ρ⁻¹ *
      ‖∫ s in (x - ρ)..(x + ρ), f₀ s‖)) ((b : ℚ) : ℝ)

theorem measurable_brsRemTwoCent {f₀ : ℝ → ℂ} (hf₀ : Continuous f₀) :
    Measurable (brsRemTwoCent f₀) := by
  have heq : brsRemTwoCent f₀ = fun ρ : ℝ =>
      ⨆ b : ℚ, ENNReal.ofReal (ρ⁻¹ *
        ‖∫ s in ((b : ℝ) - ρ)..((b : ℝ) + ρ), f₀ s‖) :=
    funext (brsRemTwoCent_eq_rat_iSup hf₀)
  rw [heq]
  refine Measurable.iSup fun b => ?_
  refine ENNReal.measurable_ofReal.comp ?_
  refine measurable_inv.mul ?_
  exact (((continuous_window_integral hf₀).comp
    (continuous_id.prodMk (continuous_const : Continuous fun _ : ℝ =>
      (b : ℝ)))).norm).measurable

theorem brsRemTwoCent_ne_top {f₀ : ℝ → ℂ} {Cf : ℝ}
    (hbd : ∀ z : ℝ, ‖f₀ z‖ ≤ Cf) {ρ : ℝ} (hρ : 0 < ρ) :
    brsRemTwoCent (absProfile f₀) ρ ≠ ⊤ := by
  refine ne_top_of_le_ne_top
    (b := ENNReal.ofReal (ρ⁻¹ * (Cf * |2 * ρ|))) ENNReal.ofReal_ne_top ?_
  refine iSup_le fun x => ?_
  refine ENNReal.ofReal_le_ofReal
    (mul_le_mul_of_nonneg_left ?_ (by positivity))
  have hbd' : ∀ y ∈ uIoc (x - ρ) (x + ρ), ‖absProfile f₀ y‖ ≤ Cf := by
    intro y _
    rw [norm_absProfile]
    exact hbd y
  refine le_trans (intervalIntegral.norm_integral_le_of_norm_le_const hbd')
    (le_of_eq ?_)
  congr 2
  ring

/-- **The endpoint estimate for the centred average.** -/
theorem prop43_brsRemTwoCent_endpoint {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ (f₀ : ℝ → ℂ) (Cf : ℝ), Continuous f₀ →
      (∀ z : ℝ, ‖f₀ z‖ ≤ Cf) → (∀ s : ℝ, s < 1 / 4 → f₀ s = 0) →
      (∫⁻ ρ, ENNReal.ofReal ρ *
          brsRemTwoCent (absProfile f₀) ρ ^ (2 * p)) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C *
          (∫⁻ s, ENNReal.ofReal s * ‖f₀ s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  set Cst : ℝ := (2 * p * ((8 : ℝ) ^ (2 : ℕ) / (2 * (4 : ℝ) ^ (2 : ℕ))) *
      (2 * (p - 1))⁻¹ * (4 : ℝ) ^ (2 * p)) ^ (1 / (2 * p)) with hCst
  have hCpos : (0 : ℝ) < Cst := by
    rw [hCst]
    have h1 : (0 : ℝ) < p - 1 := by linarith
    have h2 : (0 : ℝ) < (4 : ℝ) ^ (2 * p) := Real.rpow_pos_of_pos (by norm_num) _
    have hnum : (0 : ℝ) < 2 * p * ((8 : ℝ) ^ (2 : ℕ) / (2 * (4 : ℝ) ^ (2 : ℕ))) *
        (2 * (p - 1))⁻¹ * (4 : ℝ) ^ (2 * p) := by positivity
    exact Real.rpow_pos_of_pos hnum _
  refine ⟨Cst, hCpos, fun f₀ Cf hf₀ hfbd hsupp => ?_⟩
  have hlev : ∀ u : ℝ, 0 < u →
      brsWeightMeasure 2
          {ρ : ℝ | ENNReal.ofReal u < brsRemTwoCent (absProfile f₀) ρ} ≤
        ENNReal.ofReal (((8 : ℝ) / u) ^ (2 : ℕ) / (((2 : ℕ) : ℝ))) *
          brsTail (brsWeightMeasure 2) (fun s => ‖f₀ s‖) (u / 4) ^ (2 : ℕ) := by
    intro u hu
    have h := measure_brsRemTwoCent_gt_le (d := 2) (by norm_num) hf₀ hsupp hu
    refine le_trans h (le_of_eq ?_)
    norm_num
  have hmain := prop43_abstract_endpoint (d := 2) (by norm_num) hp
    (A := 8) (B := 4) (by norm_num) (by norm_num) hf₀.measurable
    (M := brsRemTwoCent (absProfile f₀)) (measurable_brsRemTwoCent
      (continuous_absProfile hf₀))
    (fun ρ => by
      rcases le_or_gt ρ 0 with hr | hr
      · rw [brsRemTwoCent_eq_zero_of_nonpos hr]
        exact ENNReal.zero_ne_top
      · exact brsRemTwoCent_ne_top hfbd hr)
    hlev
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hmain
  refine le_trans hmain (le_of_eq ?_)
  rw [hCst]

/-! ## The smoothed truncated kernel, away from the origin

`brsTruncKernel k` lives on `(0, 2^{-k}]`, so `h_k ∗ ψ (x)` only sees `ψ` on
`[x - 2^{-k}, x)`.  A bound for `ψ` there is enough. -/

theorem abs_brsTruncConvReal_le_far {k : ℕ} {ψ : ℝ → ℝ} {M0 M : ℝ}
    (hψ : Continuous ψ) (hbd0 : ∀ y : ℝ, |ψ y| ≤ M0) (_hM : 0 ≤ M) {x : ℝ}
    (hbd : ∀ y : ℝ, x - (2 : ℝ) ^ (-(k : ℝ)) ≤ y → y < x → |ψ y| ≤ M) :
    |brsTruncConvReal k ψ x| ≤ M * (2 * (2 : ℝ) ^ (-(k : ℝ) / 2)) := by
  have hKint : Integrable (fun y : ℝ => brsTruncKernel k (x - y)) volume :=
    (integrable_brsTruncKernel k).comp_sub_left x
  have hprod : Integrable (fun y : ℝ => brsTruncKernel k (x - y) * ψ y)
      volume :=
    hKint.mul_bdd hψ.aestronglyMeasurable
      (Filter.Eventually.of_forall fun y => by
        rw [Real.norm_eq_abs]
        exact hbd0 y)
  have hshift : (∫ y : ℝ, brsTruncKernel k (x - y)) =
      ∫ y : ℝ, brsTruncKernel k y :=
    integral_sub_left_eq_self (brsTruncKernel k) volume x
  have hbound : ∀ y : ℝ, ‖brsTruncKernel k (x - y) * ψ y‖ ≤
      brsTruncKernel k (x - y) * M := by
    intro y
    by_cases hy : x - y ∈ Ioc (0 : ℝ) ((2 : ℝ) ^ (-(k : ℝ)))
    · rw [Real.norm_eq_abs, abs_mul,
        abs_of_nonneg (brsTruncKernel_nonneg k (x - y))]
      refine mul_le_mul_of_nonneg_left ?_ (brsTruncKernel_nonneg k (x - y))
      exact hbd y (by linarith [hy.2]) (by linarith [hy.1])
    · have hzero : brsTruncKernel k (x - y) = 0 := by
        rw [brsTruncKernel, Set.indicator_of_notMem hy]
      rw [hzero, zero_mul, zero_mul, norm_zero]
  have hright : Integrable (fun y : ℝ => brsTruncKernel k (x - y) * M) volume :=
    hKint.mul_const M
  show |∫ y : ℝ, brsTruncKernel k (x - y) * ψ y| ≤ _
  rw [← Real.norm_eq_abs]
  refine le_trans (norm_integral_le_of_norm_le hright
    (Filter.Eventually.of_forall hbound)) (le_of_eq ?_)
  rw [integral_mul_const, hshift, integral_brsTruncKernel]
  ring

/-! ## Rescaling the radial `L^q` norm

`∫ F(a r)^q r dr = a^{-2} ∫ F(ρ)^q ρ dρ`, so composing with a dilation by
`a ≥ 1` never increases the radial norm. -/

theorem lintegral_scaled_weight {F : ℝ → ENNReal} (hF : Measurable F) {q a : ℝ}
    (ha : 0 < a) :
    (∫⁻ r : ℝ, F (a * r) ^ q * ENNReal.ofReal r) =
      ENNReal.ofReal (a⁻¹ * a⁻¹) * ∫⁻ ρ : ℝ, F ρ ^ q * ENNReal.ofReal ρ := by
  set G : ℝ → ENNReal := fun ρ => F ρ ^ q * ENNReal.ofReal (a⁻¹ * ρ) with hG
  have hGm : Measurable G := by
    rw [hG]
    exact (hF.pow_const q).mul
      (ENNReal.measurable_ofReal.comp (measurable_const_mul _))
  have hcomp : ∀ r : ℝ, G (a * r) = F (a * r) ^ q * ENNReal.ofReal r := by
    intro r
    rw [hG]
    simp only
    congr 2
    field_simp
  have h1 : (∫⁻ r : ℝ, F (a * r) ^ q * ENNReal.ofReal r) =
      ENNReal.ofReal |a⁻¹| * ∫⁻ ρ : ℝ, G ρ := by
    rw [← lintegral_comp_mul_left_ennreal hGm (ne_of_gt ha)]
    exact lintegral_congr fun r => (hcomp r).symm
  have h2 : (∫⁻ ρ : ℝ, G ρ) =
      ENNReal.ofReal a⁻¹ * ∫⁻ ρ : ℝ, F ρ ^ q * ENNReal.ofReal ρ := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    refine lintegral_congr fun ρ => ?_
    rw [hG]
    simp only
    rcases le_or_gt ρ 0 with hρ | hρ
    · rw [ENNReal.ofReal_eq_zero.mpr hρ,
        ENNReal.ofReal_eq_zero.mpr (by nlinarith [inv_pos.mpr ha] :
          a⁻¹ * ρ ≤ 0)]
      ring
    · rw [ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ a⁻¹)]
      ring
  rw [h1, h2, abs_of_nonneg (by positivity : (0 : ℝ) ≤ a⁻¹), ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ a⁻¹)]

theorem lintegral_scaled_weight_le {F : ℝ → ENNReal} (hF : Measurable F)
    {q a : ℝ} (ha : 1 ≤ a) :
    (∫⁻ r : ℝ, F (a * r) ^ q * ENNReal.ofReal r) ≤
      ∫⁻ ρ : ℝ, F ρ ^ q * ENNReal.ofReal ρ := by
  have ha0 : (0 : ℝ) < a := lt_of_lt_of_le zero_lt_one ha
  rw [lintegral_scaled_weight hF ha0]
  refine le_trans (mul_le_mul' (ENNReal.ofReal_le_one.mpr ?_) le_rfl) ?_
  · have h : a⁻¹ ≤ 1 := inv_le_one_of_one_le₀ ha
    nlinarith [inv_pos.mpr ha0]
  · rw [one_mul]

/-! ## The dilated Schwartz profile, away from the origin

`|p(w)| ≤ C_p / w²` gives `|p_j(y)| ≤ C_p 2^{-j} y^{-2}`, and `h_{kt} ∗ p_j`
only sees `p_j` on `[x - 2^{-kt}, x)`. -/

theorem abs_brsDilate_far {j : ℕ} {pf : ℝ → ℝ} {Cp : ℝ}
    (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp) {y ρ : ℝ} (hρ : 0 < ρ)
    (hy : ρ ≤ |y|) : |brsDilate pf j y| ≤ Cp / ((2 : ℝ) ^ j * ρ ^ 2) := by
  have h2j : (0 : ℝ) < (2 : ℝ) ^ j := by positivity
  have hy0 : (0 : ℝ) < |y| := lt_of_lt_of_le hρ hy
  have hw : ((2 : ℝ) ^ j * y) ^ 2 * |pf ((2 : ℝ) ^ j * y)| ≤ Cp :=
    hCp2 ((2 : ℝ) ^ j * y)
  have hsq : ((2 : ℝ) ^ j * y) ^ 2 = ((2 : ℝ) ^ j) ^ 2 * |y| ^ 2 := by
    rw [mul_pow, sq_abs]
  rw [hsq] at hw
  have habs : |brsDilate pf j y| = (2 : ℝ) ^ j * |pf ((2 : ℝ) ^ j * y)| := by
    rw [brsDilate, abs_mul, abs_of_nonneg (le_of_lt h2j)]
  rw [habs, le_div_iff₀ (by positivity : (0 : ℝ) < (2 : ℝ) ^ j * ρ ^ 2)]
  have hρy : ρ ^ 2 ≤ |y| ^ 2 := by nlinarith
  calc (2 : ℝ) ^ j * |pf ((2 : ℝ) ^ j * y)| * ((2 : ℝ) ^ j * ρ ^ 2)
      = ((2 : ℝ) ^ j) ^ 2 * ρ ^ 2 * |pf ((2 : ℝ) ^ j * y)| := by ring
    _ ≤ ((2 : ℝ) ^ j) ^ 2 * |y| ^ 2 * |pf ((2 : ℝ) ^ j * y)| := by
        refine mul_le_mul_of_nonneg_right ?_ (abs_nonneg _)
        exact mul_le_mul_of_nonneg_left hρy (by positivity)
    _ ≤ Cp := hw

/-- **The smoothed dilated profile, away from the origin.** -/
theorem abs_brsTruncConvReal_brsDilate_far {kt j : ℕ} {pf : ℝ → ℝ}
    (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    {x ρ : ℝ} (hρ : 0 < ρ) (hcut : (2 : ℝ) ^ (-(kt : ℝ)) ≤ ρ)
    (hx : 2 * ρ ≤ |x|) :
    |brsTruncConvReal kt (brsDilate pf j) x| ≤
      (Cp / ((2 : ℝ) ^ j * ρ ^ 2)) * (2 * (2 : ℝ) ^ (-(kt : ℝ) / 2)) := by
  refine abs_brsTruncConvReal_le_far (M0 := (2 : ℝ) ^ j * Cp)
    (continuous_brsDilate hpf j) (fun y => abs_brsDilate_le hCp0 j y)
    (by positivity) ?_
  intro y hy1 hy2
  refine abs_brsDilate_far hCp2 hρ ?_
  have hxy : |x - y| ≤ (2 : ℝ) ^ (-(kt : ℝ)) := by
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ x - y)]
    linarith
  have h1 : |x| - |y| ≤ |x - y| := abs_sub_abs_le_abs_sub x y
  linarith [le_trans hxy hcut]

/-! ## A kernel dominated by a series of indicators

If `|K|` is bounded by `Σ_n B_n 1_{[-ρ_n, ρ_n]}` then `K ∗ G` is bounded by the
corresponding series of interval averages of `G`. -/

theorem lintegral_Icc_enorm_eq {G : ℝ → ℂ} (hG : Continuous G) {a b : ℝ}
    (hab : a ≤ b) :
    (∫⁻ u in Icc a b, ‖G u‖ₑ) = ENNReal.ofReal (∫ u in a..b, ‖G u‖) := by
  have hint : IntegrableOn (fun u => ‖G u‖) (Icc a b) volume :=
    hG.norm.integrableOn_Icc
  rw [intervalIntegral.integral_of_le hab, ← integral_Icc_eq_integral_Ioc,
    ofReal_integral_eq_lintegral_ofReal hint
      (Filter.Eventually.of_forall fun u => norm_nonneg _)]
  exact lintegral_congr fun u => (ofReal_norm (G u)).symm

theorem lintegral_shift_indicator {G : ℝ → ℂ} (_hG : Continuous G) (x ρ : ℝ) :
    (∫⁻ y : ℝ, (Icc (-ρ) ρ).indicator (fun y : ℝ => ‖G (x + y)‖ₑ) y) =
      ∫⁻ u in Icc (x - ρ) (x + ρ), ‖G u‖ₑ := by
  have hrw : ∀ y : ℝ, (Icc (-ρ) ρ).indicator (fun y : ℝ => ‖G (x + y)‖ₑ) y =
      (Icc (x - ρ) (x + ρ)).indicator (fun u : ℝ => ‖G u‖ₑ) (x + y) := by
    intro y
    by_cases hy : y ∈ Icc (-ρ) ρ
    · rw [Set.indicator_of_mem hy,
        Set.indicator_of_mem (show x + y ∈ Icc (x - ρ) (x + ρ) from
          ⟨by linarith [hy.1], by linarith [hy.2]⟩)]
    · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem]
      intro hc
      exact hy ⟨by linarith [hc.1], by linarith [hc.2]⟩
  rw [lintegral_congr hrw,
    lintegral_add_left_eq_self
      ((Icc (x - ρ) (x + ρ)).indicator (fun u : ℝ => ‖G u‖ₑ)) x,
    lintegral_indicator measurableSet_Icc]

/-- **A kernel dominated by a series of indicators.** -/
theorem enorm_kernel_conv_le_tsum {K : ℝ → ℝ} {G : ℝ → ℂ} (hG : Continuous G)
    {B ρ : ℕ → ℝ} (hρ : ∀ n : ℕ, 0 ≤ ρ n)
    (hbound : ∀ y : ℝ, ‖K y‖ₑ ≤
      ∑' n : ℕ, ENNReal.ofReal (B n) *
        (Icc (-(ρ n)) (ρ n)).indicator (fun _ : ℝ => (1 : ENNReal)) y)
    (x : ℝ) :
    ‖∫ y : ℝ, ((K y : ℝ) : ℂ) * G (x + y)‖ₑ ≤
      ∑' n : ℕ, ENNReal.ofReal (B n) *
        ENNReal.ofReal (∫ u in (x - ρ n)..(x + ρ n), ‖G u‖) := by
  have hstep1 : ‖∫ y : ℝ, ((K y : ℝ) : ℂ) * G (x + y)‖ₑ ≤
      ∫⁻ y : ℝ, ‖K y‖ₑ * ‖G (x + y)‖ₑ := by
    refine le_trans (enorm_integral_le_lintegral_enorm _) (le_of_eq ?_)
    refine lintegral_congr fun y => ?_
    rw [enorm_mul]
    congr 1
    rw [← ofReal_norm, ← ofReal_norm, Complex.norm_real]
  have hstep2 : (∫⁻ y : ℝ, ‖K y‖ₑ * ‖G (x + y)‖ₑ) ≤
      ∫⁻ y : ℝ, ∑' n : ℕ, ENNReal.ofReal (B n) *
        (Icc (-(ρ n)) (ρ n)).indicator (fun y : ℝ => ‖G (x + y)‖ₑ) y := by
    refine lintegral_mono fun y => ?_
    have h := hbound y
    calc ‖K y‖ₑ * ‖G (x + y)‖ₑ
        ≤ (∑' n : ℕ, ENNReal.ofReal (B n) *
            (Icc (-(ρ n)) (ρ n)).indicator
              (fun _ : ℝ => (1 : ENNReal)) y) * ‖G (x + y)‖ₑ :=
          mul_le_mul' h le_rfl
      _ = ∑' n : ℕ, ENNReal.ofReal (B n) *
            (Icc (-(ρ n)) (ρ n)).indicator
              (fun y : ℝ => ‖G (x + y)‖ₑ) y := by
          rw [← ENNReal.tsum_mul_right]
          refine tsum_congr fun n => ?_
          by_cases hy : y ∈ Icc (-(ρ n)) (ρ n)
          · rw [Set.indicator_of_mem hy, Set.indicator_of_mem hy]
            ring
          · rw [Set.indicator_of_notMem hy, Set.indicator_of_notMem hy]
            ring
  have hmeas : ∀ n : ℕ, Measurable fun y : ℝ => ENNReal.ofReal (B n) *
      (Icc (-(ρ n)) (ρ n)).indicator (fun y : ℝ => ‖G (x + y)‖ₑ) y := by
    intro n
    refine measurable_const.mul ?_
    exact (((hG.comp (continuous_const.add continuous_id)).measurable.enorm
      ).indicator measurableSet_Icc)
  have hstep3 : (∫⁻ y : ℝ, ∑' n : ℕ, ENNReal.ofReal (B n) *
      (Icc (-(ρ n)) (ρ n)).indicator (fun y : ℝ => ‖G (x + y)‖ₑ) y) =
      ∑' n : ℕ, ENNReal.ofReal (B n) *
        ENNReal.ofReal (∫ u in (x - ρ n)..(x + ρ n), ‖G u‖) := by
    rw [lintegral_tsum fun n => (hmeas n).aemeasurable]
    refine tsum_congr fun n => ?_
    rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top,
      lintegral_shift_indicator hG x (ρ n),
      lintegral_Icc_enorm_eq hG (by linarith [hρ n])]
  exact le_trans hstep1 (le_trans hstep2 (le_of_eq hstep3))

/-! ## The low-frequency kernel, dominated by a series of indicators -/

/-- The dyadic bounds for `h_{k+1} ∗ p_{k+1+s}` on `|y| ≤ 2^{n+2} r`. -/
def brsLowKernelBound (k s : ℕ) (Cp r : ℝ) : ℕ → ℝ
  | 0 => (2 : ℝ) ^ (k + 1 + s) * Cp * (2 * (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2))
  | (n + 1) => Cp / ((2 : ℝ) ^ (k + 1 + s) * ((2 : ℝ) ^ (n + 1) * r) ^ 2) *
      (2 * (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2))

theorem brsLowKernelBound_nonneg {k s : ℕ} {Cp r : ℝ} (hCp : 0 ≤ Cp) (n : ℕ) :
    0 ≤ brsLowKernelBound k s Cp r n := by
  cases n with
  | zero =>
      rw [brsLowKernelBound]
      positivity
  | succ n =>
      rw [brsLowKernelBound]
      positivity

/-- **The low-frequency kernel is dominated by a series of indicators.** -/
theorem enorm_brsTruncConvReal_brsDilate_le_tsum {k s : ℕ} {pf : ℝ → ℝ}
    (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    {r : ℝ} (hr0 : 0 < r) (hcut : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r)
    (y : ℝ) :
    ‖brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y‖ₑ ≤
      ∑' n : ℕ, ENNReal.ofReal (brsLowKernelBound k s Cp r n) *
        (Icc (-((2 : ℝ) ^ (n + 2) * r)) ((2 : ℝ) ^ (n + 2) * r)).indicator
          (fun _ : ℝ => (1 : ENNReal)) y := by
  classical
  have hex : ∃ n : ℕ, |y| ≤ (2 : ℝ) ^ (n + 2) * r := by
    obtain ⟨n, hn⟩ :=
      pow_unbounded_of_one_lt (|y| / r) (by norm_num : (1 : ℝ) < 2)
    refine ⟨n, ?_⟩
    have h : |y| / r < (2 : ℝ) ^ n := hn
    rw [div_lt_iff₀ hr0] at h
    have h2 : (2 : ℝ) ^ n * r ≤ (2 : ℝ) ^ (n + 2) * r :=
      mul_le_mul_of_nonneg_right
        (pow_le_pow_right₀ (by norm_num) (by omega)) hr0.le
    linarith
  set M : ℕ := Nat.find hex with hM
  have hmem : |y| ≤ (2 : ℝ) ^ (M + 2) * r := Nat.find_spec hex
  have hbdm : |brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y| ≤
      brsLowKernelBound k s Cp r M := by
    by_cases hz : M = 0
    · rw [hz, brsLowKernelBound]
      exact abs_brsTruncConvReal_le (continuous_brsDilate hpf _)
        (fun z => abs_brsDilate_le hCp0 _ z) y
    · obtain ⟨n, hn⟩ := Nat.exists_eq_succ_of_ne_zero hz
      rw [hn, brsLowKernelBound]
      have hnot : ¬ (|y| ≤ (2 : ℝ) ^ (n + 2) * r) :=
        Nat.find_min hex (by rw [← hM, hn]; omega)
      have hgt : (2 : ℝ) ^ (n + 2) * r < |y| := lt_of_not_ge hnot
      have hone : (1 : ℝ) ≤ (2 : ℝ) ^ (n + 1) := one_le_pow₀ (by norm_num)
      have hρpos : (0 : ℝ) < (2 : ℝ) ^ (n + 1) * r := by positivity
      have hcut' : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ (n + 1) * r := by
        refine le_trans hcut ?_
        nlinarith
      have hx : 2 * ((2 : ℝ) ^ (n + 1) * r) ≤ |y| := by
        have : 2 * ((2 : ℝ) ^ (n + 1) * r) = (2 : ℝ) ^ (n + 2) * r := by
          rw [pow_succ]
          ring
        rw [this]
        exact hgt.le
      exact abs_brsTruncConvReal_brsDilate_far hpf hCppos hCp0 hCp2 hρpos
        hcut' hx
  refine le_trans ?_ (ENNReal.le_tsum M)
  rw [Set.indicator_of_mem (show y ∈ Icc (-((2 : ℝ) ^ (M + 2) * r))
      ((2 : ℝ) ^ (M + 2) * r) from abs_le.mp hmem), mul_one,
    ← ofReal_norm, Real.norm_eq_abs]
  exact ENNReal.ofReal_le_ofReal hbdm

/-! ## The dyadic constants of the low-frequency kernel -/

theorem brsLowKernel_const_zero {A w Cp T : ℝ} (hA : 0 < A) (hw : 0 < w)
    (hCp : 0 ≤ Cp) (hT : 0 < T) (hwA : w ≤ 2 * A) :
    w⁻¹ * ((A ^ 2)⁻¹ * T * Cp * (2 * A) * (4 * w ^ 2)) ≤ 16 * Cp * T := by
  have heq : w⁻¹ * ((A ^ 2)⁻¹ * T * Cp * (2 * A) * (4 * w ^ 2)) =
      8 * T * Cp * (w / A) := by
    field_simp
    ring
  rw [heq]
  have hdiv : w / A ≤ 2 := by
    rw [div_le_iff₀ hA]
    linarith
  calc 8 * T * Cp * (w / A) ≤ 8 * T * Cp * 2 :=
        mul_le_mul_of_nonneg_left hdiv (by positivity)
    _ = 16 * Cp * T := by ring

theorem brsLowKernel_const_succ {A w Cp T S : ℝ} (hA : 0 < A) (hw : 0 < w)
    (hCp : 0 ≤ Cp) (hT : 0 < T) (hS : 0 < S) (hAw : A ≤ w) :
    w⁻¹ * (Cp / ((A ^ 2)⁻¹ * T * (S * w ^ 2) ^ 2) * (2 * A) *
      (4 * S * w ^ 2)) ≤ 8 * Cp / (T * S) := by
  have heq : w⁻¹ * (Cp / ((A ^ 2)⁻¹ * T * (S * w ^ 2) ^ 2) * (2 * A) *
      (4 * S * w ^ 2)) = 8 * Cp / (T * S) * (A ^ 3 / w ^ 3) := by
    field_simp
    ring
  rw [heq]
  have hcube : A ^ 3 / w ^ 3 ≤ 1 := by
    rw [div_le_one (by positivity)]
    exact pow_le_pow_left₀ hA.le hAw 3
  calc 8 * Cp / (T * S) * (A ^ 3 / w ^ 3)
      ≤ 8 * Cp / (T * S) * 1 :=
        mul_le_mul_of_nonneg_left hcube (by positivity)
    _ = 8 * Cp / (T * S) := by ring

/-! ## The weighted dyadic constants -/

/-- **Each dyadic block contributes `≲ 2^{-n}`, uniformly in `k`.** -/
theorem brsLowKernelBound_mul_le {k s n : ℕ} {Cp r : ℝ} (hCppos : 0 < Cp)
    (hr0 : 0 < r) (hcut : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r)
    (hup : r ≤ 2 * (2 : ℝ) ^ (-(k : ℝ))) :
    r ^ (-(1 / 2) : ℝ) *
        (brsLowKernelBound k s Cp r n * ((2 : ℝ) ^ (n + 2) * r)) ≤
      16 * Cp * 2 ^ s / 2 ^ n := by
  set A : ℝ := (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ) / 2) with hAdef
  have hApos : (0 : ℝ) < A := Real.rpow_pos_of_pos (by norm_num) _
  have hA2 : A ^ 2 = (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) := by
    rw [hAdef, pow_two, ← Real.rpow_add (by norm_num : (0 : ℝ) < 2)]
    congr 1
    ring
  set w : ℝ := r ^ (1 / 2 : ℝ) with hwdef
  have hwpos : (0 : ℝ) < w := Real.rpow_pos_of_pos hr0 _
  have hw2 : w ^ 2 = r := by
    rw [hwdef, ← Real.rpow_natCast (r ^ (1 / 2 : ℝ)) 2, ← Real.rpow_mul hr0.le]
    norm_num
  have hrinv : r ^ (-(1 / 2) : ℝ) = w⁻¹ := by
    rw [hwdef, ← Real.rpow_neg hr0.le]
  have h2k : (2 : ℝ) ^ (-(k : ℝ)) = (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) * 2 := by
    rw [show (-(k : ℝ)) = -((k + 1 : ℕ) : ℝ) + 1 from by push_cast; ring,
      Real.rpow_add (by norm_num : (0 : ℝ) < 2), Real.rpow_one]
  have hr4 : r ≤ 4 * A ^ 2 := by
    rw [hA2]
    rw [h2k] at hup
    linarith
  have hAw : A ≤ w := by
    have h : A ^ 2 ≤ w ^ 2 := by rw [hA2, hw2]; exact hcut
    nlinarith
  have hwA : w ≤ 2 * A := by nlinarith
  have hPeq : (2 : ℝ) ^ (k + 1 + s) = (A ^ 2)⁻¹ * 2 ^ s := by
    rw [hA2, show ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)))⁻¹ = (2 : ℝ) ^ (k + 1) from by
      rw [← Real.rpow_natCast (2 : ℝ) (k + 1),
        ← Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), neg_neg], pow_add]
  have hTpos : (0 : ℝ) < (2 : ℝ) ^ s := by positivity
  have hTone : (1 : ℝ) ≤ (2 : ℝ) ^ s := one_le_pow₀ (by norm_num)
  rw [hrinv]
  cases n with
  | zero =>
      rw [brsLowKernelBound, hPeq]
      have hshape : (2 : ℝ) ^ (0 + 2) * r = 4 * w ^ 2 := by
        rw [hw2]
        norm_num
      rw [hshape]
      refine le_trans (brsLowKernel_const_zero hApos hwpos hCppos.le hTpos hwA)
        (le_of_eq ?_)
      rw [pow_zero, div_one]
  | succ m =>
      rw [brsLowKernelBound, hPeq]
      have hshape : (2 : ℝ) ^ (m + 1 + 2) * r = 4 * (2 : ℝ) ^ (m + 1) * w ^ 2 := by
        rw [hw2, pow_add, pow_add]
        ring
      have hshape2 : ((2 : ℝ) ^ (m + 1) * r) ^ 2 = ((2 : ℝ) ^ (m + 1) * w ^ 2) ^ 2 := by
        rw [hw2]
      rw [hshape, hshape2]
      have hSpos : (0 : ℝ) < (2 : ℝ) ^ (m + 1) := by positivity
      refine le_trans (brsLowKernel_const_succ hApos hwpos hCppos.le hTpos hSpos
        hAw) ?_
      rw [div_le_div_iff₀ (by positivity : (0:ℝ) < (2:ℝ)^s * (2:ℝ)^(m+1))
        (by positivity : (0:ℝ) < (2:ℝ)^(m+1))]
      have hS1 : (1 : ℝ) ≤ (2 : ℝ) ^ (m + 1) := one_le_pow₀ (by norm_num)
      calc 8 * Cp * (2 : ℝ) ^ (m + 1)
          ≤ 16 * Cp * (2 : ℝ) ^ (m + 1) * 1 := by nlinarith
        _ ≤ 16 * Cp * (2 : ℝ) ^ (m + 1) * ((2 : ℝ) ^ s * (2 : ℝ) ^ s) := by
            refine mul_le_mul_of_nonneg_left ?_ (by positivity)
            nlinarith
        _ = 16 * Cp * (2 : ℝ) ^ s * ((2 : ℝ) ^ s * (2 : ℝ) ^ (m + 1)) := by ring

/-! ## The `m = 0` piece, dominated by the centred averages

With a Schwartz profile the low-frequency kernel is no longer compactly
supported, but its dyadic tails are summable against the centred maximal
averages at the dilated scales `2^{n+2} r`. -/

/-- **The `m = 0` piece, dominated by the centred averages.** -/
theorem brsNearMaxP_low_le_tsum_cent {k s : ℕ} {pf : ℝ → ℝ}
    (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    {g : ℝ → ℂ} (hg : Continuous g) {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (r : ℝ) :
    brsNearMaxP k (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
  rw [brsNearMaxP]
  by_cases hr : r ∈ brsWindowExt k
  swap
  · rw [Set.indicator_of_notMem hr]
    exact zero_le
  rw [Set.indicator_of_mem hr]
  have hr0 : 0 < r := brsWindowExt_pos hr
  have hcut : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr
  have hup : r ≤ 2 * (2 : ℝ) ^ (-(k : ℝ)) := brsWindowExt_le_two_mul k hr
  have hρpos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ (n + 2) * r := fun n => by positivity
  have hper : ∀ t ∈ E ∩ Ici (3 * r / 2),
      ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ₑ ≤
      ∑' n : ℕ, ENNReal.ofReal (brsLowKernelBound k s Cp r n *
          ((2 : ℝ) ^ (n + 2) * r)) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
    intro t ht
    have htI : t ∈ Icc (1 : ℝ) 2 := hE ht.1
    have ht1 : (1 : ℝ) ≤ t := htI.1
    have ht2 : t ≤ 2 := htI.2
    have htr : 3 * r / 2 ≤ t := ht.2
    have hx : t - r ∈ Icc (1 / 3 : ℝ) 2 := ⟨by linarith, by linarith⟩
    have hrefl : ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ₑ =
        ‖∫ y : ℝ,
          ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
            g ((t - r) + y)‖ₑ := by
      congr 1
      show (∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (-(t - r) - y)) = _
      refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
      show ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
        g (-(-(t - r) - y)) = _
      congr 2
      ring
    rw [hrefl]
    refine le_trans (enorm_kernel_conv_le_tsum hg (fun n => (hρpos n).le)
      (fun y => enorm_brsTruncConvReal_brsDilate_le_tsum hpf hCppos hCp0 hCp2
        hr0 hcut y) (t - r)) ?_
    refine ENNReal.tsum_le_tsum fun n => ?_
    have hBnn : (0 : ℝ) ≤ brsLowKernelBound k s Cp r n :=
      brsLowKernelBound_nonneg hCppos.le n
    have hab : (t - r) - (2 : ℝ) ^ (n + 2) * r ≤
        (t - r) + (2 : ℝ) ^ (n + 2) * r := by linarith [hρpos n]
    have hRterm : ‖∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
          ((t - r) + (2 : ℝ) ^ (n + 2) * r), absProfile g u‖ =
        ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
          ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖ :=
      norm_intervalIntegral_ofReal_nonneg hab _ fun u _ => norm_nonneg _
    have hInn : (0 : ℝ) ≤ ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
        ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖ :=
      intervalIntegral.integral_nonneg hab fun u _ => norm_nonneg _
    have hle : ENNReal.ofReal (((2 : ℝ) ^ (n + 2) * r)⁻¹ *
          ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
            ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖) ≤
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
      rw [brsRemTwoCent]
      refine le_iSup_of_le (t - r) ?_
      rw [hRterm]
    calc ENNReal.ofReal (brsLowKernelBound k s Cp r n) *
          ENNReal.ofReal (∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
            ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖)
        = ENNReal.ofReal (brsLowKernelBound k s Cp r n *
              ((2 : ℝ) ^ (n + 2) * r)) *
            ENNReal.ofReal (((2 : ℝ) ^ (n + 2) * r)⁻¹ *
              ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
                ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖) := by
          rw [← ENNReal.ofReal_mul hBnn,
            ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤
              brsLowKernelBound k s Cp r n * ((2 : ℝ) ^ (n + 2) * r))]
          congr 1
          field_simp
      _ ≤ _ := mul_le_mul' le_rfl hle
  have hmax : brsNearPieceMax (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ∑' n : ℕ, ENNReal.ofReal (brsLowKernelBound k s Cp r n *
          ((2 : ℝ) ^ (n + 2) * r)) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
    rw [brsNearPieceMax]
    exact iSup₂_le hper
  refine le_trans (mul_le_mul' le_rfl hmax) ?_
  rw [← ENNReal.tsum_mul_left]
  refine ENNReal.tsum_le_tsum fun n => ?_
  rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr0.le _)]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal
    (brsLowKernelBound_mul_le hCppos hr0 hcut hup)) le_rfl

/-! ## The `m = 0` family at the endpoint

The dyadic tails are summed by Minkowski, and each rescaled copy costs nothing
because the radial norm decreases under dilation by a factor `≥ 1`. -/

theorem tsum_ofReal_two_pow_inv {c : ℝ} (hc : 0 ≤ c) :
    (∑' n : ℕ, ENNReal.ofReal (c / 2 ^ n)) = ENNReal.ofReal (2 * c) := by
  have hb : (-1 : ℝ) < 0 := by norm_num
  have hcong : ∀ n : ℕ, ENNReal.ofReal (c / 2 ^ n) =
      ENNReal.ofReal (c * (2 : ℝ) ^ ((-1 : ℝ) * (n : ℝ))) := by
    intro n
    congr 1
    rw [show (-1 : ℝ) * (n : ℝ) = -(n : ℝ) from by ring,
      Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), Real.rpow_natCast]
    field_simp
  rw [tsum_congr hcong, tsum_ofReal_geometric hc hb]
  congr 1
  rw [show ((2 : ℝ) ^ (-1 : ℝ)) = 1 / 2 from by
    rw [show (-1 : ℝ) = ((-1 : ℤ) : ℝ) from by norm_num, Real.rpow_intCast]
    norm_num]
  field_simp
  ring

/-- **The `m = 0` family at the endpoint.** -/
theorem endpoint_tsum_brsRemTwoCent {p : ℝ} (hp : 1 < p) {Cp : ℝ}
    (hCppos : 0 < Cp) (s : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ (g : ℝ → ℂ) (Cg : ℝ), Continuous g →
      (∀ z : ℝ, ‖g z‖ ≤ Cg) → (∀ z : ℝ, z < 1 / 4 → g z = 0) →
      (∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n) *
            brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ z : ℝ, ENNReal.ofReal z * ‖g z‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  obtain ⟨C0, hC0pos, hC0⟩ := prop43_brsRemTwoCent_endpoint hp
  refine ⟨32 * Cp * 2 ^ s * C0, by positivity, fun g Cg hg hgbd hsupp => ?_⟩
  set W : ℝ → ENNReal := brsRemTwoCent (absProfile g) with hW
  have hWmeas : Measurable W :=
    measurable_brsRemTwoCent (continuous_absProfile hg)
  set G : ℕ → ℝ → ENNReal := fun n r =>
    ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n) * W ((2 : ℝ) ^ (n + 2) * r) with hG
  have hGmeas : ∀ n : ℕ, Measurable (G n) := fun n =>
    measurable_const.mul (hWmeas.comp (measurable_const_mul _))
  set Z : ENNReal := ∫⁻ ρ : ℝ, W ρ ^ (2 * p) * ENNReal.ofReal ρ with hZ
  have hterm : ∀ n : ℕ,
      (∫⁻ r : ℝ, G n r ^ (2 * p) * ENNReal.ofReal r) ^ (1 / (2 * p)) ≤
        ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n) * Z ^ (1 / (2 * p)) := by
    intro n
    have hKpos : (0 : ℝ) < 16 * Cp * 2 ^ s / 2 ^ n := by positivity
    have h1 : (∫⁻ r : ℝ, G n r ^ (2 * p) * ENNReal.ofReal r) =
        ENNReal.ofReal ((16 * Cp * 2 ^ s / 2 ^ n) ^ (2 * p)) *
          ∫⁻ r : ℝ, ENNReal.ofReal r * W ((2 : ℝ) ^ (n + 2) * r) ^ (2 * p) :=
      lintegral_const_mul_rpow_weight hKpos hq0 _
    have h2 : (∫⁻ r : ℝ,
        ENNReal.ofReal r * W ((2 : ℝ) ^ (n + 2) * r) ^ (2 * p)) ≤ Z := by
      rw [hZ]
      refine le_trans (le_of_eq (lintegral_congr fun r => mul_comm _ _)) ?_
      exact lintegral_scaled_weight_le hWmeas
        (a := (2 : ℝ) ^ (n + 2)) (one_le_pow₀ (by norm_num))
    rw [h1]
    refine le_trans (ENNReal.rpow_le_rpow (mul_le_mul' le_rfl h2)
      (by positivity)) ?_
    rw [rpow_inv_const_mul hKpos hq0]
  refine le_trans (lintegral_radial_Lp_tsum_le hq1 hGmeas) ?_
  refine le_trans (ENNReal.tsum_le_tsum hterm) ?_
  rw [ENNReal.tsum_mul_right,
    show (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n)) =
      ENNReal.ofReal (2 * (16 * Cp * 2 ^ s)) from
      tsum_ofReal_two_pow_inv (by positivity)]
  have hZeq : Z = ∫⁻ ρ : ℝ, ENNReal.ofReal ρ * W ρ ^ (2 * p) := by
    rw [hZ]
    exact lintegral_congr fun ρ => mul_comm _ _
  rw [hZeq]
  refine le_trans (mul_le_mul' le_rfl (hC0 g Cg hg hgbd hsupp)) (le_of_eq ?_)
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤
    2 * (16 * Cp * 2 ^ s))]
  congr 2
  ring

/-! ## The `m = 0` piece, dominated by the centred averages

With a Schwartz profile the low-frequency kernel is no longer compactly
supported, but its dyadic tails are summable against the centred maximal
averages at the dilated scales `2^{n+2} r`. -/

/-- **The `m = 0` piece, dominated by the centred averages.** -/
theorem brsNearMax_low_le_tsum_cent {k s : ℕ} {pf : ℝ → ℝ}
    (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    {g : ℝ → ℂ} (hg : Continuous g) (E : Set ℝ) (r : ℝ) :
    brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ s / 2 ^ n) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
  rw [brsNearMax]
  by_cases hr : r ∈ brsWindowExt k
  swap
  · rw [Set.indicator_of_notMem hr]
    exact zero_le
  rw [Set.indicator_of_mem hr]
  have hr0 : 0 < r := brsWindowExt_pos hr
  have hcut : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r := brsCut_le_of_mem_windowExt hr
  have hup : r ≤ 2 * (2 : ℝ) ^ (-(k : ℝ)) := brsWindowExt_le_two_mul k hr
  have hρpos : ∀ n : ℕ, (0 : ℝ) < (2 : ℝ) ^ (n + 2) * r := fun n => by positivity
  have hper : ∀ t ∈ E,
      ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ₑ ≤
      ∑' n : ℕ, ENNReal.ofReal (brsLowKernelBound k s Cp r n *
          ((2 : ℝ) ^ (n + 2) * r)) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
    intro t _
    have hrefl : ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (z - y)) (t - r)‖ₑ =
        ‖∫ y : ℝ,
          ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
            g ((t - r) + y)‖ₑ := by
      congr 1
      show (∫ y : ℝ,
        ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
          brsRefl g (-(t - r) - y)) = _
      refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
      show ((brsTruncConvReal (k + 1) (brsDilate pf (k + 1 + s)) y : ℝ) : ℂ) *
        g (-(-(t - r) - y)) = _
      congr 2
      ring
    rw [hrefl]
    refine le_trans (enorm_kernel_conv_le_tsum hg (fun n => (hρpos n).le)
      (fun y => enorm_brsTruncConvReal_brsDilate_le_tsum hpf hCppos hCp0 hCp2
        hr0 hcut y) (t - r)) ?_
    refine ENNReal.tsum_le_tsum fun n => ?_
    have hBnn : (0 : ℝ) ≤ brsLowKernelBound k s Cp r n :=
      brsLowKernelBound_nonneg hCppos.le n
    have hab : (t - r) - (2 : ℝ) ^ (n + 2) * r ≤
        (t - r) + (2 : ℝ) ^ (n + 2) * r := by linarith [hρpos n]
    have hRterm : ‖∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
          ((t - r) + (2 : ℝ) ^ (n + 2) * r), absProfile g u‖ =
        ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
          ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖ :=
      norm_intervalIntegral_ofReal_nonneg hab _ fun u _ => norm_nonneg _
    have hInn : (0 : ℝ) ≤ ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
        ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖ :=
      intervalIntegral.integral_nonneg hab fun u _ => norm_nonneg _
    have hle : ENNReal.ofReal (((2 : ℝ) ^ (n + 2) * r)⁻¹ *
          ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
            ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖) ≤
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
      rw [brsRemTwoCent]
      refine le_iSup_of_le (t - r) ?_
      rw [hRterm]
    calc ENNReal.ofReal (brsLowKernelBound k s Cp r n) *
          ENNReal.ofReal (∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
            ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖)
        = ENNReal.ofReal (brsLowKernelBound k s Cp r n *
              ((2 : ℝ) ^ (n + 2) * r)) *
            ENNReal.ofReal (((2 : ℝ) ^ (n + 2) * r)⁻¹ *
              ∫ u in ((t - r) - (2 : ℝ) ^ (n + 2) * r)..
                ((t - r) + (2 : ℝ) ^ (n + 2) * r), ‖g u‖) := by
          rw [← ENNReal.ofReal_mul hBnn,
            ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤
              brsLowKernelBound k s Cp r n * ((2 : ℝ) ^ (n + 2) * r))]
          congr 1
          field_simp
      _ ≤ _ := mul_le_mul' le_rfl hle
  have hmax : brsNearFullMax (k + 1) (brsDilate pf (k + 1 + s)) g E r ≤
      ∑' n : ℕ, ENNReal.ofReal (brsLowKernelBound k s Cp r n *
          ((2 : ℝ) ^ (n + 2) * r)) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r) := by
    rw [brsNearFullMax]
    exact iSup₂_le hper
  refine le_trans (mul_le_mul' le_rfl hmax) ?_
  rw [← ENNReal.tsum_mul_left]
  refine ENNReal.tsum_le_tsum fun n => ?_
  rw [← mul_assoc, ← ENNReal.ofReal_mul (Real.rpow_nonneg hr0.le _)]
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal
    (brsLowKernelBound_mul_le hCppos hr0 hcut hup)) le_rfl

/-! ## `R₂^-` at the endpoint, as one family

Far part, `m = 0` near part and `m ≥ 1` near parts are assembled into a single
countable family of *measurable* functions dominating `R₂^-`, so that the
radial Minkowski inequality applies without any measurability question about
the maximal functions themselves. -/

/-- **`R₂^-` at the endpoint, split into the three families.** -/
theorem brsRemTwoTwoLeft_endpoint_family_le' {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    (hpfint : Integrable pf volume) (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ)
    (hυint : Integrable υ volume) {Mυ : ℝ} (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q) ^ (1 / q) ≤
      (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
            brsRemainderTwo (absProfile g) r) ^ q * ENNReal.ofReal r) ^ (1 / q) +
        ((∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
              brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r)) ^ q *
            ENNReal.ofReal r) ^ (1 / q) +
          ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
            brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
              (brsLPInput S (k + (4 + m)) g) E r ^ q *
                ENNReal.ofReal r) ^ (1 / q)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hidx : ∀ k m : ℕ, k + 1 + 3 + m = k + (4 + m) := by
    intro k m
    omega
  set B : ℕ → ℕ → ℝ → ENNReal := fun m k r =>
    brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
      (brsLPInput S (k + (4 + m)) g) E r with hB
  set H : ℕ → ℝ → ENNReal := fun m =>
    match m with
    | 0 => fun r => ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r
    | 1 => fun r => ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r)
    | (m + 2) => fun r => ∑' k : ℕ, B m k r with hH
  have hBmeas : ∀ m k : ℕ, Measurable (B m k) := by
    intro m k
    exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hυ _)
      (hasCompactSupport_brsDilate hυcs _)
      (continuous_brsLPInput S (k + (4 + m)) hg hgbd) E
  have hHmeas : ∀ m : ℕ, Measurable (H m) := by
    intro m
    match m with
    | 0 =>
        exact measurable_const.mul
          (measurable_brsRemainderTwo (continuous_absProfile hg))
    | 1 =>
        refine Measurable.ennreal_tsum fun n => ?_
        exact measurable_const.mul
          ((measurable_brsRemTwoCent (continuous_absProfile hg)).comp
            (measurable_const_mul _))
    | (m + 2) => exact Measurable.ennreal_tsum fun k => hBmeas m k
  -- the pointwise bound on the integrand
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoLeft E g r ^ q ≤
      (∑' m : ℕ, H m r) ^ q * ENNReal.ofReal r := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, mul_zero]
    have hsplit := brsRemTwoTwoLeft_le_window_sum hE hg hr
    have hfar : brsFarWindowSum E g r ≤ H 0 r :=
      brsFarWindowSum_le_brsRemainderTwo hE hg r
    have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
        H 1 r + ∑' m : ℕ, H (m + 2) r := by
      have hstep : ∀ k : ℕ, (brsWindowExt k).indicator
          (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
          brsNearMax k (k + 1) (brsDilate pf (k + 1 + 3)) g E r +
            ∑' m : ℕ, B m k r := by
        intro k
        have h := brsANearWindow_le_tsum_lp (E := E) k 3 hg hgbd hpf
          hpfint hCp0 hpfnorm hfac hυ.continuous hυint hυbd r
        refine le_trans h (le_of_eq ?_)
        congr 1
        refine tsum_congr fun m => ?_
        rw [hB, hidx k m]
      refine le_trans (ENNReal.tsum_le_tsum hstep) ?_
      rw [ENNReal.tsum_add]
      refine add_le_add ?_ (le_of_eq ENNReal.tsum_comm)
      refine tsum_window_le
        (A := fun k r => brsNearMax k (k + 1) (brsDilate pf (k + 1 + 3)) g E r)
        (V := fun r => ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
          brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r))
        (fun k r hr => brsNearMax_eq_zero_of_notMem hr) (fun k r => ?_) r
      exact brsNearMax_low_le_tsum_cent hpf hCppos hCp0 hCp2 hg E r
    have hle : brsRemTwoTwoLeft E g r ≤ ∑' m : ℕ, H m r := by
      refine le_trans hsplit ?_
      rw [ennreal_tsum_eq_zero_add (fun m : ℕ => H m r),
        ennreal_tsum_eq_zero_add (fun m : ℕ => H (m + 1) r)]
      rw [add_comm ((∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearLeftAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r))]
      exact add_le_add hfar hnear
    rw [mul_comm (ENNReal.ofReal r)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow hle hq0.le) le_rfl
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono hpt)
    (by positivity)) ?_
  refine le_trans (lintegral_radial_Lp_tsum_le hq hHmeas) (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H m r ^ q * ENNReal.ofReal r) ^ (1 / q)),
    ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H (m + 1) r ^ q * ENNReal.ofReal r) ^ (1 / q))]
  congr 1
  congr 1
  refine tsum_congr fun m => ?_
  congr 1
  exact lintegral_tsum_window_rpow
    (fun k r hr => brsNearMax_eq_zero_of_notMem hr) (fun k => hBmeas m k) hq0

/-! ## Proposition 5.4(i) at the endpoint `q = 2p`, left half

The three families are estimated separately — far part and `m = 0` near part by
the layer cake, `m ≥ 1` near parts by Littlewood--Paley — and the profile is
localized first so that all three land on the same weighted `L^p` norm. -/

/-- **Proposition 5.4(i) at the endpoint `q = 2p` for `R₂^-`.** -/
theorem prop54_brsRemTwoTwoLeft_endpoint_interior' {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    {pf : ℝ → ℝ} (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    (hpfint : Integrable pf volume) (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    (hυint : Integrable υ volume)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hAι : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p rr : ℝ} (hp : 1 < p) (hr : 1 < rr) (hrq : rr < 2 * p)
    (hrel : 1 / p + 1 / rr = 1 + 1 / (2 * p))
    (hgeom : (γ - (1 / rr - 1 / 2) * (2 * p)) / (2 * p) < 0)
    {A₀ : ENNReal} (hA₀top : A₀ ≠ ⊤)
    (hA₀ : ∀ (offset : ℕ) (h : ℝ → ℂ) (Ch : ℝ), Continuous h →
      (∀ z : ℝ, ‖h z‖ ≤ Ch) →
      (∑' k : ℕ, (∫⁻ x : ℝ, ‖∫ y : ℝ,
          (brsSchwartzDilate S (k + offset) : ℝ → ℂ) y * h (x - y)‖ₑ ^ p) ^
            (2 * p / p)) ≤
        A₀ * (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (2 * p / p))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoLeft E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
        C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set Y : ENNReal := (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) with hY
  -- localize
  set h : ℝ → ℂ := brsLocalize g with hh
  have hhc : Continuous h := continuous_brsLocalize hg
  have hhbd : ∀ z : ℝ, ‖h z‖ ≤ Cg := fun z => brsLocalize_bounded hgbd z
  have hloc : (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E g x ^ (2 * p)) =
      ∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoLeft E h x ^ (2 * p) := by
    refine lintegral_congr fun x => ?_
    rcases le_or_gt x 0 with hx | hx
    · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul, zero_mul]
    · rw [hh, brsRemTwoTwoLeft_brsLocalize hE g hx.le]
  have hhsupp : ∀ z : ℝ, z < 1 / 4 → h z = 0 := by
    intro z hz
    rw [hh]
    exact brsLocalize_eq_zero_of_notMem (fun hc => absurd hc.1 (by linarith))
  -- the three families
  have hfam := brsRemTwoTwoLeft_endpoint_family_le' hE hhc hhbd hpf hCppos hCp0
    hCp2 hpfint hpfnorm hfac hυ hcs hυint hbd hq1
  obtain ⟨C1, hC1pos, hC1⟩ := endpoint_const_mul_brsRemainderTwo hp
    (K := (2048 : ℝ) ^ (1 / 2 : ℝ)) (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨C2, hC2pos, hC2⟩ := endpoint_tsum_brsRemTwoCent hp hCppos 3
  obtain ⟨C3, hC3top, hC3⟩ := tsum_near_high_endpoint hE hυ hcs hR hυ' hcs' hR'
    hbd hAι hAnn hbd' hA' hA'nn hmom hmom' hhc hhbd hCγ hNloc hNbd hp hr hrq
    (by linarith : p < 2 * p) hrel (le_refl (2 * p)) hA₀top
    (fun offset => hA₀ offset (brsRefl h) Cg (continuous_brsRefl hhc)
      (fun z => brsRefl_bounded hhbd z)) hgeom
  -- the weighted and unweighted norms of the localized profile
  have hw : (∫⁻ s : ℝ, ENNReal.ofReal s * ‖h s‖ₑ ^ p) ^ (1 / p) ≤ Y := by
    rw [hY]
    exact ENNReal.rpow_le_rpow (lintegral_weighted_brsLocalize_le hp0)
      (by positivity)
  have hu : (∫⁻ z : ℝ, ‖h z‖ₑ ^ p) ^ (1 / p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsLocalize_le (g := g) hp0) (by positivity)) ?_
    rw [hY, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
  refine ⟨ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
    C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p))), ?_, ?_⟩
  · refine ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ?_⟩
    exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top,
      ENNReal.mul_ne_top hC3top ENNReal.ofReal_ne_top⟩
  · rw [hloc]
    refine le_trans hfam ?_
    have h1 : (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile h) r) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C1 * Y :=
      le_trans (hC1 h hhc) (mul_le_mul' le_rfl hw)
    have h2 : (∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
        brsRemTwoCent (absProfile h) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C2 * Y :=
      le_trans (hC2 h Cg hhc hhbd hhsupp) (mul_le_mul' le_rfl hw)
    have h3 : (∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
          (brsLPInput S (k + (4 + m)) h) E r ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p))) ≤
        C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
      refine le_trans hC3 ?_
      rw [mul_assoc]
      exact mul_le_mul' le_rfl hu
    calc (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
              brsRemainderTwo (absProfile h) r) ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p)) +
          ((∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
                brsRemTwoCent (absProfile h) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
              ENNReal.ofReal r) ^ (1 / (2 * p)) +
            ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
              brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
                (brsLPInput S (k + (4 + m)) h) E r ^ (2 * p) *
                  ENNReal.ofReal r) ^ (1 / (2 * p)))
        ≤ ENNReal.ofReal C1 * Y +
            (ENNReal.ofReal C2 * Y + C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y) :=
          add_le_add h1 (add_le_add h2 h3)
      _ = (ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
            C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)))) * Y := by ring

/-! ## Proposition 5.4(i) at the endpoint, with the data supplied

The Calderón factorization provides the profile, the compactly supported bump
with vanishing moments and the band-limited Schwartz factor; the exponent
relation forces `(1/r - 1/2)·2p = p - 1`, so the `m`-sum converges exactly when
`γ < p - 1`, i.e. `p > 1 + γ`. -/

/-- **Proposition 5.4(i) at the endpoint `q = 2p` for `R₂^-`.** -/
theorem prop54_brsRemTwoTwoLeft_endpoint {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (E ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p : ℝ} (hp : 1 < p) (hγ : γ < p - 1)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoLeft E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
        C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hppq : p < 2 * p := by linarith
  -- the Calderón factorization
  obtain ⟨pf, υ, S, Cp, hpfC, hpfint, hpfnorm, hCppos, hCp0, hCp2, hυC, hυcs,
    hυball, hmom, hmom', hSsupp, hfac⟩ := exists_brsCalderonFactorization 1
  have hpf : Continuous pf := hpfC.continuous
  have hυ : ContDiff ℝ 1 υ := hυC.of_le (by exact_mod_cast le_top)
  have hυC' : ContDiff ℝ (⊤ : ℕ∞) (deriv υ) := (contDiff_infty_iff_deriv.mp hυC).2
  have hυ' : ContDiff ℝ 1 (deriv υ) := hυC'.of_le (by exact_mod_cast le_top)
  have hcs' : HasCompactSupport (deriv υ) := hυcs.deriv
  have hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1 :=
    tsupport_deriv_subset.trans hυball
  have hυint : Integrable υ volume :=
    hυC.continuous.integrable_of_hasCompactSupport hυcs
  obtain ⟨Mu, hbd⟩ : ∃ M : ℝ, ∀ x : ℝ, |υ x| ≤ M := by
    obtain ⟨C, hC⟩ := hυcs.exists_bound_of_continuous hυC.continuous
    exact ⟨C, fun x => by simpa [Real.norm_eq_abs] using hC x⟩
  obtain ⟨Mu', hbd'⟩ : ∃ M : ℝ, ∀ x : ℝ, |deriv υ x| ≤ M := by
    obtain ⟨C, hC⟩ := hcs'.exists_bound_of_continuous hυC'.continuous
    exact ⟨C, fun x => by simpa [Real.norm_eq_abs] using hC x⟩
  have hAnn : (0 : ℝ) ≤ ∫ y : ℝ, |υ y| :=
    integral_nonneg fun y => abs_nonneg _
  have hA'nn : (0 : ℝ) ≤ ∫ y : ℝ, |deriv υ y| :=
    integral_nonneg fun y => abs_nonneg _
  -- the exponents
  obtain ⟨rr, hrr, hrrq, hrel, hrr2, hexp⟩ := brs_exponent_data hp hppq
  have hSq : (1 / rr - 1 / 2) * (2 * p) = p - 1 := by
    have hinv : 1 / rr = 1 + 1 / (2 * p) - 1 / p := by linarith
    rw [hinv]
    field_simp
    ring
  have hgeom : (γ - (1 / rr - 1 / 2) * (2 * p)) / (2 * p) < 0 := by
    rw [hSq]
    exact div_neg_of_neg_of_pos (by linarith) (by linarith)
  -- the Littlewood--Paley constant
  obtain ⟨CLP⟩ := Auto.LittlewoodPaley.exists_lpCutoffs 1
  obtain ⟨A₀, hA₀top, hA₀main⟩ :=
    tsum_lintegral_psiDilate_conv_le_bdd CLP hSsupp hp
      (by linarith : (2 : ℝ) ≤ 2 * p) (by linarith : p ≤ 2 * p)
  exact prop54_brsRemTwoTwoLeft_endpoint_interior' hE hpf hCppos hCp0 hCp2
    hpfint hpfnorm hfac hυ hυcs hυball hυ' hcs' hR' hυint hbd le_rfl hAnn hbd'
    le_rfl hA'nn hmom hmom' hCγ hNloc hNbd hp hrr hrrq hrel hgeom hA₀top
    (fun offset h Ch hhc hhbd => hA₀main offset h Ch hhc hhbd) hg hgbd

/-! ## The reflected resolution with the Littlewood--Paley factor

The inner step of `brsANearLeftAt_le_pieces_lp`, isolated so that the
right-endpoint half can use it on the reflected data. -/

theorem enorm_brsRefl_conv_le_pieces_lp (k s : ℕ) {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) (a : ℝ) :
    ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
        ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (z - y)) a‖ₑ ≤
      ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate pf (k + s)) y : ℝ) : ℂ) *
            brsRefl g (z - y)) a‖ₑ +
        ∑' m : ℕ, ‖brsRefl (fun z : ℝ => ∫ y : ℝ,
          ((brsTruncConvReal k (brsDilate υ (k + s + m)) y : ℝ) : ℂ) *
            brsRefl (brsLPInput S (k + s + m) g) (z - y)) a‖ₑ := by
  have hgrefl : Continuous (brsRefl g) := continuous_brsRefl hg
  have hgreflbd : ∀ z : ℝ, ‖brsRefl g z‖ ≤ Cg := fun z => brsRefl_bounded hgbd z
  set x : ℝ := -a with hx
  have hres := brs_resolution_truncConv_int k s hpf hpfint hpfnorm hgrefl
    hgreflbd (norm_brsTruncKernel_convolution_le k hgrefl hgreflbd) x
  have hlow : (∫ y : ℝ, (brsDilate pf (k + s) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate pf (k + s)) y : ℝ) : ℂ) *
        brsRefl g (x - y) :=
    brs_piece_eq_int k (continuous_brsDilate hpf (k + s))
      (integrable_brsDilate hpfint (k + s))
      (fun z => abs_brsDilate_le hpfbd (k + s) z) hgrefl hgreflbd x
  have hpiece : ∀ m : ℕ, (∫ y : ℝ, (brsLPKernel pf (k + s + m) y : ℂ) *
      (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
        ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) (x - y)) =
      ∫ y : ℝ, ((brsTruncConvReal k (brsDilate υ (k + s + m)) y : ℝ) : ℂ) *
        brsRefl (brsLPInput S (k + s + m) g) (x - y) := by
    intro m
    rw [brsRefl_brsLPInput]
    exact brs_piece_eq_lp k (k + s + m) hfac hυcont hυint hυbd hgrefl hgreflbd x
  rw [hlow] at hres
  simp only [hpiece] at hres
  have hlim : (brsTruncKernel k ⋆[(ContinuousLinearMap.lsmul ℝ ℝ :
      ℝ →L[ℝ] ℂ →L[ℝ] ℂ), volume] brsRefl g) x =
      ∫ y : ℝ, ((brsTruncKernel k y : ℝ) : ℂ) * brsRefl g (x - y) :=
    convolution_eq_integral x
  rw [hlim] at hres
  exact enorm_le_tsum_of_tendsto hres

/-- **The near part of `R_2^+`, decomposed with the Littlewood--Paley
factor.** -/
theorem brsANearRightAt_le_pieces_lp (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) {r : ℝ}
    (hcr : (2 : ℝ) ^ (-(k : ℝ)) ≤ r) :
    brsANearRightAt ((2 : ℝ) ^ (-(k : ℝ))) E g r ≤
      ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
        (brsNearFullMax k (brsDilate pf (k + s)) (fun w : ℝ => g (3 - w))
            ((fun x : ℝ => 3 - x) '' E) r +
          ∑' m : ℕ, brsNearFullMax k (brsDilate υ (k + s + m))
            (brsLPInput S (k + s + m) (fun w : ℝ => g (3 - w)))
            ((fun x : ℝ => 3 - x) '' E) r) := by
  have hc : (0 : ℝ) < (2 : ℝ) ^ (-(k : ℝ)) :=
    Real.rpow_pos_of_pos (by norm_num) _
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  rw [brsANearRightAt_eq hc hg hcr]
  refine mul_le_mul' le_rfl ?_
  refine iSup₂_le fun t ht => ?_
  have hmem : (3 - t) ∈ (fun x : ℝ => 3 - x) '' E := ⟨t, ht.1, rfl⟩
  refine le_trans (enorm_brsRefl_conv_le_pieces_lp k s hgt hgtbd hpf hpfint
    hpfbd hpfnorm hfac hυcont hυint hυbd (3 - t - r)) ?_
  refine add_le_add (le_iSup₂_of_le (3 - t) hmem le_rfl) ?_
  exact ENNReal.tsum_le_tsum fun m => le_iSup₂_of_le (3 - t) hmem le_rfl

/-- **The near part of `R_2^+` on `I_k`, with the Littlewood--Paley
factor.** -/
theorem brsANearRightWindow_le_tsum_lp (k s : ℕ) {E : Set ℝ} {g : ℝ → ℂ}
    (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) (hpfint : Integrable pf volume)
    {Mpf : ℝ} (hpfbd : ∀ x : ℝ, |pf x| ≤ Mpf)
    (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυcont : Continuous υ) (hυint : Integrable υ volume) {Mυ : ℝ}
    (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ) (r : ℝ) :
    (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
      brsNearMax k (k + 1) (brsDilate pf (k + 1 + s)) (fun w : ℝ => g (3 - w))
          ((fun x : ℝ => 3 - x) '' E) r +
        ∑' m : ℕ, brsNearMax k (k + 1) (brsDilate υ (k + 1 + s + m))
          (brsLPInput S (k + 1 + s + m) (fun w : ℝ => g (3 - w)))
          ((fun x : ℝ => 3 - x) '' E) r := by
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    have hcr : (2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ)) ≤ r :=
      brsCut_le_of_mem_windowExt hr
    refine le_trans (brsANearRightAt_le_pieces_lp (k + 1) s hg hgbd hpf hpfint
      hpfbd hpfnorm hfac hυcont hυint hυbd hcr) (le_of_eq ?_)
    rw [mul_add, ← ENNReal.tsum_mul_left]
    congr 1
    · rw [brsNearMax, Set.indicator_of_mem hr]
    · refine tsum_congr fun m => ?_
      rw [brsNearMax, Set.indicator_of_mem hr]
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-! ## The far part of `R₂^+` at an arbitrary cutoff -/

/-- **The far part of `R₂^+` at an arbitrary cutoff is dominated by `R₂`.** -/
theorem brsBFarRightAt_le_brsRemainderTwo {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {r c : ℝ} (hr : 0 < r)
    (hc : brsCutScale r ≤ c) :
    brsBFarRightAt c E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  have hcut : 0 < brsCutScale r := brsCutScale_pos hr
  have hcpos : 0 < c := lt_of_lt_of_le hcut hc
  rw [brsBFarRightAt]
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htr' : 3 * r / 2 ≤ t := htr
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have hab : t ≤ t + r := by linarith
  have hab2 : t - r ≤ t + r := by linarith
  have hRterm : ‖∫ s in (t - r)..(t + r), absProfile g s‖ =
      ∫ s in (t - r)..(t + r), ‖g s‖ :=
    norm_intervalIntegral_ofReal_nonneg hab2 _ fun s _ => norm_nonneg _
  have hlow : ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) ≤
      brsRemainderTwo (absProfile g) r := by
    refine le_iSup₂_of_le t ⟨htI, htr⟩ ?_
    rw [hRterm]
  have hHle : ∀ s ∈ Icc t (t + r),
      ENNReal.ofReal ‖(Iic (t + r - c)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ ≤
        ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ := by
    intro s hs
    by_cases hmem : s ≤ t + r - c
    · rw [Set.indicator_of_mem (show s ∈ Iic (t + r - c) from hmem),
        norm_mul, Complex.norm_real,
        Real.norm_of_nonneg (Real.rpow_nonneg (abs_nonneg _) _),
        ENNReal.ofReal_mul (Real.rpow_nonneg (abs_nonneg _) _), ofReal_norm]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      rw [abs_of_nonneg (by linarith [hs.2] : (0 : ℝ) ≤ t + r - s)]
      exact Real.rpow_le_rpow_of_nonpos hcpos (by linarith) (by norm_num)
    · rw [Set.indicator_of_notMem
        (show s ∉ Iic (t + r - c) from hmem)]
      simp
  have hupper := ofReal_norm_intervalIntegral_le_lintegral hab
    ((Iic (t + r - c)).indicator
      (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s))
    (fun s => ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) * ‖g s‖ₑ) hHle
  have hint : IntegrableOn (fun s => ‖g s‖) (Icc (t - r) (t + r)) volume :=
    hg.norm.integrableOn_Icc
  have heq : (∫⁻ s in Icc (t - r) (t + r), ‖g s‖ₑ) =
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [intervalIntegral.integral_of_le hab2, ← integral_Icc_eq_integral_Ioc,
      ofReal_integral_eq_lintegral_ofReal hint
        (Filter.Eventually.of_forall fun s => norm_nonneg _)]
    exact lintegral_congr fun s => (ofReal_norm (g s)).symm
  have hmass : (∫⁻ s in Icc t (t + r), ‖g s‖ₑ) ≤
      ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← heq]
    exact lintegral_mono_set (Icc_subset_Icc (by linarith) le_rfl)
  have hInn : (0 : ℝ) ≤ ∫ s in (t - r)..(t + r), ‖g s‖ :=
    intervalIntegral.integral_nonneg hab2 fun s _ => norm_nonneg _
  have hprod : ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
      (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg hcpos.le _),
      ← ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _),
      ← ENNReal.ofReal_mul (by positivity : (0 : ℝ) ≤ (2048 : ℝ) ^ (1 / 2 : ℝ))]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [← mul_assoc, ← mul_assoc]
    exact mul_le_mul_of_nonneg_right (cutScale_rpow_mul_le hr hc) hInn
  calc ENNReal.ofReal (r ^ (-(1 / 2) : ℝ) *
        ‖∫ s in t..(t + r), (Iic (t + r - c)).indicator
          (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖)
      = ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖∫ s in t..(t + r),
            (Iic (t + r - c)).indicator
              (fun s => ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s) s‖ :=
        ENNReal.ofReal_mul (Real.rpow_nonneg hr.le _)
    _ ≤ ENNReal.ofReal (r ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (c ^ (-(1 / 2) : ℝ)) *
            ENNReal.ofReal (∫ s in (t - r)..(t + r), ‖g s‖)) := by
        refine mul_le_mul' le_rfl (le_trans hupper ?_)
        rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
        exact mul_le_mul' le_rfl hmass
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          ENNReal.ofReal (r⁻¹ * ∫ s in (t - r)..(t + r), ‖g s‖) := hprod
    _ ≤ ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
          brsRemainderTwo (absProfile g) r := mul_le_mul' le_rfl hlow


/-- **The far window sum of `R₂^+` is dominated by `R₂`.** -/
theorem brsFarWindowSumRight_le_brsRemainderTwo {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {g : ℝ → ℂ} (hg : Continuous g) (r : ℝ) :
    brsFarWindowSumRight E g r ≤
      ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r := by
  rw [brsFarWindowSumRight]
  refine tsum_window_le
    (A := fun k r => (brsWindowExt k).indicator
      (brsBFarRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r)
    (V := fun r => ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
      brsRemainderTwo (absProfile g) r)
    (fun k r hr => Set.indicator_of_notMem hr _) (fun k r => ?_) r
  by_cases hr : r ∈ brsWindowExt k
  · rw [Set.indicator_of_mem hr]
    exact brsBFarRightAt_le_brsRemainderTwo hE hg (brsWindowExt_pos hr)
      (brsCutScale_le_window_cut hr)
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **(5.6) at the endpoint `q = 2p`, for the far window sum of `R₂^+`.** -/
theorem prop56_brsFarWindowSumRight_endpoint {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (hp : 1 < p) :
    ∃ C : ℝ, 0 < C ∧ ∀ g : ℝ → ℂ, Continuous g →
      (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ (2 * p)) ^
          (1 / (2 * p)) ≤
        ENNReal.ofReal C * (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  obtain ⟨C, hCpos, hbound⟩ :=
    prop43_brsRemainderTwo_endpoint (d := 2) (by norm_num) hp
  have hKpos : (0 : ℝ) < (2048 : ℝ) ^ (1 / 2 : ℝ) :=
    Real.rpow_pos_of_pos (by norm_num) _
  refine ⟨(2048 : ℝ) ^ (1 / 2 : ℝ) * C, by positivity, ?_⟩
  intro g hg
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set K : ℝ := (2048 : ℝ) ^ (1 / 2 : ℝ) with hK
  have hb := hbound g hg
  simp only [Nat.cast_ofNat, show (2 : ℕ) - 1 = 1 from rfl, pow_one,
    ofReal_norm, show p * (2 : ℝ) = 2 * p from mul_comm p 2] at hb
  have hdom : ∀ r : ℝ, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ (2 * p) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        (ENNReal.ofReal r * brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
    intro r
    have h := brsFarWindowSumRight_le_brsRemainderTwo hE hg r
    calc ENNReal.ofReal r * brsFarWindowSumRight E g r ^ (2 * p)
        ≤ ENNReal.ofReal r *
            (ENNReal.ofReal K * brsRemainderTwo (absProfile g) r) ^ (2 * p) :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h hq0.le)
      _ = ENNReal.ofReal (K ^ (2 * p)) *
            (ENNReal.ofReal r *
              brsRemainderTwo (absProfile g) r ^ (2 * p)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le,
            ENNReal.ofReal_rpow_of_pos hKpos]
          ring
  have hint : (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ (2 * p)) ≤
      ENNReal.ofReal (K ^ (2 * p)) *
        ∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p) := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hdom
  calc (∫⁻ r, ENNReal.ofReal r * brsFarWindowSumRight E g r ^ (2 * p)) ^
        (1 / (2 * p))
      ≤ (ENNReal.ofReal (K ^ (2 * p)) *
          ∫⁻ r, ENNReal.ofReal r *
            brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) :=
        ENNReal.rpow_le_rpow hint (by positivity)
    _ = ENNReal.ofReal K * (∫⁻ r, ENNReal.ofReal r *
          brsRemainderTwo (absProfile g) r ^ (2 * p)) ^ (1 / (2 * p)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _
            (by positivity : (0 : ℝ) ≤ 1 / (2 * p)),
          ENNReal.ofReal_rpow_of_pos (by positivity : (0 : ℝ) < K ^ (2 * p)),
          ← Real.rpow_mul hKpos.le,
          show 2 * p * (1 / (2 * p)) = 1 from by field_simp, Real.rpow_one]
    _ ≤ ENNReal.ofReal K *
          (ENNReal.ofReal C *
            (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p)) :=
        mul_le_mul' le_rfl hb
    _ = ENNReal.ofReal (K * C) *
          (∫⁻ s, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
        rw [ENNReal.ofReal_mul hKpos.le, mul_assoc]

/-! ## Reflecting the profile about `3/2`

The centred maximal average and the unweighted `L^p` norm are both invariant
under `s ↦ 3 - s`, so the right-endpoint half can be run on the reflected data
and the estimates read back on the original profile. -/

theorem brsRemTwoCent_three_sub (g : ℝ → ℂ) (ρ : ℝ) :
    brsRemTwoCent (absProfile (fun w : ℝ => g (3 - w))) ρ =
      brsRemTwoCent (absProfile g) ρ := by
  have key : ∀ x : ℝ,
      (∫ s in (x - ρ)..(x + ρ), absProfile (fun w : ℝ => g (3 - w)) s) =
        ∫ v in ((3 - x) - ρ)..((3 - x) + ρ), absProfile g v := by
    intro x
    have h1 : (∫ s in (x - ρ)..(x + ρ),
        absProfile (fun w : ℝ => g (3 - w)) s) =
        ∫ s in (x - ρ)..(x + ρ), absProfile g (3 - s) := rfl
    rw [h1, intervalIntegral.integral_comp_sub_left (fun v => absProfile g v) 3]
    congr 1 <;> ring
  refine le_antisymm ?_ ?_
  · rw [brsRemTwoCent]
    refine iSup_le fun x => ?_
    rw [key x, brsRemTwoCent]
    exact le_iSup (fun y : ℝ => ENNReal.ofReal (ρ⁻¹ *
      ‖∫ v in (y - ρ)..(y + ρ), absProfile g v‖)) (3 - x)
  · rw [brsRemTwoCent]
    refine iSup_le fun x => ?_
    rw [brsRemTwoCent]
    refine le_iSup_of_le (3 - x) ?_
    rw [key (3 - x), show (3 : ℝ) - (3 - x) = x from by ring]

theorem lintegral_enorm_rpow_three_sub {F : ℝ → ℂ} (hF : Measurable F) (p : ℝ) :
    (∫⁻ x : ℝ, ‖F (3 - x)‖ₑ ^ p) = ∫⁻ x : ℝ, ‖F x‖ₑ ^ p := by
  have h1 : (∫⁻ x : ℝ, ‖F (3 - x)‖ₑ ^ p) =
      ∫⁻ x : ℝ, ‖F (-(x - 3))‖ₑ ^ p := by
    refine lintegral_congr fun x => ?_
    congr 3
    ring
  rw [h1, lintegral_sub_right_eq_self (fun x : ℝ => ‖F (-x)‖ₑ ^ p) 3]
  exact lintegral_enorm_rpow_neg hF p

/-- **`R₂^+` does not see the localization.** -/
theorem brsRemTwoTwoRight_brsLocalize {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (g : ℝ → ℂ) {r : ℝ} (hr : 0 ≤ r) :
    brsRemTwoTwoRight E (brsLocalize g) r = brsRemTwoTwoRight E g r := by
  rw [brsRemTwoTwoRight, brsRemTwoTwoRight]
  refine iSup_congr fun t => ?_
  refine iSup_congr fun ht => ?_
  obtain ⟨htE, htr⟩ := ht
  have htI : t ∈ Icc (1 : ℝ) 2 := hE htE
  have ht1 : (1 : ℝ) ≤ t := htI.1
  have ht2 : t ≤ 2 := htI.2
  have htr' : 3 * r / 2 ≤ t := htr
  have hsub : ∀ s ∈ uIcc t (t + r), s ∈ Icc (1 / 3 : ℝ) (10 / 3) := by
    intro s hs
    rw [uIcc_of_le (by linarith)] at hs
    exact ⟨by linarith [hs.1], by linarith [hs.2]⟩
  have hInt : (∫ s in t..(t + r),
        ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * brsLocalize g s) =
      ∫ s in t..(t + r),
        ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s := by
    refine intervalIntegral.integral_congr fun s hs => ?_
    show ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * brsLocalize g s =
      ((|t + r - s| ^ (-(1 / 2) : ℝ) : ℝ) : ℂ) * g s
    rw [brsLocalize_eq_of_mem (hsub s hs)]
  rw [hInt]

/-! ## `R₂^+` at the endpoint, as one family

Far part, `m = 0` near part and `m ≥ 1` near parts are assembled into a single
countable family of *measurable* functions dominating `R₂^-`, so that the
radial Minkowski inequality applies without any measurability question about
the maximal functions themselves. -/

/-- **`R₂^+` at the endpoint, split into the three families.** -/
theorem brsRemTwoTwoRight_endpoint_family_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg)
    {pf : ℝ → ℝ} (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    (hpfint : Integrable pf volume) (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hυcs : HasCompactSupport υ)
    (hυint : Integrable υ volume) {Mυ : ℝ} (hυbd : ∀ z : ℝ, |υ z| ≤ Mυ)
    {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q) ^ (1 / q) ≤
      (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
            brsRemainderTwo (absProfile g) r) ^ q * ENNReal.ofReal r) ^ (1 / q) +
        ((∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
              brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r)) ^ q *
            ENNReal.ofReal r) ^ (1 / q) +
          ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
            brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
              (brsLPInput S (k + (4 + m)) (fun w : ℝ => g (3 - w)))
              ((fun x : ℝ => 3 - x) '' E) r ^ q *
                ENNReal.ofReal r) ^ (1 / q)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hidx : ∀ k m : ℕ, k + 1 + 3 + m = k + (4 + m) := by
    intro k m
    omega
  have hgt : Continuous fun w : ℝ => g (3 - w) :=
    hg.comp (continuous_const.sub continuous_id)
  have hgtbd : ∀ z : ℝ, ‖g (3 - z)‖ ≤ Cg := fun z => hgbd _
  set B : ℕ → ℕ → ℝ → ENNReal := fun m k r =>
    brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
      (brsLPInput S (k + (4 + m)) (fun w : ℝ => g (3 - w)))
      ((fun x : ℝ => 3 - x) '' E) r with hB
  set H : ℕ → ℝ → ENNReal := fun m =>
    match m with
    | 0 => fun r => ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile g) r
    | 1 => fun r => ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
        brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r)
    | (m + 2) => fun r => ∑' k : ℕ, B m k r with hH
  have hBmeas : ∀ m k : ℕ, Measurable (B m k) := by
    intro m k
    exact measurable_brsNearMax k (k + 1) (contDiff_brsDilate hυ _)
      (hasCompactSupport_brsDilate hυcs _)
      (continuous_brsLPInput S (k + (4 + m)) hgt hgtbd) _
  have hHmeas : ∀ m : ℕ, Measurable (H m) := by
    intro m
    match m with
    | 0 =>
        exact measurable_const.mul
          (measurable_brsRemainderTwo (continuous_absProfile hg))
    | 1 =>
        refine Measurable.ennreal_tsum fun n => ?_
        exact measurable_const.mul
          ((measurable_brsRemTwoCent (continuous_absProfile hg)).comp
            (measurable_const_mul _))
    | (m + 2) => exact Measurable.ennreal_tsum fun k => hBmeas m k
  -- the pointwise bound on the integrand
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsRemTwoTwoRight E g r ^ q ≤
      (∑' m : ℕ, H m r) ^ q * ENNReal.ofReal r := by
    intro r
    rcases le_or_gt r 0 with hr | hr
    · rw [ENNReal.ofReal_eq_zero.mpr hr, zero_mul, mul_zero]
    have hsplit := brsRemTwoTwoRight_le_window_sum hE hg hr
    have hfar : brsFarWindowSumRight E g r ≤ H 0 r :=
      brsFarWindowSumRight_le_brsRemainderTwo hE hg r
    have hnear : (∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r) ≤
        H 1 r + ∑' m : ℕ, H (m + 2) r := by
      have hstep : ∀ k : ℕ, (brsWindowExt k).indicator
          (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r ≤
          brsNearMax k (k + 1) (brsDilate pf (k + 1 + 3))
              (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r +
            ∑' m : ℕ, B m k r := by
        intro k
        have h := brsANearRightWindow_le_tsum_lp (E := E) k 3 hg hgbd hpf
          hpfint hCp0 hpfnorm hfac hυ.continuous hυint hυbd r
        refine le_trans h (le_of_eq ?_)
        congr 1
        refine tsum_congr fun m => ?_
        rw [hB, hidx k m]
      refine le_trans (ENNReal.tsum_le_tsum hstep) ?_
      rw [ENNReal.tsum_add]
      refine add_le_add ?_ (le_of_eq ENNReal.tsum_comm)
      refine tsum_window_le
        (A := fun k r => brsNearMax k (k + 1) (brsDilate pf (k + 1 + 3))
          (fun w : ℝ => g (3 - w)) ((fun x : ℝ => 3 - x) '' E) r)
        (V := fun r => ∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
          brsRemTwoCent (absProfile g) ((2 : ℝ) ^ (n + 2) * r))
        (fun k r hr => brsNearMax_eq_zero_of_notMem hr) (fun k r => ?_) r
      refine le_trans (brsNearMax_low_le_tsum_cent hpf hCppos hCp0 hCp2 hgt
        ((fun x : ℝ => 3 - x) '' E) r) (le_of_eq ?_)
      exact tsum_congr fun n => by rw [brsRemTwoCent_three_sub]
    have hle : brsRemTwoTwoRight E g r ≤ ∑' m : ℕ, H m r := by
      refine le_trans hsplit ?_
      rw [ennreal_tsum_eq_zero_add (fun m : ℕ => H m r),
        ennreal_tsum_eq_zero_add (fun m : ℕ => H (m + 1) r)]
      rw [add_comm ((∑' k : ℕ, (brsWindowExt k).indicator
        (brsANearRightAt ((2 : ℝ) ^ (-((k + 1 : ℕ) : ℝ))) E g) r))]
      exact add_le_add hfar hnear
    rw [mul_comm (ENNReal.ofReal r)]
    exact mul_le_mul' (ENNReal.rpow_le_rpow hle hq0.le) le_rfl
  refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono hpt)
    (by positivity)) ?_
  refine le_trans (lintegral_radial_Lp_tsum_le hq hHmeas) (le_of_eq ?_)
  rw [ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H m r ^ q * ENNReal.ofReal r) ^ (1 / q)),
    ennreal_tsum_eq_zero_add
      (fun m : ℕ => (∫⁻ r : ℝ, H (m + 1) r ^ q * ENNReal.ofReal r) ^ (1 / q))]
  congr 1
  congr 1
  refine tsum_congr fun m => ?_
  congr 1
  exact lintegral_tsum_window_rpow
    (fun k r hr => brsNearMax_eq_zero_of_notMem hr) (fun k => hBmeas m k) hq0

/-! ## Proposition 5.4(i) at the endpoint `q = 2p`, right half

The three families are estimated separately — far part and `m = 0` near part by
the layer cake, `m ≥ 1` near parts by Littlewood--Paley — and the profile is
localized first so that all three land on the same weighted `L^p` norm. -/

/-- **Proposition 5.4(i) at the endpoint `q = 2p` for `R₂^+`.** -/
theorem prop54_brsRemTwoTwoRight_endpoint_interior {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2)
    {pf : ℝ → ℝ} (hpf : Continuous pf) {Cp : ℝ} (hCppos : 0 < Cp)
    (hCp0 : ∀ x : ℝ, |pf x| ≤ Cp) (hCp2 : ∀ x : ℝ, x ^ 2 * |pf x| ≤ Cp)
    (hpfint : Integrable pf volume) (hpfnorm : (∫ x : ℝ, pf x) = 1)
    {υ : ℝ → ℝ} {S : SchwartzMap ℝ ℂ}
    (hfac : ((fun y : ℝ => (υ y : ℂ)) ⋆[ContinuousLinearMap.mul ℂ ℂ]
      (S : ℝ → ℂ)) = fun x : ℝ => ((brsLPKernel pf 0 x : ℝ) : ℂ))
    (hυ : ContDiff ℝ 1 υ) (hcs : HasCompactSupport υ)
    (hR : tsupport υ ⊆ Metric.closedBall 0 1)
    (hυ' : ContDiff ℝ 1 (deriv υ)) (hcs' : HasCompactSupport (deriv υ))
    (hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1)
    (hυint : Integrable υ volume)
    {Mu A Mu' A' : ℝ} (hbd : ∀ x : ℝ, |υ x| ≤ Mu) (hAι : (∫ y : ℝ, |υ y|) ≤ A)
    (hAnn : 0 ≤ A) (hbd' : ∀ x : ℝ, |deriv υ x| ≤ Mu')
    (hA' : (∫ y : ℝ, |deriv υ y|) ≤ A') (hA'nn : 0 ≤ A')
    {N : ℕ} (hmom : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * υ y) = 0)
    (hmom' : ∀ i : ℕ, i < N + 1 → (∫ y : ℝ, y ^ i * deriv υ y) = 0)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (((fun x : ℝ => 3 - x) '' E) ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p rr : ℝ} (hp : 1 < p) (hr : 1 < rr) (hrq : rr < 2 * p)
    (hrel : 1 / p + 1 / rr = 1 + 1 / (2 * p))
    (hgeom : (γ - (1 / rr - 1 / 2) * (2 * p)) / (2 * p) < 0)
    {A₀ : ENNReal} (hA₀top : A₀ ≠ ⊤)
    (hA₀ : ∀ (offset : ℕ) (h : ℝ → ℂ) (Ch : ℝ), Continuous h →
      (∀ z : ℝ, ‖h z‖ ≤ Ch) →
      (∑' k : ℕ, (∫⁻ x : ℝ, ‖∫ y : ℝ,
          (brsSchwartzDilate S (k + offset) : ℝ → ℂ) y * h (x - y)‖ₑ ^ p) ^
            (2 * p / p)) ≤
        A₀ * (∫⁻ x : ℝ, ‖h x‖ₑ ^ p) ^ (2 * p / p))
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoRight E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
        C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set Y : ENNReal := (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) with hY
  -- localize
  set h : ℝ → ℂ := brsLocalize g with hh
  have hhc : Continuous h := continuous_brsLocalize hg
  have hhbd : ∀ z : ℝ, ‖h z‖ ≤ Cg := fun z => brsLocalize_bounded hgbd z
  have hloc : (∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E g x ^ (2 * p)) =
      ∫⁻ x : ℝ, ENNReal.ofReal x * brsRemTwoTwoRight E h x ^ (2 * p) := by
    refine lintegral_congr fun x => ?_
    rcases le_or_gt x 0 with hx | hx
    · rw [ENNReal.ofReal_eq_zero.mpr hx, zero_mul, zero_mul]
    · rw [hh, brsRemTwoTwoRight_brsLocalize hE g hx.le]
  have hhsupp : ∀ z : ℝ, z < 1 / 4 → h z = 0 := by
    intro z hz
    rw [hh]
    exact brsLocalize_eq_zero_of_notMem (fun hc => absurd hc.1 (by linarith))
  -- the three families
  have hfam := brsRemTwoTwoRight_endpoint_family_le hE hhc hhbd hpf hCppos hCp0
    hCp2 hpfint hpfnorm hfac hυ hcs hυint hbd hq1
  have hht : Continuous fun w : ℝ => h (3 - w) :=
    hhc.comp (continuous_const.sub continuous_id)
  have hhtbd : ∀ z : ℝ, ‖h (3 - z)‖ ≤ Cg := fun z => hhbd _
  obtain ⟨C1, hC1pos, hC1⟩ := endpoint_const_mul_brsRemainderTwo hp
    (K := (2048 : ℝ) ^ (1 / 2 : ℝ)) (Real.rpow_pos_of_pos (by norm_num) _)
  obtain ⟨C2, hC2pos, hC2⟩ := endpoint_tsum_brsRemTwoCent hp hCppos 3
  obtain ⟨C3, hC3top, hC3⟩ := tsum_near_high_endpoint
    (image_three_sub_subset_Icc hE) hυ hcs hR hυ' hcs' hR'
    hbd hAι hAnn hbd' hA' hA'nn hmom hmom' hht hhtbd hCγ hNloc hNbd hp hr hrq
    (by linarith : p < 2 * p) hrel (le_refl (2 * p)) hA₀top
    (fun offset => hA₀ offset (brsRefl fun w : ℝ => h (3 - w)) Cg
      (continuous_brsRefl hht) (fun z => brsRefl_bounded hhtbd z)) hgeom
  rw [lintegral_enorm_rpow_three_sub hhc.measurable p] at hC3
  -- the weighted and unweighted norms of the localized profile
  have hw : (∫⁻ s : ℝ, ENNReal.ofReal s * ‖h s‖ₑ ^ p) ^ (1 / p) ≤ Y := by
    rw [hY]
    exact ENNReal.rpow_le_rpow (lintegral_weighted_brsLocalize_le hp0)
      (by positivity)
  have hu : (∫⁻ z : ℝ, ‖h z‖ₑ ^ p) ^ (1 / p) ≤
      ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
    refine le_trans (ENNReal.rpow_le_rpow
      (lintegral_enorm_brsLocalize_le (g := g) hp0) (by positivity)) ?_
    rw [hY, ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / p),
      ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 4)]
  refine ⟨ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
    C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p))), ?_, ?_⟩
  · refine ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ?_⟩
    exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top,
      ENNReal.mul_ne_top hC3top ENNReal.ofReal_ne_top⟩
  · rw [hloc]
    refine le_trans hfam ?_
    have h1 : (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
        brsRemainderTwo (absProfile h) r) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C1 * Y :=
      le_trans (hC1 h hhc) (mul_le_mul' le_rfl hw)
    have h2 : (∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
        brsRemTwoCent (absProfile h) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
          ENNReal.ofReal r) ^ (1 / (2 * p)) ≤ ENNReal.ofReal C2 * Y :=
      le_trans (hC2 h Cg hhc hhbd hhsupp) (mul_le_mul' le_rfl hw)
    have h3 : (∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
        brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
          (brsLPInput S (k + (4 + m)) (fun w : ℝ => h (3 - w)))
          ((fun x : ℝ => 3 - x) '' E) r ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p))) ≤
        C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y := by
      refine le_trans hC3 ?_
      rw [mul_assoc]
      exact mul_le_mul' le_rfl hu
    calc (∫⁻ r : ℝ, (ENNReal.ofReal ((2048 : ℝ) ^ (1 / 2 : ℝ)) *
              brsRemainderTwo (absProfile h) r) ^ (2 * p) *
            ENNReal.ofReal r) ^ (1 / (2 * p)) +
          ((∫⁻ r : ℝ, (∑' n : ℕ, ENNReal.ofReal (16 * Cp * 2 ^ 3 / 2 ^ n) *
                brsRemTwoCent (absProfile h) ((2 : ℝ) ^ (n + 2) * r)) ^ (2 * p) *
              ENNReal.ofReal r) ^ (1 / (2 * p)) +
            ∑' m : ℕ, (∑' k : ℕ, ∫⁻ r : ℝ,
              brsNearMax k (k + 1) (brsDilate υ (k + (4 + m)))
                (brsLPInput S (k + (4 + m)) (fun w : ℝ => h (3 - w)))
                ((fun x : ℝ => 3 - x) '' E) r ^ (2 * p) *
                  ENNReal.ofReal r) ^ (1 / (2 * p)))
        ≤ ENNReal.ofReal C1 * Y +
            (ENNReal.ofReal C2 * Y + C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)) * Y) :=
          add_le_add h1 (add_le_add h2 h3)
      _ = (ENNReal.ofReal C1 + (ENNReal.ofReal C2 +
            C3 * ENNReal.ofReal ((4 : ℝ) ^ (1 / p)))) * Y := by ring

/-! ## Proposition 5.4(i) at the endpoint for `R₂^+`, with the data supplied

The Calderón factorization provides the profile, the compactly supported bump
with vanishing moments and the band-limited Schwartz factor; the exponent
relation forces `(1/r - 1/2)·2p = p - 1`, so the `m`-sum converges exactly when
`γ < p - 1`, i.e. `p > 1 + γ`. -/

/-- **Proposition 5.4(i) at the endpoint `q = 2p` for `R₂^+`.** -/
theorem prop54_brsRemTwoTwoRight_endpoint {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {Cγ γ : ℝ} (hCγ : 0 ≤ Cγ) {Nloc : ℕ → ℕ}
    (hNloc : ∀ n k i : ℕ,
      intervalCoveringNumber (((fun x : ℝ => 3 - x) '' E) ∩ brsDilBlock k i)
        ((2 : ℝ) ^ (-((k + (4 + n) : ℕ) : ℝ))) ≤ Nloc n)
    (hNbd : ∀ n : ℕ, ((Nloc n : ℕ) : ENNReal) ≤
      ENNReal.ofReal (Cγ * (2 : ℝ) ^ (γ * ((4 + n : ℕ) : ℝ))))
    {p : ℝ} (hp : 1 < p) (hγ : γ < p - 1)
    {g : ℝ → ℂ} (hg : Continuous g) {Cg : ℝ} (hgbd : ∀ z : ℝ, ‖g z‖ ≤ Cg) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ x : ℝ, ENNReal.ofReal x *
          brsRemTwoTwoRight E g x ^ (2 * p)) ^ (1 / (2 * p)) ≤
        C * (∫⁻ s : ℝ, ENNReal.ofReal s * ‖g s‖ₑ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_trans zero_lt_one hp
  have hppq : p < 2 * p := by linarith
  -- the Calderón factorization
  obtain ⟨pf, υ, S, Cp, hpfC, hpfint, hpfnorm, hCppos, hCp0, hCp2, hυC, hυcs,
    hυball, hmom, hmom', hSsupp, hfac⟩ := exists_brsCalderonFactorization 1
  have hpf : Continuous pf := hpfC.continuous
  have hυ : ContDiff ℝ 1 υ := hυC.of_le (by exact_mod_cast le_top)
  have hυC' : ContDiff ℝ (⊤ : ℕ∞) (deriv υ) := (contDiff_infty_iff_deriv.mp hυC).2
  have hυ' : ContDiff ℝ 1 (deriv υ) := hυC'.of_le (by exact_mod_cast le_top)
  have hcs' : HasCompactSupport (deriv υ) := hυcs.deriv
  have hR' : tsupport (deriv υ) ⊆ Metric.closedBall 0 1 :=
    tsupport_deriv_subset.trans hυball
  have hυint : Integrable υ volume :=
    hυC.continuous.integrable_of_hasCompactSupport hυcs
  obtain ⟨Mu, hbd⟩ : ∃ M : ℝ, ∀ x : ℝ, |υ x| ≤ M := by
    obtain ⟨C, hC⟩ := hυcs.exists_bound_of_continuous hυC.continuous
    exact ⟨C, fun x => by simpa [Real.norm_eq_abs] using hC x⟩
  obtain ⟨Mu', hbd'⟩ : ∃ M : ℝ, ∀ x : ℝ, |deriv υ x| ≤ M := by
    obtain ⟨C, hC⟩ := hcs'.exists_bound_of_continuous hυC'.continuous
    exact ⟨C, fun x => by simpa [Real.norm_eq_abs] using hC x⟩
  have hAnn : (0 : ℝ) ≤ ∫ y : ℝ, |υ y| :=
    integral_nonneg fun y => abs_nonneg _
  have hA'nn : (0 : ℝ) ≤ ∫ y : ℝ, |deriv υ y| :=
    integral_nonneg fun y => abs_nonneg _
  -- the exponents
  obtain ⟨rr, hrr, hrrq, hrel, hrr2, hexp⟩ := brs_exponent_data hp hppq
  have hSq : (1 / rr - 1 / 2) * (2 * p) = p - 1 := by
    have hinv : 1 / rr = 1 + 1 / (2 * p) - 1 / p := by linarith
    rw [hinv]
    field_simp
    ring
  have hgeom : (γ - (1 / rr - 1 / 2) * (2 * p)) / (2 * p) < 0 := by
    rw [hSq]
    exact div_neg_of_neg_of_pos (by linarith) (by linarith)
  -- the Littlewood--Paley constant
  obtain ⟨CLP⟩ := Auto.LittlewoodPaley.exists_lpCutoffs 1
  obtain ⟨A₀, hA₀top, hA₀main⟩ :=
    tsum_lintegral_psiDilate_conv_le_bdd CLP hSsupp hp
      (by linarith : (2 : ℝ) ≤ 2 * p) (by linarith : p ≤ 2 * p)
  exact prop54_brsRemTwoTwoRight_endpoint_interior hE hpf hCppos hCp0 hCp2
    hpfint hpfnorm hfac hυ hυcs hυball hυ' hcs' hR' hυint hbd le_rfl hAnn hbd'
    le_rfl hA'nn hmom hmom' hCγ hNloc hNbd hp hrr hrrq hrel hgeom hA₀top
    (fun offset h Ch hhc hhbd => hA₀main offset h Ch hhc hhbd) hg hgbd

/-! ## The covering hypothesis at `p = 2`, with a scale-dependent constant

At `p = 2` the exponent `1 - 2/p + 1/q` of the covering hypothesis degenerates
to `1/q`, and a uniform constant no longer makes the sum over the outer index
converge — this is BRS's logarithmic loss.  The hypothesis that does work
lets the constant improve as the scale gets finer. -/

/-- `N(E, δ)^{1/q} ≤ A_j δ^{-1/q}` for every `δ ≲ 2^{-j}`. -/
def HasBRSCoveringSeq (E : Set ℝ) (q : ℝ) (A : ℕ → ℝ) : Prop :=
  ∀ (j : ℕ) (δ : ℝ), 0 < δ → δ ≤ 6 * (1 / 2 : ℝ) ^ j →
    (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) ≤
      ENNReal.ofReal (A j * δ ^ (-(1 / q)))

/-- **The Hölder arm at `p = 2`.** -/
theorem brs_holder_arm_le_two {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {q : ℝ} (hq0 : 0 < q) {A : ℕ → ℝ}
    (hcov : HasBRSCoveringSeq E q A) (n : ℕ) :
    volume (brsD E n) ^ (1 / q) ≤ ENNReal.ofReal ((7 : ℝ) ^ (1 / q) * A n) := by
  set σ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hσdef
  have hσ0 : 0 < σ := by rw [hσdef]; positivity
  have hσhalf : σ = (1 / 2 : ℝ) ^ n := by
    rw [hσdef, zpow_neg, zpow_natCast, one_div, inv_pow]
  have hσ6 : σ ≤ 6 * (1 / 2 : ℝ) ^ n := by
    rw [hσhalf]
    nlinarith [pow_pos (by norm_num : (0 : ℝ) < 1 / 2) n]
  have hvol := volume_brsD_le hE hEne n
  rw [← hσdef] at hvol
  refine le_trans (ENNReal.rpow_le_rpow hvol (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  refine le_trans (mul_le_mul' le_rfl (hcov n σ hσ0 hσ6)) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [Real.mul_rpow (by norm_num) hσ0.le]
  have hcancel : σ ^ (1 / q) * σ ^ (-(1 / q)) = 1 := by
    rw [← Real.rpow_add hσ0]
    norm_num
  calc (7 : ℝ) ^ (1 / q) * σ ^ (1 / q) * (A n * σ ^ (-(1 / q)))
      = (7 : ℝ) ^ (1 / q) * A n * (σ ^ (1 / q) * σ ^ (-(1 / q))) := by ring
    _ = (7 : ℝ) ^ (1 / q) * A n := by rw [hcancel, mul_one]

/-- **The covering arm at `p = 2`.** -/
theorem brs_cover_arm_le_two {E : Set ℝ} {q : ℝ} (_hq0 : 0 < q) {A : ℕ → ℝ}
    (hA0 : ∀ j : ℕ, 0 ≤ A j) (hcov : HasBRSCoveringSeq E q A) {Ablk : ℝ}
    (hAblk : 0 < Ablk) {j m : ℕ}
    (hu : Ablk * (1 / 2 : ℝ) ^ m ≤ 6 * (1 / 2 : ℝ) ^ j) :
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
        (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
      ((intervalCoveringNumber E (Ablk * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * (Ablk * (1 / 2) ^ m)) ^
          ((1 : ℝ) - 1 / 2 + 1 / q))) ≤
      ENNReal.ofReal ((2 : ℝ) ^ (5 / 2 + 1 / q) * A j) := by
  set u : ℝ := Ablk * (1 / 2 : ℝ) ^ m with hudef
  have hu0 : 0 < u := by rw [hudef]; positivity
  have hcv := hcov j u hu0 hu
  have hpow2 : ENNReal.ofReal (2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q) =
      ENNReal.ofReal ((2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q)) :=
    ENNReal.ofReal_rpow_of_pos (by positivity)
  have hnn₁ : (0 : ℝ) ≤ ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (Ablk / 2) ^ (-(1 / 2) : ℝ) :=
    mul_nonneg (Real.rpow_nonneg (by positivity) _)
      (Real.rpow_nonneg (by positivity) _)
  rw [hpow2]
  calc ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
        ((intervalCoveringNumber E u : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal ((2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q))))
      ≤ ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
          (ENNReal.ofReal (A j * u ^ (-(1 / q))) *
            (2 * ENNReal.ofReal ((2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q)))) :=
        mul_le_mul' le_rfl (mul_le_mul' hcv le_rfl)
    _ = ENNReal.ofReal ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
          (A j * u ^ (-(1 / q)) *
            (2 * (2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q)))) := by
        rw [show (2 : ENNReal) = ENNReal.ofReal 2 from by
          rw [ENNReal.ofReal_ofNat]]
        rw [← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul
            (mul_nonneg (hA0 j) (Real.rpow_nonneg hu0.le _)),
          ← ENNReal.ofReal_mul hnn₁]
    _ = ENNReal.ofReal ((2 : ℝ) ^ (5 / 2 + 1 / q) * A j) := by
        congr 1
        have hident := brs_arm_real_identity (A := Ablk) hAblk (p := 2) (q := q) m
        have hexp : (-(1 - 2 / (2 : ℝ) + 1 / q)) = -(1 / q) := by norm_num
        have hexp2 : ((1 : ℝ) - 1 / 2 + 1 / q) = 1 - 1 / (2 : ℝ) + 1 / q := by
          norm_num
        rw [hexp] at hident
        calc (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
              (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
              (A j * u ^ (-(1 / q)) *
                (2 * (2 * u) ^ ((1 : ℝ) - 1 / 2 + 1 / q)))
            = A j * ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (Ablk / 2) ^ (-(1 / (2 : ℝ)) : ℝ)) *
                (u ^ (-(1 / q)) *
                  (2 * (2 * u) ^ (1 - 1 / (2 : ℝ) + 1 / q)))) := by
              rw [hexp2]
              ring
          _ = A j * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
                (2 : ℝ) ^ (-((m : ℝ) * (1 / (2 : ℝ) - 1 / 2)))) := by
              rw [hudef] at *
              rw [hident]
          _ = (2 : ℝ) ^ (5 / 2 + 1 / q) * A j := by
              rw [show (-((m : ℝ) * (1 / (2 : ℝ) - 1 / 2))) = 0 from by ring,
                Real.rpow_zero]
              ring

/-! ## The shell estimate at `p = 2`

The two arms are both constant in the inner index `m`, so the `m`-sum is split
at `m = k`: the first `k+1` terms take the Hölder arm, the rest the covering
arm.  That is where BRS's factor `1 + ℓ` comes from. -/

theorem ennreal_tsum_split (f : ℕ → ENNReal) : ∀ k : ℕ,
    (∑' m : ℕ, f m) = (∑ m ∈ Finset.range k, f m) + ∑' m : ℕ, f (m + k) := by
  intro k
  induction k with
  | zero => simp
  | succ k ih =>
      rw [ih, ennreal_tsum_eq_zero_add (fun m : ℕ => f (m + k)),
        Finset.sum_range_succ]
      simp only [Nat.zero_add]
      rw [← add_assoc]
      congr 1
      refine tsum_congr fun m => ?_
      congr 1
      omega

/-- The constant of the `k`-th shell at `p = 2`. -/
def brsSeqBlockConst (q : ℝ) (A : ℕ → ℝ) (k : ℕ) : ENNReal :=
  ((k : ENNReal) + 1) * ENNReal.ofReal ((7 : ℝ) ^ (1 / q) * A k) +
    ENNReal.ofReal ((2 : ℝ) ^ (5 / 2 + 1 / q)) *
      ∑' j : ℕ, ENNReal.ofReal (A (k + 1 + j))

/-- **The shell estimate at `p = 2`.** -/
theorem lintegral_brsShellMaj_bound_two {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {q : ℝ} (hq2 : 2 ≤ q) {A : ℕ → ℝ}
    (hA0 : ∀ j : ℕ, 0 ≤ A j) (hAmono : Antitone A)
    (hcov : HasBRSCoveringSeq E q A) {g : ℝ → ℂ} (hg : Measurable g) (k i : ℕ) :
    (∫⁻ r : ℝ, brsShellMaj E 2 q g k i r ^ q) ^ (1 / q) ≤
      brsSeqBlockConst q A k *
        (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
          ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) := by
  have hq0 : (0 : ℝ) < q := by linarith
  set Ablk : ℝ := 2 * (1 / 2 : ℝ) ^ i with hAblk
  have hAblk0 : (0 : ℝ) < Ablk := by rw [hAblk]; positivity
  set GA : ENNReal := (∫⁻ s in Ioc (Ablk / 2) (2 * Ablk),
    ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) with hGA
  set T : ℕ → ENNReal := fun m =>
    min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ ((1 : ℝ) / 2 - 1 / 2) *
            (Ablk / 2) ^ ((1 : ℝ) - 2 / 2)) *
          volume (brsD E (k + i)) ^ (1 / q))
        (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (Ablk / 2) ^ (-(1 / 2) : ℝ)) *
          ((intervalCoveringNumber E (Ablk * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
            (2 * ENNReal.ofReal (2 * (Ablk * (1 / 2) ^ m)) ^
              ((1 : ℝ) - 1 / 2 + 1 / q)))) with hT
  have hstart : (∫⁻ r : ℝ, brsShellMaj E 2 q g k i r ^ q) ^ (1 / q) ≤
      (∑' m : ℕ, T m) * GA := by
    have h := lintegral_brsBlockMaj_rpow_le (E := E) hE (p := 2) (q := q)
      (by norm_num) (by norm_num) (by linarith) hg hAblk0 (k + i)
    have hSM : ∀ r : ℝ, brsShellMaj E 2 q g k i r =
        brsBlockMaj E 2 q g Ablk (k + i) r := fun r => rfl
    simp only [hSM]
    refine le_trans h (le_of_eq ?_)
    rw [hT, hGA, ENNReal.tsum_mul_right]
  refine le_trans hstart (mul_le_mul' ?_ ?_)
  swap
  · rw [hGA, hAblk, shell_window_eq i]
  -- the first arm is trivial at `p = 2`
  have hone : ∀ m : ℕ, ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^
      ((1 : ℝ) / 2 - 1 / 2) * (Ablk / 2) ^ ((1 : ℝ) - 2 / 2)) = 1 := by
    intro m
    rw [show ((1 : ℝ) / 2 - 1 / 2) = 0 from by norm_num,
      show ((1 : ℝ) - 2 / 2) = 0 from by norm_num, Real.rpow_zero,
      Real.rpow_zero, mul_one, ENNReal.ofReal_one]
  have harm1 : ∀ m : ℕ, T m ≤ ENNReal.ofReal ((7 : ℝ) ^ (1 / q) * A k) := by
    intro m
    refine le_trans (min_le_left _ _) ?_
    rw [hone m, one_mul]
    refine le_trans (brs_holder_arm_le_two hE hEne hq0 hcov (k + i)) ?_
    refine ENNReal.ofReal_le_ofReal ?_
    refine mul_le_mul_of_nonneg_left (hAmono (by omega)) ?_
    positivity
  have harm2 : ∀ m : ℕ, T m ≤
      ENNReal.ofReal ((2 : ℝ) ^ (5 / 2 + 1 / q)) *
        ENNReal.ofReal (A (i + m)) := by
    intro m
    refine le_trans (min_le_right _ _) ?_
    have hle : Ablk * (1 / 2 : ℝ) ^ m ≤ 6 * (1 / 2 : ℝ) ^ (i + m) := by
      rw [hAblk, pow_add]
      nlinarith [pow_pos (by norm_num : (0 : ℝ) < 1 / 2) i,
        pow_pos (by norm_num : (0 : ℝ) < 1 / 2) m]
    refine le_trans (brs_cover_arm_le_two hq0 hA0 hcov hAblk0 hle)
      (le_of_eq ?_)
    rw [← ENNReal.ofReal_mul (by positivity)]
  -- split the `m`-sum at `k`
  have hsplit : (∑' m : ℕ, T m) =
      (∑ m ∈ Finset.range (k + 1), T m) + ∑' m : ℕ, T (m + (k + 1)) :=
    ennreal_tsum_split T (k + 1)
  rw [hsplit, brsSeqBlockConst]
  refine add_le_add ?_ ?_
  · refine le_trans (Finset.sum_le_sum fun m _ => harm1 m) (le_of_eq ?_)
    rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
    congr 1
    push_cast
    ring
  · rw [← ENNReal.tsum_mul_left]
    refine ENNReal.tsum_le_tsum fun m => ?_
    refine le_trans (harm2 (m + (k + 1))) ?_
    refine mul_le_mul' le_rfl (ENNReal.ofReal_le_ofReal ?_)
    exact hAmono (by omega)

/-! ## The `(k, i)` sums at `p = 2` -/

/-- **The inner sum over the shells, at `p = 2`.** -/
theorem lintegral_tsum_brsShellMaj_bound_two {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq2 : 2 ≤ q)
    {A : ℕ → ℝ} (hA0 : ∀ j : ℕ, 0 ≤ A j) (hAmono : Antitone A)
    (hcov : HasBRSCoveringSeq E q A) {g : ℝ → ℂ} (hg : Measurable g) (k : ℕ) :
    (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E 2 q g k i r) ^ q) ^ (1 / q) ≤
      brsSeqBlockConst q A k *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^
          (1 / (2 : ℝ)) := by
  have hq0 : (0 : ℝ) < q := by linarith
  set K : ENNReal := brsSeqBlockConst q A k with hK
  set GA : ℕ → ENNReal := fun i =>
    (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
      ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (1 / (2 : ℝ)) with hGA
  have hdisj : (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E 2 q g k i r) ^ q) =
      ∑' i : ℕ, ∫⁻ r : ℝ, brsShellMaj E 2 q g k i r ^ q :=
    lintegral_rpow_tsum_disjoint (fun i => measurableSet_brsD E (k + i))
      (brsD_shift_disjoint E k) (fun i => measurable_brsShellMaj E 2 q hg k i)
      (fun i r hr => brsShellMaj_eq_zero_of_notMem hr) hq0
  rw [hdisj]
  have hterm : ∀ i : ℕ, (∫⁻ r : ℝ, brsShellMaj E 2 q g k i r ^ q) ≤
      K ^ q * GA i ^ q := by
    intro i
    have h := lintegral_brsShellMaj_bound_two hE hEne hq2 hA0 hAmono hcov hg k i
    have h' := ENNReal.rpow_le_rpow h hq0.le
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at h'
    refine le_trans h' (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, hK, hGA]
  refine le_trans (ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum hterm)
    (by positivity : (0 : ℝ) ≤ 1 / q)) ?_
  rw [ENNReal.tsum_mul_left]
  have hsq : ∀ i : ℕ, GA i ^ q =
      (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
        ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (q / 2) := by
    intro i
    rw [hGA, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hoverlap : (∑' i : ℕ, GA i ^ q) ≤
      (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (q / 2) := by
    have hqp : (1 : ℝ) ≤ q / 2 := by
      rw [le_div_iff₀ (by norm_num : (0 : ℝ) < 2)]
      linarith
    calc (∑' i : ℕ, GA i ^ q)
        = ∑' i : ℕ, (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (q / 2) := tsum_congr hsq
      _ ≤ (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (q / 2) := tsum_rpow_le_rpow_tsum hqp
      _ ≤ (ENNReal.ofReal 2 * ∫⁻ s : ℝ,
            ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^ (q / 2) := by
          refine ENNReal.rpow_le_rpow ?_ (by positivity)
          have h := tsum_lintegral_block_windows_le
            (h := fun s => ENNReal.ofReal ‖g s‖ ^ (2 : ℝ))
          rw [show ((2 : ENNReal)) = ENNReal.ofReal 2 from by
            rw [ENNReal.ofReal_ofNat]] at h
          exact h
  refine le_trans (ENNReal.rpow_le_rpow (mul_le_mul' le_rfl hoverlap)
    (by positivity : (0 : ℝ) ≤ 1 / q)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
    ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
  congr 1
  · rw [mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
  · congr 1
    field_simp

/-- **The total double sum at `p = 2`.** -/
theorem lintegral_tsum_shellMaj_total_two {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {q : ℝ} (hq2 : 2 ≤ q) {A : ℕ → ℝ}
    (hA0 : ∀ j : ℕ, 0 ≤ A j) (hAmono : Antitone A)
    (hcov : HasBRSCoveringSeq E q A) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, (∑' k : ℕ, ∑' i : ℕ, brsShellMaj E 2 q g k i r) ^ q) ^ (1 / q) ≤
      (∑' k : ℕ, brsSeqBlockConst q A k) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^
          (1 / (2 : ℝ)) := by
  have hq1 : (1 : ℝ) ≤ q := by linarith
  set Gk : ℕ → ℝ → ENNReal := fun k r => ∑' i : ℕ, brsShellMaj E 2 q g k i r
    with hGk
  have hGkmeas : ∀ k : ℕ, Measurable (Gk k) := by
    intro k
    exact Measurable.tsum fun i => measurable_brsShellMaj E 2 q hg k i
  have hstep : (∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q)) ≤
      (∑' k : ℕ, brsSeqBlockConst q A k) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ (2 : ℝ)) ^
          (1 / (2 : ℝ)) := by
    rw [← ENNReal.tsum_mul_right]
    refine ENNReal.tsum_le_tsum fun k => ?_
    rw [hGk]
    exact lintegral_tsum_brsShellMaj_bound_two hE hEne hq2 hA0 hAmono hcov hg k
  exact le_trans (lintegral_rpow_tsum_le hq1 hGkmeas) hstep

/-! ## The endpoint shell decomposition, for an arbitrary majorant

The Proposition 4.6 chain uses only three facts about the operator: that it
vanishes off `U_0`, and the two pointwise bounds on `D_0` and on `Ω_ℓ`.  Stating
those steps for an arbitrary `F` lets the same argument serve `𝔐_{p,∞}^±`. -/

theorem lintegral_le_brsD_zero_add_tsum_brsOmega_of_maj {E : Set ℝ}
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {F : ℝ → ENNReal}
    (hzero : ∀ r : ℝ, r ∉ brsU E 0 → F r = 0) :
    (∫⁻ r : ℝ, F r) ≤
      (∫⁻ r in brsD E 0, F r) + ∑' l : ℕ, ∫⁻ r in brsOmega E l, F r := by
  have hcover : brsU E 0 ⊆ (brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l) ∪ closure E := by
    intro r hr
    by_cases hmem : r ∈ ⋃ n : ℕ, brsD E n
    · obtain ⟨n, hrn⟩ := Set.mem_iUnion.mp hmem
      refine Or.inl ?_
      rcases Nat.eq_zero_or_pos n with hn | hn
      · exact Or.inl (hn ▸ hrn)
      · obtain ⟨l, hl, hnl⟩ := exists_grouped_shell hn
        refine Or.inr (Set.mem_iUnion.mpr ⟨l, ?_⟩)
        rw [brsOmega]
        exact Set.mem_iUnion₂.mpr ⟨n, hnl, hrn⟩
    · refine Or.inr ?_
      have hd0 := infDist_eq_zero_of_notMem_iUnion_brsD hr hmem
      rwa [← Metric.mem_closure_iff_infDist_zero hEne] at hd0
  calc (∫⁻ r : ℝ, F r) = ∫⁻ r in brsU E 0, F r := by
        rw [← lintegral_indicator (measurableSet_brsU E 0)]
        refine lintegral_congr fun r => ?_
        by_cases hr : r ∈ brsU E 0
        · rw [Set.indicator_of_mem hr]
        · rw [Set.indicator_of_notMem hr, hzero r hr]
    _ ≤ ∫⁻ r in (brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l) ∪ closure E, F r :=
        lintegral_mono_set hcover
    _ ≤ (∫⁻ r in brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l, F r) +
          ∫⁻ r in closure E, F r := lintegral_union_le _ _ _
    _ = ∫⁻ r in brsD E 0 ∪ ⋃ l : ℕ, brsOmega E l, F r := by
        rw [setLIntegral_measure_zero _ _ hEnull, add_zero]
    _ ≤ (∫⁻ r in brsD E 0, F r) + ∫⁻ r in ⋃ l : ℕ, brsOmega E l, F r :=
        lintegral_union_le _ _ _
    _ ≤ (∫⁻ r in brsD E 0, F r) + ∑' l : ℕ, ∫⁻ r in brsOmega E l, F r :=
        add_le_add le_rfl (lintegral_iUnion_le _ _)

theorem lintegral_brsD_zero_le_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q)
    {F : ℝ → ENNReal} {W : ENNReal} (hmaj : ∀ r ∈ brsD E 0, F r ≤ W) :
    (∫⁻ r in brsD E 0, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * ENNReal.ofReal 7 := by
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q with hK
  have hpoint : ∀ r ∈ brsD E 0,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q ≤ K := by
    intro r hr
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hr.1
    rw [hK]
    exact mul_le_mul' hweight (ENNReal.rpow_le_rpow (hmaj r hr) hq.le)
  calc (∫⁻ r in brsD E 0, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
      ≤ ∫⁻ _r in brsD E 0, K :=
        setLIntegral_mono' (measurableSet_brsD E 0) hpoint
    _ = K * volume (brsD E 0) := setLIntegral_const _ _
    _ ≤ K * ENNReal.ofReal 7 := by
        refine mul_le_mul' le_rfl ?_
        refine le_trans (measure_mono ?_) (volume_brsU_zero_le hE hEne)
        exact fun r hr => hr.1
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * ENNReal.ofReal 7 := by rw [hK]

theorem lintegral_brsOmega_le_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q : ℝ} (hq : 0 < q)
    {l : ℕ} (hl : 1 ≤ l) {F : ℝ → ENNReal} {W : ENNReal}
    (hmaj : ∀ r ∈ brsOmega E l, F r ≤ W) :
    (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * volume (brsOmega E l) := by
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q with hK
  have hpoint : ∀ r ∈ brsOmega E l,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 :=
      brsU_subset_of_le E (Nat.zero_le (2 ^ (l - 1))) (brsOmega_subset_brsU hl hr)
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    rw [hK]
    exact mul_le_mul' hweight (ENNReal.rpow_le_rpow (hmaj r hr) hq.le)
  calc (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
      ≤ ∫⁻ _r in brsOmega E l, K :=
        setLIntegral_mono' (measurableSet_brsOmega E l) hpoint
    _ = K * volume (brsOmega E l) := setLIntegral_const _ _
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * W ^ q * volume (brsOmega E l) := by
        rw [hK]

/-! ## The Proposition 4.6 chain, for an arbitrary majorant -/

theorem tsum_brsOmega_le_of_maj {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {q B : ℝ} (hq : 1 ≤ q)
    (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ)))))
    (g : ℝ → ℂ) {F : ℝ → ENNReal}
    (hFO : ∀ l : ℕ, 1 ≤ l → ∀ r ∈ brsOmega E l, F r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ((∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) :
    (∑' l : ℕ, ∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        F r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
        (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
              ((Real.log 2) ^ (1 / (d : ℝ)) /
                ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
              ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
            (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
              (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
            (∑' m : ℕ, brsLogBlockNorm d g m ^ q) +
          ENNReal.ofReal 7 *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  set A : ENNReal := ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) with hA
  set T : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
    ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g with hT
  set S : ℕ → ENNReal := fun l =>
    ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m with hS
  set D : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * A ^ q * 2 ^ q with hD
  set cst : ℝ := 7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
    ((Real.log 2) ^ (1 / (d : ℝ)) / ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
    ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q with hcst
  set M : ENNReal := ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
    ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) * (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹
    with hM
  set z : ENNReal := ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ with hz
  -- the per-shell bound, split into the block sum and the top piece
  have hper : ∀ l : ℕ,
      (∫⁻ r in brsOmega E l, ENNReal.ofReal r ^ (d - 1) *
        F r ^ q) ≤
        D * (S l ^ q * volume (brsOmega E l) + T ^ q * volume (brsOmega E l)) := by
    intro l
    rcases Nat.eq_zero_or_pos l with hl | hl
    · rw [hl, brsOmega_zero]
      simp
    · refine le_trans (lintegral_brsOmega_le_of_maj hE hEne hq0 hl
        (hFO l hl)) ?_
      have h1 : (A * (S l + T)) ^ q ≤ A ^ q * (2 ^ q * (S l ^ q + T ^ q)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ennreal_rpow_add_le hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) * (A * (S l + T)) ^ q *
            volume (brsOmega E l)
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              (A ^ q * (2 ^ q * (S l ^ q + T ^ q))) * volume (brsOmega E l) :=
            mul_le_mul' (mul_le_mul' le_rfl h1) le_rfl
        _ = D * (S l ^ q * volume (brsOmega E l) +
              T ^ q * volume (brsOmega E l)) := by
            rw [hD]
            ring
  refine le_trans (ENNReal.tsum_le_tsum hper) ?_
  rw [ENNReal.tsum_mul_left, hD]
  refine mul_le_mul' le_rfl ?_
  rw [ENNReal.tsum_add]
  refine add_le_add ?_ ?_
  · -- the block sums
    have hshell : ∀ l : ℕ, S l ^ q * volume (brsOmega E l) ≤
        ENNReal.ofReal cst *
          (z ^ l * (∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q)) := by
      intro l
      rcases Nat.eq_zero_or_pos l with hl | hl
      · rw [hl, brsOmega_zero]
        simp
      · refine le_trans (logShell_term_le hd hE hEne hq hB hcov g hl) (le_of_eq ?_)
        rw [hcst, hz]
        ring
    refine le_trans (ENNReal.tsum_le_tsum hshell) ?_
    rw [ENNReal.tsum_mul_left]
    calc ENNReal.ofReal cst *
          (∑' l : ℕ, z ^ l *
            ∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m ^ q)
        ≤ ENNReal.ofReal cst * (M * ∑' m : ℕ, brsLogBlockNorm d g m ^ q) := by
          refine mul_le_mul' le_rfl ?_
          rw [hz, hM]
          exact tsum_logShell_block_le hd g
      _ = ENNReal.ofReal cst * M * ∑' m : ℕ, brsLogBlockNorm d g m ^ q :=
          (mul_assoc _ _ _).symm
  · -- the top piece
    rw [ENNReal.tsum_mul_left]
    rw [mul_comm]
    exact mul_le_mul' (tsum_volume_brsOmega_le hE hEne) le_rfl


theorem exists_endpoint_bound_of_maj {d : ℕ} (hd : 2 ≤ d) {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {q B : ℝ} (hpq : (d : ℝ) / ((d : ℝ) - 1) ≤ q) (hB : 0 < B)
    (hcov : ∀ l : ℕ, 1 ≤ l →
      ((intervalCoveringNumber E ((2 : ℝ) ^ (-(2 ^ (l - 1) : ℤ))) : ℕ) : ℝ≥0∞) ≤
        ENNReal.ofReal (B ^ q * (2 : ℝ) ^ ((2 ^ (l - 1) : ℤ)) *
          (((2 : ℝ) ^ (l - 1)) * Real.log 2) ^ (-(q / (d : ℝ))))) :
    ∃ Λ : ENNReal, Λ ≠ ⊤ ∧ ∀ (g : ℝ → ℂ) (F : ℝ → ENNReal),
      (∀ r : ℝ, r ∉ brsU E 0 → F r = 0) →
      (∀ r ∈ brsD E 0, F r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
          ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) →
      (∀ l : ℕ, 1 ≤ l → ∀ r ∈ brsOmega E l, F r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ((∑' m : ℕ, brsLogWeight d l m * brsLogBlockNorm d g m) +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) →
      (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
        Λ * ((∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
          (((d : ℝ) - 1) / (d : ℝ))) ^ q := by
  have hdR : (2 : ℝ) ≤ (d : ℝ) := by exact_mod_cast hd
  have hd1 : (0 : ℝ) < (d : ℝ) - 1 := by linarith
  have hdpos : (0 : ℝ) < (d : ℝ) := by linarith
  have hpd1 : (1 : ℝ) ≤ (d : ℝ) / ((d : ℝ) - 1) := by
    rw [le_div_iff₀ hd1]
    linarith
  have hq : (1 : ℝ) ≤ q := le_trans hpd1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  refine ⟨ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
        (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q * ENNReal.ofReal 7 +
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
        (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
              ((Real.log 2) ^ (1 / (d : ℝ)) /
                ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
              ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
            (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
              (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) +
          ENNReal.ofReal 7 *
            ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q), ?_, ?_⟩
  · -- finiteness of the constant
    have hy1 : 1 < (2 : ℝ) ^ (1 / (d : ℝ)) := one_lt_two_rpow_inv_d hd
    have hypos : (0 : ℝ) < (2 : ℝ) ^ (1 / (d : ℝ)) := by positivity
    have hzlt : ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ < 1 := by
      rw [ENNReal.ofReal_lt_one]
      have h := (div_lt_one hypos).mpr hy1
      simpa [one_div] using h
    have hsub : (1 : ENNReal) - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹ ≠ 0 := by
      intro h
      rw [tsub_eq_zero_iff_le] at h
      exact absurd hzlt (not_lt.mpr h)
    have hinv : ((1 : ENNReal) -
        ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹ ≠ ⊤ :=
      ENNReal.inv_ne_top.mpr hsub
    refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
    · refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_)
        ENNReal.ofReal_ne_top
      exact ENNReal.rpow_ne_top_of_nonneg hq0.le
        (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top)
    · refine ENNReal.mul_ne_top (ENNReal.mul_ne_top (ENNReal.mul_ne_top
        ENNReal.ofReal_ne_top (ENNReal.rpow_ne_top_of_nonneg hq0.le
          ENNReal.ofReal_ne_top)) (ENNReal.rpow_ne_top_of_nonneg hq0.le
            (by simp))) ?_
      refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
      · exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
          (ENNReal.mul_ne_top ENNReal.ofReal_ne_top hinv)
      · exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
          (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top)
  · intro g F hFzero hFD0 hFO
    have hzeroF : ∀ r : ℝ, r ∉ brsU E 0 →
        ENNReal.ofReal r ^ (d - 1) * F r ^ q = 0 := by
      intro r hr
      rw [hFzero r hr, ENNReal.zero_rpow_of_pos hq0, mul_zero]
    have hNtop : brsTopNorm d g ≤
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
          (((d : ℝ) - 1) / (d : ℝ)) := brsTopNorm_le hd g
    have hblocks := tsum_brsLogBlockNorm_pow_le hd hpq g
    refine le_trans (lintegral_le_brsD_zero_add_tsum_brsOmega_of_maj hEne hEnull
      hzeroF) ?_
    rw [add_mul]
    refine add_le_add ?_ ?_
    · -- the zeroth shell
      refine le_trans (lintegral_brsD_zero_le_of_maj hE hEne hq0 hFD0) ?_
      have hstep : (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
          (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q ≤
          (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
            ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q *
            ((∫⁻ s in Ioi (0 : ℝ),
              (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                (((d : ℝ) - 1) / (d : ℝ))) ^ q := by
        rw [← mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hNtop hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
            (ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
              (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g)) ^ q *
            ENNReal.ofReal 7
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              ((ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
                ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                  ((11 : ℝ) / 2) ^ (1 / (d : ℝ)))) ^ q *
                ((∫⁻ s in Ioi (0 : ℝ),
                  (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                    (((d : ℝ) - 1) / (d : ℝ))) ^ q) * ENNReal.ofReal 7 :=
            mul_le_mul' (mul_le_mul' le_rfl hstep) le_rfl
        _ = _ := by ring
    · -- the grouped shells
      refine le_trans (tsum_brsOmega_le_of_maj hd hE hEne hq hB hcov g hFO) ?_
      have htop : ENNReal.ofReal 7 *
          (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q ≤
          ENNReal.ofReal 7 *
            (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
              ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q *
              ((∫⁻ s in Ioi (0 : ℝ),
                (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                  (((d : ℝ) - 1) / (d : ℝ))) ^ q) := by
        refine mul_le_mul' le_rfl ?_
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
        exact mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hNtop hq0.le)
      calc ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
            ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
            (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
                  ((Real.log 2) ^ (1 / (d : ℝ)) /
                    ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
                  ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
                (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                    ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
                  (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
                (∑' m : ℕ, brsLogBlockNorm d g m ^ q) +
              ENNReal.ofReal 7 *
                (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                  ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) * brsTopNorm d g) ^ q)
          ≤ ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
              ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q * 2 ^ q *
              (ENNReal.ofReal (7 * B ^ q * (Real.log 2) ^ (-(q / (d : ℝ))) *
                    ((Real.log 2) ^ (1 / (d : ℝ)) /
                      ((2 : ℝ) ^ (1 / (d : ℝ)) - 1)) ^ (q - 1) *
                    ((2 : ℝ) ^ (1 / (d : ℝ))) ^ q) *
                  (ENNReal.ofReal ((Real.log 2) ^ (1 / (d : ℝ)) *
                      ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹) *
                    (1 - ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)))⁻¹)⁻¹) *
                  ((∫⁻ s in Ioi (0 : ℝ),
                    (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                      (((d : ℝ) - 1) / (d : ℝ))) ^ q +
                ENNReal.ofReal 7 *
                  (ENNReal.ofReal ((2 : ℝ) ^ (1 / (d : ℝ)) *
                    ((11 : ℝ) / 2) ^ (1 / (d : ℝ))) ^ q *
                    ((∫⁻ s in Ioi (0 : ℝ),
                      (ENNReal.ofReal ‖g s‖) ^ ((d : ℝ) / ((d : ℝ) - 1))) ^
                        (((d : ℝ) - 1) / (d : ℝ))) ^ q)) :=
            mul_le_mul' le_rfl (add_le_add (mul_le_mul' le_rfl hblocks) htop)
        _ = _ := by ring

/-! ## The far halves at `p = 2`, on the grouped shells

At `p = 2` (which is `p_d` for `d = 2`) the shell majorant of `𝔐_{p,∞}^±` is
literally the one the Proposition 4.6 chain consumes. -/

theorem brsMainInf_exponent : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / (2 : ℝ)) - 1) =
    -(1 / ((2 : ℕ) : ℝ)) := by
  push_cast
  ring

theorem brsMainInfLeft_le_on_brsD_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : r ∈ brsD E 0) :
    brsMainInfLeft E 2 g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (((2 : ℕ) : ℝ)))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / ((2 : ℕ) : ℝ)) *
          ((11 : ℝ) / 2) ^ (1 / ((2 : ℕ) : ℝ))) * brsTopNorm 2 g) := by
  have hcut := brsMainInfLeft_le_on_brsD (p := (2 : ℝ)) hE g hr
  rw [brsMainInf_exponent] at hcut
  refine le_trans hcut ?_
  refine mul_le_mul' le_rfl ?_
  have hwin : Icc ((2 : ℝ) ^ (-(0 : ℕ) : ℤ)) 6 ⊆ Icc (1 / 2 : ℝ) 6 := by
    refine Icc_subset_Icc ?_ le_rfl
    norm_num
  refine le_trans (lintegral_mono_set hwin) ?_
  rw [brsTopNorm]
  exact lintegral_top_piece_le (d := 2) (by norm_num) hg

theorem brsMainInfLeft_le_on_brsOmega {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Measurable g) {l : ℕ} (hl : 1 ≤ l) {r : ℝ}
    (hr : r ∈ brsOmega E l) :
    brsMainInfLeft E 2 g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (((2 : ℕ) : ℝ)))) *
        ((∑' m : ℕ, brsLogWeight 2 l m * brsLogBlockNorm 2 g m) +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / ((2 : ℕ) : ℝ)) *
            ((11 : ℝ) / 2) ^ (1 / ((2 : ℕ) : ℝ))) * brsTopNorm 2 g) := by
  obtain ⟨n, hn, hrn⟩ : ∃ n ∈ Finset.Ico (2 ^ (l - 1)) (2 ^ l), r ∈ brsD E n := by
    rw [brsOmega] at hr
    simpa only [Set.mem_iUnion, exists_prop] using hr
  rw [Finset.mem_Ico] at hn
  have hcut := brsMainInfLeft_le_on_brsD (p := (2 : ℝ)) hE g hrn
  rw [brsMainInf_exponent] at hcut
  refine le_trans hcut ?_
  refine mul_le_mul' le_rfl ?_
  have hwin : Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 ⊆ Icc ((2 : ℝ) ^ (-(2 ^ l : ℤ))) 6 := by
    refine Icc_subset_Icc ?_ le_rfl
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    have hcast : ((n : ℤ)) ≤ ((2 ^ l : ℕ) : ℤ) := by
      exact_mod_cast le_of_lt hn.2
    push_cast at hcast
    omega
  refine le_trans (lintegral_mono_set hwin) ?_
  exact lintegral_window_le_logBlocks (d := 2) (by norm_num) hg hl

theorem brsMainInfRight_le_on_brsD_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : r ∈ brsD E 0) :
    brsMainInfRight E 2 g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (((2 : ℕ) : ℝ)))) *
        (ENNReal.ofReal ((2 : ℝ) ^ (1 / ((2 : ℕ) : ℝ)) *
