theorem brsMainInfRight_le_on_brsOmega {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {g : ℝ → ℂ} (hg : Measurable g) {l : ℕ} (hl : 1 ≤ l) {r : ℝ}
