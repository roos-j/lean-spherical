    {g : ℝ → ℂ} (hg : Measurable g) (m : ℕ) :
    (∫⁻ s in brsNearPieceSet a m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          a ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc a (2 * a), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  set θ : ℝ := (1 / 2 : ℝ) ^ (m + 1) with hθ
  have hθ0 : (0 : ℝ) < θ := by rw [hθ]; positivity
  set K : ℝ := θ ^ (-(1 / 2) : ℝ) * a ^ (-(1 / p) : ℝ) with hK
  have hK0 : (0 : ℝ) ≤ K := by
    rw [hK]
    exact mul_nonneg (Real.rpow_nonneg hθ0.le _) (Real.rpow_nonneg ha.le _)
  have hgmeas : Measurable fun s : ℝ => ENNReal.ofReal ‖g s‖ :=
    hg.norm.ennreal_ofReal
  -- replace the weight by the constant `K`
