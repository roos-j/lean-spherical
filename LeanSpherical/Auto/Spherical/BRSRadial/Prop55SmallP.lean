  -- the `L^s` norm of the indicator
  have hKs : (∫⁻ u : ℝ, K u ^ s) = volume Q := by
    have hpt : ∀ u : ℝ, K u ^ s = K u := by
      intro u
      by_cases hu : u ∈ Q
      · simp [hK, Set.indicator_of_mem hu]
      · simp [hK, Set.indicator_of_notMem hu, ENNReal.zero_rpow_of_pos hs0]
    rw [lintegral_congr hpt]
    show (∫⁻ u : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) u) = volume Q
    rw [lintegral_indicator hQ]
    simp
  rw [hKs] at hmain
  -- assemble
  set G : ENNReal := ∫⁻ y : ℝ, F y ^ p with hG
  have hcollect : (volume Q) ^ ((1 - 1 / p) * q) *
      (G ^ (s - 1) * (G * volume Q)) =
      ((volume Q) ^ ((1 - 1 / p + 1 / q) * q)) * G ^ s := by
    rw [show G ^ (s - 1) * (G * volume Q) = (G ^ (s - 1) * G ^ (1 : ℝ)) * volume Q from by
      rw [ENNReal.rpow_one]; ring]
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) (by norm_num),
      show s - 1 + 1 = s from by ring]
    rw [show (volume Q) ^ ((1 - 1 / p) * q) * (G ^ s * volume Q) =
        ((volume Q) ^ ((1 - 1 / p) * q) * (volume Q) ^ (1 : ℝ)) * G ^ s from by
      rw [ENNReal.rpow_one]; ring]
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by
      have : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp1
      nlinarith) (by norm_num)]
    congr 2
    field_simp
  rw [hcollect] at hmain
  calc (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * F y) ^ q) ^ (1 / q)
      ≤ (((volume Q) ^ ((1 - 1 / p + 1 / q) * q)) * G ^ s) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = (volume Q) ^ (1 - 1 / p + 1 / q) * G ^ (1 / p) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul]
        congr 2
        · field_simp
        · rw [hs]
          field_simp

/-! ## Linearizing the dilation supremum

Once the dilation `t` is confined to an interval `[u, v]`, the window
`(r - t + c₁, r - t + c₂]` of the `s`-integral is contained in a fixed
translate window measured from `r`, so the supremum over `t` is dominated by a
single convolution with the indicator of an interval of length
`(v - u) + (c₂ - c₁)`.  Together with `lintegral_indicator_conv_rpow_le` this is
the `m > ℓ` half of BRS Proposition 5.5(ii)–(iii). -/

/-- A supremum is bounded by the `ℓ^q` norm. -/
theorem iSup_le_rpow_tsum {ι : Type*} {X : ι → ENNReal} {q : ℝ} (hq0 : 0 < q) :
    (⨆ i, X i) ≤ (∑' i, X i ^ q) ^ (1 / q) := by
  refine iSup_le fun i => ?_
  have h1 : X i ^ q ≤ ∑' j, X j ^ q := ENNReal.le_tsum i
  calc X i = (X i ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑' j, X j ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow h1 (by positivity)

/-- A finite supremum is bounded by the `ℓ^q` norm. -/
theorem iSup_finset_le_rpow_sum {ι : Type*} {s : Finset ι} {X : ι → ENNReal}
    {q : ℝ} (hq0 : 0 < q) :
    (⨆ i ∈ s, X i) ≤ (∑ i ∈ s, X i ^ q) ^ (1 / q) := by
  refine iSup₂_le fun i hi => ?_
  have h1 : X i ^ q ≤ ∑ j ∈ s, X j ^ q :=
    Finset.single_le_sum (f := fun j => X j ^ q) (fun _ _ => zero_le) hi
  calc X i = (X i ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ j ∈ s, X j ^ q) ^ (1 / q) := ENNReal.rpow_le_rpow h1 (by positivity)

/-- **The translation window.**  For `t` in `[u, v]` the shifted window sits
inside the reflected translate of a single interval. -/
theorem lintegral_shifted_window_le {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    (F : ℝ → ENNReal) (r : ℝ) :
    (∫⁻ s in Ioc (r - t + c₁) (r - t + c₂), F s) ≤
      ∫⁻ s : ℝ,
        Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - s) *
          F s := by
  obtain ⟨hu, hv⟩ := ht
  have hsub : Ioc (r - t + c₁) (r - t + c₂) ⊆
      (fun s : ℝ => r - s) ⁻¹' Ico (u - c₂) (v - c₁) := by
    intro s hs
    obtain ⟨h1, h2⟩ := hs
    constructor
    · have : r - s < t - c₁ := by linarith
      linarith
    · have : t - c₂ ≤ r - s := by linarith
      linarith
  rw [lintegral_indicator_shift measurableSet_Ico F r]
  exact lintegral_mono_set hsub

/-- The reflected translate window has the expected length. -/
theorem volume_shifted_window (u v c₁ c₂ : ℝ) :
    volume (Ico (u - c₂) (v - c₁)) = ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
  rw [Real.volume_Ico]
  congr 1
  ring

/-- **The `m > ℓ` estimate.**  Combining the translation window with Young's
inequality against an indicator bounds the `L^q` norm of the linearized piece
by `|window|^{1 - 1/p + 1/q} ‖F‖_p`. -/
theorem lintegral_shifted_window_rpow_le {u v c₁ c₂ : ℝ} (huv : u ≤ v)
    (hc : c₁ ≤ c₂) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v, ∫⁻ s in Ioc (r - (t : ℝ) + c₁) (r - (t : ℝ) + c₂), F s) ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hlen : (0 : ℝ) ≤ (v - u) + (c₂ - c₁) := by
    have : (0 : ℝ) ≤ v - u := by linarith
    have : (0 : ℝ) ≤ c₂ - c₁ := by linarith
    linarith
  have hptwise : ∀ r : ℝ,
      (⨆ t : Icc u v, ∫⁻ s in Ioc (r - (t : ℝ) + c₁) (r - (t : ℝ) + c₂), F s) ≤
        ∫⁻ s : ℝ,
          Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - s) *
            F s := by
    intro r
    exact iSup_le fun t => lintegral_shifted_window_le t.2 F r
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hptwise r) hq0.le)
    (by positivity)) ?_
  have hyoung := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
    measurableSet_Ico (by
      rw [volume_shifted_window]
      exact ENNReal.ofReal_ne_top) hF hp1 hpq
  rw [volume_shifted_window] at hyoung
  exact hyoung

/-! ## The mirrored translation window

`|r - t|` is `r - t` or `t - r`, and only the first is a translate of `r` in
the right direction.  For the second, reflecting the integration variable turns
it into a translate as well, at the cost of replacing `F` by `F ∘ (-·)` — this
is BRS's `Σ_±` with `h̃(s) = h(-s)`.  The reflection preserves every `L^p`
norm. -/

/-- Reflection preserves the integral. -/
theorem lintegral_comp_neg (F : ℝ → ENNReal) (hF : Measurable F) :
    (∫⁻ y : ℝ, F (-y)) = ∫⁻ y : ℝ, F y :=
  (Measure.measurePreserving_neg (volume : Measure ℝ)).lintegral_comp hF

/-- **The mirrored translation window.** -/
theorem lintegral_shifted_window_le' {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    {F : ℝ → ENNReal} (hF : Measurable F) (r : ℝ) :
    (∫⁻ s in Ioc (t - r + c₁) (t - r + c₂), F s) ≤
      ∫⁻ y : ℝ,
        Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
          F (-y) := by
  obtain ⟨hu, hv⟩ := ht
  set S : Set ℝ := Ioc (t - r + c₁) (t - r + c₂) with hS
  have hSmeas : MeasurableSet S := measurableSet_Ioc
  have hstep : (∫⁻ s in S, F s) =
      ∫⁻ y : ℝ, Set.indicator S (fun z => F z) (-y) := by
    rw [← lintegral_indicator hSmeas]
    exact (lintegral_comp_neg _ (hF.indicator hSmeas)).symm
  rw [hstep]
  refine lintegral_mono fun y => ?_
  by_cases hy : (-y) ∈ S
  · rw [Set.indicator_of_mem hy]
    obtain ⟨h1, h2⟩ := hy
    have hmem : r - y ∈ Ioc (u + c₁) (v + c₂) := by
      constructor
      · have : t - r + c₁ < -y := h1
        linarith
      · have : -y ≤ t - r + c₂ := h2
        linarith
    rw [Set.indicator_of_mem hmem, one_mul]
  · rw [Set.indicator_of_notMem hy]
    exact zero_le

/-- **The dyadic piece sits in an additive window.**  If `A/2 ≤ a < A` then the
`m`-th multiplicative piece of `(a, 2a]` lies in `(a + A·2^{-m-2}, a + A·2^{-m}]`,
whose endpoints no longer depend on `a`. -/
theorem brsNearPieceSet_subset_shift {a A : ℝ} (_hA : 0 < A) (ha1 : A / 2 ≤ a)
    (ha2 : a < A) (m : ℕ) :
    brsNearPieceSet a m ⊆
      Ioc (a + A * (1 / 2 : ℝ) ^ (m + 2)) (a + A * (1 / 2 : ℝ) ^ m) := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ m := by positivity
  have hsucc : (1 / 2 : ℝ) ^ (m + 1) = (1 / 2 : ℝ) ^ m / 2 := by
    rw [pow_succ]; ring
  have hsucc2 : (1 / 2 : ℝ) ^ (m + 2) = (1 / 2 : ℝ) ^ m / 4 := by
    rw [pow_succ, pow_succ]; ring
  constructor
  · have hlow : a + a * (1 / 2 : ℝ) ^ (m + 1) < s := by nlinarith
    have : A * (1 / 2 : ℝ) ^ (m + 2) ≤ a * (1 / 2 : ℝ) ^ (m + 1) := by
      rw [hsucc, hsucc2]
      nlinarith
    linarith
  · have hhigh : s ≤ a + a * (1 / 2 : ℝ) ^ m := by nlinarith
    have : a * (1 / 2 : ℝ) ^ m ≤ A * (1 / 2 : ℝ) ^ m := by nlinarith
    linarith

/-- The additive window has length `(3/4)·A·2^{-m}`. -/
theorem shift_window_length (a A : ℝ) (m : ℕ) :
    (a + A * (1 / 2 : ℝ) ^ m) - (a + A * (1 / 2 : ℝ) ^ (m + 2)) =
      A * (1 / 2 : ℝ) ^ m * (3 / 4) := by
  have hsucc2 : (1 / 2 : ℝ) ^ (m + 2) = (1 / 2 : ℝ) ^ m / 4 := by
    rw [pow_succ, pow_succ]; ring
  rw [hsucc2]
  ring

/-! ## The linearized window estimate, both signs

`|r - t|` is one of `r - t`, `t - r`, so the window integral is bounded by the
sum of the two signed ones, each of which is a convolution with an indicator of
an interval of length `(v - u) + (c₂ - c₁)`. -/

/-- Splitting on the sign of `r - t`. -/
theorem lintegral_abs_window_le (F : ℝ → ENNReal) (r t c₁ c₂ : ℝ) :
    (∫⁻ s in Ioc (|r - t| + c₁) (|r - t| + c₂), F s) ≤
      (∫⁻ s in Ioc (r - t + c₁) (r - t + c₂), F s) +
        ∫⁻ s in Ioc (t - r + c₁) (t - r + c₂), F s := by
  rcases abs_cases (r - t) with ⟨h, _⟩ | ⟨h, _⟩
  · rw [h]
    exact le_add_right le_rfl
  · rw [h, neg_sub]
    exact le_add_left le_rfl

/-- **The mirrored Young estimate.** -/
theorem lintegral_shifted_window_rpow_le' {u v c₁ c₂ : ℝ} (_huv : u ≤ v)
    (_hc : c₁ ≤ c₂) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v,
          ∫⁻ s in Ioc ((t : ℝ) - r + c₁) ((t : ℝ) - r + c₂), F s) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  have hptwise : ∀ r : ℝ,
      (⨆ t : Icc u v, ∫⁻ s in Ioc ((t : ℝ) - r + c₁) ((t : ℝ) - r + c₂), F s) ≤
        ∫⁻ y : ℝ,
          Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
            F (-y) :=
    fun r => iSup_le fun t => lintegral_shifted_window_le' t.2 hF r
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hptwise r) hq0.le)
    (by positivity)) ?_
  have hvol : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hyoung := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
    measurableSet_Ioc (by rw [hvol]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
  rw [hvol] at hyoung
  refine le_trans hyoung (le_of_eq ?_)
  congr 1
  congr 1
  exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)

/-- The convolution with an indicator is measurable. -/
theorem measurable_indicator_conv {Q : Set ℝ} (hQ : MeasurableSet Q)
    {F : ℝ → ENNReal} (hF : Measurable F) :
    Measurable fun r : ℝ =>
      ∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (r - y) * F y := by
  have hK : Measurable (Set.indicator Q (fun _ => (1 : ENNReal))) :=
    measurable_const.indicator hQ
  have hjoint : Measurable (Function.uncurry fun r y : ℝ =>
      Set.indicator Q (fun _ => (1 : ENNReal)) (r - y) * F y) :=
    (hK.comp (measurable_fst.sub measurable_snd)).mul (hF.comp measurable_snd)
  exact hjoint.lintegral_prod_right' (ν := (volume : Measure ℝ))

/-- **The two-sided linearized window estimate.** -/
theorem lintegral_abs_window_rpow_le {u v c₁ c₂ : ℝ} (_huv : u ≤ v) (_hc : c₁ ≤ c₂)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : Icc u v,
          ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q) ≤
      2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  set X : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) *
        F y with hXdef
  set Y : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) *
        F (-y) with hYdef
  have hXmeas : AEMeasurable X (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ico hF).aemeasurable
  have hYmeas : AEMeasurable Y (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ioc hFneg).aemeasurable
  have hsplit : ∀ r : ℝ,
      (⨆ t : Icc u v,
        ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤ X r + Y r := by
    intro r
    refine iSup_le fun t => ?_
    refine le_trans (lintegral_abs_window_le F r (t : ℝ) c₁ c₂) ?_
    exact add_le_add (lintegral_shifted_window_le t.2 F r)
      (lintegral_shifted_window_le' t.2 hF r)
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hsplit r) hq0.le)
    (by positivity)) ?_
  refine le_trans (ENNReal.lintegral_Lp_add_le hXmeas hYmeas hq1) ?_
  have hvol₁ : volume (Ico (u - c₂) (v - c₁)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have hvol₂ : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hX' : (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
      measurableSet_Ico (by rw [hvol₁]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
    rwa [hvol₁] at h
  have hY' : (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
      measurableSet_Ioc (by rw [hvol₂]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
    rw [hvol₂] at h
    refine le_trans h (le_of_eq ?_)
    congr 1
    congr 1
    exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)
  calc (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) + (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q)
      ≤ ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) +
          ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := add_le_add hX' hY'
    _ = 2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [two_mul]
        ring

/-! ## A measurable majorant for the linearized window operator

The supremum over `t` in an interval is not obviously measurable, so it is
replaced by the pair of convolutions that dominate it.  Those are measurable by
Tonelli, and carry the same `L^q` bound. -/

/-- The measurable majorant of the linearized window operator. -/
def brsWindowMaj (u v c₁ c₂ : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  (∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) * F y) +
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) * F (-y)

theorem measurable_brsWindowMaj (u v c₁ c₂ : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsWindowMaj u v c₁ c₂ F) := by
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  exact (measurable_indicator_conv measurableSet_Ico hF).add
    (measurable_indicator_conv measurableSet_Ioc hFneg)

/-- The majorant dominates the supremum over the dilation window. -/
theorem iSup_window_le_brsWindowMaj {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) (r : ℝ) :
    (⨆ t : Icc u v, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsWindowMaj u v c₁ c₂ F r := by
  refine iSup_le fun t => ?_
  refine le_trans (lintegral_abs_window_le F r (t : ℝ) c₁ c₂) ?_
  exact add_le_add (lintegral_shifted_window_le t.2 F r)
    (lintegral_shifted_window_le' t.2 hF r)

/-- The `L^q` bound for the majorant. -/
theorem lintegral_brsWindowMaj_rpow_le {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsWindowMaj u v c₁ c₂ F r ^ q) ^ (1 / q) ≤
      2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hFneg : Measurable fun y : ℝ => F (-y) := hF.comp measurable_neg
  set X : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ico (u - c₂) (v - c₁)) (fun _ => (1 : ENNReal)) (r - y) * F y
    with hXdef
  set Y : ℝ → ENNReal := fun r =>
    ∫⁻ y : ℝ,
      Set.indicator (Ioc (u + c₁) (v + c₂)) (fun _ => (1 : ENNReal)) (r - y) * F (-y)
    with hYdef
  have hXmeas : AEMeasurable X (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ico hF).aemeasurable
  have hYmeas : AEMeasurable Y (volume : Measure ℝ) :=
    (measurable_indicator_conv measurableSet_Ioc hFneg).aemeasurable
  have hvol₁ : volume (Ico (u - c₂) (v - c₁)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have hvol₂ : volume (Ioc (u + c₁) (v + c₂)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ioc]
    congr 1
    ring
  have hX' : (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ico (u - c₂) (v - c₁))
      measurableSet_Ico (by rw [hvol₁]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
    rwa [hvol₁] at h
  have hY' : (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
    have h := lintegral_indicator_conv_rpow_le (Q := Ioc (u + c₁) (v + c₂))
      measurableSet_Ioc (by rw [hvol₂]; exact ENNReal.ofReal_ne_top) hFneg hp1 hpq
    rw [hvol₂] at h
    refine le_trans h (le_of_eq ?_)
    congr 1
    congr 1
    exact lintegral_comp_neg (fun y => F y ^ p) (hF.pow_const p)
  refine le_trans (ENNReal.lintegral_Lp_add_le hXmeas hYmeas hq1) ?_
  calc (∫⁻ r : ℝ, X r ^ q) ^ (1 / q) + (∫⁻ r : ℝ, Y r ^ q) ^ (1 / q)
      ≤ ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) +
          ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
            (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := add_le_add hX' hY'
    _ = 2 * ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [two_mul]
        ring

/-! ## The covered window estimate

Splitting the dilation set by a `δ`-cover turns the supremum over all of `E`
into a factor `N(E, δ)^{1/q}`.  This is the `m > ℓ` half of BRS Proposition
5.5(ii)–(iii). -/

theorem lintegral_cover_window_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (_hc : c₁ ≤ c₂) (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ,
        (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
  set M : ENNReal := 2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  -- each cover interval
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMaj_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤
        M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul' (mul_le_mul' le_rfl
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp)) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  -- the supremum over `E` is dominated by the majorants over the cover
  have hsup : ∀ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
        ⨆ a ∈ ι, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    intro r
    refine iSup_le fun t => ?_
    obtain ⟨a, haι, hat⟩ : ∃ a ∈ ι, (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
      have hcov := hι t.2
      simpa only [Set.mem_iUnion, exists_prop] using hcov
    refine le_iSup₂_of_le a haι ?_
    refine le_trans ?_ (iSup_window_le_brsWindowMaj (u := a - δ / 2)
      (v := a + δ / 2) hF r)
    exact le_iSup (fun u : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨(t : ℝ), hat⟩
  have hsum : ∀ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q ≤
        ∑ a ∈ ι, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    have h := le_trans (hsup r) (iSup_finset_le_rpow_sum (s := ι) (q := q) hq0)
    have := ENNReal.rpow_le_rpow h hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hmain : (∫⁻ r : ℝ,
      (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ≤
      (ι.card : ENNReal) * M ^ q := by
    refine le_trans (lintegral_mono hsum) ?_
    rw [lintegral_finsetSum' _ (fun a _ =>
      ((measurable_brsWindowMaj _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ ι, ∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ ι, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = (ι.card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ,
        (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ^ q) ^
        (1 / q)
      ≤ ((ι.card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = (ι.card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The uniform per-piece bound

Once `a = |r - t|` is confined to a dyadic block `[A/2, A)`, the per-piece
Hölder bound becomes independent of `a` — and hence of `r` and `t`.  This is
the `m ≤ ℓ` half of BRS Proposition 5.5(ii)–(iii): the `L^q` norm then costs
only the measure of the shell. -/

/-- A negative power is antitone in the base. -/
theorem rpow_le_rpow_of_nonpos_exp {x y e : ℝ} (hx : 0 < x) (hxy : x ≤ y)
    (he : e ≤ 0) : y ^ e ≤ x ^ e := by
  have hy : 0 < y := lt_of_lt_of_le hx hxy
  rw [Real.rpow_def_of_pos hx, Real.rpow_def_of_pos hy]
  refine Real.exp_le_exp.mpr ?_
  have hlog : Real.log x ≤ Real.log y := Real.log_le_log hx hxy
  nlinarith

/-- **The uniform per-piece bound.** -/
theorem lintegral_nearPiece_le_uniform {p : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {A a : ℝ} (_hA : 0 < A) (ha1 : A / 2 ≤ a) (ha2 : a < A)
    {g : ℝ → ℂ} (hg : Measurable g) (m : ℕ) :
    (∫⁻ s in brsNearPieceSet a m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - a) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          (A / 2) ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hA2 : (0 : ℝ) < A / 2 := by linarith
  have ha0 : (0 : ℝ) < a := lt_of_lt_of_le hA2 ha1
  have hexp : 1 - 2 / p ≤ 0 := by
    have : (1 : ℝ) ≤ 2 / p := by
      rw [le_div_iff₀ hp0]
      linarith
    linarith
  have hθ : (0 : ℝ) < ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) :=
    Real.rpow_pos_of_pos (by positivity) _
  have hbase : a ^ (1 - 2 / p) ≤ (A / 2) ^ (1 - 2 / p) :=
    rpow_le_rpow_of_nonpos_exp hA2 ha1 hexp
  have hsub : Ioc a (2 * a) ⊆ Ioc (A / 2) (2 * A) := by
    intro s hs
    exact ⟨lt_of_le_of_lt ha1 hs.1, le_trans hs.2 (by linarith)⟩
  refine le_trans (lintegral_nearPiece_le hp1 hp2 ha0 hg m) ?_
  refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_)
    (ENNReal.rpow_le_rpow (lintegral_mono_set hsub) (by positivity))
  exact mul_le_mul_of_nonneg_left hbase hθ.le

/-! ## A measurable majorant for the covered window operator

The supremum over `t ∈ E` is not measurable, and the summation over `m` needs
Minkowski, which needs measurable summands.  So the supremum is replaced once
and for all by the `ℓ^q` sum of the window majorants over a chosen cover. -/

open Classical in
/-- A choice of optimal `δ`-cover of `E`. -/
def brsCoverFinset (E : Set ℝ) (δ : ℝ) : Finset ℝ :=
  if h : ∃ ι : Finset ℝ, IsIntervalCover E δ ι ∧
      ι.card = intervalCoveringNumber E δ then h.choose else ∅

theorem brsCoverFinset_spec {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) :
    IsIntervalCover E δ (brsCoverFinset E δ) ∧
      (brsCoverFinset E δ).card = intervalCoveringNumber E δ := by
  classical
  have h : ∃ ι : Finset ℝ, IsIntervalCover E δ ι ∧
      ι.card = intervalCoveringNumber E δ := by
    obtain ⟨ι, hι, hcard⟩ :=
      exists_intervalCover_card_eq_intervalCoveringNumber hE hδ
    exact ⟨ι, hι, hcard⟩
  rw [brsCoverFinset, dif_pos h]
  exact h.choose_spec

/-- The measurable majorant of the covered window operator. -/
def brsCoverMaj (E : Set ℝ) (δ c₁ c₂ q : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  (∑ a ∈ brsCoverFinset E δ,
    brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q)

theorem measurable_brsCoverMaj (E : Set ℝ) (δ c₁ c₂ q : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsCoverMaj E δ c₁ c₂ q F) := by
  refine Measurable.pow_const ?_ (1 / q)
  exact Finset.measurable_sum _ fun a _ =>
    (measurable_brsWindowMaj _ _ _ _ hF).pow_const q

/-- The majorant dominates the supremum over `E`. -/
theorem iSup_le_brsCoverMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) {c₁ c₂ q : ℝ} (hq0 : 0 < q) {F : ℝ → ENNReal}
    (hF : Measurable F) (r : ℝ) :
    (⨆ t : E, ∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsCoverMaj E δ c₁ c₂ q F r := by
  obtain ⟨hι, _⟩ := brsCoverFinset_spec hE hδ
  refine iSup_le fun t => ?_
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ brsCoverFinset E δ,
      (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι t.2
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  have hle : (∫⁻ s in Ioc (|r - (t : ℝ)| + c₁) (|r - (t : ℝ)| + c₂), F s) ≤
      brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    refine le_trans ?_ (iSup_window_le_brsWindowMaj (u := a - δ / 2)
      (v := a + δ / 2) hF r)
    exact le_iSup (fun u : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨(t : ℝ), hat⟩
  refine le_trans hle ?_
  rw [brsCoverMaj]
  have hmem : brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q ≤
      ∑ b ∈ brsCoverFinset E δ,
        brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q :=
    Finset.single_le_sum
      (f := fun b => brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q)
      (fun _ _ => zero_le) haι
  calc brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r
      = (brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ b ∈ brsCoverFinset E δ,
          brsWindowMaj (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmem (by positivity)

/-- **The `L^q` bound for the covered window majorant.** -/
theorem lintegral_brsCoverMaj_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ^ (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨hι, hcard⟩ := brsCoverFinset_spec hE hδ
  set M : ENNReal := 2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMaj_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ,
        brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤ M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul' (mul_le_mul' le_rfl
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp)) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hpow : ∀ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q =
      ∑ a ∈ brsCoverFinset E δ,
        brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    rw [brsCoverMaj, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne',
      ENNReal.rpow_one]
  have hmain : (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ≤
      ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
    rw [lintegral_congr hpow,
      lintegral_finsetSum' _ (fun a _ =>
        ((measurable_brsWindowMaj _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ brsCoverFinset E δ,
          ∫⁻ r : ℝ, brsWindowMaj (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ brsCoverFinset E δ, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ, brsCoverMaj E δ c₁ c₂ q F r ^ q) ^ (1 / q)
      ≤ (((brsCoverFinset E δ).card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ((brsCoverFinset E δ).card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The dyadic blocks of `|r - t|`

`𝔐_{p,0}` is decomposed according to the size of `a = |r - t|`, which lies in
`(0, 2)` whenever the dilation window is non-empty.  Writing `A_j := 2·2^{-j}`,
every such `a` lies in exactly one block `[A_j/2, A_j)`. -/

/-- The dilations whose distance to `r` lies in the `j`-th dyadic block. -/
def brsBlockSet (E : Set ℝ) (A r : ℝ) : Set ℝ :=
  E ∩ {t | A / 2 ≤ |r - t| ∧ |r - t| < A}

/-- `𝔐_{p,0}^-` restricted to one dyadic block, without the radial factor. -/
def brsBlockMax (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (A r : ℝ) : ENNReal :=
  ⨆ t ∈ brsBlockSet E A r,
    ∫⁻ s in Ioc |r - t| (2 * |r - t|),
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖

/-- Every `a ∈ (0, 2)` lies in a dyadic block. -/
theorem exists_block_index {a : ℝ} (ha : 0 < a) (ha2 : a < 2) :
    ∃ j : ℕ, 2 * (1 / 2 : ℝ) ^ j / 2 ≤ a ∧ a < 2 * (1 / 2 : ℝ) ^ j := by
  classical
  have hex : ∃ j : ℕ, (1 / 2 : ℝ) ^ j ≤ a := by
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one ha (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨n, hn.le⟩
  set j : ℕ := Nat.find hex with hj
  have hlow : (1 / 2 : ℝ) ^ j ≤ a := Nat.find_spec hex
  have hhigh : a < 2 * (1 / 2 : ℝ) ^ j := by
    rcases Nat.eq_zero_or_pos j with hj0 | hjpos
    · rw [hj0]
      simpa using ha2
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, j = k + 1 := ⟨j - 1, by omega⟩
      have hklt : k < Nat.find hex := by
        rw [← hj]
        omega
      have hnot := Nat.find_min hex hklt
      have hidx : (1 / 2 : ℝ) ^ k = 2 * (1 / 2 : ℝ) ^ j := by
        rw [hk, pow_succ]
        ring
      rw [hidx] at hnot
      exact lt_of_not_ge hnot
  refine ⟨j, ?_, hhigh⟩
  have : 2 * (1 / 2 : ℝ) ^ j / 2 = (1 / 2 : ℝ) ^ j := by ring
  rw [this]
  exact hlow

/-- **The block decomposition of `𝔐_{p,0}^-`.** -/
theorem brsMainZeroLeft_le_tsum_blocks {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p : ℝ} {g : ℝ → ℂ} (r : ℝ) :
    brsMainZeroLeft E p g r ≤
      ENNReal.ofReal r⁻¹ * ∑' j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r := by
  refine iSup₂_le fun t ht => ?_
  refine mul_le_mul' le_rfl ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  obtain ⟨htlo, hthi⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have ha2 : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  rcases eq_or_lt_of_le (abs_nonneg (r - t)) with hz | hapos
  · have hempty : Ioc |r - t| (2 * |r - t|) = (∅ : Set ℝ) := by
      rw [← hz]
      simp
    rw [hempty]
    simp
  · obtain ⟨j, hj1, hj2⟩ := exists_block_index hapos ha2
    have hmem : t ∈ brsBlockSet E (2 * (1 / 2 : ℝ) ^ j) r := ⟨htE, hj1, hj2⟩
    refine le_trans ?_ (ENNReal.le_tsum j)
    exact le_iSup₂ (f := fun t (_ : t ∈ brsBlockSet E (2 * (1 / 2 : ℝ) ^ j) r) =>
      ∫⁻ s in Ioc |r - t| (2 * |r - t|),
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) t hmem

/-! ## The two bounds for a single block and piece

On the block `[A/2, A)` the `m`-th piece admits two estimates: the uniform
Hölder bound, which is constant in `r`, and the covered-window bound, which
carries the covering number at the fine scale `A·2^{-m}`.  BRS use the first for
`m ≤ ℓ` and the second for `m > ℓ`. -/

/-- `𝔐_{p,0}^-` restricted to one dyadic block and one dyadic piece. -/
def brsBlockPieceMax (E : Set ℝ) (p : ℝ) (g : ℝ → ℂ) (A : ℝ) (m : ℕ) (r : ℝ) :
    ENNReal :=
  ⨆ t ∈ brsBlockSet E A r,
    ∫⁻ s in brsNearPieceSet |r - t| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖

/-- The profile localized to the `s`-window of a block. -/
def brsBlockProfile (A : ℝ) (g : ℝ → ℂ) : ℝ → ENNReal :=
  Set.indicator (Ioc (A / 2) (2 * A)) (fun z => ENNReal.ofReal ‖g z‖)

theorem measurable_brsBlockProfile (A : ℝ) {g : ℝ → ℂ} (hg : Measurable g) :
    Measurable (brsBlockProfile A g) :=
  (hg.norm.ennreal_ofReal).indicator measurableSet_Ioc

theorem lintegral_brsBlockProfile_rpow (A : ℝ) {g : ℝ → ℂ} {p : ℝ} (hp0 : 0 < p) :
    (∫⁻ s : ℝ, brsBlockProfile A g s ^ p) =
      ∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p := by
  rw [← lintegral_indicator measurableSet_Ioc]
  refine lintegral_congr fun s => ?_
  by_cases hs : s ∈ Ioc (A / 2) (2 * A)
  · rw [brsBlockProfile, Set.indicator_of_mem hs, Set.indicator_of_mem hs]
  · rw [brsBlockProfile, Set.indicator_of_notMem hs, Set.indicator_of_notMem hs,
      ENNReal.zero_rpow_of_pos hp0]

/-- The block is decomposed into the dyadic pieces. -/
theorem brsBlockMax_le_tsum {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {A : ℝ} (_hA : 0 < A)
    (r : ℝ) :
    brsBlockMax E p g A r ≤ ∑' m : ℕ, brsBlockPieceMax E p g A m r := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have ha0 : (0 : ℝ) < |r - t| := lt_of_lt_of_le (by linarith) ht1
  refine le_trans (lintegral_near_le_tsum_pieces ha0 _) ?_
  refine ENNReal.tsum_le_tsum fun m => ?_
  exact le_iSup₂ (f := fun u (_ : u ∈ brsBlockSet E A r) =>
    ∫⁻ s in brsNearPieceSet |r - u| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - u|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖) t ⟨htE, ht1, ht2⟩

/-- **The uniform Hölder bound for one block and piece.**  Independent of `r`. -/
theorem brsBlockPieceMax_le_const {E : Set ℝ} {p : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    {g : ℝ → ℂ} (hg : Measurable g) {A : ℝ} (hA : 0 < A) (m : ℕ) (r : ℝ) :
    brsBlockPieceMax E p g A m r ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
          (A / 2) ^ (1 - 2 / p)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  exact lintegral_nearPiece_le_uniform hp1 hp2 hA ht1 ht2 hg m

/-- **The covered-window bound for one block and piece.** -/
theorem brsBlockPieceMax_le_cover {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ} (hg : Measurable g)
    {A : ℝ} (hA : 0 < A) (m : ℕ) (r : ℝ) :
    brsBlockPieceMax E p g A m r ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q
          (brsBlockProfile A g) r := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hA2 : (0 : ℝ) < A / 2 := by linarith
  have hδ : (0 : ℝ) < A * (1 / 2) ^ m := by positivity
  set c₁ : ℝ := A * (1 / 2 : ℝ) ^ (m + 2) with hc₁
  set c₂ : ℝ := A * (1 / 2 : ℝ) ^ m with hc₂
  set F : ℝ → ENNReal := brsBlockProfile A g with hF
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, ht1, ht2⟩ := ht
  have ha0 : (0 : ℝ) < |r - t| := lt_of_lt_of_le hA2 ht1
  -- the weight is bounded on the piece
  have hweight : (∫⁻ s in brsNearPieceSet |r - t| m,
      ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
        ENNReal.ofReal ‖g s‖) ≤
      ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        ∫⁻ s in Ioc (|r - t| + c₁) (|r - t| + c₂), F s := by
    have hstep : (∫⁻ s in brsNearPieceSet |r - t| m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) * (s - |r - t|) ^ (-(1 / 2) : ℝ)) *
          ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          ∫⁻ s in brsNearPieceSet |r - t| m, F s := by
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      have hsmem : s ∈ Ioc (A / 2) (2 * A) := by
        have hsub := brsNearPieceSet_subset_shift hA ht1 ht2 m
        have hmem := hsub hs
        obtain ⟨h1, h2⟩ := hmem
        constructor
        · have : (0 : ℝ) < c₁ := by rw [hc₁]; positivity
          linarith
        · have hc₂le : c₂ ≤ A := by
            rw [hc₂]
            have : (1 / 2 : ℝ) ^ m ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
            nlinarith
          linarith
      have hFs : F s = ENNReal.ofReal ‖g s‖ := by
        rw [hF, brsBlockProfile, Set.indicator_of_mem hsmem]
      rw [hFs]
      refine mul_le_mul' (ENNReal.ofReal_le_ofReal ?_) le_rfl
      have hw := mainWeight_piece_le hp1 hp2 ha0 hs
      have hbase : |r - t| ^ (-(1 / p) : ℝ) ≤ (A / 2) ^ (-(1 / p) : ℝ) :=
        rpow_le_rpow_of_nonpos_exp hA2 ht1 (by
          have h : (0 : ℝ) < 1 / p := by positivity
          linarith)
      refine le_trans hw ?_
      exact mul_le_mul_of_nonneg_left hbase
        (Real.rpow_nonneg (by positivity) _)
    refine le_trans hstep (mul_le_mul' le_rfl ?_)
    exact lintegral_mono_set (brsNearPieceSet_subset_shift hA ht1 ht2 m)
  refine le_trans hweight (mul_le_mul' le_rfl ?_)
  -- the window is dominated by the covered majorant
  refine le_trans ?_ (iSup_le_brsCoverMaj hE hδ hq0 hFmeas r)
  exact le_iSup (fun u : E =>
    ∫⁻ s in Ioc (|r - (u : ℝ)| + c₁) (|r - (u : ℝ)| + c₂), F s) ⟨t, htE⟩

/-! ## The block estimate on a shell

Summing the two per-piece bounds over `m` with Minkowski gives, for one shell
and one dyadic block, the estimate that carries all the analysis of BRS
Proposition 5.5(ii)–(iii).  Which of the two bounds is used for which `m` is
left to the arithmetic: the statement takes their minimum. -/

/-- The `L^q` norm of a constant on a set. -/
theorem lintegral_indicator_const_rpow {S : Set ℝ} (hS : MeasurableSet S)
    {c : ENNReal} {q : ℝ} (hq0 : 0 < q) :
    (∫⁻ r : ℝ, Set.indicator S (fun _ => c) r ^ q) ^ (1 / q) =
      c * volume S ^ (1 / q) := by
  have hpt : ∀ r : ℝ, Set.indicator S (fun _ => c) r ^ q =
      Set.indicator S (fun _ => c ^ q) r := by
    intro r
    by_cases hr : r ∈ S
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0]
  rw [lintegral_congr hpt, lintegral_indicator hS, setLIntegral_const,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    mul_one_div_cancel hq0.ne', ENNReal.rpow_one]

/-- **The block estimate on a shell.** -/
theorem lintegral_brsBlockMax_shell_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hpq : p ≤ q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA : 0 < A) (n : ℕ) :
    (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) ^ (1 / q) ≤
      ∑' m : ℕ,
        min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
                (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
            (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
                (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                  (1 - 1 / p + 1 / q)))) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  set F : ℝ → ENNReal := brsBlockProfile A g with hFdef
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = GA := by
    rw [hFdef, lintegral_brsBlockProfile_rpow A hp0, hGA]
  -- the two per-piece majorants
  set CH : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p)) with hCH
  set W : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ)) with hW
  set Θ : ℕ → ℝ → ENNReal := fun m r =>
    min (Set.indicator (brsD E n) (fun _ => CH m * GA) r)
      (W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
        (A * (1 / 2) ^ m) q F r) with hΘ
  have hΘmeas : ∀ m : ℕ, Measurable (Θ m) := by
    intro m
    refine Measurable.min ?_ ?_
    · exact measurable_const.indicator (measurableSet_brsD E n)
    · exact measurable_const.mul (measurable_brsCoverMaj _ _ _ _ _ hFmeas)
  -- the pointwise bound
  have hpt : ∀ r : ℝ,
      Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ≤ ∑' m, Θ m r := by
    intro r
    by_cases hr : r ∈ brsD E n
    · rw [Set.indicator_of_mem hr]
      refine le_trans (brsBlockMax_le_tsum hA r) ?_
      refine ENNReal.tsum_le_tsum fun m => ?_
      refine le_min ?_ ?_
      · rw [Set.indicator_of_mem hr, hCH, hGA]
        exact brsBlockPieceMax_le_const hp1 hp2 hg hA m r
      · rw [hW]
        exact brsBlockPieceMax_le_cover hE hp1 hp2 hq0 hg hA m r
    · rw [Set.indicator_of_notMem hr]
      exact zero_le
  -- the two `L^q` bounds for each `Θ m`
  have hΘbound : ∀ m : ℕ, (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
      min (CH m * volume (brsD E n) ^ (1 / q))
        (W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)))) *
        GA := by
    intro m
    have hδ : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
    have hlen : A * (1 / 2 : ℝ) ^ m - A * (1 / 2 : ℝ) ^ (m + 2) ≤
        A * (1 / 2 : ℝ) ^ m := by
      have : (0 : ℝ) ≤ A * (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hb1 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        CH m * GA * volume (brsD E n) ^ (1 / q) := by
      have hmono : ∀ r : ℝ, Θ m r ≤ Set.indicator (brsD E n) (fun _ => CH m * GA) r :=
        fun r => min_le_left _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      exact le_of_eq (lintegral_indicator_const_rpow (measurableSet_brsD E n) hq0)
    have hb2 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
          GA := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r := fun r => min_le_right _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      have hconst : (∫⁻ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
          (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q) ^ (1 / q) =
          W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q) := by
        have hpull : ∀ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
            (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q =
            W m ^ q * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
              (A * (1 / 2) ^ m) q F r ^ q :=
          fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le
        rw [lintegral_congr hpull, lintegral_const_mul' _ _ (by
          refine ENNReal.rpow_ne_top_of_nonneg hq0.le ?_
          rw [hW]
          exact ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
      rw [hconst]
      have hcov := lintegral_brsCoverMaj_rpow_le hE hδ hlen hFmeas hp1 hpq
      rw [hFnorm] at hcov
      calc W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q)
          ≤ W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)) *
              GA) := mul_le_mul' le_rfl hcov
        _ = W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
              GA := by ring
    rw [← min_mul_mul_right]
    exact le_min (hb1.trans (le_of_eq (by ring))) hb2
  -- assemble
  have hrewrite : (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) =
      ∫⁻ r : ℝ,
        Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ^ q := by
    rw [← lintegral_indicator (measurableSet_brsD E n)]
    refine lintegral_congr fun r => ?_
    by_cases hr : r ∈ brsD E n
    · rw [Set.indicator_of_mem hr, Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0]
  rw [hrewrite]
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_mono fun r => ENNReal.rpow_le_rpow (hpt r) hq0.le)
    (by positivity)) ?_
  refine le_trans (lintegral_rpow_tsum_le hq1 hΘmeas) ?_
  exact ENNReal.tsum_le_tsum hΘbound

/-! ## The two arms of the block estimate, evaluated

With the covering hypothesis of BRS (5.15) in hand, both arms of the minimum in
`lintegral_brsBlockMax_shell_le` become explicit powers of two: the covered arm
decays like `2^{-m(1/p-1/2)}` and does not see the block or the shell, while the
Hölder arm grows like `2^{m(1/p-1/2)}` but carries the factor
`(2^{-n}/A)^{2/p-1}`, which is the `ℓ`-decay. -/

theorem half_pow_eq (k : ℕ) : ((1 / 2 : ℝ) ^ k) = (2 : ℝ) ^ (-(k : ℝ)) := by
  rw [Real.rpow_neg (by norm_num), Real.rpow_natCast, one_div, inv_pow]

/-- Interpolation between the two arms of a minimum. -/
theorem min_le_rpow_mul_rpow {a b : ENNReal} {t : ℝ} (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    min a b ≤ a ^ (1 - t) * b ^ t := by
  have h : min a b = (min a b) ^ (1 - t) * (min a b) ^ t := by
    rw [← ENNReal.rpow_add_of_nonneg _ _ (by linarith) ht0]
    simp
  rw [h]
  exact mul_le_mul' (ENNReal.rpow_le_rpow (min_le_left a b) (by linarith))
    (ENNReal.rpow_le_rpow (min_le_right a b) ht0)

/-- **The covering hypothesis of BRS (5.15), in dyadic form.** -/
def HasBRSCoveringBound (E : Set ℝ) (p q AE : ℝ) : Prop :=
  ∀ δ : ℝ, 0 < δ → δ ≤ 6 →
    (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) ≤
      ENNReal.ofReal (AE * δ ^ (-(1 - 2 / p + 1 / q)))

/-- The real identity behind the covered arm. -/
theorem brs_arm_real_identity {A : ℝ} (hA : 0 < A) {p q : ℝ} (m : ℕ) :
    (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * (A / 2) ^ (-(1 / p) : ℝ)) *
      ((A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
        (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q))) =
      (2 : ℝ) ^ (5 / 2 + 1 / q) * (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hu0 : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
  have hθ : ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) =
      (2 : ℝ) ^ (((m : ℝ) + 1) / 2) := by
    rw [half_pow_eq, ← Real.rpow_mul h2.le]
    congr 1
    push_cast
    ring
  have hA2 : (A / 2 : ℝ) ^ (-(1 / p) : ℝ) =
      A ^ (-(1 / p) : ℝ) * (2 : ℝ) ^ (1 / p) := by
    rw [div_eq_mul_inv, Real.mul_rpow hA.le (by norm_num),
      Real.inv_rpow h2.le, ← Real.rpow_neg h2.le, neg_neg]
  have hupow : ∀ e : ℝ, (A * (1 / 2 : ℝ) ^ m) ^ e =
      A ^ e * (2 : ℝ) ^ (-((m : ℝ) * e)) := by
    intro e
    rw [half_pow_eq, Real.mul_rpow hA.le (Real.rpow_nonneg h2.le _),
      ← Real.rpow_mul h2.le]
    congr 2
    ring
  have h2u : ∀ e : ℝ, (2 * (A * (1 / 2 : ℝ) ^ m)) ^ e =
      (2 : ℝ) ^ e * (A ^ e * (2 : ℝ) ^ (-((m : ℝ) * e))) := by
    intro e
    rw [Real.mul_rpow h2.le hu0.le, hupow e]
  rw [hθ, hA2, hupow (-(1 - 2 / p + 1 / q)), h2u (1 - 1 / p + 1 / q)]
  have hAcancel : A ^ (-(1 / p) : ℝ) * A ^ (-(1 - 2 / p + 1 / q)) *
      A ^ (1 - 1 / p + 1 / q) = 1 := by
    rw [← Real.rpow_add hA, ← Real.rpow_add hA]
    have hzero : -(1 / p) + -(1 - 2 / p + 1 / q) + (1 - 1 / p + 1 / q) = 0 := by
      ring
    rw [hzero, Real.rpow_zero]
  have h2one : (2 : ℝ) = (2 : ℝ) ^ (1 : ℝ) := by
    rw [Real.rpow_one]
  calc (2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (A ^ (-(1 / p) : ℝ) * (2 : ℝ) ^ (1 / p)) *
        (A ^ (-(1 - 2 / p + 1 / q)) *
            (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
          (2 * ((2 : ℝ) ^ (1 - 1 / p + 1 / q) *
            (A ^ (1 - 1 / p + 1 / q) *
              (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q)))))))
      = (A ^ (-(1 / p) : ℝ) * A ^ (-(1 - 2 / p + 1 / q)) *
            A ^ (1 - 1 / p + 1 / q)) *
          ((2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (2 : ℝ) ^ (1 / p) *
            (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
            (2 : ℝ) ^ (1 : ℝ) * (2 : ℝ) ^ (1 - 1 / p + 1 / q) *
            (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q)))) := by
        rw [← h2one]
        ring
    _ = (2 : ℝ) ^ (((m : ℝ) + 1) / 2) * (2 : ℝ) ^ (1 / p) *
          (2 : ℝ) ^ (-((m : ℝ) * -(1 - 2 / p + 1 / q))) *
          (2 : ℝ) ^ (1 : ℝ) * (2 : ℝ) ^ (1 - 1 / p + 1 / q) *
          (2 : ℝ) ^ (-((m : ℝ) * (1 - 1 / p + 1 / q))) := by
        rw [hAcancel, one_mul]
    _ = (2 : ℝ) ^ ((((m : ℝ) + 1) / 2) + (1 / p) +
          (-((m : ℝ) * -(1 - 2 / p + 1 / q))) + (1 : ℝ) + (1 - 1 / p + 1 / q) +
          (-((m : ℝ) * (1 - 1 / p + 1 / q)))) := by
        rw [← Real.rpow_add h2, ← Real.rpow_add h2, ← Real.rpow_add h2,
          ← Real.rpow_add h2, ← Real.rpow_add h2]
    _ = (2 : ℝ) ^ (5 / 2 + 1 / q) * (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by
        rw [← Real.rpow_add h2]
        congr 1
        ring

/-- **The covered arm.** -/
theorem brs_cover_arm_le {E : Set ℝ} {p q AE : ℝ} (hp1 : 1 ≤ p) (_hq0 : 0 < q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE)
    {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (m : ℕ) :
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
        (A / 2) ^ (-(1 / p) : ℝ)) *
      ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
        (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) ≤
      ENNReal.ofReal (AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))))) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have h2 : (0 : ℝ) < 2 := by norm_num
  set u : ℝ := A * (1 / 2 : ℝ) ^ m with hu
  have hu0 : 0 < u := by rw [hu]; positivity
  have hu1 : u ≤ 6 := by
    rw [hu]
    have hpow : (1 / 2 : ℝ) ^ m ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have hcv := hcov u hu0 hu1
  have hpow2 : ENNReal.ofReal (2 * u) ^ (1 - 1 / p + 1 / q) =
      ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q)) :=
    ENNReal.ofReal_rpow_of_pos (by positivity)
  have hnn₁ : (0 : ℝ) ≤ ((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ) :=
    mul_nonneg (Real.rpow_nonneg (by positivity) _)
      (Real.rpow_nonneg (by positivity) _)
  rw [hpow2]
  calc ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
          (A / 2) ^ (-(1 / p) : ℝ)) *
        ((intervalCoveringNumber E u : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q))))
      ≤ ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          (ENNReal.ofReal (AE * u ^ (-(1 - 2 / p + 1 / q))) *
            (2 * ENNReal.ofReal ((2 * u) ^ (1 - 1 / p + 1 / q)))) :=
        mul_le_mul' le_rfl (mul_le_mul' hcv le_rfl)
    _ = ENNReal.ofReal ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          (AE * u ^ (-(1 - 2 / p + 1 / q)) *
            (2 * (2 * u) ^ (1 - 1 / p + 1 / q)))) := by
        rw [show (2 : ENNReal) = ENNReal.ofReal 2 from by
          rw [ENNReal.ofReal_ofNat]]
        rw [← ENNReal.ofReal_mul (by positivity),
          ← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hnn₁]
    _ = ENNReal.ofReal (AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
          (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))))) := by
        congr 1
        rw [hu] at *
        calc (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) * (A / 2) ^ (-(1 / p) : ℝ)) *
              (AE * (A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
                (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q)))
            = AE * ((((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((A * (1 / 2 : ℝ) ^ m) ^ (-(1 - 2 / p + 1 / q)) *
                (2 * (2 * (A * (1 / 2 : ℝ) ^ m)) ^ (1 - 1 / p + 1 / q)))) := by
              ring
          _ = AE * ((2 : ℝ) ^ (5 / 2 + 1 / q) *
                (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2)))) := by
              rw [brs_arm_real_identity hA0 m]

/-! ## The Hölder arm, evaluated

The Hölder arm is the constant bound times `|D_n|^{1/q}`; feeding
`volume_brsD_le` and the covering hypothesis at the shell scale turns it into
`2^{(m+1)(1/p-1/2)}·(2^{-n}/A)^{2/p-1}`, whose second factor is the `ℓ`-decay. -/

/-- The real identity behind the Hölder arm. -/
theorem brs_holder_real_identity {A σ : ℝ} (hA : 0 < A) (hσ : 0 < σ) {p q : ℝ}
    (m : ℕ) :
    (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
      ((7 * σ) ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q))) =
      (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * (σ / A) ^ (2 / p - 1) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hθ : ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) =
      (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) := by
    rw [half_pow_eq, ← Real.rpow_mul h2.le]
    congr 1
    push_cast
    ring
  have hA2 : (A / 2 : ℝ) ^ (1 - 2 / p) =
      A ^ (1 - 2 / p) * (2 : ℝ) ^ (2 / p - 1) := by
    rw [div_eq_mul_inv, Real.mul_rpow hA.le (by norm_num),
      Real.inv_rpow h2.le, ← Real.rpow_neg h2.le]
    congr 2
    ring
  have h7 : ((7 : ℝ) * σ) ^ (1 / q) = (7 : ℝ) ^ (1 / q) * σ ^ (1 / q) :=
    Real.mul_rpow (by norm_num) hσ.le
  have hquot : (σ / A) ^ (2 / p - 1) =
      σ ^ (2 / p - 1) * A ^ (1 - 2 / p) := by
    rw [div_eq_mul_inv, Real.mul_rpow hσ.le (by positivity),
      Real.inv_rpow hA.le, ← Real.rpow_neg hA.le]
    congr 2
    ring
  rw [hθ, hA2, h7, hquot]
  have hσcancel : σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)) = σ ^ (2 / p - 1) := by
    rw [← Real.rpow_add hσ]
    congr 1
    ring
  calc (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
        (A ^ (1 - 2 / p) * (2 : ℝ) ^ (2 / p - 1)) *
        ((7 : ℝ) ^ (1 / q) * σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)))
      = (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
          ((σ ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q))) * A ^ (1 - 2 / p)) := by
        ring
    _ = (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
          (σ ^ (2 / p - 1) * A ^ (1 - 2 / p)) := by
        rw [hσcancel]

/-- **The Hölder arm.** -/
theorem brs_holder_arm_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hq0 : 0 < q) (_hAE : 0 ≤ AE)
    (hcov : HasBRSCoveringBound E p q AE) {A : ℝ} (hA0 : 0 < A) (n m : ℕ) :
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
        (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q) ≤
      ENNReal.ofReal (AE * ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ (2 / p - 1))) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have h2 : (0 : ℝ) < 2 := by norm_num
  set σ : ℝ := (2 : ℝ) ^ (-(n : ℝ)) with hσdef
  have hσ0 : 0 < σ := by rw [hσdef]; positivity
  have hσ1 : σ ≤ 6 := by
    have hle : σ ≤ 1 := by
      rw [hσdef]
      refine Real.rpow_le_one_of_one_le_of_nonpos (by norm_num) ?_
      simp
    linarith
  have hzpow : ((2 : ℝ) ^ (-(n : ℤ))) = σ := by
    rw [hσdef, ← Real.rpow_intCast]
    congr 1
    push_cast
    ring
  -- the shell measure
  have hvol := volume_brsD_le hE hEne n
  rw [hzpow] at hvol
  have hnn : (0 : ℝ) ≤ ((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p) :=
    mul_nonneg (Real.rpow_nonneg (by positivity) _)
      (Real.rpow_nonneg (by positivity) _)
  have hstep : volume (brsD E n) ^ (1 / q) ≤
      ENNReal.ofReal ((7 * σ) ^ (1 / q)) *
        ENNReal.ofReal (AE * σ ^ (-(1 - 2 / p + 1 / q))) := by
    refine le_trans (ENNReal.rpow_le_rpow hvol (by positivity)) ?_
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
      ENNReal.ofReal_rpow_of_pos (by positivity)]
    exact mul_le_mul' le_rfl (hcov σ hσ0 hσ1)
  refine le_trans (mul_le_mul' le_rfl hstep) (le_of_eq ?_)
  rw [← ENNReal.ofReal_mul (by positivity), ← ENNReal.ofReal_mul hnn]
  congr 1
  calc (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
        ((7 * σ) ^ (1 / q) * (AE * σ ^ (-(1 - 2 / p + 1 / q))))
      = AE * ((((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) * (A / 2) ^ (1 - 2 / p)) *
          ((7 * σ) ^ (1 / q) * σ ^ (-(1 - 2 / p + 1 / q)))) := by ring
    _ = AE * ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
          (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * (σ / A) ^ (2 / p - 1)) := by
        rw [brs_holder_real_identity hA0 hσ0 m]

/-! ## Interpolating and summing the two arms

`min u v ≤ u^{1/4} v^{3/4}` turns the growing arm `2^{(m+1)β}x^{2β}` and the
decaying arm `2^{-mβ}` into the single summable term
`2^{β/4} x^{β/2} 2^{-mβ/2}`, whose `m`-sum is geometric. -/

theorem ofReal_min_eq (u v : ℝ) :
    ENNReal.ofReal (min u v) = min (ENNReal.ofReal u) (ENNReal.ofReal v) := by
  rcases le_total u v with h | h
  · rw [min_eq_left h, min_eq_left (ENNReal.ofReal_le_ofReal h)]
  · rw [min_eq_right h, min_eq_right (ENNReal.ofReal_le_ofReal h)]

/-- The real interpolation inequality. -/
theorem min_le_rpow_mul_rpow_real {u v : ℝ} (hu : 0 ≤ u) (hv : 0 ≤ v) :
    min u v ≤ u ^ ((1 : ℝ) / 4) * v ^ ((3 : ℝ) / 4) := by
  have hmin : (0 : ℝ) ≤ min u v := le_min hu hv
  have hsplit : min u v = (min u v) ^ ((1 : ℝ) / 4) * (min u v) ^ ((3 : ℝ) / 4) := by
    rw [← Real.rpow_add' hmin (by norm_num)]
    norm_num
  rw [hsplit]
  exact mul_le_mul (Real.rpow_le_rpow hmin (min_le_left u v) (by norm_num))
    (Real.rpow_le_rpow hmin (min_le_right u v) (by norm_num))
    (Real.rpow_nonneg hmin _) (Real.rpow_nonneg hu _)

/-- The geometric series in the piece index. -/
theorem tsum_two_rpow_neg_mul {β : ℝ} (hβ : 0 < β) :
    ∑' m : ℕ, (2 : ℝ) ^ (-((m : ℝ) * β)) = (1 - (2 : ℝ) ^ (-β))⁻¹ := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hr : ∀ m : ℕ, (2 : ℝ) ^ (-((m : ℝ) * β)) = ((2 : ℝ) ^ (-β)) ^ m := by
    intro m
    rw [← Real.rpow_natCast ((2 : ℝ) ^ (-β)) m, ← Real.rpow_mul h2.le]
    congr 1
    ring
  rw [tsum_congr hr]
  have hlt : (2 : ℝ) ^ (-β) < 1 := by
    refine Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) ?_
    linarith
  exact tsum_geometric_of_lt_one (Real.rpow_nonneg h2.le _) hlt

/-- **The interpolated per-piece bound.** -/
theorem brs_interp_term_le {C₁ C₂ β x : ℝ} (hC₁ : 0 ≤ C₁) (hC₂ : 0 ≤ C₂)
    (hx : 0 < x) (m : ℕ) :
    min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
        (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β))) ≤
      C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) * x ^ (β / 2) *
        (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hu : (0 : ℝ) ≤ C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
    have h1 : (0 : ℝ) ≤ (2 : ℝ) ^ (((m : ℝ) + 1) * β) := Real.rpow_nonneg h2.le _
    have h3 : (0 : ℝ) ≤ x ^ (2 * β) := Real.rpow_nonneg hx.le _
    positivity
  have hv : (0 : ℝ) ≤ C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
    have h1 : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * β)) := Real.rpow_nonneg h2.le _
    positivity
  refine le_trans (min_le_rpow_mul_rpow_real hu hv) (le_of_eq ?_)
  have hupow : (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β)) ^ ((1 : ℝ) / 4) =
      C₁ ^ ((1 : ℝ) / 4) * (2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) * x ^ (β / 2) := by
    rw [Real.mul_rpow (by positivity) (Real.rpow_nonneg hx.le _),
      Real.mul_rpow hC₁ (Real.rpow_nonneg h2.le _),
      ← Real.rpow_mul h2.le, ← Real.rpow_mul hx.le]
    congr 2 <;> ring
  have hvpow : (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β))) ^ ((3 : ℝ) / 4) =
      C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4)) := by
    rw [Real.mul_rpow hC₂ (Real.rpow_nonneg h2.le _), ← Real.rpow_mul h2.le]
    congr 2
    ring
  rw [hupow, hvpow]
  calc C₁ ^ ((1 : ℝ) / 4) * (2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) * x ^ (β / 2) *
        (C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4)))
      = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * x ^ (β / 2) *
          ((2 : ℝ) ^ ((((m : ℝ) + 1) * β) / 4) *
            (2 : ℝ) ^ (-(3 * (m : ℝ) * β / 4))) := by ring
    _ = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * x ^ (β / 2) *
          ((2 : ℝ) ^ (β / 4) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
        rw [← Real.rpow_add h2, ← Real.rpow_add h2]
        congr 1
        ring
    _ = C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) * x ^ (β / 2) *
          (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring

/-! ## The block estimate on a shell, evaluated

Combining the two evaluated arms with the interpolation and the geometric sum
gives the estimate for one shell and one dyadic block, with the `ℓ`-decay
`(2^{-n}/A)^{β/2}` explicit. -/

/-- The constant of the block estimate. -/
def brsBlockConst (p q : ℝ) : ℝ :=
  ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1)) ^ ((1 : ℝ) / 4) *
      ((2 : ℝ) ^ (5 / 2 + 1 / q)) ^ ((3 : ℝ) / 4) *
      (2 : ℝ) ^ ((1 / p - 1 / 2) / 4) *
    (1 - (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)))⁻¹

theorem brsBlockConst_nonneg {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) :
    0 ≤ brsBlockConst p q := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hlt : (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)) < 1 :=
    Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith)
  have hden : (0 : ℝ) < 1 - (2 : ℝ) ^ (-((1 / p - 1 / 2) / 2)) := by linarith
  rw [brsBlockConst]
  have h1 : (0 : ℝ) ≤ ((7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1)) ^ ((1 : ℝ) / 4) :=
    Real.rpow_nonneg (by positivity) _
  have h3 : (0 : ℝ) ≤ ((2 : ℝ) ^ (5 / 2 + 1 / q)) ^ ((3 : ℝ) / 4) :=
    Real.rpow_nonneg (by positivity) _
  have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ ((1 / p - 1 / 2) / 4) := Real.rpow_nonneg h2.le _
  positivity

/-- **The block estimate on a shell, evaluated.** -/
theorem lintegral_brsBlockMax_shell_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (n : ℕ) :
    (∫⁻ r in brsD E n, brsBlockMax E p g A r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ ((1 / p - 1 / 2) / 2)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hp1) hpq
  have h2 : (0 : ℝ) < 2 := by norm_num
  set β : ℝ := 1 / p - 1 / 2 with hβdef
  have hβ : 0 < β := by
    rw [hβdef]
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hβ2 : 2 * β = 2 / p - 1 := by rw [hβdef]; ring
  set x : ℝ := ((2 : ℝ) ^ (-(n : ℝ))) / A with hxdef
  have hx : 0 < x := by rw [hxdef]; positivity
  set C₁ : ℝ := (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) with hC₁
  set C₂ : ℝ := (2 : ℝ) ^ (5 / 2 + 1 / q) with hC₂
  have hC₁0 : 0 ≤ C₁ := by rw [hC₁]; positivity
  have hC₂0 : 0 ≤ C₂ := by rw [hC₂]; positivity
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the term-by-term bound
  have hterm : ∀ m : ℕ,
      min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
          (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
              (A / 2) ^ (-(1 / p) : ℝ)) *
            ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                (1 - 1 / p + 1 / q)))) ≤
        ENNReal.ofReal (AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) *
          (2 : ℝ) ^ (β / 4) * x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
    intro m
    have harm₁ := brs_holder_arm_le hE hEne hp1 hq0 hAE hcov hA0 n m
    have harm₂ := brs_cover_arm_le hp1 hq0 hAE hcov hA0 hA1 m
    have hmin := min_le_min harm₁ harm₂
    refine le_trans hmin ?_
    rw [← ofReal_min_eq]
    refine ENNReal.ofReal_le_ofReal ?_
    have hfact : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
        min (AE * a) (AE * b) = AE * min a b := by
      intro a b ha hb
      rcases le_total a b with h | h
      · rw [min_eq_left h, min_eq_left (mul_le_mul_of_nonneg_left h hAE)]
      · rw [min_eq_right h, min_eq_right (mul_le_mul_of_nonneg_left h hAE)]
    have ha0 : (0 : ℝ) ≤ (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) := by
      have : (0 : ℝ) ≤ x ^ (2 / p - 1) := Real.rpow_nonneg hx.le _
      positivity
    have hb0 : (0 : ℝ) ≤ (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by positivity
    rw [hfact _ _ ha0 hb0]
    have hshape₁ : (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) =
        C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
      rw [hC₁, hβdef, hβ2]
    have hshape₂ : (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) =
        C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
      rw [hC₂, hβdef]
    rw [hshape₁, hshape₂]
    have hinterp := brs_interp_term_le (β := β) hC₁0 hC₂0 hx m
    calc AE * min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
            (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)))
        ≤ AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) :=
          mul_le_mul_of_nonneg_left hinterp hAE
      _ = AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring
  -- the geometric sum
  set K : ℝ := AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
    x ^ (β / 2)) with hK
  have hK0 : 0 ≤ K := by
    rw [hK]
    have h1 : (0 : ℝ) ≤ C₁ ^ ((1 : ℝ) / 4) := Real.rpow_nonneg hC₁0 _
    have h3 : (0 : ℝ) ≤ C₂ ^ ((3 : ℝ) / 4) := Real.rpow_nonneg hC₂0 _
    have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ (β / 4) := Real.rpow_nonneg h2.le _
    have h5 : (0 : ℝ) ≤ x ^ (β / 2) := Real.rpow_nonneg hx.le _
    positivity
  have hsummable : Summable fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
    have hr : (fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) =
        fun m : ℕ => ((2 : ℝ) ^ (-(β / 2))) ^ m := by
      funext m
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (-(β / 2))) m, ← Real.rpow_mul h2.le]
      congr 1
      ring
    rw [hr]
    exact summable_geometric_of_lt_one (Real.rpow_nonneg h2.le _)
      (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith))
  have htsum : (∑' m : ℕ, ENNReal.ofReal (K * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))))) =
      ENNReal.ofReal (K * (1 - (2 : ℝ) ^ (-(β / 2)))⁻¹) := by
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by
      have : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := Real.rpow_nonneg h2.le _
      positivity) (hsummable.mul_left K)]
    rw [tsum_mul_left, tsum_two_rpow_neg_mul (by linarith : (0 : ℝ) < β / 2)]
  -- assemble
  refine le_trans (lintegral_brsBlockMax_shell_le hE hp1 hp2.le hpq hg hA0 n) ?_
  refine le_trans (ENNReal.tsum_le_tsum (fun m => mul_le_mul' (hterm m) le_rfl)) ?_
  rw [ENNReal.tsum_mul_right, htsum]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [hK, brsBlockConst, ← hβdef, ← hC₁, ← hC₂]
  ring

/-! ## The block majorant, as a definition

`brsBlockMax` is a supremum over an `r`-dependent uncountable set, so it cannot
be fed to Minkowski.  The `m`-sum of the two-armed majorants built inside
`lintegral_brsBlockMax_shell_le` is measurable and dominates it on the shell;
exposing it as a definition is what allows the outer sums to be taken. -/

/-- The measurable majorant of the block operator on a shell. -/
def brsBlockMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (A : ℝ) (n : ℕ) (r : ℝ) :
    ENNReal :=
  ∑' m : ℕ,
    min (Set.indicator (brsD E n)
          (fun _ => ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) *
            (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) r)
        (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
            (A / 2) ^ (-(1 / p) : ℝ)) *
          brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m)
            q (brsBlockProfile A g) r)

theorem measurable_brsBlockMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) (A : ℝ) (n : ℕ) :
    Measurable (brsBlockMaj E p q g A n) := by
  refine Measurable.tsum fun m => ?_
  refine Measurable.min ?_ ?_
  · exact measurable_const.indicator (measurableSet_brsD E n)
  · exact measurable_const.mul
      (measurable_brsCoverMaj _ _ _ _ _ (measurable_brsBlockProfile A hg))

/-- **The majorant dominates the block operator on the shell.** -/
theorem indicator_brsBlockMax_le_brsBlockMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (n : ℕ) (r : ℝ) :
    Set.indicator (brsD E n) (fun r => brsBlockMax E p g A r) r ≤
      brsBlockMaj E p q g A n r := by
  by_cases hr : r ∈ brsD E n
  · rw [Set.indicator_of_mem hr, brsBlockMaj]
    refine le_trans (brsBlockMax_le_tsum hA0 r) ?_
    refine ENNReal.tsum_le_tsum fun m => ?_
    refine le_min ?_ ?_
    · rw [Set.indicator_of_mem hr]
      exact brsBlockPieceMax_le_const hp1 hp2 hg hA0 m r
    · exact brsBlockPieceMax_le_cover hE hp1 hp2 hq0 hg hA0 m r
  · rw [Set.indicator_of_notMem hr]
    exact zero_le

/-- **The `L^q` bound for the block majorant.** -/
theorem lintegral_brsBlockMaj_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hp1 : 1 ≤ p) (_hp2 : p ≤ 2) (hpq : p ≤ q) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (n : ℕ) :
    (∫⁻ r : ℝ, brsBlockMaj E p q g A n r ^ q) ^ (1 / q) ≤
      ∑' m : ℕ,
        min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
                (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
            (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
                (A / 2) ^ (-(1 / p) : ℝ)) *
              ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
                (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                  (1 - 1 / p + 1 / q)))) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  set F : ℝ → ENNReal := brsBlockProfile A g with hFdef
  have hFmeas : Measurable F := measurable_brsBlockProfile A hg
  have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = GA := by
    rw [hFdef, lintegral_brsBlockProfile_rpow A hp0, hGA]
  set CH : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
      (A / 2) ^ (1 - 2 / p)) with hCH
  set W : ℕ → ENNReal := fun m =>
    ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
      (A / 2) ^ (-(1 / p) : ℝ)) with hW
  set Θ : ℕ → ℝ → ENNReal := fun m r =>
    min (Set.indicator (brsD E n) (fun _ => CH m * GA) r)
      (W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
        (A * (1 / 2) ^ m) q F r) with hΘ
  have hΘmeas : ∀ m : ℕ, Measurable (Θ m) := by
    intro m
    refine Measurable.min ?_ ?_
    · exact measurable_const.indicator (measurableSet_brsD E n)
    · exact measurable_const.mul (measurable_brsCoverMaj _ _ _ _ _ hFmeas)
  have hΘbound : ∀ m : ℕ, (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
      min (CH m * volume (brsD E n) ^ (1 / q))
        (W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)))) *
        GA := by
    intro m
    have hδ : (0 : ℝ) < A * (1 / 2 : ℝ) ^ m := by positivity
    have hlen : A * (1 / 2 : ℝ) ^ m - A * (1 / 2 : ℝ) ^ (m + 2) ≤
        A * (1 / 2 : ℝ) ^ m := by
      have : (0 : ℝ) ≤ A * (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hb1 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        CH m * GA * volume (brsD E n) ^ (1 / q) := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          Set.indicator (brsD E n) (fun _ => CH m * GA) r :=
        fun r => min_le_left _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      exact le_of_eq (lintegral_indicator_const_rpow (measurableSet_brsD E n) hq0)
    have hb2 : (∫⁻ r : ℝ, Θ m r ^ q) ^ (1 / q) ≤
        W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
          (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
          GA := by
      have hmono : ∀ r : ℝ, Θ m r ≤
          W m * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r := fun r => min_le_right _ _
      refine le_trans (ENNReal.rpow_le_rpow
        (lintegral_mono fun r => ENNReal.rpow_le_rpow (hmono r) hq0.le)
        (by positivity)) ?_
      have hconst : (∫⁻ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
          (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q) ^ (1 / q) =
          W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q) := by
        have hpull : ∀ r : ℝ, (W m * brsCoverMaj E (A * (1 / 2) ^ m)
            (A * (1 / 2) ^ (m + 2)) (A * (1 / 2) ^ m) q F r) ^ q =
            W m ^ q * brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
              (A * (1 / 2) ^ m) q F r ^ q :=
          fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le
        rw [lintegral_congr hpull, lintegral_const_mul' _ _ (by
          refine ENNReal.rpow_ne_top_of_nonneg hq0.le ?_
          rw [hW]
          exact ENNReal.ofReal_ne_top),
          ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
      rw [hconst]
      have hcov := lintegral_brsCoverMaj_rpow_le hE hδ hlen hFmeas hp1 hpq
      rw [hFnorm] at hcov
      calc W m * (∫⁻ r : ℝ, brsCoverMaj E (A * (1 / 2) ^ m) (A * (1 / 2) ^ (m + 2))
            (A * (1 / 2) ^ m) q F r ^ q) ^ (1 / q)
          ≤ W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q)) *
              GA) := mul_le_mul' le_rfl hcov
        _ = W m * ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^ (1 - 1 / p + 1 / q))) *
              GA := by ring
    rw [← min_mul_mul_right]
    exact le_min (hb1.trans (le_of_eq (by ring))) hb2
  have hshape : ∀ r : ℝ, brsBlockMaj E p q g A n r = ∑' m : ℕ, Θ m r := by
    intro r
    rw [brsBlockMaj, hΘ, hCH, hW, hGA, hFdef]
  rw [lintegral_congr fun r => by rw [hshape r]]
  refine le_trans (lintegral_rpow_tsum_le hq1 hΘmeas) ?_
  exact ENNReal.tsum_le_tsum hΘbound

/-! ## Summing over disjointly supported pieces

The shells are disjoint and the block majorant vanishes off its shell, so the
`n`-sum costs nothing: the `L^q` norm of the sum is the `ℓ^q` sum of the
norms. -/

/-- **The `L^q` norm of a sum of disjointly supported functions.** -/
theorem lintegral_rpow_tsum_disjoint {S : ℕ → Set ℝ}
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (Function.onFun Disjoint S))
    {F : ℕ → ℝ → ENNReal} (_hF : ∀ i, Measurable (F i))
    (hsupp : ∀ i, ∀ r : ℝ, r ∉ S i → F i r = 0) {q : ℝ} (hq0 : 0 < q) :
    (∫⁻ r : ℝ, (∑' i : ℕ, F i r) ^ q) = ∑' i : ℕ, ∫⁻ r : ℝ, F i r ^ q := by
  have hzero : ∀ r : ℝ, r ∉ (⋃ i, S i) → (∑' i : ℕ, F i r) ^ q = 0 := by
    intro r hr
    have hall : ∀ i : ℕ, F i r = 0 := by
      intro i
      exact hsupp i r fun hi => hr (Set.mem_iUnion.mpr ⟨i, hi⟩)
    rw [tsum_congr hall, tsum_zero, ENNReal.zero_rpow_of_pos hq0]
  have hind : ∀ r : ℝ, (∑' i : ℕ, F i r) ^ q =
      Set.indicator (⋃ i, S i) (fun r => (∑' i : ℕ, F i r) ^ q) r := by
    intro r
    by_cases hr : r ∈ (⋃ i, S i)
    · rw [Set.indicator_of_mem hr]
    · rw [Set.indicator_of_notMem hr, hzero r hr]
  have hUmeas : MeasurableSet (⋃ i, S i) := MeasurableSet.iUnion hS
  rw [lintegral_congr hind, lintegral_indicator hUmeas,
    lintegral_iUnion hS hd]
  refine tsum_congr fun i => ?_
  have hres : (∫⁻ r in S i, (∑' j : ℕ, F j r) ^ q) =
      ∫⁻ r in S i, F i r ^ q := by
    refine setLIntegral_congr_fun (hS i) ?_
    intro r hr
    have hsingle : (∑' j : ℕ, F j r) = F i r := by
      refine tsum_eq_single i fun j hj => ?_
      refine hsupp j r fun hjr => ?_
      exact absurd rfl ((hd hj).ne_of_mem hjr hr)
    show (∑' j : ℕ, F j r) ^ q = F i r ^ q
    rw [hsingle]
  rw [hres]
  have houter : (∫⁻ r : ℝ, F i r ^ q) = ∫⁻ r in S i, F i r ^ q := by
    have hzero' : ∀ r : ℝ, r ∉ S i → F i r ^ q = 0 := by
      intro r hr
      rw [hsupp i r hr, ENNReal.zero_rpow_of_pos hq0]
    have hind' : ∀ r : ℝ, F i r ^ q =
        Set.indicator (S i) (fun r => F i r ^ q) r := by
      intro r
      by_cases hr : r ∈ S i
      · rw [Set.indicator_of_mem hr]
      · rw [Set.indicator_of_notMem hr, hzero' r hr]
    rw [lintegral_congr hind', lintegral_indicator (hS i)]
  rw [houter]

/-- The block majorant vanishes off its shell. -/
theorem brsBlockMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ} {A : ℝ}
    {n : ℕ} {r : ℝ} (hr : r ∉ brsD E n) : brsBlockMaj E p q g A n r = 0 := by
  rw [brsBlockMaj, ENNReal.tsum_eq_zero]
  intro m
  rw [Set.indicator_of_notMem hr]
  exact min_eq_left zero_le

/-! ## Bounded overlap of the block windows

The `s`-window of the `i`-th block is `(2^{-i}, 4·2^{-i}]`, the union of two
intervals from tiling families.  So the windows overlap at most twice and the
`i`-sum of the localized `L^p` norms costs only a factor two. -/

/-- Two tiling families cover the block window. -/
theorem block_window_eq_union (i : ℕ) :
    Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) =
      Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i) ∪
        Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) := by
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ i := by positivity
  rw [Set.Ioc_union_Ioc_eq_Ioc (by linarith) (by linarith)]

/-- The first tiling family is disjoint. -/
theorem block_window_lower_disjoint :
    Pairwise (Function.onFun Disjoint
      (fun i : ℕ => Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i))) := by
  intro i j hij
  have key : ∀ a b : ℕ, a < b →
      Disjoint (Ioc ((1 / 2 : ℝ) ^ a) (2 * (1 / 2 : ℝ) ^ a))
        (Ioc ((1 / 2 : ℝ) ^ b) (2 * (1 / 2 : ℝ) ^ b)) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun s hs hs' => ?_
    have hmono : (1 / 2 : ℝ) ^ b ≤ (1 / 2 : ℝ) ^ (a + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have hsucc : (2 : ℝ) * (1 / 2 : ℝ) ^ (a + 1) = (1 / 2 : ℝ) ^ a := by
      rw [pow_succ]; ring
    have h1 : s ≤ 2 * (1 / 2 : ℝ) ^ b := hs'.2
    have h2 : (1 / 2 : ℝ) ^ a < s := hs.1
    nlinarith
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h
  · exact (key j i h).symm

/-- The second tiling family is disjoint. -/
theorem block_window_upper_disjoint :
    Pairwise (Function.onFun Disjoint
      (fun i : ℕ => Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i))) := by
  intro i j hij
  have key : ∀ a b : ℕ, a < b →
      Disjoint (Ioc (2 * (1 / 2 : ℝ) ^ a) (4 * (1 / 2 : ℝ) ^ a))
        (Ioc (2 * (1 / 2 : ℝ) ^ b) (4 * (1 / 2 : ℝ) ^ b)) := by
    intro a b hab
    refine Set.disjoint_left.mpr fun s hs hs' => ?_
    have hmono : (1 / 2 : ℝ) ^ b ≤ (1 / 2 : ℝ) ^ (a + 1) :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
    have hsucc : (4 : ℝ) * (1 / 2 : ℝ) ^ (a + 1) = 2 * (1 / 2 : ℝ) ^ a := by
      rw [pow_succ]; ring
    have h1 : s ≤ 4 * (1 / 2 : ℝ) ^ b := hs'.2
    have h2 : 2 * (1 / 2 : ℝ) ^ a < s := hs.1
    nlinarith
  rcases lt_or_gt_of_ne hij with h | h
  · exact key i j h
  · exact (key j i h).symm

/-- Summing a nonnegative integrand over a disjoint family costs nothing. -/
theorem tsum_setLIntegral_le_of_disjoint {S : ℕ → Set ℝ}
    (hS : ∀ i, MeasurableSet (S i)) (hd : Pairwise (Function.onFun Disjoint S))
    (h : ℝ → ENNReal) :
    (∑' i : ℕ, ∫⁻ s in S i, h s) ≤ ∫⁻ s : ℝ, h s := by
  rw [← lintegral_iUnion hS hd]
  exact setLIntegral_le_lintegral _ _

/-- **Bounded overlap of the block windows.** -/
theorem tsum_lintegral_block_windows_le {h : ℝ → ENNReal} :
    (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) ≤
      2 * ∫⁻ s : ℝ, h s := by
  have hsplit : ∀ i : ℕ,
      (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) ≤
        (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s := by
    intro i
    rw [block_window_eq_union i]
    exact lintegral_union_le _ _ _
  calc (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s)
      ≤ ∑' i : ℕ, ((∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s) :=
        ENNReal.tsum_le_tsum hsplit
    _ = (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (2 * (1 / 2 : ℝ) ^ i), h s) +
          ∑' i : ℕ, ∫⁻ s in Ioc (2 * (1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i), h s :=
        ENNReal.tsum_add
    _ ≤ (∫⁻ s : ℝ, h s) + ∫⁻ s : ℝ, h s :=
        add_le_add
          (tsum_setLIntegral_le_of_disjoint (fun _ => measurableSet_Ioc)
            block_window_lower_disjoint h)
          (tsum_setLIntegral_le_of_disjoint (fun _ => measurableSet_Ioc)
            block_window_upper_disjoint h)
    _ = 2 * ∫⁻ s : ℝ, h s := by rw [two_mul]

/-! ## The block majorant estimate, evaluated

The same arithmetic as for `brsBlockMax`, applied to its measurable majorant. -/

/-- **The block majorant estimate, evaluated.** -/
theorem lintegral_brsBlockMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) {A : ℝ} (hA0 : 0 < A) (hA1 : A ≤ 2) (n : ℕ) :
    (∫⁻ r : ℝ, brsBlockMaj E p q g A n r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
        (((2 : ℝ) ^ (-(n : ℝ))) / A) ^ ((1 / p - 1 / 2) / 2)) *
        (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le (lt_of_lt_of_le zero_lt_one hp1) hpq
  have h2 : (0 : ℝ) < 2 := by norm_num
  set β : ℝ := 1 / p - 1 / 2 with hβdef
  have hβ : 0 < β := by
    rw [hβdef]
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hβ2 : 2 * β = 2 / p - 1 := by rw [hβdef]; ring
  set x : ℝ := ((2 : ℝ) ^ (-(n : ℝ))) / A with hxdef
  have hx : 0 < x := by rw [hxdef]; positivity
  set C₁ : ℝ := (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) with hC₁
  set C₂ : ℝ := (2 : ℝ) ^ (5 / 2 + 1 / q) with hC₂
  have hC₁0 : 0 ≤ C₁ := by rw [hC₁]; positivity
  have hC₂0 : 0 ≤ C₂ := by rw [hC₂]; positivity
  set GA : ENNReal :=
    (∫⁻ s in Ioc (A / 2) (2 * A), ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the term-by-term bound
  have hterm : ∀ m : ℕ,
      min (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (1 / 2 - 1 / p) *
              (A / 2) ^ (1 - 2 / p)) * volume (brsD E n) ^ (1 / q))
          (ENNReal.ofReal (((1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 / 2) : ℝ) *
              (A / 2) ^ (-(1 / p) : ℝ)) *
            ((intervalCoveringNumber E (A * (1 / 2) ^ m) : ENNReal) ^ (1 / q) *
              (2 * ENNReal.ofReal (2 * (A * (1 / 2) ^ m)) ^
                (1 - 1 / p + 1 / q)))) ≤
        ENNReal.ofReal (AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) *
          (2 : ℝ) ^ (β / 4) * x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) := by
    intro m
    have harm₁ := brs_holder_arm_le hE hEne hp1 hq0 hAE hcov hA0 n m
    have harm₂ := brs_cover_arm_le hp1 hq0 hAE hcov hA0 hA1 m
    have hmin := min_le_min harm₁ harm₂
    refine le_trans hmin ?_
    rw [← ofReal_min_eq]
    refine ENNReal.ofReal_le_ofReal ?_
    have hfact : ∀ a b : ℝ, 0 ≤ a → 0 ≤ b →
        min (AE * a) (AE * b) = AE * min a b := by
      intro a b ha hb
      rcases le_total a b with h | h
      · rw [min_eq_left h, min_eq_left (mul_le_mul_of_nonneg_left h hAE)]
      · rw [min_eq_right h, min_eq_right (mul_le_mul_of_nonneg_left h hAE)]
    have ha0 : (0 : ℝ) ≤ (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) := by
      have : (0 : ℝ) ≤ x ^ (2 / p - 1) := Real.rpow_nonneg hx.le _
      positivity
    have hb0 : (0 : ℝ) ≤ (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) := by positivity
    rw [hfact _ _ ha0 hb0]
    have hshape₁ : (7 : ℝ) ^ (1 / q) * (2 : ℝ) ^ (2 / p - 1) *
        (2 : ℝ) ^ (((m : ℝ) + 1) * (1 / p - 1 / 2)) * x ^ (2 / p - 1) =
        C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β) := by
      rw [hC₁, hβdef, hβ2]
    have hshape₂ : (2 : ℝ) ^ (5 / 2 + 1 / q) *
        (2 : ℝ) ^ (-((m : ℝ) * (1 / p - 1 / 2))) =
        C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)) := by
      rw [hC₂, hβdef]
    rw [hshape₁, hshape₂]
    have hinterp := brs_interp_term_le (β := β) hC₁0 hC₂0 hx m
    calc AE * min (C₁ * (2 : ℝ) ^ (((m : ℝ) + 1) * β) * x ^ (2 * β))
            (C₂ * (2 : ℝ) ^ (-((m : ℝ) * β)))
        ≤ AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) :=
          mul_le_mul_of_nonneg_left hinterp hAE
      _ = AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
            x ^ (β / 2)) * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by ring
  -- the geometric sum
  set K : ℝ := AE * (C₁ ^ ((1 : ℝ) / 4) * C₂ ^ ((3 : ℝ) / 4) * (2 : ℝ) ^ (β / 4) *
    x ^ (β / 2)) with hK
  have hK0 : 0 ≤ K := by
    rw [hK]
    have h1 : (0 : ℝ) ≤ C₁ ^ ((1 : ℝ) / 4) := Real.rpow_nonneg hC₁0 _
    have h3 : (0 : ℝ) ≤ C₂ ^ ((3 : ℝ) / 4) := Real.rpow_nonneg hC₂0 _
    have h4 : (0 : ℝ) ≤ (2 : ℝ) ^ (β / 4) := Real.rpow_nonneg h2.le _
    have h5 : (0 : ℝ) ≤ x ^ (β / 2) := Real.rpow_nonneg hx.le _
    positivity
  have hsummable : Summable fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := by
    have hr : (fun m : ℕ => (2 : ℝ) ^ (-((m : ℝ) * (β / 2)))) =
        fun m : ℕ => ((2 : ℝ) ^ (-(β / 2))) ^ m := by
      funext m
      rw [← Real.rpow_natCast ((2 : ℝ) ^ (-(β / 2))) m, ← Real.rpow_mul h2.le]
      congr 1
      ring
    rw [hr]
    exact summable_geometric_of_lt_one (Real.rpow_nonneg h2.le _)
      (Real.rpow_lt_one_of_one_lt_of_neg (by norm_num) (by linarith))
  have htsum : (∑' m : ℕ, ENNReal.ofReal (K * (2 : ℝ) ^ (-((m : ℝ) * (β / 2))))) =
      ENNReal.ofReal (K * (1 - (2 : ℝ) ^ (-(β / 2)))⁻¹) := by
    rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by
      have : (0 : ℝ) ≤ (2 : ℝ) ^ (-((m : ℝ) * (β / 2))) := Real.rpow_nonneg h2.le _
      positivity) (hsummable.mul_left K)]
    rw [tsum_mul_left, tsum_two_rpow_neg_mul (by linarith : (0 : ℝ) < β / 2)]
  -- assemble
  refine le_trans (lintegral_brsBlockMaj_rpow_le hE hp1 hp2.le hpq hg hA0 n) ?_
  refine le_trans (ENNReal.tsum_le_tsum (fun m => mul_le_mul' (hterm m) le_rfl)) ?_
  rw [ENNReal.tsum_mul_right, htsum]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [hK, brsBlockConst, ← hβdef, ← hC₁, ← hC₂]
  ring

/-! ## The `(k, i)` reindexing

The shell index `n` and the block index `j` are replaced by `k = n - j` and
`i = j`.  The point of the change is that the `s`-window then moves with the
outer index, which is what makes the `ℓ^p ↪ ℓ^q` step work. -/

/-- The block majorant, indexed by `(k, i)`: shell `k + i`, block `A_i = 2·2^{-i}`. -/
def brsShellMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (k i : ℕ) (r : ℝ) : ENNReal :=
  brsBlockMaj E p q g (2 * (1 / 2 : ℝ) ^ i) (k + i) r

theorem measurable_brsShellMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) (k i : ℕ) : Measurable (brsShellMaj E p q g k i) :=
  measurable_brsBlockMaj E p q hg _ _

theorem brsShellMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ}
    {k i : ℕ} {r : ℝ} (hr : r ∉ brsD E (k + i)) :
    brsShellMaj E p q g k i r = 0 :=
  brsBlockMaj_eq_zero_of_notMem hr

/-- On a shell, blocks finer than the shell are empty. -/
theorem brsBlockMax_eq_zero_of_lt {E : Set ℝ} {p : ℝ} {g : ℝ → ℂ} {n j : ℕ}
    (hj : n < j) {r : ℝ} (hr : r ∈ brsD E n) :
    brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (zero_le)
  exfalso
  obtain ⟨htE, ht1, ht2⟩ := ht
  have hdist := lt_infDist_of_mem_brsD hr
  have hle : Metric.infDist r E ≤ |r - t| := by
    have h := Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  have hzp : ((2 : ℝ) ^ (-(n : ℤ))) = (1 / 2 : ℝ) ^ n := by
    rw [zpow_neg, zpow_natCast, one_div, inv_pow]
  rw [hzp] at hdist
  have hmono : (1 / 2 : ℝ) ^ j ≤ (1 / 2 : ℝ) ^ (n + 1) :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have hsucc : (2 : ℝ) * (1 / 2 : ℝ) ^ (n + 1) = (1 / 2 : ℝ) ^ n := by
    rw [pow_succ]; ring
  have h1 : |r - t| < 2 * (1 / 2 : ℝ) ^ j := ht2
  nlinarith

/-- **The pointwise bound in the `(k, i)` indexing.** -/
theorem brsMainZeroLeft_le_tsum_shellMaj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q)
    {g : ℝ → ℂ} (hg : Measurable g) {r : ℝ} (hr : r ∉ closure E) :
    brsMainZeroLeft E p g r ≤
      ENNReal.ofReal (3 / 2) * ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r := by
  rcases Set.eq_empty_or_nonempty (E ∩ Ioo (r / 2) (3 * r / 2)) with hw | ⟨t, ht⟩
  · rw [brsMainZeroLeft, hw]
    simp
  · obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hr0 : (0 : ℝ) < r := by linarith
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith
    -- the radius sits in a shell
    have hdist : Metric.infDist r E ≤ |r - t| := by
      have h := Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    have habs : |r - t| < r / 2 := by
      rw [abs_lt]
      constructor <;> linarith
    have hU : r ∈ brsU E 0 := by
      show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-((0 : ℕ) : ℤ))
      simp only [Nat.cast_zero, neg_zero, zpow_zero, mul_one]
      linarith
    have hne : Metric.infDist r E ≠ 0 := by
      intro hzero
      exact hr ((Metric.mem_closure_iff_infDist_zero hEne).mpr hzero)
    have hmem : r ∈ ⋃ n, brsD E n := by
      by_contra hcon
      exact hne (infDist_eq_zero_of_notMem_iUnion_brsD hU hcon)
    obtain ⟨n, hn⟩ := Set.mem_iUnion.mp hmem
    -- the block decomposition, reindexed
    refine le_trans (brsMainZeroLeft_le_tsum_blocks hE r) ?_
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) ?_
    have hinj : Function.Injective (fun j : ℕ => (n - j, j)) := by
      intro a b hab
      exact congrArg Prod.snd hab
    have hstep : ∀ j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r ≤
        brsShellMaj E p q g (n - j) j r := by
      intro j
      by_cases hj : j ≤ n
      · have hidx : (n - j) + j = n := by omega
        rw [brsShellMaj, hidx]
        have h := indicator_brsBlockMax_le_brsBlockMaj hE hp1 hp2 hq0 hg
          (A := 2 * (1 / 2 : ℝ) ^ j) (by positivity) n r
        rwa [Set.indicator_of_mem hn] at h
      · rw [brsBlockMax_eq_zero_of_lt (by omega) hn]
        exact zero_le
    calc (∑' j : ℕ, brsBlockMax E p g (2 * (1 / 2 : ℝ) ^ j) r)
        ≤ ∑' kj : ℕ × ℕ, brsShellMaj E p q g kj.1 kj.2 r := by
          exact ENNReal.summable.tsum_le_tsum_of_inj (fun j : ℕ => (n - j, j)) hinj
            (fun c _ => zero_le) hstep ENNReal.summable
      _ = ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r :=
          ENNReal.tsum_prod (f := fun a b => brsShellMaj E p q g a b r)

/-! ## Two small tools for the final assembly -/

/-- `ℓ^1 ↪ ℓ^s` for `s ≥ 1`. -/
theorem tsum_rpow_le_rpow_tsum {a : ℕ → ENNReal} {s : ℝ} (hs : 1 ≤ s) :
    (∑' i : ℕ, a i ^ s) ≤ (∑' i : ℕ, a i) ^ s := by
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs
  set A : ENNReal := ∑' i : ℕ, a i with hA
  by_cases hAtop : A = ⊤
  · rw [hAtop, ENNReal.top_rpow_of_pos hs0]
    exact le_top
  · have hstep : ∀ i : ℕ, a i ^ s ≤ a i * A ^ (s - 1) := by
      intro i
      have hle : a i ≤ A := ENNReal.le_tsum i
      calc a i ^ s = a i ^ (1 + (s - 1)) := by congr 1; ring
        _ = a i ^ (1 : ℝ) * a i ^ (s - 1) :=
            ENNReal.rpow_add_of_nonneg _ _ zero_le_one (by linarith)
        _ = a i * a i ^ (s - 1) := by rw [ENNReal.rpow_one]
        _ ≤ a i * A ^ (s - 1) :=
            mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hle (by linarith))
    calc (∑' i : ℕ, a i ^ s) ≤ ∑' i : ℕ, a i * A ^ (s - 1) :=
          ENNReal.tsum_le_tsum hstep
      _ = A * A ^ (s - 1) := by rw [ENNReal.tsum_mul_right, ← hA]
      _ = A ^ s := by
          nth_rewrite 1 [show A = A ^ (1 : ℝ) from (ENNReal.rpow_one A).symm]
          rw [← ENNReal.rpow_add_of_nonneg _ _ zero_le_one (by linarith)]
          congr 1
          ring

/-- `𝔐_{p,0}^-` vanishes off the radial window. -/
theorem brsMainZeroLeft_eq_zero {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    {g : ℝ → ℂ} {r : ℝ} (hr : r ∉ Ioo (2 / 3 : ℝ) 4) :
    brsMainZeroLeft E p g r = 0 := by
  rw [brsMainZeroLeft, brsMainWindow_empty hE hr]
  simp

/-- The radial weight is bounded on the support. -/
theorem ofReal_mul_brsMainZeroLeft_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {p q : ℝ} (hq0 : 0 < q) {g : ℝ → ℂ} (r : ℝ) :
    ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      ENNReal.ofReal 4 * brsMainZeroLeft E p g r ^ q := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · exact mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
  · rw [brsMainZeroLeft_eq_zero hE hr, ENNReal.zero_rpow_of_pos hq0, mul_zero,
      mul_zero]

/-- The shells used by the `(k, i)` indexing are disjoint in `i`. -/
theorem brsD_shift_disjoint (E : Set ℝ) (k : ℕ) :
    Pairwise (Function.onFun Disjoint (fun i : ℕ => brsD E (k + i))) := by
  intro i j hij
  exact brsD_disjoint E (by omega)

/-! ## Dyadic powers, and the geometric sum in the outer index -/

theorem half_rpow (t : ℝ) : ((1 : ℝ) / 2) ^ t = (2 : ℝ) ^ (-t) := by
  rw [one_div, Real.inv_rpow (by norm_num), Real.rpow_neg (by norm_num)]

theorem half_pow_rpow (k : ℕ) (e : ℝ) :
    ((1 / 2 : ℝ) ^ k) ^ e = ((1 / 2 : ℝ) ^ e) ^ k := by
  have h2 : (0 : ℝ) < 2 := by norm_num
  rw [half_pow_eq, ← Real.rpow_mul h2.le, half_rpow,
    ← Real.rpow_natCast ((2 : ℝ) ^ (-e)) k, ← Real.rpow_mul h2.le]
  congr 1
  ring

/-- The geometric sum in the outer index. -/
theorem tsum_ofReal_half_pow {C ρ : ℝ} (hC : 0 ≤ C) (hρ0 : 0 < ρ) (hρ1 : ρ < 1) :
    (∑' k : ℕ, ENNReal.ofReal (C * ρ ^ (k + 1))) =
      ENNReal.ofReal (C * (ρ / (1 - ρ))) := by
  have hsummable : Summable fun k : ℕ => C * ρ ^ (k + 1) := by
    have h : Summable fun k : ℕ => ρ ^ k := summable_geometric_of_lt_one hρ0.le hρ1
    exact ((h.mul_left ρ).congr fun k => by rw [pow_succ]; ring).mul_left C
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun k => by positivity) hsummable,
    tsum_mul_left]
  congr 1
  congr 1
  have hshift : (∑' k : ℕ, ρ ^ (k + 1)) = ρ * ∑' k : ℕ, ρ ^ k := by
    rw [← tsum_mul_left]
    exact tsum_congr fun k => by rw [pow_succ]; ring
  rw [hshift, tsum_geometric_of_lt_one hρ0.le hρ1]
  field_simp

/-- The constant of BRS Proposition 5.5(ii) for the near half. -/
def brsMainZeroConst (p q : ℝ) : ℝ :=
  (4 : ℝ) ^ (1 / q) * (3 / 2) * brsBlockConst p q *
      ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
        (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2))) *
    (2 : ℝ) ^ (1 / p)

/-! ## The block estimate in the `(k, i)` indexing

The ratio `2^{-n}/A` becomes `2^{-(k+1)}`, depending only on the outer index,
and the `s`-window becomes `(2^{-i}, 4·2^{-i}]`, depending only on the inner
one.  That separation is the whole point of the reindexing. -/

theorem shell_ratio_eq (k i : ℕ) :
    ((2 : ℝ) ^ (-((k + i : ℕ) : ℝ))) / (2 * (1 / 2 : ℝ) ^ i) =
      (1 / 2 : ℝ) ^ (k + 1) := by
  have hi : (0 : ℝ) < (1 / 2 : ℝ) ^ i := by positivity
  rw [← half_pow_eq, pow_add, pow_succ]
  field_simp

theorem shell_window_eq (i : ℕ) :
    Ioc ((2 * (1 / 2 : ℝ) ^ i) / 2) (2 * (2 * (1 / 2 : ℝ) ^ i)) =
      Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i) := by
  congr 1 <;> ring

/-- **The block estimate, reindexed.** -/
theorem lintegral_brsShellMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) (k i : ℕ) :
    (∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) *
        (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
          ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hA0 : (0 : ℝ) < 2 * (1 / 2 : ℝ) ^ i := by positivity
  have hA1 : 2 * (1 / 2 : ℝ) ^ i ≤ 2 := by
    have hpow : (1 / 2 : ℝ) ^ i ≤ 1 := pow_le_one₀ (by norm_num) (by norm_num)
    nlinarith
  have h := lintegral_brsBlockMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg hA0 hA1
    (k + i)
  simp only [brsShellMaj]
  refine le_trans h (le_of_eq ?_)
  rw [shell_window_eq i, shell_ratio_eq k i, half_pow_rpow]

/-! ## The inner sum: one outer index, all shells

For a fixed outer index `k` the shells are disjoint, so the `L^q` norm is the
`ℓ^q` sum; and the `s`-windows have bounded overlap, so `ℓ^p ↪ ℓ^q` turns that
into `‖g‖_p`. -/

theorem lintegral_tsum_brsShellMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) (k : ℕ) :
    (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set K : ENNReal := ENNReal.ofReal (AE * brsBlockConst p q *
    ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)) ^ (k + 1)) with hK
  set GA : ℕ → ENNReal := fun i =>
    (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
      ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGA
  -- the shells are disjoint, so the `L^q` norm is the `ℓ^q` sum
  have hdisj : (∫⁻ r : ℝ, (∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) =
      ∑' i : ℕ, ∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q :=
    lintegral_rpow_tsum_disjoint (fun i => measurableSet_brsD E (k + i))
      (brsD_shift_disjoint E k) (fun i => measurable_brsShellMaj E p q hg k i)
      (fun i r hr => brsShellMaj_eq_zero_of_notMem hr) hq0
  rw [hdisj]
  -- each shell
  have hterm : ∀ i : ℕ, (∫⁻ r : ℝ, brsShellMaj E p q g k i r ^ q) ≤
      K ^ q * GA i ^ q := by
    intro i
    have h := lintegral_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k i
    have h' := ENNReal.rpow_le_rpow h hq0.le
    rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at h'
    refine le_trans h' (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, hK, hGA]
  refine le_trans (ENNReal.rpow_le_rpow (ENNReal.tsum_le_tsum hterm)
    (by positivity : (0 : ℝ) ≤ 1 / q)) ?_
  rw [ENNReal.tsum_mul_left]
  -- the windows have bounded overlap
  have hsq : ∀ i : ℕ, GA i ^ q =
      (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
        ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
    intro i
    rw [hGA, ← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hoverlap : (∑' i : ℕ, GA i ^ q) ≤
      (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
    have hqp : (1 : ℝ) ≤ q / p := by
      rw [le_div_iff₀ hp0]
      linarith
    calc (∑' i : ℕ, GA i ^ q)
        = ∑' i : ℕ, (∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := tsum_congr hsq
      _ ≤ (∑' i : ℕ, ∫⁻ s in Ioc ((1 / 2 : ℝ) ^ i) (4 * (1 / 2 : ℝ) ^ i),
            ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := tsum_rpow_le_rpow_tsum hqp
      _ ≤ (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (q / p) := by
          refine ENNReal.rpow_le_rpow ?_ (by positivity)
          have h := tsum_lintegral_block_windows_le
            (h := fun s => ENNReal.ofReal ‖g s‖ ^ p)
          rw [show ((2 : ENNReal)) = ENNReal.ofReal 2 from by
            rw [ENNReal.ofReal_ofNat]] at h
          exact h
  refine le_trans (ENNReal.rpow_le_rpow (mul_le_mul' le_rfl hoverlap)
    (by positivity : (0 : ℝ) ≤ 1 / q)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
    ← ENNReal.rpow_mul, show q * (1 / q) = 1 from by field_simp,
    ENNReal.rpow_one]
  congr 2
  field_simp

/-! ## BRS Proposition 5.5(ii) for the near half

Summing the outer index — the only sum that goes through Minkowski — closes the
argument: the outer factor is geometric, convergent exactly because `p < 2`. -/

theorem prop55ii_brsMainZeroLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 ≤ AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroConst p q * AE) *
        (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hCB : (0 : ℝ) ≤ brsBlockConst p q := brsBlockConst_nonneg hp1 hp2
  set ρ : ℝ := (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) with hρdef
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
  set Gk : ℕ → ℝ → ENNReal := fun k r => ∑' i : ℕ, brsShellMaj E p q g k i r
    with hGk
  have hGkmeas : ∀ k : ℕ, Measurable (Gk k) := by
    intro k
    exact Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i
  -- the pointwise bound, off the null set `closure E`
  have hae : ∀ᵐ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q ≤
      ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) * (∑' k : ℕ, Gk k r) ^ q := by
    have hnull : ∀ᵐ r : ℝ, r ∉ closure E := by
      rw [ae_iff]
      simpa using hEnull
    filter_upwards [hnull] with r hr
    have h1 := ofReal_mul_brsMainZeroLeft_rpow_le hE (p := p) (q := q) hq0 (g := g) r
    have h2 := brsMainZeroLeft_le_tsum_shellMaj hE hEne hp1 hp2.le hq0 hg hr
    calc ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q
        ≤ ENNReal.ofReal 4 * brsMainZeroLeft E p g r ^ q := h1
      _ ≤ ENNReal.ofReal 4 *
            (ENNReal.ofReal (3 / 2) * ∑' k : ℕ, Gk k r) ^ q :=
          mul_le_mul' le_rfl (ENNReal.rpow_le_rpow h2 hq0.le)
      _ = ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) * (∑' k : ℕ, Gk k r) ^ q := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
            ENNReal.ofReal_rpow_of_pos (by norm_num),
            ← ENNReal.ofReal_mul (by norm_num)]
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroLeft E p g r ^ q) ≤
      ENNReal.ofReal (4 * (3 / 2 : ℝ) ^ q) *
        ∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono_ae hae
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  -- Minkowski in the outer index
  have hmink : (∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q) ^ (1 / q) ≤
      ∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hGkmeas
  have houter : (∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (AE * brsBlockConst p q * (ρ / (1 - ρ))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
    have hterm : ∀ k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (AE * brsBlockConst p q * ρ ^ (k + 1)) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      intro k
      rw [hGk, hρdef]
      exact lintegral_tsum_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k
    refine le_trans (ENNReal.tsum_le_tsum hterm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right,
      tsum_ofReal_half_pow (by positivity : (0 : ℝ) ≤ AE * brsBlockConst p q)
        hρ0 hρ1]
  refine le_trans (mul_le_mul' le_rfl (le_trans hmink houter)) (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by norm_num : (0 : ℝ) < 2)]
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity), ← mul_assoc,
    ← ENNReal.ofReal_mul (by positivity)]
  congr 1
  rw [brsMainZeroConst, ← hρdef]
  have h4 : ((4 : ℝ) * (3 / 2 : ℝ) ^ q) ^ (1 / q) =
      (4 : ℝ) ^ (1 / q) * (3 / 2 : ℝ) := by
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  rw [h4]
  ring

/-! ## The shell machinery of Proposition 4.5, stated generically

Steps 2–4 of Proposition 4.5 use nothing about `𝔐_p` beyond the shell majorant
`brsMainMaximal_le_on_brsD` and the vanishing off `U_0`.  Restated for an
arbitrary function with those two properties, they apply verbatim to the far
half `𝔐_{p,∞}^-`, whose shell majorant is the same. -/

/-- **Step 2 of Proposition 4.5, generically.** -/
theorem rpow_le_on_brsD_of_maj {d : ℕ} {p q a : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    {g : ℝ → ℂ} {n : ℕ} {v : ENNReal}
    (hstep : v ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    v ^ q ≤
      ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
          (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
            (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set c : ℕ → ENNReal := brsWindowWeight e p n with hc
  set G : ℕ → ENNReal := brsBlockNorm p g with hG
  set A : ℝ := (2 / 3 : ℝ) ^ (1 - (d : ℝ)) with hA
  have hApos : 0 < A := by
    rw [hA]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hholder : (∑' k, c k * G k) ≤
      (∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q) :=
    tsum_weighted_le c G hq
  have hweight : (∑' k, c k) ≤
      ENNReal.ofReal (blockConstBase e p *
        (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) := by
    rw [hc, he]
    exact tsum_brsWindowWeight_le hp hae ha n
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  calc v ^ q
      ≤ (ENNReal.ofReal A * ∑' k, c k * G k) ^ q :=
        ENNReal.rpow_le_rpow hstep hq0.le
    _ = (ENNReal.ofReal A) ^ q * (∑' k, c k * G k) ^ q := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
    _ ≤ (ENNReal.ofReal A) ^ q *
          ((∑' k, c k * G k ^ q) ^ (1 / q) * (∑' k, c k) ^ (1 - 1 / q)) ^ q := by
        refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow hholder hq0.le)
    _ = (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * (∑' k, c k) ^ (q - 1)) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul,
          ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
        congr 2
        field_simp
    _ ≤ (ENNReal.ofReal A) ^ q * ((∑' k, c k * G k ^ q) * B ^ (q - 1)) := by
        refine mul_le_mul' le_rfl (mul_le_mul' le_rfl ?_)
        exact ENNReal.rpow_le_rpow hweight (by linarith)
    _ = ENNReal.ofReal (A ^ q) * B ^ (q - 1) * ∑' k, c k * G k ^ q := by
        rw [ENNReal.ofReal_rpow_of_nonneg hApos.le hq0.le]
        ring

/-- **Step 3 of Proposition 4.5, generically.** -/
theorem lintegral_brsD_le_of_maj {d : ℕ} {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q a : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    {g : ℝ → ℂ} {F : ℝ → ENNReal} (n : ℕ)
    (hmaj : ∀ r ∈ brsD E n, F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    (∫⁻ r in brsD E n, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) *
            (ENNReal.ofReal (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
              (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1)))) ^ (q - 1) *
            ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
              brsBlockNorm p g k ^ q) *
        volume (brsU E n) := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set B : ENNReal := ENNReal.ofReal (blockConstBase e p *
    (((2 : ℝ) ^ (-a)) ^ (n + 3) / ((2 : ℝ) ^ (-a) - 1))) with hB
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  set K : ENNReal := ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
    (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) with hK
  have hpoint : ∀ r ∈ brsD E n,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q ≤ K := by
    intro r hr
    have hrU0 : r ∈ brsU E 0 := brsU_subset_of_le E (Nat.zero_le n) hr.1
    have hweight := weight_le_of_mem_brsU_zero (d := d) hE hEne hrU0
    have hmax : F r ^ q ≤
        ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T := by
      rw [hB, hT, he]
      exact rpow_le_on_brsD_of_maj hp hq hae ha (hmaj r hr)
    rw [hK]
    exact mul_le_mul' hweight hmax
  calc (∫⁻ r in brsD E n, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
      ≤ ∫⁻ _r in brsD E n, K :=
        setLIntegral_mono' (measurableSet_brsD E n) hpoint
    _ = K * volume (brsD E n) := setLIntegral_const _ _
    _ ≤ K * volume (brsU E n) := by
        refine mul_le_mul' le_rfl (measure_mono ?_)
        exact fun r hr => hr.1
    _ = ENNReal.ofReal ((5 : ℝ) ^ (d - 1)) *
          (ENNReal.ofReal (((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q) * B ^ (q - 1) * T) *
          volume (brsU E n) := by rw [hK]

/-- **Step 4 of Proposition 4.5, generically.** -/
theorem lintegral_le_tsum_brsD_of_zero {E : Set ℝ} (hEne : E.Nonempty)
    (hEnull : volume (closure E) = 0) {F : ℝ → ENNReal}
    (hzero : ∀ r, r ∉ brsU E 0 → F r = 0) :
    (∫⁻ r : ℝ, F r) ≤ ∑' n : ℕ, ∫⁻ r in brsD E n, F r := by
  have hcover : brsU E 0 ⊆ (⋃ n : ℕ, brsD E n) ∪ closure E := by
    intro r hr
    by_cases hmem : r ∈ ⋃ n : ℕ, brsD E n
    · exact Or.inl hmem
    · refine Or.inr ?_
      have hd0 := infDist_eq_zero_of_notMem_iUnion_brsD hr hmem
      rwa [← Metric.mem_closure_iff_infDist_zero hEne] at hd0
  calc (∫⁻ r, F r) = ∫⁻ r in brsU E 0, F r := by
        rw [← lintegral_indicator (measurableSet_brsU E 0)]
        refine lintegral_congr fun r => ?_
        by_cases hr : r ∈ brsU E 0
        · rw [Set.indicator_of_mem hr]
        · rw [Set.indicator_of_notMem hr, hzero r hr]
    _ ≤ ∫⁻ r in (⋃ n : ℕ, brsD E n) ∪ closure E, F r := lintegral_mono_set hcover
    _ ≤ (∫⁻ r in ⋃ n : ℕ, brsD E n, F r) + ∫⁻ r in closure E, F r :=
        lintegral_union_le _ _ _
    _ = ∫⁻ r in ⋃ n : ℕ, brsD E n, F r := by
        rw [setLIntegral_measure_zero _ _ hEnull, add_zero]
    _ ≤ ∑' n : ℕ, ∫⁻ r in brsD E n, F r := lintegral_iUnion_le _ _

/-! ## Proposition 4.5, stated generically

The whole chain applies to any function that vanishes off `U_0` and obeys the
shell majorant bound. -/

theorem lintegral_brsD_le_shell_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty) {p q a S : ℝ} (hp : 1 ≤ p)
    (hq : 1 ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} {F : ℝ → ENNReal} (n : ℕ)
    (hmaj : ∀ r ∈ brsD E n, F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
      ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
        brsBlockNorm p g k) :
    (∫⁻ r in brsD E n,
        ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
      ENNReal.ofReal (shellConst d p q a S) *
          (ENNReal.ofReal ((2 : ℝ) ^ (-a))⁻¹) ^ n *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k ^ q := by
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  have hA : (0 : ℝ) < (2 / 3 : ℝ) ^ (1 - (d : ℝ)) := Real.rpow_pos_of_pos (by norm_num) _
  set T : ENNReal := ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q
    with hT
  -- the volume of the shell neighbourhood
  have hvol : volume (brsU E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
        (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by
    refine le_trans (volume_brsU_le hE hEne n) ?_
    calc ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
          ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞)
        ≤ ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
            ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) :=
          mul_le_mul' le_rfl (hcov n)
      _ = ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) :=
          (ENNReal.ofReal_mul (by positivity)).symm
  -- the shell constant, with its `n`-dependence
  have hB : (ENNReal.ofReal (blockConstBase e p * (x ^ (n + 3) / (x - 1)))) ^ (q - 1) =
      ENNReal.ofReal ((blockConstBase e p / (x - 1)) ^ (q - 1) *
        (x ^ (n + 3)) ^ (q - 1)) := by
    rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) (by linarith)]
    congr 1
    rw [show blockConstBase e p * (x ^ (n + 3) / (x - 1)) =
        (blockConstBase e p / (x - 1)) * x ^ (n + 3) by ring,
      Real.mul_rpow (by positivity) (by positivity)]
  -- assemble
  have hstep := lintegral_brsD_le_of_maj hE hEne hp hq hae ha n hmaj
  rw [← he, ← hT] at hstep
  refine le_trans hstep ?_
  rw [← hxdef, hB]
  refine le_trans (mul_le_mul' le_rfl hvol) (le_of_eq ?_)
  set A1 : ℝ := (5 : ℝ) ^ (d - 1) with hA1
  set A2 : ℝ := ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q with hA2
  set A3 : ℝ := (blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)
    with hA3
  set A4 : ℝ := 7 * (2 : ℝ) ^ (-(n : ℤ)) *
    (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) with hA4
  have h1 : 0 ≤ A1 := by rw [hA1]; positivity
  have h2 : 0 ≤ A2 := by
    rw [hA2]
    exact (Real.rpow_pos_of_pos hA _).le
  have h3 : 0 ≤ A3 := by
    rw [hA3]
    have hb1 : (0 : ℝ) < (blockConstBase e p / (x - 1)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (div_pos hC0 (by linarith)) _
    have hb2 : (0 : ℝ) < (x ^ (n + 3)) ^ (q - 1) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have h4 : 0 ≤ A4 := by
    rw [hA4]
    have hb1 : (0 : ℝ) < S ^ q := Real.rpow_pos_of_pos hS _
    have hb2 : (0 : ℝ) < ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)) :=
      Real.rpow_pos_of_pos (by positivity) _
    positivity
  have hfactor := shell_factor_identity (a := a) (q := q) n
  rw [← hxdef] at hfactor
  have hconst : A1 * A2 * A3 * A4 = shellConst d p q a S * (x⁻¹) ^ n := by
    rw [hA1, hA2, hA3, hA4, shellConst, ← he, ← hxdef]
    calc (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
          ((blockConstBase e p / (x - 1)) ^ (q - 1) * (x ^ (n + 3)) ^ (q - 1)) *
          (7 * (2 : ℝ) ^ (-(n : ℤ)) *
            (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
        = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            ((x ^ (n + 3)) ^ (q - 1) *
              ((2 : ℝ) ^ (-(n : ℤ)) *
                ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1)))) := by ring
      _ = ((5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q) *
            (x ^ (3 * (q - 1)) * (x⁻¹) ^ n) := by rw [hfactor]
      _ = (5 : ℝ) ^ (d - 1) * ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) ^ q *
            (blockConstBase e p / (x - 1)) ^ (q - 1) * 7 * S ^ q *
            x ^ (3 * (q - 1)) * (x⁻¹) ^ n := by ring
  calc ENNReal.ofReal A1 * (ENNReal.ofReal A2 * ENNReal.ofReal A3 * T) *
        ENNReal.ofReal A4
      = (ENNReal.ofReal A1 * ENNReal.ofReal A2 * ENNReal.ofReal A3 *
          ENNReal.ofReal A4) * T := by ring
    _ = ENNReal.ofReal (A1 * A2 * A3 * A4) * T := by
        rw [ENNReal.ofReal_mul (mul_nonneg (mul_nonneg h1 h2) h3),
          ENNReal.ofReal_mul (mul_nonneg h1 h2), ENNReal.ofReal_mul h1]
    _ = ENNReal.ofReal (shellConst d p q a S * (x⁻¹) ^ n) * T := by rw [hconst]
    _ = ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n * T := by
        rw [ENNReal.ofReal_mul (shellConst_pos (d := d) (p := p) (q := q) ha hS).le,
          ENNReal.ofReal_pow (by positivity)]

theorem prop45_of_maj {d : ℕ} {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (hEnull : volume (closure E) = 0) {p q a S : ℝ} (hp : 1 ≤ p) (hq : 1 ≤ q)
    (hpq : p ≤ q) (hae : (((d : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a)
    (ha : a < 0) (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} {F : ℝ → ENNReal}
    (hFzero : ∀ r : ℝ, r ∉ brsU E 0 → F r = 0)
    (hmaj : ∀ n : ℕ, ∀ r ∈ brsD E n,
      F r ≤ ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - (d : ℝ))) *
        ∑' k : ℕ, brsWindowWeight (((d : ℝ) - 1) * (1 - 1 / p) - 1) p n k *
          brsBlockNorm p g k) :
    (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((shellConst d p q a S *
          (blockConstBase (((d : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  have hp0 : 0 < p := lt_of_lt_of_le zero_lt_one hp
  have hq0 : 0 < q := lt_of_lt_of_le zero_lt_one hq
  set e : ℝ := ((d : ℝ) - 1) * (1 - 1 / p) - 1 with he
  set x : ℝ := (2 : ℝ) ^ (-a) with hxdef
  have hx : 1 < x := by
    rw [hxdef]
    exact one_lt_two_rpow_neg ha
  have hxpos : 0 < x := lt_trans zero_lt_one hx
  have hinv : x⁻¹ < 1 := by
    rw [inv_lt_one_iff₀]
    exact Or.inr hx
  have hC0 : 0 < blockConstBase e p := blockConstBase_pos e p
  set Mreal : ℝ := blockConstBase e p * x ^ (2 : ℕ) * (1 - x⁻¹)⁻¹ with hMreal
  have hMpos : 0 < Mreal := by
    rw [hMreal]
    have hsub : (0 : ℝ) < 1 - x⁻¹ := by linarith
    positivity
  have hSC : 0 < shellConst d p q a S := shellConst_pos (d := d) (p := p) (q := q) ha hS
  set G : ENNReal := (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) with hG
  have hzeroF : ∀ r : ℝ, r ∉ brsU E 0 →
      ENNReal.ofReal r ^ (d - 1) * F r ^ q = 0 := by
    intro r hr
    rw [hFzero r hr, ENNReal.zero_rpow_of_pos hq0, mul_zero]
  -- the shells
  have hshell : ∀ n : ℕ, (∫⁻ r in brsD E n,
      ENNReal.ofReal r ^ (d - 1) * F r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S) * (ENNReal.ofReal x⁻¹) ^ n *
          ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
    intro n
    rw [he, hxdef]
    exact lintegral_brsD_le_shell_of_maj hE hEne hp hq hae ha hS hcov n (hmaj n)
  -- the block sums
  have hblocks : (∑' k : ℕ, brsBlockNorm p g k ^ q) ≤ G ^ q := by
    have h1 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤
        (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) :=
      tsum_rpow_le_tsum_rpow _ hp0 hpq
    have h2 : (∑' k : ℕ, brsBlockNorm p g k ^ p) ^ (1 / p) ≤ G := by
      rw [hG]
      exact ENNReal.rpow_le_rpow (tsum_brsBlockNorm_rpow_le hp0 g) (by positivity)
    have h3 : (∑' k : ℕ, brsBlockNorm p g k ^ q) ^ (1 / q) ≤ G := le_trans h1 h2
    have h4 := ENNReal.rpow_le_rpow h3 hq0.le
    rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one] at h4
  -- chain everything
  have hmain : (∫⁻ r, ENNReal.ofReal r ^ (d - 1) *
      F r ^ q) ≤
        ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
    calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q)
        ≤ ∑' n : ℕ, ∫⁻ r in brsD E n,
            ENNReal.ofReal r ^ (d - 1) * F r ^ q :=
          lintegral_le_tsum_brsD_of_zero hEne hEnull hzeroF
      _ ≤ ∑' n : ℕ, ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal x⁻¹) ^ n *
            ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q :=
          ENNReal.tsum_le_tsum hshell
      _ = ENNReal.ofReal (shellConst d p q a S) *
            ∑' n : ℕ, (ENNReal.ofReal x⁻¹) ^ n *
              ∑' k : ℕ, brsWindowWeight e p n k * brsBlockNorm p g k ^ q := by
          rw [← ENNReal.tsum_mul_left]
          refine tsum_congr fun n => ?_
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) *
            (ENNReal.ofReal (blockConstBase e p * x ^ (2 : ℕ)) *
              (1 - ENNReal.ofReal x⁻¹)⁻¹ *
              ∑' k : ℕ, brsBlockNorm p g k ^ q) := by
          refine mul_le_mul' le_rfl ?_
          rw [hxdef]
          exact tsum_shell_block_le hae ha g
      _ = ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal *
            ∑' k : ℕ, brsBlockNorm p g k ^ q := by
          rw [hMreal, hxdef, ← blockSumConst_eq (e := e) (p := p) ha]
          ring
      _ ≤ ENNReal.ofReal (shellConst d p q a S) * ENNReal.ofReal Mreal * G ^ q :=
          mul_le_mul' le_rfl hblocks
      _ = ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q := by
          rw [ENNReal.ofReal_mul hSC.le]
  calc (∫⁻ r, ENNReal.ofReal r ^ (d - 1) * F r ^ q) ^ (1 / q)
      ≤ (ENNReal.ofReal (shellConst d p q a S * Mreal) * G ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ENNReal.ofReal ((shellConst d p q a S * Mreal) ^ (1 / q)) * G := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / q),
          ← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one,
          ENNReal.ofReal_rpow_of_nonneg (by positivity) (by positivity)]

/-! ## The far half `𝔐_{p,∞}^-` for `p < 2`

Its shell majorant is literally the one of `𝔐_p` in dimension two, so the
generic Proposition 4.5 applies verbatim. -/

theorem brsMainInfLeft_eq_zero_of_notMem_brsU_zero {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {r : ℝ}
    (hr : r ∉ brsU E 0) : brsMainInfLeft E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hclose : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  have hdist : Metric.infDist r E ≤ |r - t| := by
    have h : Metric.infDist r E ≤ dist r t :=
      Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  refine hr ?_
  show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ)
  have hcalc : (2 : ℝ) * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) = 2 := by norm_num
  rw [hcalc]
  linarith

/-- **The shell majorant for `𝔐_{p,∞}^-`.**  It is the one of `𝔐_p` at `d = 2`. -/
theorem brsMainInfLeft_le_on_brsD {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (g : ℝ → ℂ) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainInfLeft E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) *
        ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
          ENNReal.ofReal (s ^ ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1)) *
            ENNReal.ofReal ‖g s‖ := by
  have hexp : (((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1 = -(1 / p) := by
    push_cast
    ring
  have hconst : ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) = 3 / 2 := by
    have h : (1 : ℝ) - ((2 : ℕ) : ℝ) = -1 := by push_cast; ring
    rw [h, Real.rpow_neg_one]
    norm_num
  rw [hexp, hconst]
  have hdist := lt_infDist_of_mem_brsD hrD
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hr0 (by norm_num)]
    linarith
  have hcut : (2 : ℝ) ^ (-(n : ℤ)) ≤ 2 * |r - t| := by
    have hle : Metric.infDist r E ≤ |r - t| := by
      have h : Metric.infDist r E ≤ dist r t :=
        Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    have habs : (0 : ℝ) ≤ |r - t| := abs_nonneg _
    linarith
  have hsub : Ioc (2 * |r - t|) (r + t) ⊆ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 := by
    intro s hs
    exact ⟨le_trans hcut hs.1.le, by linarith [hs.2]⟩
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) (lintegral_mono_set hsub)

/-- **BRS Proposition 5.5(ii) for the far half.** -/
theorem prop55ii_brsMainInfLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {p q a S : ℝ}
    (hp : 1 ≤ p) (hq : 1 ≤ q) (hpq : p ≤ q)
    (hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r ^ ((2 : ℕ) - 1) * brsMainInfLeft E p g r ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((shellConst 2 p q a S *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  refine prop45_of_maj (d := 2) hE hEne hEnull hp hq hpq hae ha hS hcov
    (g := g) (F := brsMainInfLeft E p g)
    (fun r hr => brsMainInfLeft_eq_zero_of_notMem_brsU_zero hE g hr) ?_
  intro n r hr
  refine le_trans (brsMainInfLeft_le_on_brsD hE g hr) ?_
  exact mul_le_mul' le_rfl (lintegral_window_le_tsum_blocks hp hg n)

/-! ## Adding two halves

Minkowski needs measurability of both summands; the convexity bound
`(a+b)^q ≤ 2^{q-1}(a^q+b^q)` plus subadditivity of `x ↦ x^{1/q}` needs it of
only one, since `lintegral_add_left` is an equality as soon as one summand is
measurable. -/

theorem lintegral_radial_rpow_add_le {A B : ℝ → ENNReal} (hA : Measurable A)
    {c : ENNReal} (hc : c ≠ ⊤) {q : ℝ} (hq : 1 ≤ q) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q) ^ (1 / q) ≤
      (2 : ENNReal) ^ (1 - 1 / q) *
        ((∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) ^ (1 / q) +
          c * (∫⁻ r : ℝ, ENNReal.ofReal r * B r ^ q) ^ (1 / q)) := by
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq
  have hinv : (0 : ℝ) < 1 / q := by positivity
  have hinv1 : 1 / q ≤ 1 := by
    rw [div_le_one hq0]
    exact hq
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q ≤
      (2 : ENNReal) ^ (q - 1) *
        (ENNReal.ofReal r * A r ^ q + c ^ q * (ENNReal.ofReal r * B r ^ q)) := by
    intro r
    have h := ENNReal.rpow_add_le_mul_rpow_add_rpow (A r) (c * B r) hq
    calc ENNReal.ofReal r * (A r + c * B r) ^ q
        ≤ ENNReal.ofReal r * ((2 : ENNReal) ^ (q - 1) *
            (A r ^ q + (c * B r) ^ q)) := mul_le_mul' le_rfl h
      _ = (2 : ENNReal) ^ (q - 1) *
            (ENNReal.ofReal r * A r ^ q + c ^ q * (ENNReal.ofReal r * B r ^ q)) := by
          rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le]
          ring
  have hsplit : (∫⁻ r : ℝ, (ENNReal.ofReal r * A r ^ q +
      c ^ q * (ENNReal.ofReal r * B r ^ q))) =
      (∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) +
        ∫⁻ r : ℝ, c ^ q * (ENNReal.ofReal r * B r ^ q) := by
    refine lintegral_add_left ?_ _
    exact (by fun_prop : Measurable fun r : ℝ => ENNReal.ofReal r).mul
      (hA.pow_const q)
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * (A r + c * B r) ^ q) ≤
      (2 : ENNReal) ^ (q - 1) *
        ((∫⁻ r : ℝ, ENNReal.ofReal r * A r ^ q) +
          c ^ q * ∫⁻ r : ℝ, ENNReal.ofReal r * B r ^ q) := by
    refine le_trans (lintegral_mono hpt) ?_
    rw [lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg (by linarith) (by simp)), hsplit,
      lintegral_const_mul' _ _
      (ENNReal.rpow_ne_top_of_nonneg hq0.le hc)]
  refine le_trans (ENNReal.rpow_le_rpow hmain hinv.le) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv.le, ← ENNReal.rpow_mul]
  refine mul_le_mul' (le_of_eq (by congr 1; field_simp)) ?_
  refine le_trans (ENNReal.rpow_add_le_add_rpow _ _ hinv.le hinv1) ?_
  refine add_le_add le_rfl (le_of_eq ?_)
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv.le, ← ENNReal.rpow_mul,
    mul_one_div_cancel hq0.ne', ENNReal.rpow_one]

/-! ## The near majorant, as a measurable function

To add the two halves of `𝔐_p^-` the near half must be replaced by a
measurable majorant; the total bound for the double sum is the core of
`prop55ii_brsMainZeroLeft`, extracted. -/

/-- **The total bound for the double sum of shell majorants.** -/
theorem lintegral_tsum_shellMaj_total {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r : ℝ, (∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r) ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
            (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hCB : (0 : ℝ) ≤ brsBlockConst p q := brsBlockConst_nonneg hp1 hp2
  set ρ : ℝ := (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) with hρdef
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) (by linarith)
  set Gk : ℕ → ℝ → ENNReal := fun k r => ∑' i : ℕ, brsShellMaj E p q g k i r
    with hGk
  have hGkmeas : ∀ k : ℕ, Measurable (Gk k) := by
    intro k
    exact Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i
  have hmink : (∫⁻ r : ℝ, (∑' k : ℕ, Gk k r) ^ q) ^ (1 / q) ≤
      ∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hGkmeas
  have houter : (∑' k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q)) ≤
      ENNReal.ofReal (AE * brsBlockConst p q * (ρ / (1 - ρ))) *
        (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
    have hterm : ∀ k : ℕ, (∫⁻ r : ℝ, Gk k r ^ q) ^ (1 / q) ≤
        ENNReal.ofReal (AE * brsBlockConst p q * ρ ^ (k + 1)) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
      intro k
      rw [hGk, hρdef]
      exact lintegral_tsum_brsShellMaj_bound hE hEne hp1 hp2 hpq hAE hcov hg k
    refine le_trans (ENNReal.tsum_le_tsum hterm) (le_of_eq ?_)
    rw [ENNReal.tsum_mul_right,
      tsum_ofReal_half_pow (by positivity : (0 : ℝ) ≤ AE * brsBlockConst p q)
        hρ0 hρ1]
  exact le_trans hmink houter

/-- The measurable near majorant of `𝔐_{p,0}^-`. -/
def brsMainZeroMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  ENNReal.ofReal (3 / 2) * ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r

theorem measurable_brsMainZeroMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) : Measurable (brsMainZeroMaj E p q g) := by
  refine measurable_const.mul ?_
  exact Measurable.tsum fun k =>
    Measurable.tsum fun i => measurable_brsShellMaj E p q hg k i

theorem brsMainZeroMaj_eq_zero_of_notMem {E : Set ℝ} {p q : ℝ} {g : ℝ → ℂ}
    {r : ℝ} (hr : r ∉ brsU E 0) : brsMainZeroMaj E p q g r = 0 := by
  rw [brsMainZeroMaj, ENNReal.tsum_eq_zero.mpr, mul_zero]
  intro k
  rw [ENNReal.tsum_eq_zero]
  intro i
  refine brsShellMaj_eq_zero_of_notMem ?_
  intro hmem
  exact hr (brsU_subset_of_le E (Nat.zero_le (k + i)) hmem.1)

/-- **The `L^q` bound for the near majorant.** -/
theorem lintegral_brsMainZeroMaj_bound {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ}
    (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((5 : ℝ) ^ (1 / q) * (3 / 2)) *
        (ENNReal.ofReal (AE * brsBlockConst p q *
            ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
              (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) *
          (ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set S : ℝ → ENNReal := fun r => ∑' k : ℕ, ∑' i : ℕ, brsShellMaj E p q g k i r
    with hS
  -- the radial weight is at most `5` on the support
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q ≤
      ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * S r ^ q := by
    intro r
    by_cases hr : r ∈ brsU E 0
    · have hr5 : r ≤ 5 := le_five_of_mem_brsU_zero hE hEne hr
      calc ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q
          ≤ ENNReal.ofReal 5 * (ENNReal.ofReal (3 / 2) * S r) ^ q := by
            refine mul_le_mul' (ENNReal.ofReal_le_ofReal hr5) ?_
            rw [brsMainZeroMaj, hS]
        _ = ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * S r ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
              ENNReal.ofReal_rpow_of_pos (by norm_num),
              ← ENNReal.ofReal_mul (by norm_num)]
    · rw [brsMainZeroMaj_eq_zero_of_notMem hr, ENNReal.zero_rpow_of_pos hq0,
        mul_zero]
      exact zero_le
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroMaj E p q g r ^ q) ≤
      ENNReal.ofReal ((5 : ℝ) * (3 / 2 : ℝ) ^ q) * ∫⁻ r : ℝ, S r ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hpt
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  refine mul_le_mul' (le_of_eq ?_) ?_
  · congr 1
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  · rw [hS]
    exact lintegral_tsum_shellMaj_total hE hEne hp1 hp2 hpq hAE hcov hg

/-! ## The two covering hypotheses agree

`HasBRSCoveringBound` is the `q`-th root of the dyadic hypothesis used by
Proposition 4.5. -/

theorem hasBRSCoveringBound_dyadic {E : Set ℝ} {p q AE : ℝ} (hq0 : 0 < q)
    (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE) {a : ℝ}
    (ha : 1 - 2 / p = a) (n : ℕ) :
    ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (AE ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))) := by
  set δ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hδdef
  have hδ0 : 0 < δ := by rw [hδdef]; positivity
  have hδ1 : δ ≤ 6 := by
    rw [hδdef]
    have h1 : δ ≤ 1 := by
      rw [hδdef]
      exact zpow_le_one_of_nonpos₀ (by norm_num) (by simp)
    rw [hδdef] at h1
    linarith
  have h := hcov δ hδ0 hδ1
  have h' := ENNReal.rpow_le_rpow h (le_of_lt hq0)
  rw [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at h'
  refine le_trans h' (le_of_eq ?_)
  rw [ENNReal.ofReal_rpow_of_nonneg (by positivity) hq0.le]
  congr 1
  rw [Real.mul_rpow hAE (Real.rpow_nonneg hδ0.le _), ← Real.rpow_mul hδ0.le]
  congr 2
  rw [← ha]
  field_simp

theorem add_mul_le_add_mul_add {A B X Y : ENNReal} :
    A * X + B * Y ≤ (A + B) * (X + Y) := by
  rw [add_mul, mul_add, mul_add]
  exact add_le_add le_self_add le_add_self

/-! ## BRS Proposition 5.5(ii) for `𝔐_p^-`

The two halves are added with the convexity bound; the near half must go
through its measurable majorant. -/

/-- **BRS Proposition 5.5(ii), left endpoint.** -/
theorem prop55ii_brsMainTwoLeft {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 < AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q) ^ (1 / q) ≤
        C * ((ENNReal.ofReal 2 * ∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) +
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set a : ℝ := 1 - 2 / p with hadef
  have ha : a < 0 := by
    rw [hadef]
    have : 1 < 2 / p := by
      rw [lt_div_iff₀ hp0]
      linarith
    linarith
  have hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a := by
    rw [hadef]
    push_cast
    ring
  have hdyad := hasBRSCoveringBound_dyadic (E := E) (p := p) (q := q) (AE := AE)
    hq0 hAE.le hcov (a := a) hadef.symm
  -- the two halves
  have hnear := lintegral_brsMainZeroMaj_bound hE hEne hp1 hp2 hpq hAE.le hcov hg
  have hfar := prop55ii_brsMainInfLeft hE hEne hEnull hp1 hq1 hpq hae ha
    (by positivity : (0 : ℝ) < AE) hdyad hg
  rw [show ((2 : ℕ) - 1) = 1 from by norm_num] at hfar
  simp only [pow_one] at hfar
  -- the pointwise bound
  have hsplit : ∀ᵐ r : ℝ, ENNReal.ofReal r * brsMainTwoLeft E p g r ^ q ≤
      ENNReal.ofReal r *
        (brsMainZeroMaj E p q g r +
          ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) * brsMainInfLeft E p g r) ^ q := by
    have hnull : ∀ᵐ r : ℝ, r ∉ closure E := by
      rw [ae_iff]
      simpa using hEnull
    filter_upwards [hnull] with r hr
    by_cases hr0 : 0 < r
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsMainTwoLeft_le_split hr0) ?_
      refine add_le_add ?_ le_rfl
      rw [brsMainZeroMaj]
      exact brsMainZeroLeft_le_tsum_shellMaj hE hEne hp1 hp2.le hq0 hg hr
    · rw [ENNReal.ofReal_eq_zero.mpr (by linarith [not_lt.mp hr0]), zero_mul,
        zero_mul]
  refine ⟨(2 : ENNReal) ^ (1 - 1 / q) *
    (ENNReal.ofReal ((5 : ℝ) ^ (1 / q) * (3 / 2)) *
        ENNReal.ofReal (AE * brsBlockConst p q *
          ((1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2) /
            (1 - (1 / 2 : ℝ) ^ ((1 / p - 1 / 2) / 2)))) +
      ENNReal.ofReal ((2 : ℝ) ^ (1 / 2 : ℝ)) *
        ENNReal.ofReal ((shellConst 2 p q a AE *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q))),
    ?_, ?_⟩
  · refine ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg ?_ (by simp)) ?_
    · have : 1 / q ≤ 1 := by
        rw [div_le_one hq0]
        exact hq1
      linarith
    · exact ENNReal.add_ne_top.mpr
        ⟨ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top,
          ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top⟩
  · refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono_ae hsplit)
      (by positivity)) ?_
    refine le_trans (lintegral_radial_rpow_add_le
      (measurable_brsMainZeroMaj E p q hg) ENNReal.ofReal_ne_top hq1) ?_
    refine le_trans (mul_le_mul' le_rfl
      (add_le_add hnear (mul_le_mul' le_rfl hfar))) ?_
    refine le_trans (mul_le_mul' (le_refl ((2 : ENNReal) ^ (1 - 1 / q))) ?_)
      (le_of_eq (mul_assoc _ _ _).symm)
    refine le_trans (le_of_eq ?_) add_mul_le_add_mul_add
    ring

/-! ## The far half `𝔐_{p,∞}^+` for `p < 2`

Its shell majorant is the same as for the `-` sign: the window
`(|r-t|, (r+t)/2]` also sits inside `[2^{-n}, 6]` on the shell `D_n`. -/

theorem brsMainInfRight_eq_zero_of_notMem_brsU_zero {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ} (g : ℝ → ℂ) {r : ℝ}
    (hr : r ∉ brsU E 0) : brsMainInfRight E p g r = 0 := by
  refine le_antisymm (iSup₂_le fun t ht => ?_) (by simp)
  exfalso
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hclose : |r - t| < 2 := by
    rw [abs_lt]
    constructor <;> linarith
  have hdist : Metric.infDist r E ≤ |r - t| := by
    have h : Metric.infDist r E ≤ dist r t :=
      Metric.infDist_le_dist_of_mem (x := r) htE
    rwa [Real.dist_eq] at h
  refine hr ?_
  show Metric.infDist r E ≤ 2 * (2 : ℝ) ^ (-(0 : ℕ) : ℤ)
  have hcalc : (2 : ℝ) * (2 : ℝ) ^ (-(0 : ℕ) : ℤ) = 2 := by norm_num
  rw [hcalc]
  linarith

/-- **The shell majorant for `𝔐_{p,∞}^+`.** -/
theorem brsMainInfRight_le_on_brsD {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p : ℝ}
    (g : ℝ → ℂ) {n : ℕ} {r : ℝ} (hrD : r ∈ brsD E n) :
    brsMainInfRight E p g r ≤
      ENNReal.ofReal ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) *
        ∫⁻ s in Icc ((2 : ℝ) ^ (-(n : ℤ))) 6,
          ENNReal.ofReal (s ^ ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1)) *
            ENNReal.ofReal ‖g s‖ := by
  have hexp : (((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1 = -(1 / p) := by
    push_cast
    ring
  have hconst : ((2 / 3 : ℝ) ^ (1 - ((2 : ℕ) : ℝ))) = 3 / 2 := by
    have h : (1 : ℝ) - ((2 : ℕ) : ℝ) = -1 := by push_cast; ring
    rw [h, Real.rpow_neg_one]
    norm_num
  rw [hexp, hconst]
  have hdist := lt_infDist_of_mem_brsD hrD
  refine iSup₂_le fun t ht => ?_
  obtain ⟨htE, htlow, hthigh⟩ := ht
  obtain ⟨ht1, ht2⟩ := hE htE
  have hr0 : (0 : ℝ) < r := by linarith
  have hrinv : r⁻¹ ≤ 3 / 2 := by
    rw [inv_le_comm₀ hr0 (by norm_num)]
    linarith
  have hcut : (2 : ℝ) ^ (-(n : ℤ)) ≤ |r - t| := by
    have hle : Metric.infDist r E ≤ |r - t| := by
      have h : Metric.infDist r E ≤ dist r t :=
        Metric.infDist_le_dist_of_mem (x := r) htE
      rwa [Real.dist_eq] at h
    linarith
  have hsub : Ioc |r - t| ((r + t) / 2) ⊆ Icc ((2 : ℝ) ^ (-(n : ℤ))) 6 := by
    intro s hs
    exact ⟨le_trans hcut hs.1.le, by linarith [hs.2]⟩
  exact mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) (lintegral_mono_set hsub)

/-- **BRS Proposition 5.5(ii) for the far half, right endpoint.** -/
theorem prop55ii_brsMainInfRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0) {p q a S : ℝ}
    (hp : 1 ≤ p) (hq : 1 ≤ q) (hpq : p ≤ q)
    (hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a) (ha : a < 0)
    (hS : 0 < S)
    (hcov : ∀ n : ℕ, ((intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℕ) : ℝ≥0∞) ≤
      ENNReal.ofReal (S ^ q * ((2 : ℝ) ^ (-(n : ℤ))) ^ (-(q * a + 1))))
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r ^ ((2 : ℕ) - 1) * brsMainInfRight E p g r ^ q) ^
        (1 / q) ≤
      ENNReal.ofReal ((shellConst 2 p q a S *
          (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
            ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q)) *
        (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p) := by
  refine prop45_of_maj (d := 2) hE hEne hEnull hp hq hpq hae ha hS hcov
    (g := g) (F := brsMainInfRight E p g)
    (fun r hr => brsMainInfRight_eq_zero_of_notMem_brsU_zero hE g hr) ?_
  intro n r hr
  refine le_trans (brsMainInfRight_le_on_brsD hE g hr) ?_
  exact mul_le_mul' le_rfl (lintegral_window_le_tsum_blocks hp hg n)

/-! ## The dyadic pieces at the right endpoint

For `𝔐_{p,0}^+` the singularity sits at `s = b := r + t`, which stays in
`(1, 6)`.  There is therefore no block decomposition and no shell structure:
one dyadic decomposition of the near window `(b/2, b)` suffices. -/

/-- The `m`-th dyadic piece of the right near window `(b/2, b)`. -/
def brsRightPieceSet (b : ℝ) (m : ℕ) : Set ℝ :=
  Ioc (b - b * (1 / 2 : ℝ) ^ (m + 1)) (b - b * (1 / 2 : ℝ) ^ (m + 2))

theorem brsRightPieceSet_subset {b : ℝ} (hb : 0 < b) (m : ℕ) :
    brsRightPieceSet b m ⊆ Ioc (b / 2) b := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hp1 : (1 / 2 : ℝ) ^ (m + 1) ≤ (1 / 2 : ℝ) ^ 1 :=
    pow_le_pow_of_le_one (by norm_num) (by norm_num) (by omega)
  have hp2 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  constructor
  · have : b * (1 / 2 : ℝ) ^ (m + 1) ≤ b * (1 / 2 : ℝ) := by
      have := mul_le_mul_of_nonneg_left hp1 hb.le
      simpa using this
    linarith
  · nlinarith

/-- The pieces exhaust the right near window, up to the endpoint. -/
theorem Ioc_subset_iUnion_brsRightPieceSet {b : ℝ} (hb : 0 < b) :
    Ioc (b / 2) b ⊆ (⋃ m : ℕ, brsRightPieceSet b m) ∪ {b} := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  rcases eq_or_lt_of_le h2 with heq | hlt
  · exact Or.inr (by simp [heq])
  refine Or.inl ?_
  classical
  set x : ℝ := (b - s) / b with hx
  have hx0 : 0 < x := by
    rw [hx]
    exact div_pos (by linarith) hb
  have hxhalf : x < 1 / 2 := by
    rw [hx, div_lt_iff₀ hb]
    linarith
  have hex : ∃ m : ℕ, (1 / 2 : ℝ) ^ (m + 2) ≤ x := by
    obtain ⟨n, hn⟩ := exists_pow_lt_of_lt_one hx0 (by norm_num : (1 / 2 : ℝ) < 1)
    exact ⟨n, le_of_lt (lt_of_le_of_lt (pow_le_pow_of_le_one (by norm_num)
      (by norm_num) (by omega)) hn)⟩
  set m : ℕ := Nat.find hex with hm
  have hlow : (1 / 2 : ℝ) ^ (m + 2) ≤ x := Nat.find_spec hex
  have hhigh : x < (1 / 2 : ℝ) ^ (m + 1) := by
    rcases Nat.eq_zero_or_pos m with hm0 | hmpos
    · rw [hm0]
      simpa using hxhalf
    · obtain ⟨k, hk⟩ : ∃ k : ℕ, m = k + 1 := ⟨m - 1, by omega⟩
      have hklt : k < Nat.find hex := by
        rw [← hm]
        omega
      have hnot := Nat.find_min hex hklt
      have hidx : k + 2 = m + 1 := by omega
      rw [hidx] at hnot
      exact lt_of_not_ge hnot
  have hxb : x * b = b - s := by
    rw [hx, div_mul_cancel₀ _ hb.ne']
  refine Set.mem_iUnion.mpr ⟨m, ?_, ?_⟩
  · have h := mul_lt_mul_of_pos_right hhigh hb
    nlinarith [hxb]
  · have h := mul_le_mul_of_nonneg_right hlow hb.le
    nlinarith [hxb]

/-- The right near-window integral is at most the sum over the dyadic pieces. -/
theorem lintegral_rightNear_le_tsum_pieces {b : ℝ} (hb : 0 < b) (F : ℝ → ENNReal) :
    (∫⁻ s in Ioc (b / 2) b, F s) ≤
      ∑' m : ℕ, ∫⁻ s in brsRightPieceSet b m, F s := by
  refine le_trans (lintegral_mono_set (Ioc_subset_iUnion_brsRightPieceSet hb)) ?_
  refine le_trans (lintegral_union_le _ _ _) ?_
  have hpt : (∫⁻ s in ({b} : Set ℝ), F s) = 0 := by
    rw [setLIntegral_measure_zero]
    simp
  rw [hpt, add_zero]
  exact lintegral_iUnion_le _ _

/-- **The pointwise weight bound on a right piece.** -/
theorem mainWeightRight_piece_le {p b s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hb : 0 < b) {m : ℕ} (hs : s ∈ brsRightPieceSet b m) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤
      (b / 2) ^ (1 / 2 - 1 / p) *
        (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hsub := brsRightPieceSet_subset hb m hs
  obtain ⟨hs1, hs2⟩ := hsub
  obtain ⟨h1, h2⟩ := hs
  have hb2 : (0 : ℝ) < b / 2 := by linarith
  have hs0 : 0 < s := lt_trans hb2 hs1
  have hκ : 1 / 2 - 1 / p ≤ 0 := by
    have : (1 : ℝ) / 2 ≤ 1 / p := by
      rw [div_le_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  have hbs : (0 : ℝ) < b * (1 / 2 : ℝ) ^ (m + 2) := by positivity
  have hgap : b * (1 / 2 : ℝ) ^ (m + 2) ≤ b - s := by linarith
  have hfirst : s ^ (1 / 2 - 1 / p) ≤ (b / 2) ^ (1 / 2 - 1 / p) :=
    rpow_le_rpow_of_nonpos_exp hb2 hs1.le hκ
  have hsecond : (b - s) ^ (-(1 / 2) : ℝ) ≤
      (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) :=
    rpow_le_rpow_of_nonpos_exp hbs hgap (by norm_num)
  exact mul_le_mul hfirst hsecond (Real.rpow_nonneg (by linarith) _)
    (Real.rpow_nonneg hb2.le _)

/-- **The right piece sits in an additive window.** -/
theorem brsRightPieceSet_subset_shift {b : ℝ} (hb1 : 1 ≤ b) (hb6 : b ≤ 6)
    (m : ℕ) :
    brsRightPieceSet b m ⊆
      Ioc (b - 6 * (1 / 2 : ℝ) ^ (m + 1)) (b - (1 / 2 : ℝ) ^ (m + 2)) := by
  intro s hs
  obtain ⟨h1, h2⟩ := hs
  have hpow1 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 1) := by positivity
  have hpow2 : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  constructor
  · nlinarith
  · nlinarith

/-! ## The linearized window at the right endpoint

`s ∈ (r + t - c₂, r + t - c₁]` says `r - s ∈ [c₁ - t, c₂ - t)`, so the window is
again a reflected translate — and there is only one arm, since `r + t` needs no
absolute value. -/

/-- **The translation window at the right endpoint.** -/
theorem lintegral_shifted_window_le_add {u v c₁ c₂ t : ℝ} (ht : t ∈ Icc u v)
    (F : ℝ → ENNReal) (r : ℝ) :
    (∫⁻ s in Ioc (r + t - c₂) (r + t - c₁), F s) ≤
      ∫⁻ s : ℝ,
        Set.indicator (Ico (c₁ - v) (c₂ - u)) (fun _ => (1 : ENNReal)) (r - s) *
          F s := by
  obtain ⟨hu, hv⟩ := ht
  have hsub : Ioc (r + t - c₂) (r + t - c₁) ⊆
      (fun s : ℝ => r - s) ⁻¹' Ico (c₁ - v) (c₂ - u) := by
    intro s hs
    obtain ⟨h1, h2⟩ := hs
    constructor
    · have : c₁ - t ≤ r - s := by linarith
      linarith
    · have : r - s < c₂ - t := by linarith
      linarith
  rw [lintegral_indicator_shift measurableSet_Ico F r]
  exact lintegral_mono_set hsub

/-- The measurable majorant of the right linearized window operator. -/
def brsWindowMajAdd (u v c₁ c₂ : ℝ) (F : ℝ → ENNReal) (r : ℝ) : ENNReal :=
  ∫⁻ s : ℝ,
    Set.indicator (Ico (c₁ - v) (c₂ - u)) (fun _ => (1 : ENNReal)) (r - s) * F s

theorem measurable_brsWindowMajAdd (u v c₁ c₂ : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsWindowMajAdd u v c₁ c₂ F) :=
  measurable_indicator_conv measurableSet_Ico hF

theorem iSup_window_le_brsWindowMajAdd {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (r : ℝ) :
    (⨆ t : Icc u v, ∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsWindowMajAdd u v c₁ c₂ F r :=
  iSup_le fun t => lintegral_shifted_window_le_add t.2 F r

theorem lintegral_brsWindowMajAdd_rpow_le {u v c₁ c₂ : ℝ} {F : ℝ → ENNReal}
    (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsWindowMajAdd u v c₁ c₂ F r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) ^ (1 - 1 / p + 1 / q) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hvol : volume (Ico (c₁ - v) (c₂ - u)) =
      ENNReal.ofReal ((v - u) + (c₂ - c₁)) := by
    rw [Real.volume_Ico]
    congr 1
    ring
  have h := lintegral_indicator_conv_rpow_le (Q := Ico (c₁ - v) (c₂ - u))
    measurableSet_Ico (by rw [hvol]; exact ENNReal.ofReal_ne_top) hF hp1 hpq
  rwa [hvol] at h

/-- The measurable majorant of the covered right window operator. -/
def brsCoverMajAdd (E : Set ℝ) (δ c₁ c₂ q : ℝ) (F : ℝ → ENNReal) (r : ℝ) :
    ENNReal :=
  (∑ a ∈ brsCoverFinset E δ,
    brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q)

theorem measurable_brsCoverMajAdd (E : Set ℝ) (δ c₁ c₂ q : ℝ) {F : ℝ → ENNReal}
    (hF : Measurable F) : Measurable (brsCoverMajAdd E δ c₁ c₂ q F) := by
  refine Measurable.pow_const ?_ (1 / q)
  exact Finset.measurable_sum _ fun a _ =>
    (measurable_brsWindowMajAdd _ _ _ _ hF).pow_const q

/-- The majorant dominates the supremum over `E`. -/
theorem iSup_le_brsCoverMajAdd {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {δ : ℝ}
    (hδ : 0 < δ) {c₁ c₂ q : ℝ} (hq0 : 0 < q) {F : ℝ → ENNReal} (r : ℝ) :
    (⨆ t : E, ∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsCoverMajAdd E δ c₁ c₂ q F r := by
  obtain ⟨hι, _⟩ := brsCoverFinset_spec hE hδ
  refine iSup_le fun t => ?_
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ brsCoverFinset E δ,
      (t : ℝ) ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι t.2
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  have hle : (∫⁻ s in Ioc (r + (t : ℝ) - c₂) (r + (t : ℝ) - c₁), F s) ≤
      brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r := by
    refine le_trans ?_ (iSup_window_le_brsWindowMajAdd (u := a - δ / 2)
      (v := a + δ / 2) (F := F) r)
    exact le_iSup (fun w : Icc (a - δ / 2) (a + δ / 2) =>
      ∫⁻ s in Ioc (r + (w : ℝ) - c₂) (r + (w : ℝ) - c₁), F s) ⟨(t : ℝ), hat⟩
  refine le_trans hle ?_
  rw [brsCoverMajAdd]
  have hmem : brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q ≤
      ∑ b ∈ brsCoverFinset E δ,
        brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q :=
    Finset.single_le_sum
      (f := fun b => brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q)
      (fun _ _ => zero_le) haι
  calc brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r
      = (brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) := by
        rw [← ENNReal.rpow_mul, mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ ≤ (∑ b ∈ brsCoverFinset E δ,
          brsWindowMajAdd (b - δ / 2) (b + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmem (by positivity)

/-- **The `L^q` bound for the covered right window majorant.** -/
theorem lintegral_brsCoverMajAdd_rpow_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    {δ : ℝ} (hδ : 0 < δ) {c₁ c₂ : ℝ} (hlen : c₂ - c₁ ≤ δ)
    {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ} (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ^ (1 / q) ≤
      (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
        (ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
        (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  obtain ⟨hι, hcard⟩ := brsCoverFinset_spec hE hδ
  set M : ENNReal := ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) *
    (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) with hM
  have hexp : (0 : ℝ) ≤ 1 - 1 / p + 1 / q := by
    have hinv : 1 / p ≤ 1 := by
      rw [div_le_one hp0]
      exact hp1
    have : (0 : ℝ) < 1 / q := by positivity
    linarith
  have hpiece : ∀ a : ℝ,
      (∫⁻ r : ℝ, brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ≤ M ^ q := by
    intro a
    have h := lintegral_brsWindowMajAdd_rpow_le (u := a - δ / 2) (v := a + δ / 2)
      (c₁ := c₁) (c₂ := c₂) hF hp1 hpq
    have hlenle : ((a + δ / 2) - (a - δ / 2)) + (c₂ - c₁) ≤ 2 * δ := by linarith
    have h' : (∫⁻ r : ℝ,
        brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q) ^ (1 / q) ≤ M := by
      refine le_trans h ?_
      rw [hM]
      exact mul_le_mul'
        (ENNReal.rpow_le_rpow (ENNReal.ofReal_le_ofReal hlenle) hexp) le_rfl
    have := ENNReal.rpow_le_rpow h' hq0.le
    rwa [← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne', ENNReal.rpow_one] at this
  have hpow : ∀ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q =
      ∑ a ∈ brsCoverFinset E δ,
        brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q := by
    intro r
    rw [brsCoverMajAdd, ← ENNReal.rpow_mul, one_div_mul_cancel hq0.ne',
      ENNReal.rpow_one]
  have hmain : (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ≤
      ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
    rw [lintegral_congr hpow,
      lintegral_finsetSum' _ (fun a _ =>
        ((measurable_brsWindowMajAdd _ _ _ _ hF).pow_const q).aemeasurable)]
    calc (∑ a ∈ brsCoverFinset E δ,
          ∫⁻ r : ℝ, brsWindowMajAdd (a - δ / 2) (a + δ / 2) c₁ c₂ F r ^ q)
        ≤ ∑ _a ∈ brsCoverFinset E δ, M ^ q := Finset.sum_le_sum fun a _ => hpiece a
      _ = ((brsCoverFinset E δ).card : ENNReal) * M ^ q := by
          rw [Finset.sum_const, nsmul_eq_mul]
  calc (∫⁻ r : ℝ, brsCoverMajAdd E δ c₁ c₂ q F r ^ q) ^ (1 / q)
      ≤ (((brsCoverFinset E δ).card : ENNReal) * M ^ q) ^ (1 / q) :=
        ENNReal.rpow_le_rpow hmain (by positivity)
    _ = ((brsCoverFinset E δ).card : ENNReal) ^ (1 / q) * M := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
          mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    _ = (intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
          (ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q)) *
          (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) := by
        rw [hcard, hM]
        ring

/-! ## The near half `𝔐_{p,0}^+` for `p < 2`

Since `b = r + t` stays in `(1, 6)`, the weight bound on the `m`-th piece is
uniform in `b`, and the `m`-sum is a single geometric series. -/

/-- The uniform weight bound on the `m`-th right piece. -/
def brsRightWeight (p : ℝ) (m : ℕ) : ℝ :=
  (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ)

theorem brsRightWeight_nonneg (p : ℝ) (m : ℕ) : 0 ≤ brsRightWeight p m := by
  rw [brsRightWeight]
  have h1 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    Real.rpow_nonneg (by norm_num) _
  have h2 : (0 : ℝ) ≤ (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ) :=
    Real.rpow_nonneg (by positivity) _
  positivity

/-- **The uniform weight bound on a right piece.** -/
theorem mainWeightRight_piece_le_uniform {p b s : ℝ} (hp1 : 1 ≤ p) (hp2 : p ≤ 2)
    (hb1 : 1 ≤ b) (_hb6 : b ≤ 6) {m : ℕ} (hs : s ∈ brsRightPieceSet b m) :
    s ^ (1 / 2 - 1 / p) * (b - s) ^ (-(1 / 2) : ℝ) ≤ brsRightWeight p m := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hb0 : (0 : ℝ) < b := by linarith
  have hκ : 1 / 2 - 1 / p ≤ 0 := by
    have : (1 : ℝ) / 2 ≤ 1 / p := by
      rw [div_le_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  refine le_trans (mainWeightRight_piece_le hp1 hp2 hb0 hs) ?_
  rw [brsRightWeight]
  have hpow : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
  have hfirst : (b / 2) ^ (1 / 2 - 1 / p) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    rpow_le_rpow_of_nonpos_exp (by norm_num) (by linarith) hκ
  have hsecond : (b * (1 / 2 : ℝ) ^ (m + 2)) ^ (-(1 / 2) : ℝ) ≤
      (((1 / 2 : ℝ)) ^ (m + 2)) ^ (-(1 / 2) : ℝ) := by
    refine rpow_le_rpow_of_nonpos_exp hpow ?_ (by norm_num)
    nlinarith
  exact mul_le_mul hfirst hsecond (Real.rpow_nonneg (by positivity) _)
    (Real.rpow_nonneg (by norm_num) _)

/-- The measurable majorant of `𝔐_{p,0}^+`. -/
def brsMainZeroRightMaj (E : Set ℝ) (p q : ℝ) (g : ℝ → ℂ) (r : ℝ) : ENNReal :=
  Set.indicator (Ioo (2 / 3 : ℝ) 4)
    (fun r => ENNReal.ofReal (3 / 2) *
      ∑' m : ℕ, ENNReal.ofReal (brsRightWeight p m) *
        brsCoverMajAdd E (6 * (1 / 2 : ℝ) ^ (m + 1)) ((1 / 2 : ℝ) ^ (m + 2))
          (6 * (1 / 2 : ℝ) ^ (m + 1)) q (fun s => ENNReal.ofReal ‖g s‖) r) r

theorem measurable_brsMainZeroRightMaj (E : Set ℝ) (p q : ℝ) {g : ℝ → ℂ}
    (hg : Measurable g) : Measurable (brsMainZeroRightMaj E p q g) := by
  refine Measurable.indicator ?_ measurableSet_Ioo
  refine measurable_const.mul ?_
  refine Measurable.tsum fun m => ?_
  exact measurable_const.mul
    (measurable_brsCoverMajAdd _ _ _ _ _ hg.norm.ennreal_ofReal)

/-- **The majorant dominates `𝔐_{p,0}^+`.** -/
theorem brsMainZeroRight_le_maj {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) {p q : ℝ}
    (hp1 : 1 ≤ p) (hp2 : p ≤ 2) (hq0 : 0 < q) {g : ℝ → ℂ} (r : ℝ) :
    brsMainZeroRight E p g r ≤ brsMainZeroRightMaj E p q g r := by
  by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
  · rw [brsMainZeroRightMaj, Set.indicator_of_mem hr]
    refine iSup₂_le fun t ht => ?_
    obtain ⟨htE, ht1, ht2⟩ := ht
    obtain ⟨htlo, hthi⟩ := hE htE
    have hr0 : (0 : ℝ) < r := by linarith [hr.1]
    have hrinv : r⁻¹ ≤ 3 / 2 := by
      rw [inv_le_comm₀ hr0 (by norm_num)]
      linarith [hr.1]
    have hb1 : (1 : ℝ) ≤ r + t := by linarith [hr.1]
    have hb6 : r + t ≤ 6 := by linarith [hr.2]
    have hb0 : (0 : ℝ) < r + t := by linarith
    refine mul_le_mul' (ENNReal.ofReal_le_ofReal hrinv) ?_
    refine le_trans (lintegral_rightNear_le_tsum_pieces hb0 _) ?_
    refine ENNReal.tsum_le_tsum fun m => ?_
    -- the weight is uniform on the piece
    have hweight : (∫⁻ s in brsRightPieceSet (r + t) m,
        ENNReal.ofReal (s ^ (1 / 2 - 1 / p) *
          ((r + t) - s) ^ (-(1 / 2) : ℝ)) * ENNReal.ofReal ‖g s‖) ≤
        ENNReal.ofReal (brsRightWeight p m) *
          ∫⁻ s in brsRightPieceSet (r + t) m, ENNReal.ofReal ‖g s‖ := by
      rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
      refine setLIntegral_mono' measurableSet_Ioc ?_
      intro s hs
      exact mul_le_mul' (ENNReal.ofReal_le_ofReal
        (mainWeightRight_piece_le_uniform hp1 hp2 hb1 hb6 hs)) le_rfl
    refine le_trans hweight ?_
    refine mul_le_mul' le_rfl ?_
    refine le_trans (lintegral_mono_set
      (brsRightPieceSet_subset_shift hb1 hb6 m)) ?_
    refine le_trans ?_ (iSup_le_brsCoverMajAdd hE
      (by positivity : (0 : ℝ) < 6 * (1 / 2 : ℝ) ^ (m + 1)) hq0 r)
    exact le_iSup (fun w : E =>
      ∫⁻ s in Ioc (r + (w : ℝ) - 6 * (1 / 2 : ℝ) ^ (m + 1))
        (r + (w : ℝ) - (1 / 2 : ℝ) ^ (m + 2)),
        ENNReal.ofReal ‖g s‖) ⟨t, htE⟩
  · rw [brsMainZeroRightMaj, Set.indicator_of_notMem hr, brsMainZeroRight,
      brsMainWindow_empty hE hr]
    simp

/-! ## The geometric series at the right endpoint -/

/-- The constant of the right-endpoint term. -/
def brsRightConst (p q : ℝ) : ℝ :=
  (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
    (6 : ℝ) ^ (1 - 1 / p + 1 / q)

theorem brsRightConst_nonneg (p q : ℝ) : 0 ≤ brsRightConst p q := by
  rw [brsRightConst]
  have h1 : (0 : ℝ) ≤ (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) :=
    Real.rpow_nonneg (by norm_num) _
  have h2 : (0 : ℝ) ≤ (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) :=
    Real.rpow_nonneg (by norm_num) _
  have h3 : (0 : ℝ) ≤ (6 : ℝ) ^ (1 - 1 / p + 1 / q) :=
    Real.rpow_nonneg (by norm_num) _
  positivity

/-- **The `m`-th term at the right endpoint is geometric.** -/
theorem brs_right_term_identity {p q : ℝ} (m : ℕ) :
    brsRightWeight p m * ((6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
        (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q)) =
      brsRightConst p q * ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m := by
  set θ : ℝ := (1 / 2 : ℝ) ^ m with hθdef
  have hθ : (0 : ℝ) < θ := by rw [hθdef]; positivity
  have h1 : (6 : ℝ) * (1 / 2 : ℝ) ^ (m + 1) = 3 * θ := by
    rw [hθdef, pow_succ]; ring
  have h2 : ((1 / 2 : ℝ)) ^ (m + 2) = θ / 4 := by
    rw [hθdef, pow_succ, pow_succ]; ring
  have h3 : (2 : ℝ) * (3 * θ) = 6 * θ := by ring
  rw [brsRightWeight, brsRightConst, h1, h2, h3]
  have hq1 : (θ / 4) ^ (-(1 / 2) : ℝ) = θ ^ (-(1 / 2) : ℝ) * 2 := by
    rw [Real.div_rpow hθ.le (by norm_num)]
    have h4 : (4 : ℝ) ^ (-(1 / 2) : ℝ) = 1 / 2 := by
      rw [show (4 : ℝ) = 2 ^ (2 : ℝ) from by
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) from by norm_num, Real.rpow_natCast]
        norm_num, ← Real.rpow_mul (by norm_num)]
      norm_num
    rw [h4]
    ring
  have hq2 : ((3 : ℝ) * θ) ^ (-(1 - 2 / p + 1 / q)) =
      (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) * θ ^ (-(1 - 2 / p + 1 / q)) :=
    Real.mul_rpow (by norm_num) hθ.le
  have hq3 : ((6 : ℝ) * θ) ^ (1 - 1 / p + 1 / q) =
      (6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 - 1 / p + 1 / q) :=
    Real.mul_rpow (by norm_num) hθ.le
  rw [hq1, hq2, hq3]
  have hθpow : θ ^ (-(1 / 2) : ℝ) * θ ^ (-(1 - 2 / p + 1 / q)) *
      θ ^ (1 - 1 / p + 1 / q) = θ ^ (1 / p - 1 / 2) := by
    rw [← Real.rpow_add hθ, ← Real.rpow_add hθ]
    congr 1
    ring
  have hlast : ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m = θ ^ (1 / p - 1 / 2) := by
    rw [hθdef, half_pow_rpow]
  rw [hlast]
  calc (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * (θ ^ (-(1 / 2) : ℝ) * 2) *
        ((3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) * θ ^ (-(1 - 2 / p + 1 / q)) *
          ((6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 - 1 / p + 1 / q)))
      = (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
          (6 : ℝ) ^ (1 - 1 / p + 1 / q) *
          (θ ^ (-(1 / 2) : ℝ) * θ ^ (-(1 - 2 / p + 1 / q)) *
            θ ^ (1 - 1 / p + 1 / q)) := by ring
    _ = (1 / 2 : ℝ) ^ (1 / 2 - 1 / p) * 2 * (3 : ℝ) ^ (-(1 - 2 / p + 1 / q)) *
          (6 : ℝ) ^ (1 - 1 / p + 1 / q) * θ ^ (1 / p - 1 / 2) := by
        rw [hθpow]

/-! ## BRS Proposition 5.5(ii) for the near half at the right endpoint -/

theorem tsum_ofReal_geom {C ρ : ℝ} (hC : 0 ≤ C) (hρ0 : 0 ≤ ρ) (hρ1 : ρ < 1) :
    (∑' m : ℕ, ENNReal.ofReal (C * ρ ^ m)) = ENNReal.ofReal (C * (1 - ρ)⁻¹) := by
  have hsummable : Summable fun m : ℕ => C * ρ ^ m :=
    (summable_geometric_of_lt_one hρ0 hρ1).mul_left C
  rw [← ENNReal.ofReal_tsum_of_nonneg (fun m => by positivity) hsummable,
    tsum_mul_left, tsum_geometric_of_lt_one hρ0 hρ1]

/-- The constant of the near half at the right endpoint. -/
def brsMainZeroRightTotalConst (p q : ℝ) : ℝ :=
  (4 : ℝ) ^ (1 / q) * (3 / 2) * brsRightConst p q *
    (1 - (1 / 2 : ℝ) ^ (1 / p - 1 / 2))⁻¹

/-- **BRS Proposition 5.5(ii) for `𝔐_{p,0}^+`.** -/
theorem lintegral_brsMainZeroRightMaj_bound {E : Set ℝ}
    (hE : E ⊆ Icc (1 : ℝ) 2) {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2)
    (hpq : p ≤ q) (hAE : 0 ≤ AE) (hcov : HasBRSCoveringBound E p q AE)
    {g : ℝ → ℂ} (hg : Measurable g) :
    (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (brsMainZeroRightTotalConst p q * AE) *
        (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  have hβ : (0 : ℝ) < 1 / p - 1 / 2 := by
    have : 1 / 2 < 1 / p := by
      rw [div_lt_div_iff₀ (by norm_num) hp0]
      linarith
    linarith
  set ρ : ℝ := (1 / 2 : ℝ) ^ (1 / p - 1 / 2) with hρdef
  have hρ0 : 0 < ρ := by rw [hρdef]; positivity
  have hρ1 : ρ < 1 := by
    rw [hρdef]
    exact Real.rpow_lt_one (by norm_num) (by norm_num) hβ
  set F : ℝ → ENNReal := fun s => ENNReal.ofReal ‖g s‖ with hF
  have hFmeas : Measurable F := hg.norm.ennreal_ofReal
  set Gp : ENNReal := (∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) with hGp
  set T : ℕ → ℝ → ENNReal := fun m r =>
    ENNReal.ofReal (brsRightWeight p m) *
      brsCoverMajAdd E (6 * (1 / 2 : ℝ) ^ (m + 1)) ((1 / 2 : ℝ) ^ (m + 2))
        (6 * (1 / 2 : ℝ) ^ (m + 1)) q F r with hT
  have hTmeas : ∀ m : ℕ, Measurable (T m) := by
    intro m
    exact measurable_const.mul (measurable_brsCoverMajAdd _ _ _ _ _ hFmeas)
  -- the radial weight is bounded on the support
  have hpt : ∀ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q ≤
      ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) * (∑' m : ℕ, T m r) ^ q := by
    intro r
    by_cases hr : r ∈ Ioo (2 / 3 : ℝ) 4
    · rw [brsMainZeroRightMaj, Set.indicator_of_mem hr]
      calc ENNReal.ofReal r * (ENNReal.ofReal (3 / 2) * ∑' m : ℕ, T m r) ^ q
          ≤ ENNReal.ofReal 4 * (ENNReal.ofReal (3 / 2) * ∑' m : ℕ, T m r) ^ q :=
            mul_le_mul' (ENNReal.ofReal_le_ofReal hr.2.le) le_rfl
        _ = ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) *
              (∑' m : ℕ, T m r) ^ q := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← mul_assoc,
              ENNReal.ofReal_rpow_of_pos (by norm_num),
              ← ENNReal.ofReal_mul (by norm_num)]
    · rw [brsMainZeroRightMaj, Set.indicator_of_notMem hr,
        ENNReal.zero_rpow_of_pos hq0, mul_zero]
      exact zero_le
  have hmain : (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainZeroRightMaj E p q g r ^ q) ≤
      ENNReal.ofReal ((4 : ℝ) * (3 / 2 : ℝ) ^ q) *
        ∫⁻ r : ℝ, (∑' m : ℕ, T m r) ^ q := by
    rw [← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
    exact lintegral_mono hpt
  refine le_trans (ENNReal.rpow_le_rpow hmain (by positivity)) ?_
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity),
    ENNReal.ofReal_rpow_of_pos (by positivity)]
  -- Minkowski over the piece index
  have hmink : (∫⁻ r : ℝ, (∑' m : ℕ, T m r) ^ q) ^ (1 / q) ≤
      ∑' m : ℕ, (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) :=
    lintegral_rpow_tsum_le hq1 hTmeas
  have hterm : ∀ m : ℕ, (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) ≤
      ENNReal.ofReal (AE * brsRightConst p q * ρ ^ m) * Gp := by
    intro m
    set δ : ℝ := 6 * (1 / 2 : ℝ) ^ (m + 1) with hδdef
    have hδ0 : 0 < δ := by rw [hδdef]; positivity
    have hδ6 : δ ≤ 6 := by
      rw [hδdef]
      have hpow : (1 / 2 : ℝ) ^ (m + 1) ≤ 1 :=
        pow_le_one₀ (by norm_num) (by norm_num)
      nlinarith
    have hlen : δ - (1 / 2 : ℝ) ^ (m + 2) ≤ δ := by
      have : (0 : ℝ) < (1 / 2 : ℝ) ^ (m + 2) := by positivity
      linarith
    have hcma := lintegral_brsCoverMajAdd_rpow_le hE hδ0 hlen hFmeas hp1 hpq
    have hpull : (∫⁻ r : ℝ, T m r ^ q) ^ (1 / q) =
        ENNReal.ofReal (brsRightWeight p m) *
          (∫⁻ r : ℝ, brsCoverMajAdd E δ ((1 / 2 : ℝ) ^ (m + 2)) δ q F r ^ q) ^
            (1 / q) := by
      rw [hT]
      simp only
      rw [lintegral_congr (fun r => ENNReal.mul_rpow_of_nonneg _ _ hq0.le),
        lintegral_const_mul' _ _
          (ENNReal.rpow_ne_top_of_nonneg hq0.le ENNReal.ofReal_ne_top),
        ENNReal.mul_rpow_of_nonneg _ _ (by positivity), ← ENNReal.rpow_mul,
        mul_one_div_cancel hq0.ne', ENNReal.rpow_one]
    rw [hpull]
    refine le_trans (mul_le_mul' le_rfl hcma) ?_
    have hFnorm : (∫⁻ s : ℝ, F s ^ p) ^ (1 / p) = Gp := by rw [hF, hGp]
    rw [hFnorm]
    have hN := hcov δ hδ0 hδ6
    have hpow2 : ENNReal.ofReal (2 * δ) ^ (1 - 1 / p + 1 / q) =
        ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) :=
      ENNReal.ofReal_rpow_of_pos (by positivity)
    rw [hpow2]
    calc ENNReal.ofReal (brsRightWeight p m) *
          ((intervalCoveringNumber E δ : ENNReal) ^ (1 / q) *
            ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) * Gp)
        ≤ ENNReal.ofReal (brsRightWeight p m) *
            (ENNReal.ofReal (AE * δ ^ (-(1 - 2 / p + 1 / q))) *
              ENNReal.ofReal ((2 * δ) ^ (1 - 1 / p + 1 / q)) * Gp) :=
          mul_le_mul' le_rfl (mul_le_mul' (mul_le_mul' hN le_rfl) le_rfl)
      _ = ENNReal.ofReal (brsRightWeight p m *
            (AE * δ ^ (-(1 - 2 / p + 1 / q)) *
              (2 * δ) ^ (1 - 1 / p + 1 / q))) * Gp := by
          rw [← ENNReal.ofReal_mul (by positivity), ← mul_assoc,
            ← ENNReal.ofReal_mul (brsRightWeight_nonneg p m)]
      _ = ENNReal.ofReal (AE * brsRightConst p q * ρ ^ m) * Gp := by
          congr 2
          rw [hδdef, hρdef]
          calc brsRightWeight p m *
                (AE * (6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
                  (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q))
              = AE * (brsRightWeight p m *
                  ((6 * (1 / 2 : ℝ) ^ (m + 1)) ^ (-(1 - 2 / p + 1 / q)) *
                    (2 * (6 * (1 / 2 : ℝ) ^ (m + 1))) ^ (1 - 1 / p + 1 / q))) := by
                ring
            _ = AE * (brsRightConst p q *
                  ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m) := by
                rw [brs_right_term_identity]
            _ = AE * brsRightConst p q * ((1 / 2 : ℝ) ^ (1 / p - 1 / 2)) ^ m := by
                ring
  refine le_trans (mul_le_mul' le_rfl (le_trans hmink
    (ENNReal.tsum_le_tsum hterm))) ?_
  rw [ENNReal.tsum_mul_right,
    tsum_ofReal_geom (mul_nonneg hAE (brsRightConst_nonneg p q)) hρ0.le hρ1]
  rw [← mul_assoc, ← ENNReal.ofReal_mul (by positivity)]
  refine mul_le_mul' (le_of_eq ?_) le_rfl
  congr 1
  rw [brsMainZeroRightTotalConst, ← hρdef]
  have h4 : ((4 : ℝ) * (3 / 2 : ℝ) ^ q) ^ (1 / q) =
      (4 : ℝ) ^ (1 / q) * (3 / 2 : ℝ) := by
    rw [Real.mul_rpow (by norm_num) (Real.rpow_nonneg (by norm_num) _),
      ← Real.rpow_mul (by norm_num : (0 : ℝ) ≤ 3 / 2),
      mul_one_div_cancel hq0.ne', Real.rpow_one]
  rw [h4]
  ring

/-! ## BRS Proposition 5.5(ii), right endpoint

Adding the two halves of `𝔐_p^+`; the splitting costs no constant at all
because `r + t - s ≥ s` on the far half. -/

/-- **BRS Proposition 5.5(ii), right endpoint.** -/
theorem prop55ii_brsMainTwoRight {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2)
    (hEne : E.Nonempty) (hEnull : volume (closure E) = 0)
    {p q AE : ℝ} (hp1 : 1 ≤ p) (hp2 : p < 2) (hpq : p ≤ q) (hAE : 0 < AE)
    (hcov : HasBRSCoveringBound E p q AE) {g : ℝ → ℂ} (hg : Measurable g) :
    ∃ C : ENNReal, C ≠ ⊤ ∧
      (∫⁻ r : ℝ, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q) ^ (1 / q) ≤
        C * ((∫⁻ s : ℝ, ENNReal.ofReal ‖g s‖ ^ p) ^ (1 / p) +
          (∫⁻ s in Ioi (0 : ℝ), (ENNReal.ofReal ‖g s‖) ^ p) ^ (1 / p)) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set a : ℝ := 1 - 2 / p with hadef
  have ha : a < 0 := by
    rw [hadef]
    have : 1 < 2 / p := by
      rw [lt_div_iff₀ hp0]
      linarith
    linarith
  have hae : ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) + 1 - 1 / p = a := by
    rw [hadef]
    push_cast
    ring
  have hdyad := hasBRSCoveringBound_dyadic (E := E) (p := p) (q := q) (AE := AE)
    hq0 hAE.le hcov (a := a) hadef.symm
  have hnear := lintegral_brsMainZeroRightMaj_bound hE hp1 hp2 hpq hAE.le hcov hg
  have hfar := prop55ii_brsMainInfRight hE hEne hEnull hp1 hq1 hpq hae ha
    (by positivity : (0 : ℝ) < AE) hdyad hg
  rw [show ((2 : ℕ) - 1) = 1 from by norm_num] at hfar
  simp only [pow_one] at hfar
  have hsplit : ∀ r : ℝ, ENNReal.ofReal r * brsMainTwoRight E p g r ^ q ≤
      ENNReal.ofReal r *
        (brsMainZeroRightMaj E p q g r + 1 * brsMainInfRight E p g r) ^ q := by
    intro r
    by_cases hr0 : 0 < r
    · refine mul_le_mul' le_rfl (ENNReal.rpow_le_rpow ?_ hq0.le)
      refine le_trans (brsMainTwoRight_le_split hr0) ?_
      rw [one_mul]
      exact add_le_add (brsMainZeroRight_le_maj hE hp1 hp2.le hq0 r) le_rfl
    · rw [ENNReal.ofReal_eq_zero.mpr (by linarith [not_lt.mp hr0]), zero_mul,
        zero_mul]
  refine ⟨(2 : ENNReal) ^ (1 - 1 / q) *
    (ENNReal.ofReal (brsMainZeroRightTotalConst p q * AE) +
      ENNReal.ofReal ((shellConst 2 p q a AE *
        (blockConstBase ((((2 : ℕ) : ℝ) - 1) * (1 - 1 / p) - 1) p *
          ((2 : ℝ) ^ (-a)) ^ (2 : ℕ) * (1 - ((2 : ℝ) ^ (-a))⁻¹)⁻¹)) ^ (1 / q))),
    ?_, ?_⟩
  · refine ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg ?_ (by simp)) ?_
    · have : 1 / q ≤ 1 := by
        rw [div_le_one hq0]
        exact hq1
      linarith
    · exact ENNReal.add_ne_top.mpr ⟨ENNReal.ofReal_ne_top, ENNReal.ofReal_ne_top⟩
  · refine le_trans (ENNReal.rpow_le_rpow (lintegral_mono hsplit)
      (by positivity)) ?_
    refine le_trans (lintegral_radial_rpow_add_le
      (measurable_brsMainZeroRightMaj E p q hg) (by simp) hq1) ?_
    refine le_trans (mul_le_mul' le_rfl
