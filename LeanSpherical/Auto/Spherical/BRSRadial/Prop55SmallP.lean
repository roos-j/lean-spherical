/-! ## Covering the dyadic neighbourhood by intervals

BRS write the shell `D_n` as a union of `≈ N(E, 2^{-n})` intervals of length
`≈ 2^{-n}`; this is the family the `r`-variable lives in for the localized
estimates of Proposition 5.5(ii)–(iii).  The cover comes straight from a
`2^{-n}`-cover of `E`, fattened by `3·2^{-n}`. -/

/-- **The interval cover of the dyadic neighbourhood.**  A `δ`-cover of `E`,
fattened to length `7δ`, covers `U_n`. -/
theorem exists_cover_brsU {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (n : ℕ) :
    ∃ ι : Finset ℝ,
      ι.card = intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) ∧
        brsU E n ⊆ ⋃ a ∈ ι,
          Icc (a - 7 * (2 : ℝ) ^ (-(n : ℤ)) / 2) (a + 7 * (2 : ℝ) ^ (-(n : ℤ)) / 2) := by
  set δ : ℝ := (2 : ℝ) ^ (-(n : ℤ)) with hδ
  have hδpos : 0 < δ := by
    rw [hδ]
    positivity
  obtain ⟨ι, hι, hcard⟩ :=
    exists_intervalCover_card_eq_intervalCoveringNumber hE hδpos
  refine ⟨ι, hcard, ?_⟩
  intro r hr
  have hdist : Metric.infDist r E ≤ 2 * δ := hr
  obtain ⟨t, htE, hrt⟩ : ∃ t ∈ E, dist r t < 3 * δ := by
    have hlt : Metric.infDist r E < 3 * δ := by linarith
    exact (Metric.infDist_lt_iff hEne).mp hlt
  obtain ⟨a, haι, hat⟩ : ∃ a ∈ ι, t ∈ Icc (a - δ / 2) (a + δ / 2) := by
    have hcov := hι htE
    simpa only [Set.mem_iUnion, exists_prop] using hcov
  refine Set.mem_biUnion haι ?_
  rw [Real.dist_eq, abs_lt] at hrt
  constructor
  · have := hat.1
    have := hrt.1
    linarith
  · have := hat.2
    have := hrt.2
    linarith

/-- The shells are contained in the cover of the neighbourhood. -/
theorem brsD_subset_brsU (E : Set ℝ) (n : ℕ) : brsD E n ⊆ brsU E n :=
  fun _ hr => hr.1

/-- The measure of a shell, in terms of the covering number. -/
theorem volume_brsD_le {E : Set ℝ} (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (n : ℕ) :
    volume (brsD E n) ≤
      ENNReal.ofReal (7 * (2 : ℝ) ^ (-(n : ℤ))) *
        (intervalCoveringNumber E ((2 : ℝ) ^ (-(n : ℤ))) : ℝ≥0∞) :=
  le_trans (measure_mono (brsD_subset_brsU E n)) (volume_brsU_le hE hEne n)

/-! ## Young's inequality against an indicator

Mathlib has no general Young convolution inequality, but the case needed for
BRS Proposition 5.5(ii)–(iii) — convolution with the indicator of a set — needs
none: Hölder inside the convolution reduces it to the `L^1 ∗ L^s → L^s` case,
which is `lintegral_shift_mul_rpow_le`.  Explicitly, with `s = q/p`,

`(1_Q ∗ F)(x) ≤ |Q|^{1-1/p} (1_Q ∗ F^p)(x)^{1/p}`,
`‖1_Q ∗ F^p‖_{s} ≤ |Q|^{1/s} ‖F^p‖_1`,

and multiplying out gives `‖1_Q ∗ F‖_q ≤ |Q|^{1 - 1/p + 1/q} ‖F‖_p`. -/

/-- The reflected translate of a set has the same measure. -/
theorem volume_preimage_sub_left (x : ℝ) {Q : Set ℝ} (hQ : MeasurableSet Q) :
    volume ((fun y : ℝ => x - y) ⁻¹' Q) = volume Q := by
  have hmp : MeasurePreserving (fun y : ℝ => x - y) volume volume :=
    Measure.measurePreserving_sub_left volume x
  rw [← hmp.measure_preimage hQ.nullMeasurableSet]

/-- The convolution with an indicator, written as a set integral. -/
theorem lintegral_indicator_shift {Q : Set ℝ} (hQ : MeasurableSet Q)
    (F : ℝ → ENNReal) (x : ℝ) :
    (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) =
      ∫⁻ y in (fun y : ℝ => x - y) ⁻¹' Q, F y := by
  have hpre : MeasurableSet ((fun y : ℝ => x - y) ⁻¹' Q) :=
    hQ.preimage (measurable_const.sub measurable_id)
  have hfun : (fun y : ℝ => Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y)
      = Set.indicator ((fun y : ℝ => x - y) ⁻¹' Q) F := by
    funext y
    by_cases hy : x - y ∈ Q
    · rw [Set.indicator_of_mem hy, one_mul,
        Set.indicator_of_mem (show y ∈ (fun y : ℝ => x - y) ⁻¹' Q from hy)]
    · rw [Set.indicator_of_notMem hy, zero_mul,
        Set.indicator_of_notMem (show y ∉ (fun y : ℝ => x - y) ⁻¹' Q from hy)]
  rw [hfun, lintegral_indicator hpre]

/-- **Hölder inside the convolution.** -/
theorem lintegral_indicator_conv_le_pointwise {Q : Set ℝ} (hQ : MeasurableSet Q)
    {F : ℝ → ENNReal} (hF : Measurable F) {p : ℝ} (hp1 : 1 ≤ p) (x : ℝ) :
    (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) ≤
      (volume Q) ^ (1 - 1 / p) *
        (∫⁻ y : ℝ,
          Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y ^ p) ^ (1 / p) := by
  have hpre : MeasurableSet ((fun y : ℝ => x - y) ⁻¹' Q) :=
    hQ.preimage (measurable_const.sub measurable_id)
  rw [lintegral_indicator_shift hQ F x, lintegral_indicator_shift hQ (fun y => F y ^ p) x]
  have hholder := lintegral_le_rpow_mul_measure_univ
    (μ := volume.restrict ((fun y : ℝ => x - y) ⁻¹' Q)) hF hp1
  rw [Measure.restrict_apply_univ, volume_preimage_sub_left x hQ] at hholder
  rw [mul_comm]
  exact hholder

/-- **Young's inequality against an indicator.** -/
theorem lintegral_indicator_conv_rpow_le {Q : Set ℝ} (hQ : MeasurableSet Q)
    (hQfin : volume Q ≠ ⊤) {F : ℝ → ENNReal} (hF : Measurable F) {p q : ℝ}
    (hp1 : 1 ≤ p) (hpq : p ≤ q) :
    (∫⁻ x : ℝ,
        (∫⁻ y : ℝ, Set.indicator Q (fun _ => (1 : ENNReal)) (x - y) * F y) ^ q) ^
        (1 / q) ≤
      (volume Q) ^ (1 - 1 / p + 1 / q) * (∫⁻ y : ℝ, F y ^ p) ^ (1 / p) := by
  have hp0 : (0 : ℝ) < p := lt_of_lt_of_le zero_lt_one hp1
  have hq1 : (1 : ℝ) ≤ q := le_trans hp1 hpq
  have hq0 : (0 : ℝ) < q := lt_of_lt_of_le zero_lt_one hq1
  set s : ℝ := q / p with hs
  have hs1 : (1 : ℝ) ≤ s := by
    rw [hs, le_div_iff₀ hp0]
    linarith
  have hs0 : (0 : ℝ) < s := lt_of_lt_of_le zero_lt_one hs1
  set K : ℝ → ENNReal := fun u => Set.indicator Q (fun _ => (1 : ENNReal)) u with hK
  have hKmeas : Measurable K := by
    rw [hK]
    exact (measurable_const.indicator hQ)
  have hFp : Measurable fun y : ℝ => F y ^ p := hF.pow_const p
  -- the `L^1 ∗ L^s` step
