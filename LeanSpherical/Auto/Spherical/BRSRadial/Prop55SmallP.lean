    have h := lintegral_indicator_conv_le_pointwise hQ hF hp1 x
    have h' := ENNReal.rpow_le_rpow h hq0.le
    refine le_trans h' (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ hq0.le, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    congr 2
    rw [hs]
    field_simp
  -- integrate
  have hmain : (∫⁻ x : ℝ, (∫⁻ y : ℝ, K (x - y) * F y) ^ q) ≤
      (volume Q) ^ ((1 - 1 / p) * q) *
        ((∫⁻ y : ℝ, F y ^ p) ^ (s - 1) *
          ((∫⁻ y : ℝ, F y ^ p) * ∫⁻ u : ℝ, K u ^ s)) := by
    refine le_trans (lintegral_mono hptwise) ?_
    rw [lintegral_const_mul' _ _ (by
      refine ENNReal.rpow_ne_top_of_nonneg ?_ hQfin
      have : 1 / p ≤ 1 := by
        rw [div_le_one hp0]
        exact hp1
      nlinarith)]
