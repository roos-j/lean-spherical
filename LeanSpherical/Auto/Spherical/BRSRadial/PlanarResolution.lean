  change (∫ x : ℝ, 2 ^ j * φ (2 ^ j * x)) = ∫ x, φ x
  rw [integral_const_mul]
  rw [MeasureTheory.Measure.integral_comp_mul_left (fun y => φ y) ((2 : ℝ) ^ j)]
  rw [smul_eq_mul, ← mul_assoc]
  have habs : |((2 : ℝ) ^ j)⁻¹| = ((2 : ℝ) ^ j)⁻¹ :=
    abs_of_pos (by positivity)
  rw [habs, mul_inv_cancel₀ hne, one_mul]

/-- The Littlewood--Paley piece `ψ_j = φ_j - φ_{j-1}`. -/
def brsLPKernel (φ : ℝ → ℝ) (j : ℕ) (x : ℝ) : ℝ :=
  brsDilate φ (j + 1) x - brsDilate φ j x

theorem continuous_brsLPKernel {φ : ℝ → ℝ} (hφ : Continuous φ) (j : ℕ) :
    Continuous (brsLPKernel φ j) :=
  (continuous_brsDilate hφ (j + 1)).sub (continuous_brsDilate hφ j)

