    fwdDiff_iter_pow_eq_zero_of_lt hj
  have hsum := fwdDiff_iter_eq_sum_shift (h := (1 : ℝ))
    (fun r : ℝ => r ^ j) N 0
  rw [hzero] at hsum
  have hsum' : (0 : ℝ) =
      ∑ k ∈ Finset.range (N + 1), ((-1 : ℤ) ^ (N - k) * (N.choose k) : ℤ) •
        ((k : ℝ) ^ j) := by
    simpa using hsum
  have hfac : ∀ k ∈ Finset.range (N + 1),
      ((-1 : ℤ) ^ (N - k) * (N.choose k) : ℤ) • ((k : ℝ) ^ j) =
        (-1 : ℝ) ^ N * ((-1 : ℝ) ^ k * (N.choose k) * (k : ℝ) ^ j) := by
    intro k hk
    have hkN : k ≤ N := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
    have hpow : ((-1 : ℝ)) ^ (N - k) = (-1 : ℝ) ^ N * (-1 : ℝ) ^ k := by
      have : (-1 : ℝ) ^ N = (-1 : ℝ) ^ (N - k) * (-1 : ℝ) ^ k := by
        rw [← pow_add]
        congr 1
        omega
      rw [this]
      rw [mul_assoc, ← pow_add]
      have h2 : k + k = 2 * k := by ring
      rw [h2, pow_mul]
      norm_num
    rw [zsmul_eq_mul]
    push_cast
    rw [hpow]
    ring
  rw [Finset.sum_congr rfl hfac, ← Finset.mul_sum] at hsum'
  have hne : ((-1 : ℝ) ^ N) ≠ 0 := pow_ne_zero N (by norm_num)
  exact (mul_eq_zero.mp hsum'.symm).resolve_left hne

