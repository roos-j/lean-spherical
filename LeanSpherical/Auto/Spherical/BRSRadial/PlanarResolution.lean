    Continuous (brsDilate φ j) := by
  change Continuous fun x : ℝ => 2 ^ j * φ (2 ^ j * x)
  exact continuous_const.mul (hφ.comp (continuous_const.mul continuous_id))

theorem hasCompactSupport_brsDilate {φ : ℝ → ℝ} (hφ : HasCompactSupport φ)
    (j : ℕ) : HasCompactSupport (brsDilate φ j) := by
  have hne : (2 : ℝ) ^ j ≠ 0 := by positivity
  have hcomp : HasCompactSupport (fun x : ℝ => φ (2 ^ j * x)) := by
    have hhom : HasCompactSupport (φ ∘ fun x : ℝ => (2 : ℝ) ^ j * x) := by
      refine hφ.comp_homeomorph (Homeomorph.mulLeft₀ ((2 : ℝ) ^ j) hne)
    exact hhom
  exact hcomp.mul_left

/-- Dilation preserves the integral. -/
theorem integral_brsDilate (φ : ℝ → ℝ) (j : ℕ) :
    (∫ x, brsDilate φ j x) = ∫ x, φ x := by
