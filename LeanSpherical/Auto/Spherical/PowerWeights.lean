  have hddkfun : (ddk : Euclidean d →
      (Euclidean d →L[ℝ] (Euclidean d →L[ℝ] ℂ))) =
      fderiv ℝ (fderiv ℝ (k : Euclidean d → ℂ)) := by
    funext x
    calc
      ddk x = fderiv ℝ (dk : Euclidean d → (Euclidean d →L[ℝ] ℂ)) x :=
        SchwartzMap.fderivCLM_apply ℂ dk x
      _ = fderiv ℝ (fderiv ℝ (k : Euclidean d → ℂ)) x := by
        rw [hdkfun]
  have hdkSmooth : ContDiff ℝ 1 (dk : Euclidean d → (Euclidean d →L[ℝ] ℂ)) := by
