    (∫⁻ x, (⨆ m : ℕ, u m x) ^ p ∂mu) ≤ B := by
  have hpow_mono : Monotone (fun m : ℕ => fun x => (u m x) ^ p) := by
    intro m l hml x
    exact ENNReal.rpow_le_rpow (hu_mono hml x) hp.le
  have hpow_iSup (x : X) :
