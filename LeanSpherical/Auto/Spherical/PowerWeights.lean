theorem exists_restrictedRelativeBandpass_intervalCover_cap_shell_lintegral_rpow_le_of_global_nonneg
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
