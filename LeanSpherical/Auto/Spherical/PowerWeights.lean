    rw [← hddkfun]
    simpa only [pow_one] using ddk.integrable_pow_mul volume 1
  let dK : SchwartzMap (Euclidean d) (Euclidean d →L[ℝ] ℂ) :=
    (SchwartzMap.fderivCLM ℂ (Euclidean d) ℂ) K
  let ddK : SchwartzMap (Euclidean d)
      (Euclidean d →L[ℝ] (Euclidean d →L[ℝ] ℂ)) :=
    (SchwartzMap.fderivCLM ℂ (Euclidean d) (Euclidean d →L[ℝ] ℂ)) dK
  have hdKfun : (dK : Euclidean d → (Euclidean d →L[ℝ] ℂ)) =
