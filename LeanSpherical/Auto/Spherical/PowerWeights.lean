    rw [ENNReal.ofReal_pow (by norm_num : (0 : Real) ≤ 2)]
    norm_num
    exact ENNReal.inv_pow.symm
  rw [hbase, ENNReal.inv_rpow, ← ENNReal.rpow_neg]

private theorem dyadic_deep_gain_le_rate
    {n j : Nat} {alpha epsilon : Real}
    (hepsilon : 0 ≤ epsilon) (hgain : epsilon ≤ (n : Real) + alpha) :
    (ENNReal.ofReal ((2 : Real) ^ j)) ^ (-((n : Real) + alpha)) ≤
      (dyadicMultiplicativeScale j : ENNReal) ^ epsilon := by
  calc
    (ENNReal.ofReal ((2 : Real) ^ j)) ^ (-((n : Real) + alpha)) =
        (dyadicMultiplicativeScale j : ENNReal) ^ ((n : Real) + alpha) :=
      (dyadicMultiplicativeScale_rpow_eq_dyadic_inverse j ((n : Real) + alpha)).symm
    _ ≤ (dyadicMultiplicativeScale j : ENNReal) ^ epsilon :=
      ENNReal.rpow_le_rpow_of_exponent_ge
        (by exact_mod_cast dyadicMultiplicativeScale_le_one j) hgain

private theorem thinRadial_short_piece_input_sum_le
    {n k : Nat} (hk : 4 ≤ k) (s : Real) (hscale : s = ((2 : Real) ^ k)⁻¹)
    (f : SchwartzMap (Euclidean (n + 1)) Complex) {p alpha : Real} (hp : 0 < p) :
    (∑ m ∈ Finset.Icc 2 (2 ^ (k + 3)),
      ∫⁻ x : Euclidean (n + 1),
        (ENNReal.ofReal
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s
              (by rw [hscale]; positivity) m)) x‖) ^ p ∂
          powerWeightedVolume (n + 1) alpha) ≤
      ((ENNReal.ofReal 2) ^ p * 2) *
        ∫⁻ x : Euclidean (n + 1), (ENNReal.ofReal ‖f x‖) ^ p ∂
          powerWeightedVolume (n + 1) alpha := by
  let hs : 0 < s := by
    rw [hscale]
    positivity
  let M : Finset Nat := Finset.Icc 2 (2 ^ (k + 3))
  let g : Nat → SchwartzMap (Euclidean (n + 1)) Complex := fun m =>
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition (n + 1) s hs m)
  have hpositive : ∀ m ∈ M, 0 < s * ((m : Real) - 1 / 4) := by
    intro m hm
    apply mul_pos hs
    have hmtwo : 2 ≤ m := (Finset.mem_Icc.mp hm).1
    have hmreal : (2 : Real) ≤ (m : Real) := by exact_mod_cast hmtwo
    linarith
  have hmeas (m : Nat) (hm : m ∈ M) :
      Measurable (fun x : Euclidean (n + 1) => ‖g m x‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp (g m).continuous.enorm.measurable
  have hsum :
      (∑ m ∈ M, ∫⁻ x : Euclidean (n + 1), ‖g m x‖ₑ ^ p ∂
        powerWeightedVolume (n + 1) alpha) =
        ∫⁻ x : Euclidean (n + 1), ∑ m ∈ M, ‖g m x‖ₑ ^ p ∂
          powerWeightedVolume (n + 1) alpha := by
    rw [lintegral_finsetSum]
    intro m hm
    exact hmeas m hm
  have hoverlap := lintegral_sum_enorm_rpow_thinRadialPartition_piece_le
    hs f M hpositive hp (powerWeightedVolume (n + 1) alpha)
  calc
    (∑ m ∈ Finset.Icc 2 (2 ^ (k + 3)),
      ∫⁻ x : Euclidean (n + 1),
        (ENNReal.ofReal
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s
              (by rw [hscale]; positivity) m)) x‖) ^ p ∂
          powerWeightedVolume (n + 1) alpha) =
        ∑ m ∈ M, ∫⁻ x : Euclidean (n + 1), ‖g m x‖ₑ ^ p ∂
          powerWeightedVolume (n + 1) alpha := by
            simp only [M, g, hs, ofReal_norm]
    _ = ∫⁻ x : Euclidean (n + 1), ∑ m ∈ M, ‖g m x‖ₑ ^ p ∂
          powerWeightedVolume (n + 1) alpha := hsum
    _ ≤ ((ENNReal.ofReal 2) ^ p * 2) *
        ∫⁻ x : Euclidean (n + 1), ‖f x‖ₑ ^ p ∂
          powerWeightedVolume (n + 1) alpha := hoverlap
    _ = _ := by
          simp only [ofReal_norm]

/-- Absorb a fixed finite collection of raw-band coefficients into the
decaying rate.  This is used only for the finitely many frequencies before
the strict entropy estimate begins. -/
private theorem exists_finiteHead_raw_band_rate
    {p epsilon : Real} (hp : 1 < p) (hepsilon : 0 ≤ epsilon)
    (J : Nat) (H : Nat → ENNReal) (hHtop : ∀ i, H i ≠ ∞) :
    ∃ Khead : ENNReal, Khead ≠ ∞ ∧
      ∀ j, j < J →
        H j ≤ Khead * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) *
          (dyadicMultiplicativeScale j : ENNReal) ^ epsilon := by
  let Khead : ENNReal := ∑ i ∈ Finset.range J,
    H i * (dyadicMultiplicativeScale i : ENNReal) ^ (-epsilon)
  have hKheadtop : Khead ≠ ∞ := by
    dsimp only [Khead]
    apply ENNReal.sum_ne_top.mpr
    intro i hi
    apply ENNReal.mul_ne_top (hHtop i)
    apply ENNReal.rpow_ne_top_of_ne_zero
    · exact ENNReal.coe_ne_zero.mpr (dyadicMultiplicativeScale_pos i).ne'
    · exact ENNReal.coe_ne_top
  refine ⟨Khead, hKheadtop, ?_⟩
  intro j hj
  let delta : ENNReal := (dyadicMultiplicativeScale j : ENNReal)
  have hdelta0 : delta ≠ 0 := by
    dsimp only [delta]
    exact ENNReal.coe_ne_zero.mpr (dyadicMultiplicativeScale_pos j).ne'
  have hdeltatop : delta ≠ ∞ := by
    dsimp only [delta]
    exact ENNReal.coe_ne_top
  have hsingle : H j * delta ^ (-epsilon) ≤ Khead := by
    dsimp only [Khead]
    exact Finset.single_le_sum (s := Finset.range J)
      (f := fun i => H i * (dyadicMultiplicativeScale i : ENNReal) ^ (-epsilon))
      (fun _ _ => bot_le) (Finset.mem_range.mpr hj)
  have hcancel : delta ^ (-epsilon) * delta ^ epsilon = 1 := by
    calc
      delta ^ (-epsilon) * delta ^ epsilon = delta ^ ((-epsilon) + epsilon) :=
        (ENNReal.rpow_add (-epsilon) epsilon hdelta0 hdeltatop).symm
      _ = 1 := by
        rw [show (-epsilon) + epsilon = 0 by ring, ENNReal.rpow_zero]
  have hbase : (1 : ENNReal) ≤ ENNReal.ofReal ((j : Real) + 1) := by
    rw [← ENNReal.ofReal_one]
    apply ENNReal.ofReal_le_ofReal
    have hj0 : (0 : Real) ≤ (j : Real) := by positivity
    linarith
  have hpoly : (1 : ENNReal) ≤
      (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) := by
    rw [← ENNReal.rpow_zero]
    exact ENNReal.rpow_le_rpow_of_exponent_le hbase (by linarith)
  have hKpoly : Khead ≤
      Khead * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) := by
    calc
      Khead = Khead * 1 := (mul_one _).symm
      _ ≤ Khead * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) :=
        by simpa only [mul_comm] using mul_le_mul_left hpoly Khead
  calc
    H j = (H j * delta ^ (-epsilon)) * delta ^ epsilon := by
      rw [mul_assoc, hcancel, mul_one]
    _ ≤ Khead * delta ^ epsilon := by
      simpa only [mul_comm] using mul_le_mul_right hsingle (delta ^ epsilon)
    _ ≤ (Khead * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1)) *
        delta ^ epsilon := by
          simpa only [mul_comm, mul_left_comm] using
            mul_le_mul_right hKpoly (delta ^ epsilon)
    _ = Khead * (ENNReal.ofReal ((j : Real) + 1)) ^ (2 * p - 1) *
        (dyadicMultiplicativeScale j : ENNReal) ^ epsilon := by
          rfl

set_option maxHeartbeats 2000000 in
/-- The strict cap estimate for one central thin-radial piece, with the
entropy and square-coefficient constants made uniform before the physical
shell is chosen.  The entropy exponent may be shrunk; this only enlarges
the right side of the entropy estimate. -/
private theorem exists_strictNegative_cap_piece_raw_rate
    {n : Nat} (hn : 1 ≤ n) (E : Set Real) {p alpha epsilon epsilon0 : Real}
    (hp : 1 < p) (hp2 : p < 2) (halpha : alpha < 0)
    (hepsilon : 0 < epsilon) (hepsilon_le : epsilon ≤ epsilon0)
    (j0 : Nat)
    (hentropy : ∀ j ≥ j0, ∀ R : Real, 0 < R → ∀ (s : Real) (mu : Int),
      0 < s → s ≤ 1 / 16 →
      (dyadicMultiplicativeScale j : Real) ≤ 16 * s →
      ((normalizedRadiusBlock E R) ∩ thinRadiusWindow s mu).Nonempty →
      ∃ N : Nat,
        multiplicativeEntropy ((normalizedRadiusBlock E R) ∩ thinRadiusWindow s mu)
            (dyadicMultiplicativeScale j) ≤ N ∧
        (N : ENNReal) ≤
          (ENNReal.ofReal (16 * s)) ^ ((n : Real) * (p - 2) - alpha) *
          ((dyadicMultiplicativeScale j : ENNReal)⁻¹) ^
            ((n : Real) * (p - 1) - epsilon0))
    (C0 C1 : Real) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (n + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((n : Real) / 2))
    (hderiv : ∀ xi : Euclidean (n + 1), ∀ u : Real, 1 ≤ ‖xi‖ →
      u ∈ Icc (1 : Real) 2 →
      ‖deriv (fun z : Real => surfaceFourier (n + 1) (z • xi)) u‖ ≤
        C1 / ‖xi‖ ^ ((n : Real) / 2 - 1))
    (phi : SchwartzMap (Euclidean (n + 1)) Complex)
    (hphiOne : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphiZero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphiNorm : ∀ xi, ‖phi xi‖ ≤ 1) :
    ∃ Cap : ENNReal, Cap ≠ ∞ ∧
      ∀ (j k : Nat) (R : Real) (f : SchwartzMap (Euclidean (n + 1)) Complex)
        (s : Real) (mu : Int) (m : Nat),
        4 ≤ j → 4 ≤ k → k + 1 ≤ j → j0 ≤ j + 4 → 0 < R →
        (hs : 0 < s) → s = ((2 : Real) ^ k)⁻¹ →
        ((normalizedRadiusBlock E R) ∩ thinRadiusWindow s mu).Nonempty →
        m ∈ (Finset.Icc 2 (2 ^ (k + 3))).filter
          (fun m : Nat => (m : Int) ∈ Finset.Icc (mu - 7) (mu + 7)) →
        (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2),
          (restrictedRelativeBandpassSphericalMaximal (n + 1)
            ((normalizedRadiusBlock E R) ∩ thinRadiusWindow s mu) phi j
            (SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs m)) x) ^ p ∂
            powerWeightedVolume (n + 1) alpha) ≤
          Cap * (dyadicMultiplicativeScale j : ENNReal) ^ epsilon *
            ∫⁻ x : Euclidean (n + 1),
              (ENNReal.ofReal
                ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
                  (thinRadialPartition (n + 1) s hs m)) x‖) ^ p ∂
                powerWeightedVolume (n + 1) alpha := by
  obtain ⟨C, hC, hcap⟩ :=
    exists_thinRadialPartition_strictNegativeCap_shell_lintegral_rpow_le
      hn C0 C1 hC0 hC1 hdecay hderiv phi hphiOne hphiZero hphiNorm
  let rho : Real := (n : Real) * (p - 2) - alpha
  let sigma : Real := (n : Real) * (p - 1) - epsilon
  let D : Real :=
    12 * C0 *
      ‖((SchwartzMap.fderivCLM Complex (Euclidean (n + 1)) Complex) phi).toBoundedContinuousFunction‖
  let K0 : ENNReal := ENNReal.ofReal
    (2 * (4 * C0) ^ (2 : Nat) + 2 * (2 * (8 * C1 + D)) ^ (2 : Nat))
  let Kraw : ENNReal := K0 * (16 : ENNReal) ^ n
  let Kent : ENNReal := (ENNReal.ofReal (16 : Real)) ^ rho
  let kappa2 : ENNReal :=
    ENNReal.ofReal ((1 : Real) / 4) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (2 - p))⁻¹
  let kappa1 : ENNReal :=
    (ENNReal.ofReal (p - 1))⁻¹ + (ENNReal.ofReal (3 - p))⁻¹
  let T : ENNReal :=
    (2 + (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3)))⁻¹) *
      relativeMovingBandCapTailEnvelope n C
  let Cap : ENNReal :=
    ENNReal.ofReal p * (4 * kappa2 + 2 * kappa1) *
      ((1 + T) ^ (2 - p) * (1 + Kraw) ^ (p - 1) * Kent) *
        (ENNReal.ofReal (4 * (8 : Real))) ^ (-alpha)
  have hK0top : K0 ≠ ∞ := by
    dsimp only [K0]
    exact ENNReal.ofReal_ne_top
  have hKrawtop : Kraw ≠ ∞ := by
    dsimp only [Kraw]
    apply ENNReal.mul_ne_top hK0top
    exact ENNReal.pow_ne_top ENNReal.coe_ne_top
  have hKenttop : Kent ≠ ∞ := by
    dsimp only [Kent]
    exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  have hTtop : T ≠ ∞ := by
    dsimp only [T]
    apply ENNReal.mul_ne_top
    · apply ENNReal.add_ne_top.mpr
      constructor
      · norm_num
      · apply ENNReal.inv_ne_top.mpr
        exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
    · exact relativeMovingBandCapTailEnvelope_ne_top n C
  have hkappa2top : kappa2 ≠ ∞ := by
    dsimp only [kappa2]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
      apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (lt_trans zero_lt_one hp)
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp2)
  have hkappa1top : kappa1 ≠ ∞ := by
    dsimp only [kappa1]
    apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp)
    · apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr (by linarith)
  have hcoretop :
      (1 + T) ^ (2 - p) * (1 + Kraw) ^ (p - 1) * Kent ≠ ∞ := by
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · apply ENNReal.rpow_ne_top_of_nonneg
        · linarith
        · exact ENNReal.add_ne_top.mpr ⟨by norm_num, hTtop⟩
      · apply ENNReal.rpow_ne_top_of_nonneg
        · linarith
        · exact ENNReal.add_ne_top.mpr ⟨by norm_num, hKrawtop⟩
    · exact hKenttop
  have hweighttop : (ENNReal.ofReal (4 * (8 : Real))) ^ (-alpha) ≠ ∞ := by
    apply ENNReal.rpow_ne_top_of_ne_zero
    · norm_num
    · exact ENNReal.ofReal_ne_top
  have hCaptop : Cap ≠ ∞ := by
    dsimp only [Cap]
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
        apply ENNReal.add_ne_top.mpr
        constructor
        · exact ENNReal.mul_ne_top (by norm_num) hkappa2top
        · exact ENNReal.mul_ne_top (by norm_num) hkappa1top
      · exact hcoretop
    · exact hweighttop
  refine ⟨Cap, hCaptop, ?_⟩
  intro j k R f s mu m hj hk hjk hj0 hR hs hscale hne hm
  let F : Set Real := normalizedRadiusBlock E R
  let delta : NNReal := dyadicMultiplicativeScale (j + 4)
  let g : SchwartzMap (Euclidean (n + 1)) Complex :=
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition (n + 1) s hs m)
  let B : Set (Euclidean (n + 1)) :=
    euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let I : ENNReal := ∫⁻ x : Euclidean (n + 1),
    (ENNReal.ofReal ‖g x‖) ^ p ∂powerWeightedVolume (n + 1) alpha
  have hFsub : F ⊆ Icc (1 : Real) 2 := by
    dsimp only [F]
    exact normalizedRadiusBlock_subset_Icc_one_two hR
  have hsmall : s ≤ 1 / 16 := shell_scale_le_one_sixteenth hk s hscale
  have hsquarter : 4 * s ≤ 1 := by linarith
  have hdelta_shell : (delta : Real) ≤ 16 * s := by
    dsimp only [delta]
    simpa only [hscale] using
      dyadicMultiplicativeScale_shift_four_le_shell_scale hjk
  obtain ⟨N, hN, hNrate⟩ :=
    hentropy (j + 4) hj0 R hR s mu hs hsmall hdelta_shell (by
      simpa only [F] using hne)
  have hsigma0 : (n : Real) * (p - 1) - epsilon0 ≤ sigma := by
    dsimp only [sigma]
    linarith
  have hinvone : 1 ≤ (delta : ENNReal)⁻¹ := by
    apply ENNReal.one_le_inv.mpr
    dsimp only [delta]
    exact_mod_cast dyadicMultiplicativeScale_le_one (j + 4)
  have hinvpow : ((delta : ENNReal)⁻¹) ^
      ((n : Real) * (p - 1) - epsilon0) ≤
        ((delta : ENNReal)⁻¹) ^ sigma :=
    ENNReal.rpow_le_rpow_of_exponent_le hinvone hsigma0
  have hNbound : (N : ENNReal) ≤
      Kent * (ENNReal.ofReal s) ^ rho * ((delta : ENNReal)⁻¹) ^ sigma := by
    calc
      (N : ENNReal) ≤
          (ENNReal.ofReal (16 * s)) ^ rho * ((delta : ENNReal)⁻¹) ^
            ((n : Real) * (p - 1) - epsilon0) := by
              simpa only [delta, rho] using hNrate
      _ = Kent * (ENNReal.ofReal s) ^ rho * ((delta : ENNReal)⁻¹) ^
            ((n : Real) * (p - 1) - epsilon0) := by
              rw [ennreal_ofReal_sixteen_mul_rpow hs]
      _ ≤ Kent * (ENNReal.ofReal s) ^ rho * ((delta : ENNReal)⁻¹) ^ sigma := by
              gcongr
  have hmshort := Finset.mem_filter.mp hm
  have hmshortIcc : 2 ≤ m ∧ m ≤ 2 ^ (k + 3) := Finset.mem_Icc.mp hmshort.1
  have hpowwide : 2 ^ (k + 3) ≤ 2 ^ (k + 4) := by
    exact pow_le_pow_right' (by omega : 1 ≤ (2 : Nat)) (by omega)
  have hmwide : m ∈ (Finset.Icc (1 : Nat) (2 ^ (k + 4))).filter
      (fun m : Nat => (m : Int) ∈ Finset.Icc (mu - 7) (mu + 7)) := by
    apply Finset.mem_filter.mpr
    constructor
    · exact Finset.mem_Icc.mpr ⟨by omega, hmshortIcc.2.trans hpowwide⟩
    · exact hmshort.2
  have hmseparated : m ∈ Finset.Icc 2 (2 ^ (k + 4)) :=
    Finset.mem_Icc.mpr ⟨hmshortIcc.1, hmshortIcc.2.trans hpowwide⟩
  have hsep : s < s * ((m : Real) - 1 / 4) :=
    thinRadialBufferedPartition_piece_separated s hscale hmseparated
  have hmpos : 0 < s * ((m : Real) - 1 / 4) := lt_trans hs hsep
  have hb : s * ((m : Real) + 5 / 4) ≤ 8 := by
    exact thinRadialBufferedPartition_central_upper_le_eight hk s hscale F hFsub mu
      (by simpa only [F] using hne) hmwide
  have hD : 0 ≤ D := by
    dsimp only [D]
    positivity
  have hraw0 := ofReal_thinRadialCapEntropySquare_le_dyadicDecay
    (n := n) j C0 (2 * C1) D (delta : Real) hC0.le (by positivity) hD (by positivity)
      (by simpa only [delta] using dyadicMultiplicativeScale_shift_four_short j)
  have hraw : ENNReal.ofReal
      (2 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2)) ^ (2 : Nat) +
        2 * (8 * Real.log 2 * (delta : Real)) ^ (2 : Nat) *
          (2 * ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2 - 1) +
            D / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2))) ^ (2 : Nat)) ≤
        Kraw * (delta : ENNReal) ^ n := by
    calc
      ENNReal.ofReal
          (2 * ((4 * C0) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2)) ^ (2 : Nat) +
            2 * (8 * Real.log 2 * (delta : Real)) ^ (2 : Nat) *
              (2 * ((8 * C1) / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2 - 1) +
                D / (Auto.Spherical.SurfaceMeasureDecay.dyadicScale j) ^ ((n : Real) / 2))) ^ (2 : Nat)) ≤
          K0 * (dyadicMultiplicativeScale j : ENNReal) ^ n := by
            dsimp only [K0]
            convert hraw0 using 1 <;> ring
      _ = Kraw * (delta : ENNReal) ^ n := by
            dsimp only [Kraw, delta]
            rw [dyadicMultiplicativeScale_shift_four_nat_factor]
            ring
  have hrho : rho + (n : Real) * (2 - p) = -alpha := by
    dsimp only [rho]
    ring
  have hsigma : (n : Real) * (p - 1) - sigma = epsilon := by
    dsimp only [sigma]
    ring
  have hcapmoment := hcap j f F delta N (s := s) (alpha := alpha) (p := p)
    m mu (epsilon := epsilon) (rho := rho) (sigma := sigma) (K := Kent)
      (Kraw := Kraw) (bUpper := 8)
      hj (by simpa only [F] using hne) hFsub (by simpa only [F, delta] using hN)
      (by
        dsimp only [delta]
        exact dyadicMultiplicativeScale_pos (j + 4))
      (by
        dsimp only [delta]
        exact dyadicMultiplicativeScale_shift_four_log_two_le_one j)
      (by
        dsimp only [delta]
        exact dyadicMultiplicativeScale_shift_four_short j)
      hs hsquarter halpha hmpos hsep hp hp2 hepsilon hrho hsigma hb hKrawtop
      (by simpa only [D] using hraw) (by simpa only [delta] using hNbound)
  have hrawEq := restrictedRelativeBandpass_lintegral_rpow_eq_lintegral_toReal_rpow
    (show 0 < n + 1 by omega) (E := F ∩ thinRadiusWindow s mu)
      (by intro r hr; exact hFsub hr.1) phi j g (by linarith : 0 ≤ p) B
      (powerWeightedVolume (n + 1) alpha)
  calc
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2),
      (restrictedRelativeBandpassSphericalMaximal (n + 1)
        ((normalizedRadiusBlock E R) ∩ thinRadiusWindow s mu) phi j
        (SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
          (thinRadialPartition (n + 1) s hs m)) x) ^ p ∂
          powerWeightedVolume (n + 1) alpha) =
        ∫⁻ x in B,
          ENNReal.ofReal
            ((restrictedRelativeBandpassSphericalMaximal (n + 1)
              (F ∩ thinRadiusWindow s mu) phi j g x).toReal ^ p)
              ∂powerWeightedVolume (n + 1) alpha := by
            simpa only [F, g, B] using hrawEq
    _ ≤ Cap * (delta : ENNReal) ^ epsilon * I := by
          simpa only [Cap, T, kappa1, kappa2, Kraw, Kent, I, g, B, mul_assoc] using
            hcapmoment
    _ ≤ Cap * (dyadicMultiplicativeScale j : ENNReal) ^ epsilon * I := by
          have hshift := dyadicMultiplicativeScale_shift_four_rpow_le j hepsilon.le
          calc
            Cap * (delta : ENNReal) ^ epsilon * I =
                ((delta : ENNReal) ^ epsilon * Cap) * I := by ac_rfl
            _ ≤ ((dyadicMultiplicativeScale j : ENNReal) ^ epsilon * Cap) * I :=
              mul_le_mul_left (mul_le_mul_left hshift Cap) I
            _ = Cap * (dyadicMultiplicativeScale j : ENNReal) ^ epsilon * I := by ac_rfl
