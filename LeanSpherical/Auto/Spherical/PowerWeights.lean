/-- On an input annulus, the unweighted integral is controlled by a
nonnegative power-weighted integral using the inner radius. -/
theorem lintegral_volume_le_innerPower_inv_mul_powerWeightedVolume_of_annular_support_nonneg
    {d : Nat} {α r R : ℝ} (hα : 0 ≤ α) (hr : 0 < r)
    (G : Euclidean d → ENNReal) (hG : Measurable G)
    (hGsupport : ∀ x, x ∉ euclideanAnnulus d r R → G x = 0) :
    (∫⁻ x, G x ∂volume) ≤
      ((ENNReal.ofReal r) ^ α)⁻¹ *
        ∫⁻ x, G x ∂powerWeightedVolume d α := by
  let A : Set (Euclidean d) := euclideanAnnulus d r R
  let w : ENNReal := (ENNReal.ofReal r) ^ α
  have hA : MeasurableSet A := measurableSet_closedBall.diff measurableSet_ball
  have hindicator : A.indicator G = G := by
    funext x
    by_cases hx : x ∈ A
    · simp [hx]
    · simp [hx, hGsupport x hx]
  have hwpos : 0 < w := by
    dsimp only [w]
    exact ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr hr) ENNReal.ofReal_ne_top
  have hw0 : w ≠ 0 := hwpos.ne'
  have hwtop : w ≠ ∞ := by
    dsimp only [w]
    exact ENNReal.rpow_ne_top_of_ne_zero
      (ENNReal.ofReal_ne_zero_iff.mpr hr) ENNReal.ofReal_ne_top
  have hweight : w * (∫⁻ x, G x ∂volume) ≤
      ∫⁻ x, G x ∂powerWeightedVolume d α := by
    calc
      w * (∫⁻ x, G x ∂volume) =
          w * (∫⁻ x in A, G x ∂volume) := by
        congr 1
        calc
          (∫⁻ x, G x ∂volume) = ∫⁻ x, A.indicator G x ∂volume := by
            rw [hindicator]
          _ = ∫⁻ x in A, G x ∂volume := lintegral_indicator hA G
      _ ≤ ∫⁻ x in A, G x ∂powerWeightedVolume d α := by
        dsimp only [w, A]
        exact setLIntegral_le_powerWeightedVolume_euclideanAnnulus_nonneg
          hα hr G hG
      _ = ∫⁻ x, G x ∂powerWeightedVolume d α := by
        calc
          (∫⁻ x in A, G x ∂powerWeightedVolume d α) =
              ∫⁻ x, A.indicator G x ∂powerWeightedVolume d α :=
            (lintegral_indicator hA G).symm
          _ = ∫⁻ x, G x ∂powerWeightedVolume d α := by rw [hindicator]
  calc
    (∫⁻ x, G x ∂volume) =
        w⁻¹ * (w * ∫⁻ x, G x ∂volume) := by
      rw [← mul_assoc, ENNReal.inv_mul_cancel hw0 hwtop, one_mul]
    _ ≤ w⁻¹ * (∫⁻ x, G x ∂powerWeightedVolume d α) :=
      mul_le_mul_right hweight _
    _ = ((ENNReal.ofReal r) ^ α)⁻¹ *
        ∫⁻ x, G x ∂powerWeightedVolume d α := by rfl

/-- Transfer a global unweighted square estimate to a cap shell in a
nonnegative power weight.  The output and input comparisons use the outer
and inner shell radii respectively. -/
theorem restrictedRelativeBandpass_cap_shell_lintegral_two_le_of_global_nonneg
    (n j : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1)
    (E : Set ℝ) (hE : E ⊆ Icc (1 : ℝ) 2) (hEne : E.Nonempty)
    (L : ENNReal)
    (hglobal : ∀ g : SchwartzMap (Euclidean (n + 1)) ℂ,
      (∫⁻ x : Euclidean (n + 1), ENNReal.ofReal
        ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j g x).toReal ^
          (2 : ℕ)) ∂volume) ≤
        L * ∫⁻ x : Euclidean (n + 1), ENNReal.ofReal (‖g x‖ ^ (2 : ℕ)) ∂volume)
    {s a b α : ℝ} (hs : 0 < s) (hα : 0 ≤ α) (ha : 0 < a)
    (f : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hfsupport : ∀ y, y ∉ euclideanAnnulus (n + 1) a b → f y = 0) :
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^
        (2 : ℕ)) ∂powerWeightedVolume (n + 1) α) ≤
      (ENNReal.ofReal (s / 2)) ^ α * L * ((ENNReal.ofReal a) ^ α)⁻¹ *
        ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))
          ∂powerWeightedVolume (n + 1) α := by
  let A : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) (s / 4) (s / 2)
  let B : Set (Euclidean (n + 1)) := euclideanAnnulus (n + 1) a b
  let ν : Measure (Euclidean (n + 1)) := powerWeightedVolume (n + 1) α
  let M : Euclidean (n + 1) → ENNReal :=
    restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f
  let G : Euclidean (n + 1) → ENNReal := fun x => ENNReal.ofReal ((M x).toReal ^
    (2 : ℕ))
  let I : ENNReal := ∫⁻ y : Euclidean (n + 1),
    ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) ∂volume
  let J : ENNReal := ∫⁻ y : Euclidean (n + 1),
    ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) ∂ν
  have hMreal : Measurable (fun x : Euclidean (n + 1) => (M x).toReal) := by
    dsimp only [M]
    exact measurable_toReal_restrictedRelativeBandpassSphericalMaximal
      phi f hphi_one hphi_zero hphi_norm j E hE hEne
  have hGmeas : Measurable G := (hMreal.pow_const 2).ennreal_ofReal
  have hunweighted : (∫⁻ x in A, G x ∂volume) ≤ L * I := by
    calc
      (∫⁻ x in A, G x ∂volume) ≤ ∫⁻ x : Euclidean (n + 1), G x ∂volume :=
        lintegral_mono' Measure.restrict_le_self le_rfl
      _ ≤ L * I := by
        simpa only [G, M, I] using hglobal f
  have hGinput_meas : Measurable (fun y : Euclidean (n + 1) =>
      ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))) :=
    (f.continuous.norm.pow 2).measurable.ennreal_ofReal
  have hGinput_support : ∀ y : Euclidean (n + 1), y ∉ B →
      ENNReal.ofReal (‖f y‖ ^ (2 : ℕ)) = 0 := by
    intro y hy
    simp [hfsupport y hy]
  have hinput : I ≤ ((ENNReal.ofReal a) ^ α)⁻¹ * J := by
    dsimp only [I, J, ν, B]
    exact lintegral_volume_le_innerPower_inv_mul_powerWeightedVolume_of_annular_support_nonneg
      hα ha _ hGinput_meas hGinput_support
  calc
    (∫⁻ x in euclideanAnnulus (n + 1) (s / 4) (s / 2), ENNReal.ofReal
      ((restrictedRelativeBandpassSphericalMaximal (n + 1) E phi j f x).toReal ^
        (2 : ℕ)) ∂powerWeightedVolume (n + 1) α) =
        ∫⁻ x in A, G x ∂ν := by rfl
    _ ≤ (ENNReal.ofReal (s / 2)) ^ α * (∫⁻ x in A, G x ∂volume) := by
      exact setLIntegral_powerWeightedVolume_euclideanAnnulus_le_nonneg hα G hGmeas
    _ ≤ (ENNReal.ofReal (s / 2)) ^ α * (L * I) :=
      mul_le_mul_right hunweighted _
    _ ≤ (ENNReal.ofReal (s / 2)) ^ α *
        (L * (((ENNReal.ofReal a) ^ α)⁻¹ * J)) := by
      exact mul_le_mul_right (mul_le_mul_right hinput L) _
    _ = (ENNReal.ofReal (s / 2)) ^ α * L * ((ENNReal.ofReal a) ^ α)⁻¹ * J := by
      ring
    _ = (ENNReal.ofReal (s / 2)) ^ α * L * ((ENNReal.ofReal a) ^ α)⁻¹ *
        ∫⁻ y, ENNReal.ofReal (‖f y‖ ^ (2 : ℕ))
          ∂powerWeightedVolume (n + 1) α := by rfl

/-- The short-interval cap endpoint transferred to a nonnegative
power-weighted output shell and exterior input annulus. -/
theorem exists_restrictedRelativeBandpass_interval_cap_shell_lintegral_one_le_nonneg
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) ℂ)
    (hphi_one : ∀ ξ, ‖ξ‖ ≤ 1 → phi ξ = 1)
    (hphi_zero : ∀ ξ, 2 ≤ ‖ξ‖ → phi ξ = 0)
    (hphi_norm : ∀ ξ, ‖phi ξ‖ ≤ 1) :
    ∃ C : ℝ, 0 < C ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean (n + 1)) ℂ)
      (E : Set ℝ) {u v s a b α : ℝ}, 4 ≤ j → E.Nonempty → E ⊆ Icc u v →
      u ≤ v → 1 ≤ u → v ≤ 2 → 0 < s → 4 * s ≤ u →
      v - u ≤ ((2 : ℝ) ^ j)⁻¹ → 0 ≤ α → 0 < a → a ≤ b → s < a →
