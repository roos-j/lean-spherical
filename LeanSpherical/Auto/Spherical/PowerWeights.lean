  simp only [SchwartzMap.coe_zero, hfourier, Pi.zero_apply, mul_zero,
    hinvzero, norm_zero, ENNReal.ofReal_zero]
  simp

/- One buffered thin radial product gains the `s^(p-1)` factor coming from
the volume of its physical support.  The lower end of a thin partition piece
need not itself lie outside `1 / 4`: the actual annular support of `f` clips
that endpoint.  This is the input-side estimate needed when the individual
off-window errors are summed by discrete convolution. -/
theorem thinRadialPartition_piece_lintegral_enorm_rpow_le_weighted_of_outer_bound
    {d : Nat} (hd : 0 < d) {p α s : Real} (hp : 1 < p) (hα : α ≤ 0)
    (hs : 0 < s) (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ y : Euclidean d, y ∉ euclideanAnnulus d (1 / 4) 8 → f y = 0)
    (m : Nat) (hm : 0 < s * ((m : Real) - 1 / 4)) :
    (∫⁻ y : Euclidean d,
      ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
        (thinRadialPartition d s hs m)) y‖ₑ) ^ p ≤
      ((ENNReal.ofReal (surfaceMass d) *
          (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
          ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
        ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
          ∫⁻ y : Euclidean d,
            ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition d s hs m)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
  let a : Real := s * ((m : Real) - 1 / 4)
  let b : Real := s * ((m : Real) + 5 / 4)
  let a' : Real := min 8 (max (1 / 4) a)
  let b' : Real := min 8 (max (1 / 4) b)
  let g : SchwartzMap (Euclidean d) Complex :=
    SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
      (thinRadialPartition d s hs m)
  have ha : 0 < a := by
    dsimp only [a]
    exact hm
  have hab : a ≤ b := by
    dsimp only [a, b]
    nlinarith
  have ha' : 0 < a' := by
    dsimp only [a']
    apply lt_min
    · norm_num
    · exact lt_of_lt_of_le (by norm_num) (le_max_left _ _)
  have ha'b' : a' ≤ b' := by
    dsimp only [a', b']
    exact min_le_min_left _ (max_le_max le_rfl hab)
  have hb'pos : 0 < b' := lt_of_lt_of_le ha' ha'b'
  have hb'outer : b' ≤ 8 := by
    dsimp only [b']
    exact min_le_left _ _
  have hgsupport : ∀ y : Euclidean d, y ∉ euclideanAnnulus d a' b' → g y = 0 := by
    intro y hy
    by_contra hgy
    have hfy : f y ≠ 0 := by
      intro hfy
      apply hgy
      dsimp only [g]
      rw [SchwartzMap.pairing_apply_apply, hfy]
      simp
    have hyf : y ∈ euclideanAnnulus d (1 / 4) 8 := by
      by_contra hyf
      exact hfy (hfsupport y hyf)
    have hypiece : y ∈ euclideanAnnulus d a b := by
      by_contra hypiece
      exact hgy (thinRadialPartition_piece_support_annulus hs f m ha y hypiece)
    have hyf_lower : 1 / 4 ≤ ‖y‖ := by
      exact le_of_not_gt (by
        simpa only [euclideanAnnulus, Metric.mem_ball, dist_zero_right] using hyf.2)
    have hypiece_lower : a ≤ ‖y‖ := by
      exact le_of_not_gt (by
        simpa only [euclideanAnnulus, Metric.mem_ball, dist_zero_right] using hypiece.2)
    have hypiece_upper : ‖y‖ ≤ b := by
      simpa only [euclideanAnnulus, Metric.mem_closedBall, dist_zero_right] using hypiece.1
    have hyf_upper : ‖y‖ ≤ 8 := by
      simpa only [euclideanAnnulus, Metric.mem_closedBall, dist_zero_right] using hyf.1
    have hclipped_lower : a' ≤ ‖y‖ := by
      dsimp only [a']
      exact (min_le_right _ _).trans (max_le hyf_lower hypiece_lower)
    have hclipped_upper : ‖y‖ ≤ b' := by
      dsimp only [b']
      exact le_min hyf_upper (hypiece_upper.trans (le_max_right _ _))
    apply hy
    unfold euclideanAnnulus
    constructor
    · simpa only [Metric.mem_closedBall, dist_zero_right] using hclipped_upper
    · simpa only [Metric.mem_ball, dist_zero_right] using
        not_lt_of_ge hclipped_lower
  have hbase :=
    lintegral_enorm_rpow_le_annulus_volume_mul_powerWeighted_of_annular_support
      hp hα ha' ha'b' g hgsupport
  have hwidth : b' - a' ≤ (3 / 2 : Real) * s := by
    by_cases hbelow : b < 1 / 4
    · have hbsmall : b < 1 / 4 := hbelow
      have hasmall : a < 1 / 4 := lt_of_le_of_lt hab hbsmall
      have ha'eq : a' = 1 / 4 := by
        dsimp only [a']
        rw [max_eq_left hasmall.le, min_eq_right]
        norm_num
      have hb'eq : b' = 1 / 4 := by
        dsimp only [b']
        rw [max_eq_left hbsmall.le, min_eq_right]
        norm_num
      rw [ha'eq, hb'eq]
      nlinarith
    · have hbquarter : 1 / 4 ≤ b := le_of_not_gt hbelow
      by_cases hhigh : 8 < a
      · have haeight : 8 ≤ a := hhigh.le
        have hbeight : 8 ≤ b := haeight.trans hab
        have ha'eq : a' = 8 := by
          dsimp only [a']
          rw [min_eq_left]
          exact haeight.trans (le_max_right _ _)
        have hb'eq : b' = 8 := by
          dsimp only [b']
          rw [min_eq_left]
          exact hbeight.trans (le_max_right _ _)
        rw [ha'eq, hb'eq]
        nlinarith
      · have haeight : a ≤ 8 := le_of_not_gt hhigh
        have hmaxa : max (1 / 4) a ≤ 8 := by
          exact max_le (by norm_num) haeight
        have ha'eq : a' = max (1 / 4) a := by
          dsimp only [a']
          exact min_eq_right hmaxa
        have hmaxb : max (1 / 4) b = b := max_eq_right hbquarter
        have hb'le : b' ≤ b := by
          dsimp only [b']
          rw [hmaxb]
          exact min_le_right _ _
        have hale : a ≤ a' := by
          rw [ha'eq]
          exact le_max_right _ _
        calc
          b' - a' ≤ b - a := sub_le_sub hb'le hale
          _ = (3 / 2 : Real) * s := by
            dsimp only [a, b]
            ring
  have hvolume : volume (euclideanAnnulus d a' b') ≤
      ENNReal.ofReal (surfaceMass d) *
        (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
          ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s := by
    have hraw := volume_euclideanAnnulus_le_linear (r := a') (R := b') hd ha'
    calc
      volume (euclideanAnnulus d a' b') ≤
          ENNReal.ofReal (surfaceMass d) *
            (ENNReal.ofReal b') ^ (d - 1) * ENNReal.ofReal (b' - a') := hraw
      _ ≤ ENNReal.ofReal (surfaceMass d) *
            (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
              ENNReal.ofReal ((3 / 2 : Real) * s) := by
            gcongr
      _ = ENNReal.ofReal (surfaceMass d) *
            (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
              ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s := by
            rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 3 / 2)]
            ring
  have hpminus : 0 ≤ p - 1 := by linarith
  have hvolpow := ENNReal.rpow_le_rpow hvolume hpminus
  have hweight : ((ENNReal.ofReal b') ^ α)⁻¹ ≤
      ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ := by
    apply ENNReal.inv_le_inv.mpr
    exact ennreal_ofReal_rpow_antitone_thinRadialTail hα hb'pos hb'outer
  change (∫⁻ y : Euclidean d, ‖g y‖ₑ) ^ p ≤ _
  calc
    (∫⁻ y : Euclidean d, ‖g y‖ₑ) ^ p ≤
        (volume (euclideanAnnulus d a' b')) ^ (p - 1) *
          ((ENNReal.ofReal b') ^ α)⁻¹ *
            ∫⁻ y : Euclidean d, ‖g y‖ₑ ^ p ∂powerWeightedVolume d α := hbase
    _ ≤ ((ENNReal.ofReal (surfaceMass d) *
          (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
          ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
        ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
          ∫⁻ y : Euclidean d, ‖g y‖ₑ ^ p ∂powerWeightedVolume d α := by
      gcongr

/-- Summing one dyadic separation block of literal thin radial tails keeps
the thin-annulus factor in the input moment.  The two cardinality hypotheses
are the only discrete information used here; the distance-block geometry
will supply them for the moving parameter windows. -/
theorem finset_scaled_thinRadialPartition_tail_mass_rpow_le
    {d : Nat} (hd : 0 < d) {p α s : Real} (hp : 1 < p) (hα : α ≤ 0)
    (hs : 0 < s) (f : SchwartzMap (Euclidean d) Complex)
    (hfsupport : ∀ y : Euclidean d, y ∉ euclideanAnnulus d (1 / 4) 8 → f y = 0)
    (M : Finset Nat) {ι : Type*} [DecidableEq ι]
    (U : Finset ι) (S : ι → Finset Nat) (Q : ENNReal) (L : Nat)
    (hL : 0 < L)
    (hrow : ∀ i ∈ U, (S i).card ≤ L)
    (hcol : ∀ r ∈ M, (U.filter fun i => r ∈ S i).card ≤ L)
    (hsub : ∀ i ∈ U, S i ⊆ M)
    (hpositive : ∀ r ∈ M, 0 < s * ((r : Real) - 1 / 4)) :
    (∑ i ∈ U, (Q * ∑ r ∈ S i,
      ∫⁻ y : Euclidean d,
        ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
          (thinRadialPartition d s hs r)) y‖ₑ) ^ p) ≤
      Q ^ p * (L : ENNReal) ^ p *
        ((ENNReal.ofReal (surfaceMass d) *
            (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
            ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
          ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
            ((ENNReal.ofReal 2) ^ p * 2) *
              ∫⁻ y : Euclidean d, ‖f y‖ₑ ^ p ∂powerWeightedVolume d α := by
  let A : Nat → ENNReal := fun r =>
    ∫⁻ y : Euclidean d,
      ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
        (thinRadialPartition d s hs r)) y‖ₑ
  let T : ENNReal :=
    ((ENNReal.ofReal (surfaceMass d) *
        (ENNReal.ofReal (8 : Real)) ^ (d - 1) *
        ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
      ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹
  let I : ENNReal :=
    ∫⁻ y : Euclidean d, ‖f y‖ₑ ^ p ∂powerWeightedVolume d α
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  have hpiece (r : Nat) (hr : r ∈ M) :
      A r ^ p ≤ T *
        ∫⁻ y : Euclidean d,
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
    dsimp only [A, T]
    exact thinRadialPartition_piece_lintegral_enorm_rpow_le_weighted_of_outer_bound
      hd hp hα hs f hfsupport r (hpositive r hr)
  have hpieces :
      (∑ r ∈ M, A r ^ p) ≤ T * ∑ r ∈ M,
        ∫⁻ y : Euclidean d,
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
    calc
      (∑ r ∈ M, A r ^ p) ≤ ∑ r ∈ M, T *
          ∫⁻ y : Euclidean d,
            ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
            gcongr with r hr
            exact hpiece r hr
      _ = T * ∑ r ∈ M,
          ∫⁻ y : Euclidean d,
            ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
            rw [Finset.mul_sum]
  have hsum_meas (r : Nat) (hr : r ∈ M) :
      Measurable (fun y : Euclidean d =>
        ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
          (thinRadialPartition d s hs r)) y‖ₑ ^ p) :=
    ENNReal.continuous_rpow_const.measurable.comp
      (SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
        (thinRadialPartition d s hs r)).continuous.enorm.measurable
  have hsum_eq :
      (∑ r ∈ M, ∫⁻ y : Euclidean d,
        ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
          (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α) =
        ∫⁻ y : Euclidean d, ∑ r ∈ M,
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
    rw [lintegral_finsetSum]
    intro r hr
    exact hsum_meas r hr
  have hoverlap := lintegral_sum_enorm_rpow_thinRadialPartition_piece_le
    hs f M hpositive hp0 (powerWeightedVolume d α)
  have hinput :
      (∑ r ∈ M, A r ^ p) ≤ T * ((ENNReal.ofReal 2) ^ p * 2) * I := by
    calc
      (∑ r ∈ M, A r ^ p) ≤ T * ∑ r ∈ M,
          ∫⁻ y : Euclidean d,
            ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := hpieces
      _ = T * ∫⁻ y : Euclidean d, ∑ r ∈ M,
          ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition d s hs r)) y‖ₑ ^ p ∂powerWeightedVolume d α := by
            rw [hsum_eq]
      _ ≤ T * (((ENNReal.ofReal 2) ^ p * 2) * I) := by
            simpa only [mul_comm, I] using mul_le_mul_left hoverlap T
      _ = T * ((ENNReal.ofReal 2) ^ p * 2) * I := by ring
  have hconvolution :=
    finset_rpow_scaled_row_sum_le_of_card_bounds U M S A Q hp.le L hL hrow hcol hsub
  calc
    (∑ i ∈ U, (Q * ∑ r ∈ S i,
      ∫⁻ y : Euclidean d,
        ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
          (thinRadialPartition d s hs r)) y‖ₑ) ^ p) =
        ∑ i ∈ U, (Q * ∑ r ∈ S i, A r) ^ p := by rfl
    _ ≤
        Q ^ p * (L : ENNReal) ^ p * ∑ r ∈ M, A r ^ p := hconvolution
    _ ≤ Q ^ p * (L : ENNReal) ^ p *
        (T * ((ENNReal.ofReal 2) ^ p * 2) * I) := by
          gcongr
    _ = Q ^ p * (L : ENNReal) ^ p * T *
        ((ENNReal.ofReal 2) ^ p * 2) * I := by ring
    _ = _ := by
      dsimp only [T, I]
      ring

/-- The upper off-window tails in one actual dyadic distance block have a
summed weighted moment.  Unlike the older common-tail estimate, this keeps
the individual thin input masses through the finite row/column convolution. -/
theorem exists_upperDistanceBlock_tail_lintegral_rpow_sum_le
    (n : Nat) (phi : SchwartzMap (Euclidean (n + 1)) Complex) :
    ∃ C : Real, 0 < C ∧ ∀ (j k q : Nat)
      (f : SchwartzMap (Euclidean (n + 1)) Complex) (E : Set Real)
      (M : Finset Nat) (U : Finset Int) {s α p : Real}
      (a b : Int → Real) (B : Set (Euclidean (n + 1))),
      4 ≤ j → k + 1 ≤ j → 1 < p → α ≤ 0 → (hs : 0 < s) →
      (hscale : s = ((2 : Real) ^ k)⁻¹) →
      (∀ y : Euclidean (n + 1),
        y ∉ euclideanAnnulus (n + 1) (1 / 4) 8 → f y = 0) →
      (∀ r ∈ M, 0 < s * ((r : Real) - 1 / 4)) →
      (∀ mu ∈ U,
        (E ∩ thinRadiusWindow s mu) ⊆ Icc (a mu) (b mu) ∧
          a mu ≤ b mu ∧ 1 ≤ a mu ∧ b mu ≤ 2 ∧
          b mu - a mu ≤ 3 * s ∧ b mu ≤ s * ((mu : Real) + 2)) →
      MeasurableSet B → B ⊆ ball 0 s →
      (∑ mu ∈ U, ∫⁻ x in B,
        (restrictedRelativeBandpassSphericalMaximal (n + 1)
          (E ∩ thinRadiusWindow s mu) phi j
          (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
               (thinRadialPartition (n + 1) s hs r)) x) ^ p ∂
          powerWeightedVolume (n + 1) α) ≤
        powerWeightedVolume (n + 1) α B *
          (((j : ENNReal) *
              (ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^
                  thinRadialDistanceCutoff j k q) +
            ENNReal.ofReal (C * (2 : Real) ^ j) *
              (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) ^ p *
          ((2 ^ (q + 1) : Nat) : ENNReal) ^ p *
          ((ENNReal.ofReal (surfaceMass (n + 1)) *
              (ENNReal.ofReal (8 : Real)) ^ ((n + 1) - 1) *
              ENNReal.ofReal (3 / 2 : Real) * ENNReal.ofReal s) ^ (p - 1)) *
            ((ENNReal.ofReal (8 : Real)) ^ α)⁻¹ *
              ((ENNReal.ofReal 2) ^ p * 2) *
                 ∫⁻ y : Euclidean (n + 1), ‖f y‖ₑ ^ p ∂
                   powerWeightedVolume (n + 1) α) := by
  obtain ⟨C, hC, htail⟩ :=
    exists_restrictedRelativeBandpass_thinRadialPartition_tail_sum_le_of_lower_gaps n phi
  refine ⟨C, hC, ?_⟩
  intro j k q f E M U s α p a b B hj hk hp hα hs hscale hfsupport hMpositive hwindow hB hBball
  let ell : Nat := thinRadialDistanceCutoff j k q
  let Q : ENNReal :=
    (j : ENNReal) *
        (ENNReal.ofReal (C * (2 : Real) ^ j) *
          (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
      ENNReal.ofReal (C * (2 : Real) ^ j) *
        (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)
  let A : Nat → ENNReal := fun r =>
    ∫⁻ y : Euclidean (n + 1),
      ‖(SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
        (thinRadialPartition (n + 1) s hs r)) y‖ₑ
  have hpositive (r : Nat) (hr : r ∈ M) :
      0 < s * ((r : Real) - 1 / 4) := by
    exact hMpositive r hr
  have hpoint (mu : Int) (hmu : mu ∈ U) (x : Euclidean (n + 1))
      (hx : x ∈ B) :
      restrictedRelativeBandpassSphericalMaximal (n + 1)
        (E ∩ thinRadiusWindow s mu) phi j
        (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
          SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x ≤
        Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r := by
    obtain ⟨hEsub, hab, ha, hb, hwidth, hbwindow⟩ := hwindow mu hmu
    have hraw := htail j f (0 : SchwartzMap (Euclidean (n + 1)) Complex)
      (E ∩ thinRadiusWindow s mu) (a := a mu) (b := b mu) (s := s)
      (thinRadialUpperDistanceBlock M mu q) (fun _ => ell)
      hj hEsub hab ha hb hs
      (by
        intro r hr
        exact hpositive r (Finset.mem_filter.mp hr).1)
      (by
        intro r hr m hm hmell
        exact thinRadialUpperDistanceBlock_gap j k q hk hb hscale hs hwidth hbwindow
          hr m hm (by simpa only [ell] using hmell))
      x (hBball hx)
    calc
      restrictedRelativeBandpassSphericalMaximal (n + 1)
          (E ∩ thinRadiusWindow s mu) phi j
          (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x =
          restrictedRelativeBandpassSphericalMaximal (n + 1)
            (E ∩ thinRadiusWindow s mu) phi j
            ((0 : SchwartzMap (Euclidean (n + 1)) Complex) +
              ∑ r ∈ thinRadialUpperDistanceBlock M mu q,
                SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
                  (thinRadialPartition (n + 1) s hs r)) x := by rw [zero_add]
      _ ≤ restrictedRelativeBandpassSphericalMaximal (n + 1)
            (E ∩ thinRadiusWindow s mu) phi j
            (0 : SchwartzMap (Euclidean (n + 1)) Complex) x +
          ∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            ((j : ENNReal) *
                (ENNReal.ofReal (C * (2 : Real) ^ j) *
                  (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ ell) +
              ENNReal.ofReal (C * (2 : Real) ^ j) *
                (ENNReal.ofReal (((2 : Real)⁻¹) ^ (n + 1 + 3))) ^ (j - 3)) *
              A r := by
            simpa only [A, ofReal_norm] using hraw
      _ = Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r := by
            rw [restrictedRelativeBandpassSphericalMaximal_zero]
            simp only [zero_add]
            dsimp only [Q]
            rw [Finset.mul_sum]
  have hmoment (mu : Int) (hmu : mu ∈ U) :
      (∫⁻ x in B,
        (restrictedRelativeBandpassSphericalMaximal (n + 1)
          (E ∩ thinRadiusWindow s mu) phi j
          (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
            SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
              (thinRadialPartition (n + 1) s hs r)) x) ^ p ∂
          powerWeightedVolume (n + 1) α) ≤
        (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p *
          powerWeightedVolume (n + 1) α B := by
    let P : Euclidean (n + 1) → ENNReal := fun x =>
      restrictedRelativeBandpassSphericalMaximal (n + 1)
        (E ∩ thinRadiusWindow s mu) phi j
        (∑ r ∈ thinRadialUpperDistanceBlock M mu q,
          SchwartzMap.pairing (ContinuousLinearMap.mul Complex Complex) f
            (thinRadialPartition (n + 1) s hs r)) x
    calc
      (∫⁻ x in B, (P x) ^ p ∂powerWeightedVolume (n + 1) α) =
          ∫⁻ x, B.indicator (fun x => (P x) ^ p) x ∂
            powerWeightedVolume (n + 1) α := by
              rw [lintegral_indicator hB]
      _ ≤ ∫⁻ x, B.indicator (fun _ : Euclidean (n + 1) =>
          (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p) x ∂
            powerWeightedVolume (n + 1) α := by
              apply lintegral_mono
              intro x
              by_cases hx : x ∈ B
              · simp only [Set.indicator_of_mem hx]
                exact ENNReal.rpow_le_rpow (hpoint mu hmu x hx)
                  (lt_trans zero_lt_one hp).le
              · simp [hx]
      _ = ∫⁻ _x in B, (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p ∂
          powerWeightedVolume (n + 1) α := by
            rw [lintegral_indicator hB]
      _ = (Q * ∑ r ∈ thinRadialUpperDistanceBlock M mu q, A r) ^ p *
          powerWeightedVolume (n + 1) α B := setLIntegral_const _ _
  have hmass := finset_scaled_thinRadialPartition_tail_mass_rpow_le
    (d := n + 1) (by omega) hp hα hs f hfsupport M U
      (fun mu => thinRadialUpperDistanceBlock M mu q) Q (2 ^ (q + 1))
      (by positivity)
      (fun mu hmu => thinRadialUpperDistanceBlock_card_le M mu q)
      (fun r hr => thinRadialUpperDistanceBlock_column_card_le M U r q)
      (by
        intro mu hmu r hr
        exact (Finset.mem_filter.mp hr).1)
