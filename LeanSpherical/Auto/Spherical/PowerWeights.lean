  obtain ⟨hcoreMem, hcoreBound⟩ :=
    exists_lacunaryRelativeBandpassFinitePhysical_core_bound_of_isDyadicLacunaryRadiusSelector
      (by omega) C0 C1 hC0 hC1 hdecay hderiv phi psi hphi_one hphi_zero hphi_norm hpsi
      j r hr S hS
  apply lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_weak_one_two_scaled
    psi j r S hS W (ENNReal.ofReal (C ^ (2 : ℕ)))
  · exact hweak
  · intro g t ht
    exact weak_two_lacunaryRelativeBandpassFinitePhysicalMaximal_of_core_bound
      psi j r S hS C hCpos.le hcoreMem (by
        intro h
        simpa only [C] using hcoreBound h) g ht
  · exact hp1
  · exact hp2
  · exact hs

private theorem lintegral_iSup_int_exhaustion_rpow_le
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (u : ℤ → α → ℝ) (hu_meas : ∀ k, Measurable (u k))
    (hu_nonneg : ∀ k x, 0 ≤ u k x) (p : ℝ) (hp : 0 < p) {B : ENNReal}
    (hbound : ∀ (K : Finset ℤ) (hK : K.Nonempty),
      (∫⁻ x, (ENNReal.ofReal (K.sup' hK (fun k => u k x))) ^ p ∂μ) ≤ B) :
    (∫⁻ x, (⨆ k : ℤ, ENNReal.ofReal (u k x)) ^ p ∂μ) ≤ B := by
  let K : ℕ → Finset ℤ := fun n => Finset.Icc (-((n : ℤ))) (n : ℤ)
  have hKnonempty (n : ℕ) : (K n).Nonempty := by
    refine ⟨0, ?_⟩
    simp [K]
  let v : ℕ → α → ℝ := fun n x =>
    (K n).sup' (hKnonempty n) (fun k => u k x)
  have hv_meas (n : ℕ) : Measurable (v n) := by
    have hsup_apply : ((K n).sup' (hKnonempty n) u : α → ℝ) = v n := by
      funext x
      exact Finset.sup'_apply (hKnonempty n) u x
    rw [← hsup_apply]
