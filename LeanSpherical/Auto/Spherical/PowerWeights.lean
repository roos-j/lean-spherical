          ((⨆ m : ℕ, (u m x) ^ p) ^ (1 / p)) ^ p :=
        ENNReal.rpow_le_rpow hroot hp.le
      _ = ⨆ m : ℕ, (u m x) ^ p := by
        rw [← ENNReal.rpow_mul]
        field_simp
        simp
  calc
    (∫⁻ x, (⨆ m : ℕ, u m x) ^ p ∂mu) ≤
        ∫⁻ x, ⨆ m : ℕ, (u m x) ^ p ∂mu :=
      lintegral_mono fun x => hpow_iSup x
    _ = ⨆ m : ℕ, ∫⁻ x, (u m x) ^ p ∂mu :=
      MeasureTheory.lintegral_iSup hpow_meas hpow_mono
    _ ≤ B := by
      apply iSup_le
      exact hbound

