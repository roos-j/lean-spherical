      · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by positivity)) _).ne'
      · exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
  · exact ENNReal.ofReal_ne_top

private theorem ballOriginCapConstant_ne_top (n : ℕ) :
    ballOriginCapConstant n ≠ (∞ : ℝ≥0∞) := by
