  rcases hr with ⟨hrE, hr⟩
  refine ⟨hrE, ?_⟩
  rcases Set.mem_iUnion.mp hr with ⟨k, hk⟩
  rcases Set.mem_iUnion.mp hk with ⟨hkK, hkr⟩
  refine Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨?_, hkr⟩⟩
  simp only [Finset.mem_coe] at hkK ⊢
  rw [Finset.mem_Icc] at hkK ⊢
  omega

