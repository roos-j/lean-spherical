    simpa only [R] using (hbridge f).1
  have hmoment : (∫ x : Euclidean d, R x ^ p) ≤
      A * ∫ x : Euclidean d, ‖f x‖ ^ p := by
    simpa only [R] using (hbridge f).2
  have hR_nonneg (x : Euclidean d) : 0 ≤ R x := by
    exact ENNReal.toReal_nonneg
  have hM_ne_top (x : Euclidean d) : M x ≠ ⊤ := by
    dsimp only [M]
    refine ne_top_of_le_ne_top
      (ENNReal.ofReal_ne_top : ENNReal.ofReal ‖f.toBoundedContinuousFunction‖ ≠ ⊤) ?_
    exact (restrictedNormalizedSphericalMaximal_le_normalizedSphericalMaximal d E
      (f : Euclidean d → ℂ) x).trans
      (normalizedSphericalMaximal_le_of_norm_le hd0 (f : Euclidean d → ℂ) x
        (fun y => by
          change ‖f.toBoundedContinuousFunction y‖ ≤ ‖f.toBoundedContinuousFunction‖
          exact BoundedContinuousFunction.norm_coe_le_norm _ _))
  have hM_eq (x : Euclidean d) : M x = ENNReal.ofReal (R x) := by
    dsimp only [M, R]
    symm
    exact ENNReal.ofReal_toReal (hM_ne_top x)
  have hMfun : M = ENNReal.ofReal ∘ R := by
    funext x
    simpa only [Function.comp_apply] using hM_eq x
  have hMeas : AEStronglyMeasurable M volume := by
    simpa only [M] using
      (measurable_restrictedNormalizedSphericalMaximal_schwartz E f).aestronglyMeasurable
  have hMLpEq : eLpNorm M (ENNReal.ofReal p) volume =
      eLpNorm R (ENNReal.ofReal p) volume := by
    rw [hMfun]
    exact eLpNorm_ofReal R (Filter.Eventually.of_forall fun x => hR_nonneg x)
  have hMmem : MemLp M (ENNReal.ofReal p) volume := by
    refine ⟨hMeas, ?_⟩
    rw [hMLpEq]
    exact hRreal.2
  have hI_R_nonneg : 0 ≤ ∫ x : Euclidean d, R x ^ p :=
    integral_nonneg fun x => Real.rpow_nonneg (hR_nonneg x) p
  have hI_f_nonneg : 0 ≤ ∫ x : Euclidean d, ‖f x‖ ^ p :=
    integral_nonneg fun x => Real.rpow_nonneg (norm_nonneg _) p
  have hD_nonneg : 0 ≤ D := Real.rpow_nonneg hA.le _
