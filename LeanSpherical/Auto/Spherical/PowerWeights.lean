    · apply ne_of_gt
      apply ENNReal.mul_pos
      · exact (ENNReal.pow_pos (ENNReal.ofReal_pos.mpr (by positivity)) _).ne'
      · exact (ENNReal.ofReal_pos.mpr (by positivity)).ne'
  · exact ENNReal.ofReal_ne_top

private theorem ballOriginTubeMass_pos
    (n : ℕ) (α : ℝ) {δ : ℝ≥0} (hδ : 0 < δ) :
    0 < ballOriginTubeMass n α δ := by
  have hlog : 0 < Real.log 2 * (δ : ℝ) / 8 := by positivity
  unfold ballOriginTubeMass
  apply ENNReal.mul_pos
  · exact (ENNReal.rpow_pos (ENNReal.ofReal_pos.mpr (by positivity))
      ENNReal.ofReal_ne_top).ne'
  · apply ne_of_gt
    apply ENNReal.mul_pos
    · exact (Metric.measure_ball_pos volume (0 : Euclidean n) (by positivity)).ne'
    · exact (ENNReal.ofReal_pos.mpr hlog).ne'

private theorem ballOriginCapFactor_ne_top (n : ℕ) (δ : ℝ≥0) :
    ballOriginCapFactor n δ ≠ (∞ : ℝ≥0∞) := by
  unfold ballOriginCapFactor
  apply ENNReal.div_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.ofReal_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.pow_ne_top ENNReal.ofReal_ne_top
      · exact ENNReal.ofReal_ne_top
  · exact (ENNReal.ofReal_pos.mpr (surfaceMass_pos (by omega))).ne'

private theorem ballOriginTubeMass_ne_top (n : ℕ) (α : ℝ) (δ : ℝ≥0) :
