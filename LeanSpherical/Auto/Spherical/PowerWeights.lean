      ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm R (ENNReal.ofReal p) volume = ENNReal.ofReal
          (lpNorm R (ENNReal.ofReal p) volume) := (ofReal_lpNorm hRreal).symm
      _ ≤ ENNReal.ofReal (D * lpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume) :=
        ENNReal.ofReal_le_ofReal hRlp
      _ = ENNReal.ofReal D * eLpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume := by
        rw [ENNReal.ofReal_mul hD_nonneg, ofReal_lpNorm hf]
  refine ⟨?_, ?_⟩
  · simpa only [M] using hMmem
  · simpa only [M] using hMLpEq.trans_le hRnorm

end

