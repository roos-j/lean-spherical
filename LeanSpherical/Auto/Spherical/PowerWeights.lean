    (hp : (d : ℝ) / ((d : ℝ) - 1) < p) (E : Set ℝ) :
    HasRestrictedNormalizedSphericalMaximalPowerWeightStrongType d E p 0 := by
  rw [hasRestrictedNormalizedSphericalMaximalPowerWeightStrongType_zero_iff]
  obtain ⟨A, hA, hbridge⟩ := restricted_stein_spherical_maximal hd hp E
  let D : ℝ := A ^ p⁻¹
