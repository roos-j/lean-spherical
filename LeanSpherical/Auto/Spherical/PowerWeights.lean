      _ = ((2 * ENNReal.ofReal D) +
          (32 * A * (ENNReal.ofReal C) ^ 2) +
          (16 * ENNReal.ofReal T)) * F := by ring
  rw [haeq]
  simpa only [I, aCell, bCell, V, D, A, T,
