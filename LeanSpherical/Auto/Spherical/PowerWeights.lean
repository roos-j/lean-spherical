      D * lpNorm (f : Euclidean d → ℂ) (ENNReal.ofReal p) volume := by
    rw [lpNorm_eq_integral_norm_rpow_toReal hpENN_ne_zero ENNReal.ofReal_ne_top
      hRreal.aestronglyMeasurable,
      lpNorm_eq_integral_norm_rpow_toReal hpENN_ne_zero ENNReal.ofReal_ne_top
        hf.aestronglyMeasurable]
    simp only [ENNReal.toReal_ofReal hp_pos.le]
    calc
      (∫ x : Euclidean d, ‖R x‖ ^ p) ^ p⁻¹ =
          (∫ x : Euclidean d, R x ^ p) ^ p⁻¹ := by
        congr 2
        funext x
        rw [Real.norm_eq_abs, abs_of_nonneg (hR_nonneg x)]
      _ ≤ (A * ∫ x : Euclidean d, ‖f x‖ ^ p) ^ p⁻¹ :=
        Real.rpow_le_rpow hI_R_nonneg hmoment (inv_nonneg.mpr hp_pos.le)
      _ = D * (∫ x : Euclidean d, ‖f x‖ ^ p) ^ p⁻¹ := by
        dsimp only [D]
        exact Real.mul_rpow hA.le hI_f_nonneg
