theorem lacunaryRelativeBandpassFinitePhysical_lintegral_rpow_of_isDyadicLacunaryRadiusSelector_of_weak_one
    {n : Nat} (hn : 2 ≤ n) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (n + 1), 1 ≤ ‖xi‖ →
