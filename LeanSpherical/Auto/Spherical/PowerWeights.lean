  intro f hf
  let R : Euclidean d → ℝ := fun x =>
    (restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x).toReal
  let M : Euclidean d → ENNReal := fun x =>
    restrictedNormalizedSphericalMaximal d E (f : Euclidean d → ℂ) x
