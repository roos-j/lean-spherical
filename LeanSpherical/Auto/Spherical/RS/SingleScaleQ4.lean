/-! ### Rotations of the plane -/

/-- The rotation of the plane by the angle `α`. -/
def rotF (α : ℝ) (ω : Pl) : Pl :=
  mk2 (ω 0 * Real.cos α - ω 1 * Real.sin α) (ω 0 * Real.sin α + ω 1 * Real.cos α)

@[simp] theorem rotF_apply_zero (α : ℝ) (ω : Pl) :
    rotF α ω 0 = ω 0 * Real.cos α - ω 1 * Real.sin α := by
  rw [rotF, mk2_apply_zero]

@[simp] theorem rotF_apply_one (α : ℝ) (ω : Pl) :
    rotF α ω 1 = ω 0 * Real.sin α + ω 1 * Real.cos α := by
  rw [rotF, mk2_apply_one]

theorem norm_rotF (α : ℝ) (ω : Pl) : ‖rotF α ω‖ = ‖ω‖ := by
  have hpyth := Real.sin_sq_add_cos_sq α
  have hsq : ‖rotF α ω‖ ^ 2 = ‖ω‖ ^ 2 := by
    rw [norm_sq_two, norm_sq_two, rotF_apply_zero, rotF_apply_one]
    nlinarith [hpyth, sq_nonneg (ω 0), sq_nonneg (ω 1)]
  nlinarith [norm_nonneg (rotF α ω), norm_nonneg ω, hsq]

theorem inner_rotF (α : ℝ) (u v : Pl) :
    (inner ℝ (rotF α u) (rotF α v) : ℝ) = inner ℝ u v := by
  have hpyth := Real.sin_sq_add_cos_sq α
  rw [inner_two, inner_two, rotF_apply_zero, rotF_apply_one, rotF_apply_zero, rotF_apply_one]
  linear_combination (u 0 * v 0 + u 1 * v 1) * hpyth

theorem rotF_pt (α r φ : ℝ) : rotF α (pt r φ) = pt r (φ + α) := by
  change mk2 ((pt r φ) 0 * Real.cos α - (pt r φ) 1 * Real.sin α)
      ((pt r φ) 0 * Real.sin α + (pt r φ) 1 * Real.cos α)
    = mk2 (r * Real.cos (φ + α)) (r * Real.sin (φ + α))
  rw [pt, mk2_apply_zero, mk2_apply_one, Real.cos_add, Real.sin_add]
  congr 1 <;> ring

theorem rotF_rotF (α β : ℝ) (ω : Pl) : rotF α (rotF β ω) = rotF (β + α) ω := by
  change mk2 ((rotF β ω) 0 * Real.cos α - (rotF β ω) 1 * Real.sin α)
      ((rotF β ω) 0 * Real.sin α + (rotF β ω) 1 * Real.cos α)
    = mk2 (ω 0 * Real.cos (β + α) - ω 1 * Real.sin (β + α))
      (ω 0 * Real.sin (β + α) + ω 1 * Real.cos (β + α))
  rw [rotF_apply_zero, rotF_apply_one, Real.cos_add, Real.sin_add]
  congr 1 <;> ring

theorem rotF_zero (ω : Pl) : rotF 0 ω = ω := by
  change mk2 (ω 0 * Real.cos 0 - ω 1 * Real.sin 0) (ω 0 * Real.sin 0 + ω 1 * Real.cos 0) = ω
  rw [Real.cos_zero, Real.sin_zero, show ω 0 * 1 - ω 1 * 0 = ω 0 by ring,
    show ω 0 * 0 + ω 1 * 1 = ω 1 by ring]
  exact mk2_coords ω

theorem rotF_neg_rotF (α : ℝ) (ω : Pl) : rotF (-α) (rotF α ω) = ω := by
  rw [rotF_rotF, add_neg_cancel, rotF_zero]

theorem rotF_rotF_neg (α : ℝ) (ω : Pl) : rotF α (rotF (-α) ω) = ω := by
  rw [rotF_rotF, neg_add_cancel, rotF_zero]

theorem rotF_add_apply (α : ℝ) (u v : Pl) : rotF α (u + v) = rotF α u + rotF α v := by
  have h0 : (u + v) 0 = u 0 + v 0 := rfl
  have h1 : (u + v) 1 = u 1 + v 1 := rfl
  change mk2 ((u + v) 0 * Real.cos α - (u + v) 1 * Real.sin α)
      ((u + v) 0 * Real.sin α + (u + v) 1 * Real.cos α)
    = rotF α u + rotF α v
  rw [h0, h1]
  have hgoal : rotF α u + rotF α v
      = mk2 ((rotF α u) 0 + (rotF α v) 0) ((rotF α u) 1 + (rotF α v) 1) := by
    have e0 : (rotF α u + rotF α v) 0 = (rotF α u) 0 + (rotF α v) 0 := rfl
    have e1 : (rotF α u + rotF α v) 1 = (rotF α u) 1 + (rotF α v) 1 := rfl
    rw [← e0, ← e1, mk2_coords]
  rw [hgoal, rotF_apply_zero, rotF_apply_one, rotF_apply_zero, rotF_apply_one]
  congr 1 <;> ring

theorem rotF_smul_apply (α c : ℝ) (u : Pl) : rotF α (c • u) = c • rotF α u := by
  have h0 : (c • u) 0 = c * u 0 := rfl
  have h1 : (c • u) 1 = c * u 1 := rfl
  change mk2 ((c • u) 0 * Real.cos α - (c • u) 1 * Real.sin α)
      ((c • u) 0 * Real.sin α + (c • u) 1 * Real.cos α)
    = c • rotF α u
  rw [h0, h1]
  have hgoal : c • rotF α u = mk2 (c * (rotF α u) 0) (c * (rotF α u) 1) := by
    have e0 : (c • rotF α u) 0 = c * (rotF α u) 0 := rfl
    have e1 : (c • rotF α u) 1 = c * (rotF α u) 1 := rfl
    rw [← e0, ← e1, mk2_coords]
  rw [hgoal, rotF_apply_zero, rotF_apply_one]
  congr 1 <;> ring

/-- The rotation as a linear equivalence of the plane. -/
def rotLE (α : ℝ) : Pl ≃ₗ[ℝ] Pl where
  toFun := rotF α
  map_add' := rotF_add_apply α
  map_smul' := fun c u => rotF_smul_apply α c u
  invFun := rotF (-α)
  left_inv := rotF_neg_rotF α
  right_inv := rotF_rotF_neg α

/-- The rotation as a linear isometry equivalence of the plane. -/
def rotLIE (α : ℝ) : Pl ≃ₗᵢ[ℝ] Pl where
  toLinearEquiv := rotLE α
  norm_map' := norm_rotF α

@[simp] theorem rotLIE_apply (α : ℝ) (ω : Pl) : rotLIE α ω = rotF α ω := rfl

/-- The rotation as a continuous linear equivalence of the plane. -/
def rotCLE (α : ℝ) : Pl ≃L[ℝ] Pl := (rotLIE α).toContinuousLinearEquiv

@[simp] theorem rotCLE_apply (α : ℝ) (ω : Pl) : rotCLE α ω = rotF α ω := rfl

theorem continuous_rotF (α : ℝ) : Continuous (rotF α) := (rotCLE α).continuous

theorem measurePreserving_rotF (α : ℝ) :
    MeasurePreserving (rotF α) (volume : Measure Pl) (volume : Measure Pl) :=
  (rotLIE α).measurePreserving

theorem measurableEmbedding_rotF (α : ℝ) : MeasurableEmbedding (rotF α) :=
  (rotCLE α).toHomeomorph.measurableEmbedding

theorem lintegral_comp_rotF (α : ℝ) {G : Pl → ℝ≥0∞} (hG : Measurable G) :
    (∫⁻ x : Pl, G (rotF α x)) = ∫⁻ x : Pl, G x :=
  (measurePreserving_rotF α).lintegral_comp hG

theorem fourier_comp_rotF {f : Pl → ℂ} (α : ℝ) (ω : Pl) :
    𝓕 (fun v : Pl => f (rotF α v)) ω = 𝓕 f (rotF α ω) := by
  rw [fourier_eq_ee_Pl, fourier_eq_ee_Pl]
  have hchange := (measurePreserving_rotF α).integral_comp (measurableEmbedding_rotF α)
    (fun u : Pl => ee (inner ℝ u (rotF α ω)) * f u)
  rw [← hchange]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  simp only [inner_rotF]

/-! ### Building the multiplier data from derivative bounds -/

/-- The canonical second-derivative field of a smooth multiplier. -/
noncomputable def m2can (m : ℝ → Pl → ℂ) (t : ℝ) (ω : Pl) (e e' : Pl) : ℂ :=
  fderiv ℝ (fderiv ℝ (m t)) ω e e'

set_option maxHeartbeats 1000000 in
