    intro s
    simp only [Set.mem_Ioc]
    constructor
    · intro h
      exact ⟨by linarith [h.1], by linarith [h.2]⟩
    · intro h
      exact ⟨by linarith [h.1], by linarith [h.2]⟩
  have hfun : (Set.Ioc a b).indicator (fun s : ℝ => F (c + s))
      = fun s : ℝ => (Set.Ioc (c + a) (c + b)).indicator F (c + s) := by
    funext s
    by_cases hs : s ∈ Set.Ioc a b
    · rw [Set.indicator_of_mem hs, Set.indicator_of_mem ((hset s).mpr hs)]
    · rw [Set.indicator_of_notMem hs,
        Set.indicator_of_notMem (fun hc => hs ((hset s).mp hc))]
  rw [← lintegral_indicator measurableSet_Ioc, ← lintegral_indicator measurableSet_Ioc, hfun]
  exact (lintegral_add_left_eq_self ((Set.Ioc (c + a) (c + b)).indicator F) c).symm

