    have hmf : Continuous fun s : ℝ => mfull j ε m s ω := by
      change Continuous fun s : ℝ =>
        Complex.exp (((2 * π * ε * s * ‖ω‖ : ℝ) : ℂ) * Complex.I) * m s ω
      exact hcexp.mul (hmc ω)
    have hee : Continuous fun x : Pl => ee (-(inner ℝ x ω : ℝ)) := by
      have h2 : Continuous fun x : Pl => -(inner ℝ x ω : ℝ) :=
        (continuous_id.inner continuous_const).neg
      exact continuous_ee.comp h2
    exact (hee.comp continuous_snd).mul
      ((hmf.comp continuous_fst).mul continuous_const)

theorem TopS_eq_add_intervalIntegral {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (hmdc : ∀ ω : Pl, Continuous fun s : ℝ => mdot s ω)
    (f : SchwartzMap Pl ℂ) (x : Pl) (a b : ℝ) :
    (TopS hm ε b f : Pl → ℂ) x
      = (TopS hm ε a f : Pl → ℂ) x + ∫ s in a..b, (TopS hmt ε s f : Pl → ℂ) x := by
  have hmc : ∀ ω : Pl, Continuous fun s : ℝ => m s ω := fun ω =>
    continuous_iff_continuousAt.mpr fun s => (hmd ω s).continuousAt
  have hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω := by
    intro ω
    change Continuous fun s : ℝ => ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * m s ω + mdot s ω
    exact (continuous_const.mul (hmc ω)).add (hmdc ω)
  have hcont : Continuous fun s : ℝ => (TopS hmt ε s f : Pl → ℂ) x :=
    continuous_TopS_t hmt hmtc ε f x
  have heq := intervalIntegral.integral_eq_sub_of_hasDerivAt
    (fun s _ => hasDerivAt_TopS hm hmt hmd s f x) (hcont.intervalIntegrable a b)
  rw [heq]
  ring

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The discretized fundamental theorem of calculus**, in `ℝ≥0∞` form. -/
theorem enorm_TopS_le_add_lintegral {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (hmdc : ∀ ω : Pl, Continuous fun s : ℝ => mdot s ω)
    (f : SchwartzMap Pl ℂ) (x : Pl) (t t' : ℝ) :
    ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ
      ≤ ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ
        + ∫⁻ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ₑ := by
  have hmc : ∀ ω : Pl, Continuous fun s : ℝ => m s ω := fun ω =>
    continuous_iff_continuousAt.mpr fun s => (hmd ω s).continuousAt
  have hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω := by
    intro ω
    change Continuous fun s : ℝ => ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * m s ω + mdot s ω
    exact (continuous_const.mul (hmc ω)).add (hmdc ω)
  have hcont : Continuous fun s : ℝ => (TopS hmt ε s f : Pl → ℂ) x :=
    continuous_TopS_t hmt hmtc ε f x
  have hint : IntegrableOn (fun s : ℝ => ‖(TopS hmt ε s f : Pl → ℂ) x‖) (Set.uIoc t' t)
      (volume : Measure ℝ) :=
    intervalIntegrable_iff.mp ((hcont.norm).intervalIntegrable t' t)
  have hnn : 0 ≤ ∫ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ :=
    setIntegral_nonneg measurableSet_uIoc (fun s _ => norm_nonneg _)
  have h1 : ‖(TopS hm ε t f : Pl → ℂ) x‖
      ≤ ‖(TopS hm ε t' f : Pl → ℂ) x‖
        + ∫ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ := by
    rw [TopS_eq_add_intervalIntegral hm hmt hmd hmdc f x t' t]
    refine le_trans (norm_add_le _ _) ?_
    have h2 : ‖∫ s in t'..t, (TopS hmt ε s f : Pl → ℂ) x‖
        ≤ ∫ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ :=
      intervalIntegral.norm_integral_le_integral_norm_uIoc
    linarith
  have h3 : ENNReal.ofReal (∫ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖)
      = ∫⁻ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ₑ := by
    rw [ofReal_integral_eq_lintegral_ofReal hint
      (Filter.Eventually.of_forall fun s => norm_nonneg _)]
    refine lintegral_congr fun s => ?_
    rw [ofReal_norm]
  calc ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ
      = ENNReal.ofReal ‖(TopS hm ε t f : Pl → ℂ) x‖ := (ofReal_norm _).symm
    _ ≤ ENNReal.ofReal (‖(TopS hm ε t' f : Pl → ℂ) x‖
          + ∫ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖) :=
        ENNReal.ofReal_le_ofReal h1
    _ = ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ
          + ∫⁻ s in Set.uIoc t' t, ‖(TopS hmt ε s f : Pl → ℂ) x‖ₑ := by
        rw [ENNReal.ofReal_add (norm_nonneg _) hnn, h3, ofReal_norm]

/-- The truncated derivative family of the discretization. -/
noncomputable def derTr {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0' ε : ℝ} (hmt : MultData j (mtil ε m mdot) m2' B0') (f : SchwartzMap Pl ℂ)
    (u : ℝ) (x : Pl) : ℝ≥0∞ :=
  if 1 ≤ u ∧ u ≤ 2 then ‖(TopS hmt ε u f : Pl → ℂ) x‖ₑ else 0

theorem derTr_eq_of_mem {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0' ε : ℝ} (hmt : MultData j (mtil ε m mdot) m2' B0') (f : SchwartzMap Pl ℂ)
    {u : ℝ} (h1 : 1 ≤ u) (h2 : u ≤ 2) (x : Pl) :
    derTr hmt f u x = ‖(TopS hmt ε u f : Pl → ℂ) x‖ₑ := by
  rw [derTr, if_pos ⟨h1, h2⟩]

theorem measurable_derTr_prod {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0' ε : ℝ} (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω) (f : SchwartzMap Pl ℂ)
    (t' : ℝ) : Measurable fun v : ℝ × Pl => derTr hmt f (t' + v.1) v.2 := by
  classical
  have hcont : Continuous fun v : ℝ × Pl => (TopS hmt ε v.1 f : Pl → ℂ) v.2 :=
    continuous_TopS_prod hmt hmtc ε f
  have hshift : Continuous fun v : ℝ × Pl => ((t' + v.1, v.2) : ℝ × Pl) :=
    (continuous_const.add continuous_fst).prodMk continuous_snd
  have h1 : Measurable fun v : ℝ × Pl => ‖(TopS hmt ε (t' + v.1) f : Pl → ℂ) v.2‖ₑ :=
    ((hcont.comp hshift).enorm).measurable
  have hset : MeasurableSet {v : ℝ × Pl | 1 ≤ t' + v.1 ∧ t' + v.1 ≤ 2} := by
    have hm1 : MeasurableSet {v : ℝ × Pl | 1 ≤ t' + v.1} :=
      measurableSet_le measurable_const (measurable_const.add measurable_fst)
    have hm2 : MeasurableSet {v : ℝ × Pl | t' + v.1 ≤ 2} :=
      measurableSet_le (measurable_const.add measurable_fst) measurable_const
    exact hm1.inter hm2
  change Measurable fun v : ℝ × Pl =>
    if 1 ≤ t' + v.1 ∧ t' + v.1 ≤ 2 then ‖(TopS hmt ε (t' + v.1) f : Pl → ℂ) v.2‖ₑ else 0
  exact Measurable.ite hset h1 measurable_const

theorem measurable_derTr_fst {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0' ε : ℝ} (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω) (f : SchwartzMap Pl ℂ)
    (x : Pl) : Measurable fun u : ℝ => derTr hmt f u x := by
  classical
  have hcont : Continuous fun s : ℝ => (TopS hmt ε s f : Pl → ℂ) x :=
    continuous_TopS_t hmt hmtc ε f x
  have hset : MeasurableSet {u : ℝ | 1 ≤ u ∧ u ≤ 2} :=
    (measurableSet_le measurable_const measurable_id).inter
      (measurableSet_le measurable_id measurable_const)
  change Measurable fun u : ℝ =>
    if 1 ≤ u ∧ u ≤ 2 then ‖(TopS hmt ε u f : Pl → ℂ) x‖ₑ else 0
  exact Measurable.ite hset (hcont.enorm).measurable measurable_const

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The discretization of the supremum.**  The supremum over `E` of the single-scale operator is
bounded by the `ℓ^q`-sum over a `δ`-net `ℰ ⊆ [1,2]` of `E`, plus the `ℓ^q`-sum of the local
integrals of the `t`-derivative. -/
theorem iSup_enorm_TopS_le {j : ℕ} {m mdot : ℝ → Pl → ℂ} {m2 m2' : ℝ → Pl → Pl → Pl → ℂ}
    {B0 B0' : ℝ} {ε : ℝ} (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (hmdc : ∀ ω : Pl, Continuous fun s : ℝ => mdot s ω)
    (f : SchwartzMap Pl ℂ) {q δ : ℝ} (hq : 0 < q) (hδ : 0 < δ)
    {E : Set ℝ} {Efin : Finset ℝ} (hE : ∀ t ∈ E, 1 ≤ t ∧ t ≤ 2)
    (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    (hdense : ∀ t ∈ E, ∃ t' ∈ Efin, |t - t'| ≤ δ) (x : Pl) :
    (⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ)
      ≤ (∑ t' ∈ Efin, ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ ^ q) ^ (1 / q)
        + (∑ t' ∈ Efin, (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ q) ^ (1 / q) := by
  refine iSup_le fun t => ?_
  obtain ⟨t', ht'mem, hclose⟩ := hdense t.1 t.2
  have habs := abs_le.mp hclose
  have hEt := hE t.1 t.2
  have hEt' := hEfin t' ht'mem
  have hsub : Set.uIoc t' t.1 ⊆ Set.Ioc (t' + -δ) (t' + δ) := by
    intro u hu
    rw [Set.mem_Ioc]
    rcases Set.mem_uIoc.mp hu with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨by linarith, by linarith [habs.2]⟩
    · exact ⟨by linarith [habs.1], by linarith⟩
  have hin12 : ∀ u ∈ Set.uIoc t' t.1, 1 ≤ u ∧ u ≤ 2 := by
    intro u hu
    rcases Set.mem_uIoc.mp hu with ⟨h1, h2⟩ | ⟨h1, h2⟩
    · exact ⟨by linarith [hEt'.1], by linarith [hEt.2]⟩
    · exact ⟨by linarith [hEt.1], by linarith [hEt'.2]⟩
  have hcongr : (∫⁻ s in Set.uIoc t' t.1, ‖(TopS hmt ε s f : Pl → ℂ) x‖ₑ)
      = ∫⁻ s in Set.uIoc t' t.1, derTr hmt f s x := by
    refine setLIntegral_congr_fun measurableSet_uIoc ?_
    intro u hu
    exact (derTr_eq_of_mem hmt f (hin12 u hu).1 (hin12 u hu).2 x).symm
  have hstep : (∫⁻ s in Set.uIoc t' t.1, ‖(TopS hmt ε s f : Pl → ℂ) x‖ₑ)
      ≤ ∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x := by
    rw [hcongr, ← lintegral_Ioc_shift t' (fun u => derTr hmt f u x) (-δ) δ]
    exact lintegral_mono_set hsub
  refine le_trans (enorm_TopS_le_add_lintegral hm hmt hmd hmdc f x t.1 t') (add_le_add ?_ ?_)
  · exact le_ellq hq ht'mem
  · exact le_trans hstep (le_ellq hq ht'mem)

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The `L^{q₄}` bound for the derivative term of the discretization.**  The local integrals in
the dilation parameter cost exactly the length `2δ` of the interval. -/
theorem lintegral_pow_derTr_le {j : ℕ} {m mdot : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0t : ℝ} {m2' : ℝ → Pl → Pl → Pl → ℂ} {B0t' : ℝ} {ε : ℝ}
    (hpolt : PolarData j (mtil ε m mdot) mr ma B0t)
    (hmt : MultData j (mtil ε m mdot) m2' B0t')
    (hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    (hε : |ε| = 1) (Efin : Finset ℝ)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p δ : ℝ} (hp : p = (3 + 2 * gam) / 2) (hδ : 0 < δ) (f : SchwartzMap Pl ℂ) :
    (∑ t' ∈ Efin, ∫⁻ x : Pl,
        (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ (2 * p)) ^ (1 / (2 * p))
      ≤ ENNReal.ofReal (2 * δ)
        * ((C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
          * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)) := by
  classical
  have hp2 : 2 < p := by rw [hp]; linarith
  have hppos : (0 : ℝ) < p := by linarith
  have hq1 : (1 : ℝ) < 2 * p := by linarith
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  set q : ℝ := 2 * p with hqdef
  set K : ℝ≥0∞ := (C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
      * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) with hKdef
  have h2δ : (0 : ℝ) < 2 * δ := by linarith
  have hlen : δ - -δ = 2 * δ := by ring
  have hinj : Function.Injective (fun t : ℝ => t + 0) := fun a b hab => by simpa using hab
  -- the joint measurability of the truncated derivative family
  have hmeasfst : ∀ x : Pl, Measurable fun u : ℝ => derTr hmt f u x := fun x =>
    measurable_derTr_fst hmt hmtc f x
  have hmeasprod : ∀ t' : ℝ, Measurable fun w : Pl × ℝ => (derTr hmt f (t' + w.2) w.1) ^ q := by
    intro t'
    have h1 : Measurable fun v : ℝ × Pl => derTr hmt f (t' + v.1) v.2 :=
      measurable_derTr_prod hmt hmtc f t'
    exact (h1.comp measurable_swap).pow_const _
  -- Step 1: Hölder in the dilation parameter
  have hHolder : ∀ (t' : ℝ) (x : Pl),
      (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ q
        ≤ (ENNReal.ofReal (2 * δ)) ^ (q - 1)
          * ∫⁻ s in Set.Ioc (-δ) δ, (derTr hmt f (t' + s) x) ^ q := by
    intro t' x
    have hmeas : Measurable fun s : ℝ => derTr hmt f (t' + s) x :=
      (hmeasfst x).comp (measurable_const.add measurable_id)
    have h := lintegral_Ioc_pow_le hq1 hmeas (by linarith : (-δ : ℝ) ≤ δ)
    rwa [hlen] at h
  -- Step 2: Tonelli
  have hswap : ∀ t' : ℝ, (∫⁻ x : Pl, ∫⁻ s in Set.Ioc (-δ) δ, (derTr hmt f (t' + s) x) ^ q)
      = ∫⁻ s in Set.Ioc (-δ) δ, ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q := by
    intro t'
    exact lintegral_lintegral_swap ((hmeasprod t').aemeasurable)
  -- Step 3: the slice bound
  have hslice : ∀ s : ℝ, (∑ t' ∈ Efin, ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q) ≤ K ^ q := by
    intro s
    have hinjs : Function.Injective (fun t : ℝ => t + s) := fun a b hab => by simpa using hab
    set Efs : Finset ℝ := (Efin.filter (fun t' => 1 ≤ t' + s ∧ t' + s ≤ 2)).image
      (fun t' => t' + s) with hEfs
    have hEfs12 : ∀ u ∈ Efs, 1 ≤ u ∧ u ≤ 2 := by
      intro u hu
      rw [hEfs, Finset.mem_image] at hu
      obtain ⟨t', ht', rfl⟩ := hu
      rw [Finset.mem_filter] at ht'
      exact ht'.2
    have hcardEfs : (Efs.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam) := by
      refine le_trans ?_ hcard
      have h1 : Efs.card ≤ Efin.card := by
        rw [hEfs, Finset.card_image_of_injective _ hinjs]
        exact Finset.card_filter_le _ _
      exact_mod_cast h1
    have hcountEfs : ∀ k ≤ Mc, IsIntervalCount Efs (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)) := by
      intro k hk
      have h1 := (hcount k hk).translate s
      refine IsIntervalCount.subset ?_ h1
      rw [hEfs]
      exact Finset.image_subset_image (Finset.filter_subset _ _)
    have hmain := lintegral_pow_TopS_le hpolt hmt hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efs
      hEfs12 hgam1 hgam2 hNa hMc hcardEfs hcountEfs hMk hQb hMj hMj2 hBL hp f
    have hzero : ∀ t' ∈ Efin, (∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q) ≠ 0 →
        (1 ≤ t' + s ∧ t' + s ≤ 2) := by
      intro t' _ hne
      by_contra hcon
      refine hne ?_
      have hpt : ∀ x : Pl, (derTr hmt f (t' + s) x) ^ q = 0 := by
        intro x
        have hd0 : derTr hmt f (t' + s) x = 0 := by
          rw [derTr, if_neg hcon]
        rw [hd0, ENNReal.zero_rpow_of_pos hq0]
      rw [lintegral_congr hpt, lintegral_zero]
    have hsum : (∑ t' ∈ Efin, ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q)
        = ∑ u ∈ Efs, ∫⁻ x : Pl, ‖(TopS hmt ε u f : Pl → ℂ) x‖ₑ ^ q := by
      rw [← Finset.sum_filter_of_ne hzero, hEfs,
        Finset.sum_image (fun a _ b _ hab => hinjs hab)]
      refine Finset.sum_congr rfl fun t' ht' => ?_
      rw [Finset.mem_filter] at ht'
      refine lintegral_congr fun x => ?_
      rw [derTr_eq_of_mem hmt f ht'.2.1 ht'.2.2 x]
    rw [hsum]
    have hpow := ENNReal.rpow_le_rpow hmain hq0.le
    rw [← ENNReal.rpow_mul, hqdef] at hpow
    rw [show (1 : ℝ) / (2 * p) * (2 * p) = 1 by field_simp, ENNReal.rpow_one] at hpow
    exact hpow
  -- assemble
  have hmeasslice : ∀ t' : ℝ, Measurable fun s : ℝ => ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q := by
    intro t'
    have h1 : Measurable fun v : ℝ × Pl => (derTr hmt f (t' + v.1) v.2) ^ q :=
      (measurable_derTr_prod hmt hmtc f t').pow_const _
    exact h1.lintegral_prod_right'
  have hstep1 : (∑ t' ∈ Efin, ∫⁻ x : Pl,
        (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ q)
      ≤ (ENNReal.ofReal (2 * δ)) ^ (q - 1)
        * ∫⁻ s in Set.Ioc (-δ) δ, (∑ t' ∈ Efin, ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q) := by
    have h1 : (∑ t' ∈ Efin, ∫⁻ x : Pl,
          (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ q)
        ≤ ∑ t' ∈ Efin, (ENNReal.ofReal (2 * δ)) ^ (q - 1)
          * ∫⁻ x : Pl, ∫⁻ s in Set.Ioc (-δ) δ, (derTr hmt f (t' + s) x) ^ q := by
      refine Finset.sum_le_sum fun t' _ => ?_
      rw [← lintegral_const_mul' _ _ (by
        refine ENNReal.rpow_ne_top_of_nonneg (by linarith) ?_
        exact ENNReal.ofReal_ne_top)]
      exact lintegral_mono fun x => hHolder t' x
    refine le_trans h1 (le_of_eq ?_)
    rw [← Finset.mul_sum]
    congr 1
    rw [lintegral_finsetSum _ (fun t' _ => hmeasslice t')]
    exact Finset.sum_congr rfl fun t' _ => hswap t'
  have hstep2 : (∫⁻ s in Set.Ioc (-δ) δ,
        (∑ t' ∈ Efin, ∫⁻ x : Pl, (derTr hmt f (t' + s) x) ^ q))
      ≤ ENNReal.ofReal (2 * δ) * K ^ q := by
    refine le_trans (lintegral_mono hslice) (le_of_eq ?_)
    rw [setLIntegral_const, Real.volume_Ioc, hlen, mul_comm]
  have htotal : (∑ t' ∈ Efin, ∫⁻ x : Pl,
        (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ q)
      ≤ (ENNReal.ofReal (2 * δ) * K) ^ q := by
    have h0 : ENNReal.ofReal (2 * δ) ≠ 0 := by
      rw [ne_eq, ENNReal.ofReal_eq_zero]
      linarith
    have hpow : (ENNReal.ofReal (2 * δ)) ^ (q - 1) * (ENNReal.ofReal (2 * δ)) ^ (1 : ℝ)
        = (ENNReal.ofReal (2 * δ)) ^ q := by
      rw [← ENNReal.rpow_add _ _ h0 ENNReal.ofReal_ne_top]
      congr 1
      ring
    refine le_trans hstep1 (le_trans (mul_le_mul' (le_refl _) hstep2) (le_of_eq ?_))
    calc (ENNReal.ofReal (2 * δ)) ^ (q - 1) * (ENNReal.ofReal (2 * δ) * K ^ q)
        = ((ENNReal.ofReal (2 * δ)) ^ (q - 1) * (ENNReal.ofReal (2 * δ)) ^ (1 : ℝ)) * K ^ q := by
          rw [ENNReal.rpow_one]
          ring
      _ = (ENNReal.ofReal (2 * δ)) ^ q * K ^ q := by rw [hpow]
      _ = (ENNReal.ofReal (2 * δ) * K) ^ q := (ENNReal.mul_rpow_of_nonneg _ _ hq0.le).symm
  have hfinal := ENNReal.rpow_le_rpow htotal (le_of_lt (one_div_pos.mpr hq0))
  rw [← ENNReal.rpow_mul, mul_one_div, div_self hq0.ne', ENNReal.rpow_one] at hfinal
  rw [hqdef] at hfinal
  exact hfinal

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Theorem 2.1 of the paper, for the single-scale operator.**  The `L^{q₄}` norm of the maximal
function over `E` of `T_t f` is bounded by `‖f‖_{p₄}`, with the constant of §3 for the multiplier
and its `t`-derivative; the derivative term is paid for by the length `2δ` of the net. -/
theorem lintegral_pow_iSup_TopS_le {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {mr ma mrt mat : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 B0t : ℝ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0' B0t' : ℝ} {ε : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    (hpolt : PolarData j (mtil ε m mdot) mrt mat B0t)
    (hmt : MultData j (mtil ε m mdot) m2' B0t')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (hmdc : ∀ ω : Pl, Continuous fun s : ℝ => mdot s ω)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p δ : ℝ} (hp : p = (3 + 2 * gam) / 2) (hδ : 0 < δ)
    {E : Set ℝ} (hE : ∀ t ∈ E, 1 ≤ t ∧ t ≤ 2)
    (hdense : ∀ t ∈ E, ∃ t' ∈ Efin, |t - t'| ≤ δ) (f : SchwartzMap Pl ℂ) :
    (∫⁻ x : Pl, (⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) ^ (2 * p)) ^ (1 / (2 * p))
      ≤ ((C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
          + ENNReal.ofReal (2 * δ)
            * (C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2))
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  classical
  have hp2 : 2 < p := by rw [hp]; linarith
  have hppos : (0 : ℝ) < p := by linarith
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  have hmc : ∀ ω : Pl, Continuous fun s : ℝ => m s ω := fun ω =>
    continuous_iff_continuousAt.mpr fun s => (hmd ω s).continuousAt
  have hmtc : ∀ ω : Pl, Continuous fun s : ℝ => mtil ε m mdot s ω := by
    intro ω
    change Continuous fun s : ℝ => ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * m s ω + mdot s ω
    exact (continuous_const.mul (hmc ω)).add (hmdc ω)
  set A : Pl → ℝ≥0∞ := fun x =>
    (∑ t' ∈ Efin, ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ ^ (2 * p)) ^ (1 / (2 * p)) with hAdef
  set B : Pl → ℝ≥0∞ := fun x =>
    (∑ t' ∈ Efin, (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ (2 * p)) ^ (1 / (2 * p))
    with hBdef
  -- measurability of the two pieces
  have hmeasA : Measurable A := by
    rw [hAdef]
    refine Measurable.pow_const ?_ _
    refine Finset.measurable_sum _ fun t' _ => ?_
    exact (((TopS hm ε t' f : SchwartzMap Pl ℂ).continuous).enorm.measurable).pow_const _
  have hmeasB : Measurable B := by
    rw [hBdef]
    refine Measurable.pow_const ?_ _
    refine Finset.measurable_sum _ fun t' _ => ?_
    refine Measurable.pow_const ?_ _
    have h1 : Measurable fun w : Pl × ℝ => derTr hmt f (t' + w.2) w.1 :=
      (measurable_derTr_prod hmt hmtc f t').comp measurable_swap
    exact h1.lintegral_prod_right'
  -- the pointwise discretization
  have hpt : ∀ x : Pl, (⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) ≤ A x + B x := by
    intro x
    exact iSup_enorm_TopS_le hm hmt hmd hmdc f hq0 hδ hE hEfin hdense x
  -- the `L^q` norms of the two pieces
  have hApow : ∀ x : Pl, A x ^ (2 * p)
      = ∑ t' ∈ Efin, ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ ^ (2 * p) := by
    intro x
    rw [hAdef, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hBpow : ∀ x : Pl, B x ^ (2 * p)
      = ∑ t' ∈ Efin, (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ (2 * p) := by
    intro x
    rw [hBdef, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hq0.ne', ENNReal.rpow_one]
  have hAint : (∫⁻ x : Pl, A x ^ (2 * p))
      = ∑ t' ∈ Efin, ∫⁻ x : Pl, ‖(TopS hm ε t' f : Pl → ℂ) x‖ₑ ^ (2 * p) := by
    rw [lintegral_congr hApow]
    exact lintegral_finsetSum _ fun t' _ =>
      (((TopS hm ε t' f : SchwartzMap Pl ℂ).continuous).enorm.measurable).pow_const _
  have hBint : (∫⁻ x : Pl, B x ^ (2 * p))
      = ∑ t' ∈ Efin, ∫⁻ x : Pl,
        (∫⁻ s in Set.Ioc (-δ) δ, derTr hmt f (t' + s) x) ^ (2 * p) := by
    rw [lintegral_congr hBpow]
    refine lintegral_finsetSum _ fun t' _ => ?_
    refine Measurable.pow_const ?_ _
    have h1 : Measurable fun w : Pl × ℝ => derTr hmt f (t' + w.2) w.1 :=
      (measurable_derTr_prod hmt hmtc f t').comp measurable_swap
    exact h1.lintegral_prod_right'
  -- assemble
  calc (∫⁻ x : Pl, (⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) ^ (2 * p)) ^ (1 / (2 * p))
      ≤ (∫⁻ x : Pl, (A x + B x) ^ (2 * p)) ^ (1 / (2 * p)) := by
        refine ENNReal.rpow_le_rpow (lintegral_mono fun x => ?_) (le_of_lt (one_div_pos.mpr hq0))
        exact ENNReal.rpow_le_rpow (hpt x) hq0.le
    _ ≤ (∫⁻ x : Pl, A x ^ (2 * p)) ^ (1 / (2 * p))
          + (∫⁻ x : Pl, B x ^ (2 * p)) ^ (1 / (2 * p)) :=
        ENNReal.lintegral_Lp_add_le hmeasA.aemeasurable hmeasB.aemeasurable hq1
    _ ≤ (C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
            * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)
          + ENNReal.ofReal (2 * δ)
            * ((C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
              * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)) := by
        refine add_le_add ?_ ?_
        · rw [hAint]
          exact lintegral_pow_TopS_le hpol hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin
            hgam1 hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hp f
        · rw [hBint]
          exact lintegral_pow_derTr_le hpolt hmt hmtc hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin
            hgam1 hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hp hδ f
    _ = ((C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
          + ENNReal.ofReal (2 * δ)
            * (C3 Cs CV Cst Na B0t B0t' j Mc Mk L p gam) ^ ((1 : ℝ) / 2))
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by ring

/-! ### Nets of the dilation set -/

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **A maximal `δ`-separated subset is a `δ`-net.**  Every set of radii in `[1,2]` has a finite
`δ`-separated subset every point of which is within `δ` of the set. -/
theorem exists_delta_net {E : Set ℝ} (hE : E ⊆ Set.Icc (1 : ℝ) 2) {δ : ℝ} (hδ : 0 < δ) :
    ∃ Efin : Finset ℝ, (∀ t ∈ Efin, t ∈ E)
      ∧ (∀ s ∈ Efin, ∀ t ∈ Efin, s ≠ t → δ ≤ |s - t|)
      ∧ (∀ t ∈ E, ∃ t' ∈ Efin, |t - t'| ≤ δ) := by
  classical
  set P : Finset ℝ → Prop := fun F =>
    (∀ t ∈ F, t ∈ E) ∧ ∀ s ∈ F, ∀ t ∈ F, s ≠ t → δ ≤ |s - t| with hPdef
  set N : ℕ := ⌊1 / δ⌋₊ + 1 with hNdef
  -- every admissible family has at most `N` elements
  have hbdd : ∀ F : Finset ℝ, P F → F.card ≤ N := by
    intro F hF
    have hmapsto : ∀ t ∈ F, ⌊(t - 1) / δ⌋₊ ∈ Finset.range N := by
      intro t ht
      have hmem := hE (hF.1 t ht)
      rw [Set.mem_Icc] at hmem
      rw [Finset.mem_range, hNdef]
      have h1 : (t - 1) / δ ≤ 1 / δ := by
        refine div_le_div_of_nonneg_right ?_ hδ.le
        linarith [hmem.2]
      have h2 : ⌊(t - 1) / δ⌋₊ ≤ ⌊1 / δ⌋₊ := Nat.floor_le_floor h1
      omega
    have hinj : ∀ s ∈ F, ∀ t ∈ F, ⌊(s - 1) / δ⌋₊ = ⌊(t - 1) / δ⌋₊ → s = t := by
      intro s hs t ht heq
      by_contra hne
      have hsep := hF.2 s hs t ht hne
      have hmems := hE (hF.1 s hs)
      have hmemt := hE (hF.1 t ht)
      rw [Set.mem_Icc] at hmems hmemt
      have hs0 : (0 : ℝ) ≤ (s - 1) / δ := by
        refine div_nonneg ?_ hδ.le
        linarith [hmems.1]
      have ht0 : (0 : ℝ) ≤ (t - 1) / δ := by
        refine div_nonneg ?_ hδ.le
        linarith [hmemt.1]
      have hsf := Nat.floor_le hs0
      have htf := Nat.floor_le ht0
      have hsf' := Nat.lt_floor_add_one ((s - 1) / δ)
      have htf' := Nat.lt_floor_add_one ((t - 1) / δ)
      rw [heq] at hsf hsf'
      have hlt : |(s - 1) / δ - (t - 1) / δ| < 1 := by
        rw [abs_lt]
        constructor
        · linarith
        · linarith
      have hdiv : (s - 1) / δ - (t - 1) / δ = (s - t) / δ := by
        field_simp
        ring
      rw [hdiv, abs_div, abs_of_pos hδ, div_lt_one hδ] at hlt
      linarith
    have hcard := Finset.card_le_card_of_injOn (fun t => ⌊(t - 1) / δ⌋₊) hmapsto
      (fun s hs t ht h => hinj s hs t ht h)
    simpa using hcard
  -- pick an admissible family of maximal cardinality
  set Q : ℕ → Prop := fun n => ∃ F : Finset ℝ, P F ∧ F.card = n with hQdef
  have hQ0 : Q 0 := ⟨∅, ⟨by simp, by simp⟩, by simp⟩
  have hk := Nat.findGreatest_spec (P := Q) (m := 0) (n := N) (Nat.zero_le _) hQ0
  obtain ⟨F0, hF0P, hF0card⟩ := hk
  have hmax : ∀ F : Finset ℝ, P F → F.card ≤ Nat.findGreatest Q N := by
    intro F hF
    exact Nat.le_findGreatest (hbdd F hF) ⟨F, hF, rfl⟩
  refine ⟨F0, hF0P.1, hF0P.2, ?_⟩
  intro t htE
  by_contra hcon
  push Not at hcon
  have hgt : ∀ t' ∈ F0, δ < |t - t'| := by
    intro t' ht'
    exact hcon t' ht'
  have hnotmem : t ∉ F0 := by
    intro hmem
    have h := hgt t hmem
    rw [sub_self, abs_zero] at h
    linarith
  have hins : P (insert t F0) := by
    refine ⟨?_, ?_⟩
    · intro u hu
      rcases Finset.mem_insert.mp hu with h | h
      · rw [h]; exact htE
      · exact hF0P.1 u h
    · intro u hu v hv huv
      rcases Finset.mem_insert.mp hu with hu1 | hu2
      · rcases Finset.mem_insert.mp hv with hv1 | hv2
        · exact absurd (hu1.trans hv1.symm) huv
        · rw [hu1]
          exact le_of_lt (hgt v hv2)
      · rcases Finset.mem_insert.mp hv with hv1 | hv2
        · rw [hv1, abs_sub_comm]
          exact le_of_lt (hgt u hu2)
        · exact hF0P.2 u hu2 v hv2 huv
  have hcard : (insert t F0).card = F0.card + 1 := Finset.card_insert_of_notMem hnotmem
  have hle := hmax (insert t F0) hins
  rw [hcard, hF0card] at hle
  omega

/-- The cardinality bound coming from an interval count at a scale at least `1/2`. -/
theorem card_le_of_isIntervalCount {Efin : Finset ℝ} {dl N : ℝ} (hdl : 1 / 2 ≤ dl)
    (hsub : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2) (h : IsIntervalCount Efin dl N) :
    (Efin.card : ℝ) ≤ 3 * N := by
  classical
  set A : Finset ℝ := Efin.filter (fun t => (1 : ℝ) ≤ t ∧ t < 1 + dl) with hA
  set B : Finset ℝ := Efin.filter (fun t => 1 + dl ≤ t ∧ t < 1 + dl + dl) with hB
  set C : Finset ℝ := Efin.filter (fun t => 1 + dl + dl ≤ t ∧ t < 1 + dl + dl + dl) with hC
  have hcover : Efin ⊆ A ∪ B ∪ C := by
    intro t ht
    have h12 := hsub t ht
    rcases lt_or_ge t (1 + dl) with h1 | h1
    · exact Finset.mem_union_left _ (Finset.mem_union_left _
        (Finset.mem_filter.mpr ⟨ht, h12.1, h1⟩))
    · rcases lt_or_ge t (1 + dl + dl) with h2 | h2
      · exact Finset.mem_union_left _ (Finset.mem_union_right _
          (Finset.mem_filter.mpr ⟨ht, h1, h2⟩))
      · refine Finset.mem_union_right _ (Finset.mem_filter.mpr ⟨ht, h2, ?_⟩)
        linarith [h12.2]
  have hcardle : Efin.card ≤ A.card + B.card + C.card := by
    refine le_trans (Finset.card_le_card hcover) ?_
    refine le_trans (Finset.card_union_le _ _) ?_
    exact Nat.add_le_add_right (Finset.card_union_le _ _) _
  have hAle : (A.card : ℝ) ≤ N := h 1
  have hBle : (B.card : ℝ) ≤ N := by
    have h1 := h (1 + dl)
    have heq : Efin.filter (fun t => 1 + dl ≤ t ∧ t < 1 + dl + dl) = B := by rw [hB]
    rw [heq] at h1
    exact h1
  have hCle : (C.card : ℝ) ≤ N := by
    have h1 := h (1 + dl + dl)
    have heq : Efin.filter (fun t => 1 + dl + dl ≤ t ∧ t < 1 + dl + dl + dl) = C := by rw [hC]
    rw [heq] at h1
    exact h1
  have hcast : (Efin.card : ℝ) ≤ (A.card : ℝ) + (B.card : ℝ) + (C.card : ℝ) := by
    exact_mod_cast hcardle
  linarith

theorem IsIntervalCount.mono {Efin : Finset ℝ} {δ N N' : ℝ} (h : IsIntervalCount Efin δ N)
    (hNN : N ≤ N') : IsIntervalCount Efin δ N' := fun c => le_trans (h c) hNN

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The counting data of the discretization.**  A set of radii with a subpower Assouad cover
bound has, at every dyadic scale, a `2^{-j}`-net whose interval counts are the ones required by
Proposition 3.1. -/
theorem exists_net_counting_data {E : Set ℝ} {gam eta C : ℝ}
    (hE : E ⊆ Set.Icc (1 : ℝ) 2) (hcov : HasSubpowerAssouadCoverBound E gam eta C)
    (hCnn : 0 ≤ C) (hgamhalf : 1 / 2 ≤ gam) {j : ℕ} (hj : 1 ≤ j) :
    ∃ (Efin : Finset ℝ) (Na : ℝ) (Mc : ℕ),
      1 ≤ Na ∧ Na ≤ 6 + 6 * C * (2 : ℝ) ^ ((j : ℝ) * eta)
      ∧ 2 * Mc ≤ j ∧ (j : ℤ) ≤ 2 * (Mc : ℤ) + 1
      ∧ (∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
      ∧ (∀ t ∈ E, ∃ t' ∈ Efin, |t - t'| ≤ (2 : ℝ) ^ (-(j : ℤ)))
      ∧ (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam)
      ∧ (∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
          (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam))) := by
  classical
  have hgam : (0 : ℝ) ≤ gam := by linarith
  have hδpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  obtain ⟨Efin, hEmem, hsep, hdense⟩ := exists_delta_net hE hδpos
  set Mc : ℕ := j / 2 with hMcdef
  have hMc : 2 * Mc ≤ j := by
    rw [hMcdef]
    omega
  have hMc2 : (j : ℤ) ≤ 2 * (Mc : ℤ) + 1 := by
    have h1 : j ≤ 2 * Mc + 1 := by
      rw [hMcdef]
      omega
    exact_mod_cast h1
  have hE1 : ∀ t ∈ Efin, 1 ≤ t := fun t ht => (hE (hEmem t ht)).1
  have hE2 : ∀ t ∈ Efin, t ≤ 2 := fun t ht => (hE (hEmem t ht)).2
  set Na0 : ℝ := 2 + 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) with hNa0
  have hpow : (0 : ℝ) < (2 : ℝ) ^ ((j : ℝ) * eta) := Real.rpow_pos_of_pos (by norm_num) _
  have hNa0one : 1 ≤ Na0 := by
    rw [hNa0]
    have h1 : (0 : ℝ) ≤ 2 * C * (2 : ℝ) ^ ((j : ℝ) * eta) := by positivity
    linarith
  set Na : ℝ := 3 * Na0 with hNadef
  have hNaone : 1 ≤ Na := by
    rw [hNadef]
    linarith
  have hcount0 : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
      (Na0 * (2 : ℝ) ^ (2 * (k : ℝ) * gam)) := by
    intro k hk
    have hkj : 2 * k ≤ j := by omega
