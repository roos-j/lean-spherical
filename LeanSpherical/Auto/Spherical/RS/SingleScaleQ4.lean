/-- **The dyadic maximal operator is dominated by the majorants of the three waves.** -/
theorem enorm_fractalDyadicBandpassMaximal_le {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (j : ℕ) {E : Set ℝ} (hE : E ⊆ Set.Icc (1 : ℝ) 2) (f : SchwartzMap Pl ℂ)
    {Wout Win Wmid : Pl → ℝ≥0∞}
    (hout : ∀ x : Pl,
      (⨆ t : E, ‖waveInt hφone hφzero CoordinateWavePart.outgoing j t.1 f x‖ₑ) ≤ Wout x)
    (hin : ∀ x : Pl,
      (⨆ t : E, ‖waveInt hφone hφzero CoordinateWavePart.incoming j t.1 f x‖ₑ) ≤ Win x)
    (hmid : ∀ x : Pl,
      (⨆ t : E, ‖waveInt hφone hφzero CoordinateWavePart.middle j t.1 f x‖ₑ) ≤ Wmid x)
    (x : Pl) :
    ‖fractalDyadicBandpassMaximal 2 E (absoluteDyadicBandpass φ hφone hφzero j) f x‖ₑ
      ≤ ‖((surfaceMass 2)⁻¹ : ℝ)‖ₑ * (Wout x + Win x + Wmid x) := by
  classical
  refine le_trans (enorm_toReal_le _) ?_
  change (⨆ t : E, ENNReal.ofReal ‖normalizedSphericalAverage 2
      ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
        SchwartzMap Pl ℂ) : Pl → ℂ) t.1 x‖)
    ≤ ‖((surfaceMass 2)⁻¹ : ℝ)‖ₑ * (Wout x + Win x + Wmid x)
  refine iSup_le fun t => ?_
  have ht : 0 < t.1 := lt_of_lt_of_le zero_lt_one (hE t.2).1
  have hrepr := sphericalAverage_bandpass_eq_wave_sum hφone hφzero j ht f x
  have hnorm : ENNReal.ofReal ‖normalizedSphericalAverage 2
      ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
        SchwartzMap Pl ℂ) : Pl → ℂ) t.1 x‖
      = ‖((surfaceMass 2)⁻¹ : ℝ)‖ₑ
        * ‖sphericalAverage 2 ((dyadicBandpassProjection
            (absoluteDyadicBandpass φ hφone hφzero j) f : SchwartzMap Pl ℂ) : Pl → ℂ) t.1 x‖ₑ := by
    rw [ofReal_norm, normalizedSphericalAverage, enorm_mul]
    congr 1
    rw [← ofReal_norm, ← ofReal_norm, norm_inv, norm_inv, Complex.norm_real]
  rw [hnorm]
  refine mul_le_mul' (le_refl _) ?_
  rw [hrepr]
  refine le_trans (le_trans (enorm_add_le _ _) (add_le_add (enorm_add_le _ _) (le_refl _))) ?_
  refine add_le_add (add_le_add ?_ ?_) ?_
  · exact le_trans (le_iSup
      (fun t' : E => ‖waveInt hφone hφzero CoordinateWavePart.outgoing j t'.1 f x‖ₑ) t) (hout x)
  · exact le_trans (le_iSup
      (fun t' : E => ‖waveInt hφone hφzero CoordinateWavePart.incoming j t'.1 f x‖ₑ) t) (hin x)
  · exact le_trans (le_iSup
      (fun t' : E => ‖waveInt hφone hφzero CoordinateWavePart.middle j t'.1 f x‖ₑ) t) (hmid x)

/-! ### The §3 constant as a real number -/

/-- The real number underlying the §3 constant. -/
noncomputable def c3R (Cs CV Cst Na B0 B0' : ℝ) (j Mc Mk L : ℕ) (p gam : ℝ) : ℝ :=
  (8 * ((Mc : ℝ) + 2) ^ 2
      * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) ^ (1 / p)
    * (700000000 * (1 + stC) * B0 * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1)))
        ^ (2 * (1 - 2 / p))
    * (Auto.HardyLittlewoodSobolev.hlsConst (2 * (2 * gam - 1) / (1 + 2 * gam))) ^ (1 - 1 / p)

theorem hlsConst_nonneg {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1) :
    0 ≤ Auto.HardyLittlewoodSobolev.hlsConst (2 * (2 * gam - 1) / (1 + 2 * gam)) := by
  set lam : ℝ := 2 * (2 * gam - 1) / (1 + 2 * gam) with hlam
  have hden : (0 : ℝ) < 1 + 2 * gam := by linarith
  have hlam0 : 0 < lam := by
    rw [hlam]
    refine div_pos (by linarith) hden
  have hlam1 : lam < 1 := by
    rw [hlam, div_lt_one hden]
    linarith
  have h1 : (2 : ℝ) ^ (-(lam / (2 - lam))) < 1 :=
    Auto.HardyLittlewoodSobolev.two_rpow_neg_lt_one_hls hlam0 hlam1
  have h2 : (0 : ℝ) < 1 - (2 : ℝ) ^ (-(lam / (2 - lam))) := by linarith
  rw [Auto.HardyLittlewoodSobolev.hlsConst]
  have h3 : (0 : ℝ) < (1 - lam) * (1 - (2 : ℝ) ^ (-(lam / (2 - lam)))) := by
    refine mul_pos (by linarith) h2
  positivity

