/-- **The single-scale wave estimate.**  Given the `L^{p₄} → L^{q₄}` bound `K` for the sector
operator, the `part`-wave of the dyadic spherical average obeys the same bound with the constant
`N · 2^{-(j+1)/2} · K`. -/
theorem lintegral_pow_iSup_waveInt_le {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) {ε : ℝ} {j : ℕ} {mdot msym : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ}
    (hm : MultData (j + 1) msym m2 B0)
    (hmt : MultData (j + 1) (mtil ε msym mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => msym s ω) (mdot t ω) t)
    (hsum : ∀ t : ℝ, 1 ≤ t → t ≤ 2 → ∀ ξ : Pl, (∑ ν ∈ Finset.range Nsec,
        mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ))
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
        * (planarCoordinateWaveRadialTerm part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ))
    {E : Set ℝ} (hE : E ⊆ Set.Icc (1 : ℝ) 2) {p : ℝ} (hp : 2 < p) {K : ℝ≥0∞}
    (hK : ∀ g : SchwartzMap Pl ℂ,
      (∫⁻ x : Pl, (⨆ t : E, ‖(TopS hm ε t.1 g : Pl → ℂ) x‖ₑ) ^ (2 * p)) ^ (1 / (2 * p))
        ≤ K * (∫⁻ x : Pl, ‖(g : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p))
    (f : SchwartzMap Pl ℂ) :
    ∃ W : Pl → ℝ≥0∞, Measurable W
      ∧ (∀ x : Pl, (⨆ t : E, ‖waveInt hφone hφzero part j t.1 f x‖ₑ) ≤ W x)
      ∧ (∫⁻ x : Pl, W x ^ (2 * p)) ^ (1 / (2 * p))
        ≤ (Nsec : ℝ≥0∞) * ENNReal.ofReal ((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹) * K
          * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  classical
  have hq0 : (0 : ℝ) < 2 * p := by linarith
  have hq1 : (1 : ℝ) ≤ 2 * p := by linarith
  set c : ℝ≥0∞ := ENNReal.ofReal ((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹) with hcdef
  have hctop : c ≠ ⊤ := by
    rw [hcdef]
    exact ENNReal.ofReal_ne_top
  -- the sector maximal functions
  set g : ℕ → Pl → ℝ≥0∞ := fun ν x =>
    c * ⨆ t : E, ‖(TopS hm ε t.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
      (rotF (-((ν : ℝ) * hsec)) x)‖ₑ with hgdef
  have hgmeas' : ∀ ν : ℕ, Measurable (g ν) := by
    intro ν
    rw [hgdef]
    refine Measurable.const_mul ?_ c
    exact (measurable_iSup_TopS hm hmt hmd E (rotSch ((ν : ℝ) * hsec) f)).comp
      (continuous_rotF (-((ν : ℝ) * hsec))).measurable
  have hgmeas : ∀ ν ∈ Finset.range Nsec, AEMeasurable (g ν) (volume : Measure Pl) :=
    fun ν _ => (hgmeas' ν).aemeasurable
  -- step 1: the pointwise bound
  have hpt : ∀ x : Pl, (⨆ t : E, ‖waveInt hφone hφzero part j t.1 f x‖ₑ)
      ≤ (∑ ν ∈ Finset.range Nsec, g ν) x := by
    intro x
    refine iSup_le fun t => ?_
    have ht1 : (1 : ℝ) ≤ t.1 := (hE t.2).1
    have ht2 : t.1 ≤ 2 := (hE t.2).2
    rw [waveInt_eq_sector_sum hφone hφzero part hm (hsum t.1 ht1 ht2) f x]
    rw [Finset.sum_apply]
    calc ‖(((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ) * ∑ ν ∈ Finset.range Nsec,
            (TopS hm ε t.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
              (rotF (-((ν : ℝ) * hsec)) x)‖ₑ
        = c * ‖∑ ν ∈ Finset.range Nsec,
            (TopS hm ε t.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
              (rotF (-((ν : ℝ) * hsec)) x)‖ₑ := by
          have hcval : ‖(((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)‖ₑ = c := by
            rw [hcdef, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
              abs_of_nonneg (by positivity : (0 : ℝ) ≤ (Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹)]
          rw [enorm_mul, hcval]
      _ ≤ c * ∑ ν ∈ Finset.range Nsec,
            ‖(TopS hm ε t.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
              (rotF (-((ν : ℝ) * hsec)) x)‖ₑ := by
          exact mul_le_mul' (le_refl c) (enorm_sum_le _ _)
      _ = ∑ ν ∈ Finset.range Nsec, c *
            ‖(TopS hm ε t.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
              (rotF (-((ν : ℝ) * hsec)) x)‖ₑ := by
          rw [Finset.mul_sum]
      _ ≤ ∑ ν ∈ Finset.range Nsec, g ν x := by
          refine Finset.sum_le_sum fun ν _ => ?_
          rw [hgdef]
          refine mul_le_mul' (le_refl c) ?_
          exact le_iSup (fun t' : E => ‖(TopS hm ε t'.1 (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ)
            (rotF (-((ν : ℝ) * hsec)) x)‖ₑ) t
  refine ⟨∑ ν ∈ Finset.range Nsec, g ν, ?_, hpt, ?_⟩
  · have hfun : (∑ ν ∈ Finset.range Nsec, g ν)
        = fun x : Pl => ∑ ν ∈ Finset.range Nsec, g ν x := by
      funext x
      exact Finset.sum_apply x (Finset.range Nsec) g
    rw [hfun]
    exact Finset.measurable_sum _ fun ν _ => hgmeas' ν
  -- step 2: Minkowski over the sectors
  have hstep2 : (∫⁻ x : Pl, ((∑ ν ∈ Finset.range Nsec, g ν) x) ^ (2 * p)) ^ (1 / (2 * p))
      ≤ ∑ ν ∈ Finset.range Nsec, (∫⁻ x : Pl, g ν x ^ (2 * p)) ^ (1 / (2 * p)) :=
    lintegral_rpow_finset_sum_le _ g hgmeas hq1
  refine le_trans hstep2 ?_
  -- step 3: each sector term
  have hterm : ∀ ν ∈ Finset.range Nsec, (∫⁻ x : Pl, g ν x ^ (2 * p)) ^ (1 / (2 * p))
      ≤ c * K * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
    intro ν _
    set α : ℝ := (ν : ℝ) * hsec with hαdef
    have hmeasG : Measurable fun y : Pl =>
        (⨆ t : E, ‖(TopS hm ε t.1 (rotSch α f) : Pl → ℂ) y‖ₑ) ^ (2 * p) :=
      (measurable_iSup_TopS hm hmt hmd E (rotSch α f)).pow_const _
    have hchange : (∫⁻ x : Pl,
        (⨆ t : E, ‖(TopS hm ε t.1 (rotSch α f) : Pl → ℂ) (rotF (-α) x)‖ₑ) ^ (2 * p))
        = ∫⁻ y : Pl, (⨆ t : E, ‖(TopS hm ε t.1 (rotSch α f) : Pl → ℂ) y‖ₑ) ^ (2 * p) :=
      lintegral_comp_rotF (-α) hmeasG
    have hg : (∫⁻ x : Pl, g ν x ^ (2 * p)) ^ (1 / (2 * p))
        = c * (∫⁻ y : Pl, (⨆ t : E, ‖(TopS hm ε t.1 (rotSch α f) : Pl → ℂ) y‖ₑ) ^ (2 * p))
          ^ (1 / (2 * p)) := by
      rw [hgdef]
      rw [lintegral_rpow_const_mul hctop _ hq0, hchange]
    rw [hg]
    refine le_trans (mul_le_mul' (le_refl c) (hK (rotSch α f))) ?_
    rw [lintegral_enorm_rpow_rotSch α f]
    rw [mul_assoc]
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [Finset.sum_const, Finset.card_range, nsmul_eq_mul]
  exact le_of_eq (by ring)

/-! ### Monotonicity of the §3 constant -/

theorem KP31_nonneg (Cs CV Cst : ℝ) : 0 ≤ KP31 Cs CV Cst := by
  rw [KP31]
  have h1 : (0 : ℝ) ≤ (1 + 192 * Cst) ^ 2 := sq_nonneg _
  have h2 : (0 : ℝ) ≤ 12 * 2 ^ 83 + 2 ^ 34 + 36 * c0far Cs CV ^ 2 * 2 ^ 25 := by
    have := sq_nonneg (c0far Cs CV)
    positivity
  positivity

/-- **The §3 constant is monotone in the counting constant and in the number of shells.** -/
theorem C3_mono {Cs CV Cst Na Na' B0 B0' : ℝ} {j Mc Mc' Mk L : ℕ} {p gam : ℝ}
    (hp : 2 < p) (hNa : 0 ≤ Na) (hNaNa' : Na ≤ Na') (hMc : Mc ≤ Mc') :
    C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam
      ≤ C3 Cs CV Cst Na' B0 B0' j Mc' Mk L p gam := by
  have hppos : (0 : ℝ) < p := by linarith
  have h1p : (0 : ℝ) ≤ 1 / p := by positivity
  have hKP : (0 : ℝ) ≤ KP31 Cs CV Cst := KP31_nonneg Cs CV Cst
  have hb2 : (0 : ℝ) ≤ (4 * B0' ^ 2) ^ 2 := by positivity
  have hMcR : ((Mc : ℝ) + 2) ^ 2 ≤ ((Mc' : ℝ) + 2) ^ 2 := by
    have hle : (Mc : ℝ) ≤ (Mc' : ℝ) := by exact_mod_cast hMc
    nlinarith [hle]
  rw [C3, C3]
  refine mul_le_mul' (mul_le_mul' ?_ (le_refl _)) (le_refl _)
  refine ENNReal.rpow_le_rpow ?_ h1p
  refine mul_le_mul' (le_refl _) (ENNReal.ofReal_le_ofReal ?_)
  have hbig : (0 : ℝ) ≤ KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 := by positivity
  have hpow : (0 : ℝ) ≤ ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by positivity
  have hstep1 : KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2
      ≤ KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na' * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
    refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hNaNa' hbig) hpow
  have hNa'nn : (0 : ℝ) ≤ Na' := le_trans hNa hNaNa'
  have hrhs : (0 : ℝ) ≤ KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na' * ((2 : ℝ) ^ (j : ℤ)) ^ 2 := by
    positivity
  calc 2 * ((Mc : ℝ) + 2) ^ 2
        * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)
      ≤ 2 * ((Mc : ℝ) + 2) ^ 2
        * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na' * ((2 : ℝ) ^ (j : ℤ)) ^ 2) := by
        refine mul_le_mul_of_nonneg_left hstep1 (by positivity)
    _ ≤ 2 * ((Mc' : ℝ) + 2) ^ 2
        * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na' * ((2 : ℝ) ^ (j : ℤ)) ^ 2) := by
        refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hMcR (by norm_num)) hrhs

/-! ### The single-scale estimate for one coordinate wave, with the §3 constant -/

/-- The plate parameters, together with the size bounds needed to estimate the §3 constant. -/
theorem exists_plate_params_sized (j : ℕ) :
    ∃ Mk L : ℕ, 1 ≤ Mk ∧ (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100
      ∧ 2 * (Mk : ℤ) ≤ (j : ℤ) + 14 ∧ (j : ℤ) ≤ 2 * (Mk : ℤ)
      ∧ ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L
      ∧ (2 : ℝ) ^ Mk ≤ 256 * ((2 : ℝ) ^ (j : ℤ)) ^ ((1 : ℝ) / 2)
      ∧ 10 * ((L : ℝ) + 1) + 1 ≤ 5 * (j : ℝ) + 111 := by
  obtain ⟨Mk, L, h1, h2, h3, h4, h5⟩ := exists_plate_params j
  refine ⟨max 7 ((j + 1) / 2), max 7 ((j + 1) / 2) + 2, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · exact le_trans (by norm_num) (le_max_left _ _)
  · have h7 : (7 : ℤ) ≤ (max 7 ((j + 1) / 2) : ℕ) := by
      have : 7 ≤ max 7 ((j + 1) / 2) := le_max_left _ _
      exact_mod_cast this
    have hle : (2 : ℝ) ^ (-((max 7 ((j + 1) / 2) : ℕ) : ℤ)) ≤ (2 : ℝ) ^ (-(7 : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    refine le_trans hle ?_
    norm_num
  · have hh1 : 2 * max 7 ((j + 1) / 2) ≤ j + 14 := by omega
    exact_mod_cast hh1
  · have hh1 : j ≤ 2 * max 7 ((j + 1) / 2) := by omega
    exact_mod_cast hh1
  · refine Int.ceil_le.mpr ?_
    have hpi : π ≤ 4 := by
      have h := Real.pi_lt_d2
      linarith
    have hpow : (0 : ℝ) < (2 : ℝ) ^ (max 7 ((j + 1) / 2)) := by positivity
    have hh1 : π * (2 : ℝ) ^ (max 7 ((j + 1) / 2))
        ≤ 4 * (2 : ℝ) ^ (max 7 ((j + 1) / 2)) :=
      mul_le_mul_of_nonneg_right hpi hpow.le
    refine le_trans hh1 (le_of_eq ?_)
    push_cast
    rw [pow_add]
    ring
  · -- the size bound for `2^{Mk}`
    have hMkle : (max 7 ((j + 1) / 2) : ℕ) ≤ 7 + (j + 1) / 2 := by omega
    have ha : (2 : ℝ) ^ (max 7 ((j + 1) / 2) : ℕ) ≤ (2 : ℝ) ^ (7 + (j + 1) / 2 : ℕ) :=
      pow_le_pow_right₀ (by norm_num) hMkle
    have hb : (2 : ℝ) ^ (7 + (j + 1) / 2 : ℕ) = 128 * (2 : ℝ) ^ ((j + 1) / 2 : ℕ) := by
      rw [pow_add]
      norm_num
    have hexp : (((j + 1) / 2 : ℕ) : ℝ) ≤ (j : ℝ) / 2 + 1 := by
      have hnat : 2 * ((j + 1) / 2) ≤ j + 2 := by omega
      have : ((2 * ((j + 1) / 2) : ℕ) : ℝ) ≤ ((j + 2 : ℕ) : ℝ) := by exact_mod_cast hnat
      push_cast at this
      linarith
    have hc : (2 : ℝ) ^ ((j + 1) / 2 : ℕ) ≤ 2 * ((2 : ℝ) ^ (j : ℤ)) ^ ((1 : ℝ) / 2) := by
      have hz : ((2 : ℝ) ^ (j : ℤ)) ^ ((1 : ℝ) / 2) = (2 : ℝ) ^ ((j : ℝ) / 2) := by
        rw [← Real.rpow_intCast (2 : ℝ) (j : ℤ), ← Real.rpow_mul (by norm_num)]
        congr 1
        push_cast
        ring
      have hnat : (2 : ℝ) ^ ((j + 1) / 2 : ℕ) = (2 : ℝ) ^ ((((j + 1) / 2 : ℕ) : ℝ)) := by
        rw [Real.rpow_natCast]
      rw [hz, hnat]
      have hmono : (2 : ℝ) ^ ((((j + 1) / 2 : ℕ) : ℝ)) ≤ (2 : ℝ) ^ ((j : ℝ) / 2 + 1) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) hexp
      refine le_trans hmono (le_of_eq ?_)
      rw [Real.rpow_add (by norm_num), Real.rpow_one]
      ring
    calc (2 : ℝ) ^ (max 7 ((j + 1) / 2) : ℕ) ≤ 128 * (2 : ℝ) ^ ((j + 1) / 2 : ℕ) := by
          rw [← hb]; exact ha
      _ ≤ 128 * (2 * ((2 : ℝ) ^ (j : ℤ)) ^ ((1 : ℝ) / 2)) := by
          exact mul_le_mul_of_nonneg_left hc (by norm_num)
      _ = 256 * ((2 : ℝ) ^ (j : ℤ)) ^ ((1 : ℝ) / 2) := by ring
  · -- the size bound for `L`
    have hnat : 10 * (max 7 ((j + 1) / 2) + 2) + 11 ≤ 5 * j + 111 := by omega
    have hR := (Nat.cast_le (α := ℝ)).mpr hnat
    push_cast at hR ⊢
    linarith

noncomputable def shrC : ℝ := Classical.choose exists_shrinkS_deriv_bound

theorem one_le_shrC : 1 ≤ shrC := (Classical.choose_spec exists_shrinkS_deriv_bound).1

theorem abs_deriv_shrinkS_le (x : ℝ) : |deriv shrinkS x| ≤ shrC :=
  (Classical.choose_spec exists_shrinkS_deriv_bound).2 x

noncomputable def uvC : ℝ := Classical.choose (exists_unitVec_bound 1)

theorem one_le_uvC : 1 ≤ uvC := (Classical.choose_spec (exists_unitVec_bound 1)).1

theorem norm_iteratedFDeriv_unitVec_le (i : Fin 2) (n : ℕ) (hn : n ≤ 1) (ζ : Pl) :
    ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ uvC :=
  (Classical.choose_spec (exists_unitVec_bound 1)).2 i n hn ζ

/-- The uniform §3 constant at the scale `j`, for the sector multiplier with symbol bounds
`B` and dilation-derivative bounds `Bt · 2^{j+1}`. -/
noncomputable def KQ4 (Cass eta B Bt : ℝ) (j Mk L : ℕ) (p gam : ℝ) : ℝ≥0∞ :=
  (C3 shrC uvC stC (6 + 6 * Cass * (2 : ℝ) ^ (((j + 1 : ℕ) : ℝ) * eta)) (384 * B) B
      (j + 1) ((j + 1) / 2) Mk L p gam) ^ ((1 : ℝ) / 2)
    + ENNReal.ofReal (2 * (2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)))
      * (C3 shrC uvC stC (6 + 6 * Cass * (2 : ℝ) ^ (((j + 1 : ℕ) : ℝ) * eta))
          (384 * (Bt * (2 : ℝ) ^ (j + 1))) (Bt * (2 : ℝ) ^ (j + 1))
          (j + 1) ((j + 1) / 2) Mk L p gam) ^ ((1 : ℝ) / 2)

