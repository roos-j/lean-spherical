/-- **The multiplier data of a rescaled fixed-scale symbol.**  If `g` is a smooth symbol whose
derivatives up to order three are bounded by `B`, and if the rescaled symbol
`ω ↦ g (2^{-j}ω)` is supported in the sector `Θ_j`, then it satisfies `MultData` with the
constant `B`. -/
theorem multData_of_rescaled {g : ℝ → Pl → ℂ} {B : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (g t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), g t ((2 : ℝ) ^ (-(j : ℤ)) • ω) ≠ 0 → ω ∈ Theta j)
    (hbd : ∀ n ≤ 3, ∀ (t : ℝ) (v : Pl), ‖iteratedFDeriv ℝ n (g t) v‖ ≤ B) :
    MultData j (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (m2can (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))) B := by
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  refine multData_of_bounds ?_ hsupp ?_
  · intro t
    exact (hsmooth t).comp (contDiff_const_smul _)
  · intro n hn t ω
    refine le_trans (norm_iteratedFDeriv_rescale (hsmooth t) hcpos.le n ω) ?_
    have h1 : ((2 : ℝ) ^ (-(j : ℤ))) ^ n = (2 : ℝ) ^ (-((n : ℤ) * (j : ℤ))) := by
      rw [← zpow_natCast ((2 : ℝ) ^ (-(j : ℤ))) n, ← zpow_mul]
      congr 1
      ring
    rw [h1]
    exact mul_le_mul_of_nonneg_right (hbd n hn t _) (by positivity)

/-! ### Building the polar data from derivative bounds -/

theorem contDiff_mk2_pair : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : ℝ × ℝ => mk2 q.1 q.2 := by
  change ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : ℝ × ℝ =>
    q.1 • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
      + q.2 • EuclideanSpace.single (1 : Fin 2) (1 : ℝ)
  exact (contDiff_fst.smul contDiff_const).add (contDiff_snd.smul contDiff_const)

theorem contDiff_pt_radial (φ : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) fun r : ℝ => pt r φ := by
  change ContDiff ℝ (↑(⊤ : ℕ∞)) fun r : ℝ => mk2 (r * Real.cos φ) (r * Real.sin φ)
  exact contDiff_mk2_pair.comp
    ((contDiff_id.mul contDiff_const).prodMk (contDiff_id.mul contDiff_const))

theorem contDiff_pt_angular (r : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ : ℝ => pt r φ := by
  change ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ : ℝ => mk2 (r * Real.cos φ) (r * Real.sin φ)
  exact contDiff_mk2_pair.comp
    ((contDiff_const.mul Real.contDiff_cos).prodMk (contDiff_const.mul Real.contDiff_sin))

/-- The canonical radial data of a multiplier. -/
noncomputable def mrcan (m : ℝ → Pl → ℂ) (k : ℕ) (t φ r : ℝ) : ℂ :=
  iteratedDeriv k (fun r' : ℝ => m t (pt r' φ)) r

/-- The canonical angular data of a multiplier. -/
noncomputable def macan (m : ℝ → Pl → ℂ) (k : ℕ) (t r φ : ℝ) : ℂ :=
  iteratedDeriv k (fun φ' : ℝ => m t (pt r φ')) φ

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The polar data from radial and angular derivative bounds.** -/
theorem polarData_of_bounds {m : ℝ → Pl → ℂ} {B0 : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (m t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), m t ω ≠ 0 → ω ∈ Theta j)
    (hrb : ∀ k ≤ 4, ∀ (t φ r : ℝ),
      ‖mrcan m k t φ r‖ ≤ B0 * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))))
    (hab : ∀ k ≤ 3, ∀ (t r φ : ℝ), ‖macan m k t r φ‖ ≤ B0) :
    PolarData j m (mrcan m) (macan m) B0 := by
  have hrad : ∀ (t φ : ℝ), ContDiff ℝ (↑(⊤ : ℕ∞)) fun r' : ℝ => m t (pt r' φ) := by
    intro t φ
    exact (hsmooth t).comp (contDiff_pt_radial φ)
  have hang : ∀ (t r : ℝ), ContDiff ℝ (↑(⊤ : ℕ∞)) fun φ' : ℝ => m t (pt r φ') := by
    intro t r
    exact (hsmooth t).comp (contDiff_pt_angular r)
  have hvanish : ∀ (t φ r' : ℝ), |r'| < (2 : ℝ) ^ ((j : ℤ) - 1) → m t (pt r' φ) = 0 := by
    intro t φ r' hr'
    by_contra hcon
    have hmem := hsupp t (pt r' φ) hcon
    have hnorm : ‖pt r' φ‖ = |r'| := norm_pt_abs r' φ
    have h := hmem.2.2.1
    rw [hnorm] at h
    linarith
  have hvanishbig : ∀ (t φ r' : ℝ), (2 : ℝ) ^ ((j : ℤ) + 1) < |r'| → m t (pt r' φ) = 0 := by
    intro t φ r' hr'
    by_contra hcon
    have hmem := hsupp t (pt r' φ) hcon
    have hnorm : ‖pt r' φ‖ = |r'| := norm_pt_abs r' φ
    have h := hmem.2.2.2
    rw [hnorm] at h
    linarith
  refine ⟨?_, ?_, ?_, hrb, ?_, ?_, ?_, ?_, hab⟩
  · intro t φ r
    rw [mrcan, iteratedDeriv_zero]
  · intro k hk t φ r
    have hdiff : Differentiable ℝ (iteratedDeriv k fun r' : ℝ => m t (pt r' φ)) :=
      ContDiff.differentiable_iteratedDeriv k (hrad t φ)
        (by exact_mod_cast (ENat.coe_lt_top k))
    have hderiv := (hdiff r).hasDerivAt
    have heq : mrcan m (k + 1) t φ r = deriv (iteratedDeriv k fun r' : ℝ => m t (pt r' φ)) r := by
      rw [mrcan, iteratedDeriv_succ]
    rw [heq]
    exact hderiv
  · intro k hk t φ
    exact ContDiff.continuous_iteratedDeriv k (hrad t φ)
      (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))
  · -- the radial data vanishes at the origin and beyond the annulus
    intro k hk t φ r hr
    rcases hr with hr0 | hrbig
    · have hev : (fun r' : ℝ => m t (pt r' φ)) =ᶠ[nhds r] (fun _ : ℝ => (0 : ℂ)) := by
        have hball : Metric.ball r ((2 : ℝ) ^ ((j : ℤ) - 1)) ∈ nhds r :=
          Metric.ball_mem_nhds r (by positivity)
        filter_upwards [hball] with r' hr'
        rw [Metric.mem_ball, Real.dist_eq, hr0] at hr'
        refine hvanish t φ r' ?_
        simpa using hr'
      rw [mrcan, hev.iteratedDeriv_eq k]
      simp
    · have hev : (fun r' : ℝ => m t (pt r' φ)) =ᶠ[nhds r] (fun _ : ℝ => (0 : ℂ)) := by
        have hnhds : Set.Ioi ((2 : ℝ) ^ ((j : ℤ) + 1)) ∈ nhds r :=
          isOpen_Ioi.mem_nhds hrbig
        filter_upwards [hnhds] with r' hr'
        refine hvanishbig t φ r' ?_
        rw [Set.mem_Ioi] at hr'
        have hpos : (0 : ℝ) < r' := lt_trans (by positivity) hr'
        rw [abs_of_pos hpos]
        exact hr'
      rw [mrcan, hev.iteratedDeriv_eq k]
      simp
  · intro t r φ
    rw [macan, iteratedDeriv_zero]
  · intro k hk t r φ
    have hdiff : Differentiable ℝ (iteratedDeriv k fun φ' : ℝ => m t (pt r φ')) :=
      ContDiff.differentiable_iteratedDeriv k (hang t r)
        (by exact_mod_cast (ENat.coe_lt_top k))
    have hderiv := (hdiff φ).hasDerivAt
    have heq : macan m (k + 1) t r φ
        = deriv (iteratedDeriv k fun φ' : ℝ => m t (pt r φ')) φ := by
      rw [macan, iteratedDeriv_succ]
    rw [heq]
    exact hderiv
  · intro k hk t r
    exact ContDiff.continuous_iteratedDeriv k (hang t r)
      (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))

/-! ### Polar coordinates of a planar vector -/

theorem pt_add_int_mul_two_pi (r φ : ℝ) (n : ℤ) : pt r (φ + n * (2 * π)) = pt r φ := by
  rw [pt, pt, Real.cos_add_int_mul_two_pi, Real.sin_add_int_mul_two_pi]

theorem exists_pt_of_norm_one {v : Pl} (hv : ‖v‖ = 1) : ∃ φ : ℝ, v = pt 1 φ := by
  set z : ℂ := (v 0 : ℂ) + (v 1 : ℂ) * Complex.I with hz
  have hre : z.re = v 0 := by
    rw [hz]
    simp
  have him : z.im = v 1 := by
    rw [hz]
    simp
  have hnorm : ‖z‖ = 1 := by
    have h1 : ‖z‖ = Real.sqrt (z.re ^ 2 + z.im ^ 2) := Complex.norm_eq_sqrt_sq_add_sq z
    rw [h1, hre, him, ← norm_sq_two v, hv]
    norm_num
  have hzne : z ≠ 0 := by
    intro hcon
    rw [hcon] at hnorm
    simp at hnorm
  refine ⟨Complex.arg z, ?_⟩
  have hcos : Real.cos (Complex.arg z) = v 0 := by
    rw [Complex.cos_arg hzne, hnorm, hre, div_one]
  have hsin : Real.sin (Complex.arg z) = v 1 := by
    rw [Complex.sin_arg, hnorm, him, div_one]
  rw [pt, hcos, hsin, one_mul, one_mul]
  exact (mk2_coords v).symm

theorem unitVec_pt_one (i : Fin 2) (φ : ℝ) : unitVec i (pt 1 φ) = (pt 1 φ) i := by
  have hnorm : ‖pt 1 φ‖ = 1 := norm_pt_one φ
  have hsq : ‖pt 1 φ‖ ^ 2 = 1 := by
    rw [hnorm]
    norm_num
  rw [unitVec, hsq, gsm_eq_inv_sqrt (by norm_num) (by norm_num)]
  norm_num

theorem unitVec_pt_one_zero (φ : ℝ) : unitVec 0 (pt 1 φ) = Real.cos φ := by
  rw [unitVec_pt_one, pt, mk2_apply_zero, one_mul]

theorem unitVec_pt_one_one (φ : ℝ) : unitVec 1 (pt 1 φ) = Real.sin φ := by
  rw [unitVec_pt_one, pt, mk2_apply_one, one_mul]

/-! ### The angular sector cutoff -/

/-- The bump in the first unit coordinate: supported in `[2^{-14}, 3·2^{-14}]`, positive on the
interior of that interval. -/
def angB (s : ℝ) : ℝ :=
  Real.smoothTransition ((2 : ℝ) ^ (14 : ℕ) * s - 1)
    * Real.smoothTransition (3 - (2 : ℝ) ^ (14 : ℕ) * s)

theorem contDiff_angB : ContDiff ℝ (↑(⊤ : ℕ∞)) angB :=
  (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub (contDiff_const.mul contDiff_id)))

theorem angB_nonneg (s : ℝ) : 0 ≤ angB s :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem angB_le_one (s : ℝ) : angB s ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem angB_pos {s : ℝ} (h1 : (2 : ℝ) ^ (14 : ℕ) * s > 1) (h2 : (2 : ℝ) ^ (14 : ℕ) * s < 3) :
    0 < angB s :=
  mul_pos (Real.smoothTransition.pos_of_pos (by linarith))
    (Real.smoothTransition.pos_of_pos (by linarith))

theorem angB_eq_zero_of_le {s : ℝ} (h : (2 : ℝ) ^ (14 : ℕ) * s ≤ 1) : angB s = 0 := by
  rw [angB, Real.smoothTransition.zero_of_nonpos (by linarith), zero_mul]

theorem angB_eq_zero_of_ge {s : ℝ} (h : 3 ≤ (2 : ℝ) ^ (14 : ℕ) * s) : angB s = 0 := by
  have hz : Real.smoothTransition (3 - (2 : ℝ) ^ (14 : ℕ) * s) = 0 :=
    Real.smoothTransition.zero_of_nonpos (by linarith)
  rw [angB, hz, mul_zero]

/-- The bump in the second unit coordinate: `0` for `s ≤ 1/4`, `1` for `s ≥ 3/8`. -/
def angC (s : ℝ) : ℝ := Real.smoothTransition (8 * s - 2)

theorem contDiff_angC : ContDiff ℝ (↑(⊤ : ℕ∞)) angC :=
  contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)

theorem angC_nonneg (s : ℝ) : 0 ≤ angC s := Real.smoothTransition.nonneg _

theorem angC_le_one (s : ℝ) : angC s ≤ 1 := Real.smoothTransition.le_one _

theorem angC_eq_one {s : ℝ} (h : 3 / 8 ≤ s) : angC s = 1 := by
  rw [angC, Real.smoothTransition.one_of_one_le (by linarith)]

theorem angC_eq_zero_of_le {s : ℝ} (h : s ≤ 1 / 4) : angC s = 0 := by
  rw [angC, Real.smoothTransition.zero_of_nonpos (by linarith)]

theorem angC_pos {s : ℝ} (h : 1 / 4 < s) : 0 < angC s :=
  Real.smoothTransition.pos_of_pos (by linarith)

/-- The sector cutoff: a smooth function of the direction, supported in the narrow sector. -/
def secCut (v : Pl) : ℝ := angB (unitVec 0 v) * angC (unitVec 1 v)

theorem contDiff_secCut : ContDiff ℝ (↑(⊤ : ℕ∞)) secCut :=
  (contDiff_angB.comp (contDiff_unitVec 0)).mul (contDiff_angC.comp (contDiff_unitVec 1))

theorem secCut_nonneg (v : Pl) : 0 ≤ secCut v :=
  mul_nonneg (angB_nonneg _) (angC_nonneg _)

theorem secCut_le_one (v : Pl) : secCut v ≤ 1 := by
  refine le_trans (mul_le_one₀ (angB_le_one _) (angC_nonneg _) (angC_le_one _)) ?_
  norm_num

theorem secCut_pt_one (φ : ℝ) : secCut (pt 1 φ) = angB (Real.cos φ) * angC (Real.sin φ) := by
  rw [secCut, unitVec_pt_one_zero, unitVec_pt_one_one]

/-- On the annulus where the smooth unit vector field is the true one, the sector cutoff is
supported in the narrow sector. -/
theorem mem_sector_of_secCut_ne_zero {v : Pl} (h1 : (1 : ℝ) / 8 < ‖v‖ ^ 2)
    (h2 : ‖v‖ ^ 2 < 8) (h : secCut v ≠ 0) :
    0 < v 0 ∧ v 0 < (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := by
  have hnormpos : (0 : ℝ) < ‖v‖ := by
    nlinarith [norm_nonneg v]
  have hpow : (0 : ℝ) < (2 : ℝ) ^ (14 : ℕ) := by positivity
  have hgsm : gsm (‖v‖ ^ 2) = 1 / Real.sqrt (‖v‖ ^ 2) :=
    gsm_eq_inv_sqrt (by linarith) (by linarith)
  have hsqrt : Real.sqrt (‖v‖ ^ 2) = ‖v‖ := Real.sqrt_sq (norm_nonneg v)
  have hu0 : unitVec 0 v = v 0 / ‖v‖ := by
    rw [unitVec, hgsm, hsqrt]
    ring
  have hu1 : unitVec 1 v = v 1 / ‖v‖ := by
    rw [unitVec, hgsm, hsqrt]
    ring
  have hB : angB (unitVec 0 v) ≠ 0 := by
    intro hc
    rw [secCut, hc, zero_mul] at h
    exact h rfl
  have hC : angC (unitVec 1 v) ≠ 0 := by
    intro hc
    rw [secCut, hc, mul_zero] at h
    exact h rfl
  have hB1 : 1 < (2 : ℝ) ^ (14 : ℕ) * (v 0 / ‖v‖) := by
    by_contra hcon
    rw [hu0] at hB
    exact hB (angB_eq_zero_of_le (not_lt.mp hcon))
  have hB2 : (2 : ℝ) ^ (14 : ℕ) * (v 0 / ‖v‖) < 3 := by
    by_contra hcon
    rw [hu0] at hB
    exact hB (angB_eq_zero_of_ge (not_lt.mp hcon))
  have hC1 : (1 : ℝ) / 4 < v 1 / ‖v‖ := by
    by_contra hcon
    rw [hu1] at hC
    exact hC (angC_eq_zero_of_le (not_lt.mp hcon))
  have hquot0 : 0 < v 0 / ‖v‖ := by
    by_contra hcon
    have hle : v 0 / ‖v‖ ≤ 0 := not_lt.mp hcon
    nlinarith [hB1, hle, hpow]
  have hv0 : 0 < v 0 := by
    have heq : v 0 = (v 0 / ‖v‖) * ‖v‖ := by
      field_simp
    rw [heq]
    exact mul_pos hquot0 hnormpos
  have hv1 : 0 < v 1 := by
    have heq : v 1 = (v 1 / ‖v‖) * ‖v‖ := by
      field_simp
    rw [heq]
    exact mul_pos (by linarith) hnormpos
  refine ⟨hv0, ?_⟩
  have h14 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / (2 : ℝ) ^ (14 : ℕ) := by
    rw [zpow_neg, ← zpow_natCast (2 : ℝ) 14]
    norm_num
  have h10 : (2 : ℝ) ^ (-(10 : ℤ)) = 1 / (2 : ℝ) ^ (10 : ℕ) := by
    rw [zpow_neg, ← zpow_natCast (2 : ℝ) 10]
    norm_num
  have hdiv : v 0 / ‖v‖ < 3 / (2 : ℝ) ^ (14 : ℕ) := by
    rw [lt_div_iff₀ hpow]
    nlinarith [hB2]
  have hv0lt : v 0 < 3 / (2 : ℝ) ^ (14 : ℕ) * ‖v‖ := (div_lt_iff₀ hnormpos).mp hdiv
  have hnormlt : ‖v‖ < 4 * v 1 := by
    rw [lt_div_iff₀ hnormpos] at hC1
    linarith
  have hcoef : (3 : ℝ) / (2 : ℝ) ^ (14 : ℕ) * 4 ≤ (2 : ℝ) ^ (-(10 : ℤ)) := by
    rw [h10]
    norm_num
  have hposcoef : (0 : ℝ) < 3 / (2 : ℝ) ^ (14 : ℕ) := by positivity
  calc v 0 < 3 / (2 : ℝ) ^ (14 : ℕ) * ‖v‖ := hv0lt
    _ ≤ 3 / (2 : ℝ) ^ (14 : ℕ) * (4 * v 1) := mul_le_mul_of_nonneg_left hnormlt.le hposcoef.le
    _ = (3 / (2 : ℝ) ^ (14 : ℕ) * 4) * v 1 := by ring
    _ ≤ (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := mul_le_mul_of_nonneg_right hcoef hv1.le

/-! ### The rotated sectors cover the circle -/

/-- The number of sectors. -/
def Nsec : ℕ := 2 ^ 17

/-- The angular spacing of the sectors. -/
noncomputable def hsec : ℝ := 2 * π / (Nsec : ℝ)

theorem Nsec_pos : 0 < Nsec := by
  rw [Nsec]
  norm_num

theorem hsec_pos : 0 < hsec := by
  rw [hsec, Nsec]
  have h := Real.pi_pos
  positivity

theorem hsec_le : hsec ≤ (2 : ℝ) ^ (-(14 : ℤ)) := by
  have hpi : π < 3.15 := Real.pi_lt_d2
  have hN : ((Nsec : ℕ) : ℝ) = 131072 := by
    rw [Nsec]
    norm_num
  rw [hsec, hN, div_le_iff₀ (by norm_num : (0 : ℝ) < 131072)]
  have h2 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / 16384 := by
    norm_num
  rw [h2]
  nlinarith [hpi]

theorem Nsec_hsec : (Nsec : ℝ) * hsec = 2 * π := by
  have hN : ((Nsec : ℕ) : ℝ) ≠ 0 := by
    rw [Nsec]
    norm_num
  rw [hsec]
  field_simp

theorem secCut_pt {r : ℝ} (hr1 : (1 : ℝ) / 8 < r ^ 2) (hr2 : r ^ 2 < 8) (hrpos : 0 < r) (φ : ℝ) :
    secCut (pt r φ) = angB (Real.cos φ) * angC (Real.sin φ) := by
  have hnorm : ‖pt r φ‖ = r := norm_pt r φ hrpos.le
  have hsq : ‖pt r φ‖ ^ 2 = r ^ 2 := by
    rw [hnorm]
  have hgsm : gsm (‖pt r φ‖ ^ 2) = 1 / Real.sqrt (‖pt r φ‖ ^ 2) := by
    rw [hsq]
    exact gsm_eq_inv_sqrt (by linarith) (by linarith)
  have hsqrt : Real.sqrt (‖pt r φ‖ ^ 2) = r := by
    rw [hsq, Real.sqrt_sq hrpos.le]
  have hu0 : unitVec 0 (pt r φ) = Real.cos φ := by
    rw [unitVec, hgsm, hsqrt, pt, mk2_apply_zero]
    field_simp
  have hu1 : unitVec 1 (pt r φ) = Real.sin φ := by
    rw [unitVec, hgsm, hsqrt, pt, mk2_apply_one]
    field_simp
  rw [secCut, hu0, hu1]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The window of the sector cutoff.**  Near `π/2` the cutoff is positive. -/
theorem secCut_pt_pos_of_window {r x : ℝ} (hr1 : (1 : ℝ) / 8 < r ^ 2) (hr2 : r ^ 2 < 8)
    (hrpos : 0 < r) (hx1 : 3 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) ≤ x)
    (hx2 : x ≤ 5 / 2 * (2 : ℝ) ^ (-(14 : ℤ))) :
    0 < secCut (pt r (π / 2 - x)) := by
  have h14 : (2 : ℝ) ^ (-(14 : ℤ)) = 1 / 16384 := by
    norm_num
  rw [h14] at hx1 hx2
  have hxpos : 0 < x := by linarith
  have hxsmall : x ≤ 1 := by linarith
  have hcos : Real.cos (π / 2 - x) = Real.sin x := Real.cos_pi_div_two_sub x
  have hsin : Real.sin (π / 2 - x) = Real.cos x := Real.sin_pi_div_two_sub x
  rw [secCut_pt hr1 hr2 hrpos, hcos, hsin]
  refine mul_pos ?_ ?_
  · -- the first bump is positive
    have hsinlt : Real.sin x < x := Real.sin_lt hxpos
    have hsingt : x - x ^ 3 / 6 < Real.sin x := Real.sin_gt_sub_cube hxpos
    refine angB_pos ?_ ?_
    · have hxsq : x ^ 2 ≤ (5 / 2 / 16384) ^ 2 := by
        nlinarith [hx2, hxpos]
      have hcube : x ^ 3 / 6 ≤ x * ((5 / 2 / 16384) ^ 2 / 6) := by
        nlinarith [hxsq, hxpos]
      have hsinlow : x * (1 - (5 / 2 / 16384) ^ 2 / 6) < Real.sin x := by
        nlinarith [hsingt, hcube]
      have hpow : (2 : ℝ) ^ (14 : ℕ) = 16384 := by norm_num
      rw [hpow]
      nlinarith [hsinlow, hx1]
    · have hpow : (2 : ℝ) ^ (14 : ℕ) = 16384 := by norm_num
      rw [hpow]
      nlinarith [hsinlt, hx2]
  · -- the second bump is positive
    refine angC_pos ?_
    have hcosge : 1 - x ^ 2 / 2 ≤ Real.cos x := Real.one_sub_sq_div_two_le_cos
    nlinarith [hcosge, hxsmall, hxpos]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The rotated sectors cover every direction.** -/
theorem exists_secCut_rot_pos {v : Pl} (h1 : (1 : ℝ) / 8 < ‖v‖ ^ 2) (h2 : ‖v‖ ^ 2 < 8) :
    ∃ ν : ℕ, ν < Nsec ∧ 0 < secCut (rotF (-((ν : ℝ) * hsec)) v) := by
  have hnormpos : (0 : ℝ) < ‖v‖ := by
    nlinarith [norm_nonneg v]
  -- polar coordinates of `v`
  obtain ⟨φ, hφ⟩ : ∃ φ : ℝ, v = pt ‖v‖ φ := by
    have hunit : ‖(‖v‖)⁻¹ • v‖ = 1 := by
      rw [norm_smul, norm_inv, Real.norm_eq_abs, abs_of_pos hnormpos]
      field_simp
    obtain ⟨φ, hφ1⟩ := exists_pt_of_norm_one hunit
    refine ⟨φ, ?_⟩
    have h3 : v = ‖v‖ • ((‖v‖)⁻¹ • v) := by
      rw [smul_smul, mul_inv_cancel₀ hnormpos.ne', one_smul]
    conv_lhs => rw [h3, hφ1]
    rw [← pt_eq_smul]
  -- choose the rotation index
  have hhpos : 0 < hsec := hsec_pos
  set y : ℝ := φ - π / 2 + 2 * (2 : ℝ) ^ (-(14 : ℤ)) with hy
  set k : ℤ := ⌊y / hsec + 1 / 2⌋ with hk
  have hkbound : |(k : ℝ) * hsec - y| ≤ hsec / 2 := by
    have hfl := Int.floor_le (y / hsec + 1 / 2)
    have hfl2 := Int.lt_floor_add_one (y / hsec + 1 / 2)
    rw [abs_le]
    constructor
    · have h4 : (k : ℝ) ≥ y / hsec - 1 / 2 := by
        rw [hk]
        linarith [hfl2]
      have h5 : (k : ℝ) * hsec ≥ (y / hsec - 1 / 2) * hsec :=
        mul_le_mul_of_nonneg_right h4 hhpos.le
      have h6 : (y / hsec - 1 / 2) * hsec = y - hsec / 2 := by
        field_simp
      linarith [h5, h6.le, h6.ge]
    · have h4 : (k : ℝ) ≤ y / hsec + 1 / 2 := by
        rw [hk]
        exact hfl
      have h5 : (k : ℝ) * hsec ≤ (y / hsec + 1 / 2) * hsec :=
        mul_le_mul_of_nonneg_right h4 hhpos.le
      have h6 : (y / hsec + 1 / 2) * hsec = y + hsec / 2 := by
        field_simp
      linarith [h5, h6.le, h6.ge]
  -- the window
  set x : ℝ := (k : ℝ) * hsec - φ + π / 2 with hx
  have hxwin1 : 3 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) ≤ x := by
    have hhalf : hsec / 2 ≤ (2 : ℝ) ^ (-(14 : ℤ)) / 2 := by
      linarith [hsec_le]
    have h7 := (abs_le.mp hkbound).1
    rw [hx, hy] at *
    linarith [h7, hhalf]
  have hxwin2 : x ≤ 5 / 2 * (2 : ℝ) ^ (-(14 : ℤ)) := by
    have hhalf : hsec / 2 ≤ (2 : ℝ) ^ (-(14 : ℤ)) / 2 := by
      linarith [hsec_le]
    have h7 := (abs_le.mp hkbound).2
    rw [hx, hy] at *
    linarith [h7, hhalf]
  -- reduce the index modulo `Nsec`
  set ν : ℕ := (k % (Nsec : ℤ)).toNat with hν
  have hNpos : (0 : ℤ) < (Nsec : ℤ) := by
    have := Nsec_pos
    exact_mod_cast this
  have hmodnn : 0 ≤ k % (Nsec : ℤ) := Int.emod_nonneg k (by exact_mod_cast hNpos.ne')
  have hmodlt : k % (Nsec : ℤ) < (Nsec : ℤ) := Int.emod_lt_of_pos k hNpos
  have hνcast : ((ν : ℕ) : ℤ) = k % (Nsec : ℤ) := by
    rw [hν]
    exact Int.toNat_of_nonneg hmodnn
  have hνlt : ν < Nsec := by
    have hcast : ((ν : ℕ) : ℤ) < (Nsec : ℤ) := by
      rw [hνcast]
      exact hmodlt
    exact_mod_cast hcast
  refine ⟨ν, hνlt, ?_⟩
  -- the rotation by `ν hsec` agrees with the rotation by `k hsec`
  have hdiff : ((k : ℝ) - (ν : ℝ)) = ((k / (Nsec : ℤ) : ℤ) : ℝ) * (Nsec : ℝ) := by
    have h8 : k % (Nsec : ℤ) = k - (Nsec : ℤ) * (k / (Nsec : ℤ)) := Int.emod_def k _
    have h9 : ((ν : ℕ) : ℝ) = ((k % (Nsec : ℤ) : ℤ) : ℝ) := by
      rw [← hνcast]
      norm_num
    rw [h9, h8]
    push_cast
    ring
  have hrot : rotF (-((ν : ℝ) * hsec)) v = pt ‖v‖ (π / 2 - x) := by
    conv_lhs => rw [hφ]
    rw [rotF_pt]
    have hshift : φ + -((ν : ℝ) * hsec) = (π / 2 - x) + ((k / (Nsec : ℤ) : ℤ) : ℝ) * (2 * π) := by
      rw [hx]
      have h11 : ((k : ℝ) - (ν : ℝ)) * hsec
          = ((k / (Nsec : ℤ) : ℤ) : ℝ) * ((Nsec : ℝ) * hsec) := by
        rw [hdiff]
        ring
      rw [Nsec_hsec] at h11
      linarith [h11]
    rw [hshift, pt_add_int_mul_two_pi]
  rw [hrot]
  exact secCut_pt_pos_of_window h1 h2 hnormpos hxwin1 hxwin2

/-! ### The angular partition of unity -/

theorem rotF_neg_two_pi (v : Pl) : rotF (-(2 * π)) v = v := by
  change mk2 (v 0 * Real.cos (-(2 * π)) - v 1 * Real.sin (-(2 * π)))
      (v 0 * Real.sin (-(2 * π)) + v 1 * Real.cos (-(2 * π))) = v
  rw [Real.cos_neg, Real.sin_neg, Real.cos_two_pi, Real.sin_two_pi]
  rw [show v 0 * 1 - v 1 * -0 = v 0 by ring, show v 0 * -0 + v 1 * 1 = v 1 by ring]
  exact mk2_coords v

/-- The radial cutoff of the partition of unity. -/
def annD (v : Pl) : ℝ :=
  Real.smoothTransition (16 * ‖v‖ ^ 2 - 2) * Real.smoothTransition (8 - ‖v‖ ^ 2)

theorem contDiff_annD : ContDiff ℝ (↑(⊤ : ℕ∞)) annD :=
  (contDiff_st.comp ((contDiff_const.mul (contDiff_norm_sq ℝ)).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub (contDiff_norm_sq ℝ)))

theorem annD_nonneg (v : Pl) : 0 ≤ annD v :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem annD_le_one (v : Pl) : annD v ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem annD_eq_one {v : Pl} (h1 : (1 : ℝ) / 2 ≤ ‖v‖) (h2 : ‖v‖ ≤ 2) : annD v = 1 := by
  have hsq1 : (1 : ℝ) / 4 ≤ ‖v‖ ^ 2 := by nlinarith [norm_nonneg v]
  have hsq2 : ‖v‖ ^ 2 ≤ 4 := by nlinarith [norm_nonneg v]
  rw [annD, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem annulus_of_annD_pos {v : Pl} (h : 0 < annD v) :
    (1 : ℝ) / 8 < ‖v‖ ^ 2 ∧ ‖v‖ ^ 2 < 8 := by
  have h1 : Real.smoothTransition (16 * ‖v‖ ^ 2 - 2) ≠ 0 := by
    intro hc
    rw [annD, hc, zero_mul] at h
    exact absurd h (lt_irrefl 0)
  have h2 : Real.smoothTransition (8 - ‖v‖ ^ 2) ≠ 0 := by
    intro hc
    rw [annD, hc, mul_zero] at h
    exact absurd h (lt_irrefl 0)
  constructor
  · by_contra hcon
    exact h1 (Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith))
  · by_contra hcon
    exact h2 (Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith))

theorem annD_rotF (α : ℝ) (v : Pl) : annD (rotF α v) = annD v := by
  rw [annD, annD, norm_rotF]

/-- The sum of the rotated sector cutoffs. -/
noncomputable def Dsum (v : Pl) : ℝ :=
  ∑ ν ∈ Finset.range Nsec, secCut (rotF (-((ν : ℝ) * hsec)) v)

theorem contDiff_Dsum : ContDiff ℝ (↑(⊤ : ℕ∞)) Dsum := by
  refine ContDiff.sum fun ν _ => ?_
  exact contDiff_secCut.comp ((rotCLE (-((ν : ℝ) * hsec))).contDiff)

theorem Dsum_nonneg (v : Pl) : 0 ≤ Dsum v :=
  Finset.sum_nonneg fun _ν _ => secCut_nonneg _

theorem Dsum_pos_of_annD_pos {v : Pl} (h : 0 < annD v) : 0 < Dsum v := by
  obtain ⟨h1, h2⟩ := annulus_of_annD_pos h
  obtain ⟨ν, hν, hpos⟩ := exists_secCut_rot_pos h1 h2
  refine lt_of_lt_of_le hpos ?_
  refine Finset.single_le_sum (f := fun ν : ℕ => secCut (rotF (-((ν : ℝ) * hsec)) v))
    (fun i _ => secCut_nonneg _) ?_
  rw [Finset.mem_range]
  exact hν

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The sum of the rotated sector cutoffs is invariant under a rotation by the spacing. -/
theorem Dsum_rotF_step (v : Pl) : Dsum (rotF (-hsec) v) = Dsum v := by
  set f : ℕ → ℝ := fun ν => secCut (rotF (-((ν : ℝ) * hsec)) v) with hf
  have hterm : ∀ ν : ℕ, secCut (rotF (-((ν : ℝ) * hsec)) (rotF (-hsec) v)) = f (ν + 1) := by
    intro ν
    rw [hf, rotF_rotF]
    congr 2
    push_cast
    ring
  have h2 : f Nsec = f 0 := by
    rw [hf]
    change secCut (rotF (-(((Nsec : ℕ) : ℝ) * hsec)) v)
      = secCut (rotF (-(((0 : ℕ) : ℝ) * hsec)) v)
    have hz : (-(((0 : ℕ) : ℝ) * hsec)) = 0 := by
      push_cast
      ring
    rw [hz, rotF_zero, Nsec_hsec, rotF_neg_two_pi]
  have h1 : (∑ ν ∈ Finset.range Nsec, f (ν + 1)) + f 0
      = (∑ ν ∈ Finset.range Nsec, f ν) + f Nsec := by
    rw [← Finset.sum_range_succ' f Nsec, ← Finset.sum_range_succ f Nsec]
  have h3 : (∑ ν ∈ Finset.range Nsec, f (ν + 1)) = ∑ ν ∈ Finset.range Nsec, f ν := by
    rw [h2] at h1
    linarith
  rw [Dsum, Dsum]
  calc (∑ ν ∈ Finset.range Nsec, secCut (rotF (-((ν : ℝ) * hsec)) (rotF (-hsec) v)))
      = ∑ ν ∈ Finset.range Nsec, f (ν + 1) := Finset.sum_congr rfl fun ν _ => hterm ν
    _ = ∑ ν ∈ Finset.range Nsec, f ν := h3

theorem Dsum_rotF_nat (μ : ℕ) : ∀ v : Pl, Dsum (rotF (-((μ : ℝ) * hsec)) v) = Dsum v := by
  induction μ with
  | zero =>
      intro v
      have hz : (-(((0 : ℕ) : ℝ) * hsec)) = 0 := by
        push_cast
        ring
      rw [hz, rotF_zero]
  | succ n ih =>
      intro v
      have hstep : rotF (-(((n + 1 : ℕ) : ℝ) * hsec)) v
          = rotF (-((n : ℝ) * hsec)) (rotF (-hsec) v) := by
        rw [rotF_rotF]
        congr 2
        push_cast
        ring
      rw [hstep, ih (rotF (-hsec) v), Dsum_rotF_step]

/-- The first cutoff of the angular partition of unity. -/
noncomputable def psiSec (v : Pl) : ℝ := secCut v * annD v / (Dsum v + (1 - annD v))

theorem denom_pos (v : Pl) : 0 < Dsum v + (1 - annD v) := by
  rcases lt_or_eq_of_le (annD_le_one v) with hlt | heq
  · have := Dsum_nonneg v
    linarith
  · have hpos : 0 < annD v := by
      rw [heq]
      norm_num
    have := Dsum_pos_of_annD_pos hpos
    rw [heq]
    linarith

theorem contDiff_psiSec : ContDiff ℝ (↑(⊤ : ℕ∞)) psiSec := by
  refine ContDiff.div (contDiff_secCut.mul contDiff_annD) ?_ ?_
  · exact contDiff_Dsum.add (contDiff_const.sub contDiff_annD)
  · intro v
    exact (denom_pos v).ne'

theorem psiSec_nonneg (v : Pl) : 0 ≤ psiSec v := by
  rw [psiSec]
  exact div_nonneg (mul_nonneg (secCut_nonneg v) (annD_nonneg v)) (denom_pos v).le

theorem psiSec_eq_zero_of_secCut_eq_zero {v : Pl} (h : secCut v = 0) : psiSec v = 0 := by
  rw [psiSec, h, zero_mul, zero_div]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The angular partition of unity.**  On the annulus the rotated cutoffs sum to one. -/
theorem sum_psiSec_rotF {v : Pl} (h1 : (1 : ℝ) / 2 ≤ ‖v‖) (h2 : ‖v‖ ≤ 2) :
    (∑ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v)) = 1 := by
  have hannD : annD v = 1 := annD_eq_one h1 h2
  have hterm : ∀ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v)
      = secCut (rotF (-((ν : ℝ) * hsec)) v) / Dsum v := by
    intro ν _
    rw [psiSec, annD_rotF, Dsum_rotF_nat, hannD]
    norm_num
  rw [Finset.sum_congr rfl hterm, ← Finset.sum_div, ← Dsum]
  have hpos : 0 < Dsum v := by
    refine Dsum_pos_of_annD_pos ?_
    rw [hannD]
    norm_num
  exact div_self hpos.ne'

theorem sector_of_psiSec_ne_zero {v : Pl} (h : psiSec v ≠ 0) :
    (1 : ℝ) / 8 < ‖v‖ ^ 2 ∧ ‖v‖ ^ 2 < 8 ∧ 0 < v 0 ∧ v 0 < (2 : ℝ) ^ (-(10 : ℤ)) * v 1 := by
  have hs : secCut v ≠ 0 := by
    intro hc
    exact h (psiSec_eq_zero_of_secCut_eq_zero hc)
  have ha : annD v ≠ 0 := by
    intro hc
    rw [psiSec, hc, mul_zero, zero_div] at h
    exact h rfl
  have hapos : 0 < annD v := lt_of_le_of_ne (annD_nonneg v) (Ne.symm ha)
  obtain ⟨h1, h2⟩ := annulus_of_annD_pos hapos
  obtain ⟨h3, h4⟩ := mem_sector_of_secCut_ne_zero h1 h2 hs
  exact ⟨h1, h2, h3, h4⟩

/-! ### The radial amplitude of the planar surface wave -/

theorem pi_mul_aux {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3) (hu : 1 ≤ u) :
    (0 : ℝ) < 2 * π * t ∧ 2 * π * t ≤ 6 * π ∧ (1 : ℝ) ≤ 2 * π * t * u
      ∧ u ≤ 2 * π * t * u := by
  have hπ : (3 : ℝ) < π := Real.pi_gt_three
  have hupos : (0 : ℝ) < u := by linarith
  have h1 : (3 : ℝ) ≤ 2 * π * t := by nlinarith
  have h2 : (0 : ℝ) < 2 * π * t := by linarith
  have h3 : 2 * π * t ≤ 6 * π := by nlinarith
  have h4 : 2 * π * t ≤ 2 * π * t * u := by nlinarith
  refine ⟨h2, h3, by linarith, ?_⟩
  nlinarith

theorem sqrt_pow_id {u : ℝ} (hu : 1 ≤ u) (k : ℕ) :
    (Real.sqrt u) ^ (2 * k + 1) = u ^ k * Real.sqrt u := by
  have h1 : (Real.sqrt u) ^ (2 * k + 1) = ((Real.sqrt u) ^ 2) ^ k * Real.sqrt u := by
    rw [← pow_mul, ← pow_succ]
  rw [h1, Real.sq_sqrt (by linarith)]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The `k`-th radial derivative of the planar wave amplitude decays like `u^{-k-1/2}` for
dilations in `[1,2]`, at every order `k`. -/
theorem exists_ampR_decay_order (part : CoordinateWavePart) (k : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ C / (u ^ k * Real.sqrt u) := by
  cases part with
  | outgoing =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_outgoing_decay k
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have habs : |(2 * π * t) * u| = (2 * π * t) * u := by
        rw [abs_of_pos (by nlinarith [hpos, hu])]
      have hlarge : 1 ≤ |(2 * π * t) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hupos : (0 : ℝ) < u := by linarith
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |2 * π * t| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_of_pos hpos]
        exact hle6
      have hden : u ^ k * Real.sqrt u
          ≤ quadraticMomentScale (2 * k) |(2 * π * t) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : Real.sqrt u ≤ Real.sqrt ((2 * π * t) * u) := Real.sqrt_le_sqrt hgeu
        have hpow : (Real.sqrt u) ^ (2 * k + 1) ≤ (Real.sqrt ((2 * π * t) * u)) ^ (2 * k + 1) :=
          pow_le_pow_left₀ (Real.sqrt_nonneg u) hsq _
        rw [← sqrt_pow_id hu k]
        exact hpow
      have hqpos : (0 : ℝ) < quadraticMomentScale (2 * k) |(2 * π * t) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : (0 : ℝ) < Real.sqrt ((2 * π * t) * u) :=
          Real.sqrt_pos.mpr (by nlinarith [hpos, hupos])
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |2 * π * t| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |2 * π * t| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)
  | incoming =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_incoming_decay k
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have hupos : (0 : ℝ) < u := by linarith
      have habs : |(-(2 * π * t)) * u| = (2 * π * t) * u := by
        rw [neg_mul, abs_neg, abs_of_pos (by nlinarith [hpos, hupos])]
      have hlarge : 1 ≤ |(-(2 * π * t)) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |-(2 * π * t)| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_neg, abs_of_pos hpos]
        exact hle6
      have hden : u ^ k * Real.sqrt u
          ≤ quadraticMomentScale (2 * k) |(-(2 * π * t)) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : Real.sqrt u ≤ Real.sqrt ((2 * π * t) * u) := Real.sqrt_le_sqrt hgeu
        have hpow : (Real.sqrt u) ^ (2 * k + 1) ≤ (Real.sqrt ((2 * π * t) * u)) ^ (2 * k + 1) :=
          pow_le_pow_left₀ (Real.sqrt_nonneg u) hsq _
        rw [← sqrt_pow_id hu k]
        exact hpow
      have hqpos : (0 : ℝ) < quadraticMomentScale (2 * k) |(-(2 * π * t)) * u| := by
        rw [quadraticMomentScale, habs]
        have hsq : (0 : ℝ) < Real.sqrt ((2 * π * t) * u) :=
          Real.sqrt_pos.mpr (by nlinarith [hpos, hupos])
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |-(2 * π * t)| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |-(2 * π * t)| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)
  | middle =>
      obtain ⟨C, hC, hbd⟩ :=
        exists_norm_iteratedDeriv_planarCoordinateWaveRadialAmplitude_middle_decay k (k + 1)
      refine ⟨C * (6 * π) ^ k, by positivity, ?_⟩
      intro t u ht1 ht2 hu
      obtain ⟨hpos, hle6, hge1, hgeu⟩ := pi_mul_aux ht1 ht2 hu
      have hupos : (0 : ℝ) < u := by linarith
      have habs : |(2 * π * t) * u| = (2 * π * t) * u := by
        rw [abs_of_pos (by nlinarith [hpos, hupos])]
      have hlarge : 1 ≤ |(2 * π * t) * u| := by
        rw [habs]
        exact hge1
      have h := hbd t u hlarge
      refine le_trans h ?_
      have hsqrtpos : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := by positivity
      have hscale : |2 * π * t| ^ k ≤ (6 * π) ^ k := by
        refine pow_le_pow_left₀ (abs_nonneg _) ?_ k
        rw [abs_of_pos hpos]
        exact hle6
      have hsqrtle : Real.sqrt u ≤ u := by
        nlinarith [Real.sq_sqrt (show (0 : ℝ) ≤ u by linarith), Real.sqrt_nonneg u,
          Real.sqrt_le_sqrt hu, Real.sqrt_one]
      have hden : u ^ k * Real.sqrt u ≤ |(2 * π * t) * u| ^ (k + 1) := by
        rw [habs]
        have h1 : u ^ k * Real.sqrt u ≤ u ^ k * u :=
          mul_le_mul_of_nonneg_left hsqrtle (by positivity)
        have h2 : u ^ k * u = u ^ (k + 1) := by
          rw [pow_succ]
        have h3 : u ^ (k + 1) ≤ ((2 * π * t) * u) ^ (k + 1) := by
          refine pow_le_pow_left₀ (by linarith) hgeu _
        rw [h2] at h1
        linarith
      have hqpos : (0 : ℝ) < |(2 * π * t) * u| ^ (k + 1) := by
        rw [habs]
        positivity
      rw [div_le_div_iff₀ hqpos hdenpos]
      have hstep1 : C * |2 * π * t| ^ k * (u ^ k * Real.sqrt u)
          ≤ C * (6 * π) ^ k * (u ^ k * Real.sqrt u) := by
        have h1 : C * |2 * π * t| ^ k ≤ C * (6 * π) ^ k :=
          mul_le_mul_of_nonneg_left hscale hC.le
        exact mul_le_mul_of_nonneg_right h1 hdenpos.le
      refine le_trans hstep1 ?_
      exact mul_le_mul_of_nonneg_left hden (by positivity)

/-- **The symbol bounds of the planar wave amplitude**, uniform for `k ≤ N`. -/
theorem exists_ampR_decay (part : CoordinateWavePart) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ k ≤ N, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ C / (u ^ k * Real.sqrt u) := by
  induction N with
  | zero =>
      obtain ⟨C, hC, h⟩ := exists_ampR_decay_order part 0
      refine ⟨C, hC, fun k hk => ?_⟩
      have hk0 : k = 0 := by omega
      subst hk0
      exact h
  | succ n ih =>
      obtain ⟨C, hC, h⟩ := ih
      obtain ⟨C', hC', h'⟩ := exists_ampR_decay_order part (n + 1)
      refine ⟨max C C', by positivity, fun k hk t u ht1 ht2 hu => ?_⟩
      have hupos : (0 : ℝ) < u := by linarith
      have hsq : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      have hdenpos : (0 : ℝ) < u ^ k * Real.sqrt u := mul_pos (pow_pos hupos k) hsq
      by_cases heq : k = n + 1
      · subst heq
        refine le_trans (h' t u ht1 ht2 hu) ?_
        gcongr
        exact le_max_right _ _
      · refine le_trans (h k (by omega) t u ht1 ht2 hu) ?_
        gcongr
        exact le_max_left _ _

/-! ### The fixed-scale symbol -/

theorem contDiff_ampR (part : CoordinateWavePart) (a : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ => planarCoordinateWaveRadialAmplitude part a u := by
  cases part with
  | outgoing =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ) * planarEndpointQuadraticIntegral ((2 * π * a) * u)
      exact contDiff_const.mul (contDiff_planarEndpointQuadraticIntegral.comp
        (contDiff_const.mul contDiff_id))
  | incoming =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ) * planarEndpointQuadraticIntegral ((-(2 * π * a)) * u)
      exact contDiff_const.mul (contDiff_planarEndpointQuadraticIntegral.comp
        (contDiff_const.mul contDiff_id))
  | middle =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun u : ℝ =>
        (surfaceMass 1 : ℂ)
          * coordinateMiddleMeridianLocalizedIntegral 0 ((2 * π * a) * u)
      exact contDiff_const.mul
        ((contDiff_coordinateMiddleMeridianLocalizedIntegral 0).comp
          (contDiff_const.mul contDiff_id))

/-- The dilation cutoff: `1` on `[1,2]`, supported in `(1/2, 3)`. -/
def tcut (t : ℝ) : ℝ := Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)

theorem contDiff_tcut : ContDiff ℝ (↑(⊤ : ℕ∞)) tcut :=
  (contDiff_st.comp ((contDiff_const.mul contDiff_id).sub contDiff_const)).mul
    (contDiff_st.comp (contDiff_const.sub contDiff_id))

theorem tcut_eq_one {t : ℝ} (h1 : 1 ≤ t) (h2 : t ≤ 2) : tcut t = 1 := by
  rw [tcut, Real.smoothTransition.one_of_one_le (by linarith),
    Real.smoothTransition.one_of_one_le (by linarith), mul_one]

theorem tcut_nonneg (t : ℝ) : 0 ≤ tcut t :=
  mul_nonneg (Real.smoothTransition.nonneg _) (Real.smoothTransition.nonneg _)

theorem tcut_le_one (t : ℝ) : tcut t ≤ 1 := by
  refine le_trans (mul_le_one₀ (Real.smoothTransition.le_one _)
    (Real.smoothTransition.nonneg _) (Real.smoothTransition.le_one _)) ?_
  norm_num

theorem tcut_mem {t : ℝ} (h : tcut t ≠ 0) : 1 / 2 < t ∧ t < 3 := by
  constructor
  · by_contra hcon
    refine h ?_
    rw [tcut, Real.smoothTransition.zero_of_nonpos (by
      have := not_lt.mp hcon
      linarith), zero_mul]
  · by_contra hcon
    refine h ?_
    have hz : Real.smoothTransition (3 - t) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by
        have := not_lt.mp hcon
        linarith)
    rw [tcut, hz, mul_zero]

/-- The radial cutoff of the dyadic bandpass at the fixed scale: `φ(v) - φ(2v)`. -/
noncomputable def bpCut (φ : SchwartzMap Pl ℂ) (v : Pl) : ℂ :=
  (φ : Pl → ℂ) v - (φ : Pl → ℂ) ((2 : ℝ) • v)

theorem contDiff_bpCut (φ : SchwartzMap Pl ℂ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (bpCut φ) := by
  refine ContDiff.sub (φ.smooth (⊤ : ℕ∞)) ?_
  exact (φ.smooth (⊤ : ℕ∞)).comp (contDiff_const_smul _)

theorem bpCut_eq_zero_of_small {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1) {v : Pl} (h : ‖v‖ ≤ 1 / 2) :
    bpCut φ v = 0 := by
  have h1 : (φ : Pl → ℂ) v = 1 := hφone v (by linarith)
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • v) = 1 := by
    refine hφone _ ?_
    rw [norm_smul, Real.norm_eq_abs]
    have : |(2 : ℝ)| = 2 := by norm_num
    rw [this]
    linarith
  rw [bpCut, h1, h2, sub_self]

theorem bpCut_eq_zero_of_large {φ : SchwartzMap Pl ℂ}
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) {v : Pl} (h : 2 ≤ ‖v‖) :
    bpCut φ v = 0 := by
  have h1 : (φ : Pl → ℂ) v = 0 := hφzero v h
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • v) = 0 := by
    refine hφzero _ ?_
    rw [norm_smul, Real.norm_eq_abs]
    have h3 : |(2 : ℝ)| = 2 := by norm_num
    rw [h3]
    linarith
  rw [bpCut, h1, h2, sub_self]

/-- **The fixed-scale symbol** of the `ν = 0` sector piece of the `part`-wave at scale `J`. -/
noncomputable def gSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((tcut t : ℝ) : ℂ) * bpCut φ v * ((psiSec v : ℝ) : ℂ)
    * planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * nrm v)

theorem contDiff_gSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gSym φ part J t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl =>
      planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * nrm v) :=
    (contDiff_ampR part t).comp (contDiff_const.mul contDiff_nrm)
  have h2 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => ((psiSec v : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp contDiff_psiSec
  exact ((((contDiff_const.mul contDiff_const).mul (contDiff_bpCut φ)).mul h2).mul h1)

/-- The symbol at scale `J` is the rescaling of the fixed-scale symbol. -/
theorem gSym_support {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (t : ℝ) (ω : Pl)
    (h : gSym φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0) : ω ∈ Theta J := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hbp : bpCut φ v ≠ 0 := by
    intro hc
    rw [gSym, hc] at h
    simp at h
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [gSym, hc] at h
    simp at h
  obtain ⟨hs1, hs2, hs3, hs4⟩ := sector_of_psiSec_ne_zero hps
  have hlow : 1 / 2 < ‖v‖ := by
    by_contra hcon
    exact hbp (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
  have hhigh : ‖v‖ < 2 := by
    by_contra hcon
    exact hbp (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))
  -- transfer to `ω`
  have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
  have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
    rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
  have hω0 : v 0 = (2 : ℝ) ^ (-(J : ℤ)) * ω 0 := rfl
  have hω1 : v 1 = (2 : ℝ) ^ (-(J : ℤ)) * ω 1 := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hω0] at hs3
    nlinarith [hs3, hJpos]
  · rw [hω0, hω1] at hs4
    nlinarith [hs4, hJpos]
  · -- `2^{J-1} ≤ ‖ω‖`
    rw [hnormv] at hlow
    have hpow : (2 : ℝ) ^ ((J : ℤ) - 1) = (2 : ℝ) ^ (J : ℤ) / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hlow, hJpos, hid]
  · -- `‖ω‖ ≤ 2^{J+1}`
    rw [hnormv] at hhigh
    have hpow : (2 : ℝ) ^ ((J : ℤ) + 1) = (2 : ℝ) ^ (J : ℤ) * 2 := by
      rw [two_zpow_add]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hhigh, hJpos, hid]

/-! ### Uniform derivative bounds for the fixed-scale symbol -/

theorem exists_iteratedFDeriv_bound {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hsupp : HasCompactSupport f) (n : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ v : Pl, ‖iteratedFDeriv ℝ n f v‖ ≤ C := by
  have hcs : HasCompactSupport (iteratedFDeriv ℝ n f) := hsupp.iteratedFDeriv n
  have hcont : Continuous (iteratedFDeriv ℝ n f) :=
    hf.continuous_iteratedFDeriv (by exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤))
  obtain ⟨C, hC⟩ := hcont.bounded_above_of_compact_support hcs
  refine ⟨max C 1, by positivity, fun v => le_trans (hC v) (le_max_left _ _)⟩

/-- All derivatives up to a given order of a smooth compactly supported function admit a common
bound. -/
theorem exists_iteratedFDeriv_bound_upto {F : Type*} [NormedAddCommGroup F] [NormedSpace ℝ F]
    {f : Pl → F} (hf : ContDiff ℝ (↑(⊤ : ℕ∞)) f) (hsupp : HasCompactSupport f) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i f v‖ ≤ C := by
  induction N with
  | zero =>
      obtain ⟨C, hC, h⟩ := exists_iteratedFDeriv_bound hf hsupp 0
      refine ⟨C, hC, fun i hi v => ?_⟩
      have hi0 : i = 0 := by omega
      subst hi0
      exact h v
  | succ n ih =>
      obtain ⟨C, hC, h⟩ := ih
      obtain ⟨C', hC', h'⟩ := exists_iteratedFDeriv_bound hf hsupp (n + 1)
      refine ⟨max C C', by positivity, fun i hi v => ?_⟩
      by_cases heq : i = n + 1
      · subst heq
        exact le_trans (h' v) (le_max_right _ _)
      · exact le_trans (h i (by omega) v) (le_max_left _ _)

theorem hasCompactSupport_psiSec : HasCompactSupport psiSec := by
  have hsub : Function.support psiSec ⊆ Metric.closedBall (0 : Pl) 3 := by
    intro v hv
    rw [Function.mem_support] at hv
    obtain ⟨h1, h2, -, -⟩ := sector_of_psiSec_ne_zero hv
    rw [Metric.mem_closedBall, dist_zero_right]
    nlinarith [norm_nonneg v]
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Pl) 3) hsub

/-- A uniform bound for the derivatives of the smooth truncated norm, in the shape needed by the
composition estimate. -/
theorem exists_nrm_deriv_bound (N : ℕ) : ∃ D : ℝ, 1 ≤ D ∧ ∀ i : ℕ, 1 ≤ i → i ≤ N →
    ∀ v : Pl, ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i := by
  obtain ⟨C, hC, h⟩ := exists_iteratedFDeriv_bound_upto contDiff_nrm hasCompactSupport_nrm N
  refine ⟨max C 1, le_max_right _ _, fun i hi1 hiN v => ?_⟩
  have hD1 : (1 : ℝ) ≤ max C 1 := le_max_right _ _
  have h1 : (max C 1) ^ (1 : ℕ) ≤ (max C 1) ^ i := pow_le_pow_right₀ hD1 hi1
  rw [pow_one] at h1
  exact le_trans (le_trans (h i hiN v) (le_max_left _ _)) h1

/-- The rescaled radial amplitude of the symbol, as a one-dimensional function. -/
noncomputable def gout (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * planarCoordinateWaveRadialAmplitude part t
    ((2 : ℝ) ^ J * u)

theorem contDiff_gout (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gout part J t) :=
  contDiff_const.mul ((contDiff_ampR part t).comp (contDiff_const.mul contDiff_id))

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The rescaled amplitude has uniformly bounded derivatives** on the annulus: the factor
`2^{J/2}` exactly compensates the `(2^J)^{-1/2}` decay of the amplitude. -/
theorem norm_iteratedDeriv_gout_le {part : CoordinateWavePart} {Camp : ℝ} (hCamp : 0 < Camp)
    {N : ℕ}
    (hamp : ∀ k ≤ N, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ Camp / (u ^ k * Real.sqrt u))
    {J : ℕ} (hJ : 1 ≤ J) {i : ℕ} (hi : i ≤ N) {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3)
    (hu1 : 1 / 2 ≤ u) (_hu2 : u ≤ 2) :
    ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 1) * Camp := by
  have hpowpos : (0 : ℝ) < (2 : ℝ) ^ J := by positivity
  have hpowge : (2 : ℝ) ≤ (2 : ℝ) ^ J := by
    calc (2 : ℝ) = (2 : ℝ) ^ (1 : ℕ) := by norm_num
      _ ≤ (2 : ℝ) ^ J := pow_le_pow_right₀ (by norm_num) hJ
  have hupos : (0 : ℝ) < u := by linarith
  have hprod : (1 : ℝ) ≤ (2 : ℝ) ^ J * u := by nlinarith
  have hsqrtpow : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ J) := Real.sqrt_pos.mpr hpowpos
  -- the iterated derivative of the rescaled amplitude
  have hchain : iteratedDeriv i (gout part J t) u
      = ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((((2 : ℝ) ^ J : ℝ) : ℂ) ^ i
        * iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
            ((2 : ℝ) ^ J * u)) := by
    have hsm : iteratedDeriv i
        (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t ((((2 : ℝ) ^ J : ℝ)) * u'))
        = fun u' : ℝ => (((2 : ℝ) ^ J : ℝ) : ℝ) ^ i •
            iteratedDeriv i (fun w : ℝ => planarCoordinateWaveRadialAmplitude part t w)
              ((((2 : ℝ) ^ J : ℝ)) * u') :=
      iteratedDeriv_comp_const_smul
        ((contDiff_ampR part t).of_le (by exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤))) _
    have hcm : iteratedDeriv i (gout part J t) u
        = ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ)
          * iteratedDeriv i (fun u' : ℝ =>
              planarCoordinateWaveRadialAmplitude part t ((((2 : ℝ) ^ J : ℝ)) * u')) u := by
      refine iteratedDeriv_const_mul _ ?_
      exact (((contDiff_ampR part t).comp (contDiff_const.mul contDiff_id)).of_le
        (by exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤))).contDiffAt
    rw [hcm, hsm]
    simp only [Complex.real_smul]
    push_cast
    ring
  rw [hchain, norm_mul, norm_mul]
  have hnorm1 : ‖((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ)‖ = Real.sqrt ((2 : ℝ) ^ J) := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hsqrtpow]
  have hnorm2 : ‖((((2 : ℝ) ^ J : ℝ)) : ℂ) ^ i‖ = ((2 : ℝ) ^ J) ^ i := by
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, abs_of_pos hpowpos]
  rw [hnorm1, hnorm2]
  -- the amplitude bound at the rescaled radius
  have hbd := hamp i hi t ((2 : ℝ) ^ J * u) ht1 ht2 hprod
  have hsqrtprod : Real.sqrt ((2 : ℝ) ^ J * u)
      = Real.sqrt ((2 : ℝ) ^ J) * Real.sqrt u := Real.sqrt_mul hpowpos.le u
  have hden : ((2 : ℝ) ^ J * u) ^ i * Real.sqrt ((2 : ℝ) ^ J * u)
      = (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J)) * (u ^ i * Real.sqrt u) := by
    rw [hsqrtprod, mul_pow]
    ring
  rw [hden] at hbd
  have hkey : Real.sqrt ((2 : ℝ) ^ J) * (((2 : ℝ) ^ J) ^ i
      * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
          ((2 : ℝ) ^ J * u)‖)
      ≤ Camp / (u ^ i * Real.sqrt u) := by
    have hfac : (0 : ℝ) < ((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J) := by positivity
    have hstep : ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
          ((2 : ℝ) ^ J * u)‖
        ≤ Camp / ((((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J)) * (u ^ i * Real.sqrt u)) := hbd
    have hupow : (0 : ℝ) < u ^ i * Real.sqrt u := by
      have : (0 : ℝ) < Real.sqrt u := Real.sqrt_pos.mpr hupos
      positivity
    rw [div_mul_eq_div_div_swap] at hstep
    calc Real.sqrt ((2 : ℝ) ^ J) * (((2 : ℝ) ^ J) ^ i
          * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
              ((2 : ℝ) ^ J * u)‖)
        = (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J))
            * ‖iteratedDeriv i (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u')
                ((2 : ℝ) ^ J * u)‖ := by ring
      _ ≤ (((2 : ℝ) ^ J) ^ i * Real.sqrt ((2 : ℝ) ^ J))
            * (Camp / (u ^ i * Real.sqrt u) / (((2 : ℝ) ^ J) ^ i
              * Real.sqrt ((2 : ℝ) ^ J))) := by
          exact mul_le_mul_of_nonneg_left hstep hfac.le
      _ = Camp / (u ^ i * Real.sqrt u) := by
          field_simp
  refine le_trans hkey ?_
  -- finally `u ≥ 1/2` gives the numerical constant
  have hsqrtu : (1 : ℝ) / 2 ≤ Real.sqrt u := by
    have h1 : Real.sqrt (1 / 2 : ℝ) ≤ Real.sqrt u := Real.sqrt_le_sqrt hu1
    have h2 : (1 : ℝ) / 2 ≤ Real.sqrt (1 / 2 : ℝ) := by
      have h3 : Real.sqrt (1 / 2 : ℝ) ^ 2 = 1 / 2 := Real.sq_sqrt (by norm_num)
      nlinarith [Real.sqrt_nonneg (1 / 2 : ℝ), h3]
    linarith
  have hui : ((1 : ℝ) / 2) ^ N ≤ u ^ i := by
    have hpow : (1 / 2 : ℝ) ^ i ≤ u ^ i := pow_le_pow_left₀ (by norm_num) hu1 i
    have hmono : ((1 : ℝ) / 2) ^ N ≤ ((1 : ℝ) / 2) ^ i :=
      pow_le_pow_of_le_one (by norm_num) (by norm_num) hi
    linarith
  have hdenpos : (0 : ℝ) < u ^ i * Real.sqrt u :=
    mul_pos (pow_pos hupos i) (Real.sqrt_pos.mpr hupos)
  rw [div_le_iff₀ hdenpos]
  have hmul : ((1 : ℝ) / 2) ^ N * (1 / 2) ≤ u ^ i * Real.sqrt u :=
    mul_le_mul hui hsqrtu (by norm_num) (pow_nonneg hupos.le i)
  have hinv : ((1 : ℝ) / 2) ^ N * (1 / 2) = ((2 : ℝ) ^ (N + 1))⁻¹ := by
    rw [← pow_succ, div_pow, one_pow, one_div]
  calc Camp = (2 : ℝ) ^ (N + 1) * Camp * ((2 : ℝ) ^ (N + 1))⁻¹ := by
        field_simp
    _ ≤ (2 : ℝ) ^ (N + 1) * Camp * (u ^ i * Real.sqrt u) := by
        refine mul_le_mul_of_nonneg_left ?_ (mul_nonneg (by positivity) hCamp.le)
        rw [← hinv]
        exact hmul

/-- The cutoff factor of the fixed-scale symbol. -/
noncomputable def cutF (φ : SchwartzMap Pl ℂ) (v : Pl) : ℂ :=
  bpCut φ v * ((psiSec v : ℝ) : ℂ)

theorem contDiff_cutF (φ : SchwartzMap Pl ℂ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutF φ) :=
  (contDiff_bpCut φ).mul (Complex.ofRealCLM.contDiff.comp contDiff_psiSec)

theorem hasCompactSupport_cutF (φ : SchwartzMap Pl ℂ) : HasCompactSupport (cutF φ) := by
  refine HasCompactSupport.of_support_subset_isCompact (isCompact_closedBall (0 : Pl) 3) ?_
  intro v hv
  rw [Function.mem_support] at hv
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [cutF, hc] at hv
    simp at hv
  obtain ⟨h1, h2, -, -⟩ := sector_of_psiSec_ne_zero hps
  rw [Metric.mem_closedBall, dist_zero_right]
  nlinarith [norm_nonneg v]

theorem exists_cutF_bound (φ : SchwartzMap Pl ℂ) (N : ℕ) :
    ∃ C : ℝ, 0 < C ∧ ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ C :=
  exists_iteratedFDeriv_bound_upto (contDiff_cutF φ) (hasCompactSupport_cutF φ) N

theorem gSym_eq_prod (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    gSym φ part J t = fun v : Pl => ((tcut t : ℝ) : ℂ) * (cutF φ v * gout part J t (nrm v)) := by
  funext v
  rw [gSym, cutF, gout]
  ring

set_option maxHeartbeats 4000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The product bound for the cutoff times a radial profile.**  If the one-dimensional profile
`G` has derivatives up to order `N` bounded by `Cg` on the annulus `1/2 ≤ u ≤ 2`, then the planar
function `w ↦ cutF φ w · G(nrm w)` has Fréchet derivatives up to order `N` bounded uniformly. -/
theorem norm_iteratedFDeriv_cut_mul_comp_le {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    {N : ℕ} {G : ℝ → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {Cg : ℝ} (hCgpos : 0 < Cg)
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i G u‖ ≤ Cg)
    {D : ℝ} (hD1 : 1 ≤ D)
    (hDbd : ∀ i : ℕ, 1 ≤ i → i ≤ N → ∀ v : Pl, ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i)
    {Cc : ℝ} (hCc : 0 < Cc)
    (hcut : ∀ i ≤ N, ∀ v : Pl, ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ Cc)
    {n : ℕ} (hn : n ≤ N) (v : Pl) :
    ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * G (nrm w)) v‖
      ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ) * Cg * D ^ N) := by
  classical
  set Cbig : ℝ := (Nat.factorial N : ℝ) * Cg * D ^ N with hCbig
  have hDpos : (0 : ℝ) < D ^ N := by positivity
  have hCbigpos : 0 < Cbig := by
    rw [hCbig]
    positivity
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  have hcompsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => G (nrm w) :=
    hG.comp contDiff_nrm
  by_cases hv : 1 / 2 ≤ ‖v‖ ∧ ‖v‖ ≤ 2
  · -- the main case: the composition estimate applies
    have hnrmv : nrm v = ‖v‖ := nrm_eq (by linarith [hv.1]) (by linarith [hv.2])
    have hcomp : ∀ m ≤ N, ‖iteratedFDeriv ℝ m (fun w : Pl => G (nrm w)) v‖
        ≤ Cbig := by
      intro m hm
      have hC : ∀ i, i ≤ m → ‖iteratedFDeriv ℝ i G (nrm v)‖ ≤ Cg := by
        intro i hi
        rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, hnrmv]
        exact hGbd i (by omega) ‖v‖ hv.1 hv.2
      have hD' : ∀ i, 1 ≤ i → i ≤ m → ‖iteratedFDeriv ℝ i nrm v‖ ≤ D ^ i := by
        intro i hi1 hi2
        exact hDbd i hi1 (by omega) v
      have hmle : ((m : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
        exact_mod_cast (le_top : ((m : ℕ∞)) ≤ ⊤)
      have h := norm_iteratedFDeriv_comp_le hG contDiff_nrm hmle v hC hD'
      refine le_trans h ?_
      rw [hCbig]
      have hfac : ((Nat.factorial m : ℕ) : ℝ) ≤ ((Nat.factorial N : ℕ) : ℝ) := by
        exact_mod_cast Nat.factorial_le hm
      have hDm : D ^ m ≤ D ^ N := pow_le_pow_right₀ hD1 hm
      calc ((Nat.factorial m : ℕ) : ℝ) * Cg * D ^ m
          ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg * D ^ m := by
            have h1 : ((Nat.factorial m : ℕ) : ℝ) * Cg ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg :=
              mul_le_mul_of_nonneg_right hfac hCgpos.le
            exact mul_le_mul_of_nonneg_right h1 (by positivity)
        _ ≤ ((Nat.factorial N : ℕ) : ℝ) * Cg * D ^ N := by
            refine mul_le_mul_of_nonneg_left hDm ?_
            positivity
    have hprodbd := norm_iteratedFDeriv_mul_le (contDiff_cutF φ) hcompsmooth v hnle
    refine le_trans hprodbd ?_
    have hterm : ∀ i ∈ Finset.range (n + 1),
        (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (cutF φ) v‖
            * ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖
          ≤ (n.choose i : ℝ) * (Cc * Cbig) := by
      intro i hi
      rw [Finset.mem_range] at hi
      have h1 : ‖iteratedFDeriv ℝ i (cutF φ) v‖ ≤ Cc := hcut i (by omega) v
      have h2 : ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖ ≤ Cbig :=
        hcomp (n - i) (by omega)
      have h3 : (0 : ℝ) ≤ (n.choose i : ℝ) := by positivity
      calc (n.choose i : ℝ) * ‖iteratedFDeriv ℝ i (cutF φ) v‖
              * ‖iteratedFDeriv ℝ (n - i) (fun w : Pl => G (nrm w)) v‖
          ≤ (n.choose i : ℝ) * Cc * Cbig := by
            refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
            positivity
        _ = (n.choose i : ℝ) * (Cc * Cbig) := by ring
    refine le_trans (Finset.sum_le_sum hterm) ?_
    rw [← Finset.sum_mul]
    have hchoose : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ)) = (2 : ℝ) ^ n := by
      have h := Nat.sum_range_choose n
      have hcast : (∑ i ∈ Finset.range (n + 1), (n.choose i : ℝ))
          = ((∑ i ∈ Finset.range (n + 1), n.choose i : ℕ) : ℝ) := by
        push_cast
        ring
      rw [hcast, h]
      push_cast
      ring
    rw [hchoose]
    have hpow : (2 : ℝ) ^ n ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hn
    have hprodpos : (0 : ℝ) < Cc * Cbig := by positivity
    calc (2 : ℝ) ^ n * (Cc * Cbig) ≤ (2 : ℝ) ^ N * (Cc * Cbig) :=
          mul_le_mul_of_nonneg_right hpow hprodpos.le
      _ = (2 : ℝ) ^ N * Cc * Cbig := by ring
  · -- off the annulus the cutoff vanishes on a neighbourhood
    have hzero : ∀ᶠ w in nhds v, (fun w : Pl => cutF φ w * G (nrm w)) w
        = (fun _ : Pl => (0 : ℂ)) w := by
      rcases not_and_or.mp hv with hlow | hhigh
      · have hlt : ‖v‖ < 1 / 2 := not_le.mp hlow
        have hball : Metric.ball v (1 / 2 - ‖v‖) ∈ nhds v :=
          Metric.ball_mem_nhds v (by linarith)
        filter_upwards [hball] with w hw
        have hwle : ‖w‖ ≤ 1 / 2 := by
          rw [Metric.mem_ball, dist_eq_norm] at hw
          have h1 : ‖w‖ - ‖v‖ ≤ ‖w - v‖ := norm_sub_norm_le w v
          linarith
        have hbp : bpCut φ w = 0 := bpCut_eq_zero_of_small hφone hwle
        change cutF φ w * G (nrm w) = 0
        rw [cutF, hbp, zero_mul, zero_mul]
      · have hgt : 2 < ‖v‖ := not_le.mp hhigh
        have hball : Metric.ball v (‖v‖ - 2) ∈ nhds v :=
          Metric.ball_mem_nhds v (by linarith)
        filter_upwards [hball] with w hw
        have hwge : 2 ≤ ‖w‖ := by
          rw [Metric.mem_ball, dist_eq_norm] at hw
          have h1 : ‖v‖ - ‖w‖ ≤ ‖v - w‖ := norm_sub_norm_le v w
          have h2 : ‖v - w‖ = ‖w - v‖ := norm_sub_rev v w
          rw [h2] at h1
          linarith
        have hbp : bpCut φ w = 0 := bpCut_eq_zero_of_large hφzero hwge
        change cutF φ w * G (nrm w) = 0
        rw [cutF, hbp, zero_mul, zero_mul]
    have hiter : iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * G (nrm w)) v
        = iteratedFDeriv ℝ n (fun _ : Pl => (0 : ℂ)) v := by
      have hzero' : (fun w : Pl => cutF φ w * G (nrm w))
          =ᶠ[nhdsWithin v Set.univ] (fun _ : Pl => (0 : ℂ)) := by
        rw [nhdsWithin_univ]
        exact hzero
      have hx : (fun w : Pl => cutF φ w * G (nrm w)) v
          = (fun _ : Pl => (0 : ℂ)) v := hzero.self_of_nhds
      have h := hzero'.iteratedFDerivWithin_eq (𝕜 := ℝ) hx n
      rw [iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at h
      exact h
    rw [hiter]
    have hz : iteratedFDeriv ℝ n (fun _ : Pl => (0 : ℂ)) v = 0 := by
      simp
    rw [hz, norm_zero]
    positivity

