/-- **The multiplier data from `iteratedFDeriv` bounds.**  A smooth multiplier supported in the
sector whose derivatives of order at most three gain a factor `2^{-j}` each satisfies
`MultData`. -/
theorem multData_of_bounds {m : ℝ → Pl → ℂ} {B0 : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (m t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), m t ω ≠ 0 → ω ∈ Theta j)
    (hbdi : ∀ n ≤ 3, ∀ (t : ℝ) (ω : Pl),
      ‖iteratedFDeriv ℝ n (m t) ω‖ ≤ B0 * (2 : ℝ) ^ (-((n : ℤ) * (j : ℤ)))) :
    MultData j m (m2can m) B0 := by
  have hfd : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fderiv ℝ (m t)) := by
    intro t
    exact (hsmooth t).fderiv_right (by simp)
  have hfd2 : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (fderiv ℝ (fderiv ℝ (m t))) := by
    intro t
    exact (hfd t).fderiv_right (by simp)
  refine ⟨hsmooth, hsupp, ?_, ?_, ?_, ?_, ?_, hbdi⟩
  · -- the second directional derivative along a line
    intro t ω e e' ρ
    have hcomp : HasDerivAt (fun r : ℝ => fderiv ℝ (m t) (ω + r • e))
        (fderiv ℝ (fderiv ℝ (m t)) (ω + ρ • e) e) ρ :=
      hasDerivAt_line' (hfd t) ω e ρ
    exact (ContinuousLinearMap.apply ℝ ℂ e').hasFDerivAt.comp_hasDerivAt ρ hcomp
  · -- continuity of the second-derivative field
    intro t e e'
    have hcont : Continuous (fderiv ℝ (fderiv ℝ (m t))) := (hfd2 t).continuous
    exact (hcont.clm_apply continuous_const).clm_apply continuous_const
  · -- the sup bound
    intro t ω
    have h := hbdi 0 (by norm_num) t ω
    rw [norm_iteratedFDeriv_zero] at h
    simpa using h
  · -- the first-derivative bound
    intro t ω u hu
    have h := hbdi 1 (by norm_num) t ω
    rw [norm_iteratedFDeriv_one] at h
    have h2 : ‖fderiv ℝ (m t) ω u‖ ≤ ‖fderiv ℝ (m t) ω‖ * ‖u‖ :=
      (fderiv ℝ (m t) ω).le_opNorm u
    rw [hu, mul_one] at h2
    have hexp : (-(((1 : ℕ) : ℤ) * (j : ℤ))) = -(j : ℤ) := by
      push_cast
      ring
    rw [hexp] at h
    exact le_trans h2 h
  · -- the second-derivative bound
    intro t ω e e' he he'
    have h := hbdi 2 (by norm_num) t ω
    have hval : m2can m t ω e e' = iteratedFDeriv ℝ 2 (m t) ω ![e, e'] := by
      rw [m2can, iteratedFDeriv_two_apply]
      norm_num
    have h2 := (iteratedFDeriv ℝ 2 (m t) ω).le_opNorm ![e, e']
    have hprod : (∏ i : Fin 2, ‖(![e, e'] : Fin 2 → Pl) i‖) = 1 := by
      rw [Fin.prod_univ_two]
      norm_num [he, he']
    rw [hprod, mul_one] at h2
    rw [hval]
    have hexp : (-(((2 : ℕ) : ℤ) * (j : ℤ))) = -2 * (j : ℤ) := by
      push_cast
      ring
    rw [hexp] at h
    exact le_trans h2 h

/-! ### Rescaling a fixed-scale symbol -/

theorem norm_iteratedFDeriv_rescale {g : Pl → ℂ} (hg : ContDiff ℝ (↑(⊤ : ℕ∞)) g) {c : ℝ}
    (hc : 0 ≤ c) (n : ℕ) (ω : Pl) :
    ‖iteratedFDeriv ℝ n (fun v : Pl => g (c • v)) ω‖
      ≤ ‖iteratedFDeriv ℝ n g (c • ω)‖ * c ^ n := by
  set Lc : Pl →L[ℝ] Pl := c • ContinuousLinearMap.id ℝ Pl with hLc
  have hLcapp : ∀ v : Pl, Lc v = c • v := by
    intro v
    rw [hLc]
    rfl
  have hnormLc : ‖Lc‖ ≤ c := by
    rw [hLc]
    refine le_trans (norm_smul_le c (ContinuousLinearMap.id ℝ Pl)) ?_
    rw [Real.norm_eq_abs, abs_of_nonneg hc]
    have h1 : ‖ContinuousLinearMap.id ℝ Pl‖ ≤ 1 := ContinuousLinearMap.norm_id_le
    nlinarith [hc, norm_nonneg (ContinuousLinearMap.id ℝ Pl)]
  have hfun : (fun v : Pl => g (c • v)) = g ∘ Lc := by
    funext v
    rw [Function.comp_apply, hLcapp]
  rw [hfun, Lc.iteratedFDeriv_comp_right hg ω
    (by exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤))]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin n, ‖Lc‖) = ‖Lc‖ ^ n := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod, hLcapp ω]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg _)
  exact pow_le_pow_left₀ (norm_nonneg _) hnormLc n

set_option maxHeartbeats 1000000 in
