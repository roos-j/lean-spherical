-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The wave piece is the sum of the rotated sector operators**, given the sector expansion of
the multiplier. -/
theorem waveInt_eq_sector_sum {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) {ε : ℝ} {j : ℕ} {msym : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData (j + 1) msym m2 B0) {t : ℝ}
    (hsum : ∀ ξ : Pl, (∑ ν ∈ Finset.range Nsec,
        mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ))
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
        * (planarCoordinateWaveRadialTerm part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ))
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    waveInt hφone hφzero part j t f x
      = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ) * ∑ ν ∈ Finset.range Nsec,
          (TopS hm ε t (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ) (rotF (-((ν : ℝ) * hsec)) x) := by
  classical
  have hsqrtpos : (0 : ℝ) < Real.sqrt ((2 : ℝ) ^ (j + 1)) := by
    refine Real.sqrt_pos.mpr ?_
    positivity
  -- step 1: each rotated operator as an integral in the original frequency variable
  have hpiece : ∀ α : ℝ,
      (TopS hm ε t (rotSch α f) : Pl → ℂ) (rotF (-α) x)
        = ∫ ξ : Pl, ee (-(inner ℝ x ξ : ℝ))
            * (mfull (j + 1) ε msym t (rotF (-α) ξ) * 𝓕 ((f : Pl → ℂ)) ξ) := by
    intro α
    rw [TopS_eq_integral hm ε t (rotSch α f) (rotF (-α) x)]
    have h := (measurePreserving_rotF α).integral_comp (measurableEmbedding_rotF α)
      (fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-α) ξ) * 𝓕 ((f : Pl → ℂ)) ξ))
    rw [← h]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
    have hinner : (inner ℝ x (rotF α ω) : ℝ) = (inner ℝ (rotF (-α) x) ω : ℝ) := by
      have h1 := inner_rotF (-α) x (rotF α ω)
      rw [rotF_neg_rotF] at h1
      exact h1.symm
    have hrot2 : rotF (-α) (rotF α ω) = ω := rotF_neg_rotF α ω
    have hfour : 𝓕 ((rotSch α f : Pl → ℂ)) ω = 𝓕 ((f : Pl → ℂ)) (rotF α ω) := by
      rw [rotSch_coe]
      exact fourier_comp_rotF α ω
    change ee (-(inner ℝ (rotF (-α) x) ω : ℝ))
        * (mfull (j + 1) ε msym t ω * 𝓕 ((rotSch α f : Pl → ℂ)) ω)
      = ee (-(inner ℝ x (rotF α ω) : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-α) (rotF α ω))
          * 𝓕 ((f : Pl → ℂ)) (rotF α ω))
    rw [hinner, hrot2, hfour]
  have hsumeq : (∑ ν ∈ Finset.range Nsec,
      (TopS hm ε t (rotSch ((ν : ℝ) * hsec) f) : Pl → ℂ) (rotF (-((ν : ℝ) * hsec)) x))
      = ∑ ν ∈ Finset.range Nsec, ∫ ξ : Pl, ee (-(inner ℝ x ξ : ℝ))
          * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
            * 𝓕 ((f : Pl → ℂ)) ξ) :=
    Finset.sum_congr rfl fun ν _ => hpiece ((ν : ℝ) * hsec)
  rw [hsumeq]
  -- step 2: combine the finite sum with the integral
  have hint : ∀ ν ∈ Finset.range Nsec, Integrable (fun ξ : Pl =>
      ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
          * 𝓕 ((f : Pl → ℂ)) ξ)) (volume : Measure Pl) := fun ν _ =>
    integrable_integrand_mfull_rot hm ε t f x _
  rw [← integral_finsetSum _ hint, ← integral_const_mul, waveInt]
  -- step 3: compare the integrands
  refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
  change ee (-(inner ℝ x ξ : ℝ))
      * (planarCoordinateWaveRadialTerm part t ‖ξ‖
        * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ * 𝓕 ((f : Pl → ℂ)) ξ)
    = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ) * ∑ ν ∈ Finset.range Nsec,
        ee (-(inner ℝ x ξ : ℝ))
          * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ)
            * 𝓕 ((f : Pl → ℂ)) ξ)
  have hcancel : (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
      * ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) = 1 := by
    rw [← Complex.ofReal_mul, inv_mul_cancel₀ (ne_of_gt hsqrtpos), Complex.ofReal_one]
  have hpull : (∑ ν ∈ Finset.range Nsec, ee (-(inner ℝ x ξ : ℝ))
        * (mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ) * 𝓕 ((f : Pl → ℂ)) ξ))
      = (ee (-(inner ℝ x ξ : ℝ)) * 𝓕 ((f : Pl → ℂ)) ξ)
        * ∑ ν ∈ Finset.range Nsec,
            mfull (j + 1) ε msym t (rotF (-((ν : ℝ) * hsec)) ξ) := by
    rw [Finset.mul_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    ring
  rw [hpull, hsum ξ]
  calc ee (-(inner ℝ x ξ : ℝ))
        * (planarCoordinateWaveRadialTerm part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ * 𝓕 ((f : Pl → ℂ)) ξ)
      = ((((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
          * ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ))
        * (ee (-(inner ℝ x ξ : ℝ))
          * (planarCoordinateWaveRadialTerm part t ‖ξ‖
            * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ
            * 𝓕 ((f : Pl → ℂ)) ξ)) := by
        rw [hcancel, one_mul]
    _ = (((Real.sqrt ((2 : ℝ) ^ (j + 1)))⁻¹ : ℝ) : ℂ)
        * ((ee (-(inner ℝ x ξ : ℝ)) * 𝓕 ((f : Pl → ℂ)) ξ)
          * (((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
            * (planarCoordinateWaveRadialTerm part t ‖ξ‖
              * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ))) := by
        ring

/-! ### The three wave pieces reassemble the single-scale average -/

theorem fourierInv_eq_ee_Pl (g : Pl → ℂ) (x : Pl) :
    𝓕⁻ g x = ∫ ω : Pl, ee (-(inner ℝ x ω : ℝ)) * g ω := by
  rw [Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  have hinner : (inner ℝ v (-x) : ℝ) = -(inner ℝ x v : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  simp only [hinner]

theorem continuous_waveTerm_norm (part : CoordinateWavePart) (t : ℝ) :
    Continuous fun ω : Pl => planarCoordinateWaveRadialTerm part t ‖ω‖ := by
  have h1 : Continuous fun ρ : ℝ => planarCoordinateWaveRadialTerm part t ρ := by
    rw [show (fun ρ : ℝ => planarCoordinateWaveRadialTerm part t ρ)
        = fun ρ : ℝ => planarCoordinateWaveRadialAmplitude part t ρ
          * oscillatoryExp (coordinateWaveRadialPhase part t) ρ from rfl]
    refine (contDiff_ampR part t).continuous.mul ?_
    have h2 : Continuous fun ρ : ℝ =>
        (((coordinateWaveRadialPhase part t * ρ : ℝ)) : ℂ) * Complex.I :=
      (Complex.continuous_ofReal.comp (continuous_const.mul continuous_id)).mul continuous_const
    exact Complex.continuous_exp.comp h2
  exact h1.comp continuous_norm

/-- The integrand of the `part`-wave piece. -/
noncomputable def waveIntegrand {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) : Pl → ℂ :=
  fun ω : Pl => ee (-(inner ℝ x ω : ℝ))
    * (planarCoordinateWaveRadialTerm part t ‖ω‖
      * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω * 𝓕 ((f : Pl → ℂ)) ω)

theorem waveInt_eq_integral {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    waveInt hφone hφzero part j t f x
      = ∫ ω : Pl, waveIntegrand hφone hφzero part j t f x ω := rfl

theorem integrable_waveInt_integrand {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    Integrable (waveIntegrand hφone hφzero part j t f x) (volume : Measure Pl) := by
  classical
  set G : Pl → ℂ := fun ω : Pl => planarCoordinateWaveRadialTerm part t ‖ω‖
    * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω with hGdef
  have hGcont : Continuous G :=
    (continuous_waveTerm_norm part t).mul
      (absoluteDyadicBandpass φ hφone hφzero j).continuous
  have hGsupp : HasCompactSupport G := by
    refine HasCompactSupport.mul_left ?_
    exact absoluteDyadicBandpass_compact φ hφone hφzero j
  obtain ⟨C, hC⟩ := hGcont.bounded_above_of_compact_support hGsupp
  have hbint : Integrable (fun ω : Pl => C * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul C
  have hcont : Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) * (G ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    have hee : Continuous fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) := by
      have h1 : Continuous fun ω : Pl => -(inner ℝ x ω : ℝ) :=
        (continuous_const.inner continuous_id).neg
      exact continuous_ee.comp h1
    have hfF : Continuous (𝓕 ((f : Pl → ℂ))) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).continuous
    exact hee.mul (hGcont.mul hfF)
  have hgoal : waveIntegrand hφone hφzero part j t f x
      = fun ω : Pl => ee (-(inner ℝ x ω : ℝ)) * (G ω * 𝓕 ((f : Pl → ℂ)) ω) := by
    funext ω
    rw [waveIntegrand, hGdef]
  rw [hgoal]
  refine Integrable.mono' hbint hcont.aestronglyMeasurable ?_
  filter_upwards with ω
  rw [norm_mul, norm_mul, norm_ee, one_mul]
  exact mul_le_mul_of_nonneg_right (hC ω) (norm_nonneg _)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The three coordinate waves reassemble the single-scale dyadic spherical average.** -/
theorem sphericalAverage_bandpass_eq_wave_sum {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (j : ℕ) {t : ℝ} (ht : 0 < t) (f : SchwartzMap Pl ℂ) (x : Pl) :
    sphericalAverage 2 ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
        SchwartzMap Pl ℂ) : Pl → ℂ) t x
      = waveInt hφone hφzero CoordinateWavePart.outgoing j t f x
        + waveInt hφone hφzero CoordinateWavePart.incoming j t f x
        + waveInt hφone hφzero CoordinateWavePart.middle j t f x := by
  classical
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz,
    fourierInv_eq_ee_Pl]
  have hA := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.outgoing j t f x
  have hB := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.incoming j t f x
  have hC := integrable_waveInt_integrand hφone hφzero CoordinateWavePart.middle j t f x
  have hAB : Integrable (fun ω : Pl =>
      waveIntegrand hφone hφzero CoordinateWavePart.outgoing j t f x ω
        + waveIntegrand hφone hφzero CoordinateWavePart.incoming j t f x ω)
      (volume : Measure Pl) := hA.add hB
  have hsplit : ∀ ω : Pl, ee (-(inner ℝ x ω : ℝ))
        * (surfaceFourier 2 (-t • ω)
          * 𝓕 ((dyadicBandpassProjection (absoluteDyadicBandpass φ hφone hφzero j) f :
              SchwartzMap Pl ℂ) : Pl → ℂ) ω)
      = (waveIntegrand hφone hφzero CoordinateWavePart.outgoing j t f x ω
          + waveIntegrand hφone hφzero CoordinateWavePart.incoming j t f x ω)
        + waveIntegrand hφone hφzero CoordinateWavePart.middle j t f x ω := by
    intro ω
    rw [Auto.Spherical.AHRS.fourier_dyadicBandpassProjection,
      surfaceFourier_two_neg_smul_eq_planarCoordinateSurfaceWaveSum ht ω,
      planarCoordinateSurfaceWaveSum_eq_three_radialTerms t ‖ω‖, waveIntegrand, waveIntegrand,
      waveIntegrand]
    ring
  rw [integral_congr_ae (Filter.Eventually.of_forall hsplit), integral_add hAB hC,
    integral_add hA hB, waveInt_eq_integral, waveInt_eq_integral, waveInt_eq_integral]

/-! ### Measurability of the sector maximal functions, and Minkowski for finite sums -/

theorem continuous_TopS_param {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    Continuous fun t : ℝ => (TopS hm ε t f : Pl → ℂ) x :=
  continuous_iff_continuousAt.mpr fun t => (hasDerivAt_TopS hm hmt hmd t f x).continuousAt

theorem measurable_iSup_TopS {j : ℕ} {m mdot : ℝ → Pl → ℂ}
    {m2 m2' : ℝ → Pl → Pl → Pl → ℂ} {B0 B0' : ℝ} {ε : ℝ}
    (hm : MultData j m m2 B0) (hmt : MultData j (mtil ε m mdot) m2' B0')
    (hmd : ∀ (ω : Pl) (t : ℝ), HasDerivAt (fun s : ℝ => m s ω) (mdot t ω) t)
    (E : Set ℝ) (f : SchwartzMap Pl ℂ) :
    Measurable fun x : Pl => ⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ := by
  have hEq : (fun x : Pl => ⨆ t : E, ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ)
      = ⨆ t : E, fun x : Pl => ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ := by
    funext x
    exact (iSup_apply
      (f := fun t : E => fun x : Pl => ‖(TopS hm ε t.1 f : Pl → ℂ) x‖ₑ) (a := x)).symm
  rw [hEq]
  refine measurable_iSup_of_lowerSemicontinuous ?_ ?_
  · intro t
    exact ((TopS hm ε t.1 f : SchwartzMap Pl ℂ).continuous.enorm).measurable
  · intro x
    exact (((continuous_TopS_param hm hmt hmd f x).comp
      continuous_subtype_val).enorm).lowerSemicontinuous

/-- **Minkowski's inequality for a finite sum**, in the extended-nonnegative setting. -/
theorem lintegral_rpow_finset_sum_le {ι : Type*} (s : Finset ι) (g : ι → Pl → ℝ≥0∞)
    (hg : ∀ i ∈ s, AEMeasurable (g i) (volume : Measure Pl)) {r : ℝ} (hr : 1 ≤ r) :
    (∫⁻ x : Pl, (∑ i ∈ s, g i) x ^ r) ^ (1 / r)
      ≤ ∑ i ∈ s, (∫⁻ x : Pl, g i x ^ r) ^ (1 / r) := by
  classical
  have hrpos : (0 : ℝ) < r := by linarith
  induction s using Finset.induction_on with
  | empty =>
      simp only [Finset.sum_empty, Pi.zero_apply, ENNReal.zero_rpow_of_pos hrpos,
        lintegral_zero]
      rw [ENNReal.zero_rpow_of_pos (by positivity : (0 : ℝ) < 1 / r)]
  | insert a s ha ih =>
      have hgs : AEMeasurable (∑ i ∈ s, g i) (volume : Measure Pl) := by
        refine Finset.aemeasurable_sum s fun i hi => hg i (Finset.mem_insert_of_mem hi)
      have hga : AEMeasurable (g a) (volume : Measure Pl) := hg a (Finset.mem_insert_self a s)
      have hsum : (∑ i ∈ insert a s, g i) = g a + ∑ i ∈ s, g i := Finset.sum_insert ha
      rw [hsum, Finset.sum_insert ha]
      refine le_trans (ENNReal.lintegral_Lp_add_le hga hgs hr) ?_
      exact add_le_add (le_refl _) (ih fun i hi => hg i (Finset.mem_insert_of_mem hi))

theorem lintegral_rpow_const_mul {c : ℝ≥0∞} (hc : c ≠ ⊤) (g : Pl → ℝ≥0∞) {r : ℝ}
    (hr : 0 < r) :
    (∫⁻ x : Pl, (c * g x) ^ r) ^ (1 / r) = c * (∫⁻ x : Pl, g x ^ r) ^ (1 / r) := by
  have h1 : ∀ x : Pl, (c * g x) ^ r = c ^ r * g x ^ r := fun x =>
    ENNReal.mul_rpow_of_nonneg _ _ hr.le
  have hcr : c ^ r ≠ ⊤ := by
    exact ENNReal.rpow_ne_top_of_nonneg hr.le hc
  rw [lintegral_congr h1, lintegral_const_mul' _ _ hcr,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0 : ℝ) ≤ 1 / r), ← ENNReal.rpow_mul,
    mul_one_div, div_self hr.ne', ENNReal.rpow_one]

theorem lintegral_enorm_rpow_rotSch (α : ℝ) (f : SchwartzMap Pl ℂ) {r : ℝ} :
    (∫⁻ x : Pl, ‖(rotSch α f : Pl → ℂ) x‖ₑ ^ r) = ∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ r := by
  have hmeas : Measurable fun y : Pl => ‖(f : Pl → ℂ) y‖ₑ ^ r :=
    (f.continuous.enorm.measurable).pow_const r
  have h := lintegral_comp_rotF α hmeas
  rw [← h]
  rfl

