-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The fixed-scale symbol has derivative bounds uniform in the scale and the dilation.** -/
theorem exists_gSym_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (gSym φ part J t) v‖ ≤ B := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part N
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  have hDpos : (0 : ℝ) < D ^ N := by positivity
  refine ⟨(2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 1) * Camp) * D ^ N),
    by positivity, ?_⟩
  intro J hJ n hn t v
  have hcompsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => gout part J t (nrm w) :=
    (contDiff_gout part J t).comp contDiff_nrm
  have hprodsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : Pl => cutF φ w * gout part J t (nrm w) :=
    (contDiff_cutF φ).mul hcompsmooth
  have hsplit : ‖iteratedFDeriv ℝ n (gSym φ part J t) v‖
      = |tcut t| * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ := by
    rw [gSym_eq_prod]
    have hsm : (fun w : Pl => ((tcut t : ℝ) : ℂ) * (cutF φ w * gout part J t (nrm w)))
        = (tcut t) • (fun w : Pl => cutF φ w * gout part J t (nrm w)) := by
      funext w
      rw [Pi.smul_apply, Complex.real_smul]
    have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
      exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
    rw [hsm, iteratedFDeriv_const_smul_apply (hprodsmooth.of_le hnle).contDiffAt, norm_smul,
      Real.norm_eq_abs]
  rw [hsplit]
  by_cases ht : 1 / 2 < t ∧ t < 3
  · have hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 1) * Camp := fun i hi u hu1 hu2 =>
      norm_iteratedDeriv_gout_le hCamp hamp hJ hi ht.1.le ht.2.le hu1 hu2
    have hbd := norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_gout part J t)
      (mul_pos (by positivity) hCamp) hGbd hD1 hDbd hCc hcut hn v
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    calc |tcut t| * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖
        ≤ 1 * ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ :=
          mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
      _ = ‖iteratedFDeriv ℝ n (fun w : Pl => cutF φ w * gout part J t (nrm w)) v‖ := one_mul _
      _ ≤ (2 : ℝ) ^ N * Cc
            * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 1) * Camp) * D ^ N) := hbd
  · have hz : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz, abs_zero, zero_mul]
    positivity

/-! ### Radial and angular derivatives of a planar symbol -/

theorem pt_smul (c r φ : ℝ) : c • pt r φ = pt (c * r) φ := by
  rw [pt_eq_smul r φ, pt_eq_smul (c * r) φ, smul_smul]

/-- Along a unit-speed line through the origin the iterated derivatives of a smooth function are
bounded by its iterated Fréchet derivatives. -/
theorem norm_iteratedDeriv_line_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {e : Pl}
    (he : ‖e‖ = 1) (k : ℕ) (ρ : ℝ) :
    ‖iteratedDeriv k (fun s : ℝ => G (s • e)) ρ‖ ≤ ‖iteratedFDeriv ℝ k G (ρ • e)‖ := by
  set L : ℝ →L[ℝ] Pl := (ContinuousLinearMap.id ℝ ℝ).smulRight e with hL
  have hLapp : ∀ s : ℝ, L s = s • e := fun s => rfl
  have hLnorm : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one fun s => ?_
    rw [hLapp, norm_smul, he, mul_one, one_mul]
  have hfun : (fun s : ℝ => G (s • e)) = G ∘ L := by
    funext s
    rw [Function.comp_apply, hLapp]
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hfun,
    L.iteratedFDeriv_comp_right hG ρ (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))]
  refine le_trans (ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _) ?_
  have hprod : (∏ _i : Fin k, ‖L‖) = ‖L‖ ^ k := by
    rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
  rw [hprod, hLapp ρ]
  exact mul_le_of_le_one_right (norm_nonneg _) (pow_le_one₀ (norm_nonneg _) hLnorm)

/-- The angular derivative of the polar parametrization is the parametrization rotated by a
quarter turn. -/
theorem hasDerivAt_pt_angle (ρ φ : ℝ) :
    HasDerivAt (fun φ' : ℝ => pt ρ φ') (pt ρ (φ + π / 2)) φ := by
  have h1 : HasDerivAt (fun φ' : ℝ => ρ * Real.cos φ') (ρ * (-Real.sin φ)) φ :=
    (Real.hasDerivAt_cos φ).const_mul ρ
  have h2 : HasDerivAt (fun φ' : ℝ => ρ * Real.sin φ') (ρ * Real.cos φ) φ :=
    (Real.hasDerivAt_sin φ).const_mul ρ
  have h := (h1.smul_const (EuclideanSpace.single (0 : Fin 2) (1 : ℝ))).add
    (h2.smul_const (EuclideanSpace.single (1 : Fin 2) (1 : ℝ)))
  have hgoal : (fun φ' : ℝ => pt ρ φ')
      = fun φ' : ℝ => (ρ * Real.cos φ') • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
          + (ρ * Real.sin φ') • EuclideanSpace.single (1 : Fin 2) (1 : ℝ) := by
    funext φ'
    rw [pt, mk2]
  have hval : pt ρ (φ + π / 2)
      = (ρ * (-Real.sin φ)) • EuclideanSpace.single (0 : Fin 2) (1 : ℝ)
        + (ρ * Real.cos φ) • EuclideanSpace.single (1 : Fin 2) (1 : ℝ) := by
    rw [pt, mk2, Real.cos_add_pi_div_two, Real.sin_add_pi_div_two]
  rw [hgoal, hval]
  exact h

theorem iteratedDeriv_pt_angle (ρ : ℝ) (i : ℕ) :
    iteratedDeriv i (fun φ' : ℝ => pt ρ φ') = fun φ : ℝ => pt ρ (φ + (i : ℝ) * (π / 2)) := by
  induction i with
  | zero =>
      funext φ
      rw [iteratedDeriv_zero]
      norm_num
  | succ n ih =>
      funext φ
      rw [iteratedDeriv_succ, ih]
      have h : HasDerivAt (fun φ' : ℝ => pt ρ (φ' + (n : ℝ) * (π / 2)))
          (pt ρ (φ + (n : ℝ) * (π / 2) + π / 2)) φ :=
        HasDerivAt.comp_add_const φ ((n : ℝ) * (π / 2))
          (hasDerivAt_pt_angle ρ (φ + (n : ℝ) * (π / 2)))
      rw [h.deriv]
      congr 1
      push_cast
      ring

/-- **The radial derivatives of a symbol with bounded Fréchet derivatives are bounded.** -/
theorem norm_iteratedDeriv_radial_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {B : ℝ}
    (hbd : ∀ i ≤ 4, ∀ v : Pl, ‖iteratedFDeriv ℝ i G v‖ ≤ B) {k : ℕ} (hk : k ≤ 4) (ρ φ : ℝ) :
    ‖iteratedDeriv k (fun r' : ℝ => G (pt r' φ)) ρ‖ ≤ B := by
  have he : ‖pt 1 φ‖ = 1 := norm_pt 1 φ zero_le_one
  have hfun : (fun r' : ℝ => G (pt r' φ)) = fun s : ℝ => G (s • pt 1 φ) := by
    funext r'
    rw [pt_eq_smul r' φ]
  rw [hfun]
  exact le_trans (norm_iteratedDeriv_line_le hG he k ρ) (hbd k hk _)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The angular derivatives of a compactly supported symbol with bounded Fréchet derivatives
are bounded**, uniformly in the radius: on the support the radius is at most `2`, so the chain
rule loses only a bounded factor. -/
theorem norm_iteratedDeriv_angle_le {G : Pl → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G) {B : ℝ}
    (hbd : ∀ i ≤ 4, ∀ v : Pl, ‖iteratedFDeriv ℝ i G v‖ ≤ B)
    (hzero : ∀ v : Pl, 2 ≤ ‖v‖ → G v = 0)
    {k : ℕ} (hk : k ≤ 4) (ρ φ : ℝ) :
    ‖iteratedDeriv k (fun φ' : ℝ => G (pt ρ φ')) φ‖ ≤ 384 * B := by
  have hB : (0 : ℝ) ≤ B := le_trans (norm_nonneg _) (hbd 0 (by norm_num) 0)
  by_cases hρ : |ρ| ≤ 2
  · -- the main case: the chain rule bound
    have hkle : ((k : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
      exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤)
    have hC : ∀ i, i ≤ k → ‖iteratedFDeriv ℝ i G (pt ρ φ)‖ ≤ B := fun i hi =>
      hbd i (by omega) _
    have hD : ∀ i, 1 ≤ i → i ≤ k →
        ‖iteratedFDeriv ℝ i (fun φ' : ℝ => pt ρ φ') φ‖ ≤ (2 : ℝ) ^ i := by
      intro i hi1 hi2
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, iteratedDeriv_pt_angle, norm_pt_abs]
      have h1 : (2 : ℝ) ^ (1 : ℕ) ≤ (2 : ℝ) ^ i := pow_le_pow_right₀ (by norm_num) hi1
      rw [pow_one] at h1
      linarith
    have h := norm_iteratedFDeriv_comp_le hG (contDiff_pt_angular ρ) hkle φ hC hD
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv] at h
    refine le_trans h ?_
    have hfac : ((Nat.factorial k : ℕ) : ℝ) ≤ 24 := by
      interval_cases k <;> norm_num [Nat.factorial]
    have hpow : (2 : ℝ) ^ k ≤ 16 := by
      interval_cases k <;> norm_num
    calc ((Nat.factorial k : ℕ) : ℝ) * B * (2 : ℝ) ^ k ≤ 24 * B * 16 := by
          have h1 : ((Nat.factorial k : ℕ) : ℝ) * B ≤ 24 * B :=
            mul_le_mul_of_nonneg_right hfac hB
          exact mul_le_mul h1 hpow (by positivity) (by positivity)
      _ = 384 * B := by ring
  · -- off the support the function vanishes identically
    have hfz : (fun φ' : ℝ => G (pt ρ φ')) = fun _ : ℝ => (0 : ℂ) := by
      funext φ'
      refine hzero _ ?_
      rw [norm_pt_abs]
      linarith [not_le.mp hρ]
    rw [hfz]
    have hzz : iteratedDeriv k (fun _ : ℝ => (0 : ℂ)) φ = 0 := by
      simp
    rw [hzz, norm_zero]
    positivity

/-! ### The polar data of a rescaled symbol -/

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The polar data of a rescaled fixed-scale symbol.**  If `g` is smooth, supported in the ball
of radius `2`, with Fréchet derivatives of order at most four bounded by `B`, and if `ω ↦
g(2^{-j}ω)`
is supported in the sector `Θ_j`, then the rescaled symbol satisfies `PolarData`: the rescaling
supplies exactly one factor `2^{-j}` per radial derivative, and the angular derivatives are bounded
because the support forces the radius to be at most `2`. -/
theorem polarData_of_rescaled {g : ℝ → Pl → ℂ} {B : ℝ} {j : ℕ}
    (hsmooth : ∀ t : ℝ, ContDiff ℝ (↑(⊤ : ℕ∞)) (g t))
    (hsupp : ∀ (t : ℝ) (ω : Pl), g t ((2 : ℝ) ^ (-(j : ℤ)) • ω) ≠ 0 → ω ∈ Theta j)
    (hzero : ∀ (t : ℝ) (v : Pl), 2 ≤ ‖v‖ → g t v = 0)
    (hbd : ∀ n ≤ 4, ∀ (t : ℝ) (v : Pl), ‖iteratedFDeriv ℝ n (g t) v‖ ≤ B) :
    PolarData j (fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (mrcan fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω))
      (macan fun t ω => g t ((2 : ℝ) ^ (-(j : ℤ)) • ω)) (384 * B) := by
  have hB : (0 : ℝ) ≤ B := le_trans (norm_nonneg _) (hbd 0 (by norm_num) 0 0)
  have hcpos : (0 : ℝ) < (2 : ℝ) ^ (-(j : ℤ)) := by positivity
  refine polarData_of_bounds ?_ hsupp ?_ ?_
  · intro t
    exact (hsmooth t).comp (contDiff_const_smul _)
  · -- the radial bounds, with one factor `2^{-j}` per derivative
    intro k hk t φ r
    have hFsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun ρ : ℝ => g t (pt ρ φ) :=
      (hsmooth t).comp (contDiff_pt_radial φ)
    have hrw : (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ))
        = fun r' : ℝ => (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r') := by
      funext r'
      rw [pt_smul]
    have hkey : iteratedDeriv k (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ)) r
        = ((2 : ℝ) ^ (-(j : ℤ))) ^ k • iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ))
            ((2 : ℝ) ^ (-(j : ℤ)) * r) := by
      rw [hrw, iteratedDeriv_comp_const_smul
        (hFsmooth.of_le (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤)))]
    change ‖iteratedDeriv k (fun r' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r' φ)) r‖
      ≤ 384 * B * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
    rw [hkey, norm_smul, norm_pow, Real.norm_eq_abs, abs_of_pos hcpos]
    have hpowk : ((2 : ℝ) ^ (-(j : ℤ))) ^ k = (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by
      rw [← zpow_natCast ((2 : ℝ) ^ (-(j : ℤ))) k, ← zpow_mul]
      congr 1
      ring
    rw [hpowk]
    have hbdk : ‖iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r)‖ ≤ B :=
      norm_iteratedDeriv_radial_le (hsmooth t) (fun i hi v => hbd i hi t v) hk _ φ
    have hzpos : (0 : ℝ) < (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by positivity
    calc (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
            * ‖iteratedDeriv k (fun ρ : ℝ => g t (pt ρ φ)) ((2 : ℝ) ^ (-(j : ℤ)) * r)‖
        ≤ (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) * B :=
          mul_le_mul_of_nonneg_left hbdk hzpos.le
      _ ≤ 384 * B * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ))) := by
          nlinarith [mul_nonneg hB hzpos.le]
  · -- the angular bounds
    intro k hk t r φ
    have hrw : (fun φ' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r φ'))
        = fun φ' : ℝ => g t (pt ((2 : ℝ) ^ (-(j : ℤ)) * r) φ') := by
      funext φ'
      rw [pt_smul]
    change ‖iteratedDeriv k (fun φ' : ℝ => g t ((2 : ℝ) ^ (-(j : ℤ)) • pt r φ')) φ‖ ≤ 384 * B
    rw [hrw]
    exact norm_iteratedDeriv_angle_le (hsmooth t) (fun i hi v => hbd i hi t v)
      (fun v hv => hzero t v hv) (by omega) _ φ

/-! ### The multiplier data of the sector symbol -/

theorem gSym_eq_zero_of_large {φ : SchwartzMap Pl ℂ}
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (t : ℝ) {v : Pl} (h : 2 ≤ ‖v‖) :
    gSym φ part J t v = 0 := by
  rw [gSym, bpCut_eq_zero_of_large hφzero h]
  ring

/-- **The sector multiplier at scale `J`**: the rescaling of the fixed-scale symbol. -/
noncomputable def msc (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (ω : Pl) : ℂ :=
  gSym φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω)

/-- **The sector multiplier satisfies both hypothesis packages**, with constants independent of the
scale `J` and of the dilation `t`. -/
theorem exists_msc_data (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J →
      MultData J (msc φ part J) (m2can (msc φ part J)) B
        ∧ PolarData J (msc φ part J) (mrcan (msc φ part J)) (macan (msc φ part J)) (384 * B) := by
  obtain ⟨B, hBpos, hB⟩ := exists_gSym_bound φ hφone hφzero part 4
  refine ⟨B, hBpos, fun J hJ => ⟨?_, ?_⟩⟩
  · exact multData_of_rescaled (fun t => contDiff_gSym φ part J t)
      (fun t ω h => gSym_support hφone hφzero part J t ω h)
      (fun n hn t v => hB J hJ n (by omega) t v)
  · exact polarData_of_rescaled (fun t => contDiff_gSym φ part J t)
      (fun t ω h => gSym_support hφone hφzero part J t ω h)
      (fun t v hv => gSym_eq_zero_of_large hφzero part J t hv)
      (fun n hn t v => hB J hJ n hn t v)

/-! ### The dilation derivative of the amplitude -/

/-- The planar wave amplitude is a function of the *product* of its two arguments, hence
symmetric in them.  This turns the derivative in the dilation parameter into the radial
derivative, for which the repository provides the full symbol calculus. -/
theorem ampR_symm (part : CoordinateWavePart) (a ρ : ℝ) :
    planarCoordinateWaveRadialAmplitude part a ρ
      = planarCoordinateWaveRadialAmplitude part ρ a := by
  have h1 : (2 * π * a) * ρ = (2 * π * ρ) * a := by ring
  have h2 : (-(2 * π * a)) * ρ = (-(2 * π * ρ)) * a := by ring
  cases part with
  | outgoing =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h1]
  | incoming =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h2]
  | middle =>
      unfold planarCoordinateWaveRadialAmplitude
      dsimp only
      rw [h1]

/-- The chain rule for a profile composed with a linear map. -/
theorem hasDerivAt_comp_linear {P : ℝ → ℂ} (hP : ContDiff ℝ (↑(⊤ : ℕ∞)) P) (c ρ : ℝ) :
    HasDerivAt (fun r : ℝ => P (c * r)) (((c : ℝ) : ℂ) * deriv P (c * ρ)) ρ := by
  have hlin : HasDerivAt (fun r : ℝ => c * r) c ρ := by
    simpa using (hasDerivAt_id ρ).const_mul c
  have hP' : HasDerivAt P (deriv P (c * ρ)) (c * ρ) :=
    (hP.differentiable (by simp)).differentiableAt.hasDerivAt
  refine (hP'.scomp ρ hlin).congr_deriv ?_
  rw [Complex.real_smul]

/-- The radial derivative of the planar wave amplitude. -/
noncomputable def ampRD (part : CoordinateWavePart) (a ρ : ℝ) : ℂ :=
  (surfaceMass 1 : ℂ) *
    match part with
    | .outgoing => ((2 * π * a : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((2 * π * a) * ρ)
    | .incoming => ((-(2 * π * a) : ℝ) : ℂ) *
        deriv planarEndpointQuadraticIntegral ((-(2 * π * a)) * ρ)
    | .middle => ((2 * π * a : ℝ) : ℂ) *
        deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * a) * ρ)

theorem hasDerivAt_ampR (part : CoordinateWavePart) (a ρ : ℝ) :
    HasDerivAt (fun ρ' : ℝ => planarCoordinateWaveRadialAmplitude part a ρ')
      (ampRD part a ρ) ρ := by
  cases part with
  | outgoing =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (2 * π * a) ρ).const_mul (surfaceMass 1 : ℂ)
  | incoming =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear contDiff_planarEndpointQuadraticIntegral
        (-(2 * π * a)) ρ).const_mul (surfaceMass 1 : ℂ)
  | middle =>
      unfold planarCoordinateWaveRadialAmplitude ampRD
      dsimp only
      exact (hasDerivAt_comp_linear
        (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)
        (2 * π * a) ρ).const_mul (surfaceMass 1 : ℂ)

/-- The derivative of the amplitude in the dilation parameter. -/
theorem hasDerivAt_ampR_param (part : CoordinateWavePart) (u t : ℝ) :
    HasDerivAt (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      (ampRD part u t) t := by
  have hfun : (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      = fun s : ℝ => planarCoordinateWaveRadialAmplitude part u s := by
    funext s
    exact ampR_symm part s u
  rw [hfun]
  exact hasDerivAt_ampR part u t

/-- The two first derivatives of the amplitude are related by the exchange of its arguments:
`s ∂₂A(r,s) = r ∂₂A(s,r)`. -/
theorem ampRD_swap (part : CoordinateWavePart) (s r : ℝ) :
    ((s : ℝ) : ℂ) * ampRD part r s = ((r : ℝ) : ℂ) * ampRD part s r := by
  have h1 : (2 * π * r) * s = (2 * π * s) * r := by ring
  have h2 : (-(2 * π * r)) * s = (-(2 * π * s)) * r := by ring
  cases part with
  | outgoing =>
      unfold ampRD
      dsimp only
      rw [h1]
      push_cast
      ring
  | incoming =>
      unfold ampRD
      dsimp only
      rw [h2]
      push_cast
      ring
  | middle =>
      unfold ampRD
      dsimp only
      rw [h1]
      push_cast
      ring

/-- The radial derivative of the rescaled amplitude. -/
theorem hasDerivAt_gout_radius (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) :
    HasDerivAt (gout part J t)
      (((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ((((2 : ℝ) ^ J : ℝ) : ℂ)
        * ampRD part t ((2 : ℝ) ^ J * u))) u := by
  have h1 : HasDerivAt
      (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ J * u'))
      ((((2 : ℝ) ^ J : ℝ) : ℂ) * ampRD part t ((2 : ℝ) ^ J * u)) u := by
    have hlin : HasDerivAt (fun u' : ℝ => (2 : ℝ) ^ J * u') ((2 : ℝ) ^ J) u := by
      simpa using (hasDerivAt_id u).const_mul ((2 : ℝ) ^ J)
    refine ((hasDerivAt_ampR part t ((2 : ℝ) ^ J * u)).scomp u hlin).congr_deriv ?_
    rw [Complex.real_smul]
  exact h1.const_mul _

theorem contDiff_deriv_endpoint :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv planarEndpointQuadraticIntegral) :=
  (contDiff_infty_iff_deriv.mp contDiff_planarEndpointQuadraticIntegral).2

theorem contDiff_deriv_middle : ContDiff ℝ (↑(⊤ : ℕ∞))
    (deriv (coordinateMiddleMeridianLocalizedIntegral 0)) :=
  (contDiff_infty_iff_deriv.mp (contDiff_coordinateMiddleMeridianLocalizedIntegral 0)).2

theorem contDiff_ampRD_left (part : CoordinateWavePart) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => ampRD part w t := by
  cases part with
  | outgoing =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ) * deriv planarEndpointQuadraticIntegral ((2 * π * w) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul ?_
      exact contDiff_deriv_endpoint.comp ((contDiff_const.mul contDiff_id).mul contDiff_const)
  | incoming =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((-(2 * π * w) : ℝ) : ℂ)
          * deriv planarEndpointQuadraticIntegral ((-(2 * π * w)) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp
        (contDiff_const.mul contDiff_id).neg).mul ?_
      exact contDiff_deriv_endpoint.comp
        ((contDiff_const.mul contDiff_id).neg.mul contDiff_const)
  | middle =>
      change ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ)
          * deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * w) * t))
      refine contDiff_const.mul ?_
      refine (Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)).mul ?_
      exact contDiff_deriv_middle.comp ((contDiff_const.mul contDiff_id).mul contDiff_const)

/-- **The dilation derivative of the rescaled amplitude.** -/
noncomputable def goutDot (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) : ℂ :=
  ((Real.sqrt ((2 : ℝ) ^ J) : ℝ) : ℂ) * ampRD part ((2 : ℝ) ^ J * u) t

theorem hasDerivAt_gout_param (part : CoordinateWavePart) (J : ℕ) (t u : ℝ) :
    HasDerivAt (fun s : ℝ => gout part J s u) (goutDot part J t u) t := by
  have h1 : HasDerivAt
      (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s ((2 : ℝ) ^ J * u))
      (ampRD part ((2 : ℝ) ^ J * u) t) t := hasDerivAt_ampR_param part _ t
  exact h1.const_mul _

theorem contDiff_deriv_gout (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (gout part J t)) :=
  (contDiff_infty_iff_deriv.mp (contDiff_gout part J t)).2

theorem contDiff_goutDot (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (goutDot part J t) :=
  contDiff_const.mul ((contDiff_ampRD_left part t).comp (contDiff_const.mul contDiff_id))

/-- Away from `t = 0` the dilation derivative is `(u/t)` times the radial derivative. -/
theorem goutDot_eq (part : CoordinateWavePart) (J : ℕ) {t : ℝ} (ht : t ≠ 0) (u : ℝ) :
    goutDot part J t u = ((t⁻¹ * u : ℝ) : ℂ) * deriv (gout part J t) u := by
  rw [goutDot, (hasDerivAt_gout_radius part J t u).deriv]
  have hswap := ampRD_swap part t ((2 : ℝ) ^ J * u)
  have htC : ((t : ℝ) : ℂ) ≠ 0 := by exact_mod_cast ht
  have hval : ampRD part ((2 : ℝ) ^ J * u) t
      = ((((2 : ℝ) ^ J * u : ℝ) : ℂ) / ((t : ℝ) : ℂ)) * ampRD part t ((2 : ℝ) ^ J * u) := by
    field_simp
    linear_combination hswap
  rw [hval]
  push_cast
  field_simp

/-! ### Derivative bounds for the dilation derivative of the amplitude -/

/-- All derivatives of an affine profile are bounded on the annulus. -/
theorem norm_iteratedDeriv_ofReal_lin_le {c u : ℝ} (hc : |c| ≤ 2) (hu : |u| ≤ 2) (k : ℕ) :
    ‖iteratedDeriv k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 4 := by
  have hd : deriv (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) = fun _ : ℝ => ((c : ℝ) : ℂ) := by
    funext x
    have h1 : HasDerivAt (fun u' : ℝ => c * u') c x := by
      simpa using (hasDerivAt_id x).const_mul c
    have h2 : HasDerivAt (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) ((c : ℝ) : ℂ) x := by
      simpa using h1.ofReal_comp
    exact h2.deriv
  match k with
  | 0 =>
      rw [iteratedDeriv_zero, Complex.norm_real, Real.norm_eq_abs, abs_mul]
      nlinarith [abs_nonneg c, abs_nonneg u, hc, hu]
  | (n + 1) =>
      rw [iteratedDeriv_succ', hd, iteratedDeriv_const]
      split_ifs with hn
      · rw [Complex.norm_real, Real.norm_eq_abs]
        linarith
      · rw [norm_zero]
        norm_num

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The dilation derivative of the rescaled amplitude has uniformly bounded derivatives** on
the annulus. -/
theorem norm_iteratedDeriv_goutDot_le {part : CoordinateWavePart} {Camp : ℝ} (hCamp : 0 < Camp)
    {N : ℕ}
    (hamp : ∀ k ≤ N + 1, ∀ t u : ℝ, 1 / 2 ≤ t → t ≤ 3 → 1 ≤ u →
      ‖iteratedDeriv k (fun u' : ℝ => planarCoordinateWaveRadialAmplitude part t u') u‖
        ≤ Camp / (u ^ k * Real.sqrt u))
    {J : ℕ} (hJ : 1 ≤ J) {i : ℕ} (hi : i ≤ N) {t u : ℝ} (ht1 : 1 / 2 ≤ t) (ht2 : t ≤ 3)
    (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (goutDot part J t) u‖
      ≤ (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by
  classical
  have htpos : (0 : ℝ) < t := by linarith
  have hcabs : |t⁻¹| ≤ 2 := by
    rw [abs_of_pos (inv_pos.mpr htpos)]
    rw [inv_le_comm₀ htpos (by norm_num)]
    linarith
  have huabs : |u| ≤ 2 := by
    rw [abs_of_pos (by linarith)]
    linarith
  have hile : ((i : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤)
  have hf : ContDiff ℝ (↑(⊤ : ℕ∞)) fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  have hg : ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (gout part J t)) := contDiff_deriv_gout part J t
  have hfun : goutDot part J t
      = fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ) * deriv (gout part J t) u' := by
    funext u'
    exact goutDot_eq part J (ne_of_gt htpos) u'
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv, hfun]
  refine le_trans (norm_iteratedFDeriv_mul_le hf hg u hile) ?_
  have hterm : ∀ k ∈ Finset.range (i + 1),
      (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖
          * ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (i.choose k : ℝ) * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by
    intro k hk
    rw [Finset.mem_range] at hk
    have h1 : ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖ ≤ 4 := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact norm_iteratedDeriv_ofReal_lin_le hcabs huabs k
    have h2 : ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (2 : ℝ) ^ (N + 2) * Camp := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv, ← iteratedDeriv_succ']
      exact norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht1 ht2 hu1 hu2
    have h3 : (0 : ℝ) ≤ (i.choose k : ℝ) := by positivity
    calc (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((t⁻¹ * u' : ℝ) : ℂ)) u‖
            * ‖iteratedFDeriv ℝ (i - k) (deriv (gout part J t)) u‖
        ≤ (i.choose k : ℝ) * 4 * ((2 : ℝ) ^ (N + 2) * Camp) := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
          positivity
      _ = (i.choose k : ℝ) * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.sum_mul]
  have hchoose : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ)) = (2 : ℝ) ^ i := by
    have h := Nat.sum_range_choose i
    have hcast : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ))
        = ((∑ k ∈ Finset.range (i + 1), i.choose k : ℕ) : ℝ) := by
      push_cast
      ring
    rw [hcast, h]
    push_cast
    ring
  rw [hchoose]
  have hpow : (2 : ℝ) ^ i ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hi
  refine mul_le_mul_of_nonneg_right hpow ?_
  positivity

/-! ### The dilation derivative of the fixed-scale symbol -/

/-- The derivative of the dilation cutoff. -/
noncomputable def tcutD (t : ℝ) : ℝ :=
  2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)
    - Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)

theorem hasDerivAt_tcut (t : ℝ) : HasDerivAt tcut (tcutD t) t := by
  have hst : ∀ x : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition x) x :=
    fun x => (contDiff_st.differentiable (by simp)).differentiableAt.hasDerivAt
  have h1 : HasDerivAt (fun s : ℝ => Real.smoothTransition (2 * s - 1))
      (deriv Real.smoothTransition (2 * t - 1) * 2) t := by
    have hin : HasDerivAt (fun s : ℝ => 2 * s - 1) 2 t := by
      simpa using ((hasDerivAt_id t).const_mul (2 : ℝ)).sub_const 1
    exact (hst (2 * t - 1)).comp t hin
  have h2 : HasDerivAt (fun s : ℝ => Real.smoothTransition (3 - s))
      (deriv Real.smoothTransition (3 - t) * (-1)) t := by
    have hin : HasDerivAt (fun s : ℝ => 3 - s) (-1) t := by
      simpa using (hasDerivAt_id t).const_sub (3 : ℝ)
    exact (hst (3 - t)).comp t hin
  refine (h1.mul h2).congr_deriv ?_
  rw [tcutD]
  ring

theorem tcutD_eq_zero {t : ℝ} (h : ¬(1 / 2 < t ∧ t < 3)) : tcutD t = 0 := by
  rcases not_and_or.mp h with hlow | hhigh
  · have hle : t ≤ 1 / 2 := not_lt.mp hlow
    have h1 : Real.smoothTransition (2 * t - 1) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    have h2 : deriv Real.smoothTransition (2 * t - 1) = 0 :=
      deriv_st_eq_zero_of_nonpos (by linarith)
    rw [tcutD, h1, h2]
    ring
  · have hge : 3 ≤ t := not_lt.mp hhigh
    have h1 : Real.smoothTransition (3 - t) = 0 :=
      Real.smoothTransition.zero_of_nonpos (by linarith)
    have h2 : deriv Real.smoothTransition (3 - t) = 0 :=
      deriv_st_eq_zero_of_nonpos (by linarith)
    rw [tcutD, h1, h2]
    ring

/-- **The dilation derivative of the fixed-scale symbol.** -/
noncomputable def gSymDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) : ℂ :=
  ((tcutD t : ℝ) : ℂ) * (cutF φ v * gout part J t (nrm v))
    + ((tcut t : ℝ) : ℂ) * (cutF φ v * goutDot part J t (nrm v))

theorem hasDerivAt_gSym_param (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (v : Pl) :
    HasDerivAt (fun s : ℝ => gSym φ part J s v) (gSymDot φ part J t v) t := by
  have hrepr : ∀ s : ℝ, gSym φ part J s v
      = ((tcut s : ℝ) : ℂ) * (cutF φ v * gout part J s (nrm v)) := by
    intro s
    exact congrFun (gSym_eq_prod φ part J s) v
  have hfun : (fun s : ℝ => gSym φ part J s v)
      = fun s : ℝ => ((tcut s : ℝ) : ℂ) * (cutF φ v * gout part J s (nrm v)) := by
    funext s
    exact hrepr s
  rw [hfun]
  have h1 : HasDerivAt (fun s : ℝ => ((tcut s : ℝ) : ℂ)) ((tcutD t : ℝ) : ℂ) t := by
    simpa using (hasDerivAt_tcut t).ofReal_comp
  have h2 : HasDerivAt (fun s : ℝ => cutF φ v * gout part J s (nrm v))
      (cutF φ v * goutDot part J t (nrm v)) t :=
    (hasDerivAt_gout_param part J t (nrm v)).const_mul _
  refine (h1.mul h2).congr_deriv ?_
  rw [gSymDot]

theorem contDiff_gSymDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ) (t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (gSymDot φ part J t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * gout part J t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_gout part J t).comp contDiff_nrm)
  have h2 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * goutDot part J t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_goutDot part J t).comp contDiff_nrm)
  exact (contDiff_const.mul h1).add (contDiff_const.mul h2)

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The dilation derivative of the fixed-scale symbol has derivative bounds uniform in the
scale and the dilation.** -/
theorem exists_gSymDot_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ B := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part (N + 1)
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  obtain ⟨Cst, hCst1, hCstd1, hCstd2⟩ := exists_st_deriv2_bound
  have hCg1 : (0 : ℝ) < (2 : ℝ) ^ (N + 2) * Camp := by positivity
  have hCg2 : (0 : ℝ) < (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) := by positivity
  have hCstpos : (0 : ℝ) < Cst := by linarith
  refine ⟨3 * Cst * ((2 : ℝ) ^ N * Cc
      * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N))
    + (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
      * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N), by positivity, ?_⟩
  intro J hJ n hn t v
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  set F1 : Pl → ℂ := fun v' : Pl => cutF φ v' * gout part J t (nrm v') with hF1
  set F2 : Pl → ℂ := fun v' : Pl => cutF φ v' * goutDot part J t (nrm v') with hF2
  have hF1smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) F1 :=
    (contDiff_cutF φ).mul ((contDiff_gout part J t).comp contDiff_nrm)
  have hF2smooth : ContDiff ℝ (↑(⊤ : ℕ∞)) F2 :=
    (contDiff_cutF φ).mul ((contDiff_goutDot part J t).comp contDiff_nrm)
  -- the two pieces of the derivative symbol
  have hsplit : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖
      ≤ |tcutD t| * ‖iteratedFDeriv ℝ n F1 v‖ + |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ := by
    have hadd : gSymDot φ part J t
        = (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v')
          + fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v' := rfl
    have hsm1 : (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') = (tcutD t) • F1 := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hsm2 : (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') = (tcut t) • F2 := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hc1 : ContDiffAt ℝ n (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') v := by
      rw [hsm1]
      exact ((hF1smooth.of_le hnle).const_smul (tcutD t)).contDiffAt
    have hc2 : ContDiffAt ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') v := by
      rw [hsm2]
      exact ((hF2smooth.of_le hnle).const_smul (tcut t)).contDiffAt
    rw [hadd, iteratedFDeriv_add_apply hc1 hc2]
    refine le_trans (norm_add_le _ _) ?_
    have he1 : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcutD t : ℝ) : ℂ) * F1 v') v‖
        = |tcutD t| * ‖iteratedFDeriv ℝ n F1 v‖ := by
      rw [hsm1, iteratedFDeriv_const_smul_apply (hF1smooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    have he2 : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * F2 v') v‖
        = |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ := by
      rw [hsm2, iteratedFDeriv_const_smul_apply (hF2smooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    rw [he1, he2]
  refine le_trans hsplit ?_
  by_cases ht : 1 / 2 < t ∧ t < 3
  · -- the main case
    have hGbd1 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 2) * Camp :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht.1.le ht.2.le hu1 hu2
    have hGbd2 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (goutDot part J t) u‖
          ≤ (2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp)) :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_goutDot_le hCamp hamp hJ hi ht.1.le ht.2.le hu1 hu2
    have hb1 : ‖iteratedFDeriv ℝ n F1 v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_gout part J t) hCg1 hGbd1
        hD1 hDbd hCc hcut hn v
    have hb2 : ‖iteratedFDeriv ℝ n F2 v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_goutDot part J t) hCg2 hGbd2
        hD1 hDbd hCc hcut hn v
    have htcutD : |tcutD t| ≤ 3 * Cst := by
      have h1 := hCstd1 (2 * t - 1)
      have h2 := hCstd1 (3 - t)
      have h3 := Real.smoothTransition.le_one (2 * t - 1)
      have h4 := Real.smoothTransition.nonneg (2 * t - 1)
      have h5 := Real.smoothTransition.le_one (3 - t)
      have h6 := Real.smoothTransition.nonneg (3 - t)
      have hb : |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)|
          ≤ 2 * Cst := by
        rw [abs_mul, abs_mul]
        have habs : |(2 : ℝ)| = 2 := by norm_num
        rw [habs, abs_of_nonneg h6]
        nlinarith [abs_nonneg (deriv Real.smoothTransition (2 * t - 1))]
      have hb' : |Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)|
          ≤ Cst := by
        rw [abs_mul, abs_of_nonneg h4]
        nlinarith [abs_nonneg (deriv Real.smoothTransition (3 - t))]
      have := abs_sub (2 * deriv Real.smoothTransition (2 * t - 1)
        * Real.smoothTransition (3 - t))
        (Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t))
      rw [tcutD]
      calc |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)
              - Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)|
          ≤ |2 * deriv Real.smoothTransition (2 * t - 1) * Real.smoothTransition (3 - t)|
              + |Real.smoothTransition (2 * t - 1) * deriv Real.smoothTransition (3 - t)| :=
            abs_sub _ _
        _ ≤ 2 * Cst + Cst := add_le_add hb hb'
        _ = 3 * Cst := by ring
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    have hK1nn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ (N + 2) * Camp) * D ^ N) := by positivity
    have hK2nn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ) * ((2 : ℝ) ^ N * (4 * ((2 : ℝ) ^ (N + 2) * Camp))) * D ^ N) := by
      positivity
    refine add_le_add ?_ ?_
    · exact mul_le_mul htcutD hb1 (norm_nonneg _) (by positivity)
    · calc |tcut t| * ‖iteratedFDeriv ℝ n F2 v‖ ≤ 1 * ‖iteratedFDeriv ℝ n F2 v‖ :=
            mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ n F2 v‖ := one_mul _
        _ ≤ _ := hb2
  · -- off the dilation window both cutoffs vanish
    have hz1 : tcutD t = 0 := tcutD_eq_zero ht
    have hz2 : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz1, hz2, abs_zero, zero_mul, zero_mul, add_zero]
    positivity

/-! ### The radial profile of the phase derivative -/

/-- All derivatives of an affine profile are bounded on the annulus, with the constant linear in
the slope. -/
theorem norm_iteratedDeriv_lin_le (c : ℝ) {u : ℝ} (hu : |u| ≤ 2) (k : ℕ) :
    ‖iteratedDeriv k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 2 * (|c| + 1) := by
  have hd : deriv (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) = fun _ : ℝ => ((c : ℝ) : ℂ) := by
    funext x
    have h1 : HasDerivAt (fun u' : ℝ => c * u') c x := by
      simpa using (hasDerivAt_id x).const_mul c
    have h2 : HasDerivAt (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) ((c : ℝ) : ℂ) x := by
      simpa using h1.ofReal_comp
    exact h2.deriv
  match k with
  | 0 =>
      rw [iteratedDeriv_zero, Complex.norm_real, Real.norm_eq_abs, abs_mul]
      nlinarith [abs_nonneg c, abs_nonneg u, hu]
  | (n + 1) =>
      rw [iteratedDeriv_succ', hd, iteratedDeriv_const]
      split_ifs with hn
      · rw [Complex.norm_real, Real.norm_eq_abs]
        nlinarith [abs_nonneg c]
      · rw [norm_zero]
        nlinarith [abs_nonneg c]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The Leibniz bound for an affine factor times a bounded profile.** -/
theorem norm_iteratedDeriv_lin_mul_le {c : ℝ} {G : ℝ → ℂ} (hG : ContDiff ℝ (↑(⊤ : ℕ∞)) G)
    {Cg : ℝ} (hCg : 0 ≤ Cg) {N : ℕ}
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i G u‖ ≤ Cg)
    {i : ℕ} (hi : i ≤ N) {u : ℝ} (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (fun u' : ℝ => ((c * u' : ℝ) : ℂ) * G u') u‖
      ≤ (2 : ℝ) ^ N * (2 * (|c| + 1)) * Cg := by
  classical
  have huabs : |u| ≤ 2 := by
    rw [abs_of_pos (by linarith)]
    linarith
  have hile : ((i : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((i : ℕ∞)) ≤ ⊤)
  have hf : ContDiff ℝ (↑(⊤ : ℕ∞)) fun u' : ℝ => ((c * u' : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  rw [← norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  refine le_trans (norm_iteratedFDeriv_mul_le hf hG u hile) ?_
  have hterm : ∀ k ∈ Finset.range (i + 1),
      (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖
          * ‖iteratedFDeriv ℝ (i - k) G u‖
        ≤ (i.choose k : ℝ) * ((2 * (|c| + 1)) * Cg) := by
    intro k hk
    rw [Finset.mem_range] at hk
    have h1 : ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖ ≤ 2 * (|c| + 1) := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact norm_iteratedDeriv_lin_le c huabs k
    have h2 : ‖iteratedFDeriv ℝ (i - k) G u‖ ≤ Cg := by
      rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
      exact hGbd (i - k) (by omega) u hu1 hu2
    have h3 : (0 : ℝ) ≤ (i.choose k : ℝ) := by positivity
    calc (i.choose k : ℝ) * ‖iteratedFDeriv ℝ k (fun u' : ℝ => ((c * u' : ℝ) : ℂ)) u‖
            * ‖iteratedFDeriv ℝ (i - k) G u‖
        ≤ (i.choose k : ℝ) * (2 * (|c| + 1)) * Cg := by
          refine mul_le_mul (mul_le_mul_of_nonneg_left h1 h3) h2 (norm_nonneg _) ?_
          have habs : (0 : ℝ) ≤ |c| := abs_nonneg c
          positivity
      _ = (i.choose k : ℝ) * ((2 * (|c| + 1)) * Cg) := by ring
  refine le_trans (Finset.sum_le_sum hterm) ?_
  rw [← Finset.sum_mul]
  have hchoose : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ)) = (2 : ℝ) ^ i := by
    have h := Nat.sum_range_choose i
    have hcast : (∑ k ∈ Finset.range (i + 1), (i.choose k : ℝ))
        = ((∑ k ∈ Finset.range (i + 1), i.choose k : ℕ) : ℝ) := by
      push_cast
      ring
    rw [hcast, h]
    push_cast
    ring
  rw [hchoose, ← mul_assoc]
  have hpow : (2 : ℝ) ^ i ≤ (2 : ℝ) ^ N := pow_le_pow_right₀ (by norm_num) hi
  refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_right hpow ?_) hCg
  have habs : (0 : ℝ) ≤ |c| := abs_nonneg c
  positivity

/-- The radial profile of the term produced by differentiating the phase in the dilation. -/
noncomputable def goutPh (part : CoordinateWavePart) (J : ℕ) (ε t u : ℝ) : ℂ :=
  (((2 * π * ε * (2 : ℝ) ^ J) * u : ℝ) : ℂ) * (Complex.I * gout part J t u)

theorem contDiff_goutPh (part : CoordinateWavePart) (J : ℕ) (ε t : ℝ) :
    ContDiff ℝ (↑(⊤ : ℕ∞)) (goutPh part J ε t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞))
      fun u : ℝ => (((2 * π * ε * (2 : ℝ) ^ J) * u : ℝ) : ℂ) :=
    Complex.ofRealCLM.contDiff.comp (contDiff_const.mul contDiff_id)
  exact h1.mul (contDiff_const.mul (contDiff_gout part J t))

theorem norm_iteratedDeriv_goutPh_le {part : CoordinateWavePart} {Cg : ℝ} (hCg : 0 ≤ Cg)
    {N : ℕ} {J : ℕ} {ε t : ℝ}
    (hGbd : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 → ‖iteratedDeriv i (gout part J t) u‖ ≤ Cg)
    {i : ℕ} (hi : i ≤ N) {u : ℝ} (hu1 : 1 / 2 ≤ u) (hu2 : u ≤ 2) :
    ‖iteratedDeriv i (goutPh part J ε t) u‖
      ≤ (2 : ℝ) ^ N * (2 * (|2 * π * ε * (2 : ℝ) ^ J| + 1)) * Cg := by
  have hIbd : ∀ k ≤ N, ∀ u' : ℝ, 1 / 2 ≤ u' → u' ≤ 2 →
      ‖iteratedDeriv k (fun w : ℝ => Complex.I * gout part J t w) u'‖ ≤ Cg := by
    intro k hk u' hu1' hu2'
    have hcm : iteratedDeriv k (fun w : ℝ => Complex.I * gout part J t w) u'
        = Complex.I * iteratedDeriv k (gout part J t) u' := by
      refine iteratedDeriv_const_mul _ ?_
      exact ((contDiff_gout part J t).of_le
        (by exact_mod_cast (le_top : ((k : ℕ∞)) ≤ ⊤))).contDiffAt
    rw [hcm, norm_mul, Complex.norm_I, one_mul]
    exact hGbd k hk u' hu1' hu2'
  have hIsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) fun w : ℝ => Complex.I * gout part J t w :=
    contDiff_const.mul (contDiff_gout part J t)
  exact norm_iteratedDeriv_lin_mul_le hIsmooth hCg hIbd hi hu1 hu2

/-! ### The dilation-derivative symbol -/

/-- On the support of the cutoff the smooth truncated norm is the norm, and the annulus
condition holds. -/
theorem norm_mem_of_cutF_ne_zero {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    {v : Pl} (h : cutF φ v ≠ 0) : 1 / 2 < ‖v‖ ∧ ‖v‖ < 2 := by
  have hbp : bpCut φ v ≠ 0 := by
    intro hc
    rw [cutF, hc, zero_mul] at h
    exact h rfl
  constructor
  · by_contra hcon
    exact hbp (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
  · by_contra hcon
    exact hbp (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))

/-- The sector membership from the cutoff alone. -/
theorem theta_of_cutF_ne_zero {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) (J : ℕ) {ω : Pl}
    (h : cutF φ ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0) : ω ∈ Theta J := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hps : (psiSec v : ℝ) ≠ 0 := by
    intro hc
    rw [cutF, hc] at h
    simp at h
  obtain ⟨hs1, hs2, hs3, hs4⟩ := sector_of_psiSec_ne_zero hps
  obtain ⟨hlow, hhigh⟩ := norm_mem_of_cutF_ne_zero hφone hφzero h
  have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
  have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
    rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
  have hω0 : v 0 = (2 : ℝ) ^ (-(J : ℤ)) * ω 0 := rfl
  have hω1 : v 1 = (2 : ℝ) ^ (-(J : ℤ)) * ω 1 := rfl
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [hω0] at hs3
    nlinarith [hs3, hJpos]
  · rw [hω0, hω1] at hs4
    nlinarith [hs4, hJpos]
  · rw [hnormv] at hlow
    have hpow : (2 : ℝ) ^ ((J : ℤ) - 1) = (2 : ℝ) ^ (J : ℤ) / 2 := by
      rw [zpow_sub₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hlow, hJpos, hid]
  · rw [hnormv] at hhigh
    have hpow : (2 : ℝ) ^ ((J : ℤ) + 1) = (2 : ℝ) ^ (J : ℤ) * 2 := by
      rw [two_zpow_add]
      norm_num
    have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    rw [hpow]
    nlinarith [hhigh, hJpos, hid]

theorem gSym_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ) (t : ℝ)
    {v : Pl} (h : cutF φ v = 0) : gSym φ part J t v = 0 := by
  have hrepr := congrFun (gSym_eq_prod φ part J t) v
  rw [hrepr, h, zero_mul, mul_zero]

theorem gSymDot_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) {v : Pl} (h : cutF φ v = 0) : gSymDot φ part J t v = 0 := by
  rw [gSymDot, h, zero_mul, zero_mul, mul_zero, mul_zero, add_zero]

/-- **The symbol of the dilation derivative of the full multiplier.** -/
noncomputable def mtilSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) (v : Pl) : ℂ :=
  ((tcut t : ℝ) : ℂ) * (cutF φ v * goutPh part J ε t (nrm v)) + gSymDot φ part J t v

theorem contDiff_mtilSym (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (mtilSym φ part J ε t) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun v : Pl => cutF φ v * goutPh part J ε t (nrm v) :=
    (contDiff_cutF φ).mul ((contDiff_goutPh part J ε t).comp contDiff_nrm)
  exact (contDiff_const.mul h1).add (contDiff_gSymDot φ part J t)

theorem mtilSym_eq_zero_of_cutF {φ : SchwartzMap Pl ℂ} (part : CoordinateWavePart) (J : ℕ)
    (ε t : ℝ) {v : Pl} (h : cutF φ v = 0) : mtilSym φ part J ε t v = 0 := by
  rw [mtilSym, h, zero_mul, mul_zero, gSymDot_eq_zero_of_cutF part J t h, add_zero]

/-- The rescaled sector multiplier and its dilation derivative. -/
noncomputable def mscDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (t : ℝ) (ω : Pl) : ℂ :=
  gSymDot φ part J t ((2 : ℝ) ^ (-(J : ℤ)) • ω)

theorem hasDerivAt_msc (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ω : Pl) (t : ℝ) :
    HasDerivAt (fun s : ℝ => msc φ part J s ω) (mscDot φ part J t ω) t :=
  hasDerivAt_gSym_param φ part J t _

/-- **The dilation derivative of the sector multiplier is the rescaling of `mtilSym`.** -/
theorem mtil_msc_eq (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (J : ℕ) (ε t : ℝ) (ω : Pl) :
    mtil ε (msc φ part J) (mscDot φ part J) t ω
      = mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) := by
  set v : Pl := (2 : ℝ) ^ (-(J : ℤ)) • ω with hv
  have hkey : ((2 * π * ε * ‖ω‖ : ℝ) : ℂ) * Complex.I * gSym φ part J t v
      = ((tcut t : ℝ) : ℂ) * (cutF φ v * goutPh part J ε t (nrm v)) := by
    have hrepr := congrFun (gSym_eq_prod φ part J t) v
    by_cases hc : cutF φ v = 0
    · rw [hrepr, hc]
      simp
    · -- on the support the two radial variables agree
      obtain ⟨hlow, hhigh⟩ := norm_mem_of_cutF_ne_zero hφone hφzero hc
      have hnrm : nrm v = ‖v‖ := nrm_eq (by linarith) (by linarith)
      have hJpos : (0 : ℝ) < (2 : ℝ) ^ (-(J : ℤ)) := by positivity
      have hnormv : ‖v‖ = (2 : ℝ) ^ (-(J : ℤ)) * ‖ω‖ := by
        rw [hv, norm_smul, Real.norm_eq_abs, abs_of_pos hJpos]
      have hid : (2 : ℝ) ^ (-(J : ℤ)) * (2 : ℝ) ^ (J : ℤ) = 1 := by
        rw [← two_zpow_add, neg_add_cancel, zpow_zero]
      have hJn : ((2 : ℝ) ^ J : ℝ) = (2 : ℝ) ^ (J : ℤ) := by
        rw [zpow_natCast]
      have hprod : (2 : ℝ) ^ J * nrm v = ‖ω‖ := by
        rw [hnrm, hnormv, hJn]
        nlinarith [hid]
      have hprod2 : 2 * π * ε * (2 : ℝ) ^ J * nrm v = 2 * π * ε * ‖ω‖ := by
        rw [← hprod]
        ring
      rw [hrepr, goutPh, hprod2]
      ring
  rw [mtil, mscDot, msc, mtilSym, ← hv, hkey]

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The dilation-derivative symbol has derivative bounds which lose only one factor `2^J`**,
the factor produced by differentiating the phase. -/
theorem exists_mtilSym_bound (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (N : ℕ) {ε : ℝ} (hε : |ε| = 1) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J → ∀ n ≤ N, ∀ (t : ℝ) (v : Pl),
      ‖iteratedFDeriv ℝ n (mtilSym φ part J ε t) v‖ ≤ B * (2 : ℝ) ^ J := by
  classical
  obtain ⟨Camp, hCamp, hamp⟩ := exists_ampR_decay part (N + 1)
  obtain ⟨D, hD1, hDbd⟩ := exists_nrm_deriv_bound N
  obtain ⟨Cc, hCc, hcut⟩ := exists_cutF_bound φ N
  obtain ⟨Bdot, hBdot, hdot⟩ := exists_gSymDot_bound φ hφone hφzero part N
  have hCg1 : (0 : ℝ) < (2 : ℝ) ^ (N + 2) * Camp := by positivity
  have hπ : (0 : ℝ) < π := Real.pi_pos
  refine ⟨(2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
      * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) + Bdot,
    by positivity, ?_⟩
  intro J hJ n hn t v
  have h1le : (1 : ℝ) ≤ (2 : ℝ) ^ J := by
    have h := pow_le_pow_right₀ (by norm_num : (1 : ℝ) ≤ 2) (Nat.zero_le J)
    simpa using h
  have hnle : ((n : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    exact_mod_cast (le_top : ((n : ℕ∞)) ≤ ⊤)
  set Fph : Pl → ℂ := fun v' : Pl => cutF φ v' * goutPh part J ε t (nrm v') with hFph
  have hFphsmooth : ContDiff ℝ (↑(⊤ : ℕ∞)) Fph :=
    (contDiff_cutF φ).mul ((contDiff_goutPh part J ε t).comp contDiff_nrm)
  -- split the symbol into the phase term and the amplitude term
  have hsplit : ‖iteratedFDeriv ℝ n (mtilSym φ part J ε t) v‖
      ≤ |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
        + ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ := by
    have hadd : mtilSym φ part J ε t
        = (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') + gSymDot φ part J t := rfl
    have hsm : (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') = (tcut t) • Fph := by
      funext v'
      rw [Pi.smul_apply, Complex.real_smul]
    have hc1 : ContDiffAt ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') v := by
      rw [hsm]
      exact ((hFphsmooth.of_le hnle).const_smul (tcut t)).contDiffAt
    have hc2 : ContDiffAt ℝ n (gSymDot φ part J t) v :=
      ((contDiff_gSymDot φ part J t).of_le hnle).contDiffAt
    rw [hadd, iteratedFDeriv_add_apply hc1 hc2]
    refine le_trans (norm_add_le _ _) (add_le_add ?_ (le_refl _))
    have he : ‖iteratedFDeriv ℝ n (fun v' : Pl => ((tcut t : ℝ) : ℂ) * Fph v') v‖
        = |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖ := by
      rw [hsm, iteratedFDeriv_const_smul_apply (hFphsmooth.of_le hnle).contDiffAt, norm_smul,
        Real.norm_eq_abs]
    rw [he]
  have hdotbd : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ Bdot := hdot J hJ n hn t v
  refine le_trans hsplit ?_
  by_cases ht : 1 / 2 < t ∧ t < 3
  · -- the main case
    have hGbd1 : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (gout part J t) u‖ ≤ (2 : ℝ) ^ (N + 2) * Camp :=
      fun i hi u hu1 hu2 =>
        norm_iteratedDeriv_gout_le hCamp hamp hJ (by omega) ht.1.le ht.2.le hu1 hu2
    have habs : |2 * π * ε * (2 : ℝ) ^ J| = 2 * π * (2 : ℝ) ^ J := by
      have h1 : 2 * π * ε * (2 : ℝ) ^ J = (2 * π * (2 : ℝ) ^ J) * ε := by ring
      rw [h1, abs_mul, hε, mul_one, abs_of_pos (by positivity)]
    have hGph : ∀ i ≤ N, ∀ u : ℝ, 1 / 2 ≤ u → u ≤ 2 →
        ‖iteratedDeriv i (goutPh part J ε t) u‖
          ≤ (2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp) := by
      intro i hi u hu1 hu2
      refine le_trans (norm_iteratedDeriv_goutPh_le hCg1.le hGbd1 hi hu1 hu2) ?_
      refine mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left ?_ (by positivity)) hCg1.le
      rw [habs]
      nlinarith [h1le, hπ]
    have hb : ‖iteratedFDeriv ℝ n Fph v‖ ≤ (2 : ℝ) ^ N * Cc
        * ((Nat.factorial N : ℝ)
            * ((2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp))
          * D ^ N) :=
      norm_iteratedFDeriv_cut_mul_comp_le hφone hφzero (contDiff_goutPh part J ε t)
        (by positivity) hGph hD1 hDbd hCc hcut hn v
    have htcut : |tcut t| ≤ 1 := by
      rw [abs_of_nonneg (tcut_nonneg t)]
      exact tcut_le_one t
    have hstep : |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
        ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
            * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
          * (2 : ℝ) ^ J := by
      calc |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖ ≤ 1 * ‖iteratedFDeriv ℝ n Fph v‖ :=
            mul_le_mul_of_nonneg_right htcut (norm_nonneg _)
        _ = ‖iteratedFDeriv ℝ n Fph v‖ := one_mul _
        _ ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * ((2 * (2 * π + 1)) * (2 : ℝ) ^ J) * ((2 : ℝ) ^ (N + 2) * Camp))
            * D ^ N) := hb
        _ = (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
            * (2 : ℝ) ^ J := by ring
    have hdot2 : ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖ ≤ Bdot * (2 : ℝ) ^ J := by
      nlinarith [hdotbd, h1le, hBdot]
    calc |tcut t| * ‖iteratedFDeriv ℝ n Fph v‖
          + ‖iteratedFDeriv ℝ n (gSymDot φ part J t) v‖
        ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N)
            * (2 : ℝ) ^ J + Bdot * (2 : ℝ) ^ J := add_le_add hstep hdot2
      _ = ((2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
              * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) + Bdot)
            * (2 : ℝ) ^ J := by ring
  · -- off the dilation window the phase term vanishes
    have hz : tcut t = 0 := by
      by_contra hc
      exact ht (tcut_mem hc)
    rw [hz, abs_zero, zero_mul, zero_add]
    have hKnn : (0 : ℝ) ≤ (2 : ℝ) ^ N * Cc * ((Nat.factorial N : ℝ)
        * ((2 : ℝ) ^ N * (2 * (2 * π + 1)) * ((2 : ℝ) ^ (N + 2) * Camp)) * D ^ N) := by
      positivity
    nlinarith [hdotbd, h1le, hKnn, hBdot]

/-- **The dilation-derivative multiplier satisfies both hypothesis packages**, with constants that
lose only the factor `2^J` of the phase. -/
theorem exists_mtil_data (φ : SchwartzMap Pl ℂ)
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) {ε : ℝ} (hε : |ε| = 1) :
    ∃ B : ℝ, 0 < B ∧ ∀ J : ℕ, 1 ≤ J →
      MultData J (mtil ε (msc φ part J) (mscDot φ part J))
          (m2can (mtil ε (msc φ part J) (mscDot φ part J))) (B * (2 : ℝ) ^ J)
        ∧ PolarData J (mtil ε (msc φ part J) (mscDot φ part J))
          (mrcan (mtil ε (msc φ part J) (mscDot φ part J)))
          (macan (mtil ε (msc φ part J) (mscDot φ part J))) (384 * (B * (2 : ℝ) ^ J)) := by
  obtain ⟨B, hBpos, hB⟩ := exists_mtilSym_bound φ hφone hφzero part 4 hε
  refine ⟨B, hBpos, fun J hJ => ?_⟩
  have hfun : mtil ε (msc φ part J) (mscDot φ part J)
      = fun t ω => mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) := by
    funext t ω
    exact mtil_msc_eq φ hφone hφzero part J ε t ω
  have hsupp : ∀ (t : ℝ) (ω : Pl),
      mtilSym φ part J ε t ((2 : ℝ) ^ (-(J : ℤ)) • ω) ≠ 0 → ω ∈ Theta J := by
    intro t ω h
    refine theta_of_cutF_ne_zero hφone hφzero J ?_
    intro hc
    exact h (mtilSym_eq_zero_of_cutF part J ε t hc)
  have hzero : ∀ (t : ℝ) (v : Pl), 2 ≤ ‖v‖ → mtilSym φ part J ε t v = 0 := by
    intro t v hv
    refine mtilSym_eq_zero_of_cutF part J ε t ?_
    rw [cutF, bpCut_eq_zero_of_large hφzero hv, zero_mul]
  rw [hfun]
  refine ⟨?_, ?_⟩
  · exact multData_of_rescaled (fun t => contDiff_mtilSym φ part J ε t) hsupp
      (fun n hn t v => hB J hJ n (by omega) t v)
  · exact polarData_of_rescaled (fun t => contDiff_mtilSym φ part J ε t) hsupp hzero
      (fun n hn t v => hB J hJ n hn t v)

/-! ### Continuity in the dilation -/

theorem continuous_ampR_param (part : CoordinateWavePart) (u : ℝ) :
    Continuous fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u := by
  have hfun : (fun s : ℝ => planarCoordinateWaveRadialAmplitude part s u)
      = fun s : ℝ => planarCoordinateWaveRadialAmplitude part u s := by
    funext s
    exact ampR_symm part s u
  rw [hfun]
  exact (contDiff_ampR part u).continuous

theorem continuous_ampRD_param (part : CoordinateWavePart) (w : ℝ) :
    Continuous fun t : ℝ => ampRD part w t := by
  cases part with
  | outgoing =>
      change Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ) * deriv planarEndpointQuadraticIntegral ((2 * π * w) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_endpoint.continuous.comp (continuous_const.mul continuous_id)))
  | incoming =>
      change Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((-(2 * π * w) : ℝ) : ℂ)
          * deriv planarEndpointQuadraticIntegral ((-(2 * π * w)) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_endpoint.continuous.comp (continuous_const.mul continuous_id)))
  | middle =>
      change Continuous fun t : ℝ => (surfaceMass 1 : ℂ) *
        (((2 * π * w : ℝ) : ℂ)
          * deriv (coordinateMiddleMeridianLocalizedIntegral 0) ((2 * π * w) * t))
      exact continuous_const.mul (continuous_const.mul
        (contDiff_deriv_middle.continuous.comp (continuous_const.mul continuous_id)))

theorem continuous_gout_param (part : CoordinateWavePart) (J : ℕ) (u : ℝ) :
    Continuous fun s : ℝ => gout part J s u :=
  continuous_const.mul (continuous_ampR_param part _)

theorem continuous_goutDot_param (part : CoordinateWavePart) (J : ℕ) (u : ℝ) :
    Continuous fun t : ℝ => goutDot part J t u :=
  continuous_const.mul (continuous_ampRD_param part _)

theorem continuous_tcut : Continuous tcut := contDiff_tcut.continuous

theorem continuous_tcutD : Continuous tcutD := by
  have hst : Continuous Real.smoothTransition := contDiff_st.continuous
  have hstd : Continuous (deriv Real.smoothTransition) := contDiff_deriv_st.continuous
  have h1 : Continuous fun t : ℝ => 2 * t - 1 :=
    (continuous_const.mul continuous_id).sub continuous_const
  have h2 : Continuous fun t : ℝ => 3 - t := continuous_const.sub continuous_id
  exact ((continuous_const.mul (hstd.comp h1)).mul (hst.comp h2)).sub
    ((hst.comp h1).mul (hstd.comp h2))

theorem continuous_gSymDot_param (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (v : Pl) : Continuous fun t : ℝ => gSymDot φ part J t v := by
  have h1 : Continuous fun t : ℝ => ((tcutD t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_tcutD
  have h2 : Continuous fun t : ℝ => ((tcut t : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp continuous_tcut
  exact (h1.mul (continuous_const.mul (continuous_gout_param part J (nrm v)))).add
    (h2.mul (continuous_const.mul (continuous_goutDot_param part J (nrm v))))

theorem continuous_mscDot (φ : SchwartzMap Pl ℂ) (part : CoordinateWavePart) (J : ℕ)
    (ω : Pl) : Continuous fun s : ℝ => mscDot φ part J s ω :=
  continuous_gSymDot_param φ part J _

/-! ### The sector decomposition of the dyadic bandpass multiplier -/

theorem nrm_rotF (α : ℝ) (v : Pl) : nrm (rotF α v) = nrm v := by
  rw [nrm, nrm, norm_rotF]

theorem bpCut_rotF {φ : SchwartzMap Pl ℂ} (hφrad : IsNormRadial (φ : Pl → ℂ)) (α : ℝ)
    (v : Pl) : bpCut φ (rotF α v) = bpCut φ v := by
  have h1 : (φ : Pl → ℂ) (rotF α v) = (φ : Pl → ℂ) v := hφrad (norm_rotF α v)
  have h2 : (φ : Pl → ℂ) ((2 : ℝ) • rotF α v) = (φ : Pl → ℂ) ((2 : ℝ) • v) := by
    refine hφrad ?_
    rw [← rotF_smul_apply, norm_rotF]
  rw [bpCut, bpCut, h1, h2]

/-- The repository's absolute dyadic bandpass is the fixed-scale bandpass cutoff at the
rescaled frequency, with `J = j + 1`. -/
theorem absoluteDyadicBandpass_eq_bpCut {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0) (j : ℕ) (ξ : Pl) :
    (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ
      = bpCut φ ((2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) • ξ) := by
  have hc : (2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) = ((2 : ℝ) ^ (j + 1))⁻¹ := by
    rw [zpow_neg, zpow_natCast]
  have hsm : (2 : ℝ) • (((2 : ℝ) ^ (j + 1))⁻¹ • ξ) = ((2 : ℝ) ^ j)⁻¹ • ξ := by
    rw [smul_smul]
    congr 1
    rw [pow_succ]
    field_simp
  rw [absoluteDyadicBandpass_spec φ hφone hφzero j ξ, bpCut, hc, hsm]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The sector decomposition.**  For dilations in `[1,2]` the product of the wave amplitude with
the dyadic bandpass is `2^{-J/2}` times the sum of the `N` rotated copies of the single sector
multiplier. -/
theorem sector_sum_msc {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (hφrad : IsNormRadial (φ : Pl → ℂ))
    (part : CoordinateWavePart) (j : ℕ) {t : ℝ} (ht1 : 1 ≤ t) (ht2 : t ≤ 2) (ξ : Pl) :
    (∑ ν ∈ Finset.range Nsec, msc φ part (j + 1) t (rotF (-((ν : ℝ) * hsec)) ξ))
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ)
        * (planarCoordinateWaveRadialAmplitude part t ‖ξ‖
          * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ) := by
  classical
  set c : ℝ := (2 : ℝ) ^ (-((j + 1 : ℕ) : ℤ)) with hcdef
  set v : Pl := c • ξ with hvdef
  have hcpos : (0 : ℝ) < c := by
    rw [hcdef]
    positivity
  have hbp : (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ξ = bpCut φ v :=
    absoluteDyadicBandpass_eq_bpCut hφone hφzero j ξ
  -- each rotated multiplier, written out
  have hterm : ∀ ν : ℕ, msc φ part (j + 1) t (rotF (-((ν : ℝ) * hsec)) ξ)
      = ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * ((tcut t : ℝ) : ℂ) * bpCut φ v
        * ((psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ)
        * planarCoordinateWaveRadialAmplitude part t ((2 : ℝ) ^ (j + 1) * nrm v) := by
    intro ν
    have hrot : c • rotF (-((ν : ℝ) * hsec)) ξ = rotF (-((ν : ℝ) * hsec)) v := by
      rw [hvdef, rotF_smul_apply]
    rw [msc, hrot, gSym, bpCut_rotF hφrad, nrm_rotF]
  rw [Finset.sum_congr rfl fun ν _ => hterm ν]
  by_cases hz : bpCut φ v = 0
  · rw [hbp, hz]
    simp
  · -- on the support the annulus condition holds, so the rotated cutoffs sum to one
    have hlow : 1 / 2 < ‖v‖ := by
      by_contra hcon
      exact hz (bpCut_eq_zero_of_small hφone (not_lt.mp hcon))
    have hhigh : ‖v‖ < 2 := by
      by_contra hcon
      exact hz (bpCut_eq_zero_of_large hφzero (not_lt.mp hcon))
    have hnrm : nrm v = ‖v‖ := nrm_eq (by linarith) (by linarith)
    have hnormv : ‖v‖ = c * ‖ξ‖ := by
      rw [hvdef, norm_smul, Real.norm_eq_abs, abs_of_pos hcpos]
    have hid : c * (2 : ℝ) ^ (j + 1) = 1 := by
      rw [hcdef]
      rw [show ((2 : ℝ) ^ (j + 1)) = (2 : ℝ) ^ ((j + 1 : ℕ) : ℤ) by rw [zpow_natCast]]
      rw [← two_zpow_add, neg_add_cancel, zpow_zero]
    have hprod : (2 : ℝ) ^ (j + 1) * nrm v = ‖ξ‖ := by
      rw [hnrm, hnormv]
      nlinarith [hid]
    have htcut1 : tcut t = 1 := tcut_eq_one ht1 ht2
    rw [hprod, htcut1]
    have hsum : (∑ ν ∈ Finset.range Nsec,
        ((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * ((1 : ℝ) : ℂ) * bpCut φ v
          * ((psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ)
          * planarCoordinateWaveRadialAmplitude part t ‖ξ‖)
        = (((Real.sqrt ((2 : ℝ) ^ (j + 1)) : ℝ) : ℂ) * bpCut φ v
            * planarCoordinateWaveRadialAmplitude part t ‖ξ‖)
          * ((∑ ν ∈ Finset.range Nsec, psiSec (rotF (-((ν : ℝ) * hsec)) v) : ℝ) : ℂ) := by
      rw [Complex.ofReal_sum, Finset.mul_sum]
      refine Finset.sum_congr rfl fun ν _ => ?_
      push_cast
      ring
    rw [hsum, sum_psiSec_rotF (le_of_lt hlow) (le_of_lt hhigh), hbp]
    push_cast
    ring

/-! ### The wave pieces of the single-scale average, and their sector expansion -/

/-- The rotate of a Schwartz function. -/
noncomputable def rotSch (α : ℝ) (f : SchwartzMap Pl ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.compCLMOfContinuousLinearEquiv ℝ (rotCLE α) f

@[simp] theorem rotSch_apply (α : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (rotSch α f : Pl → ℂ) x = (f : Pl → ℂ) (rotF α x) := rfl

theorem rotSch_coe (α : ℝ) (f : SchwartzMap Pl ℂ) :
    (rotSch α f : Pl → ℂ) = fun x : Pl => (f : Pl → ℂ) (rotF α x) := rfl

/-- The `part`-wave piece of the dyadic single-scale spherical average. -/
noncomputable def waveInt {φ : SchwartzMap Pl ℂ}
    (hφone : ∀ ξ : Pl, ‖ξ‖ ≤ 1 → (φ : Pl → ℂ) ξ = 1)
    (hφzero : ∀ ξ : Pl, 2 ≤ ‖ξ‖ → (φ : Pl → ℂ) ξ = 0)
    (part : CoordinateWavePart) (j : ℕ) (t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) : ℂ :=
  ∫ ω : Pl, ee (-(inner ℝ x ω : ℝ))
    * (planarCoordinateWaveRadialTerm part t ‖ω‖
        * (absoluteDyadicBandpass φ hφone hφzero j : Pl → ℂ) ω * 𝓕 ((f : Pl → ℂ)) ω)

theorem integrable_integrand_mfull_rot {j : ℕ} {m : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ)
    (f : SchwartzMap Pl ℂ) (x : Pl) (α : ℝ) :
    Integrable (fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
      * (mfull j ε m t (rotF α ξ) * 𝓕 ((f : Pl → ℂ)) ξ)) (volume : Measure Pl) := by
  have hbint : Integrable (fun ω : Pl => B0 * ‖𝓕 ((f : Pl → ℂ)) ω‖) (volume : Measure Pl) := by
    have h1 : Integrable (𝓕 ((f : Pl → ℂ))) (volume : Measure Pl) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).integrable
    exact h1.norm.const_mul B0
  have hcont : Continuous fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ))
      * (mfull j ε m t (rotF α ξ) * 𝓕 ((f : Pl → ℂ)) ξ) := by
    have hee : Continuous fun ξ : Pl => ee (-(inner ℝ x ξ : ℝ)) := by
      have h1 : Continuous fun ξ : Pl => -(inner ℝ x ξ : ℝ) :=
        (continuous_const.inner continuous_id).neg
      exact continuous_ee.comp h1
    have hfF : Continuous (𝓕 ((f : Pl → ℂ))) := by
      rw [← SchwartzMap.fourier_coe f]
      exact (𝓕 f : SchwartzMap Pl ℂ).continuous
    exact hee.mul ((((contDiff_mfull hm ε t).continuous).comp (continuous_rotF α)).mul hfF)
  refine Integrable.mono' hbint hcont.aestronglyMeasurable ?_
  filter_upwards with ξ
  rw [norm_mul, norm_mul, norm_ee, one_mul]
  exact mul_le_mul_of_nonneg_right (norm_mfull_le hm ε t _) (norm_nonneg _)

