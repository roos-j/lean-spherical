  linarith

/-- **The plate parameters exist at every scale.**  `M = max 7 ⌈j/2⌉` and `L = M + 2` satisfy all
the hypotheses of the endpoint estimate (K). -/
theorem exists_plate_params (j : ℕ) :
    ∃ Mk L : ℕ, 1 ≤ Mk ∧ (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100
      ∧ 2 * (Mk : ℤ) ≤ (j : ℤ) + 14 ∧ (j : ℤ) ≤ 2 * (Mk : ℤ)
      ∧ ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L := by
  refine ⟨max 7 ((j + 1) / 2), max 7 ((j + 1) / 2) + 2, ?_, ?_, ?_, ?_, ?_⟩
  · exact le_trans (by norm_num) (le_max_left _ _)
  · have h7 : (7 : ℤ) ≤ (max 7 ((j + 1) / 2) : ℕ) := by
      have : 7 ≤ max 7 ((j + 1) / 2) := le_max_left _ _
      exact_mod_cast this
    have hle : (2 : ℝ) ^ (-((max 7 ((j + 1) / 2) : ℕ) : ℤ)) ≤ (2 : ℝ) ^ (-(7 : ℤ)) :=
      zpow_le_zpow_right₀ (by norm_num) (by omega)
    refine le_trans hle ?_
    norm_num
  · have h1 : 2 * max 7 ((j + 1) / 2) ≤ j + 14 := by omega
    exact_mod_cast h1
  · have h1 : j ≤ 2 * max 7 ((j + 1) / 2) := by omega
    exact_mod_cast h1
  · refine Int.ceil_le.mpr ?_
    have hpi : π ≤ 4 := by
      have h := Real.pi_lt_d2
      linarith
    have hpow : (0 : ℝ) < (2 : ℝ) ^ (max 7 ((j + 1) / 2)) := by positivity
    have h1 : π * (2 : ℝ) ^ (max 7 ((j + 1) / 2))
        ≤ 4 * (2 : ℝ) ^ (max 7 ((j + 1) / 2)) := by
      exact mul_le_mul_of_nonneg_right hpi hpow.le
    refine le_trans h1 (le_of_eq ?_)
    push_cast
    rw [pow_add]
    ring

