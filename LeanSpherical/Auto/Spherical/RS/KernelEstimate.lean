/-- **The first-derivative (non-stationary phase) test**, with boundary terms. -/
theorem norm_integral_osc_ibp_bdry {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Q : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτ'c : Continuous τ')
    (hτ'ne : ∀ x ∈ Set.uIcc a b, τ' x ≠ 0)
    (hAc : Continuous A) (hQc : ContinuousOn Q (Set.uIcc a b))
    (hAQ : ∀ x ∈ Set.uIcc a b,
      HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Q x) x) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (‖A b‖ / |τ' b| + ‖A a‖ / |τ' a| + ∫ x in a..b, ‖Q x‖) / |lam| := by
  have hlampos : (0 : ℝ) < |lam| := abs_pos.mpr hlam
  have hnormL : ‖((lam : ℝ) : ℂ) * Complex.I‖ = |lam| := by
    rw [norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs]
