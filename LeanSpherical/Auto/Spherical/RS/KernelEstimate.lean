  rw [norm_div, hnormL, norm_mul, one_div, norm_inv, hnormL]
  have hbdry : ‖osc lam (τ b) * (A b / ((τ' b : ℝ) : ℂ))
        - osc lam (τ a) * (A a / ((τ' a : ℝ) : ℂ))‖
      ≤ ‖A b‖ / |τ' b| + ‖A a‖ / |τ' a| := by
    refine le_trans (norm_sub_le _ _) ?_
    rw [norm_mul, norm_mul, norm_osc, norm_osc, one_mul, one_mul, norm_div, norm_div,
      Complex.norm_real, Complex.norm_real, Real.norm_eq_abs, Real.norm_eq_abs]
