/-! ### The stationary point of a convex phase -/

section Stationary

/-- With `τ'' ≥ kap` on `[a,b]` the increment of `τ'` there is at least `kap` times the increment
of the variable. -/
theorem incr_of_deriv_ge {a b kap : ℝ} {τ' τ'' : ℝ → ℝ}
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x)
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x) {x y : ℝ}
    (hx : x ∈ Set.Icc a b) (hy : y ∈ Set.Icc a b) (hxy : x ≤ y) :
    τ' x + kap * (y - x) ≤ τ' y := by
  have hgd : ∀ z : ℝ, HasDerivAt (fun w : ℝ => τ' w - kap * w) (τ'' z - kap) z := by
    intro z
    have h := (hτ' z).sub ((hasDerivAt_id z).const_mul kap)
    refine h.congr_deriv ?_
    ring
  have hmono : MonotoneOn (fun w : ℝ => τ' w - kap * w) (Set.Icc a b) := by
    refine monotoneOn_of_deriv_nonneg (convex_Icc a b) ?_ ?_ ?_
    · intro z _
      exact ((hgd z).continuousAt).continuousWithinAt
    · intro z _
      exact ((hgd z).differentiableAt).differentiableWithinAt
    · intro z hz
      rw [interior_Icc] at hz
      have hzmem : z ∈ Set.Icc a b := ⟨le_of_lt hz.1, le_of_lt hz.2⟩
      rw [(hgd z).deriv]
      linarith [hτ'' z hzmem]
  have h := hmono hx hy hxy
  simp only [] at h
  linarith

/-- **The stationary point.**  If `τ'' ≥ kap > 0` on `[a,b]` there is `c ∈ [a,b]` with
`kap |x - c| ≤ |τ' x|` throughout `[a,b]`. -/
theorem exists_stationary_lower {a b kap : ℝ} (hab : a ≤ b) (hkap : 0 < kap)
    {τ' τ'' : ℝ → ℝ} (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x)
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x) :
    ∃ c ∈ Set.Icc a b, ∀ x ∈ Set.Icc a b, kap * |x - c| ≤ |τ' x| := by
  have hτ'c : Continuous τ' := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ' x).continuousAt
  have hamem : a ∈ Set.Icc a b := Set.left_mem_Icc.mpr hab
  have hbmem : b ∈ Set.Icc a b := Set.right_mem_Icc.mpr hab
  rcases le_or_gt 0 (τ' a) with hA | hA
  · refine ⟨a, hamem, fun x hx => ?_⟩
    have h := incr_of_deriv_ge hτ' hτ'' hamem hx hx.1
    have hprod : (0 : ℝ) ≤ kap * (x - a) := mul_nonneg (le_of_lt hkap) (by linarith [hx.1])
    have habs : |x - a| = x - a := abs_of_nonneg (by linarith [hx.1])
    have hpos : (0 : ℝ) ≤ τ' x := by linarith
    rw [habs, abs_of_nonneg hpos]
    linarith
  rcases le_or_gt (τ' b) 0 with hB | hB
  · refine ⟨b, hbmem, fun x hx => ?_⟩
    have h := incr_of_deriv_ge hτ' hτ'' hx hbmem hx.2
    have hprod : (0 : ℝ) ≤ kap * (b - x) := mul_nonneg (le_of_lt hkap) (by linarith [hx.2])
    have habs : |x - b| = b - x := by
      rw [abs_of_nonpos (by linarith [hx.2])]
      ring
    have hneg : τ' x ≤ 0 := by linarith
    rw [habs, abs_of_nonpos hneg]
    linarith
  · have hmem : (0 : ℝ) ∈ Set.Icc (τ' a) (τ' b) := ⟨le_of_lt hA, le_of_lt hB⟩
    obtain ⟨c, hc, hc0⟩ := intermediate_value_Icc hab hτ'c.continuousOn hmem
    refine ⟨c, hc, fun x hx => ?_⟩
    rcases le_or_gt c x with hcx | hcx
    · have h := incr_of_deriv_ge hτ' hτ'' hc hx hcx
      rw [hc0] at h
      have hprod : (0 : ℝ) ≤ kap * (x - c) := mul_nonneg (le_of_lt hkap) (by linarith)
      have habs : |x - c| = x - c := abs_of_nonneg (by linarith)
      have hpos : (0 : ℝ) ≤ τ' x := by linarith
      rw [habs, abs_of_nonneg hpos]
      linarith
    · have hxc : x ≤ c := le_of_lt hcx
      have h := incr_of_deriv_ge hτ' hτ'' hx hc hxc
      rw [hc0] at h
      have hprod : (0 : ℝ) ≤ kap * (c - x) := mul_nonneg (le_of_lt hkap) (by linarith)
      have habs : |x - c| = c - x := by
        rw [abs_of_nonpos (by linarith)]
        ring
      have hneg : τ' x ≤ 0 := by linarith
      rw [habs, abs_of_nonpos hneg]
      linarith

end Stationary


/-! ### The one-sided piece of van der Corput's estimate -/

section VdCSide

theorem div_le_div_of_le_of_le {a b c d : ℝ} (hbd : 0 < b) (hd : 0 < d)
    (hac : a ≤ c) (hcnn : 0 ≤ c) (hdb : d ≤ b) : a / b ≤ c / d := by
  rw [div_le_div_iff₀ hbd hd]
  exact mul_le_mul hac hdb (le_of_lt hd) hcnn

/-- On an interval where `|τ'| ≥ mu > 0`, the first-derivative test gives
`(4M + M₁(β-α))/(lam·mu)`.  The `τ''`-term is handled by the telescoping identity
`∫ τ''/(τ')² = 1/τ'(α) - 1/τ'(β)`, which is what makes the estimate independent of any upper
bound on `τ''`. -/
theorem norm_integral_osc_side {al be lam mu M M1 : ℝ} (halbe : al ≤ be) (hlam : 0 < lam)
    (hmu : 0 < mu)
    {τ τ' τ'' : ℝ → ℝ} {A A' : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x)
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x) (hτ''c : Continuous τ'')
    (hτ''nn : ∀ x ∈ Set.Icc al be, 0 ≤ τ'' x)
    (hA : ∀ x, HasDerivAt A (A' x) x) (hA'c : Continuous A')
    (hM : ∀ x, ‖A x‖ ≤ M) (hM1 : ∀ x, ‖A' x‖ ≤ M1)
    (hmulow : ∀ x ∈ Set.Icc al be, mu ≤ |τ' x|) :
    ‖∫ x in al..be, osc lam (τ x) * A x‖ ≤ (4 * M + M1 * (be - al)) / (lam * mu) := by
  have hMnn : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM al)
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) (hM1 al)
  have hAc : Continuous A := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hA x).continuousAt
  have hτ'c : Continuous τ' := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ' x).continuousAt
  have huIcc : Set.uIcc al be = Set.Icc al be := Set.uIcc_of_le halbe
  have hτ'ne : ∀ x ∈ Set.uIcc al be, τ' x ≠ 0 := by
    intro x hx
    rw [huIcc] at hx
    intro h0
    have h := hmulow x hx
    rw [h0, abs_zero] at h
    linarith
  set Q : ℝ → ℂ := fun x =>
    (A' x * ((τ' x : ℝ) : ℂ) - A x * ((τ'' x : ℝ) : ℂ)) / (((τ' x : ℝ) : ℂ)) ^ 2 with hQdef
  have hAQ : ∀ x ∈ Set.uIcc al be,
      HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Q x) x := by
    intro x hx
    have hne : ((τ' x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hτ'ne x hx
    have hd : HasDerivAt (fun y : ℝ => ((τ' y : ℝ) : ℂ)) (((τ'' x : ℝ) : ℂ)) x :=
      (hτ' x).ofReal_comp
    exact (hA x).div hd hne
  have hQc : ContinuousOn Q (Set.uIcc al be) := by
    rw [hQdef]
    refine ContinuousOn.div ?_ ?_ ?_
    · exact ((hA'c.continuousOn).mul
        ((Complex.continuous_ofReal.comp hτ'c).continuousOn)).sub
        ((hAc.continuousOn).mul ((Complex.continuous_ofReal.comp hτ''c).continuousOn))
    · exact (((Complex.continuous_ofReal.comp hτ'c)).continuousOn).pow 2
    · intro x hx
      have hne : ((τ' x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hτ'ne x hx
      exact pow_ne_zero 2 hne
  have hbound := norm_integral_osc_ibp_bdry halbe (ne_of_gt hlam) hτ hτ'c hτ'ne hAc hQc hAQ
  have hbd1 : ‖A be‖ / |τ' be| ≤ M / mu := by
    have hbe := hmulow be (Set.right_mem_Icc.mpr halbe)
    exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hbe) hmu (hM be) hMnn hbe
  have hbd2 : ‖A al‖ / |τ' al| ≤ M / mu := by
    have hal := hmulow al (Set.left_mem_Icc.mpr halbe)
    exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hal) hmu (hM al) hMnn hal
  have hQsplit : ∀ x ∈ Set.Icc al be,
      ‖Q x‖ ≤ M1 / mu + M * (τ'' x / (τ' x) ^ 2) := by
    intro x hx
    have hne : τ' x ≠ 0 := hτ'ne x (by rw [huIcc]; exact hx)
    have hmux := hmulow x hx
    have habspos : (0 : ℝ) < |τ' x| := lt_of_lt_of_le hmu hmux
    have hsqpos : (0 : ℝ) < (τ' x) ^ 2 := by positivity
    have habs2 : ‖(((τ' x : ℝ) : ℂ)) ^ 2‖ = (τ' x) ^ 2 := by
      rw [norm_pow, Complex.norm_real, Real.norm_eq_abs, sq_abs]
    have hsq : (τ' x) ^ 2 = |τ' x| * |τ' x| := by
      rw [← sq_abs]
      ring
    have h1 : ‖A' x‖ * |τ' x| / (τ' x) ^ 2 ≤ M1 / mu := by
      rw [hsq, mul_div_mul_right _ _ (ne_of_gt habspos)]
      exact div_le_div_of_le_of_le habspos hmu (hM1 x) hM1nn hmux
    have h2 : ‖A x‖ * |τ'' x| / (τ' x) ^ 2 ≤ M * (τ'' x / (τ' x) ^ 2) := by
      rw [abs_of_nonneg (hτ''nn x hx), mul_div_assoc]
      exact mul_le_mul_of_nonneg_right (hM x) (div_nonneg (hτ''nn x hx) (le_of_lt hsqpos))
    have hQx : ‖Q x‖ ≤ (‖A' x‖ * |τ' x| + ‖A x‖ * |τ'' x|) / (τ' x) ^ 2 := by
      change ‖(A' x * ((τ' x : ℝ) : ℂ) - A x * ((τ'' x : ℝ) : ℂ)) / (((τ' x : ℝ) : ℂ)) ^ 2‖
        ≤ (‖A' x‖ * |τ' x| + ‖A x‖ * |τ'' x|) / (τ' x) ^ 2
      rw [norm_div, habs2]
      refine div_le_div_of_nonneg_right ?_ (le_of_lt hsqpos)
      refine le_trans (norm_sub_le _ _) ?_
      rw [norm_mul, norm_mul, Complex.norm_real, Complex.norm_real, Real.norm_eq_abs,
        Real.norm_eq_abs]
    refine le_trans hQx ?_
    rw [_root_.add_div]
    linarith
  have hdivne : ∀ x ∈ Set.uIcc al be, (τ' x) ^ 2 ≠ 0 :=
    fun x hx => pow_ne_zero 2 (hτ'ne x hx)
  have hcont2 : ContinuousOn (fun x => τ'' x / (τ' x) ^ 2) (Set.uIcc al be) :=
    ContinuousOn.div (hτ''c.continuousOn) ((hτ'c.continuousOn).pow 2) hdivne
  have htel : (∫ x in al..be, τ'' x / (τ' x) ^ 2) = 1 / τ' al - 1 / τ' be := by
    have hd : ∀ x ∈ Set.uIcc al be,
        HasDerivAt (fun y : ℝ => -(τ' y)⁻¹) (τ'' x / (τ' x) ^ 2) x := by
      intro x hx
