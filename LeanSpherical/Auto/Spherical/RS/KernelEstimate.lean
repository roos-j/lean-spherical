      have h := ((hτ' x).inv hne).neg
      refine h.congr_deriv ?_
      field_simp
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt hd hcont2.intervalIntegrable
    rw [h]
    have hane : τ' al ≠ 0 := hτ'ne al Set.left_mem_uIcc
    have hbne : τ' be ≠ 0 := hτ'ne be Set.right_mem_uIcc
    field_simp
    ring
  have htelbd : (1 : ℝ) / τ' al - 1 / τ' be ≤ 2 / mu := by
    have hal := hmulow al (Set.left_mem_Icc.mpr halbe)
    have hbe := hmulow be (Set.right_mem_Icc.mpr halbe)
    have h1 : |(1 : ℝ) / τ' al| ≤ 1 / mu := by
      rw [abs_div, abs_one]
      exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hal) hmu (le_refl (1:ℝ))
        (by norm_num) hal
    have h2 : |(1 : ℝ) / τ' be| ≤ 1 / mu := by
      rw [abs_div, abs_one]
      exact div_le_div_of_le_of_le (lt_of_lt_of_le hmu hbe) hmu (le_refl (1:ℝ))
        (by norm_num) hbe
    have h3 := abs_le.mp h1
    have h4 := abs_le.mp h2
    have hmu' : (2 : ℝ) / mu = 1 / mu + 1 / mu := by ring
    rw [hmu']
    linarith [h3.1, h3.2, h4.1, h4.2]
  have hQintbd : (∫ x in al..be, ‖Q x‖) ≤ M1 * (be - al) / mu + 2 * M / mu := by
    have hi1 : IntervalIntegrable (fun x => ‖Q x‖) volume al be :=
      (hQc.norm).intervalIntegrable
    have hia : IntervalIntegrable (fun _ : ℝ => M1 / mu) volume al be :=
      intervalIntegrable_const
    have hib : IntervalIntegrable (fun x : ℝ => M * (τ'' x / (τ' x) ^ 2)) volume al be :=
      ((continuousOn_const).mul hcont2).intervalIntegrable
    have hi2 : IntervalIntegrable
        (fun x => M1 / mu + M * (τ'' x / (τ' x) ^ 2)) volume al be := hia.add hib
    have hmono := intervalIntegral.integral_mono_on halbe hi1 hi2 hQsplit
    refine le_trans hmono ?_
    rw [intervalIntegral.integral_add hia hib, intervalIntegral.integral_const,
      intervalIntegral.integral_const_mul, htel]
    have hstep : M * ((1 : ℝ) / τ' al - 1 / τ' be) ≤ M * (2 / mu) :=
      mul_le_mul_of_nonneg_left htelbd hMnn
    have h2M : M * (2 / mu) = 2 * M / mu := by ring
    rw [h2M] at hstep
    have hfirst : (be - al) • (M1 / mu) = M1 * (be - al) / mu := by
      rw [smul_eq_mul]
      ring
    rw [hfirst]
    linarith
  have hlamabs : |lam| = lam := abs_of_pos hlam
  rw [hlamabs] at hbound
  refine le_trans hbound ?_
  have hsum : ‖A be‖ / |τ' be| + ‖A al‖ / |τ' al| + (∫ x in al..be, ‖Q x‖)
      ≤ (4 * M + M1 * (be - al)) / mu := by
    have heq : M / mu + M / mu + (M1 * (be - al) / mu + 2 * M / mu)
        = (4 * M + M1 * (be - al)) / mu := by
      field_simp
      ring
    linarith [hbd1, hbd2, hQintbd]
  rw [div_le_div_iff₀ hlam (by positivity : (0:ℝ) < lam * mu)]
  have hmul : (4 * M + M1 * (be - al)) * lam
      = ((4 * M + M1 * (be - al)) / mu) * (lam * mu) := by
    field_simp
  calc (‖A be‖ / |τ' be| + ‖A al‖ / |τ' al| + ∫ x in al..be, ‖Q x‖) * (lam * mu)
      ≤ ((4 * M + M1 * (be - al)) / mu) * (lam * mu) :=
        mul_le_mul_of_nonneg_right hsum (by positivity)
    _ = (4 * M + M1 * (be - al)) * lam := hmul.symm

end VdCSide


/-! ### Van der Corput's second-derivative test -/

section VdC

/-- **Van der Corput's second-derivative test.**  If `τ'' ≥ kap > 0`, `‖A‖ ≤ M` and
`‖A'‖ ≤ M₁`, then `‖∫_a^b e^{i lam τ}A‖ ≤ (10M + 2M₁(b-a))/√(lam·kap)`.  The gain
`(lam·kap)^{-1/2}` is the curvature gain: the interval of length `2(lam·kap)^{-1/2}` around the
stationary point is estimated trivially and the first-derivative test is applied outside it. -/
theorem norm_integral_osc_vdc {a b lam kap M M1 : ℝ} (hab : a ≤ b) (hlam : 0 < lam)
    (hkap : 0 < kap)
    {τ τ' τ'' : ℝ → ℝ} {A A' : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x)
    (hτ' : ∀ x, HasDerivAt τ' (τ'' x) x) (hτ''c : Continuous τ'')
    (hτ'' : ∀ x ∈ Set.Icc a b, kap ≤ τ'' x)
    (hA : ∀ x, HasDerivAt A (A' x) x) (hA'c : Continuous A')
    (hM : ∀ x, ‖A x‖ ≤ M) (hM1 : ∀ x, ‖A' x‖ ≤ M1) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (10 * M + 2 * M1 * (b - a)) / Real.sqrt (lam * kap) := by
  have hMnn : (0 : ℝ) ≤ M := le_trans (norm_nonneg _) (hM a)
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) (hM1 a)
  have hτ''nn : ∀ x ∈ Set.Icc a b, (0 : ℝ) ≤ τ'' x :=
    fun x hx => le_trans (le_of_lt hkap) (hτ'' x hx)
  have hAc : Continuous A := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hA x).continuousAt
  have hτc : Continuous τ := by
    refine continuous_iff_continuousAt.mpr fun x => ?_
    exact (hτ x).continuousAt
  have hoscc : Continuous fun x : ℝ => osc lam (τ x) * A x := by
    refine Continuous.mul ?_ hAc
    exact Complex.continuous_exp.comp
      ((Complex.continuous_ofReal.comp (continuous_const.mul hτc)).mul continuous_const)
  have hsqpos : (0 : ℝ) < Real.sqrt (lam * kap) := Real.sqrt_pos.mpr (by positivity)
  set del : ℝ := 1 / Real.sqrt (lam * kap) with hdel
  have hdelpos : (0 : ℝ) < del := by rw [hdel]; positivity
  have hprod : lam * kap * del = Real.sqrt (lam * kap) := by
    have hs : Real.sqrt (lam * kap) * Real.sqrt (lam * kap) = lam * kap :=
      Real.mul_self_sqrt (by positivity)
    rw [hdel, mul_one_div, eq_comm, eq_div_iff (ne_of_gt hsqpos)]
    linarith [hs]
  obtain ⟨c, hc, hlow⟩ := exists_stationary_lower hab hkap hτ' hτ''
  set p : ℝ := max a (min b (c - del)) with hp
  set q : ℝ := max a (min b (c + del)) with hq
  have hap : a ≤ p := le_max_left _ _
  have hqb : q ≤ b := max_le hab (min_le_left _ _)
  have hpq : p ≤ q := by
    rw [hp, hq]
    exact max_le_max (le_refl a) (min_le_min (le_refl b) (by linarith))
  have hpb : p ≤ b := le_trans hpq hqb
  have haq : a ≤ q := le_trans hap hpq
  -- the three pieces
  have hsplit : (∫ x in a..b, osc lam (τ x) * A x)
      = (∫ x in a..p, osc lam (τ x) * A x) + (∫ x in p..q, osc lam (τ x) * A x)
        + ∫ x in q..b, osc lam (τ x) * A x := by
    rw [intervalIntegral.integral_add_adjacent_intervals
        (hoscc.intervalIntegrable a p) (hoscc.intervalIntegrable p q),
      intervalIntegral.integral_add_adjacent_intervals
        (hoscc.intervalIntegrable a q) (hoscc.intervalIntegrable q b)]
  -- the middle piece
  have hmid : ‖∫ x in p..q, osc lam (τ x) * A x‖ ≤ M * (2 * del) := by
    have hqp : q - p ≤ 2 * del := by
      have hmin : min b (c + del) ≤ min b (c - del) + 2 * del := by
        rcases le_total b (c - del) with h | h
        · rw [min_eq_left h]
          have h2 : min b (c + del) ≤ b := min_le_left _ _
          linarith
        · rw [min_eq_right h]
          have h2 : min b (c + del) ≤ c + del := min_le_right _ _
          linarith
      have hmax : max a (min b (c + del)) ≤ max a (min b (c - del)) + 2 * del := by
        rcases le_total (min b (c + del)) a with h | h
        · rw [max_eq_left h]
          have h2 : a ≤ max a (min b (c - del)) := le_max_left _ _
          linarith
        · rw [max_eq_right h]
          have h2 : min b (c - del) ≤ max a (min b (c - del)) := le_max_right _ _
          linarith
      rw [hp, hq]
      linarith [hmax]
    have hbd := intervalIntegral.norm_integral_le_of_norm_le_const
      (C := M) (a := p) (b := q) (f := fun x : ℝ => osc lam (τ x) * A x) ?_
    · refine le_trans hbd ?_
      have habsq : |q - p| = q - p := abs_of_nonneg (by linarith)
      rw [habsq]
      exact mul_le_mul_of_nonneg_left hqp hMnn
    · intro x _
      rw [norm_mul, norm_osc, one_mul]
      exact hM x
  -- the right piece
  have hright : ‖∫ x in q..b, osc lam (τ x) * A x‖
      ≤ (4 * M + M1 * (b - q)) / (lam * (kap * del)) := by
    rcases le_or_gt b (c + del) with hcase | hcase
    · have hqeqb : q = b := by
        rw [hq, min_eq_left hcase, max_eq_right hab]
      rw [hqeqb, intervalIntegral.integral_same, norm_zero]
      have hnn : (0 : ℝ) ≤ (4 * M + M1 * (b - b)) / (lam * (kap * del)) := by
        have : (b : ℝ) - b = 0 := by ring
        rw [this]
        positivity
      simpa [hqeqb] using hnn
    · have hqge : c + del ≤ q := by
        rw [hq, min_eq_right (le_of_lt hcase)]
        exact le_max_right _ _
      refine norm_integral_osc_side hqb hlam (by positivity) hτ hτ' hτ''c
        (fun x hx => hτ''nn x ⟨le_trans haq hx.1, hx.2⟩) hA hA'c hM hM1 ?_
      intro x hx
      have hxab : x ∈ Set.Icc a b := ⟨le_trans haq hx.1, hx.2⟩
      have hxc : del ≤ |x - c| := by
        have h1 : c + del ≤ x := le_trans hqge hx.1
        rw [abs_of_nonneg (by linarith)]
        linarith
      have h := hlow x hxab
      calc kap * del ≤ kap * |x - c| := mul_le_mul_of_nonneg_left hxc (le_of_lt hkap)
        _ ≤ |τ' x| := h
  -- the left piece
  have hleft : ‖∫ x in a..p, osc lam (τ x) * A x‖
      ≤ (4 * M + M1 * (p - a)) / (lam * (kap * del)) := by
    rcases le_or_gt (c - del) a with hcase | hcase
    · have hpeqa : p = a := by
        rw [hp, max_eq_left]
        exact le_trans (min_le_right _ _) hcase
      rw [hpeqa, intervalIntegral.integral_same, norm_zero]
      have hnn : (0 : ℝ) ≤ (4 * M + M1 * (a - a)) / (lam * (kap * del)) := by
        have : (a : ℝ) - a = 0 := by ring
        rw [this]
        positivity
      simpa [hpeqa] using hnn
    · have hple : p ≤ c - del := by
        have hcb : c ≤ b := hc.2
        rw [hp, min_eq_right (by linarith), max_eq_right (le_of_lt hcase)]
      refine norm_integral_osc_side hap hlam (by positivity) hτ hτ' hτ''c
        (fun x hx => hτ''nn x ⟨hx.1, le_trans hx.2 hpb⟩) hA hA'c hM hM1 ?_
      intro x hx
      have hxab : x ∈ Set.Icc a b := ⟨hx.1, le_trans hx.2 hpb⟩
      have hxc : del ≤ |x - c| := by
        have h1 : x ≤ c - del := le_trans hx.2 hple
        rw [abs_of_nonpos (by linarith)]
        linarith
      have h := hlow x hxab
      calc kap * del ≤ kap * |x - c| := mul_le_mul_of_nonneg_left hxc (le_of_lt hkap)
        _ ≤ |τ' x| := h
  -- assemble
  rw [hsplit]
  refine le_trans (norm_add_le _ _) ?_
  refine le_trans (add_le_add (le_trans (norm_add_le _ _) (add_le_add hleft hmid)) hright) ?_
  have hkd : lam * (kap * del) = Real.sqrt (lam * kap) := by
    rw [← hprod]
    ring
  rw [hkd]
  have hmd : M * (2 * del) = 2 * M / Real.sqrt (lam * kap) := by
    rw [hdel]
    field_simp
  rw [hmd]
  have hpa : (0 : ℝ) ≤ p - a := by linarith
  have hbq : (0 : ℝ) ≤ b - q := by linarith
  have hsum : (p - a) + (b - q) ≤ b - a := by linarith
  have hcomb : (4 * M + M1 * (p - a)) / Real.sqrt (lam * kap)
        + 2 * M / Real.sqrt (lam * kap)
        + (4 * M + M1 * (b - q)) / Real.sqrt (lam * kap)
      = ((4 * M + M1 * (p - a)) + 2 * M + (4 * M + M1 * (b - q)))
        / Real.sqrt (lam * kap) := by
    ring
  rw [hcomb]
  refine div_le_div_of_nonneg_right ?_ (le_of_lt hsqpos)
  nlinarith [mul_le_mul_of_nonneg_left hsum hM1nn, mul_nonneg hM1nn hpa,
    mul_nonneg hM1nn hbq]

end VdC


/-! ### The phase of the kernel in the first frequency variable -/

section KernelPhase

/-- Flipping the sign of the phase does not change the modulus of an oscillatory integral. -/
theorem norm_integral_osc_conj {a b lam : ℝ} (τ : ℝ → ℝ) (A : ℝ → ℂ) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      = ‖∫ x in a..b, osc lam (-τ x) * (starRingEnd ℂ) (A x)‖ := by
  have hpt : ∀ x : ℝ, (starRingEnd ℂ) (osc lam (τ x) * A x)
      = osc lam (-τ x) * (starRingEnd ℂ) (A x) := by
    intro x
    rw [map_mul, osc, osc]
    congr 1
    rw [← Complex.exp_conj]
    congr 1
    rw [map_mul, Complex.conj_I, Complex.conj_ofReal]
    push_cast
    ring
  have hcj : (starRingEnd ℂ) (∫ x in a..b, osc lam (τ x) * A x)
      = ∫ x in a..b, (starRingEnd ℂ) (osc lam (τ x) * A x) := by
    simp only [intervalIntegral, map_sub, integral_conj]
  rw [← intervalIntegral.integral_congr (fun x _ => hpt x), ← hcj, RCLike.norm_conj]

/-- The radial variable in the plane, as a function of the first coordinate. -/
noncomputable def rr (w2 w1 : ℝ) : ℝ := Real.sqrt (w1 ^ 2 + w2 ^ 2)

theorem rr_pos {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) : 0 < rr w2 w1 := by
  rw [rr, Real.sqrt_pos]
  positivity

theorem rr_sq {w2 : ℝ} (w1 : ℝ) : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := by
  rw [rr, Real.sq_sqrt (by positivity)]

theorem hasDerivAt_rr {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) :
    HasDerivAt (rr w2) (w1 / rr w2 w1) w1 := by
  have hinner : HasDerivAt (fun x : ℝ => x ^ 2 + w2 ^ 2) (2 * w1) w1 := by
    have h := (hasDerivAt_pow 2 w1).add_const (w2 ^ 2)
    refine h.congr_deriv ?_
    push_cast
    ring
  have hne : w1 ^ 2 + w2 ^ 2 ≠ 0 := by positivity
  have h := hinner.sqrt hne
  refine h.congr_deriv ?_
  rw [rr]
  have hs : (0 : ℝ) < Real.sqrt (w1 ^ 2 + w2 ^ 2) := by
    rw [Real.sqrt_pos]
    positivity
  field_simp

/-- The second derivative of the radial variable: this is the curvature of the circle. -/
theorem hasDerivAt_rr' {w2 : ℝ} (h2 : w2 ≠ 0) (w1 : ℝ) :
    HasDerivAt (fun x : ℝ => x / rr w2 x) (w2 ^ 2 / (rr w2 w1) ^ 3) w1 := by
  have hrne : rr w2 w1 ≠ 0 := ne_of_gt (rr_pos h2 w1)
  have h := (hasDerivAt_id w1).div (hasDerivAt_rr h2 w1) hrne
  refine h.congr_deriv ?_
  have hsq : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := rr_sq w1
  simp only [id_eq]
  field_simp
  nlinarith [hsq, rr_pos h2 w1]

/-- The curvature lower bound on the relevant range. -/
theorem rr_curvature_lower {w2 w1 R : ℝ} (h2 : 0 < w2) (hw1 : |w1| ≤ R) :
    w2 ^ 2 / (Real.sqrt (R ^ 2 + w2 ^ 2)) ^ 3 ≤ w2 ^ 2 / (rr w2 w1) ^ 3 := by
  have hrpos : 0 < rr w2 w1 := rr_pos (ne_of_gt h2) w1
  have hsq : (rr w2 w1) ^ 2 = w1 ^ 2 + w2 ^ 2 := rr_sq w1
  have hw1sq : w1 ^ 2 ≤ R ^ 2 := by
    nlinarith [sq_abs w1, abs_nonneg w1]
  have h1 : rr w2 w1 ≤ Real.sqrt (R ^ 2 + w2 ^ 2) := by
    rw [rr]
    exact Real.sqrt_le_sqrt (by linarith)
  have hcube : (rr w2 w1) ^ 3 ≤ (Real.sqrt (R ^ 2 + w2 ^ 2)) ^ 3 :=
    pow_le_pow_left₀ (le_of_lt hrpos) h1 3
  exact div_le_div_of_nonneg_left (by positivity) (by positivity) hcube

end KernelPhase


/-! ### The kernel in polar coordinates -/

section KernelPolar

/-- The coefficient of the linear radial phase: `⟨u,θ(φ)⟩ + εt`.  It vanishes exactly at the
angles where the radial direction is stationary. -/
def psiu (u : Pl) (ε t φ : ℝ) : ℝ := (inner ℝ u (pt 1 φ) : ℝ) + ε * t

/-- The kernel of the single-scale operator. -/
def kern (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) : ℂ :=
  ∫ ω : Pl, ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω

/-- Polar derivative data for the multiplier: the radial derivatives `mr k` and the angular
derivatives `ma k` of `(r,φ) ↦ m t (pt r φ)`, up to third order.  Radial derivatives gain a
factor `2^{-j}` each; angular derivatives are bounded. -/
structure PolarData (j : ℕ) (m : ℝ → Pl → ℂ)
    (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (B0 : ℝ) : Prop where
  r0 : ∀ (t φ r : ℝ), mr 0 t φ r = m t (pt r φ)
  rd : ∀ (k : ℕ), k ≤ 3 → ∀ (t φ r : ℝ), HasDerivAt (mr k t φ) (mr (k + 1) t φ r) r
  rc : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ : ℝ), Continuous (mr k t φ)
  rb : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ r : ℝ),
    ‖mr k t φ r‖ ≤ B0 * (2 : ℝ) ^ (-((k : ℤ) * (j : ℤ)))
  rz : ∀ (k : ℕ), k ≤ 4 → ∀ (t φ r : ℝ), r = 0 ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r → mr k t φ r = 0
  a0 : ∀ (t r φ : ℝ), ma 0 t r φ = m t (pt r φ)
  ad : ∀ (k : ℕ), k ≤ 2 → ∀ (t r φ : ℝ), HasDerivAt (ma k t r) (ma (k + 1) t r φ) φ
  ac : ∀ (k : ℕ), k ≤ 3 → ∀ (t r : ℝ), Continuous (ma k t r)
  ab : ∀ (k : ℕ), k ≤ 3 → ∀ (t r φ : ℝ), ‖ma k t r φ‖ ≤ B0

theorem PolarData.nonneg {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) : 0 ≤ B0 :=
  le_trans (norm_nonneg _) (hp.ab 0 (by norm_num) 0 0 0)

/-- In polar coordinates the kernel integrand is an oscillatory factor with a phase that is
*linear* in the radius. -/
theorem kern_polar_pt (j : ℕ) (m : ℝ → Pl → ℂ) (ε t : ℝ) (u : Pl) {r : ℝ} (hr : 0 ≤ r) (φ : ℝ) :
    (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))
      = osc (2 * π) (r * psiu u ε t φ) * ((r : ℂ) * m t (pt r φ)) := by
  have hinner : (inner ℝ u (pt r φ) : ℝ) = r * (inner ℝ u (pt 1 φ) : ℝ) := by
    rw [pt_eq_smul r φ, real_inner_smul_right]
  have hE : ee (-(r * (inner ℝ u (pt 1 φ) : ℝ)))
        * Complex.exp (((2 * π * ε * t * r : ℝ) : ℂ) * Complex.I)
      = osc (2 * π) (r * psiu u ε t φ) := by
    rw [ee, osc, ← Complex.exp_add, psiu]
    congr 1
    push_cast
    ring
  rw [mfull, hinner, norm_pt r φ hr, Complex.real_smul, ← hE]
  ring

theorem continuous_kern_integrand {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    Continuous fun ω : Pl => ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω := by
  refine Continuous.mul ?_ (contDiff_mfull hm ε t).continuous
  refine Complex.continuous_exp.comp ?_
  refine (Complex.continuous_ofReal.comp ?_).mul continuous_const
  exact continuous_const.mul (continuous_const.inner continuous_id).neg

/-- The amplitude of the radial oscillatory integral. -/
def radAmp (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := (r : ℂ) * mr 0 t φ r

/-- Its first derivative. -/
def radAmp1 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := mr 0 t φ r + (r : ℂ) * mr 1 t φ r

/-- Its second derivative. -/
def radAmp2 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 2 * mr 1 t φ r + (r : ℂ) * mr 2 t φ r

/-- Its third derivative. -/
def radAmp3 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 3 * mr 2 t φ r + (r : ℂ) * mr 3 t φ r

/-- Its fourth derivative. -/
def radAmp4 (mr : ℕ → ℝ → ℝ → ℝ → ℂ) (t φ r : ℝ) : ℂ := 4 * mr 3 t φ r + (r : ℂ) * mr 4 t φ r

theorem hasDerivAt_radAmp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp mr t φ) (radAmp1 mr t φ r) r := by
  have h := (hasDerivAt_ofReal_id r).mul (hp.rd 0 (by norm_num) t φ r)
  refine h.congr_deriv ?_
  rw [radAmp1]
  ring

theorem hasDerivAt_radAmp1 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp1 mr t φ) (radAmp2 mr t φ r) r := by
  have h := (hp.rd 0 (by norm_num) t φ r).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 1 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp2]
  ring

theorem hasDerivAt_radAmp2 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp2 mr t φ) (radAmp3 mr t φ r) r := by
  have h := ((hp.rd 1 (by norm_num) t φ r).const_mul (2 : ℂ)).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 2 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp3]
  ring

theorem hasDerivAt_radAmp3 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ r : ℝ) :
    HasDerivAt (radAmp3 mr t φ) (radAmp4 mr t φ r) r := by
  have h := ((hp.rd 2 (by norm_num) t φ r).const_mul (3 : ℂ)).add
    ((hasDerivAt_ofReal_id r).mul (hp.rd 3 (by norm_num) t φ r))
  refine h.congr_deriv ?_
  rw [radAmp4]
  ring

theorem continuous_radAmp3 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) : Continuous (radAmp3 mr t φ) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul (hp.rc 2 (by norm_num) t φ)
  · exact Complex.continuous_ofReal.mul (hp.rc 3 (by norm_num) t φ)

theorem continuous_radAmp4 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) : Continuous (radAmp4 mr t φ) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul (hp.rc 3 (by norm_num) t φ)
  · exact Complex.continuous_ofReal.mul (hp.rc 4 (by norm_num) t φ)

theorem radAmp_zero_left {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) :
    radAmp mr t φ 0 = 0 ∧ radAmp1 mr t φ 0 = 0 ∧ radAmp2 mr t φ 0 = 0
      ∧ radAmp3 mr t φ 0 = 0 := by
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [radAmp]
    simp
  · rw [radAmp1, hp.rz 0 (by norm_num) t φ 0 (Or.inl rfl)]
    simp
  · rw [radAmp2, hp.rz 1 (by norm_num) t φ 0 (Or.inl rfl)]
    simp
  · rw [radAmp3, hp.rz 2 (by norm_num) t φ 0 (Or.inl rfl)]
    simp

theorem radAmp_zero_right {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (t φ : ℝ) {r : ℝ} (hr : (2 : ℝ) ^ ((j : ℤ) + 1) < r) :
    radAmp mr t φ r = 0 ∧ radAmp1 mr t φ r = 0 ∧ radAmp2 mr t φ r = 0
      ∧ radAmp3 mr t φ r = 0 := by
  have h0 := hp.rz 0 (by norm_num) t φ r (Or.inr hr)
  have h1 := hp.rz 1 (by norm_num) t φ r (Or.inr hr)
  have h2 := hp.rz 2 (by norm_num) t φ r (Or.inr hr)
  have h3 := hp.rz 3 (by norm_num) t φ r (Or.inr hr)
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [radAmp, h0, mul_zero]
  · rw [radAmp1, h0, h1]
    simp
  · rw [radAmp2, h1, h2]
    simp
  · rw [radAmp3, h2, h3]
    simp

/-- The radial integral of the kernel integrand is an interval integral with a linear phase. -/
theorem radial_integral_eq {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) :
    (∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))
      = ∫ r in (0 : ℝ)..((2 : ℝ) ^ ((j : ℤ) + 2)),
          osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have hpt : ∀ r ∈ Set.Ioi (0 : ℝ),
      (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))
        = osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
    intro r hr
    rw [kern_polar_pt j m ε t u (le_of_lt hr) φ, radAmp, hp.r0]
  rw [setIntegral_congr_fun measurableSet_Ioi hpt]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ) \ Set.Ioc (0 : ℝ) b,
      osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r = 0 := by
    intro r hr
    have hrb : b < r := by
      rcases hr with ⟨hr1, hr2⟩
      rw [Set.mem_Ioc] at hr2
      exact not_le.mp fun h => hr2 ⟨hr1, h⟩
    have hgt : (2 : ℝ) ^ ((j : ℤ) + 1) < r := by
      refine lt_of_lt_of_le ?_ (le_of_lt hrb)
      rw [hb]
      exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
    rw [(radAmp_zero_right hp t φ hgt).1, mul_zero]
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi Set.Ioc_subset_Ioi_self
    hzero]
  rw [intervalIntegral.integral_of_le (le_of_lt hbpos)]

/-- **The radial estimate.**  Four integrations by parts in the radius, whose phase is linear,
give four powers of `(2^j |ψ|)` off the trivial size `2^{2j}`. -/
theorem norm_radial_integral_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) (hψ : psiu u ε t φ ≠ 0) :
    ‖∫ r in Set.Ioi (0 : ℝ),
        (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))‖
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hlam : (2 * π : ℝ) ≠ 0 := by
    have := Real.pi_pos
    positivity
  have hbgt : (2 : ℝ) ^ ((j : ℤ) + 1) < b := by
    rw [hb]
    exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
  rw [radial_integral_eq hp ε t u φ]
  have hibp := norm_integral_osc_linear_ibp4 (a := (0 : ℝ)) (b := b) (lam := 2 * π)
    (psi := psiu u ε t φ) (le_of_lt hbpos) hlam hψ
    (hasDerivAt_radAmp hp t φ) (hasDerivAt_radAmp1 hp t φ) (hasDerivAt_radAmp2 hp t φ)
    (hasDerivAt_radAmp3 hp t φ) (continuous_radAmp4 hp t φ)
    (radAmp_zero_left hp t φ).1 (radAmp_zero_right hp t φ hbgt).1
    (radAmp_zero_left hp t φ).2.1 (radAmp_zero_right hp t φ hbgt).2.1
    (radAmp_zero_left hp t φ).2.2.1 (radAmp_zero_right hp t φ hbgt).2.2.1
    (radAmp_zero_left hp t φ).2.2.2 (radAmp_zero_right hp t φ hbgt).2.2.2
  have hA4 : ∀ r ∈ Set.Icc (0 : ℝ) b,
      ‖radAmp4 mr t φ r‖ ≤ 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
    intro r hr
    have h3 : ‖mr 3 t φ r‖ ≤ B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
      have h := hp.rb 3 (by norm_num) t φ r
      norm_num at h
      convert h using 3
      norm_num
    have h4 : ‖mr 4 t φ r‖ ≤ B0 * (2 : ℝ) ^ (-(4 * (j : ℤ))) := by
      have h := hp.rb 4 (by norm_num) t φ r
      norm_num at h
      convert h using 3
      norm_num
    have hrb : |r| ≤ b := by
      rw [abs_of_nonneg hr.1]
      exact hr.2
    have hstep : ‖radAmp4 mr t φ r‖ ≤ 4 * ‖mr 3 t φ r‖ + b * ‖mr 4 t φ r‖ := by
      rw [radAmp4]
      refine le_trans (norm_add_le _ _) ?_
      rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
      have h4n : ‖(4 : ℂ)‖ = 4 := by norm_num
      rw [h4n]
      have hmul : |r| * ‖mr 4 t φ r‖ ≤ b * ‖mr 4 t φ r‖ :=
        mul_le_mul_of_nonneg_right hrb (norm_nonneg _)
      linarith
    have hbval : b * ((2 : ℝ) ^ (-(4 * (j : ℤ)))) = 4 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
      rw [hb, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      rw [show ((j : ℤ) + 2 + -(4 * (j : ℤ))) = 2 + -(3 * (j : ℤ)) by ring]
      rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
    calc ‖radAmp4 mr t φ r‖ ≤ 4 * ‖mr 3 t φ r‖ + b * ‖mr 4 t φ r‖ := hstep
      _ ≤ 4 * (B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) + b * (B0 * (2 : ℝ) ^ (-(4 * (j : ℤ)))) := by
          refine add_le_add (by linarith) ?_
          exact mul_le_mul_of_nonneg_left h4 (le_of_lt hbpos)
      _ = 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))) := by
          rw [show b * (B0 * (2 : ℝ) ^ (-(4 * (j : ℤ))))
            = B0 * (b * ((2 : ℝ) ^ (-(4 * (j : ℤ))))) by ring, hbval]
          ring
  have hintA4 : (∫ r in (0 : ℝ)..b, ‖radAmp4 mr t φ r‖)
      ≤ b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) := by
    have hint1 : IntervalIntegrable (fun r => ‖radAmp4 mr t φ r‖) volume 0 b :=
      ((continuous_radAmp4 hp t φ).norm).intervalIntegrable 0 b
    have hint2 : IntervalIntegrable
        (fun _ : ℝ => 8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) volume 0 b :=
      intervalIntegrable_const
    have h := intervalIntegral.integral_mono_on (le_of_lt hbpos) hint1 hint2 hA4
    rw [intervalIntegral.integral_const] at h
    have heq : (b - 0) • (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))))
        = b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))) := by
      rw [smul_eq_mul]
      ring
    rw [heq] at h
    exact h
  have hpsipos : (0 : ℝ) < |psiu u ε t φ| := abs_pos.mpr hψ
  have hbv : b * ((2 : ℝ) ^ (-(3 * (j : ℤ)))) = 4 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := by
    rw [hb, ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    rw [show ((j : ℤ) + 2 + -(3 * (j : ℤ))) = 2 + -(2 * (j : ℤ)) by ring]
    rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    norm_num
  have habs : |2 * π| = 2 * π := abs_of_nonneg (by positivity)
  have hquart : (256 : ℝ) ≤ |2 * π| ^ 4 := by
    rw [habs]
    have h4 : (4 : ℝ) ≤ 2 * π := by linarith [Real.two_le_pi]
    have h := pow_le_pow_left₀ (by norm_num : (0 : ℝ) ≤ 4) h4 4
    norm_num at h
    exact h
  have hfinal : (|2 * π| ^ 4 * |psiu u ε t φ| ^ 4)⁻¹ * (b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))))
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
    have hlhs : (|2 * π| ^ 4 * |psiu u ε t φ| ^ 4)⁻¹
          * (b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ)))))
        = (32 / |2 * π| ^ 4) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ)))) / |psiu u ε t φ| ^ 4 := by
      rw [show b * (8 * B0 * (2 : ℝ) ^ (-(3 * (j : ℤ))))
        = 8 * B0 * (b * ((2 : ℝ) ^ (-(3 * (j : ℤ))))) by ring, hbv]
      rw [mul_inv]
      field_simp
      ring
    rw [hlhs]
    have hfac : (32 : ℝ) / |2 * π| ^ 4 ≤ 1 := by
      rw [div_le_one (by nlinarith)]
      linarith
    have hnum : (0 : ℝ) ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := by positivity
    refine div_le_div_of_nonneg_right ?_ (by positivity)
    calc (32 / |2 * π| ^ 4) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))))
        ≤ 1 * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ)))) := mul_le_mul_of_nonneg_right hfac hnum
      _ = B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) := one_mul _
  refine le_trans hibp (le_trans ?_ hfinal)
  exact mul_le_mul_of_nonneg_left hintA4 (by positivity)

end KernelPolar


/-! ### Two integrations by parts with explicit amplitude bounds -/

section IbpChain

/-- The amplitude after one integration by parts, `(A/τ')`. -/
def chainB (τ1 τ2 : ℝ → ℝ) (A A1 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A1 x / ((τ1 x : ℝ) : ℂ) - A x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2

/-- Its derivative. -/
def chainB1 (τ1 τ2 τ3 : ℝ → ℝ) (A A1 A2 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A2 x / ((τ1 x : ℝ) : ℂ) - 2 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2
    - A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 2
    + 2 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 3

/-- The amplitude after two integrations by parts. -/
def chainC (τ1 τ2 τ3 : ℝ → ℝ) (A A1 A2 : ℝ → ℂ) (x : ℝ) : ℂ :=
  A2 x / ((τ1 x : ℝ) : ℂ) ^ 2 - 3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3
    - A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3
    + 3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4

theorem hasDerivAt_chain_first {τ1 τ2 : ℝ → ℝ} {A A1 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hA : HasDerivAt A (A1 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (fun y => A y / ((τ1 y : ℝ) : ℂ)) (chainB τ1 τ2 A A1 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have h := hA.div hτ1C hneC
  refine h.congr_deriv ?_
  rw [chainB]
  field_simp

theorem hasDerivAt_chainB {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hτ2 : HasDerivAt τ2 (τ3 x) x)
    (hA : HasDerivAt A (A1 x) x) (hA1 : HasDerivAt A1 (A2 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (chainB τ1 τ2 A A1) (chainB1 τ1 τ2 τ3 A A1 A2 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have hτ2C : HasDerivAt (fun z : ℝ => ((τ2 z : ℝ) : ℂ)) ((τ3 x : ℝ) : ℂ) x :=
    hτ2.ofReal_comp
  have hsq : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ) ^ 2)
      (2 * ((τ1 x : ℝ) : ℂ) * ((τ2 x : ℝ) : ℂ)) x := by
    have h := hτ1C.pow 2
    refine h.congr_deriv ?_
    push_cast
    ring
  have hsqne : ((τ1 x : ℝ) : ℂ) ^ 2 ≠ 0 := pow_ne_zero _ hneC
  have hfirst : HasDerivAt (fun y => A1 y / ((τ1 y : ℝ) : ℂ))
      ((A2 x * ((τ1 x : ℝ) : ℂ) - A1 x * ((τ2 x : ℝ) : ℂ)) / ((τ1 x : ℝ) : ℂ) ^ 2) x :=
    hA1.div hτ1C hneC
  have hnum : HasDerivAt (fun y => A y * ((τ2 y : ℝ) : ℂ))
      (A1 x * ((τ2 x : ℝ) : ℂ) + A x * ((τ3 x : ℝ) : ℂ)) x := hA.mul hτ2C
  have hsecond : HasDerivAt (fun y => A y * ((τ2 y : ℝ) : ℂ) / ((τ1 y : ℝ) : ℂ) ^ 2)
      (((A1 x * ((τ2 x : ℝ) : ℂ) + A x * ((τ3 x : ℝ) : ℂ)) * ((τ1 x : ℝ) : ℂ) ^ 2
        - A x * ((τ2 x : ℝ) : ℂ) * (2 * ((τ1 x : ℝ) : ℂ) * ((τ2 x : ℝ) : ℂ)))
          / (((τ1 x : ℝ) : ℂ) ^ 2) ^ 2) x := hnum.div hsq hsqne
  have h := hfirst.sub hsecond
  refine h.congr_deriv ?_
  rw [chainB1]
  field_simp
  ring

theorem hasDerivAt_chainB_div {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {x : ℝ}
    (hτ1 : HasDerivAt τ1 (τ2 x) x) (hτ2 : HasDerivAt τ2 (τ3 x) x)
    (hA : HasDerivAt A (A1 x) x) (hA1 : HasDerivAt A1 (A2 x) x)
    (hne : τ1 x ≠ 0) :
    HasDerivAt (fun y => chainB τ1 τ2 A A1 y / ((τ1 y : ℝ) : ℂ))
      (chainC τ1 τ2 τ3 A A1 A2 x) x := by
  have hneC : ((τ1 x : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hne
  have hτ1C : HasDerivAt (fun z : ℝ => ((τ1 z : ℝ) : ℂ)) ((τ2 x : ℝ) : ℂ) x :=
    hτ1.ofReal_comp
  have h := (hasDerivAt_chainB hτ1 hτ2 hA hA1 hne).div hτ1C hneC
  refine h.congr_deriv ?_
  rw [chainC, chainB1, chainB]
  field_simp
  ring

theorem continuous_chainB {τ1 τ2 : ℝ → ℝ} {A A1 : ℝ → ℂ}
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hAc : Continuous A) (hA1c : Continuous A1)
    (hne : ∀ x, τ1 x ≠ 0) : Continuous (chainB τ1 τ2 A A1) := by
  have hτ1C : Continuous fun x : ℝ => ((τ1 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ1c
  have hτ2C : Continuous fun x : ℝ => ((τ2 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ2c
  have hneC : ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ≠ 0 := fun x => by exact_mod_cast hne x
  refine Continuous.sub (hA1c.div hτ1C hneC) ?_
  exact (hAc.mul hτ2C).div (hτ1C.pow 2) fun x => pow_ne_zero _ (hneC x)

theorem continuous_chainC {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hAc : Continuous A) (hA1c : Continuous A1) (hA2c : Continuous A2)
    (hne : ∀ x, τ1 x ≠ 0) : Continuous (chainC τ1 τ2 τ3 A A1 A2) := by
  have hτ1C : Continuous fun x : ℝ => ((τ1 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ1c
  have hτ2C : Continuous fun x : ℝ => ((τ2 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ2c
  have hτ3C : Continuous fun x : ℝ => ((τ3 x : ℝ) : ℂ) := Complex.continuous_ofReal.comp hτ3c
  have hneC : ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ≠ 0 := fun x => by exact_mod_cast hne x
  have hp : ∀ n : ℕ, ∀ x : ℝ, ((τ1 x : ℝ) : ℂ) ^ n ≠ 0 := fun n x => pow_ne_zero _ (hneC x)
  refine Continuous.add (Continuous.sub (Continuous.sub ?_ ?_) ?_) ?_
  · exact hA2c.div (hτ1C.pow 2) (hp 2)
  · exact ((continuous_const.mul hA1c).mul hτ2C).div (hτ1C.pow 3) (hp 3)
  · exact (hAc.mul hτ3C).div (hτ1C.pow 3) (hp 3)
  · exact ((continuous_const.mul hAc).mul (hτ2C.pow 2)).div (hτ1C.pow 4) (hp 4)

/-- The size of the amplitude after two integrations by parts. -/
theorem norm_chainC_le {τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ} {mu M0 M1 M2 T2 T3 : ℝ}
    (hmu : 0 < mu) {x : ℝ} (hlow : mu ≤ |τ1 x|)
    (hM0 : ‖A x‖ ≤ M0) (hM1 : ‖A1 x‖ ≤ M1) (hM2 : ‖A2 x‖ ≤ M2)
    (hT2 : |τ2 x| ≤ T2) (hT3 : |τ3 x| ≤ T3) :
    ‖chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3 + 3 * M0 * T2 ^ 2 / mu ^ 4 := by
  have habs : ∀ n : ℕ, mu ^ n ≤ ‖((τ1 x : ℝ) : ℂ) ^ n‖ := by
    intro n
    rw [norm_pow, Complex.norm_real, Real.norm_eq_abs]
    exact pow_le_pow_left₀ (le_of_lt hmu) hlow n
  have hmun : ∀ n : ℕ, (0 : ℝ) < mu ^ n := fun n => pow_pos hmu n
  have hdiv : ∀ (z : ℂ) (n : ℕ) (K : ℝ), ‖z‖ ≤ K → 0 ≤ K →
      ‖z / ((τ1 x : ℝ) : ℂ) ^ n‖ ≤ K / mu ^ n := by
    intro z n K hz hK
    rw [norm_div]
    exact div_le_div_of_le_of_le (lt_of_lt_of_le (hmun n) (habs n)) (hmun n) hz hK (habs n)
  have hT2nn : (0 : ℝ) ≤ T2 := le_trans (abs_nonneg _) hT2
  have hT3nn : (0 : ℝ) ≤ T3 := le_trans (abs_nonneg _) hT3
  have hM0nn : (0 : ℝ) ≤ M0 := le_trans (norm_nonneg _) hM0
  have hM1nn : (0 : ℝ) ≤ M1 := le_trans (norm_nonneg _) hM1
  have hM2nn : (0 : ℝ) ≤ M2 := le_trans (norm_nonneg _) hM2
  have h1 : ‖A2 x / ((τ1 x : ℝ) : ℂ) ^ 2‖ ≤ M2 / mu ^ 2 := hdiv _ 2 _ hM2 hM2nn
  have h2 : ‖3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3‖ ≤ 3 * M1 * T2 / mu ^ 3 := by
    refine hdiv _ 3 _ ?_ (by positivity)
    rw [norm_mul, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have h3 : ‖(3 : ℂ)‖ = 3 := by norm_num
    rw [h3]
    exact mul_le_mul (mul_le_mul_of_nonneg_left hM1 (by norm_num)) hT2
      (abs_nonneg _) (by positivity)
  have h3 : ‖A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3‖ ≤ M0 * T3 / mu ^ 3 := by
    refine hdiv _ 3 _ ?_ (by positivity)
    rw [norm_mul, Complex.norm_real, Real.norm_eq_abs]
    exact mul_le_mul hM0 hT3 (abs_nonneg _) hM0nn
  have h4 : ‖3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4‖
      ≤ 3 * M0 * T2 ^ 2 / mu ^ 4 := by
    refine hdiv _ 4 _ ?_ (by positivity)
    rw [norm_mul, norm_mul, norm_pow, Complex.norm_real, Real.norm_eq_abs]
    have h3 : ‖(3 : ℂ)‖ = 3 := by norm_num
    rw [h3]
    refine mul_le_mul (mul_le_mul_of_nonneg_left hM0 (by norm_num))
      (pow_le_pow_left₀ (abs_nonneg _) hT2 2) (by positivity) (by positivity)
  rw [chainC]
  set X1 := A2 x / ((τ1 x : ℝ) : ℂ) ^ 2 with hX1
  set X2 := 3 * A1 x * ((τ2 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3 with hX2
  set X3 := A x * ((τ3 x : ℝ) : ℂ) / ((τ1 x : ℝ) : ℂ) ^ 3 with hX3
  set X4 := 3 * A x * ((τ2 x : ℝ) : ℂ) ^ 2 / ((τ1 x : ℝ) : ℂ) ^ 4 with hX4
  have e1 : ‖X1 - X2 - X3 + X4‖ ≤ ‖X1 - X2 - X3‖ + ‖X4‖ := norm_add_le _ _
  have e2 : ‖X1 - X2 - X3‖ ≤ ‖X1 - X2‖ + ‖X3‖ := norm_sub_le _ _
  have e3 : ‖X1 - X2‖ ≤ ‖X1‖ + ‖X2‖ := norm_sub_le _ _
  linarith

/-- **Two integrations by parts with explicit bounds.**  The phase derivative is bounded below by
`mu`, the amplitude and its first two derivatives by `M0, M1, M2`, and the second and third
derivatives of the phase by `T2, T3`. -/
theorem norm_integral_osc_ibp2_bound {a b lam mu M0 M1 M2 T2 T3 : ℝ}
    (hab : a ≤ b) (hlam : lam ≠ 0) (hmu : 0 < mu)
    {τ τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ1 x) x) (hτ1 : ∀ x, HasDerivAt τ1 (τ2 x) x)
    (hτ2 : ∀ x, HasDerivAt τ2 (τ3 x) x)
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2c : Continuous A2)
    (hlow : ∀ x, mu ≤ |τ1 x|)
    (hM0 : ∀ x, ‖A x‖ ≤ M0) (hM1 : ∀ x, ‖A1 x‖ ≤ M1) (hM2 : ∀ x, ‖A2 x‖ ≤ M2)
    (hT2 : ∀ x, |τ2 x| ≤ T2) (hT3 : ∀ x, |τ3 x| ≤ T3)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (b - a) * (lam ^ 2)⁻¹
        * (M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
            + 3 * M0 * T2 ^ 2 / mu ^ 4) := by
  have hne : ∀ x, τ1 x ≠ 0 := by
    intro x
    have h := hlow x
    intro h0
    rw [h0] at h
    simp at h
    linarith
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hBc : Continuous (chainB τ1 τ2 A A1) := continuous_chainB hτ1c hτ2c hAc hA1c hne
  have hCc : Continuous (chainC τ1 τ2 τ3 A A1 A2) :=
    continuous_chainC hτ1c hτ2c hτ3c hAc hA1c hA2c hne
  have hBa : chainB τ1 τ2 A A1 a = 0 := by
    rw [chainB, hAa, h1a]
    simp
  have hBb : chainB τ1 τ2 A A1 b = 0 := by
    rw [chainB, hAb, h1b]
    simp
  have h := norm_integral_osc_ibp_twice hab hlam hτ hτ1c hne hAc hBc hCc
    (fun x => hasDerivAt_chain_first (hτ1 x) (hA x) (hne x))
    (fun x => hasDerivAt_chainB_div (hτ1 x) (hτ2 x) (hA x) (hA1 x) (hne x))
    hAa hAb hBa hBb
  refine le_trans h ?_
  set K : ℝ := M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
    + 3 * M0 * T2 ^ 2 / mu ^ 4 with hK
  have hbound : (∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖) ≤ (b - a) * K := by
    have hint1 : IntervalIntegrable (fun x => ‖chainC τ1 τ2 τ3 A A1 A2 x‖) volume a b :=
      hCc.norm.intervalIntegrable a b
    have hint2 : IntervalIntegrable (fun _ : ℝ => K) volume a b := intervalIntegrable_const
    have hmono := intervalIntegral.integral_mono_on hab hint1 hint2
      (fun x _ => norm_chainC_le hmu (hlow x) (hM0 x) (hM1 x) (hM2 x) (hT2 x) (hT3 x))
    rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
    exact hmono
  have hlamnn : (0 : ℝ) ≤ (lam ^ 2)⁻¹ := by positivity
  calc (lam ^ 2)⁻¹ * ∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ (lam ^ 2)⁻¹ * ((b - a) * K) := mul_le_mul_of_nonneg_left hbound hlamnn
    _ = (b - a) * (lam ^ 2)⁻¹ * K := by ring

end IbpChain


/-! ### The angular phase and the plate cutoffs -/

section AngularPhase

theorem psiu_eq (u : Pl) (ε t φ : ℝ) :
    psiu u ε t φ = u 0 * Real.cos φ + u 1 * Real.sin φ + ε * t := by
  rw [psiu, pt, inner_two, mk2_apply_zero, mk2_apply_one]
  ring

/-- The first angular derivative of the phase coefficient. -/
def psi1 (u : Pl) (φ : ℝ) : ℝ := -(u 0) * Real.sin φ + u 1 * Real.cos φ

/-- The second angular derivative. -/
def psi2 (u : Pl) (φ : ℝ) : ℝ := -(u 0 * Real.cos φ + u 1 * Real.sin φ)

/-- The third angular derivative. -/
def psi3 (u : Pl) (φ : ℝ) : ℝ := u 0 * Real.sin φ - u 1 * Real.cos φ

theorem hasDerivAt_psiu (u : Pl) (ε t φ : ℝ) : HasDerivAt (psiu u ε t) (psi1 u φ) φ := by
  have h : HasDerivAt (fun x : ℝ => u 0 * Real.cos x + u 1 * Real.sin x + ε * t)
      (u 0 * (-Real.sin φ) + u 1 * Real.cos φ) φ := by
    have h1 := (Real.hasDerivAt_cos φ).const_mul (u 0)
    have h2 := (Real.hasDerivAt_sin φ).const_mul (u 1)
    exact (h1.add h2).add_const _
  have heq : psiu u ε t = fun x : ℝ => u 0 * Real.cos x + u 1 * Real.sin x + ε * t := by
    funext x
    exact psiu_eq u ε t x
  rw [heq]
  refine h.congr_deriv ?_
  rw [psi1]
  ring

theorem hasDerivAt_psi1 (u : Pl) (φ : ℝ) : HasDerivAt (psi1 u) (psi2 u φ) φ := by
  have h1 := (Real.hasDerivAt_sin φ).const_mul (-(u 0))
  have h2 := (Real.hasDerivAt_cos φ).const_mul (u 1)
  have h := h1.add h2
  refine h.congr_deriv ?_
  rw [psi2]
  ring

theorem hasDerivAt_psi2 (u : Pl) (φ : ℝ) : HasDerivAt (psi2 u) (psi3 u φ) φ := by
  have h1 := (Real.hasDerivAt_cos φ).const_mul (u 0)
  have h2 := (Real.hasDerivAt_sin φ).const_mul (u 1)
  have h := (h1.add h2).neg
  refine h.congr_deriv ?_
  rw [psi3]
  ring

theorem continuous_psi1 (u : Pl) : Continuous (psi1 u) := by
  refine Continuous.add ?_ ?_
  · exact continuous_const.mul Real.continuous_sin
  · exact continuous_const.mul Real.continuous_cos

theorem continuous_psi2 (u : Pl) : Continuous (psi2 u) := by
  refine Continuous.neg (Continuous.add ?_ ?_)
  · exact continuous_const.mul Real.continuous_cos
  · exact continuous_const.mul Real.continuous_sin

theorem continuous_psi3 (u : Pl) : Continuous (psi3 u) := by
  refine Continuous.sub ?_ ?_
  · exact continuous_const.mul Real.continuous_sin
  · exact continuous_const.mul Real.continuous_cos

theorem abs_psi_le (u : Pl) (φ : ℝ) :
    |psi1 u φ| ≤ 2 * ‖u‖ ∧ |psi2 u φ| ≤ 2 * ‖u‖ ∧ |psi3 u φ| ≤ 2 * ‖u‖ := by
  have h0 : |u 0| ≤ ‖u‖ := Auto.CalderonVaillancourt.abs_apply_le_norm u 0
  have h1 : |u 1| ≤ ‖u‖ := Auto.CalderonVaillancourt.abs_apply_le_norm u 1
  have hs : |Real.sin φ| ≤ 1 := Real.abs_sin_le_one φ
  have hc : |Real.cos φ| ≤ 1 := Real.abs_cos_le_one φ
  have hb0 : |u 0 * Real.cos φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 0| * |Real.cos φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h0 hc (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb1 : |u 1 * Real.sin φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 1| * |Real.sin φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h1 hs (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb0s : |u 0 * Real.sin φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 0| * |Real.sin φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h0 hs (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  have hb1c : |u 1 * Real.cos φ| ≤ ‖u‖ := by
    rw [abs_mul]
    calc |u 1| * |Real.cos φ| ≤ ‖u‖ * 1 :=
          mul_le_mul h1 hc (abs_nonneg _) (norm_nonneg _)
      _ = ‖u‖ := mul_one _
  refine ⟨?_, ?_, ?_⟩
  · rw [psi1]
    have h : |-(u 0) * Real.sin φ + u 1 * Real.cos φ|
        ≤ |-(u 0) * Real.sin φ| + |u 1 * Real.cos φ| := abs_add_le _ _
    have he : |-(u 0) * Real.sin φ| = |u 0 * Real.sin φ| := by
      rw [neg_mul, abs_neg]
    linarith [h, he ▸ hb0s]
  · rw [psi2, abs_neg]
    have h : |u 0 * Real.cos φ + u 1 * Real.sin φ|
        ≤ |u 0 * Real.cos φ| + |u 1 * Real.sin φ| := abs_add_le _ _
    linarith
  · rw [psi3]
    have h : |u 0 * Real.sin φ - u 1 * Real.cos φ|
        ≤ |u 0 * Real.sin φ| + |u 1 * Real.cos φ| := abs_sub _ _
    linarith

/-! #### The plate cutoffs -/

/-- The telescoping angular cutoff: `1` when `2^M φ ≥ ν + 1`, `0` when `2^M φ ≤ ν`. -/
def plateT (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))

/-- The plate cutoff at angular scale `2^{-M}`, supported in `[ν 2^{-M}, (ν+2) 2^{-M}]`. -/
def plateC (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ := plateT M ν φ - plateT M (ν + 1) φ

/-- The first derivative of the plate cutoff. -/
def plateC1 (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  (2 : ℝ) ^ M * (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
    - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))

/-- The second derivative of the plate cutoff. -/
def plateC2 (M : ℕ) (ν : ℤ) (φ : ℝ) : ℝ :=
  (2 : ℝ) ^ M * (2 : ℝ) ^ M
    * (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))

theorem hasDerivAt_plateT (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateT M ν)
      ((2 : ℝ) ^ M * deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))) φ := by
  have hinner : HasDerivAt (fun x : ℝ => (2 : ℝ) ^ M * x - (ν : ℝ)) ((2 : ℝ) ^ M) φ := by
    have h := (hasDerivAt_id φ).const_mul ((2 : ℝ) ^ M)
    simpa using h.sub_const ((ν : ℝ))
  have hst : HasDerivAt Real.smoothTransition
      (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
      ((2 : ℝ) ^ M * φ - (ν : ℝ)) :=
    (contDiff_st.differentiable (by simp) _).hasDerivAt
  have h := hst.comp φ hinner
  refine h.congr_deriv ?_
  ring

theorem hasDerivAt_plateC (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateC M ν) (plateC1 M ν φ) φ := by
  have h1 := hasDerivAt_plateT M ν φ
  have h2 := hasDerivAt_plateT M (ν + 1) φ
  have h := h1.sub h2
  refine h.congr_deriv ?_
  rw [plateC1]
  push_cast
  ring

theorem hasDerivAt_plateC1 (M : ℕ) (ν : ℤ) (φ : ℝ) :
    HasDerivAt (plateC1 M ν) (plateC2 M ν φ) φ := by
  have hd : ∀ c : ℝ, HasDerivAt (fun x : ℝ => deriv Real.smoothTransition ((2 : ℝ) ^ M * x - c))
      ((2 : ℝ) ^ M * deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - c)) φ := by
    intro c
    have hinner : HasDerivAt (fun x : ℝ => (2 : ℝ) ^ M * x - c) ((2 : ℝ) ^ M) φ := by
      have h := (hasDerivAt_id φ).const_mul ((2 : ℝ) ^ M)
      simpa using h.sub_const c
    have hst : HasDerivAt (deriv Real.smoothTransition)
        (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - c))
        ((2 : ℝ) ^ M * φ - c) :=
      (contDiff_deriv_st.differentiable (by simp) _).hasDerivAt
    have h := hst.comp φ hinner
    refine h.congr_deriv ?_
    ring
  have h := ((hd ((ν : ℝ))).sub (hd ((ν : ℝ) + 1))).const_mul ((2 : ℝ) ^ M)
  refine h.congr_deriv ?_
  rw [plateC2]
  ring

theorem continuous_plateC1 (M : ℕ) (ν : ℤ) : Continuous (plateC1 M ν) := by
  refine continuous_const.mul (Continuous.sub ?_ ?_)
  · exact contDiff_deriv_st.continuous.comp ((continuous_const.mul continuous_id).sub
      continuous_const)
  · exact contDiff_deriv_st.continuous.comp ((continuous_const.mul continuous_id).sub
      continuous_const)

theorem continuous_plateC2 (M : ℕ) (ν : ℤ) : Continuous (plateC2 M ν) := by
  have hc : Continuous (deriv (deriv Real.smoothTransition)) := by
    have h : ContDiff ℝ (↑(⊤ : ℕ∞)) (deriv (deriv Real.smoothTransition)) := by
      have h2 : ContDiff ℝ ((↑(⊤ : ℕ∞)) + 1) (deriv Real.smoothTransition) := by
        simpa using contDiff_deriv_st
      exact (contDiff_succ_iff_deriv.mp h2).2.2
    exact h.continuous
  refine continuous_const.mul (Continuous.sub ?_ ?_)
  · exact hc.comp ((continuous_const.mul continuous_id).sub continuous_const)
  · exact hc.comp ((continuous_const.mul continuous_id).sub continuous_const)

theorem continuous_plateC (M : ℕ) (ν : ℤ) : Continuous (plateC M ν) :=
  continuous_iff_continuousAt.mpr fun φ => (hasDerivAt_plateC M ν φ).continuousAt

theorem plateC_nonneg (M : ℕ) (ν : ℤ) (φ : ℝ) : 0 ≤ plateC M ν φ := by
  rw [plateC, plateT, plateT, sub_nonneg]
  refine Real.smoothTransition.monotone ?_
  push_cast
  linarith

theorem plateC_le_one (M : ℕ) (ν : ℤ) (φ : ℝ) : plateC M ν φ ≤ 1 := by
  rw [plateC]
  have h1 : plateT M ν φ ≤ 1 := Real.smoothTransition.le_one _
  have h2 : (0 : ℝ) ≤ plateT M (ν + 1) φ := Real.smoothTransition.nonneg _
  linarith

theorem abs_plateC_le_one (M : ℕ) (ν : ℤ) (φ : ℝ) : |plateC M ν φ| ≤ 1 := by
  rw [abs_of_nonneg (plateC_nonneg M ν φ)]
  exact plateC_le_one M ν φ

/-- Outside its plate, on the left, the cutoff and its first two derivatives vanish. -/
theorem plateC_eq_zero_of_nonpos {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : (2 : ℝ) ^ M * φ - (ν : ℝ) ≤ 0) :
    plateC M ν φ = 0 ∧ plateC1 M ν φ = 0 ∧ plateC2 M ν φ = 0 := by
  have h2 : (2 : ℝ) ^ M * φ - ((ν : ℝ) + 1) ≤ 0 := by linarith
  have hz1 : plateT M ν φ = 0 := Real.smoothTransition.zero_of_nonpos h
  have hz2 : plateT M (ν + 1) φ = 0 := by
    rw [plateT]
    refine Real.smoothTransition.zero_of_nonpos ?_
    push_cast
    linarith
  refine ⟨by rw [plateC, hz1, hz2, sub_zero], ?_, ?_⟩
  · rw [plateC1, deriv_st_eq_zero_of_nonpos h, deriv_st_eq_zero_of_nonpos h2]
    ring
  · rw [plateC2, deriv2_st_eq_zero_of_nonpos h, deriv2_st_eq_zero_of_nonpos h2]
    ring

/-- Outside its plate, on the right, the cutoff and its first two derivatives vanish. -/
theorem plateC_eq_zero_of_two_le {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : 2 ≤ (2 : ℝ) ^ M * φ - (ν : ℝ)) :
    plateC M ν φ = 0 ∧ plateC1 M ν φ = 0 ∧ plateC2 M ν φ = 0 := by
  have h1 : (1 : ℝ) ≤ (2 : ℝ) ^ M * φ - (ν : ℝ) := by linarith
  have h2 : (1 : ℝ) ≤ (2 : ℝ) ^ M * φ - ((ν : ℝ) + 1) := by linarith
  have hz1 : plateT M ν φ = 1 := Real.smoothTransition.one_of_one_le h1
  have hz2 : plateT M (ν + 1) φ = 1 := by
    rw [plateT]
    refine Real.smoothTransition.one_of_one_le ?_
    push_cast
    linarith
  refine ⟨by rw [plateC, hz1, hz2, sub_self], ?_, ?_⟩
  · rw [plateC1, deriv_st_eq_zero_of_one_le h1, deriv_st_eq_zero_of_one_le h2]
    ring
  · rw [plateC2, deriv2_st_eq_zero_of_one_le h1, deriv2_st_eq_zero_of_one_le h2]
    ring

/-- The derivatives of the plate cutoff are bounded by the natural powers of `2^M`. -/
theorem abs_plateC_deriv_le (M : ℕ) (ν : ℤ) (φ : ℝ) :
    ∃ C : ℝ, 1 ≤ C ∧ |plateC1 M ν φ| ≤ 2 * C * (2 : ℝ) ^ M
      ∧ |plateC2 M ν φ| ≤ 2 * C * ((2 : ℝ) ^ M) ^ 2 := by
  obtain ⟨C, hC1, hCd, hCd2⟩ := exists_st_deriv2_bound
  refine ⟨C, hC1, ?_, ?_⟩
  · rw [plateC1, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ (2 : ℝ) ^ M)]
    have hsub : |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * C := by
      have ha := hCd ((2 : ℝ) ^ M * φ - (ν : ℝ))
      have hb := hCd ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
      have h := abs_sub (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
        (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
      linarith
    calc (2 : ℝ) ^ M * |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
          - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
        ≤ (2 : ℝ) ^ M * (2 * C) := mul_le_mul_of_nonneg_left hsub (by positivity)
      _ = 2 * C * (2 : ℝ) ^ M := by ring
  · rw [plateC2, abs_mul, abs_of_nonneg (by positivity : (0:ℝ) ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M)]
    have hsub : |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * C := by
      have ha := hCd2 ((2 : ℝ) ^ M * φ - (ν : ℝ))
      have hb := hCd2 ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
      have h := abs_sub (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ)))
        (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
      linarith
    calc (2 : ℝ) ^ M * (2 : ℝ) ^ M
          * |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
            - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
        ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M * (2 * C) := mul_le_mul_of_nonneg_left hsub (by positivity)
      _ = 2 * C * ((2 : ℝ) ^ M) ^ 2 := by ring

/-- The plate cutoffs telescope. -/
theorem sum_plateC (M : ℕ) (a b : ℤ) (hab : a ≤ b) (φ : ℝ) :
    ∑ ν ∈ Finset.Icc a b, plateC M ν φ = plateT M a φ - plateT M (b + 1) φ := by
  classical
  induction b, hab using Int.leInduction with
  | base =>
    simp [plateC]
  | succ n hn ih =>
    have hnot : (n + 1) ∉ Finset.Icc a n := by
      simp [Finset.mem_Icc]
    have hins : Finset.Icc a (n + 1) = insert (n + 1) (Finset.Icc a n) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_insert]
      omega
    rw [hins, Finset.sum_insert hnot, ih, plateC]
    ring

end AngularPhase


/-! ### Localized integration by parts -/

section IbpLocal

/-- One integration by parts, with the hypotheses on the phase and the amplitudes needed only on
the interval of integration. -/
theorem integral_osc_ibp_on {a b lam : ℝ} (hab : a ≤ b) (hlam : lam ≠ 0)
    {τ τ' : ℝ → ℝ} {A Bn : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ' x) x) (hτc : Continuous τ)
    (hne : ∀ x ∈ Set.Icc a b, τ' x ≠ 0)
    (hAc : ContinuousOn A (Set.Icc a b)) (hBc : ContinuousOn Bn (Set.Icc a b))
    (hAB : ∀ x ∈ Set.Icc a b, HasDerivAt (fun y => A y / ((τ' y : ℝ) : ℂ)) (Bn x) x)
    (hAa : A a = 0) (hAb : A b = 0) :
    (∫ x in a..b, osc lam (τ x) * A x)
      = -(1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, osc lam (τ x) * Bn x := by
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hlamC : ((lam : ℝ) : ℂ) * Complex.I ≠ 0 := by
    refine mul_ne_zero ?_ Complex.I_ne_zero
    exact_mod_cast hlam
  set u : ℝ → ℂ := fun y => (A y / ((τ' y : ℝ) : ℂ)) / (((lam : ℝ) : ℂ) * Complex.I) with hu
  set v : ℝ → ℂ := fun y => osc lam (τ y) with hv
  have hvc : Continuous v := continuous_osc_comp hτc
  have hud : ∀ x ∈ Set.Icc a b, HasDerivAt u (Bn x / (((lam : ℝ) : ℂ) * Complex.I)) x :=
    fun x hx => (hAB x hx).div_const _
  have hvd : ∀ x, HasDerivAt v (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I)) x := fun x =>
    hasDerivAt_osc (hτ x)
  have hkey : ∀ x ∈ Set.Icc a b, HasDerivAt (fun y => u y * v y)
      (v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) x := by
    intro x hx
    have h := (hud x hx).mul (hvd x)
    have hlamC' : ((lam : ℝ) : ℂ) ≠ 0 := by exact_mod_cast hlam
    have heq : Bn x / (((lam : ℝ) : ℂ) * Complex.I) * v x +
        u x * (v x * ((((lam * τ' x : ℝ)) : ℂ) * Complex.I))
        = v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)) := by
      have hτ'C : ((τ' x : ℝ) : ℂ) ≠ 0 := by
        exact_mod_cast hne x hx
      rw [hu]
      push_cast
      field_simp
      ring
    rw [heq] at h
    exact h
  have hbdry : u b * v b - u a * v a = 0 := by
    simp [hu, hAa, hAb]
  have hintg : IntervalIntegrable
      (fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul (hAc.add (hBc.div_const _))
  have hzero : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I))) = 0 := by
    have h := intervalIntegral.integral_eq_sub_of_hasDerivAt
      (f := fun y => u y * v y)
      (f' := fun x => v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      (fun x hx => hkey x (by rw [huIcc] at hx; exact hx)) hintg
    rw [h, hbdry]
  have h1 : IntervalIntegrable (fun x => v x * A x) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul hAc
  have h2 : IntervalIntegrable (fun x => v x * Bn x) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact (hvc.continuousOn).mul hBc
  have hsplit : (∫ x in a..b, v x * (A x + Bn x / (((lam : ℝ) : ℂ) * Complex.I)))
      = (∫ x in a..b, v x * A x) +
        (1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x := by
    rw [← intervalIntegral.integral_const_mul, ← intervalIntegral.integral_add h1 (h2.const_mul _)]
    refine intervalIntegral.integral_congr fun x _ => ?_
    field_simp
  rw [hsplit] at hzero
  have hres : (∫ x in a..b, v x * A x)
      = -((1 / (((lam : ℝ) : ℂ) * Complex.I)) * ∫ x in a..b, v x * Bn x) := by
    linear_combination hzero
  rw [hres]
  ring

/-- **Two integrations by parts, localized.**  All hypotheses on the phase and on the amplitude
are needed only on the interval of integration; the amplitude and its first derivative vanish at
the endpoints. -/
theorem norm_integral_osc_ibp2_bound_on {a b lam mu M0 M1 M2 T2 T3 : ℝ}
    (hab : a ≤ b) (hlam : lam ≠ 0) (hmu : 0 < mu)
    {τ τ1 τ2 τ3 : ℝ → ℝ} {A A1 A2 : ℝ → ℂ}
    (hτ : ∀ x, HasDerivAt τ (τ1 x) x) (hτ1 : ∀ x, HasDerivAt τ1 (τ2 x) x)
    (hτ2 : ∀ x, HasDerivAt τ2 (τ3 x) x)
    (hτ1c : Continuous τ1) (hτ2c : Continuous τ2) (hτ3c : Continuous τ3)
    (hA : ∀ x, HasDerivAt A (A1 x) x) (hA1 : ∀ x, HasDerivAt A1 (A2 x) x)
    (hA2c : Continuous A2)
    (hlow : ∀ x ∈ Set.Icc a b, mu ≤ |τ1 x|)
    (hM0 : ∀ x ∈ Set.Icc a b, ‖A x‖ ≤ M0) (hM1 : ∀ x ∈ Set.Icc a b, ‖A1 x‖ ≤ M1)
    (hM2 : ∀ x ∈ Set.Icc a b, ‖A2 x‖ ≤ M2)
    (hT2 : ∀ x ∈ Set.Icc a b, |τ2 x| ≤ T2) (hT3 : ∀ x ∈ Set.Icc a b, |τ3 x| ≤ T3)
    (hAa : A a = 0) (hAb : A b = 0) (h1a : A1 a = 0) (h1b : A1 b = 0) :
    ‖∫ x in a..b, osc lam (τ x) * A x‖
      ≤ (b - a) * (lam ^ 2)⁻¹
        * (M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
            + 3 * M0 * T2 ^ 2 / mu ^ 4) := by
  have huIcc : Set.uIcc a b = Set.Icc a b := Set.uIcc_of_le hab
  have hne : ∀ x ∈ Set.Icc a b, τ1 x ≠ 0 := by
    intro x hx h0
    have h := hlow x hx
    rw [h0] at h
    simp at h
    linarith
  have hAc : Continuous A := continuous_iff_continuousAt.mpr fun x => (hA x).continuousAt
  have hA1c : Continuous A1 := continuous_iff_continuousAt.mpr fun x => (hA1 x).continuousAt
  have hτc : Continuous τ := continuous_iff_continuousAt.mpr fun x => (hτ x).continuousAt
  have hτ1CC : ContinuousOn (fun x : ℝ => ((τ1 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ1c).continuousOn
  have hτ2CC : ContinuousOn (fun x : ℝ => ((τ2 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ2c).continuousOn
  have hτ3CC : ContinuousOn (fun x : ℝ => ((τ3 x : ℝ) : ℂ)) (Set.Icc a b) :=
    (Complex.continuous_ofReal.comp hτ3c).continuousOn
  have hneC : ∀ x ∈ Set.Icc a b, ((τ1 x : ℝ) : ℂ) ≠ 0 := by
    intro x hx
    exact_mod_cast hne x hx
  have hpow : ∀ (n : ℕ), ∀ x ∈ Set.Icc a b, ((τ1 x : ℝ) : ℂ) ^ n ≠ 0 :=
    fun n x hx => pow_ne_zero _ (hneC x hx)
  have hBcOn : ContinuousOn (chainB τ1 τ2 A A1) (Set.Icc a b) := by
    refine ContinuousOn.sub (hA1c.continuousOn.div hτ1CC hneC) ?_
    exact (hAc.continuousOn.mul hτ2CC).div (hτ1CC.pow 2) (hpow 2)
  have hCcOn : ContinuousOn (chainC τ1 τ2 τ3 A A1 A2) (Set.Icc a b) := by
    refine ContinuousOn.add (ContinuousOn.sub (ContinuousOn.sub
      (hA2c.continuousOn.div (hτ1CC.pow 2) (hpow 2)) ?_) ?_) ?_
    · exact ((continuousOn_const.mul hA1c.continuousOn).mul hτ2CC).div (hτ1CC.pow 3) (hpow 3)
    · exact (hAc.continuousOn.mul hτ3CC).div (hτ1CC.pow 3) (hpow 3)
    · exact ((continuousOn_const.mul hAc.continuousOn).mul (hτ2CC.pow 2)).div
        (hτ1CC.pow 4) (hpow 4)
  have hBa : chainB τ1 τ2 A A1 a = 0 := by
    rw [chainB, hAa, h1a]
    simp
  have hBb : chainB τ1 τ2 A A1 b = 0 := by
    rw [chainB, hAb, h1b]
    simp
  have hstep1 := integral_osc_ibp_on hab hlam hτ hτc hne hAc.continuousOn hBcOn
    (fun x hx => hasDerivAt_chain_first (hτ1 x) (hA x) (hne x hx)) hAa hAb
  have hstep2 := integral_osc_ibp_on hab hlam hτ hτc hne hBcOn hCcOn
    (fun x hx => hasDerivAt_chainB_div (hτ1 x) (hτ2 x) (hA x) (hA1 x) (hne x hx)) hBa hBb
  have hnormlam : ‖(1 : ℂ) / (((lam : ℝ) : ℂ) * Complex.I)‖ = |lam|⁻¹ := by
    rw [norm_div, norm_mul, Complex.norm_I, mul_one, Complex.norm_real, Real.norm_eq_abs, norm_one,
      one_div]
  have hchain : ‖∫ x in a..b, osc lam (τ x) * A x‖
      = |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖) := by
    rw [hstep1, norm_mul, norm_neg, hnormlam, hstep2, norm_mul, norm_neg, hnormlam]
  -- bound the last integral
  have hCint : IntervalIntegrable (fun x => ‖chainC τ1 τ2 τ3 A A1 A2 x‖) volume a b := by
    refine ContinuousOn.intervalIntegrable ?_
    rw [huIcc]
    exact hCcOn.norm
  have hbd : ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ ∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖ := by
    have h := intervalIntegral.norm_integral_le_abs_integral_norm
      (f := fun x => osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x) (a := a) (b := b) (μ := volume)
    refine le_trans h (le_of_eq ?_)
    rw [abs_of_nonneg]
    · refine intervalIntegral.integral_congr fun x _ => ?_
      rw [norm_mul, norm_osc, one_mul]
    · refine intervalIntegral.integral_nonneg hab fun x _ => ?_
      exact norm_nonneg _
  set K : ℝ := M2 / mu ^ 2 + 3 * M1 * T2 / mu ^ 3 + M0 * T3 / mu ^ 3
    + 3 * M0 * T2 ^ 2 / mu ^ 4 with hK
  have hKint : (∫ x in a..b, ‖chainC τ1 τ2 τ3 A A1 A2 x‖) ≤ (b - a) * K := by
    have hmono := intervalIntegral.integral_mono_on hab hCint
      (intervalIntegrable_const (c := K))
      (fun x hx => norm_chainC_le hmu (hlow x hx) (hM0 x hx) (hM1 x hx) (hM2 x hx)
        (hT2 x hx) (hT3 x hx))
    rw [intervalIntegral.integral_const, smul_eq_mul] at hmono
    exact hmono
  rw [hchain]
  have hlamnn : (0 : ℝ) ≤ |lam|⁻¹ := by positivity
  have hstep : |lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖
      ≤ |lam|⁻¹ * ((b - a) * K) :=
    mul_le_mul_of_nonneg_left (le_trans hbd hKint) hlamnn
  have hfin : |lam|⁻¹ * (|lam|⁻¹ * ((b - a) * K)) = (b - a) * (lam ^ 2)⁻¹ * K := by
    have h : |lam| * |lam| = lam ^ 2 := by
      rw [← abs_mul, ← pow_two, abs_of_nonneg (sq_nonneg lam)]
    field_simp
    rw [← h]
    ring
  calc |lam|⁻¹ * (|lam|⁻¹ * ‖∫ x in a..b, osc lam (τ x) * chainC τ1 τ2 τ3 A A1 A2 x‖)
      ≤ |lam|⁻¹ * (|lam|⁻¹ * ((b - a) * K)) := mul_le_mul_of_nonneg_left hstep hlamnn
    _ = (b - a) * (lam ^ 2)⁻¹ * K := hfin

end IbpLocal


/-! ### The angular amplitude on a plate -/

section AngularAmp

/-- A fixed constant bounding the first two derivatives of `Real.smoothTransition`. -/
noncomputable def stC : ℝ := Classical.choose exists_st_deriv2_bound

theorem one_le_stC : 1 ≤ stC := (Classical.choose_spec exists_st_deriv2_bound).1

theorem abs_deriv_st_le (x : ℝ) : |deriv Real.smoothTransition x| ≤ stC :=
  (Classical.choose_spec exists_st_deriv2_bound).2.1 x

theorem abs_deriv2_st_le (x : ℝ) : |deriv (deriv Real.smoothTransition) x| ≤ stC :=
  (Classical.choose_spec exists_st_deriv2_bound).2.2 x

theorem stC_nonneg : (0 : ℝ) ≤ stC := le_trans zero_le_one one_le_stC

attribute [irreducible] stC

theorem abs_plateC1_le (M : ℕ) (ν : ℤ) (φ : ℝ) : |plateC1 M ν φ| ≤ 2 * stC * (2 : ℝ) ^ M := by
  rw [plateC1, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ M)]
  have ha := abs_deriv_st_le ((2 : ℝ) ^ M * φ - (ν : ℝ))
  have hb := abs_deriv_st_le ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
  have h := abs_sub (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ)))
    (deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
  have hsub : |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * stC := by
    linarith
  calc (2 : ℝ) ^ M * |deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - (ν : ℝ))
        - deriv Real.smoothTransition ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
      ≤ (2 : ℝ) ^ M * (2 * stC) := mul_le_mul_of_nonneg_left hsub (by positivity)
    _ = 2 * stC * (2 : ℝ) ^ M := by ring

theorem abs_plateC2_le (M : ℕ) (ν : ℤ) (φ : ℝ) :
    |plateC2 M ν φ| ≤ 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by
  rw [plateC2, abs_mul, abs_of_nonneg (by positivity : (0 : ℝ) ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M)]
  have ha := abs_deriv2_st_le ((2 : ℝ) ^ M * φ - (ν : ℝ))
  have hb := abs_deriv2_st_le ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))
  have h := abs_sub (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ)))
    (deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1)))
  have hsub : |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
      - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))| ≤ 2 * stC := by
    linarith
  calc (2 : ℝ) ^ M * (2 : ℝ) ^ M
        * |deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - (ν : ℝ))
          - deriv (deriv Real.smoothTransition) ((2 : ℝ) ^ M * φ - ((ν : ℝ) + 1))|
      ≤ (2 : ℝ) ^ M * (2 : ℝ) ^ M * (2 * stC) :=
        mul_le_mul_of_nonneg_left hsub (by positivity)
    _ = 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by ring

/-- The amplitude of the angular oscillatory integral on the plate `ν`. -/
def angAmp (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 0 t r φ * ((plateC M ν φ : ℝ) : ℂ))

/-- Its first angular derivative. -/
def angAmp1 (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
    + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ))

/-- Its second angular derivative. -/
def angAmp2 (ma : ℕ → ℝ → ℝ → ℝ → ℂ) (M : ℕ) (ν : ℤ) (t r φ : ℝ) : ℂ :=
  (r : ℂ) * (ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
    + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
    + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ))

theorem hasDerivAt_angAmp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) :
    HasDerivAt (angAmp ma M ν t r) (angAmp1 ma M ν t r φ) φ := by
  have hc : HasDerivAt (fun x : ℝ => ((plateC M ν x : ℝ) : ℂ))
      (((plateC1 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC M ν φ).ofReal_comp
  have h := ((hp.ad 0 (by norm_num) t r φ).mul hc).const_mul ((r : ℂ))
  refine h.congr_deriv ?_
  rw [angAmp1]

theorem hasDerivAt_angAmp1 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) :
    HasDerivAt (angAmp1 ma M ν t r) (angAmp2 ma M ν t r φ) φ := by
  have hc : HasDerivAt (fun x : ℝ => ((plateC M ν x : ℝ) : ℂ))
      (((plateC1 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC M ν φ).ofReal_comp
  have hc1 : HasDerivAt (fun x : ℝ => ((plateC1 M ν x : ℝ) : ℂ))
      (((plateC2 M ν φ : ℝ) : ℂ)) φ := (hasDerivAt_plateC1 M ν φ).ofReal_comp
  have h := (((hp.ad 1 (by norm_num) t r φ).mul hc).add
    ((hp.ad 0 (by norm_num) t r φ).mul hc1)).const_mul ((r : ℂ))
  refine h.congr_deriv ?_
  rw [angAmp2]
  ring

theorem continuous_angAmp2 {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r : ℝ) :
    Continuous (angAmp2 ma M ν t r) := by
  have hc : Continuous fun x : ℝ => ((plateC M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC M ν)
  have hc1 : Continuous fun x : ℝ => ((plateC1 M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC1 M ν)
  have hc2 : Continuous fun x : ℝ => ((plateC2 M ν x : ℝ) : ℂ) :=
    Complex.continuous_ofReal.comp (continuous_plateC2 M ν)
  refine continuous_const.mul (Continuous.add (Continuous.add ?_ ?_) ?_)
  · exact (hp.ac 2 (by norm_num) t r).mul hc
  · exact (continuous_const.mul (hp.ac 1 (by norm_num) t r)).mul hc1
  · exact (hp.ac 0 (by norm_num) t r).mul hc2

/-- The size of the angular amplitude and of its first two derivatives. -/
theorem norm_angAmp_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r φ : ℝ) (hr : 0 < r) :
    ‖angAmp ma M ν t r φ‖ ≤ r * B0
      ∧ ‖angAmp1 ma M ν t r φ‖ ≤ 3 * stC * (2 : ℝ) ^ M * (r * B0)
      ∧ ‖angAmp2 ma M ν t r φ‖ ≤ 7 * stC * ((2 : ℝ) ^ M) ^ 2 * (r * B0) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hP : (1 : ℝ) ≤ (2 : ℝ) ^ M := one_le_pow₀ (by norm_num)
  have hrn : ‖(r : ℂ)‖ = r := by
    rw [Complex.norm_real, Real.norm_eq_abs, abs_of_pos hr]
  have hc0 : ‖((plateC M ν φ : ℝ) : ℂ)‖ ≤ 1 := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC_le_one M ν φ
  have hc1 : ‖((plateC1 M ν φ : ℝ) : ℂ)‖ ≤ 2 * stC * (2 : ℝ) ^ M := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC1_le M ν φ
  have hc2 : ‖((plateC2 M ν φ : ℝ) : ℂ)‖ ≤ 2 * stC * ((2 : ℝ) ^ M) ^ 2 := by
    rw [Complex.norm_real, Real.norm_eq_abs]
    exact abs_plateC2_le M ν φ
  have hm0 : ‖ma 0 t r φ‖ ≤ B0 := hp.ab 0 (by norm_num) t r φ
  have hm1 : ‖ma 1 t r φ‖ ≤ B0 := hp.ab 1 (by norm_num) t r φ
  have hm2 : ‖ma 2 t r φ‖ ≤ B0 := hp.ab 2 (by norm_num) t r φ
  have hprod : ∀ (z w : ℂ) (X Y : ℝ), ‖z‖ ≤ X → ‖w‖ ≤ Y → 0 ≤ Y → ‖z * w‖ ≤ X * Y := by
    intro z w X Y hz hw hY
    rw [norm_mul]
    exact mul_le_mul hz hw (norm_nonneg _) (le_trans (norm_nonneg _) hz)
  refine ⟨?_, ?_, ?_⟩
  · rw [angAmp, norm_mul, hrn]
    have h := hprod (ma 0 t r φ) (((plateC M ν φ : ℝ) : ℂ)) B0 1 hm0 hc0 zero_le_one
    rw [mul_one] at h
    exact mul_le_mul_of_nonneg_left h (le_of_lt hr)
  · rw [angAmp1, norm_mul, hrn]
    have hA : ‖ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
        + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)‖
        ≤ B0 * 1 + B0 * (2 * stC * (2 : ℝ) ^ M) := by
      refine le_trans (norm_add_le _ _) (add_le_add ?_ ?_)
      · exact hprod _ _ _ _ hm1 hc0 zero_le_one
      · exact hprod _ _ _ _ hm0 hc1 (by positivity)
    have hstep : B0 * 1 + B0 * (2 * stC * (2 : ℝ) ^ M) ≤ 3 * stC * (2 : ℝ) ^ M * B0 := by
      nlinarith [hB0, hstC, hP, mul_le_mul_of_nonneg_left hP
          (le_of_lt (lt_of_lt_of_le zero_lt_one hstC))]
    calc r * ‖ma 1 t r φ * ((plateC M ν φ : ℝ) : ℂ)
          + ma 0 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)‖
        ≤ r * (3 * stC * (2 : ℝ) ^ M * B0) :=
          mul_le_mul_of_nonneg_left (le_trans hA hstep) (le_of_lt hr)
      _ = 3 * stC * (2 : ℝ) ^ M * (r * B0) := by ring
  · rw [angAmp2, norm_mul, hrn]
    have hA : ‖ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
        + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
        + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ)‖
        ≤ (B0 * 1 + 2 * B0 * (2 * stC * (2 : ℝ) ^ M))
          + B0 * (2 * stC * ((2 : ℝ) ^ M) ^ 2) := by
      refine le_trans (norm_add_le _ _) (add_le_add (le_trans (norm_add_le _ _)
        (add_le_add ?_ ?_)) ?_)
      · exact hprod _ _ _ _ hm2 hc0 zero_le_one
      · have h2 : ‖(2 : ℂ) * ma 1 t r φ‖ ≤ 2 * B0 := by
          rw [norm_mul]
          have : ‖(2 : ℂ)‖ = 2 := by norm_num
          rw [this]
          exact mul_le_mul_of_nonneg_left hm1 (by norm_num)
        exact hprod _ _ _ _ h2 hc1 (by positivity)
      · exact hprod _ _ _ _ hm0 hc2 (by positivity)
    have hstep : (B0 * 1 + 2 * B0 * (2 * stC * (2 : ℝ) ^ M))
        + B0 * (2 * stC * ((2 : ℝ) ^ M) ^ 2) ≤ 7 * stC * ((2 : ℝ) ^ M) ^ 2 * B0 := by
      have hPP : (2 : ℝ) ^ M ≤ ((2 : ℝ) ^ M) ^ 2 := by
        nlinarith [hP]
      have h1 : (1 : ℝ) ≤ stC * ((2 : ℝ) ^ M) ^ 2 := by
        nlinarith [hP, hstC]
      nlinarith [hB0, hstC, hP, hPP, h1,
        mul_le_mul_of_nonneg_left hPP (le_of_lt (lt_of_lt_of_le zero_lt_one hstC))]
    calc r * ‖ma 2 t r φ * ((plateC M ν φ : ℝ) : ℂ)
          + 2 * ma 1 t r φ * ((plateC1 M ν φ : ℝ) : ℂ)
          + ma 0 t r φ * ((plateC2 M ν φ : ℝ) : ℂ)‖
        ≤ r * (7 * stC * ((2 : ℝ) ^ M) ^ 2 * B0) :=
          mul_le_mul_of_nonneg_left (le_trans hA hstep) (le_of_lt hr)
      _ = 7 * stC * ((2 : ℝ) ^ M) ^ 2 * (r * B0) := by ring

/-- The angular amplitude and its derivative vanish at both ends of the plate. -/
theorem angAmp_zero_ends {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (_hp : PolarData j m mr ma B0) (M : ℕ) (ν : ℤ) (t r : ℝ) :
    angAmp ma M ν t r ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp1 ma M ν t r ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp ma M ν t r (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = 0
      ∧ angAmp1 ma M ν t r (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = 0 := by
  have hPQ : (2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ)) = 1 := by
    rw [show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by
      rw [zpow_natCast]]
    rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hleft : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) - (ν : ℝ) ≤ 0 := by
    have h : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) := by
      calc (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * (ν : ℝ) := by ring
        _ = (ν : ℝ) := by rw [hPQ, one_mul]
    rw [h]
    linarith
  have hright : 2 ≤ (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) - (ν : ℝ) := by
    have h : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) + 2 := by
      calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * ((ν : ℝ) + 2) := by ring
        _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
    rw [h]
    linarith
  obtain ⟨hz0, hz1, -⟩ := plateC_eq_zero_of_nonpos hleft
  obtain ⟨hw0, hw1, -⟩ := plateC_eq_zero_of_two_le hright
  refine ⟨?_, ?_, ?_, ?_⟩
  · rw [angAmp, hz0]
    simp
  · rw [angAmp1, hz0, hz1]
    simp
  · rw [angAmp, hw0]
    simp
  · rw [angAmp1, hw0, hw1]
    simp

end AngularAmp


/-! ### The angular estimate on a plate -/

section AngularPlate

theorem inv_two_pi_sq_le : ((2 * π) ^ 2)⁻¹ ≤ 1 / 16 := by
  have h4 : (4 : ℝ) ≤ 2 * π := by linarith [Real.two_le_pi]
  have h16 : (16 : ℝ) ≤ (2 * π) ^ 2 := by nlinarith [h4]
  rw [inv_eq_one_div, div_le_div_iff₀ (by positivity) (by norm_num)]
  linarith

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The angular estimate.**  On a plate of angular length `2·2^{-M}` on which the angular
derivative of the phase coefficient is at least `mu0 ≥ 2^{-M}`, while its second and third
derivatives are `O(1 + mu0)` and `O(mu0)`, two integrations by parts give `2^M/(r·mu0²)`. -/
theorem norm_angular_plate_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (u : Pl) (ε t : ℝ) (M : ℕ) (ν : ℤ)
    {mu0 r : ℝ} (hmu0 : 0 < mu0) (hmuM : (2 : ℝ) ^ (-(M : ℤ)) ≤ mu0) (hr : 0 < r)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu0 ≤ |psi1 u φ|)
    (h2 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi2 u φ| ≤ 3 + 24 * mu0)
    (h3 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi3 u φ| ≤ 8 * mu0) :
    ‖∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
        osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ‖
      ≤ 400 * stC * B0 * (2 : ℝ) ^ M / (r * mu0 ^ 2) := by
  set P : ℝ := (2 : ℝ) ^ M with hP
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hPpos : (0 : ℝ) < P := by rw [hP]; positivity
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hP1 : (1 : ℝ) ≤ P := by
    rw [hP]
    exact one_le_pow₀ (by norm_num)
  have hPQ : P * Q = 1 := by
    rw [hP, hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hPmu : (1 : ℝ) ≤ P * mu0 := by
    have h := mul_le_mul_of_nonneg_left hmuM (le_of_lt hPpos)
    rw [hPQ] at h
    exact h
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  set a : ℝ := (ν : ℝ) * Q with ha
  set b : ℝ := ((ν : ℝ) + 2) * Q with hb
  have hab : a ≤ b := by
    rw [ha, hb]
    exact mul_le_mul_of_nonneg_right (by linarith : (ν : ℝ) ≤ (ν : ℝ) + 2) (le_of_lt hQpos)
  have hba : b - a = 2 * Q := by
    rw [ha, hb]
    ring
  have hτ : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psiu u ε t x) (r * psi1 u φ) φ :=
    fun φ => (hasDerivAt_psiu u ε t φ).const_mul r
  have hτ1 : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psi1 u x) (r * psi2 u φ) φ :=
    fun φ => (hasDerivAt_psi1 u φ).const_mul r
  have hτ2 : ∀ φ : ℝ, HasDerivAt (fun x : ℝ => r * psi2 u x) (r * psi3 u φ) φ :=
    fun φ => (hasDerivAt_psi2 u φ).const_mul r
  have hτ1c : Continuous fun x : ℝ => r * psi1 u x := continuous_const.mul (continuous_psi1 u)
  have hτ2c : Continuous fun x : ℝ => r * psi2 u x := continuous_const.mul (continuous_psi2 u)
  have hτ3c : Continuous fun x : ℝ => r * psi3 u x := continuous_const.mul (continuous_psi3 u)
  have hlowr : ∀ φ ∈ Set.Icc a b, r * mu0 ≤ |r * psi1 u φ| := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (hlow φ hφ) (le_of_lt hr)
  have hc2 : (3 : ℝ) + 24 * mu0 ≤ 27 * (mu0 * P) := by
    have h1 : (1 : ℝ) ≤ mu0 * P := by
      rw [mul_comm]
      exact hPmu
    have h2' : mu0 ≤ mu0 * P := by nlinarith [hmu0, hP1]
    linarith
  have hT2 : ∀ φ ∈ Set.Icc a b, |r * psi2 u φ| ≤ r * (27 * (mu0 * P)) := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (le_trans (h2 φ hφ) hc2) (le_of_lt hr)
  have hT3 : ∀ φ ∈ Set.Icc a b, |r * psi3 u φ| ≤ r * (8 * mu0) := by
    intro φ hφ
    rw [abs_mul, abs_of_pos hr]
    exact mul_le_mul_of_nonneg_left (h3 φ hφ) (le_of_lt hr)
  obtain ⟨hv0, hv1, hw0, hw1⟩ := angAmp_zero_ends hp M ν t r
  have hlam : (2 * π : ℝ) ≠ 0 := by
    have := Real.pi_pos
    positivity
  have hibp := norm_integral_osc_ibp2_bound_on (a := a) (b := b) (lam := 2 * π)
    (mu := r * mu0) (M0 := r * B0) (M1 := 3 * stC * P * (r * B0))
    (M2 := 7 * stC * P ^ 2 * (r * B0)) (T2 := r * (27 * (mu0 * P))) (T3 := r * (8 * mu0))
    hab hlam (by positivity) hτ hτ1 hτ2 hτ1c hτ2c hτ3c
    (hasDerivAt_angAmp hp M ν t r) (hasDerivAt_angAmp1 hp M ν t r)
    (continuous_angAmp2 hp M ν t r) hlowr
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).1)
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).2.1)
    (fun φ _ => (norm_angAmp_le hp M ν t r φ hr).2.2)
    hT2 hT3 hv0 hw0 hv1 hw1
  refine le_trans hibp ?_
  have hden : (0 : ℝ) < r * mu0 ^ 2 := by positivity
  -- each of the four terms is an exact multiple of `stC P² B₀ /(r mu0²)`
  have e1 : 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
      = 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
  have e2 : 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
      = 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
    ring
  have e3 : r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3 = 8 * B0 / (r * mu0 ^ 2) := by
    field_simp
  have e4 : 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4
      = 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2) := by
    field_simp
    ring
  have g3 : 8 * B0 / (r * mu0 ^ 2) ≤ 8 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    refine div_le_div_of_nonneg_right ?_ hden.le
    have h1 : (1 : ℝ) ≤ stC * P ^ 2 := by nlinarith [hstC, hP1]
    nlinarith [h1, hB0]
  have g4 : 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2)
      ≤ 2187 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    refine div_le_div_of_nonneg_right ?_ hden.le
    nlinarith [hstC, hB0, sq_nonneg P, mul_nonneg hB0 (sq_nonneg P)]
  have hbrnn : (0 : ℝ) ≤ 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
        + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
        + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
        + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4 := by
    rw [e1, e2, e3, e4]
    have hfacnn : (0 : ℝ) ≤ stC * P ^ 2 * B0 :=
      mul_nonneg (mul_nonneg hstCnn (sq_nonneg P)) hB0
    have h1 : (0 : ℝ) ≤ 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by linarith) hden.le
    have h2' : (0 : ℝ) ≤ 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by linarith) hden.le
    have h3' : (0 : ℝ) ≤ 8 * B0 / (r * mu0 ^ 2) := div_nonneg (by linarith) hden.le
    have h4 : (0 : ℝ) ≤ 2187 * (P ^ 2 * B0) / (r * mu0 ^ 2) :=
      div_nonneg (by nlinarith [sq_nonneg P, hB0]) hden.le
    linarith
  have hbracket : 7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
        + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
        + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
        + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4
      ≤ 2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
    rw [e1, e2, e3, e4]
    have hsum : 7 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 243 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 8 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        + 2187 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)
        = 2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2) := by
      simp only [div_eq_mul_inv]
      ring
    linarith [g3, g4]
  have hpi : ((2 * π) ^ 2)⁻¹ ≤ 1 / 16 := inv_two_pi_sq_le
  have hstepf : (b - a) * ((2 * π) ^ 2)⁻¹
        * (7 * stC * P ^ 2 * (r * B0) / (r * mu0) ^ 2
          + 3 * (3 * stC * P * (r * B0)) * (r * (27 * (mu0 * P))) / (r * mu0) ^ 3
          + r * B0 * (r * (8 * mu0)) / (r * mu0) ^ 3
          + 3 * (r * B0) * (r * (27 * (mu0 * P))) ^ 2 / (r * mu0) ^ 4)
      ≤ 2 * Q * (1 / 16) * (2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2)) := by
    rw [hba]
    refine mul_le_mul (mul_le_mul_of_nonneg_left hpi (by positivity)) hbracket hbrnn ?_
    positivity
  refine le_trans hstepf ?_
  have hQP2 : Q * P ^ 2 = P := by
    have h : Q * P ^ 2 = (P * Q) * P := by ring
    rw [h, hPQ, one_mul]
  have hL : 2 * Q * (1 / 16) * (2445 * (stC * P ^ 2 * B0) / (r * mu0 ^ 2))
      = 2445 / 8 * (Q * P ^ 2) * (stC * B0) / (r * mu0 ^ 2) := by
    simp only [div_eq_mul_inv]
    ring
  rw [hL, hQP2]
  refine div_le_div_of_nonneg_right ?_ hden.le
  have hnn : (0 : ℝ) ≤ P * (stC * B0) := mul_nonneg (le_of_lt hPpos) (mul_nonneg hstCnn hB0)
  nlinarith [hnn]

end AngularPlate


/-! ### The plate decomposition of the kernel -/

section KernelPlates

/-- The radial integral of the kernel integrand at a fixed angle. -/
def kernRad (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) (φ : ℝ) : ℂ :=
  ∫ r in Set.Ioi (0 : ℝ), (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))

/-- The plate piece of the kernel. -/
def kernPlate (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) : ℂ :=
  ∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) • kernRad j ε m t u φ

theorem kern_integrand_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {ω : Pl}
    (h : (2 : ℝ) ^ ((j : ℤ) + 1) < ‖ω‖) :
    ee (-(inner ℝ u ω : ℝ)) * mfull j ε m t ω = 0 := by
  have hnot : ω ∉ Theta j := by
    intro hT
    exact absurd hT.2.2.2 (not_le.mpr h)
  rw [mfull_eq_zero hm ε t hnot, mul_zero]

/-- The kernel is the angular integral of its radial integrals. -/
theorem kern_eq_integral_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    kern j ε m t u = ∫ φ in Set.Ioo (-π) π, kernRad j ε m t u φ := by
  rw [kern]
  exact integral_polar_angle_outer (continuous_kern_integrand hm ε t u)
    (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
    (fun ω hω => kern_integrand_eq_zero hm ε t u hω)

/-- **The angular support.**  The multiplier vanishes unless the polar angle lies in `(1, π/2)`. -/
theorem mem_sector_angle {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) {t r φ : ℝ} (hr : 0 < r) (hφ : φ ∈ Set.Ioo (-π) π)
    (hne : m t (pt r φ) ≠ 0) : 1 < φ ∧ φ < π / 2 := by
  have hT := hm.supp t (pt r φ) hne
  have h0 : 0 < (pt r φ) 0 := hT.1
  have h1 : (pt r φ) 0 < (2 : ℝ) ^ (-(10 : ℤ)) * (pt r φ) 1 := hT.2.1
  rw [pt, mk2_apply_zero] at h0
  rw [pt, mk2_apply_zero, mk2_apply_one] at h1
  have hcos : 0 < Real.cos φ := by
    by_contra hc
    have : r * Real.cos φ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hc)
    linarith
  have hsin : 0 < Real.sin φ := by
    by_contra hs
    have hle : r * Real.sin φ ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hs)
    have hcpos : 0 < r * Real.cos φ := mul_pos hr hcos
    have hc10 : (0 : ℝ) < (2 : ℝ) ^ (-(10 : ℤ)) := by positivity
    nlinarith [h1, hle, hcpos]
  -- `sin φ > 0` and `φ ∈ (-π,π)` force `φ > 0`
  have hpos : 0 < φ := by
    by_contra hp
    have hple : φ ≤ 0 := not_lt.mp hp
    have hnn : 0 ≤ -φ := by linarith
    have hle : -φ ≤ π := by linarith [hφ.1]
    have h := Real.sin_nonneg_of_nonneg_of_le_pi hnn hle
    rw [Real.sin_neg] at h
    linarith
  -- `cos φ > 0` and `φ ∈ (0,π)` force `φ < π/2`
  have hlt : φ < π / 2 := by
    by_contra hq
    have hq' : π / 2 ≤ φ := not_lt.mp hq
    have hle : φ ≤ π + π / 2 := by linarith [hφ.2, Real.pi_pos]
    have h := Real.cos_nonpos_of_pi_div_two_le_of_le hq' hle
    linarith
  refine ⟨?_, hlt⟩
  by_contra hone
  have hle1 : φ ≤ 1 := not_lt.mp hone
  have hcoslow : (1 : ℝ) - φ ^ 2 / 2 ≤ Real.cos φ := Real.one_sub_sq_div_two_le_cos
  have hsinle : Real.sin φ ≤ 1 := Real.sin_le_one φ
  have hc10 : (2 : ℝ) ^ (-(10 : ℤ)) = 1 / 1024 := by
    norm_num [zpow_neg]
  have hcos2 : (1 : ℝ) / 2 ≤ Real.cos φ := by
    have hsq : φ ^ 2 ≤ 1 := by nlinarith [hpos, hle1]
    linarith
  have hcontr : r * Real.cos φ < (1 / 1024 : ℝ) * (r * Real.sin φ) := by
    rw [hc10] at h1
    exact h1
  nlinarith [hcontr, hcos2, hsinle, hr]

/-- Off the angular sector the radial integral vanishes. -/
theorem kernRad_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {φ : ℝ} (hφ : φ ∈ Set.Ioo (-π) π)
    (hout : ¬ (1 < φ ∧ φ < π / 2)) : kernRad j ε m t u φ = 0 := by
  rw [kernRad]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ),
      (r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)) = 0 := by
    intro r hr
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      exact hout (mem_sector_angle hm hr hφ hne)
    rw [mfull, hmz, mul_zero, mul_zero, smul_zero]
  rw [setIntegral_congr_fun measurableSet_Ioi hzero]
  simp

/-- The radial integrals are integrable in the angle. -/
theorem integrableOn_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    IntegrableOn (kernRad j ε m t u) (Set.Ioo (-π) π) volume := by
  have hprod : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint : Integrable (fun q : ℝ × ℝ => q.1 •
        (ee (-(inner ℝ u (pt q.1 q.2) : ℝ)) * mfull j ε m t (pt q.1 q.2)))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprod]
    exact integrableOn_polar (continuous_kern_integrand hm ε t u)
      (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
      (fun ω hω => kern_integrand_eq_zero hm ε t u hω)
  exact hint.integral_prod_right

/-- Each plate piece is integrable in the angle. -/
theorem integrableOn_plate_kernRad {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    IntegrableOn (fun φ => (plateC M ν φ : ℝ) • kernRad j ε m t u φ)
      (Set.Ioo (-π) π) volume := by
  have hkr := integrableOn_kernRad hm ε t u
  refine Integrable.mono' hkr.norm ?_ ?_
  · exact ((continuous_plateC M ν).aestronglyMeasurable).smul hkr.aestronglyMeasurable
  · filter_upwards with φ
    rw [norm_smul, Real.norm_eq_abs]
    have h1 := abs_plateC_le_one M ν φ
    have h2 : (0 : ℝ) ≤ ‖kernRad j ε m t u φ‖ := norm_nonneg _
    nlinarith [h1, h2]

/-- **The plate decomposition.**  The kernel is the sum of its plate pieces. -/
theorem kern_eq_sum_plates {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {M : ℕ} (hM : 1 ≤ M) :
    kern j ε m t u
      = ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, kernPlate j ε m t u M ν := by
  have hPpos : (0 : ℝ) < (2 : ℝ) ^ M := by positivity
  have hB : (0 : ℤ) ≤ ⌈π * (2 : ℝ) ^ M⌉ := by
    refine Int.ceil_nonneg ?_
    positivity
  have hP1 : (2 : ℝ) ≤ (2 : ℝ) ^ M := by
    calc (2 : ℝ) = (2 : ℝ) ^ (1 : ℕ) := by norm_num
      _ ≤ (2 : ℝ) ^ M := pow_le_pow_right₀ (by norm_num) hM
  have hsum1 : ∀ φ ∈ Set.Ioo (-π) π,
      ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, (plateC M ν φ : ℝ) • kernRad j ε m t u φ
        = kernRad j ε m t u φ := by
    intro φ hφ
    by_cases hs : 1 < φ ∧ φ < π / 2
    · have hone : ∑ ν ∈ Finset.Icc (0 : ℤ) ⌈π * (2 : ℝ) ^ M⌉, plateC M ν φ = 1 := by
        rw [sum_plateC M 0 _ hB φ]
        have hT0 : plateT M 0 φ = 1 := by
          rw [plateT]
          refine Real.smoothTransition.one_of_one_le ?_
          push_cast
          nlinarith [hs.1, hP1]
        have hTB : plateT M (⌈π * (2 : ℝ) ^ M⌉ + 1) φ = 0 := by
          rw [plateT]
          refine Real.smoothTransition.zero_of_nonpos ?_
          have hceil : π * (2 : ℝ) ^ M ≤ ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) := Int.le_ceil _
          push_cast
          nlinarith [hs.2, Real.pi_pos, hPpos, hceil]
        rw [hT0, hTB, sub_zero]
      rw [← Finset.sum_smul, hone, one_smul]
    · rw [kernRad_eq_zero hm ε t u hφ hs]
      simp
  rw [kern_eq_integral_kernRad hm ε t u, ← setIntegral_congr_fun measurableSet_Ioo hsum1]
  rw [integral_finsetSum _ (fun ν _ => integrableOn_plate_kernRad hm ε t u M ν)]
  rfl

/-- The trivial bound for the radial integral. -/
theorem norm_kernRad_le_trivial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    (hp : PolarData j m mr ma B0) (ε t : ℝ) (u : Pl) (φ : ℝ) :
    ‖kernRad j ε m t u φ‖ ≤ B0 * ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set b : ℝ := (2 : ℝ) ^ ((j : ℤ) + 2) with hb
  have hbpos : (0 : ℝ) < b := by rw [hb]; positivity
  have heq : kernRad j ε m t u φ
      = ∫ r in (0 : ℝ)..b, osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r := by
    rw [kernRad]
    exact radial_integral_eq hp ε t u φ
  rw [heq]
  have hconst : ∀ r ∈ Set.uIoc (0 : ℝ) b,
      ‖osc (2 * π) (r * psiu u ε t φ) * radAmp mr t φ r‖ ≤ b * B0 := by
    intro r hr
    rw [Set.uIoc_of_le (le_of_lt hbpos)] at hr
    rw [norm_mul, norm_osc, one_mul, radAmp, norm_mul, Complex.norm_real, Real.norm_eq_abs]
    have hrb : |r| ≤ b := by
      rw [abs_of_nonneg (le_of_lt hr.1)]
      exact hr.2
    have hm0 : ‖mr 0 t φ r‖ ≤ B0 := by
      have h := hp.rb 0 (by norm_num) t φ r
      simpa using h
    exact mul_le_mul hrb hm0 (norm_nonneg _) (le_of_lt hbpos)
  have h := intervalIntegral.norm_integral_le_of_norm_le_const hconst
  refine le_trans h (le_of_eq ?_)
  have habs : |b - 0| = b := by
    rw [sub_zero, abs_of_pos hbpos]
  rw [habs, hb]
  ring

/-- **The plate bound from a uniform bound for the radial integrals.**  Only the values of the
radial integral on the plate matter. -/
theorem norm_kernPlate_le_of_kernRad_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (_hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {C : ℝ} (hCnn : 0 ≤ C)
    (hrad : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), ‖kernRad j ε m t u φ‖ ≤ C) :
    ‖kernPlate j ε m t u M ν‖ ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * C := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  set I : Set ℝ := Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) with hI
  -- the plate piece is an integral over the intersection with the plate
  have hzero : ∀ φ ∈ Set.Ioo (-π) π \ (Set.Ioo (-π) π ∩ I),
      (plateC M ν φ : ℝ) • kernRad j ε m t u φ = 0 := by
    intro φ hφ
    have hnot : φ ∉ I := by
      intro hmem
      exact hφ.2 ⟨hφ.1, hmem⟩
    rw [hI, Set.mem_Icc, not_and_or] at hnot
    have hpz : plateC M ν φ = 0 := by
      rcases hnot with h | h
      · refine (plateC_eq_zero_of_nonpos ?_).1
        have hlt : φ < (ν : ℝ) * Q := not_le.mp h
        have hmul : (2 : ℝ) ^ M * φ < (2 : ℝ) ^ M * ((ν : ℝ) * Q) :=
          mul_lt_mul_of_pos_left hlt (by positivity)
        have hPQ : (2 : ℝ) ^ M * Q = 1 := by
          rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
            ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
          simp
        have hval : (2 : ℝ) ^ M * ((ν : ℝ) * Q) = (ν : ℝ) := by
          calc (2 : ℝ) ^ M * ((ν : ℝ) * Q) = ((2 : ℝ) ^ M * Q) * (ν : ℝ) := by ring
            _ = (ν : ℝ) := by rw [hPQ, one_mul]
        rw [hval] at hmul
        linarith
      · refine (plateC_eq_zero_of_two_le ?_).1
        have hgt : ((ν : ℝ) + 2) * Q < φ := not_le.mp h
        have hmul : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) < (2 : ℝ) ^ M * φ :=
          mul_lt_mul_of_pos_left hgt (by positivity)
        have hPQ : (2 : ℝ) ^ M * Q = 1 := by
          rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
            ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
          simp
        have hval : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) = (ν : ℝ) + 2 := by
          calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * Q) = ((2 : ℝ) ^ M * Q) * ((ν : ℝ) + 2) := by ring
            _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
        rw [hval] at hmul
        linarith
    rw [hpz]
    simp
  have hrestrict : (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) • kernRad j ε m t u φ)
      = ∫ φ in Set.Ioo (-π) π ∩ I, (plateC M ν φ : ℝ) • kernRad j ε m t u φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioo
      Set.inter_subset_left hzero
  rw [kernPlate, hrestrict]
  -- the uniform bound on the plate
  have hbd : ∀ φ ∈ Set.Ioo (-π) π ∩ I, ‖(plateC M ν φ : ℝ) • kernRad j ε m t u φ‖ ≤ C := by
    intro φ hφ
    have hradφ : ‖kernRad j ε m t u φ‖ ≤ C := hrad φ (by rw [hI] at hφ; exact hφ.2)
    rw [norm_smul, Real.norm_eq_abs]
    have h1 := abs_plateC_le_one M ν φ
    have h2 : (0 : ℝ) ≤ ‖kernRad j ε m t u φ‖ := norm_nonneg _
    calc |plateC M ν φ| * ‖kernRad j ε m t u φ‖ ≤ 1 * ‖kernRad j ε m t u φ‖ :=
          mul_le_mul_of_nonneg_right h1 h2
      _ = ‖kernRad j ε m t u φ‖ := one_mul _
      _ ≤ C := hradφ
  have hmeas : volume (Set.Ioo (-π) π ∩ I) ≤ ENNReal.ofReal (2 * Q) := by
    refine le_trans (measure_mono Set.inter_subset_right) ?_
    rw [hI, Real.volume_Icc]
    refine ENNReal.ofReal_le_ofReal ?_
    have h : ((ν : ℝ) + 2) * Q - (ν : ℝ) * Q = 2 * Q := by ring
    rw [h]
  have hfin : volume (Set.Ioo (-π) π ∩ I) < ⊤ :=
    lt_of_le_of_lt hmeas (by exact ENNReal.ofReal_lt_top)
  have hle := norm_setIntegral_le_of_norm_le_const hfin hbd
  refine le_trans hle ?_
  have htoreal : (volume (Set.Ioo (-π) π ∩ I)).toReal ≤ 2 * Q := by
    have h := ENNReal.toReal_le_toReal hfin.ne (by exact ENNReal.ofReal_ne_top) |>.mpr hmeas
    refine le_trans h ?_
    rw [ENNReal.toReal_ofReal (by positivity)]
  calc C * (volume (Set.Ioo (-π) π ∩ I)).toReal ≤ C * (2 * Q) :=
        mul_le_mul_of_nonneg_left htoreal hCnn
    _ = 2 * Q * C := by ring

/-- On the support of the multiplier both polar coordinates of the frequency are positive. -/
theorem sin_cos_pos_of_ne {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) {t r φ : ℝ} (hr : 0 < r) (hne : m t (pt r φ) ≠ 0) :
    0 < Real.sin φ ∧ 0 < Real.cos φ := by
  have hT := hm.supp t (pt r φ) hne
  have h0 : 0 < (pt r φ) 0 := hT.1
  have h1 : 0 < (pt r φ) 1 := Theta.snd_pos hT
  rw [pt, mk2_apply_zero] at h0
  rw [pt, mk2_apply_one] at h1
  constructor
  · by_contra hs
    have := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hs)
    linarith
  · by_contra hc
    have := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hr) (not_lt.mp hc)
    linarith

/-- **The radial route for a plate.**  If the phase coefficient is at least `mu` on the plate, the
radial estimate integrates to `2·2^{-M}·B₀ 2^{-2j} mu^{-4}`. -/
theorem norm_kernPlate_le_radial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {mu : ℝ} (hmu : 0 < mu)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu ≤ |psiu u ε t φ|) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * (B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / mu ^ 4) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  refine norm_kernPlate_le_of_kernRad_le hp hm ε t u M ν (by positivity) ?_
  intro φ hφ
  have hmuφ : mu ≤ |psiu u ε t φ| := hlow φ hφ
  have hψ : psiu u ε t φ ≠ 0 := by
    intro h0
    rw [h0, abs_zero] at hmuφ
    linarith
  have hradφ : ‖kernRad j ε m t u φ‖
      ≤ B0 * (2 : ℝ) ^ (-(2 * (j : ℤ))) / |psiu u ε t φ| ^ 4 := by
    rw [kernRad]
    exact norm_radial_integral_le hp ε t u φ hψ
  have hpow : mu ^ 4 ≤ |psiu u ε t φ| ^ 4 := pow_le_pow_left₀ (le_of_lt hmu) hmuφ 4
  refine le_trans hradφ ?_
  exact div_le_div_of_nonneg_left (by positivity) (by positivity) hpow

/-- **The trivial route for a plate.** -/
theorem norm_kernPlate_le_trivial {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 2 * (2 : ℝ) ^ (-(M : ℤ)) * (B0 * ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2) := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  refine norm_kernPlate_le_of_kernRad_le hp hm ε t u M ν (by positivity) ?_
  intro φ _
  exact norm_kernRad_le_trivial hp ε t u φ

/-- The plate piece with the radius outermost. -/
theorem kernPlate_eq_radius_outer {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ) :
    kernPlate j ε m t u M ν
      = ∫ r in Set.Ioi (0 : ℝ), ∫ φ in Set.Ioo (-π) π,
          (plateC M ν φ : ℝ) •
            ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))) := by
  have hprodOI : ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))
      = (volume : Measure (ℝ × ℝ)).restrict (Set.Ioi (0 : ℝ) ×ˢ Set.Ioo (-π) π) := by
    rw [Measure.volume_eq_prod, Measure.prod_restrict]
  have hint0 : Integrable (fun q : ℝ × ℝ => q.1 •
        (ee (-(inner ℝ u (pt q.1 q.2) : ℝ)) * mfull j ε m t (pt q.1 q.2)))
      (((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ))).prod
        ((volume : Measure ℝ).restrict (Set.Ioo (-π) π))) := by
    rw [hprodOI]
    exact integrableOn_polar (continuous_kern_integrand hm ε t u)
      (R := (2 : ℝ) ^ ((j : ℤ) + 1)) (by positivity)
      (fun ω hω => kern_integrand_eq_zero hm ε t u hω)
  -- the plate-weighted integrand is integrable on the swapped product
  have hint : Integrable (Function.uncurry fun (φ : ℝ) (r : ℝ) =>
        (plateC M ν φ : ℝ) • ((r : ℝ) •
          (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))))
      (((volume : Measure ℝ).restrict (Set.Ioo (-π) π)).prod
        ((volume : Measure ℝ).restrict (Set.Ioi (0 : ℝ)))) := by
    have hswap := hint0.swap
    refine Integrable.mono' hswap.norm ?_ ?_
    · have hc : Continuous (Function.uncurry fun (φ : ℝ) (r : ℝ) =>
          (plateC M ν φ : ℝ) • ((r : ℝ) •
            (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))) := by
        have h1 : Continuous fun q : ℝ × ℝ => plateC M ν q.1 :=
          (continuous_plateC M ν).comp continuous_fst
        have h2 : Continuous fun q : ℝ × ℝ => (q.2 : ℝ) •
            (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1)) := by
          refine continuous_snd.smul ?_
          refine (continuous_kern_integrand hm ε t u).comp ?_
          exact continuous_pt.comp (continuous_snd.prodMk continuous_fst)
        exact h1.smul h2
      exact hc.aestronglyMeasurable
    · filter_upwards with q
      have h1 := abs_plateC_le_one M ν q.1
      have h2 : (0 : ℝ) ≤ ‖(q.2 : ℝ) •
          (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1))‖ := norm_nonneg _
      change ‖(plateC M ν q.1 : ℝ) • ((q.2 : ℝ) •
        (ee (-(inner ℝ u (pt q.2 q.1) : ℝ)) * mfull j ε m t (pt q.2 q.1)))‖ ≤ _
      rw [norm_smul, Real.norm_eq_abs]
      have hsw : ‖(Prod.swap q).1 •
          (ee (-(inner ℝ u (pt (Prod.swap q).1 (Prod.swap q).2) : ℝ))
            * mfull j ε m t (pt (Prod.swap q).1 (Prod.swap q).2))‖
          = ‖(q.2 : ℝ) • (ee (-(inner ℝ u (pt q.2 q.1) : ℝ))
            * mfull j ε m t (pt q.2 q.1))‖ := rfl
      rw [Function.comp_apply] at *
      nlinarith [h1, h2]
  rw [kernPlate]
  have hin : ∀ φ : ℝ, (plateC M ν φ : ℝ) • kernRad j ε m t u φ
      = ∫ r in Set.Ioi (0 : ℝ), (plateC M ν φ : ℝ) •
          ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))) := by
    intro φ
    rw [kernRad, integral_smul]
  rw [setIntegral_congr_fun measurableSet_Ioo (fun φ _ => hin φ)]
  exact integral_integral_swap hint

/-- The plate cutoff kills the angles outside its plate. -/
theorem plateC_eq_zero_of_not_mem {M : ℕ} {ν : ℤ} {φ : ℝ}
    (h : φ ∉ Set.Ioc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))) :
    plateC M ν φ = 0 := by
  have hPQ : (2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ)) = 1 := by
    rw [show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  rw [Set.mem_Ioc, not_and_or] at h
  rcases h with h | h
  · refine (plateC_eq_zero_of_nonpos ?_).1
    have hle : φ ≤ (ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)) := not_lt.mp h
    have hmul : (2 : ℝ) ^ M * φ ≤ (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) :=
      mul_le_mul_of_nonneg_left hle (by positivity)
    have hval : (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) := by
      calc (2 : ℝ) ^ M * ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * (ν : ℝ) := by ring
        _ = (ν : ℝ) := by rw [hPQ, one_mul]
    rw [hval] at hmul
    linarith
  · refine (plateC_eq_zero_of_two_le ?_).1
    have hgt : ((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)) < φ := not_le.mp h
    have hmul : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) ≤ (2 : ℝ) ^ M * φ :=
      mul_le_mul_of_nonneg_left (le_of_lt hgt) (by positivity)
    have hval : (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))) = (ν : ℝ) + 2 := by
      calc (2 : ℝ) ^ M * (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
          = ((2 : ℝ) ^ M * (2 : ℝ) ^ (-(M : ℤ))) * ((ν : ℝ) + 2) := by ring
        _ = (ν : ℝ) + 2 := by rw [hPQ, one_mul]
    rw [hval] at hmul
    linarith

/-- For a fixed radius, the plate-weighted angular integral is an interval integral over the
plate, with the angular amplitude `angAmp`. -/
theorem angular_integral_eq {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl)
    {M : ℕ} (hM : 1 ≤ M) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉) {r : ℝ} (hr : 0 < r) :
    (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ))))
      = ∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
          osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hQhalf : Q ≤ 1 / 2 := by
    rw [hQ]
    have h : (2 : ℝ) ^ (-(M : ℤ)) ≤ (2 : ℝ) ^ (-(1 : ℤ)) := by
      refine zpow_le_zpow_right₀ (by norm_num : (1 : ℝ) ≤ 2) ?_
      omega
    calc (2 : ℝ) ^ (-(M : ℤ)) ≤ (2 : ℝ) ^ (-(1 : ℤ)) := h
      _ = 1 / 2 := by norm_num
  -- the pointwise identity
  have hpt : ∀ φ : ℝ, (plateC M ν φ : ℝ) •
      ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))
      = osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    intro φ
    rw [kern_polar_pt j m ε t u (le_of_lt hr) φ, angAmp, hp.a0, Complex.real_smul]
    ring
  -- both integrals are over the intersection of the plate with `(-π,π)`
  set I : Set ℝ := Set.Ioc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) with hI
  have hIm : MeasurableSet I := by
    rw [hI]
    exact measurableSet_Ioc
  have hleft : (∫ φ in Set.Ioo (-π) π, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ)
      = ∫ φ in Set.Ioo (-π) π ∩ I, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioo
      Set.inter_subset_left ?_
    intro φ hφ
    have hnot : φ ∉ I := fun hmem => hφ.2 ⟨hφ.1, hmem⟩
    have hz : plateC M ν φ = 0 := plateC_eq_zero_of_not_mem (by rw [hI] at hnot; exact hnot)
    rw [angAmp, hz]
    simp
  have hright : (∫ φ in I, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ)
      = ∫ φ in I ∩ Set.Ioo (-π) π, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ := by
    refine setIntegral_eq_of_subset_of_forall_sdiff_eq_zero hIm Set.inter_subset_left ?_
    intro φ hφ
    have hmemI : φ ∈ I := hφ.1
    have hnot : φ ∉ Set.Ioo (-π) π := fun hmem => hφ.2 ⟨hmemI, hmem⟩
    -- such an angle is at least `π`, hence has non-positive sine
    have hlow : 0 < φ := by
      rw [hI, Set.mem_Ioc] at hmemI
      have h0 : (0 : ℝ) ≤ (ν : ℝ) * Q := by
        have : (0 : ℝ) ≤ (ν : ℝ) := by exact_mod_cast hν
        positivity
      linarith [hmemI.1]
    have hpi : π ≤ φ := by
      rw [Set.mem_Ioo, not_and_or] at hnot
      rcases hnot with h | h
      · exact absurd hlow (by linarith [not_lt.mp h, Real.pi_pos])
      · exact not_lt.mp h
    have hup : φ ≤ 2 * π := by
      rw [hI, Set.mem_Ioc] at hmemI
      have hceil : ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) ≤ π * (2 : ℝ) ^ M + 1 := by
        have h := Int.ceil_lt_add_one (π * (2 : ℝ) ^ M)
        linarith
      have hνle : ((ν : ℤ) : ℝ) ≤ π * (2 : ℝ) ^ M + 1 := by
        have h : ((ν : ℤ) : ℝ) ≤ ((⌈π * (2 : ℝ) ^ M⌉ : ℤ) : ℝ) := by exact_mod_cast hνB
        linarith
      have hPQ : (2 : ℝ) ^ M * Q = 1 := by
        rw [hQ, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
          ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
        simp
      have hstep : ((ν : ℝ) + 2) * Q ≤ π + 3 * Q := by
        have h1 : (ν : ℝ) * Q ≤ (π * (2 : ℝ) ^ M + 1) * Q :=
          mul_le_mul_of_nonneg_right hνle (le_of_lt hQpos)
        have h2 : (π * (2 : ℝ) ^ M + 1) * Q = π + Q := by
          calc (π * (2 : ℝ) ^ M + 1) * Q = π * ((2 : ℝ) ^ M * Q) + Q := by ring
            _ = π + Q := by rw [hPQ, mul_one]
        nlinarith [h1, h2, hQpos]
      have hπ : (2 : ℝ) ≤ π := Real.two_le_pi
      nlinarith [hmemI.2, hstep, hQhalf, hπ]
    have hsin : Real.sin φ ≤ 0 := by
      have h1 : 0 ≤ φ - π := by linarith
      have h2 : φ - π ≤ π := by linarith
      have h := Real.sin_nonneg_of_nonneg_of_le_pi h1 h2
      rw [Real.sin_sub_pi] at h
      linarith
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      exact absurd (sin_cos_pos_of_ne hm hr hne).1 (not_lt.mpr hsin)
    rw [angAmp, hp.a0, hmz]
    simp
  rw [setIntegral_congr_fun measurableSet_Ioo (fun φ _ => hpt φ), hleft,
    intervalIntegral.integral_of_le (by nlinarith [hQpos] : (ν : ℝ) * Q ≤ ((ν : ℝ) + 2) * Q),
    ← hI, hright, Set.inter_comm]

/-- Off the frequency annulus the angular integral vanishes. -/
theorem angular_integral_eq_zero {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {r : ℝ} (hr : 0 < r) (hout : r < (2 : ℝ) ^ ((j : ℤ) - 1) ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r) :
    (∫ φ in ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))..(((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))),
        osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ) = 0 := by
  have hzero : ∀ φ : ℝ, osc (2 * π) (r * psiu u ε t φ) * angAmp ma M ν t r φ = 0 := by
    intro φ
    have hmz : m t (pt r φ) = 0 := by
      by_contra hne
      have hT := hm.supp t (pt r φ) hne
      have hnorm : ‖pt r φ‖ = r := norm_pt r φ (le_of_lt hr)
      rcases hout with h | h
      · have := hT.2.2.1
        rw [hnorm] at this
        linarith
      · have := hT.2.2.2
        rw [hnorm] at this
        linarith
    rw [angAmp, hp.a0, hmz]
    simp
  rw [intervalIntegral.integral_congr (fun φ _ => hzero φ)]
  simp

/-- **The angular route for a plate.**  Two integrations by parts in the angle, integrated over the
radial annulus. -/
theorem norm_kernPlate_le_angular {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl)
    {M : ℕ} (hM : 1 ≤ M) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    {mu0 : ℝ} (hmu0 : 0 < mu0) (hmuM : (2 : ℝ) ^ (-(M : ℤ)) ≤ mu0)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu0 ≤ |psi1 u φ|)
    (h2 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi2 u φ| ≤ 3 + 24 * mu0)
    (h3 : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), |psi3 u φ| ≤ 8 * mu0) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 3200 * stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  set K : ℝ := stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 with hK
  have hKnn : (0 : ℝ) ≤ K := by
    rw [hK]
    refine div_nonneg ?_ (by positivity)
    exact mul_nonneg (mul_nonneg (le_trans zero_le_one hstC) hB0) (by positivity)
  set A : ℝ := (2 : ℝ) ^ ((j : ℤ) - 2) with hA
  set Bb : ℝ := (2 : ℝ) ^ ((j : ℤ) + 1) with hBb
  have hApos : (0 : ℝ) < A := by rw [hA]; positivity
  have hBpos : (0 : ℝ) < Bb := by rw [hBb]; positivity
  have hAB : A ≤ Bb := by
    rw [hA, hBb]
    exact zpow_le_zpow_right₀ (by norm_num) (by omega)
  -- the radius-outer representation
  rw [kernPlate_eq_radius_outer hm ε t u M ν]
  have hzero : ∀ r ∈ Set.Ioi (0 : ℝ) \ Set.Ioc A Bb,
      (∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))) = 0 := by
    intro r hr
    have hrpos : (0 : ℝ) < r := hr.1
    have hnot : r ∉ Set.Ioc A Bb := hr.2
    rw [Set.mem_Ioc, not_and_or] at hnot
    have hout : r < (2 : ℝ) ^ ((j : ℤ) - 1) ∨ (2 : ℝ) ^ ((j : ℤ) + 1) < r := by
      rcases hnot with h | h
      · refine Or.inl ?_
        have hle : r ≤ A := not_lt.mp h
        have hlt : A < (2 : ℝ) ^ ((j : ℤ) - 1) := by
          rw [hA]
          exact zpow_lt_zpow_right₀ (by norm_num) (by omega)
        linarith
      · exact Or.inr (not_le.mp h)
    rw [angular_integral_eq hp hm ε t u hM hν hνB hrpos]
    exact angular_integral_eq_zero hp hm ε t u M ν hrpos hout
  have hsub : Set.Ioc A Bb ⊆ Set.Ioi (0 : ℝ) := fun r hr => lt_trans hApos hr.1
  rw [setIntegral_eq_of_subset_of_forall_sdiff_eq_zero measurableSet_Ioi hsub hzero]
  -- the uniform bound on the annulus
  have hbd : ∀ r ∈ Set.Ioc A Bb,
      ‖∫ φ in Set.Ioo (-π) π, (plateC M ν φ : ℝ) •
        ((r : ℝ) • (ee (-(inner ℝ u (pt r φ) : ℝ)) * mfull j ε m t (pt r φ)))‖
      ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) := by
    intro r hr
    have hrpos : (0 : ℝ) < r := lt_trans hApos hr.1
    rw [angular_integral_eq hp hm ε t u hM hν hνB hrpos]
    have h := norm_angular_plate_le hp u ε t M ν hmu0 hmuM hrpos hlow h2 h3
    refine le_trans h ?_
    have hrinv : (r : ℝ)⁻¹ ≤ (2 : ℝ) ^ (2 - (j : ℤ)) := by
      have hAinv : A⁻¹ = (2 : ℝ) ^ (2 - (j : ℤ)) := by
        rw [hA, ← zpow_neg]
        congr 1
        ring
      rw [← hAinv]
      exact inv_anti₀ hApos (le_of_lt hr.1)
    have hlhs : 400 * stC * B0 * (2 : ℝ) ^ M / (r * mu0 ^ 2) = (400 * K) * r⁻¹ := by
      rw [hK]
      field_simp
    rw [hlhs]
    exact mul_le_mul_of_nonneg_left hrinv (by positivity)
  have hfin : volume (Set.Ioc A Bb) < ⊤ := by
    rw [Real.volume_Ioc]
    exact ENNReal.ofReal_lt_top
  have hle := norm_setIntegral_le_of_norm_le_const hfin hbd
  refine le_trans hle ?_
  have htoreal : (volume (Set.Ioc A Bb)).toReal ≤ Bb := by
    rw [Real.volume_Ioc, ENNReal.toReal_ofReal (by linarith)]
    linarith [hApos]
  have hCnn : (0 : ℝ) ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) := by positivity
  calc 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * (volume (Set.Ioc A Bb)).toReal
      ≤ 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * Bb :=
        mul_le_mul_of_nonneg_left htoreal hCnn
    _ = 3200 * K := by
        have hpow8 : (2 : ℝ) ^ (2 - (j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1) = 8 := by
          rw [← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0),
            show (2 - (j : ℤ) + ((j : ℤ) + 1)) = 3 by ring]
          norm_num
        calc 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ))) * Bb
            = 400 * K * ((2 : ℝ) ^ (2 - (j : ℤ)) * (2 : ℝ) ^ ((j : ℤ) + 1)) := by
              rw [hBb]
              ring
          _ = 3200 * K := by
              rw [hpow8]
              ring
    _ = 3200 * stC * B0 * (2 : ℝ) ^ M / mu0 ^ 2 := by
        rw [hK]
        field_simp

/-! ### An elementary one-dimensional integral -/

/-- The quadratically decaying bump `(1 + A|a v + b|)^{-2}` has integral at most `2π/(Aa)`.
It is dominated by the Cauchy kernel `2(1 + (A(av+b))²)^{-1}`. -/
theorem integral_inv_one_add_abs_sq_le {A a b : ℝ} (hA : 0 < A) (ha : 0 < a) :
    (∫ v : ℝ, (1 + A * |a * v + b|)⁻¹ ^ 2) ≤ 2 * π / (A * a) := by
  set c : ℝ := A * a with hc
  have hcpos : (0 : ℝ) < c := by rw [hc]; positivity
  have hcne : c ≠ 0 := ne_of_gt hcpos
  -- the pointwise majorant
  have hmaj : ∀ v : ℝ, (1 + A * |a * v + b|)⁻¹ ^ 2 ≤ 2 * (1 + (c * v + A * b) ^ 2)⁻¹ := by
    intro v
    set y : ℝ := A * |a * v + b| with hy
    have hynn : (0 : ℝ) ≤ y := by
      rw [hy]
      positivity
    have hsq : (c * v + A * b) ^ 2 = y ^ 2 := by
      rw [hy, hc, mul_pow, sq_abs]
      ring
    rw [hsq, inv_pow]
    have hp1 : (0 : ℝ) < (1 + y) ^ 2 := by positivity
    have hp2 : (0 : ℝ) < 1 + y ^ 2 := by positivity
    rw [show (2 : ℝ) * (1 + y ^ 2)⁻¹ = 2 / (1 + y ^ 2) by
      rw [div_eq_mul_inv]]
    rw [inv_eq_one_div, div_le_div_iff₀ hp1 hp2]
    nlinarith [hynn]
  -- the majorant is integrable, with integral `2π/c`
  have hbase : Integrable fun x : ℝ => (1 + x ^ 2)⁻¹ := integrable_inv_one_add_sq
  have hshift : Integrable fun x : ℝ => (1 + (x + A * b) ^ 2)⁻¹ :=
    hbase.comp_add_right (A * b)
  have hscale : Integrable fun v : ℝ => (1 + (c * v + A * b) ^ 2)⁻¹ := by
    have h := hshift.comp_mul_left' hcne
    refine h.congr ?_
    filter_upwards with v
    ring_nf
  have hint : Integrable fun v : ℝ => 2 * (1 + (c * v + A * b) ^ 2)⁻¹ := hscale.const_mul 2
  have hnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => (1 + A * |a * v + b|)⁻¹ ^ 2 := by
    filter_upwards with v
    change (0 : ℝ) ≤ (1 + A * |a * v + b|)⁻¹ ^ 2
    positivity
  have hle := integral_mono_of_nonneg hnn hint (Filter.Eventually.of_forall hmaj)
  refine le_trans hle (le_of_eq ?_)
  -- compute the majorant's integral
  have hcomp : (∫ v : ℝ, (1 + (c * v + A * b) ^ 2)⁻¹) = c⁻¹ * π := by
    have hstep : (∫ v : ℝ, (1 + (c * v + A * b) ^ 2)⁻¹)
        = ∫ v : ℝ, (fun y : ℝ => (1 + (y + A * b) ^ 2)⁻¹) (c * v) := by
      refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
      change (1 + (c * v + A * b) ^ 2)⁻¹ = (1 + (c * v + A * b) ^ 2)⁻¹
      rfl
    rw [hstep, MeasureTheory.Measure.integral_comp_mul_left (fun y : ℝ => (1 + (y + A * b) ^ 2)⁻¹)
        c]
    rw [MeasureTheory.integral_add_right_eq_self (fun x : ℝ => (1 + x ^ 2)⁻¹) (A * b)]
    rw [integral_univ_inv_one_add_sq, smul_eq_mul, abs_of_pos (by positivity : (0 : ℝ) < c⁻¹)]
  rw [integral_const_mul, hcomp, hc]
  field_simp

/-! ### Combining the two routes, and the sinusoid form of the phase -/

/-- If a nonnegative quantity is bounded by both `R` and `A`, it is bounded by any `Z ≥ 0` with
`R·A ≤ Z²`.  This replaces taking square roots. -/
theorem le_of_sq_le_mul {K R A Z : ℝ} (hK : 0 ≤ K) (hZ : 0 ≤ Z) (hR : K ≤ R) (hA : K ≤ A)
    (h : R * A ≤ Z ^ 2) : K ≤ Z := by
  have hKK : K ^ 2 ≤ R * A := by nlinarith
  nlinarith [hKK, h]

/-- **The capped radial route.**  Combining the radial estimate with the trivial one gives a bound
which is finite even where the phase coefficient vanishes. -/
theorem norm_kernPlate_le_capped {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0') (ε t : ℝ) (u : Pl) (M : ℕ) (ν : ℤ)
    {mu : ℝ} (hmu : 0 ≤ mu)
    (hlow : ∀ φ ∈ Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
        (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ))), mu ≤ |psiu u ε t φ|) :
    ‖kernPlate j ε m t u M ν‖
      ≤ 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
          * (1 + (2 : ℝ) ^ (j : ℤ) * mu)⁻¹ ^ 4 := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQ
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJ
  have hQpos : (0 : ℝ) < Q := by rw [hQ]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJ]; positivity
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJ, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  have hy : (0 : ℝ) ≤ J * mu := by positivity
  have hpos : (0 : ℝ) < 1 + J * mu := by linarith
  have hb : ((2 : ℝ) ^ ((j : ℤ) + 2)) ^ 2 = 16 * J ^ 2 := by
    rw [hJ, ← hJ2, show ((j : ℤ) + 2) = 2 + (j : ℤ) by ring,
      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    rw [show (2 * (j : ℤ)) = (j : ℤ) + (j : ℤ) by ring,
      zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    norm_num
    ring
  rcases le_or_gt (J * mu) 1 with hcase | hcase
  · -- the trivial bound suffices
    have htriv := norm_kernPlate_le_trivial hp hm ε t u M ν
    refine le_trans htriv ?_
    rw [hb, hJ2]
    have hinv : (1 : ℝ) / 16 ≤ (1 + J * mu)⁻¹ ^ 4 := by
      have h2 : (1 + J * mu) ≤ 2 := by linarith
      have h1 : (0 : ℝ) < (1 + J * mu) ^ 4 := by positivity
      rw [inv_pow, le_inv_comm₀ (by norm_num) h1]
      have h4 : (1 + J * mu) ^ 4 ≤ 2 ^ 4 := pow_le_pow_left₀ (by positivity) h2 4
      norm_num at h4 ⊢
      linarith
    have hfac : (0 : ℝ) ≤ 512 * Q * B0 * J ^ 2 := by positivity
    calc 2 * Q * (B0 * (16 * J ^ 2)) = 32 * (Q * B0 * J ^ 2) := by ring
      _ ≤ 512 * Q * B0 * J ^ 2 * ((1 : ℝ) / 16) := by
          nlinarith [mul_nonneg (mul_nonneg (le_of_lt hQpos) hB0) (sq_nonneg J)]
      _ ≤ 512 * Q * B0 * J ^ 2 * (1 + J * mu)⁻¹ ^ 4 :=
          mul_le_mul_of_nonneg_left hinv hfac
  · -- the radial bound suffices
    have hmupos : (0 : ℝ) < mu := by
      by_contra hle
      have : J * mu ≤ 0 := mul_nonpos_of_nonneg_of_nonpos (le_of_lt hJpos) (not_lt.mp hle)
      linarith
    have hrad := norm_kernPlate_le_radial hp hm ε t u M ν hmupos hlow
    refine le_trans hrad ?_
    have hneg : (2 : ℝ) ^ (-(2 * (j : ℤ))) = (J ^ 2)⁻¹ := by
      rw [← hJ2, ← zpow_neg]
    rw [hneg, hJ2]
    have hinv : (16 * (J * mu) ^ 4)⁻¹ ≤ (1 + J * mu)⁻¹ ^ 4 := by
      have h2 : (1 + J * mu) ≤ 2 * (J * mu) := by linarith
      have h1 : (0 : ℝ) < (1 + J * mu) ^ 4 := by positivity
      have h3 : (0 : ℝ) < 16 * (J * mu) ^ 4 := by positivity
      rw [inv_pow, inv_le_inv₀ h3 h1]
      have h4 : (1 + J * mu) ^ 4 ≤ (2 * (J * mu)) ^ 4 :=
        pow_le_pow_left₀ (by positivity) h2 4
      calc (1 + J * mu) ^ 4 ≤ (2 * (J * mu)) ^ 4 := h4
        _ = 16 * (J * mu) ^ 4 := by ring
    have hkey : 2 * Q * (B0 * (J ^ 2)⁻¹ / mu ^ 4)
        ≤ 512 * Q * B0 * J ^ 2 * ((16 * (J * mu) ^ 4)⁻¹) := by
      have hrhs : 512 * Q * B0 * J ^ 2 * ((16 * (J * mu) ^ 4)⁻¹)
          = 32 * Q * B0 / (J ^ 2 * mu ^ 4) := by
        field_simp
        ring
      have hlhs : 2 * Q * (B0 * (J ^ 2)⁻¹ / mu ^ 4) = 2 * Q * B0 / (J ^ 2 * mu ^ 4) := by
        field_simp
      rw [hrhs, hlhs, div_le_div_iff₀ (by positivity) (by positivity)]
      have hnn : (0 : ℝ) ≤ Q * B0 * (J ^ 2 * mu ^ 4) := by positivity
      nlinarith [hnn]
    refine le_trans hkey ?_
    exact mul_le_mul_of_nonneg_left hinv (by positivity)

/-- **The sinusoid form of the phase.**  There is a phase shift `δ` with
`⟨u,θ(φ)⟩ = ‖u‖ sin(φ+δ)` and `ψ'(φ) = ‖u‖ cos(φ+δ)`. -/
theorem exists_phase_shift (u : Pl) : ∃ δ : ℝ,
    (∀ φ : ℝ, (inner ℝ u (pt 1 φ) : ℝ) = ‖u‖ * Real.sin (φ + δ))
      ∧ ∀ φ : ℝ, psi1 u φ = ‖u‖ * Real.cos (φ + δ) := by
  by_cases h0 : u = 0
  · refine ⟨0, fun φ => ?_, fun φ => ?_⟩
    · rw [h0]
      simp
    · rw [h0, psi1]
      simp
  · set z : ℂ := (u 1 : ℂ) + (u 0 : ℂ) * Complex.I with hz
    have hzre : z.re = u 1 := by
      rw [hz]
      simp
    have hzim : z.im = u 0 := by
      rw [hz]
      simp
    have hznorm : ‖z‖ = ‖u‖ := by
      rw [Complex.norm_eq_sqrt_sq_add_sq, hzre, hzim]
      rw [show ‖u‖ = Real.sqrt (‖u‖ ^ 2) by rw [Real.sqrt_sq (norm_nonneg u)]]
      rw [norm_sq_eq_coords u]
      congr 1
      ring
    have hunorm : (0 : ℝ) < ‖u‖ := by
      rw [norm_pos_iff]
      exact h0
    have hzne : z ≠ 0 := by
      intro hzz
      rw [hzz] at hznorm
      simp at hznorm
      exact absurd hznorm.symm (ne_of_gt hunorm)
    refine ⟨Complex.arg z, fun φ => ?_, fun φ => ?_⟩
    · have hs : Real.sin (Complex.arg z) = u 0 / ‖u‖ := by
        rw [Complex.sin_arg, hzim, hznorm]
      have hc : Real.cos (Complex.arg z) = u 1 / ‖u‖ := by
        rw [Complex.cos_arg hzne, hzre, hznorm]
      rw [Real.sin_add, hs, hc, pt, inner_two, mk2_apply_zero, mk2_apply_one]
      field_simp
      ring
    · have hs : Real.sin (Complex.arg z) = u 0 / ‖u‖ := by
        rw [Complex.sin_arg, hzim, hznorm]
      have hc : Real.cos (Complex.arg z) = u 1 / ‖u‖ := by
        rw [Complex.cos_arg hzne, hzre, hznorm]
      rw [Real.cos_add, hs, hc, psi1]
      field_simp
      ring

/-! ### The lower bound for the angular derivative -/

/-- Jordan's inequality in the form `|s|/2 ≤ |sin s|` on `|s| ≤ π/2`. -/
theorem abs_sin_ge_half {s : ℝ} (hs : |s| ≤ π / 2) : |s| / 2 ≤ |Real.sin s| := by
  have hpi4 : π ≤ 4 := Real.pi_le_four
  have hpipos : (0 : ℝ) < π := Real.pi_pos
  have hmain : ∀ x : ℝ, 0 ≤ x → x ≤ π / 2 → x / 2 ≤ Real.sin x := by
    intro x hx hx'
    have hj := Real.mul_le_sin hx hx'
    have hcoef : (1 : ℝ) / 2 ≤ 2 / π := by
      rw [div_le_div_iff₀ (by norm_num) hpipos]
      linarith
    have hstep : x / 2 ≤ 2 / π * x := by
      have h := mul_le_mul_of_nonneg_right hcoef hx
      calc x / 2 = 1 / 2 * x := by ring
        _ ≤ 2 / π * x := h
    linarith
  rcases le_or_gt 0 s with h | h
  · have habs : |s| = s := abs_of_nonneg h
    rw [habs] at hs ⊢
    have hsin : 0 ≤ Real.sin s :=
      Real.sin_nonneg_of_nonneg_of_le_pi h (by linarith)
    rw [abs_of_nonneg hsin]
    exact hmain s h hs
  · have habs : |s| = -s := abs_of_neg h
    have hneg : 0 ≤ -s := by linarith
    have hs' : -s ≤ π / 2 := by
      rw [habs] at hs
      exact hs
    have hsin : 0 ≤ Real.sin (-s) :=
      Real.sin_nonneg_of_nonneg_of_le_pi hneg (by linarith)
    have hmain' := hmain (-s) hneg hs'
    rw [Real.sin_neg] at hmain'
    rw [habs, abs_of_nonpos (by linarith [hsin, Real.sin_neg s] : Real.sin s ≤ 0)]
    linarith

/-- The distance from `x` to the nearest zero of the cosine. -/
noncomputable def cosDist (x : ℝ) : ℝ := |x - (π / 2 + (round ((x - π / 2) / π) : ℝ) * π)|

theorem cosDist_nonneg (x : ℝ) : 0 ≤ cosDist x := abs_nonneg _

theorem cosDist_le (x : ℝ) : cosDist x ≤ π / 2 := by
  have hpipos : (0 : ℝ) < π := Real.pi_pos
  have h := abs_sub_round ((x - π / 2) / π)
  have hx : x - (π / 2 + ((round ((x - π / 2) / π) : ℤ) : ℝ) * π)
      = π * ((x - π / 2) / π - ((round ((x - π / 2) / π) : ℤ) : ℝ)) := by
    field_simp
    ring
  rw [cosDist, hx, abs_mul, abs_of_pos hpipos]
  calc π * |(x - π / 2) / π - ((round ((x - π / 2) / π) : ℤ) : ℝ)| ≤ π * (1 / 2) :=
        mul_le_mul_of_nonneg_left h (le_of_lt hpipos)
    _ = π / 2 := by ring

/-- `|cos x|` is at least half the distance to the nearest zero of the cosine. -/
theorem abs_cos_ge (x : ℝ) : cosDist x / 2 ≤ |Real.cos x| := by
  set n : ℤ := round ((x - π / 2) / π) with hn
  set sarg : ℝ := x - (π / 2 + (n : ℝ) * π) with hsarg
  have hx : x = π / 2 + sarg + (n : ℝ) * π := by
    rw [hsarg]
    ring
  have hcos : |Real.cos x| = |Real.sin sarg| := by
    rw [hx, Real.cos_add_int_mul_pi, abs_mul]
    have hpow : |((-1 : ℝ) ^ n)| = 1 := by
      rcases Int.even_or_odd n with he | ho
      · rw [he.neg_one_zpow]
        norm_num
      · rw [ho.neg_one_zpow]
        norm_num
    have hstep : Real.cos (π / 2 + sarg) = -Real.sin sarg := by
      rw [Real.cos_add, Real.cos_pi_div_two, Real.sin_pi_div_two]
      ring
    rw [hpow, one_mul, hstep, abs_neg]
  have hd : cosDist x = |sarg| := by
    rw [cosDist, ← hn, ← hsarg]
  rw [hd, hcos]
  refine abs_sin_ge_half ?_
  rw [← hd]
  exact cosDist_le x

/-- **The lower bound for the angular derivative of the phase.** -/
theorem abs_psi1_ge (u : Pl) {δ : ℝ} (hδ : ∀ φ : ℝ, psi1 u φ = ‖u‖ * Real.cos (φ + δ)) (φ : ℝ) :
    ‖u‖ * cosDist (φ + δ) / 2 ≤ |psi1 u φ| := by
  rw [hδ φ, abs_mul, abs_of_nonneg (norm_nonneg u)]
  have h := abs_cos_ge (φ + δ)
  have hnn : (0 : ℝ) ≤ ‖u‖ := norm_nonneg u
  calc ‖u‖ * cosDist (φ + δ) / 2 = ‖u‖ * (cosDist (φ + δ) / 2) := by ring
    _ ≤ ‖u‖ * |Real.cos (φ + δ)| := mul_le_mul_of_nonneg_left h hnn

/-- The round-based distance is minimal among all the zeros of the cosine. -/
theorem cosDist_le_of_int (x : ℝ) (k : ℤ) : cosDist x ≤ |x - (π / 2 + (k : ℝ) * π)| := by
  have hpi : (0 : ℝ) < π := Real.pi_pos
  set n : ℤ := round ((x - π / 2) / π) with hn
  by_cases h : k = n
  · rw [cosDist, ← hn, h]
  · have hkn : (1 : ℝ) ≤ |(k : ℝ) - (n : ℝ)| := by
      have hz : ((k - n : ℤ) : ℝ) = (k : ℝ) - (n : ℝ) := by push_cast; ring
      have hne : k - n ≠ 0 := by
        intro h0
        exact h (by omega)
      have h1 : (1 : ℤ) ≤ |k - n| := by
        rcases lt_or_gt_of_ne hne with hlt | hgt
        · rw [abs_of_neg hlt]
          omega
        · rw [abs_of_pos hgt]
          omega
      have h2 : ((1 : ℤ) : ℝ) ≤ ((|k - n| : ℤ) : ℝ) := by exact_mod_cast h1
      rw [Int.cast_abs, hz] at h2
      simpa using h2
    have hround := abs_sub_round ((x - π / 2) / π)
    rw [← hn] at hround
    have hxk : |x - (π / 2 + (k : ℝ) * π)| = π * |(x - π / 2) / π - (k : ℝ)| := by
      rw [show x - (π / 2 + (k : ℝ) * π) = π * ((x - π / 2) / π - (k : ℝ)) by
        field_simp; ring, abs_mul, abs_of_pos hpi]
    have hlow : (1 : ℝ) / 2 ≤ |(x - π / 2) / π - (k : ℝ)| := by
      have htri : |(k : ℝ) - (n : ℝ)|
          ≤ |(x - π / 2) / π - (n : ℝ)| + |(x - π / 2) / π - (k : ℝ)| := by
        calc |(k : ℝ) - (n : ℝ)|
            = |((x - π / 2) / π - (n : ℝ)) - ((x - π / 2) / π - (k : ℝ))| := by
              congr 1
              ring
          _ ≤ |(x - π / 2) / π - (n : ℝ)| + |(x - π / 2) / π - (k : ℝ)| := abs_sub _ _
      linarith
    have h2 : π / 2 ≤ |x - (π / 2 + (k : ℝ) * π)| := by
      rw [hxk]
      calc π / 2 = π * (1 / 2) := by ring
        _ ≤ π * |(x - π / 2) / π - (k : ℝ)| := mul_le_mul_of_nonneg_left hlow (le_of_lt hpi)
    exact le_trans (cosDist_le x) h2

/-- The distance to the nearest zero of the cosine is Lipschitz. -/
theorem cosDist_sub_le (x y : ℝ) : cosDist x - |x - y| ≤ cosDist y := by
  set n : ℤ := round ((y - π / 2) / π) with hn
  have h1 : cosDist x ≤ |x - (π / 2 + (n : ℝ) * π)| := cosDist_le_of_int x n
  have h2 : |x - (π / 2 + (n : ℝ) * π)| ≤ |x - y| + |y - (π / 2 + (n : ℝ) * π)| := by
    calc |x - (π / 2 + (n : ℝ) * π)| = |(x - y) + (y - (π / 2 + (n : ℝ) * π))| := by
          congr 1
          ring
      _ ≤ |x - y| + |y - (π / 2 + (n : ℝ) * π)| := abs_add_le _ _
  have h3 : |y - (π / 2 + (n : ℝ) * π)| = cosDist y := by
    rw [cosDist, ← hn]
  linarith

/-! ### The harmonic sum and the clustering of the resonant plates -/

/-- The dyadic bound for the harmonic sum. -/
theorem harmonic_dyadic (L : ℕ) :
    ∑ k ∈ Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L), (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  induction L with
  | zero => norm_num
  | succ L ih =>
    have hsplit : Finset.Icc (1 : ℕ) ((2 : ℕ) ^ (L + 1))
        = Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L)
          ∪ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)) := by
      ext k
      simp only [Finset.mem_Icc, Finset.mem_union]
      constructor
      · intro h
        rcases le_or_gt k ((2 : ℕ) ^ L) with hk | hk
        · exact Or.inl ⟨h.1, hk⟩
        · exact Or.inr ⟨hk, h.2⟩
      · intro h
        rcases h with h | h
        · refine ⟨h.1, le_trans h.2 ?_⟩
          exact Nat.pow_le_pow_right (by norm_num) (by omega)
        · refine ⟨?_, h.2⟩
          have h1 : 1 ≤ (2 : ℕ) ^ L := Nat.one_le_two_pow
          omega
    have hdisj : Disjoint (Finset.Icc (1 : ℕ) ((2 : ℕ) ^ L))
        (Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1))) := by
      refine Finset.disjoint_left.mpr ?_
      intro k hk hk'
      rw [Finset.mem_Icc] at hk hk'
      omega
    rw [hsplit, Finset.sum_union hdisj]
    have hcard : (Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1))).card = (2 : ℕ) ^ L := by
      rw [Nat.card_Icc]
      have h2 : (2 : ℕ) ^ (L + 1) = 2 * (2 : ℕ) ^ L := by ring
      omega
    have hbd : ∀ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
        (1 : ℝ) / (k : ℝ) ≤ (1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ) := by
      intro k hk
      rw [Finset.mem_Icc] at hk
      have hk1 : (0 : ℝ) < (((2 : ℕ) ^ L : ℕ) : ℝ) := by positivity
      have hk2 : (((2 : ℕ) ^ L : ℕ) : ℝ) ≤ (k : ℝ) := by
        have hnat : (2 : ℕ) ^ L ≤ k := by omega
        exact_mod_cast hnat
      exact one_div_le_one_div_of_le hk1 hk2
    have htail : ∑ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
        (1 : ℝ) / (k : ℝ) ≤ 1 := by
      calc ∑ k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)), (1 : ℝ) / (k : ℝ)
          ≤ ∑ _k ∈ Finset.Icc ((2 : ℕ) ^ L + 1) ((2 : ℕ) ^ (L + 1)),
              (1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ) := Finset.sum_le_sum hbd
        _ = (((2 : ℕ) ^ L : ℕ) : ℝ) * ((1 : ℝ) / (((2 : ℕ) ^ L : ℕ) : ℝ)) := by
            rw [Finset.sum_const, hcard, nsmul_eq_mul]
        _ = 1 := by
            have hne : (((2 : ℕ) ^ L : ℕ) : ℝ) ≠ 0 := by positivity
            field_simp
    push_cast
    linarith

/-- The harmonic sum up to any `n ≤ 2^L`. -/
theorem harmonic_le (n L : ℕ) (h : n ≤ (2 : ℕ) ^ L) :
    ∑ k ∈ Finset.Icc (1 : ℕ) n, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  refine le_trans (Finset.sum_le_sum_of_subset_of_nonneg ?_ ?_) (harmonic_dyadic L)
  · intro k hk
    rw [Finset.mem_Icc] at hk ⊢
    exact ⟨hk.1, le_trans hk.2 h⟩
  · intro k _ _
    positivity

/-- **Clustering.**  Two points at distance at most `1` that are both within `1` of a zero of the
cosine are within the sum of their distances to the zeros: their nearest zeros coincide, because
the zeros are `π`-separated. -/
theorem abs_sub_le_cosDist_add {x y : ℝ} (hxy : |x - y| ≤ 1) (hx : cosDist x ≤ 1)
    (hy : cosDist y ≤ 1) : |x - y| ≤ cosDist x + cosDist y := by
  have hpi : (3 : ℝ) < π := by
    have h := Real.pi_gt_three
    linarith
  set nx : ℤ := round ((x - π / 2) / π) with hnx
  set ny : ℤ := round ((y - π / 2) / π) with hny
  set zx : ℝ := π / 2 + (nx : ℝ) * π with hzx
  set zy : ℝ := π / 2 + (ny : ℝ) * π with hzy
  have hdx : |x - zx| = cosDist x := by rw [cosDist, ← hnx, ← hzx]
  have hdy : |y - zy| = cosDist y := by rw [cosDist, ← hny, ← hzy]
  have hclose : |zx - zy| ≤ 3 := by
    have h1 : |zx - zy| ≤ |zx - x| + |x - y| + |y - zy| := by
      calc |zx - zy| = |(zx - x) + (x - y) + (y - zy)| := by
            congr 1
            ring
        _ ≤ |(zx - x) + (x - y)| + |y - zy| := abs_add_le _ _
        _ ≤ |zx - x| + |x - y| + |y - zy| := by
            have := abs_add_le (zx - x) (x - y)
            linarith
    have h2 : |zx - x| = cosDist x := by
      rw [← hdx, abs_sub_comm]
    linarith [hdy ▸ le_refl |y - zy|, h1, h2 ▸ le_refl |zx - x|]
  have hsame : nx = ny := by
    by_contra hne
    have h1 : (1 : ℤ) ≤ |nx - ny| := by
      have hne' : nx - ny ≠ 0 := by omega
      rcases lt_or_gt_of_ne hne' with hlt | hgt
      · rw [abs_of_neg hlt]
        omega
      · rw [abs_of_pos hgt]
        omega
    have h2 : |zx - zy| = |(nx : ℝ) - (ny : ℝ)| * π := by
      rw [hzx, hzy, show π / 2 + (nx : ℝ) * π - (π / 2 + (ny : ℝ) * π)
        = ((nx : ℝ) - (ny : ℝ)) * π by ring, abs_mul, abs_of_pos Real.pi_pos]
    have h3 : (1 : ℝ) ≤ |(nx : ℝ) - (ny : ℝ)| := by
      have hz : ((nx - ny : ℤ) : ℝ) = (nx : ℝ) - (ny : ℝ) := by push_cast; ring
      have h4 : ((1 : ℤ) : ℝ) ≤ ((|nx - ny| : ℤ) : ℝ) := by exact_mod_cast h1
      rw [Int.cast_abs, hz] at h4
      simpa using h4
    have h5 : π ≤ |zx - zy| := by
      rw [h2]
      calc π = 1 * π := by ring
        _ ≤ |(nx : ℝ) - (ny : ℝ)| * π :=
            mul_le_mul_of_nonneg_right h3 (le_of_lt Real.pi_pos)
    linarith
  rw [hsame] at hzx
  have hzz : zx = zy := by rw [hzx, hzy]
  calc |x - y| = |(x - zx) + (zx - y)| := by
        congr 1
        ring
    _ ≤ |x - zx| + |zx - y| := abs_add_le _ _
    _ = cosDist x + cosDist y := by
        rw [hdx, hzz, abs_sub_comm, hdy]

/-! ### The phase in coordinates -/

/-- The second angular derivative of the phase coefficient is `εt - ψ`. -/
theorem psi2_eq (u : Pl) (ε t φ : ℝ) : psi2 u φ = ε * t - psiu u ε t φ := by
  rw [psi2, psiu_eq]
  ring

/-- The third angular derivative is minus the first. -/
theorem psi3_eq_neg (u : Pl) (φ : ℝ) : psi3 u φ = -psi1 u φ := by
  rw [psi3, psi1]
  ring

/-- The phase coefficient is affine in the second coordinate. -/
theorem psiu_mk2 (w v ε t φ : ℝ) :
    psiu (mk2 w v) ε t φ = v * Real.sin φ + (w * Real.cos φ + ε * t) := by
  rw [psiu_eq, mk2_apply_zero, mk2_apply_one]
  ring

/-- Its angular derivative is affine in the second coordinate. -/
theorem psi1_mk2 (w v φ : ℝ) :
    psi1 (mk2 w v) φ = v * Real.cos φ - w * Real.sin φ := by
  rw [psi1, mk2_apply_zero, mk2_apply_one]
  ring

/-! #### Angles near `π/2` -/

/-- Near `π/2` the sine is bounded below. -/
theorem sin_ge_of_near {φ : ℝ} (h : |π / 2 - φ| ≤ 3 / 5) : (4 : ℝ) / 5 ≤ Real.sin φ := by
  have hcos : Real.sin φ = Real.cos (π / 2 - φ) := by
    rw [Real.cos_pi_div_two_sub]
  have hlow : (1 : ℝ) - (π / 2 - φ) ^ 2 / 2 ≤ Real.cos (π / 2 - φ) :=
    Real.one_sub_sq_div_two_le_cos
  have hsq : (π / 2 - φ) ^ 2 ≤ (3 / 5) ^ 2 := by
    have h0 : (0 : ℝ) ≤ |π / 2 - φ| := abs_nonneg _
    nlinarith [sq_abs (π / 2 - φ)]
  rw [hcos]
  nlinarith [hlow, hsq]

/-- Near `π/2` the cosine is small. -/
theorem abs_cos_le_of_near {φ : ℝ} (h : |π / 2 - φ| ≤ 3 / 5) : |Real.cos φ| ≤ 3 / 5 := by
  have hsin : Real.cos φ = Real.sin (π / 2 - φ) := by
    rw [Real.sin_pi_div_two_sub]
  rw [hsin]
  refine le_trans ?_ h
  rcases le_or_gt 0 (π / 2 - φ) with hpos | hneg
  · rw [abs_of_nonneg hpos]
    have h1 : Real.sin (π / 2 - φ) ≤ π / 2 - φ := Real.sin_le hpos
    have h2 : -(π / 2 - φ) ≤ Real.sin (π / 2 - φ) := by
      rcases le_or_gt (π / 2 - φ) π with hle | hgt
      · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hpos hle
        linarith
      · have hm1 := Real.neg_one_le_sin (π / 2 - φ)
        have h1 : (1 : ℝ) ≤ π / 2 - φ := by linarith [Real.pi_gt_three]
        linarith
    rw [abs_le]
    exact ⟨h2, h1⟩
  · have hneg' : π / 2 - φ < 0 := hneg
    rw [abs_of_neg hneg']
    have hpos' : 0 ≤ -(π / 2 - φ) := by linarith
    have h1 : Real.sin (-(π / 2 - φ)) ≤ -(π / 2 - φ) := Real.sin_le hpos'
    have h2 : -(-(π / 2 - φ)) ≤ Real.sin (-(π / 2 - φ)) := by
      rcases le_or_gt (-(π / 2 - φ)) π with hle | hgt
      · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hpos' hle
        linarith
      · have hm1 := Real.neg_one_le_sin (-(π / 2 - φ))
        have h1 : (1 : ℝ) ≤ -(π / 2 - φ) := by linarith [Real.pi_gt_three]
        linarith
    rw [Real.sin_neg] at h1 h2
    rw [abs_le]
    constructor <;> linarith

/-! ### Exact identities for the phase -/

theorem abs_sin_le_abs_of_nonneg {x : ℝ} (hx : 0 ≤ x) : |Real.sin x| ≤ |x| := by
  rw [abs_of_nonneg hx]
  have hup : Real.sin x ≤ x := Real.sin_le hx
  have hlow : -x ≤ Real.sin x := by
    rcases le_or_gt x π with hle | hgt
    · have hnn := Real.sin_nonneg_of_nonneg_of_le_pi hx hle
      linarith
    · have hm1 := Real.neg_one_le_sin x
      have h1 : (1 : ℝ) ≤ x := by linarith [Real.pi_gt_three]
      linarith
  rw [abs_le]
  exact ⟨hlow, hup⟩

theorem abs_sin_le_abs (x : ℝ) : |Real.sin x| ≤ |x| := by
  rcases le_or_gt 0 x with hx | hx
  · exact abs_sin_le_abs_of_nonneg hx
  · have h := abs_sin_le_abs_of_nonneg (x := -x) (by linarith)
    rw [Real.sin_neg, abs_neg, abs_neg] at h
    exact h

theorem abs_sin_sub_sin_le (a b : ℝ) : |Real.sin a - Real.sin b| ≤ |a - b| := by
  rw [Real.sin_sub_sin, abs_mul, abs_mul]
  have h1 : |Real.sin ((a - b) / 2)| ≤ |(a - b) / 2| := abs_sin_le_abs _
  have h2 : |Real.cos ((a + b) / 2)| ≤ 1 := Real.abs_cos_le_one _
  have h2n : (2 : ℝ) = |(2 : ℝ)| := by norm_num
  have habs : |(a - b) / 2| = |a - b| / 2 := by
    rw [abs_div]
    norm_num
  calc |(2 : ℝ)| * |Real.sin ((a - b) / 2)| * |Real.cos ((a + b) / 2)|
      ≤ |(2 : ℝ)| * (|a - b| / 2) * 1 := by
        refine mul_le_mul (mul_le_mul_of_nonneg_left (habs ▸ h1) (abs_nonneg _)) h2
          (abs_nonneg _) (by positivity)
    _ = |a - b| := by
        rw [show |(2 : ℝ)| = 2 by norm_num]
        ring

theorem abs_cos_sub_cos_le (a b : ℝ) : |Real.cos a - Real.cos b| ≤ |a - b| := by
  rw [Real.cos_sub_cos, abs_mul, abs_mul, abs_neg]
  have h1 : |Real.sin ((a - b) / 2)| ≤ |(a - b) / 2| := abs_sin_le_abs _
  have h2 : |Real.sin ((a + b) / 2)| ≤ 1 := Real.abs_sin_le_one _
  have habs : |(a - b) / 2| = |a - b| / 2 := by
    rw [abs_div]
    norm_num
  calc |(2 : ℝ)| * |Real.sin ((a + b) / 2)| * |Real.sin ((a - b) / 2)|
      ≤ |(2 : ℝ)| * 1 * (|a - b| / 2) := by
        refine mul_le_mul (mul_le_mul_of_nonneg_left h2 (abs_nonneg _)) (habs ▸ h1)
          (abs_nonneg _) (by positivity)
    _ = |a - b| := by
        rw [show |(2 : ℝ)| = 2 by norm_num]
        ring

/-- The Pythagorean identity for the phase: `ψ'² + (ψ - εt)² = ‖u‖²`. -/
theorem sq_psi1_add_sq (u : Pl) (ε t φ : ℝ) :
    (psi1 u φ) ^ 2 + (psiu u ε t φ - ε * t) ^ 2 = ‖u‖ ^ 2 := by
  rw [psi1, psiu_eq, norm_sq_eq_coords]
  have h := Real.sin_sq_add_cos_sq φ
  nlinarith [h]

/-- The phase and its angular derivative are `‖u‖`-Lipschitz in the angle. -/
theorem abs_psiu_sub_le (u : Pl) (ε t φ φ' : ℝ) :
    |psiu u ε t φ - psiu u ε t φ'| ≤ ‖u‖ * |φ - φ'| := by
  obtain ⟨δ, hs, hc⟩ := exists_phase_shift u
  have h1 : psiu u ε t φ - psiu u ε t φ'
      = ‖u‖ * (Real.sin (φ + δ) - Real.sin (φ' + δ)) := by
    rw [psiu, psiu, hs φ, hs φ']
    ring
  rw [h1, abs_mul, abs_of_nonneg (norm_nonneg u)]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg u)
  have h2 := abs_sin_sub_sin_le (φ + δ) (φ' + δ)
  have h3 : (φ + δ) - (φ' + δ) = φ - φ' := by ring
  rw [h3] at h2
  exact h2

theorem abs_psi1_sub_le (u : Pl) (φ φ' : ℝ) :
    |psi1 u φ - psi1 u φ'| ≤ ‖u‖ * |φ - φ'| := by
  obtain ⟨δ, hs, hc⟩ := exists_phase_shift u
  have h1 : psi1 u φ - psi1 u φ' = ‖u‖ * (Real.cos (φ + δ) - Real.cos (φ' + δ)) := by
    rw [hc φ, hc φ']
    ring
  rw [h1, abs_mul, abs_of_nonneg (norm_nonneg u)]
  refine mul_le_mul_of_nonneg_left ?_ (norm_nonneg u)
  have h2 := abs_cos_sub_cos_le (φ + δ) (φ' + δ)
  have h3 : (φ + δ) - (φ' + δ) = φ - φ' := by ring
  rw [h3] at h2
  exact h2

/-- `‖u‖` is controlled by the phase and its derivative at any single angle. -/
theorem norm_le_psi (u : Pl) (ε t φ : ℝ) :
    ‖u‖ ≤ |psi1 u φ| + |psiu u ε t φ - ε * t| := by
  have h := sq_psi1_add_sq u ε t φ
  have h1 : (0 : ℝ) ≤ |psi1 u φ| := abs_nonneg _
  have h2 : (0 : ℝ) ≤ |psiu u ε t φ - ε * t| := abs_nonneg _
  have hsq : ‖u‖ ^ 2 ≤ (|psi1 u φ| + |psiu u ε t φ - ε * t|) ^ 2 := by
    rw [← h]
    nlinarith [sq_abs (psi1 u φ), sq_abs (psiu u ε t φ - ε * t), h1, h2]
  nlinarith [hsq, norm_nonneg u, h1, h2]

/-- **The reference identity.**  At the plate's reference angle, the angular derivative is
determined by `w + εt cos φ` and the value of the phase. -/
theorem psi1_ref_identity (w v ε t φ : ℝ) :
    psi1 (mk2 w v) φ * Real.sin φ
      = Real.cos φ * psiu (mk2 w v) ε t φ - (w + ε * t * Real.cos φ) := by
  rw [psi1_mk2, psiu_mk2]
  have h := Real.sin_sq_add_cos_sq φ
  linear_combination (-w) * h

/-! ### Mean value bounds on a plate -/

/-- The phase varies over an interval by at most the length times a bound for its derivative. -/
theorem abs_psiu_sub_le_of_bound (u : Pl) (ε t : ℝ) {a b K : ℝ}
    (hK : ∀ φ ∈ Set.Icc a b, |psi1 u φ| ≤ K) {φ φ' : ℝ}
    (hφ : φ ∈ Set.Icc a b) (hφ' : φ' ∈ Set.Icc a b) :
    |psiu u ε t φ - psiu u ε t φ'| ≤ K * |φ - φ'| := by
  have hconv : Convex ℝ (Set.Icc a b) := convex_Icc a b
  have hderiv : ∀ x ∈ Set.Icc a b,
      HasDerivWithinAt (psiu u ε t) (psi1 u x) (Set.Icc a b) x := by
    intro x _
    exact (hasDerivAt_psiu u ε t x).hasDerivWithinAt
  have hbound : ∀ x ∈ Set.Icc a b, ‖psi1 u x‖ ≤ K := by
    intro x hx
    rw [Real.norm_eq_abs]
    exact hK x hx
  have h := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le hderiv hbound hφ' hφ
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at h
  calc |psiu u ε t φ - psiu u ε t φ'| = |psiu u ε t φ - psiu u ε t φ'| := rfl
    _ ≤ K * |φ - φ'| := h

/-- The same for the angular derivative. -/
theorem abs_psi1_sub_le_of_bound (u : Pl) (_ε _t : ℝ) {a b K : ℝ}
    (hK : ∀ φ ∈ Set.Icc a b, |psi2 u φ| ≤ K) {φ φ' : ℝ}
    (hφ : φ ∈ Set.Icc a b) (hφ' : φ' ∈ Set.Icc a b) :
    |psi1 u φ - psi1 u φ'| ≤ K * |φ - φ'| := by
  have hconv : Convex ℝ (Set.Icc a b) := convex_Icc a b
  have hderiv : ∀ x ∈ Set.Icc a b,
      HasDerivWithinAt (psi1 u) (psi2 u x) (Set.Icc a b) x := by
    intro x _
    exact (hasDerivAt_psi1 u x).hasDerivWithinAt
  have hbound : ∀ x ∈ Set.Icc a b, ‖psi2 u x‖ ≤ K := by
    intro x hx
    rw [Real.norm_eq_abs]
    exact hK x hx
  have h := hconv.norm_image_sub_le_of_norm_hasDerivWithin_le hderiv hbound hφ' hφ
  rw [Real.norm_eq_abs, Real.norm_eq_abs] at h
  exact h

/-! ### The plate bounds for a far plate -/

/-- The reference angle of the plate `ν`. -/
def plAng (M : ℕ) (ν : ℤ) : ℝ := (ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ))

/-- The `v`-independent size parameter of the plate `ν`: it measures how far the plate is from the
angular resonance. -/
def plA (M : ℕ) (ν : ℤ) (ε t w : ℝ) : ℝ := w + ε * t * Real.cos (plAng M ν)

theorem plAng_add (M : ℕ) (ν : ℤ) :
    plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ)) = ((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)) := by
  rw [plAng]
  ring

/-- **The plate bounds.**  On a far plate, in the `v`-region where the phase is small compared with
the plate parameter `A`, all the quantities entering the two routes are comparable to `|A|`. -/
theorem plate_bounds_far {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |plA M ν ε t w| / 3 ≤ |psi1 (mk2 w v) φ|)
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psi2 (mk2 w v) φ| ≤ 3 + 24 * (|plA M ν ε t w| / 3))
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psi1 (mk2 w v) φ| ≤ 8 * (|plA M ν ε t w| / 3))
      ∧ (∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
        |psiu (mk2 w v) ε t (plAng M ν)| - 6 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|
          ≤ |psiu (mk2 w v) ε t φ|) := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφν
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hQA : Q ≤ |A| / 100 := by linarith [hA]
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsin1 : Real.sin φν ≤ 1 := Real.sin_le_one φν
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  -- the reference identity
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * psiu u ε t φν - A := by
    rw [hu, hAdef, plA, ← hφν]
    exact psi1_ref_identity w v ε t φν
  have habsq : |Real.cos φν * psiu u ε t φν| ≤ 3 / 5 * (|A| / 2) := by
    rw [abs_mul]
    exact mul_le_mul hcos hreg (abs_nonneg _) (by norm_num)
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * psiu u ε t φν - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_low : |A| / 2 ≤ |psi1 u φν| := by
    have h6 : |A| - |Real.cos φν * psiu u ε t φν|
        ≤ |Real.cos φν * psiu u ε t φν - A| := by
      have h7 := abs_sub_abs_le_abs_sub A (Real.cos φν * psiu u ε t φν)
      rw [abs_sub_comm A (Real.cos φν * psiu u ε t φν)] at h7
      linarith
    have h9 : |A| - 3 / 5 * (|A| / 2) ≤ |psi1 u φν| * Real.sin φν := by
      rw [hpsin]
      linarith
    have h10 : |psi1 u φν| * Real.sin φν ≤ |psi1 u φν| := by
      calc |psi1 u φν| * Real.sin φν ≤ |psi1 u φν| * 1 :=
            mul_le_mul_of_nonneg_left hsin1 (abs_nonneg _)
        _ = |psi1 u φν| := mul_one _
    linarith
  have hpp_up : |psi1 u φν| ≤ 2 * |A| := by
    have h1 : |Real.cos φν * psiu u ε t φν - A| ≤ 3 / 5 * (|A| / 2) + |A| := by
      have h3 := abs_sub (Real.cos φν * psiu u ε t φν) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    linarith
  -- the size of `u`
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 3 * |A| + 2 := by
    have h := norm_le_psi u ε t φν
    have h2 : |psiu u ε t φν - ε * t| ≤ |A| / 2 + 2 := by
      have h3 := abs_sub (psiu u ε t φν) (ε * t)
      linarith
    linarith [hpp_up]
  -- the Lipschitz bounds on the plate
  have hlip : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |φ - φν| ≤ 2 * Q := by
    intro φ hφ
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have hslack : ∀ φ ∈ Set.Icc φν (φν + 2 * Q),
      |psiu u ε t φ - psiu u ε t φν| ≤ 6 * Q * |A| + 4 * Q := by
    intro φ hφ
    have h := abs_psiu_sub_le u ε t φ φν
    calc |psiu u ε t φ - psiu u ε t φν| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (3 * |A| + 2) * (2 * Q) :=
          mul_le_mul hnorm (hlip φ hφ) (abs_nonneg _) (by positivity)
      _ = 6 * Q * |A| + 4 * Q := by ring
  have hslack1 : ∀ φ ∈ Set.Icc φν (φν + 2 * Q),
      |psi1 u φ - psi1 u φν| ≤ 6 * Q * |A| + 4 * Q := by
    intro φ hφ
    have h := abs_psi1_sub_le u φ φν
    calc |psi1 u φ - psi1 u φν| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (3 * |A| + 2) * (2 * Q) :=
          mul_le_mul hnorm (hlip φ hφ) (abs_nonneg _) (by positivity)
      _ = 6 * Q * |A| + 4 * Q := by ring
  have hsmall : 6 * Q * |A| + 4 * Q ≤ |A| / 10 := by
    have h1 : 6 * Q * |A| ≤ 6 / 100 * |A| := by
      have := mul_le_mul_of_nonneg_right hQ (le_of_lt hApos)
      linarith
    have h2 : 4 * Q ≤ 4 / 100 * |A| := by linarith [hQA]
    linarith
  refine ⟨?_, ?_, ?_, ?_⟩
  · -- the lower bound for the angular derivative
    intro φ hφ
    have h1 := hslack1 φ hφ
    have h2 : |psi1 u φν| - |psi1 u φ - psi1 u φν| ≤ |psi1 u φ| := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φν) (psi1 u φ)
      rw [abs_sub_comm (psi1 u φν) (psi1 u φ)] at h3
      linarith
    have hgoal : |A| / 3 ≤ |psi1 u φν| - (6 * Q * |A| + 4 * Q) := by
      linarith [hpp_low, hsmall]
    linarith
  · -- the bound for the second derivative
    intro φ hφ
    have h1 := hslack φ hφ
    have h2 : |psiu u ε t φ| ≤ |psiu u ε t φν| + (6 * Q * |A| + 4 * Q) := by
      have h3 := abs_sub_abs_le_abs_sub (psiu u ε t φ) (psiu u ε t φν)
      linarith
    have h4 : |psi2 u φ| ≤ |ε * t| + |psiu u ε t φ| := by
      rw [psi2_eq u ε t φ]
      exact abs_sub _ _
    have h5 : |psiu u ε t φ| ≤ |A| / 2 + |A| / 10 := by linarith [hreg, hsmall]
    linarith [hApos]
  · -- the upper bound for the angular derivative
    intro φ hφ
    have h1 := hslack1 φ hφ
    have h2 : |psi1 u φ| ≤ |psi1 u φν| + (6 * Q * |A| + 4 * Q) := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
      linarith
    linarith [hpp_up, hsmall]
  · -- the sharper lower bound for the phase, from the mean value theorem on the plate
    have hK : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |psi1 u φ| ≤ 8 * (|A| / 3) := by
      intro φ hφ
      have h1 := hslack1 φ hφ
      have h2 : |psi1 u φ| ≤ |psi1 u φν| + (6 * Q * |A| + 4 * Q) := by
        have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
        linarith
      linarith [hpp_up, hsmall]
    intro φ hφ
    have hmvt := abs_psiu_sub_le_of_bound u ε t hK hφ
      (Set.left_mem_Icc.mpr (by linarith [hQpos]))
    have hlipφ := hlip φ hφ
    have h1 : |psiu u ε t φ - psiu u ε t φν| ≤ 6 * Q * |A| := by
      calc |psiu u ε t φ - psiu u ε t φν| ≤ 8 * (|A| / 3) * |φ - φν| := hmvt
        _ ≤ 8 * (|A| / 3) * (2 * Q) := by
            refine mul_le_mul_of_nonneg_left hlipφ (by positivity)
        _ ≤ 6 * Q * |A| := by
            nlinarith [hQpos, hApos]
    have h2 : |psiu u ε t φν| - |psiu u ε t φ - psiu u ε t φν| ≤ |psiu u ε t φ| := by
      have h3 := abs_sub_abs_le_abs_sub (psiu u ε t φν) (psiu u ε t φ)
      rw [abs_sub_comm (psiu u ε t φν) (psiu u ε t φ)] at h3
      linarith
    linarith

/-! ### The combined bound on a far plate -/

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The combined bound for a far plate.**  In the `v`-region where the phase is at most half the
plate parameter, the geometric mean of the capped radial bound and the angular bound gives a bound
that decays like `(1+2^j μ)^{-2}` in the phase and like `|A|^{-1}` in the plate. -/
theorem norm_kernPlate_far_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 4000 * stC * B0 * (2 : ℝ) ^ (j : ℤ)
          * (1 + (2 : ℝ) ^ (j : ℤ) * max 0 (|psiu (mk2 w v) ε t (plAng M ν)|
              - 6 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|))⁻¹ ^ 2
          / |plA M ν ε t w| := by
  obtain ⟨hb1, hb2, hb3, hb4⟩ := plate_bounds_far hε ht1 ht2 hQ hang hA hreg
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t (plAng M ν) with hq
  set slack : ℝ := 6 * Q * |A| with hslackdef
  set mu : ℝ := max 0 (|q| - slack) with hmudef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hmunn : (0 : ℝ) ≤ mu := le_max_left _ _
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hplate : Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q)
      = Set.Icc (plAng M ν) (plAng M ν + 2 * Q) := by
    rw [plAng_add M ν, plAng]
  -- the angular route
  have hang_bd : ‖kernPlate j ε m t u M ν‖ ≤ 3200 * stC * B0 * P / (|A| / 3) ^ 2 := by
    refine norm_kernPlate_le_angular hp hm ε t u hM hν hνB (by positivity) ?_ ?_ ?_ ?_
    · -- `Q ≤ |A|/3`
      linarith [hA]
    · rw [hplate]
      exact hb1
    · rw [hplate]
      exact hb2
    · rw [hplate]
      intro φ hφ
      have h := hb3 φ hφ
      rw [psi3_eq_neg u φ, abs_neg]
      exact h
  -- the capped radial route
  have hrad_bd : ‖kernPlate j ε m t u M ν‖ ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
      * (1 + J * mu)⁻¹ ^ 4 := by
    refine norm_kernPlate_le_capped hp hm ε t u M ν hmunn ?_
    rw [hplate]
    intro φ hφ
    rcases le_or_gt (|q| - slack) 0 with hle | hgt
    · have : mu = 0 := by
        rw [hmudef, max_eq_left hle]
      rw [this]
      exact abs_nonneg _
    · have : mu = |q| - slack := by
        rw [hmudef, max_eq_right (le_of_lt hgt)]
      rw [this]
      exact hb4 φ hφ
  -- combine
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  rw [hJ2] at hrad_bd
  refine le_of_sq_le_mul (norm_nonneg _) (by positivity) hrad_bd hang_bd ?_
  -- the numerical inequality
  have hinvpos : (0 : ℝ) < 1 + J * mu := by positivity
  have hsq : ((1 + J * mu)⁻¹ ^ 4) = ((1 + J * mu)⁻¹ ^ 2) ^ 2 := by ring
  have hstC2 : stC ≤ stC ^ 2 := by nlinarith [hstC]
  have hlhs : 512 * Q * B0 * J ^ 2 * (1 + J * mu)⁻¹ ^ 4 * (3200 * stC * B0 * P / (|A| / 3) ^ 2)
      = 14745600 * (P * Q) * stC * B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 / |A| ^ 2 := by
    rw [hsq]
    field_simp
    ring
  have hrhs : (4000 * stC * B0 * J * (1 + J * mu)⁻¹ ^ 2 / |A|) ^ 2
      = 16000000 * stC ^ 2 * B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 / |A| ^ 2 := by
    field_simp
    ring
  rw [hlhs, hrhs, hPQ]
  refine div_le_div_of_nonneg_right ?_ (by positivity)
  have hfac : (0 : ℝ) ≤ B0 ^ 2 * J ^ 2 * ((1 + J * mu)⁻¹ ^ 2) ^ 2 := by positivity
  nlinarith [hstC2, hfac, mul_le_mul_of_nonneg_right hstC2 hfac]

/-! ### The one-dimensional integral of the capped bound -/

/-- The integral of the capped quadratic bump: the flat part contributes the length of the
`slack`-neighbourhood, the decaying part contributes `O(1/A)`. -/
theorem integral_capped_le {A a b slack : ℝ} (hA : 0 < A) (ha : 4 / 5 ≤ a)
    (hslack : 0 ≤ slack) :
    Integrable (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2)
      ∧ (∫ v : ℝ, (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) ≤ 5 * slack + 5 * π / A := by
  have hapos : (0 : ℝ) < a := by linarith
  set c : ℝ := A / 2 * a with hc
  have hcpos : (0 : ℝ) < c := by rw [hc]; positivity
  set S : Set ℝ := Set.Icc ((-(2 * slack) - b) / a) ((2 * slack - b) / a) with hS
  set g1 : ℝ → ℝ := S.indicator (fun _ => (1 : ℝ)) with hg1
  set g2 : ℝ → ℝ := fun v => 2 * (1 + (c * v + A / 2 * b) ^ 2)⁻¹ with hg2
  -- the majorant
  have hmaj : ∀ v : ℝ, (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 ≤ g1 v + g2 v := by
    intro v
    have hg2nn : (0 : ℝ) ≤ g2 v := by
      rw [hg2]
      positivity
    have hg1nn : (0 : ℝ) ≤ g1 v := by
      rw [hg1]
      refine Set.indicator_nonneg ?_ v
      intro x _
      norm_num
    rcases le_or_gt (|a * v + b|) (2 * slack) with hcase | hcase
    · -- the flat part
      have hmem : v ∈ S := by
        rw [hS, Set.mem_Icc]
        have h := abs_le.mp hcase
        constructor
        · rw [div_le_iff₀ hapos]
          linarith [h.1]
        · rw [le_div_iff₀ hapos]
          linarith [h.2]
      have hone : g1 v = 1 := by
        rw [hg1, Set.indicator_of_mem hmem]
      have hnn : (0 : ℝ) ≤ A * max 0 (|a * v + b| - slack) := by
        have : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
        positivity
      have hle : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 ≤ 1 := by
        have h1 : (1 : ℝ) ≤ 1 + A * max 0 (|a * v + b| - slack) := by linarith
        have h2 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ≤ 1 := by
          rw [inv_le_one_iff₀]
          right
          exact h1
        have h3 : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ := by positivity
        nlinarith [h2, h3]
      linarith
    · -- the decaying part
      have hmaxeq : max 0 (|a * v + b| - slack) = |a * v + b| - slack := by
        refine max_eq_right ?_
        linarith
      have hhalf : |a * v + b| / 2 ≤ |a * v + b| - slack := by linarith
      have h1 : 1 + A / 2 * |a * v + b| ≤ 1 + A * max 0 (|a * v + b| - slack) := by
        rw [hmaxeq]
        nlinarith [hhalf, hA]
      have h2 : (0 : ℝ) < 1 + A / 2 * |a * v + b| := by positivity
      have h3 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2
          ≤ (1 + A / 2 * |a * v + b|)⁻¹ ^ 2 := by
        have h4 : (1 + A * max 0 (|a * v + b| - slack))⁻¹ ≤ (1 + A / 2 * |a * v + b|)⁻¹ :=
          inv_anti₀ h2 h1
        have h5 : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ := by positivity
        nlinarith [h4, h5]
      have h6 : (1 + A / 2 * |a * v + b|)⁻¹ ^ 2 ≤ g2 v := by
        have hg2v : g2 v = 2 * (1 + (c * v + A / 2 * b) ^ 2)⁻¹ := rfl
        set y : ℝ := A / 2 * |a * v + b| with hy
        have hynn : (0 : ℝ) ≤ y := by
          rw [hy]
          positivity
        have hsq : (c * v + A / 2 * b) ^ 2 = y ^ 2 := by
          rw [hy, hc, mul_pow, sq_abs]
          ring
        rw [hg2v, hsq, inv_pow]
        have hp1 : (0 : ℝ) < (1 + y) ^ 2 := by positivity
        have hp2 : (0 : ℝ) < 1 + y ^ 2 := by positivity
        rw [show (2 : ℝ) * (1 + y ^ 2)⁻¹ = 2 / (1 + y ^ 2) by rw [div_eq_mul_inv]]
        rw [inv_eq_one_div, div_le_div_iff₀ hp1 hp2]
        nlinarith [hynn]
      linarith
  -- integrability
  have hg1int : Integrable g1 := by
    rw [hg1, integrable_indicator_iff measurableSet_Icc]
    exact continuous_const.integrableOn_Icc
  have hg2int : Integrable g2 := by
    have hbase : Integrable fun x : ℝ => (1 + x ^ 2)⁻¹ := integrable_inv_one_add_sq
    have hshift : Integrable fun x : ℝ => (1 + (x + A / 2 * b) ^ 2)⁻¹ :=
      hbase.comp_add_right (A / 2 * b)
    have hscale : Integrable fun v : ℝ => (1 + (c * v + A / 2 * b) ^ 2)⁻¹ := by
      have h := hshift.comp_mul_left' (ne_of_gt hcpos)
      refine h.congr ?_
      filter_upwards with v
      ring_nf
    rw [hg2]
    exact hscale.const_mul 2
  have hnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 := by
    filter_upwards with v
    change (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2
    have : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    positivity
  have hgint : Integrable (fun v : ℝ => g1 v + g2 v) := hg1int.add hg2int
  have hcont : Continuous (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) := by
    have hinner : Continuous (fun v : ℝ => 1 + A * max 0 (|a * v + b| - slack)) := by
      refine continuous_const.add (continuous_const.mul ?_)
      refine continuous_const.max ?_
      refine Continuous.sub ?_ continuous_const
      exact continuous_abs.comp ((continuous_const.mul continuous_id).add continuous_const)
    refine Continuous.pow (Continuous.inv₀ hinner ?_) 2
    intro v
    have h0 : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    have h1 : (0 : ℝ) < 1 + A * max 0 (|a * v + b| - slack) := by positivity
    exact ne_of_gt h1
  have hFint : Integrable (fun v : ℝ => (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2) := by
    refine Integrable.mono' hgint hcont.aestronglyMeasurable ?_
    filter_upwards with v
    have h0 : (0 : ℝ) ≤ max 0 (|a * v + b| - slack) := le_max_left _ _
    have hnnv : (0 : ℝ) ≤ (1 + A * max 0 (|a * v + b| - slack))⁻¹ ^ 2 := by positivity
    rw [Real.norm_eq_abs, abs_of_nonneg hnnv]
    exact hmaj v
  refine ⟨hFint, ?_⟩
  have hle := integral_mono_of_nonneg hnn hgint (Filter.Eventually.of_forall hmaj)
  refine le_trans hle ?_
  rw [integral_add hg1int hg2int]
  -- the two integrals
  have hI1 : (∫ v : ℝ, g1 v) ≤ 5 * slack := by
    have hlen : (2 * slack - b) / a - (-(2 * slack) - b) / a = 4 * slack / a := by
      field_simp
      ring
    rw [hg1, integral_indicator measurableSet_Icc, setIntegral_const, smul_eq_mul, mul_one,
      MeasureTheory.measureReal_def, Real.volume_Icc, hlen,
      ENNReal.toReal_ofReal (by positivity)]
    rw [div_le_iff₀ hapos]
    nlinarith [hslack, ha]
  have hI2 : (∫ v : ℝ, g2 v) ≤ 5 * π / A := by
    have hcomp : (∫ v : ℝ, (1 + (c * v + A / 2 * b) ^ 2)⁻¹) = c⁻¹ * π := by
      have hstep : (∫ v : ℝ, (1 + (c * v + A / 2 * b) ^ 2)⁻¹)
          = ∫ v : ℝ, (fun y : ℝ => (1 + (y + A / 2 * b) ^ 2)⁻¹) (c * v) := rfl
      rw [hstep, MeasureTheory.Measure.integral_comp_mul_left
        (fun y : ℝ => (1 + (y + A / 2 * b) ^ 2)⁻¹) c]
      rw [MeasureTheory.integral_add_right_eq_self (fun x : ℝ => (1 + x ^ 2)⁻¹) (A / 2 * b)]
      rw [integral_univ_inv_one_add_sq, smul_eq_mul,
        abs_of_pos (by positivity : (0 : ℝ) < c⁻¹)]
    rw [hg2, integral_const_mul, hcomp, hc]
    have hpi : (0 : ℝ) < π := Real.pi_pos
    have h1 : 2 * ((A / 2 * a)⁻¹ * π) = 4 * π / (A * a) := by
      field_simp
      ring
    rw [h1, div_le_div_iff₀ (by positivity) hA]
    have hkey : π * A * 4 ≤ π * A * (5 * a) :=
      mul_le_mul_of_nonneg_left (by linarith : (4 : ℝ) ≤ 5 * a)
        (le_of_lt (mul_pos hpi hA))
    nlinarith [hkey]
  linarith

/-! ### The far plate in the complementary region -/

/-- In the region where the phase at the reference angle is at least half the plate parameter, the
phase stays comparable to its reference value across the plate. -/
theorem plate_bounds_far2 {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg2 : |plA M ν ε t w| / 2 ≤ |psiu (mk2 w v) ε t (plAng M ν)|) :
    ∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
      |psiu (mk2 w v) ε t (plAng M ν)| / 2 ≤ |psiu (mk2 w v) ε t φ| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφν
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t φν with hq
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hqpos : (0 : ℝ) < |q| := lt_of_lt_of_le (by positivity) hreg2
  have hQq : Q ≤ |q| / 50 := by
    have h1 : 100 * Q ≤ |A| := hA
    have h2 : |A| ≤ 2 * |q| := by linarith
    linarith
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * q - A := by
    rw [hu, hAdef, plA, ← hφν, hq, hu]
    exact psi1_ref_identity w v ε t φν
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * q - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_up : |psi1 u φν| ≤ 4 * |q| := by
    have hcq : |Real.cos φν * q| ≤ 3 / 5 * |q| := by
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right hcos (abs_nonneg _)
    have h1 : |Real.cos φν * q - A| ≤ 3 / 5 * |q| + |A| := by
      have h3 := abs_sub (Real.cos φν * q) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    have h5 : |A| ≤ 2 * |q| := by linarith
    linarith
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 5 * |q| + 2 := by
    have h := norm_le_psi u ε t φν
    rw [← hq] at h
    have h2 : |q - ε * t| ≤ |q| + 2 := by
      have h3 := abs_sub q (ε * t)
      linarith
    linarith [hpp_up]
  intro φ hφ
  have hlipφ : |φ - φν| ≤ 2 * Q := by
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have h1 : |psiu u ε t φ - q| ≤ (5 * |q| + 2) * (2 * Q) := by
    have h := abs_psiu_sub_le u ε t φ φν
    rw [← hq] at h
    calc |psiu u ε t φ - q| ≤ ‖u‖ * |φ - φν| := h
      _ ≤ (5 * |q| + 2) * (2 * Q) :=
          mul_le_mul hnorm hlipφ (abs_nonneg _) (by positivity)
  have hsmall : (5 * |q| + 2) * (2 * Q) ≤ |q| / 2 := by
    have hA1 : 10 * Q * |q| ≤ 10 / 100 * |q| := by
      have := mul_le_mul_of_nonneg_right hQ (le_of_lt hqpos)
      linarith
    have hA2 : 4 * Q ≤ 4 / 50 * |q| := by linarith [hQq]
    nlinarith [hA1, hA2, hqpos]
  have h2 : |q| - |psiu u ε t φ - q| ≤ |psiu u ε t φ| := by
    have h3 := abs_sub_abs_le_abs_sub q (psiu u ε t φ)
    rw [abs_sub_comm q (psiu u ε t φ)] at h3
    linarith
  linarith

/-- **The far plate in the complementary region.**  Only the capped radial route is needed. -/
theorem norm_kernPlate_far2_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg2 : |plA M ν ε t w| / 2 ≤ |psiu (mk2 w v) ε t (plAng M ν)|) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
          * (1 + (2 : ℝ) ^ (j : ℤ) * (|psiu (mk2 w v) ε t (plAng M ν)| / 2))⁻¹ ^ 4 := by
  have hb := plate_bounds_far2 hε ht1 ht2 hQ hang hA hreg2
  refine norm_kernPlate_le_capped hp hm ε t (mk2 w v) M ν (by positivity) ?_
  have hplate : Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
      (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
      = Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))) := by
    rw [plAng_add M ν, plAng]
  rw [hplate]
  exact hb

/-! ### The pointwise majorant on a far plate -/

/-- The angular bound on a far plate, in the region where the phase is small. -/
theorem norm_kernPlate_ang_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|)
    (hreg : |psiu (mk2 w v) ε t (plAng M ν)| ≤ |plA M ν ε t w| / 2) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 28800 * stC * B0 * (2 : ℝ) ^ M / |plA M ν ε t w| ^ 2 := by
  obtain ⟨hb1, hb2, hb3, hb4⟩ := plate_bounds_far hε ht1 ht2 hQ hang hA hreg
  have hApos : (0 : ℝ) < |plA M ν ε t w| := lt_of_lt_of_le (by positivity) hA
  have hplate : Set.Icc ((ν : ℝ) * (2 : ℝ) ^ (-(M : ℤ)))
      (((ν : ℝ) + 2) * (2 : ℝ) ^ (-(M : ℤ)))
      = Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))) := by
    rw [plAng_add M ν, plAng]
  have h := norm_kernPlate_le_angular hp hm ε t (mk2 w v) hM hν hνB
    (by positivity : (0 : ℝ) < |plA M ν ε t w| / 3) (by linarith [hA])
    (by rw [hplate]; exact hb1) (by rw [hplate]; exact hb2)
    (by
      rw [hplate]
      intro φ hφ
      have h3 := hb3 φ hφ
      rw [psi3_eq_neg (mk2 w v) φ, abs_neg]
      exact h3)
  refine le_trans h (le_of_eq ?_)
  field_simp
  ring

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The pointwise majorant on a far plate.**  Three regions: the flat core (angular bound), the
intermediate region (the combined bound), and the far region (capped radial bound).  All three are
dominated by the sum of two capped quadratic bumps. -/
theorem norm_kernPlate_far_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|) (v : ℝ) :
    ‖kernPlate j ε m t (mk2 w v) M ν‖
      ≤ 28800 * stC * B0 * (2 : ℝ) ^ M / |plA M ν ε t w| ^ 2
          * (1 + (2 : ℝ) ^ (j : ℤ)
              * max 0 (|psiu (mk2 w v) ε t (plAng M ν)|
                  - 12 * (2 : ℝ) ^ (-(M : ℤ)) * |plA M ν ε t w|))⁻¹ ^ 2
        + (4000 * stC * B0 * (2 : ℝ) ^ (j : ℤ) / |plA M ν ε t w|
            + 512 * (2 : ℝ) ^ (-(M : ℤ)) * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * (1 + (2 : ℝ) ^ (j : ℤ) * (|plA M ν ε t w| / 4))⁻¹ ^ 2)
          * (1 + (2 : ℝ) ^ (j : ℤ) / 2
              * max 0 (|psiu (mk2 w v) ε t (plAng M ν)| - 0))⁻¹ ^ 2 := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set q : ℝ := psiu (mk2 w v) ε t (plAng M ν) with hqdef
  set Ab : ℝ := 28800 * stC * B0 * P / |A| ^ 2 with hAbdef
  set C1 : ℝ := 4000 * stC * B0 * J / |A| with hC1def
  set D1 : ℝ := 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2 with hD1def
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hAbnn : (0 : ℝ) ≤ Ab := by
    rw [hAbdef]
    positivity
  have hC1nn : (0 : ℝ) ≤ C1 := by
    rw [hC1def]
    positivity
  have hD1nn : (0 : ℝ) ≤ D1 := by
    rw [hD1def]
    positivity
  have hqnn : (0 : ℝ) ≤ |q| := abs_nonneg _
  have hqabs : (0 : ℝ) ≤ |A| := le_of_lt hApos
  clear_value Ab C1 D1
  have hzero : max 0 (|q| - 0) = |q| := by
    rw [sub_zero, max_eq_right hqnn]
  have hterm2nn : (0 : ℝ) ≤ (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
    have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
    positivity
  have hterm1nn : (0 : ℝ) ≤ Ab * (1 + J * max 0 (|q| - 12 * Q * |A|))⁻¹ ^ 2 := by
    have h : (0 : ℝ) ≤ max 0 (|q| - 12 * Q * |A|) := le_max_left _ _
    positivity
  rcases le_or_gt (|q|) (12 * Q * |A|) with hcase1 | hcase1
  · -- the flat core: the angular bound, and the first majorant is exactly `Ab`
    have hreg : |q| ≤ |A| / 2 := by
      have h1 : 12 * Q * |A| ≤ |A| / 2 := by
        have h2 : 12 * Q ≤ 12 / 100 := by linarith
        nlinarith [hApos, h2]
      linarith
    have hangb := norm_kernPlate_ang_le hp hm hε ht1 ht2 hM hQ hν hνB hang hA hreg
    have hmax : max 0 (|q| - 12 * Q * |A|) = 0 := max_eq_left (by linarith)
    have heq : Ab * (1 + J * max 0 (|q| - 12 * Q * |A|))⁻¹ ^ 2 = Ab := by
      rw [hmax]
      norm_num
    rw [heq]
    linarith [hangb, hterm2nn]
  · rcases le_or_gt (|q|) (|A| / 2) with hcase2 | hcase2
    · -- the intermediate region: the combined bound
      have hcomb := norm_kernPlate_far_le hp hm hε ht1 ht2 hM hQ hν hνB hang hA hcase2
      have hmu : |q| / 2 ≤ max 0 (|q| - 6 * Q * |A|) := by
        have h1 : 6 * Q * |A| ≤ |q| / 2 := by
          nlinarith [hcase1, hQpos, hApos]
        have h2 : |q| / 2 ≤ |q| - 6 * Q * |A| := by linarith
        exact le_trans h2 (le_max_right _ _)
      have hmono : (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2
          ≤ (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        rw [hzero]
        have h1 : 1 + J / 2 * |q| ≤ 1 + J * max 0 (|q| - 6 * Q * |A|) := by
          nlinarith [hmu, hJpos]
        have h2 : (0 : ℝ) < 1 + J / 2 * |q| := by positivity
        have h3 := inv_anti₀ h2 h1
        have h4 : (0 : ℝ) ≤ (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ := by
          have h5 : (0 : ℝ) ≤ max 0 (|q| - 6 * Q * |A|) := le_max_left _ _
          positivity
        nlinarith [h3, h4]
      have hbd : ‖kernPlate j ε m t (mk2 w v) M ν‖
          ≤ C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        refine le_trans hcomb ?_
        have heq : 4000 * stC * B0 * J
              * (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2 / |A|
            = C1 * (1 + J * max 0 (|q| - 6 * Q * |A|))⁻¹ ^ 2 := by
          rw [hC1def]
          field_simp
        rw [heq]
        exact mul_le_mul_of_nonneg_left hmono hC1nn
      have hD1term : (0 : ℝ) ≤ D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
        positivity
      have hsplit : (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
          = C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
            + D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      rw [hsplit]
      linarith [hbd, hterm1nn, hD1term]
    · -- the far region: the capped radial bound
      have hcap := norm_kernPlate_far2_le hp hm hε ht1 ht2 hQ hang hA (le_of_lt hcase2)
      have hfac : (1 + J * (|q| / 2))⁻¹ ^ 4
          ≤ (1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        rw [hzero]
        have h1 : 1 + J * (|A| / 4) ≤ 1 + J * (|q| / 2) := by
          nlinarith [hcase2, hJpos]
        have h2 : (0 : ℝ) < 1 + J * (|A| / 4) := by positivity
        have h3 : (0 : ℝ) < 1 + J * (|q| / 2) := by positivity
        have h4 := inv_anti₀ h2 h1
        have h5 : (1 + J * (|q| / 2))⁻¹ ^ 2 ≤ (1 + J * (|A| / 4))⁻¹ ^ 2 := by
          have h6 : (0 : ℝ) ≤ (1 + J * (|q| / 2))⁻¹ := by positivity
          nlinarith [h4, h6]
        have h7 : (1 + J / 2 * |q|) = (1 + J * (|q| / 2)) := by ring
        rw [h7]
        have h8 : (1 + J * (|q| / 2))⁻¹ ^ 4
            = (1 + J * (|q| / 2))⁻¹ ^ 2 * (1 + J * (|q| / 2))⁻¹ ^ 2 := by ring
        rw [h8]
        refine mul_le_mul h5 (le_refl _) (by positivity) (by positivity)
      have hbd : ‖kernPlate j ε m t (mk2 w v) M ν‖
          ≤ D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        refine le_trans hcap ?_
        rw [hD1def]
        have hfac2 : 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|q| / 2))⁻¹ ^ 4
            ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * ((1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2) :=
          mul_le_mul_of_nonneg_left hfac (by positivity)
        calc 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|q| / 2))⁻¹ ^ 4
            ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ))
              * ((1 + J * (|A| / 4))⁻¹ ^ 2 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2) := hfac2
          _ = 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
              * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      have hC1term : (0 : ℝ) ≤ C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by
        have h : (0 : ℝ) ≤ max 0 (|q| - 0) := le_max_left _ _
        positivity
      have hsplit : (C1 + D1) * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
          = C1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2
            + D1 * (1 + J / 2 * max 0 (|q| - 0))⁻¹ ^ 2 := by ring
      rw [hsplit]
      linarith [hbd, hterm1nn, hC1term]

/-! ### The `v`-integral over a far plate -/

set_option maxHeartbeats 2000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The far plate contributes `stC·B₀/|A|`.**  Integrating the pointwise majorant in the second
coordinate: the flat core contributes `2^{-M}|A|` times the angular bound, and the two decaying
pieces contribute `2^{-j}` times their peaks. -/
theorem exists_far_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉)
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : 100 * (2 : ℝ) ^ (-(M : ℤ)) ≤ |plA M ν ε t w|) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 100000000 * stC * B0 / |plA M ν ε t w| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  set φν : ℝ := plAng M ν with hφνdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hApos : (0 : ℝ) < |A| := lt_of_lt_of_le (by positivity) hA
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hJ1 : (1 : ℝ) ≤ J := by
    rw [hJdef, zpow_natCast]
    exact one_le_pow₀ (by norm_num)
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hP2J : P ^ 2 ≤ 16384 * J := by
    rw [hPdef, hJdef]
    have h1 : ((2 : ℝ) ^ M) ^ 2 = (2 : ℝ) ^ (((2 * M : ℕ) : ℤ)) := by
      rw [zpow_natCast, ← pow_mul]
      ring_nf
    have h2 : (16384 : ℝ) * (2 : ℝ) ^ (j : ℤ) = (2 : ℝ) ^ ((j : ℤ) + 14) := by
      rw [zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
      norm_num
      ring
    rw [h1, h2]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    push_cast
    omega
  have hAinv : (1 : ℝ) / |A| ≤ P / 100 := by
    rw [div_le_div_iff₀ hApos (by norm_num)]
    have h1 : 100 * Q ≤ |A| := hA
    have h2 : P * (100 * Q) ≤ P * |A| := mul_le_mul_of_nonneg_left h1 (le_of_lt hPpos)
    rw [show P * (100 * Q) = 100 * (P * Q) by ring, hPQ] at h2
    linarith
  -- the affine form of the phase
  set a : ℝ := Real.sin φν with hadef
  set b : ℝ := w * Real.cos φν + ε * t with hbdef
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have ha : (4 : ℝ) / 5 ≤ a := by
    rw [hadef]
    exact sin_ge_of_near hangle
  have hqaff : ∀ v : ℝ, psiu (mk2 w v) ε t φν = a * v + b := by
    intro v
    rw [hadef, hbdef, hφνdef, psiu_mk2]
    ring
  -- the two constants
  set T1 : ℝ := 28800 * stC * B0 * P / |A| ^ 2 with hT1def
  set T2 : ℝ := 4000 * stC * B0 * J / |A|
    + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2 with hT2def
  have hT1nn : (0 : ℝ) ≤ T1 := by
    rw [hT1def]
    positivity
  have hT2nn : (0 : ℝ) ≤ T2 := by
    rw [hT2def]
    positivity
  -- the majorant
  set G : ℝ → ℝ := fun v =>
    T1 * (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2
      + T2 * (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 with hGdef
  have hmaj : ∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v := by
    intro v
    have h := norm_kernPlate_far_majorant hp hm hε ht1 ht2 hM hQ hν hνB hang hA v
    rw [hqaff v] at h
    exact h
  -- the two capped integrals
  obtain ⟨hint1, hbd1⟩ := integral_capped_le (A := J) (a := a) (b := b)
    (slack := 12 * Q * |A|) hJpos ha (by positivity)
  obtain ⟨hint2, hbd2⟩ := integral_capped_le (A := J / 2) (a := a) (b := b) (slack := 0)
    (by positivity) ha (le_refl 0)
  have hGint : Integrable G := by
    rw [hGdef]
    exact (hint1.const_mul T1).add (hint2.const_mul T2)
  have hGnn : ∀ v : ℝ, (0 : ℝ) ≤ G v := by
    intro v
    rw [hGdef]
    have h1 : (0 : ℝ) ≤ max 0 (|a * v + b| - 12 * Q * |A|) := le_max_left _ _
    have h2 : (0 : ℝ) ≤ max 0 (|a * v + b| - 0) := le_max_left _ _
    have h3 : (0 : ℝ) ≤ (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2 := by positivity
    have h4 : (0 : ℝ) ≤ (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 := by positivity
    have h5 : (0 : ℝ) ≤ T1 * (1 + J * max 0 (|a * v + b| - 12 * Q * |A|))⁻¹ ^ 2 :=
      mul_nonneg hT1nn h3
    have h6 : (0 : ℝ) ≤ T2 * (1 + J / 2 * max 0 (|a * v + b| - 0))⁻¹ ^ 2 :=
      mul_nonneg hT2nn h4
    linarith
  -- the integral of the majorant
  have hGbd : (∫ v : ℝ, G v) ≤ T1 * (5 * (12 * Q * |A|) + 5 * π / J)
      + T2 * (5 * 0 + 5 * π / (J / 2)) := by
    rw [hGdef, integral_add (hint1.const_mul T1) (hint2.const_mul T2),
      integral_const_mul, integral_const_mul]
    refine add_le_add (mul_le_mul_of_nonneg_left hbd1 hT1nn)
      (mul_le_mul_of_nonneg_left hbd2 hT2nn)
  -- the numerical estimate
  have hnum : T1 * (5 * (12 * Q * |A|) + 5 * π / J) + T2 * (5 * 0 + 5 * π / (J / 2))
      ≤ 100000000 * (stC * B0 / |A|) := by
    have hpi : π ≤ 4 := Real.pi_le_four
    have hpipos : (0 : ℝ) < π := Real.pi_pos
    have hXnn : (0 : ℝ) ≤ stC * B0 / |A| := by positivity
    -- first term
    have e1 : T1 * (5 * (12 * Q * |A|)) = 1728000 * stC * B0 * (P * Q) / |A| := by
      rw [hT1def]
      field_simp
      ring
    have e1' : T1 * (5 * (12 * Q * |A|)) = 1728000 * (stC * B0 / |A|) := by
      rw [e1, hPQ]
      ring
    -- second term
    have e2 : T1 * (5 * π / J) = 144000 * π * stC * B0 * P / (|A| ^ 2 * J) := by
      rw [hT1def]
      field_simp
      ring
    have e2' : T1 * (5 * π / J) ≤ 80000000 * (stC * B0 / |A|) := by
      rw [e2]
      have hstep : P / (|A| ^ 2 * J) ≤ 16384 / (100 * |A|) := by
        rw [div_le_div_iff₀ (by positivity) (by positivity)]
        have h4 : 100 ≤ |A| * P := by
          rw [div_le_div_iff₀ hApos (by norm_num)] at hAinv
          linarith
        have h5 : P ^ 2 ≤ 16384 * J := hP2J
        have h6 : |A| ^ 2 * P ^ 2 ≤ |A| ^ 2 * (16384 * J) :=
          mul_le_mul_of_nonneg_left h5 (sq_nonneg _)
        have h7 : 100 * (|A| * P) ≤ (|A| * P) * (|A| * P) := by nlinarith [h4]
        nlinarith [h6, h7]
      have h7 : 144000 * π * stC * B0 * P / (|A| ^ 2 * J)
          = 144000 * π * stC * B0 * (P / (|A| ^ 2 * J)) := by ring
      rw [h7]
      have h6 : 144000 * π * stC * B0 * (P / (|A| ^ 2 * J))
          ≤ 144000 * π * stC * B0 * (16384 / (100 * |A|)) :=
        mul_le_mul_of_nonneg_left hstep (by positivity)
      refine le_trans h6 ?_
      have h8 : 144000 * π * stC * B0 * (16384 / (100 * |A|))
          = 23592960 * π * (stC * B0 / |A|) := by
        field_simp
        ring
      rw [h8]
      have h9 : 23592960 * π ≤ 80000000 := by
        have hpi : π ≤ 3.15 := le_of_lt Real.pi_lt_d2
        nlinarith [hpi]
      exact mul_le_mul_of_nonneg_right h9 hXnn
    -- third term
    have e3 : T2 * (5 * 0 + 5 * π / (J / 2)) = T2 * (10 * π / J) := by
      have h : 5 * π / (J / 2) = 10 * π / J := by
        field_simp
        ring
      rw [h]
      ring
    have e3' : T2 * (10 * π / J) ≤ 250000 * (stC * B0 / |A|) := by
      rw [hT2def]
      have hsplit : (4000 * stC * B0 * J / |A|
            + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2)
            * (10 * π / J)
          = 4000 * stC * B0 * J / |A| * (10 * π / J)
            + 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
              * (10 * π / J) := by ring
      rw [hsplit]
      have hfirst : 4000 * stC * B0 * J / |A| * (10 * π / J)
          = 40000 * π * (stC * B0 / |A|) := by
        field_simp
        ring
      have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
        rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
        congr 1
        push_cast
        ring
      have hinvbd : (1 + J * (|A| / 4))⁻¹ ^ 2 ≤ 16 / (J ^ 2 * |A| ^ 2) := by
        have h1 : J * (|A| / 4) ≤ 1 + J * (|A| / 4) := by linarith
        have h2 : (0 : ℝ) < J * (|A| / 4) := by positivity
        have h3 : (1 + J * (|A| / 4))⁻¹ ≤ (J * (|A| / 4))⁻¹ := inv_anti₀ h2 h1
        have h4 : (0 : ℝ) ≤ (1 + J * (|A| / 4))⁻¹ := by positivity
        have h5 : (1 + J * (|A| / 4))⁻¹ ^ 2 ≤ ((J * (|A| / 4))⁻¹) ^ 2 :=
          pow_le_pow_left₀ h4 h3 2
        refine le_trans h5 (le_of_eq ?_)
        field_simp
        ring
      have hsecond : 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * (|A| / 4))⁻¹ ^ 2
            * (10 * π / J)
          ≤ 512 * Q * B0 * J ^ 2 * (16 / (J ^ 2 * |A| ^ 2)) * (10 * π / J) := by
        rw [hJ2]
        refine mul_le_mul_of_nonneg_right
          (mul_le_mul_of_nonneg_left hinvbd (by positivity)) (by positivity)
      have hsecond' : 512 * Q * B0 * J ^ 2 * (16 / (J ^ 2 * |A| ^ 2)) * (10 * π / J)
          = 81920 * π * Q * B0 / (J * |A| ^ 2) := by
        field_simp
        ring
      have hthird : 81920 * π * Q * B0 / (J * |A| ^ 2) ≤ 4000 * (B0 / |A|) := by
        have hstep : Q / (J * |A| ^ 2) ≤ 1 / (100 * |A|) := by
          rw [div_le_div_iff₀ (by positivity) (by positivity)]
          have h5 : Q * (100 * |A|) ≤ |A| ^ 2 := by
            nlinarith [hA, hApos, hQpos]
          nlinarith [h5, hJ1, hApos, sq_nonneg |A|]
        have h1 : 81920 * π * Q * B0 / (J * |A| ^ 2)
            = 81920 * π * B0 * (Q / (J * |A| ^ 2)) := by ring
        rw [h1]
        have h2 : 81920 * π * B0 * (Q / (J * |A| ^ 2))
            ≤ 81920 * π * B0 * (1 / (100 * |A|)) :=
          mul_le_mul_of_nonneg_left hstep (by positivity)
        refine le_trans h2 ?_
        have h3 : 81920 * π * B0 * (1 / (100 * |A|)) = 819.2 * π * (B0 / |A|) := by
          field_simp
          ring
        rw [h3]
        have h4 : 819.2 * π ≤ 4000 := by linarith
        have h5 : (0 : ℝ) ≤ B0 / |A| := by positivity
        exact mul_le_mul_of_nonneg_right h4 h5
      have hstC1 : B0 / |A| ≤ stC * B0 / |A| := by
        refine div_le_div_of_nonneg_right ?_ hApos.le
        nlinarith [hstC, hB0]
      have hfin : 4000 * (B0 / |A|) ≤ 4000 * (stC * B0 / |A|) :=
        mul_le_mul_of_nonneg_left hstC1 (by norm_num)
      have hpi40000 : 40000 * π * (stC * B0 / |A|) ≤ 160000 * (stC * B0 / |A|) := by
        have h9 : 40000 * π ≤ 160000 := by linarith
        have h : 40000 * π * (stC * B0 / |A|) = (40000 * π) * (stC * B0 / |A|) := by ring
        rw [h]
        exact mul_le_mul_of_nonneg_right h9 hXnn
      rw [hfirst]
      linarith [hsecond, hsecond' ▸ hthird, hfin, hpi40000, hXnn]
    have hsplit2 : T1 * (5 * (12 * Q * |A|) + 5 * π / J)
        = T1 * (5 * (12 * Q * |A|)) + T1 * (5 * π / J) := by ring
    rw [hsplit2, e1', e3]
    linarith [e2', e3', hXnn]
  refine ⟨G, hmaj, hGint, hGnn, ?_⟩
  refine le_trans (le_trans hGbd hnum) (le_of_eq ?_)
  ring

/-! ### The near plates -/

/-- On a near plate the phase varies by at most `2Q|q| + 300Q²` across the plate. -/
theorem plate_bounds_near {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w v : ℝ}
    (hA : |plA M ν ε t w| ≤ 100 * (2 : ℝ) ^ (-(M : ℤ))) :
    ∀ φ ∈ Set.Icc (plAng M ν) (plAng M ν + 2 * (2 : ℝ) ^ (-(M : ℤ))),
      |psiu (mk2 w v) ε t (plAng M ν)|
          - (2 * (2 : ℝ) ^ (-(M : ℤ)) * |psiu (mk2 w v) ε t (plAng M ν)|
            + 300 * ((2 : ℝ) ^ (-(M : ℤ))) ^ 2)
        ≤ |psiu (mk2 w v) ε t φ| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set φν : ℝ := plAng M ν with hφνdef
  set A : ℝ := plA M ν ε t w with hAdef
  set u : Pl := mk2 w v with hu
  set q : ℝ := psiu u ε t φν with hqdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hqnn : (0 : ℝ) ≤ |q| := abs_nonneg _
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have hsin : (4 : ℝ) / 5 ≤ Real.sin φν := sin_ge_of_near hangle
  have hcos : |Real.cos φν| ≤ 3 / 5 := abs_cos_le_of_near hangle
  have hsinpos : (0 : ℝ) ≤ Real.sin φν := by linarith
  have hident : psi1 u φν * Real.sin φν = Real.cos φν * q - A := by
    rw [hu, hAdef, plA, ← hφνdef, hqdef, hu]
    exact psi1_ref_identity w v ε t φν
  have hpsin : |psi1 u φν| * Real.sin φν = |Real.cos φν * q - A| := by
    rw [← hident, abs_mul, abs_of_nonneg hsinpos]
  have hpp_up : |psi1 u φν| ≤ 3 / 4 * |q| + 125 * Q := by
    have hcq : |Real.cos φν * q| ≤ 3 / 5 * |q| := by
      rw [abs_mul]
      exact mul_le_mul_of_nonneg_right hcos (abs_nonneg _)
    have h1 : |Real.cos φν * q - A| ≤ 3 / 5 * |q| + 100 * Q := by
      have h3 := abs_sub (Real.cos φν * q) A
      linarith
    have h4 : |psi1 u φν| * (4 / 5) ≤ |psi1 u φν| * Real.sin φν :=
      mul_le_mul_of_nonneg_left hsin (abs_nonneg _)
    rw [hpsin] at h4
    linarith
  have hεt : |ε * t| ≤ 2 := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
    exact ht2
  have hnorm : ‖u‖ ≤ 7 / 4 * |q| + 125 * Q + 2 := by
    have h := norm_le_psi u ε t φν
    rw [← hqdef] at h
    have h2 : |q - ε * t| ≤ |q| + 2 := by
      have h3 := abs_sub q (ε * t)
      linarith
    linarith [hpp_up]
  -- the derivative bound on the plate
  have hK : ∀ φ ∈ Set.Icc φν (φν + 2 * Q), |psi1 u φ| ≤ 4 / 5 * |q| + 132 * Q := by
    intro φ hφ
    have hlipφ : |φ - φν| ≤ 2 * Q := by
      rw [abs_of_nonneg (by linarith [hφ.1])]
      linarith [hφ.2]
    have h1 : |psi1 u φ - psi1 u φν| ≤ (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) := by
      have h := abs_psi1_sub_le u φ φν
      calc |psi1 u φ - psi1 u φν| ≤ ‖u‖ * |φ - φν| := h
        _ ≤ (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) :=
            mul_le_mul hnorm hlipφ (abs_nonneg _) (by positivity)
    have h2 : |psi1 u φ| ≤ |psi1 u φν| + |psi1 u φ - psi1 u φν| := by
      have h3 := abs_sub_abs_le_abs_sub (psi1 u φ) (psi1 u φν)
      linarith
    have h4 : (7 / 4 * |q| + 125 * Q + 2) * (2 * Q) ≤ 1 / 20 * |q| + 7 * Q := by
      have hq1 : 2 * Q * (7 / 4 * |q|) ≤ 1 / 20 * |q| := by
        nlinarith [hQpos, hqnn, hQ]
      have hq2 : 2 * Q * (125 * Q) ≤ 3 * Q := by
        nlinarith [hQpos, hQ]
      nlinarith [hq1, hq2, hQpos]
    linarith [hpp_up]
  -- the mean value bound
  intro φ hφ
  have hmvt := abs_psiu_sub_le_of_bound u ε t hK hφ
    (Set.left_mem_Icc.mpr (by linarith [hQpos]))
  have hlipφ : |φ - φν| ≤ 2 * Q := by
    rw [abs_of_nonneg (by linarith [hφ.1])]
    linarith [hφ.2]
  have h1 : |psiu u ε t φ - q| ≤ 2 * Q * |q| + 300 * Q ^ 2 := by
    rw [← hqdef] at hmvt
    calc |psiu u ε t φ - q| ≤ (4 / 5 * |q| + 132 * Q) * |φ - φν| := hmvt
      _ ≤ (4 / 5 * |q| + 132 * Q) * (2 * Q) := by
          refine mul_le_mul_of_nonneg_left hlipφ (by positivity)
      _ ≤ 2 * Q * |q| + 300 * Q ^ 2 := by
          nlinarith [hQpos, hqnn]
  have h2 : |q| - |psiu u ε t φ - q| ≤ |psiu u ε t φ| := by
    have h3 := abs_sub_abs_le_abs_sub q (psiu u ε t φ)
    rw [abs_sub_comm q (psiu u ε t φ)] at h3
    linarith
  linarith

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The near plates.**  There are `O(1)` of them, and each contributes `O(B₀ 2^M)`. -/
theorem exists_near_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ))
    {ν : ℤ} (hang : |π / 2 - plAng M ν| ≤ 3 / 5) {w : ℝ}
    (hA : |plA M ν ε t w| ≤ 100 * (2 : ℝ) ^ (-(M : ℤ))) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 7000000 * B0 * (2 : ℝ) ^ M := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set J : ℝ := (2 : ℝ) ^ (j : ℤ) with hJdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set φν : ℝ := plAng M ν with hφνdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hJpos : (0 : ℝ) < J := by rw [hJdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hJP2 : J ≤ P ^ 2 := by
    rw [hJdef, hPdef]
    have h1 : ((2 : ℝ) ^ M) ^ 2 = (2 : ℝ) ^ (((2 * M : ℕ) : ℤ)) := by
      rw [zpow_natCast, ← pow_mul]
      ring_nf
    rw [h1]
    refine zpow_le_zpow_right₀ (by norm_num) ?_
    push_cast
    omega
  have hJ2 : (2 : ℝ) ^ (2 * (j : ℤ)) = J ^ 2 := by
    rw [hJdef, ← zpow_natCast ((2 : ℝ) ^ (j : ℤ)) 2, ← zpow_mul]
    congr 1
    push_cast
    ring
  -- the affine form of the phase
  set a : ℝ := Real.sin φν with hadef
  set b : ℝ := w * Real.cos φν + ε * t with hbdef
  have hangle : |π / 2 - φν| ≤ 3 / 5 := by linarith [hang]
  have ha : (4 : ℝ) / 5 ≤ a := by
    rw [hadef]
    exact sin_ge_of_near hangle
  have hqaff : ∀ v : ℝ, psiu (mk2 w v) ε t φν = a * v + b := by
    intro v
    rw [hadef, hbdef, hφνdef, psiu_mk2]
    ring
  refine ⟨fun v => 512 * Q * B0 * J ^ 2
      * (1 + J / 3 * max 0 (|a * v + b| - 2700 * Q ^ 2))⁻¹ ^ 2, ?_, ?_, ?_, ?_⟩
  · -- the pointwise bound
    intro v
    set qv : ℝ := |a * v + b| with hqvdef
    have hqvnn : (0 : ℝ) ≤ qv := by rw [hqvdef]; exact abs_nonneg _
    have hbd := plate_bounds_near hε ht1 ht2 hQ hang hA (v := v)
    rw [hqaff v] at hbd
    set mu : ℝ := max 0 (qv - (2 * Q * qv + 300 * Q ^ 2)) with hmudef
    have hcap : ‖kernPlate j ε m t (mk2 w v) M ν‖
        ≤ 512 * Q * B0 * (2 : ℝ) ^ (2 * (j : ℤ)) * (1 + J * mu)⁻¹ ^ 4 := by
      refine norm_kernPlate_le_capped hp hm ε t (mk2 w v) M ν (le_max_left _ _) ?_
      have hplate : Set.Icc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q)
          = Set.Icc φν (φν + 2 * Q) := by
        rw [hφνdef, plAng_add M ν, plAng]
      rw [hplate]
      intro φ hφ
      rcases le_or_gt (qv - (2 * Q * qv + 300 * Q ^ 2)) 0 with hle | hgt
      · have hz : mu = 0 := by rw [hmudef, max_eq_left hle]
        rw [hz]
        exact abs_nonneg _
      · have hz : mu = qv - (2 * Q * qv + 300 * Q ^ 2) := by
          rw [hmudef, max_eq_right (le_of_lt hgt)]
        rw [hz, hqvdef]
        exact hbd φ hφ
    -- compare the two capped bounds
    have hstep : (1 : ℝ) / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ mu := by
      rcases le_or_gt (2700 * Q ^ 2) qv with hcase | hcase
      · have hslack : 2 * Q * qv + 300 * Q ^ 2 ≤ 2 / 3 * qv := by
          have h1 : 2 * Q * qv ≤ 1 / 50 * qv := by
            nlinarith [hQpos, hqvnn, hQ]
          have h2 : 300 * Q ^ 2 ≤ 1 / 9 * qv := by
            nlinarith [hcase, hQpos]
          linarith
        have h3 : (1 : ℝ) / 3 * qv ≤ qv - (2 * Q * qv + 300 * Q ^ 2) := by linarith
        have h4 : max 0 (qv - 2700 * Q ^ 2) ≤ qv := by
          refine max_le hqvnn ?_
          nlinarith [hQpos]
        calc (1 : ℝ) / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ 1 / 3 * qv := by linarith
          _ ≤ qv - (2 * Q * qv + 300 * Q ^ 2) := h3
          _ ≤ mu := le_max_right _ _
      · have hz : max 0 (qv - 2700 * Q ^ 2) = 0 := by
          refine max_eq_left ?_
          linarith
        rw [hz]
        have : (0 : ℝ) ≤ mu := le_max_left _ _
        linarith
    have hmono : (1 + J * mu)⁻¹ ^ 4
        ≤ (1 + J / 3 * max 0 (qv - 2700 * Q ^ 2))⁻¹ ^ 2 := by
      have h1 : 1 + J / 3 * max 0 (qv - 2700 * Q ^ 2) ≤ 1 + J * mu := by
        have h2 : J / 3 * max 0 (qv - 2700 * Q ^ 2) = J * (1 / 3 * max 0 (qv - 2700 * Q ^ 2)) := by
          ring
        rw [h2]
        linarith [mul_le_mul_of_nonneg_left hstep (le_of_lt hJpos)]
      have h3 : (0 : ℝ) < 1 + J / 3 * max 0 (qv - 2700 * Q ^ 2) := by
        have h4 : (0 : ℝ) ≤ max 0 (qv - 2700 * Q ^ 2) := le_max_left _ _
        positivity
      have h5 := inv_anti₀ h3 h1
      have h6 : (0 : ℝ) ≤ (1 + J * mu)⁻¹ := by
        have h7 : (0 : ℝ) ≤ mu := le_max_left _ _
        positivity
      have h8 : (1 + J * mu)⁻¹ ^ 4 ≤ (1 + J * mu)⁻¹ ^ 2 := by
        have h9 : (1 + J * mu)⁻¹ ≤ 1 := by
          rw [inv_le_one_iff₀]
          right
          have h7 : (0 : ℝ) ≤ mu := le_max_left _ _
          nlinarith [hJpos, h7]
        exact pow_le_pow_of_le_one h6 h9 (by norm_num)
      have h10 : (1 + J * mu)⁻¹ ^ 2
          ≤ (1 + J / 3 * max 0 (qv - 2700 * Q ^ 2))⁻¹ ^ 2 := pow_le_pow_left₀ h6 h5 2
      linarith
    refine le_trans hcap ?_
    rw [hJ2]
    exact mul_le_mul_of_nonneg_left hmono (by positivity)
  · -- integrability
    obtain ⟨hint, -⟩ := integral_capped_le (A := J / 3) (a := a) (b := b)
      (slack := 2700 * Q ^ 2) (by positivity) ha (by positivity)
    exact hint.const_mul _
  · -- nonnegativity
    intro v
    have h : (0 : ℝ) ≤ max 0 (|a * v + b| - 2700 * Q ^ 2) := le_max_left _ _
    positivity
  · -- the integral
    obtain ⟨hint, hbd⟩ := integral_capped_le (A := J / 3) (a := a) (b := b)
      (slack := 2700 * Q ^ 2) (by positivity) ha (by positivity)
    rw [integral_const_mul]
    have hfac : (0 : ℝ) ≤ 512 * Q * B0 * J ^ 2 := by positivity
    refine le_trans (mul_le_mul_of_nonneg_left hbd hfac) ?_
    -- the numerical estimate
    have hpi : π ≤ 4 := Real.pi_le_four
    have h1 : 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2)) = 6912000 * B0 * (Q ^ 3 * J ^ 2) := by
      ring
    have h2 : Q ^ 3 * J ^ 2 ≤ P := by
      have h3 : J ^ 2 ≤ (P ^ 2) ^ 2 := by
        refine pow_le_pow_left₀ (le_of_lt hJpos) hJP2 2
      have h4 : Q ^ 3 * J ^ 2 ≤ Q ^ 3 * (P ^ 2) ^ 2 :=
        mul_le_mul_of_nonneg_left h3 (by positivity)
      refine le_trans h4 (le_of_eq ?_)
      have h5 : Q = 1 / P := by
        field_simp
        linarith [hPQ]
      rw [h5]
      field_simp
    have h6 : 512 * Q * B0 * J ^ 2 * (5 * π / (J / 3)) = 7680 * π * B0 * (Q * J) := by
      field_simp
      ring
    have h7 : Q * J ≤ P := by
      have h8 : Q * J ≤ Q * P ^ 2 := mul_le_mul_of_nonneg_left hJP2 (le_of_lt hQpos)
      refine le_trans h8 (le_of_eq ?_)
      have h5 : Q = 1 / P := by
        field_simp
        linarith [hPQ]
      rw [h5]
      field_simp
    have hsplit : 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2) + 5 * π / (J / 3))
        = 512 * Q * B0 * J ^ 2 * (5 * (2700 * Q ^ 2))
          + 512 * Q * B0 * J ^ 2 * (5 * π / (J / 3)) := by ring
    rw [hsplit, h1, h6]
    have hA1 : 6912000 * B0 * (Q ^ 3 * J ^ 2) ≤ 6912000 * B0 * P :=
      mul_le_mul_of_nonneg_left h2 (by positivity)
    have hA2 : 7680 * π * B0 * (Q * J) ≤ 7680 * π * B0 * P :=
      mul_le_mul_of_nonneg_left h7 (by positivity)
    have hA3 : 7680 * π * B0 * P ≤ 30720 * B0 * P := by
      have h : (0 : ℝ) ≤ B0 * P := by positivity
      nlinarith [hpi, h]
    have hA4 : (0 : ℝ) ≤ B0 * P := by positivity
    nlinarith [hA1, hA2, hA3, hA4]

/-! ### The uniform per-plate majorant -/

/-- The weight of a plate in the plate sum: the reciprocal of `max(2^{-M}, |A_ν|)` for plates in
the angular range, and zero for the others. -/
noncomputable def plWt (M : ℕ) (ν : ℤ) (ε t w : ℝ) : ℝ :=
  if |π / 2 - plAng M ν| ≤ 3 / 5 then 1 / max ((2 : ℝ) ^ (-(M : ℤ))) (|plA M ν ε t w|) else 0

theorem plWt_nonneg (M : ℕ) (ν : ℤ) (ε t w : ℝ) : 0 ≤ plWt M ν ε t w := by
  rw [plWt]
  split
  · positivity
  · exact le_refl 0

/-- A plate whose reference angle is far from `π/2` does not meet the angular support. -/
theorem kernPlate_eq_zero_of_angle {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) {M : ℕ}
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) {ν : ℤ}
    (hang : ¬ (|π / 2 - plAng M ν| ≤ 3 / 5)) :
    kernPlate j ε m t u M ν = 0 := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hgt : (3 : ℝ) / 5 < |π / 2 - plAng M ν| := not_le.mp hang
  rw [kernPlate]
  have hzero : ∀ φ ∈ Set.Ioo (-π) π,
      (plateC M ν φ : ℝ) • kernRad j ε m t u φ = 0 := by
    intro φ hφ
    by_cases hpc : plateC M ν φ = 0
    · rw [hpc]
      simp
    · -- the angle lies in the plate, hence far from `π/2`
      have hmem : φ ∈ Set.Ioc ((ν : ℝ) * Q) (((ν : ℝ) + 2) * Q) := by
        by_contra hnot
        exact hpc (plateC_eq_zero_of_not_mem hnot)
      have hclose : |φ - plAng M ν| ≤ 2 * Q := by
        rw [plAng, Set.mem_Ioc] at *
        rw [abs_le]
        constructor
        · linarith [hmem.1]
        · linarith [hmem.2]
      have hfar : (3 : ℝ) / 5 - 2 * Q ≤ |π / 2 - φ| := by
        have h1 : |π / 2 - plAng M ν| ≤ |π / 2 - φ| + |φ - plAng M ν| := by
          calc |π / 2 - plAng M ν| = |(π / 2 - φ) + (φ - plAng M ν)| := by
                congr 1
                ring
            _ ≤ |π / 2 - φ| + |φ - plAng M ν| := abs_add_le _ _
        linarith
      have hout : ¬ (1 < φ ∧ φ < π / 2) := by
        intro ⟨h1, h2⟩
        have h3 : |π / 2 - φ| = π / 2 - φ := abs_of_nonneg (by linarith)
        have hpi : π < 3.15 := Real.pi_lt_d2
        rw [h3] at hfar
        have h4 : 2 * Q ≤ 1 / 50 := by linarith
        linarith
      rw [kernRad_eq_zero hm ε t u hφ hout]
      simp
  rw [setIntegral_congr_fun measurableSet_Ioo hzero]
  simp

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The uniform per-plate majorant.**  Every plate — far, near, or outside the angular support —
admits a majorant whose integral is at most `C(1+stC)B₀ / max(2^{-M}, |A_ν|)`. -/
theorem exists_plate_majorant {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ))
    {ν : ℤ} (hν : 0 ≤ ν) (hνB : ν ≤ ⌈π * (2 : ℝ) ^ M⌉) (w : ℝ) :
    ∃ G : ℝ → ℝ, (∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
      ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
      ∧ (∫ v : ℝ, G v) ≤ 700000000 * (1 + stC) * B0 * plWt M ν ε t w := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  set A : ℝ := plA M ν ε t w with hAdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstC : (1 : ℝ) ≤ stC := one_le_stC
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hmaxpos : (0 : ℝ) < max Q |A| := lt_of_lt_of_le hQpos (le_max_left _ _)
  by_cases hangle : |π / 2 - plAng M ν| ≤ 3 / 5
  · by_cases hfar : 100 * Q ≤ |A|
    · -- a far plate
      obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
        exists_far_majorant hp hm hε ht1 ht2 hM hQ hMj hν hνB hangle hfar
      refine ⟨G, hG1, hG2, hG3, le_trans hG4 ?_⟩
      have hmaxeq : max Q |A| = |A| := by
        refine max_eq_right ?_
        linarith
      rw [plWt, if_pos hangle, ← hQdef, ← hAdef, hmaxeq, mul_one_div]
      refine div_le_div_of_nonneg_right ?_ (abs_nonneg A)
      nlinarith [hstCnn, hB0, hstC]
    · -- a near plate
      have hnear : |A| ≤ 100 * Q := le_of_lt (not_le.mp hfar)
      obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
        exists_near_majorant hp hm hε ht1 ht2 hQ hMj2 hangle hnear
      refine ⟨G, hG1, hG2, hG3, le_trans hG4 ?_⟩
      have hmaxle : max Q |A| ≤ 100 * Q := max_le (by linarith) hnear
      have hstep : 7000000 * B0 * P ≤ 700000000 * (1 + stC) * B0 / (100 * Q) := by
        have hPform : P = 1 / Q := by
          field_simp
          linarith [hPQ]
        rw [hPform, le_div_iff₀ (by positivity : (0 : ℝ) < 100 * Q)]
        have h : 7000000 * B0 * (1 / Q) * (100 * Q) = 700000000 * B0 := by
          field_simp
          ring
        rw [h]
        nlinarith [hstCnn, hB0]
      refine le_trans hstep ?_
      rw [plWt, if_pos hangle, ← hQdef, ← hAdef, mul_one_div]
      refine div_le_div_of_nonneg_left ?_ hmaxpos hmaxle
      nlinarith [hstCnn, hB0]
  · -- outside the angular support
    refine ⟨fun _ => 0, ?_, integrable_zero _ _ _, fun _ => le_refl 0, ?_⟩
    · intro v
      rw [kernPlate_eq_zero_of_angle hm ε t (mk2 w v) hQ hangle]
      simp
    · rw [integral_zero, plWt, if_neg hangle]
      simp

/-! ### The plate parameters are separated -/

/-- **Separation.**  The plate parameters `A_ν = w + εt cos φ_ν` of two plates in the angular range
differ by at least `(2/5)|ν - ν'| 2^{-M}`: the `w` cancels, and the cosine has derivative at least
`4/5` in modulus there. -/
theorem plA_separated {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (_ht2 : t ≤ 2) {M : ℕ} {ν ν' : ℤ}
    (w : ℝ) (hang : |π / 2 - plAng M ν| ≤ 3 / 5) (hang' : |π / 2 - plAng M ν'| ≤ 3 / 5) :
    2 / 5 * (|(ν : ℝ) - (ν' : ℝ)| * (2 : ℝ) ^ (-(M : ℤ)))
      ≤ |plA M ν ε t w - plA M ν' ε t w| := by
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set x : ℝ := plAng M ν with hxdef
  set y : ℝ := plAng M ν' with hydef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hdiff : plA M ν ε t w - plA M ν' ε t w = ε * t * (Real.cos x - Real.cos y) := by
    rw [plA, plA, ← hxdef, ← hydef]
    ring
  have hxy : x - y = ((ν : ℝ) - (ν' : ℝ)) * Q := by
    rw [hxdef, hydef, plAng, plAng, hQdef]
    ring
  -- the midpoint is still in the good range
  have hmid : |π / 2 - (x + y) / 2| ≤ 3 / 5 := by
    have h : π / 2 - (x + y) / 2 = ((π / 2 - x) + (π / 2 - y)) / 2 := by ring
    rw [h, abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    have h2 : |(π / 2 - x) + (π / 2 - y)| ≤ |π / 2 - x| + |π / 2 - y| := abs_add_le _ _
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2)]
    linarith
  have hsinmid : (4 : ℝ) / 5 ≤ Real.sin ((x + y) / 2) := sin_ge_of_near hmid
  -- the half-difference is small
  have hsmall : |(x - y) / 2| ≤ π / 2 := by
    have h1 : |x - y| ≤ 6 / 5 := by
      have h2 : |x - y| ≤ |π / 2 - y| + |π / 2 - x| := by
        calc |x - y| = |(π / 2 - y) - (π / 2 - x)| := by
              congr 1
              ring
          _ ≤ |π / 2 - y| + |π / 2 - x| := abs_sub _ _
      linarith
    rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    have hpi : (3 : ℝ) < π := Real.pi_gt_three
    rw [div_le_iff₀ (by norm_num : (0 : ℝ) < 2)]
    linarith
  have hsinhalf : |(x - y) / 2| / 2 ≤ |Real.sin ((x - y) / 2)| := abs_sin_ge_half hsmall
  -- put things together
  have hcos : |Real.cos x - Real.cos y|
      = 2 * |Real.sin ((x + y) / 2)| * |Real.sin ((x - y) / 2)| := by
    rw [Real.cos_sub_cos, abs_mul, abs_mul, abs_neg, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ 2)]
  have hsinmidabs : (4 : ℝ) / 5 ≤ |Real.sin ((x + y) / 2)| := by
    rw [abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sin ((x + y) / 2))]
    exact hsinmid
  have hstep : 2 / 5 * |x - y| ≤ |Real.cos x - Real.cos y| := by
    rw [hcos]
    have habs : |(x - y) / 2| = |x - y| / 2 := by
      rw [abs_div, abs_of_nonneg (by norm_num : (0 : ℝ) ≤ (2 : ℝ))]
    rw [habs] at hsinhalf
    have h1 : (4 : ℝ) / 5 * (|x - y| / 4) ≤ |Real.sin ((x + y) / 2)| * |Real.sin ((x - y) / 2)| :=
        by
      refine mul_le_mul hsinmidabs ?_ (by positivity) (by positivity)
      linarith [hsinhalf]
    nlinarith [h1, abs_nonneg (x - y)]
  have hεt : |ε * t| = t := by
    rw [abs_mul, hε, one_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ t)]
  rw [hdiff, abs_mul, hεt]
  have habsxy : |x - y| = |(ν : ℝ) - (ν' : ℝ)| * Q := by
    rw [hxy, abs_mul, abs_of_pos hQpos]
  rw [habsxy] at hstep
  have hcosnn : (0 : ℝ) ≤ |Real.cos x - Real.cos y| := abs_nonneg _
  have h : 1 * |Real.cos x - Real.cos y| ≤ t * |Real.cos x - Real.cos y| :=
    mul_le_mul_of_nonneg_right ht1 hcosnn
  linarith [hstep, h]

/-! ### The plate sum -/

/-- The harmonic sum over an integer interval. -/
theorem harmonic_int_le (B : ℤ) (L : ℕ) (hB : B ≤ 2 ^ L) :
    ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 := by
  classical
  rcases le_or_gt B 0 with hlt | hge
  · have hempty : Finset.Icc (1 : ℤ) B = ∅ := by
      rw [Finset.Icc_eq_empty]
      omega
    rw [hempty, Finset.sum_empty]
    positivity
  · have himg : (Finset.Icc (1 : ℕ) B.toNat).image (fun n : ℕ => (n : ℤ))
        = Finset.Icc (1 : ℤ) B := by
      ext k
      simp only [Finset.mem_image, Finset.mem_Icc]
      constructor
      · rintro ⟨n, ⟨h1, h2⟩, rfl⟩
        omega
      · intro h
        exact ⟨k.toNat, ⟨by omega, by omega⟩, by omega⟩
    rw [← himg, Finset.sum_image (by
      intro x _ y _ h
      exact Nat.cast_injective h)]
    have hcast : ∀ n ∈ Finset.Icc (1 : ℕ) B.toNat,
        (1 : ℝ) / (((n : ℤ) : ℝ)) = (1 : ℝ) / (n : ℝ) := by
      intro n _
      push_cast
      ring
    rw [Finset.sum_congr rfl hcast]
    refine harmonic_le B.toNat L ?_
    have h2 : (((2 : ℕ) ^ L : ℕ) : ℤ) = (2 : ℤ) ^ L := by push_cast; ring
    omega

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The plate sum.**  The separation of the plate parameters turns the sum of the plate weights
into a harmonic sum, giving `2^M(1+M)` up to constants. -/
theorem plate_sum_le {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ}
    {B : ℤ} (_hB0 : 0 ≤ B) {L : ℕ} (hBL : B ≤ 2 ^ L) (w : ℝ) :
    ∑ ν ∈ Finset.Icc (0 : ℤ) B, plWt M ν ε t w
      ≤ (2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1) := by
  classical
  set Q : ℝ := (2 : ℝ) ^ (-(M : ℤ)) with hQdef
  set P : ℝ := (2 : ℝ) ^ M with hPdef
  have hQpos : (0 : ℝ) < Q := by rw [hQdef]; positivity
  have hPpos : (0 : ℝ) < P := by rw [hPdef]; positivity
  have hPQ : P * Q = 1 := by
    rw [hPdef, hQdef, show ((2 : ℝ) ^ M) = (2 : ℝ) ^ ((M : ℤ)) by rw [zpow_natCast],
      ← zpow_add₀ (by norm_num : (2 : ℝ) ≠ 0)]
    simp
  have hQinv : 1 / Q = P := by
    field_simp
    linarith [hPQ]
  set S : Finset ℤ := (Finset.Icc (0 : ℤ) B).filter
    (fun ν => |π / 2 - plAng M ν| ≤ 3 / 5) with hSdef
  have hsum : ∑ ν ∈ Finset.Icc (0 : ℤ) B, plWt M ν ε t w
      = ∑ ν ∈ S, 1 / max Q (|plA M ν ε t w|) := by
    rw [hSdef, Finset.sum_filter]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [plWt, hQdef]
  rw [hsum]
  rcases S.eq_empty_or_nonempty with hempty | hne
  · rw [hempty, Finset.sum_empty]
    have h1 : (0 : ℝ) ≤ 10 * ((L : ℝ) + 1) + 1 := by positivity
    positivity
  obtain ⟨ν₀, hν₀S, hν₀min⟩ := S.exists_min_image (fun ν => |plA M ν ε t w|) hne
  -- the angular hypothesis for members of `S`
  have hSang : ∀ ν ∈ S, |π / 2 - plAng M ν| ≤ 3 / 5 := by
    intro ν hν
    rw [hSdef, Finset.mem_filter] at hν
    exact hν.2
  have hSrange : ∀ ν ∈ S, 0 ≤ ν ∧ ν ≤ B := by
    intro ν hν
    rw [hSdef, Finset.mem_filter, Finset.mem_Icc] at hν
    exact hν.1
  -- the term at the minimiser
  have hmin_term : 1 / max Q (|plA M ν₀ ε t w|) ≤ P := by
    rw [← hQinv]
    refine one_div_le_one_div_of_le hQpos (le_max_left _ _)
  -- the other terms
  have hterm : ∀ ν ∈ S.erase ν₀,
      1 / max Q (|plA M ν ε t w|) ≤ 5 * P / |(ν : ℝ) - (ν₀ : ℝ)| := by
    intro ν hν
    have hνS : ν ∈ S := Finset.mem_of_mem_erase hν
    have hne' : ν ≠ ν₀ := Finset.ne_of_mem_erase hν
    have hsep := plA_separated hε ht1 ht2 w (hSang ν hνS) (hSang ν₀ hν₀S)
    have hmin := hν₀min ν hνS
    have habs : |plA M ν ε t w - plA M ν₀ ε t w|
        ≤ |plA M ν ε t w| + |plA M ν₀ ε t w| := abs_sub _ _
    have hd : (1 : ℝ) ≤ |(ν : ℝ) - (ν₀ : ℝ)| := by
      have h1 : ((ν - ν₀ : ℤ) : ℝ) = (ν : ℝ) - (ν₀ : ℝ) := by push_cast; ring
      have h2 : (1 : ℤ) ≤ |ν - ν₀| := by
        rcases lt_or_gt_of_ne (sub_ne_zero.mpr (by exact_mod_cast hne')) with hlt | hgt
        · rw [abs_of_neg hlt]
          omega
        · rw [abs_of_pos hgt]
          omega
      have h3 : ((1 : ℤ) : ℝ) ≤ ((|ν - ν₀| : ℤ) : ℝ) := by exact_mod_cast h2
      rw [Int.cast_abs, h1] at h3
      simpa using h3
    have hlow : 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) ≤ |plA M ν ε t w| := by
      have h4 := hsep
      rw [← hQdef] at h4
      linarith [habs, hmin, h4]
    have hmaxlow : 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) ≤ max Q (|plA M ν ε t w|) :=
      le_trans hlow (le_max_right _ _)
    have hpos : (0 : ℝ) < 1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q) := by
      have h5 : (0 : ℝ) < |(ν : ℝ) - (ν₀ : ℝ)| := lt_of_lt_of_le zero_lt_one hd
      positivity
    have hstep : 1 / max Q (|plA M ν ε t w|)
        ≤ 1 / (1 / 5 * (|(ν : ℝ) - (ν₀ : ℝ)| * Q)) :=
      one_div_le_one_div_of_le hpos hmaxlow
    refine le_trans hstep (le_of_eq ?_)
    rw [← hQinv]
    field_simp
  -- the reindexing
  set N : ℤ := B with hNdef
  have hreindex : ∑ ν ∈ S.erase ν₀, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
      ≤ 2 * (5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ)) := by
    set T : Finset ℤ := S.erase ν₀ with hTdef
    have hTrange : ∀ ν ∈ T, 0 ≤ ν ∧ ν ≤ B ∧ ν ≠ ν₀ := by
      intro ν hν
      refine ⟨(hSrange ν (Finset.mem_of_mem_erase hν)).1,
        (hSrange ν (Finset.mem_of_mem_erase hν)).2, Finset.ne_of_mem_erase hν⟩
    have hν₀range : 0 ≤ ν₀ ∧ ν₀ ≤ B := hSrange ν₀ hν₀S
    have hpart : ∑ ν ∈ T, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        = ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
          + ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|) :=
      (Finset.sum_filter_add_sum_filter_not T _ _).symm
    have hplus : ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        ≤ 5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) := by
      have hinj : ∀ x ∈ T.filter (fun ν => ν₀ < ν), ∀ y ∈ T.filter (fun ν => ν₀ < ν),
          x - ν₀ = y - ν₀ → x = y := by
        intro x _ y _ h
        omega
      have heq : ∀ ν ∈ T.filter (fun ν => ν₀ < ν),
          5 * P / |(ν : ℝ) - (ν₀ : ℝ)| = 5 * P * ((1 : ℝ) / (((ν - ν₀ : ℤ) : ℝ))) := by
        intro ν hν
        rw [Finset.mem_filter] at hν
        have hlt : ν₀ < ν := hν.2
        have hcast : ((ν - ν₀ : ℤ) : ℝ) = (ν : ℝ) - (ν₀ : ℝ) := by push_cast; ring
        have hpos : (0 : ℝ) < (ν : ℝ) - (ν₀ : ℝ) := by
          have : (ν₀ : ℝ) < (ν : ℝ) := by exact_mod_cast hlt
          linarith
        rw [hcast, abs_of_pos hpos]
        field_simp
      rw [Finset.sum_congr rfl heq, ← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have hsubset : (T.filter (fun ν => ν₀ < ν)).image (fun ν => ν - ν₀)
          ⊆ Finset.Icc (1 : ℤ) B := by
        intro k hk
        rw [Finset.mem_image] at hk
        obtain ⟨ν, hν, rfl⟩ := hk
        rw [Finset.mem_filter] at hν
        have h1 := hTrange ν hν.1
        rw [Finset.mem_Icc]
        omega
      calc ∑ ν ∈ T.filter (fun ν => ν₀ < ν), (1 : ℝ) / (((ν - ν₀ : ℤ) : ℝ))
          = ∑ k ∈ (T.filter (fun ν => ν₀ < ν)).image (fun ν => ν - ν₀),
              (1 : ℝ) / ((k : ℤ) : ℝ) := by rw [Finset.sum_image hinj]
        _ ≤ ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / ((k : ℤ) : ℝ) := by
            refine Finset.sum_le_sum_of_subset_of_nonneg hsubset ?_
            intro k hk _
            rw [Finset.mem_Icc] at hk
            have h1 : (1 : ℝ) ≤ ((k : ℤ) : ℝ) := by exact_mod_cast hk.1
            positivity
    have hminus : ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|)
        ≤ 5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) := by
      have hinj : ∀ x ∈ T.filter (fun ν => ¬ (ν₀ < ν)), ∀ y ∈ T.filter (fun ν => ¬ (ν₀ < ν)),
          ν₀ - x = ν₀ - y → x = y := by
        intro x _ y _ h
        omega
      have heq : ∀ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)),
          5 * P / |(ν : ℝ) - (ν₀ : ℝ)| = 5 * P * ((1 : ℝ) / (((ν₀ - ν : ℤ) : ℝ))) := by
        intro ν hν
        rw [Finset.mem_filter] at hν
        have hle : ν < ν₀ := by
          have h1 := hν.2
          have h2 := (hTrange ν hν.1).2.2
          omega
        have hcast : ((ν₀ - ν : ℤ) : ℝ) = (ν₀ : ℝ) - (ν : ℝ) := by push_cast; ring
        have hpos : (0 : ℝ) < (ν₀ : ℝ) - (ν : ℝ) := by
          have : (ν : ℝ) < (ν₀ : ℝ) := by exact_mod_cast hle
          linarith
        rw [hcast, abs_sub_comm, abs_of_pos hpos]
        field_simp
      rw [Finset.sum_congr rfl heq, ← Finset.mul_sum]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have hsubset : (T.filter (fun ν => ¬ (ν₀ < ν))).image (fun ν => ν₀ - ν)
          ⊆ Finset.Icc (1 : ℤ) B := by
        intro k hk
        rw [Finset.mem_image] at hk
        obtain ⟨ν, hν, rfl⟩ := hk
        rw [Finset.mem_filter] at hν
        have h1 := hTrange ν hν.1
        have h2 := hν.2
        rw [Finset.mem_Icc]
        omega
      calc ∑ ν ∈ T.filter (fun ν => ¬ (ν₀ < ν)), (1 : ℝ) / (((ν₀ - ν : ℤ) : ℝ))
          = ∑ k ∈ (T.filter (fun ν => ¬ (ν₀ < ν))).image (fun ν => ν₀ - ν),
              (1 : ℝ) / ((k : ℤ) : ℝ) := by rw [Finset.sum_image hinj]
        _ ≤ ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / ((k : ℤ) : ℝ) := by
            refine Finset.sum_le_sum_of_subset_of_nonneg hsubset ?_
            intro k hk _
            rw [Finset.mem_Icc] at hk
            have h1 : (1 : ℝ) ≤ ((k : ℤ) : ℝ) := by exact_mod_cast hk.1
            positivity
    rw [hpart]
    linarith
  -- assemble
  have hsplit : ∑ ν ∈ S, 1 / max Q (|plA M ν ε t w|)
      = 1 / max Q (|plA M ν₀ ε t w|) + ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|) := by
    rw [← Finset.add_sum_erase S _ hν₀S]
  rw [hsplit]
  have hbound : ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|)
      ≤ ∑ ν ∈ S.erase ν₀, (5 * P / |(ν : ℝ) - (ν₀ : ℝ)|) :=
    Finset.sum_le_sum hterm
  have hharm : ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ) ≤ (L : ℝ) + 1 :=
    harmonic_int_le B L hBL
  have hfinal : 2 * (5 * P * ∑ k ∈ Finset.Icc (1 : ℤ) B, (1 : ℝ) / (k : ℝ))
      ≤ 10 * P * ((L : ℝ) + 1) := by
    have h : (0 : ℝ) ≤ 10 * P := by positivity
    nlinarith [hharm, h]
  have hPnn : (0 : ℝ) ≤ P := le_of_lt hPpos
  calc 1 / max Q (|plA M ν₀ ε t w|) + ∑ ν ∈ S.erase ν₀, 1 / max Q (|plA M ν ε t w|)
      ≤ P + 10 * P * ((L : ℝ) + 1) := by
        linarith [hmin_term, hbound, hreindex, hfinal]
    _ = P * (10 * ((L : ℝ) + 1) + 1) := by ring

/-! ### The endpoint estimate for the kernel -/

/-- The per-plate majorant, in the form needed for the sum over all plates: the pointwise bound is
only claimed for plates in the range, and the bound for the integral is expressed through the plate
weight `plWt`. -/
theorem exists_plate_majorant' {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) (w : ℝ) (ν : ℤ) :
    ∃ G : ℝ → ℝ,
      ((0 ≤ ν ∧ ν ≤ ⌈π * (2 : ℝ) ^ M⌉) → ∀ v : ℝ, ‖kernPlate j ε m t (mk2 w v) M ν‖ ≤ G v)
        ∧ Integrable G ∧ (∀ v : ℝ, 0 ≤ G v)
        ∧ (∫ v : ℝ, G v) ≤ 700000000 * (1 + stC) * B0 * plWt M ν ε t w := by
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  by_cases hrange : 0 ≤ ν ∧ ν ≤ ⌈π * (2 : ℝ) ^ M⌉
  · obtain ⟨G, hG1, hG2, hG3, hG4⟩ :=
      exists_plate_majorant hp hm hε ht1 ht2 hM hQ hMj hMj2 hrange.1 hrange.2 w
    exact ⟨G, fun _ => hG1, hG2, hG3, hG4⟩
  · refine ⟨fun _ => 0, fun hc => absurd hc hrange, integrable_zero _ _ _, fun _ => le_refl 0, ?_⟩
    rw [integral_zero]
    have h := plWt_nonneg M ν ε t w
    positivity

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The endpoint estimate for the kernel.**  For every `w`, the `L¹` norm of the kernel in the
second variable is at most `C(1+stC)B₀ 2^M(1+M)`, i.e. `2^{j/2}` up to a factor `j`. -/
theorem lintegral_norm_kern_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L) (w : ℝ) :
    (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v)‖ₑ)
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) := by
  classical
  set B : ℤ := ⌈π * (2 : ℝ) ^ M⌉ with hBdef
  have hBnn : (0 : ℤ) ≤ B := by
    rw [hBdef]
    refine Int.ceil_nonneg ?_
    positivity
  have hB0 : (0 : ℝ) ≤ B0 := hp.nonneg
  have hstCnn : (0 : ℝ) ≤ stC := stC_nonneg
  choose G hG1 hG2 hG3 hG4 using
    exists_plate_majorant' hp hm hε ht1 ht2 hM hQ hMj hMj2 w
  -- the pointwise bound
  have hpt : ∀ v : ℝ, ‖kern j ε m t (mk2 w v)‖ ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v := by
    intro v
    rw [kern_eq_sum_plates hm ε t (mk2 w v) hM, ← hBdef]
    refine le_trans (norm_sum_le _ _) ?_
    refine Finset.sum_le_sum fun ν hν => ?_
    rw [Finset.mem_Icc] at hν
    exact hG1 ν ⟨hν.1, hν.2⟩ v
  -- integrability and nonnegativity of the total majorant
  have hGtotint : Integrable (fun v : ℝ => ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) :=
    integrable_finsetSum _ fun ν _ => hG2 ν
  have hGtotnn : (0 : ℝ → ℝ) ≤ᵐ[volume] fun v : ℝ => ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v := by
    filter_upwards with v
    change (0 : ℝ) ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v
    exact Finset.sum_nonneg fun ν _ => hG3 ν v
  -- the sum of the integrals
  have hsumint : (∫ v : ℝ, ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v)
      = ∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v :=
    integral_finsetSum _ fun ν _ => hG2 ν
  have hsumbd : (∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v)
      ≤ 700000000 * (1 + stC) * B0 * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) := by
    have hstep : (∑ ν ∈ Finset.Icc (0 : ℤ) B, ∫ v : ℝ, G ν v)
        ≤ ∑ ν ∈ Finset.Icc (0 : ℤ) B, 700000000 * (1 + stC) * B0 * plWt M ν ε t w :=
      Finset.sum_le_sum fun ν _ => hG4 ν
    refine le_trans hstep ?_
    rw [← Finset.mul_sum]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact plate_sum_le hε ht1 ht2 hBnn hBL w
  calc (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v)‖ₑ)
      ≤ ∫⁻ v : ℝ, ENNReal.ofReal (∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) := by
        refine lintegral_mono fun v => ?_
        rw [← ofReal_norm]
        exact ENNReal.ofReal_le_ofReal (hpt v)
    _ = ENNReal.ofReal (∫ v : ℝ, ∑ ν ∈ Finset.Icc (0 : ℤ) B, G ν v) :=
        (ofReal_integral_eq_lintegral_ofReal hGtotint hGtotnn).symm
    _ ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) := by
        refine ENNReal.ofReal_le_ofReal ?_
        rw [hsumint]
        exact hsumbd


end KernelPlates
