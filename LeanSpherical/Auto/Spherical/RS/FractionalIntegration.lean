  set gt : ℕ → Pl2 → ℂ := fun n q => cutBoth δ R q * g n q with hgtdef
  have hgtsm : ∀ n, ContDiff ℝ (↑(⊤ : ℕ∞)) (gt n) :=
    fun n => (contDiff_cutBoth δ R).mul (hgsm n)
  have hgtcs : ∀ n, HasCompactSupport (gt n) := by
    intro n
    exact HasCompactSupport.mul_right (hasCompactSupport_cutBoth hR)
  set S : ℕ → SchwartzMap Pl2 ℂ := fun n => (hgtcs n).toSchwartzMap (hgtsm n) with hSdef
  have hScoe : ∀ n, ((S n : Pl2 → ℂ)) = gt n := fun n => rfl
  have hgtint : ∀ n, Integrable (gt n) (volume : Measure Pl2) := by
    intro n
    rw [← hScoe n]
    exact (S n).integrable
  have hgtmeas : ∀ n, Measurable (gt n) := fun n => (hgtsm n).continuous.measurable
  -- the cut-off does not change `G`
