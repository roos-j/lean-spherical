/-- **The `L^p` estimate of §3.**  This is the conclusion of the interpolation between
Proposition 3.1 and the single-kernel endpoint: the bilinear operator `𝒯_j` maps the
interpolated space into `ℓ^p L^p` over the finite set of dilations. -/
theorem lintegral_pow_Top2_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ p) ^ (1 / p)
      ≤ (4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
              * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
            * normNpp p gam F) ^ (1 / p)
          * (ENNReal.ofReal (700000000 * (1 + stC) * B0
              * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F)
            ^ (1 - 2 / p) := by
  refine lintegral_pow_le_of_pairing_le hpgt Efin
    (h := fun t x => Top2 j ε m t F x) (fun t => measurable_Top2 hm ε t hF) ?_
  intro φ hφm Cφ R hφb hφs
  exact enorm_pairT_le_interp hpol hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1
    hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hpgt hF hfib hNfin hφm hφb hφs

/-! ### One-dimensional fractional integration: the interpolated norm of a tensor product -/

/-- The tensor product of two functions on the plane, as a function on `ℝ⁴`. -/
def tensF (f g : Pl → ℂ) (q : Pl2) : ℂ := f (prjL q) * g (prjR q)

@[simp] theorem tensF_pr (f g : Pl → ℂ) (y z : Pl) : tensF f g (pr y z) = f y * g z := rfl

theorem tensF_eq_tens (f g : SchwartzMap Pl ℂ) :
    tensF (f : Pl → ℂ) (g : Pl → ℂ) = (tens f g : Pl2 → ℂ) := rfl

theorem measurable_tensF {f g : Pl → ℂ} (hf : Measurable f) (hg : Measurable g) :
    Measurable (tensF f g) :=
  (hf.comp prjL.continuous.measurable).mul (hg.comp prjR.continuous.measurable)

/-- The fibre `L^p` profile of a function on the plane. -/
noncomputable def fibP (p : ℝ) (f : Pl → ℂ) (y1 : ℝ) : ℝ≥0∞ :=
  (∫⁻ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p) ^ (1 / p)

theorem measurable_fibP {p : ℝ} {f : Pl → ℂ} (hf : Measurable f) : Measurable (fibP p f) := by
  have hjoint : Measurable fun w : ℝ × ℝ => ‖f (mk2 w.1 w.2)‖ₑ ^ p :=
    ((hf.comp continuous_mk2.measurable).enorm).pow_const _
  have h1 : Measurable fun y1 : ℝ => ∫⁻ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p :=
    hjoint.lintegral_prod_right'
  change Measurable fun y1 : ℝ => (∫⁻ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p) ^ (1 / p)
  exact h1.pow_const _

theorem fibProf_tensF {p : ℝ} (hp : 0 < p) {f g : Pl → ℂ} (hf : Measurable f)
    (hg : Measurable g) (y1 z1 : ℝ) :
    fibProf p (tensF f g) y1 z1 = fibP p f y1 * fibP p g z1 := by
  have hfy : Measurable fun y2 : ℝ => ‖f (mk2 y1 y2)‖ₑ ^ p :=
    ((hf.comp (continuous_mk2.measurable.comp
      (measurable_const.prodMk measurable_id))).enorm).pow_const _
  have hgz : Measurable fun z2 : ℝ => ‖g (mk2 z1 z2)‖ₑ ^ p :=
    ((hg.comp (continuous_mk2.measurable.comp
      (measurable_const.prodMk measurable_id))).enorm).pow_const _
  have hpt : ∀ y2 z2 : ℝ, ‖tensF f g (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p
      = ‖f (mk2 y1 y2)‖ₑ ^ p * ‖g (mk2 z1 z2)‖ₑ ^ p := by
    intro y2 z2
    rw [tensF_pr, enorm_mul, ENNReal.mul_rpow_of_nonneg _ _ hp.le]
  have hz : ∀ y2 : ℝ, (∫⁻ z2 : ℝ, ‖tensF f g (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p)
      = ‖f (mk2 y1 y2)‖ₑ ^ p * ∫⁻ z2 : ℝ, ‖g (mk2 z1 z2)‖ₑ ^ p := by
    intro y2
    rw [lintegral_congr (hpt y2), lintegral_const_mul _ hgz]
  rw [fibProf, fibP, fibP, lintegral_congr hz, lintegral_mul_const _ hfy,
    ENNReal.mul_rpow_of_nonneg _ _ (by positivity : (0:ℝ) ≤ 1 / p)]

theorem lintegral_fibP_pow {p : ℝ} (hp : 0 < p) {f : Pl → ℂ} (hf : Measurable f) :
    (∫⁻ y1 : ℝ, (fibP p f y1) ^ p) = ∫⁻ x : Pl, ‖f x‖ₑ ^ p := by
  have h1 : ∀ y1 : ℝ, (fibP p f y1) ^ p = ∫⁻ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p := by
    intro y1
    rw [fibP, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne', ENNReal.rpow_one]
  rw [lintegral_congr h1,
    ← lintegral_Pl_eq_prod (fun x : Pl => ‖f x‖ₑ ^ p) (hf.enorm.pow_const _)]

