      prop31_Top2 hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2 hNa hM
        hcard hcount (S n)
    rw [hScoe n] at h1
    exact le_trans h1 (mul_le_mul' (le_refl _) (hwt n))
