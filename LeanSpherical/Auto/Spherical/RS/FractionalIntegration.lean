/-- **The `L¹_{y₁}L^∞_{y₂} → L^∞` endpoint of §3.**  The kernel estimate gives the operator bound
with the constant `C(1+stC)B₀2^M(1+M)`, i.e. `2^{j/2}` up to a factor `j`. -/
theorem enorm_TopS_le_mix {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    (f : SchwartzMap Pl ℂ) (x : Pl) :
    ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) * mixL1Linf (f : Pl → ℂ) := by
  set C : ℝ := 700000000 * (1 + stC) * B0
    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) with hCdef
  set S : ℝ → ℝ≥0∞ := fun y => ⨆ v : ℝ, ‖(f : Pl → ℂ) (mk2 y v)‖ₑ with hSdef
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hFcont : Continuous fun y : Pl => kern j ε m t y * (f : Pl → ℂ) (x - y) :=
    hkc.mul (f.continuous.comp (continuous_const.sub continuous_id))
  have hFmeas : Measurable fun y : Pl => ‖kern j ε m t y * (f : Pl → ℂ) (x - y)‖ₑ :=
    hFcont.enorm.measurable
  have hkmeas : ∀ w : ℝ, Measurable fun v : ℝ => ‖kern j ε m t (mk2 w v)‖ₑ := by
    intro w
    refine (Continuous.enorm ?_).measurable
    exact hkc.comp (continuous_mk2.comp (continuous_const.prodMk continuous_id))
  have hinner : ∀ w : ℝ,
      (∫⁻ v : ℝ, ‖kern j ε m t (mk2 w v) * (f : Pl → ℂ) (x - mk2 w v)‖ₑ)
        ≤ ENNReal.ofReal C * S (x 0 - w) := by
    intro w
    have hstep : ∀ v : ℝ, ‖kern j ε m t (mk2 w v) * (f : Pl → ℂ) (x - mk2 w v)‖ₑ
