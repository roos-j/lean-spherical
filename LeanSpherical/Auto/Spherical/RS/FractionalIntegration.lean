-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Holomorphy of the pairing integrand in the parameter**, for a single dilation `t`, again
by Morera's theorem. -/
theorem differentiableOn_integral_Top2_phifam {j : ℕ} {m : ℝ → Pl → ℂ}
    {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : Measurable (φ t)) {Cφ R : ℝ} (hφb : ∀ x : Pl, ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ x : Pl, R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ} (hUvr : ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr) :
    DifferentiableOn ℂ
      (fun ζ : ℂ => ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
      (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
  classical
  have hopen : IsOpen (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) :=
    isOpen_Ioo.preimage Complex.continuous_re
  have hmajint : Integrable (majP p φ Uvr t) (volume : Measure Pl) :=
    integrable_majP hpgt hφm hφb hφs Uvr
  set g : Pl → ℂ → ℂ := fun x ζ =>
    Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x with hg
  have hgdiff : ∀ x : Pl, DifferentiableOn ℂ (g x) (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
    intro x
    rw [hg]
    exact (differentiableOn_Top2_Ffam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt
      hF hfib hNfin x).mul ((differentiable_phifam p φ t x).differentiableOn)
  have hjoint : ∀ σ : ℝ → ℂ, Measurable σ → Measurable fun v : ℝ × Pl => g v.2 (σ v.1) := by
    intro σ hσ
    rw [hg]
    have h1 : Measurable fun v : ℝ × Pl => Top2 j ε m t (Ffam p gam F (σ v.1)) v.2 := by
      have hfun : (fun v : ℝ × Pl => Top2 j ε m t (Ffam p gam F (σ v.1)) v.2)
          = (fun u : ℂ × Pl => Top2 j ε m t (Ffam p gam F u.1) u.2)
            ∘ (fun v : ℝ × Pl => ((σ v.1, v.2) : ℂ × Pl)) := rfl
      rw [hfun]
      exact (measurable_Top2_Ffam_uncurry hm ε t p gam hF).comp
        ((hσ.comp measurable_fst).prodMk measurable_snd)
    have h2 : Measurable fun v : ℝ × Pl => phifam p φ (σ v.1) t v.2 := by
      have hfun : (fun v : ℝ × Pl => phifam p φ (σ v.1) t v.2)
          = (fun u : ℂ × Pl => phifam p φ u.1 t u.2)
            ∘ (fun v : ℝ × Pl => ((σ v.1, v.2) : ℂ × Pl)) := rfl
      rw [hfun]
      exact (measurable_phifam_uncurry (p := p) (φ := φ) (t := t) hφm).comp
        ((hσ.comp measurable_fst).prodMk measurable_snd)
    exact h1.mul h2
  have hbdσ : ∀ σ : ℝ → ℂ, ∀ S : Set ℝ, (∀ s ∈ S, 0 ≤ (σ s).re ∧ (σ s).re ≤ 1) →
      ∀ s ∈ S, ∀ x : Pl, ‖g x (σ s)‖ ≤ majP p φ Uvr t x := by
    intro σ S hS s hs x
    rw [hg]
    exact norm_Top2_phifam_le_majP hpgt (hS s hs).1 (hS s hs).2
      (hUvr (σ s) ⟨(hS s hs).1, (hS s hs).2⟩) x
  -- the wedge integral commutes with the integral in the output variable
  have hwedge : ∀ z w : ℂ, Complex.Rectangle z w ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 →
      Complex.wedgeIntegral z w
          (fun ζ : ℂ => ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
        = ∫ x : Pl, Complex.wedgeIntegral z w (g x) := by
    intro z w hzw
    have hre : ∀ s ∈ Set.uIcc z.re w.re, s ∈ Set.Ioo (0 : ℝ) 1 := by
      intro s hs
      have hmem : ((s : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simpa using hs
        · simp
      have h := hzw hmem
      simpa using h
    have hwmem : w.re ∈ Set.Ioo (0 : ℝ) 1 := by
      have hmem : ((w.re : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simp
        · simp
      have h := hzw hmem
      simpa using h
    set σ : ℝ → ℂ := fun s => (s : ℂ) + z.im * Complex.I with hσdef
    set τ : ℝ → ℂ := fun y => (w.re : ℂ) + y * Complex.I with hτdef
    have hσmeas : Measurable σ := by
      rw [hσdef]
      exact (Complex.measurable_ofReal).add measurable_const
    have hτmeas : Measurable τ := by
      rw [hτdef]
      exact measurable_const.add (Complex.measurable_ofReal.mul measurable_const)
    have hσstrip : ∀ s ∈ Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re,
        0 ≤ (σ s).re ∧ (σ s).re ≤ 1 := by
      intro s hs
      have hsu : s ∈ Set.uIcc z.re w.re := by
        rcases hs with h | h
        · exact Set.mem_uIcc_of_le (le_of_lt h.1) h.2
        · exact Set.mem_uIcc_of_ge (le_of_lt h.1) h.2
      have h := hre s hsu
      have hre' : (σ s).re = s := by
        rw [hσdef]
        simp
      rw [hre']
      exact ⟨le_of_lt h.1, le_of_lt h.2⟩
    have hτstrip : ∀ y ∈ Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im,
        0 ≤ (τ y).re ∧ (τ y).re ≤ 1 := by
      intro y _
      have hre' : (τ y).re = w.re := by
        rw [hτdef]
        simp
      rw [hre']
      exact ⟨le_of_lt hwmem.1, le_of_lt hwmem.2⟩
    have hswap1 : (∫ s in z.re..w.re,
          ∫ x : Pl, Top2 j ε m t (Ffam p gam F (σ s)) x * phifam p φ (σ s) t x)
        = ∫ x : Pl, ∫ s in z.re..w.re, g x (σ s) := by
      refine intervalIntegral_integral_swap_gen z.re w.re (hjoint σ hσmeas)
        (bound := majP p φ Uvr t) ?_ hmajint
      intro s hs x
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs x
    have hswap2 : (∫ y in z.im..w.im,
          ∫ x : Pl, Top2 j ε m t (Ffam p gam F (τ y)) x * phifam p φ (τ y) t x)
        = ∫ x : Pl, ∫ y in z.im..w.im, g x (τ y) := by
      refine intervalIntegral_integral_swap_gen z.im w.im (hjoint τ hτmeas)
        (bound := majP p φ Uvr t) ?_ hmajint
      intro y hy x
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy x
    have hint1 : Integrable (fun x : Pl => ∫ s in z.re..w.re, g x (σ s))
        (volume : Measure Pl) := by
      refine integrable_intervalIntegral_gen z.re w.re (hjoint σ hσmeas)
        (bound := majP p φ Uvr t) ?_ hmajint
      intro s hs x
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs x
    have hint2 : Integrable (fun x : Pl => ∫ y in z.im..w.im, g x (τ y))
        (volume : Measure Pl) := by
      refine integrable_intervalIntegral_gen z.im w.im (hjoint τ hτmeas)
        (bound := majP p φ Uvr t) ?_ hmajint
      intro y hy x
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy x
    have hσapp : ∀ s : ℝ, σ s = (s : ℂ) + z.im * Complex.I := fun s => rfl
    have hτapp : ∀ y : ℝ, τ y = (w.re : ℂ) + y * Complex.I := fun y => rfl
    simp only [Complex.wedgeIntegral, ← hσapp, ← hτapp]
    rw [hswap1, hswap2,
      ← integral_smul Complex.I (fun x : Pl => ∫ y in z.im..w.im, g x (τ y))]
    exact (integral_add hint1 (hint2.smul Complex.I)).symm
  rw [← Complex.isConservativeOn_and_continuousOn_iff_isDifferentiableOn hopen]
  refine ⟨?_, ?_⟩
  · intro z w hzw
    have hrecteq : Complex.Rectangle w z = Complex.Rectangle z w := by
      rw [Complex.Rectangle, Complex.Rectangle, Set.uIcc_comm w.re z.re,
        Set.uIcc_comm w.im z.im]
    have hrect : Complex.Rectangle w z ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 := by
      rw [hrecteq]
      exact hzw
    rw [hwedge z w hzw, hwedge w z hrect, ← integral_neg]
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    exact (hgdiff x).isConservativeOn z w hzw
  · refine (continuousOn_integral_Top2_phifam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1
      hgam2 hpgt hF hfib hNfin hφm hφb hφs hUvr).mono ?_
    intro ζ hζ
    exact ⟨le_of_lt hζ.1, le_of_lt hζ.2⟩

/-! ### The pairing of the two families is continuous, holomorphic and bounded -/

theorem continuousOn_pairT_fam {j : ℕ} {m : ℝ → Pl → ℂ}
    {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t)) {Cφ R : ℝ}
    (hφb : ∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ → ℝ} (hUvr : ∀ t ∈ Efin, ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr t) :
    ContinuousOn (fun ζ : ℂ => pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)) clStrip := by
  have heq : (fun ζ : ℂ => pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ))
      = fun ζ : ℂ => ∑ t ∈ Efin,
        ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x := rfl
  rw [heq]
  refine continuousOn_finsetSum Efin fun t ht => ?_
  exact continuousOn_integral_Top2_phifam hpol hm hε (hEfin t ht).1 (hEfin t ht).2 hMk hQ hMj
    hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin (hφm t) (hφb t) (hφs t) (hUvr t ht)

theorem differentiableOn_pairT_fam {j : ℕ} {m : ℝ → Pl → ℂ}
    {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t)) {Cφ R : ℝ}
    (hφb : ∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ → ℝ} (hUvr : ∀ t ∈ Efin, ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr t) :
    DifferentiableOn ℂ (fun ζ : ℂ => pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ))
      (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
  have heq : (fun ζ : ℂ => pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ))
      = fun ζ : ℂ => ∑ t ∈ Efin,
        ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x := rfl
  rw [heq]
  refine DifferentiableOn.fun_sum fun t ht => ?_
  exact differentiableOn_integral_Top2_phifam hpol hm hε (hEfin t ht).1 (hEfin t ht).2 hMk hQ
    hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin (hφm t) (hφb t) (hφs t) (hUvr t ht)

/-- **The pairing of the two families is bounded on the closed strip.** -/
theorem norm_pairT_fam_le {j : ℕ} {m : ℝ → Pl → ℂ} {ε : ℝ} (Efin : Finset ℝ)
    {gam p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ}
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t)) {Cφ R : ℝ}
    (hφb : ∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ → ℝ} (hUvr : ∀ t ∈ Efin, ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr t)
    {ζ : ℂ} (hζ : ζ ∈ clStrip) :
    ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖
      ≤ ∑ t ∈ Efin, ∫ x : Pl, majP p φ (Uvr t) t x := by
  have heq : pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)
      = ∑ t ∈ Efin, ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x := rfl
  rw [heq]
  refine le_trans (norm_sum_le _ _) ?_
  refine Finset.sum_le_sum fun t ht => ?_
  refine norm_integral_le_of_norm_le (integrable_majP hpgt (hφm t) (hφb t) (hφs t) (Uvr t)) ?_
  filter_upwards with x
  exact norm_Top2_phifam_le_majP hpgt hζ.1 hζ.2 (hUvr t ht ζ hζ) x

/-! ### The family reproduces the data almost everywhere at `θ = 1 - 2/p` -/

theorem sepFst_eq_bs_sub (q : Pl2) : sepFst q = bs1 q - bs2 q := by
  conv_lhs => rw [← pr_bs_fb q]
  rw [sepFst_pr_mk2]

theorem isClosed_clStrip : IsClosed clStrip := by
  have h : clStrip = Complex.re ⁻¹' Set.Icc (0 : ℝ) 1 := by
    ext ζ
    simp only [clStrip, Set.mem_setOf_eq, Set.mem_preimage, Set.mem_Icc]
  rw [h]
  exact isClosed_Icc.preimage Complex.continuous_re

theorem closure_strip_subset_clStrip :
    closure (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) ⊆ clStrip :=
  closure_minimal (fun _ζ hζ => ⟨le_of_lt hζ.1, le_of_lt hζ.2⟩) isClosed_clStrip

/-- If the fibre profile over `(y₁,z₁)` vanishes, then so does the fibre integral of `|F|`. -/
theorem lintegral_fibre_enorm_eq_zero {p : ℝ} (hp : 0 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    {y1 z1 : ℝ} (h0 : fibProf p F y1 z1 = 0) :
    (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ) = 0 := by
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have hmz : ∀ y2 : ℝ, Measurable fun z2 : ℝ => ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
    intro y2
    refine (hF.comp (hprmeas.comp ?_)).enorm
    exact measurable_const.prodMk (continuous_mk2.measurable.comp
      (measurable_const.prodMk measurable_id))
  have hjoint : Measurable fun w : ℝ × ℝ => ‖F (pr (mk2 y1 w.1) (mk2 z1 w.2))‖ₑ := by
    refine (hF.comp (hprmeas.comp ?_)).enorm
    exact (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_fst)).prodMk
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_snd))
  have hAzero : (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p) = 0 := by
    rw [fibProf] at h0
    rcases ENNReal.rpow_eq_zero_iff.mp h0 with h | h
    · exact h.1
    · exact absurd h.2 (not_lt.mpr (le_of_lt (div_pos one_pos hp)))
  have hinnermeas : Measurable fun y2 : ℝ => ∫⁻ z2 : ℝ,
      ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := (hjoint.pow_const p).lintegral_prod_right'
  have hae1 : ∀ᵐ y2 : ℝ, (∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p) = 0 := by
    have h := (lintegral_eq_zero_iff hinnermeas).mp hAzero
    filter_upwards [h] with y2 hy2
    simpa using hy2
  have hae2 : ∀ᵐ y2 : ℝ, (∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ) = 0 := by
    filter_upwards [hae1] with y2 hy2
    have h := (lintegral_eq_zero_iff ((hmz y2).pow_const p)).mp hy2
    refine (lintegral_eq_zero_iff (hmz y2)).mpr ?_
    filter_upwards [h] with z2 hz2
    have hz : ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p = 0 := by simpa using hz2
    rcases ENNReal.rpow_eq_zero_iff.mp hz with hc | hc
    · simpa using hc.1
    · exact absurd hc.2 (not_lt.mpr hp.le)
  have hmeasout : Measurable fun y2 : ℝ => ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ :=
    hjoint.lintegral_prod_right'
  exact (lintegral_eq_zero_iff hmeasout).mpr hae2

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The Calderón family reproduces the data at `θ = 1 - 2/p`, almost everywhere.** -/
theorem ae_Ffam_at_theta {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    (hF : Measurable F) (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) :
    ∀ᵐ q : Pl2, Ffam p gam F (((1 - 2 / p : ℝ)) : ℂ) q = F q := by
  classical
  have hppos : (0 : ℝ) < p := by linarith
  have hdiag : ∀ᵐ q : Pl2, sepFst q ≠ 0 := by
    rw [Filter.eventually_iff_exists_mem]
    refine ⟨{q : Pl2 | sepFst q = 0}ᶜ, ?_, fun q hq => hq⟩
    rw [mem_ae_iff, compl_compl]
    exact volume_sepFst_eq_zero
  set Gbad : Pl2 → ℝ≥0∞ := fun q =>
    if fibProf p F (bs1 q) (bs2 q) = 0 then ‖F q‖ₑ else 0 with hGbad
  have hfibq : Measurable fun q : Pl2 => fibProf p F (bs1 q) (bs2 q) := by
    have hfun : (fun q : Pl2 => fibProf p F (bs1 q) (bs2 q))
        = (fun a : ℝ × ℝ => fibProf p F a.1 a.2)
          ∘ (fun q : Pl2 => ((bs1 q, bs2 q) : ℝ × ℝ)) := rfl
    rw [hfun]
    exact (measurable_fibProf hF).comp (measurable_bs1.prodMk measurable_bs2)
  have hS : MeasurableSet {q : Pl2 | fibProf p F (bs1 q) (bs2 q) = 0} := by
    have hpre : {q : Pl2 | fibProf p F (bs1 q) (bs2 q) = 0}
        = (fun q : Pl2 => fibProf p F (bs1 q) (bs2 q)) ⁻¹' {0} := rfl
    rw [hpre]
    exact hfibq (measurableSet_singleton 0)
  have hGmeas : Measurable Gbad := by
    rw [hGbad]
    exact Measurable.ite hS hF.enorm measurable_const
  have hinner : ∀ y1 z1 : ℝ,
      (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, Gbad (pr (mk2 y1 y2) (mk2 z1 z2))) = 0 := by
    intro y1 z1
    by_cases hz : fibProf p F y1 z1 = 0
    · have hpt : (fun y2 : ℝ => ∫⁻ z2 : ℝ, Gbad (pr (mk2 y1 y2) (mk2 z1 z2)))
          = fun y2 : ℝ => ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
        funext y2
        refine lintegral_congr fun z2 => ?_
        change (if fibProf p F (bs1 (pr (mk2 y1 y2) (mk2 z1 z2)))
              (bs2 (pr (mk2 y1 y2) (mk2 z1 z2))) = 0 then
            ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ else 0)
          = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        rw [bs1_pr_mk2, bs2_pr_mk2, if_pos hz]
      rw [hpt]
      exact lintegral_fibre_enorm_eq_zero hppos hF hz
    · have hpt : ∀ y2 z2 : ℝ, Gbad (pr (mk2 y1 y2) (mk2 z1 z2)) = 0 := by
        intro y2 z2
        change (if fibProf p F (bs1 (pr (mk2 y1 y2) (mk2 z1 z2)))
              (bs2 (pr (mk2 y1 y2) (mk2 z1 z2))) = 0 then
            ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ else 0) = 0
        rw [bs1_pr_mk2, bs2_pr_mk2, if_neg hz]
      simp only [hpt, lintegral_zero]
  have hGzero : (∫⁻ q : Pl2, Gbad q) = 0 := by
    rw [lintegral_Pl2_iter_base hGmeas]
    simp only [hinner, lintegral_zero]
  have hGae : ∀ᵐ q : Pl2, Gbad q = 0 := by
    have h := (lintegral_eq_zero_iff hGmeas).mp hGzero
    filter_upwards [h] with q hq
    simpa using hq
  filter_upwards [hdiag, hGae] with q hq1 hq2
  by_cases hz : fibProf p F (bs1 q) (bs2 q) = 0
  · have hFq : F q = 0 := by
      have h : ‖F q‖ₑ = 0 := by
        have h2 : (if fibProf p F (bs1 q) (bs2 q) = 0 then ‖F q‖ₑ else 0) = 0 := hq2
        rw [if_pos hz] at h2
        exact h2
      simpa using h
    rw [Ffam_eq_zero_of_degenerate hp hgam1 F _ (Or.inl hz), hFq]
  · have hne : bs1 q ≠ bs2 q := by
      intro hc
      exact hq1 (by rw [sepFst_eq_bs_sub, hc, sub_self])
    exact Ffam_at_theta hp hgam1 hne (hfib _ _) hz

theorem Top2_congr_ae {j : ℕ} {ε t : ℝ} {m : ℝ → Pl → ℂ} {F G : Pl2 → ℂ}
    (h : ∀ᵐ q : Pl2, F q = G q) (x : Pl) : Top2 j ε m t F x = Top2 j ε m t G x := by
  rw [Top2, Top2]
  refine integral_congr_ae ?_
  filter_upwards [h] with q hq
  rw [hq]

/-! ### The analytic interpolation of §3, in pairing form -/

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The analytic interpolation of §3.**  The pairing of `𝒯_jF` with a bounded, compactly
supported test function is at most the geometric mean of the two edge bounds, with the exponent
`θ = 1 - 2/p` of the Calderón couple. -/
theorem norm_pairT_interp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t)) {Cφ R : ℝ}
    (hφb : ∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ → ℝ} (hUvr : ∀ t ∈ Efin, ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr t)
    {M0 M1 : ℝ} (hM0 : 0 < M0) (hM1 : 0 < M1)
    (h0 : ∀ ζ : ℂ, ζ.re = 0 → ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ M0)
    (h1 : ∀ ζ : ℂ, ζ.re = 1 → ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ M1) :
    ‖pairT j ε m Efin F φ‖ ≤ M0 ^ (2 / p) * M1 ^ (1 - 2 / p) := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := by positivity
  have h2p1 : 2 / p ≤ 1 := by
    rw [div_le_one hppos]
    linarith
  have hθ0 : (0 : ℝ) ≤ 1 - 2 / p := by linarith
  have hθ1 : (1 : ℝ) - 2 / p ≤ 1 := by linarith
  have hd : DiffContOnCl ℂ
      (fun ζ : ℂ => pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ))
      (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
    refine ⟨differentiableOn_pairT_fam hpol hm hε Efin hEfin hMk hQ hMj hMj2 hBL hgam1 hgam2
      hpgt hF hfib hNfin hφm hφb hφs hUvr, ?_⟩
    refine (continuousOn_pairT_fam hpol hm hε Efin hEfin hMk hQ hMj hMj2 hBL hgam1 hgam2
      hpgt hF hfib hNfin hφm hφb hφs hUvr).mono ?_
    exact closure_strip_subset_clStrip
  have hbdd : ∃ C : ℝ, ∀ z : ℂ, 0 ≤ z.re → z.re ≤ 1 →
      ‖pairT j ε m Efin (Ffam p gam F z) (phifam p φ z)‖ ≤ C :=
    ⟨∑ t ∈ Efin, ∫ x : Pl, majP p φ (Uvr t) t x, fun z hz1 hz2 =>
      norm_pairT_fam_le Efin hpgt hφm hφb hφs hUvr ⟨hz1, hz2⟩⟩
  have hkey := three_lines (θ := 1 - 2 / p) hθ0 hθ1 hM0 hM1 hd hbdd h0 h1
  have hrepr : pairT j ε m Efin (Ffam p gam F (((1 - 2 / p : ℝ)) : ℂ))
        (phifam p φ (((1 - 2 / p : ℝ)) : ℂ))
      = pairT j ε m Efin F φ := by
    rw [pairT, pairT]
    refine Finset.sum_congr rfl fun t ht => ?_
    refine integral_congr_ae (Filter.Eventually.of_forall fun x => ?_)
    change Top2 j ε m t (Ffam p gam F (((1 - 2 / p : ℝ)) : ℂ)) x
        * phifam p φ (((1 - 2 / p : ℝ)) : ℂ) t x = Top2 j ε m t F x * φ t x
    rw [Top2_congr_ae (ae_Ffam_at_theta hpgt hgam1 hF hfib) x, phifam_at_theta hpgt φ t x]
  rw [hrepr] at hkey
  have hexp : (1 : ℝ) - (1 - 2 / p) = 2 / p := by ring
  rw [hexp] at hkey
  exact hkey

/-! ### Duality: from the pairing bound to the `ℓ^pL^p` bound -/

open Classical in
/-- The truncated dual function of the duality argument:
`φ = χ·conj(h)·|h|^{p-2}`, truncated to `{‖x‖ ≤ n} ∩ {|h| ≤ n}`. -/
noncomputable def dualTr (p : ℝ) (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) : ℂ :=
  if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
    (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0

open Classical in
/-- The truncated `p`-th power of `|h|`. -/
noncomputable def powTr (p : ℝ) (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) : ℝ :=
  if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0

theorem sq_mul_rpow_sub_two {a p : ℝ} (ha : 0 ≤ a) (hp : 2 < p) :
    a ^ 2 * a ^ (p - 2) = a ^ p := by
  rcases eq_or_lt_of_le ha with h | hpos
  · have h0 : a = 0 := h.symm
    rw [h0, Real.zero_rpow (by linarith : p ≠ 0)]
    simp
  · rw [← Real.rpow_natCast a 2, ← Real.rpow_add hpos]
    norm_num

theorem mul_rpow_sub_two {a p : ℝ} (ha : 0 ≤ a) (hp : 2 < p) :
    a * a ^ (p - 2) = a ^ (p - 1) := by
  rcases eq_or_lt_of_le ha with h | hpos
  · have h0 : a = 0 := h.symm
    rw [h0, Real.zero_rpow (by linarith : p - 1 ≠ 0), zero_mul]
  · have h1 : a * a ^ (p - 2) = a ^ (1 : ℝ) * a ^ (p - 2) := by rw [Real.rpow_one]
    rw [h1, ← Real.rpow_add hpos]
    congr 1
    ring

theorem measurableSet_trunc {n : ℕ} {g : Pl → ℂ} (hg : Measurable g) :
    MeasurableSet {x : Pl | ‖x‖ ≤ (n : ℝ) ∧ ‖g x‖ ≤ (n : ℝ)} :=
  (measurableSet_le measurable_norm measurable_const).inter
    (measurableSet_le hg.norm measurable_const)

theorem measurable_dualTr {p : ℝ} (hp : 2 ≤ p) {n : ℕ} {h : ℝ → Pl → ℂ} {t : ℝ}
    (hh : Measurable (h t)) : Measurable (dualTr p n h t) := by
  classical
  change Measurable fun x : Pl => if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
      (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0
  refine Measurable.ite (measurableSet_trunc hh) ?_ measurable_const
  refine (Complex.continuous_conj.measurable.comp hh).mul ?_
  exact Complex.measurable_ofReal.comp
    ((Real.continuous_rpow_const (by linarith : (0:ℝ) ≤ p - 2)).measurable.comp hh.norm)

theorem measurable_powTr {p : ℝ} (hp : 2 ≤ p) {n : ℕ} {h : ℝ → Pl → ℂ} {t : ℝ}
    (hh : Measurable (h t)) : Measurable (powTr p n h t) := by
  classical
  change Measurable fun x : Pl =>
    if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0
  refine Measurable.ite (measurableSet_trunc hh) ?_ measurable_const
  exact (Real.continuous_rpow_const (by linarith : (0:ℝ) ≤ p)).measurable.comp hh.norm

theorem powTr_nonneg {p : ℝ} (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    0 ≤ powTr p n h t x := by
  classical
  change 0 ≤ if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · rw [if_pos hx]
    exact Real.rpow_nonneg (norm_nonneg _) _
  · rw [if_neg hx]

theorem powTr_mono {p : ℝ} (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) {n m : ℕ} (hnm : n ≤ m) :
    powTr p n h t x ≤ powTr p m h t x := by
  classical
  change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0)
      ≤ if ‖x‖ ≤ (m : ℝ) ∧ ‖h t x‖ ≤ (m : ℝ) then ‖h t x‖ ^ p else 0
  have hcast : (n : ℝ) ≤ (m : ℝ) := Nat.cast_le.mpr hnm
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · rw [if_pos hx, if_pos ⟨le_trans hx.1 hcast, le_trans hx.2 hcast⟩]
  · rw [if_neg hx]
    by_cases hy : ‖x‖ ≤ (m : ℝ) ∧ ‖h t x‖ ≤ (m : ℝ)
    · rw [if_pos hy]
      exact Real.rpow_nonneg (norm_nonneg _) _
    · rw [if_neg hy]

theorem norm_dualTr_le {p : ℝ} (hp : 2 < p) (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    ‖dualTr p n h t x‖ ≤ (n : ℝ) ^ (p - 1) := by
  classical
  change ‖if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
      (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0‖ ≤ (n : ℝ) ^ (p - 1)
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · rw [if_pos hx, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
      mul_rpow_sub_two (norm_nonneg (h t x)) hp]
    exact Real.rpow_le_rpow (norm_nonneg _) hx.2 (by linarith)
  · rw [if_neg hx, norm_zero]
    exact Real.rpow_nonneg (Nat.cast_nonneg n) _

theorem dualTr_eq_zero_of_far {p : ℝ} (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl)
    (hx : (n : ℝ) < ‖x‖) : dualTr p n h t x = 0 := by
  classical
  change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
      (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0) = 0
  rw [if_neg (fun hc => absurd hc.1 (not_le.mpr hx))]

theorem mul_dualTr_eq {p : ℝ} (hp : 2 < p) (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    h t x * dualTr p n h t x = ((powTr p n h t x : ℝ) : ℂ) := by
  classical
  change h t x * (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
        (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0)
      = (((if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0 : ℝ)) : ℂ)
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · rw [if_pos hx, if_pos hx, ← mul_assoc, Complex.mul_conj,
      Complex.normSq_eq_norm_sq, ← Complex.ofReal_mul,
      sq_mul_rpow_sub_two (norm_nonneg (h t x)) hp]
  · rw [if_neg hx, if_neg hx, mul_zero, Complex.ofReal_zero]

theorem enorm_dualTr_rpow_eq {p : ℝ} (hp : 2 < p) (n : ℕ) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    ‖dualTr p n h t x‖ₑ ^ (p / (p - 1)) = ENNReal.ofReal (powTr p n h t x) := by
  classical
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hp'pos : (0 : ℝ) < p / (p - 1) := div_pos (by linarith) hp1
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · have hnorm : ‖dualTr p n h t x‖ = ‖h t x‖ ^ (p - 1) := by
      change ‖if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
          (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0‖
        = ‖h t x‖ ^ (p - 1)
      rw [if_pos hx, norm_mul, RCLike.norm_conj, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
        mul_rpow_sub_two (norm_nonneg (h t x)) hp]
    have hpow : powTr p n h t x = ‖h t x‖ ^ p := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0) = ‖h t x‖ ^ p
      rw [if_pos hx]
    have hexp : (p - 1) * (p / (p - 1)) = p := by
      field_simp
    rw [hpow, ← ofReal_norm, hnorm,
      ENNReal.ofReal_rpow_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _) hp'pos.le,
      ← Real.rpow_mul (norm_nonneg _), hexp]
  · have hz : dualTr p n h t x = 0 := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then
          (starRingEnd ℂ) (h t x) * ((‖h t x‖ ^ (p - 2) : ℝ) : ℂ) else 0) = 0
      rw [if_neg hx]
    have hpow : powTr p n h t x = 0 := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0) = 0
      rw [if_neg hx]
    rw [hz, hpow, enorm_zero, ENNReal.zero_rpow_of_pos hp'pos, ENNReal.ofReal_zero]

theorem integrable_powTr {p : ℝ} (hp : 2 < p) {n : ℕ} {h : ℝ → Pl → ℂ} {t : ℝ}
    (hh : Measurable (h t)) : Integrable (powTr p n h t) (volume : Measure Pl) := by
  classical
  have hmeas : Measurable (powTr p n h t) := measurable_powTr hp.le hh
  have hind : Integrable (Set.indicator (Metric.closedBall (0 : Pl) (n : ℝ))
      (fun _ => (n : ℝ) ^ p)) (volume : Measure Pl) := by
    rw [integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const (measure_closedBall_lt_top).ne
  refine Integrable.mono' hind hmeas.aestronglyMeasurable ?_
  filter_upwards with x
  rw [Real.norm_eq_abs, abs_of_nonneg (powTr_nonneg n h t x)]
  by_cases hx : ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ)
  · have hpow : powTr p n h t x = ‖h t x‖ ^ p := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0) = ‖h t x‖ ^ p
      rw [if_pos hx]
    rw [hpow, Set.indicator_of_mem (by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hx.1)]
    exact Real.rpow_le_rpow (norm_nonneg _) hx.2 (by linarith)
  · have hpow : powTr p n h t x = 0 := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0) = 0
      rw [if_neg hx]
    rw [hpow]
    exact Set.indicator_nonneg (fun _ _ => Real.rpow_nonneg (Nat.cast_nonneg n) _) x

theorem tendsto_ofReal_powTr {p : ℝ} (hp : 2 < p) (h : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (powTr p n h t x)) Filter.atTop
      (nhds (‖h t x‖ₑ ^ p)) := by
  classical
  obtain ⟨N, hN⟩ := exists_nat_ge (max ‖x‖ ‖h t x‖)
  have hN1 : ‖x‖ ≤ (N : ℝ) := le_trans (le_max_left _ _) hN
  have hN2 : ‖h t x‖ ≤ (N : ℝ) := le_trans (le_max_right _ _) hN
  have heq : ∀ᶠ n : ℕ in Filter.atTop,
      (fun _ : ℕ => ‖h t x‖ₑ ^ p) n = ENNReal.ofReal (powTr p n h t x) := by
    refine Filter.eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
    have hcast : (N : ℝ) ≤ (n : ℝ) := Nat.cast_le.mpr hn
    have hpow : powTr p n h t x = ‖h t x‖ ^ p := by
      change (if ‖x‖ ≤ (n : ℝ) ∧ ‖h t x‖ ≤ (n : ℝ) then ‖h t x‖ ^ p else 0) = ‖h t x‖ ^ p
      rw [if_pos ⟨le_trans hN1 hcast, le_trans hN2 hcast⟩]
    rw [hpow, ← ofReal_norm,
      ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) (by linarith : (0:ℝ) ≤ p)]
  exact Filter.Tendsto.congr' heq tendsto_const_nhds

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Duality.**  A pairing bound valid for every bounded, compactly supported test family gives
the `ℓ^pL^p` bound on the family itself. -/
theorem lintegral_pow_le_of_pairing_le {p : ℝ} (hp : 2 < p) (Efin : Finset ℝ)
    {h : ℝ → Pl → ℂ} (hhm : ∀ t : ℝ, Measurable (h t)) {Kv : ℝ≥0∞}
    (hpair : ∀ φ : ℝ → Pl → ℂ, (∀ t : ℝ, Measurable (φ t)) → ∀ Cφ R : ℝ,
      (∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ) → (∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0) →
      ‖∑ t ∈ Efin, ∫ x : Pl, h t x * φ t x‖ₑ
        ≤ Kv * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) ^ (1 / (p / (p - 1)))) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖h t x‖ₑ ^ p) ^ (1 / p) ≤ Kv := by
  classical
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hp'pos : (0 : ℝ) < p / (p - 1) := div_pos hppos hp1
  set In : ℕ → ℝ≥0∞ := fun n =>
    ∑ t ∈ Efin, ∫⁻ x : Pl, ENNReal.ofReal (powTr p n h t x) with hIn
  have hIeq : ∀ (n : ℕ) (t : ℝ), (∫⁻ x : Pl, ENNReal.ofReal (powTr p n h t x))
      = ENNReal.ofReal (∫ x : Pl, powTr p n h t x) := by
    intro n t
    exact (ofReal_integral_eq_lintegral_ofReal (integrable_powTr hp (hhm t))
      (Filter.Eventually.of_forall fun x => powTr_nonneg n h t x)).symm
  have hIfin : ∀ n : ℕ, In n ≠ ⊤ := by
    intro n
    rw [hIn]
    refine ENNReal.sum_ne_top.mpr fun t _ => ?_
    rw [hIeq n t]
    exact ENNReal.ofReal_ne_top
  -- the pairing bound applied to the truncated dual function
  have hkey : ∀ n : ℕ, In n ≤ Kv * (In n) ^ (1 / (p / (p - 1))) := by
    intro n
    have hφm : ∀ t : ℝ, Measurable (dualTr p n h t) := fun t => measurable_dualTr hp.le (hhm t)
    have hpr := hpair (dualTr p n h) hφm ((n : ℝ) ^ (p - 1)) (n : ℝ)
      (fun t x => norm_dualTr_le hp n h t x)
      (fun t x hx => dualTr_eq_zero_of_far n h t x hx)
    have hnn : ∀ t : ℝ, 0 ≤ ∫ x : Pl, powTr p n h t x := fun t =>
      integral_nonneg fun x => powTr_nonneg n h t x
    have hterm : ∀ t : ℝ, (∫ x : Pl, h t x * dualTr p n h t x)
        = ((∫ x : Pl, powTr p n h t x : ℝ) : ℂ) := by
      intro t
      have h1 : (∫ x : Pl, h t x * dualTr p n h t x)
          = ∫ x : Pl, ((powTr p n h t x : ℝ) : ℂ) :=
        integral_congr_ae (Filter.Eventually.of_forall fun x => mul_dualTr_eq hp n h t x)
      rw [h1, integral_complex_ofReal]
    have hsum : (∑ t ∈ Efin, ∫ x : Pl, h t x * dualTr p n h t x)
        = ((∑ t ∈ Efin, ∫ x : Pl, powTr p n h t x : ℝ) : ℂ) := by
      rw [Complex.ofReal_sum]
      exact Finset.sum_congr rfl fun t _ => hterm t
    have hLHS : ‖∑ t ∈ Efin, ∫ x : Pl, h t x * dualTr p n h t x‖ₑ = In n := by
      rw [hsum, ← ofReal_norm, Complex.norm_real, Real.norm_eq_abs,
        abs_of_nonneg (Finset.sum_nonneg fun t _ => hnn t),
        ENNReal.ofReal_sum_of_nonneg (fun t _ => hnn t), hIn]
      exact Finset.sum_congr rfl fun t _ => (hIeq n t).symm
    have hQ : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖dualTr p n h t x‖ₑ ^ (p / (p - 1))) = In n := by
      rw [hIn]
      refine Finset.sum_congr rfl fun t _ => ?_
      exact lintegral_congr fun x => enorm_dualTr_rpow_eq hp n h t x
    rw [hLHS, hQ] at hpr
    exact hpr
  -- each truncated integral is at most `Kv ^ p`
  have hstep : ∀ n : ℕ, In n ≤ Kv ^ p := by
    intro n
    rcases eq_or_ne (In n) 0 with h0 | h0
    · rw [h0]
      exact zero_le
    have hfin := hIfin n
    have hc0 : (In n) ^ (1 / (p / (p - 1))) ≠ 0 := by
      rw [ne_eq, ENNReal.rpow_eq_zero_iff]
      intro hcon
      rcases hcon with hc | hc
      · exact h0 hc.1
      · exact hfin hc.1
    have hct : (In n) ^ (1 / (p / (p - 1))) ≠ ⊤ := by
      rw [ne_eq, ENNReal.rpow_eq_top_iff]
      intro hcon
      rcases hcon with hc | hc
      · exact h0 hc.1
      · exact hfin hc.1
    have hsplit : In n = (In n) ^ (1 / p) * (In n) ^ (1 / (p / (p - 1))) := by
      rw [← ENNReal.rpow_add _ _ h0 hfin]
      have hexp : 1 / p + 1 / (p / (p - 1)) = 1 := by
        rw [one_div_div, ← add_div, show (1 : ℝ) + (p - 1) = p by ring,
          div_self hppos.ne']
      rw [hexp, ENNReal.rpow_one]
    have h1 : (In n) ^ (1 / p) * (In n) ^ (1 / (p / (p - 1)))
        ≤ Kv * (In n) ^ (1 / (p / (p - 1))) := by
      rw [← hsplit]
      exact hkey n
    have h2 : (In n) ^ (1 / p) ≤ Kv := (ENNReal.mul_le_mul_iff_left hc0 hct).mp h1
    have h3 : ((In n) ^ (1 / p)) ^ p ≤ Kv ^ p := ENNReal.rpow_le_rpow h2 hppos.le
    rwa [← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hppos.ne', ENNReal.rpow_one] at h3
  -- monotone convergence
  have hlim : Filter.Tendsto In Filter.atTop
      (nhds (∑ t ∈ Efin, ∫⁻ x : Pl, ‖h t x‖ₑ ^ p)) := by
    rw [hIn]
    refine tendsto_finsetSum Efin fun t _ => ?_
    refine lintegral_tendsto_of_tendsto_of_monotone
      (fun n => ((measurable_powTr hp.le (hhm t)).ennreal_ofReal).aemeasurable) ?_ ?_
    · filter_upwards with x
      intro a b hab
      exact ENNReal.ofReal_le_ofReal (powTr_mono h t x hab)
    · filter_upwards with x
      exact tendsto_ofReal_powTr hp h t x
  have hfull : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖h t x‖ₑ ^ p) ≤ Kv ^ p :=
    le_of_tendsto hlim (Filter.Eventually.of_forall hstep)
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖h t x‖ₑ ^ p) ^ (1 / p)
      ≤ (Kv ^ p) ^ (1 / p) := ENNReal.rpow_le_rpow hfull (le_of_lt (one_div_pos.mpr hppos))
    _ = Kv := by
        rw [← ENNReal.rpow_mul, mul_one_div, div_self hppos.ne', ENNReal.rpow_one]

/-! ### The `L^p` bound of §3: interpolation plus duality -/

/-- The `ζ`-uniform bound for the image of the Calderón family. -/
noncomputable def uniTop2 (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (B0 : ℝ) (Mk L : ℕ)
    (p gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ((∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
      * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) ^ ((1 : ℝ) / 2)
    * (normNpp p gam F) ^ ((1 : ℝ) / 2)
  + ENNReal.ofReal (700000000 * (1 + stC) * B0
      * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F

theorem uniTop2_ne_top {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hm : MultData j m m2 B0') (ε t : ℝ) (B0 : ℝ) (Mk L : ℕ) {p gam : ℝ} {F : Pl2 → ℂ}
    (hNfin : normNpp p gam F ≠ ⊤) : uniTop2 j ε m t B0 Mk L p gam F ≠ ⊤ := by
  have hAfin : (∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) < ⊤ := by
    have hfun : ∀ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)
        = ‖(kernS hm ε t : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
      intro u
      rw [kernS_apply]
    rw [lintegral_congr hfun]
    exact lintegral_enorm_sq_mul_one_add_lt_top (kernS hm ε t)
  rw [uniTop2]
  refine ENNReal.add_ne_top.mpr ⟨?_, ?_⟩
  · refine ENNReal.mul_ne_top ?_ ?_
    · refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
      exact (ENNReal.mul_lt_top hAfin hAfin).ne
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hNfin
  · exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) hNfin

theorem norm_Top2_Ffam_le_uni {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {ζ : ℂ} (hζ : ζ ∈ clStrip) (x : Pl) :
    ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ (uniTop2 j ε m t B0 Mk L p gam F).toReal := by
  have h := enorm_Top2_Ffam_le hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib
    hζ.1 hζ.2 x
  rw [← ofReal_norm] at h
  rw [← ENNReal.ofReal_le_iff_le_toReal (uniTop2_ne_top hm ε t B0 Mk L hNfin)]
  exact h

theorem lintegral_enorm_rpow_ne_top_of_bdd_support {r : ℝ} (hr : 0 < r) {g : Pl → ℂ}
    (hg : Measurable g) {C R : ℝ} (hb : ∀ x : Pl, ‖g x‖ ≤ C)
    (hsupp : ∀ x : Pl, R < ‖x‖ → g x = 0) : (∫⁻ x : Pl, ‖g x‖ₑ ^ r) ≠ ⊤ := by
  have hint : Integrable (fun x : Pl => ‖g x‖ ^ r) (volume : Measure Pl) :=
    integrable_rpow_norm_of_bdd_support hr hg hb hsupp
  have heq : (∫⁻ x : Pl, ‖g x‖ₑ ^ r) = ENNReal.ofReal (∫ x : Pl, ‖g x‖ ^ r) := by
    rw [ofReal_integral_eq_lintegral_ofReal hint
      (Filter.Eventually.of_forall fun x => Real.rpow_nonneg (norm_nonneg _) _)]
    refine lintegral_congr fun x => ?_
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hr.le]
  rw [heq]
  exact ENNReal.ofReal_ne_top

/-- The `ℝ≥0∞` algebra behind the interpolation of the two edge bounds. -/
theorem ennreal_interp_alg {p : ℝ} (hp : 2 < p) {Aen Ben Q : ℝ≥0∞}
    (_hA : Aen ≠ ⊤) (_hB : Ben ≠ ⊤) (hQt : Q ≠ ⊤) :
    (Aen ^ ((1 : ℝ) / 2) * Q ^ ((1 : ℝ) / 2)) ^ (2 / p) * (Ben * Q) ^ (1 - 2 / p)
      = (Aen ^ (1 / p) * Ben ^ (1 - 2 / p)) * Q ^ (1 / (p / (p - 1))) := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := div_pos (by norm_num) hppos
  have h2p1 : 2 / p < 1 := by
    rw [div_lt_one hppos]
    linarith
  have h1m : (0 : ℝ) < 1 - 2 / p := by linarith
  have hpne : p ≠ 0 := hppos.ne'
  have hp1ne : p - 1 ≠ 0 := by
    intro hc
    have : p = 1 := by linarith
    linarith
  have hp'pos : (0 : ℝ) < 1 / (p / (p - 1)) :=
    div_pos (by norm_num) (div_pos hppos (by linarith))
  rw [ENNReal.mul_rpow_of_nonneg _ _ h2p.le, ENNReal.mul_rpow_of_nonneg _ _ h1m.le,
    ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
  have he1 : (1 : ℝ) / 2 * (2 / p) = 1 / p := by
    field_simp
  rw [he1]
  rcases eq_or_ne Q 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos (one_div_pos.mpr hppos), ENNReal.zero_rpow_of_pos h1m,
      ENNReal.zero_rpow_of_pos hp'pos]
    simp
  · have hexp : (1 : ℝ) / p + (1 - 2 / p) = 1 / (p / (p - 1)) := by
      rw [one_div_div]
      field_simp
      try ring
    have hQmul : Q ^ ((1 : ℝ) / p) * Q ^ (1 - 2 / p) = Q ^ (1 / (p / (p - 1))) := by
      rw [← ENNReal.rpow_add _ _ h0 hQt, hexp]
    calc Aen ^ ((1 : ℝ) / p) * Q ^ ((1 : ℝ) / p) * (Ben ^ (1 - 2 / p) * Q ^ (1 - 2 / p))
        = Aen ^ ((1 : ℝ) / p) * Ben ^ (1 - 2 / p)
            * (Q ^ ((1 : ℝ) / p) * Q ^ (1 - 2 / p)) := by ring
      _ = Aen ^ ((1 : ℝ) / p) * Ben ^ (1 - 2 / p) * Q ^ (1 / (p / (p - 1))) := by rw [hQmul]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The interpolated pairing bound.** -/
theorem enorm_pairT_le_interp {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t)) {Cφ R : ℝ}
    (hφb : ∀ (t : ℝ) (x : Pl), ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ (t : ℝ) (x : Pl), R < ‖x‖ → φ t x = 0) :
    ‖pairT j ε m Efin F φ‖ₑ
      ≤ ((4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
              * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
            * normNpp p gam F) ^ (1 / p)
          * (ENNReal.ofReal (700000000 * (1 + stC) * B0
              * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F) ^ (1 - 2 / p))
        * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) ^ (1 / (p / (p - 1))) := by
  classical
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hp'pos : (0 : ℝ) < p / (p - 1) := div_pos hppos hp1
  have h2p : (0 : ℝ) < 2 / p := div_pos (by norm_num) hppos
  have h2p1 : 2 / p < 1 := by
    rw [div_lt_one hppos]
    linarith
  have h1m : (0 : ℝ) < 1 - 2 / p := by linarith
  set Aen : ℝ≥0∞ := 4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
      * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
    * normNpp p gam F with hAendef
  set Ben : ℝ≥0∞ := ENNReal.ofReal (700000000 * (1 + stC) * B0
      * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F with hBendef
  set Q : ℝ≥0∞ := ∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1)) with hQdef
  have hAfin : Aen ≠ ⊤ := by
    rw [hAendef]
    exact ENNReal.mul_ne_top (ENNReal.mul_ne_top (by norm_num) ENNReal.ofReal_ne_top) hNfin
  have hBfin : Ben ≠ ⊤ := by
    rw [hBendef]
    exact ENNReal.mul_ne_top (ENNReal.pow_ne_top ENNReal.ofReal_ne_top) hNfin
  have hQfin : Q ≠ ⊤ := by
    rw [hQdef]
    refine ENNReal.sum_ne_top.mpr fun t _ => ?_
    exact lintegral_enorm_rpow_ne_top_of_bdd_support hp'pos (hφm t) (hφb t) (hφs t)
  set A0 : ℝ≥0∞ := Aen ^ ((1 : ℝ) / 2) * Q ^ ((1 : ℝ) / 2) with hA0def
  set A1 : ℝ≥0∞ := Ben * Q with hA1def
  have hA0fin : A0 ≠ ⊤ := by
    rw [hA0def]
    exact ENNReal.mul_ne_top (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hAfin)
      (ENNReal.rpow_ne_top_of_nonneg (by norm_num) hQfin)
  have hA1fin : A1 ≠ ⊤ := by
    rw [hA1def]
    exact ENNReal.mul_ne_top hBfin hQfin
  -- the uniform bound on the closed strip
  set Uvr : ℝ → ℝ := fun t => (uniTop2 j ε m t B0 Mk L p gam F).toReal with hUvrdef
  have hUvr : ∀ t ∈ Efin, ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr t := by
    intro t ht ζ hζ x
    rw [hUvrdef]
    exact norm_Top2_Ffam_le_uni hpol hm hε (hEfin t ht).1 (hEfin t ht).2 hMk hQb hMj hMj2 hBL
      hgam1 hgam2 hpgt hF hfib hNfin hζ x
  -- the two edge bounds, in real form, with a positive slack
  have hedge0 : ∀ δ : ℝ, 0 < δ → ∀ ζ : ℂ, ζ.re = 0 →
      ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ A0.toReal + δ := by
    intro δ hδ ζ hζ
    have h := enorm_pairT_edge0 hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
      hNa hMc hcard hcount hpgt hF hfib hNfin hφm hζ
    rw [← ofReal_norm, ← hAendef, ← hQdef, ← hA0def] at h
    have h2 : ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ A0.toReal := by
      rw [← ENNReal.ofReal_le_iff_le_toReal hA0fin]
      exact h
    linarith
  have hedge1 : ∀ δ : ℝ, 0 < δ → ∀ ζ : ℂ, ζ.re = 1 →
      ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ A1.toReal + δ := by
    intro δ hδ ζ hζ
    have h := enorm_pairT_edge1 hpol hm hε Efin hEfin hMk hQb hMj hMj2 hBL hgam1 hpgt hF hNfin
      (φ := φ) hζ
    rw [← ofReal_norm, ← hBendef, ← hQdef, ← hA1def] at h
    have h2 : ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ ≤ A1.toReal := by
      rw [← ENNReal.ofReal_le_iff_le_toReal hA1fin]
      exact h
    linarith
  -- the interpolation, with the slack
  have hslack : ∀ δ : ℝ, 0 < δ → ‖pairT j ε m Efin F φ‖
      ≤ (A0.toReal + δ) ^ (2 / p) * (A1.toReal + δ) ^ (1 - 2 / p) := by
    intro δ hδ
    refine norm_pairT_interp hpol hm hε Efin hEfin hMk hQb hMj hMj2 hBL hgam1 hgam2 hpgt hF
      hfib hNfin hφm hφb hφs hUvr ?_ ?_ (hedge0 δ hδ) (hedge1 δ hδ)
    · have : 0 ≤ A0.toReal := ENNReal.toReal_nonneg
      linarith
    · have : 0 ≤ A1.toReal := ENNReal.toReal_nonneg
      linarith
  -- let the slack tend to zero
  have hreal : ‖pairT j ε m Efin F φ‖ ≤ A0.toReal ^ (2 / p) * A1.toReal ^ (1 - 2 / p) := by
    have hcont : Filter.Tendsto
        (fun δ : ℝ => (A0.toReal + δ) ^ (2 / p) * (A1.toReal + δ) ^ (1 - 2 / p))
        (nhdsWithin 0 (Set.Ioi 0))
        (nhds (A0.toReal ^ (2 / p) * A1.toReal ^ (1 - 2 / p))) := by
      have h1 : Continuous fun δ : ℝ =>
          (A0.toReal + δ) ^ (2 / p) * (A1.toReal + δ) ^ (1 - 2 / p) :=
        ((Real.continuous_rpow_const h2p.le).comp (continuous_const.add continuous_id)).mul
          ((Real.continuous_rpow_const h1m.le).comp (continuous_const.add continuous_id))
      have h2 : Filter.Tendsto
          (fun δ : ℝ => (A0.toReal + δ) ^ (2 / p) * (A1.toReal + δ) ^ (1 - 2 / p))
          (nhdsWithin (0 : ℝ) (Set.Ioi 0))
          (nhds ((A0.toReal + 0) ^ (2 / p) * (A1.toReal + 0) ^ (1 - 2 / p))) :=
        h1.continuousWithinAt
      simpa using h2
    refine ge_of_tendsto hcont ?_
    refine eventually_nhdsWithin_of_forall fun δ hδ => ?_
    exact hslack δ hδ
  -- transfer to `ℝ≥0∞`
  have hmain : ‖pairT j ε m Efin F φ‖ₑ ≤ A0 ^ (2 / p) * A1 ^ (1 - 2 / p) := by
    rw [← ofReal_norm]
    refine le_trans (ENNReal.ofReal_le_ofReal hreal) ?_
    rw [ENNReal.ofReal_mul (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg h2p.le,
      ← ENNReal.ofReal_rpow_of_nonneg ENNReal.toReal_nonneg h1m.le,
      ENNReal.ofReal_toReal hA0fin, ENNReal.ofReal_toReal hA1fin]
  refine le_trans hmain (le_of_eq ?_)
  rw [hA0def, hA1def]
  exact ennreal_interp_alg hpgt hAfin hBfin hQfin

