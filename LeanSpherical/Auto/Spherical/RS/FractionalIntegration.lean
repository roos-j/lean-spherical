    intro q
    by_cases hz : G q = 0
    · rw [hz, mul_zero]
    · have h1 : δ ≤ |sepFst q| := by
        by_contra hc
        exact hz (hGsupp1 q (not_le.mp hc))
      have h2 : ‖q‖ ≤ R := by
        by_contra hc
        exact hz (hGsupp2 q (not_le.mp hc))
      rw [cutBoth_eq_one hδ hR h1 h2, one_mul]
  have hdiff : ∀ n q, gt n q - G q = cutBoth δ R q * (g n q - G q) := by
    intro n q
    change cutBoth δ R q * g n q - G q = cutBoth δ R q * (g n q - G q)
    rw [mul_sub, hcutG q]
  -- `L²` closeness of the cut approximants
