  have hlim : Filter.Tendsto (fun n : ℕ =>
      KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))))
      Filter.atTop (nhds (KE * (4 * wMass gam G))) := by
    have h1 : Filter.Tendsto (fun n : ℕ => (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
        Filter.atTop (nhds 0) := by
      have h : Filter.Tendsto (fun n : ℕ => (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
          Filter.atTop (nhds ((0 : ℝ≥0∞) ^ (2 : ℝ))) :=
        ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto (0 : ℝ≥0∞)).comp hofRealzero
      rwa [ENNReal.zero_rpow_of_pos (by norm_num)] at h
    have h2 : Filter.Tendsto (fun n : ℕ => W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))
        Filter.atTop (nhds 0) := by
      have h := ENNReal.Tendsto.const_mul h1 (Or.inr hWtop)
      simpa using h
    have h3 : Filter.Tendsto (fun n : ℕ =>
        4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) Filter.atTop (nhds 0) := by
      have h := ENNReal.Tendsto.const_mul h2 (Or.inr (by norm_num : (4 : ℝ≥0∞) ≠ ⊤))
      simpa using h
    have h4 : Filter.Tendsto (fun n : ℕ => 4 * wMass gam G
        + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) Filter.atTop
        (nhds (4 * wMass gam G)) := by
      have hc : Filter.Tendsto (fun _ : ℕ => 4 * wMass gam G) Filter.atTop
          (nhds (4 * wMass gam G)) := tendsto_const_nhds
      have h := hc.add h3
      simpa using h
    have h5 := ENNReal.Tendsto.const_mul h4
      (Or.inr hKEtop)
    exact h5
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ) := hsum_in G hGL1
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun n : ℕ =>
          KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))))
          Filter.atTop :=
        Filter.liminf_le_liminf (Filter.Eventually.of_forall hRHS)
    _ = KE * (4 * wMass gam G) := hlim.liminf_eq
    _ = 4 * KE * wMass gam G := by ring

/-! ### The `L²` endpoint for bounded compactly supported data -/

theorem volume_sepFst_eq_zero : (volume : Measure Pl2) {q : Pl2 | sepFst q = 0} = 0 := by
  have hker : {q : Pl2 | sepFst q = 0} = (LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ) : Set Pl2) := by
    ext q
    simp [LinearMap.mem_ker]
  have hne : (LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ)) ≠ ⊤ := by
    intro hcon
    have hmem : (pr (mk2 1 0) 0) ∈ LinearMap.ker (sepFst : Pl2 →ₗ[ℝ] ℝ) := by
      rw [hcon]
      exact Submodule.mem_top
    rw [LinearMap.mem_ker] at hmem
    have hval : (sepFst : Pl2 →ₗ[ℝ] ℝ) (pr (mk2 1 0) 0) = 1 := by
      change ((mk2 1 0 - 0 : Pl)) 0 = 1
      rw [sub_zero]
      exact mk2_apply_zero 1 0
    rw [hval] at hmem
    exact absurd hmem one_ne_zero
  rw [hker]
  exact Measure.addHaar_submodule (volume : Measure Pl2) _ hne

