    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1)) with hCdef
  set K : Pl → ℝ≥0∞ := fun u => ‖kern j ε m t u‖ₑ with hKdef
  set S : ℝ → ℝ → ℝ≥0∞ := fun y1 z1 =>
