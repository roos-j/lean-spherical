/-- **Holomorphy in the parameter.**  `ζ ↦ 𝒯_j(F_ζ)(x)` is holomorphic on the open strip. -/
theorem differentiableOn_Top2_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) (x : Pl) :
    DifferentiableOn ℂ (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
      (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
  classical
  have hopen : IsOpen (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) :=
    isOpen_Ioo.preimage Complex.continuous_re
  have hbound_int : Integrable (majB j ε m t p gam F x) (volume : Measure Pl2) :=
    integrable_majB hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin x
  -- the integrand as a function of the parameter and of `q`
  set g : Pl2 → ℂ → ℂ := fun q ζ =>
    kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q with hg
  have hgdiff : ∀ q : Pl2, Differentiable ℂ (g q) := by
    intro q
    rw [hg]
    exact (differentiable_Ffam p gam F q).const_mul _
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hjoint : ∀ σ : ℝ → ℂ, Measurable σ →
      Measurable fun v : ℝ × Pl2 => g v.2 (σ v.1) := by
    intro σ hσ
    rw [hg]
    have h1 : Measurable fun v : ℝ × Pl2 =>
        kern j ε m t (x - prjL v.2) * kern j ε m t (x - prjR v.2) := by
      have h2 : Continuous fun q : Pl2 =>
          kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
        (hkc.comp (continuous_const.sub prjL.continuous)).mul
          (hkc.comp (continuous_const.sub prjR.continuous))
      exact h2.measurable.comp measurable_snd
    have h3 : Measurable fun v : ℝ × Pl2 => Ffam p gam F (σ v.1) v.2 := by
      have hfun : (fun v : ℝ × Pl2 => Ffam p gam F (σ v.1) v.2)
          = (fun u : ℂ × Pl2 => Ffam p gam F u.1 u.2)
            ∘ (fun v : ℝ × Pl2 => ((σ v.1, v.2) : ℂ × Pl2)) := rfl
      rw [hfun]
      refine (measurable_Ffam_uncurry hF).comp ?_
      exact (hσ.comp measurable_fst).prodMk measurable_snd
    exact h1.mul h3
  have hbdσ : ∀ σ : ℝ → ℂ, ∀ (S : Set ℝ), (∀ s ∈ S, 0 ≤ (σ s).re ∧ (σ s).re ≤ 1) →
      ∀ s ∈ S, ∀ q : Pl2, ‖g q (σ s)‖ ≤ majB j ε m t p gam F x q := by
    intro σ S hS s hs q
    rw [hg, majB, norm_mul, norm_mul]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact norm_Ffam_le_toReal_sum hpgt hgam1 F (hS s hs).1 (hS s hs).2 q
  -- the wedge integral commutes with the `q`-integral
  have hwedge : ∀ z w : ℂ, Complex.Rectangle z w ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 →
      Complex.wedgeIntegral z w (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
        = ∫ q : Pl2, Complex.wedgeIntegral z w (g q) := by
    intro z w hzw
    -- the real parts of the two parameter paths stay in the strip
    have hre : ∀ s ∈ Set.uIcc z.re w.re, s ∈ Set.Ioo (0 : ℝ) 1 := by
      intro s hs
      have hmem : ((s : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simpa using hs
        · simp
      have h := hzw hmem
      simpa using h
    have hwmem : w.re ∈ Set.Ioo (0 : ℝ) 1 := by
      have hmem : ((w.re : ℂ) + z.im * Complex.I) ∈ Complex.Rectangle z w := by
        rw [Complex.Rectangle, Complex.mem_reProdIm]
        constructor
        · simp
        · simp
      have h := hzw hmem
      simpa using h
    -- the two paths
    set σ : ℝ → ℂ := fun s => (s : ℂ) + z.im * Complex.I with hσdef
    set τ : ℝ → ℂ := fun y => (w.re : ℂ) + y * Complex.I with hτdef
    have hσmeas : Measurable σ := by
      rw [hσdef]
      exact (Complex.measurable_ofReal).add measurable_const
    have hτmeas : Measurable τ := by
      rw [hτdef]
      exact measurable_const.add (Complex.measurable_ofReal.mul measurable_const)
    have hσstrip : ∀ s ∈ Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re,
        0 ≤ (σ s).re ∧ (σ s).re ≤ 1 := by
      intro s hs
      have hsu : s ∈ Set.uIcc z.re w.re := by
        rcases hs with h | h
        · exact Set.mem_uIcc_of_le (le_of_lt h.1) h.2
        · exact Set.mem_uIcc_of_ge (le_of_lt h.1) h.2
      have h := hre s hsu
      have hre' : (σ s).re = s := by
        rw [hσdef]
        simp
      rw [hre']
      exact ⟨le_of_lt h.1, le_of_lt h.2⟩
    have hτstrip : ∀ y ∈ Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im,
        0 ≤ (τ y).re ∧ (τ y).re ≤ 1 := by
      intro y _
      have hre' : (τ y).re = w.re := by
        rw [hτdef]
        simp
      rw [hre']
      exact ⟨le_of_lt hwmem.1, le_of_lt hwmem.2⟩
    have hswap1 : (∫ s in z.re..w.re, Top2 j ε m t (Ffam p gam F (σ s)) x)
        = ∫ q : Pl2, ∫ s in z.re..w.re, g q (σ s) := by
      refine intervalIntegral_integral_swap_Pl2 z.re w.re (hjoint σ hσmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro s hs q
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs q
    have hswap2 : (∫ y in z.im..w.im, Top2 j ε m t (Ffam p gam F (τ y)) x)
        = ∫ q : Pl2, ∫ y in z.im..w.im, g q (τ y) := by
      refine intervalIntegral_integral_swap_Pl2 z.im w.im (hjoint τ hτmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro y hy q
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy q
    have hint1 : Integrable (fun q : Pl2 => ∫ s in z.re..w.re, g q (σ s))
        (volume : Measure Pl2) := by
      refine integrable_intervalIntegral_Pl2 z.re w.re (hjoint σ hσmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro s hs q
      exact hbdσ σ (Set.Ioc z.re w.re ∪ Set.Ioc w.re z.re) hσstrip s hs q
    have hint2 : Integrable (fun q : Pl2 => ∫ y in z.im..w.im, g q (τ y))
        (volume : Measure Pl2) := by
      refine integrable_intervalIntegral_Pl2 z.im w.im (hjoint τ hτmeas)
        (bound := majB j ε m t p gam F x) ?_ hbound_int
      intro y hy q
      exact hbdσ τ (Set.Ioc z.im w.im ∪ Set.Ioc w.im z.im) hτstrip y hy q
    have hσapp : ∀ s : ℝ, σ s = (s : ℂ) + z.im * Complex.I := fun s => rfl
    have hτapp : ∀ y : ℝ, τ y = (w.re : ℂ) + y * Complex.I := fun y => rfl
    simp only [Complex.wedgeIntegral, ← hσapp, ← hτapp]
    rw [hswap1, hswap2,
      ← integral_smul Complex.I (fun q : Pl2 => ∫ y in z.im..w.im, g q (τ y))]
    exact (integral_add hint1 (hint2.smul Complex.I)).symm
  -- conclude by Morera
  rw [← Complex.isConservativeOn_and_continuousOn_iff_isDifferentiableOn hopen]
  refine ⟨?_, ?_⟩
  · intro z w hzw
    have hrecteq : Complex.Rectangle w z = Complex.Rectangle z w := by
      rw [Complex.Rectangle, Complex.Rectangle, Set.uIcc_comm w.re z.re,
        Set.uIcc_comm w.im z.im]
    have hrect : Complex.Rectangle w z ⊆ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 := by
      rw [hrecteq]
      exact hzw
    rw [hwedge z w hzw, hwedge w z hrect, ← integral_neg]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    exact (hgdiff q).differentiableOn.isConservativeOn z w (Set.subset_univ _)
  · refine (continuousOn_Top2_Ffam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt
      hF hfib hNfin x).mono ?_
    intro ζ hζ
    exact ⟨le_of_lt hζ.1, le_of_lt hζ.2⟩

/-! ### Level two: continuity and holomorphy of the pairing in the parameter -/

/-- `a^r ≤ a^{r₀} + a^{r₁}` when `0 < r₀ ≤ r ≤ r₁`. -/
theorem rpow_le_add_rpow {a r r0 r1 : ℝ} (ha : 0 ≤ a) (hr0 : 0 < r0)
    (h0 : r0 ≤ r) (h1 : r ≤ r1) : a ^ r ≤ a ^ r0 + a ^ r1 := by
  rcases eq_or_lt_of_le ha with h | hapos
  · have hrpos : 0 < r := lt_of_lt_of_le hr0 h0
    have hr1pos : 0 < r1 := lt_of_lt_of_le hrpos h1
    rw [← h, Real.zero_rpow hrpos.ne', Real.zero_rpow hr0.ne', Real.zero_rpow hr1pos.ne']
    norm_num
  · rcases le_or_gt a 1 with hle | hgt
    · refine le_trans (Real.rpow_le_rpow_of_exponent_ge hapos hle h0) ?_
      exact le_add_of_nonneg_right (Real.rpow_nonneg ha _)
    · refine le_trans (Real.rpow_le_rpow_of_exponent_le hgt.le h1) ?_
      exact le_add_of_nonneg_left (Real.rpow_nonneg ha _)

/-- **The real bound on the test family**, valid on the whole closed strip. -/
theorem norm_phifam_le_add {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) {ζ : ℂ}
    (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (t : ℝ) (x : Pl) :
    ‖phifam p φ ζ t x‖ ≤ ‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hpp : (0 : ℝ) < p / (p - 1) := div_pos (by linarith) hp1
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [phifam, h0, signC_zero, zero_mul, norm_zero]
    exact add_nonneg (Real.rpow_nonneg le_rfl _) (Real.rpow_nonneg le_rfl _)
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    rw [phifam, norm_mul, norm_rpowC hpos, phifam_exponent_re]
    have hb : ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
        ≤ ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
      calc ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
          ≤ 1 * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
            mul_le_mul_of_nonneg_right (norm_signC_le_one _) (Real.rpow_nonneg hpos.le _)
        _ = ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := one_mul _
    refine le_trans hb (rpow_le_add_rpow (norm_nonneg _) (by linarith) ?_ ?_)
    · nlinarith [mul_nonneg hpp.le hζ0]
    · nlinarith [mul_le_mul_of_nonneg_left hζ1 hpp.le]

/-- The majorant in the output variable for the level-two dominated convergence. -/
noncomputable def majP (p : ℝ) (φ : ℝ → Pl → ℂ) (Uvr : ℝ) (t : ℝ) (x : Pl) : ℝ :=
  Uvr * (‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)))

theorem majP_nonneg {p : ℝ} (φ : ℝ → Pl → ℂ) {Uvr : ℝ} (hU : 0 ≤ Uvr) (t : ℝ) (x : Pl) :
    0 ≤ majP p φ Uvr t x := by
  have h1 : (0 : ℝ) ≤ ‖φ t x‖ ^ (p / (p - 1) / 2) := Real.rpow_nonneg (norm_nonneg _) _
  have h2 : (0 : ℝ) ≤ ‖φ t x‖ ^ (p / (p - 1)) := Real.rpow_nonneg (norm_nonneg _) _
  rw [majP]
  exact mul_nonneg hU (by linarith)

theorem norm_Top2_phifam_le_majP {j : ℕ} {ε t : ℝ} {m : ℝ → Pl → ℂ} {p gam : ℝ} {F : Pl2 → ℂ}
    (hp : 2 < p) {φ : ℝ → Pl → ℂ} {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1)
    {Uvr : ℝ} (hU : ∀ x : Pl, ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr) (x : Pl) :
    ‖Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x‖ ≤ majP p φ Uvr t x := by
  rw [norm_mul, majP]
  exact mul_le_mul (hU x) (norm_phifam_le_add hp φ hζ0 hζ1 t x) (norm_nonneg _)
    (le_trans (norm_nonneg _) (hU x))

/-- A bounded, compactly supported function has an integrable power of its modulus. -/
theorem integrable_rpow_norm_of_bdd_support {r : ℝ} (hr : 0 < r) {g : Pl → ℂ}
    (hg : Measurable g) {C R : ℝ} (hb : ∀ x : Pl, ‖g x‖ ≤ C)
    (hsupp : ∀ x : Pl, R < ‖x‖ → g x = 0) :
    Integrable (fun x : Pl => ‖g x‖ ^ r) (volume : Measure Pl) := by
  have hCnn : (0 : ℝ) ≤ C := le_trans (norm_nonneg (g 0)) (hb 0)
  have hmeas : Measurable fun x : Pl => ‖g x‖ ^ r :=
    (Real.continuous_rpow_const hr.le).measurable.comp hg.norm
  have hind : Integrable (Set.indicator (Metric.closedBall (0 : Pl) R) (fun _ => C ^ r))
      (volume : Measure Pl) := by
    rw [integrable_indicator_iff measurableSet_closedBall]
    exact integrableOn_const (measure_closedBall_lt_top).ne
  refine Integrable.mono' hind hmeas.aestronglyMeasurable ?_
  filter_upwards with x
  rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
  by_cases hx : ‖x‖ ≤ R
  · have hmem : x ∈ Metric.closedBall (0 : Pl) R := by
      rw [Metric.mem_closedBall, dist_zero_right]
      exact hx
    rw [Set.indicator_of_mem hmem]
    exact Real.rpow_le_rpow (norm_nonneg _) (hb x) hr.le
  · have h0 : g x = 0 := hsupp x (lt_of_not_ge hx)
    rw [h0, norm_zero, Real.zero_rpow hr.ne']
    exact Set.indicator_nonneg (fun _ _ => Real.rpow_nonneg hCnn _) x

theorem integrable_majP {p : ℝ} (hp : 2 < p) {φ : ℝ → Pl → ℂ} {t : ℝ}
    (hφm : Measurable (φ t)) {Cφ R : ℝ} (hφb : ∀ x : Pl, ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ x : Pl, R < ‖x‖ → φ t x = 0) (Uvr : ℝ) :
    Integrable (majP p φ Uvr t) (volume : Measure Pl) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hpp : (0 : ℝ) < p / (p - 1) := div_pos (by linarith) hp1
  have h1 : Integrable (fun x : Pl => ‖φ t x‖ ^ (p / (p - 1) / 2)) (volume : Measure Pl) :=
    integrable_rpow_norm_of_bdd_support (by linarith) hφm hφb hφs
  have h2 : Integrable (fun x : Pl => ‖φ t x‖ ^ (p / (p - 1))) (volume : Measure Pl) :=
    integrable_rpow_norm_of_bdd_support hpp hφm hφb hφs
  have h3 : Integrable (fun x : Pl => Uvr
      * (‖φ t x‖ ^ (p / (p - 1) / 2) + ‖φ t x‖ ^ (p / (p - 1)))) (volume : Measure Pl) :=
    (h1.add h2).const_mul Uvr
  exact h3

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- Joint measurability of the image of the family in the parameter and in the output variable. -/
theorem measurable_Top2_Ffam_uncurry {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ}
    (hF : Measurable F) :
    Measurable fun v : ℂ × Pl => Top2 j ε m t (Ffam p gam F v.1) v.2 := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hcont : Continuous fun w : (ℂ × Pl) × Pl2 =>
      kern j ε m t (w.1.2 - prjL w.2) * kern j ε m t (w.1.2 - prjR w.2) := by
    have h1 : Continuous fun w : (ℂ × Pl) × Pl2 => kern j ε m t (w.1.2 - prjL w.2) :=
      hkc.comp ((continuous_snd.comp continuous_fst).sub (prjL.continuous.comp continuous_snd))
    have h2 : Continuous fun w : (ℂ × Pl) × Pl2 => kern j ε m t (w.1.2 - prjR w.2) :=
      hkc.comp ((continuous_snd.comp continuous_fst).sub (prjR.continuous.comp continuous_snd))
    exact h1.mul h2
  have hF2 : Measurable fun w : (ℂ × Pl) × Pl2 => Ffam p gam F w.1.1 w.2 := by
    have hfun : (fun w : (ℂ × Pl) × Pl2 => Ffam p gam F w.1.1 w.2)
        = (fun u : ℂ × Pl2 => Ffam p gam F u.1 u.2)
          ∘ (fun w : (ℂ × Pl) × Pl2 => ((w.1.1, w.2) : ℂ × Pl2)) := rfl
    rw [hfun]
    exact (measurable_Ffam_uncurry hF).comp
      ((measurable_fst.comp measurable_fst).prodMk measurable_snd)
  have hjoint : StronglyMeasurable fun w : (ℂ × Pl) × Pl2 =>
      kern j ε m t (w.1.2 - prjL w.2) * kern j ε m t (w.1.2 - prjR w.2)
        * Ffam p gam F w.1.1 w.2 :=
    (hcont.stronglyMeasurable).mul hF2.stronglyMeasurable
  have hSM : StronglyMeasurable fun v : ℂ × Pl =>
      ∫ q : Pl2, kern j ε m t (v.2 - prjL q) * kern j ε m t (v.2 - prjR q)
        * Ffam p gam F v.1 q := hjoint.integral_prod_right'
  exact hSM.measurable

theorem measurable_phifam_uncurry {p : ℝ} {φ : ℝ → Pl → ℂ} {t : ℝ} (hφ : Measurable (φ t)) :
    Measurable fun v : ℂ × Pl => phifam p φ v.1 t v.2 := by
  have h1 : Measurable fun v : ℂ × Pl => signC (φ t v.2) :=
    measurable_signC.comp (hφ.comp measurable_snd)
  have h2 : Measurable fun v : ℂ × Pl =>
      rpowC ‖φ t v.2‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2) := by
    have hfun : (fun v : ℂ × Pl => rpowC ‖φ t v.2‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2))
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl =>
            ((‖φ t v.2‖, ((p / (p - 1) : ℝ) : ℂ) * (1 + v.1) / 2) : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact ((hφ.comp measurable_snd).norm).prodMk
      ((measurable_const.mul (measurable_const.add measurable_fst)).div_const 2)
  exact h1.mul h2

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Continuity of the pairing integrand in the parameter**, for a single dilation `t`. -/
theorem continuousOn_integral_Top2_phifam {j : ℕ} {m : ℝ → Pl → ℂ}
    {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : Measurable (φ t)) {Cφ R : ℝ} (hφb : ∀ x : Pl, ‖φ t x‖ ≤ Cφ)
    (hφs : ∀ x : Pl, R < ‖x‖ → φ t x = 0)
    {Uvr : ℝ} (hUvr : ∀ ζ : ℂ, ζ ∈ clStrip → ∀ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x‖ ≤ Uvr) :
    ContinuousOn
      (fun ζ : ℂ => ∫ x : Pl, Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x) clStrip := by
  intro ζ₀ hζ₀
  have hmajint : Integrable (majP p φ Uvr t) (volume : Measure Pl) :=
    integrable_majP hpgt hφm hφb hφs Uvr
  have hmeas : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, AEStronglyMeasurable
      (fun x : Pl => Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
      (volume : Measure Pl) :=
    Filter.Eventually.of_forall fun ζ =>
      ((measurable_Top2 hm ε t (measurable_Ffam hF ζ)).mul
        (measurable_phifam φ ζ hφm)).aestronglyMeasurable
  have hbd : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, ∀ᵐ x : Pl,
      ‖Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x‖ ≤ majP p φ Uvr t x := by
    refine eventually_nhdsWithin_of_forall fun ζ hζ => ?_
    filter_upwards with x
    exact norm_Top2_phifam_le_majP hpgt hζ.1 hζ.2 (hUvr ζ hζ) x
  have hlim : ∀ᵐ x : Pl, Filter.Tendsto
      (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x * phifam p φ ζ t x)
      (nhdsWithin ζ₀ clStrip)
      (nhds (Top2 j ε m t (Ffam p gam F ζ₀) x * phifam p φ ζ₀ t x)) := by
    filter_upwards with x
    have h1 : Filter.Tendsto (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x)
        (nhdsWithin ζ₀ clStrip) (nhds (Top2 j ε m t (Ffam p gam F ζ₀) x)) :=
      continuousOn_Top2_Ffam hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib
        hNfin x ζ₀ hζ₀
    have h2 : Filter.Tendsto (fun ζ : ℂ => phifam p φ ζ t x) (nhdsWithin ζ₀ clStrip)
        (nhds (phifam p φ ζ₀ t x)) :=
      ((differentiable_phifam p φ t x).continuous.continuousWithinAt (s := clStrip)).tendsto
    exact h1.mul h2
  exact MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (majP p φ Uvr t) hmeas hbd hmajint hlim

