    {F : Pl2 → ℂ} (hF : Measurable F) (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤)
    (hNfin : normNpp p gam F ≠ ⊤)
    {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t))
    {ζ : ℂ} (hζ : ζ.re = 0) :
    ‖pairT j ε m Efin (Ffam p gam F ζ) (phifam p φ ζ)‖ₑ
      ≤ (4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
            * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
          * normNpp p gam F) ^ ((1 : ℝ) / 2)
        * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (p / (p - 1))) ^ ((1 : ℝ) / 2) := by
  have hFfam_meas : Measurable (Ffam p gam F ζ) := measurable_Ffam hF ζ
