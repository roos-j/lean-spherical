  have hWtop : W ≠ ⊤ := by rw [hW]; exact ENNReal.ofReal_ne_top
  have hwt : ∀ n, wMass gam (gt n)
      ≤ 4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ)) := by
    intro n
    have h1 := wMass_le_four_add gam (hgtmeas n) hGm
    have h2 : wMass gam (gt n - G) ≤ W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ) := by
      have h3 : wMass gam (gt n - G)
          ≤ W * ∫⁻ q : Pl2, ‖(gt n - G) q‖ₑ ^ (2 : ℝ) := by
        rw [hW]
        refine wMass_le_of_away (le_of_lt hgam1) (by positivity) (fun q hq => ?_)
        change gt n q - G q = 0
        exact hdsupp1 n q hq
      refine le_trans h3 (mul_le_mul' (le_refl _) ?_)
      exact hsqcl n
    calc wMass gam (gt n) ≤ 4 * wMass gam G + 4 * wMass gam (gt n - G) := h1
      _ ≤ 4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ)) :=
          add_le_add (le_refl _) (mul_le_mul' (le_refl _) h2)
