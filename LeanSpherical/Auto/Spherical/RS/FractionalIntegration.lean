/-- **Continuity in the parameter.**  `ζ ↦ 𝒯_j(F_ζ)(x)` is continuous on the closed strip. -/
theorem continuousOn_Top2_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) (hNfin : normNpp p gam F ≠ ⊤) (x : Pl) :
    ContinuousOn (fun ζ : ℂ => Top2 j ε m t (Ffam p gam F ζ) x) clStrip := by
  intro ζ₀ hζ₀
  have hbound_int : Integrable (majB j ε m t p gam F x) (volume : Measure Pl2) :=
    integrable_majB hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL hgam1 hgam2 hpgt hF hfib hNfin x
  have hmeas : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, AEStronglyMeasurable
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (volume : Measure Pl2) :=
    Filter.Eventually.of_forall fun ζ => aestronglyMeasurable_kern_Ffam hm ε t p gam hF x ζ
  have hbd : ∀ᶠ ζ in nhdsWithin ζ₀ clStrip, ∀ᵐ q : Pl2,
      ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q‖
        ≤ majB j ε m t p gam F x q := by
    refine eventually_nhdsWithin_of_forall fun ζ hζ => ?_
    filter_upwards with q
    rw [norm_mul, norm_mul, majB]
    refine mul_le_mul_of_nonneg_left ?_ (by positivity)
    exact norm_Ffam_le_toReal_sum hpgt hgam1 F hζ.1 hζ.2 q
  have hlim : ∀ᵐ q : Pl2, Filter.Tendsto
      (fun ζ : ℂ => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (nhdsWithin ζ₀ clStrip)
      (nhds (kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ₀ q)) := by
    filter_upwards with q
    have hcont : Continuous fun ζ : ℂ => Ffam p gam F ζ q :=
      (differentiable_Ffam p gam F q).continuous
    have h1 : Filter.Tendsto (fun ζ : ℂ => Ffam p gam F ζ q) (nhdsWithin ζ₀ clStrip)
        (nhds (Ffam p gam F ζ₀ q)) := (hcont.continuousWithinAt (s := clStrip)).tendsto
    exact h1.const_mul _
  have hconv := MeasureTheory.tendsto_integral_filter_of_dominated_convergence
    (μ := (volume : Measure Pl2)) (l := nhdsWithin ζ₀ clStrip)
    (F := fun ζ (q : Pl2) => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
      * Ffam p gam F ζ q)
    (f := fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
      * Ffam p gam F ζ₀ q)
    (majB j ε m t p gam F x) hmeas hbd hbound_int hlim
  exact hconv

/-! ### Swapping an interval integral with an integral over a measure space -/

theorem integrable_uncurry_of_bound {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (Function.uncurry G) (((volume : Measure ℝ).restrict S).prod μ) := by
  have hfin : IsFiniteMeasure ((volume : Measure ℝ).restrict S) := by
    refine ⟨?_⟩
    rw [Measure.restrict_apply_univ]
    exact hSfin
  have hone : Integrable (fun _ : ℝ => (1 : ℝ)) ((volume : Measure ℝ).restrict S) :=
    integrable_const 1
  have hmaj : Integrable (fun z : ℝ × α => (1 : ℝ) * bound z.2)
      (((volume : Measure ℝ).restrict S).prod μ) := hone.mul_prod hbint
  refine Integrable.mono' hmaj hmeas.aestronglyMeasurable ?_
  have hprodrestrict : (((volume : Measure ℝ).restrict S).prod μ)
      = ((volume : Measure ℝ).prod μ).restrict (S ×ˢ Set.univ) := by
    rw [← Measure.prod_restrict, Measure.restrict_univ]
  have hae : ∀ᵐ z : ℝ × α ∂(((volume : Measure ℝ).restrict S).prod μ), z.1 ∈ S := by
    rw [hprodrestrict]
    have h := ae_restrict_mem (μ := ((volume : Measure ℝ).prod μ))
      (hS.prod MeasurableSet.univ)
    filter_upwards [h] with z hz
    exact hz.1
  filter_upwards [hae] with z hz
  rw [one_mul]
  exact hbd z.1 hz z.2

theorem setIntegral_integral_swap_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    (∫ s in S, ∫ q : α, G s q ∂μ) = ∫ q : α, (∫ s in S, G s q) ∂μ :=
  integral_integral_swap (integrable_uncurry_of_bound hS hSfin hmeas hbd hbint)

theorem integrable_setIntegral_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] {S : Set ℝ} (hS : MeasurableSet S)
    (hSfin : (volume : Measure ℝ) S < ⊤) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ} (hbd : ∀ s ∈ S, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (fun q : α => ∫ s in S, G s q) μ := by
  have huc := integrable_uncurry_of_bound hS hSfin hmeas hbd hbint
  have h := huc.integral_prod_right
  simpa [Function.uncurry] using h

theorem intervalIntegral_integral_swap_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] (a b : ℝ) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    (∫ s in a..b, ∫ q : α, G s q ∂μ) = ∫ q : α, (∫ s in a..b, G s q) ∂μ := by
  have hbd1 : ∀ s ∈ Set.Ioc a b, ∀ q, ‖G s q‖ ≤ bound q :=
    fun s hs q => hbd s (Or.inl hs) q
  have hbd2 : ∀ s ∈ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q :=
    fun s hs q => hbd s (Or.inr hs) q
  have hIoc1 : (∫ s in Set.Ioc a b, ∫ q : α, G s q ∂μ)
      = ∫ q : α, (∫ s in Set.Ioc a b, G s q) ∂μ :=
    setIntegral_integral_swap_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd1 hbint
  have hIoc2 : (∫ s in Set.Ioc b a, ∫ q : α, G s q ∂μ)
      = ∫ q : α, (∫ s in Set.Ioc b a, G s q) ∂μ :=
    setIntegral_integral_swap_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd2 hbint
  change (∫ s in Set.Ioc a b, ∫ q : α, G s q ∂μ) - (∫ s in Set.Ioc b a, ∫ q : α, G s q ∂μ)
      = ∫ q : α, ((∫ s in Set.Ioc a b, G s q) - ∫ s in Set.Ioc b a, G s q) ∂μ
  rw [hIoc1, hIoc2,
    ← integral_sub
      (integrable_setIntegral_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd1 hbint)
      (integrable_setIntegral_gen measurableSet_Ioc measure_Ioc_lt_top hmeas hbd2 hbint)]

theorem integrable_intervalIntegral_gen {α : Type*} [MeasurableSpace α] {μ : Measure α}
    [SigmaFinite μ] (a b : ℝ) {G : ℝ → α → ℂ}
    (hmeas : Measurable fun z : ℝ × α => G z.1 z.2)
    {bound : α → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound μ) :
    Integrable (fun q : α => ∫ s in a..b, G s q) μ := by
  have h1 := integrable_setIntegral_gen (S := Set.Ioc a b) measurableSet_Ioc measure_Ioc_lt_top
    hmeas (fun s hs q => hbd s (Or.inl hs) q) hbint
  have h2 := integrable_setIntegral_gen (S := Set.Ioc b a) measurableSet_Ioc measure_Ioc_lt_top
    hmeas (fun s hs q => hbd s (Or.inr hs) q) hbint
  exact h1.sub h2

/-- The special case of the swap used for the `ℝ⁴` integral. -/
theorem intervalIntegral_integral_swap_Pl2 (a b : ℝ) {G : ℝ → Pl2 → ℂ}
    (hmeas : Measurable fun z : ℝ × Pl2 => G z.1 z.2)
    {bound : Pl2 → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound (volume : Measure Pl2)) :
    (∫ s in a..b, ∫ q : Pl2, G s q) = ∫ q : Pl2, ∫ s in a..b, G s q :=
  intervalIntegral_integral_swap_gen a b hmeas hbd hbint

theorem integrable_intervalIntegral_Pl2 (a b : ℝ) {G : ℝ → Pl2 → ℂ}
    (hmeas : Measurable fun z : ℝ × Pl2 => G z.1 z.2)
    {bound : Pl2 → ℝ}
    (hbd : ∀ s ∈ Set.Ioc a b ∪ Set.Ioc b a, ∀ q, ‖G s q‖ ≤ bound q)
    (hbint : Integrable bound (volume : Measure Pl2)) :
    Integrable (fun q : Pl2 => ∫ s in a..b, G s q) (volume : Measure Pl2) :=
  integrable_intervalIntegral_gen a b hmeas hbd hbint

/-! ### Holomorphy of the image of the family, by Morera's theorem -/

theorem measurable_rpowC_uncurry : Measurable fun v : ℝ × ℂ => rpowC v.1 v.2 := by
  classical
  have h : (fun v : ℝ × ℂ => rpowC v.1 v.2)
      = fun v : ℝ × ℂ => if v.1 = 0 then 0 else Complex.exp (v.2 * (Real.log v.1 : ℂ)) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_fst measurable_const)
    measurable_const ?_
  exact Complex.measurable_exp.comp (measurable_snd.mul
    (Complex.measurable_ofReal.comp (Real.measurable_log.comp measurable_fst)))

