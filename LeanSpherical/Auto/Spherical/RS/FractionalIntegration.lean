    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {R CG : ℝ} (hR : 0 < R)
    {G : Pl2 → ℂ} (hGm : Measurable G) (hGb : ∀ q, ‖G q‖ ≤ CG)
    (hGsupp : ∀ q, R < ‖q‖ → G q = 0) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
