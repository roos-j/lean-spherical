theorem prop31_Top2_away {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {δ R CG : ℝ} (hδ : 0 < δ) (hR : 0 < R)
    {G : Pl2 → ℂ} (hGm : Measurable G) (hGb : ∀ q, ‖G q‖ ≤ CG)
    (hGsupp1 : ∀ q, |sepFst q| < δ → G q = 0) (hGsupp2 : ∀ q, R < ‖q‖ → G q = 0) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      ≤ 4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam G := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  have hKEtop : KE ≠ ⊤ := by rw [hKE]; exact ENNReal.ofReal_ne_top
  have hGL2 : MemLp G 2 (volume : Measure Pl2) := memLp_of_bdd_support hGm hGb hGsupp2
  have hGL1 : Integrable G (volume : Measure Pl2) :=
    memLp_one_iff_integrable.mp (memLp_of_bdd_support hGm hGb hGsupp2)
  -- the smooth approximants
  have hex : ∀ n : ℕ, ∃ g : Pl2 → ℂ, HasCompactSupport g ∧ ContDiff ℝ (↑(⊤ : ℕ∞)) g ∧
      eLpNorm (G - g) 2 (volume : Measure Pl2) ≤ ENNReal.ofReal (1 / ((n : ℝ) + 1)) := by
    intro n
    exact hGL2.exist_eLpNorm_sub_le (by norm_num) (by norm_num)
