/-! ### Continuity of the image of the family in the parameter -/

/-- The closed strip `0 ≤ Re ζ ≤ 1`. -/
def clStrip : Set ℂ := {ζ : ℂ | 0 ≤ ζ.re ∧ ζ.re ≤ 1}

theorem aestronglyMeasurable_kern_Ffam {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ}
    (hF : Measurable F) (x : Pl) (ζ : ℂ) :
    AEStronglyMeasurable (fun q : Pl2 =>
      kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Ffam p gam F ζ q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
    (hkc.comp (continuous_const.sub prjL.continuous)).mul
      (hkc.comp (continuous_const.sub prjR.continuous))
  exact (h1.measurable.mul (measurable_Ffam hF ζ)).aestronglyMeasurable

