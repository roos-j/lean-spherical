theorem measurable_Ffam_uncurry {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun v : ℂ × Pl2 => Ffam p gam F v.1 v.2 := by
  have h1 : Measurable fun v : ℂ × Pl2 => signC (F v.2) :=
    measurable_signC.comp (hF.comp measurable_snd)
  have h2 : Measurable fun v : ℂ × Pl2 =>
      rpowC ((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal) (1 - v.1) := by
    have hfun : (fun v : ℂ × Pl2 =>
        rpowC ((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal) (1 - v.1))
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl2 =>
            (((gZero p gam F (bs1 v.2) (bs2 v.2) (fb1 v.2) (fb2 v.2)).toReal, 1 - v.1)
              : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact (((measurable_gZero_q hF).ennreal_toReal).comp measurable_snd).prodMk
      (measurable_const.sub measurable_fst)
  have h3 : Measurable fun v : ℂ × Pl2 =>
      rpowC ((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal) v.1 := by
    have hfun : (fun v : ℂ × Pl2 => rpowC ((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal) v.1)
        = (fun u : ℝ × ℂ => rpowC u.1 u.2)
          ∘ (fun v : ℂ × Pl2 =>
            (((gOne p gam F (bs1 v.2) (bs2 v.2)).toReal, v.1) : ℝ × ℂ)) := rfl
    rw [hfun]
    refine measurable_rpowC_uncurry.comp ?_
    exact (((measurable_gOne_q hF).ennreal_toReal).comp measurable_snd).prodMk measurable_fst
  exact (h1.mul h2).mul h3

