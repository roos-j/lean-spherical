-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Proposition 3.1 for all data of finite weighted mass.**  This is the class in which the
Calderón family of the interpolation lives. -/
theorem prop31_Top2_wmass {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {F : Pl2 → ℂ} (hFm : Measurable F) (hFfin : wMass gam F ≠ ⊤) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))
      ≤ 4 * ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam F := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  -- the truncations
  set Fn : ℕ → Pl2 → ℂ := fun n q =>
    if ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ) then F q else 0 with hFndef
  have hFnmeas : ∀ n : ℕ, Measurable (Fn n) := by
    intro n
    refine Measurable.ite ?_ hFm measurable_const
    exact ((measurableSet_le (hFm.norm) measurable_const).inter
      (measurableSet_le (continuous_id.norm.measurable) measurable_const))
  have hFnb : ∀ (n : ℕ) (q : Pl2), ‖Fn n q‖ ≤ (n : ℝ) := by
    intro n q
    rw [hFndef]
    by_cases h : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)
    · simp only [if_pos h]
      exact h.1
    · simp only [if_neg h, norm_zero]
      positivity
  have hFnsupp : ∀ (n : ℕ) (q : Pl2), (n : ℝ) + 1 < ‖q‖ → Fn n q = 0 := by
    intro n q hq
    rw [hFndef]
    have h : ¬ (‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)) := by
      intro hc
      have h2 := hc.2
      linarith
    simp only [if_neg h]
  have hFnle : ∀ (n : ℕ) (q : Pl2), ‖Fn n q‖ ≤ ‖F q‖ := by
    intro n q
    rw [hFndef]
    by_cases h : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ)
    · simp only [if_pos h]
      exact le_refl _
    · simp only [if_neg h, norm_zero]
      exact norm_nonneg _
  have hwn : ∀ n : ℕ, wMass gam (Fn n) ≤ wMass gam F := by
    intro n
    rw [wMass, wMass]
    refine lintegral_mono fun q => ?_
    refine mul_le_mul' ?_ (le_refl _)
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hFnle n q)
  -- the bound for each truncation
  have hbdd : ∀ n : ℕ, (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ))
      ≤ 4 * KE * wMass gam F := by
    intro n
    have h1 := prop31_Top2_bdd hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
      hNa hM hcard hcount (R := (n : ℝ) + 1) (CG := (n : ℝ))
      (by positivity) (hFnmeas n) (hFnb n) (hFnsupp n)
    refine le_trans h1 ?_
    rw [hKE]
    exact mul_le_mul' (le_refl _) (hwn n)
  -- pointwise convergence of the images
  have hptTop2 : ∀ (t : ℝ) (x : Pl), Filter.Tendsto (fun n => Top2 j ε m t (Fn n) x)
      Filter.atTop (nhds (Top2 j ε m t F x)) := by
    intro t x
    have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
    have hkmul : Continuous fun q : Pl2 =>
        kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    have hFint := integrable_Top2_integrand_of_wMass hm ε t hgam1 hgam2 x hFm hFfin
    have hmeasn : ∀ n : ℕ, AEStronglyMeasurable
        (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q)
        (volume : Measure Pl2) := fun n => (hkmul.measurable.mul (hFnmeas n)).aestronglyMeasurable
    have hbound : ∀ n : ℕ, ∀ᵐ q : Pl2,
        ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q‖
          ≤ ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q‖ := by
      intro n
      filter_upwards with q
      rw [norm_mul, norm_mul, norm_mul, norm_mul]
      exact mul_le_mul_of_nonneg_left (hFnle n q)
        (mul_nonneg (norm_nonneg (kern j ε m t (x - prjL q)))
          (norm_nonneg (kern j ε m t (x - prjR q))))
    have hconvpt : ∀ᵐ q : Pl2, Filter.Tendsto
        (fun n => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * Fn n q)
        Filter.atTop
        (nhds (kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q)) := by
      filter_upwards with q
      have hev : ∀ᶠ n : ℕ in Filter.atTop, Fn n q = F q := by
        obtain ⟨N, hN⟩ := exists_nat_gt (max ‖F q‖ ‖q‖)
        refine Filter.eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
        have h1 : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
        have h2 : ‖F q‖ ≤ (n : ℝ) := by
          have h4 := le_max_left ‖F q‖ ‖q‖
          linarith [hN, h1]
        have h3 : ‖q‖ ≤ (n : ℝ) := by
          have h4 := le_max_right ‖F q‖ ‖q‖
          linarith [hN, h1]
        rw [hFndef]
        simp only [if_pos (⟨h2, h3⟩ : ‖F q‖ ≤ (n : ℝ) ∧ ‖q‖ ≤ (n : ℝ))]
      refine Filter.Tendsto.congr' ?_ tendsto_const_nhds
      filter_upwards [hev] with n hn
      rw [hn]
    exact tendsto_integral_of_dominated_convergence _ hmeasn hFint.norm hbound hconvpt
  -- measurability of the integrands
  have hmeasT : ∀ (h : Pl2 → ℂ), Measurable h → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hhm t
    exact (((measurable_Top2 hm ε t hhm).enorm)).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Measurable h →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hhm
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hhm t)]
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp (hptTop2 t x).enorm
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (Fn n) (hFnmeas n) t))
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ) := hsum_in F hFm
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (Fn n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun _ : ℕ => 4 * KE * wMass gam F) Filter.atTop := by
        refine Filter.liminf_le_liminf (Filter.Eventually.of_forall fun n => ?_)
        rw [← hsum_in (Fn n) (hFnmeas n)]
        exact hbdd n
    _ = 4 * KE * wMass gam F := Filter.liminf_const _

/-! ### Hadamard's three lines lemma -/

/-- **Hadamard's three lines lemma**, in the bounded case, which is the one needed for the
interpolation of §3: a function holomorphic on the strip `0 < Re ζ < 1`, continuous up to the
boundary and bounded on the closed strip, whose modulus is at most `M₀` on `Re ζ = 0` and at most
`M₁` on `Re ζ = 1`, satisfies `‖Ψ(θ)‖ ≤ M₀^{1-θ}M₁^{θ}` for `θ ∈ [0,1]`. -/
theorem three_lines {Ψ : ℂ → ℂ} {M0 M1 : ℝ} {θ : ℝ} (hθ0 : 0 ≤ θ) (hθ1 : θ ≤ 1)
    (hM0 : 0 < M0) (hM1 : 0 < M1)
    (hd : DiffContOnCl ℂ Ψ (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1))
    (hbdd : ∃ C : ℝ, ∀ z : ℂ, 0 ≤ z.re → z.re ≤ 1 → ‖Ψ z‖ ≤ C)
    (h0 : ∀ z : ℂ, z.re = 0 → ‖Ψ z‖ ≤ M0)
    (h1 : ∀ z : ℂ, z.re = 1 → ‖Ψ z‖ ≤ M1) :
    ‖Ψ (θ : ℂ)‖ ≤ M0 ^ (1 - θ) * M1 ^ θ := by
  obtain ⟨C, hC⟩ := hbdd
  set Φ : ℂ → ℂ := fun z =>
    Ψ z * Complex.exp ((z - 1) * (Real.log M0 : ℂ)) * Complex.exp (-z * (Real.log M1 : ℂ))
    with hΦ
  -- the modulus of the auxiliary factors
  have hnormΦ : ∀ z : ℂ, ‖Φ z‖ = ‖Ψ z‖ * M0 ^ (z.re - 1) * M1 ^ (-z.re) := by
    intro z
    have h2 : ‖Complex.exp ((z - 1) * (Real.log M0 : ℂ))‖ = M0 ^ (z.re - 1) := by
      rw [Complex.norm_exp]
      have h3 : ((z - 1) * (Real.log M0 : ℂ)).re = (z.re - 1) * Real.log M0 := by
        simp [Complex.mul_re]
      rw [h3, Real.rpow_def_of_pos hM0]
      ring_nf
    have h4 : ‖Complex.exp (-z * (Real.log M1 : ℂ))‖ = M1 ^ (-z.re) := by
      rw [Complex.norm_exp]
      have h5 : (-z * (Real.log M1 : ℂ)).re = (-z.re) * Real.log M1 := by
        simp [Complex.mul_re]
      rw [h5, Real.rpow_def_of_pos hM1]
      ring_nf
    rw [hΦ, norm_mul, norm_mul, h2, h4]
  -- `Φ` is holomorphic on the strip and continuous up to the boundary
  have hdΦ : DiffContOnCl ℂ Φ (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1) := by
    have hent1 : Differentiable ℂ fun z : ℂ => Complex.exp ((z - 1) * (Real.log M0 : ℂ)) :=
      fun z => (Complex.differentiable_exp _).comp z
        (((differentiable_id.sub_const 1).mul_const _) z)
    have hent2 : Differentiable ℂ fun z : ℂ => Complex.exp (-z * (Real.log M1 : ℂ)) :=
      fun z => (Complex.differentiable_exp _).comp z
        (((differentiable_neg.mul_const _)) z)
    refine ⟨(hd.differentiableOn.mul hent1.differentiableOn).mul hent2.differentiableOn, ?_⟩
    exact (hd.continuousOn.mul hent1.continuous.continuousOn).mul
      hent2.continuous.continuousOn
  -- the boundary bounds become `1`
  have hb0 : ∀ z : ℂ, z.re = 0 → ‖Φ z‖ ≤ 1 := by
    intro z hz
    rw [hnormΦ z, hz]
    have h6 : M1 ^ (-(0 : ℝ)) = 1 := by
      rw [neg_zero, Real.rpow_zero]
    rw [h6, mul_one]
    have h7 : ‖Ψ z‖ * M0 ^ ((0 : ℝ) - 1) ≤ M0 * M0 ^ ((0 : ℝ) - 1) :=
      mul_le_mul_of_nonneg_right (h0 z hz) (by positivity)
    refine le_trans h7 (le_of_eq ?_)
    rw [show (0 : ℝ) - 1 = -1 by ring, Real.rpow_neg_one, mul_inv_cancel₀ hM0.ne']
  have hb1 : ∀ z : ℂ, z.re = 1 → ‖Φ z‖ ≤ 1 := by
    intro z hz
    rw [hnormΦ z, hz]
    have h6 : M0 ^ ((1 : ℝ) - 1) = 1 := by
      rw [sub_self, Real.rpow_zero]
    rw [h6, mul_one]
    have h7 : ‖Ψ z‖ * M1 ^ (-(1 : ℝ)) ≤ M1 * M1 ^ (-(1 : ℝ)) :=
      mul_le_mul_of_nonneg_right (h1 z hz) (by positivity)
    refine le_trans h7 (le_of_eq ?_)
    rw [Real.rpow_neg_one, mul_inv_cancel₀ hM1.ne']
  -- the growth hypothesis: `Φ` is bounded on the closed strip
  have hbound : ∃ K : ℝ, ∀ z : ℂ, z ∈ Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1 → ‖Φ z‖ ≤ K := by
    refine ⟨|C| * (1 + M0⁻¹) * (1 + M1⁻¹), fun z hz => ?_⟩
    have hz0 : 0 < z.re := hz.1
    have hz1 : z.re < 1 := hz.2
    have hΨ : ‖Ψ z‖ ≤ |C| := le_trans (hC z (le_of_lt hz0) (le_of_lt hz1)) (le_abs_self C)
    have hp0 : M0 ^ (z.re - 1) ≤ 1 + M0⁻¹ := by
      rcases le_total M0 1 with hle | hle
      · have h8 : M0 ^ (z.re - 1) ≤ M0 ^ (-(1 : ℝ)) := by
          refine Real.rpow_le_rpow_of_exponent_ge hM0 hle ?_
          linarith
        rw [Real.rpow_neg_one] at h8
        linarith
      · have h8 : M0 ^ (z.re - 1) ≤ M0 ^ (0 : ℝ) := by
          refine Real.rpow_le_rpow_of_exponent_le hle ?_
          linarith
        rw [Real.rpow_zero] at h8
        have h9 : (0 : ℝ) ≤ M0⁻¹ := by positivity
        linarith
    have hp1 : M1 ^ (-z.re) ≤ 1 + M1⁻¹ := by
      rcases le_total M1 1 with hle | hle
      · have h8 : M1 ^ (-z.re) ≤ M1 ^ (-(1 : ℝ)) := by
          refine Real.rpow_le_rpow_of_exponent_ge hM1 hle ?_
          linarith
        rw [Real.rpow_neg_one] at h8
        linarith
      · have h8 : M1 ^ (-z.re) ≤ M1 ^ (0 : ℝ) := by
          refine Real.rpow_le_rpow_of_exponent_le hle ?_
          linarith
        rw [Real.rpow_zero] at h8
        have h9 : (0 : ℝ) ≤ M1⁻¹ := by positivity
        linarith
    rw [hnormΦ z]
    have hnn0 : (0 : ℝ) ≤ M0 ^ (z.re - 1) := by positivity
    have hnn1 : (0 : ℝ) ≤ M1 ^ (-z.re) := by positivity
    have hCnn : (0 : ℝ) ≤ |C| := abs_nonneg C
    refine mul_le_mul (mul_le_mul hΨ hp0 hnn0 hCnn) hp1 hnn1 (by positivity)
  obtain ⟨K, hK⟩ := hbound
  have hgrowth : ∃ c < π / (1 - 0), ∃ B : ℝ,
      Φ =O[Filter.comap (abs ∘ Complex.im) Filter.atTop
        ⊓ Filter.principal (Complex.re ⁻¹' Set.Ioo (0 : ℝ) 1)]
        fun z : ℂ => Real.exp (B * Real.exp (c * |z.im|)) := by
    refine ⟨0, by simpa using Real.pi_pos, 0, ?_⟩
    refine Asymptotics.IsBigO.of_bound |K| ?_
    refine Filter.Eventually.filter_mono inf_le_right ?_
    rw [Filter.eventually_principal]
    intro z hz
    have h1 : ‖Φ z‖ ≤ K := hK z hz
    have h2 : ‖(fun z : ℂ => Real.exp (0 * Real.exp (0 * |z.im|))) z‖ = 1 := by
      simp
    rw [h2, mul_one]
    exact le_trans h1 (le_abs_self K)
  have hPL := PhragmenLindelof.vertical_strip (a := (0 : ℝ)) (b := (1 : ℝ))
    (f := Φ) (C := 1) (z := (θ : ℂ)) hdΦ hgrowth hb0 hb1 (by simpa using hθ0) (by simpa using hθ1)
  -- undo the auxiliary factors
  have hval : ‖Φ (θ : ℂ)‖ = ‖Ψ (θ : ℂ)‖ * M0 ^ (θ - 1) * M1 ^ (-θ) := by
    rw [hnormΦ]
    simp
  rw [hval] at hPL
  have hpos0 : (0 : ℝ) < M0 ^ (θ - 1) := Real.rpow_pos_of_pos hM0 _
  have hpos1 : (0 : ℝ) < M1 ^ (-θ) := Real.rpow_pos_of_pos hM1 _
  have hmul : ‖Ψ (θ : ℂ)‖ ≤ (M0 ^ (θ - 1) * M1 ^ (-θ))⁻¹ := by
    rw [inv_eq_one_div, le_div_iff₀ (by positivity : (0 : ℝ) < M0 ^ (θ - 1) * M1 ^ (-θ))]
    calc ‖Ψ (θ : ℂ)‖ * (M0 ^ (θ - 1) * M1 ^ (-θ))
        = ‖Ψ (θ : ℂ)‖ * M0 ^ (θ - 1) * M1 ^ (-θ) := by ring
      _ ≤ 1 := hPL
  refine le_trans hmul (le_of_eq ?_)
  rw [mul_inv, ← Real.rpow_neg_one (M0 ^ (θ - 1)), ← Real.rpow_neg_one (M1 ^ (-θ)),
    ← Real.rpow_mul hM0.le, ← Real.rpow_mul hM1.le]
  congr 1
  · congr 1
    ring
  · congr 1
    ring

/-! ### The pairing on the output side, and its two endpoint bounds -/

/-- The pairing `⟨𝒯_jF, φ⟩` over `ℝ² × ℰ`. -/
noncomputable def pairT (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (Efin : Finset ℝ) (F : Pl2 → ℂ)
    (φ : ℝ → Pl → ℂ) : ℂ :=
  ∑ t ∈ Efin, ∫ x : Pl, Top2 j ε m t F x * φ t x

/-- The `ℓ²L²` norm on the output side. -/
noncomputable def outL2 (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ) : ℝ≥0∞ :=
  (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)

/-- The `ℓ¹L¹` norm on the output side. -/
noncomputable def outL1 (Efin : Finset ℝ) (φ : ℝ → Pl → ℂ) : ℝ≥0∞ :=
  ∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ

/-- **The `L^∞` endpoint for the pairing.** -/
theorem enorm_pairT_le_sup {j : ℕ} {m : ℝ → Pl → ℂ} (ε : ℝ) (Efin : Finset ℝ)
    (F : Pl2 → ℂ) (φ : ℝ → Pl → ℂ) {Bv : ℝ≥0∞} (hBv : Bv ≠ ⊤)
    (hB : ∀ t ∈ Efin, ∀ x : Pl, ‖Top2 j ε m t F x‖ₑ ≤ Bv) :
    ‖pairT j ε m Efin F φ‖ₑ ≤ Bv * outL1 Efin φ := by
  rw [pairT, outL1, Finset.mul_sum]
  refine le_trans (enorm_sum_le _ _) ?_
  refine Finset.sum_le_sum fun t ht => ?_
  refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
  rw [← lintegral_const_mul' _ _ hBv]
  refine lintegral_mono fun x => ?_
  rw [enorm_mul]
  exact mul_le_mul' (hB t ht x) (le_refl _)

/-- **The `L²` endpoint for the pairing.** -/
theorem enorm_pairT_le_L2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε : ℝ) (Efin : Finset ℝ)
    {F : Pl2 → ℂ} (hFm : Measurable F) {φ : ℝ → Pl → ℂ} (hφm : ∀ t : ℝ, Measurable (φ t))
    {Av : ℝ≥0∞}
    (hA : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) ≤ Av) :
    ‖pairT j ε m Efin F φ‖ₑ ≤ Av * outL2 Efin φ := by
  classical
  -- the pointwise Hölder in `x`, for each `t`
  have hstep : ∀ t : ℝ, ‖∫ x : Pl, Top2 j ε m t F x * φ t x‖ₑ
      ≤ (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
    intro t
    refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
    have heq : ∀ x : Pl, ‖Top2 j ε m t F x * φ t x‖ₑ
        = ((fun x => ‖Top2 j ε m t F x‖ₑ) * (fun x => ‖φ t x‖ₑ)) x := by
      intro x
      change ‖Top2 j ε m t F x * φ t x‖ₑ = ‖Top2 j ε m t F x‖ₑ * ‖φ t x‖ₑ
      rw [enorm_mul]
    rw [lintegral_congr heq]
    exact ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl) Real.HolderConjugate.two_two
      ((measurable_Top2 hm ε t hFm).enorm.aemeasurable) ((hφm t).enorm.aemeasurable)
  -- the discrete Cauchy--Schwarz over `ℰ`
  have hCS : (∑ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      ≤ (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
    have h := ENNReal.inner_le_Lp_mul_Lq (s := Efin)
      (f := fun t => (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      (g := fun t => (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2))
      (p := 2) (q := 2) Real.HolderConjugate.two_two
    have hsq : ∀ (y : ℝ≥0∞), (y ^ ((1 : ℝ) / 2)) ^ (2 : ℝ) = y := by
      intro y
      rw [← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one]
    simp only [hsq] at h
    exact h
  calc ‖pairT j ε m Efin F φ‖ₑ
      ≤ ∑ t ∈ Efin, ‖∫ x : Pl, Top2 j ε m t F x * φ t x‖ₑ := by
        rw [pairT]
        exact enorm_sum_le _ _
    _ ≤ ∑ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
          * (∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) :=
        Finset.sum_le_sum fun t _ => hstep t
    _ ≤ (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t F x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
          * (∑ t ∈ Efin, ∫⁻ x : Pl, ‖φ t x‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := hCS
    _ ≤ Av * outL2 Efin φ := by
        rw [outL2]
        exact mul_le_mul' hA (le_refl _)

/-! ### Base--fibre coordinates for the weighted mass -/

theorem sepFst_pr_mk2 (y1 y2 z1 z2 : ℝ) :
    sepFst (pr (mk2 y1 y2) (mk2 z1 z2)) = y1 - z1 := by
  change ((mk2 y1 y2 - mk2 z1 z2 : Pl)) 0 = y1 - z1
  rw [mk2_sub_mk2, mk2_apply_zero]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The weighted mass in base--fibre coordinates: the base variables `(y₁,z₁)` outside, the fibre
variables `(y₂,z₂)` inside. -/
theorem wMass1_iter {gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    wMass1 gam F
      = ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
          ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (2 : ℝ)
            * ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) := by
  classical
  set Gfun : Pl2 → ℝ≥0∞ := fun x =>
    ‖F x‖ₑ ^ (2 : ℝ) * ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1)) with hGfun
  have hsepmeas : Measurable fun x : Pl2 => ((sepCLM x) 0 : ℝ) :=
    sepFst.continuous.measurable
  have hGmeas : Measurable Gfun := by
    rw [hGfun]
    exact ((hF.enorm).pow_const _).mul ((hsepmeas.enorm).pow_const _)
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  -- step 1: iterate over `Pl × Pl`
  have h1 : wMass1 gam F = ∫⁻ y : Pl, ∫⁻ z : Pl, Gfun (pr y z) := by
    rw [wMass1, ← hGfun]
    exact (lintegral_pr Gfun hGmeas).symm
  -- step 2: split each `Pl` into its two coordinates
  have h2 : ∀ y : Pl, (∫⁻ z : Pl, Gfun (pr y z))
      = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
    intro y
    refine lintegral_Pl_eq_prod _ ?_
    exact hGmeas.comp (hprmeas.comp (measurable_const.prodMk measurable_id))
  have h3 : (∫⁻ y : Pl, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)))
      = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    refine lintegral_Pl_eq_prod _ ?_
    have hjoint : Measurable fun w : Pl × (ℝ × ℝ) => Gfun (pr w.1 (mk2 w.2.1 w.2.2)) := by
      refine hGmeas.comp (hprmeas.comp ?_)
      exact measurable_fst.prodMk
        (continuous_mk2.measurable.comp measurable_snd)
    have hstep : Measurable fun y : Pl => ∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)) :=
      hjoint.lintegral_prod_right'
    have heq : ∀ y : Pl, (∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)))
        = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
      intro y
      rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
      exact (hGmeas.comp (hprmeas.comp (measurable_const.prodMk
        (continuous_mk2.measurable)))).aemeasurable
    simpa [heq] using hstep
  -- step 3: swap the two inner variables `y₂` and `z₁`
  have h4 : ∀ y1 : ℝ, (∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)))
      = ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    intro y1
    refine lintegral_lintegral_swap ?_
    have hjoint : Measurable fun w : ℝ × ℝ => ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 w.1) (mk2 w.2 z2)) := by
      have h5 : Measurable fun v : (ℝ × ℝ) × ℝ =>
          Gfun (pr (mk2 y1 v.1.1) (mk2 v.1.2 v.2)) := by
        refine hGmeas.comp (hprmeas.comp ?_)
        refine Measurable.prodMk ?_ ?_
        · exact continuous_mk2.measurable.comp
            (measurable_const.prodMk (measurable_fst.comp measurable_fst))
        · exact continuous_mk2.measurable.comp
            ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
      exact h5.lintegral_prod_right'
    exact hjoint.aemeasurable
  rw [h1, lintegral_congr h2, h3, lintegral_congr h4]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  refine lintegral_congr fun y2 => ?_
  refine lintegral_congr fun z2 => ?_
  have hsep : ((sepCLM (pr (mk2 y1 y2) (mk2 z1 z2))) 0 : ℝ) = y1 - z1 := sepFst_pr_mk2 y1 y2 z1 z2
  simp only [hGfun, hsep]

/-! ### The algebra of the Calderón factorization -/

/-- `Φ·Ψ₁ = u^{p'}` with `u = WΦ`, `Ψ₁ = W u^{p'-1}`. -/
theorem calderon_alg1 {p : ℝ} (hp : 2 < p) (W Ph : ℝ≥0∞) :
    Ph * (W * (W * Ph) ^ (p / (p - 1) - 1)) = (W * Ph) ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hstep : Ph * (W * (W * Ph) ^ (p / (p - 1) - 1))
      = (W * Ph) ^ (1 : ℝ) * (W * Ph) ^ (p / (p - 1) - 1) := by
    rw [ENNReal.rpow_one]
    ring
  rw [hstep, ← ENNReal.rpow_add_of_nonneg _ _ (by norm_num) (by linarith)]
  congr 1
  ring

/-- `Ψ₀²Φ²W^p = u^{p'}` with `Ψ₀ = Ψ₁^{-(p-2)/2}`, i.e. `Ψ₀² = Ψ₁^{-(p-2)}`.  This is the
identity that makes the `L²` norm of the first Calderón factor equal to the interpolated norm. -/
theorem calderon_alg2 {p : ℝ} (hp : 2 < p) {W Ph : ℝ≥0∞} (hW0 : W ≠ 0) (hWt : W ≠ ⊤)
    (hPht : Ph ≠ ⊤) :
    (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2)) * (Ph ^ (2 : ℝ) * W ^ p)
      = (W * Ph) ^ (p / (p - 1)) := by
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hexp : 2 - (p / (p - 1) - 1) * (p - 2) = p / (p - 1) := by
    field_simp
    ring
  rcases eq_or_ne Ph 0 with hPh0 | hPh0
  · rw [hPh0]
    have h1 : ((0 : ℝ≥0∞)) ^ (2 : ℝ) = 0 := ENNReal.zero_rpow_of_pos (by norm_num)
    have h2 : (W * (0 : ℝ≥0∞)) ^ (p / (p - 1)) = 0 := by
      rw [mul_zero, ENNReal.zero_rpow_of_pos (by linarith)]
    rw [h1, h2, zero_mul, mul_zero]
  · -- the nondegenerate case
    have hu0 : W * Ph ≠ 0 := mul_ne_zero hW0 hPh0
    have hut : W * Ph ≠ ⊤ := ENNReal.mul_ne_top hWt hPht
    have hpow0 : (W * Ph) ^ (p / (p - 1) - 1) ≠ 0 := by
      rw [ne_eq, ENNReal.rpow_eq_zero_iff]
      intro hcon
      rcases hcon with hc | hc
      · exact hu0 hc.1
      · exact hut hc.1
    have hpowt : (W * Ph) ^ (p / (p - 1) - 1) ≠ ⊤ :=
      ENNReal.rpow_ne_top_of_nonneg (by linarith) hut
    -- expand the first factor
    have h1 : (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2))
        = W ^ (-(p - 2)) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2))) := by
      rw [ENNReal.mul_rpow_of_ne_top hWt hpowt, ← ENNReal.rpow_mul]
    -- combine the `W` powers
    have h2 : W ^ (-(p - 2)) * W ^ p = W ^ (2 : ℝ) := by
      rw [← ENNReal.rpow_add _ _ hW0 hWt]
      congr 1
      ring
    have h3 : W ^ (2 : ℝ) * Ph ^ (2 : ℝ) = (W * Ph) ^ (2 : ℝ) :=
      (ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)).symm
    have h4 : (W * Ph) ^ (2 : ℝ) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2)))
        = (W * Ph) ^ (p / (p - 1)) := by
      rw [← ENNReal.rpow_add _ _ hu0 hut]
      congr 1
      have h5 : (2 : ℝ) + (p / (p - 1) - 1) * (-(p - 2)) = 2 - (p / (p - 1) - 1) * (p - 2) := by
        ring
      rw [h5, hexp]
    calc (W * (W * Ph) ^ (p / (p - 1) - 1)) ^ (-(p - 2)) * (Ph ^ (2 : ℝ) * W ^ p)
        = (W ^ (-(p - 2)) * W ^ p) * (Ph ^ (2 : ℝ)
            * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2)))) := by
          rw [h1]
          ring
      _ = ((W * Ph) ^ (2 : ℝ)) * (W * Ph) ^ ((p / (p - 1) - 1) * (-(p - 2))) := by
          rw [h2, ← h3]
          ring
      _ = (W * Ph) ^ (p / (p - 1)) := h4

/-! ### The Calderón factorization: the base data -/

/-- The fibre `L^p` profile of `F` at the base point `(y₁,z₁)`. -/
noncomputable def fibProf (p : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p) ^ (1 / p)

/-- The base weight `W = |y₁-z₁|^{(1-2γ)/p}` of the interpolated norm. -/
noncomputable def wtB (p gam y1 z1 : ℝ) : ℝ≥0∞ := ‖(y1 - z1 : ℝ)‖ₑ ^ ((1 - 2 * gam) / p)

/-- `u = WΦ`. -/
noncomputable def uB (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  wtB p gam y1 z1 * fibProf p F y1 z1

/-- The `p'`-th power of the interpolated norm `N_p(F)` of §3. -/
noncomputable def normNpp (p gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, (uB p gam F y1 z1) ^ (p / (p - 1))

/-- The second Calderón factor `Ψ₁ = W u^{p'-1}`. -/
noncomputable def psi1B (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  wtB p gam y1 z1 * (uB p gam F y1 z1) ^ (p / (p - 1) - 1)

/-- The first Calderón factor `Ψ₀ = Ψ₁^{-(p-2)/2}`. -/
noncomputable def psi0B (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  (psi1B p gam F y1 z1) ^ (-(p - 2) / 2)

/-- The modulus of the first factor of the Calderón family. -/
noncomputable def gZero (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 y2 z2 : ℝ) : ℝ≥0∞ :=
  ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2) * fibProf p F y1 z1 ^ (1 - p / 2)
    * psi0B p gam F y1 z1

/-- The modulus of the second factor of the Calderón family; it does not depend on the fibre
variables. -/
noncomputable def gOne (p gam : ℝ) (F : Pl2 → ℂ) (y1 z1 : ℝ) : ℝ≥0∞ :=
  fibProf p F y1 z1 * psi1B p gam F y1 z1

theorem fibProf_pow {p : ℝ} (hp : 0 < p) (F : Pl2 → ℂ) (y1 z1 : ℝ) :
    (fibProf p F y1 z1) ^ p = ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
      ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
  rw [fibProf, ← ENNReal.rpow_mul, one_div, inv_mul_cancel₀ hp.ne', ENNReal.rpow_one]

theorem wtB_pow {p gam : ℝ} (hp : 0 < p) (y1 z1 : ℝ) :
    (wtB p gam y1 z1) ^ p = ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) := by
  rw [wtB, ← ENNReal.rpow_mul, div_mul_cancel₀ _ hp.ne']
  congr 1
  ring

theorem wtB_ne_zero {p gam : ℝ} (_hp : 0 < p) (_hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 ≠ z1) :
    wtB p gam y1 z1 ≠ 0 := by
  rw [wtB, ne_eq, ENNReal.rpow_eq_zero_iff]
  intro hcon
  rcases hcon with hc | hc
  · rw [enorm_eq_zero, sub_eq_zero] at hc
    exact h hc.1
  · exact (by simpa using hc.1 : ‖(y1 - z1 : ℝ)‖ₑ = ⊤) |> fun hh => absurd hh enorm_ne_top

theorem wtB_ne_top {p gam : ℝ} (_hp : 0 < p) (_hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 ≠ z1) :
    wtB p gam y1 z1 ≠ ⊤ := by
  have hne : ‖(y1 - z1 : ℝ)‖ₑ ≠ 0 := by
    rw [ne_eq, enorm_eq_zero, sub_eq_zero]
    exact h
  rw [wtB, ne_eq, ENNReal.rpow_eq_top_iff]
  intro hcon
  rcases hcon with hc | hc
  · exact hne hc.1
  · exact absurd hc.1 enorm_ne_top

theorem measurable_fibProf {p : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => fibProf p F a.1 a.2 := by
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have hjoint : Measurable fun v : (ℝ × ℝ) × (ℝ × ℝ) =>
      ‖F (pr (mk2 v.1.1 v.2.1) (mk2 v.1.2 v.2.2))‖ₑ ^ p := by
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    refine Measurable.prodMk ?_ ?_
    · exact continuous_mk2.measurable.comp
        ((measurable_fst.comp measurable_fst).prodMk (measurable_fst.comp measurable_snd))
    · exact continuous_mk2.measurable.comp
        ((measurable_snd.comp measurable_fst).prodMk (measurable_snd.comp measurable_snd))
  have hinner : Measurable fun a : ℝ × ℝ => ∫⁻ r : ℝ × ℝ,
      ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p := hjoint.lintegral_prod_right'
  have heq : ∀ a : ℝ × ℝ, (∫⁻ r : ℝ × ℝ, ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p)
      = ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖F (pr (mk2 a.1 y2) (mk2 a.2 z2))‖ₑ ^ p := by
    intro a
    rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
    refine (Measurable.aemeasurable ?_)
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    exact (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_fst)).prodMk
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_snd))
  have hfib : ∀ a : ℝ × ℝ, fibProf p F a.1 a.2
      = (∫⁻ r : ℝ × ℝ, ‖F (pr (mk2 a.1 r.1) (mk2 a.2 r.2))‖ₑ ^ p) ^ (1 / p) := by
    intro a
    rw [fibProf, heq a]
  simp only [hfib]
  exact hinner.pow_const _

theorem measurable_wtB (p gam : ℝ) : Measurable fun a : ℝ × ℝ => wtB p gam a.1 a.2 := by
  have h1 : Measurable fun a : ℝ × ℝ => ‖(a.1 - a.2 : ℝ)‖ₑ :=
    ((measurable_fst.sub measurable_snd).enorm)
  exact h1.pow_const _

theorem measurable_uB {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => uB p gam F a.1 a.2 :=
  (measurable_wtB p gam).mul (measurable_fibProf hF)

theorem measurable_psi1B {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => psi1B p gam F a.1 a.2 :=
  (measurable_wtB p gam).mul ((measurable_uB hF).pow_const _)

theorem measurable_psi0B {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => psi0B p gam F a.1 a.2 :=
  (measurable_psi1B hF).pow_const _

theorem measurable_gOne {p gam : ℝ} {F : Pl2 → ℂ} (hF : Measurable F) :
    Measurable fun a : ℝ × ℝ => gOne p gam F a.1 a.2 :=
  (measurable_fibProf hF).mul (measurable_psi1B hF)

/-! ### The two norm identities of the Calderón factorization -/

theorem gOne_eq (p gam : ℝ) (hp : 2 < p) (F : Pl2 → ℂ) (y1 z1 : ℝ) :
    gOne p gam F y1 z1 = (uB p gam F y1 z1) ^ (p / (p - 1)) := by
  rw [gOne, psi1B, uB]
  exact calderon_alg1 hp (wtB p gam y1 z1) (fibProf p F y1 z1)

/-- **The `X₁` norm of the second Calderón factor** is the interpolated norm. -/
theorem lintegral_gOne (p gam : ℝ) (hp : 2 < p) (F : Pl2 → ℂ) :
    (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, gOne p gam F y1 z1) = normNpp p gam F := by
  rw [normNpp]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  exact gOne_eq p gam hp F y1 z1

theorem ae_ne_of_singleton (y1 : ℝ) : ∀ᵐ z1 : ℝ, z1 ≠ y1 := by
  rw [Filter.eventually_iff_exists_mem]
  refine ⟨{y1}ᶜ, ?_, fun z1 hz1 => hz1⟩
  rw [mem_ae_iff, compl_compl]
  exact measure_singleton y1

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The `X₀` norm of the first Calderón factor** is the interpolated norm. -/
theorem lintegral_gZero_sq_weight {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam)
    {F : Pl2 → ℂ} (hF : Measurable F) (hfin : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) :
    (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
        (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)))
      = normNpp p gam F := by
  have hppos : (0 : ℝ) < p := by linarith
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  rw [normNpp]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr_ae ?_
  filter_upwards [ae_ne_of_singleton y1] with z1 hz1
  have hne : y1 ≠ z1 := fun hc => hz1 hc.symm
  -- the inner integral in the fibre variables
  have hmeasF2 : ∀ y2 : ℝ, Measurable fun z2 : ℝ =>
      ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    intro y2
    refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
    exact measurable_const.prodMk
      (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_id))
  have hmeasF1 : Measurable fun y2 : ℝ =>
      ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    have hjoint : Measurable fun v : ℝ × ℝ =>
        ‖F (pr (mk2 y1 v.1) (mk2 z1 v.2))‖ₑ ^ p := by
      refine ((hF.comp (hprmeas.comp ?_)).enorm).pow_const _
      exact (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_fst)).prodMk
        (continuous_mk2.measurable.comp (measurable_const.prodMk measurable_snd))
    exact hjoint.lintegral_prod_right'
  set C : ℝ≥0∞ := fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1 with hC
  set W2 : ℝ≥0∞ := ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) with hW2
  have hsq : ∀ y2 z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2
      = (C ^ (2 : ℝ) * W2) * ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
    intro y2 z2
    rw [gZero, hC]
    have h1 : (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)
          * fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1) ^ (2 : ℝ)
        = (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)) ^ (2 : ℝ)
          * (fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1) ^ (2 : ℝ) := by
      rw [← ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ))]
      congr 1
      ring
    have h2 : (‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ (p / 2)) ^ (2 : ℝ)
        = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
      rw [← ENNReal.rpow_mul]
      congr 1
      ring
    rw [h1, h2]
    ring
  have hinner : (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2)
      = (C ^ (2 : ℝ) * W2) * (fibProf p F y1 z1) ^ p := by
    have hstep1 : ∀ y2 : ℝ, (∫⁻ z2 : ℝ, (gZero p gam F y1 z1 y2 z2) ^ (2 : ℝ) * W2)
        = (C ^ (2 : ℝ) * W2) * ∫⁻ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ ^ p := by
      intro y2
      rw [lintegral_congr (fun z2 => hsq y2 z2), lintegral_const_mul _ (hmeasF2 y2)]
    rw [lintegral_congr hstep1, lintegral_const_mul _ hmeasF1, fibProf_pow hppos]
  rw [hinner, hC]
  -- the base algebra
  have hfib : fibProf p F y1 z1 ^ (1 - p / 2) * psi0B p gam F y1 z1 = C := by rw [hC]
  have hexpand : (C ^ (2 : ℝ) * W2) * (fibProf p F y1 z1) ^ p
      = (psi1B p gam F y1 z1) ^ (-(p - 2))
        * ((fibProf p F y1 z1) ^ (2 : ℝ) * (wtB p gam y1 z1) ^ p) := by
    have h1 : C ^ (2 : ℝ) = (fibProf p F y1 z1) ^ (2 - p) * (psi1B p gam F y1 z1) ^ (-(p - 2)) := by
      rw [hC, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ)), psi0B,
        ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
      congr 2
      · ring
      · ring
    have h2 : (fibProf p F y1 z1) ^ (2 - p) * (fibProf p F y1 z1) ^ p
        = (fibProf p F y1 z1) ^ (2 : ℝ) := by
      rcases eq_or_ne (fibProf p F y1 z1) 0 with h0 | h0
      · rw [h0]
        have e1 : (0 : ℝ≥0∞) ^ (2 - p) = ⊤ := ENNReal.zero_rpow_of_neg (by linarith)
        have e2 : (0 : ℝ≥0∞) ^ p = 0 := ENNReal.zero_rpow_of_pos hppos
        have e3 : (0 : ℝ≥0∞) ^ (2 : ℝ) = 0 := ENNReal.zero_rpow_of_pos (by norm_num)
        rw [e1, e2, e3, mul_zero]
      · rw [← ENNReal.rpow_add _ _ h0 (hfin y1 z1)]
        congr 1
        ring
    have hW2eq : W2 = (wtB p gam y1 z1) ^ p := by
      rw [hW2, wtB_pow hppos]
    rw [h1, hW2eq]
    calc (fibProf p F y1 z1) ^ (2 - p) * (psi1B p gam F y1 z1) ^ (-(p - 2))
          * (wtB p gam y1 z1) ^ p * (fibProf p F y1 z1) ^ p
        = (psi1B p gam F y1 z1) ^ (-(p - 2))
            * (((fibProf p F y1 z1) ^ (2 - p) * (fibProf p F y1 z1) ^ p)
              * (wtB p gam y1 z1) ^ p) := by ring
      _ = (psi1B p gam F y1 z1) ^ (-(p - 2))
            * ((fibProf p F y1 z1) ^ (2 : ℝ) * (wtB p gam y1 z1) ^ p) := by rw [h2]
  rw [hexpand, psi1B, uB]
  exact calderon_alg2 hp (wtB_ne_zero hppos hgam1 hne) (wtB_ne_top hppos hgam1 hne) (hfin y1 z1)

/-! ### The pointwise Calderón factorization -/

theorem psi1B_ne_zero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (hpos : fibProf p F y1 z1 ≠ 0) : psi1B p gam F y1 z1 ≠ 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have hW0 := wtB_ne_zero hppos hgam1 hne (p := p) (gam := gam)
  have hWt := wtB_ne_top hppos hgam1 hne (p := p) (gam := gam)
  have hu0 : uB p gam F y1 z1 ≠ 0 := mul_ne_zero hW0 hpos
  have hut : uB p gam F y1 z1 ≠ ⊤ := ENNReal.mul_ne_top hWt hfin
  rw [psi1B, ne_eq, mul_eq_zero]
  intro hcon
  rcases hcon with hc | hc
  · exact hW0 hc
  · rw [ENNReal.rpow_eq_zero_iff] at hc
    rcases hc with hc | hc
    · exact hu0 hc.1
    · exact hut hc.1

theorem psi1B_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (_hpos : fibProf p F y1 z1 ≠ 0) : psi1B p gam F y1 z1 ≠ ⊤ := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  have hW0 := wtB_ne_zero hppos hgam1 hne (p := p) (gam := gam)
  have hWt := wtB_ne_top hppos hgam1 hne (p := p) (gam := gam)
  have hut : uB p gam F y1 z1 ≠ ⊤ := ENNReal.mul_ne_top hWt hfin
  rw [psi1B]
  refine ENNReal.mul_ne_top hWt ?_
  exact ENNReal.rpow_ne_top_of_nonneg (by linarith) hut

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The Calderón factorization.**  `|F| = G₀^{2/p} G₁^{1-2/p}` at every point where the fibre
profile is finite and nonzero, and the base point is off the diagonal. -/
theorem calderon_factorization {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤)
    (hpos : fibProf p F y1 z1 ≠ 0) (y2 z2 : ℝ) :
    (gZero p gam F y1 z1 y2 z2) ^ (2 / p) * (gOne p gam F y1 z1) ^ (1 - 2 / p)
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := by positivity
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  have hP0 : psi1B p gam F y1 z1 ≠ 0 := psi1B_ne_zero hp hgam1 hne hfin hpos
  have hPt : psi1B p gam F y1 z1 ≠ ⊤ := psi1B_ne_top hp hgam1 hne hfin hpos
  -- expand the two factors
  have hA : (gZero p gam F y1 z1 y2 z2) ^ (2 / p)
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * ((fibProf p F y1 z1) ^ ((2 - p) / p) * (psi1B p gam F y1 z1) ^ (-((p - 2) / p))) := by
    rw [gZero, ENNReal.mul_rpow_of_nonneg _ _ h2p.le, ENNReal.mul_rpow_of_nonneg _ _ h2p.le,
      psi0B, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, ← ENNReal.rpow_mul]
    have e1 : p / 2 * (2 / p) = 1 := by field_simp
    have e2 : (1 - p / 2) * (2 / p) = (2 - p) / p := by field_simp
    have e3 : -(p - 2) / 2 * (2 / p) = -((p - 2) / p) := by field_simp
    rw [e1, e2, e3, ENNReal.rpow_one, mul_assoc]
  have hB : (gOne p gam F y1 z1) ^ (1 - 2 / p)
      = (fibProf p F y1 z1) ^ ((p - 2) / p) * (psi1B p gam F y1 z1) ^ ((p - 2) / p) := by
    rw [gOne, ENNReal.mul_rpow_of_nonneg _ _ h2p'.le]
    have e4 : (1 : ℝ) - 2 / p = (p - 2) / p := by field_simp
    rw [e4]
  rw [hA, hB]
  -- combine the powers of the profile and of `Ψ₁`
  have hfibcomb : (fibProf p F y1 z1) ^ ((2 - p) / p) * (fibProf p F y1 z1) ^ ((p - 2) / p) = 1 :=
      by
    rw [← ENNReal.rpow_add _ _ hpos hfin]
    have e5 : (2 - p) / p + (p - 2) / p = 0 := by
      field_simp
      ring
    rw [e5, ENNReal.rpow_zero]
  have hpsicomb : (psi1B p gam F y1 z1) ^ (-((p - 2) / p))
      * (psi1B p gam F y1 z1) ^ ((p - 2) / p) = 1 := by
    rw [← ENNReal.rpow_add _ _ hP0 hPt]
    have e6 : -((p - 2) / p) + (p - 2) / p = 0 := by ring
    rw [e6, ENNReal.rpow_zero]
  calc ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * ((fibProf p F y1 z1) ^ ((2 - p) / p) * (psi1B p gam F y1 z1) ^ (-((p - 2) / p)))
        * ((fibProf p F y1 z1) ^ ((p - 2) / p) * (psi1B p gam F y1 z1) ^ ((p - 2) / p))
      = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ
        * (((fibProf p F y1 z1) ^ ((2 - p) / p) * (fibProf p F y1 z1) ^ ((p - 2) / p))
          * ((psi1B p gam F y1 z1) ^ (-((p - 2) / p))
            * (psi1B p gam F y1 z1) ^ ((p - 2) / p))) := by ring
    _ = ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ := by
        rw [hfibcomb, hpsicomb, mul_one, mul_one]

/-- In the degenerate case where the fibre profile vanishes, both Calderón factors vanish. -/
theorem calderon_factorization_zero {p gam : ℝ} (hp : 2 < p) {F : Pl2 → ℂ}
    {y1 z1 : ℝ} (hzero : fibProf p F y1 z1 = 0) (y2 z2 : ℝ) :
    (gZero p gam F y1 z1 y2 z2) ^ (2 / p) * (gOne p gam F y1 z1) ^ (1 - 2 / p) = 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  have hg1 : gOne p gam F y1 z1 = 0 := by
    rw [gOne, hzero, zero_mul]
  rw [hg1, ENNReal.zero_rpow_of_pos h2p', mul_zero]

/-! ### Complex powers of nonnegative reals, and unimodular signs -/

/-- The complex power `r^w` of a nonnegative real, with the convention `0^w = 0`. -/
noncomputable def rpowC (r : ℝ) (w : ℂ) : ℂ :=
  if r = 0 then 0 else Complex.exp (w * (Real.log r : ℂ))

@[simp] theorem rpowC_zero_base (w : ℂ) : rpowC 0 w = 0 := by
  rw [rpowC, if_pos rfl]

theorem rpowC_of_pos {r : ℝ} (hr : 0 < r) (w : ℂ) :
    rpowC r w = Complex.exp (w * (Real.log r : ℂ)) := by
  rw [rpowC, if_neg hr.ne']

theorem norm_rpowC {r : ℝ} (hr : 0 < r) (w : ℂ) : ‖rpowC r w‖ = r ^ w.re := by
  rw [rpowC_of_pos hr, Complex.norm_exp]
  have h1 : (w * (Real.log r : ℂ)).re = w.re * Real.log r := by
    simp [Complex.mul_re]
  rw [h1, Real.rpow_def_of_pos hr]
  ring_nf

theorem norm_rpowC_nonneg {r : ℝ} (hr : 0 ≤ r) (w : ℂ) : ‖rpowC r w‖ = r ^ w.re ∨ r = 0 := by
  rcases eq_or_lt_of_le hr with h | h
  · exact Or.inr h.symm
  · exact Or.inl (norm_rpowC h w)

theorem rpowC_one {r : ℝ} (hr : 0 < r) : rpowC r 1 = (r : ℂ) := by
  rw [rpowC_of_pos hr, one_mul, ← Complex.ofReal_exp, Real.exp_log hr]

theorem rpowC_add (r : ℝ) (a b : ℂ) : rpowC r (a + b) = rpowC r a * rpowC r b := by
  rcases eq_or_ne r 0 with hr | hr
  · rw [hr, rpowC_zero_base, rpowC_zero_base, rpowC_zero_base, mul_zero]
  · rw [rpowC, rpowC, rpowC, if_neg hr, if_neg hr, if_neg hr, ← Complex.exp_add]
    congr 1
    ring

theorem differentiable_rpowC (r : ℝ) : Differentiable ℂ (rpowC r) := by
  rcases eq_or_ne r 0 with hr | hr
  · have h : rpowC r = fun _ : ℂ => (0 : ℂ) := by
      funext w
      rw [hr, rpowC_zero_base]
    rw [h]
    exact differentiable_const 0
  · have h : rpowC r = fun w : ℂ => Complex.exp (w * (Real.log r : ℂ)) := by
      funext w
      rw [rpowC, if_neg hr]
    rw [h]
    exact fun w => (Complex.differentiable_exp _).comp w ((differentiable_id.mul_const _) w)

/-- The unimodular sign of a complex number, with `signC 0 = 0`. -/
noncomputable def signC (z : ℂ) : ℂ := if z = 0 then 0 else z / (‖z‖ : ℂ)

theorem signC_zero : signC 0 = 0 := by
  rw [signC, if_pos rfl]

theorem norm_signC_of_ne {z : ℂ} (h : z ≠ 0) : ‖signC z‖ = 1 := by
  rw [signC, if_neg h, norm_div, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (norm_nonneg z), div_self (norm_ne_zero_iff.mpr h)]

theorem norm_signC_le_one (z : ℂ) : ‖signC z‖ ≤ 1 := by
  rcases eq_or_ne z 0 with h | h
  · rw [h, signC_zero, norm_zero]
    norm_num
  · rw [norm_signC_of_ne h]

theorem signC_mul_norm (z : ℂ) : signC z * (‖z‖ : ℂ) = z := by
  rcases eq_or_ne z 0 with h | h
  · rw [h, signC_zero, zero_mul]
  · rw [signC, if_neg h, div_mul_cancel₀]
    exact Complex.ofReal_ne_zero.mpr (norm_ne_zero_iff.mpr h)

theorem measurable_signC : Measurable signC := by
  classical
  have h : signC = fun z : ℂ => if z = 0 then 0 else z / (‖z‖ : ℂ) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_id measurable_const) measurable_const ?_
  exact measurable_id.div (Complex.measurable_ofReal.comp measurable_id.norm)

theorem measurable_rpowC (w : ℂ) : Measurable fun r : ℝ => rpowC r w := by
  classical
  have h : (fun r : ℝ => rpowC r w)
      = fun r : ℝ => if r = 0 then 0 else Complex.exp (w * (Real.log r : ℂ)) := rfl
  rw [h]
  refine Measurable.ite (measurableSet_eq_fun measurable_id measurable_const) measurable_const ?_
  exact (Complex.measurable_exp.comp
    ((Complex.measurable_ofReal.comp Real.measurable_log).const_mul w))

/-! ### The Calderón family -/

/-- The first base coordinate `y₁` of a point of `ℝ⁴`. -/
def bs1 (q : Pl2) : ℝ := (prjL q) 0
/-- The first fibre coordinate `y₂`. -/
def fb1 (q : Pl2) : ℝ := (prjL q) 1
/-- The second base coordinate `z₁`. -/
def bs2 (q : Pl2) : ℝ := (prjR q) 0
/-- The second fibre coordinate `z₂`. -/
def fb2 (q : Pl2) : ℝ := (prjR q) 1

theorem pr_bs_fb (q : Pl2) : pr (mk2 (bs1 q) (fb1 q)) (mk2 (bs2 q) (fb2 q)) = q := by
  rw [bs1, fb1, bs2, fb2, mk2_coords, mk2_coords, pr_prj]

theorem measurable_bs1 : Measurable bs1 :=
  ((EuclideanSpace.proj (0 : Fin 2)).comp prjL).continuous.measurable
theorem measurable_fb1 : Measurable fb1 :=
  ((EuclideanSpace.proj (1 : Fin 2)).comp prjL).continuous.measurable
theorem measurable_bs2 : Measurable bs2 :=
  ((EuclideanSpace.proj (0 : Fin 2)).comp prjR).continuous.measurable
theorem measurable_fb2 : Measurable fb2 :=
  ((EuclideanSpace.proj (1 : Fin 2)).comp prjR).continuous.measurable

theorem gOne_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0) :
    gOne p gam F y1 z1 ≠ ⊤ := by
  rw [gOne]
  exact ENNReal.mul_ne_top hfin (psi1B_ne_top hp hgam1 hne hfin hpos)

theorem gOne_ne_zero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0) :
    gOne p gam F y1 z1 ≠ 0 := by
  rw [gOne]
  exact mul_ne_zero hpos (psi1B_ne_zero hp hgam1 hne hfin hpos)

theorem gZero_ne_top {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ} {y1 z1 : ℝ}
    (hne : y1 ≠ z1) (hfin : fibProf p F y1 z1 ≠ ⊤) (hpos : fibProf p F y1 z1 ≠ 0)
    (y2 z2 : ℝ) : gZero p gam F y1 z1 y2 z2 ≠ ⊤ := by
  have hP0 : psi1B p gam F y1 z1 ≠ 0 := psi1B_ne_zero hp hgam1 hne hfin hpos
  have hPt : psi1B p gam F y1 z1 ≠ ⊤ := psi1B_ne_top hp hgam1 hne hfin hpos
  rw [gZero]
  refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ?_ ?_) ?_
  · exact ENNReal.rpow_ne_top_of_nonneg (by positivity) enorm_ne_top
  · rw [ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact hpos hc.1
    · exact hfin hc.1
  · rw [psi0B, ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact hP0 hc.1
    · exact hPt hc.1

/-- The Calderón family of `F`: `F_ζ = sgn(F)·G₀^{1-ζ}G₁^{ζ}`. -/
noncomputable def Ffam (p gam : ℝ) (F : Pl2 → ℂ) (ζ : ℂ) (q : Pl2) : ℂ :=
  signC (F q) * rpowC ((gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal) (1 - ζ)
    * rpowC ((gOne p gam F (bs1 q) (bs2 q)).toReal) ζ

/-- The family of the test function: `φ_ζ = sgn(φ)|φ|^{p'(1+ζ)/2}`. -/
noncomputable def phifam (p : ℝ) (φ : ℝ → Pl → ℂ) (ζ : ℂ) (t : ℝ) (x : Pl) : ℂ :=
  signC (φ t x) * rpowC ‖φ t x‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2)

theorem rpowC_toReal_eq {a : ℝ≥0∞} (hat : a ≠ ⊤) {s : ℝ} (hs : 0 < s) :
    rpowC a.toReal ((s : ℝ) : ℂ) = (((a ^ s).toReal : ℝ) : ℂ) := by
  rcases eq_or_ne a 0 with h0 | h0
  · rw [h0, ENNReal.toReal_zero, rpowC_zero_base, ENNReal.zero_rpow_of_pos hs,
      ENNReal.toReal_zero, Complex.ofReal_zero]
  · have hpos : 0 < a.toReal := ENNReal.toReal_pos h0 hat
    rw [rpowC_of_pos hpos]
    have h1 : (((s : ℝ) : ℂ) * (Real.log a.toReal : ℂ))
        = ((s * Real.log a.toReal : ℝ) : ℂ) := by
      push_cast
      ring
    rw [h1, ← Complex.ofReal_exp]
    congr 1
    rw [← ENNReal.toReal_rpow, Real.rpow_def_of_pos hpos, mul_comm]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The Calderón family reproduces `F` at `ζ = θ = 1 - 2/p`. -/
theorem Ffam_at_theta {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) {F : Pl2 → ℂ}
    {q : Pl2} (hne : bs1 q ≠ bs2 q) (hfin : fibProf p F (bs1 q) (bs2 q) ≠ ⊤)
    (hpos : fibProf p F (bs1 q) (bs2 q) ≠ 0) :
    Ffam p gam F (((1 - 2 / p : ℝ)) : ℂ) q = F q := by
  have hppos : (0 : ℝ) < p := by linarith
  have h2p : (0 : ℝ) < 2 / p := by positivity
  have h2p' : (0 : ℝ) < 1 - 2 / p := by
    rw [sub_pos, div_lt_one hppos]
    linarith
  set y1 := bs1 q
  set z1 := bs2 q
  set y2 := fb1 q
  set z2 := fb2 q
  have hGZt : gZero p gam F y1 z1 y2 z2 ≠ ⊤ := gZero_ne_top hp hgam1 hne hfin hpos y2 z2
  have hG1t : gOne p gam F y1 z1 ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
  have hone : (1 : ℂ) - ((1 - 2 / p : ℝ) : ℂ) = ((2 / p : ℝ) : ℂ) := by
    push_cast
    ring
  rw [Ffam, hone, rpowC_toReal_eq hGZt h2p, rpowC_toReal_eq hG1t h2p']
  have hprod : (((gZero p gam F y1 z1 y2 z2 ^ (2 / p)).toReal : ℝ) : ℂ)
      * (((gOne p gam F y1 z1 ^ (1 - 2 / p)).toReal : ℝ) : ℂ)
      = ((((gZero p gam F y1 z1 y2 z2 ^ (2 / p))
          * (gOne p gam F y1 z1 ^ (1 - 2 / p))).toReal : ℝ) : ℂ) := by
    rw [ENNReal.toReal_mul]
    push_cast
    ring
  rw [mul_assoc, hprod, calderon_factorization hp hgam1 hne hfin hpos y2 z2]
  have hval : ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ.toReal = ‖F q‖ := by
    rw [pr_bs_fb q, ← ofReal_norm, ENNReal.toReal_ofReal (norm_nonneg _)]
  rw [hval, signC_mul_norm]

/-! ### The edge bounds for the Calderón family -/

theorem wtB_eq_top {p gam : ℝ} (hp : 0 < p) (hgam : 1 / 2 < gam) {y1 z1 : ℝ} (h : y1 = z1) :
    wtB p gam y1 z1 = ⊤ := by
  have hneg : (1 - 2 * gam) / p < 0 := by
    refine div_neg_of_neg_of_pos ?_ hp
    linarith
  rw [wtB, h, sub_self]
  have h0 : ‖(0 : ℝ)‖ₑ = 0 := by simp
  rw [h0, ENNReal.zero_rpow_of_neg hneg]

/-- Off the support of the fibre profile, and on the diagonal, the whole family vanishes. -/
theorem Ffam_eq_zero_of_degenerate {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam)
    (F : Pl2 → ℂ) (ζ : ℂ) {q : Pl2}
    (hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q) :
    Ffam p gam F ζ q = 0 := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hppgt : 1 < p / (p - 1) := by
    rw [lt_div_iff₀ hp1]
    linarith
  rcases hdeg with h0 | hdiag
  · -- the profile vanishes, so `G₁ = 0`
    have hg1 : gOne p gam F (bs1 q) (bs2 q) = 0 := by
      rw [gOne, h0, zero_mul]
    rw [Ffam, hg1, ENNReal.toReal_zero, rpowC_zero_base, mul_zero]
  · -- on the diagonal `Ψ₀ = 0`, so `G₀ = 0`
    rcases eq_or_ne (fibProf p F (bs1 q) (bs2 q)) 0 with h0 | h0
    · have hg1 : gOne p gam F (bs1 q) (bs2 q) = 0 := by
        rw [gOne, h0, zero_mul]
      rw [Ffam, hg1, ENNReal.toReal_zero, rpowC_zero_base, mul_zero]
    · have hWtop : wtB p gam (bs1 q) (bs2 q) = ⊤ := wtB_eq_top hppos hgam1 hdiag
      have huTop : uB p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [uB, hWtop]
        exact ENNReal.top_mul h0
      have hpsi1 : psi1B p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [psi1B, hWtop, huTop, ENNReal.top_rpow_of_pos (by linarith)]
        exact ENNReal.top_mul_top
      have hpsi0 : psi0B p gam F (bs1 q) (bs2 q) = 0 := by
        rw [psi0B, hpsi1]
        refine ENNReal.top_rpow_of_neg ?_
        have h1 : (0 : ℝ) < p - 2 := by linarith
        linarith [div_pos h1 (by norm_num : (0:ℝ) < 2)]
      have hg0 : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = 0 := by
        rw [gZero, hpsi0, mul_zero]
      rw [Ffam, hg0, ENNReal.toReal_zero, rpowC_zero_base, mul_zero, zero_mul]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The edge bound at `Re ζ = 0`.** -/
theorem enorm_Ffam_le_gZero {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 0) (q : Pl2) :
    ‖Ffam p gam F ζ q‖ₑ ≤ gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) := by
  by_cases hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q
  · rw [Ffam_eq_zero_of_degenerate hp hgam1 F ζ hdeg, enorm_zero]
    exact zero_le
  · push Not at hdeg
    obtain ⟨hpos, hne⟩ := hdeg
    by_cases hfin : fibProf p F (bs1 q) (bs2 q) = ⊤
    · -- an infinite profile makes `G₀` vanish, so the bound is trivial
      by_cases hz : ‖Ffam p gam F ζ q‖ₑ = 0
      · rw [hz]
        exact zero_le
      · -- `G₀` contains the factor `Φ^{1-p/2}` with `Φ = ⊤`, which is `0`; so the family vanishes
        exfalso
        have hexp : (1 : ℝ) - p / 2 < 0 := by
          rw [sub_neg]
          rw [lt_div_iff₀ (by norm_num : (0:ℝ) < 2)]
          linarith
        have h1 : (fibProf p F (bs1 q) (bs2 q)) ^ (1 - p / 2) = 0 := by
          rw [hfin]
          exact ENNReal.top_rpow_of_neg hexp
        have hg0z : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = 0 := by
          rw [gZero, h1, mul_zero, zero_mul]
        rw [Ffam, hg0z, ENNReal.toReal_zero, rpowC_zero_base, mul_zero, zero_mul, enorm_zero] at hz
        exact hz rfl
    · -- the nondegenerate case
      have hG0t : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) ≠ ⊤ :=
        gZero_ne_top hp hgam1 hne hfin hpos (fb1 q) (fb2 q)
      have hG1t : gOne p gam F (bs1 q) (bs2 q) ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
      set a : ℝ := (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal with ha
      set b : ℝ := (gOne p gam F (bs1 q) (bs2 q)).toReal with hb
      have hbpos : 0 < b := by
        rw [hb]
        exact ENNReal.toReal_pos (gOne_ne_zero hp hgam1 hne hfin hpos) hG1t
      have hanonneg : 0 ≤ a := by
        rw [ha]
        exact ENNReal.toReal_nonneg
      -- the norm of the family
      have hnorm : ‖Ffam p gam F ζ q‖ ≤ a := by
        rcases eq_or_lt_of_le hanonneg with hazero | hapos
        · have h1 : rpowC a (1 - ζ) = 0 := by
            rw [← hazero, rpowC_zero_base]
          rw [Ffam, h1, mul_zero, zero_mul, norm_zero, ← hazero]
        · have h2 : ‖rpowC a (1 - ζ)‖ = a ^ (1 - ζ).re := norm_rpowC hapos _
          have h3 : ‖rpowC b ζ‖ = b ^ ζ.re := norm_rpowC hbpos _
          have h4 : (1 - ζ).re = 1 := by
            simp [Complex.sub_re, hζ]
          rw [Ffam, norm_mul, norm_mul, h2, h3, h4, hζ, Real.rpow_one, Real.rpow_zero, mul_one]
          calc ‖signC (F q)‖ * a ≤ 1 * a :=
                mul_le_mul_of_nonneg_right (norm_signC_le_one _) hanonneg
            _ = a := one_mul a
      -- transfer to `ℝ≥0∞`
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖Ffam p gam F ζ q‖ ≤ ENNReal.ofReal a :=
            ENNReal.ofReal_le_ofReal hnorm
        _ = gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) := by
            rw [ha, ENNReal.ofReal_toReal hG0t]

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The edge bound at `Re ζ = 1`.** -/
theorem enorm_Ffam_le_gOne {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ : ζ.re = 1) (q : Pl2) :
    ‖Ffam p gam F ζ q‖ₑ ≤ gOne p gam F (bs1 q) (bs2 q) := by
  by_cases hdeg : fibProf p F (bs1 q) (bs2 q) = 0 ∨ bs1 q = bs2 q
  · rw [Ffam_eq_zero_of_degenerate hp hgam1 F ζ hdeg, enorm_zero]
    exact zero_le
  · push Not at hdeg
    obtain ⟨hpos, hne⟩ := hdeg
    by_cases hfin : fibProf p F (bs1 q) (bs2 q) = ⊤
    · -- `G₁` is then infinite, so the bound is trivial
      have hppos : (0 : ℝ) < p := by linarith
      have hp1 : (0 : ℝ) < p - 1 := by linarith
      have hppgt : 1 < p / (p - 1) := by
        rw [lt_div_iff₀ hp1]
        linarith
      have hW0 : wtB p gam (bs1 q) (bs2 q) ≠ 0 := wtB_ne_zero hppos hgam1 hne
      have hu : uB p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [uB, hfin]
        exact ENNReal.mul_top hW0
      have hpsi : psi1B p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [psi1B, hu, ENNReal.top_rpow_of_pos (by linarith)]
        exact ENNReal.mul_top hW0
      have hg1 : gOne p gam F (bs1 q) (bs2 q) = ⊤ := by
        rw [gOne, hfin, hpsi]
        exact ENNReal.top_mul_top
      rw [hg1]
      exact le_top
    · have hG0t : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) ≠ ⊤ :=
        gZero_ne_top hp hgam1 hne hfin hpos (fb1 q) (fb2 q)
      have hG1t : gOne p gam F (bs1 q) (bs2 q) ≠ ⊤ := gOne_ne_top hp hgam1 hne hfin hpos
      set a : ℝ := (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal with ha
      set b : ℝ := (gOne p gam F (bs1 q) (bs2 q)).toReal with hb
      have hbpos : 0 < b := by
        rw [hb]
        exact ENNReal.toReal_pos (gOne_ne_zero hp hgam1 hne hfin hpos) hG1t
      have hanonneg : 0 ≤ a := by
        rw [ha]
        exact ENNReal.toReal_nonneg
      have hnorm : ‖Ffam p gam F ζ q‖ ≤ b := by
        rcases eq_or_lt_of_le hanonneg with hazero | hapos
        · have h1 : rpowC a (1 - ζ) = 0 := by
            rw [← hazero, rpowC_zero_base]
          rw [Ffam, h1, mul_zero, zero_mul, norm_zero]
          exact le_of_lt hbpos
        · have h2 : ‖rpowC a (1 - ζ)‖ = a ^ (1 - ζ).re := norm_rpowC hapos _
          have h3 : ‖rpowC b ζ‖ = b ^ ζ.re := norm_rpowC hbpos _
          have h4 : (1 - ζ).re = 0 := by
            simp [Complex.sub_re, hζ]
          rw [Ffam, norm_mul, norm_mul, h2, h3, h4, hζ, Real.rpow_zero, Real.rpow_one, mul_one]
          calc ‖signC (F q)‖ * b ≤ 1 * b :=
                mul_le_mul_of_nonneg_right (norm_signC_le_one _) (le_of_lt hbpos)
            _ = b := one_mul b
      rw [← ofReal_norm]
      calc ENNReal.ofReal ‖Ffam p gam F ζ q‖ ≤ ENNReal.ofReal b :=
            ENNReal.ofReal_le_ofReal hnorm
        _ = gOne p gam F (bs1 q) (bs2 q) := by
            rw [hb, ENNReal.ofReal_toReal hG1t]

/-! ### The family of the test function -/

theorem phifam_exponent_re (p : ℝ) (ζ : ℂ) :
    ((((p / (p - 1) : ℝ)) : ℂ) * (1 + ζ) / 2).re = p / (p - 1) * (1 + ζ.re) / 2 := by
  have h1 : ((((p / (p - 1) : ℝ)) : ℂ) * (1 + ζ) / 2)
      = ((((p / (p - 1) / 2 : ℝ)) : ℂ) * (1 + ζ)) := by
    push_cast
    ring
  rw [h1, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, Complex.add_re, Complex.add_im,
    Complex.one_re, Complex.one_im]
  ring

theorem phifam_at_theta {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    phifam p φ (((1 - 2 / p : ℝ)) : ℂ) t x = φ t x := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : p - 1 ≠ 0 := by
    intro hc
    have : p = 1 := by linarith [hc]
    linarith
  have hexp : (((p / (p - 1) : ℝ)) : ℂ) * (1 + (((1 - 2 / p : ℝ)) : ℂ)) / 2 = 1 := by
    have hpc : ((p : ℂ)) ≠ 0 := by
      exact_mod_cast hppos.ne'
    have hp1c : ((p : ℂ)) - 1 ≠ 0 := by
      intro hc
      have : ((p - 1 : ℝ) : ℂ) = 0 := by push_cast; linear_combination hc
      exact hp1 (by exact_mod_cast this)
    push_cast
    field_simp
    ring
  rw [phifam, hexp]
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [h0, signC_zero, zero_mul]
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    rw [rpowC_one hpos, signC_mul_norm]

theorem enorm_phifam_le {p : ℝ} (hp : 2 < p) (φ : ℝ → Pl → ℂ) {ζ : ℂ} (hζ : 0 ≤ ζ.re)
    (t : ℝ) (x : Pl) :
    ‖phifam p φ ζ t x‖ₑ ≤ ‖φ t x‖ₑ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hexppos : 0 < p / (p - 1) * (1 + ζ.re) / 2 := by
    have h1 : 0 < p / (p - 1) := by positivity
    have h2 : (0 : ℝ) < 1 + ζ.re := by linarith
    positivity
  rcases eq_or_ne (φ t x) 0 with h0 | h0
  · rw [phifam, h0, signC_zero, zero_mul, enorm_zero]
    exact zero_le
  · have hpos : 0 < ‖φ t x‖ := norm_pos_iff.mpr h0
    have hnorm : ‖phifam p φ ζ t x‖ ≤ ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := by
      rw [phifam, norm_mul, norm_rpowC hpos, phifam_exponent_re]
      calc ‖signC (φ t x)‖ * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)
          ≤ 1 * ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
            mul_le_mul_of_nonneg_right (norm_signC_le_one _) (by positivity)
        _ = ‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2) := one_mul _
    rw [← ofReal_norm, ← ofReal_norm]
    calc ENNReal.ofReal ‖phifam p φ ζ t x‖
        ≤ ENNReal.ofReal (‖φ t x‖ ^ (p / (p - 1) * (1 + ζ.re) / 2)) :=
          ENNReal.ofReal_le_ofReal hnorm
      _ = (ENNReal.ofReal ‖φ t x‖) ^ (p / (p - 1) * (1 + ζ.re) / 2) :=
          (ENNReal.ofReal_rpow_of_pos hpos).symm

theorem measurable_phifam {p : ℝ} (φ : ℝ → Pl → ℂ) (ζ : ℂ) {t : ℝ} (hφ : Measurable (φ t)) :
    Measurable (phifam p φ ζ t) := by
  have h1 : Measurable fun x : Pl => signC (φ t x) := measurable_signC.comp hφ
  have h2 : Measurable fun x : Pl =>
      rpowC ‖φ t x‖ (((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2) :=
    (measurable_rpowC _).comp hφ.norm
  exact h1.mul h2

theorem differentiable_phifam (p : ℝ) (φ : ℝ → Pl → ℂ) (t : ℝ) (x : Pl) :
    Differentiable ℂ fun ζ : ℂ => phifam p φ ζ t x := by
  have h1 : Differentiable ℂ fun ζ : ℂ => ((p / (p - 1) : ℝ) : ℂ) * (1 + ζ) / 2 :=
    ((differentiable_const _).mul ((differentiable_const (1 : ℂ)).add differentiable_id)).div_const
        _
  exact (differentiable_const _).mul ((differentiable_rpowC ‖φ t x‖).comp h1)

theorem differentiable_Ffam (p gam : ℝ) (F : Pl2 → ℂ) (q : Pl2) :
    Differentiable ℂ fun ζ : ℂ => Ffam p gam F ζ q := by
  have h1 : Differentiable ℂ fun ζ : ℂ =>
      rpowC ((gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)).toReal) (1 - ζ) :=
    (differentiable_rpowC _).comp ((differentiable_const (1 : ℂ)).sub differentiable_id)
  have h2 : Differentiable ℂ fun ζ : ℂ =>
      rpowC ((gOne p gam F (bs1 q) (bs2 q)).toReal) ζ :=
    (differentiable_rpowC _).comp differentiable_id
  exact ((differentiable_const _).mul h1).mul h2

