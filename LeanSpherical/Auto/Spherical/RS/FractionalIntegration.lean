/-! ### The tensor form of the endpoint, and the one-dimensional weight -/

/-- The endpoint estimate for a product `T_tf · T_tg`, i.e. for `𝒯_j(f ⊗ g)`. -/
theorem enorm_TopS_mul_le_mix {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hp : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    (f g : SchwartzMap Pl ℂ) (x : Pl) :
    ‖(TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x‖ₑ
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
