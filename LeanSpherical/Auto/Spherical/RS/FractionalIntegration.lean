          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam G := by
  classical
  set KE : ℝ≥0∞ := ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
    * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2)) with hKE
  have hGL1 : Integrable G (volume : Measure Pl2) :=
    memLp_one_iff_integrable.mp (memLp_of_bdd_support hGm hGb hGsupp)
