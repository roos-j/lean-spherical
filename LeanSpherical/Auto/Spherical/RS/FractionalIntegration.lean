    intro n q
    rw [hGddef]
    by_cases hq : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos hq]
      exact hGb q
    · simp only [if_neg hq, norm_zero]
      exact le_trans (norm_nonneg (G q)) (hGb q)
  have hGdsupp1 : ∀ (n : ℕ) (q : Pl2), |sepFst q| < 1 / ((n : ℝ) + 1) → Gd n q = 0 := by
    intro n q hq
    rw [hGddef]
    simp only [if_neg (not_le.mpr hq)]
  have hGdsupp2 : ∀ (n : ℕ) (q : Pl2), R < ‖q‖ → Gd n q = 0 := by
    intro n q hq
    rw [hGddef]
    by_cases h : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos h]
      exact hGsupp q hq
    · simp only [if_neg h]
  have hGdle : ∀ (n : ℕ) (q : Pl2), ‖Gd n q‖ ≤ ‖G q‖ := by
    intro n q
    rw [hGddef]
    by_cases h : 1 / ((n : ℝ) + 1) ≤ |sepFst q|
    · simp only [if_pos h]
      exact le_refl _
    · simp only [if_neg h, norm_zero]
      exact norm_nonneg _
  have hGdint : ∀ n, Integrable (Gd n) (volume : Measure Pl2) := by
    intro n
    exact memLp_one_iff_integrable.mp
      (memLp_of_bdd_support (hGdmeas n) (hGdb n) (hGdsupp2 n))
  -- the weighted mass only decreases
  have hwd : ∀ n, wMass gam (Gd n) ≤ wMass gam G := by
    intro n
    rw [wMass, wMass]
    refine lintegral_mono fun q => ?_
    refine mul_le_mul' ?_ (le_refl _)
    refine ENNReal.rpow_le_rpow ?_ (by norm_num)
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal (hGdle n q)
  -- the bound for each truncation
  have hbdd : ∀ n, (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ))
      ≤ 4 * KE * wMass gam G := by
    intro n
    have h1 := prop31_Top2_away hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
      hNa hM hcard hcount (δ := 1 / ((n : ℝ) + 1)) (R := R) (CG := CG)
      (by positivity) hR (hGdmeas n) (hGdb n) (hGdsupp1 n) (hGdsupp2 n)
    refine le_trans h1 ?_
    rw [hKE]
    exact mul_le_mul' (le_refl _) (hwd n)
  -- `L¹` convergence of the truncations
  have hL1conv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖Gd n q - G q‖) Filter.atTop (nhds 0) := by
    have hae : ∀ᵐ q : Pl2, Filter.Tendsto (fun n => ‖Gd n q - G q‖) Filter.atTop (nhds 0) := by
      have hnull : (volume : Measure Pl2) {q : Pl2 | sepFst q = 0} = 0 := volume_sepFst_eq_zero
      rw [Filter.eventually_iff_exists_mem]
      refine ⟨{q : Pl2 | sepFst q = 0}ᶜ, ?_, ?_⟩
      · rw [mem_ae_iff, compl_compl]
        exact hnull
      · intro q hq
        have hqne : sepFst q ≠ 0 := hq
        have hpos : 0 < |sepFst q| := abs_pos.mpr hqne
        have hev : ∀ᶠ n : ℕ in Filter.atTop, ‖Gd n q - G q‖ = 0 := by
          obtain ⟨N, hN⟩ := exists_nat_gt (1 / |sepFst q|)
          refine Filter.eventually_atTop.mpr ⟨N, fun n hn => ?_⟩
          have h1 : 1 / ((n : ℝ) + 1) ≤ |sepFst q| := by
            rw [div_le_iff₀ (by positivity)]
            have h2 : (1 : ℝ) / |sepFst q| < (N : ℝ) := hN
            have h3 : (N : ℝ) ≤ (n : ℝ) := by exact_mod_cast hn
            have h4 : (1 : ℝ) / |sepFst q| < (n : ℝ) + 1 := by linarith
            rw [div_lt_iff₀ hpos] at h4
            linarith
          have h5 : Gd n q = G q := by
            rw [hGddef]
            simp only [if_pos h1]
          rw [h5, sub_self, norm_zero]
        exact Filter.Tendsto.congr' (hev.mono fun n hn => hn.symm) tendsto_const_nhds
    have hbound : ∀ n : ℕ, ∀ᵐ q : Pl2, ‖‖Gd n q - G q‖‖ ≤ 2 * ‖G q‖ := by
      intro n
      filter_upwards with q
      rw [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)]
      calc ‖Gd n q - G q‖ ≤ ‖Gd n q‖ + ‖G q‖ := norm_sub_le _ _
        _ ≤ ‖G q‖ + ‖G q‖ := add_le_add (hGdle n q) (le_refl _)
        _ = 2 * ‖G q‖ := by ring
    have hconv := tendsto_integral_of_dominated_convergence (bound := fun q : Pl2 => 2 * ‖G q‖)
      (F := fun n q => ‖Gd n q - G q‖) (f := fun _ : Pl2 => (0 : ℝ))
      (fun n => (((hGdmeas n).sub hGm).norm).aestronglyMeasurable)
      ((hGL1.norm).const_mul 2) hbound hae
    simpa using hconv
  -- Fatou
  have hmeasT : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh t
    exact ((continuous_Top2 hm ε t hh).enorm.measurable).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hh t)]
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    have h1 := tendsto_Top2_of_tendsto_L1 hm ε t hGdint hGL1 hL1conv x
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp h1.enorm
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (Gd n) (hGdint n) t))
  calc (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ) := hsum_in G hGL1
    _ = ∫⁻ x : Pl, Filter.liminf
          (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := by
        refine lintegral_congr fun x => ?_
        exact ((hptconv x).liminf_eq).symm
    _ ≤ Filter.liminf (fun n => ∫⁻ x : Pl,
          ∑ t ∈ Efin, ‖Top2 j ε m t (Gd n) x‖ₑ ^ (2 : ℝ)) Filter.atTop := hfatou
    _ ≤ Filter.liminf (fun _ : ℕ => 4 * KE * wMass gam G) Filter.atTop := by
        refine Filter.liminf_le_liminf (Filter.Eventually.of_forall fun n => ?_)
        rw [← hsum_in (Gd n) (hGdint n)]
        exact hbdd n
    _ = 4 * KE * wMass gam G := by
        exact Filter.liminf_const _

/-! ### The kernel is square integrable against a polynomial weight -/

theorem exists_decay_Pl (H : SchwartzMap Pl ℂ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ u : Pl, ‖(H : Pl → ℂ) u‖ * (1 + ‖u‖) ^ (3 : ℕ) ≤ K := by
  refine ⟨2 ^ (3 : ℕ) * (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H, ?_, ?_⟩
  · have h : (0 : ℝ) ≤ (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
        (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H := apply_nonneg _ _
    positivity
  · intro u
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((3 : ℕ), (0 : ℕ)))
      (le_refl 3) (le_refl 0) H u
    rw [norm_iteratedFDeriv_zero] at h
    rw [mul_comm]
    exact h

theorem integrable_inv_one_add_norm_pow5 :
    Integrable (fun u : Pl => ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) (volume : Measure Pl) := by
  have hrank : ((Module.finrank ℝ Pl : ℕ) : ℝ) < 5 := by
    rw [finrank_euclideanSpace_fin]
    norm_num
  have h := integrable_one_add_norm (E := Pl) (μ := (volume : Measure Pl)) (r := 5) hrank
  have hfun : (fun u : Pl => (1 + ‖u‖) ^ (-(5 : ℝ)))
      = fun u : Pl => ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
    funext u
    have h1 : (0 : ℝ) < 1 + ‖u‖ := by positivity
    rw [Real.rpow_neg h1.le, ← Real.rpow_natCast (1 + ‖u‖) 5]
    norm_num
  rw [← hfun]
  exact h

/-- The `L²` norm of a Schwartz function against the weight `1 + ‖u‖` is finite. -/
theorem lintegral_enorm_sq_mul_one_add_lt_top (H : SchwartzMap Pl ℂ) :
    (∫⁻ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) < ⊤ := by
  obtain ⟨K, hK0, hK⟩ := exists_decay_Pl H
  have hmaj : ∀ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)
      ≤ ENNReal.ofReal (K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) := by
    intro u
    have h1 : (0 : ℝ) < 1 + ‖u‖ := by positivity
    have hreal : ‖(H : Pl → ℂ) u‖ ^ 2 * (1 + ‖u‖) ≤ K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
      have h2 : ‖(H : Pl → ℂ) u‖ ≤ K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹ := by
        have hu := hK u
        rw [← le_div_iff₀ (by positivity : (0 : ℝ) < (1 + ‖u‖) ^ (3 : ℕ))] at hu
        refine le_trans hu (le_of_eq ?_)
        field_simp
      have h3 : ‖(H : Pl → ℂ) u‖ ^ 2 ≤ (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 := by
        refine pow_le_pow_left₀ (norm_nonneg _) h2 2
      have h4 : (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 * (1 + ‖u‖)
          = K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
        field_simp
      calc ‖(H : Pl → ℂ) u‖ ^ 2 * (1 + ‖u‖)
          ≤ (K * ((1 + ‖u‖) ^ (3 : ℕ))⁻¹) ^ 2 * (1 + ‖u‖) :=
            mul_le_mul_of_nonneg_right h3 (le_of_lt h1)
        _ = K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := h4
    have hen1 : ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) = ENNReal.ofReal (‖(H : Pl → ℂ) u‖ ^ 2) := by
      rw [← ofReal_norm, show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast,
        ← ENNReal.ofReal_pow (norm_nonneg _)]
    have hen2 : (1 : ℝ≥0∞) + ‖u‖ₑ = ENNReal.ofReal (1 + ‖u‖) := by
      rw [← ofReal_norm, ← ENNReal.ofReal_one, ← ENNReal.ofReal_add (by norm_num)
        (norm_nonneg _)]
    rw [hen1, hen2, ← ENNReal.ofReal_mul (by positivity)]
    exact ENNReal.ofReal_le_ofReal hreal
  have hint : Integrable (fun u : Pl => K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹)
      (volume : Measure Pl) := integrable_inv_one_add_norm_pow5.const_mul _
  have hnn : (0 : Pl → ℝ) ≤ᵐ[volume] fun u : Pl => K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹ := by
    filter_upwards with u
    change (0 : ℝ) ≤ K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹
    positivity
  calc (∫⁻ u : Pl, ‖(H : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
      ≤ ∫⁻ u : Pl, ENNReal.ofReal (K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) := lintegral_mono hmaj
    _ = ENNReal.ofReal (∫ u : Pl, K ^ 2 * ((1 + ‖u‖) ^ (5 : ℕ))⁻¹) :=
        (ofReal_integral_eq_lintegral_ofReal hint hnn).symm
    _ < ⊤ := ENNReal.ofReal_lt_top

theorem enorm_sub_le_one_add_mul_one_add (x y z : Pl) {sgam : ℝ} (hs0 : 0 ≤ sgam)
    (hs1 : sgam ≤ 1) :
    ‖y - z‖ₑ ^ sgam ≤ (1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ) := by
  have htri : ‖y - z‖ₑ ≤ ‖x - y‖ₑ + ‖x - z‖ₑ := by
    have h1 : y - z = -(x - y) + (x - z) := by abel
    calc ‖y - z‖ₑ = ‖-(x - y) + (x - z)‖ₑ := by rw [h1]
      _ ≤ ‖-(x - y)‖ₑ + ‖x - z‖ₑ := enorm_add_le _ _
      _ = ‖x - y‖ₑ + ‖x - z‖ₑ := by rw [enorm_neg]
  set c : ℝ≥0∞ := ‖x - y‖ₑ + ‖x - z‖ₑ with hc
  have h2 : ‖y - z‖ₑ ^ sgam ≤ c ^ sgam := ENNReal.rpow_le_rpow htri hs0
  have h3 : c ^ sgam ≤ 1 + c := by
    rcases le_total c 1 with hle | hle
    · refine le_trans (ENNReal.rpow_le_one hle hs0) ?_
      exact le_self_add
    · calc c ^ sgam ≤ c ^ (1 : ℝ) := ENNReal.rpow_le_rpow_of_exponent_le hle hs1
        _ = c := ENNReal.rpow_one c
        _ ≤ 1 + c := le_add_self
  refine le_trans h2 (le_trans h3 ?_)
  rw [hc]
  calc 1 + (‖x - y‖ₑ + ‖x - z‖ₑ)
      ≤ 1 + ‖x - y‖ₑ + ‖x - z‖ₑ + ‖x - y‖ₑ * ‖x - z‖ₑ := by
        calc 1 + (‖x - y‖ₑ + ‖x - z‖ₑ) = 1 + ‖x - y‖ₑ + ‖x - z‖ₑ := by ring
          _ ≤ 1 + ‖x - y‖ₑ + ‖x - z‖ₑ + ‖x - y‖ₑ * ‖x - z‖ₑ := le_self_add
    _ = (1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ) := by ring

/-! ### The weighted Cauchy--Schwarz bound for the kernel of `𝒯_j` -/

theorem lintegral_sub_left_eq_self_Pl (g : Pl → ℝ≥0∞) (c : Pl) :
    (∫⁻ w : Pl, g (c - w)) = ∫⁻ w : Pl, g w := by
  have h1 : (∫⁻ w : Pl, g (c - w)) = ∫⁻ w : Pl, g (c + w) := by
    have h := lintegral_neg_eq_self (μ := (volume : Measure Pl)) (fun w : Pl => g (c + w))
    simpa [sub_eq_add_neg] using h
  rw [h1]
  exact lintegral_add_left_eq_self g c

/-- The weighted square integral of the kernel of `𝒯_j`. -/
noncomputable def CKx (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (gam : ℝ) (x : Pl) : ℝ≥0∞ :=
  ∫⁻ q : Pl2, (‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ) ^ (2 : ℝ)
    * ‖sepCLM q‖ₑ ^ (2 * gam - 1)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
theorem CKx_le_sq {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) : CKx j ε m t gam x
      ≤ (∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
        * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hs0 : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
  have hs1 : 2 * gam - 1 ≤ 1 := by linarith
  set A : Pl → ℝ≥0∞ := fun u => ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) with hA
  have hAtop : ∀ u : Pl, A u ≠ ⊤ := by
    intro u
    rw [hA]
    refine ENNReal.mul_ne_top ?_ ?_
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) enorm_ne_top
    · exact ENNReal.add_ne_top.mpr ⟨by norm_num, enorm_ne_top⟩
  have hAmeas : Measurable A := by
    rw [hA]
    exact ((hkc.enorm.measurable).pow_const _).mul (measurable_const.add
      (continuous_id.enorm.measurable))
  have hAfin : (∫⁻ u : Pl, A u) < ⊤ := by
    have hfun : ∀ u : Pl, A u = ‖(kernS hm ε t : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
      intro u
      rw [hA, kernS_apply]
    rw [lintegral_congr hfun]
    exact lintegral_enorm_sq_mul_one_add_lt_top (kernS hm ε t)
  -- the pointwise bound
  have hmeasint : Measurable fun q : Pl2 =>
      (‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ) ^ (2 : ℝ)
        * ‖sepCLM q‖ₑ ^ (2 * gam - 1) := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact ((h1.mul h2).pow_const _).mul ((sepCLM.continuous.enorm.measurable).pow_const _)
  have hbd : ∀ y z : Pl,
      (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
          * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1)
        ≤ A (x - y) * A (x - z) := by
    intro y z
    have hsplit : (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
        = ‖kern j ε m t (x - y)‖ₑ ^ (2 : ℝ) * ‖kern j ε m t (x - z)‖ₑ ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    have hw := enorm_sub_le_one_add_mul_one_add x y z hs0 hs1
    calc (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
          * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1)
        ≤ (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
            * ((1 + ‖x - y‖ₑ) * (1 + ‖x - z‖ₑ)) := mul_le_mul' (le_refl _) hw
      _ = A (x - y) * A (x - z) := by
          rw [hsplit, hA]
          ring
  -- iterate and split
  calc CKx j ε m t gam x
      = ∫⁻ y : Pl, ∫⁻ z : Pl,
          (‖kern j ε m t (x - y)‖ₑ * ‖kern j ε m t (x - z)‖ₑ) ^ (2 : ℝ)
            * ‖(y - z : Pl)‖ₑ ^ (2 * gam - 1) := by
        rw [CKx]
        exact (lintegral_pr _ hmeasint).symm
    _ ≤ ∫⁻ y : Pl, ∫⁻ z : Pl, A (x - y) * A (x - z) :=
        lintegral_mono fun y => lintegral_mono fun z => hbd y z
    _ = ∫⁻ y : Pl, A (x - y) * ∫⁻ z : Pl, A (x - z) := by
        refine lintegral_congr fun y => ?_
        exact lintegral_const_mul' _ _ (hAtop (x - y))
    _ = (∫⁻ y : Pl, A (x - y)) * ∫⁻ z : Pl, A (x - z) := by
        rw [lintegral_mul_const' _ _ ?_]
        rw [lintegral_sub_left_eq_self_Pl A x]
        exact hAfin.ne
    _ = (∫⁻ u : Pl, A u) * ∫⁻ u : Pl, A u := by
        rw [lintegral_sub_left_eq_self_Pl A x]

theorem CKx_lt_top {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) : CKx j ε m t gam x < ⊤ := by
  have hAfin : (∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) < ⊤ := by
    have hfun : ∀ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)
        = ‖(kernS hm ε t : Pl → ℂ) u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ) := by
      intro u
      rw [kernS_apply]
    rw [lintegral_congr hfun]
    exact lintegral_enorm_sq_mul_one_add_lt_top (kernS hm ε t)
  exact lt_of_le_of_lt (CKx_le_sq hm ε t hgam1 hgam2 x) (ENNReal.mul_lt_top hAfin hAfin)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The weighted Cauchy--Schwarz bound.**  The kernel integral of `𝒯_j` is controlled by the
weighted mass of the data. -/
theorem lintegral_kern_mul_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (_hgam2 : gam ≤ 1)
    (x : Pl) {F : Pl2 → ℂ} (hF : Measurable F) :
    (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ * ‖F q‖ₑ)
      ≤ (CKx j ε m t gam x) ^ ((1 : ℝ) / 2) * (wMass gam F) ^ ((1 : ℝ) / 2) := by
  classical
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  set kk : Pl2 → ℝ≥0∞ := fun q =>
    ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ with hkk
  set w : Pl2 → ℝ≥0∞ := fun q => ‖sepCLM q‖ₑ ^ (2 * gam - 1) with hwdef
  have hkkmeas : Measurable kk := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact h1.mul h2
  have hwmeas : Measurable w := (sepCLM.continuous.enorm.measurable).pow_const _
  -- off the diagonal the weight splits
  have hae : (fun q : Pl2 => kk q * ‖F q‖ₑ)
      =ᵐ[volume] fun q : Pl2 => (kk q * w q ^ ((1 : ℝ) / 2))
        * (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹) := by
    have hnull : (volume : Measure Pl2) {q : Pl2 | sepCLM q = 0} = 0 := volume_sepCLM_eq_zero
    rw [Filter.eventuallyEq_iff_exists_mem]
    refine ⟨{q : Pl2 | sepCLM q = 0}ᶜ, ?_, ?_⟩
    · rw [mem_ae_iff, compl_compl]
      exact hnull
    · intro q hq
      have hqne : sepCLM q ≠ 0 := hq
      have hpos : (0 : ℝ≥0∞) < ‖sepCLM q‖ₑ := by
        rw [enorm_pos]
        exact hqne
      have hwpos : (0 : ℝ≥0∞) < w q ^ ((1 : ℝ) / 2) := by
        rw [hwdef]
        refine ENNReal.rpow_pos ?_ ?_
        · exact ENNReal.rpow_pos hpos enorm_ne_top
        · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      have hwtop : w q ^ ((1 : ℝ) / 2) ≠ ⊤ := by
        rw [hwdef]
        refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
        exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      change kk q * ‖F q‖ₑ = (kk q * w q ^ ((1 : ℝ) / 2)) * (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹)
      rw [mul_comm (‖F q‖ₑ) ((w q ^ ((1 : ℝ) / 2))⁻¹), ← mul_assoc, mul_assoc (kk q),
        ENNReal.mul_inv_cancel hwpos.ne' hwtop, mul_one]
  rw [lintegral_congr_ae hae]
  have hf : AEMeasurable (fun q : Pl2 => kk q * w q ^ ((1 : ℝ) / 2)) (volume : Measure Pl2) :=
    (hkkmeas.mul (hwmeas.pow_const _)).aemeasurable
  have hg : AEMeasurable (fun q : Pl2 => ‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹)
      (volume : Measure Pl2) := ((hF.enorm).mul ((hwmeas.pow_const _).inv)).aemeasurable
  have hhol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl2)
    Real.HolderConjugate.two_two hf hg
  refine le_trans hhol ?_
  refine mul_le_mul' ?_ ?_
  · -- the kernel factor
    refine le_of_eq ?_
    congr 1
    rw [CKx]
    refine lintegral_congr fun q => ?_
    have h1 : (kk q * w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ)
        = kk q ^ (2 : ℝ) * (w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1, ← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one, hkk,
      hwdef]
  · -- the data factor
    refine le_of_eq ?_
    congr 1
    rw [wMass]
    refine lintegral_congr fun q => ?_
    have h1 : (‖F q‖ₑ * (w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ)
        = ‖F q‖ₑ ^ (2 : ℝ) * ((w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1]
    congr 1
    rw [← ENNReal.rpow_neg_one (w q ^ ((1 : ℝ) / 2)), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      hwdef, ← ENNReal.rpow_mul]
    congr 1
    ring

/-! ### The `L²` endpoint for all data of finite weighted mass -/

theorem integrable_Top2_integrand_of_wMass {j : ℕ} {m : ℝ → Pl → ℂ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ}
    (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1) (x : Pl) {F : Pl2 → ℂ} (hFm : Measurable F)
    (hFfin : wMass gam F ≠ ⊤) :
    Integrable (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hmeas : Measurable fun q : Pl2 =>
      kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q := by
    have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    exact h1.measurable.mul hFm
  refine ⟨hmeas.aestronglyMeasurable, ?_⟩
  have hbd := lintegral_kern_mul_le hm ε t hgam1 hgam2 x hFm
  have heq : ∀ q : Pl2,
      ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q‖ₑ
        = ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ * ‖F q‖ₑ := by
    intro q
    rw [enorm_mul, enorm_mul]
  rw [hasFiniteIntegral_iff_enorm, lintegral_congr heq]
  refine lt_of_le_of_lt hbd ?_
  refine ENNReal.mul_lt_top ?_ ?_
  · refine ENNReal.rpow_lt_top_of_nonneg (by norm_num) ?_
    exact (CKx_lt_top hm ε t hgam1 hgam2 x).ne
  · exact ENNReal.rpow_lt_top_of_nonneg (by norm_num) hFfin

/-- `𝒯_jh` is measurable in `x` for any measurable `h`. -/
theorem measurable_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hhm : Measurable h) :
    Measurable (Top2 j ε m t h) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hcont : Continuous fun p : Pl × Pl2 =>
      kern j ε m t (p.1 - prjL p.2) * kern j ε m t (p.1 - prjR p.2) := by
    have h1 : Continuous fun p : Pl × Pl2 => kern j ε m t (p.1 - prjL p.2) :=
      hkc.comp (continuous_fst.sub (prjL.continuous.comp continuous_snd))
    have h2 : Continuous fun p : Pl × Pl2 => kern j ε m t (p.1 - prjR p.2) :=
      hkc.comp (continuous_fst.sub (prjR.continuous.comp continuous_snd))
    exact h1.mul h2
  have hjoint : StronglyMeasurable fun p : Pl × Pl2 =>
      kern j ε m t (p.1 - prjL p.2) * kern j ε m t (p.1 - prjR p.2) * h p.2 := by
    refine (hcont.stronglyMeasurable).mul ?_
    exact (hhm.comp measurable_snd).stronglyMeasurable
  have hSM : StronglyMeasurable fun x : Pl =>
      ∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q :=
    hjoint.integral_prod_right'
  exact hSM.measurable

