      have h2 : Measurable fun z : Pl => ‖F (pr y z)‖ₑ :=
        (hF.comp (hprmeas.comp (measurable_const.prodMk measurable_id))).enorm
      exact (measurable_const.mul h1).mul h2
    rw [lintegral_Pl_eq_prod _ hmz]
    have hinnerz : ∀ z1 : ℝ,
        (∫⁻ z2 : ℝ, K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ)
          ≤ K (x - y) * ENNReal.ofReal C * S (y 0) z1 := by
      intro z1
      have hbd : ∀ z2 : ℝ, K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ
          ≤ K (x - mk2 z1 z2) * (K (x - y) * S (y 0) z1) := by
        intro z2
        have hFle : ‖F (pr y (mk2 z1 z2))‖ₑ ≤ S (y 0) z1 := by
          have hSval : S (y 0) z1
              = ⨆ y2 : ℝ, ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ := rfl
          rw [hSval]
          calc ‖F (pr y (mk2 z1 z2))‖ₑ
              = ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2))‖ₑ := by rw [mk2_coords]
            _ ≤ ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2'))‖ₑ :=
                le_iSup (fun z2' : ℝ => ‖F (pr (mk2 (y 0) (y 1)) (mk2 z1 z2'))‖ₑ) z2
            _ ≤ ⨆ y2 : ℝ, ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ :=
                le_iSup (fun y2 : ℝ =>
                  ⨆ z2' : ℝ, ‖F (pr (mk2 (y 0) y2) (mk2 z1 z2'))‖ₑ) (y 1)
        calc K (x - y) * K (x - mk2 z1 z2) * ‖F (pr y (mk2 z1 z2))‖ₑ
            ≤ K (x - y) * K (x - mk2 z1 z2) * S (y 0) z1 := mul_le_mul' (le_refl _) hFle
          _ = K (x - mk2 z1 z2) * (K (x - y) * S (y 0) z1) := by ring
      refine le_trans (lintegral_mono hbd) ?_
      rw [lintegral_mul_const _ (hKmk2 z1)]
      calc (∫⁻ z2 : ℝ, K (x - mk2 z1 z2)) * (K (x - y) * S (y 0) z1)
          ≤ ENNReal.ofReal C * (K (x - y) * S (y 0) z1) :=
            mul_le_mul' (hKbd z1) (le_refl _)
        _ = K (x - y) * ENNReal.ofReal C * S (y 0) z1 := by ring
    refine le_trans (lintegral_mono hinnerz) (le_of_eq ?_)
    rw [lintegral_const_mul' _ _ (ENNReal.mul_ne_top (hKtop (x - y)) hCtop), mul_assoc]
  -- assemble
  calc ‖Top2 j ε m t F x‖ₑ
      ≤ ∫⁻ q : Pl2, K (x - prjL q) * K (x - prjR q) * ‖F q‖ₑ := by
        rw [Top2]
        refine le_trans (enorm_integral_le_lintegral_enorm _) ?_
        refine lintegral_mono fun q => ?_
        rw [enorm_mul, enorm_mul]
    _ = ∫⁻ y : Pl, ∫⁻ z : Pl, K (x - y) * K (x - z) * ‖F (pr y z)‖ₑ :=
        (lintegral_pr _ hmeasPl2).symm
    _ = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z : Pl,
          K (x - mk2 y1 y2) * K (x - z) * ‖F (pr (mk2 y1 y2) z)‖ₑ :=
        lintegral_Pl_eq_prod _ hmeasOuter
    _ ≤ ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, K (x - mk2 y1 y2)
          * (ENNReal.ofReal C * ∫⁻ z1 : ℝ, S y1 z1) := by
        refine lintegral_mono fun y1 => lintegral_mono fun y2 => ?_
        have h := hz (mk2 y1 y2)
        rw [mk2_apply_zero] at h
        exact h
    _ ≤ ∫⁻ y1 : ℝ, ENNReal.ofReal C * (ENNReal.ofReal C * ∫⁻ z1 : ℝ, S y1 z1) := by
        refine lintegral_mono fun y1 => ?_
        rw [lintegral_mul_const _ (hKmk2 y1)]
        exact mul_le_mul' (hKbd y1) (le_refl _)
    _ = ENNReal.ofReal C ^ 2 * ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, S y1 z1 := by
        rw [← lintegral_const_mul' (ENNReal.ofReal C ^ 2)
          (fun y1 : ℝ => ∫⁻ z1 : ℝ, S y1 z1) (ENNReal.pow_ne_top hCtop)]
        refine lintegral_congr fun y1 => ?_
        rw [pow_two, mul_assoc]
    _ = ENNReal.ofReal C ^ 2 * mix2 F := by
        rw [mix2, hSdef]

/-! ### `𝒯_j` on a tensor is the product of the two single-scale operators -/

theorem TopS_eq_conv_left {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x = ∫ y : Pl, kern j ε m t (x - y) * (f : Pl → ℂ) y := by
  rw [TopS_eq_convolution hm ε t f x]
  have h := integral_sub_left_eq_self
    (fun y : Pl => kern j ε m t (x - y) * (f : Pl → ℂ) y) (volume : Measure Pl) x
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [sub_sub_cancel]

/-- **The bilinear operator on a tensor.** `𝒯_j(f ⊗ g) = T_tf · T_tg`, which is the
bilinearization identity of §3. -/
theorem Top2_tens {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f g : SchwartzMap Pl ℂ) (x : Pl) :
    Top2 j ε m t (tens f g : Pl2 → ℂ) x
      = (TopS hm ε t f : Pl → ℂ) x * (TopS hm ε t g : Pl → ℂ) x := by
  have hchange : (∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
        * (tens f g : Pl2 → ℂ) q)
      = ∫ w : Pl × Pl, (kern j ε m t (x - w.1) * (f : Pl → ℂ) w.1)
          * (kern j ε m t (x - w.2) * (g : Pl → ℂ) w.2) := by
    rw [← measurePreserving_prPair.integral_comp
      (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toHomeomorph.measurableEmbedding
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
        * (tens f g : Pl2 → ℂ) q)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun w => ?_)
    change kern j ε m t (x - prjL (pr w.1 w.2)) * kern j ε m t (x - prjR (pr w.1 w.2))
        * (tens f g : Pl2 → ℂ) (pr w.1 w.2)
      = (kern j ε m t (x - w.1) * (f : Pl → ℂ) w.1)
          * (kern j ε m t (x - w.2) * (g : Pl → ℂ) w.2)
    rw [prjL_pr, prjR_pr, tens_apply_pr]
    ring
  rw [Top2, hchange, Measure.volume_eq_prod,
    integral_prod_mul (f := fun y : Pl => kern j ε m t (x - y) * (f : Pl → ℂ) y)
      (g := fun z : Pl => kern j ε m t (x - z) * (g : Pl → ℂ) z),
    TopS_eq_conv_left hm ε t f x, TopS_eq_conv_left hm ε t g x]

/-! ### The convolution representation of `𝒯_j` on `ℝ⁴` -/

theorem pr_sub (a b c d : Pl) : pr a b - pr c d = pr (a - c) (b - d) := rfl

instance instIsNegInvariantPl2 : (volume : Measure Pl2).IsNegInvariant :=
  MeasureTheory.Measure.IsAddHaarMeasure.isNegInvariant_of_regular _

theorem pr_neg (a b : Pl) : -(pr a b) = pr (-a) (-b) := rfl

theorem pr_prj (q : Pl2) : pr (prjL q) (prjR q) = q := rfl

theorem fourierInv_mfull_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    𝓕⁻ ((mfullS hm ε t : Pl → ℂ)) u = kern j ε m t u := by
  rw [← SchwartzMap.fourierInv_coe]
  exact kernS_apply hm ε t u

/-- The multiplier of `𝒯_j` on `ℝ⁴`: the tensor square of `mfull`. -/
noncomputable def mfull2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl2 ℂ :=
  tens (mfullS hm ε t) (mfullS hm ε t)

/-- The kernel of `𝒯_j` on `ℝ⁴`. -/
noncomputable def kern2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl2 ℂ :=
  𝓕⁻ (mfull2S hm ε t)

theorem kern2S_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u v : Pl) :
    (kern2S hm ε t : Pl2 → ℂ) (pr u v) = kern j ε m t u * kern j ε m t v := by
  rw [kern2S, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, pr_neg, mfull2S,
    fourier_tens, ← Real.fourierInv_eq_fourier_neg, ← Real.fourierInv_eq_fourier_neg,
    fourierInv_mfull_apply, fourierInv_mfull_apply]

theorem hasTemperateGrowth_mfull2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    Function.HasTemperateGrowth ((mfull2S hm ε t : Pl2 → ℂ)) :=
  SchwartzMap.hasTemperateGrowth (mfull2S hm ε t)

/-- The operator `𝒯_j` on `ℝ⁴`, as a Schwartz map. -/
noncomputable def Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  𝓕⁻ (SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F))

theorem Top2S_eq_convolution {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (w : Pl2) :
    (Top2S hm ε t F : Pl2 → ℂ)  w
      = ∫ q : Pl2, (kern2S hm ε t : Pl2 → ℂ) q * (F : Pl2 → ℂ) (w - q) := by
  have h3 : 𝓕 (kern2S hm ε t) = mfull2S hm ε t := by
    rw [kern2S, FourierTransform.fourier_fourierInv_eq]
  have h1 : 𝓕 (Top2S hm ε t F)
      = SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) := by
    rw [Top2S, FourierTransform.fourier_fourierInv_eq]
  have h2 : 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F)
      = SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (𝓕 (kern2S hm ε t)) (𝓕 F) :=
    SchwartzMap.fourier_convolution _ _ _
  have h4 : SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (mfull2S hm ε t) (𝓕 F)
      = SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) := by
    refine SchwartzMap.ext fun ω => ?_
    rw [SchwartzMap.pairing_apply_apply,
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul]
    rfl
  have hEq : Top2S hm ε t F
      = SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F := by
    have hF : 𝓕 (Top2S hm ε t F)
        = 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F) := by
      rw [h1, h2, h3, h4]
    calc Top2S hm ε t F = 𝓕⁻ (𝓕 (Top2S hm ε t F)) :=
          (FourierTransform.fourierInv_fourier_eq _).symm
      _ = 𝓕⁻ (𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kern2S hm ε t) F)) := by
          rw [hF]
      _ = _ := FourierTransform.fourierInv_fourier_eq _
  rw [hEq, SchwartzMap.convolution_apply]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  simp only [ContinuousLinearMap.mul_apply']

/-- **The kernel representation of `𝒯_j`.**  The operator defined by the kernel agrees with the
multiplier operator on `ℝ⁴`, restricted to the diagonal. -/
theorem Top2_eq_Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl) :
    Top2 j ε m t (F : Pl2 → ℂ) x = (Top2S hm ε t F : Pl2 → ℂ) (pr x x) := by
  rw [Top2S_eq_convolution, Top2]
  have h := integral_sub_left_eq_self
    (fun q : Pl2 => (kern2S hm ε t : Pl2 → ℂ) q * (F : Pl2 → ℂ) (pr x x - q))
    (volume : Measure Pl2) (pr x x)
  rw [← h]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  have hk : (kern2S hm ε t : Pl2 → ℂ) (pr x x - q)
      = kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) := by
    have hq : (pr x x - q : Pl2) = pr (x - prjL q) (x - prjR q) := by
      conv_lhs => rw [← pr_prj q]
      rw [pr_sub]
    rw [hq, kern2S_apply]
  simp only [sub_sub_cancel, hk]

/-! ### The frequency side: `𝒯_j` is the inverse transform of `S[F,b]` -/

/-- The shear `(u,v) ↦ (u+v, v)` of `ℝ² × ℝ²`, as a measurable equivalence. -/
def shiftME : (Pl × Pl) ≃ᵐ (Pl × Pl) where
  toFun := fun q => (q.1 + q.2, q.2)
  invFun := fun q => (q.1 - q.2, q.2)
  left_inv := fun q => by simp
  right_inv := fun q => by simp
  measurable_toFun := (measurable_fst.add measurable_snd).prodMk measurable_snd
  measurable_invFun := (measurable_fst.sub measurable_snd).prodMk measurable_snd

@[simp] theorem shiftME_apply (q : Pl × Pl) : shiftME q = (q.1 + q.2, q.2) := rfl

theorem measurePreserving_shiftME :
    MeasurePreserving shiftME (volume : Measure (Pl × Pl)) (volume : Measure (Pl × Pl)) := by
  have h := measurePreserving_add_prod (volume : Measure Pl) (volume : Measure Pl)
  rw [Measure.volume_eq_prod]
  exact h

theorem integrable_ee_mfull_prod {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (Ff : SchwartzMap Pl2 ℂ) (x : Pl) :
    Integrable (fun q : Pl × Pl => (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)))
      (volume : Measure (Pl × Pl)) := by
  have hFint : Integrable (fun q : Pl × Pl => (Ff : Pl2 → ℂ) (pr q.1 q.2))
      (volume : Measure (Pl × Pl)) :=
    measurePreserving_prPair.integrable_comp_of_integrable Ff.integrable
  have hmc : Continuous (mfull j ε m t) := (contDiff_mfull hm ε t).continuous
  have hcont : Continuous fun q : Pl × Pl =>
      (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)) := by
    have h1 : Continuous fun q : Pl × Pl => ee (-(inner ℝ q.1 x : ℝ)) :=
      continuous_ee.comp ((continuous_fst.inner continuous_const).neg)
    have h2 : Continuous fun q : Pl × Pl => ee (-(inner ℝ q.2 x : ℝ)) :=
      continuous_ee.comp ((continuous_snd.inner continuous_const).neg)
    have h3 : Continuous fun q : Pl × Pl => mfull j ε m t q.1 := hmc.comp continuous_fst
    have h4 : Continuous fun q : Pl × Pl => mfull j ε m t q.2 := hmc.comp continuous_snd
    have h5 : Continuous fun q : Pl × Pl => (Ff : Pl2 → ℂ) (pr q.1 q.2) :=
      Ff.continuous.comp continuous_prPair
    exact (h1.mul h2).mul ((h3.mul h4).mul h5)
  refine Integrable.mono' ((hFint.norm).const_mul (B0 * B0)) hcont.aestronglyMeasurable
    (Filter.Eventually.of_forall fun q => ?_)
  have hb1 : ‖mfull j ε m t q.1‖ ≤ B0 := norm_mfull_le hm ε t q.1
  have hb2 : ‖mfull j ε m t q.2‖ ≤ B0 := norm_mfull_le hm ε t q.2
  have hnn : (0 : ℝ) ≤ ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := norm_nonneg _
  have hB0 : (0 : ℝ) ≤ B0 := le_trans (norm_nonneg _) hb1
  calc ‖(ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2))‖
      = ‖mfull j ε m t q.1‖ * ‖mfull j ε m t q.2‖ * ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := by
        rw [norm_mul, norm_mul, norm_mul, norm_mul, norm_ee, norm_ee, one_mul, one_mul, mul_assoc]
    _ ≤ B0 * B0 * ‖(Ff : Pl2 → ℂ) (pr q.1 q.2)‖ := by
        refine mul_le_mul_of_nonneg_right ?_ hnn
        exact mul_le_mul hb1 hb2 (norm_nonneg _) hB0

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The frequency-side identification.**  The kernel operator `𝒯_j` is the inverse Fourier
transform of the §4 operator `S[F, bprod m]`. -/
theorem Top2S_diag_eq_fourierInv_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ}
    {B0 : ℝ} (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (x : Pl) :
    (Top2S hm ε t F : Pl2 → ℂ) (pr x x)
      = 𝓕⁻ (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) x := by
  classical
  set Ff : SchwartzMap Pl2 ℂ := 𝓕 F with hFfdef
  have hFf : ∀ ω : Pl2, 𝓕 ((F : Pl2 → ℂ)) ω = (Ff : Pl2 → ℂ) ω := by
    intro ω
    rw [hFfdef, SchwartzMap.fourier_coe]
  set G : Pl × Pl → ℂ := fun q =>
    ee (-(inner ℝ q.1 x : ℝ)) * (mfull j ε m t (q.1 - q.2) * mfull j ε m t q.2
      * (Ff : Pl2 → ℂ) (pr (q.1 - q.2) q.2)) with hGdef
  set W : Pl × Pl → ℂ := fun q =>
    (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
      * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2)) with hWdef
  -- `W = G ∘ shiftME`
  have hWG : ∀ q : Pl × Pl, W q = G (shiftME q) := by
    intro q
    have h1 : (q.1 + q.2 - q.2 : Pl) = q.1 := by abel
    have harg : (inner ℝ (q.1 + q.2 : Pl) x : ℝ)
        = (inner ℝ q.1 x : ℝ) + (inner ℝ q.2 x : ℝ) := inner_add_left _ _ _
    rw [hWdef, hGdef]
    change (ee (-(inner ℝ q.1 x : ℝ)) * ee (-(inner ℝ q.2 x : ℝ)))
        * (mfull j ε m t q.1 * mfull j ε m t q.2 * (Ff : Pl2 → ℂ) (pr q.1 q.2))
      = ee (-(inner ℝ (q.1 + q.2 : Pl) x : ℝ))
        * (mfull j ε m t (q.1 + q.2 - q.2) * mfull j ε m t q.2
            * (Ff : Pl2 → ℂ) (pr (q.1 + q.2 - q.2) q.2))
    rw [h1, harg, show -((inner ℝ q.1 x : ℝ) + (inner ℝ q.2 x : ℝ))
      = -(inner ℝ q.1 x : ℝ) + -(inner ℝ q.2 x : ℝ) by ring, ee_add]
  have hWint : Integrable W (volume : Measure (Pl × Pl)) := by
    rw [hWdef]
    exact integrable_ee_mfull_prod hm ε t Ff x
  have hGint : Integrable G (volume : Measure (Pl × Pl)) := by
    have hcomp : Integrable (G ∘ shiftME) (volume : Measure (Pl × Pl)) := by
      have hfun : (G ∘ shiftME) = W := by
        funext q
        exact (hWG q).symm
      rw [hfun]
      exact hWint
    exact (measurePreserving_shiftME.integrable_comp_emb shiftME.measurableEmbedding).mp hcomp
  -- Step 1: the left-hand side as an integral over `Pl × Pl`
  have hL : (Top2S hm ε t F : Pl2 → ℂ) (pr x x) = ∫ q : Pl × Pl, W q := by
    rw [Top2S, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl2,
      ← measurePreserving_prPair.integral_comp
        (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toHomeomorph.measurableEmbedding
        (fun v : Pl2 => ee (inner ℝ v (-(pr x x)))
          * ((SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) :
              SchwartzMap Pl2 ℂ) : Pl2 → ℂ) v)]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    change ee (inner ℝ (pr q.1 q.2 : Pl2) (-(pr x x)))
        * ((SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F) :
            SchwartzMap Pl2 ℂ) : Pl2 → ℂ) (pr q.1 q.2) = W q
    rw [SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul,
      mfull2S]
    have harg : (inner ℝ (pr q.1 q.2 : Pl2) (-(pr x x)) : ℝ)
        = -(inner ℝ q.1 x : ℝ) + -(inner ℝ q.2 x : ℝ) := by
      rw [pr_neg, inner_pr, inner_neg_right, inner_neg_right]
    rw [harg, ee_add, tens_apply_pr, mfullS_apply, mfullS_apply, hWdef]
  -- Step 2: the change of variables
  have hchange : (∫ q : Pl × Pl, W q) = ∫ q : Pl × Pl, G q := by
    rw [← measurePreserving_shiftME.integral_comp' G]
    refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
    exact hWG q
  -- Step 3: Fubini
  have hfub : (∫ q : Pl × Pl, G q) = ∫ ξ : Pl, ∫ η : Pl, G (ξ, η) := by
    rw [Measure.volume_eq_prod] at hGint ⊢
    have hG' : Integrable (Function.uncurry fun ξ η => G (ξ, η))
        ((volume : Measure Pl).prod (volume : Measure Pl)) := hGint
    exact (integral_integral hG').symm
  -- Step 4: the inner integral
  have hinner : ∀ ξ : Pl, (∫ η : Pl, G (ξ, η))
      = ee (-(inner ℝ ξ x : ℝ)) * Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
    intro ξ
    rw [Sop, SopK, ← integral_const_mul]
    refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
    change ee (-(inner ℝ ξ x : ℝ)) * (mfull j ε m t (ξ - η) * mfull j ε m t η
        * (Ff : Pl2 → ℂ) (pr (ξ - η) η))
      = ee (-(inner ℝ ξ x : ℝ)) * (phase ε t ξ η * bprod m t ξ η
          * 𝓕 ((F : Pl2 → ℂ)) (pr (ξ - η) η))
    rw [phase_bprod_eq hm ε t ξ η, hFf]
  -- Step 5: the right-hand side
  have hR : 𝓕⁻ (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) x
      = ∫ ξ : Pl, ee (-(inner ℝ ξ x : ℝ)) * Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
    rw [Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl]
    refine integral_congr_ae (Filter.Eventually.of_forall fun ξ => ?_)
    simp only [inner_neg_right]
  rw [hL, hchange, hfub, hR]
  exact integral_congr_ae (Filter.Eventually.of_forall hinner)

/-! ### `S[F, bprod m]` is continuous and integrable -/

theorem norm_pr_ge_right (a b : Pl) : ‖b‖ ≤ ‖(pr a b : Pl2)‖ := by
  have h : ‖(pr a b : Pl2)‖ ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2 := norm_pr_sq a b
  nlinarith [norm_nonneg a, norm_nonneg b, norm_nonneg (pr a b : Pl2)]

/-- The `ℝ⁴` multiplier applied to `𝓕F`, as a Schwartz function. -/
noncomputable def Hmul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) : SchwartzMap Pl2 ℂ :=
  SchwartzMap.smulLeftCLM ℂ ((mfull2S hm ε t : Pl2 → ℂ)) (𝓕 F)

theorem Hmul_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (ω : Pl2) :
    (Hmul hm ε t F : Pl2 → ℂ)  ω
      = (mfull2S hm ε t : Pl2 → ℂ) ω * 𝓕 ((F : Pl2 → ℂ)) ω := by
  rw [Hmul, SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull2 hm ε t), smul_eq_mul,
    SchwartzMap.fourier_coe]

theorem Sop_eq_integral_Hmul {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) (ξ : Pl) :
    Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t
      = ∫ η : Pl, (Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η) := by
  rw [Sop, SopK]
  refine integral_congr_ae (Filter.Eventually.of_forall fun η => ?_)
  simp only [Hmul_apply, mfull2S, tens_apply_pr, mfullS_apply]
  rw [phase_bprod_eq hm ε t ξ η]

/-- The decay of a Schwartz function on `ℝ⁴`, in the form needed for the majorant. -/
theorem exists_decay_Pl2 (H : SchwartzMap Pl2 ℂ) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ w : Pl2, ‖(H : Pl2 → ℂ) w‖ * (1 + ‖w‖) ^ (3 : ℕ) ≤ K := by
  refine ⟨2 ^ (3 : ℕ) * (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
    (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H, ?_, ?_⟩
  · have h : (0 : ℝ) ≤ (Finset.Iic ((3 : ℕ), (0 : ℕ))).sup
        (fun m => SchwartzMap.seminorm ℝ m.1 m.2) H := apply_nonneg _ _
    positivity
  · intro w
    have h := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := ℝ) (m := ((3 : ℕ), (0 : ℕ)))
      (le_refl 3) (le_refl 0) H w
    rw [norm_iteratedFDeriv_zero] at h
    rw [mul_comm]
    exact h

theorem integrable_inv_one_add_norm_cube :
    Integrable (fun η : Pl => ((1 + ‖η‖) ^ (3 : ℕ))⁻¹) (volume : Measure Pl) := by
  have hrank : ((Module.finrank ℝ Pl : ℕ) : ℝ) < 3 := by
    rw [finrank_euclideanSpace_fin]
    norm_num
  have h := integrable_one_add_norm (E := Pl) (μ := (volume : Measure Pl)) (r := 3) hrank
  have hfun : (fun η : Pl => (1 + ‖η‖) ^ (-(3 : ℝ)))
      = fun η : Pl => ((1 + ‖η‖) ^ (3 : ℕ))⁻¹ := by
    funext η
    have h1 : (0 : ℝ) < 1 + ‖η‖ := by positivity
    rw [Real.rpow_neg h1.le, ← Real.rpow_natCast (1 + ‖η‖) 3]
    norm_num
  rw [← hfun]
  exact h

theorem continuous_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    Continuous fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
  obtain ⟨K, hK0, hK⟩ := exists_decay_Pl2 (Hmul hm ε t F)
  have hrepr : (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t)
      = fun ξ : Pl => ∫ η : Pl, (Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η) := by
    funext ξ
    exact Sop_eq_integral_Hmul hm ε t F ξ
  rw [hrepr]
  have hcontpr : ∀ ξ : Pl, Continuous fun η : Pl => (pr (ξ - η) η : Pl2) :=
    fun ξ => continuous_prPair.comp ((continuous_const.sub continuous_id).prodMk continuous_id)
  have hcontpr' : ∀ η : Pl, Continuous fun ξ : Pl => (pr (ξ - η) η : Pl2) :=
    fun η => continuous_prPair.comp ((continuous_id.sub continuous_const).prodMk continuous_const)
  refine continuous_of_dominated (bound := fun η : Pl => K * ((1 + ‖η‖) ^ (3 : ℕ))⁻¹) ?_ ?_ ?_ ?_
  · intro ξ
    exact ((Hmul hm ε t F).continuous.comp (hcontpr ξ)).aestronglyMeasurable
  · intro ξ
    filter_upwards with η
    have h1 := hK (pr (ξ - η) η)
    have h2 : (1 : ℝ) + ‖η‖ ≤ 1 + ‖(pr (ξ - η) η : Pl2)‖ := by
      linarith [norm_pr_ge_right (ξ - η) η]
    have h3 : (0 : ℝ) < (1 + ‖η‖) ^ (3 : ℕ) := by positivity
    have h4 : ((1 + ‖η‖) ^ (3 : ℕ)) ≤ ((1 + ‖(pr (ξ - η) η : Pl2)‖) ^ (3 : ℕ)) := by
      refine pow_le_pow_left₀ (by positivity) h2 3
    have h5 : ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ * ((1 + ‖η‖) ^ (3 : ℕ)) ≤ K := by
      refine le_trans (mul_le_mul_of_nonneg_left h4 (norm_nonneg _)) h1
    rw [← le_div_iff₀ h3] at h5
    refine le_trans h5 (le_of_eq ?_)
    field_simp
  · exact (integrable_inv_one_add_norm_cube).const_mul K
  · filter_upwards with η
    exact (Hmul hm ε t F).continuous.comp (hcontpr' η)

theorem integrable_Sop {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    Integrable (fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t) (volume : Measure Pl) := by
  refine ⟨(continuous_Sop hm ε t F).aestronglyMeasurable, ?_⟩
  have hmeas : Measurable fun w : Pl2 => ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ :=
    (Hmul hm ε t F).continuous.enorm.measurable
  have hbd : ∀ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ
      ≤ ∫⁻ η : Pl, ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ₑ := by
    intro ξ
    rw [Sop_eq_integral_Hmul hm ε t F ξ]
    exact enorm_integral_le_lintegral_enorm _
  have hfin : (∫⁻ w : Pl2, ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ) < ⊤ :=
    (Hmul hm ε t F).integrable.hasFiniteIntegral
  calc (∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ)
      ≤ ∫⁻ ξ : Pl, ∫⁻ η : Pl, ‖(Hmul hm ε t F : Pl2 → ℂ) (pr (ξ - η) η)‖ₑ :=
        lintegral_mono hbd
    _ = ∫⁻ w : Pl2, ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ :=
        lintegral_pr_shift (fun w => ‖(Hmul hm ε t F : Pl2 → ℂ) w‖ₑ) hmeas
    _ < ⊤ := hfin

/-! ### The `L²` endpoint of §3 for `𝒯_j` -/

/-- The diagonal embedding `ℝ² → ℝ⁴`. -/
def diagCLM : Pl →L[ℝ] Pl2 :=
  (WithLp.prodContinuousLinearEquiv 2 ℝ Pl Pl).symm.toContinuousLinearMap.comp
    ((ContinuousLinearMap.id ℝ Pl).prod (ContinuousLinearMap.id ℝ Pl))

@[simp] theorem diagCLM_apply (x : Pl) : (diagCLM x : Pl2) = pr x x := rfl

theorem diag_upper : ∃ (k : ℕ) (C : ℝ), ∀ x : Pl, ‖x‖ ≤ C * (1 + ‖(diagCLM x : Pl2)‖) ^ k := by
  refine ⟨1, 1, fun x => ?_⟩
  have h := norm_pr_ge_right x x
  rw [diagCLM_apply]
  simp only [pow_one, one_mul]
  linarith

/-- The restriction of a Schwartz function on `ℝ⁴` to the diagonal. -/
noncomputable def diagS (H : SchwartzMap Pl2 ℂ) : SchwartzMap Pl ℂ :=
  SchwartzMap.compCLM ℝ (g := (diagCLM : Pl → Pl2)) diagCLM.hasTemperateGrowth diag_upper H

@[simp] theorem diagS_apply (H : SchwartzMap Pl2 ℂ) (x : Pl) :
    (diagS H : Pl → ℂ) x = (H : Pl2 → ℂ) (pr x x) := rfl

theorem fourier_diagS_Top2S {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ))
      = fun ξ : Pl => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t := by
  set g : Pl → ℂ := fun ξ => Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t with hgdef
  have hu : ((diagS (Top2S hm ε t F) : Pl → ℂ)) = 𝓕⁻ g := by
    funext x
    rw [diagS_apply, hgdef]
    exact Top2S_diag_eq_fourierInv_Sop hm ε t F x
  have hginv : Integrable (𝓕 g) (volume : Measure Pl) := by
    have hpt : (𝓕 g) = fun w : Pl => ((diagS (Top2S hm ε t F) : Pl → ℂ)) (-w) := by
      funext w
      rw [hu, Real.fourierInv_eq_fourier_neg, neg_neg]
    rw [hpt]
    exact ((diagS (Top2S hm ε t F)).integrable).comp_neg
  rw [hu]
  have hgc : Continuous g := by
    rw [hgdef]
    exact continuous_Sop hm ε t F
  have hgi : Integrable g (volume : Measure Pl) := by
    rw [hgdef]
    exact integrable_Sop hm ε t F
  exact hgc.fourier_fourierInv_eq hgi hginv

/-- **The `L²` transfer for `𝒯_j`.**  Plancherel identifies the `L²` norm of `𝒯_jF(·,t)` with that
of the §4 operator `S[F, bprod m](·,t)`. -/
theorem lintegral_enorm_sq_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (F : SchwartzMap Pl2 ℂ) :
    (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
  have h1 : (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(diagS (Top2S hm ε t F) : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
    refine lintegral_congr fun x => ?_
    rw [Top2_eq_Top2S hm ε t F x, diagS_apply]
  have h2 : (∫⁻ ξ : Pl, ‖𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ)) ξ‖ₑ ^ (2 : ℝ))
      = ∫⁻ x : Pl, ‖(diagS (Top2S hm ε t F) : Pl → ℂ) x‖ₑ ^ (2 : ℝ) :=
    lintegral_enorm_sq_fourier_schwartz_Pl (diagS (Top2S hm ε t F))
  have h3 : (∫⁻ ξ : Pl, ‖𝓕 ((diagS (Top2S hm ε t F) : Pl → ℂ)) ξ‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
    rw [fourier_diagS_Top2S hm ε t F]
  rw [h1, ← h2, h3]

/-- **Proposition 3.1 for `𝒯_j`**: the `L²` endpoint of §3 in physical space, for arbitrary
Schwartz data on `ℝ⁴`. -/
theorem prop31_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0)
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {M : ℕ} (hM : 2 * M ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((M : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ M, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    (F : SchwartzMap Pl2 ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      ≤ ENNReal.ofReal (2 * ((M : ℝ) + 2) ^ 2
          * (KP31 Cs CV Cst * (4 * B0 ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))
        * wMass gam F := by
  have hstep : ∀ t ∈ Efin, (∫⁻ x : Pl, ‖Top2 j ε m t ((F : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
      = ∫⁻ ξ : Pl, ‖Sop ε (bprod m) ((F : Pl2 → ℂ)) ξ t‖ₑ ^ (2 : ℝ) := by
    intro t _
    exact lintegral_enorm_sq_Top2 hm ε t F
  rw [Finset.sum_congr rfl hstep]
  exact prop31_bprod hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin hgam1 hgam2
    hNa hM hcard hcount F

/-! ### `𝒯_j` is continuous on `L¹(ℝ⁴)` -/

/-- The `L¹` norm of the multiplier, which bounds the kernel. -/
noncomputable def Ckern (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) : ℝ :=
  ∫ ω : Pl, ‖mfull j ε m t ω‖

theorem integrable_mfull {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) :
    Integrable (mfull j ε m t) (volume : Measure Pl) :=
  ((contDiff_mfull hm ε t).continuous).integrable_of_hasCompactSupport
    (hasCompactSupport_mfull hm ε t)

theorem Ckern_nonneg (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) : 0 ≤ Ckern j ε m t := by
  rw [Ckern]
  exact integral_nonneg fun ω => norm_nonneg _

theorem norm_kern_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (_hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    ‖kern j ε m t u‖ ≤ Ckern j ε m t := by
  rw [kern, Ckern]
  refine le_trans (norm_integral_le_integral_norm _) (le_of_eq ?_)
  refine integral_congr_ae (Filter.Eventually.of_forall fun ω => ?_)
  simp only [norm_mul, norm_ee, one_mul]

theorem integrable_Top2_integrand {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hh : Integrable h (volume : Measure Pl2))
    (x : Pl) :
    Integrable (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q)
      (volume : Measure Pl2) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hmeas : AEStronglyMeasurable
      (fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q)
      (volume : Measure Pl2) := by
    have h1 : Continuous fun q : Pl2 => kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) :=
      (hkc.comp (continuous_const.sub prjL.continuous)).mul
        (hkc.comp (continuous_const.sub prjR.continuous))
    exact h1.aestronglyMeasurable.mul hh.aestronglyMeasurable
  refine Integrable.mono' ((hh.norm).const_mul (Ckern j ε m t * Ckern j ε m t)) hmeas
    (Filter.Eventually.of_forall fun q => ?_)
  have hb1 := norm_kern_le hm ε t (x - prjL q)
  have hb2 := norm_kern_le hm ε t (x - prjR q)
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
      = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
        rw [norm_mul, norm_mul]
    _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
        refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
        exact mul_le_mul hb1 hb2 (norm_nonneg _) hC

/-- **`𝒯_j` is bounded from `L¹(ℝ⁴)` to `L^∞`.** -/
theorem norm_Top2_le_L1 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ} (hh : Integrable h (volume : Measure Pl2))
    (x : Pl) :
    ‖Top2 j ε m t h x‖ ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h q‖ := by
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  rw [Top2]
  refine le_trans (norm_integral_le_integral_norm _) ?_
  have hbd : ∀ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
      ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
    intro q
    have hb1 := norm_kern_le hm ε t (x - prjL q)
    have hb2 := norm_kern_le hm ε t (x - prjR q)
    calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
        = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
          rw [norm_mul, norm_mul]
      _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
          refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
          exact mul_le_mul hb1 hb2 (norm_nonneg _) hC
  have hint1 : Integrable
      (fun q : Pl2 => ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖)
      (volume : Measure Pl2) := (integrable_Top2_integrand hm ε t hh x).norm
  have hint2 : Integrable (fun q : Pl2 => Ckern j ε m t * Ckern j ε m t * ‖h q‖)
      (volume : Measure Pl2) := (hh.norm).const_mul _
  calc (∫ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖)
      ≤ ∫ q : Pl2, Ckern j ε m t * Ckern j ε m t * ‖h q‖ :=
        integral_mono hint1 hint2 hbd
    _ = Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h q‖ := integral_const_mul _ _

theorem Top2_sub {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h1 h2 : Pl2 → ℂ}
    (hh1 : Integrable h1 (volume : Measure Pl2)) (hh2 : Integrable h2 (volume : Measure Pl2))
    (x : Pl) :
    Top2 j ε m t (h1 - h2) x = Top2 j ε m t h1 x - Top2 j ε m t h2 x := by
  rw [Top2, Top2, Top2, ← integral_sub (integrable_Top2_integrand hm ε t hh1 x)
    (integrable_Top2_integrand hm ε t hh2 x)]
  refine integral_congr_ae (Filter.Eventually.of_forall fun q => ?_)
  change kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * (h1 q - h2 q)
    = kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h1 q
      - kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h2 q
  ring

/-! ### Continuity of `𝒯_j` and the transfer of the `L²` estimate along `L¹` limits -/

theorem continuous_Top2 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : Pl2 → ℂ}
    (hh : Integrable h (volume : Measure Pl2)) :
    Continuous (Top2 j ε m t h) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  refine continuous_of_dominated (bound := fun q : Pl2 => Ckern j ε m t * Ckern j ε m t * ‖h q‖)
    ?_ ?_ ((hh.norm).const_mul _) ?_
  · intro x
    exact (integrable_Top2_integrand hm ε t hh x).aestronglyMeasurable
  · intro x
    filter_upwards with q
    have hb1 := norm_kern_le hm ε t (x - prjL q)
    have hb2 := norm_kern_le hm ε t (x - prjR q)
    calc ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * h q‖
        = ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖ * ‖h q‖ := by
          rw [norm_mul, norm_mul]
      _ ≤ Ckern j ε m t * Ckern j ε m t * ‖h q‖ := by
          refine mul_le_mul_of_nonneg_right ?_ (norm_nonneg _)
          exact mul_le_mul hb1 hb2 (norm_nonneg _) hC
  · filter_upwards with q
    have h1 : Continuous fun x : Pl => kern j ε m t (x - prjL q) :=
      hkc.comp (continuous_id.sub continuous_const)
    have h2 : Continuous fun x : Pl => kern j ε m t (x - prjR q) :=
      hkc.comp (continuous_id.sub continuous_const)
    exact (h1.mul h2).mul continuous_const

/-- If `h n → H` in `L¹(ℝ⁴)`, then `𝒯_j h n → 𝒯_j H` pointwise. -/
theorem tendsto_Top2_of_tendsto_L1 {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {h : ℕ → Pl2 → ℂ} {H : Pl2 → ℂ}
    (hhn : ∀ n, Integrable (h n) (volume : Measure Pl2))
    (hH : Integrable H (volume : Measure Pl2))
    (hconv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖h n q - H q‖) Filter.atTop (nhds 0))
    (x : Pl) :
    Filter.Tendsto (fun n => Top2 j ε m t (h n) x) Filter.atTop (nhds (Top2 j ε m t H x)) := by
  have hC : 0 ≤ Ckern j ε m t := Ckern_nonneg j ε m t
  rw [Metric.tendsto_atTop]
  intro δ hδ
  by_cases hCz : Ckern j ε m t * Ckern j ε m t = 0
  · refine ⟨0, fun n _ => ?_⟩
    have hbd : ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := by
      rw [← Top2_sub hm ε t (hhn n) hH x]
      exact norm_Top2_le_L1 hm ε t ((hhn n).sub hH) x
    rw [hCz, zero_mul] at hbd
    have : dist (Top2 j ε m t (h n) x) (Top2 j ε m t H x) = 0 := by
      rw [dist_eq_norm]
      exact le_antisymm hbd (norm_nonneg _)
    rw [this]
    exact hδ
  · have hCpos : 0 < Ckern j ε m t * Ckern j ε m t := by
      rcases lt_or_eq_of_le (by positivity : (0 : ℝ) ≤ Ckern j ε m t * Ckern j ε m t) with h1 | h1
      · exact h1
      · exact absurd h1.symm hCz
    have hδ' : 0 < δ / (Ckern j ε m t * Ckern j ε m t) := by positivity
    rw [Metric.tendsto_atTop] at hconv
    obtain ⟨N, hN⟩ := hconv (δ / (Ckern j ε m t * Ckern j ε m t)) hδ'
    refine ⟨N, fun n hn => ?_⟩
    have hbd : ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := by
      rw [← Top2_sub hm ε t (hhn n) hH x]
      exact norm_Top2_le_L1 hm ε t ((hhn n).sub hH) x
    have hsmall : (∫ q : Pl2, ‖h n q - H q‖) < δ / (Ckern j ε m t * Ckern j ε m t) := by
      have h1 := hN n hn
      rw [Real.dist_eq, sub_zero] at h1
      have h2 : (0 : ℝ) ≤ ∫ q : Pl2, ‖h n q - H q‖ :=
        integral_nonneg fun q => norm_nonneg _
      rw [abs_of_nonneg h2] at h1
      exact h1
    rw [dist_eq_norm]
    calc ‖Top2 j ε m t (h n) x - Top2 j ε m t H x‖
        ≤ Ckern j ε m t * Ckern j ε m t * ∫ q : Pl2, ‖h n q - H q‖ := hbd
      _ < Ckern j ε m t * Ckern j ε m t * (δ / (Ckern j ε m t * Ckern j ε m t)) :=
          mul_lt_mul_of_pos_left hsmall hCpos
      _ = δ := by
          have hne : Ckern j ε m t ≠ 0 := by
            intro hzero
            rw [hzero, mul_zero] at hCpos
            exact absurd hCpos (lt_irrefl 0)
          field_simp

/-! ### Smooth cutoffs on `ℝ⁴` -/

/-- The first coordinate of the separation `y - z`, as a continuous linear functional on `ℝ⁴`. -/
noncomputable def sepFst : Pl2 →L[ℝ] ℝ :=
  (EuclideanSpace.proj (0 : Fin 2)).comp sepCLM

@[simp] theorem sepFst_apply (q : Pl2) : sepFst q = (sepCLM q) 0 := rfl

/-- A smooth cutoff on `ℝ⁴` that vanishes where `|y₁ - z₁| ≤ δ/2` and equals `1` where
`|y₁ - z₁| ≥ δ`. -/
noncomputable def cutDiag (δ : ℝ) (q : Pl2) : ℝ :=
  Real.smoothTransition ((sepFst q ^ 2 - (δ / 2) ^ 2) / (δ ^ 2 - (δ / 2) ^ 2))

theorem contDiff_cutDiag (δ : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutDiag δ) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => sepFst q ^ 2 :=
    (sepFst.contDiff).pow 2
  exact Real.smoothTransition.contDiff.comp ((h1.sub contDiff_const).div_const _)

theorem cutDiag_nonneg (δ : ℝ) (q : Pl2) : 0 ≤ cutDiag δ q := Real.smoothTransition.nonneg _

theorem cutDiag_le_one (δ : ℝ) (q : Pl2) : cutDiag δ q ≤ 1 := Real.smoothTransition.le_one _

theorem cutDiag_eq_one {δ : ℝ} (hδ : 0 < δ) {q : Pl2} (h : δ ≤ |sepFst q|) :
    cutDiag δ q = 1 := by
  have hden : (0 : ℝ) < δ ^ 2 - (δ / 2) ^ 2 := by nlinarith
  rw [cutDiag]
  refine Real.smoothTransition.one_of_one_le ?_
  rw [le_div_iff₀ hden]
  nlinarith [sq_abs (sepFst q), abs_nonneg (sepFst q)]

theorem cutDiag_eq_zero {δ : ℝ} (hδ : 0 < δ) {q : Pl2} (h : |sepFst q| ≤ δ / 2) :
    cutDiag δ q = 0 := by
  have hden : (0 : ℝ) < δ ^ 2 - (δ / 2) ^ 2 := by nlinarith
  rw [cutDiag]
  refine Real.smoothTransition.zero_of_nonpos ?_
  rw [div_nonpos_iff]
  refine Or.inr ⟨?_, le_of_lt hden⟩
  nlinarith [sq_abs (sepFst q), abs_nonneg (sepFst q)]

/-- A smooth cutoff on `ℝ⁴` that equals `1` on the ball of radius `R` and vanishes outside the
ball of radius `2R`. -/
noncomputable def cutBall (R : ℝ) (q : Pl2) : ℝ :=
  Real.smoothTransition ((4 * R ^ 2 - ‖q‖ ^ 2) / (3 * R ^ 2))

theorem contDiff_cutBall (R : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutBall R) := by
  have h1 : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => ‖q‖ ^ 2 := contDiff_norm_sq ℝ
  exact Real.smoothTransition.contDiff.comp ((contDiff_const.sub h1).div_const _)

theorem cutBall_nonneg (R : ℝ) (q : Pl2) : 0 ≤ cutBall R q := Real.smoothTransition.nonneg _

theorem cutBall_le_one (R : ℝ) (q : Pl2) : cutBall R q ≤ 1 := Real.smoothTransition.le_one _

theorem cutBall_eq_one {R : ℝ} (hR : 0 < R) {q : Pl2} (h : ‖q‖ ≤ R) : cutBall R q = 1 := by
  have hden : (0 : ℝ) < 3 * R ^ 2 := by positivity
  rw [cutBall]
  refine Real.smoothTransition.one_of_one_le ?_
  rw [le_div_iff₀ hden]
  nlinarith [norm_nonneg q]

theorem cutBall_eq_zero {R : ℝ} (hR : 0 < R) {q : Pl2} (h : 2 * R ≤ ‖q‖) : cutBall R q = 0 := by
  have hden : (0 : ℝ) < 3 * R ^ 2 := by positivity
  rw [cutBall]
  refine Real.smoothTransition.zero_of_nonpos ?_
  rw [div_nonpos_iff]
  refine Or.inr ⟨?_, le_of_lt hden⟩
  nlinarith [norm_nonneg q, hR]

theorem hasCompactSupport_cutBall {R : ℝ} (hR : 0 < R) : HasCompactSupport (cutBall R) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl2) (2 * R)) fun q hq => ?_
  refine cutBall_eq_zero hR ?_
  rw [Metric.mem_closedBall, dist_zero_right] at hq
  exact le_of_lt (by simpa using not_le.mp (fun hc => hq hc))

/-- The product cutoff: smooth, compactly supported, equal to `1` where `|y₁-z₁| ≥ δ` and
`‖q‖ ≤ R`. -/
noncomputable def cutBoth (δ R : ℝ) (q : Pl2) : ℂ := ((cutDiag δ q * cutBall R q : ℝ) : ℂ)

theorem contDiff_cutBoth (δ R : ℝ) : ContDiff ℝ (↑(⊤ : ℕ∞)) (cutBoth δ R) := by
  have h : ContDiff ℝ (↑(⊤ : ℕ∞)) fun q : Pl2 => cutDiag δ q * cutBall R q :=
    (contDiff_cutDiag δ).mul (contDiff_cutBall R)
  exact Complex.ofRealCLM.contDiff.comp h

theorem norm_cutBoth_le_one (δ R : ℝ) (q : Pl2) : ‖cutBoth δ R q‖ ≤ 1 := by
  rw [cutBoth, Complex.norm_real, Real.norm_eq_abs,
    abs_of_nonneg (mul_nonneg (cutDiag_nonneg δ q) (cutBall_nonneg R q))]
  exact mul_le_one₀ (cutDiag_le_one δ q) (cutBall_nonneg R q) (cutBall_le_one R q)

theorem cutBoth_eq_one {δ R : ℝ} (hδ : 0 < δ) (hR : 0 < R) {q : Pl2}
    (h1 : δ ≤ |sepFst q|) (h2 : ‖q‖ ≤ R) : cutBoth δ R q = 1 := by
  rw [cutBoth, cutDiag_eq_one hδ h1, cutBall_eq_one hR h2, mul_one, Complex.ofReal_one]

theorem hasCompactSupport_cutBoth {δ R : ℝ} (hR : 0 < R) : HasCompactSupport (cutBoth δ R) := by
  refine HasCompactSupport.intro (isCompact_closedBall (0 : Pl2) (2 * R)) fun q hq => ?_
  have hz : cutBall R q = 0 := by
    refine cutBall_eq_zero hR ?_
    rw [Metric.mem_closedBall, dist_zero_right] at hq
    exact le_of_lt (by simpa using not_le.mp (fun hc => hq hc))
  rw [cutBoth, hz, mul_zero, Complex.ofReal_zero]

/-! ### Bounded compactly supported data: membership, the weight, and Hölder -/

theorem memLp_of_bdd_support {p : ℝ≥0∞} {G : Pl2 → ℂ} (hGm : Measurable G) {CG ρ : ℝ}
    (hGb : ∀ q, ‖G q‖ ≤ CG) (hsupp : ∀ q, ρ < ‖q‖ → G q = 0) :
    MemLp G p (volume : Measure Pl2) := by
  refine (memLp_top_of_bound hGm.aestronglyMeasurable CG
    (Filter.Eventually.of_forall hGb)).mono_exponent_of_measure_support_ne_top
    (s := Metric.closedBall (0 : Pl2) ρ) ?_ ?_ le_top
  · intro q hq
    refine hsupp q ?_
    rw [Metric.mem_closedBall, dist_zero_right] at hq
    exact not_le.mp hq
  · exact (measure_closedBall_lt_top).ne

theorem abs_sepFst_le (q : Pl2) : |sepFst q| ≤ ‖sepCLM q‖ := by
  have hsq : ‖sepCLM q‖ ^ 2 = (sepCLM q) 0 ^ 2 + (sepCLM q) 1 ^ 2 := norm_sq_two _
  rw [sepFst_apply]
  nlinarith [abs_nonneg ((sepCLM q) 0), norm_nonneg (sepCLM q), sq_abs ((sepCLM q) 0),
    sq_nonneg ((sepCLM q) 1)]

/-- On functions supported away from the diagonal the weight is bounded. -/
theorem wMass_le_of_away {gam δ : ℝ} (hgam : 1 / 2 ≤ gam) (hδ : 0 < δ) {h : Pl2 → ℂ}
    (hsupp : ∀ q, |sepFst q| < δ → h q = 0) :
    wMass gam h
      ≤ ENNReal.ofReal (δ ^ (-(2 * gam - 1))) * ∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ) := by
  rw [wMass, ← lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  refine lintegral_mono fun q => ?_
  by_cases hq : |sepFst q| < δ
  · rw [hsupp q hq]
    simp
  · have hexp : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
    have h1 : δ ≤ ‖sepCLM q‖ := le_trans (not_lt.mp hq) (abs_sepFst_le q)
    have h2 : ENNReal.ofReal δ ≤ ‖sepCLM q‖ₑ := by
      rw [← ofReal_norm]
      exact ENNReal.ofReal_le_ofReal h1
    have h3 : ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) ≤ (ENNReal.ofReal δ) ^ (-(2 * gam - 1)) := by
      rw [ENNReal.rpow_neg, ENNReal.rpow_neg]
      exact ENNReal.inv_le_inv.mpr (ENNReal.rpow_le_rpow h2 hexp)
    have h4 : (ENNReal.ofReal δ) ^ (-(2 * gam - 1))
        = ENNReal.ofReal (δ ^ (-(2 * gam - 1))) :=
      ENNReal.ofReal_rpow_of_pos hδ
    rw [h4] at h3
    calc ‖h q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
        ≤ ‖h q‖ₑ ^ (2 : ℝ) * ENNReal.ofReal (δ ^ (-(2 * gam - 1))) :=
          mul_le_mul' (le_refl _) h3
      _ = ENNReal.ofReal (δ ^ (-(2 * gam - 1))) * ‖h q‖ₑ ^ (2 : ℝ) := by ring

/-- A quasi-triangle inequality for the weighted mass. -/
theorem wMass_le_four_add (gam : ℝ) {f g : Pl2 → ℂ} (hf : Measurable f) (hg : Measurable g) :
    wMass gam f ≤ 4 * wMass gam g + 4 * wMass gam (f - g) := by
  have hw : Measurable fun q : Pl2 => ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    (sepCLM.continuous.enorm.measurable).pow_const _
  have hA : Measurable fun q : Pl2 => ‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    ((hg.enorm).pow_const _).mul hw
  have hB : Measurable fun q : Pl2 =>
      ‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
    (((hf.sub hg).enorm).pow_const _).mul hw
  have hpt : ∀ q : Pl2, ‖f q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
      ≤ 4 * (‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
        + 4 * (‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))) := by
    intro q
    have hsub : f q = g q + (f - g) q := by
      change f q = g q + (f q - g q)
      ring
    have htri : ‖f q‖ₑ ≤ ‖g q‖ₑ + ‖(f - g) q‖ₑ := by
      rw [hsub]
      exact enorm_add_le _ _
    set X : ℝ≥0∞ := ‖g q‖ₑ with hX
    set Y : ℝ≥0∞ := ‖(f - g) q‖ₑ with hY
    have hmax : ‖f q‖ₑ ≤ 2 * max X Y := by
      refine le_trans htri ?_
      have h1 : X ≤ max X Y := le_max_left _ _
      have h2 : Y ≤ max X Y := le_max_right _ _
      calc X + Y ≤ max X Y + max X Y := add_le_add h1 h2
        _ = 2 * max X Y := by ring
    have hsq : ‖f q‖ₑ ^ (2 : ℝ) ≤ 4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ)) := by
      have h5 : ‖f q‖ₑ ^ (2 : ℝ) ≤ (2 * max X Y) ^ (2 : ℝ) :=
        ENNReal.rpow_le_rpow hmax (by norm_num)
      have h6 : (2 * max X Y) ^ (2 : ℝ) = 4 * (max X Y) ^ (2 : ℝ) := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0:ℝ) ≤ (2:ℝ))]
        congr 1
        rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast]
        norm_num
      have h7 : (max X Y) ^ (2 : ℝ) ≤ X ^ (2 : ℝ) + Y ^ (2 : ℝ) := by
        rcases le_total X Y with hle | hle
        · rw [max_eq_right hle]
          exact le_add_self
        · rw [max_eq_left hle]
          exact le_add_right (le_refl _)
      calc ‖f q‖ₑ ^ (2 : ℝ) ≤ 4 * (max X Y) ^ (2 : ℝ) := by rw [← h6]; exact h5
        _ ≤ 4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ)) := mul_le_mul' (le_refl _) h7
    calc ‖f q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))
        ≤ (4 * (X ^ (2 : ℝ) + Y ^ (2 : ℝ))) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)) :=
          mul_le_mul' hsq (le_refl _)
      _ = 4 * (X ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
          + 4 * (Y ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1))) := by ring
  calc wMass gam f
      ≤ ∫⁻ q : Pl2, (4 * (‖g q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))
          + 4 * (‖(f - g) q‖ₑ ^ (2 : ℝ) * ‖sepCLM q‖ₑ ^ (-(2 * gam - 1)))) := by
        rw [wMass]
        exact lintegral_mono hpt
    _ = 4 * wMass gam g + 4 * wMass gam (f - g) := by
        rw [lintegral_add_left (hA.const_mul 4), lintegral_const_mul _ hA,
          lintegral_const_mul _ hB, wMass, wMass]

/-- Hölder: the `L¹` norm of a function supported in a ball is controlled by its `L²` norm. -/
theorem lintegral_enorm_le_sqrt {ρ : ℝ} {h : Pl2 → ℂ} (hm : Measurable h)
    (hsupp : ∀ q, ρ < ‖q‖ → h q = 0) :
    (∫⁻ q : Pl2, ‖h q‖ₑ)
      ≤ (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2)
        * (volume (Metric.closedBall (0 : Pl2) ρ)) ^ ((1 : ℝ) / 2) := by
  classical
  set K : Set Pl2 := Metric.closedBall (0 : Pl2) ρ with hKdef
  have hKm : MeasurableSet K := measurableSet_closedBall
  have hpt : ∀ q : Pl2, ‖h q‖ₑ
      = ((fun q => ‖h q‖ₑ) * (K.indicator (fun _ => (1 : ℝ≥0∞)))) q := by
    intro q
    by_cases hq : q ∈ K
    · change ‖h q‖ₑ = ‖h q‖ₑ * K.indicator (fun _ => (1 : ℝ≥0∞)) q
      rw [Set.indicator_of_mem hq, mul_one]
    · have hz : h q = 0 := by
        refine hsupp q ?_
        rw [hKdef, Metric.mem_closedBall, dist_zero_right] at hq
        exact not_le.mp hq
      change ‖h q‖ₑ = ‖h q‖ₑ * K.indicator (fun _ => (1 : ℝ≥0∞)) q
      rw [hz, Set.indicator_of_notMem hq]
      simp
  rw [lintegral_congr hpt]
  have hf : AEMeasurable (fun q : Pl2 => ‖h q‖ₑ) (volume : Measure Pl2) :=
    hm.enorm.aemeasurable
  have hg : AEMeasurable (K.indicator (fun _ => (1 : ℝ≥0∞))) (volume : Measure Pl2) :=
    (measurable_const.indicator hKm).aemeasurable
  have hhol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl2)
    Real.HolderConjugate.two_two hf hg
  refine le_trans hhol (le_of_eq ?_)
  congr 1
  have hind : ∀ q : Pl2, (K.indicator (fun _ => (1 : ℝ≥0∞)) q) ^ (2 : ℝ)
      = K.indicator (fun _ => (1 : ℝ≥0∞)) q := by
    intro q
    by_cases hq : q ∈ K
    · rw [Set.indicator_of_mem hq, ENNReal.one_rpow]
    · rw [Set.indicator_of_notMem hq, ENNReal.zero_rpow_of_pos (by norm_num)]
  rw [lintegral_congr hind, lintegral_indicator hKm, setLIntegral_one]

/-! ### The `L²` endpoint for bounded data supported away from the diagonal -/

theorem lintegral_enorm_sq_le_of_eLpNorm {h : Pl2 → ℂ} {c : ℝ≥0∞}
    (hc : eLpNorm h 2 (volume : Measure Pl2) ≤ c) :
    (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ≤ c ^ (2 : ℝ) := by
  have h1 : (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) ≤
      eLpNorm h 2 (volume : Measure Pl2) := by
    by_cases hm : AEStronglyMeasurable h volume
    · rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hm]
      norm_num
    · rw [eLpNorm_of_not_aestronglyMeasurable hm]
      exact le_top
  replace hc := h1.trans hc
  have h2 := ENNReal.rpow_le_rpow hc (by norm_num : (0 : ℝ) ≤ (2 : ℝ))
  rw [← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one] at h2
  exact h2

theorem eLpNorm_two_eq_rpow (h : Pl2 → ℂ) (hh : AEStronglyMeasurable h volume) :
    eLpNorm h 2 (volume : Measure Pl2)
      = (∫⁻ q : Pl2, ‖h q‖ₑ ^ (2 : ℝ)) ^ ((1 : ℝ) / 2) := by
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal (by norm_num) (by norm_num) hh]
  norm_num

set_option maxHeartbeats 4000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **Proposition 3.1 for bounded data supported away from the diagonal.**  The `L²` endpoint of §3
