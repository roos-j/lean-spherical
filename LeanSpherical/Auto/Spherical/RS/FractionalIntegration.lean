    refine le_trans (lintegral_mono hstep) ?_
    rw [lintegral_mul_const _ (hkmeas w)]
    gcongr
    exact lintegral_norm_kern_le hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL w
