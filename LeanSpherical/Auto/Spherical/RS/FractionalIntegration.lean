    have h1 : (∫⁻ w : ℝ, S (x 0 - w)) = ∫⁻ w : ℝ, S (x 0 + w) := by
      have h := lintegral_neg_eq_self (μ := (volume : Measure ℝ))
        (fun w : ℝ => S (x 0 + w))
      simpa [sub_eq_add_neg] using h
