  have hdsupp1 : ∀ n q, |sepFst q| < δ / 2 → gt n q - G q = 0 := by
    intro n q h
    have h1 : cutBoth δ R q = 0 := by
      rw [cutBoth, cutDiag_eq_zero hδ (le_of_lt h), zero_mul, Complex.ofReal_zero]
    rw [hdiff n q, h1, zero_mul]
  have hdsupp2 : ∀ n q, 2 * R < ‖q‖ → gt n q - G q = 0 := by
    intro n q h
    have h1 : cutBoth δ R q = 0 := by
      rw [cutBoth, cutBall_eq_zero hR (le_of_lt h), mul_zero, Complex.ofReal_zero]
    rw [hdiff n q, h1, zero_mul]
