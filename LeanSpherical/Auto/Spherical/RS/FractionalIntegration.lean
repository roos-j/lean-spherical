          * (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2) := by
      intro n
      have h1 := lintegral_enorm_le_sqrt (ρ := 2 * R)
        (h := fun q => gt n q - G q) ((hgtmeas n).sub hGm) (fun q hq => hdsupp2 n q hq)
      refine le_trans h1 (mul_le_mul' ?_ (le_refl _))
      rw [← eLpNorm_two_eq_rpow (fun q => gt n q - G q) ((hgtmeas n).sub hGm).aestronglyMeasurable]
      exact hgtcl n
    have hzero : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1))
        * (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2)) Filter.atTop
        (nhds 0) := by
      have h := ENNReal.Tendsto.mul_const hofRealzero (Or.inr hvol)
      simpa using h
    exact tendsto_of_tendsto_of_tendsto_of_le_of_le tendsto_const_nhds hzero
      (fun _ => zero_le) hbd
  have hL1conv : Filter.Tendsto (fun n => ∫ q : Pl2, ‖gt n q - G q‖) Filter.atTop (nhds 0) := by
    have heq : ∀ n, (∫ q : Pl2, ‖gt n q - G q‖) = (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ).toReal := by
      intro n
      exact integral_norm_eq_lintegral_enorm (((hgtmeas n).sub hGm).aestronglyMeasurable)
    rw [Filter.tendsto_congr heq]
    have h3 : Filter.Tendsto (fun n : ℕ => (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ).toReal)
        Filter.atTop (nhds ((0 : ℝ≥0∞).toReal)) :=
      (ENNReal.tendsto_toReal (by norm_num : (0 : ℝ≥0∞) ≠ ⊤)).comp hL1en
    rwa [ENNReal.toReal_zero] at h3
  -- the finite sum inside the integral
  have hmeasT : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) → ∀ t : ℝ,
      Measurable fun x : Pl => ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh t
    exact ((continuous_Top2 hm ε t hh).enorm.measurable).pow_const _
  have hsum_in : ∀ (h : Pl2 → ℂ), Integrable h (volume : Measure Pl2) →
      (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ))
        = ∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t h x‖ₑ ^ (2 : ℝ) := by
    intro h hh
    rw [lintegral_finsetSum _ (fun t _ => hmeasT h hh t)]
  -- pointwise convergence
  have hptconv : ∀ x : Pl, Filter.Tendsto
      (fun n => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ)) Filter.atTop
      (nhds (∑ t ∈ Efin, ‖Top2 j ε m t G x‖ₑ ^ (2 : ℝ))) := by
    intro x
    refine tendsto_finsetSum _ (fun t _ => ?_)
    have h1 := tendsto_Top2_of_tendsto_L1 hm ε t hgtint hGL1 hL1conv x
    exact ((ENNReal.continuous_rpow_const (y := (2 : ℝ))).tendsto _).comp h1.enorm
  -- Fatou
  have hfatou := lintegral_liminf_le (μ := (volume : Measure Pl))
    (u := (Filter.atTop : Filter ℕ))
    (f := fun n x => ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ))
    (fun n => Finset.measurable_sum _ (fun t _ => hmeasT (gt n) (hgtint n) t))
  -- the bound for each approximant
  have hRHS : ∀ n, (∫⁻ x : Pl, ∑ t ∈ Efin, ‖Top2 j ε m t (gt n) x‖ₑ ^ (2 : ℝ))
      ≤ KE * (4 * wMass gam G + 4 * (W * (ENNReal.ofReal (1 / ((n : ℝ) + 1))) ^ (2 : ℝ))) := by
    intro n
    rw [← hsum_in (gt n) (hgtint n)]
    have h1 : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖Top2 j ε m t ((S n : Pl2 → ℂ)) x‖ₑ ^ (2 : ℝ))
