  have h1 := enorm_TopS_le_mix hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL f x
  have h2 := enorm_TopS_le_mix hp hm hε ht1 ht2 hM hQ hMj hMj2 hBL g x
  rw [enorm_mul]
  refine le_trans (mul_le_mul' h1 h2) (le_of_eq ?_)
