/-- The weight of §3 with the full separation `|y - z|` replaced by the separation `|y₁ - z₁|` of
the first coordinates. -/
noncomputable def wMass1 (gam : ℝ) (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ x : Pl2, ‖F x‖ₑ ^ (2 : ℝ) * ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1))

/-- **The one-dimensional weight dominates.**  Since `|y₁ - z₁| ≤ |y - z|` and the exponent is
negative, replacing the separation by the separation of the first coordinates only increases the
weighted mass. -/
theorem wMass_le_wMass1 {gam : ℝ} (hgam : 1 / 2 < gam) (F : Pl2 → ℂ) :
    wMass gam F ≤ wMass1 gam F := by
  rw [wMass, wMass1]
  refine lintegral_mono fun x => ?_
  have hcoord : ‖(sepCLM x) 0‖ ≤ ‖sepCLM x‖ := by
    have hsq : ‖sepCLM x‖ ^ 2 = (sepCLM x) 0 ^ 2 + (sepCLM x) 1 ^ 2 := norm_sq_two _
    have h1 : ‖(sepCLM x) 0‖ = |(sepCLM x) 0| := rfl
    rw [h1]
    nlinarith [abs_nonneg ((sepCLM x) 0), norm_nonneg (sepCLM x), sq_abs ((sepCLM x) 0),
      sq_nonneg ((sepCLM x) 1)]
  have hle : ‖(sepCLM x) 0‖ₑ ≤ ‖sepCLM x‖ₑ := by
    rw [← ofReal_norm, ← ofReal_norm]
    exact ENNReal.ofReal_le_ofReal hcoord
  have hc : (0 : ℝ) ≤ 2 * gam - 1 := by linarith
  have hstep : ‖sepCLM x‖ₑ ^ (-(2 * gam - 1)) ≤ ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1)) := by
    rw [ENNReal.rpow_neg, ENNReal.rpow_neg]
    exact ENNReal.inv_le_inv.mpr (ENNReal.rpow_le_rpow hle hc)
  exact mul_le_mul' (le_refl _) hstep

/-! ### The bilinear operator on `ℝ⁴` and its endpoint -/

theorem lintegral_sub_left_eq_self' (g : ℝ → ℝ≥0∞) (c : ℝ) :
    (∫⁻ w : ℝ, g (c - w)) = ∫⁻ w : ℝ, g w := by
  have h1 : (∫⁻ w : ℝ, g (c - w)) = ∫⁻ w : ℝ, g (c + w) := by
    have h := lintegral_neg_eq_self (μ := (volume : Measure ℝ)) (fun w : ℝ => g (c + w))
    simpa [sub_eq_add_neg] using h
  rw [h1]
  exact lintegral_add_left_eq_self g c

/-- The bilinear operator `𝒯_j` of §3, defined by its kernel `k_{j,t}(x-y)k_{j,t}(x-z)`. -/
noncomputable def Top2 (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (F : Pl2 → ℂ) (x : Pl) : ℂ :=
  ∫ q : Pl2, kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q) * F q

/-- The mixed norm `‖F‖_{L¹_{(y₁,z₁)}L^∞_{(y₂,z₂)}}` on `ℝ⁴`, in iterated form. -/
noncomputable def mix2 (F : Pl2 → ℂ) : ℝ≥0∞ :=
  ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ⨆ y2 : ℝ, ⨆ z2 : ℝ, ‖F (pr (mk2 y1 y2) (mk2 z1 z2))‖ₑ

