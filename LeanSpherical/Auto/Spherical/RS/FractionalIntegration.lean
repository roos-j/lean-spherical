/-- **The uniform bound on the image of the family**, valid on the whole closed strip. -/
theorem enorm_Top2_Ffam_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQ : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) {F : Pl2 → ℂ} (hF : Measurable F)
    (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤)
    {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (x : Pl) :
    ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ
      ≤ ((∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
            * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) ^ ((1 : ℝ) / 2)
          * (normNpp p gam F) ^ ((1 : ℝ) / 2)
        + ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hkkmeas : Measurable fun q : Pl2 =>
      ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact h1.mul h2
  have hsplit : (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)))
      = (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
        + ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
    have hpt : ∀ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q))
        = ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
          + ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := by
      intro q
      ring
    have hm1 : Measurable fun q : Pl2 =>
        ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) :=
      hkkmeas.mul (measurable_gZero_q hF)
    rw [lintegral_congr hpt, lintegral_add_left hm1]
  calc ‖Top2 j ε m t (Ffam p gam F ζ) x‖ₑ
      ≤ ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q) * kern j ε m t (x - prjR q)
            * Ffam p gam F ζ q‖ₑ := by
        rw [Top2]
        exact enorm_integral_le_lintegral_enorm _
    _ ≤ ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
          * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)) := by
        refine lintegral_mono fun q => ?_
        rw [enorm_mul, enorm_mul]
        exact mul_le_mul' (le_refl _) (enorm_Ffam_le_sum hpgt hgam1 F hζ0 hζ1 q)
    _ = (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
          + ∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
            * gOne p gam F (bs1 q) (bs2 q) := hsplit
    _ ≤ ((∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ))
            * ∫⁻ u : Pl, ‖kern j ε m t u‖ₑ ^ (2 : ℝ) * (1 + ‖u‖ₑ)) ^ ((1 : ℝ) / 2)
          * (normNpp p gam F) ^ ((1 : ℝ) / 2)
        + ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F := by
        refine add_le_add ?_ (lintegral_kern_gOne_le hpol hm hε ht1 ht2 hMk hQ hMj hMj2 hBL
          hpgt x hF)
        refine le_trans (lintegral_kern_gZero_le hm ε t hgam1 hgam2 hpgt x hF hfib) ?_
        refine mul_le_mul' ?_ (le_refl _)
        refine ENNReal.rpow_le_rpow ?_ (by norm_num)
        exact le_trans (CKx1_le_CKx j ε m t hgam1 x) (CKx_le_sq hm ε t hgam1 hgam2 x)

/-! ### The real majorant, and continuity of the family's image in the parameter -/

theorem Ffam_eq_zero_of_gZero_top {p gam : ℝ} {F : Pl2 → ℂ} {ζ : ℂ} {q : Pl2}
    (h : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) = ⊤) : Ffam p gam F ζ q = 0 := by
  rw [Ffam, h, ENNReal.toReal_top, rpowC_zero_base, mul_zero, zero_mul]

theorem Ffam_eq_zero_of_gOne_top {p gam : ℝ} {F : Pl2 → ℂ} {ζ : ℂ} {q : Pl2}
    (h : gOne p gam F (bs1 q) (bs2 q) = ⊤) : Ffam p gam F ζ q = 0 := by
  rw [Ffam, h, ENNReal.toReal_top, rpowC_zero_base, mul_zero]

/-- The real-valued majorant of the family on the closed strip. -/
theorem norm_Ffam_le_toReal_sum {p gam : ℝ} (hp : 2 < p) (hgam1 : 1 / 2 < gam) (F : Pl2 → ℂ)
    {ζ : ℂ} (hζ0 : 0 ≤ ζ.re) (hζ1 : ζ.re ≤ 1) (q : Pl2) :
    ‖Ffam p gam F ζ q‖
      ≤ (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
          + gOne p gam F (bs1 q) (bs2 q)).toReal := by
  by_cases htop : gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
      + gOne p gam F (bs1 q) (bs2 q) = ⊤
  · have hz : Ffam p gam F ζ q = 0 := by
      rcases ENNReal.add_eq_top.mp htop with h | h
      · exact Ffam_eq_zero_of_gZero_top h
      · exact Ffam_eq_zero_of_gOne_top h
    rw [hz, norm_zero, htop, ENNReal.toReal_top]
  · have h := enorm_Ffam_le_sum hp hgam1 F hζ0 hζ1 q
    rw [← ofReal_norm] at h
    have h2 := ENNReal.toReal_le_toReal (by exact ENNReal.ofReal_ne_top) htop |>.mpr h
    rw [ENNReal.toReal_ofReal (norm_nonneg _)] at h2
    exact h2

/-- The real majorant of the kernel integrand. -/
noncomputable def majB (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (p gam : ℝ) (F : Pl2 → ℂ)
    (x : Pl) (q : Pl2) : ℝ :=
  ‖kern j ε m t (x - prjL q)‖ * ‖kern j ε m t (x - prjR q)‖
    * (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) + gOne p gam F (bs1 q) (bs2 q)).toReal

theorem majB_nonneg (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (p gam : ℝ) (F : Pl2 → ℂ)
    (x : Pl) (q : Pl2) : 0 ≤ majB j ε m t p gam F x q := by
  rw [majB]
  positivity

theorem measurable_majB {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (p gam : ℝ) {F : Pl2 → ℂ} (hF : Measurable F) (x : Pl) :
    Measurable (majB j ε m t p gam F x) := by
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ :=
    (hkc.comp (continuous_const.sub prjL.continuous)).norm.measurable
  have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ :=
    (hkc.comp (continuous_const.sub prjR.continuous)).norm.measurable
  have h3 : Measurable fun q : Pl2 => (gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q)
      + gOne p gam F (bs1 q) (bs2 q)).toReal :=
    ((measurable_gZero_q hF).add (measurable_gOne_q hF)).ennreal_toReal
  exact (h1.mul h2).mul h3

