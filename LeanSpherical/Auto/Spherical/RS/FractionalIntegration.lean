/-- **The `L^{p₄}` estimate of §3 for a tensor product.** -/
theorem lintegral_pow_Top2_tensF_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hp : p = (3 + 2 * gam) / 2) (f g : SchwartzMap Pl ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl,
        ‖Top2 j ε m t (tensF (f : Pl → ℂ) (g : Pl → ℂ)) x‖ₑ ^ p) ^ (1 / p)
      ≤ C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)
        * (∫⁻ x : Pl, ‖(g : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  have hp2 : 2 < p := by rw [hp]; linarith
  have hppos : (0 : ℝ) < p := by linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have h1m' : (0 : ℝ) < 1 - 1 / p := by
    have : 1 / p < 1 := by
      rw [div_lt_one hppos]
      linarith
    linarith
  have hfibT := fibProf_tensF_schwartz_ne_top hp2 f g
  have hNT := normNpp_tensF_schwartz_ne_top hgam1 hgam2 hp f g
  have hstep := lintegral_pow_Top2_le hpol hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin
    hgam1 hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hp2
    (measurable_tensF f.continuous.measurable g.continuous.measurable) hfibT hNT
  rw [ennreal_two_factor_alg hp2 _ _ hNT] at hstep
  refine le_trans hstep ?_
  have hN := normNpp_tensF_le hgam1 hgam2 hp f.continuous.measurable g.continuous.measurable
  have hexp2 : (1 / (p - 1)) * (1 - 1 / p) = 1 / p := by
    field_simp
  have hNpow : (normNpp p gam (tensF (f : Pl → ℂ) (g : Pl → ℂ))) ^ (1 - 1 / p)
      ≤ (ENNReal.ofReal (Auto.HardyLittlewoodSobolev.hlsConst
            (2 * (2 * gam - 1) / (1 + 2 * gam)))) ^ (1 - 1 / p)
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)
        * (∫⁻ x : Pl, ‖(g : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
    refine le_trans (ENNReal.rpow_le_rpow hN h1m'.le) (le_of_eq ?_)
    rw [ENNReal.mul_rpow_of_nonneg _ _ h1m'.le, ENNReal.mul_rpow_of_nonneg _ _ h1m'.le,
      ← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hexp2]
  calc (4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
            * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))) ^ (1 / p)
        * (ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2) ^ (1 - 2 / p)
        * (normNpp p gam (tensF (f : Pl → ℂ) (g : Pl → ℂ))) ^ (1 - 1 / p)
      ≤ (4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
            * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))) ^ (1 / p)
        * (ENNReal.ofReal (700000000 * (1 + stC) * B0
            * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2) ^ (1 - 2 / p)
        * ((ENNReal.ofReal (Auto.HardyLittlewoodSobolev.hlsConst
              (2 * (2 * gam - 1) / (1 + 2 * gam)))) ^ (1 - 1 / p)
          * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)
          * (∫⁻ x : Pl, ‖(g : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)) := mul_le_mul' (le_refl _) hNpow
    _ = C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p)
        * (∫⁻ x : Pl, ‖(g : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
        rw [C3]
        ring

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The `L^{q₄}` estimate of §3 for the linear operator**, `q₄ = 2p₄`. -/
theorem lintegral_pow_TopS_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {Cs CV : ℝ} (hCs : ∀ x : ℝ, |deriv shrinkS x| ≤ Cs) (hCVnn : 0 ≤ CV)
    (hCV : ∀ i : Fin 2, ∀ n ≤ 1, ∀ ζ : Pl, ‖iteratedFDeriv ℝ n (unitVec i) ζ‖ ≤ CV)
    {Cst : ℝ} (hCst1 : 1 ≤ Cst)
    (hCstd1 : ∀ x : ℝ, |deriv Real.smoothTransition x| ≤ Cst)
    (hCstd2 : ∀ x : ℝ, |deriv (deriv Real.smoothTransition) x| ≤ Cst)
    {ε : ℝ} (hε : |ε| = 1) (Efin : Finset ℝ) (hEfin : ∀ t ∈ Efin, 1 ≤ t ∧ t ≤ 2)
    {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {Na : ℝ} (hNa : 1 ≤ Na) {Mc : ℕ} (hMc : 2 * Mc ≤ j)
    (hcard : (Efin.card : ℝ) ≤ Na * (2 : ℝ) ^ (2 * ((Mc : ℝ) + 1) * gam))
    (hcount : ∀ k ≤ Mc, IsIntervalCount Efin (((2 : ℝ) ^ (k : ℤ)) ^ 2 / (2 : ℝ) ^ (j : ℤ))
        (Na * (2 : ℝ) ^ (2 * (k : ℝ) * gam)))
    {Mk : ℕ} (hMk : 1 ≤ Mk)
    (hQb : (2 : ℝ) ^ (-(Mk : ℤ)) ≤ 1 / 100) (hMj : 2 * (Mk : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (Mk : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ Mk⌉ ≤ 2 ^ L)
    {p : ℝ} (hp : p = (3 + 2 * gam) / 2) (f : SchwartzMap Pl ℂ) :
    (∑ t ∈ Efin, ∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p)) ^ (1 / (2 * p))
      ≤ (C3 Cs CV Cst Na B0 B0' j Mc Mk L p gam) ^ ((1 : ℝ) / 2)
        * (∫⁻ x : Pl, ‖(f : Pl → ℂ) x‖ₑ ^ p) ^ (1 / p) := by
  have hp2 : 2 < p := by rw [hp]; linarith
  have hppos : (0 : ℝ) < p := by linarith
  -- the bilinearization identity, pointwise
  have hpt : ∀ (t : ℝ) (x : Pl), ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p)
      = ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ ^ p := by
    intro t x
    have h2 : ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ
        = ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 : ℝ) := by
      rw [tensF_eq_tens, Top2_tens hm ε t f f, enorm_mul,
        show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast, pow_two]
    rw [h2, ← ENNReal.rpow_mul]
  have hsum : (∑ t ∈ Efin, ∫⁻ x : Pl, ‖(TopS hm ε t f : Pl → ℂ) x‖ₑ ^ (2 * p))
      = ∑ t ∈ Efin, ∫⁻ x : Pl,
        ‖Top2 j ε m t (tensF (f : Pl → ℂ) (f : Pl → ℂ)) x‖ₑ ^ p := by
    refine Finset.sum_congr rfl fun t _ => ?_
    exact lintegral_congr fun x => hpt t x
  have hroot : ∀ A : ℝ≥0∞, A ^ (1 / (2 * p)) = (A ^ (1 / p)) ^ ((1 : ℝ) / 2) := by
    intro A
    rw [← ENNReal.rpow_mul]
    congr 1
    field_simp
  have hhalf : ∀ C X : ℝ≥0∞, (C * X * X) ^ ((1 : ℝ) / 2) = C ^ ((1 : ℝ) / 2) * X := by
    intro C X
    rw [mul_assoc, ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : ℝ) ≤ 1 / 2)]
    congr 1
    have hXX : X * X = X ^ (2 : ℝ) := by
      rw [show (2 : ℝ) = ((2 : ℕ) : ℝ) by norm_num, ENNReal.rpow_natCast, pow_two]
    rw [hXX, ← ENNReal.rpow_mul, show (2 : ℝ) * (1 / 2) = 1 by norm_num, ENNReal.rpow_one]
  rw [hsum, hroot]
  refine le_trans (ENNReal.rpow_le_rpow
    (lintegral_pow_Top2_tensF_le hpol hm hCs hCVnn hCV hCst1 hCstd1 hCstd2 hε Efin hEfin
      hgam1 hgam2 hNa hMc hcard hcount hMk hQb hMj hMj2 hBL hp f f)
    (by norm_num : (0 : ℝ) ≤ 1 / 2)) (le_of_eq ?_)
  exact hhalf _ _


