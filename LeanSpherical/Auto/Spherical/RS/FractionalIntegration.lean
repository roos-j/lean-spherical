-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The fractional integration step of §3.**  At the exponent `p = p₄ = (3+2γ)/2` the
interpolated norm of a tensor product is controlled by the product of the `L^p` norms; this is
Hölder's inequality in the base variable followed by the one-dimensional Hardy--Littlewood--Sobolev
inequality with `λ = (2γ-1)p'/p`. -/
theorem normNpp_tensF_le {gam p : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (hp : p = (3 + 2 * gam) / 2) {f g : Pl → ℂ} (hf : Measurable f) (hg : Measurable g) :
    normNpp p gam (tensF f g)
      ≤ ENNReal.ofReal (Auto.HardyLittlewoodSobolev.hlsConst (2 * (2 * gam - 1) / (1 + 2 * gam)))
        * (∫⁻ x : Pl, ‖f x‖ₑ ^ p) ^ (1 / (p - 1))
        * (∫⁻ x : Pl, ‖g x‖ₑ ^ p) ^ (1 / (p - 1)) := by
  have hppos : (0 : ℝ) < p := by rw [hp]; linarith
  have hp2 : 2 < p := by rw [hp]; linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  have hgpos : (0 : ℝ) < 1 + 2 * gam := by linarith
  set p' : ℝ := p / (p - 1) with hp'def
  have hp'pos : 0 < p' := div_pos hppos hp1
  set lam : ℝ := 2 * (2 * gam - 1) / (1 + 2 * gam) with hlamdef
  have hlam0 : 0 < lam := by
    rw [hlamdef]
    exact div_pos (by linarith) hgpos
  have hlam1 : lam < 1 := by
    rw [hlamdef, div_lt_one hgpos]
    linarith
  have hlamalt : (1 - 2 * gam) / p * p' = -lam := by
    rw [hlamdef, hp'def, hp]
    have h1 : (3 + 2 * gam) / 2 - 1 = (1 + 2 * gam) / 2 := by ring
    rw [h1]
    field_simp
    ring
  have hp'p : p' * (p - 1) = p := by
    rw [hp'def]
    field_simp
  have hr : 2 / (2 - lam) = p - 1 := by
    rw [hlamdef, hp]
    have h2 : 2 - 2 * (2 * gam - 1) / (1 + 2 * gam) = 4 / (1 + 2 * gam) := by
      field_simp
      ring
    rw [h2]
    field_simp
    ring
  have hq : (2 - lam) / 2 = 1 / (p - 1) := by
    rw [← hr, one_div_div]
  -- rewrite the interpolated norm as a Riesz form
  have hmeasf : Measurable fun y1 : ℝ => (fibP p f y1) ^ p' :=
    (measurable_fibP hf).pow_const _
  have hmeasg : Measurable fun z1 : ℝ => (fibP p g z1) ^ p' :=
    (measurable_fibP hg).pow_const _
  have hrw : normNpp p gam (tensF f g)
      = ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ‖(y1 - z1 : ℝ)‖ₑ ^ (-lam)
          * ((fibP p f y1) ^ p' * (fibP p g z1) ^ p') := by
    rw [normNpp]
    refine lintegral_congr fun y1 => ?_
    refine lintegral_congr fun z1 => ?_
    rw [uB, fibProf_tensF hppos hf hg, wtB,
      ENNReal.mul_rpow_of_nonneg _ _ hp'pos.le, ENNReal.mul_rpow_of_nonneg _ _ hp'pos.le,
      ← ENNReal.rpow_mul, hlamalt]
  rw [hrw]
  refine le_trans (Auto.HardyLittlewoodSobolev.lintegral_bilinear_riesz_le hlam0 hlam1
    hmeasf hmeasg) (le_of_eq ?_)
  have hone : ∀ h : Pl → ℂ, Measurable h →
      ((∫⁻ y1 : ℝ, ((fibP p h y1) ^ p') ^ (2 / (2 - lam))) ^ ((2 - lam) / 2))
        = (∫⁻ x : Pl, ‖h x‖ₑ ^ p) ^ (1 / (p - 1)) := by
    intro h hhm
    have hpt : ∀ y1 : ℝ, ((fibP p h y1) ^ p') ^ (2 / (2 - lam)) = (fibP p h y1) ^ p := by
      intro y1
      rw [hr, ← ENNReal.rpow_mul, hp'p]
    rw [lintegral_congr hpt, lintegral_fibP_pow hppos hhm, hq]
  rw [hone f hf, hone g hg, hlamdef]

/-! ### Finiteness of the interpolated norm of a Schwartz tensor product -/

theorem abs_le_norm_mk2 (x y : ℝ) : |y| ≤ ‖mk2 x y‖ := by
  have hsq : ‖mk2 x y‖ ^ 2 = x ^ 2 + y ^ 2 := norm_mk2_sq x y
  nlinarith [abs_nonneg y, norm_nonneg (mk2 x y), sq_abs y, sq_nonneg x]

theorem lintegral_one_add_abs_rpow_ne_top {r : ℝ} (hr : 1 < r) :
    (∫⁻ v : ℝ, ENNReal.ofReal ((1 + |v|) ^ (-r))) ≠ ⊤ := by
  have hrank : ((Module.finrank ℝ ℝ : ℕ) : ℝ) < r := by
    rw [Module.finrank_self]
    exact_mod_cast hr
  have h := integrable_one_add_norm (E := ℝ) (μ := (volume : Measure ℝ)) (r := r) hrank
  have hfin := h.hasFiniteIntegral
  rw [hasFiniteIntegral_iff_enorm] at hfin
  have heq : ∀ v : ℝ, ‖(1 + ‖v‖) ^ (-r)‖ₑ = ENNReal.ofReal ((1 + |v|) ^ (-r)) := by
    intro v
    rw [← ofReal_norm, Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (by positivity) _), Real.norm_eq_abs]
  rw [lintegral_congr heq] at hfin
  exact hfin.ne

theorem lintegral_fibre_rpow_ne_top_of_decay {p K : ℝ} (hp : 2 < p) (hK : 0 ≤ K)
    {f : Pl → ℂ} (hdec : ∀ u : Pl, ‖f u‖ * (1 + ‖u‖) ^ (3 : ℕ) ≤ K) (y1 : ℝ) :
    (∫⁻ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p) ≠ ⊤ := by
  have hppos : (0 : ℝ) < p := by linarith
  have hmaj : ∀ y2 : ℝ, ‖f (mk2 y1 y2)‖ₑ ^ p
      ≤ ENNReal.ofReal (K ^ p) * ENNReal.ofReal ((1 + |y2|) ^ (-(3 * p))) := by
    intro y2
    have h1 : (0 : ℝ) < 1 + ‖mk2 y1 y2‖ := by positivity
    have h2 : ‖f (mk2 y1 y2)‖ ≤ K * ((1 + ‖mk2 y1 y2‖) ^ (3 : ℕ))⁻¹ := by
      have hu := hdec (mk2 y1 y2)
      rw [← le_div_iff₀ (by positivity : (0 : ℝ) < (1 + ‖mk2 y1 y2‖) ^ (3 : ℕ))] at hu
      refine le_trans hu (le_of_eq ?_)
      field_simp
    have h3 : ((1 + ‖mk2 y1 y2‖) ^ (3 : ℕ))⁻¹ ≤ ((1 + |y2|) ^ (3 : ℕ))⁻¹ := by
      refine inv_anti₀ (by positivity) ?_
      refine pow_le_pow_left₀ (by positivity) ?_ 3
      have := abs_le_norm_mk2 y1 y2
      linarith
    have h4 : ‖f (mk2 y1 y2)‖ ≤ K * ((1 + |y2|) ^ (3 : ℕ))⁻¹ :=
      le_trans h2 (mul_le_mul_of_nonneg_left h3 hK)
    have h5 : ‖f (mk2 y1 y2)‖ ^ p ≤ (K * ((1 + |y2|) ^ (3 : ℕ))⁻¹) ^ p :=
      Real.rpow_le_rpow (norm_nonneg _) h4 hppos.le
    have h6 : (K * ((1 + |y2|) ^ (3 : ℕ))⁻¹) ^ p
        = K ^ p * ((1 + |y2|) ^ (-(3 * p))) := by
      rw [Real.mul_rpow hK (by positivity)]
      congr 1
      have hb : (0 : ℝ) < 1 + |y2| := by positivity
      rw [← Real.rpow_natCast (1 + |y2|) 3, ← Real.rpow_neg_one, ← Real.rpow_mul hb.le,
        ← Real.rpow_mul hb.le]
      congr 1
      push_cast
      ring
    rw [← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hppos.le,
      ← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [← h6]
    exact h5
  refine ne_top_of_le_ne_top ?_ (lintegral_mono hmaj)
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top
    (lintegral_one_add_abs_rpow_ne_top (by linarith))

theorem lintegral_enorm_rpow_Pl_ne_top_of_decay {p K : ℝ} (hp : 2 < p) (hK : 0 ≤ K)
    {f : Pl → ℂ} (hdec : ∀ u : Pl, ‖f u‖ * (1 + ‖u‖) ^ (3 : ℕ) ≤ K) :
    (∫⁻ x : Pl, ‖f x‖ₑ ^ p) ≠ ⊤ := by
  have hppos : (0 : ℝ) < p := by linarith
  have hrank : ((Module.finrank ℝ Pl : ℕ) : ℝ) < 3 * p := by
    rw [finrank_euclideanSpace_fin]
    push_cast
    linarith
  have hint := integrable_one_add_norm (E := Pl) (μ := (volume : Measure Pl)) (r := 3 * p) hrank
  have hfin := hint.hasFiniteIntegral
  rw [hasFiniteIntegral_iff_enorm] at hfin
  have hmaj : ∀ x : Pl, ‖f x‖ₑ ^ p
      ≤ ENNReal.ofReal (K ^ p) * ‖(1 + ‖x‖) ^ (-(3 * p))‖ₑ := by
    intro x
    have hb : (0 : ℝ) < 1 + ‖x‖ := by positivity
    have h2 : ‖f x‖ ≤ K * ((1 + ‖x‖) ^ (3 : ℕ))⁻¹ := by
      have hu := hdec x
      rw [← le_div_iff₀ (by positivity : (0 : ℝ) < (1 + ‖x‖) ^ (3 : ℕ))] at hu
      refine le_trans hu (le_of_eq ?_)
      field_simp
    have h5 : ‖f x‖ ^ p ≤ (K * ((1 + ‖x‖) ^ (3 : ℕ))⁻¹) ^ p :=
      Real.rpow_le_rpow (norm_nonneg _) h2 hppos.le
    have h6 : (K * ((1 + ‖x‖) ^ (3 : ℕ))⁻¹) ^ p = K ^ p * ((1 + ‖x‖) ^ (-(3 * p))) := by
      rw [Real.mul_rpow hK (by positivity)]
      congr 1
      rw [← Real.rpow_natCast (1 + ‖x‖) 3, ← Real.rpow_neg_one, ← Real.rpow_mul hb.le,
        ← Real.rpow_mul hb.le]
      congr 1
      push_cast
      ring
    have hen : ‖(1 + ‖x‖) ^ (-(3 * p))‖ₑ = ENNReal.ofReal ((1 + ‖x‖) ^ (-(3 * p))) := by
      rw [← ofReal_norm, Real.norm_eq_abs,
        abs_of_nonneg (Real.rpow_nonneg hb.le _)]
    rw [hen, ← ofReal_norm, ENNReal.ofReal_rpow_of_nonneg (norm_nonneg _) hppos.le,
      ← ENNReal.ofReal_mul (by positivity)]
    refine ENNReal.ofReal_le_ofReal ?_
    rw [← h6]
    exact h5
  refine ne_top_of_le_ne_top ?_ (lintegral_mono hmaj)
  rw [lintegral_const_mul' _ _ ENNReal.ofReal_ne_top]
  exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top hfin.ne

theorem fibProf_tensF_schwartz_ne_top {p : ℝ} (hp : 2 < p) (f g : SchwartzMap Pl ℂ)
    (y1 z1 : ℝ) : fibProf p (tensF (f : Pl → ℂ) (g : Pl → ℂ)) y1 z1 ≠ ⊤ := by
  have hppos : (0 : ℝ) < p := by linarith
  obtain ⟨Kf, hKf0, hKf⟩ := exists_decay_Pl f
  obtain ⟨Kg, hKg0, hKg⟩ := exists_decay_Pl g
  rw [fibProf_tensF hppos (f.continuous.measurable) (g.continuous.measurable)]
  refine ENNReal.mul_ne_top ?_ ?_
  · rw [fibP, ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact absurd hc.2 (not_lt.mpr (le_of_lt (one_div_pos.mpr hppos)))
    · exact lintegral_fibre_rpow_ne_top_of_decay hp hKf0 hKf y1 hc.1
  · rw [fibP, ne_eq, ENNReal.rpow_eq_top_iff]
    intro hcon
    rcases hcon with hc | hc
    · exact absurd hc.2 (not_lt.mpr (le_of_lt (one_div_pos.mpr hppos)))
    · exact lintegral_fibre_rpow_ne_top_of_decay hp hKg0 hKg z1 hc.1

theorem normNpp_tensF_schwartz_ne_top {gam p : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (hp : p = (3 + 2 * gam) / 2) (f g : SchwartzMap Pl ℂ) :
    normNpp p gam (tensF (f : Pl → ℂ) (g : Pl → ℂ)) ≠ ⊤ := by
  have hp2 : 2 < p := by rw [hp]; linarith
  have hp1 : (0 : ℝ) < p - 1 := by linarith
  obtain ⟨Kf, hKf0, hKf⟩ := exists_decay_Pl f
  obtain ⟨Kg, hKg0, hKg⟩ := exists_decay_Pl g
  refine ne_top_of_le_ne_top ?_ (normNpp_tensF_le hgam1 hgam2 hp (f.continuous.measurable)
    (g.continuous.measurable))
  refine ENNReal.mul_ne_top (ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_) ?_
  · refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact lintegral_enorm_rpow_Pl_ne_top_of_decay hp2 hKf0 hKf
  · refine ENNReal.rpow_ne_top_of_nonneg (by positivity) ?_
    exact lintegral_enorm_rpow_Pl_ne_top_of_decay hp2 hKg0 hKg

/-! ### The `L^{p₄}` estimate of §3 for the linear operator -/

/-- The constant of the `L^{p₄}` estimate of §3. -/
noncomputable def C3 (Cs CV Cst Na B0 B0' : ℝ) (j Mc Mk L : ℕ) (p gam : ℝ) : ℝ≥0∞ :=
  (4 * ENNReal.ofReal (2 * ((Mc : ℝ) + 2) ^ 2
        * (KP31 Cs CV Cst * (4 * B0' ^ 2) ^ 2 * Na * ((2 : ℝ) ^ (j : ℤ)) ^ 2))) ^ (1 / p)
    * (ENNReal.ofReal (700000000 * (1 + stC) * B0
        * ((2 : ℝ) ^ Mk * (10 * ((L : ℝ) + 1) + 1))) ^ 2) ^ (1 - 2 / p)
    * ENNReal.ofReal (Auto.HardyLittlewoodSobolev.hlsConst
        (2 * (2 * gam - 1) / (1 + 2 * gam))) ^ (1 - 1 / p)

theorem ennreal_two_factor_alg {p : ℝ} (hp : 2 < p) (Ac Bc : ℝ≥0∞) {N : ℝ≥0∞} (hN : N ≠ ⊤) :
    (Ac * N) ^ (1 / p) * (Bc * N) ^ (1 - 2 / p)
      = (Ac ^ (1 / p) * Bc ^ (1 - 2 / p)) * N ^ (1 - 1 / p) := by
  have hppos : (0 : ℝ) < p := by linarith
  have h1p : (0 : ℝ) < 1 / p := one_div_pos.mpr hppos
  have h2p : (0 : ℝ) < 2 / p := div_pos (by norm_num) hppos
  have h2p1 : 2 / p < 1 := by
    rw [div_lt_one hppos]
    linarith
  have h1m : (0 : ℝ) < 1 - 2 / p := by linarith
  have h1m' : (0 : ℝ) < 1 - 1 / p := by
    have : 1 / p < 1 := by
      rw [div_lt_one hppos]
      linarith
    linarith
  rw [ENNReal.mul_rpow_of_nonneg _ _ h1p.le, ENNReal.mul_rpow_of_nonneg _ _ h1m.le]
  rcases eq_or_ne N 0 with h0 | h0
  · rw [h0, ENNReal.zero_rpow_of_pos h1p, ENNReal.zero_rpow_of_pos h1m,
      ENNReal.zero_rpow_of_pos h1m']
    simp
  · have hexp : (1 : ℝ) / p + (1 - 2 / p) = 1 - 1 / p := by ring
    have hNmul : N ^ ((1 : ℝ) / p) * N ^ (1 - 2 / p) = N ^ (1 - 1 / p) := by
      rw [← ENNReal.rpow_add _ _ h0 hN, hexp]
    calc Ac ^ ((1 : ℝ) / p) * N ^ ((1 : ℝ) / p) * (Bc ^ (1 - 2 / p) * N ^ (1 - 2 / p))
        = Ac ^ ((1 : ℝ) / p) * Bc ^ (1 - 2 / p)
            * (N ^ ((1 : ℝ) / p) * N ^ (1 - 2 / p)) := by ring
      _ = Ac ^ ((1 : ℝ) / p) * Bc ^ (1 - 2 / p) * N ^ (1 - 1 / p) := by rw [hNmul]

