/-- The weighted square integral of an `ℝ≥0∞`-valued function, in base--fibre coordinates. -/
theorem lintegral_sq_weight_iter {gam : ℝ} {G : Pl2 → ℝ≥0∞} (hG : Measurable G) :
    (∫⁻ q : Pl2, (G q) ^ (2 : ℝ) * ‖(sepCLM q) 0‖ₑ ^ (-(2 * gam - 1)))
      = ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ,
          (G (pr (mk2 y1 y2) (mk2 z1 z2))) ^ (2 : ℝ)
            * ‖(y1 - z1 : ℝ)‖ₑ ^ (-(2 * gam - 1)) := by
  classical
  set Gfun : Pl2 → ℝ≥0∞ := fun x =>
    (G x) ^ (2 : ℝ) * ‖(sepCLM x) 0‖ₑ ^ (-(2 * gam - 1)) with hGfun
  have hsepmeas : Measurable fun x : Pl2 => ((sepCLM x) 0 : ℝ) :=
    sepFst.continuous.measurable
  have hGmeas : Measurable Gfun := by
    rw [hGfun]
    exact ((hG).pow_const _).mul ((hsepmeas.enorm).pow_const _)
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have h1 : (∫⁻ q : Pl2, Gfun q) = ∫⁻ y : Pl, ∫⁻ z : Pl, Gfun (pr y z) :=
    (lintegral_pr Gfun hGmeas).symm
  have h2 : ∀ y : Pl, (∫⁻ z : Pl, Gfun (pr y z))
      = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
    intro y
    refine lintegral_Pl_eq_prod _ ?_
    exact hGmeas.comp (hprmeas.comp (measurable_const.prodMk measurable_id))
  have h3 : (∫⁻ y : Pl, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)))
      = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    refine lintegral_Pl_eq_prod _ ?_
    have hjoint : Measurable fun w : Pl × (ℝ × ℝ) => Gfun (pr w.1 (mk2 w.2.1 w.2.2)) := by
      refine hGmeas.comp (hprmeas.comp ?_)
      exact measurable_fst.prodMk (continuous_mk2.measurable.comp measurable_snd)
    have hstep : Measurable fun y : Pl => ∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)) :=
      hjoint.lintegral_prod_right'
    have heq : ∀ y : Pl, (∫⁻ zz : ℝ × ℝ, Gfun (pr y (mk2 zz.1 zz.2)))
        = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr y (mk2 z1 z2)) := by
      intro y
      rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
      exact (hGmeas.comp (hprmeas.comp (measurable_const.prodMk
        (continuous_mk2.measurable)))).aemeasurable
    simpa [heq] using hstep
  have h4 : ∀ y1 : ℝ, (∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)))
      = ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    intro y1
    refine lintegral_lintegral_swap ?_
    have hjoint : Measurable fun w : ℝ × ℝ => ∫⁻ z2 : ℝ, Gfun (pr (mk2 y1 w.1) (mk2 w.2 z2)) := by
      have h5 : Measurable fun v : (ℝ × ℝ) × ℝ =>
          Gfun (pr (mk2 y1 v.1.1) (mk2 v.1.2 v.2)) := by
        refine hGmeas.comp (hprmeas.comp ?_)
        refine Measurable.prodMk ?_ ?_
        · exact continuous_mk2.measurable.comp
            (measurable_const.prodMk (measurable_fst.comp measurable_fst))
        · exact continuous_mk2.measurable.comp
            ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
      exact h5.lintegral_prod_right'
    exact hjoint.aemeasurable
  rw [h1, lintegral_congr h2, h3, lintegral_congr h4]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  refine lintegral_congr fun y2 => ?_
  refine lintegral_congr fun z2 => ?_
  have hsep : ((sepCLM (pr (mk2 y1 y2) (mk2 z1 z2))) 0 : ℝ) = y1 - z1 := sepFst_pr_mk2 y1 y2 z1 z2
  simp only [hGfun, hsep]

/-- The weighted square integral of the kernel, with the one-dimensional weight. -/
noncomputable def CKx1 (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) (gam : ℝ) (x : Pl) : ℝ≥0∞ :=
  ∫⁻ q : Pl2, (‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ) ^ (2 : ℝ)
    * ‖(sepCLM q) 0‖ₑ ^ (2 * gam - 1)

theorem CKx1_le_CKx (j : ℕ) (ε : ℝ) (m : ℝ → Pl → ℂ) (t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam)
    (x : Pl) : CKx1 j ε m t gam x ≤ CKx j ε m t gam x := by
  rw [CKx1, CKx]
  refine lintegral_mono fun q => ?_
  refine mul_le_mul' (le_refl _) ?_
  refine ENNReal.rpow_le_rpow ?_ (by linarith)
  rw [← ofReal_norm, ← ofReal_norm]
  exact ENNReal.ofReal_le_ofReal (abs_sepFst_le q)

theorem CKx1_lt_top {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    (x : Pl) : CKx1 j ε m t gam x < ⊤ :=
  lt_of_le_of_lt (CKx1_le_CKx j ε m t hgam1 x) (CKx_lt_top hm ε t hgam1 hgam2 x)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The weighted Cauchy--Schwarz bound, for an `ℝ≥0∞`-valued majorant. -/
theorem lintegral_kern_mul_le_gen {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (_hgam2 : gam ≤ 1)
    (x : Pl) {G : Pl2 → ℝ≥0∞} (hG : Measurable G) :
    (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ * G q)
      ≤ (CKx1 j ε m t gam x) ^ ((1 : ℝ) / 2)
        * (∫⁻ q : Pl2, (G q) ^ (2 : ℝ) * ‖(sepCLM q) 0‖ₑ ^ (-(2 * gam - 1))) ^ ((1 : ℝ) / 2) := by
  classical
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  set kk : Pl2 → ℝ≥0∞ := fun q =>
    ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ with hkk
  set w : Pl2 → ℝ≥0∞ := fun q => ‖(sepCLM q) 0‖ₑ ^ (2 * gam - 1) with hwdef
  have hkkmeas : Measurable kk := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact h1.mul h2
  have hwmeas : Measurable w := ((sepFst.continuous.enorm.measurable)).pow_const _
  have hae : (fun q : Pl2 => kk q * G q)
      =ᵐ[volume] fun q : Pl2 => (kk q * w q ^ ((1 : ℝ) / 2))
        * (G q * (w q ^ ((1 : ℝ) / 2))⁻¹) := by
    have hnull : (volume : Measure Pl2) {q : Pl2 | sepFst q = 0} = 0 := volume_sepFst_eq_zero
    rw [Filter.eventuallyEq_iff_exists_mem]
    refine ⟨{q : Pl2 | sepFst q = 0}ᶜ, ?_, ?_⟩
    · rw [mem_ae_iff, compl_compl]
      exact hnull
    · intro q hq
      have hqne : sepFst q ≠ 0 := hq
      have hpos : (0 : ℝ≥0∞) < ‖sepFst q‖ₑ := by
        rw [enorm_pos]
        exact hqne
      have hwpos : (0 : ℝ≥0∞) < w q ^ ((1 : ℝ) / 2) := by
        rw [hwdef]
        refine ENNReal.rpow_pos ?_ ?_
        · exact ENNReal.rpow_pos hpos enorm_ne_top
        · exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      have hwtop : w q ^ ((1 : ℝ) / 2) ≠ ⊤ := by
        rw [hwdef]
        refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
        exact ENNReal.rpow_ne_top_of_nonneg (by linarith) enorm_ne_top
      change kk q * G q = (kk q * w q ^ ((1 : ℝ) / 2)) * (G q * (w q ^ ((1 : ℝ) / 2))⁻¹)
      rw [mul_comm (G q) ((w q ^ ((1 : ℝ) / 2))⁻¹), ← mul_assoc, mul_assoc (kk q),
        ENNReal.mul_inv_cancel hwpos.ne' hwtop, mul_one]
  rw [lintegral_congr_ae hae]
  have hf : AEMeasurable (fun q : Pl2 => kk q * w q ^ ((1 : ℝ) / 2)) (volume : Measure Pl2) :=
    (hkkmeas.mul (hwmeas.pow_const _)).aemeasurable
  have hg : AEMeasurable (fun q : Pl2 => G q * (w q ^ ((1 : ℝ) / 2))⁻¹)
      (volume : Measure Pl2) := (hG.mul ((hwmeas.pow_const _).inv)).aemeasurable
  have hhol := ENNReal.lintegral_mul_le_Lp_mul_Lq (volume : Measure Pl2)
    Real.HolderConjugate.two_two hf hg
  refine le_trans hhol ?_
  refine mul_le_mul' ?_ ?_
  · refine le_of_eq ?_
    congr 1
    rw [CKx1]
    refine lintegral_congr fun q => ?_
    have h1 : (kk q * w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ)
        = kk q ^ (2 : ℝ) * (w q ^ ((1 : ℝ) / 2)) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1, ← ENNReal.rpow_mul, show (1 : ℝ) / 2 * 2 = 1 by norm_num, ENNReal.rpow_one, hkk,
      hwdef]
  · refine le_of_eq ?_
    congr 1
    refine lintegral_congr fun q => ?_
    have h1 : (G q * (w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ)
        = (G q) ^ (2 : ℝ) * ((w q ^ ((1 : ℝ) / 2))⁻¹) ^ (2 : ℝ) :=
      ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)
    rw [h1]
    congr 1
    rw [← ENNReal.rpow_neg_one (w q ^ ((1 : ℝ) / 2)), ← ENNReal.rpow_mul, ← ENNReal.rpow_mul,
      hwdef, ← ENNReal.rpow_mul]
    congr 1
    ring

/-! ### Iterated integration in base--fibre order, and the two majorant bounds -/

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- Iterated integration on `ℝ⁴` in base--fibre order. -/
theorem lintegral_Pl2_iter_base {G : Pl2 → ℝ≥0∞} (hG : Measurable G) :
    (∫⁻ q : Pl2, G q)
      = ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, G (pr (mk2 y1 y2) (mk2 z1 z2)) := by
  classical
  have hprmeas : Measurable fun w : Pl × Pl => (WithLp.toLp 2 w : Pl2) :=
    (MeasurableEquiv.toLp 2 (Pl × Pl)).measurable
  have h1 : (∫⁻ q : Pl2, G q) = ∫⁻ y : Pl, ∫⁻ z : Pl, G (pr y z) :=
    (lintegral_pr G hG).symm
  have h2 : ∀ y : Pl, (∫⁻ z : Pl, G (pr y z))
      = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, G (pr y (mk2 z1 z2)) := by
    intro y
    refine lintegral_Pl_eq_prod _ ?_
    exact hG.comp (hprmeas.comp (measurable_const.prodMk measurable_id))
  have h3 : (∫⁻ y : Pl, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, G (pr y (mk2 z1 z2)))
      = ∫⁻ y1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, G (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    refine lintegral_Pl_eq_prod _ ?_
    have hjoint : Measurable fun w : Pl × (ℝ × ℝ) => G (pr w.1 (mk2 w.2.1 w.2.2)) := by
      refine hG.comp (hprmeas.comp ?_)
      exact measurable_fst.prodMk (continuous_mk2.measurable.comp measurable_snd)
    have hstep : Measurable fun y : Pl => ∫⁻ zz : ℝ × ℝ, G (pr y (mk2 zz.1 zz.2)) :=
      hjoint.lintegral_prod_right'
    have heq : ∀ y : Pl, (∫⁻ zz : ℝ × ℝ, G (pr y (mk2 zz.1 zz.2)))
        = ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, G (pr y (mk2 z1 z2)) := by
      intro y
      rw [Measure.volume_eq_prod, lintegral_prod _ ?_]
      exact (hG.comp (hprmeas.comp (measurable_const.prodMk
        (continuous_mk2.measurable)))).aemeasurable
    simpa [heq] using hstep
  have h4 : ∀ y1 : ℝ, (∫⁻ y2 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ z2 : ℝ, G (pr (mk2 y1 y2) (mk2 z1 z2)))
      = ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, G (pr (mk2 y1 y2) (mk2 z1 z2)) := by
    intro y1
    refine lintegral_lintegral_swap ?_
    have hjoint : Measurable fun w : ℝ × ℝ => ∫⁻ z2 : ℝ, G (pr (mk2 y1 w.1) (mk2 w.2 z2)) := by
      have h5 : Measurable fun v : (ℝ × ℝ) × ℝ => G (pr (mk2 y1 v.1.1) (mk2 v.1.2 v.2)) := by
        refine hG.comp (hprmeas.comp ?_)
        refine Measurable.prodMk ?_ ?_
        · exact continuous_mk2.measurable.comp
            (measurable_const.prodMk (measurable_fst.comp measurable_fst))
        · exact continuous_mk2.measurable.comp
            ((measurable_snd.comp measurable_fst).prodMk measurable_snd)
      exact h5.lintegral_prod_right'
    exact hjoint.aemeasurable
  rw [h1, lintegral_congr h2, h3, lintegral_congr h4]

/-- The single-kernel estimate in the translated form used by the majorant bounds. -/
theorem lintegral_kern_translate_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ}
    {B0 : ℝ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    (x : Pl) (c : ℝ) :
    (∫⁻ v : ℝ, ‖kern j ε m t (x - mk2 c v)‖ₑ)
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) := by
  have hpt : ∀ v : ℝ, ‖kern j ε m t (x - mk2 c v)‖ₑ
      = (fun u : ℝ => ‖kern j ε m t (mk2 (x 0 - c) u)‖ₑ) (x 1 - v) := by
    intro v
    rw [sub_mk2]
  rw [lintegral_congr hpt,
    lintegral_sub_left_eq_self' (fun u : ℝ => ‖kern j ε m t (mk2 (x 0 - c) u)‖ₑ) (x 1)]
  exact lintegral_norm_kern_le hpol hm hε ht1 ht2 hM hQ hMj hMj2 hBL (x 0 - c)

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The first majorant bound.**  The first Calderón factor is integrable against the kernel. -/
theorem lintegral_kern_gZero_le {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) {gam : ℝ} (hgam1 : 1 / 2 < gam) (hgam2 : gam ≤ 1)
    {p : ℝ} (hpgt : 2 < p) (x : Pl)
    {F : Pl2 → ℂ} (hF : Measurable F) (hfib : ∀ y1 z1 : ℝ, fibProf p F y1 z1 ≠ ⊤) :
    (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q))
      ≤ (CKx1 j ε m t gam x) ^ ((1 : ℝ) / 2) * (normNpp p gam F) ^ ((1 : ℝ) / 2) := by
  have hGmeas : Measurable fun q : Pl2 => gZero p gam F (bs1 q) (bs2 q) (fb1 q) (fb2 q) :=
    measurable_gZero_q hF
  refine le_trans (lintegral_kern_mul_le_gen hm ε t hgam1 hgam2 x hGmeas) ?_
  refine mul_le_mul' (le_refl _) ?_
  refine ENNReal.rpow_le_rpow (le_of_eq ?_) (by norm_num)
  rw [lintegral_sq_weight_iter hGmeas, ← lintegral_gZero_sq_weight hpgt hgam1 hF hfib]
  refine lintegral_congr fun y1 => ?_
  refine lintegral_congr fun z1 => ?_
  refine lintegral_congr fun y2 => ?_
  refine lintegral_congr fun z2 => ?_
  simp

set_option maxHeartbeats 1000000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- **The second majorant bound.**  The second Calderón factor is integrable against the kernel,
because it does not depend on the fibre variables and the fibre integral of the kernel is the
single-kernel estimate (K). -/
theorem lintegral_kern_gOne_le {j : ℕ} {m : ℝ → Pl → ℂ} {mr ma : ℕ → ℝ → ℝ → ℝ → ℂ} {B0 : ℝ}
    {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0' : ℝ}
    (hpol : PolarData j m mr ma B0) (hm : MultData j m m2 B0')
    {ε t : ℝ} (hε : |ε| = 1) (ht1 : 1 ≤ t) (ht2 : t ≤ 2) {M : ℕ} (hM : 1 ≤ M)
    (hQ : (2 : ℝ) ^ (-(M : ℤ)) ≤ 1 / 100) (hMj : 2 * (M : ℤ) ≤ (j : ℤ) + 14)
    (hMj2 : (j : ℤ) ≤ 2 * (M : ℤ)) {L : ℕ} (hBL : ⌈π * (2 : ℝ) ^ M⌉ ≤ 2 ^ L)
    {gam p : ℝ} (hpgt : 2 < p) (x : Pl) {F : Pl2 → ℂ} (hF : Measurable F) :
    (∫⁻ q : Pl2, ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * gOne p gam F (bs1 q) (bs2 q))
      ≤ ENNReal.ofReal (700000000 * (1 + stC) * B0
          * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) ^ 2 * normNpp p gam F := by
  set Cb : ℝ≥0∞ := ENNReal.ofReal (700000000 * (1 + stC) * B0
    * ((2 : ℝ) ^ M * (10 * ((L : ℝ) + 1) + 1))) with hCb
  have hkc : Continuous (kern j ε m t) := continuous_kern hm ε t
  have hGmeas : Measurable fun q : Pl2 =>
      ‖kern j ε m t (x - prjL q)‖ₑ * ‖kern j ε m t (x - prjR q)‖ₑ
        * gOne p gam F (bs1 q) (bs2 q) := by
    have h1 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjL q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjL.continuous)).enorm.measurable
    have h2 : Measurable fun q : Pl2 => ‖kern j ε m t (x - prjR q)‖ₑ :=
      (hkc.comp (continuous_const.sub prjR.continuous)).enorm.measurable
    exact (h1.mul h2).mul (measurable_gOne_q hF)
  have hkmk2 : ∀ c : ℝ, Measurable fun v : ℝ => ‖kern j ε m t (x - mk2 c v)‖ₑ := by
    intro c
    exact (hkc.comp (continuous_const.sub
      (continuous_mk2.comp (continuous_const.prodMk continuous_id)))).enorm.measurable
  rw [lintegral_Pl2_iter_base hGmeas]
  simp only [prjL_pr, prjR_pr, bs1_pr_mk2, bs2_pr_mk2]
  have hstep : ∀ y1 z1 : ℝ,
      (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ
            * ‖kern j ε m t (x - mk2 z1 z2)‖ₑ * gOne p gam F y1 z1)
        ≤ gOne p gam F y1 z1 * (Cb * Cb) := by
    intro y1 z1
    have hIA : (∫⁻ y2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ) ≤ Cb :=
      lintegral_kern_translate_le hpol hm hε ht1 ht2 hM hQ hMj hMj2 hBL x y1
    have hIB : (∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 z1 z2)‖ₑ) ≤ Cb :=
      lintegral_kern_translate_le hpol hm hε ht1 ht2 hM hQ hMj hMj2 hBL x z1
    have hz2 : ∀ y2 : ℝ, (∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ
          * ‖kern j ε m t (x - mk2 z1 z2)‖ₑ * gOne p gam F y1 z1)
        = (‖kern j ε m t (x - mk2 y1 y2)‖ₑ * gOne p gam F y1 z1)
          * ∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 z1 z2)‖ₑ := by
      intro y2
      rw [← lintegral_const_mul _ (hkmk2 z1)]
      refine lintegral_congr fun z2 => ?_
      ring
    have hy2 : (∫⁻ y2 : ℝ, (‖kern j ε m t (x - mk2 y1 y2)‖ₑ * gOne p gam F y1 z1) * Cb)
        = (∫⁻ y2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ) * (gOne p gam F y1 z1 * Cb) := by
      rw [← lintegral_mul_const _ (hkmk2 y1)]
      refine lintegral_congr fun y2 => ?_
      ring
    calc (∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ
            * ‖kern j ε m t (x - mk2 z1 z2)‖ₑ * gOne p gam F y1 z1)
        = ∫⁻ y2 : ℝ, (‖kern j ε m t (x - mk2 y1 y2)‖ₑ * gOne p gam F y1 z1)
            * ∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 z1 z2)‖ₑ := lintegral_congr hz2
      _ ≤ ∫⁻ y2 : ℝ, (‖kern j ε m t (x - mk2 y1 y2)‖ₑ * gOne p gam F y1 z1) * Cb :=
          lintegral_mono fun y2 => mul_le_mul' (le_refl _) hIB
      _ = (∫⁻ y2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ) * (gOne p gam F y1 z1 * Cb) := hy2
      _ ≤ Cb * (gOne p gam F y1 z1 * Cb) := mul_le_mul' hIA (le_refl _)
      _ = gOne p gam F y1 z1 * (Cb * Cb) := by ring
  have hfinal : (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, gOne p gam F y1 z1 * (Cb * Cb))
      = (Cb * Cb) * normNpp p gam F := by
    have hCbtop : Cb * Cb ≠ ⊤ := by
      rw [hCb]
      exact ENNReal.mul_ne_top ENNReal.ofReal_ne_top ENNReal.ofReal_ne_top
    have h1 : ∀ y1 : ℝ, (∫⁻ z1 : ℝ, gOne p gam F y1 z1 * (Cb * Cb))
        = (Cb * Cb) * ∫⁻ z1 : ℝ, gOne p gam F y1 z1 := by
      intro y1
      rw [← lintegral_const_mul' _ _ hCbtop]
      refine lintegral_congr fun z1 => ?_
      ring
    rw [lintegral_congr h1, lintegral_const_mul' _ _ hCbtop, lintegral_gOne p gam hpgt F]
  calc (∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, ∫⁻ y2 : ℝ, ∫⁻ z2 : ℝ, ‖kern j ε m t (x - mk2 y1 y2)‖ₑ
          * ‖kern j ε m t (x - mk2 z1 z2)‖ₑ * gOne p gam F y1 z1)
      ≤ ∫⁻ y1 : ℝ, ∫⁻ z1 : ℝ, gOne p gam F y1 z1 * (Cb * Cb) :=
        lintegral_mono fun y1 => lintegral_mono fun z1 => hstep y1 z1
    _ = (Cb * Cb) * normNpp p gam F := hfinal
    _ = Cb ^ 2 * normNpp p gam F := by
        rw [pow_two]

/-! ### The interior majorant of the family, and the uniform bound on its image -/

theorem rpow_interp_le_add {a b s : ℝ} (ha : 0 < a) (hb : 0 < b) (hs0 : 0 ≤ s) (hs1 : s ≤ 1) :
    a ^ (1 - s) * b ^ s ≤ a + b := by
  rcases le_total a b with hab | hab
  · have h1 : a ^ (1 - s) ≤ b ^ (1 - s) := Real.rpow_le_rpow ha.le hab (by linarith)
    calc a ^ (1 - s) * b ^ s ≤ b ^ (1 - s) * b ^ s :=
          mul_le_mul_of_nonneg_right h1 (by positivity)
      _ = b := by
          rw [← Real.rpow_add hb]
          norm_num
      _ ≤ a + b := by linarith
  · have h1 : b ^ s ≤ a ^ s := Real.rpow_le_rpow hb.le hab hs0
    calc a ^ (1 - s) * b ^ s ≤ a ^ (1 - s) * a ^ s :=
          mul_le_mul_of_nonneg_left h1 (by positivity)
      _ = a := by
          rw [← Real.rpow_add ha]
          norm_num
      _ ≤ a + b := by linarith

