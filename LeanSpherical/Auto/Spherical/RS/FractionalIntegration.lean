/-! ### The convolution representation of `T_t` -/

/-- The kernel of the single-scale operator, as a Schwartz function. -/
noncomputable def kernS {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : SchwartzMap Pl ℂ :=
  𝓕⁻ (mfullS hm ε t)

theorem kernS_apply {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (u : Pl) :
    (kernS hm ε t : Pl → ℂ) u = kern j ε m t u := by
  rw [kernS, SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg, fourier_eq_ee_Pl, kern]
  refine integral_congr_ae (Filter.Eventually.of_forall fun v => ?_)
  have hinner : (inner ℝ v (-u) : ℝ) = -(inner ℝ u v : ℝ) := by
    rw [inner_neg_right, real_inner_comm]
  simp only [mfullS_apply, hinner]

/-- **The convolution representation.**  `T_t f = k_{j,t} ∗ f`. -/
theorem TopS_eq_convolution {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) (f : SchwartzMap Pl ℂ) (x : Pl) :
    (TopS hm ε t f : Pl → ℂ) x = ∫ y : Pl, kern j ε m t y * (f : Pl → ℂ) (x - y) := by
  have h3 : 𝓕 (kernS hm ε t) = mfullS hm ε t := by
    rw [kernS, FourierTransform.fourier_fourierInv_eq]
  have h1 : 𝓕 (TopS hm ε t f) = SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) := by
    rw [TopS, FourierTransform.fourier_fourierInv_eq]
  have h2 : 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f)
      = SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (𝓕 (kernS hm ε t)) (𝓕 f) :=
    SchwartzMap.fourier_convolution _ _ _
  have h4 : SchwartzMap.pairing (ContinuousLinearMap.mul ℂ ℂ) (mfullS hm ε t) (𝓕 f)
      = SchwartzMap.smulLeftCLM ℂ (mfull j ε m t) (𝓕 f) := by
    refine SchwartzMap.ext fun ω => ?_
    rw [SchwartzMap.pairing_apply_apply,
      SchwartzMap.smulLeftCLM_apply_apply (hasTemperateGrowth_mfull hm ε t), mfullS_apply,
      smul_eq_mul]
    rfl
  have hEq : TopS hm ε t f
      = SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f := by
    have hF : 𝓕 (TopS hm ε t f)
        = 𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f) := by
      rw [h1, h2, h3, h4]
    calc TopS hm ε t f = 𝓕⁻ (𝓕 (TopS hm ε t f)) :=
          (FourierTransform.fourierInv_fourier_eq _).symm
      _ = 𝓕⁻ (𝓕 (SchwartzMap.convolution (ContinuousLinearMap.mul ℂ ℂ) (kernS hm ε t) f)) := by
          rw [hF]
      _ = _ := FourierTransform.fourierInv_fourier_eq _
  rw [hEq, SchwartzMap.convolution_apply]
  change (∫ y : Pl, (ContinuousLinearMap.mul ℂ ℂ) ((kernS hm ε t : Pl → ℂ) y)
      ((f : Pl → ℂ) (x - y))) = _
  refine integral_congr_ae (Filter.Eventually.of_forall fun y => ?_)
  simp only [ContinuousLinearMap.mul_apply', kernS_apply]

/-! ### The mixed norm and the `L¹L^∞ → L^∞` endpoint -/

theorem mk2_sub_mk2 (a b c d : ℝ) : mk2 a b - mk2 c d = mk2 (a - c) (b - d) := by
  rw [mk2_eq_add, mk2_eq_add, mk2_eq_add, sub_smul, sub_smul]
  abel

theorem sub_mk2 (x : Pl) (w v : ℝ) : x - mk2 w v = mk2 (x 0 - w) (x 1 - v) := by
  conv_lhs => rw [← mk2_coords x]
  rw [mk2_sub_mk2]

theorem continuous_kern {j : ℕ} {m : ℝ → Pl → ℂ} {m2 : ℝ → Pl → Pl → Pl → ℂ} {B0 : ℝ}
    (hm : MultData j m m2 B0) (ε t : ℝ) : Continuous (kern j ε m t) := by
  have h : kern j ε m t = ((kernS hm ε t : SchwartzMap Pl ℂ) : Pl → ℂ) := by
    funext u
    rw [kernS_apply]
  rw [h]
  exact (kernS hm ε t).continuous

/-- Iterated integration on the plane, for `ℝ≥0∞`-valued functions. -/
theorem lintegral_Pl_eq_prod (F : Pl → ℝ≥0∞) (hF : Measurable F) :
    (∫⁻ y : Pl, F y) = ∫⁻ w : ℝ, ∫⁻ v : ℝ, F (mk2 w v) := by
  have hmeas : Measurable fun p : ℝ × ℝ => F (mk2 p.1 p.2) :=
    hF.comp continuous_mk2.measurable
  have h1 : (∫⁻ p : ℝ × ℝ, F (mk2 p.1 p.2)) = ∫⁻ y : Pl, F (mk2 (y 0) (y 1)) :=
    measurePreserving_coords.lintegral_map_equiv (fun p : ℝ × ℝ => F (mk2 p.1 p.2)) coords
  have h2 : (∫⁻ y : Pl, F (mk2 (y 0) (y 1))) = ∫⁻ y : Pl, F y := by
    refine lintegral_congr fun y => ?_
    rw [mk2_coords]
  have h3 : (∫⁻ p : ℝ × ℝ, F (mk2 p.1 p.2)) = ∫⁻ w : ℝ, ∫⁻ v : ℝ, F (mk2 w v) := by
    rw [Measure.volume_eq_prod, lintegral_prod _ hmeas.aemeasurable]
  rw [← h2, ← h1, h3]

/-- The mixed norm `‖f‖_{L¹_{y₁}L^∞_{y₂}}` of §3. -/
noncomputable def mixL1Linf (f : Pl → ℂ) : ℝ≥0∞ :=
  ∫⁻ y : ℝ, ⨆ v : ℝ, ‖f (mk2 y v)‖ₑ

