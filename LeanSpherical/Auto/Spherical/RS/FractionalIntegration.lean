      Filter.atTop (nhds 0) := by
    have h1 : Filter.Tendsto (fun n : ℕ => 1 / ((n : ℝ) + 1)) Filter.atTop (nhds 0) :=
      tendsto_one_div_add_atTop_nhds_zero_nat
    have h2 : Filter.Tendsto (fun n : ℕ => ENNReal.ofReal (1 / ((n : ℝ) + 1)))
        Filter.atTop (nhds (ENNReal.ofReal 0)) :=
      (ENNReal.continuous_ofReal.tendsto (0 : ℝ)).comp h1
    rwa [ENNReal.ofReal_zero] at h2
  have hL1en : Filter.Tendsto (fun n => ∫⁻ q : Pl2, ‖gt n q - G q‖ₑ) Filter.atTop (nhds 0) := by
    have hvol : (volume (Metric.closedBall (0 : Pl2) (2 * R))) ^ ((1 : ℝ) / 2) ≠ ⊤ := by
      refine ENNReal.rpow_ne_top_of_nonneg (by norm_num) ?_
      exact (measure_closedBall_lt_top).ne
    have hbd : ∀ n, (∫⁻ q : Pl2, ‖gt n q - G q‖ₑ)
