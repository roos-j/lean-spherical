  rw [lintegral_indicator hcL.measurableSet, setLIntegral_const]
  have hvol : (volume : Measure ℝ) {y : ℝ | |y| ≤ L} ≤ ENNReal.ofReal (2 * L) := by
    have hsub : {y : ℝ | |y| ≤ L} ⊆ Icc (-L) L := by
      intro y hy
      simp only [Set.mem_setOf_eq, abs_le] at hy
      exact ⟨hy.1, hy.2⟩
    refine le_trans (measure_mono hsub) ?_
    rw [Real.volume_Icc]
