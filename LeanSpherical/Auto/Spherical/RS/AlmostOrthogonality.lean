/-! ## The plane and the plane squared -/

/-- The plane `ℝ²`. -/
abbrev Pl := Euclidean 2

/-- The product `ℝ² × ℝ²`, carrying the Euclidean structure of `ℝ⁴`. -/
abbrev Pl2 := WithLp 2 (Pl × Pl)

/-- Pair two planar vectors into a vector of `ℝ⁴`. -/
def pr (y z : Pl) : Pl2 := WithLp.toLp 2 (y, z)

@[simp] theorem pr_ofLp (y z : Pl) : WithLp.ofLp (pr y z) = (y, z) := rfl

theorem inner_pr (y z y' z' : Pl) :
    inner ℝ (pr y z) (pr y' z') = inner ℝ y y' + inner ℝ z z' := rfl

/-! ## Planar coordinates -/

theorem inner_two (x y : Pl) : inner ℝ x y = x 0 * y 0 + x 1 * y 1 := by
  rw [PiLp.inner_apply, Fin.sum_univ_two]
  simp [RCLike.inner_apply, mul_comm]

theorem norm_sq_two (x : Pl) : ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
  rw [EuclideanSpace.real_norm_sq_eq, Fin.sum_univ_two]

/-- The determinant of two planar vectors. -/
def det2 (x y : Pl) : ℝ := x 0 * y 1 - x 1 * y 0

/-- Lagrange's identity in the plane. -/
theorem lagrange (x y : Pl) :
    det2 x y ^ 2 = ‖x‖ ^ 2 * ‖y‖ ^ 2 - inner ℝ x y ^ 2 := by
  rw [det2, norm_sq_two, norm_sq_two, inner_two]
  ring

/-- The determinant is bounded by the product of the norms and the unoriented angle. -/
theorem abs_det2_le (x y : Pl) :
    |det2 x y| ≤ ‖x‖ * ‖y‖ * InnerProductGeometry.angle x y := by
  set θ := InnerProductGeometry.angle x y with hθ
  have hθ0 : 0 ≤ θ := InnerProductGeometry.angle_nonneg x y
  have hcos : Real.cos θ * (‖x‖ * ‖y‖) = inner ℝ x y :=
    InnerProductGeometry.cos_angle_mul_norm_mul_norm x y
  have hsin : det2 x y ^ 2 = (‖x‖ * ‖y‖) ^ 2 * Real.sin θ ^ 2 := by
    rw [lagrange, ← hcos]
    have := Real.sin_sq_add_cos_sq θ
    nlinarith [this]
  have hsinle : Real.sin θ ≤ θ := by
    rcases eq_or_lt_of_le hθ0 with h | h
    · rw [← h]
      simp
    · exact (Real.sin_lt h).le
  have hsinnn : 0 ≤ Real.sin θ := Real.sin_nonneg_of_nonneg_of_le_pi hθ0
    (InnerProductGeometry.angle_le_pi x y)
  have hnn : (0 : ℝ) ≤ ‖x‖ * ‖y‖ := by positivity
  have hsq : |det2 x y| ^ 2 ≤ (‖x‖ * ‖y‖ * θ) ^ 2 := by
    rw [sq_abs, hsin]
    have : Real.sin θ ^ 2 ≤ θ ^ 2 := by nlinarith
    nlinarith [sq_nonneg (‖x‖ * ‖y‖)]
  have hrhs : 0 ≤ ‖x‖ * ‖y‖ * θ := by positivity
  nlinarith [abs_nonneg (det2 x y), hsq, hrhs]

/-! ## Volume of a planar slab -/

/-- The measurable identification of the plane with `ℝ × ℝ` given by its coordinates. -/
def coords : Pl ≃ᵐ ℝ × ℝ :=
  (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow

@[simp] theorem coords_apply (x : Pl) : coords x = (x 0, x 1) := rfl

theorem measurePreserving_coords :
    MeasurePreserving coords (volume : Measure Pl) (volume : Measure (ℝ × ℝ)) :=
  (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
    (volume_preserving_finTwoArrow ℝ)

theorem volume_planar_eq (s : Set (ℝ × ℝ)) :
    volume {x : Pl | (x 0, x 1) ∈ s} = (volume : Measure (ℝ × ℝ)) s := by
  have h : {x : Pl | (x 0, x 1) ∈ s} = coords ⁻¹' s := rfl
  rw [h]
  exact measurePreserving_coords.measure_preimage_emb coords.measurableEmbedding s

/-- The measure of the planar slab `|x₀ - s x₁| ≤ K`, `|x₁| ≤ L`. -/
theorem volume_slab_le (s K L : ℝ) (hK : 0 ≤ K) (_hL : 0 ≤ L) :
    volume {x : Pl | |x 0 - s * x 1| ≤ K ∧ |x 1| ≤ L} ≤ ENNReal.ofReal (4 * K * L) := by
  classical
  set T : Set (ℝ × ℝ) := {p : ℝ × ℝ | |p.1 - s * p.2| ≤ K ∧ |p.2| ≤ L} with hT
  have hcL : IsClosed {y : ℝ | |y| ≤ L} := isClosed_le continuous_abs continuous_const
  have hmeasT : MeasurableSet T := by
    have h1 : IsClosed {p : ℝ × ℝ | |p.1 - s * p.2| ≤ K} :=
      isClosed_le ((continuous_fst.sub (continuous_const.mul continuous_snd)).abs)
        continuous_const
    have h2 : IsClosed {p : ℝ × ℝ | |p.2| ≤ L} :=
      isClosed_le continuous_snd.abs continuous_const
    exact (h1.inter h2).measurableSet
  have hset : {x : Pl | |x 0 - s * x 1| ≤ K ∧ |x 1| ≤ L} = {x : Pl | (x 0, x 1) ∈ T} := rfl
  rw [hset, volume_planar_eq, Measure.volume_eq_prod, Measure.prod_apply_symm hmeasT]
  have hslice : ∀ y : ℝ, (volume : Measure ℝ) ((fun x : ℝ => (x, y)) ⁻¹' T)
      ≤ Set.indicator {y : ℝ | |y| ≤ L} (fun _ => ENNReal.ofReal (2 * K)) y := by
    intro y
    by_cases hy : |y| ≤ L
    · rw [Set.indicator_of_mem (show y ∈ {y : ℝ | |y| ≤ L} from hy)]
      have hsub : (fun x : ℝ => (x, y)) ⁻¹' T ⊆ Icc (s * y - K) (s * y + K) := by
        intro x hx
        have hx1 : |x - s * y| ≤ K := hx.1
        rw [abs_le] at hx1
        exact ⟨by linarith [hx1.1], by linarith [hx1.2]⟩
      refine le_trans (measure_mono hsub) ?_
      rw [Real.volume_Icc]
      apply le_of_eq
      congr 1
      ring
    · have : (fun x : ℝ => (x, y)) ⁻¹' T = ∅ := by
        ext x
        simp only [Set.mem_preimage, Set.mem_empty_iff_false, iff_false, hT, Set.mem_setOf_eq]
