      have hclB : 0 < 2 - beta - w * (3 - beta) := by
        have hlin : alpha / 2 + (2 - beta - alpha / 2) * b - (1 + alpha / 2) * a
            = (1 - t) * (2 - beta - w * (3 - beta))
              + t * (alpha / 2 + (2 - beta - alpha / 2) * Y4
