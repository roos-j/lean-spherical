  filter_upwards [ae_restrict_mem measurableSet_Ioi] with t ht
  have htm : 0 < t ^ m := Real.rpow_pos_of_pos ht m
  have hset : MeasurableSet {x : (Euclidean d) | (1 / 4 : ℝ) * t ^ m ≤ u x} :=
