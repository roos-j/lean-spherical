        (B ^ 2 + 2 * B * C) * E := by
    calc
      (∫ x, ‖F 1 x‖ ^ 2) +
          2 * (∫ s in (1 : ℝ)..2, ∫ x, ‖F s x‖ * ‖D s x‖) ≤
          B ^ 2 * E + 2 * (B * C * E) := by
        exact add_le_add (hFbound 1 ⟨by norm_num, by norm_num⟩)
          (mul_le_mul_of_nonneg_left hprod_interval (by norm_num))
      _ = (B ^ 2 + 2 * B * C) * E := by ring
  have hK : 0 ≤ (B ^ 2 + 2 * B * C) * E := by
    exact mul_nonneg (add_nonneg (sq_nonneg _) (mul_nonneg (mul_nonneg (by norm_num) hB) hC)) hE
  let Q : Euclidean (d + 1) → ENNReal := fun x =>
    ⨆ r : Icc (1 : ℝ) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 2)
  have hQ : (∫⁻ x, Q x) ≤ ENNReal.ofReal ((B ^ 2 + 2 * B * C) * E) := by
    simpa only [Q] using hmax.2.trans (ENNReal.ofReal_le_ofReal hinside)
  have hsquare := memLp_two_toReal_sqrt_of_measurable_lintegral
    Q (by simpa only [Q] using hmax.1) hK hQ
  have hordinary := memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
    (d := d + 1) (F := F) (a := (1 : ℝ)) (b := 2) (by norm_num) hFcont hsquare.1 hsquare.2
  simpa only [F, B, S, T, C, E] using hordinary


theorem compact_schwartz_cutoff {n : Nat} (phi g : SchwartzMap (Euclidean n) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hg : HasCompactSupport (g : Euclidean n → ℂ)) :
    ∃ chi : SchwartzMap (Euclidean n) ℂ,
      HasCompactSupport (chi : Euclidean n → ℂ) ∧
      (∀ xi, ‖chi xi‖ ≤ 2) ∧ ∀ xi, chi xi * g xi = g xi := by
  have hphi_compact : HasCompactSupport (phi : Euclidean n → ℂ) := by
    apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean n) 2)
    intro xi hxi
    apply hphi_zero xi
    have hlt : 2 < ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxi
      exact lt_of_not_ge hxi
    exact hlt.le
  obtain ⟨R, hR⟩ :=
    (Metric.isBounded_iff_subset_closedBall (0 : Euclidean n)).1 hg.isBounded
  let S : ℝ := |R| + 1
  have hS : 0 < S := by
    dsimp only [S]
    positivity
  let A : Euclidean n ≃L[ℝ] Euclidean n :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 S⁻¹ (inv_ne_zero hS.ne'))
  let chi : SchwartzMap (Euclidean n) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A phi
  have hchi (xi : Euclidean n) : chi xi = phi (S⁻¹ • xi) := by
    change phi (A xi) = _
    simp [A]
  have hchi_compact : HasCompactSupport (chi : Euclidean n → ℂ) := by
    change HasCompactSupport ((phi : Euclidean n → ℂ) ∘
      (A.toHomeomorph : Euclidean n → Euclidean n))
    exact hphi_compact.comp_homeomorph A.toHomeomorph
  refine ⟨chi, hchi_compact, ?_, ?_⟩
  · intro xi
    calc
      ‖chi xi‖ = ‖phi (S⁻¹ • xi)‖ := by rw [hchi]
      _ ≤ 1 := hphi_norm _
      _ ≤ 2 := by norm_num
  · intro xi
    by_cases hzero : g xi = 0
    · rw [hzero, mul_zero]
    · have hmem : xi ∈ tsupport (g : Euclidean n → ℂ) :=
        subset_tsupport _ (Function.mem_support.mpr hzero)
      have hnormR : ‖xi‖ ≤ R := by
        have := hR hmem
        simpa only [Metric.mem_closedBall, dist_zero_right] using this
      have hnormS : ‖xi‖ ≤ S := by
        dsimp only [S]
        calc
          ‖xi‖ ≤ R := hnormR
          _ ≤ |R| := le_abs_self R
          _ ≤ |R| + 1 := by linarith
      have hscaled : ‖S⁻¹ • xi‖ ≤ 1 := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hS)]
        exact (inv_mul_le_one₀ hS).2 hnormS
      rw [hchi, hphi_one _ hscaled, one_mul]

theorem memLp_two_iSup_relative_dyadic_moving_bandpass_compact_data
    {d : Nat} (hd : 1 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hg : HasCompactSupport (g : Euclidean (d + 1) → ℂ)) (j : Nat) :
    let F : ℝ → Euclidean (d + 1) → ℂ := fun s x =>
      𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * g xi) x
    MemLp (fun x : Euclidean (d + 1) =>
      (⨆ r : Icc (1 : ℝ) 2, ENNReal.ofReal ‖F r.1 x‖).toReal) 2 volume ∧
      (∫ x : Euclidean (d + 1),
        ‖(⨆ r : Icc (1 : ℝ) 2, ENNReal.ofReal ‖F r.1 x‖).toReal‖ ^ 2) ≤
        (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ xi : Euclidean (d + 1), ‖g xi‖ ^ 2) := by
  obtain ⟨chi, hchi_compact, hchi_norm, hchi_mul⟩ :=
    compact_schwartz_cutoff phi g hphi_one hphi_zero hphi_norm hg
  have hlocal := memLp_two_iSup_relative_dyadic_moving_bandpass_of_sharp
    hd C0 C1 hC0 hC1 hdecay hderiv phi chi (𝓕⁻ g)
      hphi_one hphi_zero hphi_norm hchi_compact hchi_norm j
  have hsymbol (s : ℝ) (xi : Euclidean (d + 1)) :
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * chi xi *
          𝓕 ((𝓕⁻ g : SchwartzMap (Euclidean (d + 1)) ℂ) : Euclidean (d + 1) → ℂ) xi =
        surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * g xi := by
    rw [← SchwartzMap.fourier_coe, fourier_fourierInv_eq]
    calc
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * chi xi * g xi =
          surfaceFourier (d + 1) (-s • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * (chi xi * g xi) := by ring
      _ = _ := by rw [hchi_mul]
  have hfourier (xi : Euclidean (d + 1)) :
      𝓕
          ((𝓕⁻ g : SchwartzMap (Euclidean (d + 1)) ℂ) :
            Euclidean (d + 1) → ℂ)
          xi =
        g xi := by
    rw [← SchwartzMap.fourier_coe, fourier_fourierInv_eq]
  have hsymbol' (s : ℝ) (xi : Euclidean (d + 1)) :
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * chi xi * g xi =
        surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * g xi := by
    calc
      surfaceFourier (d + 1) (-s • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * chi xi * g xi =
          surfaceFourier (d + 1) (-s • xi) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • xi)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (s • xi))) * (chi xi * g xi) := by ring
      _ = _ := by rw [hchi_mul]
  simpa only [hfourier, hsymbol'] using hlocal

theorem memLp_two_iSup_relative_dyadic_radius_block_compact_data
    {d : Nat} (hd : 1 ≤ d) (C0 C1 : ℝ) (hC0 : 0 < C0) (hC1 : 0 < C1)
    (hdecay : ∀ xi : Euclidean (d + 1), 1 ≤ ‖xi‖ →
      ‖surfaceFourier (d + 1) xi‖ ≤ C0 / ‖xi‖ ^ ((d : ℝ) / 2))
    (hderiv : ∀ xi : Euclidean (d + 1), ∀ r : ℝ, 1 ≤ ‖xi‖ →
      r ∈ Icc (1 : ℝ) 2 →
      ‖deriv (fun s : ℝ => surfaceFourier (d + 1) (s • xi)) r‖ ≤
        C1 / ‖xi‖ ^ ((d : ℝ) / 2 - 1))
    (phi g : SchwartzMap (Euclidean (d + 1)) ℂ)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1)
    (hg : HasCompactSupport (g : Euclidean (d + 1) → ℂ))
    (j : Nat) (a : ℝ) (ha : 0 < a) :
    let B : Euclidean (d + 1) → ℝ := fun x =>
      (⨆ r : Icc a (2 * a), ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x‖).toReal
    Measurable B ∧ MemLp B 2 volume ∧
      (∫ x : Euclidean (d + 1), ‖B x‖ ^ 2) ≤
        (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ xi : Euclidean (d + 1), ‖g xi‖ ^ 2) := by
  let A : Euclidean (d + 1) ≃L[ℝ] Euclidean (d + 1) :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 a⁻¹ (inv_ne_zero ha.ne'))
  let ga : SchwartzMap (Euclidean (d + 1)) ℂ :=
    SchwartzMap.compCLMOfContinuousLinearEquiv ℂ A g
  have hga (xi : Euclidean (d + 1)) : ga xi = g (a⁻¹ • xi) := by
    change g (A xi) = _
    simp [A]
  have hga_compact : HasCompactSupport (ga : Euclidean (d + 1) → ℂ) := by
    change HasCompactSupport ((g : Euclidean (d + 1) → ℂ) ∘
      (A.toHomeomorph : Euclidean (d + 1) → Euclidean (d + 1)))
    exact hg.comp_homeomorph A.toHomeomorph
  have hlocal := memLp_two_iSup_relative_dyadic_moving_bandpass_compact_data
    hd C0 C1 hC0 hC1 hdecay hderiv phi ga
