            surfaceFourier (d + 1) (-s.1 • eta) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta) (a⁻¹ • x)‖ =
            ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
