                      (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                        phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta) (a⁻¹ • x)‖ =
                    ENNReal.ofReal (q *
                      ‖𝓕⁻ (fun eta : Euclidean (d + 1) =>
                      surfaceFourier (d + 1) (-s.1 • eta) *
                        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                          phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta)
                        (a⁻¹ • x)‖) :=
                      (ENNReal.ofReal_mul hq).symm
                _ = ENNReal.ofReal ‖q •
                    𝓕⁻ (fun eta : Euclidean (d + 1) =>
                    surfaceFourier (d + 1) (-s.1 • eta) *
                      (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                        phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta)
