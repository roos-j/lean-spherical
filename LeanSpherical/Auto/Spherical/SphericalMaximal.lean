      (∀ xi : Euclidean d, psi xi =
        deriv (fun t : ℝ =>
          phi (((2 : ℝ) ^ (j + 1))⁻¹ • (t • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (t • xi))) r * theta xi) ∧
      HasCompactSupport (psi : Euclidean d → ℂ) := by
  let dB : Euclidean d → ℂ := fun xi =>
    fderiv ℝ (phi : Euclidean d → ℂ)
      (((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi))
      (((2 : ℝ) ^ (j + 1))⁻¹ • xi) -
    fderiv ℝ (phi : Euclidean d → ℂ)
      (((2 : ℝ) ^ j)⁻¹ • (r • xi))
      (((2 : ℝ) ^ j)⁻¹ • xi)
  let phiFamily : Euclidean d → Euclidean d → ℂ := fun _ => phi
  have hphiFamily : ContDiff ℝ (↑(⊤ : ℕ∞)) (Function.uncurry phiFamily) := by
    change ContDiff ℝ (↑(⊤ : ℕ∞)) (fun q : Euclidean d × Euclidean d => phi q.2)
    exact (phi.smooth (⊤ : ℕ∞)).comp contDiff_snd
  have harg1 : ContDiff ℝ (↑(⊤ : ℕ∞))
      (fun xi : Euclidean d => ((2 : ℝ) ^ (j + 1))⁻¹ • (r • xi)) := by
    fun_prop
  have harg0 : ContDiff ℝ (↑(⊤ : ℕ∞))
      (fun xi : Euclidean d => ((2 : ℝ) ^ j)⁻¹ • (r • xi)) := by
    fun_prop
  have hvec1 : ContDiff ℝ (↑(⊤ : ℕ∞))
      (fun xi : Euclidean d => ((2 : ℝ) ^ (j + 1))⁻¹ • xi) := by
    fun_prop
  have hvec0 : ContDiff ℝ (↑(⊤ : ℕ∞))
