          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • eta)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (s • eta))) * ga eta) x
  have hblockENN (x : Euclidean (d + 1)) :
      (⨆ r : Icc a (2 * a), ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-r.1 • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x‖) =
        ENNReal.ofReal q *
          (⨆ s : Icc (1 : ℝ) 2, ENNReal.ofReal ‖𝓕⁻ (fun eta : Euclidean (d + 1) =>
            surfaceFourier (d + 1) (-s.1 • eta) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta) (a⁻¹ • x)‖) := by
    apply le_antisymm
    · refine iSup_le fun r => ?_
      let s : Icc (1 : ℝ) 2 := ⟨a⁻¹ * r.1, by
        constructor
        · calc
            1 = a⁻¹ * a := (inv_mul_cancel₀ ha.ne').symm
            _ ≤ a⁻¹ * r.1 := mul_le_mul_of_nonneg_left r.2.1 (inv_nonneg.mpr ha.le)
        · calc
