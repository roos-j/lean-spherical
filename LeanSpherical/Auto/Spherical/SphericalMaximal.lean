              surfaceFourier (d + 1) (-s.1 • eta) *
                (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                  phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta) (a⁻¹ • x)‖) := by
              rw [hd, norm_smul, Real.norm_eq_abs, abs_of_nonneg hq]
        _ = ENNReal.ofReal q * ENNReal.ofReal ‖𝓕⁻ (fun eta : Euclidean (d + 1) =>
