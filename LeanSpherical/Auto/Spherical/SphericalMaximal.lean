  let M : Euclidean (d + 1) → ℝ := fun y =>
    (⨆ s : Icc (1 : ℝ) 2, ENNReal.ofReal ‖𝓕⁻ (fun eta : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-s.1 • eta) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s.1 • eta)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (s.1 • eta))) * ga eta) y‖).toReal
  have hMlocal : MemLp M 2 volume ∧
      (∫ y : Euclidean (d + 1), ‖M y‖ ^ 2) ≤
        (((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) ^ 2 +
          2 * ((4 * C0) / (dyadicScale j) ^ ((d : ℝ) / 2)) *
            (2 * ((8 * C1) / (dyadicScale j) ^ ((d : ℝ) / 2 - 1) +
              (12 * C0 *
                  ‖((SchwartzMap.fderivCLM ℂ
                    (Euclidean (d + 1)) ℂ) phi).toBoundedContinuousFunction‖) /
                (dyadicScale j) ^ ((d : ℝ) / 2)))) *
          (∫ eta : Euclidean (d + 1), ‖ga eta‖ ^ 2) := by
    simpa only [M] using hlocal
  let B : Euclidean (d + 1) → ℝ := fun x =>
    (⨆ r : Icc a (2 * a), ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
      surfaceFourier (d + 1) (-r.1 • xi) *
        (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
          phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x‖).toReal
  let q : ℝ := (a⁻¹) ^ (d + 1)
  have hq : 0 ≤ q := by
    dsimp only [q]
    positivity
  have hqpos : 0 < q := by
    dsimp only [q]
    positivity
  have hdilate (s : ℝ) (x : Euclidean (d + 1)) :
      𝓕⁻ (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-(a * s) • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • ((a * s) • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • ((a * s) • xi))) * g xi) x =
        q • 𝓕⁻ (fun eta : Euclidean (d + 1) =>
          surfaceFourier (d + 1) (-s • eta) *
            (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (s • eta)) -
              phi (((2 : ℝ) ^ j)⁻¹ • (s • eta))) * ga eta) (a⁻¹ • x) := by
    have hfun : (fun xi : Euclidean (d + 1) =>
        surfaceFourier (d + 1) (-(a * s) • xi) *
          (phi (((2 : ℝ) ^ (j + 1))⁻¹ • ((a * s) • xi)) -
            phi (((2 : ℝ) ^ j)⁻¹ • ((a * s) • xi))) * g xi) =
