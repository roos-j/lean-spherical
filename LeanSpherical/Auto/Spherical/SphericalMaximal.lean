      have hrs : a * s.1 = r.1 := by
        dsimp only [s]
        field_simp
      have hd := hdilate s.1 x
      rw [hrs] at hd
      calc
        ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean (d + 1) =>
            surfaceFourier (d + 1) (-r.1 • xi) *
              (phi (((2 : ℝ) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                phi (((2 : ℝ) ^ j)⁻¹ • (r.1 • xi))) * g xi) x‖ =
