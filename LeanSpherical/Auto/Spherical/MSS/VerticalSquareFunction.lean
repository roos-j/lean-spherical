  calc
    Real.sqrt (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) ≤
        Real.sqrt ((indices.card : Real) * (κ y) ^ (2 : Nat)) :=
      Real.sqrt_le_sqrt hsum
    _ = Real.sqrt (indices.card : Real) * Real.sqrt ((κ y) ^ (2 : Nat)) := by
      rw [Real.sqrt_mul (by positivity)]
    _ = Real.sqrt (indices.card : Real) * κ y := by
      rw [Real.sqrt_sq_eq_abs, abs_of_nonneg (hκ y)]

/-- A common pointwise inverse-Fourier kernel envelope gives the sharp finite
`sqrt(card)` top bound on the additive temporal Schwartz core.  This remains
a finite Schwartz result; it is not the measurable vector-valued extension
needed for the later interpolation step. -/
theorem norm_verticalTemporalSchwartzCoreRecombined_le_of_common_kernel
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex)
    (κ : Real → Real) (hκ : ∀ y, 0 ≤ κ y) (hκint : Integrable κ volume)
    (hkernel : ∀ n ∈ indices, ∀ y,
      ‖(𝓕⁻ (m n) : SchwartzMap Real Complex) y‖ ≤ κ y)
    {A : Real}
    (hinput : ∀ t, Real.sqrt (∑ n ∈ indices, ‖g n t‖ ^ (2 : Nat)) ≤ A)
    (t : Real) :
    ‖verticalTemporalSchwartzCoreRecombined indices m g t‖ ≤
      Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
  let K : Int → Real → Complex := fun n => (𝓕⁻ (m n) : SchwartzMap Real Complex)
  have hA : 0 ≤ A := le_trans (Real.sqrt_nonneg _) (hinput 0)
  have hg : ∀ n ∈ indices, ∀ u, ‖g n u‖ ≤ A := by
    intro n hn u
    exact (aux_norm_le_temporal_square indices g hn u).trans (hinput u)
  have hprod : ∀ n ∈ indices, Integrable
      (fun y : Real => K n y * g n (t - y)) volume := by
    intro n hn
    have hshift : Continuous (fun y : Real => (g n : Real → Complex) (t - y)) :=
      (g n).continuous.comp ((continuous_const : Continuous fun _ : Real => t).sub continuous_id)
    have hmajor : Integrable (fun y : Real => κ y * A) volume := by
      simpa [mul_comm] using hκint.mul_const A
    have hmeas : AEStronglyMeasurable
        (fun y : Real => K n y * g n (t - y)) volume :=
      (𝓕⁻ (m n) : SchwartzMap Real Complex).continuous.aestronglyMeasurable.mul
        hshift.aestronglyMeasurable
    refine hmajor.mono' hmeas (Filter.Eventually.of_forall ?_)
    intro y
    change ‖K n y * g n (t - y)‖ ≤ κ y * A
    rw [norm_mul]
    exact mul_le_mul (hkernel n hn y) (hg n hn (t - y)) (norm_nonneg _) (hκ y)
  have hsumint : Integrable
      (fun y : Real => ∑ n ∈ indices, K n y * g n (t - y)) volume := by
    exact integrable_finsetSum indices (fun n hn => hprod n hn)
  have henvelope : Integrable
      (fun y : Real => Real.sqrt (indices.card : Real) * κ y * A) volume := by
    have := hκint.const_mul (Real.sqrt (indices.card : Real) * A)
    simpa [mul_assoc, mul_left_comm, mul_comm] using this
  have hpoint (y : Real) :
      ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
        Real.sqrt (indices.card : Real) * κ y * A := by
    calc
      ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
          ∑ n ∈ indices, ‖K n y‖ * ‖g n (t - y)‖ := by
        calc
          ‖∑ n ∈ indices, K n y * g n (t - y)‖ ≤
              ∑ n ∈ indices, ‖K n y * g n (t - y)‖ := norm_sum_le _ _
          _ = ∑ n ∈ indices, ‖K n y‖ * ‖g n (t - y)‖ := by
            apply Finset.sum_congr rfl
            intro n hn
            rw [norm_mul]
      _ ≤ Real.sqrt (∑ n ∈ indices, ‖K n y‖ ^ (2 : Nat)) *
          Real.sqrt (∑ n ∈ indices, ‖g n (t - y)‖ ^ (2 : Nat)) :=
        Real.sum_mul_le_sqrt_mul_sqrt _ _ _
      _ ≤ (Real.sqrt (indices.card : Real) * κ y) * A := by
        exact mul_le_mul
          (aux_sqrt_sum_sq_kernel_le indices K κ hκ hkernel y)
          (hinput (t - y))
          (Real.sqrt_nonneg _)
          (mul_nonneg (Real.sqrt_nonneg _) (hκ y))
      _ = Real.sqrt (indices.card : Real) * κ y * A := by ring
  unfold verticalTemporalSchwartzCoreRecombined
  calc
    ‖∑ n ∈ indices, verticalTemporalSchwartzMultiplier (m n) (g n) t‖ =
        ‖∫ y : Real, ∑ n ∈ indices, K n y * g n (t - y)‖ := by
      congr 2
      rw [integral_finsetSum indices (fun n hn => hprod n hn)]
      apply Finset.sum_congr rfl
      intro n hn
      rw [verticalTemporalSchwartzMultiplier_eq_convolution]
      rfl
    _ ≤ ∫ y : Real, ‖∑ n ∈ indices, K n y * g n (t - y)‖ :=
      norm_integral_le_integral_norm _
    _ ≤ ∫ y : Real, Real.sqrt (indices.card : Real) * κ y * A :=
      integral_mono hsumint.norm henvelope hpoint
    _ = Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
      calc
        (∫ y : Real, Real.sqrt (indices.card : Real) * κ y * A) =
            ∫ y : Real, (Real.sqrt (indices.card : Real) * A) * κ y := by
          apply integral_congr_ae
          filter_upwards with y
          ring
        _ = (Real.sqrt (indices.card : Real) * A) * ∫ y : Real, κ y := by
          rw [integral_const_mul]
        _ = Real.sqrt (indices.card : Real) * (∫ y : Real, κ y) * A := by
          ring

/-- Supplied Schwartz profiles identify the temporal additive core with the
finite sum of literal vertical temporal projections. -/
theorem vertTempSchwartzCoreRecomb_eq_sum_vertTempProjection_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (g : Int → SchwartzMap Real Complex) :
    verticalTemporalSchwartzCoreRecombined indices m g =
      fun t => ∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t := by
  funext t
  unfold verticalTemporalSchwartzCoreRecombined
  apply Finset.sum_congr rfl
  intro n hn
  unfold verticalTemporalSchwartzMultiplier verticalTemporalProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile n hn τ]

private theorem aux_sum_schwartzReal_apply {ι : Type*}
    (indices : Finset ι) (h : ι → SchwartzMap Real Complex) (t : Real) :
    (∑ n ∈ indices, h n) t = ∑ n ∈ indices, h n t := by
  change
    ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex)
      (∑ n ∈ indices, h n)) t =
        ∑ n ∈ indices,
          ((FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) (h n)) t
  simpa only [Finset.sum_apply] using
    congrFun (map_sum
      (FunLike.coeAddMonoidHom (SchwartzMap Real Complex) Real Complex) h indices) t

private noncomputable def aux_verticalRecombinedTemporalProfile
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) :
    SchwartzMap Real Complex :=
  ∑ n ∈ indices, 𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))

private theorem aux_verticalRecombinedTemporalProfile_fourier_apply
    (indices : Finset Int) (m g : Int → SchwartzMap Real Complex) (τ : Real) :
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
      ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ := by
  have hsum :
      𝓕 (aux_verticalRecombinedTemporalProfile indices m g :
        SchwartzMap Real Complex) =
        ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) := by
    unfold aux_verticalRecombinedTemporalProfile
    rw [FourierTransform.fourier_sum]
    apply Finset.sum_congr rfl
    intro n hn
    exact FourierTransform.fourier_fourierInv_eq _
  have hpoint := congrArg (fun q : SchwartzMap Real Complex => q τ) hsum
  calc
    𝓕 ((aux_verticalRecombinedTemporalProfile indices m g :
      SchwartzMap Real Complex) : Real → Complex) τ =
        (∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n)) τ := by
      simpa only [SchwartzMap.fourier_coe] using hpoint
    _ = ∑ n ∈ indices, aux_verticalTemporalMultiplierProfile (m n) (g n) τ :=
      aux_sum_schwartzReal_apply indices
        (fun n => aux_verticalTemporalMultiplierProfile (m n) (g n)) τ

/-- For a finite vertical recombination of literal separable packets sharing
one spatial Schwartz factor, the space--time Fourier multiplier identity
holds after collecting the finite temporal sum into a Schwartz profile.  This
is a common-spatial-factor finite-tensor theorem; it does not cover the
general recombination with both spatial and temporal factors varying, nor a
physical-time-cutoff half-wave. -/
theorem spaceTimeFourier_vertRecomb_vertSepblPkts_of_schwartzProfiles_common_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket F (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket F (g n : Real → Complex)) (ξ, τ) := by
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket F (g n : Real → Complex)) =
      verticalSeparablePacket F
        ((aux_verticalRecombinedTemporalProfile indices m g :
          SchwartzMap Real Complex) : Real → Complex) := by
    funext z
    rw [verticalRecombined_verticalSeparablePackets]
    unfold verticalSeparablePacket
    unfold aux_verticalRecombinedTemporalProfile
    rw [aux_sum_schwartzReal_apply]
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro n hn
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
  rw [hphysical, spaceTimeFourier_verticalSeparablePacket,
    aux_verticalRecombinedTemporalProfile_fourier_apply]
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro n hn
  rw [aux_verticalTemporalMultiplierProfile_apply, hprofile n hn,
    spaceTimeFourier_verticalSeparablePacket, verticalMultiplier]
  ring

private theorem aux_spaceTimeFourier_finset_sum_verticalSeparablePackets
    (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex)
    (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (fun z => ∑ n ∈ indices,
          verticalSeparablePacket (F n) (g n : Real → Complex) z) (ξ, τ) =
      ∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  have hspace (t : Real) :
      𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ =
        ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    let H : SchwartzMap (Euclidean 2) Complex :=
      ∑ n ∈ indices, (g n t) • F n
    have hH (x : Euclidean 2) : H x = ∑ n ∈ indices, g n t * F n x := by
      dsimp only [H]
      rw [sum_apply]
      simp only [smul_apply, smul_eq_mul]
    rw [show (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) = H by
      funext x
      exact (hH x).symm]
    change (𝓕 H : SchwartzMap (Euclidean 2) Complex) ξ = _
    rw [show H = ∑ n ∈ indices, (g n t) • F n by rfl]
    rw [FourierTransform.fourier_sum, sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    rw [FourierTransform.fourier_smul]
    simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]
  have hright :
      (∑ n ∈ indices,
        spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ)) =
        ∑ n ∈ indices,
          𝓕 (F n : Euclidean 2 → Complex) ξ * 𝓕 (g n : Real → Complex) τ := by
    apply Finset.sum_congr rfl
    intro n hn
    exact spaceTimeFourier_verticalSeparablePacket (F n) (g n : Real → Complex) ξ τ
  rw [hright]
  unfold spaceTimeFourier
  change 𝓕 (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) τ = _
  rw [show (fun t : Real =>
    𝓕 (fun x : Euclidean 2 => ∑ n ∈ indices, g n t * F n x) ξ) =
      fun t : Real => ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ by
        funext t
        exact hspace t]
  let K : SchwartzMap Real Complex :=
    ∑ n ∈ indices, (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n
  have hK (t : Real) : K t =
      ∑ n ∈ indices, g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ := by
    dsimp only [K]
    rw [sum_apply]
    simp only [smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro n hn
    ring
  rw [show (fun t : Real => ∑ n ∈ indices,
    g n t * 𝓕 (F n : Euclidean 2 → Complex) ξ) = K by
      funext t
      exact (hK t).symm]
  change (𝓕 K : SchwartzMap Real Complex) τ = _
  rw [show K = ∑ n ∈ indices,
    (𝓕 (F n : Euclidean 2 → Complex) ξ) • g n by rfl]
  rw [FourierTransform.fourier_sum, sum_apply]
  apply Finset.sum_congr rfl
  intro n hn
  rw [FourierTransform.fourier_smul]
  simp only [smul_apply, smul_eq_mul, SchwartzMap.fourier_coe]

/-- A finite vertical recombination of literal separable packets has the
expected space--time Fourier multiplier identity when every translated
temporal cutoff has a supplied Schwartz representative.  Unlike the
common-spatial-factor corollary, both the spatial and temporal factors may
vary with the radial index.  The proof uses only finite sums of actual
Schwartz maps at each Fourier stage; it does not assert an arbitrary-function
Fourier-additivity or cover physical-time-cutoff half-waves. -/
theorem spaceTimeFourier_verticalRecombined_verticalSeparablePackets_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) (ξ : Euclidean 2) (τ : Real) :
    spaceTimeFourier
        (verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) (ξ, τ) =
      ∑ n ∈ indices,
        verticalMultiplier β scale n (ξ, τ) *
          spaceTimeFourier (verticalSeparablePacket (F n) (g n : Real → Complex)) (ξ, τ) := by
  let h : Int → SchwartzMap Real Complex := fun n =>
    𝓕⁻ (aux_verticalTemporalMultiplierProfile (m n) (g n))
  have hpiece (n : Int) (hn : n ∈ indices) :
      verticalProjection β scale n
        (verticalSeparablePacket (F n) (g n : Real → Complex)) =
      verticalSeparablePacket (F n) (h n : Real → Complex) := by
    funext z
    rw [verticalProjection_verticalSeparablePacket]
    rw [aux_verticalTemporalProjection_eq_fourierInv_profile β scale n
      (m n) (g n) (hprofile n hn)]
    rfl
  have hphysical : verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z => ∑ n ∈ indices,
        verticalSeparablePacket (F n) (h n : Real → Complex) z := by
    funext z
    unfold verticalRecombined
    apply Finset.sum_congr rfl
    intro n hn
    rw [hpiece n hn]
  rw [hphysical, aux_spaceTimeFourier_finset_sum_verticalSeparablePackets]
  apply Finset.sum_congr rfl
  intro n hn
  rw [← hpiece n hn]
  exact spaceTimeFourier_verticalProjection_verticalSeparablePacket_of_schwartzProfile
    β scale n (m n) (g n) (hprofile n hn) (F n) ξ τ

/-- A literal finite `L²` recombination endpoint for the one-dimensional
vertical multipliers.  The supplied `m n` are actual Schwartz representatives
of the translated cutoff profiles, and their pointwise square-overlap is the
only Fourier-side estimate used here. -/
theorem integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C) :
    (∫ t : Real, ‖∑ n ∈ indices,
      verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    SchwartzMap.smulLeftCLM Complex (m n : Real → Complex) (𝓕 (g n))
  let hsum : SchwartzMap Real Complex := ∑ n ∈ indices, h n
  let out : SchwartzMap Real Complex := 𝓕⁻ hsum
  have hpiece (n : Int) (t : Real) :
      (𝓕⁻ (h n) : SchwartzMap Real Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    rw [SchwartzMap.fourierInv_coe]
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [hprofile n hn τ]
  have hactual (t : Real) :
      (∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t) = out t := by
    symm
    calc
      out t = ∑ n ∈ indices, (𝓕⁻ (h n) : SchwartzMap Real Complex) t := by
        dsimp only [out, hsum]
        rw [FourierTransform.fourierInv_sum]
        simp
      _ = ∑ n ∈ indices,
          𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact hpiece n t
      _ = ∑ n ∈ indices, verticalTemporalProjection β scale n (g n) t := by
        apply Finset.sum_congr rfl
        intro n hn
        exact (hvertical n hn t).symm
  have hsum_apply (τ : Real) :
      hsum τ = ∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ := by
    dsimp only [hsum]
    rw [sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    simp only [h, SchwartzMap.smulLeftCLM_apply (m n).hasTemperateGrowth,
      smul_eq_mul, SchwartzMap.fourier_coe]
  have hsum_integrable : Integrable (fun τ : Real => ‖hsum τ‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm hsum.continuous.aestronglyMeasurable).mp
      (hsum.memLp 2 volume)
  have hg_integrable (n : Int) :
      Integrable (fun τ : Real => ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume := by
    rw [← SchwartzMap.fourier_coe]
    exact (memLp_two_iff_integrable_sq_norm
      (𝓕 (g n)).continuous.aestronglyMeasurable).mp ((𝓕 (g n)).memLp 2 volume)
  have hright_integrable : Integrable (fun τ : Real =>
      C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) volume :=
    (integrable_finsetSum indices (fun n hn => hg_integrable n)).const_mul C
  have hpoint (τ : Real) :
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
        C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
    have hnorm :
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
          Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
      calc
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ≤
            ∑ n ∈ indices, ‖m n τ * 𝓕 (g n : Real → Complex) τ‖ := norm_sum_le _ _
        _ = ∑ n ∈ indices, ‖m n τ‖ * ‖𝓕 (g n : Real → Complex) τ‖ := by
          apply Finset.sum_congr rfl
          intro n hn
          rw [norm_mul]
        _ ≤ Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) :=
          Real.sum_mul_le_sqrt_mul_sqrt _ _ _
    calc
      ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) ≤
          (Real.sqrt (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
            Real.sqrt (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ))) ^ (2 : ℕ) :=
        (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (Real.sqrt_nonneg _)
          (Real.sqrt_nonneg _))).mpr hnorm
      _ = (∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ)) *
          (∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) := by
        rw [mul_pow, Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _),
          Real.sq_sqrt (Finset.sum_nonneg fun _ _ => sq_nonneg _)]
      _ ≤ C * ∑ n ∈ indices, ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
        mul_le_mul_of_nonneg_right (hoverlap τ)
          (Finset.sum_nonneg fun _ _ => sq_nonneg _)
  calc
    (∫ t : Real, ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) t‖ ^ (2 : ℕ)) =
        ∫ t : Real, ‖out t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with t
      rw [hactual t]
    _ = ∫ τ : Real, ‖𝓕 (out : Real → Complex) τ‖ ^ (2 : ℕ) :=
      (Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq out).symm
    _ = ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [← SchwartzMap.fourier_coe]
      change ‖(𝓕 out : SchwartzMap Real Complex) τ‖ ^ (2 : ℕ) = _
      rw [show 𝓕 out = hsum by
        dsimp only [out]
        exact FourierTransform.fourier_fourierInv_eq _]
    _ = ∫ τ : Real,
        ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with τ
      rw [hsum_apply τ]
    _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      calc
        (∫ τ : Real,
            ‖∑ n ∈ indices, m n τ * 𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ)) =
            ∫ τ : Real, ‖hsum τ‖ ^ (2 : ℕ) := by
          apply integral_congr_ae
          filter_upwards with τ
          rw [hsum_apply τ]
        _ ≤ ∫ τ : Real, C * ∑ n ∈ indices,
            ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) :=
          integral_mono hsum_integrable hright_integrable (fun τ => by
            rw [hsum_apply τ]
            exact hpoint τ)
    _ = C * ∑ n ∈ indices, ∫ τ : Real,
        ‖𝓕 (g n : Real → Complex) τ‖ ^ (2 : ℕ) := by
      rw [integral_const_mul, integral_finsetSum indices (fun n hn => hg_integrable n)]
    _ = C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq (g n)

/-- The finite-overlap raw `L²` endpoint for the additive temporal Schwartz
core.  It is not an all-measurable vector-valued multiplier theorem. -/
theorem integral_norm_sq_verticalTemporalSchwartzCoreRecombined_le_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (g : Int → SchwartzMap Real Complex) :
    (∫ t : Real,
      ‖verticalTemporalSchwartzCoreRecombined indices m g t‖ ^ (2 : Nat)) ≤
      C * ∑ n ∈ indices, ∫ t : Real, ‖g n t‖ ^ (2 : Nat) := by
  rw [vertTempSchwartzCoreRecomb_eq_sum_vertTempProjection_of_schwartzProfiles
    β scale indices m hprofile g]
  exact integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
    β scale indices m g hprofile hoverlap

private theorem aux_verticalTemporalProjection_const_mul
    (β : Real → Complex) (scale : Real) (n : Int)
    (c : Complex) (g : Real → Complex) (t : Real) :
    verticalTemporalProjection β scale n (fun s => c * g s) t =
      c * verticalTemporalProjection β scale n g t := by
  unfold verticalTemporalProjection
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      𝓕 (fun s : Real => c * g s) τ) =
      fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
        (c * 𝓕 g τ) by
        funext τ
        rw [aux_fourier_const_mul_apply]]
  rw [show (fun τ : Real => β ((Real.sqrt scale)⁻¹ * τ - n) *
      (c * 𝓕 g τ)) =
      fun τ : Real => c *
        (β ((Real.sqrt scale)⁻¹ * τ - n) * 𝓕 g τ) by
        funext τ
        ring]
  exact aux_fourierInv_const_mul_apply c _ t

private noncomputable def aux_verticalTemporalOutputProfile
    (m g : SchwartzMap Real Complex) : SchwartzMap Real Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex (m : Real → Complex) (𝓕 g))

private theorem aux_verticalTemporalProjection_eq_outputProfile
    (β : Real → Complex) (scale : Real) (n : Int)
    (m g : SchwartzMap Real Complex)
    (hprofile : ∀ τ : Real, m τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (t : Real) :
    verticalTemporalProjection β scale n (g : Real → Complex) t =
      (aux_verticalTemporalOutputProfile m g : Real → Complex) t := by
  unfold verticalTemporalProjection aux_verticalTemporalOutputProfile
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
  funext τ
  simp only [SchwartzMap.smulLeftCLM_apply (m).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]
  rw [hprofile τ]

private theorem aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hh_integrable (n : Int) :
      Integrable (fun t : Real => ‖h n t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (h n).continuous.aestronglyMeasurable).mp ((h n).memLp 2 volume)
  have hterm_integrable (n : Int) :
      Integrable (fun z : WaveSpaceTime => ‖h n z.2 * F n z.1‖ ^ (2 : ℕ)) volume := by
    simpa only [Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      (hF_integrable n).mul_prod (hh_integrable n)
  have hterm_memLp (n : Int) :
      MemLp (fun z : WaveSpaceTime => h n z.2 * F n z.1) 2 volume := by
    apply (memLp_two_iff_integrable_sq_norm
      (((h n).continuous.comp continuous_snd).mul
        ((F n).continuous.comp continuous_fst)).aestronglyMeasurable).mpr
    exact hterm_integrable n
  have hsum_memLp : MemLp (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) 2 volume :=
    memLp_finsetSum indices (fun n hn => hterm_memLp n)
  rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
  exact (memLp_two_iff_integrable_sq_norm hsum_memLp.aestronglyMeasurable).mp hsum_memLp

private theorem aux_integral_norm_sq_verticalSeparablePacket_eq_product
    (F : SchwartzMap (Euclidean 2) Complex) (g : SchwartzMap Real Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
      (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
  have hF_integrable : Integrable (fun x : Euclidean 2 => ‖F x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      F.continuous.aestronglyMeasurable).mp (F.memLp 2 volume)
  have hg_integrable : Integrable (fun t : Real => ‖g t‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      g.continuous.aestronglyMeasurable).mp (g.memLp 2 volume)
  have hpacket_integrable : Integrable (fun z : WaveSpaceTime =>
      ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) volume := by
    simpa only [verticalSeparablePacket, Measure.volume_eq_prod, norm_mul, mul_pow, mul_comm] using
      hF_integrable.mul_prod hg_integrable
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket F (g : Real → Complex) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hpacket_integrable)
    _ = ∫ x : Euclidean 2,
        ‖F x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g t‖ ^ (2 : ℕ) := by
      apply integral_congr_ae
      filter_upwards with x
      rw [show (fun t : Real =>
        ‖verticalSeparablePacket F (g : Real → Complex) (x, t)‖ ^ (2 : ℕ)) =
          fun t : Real => ‖F x‖ ^ (2 : ℕ) * ‖g t‖ ^ (2 : ℕ) by
            funext t
            simp only [verticalSeparablePacket, norm_mul, mul_pow, mul_comm]]
      rw [integral_const_mul]
    _ = (∫ x : Euclidean 2, ‖F x‖ ^ (2 : ℕ)) *
        (∫ t : Real, ‖g t‖ ^ (2 : ℕ)) := by
      rw [integral_mul_const]

private theorem aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2, ∫ t : Real,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hscaled (x : Euclidean 2) (n : Int) :
      (∫ t : Real, ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    rw [show (fun t : Real => ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ)) =
        fun t : Real => ‖F n x‖ ^ (2 : ℕ) * ‖g n t‖ ^ (2 : ℕ) by
          funext t
          simp only [smul_apply, smul_eq_mul, norm_mul, mul_pow]]
    rw [integral_const_mul]
  have hslice (x : Euclidean 2) :
      (∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
    have htemporal :=
      integral_norm_sq_sum_verticalTemporalProjection_le_of_schwartz_profiles
        β scale indices m (fun n => (F n x) • g n) hprofile hoverlap
    calc
      (∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ)) =
          ∫ t : Real, ‖∑ n ∈ indices,
            verticalTemporalProjection β scale n
              (((F n x) • g n : SchwartzMap Real Complex) : Real → Complex) t‖ ^
              (2 : ℕ) := by
            apply integral_congr_ae
            filter_upwards with t
            rw [verticalRecombined_verticalSeparablePackets]
            apply congrArg (fun w : Complex => ‖w‖ ^ (2 : ℕ))
            apply Finset.sum_congr rfl
            intro n hn
            change verticalTemporalProjection β scale n (g n : Real → Complex) t * F n x =
              verticalTemporalProjection β scale n
                (fun s : Real => F n x * g n s) t
            rw [aux_verticalTemporalProjection_const_mul]
            ring
      _ ≤ C * ∑ n ∈ indices, ∫ t : Real,
          ‖((F n x) • g n : SchwartzMap Real Complex) t‖ ^ (2 : ℕ) := htemporal
      _ = C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) := by
        congr 1
        apply Finset.sum_congr rfl
        intro n hn
        exact hscaled x n
  have hF_integrable (n : Int) :
      Integrable (fun x : Euclidean 2 => ‖F n x‖ ^ (2 : ℕ)) volume :=
    (memLp_two_iff_integrable_sq_norm
      (F n).continuous.aestronglyMeasurable).mp ((F n).memLp 2 volume)
  have hright_integrable : Integrable (fun x : Euclidean 2 =>
      C * ∑ n ∈ indices, ‖F n x‖ ^ (2 : ℕ) *
        ∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) volume := by
    apply (integrable_finsetSum indices (fun n hn =>
      (hF_integrable n).mul_const (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)))).const_mul C
  have houtput_cont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  have hsq_cont : Continuous (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) := by
    rw [show (fun z : WaveSpaceTime =>
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
      fun z : WaveSpaceTime => ‖∑ n ∈ indices, h n z.2 * F n z.1‖ ^ (2 : ℕ) by
        funext z
        rw [houtput z]]
    exact houtput_cont.norm.pow _
  have hslice_meas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume :=
    hsq_cont.stronglyMeasurable.integral_prod_right'.aestronglyMeasurable
  have hleft_integrable : Integrable (fun x : Euclidean 2 =>
      ∫ t : Real, ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^ (2 : ℕ)) volume :=
            by
    refine hright_integrable.mono' hslice_meas ?_
    filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg]
    · exact hslice x
    · exact integral_nonneg fun t => sq_nonneg _
  calc
    (∫ x : Euclidean 2, ∫ t : Real,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
            (2 : ℕ)) ≤
        ∫ x : Euclidean 2, C * ∑ n ∈ indices,
          ‖F n x‖ ^ (2 : ℕ) * ∫ t : Real, ‖g n t‖ ^ (2 : ℕ) :=
      integral_mono hleft_integrable hright_integrable hslice
    _ = C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
      rw [integral_const_mul, integral_finsetSum]
      · congr 1
        apply Finset.sum_congr rfl
        intro n hn
        rw [integral_mul_const]
      · intro n hn
        exact (hF_integrable n).mul_const _

/-- A literal finite space--time `L²` endpoint for the varying-spatial
separable family from the mixed vertical Fourier identity.  The proof uses
the same exact physical tensor representation, so it does not assert a
continuum `verticalRecombination` estimate. -/
theorem integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := by
  have hintegrable :=
    aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have hiterated :=
    aux_iterated_integral_norm_sq_verticalRecombined_verticalSeparablePackets_le
      β scale indices m g hprofile hoverlap F
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) =
        ∫ x : Euclidean 2, ∫ t : Real,
          ‖verticalRecombined β scale indices
            (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) (x, t)‖ ^
              (2 : ℕ) := by
      rw [Measure.volume_eq_prod]
      exact integral_prod _ (by
        simpa only [Measure.volume_eq_prod] using hintegrable)
    _ ≤ C * ∑ n ∈ indices,
        (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
          (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) := hiterated

/-- Input-energy form of the literal finite tensor `L²` endpoint. -/
theorem integral_norm_sq_vertRecomb_vertSepblPkts_le_sum_inputEnergy_of_schw_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
      C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
  calc
    (∫ z : WaveSpaceTime,
        ‖verticalRecombined β scale indices
          (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ^ (2 : ℕ)) ≤
        C * ∑ n ∈ indices,
          (∫ x : Euclidean 2, ‖F n x‖ ^ (2 : ℕ)) *
            (∫ t : Real, ‖g n t‖ ^ (2 : ℕ)) :=
      integral_norm_sq_verticalRecombined_verticalSeparablePackets_le_of_schwartz_profiles
        β scale indices m g hprofile hoverlap F
    _ = C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ) := by
      congr 1
      apply Finset.sum_congr rfl
      intro n hn
      exact (aux_integral_norm_sq_verticalSeparablePacket_eq_product (F n) (g n)).symm

/-- The finite-overlap raw `L²` endpoint for the additive Schwartz
space--time core.  This is a finite Schwartz theorem only; it does not
provide an `L²` extension to arbitrary functions. -/
theorem integral_norm_sq_verticalSchwartzCoreRecombined_le_of_schwartzProfiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    {C : Real}
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : Nat) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → SchwartzMap Real Complex) :
    (∫ z : WaveSpaceTime,
      ‖verticalSchwartzCoreRecombined indices m F g z‖ ^ (2 : Nat)) ≤
      C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : Nat) := by
  rw [verticalSchwartzCoreRecombined_eq_verticalRecombined_of_schwartzProfiles
    β scale indices m hprofile F g]
  exact integral_norm_sq_vertRecomb_vertSepblPkts_le_sum_inputEnergy_of_schw_profiles
    β scale indices m g hprofile hoverlap F

/-- Pointwise Cauchy--Schwarz for a finite literal separable vertical
recombination.  This is the common physical-space core of the `L²` and
`L∞` finite packet endpoints below. -/
private theorem aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      Real.sum_mul_le_sqrt_mul_sqrt indices
        (fun n => ‖verticalTemporalProjection β scale n (g n) z.2‖)
        (fun n => ‖F n z.1‖)

/-- Finite separable-packet endpoint from an explicit pointwise square bound
for the actual one-dimensional vertical outputs.  It is deliberately a
literal finite statement, so a later kernel estimate can be paired with the
already proved Fourier-overlap `L²` endpoint for real interpolation. -/
theorem norm_verticalRecombined_verticalSeparablePackets_le_of_temporal_square_bound
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (g : Int → Real → Complex) {B : Real}
    (hB : 0 ≤ B)
    (htemporal : ∀ t : Real, ∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) t‖ ^ (2 : Nat) ≤ B ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hsqrt : Real.sqrt (∑ n ∈ indices,
      ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) ≤ B :=
    (Real.sqrt_le_left hB).mpr (htemporal z.2)
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n)) z‖ ≤
      Real.sqrt (∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n) z.2‖ ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      aux_norm_verticalRecombined_verticalSeparablePackets_le_temporal_spatial
        β scale indices F g z
    _ ≤ B * Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right hsqrt (Real.sqrt_nonneg _)

/-- A finite common-time-kernel endpoint for literal separable vertical
packets.  The supplied `m n` are actual Schwartz representatives of the
translated multiplier profiles.  The hypothesis `hkernel` is a literal
inverse-Fourier time-kernel envelope with one common nonnegative function
`κ`, and explicit finite coefficients `a n`; no continuum vertical
recombination or half-wave packet is asserted here. -/
theorem norm_vertRecomb_vertSepblPackets_le_of_schwartz_profiles_of_common_time_ker
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real)
    (hκ : ∀ t : Real, 0 ≤ κ t)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
  have hprojection (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t =
        𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t := by
    unfold verticalTemporalProjection
    apply congrArg (fun q : Real → Complex => 𝓕⁻ q t)
    funext τ
    rw [← hprofile n hn τ]
  rw [verticalRecombined_verticalSeparablePackets]
  calc
    ‖∑ n ∈ indices,
        verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ ≤
        ∑ n ∈ indices,
          ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2 * F n z.1‖ :=
      norm_sum_le _ _
    _ = ∑ n ∈ indices,
        ‖verticalTemporalProjection β scale n (g n : Real → Complex) z.2‖ * ‖F n z.1‖ := by
      apply Finset.sum_congr rfl
      intro n hn
      rw [norm_mul]
    _ ≤ ∑ n ∈ indices, (κ z.2 * a n) * ‖F n z.1‖ := by
      apply Finset.sum_le_sum
      intro n hn
      exact mul_le_mul_of_nonneg_right (by
        rw [hprojection n hn z.2]
        exact hkernel n hn z.2) (norm_nonneg _)
    _ = κ z.2 * ∑ n ∈ indices, a n * ‖F n z.1‖ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro n hn
      ring
    _ ≤ κ z.2 *
        (Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
          Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat))) := by
      exact mul_le_mul_of_nonneg_left
        (Real.sum_mul_le_sqrt_mul_sqrt indices a (fun n => ‖F n z.1‖))
        (hκ z.2)
    _ = κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by ring

/-- Uniform spatial and time envelopes turn the previous finite
common-time-kernel theorem into its literal pointwise `L∞` form. -/
theorem norm_vertRecomb_vertSepblPkts_le_of_schw_profs_of_comm_time_ker_and_spat_env
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : Nat) ≤ A ^ (2 : Nat))
    (z : WaveSpaceTime) :
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by
  have hspatial_sqrt : Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) ≤ A :=
    (Real.sqrt_le_left hA).mpr (hspatial z.1)
  have hcoeff_nonneg : 0 ≤ Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    Real.sqrt_nonneg _
  have htemporal : κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) ≤
      B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) :=
    mul_le_mul_of_nonneg_right (hκbound z.2) hcoeff_nonneg
  calc
    ‖verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z‖ ≤
      (κ z.2 * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) := by
      exact norm_vertRecomb_vertSepblPackets_le_of_schwartz_profiles_of_common_time_ker
        β scale indices m g hprofile F κ a hκ hkernel z
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) *
        Real.sqrt (∑ n ∈ indices, ‖F n z.1‖ ^ (2 : Nat)) :=
      mul_le_mul_of_nonneg_right htemporal (Real.sqrt_nonneg _)
    _ ≤ (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat))) * A := by
      have hleft_nonneg : 0 ≤ B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) := by
        have : 0 ≤ B := le_trans (hκ z.2) (hκbound z.2)
        positivity
      exact mul_le_mul_of_nonneg_left hspatial_sqrt hleft_nonneg
    _ = B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : Nat)) * A := by ring

/-- The Schwartz-profile hypotheses make the literal finite vertical output
measurable.  This is kept separate from the `L²` estimate so the following
interpolation theorem applies to the actual `verticalRecombined` function,
rather than to a packaged endpoint proposition. -/
private theorem aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex)
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (F : Int → SchwartzMap (Euclidean 2) Complex) :
    AEStronglyMeasurable
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))) volume := by
  classical
  let h : Int → SchwartzMap Real Complex := fun n =>
    aux_verticalTemporalOutputProfile (m n) (g n)
  have hvertical (n : Int) (hn : n ∈ indices) (t : Real) :
      verticalTemporalProjection β scale n (g n : Real → Complex) t = h n t := by
    exact aux_verticalTemporalProjection_eq_outputProfile β scale n (m n) (g n)
      (hprofile n hn) t
  have houtput (z : WaveSpaceTime) :
      verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) z =
        ∑ n ∈ indices, h n z.2 * F n z.1 := by
    rw [verticalRecombined_verticalSeparablePackets]
    apply Finset.sum_congr rfl
    intro n hn
    rw [hvertical n hn z.2]
  have hcont : Continuous (fun z : WaveSpaceTime =>
      ∑ n ∈ indices, h n z.2 * F n z.1) := by
    apply continuous_finsetSum
    intro n hn
    exact ((h n).continuous.comp continuous_snd).mul
      ((F n).continuous.comp continuous_fst)
  rw [show verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)) =
      fun z : WaveSpaceTime => ∑ n ∈ indices, h n z.2 * F n z.1 by
        funext z
        exact houtput z]
  exact hcont.aestronglyMeasurable

/-- A literal finite tensor `L²`--`L⁴`--`L∞` interpolation estimate for the
actual vertical recombination.  The `L²` factor is the proved Fourier-overlap
bound on the supplied Schwartz multiplier profiles, and the `L∞` factor is
the explicit common-time-kernel/spatial-envelope bound.  Thus the conclusion
is finite and packet-level; it makes no continuum recombination claim. -/
theorem eLpNorm_four_rpow_two_vertRecomb_vertSepblPkts_le_of_schw_profs_commTimeKer_spatEnv
    (β : Real → Complex) (scale : Real) (indices : Finset Int)
    (m g : Int → SchwartzMap Real Complex) {C : Real}
    (hprofile : ∀ n ∈ indices, ∀ τ : Real,
      m n τ = β ((Real.sqrt scale)⁻¹ * τ - n))
    (hoverlap : ∀ τ : Real, ∑ n ∈ indices, ‖m n τ‖ ^ (2 : ℕ) ≤ C)
    (F : Int → SchwartzMap (Euclidean 2) Complex)
    (κ : Real → Real) (a : Int → Real) {A B : Real}
    (hA : 0 ≤ A) (hκ : ∀ t : Real, 0 ≤ κ t)
    (hκbound : ∀ t : Real, κ t ≤ B)
    (hkernel : ∀ n ∈ indices, ∀ t : Real,
      ‖𝓕⁻ (fun τ : Real => m n τ * 𝓕 (g n : Real → Complex) τ) t‖ ≤
        κ t * a n)
    (hspatial : ∀ x : Euclidean 2, ∑ n ∈ indices,
      ‖F n x‖ ^ (2 : ℕ) ≤ A ^ (2 : ℕ)) :
    (eLpNorm
      (verticalRecombined β scale indices
        (fun n => verticalSeparablePacket (F n) (g n : Real → Complex)))
      (4 : ENNReal) volume) ^ (2 : Real) ≤
      ENNReal.ofReal (Real.sqrt (C * ∑ n ∈ indices, ∫ z : WaveSpaceTime,
        ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ))) *
        ENNReal.ofReal (B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A) := by
  let out : WaveSpaceTime → Complex :=
    verticalRecombined β scale indices
      (fun n => verticalSeparablePacket (F n) (g n : Real → Complex))
  let E : Real := ∑ n ∈ indices, ∫ z : WaveSpaceTime,
    ‖verticalSeparablePacket (F n) (g n : Real → Complex) z‖ ^ (2 : ℕ)
  let L : Real := B * Real.sqrt (∑ n ∈ indices, a n ^ (2 : ℕ)) * A
  have houtmeas : AEStronglyMeasurable out volume := by
    dsimp only [out]
    exact aux_aestronglyMeasurable_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtintegrable : Integrable (fun z : WaveSpaceTime => ‖out z‖ ^ (2 : ℕ)) volume := by
    dsimp only [out]
    exact aux_integrable_norm_sq_verticalRecombined_verticalSeparablePackets_of_profiles
      β scale indices m g hprofile F
  have houtmem : MemLp out 2 volume :=
    (memLp_two_iff_integrable_sq_norm houtmeas).mpr houtintegrable
  have hraw : (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) ≤ C * E := by
    dsimp only [out, E]
    exact
      integral_norm_sq_vertRecomb_vertSepblPkts_le_sum_inputEnergy_of_schw_profiles
        β scale indices m g hprofile hoverlap F
  have htwo : eLpNorm out (2 : ENNReal) volume ≤
      ENNReal.ofReal (Real.sqrt (C * E)) := by
    rw [houtmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    apply ENNReal.ofReal_le_ofReal
    calc
      (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : Real)) ^ (2 : Real)⁻¹ =
          Real.sqrt (∫ z : WaveSpaceTime, ‖out z‖ ^ (2 : ℕ)) := by
        rw [Real.sqrt_eq_rpow]
        congr 1
        · apply integral_congr_ae
          filter_upwards with z
          exact Real.rpow_two _
        · norm_num
      _ ≤ Real.sqrt (C * E) := Real.sqrt_le_sqrt hraw
  have htop : eLpNorm out ⊤ volume ≤ ENNReal.ofReal L := by
    rw [eLpNorm_exponent_top houtmem.aestronglyMeasurable]
    apply eLpNormEssSup_le_of_ae_bound
    filter_upwards with z
    dsimp only [out, L]
    exact
      norm_vertRecomb_vertSepblPkts_le_of_schw_profs_of_comm_time_ker_and_spat_env
        β scale indices m g hprofile F κ a hA hκ hκbound hkernel hspatial z
  have hinterp := eLpNorm_four_rpow_two_le_two_mul_top out houtmeas
  change (eLpNorm out (4 : ENNReal) volume) ^ (2 : Real) ≤
    ENNReal.ofReal (Real.sqrt (C * E)) * ENNReal.ofReal L
  exact hinterp.trans (mul_le_mul htwo htop bot_le (by simp))

/-- The literal radial--time reconstruction is the vertical recombination of
its conic radial pieces.  This identifies the finite-packet-to-continuum
vertical estimate with the reconstruction term used by the MSS decomposition. -/
theorem radialTimeReconstruction_eq_verticalRecombined
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (scale : Real) (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      verticalRecombined verticalCutoff scale (indices scale)
        (fun n => verticalProjection verticalCutoff scale n
          (conicOperator scale a ϑ (radialPiece radialCutoff scale n f))) := rfl

/-- The honest finite-family Minkowski estimate for vertical recombination.
It makes no claim about the norm of a vertical projection; those individual
measurability hypotheses are kept explicit. -/
theorem eLpNorm_verticalRecombined_le_sum
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume =
        eLpNorm (∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n)) p volume := by
      apply eLpNorm_congr_ae
      filter_upwards with z
      simp [verticalRecombined]
    _ ≤ ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_sum_le hp

/-- If every vertical projection has a common `Lᵖ` bound, finite
recombination costs at most the cardinality of its index family. -/
theorem eLpNorm_verticalRecombined_le_card_nsmul_of_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ indices,
      AEStronglyMeasurable (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ indices,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
      indices.card • B := by
  calc
    eLpNorm (verticalRecombined verticalCutoff scale indices H) p volume ≤
        ∑ n ∈ indices, eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume :=
      eLpNorm_verticalRecombined_le_sum verticalCutoff scale indices H p hmeas hp
    _ ≤ ∑ _n ∈ indices, B :=
      Finset.sum_le_sum fun n hn => hbound n hn
    _ = indices.card • B := by simp

/-- Applying the finite Minkowski estimate to the explicit relevant radial
family gives a completely concrete scale-dependent finite count. -/
theorem eLpNorm_verticalRecombined_relevantRadialIndexEnumeration_le_of_bound
    (verticalCutoff : Real → Complex) (scale : Real)
    (H : Int → WaveSpaceTime → Complex) (p B : ENNReal)
    (hmeas : ∀ n ∈ relevantRadialIndexEnumeration scale,
      AEStronglyMeasurable
        (verticalProjection verticalCutoff scale n (H n)) volume)
    (hp : 1 ≤ p)
    (hbound : ∀ n ∈ relevantRadialIndexEnumeration scale,
      eLpNorm (verticalProjection verticalCutoff scale n (H n)) p volume ≤ B) :
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤
      (2 * ⌈Real.sqrt scale⌉₊ + 7) • B := by
  calc
    eLpNorm
        (verticalRecombined verticalCutoff scale (relevantRadialIndexEnumeration scale) H)
        p volume ≤ (relevantRadialIndexEnumeration scale).card • B :=
      eLpNorm_verticalRecombined_le_card_nsmul_of_bound verticalCutoff scale
        (relevantRadialIndexEnumeration scale) H p B hmeas hp hbound
    _ ≤ (2 * ⌈Real.sqrt scale⌉₊ + 7) • B :=
      nsmul_le_nsmul_left (by positivity : 0 ≤ B)
        (card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale)

/-- A pointwise-envelope form of the finite recombination estimate. -/
theorem norm_verticalRecombined_le_card_nsmul_of_pointwise_bound
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex) (B : WaveSpaceTime → Real)
    (hbound : ∀ n ∈ indices, ∀ z : WaveSpaceTime,
      ‖verticalProjection verticalCutoff scale n (H n) z‖ ≤ B z)
    (z : WaveSpaceTime) :
    ‖verticalRecombined verticalCutoff scale indices H z‖ ≤ indices.card • B z := by
  calc
    ‖verticalRecombined verticalCutoff scale indices H z‖ =
        ‖∑ n ∈ indices, verticalProjection verticalCutoff scale n (H n) z‖ := rfl
    _ ≤ ∑ n ∈ indices, ‖verticalProjection verticalCutoff scale n (H n) z‖ :=
      norm_sum_le _ _
    _ ≤ ∑ _n ∈ indices, B z :=
      Finset.sum_le_sum fun n hn => hbound n hn z
    _ = indices.card • B z := by simp

/-- The exponent supplied by vertical recombination.  The `∞` branch is the
endpoint exponent `1/4`; the other branch is the finite-`Lp` formula. -/
def verticalRecombinationGain (p : ENNReal) : Real :=
  if p = ⊤ then 1 / 4 else 1 / 4 - 1 / (2 * p.toReal)

/-- A compactly supported smooth vertical cutoff in the literal blueprint
form.  The pointwise support condition is exactly what the finite-overlap and
vertical-recombination arguments consume. -/
structure MSSVerticalCutoff where
  cutoff : SchwartzMap Real Complex
  support : ∀ s : Real, cutoff s ≠ 0 → |s| < 1

/-- The vertical member of the radial--time cutoff data has exactly the
support required for vertical recombination. -/
def MSSRadialTimeCutoffs.toMSSVerticalCutoff
    (D : MSSRadialTimeCutoffs) : MSSVerticalCutoff where
  cutoff := D.vertical
  support := D.vertical_support

/-- The vertical recombination target on finite joint-Schwartz families,
including both the finite and `L∞` exponents. -/
def verticalRecombination (B : MSSVerticalCutoff) : Prop :=
  ∀ (p : ENNReal) (C₀ : Real), ENNReal.ofReal 2 ≤ p → 0 < C₀ →
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 2 ≤ scale →
      ∀ indices : Finset Int,
        (indices.card : Real) ≤ C₀ * Real.sqrt scale →
        ∀ H : Int → SchwartzMap JointWaveSpaceTime Complex,
          eLpNorm (verticalRecombined (B.cutoff : Real → Complex) scale indices
            (fun n => jointSchwartzRaw (H n))) p volume ≤
            ENNReal.ofReal (C * scale ^ verticalRecombinationGain p) *
              eLpNorm (verticalSquareFunction indices
                (fun n => jointSchwartzRaw (H n))) p volume

/-- A literal `L⁴` finite-packet-to-continuum transfer for vertical
recombination.  Each `packets k` is an actual family of space--time
functions, rather than an abstract finite-model output.  Thus a concrete
packet construction can supply its uniform finite-packet estimate and the
two displayed `L⁴` convergences, and this theorem closes the passage to the
literal Fourier-multiplier recombination.

This does not assert that such a packet construction exists.  To use it for
the MSS proof, one still has to construct finite measurable packet families
representing `verticalProjection`, prove their uniform vector-valued `L⁴`
bound (via a genuine `L²`--`L∞` analytic interpolation datum, not the
counting-measure proxy), and establish both convergences below. -/
theorem eLpNorm_verticalRecombined_le_of_tendsto_eLpNorm
    (verticalCutoff : Real → Complex) (scale : Real) (indices : Finset Int)
    (H : Int → WaveSpaceTime → Complex)
    (packets : Nat → Int → WaveSpaceTime → Complex) (A : ENNReal) (hA : A ≠ ∞)
    (houtput_meas : AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices H) volume)
    (hpacket_output_meas : ∀ k, AEStronglyMeasurable
      (verticalRecombined verticalCutoff scale indices (packets k)) volume)
    (hsquare_meas : AEStronglyMeasurable (verticalSquareFunction indices H) volume)
    (hpacket_square_meas : ∀ k, AEStronglyMeasurable
      (verticalSquareFunction indices (packets k)) volume)
    (hpacket_bound : ∀ k,
      eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
          (4 : ENNReal) volume ≤
        A * eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume)
    (houtput_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalRecombined verticalCutoff scale indices (packets k) -
          verticalRecombined verticalCutoff scale indices H)
        (4 : ENNReal) volume) atTop (𝓝 0))
    (hsquare_tendsto : Tendsto (fun k =>
      eLpNorm
        (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
        (4 : ENNReal) volume) atTop (𝓝 0)) :
    eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
      A * eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
  let P : ENNReal := eLpNorm
    (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume
  let S : ENNReal := eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume
  let eout : Nat → ENNReal := fun k => eLpNorm
    (verticalRecombined verticalCutoff scale indices (packets k) -
      verticalRecombined verticalCutoff scale indices H)
    (4 : ENNReal) volume
  let esq : Nat → ENNReal := fun k => eLpNorm
    (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
    (4 : ENNReal) volume
  have hp : (1 : ENNReal) ≤ (4 : ENNReal) := by norm_num
  have hpoint : ∀ k, P ≤ eout k + A * (esq k + S) := by
    intro k
    dsimp only [P, eout, esq, S]
    have houtput_triangle :
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
      calc
        eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume =
            eLpNorm
              ((verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k)) +
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          congr 1
          ext z
          simp
        _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices H -
                verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume :=
          eLpNorm_add_le hp
        _ = eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := by
          have hneg :
              verticalRecombined verticalCutoff scale indices H -
                  verticalRecombined verticalCutoff scale indices (packets k) =
                -(verticalRecombined verticalCutoff scale indices (packets k) -
                  verticalRecombined verticalCutoff scale indices H) := by
            ext z
            simp
          rw [hneg, eLpNorm_neg]
    calc
      eLpNorm (verticalRecombined verticalCutoff scale indices H) (4 : ENNReal) volume ≤
          eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            eLpNorm (verticalRecombined verticalCutoff scale indices (packets k))
              (4 : ENNReal) volume := houtput_triangle
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * eLpNorm (verticalSquareFunction indices (packets k))
              (4 : ENNReal) volume := by
        gcongr
        exact hpacket_bound k
      _ ≤ eLpNorm
              (verticalRecombined verticalCutoff scale indices (packets k) -
                verticalRecombined verticalCutoff scale indices H)
              (4 : ENNReal) volume +
            A * (eLpNorm
              (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
              (4 : ENNReal) volume +
              eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume) := by
        gcongr
        have hsquare_triangle :
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume ≤
              eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume := by
          calc
            eLpNorm (verticalSquareFunction indices (packets k)) (4 : ENNReal) volume =
                eLpNorm
                  ((verticalSquareFunction indices (packets k) - verticalSquareFunction indices H) +
                    verticalSquareFunction indices H)
                  (4 : ENNReal) volume := by
              congr 1
              ext z
              simp
            _ ≤ eLpNorm
                  (verticalSquareFunction indices (packets k) - verticalSquareFunction indices H)
                  (4 : ENNReal) volume +
                eLpNorm (verticalSquareFunction indices H) (4 : ENNReal) volume :=
              eLpNorm_add_le hp
        exact hsquare_triangle
  have heout : Tendsto eout atTop (𝓝 0) := by
    simpa only [eout] using houtput_tendsto
  have hesq : Tendsto esq atTop (𝓝 0) := by
    simpa only [esq] using hsquare_tendsto
  have hright : Tendsto (fun k => eout k + A * (esq k + S)) atTop (𝓝 (A * S)) := by
    have hsq_plus : Tendsto (fun k => esq k + S) atTop (𝓝 (0 + S)) :=
      hesq.add (tendsto_const_nhds : Tendsto (fun _ : Nat => S) atTop (𝓝 S))
    have hmul : Tendsto (fun k => A * (esq k + S)) atTop (𝓝 (A * (0 + S))) :=
      ENNReal.Tendsto.const_mul hsq_plus (Or.inr hA)
    simpa using heout.add hmul
  have hle : P ≤ A * S := ge_of_tendsto hright (Eventually.of_forall hpoint)
  simpa only [P, S] using hle


end
end Auto.Spherical.MSS
end Auto.Spherical.MSS
