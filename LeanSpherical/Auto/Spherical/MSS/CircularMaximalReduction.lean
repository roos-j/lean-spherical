        ∑ k ∈ Finset.range n,
          (2 * δ⁻¹ * (∫ t in u k..u (k + 1), ‖F t‖ ^ 2) +
            2 * δ * (∫ t in u k..u (k + 1), ‖F' t‖ ^ 2)) := hsum
    _ = 2 * δ⁻¹ *
          (∑ k ∈ Finset.range n, ∫ t in u k..u (k + 1), ‖F t‖ ^ 2) +
        2 * δ *
          (∑ k ∈ Finset.range n, ∫ t in u k..u (k + 1), ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ = 2 * δ⁻¹ * (∫ t in (1 : ℝ)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : ℝ)..2, ‖F' t‖ ^ 2) := by
      rw [hsumF, hsumF', hu0, hun]

/-- Summing nonnegative interval integrals over a finite pairwise-disjoint
family of time cells never costs more than the integral over the ambient
unit time block.  The half-open cells make the disjointness hypothesis exact
even when consecutive cells share an endpoint. -/
theorem aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
    {ι : Type*} (s : Finset ι) (a b : ι → Real) {G : Real → Real}
    (hG : Continuous G) (hG_nonneg : ∀ t, 0 ≤ G t)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i)))) :
    (∑ i ∈ s, ∫ t in a i..b i, G t) ≤ ∫ t in (1 : Real)..2, G t := by
  have hmeas : ∀ i ∈ s, MeasurableSet (Ioc (a i) (b i)) := by
    intro i hi
    exact measurableSet_Ioc
  have hint : ∀ i ∈ s, IntegrableOn G (Ioc (a i) (b i)) volume := by
    intro i hi
    exact hG.integrableOn_Ioc
  have hfull : IntegrableOn G (Ioc (1 : Real) 2) volume :=
    hG.integrableOn_Ioc
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc (1 : Real) 2)] G :=
    Filter.Eventually.of_forall fun t => hG_nonneg t
  have hunion : (⋃ i ∈ s, Ioc (a i) (b i)) ⊆ Ioc (1 : Real) 2 := by
    intro t ht
    rcases Set.mem_iUnion.mp ht with ⟨i, ht⟩
    rcases Set.mem_iUnion.mp ht with ⟨hi, ht⟩
    exact hcontained i hi ht
  calc
    (∑ i ∈ s, ∫ t in a i..b i, G t) =
        ∑ i ∈ s, ∫ t in Ioc (a i) (b i), G t := by
      apply Finset.sum_congr rfl
      intro i hi
      rw [intervalIntegral.integral_of_le (hab i hi)]
    _ = ∫ t in ⋃ i ∈ s, Ioc (a i) (b i), G t := by
      symm
      exact integral_biUnion_finset s hmeas hdisjoint hint
    _ ≤ ∫ t in Ioc (1 : Real) 2, G t :=
      setIntegral_mono_set hfull hnonneg hunion.eventuallyLE
    _ = ∫ t in (1 : Real)..2, G t := by
      rw [intervalIntegral.integral_of_le (by norm_num)]

/-- Discrete `L²` time sampling for any finite family of disjoint time
cells.  This is the exact analytic summation step used for a separated set
once its points have been assigned bounded-overlap cells; disjoint cells are
the overlap-one special case. -/
theorem timeSamplingL2_of_pairwiseDisjointIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i) (hlength : ∀ i ∈ s, b i - a i = δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
      2 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 2 ≤
        2 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
          2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      simpa [hlength i hi] using hδ
    simpa only [hlength i hi] using
      timeSobolevL2 hpos (hsample i hi) hF hF' hderiv
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hFnonneg : 0 ≤ ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  have hF'nonneg : 0 ≤ ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 :=
    intervalIntegral.integral_nonneg (by norm_num) fun _ _ => sq_nonneg _
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
        ∑ i ∈ s,
          (2 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2)) := hsum
    _ = 2 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) +
        2 * δ * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 2 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
      gcongr

/-- The same sampling estimate for cells with lengths in `[δ / 2, δ]`.
This is the form stable under clipping the radius-`δ / 2` cells at the two
endpoints of `[1,2]`. -/
theorem timeSamplingL2_of_pairwiseDisjointComparableIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength_lower : ∀ i ∈ s, δ / 2 ≤ b i - a i)
    (hlength_upper : ∀ i ∈ s, b i - a i ≤ δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
      4 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 2 ≤
        4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
          2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      exact lt_of_lt_of_le (by linarith [hδ]) (hlength_lower i hi)
    have hlength_pos : 0 < b i - a i := sub_pos.mpr hpos
    have hinv : (b i - a i)⁻¹ ≤ (δ / 2)⁻¹ := by
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by linarith [hδ]) (hlength_lower i hi))
    have hcoeff : 2 * (b i - a i)⁻¹ ≤ 4 * δ⁻¹ := by
      calc
        2 * (b i - a i)⁻¹ ≤ 2 * (δ / 2)⁻¹ :=
          mul_le_mul_of_nonneg_left hinv (by norm_num)
        _ = 4 * δ⁻¹ := by
          field_simp [ne_of_gt hδ] ; ring
    have hIFn : 0 ≤ ∫ t in a i..b i, ‖F t‖ ^ 2 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => sq_nonneg _
    have hI'n : 0 ≤ ∫ t in a i..b i, ‖F' t‖ ^ 2 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => sq_nonneg _
    calc
      ‖F (sample i)‖ ^ 2 ≤
          2 * (b i - a i)⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * (b i - a i) * (∫ t in a i..b i, ‖F' t‖ ^ 2) :=
        timeSobolevL2 hpos (hsample i hi) hF hF' hderiv
      _ ≤ 4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2) := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right hcoeff hIFn
        · apply mul_le_mul_of_nonneg_right _ hI'n
          exact mul_le_mul_of_nonneg_left (hlength_upper i hi) (by norm_num)
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 2 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 2) (fun t => sq_nonneg _)
        hab hcontained hdisjoint)
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 2) ≤
        ∑ i ∈ s,
          (4 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 2) +
            2 * δ * (∫ t in a i..b i, ‖F' t‖ ^ 2)) := hsum
    _ = 4 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 2) +
        2 * δ * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 2) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 4 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * δ * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
      gcongr

/-- The `L²` separated-time sampling estimate for the actual finite time
sets in the MSS statement.  Each selected time receives its clipped
radius-`2^{-j-1}` cell.  Separation makes the half-open cells disjoint, and
the endpoint clipping leaves every cell between half and one mesh long. -/
theorem timeSamplingL2_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ t ∈ T, ‖F t‖ ^ 2) ≤
      4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t‖ ^ 2) := by
  rcases hT with ⟨hTmem, hTsep, hTcover⟩
  let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
  let a : Real → Real := fun t => max 1 (t - δ / 2)
  let b : Real → Real := fun t => min 2 (t + δ / 2)
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hδone : δ ≤ 1 := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    apply zpow_le_one_of_nonpos₀
    · norm_num
    · omega
  have hab : ∀ t ∈ T, a t ≤ b t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ min 2 (t + δ / 2)
    apply max_le
    · apply le_min
      · norm_num
      · nlinarith [htI.1, hδ]
    · apply le_min
      · nlinarith [htI.2, hδ]
      · nlinarith [htI.1, htI.2, hδone]
  have hlength_lower : ∀ t ∈ T, δ / 2 ≤ b t - a t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change δ / 2 ≤ min 2 (t + δ / 2) - max 1 (t - δ / 2)
    by_cases hleft : 1 ≤ t - δ / 2
    · by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_right hleft, min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_right hleft, min_eq_left hright']
        linarith [htI.1, htI.2]
    · have hleft' : t - δ / 2 ≤ 1 := le_of_lt (lt_of_not_ge hleft)
      by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_left hleft', min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_left hleft', min_eq_left hright']
        linarith [htI.1, htI.2]
  have hlength_upper : ∀ t ∈ T, b t - a t ≤ δ := by
    intro t ht
    change min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤ δ
    calc
      min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤
          (t + δ / 2) - (t - δ / 2) :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = δ := by ring
  have hsample : ∀ t ∈ T, t ∈ Icc (a t) (b t) := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ t ∧ t ≤ min 2 (t + δ / 2)
    constructor
    · exact max_le htI.1 (by linarith)
    · exact le_min htI.2 (by linarith)
  have hcontained : ∀ t ∈ T, Ioc (a t) (b t) ⊆ Ioc (1 : Real) 2 := by
    intro t ht u hu
    change 1 < u ∧ u ≤ 2
    change max 1 (t - δ / 2) < u ∧ u ≤ min 2 (t + δ / 2) at hu
    exact ⟨lt_of_le_of_lt (le_max_left _ _) hu.1, hu.2.trans (min_le_left _ _)⟩
  have hdisjoint : Set.Pairwise (↑T)
      (Function.onFun Disjoint fun t => Ioc (a t) (b t)) := by
    intro s hs t ht hst
    change Disjoint (Ioc (a s) (b s)) (Ioc (a t) (b t))
    rcases lt_or_gt_of_ne hst with hstlt | htslt
    · apply Ioc_disjoint_Ioc_of_le
      change min 2 (s + δ / 2) ≤ max 1 (t - δ / 2)
      calc
        min 2 (s + δ / 2) ≤ s + δ / 2 := min_le_right _ _
        _ ≤ t - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonpos (by linarith)] at hsep
          linarith
        _ ≤ max 1 (t - δ / 2) := le_max_right _ _
    · apply Disjoint.symm
      apply Ioc_disjoint_Ioc_of_le
      change min 2 (t + δ / 2) ≤ max 1 (s - δ / 2)
      calc
        min 2 (t + δ / 2) ≤ t + δ / 2 := min_le_right _ _
        _ ≤ s - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonneg (by linarith)] at hsep
          linarith
        _ ≤ max 1 (s - δ / 2) := le_max_right _ _
  simpa only [δ] using
    (timeSamplingL2_of_pairwiseDisjointComparableIntervals
      (s := T) (a := a) (b := b) (sample := fun t => t) hδ
      hab hlength_lower hlength_upper hsample hcontained hdisjoint hF hF' hderiv)

/-- The clipped time cells used above give the elementary packing bound for
an MSS maximal separated set.  Applying the sampling estimate to the
constant scalar function avoids any separate interval-packing argument. -/
theorem aux_card_le_four_inv_dyadicTimeScale_of_MSS_MaximalSeparated
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T) :
    (T.card : Real) ≤ 4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ := by
  have h := timeSamplingL2_of_MSS_MaximalSeparated
    (E := Real) (F := fun _ : Real => (1 : Real)) (F' := fun _ : Real => (0 : Real))
    j T hT continuous_const continuous_const
    (fun t => by simpa using (hasDerivAt_const (x := t) (c := (1 : Real))))
  norm_num [intervalIntegral.integral_const] at h ⊢
  simpa using h

/-- The fixed-time Plancherel endpoint and the preceding packing bound give
the actual separated-time `L²` baseline for a frequency-localized MSS
half-wave.  Its reciprocal-mesh loss is explicit; this deliberately does not
claim the positive local-smoothing gain needed for Bourgain's summation. -/
theorem aux_dyadicHalfWave_separatedSamplingL2
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (T : Finset Real) (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∑ t ∈ T, ∫ x : Euclidean 2,
      ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) ≤
      16 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  have hcard :
      (T.card : Real) ≤ 4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ :=
    aux_card_le_four_inv_dyadicTimeScale_of_MSS_MaximalSeparated j T hT
  have hI : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (∑ t ∈ T, ∫ x : Euclidean 2,
        ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 2) ≤
        ∑ _t ∈ T, 4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro t ht
      exact _root_.Auto.Spherical.MSS.fixedTimeL2Endpoint C σ j t f
    _ = (T.card : Real) * (4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
      simp [nsmul_eq_mul]
    _ ≤ (4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹) *
        (4 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg (by norm_num) hI)
    _ = 16 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- Spatially integrated `L²` time Sobolev control.  The product
integrability hypothesis is exactly the Fubini condition needed to exchange
the time interval integral and the spatial integral.  This is the
dimension-generic, finite-exponent part of the blueprint's space-time
corollary; no all-`p` assertion is made here. -/
theorem timeSobolevL2_spacetime
    {d : Nat} {F F' : Real → Euclidean d → Complex} {a b r : Real}
    (hr : r ∈ Icc a b)
    (hFr_meas : AEStronglyMeasurable (F r) volume)
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFa : Integrable (fun x => ‖F a x‖ ^ 2) volume)
    (hF' : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc a b)).prod volume)) :
    (∫ x : Euclidean d, ‖F r x‖ ^ 2) ≤
      2 * (∫ x : Euclidean d, ‖F a x‖ ^ 2) +
        2 * (b - a) * (∫ t in a..b, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) :=
  _root_.Auto.Spherical.Auxiliary.integral_norm_sq_radius_le_of_hasDerivAt
    hr hFr_meas hF'_cont hderiv hFa hF'

/-- Spatially integrated `L⁴` time Sobolev control on the unit slab.  This
is the quartic companion to `timeSobolevL2_spacetime`: it applies the proved
one-dimensional `timeSobolevFour_unit` pointwise and uses Fubini only under
explicit product-integrability hypotheses. -/
theorem timeSobolevFour_spacetime
    {d : Nat} {F F' : Real → Euclidean d → Complex} {r : Real}
    (hr : r ∈ Icc (1 : Real) 2)
    (hFr : Integrable (fun x : Euclidean d => ‖F r x‖ ^ 4) volume)
    (hF_cont : ∀ x, Continuous (fun t => F t x))
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    (∫ x : Euclidean d, ‖F r x‖ ^ 4) ≤
      8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hright : Integrable (fun x : Euclidean d =>
      8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)) volume := by
    exact (hFinner.const_mul 8).add (hF'inner.const_mul 8)
  have hpoint (x : Euclidean d) : ‖F r x‖ ^ 4 ≤
      8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
        8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) :=
    timeSobolevFour_unit hr (hF_cont x) (hF'_cont x) (fun t => hderiv t x)
  have hFswap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hF'swap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫ x : Euclidean d, ‖F r x‖ ^ 4) ≤ ∫ x : Euclidean d,
        8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      apply integral_mono_ae hFr hright
      exact Filter.Eventually.of_forall hpoint
    _ = 8 * (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          8 * (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) := by
      rw [MeasureTheory.integral_add (hFinner.const_mul 8) (hF'inner.const_mul 8),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    _ = _ := by rw [hFswap, hF'swap]

/-- The measurable compact-time `L⁴` maximal form of
`timeSobolevFour_spacetime`.  Unlike a formal exchange of a supremum and an
integral, this proves measurability directly from joint continuity and then
integrates the pointwise quartic Sobolev estimate. -/
theorem measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSobolev
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ∧
      (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal
          (8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
            8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hmaxmeas : Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
    have hG : Measurable (⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
        ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
      apply measurable_iSup_of_lowerSemicontinuous
      · intro r
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_const.prodMk continuous_id)).norm.pow 4)).measurable
      · intro x
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 4)).lowerSemicontinuous
    have hEq : (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4) := by
      funext x
      exact (iSup_apply
        (f := fun r : Icc (1 : Real) 2 => fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4)) (a := x)).symm
    rw [hEq]
    exact hG
  refine ⟨hmaxmeas, ?_⟩
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let R : Euclidean d → Real := fun x =>
    8 * (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
      8 * (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)
  have hRint : Integrable R volume := by
    exact (hFinner.const_mul 8).add (hF'inner.const_mul 8)
  have hRnonneg (x : Euclidean d) : 0 ≤ R x := by
    dsimp only [R]
    apply add_nonneg
    · exact mul_nonneg (by norm_num)
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => pow_nonneg (norm_nonneg _) _)
    · exact mul_nonneg (by norm_num)
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ => pow_nonneg (norm_nonneg _) _)
  have hpoint (x : Euclidean d) :
      (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal (R x) := by
    apply iSup_le
    intro r
    exact ENNReal.ofReal_le_ofReal
      (timeSobolevFour_unit r.2
        (hF.comp (continuous_id.prodMk
          (continuous_const : Continuous fun _ : Real => x)))
        (hF'.comp (continuous_id.prodMk
          (continuous_const : Continuous fun _ : Real => x)))
        (fun t => hderiv t x))
  have hswapF :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hswapF' :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ∫⁻ x : Euclidean d, ENNReal.ofReal (R x) := by
      exact lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean d, R x) := by
      symm
      exact ofReal_integral_eq_lintegral_ofReal hRint
        (Filter.Eventually.of_forall hRnonneg)
    _ = ENNReal.ofReal
        (8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
          8 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
      congr 1
      dsimp only [R]
      rw [MeasureTheory.integral_add (hFinner.const_mul 8) (hF'inner.const_mul 8),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        hswapF, hswapF']

/-- The scale-sensitive fourth-power one-dimensional Sobolev estimate.  On
an interval of length `b - a`, the derivative contribution carries the
correct cubic length factor. -/
theorem timeSobolevFour
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} {a b r : Real} (hab : a < b) (hr : r ∈ Icc a b)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    ‖F r‖ ^ 4 ≤
      8 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 4) +
        8 * (b - a) ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
  let G : Real → Real := fun t => ‖F t‖ ^ 4
  have hG : Continuous G := (continuous_norm.comp hF).pow 4
  obtain ⟨c, hc, hcmean⟩ :=
    exists_eq_const_mul_intervalIntegral_of_nonneg (μ := volume)
      hG.continuousOn
      (intervalIntegrable_const : IntervalIntegrable (fun _ : Real => (1 : Real)) volume a b)
      (by intro _ _; positivity)
  have hc' : c ∈ Icc a b := by
    simpa only [uIcc_of_le hab.le] using hc
  have hlen : b - a ≠ 0 := sub_ne_zero.mpr hab.ne'
  have hcvalue : ‖F c‖ ^ 4 = (∫ t in a..b, ‖F t‖ ^ 4) / (b - a) := by
    apply (eq_div_iff hlen).mpr
    simpa [G, mul_comm] using hcmean.symm
  have hnorm := norm_le_norm_add_timeDerivativeIntegral hc' hr hF' hderiv
  let B : Real := ∫ t in a..b, ‖F' t‖
  have hB : 0 ≤ B := by
    dsimp [B]
    exact intervalIntegral.integral_nonneg hab.le fun _ _ => norm_nonneg _
  have hA : 0 ≤ ‖F c‖ := norm_nonneg _
  have hpow : ‖F r‖ ^ 4 ≤ (‖F c‖ + B) ^ 4 := by
    exact pow_le_pow_left₀ (norm_nonneg _) hnorm 4
  have hadd : (‖F c‖ + B) ^ 4 ≤ 8 * (‖F c‖ ^ 4 + B ^ 4) := by
    calc
      (‖F c‖ + B) ^ 4 ≤ 2 ^ (4 - 1) * (‖F c‖ ^ 4 + B ^ 4) :=
        add_pow_le hA hB 4
      _ = 8 * (‖F c‖ ^ 4 + B ^ 4) := by norm_num
  have hcs1 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := F') (a := a) (b := b) hab.le hF'
  have hcs1' : B ^ 2 ≤ (b - a) * ∫ t in a..b, ‖F' t‖ ^ 2 := by
    calc
      B ^ 2 = (∫ t in a..b, ‖F' t‖) ^ 2 := by rfl
      _ ≤ (b - a) * ∫ t in a..b, ‖F' t‖ ^ 2 := hcs1
  have hF'sq : Continuous (fun t : Real => ‖F' t‖ ^ 2) :=
    (continuous_norm.comp hF').pow 2
  have hcs2 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := fun t : Real => ‖F' t‖ ^ 2) (a := a) (b := b) hab.le hF'sq
  have hnormsq (t : Real) : ‖‖F' t‖ ^ 2‖ = ‖F' t‖ ^ 2 :=
    Real.norm_of_nonneg (sq_nonneg _)
  have hcs2raw : (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, (‖F' t‖ ^ 2) ^ 2 := by
    simpa only [hnormsq] using hcs2
  have hcs2' : (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖F' t‖ ^ 4 := by
    calc
      (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 ≤
          (b - a) * ∫ t in a..b, (‖F' t‖ ^ 2) ^ 2 := hcs2raw
      _ = _ := by
        congr 1
        apply intervalIntegral.integral_congr
        intro t _
        ring
  have hBfour : B ^ 4 ≤ (b - a) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
    calc
      B ^ 4 = (B ^ 2) ^ 2 := by ring
      _ ≤ ((b - a) * ∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 :=
        pow_le_pow_left₀ (sq_nonneg B) hcs1' 2
      _ = (b - a) ^ 2 * (∫ t in a..b, ‖F' t‖ ^ 2) ^ 2 := by ring
      _ ≤ (b - a) ^ 2 * ((b - a) * ∫ t in a..b, ‖F' t‖ ^ 4) := by
        exact mul_le_mul_of_nonneg_left hcs2' (sq_nonneg (b - a))
      _ = _ := by ring
  calc
    ‖F r‖ ^ 4 ≤ (‖F c‖ + B) ^ 4 := hpow
    _ ≤ 8 * (‖F c‖ ^ 4 + B ^ 4) := hadd
    _ ≤ 8 * (((∫ t in a..b, ‖F t‖ ^ 4) / (b - a)) +
        (b - a) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4) := by
      gcongr
      rw [hcvalue]
    _ = 8 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 4) +
        8 * (b - a) ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
      rw [div_eq_mul_inv]
      ring

/-- Fourth-power sampling on pairwise-disjoint time cells whose lengths are
between half a mesh and a full mesh. -/
theorem timeSamplingFour_of_pairwiseDisjointComparableIntervals
    {ι : Type*} {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    [CompleteSpace E] {F F' : Real → E}
    (s : Finset ι) (a b sample : ι → Real) {δ : Real} (hδ : 0 < δ)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength_lower : ∀ i ∈ s, δ / 2 ≤ b i - a i)
    (hlength_upper : ∀ i ∈ s, b i - a i ≤ δ)
    (hsample : ∀ i ∈ s, sample i ∈ Icc (a i) (b i))
    (hcontained : ∀ i ∈ s, Ioc (a i) (b i) ⊆ Ioc (1 : Real) 2)
    (hdisjoint : Set.Pairwise (↑s)
      (Function.onFun Disjoint (fun i => Ioc (a i) (b i))))
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ i ∈ s, ‖F (sample i)‖ ^ 4) ≤
      16 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
  have hlocal : ∀ i ∈ s,
      ‖F (sample i)‖ ^ 4 ≤
        16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
          8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) := by
    intro i hi
    have hpos : a i < b i := by
      rw [← sub_pos]
      exact lt_of_lt_of_le (by linarith [hδ]) (hlength_lower i hi)
    have hinv : (b i - a i)⁻¹ ≤ (δ / 2)⁻¹ := by
      simpa only [one_div] using
        (one_div_le_one_div_of_le (by linarith [hδ]) (hlength_lower i hi))
    have hcoeff0 : 8 * (b i - a i)⁻¹ ≤ 16 * δ⁻¹ := by
      calc
        8 * (b i - a i)⁻¹ ≤ 8 * (δ / 2)⁻¹ :=
          mul_le_mul_of_nonneg_left hinv (by norm_num)
        _ = 16 * δ⁻¹ := by
          field_simp [ne_of_gt hδ]
          ring
    have hcoeff1 : 8 * (b i - a i) ^ 3 ≤ 8 * δ ^ 3 := by
      apply mul_le_mul_of_nonneg_left _ (by norm_num)
      exact pow_le_pow_left₀ (sub_nonneg.mpr (hab i hi)) (hlength_upper i hi) 3
    have hIFn : 0 ≤ ∫ t in a i..b i, ‖F t‖ ^ 4 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => pow_nonneg (norm_nonneg _) _
    have hI'n : 0 ≤ ∫ t in a i..b i, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_nonneg hpos.le fun _ _ => pow_nonneg (norm_nonneg _) _
    calc
      ‖F (sample i)‖ ^ 4 ≤
          8 * (b i - a i)⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * (b i - a i) ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) :=
        timeSobolevFour hpos (hsample i hi) hF hF' hderiv
      _ ≤ 16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4) := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_right hcoeff0 hIFn
        · exact mul_le_mul_of_nonneg_right hcoeff1 hI'n
  have hsum := Finset.sum_le_sum fun i hi => hlocal i hi
  have hsumF : (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 4) ≤
      ∫ t in (1 : Real)..2, ‖F t‖ ^ 4 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF).pow 4) (fun t => pow_nonneg (norm_nonneg _) _)
        hab hcontained hdisjoint)
  have hsumF' : (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 4) ≤
      ∫ t in (1 : Real)..2, ‖F' t‖ ^ 4 := by
    simpa only [Pi.pow_apply, Function.comp_apply] using
      (aux_sum_intervalIntegral_le_intervalIntegral_of_pairwiseDisjoint
        s a b ((continuous_norm.comp hF').pow 4) (fun t => pow_nonneg (norm_nonneg _) _)
        hab hcontained hdisjoint)
  calc
    (∑ i ∈ s, ‖F (sample i)‖ ^ 4) ≤
        ∑ i ∈ s,
          (16 * δ⁻¹ * (∫ t in a i..b i, ‖F t‖ ^ 4) +
            8 * δ ^ 3 * (∫ t in a i..b i, ‖F' t‖ ^ 4)) := hsum
    _ = 16 * δ⁻¹ * (∑ i ∈ s, ∫ t in a i..b i, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∑ i ∈ s, ∫ t in a i..b i, ‖F' t‖ ^ 4) := by
      rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum]
    _ ≤ 16 * δ⁻¹ * (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * δ ^ 3 * (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
      gcongr

/-- The fourth-power separated-time sampling estimate for the finite time
families occurring in the MSS maximal statement. -/
theorem timeSamplingFour_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (∑ t ∈ T, ‖F t‖ ^ 4) ≤
      16 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
        8 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
          (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4) := by
  rcases hT with ⟨hTmem, hTsep, hTcover⟩
  let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
  let a : Real → Real := fun t => max 1 (t - δ / 2)
  let b : Real → Real := fun t => min 2 (t + δ / 2)
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hδone : δ ≤ 1 := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    apply zpow_le_one_of_nonpos₀
    · norm_num
    · omega
  have hab : ∀ t ∈ T, a t ≤ b t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ min 2 (t + δ / 2)
    apply max_le
    · apply le_min
      · norm_num
      · nlinarith [htI.1, hδ]
    · apply le_min
      · nlinarith [htI.2, hδ]
      · nlinarith [htI.1, htI.2, hδone]
  have hlength_lower : ∀ t ∈ T, δ / 2 ≤ b t - a t := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change δ / 2 ≤ min 2 (t + δ / 2) - max 1 (t - δ / 2)
    by_cases hleft : 1 ≤ t - δ / 2
    · by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_right hleft, min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_right hleft, min_eq_left hright']
        linarith [htI.1, htI.2]
    · have hleft' : t - δ / 2 ≤ 1 := le_of_lt (lt_of_not_ge hleft)
      by_cases hright : t + δ / 2 ≤ 2
      · rw [max_eq_left hleft', min_eq_right hright]
        linarith [htI.1, htI.2]
      · have hright' : 2 ≤ t + δ / 2 := le_of_lt (lt_of_not_ge hright)
        rw [max_eq_left hleft', min_eq_left hright']
        linarith [htI.1, htI.2]
  have hlength_upper : ∀ t ∈ T, b t - a t ≤ δ := by
    intro t ht
    change min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤ δ
    calc
      min 2 (t + δ / 2) - max 1 (t - δ / 2) ≤
          (t + δ / 2) - (t - δ / 2) :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = δ := by ring
  have hsample : ∀ t ∈ T, t ∈ Icc (a t) (b t) := by
    intro t ht
    have htI : t ∈ Icc (1 : Real) 2 := hTmem t ht
    change max 1 (t - δ / 2) ≤ t ∧ t ≤ min 2 (t + δ / 2)
    constructor
    · exact max_le htI.1 (by linarith)
    · exact le_min htI.2 (by linarith)
  have hcontained : ∀ t ∈ T, Ioc (a t) (b t) ⊆ Ioc (1 : Real) 2 := by
    intro t ht u hu
    change 1 < u ∧ u ≤ 2
    change max 1 (t - δ / 2) < u ∧ u ≤ min 2 (t + δ / 2) at hu
    exact ⟨lt_of_le_of_lt (le_max_left _ _) hu.1, hu.2.trans (min_le_left _ _)⟩
  have hdisjoint : Set.Pairwise (↑T)
      (Function.onFun Disjoint fun t => Ioc (a t) (b t)) := by
    intro s hs t ht hst
    change Disjoint (Ioc (a s) (b s)) (Ioc (a t) (b t))
    rcases lt_or_gt_of_ne hst with hstlt | htslt
    · apply Ioc_disjoint_Ioc_of_le
      change min 2 (s + δ / 2) ≤ max 1 (t - δ / 2)
      calc
        min 2 (s + δ / 2) ≤ s + δ / 2 := min_le_right _ _
        _ ≤ t - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonpos (by linarith)] at hsep
          linarith
        _ ≤ max 1 (t - δ / 2) := le_max_right _ _
    · apply Disjoint.symm
      apply Ioc_disjoint_Ioc_of_le
      change min 2 (t + δ / 2) ≤ max 1 (s - δ / 2)
      calc
        min 2 (t + δ / 2) ≤ t + δ / 2 := min_le_right _ _
        _ ≤ s - δ / 2 := by
          have hsep : δ ≤ |s - t| := hTsep hs ht hst
          rw [abs_of_nonneg (by linarith)] at hsep
          linarith
        _ ≤ max 1 (s - δ / 2) := le_max_right _ _
  simpa only [δ] using
    (timeSamplingFour_of_pairwiseDisjointComparableIntervals
      (s := T) (a := a) (b := b) (sample := fun t => t) hδ
      hab hlength_lower hlength_upper hsample hcontained hdisjoint hF hF' hderiv)

/-- The fourth-power Hölder bound for an interval integral. -/
theorem intervalIntegral_norm_pow_four_le
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {G : Real → E} {a b : Real} (hab : a ≤ b) (hG : Continuous G) :
    (∫ t in a..b, ‖G t‖) ^ 4 ≤
      (b - a) ^ 3 * ∫ t in a..b, ‖G t‖ ^ 4 := by
  let B : Real := ∫ t in a..b, ‖G t‖
  have hcs1 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := G) (a := a) (b := b) hab hG
  have hcs1' : B ^ 2 ≤ (b - a) * ∫ t in a..b, ‖G t‖ ^ 2 := by
    calc
      B ^ 2 = (∫ t in a..b, ‖G t‖) ^ 2 := by rfl
      _ ≤ (b - a) * ∫ t in a..b, ‖G t‖ ^ 2 := hcs1
  have hGsq : Continuous (fun t : Real => ‖G t‖ ^ 2) :=
    (continuous_norm.comp hG).pow 2
  have hcs2 :=
    _root_.Auto.Spherical.Auxiliary.intervalIntegral_norm_sq_le_length_mul_intervalIntegral_norm_sq
      (g := fun t : Real => ‖G t‖ ^ 2) (a := a) (b := b) hab hGsq
  have hnormsq (t : Real) : ‖‖G t‖ ^ 2‖ = ‖G t‖ ^ 2 :=
    Real.norm_of_nonneg (sq_nonneg _)
  have hcs2raw : (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, (‖G t‖ ^ 2) ^ 2 := by
    simpa only [hnormsq] using hcs2
  have hcs2' : (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
      (b - a) * ∫ t in a..b, ‖G t‖ ^ 4 := by
    calc
      (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 ≤
          (b - a) * ∫ t in a..b, (‖G t‖ ^ 2) ^ 2 := hcs2raw
      _ = _ := by
        congr 1
        apply intervalIntegral.integral_congr
        intro t _
        ring
  calc
    (∫ t in a..b, ‖G t‖) ^ 4 = B ^ 4 := by rfl
    _ = (B ^ 2) ^ 2 := by ring
    _ ≤ ((b - a) * ∫ t in a..b, ‖G t‖ ^ 2) ^ 2 :=
      pow_le_pow_left₀ (sq_nonneg B) hcs1' 2
    _ = (b - a) ^ 2 * (∫ t in a..b, ‖G t‖ ^ 2) ^ 2 := by ring
    _ ≤ (b - a) ^ 2 * ((b - a) * ∫ t in a..b, ‖G t‖ ^ 4) := by
      exact mul_le_mul_of_nonneg_left hcs2' (sq_nonneg (b - a))
    _ = _ := by ring

/-- Fourth-power control of a time increment by the fourth moment of its
time derivative over an ambient interval. -/
theorem norm_sub_pow_four_le_abs_sub_pow_three_mul_timeDerivativeEnergy
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} {a b r s : Real} (_hab : a ≤ b)
    (hr : r ∈ Icc a b) (hs : s ∈ Icc a b)
    (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    ‖F r - F s‖ ^ 4 ≤ |r - s| ^ 3 * (∫ t in a..b, ‖F' t‖ ^ 4) := by
  have hnonneg : 0 ≤ᵐ[volume.restrict (Ioc a b)] fun t => ‖F' t‖ ^ 4 :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hint : IntervalIntegrable (fun t => ‖F' t‖ ^ 4) volume a b :=
    ((continuous_norm.comp hF').pow 4).intervalIntegrable a b
  rcases le_total r s with hrs | hsr
  · have hftc : ∫ t in r..s, F' t = F s - F r := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable r s
    have hdiff : ‖F r - F s‖ ≤ ∫ t in r..s, ‖F' t‖ := by
      rw [norm_sub_rev, ← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hrs
    have hBfour := intervalIntegral_norm_pow_four_le (G := F') hrs hF'
    have hmono : (∫ t in r..s, ‖F' t‖ ^ 4) ≤ ∫ t in a..b, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_mono_interval hr.1 hrs hs.2 hnonneg hint
    have hpow : ‖F r - F s‖ ^ 4 ≤ (∫ t in r..s, ‖F' t‖) ^ 4 := by
      have hB : 0 ≤ ∫ t in r..s, ‖F' t‖ :=
        intervalIntegral.integral_nonneg hrs fun _ _ => norm_nonneg _
      exact pow_le_pow_left₀ (norm_nonneg _) hdiff 4
    calc
      ‖F r - F s‖ ^ 4 ≤ (∫ t in r..s, ‖F' t‖) ^ 4 := hpow
      _ ≤ (s - r) ^ 3 * ∫ t in r..s, ‖F' t‖ ^ 4 := hBfour
      _ ≤ (s - r) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        exact mul_le_mul_of_nonneg_left hmono (pow_nonneg (sub_nonneg.mpr hrs) _)
      _ = |r - s| ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        rw [abs_of_nonpos (sub_nonpos.mpr hrs)]
        ring
  · have hftc : ∫ t in s..r, F' t = F r - F s := by
      apply intervalIntegral.integral_eq_sub_of_hasDerivAt
      · intro t _
        exact hderiv t
      · exact hF'.intervalIntegrable s r
    have hdiff : ‖F r - F s‖ ≤ ∫ t in s..r, ‖F' t‖ := by
      rw [← hftc]
      exact intervalIntegral.norm_integral_le_integral_norm hsr
    have hBfour := intervalIntegral_norm_pow_four_le (G := F') hsr hF'
    have hmono : (∫ t in s..r, ‖F' t‖ ^ 4) ≤ ∫ t in a..b, ‖F' t‖ ^ 4 :=
      intervalIntegral.integral_mono_interval hs.1 hsr hr.2 hnonneg hint
    have hpow : ‖F r - F s‖ ^ 4 ≤ (∫ t in s..r, ‖F' t‖) ^ 4 := by
      have hB : 0 ≤ ∫ t in s..r, ‖F' t‖ :=
        intervalIntegral.integral_nonneg hsr fun _ _ => norm_nonneg _
      exact pow_le_pow_left₀ (norm_nonneg _) hdiff 4
    calc
      ‖F r - F s‖ ^ 4 ≤ (∫ t in s..r, ‖F' t‖) ^ 4 := hpow
      _ ≤ (r - s) ^ 3 * ∫ t in s..r, ‖F' t‖ ^ 4 := hBfour
      _ ≤ (r - s) ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        exact mul_le_mul_of_nonneg_left hmono (pow_nonneg (sub_nonneg.mpr hsr) _)
      _ = |r - s| ^ 3 * ∫ t in a..b, ‖F' t‖ ^ 4 := by
        rw [abs_of_nonneg (sub_nonneg.mpr hsr)]

/-- A finite MSS maximal-separated family reduces the genuine fourth-power
continuous time maximum to scale-sensitive fourth moments. -/
theorem timeSupremumFour_of_MSS_MaximalSeparated
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E] [CompleteSpace E]
    {F F' : Real → E} (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1‖ ^ 4)) ≤
      ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ‖F' t‖ ^ 4)) := by
  let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
  let A : Real := ∫ t in (1 : Real)..2, ‖F t‖ ^ 4
  let D : Real := ∫ t in (1 : Real)..2, ‖F' t‖ ^ 4
  let S : Real := ∑ t ∈ T, ‖F t‖ ^ 4
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hA : 0 ≤ A := by
    dsimp only [A]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
      pow_nonneg (norm_nonneg _) _
  have hD : 0 ≤ D := by
    dsimp only [D]
    exact intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
      pow_nonneg (norm_nonneg _) _
  have hsample : S ≤ 16 * δ⁻¹ * A + 8 * δ ^ 3 * D := by
    dsimp only [S, A, D, δ]
    exact timeSamplingFour_of_MSS_MaximalSeparated j T hT hF hF' hderiv
  have hcombined : 8 * S + 8 * δ ^ 3 * D ≤
      128 * δ⁻¹ * A + 72 * δ ^ 3 * D := by
    calc
      8 * S + 8 * δ ^ 3 * D ≤
          8 * (16 * δ⁻¹ * A + 8 * δ ^ 3 * D) + 8 * δ ^ 3 * D := by
        gcongr
      _ = 128 * δ⁻¹ * A + 72 * δ ^ 3 * D := by ring
  apply iSup_le
  intro r
  rcases hT.2.2 r r.2 with ⟨s, hs, hrs⟩
  have hinc : ‖F r.1 - F s‖ ^ 4 ≤ δ ^ 3 * D := by
    have h := norm_sub_pow_four_le_abs_sub_pow_three_mul_timeDerivativeEnergy
      (F := F) (F' := F') (a := (1 : Real)) (b := 2) (r := r.1) (s := s)
      (by norm_num) r.2 (hT.1 s hs) hF' hderiv
    calc
      ‖F r.1 - F s‖ ^ 4 ≤ |r.1 - s| ^ 3 * D := by
        simpa only [D] using h
      _ ≤ δ ^ 3 * D := by
        apply mul_le_mul_of_nonneg_right _ hD
        exact pow_le_pow_left₀ (abs_nonneg _) (le_of_lt hrs) 3
  have hnorm : ‖F r.1‖ ≤ ‖F r.1 - F s‖ + ‖F s‖ := by
    calc
      ‖F r.1‖ = ‖(F r.1 - F s) + F s‖ := by rw [sub_add_cancel]
      _ ≤ _ := norm_add_le _ _
  have hnormfour : ‖F r.1‖ ^ 4 ≤
      8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := by
    have hpow : ‖F r.1‖ ^ 4 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 4 :=
      pow_le_pow_left₀ (norm_nonneg _) hnorm 4
    calc
      ‖F r.1‖ ^ 4 ≤ (‖F r.1 - F s‖ + ‖F s‖) ^ 4 := hpow
      _ ≤ 2 ^ (4 - 1) * (‖F r.1 - F s‖ ^ 4 + ‖F s‖ ^ 4) :=
        add_pow_le (norm_nonneg _) (norm_nonneg _) 4
      _ = 8 * (‖F r.1 - F s‖ ^ 4 + ‖F s‖ ^ 4) := by norm_num
      _ = 8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := by ring
  have hsS : ‖F s‖ ^ 4 ≤ S := by
    dsimp only [S]
    exact Finset.single_le_sum (fun t _ => pow_nonneg (norm_nonneg _) _) hs
  have hpoint : ‖F r.1‖ ^ 4 ≤ 8 * S + 8 * δ ^ 3 * D := by
    calc
      ‖F r.1‖ ^ 4 ≤ 8 * ‖F s‖ ^ 4 + 8 * ‖F r.1 - F s‖ ^ 4 := hnormfour
      _ ≤ 8 * S + 8 * δ ^ 3 * D := by
        apply add_le_add
        · exact mul_le_mul_of_nonneg_left hsS (by norm_num)
        · calc
            8 * ‖F r.1 - F s‖ ^ 4 ≤ 8 * (δ ^ 3 * D) :=
              mul_le_mul_of_nonneg_left hinc (by norm_num)
            _ = 8 * δ ^ 3 * D := by ring
  exact ENNReal.ofReal_le_ofReal (hpoint.trans hcombined)

/-- The measurable product-space fourth-power form of scale-sensitive time
sampling.  The hypotheses make both the time maximum and its Fubini
interchange literal. -/
theorem measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSamplingL4
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ∧
      (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal
          (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
            72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
              (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hmaxmeas : Measurable (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
    have hG : Measurable (⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
        ENNReal.ofReal (‖F r.1 x‖ ^ 4)) := by
      apply measurable_iSup_of_lowerSemicontinuous
      · intro r
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_const.prodMk continuous_id)).norm.pow 4)).measurable
      · intro x
        exact (ENNReal.continuous_ofReal.comp
          ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm.pow 4)).lowerSemicontinuous
    have hEq : (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ⨆ r : Icc (1 : Real) 2, fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4) := by
      funext x
      exact (iSup_apply
        (f := fun r : Icc (1 : Real) 2 => fun x : Euclidean d =>
          ENNReal.ofReal (‖F r.1 x‖ ^ 4)) (a := x)).symm
    rw [hEq]
    exact hG
  refine ⟨hmaxmeas, ?_⟩
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 4 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let R : Euclidean d → Real := fun x =>
    128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
        (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
      72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
        (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4)
  have hRint : Integrable R volume := by
    exact (hFinner.const_mul
      (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3))
  have hRnonneg (x : Euclidean d) : 0 ≤ R x := by
    dsimp only [R]
    have hscale : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
      dsimp only [_root_.Auto.Spherical.MSS.dyadicTimeScale]
      exact zpow_pos (by norm_num) _
    apply add_nonneg
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (inv_nonneg.mpr hscale.le))
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
          pow_nonneg (norm_nonneg _) _)
    · exact mul_nonneg
        (mul_nonneg (by norm_num) (pow_nonneg hscale.le _))
        (intervalIntegral.integral_nonneg (by norm_num) fun _ _ =>
          pow_nonneg (norm_nonneg _) _)
  have hpoint (x : Euclidean d) :
      (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ENNReal.ofReal (R x) := by
    change (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
      ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4))
    exact timeSupremumFour_of_MSS_MaximalSeparated
      (F := fun t => F t x) (F' := fun t => F' t x) j T hT
      (hF.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (hF'.comp (continuous_id.prodMk
        (continuous_const : Continuous fun _ : Real => x)))
      (fun t => hderiv t x)
  have hswapF :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 4) hFuIoc).symm
  have hswapF' :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 4) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 4) hF'uIoc).symm
  calc
    (∫⁻ x : Euclidean d,
        ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ≤
        ∫⁻ x : Euclidean d, ENNReal.ofReal (R x) := by
      exact lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean d, R x) := by
      symm
      exact ofReal_integral_eq_lintegral_ofReal hRint
        (Filter.Eventually.of_forall hRnonneg)
    _ = ENNReal.ofReal
        (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
          72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3 *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4)) := by
      congr 1
      dsimp only [R]
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (128 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul
          (72 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ 3)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul,
        hswapF, hswapF']

/-- A measurable finite quartic lower-integral bound produces an `L⁴`
fourth-root function with the corresponding ordinary fourth-power integral
bound. -/
private theorem memLp_four_and_integral_norm_pow_four_of_measurable_lintegral
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (Q : α → ENNReal) (hQmeas : Measurable Q) {K : Real} (hK : 0 ≤ K)
    (hQlin : (∫⁻ x, Q x ∂μ) ≤ ENNReal.ofReal K) :
    MemLp (fun x => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 μ ∧
      (∫ x, ‖(Q x).toReal ^ ((4 : Real)⁻¹)‖ ^ 4 ∂μ) ≤ K := by
  let G : α → Real := fun x => (Q x).toReal ^ ((4 : Real)⁻¹)
  have hQfinite : (∫⁻ x, Q x ∂μ) ≠ ∞ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top hQlin
  have hQint : Integrable (fun x => (Q x).toReal) μ :=
    integrable_toReal_of_lintegral_ne_top hQmeas.aemeasurable hQfinite
  have hGmeas : AEStronglyMeasurable G μ := by
    exact ((Real.continuous_rpow_const (by positivity)).measurable.comp
      hQmeas.ennreal_toReal).aestronglyMeasurable
  have hGpow (x : α) : ‖G x‖ ^ 4 = (Q x).toReal := by
    dsimp only [G]
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← Real.rpow_natCast,
      ← Real.rpow_mul ENNReal.toReal_nonneg]
    norm_num
  have hGpow' (x : α) : ‖G x‖ ^ (4 : ENNReal).toReal = (Q x).toReal := by
    dsimp only [G]
    change |(Q x).toReal ^ ((4 : Real)⁻¹)| ^ (4 : Real) = (Q x).toReal
    rw [abs_of_nonneg (Real.rpow_nonneg ENNReal.toReal_nonneg _),
      ← Real.rpow_mul ENNReal.toReal_nonneg]
    norm_num
  have hGmem : MemLp G 4 μ := by
    apply (integrable_norm_rpow_iff hGmeas (by norm_num) (by simp)).mp
    rw [show (fun x : α => ‖G x‖ ^ (4 : ENNReal).toReal) =
        fun x => (Q x).toReal by
          funext x
          exact hGpow' x]
    exact hQint
  have hQae : ∀ᵐ x ∂μ, Q x < ∞ := ae_lt_top hQmeas hQfinite
  have hGbound : (∫ x, ‖G x‖ ^ 4 ∂μ) ≤ K := by
    calc
      (∫ x, ‖G x‖ ^ 4 ∂μ) = ∫ x, (Q x).toReal ∂μ := by
        apply MeasureTheory.integral_congr_ae
        filter_upwards with x
        exact hGpow x
      _ = (∫⁻ x, Q x ∂μ).toReal :=
        integral_toReal hQmeas.aemeasurable hQae
      _ ≤ (ENNReal.ofReal K).toReal :=
        (ENNReal.toReal_le_toReal hQfinite ENNReal.ofReal_ne_top).2 hQlin
      _ = K := ENNReal.toReal_ofReal hK
  exact ⟨by simpa only [G] using hGmem, by simpa only [G] using hGbound⟩

/-- A literal fourth-power integral bound controls the extended-real `L⁴`
seminorm. -/
private theorem eLpNorm_four_le_of_memLp_and_integral_norm_pow_four
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {G : α → Real}
    {K : Real} (hGmem : MemLp G 4 μ)
    (hGbound : (∫ x, ‖G x‖ ^ 4 ∂μ) ≤ K) :
    eLpNorm G 4 μ ≤ ENNReal.ofReal (K ^ ((4 : Real)⁻¹)) := by
  rw [hGmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
  norm_num
  exact ENNReal.ofReal_le_ofReal
    (Real.rpow_le_rpow (integral_nonneg fun _ => pow_nonneg (abs_nonneg _) _)
      hGbound (by positivity))

/-- On a nonempty compact time interval, the fourth root of the quartic
`ENNReal` maximum is the ordinary `ENNReal` norm maximum. -/
private theorem toReal_iSup_norm_eq_fourthRoot_of_continuous
    {X E : Type*} [TopologicalSpace X] [NormedAddCommGroup E]
    {F : Real → X → E} {a b : Real}
    (hab : a ≤ b) (hF : Continuous (Function.uncurry F)) (x : X) :
    (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖).toReal =
      ((⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 4)).toReal) ^ ((4 : Real)⁻¹) := by
  have hnorm : Continuous (fun r : Real => ‖F r x‖) := by
    exact (hF.comp (continuous_id.prodMk
      (continuous_const : Continuous fun _ : Real => x))).norm
  obtain ⟨r₀, hr₀, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr hab) hnorm.continuousOn
  have hsup :
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖) =
        ENNReal.ofReal ‖F r₀ x‖ := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal (hmax r.2)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal ‖F r.1 x‖) ⟨r₀, hr₀⟩
  have hsup_pow :
      (⨆ r : Icc a b, ENNReal.ofReal (‖F r.1 x‖ ^ 4)) =
        ENNReal.ofReal (‖F r₀ x‖ ^ 4) := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal
        (pow_le_pow_left₀ (norm_nonneg _) (hmax r.2) 4)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal (‖F r.1 x‖ ^ 4)) ⟨r₀, hr₀⟩
  rw [hsup, hsup_pow, ENNReal.toReal_ofReal (norm_nonneg _),
    ENNReal.toReal_ofReal (pow_nonneg (norm_nonneg _) _), ← Real.rpow_natCast,
    ← Real.rpow_mul (norm_nonneg _)]
  norm_num

/-- On a nonempty compact time interval, the literal real supremum agrees
with the corresponding finite `ENNReal` supremum. -/
private theorem iSup_norm_eq_toReal_iSup_ennreal_norm_of_continuous
    {X E : Type*} [TopologicalSpace X] [NormedAddCommGroup E]
    {F : Real → X → E} {a b : Real}
    (hab : a ≤ b) (hF : Continuous (Function.uncurry F)) (x : X) :
    (⨆ r : Icc a b, ‖F r.1 x‖) =
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖).toReal := by
  letI : Nonempty (Icc a b) := ⟨⟨a, le_rfl, hab⟩⟩
  have hnorm : Continuous (fun r : Real => ‖F r x‖) := by
    exact (hF.comp (continuous_id.prodMk
      (continuous_const : Continuous fun _ : Real => x))).norm
  obtain ⟨r₀, hr₀, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr hab) hnorm.continuousOn
  have hsup : (⨆ r : Icc a b, ‖F r.1 x‖) = ‖F r₀ x‖ := by
    apply le_antisymm
    · apply ciSup_le
      intro r
      exact hmax r.2
    · have hbdd : BddAbove (Set.range fun r : Icc a b => ‖F r.1 x‖) := by
        refine ⟨‖F r₀ x‖, ?_⟩
        rintro _ ⟨r, rfl⟩
        exact hmax r.2
      exact le_ciSup hbdd ⟨r₀, hr₀⟩
  have hsup_ennreal :
      (⨆ r : Icc a b, ENNReal.ofReal ‖F r.1 x‖) =
        ENNReal.ofReal ‖F r₀ x‖ := by
    apply le_antisymm
    · apply iSup_le
      intro r
      exact ENNReal.ofReal_le_ofReal (hmax r.2)
    · exact le_iSup (fun r : Icc a b => ENNReal.ofReal ‖F r.1 x‖) ⟨r₀, hr₀⟩
  rw [hsup, hsup_ennreal, ENNReal.toReal_ofReal (norm_nonneg _)]

/-- The scalar dyadic bookkeeping behind the endpoint-shaped `L⁴` sampling
estimate. -/
private theorem timeSamplingL4_dyadic_rate
    {δ A B E ρ EF ED : Real}
    (hδ : 0 < δ)
    (hFenergy : EF ≤ A * δ ^ (1 + 4 * ρ) * E)
    (hDenergy : ED ≤ B * δ ^ (-3 + 4 * ρ) * E) :
    128 * δ⁻¹ * EF + 72 * δ ^ 3 * ED ≤
      (128 * A + 72 * B) * δ ^ (4 * ρ) * E := by
  have hscaleF : δ⁻¹ * δ ^ (1 + 4 * ρ) = δ ^ (4 * ρ) := by
    rw [← Real.rpow_neg_one δ, ← Real.rpow_add hδ]
    congr 1
    ring
  have hscaleD : δ ^ 3 * δ ^ (-3 + 4 * ρ) = δ ^ (4 * ρ) := by
    rw [← Real.rpow_natCast, ← Real.rpow_add hδ]
    congr 1
    ring
  have hfirst : 128 * δ⁻¹ * EF ≤ 128 * A * δ ^ (4 * ρ) * E := by
    calc
      128 * δ⁻¹ * EF ≤ 128 * δ⁻¹ * (A * δ ^ (1 + 4 * ρ) * E) := by
        exact mul_le_mul_of_nonneg_left hFenergy
          (mul_nonneg (by norm_num) (inv_nonneg.mpr hδ.le))
      _ = 128 * A * δ ^ (4 * ρ) * E := by
        rw [show 128 * δ⁻¹ * (A * δ ^ (1 + 4 * ρ) * E) =
            128 * A * (δ⁻¹ * δ ^ (1 + 4 * ρ)) * E by ring, hscaleF]
  have hsecond : 72 * δ ^ 3 * ED ≤ 72 * B * δ ^ (4 * ρ) * E := by
    calc
      72 * δ ^ 3 * ED ≤ 72 * δ ^ 3 * (B * δ ^ (-3 + 4 * ρ) * E) := by
        exact mul_le_mul_of_nonneg_left hDenergy
          (mul_nonneg (by norm_num) (pow_nonneg hδ.le _))
      _ = 72 * B * δ ^ (4 * ρ) * E := by
        rw [show 72 * δ ^ 3 * (B * δ ^ (-3 + 4 * ρ) * E) =
            72 * B * (δ ^ 3 * δ ^ (-3 + 4 * ρ)) * E by ring, hscaleD]
  calc
    128 * δ⁻¹ * EF + 72 * δ ^ 3 * ED ≤
        128 * A * δ ^ (4 * ρ) * E + 72 * B * δ ^ (4 * ρ) * E :=
      add_le_add hfirst hsecond
    _ = (128 * A + 72 * B) * δ ^ (4 * ρ) * E := by ring

/-- Factor the fourth root of the sampled quartic energy into the local
smoothing gain and the input energy. -/
private theorem timeSamplingL4_dyadic_rate_fourth_root
    {δ A B E ρ : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B) (hE : 0 ≤ E) :
    ((128 * A + 72 * B) * δ ^ (4 * ρ) * E) ^ ((4 : Real)⁻¹) =
      (128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹) := by
  have hAB : 0 ≤ 128 * A + 72 * B := by positivity
  have hδpow : 0 ≤ δ ^ (4 * ρ) := Real.rpow_nonneg hδ.le _
  rw [Real.mul_rpow (mul_nonneg hAB hδpow) hE,
    Real.mul_rpow hAB hδpow, ← Real.rpow_mul hδ.le]
  congr 1
  ring_nf

/-- Literal dyadic `L⁴` product-energy estimates for a jointly continuous
time family and its derivative yield a real time-maximal `L⁴` bound.  The
two energy exponents are exactly those produced by an endpoint stationary
normalization and one time derivative; the resulting maximal gain is
`(dyadicTimeScale j) ^ ρ`. -/
theorem memLp_four_and_eLpNorm_iSup_timeSamplingL4_of_dyadic_energy
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF : Continuous (Function.uncurry F))
    (hF' : Continuous (Function.uncurry F'))
    (hderiv : ∀ t x, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    {A B E ρ : Real} (hA : 0 ≤ A) (hB : 0 ≤ B) (hE : 0 ≤ E)
    (hFenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) ≤
        A * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (1 + 4 * ρ) * E)
    (hF'energy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) ≤
        B * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-3 + 4 * ρ) * E) :
    MemLp (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) 4 volume ∧
      eLpNorm (fun x : Euclidean d =>
        ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) 4 volume ≤
        ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) *
            (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ ρ * E ^ ((4 : Real)⁻¹)) := by
  let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
  let Q : Euclidean d → ENNReal := fun x =>
    ⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)
  let K : Real := (128 * A + 72 * B) * δ ^ (4 * ρ) * E
  have hδ : 0 < δ := by
    dsimp only [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hQ := measurable_and_lintegral_iSup_ennreal_norm_pow_four_le_timeSamplingL4
    j T hT hF hF' hderiv hFspace hF'space
  have hQmeas : Measurable Q := by
    simpa only [Q] using hQ.1
  have hrawrate :
      128 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 4) +
        72 * δ ^ 3 * (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 4) ≤ K := by
    simpa only [δ, K] using
      (timeSamplingL4_dyadic_rate (δ := δ) hδ hFenergy hF'energy)
  have hQlin : (∫⁻ x : Euclidean d, Q x) ≤ ENNReal.ofReal K := by
    refine hQ.2.trans (ENNReal.ofReal_le_ofReal ?_)
    simpa only [δ] using hrawrate
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact mul_nonneg
      (mul_nonneg (by positivity) (Real.rpow_nonneg hδ.le _)) hE
  have hroot := memLp_four_and_integral_norm_pow_four_of_measurable_lintegral
    Q hQmeas hK hQlin
  have hnorm := eLpNorm_four_le_of_memLp_and_integral_norm_pow_four
    hroot.1 hroot.2
  have hfactor := timeSamplingL4_dyadic_rate_fourth_root
    (δ := δ) (ρ := ρ) hδ hA hB hE
  have hnorm' :
      eLpNorm (fun x : Euclidean d => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 volume ≤
        ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹)) := by
    calc
      eLpNorm (fun x : Euclidean d => (Q x).toReal ^ ((4 : Real)⁻¹)) 4 volume ≤
          ENNReal.ofReal (K ^ ((4 : Real)⁻¹)) := hnorm
      _ = ENNReal.ofReal
          ((128 * A + 72 * B) ^ ((4 : Real)⁻¹) * δ ^ ρ * E ^ ((4 : Real)⁻¹)) := by
        exact congrArg ENNReal.ofReal (by
          simpa only [K] using hfactor)
  have heq : (fun x : Euclidean d =>
      ⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) =
      fun x : Euclidean d =>
        ((⨆ r : Icc (1 : Real) 2, ENNReal.ofReal (‖F r.1 x‖ ^ 4)).toReal) ^
          ((4 : Real)⁻¹) := by
    funext x
    calc
      (⨆ r : Icc (1 : Real) 2, ‖F r.1 x‖) =
          (⨆ r : Icc (1 : Real) 2, ENNReal.ofReal ‖F r.1 x‖).toReal :=
        iSup_norm_eq_toReal_iSup_ennreal_norm_of_continuous
          (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hF x
      _ = _ :=
        toReal_iSup_norm_eq_fourthRoot_of_continuous
          (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hF x
  rw [heq]
  constructor
  · simpa only [Q] using hroot.1
  · simpa only [Q, δ] using hnorm'

/-- The finite `L²` space-time sampling estimate for the actual separated
time sets used by MSS.  The hypotheses record precisely what is needed to
apply Fubini at a finite collection of individual time slices: product
integrability on the unit slab and integrability at every sampled time. -/
theorem timeSamplingL2_spacetime_of_MSS_MaximalSeparated
    {d : Nat} {F F' : Real → Euclidean d → Complex}
    (j : Nat) (T : Finset Real)
    (hT : _root_.Auto.Spherical.MSS.MaximalSeparated j T)
    (hF_cont : ∀ x, Continuous (fun t => F t x))
    (hF'_cont : ∀ x, Continuous (fun t => F' t x))
    (hderiv : ∀ x t, HasDerivAt (fun s => F s x) (F' t x) t)
    (hFslice : ∀ t ∈ T, Integrable (fun x => ‖F t x‖ ^ 2) volume)
    (hFspace : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hF'space : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume)) :
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 2) ≤
      4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  have hFinner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hFspace.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  have hF'inner : Integrable (fun x : Euclidean d =>
      ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) volume := by
    have hG : Integrable (fun x : Euclidean d =>
        ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν) volume := by
      simpa only [ν] using hF'space.integral_prod_right
    have heq : (fun x : Euclidean d =>
        ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        fun x => ∫ t : Real, ‖F' t x‖ ^ 2 ∂ν := by
      funext x
      simp only [ν]
      rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    rw [heq]
    exact hG
  let H : Euclidean d → Real := fun x => ∑ t ∈ T, ‖F t x‖ ^ 2
  have hH : Integrable H volume := by
    dsimp only [H]
    exact integrable_finsetSum T fun t ht => hFslice t ht
  have hright : Integrable (fun x : Euclidean d =>
      4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2)) volume := by
    exact (hFinner.const_mul
      (4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹)).add
      (hF'inner.const_mul
        (2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j))
  have hpoint (x : Euclidean d) : H x ≤
      4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
    dsimp only [H]
    exact timeSamplingL2_of_MSS_MaximalSeparated j T hT
      (hF_cont x) (hF'_cont x) (fun t => hderiv x t)
  have hFswap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2 := by
    have hFuIoc : Integrable (fun p : Real × Euclidean d => ‖F p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hFspace
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F t x‖ ^ 2) hFuIoc).symm
  have hF'swap :
      (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2 := by
    have hF'uIoc : Integrable (fun p : Real × Euclidean d => ‖F' p.1 p.2‖ ^ 2)
        ((volume.restrict (uIoc (1 : Real) 2)).prod volume) := by
      rw [uIoc_of_le (by norm_num), restrict_Ioc_eq_restrict_Icc]
      exact hF'space
    exact (intervalIntegral_integral_swap
      (f := fun t (x : Euclidean d) => ‖F' t x‖ ^ 2) hF'uIoc).symm
  calc
    (∑ t ∈ T, ∫ x : Euclidean d, ‖F t x‖ ^ 2) = ∫ x : Euclidean d, H x := by
      symm
      simpa only [H] using (integral_finsetSum T fun t ht => hFslice t ht)
    _ ≤ ∫ x : Euclidean d,
        4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
            (∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
          2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
            (∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
      apply integral_mono_ae hH hright
      exact Filter.Eventually.of_forall hpoint
    _ = 4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ x : Euclidean d, ∫ t in (1 : Real)..2, ‖F' t x‖ ^ 2) := by
      rw [MeasureTheory.integral_add
        (hFinner.const_mul (4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹))
        (hF'inner.const_mul (2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j)),
        MeasureTheory.integral_const_mul, MeasureTheory.integral_const_mul]
    _ = 4 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F t x‖ ^ 2) +
        2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean d, ‖F' t x‖ ^ 2) := by
      rw [hFswap, hF'swap]

/-- Extended-real supremum form of the proved `L²` time Sobolev estimate. -/
theorem timeSupremumL2
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] [CompleteSpace E]
    {F F' : ℝ → E} {a b : ℝ} (hab : a < b)
    (hF : Continuous F) (hF' : Continuous F')
    (hderiv : ∀ t, HasDerivAt F (F' t) t) :
    (⨆ r : Icc a b, ENNReal.ofReal (‖F r.1‖ ^ 2)) ≤
      ENNReal.ofReal
        (2 * (b - a)⁻¹ * (∫ t in a..b, ‖F t‖ ^ 2) +
          2 * (b - a) * (∫ t in a..b, ‖F' t‖ ^ 2)) := by
  apply iSup_le
  intro r
  exact ENNReal.ofReal_le_ofReal (timeSobolevL2 hab r.2 hF hF' hderiv)

/-- The dyadic MSS time scale is the reciprocal of the corresponding
positive natural dyadic power. -/
theorem dyadicTimeScale_eq_inv_natPow (j : Nat) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale j =
      ((2 ^ j : Nat) : Real)⁻¹ := by
  rw [_root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg, zpow_natCast]
  congr 1
  norm_cast


