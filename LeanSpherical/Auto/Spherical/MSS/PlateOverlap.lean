          intro n hn
          apply integrable_finsetSum radialIndices
          intro n' hn'
          apply integrable_finsetSum (angularIndices.product angularIndices)
          intro pair hpair
          exact hRint n n' pair)
      _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
          ∑ pair ∈ angularIndices.product angularIndices,
            ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
          apply Finset.sum_congr rfl
          intro n hn
          calc
            (∫ z : WaveSpaceTime, ∑ n' ∈ radialIndices,
              ∑ pair ∈ angularIndices.product angularIndices,
                ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) =
                ∑ n' ∈ radialIndices, ∫ z : WaveSpaceTime,
                  ∑ pair ∈ angularIndices.product angularIndices,
                    ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) :=
              integral_finsetSum radialIndices (by
                intro n' hn'
                apply integrable_finsetSum (angularIndices.product angularIndices)
                intro pair hpair
                exact hRint n n' pair)
            _ = ∑ n' ∈ radialIndices,
                ∑ pair ∈ angularIndices.product angularIndices,
                  ∫ z : WaveSpaceTime, ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
                apply Finset.sum_congr rfl
                intro n' hn'
                exact integral_finsetSum (angularIndices.product angularIndices) (by
                  intro pair hpair
                  exact hRint n n' pair)
  calc
    (∫ z : WaveSpaceTime,
      (angularRadialSquareFunction radialIndices angularIndices
        (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) =
        ∫ z : WaveSpaceTime, ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
          ∑ pair ∈ angularIndices.product angularIndices,
            ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
          apply integral_congr_ae
          filter_upwards [] with z
          rw [angularRadialSquareFunction_pow_four_eq]
          simp only [R]
          apply Finset.sum_congr rfl
          intro n hn
          apply Finset.sum_congr rfl
          intro n' hn'
          calc
            ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
                ‖jointInversePacket (P n nu) z * jointInversePacket (P n' nu') z‖ ^ (2 : Nat) =
                ∑ pair ∈ angularIndices.product angularIndices,
                  ‖jointInversePacket (P n pair.1) z *
                    jointInversePacket (P n' pair.2) z‖ ^ (2 : Nat) :=
              (Finset.sum_product angularIndices angularIndices
                (fun pair : Int × Int =>
                  ‖jointInversePacket (P n pair.1) z *
                    jointInversePacket (P n' pair.2) z‖ ^ (2 : Nat))).symm
            _ = ∑ pair ∈ angularIndices.product angularIndices,
                ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
                  apply Finset.sum_congr rfl
                  intro pair hpair
                  dsimp only [R]
                  rw [jointInversePacket_convolution_eq_mul]
    _ = _ := hIntegral

/-- Cauchy--Schwarz across the finitely many dyadic angular separation levels. -/
private theorem integral_norm_sq_full_angularPair_sum_le_level_sums
    (maxLevel : Real → Nat)
    (sectorRadius spacingLower spacingUpper : Real)
    (hlevels : angularSeparationLevelData maxLevel
      sectorRadius spacingLower spacingUpper)
    {scale : Real} (hscale : 2 ≤ scale)
    (angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (R : Int × Int → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime,
      ‖∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R pair) z‖ ^ (2 : Nat)) ≤
      ((maxLevel scale + 1 : Nat) : Real) *
        ∑ k ∈ Finset.range (maxLevel scale + 1),
          ∫ z : WaveSpaceTime,
            ‖∑ pair ∈ angularSeparationPairs angularIndices k,
              jointInversePacket (R pair) z‖ ^ (2 : Nat) := by
  classical
  let K : Nat := maxLevel scale
  let levelSum : Nat → WaveSpaceTime → Complex := fun k z =>
    ∑ pair ∈ angularSeparationPairs angularIndices k, jointInversePacket (R pair) z
  have hfull (z : WaveSpaceTime) :
      (∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R pair) z) =
      ∑ k ∈ Finset.range (K + 1), levelSum k z := by
    dsimp only [K, levelSum]
    exact (sum_angularSeparationPairs_range_succ_of_levelData
      maxLevel sectorRadius spacingLower spacingUpper hlevels hscale angularIndices directions
      hgeometry (fun pair => jointInversePacket (R pair) z)).symm
  have hpoint (z : WaveSpaceTime) :
      ‖∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R pair) z‖ ^ (2 : Nat) ≤
      ((K + 1 : Nat) : Real) *
        ∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖ ^ (2 : Nat) := by
    rw [hfull z]
    calc
      ‖∑ k ∈ Finset.range (K + 1), levelSum k z‖ ^ (2 : Nat) ≤
          (∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖) ^ (2 : Nat) := by
        exact (sq_le_sq₀ (norm_nonneg _)
          (Finset.sum_nonneg fun _ _ => norm_nonneg _)).mpr
          (norm_sum_le _ _)
      _ ≤ ((Finset.range (K + 1)).card : Real) *
          ∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖ ^ (2 : Nat) := by
        exact sq_sum_le_card_mul_sum_sq
      _ = ((K + 1 : Nat) : Real) *
          ∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖ ^ (2 : Nat) := by
        rw [Finset.card_range]
  have hleftInt : Integrable
      (fun z : WaveSpaceTime => ‖∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R pair) z‖ ^ (2 : Nat)) volume :=
    integrable_norm_sq_sum_jointInversePacket (angularIndices.product angularIndices) R
  have hlevelInt (k : Nat) : Integrable
      (fun z : WaveSpaceTime => ‖levelSum k z‖ ^ (2 : Nat)) volume := by
    dsimp only [levelSum]
    exact integrable_norm_sq_sum_jointInversePacket
      (angularSeparationPairs angularIndices k) R
  have hsumInt : Integrable
      (fun z : WaveSpaceTime => ∑ k ∈ Finset.range (K + 1),
        ‖levelSum k z‖ ^ (2 : Nat)) volume := by
    apply integrable_finsetSum (Finset.range (K + 1))
    intro k hk
    exact hlevelInt k
  have hKnonneg : 0 ≤ ((K + 1 : Nat) : Real) := by positivity
  calc
    (∫ z : WaveSpaceTime,
      ‖∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (R pair) z‖ ^ (2 : Nat)) ≤
        ∫ z : WaveSpaceTime, ((K + 1 : Nat) : Real) *
          ∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖ ^ (2 : Nat) := by
        apply integral_mono hleftInt (hsumInt.const_mul _)
        intro z
        exact hpoint z
    _ = ((K + 1 : Nat) : Real) *
        ∫ z : WaveSpaceTime,
          ∑ k ∈ Finset.range (K + 1), ‖levelSum k z‖ ^ (2 : Nat) := by
        rw [integral_const_mul]
    _ = ((K + 1 : Nat) : Real) *
        ∑ k ∈ Finset.range (K + 1),
          ∫ z : WaveSpaceTime, ‖levelSum k z‖ ^ (2 : Nat) := by
        rw [integral_finsetSum (Finset.range (K + 1)) (fun k _ => hlevelInt k)]
    _ = ((maxLevel scale + 1 : Nat) : Real) *
        ∑ k ∈ Finset.range (maxLevel scale + 1),
          ∫ z : WaveSpaceTime,
            ‖∑ pair ∈ angularSeparationPairs angularIndices k,
              jointInversePacket (R pair) z‖ ^ (2 : Nat) := by
        rfl

private theorem integrable_pow_four_angularRadialSquareFunction_jointInversePacket
    (radialIndices angularIndices : Finset Int)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex) :
    Integrable
      (fun z : WaveSpaceTime =>
        (angularRadialSquareFunction radialIndices angularIndices
          (fun n nu => jointInversePacket (P n nu)) z) ^ (4 : Nat)) volume := by
  classical
  let R : Int → Int → Int × Int → SchwartzMap JointWaveSpaceTime Complex :=
    fun n n' pair => SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (P n pair.1) (P n' pair.2)
  have hRint (n n' : Int) (pair : Int × Int) : Integrable
      (fun z : WaveSpaceTime => ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) volume := by
    unfold R jointInversePacket
    exact integrable_norm_sq_jointSchwartzRaw _
  have hsum : Integrable
      (fun z : WaveSpaceTime => ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ∑ pair ∈ angularIndices.product angularIndices,
          ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat)) volume := by
    apply integrable_finsetSum radialIndices
    intro n hn
    apply integrable_finsetSum radialIndices
    intro n' hn'
    apply integrable_finsetSum (angularIndices.product angularIndices)
    intro pair hpair
    exact hRint n n' pair
  refine hsum.congr ?_
  filter_upwards [] with z
  symm
  rw [angularRadialSquareFunction_pow_four_eq]
  simp only [R]
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro n' hn'
  calc
    ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
        ‖jointInversePacket (P n nu) z * jointInversePacket (P n' nu') z‖ ^ (2 : Nat) =
        ∑ pair ∈ angularIndices.product angularIndices,
          ‖jointInversePacket (P n pair.1) z *
            jointInversePacket (P n' pair.2) z‖ ^ (2 : Nat) :=
      (Finset.sum_product angularIndices angularIndices
        (fun pair : Int × Int =>
          ‖jointInversePacket (P n pair.1) z *
            jointInversePacket (P n' pair.2) z‖ ^ (2 : Nat))).symm
    _ = ∑ pair ∈ angularIndices.product angularIndices,
        ‖jointInversePacket (R n n' pair) z‖ ^ (2 : Nat) := by
          apply Finset.sum_congr rfl
          intro pair hpair
          dsimp only [R]
          rw [jointInversePacket_convolution_eq_mul]

private theorem integrable_pow_four_aux_angularRadialRecombinedSquareFunction_jointInversePacket
    (radialIndices angularIndices : Finset Int)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex) :
    Integrable
      (fun z : WaveSpaceTime =>
        (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices
