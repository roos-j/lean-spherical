    by_cases hsingle : ∀ b ∈ s, b = a
    · have hsubset : s ⊆ ({a} : Finset α) := by
        intro b hb
        simp [hsingle b hb]
      exact (Finset.card_le_card hsubset).trans (by simp)
    · obtain ⟨b, hb, hba⟩ : ∃ b, b ∈ s ∧ b ≠ a := by
        push Not at hsingle
        exact hsingle
      have hsubset : s ⊆ ({a, b} : Finset α) := by
        intro c hc
        rcases h a ha b hb (Ne.symm hba) c hc with hca | hcb
        · simp [hca]
        · simp [hcb]
      exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hs : s = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [hs]

