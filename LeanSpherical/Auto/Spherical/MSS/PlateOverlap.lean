/-- The finite dyadic angular classes must cover every ordered pair, and the
number of classes must grow only logarithmically with the frequency scale. -/
def angularSeparationLevelData (maxLevel : Real → Nat)
    (sectorRadius spacingLower spacingUpper : Real) : Prop :=
  (∀ scale : Real, 2 ≤ scale →
    ∀ indices : Finset Int, ∀ directions : Int → Euclidean 2,
      angularSectorGeometry scale indices directions
        sectorRadius spacingLower spacingUpper →
      ∀ ν ∈ indices, ∀ ν' ∈ indices,
        (ν - ν').natAbs ≤ 2 ^ (maxLevel scale)) ∧
  ∃ A : Real, 0 < A ∧ ∀ scale : Real, 2 ≤ scale →
    ((maxLevel scale : Nat) : Real) + 1 ≤ A * (1 + Real.log scale)

/-- The blueprint-faithful spectral overlap-square-function proposition.
The packets are spectral joint-Schwartz data; their physical representatives
are inverse Fourier transforms, so every product in the fourth-power proof is
again a joint-Schwartz function. -/
def overlapSquareFunction (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper →
  angularSeparationLevelData maxLevel sectorRadius spacingLower spacingUpper →
  ∀ η : Real, 0 < η →
    ∃ gamma : Real, 0 < gamma ∧ gamma < 1 / 10 ∧
      ∃ Cη : Real, 0 < Cη ∧
        ∀ scale : Real, 2 ≤ scale →
          ∀ radialIndices angularIndices : Finset Int,
            ∀ directions : Int → Euclidean 2,
              angularSectorGeometry scale angularIndices directions
                sectorRadius spacingLower spacingUpper →
              ∀ P : Int → Int → SchwartzMap JointWaveSpaceTime Complex,
                (∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
                  Function.support (jointSchwartzRaw (P n ν)) ⊆
                    conicPlate scale gamma angularConstant n (directions ν)) →
                eLpNorm
                    (aux_angularRadialRecombinedSquareFunction
                      radialIndices angularIndices
                      (fun n ν =>
                        jointSchwartzRaw (FourierTransform.fourierInv (P n ν))))
                    (4 : ENNReal) volume ≤
                  ENNReal.ofReal (Cη * scale ^ η) *
                    eLpNorm
                      (angularRadialSquareFunction radialIndices angularIndices
                        (fun n ν =>
                          jointSchwartzRaw (FourierTransform.fourierInv (P n ν))))
                      (4 : ENNReal) volume

/-- The blueprint's explicit ceiling-logarithmic choice of terminal dyadic
level, with the sector-diameter constant derived from the lower spacing. -/
noncomputable def mssAngularMaxLevel
    (sectorRadius spacingLower scale : Real) : Nat :=
  ⌈Real.logb 2
    (2 + (2 * sectorRadius / spacingLower) * Real.sqrt scale)⌉₊

/-- An elementary replacement for an asymptotic log-absorption import. -/
theorem one_add_log_le_rpow
    {scale delta : Real} (hscale : 1 ≤ scale) (hdelta : 0 < delta) :
    1 + Real.log scale ≤ (1 + delta⁻¹) * scale ^ delta := by
  have hscalePos : 0 < scale := lt_of_lt_of_le zero_lt_one hscale
  have hpowPos : 0 < scale ^ delta := Real.rpow_pos_of_pos hscalePos _
  have hpowOne : 1 ≤ scale ^ delta := Real.one_le_rpow hscale hdelta.le
  have hlogMul : delta * Real.log scale ≤ scale ^ delta - 1 := by
    have h := Real.log_le_sub_one_of_pos hpowPos
    rw [Real.log_rpow hscalePos] at h
    exact h
  have hlog : Real.log scale ≤ (scale ^ delta - 1) / delta := by
    rw [le_div_iff₀ hdelta]
    nlinarith [hlogMul]
  have hsub : (scale ^ delta - 1) / delta ≤ scale ^ delta / delta := by
    apply div_le_div_of_nonneg_right _ hdelta.le
    linarith
  calc
    1 + Real.log scale ≤ 1 + (scale ^ delta - 1) / delta := by linarith
    _ ≤ 1 + scale ^ delta / delta := by linarith
    _ ≤ scale ^ delta + scale ^ delta / delta := by gcongr
    _ = (1 + delta⁻¹) * scale ^ delta := by ring

/-- The sector-radius and lower-spacing parts of `angularSectorGeometry`
bound the range of its integer labels. -/
theorem angularSeparation_label_bound_of_geometry
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {nu nu' : Int} (hnu : nu ∈ indices) (hnu' : nu' ∈ indices) :
    ((nu - nu').natAbs : Real) ≤
      (2 * sectorRadius / spacingLower) * Real.sqrt scale := by
  rcases hgeometry with ⟨hsectorPos, hsectorUpper, hspacingPos, hspacingUpper,
    center, hcenter, hdata⟩
  have hnuCenter : ‖directions nu - center‖ ≤ sectorRadius :=
    (hdata nu hnu).2.1
  have hnu'Center : ‖directions nu' - center‖ ≤ sectorRadius :=
    (hdata nu' hnu').2.1
  have hdirection : ‖directions nu - directions nu'‖ ≤ 2 * sectorRadius := by
    calc
      ‖directions nu - directions nu'‖ =
          ‖(directions nu - center) + (center - directions nu')‖ := by
            congr 1
            abel
      _ ≤ ‖directions nu - center‖ + ‖center - directions nu'‖ := norm_add_le _ _
      _ = ‖directions nu - center‖ + ‖directions nu' - center‖ := by
            congr 1
            rw [norm_sub_rev]
      _ ≤ sectorRadius + sectorRadius := add_le_add hnuCenter hnu'Center
      _ = 2 * sectorRadius := by ring
  have hseparation : spacingLower * ((nu - nu').natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions nu - directions nu'‖ :=
    ((hdata nu hnu).2.2 nu' hnu').1
  have hinv : scale ^ (-(1 / 2 : Real)) * Real.sqrt scale = 1 := by
    calc
      scale ^ (-(1 / 2 : Real)) * Real.sqrt scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 / 2 : Real) := by
            rw [← Real.sqrt_eq_rpow]
      _ = scale ^ ((-(1 / 2 : Real)) + (1 / 2 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = 1 := by norm_num
  have hscaled : spacingLower * ((nu - nu').natAbs : Real) ≤
      (2 * sectorRadius) * Real.sqrt scale := by
    calc
      spacingLower * ((nu - nu').natAbs : Real) =
          (spacingLower * ((nu - nu').natAbs : Real)) * 1 := (mul_one _).symm
      _ = (spacingLower * ((nu - nu').natAbs : Real)) *
          (scale ^ (-(1 / 2 : Real)) * Real.sqrt scale) := by rw [hinv]
      _ = (spacingLower * ((nu - nu').natAbs : Real) *
          scale ^ (-(1 / 2 : Real))) * Real.sqrt scale := by ring
      _ ≤ ‖directions nu - directions nu'‖ * Real.sqrt scale :=
        mul_le_mul_of_nonneg_right hseparation (Real.sqrt_nonneg _)
      _ ≤ (2 * sectorRadius) * Real.sqrt scale :=
        mul_le_mul_of_nonneg_right hdirection (Real.sqrt_nonneg _)
  calc
    ((nu - nu').natAbs : Real) ≤
        ((2 * sectorRadius) * Real.sqrt scale) / spacingLower := by
      apply (le_div_iff₀ hspacingPos).mpr
      simpa [mul_comm] using hscaled
    _ = (2 * sectorRadius / spacingLower) * Real.sqrt scale := by
      field_simp [ne_of_gt hspacingPos]

/-- The explicit ceiling-logarithmic terminal level from the blueprint covers
every angular label difference allowed by the existing sector geometry. -/
theorem mssAngularMaxLevel_covers_labels
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {nu nu' : Int} (hnu : nu ∈ indices) (hnu' : nu' ∈ indices) :
    (nu - nu').natAbs ≤
      2 ^ mssAngularMaxLevel sectorRadius spacingLower scale := by
  have hscalePos : 0 < scale := by linarith
  have hlabel := angularSeparation_label_bound_of_geometry hscalePos hgeometry hnu hnu'
  rcases hgeometry with ⟨hsectorPos, hsectorUpper, hspacingPos, hspacingUpper,
    center, hcenter, hdata⟩
  let c : Real := 2 * sectorRadius / spacingLower
  let u : Real := 2 + c * Real.sqrt scale
  let K : Nat := mssAngularMaxLevel sectorRadius spacingLower scale
  have hcPos : 0 < c := by
    dsimp only [c]
    positivity
  have huPos : 0 < u := by
    dsimp only [u]
    positivity
  have hlabelU : ((nu - nu').natAbs : Real) ≤ u := by
    dsimp only [u, c]
    linarith
  have hlog : Real.logb 2 u ≤ (K : Real) := by
    dsimp only [K, mssAngularMaxLevel, u, c]
    exact Nat.le_ceil _
  have huPow : u ≤ (2 : Real) ^ (K : Real) :=
    (Real.logb_le_iff_le_rpow one_lt_two huPos).mp hlog
  have hlabelPow : ((nu - nu').natAbs : Real) ≤
      ((2 ^ K : Nat) : Real) := by
    calc
      ((nu - nu').natAbs : Real) ≤ u := hlabelU
      _ ≤ (2 : Real) ^ (K : Real) := huPow
      _ = ((2 ^ K : Nat) : Real) := by
        simp only [Real.rpow_natCast, Nat.cast_pow, Nat.cast_ofNat]
  change (nu - nu').natAbs ≤ 2 ^ K
  exact_mod_cast hlabelPow

/-- The explicit terminal level has the logarithmic growth required to absorb
the finite separation-class loss. -/
theorem mssAngularMaxLevel_log_bound
    {sectorRadius spacingLower : Real}
    (hsectorPos : 0 < sectorRadius) (hspacingPos : 0 < spacingLower) :
    ∃ A : Real, 0 < A ∧ ∀ scale : Real, 2 ≤ scale →
      ((mssAngularMaxLevel sectorRadius spacingLower scale : Nat) : Real) + 1 ≤
        A * (1 + Real.log scale) := by
  let c : Real := 2 * sectorRadius / spacingLower
  let B : Real := 2 + Real.log (2 + c) / Real.log 2
  let D : Real := (Real.log 2)⁻¹
  let A : Real := B + D
  have hcPos : 0 < c := by
    dsimp only [c]
    positivity
  have hfactorPos : 0 < 2 + c := by linarith
  have hlogTwoPos : 0 < Real.log 2 := Real.log_pos one_lt_two
  have hlogFactorNonneg : 0 ≤ Real.log (2 + c) :=
    Real.log_nonneg (by linarith)
  have hquotNonneg : 0 ≤ Real.log (2 + c) / Real.log 2 :=
    div_nonneg hlogFactorNonneg hlogTwoPos.le
  have hinvPos : 0 < (Real.log 2)⁻¹ := inv_pos.mpr hlogTwoPos
  refine ⟨A, ?_, ?_⟩
  · dsimp only [A, B, D]
    linarith
  intro scale hscale
  have hscaleOne : 1 ≤ scale := by linarith
  have hscalePos : 0 < scale := lt_of_lt_of_le zero_lt_one hscaleOne
  have hsqrtLe : Real.sqrt scale ≤ scale :=
    Real.sqrt_le_self_iff.mpr (Or.inr hscaleOne)
  let u : Real := 2 + c * Real.sqrt scale
  let K : Nat := mssAngularMaxLevel sectorRadius spacingLower scale
  have huPos : 0 < u := by
    dsimp only [u]
    positivity
  have huOne : 1 ≤ u := by
    dsimp only [u]
    have : 0 ≤ c * Real.sqrt scale :=
      mul_nonneg hcPos.le (Real.sqrt_nonneg _)
    linarith
  have huLe : u ≤ (2 + c) * scale := by
    dsimp only [u]
    have hfirst : 2 ≤ 2 * scale := by nlinarith
    have hsecond : c * Real.sqrt scale ≤ c * scale :=
      mul_le_mul_of_nonneg_left hsqrtLe hcPos.le
    nlinarith
  have hlogMono : Real.logb 2 u ≤ Real.logb 2 ((2 + c) * scale) :=
    Real.logb_le_logb_of_le one_lt_two huPos huLe
  have hlogExpand : Real.logb 2 ((2 + c) * scale) =
      Real.log (2 + c) / Real.log 2 + Real.log scale / Real.log 2 := by
    rw [← Real.log_div_log, Real.log_mul hfactorPos.ne' hscalePos.ne']
    ring
  have hceilNonneg : 0 ≤ Real.logb 2 u :=
    Real.logb_nonneg one_lt_two huOne
  have hceil : (K : Real) < Real.logb 2 u + 1 := by
    dsimp only [K, mssAngularMaxLevel, u]
    exact Nat.ceil_lt_add_one hceilNonneg
  have hK : (K : Real) + 1 ≤ B + Real.log scale * D := by
    exact (calc
      (K : Real) + 1 < Real.logb 2 u + 2 := by linarith
      _ ≤ Real.logb 2 ((2 + c) * scale) + 2 := by linarith
      _ = B + Real.log scale * D := by
        dsimp only [B, D]
        rw [hlogExpand, div_eq_mul_inv]
        ring).le
  have hlogScaleNonneg : 0 ≤ Real.log scale := Real.log_nonneg hscaleOne
  have hDNonneg : 0 ≤ D := by
    dsimp only [D]
    exact hinvPos.le
  have hBNonneg : 0 ≤ B := by
    dsimp only [B]
    linarith
  change (K : Real) + 1 ≤ A * (1 + Real.log scale)
  calc
    (K : Real) + 1 ≤ B + Real.log scale * D := hK
    _ ≤ (B + D) * (1 + Real.log scale) := by
      nlinarith [mul_nonneg hBNonneg hlogScaleNonneg,
        mul_nonneg hDNonneg hlogScaleNonneg]
    _ = A * (1 + Real.log scale) := by rfl

/-- The exact blueprint terminal level supplies both pieces of the finite
level data used by the corrected square-function interface. -/
theorem mssAngularMaxLevel_levelData
    {sectorRadius spacingLower spacingUpper : Real}
    (hsectorPos : 0 < sectorRadius) (hspacingPos : 0 < spacingLower) :
    angularSeparationLevelData
      (mssAngularMaxLevel sectorRadius spacingLower)
      sectorRadius spacingLower spacingUpper := by
  constructor
  · intro scale hscale indices directions hgeometry nu hnu nu' hnu'
    exact mssAngularMaxLevel_covers_labels hscale hgeometry hnu hnu'
  · exact mssAngularMaxLevel_log_bound hsectorPos hspacingPos

/-- The pre-existing dyadic class predicate partitions every label difference
bounded by `2^K`, with the terminal class included. -/
theorem existsUnique_angularSeparationClass_le
    (m m' : Int) (K : Nat)
    (hbound : (m - m').natAbs ≤ 2 ^ K) :
    ∃! k : Nat, k ≤ K ∧ angularSeparationClass k m m' := by
  let d : Nat := (m - m').natAbs
  by_cases hd : d ≤ 1
  · refine ⟨0, ⟨Nat.zero_le _, (angularSeparationClass_zero_iff m m').mpr hd⟩, ?_⟩
    intro k hk
    rcases hk with ⟨hkK, hkClass⟩
    cases k with
    | zero => rfl
    | succ j =>
      have hjClass := (angularSeparationClass_succ_iff j m m').mp hkClass
      have hlarge : 1 < d :=
        lt_of_le_of_lt Nat.one_le_two_pow hjClass.1
      exact (not_lt_of_ge hd hlarge).elim
  · have hdLarge : 1 < d := Nat.lt_of_not_ge hd
    have hclogK : Nat.clog 2 d ≤ K :=
      (Nat.clog_le_iff_le_pow one_lt_two).mpr (by simpa only [d] using hbound)
    refine ⟨Nat.clog 2 d, ?_, ?_⟩
    · constructor
      · exact hclogK
      · have hclogPos : 0 < Nat.clog 2 d := Nat.clog_pos one_lt_two hdLarge
        obtain ⟨j, hj⟩ : ∃ j : Nat, Nat.clog 2 d = j + 1 :=
          Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hclogPos)
        rw [hj]
        apply (angularSeparationClass_succ_iff j m m').mpr
        constructor
        · have hpred : (Nat.clog 2 d).pred = j := by
            rw [hj]
            simp
          simpa only [hpred, d] using
            (Nat.pow_pred_clog_lt_self one_lt_two hdLarge)
        · simpa only [hj] using (Nat.le_pow_clog one_lt_two d)
    · intro k hk
      rcases hk with ⟨hkK, hkClass⟩
      cases k with
      | zero =>
        have hsmall : d ≤ 1 := (angularSeparationClass_zero_iff m m').mp hkClass
        exact (not_lt_of_ge hsmall hdLarge).elim
      | succ j =>
        have hjClass := (angularSeparationClass_succ_iff j m m').mp hkClass
        have hlower : j < Nat.clog 2 d :=
          (Nat.lt_clog_iff_pow_lt one_lt_two).mpr hjClass.1
        have hupper : Nat.clog 2 d ≤ j + 1 :=
          (Nat.clog_le_iff_le_pow one_lt_two).mpr hjClass.2
        exact Nat.le_antisymm (Nat.succ_le_iff.mpr hlower) hupper

/-- The existing finite `angularSeparationPairs` API therefore gives an exact
and unique separation level for every ordered angular pair. -/
theorem existsUnique_mem_angularSeparationPairs_of_levelData
    (maxLevel : Real → Nat)
    (sectorRadius spacingLower spacingUpper : Real)
    (hlevels : angularSeparationLevelData maxLevel
      sectorRadius spacingLower spacingUpper)
    {scale : Real} (hscale : 2 ≤ scale)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    {pair : Int × Int} (hpair : pair ∈ indices.product indices) :
    ∃! k : Nat, k ≤ maxLevel scale ∧ pair ∈ angularSeparationPairs indices k := by
  rcases Finset.mem_product.mp hpair with ⟨hfst, hsnd⟩
  have hbound : (pair.1 - pair.2).natAbs ≤ 2 ^ maxLevel scale :=
    hlevels.1 scale hscale indices directions hgeometry pair.1 hfst pair.2 hsnd
  rcases existsUnique_angularSeparationClass_le pair.1 pair.2
    (maxLevel scale) hbound with ⟨k, hk, hunique⟩
  refine ⟨k, ?_, ?_⟩
  · exact ⟨hk.1, (mem_angularSeparationPairs_iff indices k pair).mpr
      ⟨hfst, hsnd, hk.2⟩⟩
  intro j hj
  rcases hj with ⟨hjLevel, hjPair⟩
  have hjClass : angularSeparationClass j pair.1 pair.2 :=
    ((mem_angularSeparationPairs_iff indices j pair).mp hjPair).2.2
  exact hunique j ⟨hjLevel, hjClass⟩

/-- Summing the dyadic separation classes through the terminal level is exactly
the same as summing over all ordered angular pairs.  This is the finite
partition identity needed to recombine the fixed-level estimates. -/
theorem sum_angularSeparationPairs_range_succ_of_levelData
    {A : Type*} [AddCommMonoid A]
    (maxLevel : Real → Nat)
    (sectorRadius spacingLower spacingUpper : Real)
    (hlevels : angularSeparationLevelData maxLevel
      sectorRadius spacingLower spacingUpper)
    {scale : Real} (hscale : 2 ≤ scale)
    (indices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (F : Int × Int → A) :
    (∑ k ∈ Finset.range (maxLevel scale + 1),
      ∑ pair ∈ angularSeparationPairs indices k, F pair) =
      ∑ pair ∈ indices.product indices, F pair := by
  classical
  rw [show (∑ k ∈ Finset.range (maxLevel scale + 1),
      ∑ pair ∈ angularSeparationPairs indices k, F pair) =
      ∑ k ∈ Finset.range (maxLevel scale + 1),
        ∑ pair ∈ indices.product indices,
          if angularSeparationClass k pair.1 pair.2 then F pair else 0 by
        apply Finset.sum_congr rfl
        intro k hk
        rw [angularSeparationPairs]
        simp only [Finset.sum_filter]
    ]
  rw [Finset.sum_comm]
  apply Finset.sum_congr rfl
  intro pair hpair
  rcases existsUnique_mem_angularSeparationPairs_of_levelData
    maxLevel sectorRadius spacingLower spacingUpper hlevels hscale
    indices directions hgeometry hpair with ⟨k, hk, hunique⟩
  have hkRange : k ∈ Finset.range (maxLevel scale + 1) :=
    Finset.mem_range.mpr (Nat.lt_succ_of_le hk.1)
  rw [Finset.sum_eq_single_of_mem k hkRange]
  · have hkClass : angularSeparationClass k pair.1 pair.2 :=
      ((mem_angularSeparationPairs_iff indices k pair).mp hk.2).2.2
    rw [if_pos hkClass]
  · intro j hj hne
    have hjLevel : j ≤ maxLevel scale :=
      Nat.le_of_lt_succ (Finset.mem_range.mp hj)
    have hjClass : ¬ angularSeparationClass j pair.1 pair.2 := by
      intro hjClass
      have hjPair : pair ∈ angularSeparationPairs indices j :=
        (mem_angularSeparationPairs_iff indices j pair).mpr
          ⟨(Finset.mem_product.mp hpair).1, (Finset.mem_product.mp hpair).2, hjClass⟩
      exact hne (hunique j ⟨hjLevel, hjPair⟩)
    simp [hjClass]


/-- A retained conditional raw-Fourier hypothesis for older regular-model transfer lemmas. It is not
the proved overlap-square-function proposition. -/
def overlapSquareFunctionRawHypothesis (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper →
    ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
      ∀ gamma : Real, 0 < gamma → gamma < 1 / 10 →
        ∀ scale : Real, 2 ≤ scale →
          ∀ radialIndices angularIndices : Finset Int,
            ∀ directions : Int → Euclidean 2,
              angularSectorGeometry scale angularIndices directions
                sectorRadius spacingLower spacingUpper →
              ∀ G : Int → Int → WaveSpaceTime → Complex,
                (∀ n ∈ radialIndices, ∀ ν ∈ angularIndices,
                  Function.support (spaceTimeFourier (G n ν)) ⊆
                    conicPlate scale gamma angularConstant n (directions ν)) →
                eLpNorm
                    (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices G)
                    (4 : ENNReal) volume ≤
                  ENNReal.ofReal (C * scale ^ η) *
                    eLpNorm (angularRadialSquareFunction radialIndices angularIndices G)
                      (4 : ENNReal) volume

/-- Internal insertion point for the proof of the spectral overlap-square-function theorem. -/
private noncomputable def jointSchwartzPointwiseProduct
    (P Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (P : JointWaveSpaceTime → Complex) Q

private theorem jointSchwartzPointwiseProduct_apply
    (P Q : SchwartzMap JointWaveSpaceTime Complex) (z : JointWaveSpaceTime) :
    jointSchwartzPointwiseProduct P Q z = P z * Q z := by
  unfold jointSchwartzPointwiseProduct
  rw [SchwartzMap.smulLeftCLM_apply_apply P.hasTemperateGrowth]
  simp only [smul_eq_mul]

private theorem fourier_jointSchwartzPointwiseProduct_eq_convolution
    (P Q : SchwartzMap JointWaveSpaceTime Complex) :
    FourierTransform.fourier (jointSchwartzPointwiseProduct P Q) =
      ((SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier P)) (FourierTransform.fourier Q)) := by
  let C : SchwartzMap JointWaveSpaceTime Complex :=
    (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (FourierTransform.fourier P)) (FourierTransform.fourier Q)
  have hC : FourierTransform.fourierInv C = jointSchwartzPointwiseProduct P Q := by
    ext z
    rw [SchwartzMap.fourierInv_coe, Real.fourierInv_eq_fourier_neg]
    change (FourierTransform.fourier C : SchwartzMap JointWaveSpaceTime Complex) (-z) = _
    rw [show C =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
        (FourierTransform.fourier P)) (FourierTransform.fourier Q) by rfl]
    rw [SchwartzMap.fourier_convolution, SchwartzMap.pairing_apply_apply]
    rw [jointSchwartzPointwiseProduct_apply]
    have hP :
        (FourierTransform.fourier (FourierTransform.fourier P) :
          SchwartzMap JointWaveSpaceTime Complex) (-z) = P z := by
      have hP0 : FourierTransform.fourierInv (FourierTransform.fourier P) = P :=
        FourierTransform.fourierInv_fourier_eq P
      have hP1 := congrArg (fun R : SchwartzMap JointWaveSpaceTime Complex => R z) hP0
      change (FourierTransform.fourier (FourierTransform.fourier P) :
        SchwartzMap JointWaveSpaceTime Complex) (-z) = P z at hP1
      exact hP1
    have hQ :
        (FourierTransform.fourier (FourierTransform.fourier Q) :
          SchwartzMap JointWaveSpaceTime Complex) (-z) = Q z := by
      have hQ0 : FourierTransform.fourierInv (FourierTransform.fourier Q) = Q :=
        FourierTransform.fourierInv_fourier_eq Q
      have hQ1 := congrArg (fun R : SchwartzMap JointWaveSpaceTime Complex => R z) hQ0
      change (FourierTransform.fourier (FourierTransform.fourier Q) :
        SchwartzMap JointWaveSpaceTime Complex) (-z) = Q z at hQ1
      exact hQ1
    simp [hP, hQ]
  calc
    FourierTransform.fourier (jointSchwartzPointwiseProduct P Q) =
        FourierTransform.fourier (FourierTransform.fourierInv C) := by rw [hC]
    _ = C := FourierTransform.fourier_fourierInv_eq C
    _ = _ := rfl

/-- Product-space Haar measure is transported exactly by `jointSchwartzRaw`. -/
private theorem integral_norm_sq_jointSchwartzRaw_eq
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime, ‖jointSchwartzRaw G z‖ ^ (2 : Nat)) =
      ∫ u : JointWaveSpaceTime, ‖G u‖ ^ (2 : Nat) := by
  let hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have h := hpres.integral_comp' (fun u : JointWaveSpaceTime => ‖G u‖ ^ (2 : Nat))
  simpa only [jointSchwartzRaw, MeasurableEquiv.coe_toLp] using h

private theorem integrable_norm_sq_jointSchwartzRaw
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime => ‖jointSchwartzRaw G z‖ ^ (2 : Nat)) volume := by
  let hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  have hmem : MemLp (jointSchwartzRaw G) 2 volume := by
    change MemLp (fun z : WaveSpaceTime => G (WithLp.toLp 2 z)) 2 volume
    exact (G.memLp 2 volume).comp_measurePreserving hpres
  simpa using hmem.integrable_norm_rpow (by norm_num) ENNReal.ofNat_ne_top

private theorem jointSchwartzRaw_finset_sum_apply
    {ι : Type*} (s : Finset ι)
    (R : ι → SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    jointSchwartzRaw (∑ i ∈ s, R i) z =
      ∑ i ∈ s, jointSchwartzRaw (R i) z := by
  classical
  change
    (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
      JointWaveSpaceTime Complex) (∑ i ∈ s, R i) (WithLp.toLp 2 z) =
      ∑ i ∈ s,
        (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
          JointWaveSpaceTime Complex) (R i) (WithLp.toLp 2 z)
  simpa only [Finset.sum_apply] using congrFun
    (map_sum
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex) R s)
    (WithLp.toLp 2 z)

private theorem integral_norm_sq_jointSchwartzRaw_fourier_eq
    (G : SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime, ‖jointSchwartzRaw G z‖ ^ (2 : Nat)) =
      ∫ z : WaveSpaceTime,
        ‖jointSchwartzRaw (FourierTransform.fourier G) z‖ ^ (2 : Nat) := by
  calc
    (∫ z : WaveSpaceTime, ‖jointSchwartzRaw G z‖ ^ (2 : Nat)) =
        ∫ u : JointWaveSpaceTime, ‖G u‖ ^ (2 : Nat) :=
      integral_norm_sq_jointSchwartzRaw_eq G
    _ = ∫ u : JointWaveSpaceTime,
        ‖FourierTransform.fourier (G : JointWaveSpaceTime → Complex) u‖ ^ (2 : Nat) :=
      (integral_norm_sq_fourier_schwartz_eq G).symm
    _ = ∫ z : WaveSpaceTime,
        ‖jointSchwartzRaw (FourierTransform.fourier G) z‖ ^ (2 : Nat) :=
      (integral_norm_sq_jointSchwartzRaw_eq (FourierTransform.fourier G)).symm

private noncomputable def jointInversePacket
    (P : SchwartzMap JointWaveSpaceTime Complex) : WaveSpaceTime → Complex :=
  jointSchwartzRaw (FourierTransform.fourierInv P)

private noncomputable def jointProductProfile
    (P Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzPointwiseProduct (FourierTransform.fourierInv P)
    (FourierTransform.fourierInv Q)

private theorem jointInversePacket_mul_eq_jointSchwartzRaw_productProfile
    (P Q : SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    jointInversePacket P z * jointInversePacket Q z =
      jointSchwartzRaw (jointProductProfile P Q) z := by
  unfold jointInversePacket jointProductProfile jointSchwartzRaw
  rw [jointSchwartzPointwiseProduct_apply]

private theorem fourier_jointProductProfile_eq_convolution
    (P Q : SchwartzMap JointWaveSpaceTime Complex) :
    FourierTransform.fourier (jointProductProfile P Q) =
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q) := by
  unfold jointProductProfile
  rw [fourier_jointSchwartzPointwiseProduct_eq_convolution]
  simp only [FourierTransform.fourier_fourierInv_eq]

private theorem jointInversePacket_convolution_eq_mul
    (P Q : SchwartzMap JointWaveSpaceTime Complex) (z : WaveSpaceTime) :
    jointInversePacket
        (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q) z =
      jointInversePacket P z * jointInversePacket Q z := by
  have h := congrArg FourierTransform.fourierInv
    (fourier_jointProductProfile_eq_convolution P Q)
  rw [FourierTransform.fourierInv_fourier_eq] at h
  have hz := congrArg (fun R : SchwartzMap JointWaveSpaceTime Complex =>
    R (WithLp.toLp 2 z)) h.symm
  change (FourierTransform.fourierInv
    (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q))
      (WithLp.toLp 2 z) =
    (FourierTransform.fourierInv P) (WithLp.toLp 2 z) *
      (FourierTransform.fourierInv Q) (WithLp.toLp 2 z)
  simpa only [jointProductProfile, jointSchwartzPointwiseProduct_apply] using hz

private theorem spaceTimeFourier_jointInversePacket_eq_jointSchwartzRaw
    (P : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourier (jointInversePacket P) = jointSchwartzRaw P := by
  funext zeta
  unfold jointInversePacket
  rw [spaceTimeFourier_jointSchwartzRaw]
  change (FourierTransform.fourier (FourierTransform.fourierInv P) :
    SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 zeta) = _
  rw [FourierTransform.fourier_fourierInv_eq]
  rfl

private theorem spaceTimeFourier_jointInversePacket_mul_eq_jointSchwartzRaw_convolution
    (P Q : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourier (fun z => jointInversePacket P z * jointInversePacket Q z) =
      jointSchwartzRaw
        (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q) := by
  have hphysical :
      (fun z => jointInversePacket P z * jointInversePacket Q z) =
        jointSchwartzRaw (jointProductProfile P Q) := by
    funext z
    exact jointInversePacket_mul_eq_jointSchwartzRaw_productProfile P Q z
  rw [hphysical]
  funext zeta
  rw [spaceTimeFourier_jointSchwartzRaw]
  change (FourierTransform.fourier (jointProductProfile P Q) :
    SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 zeta) = _
  rw [fourier_jointProductProfile_eq_convolution]
  rfl

private theorem support_spaceTimeFourier_jointInversePacket_mul_subset_minkowski
    (P Q : SchwartzMap JointWaveSpaceTime Complex) (S T : Set WaveSpaceTime)
    (hP : Function.support (jointSchwartzRaw P) ⊆ S)
    (hQ : Function.support (jointSchwartzRaw Q) ⊆ T) :
    Function.support
        (spaceTimeFourier (fun z => jointInversePacket P z * jointInversePacket Q z)) ⊆
      minkowskiSum S T := by
  intro z hz
  have htransform :=
    congrFun (spaceTimeFourier_jointInversePacket_mul_eq_jointSchwartzRaw_convolution P Q) z
  rw [Function.mem_support] at hz
  rw [htransform] at hz
  have hC : WithLp.toLp 2 z ∈ Function.support
      (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q) := hz
  have hCraw : WithLp.toLp 2 z ∈ Function.support
      ((P : JointWaveSpaceTime → Complex) ⋆[ContinuousLinearMap.mul Complex Complex, volume]
        (Q : JointWaveSpaceTime → Complex)) := by
    rw [Function.mem_support] at hC ⊢
    simpa only [SchwartzMap.convolution_apply] using hC
  obtain ⟨u, hu, v, hv, huv⟩ :=
    MeasureTheory.support_convolution_subset
      (f := (P : JointWaveSpaceTime → Complex))
      (g := (Q : JointWaveSpaceTime → Complex))
      (L := ContinuousLinearMap.mul Complex Complex) (μ := volume) hCraw
  have huRaw : WithLp.ofLp u ∈ Function.support (jointSchwartzRaw P) := by
    rw [Function.mem_support] at hu ⊢
    simpa only [jointSchwartzRaw, WithLp.toLp_ofLp] using hu
  have hvRaw : WithLp.ofLp v ∈ Function.support (jointSchwartzRaw Q) := by
    rw [Function.mem_support] at hv ⊢
    simpa only [jointSchwartzRaw, WithLp.toLp_ofLp] using hv
  refine ⟨WithLp.ofLp u, hP huRaw, WithLp.ofLp v, hQ hvRaw, ?_⟩
  apply WithLp.toLp_injective (p := (2 : ENNReal))
  simpa only [WithLp.toLp_add, WithLp.toLp_ofLp] using huv

private theorem support_jointSchwartzRaw_convolution_subset_minkowski
    (P Q : SchwartzMap JointWaveSpaceTime Complex) (S T : Set WaveSpaceTime)
    (hP : Function.support (jointSchwartzRaw P) ⊆ S)
    (hQ : Function.support (jointSchwartzRaw Q) ⊆ T) :
    Function.support
        (jointSchwartzRaw
          (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex) P Q)) ⊆
      minkowskiSum S T := by
  have h := support_spaceTimeFourier_jointInversePacket_mul_subset_minkowski P Q S T hP hQ
  rw [spaceTimeFourier_jointInversePacket_mul_eq_jointSchwartzRaw_convolution] at h
  exact h

private theorem norm_sq_sum_jointSchwartzRaw_le_of_support_multiplicity
    {ι : Type*} (s : Finset ι)
    (R : ι → SchwartzMap JointWaveSpaceTime Complex)
    (A : ι → Set WaveSpaceTime) (M : Real)
    (hM : ∀ z : WaveSpaceTime,
      ((@Finset.filter ι (fun i => z ∈ A i) (Classical.decPred _) s).card : Real) ≤ M)
    (hR : ∀ i ∈ s, Function.support (jointSchwartzRaw (R i)) ⊆ A i)
    (z : WaveSpaceTime) :
    ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat) ≤
      M * ∑ i ∈ s, ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
  classical
  let active : Finset ι :=
    @Finset.filter ι (fun i => z ∈ A i) (Classical.decPred _) s
  have hactiveSub : active ⊆ s := Finset.filter_subset _ _
  have hzero : ∀ i ∈ s, i ∉ active → jointSchwartzRaw (R i) z = 0 := by
    intro i hi hinactive
    by_contra hne
    have hsupport : z ∈ Function.support (jointSchwartzRaw (R i)) := by
      rw [Function.mem_support]
      exact hne
    have hmem : z ∈ A i := hR i hi hsupport
    exact hinactive (Finset.mem_filter.mpr ⟨hi, hmem⟩)
  have hsum : (∑ i ∈ s, jointSchwartzRaw (R i) z) =
      ∑ i ∈ active, jointSchwartzRaw (R i) z :=
    (Finset.sum_subset hactiveSub hzero).symm
  have henergyActive : 0 ≤ ∑ i ∈ active,
      ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
    exact Finset.sum_nonneg fun i hi => sq_nonneg _
  have henergyLe : ∑ i ∈ active,
      ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) ≤
      ∑ i ∈ s, ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
    apply Finset.sum_le_sum_of_subset_of_nonneg hactiveSub
    intro i hi hnot
    exact sq_nonneg _
  have hMnonneg : 0 ≤ M := by
    have hcard : 0 ≤ ((active.card : Nat) : Real) := by positivity
    exact hcard.trans (by simpa only [active] using hM z)
  calc
    ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat) =
        ‖∑ i ∈ active, jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by rw [hsum]
    _ ≤ (∑ i ∈ active, ‖jointSchwartzRaw (R i) z‖) ^ (2 : Nat) := by
      exact (sq_le_sq₀ (norm_nonneg _)
        (Finset.sum_nonneg fun i hi => norm_nonneg _)).mpr (norm_sum_le _ _)
    _ ≤ ((active.card : Nat) : Real) * ∑ i ∈ active,
        ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) :=
      sq_sum_le_card_mul_sum_sq
    _ ≤ M * ∑ i ∈ active, ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) :=
      mul_le_mul_of_nonneg_right (by simpa only [active] using hM z) henergyActive
    _ ≤ M * ∑ i ∈ s, ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) :=
      mul_le_mul_of_nonneg_left henergyLe hMnonneg

private theorem integral_norm_sq_sum_jointSchwartzRaw_le_of_support_multiplicity
    {ι : Type*} (s : Finset ι)
    (R : ι → SchwartzMap JointWaveSpaceTime Complex)
    (A : ι → Set WaveSpaceTime) (M : Real)
    (hM : ∀ z : WaveSpaceTime,
      ((@Finset.filter ι (fun i => z ∈ A i) (Classical.decPred _) s).card : Real) ≤ M)
    (hR : ∀ i ∈ s, Function.support (jointSchwartzRaw (R i)) ⊆ A i) :
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) ≤
      M * ∑ i ∈ s, ∫ z : WaveSpaceTime,
        ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
  classical
  let Rsum : SchwartzMap JointWaveSpaceTime Complex := ∑ i ∈ s, R i
  have hsumraw : (fun z : WaveSpaceTime => ∑ i ∈ s, jointSchwartzRaw (R i) z) =
      jointSchwartzRaw Rsum := by
    funext z
    dsimp only [Rsum, jointSchwartzRaw]
    symm
    change
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex) (∑ i ∈ s, R i) (WithLp.toLp 2 z) =
        ∑ i ∈ s,
          (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
            JointWaveSpaceTime Complex) (R i) (WithLp.toLp 2 z)
    simpa only [Finset.sum_apply] using congrFun
      (map_sum
        (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
          JointWaveSpaceTime Complex) R s)
      (WithLp.toLp 2 z)
  have hLint : Integrable
      (fun z : WaveSpaceTime => ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) volume := by
    have h := integrable_norm_sq_jointSchwartzRaw Rsum
    rw [← hsumraw] at h
    exact h
  have hRint (i : ι) (hi : i ∈ s) : Integrable
      (fun z : WaveSpaceTime => ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) volume :=
    integrable_norm_sq_jointSchwartzRaw (R i)
  have hsumint : Integrable
      (fun z : WaveSpaceTime => ∑ i ∈ s,
        ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) volume :=
    integrable_finsetSum s hRint
  calc
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) ≤
        ∫ z : WaveSpaceTime, M * ∑ i ∈ s,
          ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
      apply integral_mono hLint (hsumint.const_mul M)
      intro z
      exact norm_sq_sum_jointSchwartzRaw_le_of_support_multiplicity
        s R A M hM hR z
    _ = M * ∫ z : WaveSpaceTime, ∑ i ∈ s,
        ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
      rw [integral_const_mul]
    _ = M * ∑ i ∈ s, ∫ z : WaveSpaceTime,
        ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
      rw [integral_finsetSum s hRint]

private theorem integral_norm_sq_sum_jointInversePacket_eq_sum_jointSchwartzRaw
    {ι : Type*} (s : Finset ι)
    (R : ι → SchwartzMap JointWaveSpaceTime Complex) :
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointInversePacket (R i) z‖ ^ (2 : Nat)) =
      ∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
  classical
  let Rinv : SchwartzMap JointWaveSpaceTime Complex :=
    ∑ i ∈ s, FourierTransform.fourierInv (R i)
  have hphysical : (fun z : WaveSpaceTime => ∑ i ∈ s, jointInversePacket (R i) z) =
      jointSchwartzRaw Rinv := by
    funext z
    unfold jointInversePacket
    change (∑ i ∈ s,
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex) (FourierTransform.fourierInv (R i))
        (WithLp.toLp 2 z)) = _
    dsimp only [Rinv, jointSchwartzRaw]
    symm
    change
      (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ i ∈ s, FourierTransform.fourierInv (R i)) (WithLp.toLp 2 z) = _
    simpa only [Finset.sum_apply] using congrFun
      (map_sum
        (FunLike.coeAddMonoidHom (SchwartzMap JointWaveSpaceTime Complex)
          JointWaveSpaceTime Complex)
        (fun i => FourierTransform.fourierInv (R i)) s)
      (WithLp.toLp 2 z)
  have hfrequency : jointSchwartzRaw (FourierTransform.fourier Rinv) =
      fun z : WaveSpaceTime => ∑ i ∈ s, jointSchwartzRaw (R i) z := by
    funext z
    dsimp only [Rinv]
    rw [FourierTransform.fourier_sum]
    simp only [FourierTransform.fourier_fourierInv_eq]
    exact jointSchwartzRaw_finset_sum_apply s R z
  calc
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointInversePacket (R i) z‖ ^ (2 : Nat)) =
        ∫ z : WaveSpaceTime, ‖jointSchwartzRaw Rinv z‖ ^ (2 : Nat) := by
      change (∫ z : WaveSpaceTime,
        ‖(fun z => ∑ i ∈ s, jointInversePacket (R i) z) z‖ ^ (2 : Nat)) = _
      rw [hphysical]
    _ = ∫ z : WaveSpaceTime,
        ‖jointSchwartzRaw (FourierTransform.fourier Rinv) z‖ ^ (2 : Nat) :=
      integral_norm_sq_jointSchwartzRaw_fourier_eq Rinv
    _ = ∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat) := by
      rw [hfrequency]

private theorem integral_norm_sq_sum_jointInversePacket_le_of_support_multiplicity
    {ι : Type*} (s : Finset ι)
    (R : ι → SchwartzMap JointWaveSpaceTime Complex)
    (A : ι → Set WaveSpaceTime) (M : Real)
    (hM : ∀ z : WaveSpaceTime,
      ((@Finset.filter ι (fun i => z ∈ A i) (Classical.decPred _) s).card : Real) ≤ M)
    (hR : ∀ i ∈ s, Function.support (jointSchwartzRaw (R i)) ⊆ A i) :
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointInversePacket (R i) z‖ ^ (2 : Nat)) ≤
      M * ∑ i ∈ s, ∫ z : WaveSpaceTime,
        ‖jointInversePacket (R i) z‖ ^ (2 : Nat) := by
  classical
  rw [integral_norm_sq_sum_jointInversePacket_eq_sum_jointSchwartzRaw]
  calc
    (∫ z : WaveSpaceTime, ‖∑ i ∈ s, jointSchwartzRaw (R i) z‖ ^ (2 : Nat)) ≤
        M * ∑ i ∈ s, ∫ z : WaveSpaceTime,
          ‖jointSchwartzRaw (R i) z‖ ^ (2 : Nat) :=
      integral_norm_sq_sum_jointSchwartzRaw_le_of_support_multiplicity s R A M hM hR
    _ = M * ∑ i ∈ s, ∫ z : WaveSpaceTime,
        ‖jointInversePacket (R i) z‖ ^ (2 : Nat) := by
      apply congrArg (fun x : Real => M * x)
      apply Finset.sum_congr rfl
      intro i hi
      simpa only [jointInversePacket, FourierTransform.fourier_fourierInv_eq] using
        (integral_norm_sq_jointSchwartzRaw_fourier_eq
          (FourierTransform.fourierInv (R i))).symm

private theorem integral_norm_sq_angularPairProducts_le_of_plateMultiplicity
    (scale gamma angularConstant : Real) (n n' : Int)
    (angularIndices : Finset Int) (directions : Int → Euclidean 2) (k : Nat)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex)
    (hP : ∀ nu ∈ angularIndices,
      Function.support (jointSchwartzRaw (P n nu)) ⊆
        conicPlate scale gamma angularConstant n (directions nu))
    (hP' : ∀ nu ∈ angularIndices,
      Function.support (jointSchwartzRaw (P n' nu)) ⊆
        conicPlate scale gamma angularConstant n' (directions nu))
    (M : Real)
    (hM : ∀ Z : WaveSpaceTime,
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤ M) :
    (∫ z : WaveSpaceTime,
      ‖∑ pair ∈ angularSeparationPairs angularIndices k,
        jointInversePacket
          (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
            (P n pair.1) (P n' pair.2)) z‖ ^ (2 : Nat)) ≤
      M * ∑ pair ∈ angularSeparationPairs angularIndices k,
        ∫ z : WaveSpaceTime,
          ‖jointInversePacket
            (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
              (P n pair.1) (P n' pair.2)) z‖ ^ (2 : Nat) := by
  classical
  let pairs := angularSeparationPairs angularIndices k
  let R : Int × Int → SchwartzMap JointWaveSpaceTime Complex := fun pair =>
    SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
      (P n pair.1) (P n' pair.2)
  let A : Int × Int → Set WaveSpaceTime := fun pair =>
    minkowskiSum (conicPlate scale gamma angularConstant n (directions pair.1))
      (conicPlate scale gamma angularConstant n' (directions pair.2))
  have hactive : ∀ Z : WaveSpaceTime,
      ((@Finset.filter (Int × Int) (fun pair => Z ∈ A pair) (Classical.decPred _) pairs).card :
        Real) ≤ M := by
    intro Z
    simpa only [pairs, A, plateOverlapPairs, plateOverlapMultiplicity] using hM Z
  have hR : ∀ pair ∈ pairs, Function.support (jointSchwartzRaw (R pair)) ⊆ A pair := by
    intro pair hpair
    have hpair' : pair ∈ angularSeparationPairs angularIndices k := by
      simpa only [pairs] using hpair
    have hdata := (mem_angularSeparationPairs_iff angularIndices k pair).mp hpair'
    dsimp only [R, A]
    exact support_jointSchwartzRaw_convolution_subset_minkowski
      (P n pair.1) (P n' pair.2)
      (conicPlate scale gamma angularConstant n (directions pair.1))
      (conicPlate scale gamma angularConstant n' (directions pair.2))
      (hP pair.1 hdata.1) (hP' pair.2 hdata.2.1)
  simpa only [pairs, R] using
    integral_norm_sq_sum_jointInversePacket_le_of_support_multiplicity
      pairs R A M hactive hR

/-- The finite fourth-power expansion underlying angular--radial recombination. -/
private theorem aux_angularRadialRecombinedSquareFunction_pow_four_eq
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H z) ^ (4 : Nat) =
      ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖(∑ nu ∈ angularIndices, H n nu z) *
          (∑ nu' ∈ angularIndices, H n' nu' z)‖ ^ (2 : Nat) := by
  have hsq :
      (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H z) ^ (2 : Nat) =
        ∑ n ∈ radialIndices, ‖∑ nu ∈ angularIndices, H n nu z‖ ^ (2 : Nat) := by
    unfold aux_angularRadialRecombinedSquareFunction
    rw [Real.sq_sqrt]
    exact Finset.sum_nonneg fun _ _ => sq_nonneg _
  calc
    (aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H z) ^ (4 : Nat) =
        ((aux_angularRadialRecombinedSquareFunction radialIndices angularIndices H z) ^ (2 : Nat)) ^
          (2 : Nat) := by ring
    _ = (∑ n ∈ radialIndices, ‖∑ nu ∈ angularIndices, H n nu z‖ ^ (2 : Nat)) ^
          (2 : Nat) := by rw [hsq]
    _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖∑ nu ∈ angularIndices, H n nu z‖ ^ (2 : Nat) *
          ‖∑ nu' ∈ angularIndices, H n' nu' z‖ ^ (2 : Nat) := by
      rw [pow_two, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro n hn
      rw [Finset.mul_sum]
    _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ‖(∑ nu ∈ angularIndices, H n nu z) *
          (∑ nu' ∈ angularIndices, H n' nu' z)‖ ^ (2 : Nat) := by
      apply Finset.sum_congr rfl
      intro n hn
      apply Finset.sum_congr rfl
      intro n' hn'
      rw [norm_mul]
      ring

private theorem angularRadialSquareFunction_pow_four_eq
    (radialIndices angularIndices : Finset Int)
    (H : Int → Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (angularRadialSquareFunction radialIndices angularIndices H z) ^ (4 : Nat) =
      ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
          ‖H n nu z * H n' nu' z‖ ^ (2 : Nat) := by
  have hsq :
      (angularRadialSquareFunction radialIndices angularIndices H z) ^ (2 : Nat) =
        ∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, ‖H n nu z‖ ^ (2 : Nat) := by
    unfold angularRadialSquareFunction
    rw [Real.sq_sqrt]
    exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => sq_nonneg _
  calc
    (angularRadialSquareFunction radialIndices angularIndices H z) ^ (4 : Nat) =
        ((angularRadialSquareFunction radialIndices angularIndices H z) ^ (2 : Nat)) ^ (2 : Nat) :=
            by
      ring
    _ = (∑ n ∈ radialIndices, ∑ nu ∈ angularIndices, ‖H n nu z‖ ^ (2 : Nat)) ^
          (2 : Nat) := by rw [hsq]
    _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        (∑ nu ∈ angularIndices, ‖H n nu z‖ ^ (2 : Nat)) *
          (∑ nu' ∈ angularIndices, ‖H n' nu' z‖ ^ (2 : Nat)) := by
      rw [pow_two, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro n hn
      rw [Finset.mul_sum]
    _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
          ‖H n nu z‖ ^ (2 : Nat) * ‖H n' nu' z‖ ^ (2 : Nat) := by
      apply Finset.sum_congr rfl
      intro n hn
      apply Finset.sum_congr rfl
      intro n' hn'
      rw [Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro nu hnu
      rw [Finset.mul_sum]
    _ = ∑ n ∈ radialIndices, ∑ n' ∈ radialIndices,
        ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
          ‖H n nu z * H n' nu' z‖ ^ (2 : Nat) := by
      apply Finset.sum_congr rfl
      intro n hn
      apply Finset.sum_congr rfl
      intro n' hn'
      apply Finset.sum_congr rfl
      intro nu hnu
      apply Finset.sum_congr rfl
      intro nu' hnu'
      rw [norm_mul]
      ring

private theorem sum_mul_sum_jointInversePacket_eq_pair_sum
    (angularIndices : Finset Int)
    (P : Int → Int → SchwartzMap JointWaveSpaceTime Complex)
    (n n' : Int) (z : WaveSpaceTime) :
    (∑ nu ∈ angularIndices, jointInversePacket (P n nu) z) *
        (∑ nu' ∈ angularIndices, jointInversePacket (P n' nu') z) =
      ∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket
          (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
            (P n pair.1) (P n' pair.2)) z := by
  calc
    (∑ nu ∈ angularIndices, jointInversePacket (P n nu) z) *
        (∑ nu' ∈ angularIndices, jointInversePacket (P n' nu') z) =
      ∑ nu ∈ angularIndices, ∑ nu' ∈ angularIndices,
        jointInversePacket (P n nu) z * jointInversePacket (P n' nu') z := by
          rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro nu hnu
          rw [Finset.mul_sum]
    _ = ∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket (P n pair.1) z * jointInversePacket (P n' pair.2) z := by
          exact (Finset.sum_product angularIndices angularIndices
            (fun pair : Int × Int =>
              jointInversePacket (P n pair.1) z * jointInversePacket (P n' pair.2) z)).symm
    _ = ∑ pair ∈ angularIndices.product angularIndices,
        jointInversePacket
          (SchwartzMap.convolution (ContinuousLinearMap.mul Complex Complex)
            (P n pair.1) (P n' pair.2)) z := by
          apply Finset.sum_congr rfl
          intro pair hpair
          exact (jointInversePacket_convolution_eq_mul (P n pair.1) (P n' pair.2) z).symm

