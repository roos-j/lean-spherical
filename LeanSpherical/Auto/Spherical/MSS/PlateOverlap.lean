theorem finset_card_le_two_of_forall_mem_eq_or_eq {α : Type*}
    (s : Finset α)
    (h : ∀ a ∈ s, ∀ b ∈ s, a ≠ b → ∀ c ∈ s, c = a ∨ c = b) :
