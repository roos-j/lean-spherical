    exact dist_zero_zeroThicknessPlatePairSum_first hradius hfirst
  · rw [EuclideanGeometry.mem_sphere]
    have hspatial : (zeroThicknessPlatePairSum radius radius' directions pair).1 = Z.1 :=
      congrArg Prod.fst hpairBase.2
    rw [← hspatial]
    exact dist_zeroThicknessPlatePairSum_first_spatial hradius' hsecond

/-- In the nondegenerate-output case, the planar zero-thickness overlap
fiber has multiplicity at most two.  The proof uses the exact two-circle
intersection theorem in `ℝ²`, together with the angular-spacing hypothesis
to recover ordered labels from the first spatial summand. -/
theorem zeroThicknessPlateOvlMultiplicity_le_two_of_angSectorGeometry_of_spat_ne_zero
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') (hZ : Z.1 ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  let firstPoints := active.image (fun pair : Int × Int => radius • directions pair.1)
  have hinjective : Set.InjOn (fun pair : Int × Int => radius • directions pair.1)
      (active : Set (Int × Int)) := by
    simpa [active] using
      (zeroThicknessPlateOverlapPairs_firstSpatial_injective_of_angularSectorGeometry
        k Z hscale hgeometry hradius.ne' hradius'.ne')
  let s₁ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨0, radius⟩
  let s₂ : EuclideanGeometry.Sphere (Euclidean 2) := ⟨Z.1, radius'⟩
  have hspheres : s₁ ≠ s₂ := by
    intro hs
    have hcenters := congrArg EuclideanGeometry.Sphere.center hs
    change (0 : Euclidean 2) = Z.1 at hcenters
    exact hZ hcenters.symm
  have hfinrank : Module.finrank Real (Euclidean 2) = 2 := by
    simp [Euclidean]
  have hcircle : ∀ p ∈ firstPoints, p ∈ s₁ ∧ p ∈ s₂ := by
    intro p hp
    simpa [firstPoints, active, s₁, s₂] using
      (mem_zeroThicknessPlateOverlapFirstSpatialPoints_two_spheres k Z hgeometry
        hradius.le hradius'.le hp)
  have hpointsCard : firstPoints.card ≤ 2 := by
    apply finset_card_le_two_of_forall_mem_eq_or_eq
    intro a ha b hb hab c hc
    rcases hcircle a ha with ⟨ha₁, ha₂⟩
    rcases hcircle b hb with ⟨hb₁, hb₂⟩
    rcases hcircle c hc with ⟨hc₁, hc₂⟩
    exact EuclideanGeometry.eq_of_mem_sphere_of_mem_sphere_of_finrank_eq_two
      hfinrank hspheres hab ha₁ hb₁ hc₁ ha₂ hb₂ hc₂
  have hcard : active.card = firstPoints.card := by
    change active.card =
      (active.image (fun pair : Int × Int => radius • directions pair.1)).card
    exact (Finset.card_image_of_injOn hinjective).symm
  calc
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z = active.card := rfl
    _ = firstPoints.card := hcard
    _ ≤ 2 := hpointsCard

/-- The fully nondegenerate zero-thickness plate-overlap theorem in the
stated planar angular-sector geometry.  If the fiber is nonempty, the common
sector condition forces its output spatial frequency to be nonzero, so the
two-circle intersection argument applies; if it is empty the conclusion is
immediate. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius') :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  by_cases hnonempty :
      (zeroThicknessPlateOverlapPairs radius radius' indices directions k Z).Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [zeroThicknessPlateOverlapPairs] using hpair
    have hi : pair.1 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
    have hj : pair.2 ∈ indices :=
      (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.2.1
    have hsumNe : (zeroThicknessPlatePairSum radius radius' directions pair).1 ≠ 0 :=
      zeroThicknessPlatePairSum_spatial_ne_zero_of_angularSectorGeometry
        hgeometry hradius hradius' hi hj
    have hZ : Z.1 ≠ 0 := by
      intro hzero
      apply hsumNe
      rw [hpairBase.2, hzero]
    exact
      zeroThicknessPlateOvlMultiplicity_le_two_of_angSectorGeometry_of_spat_ne_zero
        k Z hscale hgeometry hradius hradius' hZ
  · have hempty : zeroThicknessPlateOverlapPairs radius radius' indices directions k Z = ∅ :=
      Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [zeroThicknessPlateOverlapMultiplicity, hempty]

/-- The elementary zero-thickness plate-overlap bound furnished directly by
the prescribed angular-sector geometry.  Once the first label is fixed, a
nonzero second radius and equality of pair sums determine the second
direction, and the lower spacing condition determines its label.  Thus the
active ordered-pair fiber injects into its first-label projection.  This is
a genuine linear finite-overlap reduction; the sharp MSS geometry improves
the remaining cardinality factor to a scale-small bound. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_card_of_angularSectorGeometry
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius' : radius' ≠ 0) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤
      indices.card := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  have hmaps : Set.MapsTo Prod.fst (active : Set (Int × Int)) (indices : Set Int) := by
    intro pair hpair
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    exact (mem_angularSeparationPairs_iff indices k pair).mp hpairBase.1 |>.1
  have hinjective : (active : Set (Int × Int)).InjOn Prod.fst := by
    intro pair hpair pair' hpair' hfst
    rcases pair with ⟨i, j⟩
    rcases pair' with ⟨i', j'⟩
    change i = i' at hfst
    subst i'
    have hpairBase : (i, j) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j) = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hpairBase' : (i, j') ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions (i, j') = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair'
    have hj : j ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j)).mp hpairBase.1 |>.2.1
    have hj' : j' ∈ indices :=
      (mem_angularSeparationPairs_iff indices k (i, j')).mp hpairBase'.1 |>.2.1
    have hsum : zeroThicknessPlatePairSum radius radius' directions (i, j) =
        zeroThicknessPlatePairSum radius radius' directions (i, j') :=
      hpairBase.2.trans hpairBase'.2.symm
    exact Prod.ext rfl
      (zeroThicknessPlatePairSum_right_injective_of_angularSectorGeometry
        hscale hgeometry hj hj' hradius' hsum)
  change active.card ≤ indices.card
  exact Finset.card_le_card_of_injOn Prod.fst hmaps hinjective

/-- A strengthened geometric hypothesis for the fixed-radius model: a
pair-sum fiber contains only a pair itself and, at most, its reversed ordered
pair.  This is the appropriate replacement for literal injectivity because
equal-radius sums are invariant under swapping the two directions. -/
def zeroThicknessPairSumAtMostTwo (radius radius' : Real)
    (indices : Finset Int) (directions : Int → Euclidean 2) (k : Nat) : Prop :=
  ∀ ⦃pair⦄, pair ∈ angularSeparationPairs indices k →
    ∀ ⦃pair'⦄, pair' ∈ angularSeparationPairs indices k →
      zeroThicknessPlatePairSum radius radius' directions pair =
        zeroThicknessPlatePairSum radius radius' directions pair' →
        pair = pair' ∨ pair = (pair'.2, pair'.1)

/-- Under the explicit two-to-one pair-sum geometry, every zero-thickness
model overlap multiplicity is at most two. -/
theorem zeroThicknessPlateOverlapMultiplicity_le_two_of_pairSumAtMostTwo
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (hgeom : zeroThicknessPairSumAtMostTwo radius radius' indices directions k) :
    zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z ≤ 2 := by
  classical
  let active := zeroThicknessPlateOverlapPairs radius radius' indices directions k Z
  by_cases hnonempty : active.Nonempty
  · obtain ⟨pair, hpair⟩ := hnonempty
    have hpairBase : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius' directions pair = Z := by
      simpa [active, zeroThicknessPlateOverlapPairs] using hpair
    have hsubset : active ⊆ ({pair, (pair.2, pair.1)} : Finset (Int × Int)) := by
      intro pair' hactive
      have hpairActive : pair' ∈ angularSeparationPairs indices k ∧
          zeroThicknessPlatePairSum radius radius' directions pair' = Z := by
        simpa [active, zeroThicknessPlateOverlapPairs] using hactive
      rcases hgeom (pair := pair') hpairActive.1 (pair' := pair) hpairBase.1
        (hpairActive.2.trans hpairBase.2.symm) with h | h
      · exact Finset.mem_insert.mpr (Or.inl h)
      · exact Finset.mem_insert.mpr
          (Or.inr (Finset.mem_singleton.mpr h))
    change active.card ≤ 2
    exact (Finset.card_le_card hsubset).trans Finset.card_le_two
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    change active.card ≤ 2
    simp [hempty]

/-- At equal radii the zero-thickness pair-sum is invariant under swapping
the two ordered angular labels. -/
theorem zeroThicknessPlatePairSum_swap (radius : Real)
    (directions : Int → Euclidean 2) (pair : Int × Int) :
    zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) =
      zeroThicknessPlatePairSum radius radius directions pair := by
  simp [zeroThicknessPlatePairSum, add_comm]

/-- The swap symmetry gives an exact obstruction to a false multiplicity-one
claim for ordered pairs at equal radii. -/
theorem two_le_zeroThicknessPlateOverlapMultiplicity_of_offDiagonalPair
    (radius : Real) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (pair : Int × Int)
    (hpair : pair ∈ angularSeparationPairs indices k)
    (hoff : pair ≠ (pair.2, pair.1)) :
    2 ≤ zeroThicknessPlateOverlapMultiplicity radius radius indices directions k
      (zeroThicknessPlatePairSum radius radius directions pair) := by
  classical
  let Z := zeroThicknessPlatePairSum radius radius directions pair
  let active := zeroThicknessPlateOverlapPairs radius radius indices directions k Z
  have hswap : (pair.2, pair.1) ∈ angularSeparationPairs indices k :=
    (mem_swap_angularSeparationPairs_iff indices k pair.1 pair.2).mpr hpair
  have hpairActive : pair ∈ active := by
    have : pair ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions pair = Z := ⟨hpair, rfl⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hswapActive : (pair.2, pair.1) ∈ active := by
    have hsum : zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z := by
      simpa [Z] using zeroThicknessPlatePairSum_swap radius directions pair
    have : (pair.2, pair.1) ∈ angularSeparationPairs indices k ∧
        zeroThicknessPlatePairSum radius radius directions (pair.2, pair.1) = Z :=
      ⟨hswap, hsum⟩
    simpa [active, zeroThicknessPlateOverlapPairs] using this
  have hsubset : ({pair, (pair.2, pair.1)} : Finset (Int × Int)) ⊆ active := by
    intro pair' hpair'
    simp only [Finset.mem_insert, Finset.mem_singleton] at hpair'
    rcases hpair' with h | h
    · simpa [h] using hpairActive
    · simpa [h] using hswapActive
  change 2 ≤ active.card
  calc
    2 = ({pair, (pair.2, pair.1)} : Finset (Int × Int)).card :=
      (Finset.card_pair hoff).symm
    _ ≤ active.card := Finset.card_le_card hsubset

/-- A unit-normal-thickness conic plate translated in the normal coordinate.
The radial and angular windows are unchanged.  This is the genuinely needed
input for a thick-plate cover argument; it is not the zero-thickness model. -/
def unitNormalConicPlate (scale angularConstant normalShift : Real) (n : Int)
    (direction : Euclidean 2) : Set WaveSpaceTime :=
  {ζ | scale / 4 ≤ ‖ζ.1‖ ∧ ‖ζ.1‖ ≤ 4 * scale ∧
    ζ.1 ∈ angularSector direction
      (angularConstant * scale ^ (-(1 / 2 : Real))) ∧
    |(Real.sqrt scale)⁻¹ * ζ.2 - n| ≤ 1 ∧
    |(ζ.2 - ‖ζ.1‖) - normalShift| ≤ 2}

/-- A finite normal-coordinate cover of each thick conic plate by translated
unit-normal-thickness plates. -/
def normalCoordinatePlateCover (scale gamma angularConstant : Real)
    (normalShifts : Finset Real) : Prop :=
  ∀ (n : Int) (direction : Euclidean 2) (ζ : WaveSpaceTime),
    ζ ∈ conicPlate scale gamma angularConstant n direction →
      ∃ shift ∈ normalShifts,
        ζ ∈ unitNormalConicPlate scale angularConstant shift n direction

/-- The finite family of angular pairs whose translated unit-normal-thickness
plates can contribute to a prescribed Minkowski-sum frequency. -/
noncomputable def unitNormalPlateOverlapPairs
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
      (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)))

/-- Membership in a translated unit-normal-thickness overlap fiber. -/
theorem mem_unitNormalPlateOverlapPairs_iff
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (unitNormalConicPlate scale angularConstant normalShift n (directions pair.1))
          (unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2)) := by
  classical
  simp [unitNormalPlateOverlapPairs]

/-- The cardinality of a translated unit-normal-thickness overlap fiber. -/
noncomputable def unitNormalPlateOverlapMultiplicity
    (scale angularConstant : Real) (normalShift normalShift' : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z).card

/-- Every real normal coordinate is within unit-normal thickness of a
translate from the `4 ℤ` lattice. -/
theorem abs_sub_four_mul_floor_le_two (q : Real) :
    |q - 4 * (⌊(q + 2) / 4⌋ : Int)| ≤ 2 := by
  have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
    Int.floor_le _
  have hlt : (q + 2) / 4 < ((⌊(q + 2) / 4⌋ : Int) : Real) + 1 :=
    Int.lt_floor_add_one _
  rw [abs_le]
  constructor <;> linarith

/-- The explicit finite `4 ℤ` normal-coordinate cover of a window with
radius `2 * R`. -/
noncomputable def normalCoverShifts (R : Real) : Finset Real :=
  (Finset.Icc (-⌈R / 2⌉ - 1) (⌈R / 2⌉ + 1)).image
    (fun m : Int => (4 : Real) * m)

/-- The floor-selected normal translate belongs to the explicit cover range. -/
theorem floor_mem_normalCoverShifts (R q : Real)
    (hq : |q| ≤ 2 * R) :
    (4 : Real) * (⌊(q + 2) / 4⌋ : Int) ∈ normalCoverShifts R := by
  refine Finset.mem_image.mpr ?_
  refine ⟨⌊(q + 2) / 4⌋, ?_, rfl⟩
  rw [Finset.mem_Icc]
  rw [abs_le] at hq
  have hceil : R / 2 ≤ ((⌈R / 2⌉ : Int) : Real) := Int.le_ceil _
  constructor
  · rw [Int.le_floor]
    norm_num
    linarith
  · have hfloor : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤ (q + 2) / 4 :=
      Int.floor_le _
    have hcast : ((⌊(q + 2) / 4⌋ : Int) : Real) ≤
        ((⌈R / 2⌉ + 1 : Int) : Real) := by
      norm_num
      linarith
    exact_mod_cast hcast

/-- The explicit `4 ℤ` family covers the normal window of every thick plate.
This is a direct interval calculation; no conic-overlap geometry is used. -/
theorem normalCoordinatePlateCover_normalCoverShifts
    (scale gamma angularConstant : Real) :
    normalCoordinatePlateCover scale gamma angularConstant
      (normalCoverShifts (scale ^ gamma)) := by
  intro n direction z hz
  rcases hz with ⟨hradialLower, hradialUpper, hangular, hvør, hnormal⟩
  let q : Real := z.2 - ‖z.1‖
  let shift : Real := 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)
  refine ⟨shift, ?_, ?_⟩
  · change (4 : Real) * ((⌊(q + 2) / 4⌋ : Int) : Real) ∈
      normalCoverShifts (scale ^ gamma)
    apply floor_mem_normalCoverShifts
    simpa [q] using hnormal
  · exact ⟨hradialLower, hradialUpper, hangular, hvør, by
      change |q - 4 * ((⌊(q + 2) / 4⌋ : Int) : Real)| ≤ 2
      exact abs_sub_four_mul_floor_le_two q⟩

/-- The explicit normal-coordinate cover has at most `6 R` members whenever
`R ≥ 1`. -/
theorem card_normalCoverShifts_le_six_mul (R : Real) (hR : 1 ≤ R) :
    ((normalCoverShifts R).card : Real) ≤ 6 * R := by
  let c : Int := ⌈R / 2⌉
  have hc : R / 2 ≤ (c : Real) := by
    exact Int.le_ceil _
  have hc0 : 0 ≤ c := by
    have hc0real : 0 ≤ (c : Real) := by linarith
    exact_mod_cast hc0real
  have hcount_nonneg : 0 ≤ c + 1 + 1 - (-c - 1) := by omega
  have hcard : (normalCoverShifts R).card ≤
      (Finset.Icc (-c - 1) (c + 1)).card := by
    unfold normalCoverShifts
    exact Finset.card_image_le
  have hIcc : (Finset.Icc (-c - 1) (c + 1)).card = (2 * c + 3).toNat := by
    rw [Int.card_Icc]
    congr 1
    omega
  have hcount : (((2 * c + 3).toNat : Nat) : Real) = 2 * (c : Real) + 3 := by
    have hcast : (((2 * c + 3).toNat : Nat) : Int) = 2 * c + 3 :=
      Int.toNat_of_nonneg (by omega)
    exact_mod_cast hcast
  have hcardReal : ((normalCoverShifts R).card : Real) ≤
      2 * (c : Real) + 3 := by
    have hnat : (normalCoverShifts R).card ≤ (2 * c + 3).toNat :=
      hcard.trans_eq hIcc
    have hnatReal : ((normalCoverShifts R).card : Real) ≤
        (((2 * c + 3).toNat : Nat) : Real) := by
      exact_mod_cast hnat
    rw [hcount] at hnatReal
    exact hnatReal
  have hcupper : (c : Real) < R / 2 + 1 := by
    exact_mod_cast Int.ceil_lt_add_one (R / 2)
  linarith

/-- At the MSS scales, the explicit normal-coordinate cover has cardinality
at most `6 * scale^gamma`. -/
theorem card_normalCoverShifts_at_scale_le_six_mul
    (scale gamma : Real) (hscale : 2 ≤ scale) (hgamma : 0 ≤ gamma) :
    ((normalCoverShifts (scale ^ gamma)).card : Real) ≤ 6 * scale ^ gamma := by
  apply card_normalCoverShifts_le_six_mul
  apply Real.one_le_rpow
  · linarith
  · exact hgamma

/-- The finite family of angular pairs whose two conic plates can contribute
to a prescribed Minkowski-sum frequency. -/
noncomputable def plateOverlapPairs (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (angularSeparationPairs indices k).filter (fun pair =>
    Z ∈ minkowskiSum (conicPlate scale gamma angularConstant n (directions pair.1))
      (conicPlate scale gamma angularConstant n' (directions pair.2)))

/-- Membership in the active pair family is precisely angular separation
together with containment of the prescribed frequency in the plate sum. -/
theorem mem_plateOverlapPairs_iff (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ↔
      pair ∈ angularSeparationPairs indices k ∧
        Z ∈ minkowskiSum
          (conicPlate scale gamma angularConstant n (directions pair.1))
          (conicPlate scale gamma angularConstant n' (directions pair.2)) := by
  classical
  simp [plateOverlapPairs]

/-- Active plate-overlap pairs form a subfamily of the fixed separation
class. -/
theorem plateOverlapPairs_subset_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      angularSeparationPairs indices k := by
  classical
  rw [plateOverlapPairs]
  exact Finset.filter_subset _ _

/-- The number of pairs of conic plates at a prescribed angular separation
whose Minkowski sum contains a given frequency point. -/
noncomputable def plateOverlapMultiplicity (scale gamma angularConstant : Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Nat :=
  (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card

/-- The overlap multiplicity is exactly the cardinality of its active finite
pair family. -/
theorem plateOverlapMultiplicity_eq_card_plateOverlapPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
      (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl

private noncomputable def normalCoverOverlapPairs
    (scale angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) : Finset (Int × Int) := by
  classical
  exact (normalShifts.product normalShifts).biUnion (fun shifts =>
    unitNormalPlateOverlapPairs scale angularConstant shifts.1 shifts.2
      n n' indices directions k Z)

private theorem plateOverlapPairs_subset_normalCoverOverlapPairs
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts) :
    plateOverlapPairs scale gamma angularConstant n n' indices directions k Z ⊆
      normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z := by
  classical
  intro pair hpair
  rcases (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z pair).mp
    hpair with ⟨hseparation, hsum⟩
  rcases hsum with ⟨z, hz, w, hw, hzw⟩
  rcases hcover n (directions pair.1) z hz with ⟨shift, hshift, hzshift⟩
  rcases hcover n' (directions pair.2) w hw with ⟨shift', hshift', hwshift⟩
  apply Finset.mem_biUnion.mpr
  refine ⟨(shift, shift'), Finset.mem_product.mpr ⟨hshift, hshift'⟩, ?_⟩
  apply (mem_unitNormalPlateOverlapPairs_iff scale angularConstant shift shift'
    n n' indices directions k Z pair).mpr
  exact ⟨hseparation, ⟨z, hzshift, w, hwshift, hzw⟩⟩

/-- A finite cover by translated unit-normal plates transfers a uniform
unit-normal overlap bound to the original thick plate. -/
theorem plateOverlapMultiplicity_le_normalCover_mul_unitBound
    (scale gamma angularConstant : Real) (normalShifts : Finset Real)
    (n n' : Int) (indices : Finset Int) (directions : Int → Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (M : Nat)
    (hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts)
    (hunit : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' indices directions k Z ≤ M) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      normalShifts.card * normalShifts.card * M := by
  classical
  have hsubset := plateOverlapPairs_subset_normalCoverOverlapPairs
    scale gamma angularConstant normalShifts n n' indices directions k Z hcover
  calc
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z =
        (plateOverlapPairs scale gamma angularConstant n n' indices directions k Z).card := rfl
    _ ≤ (normalCoverOverlapPairs scale angularConstant normalShifts
        n n' indices directions k Z).card := Finset.card_le_card hsubset
    _ ≤ (normalShifts.product normalShifts).card * M := by
      apply Finset.card_biUnion_le_card_mul
      intro shifts hshifts
      rcases Finset.mem_product.mp hshifts with ⟨hleft, hright⟩
      simpa [unitNormalPlateOverlapMultiplicity] using hunit shifts.1 hleft shifts.2 hright
    _ = normalShifts.card * normalShifts.card * M := by
      have hcard : (normalShifts.product normalShifts).card =
          normalShifts.card * normalShifts.card := by
        exact Finset.card_product _ _
      rw [hcard]

/-- Cauchy--Schwarz on the active finite pair family.  The factor is the
literal plate-overlap multiplicity; no geometric bound for it is used. -/
theorem sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F : Int × Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair z‖ ^ 2 := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact sq_sum_le_card_mul_sum_sq

/-- The preceding active-pair inequality in the product form used by the
finite fourth-power calculation. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖(fun pair z => F pair.1 z * G pair.2 z) pair z‖ ^ 2 :=
      sq_sum_norm_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z
        (fun pair z => F pair.1 z * G pair.2 z) z
    _ = (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro pair hpair
      rw [norm_mul]
      ring

/-- A plate-overlap multiplicity is bounded by the number of angular pairs
under consideration. -/
theorem plateOverlapMultiplicity_le_card_angularSeparationPairs
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      (angularSeparationPairs indices k).card := by
  rw [plateOverlapMultiplicity_eq_card_plateOverlapPairs]
  exact Finset.card_le_card
    (plateOverlapPairs_subset_angularSeparationPairs scale gamma angularConstant n n'
      indices directions k Z)

/-- The trivial finite-index bound for a plate-overlap multiplicity.  The
geometric plate-overlap lemma improves this quadratic estimate. -/
theorem plateOverlapMultiplicity_le_card_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime) :
    plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z ≤
      indices.card ^ 2 :=
  (plateOverlapMultiplicity_le_card_angularSeparationPairs scale gamma angularConstant
    n n' indices directions k Z).trans (card_angularSeparationPairs_le indices k)

/-- Substituting the elementary finite pair-count bound gives a fully
geometric-free fourth-power estimate.  The sharp MSS argument replaces this
quadratic factor by the plate-overlap estimate. -/
theorem sq_sum_norm_mul_plateOverlapPairs_le_card_sq_mul_sum_sq
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) ≤
        (indices.card : Real) ^ 2 := by
    exact_mod_cast
      plateOverlapMultiplicity_le_card_sq scale gamma angularConstant n n' indices directions k Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg (‖F pair.1 z‖)) (sq_nonneg (‖G pair.2 z‖))
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' indices directions k Z F G z
    _ ≤ (indices.card : Real) ^ 2 *
        ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- The geometric plate-overlap target.  `maxLevel` is supplied by the
angular decomposition; for the blueprint it is the ceiling-logarithmic bound
on the number of angular sectors.  Unlike an unconstrained family of vectors,
the directions are required to arise from a uniformly spaced, ordered angular
sector geometry.  The multiplicative constant is allowed to depend on the
normal-thickness parameter `gamma`, as in the blueprint. -/
def plateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  0 < angularConstant ∧ ∃ overlapExponent : Real, 0 < overlapExponent ∧
    ∀ gamma : Real, 0 < gamma → gamma < 1 / 10 →
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ∀ scale : Real, 2 ≤ scale → ∀ radialIndices angularIndices : Finset Int,
          ∀ directions : Int → Euclidean 2,
            angularSectorGeometry scale angularIndices directions
              sectorRadius spacingLower spacingUpper →
            ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
              ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
                (plateOverlapMultiplicity scale gamma angularConstant n n'
                  angularIndices directions k Z : Real) ≤
                    Cgamma * scale ^ (overlapExponent * gamma)

/-- The cited geometric input needed by the finite normal-coordinate cover.
It bounds overlap fibers for arbitrary *translated* unit-normal-thickness
plates uniformly in the translations.  This is intentionally stronger than
the proved zero-thickness two-circle theorem. -/
def translatedUnitNormalPlateOverlap (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) : Prop :=
  ∃ M : Nat, ∀ scale : Real, 2 ≤ scale →
    ∀ radialIndices angularIndices : Finset Int,
      ∀ directions : Int → Euclidean 2,
        angularSectorGeometry scale angularIndices directions
          sectorRadius spacingLower spacingUpper →
        ∀ n ∈ radialIndices, ∀ n' ∈ radialIndices,
          ∀ k : Nat, k ≤ maxLevel scale → ∀ Z : WaveSpaceTime,
            ∀ normalShift normalShift' : Real,
              unitNormalPlateOverlapMultiplicity scale angularConstant
                normalShift normalShift' n n' angularIndices directions k Z ≤ M

private theorem aux_abs_time_sub_radialLabel_mul_sqrt_le
    {scale : Real} (hscale : 0 < scale) {n : Int} {t : Real}
    (ht : |(Real.sqrt scale)⁻¹ * t - n| ≤ 1) :
    |t - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  have hs : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hsne : Real.sqrt scale ≠ 0 := ne_of_gt hs
  have hrewrite :
      (Real.sqrt scale)⁻¹ * t - (n : Real) =
        (Real.sqrt scale)⁻¹ * (t - (n : Real) * Real.sqrt scale) := by
    field_simp [hsne]
  rw [hrewrite, abs_mul, abs_of_pos (inv_pos.mpr hs)] at ht
  have hmul := mul_le_mul_of_nonneg_left ht hs.le
  calc
    |t - (n : Real) * Real.sqrt scale| =
        (Real.sqrt scale * (Real.sqrt scale)⁻¹) *
          |t - (n : Real) * Real.sqrt scale| := by
            rw [mul_inv_cancel₀ hsne, one_mul]
    _ = Real.sqrt scale *
          ((Real.sqrt scale)⁻¹ * |t - (n : Real) * Real.sqrt scale|) :=
      mul_assoc _ _ _
    _ ≤ Real.sqrt scale * 1 := hmul
    _ = Real.sqrt scale := by ring

private theorem aux_mem_unitNormalConicPlate_time_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |z.2 - (n : Real) * Real.sqrt scale| ≤ Real.sqrt scale := by
  exact aux_abs_time_sub_radialLabel_mul_sqrt_le hscale hz.2.2.2.1

private theorem aux_mem_unitNormalConicPlate_radius_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤
      Real.sqrt scale + 2 := by
  have htime := aux_mem_unitNormalConicPlate_time_localized hscale hz
  have hnormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  calc
    |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| =
        |(z.2 - (n : Real) * Real.sqrt scale) -
          ((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ = |(z.2 - (n : Real) * Real.sqrt scale) +
          -((z.2 - ‖z.1‖) - normalShift)| := by ring_nf
    _ ≤ |z.2 - (n : Real) * Real.sqrt scale| +
          |-((z.2 - ‖z.1‖) - normalShift)| := abs_add_le _ _
    _ = |z.2 - (n : Real) * Real.sqrt scale| +
          |(z.2 - ‖z.1‖) - normalShift| := by rw [abs_neg]
    _ ≤ Real.sqrt scale + 2 := add_le_add htime hnormal

private theorem aux_mem_unitNormalConicPlate_direction_localized
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {z : WaveSpaceTime}
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    z.1 ≠ 0 ∧
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := by
  exact hz.2.2.1

private theorem aux_mem_minkowskiSum_unitNormalConicPlate_twoCone
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z : WaveSpaceTime}
    (hZ : Z ∈ minkowskiSum
      (unitNormalConicPlate scale angularConstant normalShift n direction)
      (unitNormalConicPlate scale angularConstant normalShift' n' direction')) :
    ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n direction,
      ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction',
        z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
  rcases hZ with ⟨z, hz, w, hw, hsum⟩
  refine ⟨z, hz, w, hw, hsum, ?_⟩
  have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hsum
  have hzNormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
  have hwNormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
  calc
    |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
        |((z.2 - ‖z.1‖) - normalShift) +
          ((w.2 - ‖w.1‖) - normalShift')| := by
            rw [← htime]
            ring_nf
    _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
    _ ≤ 4 := by linarith

private theorem aux_twoCone_polar_identity
    (X x : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    2 * ‖x‖ *
        ((‖x‖ + ‖X - x‖) -
          inner Real X (‖x‖⁻¹ • x)) =
      (‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖X - x‖
  let u : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 := r⁻¹ • x
  have hr : r ≠ 0 := by simpa only [r] using hx
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hinner : inner Real X x = r * inner Real X u := by
    rw [hxu, inner_smul_right]
  have hnorm : s ^ 2 = ‖X‖ ^ 2 - 2 * inner Real X x + r ^ 2 := by
    simpa only [r, s] using norm_sub_sq_real X x
  change 2 * r * ((r + s) - inner Real X u) = (r + s) ^ 2 - ‖X‖ ^ 2
  rw [show inner Real X u = r⁻¹ * inner Real X x by
    dsimp [u]
    rw [inner_smul_right]]
  field_simp [hr]
  nlinarith [hnorm]

private theorem aux_twoCone_polar_solve_inner
    (X x : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (hx : ‖x‖ ≠ 0) :
    inner Real X (‖x‖⁻¹ • x) =
      (‖x‖ + ‖X - x‖) -
        ((‖x‖ + ‖X - x‖) ^ 2 - ‖X‖ ^ 2) / (2 * ‖x‖) := by
  have h := aux_twoCone_polar_identity X x hx
  have hden : 2 * ‖x‖ ≠ 0 := mul_ne_zero (by norm_num) hx
  field_simp [hden] at h ⊢
  linarith

/-- The output radial defect is exactly the squared chordal angular defect of
the two normalized inputs.  This is the quantitative invariant separating the
transverse and near-tangent branches. -/
private theorem aux_twoCone_angular_defect_identity
    (x y : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (hx : ‖x‖ ≠ 0) (hy : ‖y‖ ≠ 0) :
    (‖x‖ + ‖y‖) ^ 2 - ‖x + y‖ ^ 2 =
      ‖x‖ * ‖y‖ * ‖(‖x‖)⁻¹ • x - (‖y‖)⁻¹ • y‖ ^ 2 := by
  let r : Real := ‖x‖
  let s : Real := ‖y‖
  let u : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 := r⁻¹ • x
  let v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 := s⁻¹ • y
  have hrpos : 0 < r := by
    dsimp [r]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hx)
  have hspos : 0 < s := by
    dsimp [s]
    exact lt_of_le_of_ne (norm_nonneg _) (Ne.symm hy)
  have hr : r ≠ 0 := ne_of_gt hrpos
  have hs : s ≠ 0 := ne_of_gt hspos
  have hunitu : ‖u‖ = 1 := by
    change ‖r⁻¹ • x‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hrpos)]
    change r⁻¹ * r = 1
    field_simp [hr]
  have hunitv : ‖v‖ = 1 := by
    change ‖s⁻¹ • y‖ = 1
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hspos)]
    change s⁻¹ * s = 1
    field_simp [hs]
  have hxu : x = r • u := by
    dsimp [u]
    rw [smul_smul, mul_inv_cancel₀ hr, one_smul]
  have hyv : y = s • v := by
    dsimp [v]
    rw [smul_smul, mul_inv_cancel₀ hs, one_smul]
  have hru : ‖r • u‖ = r := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hrpos.le, hunitu, mul_one]
  have hsv : ‖s • v‖ = s := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hspos.le, hunitv, mul_one]
  have hinter : inner Real (r • u) (s • v) = r * s * inner Real u v := by
    rw [inner_smul_left, inner_smul_right]
    simp [mul_assoc]
  have hsum : ‖x + y‖ ^ 2 = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
    calc
      ‖x + y‖ ^ 2 = ‖r • u + s • v‖ ^ 2 := by rw [hxu, hyv]
      _ = ‖r • u‖ ^ 2 + 2 * inner Real (r • u) (s • v) + ‖s • v‖ ^ 2 :=
        norm_add_sq_real _ _
      _ = r ^ 2 + 2 * r * s * inner Real u v + s ^ 2 := by
        rw [hru, hsv, hinter]
        ring
  have hsub : ‖u - v‖ ^ 2 = 2 - 2 * inner Real u v := by
    rw [norm_sub_sq_real, hunitu, hunitv]
    ring
  change (r + s) ^ 2 - ‖x + y‖ ^ 2 = r * s * ‖u - v‖ ^ 2
  rw [hsum, hsub]
  ring

/-- On either fixed oriented branch of the unit circle, controlling the
inner-product coordinate against a nonzero vector controls the direction.
This is the transverse half of the two-branch reduction. -/
private theorem aux_unit_same_area_branch_direction_bound
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {X u u' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {A D : Real}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hu : ‖u‖ = 1) (hu' : ‖u'‖ = 1)
    (harea : A ≤ |(o.areaForm X) u| ∧ A ≤ |(o.areaForm X) u'|)
    (hsign : (0 ≤ (o.areaForm X) u ∧ 0 ≤ (o.areaForm X) u') ∨
      ((o.areaForm X) u ≤ 0 ∧ (o.areaForm X) u' ≤ 0))
    (hinner : |inner Real X u - inner Real X u'| ≤ D) :
    ‖u - u'‖ ≤ D / ‖X‖ + D / A := by
  let N : Real := ‖X‖
  let c : Real := inner Real X u
  let c' : Real := inner Real X u'
  let a : Real := (o.areaForm X) u
  let a' : Real := (o.areaForm X) u'
  have hN : 0 < N := by simpa only [N] using hX
  have hcircle : c ^ 2 + a ^ 2 = N ^ 2 := by
    calc
      c ^ 2 + a ^ 2 = ‖X‖ ^ 2 * ‖u‖ ^ 2 := by
        simpa only [c, a] using o.inner_sq_add_areaForm_sq X u
      _ = N ^ 2 := by rw [hu]; simp only [N, one_pow, mul_one]
  have hcircle' : c' ^ 2 + a' ^ 2 = N ^ 2 := by
    calc
      c' ^ 2 + a' ^ 2 = ‖X‖ ^ 2 * ‖u'‖ ^ 2 := by
        simpa only [c', a'] using o.inner_sq_add_areaForm_sq X u'
      _ = N ^ 2 := by rw [hu']; simp only [N, one_pow, mul_one]
  have hc : |c| ≤ N := by
    simpa only [N, c, hu, mul_one] using abs_real_inner_le_norm X u
  have hc' : |c'| ≤ N := by
    simpa only [N, c', hu', mul_one] using abs_real_inner_le_norm X u'
  have hsumc : |c + c'| ≤ 2 * N := by
    calc
      |c + c'| ≤ |c| + |c'| := abs_add_le _ _
      _ ≤ N + N := add_le_add hc hc'
      _ = 2 * N := by ring
  have hsumapos : 2 * A ≤ |a + a'| := by
    rcases hsign with hnonneg | hnonpos
    · have hnonneg' : 0 ≤ a ∧ 0 ≤ a' := by
        simpa only [a, a'] using hnonneg
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonneg hnonneg'.1, abs_of_nonneg hnonneg'.2] at harea
      rw [abs_of_nonneg (add_nonneg hnonneg'.1 hnonneg'.2)]
      linarith [harea.1, harea.2]
    · have hnonpos' : a ≤ 0 ∧ a' ≤ 0 := by
        simpa only [a, a'] using hnonpos
      change A ≤ |a| ∧ A ≤ |a'| at harea
      rw [abs_of_nonpos hnonpos'.1, abs_of_nonpos hnonpos'.2] at harea
      rw [abs_of_nonpos (add_nonpos hnonpos'.1 hnonpos'.2)]
      linarith [harea.1, harea.2]
  have hprod : |a - a'| * |a + a'| = |c - c'| * |c + c'| := by
    rw [← abs_mul, ← abs_mul]
    have hfactor : (a - a') * (a + a') = -((c - c') * (c + c')) := by
      nlinarith [hcircle, hcircle']
    rw [hfactor, abs_neg]
  have hdiffc : |c - c'| ≤ D := by
    simpa only [c, c', sub_eq_add_neg, abs_neg] using hinner
  have hDnonneg : 0 ≤ D := le_trans (abs_nonneg _) hdiffc
  have hareaTimes : |a - a'| * (2 * A) ≤ D * (2 * N) := by
    calc
      |a - a'| * (2 * A) ≤ |a - a'| * |a + a'| := by
        gcongr
      _ = |c - c'| * |c + c'| := hprod
      _ ≤ D * (2 * N) := by gcongr
  have haDiff : |a - a'| ≤ D * N / A := by
    have hAne : A ≠ 0 := ne_of_gt hA
    field_simp [hAne]
    nlinarith [hareaTimes]
  have hinter : c * c' + a * a' = N ^ 2 * inner Real u u' := by
    simpa only [N, c, c', a, a'] using o.inner_mul_inner_add_areaForm_mul_areaForm X u u'
  have hmetric : N ^ 2 * ‖u - u'‖ ^ 2 = (c - c') ^ 2 + (a - a') ^ 2 := by
    rw [norm_sub_sq_real, hu, hu']
    nlinarith [hcircle, hcircle', hinter]
  have hnonneg : 0 ≤ |c - c'| + |a - a'| := add_nonneg (abs_nonneg _) (abs_nonneg _)
  have hsquare : ‖u - u'‖ ^ 2 ≤ ((|c - c'| + |a - a'|) / N) ^ 2 := by
    have hsumSquares : (c - c') ^ 2 + (a - a') ^ 2 ≤
        (|c - c'| + |a - a'|) ^ 2 := by
      nlinarith [sq_abs (c - c'), sq_abs (a - a'),
        abs_nonneg (c - c'), abs_nonneg (a - a')]
    have hNne : N ≠ 0 := ne_of_gt hN
    field_simp [hNne]
    nlinarith [hmetric, hsumSquares]
  have hdirection : ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := by
    apply (sq_le_sq₀ (norm_nonneg _) (div_nonneg hnonneg hN.le)).mp
    exact hsquare
  calc
    ‖u - u'‖ ≤ (|c - c'| + |a - a'|) / N := hdirection
    _ ≤ (D + D * N / A) / N := by gcongr
    _ = D / N + D / A := by
      field_simp [ne_of_gt hN, ne_of_gt hA]
    _ = D / ‖X‖ + D / A := by rfl

/-- Normalizing a vector which is close to a positive multiple of a unit
direction changes it by at most twice the relative approximation error. -/
private theorem aux_normalized_sub_unit_le_two_mul_error_div
    {x u : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {a e : Real}
    (hx : x ≠ 0) (ha : 0 < a) (hu : ‖u‖ = 1)
    (happrox : ‖x - a • u‖ ≤ e) :
    ‖(‖x‖)⁻¹ • x - u‖ ≤ 2 * e / a := by
  let N : Real := ‖x‖
  have hN : 0 < N := by
    change 0 < ‖x‖
    exact norm_pos_iff.mpr hx
  have hNne : N ≠ 0 := ne_of_gt hN
  have hane : a ≠ 0 := ne_of_gt ha
  have hnormau : ‖a • u‖ = a := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos ha, hu, mul_one]
  have hradial : |N - a| ≤ e := by
    change |‖x‖ - a| ≤ e
    calc
      |‖x‖ - a| = |‖x‖ - ‖a • u‖| := by rw [hnormau]
      _ ≤ ‖x - a • u‖ := abs_norm_sub_norm_le _ _
      _ ≤ e := happrox
  have hdecomp :
      N⁻¹ • x - u = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
    calc
      N⁻¹ • x - u = N⁻¹ • x - (a⁻¹ * a) • u := by
        rw [inv_mul_cancel₀ hane, one_smul]
      _ = N⁻¹ • x - a⁻¹ • (a • u) := by rw [smul_smul]
      _ = (N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u) := by
        rw [sub_smul, smul_sub]
        abel
  have hinv : |N⁻¹ - a⁻¹| * N = |N - a| / a := by
    have hformula : N⁻¹ - a⁻¹ = (a - N) / (N * a) := by
      field_simp [hNne, hane]
    rw [hformula, abs_div]
    rw [abs_of_pos (mul_pos hN ha), abs_sub_comm]
    field_simp [hNne, hane]
  have hnormx : ‖x‖ = N := rfl
  have hinva : ‖a⁻¹‖ = a⁻¹ := by
    rw [Real.norm_eq_abs, abs_of_pos (inv_pos.mpr ha)]
  calc
    ‖(‖x‖)⁻¹ • x - u‖ = ‖N⁻¹ • x - u‖ := by rfl
    _ = ‖(N⁻¹ - a⁻¹) • x + a⁻¹ • (x - a • u)‖ := by rw [hdecomp]
    _ ≤ ‖(N⁻¹ - a⁻¹) • x‖ + ‖a⁻¹ • (x - a • u)‖ := norm_add_le _ _
    _ = |N⁻¹ - a⁻¹| * N + a⁻¹ * ‖x - a • u‖ := by
      rw [norm_smul, norm_smul, Real.norm_eq_abs, hnormx, hinva]
    _ = |N - a| / a + a⁻¹ * ‖x - a • u‖ := by rw [hinv]
    _ ≤ e / a + a⁻¹ * e := by gcongr
    _ = 2 * e / a := by
      field_simp [hane]
      ring

/-- Exact chord--area relation for two unit directions in the plane. -/
private theorem aux_unit_area_sq_eq_chord
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) :
    ((o.areaForm u) v) ^ 2 =
      ‖u - v‖ ^ 2 * (1 - ‖u - v‖ ^ 2 / 4) := by
  have harea := o.inner_sq_add_areaForm_sq u v
  have hsub := norm_sub_sq_real u v
  rw [hu, hv] at harea hsub
  nlinarith [harea, hsub]

private theorem aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1) :
    ‖u - v‖ ≤ 2 * |(o.areaForm u) v| := by
  have harea := aux_unit_area_sq_eq_chord o hu hv
  have hnorm : 0 ≤ ‖u - v‖ := norm_nonneg _
  have hcloseSq : ‖u - v‖ ^ 2 ≤ 1 := by
    have hprod := mul_nonneg hnorm (sub_nonneg.mpr hclose)
    nlinarith
  have hthree : 0 ≤ 3 - ‖u - v‖ ^ 2 := by linarith
  have hfactor : 0 ≤ ‖u - v‖ ^ 2 * (3 - ‖u - v‖ ^ 2) :=
    mul_nonneg (sq_nonneg _) hthree
  have hsq : ‖u - v‖ ^ 2 ≤ (2 * |(o.areaForm u) v|) ^ 2 := by
    nlinarith [harea, sq_abs ((o.areaForm u) v)]
  apply (sq_le_sq₀ hnorm (by positivity)).mp
  exact hsq

private theorem aux_area_sum_right
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    (r s : Real) (u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) :
    (o.areaForm (r • u + s • v)) u = s * (o.areaForm v) u := by
  rw [map_add, map_smul, map_smul]
  change r * (o.areaForm u) u + s * (o.areaForm v) u = s * (o.areaForm v) u
  rw [o.areaForm_apply_self, mul_zero, zero_add]

private theorem aux_two_mul_sqrt_div_sum_le_scaled
    {scale r s C : Real} (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) :
    2 * (2 * C * Real.sqrt scale) / (r + s) ≤
      8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsum : scale / 2 ≤ r + s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1; norm_num
  apply (div_le_iff₀ hsumpos).mpr
  calc
    2 * (2 * C * Real.sqrt scale) =
        (8 * C * scale ^ (-(1 / 2 : Real))) * (scale / 2) := by
      rw [← hrpow]
      ring
    _ ≤ (8 * C * scale ^ (-(1 / 2 : Real))) * (r + s) := by
      gcongr

/-- Small output-oriented area is the tangent alternative: because both
input radii are elliptic-scale, the first normalized input lies in one
`O(scale⁻¹ᐟ²)` cap about the normalized output direction. -/
private theorem aux_tangent_cap_of_small_area
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {scale r s C : Real} {X u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hsmall : |(o.areaForm X) u| ≤ C * Real.sqrt scale) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hsdsmall : s * ‖u - v‖ ≤ 2 * C * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := hsd
      _ ≤ 2 * (C * Real.sqrt scale) := by gcongr
      _ = 2 * C * Real.sqrt scale := by ring
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (2 * C * Real.sqrt scale) / (r + s) := by gcongr
    _ ≤ 8 * C * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale hC hr hs

/-- In the transverse alternative, a lower chordal separation of the two
normalized inputs forces output-oriented area of order `sqrt scale`. -/
private theorem aux_transverse_area_lower_of_chord_lower
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {scale r s lambda : Real} {X u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hscale : 0 < scale) (hs : scale / 4 ≤ s) (hlambda : 0 ≤ lambda)
    (hX : X = r • u + s • v)
    (hu : ‖u‖ = 1) (hv : ‖v‖ = 1) (hclose : ‖u - v‖ ≤ 1)
    (hgap : lambda * scale ^ (-(1 / 2 : Real)) ≤ ‖u - v‖) :
    lambda * Real.sqrt scale / 8 ≤ |(o.areaForm X) u| := by
  have hsnonneg : 0 ≤ s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1; norm_num
  have hareaX : (o.areaForm X) u = s * (o.areaForm v) u := by
    rw [hX]
    exact aux_area_sum_right o r s u v
  have hchord : ‖u - v‖ ≤ 2 * |(o.areaForm v) u| := by
    have h := aux_unit_chord_le_two_mul_abs_area_of_norm_sub_le_one o hu hv hclose
    have hswap : |(o.areaForm u) v| = |(o.areaForm v) u| := by
      rw [o.areaForm_swap, abs_neg]
    rw [hswap] at h
    exact h
  have hsd : s * ‖u - v‖ ≤ 2 * |(o.areaForm X) u| := by
    calc
      s * ‖u - v‖ ≤ s * (2 * |(o.areaForm v) u|) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ = 2 * |s * (o.areaForm v) u| := by
        rw [abs_mul, abs_of_nonneg hsnonneg]
        ring
      _ = 2 * |(o.areaForm X) u| := by rw [← hareaX]
  have hscaled : (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
      2 * |(o.areaForm X) u| := by
    calc
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) ≤
          s * (lambda * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ ≤ s * ‖u - v‖ := mul_le_mul_of_nonneg_left hgap hsnonneg
      _ ≤ 2 * |(o.areaForm X) u| := hsd
  have hrewrite :
      (scale / 4) * (lambda * scale ^ (-(1 / 2 : Real))) =
        lambda * Real.sqrt scale / 4 := by
    rw [← hrpow]
    ring
  rw [hrewrite] at hscaled
  linarith

private theorem aux_chord_lower_of_center_direction_bounds
    {h L A : Real} {a b u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hcenters : L * h ≤ ‖a - b‖)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    (L - 2 * A) * h ≤ ‖u - v‖ := by
  have htriangle : ‖a - b‖ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
    calc
      ‖a - b‖ = ‖(a - u) + (u - v) + (v - b)‖ := by congr 1; abel
      _ ≤ ‖(a - u) + (u - v)‖ + ‖v - b‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - v‖ + ‖v - b‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hu
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_chord_upper_of_center_direction_bounds
    {h U A : Real} {a b u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hcenters : ‖a - b‖ ≤ U * h)
    (hu : ‖u - a‖ ≤ A * h) (hv : ‖v - b‖ ≤ A * h) :
    ‖u - v‖ ≤ (U + 2 * A) * h := by
  have htriangle : ‖u - v‖ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
    calc
      ‖u - v‖ = ‖(u - a) + (a - b) + (b - v)‖ := by congr 1; abel
      _ ≤ ‖(u - a) + (a - b)‖ + ‖b - v‖ := norm_add_le _ _
      _ ≤ ‖u - a‖ + ‖a - b‖ + ‖b - v‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hv
  nlinarith [hcenters, htriangle, hu, hv]

private theorem aux_output_normalized_cap_of_chord_upper
    {scale r s B : Real} {X u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (hr : scale / 4 ≤ r) (hs : scale / 4 ≤ s) (hsupper : s ≤ 4 * scale)
    (hX : X = r • u + s • v) (hXnonzero : X ≠ 0) (hu : ‖u‖ = 1)
    (hchord : ‖u - v‖ ≤ B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hsnonneg : 0 ≤ s := by linarith
  have hsumpos : 0 < r + s := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1; norm_num
  have hsub : X - (r + s) • u = s • (v - u) := by
    rw [hX, add_smul, smul_sub]
    abel
  have happrox : ‖X - (r + s) • u‖ ≤ s * ‖u - v‖ := by
    calc
      ‖X - (r + s) • u‖ = ‖s • (v - u)‖ := by rw [hsub]
      _ = s * ‖v - u‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = s * ‖u - v‖ := by rw [norm_sub_rev]
      _ ≤ s * ‖u - v‖ := le_rfl
  have herror : s * ‖u - v‖ ≤ 4 * B * Real.sqrt scale := by
    calc
      s * ‖u - v‖ ≤ s * (B * scale ^ (-(1 / 2 : Real))) :=
        mul_le_mul_of_nonneg_left hchord hsnonneg
      _ ≤ (4 * scale) * (B * scale ^ (-(1 / 2 : Real))) := by
        gcongr
      _ = 4 * B * Real.sqrt scale := by
        rw [← hrpow]
        ring
  have hnormal := aux_normalized_sub_unit_le_two_mul_error_div
    hXnonzero hsumpos hu happrox
  calc
    ‖(‖X‖)⁻¹ • X - u‖ ≤ 2 * (s * ‖u - v‖) / (r + s) := hnormal
    _ ≤ 2 * (4 * B * Real.sqrt scale) / (r + s) := by gcongr
    _ = 2 * (2 * (2 * B) * Real.sqrt scale) / (r + s) := by ring
    _ ≤ 8 * (2 * B) * scale ^ (-(1 / 2 : Real)) :=
      aux_two_mul_sqrt_div_sum_le_scaled hscale (by positivity) hr hs
    _ = 16 * B * scale ^ (-(1 / 2 : Real)) := by ring

/-- Stability of the polar inner-product coordinate under coupled changes in
the total radius and the first radius.  The two error terms are exactly the
ones supplied by the normal/time and radial plate windows. -/
private theorem aux_polar_inner_coordinate_difference_bound
    {r r' tau tau' defect defect' : Real}
    (hr : 0 < r) (hr' : 0 < r') (hdefect' : 0 ≤ defect') :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
  have hrne : r ≠ 0 := ne_of_gt hr
  have hr'ne : r' ≠ 0 := ne_of_gt hr'
  have hden : 0 < 2 * r := by positivity
  have hden' : 0 < 2 * r * r' := by positivity
  have hid : defect / (2 * r) - defect' / (2 * r') =
      (defect - defect') / (2 * r) +
        defect' * (r' - r) / (2 * r * r') := by
    field_simp [hrne, hr'ne]
    ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| =
        |(tau - tau') -
          ((defect - defect') / (2 * r) +
            defect' * (r' - r) / (2 * r * r'))| := by
      rw [sub_sub_sub_comm, hid]
    _ ≤ |tau - tau'| +
        |(defect - defect') / (2 * r) +
          defect' * (r' - r) / (2 * r * r')| := by
      calc
        |(tau - tau') -
            ((defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r'))| ≤
            |(tau - tau') - 0| +
              |0 - ((defect - defect') / (2 * r) +
                defect' * (r' - r) / (2 * r * r'))| :=
          abs_sub_le _ _ _
        _ = |tau - tau'| +
            |(defect - defect') / (2 * r) +
              defect' * (r' - r) / (2 * r * r')| := by
          rw [sub_zero, zero_sub, abs_neg]
    _ ≤ |tau - tau'| + |(defect - defect') / (2 * r)| +
        |defect' * (r' - r) / (2 * r * r')| := by
      simpa only [add_comm, add_left_comm, add_assoc] using
        add_le_add_left
          (abs_add_le ((defect - defect') / (2 * r))
            (defect' * (r' - r) / (2 * r * r')))
          |tau - tau'|
    _ = |tau - tau'| + |defect - defect'| / (2 * r) +
        defect' * |r - r'| / (2 * r * r') := by
      rw [abs_div, abs_of_pos hden, abs_div, abs_mul, abs_of_nonneg hdefect',
        abs_of_pos hden']
      rw [show |r' - r| = |r - r'| by exact abs_sub_comm _ _]

private theorem aux_abs_sub_le_two_mul_common_window
    {a b center E : Real} (ha : |a - center| ≤ E) (hb : |b - center| ≤ E) :
    |a - b| ≤ 2 * E := by
  calc
    |a - b| ≤ |a - center| + |center - b| := abs_sub_le _ _ _
    _ = |a - center| + |b - center| := by
      exact congrArg (fun q : Real => |a - center| + q) (abs_sub_comm center b)
    _ ≤ E + E := add_le_add ha hb
    _ = 2 * E := by ring

private theorem aux_radial_window_difference_le_six_sqrt
    {scale r r' center : Real} (hscale : 2 ≤ scale)
    (hr : |r - center| ≤ Real.sqrt scale + 2)
    (hr' : |r' - center| ≤ Real.sqrt scale + 2) :
    |r - r'| ≤ 6 * Real.sqrt scale := by
  have hsqrt : 1 ≤ Real.sqrt scale := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt (le_trans (by norm_num) hscale)
  have hdiff := aux_abs_sub_le_two_mul_common_window hr hr'
  nlinarith

/-- The literal unit-normal windows for two summands with the same output
give a scale-free bound for the difference of their total radii. -/
private theorem aux_total_radius_difference_le_eight
    {a b center : Real} (ha : |a - center| ≤ 4) (hb : |b - center| ≤ 4) :
    |a - b| ≤ 8 := by
  have h := aux_abs_sub_le_two_mul_common_window ha hb
  norm_num at h ⊢
  exact h

private theorem aux_sum_radius_bounds
    {scale r s : Real} (_hscale : 0 ≤ scale)
    (hrlo : scale / 4 ≤ r) (hrhi : r ≤ 4 * scale)
    (hslo : scale / 4 ≤ s) (hshi : s ≤ 4 * scale) :
    scale / 2 ≤ r + s ∧ r + s ≤ 8 * scale := by
  constructor <;> nlinarith

/-- Squared total-radius defects of two active pairs sharing an output differ
by at most `128 * scale` once each total radius lies in `[scale/2, 8 scale]`
and the normal-coordinate windows give a difference at most eight. -/
private theorem aux_defect_difference_le_one_twenty_eight_mul_scale
    {scale tau tau' Xnorm : Real} (_hscale : 0 ≤ scale)
    (htau : 0 ≤ tau) (htau' : 0 ≤ tau')
    (htauupper : tau ≤ 8 * scale) (htau'upper : tau' ≤ 8 * scale)
    (hdiff : |tau - tau'| ≤ 8) :
    |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| ≤ 128 * scale := by
  have hsum : |tau + tau'| ≤ 16 * scale := by
    rw [abs_of_nonneg (by linarith)]
    linarith
  have hfactor :
      |(tau ^ 2 - Xnorm ^ 2) - (tau' ^ 2 - Xnorm ^ 2)| =
        |tau - tau'| * |tau + tau'| := by
    rw [← abs_mul]
    congr 1
    ring
  rw [hfactor]
  calc
    |tau - tau'| * |tau + tau'| ≤ 8 * (16 * scale) :=
      mul_le_mul hdiff hsum (abs_nonneg _) (by norm_num)
    _ = 128 * scale := by ring

/-- Direct polar-coordinate stability for two literal plate witnesses.  The
three terms are respectively the normal/time window, the resulting total
radius-defect window, and the radial-label window. -/
private theorem aux_polar_inner_coordinate_difference_le_constant
    {scale r r' tau tau' defect defect' B : Real}
    (hscale : 2 ≤ scale)
    (hr : scale / 4 ≤ r) (hr' : scale / 4 ≤ r')
    (htau : |tau - tau'| ≤ 8)
    (hdefect : |defect - defect'| ≤ 128 * scale)
    (hdefect'nonneg : 0 ≤ defect')
    (hdefect'upper : defect' ≤ 16 * B ^ 2 * scale)
    (hradial : |r - r'| ≤ 6 * Real.sqrt scale) :
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hrpos : 0 < r := by linarith
  have hr'pos : 0 < r' := by linarith
  have hsqrtnonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscalepos _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1; norm_num
  have hrr : scale ^ 2 / 16 ≤ r * r' := by
    have hmul := mul_le_mul hr hr' (by linarith : 0 ≤ scale / 4) (by linarith : 0 ≤ r)
    nlinarith [hmul]
  have hterm₂ : |defect - defect'| / (2 * r) ≤ 256 := by
    have hden : 0 < 2 * r := by positivity
    calc
      |defect - defect'| / (2 * r) ≤ (128 * scale) / (2 * r) :=
        div_le_div_of_nonneg_right hdefect hden.le
      _ ≤ 256 := by
        apply (div_le_iff₀ hden).mpr
        nlinarith
  have hterm₃ : defect' * |r - r'| / (2 * r * r') ≤
      768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
    have hden : 0 < 2 * r * r' := by positivity
    have hupper : 0 ≤ 16 * B ^ 2 * scale := by positivity
    have hnum : defect' * |r - r'| ≤
        (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) :=
      by exact mul_le_mul hdefect'upper hradial (abs_nonneg _) hupper
    calc
      defect' * |r - r'| / (2 * r * r') ≤
          ((16 * B ^ 2 * scale) * (6 * Real.sqrt scale)) / (2 * r * r') :=
        div_le_div_of_nonneg_right hnum hden.le
      _ ≤ 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
        apply (div_le_iff₀ hden).mpr
        calc
          (16 * B ^ 2 * scale) * (6 * Real.sqrt scale) ≤
              96 * B ^ 2 * (scale * Real.sqrt scale) := by
            nlinarith
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (scale ^ 2 / 16)) := by
            rw [show scale * Real.sqrt scale =
              scale ^ (-(1 / 2 : Real)) * scale ^ 2 by
                calc
                  scale * Real.sqrt scale = Real.sqrt scale * scale := mul_comm _ _
                  _ = (scale ^ (-(1 / 2 : Real)) * scale) * scale := by rw [hrpow]
                  _ = scale ^ (-(1 / 2 : Real)) * scale ^ 2 := by ring]
            ring
          _ ≤ (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * (r * r')) := by gcongr
          _ = (768 * B ^ 2 * scale ^ (-(1 / 2 : Real))) *
              (2 * r * r') := by ring
  calc
    |(tau - defect / (2 * r)) - (tau' - defect' / (2 * r'))| ≤
        |tau - tau'| + |defect - defect'| / (2 * r) +
          defect' * |r - r'| / (2 * r * r') :=
      aux_polar_inner_coordinate_difference_bound hrpos hr'pos hdefect'nonneg
    _ ≤ 8 + 256 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by gcongr
    _ = 264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by ring

/-- An angular chord of size `B * scale⁻¹ᐟ²` gives a defect of order
`B² * scale` on the literal dyadic annulus. -/
private theorem aux_defect_upper_of_chord_upper
    {scale r s defect B chord : Real}
    (hscale : 0 < scale) (hB : 0 ≤ B)
    (_hrnonneg : 0 ≤ r) (hsnonneg : 0 ≤ s)
    (hrupper : r ≤ 4 * scale) (hsupper : s ≤ 4 * scale)
    (hdefect : defect = r * s * chord ^ 2)
    (hchord : chord ≤ B * scale ^ (-(1 / 2 : Real)))
    (hchordnonneg : 0 ≤ chord) :
    defect ≤ 16 * B ^ 2 * scale := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hright : 0 ≤ B * scale ^ (-(1 / 2 : Real)) := mul_nonneg hB hpow
  have hchordSq : chord ^ 2 ≤ (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact (sq_le_sq₀ hchordnonneg hright).mpr hchord
  have hrs : r * s ≤ (4 * scale) * (4 * scale) :=
    mul_le_mul hrupper hsupper hsnonneg (by positivity)
  have hprod : r * s * chord ^ 2 ≤
      ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := by
    exact mul_le_mul hrs hchordSq (sq_nonneg _) (by positivity)
  have hsqrt : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv : Real.sqrt scale * scale ^ (-(1 / 2 : Real)) = 1 := by
    calc
      Real.sqrt scale * scale ^ (-(1 / 2 : Real)) =
          scale ^ (1 / 2 : Real) * scale ^ (-(1 / 2 : Real)) := by
            rw [← Real.sqrt_eq_rpow]
      _ = scale ^ ((1 / 2 : Real) + (-(1 / 2 : Real))) :=
        (Real.rpow_add hscale _ _).symm
      _ = 1 := by norm_num
  have hscalePow : scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 = scale := by
    calc
      scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2 =
          ((Real.sqrt scale) ^ 2) ^ 2 *
            (scale ^ (-(1 / 2 : Real))) ^ 2 := by rw [hsqrt]
      _ = (Real.sqrt scale) ^ 2 *
            (Real.sqrt scale * scale ^ (-(1 / 2 : Real))) ^ 2 := by
              ring
      _ = (Real.sqrt scale) ^ 2 := by rw [hinv, one_pow, mul_one]
      _ = scale := hsqrt
  calc
    defect = r * s * chord ^ 2 := hdefect
    _ ≤ ((4 * scale) * (4 * scale)) *
        (B * scale ^ (-(1 / 2 : Real))) ^ 2 := hprod
    _ = 16 * B ^ 2 * (scale ^ 2 * (scale ^ (-(1 / 2 : Real))) ^ 2) := by ring
    _ = 16 * B ^ 2 * scale := by rw [hscalePow]

private theorem aux_real_inner_ge_seven_eighth_of_unit_dist_le_half
    {c u : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (huc : ‖u - c‖ ≤ 1 / 2) :
    7 / 8 ≤ inner Real c u := by
  have hsq := norm_sub_sq_real c u
  rw [hc, hu] at hsq
  have hnonneg : 0 ≤ ‖u - c‖ := norm_nonneg _
  have hsubsq : ‖c - u‖ ^ 2 ≤ 1 / 4 := by
    rw [norm_sub_rev]
    nlinarith
  nlinarith

/-- A common unit-sector centre keeps a positive weighted sum away from the
origin once both normalized summands are within one half of that centre. -/
private theorem aux_weighted_unit_sum_norm_lower_of_common_center
    {r s : Real} {c u v : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hc : ‖c‖ = 1) (hu : ‖u‖ = 1) (hv : ‖v‖ = 1)
    (huc : ‖u - c‖ ≤ 1 / 2) (hvc : ‖v - c‖ ≤ 1 / 2)
    (hr : 0 ≤ r) (hs : 0 ≤ s) :
    (r + s) / 2 ≤ ‖r • u + s • v‖ := by
  have hinneru : 7 / 8 ≤ inner Real c u :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hu huc
  have hinnerv : 7 / 8 ≤ inner Real c v :=
    aux_real_inner_ge_seven_eighth_of_unit_dist_le_half hc hv hvc
  have hsuminner : 7 / 8 * (r + s) ≤ inner Real c (r • u + s • v) := by
    rw [inner_add_right, inner_smul_right, inner_smul_right]
    nlinarith [mul_le_mul_of_nonneg_left hinneru hr,
      mul_le_mul_of_nonneg_left hinnerv hs]
  have hinnernorm : inner Real c (r • u + s • v) ≤ ‖r • u + s • v‖ := by
    calc
      inner Real c (r • u + s • v) ≤ |inner Real c (r • u + s • v)| := le_abs_self _
      _ ≤ ‖c‖ * ‖r • u + s • v‖ := abs_real_inner_le_norm _ _
      _ = ‖r • u + s • v‖ := by rw [hc, one_mul]
  nlinarith

/-- Convert cap control for normalized witnesses into cap control for their
angular plate centres. -/
private theorem aux_direction_centres_close_of_normalized_output_caps
    {h A C : Real} {a a' u u' xhat : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (_hh : 0 ≤ h)
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (hux : ‖u - xhat‖ ≤ C * h) (hu'x : ‖u' - xhat‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + 2 * C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ +
      ‖xhat - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - xhat) + (xhat - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - xhat) + (xhat - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖(a - u) + (u - xhat)‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  rw [norm_sub_rev] at hu'x
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - xhat‖ + ‖xhat - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + C * h + A * h := by gcongr
    _ = (2 * A + 2 * C) * h := by ring

private theorem aux_direction_centres_close_of_normalized_pair
    {h A C : Real}
    {a a' u u' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hua : ‖u - a‖ ≤ A * h) (hu'a' : ‖u' - a'‖ ≤ A * h)
    (huu' : ‖u - u'‖ ≤ C * h) :
    ‖a - a'‖ ≤ (2 * A + C) * h := by
  have htriangle : ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
    calc
      ‖a - a'‖ = ‖(a - u) + (u - u') + (u' - a')‖ := by
        congr 1
        abel
      _ ≤ ‖(a - u) + (u - u')‖ + ‖u' - a'‖ := norm_add_le _ _
      _ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := by
        gcongr
        exact norm_add_le _ _
  rw [norm_sub_rev] at hua
  calc
    ‖a - a'‖ ≤ ‖a - u‖ + ‖u - u'‖ + ‖u' - a'‖ := htriangle
    _ ≤ A * h + C * h + A * h := by gcongr
    _ = (2 * A + C) * h := by ring

private theorem aux_norm_normalized_eq_one
    {x : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} (hx : x ≠ 0) :
    ‖(‖x‖)⁻¹ • x‖ = 1 := by
  have hnormpos : 0 < ‖x‖ := norm_pos_iff.mpr hx
  have hnormne : ‖x‖ ≠ 0 := ne_of_gt hnormpos
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hnormpos)]
  field_simp [hnormne]

private theorem aux_eq_norm_smul_normalized
    {x : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} (hx : x ≠ 0) :
    x = ‖x‖ • ((‖x‖)⁻¹ • x) := by
  have hnormne : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
  rw [smul_smul, mul_inv_cancel₀ hnormne, one_smul]

private theorem aux_normalized_near_common_sector_center
    {scale angularConstant : Real}
    {x direction center : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hscale : 0 < scale) (_hx : x ≠ 0)
    (hactual : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      angularConstant * scale ^ (-(1 / 2 : Real)))
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4) :
    ‖(‖x‖)⁻¹ • x - center‖ ≤ 1 / 2 := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have habs : ‖(‖x‖)⁻¹ • x - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖(‖x‖)⁻¹ • x - direction‖ ≤
          angularConstant * scale ^ (-(1 / 2 : Real)) := hactual
      _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow
  calc
    ‖(‖x‖)⁻¹ • x - center‖ ≤
        ‖(‖x‖)⁻¹ • x - direction‖ + ‖direction - center‖ := by
      rw [show (‖x‖)⁻¹ • x - center =
        ((‖x‖)⁻¹ • x - direction) + (direction - center) by abel]
      exact norm_add_le _ _
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) + 1 / 4 := by gcongr
    _ ≤ 1 / 2 := by linarith

private theorem aux_angular_direction_chord_bounds_succ
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
        ‖directions i - directions j‖ ∧
      ‖directions i - directions j‖ ≤
        spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, hseparation⟩
  rcases (angularSeparationClass_succ_iff k i j).mp hseparation with ⟨hlower, hupper⟩
  have hlowNat : 2 ^ k ≤ (i - j).natAbs := Nat.le_of_lt hlower
  have hlowReal : ((2 ^ k : Nat) : Real) ≤ ((i - j).natAbs : Real) := by
    exact_mod_cast hlowNat
  have hupperReal : ((i - j).natAbs : Real) ≤ ((2 ^ (k + 1) : Nat) : Real) := by
    exact_mod_cast hupper
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hdataij := (hdata i hi).2.2 j hj
  constructor
  · calc
      spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤
          spacingLower * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := by
            gcongr
      _ ≤ ‖directions i - directions j‖ := hdataij.1
  · calc
      ‖directions i - directions j‖ ≤
          spacingUpper * ((i - j).natAbs : Real) * scale ^ (-(1 / 2 : Real)) := hdataij.2
      _ ≤ spacingUpper * ((2 ^ (k + 1) : Nat) : Real) *
          scale ^ (-(1 / 2 : Real)) := by gcongr

private theorem aux_scaled_dyadic_index_le_half
    {scale sectorRadius spacingLower spacingUpper : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {i j : Int} {k : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hpair : (i, j) ∈ angularSeparationPairs indices (k + 1)) :
    spacingLower * ((2 ^ k : Nat) : Real) * scale ^ (-(1 / 2 : Real)) ≤ 1 / 2 := by
  have hlower := (aux_angular_direction_chord_bounds_succ hscale hgeometry hpair).1
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  rcases (mem_angularSeparationPairs_iff indices (k + 1) (i, j)).mp hpair with
    ⟨hi, hj, _⟩
  have hupper : ‖directions i - directions j‖ ≤ 1 / 2 := by
    calc
      ‖directions i - directions j‖ ≤
          ‖directions i - center‖ + ‖center - directions j‖ := by
        rw [show directions i - directions j =
          (directions i - center) + (center - directions j) by abel]
        exact norm_add_le _ _
      _ = ‖directions i - center‖ + ‖directions j - center‖ := by
        exact congrArg (fun q : Real => ‖directions i - center‖ + q)
          (norm_sub_rev _ _)
      _ ≤ sectorRadius + sectorRadius := add_le_add (hdata i hi).2.1 (hdata j hj).2.1
      _ ≤ 1 / 2 := by linarith
  exact le_trans hlower hupper

private theorem aux_same_sign_direction_bound_of_coordinate_bounds
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {A D CX CA h : Real}
    {X U U' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hX : 0 < ‖X‖) (hA : 0 < A)
    (hU : ‖U‖ = 1) (hU' : ‖U'‖ = 1)
    (harea : A ≤ |(o.areaForm X) U| ∧ A ≤ |(o.areaForm X) U'|)
    (hsign : (0 ≤ (o.areaForm X) U ∧ 0 ≤ (o.areaForm X) U') ∨
      ((o.areaForm X) U ≤ 0 ∧ (o.areaForm X) U' ≤ 0))
    (hinner : |inner Real X U - inner Real X U'| ≤ D)
    (hXquot : D / ‖X‖ ≤ CX * h) (hAquot : D / A ≤ CA * h) :
    ‖U - U'‖ ≤ (CX + CA) * h := by
  calc
    ‖U - U'‖ ≤ D / ‖X‖ + D / A :=
      aux_unit_same_area_branch_direction_bound o hX hA hU hU' harea hsign hinner
    _ ≤ CX * h + CA * h := add_le_add hXquot hAquot
    _ = (CX + CA) * h := by ring

/-- The scale bookkeeping for the transverse branch.  `B` is the upper
angular-chord coefficient, `lambda` the lower one, and `C` compares them.
The two conclusions are the output-radius and oriented-area quotient bounds
used by the two-coordinate circle estimate. -/
private theorem aux_transverse_coordinate_quotient_bounds
    {scale h sq B lambda C ell : Real}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hsq : 1 ≤ sq)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4) :
    (264 + 768 * B ^ 2 * h) / (scale / 4) ≤
        (1056 + 192 * C ^ 2) * h ∧
      (264 + 768 * B ^ 2 * h) / (lambda * sq / 8) ≤
        (4224 / ell + 1536 * C ^ 2) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hClambda : 0 ≤ C * lambda := mul_nonneg hC hlambda
  have hBsquare : B ^ 2 ≤ (C * lambda) ^ 2 :=
    (sq_le_sq₀ hB hClambda).mpr hcompare
  have hlambdahnonneg : 0 ≤ lambda * h := mul_nonneg hlambda hh.le
  have hlambdahsq : (lambda * h) ^ 2 ≤ (1 / 4 : Real) ^ 2 :=
    (sq_le_sq₀ hlambdahnonneg (by norm_num)).mpr hlambdah
  have hlambdasq : lambda ^ 2 ≤ scale / 16 := by
    have hrewrite : lambda ^ 2 = (lambda * h) ^ 2 * scale := by
      calc
        lambda ^ 2 = lambda ^ 2 * (h ^ 2 * scale) := by rw [hhsquare, mul_one]
        _ = (lambda * h) ^ 2 * scale := by ring
    rw [hrewrite]
    calc
      (lambda * h) ^ 2 * scale ≤ (1 / 4 : Real) ^ 2 * scale :=
        mul_le_mul_of_nonneg_right hlambdahsq hscalepos.le
      _ = scale / 16 := by ring
  have hBsquare' : B ^ 2 ≤ C ^ 2 * lambda ^ 2 := by
    calc
      B ^ 2 ≤ (C * lambda) ^ 2 := hBsquare
      _ = C ^ 2 * lambda ^ 2 := by ring
  have hBsquareScale : 16 * B ^ 2 ≤ C ^ 2 * scale := by
    have hmul : C ^ 2 * lambda ^ 2 ≤ C ^ 2 * (scale / 16) :=
      mul_le_mul_of_nonneg_left hlambdasq (sq_nonneg C)
    nlinarith [hBsquare', hmul]
  have hBlinear : 4 * B ^ 2 * h ≤ C ^ 2 * lambda := by
    have hmul : B ^ 2 * h ≤ C ^ 2 * lambda ^ 2 * h :=
      mul_le_mul_of_nonneg_right hBsquare' hh.le
    have hright : C ^ 2 * lambda ^ 2 * h ≤ C ^ 2 * lambda / 4 := by
      calc
        C ^ 2 * lambda ^ 2 * h = C ^ 2 * lambda * (lambda * h) := by ring
        _ ≤ C ^ 2 * lambda * (1 / 4) := by gcongr
        _ = C ^ 2 * lambda / 4 := by ring
    nlinarith [hmul, hright]
  constructor
  · have hden : 0 < scale / 4 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hscaleh : h * scale = sq := by
      apply mul_left_cancel₀ (ne_of_gt hh)
      calc
        h * (h * scale) = h ^ 2 * scale := by ring
        _ = 1 := hhsquare
        _ = h * sq := hhsq.symm
    have hsqbound : 1 ≤ h * scale := by rw [hscaleh]; exact hsq
    have htermOne : 264 ≤ 264 * (h * scale) := by
      nlinarith [hsqbound]
    have htermB : 768 * B ^ 2 * h ≤ 48 * C ^ 2 * (h * scale) := by
      have hmul := mul_le_mul_of_nonneg_right hBsquareScale hh.le
      nlinarith
    nlinarith [htermOne, htermB]
  · have hden : 0 < lambda * sq / 8 := by positivity
    apply (div_le_iff₀ hden).mpr
    have hsqrewrite : h * sq = 1 := hhsq
    have hfirst : 264 ≤ 528 * lambda / ell := by
      have hratio : 1 ≤ lambda / ell := (one_le_div₀ hell).mpr helllambda
      calc
        264 ≤ 528 * (lambda / ell) := by nlinarith
        _ = 528 * lambda / ell := by field_simp [ne_of_gt hell]
    have hright :
        (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
          528 * lambda / ell + 192 * C ^ 2 * lambda := by
      rw [show (4224 / ell + 1536 * C ^ 2) * h * (lambda * sq / 8) =
        (4224 / ell + 1536 * C ^ 2) * (h * sq) * lambda / 8 by ring,
        hsqrewrite]
      field_simp [ne_of_gt hell]
      ring
    rw [hright]
    nlinarith [hBlinear]

private theorem aux_rpow_neg_half_mul_sqrt_eq_one
    {scale : Real} (hscale : 0 < scale) :
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale = 1 := by
  calc
    scale ^ (-(1 / 2 : Real)) * Real.sqrt scale =
        scale ^ (-(1 / 2 : Real)) * scale ^ (1 / 2 : Real) := by
          rw [← Real.sqrt_eq_rpow]
    _ = scale ^ ((-(1 / 2 : Real)) + (1 / 2 : Real)) :=
      (Real.rpow_add hscale _ _).symm
    _ = 1 := by norm_num

private theorem aux_rpow_neg_half_sq_mul_scale_eq_one
    {scale : Real} (hscale : 0 < scale) :
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale = 1 := by
  have hsq : (Real.sqrt scale) ^ 2 = scale := Real.sq_sqrt hscale.le
  have hinv := aux_rpow_neg_half_mul_sqrt_eq_one hscale
  calc
    (scale ^ (-(1 / 2 : Real))) ^ 2 * scale =
        (scale ^ (-(1 / 2 : Real))) ^ 2 * (Real.sqrt scale) ^ 2 := by rw [hsq]
    _ = (scale ^ (-(1 / 2 : Real)) * Real.sqrt scale) ^ 2 := by ring
    _ = 1 := by rw [hinv, one_pow]

private theorem aux_output_norm_lower_of_high_sector_witnesses
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction direction' center : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z) :
    scale / 4 ≤ ‖Z.1‖ := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hzu : ‖(‖z.1‖)⁻¹ • z.1‖ = 1 := aux_norm_normalized_eq_one hznonzero
  have hwu : ‖(‖w.1‖)⁻¹ • w.1‖ = 1 := aux_norm_normalized_eq_one hwnonzero
  have hzuclose : ‖(‖z.1‖)⁻¹ • z.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hznonzero
      hz.2.2.1.2 hdircenter hhigh
  have hwuclose : ‖(‖w.1‖)⁻¹ • w.1 - center‖ ≤ 1 / 2 :=
    aux_normalized_near_common_sector_center hscalepos hwnonzero
      hw.2.2.1.2 hdircenter' hhigh
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
        exact congrArg₂ (· + ·) hzsmul hwsmul
  have hsumlower : (‖z.1‖ + ‖w.1‖) / 2 ≤ ‖Z.1‖ := by
    have hgeneric := aux_weighted_unit_sum_norm_lower_of_common_center
      (r := ‖z.1‖) (s := ‖w.1‖) (c := center)
      (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
      hcenter hzu hwu hzuclose hwuclose (norm_nonneg _) (norm_nonneg _)
    calc
      (‖z.1‖ + ‖w.1‖) / 2 ≤
          ‖‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1)‖ := hgeneric
      _ = ‖Z.1‖ := by rw [← hrepr]
  nlinarith [hz.1, hw.1, hsumlower]

private theorem aux_active_pair_exists_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int)
        (directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    ∃ zw : WaveSpaceTime × WaveSpaceTime,
      zw.1 ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      zw.2 ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      zw.1 + zw.2 = Z := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨_, z, hz, w, hw, hzw⟩
  exact ⟨(z, w), hz, hw, hzw⟩

private noncomputable def aux_active_pair_witness
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int)
        (directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) : WaveSpaceTime × WaveSpaceTime :=
  if hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z then
    Classical.choose (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair hpair)
  else (0, 0)

private theorem aux_active_pair_witness_spec
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int)
        (directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1 ∈
        unitNormalConicPlate scale angularConstant normalShift n (directions pair.1) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).2 ∈
        unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2) ∧
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).1 +
        (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 = Z := by
  rw [aux_active_pair_witness, dif_pos hpair]
  exact Classical.choose_spec
      (aux_active_pair_exists_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair hpair)

private noncomputable def aux_activeFirstNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int)
        (directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).1.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).1.1

private noncomputable def aux_activeSecondNormalized
    (scale angularConstant normalShift normalShift' : Real) (n n' : Int)
    (indices : Finset Int)
        (directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2)
    (k : Nat) (Z : WaveSpaceTime) (pair : Int × Int) :
    _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2 :=
  (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).2.1‖)⁻¹ •
    (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions k Z pair).2.1

private theorem aux_output_cap_of_high_sector_witness
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction direction' center : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z z w : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hcenter : ‖center‖ = 1)
    (hdircenter : ‖direction - center‖ ≤ 1 / 4)
    (hdircenter' : ‖direction' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' direction')
    (hzw : z + w = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    ‖(‖Z.1‖)⁻¹ • Z.1 - (‖z.1‖)⁻¹ • z.1‖ ≤
      16 * B * scale ^ (-(1 / 2 : Real)) := by
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    hdircenter hdircenter' hhigh hz hw hzw
  have hXnonzero : Z.1 ≠ 0 := by
    intro hzero
    have : ‖Z.1‖ = 0 := norm_eq_zero.mpr hzero
    linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hzsmul := aux_eq_norm_smul_normalized hznonzero
  have hwsmul := aux_eq_norm_smul_normalized hwnonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzsmul hwsmul
  have hresult := aux_output_normalized_cap_of_chord_upper
    (scale := scale) (r := ‖z.1‖) (s := ‖w.1‖) (B := B) (X := Z.1)
    (u := (‖z.1‖)⁻¹ • z.1) (v := (‖w.1‖)⁻¹ • w.1)
    (by linarith) hB hz.1 hw.1 hw.2.1 hrepr hXnonzero
    (aux_norm_normalized_eq_one hznonzero) hchord
  exact hresult

private theorem aux_plate_normalized_direction_bound_abs
    {scale angularConstant normalShift : Real} {n : Int}
    {direction : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2} {z : WaveSpaceTime}
    (hscale : 0 < scale)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction) :
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
      |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  calc
    ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤
        angularConstant * scale ^ (-(1 / 2 : Real)) := hz.2.2.1.2
    _ ≤ |angularConstant| * scale ^ (-(1 / 2 : Real)) :=
      mul_le_mul_of_nonneg_right (le_abs_self angularConstant) hpow

/-- Once the first normalized direction is stable, the coupled vector-sum
identity and the common radial-label windows stabilize the second direction
at the same dyadic scale. -/
private theorem aux_second_direction_bound_of_first_and_radial_windows
    {scale r r' s s' C : Real}
    {X u u' v v' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (hscale : 0 < scale) (hC : 0 ≤ C)
    (hrnonneg : 0 ≤ r) (hrupper : r ≤ 4 * scale) (hslower : scale / 4 ≤ s)
    (hrdiff : |r - r'| ≤ 6 * Real.sqrt scale)
    (hsdiff : |s - s'| ≤ 6 * Real.sqrt scale)
    (huu' : ‖u - u'‖ ≤ C * scale ^ (-(1 / 2 : Real)))
    (hu' : ‖u'‖ = 1) (hv' : ‖v'‖ = 1)
    (hX : X = r • u + s • v) (hX' : X = r' • u' + s' • v') :
    ‖v - v'‖ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
  have hspos : 0 < s := by linarith
  have hsnonneg : 0 ≤ s := hspos.le
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscale.le _
  have hrpow : scale ^ (-(1 / 2 : Real)) * scale = Real.sqrt scale := by
    calc
      scale ^ (-(1 / 2 : Real)) * scale =
          scale ^ (-(1 / 2 : Real)) * scale ^ (1 : Real) := by rw [Real.rpow_one]
      _ = scale ^ (-(1 / 2 : Real) + (1 : Real)) :=
        (Real.rpow_add hscale _ _).symm
      _ = Real.sqrt scale := by
        convert (Real.sqrt_eq_rpow scale).symm using 1; norm_num
  have hidentity : s • (v - v') =
      (r' - r) • u' + r • (u' - u) + (s' - s) • v' := by
    have hrel : s • v = r' • u' + s' • v' - r • u := by
      calc
        s • v = X - r • u := by rw [hX]; abel
        _ = r' • u' + s' • v' - r • u := by rw [hX']
    rw [smul_sub, hrel]
    module
  have hbound : s * ‖v - v'‖ ≤
      |r' - r| + r * ‖u' - u‖ + |s' - s| := by
    calc
      s * ‖v - v'‖ = ‖s • (v - v')‖ := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hsnonneg]
      _ = ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ := by rw [hidentity]
      _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
        calc
          ‖(r' - r) • u' + r • (u' - u) + (s' - s) • v'‖ ≤
              ‖(r' - r) • u' + r • (u' - u)‖ + ‖(s' - s) • v'‖ := norm_add_le _ _
          _ ≤ ‖(r' - r) • u'‖ + ‖r • (u' - u)‖ + ‖(s' - s) • v'‖ := by
            gcongr
            exact norm_add_le _ _
      _ = |r' - r| + r * ‖u' - u‖ + |s' - s| := by
        rw [norm_smul, norm_smul, norm_smul, Real.norm_eq_abs,
          Real.norm_eq_abs, Real.norm_eq_abs, hu', hv', mul_one, mul_one,
          abs_of_nonneg hrnonneg]
  have huudiff : ‖u' - u‖ ≤ C * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact huu'
  have hrdiff' : |r' - r| ≤ 6 * Real.sqrt scale := by
    rw [abs_sub_comm]
    exact hrdiff
  have hnumerator : |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
      (12 + 4 * C) * Real.sqrt scale := by
    have hterm : r * ‖u' - u‖ ≤ 4 * C * Real.sqrt scale := by
      calc
        r * ‖u' - u‖ ≤ r * (C * scale ^ (-(1 / 2 : Real))) :=
          mul_le_mul_of_nonneg_left huudiff hrnonneg
        _ ≤ (4 * scale) * (C * scale ^ (-(1 / 2 : Real))) := by gcongr
        _ = 4 * C * Real.sqrt scale := by rw [← hrpow]; ring
    calc
      |r' - r| + r * ‖u' - u‖ + |s' - s| ≤
          (6 * Real.sqrt scale) + (4 * C * Real.sqrt scale) +
            (6 * Real.sqrt scale) := by
        apply add_le_add
        · exact add_le_add hrdiff' hterm
        · rwa [abs_sub_comm]
      _ = (12 + 4 * C) * Real.sqrt scale := by ring
  have htarget : (12 + 4 * C) * Real.sqrt scale ≤
      ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
    calc
      (12 + 4 * C) * Real.sqrt scale =
          ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * (scale / 4) := by
        rw [← hrpow]
        ring
      _ ≤ ((48 + 16 * C) * scale ^ (-(1 / 2 : Real))) * s := by
        have hnonneg : 0 ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by positivity
        gcongr
  have hdiv : ‖v - v'‖ ≤
      (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := by
    apply (le_div_iff₀ hspos).mpr
    simpa [mul_comm] using hbound
  calc
    ‖v - v'‖ ≤
        (|r' - r| + r * ‖u' - u‖ + |s' - s|) / s := hdiv
    _ ≤ ((12 + 4 * C) * Real.sqrt scale) / s :=
      div_le_div_of_nonneg_right hnumerator hsnonneg
    _ ≤ (48 + 16 * C) * scale ^ (-(1 / 2 : Real)) := by
      apply (div_le_iff₀ hspos).mpr
      simpa [mul_comm] using htarget

/-- A uniform normalized chord bound for two literal high-sector witnesses
puts their first angular centres in one dyadic cap. -/
private theorem aux_high_active_first_direction_bound_of_normalized_chord
    {scale angularConstant normalShift normalShift' U : Real} {n n' : Int}
    {direction direction' mate mate' center : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hU : 0 ≤ U) (hcenter : ‖center‖ = 1)
    (hdirection : ‖direction - center‖ ≤ 1 / 4)
    (hmate : ‖mate - center‖ ≤ 1 / 4)
    (hdirection' : ‖direction' - center‖ ≤ 1 / 4)
    (hmate' : ‖mate' - center‖ ≤ 1 / 4)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      U * scale ^ (-(1 / 2 : Real)))
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      U * scale ^ (-(1 / 2 : Real))) :
    ‖direction - direction'‖ ≤
      (2 * |angularConstant| + 32 * U) * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hz'err := aux_plate_normalized_direction_bound_abs hscalepos hz'
  have hcap := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection hmate hhigh hz hw hzw hchord
  have hcap' := aux_output_cap_of_high_sector_witness hscale hU hcenter
    hdirection' hmate' hhigh hz' hw' hz'w' hchord'
  have hcaprev : ‖(‖z.1‖)⁻¹ • z.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap
  have hcaprev' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
      16 * U * scale ^ (-(1 / 2 : Real)) := by
    rw [norm_sub_rev]
    exact hcap'
  convert aux_direction_centres_close_of_normalized_output_caps hpow hzerr hz'err
    hcaprev hcaprev' using 1; ring

private theorem aux_normalized_chord_le_one_of_high_common_sector
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {direction mate : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {z w : WaveSpaceTime}
    (hscale : 0 < scale)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hcenters : ‖direction - mate‖ ≤ 1 / 2)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1 := by
  have hzerr := aux_plate_normalized_direction_bound_abs hscale hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscale hw
  have hzsmall : ‖(‖z.1‖)⁻¹ • z.1 - direction‖ ≤ 1 / 4 := le_trans hzerr hhigh
  have hwsmall : ‖(‖w.1‖)⁻¹ • w.1 - mate‖ ≤ 1 / 4 := le_trans hwerr hhigh
  have htriangle : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤
      ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
        ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
    calc
      ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ =
          ‖((‖z.1‖)⁻¹ • z.1 - direction) + (direction - mate) +
            (mate - (‖w.1‖)⁻¹ • w.1)‖ := by congr 1; abel
      _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction‖ + ‖direction - mate‖ +
          ‖mate - (‖w.1‖)⁻¹ • w.1‖ := by
        calc
          _ ≤ ‖(‖z.1‖)⁻¹ • z.1 - direction + (direction - mate)‖ +
              ‖mate - (‖w.1‖)⁻¹ • w.1‖ := norm_add_le _ _
          _ ≤ _ := by gcongr; exact norm_add_le _ _
  rw [norm_sub_rev] at hwsmall
  linarith

private def aux_pre_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_pre_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_pre_labelBox anchor B := by
  simp only [aux_pre_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_pre_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_pre_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_pre_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_pre_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_pre_labelBox anchor₁ B ∪ aux_pre_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_pre_labelBox anchor₁ B).card + (aux_pre_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_pre_card_labelBox, aux_pre_card_labelBox]
      ring

private theorem aux_pre_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤ D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

private theorem aux_pre_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real)))) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_pre_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₁.1 hD
          hleft.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₁.2 hD
          hleft.2)
  · apply Finset.mem_union_right
    exact aux_pre_mem_labelBox_of_natAbs_sub_le
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor₂.1 hD
          hright.1)
      (aux_pre_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor₂.2 hD
          hright.2)

/-- A high-sector literal overlap fiber is uniformly packed whenever every
canonical witness has a common normalized angular-chord bound. -/
private theorem aux_high_overlap_card_bound_of_normalized_chord
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' U : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hU : 0 ≤ U)
    (hB : 2 * |angularConstant| + 32 * U ≤ spacingLower * (B : Real))
    (hchord : ∀ pair,
      pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
        n n' indices directions k Z →
      ‖aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair -
        aux_activeSecondNormalized scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair‖ ≤
        U * scale ^ (-(1 / 2 : Real))) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant| + 32 * U) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hpsep, _⟩
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hasep, _⟩
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair hpair' with ⟨hpz, hpw, hpzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor hanchor' with ⟨haz, haw, hazw⟩
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord pair hpair'
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using hchord anchor
            hanchor'
      have hfirst := aux_high_active_first_direction_bound_of_normalized_chord
        hscale hU hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        hhigh hpz hpw haz haw hpzw hazw hpchord hachord
      have hpzwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1 = Z := by
        rw [add_comm]
        exact hpzw
      have hazwrev : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1 = Z := by
        rw [add_comm]
        exact hazw
      have hpchordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z pair).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hpchord
      have hachordrev : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions k Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).2.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions k Z anchor).1.1‖ ≤
          U * scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hachord
      have hsecond := aux_high_active_first_direction_bound_of_normalized_chord
        (normalShift := normalShift') (normalShift' := normalShift) (n := n') (n' := n)
        (direction := directions pair.2) (mate := directions pair.1)
        (direction' := directions anchor.2) (mate' := directions anchor.1)
        hscale hU hcenter
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        hhigh hpw hpz haw haz hpzwrev hazwrev hpchordrev hachordrev
      exact Or.inl ⟨hfirst, hsecond⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- In the high-scale, small-separation regime, angular spacing itself gives
a uniform normalized chord bound, hence a literal finite overlap packing. -/
private theorem aux_high_tangent_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant|)
    (hB : 2 * |angularConstant| +
      32 * (8 * |angularConstant| * spacingUpper / spacingLower +
        2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, _, hspacingLower, hspacingUpper, _, _, _⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hq : ((2 ^ m : Nat) : Real) ≤ 4 * |angularConstant| / spacingLower := by
    apply (le_div_iff₀ hspacingLower).mpr
    simpa [mul_comm] using htangent
  have hcoefficient : spacingUpper * ((2 ^ (m + 1) : Nat) : Real) ≤
      8 * |angularConstant| * spacingUpper / spacingLower := by
    calc
      spacingUpper * ((2 ^ (m + 1) : Nat) : Real) =
          2 * spacingUpper * ((2 ^ m : Nat) : Real) := by
            rw [pow_succ, Nat.cast_mul]
            norm_num
            ring
      _ ≤ 2 * spacingUpper * (4 * |angularConstant| / spacingLower) := by
            gcongr
      _ = 8 * |angularConstant| * spacingUpper / spacingLower := by ring
  apply aux_high_overlap_card_bound_of_normalized_chord hscale hgeometryFull hhigh
    (by positivity : 0 ≤ 8 * |angularConstant| * spacingUpper / spacingLower +
      2 * |angularConstant|) hB
  intro pair hpair
  have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1
  have hcenters := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsep
  have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
      (8 * |angularConstant| * spacingUpper / spacingLower) *
        scale ^ (-(1 / 2 : Real)) := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
            scale ^ (-(1 / 2 : Real)) := hcenters.2
      _ ≤ (8 * |angularConstant| * spacingUpper / spacingLower) *
            scale ^ (-(1 / 2 : Real)) :=
        mul_le_mul_of_nonneg_right hcoefficient hpow
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hz, hw, hzw⟩
  have hzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
  have hwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
  simpa only [aux_activeFirstNormalized, aux_activeSecondNormalized] using
    aux_chord_upper_of_center_direction_bounds hcenterUpper hzerr hwerr

private theorem aux_high_zero_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (hB : 2 * |angularConstant| +
      32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions 0 Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions 0 Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨hsectorPos, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := Real.rpow_nonneg hscalepos.le _
  have hBzero : 0 ≤ spacingUpper + 2 * |angularConstant| := by positivity
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_pre_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor) (D :=
        2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|))
      (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices 0 pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions 0 Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions 0 Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices 0 pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices 0 anchor).mp hasep
      have hcenterUpper : ‖directions pair.1 - directions pair.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata pair.1 hpdata.1).2.2 pair.2 hpdata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff pair.1 pair.2).mp hpdata.2.2
        calc
          ‖directions pair.1 - directions pair.2‖ ≤
              spacingUpper * ((pair.1 - pair.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      have hcenterUpperA : ‖directions anchor.1 - directions anchor.2‖ ≤
          spacingUpper * scale ^ (-(1 / 2 : Real)) := by
        have hraw := (hdata anchor.1 hadata.1).2.2 anchor.2 hadata.2.1 |>.2
        have hclass := (angularSeparationClass_zero_iff anchor.1 anchor.2).mp hadata.2.2
        calc
          ‖directions anchor.1 - directions anchor.2‖ ≤
              spacingUpper * ((anchor.1 - anchor.2).natAbs : Real) *
                scale ^ (-(1 / 2 : Real)) := hraw
          _ ≤ spacingUpper * 1 * scale ^ (-(1 / 2 : Real)) := by
            gcongr
            exact_mod_cast hclass
          _ = spacingUpper * scale ^ (-(1 / 2 : Real)) := by ring
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z pair hpair' with ⟨hz, hw, hzw⟩
      rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
        n n' indices directions 0 Z anchor hanchor' with ⟨az, aw, hazw⟩
      have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hz
      have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hw
      have hazerr := aux_plate_normalized_direction_bound_abs hscalepos az
      have hawerr := aux_plate_normalized_direction_bound_abs hscalepos aw
      have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpper hpzerr hpwerr
      have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1‖ ≤
          (spacingUpper + 2 * |angularConstant|) * scale ^ (-(1 / 2 : Real)) := by
        exact aux_chord_upper_of_center_direction_bounds hcenterUpperA hazerr hawerr
      have hcapP := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
        (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hz hw hzw hpchord
      have hcapA := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
        (le_trans (hdata anchor.1 hadata.1).2.1 hsector)
        (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector) hhigh az aw hazw hachord
      have hcapP' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hcapP
      have hcapA' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
        rw [norm_sub_rev]
        exact hcapA
      have hfirst := aux_direction_centres_close_of_normalized_output_caps hpow
        hpzerr hazerr hcapP' hcapA'
      have hsecond := by
        have hpzw : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).1 = Z := by
          rw [add_comm]
          exact hzw
        have hazw' : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).1 = Z := by
          rw [add_comm]
          exact hazw
        have hcapP2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector)
          (le_trans (hdata pair.1 hpdata.1).2.1 hsector) hhigh hw hz hpzw (by
            rw [norm_sub_rev]
            exact hpchord)
        have hcapA2 := aux_output_cap_of_high_sector_witness hscale hBzero hcenter
          (le_trans (hdata anchor.2 hadata.2.1).2.1 hsector)
          (le_trans (hdata anchor.1 hadata.1).2.1 hsector) hhigh aw az hazw' (by
            rw [norm_sub_rev]
            exact hachord)
        have hcapP2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z pair).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapP2
        have hcapA2' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions 0 Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions 0 Z anchor).2.1 - (‖Z.1‖)⁻¹ • Z.1‖ ≤
          16 * (spacingUpper + 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          rw [norm_sub_rev]
          exact hcapA2
        exact aux_direction_centres_close_of_normalized_output_caps hpow
          hpwerr hawerr hcapP2' hcapA2'
      exact Or.inl ⟨by convert hfirst using 1; ring,
        by convert hsecond using 1; ring⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- Two literal witnesses for the same translated unit-normal output have
uniformly stable polar inner coordinates.  This is the analytic core of the
fixed-area-sign cap reduction. -/
private theorem aux_two_active_polar_inner_coordinate_stable
    {scale angularConstant normalShift normalShift' B : Real} {n n' : Int}
    {direction mate direction' mate' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hB : 0 ≤ B)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (hchord : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤
      B * scale ^ (-(1 / 2 : Real))) :
    |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
        inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤
      264 + 768 * B ^ 2 * scale ^ (-(1 / 2 : Real)) := by
  have hscalepos : 0 < scale := by linarith
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hznorm : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hz'norm : ‖z'.1‖ ≠ 0 := norm_ne_zero_iff.mpr hz'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hsub : Z.1 - z.1 = w.1 := by rw [← hspace]; abel
  have hsub' : Z.1 - z'.1 = w'.1 := by rw [← hspace']; abel
  have hnormal :
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z.2 + w.2 = Z.2 := congrArg Prod.snd hzw
    have hznormal : |(z.2 - ‖z.1‖) - normalShift| ≤ 2 := hz.2.2.2.2
    have hwnormal : |(w.2 - ‖w.1‖) - normalShift'| ≤ 2 := hw.2.2.2.2
    calc
      |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| =
          |((z.2 - ‖z.1‖) - normalShift) +
            ((w.2 - ‖w.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z.2 - ‖z.1‖) - normalShift| +
          |(w.2 - ‖w.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have hnormal' :
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| ≤ 4 := by
    have htime : z'.2 + w'.2 = Z.2 := congrArg Prod.snd hz'w'
    have hznormal : |(z'.2 - ‖z'.1‖) - normalShift| ≤ 2 := hz'.2.2.2.2
    have hwnormal : |(w'.2 - ‖w'.1‖) - normalShift'| ≤ 2 := hw'.2.2.2.2
    calc
      |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) - (normalShift + normalShift')| =
          |((z'.2 - ‖z'.1‖) - normalShift) +
            ((w'.2 - ‖w'.1‖) - normalShift')| := by
              rw [← htime]
              ring_nf
      _ ≤ |(z'.2 - ‖z'.1‖) - normalShift| +
          |(w'.2 - ‖w'.1‖) - normalShift'| := abs_add_le _ _
      _ ≤ 4 := by linarith
  have htau :
      |(‖z.1‖ + ‖w.1‖) - (‖z'.1‖ + ‖w'.1‖)| ≤ 8 := by
    refine aux_total_radius_difference_le_eight
      (center := Z.2 - (normalShift + normalShift')) ?_ ?_
    · calc
        |(‖z.1‖ + ‖w.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift'))| := by congr 1; ring
        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z.1‖ + ‖w.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal
    · calc
        |(‖z'.1‖ + ‖w'.1‖) - (Z.2 - (normalShift + normalShift'))| =
            |-((Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift'))| := by congr 1; ring
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖) -
              (normalShift + normalShift'))| := by rw [abs_neg]
        _ = |(Z.2 - (‖z'.1‖ + ‖w'.1‖)) -
              (normalShift + normalShift')| := by ring_nf
        _ ≤ 4 := hnormal'
  have hzradius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz
  have hz'radius := aux_mem_unitNormalConicPlate_radius_localized hscalepos hz'
  have hradial : |‖z.1‖ - ‖z'.1‖| ≤ 6 * Real.sqrt scale :=
    aux_radial_window_difference_le_six_sqrt hscale hzradius hz'radius
  have htaubounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz.1 hz.2.1 hw.1 hw.2.1
  have htau'bounds := aux_sum_radius_bounds (by linarith : 0 ≤ scale)
    hz'.1 hz'.2.1 hw'.1 hw'.2.1
  have hdefect :
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z.1‖ * ‖w.1‖ * ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 := by
    calc
      (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z.1‖ + ‖w.1‖) ^ 2 - ‖z.1 + w.1‖ ^ 2 := by rw [hspace]
      _ = ‖z.1‖ * ‖w.1‖ *
          ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z.1 w.1 hznorm (norm_ne_zero_iff.mpr hwnonzero)
  have hdefect' :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
        ‖z'.1‖ * ‖w'.1‖ * ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 := by
    calc
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 =
          (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖z'.1 + w'.1‖ ^ 2 := by rw [hspace']
      _ = ‖z'.1‖ * ‖w'.1‖ *
          ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ^ 2 :=
        aux_twoCone_angular_defect_identity z'.1 w'.1 hz'norm (norm_ne_zero_iff.mpr hw'nonzero)
  have hdefect'nonneg : 0 ≤ (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
    rw [hdefect']
    positivity
  have hdefect'upper :
      (‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2 ≤ 16 * B ^ 2 * scale := by
    exact aux_defect_upper_of_chord_upper hscalepos hB (norm_nonneg _) (norm_nonneg _)
      hz'.2.1 hw'.2.1 hdefect' hchord (norm_nonneg _)
  have hdefectdiff :
      |((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) -
          ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2)| ≤ 128 * scale :=
    aux_defect_difference_le_one_twenty_eight_mul_scale (by linarith : 0 ≤ scale)
      (by positivity) (by positivity) htaubounds.2 htau'bounds.2 htau
  have hstable := aux_polar_inner_coordinate_difference_le_constant
    hscale hz.1 hz'.1 htau hdefectdiff hdefect'nonneg hdefect'upper hradial
  have hpz : inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) =
      (‖z.1‖ + ‖w.1‖) -
        ((‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z.1‖) := by
    simpa only [hsub] using aux_twoCone_polar_solve_inner Z.1 z.1 hznorm
  have hpz' : inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1) =
      (‖z'.1‖ + ‖w'.1‖) -
        ((‖z'.1‖ + ‖w'.1‖) ^ 2 - ‖Z.1‖ ^ 2) / (2 * ‖z'.1‖) := by
    simpa only [hsub'] using aux_twoCone_polar_solve_inner Z.1 z'.1 hz'norm
  rw [hpz, hpz']
  exact hstable

/-- A literal overlap pair supplies all of the coupled two-cone data for the
ellipse reduction.  In particular, the normal-coordinate estimates pin the
*sum* of the two radii, rather than merely placing the summands in independent
annuli. -/
private theorem aux_mem_unitNormalPlateOverlapPairs_twoCone_polar
    {scale angularConstant normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {pair : Int × Int}
    (hscale : 0 < scale)
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z) :
    pair ∈ angularSeparationPairs indices k ∧
      ∃ z ∈ unitNormalConicPlate scale angularConstant normalShift n (directions pair.1),
        ∃ w ∈ unitNormalConicPlate scale angularConstant normalShift' n' (directions pair.2),
          z + w = Z ∧
          |(Z.2 - (‖z.1‖ + ‖w.1‖)) - (normalShift + normalShift')| ≤ 4 ∧
          |‖z.1‖ - ((n : Real) * Real.sqrt scale - normalShift)| ≤ Real.sqrt scale + 2 ∧
          |‖w.1‖ - ((n' : Real) * Real.sqrt scale - normalShift')| ≤ Real.sqrt scale + 2 ∧
          ‖(‖z.1‖)⁻¹ • z.1 - directions pair.1‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          ‖(‖w.1‖)⁻¹ • w.1 - directions pair.2‖ ≤
            angularConstant * scale ^ (-(1 / 2 : Real)) ∧
          2 * ‖z.1‖ *
              ((‖z.1‖ + ‖w.1‖) - inner Real Z.1 ((‖z.1‖)⁻¹ • z.1)) =
            (‖z.1‖ + ‖w.1‖) ^ 2 - ‖Z.1‖ ^ 2 := by
  rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
    n n' indices directions k Z pair).mp hpair with ⟨hseparation, hsum⟩
  refine ⟨hseparation, ?_⟩
  rcases aux_mem_minkowskiSum_unitNormalConicPlate_twoCone hsum with
    ⟨z, hz, w, hw, hzw, htime⟩
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscale hz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscale hw
  have hzdirection := (aux_mem_unitNormalConicPlate_direction_localized hz).2
  have hwdirection := (aux_mem_unitNormalConicPlate_direction_localized hw).2
  have hznonzero := (aux_mem_unitNormalConicPlate_direction_localized hz).1
  have hznormnonzero : ‖z.1‖ ≠ 0 := norm_ne_zero_iff.mpr hznonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hsub : Z.1 - z.1 = w.1 := by
    rw [← hspace]
    abel
  have hpolar := aux_twoCone_polar_identity Z.1 z.1 hznormnonzero
  refine ⟨z, hz, w, hw, hzw, htime, hzradial, hwradial, hzdirection, hwdirection, ?_⟩
  simpa only [hsub] using hpolar

/-- A pair of bounded integer label windows, used as the final discrete
packing target after the two-branch geometric reduction. -/
private def aux_labelBox (anchor : Int × Int) (B : Nat) : Finset (Int × Int) :=
  Finset.Icc (anchor.1 - (B : Int)) (anchor.1 + (B : Int)) ×ˢ
    Finset.Icc (anchor.2 - (B : Int)) (anchor.2 + (B : Int))

private theorem aux_mem_labelBox_of_natAbs_sub_le
    {pair anchor : Int × Int} {B : Nat}
    (hfirst : (pair.1 - anchor.1).natAbs ≤ B)
    (hsecond : (pair.2 - anchor.2).natAbs ≤ B) :
    pair ∈ aux_labelBox anchor B := by
  simp only [aux_labelBox, Finset.mem_product, Finset.mem_Icc]
  constructor <;> constructor <;> omega

private theorem aux_card_labelBox (anchor : Int × Int) (B : Nat) :
    (aux_labelBox anchor B).card = (2 * B + 1) ^ 2 := by
  simp only [aux_labelBox, Finset.card_product, Int.card_Icc]
  have hfirst :
      (anchor.1 + (B : Int) + 1 - (anchor.1 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  have hsecond :
      (anchor.2 + (B : Int) + 1 - (anchor.2 - (B : Int))).toNat = 2 * B + 1 := by
    omega
  rw [hfirst, hsecond]
  ring

private theorem aux_card_le_two_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card :=
      Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card :=
      Finset.card_union_le _ _
    _ = 2 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox]
      ring

private theorem aux_card_le_three_labelBoxes
    (active : Finset (Int × Int)) (anchor₁ anchor₂ anchor₃ : Int × Int) (B : Nat)
    (hcover : active ⊆ aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
      aux_labelBox anchor₃ B) :
    active.card ≤ 3 * (2 * B + 1) ^ 2 := by
  calc
    active.card ≤
        (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B ∪
          aux_labelBox anchor₃ B).card := Finset.card_le_card hcover
    _ ≤ (aux_labelBox anchor₁ B ∪ aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := Finset.card_union_le _ _
    _ ≤ (aux_labelBox anchor₁ B).card + (aux_labelBox anchor₂ B).card +
        (aux_labelBox anchor₃ B).card := by
      gcongr
      exact Finset.card_union_le _ _
    _ = 3 * (2 * B + 1) ^ 2 := by
      rw [aux_card_labelBox, aux_card_labelBox, aux_card_labelBox]
      ring

/-- The lower half of `angularSectorGeometry` turns one direction ball of
radius `D * scale⁻¹ᐟ²` into a fixed integer label window. -/
private theorem aux_natAbs_sub_le_of_scaled_direction_bound
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {i anchor : Int} {B : Nat}
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hi : i ∈ indices) (hanchor : anchor ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hdist : ‖directions i - directions anchor‖ ≤
      D * scale ^ (-(1 / 2 : Real))) :
    (i - anchor).natAbs ≤ B := by
  rcases hgeometry with ⟨_, _, hspacingLower, _, _, _, hdata⟩
  have hpow : 0 < scale ^ (-(1 / 2 : Real)) :=
    Real.rpow_pos_of_pos hscale _
  have hlow : spacingLower * ((i - anchor).natAbs : Real) *
      scale ^ (-(1 / 2 : Real)) ≤ ‖directions i - directions anchor‖ :=
    (hdata i hi).2.2 anchor hanchor |>.1
  have hscaled :
      (spacingLower * ((i - anchor).natAbs : Real)) *
        scale ^ (-(1 / 2 : Real)) ≤
      D * scale ^ (-(1 / 2 : Real)) := by
    exact le_trans hlow hdist
  have hquot : spacingLower * ((i - anchor).natAbs : Real) ≤ D := by
    nlinarith [hscaled]
  have hreal : ((i - anchor).natAbs : Real) ≤ B := by
    nlinarith [hquot, hD]
  exact_mod_cast hreal

/-- The discrete conclusion needed from the continuous two-branch geometry:
two `scale⁻¹ᐟ²` direction boxes around active label pairs give a uniform
overlap-cardinality bound. -/
private theorem aux_card_le_two_labelBoxes_of_direction_boxes
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (active : Finset (Int × Int)) (anchor₁ anchor₂ : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor₁ : anchor₁.1 ∈ indices ∧ anchor₁.2 ∈ indices)
    (hanchor₂ : anchor₂.1 ∈ indices ∧ anchor₂.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      (‖directions pair.1 - directions anchor₁.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₁.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) ∨
      (‖directions pair.1 - directions anchor₂.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
        ‖directions pair.2 - directions anchor₂.2‖ ≤ D * scale ^ (-(1 / 2 : Real)))) :
    active.card ≤ 2 * (2 * B + 1) ^ 2 := by
  apply aux_card_le_two_labelBoxes active anchor₁ anchor₂ B
  intro pair hpair
  rcases hactive pair hpair with ⟨hfirst, hsecond⟩
  rcases hcover pair hpair with hleft | hright
  · apply Finset.mem_union_left
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₁.1 hD hleft.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₁.2 hD hleft.2
  · apply Finset.mem_union_right
    apply aux_mem_labelBox_of_natAbs_sub_le
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst
        hanchor₂.1 hD hright.1
    · exact aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond
        hanchor₂.2 hD hright.2

private theorem aux_low_scale_unitNormal_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {k : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hcap : 1 / 2 ≤ 2 * |angularConstant| * scale ^ (-(1 / 2 : Real)))
    (hB : 2 * |angularConstant| ≤ spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions k Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions k Z
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, _, _, center, _, hdata⟩
  have hscalepos : 0 < scale := by linarith
  by_cases hnonempty : active.Nonempty
  · obtain ⟨anchor, hanchor⟩ := hnonempty
    apply aux_card_le_two_labelBoxes_of_direction_boxes
      (active := active) (anchor₁ := anchor) (anchor₂ := anchor)
      (D := 2 * |angularConstant|) (B := B) hscalepos hgeometryFull
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z anchor).mp hanchor' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k anchor).mp hsep |>.2.1⟩
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      rcases (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift normalShift'
        n n' indices directions k Z pair).mp hpair' with ⟨hsep, _⟩
      exact ⟨(mem_angularSeparationPairs_iff indices k pair).mp hsep |>.1,
        (mem_angularSeparationPairs_iff indices k pair).mp hsep |>.2.1⟩
    · exact hB
    · intro pair hpair
      have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hpair
      have hanchor' : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
          normalShift' n n' indices directions k Z := by simpa [active] using hanchor
      have hpsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z pair).mp hpair' |>.1
      have hasep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
        normalShift' n n' indices directions k Z anchor).mp hanchor' |>.1
      have hpdata := (mem_angularSeparationPairs_iff indices k pair).mp hpsep
      have hadata := (mem_angularSeparationPairs_iff indices k anchor).mp hasep
      have hfirst : ‖directions pair.1 - directions anchor.1‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.1 - directions anchor.1‖ ≤
              ‖directions pair.1 - center‖ + ‖center - directions anchor.1‖ := by
            rw [show directions pair.1 - directions anchor.1 =
              (directions pair.1 - center) + (center - directions anchor.1) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.1 - center‖ + ‖directions anchor.1 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.1 hpdata.1).2.1 (hdata anchor.1 hadata.1).2.1
          _ ≤ 1 / 2 := by linarith
      have hsecond : ‖directions pair.2 - directions anchor.2‖ ≤ 1 / 2 := by
        calc
          ‖directions pair.2 - directions anchor.2‖ ≤
              ‖directions pair.2 - center‖ + ‖center - directions anchor.2‖ := by
            rw [show directions pair.2 - directions anchor.2 =
              (directions pair.2 - center) + (center - directions anchor.2) by abel]
            exact norm_add_le _ _
          _ = ‖directions pair.2 - center‖ + ‖directions anchor.2 - center‖ := by
            exact congrArg (fun q : Real => ‖directions pair.2 - center‖ + q)
              (norm_sub_rev _ _)
          _ ≤ sectorRadius + sectorRadius := add_le_add
            (hdata pair.2 hpdata.2.1).2.1 (hdata anchor.2 hadata.2.1).2.1
          _ ≤ 1 / 2 := by linarith
      exact Or.inl ⟨le_trans hfirst hcap, le_trans hsecond hcap⟩
  · have hempty : active = ∅ := Finset.not_nonempty_iff_eq_empty.mp hnonempty
    simp [active, hempty]

/-- The coupled polar-coordinate calculation on one fixed area-sign branch.
This is deliberately phrased for literal witnesses so the finite packing step
can classify canonical witnesses without losing the normal/time coupling. -/
private theorem aux_transverse_same_sign_first_normalized_bound
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {scale h sq B lambda C ell angularConstant normalShift normalShift' : Real}
    {n n' : Int}
    {direction mate direction' mate' : _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {Z z w z' w' : WaveSpaceTime}
    (hscale : 2 ≤ scale) (hh : 0 < h) (hhdef : h = scale ^ (-(1 / 2 : Real)))
    (hsq : 1 ≤ sq) (hsqroot : sq = Real.sqrt scale)
    (hhsq : h * sq = 1) (hhsquare : h ^ 2 * scale = 1)
    (hell : 0 < ell) (helllambda : ell ≤ lambda)
    (hC : 0 ≤ C) (hB : 0 ≤ B) (hlambda : 0 ≤ lambda)
    (hcompare : B ≤ C * lambda) (hlambdah : lambda * h ≤ 1 / 4)
    (hXlower : scale / 4 ≤ ‖Z.1‖)
    (hz : z ∈ unitNormalConicPlate scale angularConstant normalShift n direction)
    (hw : w ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate)
    (hz' : z' ∈ unitNormalConicPlate scale angularConstant normalShift n direction')
    (hw' : w' ∈ unitNormalConicPlate scale angularConstant normalShift' n' mate')
    (hzw : z + w = Z) (hz'w' : z' + w' = Z)
    (_hchord : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ B * h)
    (hchord' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ B * h)
    (hclose : ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖ ≤ 1)
    (hclose' : ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖ ≤ 1)
    (hgap : lambda * h ≤ ‖(‖z.1‖)⁻¹ • z.1 - (‖w.1‖)⁻¹ • w.1‖)
    (hgap' : lambda * h ≤ ‖(‖z'.1‖)⁻¹ • z'.1 - (‖w'.1‖)⁻¹ • w'.1‖)
    (hsign :
      (0 ≤ (o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ∧
        0 ≤ (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)) ∨
      ((o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1) ≤ 0 ∧
        (o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1) ≤ 0)) :
    ‖(‖z.1‖)⁻¹ • z.1 - (‖z'.1‖)⁻¹ • z'.1‖ ≤
      ((1056 + 192 * C ^ 2) + (4224 / ell + 1536 * C ^ 2)) * h := by
  have hscalepos : 0 < scale := by linarith
  have hlambdapos : 0 < lambda := lt_of_lt_of_le hell helllambda
  have hXpos : 0 < ‖Z.1‖ := by linarith
  have hXnonzero : Z.1 ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hXpos)
  have hznonzero : z.1 ≠ 0 := hz.2.2.1.1
  have hwnonzero : w.1 ≠ 0 := hw.2.2.1.1
  have hz'nonzero : z'.1 ≠ 0 := hz'.2.2.1.1
  have hw'nonzero : w'.1 ≠ 0 := hw'.2.2.1.1
  have hzu := aux_norm_normalized_eq_one hznonzero
  have hwu := aux_norm_normalized_eq_one hwnonzero
  have hzu' := aux_norm_normalized_eq_one hz'nonzero
  have hwu' := aux_norm_normalized_eq_one hw'nonzero
  have hspace : z.1 + w.1 = Z.1 := congrArg Prod.fst hzw
  have hspace' : z'.1 + w'.1 = Z.1 := congrArg Prod.fst hz'w'
  have hzrepr := aux_eq_norm_smul_normalized hznonzero
  have hwrepr := aux_eq_norm_smul_normalized hwnonzero
  have hz'repr := aux_eq_norm_smul_normalized hz'nonzero
  have hw'repr := aux_eq_norm_smul_normalized hw'nonzero
  have hrepr : Z.1 =
      ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) := by
    calc
      Z.1 = z.1 + w.1 := hspace.symm
      _ = ‖z.1‖ • ((‖z.1‖)⁻¹ • z.1) + ‖w.1‖ • ((‖w.1‖)⁻¹ • w.1) :=
        congrArg₂ (· + ·) hzrepr hwrepr
  have hrepr' : Z.1 =
      ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) := by
    calc
      Z.1 = z'.1 + w'.1 := hspace'.symm
      _ = ‖z'.1‖ • ((‖z'.1‖)⁻¹ • z'.1) + ‖w'.1‖ • ((‖w'.1‖)⁻¹ • w'.1) :=
        congrArg₂ (· + ·) hz'repr hw'repr
  have harea : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z.1‖)⁻¹ • z.1)| := by
    have harea' := aux_transverse_area_lower_of_chord_lower o hscalepos hw.1 hlambda
      hrepr hzu hwu hclose (by simpa [hhdef] using hgap)
    simpa [hsqroot] using harea'
  have harea' : lambda * sq / 8 ≤ |(o.areaForm Z.1) ((‖z'.1‖)⁻¹ • z'.1)| := by
    have harea'' := aux_transverse_area_lower_of_chord_lower o hscalepos hw'.1 hlambda
      hrepr' hzu' hwu' hclose' (by simpa [hhdef] using hgap')
    simpa [hsqroot] using harea''
  have hinner := aux_two_active_polar_inner_coordinate_stable hscale hB
    hz hw hz' hw' hzw hz'w' (by
      simpa [hhdef] using hchord')
  have hinner' : |inner Real Z.1 ((‖z.1‖)⁻¹ • z.1) -
      inner Real Z.1 ((‖z'.1‖)⁻¹ • z'.1)| ≤ 264 + 768 * B ^ 2 * h := by
    simpa [hhdef] using hinner
  have hquot := aux_transverse_coordinate_quotient_bounds
    hscale hh hsq hhsq hhsquare hell helllambda hC hB hlambda hcompare hlambdah
  have hDnonneg : 0 ≤ 264 + 768 * B ^ 2 * h := by positivity
  have hquarterpos : 0 < scale / 4 := by linarith
  have hXquot : (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
      (1056 + 192 * C ^ 2) * h := by
    calc
      (264 + 768 * B ^ 2 * h) / ‖Z.1‖ ≤
          (264 + 768 * B ^ 2 * h) / (scale / 4) := by
        exact div_le_div_of_nonneg_left hDnonneg hquarterpos hXlower
      _ ≤ (1056 + 192 * C ^ 2) * h := hquot.1
  exact aux_same_sign_direction_bound_of_coordinate_bounds o hXpos
    (by positivity : 0 < lambda * sq / 8) hzu hzu' ⟨harea, harea'⟩ hsign hinner'
    hXquot hquot.2

private def aux_transverseCoreConstant (spacingLower spacingUpper : Real) : Real :=
  (1056 + 192 * (4 * spacingUpper / spacingLower + 1) ^ 2) +
    (4224 / (spacingLower / 2) +
      1536 * (4 * spacingUpper / spacingLower + 1) ^ 2)

private def aux_transverseCapConstant
    (angularConstant spacingLower spacingUpper : Real) : Real :=
  2 * |angularConstant| + 48 +
    16 * aux_transverseCoreConstant spacingLower spacingUpper

set_option maxHeartbeats 800000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- The high transverse branch has two stable directional caps, one for each
area sign.  This is the literal pairwise cap estimate used by the finite
label-box cover. -/
private theorem aux_high_transverse_same_sign_direction_boxes
    (o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2))
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {pair anchor : Int × Int}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hpair : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hanchor : anchor ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z)
    (hsign :
      (0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ∧
        0 ≤ (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor)) ∨
      ((o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair) ≤ 0 ∧
        (o.areaForm Z.1)
          (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor) ≤ 0)) :
    ‖directions pair.1 - directions anchor.1‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤
        aux_transverseCapConstant angularConstant spacingLower spacingUpper *
          scale ^ (-(1 / 2 : Real)) := by
  have hgeometryFull := hgeometry
  rcases hgeometry with ⟨_, hsector, hspacingLower, hspacingUpper,
    center, hcenter, hdata⟩
  have hscalepos : 0 < scale := by linarith
  have hpowpos : 0 < scale ^ (-(1 / 2 : Real)) := Real.rpow_pos_of_pos hscalepos _
  have hpow : 0 ≤ scale ^ (-(1 / 2 : Real)) := hpowpos.le
  have hsq : 1 ≤ Real.sqrt scale := Real.one_le_sqrt.mpr (by linarith)
  have hhsq := aux_rpow_neg_half_mul_sqrt_eq_one hscalepos
  have hhsquare := aux_rpow_neg_half_sq_mul_scale_eq_one hscalepos
  have hqpos : 0 < ((2 ^ m : Nat) : Real) := by positivity
  have hqone : 1 ≤ ((2 ^ m : Nat) : Real) := by
    exact_mod_cast (Nat.one_le_two_pow)
  have hell : 0 < spacingLower / 2 := by positivity
  have helllambda : spacingLower / 2 ≤
      spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
    have hmul : spacingLower * 1 ≤ spacingLower * ((2 ^ m : Nat) : Real) :=
      mul_le_mul_of_nonneg_left hqone hspacingLower.le
    nlinarith [hmul]
  have hlambda : 0 ≤ spacingLower * ((2 ^ m : Nat) : Real) / 2 := by positivity
  have hU : 0 ≤ 2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| := by
    positivity
  have hC : 0 ≤ 4 * spacingUpper / spacingLower + 1 := by positivity
  have hcompare :
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
        (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
    have harea : 2 * |angularConstant| ≤
        spacingLower * ((2 ^ m : Nat) : Real) / 2 := by
      nlinarith [htransverse]
    calc
      2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant| ≤
          2 * spacingUpper * ((2 ^ m : Nat) : Real) +
            spacingLower * ((2 ^ m : Nat) : Real) / 2 := by gcongr
      _ = (4 * spacingUpper / spacingLower + 1) *
          (spacingLower * ((2 ^ m : Nat) : Real) / 2) := by
          field_simp [ne_of_gt hspacingLower]
          ring
  have hsepPair := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z pair).mp hpair |>.1
  have hsepAnchor := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
    normalShift' n n' indices directions (m + 1) Z anchor).mp hanchor |>.1
  have hcentersPair := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepPair
  have hcentersAnchor := aux_angular_direction_chord_bounds_succ hscalepos hgeometryFull hsepAnchor
  have hscaled := aux_scaled_dyadic_index_le_half hscalepos hgeometryFull hsepPair
  have hlambdah : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤ 1 / 4 := by
    nlinarith [hscaled]
  have hpdata := (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsepPair
  have hadata := (mem_angularSeparationPairs_iff indices (m + 1) anchor).mp hsepAnchor
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z pair hpair with ⟨hpz, hpw, hpzw⟩
  rcases aux_active_pair_witness_spec scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z anchor hanchor with ⟨haz, haw, hazw⟩
  have hpzerr := aux_plate_normalized_direction_bound_abs hscalepos hpz
  have hpwerr := aux_plate_normalized_direction_bound_abs hscalepos hpw
  have hazerr := aux_plate_normalized_direction_bound_abs hscalepos haz
  have hawerr := aux_plate_normalized_direction_bound_abs hscalepos haw
  have hpchordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersPair.1 hpzerr hpwerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hachordlower : (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
      scale ^ (-(1 / 2 : Real)) ≤
        ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 -
          (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1‖ := by
    have hraw := aux_chord_lower_of_center_direction_bounds hcentersAnchor.1 hazerr hawerr
    calc
      (spacingLower * ((2 ^ m : Nat) : Real) / 2) *
          scale ^ (-(1 / 2 : Real)) ≤
          (spacingLower * ((2 ^ m : Nat) : Real) - 2 * |angularConstant|) *
            scale ^ (-(1 / 2 : Real)) := by
          apply mul_le_mul_of_nonneg_right _ hpow
          nlinarith [htransverse]
      _ ≤ _ := hraw
  have hpchord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions pair.1 - directions pair.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions pair.1 - directions pair.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersPair.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hpzerr hpwerr
  have hachord : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).2.1‖ ≤
      (2 * spacingUpper * ((2 ^ m : Nat) : Real) + 2 * |angularConstant|) *
        scale ^ (-(1 / 2 : Real)) := by
    have hupper : ‖directions anchor.1 - directions anchor.2‖ ≤
        (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
          scale ^ (-(1 / 2 : Real)) := by
      calc
        ‖directions anchor.1 - directions anchor.2‖ ≤
            spacingUpper * ((2 ^ (m + 1) : Nat) : Real) *
              scale ^ (-(1 / 2 : Real)) := hcentersAnchor.2
        _ = (2 * spacingUpper * ((2 ^ m : Nat) : Real)) *
              scale ^ (-(1 / 2 : Real)) := by
              have hpowtwo : ((2 ^ (m + 1) : Nat) : Real) =
                  2 * ((2 ^ m : Nat) : Real) := by
                rw [pow_succ, Nat.cast_mul]
                norm_num
                ring
              rw [hpowtwo]
              ring
    exact aux_chord_upper_of_center_direction_bounds hupper hazerr hawerr
  have hcenterPair : ‖directions pair.1 - directions pair.2‖ ≤ 1 / 2 := by
    calc
      ‖directions pair.1 - directions pair.2‖ ≤
          ‖directions pair.1 - center‖ + ‖center - directions pair.2‖ := by
        rw [show directions pair.1 - directions pair.2 =
          (directions pair.1 - center) + (center - directions pair.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions pair.1 - center‖ + ‖directions pair.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions pair.1 - center‖ + q)
          (norm_sub_rev center (directions pair.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata pair.1 hpdata.1).2.1
        · exact (hdata pair.2 hpdata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hcenterAnchor : ‖directions anchor.1 - directions anchor.2‖ ≤ 1 / 2 := by
    calc
      ‖directions anchor.1 - directions anchor.2‖ ≤
          ‖directions anchor.1 - center‖ + ‖center - directions anchor.2‖ := by
        rw [show directions anchor.1 - directions anchor.2 =
          (directions anchor.1 - center) + (center - directions anchor.2) by abel]
        exact norm_add_le _ _
      _ = ‖directions anchor.1 - center‖ + ‖directions anchor.2 - center‖ := by
        exact congrArg (fun q : Real => ‖directions anchor.1 - center‖ + q)
          (norm_sub_rev center (directions anchor.2))
      _ ≤ sectorRadius + sectorRadius := by
        apply add_le_add
        · exact (hdata anchor.1 hadata.1).2.1
        · exact (hdata anchor.2 hadata.2.1).2.1
      _ ≤ 1 / 2 := by linarith
  have hpclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterPair hpz hpw
  have haclose := aux_normalized_chord_le_one_of_high_common_sector hscalepos hhigh
    hcenterAnchor haz haw
  have hXlower := aux_output_norm_lower_of_high_sector_witnesses hscale hcenter
    (le_trans (hdata pair.1 hpdata.1).2.1 hsector)
    (le_trans (hdata pair.2 hpdata.2.1).2.1 hsector) hhigh hpz hpw hpzw
  have hfirstnorm := aux_transverse_same_sign_first_normalized_bound o
    hscale hpowpos rfl hsq rfl hhsq hhsquare hell helllambda hC hU hlambda hcompare hlambdah
    hXlower hpz hpw haz haw hpzw hazw hpchord hachord hpclose haclose
    hpchordlower hachordlower (by
      simpa only [aux_activeFirstNormalized] using hsign)
  have hcore : 0 ≤ aux_transverseCoreConstant spacingLower spacingUpper := by
    simp only [aux_transverseCoreConstant]
    positivity
  have hfirstnorm' : ‖(‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair).1.1 -
      (‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
      (aux_active_pair_witness scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z anchor).1.1‖ ≤
      aux_transverseCoreConstant spacingLower spacingUpper *
        scale ^ (-(1 / 2 : Real)) := by
    simpa only [aux_transverseCoreConstant] using hfirstnorm
  have hfirst := aux_direction_centres_close_of_normalized_pair
    hpzerr hazerr hfirstnorm'
  have hzradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpz
  have hazradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haz
  have hwradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos hpw
  have hawradial := aux_mem_unitNormalConicPlate_radius_localized hscalepos haw
  have hrdiff := aux_radial_window_difference_le_six_sqrt hscale hzradial hazradial
  have hsdiff := aux_radial_window_difference_le_six_sqrt hscale hwradial hawradial
  have hpznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).1.1 ≠ 0 := hpz.2.2.1.1
  have hpwnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z pair).2.1 ≠ 0 := hpw.2.2.1.1
  have haznonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).1.1 ≠ 0 := haz.2.2.1.1
  have hawnonzero : (aux_active_pair_witness scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z anchor).2.1 ≠ 0 := haw.2.2.1.1
  have hsecondnorm := aux_second_direction_bound_of_first_and_radial_windows
    hscalepos hcore (norm_nonneg _) hpz.2.1 hpw.1 hrdiff hsdiff hfirstnorm'
    (aux_norm_normalized_eq_one haznonzero)
    (aux_norm_normalized_eq_one hawnonzero)
    (by
      have hpzrepr := aux_eq_norm_smul_normalized hpznonzero
      have hpwrepr := aux_eq_norm_smul_normalized hpwnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).2.1 = Z.1 := congrArg Prod.fst hpzw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z pair).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z pair).2.1) := congrArg₂ (· + ·) hpzrepr hpwrepr)
    (by
      have hazrepr := aux_eq_norm_smul_normalized haznonzero
      have hawrepr := aux_eq_norm_smul_normalized hawnonzero
      have hspace : (aux_active_pair_witness scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z anchor).1.1 +
          (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).2.1 = Z.1 := congrArg Prod.fst hazw
      calc
        Z.1 = (aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1 +
            (aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1 := hspace.symm
        _ = ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
            n n' indices directions (m + 1) Z anchor).1.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).1.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).1.1) +
            ‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖ •
            ((‖(aux_active_pair_witness scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor).2.1‖)⁻¹ •
              (aux_active_pair_witness scale angularConstant normalShift normalShift'
                n n' indices directions (m + 1) Z anchor).2.1) := congrArg₂ (· + ·) hazrepr hawrepr)
  have hsecond := aux_direction_centres_close_of_normalized_pair hpwerr hawerr hsecondnorm
  constructor
  · calc
      ‖directions pair.1 - directions anchor.1‖ ≤
          (2 * |angularConstant| + aux_transverseCoreConstant spacingLower spacingUpper) *
            scale ^ (-(1 / 2 : Real)) := hfirst
      _ ≤ aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            apply mul_le_mul_of_nonneg_right _ hpow
            simp only [aux_transverseCapConstant]
            nlinarith [hcore]
  · calc
      ‖directions pair.2 - directions anchor.2‖ ≤
          (2 * |angularConstant| +
            (48 + 16 * aux_transverseCoreConstant spacingLower spacingUpper)) *
            scale ^ (-(1 / 2 : Real)) := hsecond
      _ = aux_transverseCapConstant angularConstant spacingLower spacingUpper *
            scale ^ (-(1 / 2 : Real)) := by
            simp only [aux_transverseCapConstant]
            ring

private theorem aux_card_le_one_labelBox_of_direction_box
    {scale sectorRadius spacingLower spacingUpper D : Real}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    (active : Finset (Int × Int)) (anchor : Int × Int) (B : Nat)
    (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hanchor : anchor.1 ∈ indices ∧ anchor.2 ∈ indices)
    (hactive : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices)
    (hD : D ≤ spacingLower * (B : Real))
    (hcover : ∀ pair ∈ active,
      ‖directions pair.1 - directions anchor.1‖ ≤ D * scale ^ (-(1 / 2 : Real)) ∧
      ‖directions pair.2 - directions anchor.2‖ ≤ D * scale ^ (-(1 / 2 : Real))) :
    active.card ≤ (2 * B + 1) ^ 2 := by
  calc
    active.card ≤ (aux_labelBox anchor B).card := by
      apply Finset.card_le_card
      intro pair hpair
      rcases hactive pair hpair with ⟨hfirst, hsecond⟩
      rcases hcover pair hpair with ⟨hfirstbox, hsecondbox⟩
      exact aux_mem_labelBox_of_natAbs_sub_le
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hfirst hanchor.1 hD hfirstbox)
        (aux_natAbs_sub_le_of_scaled_direction_bound hscale hgeometry hsecond hanchor.2 hD
            hsecondbox)
    _ = (2 * B + 1) ^ 2 := aux_card_labelBox anchor B

set_option maxHeartbeats 1200000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
private theorem aux_high_transverse_overlap_card_bound
    {scale angularConstant sectorRadius spacingLower spacingUpper : Real}
    {normalShift normalShift' : Real} {n n' : Int}
    {indices : Finset Int}
        {directions : Int → _root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2}
    {m : Nat} {Z : WaveSpaceTime} {B : Nat}
    (hscale : 2 ≤ scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4)
    (htransverse : 4 * |angularConstant| <
      spacingLower * ((2 ^ m : Nat) : Real))
    (hB : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
      spacingLower * (B : Real)) :
    (unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
      n n' indices directions (m + 1) Z).card ≤ 2 * (2 * B + 1) ^ 2 := by
  classical
  let active := unitNormalPlateOverlapPairs scale angularConstant normalShift normalShift'
    n n' indices directions (m + 1) Z
  let o : Orientation Real (_root_.Auto.Spherical.SurfaceMeasureDecay.Euclidean 2) (Fin 2) :=
    (EuclideanSpace.basisFun (Fin 2) Real).toBasis.orientation
  let positive : Finset (Int × Int) := active.filter fun pair =>
    0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  let negative : Finset (Int × Int) := active.filter fun pair =>
    ¬ 0 ≤ (o.areaForm Z.1)
      (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
        n n' indices directions (m + 1) Z pair)
  have hscalepos : 0 < scale := by linarith
  have hactiveIndices : ∀ pair ∈ active, pair.1 ∈ indices ∧ pair.2 ∈ indices := by
    intro pair hpair
    have hpair' : pair ∈ unitNormalPlateOverlapPairs scale angularConstant normalShift
        normalShift' n n' indices directions (m + 1) Z := by simpa [active] using hpair
    have hsep := (mem_unitNormalPlateOverlapPairs_iff scale angularConstant normalShift
      normalShift' n n' indices directions (m + 1) Z pair).mp hpair' |>.1
    exact ⟨(mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.1,
      (mem_angularSeparationPairs_iff indices (m + 1) pair).mp hsep |>.2.1⟩
  have hsplit : active ⊆ positive ∪ negative := by
    intro pair hpair
    by_cases hp : 0 ≤ (o.areaForm Z.1)
        (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
          n n' indices directions (m + 1) Z pair)
    · apply Finset.mem_union_left
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
    · apply Finset.mem_union_right
      exact Finset.mem_filter.mpr ⟨hpair, hp⟩
  have hpositiveBound : positive.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hpos : positive.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hpos
      apply aux_card_le_one_labelBox_of_direction_box positive anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inl ⟨hpairSign, hanchorSign⟩)
        exact hboxes
    · have hempty : positive = ∅ := Finset.not_nonempty_iff_eq_empty.mp hpos
      simp [hempty]
  have hnegativeBound : negative.card ≤ (2 * B + 1) ^ 2 := by
    by_cases hneg : negative.Nonempty
    · obtain ⟨anchor, hanchor⟩ := hneg
      apply aux_card_le_one_labelBox_of_direction_box negative anchor B hscalepos hgeometry
      · exact hactiveIndices anchor (Finset.mem_filter.mp hanchor).1
      · intro pair hpair
        exact hactiveIndices pair (Finset.mem_filter.mp hpair).1
      · exact hB
      · intro pair hpair
        have hpairActive := (Finset.mem_filter.mp hpair).1
        have hpairSign := (Finset.mem_filter.mp hpair).2
        have hanchorActive := (Finset.mem_filter.mp hanchor).1
        have hanchorSign := (Finset.mem_filter.mp hanchor).2
        have hpairNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z pair) ≤ 0 :=
          le_of_lt (lt_of_not_ge hpairSign)
        have hanchorNonpos : (o.areaForm Z.1)
            (aux_activeFirstNormalized scale angularConstant normalShift normalShift'
              n n' indices directions (m + 1) Z anchor) ≤ 0 :=
          le_of_lt (lt_of_not_ge hanchorSign)
        have hboxes := aux_high_transverse_same_sign_direction_boxes o hscale hgeometry
          hhigh htransverse
          (by simpa [active] using hpairActive)
          (by simpa [active] using hanchorActive)
          (Or.inr ⟨hpairNonpos, hanchorNonpos⟩)
        exact hboxes
    · have hempty : negative = ∅ := Finset.not_nonempty_iff_eq_empty.mp hneg
      simp [hempty]
  calc
    active.card ≤ (positive ∪ negative).card := Finset.card_le_card hsplit
    _ ≤ positive.card + negative.card := Finset.card_union_le _ _
    _ ≤ (2 * B + 1) ^ 2 + (2 * B + 1) ^ 2 := add_le_add hpositiveBound hnegativeBound
    _ = 2 * (2 * B + 1) ^ 2 := by ring

set_option maxHeartbeats 1200000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
theorem translatedUnitNormalPlateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real) :
    translatedUnitNormalPlateOverlap maxLevel angularConstant sectorRadius
      spacingLower spacingUpper := by
  classical
  by_cases hspacingLower : 0 < spacingLower
  · by_cases hspacingUpper : 0 < spacingUpper
    · let Dlow : Real := 2 * |angularConstant|
      let Dzero : Real := 2 * |angularConstant| +
        32 * (spacingUpper + 2 * |angularConstant|)
      let Dtangent : Real := 2 * |angularConstant| +
        32 * (8 * |angularConstant| * spacingUpper / spacingLower +
          2 * |angularConstant|)
      let Dtransverse : Real :=
        aux_transverseCapConstant angularConstant spacingLower spacingUpper
      let D : Real := Dlow + Dzero + Dtangent + Dtransverse
      have hDlow0 : 0 ≤ Dlow := by
        simp only [Dlow]
        positivity
      have hDzero0 : 0 ≤ Dzero := by
        simp only [Dzero]
        positivity
      have hDtangent0 : 0 ≤ Dtangent := by
        simp only [Dtangent]
        positivity
      have hDtransverse0 : 0 ≤ Dtransverse := by
        simp only [Dtransverse, aux_transverseCapConstant,
          aux_transverseCoreConstant]
        positivity
      have hDlow : Dlow ≤ D := by
        dsimp [D]
        nlinarith
      have hDzero : Dzero ≤ D := by
        dsimp [D]
        nlinarith
      have hDtangent : Dtangent ≤ D := by
        dsimp [D]
        nlinarith
      have hDtransverse : Dtransverse ≤ D := by
        dsimp [D]
        nlinarith
      obtain ⟨B, hB⟩ := exists_nat_gt (D / spacingLower)
      refine ⟨2 * (2 * B + 1) ^ 2, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      have hBD : D ≤ spacingLower * (B : Real) := by
        simpa [mul_comm] using (div_lt_iff₀ hspacingLower).mp hB |>.le
      have hBlow : 2 * |angularConstant| ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| = Dlow := by simp only [Dlow]
          _ ≤ D := hDlow
          _ ≤ spacingLower * (B : Real) := hBD
      have hBzero : 2 * |angularConstant| +
          32 * (spacingUpper + 2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| + 32 * (spacingUpper + 2 * |angularConstant|) = Dzero := by
            simp only [Dzero]
          _ ≤ D := hDzero
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtangent : 2 * |angularConstant| +
          32 * (8 * |angularConstant| * spacingUpper / spacingLower +
            2 * |angularConstant|) ≤ spacingLower * (B : Real) := by
        calc
          2 * |angularConstant| +
              32 * (8 * |angularConstant| * spacingUpper / spacingLower +
                2 * |angularConstant|) = Dtangent := by simp only [Dtangent]
          _ ≤ D := hDtangent
          _ ≤ spacingLower * (B : Real) := hBD
      have hBtransverse : aux_transverseCapConstant angularConstant spacingLower spacingUpper ≤
          spacingLower * (B : Real) := by
        calc
          aux_transverseCapConstant angularConstant spacingLower spacingUpper = Dtransverse := by
            simp only [Dtransverse]
          _ ≤ D := hDtransverse
          _ ≤ spacingLower * (B : Real) := hBD
      by_cases hhigh : |angularConstant| * scale ^ (-(1 / 2 : Real)) ≤ 1 / 4
      · cases k with
        | zero =>
            simpa [unitNormalPlateOverlapMultiplicity] using
              (aux_high_zero_unitNormal_overlap_card_bound hscale hgeometry hhigh hBzero)
        | succ m =>
            by_cases htangent : spacingLower * ((2 ^ m : Nat) : Real) ≤
                4 * |angularConstant|
            · simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_tangent_overlap_card_bound hscale hgeometry hhigh htangent hBtangent)
            · have htransverse : 4 * |angularConstant| <
                spacingLower * ((2 ^ m : Nat) : Real) := lt_of_not_ge htangent
              simpa [unitNormalPlateOverlapMultiplicity] using
                (aux_high_transverse_overlap_card_bound hscale hgeometry hhigh htransverse
                  hBtransverse)
      · have hcap : 1 / 2 ≤
          2 * |angularConstant| * scale ^ (-(1 / 2 : Real)) := by
            nlinarith [lt_of_not_ge hhigh]
        simpa [unitNormalPlateOverlapMultiplicity] using
          (aux_low_scale_unitNormal_overlap_card_bound hscale hgeometry hcap hBlow)
    · refine ⟨0, ?_⟩
      intro scale hscale radialIndices angularIndices directions hgeometry
        n hn n' hn' k hk Z normalShift normalShift'
      rcases hgeometry with ⟨_, _, _, hupper, _, _, _⟩
      exact False.elim (hspacingUpper hupper)
  · refine ⟨0, ?_⟩
    intro scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z normalShift normalShift'
    rcases hgeometry with ⟨_, _, hlower, _, _, _, _⟩
    exact False.elim (hspacingLower hlower)

/-- Conditional thick-plate overlap transfer.  The only geometric hypothesis
is `translatedUnitNormalPlateOverlap`; the finite `4 ℤ` normal cover and its
two-factor cardinality loss are proved above. -/
theorem plateOverlap_of_translatedUnitNormalPlateOverlap
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (hunit : translatedUnitNormalPlateOverlap maxLevel angularConstant
      sectorRadius spacingLower spacingUpper) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  rcases hunit with ⟨M, hM⟩
  refine ⟨hangular, 2, by norm_num, ?_⟩
  intro gamma hgamma hgammaUpper
  refine ⟨36 * (M : Real) + 1, by positivity, ?_⟩
  intro scale hscale radialIndices angularIndices directions hgeometry n hn n' hn' k hk Z
  let normalShifts : Finset Real := normalCoverShifts (scale ^ gamma)
  have hcover : normalCoordinatePlateCover scale gamma angularConstant normalShifts := by
    simpa [normalShifts] using
      normalCoordinatePlateCover_normalCoverShifts scale gamma angularConstant
  have hunitBound : ∀ shift ∈ normalShifts, ∀ shift' ∈ normalShifts,
      unitNormalPlateOverlapMultiplicity scale angularConstant shift shift'
        n n' angularIndices directions k Z ≤ M := by
    intro shift hshift shift' hshift'
    exact hM scale hscale radialIndices angularIndices directions hgeometry n hn n' hn'
      k hk Z shift shift'
  have hnat := plateOverlapMultiplicity_le_normalCover_mul_unitBound
    scale gamma angularConstant normalShifts n n' angularIndices directions k Z M hcover hunitBound
  have hmult : (plateOverlapMultiplicity scale gamma angularConstant n n'
      angularIndices directions k Z : Real) ≤
      (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := by
    exact_mod_cast hnat
  have hcard : (normalShifts.card : Real) ≤ 6 * scale ^ gamma := by
    simpa [normalShifts] using
      card_normalCoverShifts_at_scale_le_six_mul scale gamma hscale hgamma.le
  have hcard0 : 0 ≤ (normalShifts.card : Real) := Nat.cast_nonneg _
  have hsquare : (normalShifts.card : Real) * (normalShifts.card : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) :=
    mul_self_le_mul_self hcard0 hcard
  have hM0 : 0 ≤ (M : Real) := Nat.cast_nonneg _
  have hscaled : (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) ≤
      (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) :=
    mul_le_mul_of_nonneg_right hsquare hM0
  have hscale0 : 0 ≤ scale := by linarith
  have hscalePos : 0 < scale := by linarith
  have hrpow : scale ^ gamma * scale ^ gamma = scale ^ (2 * gamma) := by
    rw [← Real.rpow_add hscalePos]
    congr 1
    ring
  have htarget0 : 0 ≤ scale ^ (2 * gamma) := Real.rpow_nonneg hscale0 _
  calc
    (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        (normalShifts.card : Real) * (normalShifts.card : Real) * (M : Real) := hmult
    _ ≤ (6 * scale ^ gamma) * (6 * scale ^ gamma) * (M : Real) := hscaled
    _ = 36 * (M : Real) * scale ^ (2 * gamma) := by rw [← hrpow]; ring
    _ ≤ (36 * (M : Real) + 1) * scale ^ (2 * gamma) := by
      apply mul_le_mul_of_nonneg_right
      · linarith
      · exact htarget0

/-- The literal unit-normal overlap theorem closes the conditional plate-overlap transfer. -/
theorem plateOverlap_of_angularSectorGeometry
    (maxLevel : Real → Nat) (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant) :
    plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper := by
  exact plateOverlap_of_translatedUnitNormalPlateOverlap maxLevel angularConstant
    sectorRadius spacingLower spacingUpper hangular
    (translatedUnitNormalPlateOverlap_of_angularSectorGeometry maxLevel angularConstant
      sectorRadius spacingLower spacingUpper)

/-- The finite output-frequency fourth-power quantity attached to the literal
thick conic plate-overlap fibers. -/
noncomputable def finitePlateOverlapSquareEnergy
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) : Real :=
  ∑ Z ∈ outputs,
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n' indices directions k Z,
      ‖F pair.1 z * G pair.2 z‖) ^ 2

/-- The actual finite cube identifiers whose supplied output-frequency label
equals a specified conic pair-sum frequency. -/
noncomputable def plateOverlapCubeOutputFiber {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) : Finset κ := by
  classical
  exact cubes.filter (fun cube => output cube = Z)

theorem mem_plateOverlapCubeOutputFiber_iff {κ : Type*} [DecidableEq κ]
    (cubes : Finset κ) (output : κ → WaveSpaceTime) (Z : WaveSpaceTime) (cube : κ) :
    cube ∈ plateOverlapCubeOutputFiber cubes output Z ↔ cube ∈ cubes ∧ output cube = Z := by
  classical
  simp [plateOverlapCubeOutputFiber]

/-- A finite concrete realization of plate pairs.  The data explicitly give
each cube an angular-pair owner and an output-frequency label, require the
label to lie in that pair's plate sum, and require `(output, owner)` to be
injective on the selected cubes.  Thus each output fiber injects into the
literal plate-overlap fiber.  This is combinatorial only: it does not assert
that the existing half-wave cube packets supply these data. -/
theorem card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    {κ : Type*} [DecidableEq κ]
    (scale gamma angularConstant : Real) (n n' : Int) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs indices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    (plateOverlapCubeOutputFiber cubes output Z).card ≤
      plateOverlapMultiplicity scale gamma angularConstant n n' indices directions k Z := by
  classical
  apply Finset.card_le_card_of_injOn owner
  · intro cube hcube
    have hcube' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    apply (mem_plateOverlapPairs_iff scale gamma angularConstant n n' indices directions k Z
      (owner cube)).mpr
    refine ⟨howner cube hcube'.1, ?_⟩
    simpa only [hcube'.2] using hsum cube hcube'.1
  · intro cube hcube cube' hcube' hownerEq
    have hcubeMem := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube).mp hcube
    have hcubeMem' := (mem_plateOverlapCubeOutputFiber_iff cubes output Z cube').mp hcube'
    exact hinj hcubeMem.1 hcubeMem'.1 (hcubeMem.2.trans hcubeMem'.2.symm) hownerEq

/-- Combining a finite cube-to-pair realization with `plateOverlap` controls
every concrete output fiber by the same geometric scale loss. -/
theorem exists_card_plateOverlapCubeOutputFiber_le_scaled_of_plateOverlap
    {κ : Type*} [DecidableEq κ]
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale)
    (cubes : Finset κ) (owner : κ → Int × Int) (output : κ → WaveSpaceTime)
    (howner : ∀ cube ∈ cubes, owner cube ∈ angularSeparationPairs angularIndices k)
    (hsum : ∀ cube ∈ cubes,
      output cube ∈ minkowskiSum
        (conicPlate scale gamma angularConstant n (directions (owner cube).1))
        (conicPlate scale gamma angularConstant n' (directions (owner cube).2)))
    (hinj : ∀ ⦃cube cube' : κ⦄, cube ∈ cubes → cube' ∈ cubes →
      output cube = output cube' → owner cube = owner cube' → cube = cube')
    (Z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
          Cgamma * scale ^ (overlapExponent * gamma) := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hcard := card_plateOverlapCubeOutputFiber_le_plateOverlapMultiplicity_of_pairRealization
    scale gamma angularConstant n n' angularIndices directions k cubes owner output
    howner hsum hinj Z
  have hcardReal : ((plateOverlapCubeOutputFiber cubes output Z).card : Real) ≤
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) := by
    exact_mod_cast hcard
  exact hcardReal.trans
    (hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z)

/-- The literal thick-plate overlap predicate supplies the expected scaled
finite Cauchy--Schwarz estimate for one output fiber. -/
theorem exists_sq_sum_norm_mul_plateOverlapPairs_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  have hmult :
      (plateOverlapMultiplicity scale gamma angularConstant n n'
        angularIndices directions k Z : Real) ≤
        Cgamma * scale ^ (overlapExponent * gamma) :=
    hbound scale hscale radialIndices angularIndices directions hgeometry
      n hn n' hn' k hk Z
  have henergy : 0 ≤
      ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg _) (sq_nonneg _)
  calc
    (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
        angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (plateOverlapMultiplicity scale gamma angularConstant n n'
          angularIndices directions k Z : Real) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
        scale gamma angularConstant n n' angularIndices directions k Z F G z
    _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- Summing the preceding literal plate-overlap estimate over a finite output
frequency set gives the finite fourth-power overlap-square-function bound. -/
theorem exists_finitePlateOverlapSquareEnergy_le_scaled_of_plateOverlap
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hplate : plateOverlap maxLevel angularConstant sectorRadius spacingLower spacingUpper)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
    (hgeometry : angularSectorGeometry scale angularIndices directions
      sectorRadius spacingLower spacingUpper)
    (n : Int) (hn : n ∈ radialIndices) (n' : Int) (hn' : n' ∈ radialIndices)
    (k : Nat) (hk : k ≤ maxLevel scale) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    ∃ overlapExponent : Real, 0 < overlapExponent ∧
      ∃ Cgamma : Real, 0 < Cgamma ∧
        finitePlateOverlapSquareEnergy scale gamma angularConstant n n'
          angularIndices directions k outputs F G z ≤
          (Cgamma * scale ^ (overlapExponent * gamma)) *
            ∑ Z ∈ outputs,
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  rcases hplate with ⟨_, overlapExponent, hoverlapExponent, hplate⟩
  rcases hplate gamma hgamma hgammaUpper with ⟨Cgamma, hCgamma, hbound⟩
  refine ⟨overlapExponent, hoverlapExponent, Cgamma, hCgamma, ?_⟩
  unfold finitePlateOverlapSquareEnergy
  calc
    (∑ Z ∈ outputs,
      (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
          angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2) ≤
        ∑ Z ∈ outputs, (Cgamma * scale ^ (overlapExponent * gamma)) *
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro Z hZ
      have hmult :
          (plateOverlapMultiplicity scale gamma angularConstant n n'
            angularIndices directions k Z : Real) ≤
            Cgamma * scale ^ (overlapExponent * gamma) :=
        hbound scale hscale radialIndices angularIndices directions hgeometry
          n hn n' hn' k hk Z
      have henergy : 0 ≤
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
              angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
        Finset.sum_nonneg fun pair hpair =>
          mul_nonneg (sq_nonneg _) (sq_nonneg _)
      calc
        (∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
            (plateOverlapMultiplicity scale gamma angularConstant n n'
              angularIndices directions k Z : Real) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          sq_sum_norm_mul_plateOverlapPairs_le_plateOverlapMultiplicity_mul_sum_sq
            scale gamma angularConstant n n' angularIndices directions k Z F G z
        _ ≤ (Cgamma * scale ^ (overlapExponent * gamma)) *
              ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
                angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
          mul_le_mul_of_nonneg_right hmult henergy
    _ = (Cgamma * scale ^ (overlapExponent * gamma)) *
        ∑ Z ∈ outputs,
          ∑ pair ∈ plateOverlapPairs scale gamma angularConstant n n'
            angularIndices directions k Z, ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- The newly proved angular-sector plate-overlap theorem therefore gives a
literal finite overlap-square-function estimate without a cube or continuum
reconstruction claim. -/
theorem exists_finitePlateOverlapSquareEnergy_le_scaled_of_angularSectorGeometry
    (maxLevel : Real → Nat)
    (angularConstant sectorRadius spacingLower spacingUpper : Real)
    (hangular : 0 < angularConstant)
    (gamma : Real) (hgamma : 0 < gamma) (hgammaUpper : gamma < 1 / 10)
    (scale : Real) (hscale : 2 ≤ scale)
    (radialIndices angularIndices : Finset Int) (directions : Int → Euclidean 2)
