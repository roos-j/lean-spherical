/-- Minkowski sum of two subsets of space--time frequency space. -/
def minkowskiSum (A B : Set WaveSpaceTime) : Set WaveSpaceTime :=
  {Z | ∃ z ∈ A, ∃ w ∈ B, z + w = Z}

/-- Membership in a Minkowski sum is its defining two-point decomposition. -/
theorem mem_minkowskiSum_iff (A B : Set WaveSpaceTime) (Z : WaveSpaceTime) :
    Z ∈ minkowskiSum A B ↔ ∃ z ∈ A, ∃ w ∈ B, z + w = Z := Iff.rfl

/-- Minkowski addition of frequency sets is commutative. -/
theorem minkowskiSum_comm (A B : Set WaveSpaceTime) :
    minkowskiSum A B = minkowskiSum B A := by
  ext Z
  constructor
  · rintro ⟨z, hz, w, hw, hzw⟩
    exact ⟨w, hw, z, hz, by simpa [add_comm] using hzw⟩
  · rintro ⟨w, hw, z, hz, hwz⟩
    exact ⟨z, hz, w, hw, by simpa [add_comm] using hwz⟩

/-- A finite set has cardinality at most two if, after choosing any two
