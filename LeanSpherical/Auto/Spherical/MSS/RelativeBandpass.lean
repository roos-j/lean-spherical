            (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (circleRelativeBandFatUnitFamily C t)
    _ ≤ A₀ + A₁ := add_le_add (hmass t) (hibp t)

