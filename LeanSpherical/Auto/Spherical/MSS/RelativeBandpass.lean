    have hhalfDot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ q.1.1 q.2 *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2) :=
      by
        change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
          ((((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1.1 q.2) *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k q.2)
        have hbase : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1.1 q.2) := by
          unfold _root_.Auto.Spherical.MSS.halfWaveMultiplier
          apply Complex.continuous_exp.comp
          exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
        have hcoef : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
            (((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I)) := by
          exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
        exact (hcoef.mul hbase).mul
          ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k).continuous.comp
            continuous_snd)
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (((hrawdot'.mul hfat).mul hhalf').add
      ((hraw'.mul hfat).mul hhalfDot') |>.mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol, hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) : F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp [F, G, circleRelativeBandFatHalfWaveOutput]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) : D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp [D, G', circleRelativeBandFatHalfWaveOutputTimeDerivative]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    let eta : Euclidean 2 := ((2 : Real) ^ j)⁻¹ • xi
    have hq :=
      _root_.Auto.Spherical.Auxiliary.hasDerivAt_smooth_dyadic_bandpass_radial
        C.cutoff 0 t eta
    have hqfat := hq.mul_const
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta)
    have hhalf := _root_.Auto.Spherical.MSS.hasDerivAt_halfWaveMultiplier_time σ t xi
    have hsymbol := hhalf.mul_const
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)
    have hproduct := hqfat.mul hsymbol
    have hfull := hproduct.mul_const (𝓕 (f : Euclidean 2 → Complex) xi)
    have hchar := hfull.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa [G, G', eta, aux_circleRelativeBandUnitDifferenceRaw,
      aux_circleRelativeBandUnitDifferenceRawTimeDerivative,
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol] using hchar
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘ fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2


private theorem aux_circleRelativeBandFatHalfWaveOutput_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (circleAnnularEndpointHalfWaveOutput C σ k t.1 f) x := by
  unfold circleRelativeBandFatHalfWaveOutput
  unfold _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  change aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi *
      𝓕 (f : Euclidean 2 → Complex) xi =
    circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (circleAnnularEndpointHalfWaveOutput C σ k t.1 f : Euclidean 2 → Complex) xi
  rw [circleRelativeBandFatUnitFamily_apply,
    circleAnnularEndpointHalfWaveOutput_fourier]
  simp only [aux_circleRelativeBandUnitDifferenceRaw]
  norm_num
  simp only [smul_smul]
  ring_nf


theorem aux_circleRelativeBandFatUnitFamily_apply_raw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitFamily C t eta =
      aux_circleRelativeBandUnitDifferenceRaw C t.1 eta *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  rw [circleRelativeBandFatUnitFamily_apply]
  have hhalf : (t.1 / 2 : Real) • eta =
      ((2 : Real) ^ (0 + 1))⁻¹ • (t.1 • eta) := by
    norm_num
    simp only [smul_smul]
    congr 1
    ring
  have hone : t.1 • eta = ((2 : Real) ^ 0)⁻¹ • (t.1 • eta) := by norm_num
  have hdiff : C.cutoff ((t.1 / 2) • eta) - C.cutoff (t.1 • eta) =
      aux_circleRelativeBandUnitDifferenceRaw C t.1 eta := by
    unfold aux_circleRelativeBandUnitDifferenceRaw
    congr 1
    · exact congrArg C.cutoff hhalf
    · exact congrArg C.cutoff hone
  rw [hdiff]

theorem aux_circleRelativeBandFatUnitTimeDerivative_apply_raw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : CircleRelativeBandLocalTime) (eta : Euclidean 2) :
    circleRelativeBandFatUnitTimeDerivative C t eta =
      aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1 eta *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff eta := by
  rw [circleRelativeBandFatUnitTimeDerivative_apply]
  rfl

/-- The literal derivative of the moving-fat multiplier applied to a fixed
dyadic half-wave is exactly the sum of the `qdot` multiplier term and one
`2^k`-sized half-wave applied to the compact derivative input. -/
private theorem aux_circleRelativeBandFatHalfWaveOutputTimeDerivative_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (circleAnnularEndpointHalfWaveOutput C σ k t.1 f) x +
      (((2 : Real) ^ k : Real) : Complex) *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
          (circleAnnularEndpointHalfWaveOutput C σ k t.1
            (circleEndpointTimeDerivativeInput C σ k f)) x := by
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  let U : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1 f
  let V : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1
      (circleEndpointTimeDerivativeInput C σ k f)
  let q₁ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) :
          Euclidean 2 → Complex)
      (𝓕 U)
  let q₂ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) :
          Euclidean 2 → Complex)
      (𝓕 V)
  have hq₁apply (xi : Euclidean 2) : q₁ xi =
      circleRelativeBandFatUnitTimeDerivative C t (((2 : Real) ^ j)⁻¹ • xi) *
        𝓕 (U : Euclidean 2 → Complex) xi := by
    dsimp [q₁]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol_apply]
    change circleRelativeBandFatUnitTimeDerivative C t (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (U : Euclidean 2 → Complex) xi = _
    rfl
  have hq₂apply (xi : Euclidean 2) : q₂ xi =
      circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) *
        𝓕 (V : Euclidean 2 → Complex) xi := by
    dsimp [q₂]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol_apply]
    change circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (V : Euclidean 2 → Complex) xi = _
    rfl
  have hq₁inv :
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t)
          (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U x =
        𝓕⁻ (q₁ : Euclidean 2 → Complex) x := by
    rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
    funext xi
    exact (hq₁apply xi).symm
  have hq₂inv :
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) V x =
        𝓕⁻ (q₂ : Euclidean 2 → Complex) x := by
    rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
    funext xi
    exact (hq₂apply xi).symm
  have hsum := aux_fourierInv_add_of_integrable
    (q₁ : Euclidean 2 → Complex) (fun xi : Euclidean 2 => d * q₂ xi)
    q₁.integrable (q₂.integrable.const_mul d) x
  have hpoint (xi : Euclidean 2) :
      q₁ xi + d * q₂ xi =
        (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
            (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi +
        aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          (_root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t.1 xi *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)) *
          𝓕 (f : Euclidean 2 → Complex) xi := by
    rw [hq₁apply, hq₂apply,
      aux_circleRelativeBandFatUnitTimeDerivative_apply_raw,
      aux_circleRelativeBandFatUnitFamily_apply_raw,
      circleAnnularEndpointHalfWaveOutput_fourier,
      circleAnnularEndpointHalfWaveOutput_fourier,
      circleEndpointTimeDerivativeInput_fourier]
    dsimp [U, V, d]
    have hinput :=
      dyadicHalfWaveSymbol_mul_circleEndpointTimeDerivativeInputMultiplier C σ k t.1 xi
    calc
      _ =
          (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
              (((2 : Real) ^ j)⁻¹ • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              (((2 : Real) ^ j)⁻¹ • xi) *
            _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi +
          aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              (((2 : Real) ^ j)⁻¹ • xi) *
            ((((2 : Real) ^ k : Real) : Complex) *
              (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi *
                circleEndpointTimeDerivativeInputMultiplier C σ k xi))) *
            𝓕 (f : Euclidean 2 → Complex) xi := by ring
      _ = _ := by rw [hinput]
  calc
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x =
        𝓕⁻ (fun xi : Euclidean 2 => q₁ xi + d * q₂ xi) x := by
      unfold circleRelativeBandFatHalfWaveOutputTimeDerivative
      apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
      funext xi
      exact (hpoint xi).symm
    _ = 𝓕⁻ (q₁ : Euclidean 2 → Complex) x +
        𝓕⁻ (fun xi : Euclidean 2 => d * q₂ xi) x := hsum
    _ = 𝓕⁻ (q₁ : Euclidean 2 → Complex) x +
        d * 𝓕⁻ (q₂ : Euclidean 2 → Complex) x := by
      rw [← aux_const_mul_fourierInv]
    _ = _ := by
      rw [← hq₁inv, ← hq₂inv]

/-- A uniform compact relative-kernel certificate gives a uniform fixed-time
`L⁴` bound for every literal scale of the family. -/
theorem aux_exists_integral_norm_pow_four_relativeMultiplierAt_le_of_uniformKernel
    {ι : Type*} (φ : ι → SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hA : 0 ≤ A)
    (hkernel : ∀ u : ι,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (φ u) ≤ A) :
    ∃ B : Real, 0 < B ∧ ∀ (u : ι)
      (r : Ioi (0 : Real)) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (φ u) r f x‖ ^ 4) ≤ B * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  obtain ⟨K, hK, hstability⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      φ hA hkernel
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  refine ⟨K ^ (4 : Nat) * H, mul_pos (pow_pos hK 4) hH, ?_⟩
  intro u r f
  let E : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt (φ u) r f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (f : Euclidean 2 → Complex)
  have hM := hhardy f
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E :=
    _root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (φ u) f r
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤ K ^ (4 : Nat) * M x ^ 4 := by
    have h := hstability u f r x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 4 ≤ (K * M x) ^ 4 := pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = K ^ (4 : Nat) * M x ^ 4 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 => K ^ (4 : Nat) * M x ^ 4) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 4) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  change (∫ x : Euclidean 2, ‖E x‖ ^ 4) ≤
    (K ^ (4 : Nat) * H) * ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hfirst : (∫ x : Euclidean 2, ‖E x‖ ^ 4) ≤
      ∫ x : Euclidean 2, K ^ (4 : Nat) * M x ^ 4 :=
    integral_mono hEpowInt hdomInt hpoint
  have hsecond : (∫ x : Euclidean 2, K ^ (4 : Nat) * M x ^ 4) =
      K ^ (4 : Nat) * ∫ x : Euclidean 2, M x ^ 4 := by
    rw [integral_const_mul]
  have hhardyfour : (∫ x : Euclidean 2, M x ^ 4) ≤
      H * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
    convert hM.2 using 1
    · apply integral_congr_ae
      filter_upwards with x
      change M x ^ (4 : Nat) = M x ^ (4 : Real)
      exact (Real.rpow_natCast (M x) 4).symm
    · congr 1
      apply integral_congr_ae
      filter_upwards with x
      exact (Real.rpow_natCast ‖f x‖ 4).symm
  have hthird : K ^ (4 : Nat) * ∫ x : Euclidean 2, M x ^ 4 ≤
      K ^ (4 : Nat) * (H * ∫ x : Euclidean 2, ‖f x‖ ^ 4) :=
    mul_le_mul_of_nonneg_left hhardyfour (by positivity)
  have hfourth : K ^ (4 : Nat) * (H * ∫ x : Euclidean 2, ‖f x‖ ^ 4) ≤
      (K ^ (4 : Nat) * H) * ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
    simpa only [mul_assoc] using
      (le_refl (K ^ (4 : Nat) * (H * ∫ x : Euclidean 2, ‖f x‖ ^ 4)))
  exact hfirst.trans (hsecond.le.trans (hthird.trans hfourth))

private theorem aux_integrable_norm_pow_four_relativeMultiplierAt_of_uniformKernel
    {ι : Type*} (φ : ι → SchwartzMap (Euclidean 2) Complex)
    {A : Real} (hA : 0 ≤ A)
    (hkernel : ∀ u : ι,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (φ u) ≤ A)
    (u : ι) (r : Ioi (0 : Real)) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (φ u) r f x‖ ^ 4) volume := by
  obtain ⟨K, hK, hstability⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      φ hA hkernel
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  let E : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt (φ u) r f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (f : Euclidean 2 → Complex)
  have hM := hhardy f
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E :=
    _root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (φ u) f r
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤ K ^ (4 : Nat) * M x ^ 4 := by
    have h := hstability u f r x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 4 ≤ (K * M x) ^ 4 := pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = K ^ (4 : Nat) * M x ^ 4 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 => K ^ (4 : Nat) * M x ^ 4) :=
    hMpowInt.const_mul _
  refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
  filter_upwards with x
  change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
  exact hpoint x

