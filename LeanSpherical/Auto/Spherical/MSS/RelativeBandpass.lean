    normalizedCircleSourceIntegerLatticePoint_injective zO hzO (fun _ => q)
    sigma rho hrho nu hnu I inputs outputs M hM (fun j hj => le_rfl) hband hcenter h hh f
  have hQ : MemLp Q 2 volume :=
