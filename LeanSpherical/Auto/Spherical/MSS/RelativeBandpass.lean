private theorem exists_uniform_norm_iteratedFDeriv_radialComp_of_uniform_iteratedDeriv_le
    (R : Nat → Real → Real → Complex)
    (hRcont : ∀ j t, ContDiff Real (⊤ : ℕ∞) (R j t))
    (hRderiv : ∀ k : Nat, ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
      ‖iteratedDeriv k (R j t) rho‖ ≤ A)
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖eta‖ → ‖eta‖ ≤ 16 →
      ‖iteratedFDeriv Real n (fun y : Euclidean 2 => R j t ‖y‖) eta‖ ≤ C := by
  choose A hApos hAbound using hRderiv
  choose D hDpos hDbound using fun i : Nat =>
    Auto.MikhlinHormander.exists_norm_iteratedFDeriv_norm_bound_on_annulus
      (d := 2) (r := 1 / 4) (R := 16) i (by norm_num : (0 : Real) < 1 / 4)
  let CA : Real := ∑ i ∈ Finset.range (n + 1), A i
  let CD : Real := (∑ i ∈ Finset.range (n + 1), D i) + 1
  have hCApos : 0 < CA := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun i hi => (hApos i).le) hmem
    exact lt_of_lt_of_le (hApos 0) hle
  have hCDone : 1 ≤ CD := by
    dsimp [CD]
    have hsum : 0 ≤ ∑ i ∈ Finset.range (n + 1), D i :=
      Finset.sum_nonneg fun i hi => (hDpos i).le
    linarith
  refine ⟨((Nat.factorial n : Nat) : Real) * CA * CD ^ n, by positivity, ?_⟩
  intro j t eta ht hetainner etaouter
  let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
  have hsopen : IsOpen s := by
    simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hetane : eta ≠ 0 := by
    intro hzero
    subst eta
    norm_num at hetainner
  have hetas : eta ∈ s := by simpa [s] using hetane
  let g : Real → Complex := R j t
  let f : Euclidean 2 → Real := fun y => ‖y‖
  have hg : ContDiff Real n g := by
    dsimp [g]
    exact (hRcont j t).of_le
      (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
        exact WithTop.coe_le_coe.mpr le_top)
  have hf : ContDiffOn Real n f s := by
    intro x hx
    exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
  have hgfAt : ContDiffAt Real n (g ∘ f) eta :=
    hg.contDiffAt.comp eta (contDiffAt_norm Real hetane)
  have hC : ∀ i, i ≤ n → ‖iteratedFDerivWithin Real i g Set.univ (f eta)‖ ≤ CA := by
    intro i hi
    rw [iteratedFDerivWithin_univ]
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hbase := hAbound i j t (f eta) ht (by simpa [f] using hetainner)
      (by simpa [f] using etaouter)
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A i ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun l hl => (hApos l).le) hmem
    exact hbase.trans hle
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin Real i f s eta‖ ≤ CD ^ i := by
    intro i hi1 hi
    have hfeq : iteratedFDerivWithin Real i f s eta = iteratedFDeriv Real i f eta :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique
        ((contDiffAt_norm Real hetane).of_le
          (show (i : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)) hetas
    rw [hfeq]
    have hbase := hDbound i eta hetainner etaouter
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : D i ≤ CD := by
      dsimp [CD]
      calc
        D i ≤ ∑ l ∈ Finset.range (n + 1), D l :=
          Finset.single_le_sum (fun l hl => (hDpos l).le) hmem
        _ ≤ (∑ l ∈ Finset.range (n + 1), D l) + 1 := by linarith
    have hpow : CD ≤ CD ^ i := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi1)
      rw [pow_succ]
      calc
        CD = 1 * CD := (one_mul _).symm
        _ ≤ CD ^ m * CD :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ hCDone) (le_trans (by norm_num) hCDone)
    exact hbase.trans (hle.trans hpow)
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (g := g) (f := f) (s := s) (t := Set.univ)
    hg.contDiffOn hf (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    uniqueDiffOn_univ hsunique (by simp) hetas hC hD
  have hEq : iteratedFDerivWithin Real n (g ∘ f) s eta =
      iteratedFDeriv Real n (g ∘ f) eta :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique hgfAt hetas
  change ‖iteratedFDeriv Real n (g ∘ f) eta‖ ≤ _
  rw [← hEq]
  exact hcomp

theorem exists_uniform_norm_iteratedFDeriv_middleRapidNormalizedScaledRadialComp_le
    (r n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖eta‖ → ‖eta‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 => middleRapidNormalizedScaledRadialAmplitude r j t ‖y‖) eta‖ ≤ C := by
  apply exists_uniform_norm_iteratedFDeriv_radialComp_of_uniform_iteratedDeriv_le
    (middleRapidNormalizedScaledRadialAmplitude r)
  · intro j t
    exact contDiff_middleRapidNormalizedScaledRadialAmplitude r j t
  · intro k
    exact exists_uniform_norm_iteratedDeriv_middleRapidNormalizedScaledRadialAmplitude_le r k

theorem exists_uniform_norm_iteratedFDeriv_middleRapidNormalizedScaledRadialTimeDerivativeComp_le
    (r n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖eta‖ → ‖eta‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 =>
          middleRapidNormalizedScaledRadialAmplitudeTimeDerivative r j t ‖y‖) eta‖ ≤ C := by
  apply exists_uniform_norm_iteratedFDeriv_radialComp_of_uniform_iteratedDeriv_le
    (middleRapidNormalizedScaledRadialAmplitudeTimeDerivative r)
  · intro j t
    exact contDiff_middleRapidNormalizedScaledRadialAmplitudeTimeDerivative r j t
  · intro k
    exact
      exists_uniform_norm_iteratedDeriv_middleRapidNormalizedScaledRadialAmplitudeTimeDerivative_le r
        k

noncomputable def fixedDyadicFatBandpass
    (C : Auto.LittlewoodPaley.lpCutoffs 2) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fatDyadicBandpassPrototype C.cutoff)
    (Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0)

theorem fixedDyadicFatBandpass_apply
    (C : Auto.LittlewoodPaley.lpCutoffs 2) (eta : Euclidean 2) :
    fixedDyadicFatBandpass C eta =
      fatDyadicBandpassPrototype C.cutoff eta *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0 eta := by
  unfold fixedDyadicFatBandpass
  rw [SchwartzMap.smulLeftCLM_apply
    (fatDyadicBandpassPrototype C.cutoff).hasTemperateGrowth]
  rfl

noncomputable def directMiddleRapidSymbolFun
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex := fun eta =>
  ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
    (middleRapidNormalizedScaledRadialAmplitude r j t ‖eta‖ *
      fixedDyadicFatBandpass C eta)

private theorem directMiddleRapidSymbolFun_eventuallyEq_zero_at_zero
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    directMiddleRapidSymbolFun r C j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (by norm_num : (0 : Real) < 1)]
    with eta heta
  have hetaNorm : ‖eta‖ ≤ (2 : Real) ^ (0 : Nat) := by
    have hlt : ‖eta‖ < 1 := by
      simpa only [Metric.mem_ball, dist_zero_right] using heta
    norm_num
    exact hlt.le
  unfold directMiddleRapidSymbolFun
  rw [show fixedDyadicFatBandpass C eta =
      fatDyadicBandpassPrototype C.cutoff eta *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0 eta by
      exact fixedDyadicFatBandpass_apply C eta]
  simp [Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C hetaNorm]

theorem contDiff_directMiddleRapidSymbolFun
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (directMiddleRapidSymbolFun r C j t) := by
  rw [contDiff_iff_contDiffAt]
  intro eta
  by_cases heta : eta = 0
  · subst eta
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (directMiddleRapidSymbolFun_eventuallyEq_zero_at_zero r C j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun y : Euclidean 2 => ‖y‖) eta :=
      contDiffAt_norm Real heta
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun y : Euclidean 2 =>
        middleRapidNormalizedScaledRadialAmplitude r j t ‖y‖) eta :=
      (contDiff_middleRapidNormalizedScaledRadialAmplitude r j t).contDiffAt.comp eta hnorm
    have hq : ContDiffAt Real (⊤ : ℕ∞)
        (fixedDyadicFatBandpass C : Euclidean 2 → Complex) eta :=
