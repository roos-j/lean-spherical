    have hraw := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw C
    have hrawdot := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRawTimeDerivative C
    have hmiddle := aux_continuous_uncurry_circleMiddleBandpassMultiplier C k
    have hmiddledot := aux_continuous_uncurry_circleMiddleBandpassMultiplierTimeDerivative C k
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
