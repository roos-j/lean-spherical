    (beta : SchwartzMap Real Complex)
    (N : Nat) (hdim : Module.finrank Real JointWaveSpaceTime < N) (hN : 2 < N)
    (R A D : Real) (hR : 1 ≤ R) (hA : 0 ≤ A) (hD : 0 ≤ D) :
