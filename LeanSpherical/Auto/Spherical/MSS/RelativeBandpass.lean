/-- Fixed-time `L⁴` stability of the literal moving-fat multiplier applied
to any dyadic half-wave, uniformly in both the relative and half-wave scales. -/
private theorem aux_exists_integral_norm_pow_four_circleRelativeBandFatHalfWaveOutput_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (t : CircleRelativeBandLocalTime) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖ ^ 4) ≤
        B * ∫ x : Euclidean 2,
          ‖circleAnnularEndpointHalfWaveOutput C σ k t.1 f x‖ ^ 4 := by
  rcases aux_exists_integral_norm_pow_four_circleRelativeBandFatUnitFamily_le C with
    ⟨B, hB, hbound⟩
  refine ⟨B, hB, ?_⟩
  intro j k σ t f
  rw [show (∫ x : Euclidean 2,
      ‖circleRelativeBandFatHalfWaveOutput C j k σ t.1 f x‖ ^ 4) =
        ∫ x : Euclidean 2,
          ‖_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
            (circleRelativeBandFatUnitFamily C t)
            (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
            (circleAnnularEndpointHalfWaveOutput C σ k t.1 f) x‖ ^ 4 by
      apply integral_congr_ae
      filter_upwards with x
      rw [aux_circleRelativeBandFatHalfWaveOutput_eq_relativeMultiplierAt]]
  exact hbound t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
    (circleAnnularEndpointHalfWaveOutput C σ k t.1 f)


private theorem aux_norm_circleEndpointDyadicNormalization_eq_dyadicTimeScale_neg_half
    (j : Nat) :
    ‖circleEndpointDyadicNormalization j‖ =
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-(1 / 2 : Real)) := by
  let R : Real := (2 : Real) ^ j
  have hδ : _root_.Auto.Spherical.MSS.dyadicTimeScale j = R⁻¹ := by
    simp [R, _root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg]
  rw [norm_circleEndpointDyadicNormalization, Real.sqrt_eq_rpow, hδ,
    ← Real.rpow_neg_eq_inv_rpow]
  congr 1
  ring


private theorem aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutput_prod_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j k : Nat) (hk : 1 ≤ k)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖circleRelativeBandFatHalfWaveOutput C j k σ p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  obtain ⟨B, hB, hfixed⟩ :=
    aux_exists_integral_norm_pow_four_circleRelativeBandFatHalfWaveOutput_le C
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutput C j k σ t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
    C j k σ f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hFspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F t.1 x‖ ^ 4) volume := by
    intro t
    have h := aux_integrable_norm_pow_four_circleRelativeBandFatUnitFamily C t
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
      (circleAnnularEndpointHalfWaveOutput C σ k t.1 f)
    refine h.congr ?_
    filter_upwards with x
    rw [← aux_circleRelativeBandFatHalfWaveOutput_eq_relativeMultiplierAt C j k σ t f x]
  have hbound : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F t.1 x‖ ^ 4) ≤
        B * ∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4 := by
    intro t
    simpa only [F, U] using hfixed j k σ t f
  simpa only [F] using
    aux_integrable_norm_pow_four_prod_of_continuous_of_spatial_bound
      (F := F) (U := U) hFcont hUprod hFspatial hbound

private theorem aux_exists_ivlInteg_integral_norm_pow_four_circRelBandFatHalfWaveOut_le_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j k : Nat), 1 ≤ k →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4) ≤
          A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  obtain ⟨B, hB, hfixed⟩ :=
    aux_exists_integral_norm_pow_four_circleRelativeBandFatHalfWaveOutput_le C
  obtain ⟨L, hL, hUbound⟩ :=
    exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain C hgain
  refine ⟨B * L ^ (4 : Nat), mul_pos hB (pow_pos hL _), ?_⟩
  intro j k hk σ f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutput C j k σ t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    simpa only [ν, F] using
      aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutput_prod_of_gain
        C hgain j k hk σ f
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hFouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ν :=
    hFprod.integral_prod_left
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ν :=
    hUprod.integral_prod_left
  have hFinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hFouter
  have hUinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hUouter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        B * ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
    let ts : Icc (1 : Real) 2 := ⟨t, ht⟩
    simpa only [F, U] using hfixed j k σ ts f
  have hFtoU :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        B * ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
          ∫ t in (1 : Real)..2,
            B * ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
              exact intervalIntegral.integral_mono_on (by norm_num) hFinterval
                (hUinterval.const_mul _) hpoint
      _ = B * ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4 := by
            rw [intervalIntegral.integral_const_mul]
  have hUenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ≤
        L ^ (4 : Nat) * (2 : Real) ^ ((k : Real) * (1 - 4 * ρ)) * E := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) =
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k t f x‖ ^ 4 := by
              apply intervalIntegral.integral_congr_ae
              filter_upwards with t ht
              apply integral_congr_ae
              filter_upwards with x
              change ‖circleAnnularEndpointHalfWaveOutput C σ k t f x‖ ^ 4 = _
              rw [circleAnnularEndpointHalfWaveOutput_apply]
      _ ≤ _ := by simpa only [E] using hUbound k hk σ f
  have hcore := hFtoU.trans
    (mul_le_mul_of_nonneg_left hUenergy (by positivity : 0 ≤ B))
  change (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
      ‖F t x‖ ^ 4) ≤
    (B * L ^ (4 : Nat)) * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^
      (-1 + 4 * ρ) * E
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        B * (L ^ (4 : Nat) * (2 : Real) ^ ((k : Real) * (1 - 4 * ρ)) * E) := hcore
    _ = (B * L ^ (4 : Nat)) * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^
          (-1 + 4 * ρ) * E := by
      rw [aux_dyadicFrequencyPower_eq_dyadicTimeScale]
      ring


private theorem aux_exists_integral_norm_pow_four_circleRelBandFatHalfWaveOutputTimeDeriv_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B B' : Real, 0 < B ∧ 0 < B' ∧ ∀ (j k : Nat)
      (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (t : CircleRelativeBandLocalTime) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) ≤
        8 * (B' * (∫ x : Euclidean 2,
            ‖circleAnnularEndpointHalfWaveOutput C σ k t.1 f x‖ ^ 4) +
          ‖(((2 : Real) ^ k : Real) : Complex)‖ ^ 4 * B *
            (∫ x : Euclidean 2,
              ‖circleAnnularEndpointHalfWaveOutput C σ k t.1
                (circleEndpointTimeDerivativeInput C σ k f) x‖ ^ 4)) := by
  rcases aux_exists_integral_norm_pow_four_circleRelativeBandFatUnitFamily_le C with
    ⟨B, hB, hq⟩
  rcases aux_exists_integral_norm_pow_four_circleRelativeBandFatUnitTimeDerivative_le C with
    ⟨B', hB', hqdot⟩
  refine ⟨B, B', hB, hB', ?_⟩
  intro j k σ t f
  let U : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1 f
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ k f
  let UP : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1 P
  let A : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U
  let Q : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) UP
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  let R : Euclidean 2 → Complex := fun x =>
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x
  have hA : Integrable (fun x : Euclidean 2 => ‖A x‖ ^ 4) volume := by
    simpa only [A] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitTimeDerivative C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U
  have hQ : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ 4) volume := by
    simpa only [Q] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitFamily C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) UP
  have hdQ : Integrable (fun x : Euclidean 2 => ‖d * Q x‖ ^ 4) volume := by
    have h := hQ.const_mul (‖d‖ ^ (4 : Nat))
    refine h.congr ?_
    filter_upwards with x
    rw [norm_mul, mul_pow]
  have hright : Integrable (fun x : Euclidean 2 =>
      8 * (‖A x‖ ^ 4 + ‖d * Q x‖ ^ 4)) volume :=
    (hA.add hdQ).const_mul 8
  have hRcont : Continuous R := by
    have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
      C j k σ f
    simpa only [R, Function.uncurry_apply_pair] using
      (hjoint.2.1.curry_right (x := t.1))
  have hpoint (x : Euclidean 2) : ‖R x‖ ^ 4 ≤
      8 * (‖A x‖ ^ 4 + ‖d * Q x‖ ^ 4) := by
    rw [show R x = A x + d * Q x by
      dsimp [R, A, Q, d, U, P, UP]
      exact aux_circleRelativeBandFatHalfWaveOutputTimeDerivative_eq_relativeMultiplierAt
        C j k σ t f x]
    exact aux_norm_add_pow_four_le _ _
  have hR : Integrable (fun x : Euclidean 2 => ‖R x‖ ^ 4) volume := by
    refine Integrable.mono' hright (hRcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖R x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  have hfixedA := hqdot t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U
  have hfixedQ := hq t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) UP
  calc
    (∫ x : Euclidean 2,
        ‖circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) =
        ∫ x : Euclidean 2, ‖R x‖ ^ 4 := rfl
    _ ≤ ∫ x : Euclidean 2, 8 * (‖A x‖ ^ 4 + ‖d * Q x‖ ^ 4) :=
      integral_mono hR hright hpoint
    _ = 8 * (∫ x : Euclidean 2, ‖A x‖ ^ 4) +
        8 * (∫ x : Euclidean 2, ‖d * Q x‖ ^ 4) := by
      rw [MeasureTheory.integral_const_mul,
        MeasureTheory.integral_add hA hdQ]
      ring
    _ = 8 * (∫ x : Euclidean 2, ‖A x‖ ^ 4) +
        8 * (‖d‖ ^ 4 * ∫ x : Euclidean 2, ‖Q x‖ ^ 4) := by
      congr 2
      calc
        (∫ x : Euclidean 2, ‖d * Q x‖ ^ 4) =
            ∫ x : Euclidean 2, ‖d‖ ^ 4 * ‖Q x‖ ^ 4 := by
              apply integral_congr_ae
              filter_upwards with x
              rw [norm_mul, mul_pow]
        _ = ‖d‖ ^ 4 * ∫ x : Euclidean 2, ‖Q x‖ ^ 4 := by
              rw [MeasureTheory.integral_const_mul]
    _ ≤ 8 * (B' * ∫ x : Euclidean 2, ‖U x‖ ^ 4) +
        8 * (‖d‖ ^ 4 * (B * ∫ x : Euclidean 2, ‖UP x‖ ^ 4)) := by
      apply add_le_add
      · exact mul_le_mul_of_nonneg_left hfixedA (by norm_num)
      · exact mul_le_mul_of_nonneg_left
          (mul_le_mul_of_nonneg_left hfixedQ (pow_nonneg (norm_nonneg _) _))
          (by norm_num)
    _ = 8 * (B' * (∫ x : Euclidean 2,
        ‖circleAnnularEndpointHalfWaveOutput C σ k t.1 f x‖ ^ 4) +
        ‖(((2 : Real) ^ k : Real) : Complex)‖ ^ 4 * B *
          (∫ x : Euclidean 2,
            ‖circleAnnularEndpointHalfWaveOutput C σ k t.1
              (circleEndpointTimeDerivativeInput C σ k f) x‖ ^ 4)) := by
      dsimp [U, P, UP, d]
      ring


private theorem aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutputTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : CircleRelativeBandLocalTime) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) volume := by
  let U : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1 f
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ k f
  let UP : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t.1 P
  let A : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U
  let Q : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) UP
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  let R : Euclidean 2 → Complex := fun x =>
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t.1 f x
  have hA : Integrable (fun x : Euclidean 2 => ‖A x‖ ^ 4) volume := by
    simpa only [A] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitTimeDerivative C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) U
  have hQ : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ 4) volume := by
    simpa only [Q] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitFamily C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) UP
  have hdQ : Integrable (fun x : Euclidean 2 => ‖d * Q x‖ ^ 4) volume := by
    have h := hQ.const_mul (‖d‖ ^ (4 : Nat))
    refine h.congr ?_
    filter_upwards with x
    rw [norm_mul, mul_pow]
  have hright : Integrable (fun x : Euclidean 2 =>
      8 * (‖A x‖ ^ 4 + ‖d * Q x‖ ^ 4)) volume :=
    (hA.add hdQ).const_mul 8
  have hRcont : Continuous R := by
    have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
      C j k σ f
    simpa only [R, Function.uncurry_apply_pair] using
      (hjoint.2.1.curry_right (x := t.1))
  have hpoint (x : Euclidean 2) : ‖R x‖ ^ 4 ≤
      8 * (‖A x‖ ^ 4 + ‖d * Q x‖ ^ 4) := by
    rw [show R x = A x + d * Q x by
      dsimp [R, A, Q, d, U, P, UP]
      exact aux_circleRelativeBandFatHalfWaveOutputTimeDerivative_eq_relativeMultiplierAt
        C j k σ t f x]
    exact aux_norm_add_pow_four_le _ _
  refine Integrable.mono' hright (hRcont.norm.pow 4).aestronglyMeasurable ?_
  filter_upwards with x
  change ‖‖R x‖ ^ (4 : Nat)‖ ≤ _
  rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
  exact hpoint x

private theorem aux_integrable_norm_pow_four_circRelBandFatHalfWaveOutTimeDeriv_prod_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j k : Nat) (hk : 1 ≤ k)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  obtain ⟨B, B', hB, hB', hfixed⟩ :=
    aux_exists_integral_norm_pow_four_circleRelBandFatHalfWaveOutputTimeDeriv_le C
  let F' : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t f x
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ k f
  let UP : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t P x
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatHalfWaveOutput
    C j k σ f
  have hF'cont : Continuous (Function.uncurry F') := by
    simpa only [F'] using hjoint.2.1
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hUPprod : Integrable (fun p : Real × Euclidean 2 => ‖UP p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ P
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 P p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 P p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      (volume.restrict (Icc (1 : Real) 2)) := hUprod.integral_prod_left
  have hUPouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖UP t x‖ ^ 4)
      (volume.restrict (Icc (1 : Real) 2)) := hUPprod.integral_prod_left
  let g : Real → Real :=
    (fun t => (8 * B') * (∫ x : Euclidean 2, ‖U t x‖ ^ 4)) +
      (fun t => (8 * ‖d‖ ^ (4 : Nat) * B) * (∫ x : Euclidean 2, ‖UP t x‖ ^ 4))
  have hg : Integrable g (volume.restrict (Icc (1 : Real) 2)) := by
    simpa only [g, Pi.add_apply] using
      (hUouter.const_mul (8 * B')).add
        (hUPouter.const_mul (8 * ‖d‖ ^ (4 : Nat) * B))
  have hF'spatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F' t.1 x‖ ^ 4) volume := by
    intro t
    simpa only [F'] using
      aux_integrable_norm_pow_four_circleRelativeBandFatHalfWaveOutputTimeDerivative
        C j k σ t f
  have hbound : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F' t.1 x‖ ^ 4) ≤ g t.1 := by
    intro t
    have h := hfixed j k σ t f
    calc
      (∫ x : Euclidean 2, ‖F' t.1 x‖ ^ 4) ≤
          8 * (B' * (∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4) +
            ‖d‖ ^ 4 * B *
              (∫ x : Euclidean 2, ‖UP t.1 x‖ ^ 4)) := by
            simpa only [F', U, P, UP, d] using h
      _ = g t.1 := by
            simp only [g, Pi.add_apply]
            ring
  simpa only [F'] using
    integrable_norm_pow_four_prod_of_continuous_of_interval_integral_bound
      (F := F') hF'cont hF'spatial hg hbound

private theorem aux_exists_ivlInteg_integral_norm_pow_four_normd_circRelBdFatHalfWvOut_le_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j k : Nat), 1 ≤ k →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖(circleEndpointDyadicNormalization k)⁻¹ *
          circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4) ≤
          A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  obtain ⟨A, hA, hraw⟩ :=
    aux_exists_ivlInteg_integral_norm_pow_four_circRelBandFatHalfWaveOut_le_gain
      C hgain
  refine ⟨A, hA, ?_⟩
  intro j k hk σ f
  let n : Complex := (circleEndpointDyadicNormalization k)⁻¹
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutput C j k σ t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hraw' :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) * E := by
    simpa only [F, E] using hraw j k hk σ f
  have hδ : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale k := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hpow :
      (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (2 : Real) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) =
        (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) := by
    rw [← Real.rpow_add hδ]
    congr 1
    ring
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖(circleEndpointDyadicNormalization k)⁻¹ *
          circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4) =
        ‖n‖ ^ 4 * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) := by
          dsimp [n, F]
          rw [← intervalIntegral.integral_const_mul]
          apply intervalIntegral.integral_congr_ae
          filter_upwards with t ht
          calc
            (∫ x : Euclidean 2,
                ‖(circleEndpointDyadicNormalization k)⁻¹ *
                  circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4) =
                ∫ x : Euclidean 2,
                  ‖(circleEndpointDyadicNormalization k)⁻¹‖ ^ 4 *
                    ‖circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4 := by
                      apply integral_congr_ae
                      filter_upwards with x
                      rw [norm_mul, mul_pow]
            _ = ‖(circleEndpointDyadicNormalization k)⁻¹‖ ^ 4 *
                ∫ x : Euclidean 2,
                  ‖circleRelativeBandFatHalfWaveOutput C j k σ t f x‖ ^ 4 := by
                    rw [MeasureTheory.integral_const_mul]
    _ ≤ ‖n‖ ^ 4 *
          (A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) * E) :=
      mul_le_mul_of_nonneg_left hraw' (pow_nonneg (norm_nonneg _) _)
    _ = A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) * E := by
      dsimp [n]
      rw [aux_norm_inv_circleEndpointDyadicNormalization_pow_four]
      calc
        (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (2 : Nat) *
            (A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) * E) =
            A * ((_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (2 : Real) *
              (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ)) * E := by
              norm_num [Real.rpow_natCast]
              ring
        _ = _ := by rw [hpow]


private theorem aux_exists_ivlInteg_integral_norm_pow_four_normd_circRelBdFtHfWvOutTmDeriv_le_gn
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j k : Nat), 1 ≤ k →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖(circleEndpointDyadicNormalization k)⁻¹ *
          circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x‖ ^ 4) ≤
          A * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-3 + 4 * ρ) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  obtain ⟨B, B', hB, hB', hfixed⟩ :=
    aux_exists_integral_norm_pow_four_circleRelBandFatHalfWaveOutputTimeDeriv_le C
  obtain ⟨L, hL, hUbound⟩ :=
    exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain C hgain
  obtain ⟨M, hM, hPbound⟩ :=
    exists_integral_norm_pow_four_circleEndpointTimeDerivativeInput_le C
  refine ⟨8 * L ^ (4 : Nat) * (B' + B * M), by positivity, ?_⟩
  intro j k hk σ f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F' : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatHalfWaveOutputTimeDerivative C j k σ t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t f x
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ k f
  let UP : Real → Euclidean 2 → Complex := fun t x =>
    circleAnnularEndpointHalfWaveOutput C σ k t P x
  let n : Complex := (circleEndpointDyadicNormalization k)⁻¹
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hF'prod : Integrable (fun p : Real × Euclidean 2 => ‖F' p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    simpa only [ν, F'] using
      aux_integrable_norm_pow_four_circRelBandFatHalfWaveOutTimeDeriv_prod_of_gain
        C hgain j k hk σ f
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ f
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 f p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 f p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hUPprod : Integrable (fun p : Real × Euclidean 2 => ‖UP p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    have h := aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain C hgain k hk σ P
    refine h.congr ?_
    filter_upwards with p
    change ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k p.1 P p.2‖ ^ 4 =
      ‖circleAnnularEndpointHalfWaveOutput C σ k p.1 P p.2‖ ^ 4
    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hF'outer : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ν :=
    hF'prod.integral_prod_left
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ν :=
    hUprod.integral_prod_left
  have hUPouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) ν :=
    hUPprod.integral_prod_left
  have hF'interval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F' t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hF'outer
  have hUinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hUouter
  have hUPinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖UP t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hUPouter
  let g : Real → Real :=
    (fun t => (8 * B') * (∫ x : Euclidean 2, ‖U t x‖ ^ 4)) +
      (fun t => (8 * ‖d‖ ^ (4 : Nat) * B) * (∫ x : Euclidean 2, ‖UP t x‖ ^ 4))
  have hgouter : Integrable g ν := by
    simpa only [g, Pi.add_apply] using
      (hUouter.const_mul (8 * B')).add
        (hUPouter.const_mul (8 * ‖d‖ ^ (4 : Nat) * B))
  have hginterval : IntervalIntegrable g volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hgouter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ≤ g t := by
    let ts : Icc (1 : Real) 2 := ⟨t, ht⟩
    have h := hfixed j k σ ts f
    calc
      (∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ≤
          8 * (B' * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
            ‖d‖ ^ 4 * B * (∫ x : Euclidean 2, ‖UP t x‖ ^ 4)) := by
              simpa only [F', U, P, UP, d, ts] using h
      _ = g t := by
              simp only [g, Pi.add_apply]
              ring
  have hF'toG :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ≤
        ∫ t in (1 : Real)..2, g t := by
    exact intervalIntegral.integral_mono_on (by norm_num) hF'interval hginterval hpoint
  have hg_integral :
      (∫ t in (1 : Real)..2, g t) =
        (8 * B') * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
          (8 * ‖d‖ ^ (4 : Nat) * B) *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) := by
    change (∫ t in (1 : Real)..2,
      (8 * B') * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
        (8 * ‖d‖ ^ (4 : Nat) * B) *
          (∫ x : Euclidean 2, ‖UP t x‖ ^ 4)) = _
    rw [intervalIntegral.integral_add
        (hUinterval.const_mul (8 * B'))
        (hUPinterval.const_mul (8 * ‖d‖ ^ (4 : Nat) * B)),
      intervalIntegral.integral_const_mul,
      intervalIntegral.integral_const_mul]
  have hUenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ≤
        L ^ (4 : Nat) * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) * E := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) =
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k t f x‖ ^ 4 := by
              apply intervalIntegral.integral_congr_ae
              filter_upwards with t ht
              apply integral_congr_ae
              filter_upwards with x
              change ‖circleAnnularEndpointHalfWaveOutput C σ k t f x‖ ^ 4 = _
              rw [circleAnnularEndpointHalfWaveOutput_apply]
      _ ≤ _ := by
        simpa only [E, aux_dyadicFrequencyPower_eq_dyadicTimeScale] using hUbound k hk σ f
  have hPenergy : (∫ x : Euclidean 2, ‖P x‖ ^ 4) ≤ M * E := by
    simpa only [P, E] using hPbound σ k f
  have hδ0 : 0 ≤ _root_.Auto.Spherical.MSS.dyadicTimeScale k := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact (zpow_pos (by norm_num) _).le
  have hUPenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) ≤
        L ^ (4 : Nat) * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) *
          (M * E) := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) =
          ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ k t P x‖ ^ 4 := by
              apply intervalIntegral.integral_congr_ae
              filter_upwards with t ht
              apply integral_congr_ae
              filter_upwards with x
              change ‖circleAnnularEndpointHalfWaveOutput C σ k t P x‖ ^ 4 = _
              rw [circleAnnularEndpointHalfWaveOutput_apply]
      _ ≤ L ^ (4 : Nat) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) *
            (∫ x : Euclidean 2, ‖P x‖ ^ 4) := by
              simpa only [aux_dyadicFrequencyPower_eq_dyadicTimeScale] using hUbound k hk σ P
      _ ≤ _ := by
        exact mul_le_mul_of_nonneg_left hPenergy
          (mul_nonneg (pow_nonneg hL.le _)
            (Real.rpow_nonneg hδ0 _))
  have hδ : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale k := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hfirstpow :
      (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (2 : Real) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) =
        (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) := by
    rw [← Real.rpow_add hδ]
    congr 1
    ring
  have hsecondpow :
      (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-2 : Real) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-1 + 4 * ρ) =
        (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (-3 + 4 * ρ) := by
    rw [← Real.rpow_add hδ]
    congr 1
    ring
  have hDcore :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ≤
        (8 * B') * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
          (8 * ‖d‖ ^ (4 : Nat) * B) *
            (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) := by
    exact hF'toG.trans_eq hg_integral
  have hfirst :
      ‖n‖ ^ 4 * ((8 * B') *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4)) ≤
        (8 * B' * L ^ (4 : Nat)) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) * E := by
    calc
      ‖n‖ ^ 4 * ((8 * B') *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4)) ≤
          ‖n‖ ^ 4 * ((8 * B') *
            (L ^ (4 : Nat) * (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^
              (-1 + 4 * ρ) * E)) := by
              exact mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_left hUenergy (by positivity))
                (pow_nonneg (norm_nonneg _) _)
      _ = (8 * B' * L ^ (4 : Nat)) *
          (_root_.Auto.Spherical.MSS.dyadicTimeScale k) ^ (1 + 4 * ρ) * E := by
            dsimp [n]
            rw [aux_norm_inv_circleEndpointDyadicNormalization_pow_four]
            calc
