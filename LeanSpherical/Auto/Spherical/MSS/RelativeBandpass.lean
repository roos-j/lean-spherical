theorem exists_uniform_norm_iteratedFDeriv_middleRapidNormdScRadialTimeDerivComp_le
    (r n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
