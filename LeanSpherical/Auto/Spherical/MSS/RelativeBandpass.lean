        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

section FormerNamespace_3

open Filter MeasureTheory Metric Set
open scoped ContDiff Topology FourierTransform

/-- A Schwartz realization of the normalized rapid middle multiplier. -/
private noncomputable def directMiddleRapidOutput
    (r : Nat) (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (k : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
      (directMiddleRapidFamily r C ⟨k, t⟩)
      (directMiddleRapidFrequencyScale ⟨k, t⟩) :
        Euclidean 2 → Complex)
    (𝓕 f))

/-- A Schwartz realization of the normalized time derivative of the rapid
middle multiplier. -/
private noncomputable def directMiddleRapidTimeDerivativeOutput
    (r : Nat) (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (k : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
      (directMiddleRapidTimeDerivativeFamily r C ⟨k, t⟩)
      (directMiddleRapidFrequencyScale ⟨k, t⟩) :
        Euclidean 2 → Complex)
    (𝓕 f))

private theorem fourier_directMiddleRapidOutput
    (r : Nat) (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (k : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (xi : Euclidean 2) :
    𝓕 (directMiddleRapidOutput r C k t f : Euclidean 2 → Complex) xi =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (directMiddleRapidFamily r C ⟨k, t⟩)
        (directMiddleRapidFrequencyScale ⟨k, t⟩) xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold directMiddleRapidOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
      (directMiddleRapidFamily r C ⟨k, t⟩)
      (directMiddleRapidFrequencyScale ⟨k, t⟩)).hasTemperateGrowth]
  simp only [SchwartzMap.fourier_coe, smul_eq_mul]

private theorem fourier_directMiddleRapidTimeDerivativeOutput
    (r : Nat) (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (k : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (xi : Euclidean 2) :
    𝓕 (directMiddleRapidTimeDerivativeOutput r C k t f : Euclidean 2 → Complex) xi =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (directMiddleRapidTimeDerivativeFamily r C ⟨k, t⟩)
        (directMiddleRapidFrequencyScale ⟨k, t⟩) xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold directMiddleRapidTimeDerivativeOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
      (directMiddleRapidTimeDerivativeFamily r C ⟨k, t⟩)
      (directMiddleRapidFrequencyScale ⟨k, t⟩)).hasTemperateGrowth]
  simp only [SchwartzMap.fourier_coe, smul_eq_mul]

private theorem directMiddleRapidOutput_eq_relativeMultiplierAt
    (r : Nat) (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (k : Nat)
    (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    directMiddleRapidOutput r C k t f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (directMiddleRapidFamily r C ⟨k, t⟩)
        (directMiddleRapidFrequencyScale ⟨k, t⟩) f x := by
  unfold directMiddleRapidOutput
  rw [SchwartzMap.fourierInv_coe]
  rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
      (directMiddleRapidFamily r C ⟨k, t⟩)
      (directMiddleRapidFrequencyScale ⟨k, t⟩)).hasTemperateGrowth]
