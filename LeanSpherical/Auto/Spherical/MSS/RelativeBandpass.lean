    calc
      t⁻¹ * rho ≤ 1 * 16 := mul_le_mul hinvle hrhotop hrho (by norm_num)
      _ = 16 := by norm_num
  · have hkpos : 0 < k := Nat.pos_of_ne_zero hk0
    simp only [if_neg hk0]
    by_cases hk1 : k = 1
    · subst k
      simp only [ite_true, norm_mul, Complex.norm_real,
        Real.norm_of_nonneg hinvnonneg, norm_one]
      simp only [mul_one]
      calc
        t⁻¹ ≤ 1 := hinvle
