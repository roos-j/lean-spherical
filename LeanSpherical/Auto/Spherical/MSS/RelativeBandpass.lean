  choose H hHpos hH using fun i : Nat =>
    exists_uniform_norm_iteratedFDeriv_middleRapidNormdScRadialTimeDerivComp_le r i
  apply aux_exists_uniform_norm_iteratedFDeriv_compactRadialFamily_le
    (middleRapidNormalizedScaledRadialAmplitudeTimeDerivative r)
    (fun j t => directMiddleRapidTimeDerivativeSymbol r C j t)
    (fixedDyadicFatBandpass C)
    (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex))
    (fun j t => contDiff_middleRapidNormalizedScaledRadialAmplitudeTimeDerivative r j t)
    H hHpos hH
  · intro j t eta
    rw [directMiddleRapidTimeDerivativeSymbol_apply]
    unfold directMiddleRapidTimeDerivativeSymbolFun
