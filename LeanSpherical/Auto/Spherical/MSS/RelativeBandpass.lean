/-- The fixed fat multiplier is a finite telescoping sum of five integer
Littlewood--Paley bands. -/
theorem circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_intDyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi =
      ∑ i ∈ Finset.range 5,
        _root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff
          ((j : Int) - 2 + i) xi := by
  rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier,
    _root_.Auto.LittlewoodPaley.shiftedFatMultiplier]
  have h := _root_.Auto.LittlewoodPaley.finiteIntegerDyadicResolution
    C ((j : Int) - 2) 5 xi
  rw [show ((j : Int) + 3) = ((j : Int) - 2) + 5 by omega]
  simpa using h.symm

private theorem circleRelativeBand_intDyadicBandpassMultiplier_ofNat_eq_dyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (n : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier C.cutoff
        (n : Int) xi =
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff n xi := by
  rw [_root_.Auto.LittlewoodPaley.intDyadicBandpassMultiplier_apply,
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_apply]
  rw [show (n : Int) + 1 = ((n + 1 : Nat) : Int) by omega]
  simp only [zpow_natCast]

/-- Above the two low-frequency exceptional scales, the fat multiplier is
literally the sum of its five neighboring ordinary dyadic bands. -/
theorem circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_dyadic
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi =
      ∑ i ∈ Finset.range 5,
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff
          (j - 2 + i) xi := by
  rw [circleRelativeBand_fatDyadicBandpassMultiplier_eq_sum_intDyadic]
  apply Finset.sum_congr rfl
  intro i hi
  rw [show (j : Int) - 2 + i = ((j - 2 + i : Nat) : Int) by omega]
  rw [circleRelativeBand_intDyadicBandpassMultiplier_ofNat_eq_dyadic]

/-- The unrestricted-time scalar profile underlying the moving fat relative
band.  It is kept private because only the literal output and its derivative
are part of the public interface. -/
noncomputable def aux_circleRelativeBandUnitDifferenceRaw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : Real) (eta : Euclidean 2) : Complex :=
  C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta)) -
    C.cutoff (((2 : Real) ^ 0)⁻¹ • (t • eta))

/-- The literal time derivative of the unrestricted moving relative profile. -/
noncomputable def aux_circleRelativeBandUnitDifferenceRawTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (t : Real) (eta : Euclidean 2) : Complex :=
  fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta))
      (((2 : Real) ^ (0 + 1))⁻¹ • eta) -
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ 0)⁻¹ • (t • eta))
      (((2 : Real) ^ 0)⁻¹ • eta)

/-- The literal moving fat relative-band multiplier applied to the ordinary
dyadic half-wave at scale `k`; `j` is the relative-band scale. -/
noncomputable def circleRelativeBandFatHalfWaveOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The literal time derivative of
`circleRelativeBandFatHalfWaveOutput`.  Its two summands are respectively the
moving relative multiplier derivative and the ordinary half-wave derivative. -/
noncomputable def circleRelativeBandFatHalfWaveOutputTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t
        (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi +
      aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        (_root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi)) *
      𝓕 (f : Euclidean 2 → Complex) xi) x

theorem aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Continuous (Function.uncurry (aux_circleRelativeBandUnitDifferenceRaw C)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2)) -
      C.cutoff (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2)))
  exact ((C.cutoff.smooth 0).continuous.comp (by fun_prop)).sub
    ((C.cutoff.smooth 0).continuous.comp (by fun_prop))

theorem aux_continuous_uncurry_circleRelativeBandUnitDifferenceRawTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    Continuous (Function.uncurry
      (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C)) := by
  have hderiv : Continuous (fderiv Real (C.cutoff : Euclidean 2 → Complex)) :=
    (C.cutoff.smooth 1).continuous_fderiv (by norm_num)
  change Continuous (fun q : Real × Euclidean 2 =>
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ (0 + 1))⁻¹ • q.2) -
      fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ 0)⁻¹ • q.2))
  apply Continuous.sub
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)

private theorem aux_continuous_uncurry_dyadicHalfWaveSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) :
    Continuous (Function.uncurry
      (fun t xi => _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
