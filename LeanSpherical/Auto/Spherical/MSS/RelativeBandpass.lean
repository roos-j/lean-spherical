    · simp [hk1]

private theorem aux_norm_iteratedDeriv_mul_le
    {n : Nat} {f g : Real → Complex} {x : Real} {A B : Real}
    (hf : ContDiff Real (⊤ : ℕ∞) f)
    (hg : ContDiff Real (⊤ : ℕ∞) g)
    (hA : 0 ≤ A)
    (hfa : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k f x‖ ≤ A)
    (hgb : ∀ k : Nat, k ≤ n → ‖iteratedDeriv k g x‖ ≤ B) :
    ‖iteratedDeriv n (fun u : Real => f u * g u) x‖ ≤
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
  change ‖iteratedDeriv n (f * g) x‖ ≤ _
  rw [iteratedDeriv_mul
    ((hf.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)
    ((hg.of_le (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
      exact WithTop.coe_le_coe.mpr le_top)).contDiffAt)]
  calc
    ‖∑ i ∈ Finset.range (n + 1), n.choose i * iteratedDeriv i f x *
        iteratedDeriv (n - i) g x‖ ≤
      ∑ i ∈ Finset.range (n + 1),
        ‖n.choose i * iteratedDeriv i f x * iteratedDeriv (n - i) g x‖ :=
      norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * A * B := by
      apply Finset.sum_le_sum
      intro i hi
      have hi' : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hleft := hfa i hi'
      have hright := hgb (n - i) (Nat.sub_le _ _)
      rw [norm_mul, norm_mul, norm_natCast]
      calc
        (n.choose i : Real) * ‖iteratedDeriv i f x‖ *
            ‖iteratedDeriv (n - i) g x‖ =
            (n.choose i : Real) *
              (‖iteratedDeriv i f x‖ * ‖iteratedDeriv (n - i) g x‖) := by ring
        _ ≤ (n.choose i : Real) * (A * B) :=
          mul_le_mul_of_nonneg_left
            (mul_le_mul hleft hright (norm_nonneg _) hA)
            (Nat.cast_nonneg (n.choose i))
        _ = (n.choose i : Real) * A * B := by ring

/-- All parameter derivatives of the middle amplitude retain arbitrary
inverse dyadic powers on the fixed annulus. -/
theorem exists_dyadicPower_norm_iteratedDeriv_middleScaledRadialAmplitude_le
    (k p : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
      ‖iteratedDeriv k (middleScaledRadialAmplitude j t) rho‖ ≤
        A / ((2 : Real) ^ j) ^ p := by
  obtain ⟨C, hC, hdecay⟩ :=
    exists_iteratedDeriv_coordinateMiddleMeridianLocalizedIntegral_abs_decay 0 k (k + p)
  let A : Real := C * 4 ^ k
  have hA : 0 < A := mul_pos hC (pow_pos (by norm_num) _)
  refine ⟨A, hA, ?_⟩
  intro j t rho ht hrho _
  let s : Real := (2 : Real) ^ j
  let a : Real := 2 * Real.pi * t * s
  let freq : Real := a * rho
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hrhopos : 0 < rho := lt_of_lt_of_le (by norm_num) hrho
  have hapos : 0 < a := by
    dsimp [a]
    positivity
  have hfreqpos : 0 < freq := by
    dsimp [freq]
    positivity
  have hfactor : 1 ≤ 2 * Real.pi * t * rho := by
    have htr : (1 / 4 : Real) ≤ t * rho := by
      calc
        (1 / 4 : Real) = 1 * (1 / 4 : Real) := by ring
        _ ≤ t * rho := mul_le_mul ht hrho (by norm_num) htpos.le
    have hpi : (3 : Real) ≤ Real.pi := Real.pi_gt_three.le
    have hpit : 3 * (1 / 4 : Real) ≤ Real.pi * (t * rho) :=
      mul_le_mul hpi htr (by norm_num) (by linarith [Real.pi_gt_three])
    nlinarith
  have hlower : s ≤ freq := by
    change s ≤ a * rho
    change s ≤ (2 * Real.pi * t * s) * rho
    rw [show (2 * Real.pi * t * s) * rho = s * (2 * Real.pi * t * rho) by ring]
    exact le_mul_of_one_le_right hspos.le hfactor
  have hsone : 1 ≤ s := by
    dsimp [s]
    exact one_le_pow₀ (by norm_num)
  have hfreqone : 1 ≤ freq := hsone.trans hlower
  have hmain := hdecay freq (by
    rw [abs_of_pos hfreqpos]
    exact hfreqone)
  have hpow : a ^ k ≤ (4 * freq) ^ k := by
    apply pow_le_pow_left₀ hapos.le
    have hfactorRho : 1 ≤ 4 * rho := by nlinarith
    calc
      a = a * 1 := by ring
      _ ≤ a * (4 * rho) := mul_le_mul_of_nonneg_left hfactorRho hapos.le
      _ = 4 * freq := by dsimp [freq]; ring
  have hspowpos : 0 < s ^ p := pow_pos hspos _
  have hfreqpow : s ^ p ≤ freq ^ p :=
    pow_le_pow_left₀ hspos.le hlower p
  rw [iteratedDeriv_middleScaledRadialAmplitude]
  change ‖a ^ k • iteratedDeriv k
      (coordinateMiddleMeridianLocalizedIntegral 0) freq‖ ≤ A / s ^ p
  rw [norm_smul, Real.norm_eq_abs, abs_pow, abs_of_pos hapos]
  rw [abs_of_pos hfreqpos] at hmain
  have hquot : C * 4 ^ k / freq ^ p ≤ A / s ^ p := by
    dsimp [A]
    exact div_le_div_of_nonneg_left
      (mul_nonneg hC.le (pow_nonneg (by norm_num) _)) hspowpos hfreqpow
  calc
    a ^ k * ‖iteratedDeriv k (coordinateMiddleMeridianLocalizedIntegral 0) freq‖ ≤
        a ^ k * (C / freq ^ (k + p)) :=
      mul_le_mul_of_nonneg_left hmain (pow_nonneg hapos.le _)
    _ ≤ (4 * freq) ^ k * (C / freq ^ (k + p)) :=
      mul_le_mul_of_nonneg_right hpow
        (div_nonneg hC.le (pow_nonneg hfreqpos.le _))
    _ = C * 4 ^ k / freq ^ p := by
      rw [mul_pow, pow_add]
      field_simp
    _ ≤ A / s ^ p := hquot

theorem exists_dyadicPower_norm_iteratedDeriv_middleScaledRadialAmplitudeTimeDerivative_le
    (n p : Nat) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
      ‖iteratedDeriv n (middleScaledRadialAmplitudeTimeDerivative j t) rho‖ ≤
        B / ((2 : Real) ^ j) ^ p := by
  choose H hHpos hH using fun k : Nat =>
    exists_dyadicPower_norm_iteratedDeriv_middleScaledRadialAmplitude_le (k + 1) p
  let A : Real := ∑ k ∈ Finset.range (n + 1), H k
  have hApos : 0 < A := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H 0 ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun k hk => (hHpos k).le) hmem
    exact lt_of_lt_of_le (hHpos 0) hle
  let B : Real := ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * 16 * A
  have hBpos : 0 < B := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hterm : 0 < (n.choose 0 : Real) * 16 * A := by
      simp
      positivity
    have hle : (n.choose 0 : Real) * 16 * A ≤ B := by
      dsimp [B]
      exact Finset.single_le_sum
        (s := Finset.range (n + 1))
        (f := fun i : Nat => (n.choose i : Real) * 16 * A)
        (fun i hi => by positivity) hmem
    exact lt_of_lt_of_le hterm hle
  refine ⟨B, hBpos, ?_⟩
  intro j t rho ht hrho hrhotop
  let s : Real := (2 : Real) ^ j
  let F : Real → Complex := middleScaledRadialAmplitude j t
  let U : Real → Complex := fun r => ((t⁻¹ : Real) : Complex) * (r : Complex)
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have htne : t ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one ht)
  have hformula : middleScaledRadialAmplitudeTimeDerivative j t =
      fun r => U r * deriv F r := by
    rw [middleScaledRadialAmplitudeTimeDerivative_eq_rho_div_t_mul_deriv j t htne]
    funext r
    dsimp [U]
    push_cast
    ring
  have hU : ContDiff Real (⊤ : ℕ∞) U := by
    dsimp [U]
    exact contDiff_const.mul Complex.ofRealCLM.contDiff
  have hF : ContDiff Real (⊤ : ℕ∞) F := by
    dsimp [F]
    exact contDiff_middleScaledRadialAmplitude j t
  have hF' : ContDiff Real (⊤ : ℕ∞) (deriv F) :=
    (contDiff_infty_iff_deriv.mp hF).2
  have hUbound (k : Nat) (hk : k ≤ n) : ‖iteratedDeriv k U rho‖ ≤ 16 := by
    dsimp [U]
    exact aux_norm_iteratedDeriv_timeEulerFactor_le k t rho ht
      (by linarith) hrhotop
  have hF'bound (k : Nat) (hk : k ≤ n) :
      ‖iteratedDeriv k (deriv F) rho‖ ≤ A / s ^ p := by
    rw [← iteratedDeriv_succ']
    have hmain := hH k j t rho ht hrho hrhotop
    have hmem : k ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : H k ≤ A := by
      dsimp [A]
      exact Finset.single_le_sum (fun l hl => (hHpos l).le) hmem
    change ‖iteratedDeriv (k + 1) (middleScaledRadialAmplitude j t) rho‖ ≤ A / s ^ p
    exact hmain.trans (by
      change H k / ((2 : Real) ^ j) ^ p ≤ A / ((2 : Real) ^ j) ^ p
      exact div_le_div_of_nonneg_right hle
        (show 0 ≤ ((2 : Real) ^ j) ^ p by positivity))
  have hprod := aux_norm_iteratedDeriv_mul_le (n := n) hU hF'
    (by norm_num) hUbound hF'bound
  have hscale : ∑ i ∈ Finset.range (n + 1),
      (n.choose i : Real) * 16 * (A / s ^ p) = B / s ^ p := by
    calc
      ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * 16 * (A / s ^ p) =
          ∑ i ∈ Finset.range (n + 1), ((n.choose i : Real) * 16 * A) / s ^ p := by
        apply Finset.sum_congr rfl
        intro i hi
        field_simp
      _ = B / s ^ p := by
        dsimp [B]
        rw [Finset.sum_div]
  calc
    ‖iteratedDeriv n (middleScaledRadialAmplitudeTimeDerivative j t) rho‖ =
        ‖iteratedDeriv n (fun r => U r * deriv F r) rho‖ := by rw [hformula]
    _ ≤ ∑ i ∈ Finset.range (n + 1), (n.choose i : Real) * 16 * (A / s ^ p) := hprod
    _ = B / s ^ p := hscale
    _ = B / ((2 : Real) ^ j) ^ p := by rfl

noncomputable def middleRapidNormalizedScaledRadialAmplitude
    (n j : Nat) (t : Real) : Real → Complex := fun rho =>
  ((((2 : Real) ^ j) ^ (n + 1) : Real) : Complex) *
    middleScaledRadialAmplitude j t rho

