      ∀ g : WaveSpaceTime → Complex,
      (∫⁻ o : WaveSpaceTime,
        {o : WaveSpaceTime | ‖o.1‖ < 3 ∧ |o.2| < 2}.indicator
          (fun o =>
            (∑ n ∈ I, ∑ j ∈ J,
              normalizedCircleFinePacketCoreConvolutionPositiveKernel
                (normalizedCircleThinNormalProjectorSymbol
