    middleScaledRadialAmplitudeTimeDerivative j t rho

theorem contDiff_middleRapidNormalizedScaledRadialAmplitude
    (n j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (middleRapidNormalizedScaledRadialAmplitude n j t) := by
