/-- Unconditional uniform physical-kernel control for the moving relative
unit family. -/
theorem exists_circleRelativeBandFatUnit_uniformKernelBound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 ≤ A ∧ ∀ t : CircleRelativeBandLocalTime,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (circleRelativeBandFatUnitFamily C t) ≤ A := by
