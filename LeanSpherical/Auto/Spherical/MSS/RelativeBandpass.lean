private theorem aux_directMiddleRapid_scale_identity (r j : Nat) :
    ‖((((2 : Real) ^ j) ^ (r + 1) : Real) : Complex)‖⁻¹ *
        (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ (-(1 / 4 : Real)) =
      (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
        ((r : Real) + (3 : Real) / 4) := by
  let R : Real := (2 : Real) ^ j
  have hR : 0 ≤ R := by
    dsimp [R]
    positivity
