      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).continuous.comp
        hscaled
    have hmiddle' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C k q.1.1 q.2) := by
      change Continuous ((fun p : Real × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C k p.1 p.2) ∘
