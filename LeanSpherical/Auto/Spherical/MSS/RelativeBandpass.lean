theorem exists_uniform_norm_iteratedDeriv_middleRapidNormalizedScaledRadialAmplitude_le
    (n k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
      ‖iteratedDeriv k (middleRapidNormalizedScaledRadialAmplitude n j t) rho‖ ≤ A := by
  obtain ⟨A, hA, hbound⟩ :=
    exists_dyadicPower_norm_iteratedDeriv_middleScaledRadialAmplitude_le k (n + 1)
  refine ⟨A, hA, ?_⟩
  intro j t rho ht hrho hrhotop
  unfold middleRapidNormalizedScaledRadialAmplitude
  rw [iteratedDeriv_const_mul_field, norm_mul, Complex.norm_real]
  have hs : 0 < ((2 : Real) ^ j) ^ (n + 1) := by positivity
  rw [Real.norm_of_nonneg hs.le]
  have hmain := hbound j t rho ht hrho hrhotop
  calc
    ((2 : Real) ^ j) ^ (n + 1) *
        ‖iteratedDeriv k (middleScaledRadialAmplitude j t) rho‖ ≤
        ((2 : Real) ^ j) ^ (n + 1) *
          (A / ((2 : Real) ^ j) ^ (n + 1)) :=
      mul_le_mul_of_nonneg_left hmain hs.le
    _ = A := by field_simp

theorem
    exists_uniform_norm_iteratedDeriv_middleRapidNormalizedScaledRadialAmplitudeTimeDerivative_le
    (n k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
