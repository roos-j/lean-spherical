private theorem aux_norm_iteratedDeriv_timeEulerFactor_le
    (k : Nat) (t rho : Real) (ht : 1 ≤ t) (hrho : 0 ≤ rho) (hrhotop : rho ≤ 16) :
    ‖iteratedDeriv k (fun r : Real => ((t⁻¹ : Real) : Complex) * (r : Complex)) rho‖ ≤ 16 := by
  rw [iteratedDeriv_const_mul_field]
  have hbase : iteratedDeriv k (fun r : Real => (r : Complex)) rho =
      if k = 0 then (rho : Complex) else if k = 1 then 1 else 0 := by
    cases k with
    | zero => simp
    | succ k =>
        rw [iteratedDeriv_succ']
        have hderiv : deriv (fun r : Real => (r : Complex)) = fun _ => (1 : Complex) := by
          funext r
          exact (hasDerivAt_id r).ofReal_comp.deriv
        rw [hderiv, iteratedDeriv_const]
        cases k <;> simp
  rw [hbase]
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hinvnonneg : 0 ≤ t⁻¹ := inv_nonneg.mpr htpos.le
  have hinvle : t⁻¹ ≤ 1 := (inv_le_one₀ htpos).mpr ht
  by_cases hk0 : k = 0
