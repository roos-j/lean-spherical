/-- The literal moving fat relative-band multiplier applied to the
nonstationary middle dyadic wave.  Here `j` is the moving relative-band
scale and `k` is the ordinary middle-wave scale. -/
noncomputable def circleRelativeBandFatMiddleOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      aux_circleMiddleBandpassMultiplier C k t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The literal product-rule time derivative of
`circleRelativeBandFatMiddleOutput`. -/
noncomputable def aux_circleRelativeBandFatMiddleOutputTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t
        (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        aux_circleMiddleBandpassMultiplier C k t xi +
      aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
      aux_circleMiddleBandpassMultiplierTimeDerivative C k t xi) *
      𝓕 (f : Euclidean 2 → Complex) xi) x

