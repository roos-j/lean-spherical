private theorem aux_exists_uniform_norm_iteratedFDeriv_compactRadialFamily_le
    (R : Nat → Real → Real → Complex)
    (S : Nat → Real → SchwartzMap (Euclidean 2) Complex)
    (qS : SchwartzMap (Euclidean 2) Complex) (c : Complex)
    (hRcont : ∀ j t, ContDiff Real (⊤ : ℕ∞) (R j t))
    (H : Nat → Real) (hHpos : ∀ n, 0 < H n)
    (hH : ∀ (n j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖eta‖ → ‖eta‖ ≤ 16 →
      ‖iteratedFDeriv Real n (fun y : Euclidean 2 => R j t ‖y‖) eta‖ ≤ H n)
    (hSapply : ∀ j t eta, S j t eta = c * (R j t ‖eta‖ * qS eta))
    (hSsupport : ∀ j t,
      Function.support (S j t : Euclidean 2 → Complex) ⊆
        Metric.closedBall 0 (16 : Real) ∩ {eta : Euclidean 2 | (1 / 4 : Real) ≤ ‖eta‖})
    (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      ‖iteratedFDeriv Real n (S j t : Euclidean 2 → Complex) eta‖ ≤ B := by
  let q : Euclidean 2 → Complex := qS
  let B : Real := ‖c‖ * ∑ i ∈ Finset.range (n + 1),
    (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS
  have hqnonneg (m : Nat) : 0 ≤ SchwartzMap.seminorm Complex 0 m qS := by
    exact le_trans (norm_nonneg _) (qS.norm_iteratedFDeriv_le_seminorm Complex m 0)
  have hB : 0 ≤ B := by
    dsimp [B]
    apply mul_nonneg (norm_nonneg _)
    apply Finset.sum_nonneg
    intro i hi
    exact mul_nonneg (mul_nonneg (by positivity) (hHpos i).le) (hqnonneg (n - i))
  refine ⟨B, hB, ?_⟩
  intro j t eta ht _
  let K : Set (Euclidean 2) :=
    Metric.closedBall 0 (16 : Real) ∩ {y : Euclidean 2 | (1 / 4 : Real) ≤ ‖y‖}
  have hKclosed : IsClosed K := by
    dsimp [K]
    apply IsClosed.inter Metric.isClosed_closedBall
    exact isClosed_le continuous_const continuous_norm
  have htsupp : tsupport (S j t : Euclidean 2 → Complex) ⊆ K := by
    change closure (Function.support (S j t : Euclidean 2 → Complex)) ⊆ K
    exact closure_minimal (hSsupport j t) hKclosed
  by_cases hetaK : eta ∈ K
  · have hetaouter : ‖eta‖ ≤ 16 := by
      simpa only [K, Metric.mem_closedBall, dist_zero_right] using hetaK.1
    have hetainner : (1 / 4 : Real) ≤ ‖eta‖ := hetaK.2
    have hetane : eta ≠ 0 := by
      intro hzero
      subst eta
      norm_num at hetainner
    let U : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
    have hUopen : IsOpen U := by
      simpa only [U] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
    have hUunique : UniqueDiffOn Real U := hUopen.uniqueDiffOn
    have hetaU : eta ∈ U := by simpa [U] using hetane
    let g : Real → Complex := R j t
    let f : Euclidean 2 → Real := fun y => ‖y‖
    let h : Euclidean 2 → Complex := fun y => g (f y)
    have hg : ContDiff Real n g := by
      dsimp [g]
      exact (hRcont j t).of_le
        (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
          exact WithTop.coe_le_coe.mpr le_top)
    have hf : ContDiffOn Real n f U := by
      intro x hx
      exact (contDiffAt_norm Real (by simpa [U] using hx)).contDiffWithinAt
    have hh : ContDiffOn Real n h U := by
      change ContDiffOn Real n (g ∘ f) U
      exact hg.comp_contDiffOn hf
    have hq : ContDiff Real n q := by
      change ContDiff Real n (qS : Euclidean 2 → Complex)
      exact qS.smooth n
    have hradialAt : ContDiffAt Real n h eta := by
      change ContDiffAt Real n (g ∘ f) eta
      exact hg.contDiffAt.comp eta (contDiffAt_norm Real hetane)
    have hqAt : ContDiffAt Real n q eta := hq.contDiffAt
    have hprodAt : ContDiffAt Real n (fun y => h y * q y) eta := hradialAt.mul hqAt
    have hprod := norm_iteratedFDerivWithin_mul_le
      hh hq.contDiffOn hUunique hetaU
      (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    have hprodEq : iteratedFDerivWithin Real n (fun y => h y * q y) U eta =
        iteratedFDeriv Real n (fun y => h y * q y) eta :=
      iteratedFDerivWithin_eq_iteratedFDeriv hUunique hprodAt hetaU
    have hsum :
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h U eta‖ *
            ‖iteratedFDerivWithin Real (n - i) q U eta‖ ≤
        ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS := by
      apply Finset.sum_le_sum
      intro i hi
      have hin : i ≤ n := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hradialAt_i : ContDiffAt Real i h eta := by
        change ContDiffAt Real i (g ∘ f) eta
        exact (hg.of_le (by exact_mod_cast hin)).contDiffAt.comp eta
          (contDiffAt_norm Real hetane)
      have hqAt_i : ContDiffAt Real (n - i : Nat) q eta := by
        change ContDiffAt Real (n - i : Nat) (qS : Euclidean 2 → Complex) eta
        exact qS.contDiffAt (n - i)
      have hradialEq : iteratedFDerivWithin Real i h U eta = iteratedFDeriv Real i h eta :=
        iteratedFDerivWithin_eq_iteratedFDeriv hUunique hradialAt_i hetaU
      have hqEq : iteratedFDerivWithin Real (n - i) q U eta =
          iteratedFDeriv Real (n - i) q eta :=
        iteratedFDerivWithin_eq_iteratedFDeriv hUunique hqAt_i hetaU
      rw [hradialEq, hqEq]
      have hradial : ‖iteratedFDeriv Real i h eta‖ ≤ H i := by
        change ‖iteratedFDeriv Real i (fun y : Euclidean 2 => R j t ‖y‖) eta‖ ≤ H i
        exact hH i j t eta ht hetainner hetaouter
      have hqbound : ‖iteratedFDeriv Real (n - i) q eta‖ ≤
          SchwartzMap.seminorm Complex 0 (n - i) qS := by
        change ‖iteratedFDeriv Real (n - i) (qS : Euclidean 2 → Complex) eta‖ ≤ _
        exact qS.norm_iteratedFDeriv_le_seminorm Complex (n - i) eta
      calc
        (n.choose i : Real) * ‖iteratedFDeriv Real i h eta‖ *
            ‖iteratedFDeriv Real (n - i) q eta‖ ≤
          (n.choose i : Real) * H i * ‖iteratedFDeriv Real (n - i) q eta‖ :=
          mul_le_mul_of_nonneg_right
            (mul_le_mul_of_nonneg_left hradial (by positivity)) (norm_nonneg _)
        _ ≤ (n.choose i : Real) * H i * SchwartzMap.seminorm Complex 0 (n - i) qS :=
          mul_le_mul_of_nonneg_left hqbound (mul_nonneg (by positivity) (hHpos i).le)
    have hfamilyEq : (S j t : Euclidean 2 → Complex) =
        fun y => c * (h y * q y) := by
      funext y
      rw [hSapply]
    have hscalar : (fun y : Euclidean 2 => c * (h y * q y)) =
        fun y => c • (h y * q y) := by
      funext y
      simp [smul_eq_mul]
    calc
      ‖iteratedFDeriv Real n (S j t : Euclidean 2 → Complex) eta‖ =
          ‖c‖ * ‖iteratedFDeriv Real n (fun y => h y * q y) eta‖ := by
            rw [hfamilyEq, hscalar, iteratedFDeriv_const_smul_apply' hprodAt, norm_smul]
      _ = ‖c‖ * ‖iteratedFDerivWithin Real n (fun y => h y * q y) U eta‖ := by
            rw [hprodEq]
      _ ≤ ‖c‖ * ∑ i ∈ Finset.range (n + 1),
          (n.choose i : Real) * ‖iteratedFDerivWithin Real i h U eta‖ *
            ‖iteratedFDerivWithin Real (n - i) q U eta‖ :=
          mul_le_mul_of_nonneg_left hprod (norm_nonneg _)
      _ ≤ B := by exact mul_le_mul_of_nonneg_left hsum (norm_nonneg _)
  · have hnot : eta ∉ Function.support (iteratedFDeriv Real n (S j t : Euclidean 2 → Complex)) := by
      intro hmem
      exact hetaK (htsupp (support_iteratedFDeriv_subset n hmem))
    have hzero : iteratedFDeriv Real n (S j t : Euclidean 2 → Complex) eta = 0 := by
      by_contra hne
      exact hnot (Function.mem_support.mpr hne)
    rw [hzero]
    simpa using hB

private theorem exists_uniform_norm_iteratedFDeriv_directMiddleRapidSymbol_le
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2) (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (j : Nat) (t : Real) (eta : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      ‖iteratedFDeriv Real n
        (directMiddleRapidSymbol r C j t : Euclidean 2 → Complex) eta‖ ≤ B := by
