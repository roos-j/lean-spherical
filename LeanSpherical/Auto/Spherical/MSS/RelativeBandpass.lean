      MemLp (fun o : WaveSpaceTime => ∑ j ∈ outputs, ‖T j o‖^2) 2
        ((volume.prod volume).restrict {o : WaveSpaceTime | ‖o.1‖ < Rout ∧ |o.2| < 4}) ∧
      (∫ o : WaveSpaceTime, (∑ j ∈ outputs, ‖T j o‖^2)^2
        ∂((volume.prod volume).restrict {o : WaveSpaceTime | ‖o.1‖ < Rout ∧ |o.2| < 4})) ≤
      C*M^4*h^2/(L^4*Real.sqrt L⁻¹)*
        (∫ y : Euclidean 2,(∑ i ∈ inputs, ‖f i y‖^2)^2
