    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hmiddlepair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hrawdot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1.1
