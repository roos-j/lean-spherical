private theorem directMiddleRapidSymbol_at_dyadicScale
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    directMiddleRapidSymbol r C j t ((dyadicFrequencyScale j).1 • xi) =
      ((((2 : Real) ^ j) ^ (r + 1) : Real) : Complex) *
        aux_circleMiddleBandpassMultiplier C j t xi := by
  rw [directMiddleRapidSymbol_apply]
  unfold directMiddleRapidSymbolFun middleRapidNormalizedScaledRadialAmplitude
    middleScaledRadialAmplitude
  rw [fixedDyadicFatBandpass_apply]
  simp only [dyadicFrequencyScale]
  have hpow : 0 < (2 : Real) ^ j := by positivity
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
  have harg :
      (2 * Real.pi * t * (2 : Real) ^ j) * (((2 : Real) ^ j)⁻¹ * ‖xi‖) =
        2 * Real.pi * (t * ‖xi‖) := by field_simp
  rw [harg]
  rw [← fatDyadicBandpassMultiplier_eq_prototype_scale]
  rw [← Auto.Spherical.MSS.dyadicBandpassMultiplier_eq_levelZero_scaled]
  unfold aux_circleMiddleBandpassMultiplier
  rw [show Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
      Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi by ring]
  rw [Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier]
  push_cast
  rw [pow_succ]
  ring

