theorem exists_uniform_norm_iteratedDeriv_middleRapidNormalizedScaledRadialAmplitude_le
    (n k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
      ‖iteratedDeriv k (middleRapidNormalizedScaledRadialAmplitude n j t) rho‖ ≤ A := by
  obtain ⟨A, hA, hbound⟩ :=
    exists_dyadicPower_norm_iteratedDeriv_middleScaledRadialAmplitude_le k (n + 1)
  refine ⟨A, hA, ?_⟩
  intro j t rho ht hrho hrhotop
  unfold middleRapidNormalizedScaledRadialAmplitude
