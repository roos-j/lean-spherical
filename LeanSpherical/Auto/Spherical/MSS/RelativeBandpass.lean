    rw [circleAnnularEndpointHalfWaveOutput_apply]
  have hF'outer : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F' t x‖ ^ 4) ν :=
    hF'prod.integral_prod_left
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ν :=
    hUprod.integral_prod_left
  have hUPouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖UP t x‖ ^ 4) ν :=
    hUPprod.integral_prod_left
  have hF'interval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F' t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hF'outer
  have hUinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      volume 1 2 := by
