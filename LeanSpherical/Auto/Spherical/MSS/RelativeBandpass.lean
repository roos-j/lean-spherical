    simp [R, _root_.Auto.Spherical.MSS.dyadicTimeScale, zpow_neg]
  rw [hδ, Complex.norm_real, Real.norm_of_nonneg (pow_nonneg hR _)]
  rw [← Real.rpow_natCast, ← Real.rpow_neg hR]
  rw [← Real.rpow_neg_eq_inv_rpow, ← Real.rpow_neg_eq_inv_rpow]
  rw [← Real.rpow_add hRpos]
  congr 1
  push_cast
  ring

private theorem intervalIntegral_integral_norm_pow_four_le_of_slab_bound
    {F : Real → Euclidean 2 → Complex} {D : Real}
    (hprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume))
    (hbound : ∀ t : Real, t ∈ Icc (1 : Real) 2 →
      (∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤ D) :
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤ D := by
  have houter : Integrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F t x‖ ^ 4)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real =>
      ∫ x : Euclidean 2, ‖F t x‖ ^ 4) volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        ∫ _t in (1 : Real)..2, D := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval
        intervalIntegrable_const hbound
    _ = D := by norm_num

private theorem
