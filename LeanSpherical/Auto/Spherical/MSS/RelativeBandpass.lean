    exists_uniform_norm_iteratedFDeriv_middleRapidNormalizedScaledRadialComp_le r i
  apply aux_exists_uniform_norm_iteratedFDeriv_compactRadialFamily_le
    (middleRapidNormalizedScaledRadialAmplitude r)
    (fun j t => directMiddleRapidSymbol r C j t)
    (fixedDyadicFatBandpass C)
    (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex))
    (fun j t => contDiff_middleRapidNormalizedScaledRadialAmplitude r j t) H hHpos hH
  · intro j t eta
    rw [directMiddleRapidSymbol_apply]
    unfold directMiddleRapidSymbolFun
    ring
  · intro j t
    exact directMiddleRapidSymbol_support_subset_annulus r C j t

