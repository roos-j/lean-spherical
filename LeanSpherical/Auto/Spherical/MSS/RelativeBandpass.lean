  have hpow : 0 < (2 : Real) ^ j := by positivity
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
  have harg :
      (2 * Real.pi * t * (2 : Real) ^ j) * (((2 : Real) ^ j)⁻¹ * ‖xi‖) =
        2 * Real.pi * (t * ‖xi‖) := by field_simp
  rw [harg]
  rw [← fatDyadicBandpassMultiplier_eq_prototype_scale]
  rw [← Auto.Spherical.MSS.dyadicBandpassMultiplier_eq_levelZero_scaled]
  unfold aux_circleMiddleBandpassMultiplier
