theorem aux_continuous_and_hasDerivAt_circleRelativeBandFatMiddleOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
