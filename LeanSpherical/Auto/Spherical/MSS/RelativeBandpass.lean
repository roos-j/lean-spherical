  · intro j t
    exact directMiddleRapidTimeDerivativeSymbol_support_subset_annulus r C j t

private theorem aux_exists_relativeSchwartzMultiplierKernelSize_compactFamily_le
    (S : Nat → Real → SchwartzMap (Euclidean 2) Complex)
    (hsupport : ∀ j t,
      Function.support (S j t : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 (16 : Real))
    (hderivAll : ∀ n : Nat, ∃ B : Real, 0 ≤ B ∧ ∀ (j : Nat) (t : Real)
      (eta : Euclidean 2), 1 ≤ t → t ≤ 2 →
      ‖iteratedFDeriv Real n (S j t : Euclidean 2 → Complex) eta‖ ≤ B) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      relativeSchwartzMultiplierKernelSize (S j t) ≤ A := by
  choose B hB hderiv using hderivAll
  let K : Set (Euclidean 2) := Metric.closedBall 0 (16 : Real)
  have hKmeas : MeasurableSet K := measurableSet_closedBall
  have hKfinite : volume K ≠ (⊤ : ENNReal) :=
    ne_of_lt MeasureTheory.measure_closedBall_lt_top
  let A0 : Real := B 0 * (volume K).toReal
  have hA0 : 0 ≤ A0 := mul_nonneg (hB 0) ENNReal.toReal_nonneg
  have hmass : ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      (∫ eta : Euclidean 2, ‖S j t eta‖) ≤ A0 := by
    intro j t ht htop
    apply integral_norm_le_of_support_subset_of_norm_le
      (S j t : Euclidean 2 → Complex) K hKmeas hKfinite
    · simpa using (S j t).integrable.norm
    · intro eta
      simpa using hderiv 0 j t eta ht htop
    · exact hsupport j t
  let A1 : Real := (2 : Real) ^ 4 * ∑ n ∈ Finset.range (4 + 1),
    B n * (volume K).toReal
  have hA1 : 0 ≤ A1 := by
    dsimp [A1]
    apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro n hn
    exact mul_nonneg (hB n) ENNReal.toReal_nonneg
  have hibp : ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      compactFourierIBPConstant (N := 4) (S j t : Euclidean 2 → Complex) ≤ A1 := by
    intro j t ht htop
    have hmain := compactFourierIBPConstant_le_of_support_subset_of_uniform_deriv_bound
      (S j t : Euclidean 2 → Complex) ((S j t).smooth 4)
      (R := (16 : Real)) (hsupport j t) B
      (fun n hn eta => hderiv n j t eta ht htop)
    simpa [A1, K] using hmain
  refine ⟨A0 + A1, add_nonneg hA0 hA1, ?_⟩
  intro j t ht htop
  calc
    relativeSchwartzMultiplierKernelSize (S j t) ≤
        (∫ eta : Euclidean 2, ‖S j t eta‖) +
          compactFourierIBPConstant (N := 4) (S j t : Euclidean 2 → Complex) :=
      relativeSchwartzMultiplierKernelSize_le_compactFourierIBP (S j t)
    _ ≤ A0 + A1 := add_le_add (hmass j t ht htop) (hibp j t ht htop)

