    normalizedCircleFinePacketCoreOperator I inputs (P j) χout χsrc b Γ (q j) m
      ε L hLp (L•(zO j : JointWaveSpaceTime))
      (fun i => L•(zS i : Euclidean 2)) (fun i => (f i : Euclidean 2 → Complex))
