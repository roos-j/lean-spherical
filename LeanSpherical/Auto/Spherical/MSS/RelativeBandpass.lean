  have hs : 0 < ((2 : Real) ^ j) ^ (n + 1) := by positivity
  rw [Real.norm_of_nonneg hs.le]
  have hmain := hbound j t rho ht hrho hrhotop
  calc
    ((2 : Real) ^ j) ^ (n + 1) *
        ‖iteratedDeriv k (middleScaledRadialAmplitude j t) rho‖ ≤
        ((2 : Real) ^ j) ^ (n + 1) *
          (A / ((2 : Real) ^ j) ^ (n + 1)) :=
      mul_le_mul_of_nonneg_left hmain hs.le
    _ = A := by field_simp

theorem
    exists_unif_norm_iteratedDeriv_middleRapidNormdScRadialAmplitudeTimeDeriv_le
    (n k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (t rho : Real),
      1 ≤ t → (1 / 4 : Real) ≤ rho → rho ≤ 16 →
