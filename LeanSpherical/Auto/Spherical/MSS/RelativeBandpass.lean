private theorem relativeMultiplier_directMiddleRapid_eq_scaled_middle
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Icc (1 : Real) 2) (f : SchwartzMap (Euclidean 2) Complex)
