  obtain ⟨A₁, hA₁, hibp⟩ :=
    exists_compactFourierIBPConstant_circleRelativeBandFatUnitFamily_le C
  refine ⟨A₀ + A₁, add_nonneg hA₀ hA₁, ?_⟩
  intro t
  calc
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (circleRelativeBandFatUnitFamily C t) ≤
        (∫ eta : Euclidean 2, ‖circleRelativeBandFatUnitFamily C t eta‖) +
          _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
            (circleRelativeBandFatUnitFamily C t : Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (circleRelativeBandFatUnitFamily C t)
    _ ≤ A₀ + A₁ := add_le_add (hmass t) (hibp t)

