        k

noncomputable def fixedDyadicFatBandpass
    (C : Auto.LittlewoodPaley.lpCutoffs 2) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fatDyadicBandpassPrototype C.cutoff)
    (Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0)

theorem fixedDyadicFatBandpass_apply
    (C : Auto.LittlewoodPaley.lpCutoffs 2) (eta : Euclidean 2) :
    fixedDyadicFatBandpass C eta =
      fatDyadicBandpassPrototype C.cutoff eta *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0 eta := by
  unfold fixedDyadicFatBandpass
  rw [SchwartzMap.smulLeftCLM_apply
    (fatDyadicBandpassPrototype C.cutoff).hasTemperateGrowth]
  rfl

noncomputable def directMiddleRapidSymbolFun
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex := fun eta =>
  ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
    (middleRapidNormalizedScaledRadialAmplitude r j t ‖eta‖ *
      fixedDyadicFatBandpass C eta)

private theorem directMiddleRapidSymbolFun_eventuallyEq_zero_at_zero
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    directMiddleRapidSymbolFun r C j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (by norm_num : (0 : Real) < 1)]
    with eta heta
  have hetaNorm : ‖eta‖ ≤ (2 : Real) ^ (0 : Nat) := by
    have hlt : ‖eta‖ < 1 := by
      simpa only [Metric.mem_ball, dist_zero_right] using heta
    norm_num
    exact hlt.le
  unfold directMiddleRapidSymbolFun
  rw [show fixedDyadicFatBandpass C eta =
      fatDyadicBandpassPrototype C.cutoff eta *
        Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff 0 eta by
      exact fixedDyadicFatBandpass_apply C eta]
  simp [Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C hetaNorm]

theorem contDiff_directMiddleRapidSymbolFun
    (r : Nat) (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (directMiddleRapidSymbolFun r C j t) := by
  rw [contDiff_iff_contDiffAt]
  intro eta
  by_cases heta : eta = 0
  · subst eta
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (directMiddleRapidSymbolFun_eventuallyEq_zero_at_zero r C j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun y : Euclidean 2 => ‖y‖) eta :=
      contDiffAt_norm Real heta
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun y : Euclidean 2 =>
