theorem iteratedDeriv_middleScaledRadialAmplitude (j k : Nat) (t : Real) :
    iteratedDeriv k (middleScaledRadialAmplitude j t) = fun rho =>
      (2 * Real.pi * t * (2 : Real) ^ j) ^ k •
        iteratedDeriv k (coordinateMiddleMeridianLocalizedIntegral 0)
          ((2 * Real.pi * t * (2 : Real) ^ j) * rho) := by
