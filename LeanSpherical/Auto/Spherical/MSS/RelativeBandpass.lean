      ENNReal.ofReal (C*M*h*L *
        (1+L*‖X+T•normalizedCircleRayNormal ε BA
          (circleDirection (y 0)) (circleDirectionDeriv (y 0)) -
          normalizedCircleRayTerminal ε (y 1) BA
