theorem lightRayKernel_decay_le_one {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N ≤ 1 := by
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hinner : 1 ≤ 1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖ := by
    nlinarith [mul_nonneg hinv (norm_nonneg (z.1 + z.2 • ω - y))]
  have hbase : (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ≤ 1 := by
    apply (inv_le_one₀ (lt_of_lt_of_le zero_lt_one hinner)).mpr
    exact hinner
  have hbase_nonneg : 0 ≤ (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ := by
    positivity
  exact pow_le_one₀ hbase_nonneg hbase

/-- The crude pointwise light-ray-kernel bound.  The sharp Kakeya estimate
uses the spatial concentration of this kernel; this elementary bound is used
only for finite bookkeeping. -/
theorem lightRayKernel_le_normalization {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    lightRayKernel δ N ω y z ≤ (δ⁻¹) ^ 2 := by
  unfold lightRayKernel
  have hnorm : 0 ≤ (δ⁻¹) ^ 2 := sq_nonneg _
  calc
    (δ⁻¹) ^ 2 * (1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖)⁻¹ ^ N ≤
        (δ⁻¹) ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left (lightRayKernel_decay_le_one hδ N ω y z) hnorm
    _ = (δ⁻¹) ^ 2 := mul_one _

/-- A measurable direction selection makes the literal terminal-variable
light-ray kernel strongly measurable.  This is the minimum analytic
regularity needed before a direction-linearized TT* row can be asserted
integrable; unit length alone does not provide it. -/
theorem aestronglyMeasurable_lightRayKernel_terminal_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (x : Euclidean 2) (t : Real) :
    AEStronglyMeasurable
      (fun y : Euclidean 2 => lightRayKernel δ N (direction y) y (x, t)) volume := by
  apply AEMeasurable.aestronglyMeasurable
  have hdir : AEMeasurable direction volume := hdirection.aemeasurable
  have hline : AEMeasurable (fun y : Euclidean 2 => x + t • direction y - y) volume := by
    change AEMeasurable ((fun _ : Euclidean 2 => x) + t • direction - id) volume
    exact (aemeasurable_const.add (hdir.const_smul t)).sub measurable_id.aemeasurable
  have hscaled : AEMeasurable (fun y : Euclidean 2 =>
      δ⁻¹ * ‖x + t • direction y - y‖) volume :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun y : Euclidean 2 =>
      1 + δ⁻¹ * ‖x + t • direction y - y‖) volume :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun y : Euclidean 2 =>
      (δ⁻¹) ^ 2 *
        ((fun y : Euclidean 2 =>
          1 + δ⁻¹ * ‖x + t • direction y - y‖)⁻¹ y) ^ N) volume
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- A measurable direction field remains sufficient after arbitrary measurable
coordinate substitutions.  This is the component-level form used to build
joint light-ray and TT* kernels. -/
theorem aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
    {α : Type*} [MeasurableSpace α] (ν : Measure α)
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (y x : α → Euclidean 2) (t : α → Real)
    (hdirection : AEStronglyMeasurable (fun a => direction (y a)) ν)
    (hy : AEMeasurable y ν) (hx : AEMeasurable x ν) (ht : AEMeasurable t ν) :
    AEStronglyMeasurable
      (fun a => lightRayKernel δ N (direction (y a)) (y a) (x a, t a)) ν := by
  apply AEMeasurable.aestronglyMeasurable
  have hline : AEMeasurable (fun a => x a + t a • direction (y a) - y a) ν :=
    (hx.add (ht.smul hdirection.aemeasurable)).sub hy
  have hscaled : AEMeasurable (fun a =>
      δ⁻¹ * ‖x a + t a • direction (y a) - y a‖) ν :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun a =>
      1 + δ⁻¹ * ‖x a + t a • direction (y a) - y a‖) ν :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun a =>
      (δ⁻¹) ^ 2 *
        ((fun a => 1 + δ⁻¹ * ‖x a + t a • direction (y a) - y a‖)⁻¹ a) ^ N) ν
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- A measurable terminal-direction selector gives a jointly measurable
light-ray kernel in the terminal and space-time variables. -/
theorem aestronglyMeasurable_lightRayKernel_joint_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) :
    AEStronglyMeasurable
      (fun p : Euclidean 2 × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1) p.1 p.2)
      (volume.prod μ) := by
  apply AEMeasurable.aestronglyMeasurable
  have hdirection' : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      direction p.1) (volume.prod μ) :=
    hdirection.aemeasurable.comp_fst
  have hx : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.2.1)
      (volume.prod μ) :=
    (measurable_fst.comp measurable_snd).aemeasurable
  have ht : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.2.2)
      (volume.prod μ) :=
    (measurable_snd.comp measurable_snd).aemeasurable
  have hy : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime => p.1)
      (volume.prod μ) :=
    measurable_fst.aemeasurable
  have hline : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      p.2.1 + p.2.2 • direction p.1 - p.1) (volume.prod μ) :=
    (hx.add (ht.smul hdirection')).sub hy
  have hscaled : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖) (volume.prod μ) :=
    hline.norm.const_mul δ⁻¹
  have hbase : AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      1 + δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖) (volume.prod μ) :=
    aemeasurable_const.add hscaled
  change AEMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      (δ⁻¹) ^ 2 *
        ((fun p : Euclidean 2 × WaveSpaceTime =>
          1 + δ⁻¹ * ‖p.2.1 + p.2.2 • direction p.1 - p.1‖)⁻¹ p) ^ N)
      (volume.prod μ)
  exact (hbase.inv.pow_const N).const_mul ((δ⁻¹) ^ 2)

/-- Fubini transposition for a direction-linearized light-ray kernel.  The
finite-integral premise is kept explicit: measurability alone does not prove
the Córdoba row estimate. -/
theorem integral_lightRayKernel_mul_transpose_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) [SFinite μ]
    (endpointWeight : Euclidean 2 → Real) (spaceTimeWeight : WaveSpaceTime → Real)
    (hEndpoint : AEStronglyMeasurable endpointWeight volume)
    (hSpaceTime : AEStronglyMeasurable spaceTimeWeight μ)
    (hfinite : HasFiniteIntegral (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ)) :
    (∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
      lightRayKernel δ N (direction y) y z * endpointWeight y * spaceTimeWeight z ∂μ) =
      ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
        lightRayKernel δ N (direction y) y z * endpointWeight y *
          spaceTimeWeight z ∂volume ∂μ := by
  have hmeas : AEStronglyMeasurable (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ) :=
    ((aestronglyMeasurable_lightRayKernel_joint_of_aestronglyMeasurable_direction
      δ N direction hdirection μ).mul (hEndpoint.comp_fst)).mul hSpaceTime.comp_snd
  have hprod : Integrable (fun p : Euclidean 2 × WaveSpaceTime =>
      lightRayKernel δ N (direction p.1) p.1 p.2 * endpointWeight p.1 *
        spaceTimeWeight p.2) (volume.prod μ) :=
    ⟨hmeas, hfinite⟩
  simpa only [Function.uncurry] using
    (integral_integral_swap (μ := volume) (ν := μ)
      (f := fun y : Euclidean 2 => fun z : WaveSpaceTime =>
        lightRayKernel δ N (direction y) y z * endpointWeight y * spaceTimeWeight z)
      hprod)

/-- The literal product kernel in the light-ray TT* calculation is jointly
measurable as soon as the terminal direction selector is measurable. -/
theorem aestronglyMeasurable_lightRayTTStarIntegrand_of_aestronglyMeasurable_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) :
    AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.1) p.1.1 p.2 *
          lightRayKernel δ N (direction p.1.2) p.1.2 p.2)
      ((volume.prod volume).prod μ) := by
  have hfirst : AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.1) p.1.1 p.2)
      ((volume.prod volume).prod μ) := by
    apply aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
      ((volume.prod volume).prod μ) δ N direction
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.1.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.2)
    · exact (hdirection.comp_fst).comp_fst
    · exact (measurable_fst.comp measurable_fst).aemeasurable
    · exact (measurable_fst.comp measurable_snd).aemeasurable
    · exact (measurable_snd.comp measurable_snd).aemeasurable
  have hsecond : AEStronglyMeasurable
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime =>
        lightRayKernel δ N (direction p.1.2) p.1.2 p.2)
      ((volume.prod volume).prod μ) := by
    apply aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
      ((volume.prod volume).prod μ) δ N direction
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.1.2)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.1)
      (fun p : (Euclidean 2 × Euclidean 2) × WaveSpaceTime => p.2.2)
    · exact (hdirection.comp_snd).comp_fst
    · exact (measurable_snd.comp measurable_fst).aemeasurable
    · exact (measurable_fst.comp measurable_snd).aemeasurable
    · exact (measurable_snd.comp measurable_snd).aemeasurable
  exact hfirst.mul hsecond

/-- Integrating the jointly measurable TT* product produces a measurable
terminal-pair kernel under the usual sigma-finiteness hypothesis. -/
theorem aestronglyMeas_lightRayTTStarIntersectionProduct_of_aestronglyMeas_direction
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (hdirection : AEStronglyMeasurable direction volume)
    (μ : Measure WaveSpaceTime) [SFinite μ] :
    AEStronglyMeasurable
      (fun q : Euclidean 2 × Euclidean 2 => ∫ z : WaveSpaceTime,
        lightRayKernel δ N (direction q.1) q.1 z *
          lightRayKernel δ N (direction q.2) q.2 z ∂μ)
      (volume.prod volume) := by
  exact
    (aestronglyMeasurable_lightRayTTStarIntegrand_of_aestronglyMeasurable_direction
      δ N direction hdirection μ).integral_prod_right'

/-- The literal smooth light-ray average.  Integration is over planar
space-time with its product Lebesgue measure. -/
noncomputable def lightRayAverage (δ : Real) (N : Nat)
    (ω y : Euclidean 2) (g : WaveSpaceTime → Complex) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖

/-- Smooth light-ray averages are nonnegative because both the kernel and
the absolute-value input are nonnegative. -/
theorem aux_lightRayAverage_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (g : WaveSpaceTime → Complex) :
    0 ≤ lightRayAverage δ N ω y g := by
  unfold lightRayAverage
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg (lightRayKernel_nonneg hδ N ω y (x, t)) (norm_nonneg _)

/-- The continuum planar light-ray maximal operator from the blueprint.
The later Nikodym--Kakeya theorem is precisely the non-elementary `L²`
estimate for this definition. -/
noncomputable def lightRayMaximal (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => sSup ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
    unitLightRayDirections)

/-- The literal directional supremum is nonnegative whenever it is bounded
above.  This elementary fact is what makes a multiplicative, rather than
additive, measurable near-maximizer possible. -/
theorem aux_lightRayMaximal_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (g : WaveSpaceTime → Complex)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    0 ≤ lightRayMaximal δ N g y := by
  have hle : lightRayAverage δ N aux_defaultLightRayDirection.1 y g ≤
      lightRayMaximal δ N g y := by
    unfold lightRayMaximal
    apply le_csSup (hbounded y)
    exact ⟨aux_defaultLightRayDirection.1, aux_defaultLightRayDirection.2, rfl⟩
  exact (aux_lightRayAverage_nonneg hδ N aux_defaultLightRayDirection.1 y g).trans hle

/-- The maximum over a finite part of the fixed dense direction family.
Unlike the sampled finite operator elsewhere in this file, its individual
averages are still the literal continuum light-ray integrals. -/
noncomputable def aux_lightRayDenseFiniteMaximum
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (directions : Finset Nat) (hdirections : directions.Nonempty) :
    Euclidean 2 → Real :=
  fun y => directions.sup' hdirections (fun n =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)

/-- Every finite dense-direction maximum lies below the literal directional
supremum, provided that supremum is bounded above. -/
theorem aux_lightRayDenseFiniteMaximum_le_lightRayMaximal
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (directions : Finset Nat) (hdirections : directions.Nonempty)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    aux_lightRayDenseFiniteMaximum δ N g directions hdirections y ≤
      lightRayMaximal δ N g y := by
  unfold aux_lightRayDenseFiniteMaximum lightRayMaximal
  apply Finset.sup'_le
  intro n hn
  apply le_csSup (hbounded y)
  exact ⟨(aux_lightRayDirectionDenseSequence n).1,
    (aux_lightRayDirectionDenseSequence n).2, rfl⟩

/-- The analytic continuity input for the compact-direction argument.  For
Schwartz data it should follow from dominated convergence; it is kept
separate here from the purely topological supremum reduction. -/
def aux_HasContinuousLightRayDirections (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Prop :=
  ∀ y : Euclidean 2,
    ContinuousOn (fun ω : Euclidean 2 => lightRayAverage δ N ω y g)
      unitLightRayDirections

/-- Directional continuity makes the set of light-ray averages bounded
above, by compactness of the unit circle. -/
theorem aux_bddAbove_lightRayAverages_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
      unitLightRayDirections) := by
  exact (aux_isCompact_unitLightRayDirections.image_of_continuousOn
    (hcont y)).bddAbove

/-- For each endpoint `y`, directional continuity on the compact unit circle
gives a direction realizing the literal `sSup` in `lightRayMaximal`.  This
is pointwise choice only; measurability of the chosen argmax is deliberately
not claimed here. -/
theorem aux_exists_lightRayPointwiseMaximizer_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    ∃ ω : Euclidean 2, ω ∈ unitLightRayDirections ∧
      lightRayMaximal δ N g y = lightRayAverage δ N ω y g := by
  rcases aux_isCompact_unitLightRayDirections.exists_isMaxOn
      ⟨aux_defaultLightRayDirection, aux_defaultLightRayDirection.property⟩
      (hcont y) with ⟨ω, hω, hmax⟩
  refine ⟨ω, hω, ?_⟩
  unfold lightRayMaximal
  apply IsGreatest.csSup_eq
  refine ⟨⟨ω, hω, rfl⟩, ?_⟩
  intro z hz
  rcases hz with ⟨ω', hω', rfl⟩
  exact hmax hω'

/-- A pointwise choice of a maximizing light-ray direction under the
continuity hypothesis.  It is not asserted measurable: the missing
measurable-maximum theorem is exactly the remaining selector issue. -/
noncomputable def aux_lightRayPointwiseMaximizer
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) : Euclidean 2 :=
  Classical.choose (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)

/-- The pointwise argmax belongs to the unit direction circle. -/
theorem aux_lightRayPointwiseMaximizer_mem
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    aux_lightRayPointwiseMaximizer δ N g hcont y ∈ unitLightRayDirections :=
  (Classical.choose_spec (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)).1

/-- The pointwise argmax realizes the literal light-ray directional
supremum. -/
theorem aux_lightRayPointwiseMaximizer_realizes
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    lightRayMaximal δ N g y =
      lightRayAverage δ N (aux_lightRayPointwiseMaximizer δ N g hcont y) y g :=
  (Classical.choose_spec (aux_exists_lightRayPointwiseMaximizer_of_continuity
    δ N g hcont y)).2

/-- Continuity in direction reduces the literal uncountable light-ray
supremum to the fixed countable dense family of unit directions.  This is
the usable finite-to-countable bridge when an exact measurable argmax is not
yet available. -/
theorem aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) :
    lightRayMaximal δ N g y =
      sSup (Set.range (fun n : Nat =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) := by
  let F : aux_lightRayDirection → Real := fun ω => lightRayAverage δ N ω.1 y g
  have hFcont : Continuous F := (hcont y).restrict
  have himage : F '' Set.univ =
      ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections) := by
    ext r
    constructor
    · intro hr
      rcases hr with ⟨ω, hω, hr⟩
      exact ⟨ω.1, ω.2, hr⟩
    · intro hr
      rcases hr with ⟨ω, hω, hr⟩
      exact ⟨⟨ω, hω⟩, Set.mem_univ _, hr⟩
  have hFbounded : BddAbove (F '' Set.univ) := by
    rw [himage]
    exact aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y
  have hsup := aux_csSup_eq_csSup_denseRange_of_continuous
    aux_lightRayDirectionDenseSequence
    aux_denseRange_lightRayDirectionDenseSequence F hFcont hFbounded
  unfold lightRayMaximal
  rw [← himage]
  simpa only [F] using hsup

/-- Once the countable dense directional averages are measurable in the
endpoint variable, directional continuity makes the literal light-ray
maximal function measurable.  This avoids needing a measurable argmax for
measurability of the supremum itself. -/
theorem aux_aemeasurable_lightRayMaximal_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : ∀ n : Nat,
      AEMeasurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g) volume) :
    AEMeasurable (lightRayMaximal δ N g) volume := by
  have hsupmeas : AEMeasurable (fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
      volume := AEMeasurable.iSup hmeas
  have heq : lightRayMaximal δ N g = fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g := by
    funext y
    rw [aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y,
      sSup_range]
  rw [heq]
  exact hsupmeas

/-- Measurable counterpart of the preceding countable-direction result. -/
theorem aux_measurable_lightRayMaximal_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (lightRayMaximal δ N g) := by
  have hsupmeas : Measurable (fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g) :=
    Measurable.iSup hmeas
  have heq : lightRayMaximal δ N g = fun y : Euclidean 2 =>
      ⨆ n : Nat, lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g := by
    funext y
    rw [aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y,
      sSup_range]
  rw [heq]
  exact hsupmeas

/-- The countable dense direction predicate used for a measurable
epsilon-linearization of the supremum. -/
def aux_lightRayEpsilonDirectionPredicate (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) (ε : Real) (n : Nat) (y : Euclidean 2) : Prop :=
  lightRayMaximal δ N g y <
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g + ε

/-- A positive additive tolerance is attained by one direction in the
fixed dense sequence. -/
theorem aux_exists_lightRayEpsilonDirection_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    ∃ n : Nat, aux_lightRayEpsilonDirectionPredicate δ N g ε n y := by
  let S : Set Real := Set.range (fun n : Nat =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
  have hSnonempty : S.Nonempty := Set.range_nonempty _
  have hSbounded : BddAbove S := by
    apply (aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y).mono
    intro a ha
    rcases ha with ⟨n, hn⟩
    rw [← hn]
    exact ⟨(aux_lightRayDirectionDenseSequence n).1,
      (aux_lightRayDirectionDenseSequence n).2, rfl⟩
  have hsup : lightRayMaximal δ N g y = sSup S := by
    simpa only [S] using
      aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y
  have hlt : lightRayMaximal δ N g y - ε < sSup S := by
    rw [← hsup]
    linarith
  rcases exists_lt_of_lt_csSup hSnonempty hlt with ⟨a, ha, hlt_a⟩
  rcases ha with ⟨n, hn⟩
  refine ⟨n, ?_⟩
  unfold aux_lightRayEpsilonDirectionPredicate
  rw [← hn] at hlt_a
  linarith

/-- The first dense direction whose average is within `ε` of the literal
supremum.  Unlike an exact argmax it is measurable once the countable
directional averages are measurable. -/
noncomputable def aux_lightRayEpsilonDirection
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) : Euclidean 2 → Euclidean 2 :=
  by
    classical
    exact fun y => (aux_lightRayDirectionDenseSequence
      (Nat.find (aux_exists_lightRayEpsilonDirection_of_continuity
        δ N g hcont ε hε y))).1

/-- The epsilon direction is always an admissible unit light-ray direction. -/
theorem aux_lightRayEpsilonDirection_mem
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    aux_lightRayEpsilonDirection δ N g hcont ε hε y ∈ unitLightRayDirections := by
  unfold aux_lightRayEpsilonDirection
  exact (aux_lightRayDirectionDenseSequence _).2

/-- The epsilon direction realizes the dense directional approximation at
every endpoint. -/
theorem aux_lightRayMaximal_lt_lightRayEpsilonDirection_add
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y <
      lightRayAverage δ N
        (aux_lightRayEpsilonDirection δ N g hcont ε hε y) y g + ε := by
  classical
  have hfind := Nat.find_spec
    (aux_exists_lightRayEpsilonDirection_of_continuity δ N g hcont ε hε y)
  simpa only [aux_lightRayEpsilonDirection,
    aux_lightRayEpsilonDirectionPredicate] using hfind

/-- The epsilon direction is Borel measurable when every fixed dense
directional average is Borel measurable.  This gives a fully constructive
measurable approximate linearization, without invoking a general measurable
maximum theorem. -/
theorem aux_measurable_lightRayEpsilonDirection_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (aux_lightRayEpsilonDirection δ N g hcont ε hε) := by
  classical
  have hmaxmeas : Measurable (lightRayMaximal δ N g) :=
    aux_measurable_lightRayMaximal_of_continuity δ N g hcont hmeas
  unfold aux_lightRayEpsilonDirection
  simpa only using (Measurable.find
    (fun n : Nat =>
      (measurable_const : Measurable (fun _ : Euclidean 2 =>
        (aux_lightRayDirectionDenseSequence n).1)))
    (fun n => by
      change MeasurableSet {y : Euclidean 2 |
        aux_lightRayEpsilonDirectionPredicate δ N g ε n y}
      unfold aux_lightRayEpsilonDirectionPredicate
      exact measurableSet_lt hmaxmeas ((hmeas n).add measurable_const))
    (fun y => aux_exists_lightRayEpsilonDirection_of_continuity
      δ N g hcont ε hε y))

/-- The countable dense direction predicate used for a multiplicative
measurable near-linearization.  The multiplicative form is the one that can
be passed directly through an `L²` estimate on the whole plane. -/
def aux_lightRayMultiplicativeDirectionPredicate (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) (ε : Real) (n : Nat) (y : Euclidean 2) : Prop :=
  lightRayMaximal δ N g y ≤ (1 + ε) *
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g

/-- For positive width and positive relative tolerance, a fixed countable
dense family contains a direction attaining a multiplicative approximation
to the continuum directional supremum at every endpoint. -/
theorem aux_exists_lightRayMultiplicativeDirection_of_continuity
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    ∃ n : Nat, aux_lightRayMultiplicativeDirectionPredicate δ N g ε n y := by
  let S : Set Real := Set.range (fun n : Nat =>
    lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)
  have hSnonempty : S.Nonempty := Set.range_nonempty _
  have hSbounded : BddAbove S := by
    apply (aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y).mono
    intro a ha
    rcases ha with ⟨n, hn⟩
    rw [← hn]
    exact ⟨(aux_lightRayDirectionDenseSequence n).1,
      (aux_lightRayDirectionDenseSequence n).2, rfl⟩
  have hsup : lightRayMaximal δ N g y = sSup S := by
    simpa only [S] using
      aux_lightRayMaximal_eq_csSup_denseDirections_of_continuity δ N g hcont y
  have hmaxnonneg : 0 ≤ lightRayMaximal δ N g y :=
    aux_lightRayMaximal_nonneg hδ N g
      (fun y => aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y) y
  by_cases hzero : lightRayMaximal δ N g y = 0
  · refine ⟨0, ?_⟩
    unfold aux_lightRayMultiplicativeDirectionPredicate
    rw [hzero]
    exact mul_nonneg (by linarith) (aux_lightRayAverage_nonneg hδ N
      (aux_lightRayDirectionDenseSequence 0).1 y g)
  · have hmaxpos : 0 < lightRayMaximal δ N g y :=
      lt_of_le_of_ne hmaxnonneg (Ne.symm hzero)
    have hone : 1 < 1 + ε := by linarith
    have hfactor : 0 < 1 + ε := by linarith
    have hdiv : lightRayMaximal δ N g y / (1 + ε) < lightRayMaximal δ N g y :=
      div_lt_self hmaxpos hone
    have hlt : lightRayMaximal δ N g y / (1 + ε) < sSup S := by
      rwa [← hsup]
    rcases exists_lt_of_lt_csSup hSnonempty hlt with ⟨a, ha, hlt_a⟩
    rcases ha with ⟨n, hn⟩
    refine ⟨n, ?_⟩
    unfold aux_lightRayMultiplicativeDirectionPredicate
    rw [← hn] at hlt_a
    have hmul : lightRayMaximal δ N g y <
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g * (1 + ε) :=
      (div_lt_iff₀ hfactor).mp hlt_a
    simpa only [mul_comm] using hmul.le

/-- The first countable dense direction achieving the multiplicative
approximation.  This is an explicit pointwise selector; no compact argmax
or abstract measurable-selection theorem is used. -/
noncomputable def aux_lightRayMultiplicativeDirection
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) : Euclidean 2 → Euclidean 2 :=
  by
    classical
    exact fun y => (aux_lightRayDirectionDenseSequence
      (Nat.find (aux_exists_lightRayMultiplicativeDirection_of_continuity
        hδ N g hcont ε hε y))).1

/-- The multiplicative selector only takes admissible unit directions. -/
theorem aux_lightRayMultiplicativeDirection_mem
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y ∈ unitLightRayDirections := by
  unfold aux_lightRayMultiplicativeDirection
  exact (aux_lightRayDirectionDenseSequence _).2

/-- Pointwise multiplicative approximation of the literal continuum
light-ray maximal function by its explicit selected direction. -/
theorem aux_lightRayMaximal_le_lightRayMultiplicativeDirection_mul
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y ≤ (1 + ε) * lightRayAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y) y g := by
  classical
  have hfind := Nat.find_spec
    (aux_exists_lightRayMultiplicativeDirection_of_continuity hδ N g hcont ε hε y)
  simpa only [aux_lightRayMultiplicativeDirection,
    aux_lightRayMultiplicativeDirectionPredicate] using hfind

/-- The multiplicative selector is Borel measurable when the countable
fixed-direction averages are Borel measurable. -/
theorem aux_measurable_lightRayMultiplicativeDirection_of_continuity
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε)
    (hmeas : ∀ n : Nat,
      Measurable (fun y : Euclidean 2 =>
        lightRayAverage δ N (aux_lightRayDirectionDenseSequence n).1 y g)) :
    Measurable (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) := by
  classical
  have hmaxmeas : Measurable (lightRayMaximal δ N g) :=
    aux_measurable_lightRayMaximal_of_continuity δ N g hcont hmeas
  unfold aux_lightRayMultiplicativeDirection
  simpa only using (Measurable.find
    (fun n : Nat =>
      (measurable_const : Measurable (fun _ : Euclidean 2 =>
        (aux_lightRayDirectionDenseSequence n).1)))
    (fun n => by
      change MeasurableSet {y : Euclidean 2 |
        aux_lightRayMultiplicativeDirectionPredicate δ N g ε n y}
      unfold aux_lightRayMultiplicativeDirectionPredicate
      exact measurableSet_le hmaxmeas
        (measurable_const.mul (hmeas n)))
    (fun y => aux_exists_lightRayMultiplicativeDirection_of_continuity
      hδ N g hcont ε hε y))

/-- At each endpoint and positive tolerance, a finite subfamily of the
fixed dense directions approximates the literal directional supremum from
below.  The finite family may depend on the endpoint and tolerance; this is
the precise pointwise finite-net statement, without an unproved measurable
selection assertion. -/
theorem aux_exists_lightRayDenseFiniteApproximation_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (y : Euclidean 2) (η : Real) (hη : 0 < η) :
    ∃ (directions : Finset Nat) (hdirections : directions.Nonempty),
      lightRayMaximal δ N g y ≤
        aux_lightRayDenseFiniteMaximum δ N g directions hdirections y + η := by
  rcases aux_exists_lightRayPointwiseMaximizer_of_continuity δ N g hcont y with
    ⟨ω, hω, hmax⟩
  let ω₀ : aux_lightRayDirection := ⟨ω, hω⟩
  let F : aux_lightRayDirection → Real := fun ω' => lightRayAverage δ N ω'.1 y g
  have hFcont : Continuous F := (hcont y).restrict
  have hFat : ContinuousAt F ω₀ := hFcont.continuousAt
  rcases (Metric.continuousAt_iff.mp hFat η hη) with ⟨ε, hε, hclose⟩
  rcases aux_exists_finiteNet_lightRayDirectionDenseSequence ε hε with
    ⟨directions, hnet⟩
  rcases hnet ω₀ with ⟨n, hn, hndist⟩
  have hdirections : directions.Nonempty := ⟨n, hn⟩
  refine ⟨directions, hdirections, ?_⟩
  have hdist : dist (aux_lightRayDirectionDenseSequence n) ω₀ < ε := by
    simpa only [dist_comm] using hndist
  have hvalueDist : dist (F (aux_lightRayDirectionDenseSequence n)) (F ω₀) < η :=
    hclose hdist
  have habs : |F (aux_lightRayDirectionDenseSequence n) - F ω₀| < η := by
    simpa only [Real.dist_eq] using hvalueDist
  have hsub : F ω₀ - F (aux_lightRayDirectionDenseSequence n) < η := by
    calc
      F ω₀ - F (aux_lightRayDirectionDenseSequence n) =
          -(F (aux_lightRayDirectionDenseSequence n) - F ω₀) := by ring
      _ ≤ |F (aux_lightRayDirectionDenseSequence n) - F ω₀| := neg_le_abs _
      _ < η := habs
  have hvalue : F ω₀ ≤ F (aux_lightRayDirectionDenseSequence n) + η := by
    linarith
  have hfinite : F (aux_lightRayDirectionDenseSequence n) ≤
      aux_lightRayDenseFiniteMaximum δ N g directions hdirections y := by
    unfold aux_lightRayDenseFiniteMaximum
    exact Finset.le_sup' (fun k =>
      lightRayAverage δ N (aux_lightRayDirectionDenseSequence k).1 y g) hn
  calc
    lightRayMaximal δ N g y = F ω₀ := by
      simpa only [F, ω₀] using hmax
    _ ≤ F (aux_lightRayDirectionDenseSequence n) + η := hvalue
    _ ≤ aux_lightRayDenseFiniteMaximum δ N g directions hdirections y + η :=
      by linarith

/-- A measurable-direction linearization of the light-ray average.  The
Nikodym maximal theorem is obtained by proving uniform `L²` bounds for such
linearizations and then passing to the directional supremum. -/
noncomputable def aux_lightRayLinearizedAverage (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => lightRayAverage δ N (direction y) y g

/-- Every admissible linearized ray average is pointwise below the literal
directional supremum, provided the latter set of values is bounded above.
The boundedness condition is kept explicit because `sSup` on the reals does
not supply it automatically. -/
theorem aux_lightRayLinearizedAverage_le_lightRayMaximal
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) (y : Euclidean 2) :
    aux_lightRayLinearizedAverage δ N direction g y ≤
      lightRayMaximal δ N g y := by
  unfold aux_lightRayLinearizedAverage lightRayMaximal
  apply le_csSup (hbounded y)
  exact ⟨direction y, hdirection y, rfl⟩

/-- The explicit measurable dense-direction selector gives a multiplicative
linearization of the literal continuum maximal function.  This is the
selection bridge needed for `L²`: unlike an additive error, its cost can be
sent to one globally on the infinite-measure endpoint space. -/
theorem aux_lightRayMaximal_le_one_add_mul_lightRayLinearizedAverage
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (y : Euclidean 2) :
    lightRayMaximal δ N g y ≤ (1 + ε) *
      aux_lightRayLinearizedAverage δ N
        (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g y := by
  simpa only [aux_lightRayLinearizedAverage] using
    aux_lightRayMaximal_le_lightRayMultiplicativeDirection_mul
      hδ N g hcont ε hε y

/-- The multiplicative selector transfers a linearized `L²` estimate to
the literal light-ray maximal function with its explicit `(1 + ε)` loss. -/
theorem aux_eLpNorm_lightRayMaximal_le_one_add_mul_linearized
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) :
    eLpNorm (lightRayMaximal δ N g) 2 volume ≤
      ENNReal.ofReal (1 + ε) *
        eLpNorm (aux_lightRayLinearizedAverage δ N
          (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g) 2 volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul
    (Filter.Eventually.of_forall fun y => ?_) 2
  have hmaxnonneg : 0 ≤ lightRayMaximal δ N g y :=
    aux_lightRayMaximal_nonneg hδ N g
      (fun y => aux_bddAbove_lightRayAverages_of_continuity δ N g hcont y) y
  have hlinearnonneg : 0 ≤ aux_lightRayLinearizedAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g y := by
    unfold aux_lightRayLinearizedAverage
    exact aux_lightRayAverage_nonneg hδ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε y) y g
  rw [Real.norm_eq_abs, abs_of_nonneg hmaxnonneg,
    Real.norm_eq_abs, abs_of_nonneg hlinearnonneg]
  exact aux_lightRayMaximal_le_one_add_mul_lightRayLinearizedAverage
    hδ N g hcont ε hε y

/-- If a constant bounds the selected linearization, the preceding theorem
gives the corresponding explicit approximate maximal `L²` bound. -/
theorem aux_eLpNorm_lightRayMaximal_le_one_add_mul_of_selected_bound
    {δ : Real} (hδ : 0 < δ) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (ε : Real) (hε : 0 < ε) (A : ENNReal)
    (hbound : eLpNorm (aux_lightRayLinearizedAverage δ N
      (aux_lightRayMultiplicativeDirection hδ N g hcont ε hε) g) 2 volume ≤ A) :
    eLpNorm (lightRayMaximal δ N g) 2 volume ≤ ENNReal.ofReal (1 + ε) * A := by
  refine (aux_eLpNorm_lightRayMaximal_le_one_add_mul_linearized
    hδ N g hcont ε hε).trans ?_
  simpa only [mul_comm] using mul_le_mul_left hbound (ENNReal.ofReal (1 + ε))

/-- A chosen direction realizes the directional supremum when it supplies
the reverse pointwise inequality.  This records the exact logical bridge
needed after proving estimates uniform in all direction-linearizations. -/
theorem aux_lightRayMaximal_eq_linearized_of_pointwise_le
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hselect : ∀ y : Euclidean 2,
      lightRayMaximal δ N g y ≤ aux_lightRayLinearizedAverage δ N direction g y) :
    lightRayMaximal δ N g = aux_lightRayLinearizedAverage δ N direction g := by
  funext y
  exact le_antisymm (hselect y)
    (aux_lightRayLinearizedAverage_le_lightRayMaximal δ N direction g
      hdirection hbounded y)

/-- The measurable-selection statement required to pass from uniform
linearized estimates to the literal directional supremum.  It is only a
target predicate: proving it needs continuity in the direction variable and
a measurable maximum/selection argument, neither of which is supplied by
the tube-overlap estimate itself. -/
def aux_HasLightRayExactSupremumLinearization (δ : Real) (N : Nat)
    (g : WaveSpaceTime → Complex) : Prop :=
  ∃ direction : Euclidean 2 → Euclidean 2,
    AEStronglyMeasurable direction volume ∧
    (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) ∧
    (∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections)) ∧
    (∀ᵐ y : Euclidean 2 ∂volume,
      lightRayMaximal δ N g y ≤ aux_lightRayLinearizedAverage δ N direction g y)

/-- If the pointwise compact argmax is additionally a.e. measurable,
continuity supplies the exact measurable supremum linearization used by the
linearized TT* argument.  Thus the only unproved selector ingredient is its
measurability, not pointwise attainment. -/
theorem aux_hasLightRayExactSupremumLinearization_of_continuity
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hcont : aux_HasContinuousLightRayDirections δ N g)
    (hmeas : AEStronglyMeasurable
      (aux_lightRayPointwiseMaximizer δ N g hcont) volume) :
    aux_HasLightRayExactSupremumLinearization δ N g := by
  refine ⟨aux_lightRayPointwiseMaximizer δ N g hcont, hmeas,
    aux_lightRayPointwiseMaximizer_mem δ N g hcont, ?_, ?_⟩
  · exact aux_bddAbove_lightRayAverages_of_continuity δ N g hcont
  · filter_upwards with y
    rw [aux_lightRayPointwiseMaximizer_realizes δ N g hcont y]
    rfl

/-- Under an exact measurable supremum linearization, the squared energy of
the literal maximal function is the squared energy of one admissible
linearization.  This is the final selector bridge; it does not claim that
such a selector has yet been constructed. -/
theorem aux_integral_sq_lightRayMaximal_eq_of_exactSupremumLinearization
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex)
    (hlinearize : aux_HasLightRayExactSupremumLinearization δ N g) :
    ∃ direction : Euclidean 2 → Euclidean 2,
      AEStronglyMeasurable direction volume ∧
      (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) ∧
      (∫ y, lightRayMaximal δ N g y ^ 2) =
        ∫ y, aux_lightRayLinearizedAverage δ N direction g y ^ 2 := by
  rcases hlinearize with ⟨direction, hmeas, hdirection, hbounded, hselect⟩
  refine ⟨direction, hmeas, hdirection, ?_⟩
  apply integral_congr_ae
  filter_upwards [hselect] with y hy
  have heq : lightRayMaximal δ N g y =
      aux_lightRayLinearizedAverage δ N direction g y :=
    le_antisymm hy
      (aux_lightRayLinearizedAverage_le_lightRayMaximal δ N direction g
        hdirection hbounded y)
  rw [heq]

/-- The exact TT* kernel for a linearized family of light-ray averages.  It
is the smooth intersection integral of the two light-ray tubes terminating
at `y` and `y'`; the time restriction is the same one used by
`lightRayAverage`. -/
noncomputable def aux_lightRayTTStarIntersection (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (y y' : Euclidean 2) : Real :=
  ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N (direction y) y (x, t) *
      lightRayKernel δ N (direction y') y' (x, t)

/-- The TT* tube-intersection kernel is symmetric.  This elementary fact is
why one Schur row estimate is also the corresponding column estimate in the
standard scalar TT* argument. -/
theorem aux_lightRayTTStarIntersection_symm (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (y y' : Euclidean 2) :
    aux_lightRayTTStarIntersection δ N direction y y' =
      aux_lightRayTTStarIntersection δ N direction y' y := by
  unfold aux_lightRayTTStarIntersection
  apply integral_congr_ae
  filter_upwards with t
  apply integral_congr_ae
  filter_upwards with x
  ring

/-- The smooth TT* intersection kernel is nonnegative for positive tube
width. -/
theorem aux_lightRayTTStarIntersection_nonneg {δ : Real} (hδ : 0 < δ)
    (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (y y' : Euclidean 2) :
    0 ≤ aux_lightRayTTStarIntersection δ N direction y y' := by
  unfold aux_lightRayTTStarIntersection
  apply integral_nonneg
  intro t
  apply integral_nonneg
  intro x
  exact mul_nonneg
    (lightRayKernel_nonneg hδ N (direction y) y (x, t))
    (lightRayKernel_nonneg hδ N (direction y') y' (x, t))

/-- The positive linear operator underlying a direction-linearized light-ray
average.  It is kept real-valued because the maximal operator acts on the
absolute value of its complex input. -/
noncomputable def aux_lightRayLinearizedOperator (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (f : WaveSpaceTime → Real) : Euclidean 2 → Real :=
  fun y => ∫ t in lightRayTimeInterval, ∫ x : Euclidean 2,
    lightRayKernel δ N (direction y) y (x, t) * f (x, t)

/-- The original positive linearization is exactly the real operator above
applied to the pointwise complex norm. -/
theorem aux_lightRayLinearizedAverage_eq_operator_norm (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (g : WaveSpaceTime → Complex) :
    aux_lightRayLinearizedAverage δ N direction g =
      aux_lightRayLinearizedOperator δ N direction (fun z => ‖g z‖) := rfl

/-- The bilinear form pairing the linearized light-ray operator with an
endpoint test function. -/
noncomputable def aux_lightRayLinearizedBilinear (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) (f : WaveSpaceTime → Real)
    (h : Euclidean 2 → Real) : Real :=
  ∫ y : Euclidean 2, aux_lightRayLinearizedOperator δ N direction f y * h y

/-- The quadratic form of the exact continuum TT* tube-intersection kernel. -/
noncomputable def aux_lightRayTTStarQuadratic (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2)
    (h : Euclidean 2 → Real) : Real :=
  ∫ y : Euclidean 2, ∫ y' : Euclidean 2,
    aux_lightRayTTStarIntersection δ N direction y y' * h y * h y'

/-- The exact geometric Schur input in the continuum TT* proof of the
planar light-ray maximal estimate.  The exponent three is the square of the
`(1 + |log δ|)^(3/2)` factor in `HasLightRayMaximalEstimate`.  This property
contains no analytic conclusion by definition: its proof is precisely the
remaining Córdoba tube-intersection argument. -/
def aux_HasLightRayTTStarIntersectionSchurEstimate : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ δ : Real, 0 < δ → δ < 1 / 2 →
      ∀ direction : Euclidean 2 → Euclidean 2,
        (∀ y : Euclidean 2, direction y ∈ unitLightRayDirections) →
        (∀ y : Euclidean 2,
          Integrable (fun y' : Euclidean 2 =>
            aux_lightRayTTStarIntersection δ N direction y y') volume) ∧
        ∀ y : Euclidean 2,
          ∫ y' : Euclidean 2,
            aux_lightRayTTStarIntersection δ N direction y y' ≤
              C ^ 2 * (1 + |Real.log δ|) ^ 3

/-- The scalar Schur calculation for a symmetric nonnegative kernel.  The
integrability assumptions are deliberately displayed: in the light-ray
application they are the Fubini/measurability part of the continuum TT*
argument, whereas the row bound is the genuinely geometric tube-overlap
input. -/
theorem aux_kernelQuadratic_le_of_symmetricSchur
    {X : Type*} [MeasurableSpace X] (μ : Measure X) [SFinite μ]
    (K : X → X → Real)
    (B : Real) (hKnonneg : ∀ x y, 0 ≤ K x y)
    (hKsymm : ∀ x y, K x y = K y x)
    (hrow : ∀ x, Integrable (K x) μ)
    (hrowbound : ∀ x, (∫ y, K x y ∂μ) ≤ B)
    (h : X → Real) (hh : Integrable (fun x => h x ^ 2) μ)
    (hquad : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 * h p.2) (μ.prod μ))
    (hleft : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 ^ 2) (μ.prod μ))
    (hright : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.2 ^ 2) (μ.prod μ)) :
    (∫ x, ∫ y, K x y * h x * h y ∂μ ∂μ) ≤
      B * ∫ x, h x ^ 2 ∂μ := by
  have hleft_bound :
      (∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) ≤
        B * ∫ x, h x ^ 2 ∂μ := by
    calc
      (∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) =
          ∫ x, ∫ y, K x y * h x ^ 2 ∂μ ∂μ :=
        integral_prod _ hleft
      _ ≤ ∫ x, B * h x ^ 2 ∂μ := by
        apply integral_mono hleft.integral_prod_left (hh.const_mul B)
        intro x
        change (∫ y, K x y * h x ^ 2 ∂μ) ≤ B * h x ^ 2
        rw [integral_mul_const_of_integrable (hrow x)]
        exact mul_le_mul_of_nonneg_right (hrowbound x) (sq_nonneg _)
      _ = B * ∫ x, h x ^ 2 ∂μ := by rw [integral_const_mul]
  have hright_bound :
      (∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) ≤
        B * ∫ x, h x ^ 2 ∂μ := by
    calc
      (∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) =
          ∫ x, ∫ y, K x y * h y ^ 2 ∂μ ∂μ :=
        integral_prod _ hright
      _ = ∫ y, ∫ x, K x y * h y ^ 2 ∂μ ∂μ :=
        integral_integral_swap hright
      _ ≤ ∫ y, B * h y ^ 2 ∂μ := by
        apply integral_mono hright.integral_prod_right (hh.const_mul B)
        intro y
        change (∫ x, K x y * h y ^ 2 ∂μ) ≤ B * h y ^ 2
        calc
          (∫ x, K x y * h y ^ 2 ∂μ) =
              ∫ x, K y x * h y ^ 2 ∂μ := by
            apply integral_congr_ae
            filter_upwards with x
            rw [hKsymm]
          _ = (∫ x, K y x ∂μ) * h y ^ 2 := by
            rw [integral_mul_const_of_integrable (hrow y)]
          _ ≤ B * h y ^ 2 :=
            mul_le_mul_of_nonneg_right (hrowbound y) (sq_nonneg _)
      _ = B * ∫ y, h y ^ 2 ∂μ := by rw [integral_const_mul]
  have hsum : Integrable (fun p : X × X =>
      K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) (μ.prod μ) :=
    hleft.add hright
  have hscaled : Integrable (fun p : X × X =>
      (1 / 2 : Real) *
        (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2)) (μ.prod μ) :=
    hsum.const_mul _
  have hpoint (p : X × X) :
      K p.1 p.2 * h p.1 * h p.2 ≤
        (1 / 2 : Real) *
          (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) := by
    have hsquare : 0 ≤ K p.1 p.2 * (h p.1 - h p.2) ^ 2 :=
      mul_nonneg (hKnonneg p.1 p.2) (sq_nonneg _)
    nlinarith
  have hquad_bound :
      (∫ p : X × X, K p.1 p.2 * h p.1 * h p.2 ∂(μ.prod μ)) ≤
        ∫ p : X × X, (1 / 2 : Real) *
          (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) ∂(μ.prod μ) :=
    integral_mono hquad hscaled hpoint
  calc
    (∫ x, ∫ y, K x y * h x * h y ∂μ ∂μ) =
        ∫ p : X × X, K p.1 p.2 * h p.1 * h p.2 ∂(μ.prod μ) :=
      (integral_prod _ hquad).symm
    _ ≤ ∫ p : X × X, (1 / 2 : Real) *
        (K p.1 p.2 * h p.1 ^ 2 + K p.1 p.2 * h p.2 ^ 2) ∂(μ.prod μ) :=
      hquad_bound
    _ = (1 / 2 : Real) *
        ((∫ p : X × X, K p.1 p.2 * h p.1 ^ 2 ∂(μ.prod μ)) +
          ∫ p : X × X, K p.1 p.2 * h p.2 ^ 2 ∂(μ.prod μ)) := by
      rw [integral_const_mul, integral_add hleft hright]
    _ ≤ (1 / 2 : Real) *
        (B * (∫ x, h x ^ 2 ∂μ) + B * (∫ x, h x ^ 2 ∂μ)) := by
      exact mul_le_mul_of_nonneg_left (add_le_add hleft_bound hright_bound) (by norm_num)
    _ = B * ∫ x, h x ^ 2 ∂μ := by ring

/-- Specialization of the scalar Schur calculation to the literal
light-ray tube-intersection kernel.  Only the displayed product
integrability hypotheses remain analytic; the row estimate is exactly the
geometric Kakeya input. -/
theorem aux_lightRayTTStarQuadratic_le_of_rowSchur {δ : Real} (hδ : 0 < δ)
    (N : Nat) (direction : Euclidean 2 → Euclidean 2) (B : Real)
    (hrow : ∀ y : Euclidean 2,
      Integrable (fun y' : Euclidean 2 =>
        aux_lightRayTTStarIntersection δ N direction y y') volume)
    (hrowbound : ∀ y : Euclidean 2,
      (∫ y' : Euclidean 2,
        aux_lightRayTTStarIntersection δ N direction y y') ≤ B)
    (h : Euclidean 2 → Real)
    (hh : Integrable (fun y => h y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 * h p.2)
      (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.2 ^ 2)
      (volume.prod volume)) :
    aux_lightRayTTStarQuadratic δ N direction h ≤
      B * ∫ y, h y ^ 2 := by
  unfold aux_lightRayTTStarQuadratic
  exact aux_kernelQuadratic_le_of_symmetricSchur volume
    (aux_lightRayTTStarIntersection δ N direction) B
    (fun y y' => aux_lightRayTTStarIntersection_nonneg hδ N direction y y')
    (aux_lightRayTTStarIntersection_symm δ N direction) hrow hrowbound h hh
    hquad hleft hright

/-- The global geometric Schur predicate supplies the preceding quadratic
bound with its stated logarithmic constant. -/
theorem aux_lightRayTTStarQuadratic_le_of_HasLightRayTTStarIntersectionSchurEstimate
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (h : Euclidean 2 → Real)
    (hh : Integrable (fun y => h y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 * h p.2)
      (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 * h p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      aux_lightRayTTStarQuadratic δ N direction h ≤
        (C ^ 2 * (1 + |Real.log δ|) ^ 3) * ∫ y, h y ^ 2 := by
  rcases hSchur N hN with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  rcases hCbound δ hδ hδsmall direction hdirection with ⟨hrow, hrowbound⟩
  exact aux_lightRayTTStarQuadratic_le_of_rowSchur hδ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) hrow hrowbound h hh hquad hleft hright

/-- The precise Cauchy--Schwarz/Fubini identity needed to pass from the
linearized operator to its TT* intersection kernel.  This is not assumed by
the geometric Schur predicate: it isolates the remaining analytic
factorization in a form that can be proved once joint measurability of a
chosen direction field is available. -/
def aux_HasLightRayLinearizedTTStarCauchy (δ : Real) (N : Nat)
    (direction : Euclidean 2 → Euclidean 2) : Prop :=
  ∀ (f : WaveSpaceTime → Real) (h : Euclidean 2 → Real),
    Integrable (fun z => f z ^ 2) volume →
    Integrable (fun y => h y ^ 2) volume →
    |aux_lightRayLinearizedBilinear δ N direction f h| ^ 2 ≤
      (∫ z, f z ^ 2) * aux_lightRayTTStarQuadratic δ N direction h

/-- Once the exact TT* Cauchy factorization and the Schur quadratic bound
are available, the scalar cancellation argument gives the linearized
`L²` energy bound.  No maximal-function selection is used here. -/
theorem aux_lightRayLinearizedEnergy_le_of_ttStar
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (f : WaveSpaceTime → Real)
    (hf : Integrable (fun z => f z ^ 2) volume)
    (hout : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction f y ^ 2) volume)
    (hquadratic : aux_lightRayTTStarQuadratic δ N direction
      (aux_lightRayLinearizedOperator δ N direction f) ≤
        B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :
    (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
      B * ∫ z, f z ^ 2 := by
  have hin_nonneg : 0 ≤ ∫ z, f z ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hout_nonneg : 0 ≤ ∫ y,
      aux_lightRayLinearizedOperator δ N direction f y ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hdiagonal :
      aux_lightRayLinearizedBilinear δ N direction f
        (aux_lightRayLinearizedOperator δ N direction f) =
        ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2 := by
    simp only [aux_lightRayLinearizedBilinear, pow_two]
  have hCauchy := hTTStar f (aux_lightRayLinearizedOperator δ N direction f) hf hout
  rw [hdiagonal, abs_of_nonneg hout_nonneg] at hCauchy
  have hmult :
      (∫ z, f z ^ 2) *
          aux_lightRayTTStarQuadratic δ N direction
            (aux_lightRayLinearizedOperator δ N direction f) ≤
        (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :=
    mul_le_mul_of_nonneg_left hquadratic hin_nonneg
  have hsq :
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ^ 2 ≤
        (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) :=
    hCauchy.trans hmult
  by_cases hzero : (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) = 0
  · rw [hzero]
    exact mul_nonneg hB hin_nonneg
  · have hpos : 0 < ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2 :=
      lt_of_le_of_ne hout_nonneg (Ne.symm hzero)
    apply le_of_mul_le_mul_right _ hpos
    calc
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) *
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) =
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ^ 2 := by ring
      _ ≤ (∫ z, f z ^ 2) *
          (B * ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) := hsq
      _ = (B * ∫ z, f z ^ 2) *
          (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) := by ring

/-- Conversion of the squared-energy conclusion into the usual extended
`L²` norm.  The square-root constant is kept literal so this lemma is
independent of any later simplification of the logarithmic power. -/
theorem aux_eLpNorm_lightRayLinearizedOperator_le_of_energy
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B) (f : WaveSpaceTime → Real)
    (hf : MemLp f 2 volume)
    (hout : MemLp (aux_lightRayLinearizedOperator δ N direction f) 2 volume)
    (henergy : (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
      B * ∫ z, f z ^ 2) :
    eLpNorm (aux_lightRayLinearizedOperator δ N direction f) 2 volume ≤
      ENNReal.ofReal (Real.sqrt B) * eLpNorm f 2 volume := by
  let Iout : Real := ∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2
  let Iin : Real := ∫ z, f z ^ 2
  have hroot : Real.sqrt Iout ≤ Real.sqrt B * Real.sqrt Iin := by
    calc
      Real.sqrt Iout ≤ Real.sqrt (B * Iin) := Real.sqrt_le_sqrt (by
        simpa only [Iout, Iin] using henergy)
      _ = Real.sqrt B * Real.sqrt Iin := Real.sqrt_mul hB Iin
  have hrpow : Iout ^ (2 : Real)⁻¹ ≤
      Real.sqrt B * Iin ^ (2 : Real)⁻¹ := by
    rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow,
      ← Real.sqrt_eq_rpow]
    exact hroot
  have hnormout :
      eLpNorm (aux_lightRayLinearizedOperator δ N direction f) 2 volume =
        ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) := by
    rw [hout.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iout, Real.norm_eq_abs]
  have hnormin : eLpNorm f 2 volume =
      ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) := by
    rw [hf.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num [Iin, Real.norm_eq_abs]
  rw [hnormout, hnormin]
  calc
    ENNReal.ofReal (Iout ^ (2 : Real)⁻¹) ≤
        ENNReal.ofReal (Real.sqrt B * Iin ^ (2 : Real)⁻¹) :=
      ENNReal.ofReal_le_ofReal hrpow
    _ = ENNReal.ofReal (Real.sqrt B) *
        ENNReal.ofReal (Iin ^ (2 : Real)⁻¹) :=
      ENNReal.ofReal_mul (Real.sqrt_nonneg _)

/-- The preceding norm conversion in the original complex-input notation
for a light-ray linearized average. -/
theorem aux_eLpNorm_lightRayLinearizedAverage_le_of_energy
    (δ : Real) (N : Nat) (direction : Euclidean 2 → Euclidean 2)
    (B : Real) (hB : 0 ≤ B) (g : WaveSpaceTime → Complex)
    (hg : MemLp g 2 volume)
    (hout : MemLp (aux_lightRayLinearizedAverage δ N direction g) 2 volume)
    (henergy : (∫ y, aux_lightRayLinearizedAverage δ N direction g y ^ 2) ≤
      B * ∫ z, ‖g z‖ ^ 2) :
    eLpNorm (aux_lightRayLinearizedAverage δ N direction g) 2 volume ≤
      ENNReal.ofReal (Real.sqrt B) * eLpNorm g 2 volume := by
  have hgnorm : MemLp (fun z => ‖g z‖) 2 volume := by
    simpa using hg.norm
  simpa only [aux_lightRayLinearizedAverage_eq_operator_norm, eLpNorm_norm] using
    (aux_eLpNorm_lightRayLinearizedOperator_le_of_energy δ N direction B hB
      (fun z => ‖g z‖) hgnorm
      (by simpa only [aux_lightRayLinearizedAverage_eq_operator_norm] using hout)
      (by simpa only [aux_lightRayLinearizedAverage_eq_operator_norm] using henergy))

/-- The continuum TT* Schur predicate, together with its explicit
Fubini/Cauchy hypotheses, yields the stated logarithmic `L²` energy bound
for every measurable-direction linearization. -/
theorem aux_lightRayLinearizedEnergy_le_of_HasLightRayTTStarIntersectionSchurEstimate
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (f : WaveSpaceTime → Real)
    (hf : Integrable (fun z => f z ^ 2) volume)
    (hout : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction f y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.1 *
        aux_lightRayLinearizedOperator δ N direction f p.2) (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedOperator δ N direction f p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      (∫ y, aux_lightRayLinearizedOperator δ N direction f y ^ 2) ≤
        (C ^ 2 * (1 + |Real.log δ|) ^ 3) * ∫ z, f z ^ 2 := by
  rcases hSchur N hN with ⟨C, hC, hCbound⟩
  refine ⟨C, hC, ?_⟩
  rcases hCbound δ hδ hδsmall direction hdirection with ⟨hrow, hrowbound⟩
  refine aux_lightRayLinearizedEnergy_le_of_ttStar δ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) (by positivity) hTTStar f hf hout ?_
  exact aux_lightRayTTStarQuadratic_le_of_rowSchur hδ N direction
      (C ^ 2 * (1 + |Real.log δ|) ^ 3) hrow hrowbound
      (aux_lightRayLinearizedOperator δ N direction f) hout hquad hleft hright

/-- Direct extended-`L²` consequence of the continuum intersection Schur
predicate for one measurable-direction light-ray linearization.  The
square-root factor is exactly the TT* square root; the remaining hypotheses
are the explicitly exposed Fubini/Cauchy layer. -/
theorem aux_eLpNorm_lightRayLinearizedAverage_le_of_HasLightRayTTStarIntersectionSchurEst
    (hSchur : aux_HasLightRayTTStarIntersectionSchurEstimate)
    (N : Nat) (hN : 3 < N) {δ : Real} (hδ : 0 < δ) (hδsmall : δ < 1 / 2)
    (direction : Euclidean 2 → Euclidean 2)
    (hdirection : ∀ y : Euclidean 2, direction y ∈ unitLightRayDirections)
    (hTTStar : aux_HasLightRayLinearizedTTStarCauchy δ N direction)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    (hout : MemLp (aux_lightRayLinearizedAverage δ N direction g) 2 volume)
    (houtEnergy : Integrable (fun y =>
      aux_lightRayLinearizedAverage δ N direction g y ^ 2) volume)
    (hquad : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.1 *
        aux_lightRayLinearizedAverage δ N direction g p.2) (volume.prod volume))
    (hleft : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.1 ^ 2)
      (volume.prod volume))
    (hright : Integrable (fun p : Euclidean 2 × Euclidean 2 =>
      aux_lightRayTTStarIntersection δ N direction p.1 p.2 *
        aux_lightRayLinearizedAverage δ N direction g p.2 ^ 2)
      (volume.prod volume)) :
    ∃ C : Real, 0 < C ∧
      eLpNorm (aux_lightRayLinearizedAverage δ N direction g) 2 volume ≤
        ENNReal.ofReal
          (Real.sqrt (C ^ 2 * (1 + |Real.log δ|) ^ 3)) * eLpNorm g 2 volume := by
  have hgnorm : MemLp (fun z => ‖g z‖) 2 volume := by
    simpa using hg.norm
  have hinputEnergy : Integrable (fun z => ‖g z‖ ^ 2) volume := by
    have hsq := (memLp_two_iff_integrable_sq_norm hgnorm.aestronglyMeasurable).mp hgnorm
    simpa only [Real.norm_eq_abs, abs_of_nonneg (norm_nonneg _)] using hsq
  have houtOperator : Integrable (fun y =>
      aux_lightRayLinearizedOperator δ N direction (fun z => ‖g z‖) y ^ 2)
      volume := by
    simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using houtEnergy
  rcases aux_lightRayLinearizedEnergy_le_of_HasLightRayTTStarIntersectionSchurEstimate
      hSchur N hN hδ hδsmall direction hdirection hTTStar (fun z => ‖g z‖)
      hinputEnergy houtOperator
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hquad)
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hleft)
      (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using hright) with
      ⟨C, hC, henergy⟩
  refine ⟨C, hC, ?_⟩
  exact aux_eLpNorm_lightRayLinearizedAverage_le_of_energy δ N direction
    (C ^ 2 * (1 + |Real.log δ|) ^ 3) (by positivity) g hg hout
    (by simpa only [← aux_lightRayLinearizedAverage_eq_operator_norm] using henergy)

/-- The sharp planar Nikodym--Kakeya input required by the MSS proof.  This
is recorded as the exact quantitative target for the preceding continuum
operator; no instance is introduced here, since its proof is the remaining
non-elementary geometric stage. -/
def HasLightRayMaximalEstimate : Prop :=
  ∀ N : Nat, 3 < N → ∃ C : Real, 0 < C ∧
    ∀ δ : Real, 0 < δ → δ < 1 / 2 →
      ∀ g : WaveSpaceTime → Complex, MemLp g 2 volume →
        eLpNorm (lightRayMaximal δ N g) 2 volume ≤
          ENNReal.ofReal (C * (1 + |Real.log δ|) ^ (3 / 2 : Real)) *
            eLpNorm g 2 volume

/-- The exact boundary-width condition that puts the reciprocal fine-cube
spatial scale in the range of `HasLightRayMaximalEstimate`, uniformly for
every `scale ≥ 2`.  At the endpoint `scale = 2` this condition is also
necessary. -/
theorem cubeWidth_inv_mul_sqrt_pos_lt_half
    {cubeWidth scale : Real} (hwidth : 2 < cubeWidth * Real.sqrt 2)
    (hscale : 2 ≤ scale) :
    0 < (cubeWidth * Real.sqrt scale)⁻¹ ∧
      (cubeWidth * Real.sqrt scale)⁻¹ < 1 / 2 := by
  have hwidthPos : 0 < cubeWidth := by
    have hprod : 0 < cubeWidth * Real.sqrt 2 := by linarith
    rcases (mul_pos_iff.mp hprod) with hpositive | hnegative
    · exact hpositive.1
    · exact False.elim ((not_lt_of_ge (Real.sqrt_nonneg _)) hnegative.2)
  have hsqrtMono : Real.sqrt (2 : Real) ≤ Real.sqrt scale :=
    Real.sqrt_le_sqrt hscale
  have hproductMono : cubeWidth * Real.sqrt 2 ≤ cubeWidth * Real.sqrt scale :=
    mul_le_mul_of_nonneg_left hsqrtMono hwidthPos.le
  have hlarge : 2 < cubeWidth * Real.sqrt scale := hwidth.trans_le hproductMono
  have hproductPos : 0 < cubeWidth * Real.sqrt scale := by linarith
  constructor
  · exact inv_pos.mpr hproductPos
  · have hinv : (cubeWidth * Real.sqrt scale)⁻¹ < (2 : Real)⁻¹ :=
      (inv_lt_inv₀ hproductPos (by norm_num)).mpr hlarge
    simpa only [one_div] using hinv

/-!
The first elementary component of the angular Córdoba argument is a critical
one-dimensional Fourier-synthesis estimate.  It is deliberately stated only
for literal finite Fourier sums on `AddCircle`: connecting the light-ray
family to such sums requires the later dyadic angular analysis.
-/

private theorem aux_weighted_finset_abs_sum_sq_le
    {ι : Type*} (s : Finset ι) (w a : ι → Real)
    (hw : ∀ i ∈ s, 0 < w i) :
    (∑ i ∈ s, |a i|) ^ 2 ≤
      (∑ i ∈ s, (w i)⁻¹) * (∑ i ∈ s, w i * (a i) ^ 2) := by
  refine Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul s
    (r := fun i => |a i|) (f := fun i => (w i)⁻¹)
    (g := fun i => w i * (a i) ^ 2) ?_ ?_ ?_
  · intro i hi
    exact inv_nonneg.mpr (hw i hi).le
  · intro i hi
    exact mul_nonneg (hw i hi).le (sq_nonneg _)
  · intro i hi
    have hwi : w i ≠ 0 := ne_of_gt (hw i hi)
    simp [sq_abs, hwi]

private theorem aux_finite_fourier_critical_pointwise
    {ι : Type*} (s : Finset ι) (w : ι → Real)
    (coeff phase : ι → Complex)
    (hw : ∀ i ∈ s, 0 < w i)
    (hphase : ∀ i ∈ s, ‖phase i‖ = 1) :
    ‖∑ i ∈ s, coeff i * phase i‖ ^ 2 ≤
      (∑ i ∈ s, (w i)⁻¹) * (∑ i ∈ s, w i * ‖coeff i‖ ^ 2) := by
  have hnormsum :
      (∑ i ∈ s, ‖coeff i * phase i‖) = ∑ i ∈ s, ‖coeff i‖ := by
    apply Finset.sum_congr rfl
    intro i hi
    rw [norm_mul, hphase i hi, mul_one]
  calc
    ‖∑ i ∈ s, coeff i * phase i‖ ^ 2 ≤
        (∑ i ∈ s, ‖coeff i * phase i‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) (Finset.sum_nonneg fun _ _ => norm_nonneg _)).mpr
        (norm_sum_le _ _)
    _ = (∑ i ∈ s, ‖coeff i‖) ^ 2 := by rw [hnormsum]
    _ ≤ (∑ i ∈ s, (w i)⁻¹) * (∑ i ∈ s, w i * ‖coeff i‖ ^ 2) := by
      simpa only [abs_of_nonneg (norm_nonneg _)] using
        (aux_weighted_finset_abs_sum_sq_le s w (fun i => ‖coeff i‖) hw)

private theorem aux_harmonic_sum_range_le_one_add_log (M : Nat) :
    (∑ n ∈ Finset.range (M + 1), (1 + (n : Real))⁻¹) ≤
      1 + Real.log (1 + (M : Real)) := by
  have hanti : AntitoneOn (fun x : Real => (1 + x)⁻¹)
      (Set.Icc 0 (0 + (M : Real))) := by
    intro x hx y hy hxy
    apply inv_anti₀
    · linarith [hx.1]
    · linarith
  have hsum := hanti.sum_le_integral
  have hintegral : (∫ x : Real in 0..(M : Real), (1 + x)⁻¹) =
      Real.log (1 + (M : Real)) := by
    calc
      (∫ x : Real in 0..(M : Real), (1 + x)⁻¹) =
          ∫ x : Real in (0 : Real) + 1..(M : Real) + 1, x⁻¹ := by
            simpa only [add_comm] using
              (intervalIntegral.integral_comp_add_right (fun x : Real => x⁻¹)
                (a := (0 : Real)) (b := (M : Real)) 1)
      _ = Real.log (((M : Real) + 1) / ((0 : Real) + 1)) :=
        integral_inv_of_pos (by norm_num) (by positivity)
      _ = Real.log (1 + (M : Real)) := by ring_nf
  calc
    (∑ n ∈ Finset.range (M + 1), (1 + (n : Real))⁻¹) =
        1 + ∑ n ∈ Finset.range M, (1 + ((n + 1 : Nat) : Real))⁻¹ := by
          rw [Finset.sum_range_succ']
          norm_num
          ring
    _ ≤ 1 + ∫ x : Real in 0..(M : Real), (1 + x)⁻¹ := by
      have hsum' : (∑ n ∈ Finset.range M,
          (1 + ((n + 1 : Nat) : Real))⁻¹) ≤
          ∫ x : Real in 0..(M : Real), (1 + x)⁻¹ := by
        simpa only [zero_add, Nat.cast_add, Nat.cast_one] using hsum
      linarith
    _ = 1 + Real.log (1 + (M : Real)) := by rw [hintegral]

private theorem aux_oneSidedBandlimited_fourier_log
    (M : Nat) (coeff phase : Nat → Complex)
    (hphase : ∀ n ∈ Finset.range (M + 1), ‖phase n‖ = 1) :
    ‖∑ n ∈ Finset.range (M + 1), coeff n * phase n‖ ^ 2 ≤
      (1 + Real.log (1 + (M : Real))) *
        ∑ n ∈ Finset.range (M + 1), (1 + (n : Real)) * ‖coeff n‖ ^ 2 := by
  have hcritical := aux_finite_fourier_critical_pointwise
    (Finset.range (M + 1)) (fun n : Nat => 1 + (n : Real)) coeff phase
    (by
      intro n hn
      positivity) hphase
  calc
    ‖∑ n ∈ Finset.range (M + 1), coeff n * phase n‖ ^ 2 ≤
        (∑ n ∈ Finset.range (M + 1), (1 + (n : Real))⁻¹) *
          (∑ n ∈ Finset.range (M + 1),
            (1 + (n : Real)) * ‖coeff n‖ ^ 2) := hcritical
    _ ≤ (1 + Real.log (1 + (M : Real))) *
          (∑ n ∈ Finset.range (M + 1),
            (1 + (n : Real)) * ‖coeff n‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_right (aux_harmonic_sum_range_le_one_add_log M)
      exact Finset.sum_nonneg fun _ _ =>
        mul_nonneg (by positivity) (sq_nonneg _)

private theorem aux_addCircle_finiteFourier_critical_pointwise
    (T : Real) (s : Finset Int) (coeff : Int → Complex) (theta : AddCircle T) :
    ‖∑ n ∈ s, coeff n * fourier n theta‖ ^ 2 ≤
      (∑ n ∈ s, (1 + (Int.natAbs n : Real))⁻¹) *
        ∑ n ∈ s, (1 + (Int.natAbs n : Real)) * ‖coeff n‖ ^ 2 := by
  apply aux_finite_fourier_critical_pointwise s
    (fun n : Int => 1 + (Int.natAbs n : Real)) coeff
    (fun n : Int => fourier n theta)
  · intro n hn
    positivity
  · intro n hn
    rw [fourier_apply]
    exact Circle.norm_coe _

private theorem aux_addCircle_finiteFourier_critical_sup
    (T : Real) (s : Finset Int) (coeff : Int → Complex) :
    sSup ((fun theta : AddCircle T =>
      ‖∑ n ∈ s, coeff n * fourier n theta‖ ^ 2) '' Set.univ) ≤
      (∑ n ∈ s, (1 + (Int.natAbs n : Real))⁻¹) *
        ∑ n ∈ s, (1 + (Int.natAbs n : Real)) * ‖coeff n‖ ^ 2 := by
  apply csSup_le (Set.image_nonempty.mpr Set.univ_nonempty)
  intro z hz
  rcases hz with ⟨theta, -, rfl⟩
  exact aux_addCircle_finiteFourier_critical_pointwise T s coeff theta

/-- The real-linear isometry identifying complex numbers with the two
coordinates of `Euclidean 2`. -/
private noncomputable def aux_complexToEuclidean2 :
    Complex ≃ₗᵢ[Real] Euclidean 2 :=
  Complex.isometryOfOrthonormal (EuclideanSpace.basisFun (Fin 2) Real)

/-- Transport Mathlib's complex unit circle to the literal subtype used by
the light-ray maximal function. -/
private noncomputable def aux_circleToLightRayDirection :
    Circle → aux_lightRayDirection :=
  fun z => ⟨aux_complexToEuclidean2 z.1, by
    change ‖aux_complexToEuclidean2 z.1‖ = 1
    rw [aux_complexToEuclidean2.norm_map]
    exact Circle.norm_coe z⟩

private theorem aux_continuous_circleToLightRayDirection :
    Continuous aux_circleToLightRayDirection := by
  apply Continuous.subtype_mk
  exact aux_complexToEuclidean2.continuous.comp continuous_subtype_val

private theorem aux_surjective_circleToLightRayDirection :
    Function.Surjective aux_circleToLightRayDirection := by
  intro omega
  let z : Complex := aux_complexToEuclidean2.symm omega.1
  have hz : ‖z‖ = 1 := by
    dsimp only [z]
    rw [LinearIsometryEquiv.norm_map]
    exact omega.2
  let circlePoint : Circle :=
    ⟨z, mem_sphere_zero_iff_norm.mpr hz⟩
  refine ⟨circlePoint, ?_⟩
  apply Subtype.ext
  change aux_complexToEuclidean2 circlePoint.1 = omega.1
  change aux_complexToEuclidean2 z = omega.1
  exact aux_complexToEuclidean2.apply_symm_apply omega.1

/-- A global continuous and surjective angular parametrization of the literal
light-ray direction circle.  The later FIO argument still has to identify
the angular regularity of the light-ray family itself. -/
private noncomputable def aux_addCircleToLightRayDirection :
    AddCircle (2 * Real.pi) → aux_lightRayDirection :=
  aux_circleToLightRayDirection ∘ AddCircle.homeomorphCircle'

private theorem aux_continuous_addCircleToLightRayDirection :
    Continuous aux_addCircleToLightRayDirection :=
  aux_continuous_circleToLightRayDirection.comp
    AddCircle.homeomorphCircle'.continuous

private theorem aux_surjective_addCircleToLightRayDirection :
    Function.Surjective aux_addCircleToLightRayDirection :=
  aux_surjective_circleToLightRayDirection.comp
    AddCircle.homeomorphCircle'.surjective

/-- The literal direction supremum is exactly the supremum over the global
additive-circle parametrization.  This is set-theoretic and needs neither a
selector nor a Fourier-regularity assertion. -/
private theorem aux_lightRayMaximal_eq_addCircleSup
    (δ : Real) (N : Nat) (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    lightRayMaximal δ N g y =
      sSup ((fun theta : AddCircle (2 * Real.pi) =>
        lightRayAverage δ N (aux_addCircleToLightRayDirection theta).1 y g) ''
          Set.univ) := by
  unfold lightRayMaximal
  congr 1
  ext r
  constructor
  · rintro ⟨omega, homega, rfl⟩
    let omega' : aux_lightRayDirection := ⟨omega, homega⟩
    rcases aux_surjective_addCircleToLightRayDirection omega' with ⟨theta, htheta⟩
    refine ⟨theta, Set.mem_univ _, ?_⟩
    have hval : (aux_addCircleToLightRayDirection theta).1 = omega := by
      simpa only [omega'] using congrArg Subtype.val htheta
    exact congrArg (fun v : Euclidean 2 => lightRayAverage δ N v y g) hval
  · rintro ⟨theta, -, rfl⟩
    exact ⟨(aux_addCircleToLightRayDirection theta).1,
      (aux_addCircleToLightRayDirection theta).2, rfl⟩

/-- Integrated critical Sobolev bookkeeping for a literal finite angular
Fourier synthesis.  The hypotheses state precisely the integrability that a
later angular truncation must supply. -/
private theorem aux_addCircle_finiteFourier_critical_integral
    {X : Type*} [MeasurableSpace X] (mu : Measure X)
    (T : Real) (s : Finset Int) (coeff : X → Int → Complex)
    (hleft : Integrable (fun x : X =>
      sSup ((fun theta : AddCircle T =>
        ‖∑ n ∈ s, coeff x n * fourier n theta‖ ^ 2) '' Set.univ)) mu)
    (hcoeff : ∀ n ∈ s, Integrable (fun x : X =>
      (1 + (Int.natAbs n : Real)) * ‖coeff x n‖ ^ 2) mu) :
    (∫ x : X, sSup ((fun theta : AddCircle T =>
      ‖∑ n ∈ s, coeff x n * fourier n theta‖ ^ 2) '' Set.univ) ∂mu) ≤
      (∑ n ∈ s, (1 + (Int.natAbs n : Real))⁻¹) *
        ∑ n ∈ s, ∫ x : X,
          (1 + (Int.natAbs n : Real)) * ‖coeff x n‖ ^ 2 ∂mu := by
  let H : Real := ∑ n ∈ s, (1 + (Int.natAbs n : Real))⁻¹
  let E : X → Real := fun x => ∑ n ∈ s,
    (1 + (Int.natAbs n : Real)) * ‖coeff x n‖ ^ 2
  have hE : Integrable E mu := by
    dsimp only [E]
    exact integrable_finsetSum s hcoeff
  have hpoint : ∀ x : X,
      sSup ((fun theta : AddCircle T =>
        ‖∑ n ∈ s, coeff x n * fourier n theta‖ ^ 2) '' Set.univ) ≤
        H * E x := by
    intro x
    exact aux_addCircle_finiteFourier_critical_sup T s (coeff x)
  calc
    (∫ x : X, sSup ((fun theta : AddCircle T =>
      ‖∑ n ∈ s, coeff x n * fourier n theta‖ ^ 2) '' Set.univ) ∂mu) ≤
        ∫ x : X, H * E x ∂mu :=
      integral_mono hleft (hE.const_mul H) hpoint
    _ = H * ∫ x : X, E x ∂mu := by rw [integral_const_mul]
    _ = H * ∑ n ∈ s, ∫ x : X,
        (1 + (Int.natAbs n : Real)) * ‖coeff x n‖ ^ 2 ∂mu := by
      rw [integral_finsetSum s hcoeff]

private theorem sq_norm_integral_le_weightedEnergy
    (K : Euclidean 2 → Complex) (w : Euclidean 2 → Real)
    (hwpos : ∀ y, 0 < w y)
    (henergy : Integrable (fun y => (w y)⁻¹ * ‖K y‖ ^ 2) volume)
    (hmass : Integrable w volume) :
    ‖∫ y : Euclidean 2, K y‖ ^ 2 ≤
      (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        ∫ y : Euclidean 2, w y := by
  let F : Euclidean 2 → Real := fun y => Real.sqrt ((w y)⁻¹ * ‖K y‖ ^ 2)
  let G : Euclidean 2 → Real := fun y => Real.sqrt (w y)
  have hFmeas : AEStronglyMeasurable F volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable henergy.aestronglyMeasurable
  have hGmeas : AEStronglyMeasurable G volume := by
    exact Real.continuous_sqrt.comp_aestronglyMeasurable hmass.aestronglyMeasurable
  have hFsq : Integrable (fun y => F y ^ 2) volume := by
    refine henergy.congr ?_
    filter_upwards with y
    dsimp only [F]
    exact (Real.sq_sqrt (mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _))).symm
  have hGsq : Integrable (fun y => G y ^ 2) volume := by
    refine hmass.congr ?_
    filter_upwards with y
    dsimp only [G]
    exact (Real.sq_sqrt (hwpos y).le).symm
  have hFmem : MemLp F 2 volume :=
    (memLp_two_iff_integrable_sq hFmeas).mpr hFsq
  have hGmem : MemLp G 2 volume :=
    (memLp_two_iff_integrable_sq hGmeas).mpr hGsq
  have hFmem' : MemLp F (ENNReal.ofReal 2) volume := by
    norm_num
    exact hFmem
  have hGmem' : MemLp G (ENNReal.ofReal 2) volume := by
    norm_num
    exact hGmem
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg (f := F) (g := G)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun y => Real.sqrt_nonneg _)
    (Eventually.of_forall fun y => Real.sqrt_nonneg _) hFmem' hGmem'
  have hleft : (fun y : Euclidean 2 => ‖K y‖) = fun y => F y * G y := by
    funext y
    dsimp only [F, G]
    have hroot : Real.sqrt (w y) ≠ 0 := ne_of_gt (Real.sqrt_pos.2 (hwpos y))
    symm
    calc
      Real.sqrt ((w y)⁻¹ * ‖K y‖ ^ 2) * Real.sqrt (w y) =
          (Real.sqrt (w y))⁻¹ * Real.sqrt (‖K y‖ ^ 2) * Real.sqrt (w y) := by
        rw [Real.sqrt_mul (inv_nonneg.mpr (hwpos y).le), Real.sqrt_inv]
      _ = ‖K y‖ := by
        rw [Real.sqrt_sq (norm_nonneg _)]
        field_simp
  have hFint : (∫ y : Euclidean 2, F y ^ 2) =
      ∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2 := by
    apply integral_congr_ae
    filter_upwards with y
    dsimp only [F]
    exact Real.sq_sqrt (mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _))
  have hGint : (∫ y : Euclidean 2, G y ^ 2) = ∫ y : Euclidean 2, w y := by
    apply integral_congr_ae
    filter_upwards with y
    dsimp only [G]
    exact Real.sq_sqrt (hwpos y).le
  have hcs : ‖∫ y : Euclidean 2, K y‖ ≤
      Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        Real.sqrt (∫ y : Euclidean 2, w y) := by
    calc
      ‖∫ y : Euclidean 2, K y‖ ≤ ∫ y : Euclidean 2, ‖K y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, F y * G y := by rw [hleft]
      _ ≤ (∫ y : Euclidean 2, F y ^ (2 : Real)) ^ (1 / (2 : Real)) *
          (∫ y : Euclidean 2, G y ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
      _ = Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
          Real.sqrt (∫ y : Euclidean 2, w y) := by
        rw [show (fun y : Euclidean 2 => F y ^ (2 : Real)) = fun y => F y ^ 2 by
              funext y; rw [Real.rpow_two],
            show (fun y : Euclidean 2 => G y ^ (2 : Real)) = fun y => G y ^ 2 by
              funext y; rw [Real.rpow_two], hFint, hGint,
            Real.sqrt_eq_rpow, Real.sqrt_eq_rpow]
  have hright : 0 ≤ Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
      Real.sqrt (∫ y : Euclidean 2, w y) :=
    mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)
  calc
    ‖∫ y : Euclidean 2, K y‖ ^ 2 ≤
        (Real.sqrt (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
          Real.sqrt (∫ y : Euclidean 2, w y)) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hright).mpr hcs
    _ = (∫ y : Euclidean 2, (w y)⁻¹ * ‖K y‖ ^ 2) *
        ∫ y : Euclidean 2, w y := by
      rw [mul_pow, Real.sq_sqrt (integral_nonneg fun y =>
        mul_nonneg (inv_nonneg.mpr (hwpos y).le) (sq_nonneg _)),
        Real.sq_sqrt (integral_nonneg fun y => (hwpos y).le)]

private theorem lightRayKernel_pos {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (z : WaveSpaceTime) :
    0 < lightRayKernel δ N ω y z := by
  unfold lightRayKernel
  positivity

/-- A continuum kernel Cauchy--Schwarz bound for one localized fine piece. -/
theorem sq_norm_continuumFineKernelTerm_le_lightRayEnergy
    {δ A : Real} (hδ : 0 < δ) (N : Nat)
    (ω : Euclidean 2) (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (z : WaveSpaceTime) :
    ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 ≤
      A * ∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by
  have hInvInt : Integrable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume := by
    apply (henergy z).mono' (hmeas z)
    filter_upwards with y
    have hLpos : 0 < lightRayKernel δ N ω y z := lightRayKernel_pos hδ N ω y z
    have hKsquared : ‖kernel z y‖ ^ 2 ≤ (lightRayKernel δ N ω y z) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hLpos.le).mpr (hkernel z y)
    have hinner : (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
        lightRayKernel δ N ω y z := by
      calc
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
            (lightRayKernel δ N ω y z)⁻¹ * (lightRayKernel δ N ω y z) ^ 2 :=
          mul_le_mul_of_nonneg_left hKsquared (inv_nonneg.mpr hLpos.le)
        _ = lightRayKernel δ N ω y z := by
          field_simp [hLpos.ne']
    calc
      ‖(lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2‖ =
          (lightRayKernel δ N ω y z)⁻¹ * (‖kernel z y‖ ^ 2 * ‖input y‖ ^ 2) := by
        rw [Real.norm_eq_abs,
          abs_of_nonneg (mul_nonneg (inv_nonneg.mpr hLpos.le) (sq_nonneg _)), norm_mul]
        ring
      _ = ((lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2) * ‖input y‖ ^ 2 := by
        ring
      _ ≤ lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hinner (sq_nonneg _)
  have hbase := sq_norm_integral_le_weightedEnergy
    (fun y : Euclidean 2 => kernel z y * input y)
    (fun y : Euclidean 2 => lightRayKernel δ N ω y z)
    (fun y => lightRayKernel_pos hδ N ω y z) hInvInt (hmass z).1
  have hInvBound :
      (∫ y : Euclidean 2,
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) ≤
        ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by
    apply integral_mono hInvInt (henergy z)
    intro y
    have hLpos : 0 < lightRayKernel δ N ω y z := lightRayKernel_pos hδ N ω y z
    have hKsquared : ‖kernel z y‖ ^ 2 ≤ (lightRayKernel δ N ω y z) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hLpos.le).mpr (hkernel z y)
    have hinner : (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
        lightRayKernel δ N ω y z := by
      calc
        (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2 ≤
            (lightRayKernel δ N ω y z)⁻¹ * (lightRayKernel δ N ω y z) ^ 2 :=
          mul_le_mul_of_nonneg_left hKsquared (inv_nonneg.mpr hLpos.le)
        _ = lightRayKernel δ N ω y z := by
          field_simp [hLpos.ne']
    calc
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2 =
          ((lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y‖ ^ 2) * ‖input y‖ ^ 2 := by
        rw [norm_mul]
        ring
      _ ≤ lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
        mul_le_mul_of_nonneg_right hinner (sq_nonneg _)
  have hMassNonneg : 0 ≤ ∫ y : Euclidean 2, lightRayKernel δ N ω y z :=
    integral_nonneg fun y => lightRayKernel_nonneg hδ N ω y z
  have hEnergyNonneg : 0 ≤ ∫ y : Euclidean 2,
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2 :=
    integral_nonneg fun y => mul_nonneg (lightRayKernel_nonneg hδ N ω y z) (sq_nonneg _)
  calc
    ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 ≤
        (∫ y : Euclidean 2,
          (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) *
          ∫ y : Euclidean 2, lightRayKernel δ N ω y z := hbase
    _ ≤ (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) *
          ∫ y : Euclidean 2, lightRayKernel δ N ω y z :=
      mul_le_mul_of_nonneg_right hInvBound hMassNonneg
    _ ≤ (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * A :=
      mul_le_mul_of_nonneg_left (hmass z).2 hEnergyNonneg
    _ = A * ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 := by ring

/-- The product measure corresponding to the literal time-restricted
space-time integration in a light-ray average. -/
noncomputable def continuumLightRayMeasure : Measure WaveSpaceTime :=
  (volume : Measure (Euclidean 2)).prod
    ((volume : Measure Real).restrict lightRayTimeInterval)

private theorem integral_lightRayKernel_mul_norm_eq_lightRayAverage
    (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (g : WaveSpaceTime → Complex)
    (hprod : Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      lightRayKernel δ N ω y z * ‖g z‖ ∂continuumLightRayMeasure) =
      lightRayAverage δ N ω y g := by
  unfold continuumLightRayMeasure
  calc
    (∫ z : WaveSpaceTime,
        lightRayKernel δ N ω y z * ‖g z‖
        ∂(volume : Measure (Euclidean 2)).prod
          ((volume : Measure Real).restrict lightRayTimeInterval)) =
      ∫ x : Euclidean 2, ∫ t : Real in lightRayTimeInterval,
        lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖ :=
      integral_prod _ hprod
    _ = ∫ t : Real in lightRayTimeInterval, ∫ x : Euclidean 2,
        lightRayKernel δ N ω y (x, t) * ‖g (x, t)‖ :=
      integral_integral_swap hprod
    _ = lightRayAverage δ N ω y g := rfl

/-- The compact light-ray slab has no more mass than ambient space-time. -/
private theorem aux_continuumLightRayMeasure_le_volume :
    continuumLightRayMeasure ≤ (volume : Measure WaveSpaceTime) := by
  unfold continuumLightRayMeasure
  change (volume : Measure (Euclidean 2)).prod
      ((volume : Measure Real).restrict lightRayTimeInterval) ≤
    (volume : Measure (Euclidean 2)).prod (volume : Measure Real)
  exact Measure.prod_mono le_rfl Measure.restrict_le_self

/-- The compact-time light-ray kernel is in `L²` for every decay exponent
strictly bigger than one. -/
private theorem aux_memLp_two_lightRayKernel_spaceTime
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 1 < N)
    (ω y : Euclidean 2) :
    MemLp (fun z : WaveSpaceTime => lightRayKernel δ N ω y z) 2
      continuumLightRayMeasure := by
  have hmeas : AEStronglyMeasurable
      (fun z : WaveSpaceTime => lightRayKernel δ N ω y z)
      continuumLightRayMeasure := by
    simpa using
      (aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
        continuumLightRayMeasure δ N (fun _ : Euclidean 2 => ω)
        (fun _ : WaveSpaceTime => y) Prod.fst Prod.snd
        aestronglyMeasurable_const aemeasurable_const
        measurable_fst.aemeasurable measurable_snd.aemeasurable)
  apply (memLp_two_iff_integrable_sq hmeas).2
  unfold continuumLightRayMeasure
  exact aux_integrable_sq_lightRayKernel_spaceTime hδ N hN ω y

/-- Almost every point of the restricted product measure lies in its time
slab. -/
private theorem aux_ae_mem_lightRayTimeInterval :
    ∀ᵐ z : WaveSpaceTime ∂continuumLightRayMeasure,
      z.2 ∈ lightRayTimeInterval := by
  unfold continuumLightRayMeasure
  apply (Measure.ae_prod_iff_ae_ae ?_).2
  · filter_upwards with x
    exact ae_restrict_mem (by
      unfold lightRayTimeInterval
      exact measurableSet_Icc)
  · change MeasurableSet {z : Euclidean 2 × Real | z.2 ∈ lightRayTimeInterval}
    exact measurableSet_preimage measurable_snd (by
      unfold lightRayTimeInterval
      exact measurableSet_Icc)

/-- On the fixed time slab, all unit-direction kernels admit one integrable
zero-direction envelope. -/
private theorem aux_lightRayKernel_le_zeroDirection_envelope
    {δ : Real} (hδ : 0 < δ) (N : Nat) (ω y x : Euclidean 2) (t : Real)
    (hω : ‖ω‖ = 1) (ht : t ∈ lightRayTimeInterval) :
    lightRayKernel δ N ω y (x, t) ≤
      (1 + (5 / 2 : Real) * δ⁻¹) ^ N *
        lightRayKernel δ N 0 y (x, t) := by
  let r : Real := δ⁻¹ * ‖x + t • ω - y‖
  let R : Real := δ⁻¹ * ‖x - y‖
  let B : Real := (5 / 2 : Real) * δ⁻¹
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have ht0 : 0 ≤ t := by
    linarith [(mem_lightRayTimeInterval_iff t).mp ht |>.1]
  have htupper : t ≤ 5 / 2 := (mem_lightRayTimeInterval_iff t).mp ht |>.2
  have hnorm : ‖x - y‖ ≤ ‖x + t • ω - y‖ + 5 / 2 := by
    calc
      ‖x - y‖ = ‖(x + t • ω - y) - t • ω‖ := by
        congr 1
        module
      _ ≤ ‖x + t • ω - y‖ + ‖t • ω‖ := norm_sub_le _ _
      _ = ‖x + t • ω - y‖ + t := by
        rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht0, hω, mul_one]
      _ ≤ ‖x + t • ω - y‖ + 5 / 2 := by linarith
  have hR : R ≤ r + B := by
    dsimp only [r, R, B]
    have := mul_le_mul_of_nonneg_left hnorm hinv
    nlinarith
  have hr0 : 0 ≤ r := by
    dsimp only [r]
    positivity
  have hR0 : 0 ≤ R := by
    dsimp only [R]
    positivity
  have hB0 : 0 ≤ B := by
    dsimp only [B]
    positivity
  have hden : 1 + R ≤ (1 + B) * (1 + r) := by
    nlinarith [mul_nonneg hB0 hr0]
  have hdenpos : 0 < 1 + r := by linarith
  have hRpos : 0 < 1 + R := by linarith
  have hinvle : (1 + r)⁻¹ ≤ (1 + B) * (1 + R)⁻¹ := by
    have hdiv : 1 / (1 + r) ≤ (1 + B) / (1 + R) :=
      (div_le_div_iff₀ hdenpos hRpos).2 (by simpa using hden)
    simpa [one_div, div_eq_mul_inv] using hdiv
  have hpow : ((1 + r)⁻¹) ^ N ≤ ((1 + B) * (1 + R)⁻¹) ^ N := by
    exact pow_le_pow_left₀ (by positivity) hinvle N
  unfold lightRayKernel
  have hfinal : (δ⁻¹) ^ 2 * ((1 + r)⁻¹) ^ N ≤
      (1 + B) ^ N * ((δ⁻¹) ^ 2 * (1 + R)⁻¹ ^ N) := by
    calc
      (δ⁻¹) ^ 2 * ((1 + r)⁻¹) ^ N ≤
          (δ⁻¹) ^ 2 * ((1 + B) * (1 + R)⁻¹) ^ N :=
        mul_le_mul_of_nonneg_left hpow (sq_nonneg _)
      _ = (1 + B) ^ N * ((δ⁻¹) ^ 2 * (1 + R)⁻¹ ^ N) := by
        rw [mul_pow]
        ring
  simpa only [r, R, B, smul_zero, add_zero] using hfinal

private theorem aux_continuous_lightRayKernel_direction
    {δ : Real} (hδ : 0 < δ) (N : Nat)
    (y : Euclidean 2) (z : WaveSpaceTime) :
    Continuous (fun ω : Euclidean 2 => lightRayKernel δ N ω y z) := by
  unfold lightRayKernel
  have hline : Continuous (fun ω : Euclidean 2 => z.1 + z.2 • ω - y) := by
    fun_prop
  have hbase : Continuous (fun ω : Euclidean 2 =>
      1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖) :=
    continuous_const.add (continuous_const.mul hline.norm)
  refine continuous_const.mul ((Continuous.inv₀ hbase ?_).pow N)
  intro ω
  have hpos : 0 < 1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖ := by
    positivity
  exact hpos.ne'

private theorem aux_integrable_zeroDirection_envelope_mul_norm
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 1 < N)
    (y : Euclidean 2) (g : WaveSpaceTime → Complex)
    (hg : MemLp g 2 volume) :
    Integrable (fun z : WaveSpaceTime =>
      ((1 + (5 / 2 : Real) * δ⁻¹) ^ N * lightRayKernel δ N 0 y z) * ‖g z‖)
      continuumLightRayMeasure := by
  have hgslab : MemLp g 2 continuumLightRayMeasure :=
    hg.mono_measure aux_continuumLightRayMeasure_le_volume
  have hkernel : MemLp (fun z : WaveSpaceTime =>
      lightRayKernel δ N 0 y z) 2 continuumLightRayMeasure :=
    aux_memLp_two_lightRayKernel_spaceTime hδ N hN 0 y
  change Integrable
    ((fun z : WaveSpaceTime =>
      (1 + (5 / 2 : Real) * δ⁻¹) ^ N * lightRayKernel δ N 0 y z) *
      fun z : WaveSpaceTime => ‖g z‖)
    continuumLightRayMeasure
  exact (hkernel.const_mul ((1 + (5 / 2 : Real) * δ⁻¹) ^ N)).integrable_mul hgslab.norm

/-- `L²` space-time data already supplies the directional continuity needed
by the compact-circle selector construction. -/
theorem aux_hasContinuousLightRayDirections_of_memLp
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume) :
    aux_HasContinuousLightRayDirections δ N g := by
  intro y
  let bound : WaveSpaceTime → Real := fun z =>
    ((1 + (5 / 2 : Real) * δ⁻¹) ^ N * lightRayKernel δ N 0 y z) * ‖g z‖
  have hgslab : MemLp g 2 continuumLightRayMeasure :=
    hg.mono_measure aux_continuumLightRayMeasure_le_volume
  have hboundInt : Integrable bound continuumLightRayMeasure := by
    exact aux_integrable_zeroDirection_envelope_mul_norm hδ N hN y g hg
  have hmeas : ∀ ω ∈ unitLightRayDirections,
      AEStronglyMeasurable (fun z : WaveSpaceTime =>
        lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure := by
    intro ω hω
    exact
      (aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
        continuumLightRayMeasure δ N (fun _ : Euclidean 2 => ω)
        (fun _ : WaveSpaceTime => y) Prod.fst Prod.snd
        aestronglyMeasurable_const aemeasurable_const
        measurable_fst.aemeasurable measurable_snd.aemeasurable).mul
        hgslab.norm.aestronglyMeasurable
  have hbound : ∀ ω ∈ unitLightRayDirections,
      ∀ᵐ z : WaveSpaceTime ∂continuumLightRayMeasure,
        ‖lightRayKernel δ N ω y z * ‖g z‖‖ ≤ bound z := by
    intro ω hω
    filter_upwards [aux_ae_mem_lightRayTimeInterval] with z hz
    have hkernelNonneg : 0 ≤ lightRayKernel δ N ω y z :=
      lightRayKernel_nonneg hδ N ω y z
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hkernelNonneg (norm_nonneg _))]
    dsimp only [bound]
    exact mul_le_mul_of_nonneg_right
      (aux_lightRayKernel_le_zeroDirection_envelope hδ N ω y z.1 z.2
        ((mem_unitLightRayDirections_iff ω).mp hω) hz)
      (norm_nonneg _)
  have hcont : ∀ᵐ z : WaveSpaceTime ∂continuumLightRayMeasure,
      ContinuousOn (fun ω : Euclidean 2 =>
        lightRayKernel δ N ω y z * ‖g z‖) unitLightRayDirections := by
    filter_upwards with z
    exact
      ((aux_continuous_lightRayKernel_direction hδ N y z).mul continuous_const).continuousOn
  have hintegrable : ∀ ω : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure := by
    intro ω
    change Integrable
      ((fun z : WaveSpaceTime => lightRayKernel δ N ω y z) *
        fun z : WaveSpaceTime => ‖g z‖)
      continuumLightRayMeasure
    exact
      (aux_memLp_two_lightRayKernel_spaceTime hδ N hN ω y).integrable_mul hgslab.norm
  have hcontinuous : ContinuousOn (fun ω : Euclidean 2 =>
      ∫ z : WaveSpaceTime,
        lightRayKernel δ N ω y z * ‖g z‖ ∂continuumLightRayMeasure)
      unitLightRayDirections :=
    continuousOn_of_dominated hmeas hbound hboundInt hcont
  apply hcontinuous.congr
  intro ω hω
  exact (integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
    (hintegrable ω)).symm

/-- Moving the terminal point by at most one leaves a fixed-direction kernel
below an explicit integrable envelope based at the original terminal point. -/
private theorem aux_lightRayKernel_le_terminal_envelope
    {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y y₀ x : Euclidean 2) (t : Real)
    (hy : ‖y - y₀‖ ≤ 1) :
    lightRayKernel δ N ω y (x, t) ≤
      (1 + δ⁻¹) ^ N * lightRayKernel δ N ω y₀ (x, t) := by
  let r : Real := δ⁻¹ * ‖x + t • ω - y‖
  let R : Real := δ⁻¹ * ‖x + t • ω - y₀‖
  let B : Real := δ⁻¹
  have hinv : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδ.le
  have hnorm : ‖x + t • ω - y₀‖ ≤ ‖x + t • ω - y‖ + 1 := by
    calc
      ‖x + t • ω - y₀‖ = ‖(x + t • ω - y) + (y - y₀)‖ := by
        congr 1
        module
      _ ≤ ‖x + t • ω - y‖ + ‖y - y₀‖ := norm_add_le _ _
      _ ≤ ‖x + t • ω - y‖ + 1 := by linarith
  have hR : R ≤ r + B := by
    dsimp only [r, R, B]
    have := mul_le_mul_of_nonneg_left hnorm hinv
    linarith
  have hr0 : 0 ≤ r := by
    dsimp only [r]
    positivity
  have hR0 : 0 ≤ R := by
    dsimp only [R]
    positivity
  have hB0 : 0 ≤ B := by
    dsimp only [B]
    positivity
  have hden : 1 + R ≤ (1 + B) * (1 + r) := by
    nlinarith [mul_nonneg hB0 hr0]
  have hdenpos : 0 < 1 + r := by linarith
  have hRpos : 0 < 1 + R := by linarith
  have hinvle : (1 + r)⁻¹ ≤ (1 + B) * (1 + R)⁻¹ := by
    have hdiv : 1 / (1 + r) ≤ (1 + B) / (1 + R) :=
      (div_le_div_iff₀ hdenpos hRpos).2 (by simpa using hden)
    simpa [one_div, div_eq_mul_inv] using hdiv
  have hpow : ((1 + r)⁻¹) ^ N ≤ ((1 + B) * (1 + R)⁻¹) ^ N := by
    exact pow_le_pow_left₀ (by positivity) hinvle N
  unfold lightRayKernel
  have hfinal : (δ⁻¹) ^ 2 * ((1 + r)⁻¹) ^ N ≤
      (1 + B) ^ N * ((δ⁻¹) ^ 2 * (1 + R)⁻¹ ^ N) := by
    calc
      (δ⁻¹) ^ 2 * ((1 + r)⁻¹) ^ N ≤
          (δ⁻¹) ^ 2 * ((1 + B) * (1 + R)⁻¹) ^ N :=
        mul_le_mul_of_nonneg_left hpow (sq_nonneg _)
      _ = (1 + B) ^ N * ((δ⁻¹) ^ 2 * (1 + R)⁻¹ ^ N) := by
        rw [mul_pow]
        ring
  simpa only [r, R, B] using hfinal

private theorem aux_continuous_lightRayKernel_terminal
    {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω : Euclidean 2) (z : WaveSpaceTime) :
    Continuous (fun y : Euclidean 2 => lightRayKernel δ N ω y z) := by
  unfold lightRayKernel
  have hline : Continuous (fun y : Euclidean 2 => z.1 + z.2 • ω - y) := by
    fun_prop
  have hbase : Continuous (fun y : Euclidean 2 =>
      1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖) :=
    continuous_const.add (continuous_const.mul hline.norm)
  refine continuous_const.mul ((Continuous.inv₀ hbase ?_).pow N)
  intro y
  have hpos : 0 < 1 + δ⁻¹ * ‖z.1 + z.2 • ω - y‖ := by
    positivity
  exact hpos.ne'

/-- For a fixed direction, an `L²` input produces a continuous terminal
variable light-ray average. -/
theorem aux_continuous_lightRayAverage_terminal_of_memLp
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 1 < N)
    (ω : Euclidean 2) (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume) :
    Continuous (fun y : Euclidean 2 => lightRayAverage δ N ω y g) := by
  rw [continuous_iff_continuousAt]
  intro y₀
  let bound : WaveSpaceTime → Real := fun z =>
    ((1 + δ⁻¹) ^ N * lightRayKernel δ N ω y₀ z) * ‖g z‖
  have hgslab : MemLp g 2 continuumLightRayMeasure :=
    hg.mono_measure aux_continuumLightRayMeasure_le_volume
  have hkernel : MemLp (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y₀ z) 2 continuumLightRayMeasure :=
    aux_memLp_two_lightRayKernel_spaceTime hδ N hN ω y₀
  have hboundInt : Integrable bound continuumLightRayMeasure := by
    change Integrable
      ((fun z : WaveSpaceTime =>
        (1 + δ⁻¹) ^ N * lightRayKernel δ N ω y₀ z) *
        fun z : WaveSpaceTime => ‖g z‖)
      continuumLightRayMeasure
    exact (hkernel.const_mul ((1 + δ⁻¹) ^ N)).integrable_mul hgslab.norm
  have hmeas : ∀ᶠ y in 𝓝 y₀,
      AEStronglyMeasurable (fun z : WaveSpaceTime =>
        lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure := by
    filter_upwards with y
    exact
      (aestronglyMeasurable_lightRayKernel_of_aestronglyMeasurable_direction_comp
        continuumLightRayMeasure δ N (fun _ : Euclidean 2 => ω)
        (fun _ : WaveSpaceTime => y) Prod.fst Prod.snd
        aestronglyMeasurable_const aemeasurable_const
        measurable_fst.aemeasurable measurable_snd.aemeasurable).mul
        hgslab.norm.aestronglyMeasurable
  have hbound : ∀ᶠ y in 𝓝 y₀,
      ∀ᵐ z : WaveSpaceTime ∂continuumLightRayMeasure,
        ‖lightRayKernel δ N ω y z * ‖g z‖‖ ≤ bound z := by
    filter_upwards [Metric.ball_mem_nhds y₀ (by norm_num : (0 : Real) < 1)] with y hy
    have hy' : ‖y - y₀‖ ≤ 1 := by
      have hylt : dist y y₀ < 1 := (Metric.mem_ball.mp hy)
      simpa only [dist_eq_norm_sub] using hylt.le
    filter_upwards with z
    have hkernelNonneg : 0 ≤ lightRayKernel δ N ω y z :=
      lightRayKernel_nonneg hδ N ω y z
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hkernelNonneg (norm_nonneg _))]
    dsimp only [bound]
    exact mul_le_mul_of_nonneg_right
      (aux_lightRayKernel_le_terminal_envelope hδ N ω y y₀ z.1 z.2 hy')
      (norm_nonneg _)
  have hcont : ∀ᵐ z : WaveSpaceTime ∂continuumLightRayMeasure,
      ContinuousAt (fun y : Euclidean 2 =>
        lightRayKernel δ N ω y z * ‖g z‖) y₀ := by
    filter_upwards with z
    exact
      ((aux_continuous_lightRayKernel_terminal hδ N ω z).mul continuous_const).continuousAt
  have hintegrable : ∀ y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure := by
    intro y
    change Integrable
      ((fun z : WaveSpaceTime => lightRayKernel δ N ω y z) *
        fun z : WaveSpaceTime => ‖g z‖)
      continuumLightRayMeasure
    exact
      (aux_memLp_two_lightRayKernel_spaceTime hδ N hN ω y).integrable_mul hgslab.norm
  have hcontinuous : ContinuousAt (fun y : Euclidean 2 =>
      ∫ z : WaveSpaceTime,
        lightRayKernel δ N ω y z * ‖g z‖ ∂continuumLightRayMeasure) y₀ :=
    continuousAt_of_dominated hmeas hbound hboundInt hcont
  have hident : (fun y : Euclidean 2 =>
      ∫ z : WaveSpaceTime,
        lightRayKernel δ N ω y z * ‖g z‖ ∂continuumLightRayMeasure) =
      fun y : Euclidean 2 => lightRayAverage δ N ω y g := by
    funext y
    exact integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
      (hintegrable y)
  rw [← hident]
  exact hcontinuous

/-- The countable multiplicative selector is a.e. strongly measurable for
every `L²` input.  This closes the selector-side regularity needed before a
uniform linearized estimate can be applied. -/
theorem aux_aestronglyMeasurable_lightRayMultiplicativeDirection_of_memLp
    {δ : Real} (hδ : 0 < δ) (N : Nat) (hN : 1 < N)
    (g : WaveSpaceTime → Complex) (hg : MemLp g 2 volume)
    (ε : Real) (hε : 0 < ε) :
    AEStronglyMeasurable
      (aux_lightRayMultiplicativeDirection hδ N g
        (aux_hasContinuousLightRayDirections_of_memLp hδ N hN g hg) ε hε)
      volume := by
  apply Measurable.aestronglyMeasurable
  apply aux_measurable_lightRayMultiplicativeDirection_of_continuity hδ N g
    (aux_hasContinuousLightRayDirections_of_memLp hδ N hN g hg) ε hε
  intro n
  exact
    (aux_continuous_lightRayAverage_terminal_of_memLp hδ N hN
      (aux_lightRayDirectionDenseSequence n).1 g hg).measurable

private theorem integral_lightRayEnergy_transpose
    (δ : Real) (N : Nat) (ω : Euclidean 2)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (henergy : ∀ z : WaveSpaceTime, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume)) :
    (∫ z : WaveSpaceTime,
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
      ∂continuumLightRayMeasure) =
      ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
        (∫ z : WaveSpaceTime,
          lightRayKernel δ N ω y z * ‖g z‖
          ∂continuumLightRayMeasure) := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  calc
      (∫ z : WaveSpaceTime,
        (∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
        ∂continuumLightRayMeasure) =
        (∫ z : WaveSpaceTime, (∫ y : Euclidean 2,
          (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
          ∂continuumLightRayMeasure) := by
          apply integral_congr_ae
          filter_upwards with z
          rw [integral_mul_const_of_integrable (henergy z)]
    _ = (∫ y : Euclidean 2, (∫ z : WaveSpaceTime,
          (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure)) := integral_integral_swap hprod
    _ = ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := by
      apply integral_congr_ae
      filter_upwards with y
      calc
        (∫ z : WaveSpaceTime,
            (lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
            ∂continuumLightRayMeasure) =
            ∫ z : WaveSpaceTime,
              ‖input y‖ ^ 2 * (lightRayKernel δ N ω y z * ‖g z‖)
              ∂continuumLightRayMeasure := by
          apply integral_congr_ae
          filter_upwards with z
          ring
        _ = ‖input y‖ ^ 2 *
            (∫ z : WaveSpaceTime,
              lightRayKernel δ N ω y z * ‖g z‖
              ∂continuumLightRayMeasure) :=
          integral_const_mul _ _

/-- A genuine continuum version of the fine-cube kernel transposition step.
The hypotheses are the literal measurable/Fubini conditions required to turn
pointwise light-ray kernel localization into a weighted light-ray maximal
bound; no finite sampling or hidden Kakeya assertion is used. -/
theorem continuumFineKernelWeightedPairing_le_lightRayMaximal
    {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (ω : Euclidean 2) (hω : ω ∈ unitLightRayDirections)
    (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (htermWeighted : Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ y : Euclidean 2, Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hmaxWeighted : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayMaximal δ N g y) volume) :
    (∫ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) ≤
      A * ∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  have hpoint : ∀ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖ ≤
        (A * ∫ y : Euclidean 2,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖ := by
    intro z
    exact mul_le_mul_of_nonneg_right
      (sq_norm_continuumFineKernelTerm_le_lightRayEnergy hδ N ω kernel input
        hkernel hmass hmeas henergy z)
      (norm_nonneg _)
  have hrightInt : Integrable (fun z : WaveSpaceTime =>
      (A * ∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure := by
    simpa only [mul_assoc] using henergyWeighted.const_mul A
  have htranspose := integral_lightRayEnergy_transpose δ N ω input g henergy hprod
  have havgInt : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayAverage δ N ω y g) volume := by
    refine hprod.integral_prod_right.congr ?_
    filter_upwards with y
    calc
      (∫ z : WaveSpaceTime,
          lightRayKernel δ N ω y z * ‖input y‖ ^ 2 * ‖g z‖
          ∂continuumLightRayMeasure) =
          ∫ z : WaveSpaceTime,
            ‖input y‖ ^ 2 * (lightRayKernel δ N ω y z * ‖g z‖)
            ∂continuumLightRayMeasure := by
        apply integral_congr_ae
        filter_upwards with z
        ring
      _ = ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := integral_const_mul _ _
      _ = ‖input y‖ ^ 2 * lightRayAverage δ N ω y g := by
        rw [integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
          (hRayInt y)]
  have havgmax : ∀ y : Euclidean 2,
      lightRayAverage δ N ω y g ≤ lightRayMaximal δ N g y := by
    intro y
    unfold lightRayMaximal
    apply le_csSup (hbounded y)
    exact ⟨ω, hω, rfl⟩
  have hweightedMono :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayAverage δ N ω y g) ≤
        ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y := by
    apply integral_mono havgInt hmaxWeighted
    intro y
    exact mul_le_mul_of_nonneg_left (havgmax y) (sq_nonneg _)
  calc
    (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        ∫ z : WaveSpaceTime,
          (A * ∫ y : Euclidean 2,
            lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure :=
      integral_mono htermWeighted hrightInt hpoint
    _ = A * (∫ z : WaveSpaceTime,
          (∫ y : Euclidean 2,
            lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure) := by
      calc
        (∫ z : WaveSpaceTime,
            (A * ∫ y : Euclidean 2,
              lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
            ∂continuumLightRayMeasure) =
            ∫ z : WaveSpaceTime, A *
              ((∫ y : Euclidean 2,
                lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
              ∂continuumLightRayMeasure := by
          apply integral_congr_ae
          filter_upwards with z
          ring
        _ = A * (∫ z : WaveSpaceTime,
              (∫ y : Euclidean 2,
                lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖
              ∂continuumLightRayMeasure) := integral_const_mul _ _
    _ = A * ∫ y : Euclidean 2, ‖input y‖ ^ 2 *
          (∫ z : WaveSpaceTime,
            lightRayKernel δ N ω y z * ‖g z‖
            ∂continuumLightRayMeasure) := by rw [htranspose]
    _ = A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayAverage δ N ω y g := by
      congr 1
      apply integral_congr_ae
      filter_upwards with y
      rw [integral_lightRayKernel_mul_norm_eq_lightRayAverage δ N ω y g
        (hRayInt y)]
    _ ≤ A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y :=
      mul_le_mul_of_nonneg_left hweightedMono hA

/-- The finite set of piece--cube assignments.  Counting its fibers under
the second-coordinate map is the exact discrete form of reverse cube
overlap. -/
noncomputable def fineCubeAssignments {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) :
    Finset (Sigma fun _ : ι => κ) :=
  pieces.sigma cubeSets

/-- The assignments using a given cube.  Its cardinality counts the number
of radial/angular pieces to which that cube was assigned. -/
noncomputable def fineCubeAssignmentFiber {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (cube : κ) :
    Finset (Sigma fun _ : ι => κ) :=
  (fineCubeAssignments pieces cubeSets).filter (fun assignment => assignment.2 = cube)

/-- Reverse bounded overlap in a finite Fourier-cube decomposition.  This
is the literal combinatorial content of the second cardinality assertion in
the MSS cube-localization lemma. -/
def HasFiniteFineCubeReverseOverlap {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (B : Nat) : Prop :=
  ∀ cube ∈ pieces.biUnion cubeSets,
    (fineCubeAssignmentFiber pieces cubeSets cube).card ≤ B

/-- The finite-family form of
`continuumFineKernelWeightedPairing_le_lightRayMaximal`.

Each packet may have its own light-ray direction and kernel, while the
light-ray maximal function is shared.  The conclusion is obtained by applying
the one-packet transposition bound to every member of the finite family and
then exchanging the finite sums with the two integrals.  In particular, this
does not use a discretization of the light-ray maximal estimate. -/
theorem continuumFineKernelFiniteSumWeightedPairing_le_lightRayMaximal
    {ι : Type*} (s : Finset ι)
    {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (ω : ι → Euclidean 2)
    (hω : ∀ i ∈ s, ω i ∈ unitLightRayDirections)
    (kernel : ι → WaveSpaceTime → Euclidean 2 → Complex)
    (input : ι → Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hkernel : ∀ i ∈ s, ∀ z y,
      ‖kernel i z y‖ ≤ lightRayKernel δ N (ω i) y z)
    (hmass : ∀ i ∈ s, ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N (ω i) y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N (ω i) y z) ≤ A)
    (hmeas : ∀ i ∈ s, ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N (ω i) y z)⁻¹ * ‖kernel i z y * input i y‖ ^ 2)
      volume)
    (henergy : ∀ i ∈ s, ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N (ω i) y z * ‖input i y‖ ^ 2) volume)
    (htermWeighted : ∀ i ∈ s, Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : ∀ i ∈ s, Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N (ω i) y z * ‖input i y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : ∀ i ∈ s, Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N (ω i) p.2 p.1 * ‖input i p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ i ∈ s, ∀ y : Euclidean 2, Integrable
      (fun z : WaveSpaceTime => lightRayKernel δ N (ω i) y z * ‖g z‖)
      continuumLightRayMeasure)
    (hbounded : ∀ i ∈ s, ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hmaxWeighted : ∀ i ∈ s, Integrable (fun y : Euclidean 2 =>
      ‖input i y‖ ^ 2 * lightRayMaximal δ N g y) volume) :
    (∫ z : WaveSpaceTime,
      (∑ i ∈ s, ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2) * ‖g z‖
      ∂continuumLightRayMeasure) ≤
      A * ∫ y : Euclidean 2,
        (∑ i ∈ s, ‖input i y‖ ^ 2) * lightRayMaximal δ N g y := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  have hpacket : ∀ i ∈ s,
      (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        A * ∫ y : Euclidean 2,
          ‖input i y‖ ^ 2 * lightRayMaximal δ N g y := by
    intro i hi
    exact continuumFineKernelWeightedPairing_le_lightRayMaximal
      hδ hA N (ω i) (hω i hi) (kernel i) (input i) g
      (hkernel i hi) (hmass i hi) (hmeas i hi) (henergy i hi)
      (htermWeighted i hi) (henergyWeighted i hi) (hprod i hi)
      (hRayInt i hi) (hbounded i hi) (hmaxWeighted i hi)
  calc
    (∫ z : WaveSpaceTime,
      (∑ i ∈ s, ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2) * ‖g z‖
      ∂continuumLightRayMeasure) =
        ∫ z : WaveSpaceTime,
          ∑ i ∈ s, ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2 * ‖g z‖
          ∂continuumLightRayMeasure := by
      apply integral_congr_ae
      filter_upwards with z
      rw [Finset.sum_mul]
    _ = ∑ i ∈ s, ∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel i z y * input i y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure := by
      rw [integral_finsetSum s (fun i hi => htermWeighted i hi)]
    _ ≤ ∑ i ∈ s, A * ∫ y : Euclidean 2,
        ‖input i y‖ ^ 2 * lightRayMaximal δ N g y := by
      exact Finset.sum_le_sum fun i hi => hpacket i hi
    _ = A * (∑ i ∈ s, ∫ y : Euclidean 2,
        ‖input i y‖ ^ 2 * lightRayMaximal δ N g y) := by
      rw [Finset.mul_sum]
    _ = A * ∫ y : Euclidean 2,
        ∑ i ∈ s, ‖input i y‖ ^ 2 * lightRayMaximal δ N g y := by
      congr 1
      rw [integral_finsetSum s (fun i hi => hmaxWeighted i hi)]
    _ = A * ∫ y : Euclidean 2,
        (∑ i ∈ s, ‖input i y‖ ^ 2) * lightRayMaximal δ N g y := by
      congr 1
      apply integral_congr_ae
      filter_upwards with y
      rw [Finset.sum_mul]

/-- The pointwise square energy of a finite family of cube assignments.
The input is indexed only by the cube, not by the packet which uses it. -/
def continuumFineAssignedCubeSquareEnergy {ι κ X : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (input : κ → X → Complex) (x : X) : Real :=
  ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ‖input cube x‖ ^ 2

/-- The global pointwise square energy of the cubes used by a finite packet
family. -/
def continuumFineCubeSquareEnergy {ι κ X : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (input : κ → X → Complex) (x : X) : Real :=
  ∑ cube ∈ pieces.biUnion cubeSets, ‖input cube x‖ ^ 2

/-- The assigned cube square energy against a common real-valued weight. -/
def continuumFineAssignedCubeWeightedEnergy {ι κ X : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (input : κ → X → Complex) (weight : X → Real) : X → Real :=
  fun x => continuumFineAssignedCubeSquareEnergy pieces cubeSets input x * weight x

/-- The global cube square energy against a common real-valued weight. -/
def continuumFineCubeWeightedEnergy {ι κ X : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (input : κ → X → Complex) (weight : X → Real) : X → Real :=
  fun x => continuumFineCubeSquareEnergy pieces cubeSets input x * weight x

/-- Reverse bounded overlap collapses the pointwise assigned cube energy to
the global cube energy.  This is purely finite combinatorics and is
independent of packet kernels or the choice of spatial domain. -/
theorem continuumFineAssignedCubeSquareEnergy_le_reverseOverlap_mul
    {ι κ X : Type*} [DecidableEq κ] (pieces : Finset ι)
    (cubeSets : ι → Finset κ) (input : κ → X → Complex) (R : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets R) (x : X) :
    continuumFineAssignedCubeSquareEnergy pieces cubeSets input x ≤
      (R : Real) * continuumFineCubeSquareEnergy pieces cubeSets input x := by
  classical
  let E : κ → Real := fun cube => ‖input cube x‖ ^ 2
  have hmaps : ∀ assignment ∈ fineCubeAssignments pieces cubeSets,
      assignment.2 ∈ pieces.biUnion cubeSets := by
    rintro ⟨piece, cube⟩ hassignment
    have hassignment' : piece ∈ pieces ∧ cube ∈ cubeSets piece := by
      simpa [fineCubeAssignments] using hassignment
    exact Finset.mem_biUnion.mpr ⟨piece, hassignment'.1, hassignment'.2⟩
  have hfiber := Finset.sum_fiberwise_of_maps_to'
    (s := fineCubeAssignments pieces cubeSets) (t := pieces.biUnion cubeSets)
    (g := fun assignment : Sigma fun _ : ι => κ => assignment.2) hmaps E
  have hfiberEq : ∀ cube : κ,
      (∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube) =
        ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
    intro cube
    simp [E]
  change (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) ≤
    (R : Real) * ∑ cube ∈ pieces.biUnion cubeSets, E cube
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) =
        ∑ assignment ∈ fineCubeAssignments pieces cubeSets, E assignment.2 := by
      simpa [fineCubeAssignments] using
        (Finset.sum_sigma' pieces cubeSets (fun _ cube => E cube))
    _ = ∑ cube ∈ pieces.biUnion cubeSets,
        ∑ assignment ∈ fineCubeAssignments pieces cubeSets with assignment.2 = cube,
          E cube := hfiber.symm
    _ = ∑ cube ∈ pieces.biUnion cubeSets,
        ∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube := by
      apply Finset.sum_congr rfl
      intro cube hcube
      simp only [fineCubeAssignmentFiber]
    _ = ∑ cube ∈ pieces.biUnion cubeSets,
        ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
      apply Finset.sum_congr rfl
      intro cube hcube
      exact hfiberEq cube
    _ ≤ ∑ cube ∈ pieces.biUnion cubeSets, (R : Real) * E cube := by
      apply Finset.sum_le_sum
      intro cube hcube
      have hmult : ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) ≤ R := by
        exact_mod_cast hoverlap cube hcube
      exact mul_le_mul_of_nonneg_right hmult (sq_nonneg _)
    _ = (R : Real) * ∑ cube ∈ pieces.biUnion cubeSets, E cube := by
      rw [Finset.mul_sum]

/-- The weighted pointwise form of the generic reverse-overlap collapse. -/
theorem continuumFineAssignedCubeWeightedEnergy_le_reverseOverlap_mul
    {ι κ X : Type*} [DecidableEq κ] (pieces : Finset ι)
    (cubeSets : ι → Finset κ) (input : κ → X → Complex)
    (weight : X → Real) (hweight : ∀ x, 0 ≤ weight x) (R : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets R) (x : X) :
    continuumFineAssignedCubeWeightedEnergy pieces cubeSets input weight x ≤
      (R : Real) * continuumFineCubeWeightedEnergy pieces cubeSets input weight x := by
  unfold continuumFineAssignedCubeWeightedEnergy continuumFineCubeWeightedEnergy
  calc
    continuumFineAssignedCubeSquareEnergy pieces cubeSets input x * weight x ≤
        ((R : Real) * continuumFineCubeSquareEnergy pieces cubeSets input x) * weight x :=
      mul_le_mul_of_nonneg_right
        (continuumFineAssignedCubeSquareEnergy_le_reverseOverlap_mul
          pieces cubeSets input R hoverlap x)
        (hweight x)
    _ = (R : Real) *
        (continuumFineCubeSquareEnergy pieces cubeSets input x * weight x) := by ring

/-- The continuum reverse-overlap energy collapse.  Per-cube weighted
integrability is the only analytic hypothesis; the inequality itself is the
pointwise reverse-overlap bound integrated against the common nonnegative
weight. -/
theorem integral_continuumFineAssignedCubeWeightedEnergy_le_reverseOverlap_mul
    {ι κ X : Type*} [DecidableEq κ] [MeasurableSpace X] (μ : Measure X)
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (input : κ → X → Complex) (weight : X → Real)
    (hweight : ∀ x, 0 ≤ weight x) (R : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets R)
    (hcubeWeighted : ∀ cube ∈ pieces.biUnion cubeSets,
      Integrable (fun x => ‖input cube x‖ ^ 2 * weight x) μ) :
    (∫ x, continuumFineAssignedCubeWeightedEnergy pieces cubeSets input weight x ∂μ) ≤
      (R : Real) *
        ∫ x, continuumFineCubeWeightedEnergy pieces cubeSets input weight x ∂μ := by
  have hassignedTerms : Integrable (fun x =>
      ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ‖input cube x‖ ^ 2 * weight x) μ := by
    refine integrable_finsetSum pieces ?_
    intro piece hpiece
    refine integrable_finsetSum (cubeSets piece) ?_
    intro cube hcube
    exact hcubeWeighted cube (Finset.mem_biUnion.mpr ⟨piece, hpiece, hcube⟩)
  have hassigned : Integrable
      (continuumFineAssignedCubeWeightedEnergy pieces cubeSets input weight) μ := by
    refine hassignedTerms.congr ?_
    filter_upwards with x
    change (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
      ‖input cube x‖ ^ 2 * weight x) =
        (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖input cube x‖ ^ 2) * weight x
    rw [Finset.sum_mul]
    apply Finset.sum_congr rfl
    intro piece hpiece
    rw [Finset.sum_mul]
  have hglobalTerms : Integrable (fun x =>
      ∑ cube ∈ pieces.biUnion cubeSets, ‖input cube x‖ ^ 2 * weight x) μ := by
    exact integrable_finsetSum (pieces.biUnion cubeSets) hcubeWeighted
  have hglobal : Integrable
      (continuumFineCubeWeightedEnergy pieces cubeSets input weight) μ := by
    refine hglobalTerms.congr ?_
    filter_upwards with x
    change (∑ cube ∈ pieces.biUnion cubeSets,
      ‖input cube x‖ ^ 2 * weight x) =
        (∑ cube ∈ pieces.biUnion cubeSets, ‖input cube x‖ ^ 2) * weight x
    rw [Finset.sum_mul]
  have hright : Integrable (fun x =>
      (R : Real) * continuumFineCubeWeightedEnergy pieces cubeSets input weight x) μ :=
    hglobal.const_mul R
  calc
    (∫ x, continuumFineAssignedCubeWeightedEnergy pieces cubeSets input weight x ∂μ) ≤
        ∫ x, (R : Real) *
          continuumFineCubeWeightedEnergy pieces cubeSets input weight x ∂μ :=
      integral_mono hassigned hright fun x =>
        continuumFineAssignedCubeWeightedEnergy_le_reverseOverlap_mul
          pieces cubeSets input weight hweight R hoverlap x
    _ = (R : Real) *
        ∫ x, continuumFineCubeWeightedEnergy pieces cubeSets input weight x ∂μ :=
      integral_const_mul _ _

/-- The preceding continuum kernel transposition combined with an explicit
raw L2 light-ray maximal-energy estimate. -/
theorem continuumFineKernelWeightedPairing_le_of_lightRayL2Energy
    {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (ω : Euclidean 2) (hω : ω ∈ unitLightRayDirections)
    (kernel : WaveSpaceTime → Euclidean 2 → Complex)
    (input : Euclidean 2 → Complex) (g : WaveSpaceTime → Complex)
    (hkernel : ∀ z y, ‖kernel z y‖ ≤ lightRayKernel δ N ω y z)
    (hmass : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N ω y z) ≤ A)
    (hmeas : ∀ z, AEStronglyMeasurable (fun y : Euclidean 2 =>
      (lightRayKernel δ N ω y z)⁻¹ * ‖kernel z y * input y‖ ^ 2) volume)
    (henergy : ∀ z, Integrable (fun y : Euclidean 2 =>
      lightRayKernel δ N ω y z * ‖input y‖ ^ 2) volume)
    (htermWeighted : Integrable (fun z : WaveSpaceTime =>
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖)
      continuumLightRayMeasure)
    (henergyWeighted : Integrable (fun z : WaveSpaceTime =>
      (∫ y : Euclidean 2,
        lightRayKernel δ N ω y z * ‖input y‖ ^ 2) * ‖g z‖)
      continuumLightRayMeasure)
    (hprod : Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
      lightRayKernel δ N ω p.2 p.1 * ‖input p.2‖ ^ 2 * ‖g p.1‖)
      (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ y : Euclidean 2, Integrable (fun z : WaveSpaceTime =>
      lightRayKernel δ N ω y z * ‖g z‖) continuumLightRayMeasure)
    (hbounded : ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hinputMeas : AEStronglyMeasurable input volume)
    (hinputFour : Integrable (fun y : Euclidean 2 => ‖input y‖ ^ 4) volume)
    (hmaxMeas : AEStronglyMeasurable (lightRayMaximal δ N g) volume)
    (hmaxTwo : Integrable (fun y : Euclidean 2 =>
      lightRayMaximal δ N g y ^ 2) volume)
    (hKakeya : (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2) ≤
      B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2 ∂continuumLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) ≤
      A * (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by
  letI : SFinite continuumLightRayMeasure := by
    unfold continuumLightRayMeasure
    infer_instance
  have hinputSqMeas : AEStronglyMeasurable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2) volume := hinputMeas.norm.pow 2
  have hinputSqInt : Integrable (fun y : Euclidean 2 =>
      (‖input y‖ ^ 2) ^ 2) volume := by
    refine hinputFour.congr ?_
    filter_upwards with y
    ring
  have hinputSqMem : MemLp (fun y : Euclidean 2 => ‖input y‖ ^ 2) 2 volume :=
    (memLp_two_iff_integrable_sq hinputSqMeas).mpr hinputSqInt
  have hmaxMem : MemLp (lightRayMaximal δ N g) 2 volume :=
    (memLp_two_iff_integrable_sq hmaxMeas).mpr hmaxTwo
  have hmaxWeighted : Integrable (fun y : Euclidean 2 =>
      ‖input y‖ ^ 2 * lightRayMaximal δ N g y) volume := by
    exact hinputSqMem.integrable_mul hmaxMem
  have hpair := continuumFineKernelWeightedPairing_le_lightRayMaximal
    hδ hA N ω hω kernel input g hkernel hmass hmeas henergy htermWeighted
    henergyWeighted hprod hRayInt hbounded hmaxWeighted
  have hholder := integral_mul_le_Lp_mul_Lq_of_nonneg
    (f := fun y : Euclidean 2 => ‖input y‖ ^ 2)
    (g := lightRayMaximal δ N g)
    Real.HolderConjugate.two_two
    (Eventually.of_forall fun y => sq_nonneg (‖input y‖))
    (Eventually.of_forall fun y =>
      aux_lightRayMaximal_nonneg hδ N g hbounded y)
    (by norm_num; exact hinputSqMem)
    (by norm_num; exact hmaxMem)
  have hholder' :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
        (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (∫ y : Euclidean 2,
            lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) := by
    have hInputPow :
        (∫ y : Euclidean 2, (‖input y‖ ^ 2) ^ (2 : Real)) =
          ∫ y : Euclidean 2, ‖input y‖ ^ 4 := by
      apply integral_congr_ae
      filter_upwards with y
      rw [Real.rpow_two]
      ring
    have hMaxPow :
        (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ (2 : Real)) =
          ∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2 := by
      apply integral_congr_ae
      filter_upwards with y
      rw [Real.rpow_two]
    calc
      (∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
          (∫ y : Euclidean 2, (‖input y‖ ^ 2) ^ (2 : Real)) ^ (1 / (2 : Real)) *
            (∫ y : Euclidean 2,
              lightRayMaximal δ N g y ^ (2 : Real)) ^ (1 / (2 : Real)) := hholder
      _ = (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (∫ y : Euclidean 2,
            lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) := by
        rw [hInputPow, hMaxPow]
        simp only [one_div]
  have hinputNonneg : 0 ≤ (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) :=
    Real.rpow_nonneg (integral_nonneg fun y => pow_nonneg (norm_nonneg _) _) _
  have hmaxSqrt :
      (∫ y : Euclidean 2, lightRayMaximal δ N g y ^ 2) ^ ((2 : Real)⁻¹) ≤
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by
    exact Real.rpow_le_rpow
      (integral_nonneg fun y => sq_nonneg _)
      hKakeya (by norm_num)
  have hright :
      (∫ y : Euclidean 2,
        ‖input y‖ ^ 2 * lightRayMaximal δ N g y) ≤
        (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
            ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) :=
    hholder'.trans (mul_le_mul_of_nonneg_left hmaxSqrt hinputNonneg)
  calc
    (∫ z : WaveSpaceTime,
        ‖∫ y : Euclidean 2, kernel z y * input y‖ ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        A * ∫ y : Euclidean 2,
          ‖input y‖ ^ 2 * lightRayMaximal δ N g y := hpair
    _ ≤ A * ((∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
          (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
            ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹)) :=
      mul_le_mul_of_nonneg_left hright hA
    _ = A * (∫ y : Euclidean 2, ‖input y‖ ^ 4) ^ ((2 : Real)⁻¹) *
        (B * ∫ z : WaveSpaceTime, ‖g z‖ ^ 2
          ∂continuumLightRayMeasure) ^ ((2 : Real)⁻¹) := by ring

/-- A finite Riemann-sum version of a light-ray average.  It provides a
fully finite setting for the elementary estimates below, independently of
any measure-theoretic Kakeya input. -/
def finiteLightRayAverage (δ : Real) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) : Real :=
  ∑ z ∈ sample, lightRayKernel δ N ω y z * ‖g z‖

/-- A finite directional light-ray maximal function.  A nonempty direction
set is explicit because finite suprema over the reals require a witness. -/
def finiteLightRayMaximal (δ : Real) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) : Euclidean 2 → Real :=
  fun y => directions.sup' hdirections (fun ω => finiteLightRayAverage δ N ω y sample g)

/-- Each finite light-ray average is nonnegative. -/
theorem finiteLightRayAverage_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (ω y : Euclidean 2) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) :
    0 ≤ finiteLightRayAverage δ N ω y sample g := by
  unfold finiteLightRayAverage
  exact Finset.sum_nonneg fun z hz =>
    mul_nonneg (lightRayKernel_nonneg hδ N ω y z) (norm_nonneg _)

/-- The finite directional maximal function is nonnegative. -/
theorem finiteLightRayMaximal_nonneg {δ : Real} (hδ : 0 < δ) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    0 ≤ finiteLightRayMaximal δ N directions hdirections sample g y := by
  unfold finiteLightRayMaximal
  obtain ⟨ω, hω⟩ := hdirections
  exact (finiteLightRayAverage_nonneg hδ N ω y sample g).trans
    (Finset.le_sup' (fun ω => finiteLightRayAverage δ N ω y sample g) hω)

/-- The elementary kernel-size bound for a finite light-ray average. -/
theorem finiteLightRayAverage_le_normalization_mul_sum_norm {δ : Real}
    (hδ : 0 < δ) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    finiteLightRayAverage δ N ω y sample g ≤
      (δ⁻¹) ^ 2 * ∑ z ∈ sample, ‖g z‖ := by
  unfold finiteLightRayAverage
  rw [Finset.mul_sum]
  apply Finset.sum_le_sum
  intro z hz
  exact mul_le_mul_of_nonneg_right
    (lightRayKernel_le_normalization hδ N ω y z) (norm_nonneg _)

/-- Finite Cauchy--Schwarz for the sampled input values. -/
theorem sq_sum_norm_sample_le_card_mul_sum_sq
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    (∑ z ∈ sample, ‖g z‖) ^ 2 ≤
      (sample.card : Real) * ∑ z ∈ sample, ‖g z‖ ^ 2 :=
  sq_sum_le_card_mul_sum_sq

/-- The squared finite light-ray average obeys the elementary sampled `L²`
bound.  Its cardinality loss is exactly what the geometric Kakeya input must
replace in the continuum argument. -/
theorem sq_finiteLightRayAverage_le_crude_sampleEnergy {δ : Real}
    (hδ : 0 < δ) (N : Nat) (ω y : Euclidean 2)
    (sample : Finset WaveSpaceTime) (g : WaveSpaceTime → Complex) :
    finiteLightRayAverage δ N ω y sample g ^ 2 ≤
      ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let B : Real := (δ⁻¹) ^ 2
  let S : Real := ∑ z ∈ sample, ‖g z‖
  let E : Real := ∑ z ∈ sample, ‖g z‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp [B]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun z hz => norm_nonneg _
  have hA : 0 ≤ finiteLightRayAverage δ N ω y sample g :=
    finiteLightRayAverage_nonneg hδ N ω y sample g
  have haverage : finiteLightRayAverage δ N ω y sample g ≤ B * S := by
    simpa only [B, S] using
      finiteLightRayAverage_le_normalization_mul_sum_norm hδ N ω y sample g
  have hsquare : finiteLightRayAverage δ N ω y sample g ^ 2 ≤ (B * S) ^ 2 :=
    (sq_le_sq₀ hA (mul_nonneg hB hS)).mpr haverage
  have hcs : S ^ 2 ≤ (sample.card : Real) * E := by
    simpa only [S, E] using sq_sum_norm_sample_le_card_mul_sum_sq sample g
  have hE : 0 ≤ E := by
    dsimp [E]
    exact Finset.sum_nonneg fun z hz => sq_nonneg _
  calc
    finiteLightRayAverage δ N ω y sample g ^ 2 ≤ (B * S) ^ 2 := hsquare
    _ = B ^ 2 * S ^ 2 := by ring
    _ ≤ B ^ 2 * ((sample.card : Real) * E) :=
      mul_le_mul_of_nonneg_left hcs (sq_nonneg B)
    _ = ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [B, E]
      ring

/-- Every finite directional maximum has the same elementary sampled bound.
This is deliberately the crude finite estimate, not the planar Kakeya
theorem. -/
theorem finiteLightRayMaximal_le_normalization_mul_sum_norm {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    finiteLightRayMaximal δ N directions hdirections sample g y ≤
      (δ⁻¹) ^ 2 * ∑ z ∈ sample, ‖g z‖ := by
  unfold finiteLightRayMaximal
  apply Finset.sup'_le
  intro ω hω
  exact finiteLightRayAverage_le_normalization_mul_sum_norm hδ N ω y sample g

/-- Squaring the finite directional maximum gives the same sampled energy
bound, uniformly in the choice of a terminal point. -/
theorem sq_finiteLightRayMaximal_le_crude_sampleEnergy {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) (y : Euclidean 2) :
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤
      ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let B : Real := (δ⁻¹) ^ 2
  let S : Real := ∑ z ∈ sample, ‖g z‖
  let E : Real := ∑ z ∈ sample, ‖g z‖ ^ 2
  have hB : 0 ≤ B := by
    dsimp [B]
    exact sq_nonneg _
  have hS : 0 ≤ S := by
    dsimp [S]
    exact Finset.sum_nonneg fun z hz => norm_nonneg _
  have hmax : 0 ≤ finiteLightRayMaximal δ N directions hdirections sample g y :=
    finiteLightRayMaximal_nonneg hδ N directions hdirections sample g y
  have hbound : finiteLightRayMaximal δ N directions hdirections sample g y ≤ B * S := by
    simpa only [B, S] using
      finiteLightRayMaximal_le_normalization_mul_sum_norm hδ N directions hdirections sample g y
  have hsquare : finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤
      (B * S) ^ 2 :=
    (sq_le_sq₀ hmax (mul_nonneg hB hS)).mpr hbound
  have hcs : S ^ 2 ≤ (sample.card : Real) * E := by
    simpa only [S, E] using sq_sum_norm_sample_le_card_mul_sum_sq sample g
  calc
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤ (B * S) ^ 2 := hsquare
    _ = B ^ 2 * S ^ 2 := by ring
    _ ≤ B ^ 2 * ((sample.card : Real) * E) :=
      mul_le_mul_of_nonneg_left hcs (sq_nonneg B)
    _ = ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [B, E]
      ring

/-- The discrete square energy of a finite directional light-ray maximal
function at a finite family of terminal points. -/
def finiteLightRaySquareEnergy (δ : Real) (N : Nat)
    (directions terminalPoints : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) : Real :=
  ∑ y ∈ terminalPoints,
    finiteLightRayMaximal δ N directions hdirections sample g y ^ 2

/-- The completely elementary finite `L²` light-ray bookkeeping estimate.
It loses the cardinalities of both the sampled space-time set and terminal
set.  The MSS Nikodym--Kakeya theorem replaces this loss by a logarithm for
the continuum operator. -/
theorem finiteLightRaySquareEnergy_le_crude {δ : Real}
    (hδ : 0 < δ) (N : Nat) (directions terminalPoints : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) :
    finiteLightRaySquareEnergy δ N directions terminalPoints hdirections sample g ≤
      (terminalPoints.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
        ∑ z ∈ sample, ‖g z‖ ^ 2 := by
  let E : Real := ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
    ∑ z ∈ sample, ‖g z‖ ^ 2
  have hpoint : ∀ y : Euclidean 2,
      finiteLightRayMaximal δ N directions hdirections sample g y ^ 2 ≤ E := by
    intro y
    simpa only [E] using
      sq_finiteLightRayMaximal_le_crude_sampleEnergy hδ N directions hdirections sample g y
  unfold finiteLightRaySquareEnergy
  calc
    (∑ y ∈ terminalPoints,
        finiteLightRayMaximal δ N directions hdirections sample g y ^ 2) ≤
        ∑ _y ∈ terminalPoints, E := by
      apply Finset.sum_le_sum
      intro y hy
      exact hpoint y
    _ = (terminalPoints.card : Real) * E := by simp
    _ = (terminalPoints.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (sample.card : Real) *
          ∑ z ∈ sample, ‖g z‖ ^ 2 := by
      dsimp [E]
      ring

/-- Pointwise finite light-ray incidence data: the directions and terminal
points whose tubes contain a given space-time point. -/
noncomputable def lightRayTubeIncidences (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    Finset (Euclidean 2 × Euclidean 2) := by
  classical
  exact (directions.product terminalPoints).filter
    (fun pair => z ∈ lightRayTube δ pair.1 pair.2)

/-- Membership in the finite light-ray incidence family spells out both
finite indexing conditions and tube membership. -/
theorem mem_lightRayTubeIncidences_iff (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime)
    (pair : Euclidean 2 × Euclidean 2) :
    pair ∈ lightRayTubeIncidences δ directions terminalPoints z ↔
      pair.1 ∈ directions ∧ pair.2 ∈ terminalPoints ∧
        z ∈ lightRayTube δ pair.1 pair.2 := by
  classical
  simp [lightRayTubeIncidences, and_assoc]

/-- The finite tube-incidence multiplicity at one space-time point. -/
noncomputable def lightRayTubeMultiplicity (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) : Nat :=
  (lightRayTubeIncidences δ directions terminalPoints z).card

/-- Incidence multiplicity is literally the cardinality of the active tube
family. -/
theorem lightRayTubeMultiplicity_eq_card_lightRayTubeIncidences (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    lightRayTubeMultiplicity δ directions terminalPoints z =
      (lightRayTubeIncidences δ directions terminalPoints z).card := rfl

/-- The elementary incidence bound before any planar Kakeya geometry is
applied. -/
theorem lightRayTubeMultiplicity_le_card_mul_card (δ : Real)
    (directions terminalPoints : Finset (Euclidean 2)) (z : WaveSpaceTime) :
    lightRayTubeMultiplicity δ directions terminalPoints z ≤
      directions.card * terminalPoints.card := by
  classical
  rw [lightRayTubeMultiplicity_eq_card_lightRayTubeIncidences]
  unfold lightRayTubeIncidences
  calc
    ((directions.product terminalPoints).filter
        (fun pair => z ∈ lightRayTube δ pair.1 pair.2)).card ≤
        (directions.product terminalPoints).card := by
      exact Finset.card_le_card (Finset.filter_subset _ _)
    _ = directions.card * terminalPoints.card := Finset.card_product _ _

/-- Weighted finite Cauchy--Schwarz in the form used by the fine
square-function kernel reduction.  A complex kernel bounded pointwise by a
nonnegative real kernel costs its total mass and leaves the weighted input
energy. -/
theorem sq_norm_sum_le_kernelMass_mul_weightedEnergy
    {α : Type*} (sources : Finset α) (K h : α → Complex) (L : α → Real)
    (hL : ∀ y ∈ sources, 0 ≤ L y)
    (hK : ∀ y ∈ sources, ‖K y‖ ≤ L y) :
    ‖∑ y ∈ sources, K y * h y‖ ^ 2 ≤
      (∑ y ∈ sources, L y) * ∑ y ∈ sources, L y * ‖h y‖ ^ 2 := by
  have hsum_nonneg : 0 ≤ ∑ y ∈ sources, L y * ‖h y‖ :=
    Finset.sum_nonneg fun y hy => mul_nonneg (hL y hy) (norm_nonneg _)
  have hnorm :
      ‖∑ y ∈ sources, K y * h y‖ ≤ ∑ y ∈ sources, L y * ‖h y‖ := by
    calc
      ‖∑ y ∈ sources, K y * h y‖ ≤ ∑ y ∈ sources, ‖K y * h y‖ :=
        norm_sum_le _ _
      _ = ∑ y ∈ sources, ‖K y‖ * ‖h y‖ := by
        apply Finset.sum_congr rfl
        intro y hy
        rw [norm_mul]
      _ ≤ ∑ y ∈ sources, L y * ‖h y‖ := by
        apply Finset.sum_le_sum
        intro y hy
        exact mul_le_mul_of_nonneg_right (hK y hy) (norm_nonneg _)
  have hcs :
      (∑ y ∈ sources, L y * ‖h y‖) ^ 2 ≤
        (∑ y ∈ sources, L y) * ∑ y ∈ sources, L y * ‖h y‖ ^ 2 := by
    have hcs' := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul sources
      (r := fun y => L y * ‖h y‖) (f := L)
      (g := fun y => L y * ‖h y‖ ^ 2)
      (fun y hy => hL y hy)
      (fun y hy => mul_nonneg (hL y hy) (sq_nonneg _))
      (fun y hy => by nlinarith)
    simpa [mul_assoc] using hcs'
  exact (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr hnorm |>.trans hcs

/-- A finite cube-localized summand in the fine square-function argument.
The source variable is kept discrete here so that the kernel Cauchy--Schwarz
and transposition steps have a completely literal finite form. -/
noncomputable def finiteFineCubeTerm {ι κ : Type*}
    (sources : Finset (Euclidean 2))
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) (cube : κ) :
    WaveSpaceTime → Complex :=
  fun z => ∑ y ∈ sources, kernel piece cube z y * input cube y

/-- The finite sum of cube-localized terms belonging to one radial/angular
piece.  This is the discrete analogue of the decomposition
`T^ν_λ f_n = ∑_κ T^{n,ν,κ}_λ P^κ_λ f`. -/
noncomputable def finiteFinePiece {ι κ : Type*}
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) :
    WaveSpaceTime → Complex :=
  fun z => ∑ cube ∈ cubeSets piece,
    finiteFineCubeTerm sources kernel input piece cube z

/-- The finite version of the MSS fine square function.  Its `piece` index
packages the radial and angular labels, while `cubeSets piece` records the
few Fourier cubes meeting that piece. -/
noncomputable def finiteFineSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ piece ∈ pieces,
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2)

/-- The cube-expanded finite fine square function.  The comparison with
`finiteFineSquareFunction` is exactly the first Cauchy--Schwarz step in the
MSS fine-square proof. -/
noncomputable def finiteFineCubeSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
    ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2)

/-- The finite family of radial/angular pieces to which one Fourier cube is
assigned.  This is the reverse bounded-overlap family in the fine kernel
lemma. -/
noncomputable def fineCubeIncidences {ι κ : Type*}
    (pieces : Finset ι) (cubeSets : ι → Finset κ) (cube : κ) : Finset ι := by
  classical
  exact pieces.filter (fun piece => cube ∈ cubeSets piece)

/-- A finite nonnegative dual test against the square of a space-time square
function.  Taking a norm of the test function is the discrete counterpart of
the positive `L²` dual test in the blueprint. -/
noncomputable def finiteFineDualPairing
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex)
    (S : WaveSpaceTime → Real) : Real :=
  ∑ z ∈ targets, S z ^ 2 * ‖weight z‖

/-- The input cube energy weighted by a light-ray maximal function.  This is
the expression produced after the finite kernel transposition. -/
noncomputable def finiteFineCubeEnergy {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) : Real :=
  ∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y

/-- The cube energy before using the reverse bounded-overlap part of the
cube decomposition.  Each occurrence of a cube is retained with its owning
radial/angular piece, which is the exact finite expression obtained directly
after kernel transposition. -/
noncomputable def finiteFineAssignedCubeEnergy {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (M : Euclidean 2 → Real) : Real :=
  ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
    ‖input cube y‖ ^ 2 * M y

/-- The pointwise kernel localization required for a finite fine
cube-localized summand.  It is the exact discrete interface supplied by the
nonstationary-phase kernel estimate in the MSS blueprint. -/
def HasFiniteFineKernelLocalization {ι κ : Type*}
    (δ : Real) (N : Nat) (pieces : Finset ι) (cubeSets : ι → Finset κ)
    (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex) : Prop :=
  ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
    ∀ z : WaveSpaceTime, ∀ y : Euclidean 2,
      ‖kernel piece cube z y‖ ≤ lightRayKernel δ N (direction piece) y z

/-- A uniform finite mass bound for the model light-ray kernels on the
source sample.  In the continuum proof this is the elementary `L¹` kernel
bound obtained by integrating the localized kernel in the source variable. -/
def HasFiniteFineKernelMassBound {ι κ : Type*}
    (δ : Real) (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2) (A : Real) : Prop :=
  ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z : WaveSpaceTime,
    (∑ y ∈ sources, lightRayKernel δ N (direction piece) y z) ≤ A

/-- A finite light-ray average in a permitted direction is bounded by the
corresponding finite directional maximal operator. -/
theorem finiteLightRayAverage_le_finiteLightRayMaximal
    (δ : Real) (N : Nat) (directions : Finset (Euclidean 2))
    (hdirections : directions.Nonempty) (sample : Finset WaveSpaceTime)
    (g : WaveSpaceTime → Complex) {ω : Euclidean 2} (hω : ω ∈ directions)
    (y : Euclidean 2) :
    finiteLightRayAverage δ N ω y sample g ≤
      finiteLightRayMaximal δ N directions hdirections sample g y := by
  unfold finiteLightRayMaximal
  exact Finset.le_sup' (fun ω => finiteLightRayAverage δ N ω y sample g) hω

/-- Cauchy--Schwarz for one finite cube-localized term under the exact
light-ray kernel localization and mass assumptions. -/
theorem sq_norm_finiteFineCubeTerm_le_of_lightRayLocalization
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    {piece : ι} (hpiece : piece ∈ pieces) {cube : κ} (hcube : cube ∈ cubeSets piece)
    (z : WaveSpaceTime) :
    ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 ≤
      A * ∑ y ∈ sources,
        lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 := by
  have henergy_nonneg : 0 ≤ ∑ y ∈ sources,
      lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 :=
    Finset.sum_nonneg fun y hy =>
      mul_nonneg (lightRayKernel_nonneg hδ N (direction piece) y z) (sq_nonneg _)
  have hcs := sq_norm_sum_le_kernelMass_mul_weightedEnergy sources
    (fun y => kernel piece cube z y) (fun y => input cube y)
    (fun y => lightRayKernel δ N (direction piece) y z)
    (fun y hy => lightRayKernel_nonneg hδ N (direction piece) y z)
    (fun y hy => hkernel piece hpiece cube hcube z y)
  change ‖∑ y ∈ sources, kernel piece cube z y * input cube y‖ ^ 2 ≤ _
  calc
    ‖∑ y ∈ sources, kernel piece cube z y * input cube y‖ ^ 2 ≤
        (∑ y ∈ sources, lightRayKernel δ N (direction piece) y z) *
          ∑ y ∈ sources,
            lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 := hcs
    _ ≤ A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2 :=
      mul_le_mul_of_nonneg_right (hmass piece hpiece cube hcube z) henergy_nonneg

/-- Finite duality and kernel transposition for one cube-localized fine
term.  This is the literal Cauchy--Schwarz reduction to the finite
light-ray maximal function; no Kakeya estimate is used. -/
theorem sum_sq_norm_finiteFineCubeTerm_mul_norm_le_lightRayMaximal
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    {piece : ι} (hpiece : piece ∈ pieces) {cube : κ} (hcube : cube ∈ cubeSets piece)
    (hdirection : direction piece ∈ directions) :
    (∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
      A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
        finiteLightRayMaximal δ N directions hdirections targets weight y := by
  have hpoint : ∀ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ ≤
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖ := by
    intro z hz
    exact mul_le_mul_of_nonneg_right
      (sq_norm_finiteFineCubeTerm_le_of_lightRayLocalization hδ N
        pieces sources cubeSets direction kernel input hkernel hmass hpiece hcube z)
      (norm_nonneg _)
  have hrearrange :
      (∑ z ∈ targets,
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖) =
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
    calc
      (∑ z ∈ targets,
        (A * ∑ y ∈ sources,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
            ‖weight z‖) =
          ∑ z ∈ targets, ∑ y ∈ sources,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [Finset.mul_sum, Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro y hy
        ring
      _ = ∑ y ∈ sources, ∑ z ∈ targets,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        exact Finset.sum_comm
      _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
        calc
          (∑ y ∈ sources, ∑ z ∈ targets,
            A * ‖input cube y‖ ^ 2 *
              (lightRayKernel δ N (direction piece) y z * ‖weight z‖)) =
              ∑ y ∈ sources, (A * ‖input cube y‖ ^ 2) *
                (∑ z ∈ targets,
                  lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
            apply Finset.sum_congr rfl
            intro y hy
            rw [Finset.mul_sum]
          _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
                (∑ z ∈ targets,
                  lightRayKernel δ N (direction piece) y z * ‖weight z‖) := by
            rw [Finset.mul_sum]
            apply Finset.sum_congr rfl
            intro y hy
            ring
  have hmax : ∀ y ∈ sources,
      (∑ z ∈ targets,
        lightRayKernel δ N (direction piece) y z * ‖weight z‖) ≤
        finiteLightRayMaximal δ N directions hdirections targets weight y := by
    intro y hy
    simpa only [finiteLightRayAverage] using
      (finiteLightRayAverage_le_finiteLightRayMaximal δ N directions hdirections
        targets weight hdirection y)
  calc
    (∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        ∑ z ∈ targets,
          (A * ∑ y ∈ sources,
            lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) *
              ‖weight z‖ := by
      apply Finset.sum_le_sum
      intro z hz
      exact hpoint z hz
    _ = A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          (∑ z ∈ targets,
            lightRayKernel δ N (direction piece) y z * ‖weight z‖) := hrearrange
    _ ≤ A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y := by
      apply mul_le_mul_of_nonneg_left _ hA
      apply Finset.sum_le_sum
      intro y hy
      exact mul_le_mul_of_nonneg_left (hmax y hy) (sq_nonneg _)

/-- The finite duality/kernel reduction summed over every radial/angular
piece and every cube assigned to it.  This is the precise finite analogue of
the line in the MSS proof immediately before reverse cube-overlap and the
Nikodym--Kakeya estimate are invoked. -/
theorem sum_sq_norm_finiteFineCubeTerms_mul_norm_le_finiteLightRayMaximal
    {ι κ : Type*} {δ A : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
      A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hterm : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      (∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y := by
    intro piece hpiece cube hcube
    exact sum_sq_norm_finiteFineCubeTerm_mul_norm_le_lightRayMaximal hδ hA N
      pieces sources cubeSets direction kernel input targets weight directions hdirections
      hkernel hmass hpiece hcube (hdirection piece hpiece)
  have hrearrange :
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y) =
        A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
    unfold finiteFineAssignedCubeEnergy
    calc
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
          finiteLightRayMaximal δ N directions hdirections targets weight y) =
          ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            A * (∑ y ∈ sources, ‖input cube y‖ ^ 2 *
              finiteLightRayMaximal δ N directions hdirections targets weight y) := by
        apply Finset.sum_congr rfl
        intro piece hpiece
        apply Finset.sum_congr rfl
        intro cube hcube
        rw [Finset.mul_sum]
      _ = A * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
            ‖input cube y‖ ^ 2 *
              finiteLightRayMaximal δ N directions hdirections targets weight y := by
        rw [Finset.mul_sum]
        apply Finset.sum_congr rfl
        intro piece hpiece
        rw [Finset.mul_sum]
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          A * ∑ y ∈ sources, ‖input cube y‖ ^ 2 *
            finiteLightRayMaximal δ N directions hdirections targets weight y := by
      apply Finset.sum_le_sum
      intro piece hpiece
      apply Finset.sum_le_sum
      intro cube hcube
      exact hterm piece hpiece cube hcube
    _ = A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hrearrange

/-- Squaring the finite fine square function removes its outer square root. -/
theorem sq_finiteFineSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (z : WaveSpaceTime) :
    finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 =
      ∑ piece ∈ pieces,
        ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 := by
  unfold finiteFineSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun piece hpiece => sq_nonneg _

/-- Squaring the cube-expanded fine square function removes its outer square
root and exposes the individual cube terms. -/
theorem sq_finiteFineCubeSquareFunction {ι κ : Type*}
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (z : WaveSpaceTime) :
    finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 =
      ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
  unfold finiteFineCubeSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun piece hpiece =>
    Finset.sum_nonneg fun cube hcube => sq_nonneg _

/-- Finite Cauchy--Schwarz for a complex cube sum.  This form applies before
any choice of a source kernel or a particular packet model. -/
theorem sq_norm_finset_sum_le_card_mul_sum_sq {κ : Type*}
    (cubes : Finset κ) (T : κ → Complex) :
    ‖∑ cube ∈ cubes, T cube‖ ^ 2 ≤
      (cubes.card : Real) * ∑ cube ∈ cubes, ‖T cube‖ ^ 2 := by
  have hsum_nonneg : 0 ≤ ∑ cube ∈ cubes, ‖T cube‖ :=
    Finset.sum_nonneg fun cube hcube => norm_nonneg _
  calc
    ‖∑ cube ∈ cubes, T cube‖ ^ 2 ≤
        (∑ cube ∈ cubes, ‖T cube‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr (norm_sum_le _ _)
    _ ≤ (cubes.card : Real) * ∑ cube ∈ cubes, ‖T cube‖ ^ 2 := by
      exact sq_sum_le_card_mul_sum_sq

/-- The continuum fine-square transposition step before reverse cube overlap.

The cube sum in each packet is first controlled by finite Cauchy--Schwarz.
All resulting individual cube packets are then sent through the *single*
finite-family continuum transposition theorem.  Thus the light-ray maximal
operator is applied only after summing every cube assignment, never once per
cube.  The displayed integrability assumptions are exactly those needed for
the literal continuum Fubini/transposition argument. -/
theorem continuumFineSquarePairing_le_cubeMultiplicity_mul_lightRayMaximal
    {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubeSets : ι → Finset κ)
    {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B) (N : Nat)
    (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex)
    (packet : ι → κ → WaveSpaceTime → Complex)
    (g : WaveSpaceTime → Complex)
    (hpacket : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z,
      packet piece cube z =
        ∫ y : Euclidean 2, kernel piece cube z y * input cube y)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ unitLightRayDirections)
    (hkernel : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z y,
      ‖kernel piece cube z y‖ ≤ lightRayKernel δ N (direction piece) y z)
    (hmass : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z,
      Integrable (fun y : Euclidean 2 =>
        lightRayKernel δ N (direction piece) y z) volume ∧
      (∫ y : Euclidean 2, lightRayKernel δ N (direction piece) y z) ≤ A)
    (hmeas : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z,
      AEStronglyMeasurable (fun y : Euclidean 2 =>
        (lightRayKernel δ N (direction piece) y z)⁻¹ *
          ‖kernel piece cube z y * input cube y‖ ^ 2) volume)
    (henergy : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ z,
      Integrable (fun y : Euclidean 2 =>
        lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) volume)
    (htermWeighted : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      Integrable (fun z : WaveSpaceTime =>
        ‖∫ y : Euclidean 2, kernel piece cube z y * input cube y‖ ^ 2 * ‖g z‖)
        continuumLightRayMeasure)
    (henergyWeighted : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      Integrable (fun z : WaveSpaceTime =>
        (∫ y : Euclidean 2,
          lightRayKernel δ N (direction piece) y z * ‖input cube y‖ ^ 2) * ‖g z‖)
        continuumLightRayMeasure)
    (hprod : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
        lightRayKernel δ N (direction piece) p.2 p.1 * ‖input cube p.2‖ ^ 2 *
          ‖g p.1‖) (continuumLightRayMeasure.prod volume))
    (hRayInt : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ y : Euclidean 2,
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel δ N (direction piece) y z * ‖g z‖)
        continuumLightRayMeasure)
    (hbounded : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece, ∀ y : Euclidean 2,
      BddAbove ((fun ω : Euclidean 2 => lightRayAverage δ N ω y g) ''
        unitLightRayDirections))
    (hmaxWeighted : ∀ piece ∈ pieces, ∀ cube ∈ cubeSets piece,
      Integrable (fun y : Euclidean 2 =>
        ‖input cube y‖ ^ 2 * lightRayMaximal δ N g y) volume)
    (hsquareWeighted : Integrable (fun z : WaveSpaceTime =>
      (∑ piece ∈ pieces, ‖∑ cube ∈ cubeSets piece, packet piece cube z‖ ^ 2) *
        ‖g z‖) continuumLightRayMeasure) :
    (∫ z : WaveSpaceTime,
      (∑ piece ∈ pieces, ‖∑ cube ∈ cubeSets piece, packet piece cube z‖ ^ 2) *
        ‖g z‖ ∂continuumLightRayMeasure) ≤
      (B * A) * ∫ y : Euclidean 2,
        continuumFineAssignedCubeWeightedEnergy pieces cubeSets input
          (lightRayMaximal δ N g) y := by
  classical
  have hassignment : ∀ assignment ∈ fineCubeAssignments pieces cubeSets,
      assignment.1 ∈ pieces ∧ assignment.2 ∈ cubeSets assignment.1 := by
    rintro ⟨piece, cube⟩ hassignment
    simpa [fineCubeAssignments] using hassignment
  have hcubeTermsWeighted : Integrable (fun z : WaveSpaceTime =>
      ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        ‖packet piece cube z‖ ^ 2 * ‖g z‖) continuumLightRayMeasure := by
    refine integrable_finsetSum pieces ?_
    intro piece hpiece
    refine integrable_finsetSum (cubeSets piece) ?_
    intro cube hcube
    refine (htermWeighted piece hpiece cube hcube).congr ?_
    filter_upwards with z
    rw [hpacket piece hpiece cube hcube z]
  have hcubeWeighted : Integrable (fun z : WaveSpaceTime =>
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        ‖packet piece cube z‖ ^ 2) * ‖g z‖) continuumLightRayMeasure := by
    refine hcubeTermsWeighted.congr ?_
    filter_upwards with z
    calc
      ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2 * ‖g z‖ =
          ∑ piece ∈ pieces, (∑ cube ∈ cubeSets piece,
            ‖packet piece cube z‖ ^ 2) * ‖g z‖ := by
        apply Finset.sum_congr rfl
        intro piece hpiece
        rw [Finset.sum_mul]
      _ = (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2) * ‖g z‖ := by
        rw [Finset.sum_mul]
  have hpointEnergy : ∀ z : WaveSpaceTime,
      (∑ piece ∈ pieces, ‖∑ cube ∈ cubeSets piece, packet piece cube z‖ ^ 2) ≤
        B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2 := by
    intro z
    calc
      (∑ piece ∈ pieces, ‖∑ cube ∈ cubeSets piece, packet piece cube z‖ ^ 2) ≤
          ∑ piece ∈ pieces, ((cubeSets piece).card : Real) *
            ∑ cube ∈ cubeSets piece, ‖packet piece cube z‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro piece hpiece
        exact sq_norm_finset_sum_le_card_mul_sum_sq (cubeSets piece)
          (fun cube => packet piece cube z)
      _ ≤ ∑ piece ∈ pieces, B * ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2 := by
        apply Finset.sum_le_sum
        intro piece hpiece
        exact mul_le_mul_of_nonneg_right (hcard piece hpiece)
          (Finset.sum_nonneg fun cube hcube => sq_nonneg _)
      _ = B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2 := by
        rw [Finset.mul_sum]
  have hrightWeighted : Integrable (fun z : WaveSpaceTime =>
      (B * (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
        ‖packet piece cube z‖ ^ 2)) * ‖g z‖) continuumLightRayMeasure := by
    refine (hcubeWeighted.const_mul B).congr ?_
    filter_upwards with z
    ring
  have hfinite := continuumFineKernelFiniteSumWeightedPairing_le_lightRayMaximal
    (fineCubeAssignments pieces cubeSets) hδ hA N
    (fun assignment : Sigma fun _ : ι => κ => direction assignment.1)
    (by
      intro assignment hmem
      exact hdirection assignment.1 (hassignment assignment hmem).1)
    (fun assignment z y => kernel assignment.1 assignment.2 z y)
    (fun assignment y => input assignment.2 y) g
    (by
      intro assignment hmem z y
      exact hkernel assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 z y)
    (by
      intro assignment hmem z
      exact hmass assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 z)
    (by
      intro assignment hmem z
      exact hmeas assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 z)
    (by
      intro assignment hmem z
      exact henergy assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 z)
    (by
      intro assignment hmem
      exact htermWeighted assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2)
    (by
      intro assignment hmem
      exact henergyWeighted assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2)
    (by
      intro assignment hmem
      exact hprod assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2)
    (by
      intro assignment hmem y
      exact hRayInt assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 y)
    (by
      intro assignment hmem y
      exact hbounded assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2 y)
    (by
      intro assignment hmem
      exact hmaxWeighted assignment.1 (hassignment assignment hmem).1 assignment.2
        (hassignment assignment hmem).2)
  have hfiniteEnergy :
      (∫ z : WaveSpaceTime,
        (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2) * ‖g z‖ ∂continuumLightRayMeasure) ≤
        A * ∫ y : Euclidean 2,
          continuumFineAssignedCubeWeightedEnergy pieces cubeSets input
            (lightRayMaximal δ N g) y := by
    calc
      (∫ z : WaveSpaceTime,
        (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2) * ‖g z‖ ∂continuumLightRayMeasure) =
          ∫ z : WaveSpaceTime,
            (∑ assignment ∈ fineCubeAssignments pieces cubeSets,
              ‖∫ y : Euclidean 2,
                kernel assignment.1 assignment.2 z y * input assignment.2 y‖ ^ 2) *
              ‖g z‖ ∂continuumLightRayMeasure := by
        apply integral_congr_ae
        filter_upwards with z
        congr 1
        calc
          (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            ‖packet piece cube z‖ ^ 2) =
              ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
                ‖∫ y : Euclidean 2,
                  kernel piece cube z y * input cube y‖ ^ 2 := by
            apply Finset.sum_congr rfl
            intro piece hpiece
            apply Finset.sum_congr rfl
            intro cube hcube
            rw [hpacket piece hpiece cube hcube z]
          _ = ∑ assignment ∈ fineCubeAssignments pieces cubeSets,
              ‖∫ y : Euclidean 2,
                kernel assignment.1 assignment.2 z y * input assignment.2 y‖ ^ 2 := by
            simpa [fineCubeAssignments] using
              (Finset.sum_sigma' pieces cubeSets (fun piece cube =>
                ‖∫ y : Euclidean 2,
                  kernel piece cube z y * input cube y‖ ^ 2))
      _ ≤ A * ∫ y : Euclidean 2,
          (∑ assignment ∈ fineCubeAssignments pieces cubeSets,
            ‖input assignment.2 y‖ ^ 2) * lightRayMaximal δ N g y := hfinite
      _ = A * ∫ y : Euclidean 2,
          continuumFineAssignedCubeWeightedEnergy pieces cubeSets input
            (lightRayMaximal δ N g) y := by
        congr 1
        apply integral_congr_ae
        filter_upwards with y
        unfold continuumFineAssignedCubeWeightedEnergy
          continuumFineAssignedCubeSquareEnergy
        congr 1
        symm
        simpa [fineCubeAssignments] using
          (Finset.sum_sigma' pieces cubeSets (fun _ cube => ‖input cube y‖ ^ 2))
  calc
    (∫ z : WaveSpaceTime,
      (∑ piece ∈ pieces, ‖∑ cube ∈ cubeSets piece, packet piece cube z‖ ^ 2) *
        ‖g z‖ ∂continuumLightRayMeasure) ≤
        ∫ z : WaveSpaceTime,
          (B * (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            ‖packet piece cube z‖ ^ 2)) * ‖g z‖ ∂continuumLightRayMeasure :=
      integral_mono hsquareWeighted hrightWeighted (fun z =>
        mul_le_mul_of_nonneg_right (hpointEnergy z) (norm_nonneg _))
    _ = B * ∫ z : WaveSpaceTime,
        (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖packet piece cube z‖ ^ 2) * ‖g z‖ ∂continuumLightRayMeasure := by
      calc
        (∫ z : WaveSpaceTime,
          (B * (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            ‖packet piece cube z‖ ^ 2)) * ‖g z‖ ∂continuumLightRayMeasure) =
            ∫ z : WaveSpaceTime, B *
              ((∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
                ‖packet piece cube z‖ ^ 2) * ‖g z‖)
              ∂continuumLightRayMeasure := by
          apply integral_congr_ae
          filter_upwards with z
          ring
        _ = B * ∫ z : WaveSpaceTime,
            (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
              ‖packet piece cube z‖ ^ 2) * ‖g z‖
              ∂continuumLightRayMeasure := integral_const_mul _ _
    _ ≤ B * (A * ∫ y : Euclidean 2,
        continuumFineAssignedCubeWeightedEnergy pieces cubeSets input
          (lightRayMaximal δ N g) y) :=
      mul_le_mul_of_nonneg_left hfiniteEnergy hB
    _ = (B * A) * ∫ y : Euclidean 2,
        continuumFineAssignedCubeWeightedEnergy pieces cubeSets input
          (lightRayMaximal δ N g) y := by
      ring

/-- The first finite Cauchy--Schwarz step in the fine square-function proof:
the cube sum within one radial/angular piece costs its number of cubes. -/
theorem sq_norm_finiteFinePiece_le_card_mul_sum_sq {ι κ : Type*}
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (piece : ι) (z : WaveSpaceTime) :
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
      ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
  have hsum_nonneg : 0 ≤ ∑ cube ∈ cubeSets piece,
      ‖finiteFineCubeTerm sources kernel input piece cube z‖ :=
    Finset.sum_nonneg fun cube hcube => norm_nonneg _
  have hnorm :
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ≤
        ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ := by
    unfold finiteFinePiece
    exact norm_sum_le _ _
  calc
    ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
        (∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖) ^ 2 :=
      (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr hnorm
    _ ≤ ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      simpa using
        (sq_sum_le_card_mul_sum_sq (s := cubeSets piece)
          (f := fun cube => ‖finiteFineCubeTerm sources kernel input piece cube z‖))

/-- Boundedly many cubes per piece reduce the original finite fine square
function to the cube-expanded one. -/
theorem sq_finiteFineSquareFunction_le_cubeMultiplicity_mul_sq
    {ι κ : Type*} (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) {B : Real}
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (z : WaveSpaceTime) :
    finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 ≤
      B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 := by
  have hpieceBound : ∀ piece ∈ pieces,
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
        B * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
    intro piece hmem
    have henergy_nonneg : 0 ≤ ∑ cube ∈ cubeSets piece,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
      Finset.sum_nonneg fun cube hcube => sq_nonneg _
    calc
      ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2 ≤
          ((cubeSets piece).card : Real) * ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
        sq_norm_finiteFinePiece_le_card_mul_sum_sq sources cubeSets kernel input piece z
      _ ≤ B * ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 :=
        mul_le_mul_of_nonneg_right (hcard piece hmem) henergy_nonneg
  rw [sq_finiteFineSquareFunction, sq_finiteFineCubeSquareFunction]
  calc
    (∑ piece ∈ pieces,
        ‖finiteFinePiece sources cubeSets kernel input piece z‖ ^ 2) ≤
        ∑ piece ∈ pieces, B * ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro piece hmem
      exact hpieceBound piece hmem
    _ = B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- The complete finite fine-square duality reduction.  Boundedly many cubes
per piece, kernel Cauchy--Schwarz, transposition, and the directional maximum
reduce the dual pairing of the fine square function to a weighted cube
energy.  The only analytic inputs are explicitly displayed as kernel
localization/mass assumptions; no continuum Kakeya estimate is invoked. -/
theorem finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    {ι κ : Type*} {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hpoint : ∀ z ∈ targets,
      finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 * ‖weight z‖ ≤
        (B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2) *
          ‖weight z‖ := by
    intro z hz
    exact mul_le_mul_of_nonneg_right
      (sq_finiteFineSquareFunction_le_cubeMultiplicity_mul_sq
        pieces sources cubeSets kernel input hcard z)
      (norm_nonneg _)
  have hcubePairing :
      (∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖) =
        ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
    calc
      (∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖) =
          ∑ z ∈ targets, (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
            ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2) * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [sq_finiteFineCubeSquareFunction]
      _ = ∑ z ∈ targets, ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro z hz
        rw [Finset.sum_mul]
        apply Finset.sum_congr rfl
        intro piece hpiece
        rw [Finset.sum_mul]
      _ = ∑ piece ∈ pieces, ∑ z ∈ targets, ∑ cube ∈ cubeSets piece,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        exact Finset.sum_comm
      _ = ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
          ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
        apply Finset.sum_congr rfl
        intro piece hpiece
        exact Finset.sum_comm
  have htransposition :
      (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖) ≤
        A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) :=
    sum_sq_norm_finiteFineCubeTerms_mul_norm_le_finiteLightRayMaximal
      hδ hA N pieces sources cubeSets direction kernel input targets weight directions
      hdirections hkernel hmass hdirection
  unfold finiteFineDualPairing
  calc
    (∑ z ∈ targets,
      finiteFineSquareFunction pieces sources cubeSets kernel input z ^ 2 * ‖weight z‖) ≤
        ∑ z ∈ targets,
          (B * finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2) *
            ‖weight z‖ := by
      apply Finset.sum_le_sum
      intro z hz
      exact hpoint z hz
    _ = B * ∑ z ∈ targets,
        finiteFineCubeSquareFunction pieces sources cubeSets kernel input z ^ 2 *
          ‖weight z‖ := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro z hz
      ring
    _ = B * ∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ z ∈ targets,
        ‖finiteFineCubeTerm sources kernel input piece cube z‖ ^ 2 * ‖weight z‖ := by
      rw [hcubePairing]
    _ ≤ B * (A * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left htransposition hB
    _ = (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- The elementary reverse-overlap bound for a finite cube family.  Without
the geometric cube-localization lemma it loses the number of pieces; the MSS
reverse bounded-overlap assertion is precisely what replaces this factor by
an absolute constant. -/
theorem finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (M : Euclidean 2 → Real)
    (henergy : ∀ cube ∈ pieces.biUnion cubeSets,
      0 ≤ ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M ≤
      (pieces.card : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
  classical
  have hpieceBound : ∀ piece ∈ pieces,
      (∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
        ‖input cube y‖ ^ 2 * M y) ≤
        ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
    intro piece hmem
    apply Finset.sum_le_sum_of_subset_of_nonneg
      (fun cube hcube => Finset.mem_biUnion.mpr ⟨piece, hmem, hcube⟩)
    intro cube hcube hnot
    exact henergy cube hcube
  unfold finiteFineAssignedCubeEnergy finiteFineCubeEnergy
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, ∑ y ∈ sources,
      ‖input cube y‖ ^ 2 * M y) ≤
        ∑ _piece ∈ pieces, ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
      apply Finset.sum_le_sum
      intro piece hmem
      exact hpieceBound piece hmem
    _ = (pieces.card : Real) *
        ∑ cube ∈ pieces.biUnion cubeSets, ∑ y ∈ sources,
          ‖input cube y‖ ^ 2 * M y := by
      simp

/-- The finite cube fiber assigned to a specified packet owner.  This is an
explicit finite model: it does not assert that the angular sector geometry
supplies such an owner map. -/
noncomputable def ownerCubeSets {ι κ : Type*}
    (cubes : Finset κ) (owner : κ → ι) (piece : ι) : Finset κ :=
  by
    classical
    exact cubes.filter (fun cube => owner cube = piece)

private theorem mem_ownerCubeSets_iff {ι κ : Type*}
    (cubes : Finset κ) (owner : κ → ι) (piece : ι) (cube : κ) :
    cube ∈ ownerCubeSets cubes owner piece ↔
      cube ∈ cubes ∧ owner cube = piece := by
  classical
  simp [ownerCubeSets]

private theorem biUnion_ownerCubeSets_eq {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces) :
    pieces.biUnion (ownerCubeSets cubes owner) = cubes := by
  classical
  apply Finset.Subset.antisymm
  · intro cube hcube
    rcases Finset.mem_biUnion.mp hcube with ⟨piece, hpiece, hcube⟩
    exact (mem_ownerCubeSets_iff cubes owner piece cube).mp hcube |>.1
  · intro cube hcube
    apply Finset.mem_biUnion.mpr
    refine ⟨owner cube, howner cube hcube, ?_⟩
    exact (mem_ownerCubeSets_iff cubes owner (owner cube) cube).mpr ⟨hcube, rfl⟩

private theorem pairwiseDisjoint_ownerCubeSets {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) :
    (↑pieces : Set ι).PairwiseDisjoint (ownerCubeSets cubes owner) := by
  classical
  intro piece hpiece piece' hpiece' hne
  refine Finset.disjoint_left.mpr ?_
  intro cube hcube hcube'
  have hleft := (mem_ownerCubeSets_iff cubes owner piece cube).mp hcube
  have hright := (mem_ownerCubeSets_iff cubes owner piece' cube).mp hcube'
  apply hne
  exact hleft.2.symm.trans hright.2

private theorem sum_ownerCubeSets_eq {ι κ M : Type*} [AddCommMonoid M]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) (E : κ → M)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces) :
    (∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece, E cube) =
      ∑ cube ∈ cubes, E cube := by
  classical
  rw [← Finset.sum_biUnion (pairwiseDisjoint_ownerCubeSets pieces cubes owner)]
  rw [biUnion_ownerCubeSets_eq pieces cubes owner howner]

/-- An explicit owner partition has reverse cube-overlap exactly one.  The
statement is a finite combinatorial model, conditional only on the supplied
owner map rather than on unformalized sector geometry. -/
theorem hasFiniteFineCubeReverseOverlap_ownerCubeSets
    {ι κ : Type*} [DecidableEq κ]
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι) :
    HasFiniteFineCubeReverseOverlap pieces (ownerCubeSets cubes owner) 1 := by
  classical
  intro cube hcube
  have hsubset : fineCubeAssignmentFiber pieces (ownerCubeSets cubes owner) cube ⊆
      ({⟨owner cube, cube⟩} : Finset (Sigma fun _ : ι => κ)) := by
    rintro ⟨piece, assignedCube⟩ hassignment
    have hassignment' : (piece ∈ pieces ∧
        assignedCube ∈ ownerCubeSets cubes owner piece) ∧ assignedCube = cube := by
      simpa [fineCubeAssignmentFiber, fineCubeAssignments] using hassignment
    have hownerEq : owner assignedCube = piece :=
      (mem_ownerCubeSets_iff cubes owner piece assignedCube).mp hassignment'.1.2 |>.2
    have hassigned : assignedCube = cube := hassignment'.2
    subst assignedCube
    simpa using hownerEq.symm
  exact (Finset.card_le_card hsubset).trans (by simp)

/-- Pointwise, the square energy of an owner-partitioned family of actual
Fourier cubes is exactly the established finite Fourier-cube square function.
No assertion is made that an angular sector decomposition supplies the owner
map. -/
theorem sum_sq_fourierCubeProjection_ownerCubeSets_eq
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
      ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
      fourierCubeSquareFunction cubes m f x ^ 2 := by
  rw [sum_ownerCubeSets_eq pieces cubes owner
    (fun cube => ‖fourierCubeProjection (m cube) f x‖ ^ 2) howner]
  unfold fourierCubeSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun cube hcube => sq_nonneg _

/-- Integrating an explicitly owner-partitioned cube energy gives the
literal frequency-side square energy of the original finite cube family. -/
theorem integral_ownerCubeSquareEnergy_eq_frequency
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (m : κ → SchwartzMap (Euclidean 2) Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫ x : Euclidean 2,
      ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
      ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 := by
  calc
    (∫ x : Euclidean 2,
      ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
        ‖fourierCubeProjection (m cube) f x‖ ^ 2) =
        ∫ x : Euclidean 2, fourierCubeSquareFunction cubes m f x ^ 2 := by
      apply integral_congr_ae
      filter_upwards with x
      exact sum_sq_fourierCubeProjection_ownerCubeSets_eq
        pieces cubes owner howner m f x
    _ = ∫ ξ : Euclidean 2,
        (∑ cube ∈ cubes, ‖m cube ξ‖ ^ 2) *
          ‖𝓕 (f : Euclidean 2 → Complex) ξ‖ ^ 2 :=
      integral_sq_fourierCubeSquareFunction_eq_frequency cubes m f

/-- With a common angular cutoff, the literal owner-fiber packets reconstruct
the packet of the original finite actual-frequency cube family.  This does
not claim that present angular-sector geometry produces the required owner
map or a cubical cover. -/
theorem sum_angularDyadicCubePacket_ownerCubeSets_eq
    {ι κ : Type*}
    (pieces : Finset ι) (cubes : Finset κ) (owner : κ → ι)
    (howner : ∀ cube ∈ cubes, owner cube ∈ pieces)
    (C : lpCutoffs 2) (j : Nat)
    (χ : SchwartzMap (Euclidean 2) Complex)
    (m : κ → SchwartzMap (Euclidean 2) Complex) (ϑ : Real → Complex)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    (∑ piece ∈ pieces,
      angularDyadicCubePacket (ownerCubeSets cubes owner piece)
        C j χ m ϑ f z) =
      angularDyadicCubePacket cubes C j χ m ϑ f z := by
  calc
    (∑ piece ∈ pieces,
      angularDyadicCubePacket (ownerCubeSets cubes owner piece)
        C j χ m ϑ f z) =
        ∑ piece ∈ pieces, ∑ cube ∈ ownerCubeSets cubes owner piece,
          angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
            (χ : Euclidean 2 → Complex) ϑ
            (fourierCubeProjection (m cube) f) z := by
      apply Finset.sum_congr rfl
      intro piece hpiece
      exact angularDyadicCubePacket_eq_sum
        (ownerCubeSets cubes owner piece) C j χ m ϑ f z
    _ = ∑ cube ∈ cubes,
        angularPiece ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0)
          (χ : Euclidean 2 → Complex) ϑ
          (fourierCubeProjection (m cube) f) z :=
      sum_ownerCubeSets_eq pieces cubes owner
        (fun cube => angularPiece ((2 : Real) ^ j)
          (dyadicBandpassMultiplier C.cutoff 0) (χ : Euclidean 2 → Complex) ϑ
          (fourierCubeProjection (m cube) f) z) howner
    _ = angularDyadicCubePacket cubes C j χ m ϑ f z :=
      (angularDyadicCubePacket_eq_sum cubes C j χ m ϑ f z).symm

/-- The finite cube-decomposition and light-ray-kernel localization package
from the MSS fine-kernel lemma.  The four conjuncts are respectively the
bounded number of cubes per piece, pointwise light-ray domination, the
uniform kernel-mass bound, and reverse bounded cube overlap. -/
def fineKernelLocalization {ι κ : Type*} [DecidableEq κ]
    (δ A B : Real) (N D : Nat) (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex) : Prop :=
  (∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B) ∧
    HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel ∧
    HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A ∧
    HasFiniteFineCubeReverseOverlap pieces cubeSets D

/-- The exact finite double-counting identity that rewrites assigned cube
energy as a sum over cube fibers. -/
theorem finiteFineAssignedCubeEnergy_eq_sum_fibers
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M =
      ∑ cube ∈ pieces.biUnion cubeSets,
        ∑ _assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube,
          ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y := by
  classical
  let assignments : Finset (Sigma fun _ : ι => κ) :=
    fineCubeAssignments pieces cubeSets
  let cubes : Finset κ := pieces.biUnion cubeSets
  let E : κ → Real := fun cube => ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y
  have hmaps : ∀ assignment ∈ assignments, assignment.2 ∈ cubes := by
    rintro ⟨piece, cube⟩ hassignment
    have hassignment' : piece ∈ pieces ∧ cube ∈ cubeSets piece := by
      simpa [assignments, fineCubeAssignments] using hassignment
    exact Finset.mem_biUnion.mpr ⟨piece, hassignment'.1, hassignment'.2⟩
  have hfiber := Finset.sum_fiberwise_of_maps_to'
    (s := assignments) (t := cubes) (g := fun assignment : Sigma fun _ : ι => κ => assignment.2)
    hmaps E
  change (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) =
    ∑ cube ∈ cubes, ∑ assignment ∈ assignments with assignment.2 = cube, E cube
  calc
    (∑ piece ∈ pieces, ∑ cube ∈ cubeSets piece, E cube) =
        ∑ assignment ∈ assignments, E assignment.2 := by
      simpa [assignments, fineCubeAssignments] using
        (Finset.sum_sigma' pieces cubeSets (fun _ cube => E cube))
    _ = ∑ cube ∈ cubes, ∑ assignment ∈ assignments with assignment.2 = cube, E cube :=
      hfiber.symm

/-- A finite reverse-overlap bound with the actual maximum fiber
multiplicity, rather than the crude number of pieces. -/
theorem finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy
    {ι κ : Type*} [DecidableEq κ] (pieces : Finset ι)
    (sources : Finset (Euclidean 2)) (cubeSets : ι → Finset κ)
    (input : κ → Euclidean 2 → Complex) (M : Euclidean 2 → Real) (B : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets B)
    (henergy : ∀ cube ∈ pieces.biUnion cubeSets,
      0 ≤ ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M ≤
      (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
  classical
  let E : κ → Real := fun cube => ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y
  have hfiberEq : ∀ cube : κ,
      (∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube) =
        ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
    intro cube
    simp [E]
  calc
    finiteFineAssignedCubeEnergy pieces sources cubeSets input M =
        ∑ cube ∈ pieces.biUnion cubeSets,
          ∑ assignment ∈ fineCubeAssignmentFiber pieces cubeSets cube, E cube := by
      simpa only [E] using
        finiteFineAssignedCubeEnergy_eq_sum_fibers pieces sources cubeSets input M
    _ = ∑ cube ∈ pieces.biUnion cubeSets,
          ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) * E cube := by
      apply Finset.sum_congr rfl
      intro cube hcube
      exact hfiberEq cube
    _ ≤ ∑ cube ∈ pieces.biUnion cubeSets, (B : Real) * E cube := by
      apply Finset.sum_le_sum
      intro cube hcube
      have hmult : ((fineCubeAssignmentFiber pieces cubeSets cube).card : Real) ≤ B := by
        exact_mod_cast hoverlap cube hcube
      exact mul_le_mul_of_nonneg_right hmult (henergy cube hcube)
    _ = (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M := by
      unfold finiteFineCubeEnergy
      rw [Finset.mul_sum]

/-- Specializing the finite reverse-overlap bookkeeping to the nonnegative
finite light-ray maximal weight. -/
theorem finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy_lightRay
    {ι κ : Type*} [DecidableEq κ] {δ : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input
      (finiteLightRayMaximal δ N directions hdirections targets weight) ≤
      (pieces.card : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  apply finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy
  intro cube hcube
  exact Finset.sum_nonneg fun y hy =>
    mul_nonneg (sq_nonneg _)
      (finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y)

/-- The sharp finite reverse-overlap estimate with the supplied cube fiber
bound, specialized to the nonnegative finite light-ray maximal weight. -/
theorem finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy_lightRay
    {ι κ : Type*} [DecidableEq κ] {δ : Real} (hδ : 0 < δ) (N : Nat)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (input : κ → Euclidean 2 → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) (B : Nat)
    (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets B) :
    finiteFineAssignedCubeEnergy pieces sources cubeSets input
      (finiteLightRayMaximal δ N directions hdirections targets weight) ≤
      (B : Real) * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  apply finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy
    pieces sources cubeSets input _ B hoverlap
  intro cube hcube
  exact Finset.sum_nonneg fun y hy =>
    mul_nonneg (sq_nonneg _)
      (finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y)

/-- With bounded cube multiplicity in both directions, the complete finite
fine-square duality calculation has only the two expected constants.  This
is the sharp finite combinatorial version of the MSS reduction to the
light-ray maximal function. -/
theorem finiteFineDualPairing_le_cubeMultiplicities_mul_finiteLightRayEnergy
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A)
    (hB : 0 ≤ B) (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      ((B * A) * (D : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hmain := finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection
  have hreverse :=
    finiteFineAssignedCubeEnergy_le_reverseOverlap_mul_finiteFineCubeEnergy_lightRay
      hδ N pieces sources cubeSets input directions hdirections targets weight D hoverlap
  calc
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hmain
    _ ≤ (B * A) * ((D : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left hreverse (mul_nonneg hB hA)
    _ = ((B * A) * (D : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- Combining the finite fine-square duality reduction with the elementary
reverse-overlap count gives a fully proved, if non-sharp, finite analogue of
the MSS fine square-function estimate. -/
theorem finiteFineDualPairing_le_cubeMultiplicity_card_mul_finiteLightRayEnergy
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real} (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions) :
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
      ((B * A) * (pieces.card : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
  have hmain := finiteFineDualPairing_le_cubeMultiplicity_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection
  have hoverlap := finiteFineAssignedCubeEnergy_le_card_mul_finiteFineCubeEnergy_lightRay
    hδ N pieces sources cubeSets input directions hdirections targets weight
  calc
    finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        (B * A) * finiteFineAssignedCubeEnergy pieces sources cubeSets input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := hmain
    _ ≤ (B * A) * ((pieces.card : Real) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :=
      mul_le_mul_of_nonneg_left hoverlap (mul_nonneg hB hA)
    _ = ((B * A) * (pieces.card : Real)) *
        finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight) := by
      ring

/-- The discrete fourth-power input energy produced by the Fourier-cube
square function in the fine-square argument.  It is the counting-measure
counterpart of `‖∑_κ |P^κ_λ f|²‖²₂`. -/
noncomputable def aux_finiteFineInputQuarticEnergy {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) : Real :=
  ∑ y ∈ sources, (∑ cube ∈ cubes, ‖input cube y‖ ^ 2) ^ 2

/-- The square of the cube energy is controlled by the fourth-power cube
square-function energy and the finite light-ray square energy.  This is the
finite Cauchy--Schwarz/Hölder step immediately after the kernel
transposition in the MSS fine-square proof. -/
theorem aux_sq_finiteFineCubeEnergy_le_inputQuartic_mul_finiteLightRaySquareEnergy
    {κ : Type*} (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) (δ : Real) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (targets : Finset WaveSpaceTime) (weight : WaveSpaceTime → Complex) :
    finiteFineCubeEnergy cubes sources input
        (finiteLightRayMaximal δ N directions hdirections targets weight) ^ 2 ≤
      aux_finiteFineInputQuarticEnergy cubes sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  classical
  let A : Euclidean 2 → Real := fun y =>
    ∑ cube ∈ cubes, ‖input cube y‖ ^ 2
  let M : Euclidean 2 → Real :=
    finiteLightRayMaximal δ N directions hdirections targets weight
  have hcs := Finset.sum_sq_le_sum_mul_sum_of_sq_le_mul sources
    (r := fun y => A y * M y) (f := fun y => A y ^ 2)
    (g := fun y => M y ^ 2)
    (fun y hy => sq_nonneg (A y))
    (fun y hy => sq_nonneg (M y))
    (fun y hy => by
      rw [mul_pow])
  have hrearrange :
      (∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) =
        ∑ y ∈ sources, A y * M y := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro y hy
    dsimp [A]
    rw [Finset.sum_mul]
  change
    (∑ cube ∈ cubes, ∑ y ∈ sources, ‖input cube y‖ ^ 2 * M y) ^ 2 ≤
      (∑ y ∈ sources, A y ^ 2) * ∑ y ∈ sources, M y ^ 2
  rw [hrearrange]
  exact hcs

/-- A generic finite duality conclusion once the kernel reduction has
produced a cube-energy bound.  Its conclusion records the exact point at
which the finite light-ray square energy, and hence the planar Kakeya
estimate in the continuum proof, enters the MSS argument. -/
theorem aux_sq_finiteFineDualPairing_le_of_cubeEnergyBound
    {ι κ : Type*} [DecidableEq κ] {δ C : Real} (hδ : 0 < δ) (hC : 0 ≤ C)
    (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex) (N : Nat)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hbound : finiteFineDualPairing targets weight
      (finiteFineSquareFunction pieces sources cubeSets kernel input) ≤
        C * finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input
          (finiteLightRayMaximal δ N directions hdirections targets weight)) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      C ^ 2 * aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  classical
  let S : WaveSpaceTime → Real :=
    finiteFineSquareFunction pieces sources cubeSets kernel input
  let M : Euclidean 2 → Real :=
    finiteLightRayMaximal δ N directions hdirections targets weight
  let E : Real := finiteFineCubeEnergy (pieces.biUnion cubeSets) sources input M
  have hpairNonneg : 0 ≤ finiteFineDualPairing targets weight S := by
    unfold finiteFineDualPairing
    exact Finset.sum_nonneg fun z hz =>
      mul_nonneg (sq_nonneg (S z)) (norm_nonneg (weight z))
  have hMNonneg : ∀ y : Euclidean 2, 0 ≤ M y := by
    intro y
    exact finiteLightRayMaximal_nonneg hδ N directions hdirections targets weight y
  have hENonneg : 0 ≤ E := by
    unfold E finiteFineCubeEnergy
    exact Finset.sum_nonneg fun cube hcube =>
      Finset.sum_nonneg fun y hy =>
        mul_nonneg (sq_nonneg (‖input cube y‖)) (hMNonneg y)
  have hsquare : finiteFineDualPairing targets weight S ^ 2 ≤ (C * E) ^ 2 := by
    apply (sq_le_sq₀ hpairNonneg (mul_nonneg hC hENonneg)).mpr
    simpa only [S, E, M] using hbound
  have henergy : E ^ 2 ≤
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
    simpa only [E, M] using
      (aux_sq_finiteFineCubeEnergy_le_inputQuartic_mul_finiteLightRaySquareEnergy
        (pieces.biUnion cubeSets) sources input δ N directions hdirections targets weight)
  calc
    finiteFineDualPairing targets weight S ^ 2 ≤ (C * E) ^ 2 := hsquare
    _ = C ^ 2 * E ^ 2 := by ring
    _ ≤ C ^ 2 *
        (aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight) :=
      mul_le_mul_of_nonneg_left henergy (sq_nonneg C)
    _ = C ^ 2 * aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
        finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
      ring

/-- The complete finite fine-square/Kakeya reduction with an explicit
reverse cube-overlap constant.  Replacing the final finite light-ray energy
by the logarithmic continuum Nikodym--Kakeya estimate, and the preceding
quartic input energy by the Fourier-cube square-function estimate, is
exactly the remaining analytic passage to the MSS fine-square theorem. -/
theorem aux_sq_finiteFineDualPairing_le_of_reverseOverlap
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
  have hC : 0 ≤ (B * A) * (D : Real) := by positivity
  apply aux_sq_finiteFineDualPairing_le_of_cubeEnergyBound hδ hC pieces sources cubeSets
    kernel input targets weight N directions hdirections
  exact finiteFineDualPairing_le_cubeMultiplicities_mul_finiteLightRayEnergy
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection D hoverlap

/-- The finite quartic cube-square energy is nonnegative. -/
theorem aux_finiteFineInputQuarticEnergy_nonneg {κ : Type*}
    (cubes : Finset κ) (sources : Finset (Euclidean 2))
    (input : κ → Euclidean 2 → Complex) :
    0 ≤ aux_finiteFineInputQuarticEnergy cubes sources input := by
  unfold aux_finiteFineInputQuarticEnergy
  exact Finset.sum_nonneg fun y hy => sq_nonneg _

/-- The completely unconditional finite version of the MSS fine-square
duality reduction.  All losses are displayed: the only term that must be
replaced to obtain the continuum MSS bound is the crude finite light-ray
square-energy factor on the right. -/
theorem aux_sq_finiteFineDualPairing_le_crude
    {ι κ : Type*} [DecidableEq κ] {δ A B : Real}
    (hδ : 0 < δ) (hA : 0 ≤ A) (hB : 0 ≤ B)
    (N : Nat) (pieces : Finset ι) (sources : Finset (Euclidean 2))
    (cubeSets : ι → Finset κ) (direction : ι → Euclidean 2)
    (kernel : ι → κ → WaveSpaceTime → Euclidean 2 → Complex)
    (input : κ → Euclidean 2 → Complex) (targets : Finset WaveSpaceTime)
    (weight : WaveSpaceTime → Complex)
    (directions : Finset (Euclidean 2)) (hdirections : directions.Nonempty)
    (hcard : ∀ piece ∈ pieces, ((cubeSets piece).card : Real) ≤ B)
    (hkernel : HasFiniteFineKernelLocalization δ N pieces cubeSets direction kernel)
    (hmass : HasFiniteFineKernelMassBound δ N pieces sources cubeSets direction A)
    (hdirection : ∀ piece ∈ pieces, direction piece ∈ directions)
    (D : Nat) (hoverlap : HasFiniteFineCubeReverseOverlap pieces cubeSets D) :
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) := by
  have hmain := aux_sq_finiteFineDualPairing_le_of_reverseOverlap
    hδ hA hB N pieces sources cubeSets direction kernel input targets weight directions
    hdirections hcard hkernel hmass hdirection D hoverlap
  have hkakeya := finiteLightRaySquareEnergy_le_crude hδ N directions sources
    hdirections targets weight
  have hinput : 0 ≤
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input :=
    aux_finiteFineInputQuarticEnergy_nonneg (pieces.biUnion cubeSets) sources input
  have hleft : 0 ≤ ((B * A) * (D : Real)) ^ 2 *
      aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input :=
    mul_nonneg (sq_nonneg _) hinput
  calc
    finiteFineDualPairing targets weight
        (finiteFineSquareFunction pieces sources cubeSets kernel input) ^ 2 ≤
      ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := hmain
    _ = (((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input) *
          finiteLightRaySquareEnergy δ N directions sources hdirections targets weight := by
      ring
    _ ≤ (((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input) *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) :=
      mul_le_mul_of_nonneg_left hkakeya hleft
    _ = ((B * A) * (D : Real)) ^ 2 *
        aux_finiteFineInputQuarticEnergy (pieces.biUnion cubeSets) sources input *
          ((sources.card : Real) * ((δ⁻¹) ^ 2) ^ 2 * (targets.card : Real) *
            ∑ z ∈ targets, ‖weight z‖ ^ 2) := by
      ring

/-- Cauchy--Schwarz on the active ordered-pair fiber in the exact
zero-thickness model.  The coefficient is the literal fiber multiplicity,
so this is the discrete Fourier-side square-function reduction before the
two-circle geometry is inserted. -/
theorem sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_multiplicity_mul_sum_sq
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (Z : WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  calc
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖(fun pair z => F pair.1 z * G pair.2 z) pair z‖ ^ 2 := by
      rw [zeroThicknessPlateOverlapMultiplicity]
      exact sq_sum_le_card_mul_sum_sq
    _ = (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      congr 1
      apply Finset.sum_congr rfl
      intro pair hpair
      rw [norm_mul]
      ring

/-- The genuinely proved zero-thickness overlap estimate in the planar
angular-sector model.  Its factor two is sharp for ordered pairs because of
the swap symmetry at equal radii. -/
theorem sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_two_mul_sum_sq
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (Z : WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
      2 * ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  have hmult :
      (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) ≤ 2 := by
    exact_mod_cast
      zeroThicknessPlateOverlapMultiplicity_le_two_of_angularSectorGeometry
        k Z hscale hgeometry hradius hradius'
  have henergy : 0 ≤
      ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
    Finset.sum_nonneg fun pair hpair =>
      mul_nonneg (sq_nonneg _) (sq_nonneg _)
  calc
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2 ≤
        (zeroThicknessPlateOverlapMultiplicity radius radius' indices directions k Z : Real) *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_multiplicity_mul_sum_sq
        radius radius' indices directions k Z F G z
    _ ≤ 2 * ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 :=
      mul_le_mul_of_nonneg_right hmult henergy

/-- The finite output-frequency square energy of the zero-thickness
pair-sum model.  Summing this quantity is the exact finite analogue of the
Plancherel square-function calculation after resolving output fibers. -/
noncomputable def finiteZeroThicknessOverlapSquareEnergy
    (radius radius' : Real) (indices : Finset Int)
    (directions : Int → Euclidean 2) (k : Nat) (outputs : Finset WaveSpaceTime)
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) : Real :=
  ∑ Z ∈ outputs,
    (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
      ‖F pair.1 z * G pair.2 z‖) ^ 2

/-- Summing the planar multiplicity-two overlap estimate over finitely many
output frequencies.  No unproved thick-plate or Kakeya estimate is hidden:
this is a direct consequence of the zero-thickness two-circle geometry. -/
theorem finiteZeroThicknessOverlapSquareEnergy_le_two_mul_sum
    {scale sectorRadius spacingLower spacingUpper radius radius' : Real}
    {indices : Finset Int} {directions : Int → Euclidean 2} (k : Nat)
    (outputs : Finset WaveSpaceTime) (hscale : 0 < scale)
    (hgeometry : angularSectorGeometry scale indices directions
      sectorRadius spacingLower spacingUpper)
    (hradius : 0 < radius) (hradius' : 0 < radius')
    (F G : Int → WaveSpaceTime → Complex) (z : WaveSpaceTime) :
    finiteZeroThicknessOverlapSquareEnergy radius radius' indices directions k outputs F G z ≤
      2 * ∑ Z ∈ outputs,
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
  unfold finiteZeroThicknessOverlapSquareEnergy
  calc
    (∑ Z ∈ outputs,
      (∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
        ‖F pair.1 z * G pair.2 z‖) ^ 2) ≤
        ∑ Z ∈ outputs, 2 *
          ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
            ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      apply Finset.sum_le_sum
      intro Z hZ
      exact sq_sum_norm_mul_zeroThicknessPlateOverlapPairs_le_two_mul_sum_sq
        k Z hscale hgeometry hradius hradius' F G z
    _ = 2 * ∑ Z ∈ outputs,
        ∑ pair ∈ zeroThicknessPlateOverlapPairs radius radius' indices directions k Z,
          ‖F pair.1 z‖ ^ 2 * ‖G pair.2 z‖ ^ 2 := by
      rw [Finset.mul_sum]

/-- A completely finite model of vertical recombination.  The input is a
family of samples indexed by a radial label and a finite/counting spatial
label; `vertical n` is the discrete analogue of the multiplier
`V_n^λ`.  Values outside `indices` are ignored. -/
noncomputable def finiteVerticalRecombinedOnCounting {σ β : Type*}
    (indices : Finset Int) (vertical : Int → (σ → Complex) → β → Complex)
    (H : Int × σ → Complex) : β → Complex :=
  fun y => ∑ n ∈ indices, vertical n (fun x => H (n, x)) y

/-- The Riesz--Thorin counting-measure lemma gives a concrete `L² → L⁴`
vertical-recombination estimate once the finite model has its `L²` and
`L∞` endpoint bounds.  Unlike the continuum MSS target, this statement is
fully proved; the endpoint assumptions isolate exactly the remaining
multiplier estimates. -/
theorem eLpNorm_four_rpow_two_finiteVerticalRecombinedOnCounting_le_of_two_top
    {σ β : Type*} [MeasurableSpace σ] [MeasurableSingletonClass σ]
    [MeasurableSpace β] {ν : Measure β}
    (indices : Finset Int) (vertical : Int → (σ → Complex) → β → Complex)
    (H : Int × σ → Complex) {A₂ ATop : ENNReal}
    (hmeas : AEStronglyMeasurable
      (finiteVerticalRecombinedOnCounting indices vertical H) ν)
    (hTwo : eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H)
      (2 : ENNReal) ν ≤ A₂ * eLpNorm H (2 : ENNReal) Measure.count)
    (hTop : eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H) ⊤ ν ≤
      ATop * eLpNorm H ⊤ Measure.count) :
    (eLpNorm (finiteVerticalRecombinedOnCounting indices vertical H)
      (4 : ENNReal) ν) ^ (2 : Real) ≤
        (A₂ * ATop) * (eLpNorm H (2 : ENNReal) Measure.count) ^ (2 : Real) := by
  exact eLpNorm_four_rpow_two_le_of_two_top_operator_count
    (T := fun h => finiteVerticalRecombinedOnCounting indices vertical h) H
    hmeas hTwo hTop

/-- The raw finite angular/radial square-function expression before vertical
recombination.  It is a reusable algebraic helper; the canonical MSS object
is `mssFineSquareFunction`, which fixes scale-indexed cutoff data. -/
noncomputable def fineSquareFunction
    (radialIndices angularIndices : Finset Int)
    (radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (f : Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  angularRadialSquareFunction radialIndices angularIndices
    (fun n ν => angularPiece scale a (angularCutoff ν) ϑ
      (radialPiece radialCutoff scale n f))

/-- The geometric and synthesis data needed by the actual MSS fine square
function.  In particular, the angular cutoffs are scale-indexed and their
labels have a separated geometric realization.  This rules out treating an
arbitrary number of duplicated angular packets as one MSS decomposition.

The fields here are structural only: they do not contain a square-function
estimate, a kernel localization bound, or a continuum limit assertion. -/
structure MSSFineAngularData (D : MSSWavefrontCutoffData) where
  sectorRadius : Real
  spacingLower : Real
  spacingUpper : Real
  geometry : ∀ scale : Real, 2 ≤ scale →
    angularSectorGeometry scale (D.angularIndices scale) (D.directions scale)
      sectorRadius spacingLower spacingUpper
  partition_on_active_amplitude : ∀ scale : Real, 2 ≤ scale →
    ∀ xi : Euclidean 2,
      D.radialTime.amplitude (scale⁻¹ • xi) ≠ 0 →
        ∑ nu ∈ D.angularIndices scale, D.chi scale nu xi = 1
  chi_norm_le_one : ∀ scale : Real, 2 ≤ scale →
    ∀ nu ∈ D.angularIndices scale, ∀ xi : Euclidean 2,
      ‖D.chi scale nu xi‖ ≤ 1

/-- The finite radial--angular packet labels at one MSS scale.  Keeping this
as a named finite set makes the cube-incidence condition below use exactly
the same indexing convention as the finite fine-square model. -/
noncomputable def mssFinePieceIndices (D : MSSWavefrontKernelData)
    (scale : Real) : Finset (Int × Int) :=
  (relevantRadialIndexEnumeration scale).product (D.angularIndices scale)

/-- Scale-uniform Fourier-cube decomposition data for the actual smooth
wave-front packet multipliers.

This is deliberately a geometric and symbol-level interface.  It contains
the exact cube synthesis of `spatialProfile`, square overlap of the input
cube cutoffs, bounded packet fibers, reverse cube incidence, ray alignment,
and normalized cutoff derivatives.  It contains no kernel estimate, Kakeya
estimate, square-function estimate, or continuum limiting assertion.

The use of `MSSWavefrontKernelData`, rather than just
`MSSWavefrontCutoffData`, is essential: `spatialProfile` supplies the
Schwartz multiplier which the cube partition reconstructs. -/
structure MSSCubeDecomposition (D : MSSWavefrontKernelData) where
  /-- The scale-independent cube half-width coefficient. -/
  cubeWidth : Real
  cubeWidth_pos : 0 < cubeWidth
  /-- A finite cube type at each scale. -/
  cubeCount : Real → Nat
  /-- Frequency-space center of each cube. -/
  center : ∀ scale : Real, Fin (cubeCount scale) → Euclidean 2
  /-- The smooth input Fourier cutoff attached to each cube. -/
  cutoff : ∀ scale : Real,
    Fin (cubeCount scale) → SchwartzMap (Euclidean 2) Complex
  /-- An enlarged smooth cutoff used to form a Schwartz representative of a
  cube-localized input.  It equals one on the synthesis cutoff in the exact
  multiplicative sense recorded below. -/
  analysisCutoff : ∀ scale : Real,
    Fin (cubeCount scale) → SchwartzMap (Euclidean 2) Complex
  /-- The synthesis cutoff is unchanged after first analyzing with its
  enlarged cutoff.  This is the exact compatibility needed to feed a
  Schwartz cube projection into the literal fine packet. -/
  cutoff_mul_analysisCutoff : ∀ scale : Real, ∀ k : Fin (cubeCount scale),
    ∀ xi : Euclidean 2,
      cutoff scale k xi * analysisCutoff scale k xi = cutoff scale k xi
  /-- The cubes used by one radial--angular packet. -/
  cubeSets : ∀ scale : Real, Int → Int → Finset (Fin (cubeCount scale))
  /-- Each cutoff is supported in a coordinate cube of side comparable to
  `sqrt scale`. -/
  cube_support : ∀ scale : Real, 2 ≤ scale → ∀ k : Fin (cubeCount scale),
    isFourierCubeCutoff (center scale k) (cubeWidth * Real.sqrt scale)
      (cutoff scale k)
  /-- The selected cube cutoffs reconstruct every active smooth packet
  multiplier exactly. -/
  reconstruct_spatialProfile : ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ xi : Euclidean 2,
        ∑ k ∈ cubeSets scale n nu,
          cutoff scale k xi * D.spatialProfile scale n nu xi =
            D.spatialProfile scale n nu xi
  /-- The global input cube family has unit square overlap. -/
  square_overlap : ∀ scale : Real, 2 ≤ scale → ∀ xi : Euclidean 2,
    ∑ k : Fin (cubeCount scale), ‖cutoff scale k xi‖ ^ 2 ≤ 1
  /-- The number of cubes meeting any one packet is uniformly bounded. -/
  cubes_per_packet : ∃ B : Nat, ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      (cubeSets scale n nu).card ≤ B
  /-- A cube can be assigned to only uniformly many active packets. -/
  reverse_overlap : ∃ R : Nat, ∀ scale : Real, 2 ≤ scale →
    HasFiniteFineCubeReverseOverlap (mssFinePieceIndices D scale)
      (fun piece => cubeSets scale piece.1 piece.2) R
  /-- Cubes assigned to a packet remain within `O(sqrt scale)` of its
  radial--angular ray. -/
  center_ne_packet_ray : ∃ C : Real, 0 ≤ C ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ k ∈ cubeSets scale n nu,
        ‖center scale k - ((n : Real) * Real.sqrt scale) •
          D.directions scale nu‖ ≤ C * Real.sqrt scale
  /-- Uniform normalized `L¹` derivative bounds for the cube cutoffs.  This
  is the symbol regularity needed later for nonstationary phase, not an
  operator or square-function estimate. -/
  cutoff_derivative_l1 : ∀ r : Nat, ∃ A : Real, 0 ≤ A ∧
    ∀ scale : Real, 2 ≤ scale → ∀ k : Fin (cubeCount scale),
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real r (cutoff scale k) xi‖) ≤
        A * (cubeWidth * Real.sqrt scale) ^ 2 *
          ((cubeWidth * Real.sqrt scale)⁻¹) ^ r

/-- Regularity data for the enlarged analysis cutoffs of an MSS cube
decomposition.

The analysis cutoffs are deliberately kept separate from the synthesis
cutoffs: the latter need only be absorbed by the former to obtain the exact
packet identity.  In contrast, a Fourier-cube square-function theorem needs
quantitative support, overlap, and symbol bounds for the analysis family
itself.  This structure records those necessary data at a fixed enlarged
cube width.  It does **not** prove a Rubio de Francia estimate, an `L⁴`
bound, or any other square-function theorem. -/
structure MSSAnalysisCubeRegularity (D : MSSWavefrontKernelData)
    (Q : MSSCubeDecomposition D) where
  /-- The scale-independent half-width coefficient for the enlarged
  analysis cubes. -/
  analysisCubeWidth : Real
  analysisCubeWidth_pos : 0 < analysisCubeWidth
  /-- The analysis cubes are genuinely enlarged relative to the synthesis
  cubes. -/
  cubeWidth_le_analysisCubeWidth : Q.cubeWidth ≤ analysisCubeWidth
  /-- Each analysis cutoff is supported in its enlarged coordinate cube. -/
  analysis_cube_support : ∀ scale : Real, 2 ≤ scale →
    ∀ k : Fin (Q.cubeCount scale),
      isFourierCubeCutoff (Q.center scale k)
        (analysisCubeWidth * Real.sqrt scale) (Q.analysisCutoff scale k)
  /-- The uniform Fourier-side square-overlap constant of the analysis
  family. -/
  analysisSquareOverlap : Real
  analysisSquareOverlap_nonneg : 0 ≤ analysisSquareOverlap
  analysis_square_overlap : ∀ scale : Real, 2 ≤ scale → ∀ xi : Euclidean 2,
    ∑ k : Fin (Q.cubeCount scale), ‖Q.analysisCutoff scale k xi‖ ^ 2 ≤
      analysisSquareOverlap
  /-- Uniform normalized L1 derivative bounds for the analysis cutoffs.
  These are symbol data only, not multiplier estimates. -/
  analysis_cutoff_derivative_l1 : ∀ r : Nat, ∃ A : Real, 0 ≤ A ∧
    ∀ scale : Real, 2 ≤ scale → ∀ k : Fin (Q.cubeCount scale),
      (∫ xi : Euclidean 2,
        ‖iteratedFDeriv Real r (Q.analysisCutoff scale k) xi‖) ≤
        A * (analysisCubeWidth * Real.sqrt scale) ^ 2 *
          ((analysisCubeWidth * Real.sqrt scale)⁻¹) ^ r

/-- The scale-uniform signed `L⁴` multiplier hypothesis for the actual cube
cutoffs of an MSS cube decomposition.  Its one constant is uniform in every
`scale ≥ 2`, every finite selected cube family, and every Rademacher signing.

This is only the scalar Fourier-cube input: it makes no square-function,
Kakeya, or MSS fine-estimate assertion. -/
def HasScaleUniformMSSCubeRademacherL4
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ (cubes signs : Finset (Fin (Q.cubeCount scale)))
      (f : SchwartzMap (Euclidean 2) Complex), signs ∈ cubes.powerset →
        Integrable (fun x : Euclidean 2 =>
          ‖finiteRademacherFourierCubeSum cubes signs (Q.cutoff scale) f x‖ ^ (4 : Nat))
            volume ∧
        (∫ x : Euclidean 2,
          ‖finiteRademacherFourierCubeSum cubes signs (Q.cutoff scale) f x‖ ^ (4 : Nat)) ≤
            B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)

/-- The scale-uniform averaged Rademacher fourth-moment input for the actual
cube cutoffs of an MSS cube decomposition.  The finite sum is the total over
all signings, bounded by its cardinality times the proposed scalar `L⁴`
bound.  It is only a conditional form of the cube square-function issue; no
such analytic estimate is asserted here. -/
def HasScaleAverageMSSCubeRademacherL4
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ (cubes : Finset (Fin (Q.cubeCount scale)))
      (f : SchwartzMap (Euclidean 2) Complex),
      (∀ signs ∈ cubes.powerset,
        Integrable (fun x : Euclidean 2 =>
          ‖finiteRademacherFourierCubeSum cubes signs (Q.cutoff scale) f x‖ ^ (4 : Nat))
            volume) ∧
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖finiteRademacherFourierCubeSum cubes signs (Q.cutoff scale) f x‖ ^ (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat))

/-- The scale-uniform finite-family fourth-moment square-function assertion
for the cube cutoffs of an MSS cube decomposition. -/
def uniformScaleMSSCubeSquareFunctionL4
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ (cubes : Finset (Fin (Q.cubeCount scale)))
      (f : SchwartzMap (Euclidean 2) Complex),
        (∫ x : Euclidean 2,
          fourierCubeSquareFunction cubes (Q.cutoff scale) f x ^ (4 : Nat)) ≤
            B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)

/-- The generic finite Rademacher reduction turns the scale-uniform signed
MSS cube hypothesis into the same scale-uniform fourth-moment cube
square-function bound. -/
theorem uniformScaleMSSCubeSquareFunctionL4_of_signed
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D)
    (hsigned : HasScaleUniformMSSCubeRademacherL4 D Q) :
    uniformScaleMSSCubeSquareFunctionL4 D Q := by
  rcases hsigned with ⟨B, hB, hsigned⟩
  refine ⟨B, hB, ?_⟩
  intro scale hscale cubes f
  apply integral_fourth_fourierCubeSquareFunction_le_of_uniform_signed
    cubes (Q.cutoff scale) f
  intro signs hsigns
  exact hsigned scale hscale cubes signs f hsigns

/-- The generic averaged Rademacher reduction turns the scale-uniform
average-sign MSS cube hypothesis into the corresponding scale-uniform
fourth-moment cube square-function bound.  This is not a proof that the
MSS cubes satisfy the supplied average-sign hypothesis. -/
theorem uniformScaleMSSCubeSquareFunctionL4_of_average
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D)
    (haverage : HasScaleAverageMSSCubeRademacherL4 D Q) :
    uniformScaleMSSCubeSquareFunctionL4 D Q := by
  rcases haverage with ⟨B, hB, haverage⟩
  refine ⟨B, hB, ?_⟩
  intro scale hscale cubes f
  exact integral_fourth_fourierCubeSquareFunction_le_of_average
    cubes (Q.cutoff scale) f (haverage scale hscale cubes f)

/-- The scale-uniform averaged Rademacher fourth-moment input for the
enlarged analysis cutoffs of an MSS cube decomposition.  This is a
conditional scalar estimate only; it does not follow from the geometric
cube-decomposition data. -/
def HasScaleAverageMSSAnalysisCubeRademacherL4
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ (cubes : Finset (Fin (Q.cubeCount scale)))
      (f : SchwartzMap (Euclidean 2) Complex),
      (∀ signs ∈ cubes.powerset,
        Integrable (fun x : Euclidean 2 =>
          ‖finiteRademacherFourierCubeSum cubes signs (Q.analysisCutoff scale) f x‖ ^
            (4 : Nat)) volume) ∧
      (∑ signs ∈ cubes.powerset,
        ∫ x : Euclidean 2,
          ‖finiteRademacherFourierCubeSum cubes signs (Q.analysisCutoff scale) f x‖ ^
            (4 : Nat)) ≤
        (cubes.powerset.card : Real) *
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat))

/-- The scale-uniform fourth-moment square-function assertion for the
enlarged analysis cutoffs of an MSS cube decomposition. -/
def uniformScaleMSSAnalysisCubeSquareFunctionL4
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D) : Prop :=
  ∃ B : Real, 0 < B ∧ ∀ scale : Real, 2 ≤ scale →
    ∀ (cubes : Finset (Fin (Q.cubeCount scale)))
      (f : SchwartzMap (Euclidean 2) Complex),
        (∫ x : Euclidean 2,
          fourierCubeSquareFunction cubes (Q.analysisCutoff scale) f x ^ (4 : Nat)) ≤
            B * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)

/-- The finite averaged Khintchine reduction turns the scale-uniform
analysis-cutoff Rademacher hypothesis into the corresponding scale-uniform
fourth-moment square-function bound.  It does not establish that hypothesis
for the analysis family. -/
theorem uniformScaleMSSAnalysisCubeSquareFunctionL4_of_average
    (D : MSSWavefrontKernelData) (Q : MSSCubeDecomposition D)
    (haverage : HasScaleAverageMSSAnalysisCubeRademacherL4 D Q) :
    uniformScaleMSSAnalysisCubeSquareFunctionL4 D Q := by
  rcases haverage with ⟨B, hB, haverage⟩
  refine ⟨B, hB, ?_⟩
  intro scale hscale cubes f
  exact integral_fourth_fourierCubeSquareFunction_le_of_average
    cubes (Q.analysisCutoff scale) f (haverage scale hscale cubes f)

/-- The literal source kernel for one cube in one active MSS fine packet.
It is the inverse Fourier transform of the actual product of the cube cutoff,
the radial--angular packet multiplier, and the plus half-wave multiplier.
No decay, integrability, or source-kernel representation is asserted by this
definition. -/
noncomputable def mssFineCubeHalfWaveKernel (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (scale : Real) (n nu : Int)
    (cube : Fin (cubes.cubeCount scale))
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  D.radialTime.time z.2 * 𝓕⁻ (fun xi : Euclidean 2 =>
    cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
      halfWaveMultiplier WaveSign.plus z.2 xi) (z.1 - y)

/-- The literal unprojected contribution of one selected frequency cube to
one actual MSS fine packet.  Its frequency symbol is exactly the product of
the cube cutoff, the actual radial--angular spatial profile, the Fourier
transform of the Schwartz input, and the plus half-wave multiplier. -/
noncomputable def mssFineCubePacket (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (scale : Real) (n nu : Int)
    (cube : Fin (cubes.cubeCount scale))
    (f : SchwartzMap (Euclidean 2) Complex) : WaveSpaceTime → Complex :=
  fun z => D.radialTime.time z.2 *
    FourierTransform.fourierInv (fun xi : Euclidean 2 =>
      cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
        FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
          halfWaveMultiplier WaveSign.plus z.2 xi) z.1

/-- Under the explicit light-ray slab support condition, a literal fine cube
packet vanishes at every time outside the slab.  This uses only its displayed
outer physical time factor; it makes no spatial support or ray-decay claim. -/
theorem mssFineCubePacket_eq_zero_of_time_not_mem_lightRayTimeInterval
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (hslab : D.HasLightRayTimeSlabSupport)
    (scale : Real) (n nu : Int) (cube : Fin (cubes.cubeCount scale))
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hz : z.2 ∉ lightRayTimeInterval) :
    mssFineCubePacket D cubes scale n nu cube f z = 0 := by
  unfold mssFineCubePacket
  rw [D.time_eq_zero_of_not_mem_lightRayTimeInterval hslab hz]
  simp

/-- The physical support of one literal fine cube packet is contained in the
fixed time slab under the corresponding cutoff support condition.  The result
does not claim compact support in the spatial variables. -/
theorem support_mssFineCubePacket_subset_lightRayTimeSlab
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (hslab : D.HasLightRayTimeSlabSupport)
    (scale : Real) (n nu : Int) (cube : Fin (cubes.cubeCount scale))
    (f : SchwartzMap (Euclidean 2) Complex) :
    Function.support (mssFineCubePacket D cubes scale n nu cube f) ⊆
      {z : WaveSpaceTime | z.2 ∈ lightRayTimeInterval} := by
  intro z hz
  by_contra htime
  exact hz (mssFineCubePacket_eq_zero_of_time_not_mem_lightRayTimeInterval
    D cubes hslab scale n nu cube f z htime)

/-- Feeding the literal fine cube packet the Schwartz representative
obtained from its enlarged analysis cutoff leaves the packet unchanged.
The equality is exact and uses only the cutoff-absorption identity in
`MSSCubeDecomposition`; it is not an analytic square-function estimate. -/
theorem mssFineCubePacket_fourierCubeProjectedSchwartz_analysisCutoff
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (n nu : Int) (cube : Fin (cubes.cubeCount scale))
    (f : SchwartzMap (Euclidean 2) Complex) :
    mssFineCubePacket D cubes scale n nu cube
      (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) =
        mssFineCubePacket D cubes scale n nu cube f := by
  funext z
  unfold mssFineCubePacket
  apply congrArg (fun h : Euclidean 2 → Complex =>
    D.radialTime.time z.2 * FourierTransform.fourierInv h z.1)
  funext xi
  rw [fourier_fourierCubeProjectedSchwartz_apply]
  calc
    cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
        (cubes.analysisCutoff scale cube xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi) *
          halfWaveMultiplier WaveSign.plus z.2 xi =
      (cubes.cutoff scale cube xi * cubes.analysisCutoff scale cube xi) *
        D.spatialProfile scale n nu xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
            halfWaveMultiplier WaveSign.plus z.2 xi := by ring
    _ = cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
        FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
          halfWaveMultiplier WaveSign.plus z.2 xi := by
      rw [cubes.cutoff_mul_analysisCutoff scale cube xi]

/-- The selected cubes synthesize the actual unprojected MSS fine summand
exactly.  The proof uses only the supplied finite reconstruction of the
Schwartz spatial profile; the required inverse-Fourier integrability is
discharged explicitly from the Schwartz product and the unit-modulus,
continuous half-wave multiplier. -/
theorem sum_mssFineCubePacket_eq_mssFineAngularPiece
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (hscale : 2 ≤ scale) (n nu : Int)
    (hn : n ∈ relevantRadialIndexEnumeration scale)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (fun z => ∑ cube ∈ cubes.cubeSets scale n nu,
      mssFineCubePacket D cubes scale n nu cube f z) =
      angularPiece scale (D.radialTime.amplitude : Euclidean 2 → Complex)
        (D.chi scale nu) (D.radialTime.time : Real → Complex)
        (radialPiece (D.radialTime.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) := by
  classical
  have hscale_pos : 0 < scale := by linarith
  have hradialFourier : ∀ xi : Euclidean 2,
      FourierTransform.fourier
          (radialPiece (D.radialTime.radial : Real → Complex) scale n
            (f : Euclidean 2 → Complex)) xi =
        D.radialTime.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi := by
    intro xi
    exact fourier_radialPiece_eq_schwartzProfile_mul_fourier
      (D.radialTime.radial : Real → Complex) scale n
      (scratchRadialSchwartzProfile D.radialTime scale hscale_pos n) f
      (scratchRadialSchwartzProfile_apply D.radialTime scale hscale_pos n) xi
  funext z
  let q : Fin (cubes.cubeCount scale) → Euclidean 2 → Complex :=
    fun cube xi => cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
      FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
        halfWaveMultiplier WaveSign.plus z.2 xi
  have hhalf : Continuous (halfWaveMultiplier WaveSign.plus z.2) := by
    unfold halfWaveMultiplier
    fun_prop
  have hqintegrable : ∀ cube ∈ cubes.cubeSets scale n nu,
      Integrable (q cube) volume := by
    intro cube hcube
    let B : SchwartzMap (Euclidean 2) Complex :=
      SchwartzMap.smulLeftCLM Complex
        (cubes.cutoff scale cube : Euclidean 2 → Complex)
        (SchwartzMap.smulLeftCLM Complex
          (D.spatialProfile scale n nu : Euclidean 2 → Complex)
          (FourierTransform.fourier f))
    have hB : ∀ xi : Euclidean 2, B xi =
        cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi := by
      intro xi
      simp only [B,
        SchwartzMap.smulLeftCLM_apply
          (cubes.cutoff scale cube).hasTemperateGrowth,
        SchwartzMap.smulLeftCLM_apply
          (D.spatialProfile scale n nu).hasTemperateGrowth,
        smul_eq_mul, SchwartzMap.fourier_coe]
      ring
    rw [show q cube = fun xi => B xi * halfWaveMultiplier WaveSign.plus z.2 xi by
      funext xi
      rw [hB xi]]
    refine Integrable.mono' B.integrable.norm ?_ ?_
    · exact (B.continuous.mul hhalf).aestronglyMeasurable
    · filter_upwards with xi
      rw [norm_mul, norm_halfWaveMultiplier, mul_one]
  have hqsum : ∀ xi : Euclidean 2,
      ∑ cube ∈ cubes.cubeSets scale n nu, q cube xi =
        D.spatialProfile scale n nu xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
            halfWaveMultiplier WaveSign.plus z.2 xi := by
    intro xi
    dsimp [q]
    calc
      (∑ cube ∈ cubes.cubeSets scale n nu,
          cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi *
            FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
              halfWaveMultiplier WaveSign.plus z.2 xi) =
          (∑ cube ∈ cubes.cubeSets scale n nu,
            cubes.cutoff scale cube xi * D.spatialProfile scale n nu xi) *
              FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
                halfWaveMultiplier WaveSign.plus z.2 xi := by
            rw [← Finset.sum_mul, ← Finset.sum_mul]
      _ = _ := by
        rw [cubes.reconstruct_spatialProfile scale hscale n hn nu hnu xi]
  have hactual : ∀ xi : Euclidean 2,
      D.spatialProfile scale n nu xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
            halfWaveMultiplier WaveSign.plus z.2 xi =
        D.chi scale nu xi * D.radialTime.amplitude (scale⁻¹ • xi) *
          halfWaveMultiplier WaveSign.plus z.2 xi *
            FourierTransform.fourier
              (radialPiece (D.radialTime.radial : Real → Complex) scale n
                (f : Euclidean 2 → Complex)) xi := by
    intro xi
    rw [D.spatialProfile_apply, hradialFourier xi]
    ring
  unfold mssFineCubePacket angularPiece
  change
    (∑ cube ∈ cubes.cubeSets scale n nu,
      D.radialTime.time z.2 * FourierTransform.fourierInv (q cube) z.1) =
      D.radialTime.time z.2 * FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        D.chi scale nu xi * D.radialTime.amplitude (scale⁻¹ • xi) *
          halfWaveMultiplier WaveSign.plus z.2 xi *
            FourierTransform.fourier
              (radialPiece (D.radialTime.radial : Real → Complex) scale n
                (f : Euclidean 2 → Complex)) xi) z.1
  calc
    (∑ cube ∈ cubes.cubeSets scale n nu,
      D.radialTime.time z.2 * FourierTransform.fourierInv (q cube) z.1) =
        D.radialTime.time z.2 *
          ∑ cube ∈ cubes.cubeSets scale n nu,
            FourierTransform.fourierInv (q cube) z.1 := by
          rw [Finset.mul_sum]
    _ = D.radialTime.time z.2 * FourierTransform.fourierInv
        (fun xi : Euclidean 2 =>
          ∑ cube ∈ cubes.cubeSets scale n nu, q cube xi) z.1 := by
          rw [aux_fourierInv_finset_sum_of_integrable
            (cubes.cubeSets scale n nu) q hqintegrable z.1]
    _ = D.radialTime.time z.2 * FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        D.spatialProfile scale n nu xi *
          FourierTransform.fourier (f : Euclidean 2 → Complex) xi *
            halfWaveMultiplier WaveSign.plus z.2 xi) z.1 := by
          apply congrArg (fun u : Euclidean 2 → Complex =>
            D.radialTime.time z.2 * FourierTransform.fourierInv u z.1)
          funext xi
          exact hqsum xi
    _ = D.radialTime.time z.2 * FourierTransform.fourierInv (fun xi : Euclidean 2 =>
        D.chi scale nu xi * D.radialTime.amplitude (scale⁻¹ • xi) *
          halfWaveMultiplier WaveSign.plus z.2 xi *
            FourierTransform.fourier
              (radialPiece (D.radialTime.radial : Real → Complex) scale n
                (f : Euclidean 2 → Complex)) xi) z.1 := by
          apply congrArg (fun u : Euclidean 2 → Complex =>
            D.radialTime.time z.2 * FourierTransform.fourierInv u z.1)
          funext xi
          exact hactual xi

/-- The selected cube packets still synthesize the actual MSS fine summand
when each cube is fed its own enlarged-analysis Schwartz projection.  This is
the finite packetwise consequence of cutoff absorption and the exact
unprojected synthesis identity. -/
theorem sum_mssFineCubePacket_analysisProjected_eq_mssFineAngularPiece
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (hscale : 2 ≤ scale) (n nu : Int)
    (hn : n ∈ relevantRadialIndexEnumeration scale)
    (hnu : nu ∈ D.angularIndices scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (fun z => ∑ cube ∈ cubes.cubeSets scale n nu,
      mssFineCubePacket D cubes scale n nu cube
        (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z) =
      angularPiece scale (D.radialTime.amplitude : Euclidean 2 → Complex)
        (D.chi scale nu) (D.radialTime.time : Real → Complex)
        (radialPiece (D.radialTime.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) := by
  classical
  calc
    (fun z => ∑ cube ∈ cubes.cubeSets scale n nu,
      mssFineCubePacket D cubes scale n nu cube
        (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z) =
        (fun z => ∑ cube ∈ cubes.cubeSets scale n nu,
          mssFineCubePacket D cubes scale n nu cube f z) := by
      funext z
      apply Finset.sum_congr rfl
      intro cube hcube
      exact congrFun
        (mssFineCubePacket_fourierCubeProjectedSchwartz_analysisCutoff
          D cubes scale n nu cube f) z
    _ = _ := sum_mssFineCubePacket_eq_mssFineAngularPiece
      D cubes scale hscale n nu hn hnu f

/-- Conditional literal kernel localization for the cube decomposition.

The constants `kernelConstant` and `massConstant` are independent of the MSS
scale, active radial--angular packet, and assigned cube.  This is only the
bridge supplied by the missing nonstationary-phase argument: it does not
follow from `MSSCubeDecomposition`, and it contains no square-function,
Kakeya, maximal, or existence assertion. -/
structure MSSFineCubeKernelLocalization (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (N : Nat)
    (kernelConstant massConstant : Real) : Prop where
  kernelConstant_pos : 0 < kernelConstant
  massConstant_nonneg : 0 ≤ massConstant
  source_integrable : ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ cube ∈ cubes.cubeSets scale n nu, ∀ z : WaveSpaceTime,
        Integrable (fun y : Euclidean 2 =>
          mssFineCubeHalfWaveKernel D cubes scale n nu cube z y) volume
  source_representation : ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ cube ∈ cubes.cubeSets scale n nu,
        ∀ f : SchwartzMap (Euclidean 2) Complex, ∀ z : WaveSpaceTime,
          mssFineCubePacket D cubes scale n nu cube f z =
              ∫ y : Euclidean 2,
                mssFineCubeHalfWaveKernel D cubes scale n nu cube z y * f y
  light_ray_dominance : ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ cube ∈ cubes.cubeSets scale n nu, ∀ z : WaveSpaceTime,
        ∀ y : Euclidean 2,
          ‖mssFineCubeHalfWaveKernel D cubes scale n nu cube z y‖ ≤
            kernelConstant *
              lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
                (D.directions scale nu) y z
  source_mass : ∀ scale : Real, 2 ≤ scale →
    ∀ n ∈ relevantRadialIndexEnumeration scale, ∀ nu ∈ D.angularIndices scale,
      ∀ cube ∈ cubes.cubeSets scale n nu, ∀ z : WaveSpaceTime,
        (∫ y : Euclidean 2,
          ‖mssFineCubeHalfWaveKernel D cubes scale n nu cube z y‖) ≤ massConstant

/-- The normalized kernel used to feed a localized MSS cube packet to the
continuum light-ray transposition theorem.  Multiplying the associated input
by the same positive constant below leaves the packet unchanged, while this
kernel has unit light-ray domination. -/
noncomputable def mssFineNormalizedCubeKernel (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (kernelConstant : Real)
    (scale : Real) (n nu : Int) (cube : Fin (cubes.cubeCount scale))
    (z : WaveSpaceTime) (y : Euclidean 2) : Complex :=
  (kernelConstant : Complex)⁻¹ *
    mssFineCubeHalfWaveKernel D cubes scale n nu cube z y

/-- The input paired with `mssFineNormalizedCubeKernel`.  It is the literal
Schwartz analysis projection of `f`, scaled so that the normalized kernel
still represents the original cube packet exactly. -/
noncomputable def mssFineNormalizedCubeInput (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (kernelConstant : Real)
    (scale : Real) (cube : Fin (cubes.cubeCount scale))
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun y => (kernelConstant : Complex) *
    fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f y

/-- Kernel normalization preserves the literal source representation of a
fine cube packet.  This is only scalar algebra applied to the source
representation supplied by `MSSFineCubeKernelLocalization`. -/
theorem mssFineCubePacket_eq_integral_normalizedCubeKernel
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (N : Nat) (kernelConstant massConstant : Real)
    (localization : MSSFineCubeKernelLocalization D cubes N kernelConstant massConstant)
    (scale : Real) (hscale : 2 ≤ scale) (n nu : Int)
    (hn : n ∈ relevantRadialIndexEnumeration scale)
    (hnu : nu ∈ D.angularIndices scale) (cube : Fin (cubes.cubeCount scale))
    (hcube : cube ∈ cubes.cubeSets scale n nu)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime) :
    mssFineCubePacket D cubes scale n nu cube
      (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z =
        ∫ y : Euclidean 2,
          mssFineNormalizedCubeKernel D cubes kernelConstant scale n nu cube z y *
            mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y := by
  have hkernelConstant_ne : (kernelConstant : Complex) ≠ 0 := by
    intro hzero
    apply (ne_of_gt localization.kernelConstant_pos)
    have hreal := congrArg Complex.re hzero
    simpa using hreal
  rw [localization.source_representation scale hscale n hn nu hnu cube hcube
    (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z]
  apply integral_congr_ae
  filter_upwards with y
  unfold mssFineNormalizedCubeKernel mssFineNormalizedCubeInput
  field_simp [hkernelConstant_ne]

/-- After the preceding scalar normalization, the light-ray domination in a
fine cube localization has coefficient one. -/
theorem norm_mssFineNormalizedCubeKernel_le_lightRayKernel
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (N : Nat) (kernelConstant massConstant : Real)
    (localization : MSSFineCubeKernelLocalization D cubes N kernelConstant massConstant)
    (scale : Real) (hscale : 2 ≤ scale) (n nu : Int)
    (hn : n ∈ relevantRadialIndexEnumeration scale)
    (hnu : nu ∈ D.angularIndices scale) (cube : Fin (cubes.cubeCount scale))
    (hcube : cube ∈ cubes.cubeSets scale n nu) (z : WaveSpaceTime)
    (y : Euclidean 2) :
    ‖mssFineNormalizedCubeKernel D cubes kernelConstant scale n nu cube z y‖ ≤
      lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
        (D.directions scale nu) y z := by
  have hκpos : 0 < kernelConstant := localization.kernelConstant_pos
  have hκnonneg : 0 ≤ kernelConstant := hκpos.le
  unfold mssFineNormalizedCubeKernel
  rw [norm_mul, norm_inv, Complex.norm_real, Real.norm_eq_abs,
    abs_of_pos hκpos]
  calc
    kernelConstant⁻¹ * ‖mssFineCubeHalfWaveKernel D cubes scale n nu cube z y‖ ≤
        kernelConstant⁻¹ *
          (kernelConstant * lightRayKernel
            (cubes.cubeWidth * Real.sqrt scale)⁻¹ N (D.directions scale nu) y z) :=
      mul_le_mul_of_nonneg_left
        (localization.light_ray_dominance scale hscale n hn nu hnu cube hcube z y)
        (inv_nonneg.mpr hκnonneg)
    _ = lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
          (D.directions scale nu) y z := by
      field_simp [ne_of_gt hκpos]

/-- The canonical MSS fine square function, attached to the actual
scale-indexed radial-time and angular cutoff data.  The vertical projection
is deliberately absent: this is the fine square function before vertical
recombination. -/
noncomputable def mssFineSquareFunction (D : MSSWavefrontCutoffData)
    (scale : Real) (f : Euclidean 2 → Complex) : WaveSpaceTime → Real :=
  fineSquareFunction (relevantRadialIndexEnumeration scale)
    (D.angularIndices scale) (D.radialTime.radial : Real → Complex)
    (D.chi scale) scale (D.radialTime.amplitude : Euclidean 2 → Complex)
    (D.radialTime.time : Real → Complex) f

/-- The literal fine square function obtained by first feeding every assigned
cube its enlarged-analysis Schwartz projection and then summing its actual
fine cube packets.  This is an exact finite expression, not an estimate. -/
noncomputable def mssFineCubePacketSquareFunction
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (f : SchwartzMap (Euclidean 2) Complex) : WaveSpaceTime → Real :=
  fun z => Real.sqrt (∑ n ∈ relevantRadialIndexEnumeration scale,
    ∑ nu ∈ D.angularIndices scale,
      ‖∑ cube ∈ cubes.cubeSets scale n nu,
        mssFineCubePacket D cubes scale n nu cube
          (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z‖ ^ 2)

/-- The literal regularity/Fubini hypotheses needed to use continuum
transposition for the normalized MSS cube packets at one scale and against
one test function.  This is deliberately a test-function interface: it does
not claim that these hypotheses follow automatically from the geometric
cube data or from a formal source representation. -/
structure MSSFineCubeContinuumRegularity (D : MSSWavefrontKernelData)
    (cubes : MSSCubeDecomposition D) (N : Nat)
    (kernelConstant massConstant scale : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (g : WaveSpaceTime → Complex) : Prop where
  meas : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      ∀ z : WaveSpaceTime,
        AEStronglyMeasurable (fun y : Euclidean 2 =>
          (lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
            (D.directions scale nu) y z)⁻¹ *
            ‖mssFineNormalizedCubeKernel D cubes kernelConstant scale n nu cube z y *
              mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2) volume
  energy : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      ∀ z : WaveSpaceTime,
        Integrable (fun y : Euclidean 2 =>
          lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
            (D.directions scale nu) y z *
            ‖mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2) volume
  termWeighted : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      Integrable (fun z : WaveSpaceTime =>
        ‖∫ y : Euclidean 2,
          mssFineNormalizedCubeKernel D cubes kernelConstant scale n nu cube z y *
            mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2 * ‖g z‖)
          continuumLightRayMeasure
  energyWeighted : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      Integrable (fun z : WaveSpaceTime =>
        (∫ y : Euclidean 2,
          lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
            (D.directions scale nu) y z *
            ‖mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2) * ‖g z‖)
          continuumLightRayMeasure
  prod : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      Integrable (fun p : WaveSpaceTime × Euclidean 2 =>
        lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
          (D.directions scale nu) p.2 p.1 *
          ‖mssFineNormalizedCubeInput D cubes kernelConstant scale cube f p.2‖ ^ 2 *
            ‖g p.1‖) (continuumLightRayMeasure.prod volume)
  ray_integrable : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      ∀ y : Euclidean 2,
        Integrable (fun z : WaveSpaceTime =>
          lightRayKernel (cubes.cubeWidth * Real.sqrt scale)⁻¹ N
            (D.directions scale nu) y z * ‖g z‖) continuumLightRayMeasure
  bounded : ∀ y : Euclidean 2,
    BddAbove ((fun ω : Euclidean 2 =>
      lightRayAverage (cubes.cubeWidth * Real.sqrt scale)⁻¹ N ω y g) ''
        unitLightRayDirections)
  maxWeighted : ∀ (_hscale : 2 ≤ scale), ∀ n ∈ relevantRadialIndexEnumeration scale,
    ∀ nu ∈ D.angularIndices scale, ∀ cube ∈ cubes.cubeSets scale n nu,
      Integrable (fun y : Euclidean 2 =>
        ‖mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2 *
          lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g y) volume
  squareWeighted : Integrable (fun z : WaveSpaceTime =>
    mssFineCubePacketSquareFunction D cubes scale f z ^ 2 * ‖g z‖)
      continuumLightRayMeasure

/-- Squaring the literal fine cube-packet square function removes its outer
square root and exposes the finite radial--angular/cube sum. -/
theorem sq_mssFineCubePacketSquareFunction
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (z : WaveSpaceTime) :
    mssFineCubePacketSquareFunction D cubes scale f z ^ 2 =
      ∑ n ∈ relevantRadialIndexEnumeration scale,
        ∑ nu ∈ D.angularIndices scale,
          ‖∑ cube ∈ cubes.cubeSets scale n nu,
            mssFineCubePacket D cubes scale n nu cube
              (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z‖ ^ 2 := by
  unfold mssFineCubePacketSquareFunction
  rw [Real.sq_sqrt]
  exact Finset.sum_nonneg fun n hn =>
    Finset.sum_nonneg fun nu hnu => sq_nonneg _

/-- The square of the literal fine cube-packet square function written using
the single product index `mssFinePieceIndices`. -/
theorem sq_mssFineCubePacketSquareFunction_eq_pieceSum
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (z : WaveSpaceTime) :
    mssFineCubePacketSquareFunction D cubes scale f z ^ 2 =
      ∑ piece ∈ mssFinePieceIndices D scale,
        ‖∑ cube ∈ cubes.cubeSets scale piece.1 piece.2,
          mssFineCubePacket D cubes scale piece.1 piece.2 cube
            (fourierCubeProjectedSchwartz
              (cubes.analysisCutoff scale cube) f) z‖ ^ 2 := by
  rw [sq_mssFineCubePacketSquareFunction]
  unfold mssFinePieceIndices
  exact (Finset.sum_product (relevantRadialIndexEnumeration scale)
    (D.angularIndices scale) (fun piece : Int × Int =>
      ‖∑ cube ∈ cubes.cubeSets scale piece.1 piece.2,
        mssFineCubePacket D cubes scale piece.1 piece.2 cube
          (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z‖ ^ 2)).symm

/-- The literal MSS specialization of the continuum fine-square
transposition step.  Its right side is still the assigned cube energy;
reverse overlap is deliberately a separate subsequent step.

The threshold on `cubeWidth` is exactly what puts the physical width
`(cubeWidth * sqrt scale)⁻¹` into the range of the light-ray maximal
estimate at every `scale ≥ 2`. -/
theorem mssFineCubePacketSquarePairing_le_lightRayMaximal
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (N : Nat) (kernelConstant massConstant : Real)
    (localization : MSSFineCubeKernelLocalization D cubes N kernelConstant massConstant)
    {scale : Real} (hscale : 2 ≤ scale)
    (hwidth : 2 < cubes.cubeWidth * Real.sqrt 2) (hN : 2 < N)
    (f : SchwartzMap (Euclidean 2) Complex) (g : WaveSpaceTime → Complex)
    (regularity : MSSFineCubeContinuumRegularity D cubes N
      kernelConstant massConstant scale f g) :
    ∃ B : Nat,
      (∫ z : WaveSpaceTime,
        mssFineCubePacketSquareFunction D cubes scale f z ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) *
          ∫ y : Euclidean 2,
            continuumFineAssignedCubeWeightedEnergy
              (mssFinePieceIndices D scale)
              (fun piece => cubes.cubeSets scale piece.1 piece.2)
              (fun cube =>
                mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
              (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y := by
  classical
  rcases cubes.cubes_per_packet with ⟨B, hB⟩
  refine ⟨B, ?_⟩
  have hδ : 0 < (cubes.cubeWidth * Real.sqrt scale)⁻¹ :=
    (cubeWidth_inv_mul_sqrt_pos_lt_half hwidth hscale).1
  have hA : 0 ≤ ∫ u : Euclidean 2, lightRayDecayProfile N u :=
    (lightRayKernel_spatial_mass_bound hδ N hN (0 : Euclidean 2)).1
  have hpieceMem : ∀ piece ∈ mssFinePieceIndices D scale,
      piece.1 ∈ relevantRadialIndexEnumeration scale ∧
        piece.2 ∈ D.angularIndices scale := by
    intro piece hpiece
    simpa [mssFinePieceIndices] using hpiece
  have hsquareWeighted : Integrable (fun z : WaveSpaceTime =>
      (∑ piece ∈ mssFinePieceIndices D scale,
        ‖∑ cube ∈ cubes.cubeSets scale piece.1 piece.2,
          mssFineCubePacket D cubes scale piece.1 piece.2 cube
            (fourierCubeProjectedSchwartz
              (cubes.analysisCutoff scale cube) f) z‖ ^ 2) * ‖g z‖)
        continuumLightRayMeasure := by
    refine regularity.squareWeighted.congr ?_
    filter_upwards with z
    rw [sq_mssFineCubePacketSquareFunction_eq_pieceSum]
  have hgeneric := continuumFineSquarePairing_le_cubeMultiplicity_mul_lightRayMaximal
    (pieces := mssFinePieceIndices D scale)
    (cubeSets := fun piece => cubes.cubeSets scale piece.1 piece.2)
    (δ := (cubes.cubeWidth * Real.sqrt scale)⁻¹)
    (A := ∫ u : Euclidean 2, lightRayDecayProfile N u)
    (B := (B : Real)) hδ hA (Nat.cast_nonneg B) N
    (fun piece => D.directions scale piece.2)
    (fun piece cube z y =>
      mssFineNormalizedCubeKernel D cubes kernelConstant scale piece.1 piece.2 cube z y)
    (fun cube y =>
      mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y)
    (fun piece cube z =>
      mssFineCubePacket D cubes scale piece.1 piece.2 cube
        (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z)
    g
    (by
      intro piece hpiece cube hcube z
      have hmem := hpieceMem piece hpiece
      exact mssFineCubePacket_eq_integral_normalizedCubeKernel
        D cubes N kernelConstant massConstant localization scale hscale piece.1 piece.2
        hmem.1 hmem.2 cube hcube f z)
    (by
      intro piece hpiece
      have hmem := hpieceMem piece hpiece
      exact_mod_cast hB scale hscale piece.1 hmem.1 piece.2 hmem.2)
    (by
      intro piece hpiece
      have hmem := hpieceMem piece hpiece
      exact D.direction_unit scale piece.2 hmem.2)
    (by
      intro piece hpiece cube hcube z y
      have hmem := hpieceMem piece hpiece
      exact norm_mssFineNormalizedCubeKernel_le_lightRayKernel
        D cubes N kernelConstant massConstant localization scale hscale piece.1 piece.2
        hmem.1 hmem.2 cube hcube z y)
    (by
      intro piece hpiece cube hcube z
      have hmem := hpieceMem piece hpiece
      exact (lightRayKernel_spatial_mass_bound hδ N hN
        (D.directions scale piece.2)).2 z)
    (by
      intro piece hpiece cube hcube z
      have hmem := hpieceMem piece hpiece
      exact regularity.meas hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube z)
    (by
      intro piece hpiece cube hcube z
      have hmem := hpieceMem piece hpiece
      exact regularity.energy hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube z)
    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
      exact regularity.termWeighted hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube)
    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
      exact regularity.energyWeighted hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube)
    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
      exact regularity.prod hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube)
    (by
      intro piece hpiece cube hcube y
      have hmem := hpieceMem piece hpiece
      exact regularity.ray_integrable hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube y)
    (by
      intro piece hpiece cube hcube y
      exact regularity.bounded y)
    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
      exact regularity.maxWeighted hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube)
    hsquareWeighted
  calc
    (∫ z : WaveSpaceTime,
      mssFineCubePacketSquareFunction D cubes scale f z ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) =
        ∫ z : WaveSpaceTime,
          (∑ piece ∈ mssFinePieceIndices D scale,
            ‖∑ cube ∈ cubes.cubeSets scale piece.1 piece.2,
              mssFineCubePacket D cubes scale piece.1 piece.2 cube
                (fourierCubeProjectedSchwartz
                  (cubes.analysisCutoff scale cube) f) z‖ ^ 2) * ‖g z‖
          ∂continuumLightRayMeasure := by
      apply integral_congr_ae
      filter_upwards with z
      rw [sq_mssFineCubePacketSquareFunction_eq_pieceSum]
    _ ≤ ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) *
        ∫ y : Euclidean 2,
          continuumFineAssignedCubeWeightedEnergy
            (mssFinePieceIndices D scale)
            (fun piece => cubes.cubeSets scale piece.1 piece.2)
            (fun cube =>
              mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
            (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y := hgeneric

/-- Reverse cube overlap turns the assigned energy in the preceding literal
MSS transposition estimate into the global analysis-cube energy.  The
light-ray maximal operator is still invoked only once, before this purely
finite incidence collapse. -/
theorem mssFineCubePacketSquarePairing_le_lightRayCubeEnergy
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (N : Nat) (kernelConstant massConstant : Real)
    (localization : MSSFineCubeKernelLocalization D cubes N kernelConstant massConstant)
    {scale : Real} (hscale : 2 ≤ scale)
    (hwidth : 2 < cubes.cubeWidth * Real.sqrt 2) (hN : 2 < N)
    (f : SchwartzMap (Euclidean 2) Complex) (g : WaveSpaceTime → Complex)
    (regularity : MSSFineCubeContinuumRegularity D cubes N
      kernelConstant massConstant scale f g) :
    ∃ B R : Nat,
      (∫ z : WaveSpaceTime,
        mssFineCubePacketSquareFunction D cubes scale f z ^ 2 * ‖g z‖
        ∂continuumLightRayMeasure) ≤
        ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) * (R : Real) *
          ∫ y : Euclidean 2,
            continuumFineCubeWeightedEnergy
              (mssFinePieceIndices D scale)
              (fun piece => cubes.cubeSets scale piece.1 piece.2)
              (fun cube =>
                mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
              (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y := by
  classical
  obtain ⟨B, hraw⟩ := mssFineCubePacketSquarePairing_le_lightRayMaximal
    D cubes N kernelConstant massConstant localization hscale hwidth hN f g regularity
  obtain ⟨R, hR⟩ := cubes.reverse_overlap
  refine ⟨B, R, ?_⟩
  have hδ : 0 < (cubes.cubeWidth * Real.sqrt scale)⁻¹ :=
    (cubeWidth_inv_mul_sqrt_pos_lt_half hwidth hscale).1
  have hA : 0 ≤ ∫ u : Euclidean 2, lightRayDecayProfile N u :=
    (lightRayKernel_spatial_mass_bound hδ N hN (0 : Euclidean 2)).1
  have hpieceMem : ∀ piece ∈ mssFinePieceIndices D scale,
      piece.1 ∈ relevantRadialIndexEnumeration scale ∧
        piece.2 ∈ D.angularIndices scale := by
    intro piece hpiece
    simpa [mssFinePieceIndices] using hpiece
  have hweight : ∀ y : Euclidean 2,
      0 ≤ lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g y := by
    intro y
    exact aux_lightRayMaximal_nonneg hδ N g regularity.bounded y
  have hcubeWeighted : ∀ cube ∈
      (mssFinePieceIndices D scale).biUnion
        (fun piece => cubes.cubeSets scale piece.1 piece.2),
      Integrable (fun y : Euclidean 2 =>
        ‖mssFineNormalizedCubeInput D cubes kernelConstant scale cube f y‖ ^ 2 *
          lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g y) volume := by
    intro cube hcube
    obtain ⟨piece, hpiece, hcubePiece⟩ := Finset.mem_biUnion.mp hcube
    have hmem := hpieceMem piece hpiece
    exact regularity.maxWeighted hscale piece.1 hmem.1 piece.2 hmem.2 cube hcubePiece
  have hcollapse := integral_continuumFineAssignedCubeWeightedEnergy_le_reverseOverlap_mul
    (μ := volume) (mssFinePieceIndices D scale)
    (fun piece => cubes.cubeSets scale piece.1 piece.2)
    (fun cube => mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
    (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g)
    hweight R (hR scale hscale) hcubeWeighted
  have hfactor : 0 ≤ (B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u :=
    mul_nonneg (Nat.cast_nonneg B) hA
  calc
    (∫ z : WaveSpaceTime,
      mssFineCubePacketSquareFunction D cubes scale f z ^ 2 * ‖g z‖
      ∂continuumLightRayMeasure) ≤
        ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) *
          ∫ y : Euclidean 2,
            continuumFineAssignedCubeWeightedEnergy
              (mssFinePieceIndices D scale)
              (fun piece => cubes.cubeSets scale piece.1 piece.2)
              (fun cube =>
                mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
              (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y := hraw
    _ ≤ ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) *
        ((R : Real) * ∫ y : Euclidean 2,
          continuumFineCubeWeightedEnergy
            (mssFinePieceIndices D scale)
            (fun piece => cubes.cubeSets scale piece.1 piece.2)
            (fun cube =>
              mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
            (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y) :=
      mul_le_mul_of_nonneg_left hcollapse hfactor
    _ = ((B : Real) * ∫ u : Euclidean 2, lightRayDecayProfile N u) * (R : Real) *
        ∫ y : Euclidean 2,
          continuumFineCubeWeightedEnergy
            (mssFinePieceIndices D scale)
            (fun piece => cubes.cubeSets scale piece.1 piece.2)
            (fun cube =>
              mssFineNormalizedCubeInput D cubes kernelConstant scale cube f)
            (lightRayMaximal (cubes.cubeWidth * Real.sqrt scale)⁻¹ N g) y := by
      ring

/-- The literal analysis-projected cube packet square function is exactly the
canonical MSS fine square function.  The only non-definitional input is the
finite packetwise synthesis identity for each active radial--angular label. -/
theorem mssFineCubePacketSquareFunction_eq_mssFineSquareFunction
    (D : MSSWavefrontKernelData) (cubes : MSSCubeDecomposition D)
    (scale : Real) (hscale : 2 ≤ scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    mssFineCubePacketSquareFunction D cubes scale f =
      mssFineSquareFunction D.toMSSWavefrontCutoffData scale
        (f : Euclidean 2 → Complex) := by
  funext z
  unfold mssFineCubePacketSquareFunction mssFineSquareFunction
    fineSquareFunction angularRadialSquareFunction
  apply congrArg Real.sqrt
  apply Finset.sum_congr rfl
  intro n hn
  apply Finset.sum_congr rfl
  intro nu hnu
  rw [show
    (∑ cube ∈ cubes.cubeSets scale n nu,
      mssFineCubePacket D cubes scale n nu cube
        (fourierCubeProjectedSchwartz (cubes.analysisCutoff scale cube) f) z) =
      angularPiece scale (D.radialTime.amplitude : Euclidean 2 → Complex)
        (D.chi scale nu) (D.radialTime.time : Real → Complex)
        (radialPiece (D.radialTime.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) z by
      exact congrFun
        (sum_mssFineCubePacket_analysisProjected_eq_mssFineAngularPiece
          D cubes scale hscale n nu hn hnu f) z]

/-- The synthesis clause of `MSSFineAngularData` reconstructs one actual
unprojected radial fine summand.  This is only the exact finite Fourier
identity; the required multiplier integrability remains explicit. -/
theorem sum_mssFineAngularPiece_eq_conicOperator
    (D : MSSWavefrontCutoffData) (A : MSSFineAngularData D)
    (scale : Real) (hscale : 2 ≤ scale) (n : Int)
    (f : Euclidean 2 → Complex)
    (hintegrable : ∀ (t : Real) (nu : Int), nu ∈ D.angularIndices scale →
      Integrable (fun xi : Euclidean 2 =>
        D.chi scale nu xi * D.radialTime.amplitude (scale⁻¹ • xi) *
          halfWaveMultiplier WaveSign.plus t xi *
            𝓕 (radialPiece (D.radialTime.radial : Real → Complex) scale n f) xi)
        volume) :
    (fun z => ∑ nu ∈ D.angularIndices scale,
      angularPiece scale (D.radialTime.amplitude : Euclidean 2 → Complex)
        (D.chi scale nu) (D.radialTime.time : Real → Complex)
        (radialPiece (D.radialTime.radial : Real → Complex) scale n f) z) =
      conicOperator scale (D.radialTime.amplitude : Euclidean 2 → Complex)
        (D.radialTime.time : Real → Complex)
        (radialPiece (D.radialTime.radial : Real → Complex) scale n f) := by
  apply sum_angularPiece_eq_conicOperator_of_sum_eq_one_on_support
    (D.angularIndices scale) (D.chi scale) scale
    (D.radialTime.amplitude : Euclidean 2 → Complex)
    (D.radialTime.time : Real → Complex)
    (radialPiece (D.radialTime.radial : Real → Complex) scale n f)
  · intro xi hxi
    apply A.partition_on_active_amplitude scale hscale xi
    intro hzero
    exact hxi (by simp [hzero])
  · exact hintegrable

/-- A legacy raw recombination hypothesis for independently supplied cutoff
families.  It remains useful for the conditional assembly lemmas below, but
is not the structured MSS endpoint route: use `MSSWavefrontKernelData`,
`MSSFineAngularData`, and `MSSCubeDecomposition` for that route. -/
def recombination (radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) : Prop :=
  ∀ η : Real, 0 < η → ∀ N : Nat, ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ (1 / 8 + η)) *
          eLpNorm
            (fineSquareFunction (radialIndices scale) (angularIndices scale)
              radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume +
          ENNReal.ofReal (C * scale ^ (-(N : Real))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- A legacy raw fine-square hypothesis for independently supplied cutoff
families.  It is intentionally only a `Prop`: without scale-indexed angular
geometry and synthesis data it is not an MSS theorem.  The active structured
target is `mssFineSquareFunctionEstimate` in `MSS.lean`. -/
def fineSquareFunctionEstimate
    (radialIndices angularIndices : Real → Finset Int)
    (radialCutoff : Real → Complex)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) : Prop :=
  ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
      eLpNorm
          (fineSquareFunction (radialIndices scale) (angularIndices scale)
            radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
          (4 : ENNReal) volume ≤
        ENNReal.ofReal (C * scale ^ η) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume

/-- The recombination and fine-square inputs combine to the concrete planar
conic `L⁴` estimate at the MSS exponent `1 / 8 + η`.

The two losses are split evenly; the rapidly decaying recombination residual
is absorbed using `scale ≥ 2`. -/
theorem conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    (radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff a ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices
      radialCutoff angularCutoff a ϑ) :
    ∀ η : Real, 0 < η → ∃ C : Real, 0 < C ∧
      ∀ scale : Real, 2 ≤ scale → ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume ≤
          ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  have hηhalf : 0 < η / 2 := by linarith
  rcases hrec (η / 2) hηhalf 0 with ⟨Crec, hCrec, hrec⟩
  rcases hfine (η / 2) hηhalf with ⟨Cfine, hCfine, hfine⟩
  let C : Real := Crec * Cfine + Crec
  have hC : 0 < C := by
    dsimp only [C]
    positivity
  refine ⟨C, hC, ?_⟩
  intro scale hscale f
  have hscalePos : 0 < scale := lt_of_lt_of_le (by norm_num) hscale
  have hscaleNonneg : 0 ≤ scale := hscalePos.le
  have hγ : 0 ≤ (1 / 8 : Real) + η := by linarith
  have hpowγ : 1 ≤ scale ^ ((1 / 8 : Real) + η) :=
    Real.one_le_rpow (by linarith) hγ
  have hpowA : 0 ≤ scale ^ ((1 / 8 : Real) + η / 2) :=
    Real.rpow_nonneg hscaleNonneg _
  have hpowB : 0 ≤ scale ^ (η / 2) := Real.rpow_nonneg hscaleNonneg _
  have hpowZero : 0 ≤ scale ^ (-(0 : Real)) := Real.rpow_nonneg hscaleNonneg _
  have hX : 0 ≤ Crec * scale ^ ((1 / 8 : Real) + η / 2) :=
    mul_nonneg hCrec.le hpowA
  have hZ : 0 ≤ Cfine * scale ^ (η / 2) := mul_nonneg hCfine.le hpowB
  have hY : 0 ≤ Crec * scale ^ (-(0 : Real)) := mul_nonneg hCrec.le hpowZero
  have hpows : scale ^ ((1 / 8 : Real) + η / 2) * scale ^ (η / 2) =
      scale ^ ((1 / 8 : Real) + η) := by
    rw [← Real.rpow_add hscalePos]
    congr 1
    ring
  have hcoeff :
      ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          ENNReal.ofReal (Cfine * scale ^ (η / 2)) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) ≤
      ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) := by
    rw [← ENNReal.ofReal_mul hX, ← ENNReal.ofReal_add (mul_nonneg hX hZ) hY]
    apply ENNReal.ofReal_le_ofReal
    dsimp only [C]
    rw [show (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          (Cfine * scale ^ (η / 2)) =
          (Crec * Cfine) *
            (scale ^ ((1 / 8 : Real) + η / 2) * scale ^ (η / 2)) by ring,
      hpows]
    simp only [Real.rpow_zero, neg_zero, mul_one]
    have hCrecScale : Crec ≤ Crec * scale ^ ((1 / 8 : Real) + η) := by
      simpa using mul_le_mul_of_nonneg_left hpowγ hCrec.le
    calc
      (Crec * Cfine) * scale ^ ((1 / 8 : Real) + η) + Crec ≤
          (Crec * Cfine) * scale ^ ((1 / 8 : Real) + η) +
            Crec * scale ^ ((1 / 8 : Real) + η) :=
        add_le_add_right hCrecScale _
      _ = (Crec * Cfine + Crec) * scale ^ ((1 / 8 : Real) + η) := by ring
  have hrecAt := hrec scale hscale f
  have hfineAt := hfine scale hscale f
  calc
    eLpNorm (conicOperator scale a ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume ≤
        ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
            eLpNorm
              (fineSquareFunction (radialIndices scale) (angularIndices scale)
                radialCutoff angularCutoff scale a ϑ (f : Euclidean 2 → Complex))
              (4 : ENNReal) volume +
          ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      simpa using hrecAt
    _ ≤ ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          (ENNReal.ofReal (Cfine * scale ^ (η / 2)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real))) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      exact add_le_add (mul_le_mul_right hfineAt _) le_rfl
    _ = (ENNReal.ofReal (Crec * scale ^ ((1 / 8 : Real) + η / 2)) *
          ENNReal.ofReal (Cfine * scale ^ (η / 2)) +
        ENNReal.ofReal (Crec * scale ^ (-(0 : Real)))) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by ring
    _ ≤ ENNReal.ofReal (C * scale ^ ((1 / 8 : Real) + η)) *
          eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume :=
      mul_le_mul_left hcoeff _

/-- A scale-`2^j` conic `L⁴` estimate with the level-zero annular amplitude
transfers to the positive dyadic half-wave on the unit time slab.  This is the
concrete scale normal form behind the positive-orientation part of the MSS
local-smoothing estimate.  The negative orientation requires a separately
transported reflected conic estimate. -/
theorem exists_plus_dyadicHalfWaveSpaceTime_L4_bound_of_conicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    ∀ η : Real, 0 < η → ∃ A : Real, 0 < A ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  rcases conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    radialCutoff radialIndices angularIndices angularCutoff
    (dyadicBandpassMultiplier C.cutoff 0) ϑ hrec hfine η hη with ⟨A, hA, hbound⟩
  refine ⟨A, hA, ?_⟩
  intro j hj f
  have hscale : (2 : Real) ≤ (2 : Real) ^ j := by
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hconic := hbound ((2 : Real) ^ j) hscale f
  have hpow : ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η) =
      (2 : Real) ^ ((j : Real) * ((1 / 8 : Real) + η)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : 0 ≤ (2 : Real))]
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume :=
      eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator C ϑ j f hϑ
    _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
        eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
    _ = ENNReal.ofReal (A * (2 : Real) ^
        ((j : Real) * ((1 / 8 : Real) + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
      rw [hpow]

/-- One conic datum whose time cutoff is one on both the positive and
reflected unit slabs supplies the matching dyadic `L⁴` estimate for both
half-wave orientations.  This is a scale-normal-form bridge only: it does
not assert the remaining annular-sector reconstruction or the full MSS
local-smoothing theorem. -/
theorem exists_bothSign_dyadicHalfWaveSpaceTime_L4_bound_of_twoSidedConicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1 ∧ ϑ (-t) = 1)
    (hmeas : ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex,
      AEStronglyMeasurable
        (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
          (f : Euclidean 2 → Complex)) volume)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    ∀ η : Real, 0 < η → ∃ A : Real, 0 < A ∧
      ∀ j : Nat, 1 ≤ j → ∀ f : SchwartzMap (Euclidean 2) Complex,
        ∀ σ : WaveSign,
          eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (4 : ENNReal)
              localSmoothingMeasure ≤
            ENNReal.ofReal (A * (2 : Real) ^
              ((j : Real) * ((1 / 8 : Real) + η))) *
              eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
  intro η hη
  rcases conicL4Estimate_of_recombination_of_fineSquareFunctionEstimate
    radialCutoff radialIndices angularIndices angularCutoff
    (dyadicBandpassMultiplier C.cutoff 0) ϑ hrec hfine η hη with ⟨A, hA, hbound⟩
  refine ⟨A, hA, ?_⟩
  intro j hj f σ
  have hscale : (2 : Real) ≤ (2 : Real) ^ j := by
    calc
      (2 : Real) = 2 ^ 1 := by norm_num
      _ ≤ 2 ^ j := by exact pow_le_pow_right₀ (by norm_num) hj
  have hconic := hbound ((2 : Real) ^ j) hscale f
  have hpow : ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η) =
      (2 : Real) ^ ((j : Real) * ((1 / 8 : Real) + η)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : 0 ≤ (2 : Real))]
  cases σ with
  | plus =>
      calc
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          eLpNorm (conicOperator ((2 : Real) ^ j)
            (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume :=
          eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator C ϑ j f
            (fun t ht => (hϑ t ht).1)
        _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
        _ = ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
          rw [hpow]
  | minus =>
      calc
        eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
            localSmoothingMeasure ≤
          eLpNorm (conicOperator ((2 : Real) ^ j)
            (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
            (4 : ENNReal) volume :=
          eLpNorm_dyadicHalfWaveSpaceTime_minus_le_conicOperator C ϑ j f
            (fun t ht => (hϑ t ht).2) (hmeas j f)
        _ ≤ ENNReal.ofReal (A * ((2 : Real) ^ j) ^ ((1 / 8 : Real) + η)) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := hconic
        _ = ENNReal.ofReal (A * (2 : Real) ^
            ((j : Real) * ((1 / 8 : Real) + η))) *
            eLpNorm (f : Euclidean 2 → Complex) (4 : ENNReal) volume := by
          rw [hpow]

/-- Conditional `p = 4` local smoothing from one two-sided conic datum.
The recombination and fine-square hypotheses remain explicit: this corollary
only assembles their already proved conic `L⁴` consequence with the exact
dyadic scale normal form. -/
theorem p4LocalSmoothing_of_twoSidedConicData
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1 ∧ ϑ (-t) = 1)
    (hmeas : ∀ j : Nat, ∀ f : SchwartzMap (Euclidean 2) Complex,
      AEStronglyMeasurable
        (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
          (f : Euclidean 2 → Complex)) volume)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    p4LocalSmoothing C.cutoff := by
  intro η hη
  rcases exists_bothSign_dyadicHalfWaveSpaceTime_L4_bound_of_twoSidedConicData
    C ϑ radialCutoff radialIndices angularIndices angularCutoff hϑ hmeas hrec hfine η hη with
    ⟨A, hA, hbound⟩
  refine ⟨by norm_num, hη, A, hA, ?_⟩
  intro j hj f σ
  have hexponent :
      (j : Real) * (1 / 2 - 1 / 4 - mssGain 4 + η) =
        (j : Real) * ((1 / 8 : Real) + η) := by
    rw [mssGain_four]
    ring
  rw [hexponent]
  have hfour : ENNReal.ofReal (4 : Real) = (4 : ENNReal) := by norm_num
  rw [hfour]
  exact hbound j hj f σ

/-- A measurable conic time cutoff discharges the global measurability input
in the literal two-sided conic-data route to conditional `p = 4` local
smoothing.  The conic reconstruction and fine-square hypotheses remain
explicit. -/
theorem p4LocalSmoothing_of_twoSidedConicData_of_measurable
    (C : lpCutoffs 2) (ϑ radialCutoff : Real → Complex)
    (radialIndices angularIndices : Real → Finset Int)
    (angularCutoff : Int → Euclidean 2 → Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1 ∧ ϑ (-t) = 1)
    (hϑmeas : Measurable ϑ)
    (hrec : recombination radialCutoff radialIndices angularIndices angularCutoff
      (dyadicBandpassMultiplier C.cutoff 0) ϑ)
    (hfine : fineSquareFunctionEstimate radialIndices angularIndices radialCutoff
      angularCutoff (dyadicBandpassMultiplier C.cutoff 0) ϑ) :
    p4LocalSmoothing C.cutoff := by
  exact p4LocalSmoothing_of_twoSidedConicData C ϑ radialCutoff radialIndices
    angularIndices angularCutoff hϑ
    (fun j f => aestronglyMeasurable_conicOperator_dyadicBandpass C ϑ hϑmeas j f)
    hrec hfine


end
