    (a : SchwartzMap (Euclidean 2) Complex)
    (ha : ∀ xi, a xi ≠ 0 → (1 / 4 : Real) ≤ ‖xi‖ ∧ ‖xi‖ ≤ 4)
    (beta t : SchwartzMap Real Complex)
