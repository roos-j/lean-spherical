    have hh : ‖∫ y : V,K (x-y)*F y i‖ₑ ≤ ∫⁻ y : V,A (x-y)*B y := by
      refine (enorm_integral_le_lintegral_enorm _).trans (lintegral_mono ?_)
      intro y
