    (t0 r : Real) (hr : 0 < r) (hlarge : 64 * r ≤ t0)
    (F : SchwartzMap (Euclidean 2) Complex) (Y : Euclidean 2)
    (hY : |‖Y‖ - t0| ≤ (7 / 2) * r) :
