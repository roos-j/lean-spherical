theorem mssPhysicalRadialWindow_quadratic_inner_fat
    (t0 r x : Real) (hr : 0 < r) (hlarge : 64 * r ≤ t0)
    (hx : 0 ≤ x) (hs : |x - t0| ≤ (7 / 2) * r) :
