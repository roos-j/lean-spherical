/-- Factor the p>4 coefficient so that all dyadic dependence is the positive
power `b^(4 / p)`. -/
private theorem aux_relativeInterpolation_four_top_decay_coefficient_factor
    {p b Btop : Real} (hp : 0 < p) (H : ENNReal) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ =
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
        (ENNReal.ofReal b) ^ (4 / p) := by
  have hinside :
      ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H) =
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) *
          (ENNReal.ofReal b) ^ (4 : Real) := by
    rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num : (0 : Real) ≤ 4)]
    ac_rfl
  rw [hinside, ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1

private theorem aux_relativeInterpolation_four_top_static_finite
    {p Btop : Real} (hp4 : 4 < p) (hBtop : 0 < Btop) :
    ENNReal.ofReal Btop *
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ ≠ ∞ := by
  refine ENNReal.mul_ne_top ENNReal.ofReal_ne_top ?_
  apply ENNReal.rpow_ne_top_of_nonneg
  · exact inv_nonneg.mpr (lt_trans (by norm_num) hp4).le
  apply ENNReal.mul_ne_top
  · exact ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) ENNReal.ofReal_ne_top
    · apply ENNReal.rpow_ne_top_of_nonneg
      · norm_num
      apply ENNReal.inv_ne_top.mpr
      exact ENNReal.ofReal_ne_zero_iff.mpr hBtop
  apply ENNReal.mul_ne_top
  · apply ENNReal.inv_ne_top.mpr
    exact ENNReal.ofReal_ne_zero_iff.mpr (sub_pos.mpr hp4)
  · apply ENNReal.rpow_ne_top_of_nonneg
    · exact sub_nonneg.mpr hp4.le
    · exact ENNReal.ofReal_ne_top

/-- The above-four half of the literal relative-band interpolation bridge. -/
private theorem aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_four_top
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (h4 : HasRelativeCircularBandGeometricDecay 4 C.cutoff)
    {p : Real} (hp4 : 4 < p) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases h4 with ⟨B4, rho4, hB4top, hrho4, h4⟩
  rcases aux_relativeInterpolation_exists_positive_real_geometric_majorant hB4top hrho4 with
    ⟨A, r, hA, hr, hrone, hmajor⟩
  rcases aux_relativeInterpolation_exists_restrictedRelativeBandpass_raw_top_bound C.cutoff with
    ⟨Btop, hBtop, hrawTop⟩
  let θ : Real := 4 / p
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hθ : 0 < θ := by
    dsimp only [θ]
    exact div_pos (by norm_num) hp0
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let static : ENNReal := ENNReal.ofReal Btop *
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹
  let bandConst : ENNReal := static * (ENNReal.ofReal A) ^ θ
  let rho : ENNReal := (ENNReal.ofReal r) ^ θ
  have hstaticTop : static ≠ ∞ := by
    dsimp only [static, H]
    exact aux_relativeInterpolation_four_top_static_finite hp4 hBtop
  have hAtop : (ENNReal.ofReal A) ^ θ ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hbandConstTop : bandConst ≠ ∞ := by
    dsimp only [bandConst]
    exact ENNReal.mul_ne_top hstaticTop hAtop
  have hrho : rho < 1 := by
    dsimp only [rho]
    exact ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr hrone) hθ
  refine ⟨bandConst, rho, hbandConstTop, hrho, ?_⟩
  intro j f
  let b : Real := A * r ^ j
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (pow_pos hr _)
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact ENNReal.toReal_nonneg
  have hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x := by
    intro g h x
    dsimp only [T]
    exact toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_ne_top
      (Ioi (0 : Real)) C.cutoff g h j x
      (fun k => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j k x)
  have hTmeas : ∀ g, AEStronglyMeasurable (T g) volume := by
    intro g
    dsimp only [T]
    exact (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff g C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 4) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 4) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ B4 * rho4 ^ j *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := (h4 j g).2
      _ ≤ ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        mul_le_mul_of_nonneg_right (hmajor j) (by positivity)
      _ = ENNReal.ofReal b *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := rfl
  have hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Btop * a := by
    intro g a ha hga x
    dsimp only [T]
    calc
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal ≤
          (ENNReal.ofReal (Btop * a)).toReal :=
        (ENNReal.toReal_le_toReal
          (aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x) ENNReal.ofReal_ne_top).mpr
          (hrawTop j (Ioi (0 : Real)) g a ha hga x)
      _ = Btop * a := ENNReal.toReal_ofReal (mul_nonneg hBtop.le ha)
  have hinterp := aux_relativeInterpolation_four_top_smooth_interpolation T hTnonneg hTsub hTmeas hp4
    (ENNReal.ofReal b) hstrong4 Btop hBtop hTop f
  have hcoef :
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ =
        static * (ENNReal.ofReal b) ^ θ := by
    dsimp only [static, θ]
    rw [aux_relativeInterpolation_four_top_decay_coefficient_factor hp0 H]
    ac_rfl
  have hinterp' : eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      static * (ENNReal.ofReal b) ^ θ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (T f) (ENNReal.ofReal p) volume ≤
          ENNReal.ofReal Btop *
            (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
              (ENNReal.ofReal b * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        simpa only [H] using hinterp
      _ = static * (ENNReal.ofReal b) ^ θ *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        rw [hcoef]
  have hratepow : ENNReal.ofReal (r ^ ((j : Real) * θ)) = rho ^ j := by
    dsimp only [rho]
    calc
      ENNReal.ofReal (r ^ ((j : Real) * θ)) =
          (ENNReal.ofReal r) ^ ((j : Real) * θ) :=
        (ENNReal.ofReal_rpow_of_pos hr).symm
      _ = (ENNReal.ofReal r) ^ (θ * (j : Real)) := by
        congr 1
        ring
      _ = ((ENNReal.ofReal r) ^ θ) ^ ((j : Real)) :=
        ENNReal.rpow_mul _ θ (j : Real)
      _ = ((ENNReal.ofReal r) ^ θ) ^ j := by
        rw [ENNReal.rpow_natCast]
  have hbrate : (ENNReal.ofReal b) ^ θ =
      (ENNReal.ofReal A) ^ θ * rho ^ j := by
    dsimp only [b]
    rw [aux_relativeInterpolation_ofReal_product_pow_rpow hA hr hθ.le j,
      ENNReal.ofReal_rpow_of_pos hA, hratepow]
  have hnorm :
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal p) volume ≤
        bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal p) volume = eLpNorm (T f) (ENNReal.ofReal p) volume :=
        aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)
      _ ≤ static * (ENNReal.ofReal b) ^ θ *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := hinterp'
      _ = bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        rw [hbrate]
        dsimp only [bandConst]
        ac_rfl
  have hrhoTop : rho ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hfmem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume :=
    f.memLp _ volume
  have hrightTop : bandConst * rho ^ j *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hbandConstTop (ENNReal.pow_ne_top hrhoTop)) hfmem.eLpNorm_ne_top
  have hrealmem : MemLp (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume :=
    Auto.LpSpaceFacts.memLp_of_aestronglyMeasurable_of_eLpNorm_le
      ((measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable)
      (by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)).symm ▸ hnorm)
      (lt_top_iff_ne_top.mpr hrightTop)
  refine ⟨aux_relativeInterpolation_memLp_ennreal_of_memLp_toReal
    (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
    (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j)
    (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x) hrealmem, hnorm⟩

/-- A uniform literal L2 relative-band endpoint and a geometrically decaying
L4 endpoint imply relative circular-band geometric decay at every finite
exponent strictly above two. -/
theorem hasRelativeCircularBandGeometricDecay_all_gt_two_of_uniform
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (B2 : ENNReal) (hB2top : B2 ≠ ∞)
    (h2 : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal 2) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff j f) (ENNReal.ofReal 2) volume ≤
          B2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    (h4 : HasRelativeCircularBandGeometricDecay 4 C.cutoff)
    {p : Real} (hp2 : 2 < p) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases lt_trichotomy p 4 with hp4 | rfl | hp4
  · exact aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_two_four_of_uniform
      C B2 hB2top h2 h4 hp2 hp4
  · exact h4
  · exact aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_four_top C h4 hp4

/-- One positive planar L4 local-smoothing gain, together with the literal
uniform L2 endpoint, gives all finite relative circular-band exponents above
two. -/
theorem hasRelativeCircularBandGeometricDecay_of_positiveLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    {p : Real} (hp : 2 < p) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases exists_memLp_two_and_eLpNorm_restrictedRelativeBandpassSphericalMaximal C with
    ⟨L, _hL, h2⟩
  exact hasRelativeCircularBandGeometricDecay_all_gt_two_of_uniform
    C (ENNReal.ofReal L) ENNReal.ofReal_ne_top h2
    (hasRelativeCircularBandGeometricDecay_four_of_positiveLocalSmoothingGain C hgain) hp

/-- The conditional planar circular maximal theorem at every finite
`p > 2`, from one positive L4 local-smoothing gain and the literal all-radius
relative-band reassembly. -/
theorem hasCircularMaximalSchwartzBound_of_positiveLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    {p : Real} (hp : 2 < p) :
    HasCircularMaximalSchwartzBound p := by
  apply conditionalCircularMaximal (p := p) hp C.cutoff
  · apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) (2 : Real))
    intro xi hxi
    apply C.cutoff_zero xi
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  · exact C.cutoff_one
  · exact C.cutoff_zero
  · exact hasRelativeCircularBandGeometricDecay_of_positiveLocalSmoothingGain C hgain hp

/-- A planar `p = 4` local-smoothing theorem supplies the conditional
circular maximal bound at every finite exponent strictly above two. -/
theorem hasCircularMaximalSchwartzBound_of_p4LocalSmoothing
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (h4 : _root_.Auto.Spherical.MSS.p4LocalSmoothing C.cutoff) :
    ∀ q : Real, 2 < q → HasCircularMaximalSchwartzBound q := by
  intro q hq
  exact hasCircularMaximalSchwartzBound_of_positiveLocalSmoothingGain C
    (_root_.Auto.Spherical.MSS.p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
      h4 (ρ := (1 / 16 : Real)) (by norm_num) (by norm_num)) hq

/-- Bourgain's planar circular maximal theorem, obtained by choosing any
smooth Littlewood--Paley cutoff and applying the unconditional MSS endpoint. -/
theorem bourgainCircularMaximal :
    ∀ q : Real, 2 < q → HasCircularMaximalSchwartzBound q := by
  obtain ⟨C⟩ := _root_.Auto.LittlewoodPaley.exists_lpCutoffs 2
  exact hasCircularMaximalSchwartzBound_of_p4LocalSmoothing C
    (_root_.Auto.Spherical.MSS.p4LocalSmoothing_of_lpCutoffs C)

