        apply ENNReal.ofReal_le_ofReal
        linarith
      _ = ENNReal.ofReal A := rfl
  have hrho : rho ≤ ENNReal.ofReal r := by
    rw [← ENNReal.ofReal_toReal hrhotop]
    apply ENNReal.ofReal_le_ofReal
    dsimp only [r]
    linarith
  refine ⟨A, r, hA, hr, hrone, ?_⟩
  intro j
  calc
    B * rho ^ j ≤ ENNReal.ofReal A * (ENNReal.ofReal r) ^ j := by
      gcongr
    _ = ENNReal.ofReal (A * r ^ j) := by
      rw [← ENNReal.ofReal_pow hr.le, ← ENNReal.ofReal_mul hA.le]

private theorem aux_relativeInterpolation_two_four_uniform_decay_static_finite
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    {B2 : ENNReal} (hB2top : B2 ≠ ∞) :
    (ENNReal.ofReal p *
      ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
        ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
        (ENNReal.ofReal 2) ^ (4 : Real) *
          ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
            (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hp2' : 0 < p - 2 := sub_pos.mpr hp2
  have hp4' : 0 < 4 - p := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.rpow_ne_top_of_nonneg (by norm_num) hB2top
    · apply ENNReal.mul_ne_top
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2')
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
    · apply ENNReal.add_ne_top.mpr
      constructor
      · apply ENNReal.mul_ne_top
        · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
        · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp0)
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')

/-- Interpolate a uniform literal L2 band endpoint with a real-valued
geometrically decaying L4 endpoint at one fixed dyadic band. -/
private theorem aux_relativeInterpolation_relative_band_two_four_uniform_decay_coefficient
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (B2 : ENNReal)
    (h2 : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j g) (ENNReal.ofReal 2) volume ≤
        B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    {A r : Real} (hA : 0 < A) (hr : 0 < r)
    (h4 : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume ≤
      ((ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
          (ENNReal.ofReal 2) ^ (4 : Real) *
            ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
              (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
        (ENNReal.ofReal (A * r ^ j)) ^ (2 - 4 / p)) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g x).toReal
  have hTnonneg : ∀ g x, 0 ≤ T g x := by
    intro g x
    exact ENNReal.toReal_nonneg
  have hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x := by
    intro g h x
    dsimp only [T]
    exact toReal_restrictedRelativeBandpassSphericalMaximal_add_le_of_ne_top
      (Ioi (0 : Real)) C.cutoff g h j x
      (fun k => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j k x)
  have hTmeas : ∀ g, AEStronglyMeasurable (T g) volume := by
    intro g
    dsimp only [T]
    exact (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff g C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable
  let b : Real := A * r ^ j
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (pow_pos hr _)
  have hstrong2 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 2) volume ≤
        B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 2) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 2) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 2) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ B2 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume := h2 j g
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    calc
      eLpNorm (T g) (ENNReal.ofReal 4) volume =
          eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
            C.cutoff j g) (ENNReal.ofReal 4) volume := by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j g)
          (ENNReal.ofReal 4) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j g x)).symm
      _ ≤ ENNReal.ofReal (A * r ^ j) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := h4 j g
      _ = ENNReal.ofReal b *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := rfl
  let H : ENNReal := (ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)
  let L : ENNReal :=
    (ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹
  let K : ENNReal := ENNReal.ofReal p *
    ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) * H +
      (ENNReal.ofReal 2) ^ (4 : Real) * L)
  have hs : 0 < b⁻¹ * b⁻¹ := by positivity
  have hinterp := aux_relativeInterpolation_two_four_smooth_interpolation
    T hTnonneg hTsub hTmeas hp2 hp4
    B2 (ENNReal.ofReal b) hstrong2 hstrong4 (b⁻¹ * b⁻¹) hs f
  have hcoef :
      Auto.Spherical.MSS.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          (B2 ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
        K * (ENNReal.ofReal b) ^ (2 * p - 4) := by
    dsimp only [K]
    exact aux_relativeInterpolation_two_four_uniform_decay_coefficient_factor
      (lt_trans (by norm_num) hp2) hb B2 H L
  have hroot := aux_relativeInterpolation_two_four_uniform_decay_root_factor
    (lt_trans (by norm_num) hp2) K (ENNReal.ofReal b)
  calc
    eLpNorm (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume = eLpNorm (T f) (ENNReal.ofReal p) volume := rfl
    _ ≤ (Auto.Spherical.MSS.sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          (B2 ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      exact hinterp
    _ = (K * (ENNReal.ofReal b) ^ (2 * p - 4)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hcoef]
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b) ^ (2 - 4 / p)) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hroot]
    _ = (ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) * H +
          (ENNReal.ofReal 2) ^ (4 : Real) * L)) ^ p⁻¹ *
        (ENNReal.ofReal b) ^ (2 - 4 / p) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K]
    _ = (ENNReal.ofReal p *
        ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
          ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
          (ENNReal.ofReal 2) ^ (4 : Real) *
            ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
              (ENNReal.ofReal (4 - p))⁻¹))) ^ p⁻¹ *
        (ENNReal.ofReal (A * r ^ j)) ^ (2 - 4 / p) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [H, L, b]

/-- The below-four bridge: a literal uniform all-radius L2 endpoint plus the
geometrically decaying L4 endpoint gives decay at every `2 < p < 4`. -/
private theorem aux_relativeInterpolation_hasRelativeCircularBandGeometricDecay_two_four_of_uniform
    (C : Auto.LittlewoodPaley.lpCutoffs 2)
    (B2 : ENNReal) (hB2top : B2 ≠ ∞)
    (h2 : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal 2) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff j f) (ENNReal.ofReal 2) volume ≤
          B2 * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 2) volume)
    (h4 : HasRelativeCircularBandGeometricDecay 4 C.cutoff)
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4) :
    HasRelativeCircularBandGeometricDecay p C.cutoff := by
  rcases h4 with ⟨B4, rho4, hB4top, hrho4, h4⟩
  rcases aux_relativeInterpolation_exists_positive_real_geometric_majorant hB4top hrho4 with
    ⟨A, r, hA, hr, hrone, hmajor⟩
  let θ : Real := 2 - 4 / p
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hθ : 0 < θ := by
    dsimp only [θ]
    apply sub_pos.mpr
    rw [div_lt_iff₀ hp0]
    nlinarith
  let K : ENNReal := ENNReal.ofReal p *
    ((ENNReal.ofReal 2) ^ (2 : Real) * B2 ^ (2 : Real) *
      ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)) +
      (ENNReal.ofReal 2) ^ (4 : Real) *
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹))
  let bandConst : ENNReal := K ^ p⁻¹ * (ENNReal.ofReal A) ^ θ
  let rho : ENNReal := (ENNReal.ofReal r) ^ θ
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K]
    exact aux_relativeInterpolation_two_four_uniform_decay_static_finite hp2 hp4 hB2top
  have hAtop : (ENNReal.ofReal A) ^ θ ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hbandConstTop : bandConst ≠ ∞ := by
    dsimp only [bandConst]
    exact ENNReal.mul_ne_top hKtop hAtop
  have hrho : rho < 1 := by
    dsimp only [rho]
    exact ENNReal.rpow_lt_one (ENNReal.ofReal_lt_one.mpr hrone) hθ
  refine ⟨bandConst, rho, hbandConstTop, hrho, ?_⟩
  intro j f
  have h4' : ∀ (k : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff k g) (ENNReal.ofReal 4) volume ≤
        ENNReal.ofReal (A * r ^ k) *
          eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro k g
    calc
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff k g) (ENNReal.ofReal 4) volume ≤
          B4 * rho4 ^ k *
            eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := (h4 k g).2
      _ ≤ ENNReal.ofReal (A * r ^ k) *
            eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
        mul_le_mul_of_nonneg_right (hmajor k) (by positivity)
  have hinterp := aux_relativeInterpolation_relative_band_two_four_uniform_decay_coefficient
    C B2 (fun k g => (h2 k g).2) hA hr h4' hp2 hp4 j f
  have hinterp' :
      eLpNorm (fun x =>
        (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
          (ENNReal.ofReal p) volume ≤
        K ^ p⁻¹ * (ENNReal.ofReal (A * r ^ j)) ^ θ *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    simpa only [K, θ] using hinterp
  have hratepow : ENNReal.ofReal (r ^ ((j : Real) * θ)) = rho ^ j := by
    dsimp only [rho]
    calc
      ENNReal.ofReal (r ^ ((j : Real) * θ)) =
          (ENNReal.ofReal r) ^ ((j : Real) * θ) :=
        (ENNReal.ofReal_rpow_of_pos hr).symm
      _ = (ENNReal.ofReal r) ^ (θ * (j : Real)) := by
        congr 1
        ring
      _ = ((ENNReal.ofReal r) ^ θ) ^ ((j : Real)) :=
        ENNReal.rpow_mul _ θ (j : Real)
      _ = ((ENNReal.ofReal r) ^ θ) ^ j := by
        rw [ENNReal.rpow_natCast]
  have hArate : (ENNReal.ofReal (A * r ^ j)) ^ θ =
      (ENNReal.ofReal A) ^ θ * rho ^ j := by
    rw [aux_relativeInterpolation_ofReal_product_pow_rpow hA hr hθ.le j,
      ENNReal.ofReal_rpow_of_pos hA, hratepow]
  have hnorm :
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
        C.cutoff j f) (ENNReal.ofReal p) volume ≤
        bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
          C.cutoff j f) (ENNReal.ofReal p) volume =
          eLpNorm (fun x =>
            (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real))
              C.cutoff j f x).toReal) (ENNReal.ofReal p) volume :=
        aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)
      _ ≤ K ^ p⁻¹ * (ENNReal.ofReal (A * r ^ j)) ^ θ *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := hinterp'
      _ = bandConst * rho ^ j *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
        rw [hArate]
        dsimp only [bandConst]
        ac_rfl
  have hrhoTop : rho ≠ ∞ :=
    ENNReal.rpow_ne_top_of_nonneg hθ.le ENNReal.ofReal_ne_top
  have hfmem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume :=
    f.memLp _ volume
  have hrightTop : bandConst * rho ^ j *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume ≠ ∞ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hbandConstTop (ENNReal.pow_ne_top hrhoTop)) hfmem.eLpNorm_ne_top
  have hrealmem : MemLp (fun x =>
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x).toReal)
        (ENNReal.ofReal p) volume :=
    Auto.LpSpaceFacts.memLp_of_aestronglyMeasurable_of_eLpNorm_le
      ((measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j).ennreal_toReal.aestronglyMeasurable)
      (by
        exact (aux_relativeInterpolation_eLpNorm_ennreal_eq_eLpNorm_toReal_of_forall_ne_top
          (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal p) volume
          (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x)).symm ▸ hnorm)
      (lt_top_iff_ne_top.mpr hrightTop)
  refine ⟨aux_relativeInterpolation_memLp_ennreal_of_memLp_toReal
    (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
    (measurable_restrictedRelativeBandpassSphericalMaximal_global
      (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j)
    (fun x => aux_relativeInterpolation_restrictedRelativeBandpass_ne_top C j f x) hrealmem, hnorm⟩

/-- The generic literal Schwartz-core L4--L∞ source/output interpolation
argument used for the exponents above four. -/
private theorem aux_relativeInterpolation_four_top_smooth_interpolation
    (T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real)
    (hTnonneg : ∀ g x, 0 ≤ T g x)
    (hTsub : ∀ g h x, T (g + h) x ≤ T g x + T h x)
    (hTmeas : ∀ g, AEStronglyMeasurable (T g) volume)
    {p : Real} (hp4 : 4 < p)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (Btop : Real) (hBtop : 0 < Btop)
    (hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ x, T g x ≤ Btop * a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (T f) (ENNReal.ofReal p) volume ≤
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let S : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Real :=
    fun g x => T g x / Btop
  have hSnonneg : ∀ g x, 0 ≤ S g x := by
    intro g x
    exact div_nonneg (hTnonneg g x) hBtop.le
  have hSsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ x, S (g + h) x ≤ S g x + S h x := by
    intro g h _ _ x
    change T (g + h) x / Btop ≤ T g x / Btop + T h x / Btop
    rw [← add_div]
    exact div_le_div_of_nonneg_right (hTsub g h x) hBtop.le
  have hSmeas : ∀ g, g ∈ D → AEStronglyMeasurable (S g) volume := by
    intro g _
    simpa only [S, div_eq_mul_inv] using (hTmeas g).mul_const (Btop⁻¹)
  have hSstrong : ∀ g, g ∈ D →
      eLpNorm (S g) (ENNReal.ofReal 4) volume ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    have hSeq : S g = (Btop⁻¹) • T g := by
      funext x
      change T g x / Btop = Btop⁻¹ * T g x
      field_simp [hBtop.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal 4) volume =
          ENNReal.ofReal (Btop⁻¹) * eLpNorm (T g) (ENNReal.ofReal 4) volume := by
        rw [hSeq, eLpNorm_const_smul]
        rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hBtop.le)]
      _ ≤ ENNReal.ofReal (Btop⁻¹) *
          (B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume) := by
        apply mul_le_mul_right
        calc
          eLpNorm (T g) (ENNReal.ofReal 4) volume ≤
              B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
            hstrong4 g
          _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
        rw [ENNReal.ofReal_inv_of_pos hBtop]
        ac_rfl
  have hSweak : ∀ g, g ∈ D → ∀ {u : Real}, 0 < u →
      (ENNReal.ofReal u) ^ (4 : Real) *
          volume {x | u < S g x} ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ (4 : Real)) := by
    intro g _ u hu
    have hcheb := Auto.Spherical.MSS.sourceOutput_weak_distribution_of_eLpNorm (S g)
      (hSmeas g (by simp [D])) (by norm_num : (0 : Real) < 4) hu
      ((B4 * (ENNReal.ofReal Btop)⁻¹) *
        eLpNorm (eval g) (ENNReal.ofReal 4) volume) (hSstrong g (by simp [D]))
    calc
