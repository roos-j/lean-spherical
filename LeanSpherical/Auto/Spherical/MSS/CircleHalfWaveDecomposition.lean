  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  obtain ⟨A, hA, hbound⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hFint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      Integrable (fun x : Euclidean 2 => ‖F t x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j t
        (zero_le_one.trans ht.1) f
  have hFbound (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hbound j t ht.1 ht.2 f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  change Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2) (ν.prod volume)
  have hmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hFcont.norm.pow 2).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hFint t ht
  · have houter_meas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν :=
      ((hFcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν := by
      apply Integrable.of_bound houter_meas ((A / dyadicScale j) ^ 2 * E)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
      exact hFbound t ht
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter

/-- Integrating the nonstationary fixed-time middle-wave estimate over the
unit time interval preserves its full inverse dyadic-frequency gain. -/
theorem aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContribution_le_dyInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖circleMiddleWaveContribution C j t f x‖ ^ 2) ≤
        (A / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  refine ⟨A, hA, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      volume 1 2 := by
