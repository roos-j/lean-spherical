        hswapF, hswapF']

/-- The sharp stationary estimates for the planar surface Fourier transform
are already available from the circle calculation.  This is the Fourier-side
input for the high-frequency circular argument. -/
theorem circleStationaryPhase : HasCircleSurfaceFourierSharpBounds :=
  hasCircleSurfaceFourierSharpBounds

/-- The literal middle-meridian term in the coordinate circle decomposition
has the expected nonstationary inverse-frequency decay.  This keeps the
remainder quantitative rather than treating it as an unnamed error term. -/
theorem exists_circleMiddleMeridianLocalizedIntegral_decay_one :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 l‖ ≤ C / |l| :=
  Auto.Spherical.OscillatoryIntegralAux.exists_coordinateMiddleMeridianLocalizedIntegral_decay_one 0

/-- Exact angular-meridian normal form for the planar surface Fourier factor.
This is the source-checked Fourier-side decomposition available independently
of the endpoint-amplitude construction. -/
theorem circleSurfaceFourierMeridianNormalForm (xi : Euclidean 2) :
    surfaceFourier 2 xi =
      (surfaceMass 1 : Complex) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          Auto.Spherical.SurfaceMeasureDecay.circleMeridianPhase
            (2 * Real.pi * ‖xi‖) theta :=
  Auto.Spherical.SurfaceMeasureDecay.surfaceFourier_two_meridian xi

/-- Exact outgoing, incoming, and middle coordinate-wave decomposition of
the planar surface Fourier factor.  The endpoint factors are the literal
compact quadratic symbols whose stationary estimates were proved in the
planar stationary-phase foundation; the middle term remains literal for the
subsequent nonstationary analysis. -/
theorem circleSurfaceFourierCoordinateWaveDecomposition (xi : Euclidean 2) :
    surfaceFourier 2 xi =
      (surfaceMass 1 : Complex) *
        (Complex.exp (((-(2 * Real.pi * ‖xi‖) : Real) : Complex) * Complex.I) *
            Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
              (2 * Real.pi * ‖xi‖) +
          Complex.exp (((2 * Real.pi * ‖xi‖ : Real) : Complex) * Complex.I) *
            Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
              (-(2 * Real.pi * ‖xi‖)) +
          Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * ‖xi‖)) := by
  exact Auto.Spherical.OscillatoryIntegralAux.surfaceFourier_two_eq_coordinatePlanarSmoothWaves xi

/-- Exact frequency-localized meridian normal form for a positive-radius
circular average.  This is the source-checked Fourier-side portion of the
blueprint's circle-wave decomposition: the meridian integral is retained
exactly, before the unavailable endpoint-symbol split into outgoing and
incoming half-waves. -/
theorem circleBandpassFourierMeridianNormalForm
    (psi f : SchwartzMap (ℝ^2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t (dyadicBandpassProjection psi f : ℝ^2 → Complex) x =
      ((surfaceMass 2)⁻¹ : Complex) *
        𝓕⁻ (fun xi : Euclidean 2 =>
          ((surfaceMass 1 : Complex) *
            ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
              Auto.Spherical.SurfaceMeasureDecay.circleMeridianPhase
                (2 * Real.pi * (t * ‖xi‖)) theta) *
            (psi xi * 𝓕 (f : Euclidean 2 → Complex) xi)) x := by
  change _root_.Spherical.sphericalAverage t
    (dyadicBandpassProjection psi f : Euclidean 2 → Complex) x = _
  rw [Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
  unfold normalizedSphericalAverage
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  congr 1
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleSurfaceFourierMeridianNormalForm (-t • xi)]
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm]
  unfold dyadicBandpassProjection
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply psi.hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  simp only [smul_eq_mul]

/-- Exact frequency-localized coordinate-wave normal form for a positive-radius
circular average.  Unlike the meridian version, this exposes the literal
outgoing, incoming, and middle pieces of the planar surface Fourier factor.
No multiplier or local-smoothing estimate is used here. -/
theorem circleBandpassFourierCoordinateWaveNormalForm
    (psi f : SchwartzMap (ℝ^2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t (dyadicBandpassProjection psi f : ℝ^2 → Complex) x =
      ((surfaceMass 2)⁻¹ : Complex) *
        𝓕⁻ (fun xi : Euclidean 2 =>
          ((surfaceMass 1 : Complex) *
            (Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
                Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
                  (2 * Real.pi * (t * ‖xi‖)) +
              Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
                Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
                  (-(2 * Real.pi * (t * ‖xi‖))) +
              Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
                0 (2 * Real.pi * (t * ‖xi‖)))) *
            (psi xi * 𝓕 (f : Euclidean 2 → Complex) xi)) x := by
  change _root_.Spherical.sphericalAverage t
    (dyadicBandpassProjection psi f : Euclidean 2 → Complex) x = _
  rw [Auto.Spherical.PowerWeights.sphericalAverage_eq_normalizedSphericalAverage]
  unfold normalizedSphericalAverage
  rw [Auto.Spherical.Auxiliary.sphericalAverage_eq_fourierInv_surfaceMultiplier_schwartz]
  congr 1
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleSurfaceFourierCoordinateWaveDecomposition (-t • xi)]
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm]
  unfold dyadicBandpassProjection
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply psi.hasTemperateGrowth,
    SchwartzMap.fourier_coe]
  simp only [smul_eq_mul]

/-- The stationary endpoint amplitude paired with a half-wave orientation.
The negative half-wave carries the endpoint at positive quadratic frequency,
and conversely. -/
noncomputable def circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (r : Real) : Complex :=
  match σ with
  | .minus =>
      Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral r
  | .plus =>
      Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral (-r)

/-- The dyadic normalization used for the endpoint multipliers in the
circle-wave decomposition. -/
noncomputable def circleEndpointDyadicNormalization (j : Nat) : Complex :=
  (((2 : Real) ^ ((j : Real) / 2) : Real) : Complex)

theorem circleEndpointDyadicNormalization_ne_zero (j : Nat) :
    circleEndpointDyadicNormalization j ≠ 0 := by
  unfold circleEndpointDyadicNormalization
  exact_mod_cast ne_of_gt (Real.rpow_pos_of_pos (by norm_num) _)

/-- The one-dimensional stationary-phase estimate controls both oriented
circle endpoint amplitudes with the same constant. -/
theorem exists_circleEndpointAmplitude_decay :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (r : Real), 1 ≤ r → ‖circleEndpointAmplitude σ r‖ ≤ A / Real.sqrt r := by
  obtain ⟨A, hA, hdecay⟩ :=
    Auto.Spherical.OscillatoryIntegralAux.exists_planarEndpointQuadraticIntegral_decay
  refine ⟨A, hA, ?_⟩
  intro σ r hr
  cases σ with
  | minus =>
      simpa [circleEndpointAmplitude] using hdecay r hr
  | plus =>
      rw [circleEndpointAmplitude,
        Auto.Spherical.OscillatoryIntegralAux.norm_planarEndpointQuadraticIntegral_neg]
      exact hdecay r hr

/-- The absolute value of the dyadic normalization is the square root of
the corresponding dyadic frequency. -/
theorem norm_circleEndpointDyadicNormalization (j : Nat) :
    ‖circleEndpointDyadicNormalization j‖ = Real.sqrt ((2 : Real) ^ j) := by
  unfold circleEndpointDyadicNormalization
  rw [Complex.norm_real, Real.norm_of_nonneg
    (Real.rpow_nonneg (by norm_num) _), Real.sqrt_eq_rpow]
  rw [← Real.rpow_natCast, ← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  congr 1
  ring

/-- A nonzero `j`th dyadic band-pass frequency lies strictly above the
lower edge of its annulus. -/
theorem aux_norm_lt_of_dyadicBandpassMultiplier_ne_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    (2 : Real) ^ j < ‖xi‖ := by
  by_contra hnot
  exact hband
    (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (le_of_not_gt hnot))

/-- On the active dyadic annulus and for positive unit-scale time, the
endpoint stationary frequency dominates the dyadic frequency. -/
theorem aux_dyadicFrequency_le_circleEndpointFrequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) (ht : 1 ≤ t)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    (2 : Real) ^ j ≤ 2 * Real.pi * (t * ‖xi‖) := by
  have hxi : (2 : Real) ^ j ≤ ‖xi‖ :=
    (aux_norm_lt_of_dyadicBandpassMultiplier_ne_zero C j xi hband).le
  have hpi : 1 ≤ 2 * Real.pi := by
    have hpi' := Real.pi_gt_three
    linarith
  have htnorm : ‖xi‖ ≤ t * ‖xi‖ := by
    exact le_mul_of_one_le_left (norm_nonneg xi) ht
  have ht0 : 0 ≤ t := by linarith
  calc
    (2 : Real) ^ j ≤ ‖xi‖ := hxi
    _ ≤ t * ‖xi‖ := htnorm
    _ ≤ 2 * Real.pi * (t * ‖xi‖) :=
      le_mul_of_one_le_left (mul_nonneg ht0 (norm_nonneg xi)) hpi

/-- The stationary square-root denominator dominates the normalizing
dyadic half-power on an active band-pass. -/
theorem aux_norm_circleEndpointDyadicNormalization_le_sqrt_endpointFrequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) (ht : 1 ≤ t)
    (hband : _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0) :
    ‖circleEndpointDyadicNormalization j‖ ≤
      Real.sqrt (2 * Real.pi * (t * ‖xi‖)) := by
  rw [norm_circleEndpointDyadicNormalization]
  exact Real.sqrt_le_sqrt
    (aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband)

/-- The compact frequency-localized multiplier denoted `b_{j,±}` in the
blueprint.  Its low-pass factor is one on the support of the `j`th dyadic
band-pass, but makes the multiplier compactly frequency localized. -/
noncomputable def circleEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun xi =>
    circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
      (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi

/-- The annular version of the circle endpoint multiplier.  The fat dyadic
cutoff is identically one on the active band-pass and removes a neighborhood
of the origin from the endpoint symbol. -/
noncomputable def circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun xi =>
    circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
      (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi

/-- The enlarged cutoff in `circleEndpointMultiplier` gives genuine compact
frequency support. -/
theorem hasCompactSupport_circleEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleEndpointMultiplier C σ j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 3)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 3) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hpow : 0 < (2 : Real) ^ (j + 2) := by positivity
  have htwopow : 2 * (2 : Real) ^ (j + 2) = (2 : Real) ^ (j + 3) := by
    rw [show j + 3 = (j + 2) + 1 by omega, pow_succ]
    ring
  have hscaled : 2 ≤ ‖((2 : Real) ^ (j + 2))⁻¹ • xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
    rw [show ((2 : Real) ^ (j + 2))⁻¹ * ‖xi‖ =
        ‖xi‖ / (2 : Real) ^ (j + 2) by
          rw [div_eq_mul_inv, mul_comm]]
    apply (le_div_iff₀ hpow).mpr
    simpa only [htwopow] using hnorm
  have hcut : C.cutoff (((2 : Real) ^ (j + 2))⁻¹ • xi) = 0 :=
    C.cutoff_zero _ hscaled
  simp [circleEndpointMultiplier,
    _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply, hcut]

/-- A pointwise endpoint-amplitude bound transfers directly to the compact
circle endpoint multiplier. -/
theorem norm_circleEndpointMultiplier_le_of_amplitude_bound
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) (A : Real) (hA : 0 ≤ A)
    (hamp : ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ ≤
      A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) :
    ‖circleEndpointMultiplier C σ j t xi‖ ≤
      ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
        surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by
  have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
  have hcut :
      ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        1 := by
    rw [_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply]
    exact C.norm_le_one _
  have hratio : 0 ≤ A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    div_nonneg hA (Real.sqrt_nonneg _)
  have hinner :
      ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1 := by
    calc
      ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ ≤
        (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ :=
        mul_le_mul_of_nonneg_right hamp (norm_nonneg _)
      _ ≤ (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1 :=
        mul_le_mul_of_nonneg_left hcut hratio
  have houter : 0 ≤
      ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
        surfaceMass 1 := by positivity
  unfold circleEndpointMultiplier
  rw [norm_mul, norm_mul, norm_mul, norm_mul, Complex.norm_real,
    Real.norm_of_nonneg hmass1]
  calc
    ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * ‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖ =
        (‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1) *
          (‖circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi‖) := by ring
    _ ≤ (‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1) * ((A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) * 1) :=
      mul_le_mul_of_nonneg_left hinner houter
    _ = ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by ring

/-- The compact endpoint multipliers are uniformly pointwise bounded on the
active dyadic band-pass for all unit-scale times.  This is only a zero-order
stationary-phase estimate, not a Mikhlin estimate. -/
theorem exists_norm_circleEndpointMultiplier_le_on_dyadicBandpass
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t → t ≤ 2 →
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0 →
        ‖circleEndpointMultiplier C σ j t xi‖ ≤ B := by
  obtain ⟨A, hA, hdecay⟩ := exists_circleEndpointAmplitude_decay
  let B : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
    norm_pos_iff.mpr (inv_ne_zero hmass2)
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  refine ⟨B, mul_pos (mul_pos hinv hmass1) hA, ?_⟩
  intro σ j t xi ht _htop hband
  have hlower : (2 : Real) ^ j ≤ 2 * Real.pi * (t * ‖xi‖) :=
    aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
  have honepow : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hlambda : 1 ≤ 2 * Real.pi * (t * ‖xi‖) := honepow.trans hlower
  have hlambdapos : 0 < 2 * Real.pi * (t * ‖xi‖) :=
    lt_of_lt_of_le zero_lt_one hlambda
  have hamp := hdecay σ (2 * Real.pi * (t * ‖xi‖)) hlambda
  have hpoint := norm_circleEndpointMultiplier_le_of_amplitude_bound
    C σ j t xi A hA.le hamp
  have hnormal : ‖circleEndpointDyadicNormalization j‖ ≤
      Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    aux_norm_circleEndpointDyadicNormalization_le_sqrt_endpointFrequency C j t xi ht hband
  have hsqrtpos : 0 < Real.sqrt (2 * Real.pi * (t * ‖xi‖)) :=
    Real.sqrt_pos.2 hlambdapos
  have hratio : ‖circleEndpointDyadicNormalization j‖ *
      (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) ≤ A := by
    calc
      ‖circleEndpointDyadicNormalization j‖ *
          (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) =
        A * (‖circleEndpointDyadicNormalization j‖ /
          Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := by
        rw [div_eq_mul_inv]
        ring
      _ ≤ A * 1 :=
        mul_le_mul_of_nonneg_left
          ((div_le_iff₀ hsqrtpos).mpr (by simpa using hnormal)) hA.le
      _ = A := by ring
  have hsurface : 0 ≤ ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1 := by positivity
  calc
    ‖circleEndpointMultiplier C σ j t xi‖ ≤
        ‖circleEndpointDyadicNormalization j‖ * ‖((surfaceMass 2)⁻¹ : Complex)‖ *
          surfaceMass 1 * (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖))) := hpoint
    _ = (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) *
          (‖circleEndpointDyadicNormalization j‖ *
            (A / Real.sqrt (2 * Real.pi * (t * ‖xi‖)))) := by ring
    _ ≤ (‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1) * A :=
      mul_le_mul_of_nonneg_left hratio hsurface
    _ = B := by rfl

/-- The enlarged low-pass cutoff is identically one on the support of the
`j`th band-pass multiplier. -/
theorem aux_dyadicLowpassMultiplier_mul_dyadicBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (xi : Euclidean 2) :
    _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [hband, mul_zero]
  · have hxi : ‖xi‖ < (2 : Real) ^ (j + 2) := by
      by_contra hnot
      exact hband
        (_root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C
          (le_of_not_gt hnot))
    have hpow : 0 < (2 : Real) ^ (j + 2) := by positivity
    have hscaled : ‖((2 : Real) ^ (j + 2))⁻¹ • xi‖ ≤ 1 := by
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hpow)]
      rw [show ((2 : Real) ^ (j + 2))⁻¹ * ‖xi‖ =
          ‖xi‖ / (2 : Real) ^ (j + 2) by
            rw [div_eq_mul_inv, mul_comm]]
      exact (div_le_iff₀ hpow).mpr (by simpa using hxi.le)
    have hlow :
        _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi =
          1 := by
      rw [_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier_apply]
      exact C.cutoff_one _ hscaled
    rw [hlow, one_mul]

/-- Exact Fourier-symbol factorization of an endpoint contribution through
the MSS frequency-localized half-wave multiplier.  This is the algebraic
part of the circle-wave decomposition; uniform Mikhlin estimates are a
separate later step. -/
theorem circleEndpointMultiplier_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleEndpointMultiplier C σ j t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  have hnormal : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  unfold circleEndpointMultiplier _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
          (circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
            (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi) *
          (_root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) =
        ((circleEndpointDyadicNormalization j)⁻¹ * circleEndpointDyadicNormalization j) *
          (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi) *
          (_root_.Auto.LittlewoodPaley.dyadicLowpassMultiplier C.cutoff (j + 2) xi *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) := by ring
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
      rw [inv_mul_cancel₀ hnormal,
        aux_dyadicLowpassMultiplier_mul_dyadicBandpassMultiplier]
      ring

/-- Exact endpoint factorization with the annular fat dyadic cutoff.  The
fat cutoff is one on the ordinary dyadic band-pass, so it leaves the endpoint
contribution unchanged while keeping the multiplier away from the origin. -/
theorem circleAnnularEndpointMultiplier_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointMultiplier C σ j t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t xi =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
  have hnormal : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
          circleAnnularEndpointMultiplier C σ j t xi *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t xi =
        ((circleEndpointDyadicNormalization j)⁻¹ * circleEndpointDyadicNormalization j) *
          (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi) *
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
            _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi) := by
      unfold circleAnnularEndpointMultiplier _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol
      ring
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
      rw [inv_mul_cancel₀ hnormal,
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier]
      ring

/-- Both oriented stationary endpoint amplitudes are globally smooth in the
one-dimensional frequency parameter.  The fat annular cutoff below removes
the separate nonsmoothness of `‖xi‖` at the spatial frequency origin. -/
theorem contDiff_circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) :
    ContDiff Real (⊤ : ℕ∞) (circleEndpointAmplitude σ) := by
  cases σ with
  | minus =>
      exact Auto.Spherical.OscillatoryIntegralAux.contDiff_planarEndpointQuadraticIntegral
  | plus =>
      exact Auto.Spherical.OscillatoryIntegralAux.contDiff_planarEndpointQuadraticIntegral.comp
        (by fun_prop)

/-- The literal time derivative of a stationary endpoint amplitude after
evaluation at the half-wave frequency `2π t ‖ξ‖`. -/
noncomputable def circleEndpointAmplitudeTimeDerivative
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real) (ξ : Euclidean 2) : Complex :=
  ((2 * Real.pi * ‖ξ‖ : Real) : Complex) *
    deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖))

/-- The stationary endpoint amplitude has the expected pointwise time
derivative at every fixed frequency.  Together with the half-wave derivative,
this supplies the literal chain-rule input for a temporal sampling argument. -/
theorem hasDerivAt_circleEndpointAmplitude_time
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real) (ξ : Euclidean 2) :
    HasDerivAt
      (fun s : Real => circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) )
      (circleEndpointAmplitudeTimeDerivative σ t ξ) t := by
  have harg : HasDerivAt (fun s : Real => 2 * Real.pi * (s * ‖ξ‖))
      (2 * Real.pi * ‖ξ‖) t := by
    refine (hasDerivAt_iff_hasFDerivAt).mpr ?_
    simpa only [mul_assoc, mul_left_comm, mul_comm] using
      (hasDerivAt_const_mul (2 * Real.pi * ‖ξ‖)).hasFDerivAt
  have hamp : HasDerivAt (circleEndpointAmplitude σ)
      (deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖)))
      (2 * Real.pi * (t * ‖ξ‖)) := by
    apply ((contDiff_circleEndpointAmplitude σ).contDiffAt.differentiableAt
      (by norm_num)).hasDerivAt
  apply (hasDerivAt_iff_hasFDerivAt).mpr
  have hcomp := HasFDerivAt.comp t hamp.hasFDerivAt harg.hasFDerivAt
  have hfun : (circleEndpointAmplitude σ) ∘
      (fun s : Real => 2 * Real.pi * (s * ‖ξ‖)) =
      fun s : Real => circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) := rfl
  rw [hfun] at hcomp
  have hmap :
      (ContinuousLinearMap.toSpanSingleton Real
        (deriv (circleEndpointAmplitude σ) (2 * Real.pi * (t * ‖ξ‖))) ∘SL
        ContinuousLinearMap.toSpanSingleton Real (2 * Real.pi * ‖ξ‖)) =
      ContinuousLinearMap.toSpanSingleton Real
        (circleEndpointAmplitudeTimeDerivative σ t ξ) := by
    ext
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.toSpanSingleton_apply,
      circleEndpointAmplitudeTimeDerivative, Complex.real_smul, smul_eq_mul, one_smul]
    push_cast
    ring_nf
  rw [hmap] at hcomp
  exact hcomp

open Auto.Spherical.OscillatoryIntegralAux in
/-- The parameter derivatives of either oriented circle endpoint obey the
same absolute-frequency stationary-phase scale. -/
theorem exists_iteratedDeriv_circleEndpointAmplitude_abs_decay
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (r : Real), 1 ≤ |r| →
      ‖iteratedDeriv k (circleEndpointAmplitude σ) r‖ ≤
        A / Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale
          (2 * k) |r| := by
  obtain ⟨A, hA, hdecay⟩ :=
    exists_iteratedDeriv_planarEndpointQuadraticIntegral_abs_decay k
  refine ⟨A, hA, ?_⟩
  intro σ r hr
  cases σ with
  | minus =>
      change ‖iteratedDeriv k
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral r‖ ≤ _
      exact hdecay r hr
  | plus =>
      rw [show circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus =
          fun s : Real =>
            Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral (-s) by rfl,
        iteratedDeriv_comp_neg]
      simpa only [norm_smul, Real.norm_eq_abs, abs_pow, abs_neg, abs_one,
        one_pow, one_mul] using hdecay (-r) (by simpa using hr)

/-- The radial endpoint factor after rescaling the `j`th annulus to unit
frequency.  This records the exact dyadic normalization before multiplying
by the fixed fat Schwartz cutoff. -/
noncomputable def circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Real → Complex :=
  fun ρ =>
    circleEndpointDyadicNormalization j *
      circleEndpointAmplitude σ ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)

/-- Exact radial derivatives of the rescaled endpoint factor. -/
theorem iteratedDeriv_circleEndpointScaledRadialAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j k : Nat) (t : Real) :
    iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) =
      fun ρ => circleEndpointDyadicNormalization j *
        ((2 * Real.pi * t * (2 : Real) ^ j) ^ k •
          iteratedDeriv k (circleEndpointAmplitude σ)
            ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)) := by
  unfold circleEndpointScaledRadialAmplitude
  funext ρ
  have hk : (k : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞) := by
    change ((k : ℕ∞) : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞)
    exact WithTop.coe_le_coe.mpr le_top
  rw [iteratedDeriv_const_mul_field,
    iteratedDeriv_comp_const_smul ((contDiff_circleEndpointAmplitude σ).of_le hk)]

/-- The scaled radial endpoint factor retains the literal stationary-phase
bound in every derivative.  This is the quantitative input before the
separate product estimates for the fat cutoff. -/
theorem exists_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_decay
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t ρ : Real),
      1 ≤ |(2 * Real.pi * t * (2 : Real) ^ j) * ρ| →
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        ‖circleEndpointDyadicNormalization j‖ *
          |2 * Real.pi * t * (2 : Real) ^ j| ^ k *
          (A / Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale (2 * k)
              |(2 * Real.pi * t * (2 : Real) ^ j) * ρ|) := by
  obtain ⟨A, hA, hdecay⟩ :=
    exists_iteratedDeriv_circleEndpointAmplitude_abs_decay k
  refine ⟨A, hA, ?_⟩
  intro σ j t ρ hlarge
  rw [iteratedDeriv_circleEndpointScaledRadialAmplitude]
  change ‖circleEndpointDyadicNormalization j *
      ((2 * Real.pi * t * (2 : Real) ^ j) ^ k •
        iteratedDeriv k (circleEndpointAmplitude σ)
          ((2 * Real.pi * t * (2 : Real) ^ j) * ρ))‖ ≤ _
  rw [norm_mul, norm_smul, Real.norm_eq_abs, abs_pow]
  have hfactor : 0 ≤ |2 * Real.pi * t * (2 : Real) ^ j| ^ k :=
    pow_nonneg (abs_nonneg _) _
  have hinner := hdecay σ ((2 * Real.pi * t * (2 : Real) ^ j) * ρ) hlarge
  calc
    ‖circleEndpointDyadicNormalization j‖ *
        (|2 * Real.pi * t * (2 : Real) ^ j| ^ k *
          ‖iteratedDeriv k (circleEndpointAmplitude σ)
            ((2 * Real.pi * t * (2 : Real) ^ j) * ρ)‖) ≤
        ‖circleEndpointDyadicNormalization j‖ *
          (|2 * Real.pi * t * (2 : Real) ^ j| ^ k *
            (A / Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale
              (2 * k) |(2 * Real.pi * t * (2 : Real) ^ j) * ρ|)) :=
      mul_le_mul_of_nonneg_left (mul_le_mul_of_nonneg_left hinner hfactor) (norm_nonneg _)
    _ = _ := by ring

/-- On the fixed fat annulus, every fixed-order radial derivative of the
rescaled endpoint amplitude is uniform in the dyadic scale.  This is the
one-dimensional stationary input for the later multivariable compact-annulus
derivative certificate. -/
theorem exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le
    (k : Nat) :
    ∃ A : Real, 0 < A ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t ρ : Real), 1 ≤ t → (1 / 4 : Real) ≤ ρ → ρ ≤ 16 →
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤ A := by
  obtain ⟨A, hA, hdecay⟩ :=
    exists_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_decay k
  let B : Real := A * 4 ^ k
  have hB : 0 < B := mul_pos hA (pow_pos (by norm_num) _)
  refine ⟨B, hB, ?_⟩
  intro σ j t ρ ht hρ hρtop
  let s : Real := (2 : Real) ^ j
  let a : Real := 2 * Real.pi * t * s
  let freq : Real := a * ρ
  have hspos : 0 < s := by
    dsimp [s]
    positivity
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hρpos : 0 < ρ := lt_of_lt_of_le (by norm_num) hρ
  have hapos : 0 < a := by
    dsimp [a]
    positivity
  have hfreqpos : 0 < freq := by
    dsimp [freq]
    positivity
  have hfactor : 1 ≤ 2 * Real.pi * t * ρ := by
    have htr : (1 / 4 : Real) ≤ t * ρ := by
      calc
        (1 / 4 : Real) = 1 * (1 / 4 : Real) := by ring
        _ ≤ t * ρ := mul_le_mul ht hρ (by norm_num) htpos.le
    have hpi : (3 : Real) ≤ Real.pi := Real.pi_gt_three.le
    have hpit : 3 * (1 / 4 : Real) ≤ Real.pi * (t * ρ) :=
      mul_le_mul hpi htr (by norm_num) (by linarith [Real.pi_gt_three])
    nlinarith
  have hlambda : s ≤ freq := by
    change s ≤ a * ρ
    change s ≤ (2 * Real.pi * t * s) * ρ
    rw [show (2 * Real.pi * t * s) * ρ = s * (2 * Real.pi * t * ρ) by ring]
    exact le_mul_of_one_le_right hspos.le hfactor
  have hlambdaone : 1 ≤ freq := by
    have hsone : 1 ≤ s := by
      dsimp [s]
      exact one_le_pow₀ (by norm_num)
    exact hsone.trans hlambda
  have hmain := hdecay σ j t ρ (by
    change 1 ≤ |a * ρ|
    rw [abs_of_pos hfreqpos]
    exact hlambdaone)
  have hmain' :
      ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        ‖circleEndpointDyadicNormalization j‖ * |a| ^ k *
          (A / Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale
            (2 * k) |freq|) := by
    simpa [s, a, freq] using hmain
  change ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤ B
  rw [abs_of_pos hapos, abs_of_pos hfreqpos] at hmain'
  rw [norm_circleEndpointDyadicNormalization] at hmain'
  unfold Auto.Spherical.OscillatoryIntegralAux.quadraticMomentScale at hmain'
  have hsqrt : Real.sqrt s ≤ Real.sqrt freq := Real.sqrt_le_sqrt hlambda
  have hsqrtpos : 0 < Real.sqrt s := Real.sqrt_pos.2 hspos
  have hfreqsqrtpos : 0 < Real.sqrt freq := Real.sqrt_pos.2 hfreqpos
  have hpow : a ^ k ≤ (4 * freq) ^ k :=
    pow_le_pow_left₀ hapos.le (by
      dsimp [freq]
      have hfactorρ : 1 ≤ 4 * ρ := by nlinarith
      calc
        a = a * 1 := by ring
        _ ≤ a * (4 * ρ) := mul_le_mul_of_nonneg_left hfactorρ hapos.le
        _ = 4 * freq := by dsimp [freq]; ring) _
  have hden : (Real.sqrt freq) ^ (2 * k + 1) =
      Real.sqrt freq * freq ^ k := by
    calc
      (Real.sqrt freq) ^ (2 * k + 1) =
          Real.sqrt freq * ((Real.sqrt freq) ^ 2) ^ k := by
        rw [show 2 * k + 1 = 1 + 2 * k by omega, pow_add, pow_one, pow_mul]
      _ = Real.sqrt freq * freq ^ k := by
        rw [Real.sq_sqrt hfreqpos.le]
  calc
    ‖iteratedDeriv k (circleEndpointScaledRadialAmplitude σ j t) ρ‖ ≤
        Real.sqrt s * a ^ k * (A / (Real.sqrt freq) ^ (2 * k + 1)) := by
      simpa using hmain'
    _ ≤ Real.sqrt freq * (4 * freq) ^ k * (A / (Real.sqrt freq) ^ (2 * k + 1)) := by
      gcongr
    _ = A * 4 ^ k := by
      rw [hden, mul_pow]
      field_simp

/-- On a fixed positive annulus, the one-dimensional uniform endpoint bounds
lift through the Euclidean norm to multivariable iterated Fréchet derivatives.
This isolates the only use of the nonzero-radius condition in the uniform
Fourier-side endpoint certificate. -/
theorem exists_uniform_norm_iteratedFDeriv_circleEndpointScaledRadialComp_le
    (n : Nat) :
    ∃ C : Real, 0 < C ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Real) (η : Euclidean 2),
      1 ≤ t → (1 / 4 : Real) ≤ ‖η‖ → ‖η‖ ≤ 16 →
      ‖iteratedFDeriv Real n
        (fun y : Euclidean 2 => circleEndpointScaledRadialAmplitude σ j t ‖y‖) η‖ ≤ C := by
  choose A hApos hAbound using fun i : Nat =>
    exists_uniform_norm_iteratedDeriv_circleEndpointScaledRadialAmplitude_le i
  choose D hDpos hDbound using fun i : Nat =>
    _root_.Auto.MikhlinHormander.exists_norm_iteratedFDeriv_norm_bound_on_annulus
      (d := 2) (r := 1 / 4) (R := 16) i (by norm_num : (0 : Real) < 1 / 4)
  let CA : Real := ∑ i ∈ Finset.range (n + 1), A i
  let CD : Real := (∑ i ∈ Finset.range (n + 1), D i) + 1
  have hCApos : 0 < CA := by
    have hmem : 0 ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A 0 ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun i hi => (hApos i).le) hmem
    exact lt_of_lt_of_le (hApos 0) hle
  have hCDone : 1 ≤ CD := by
    dsimp [CD]
    have hsum : 0 ≤ ∑ i ∈ Finset.range (n + 1), D i :=
      Finset.sum_nonneg fun i hi => (hDpos i).le
    linarith
  refine ⟨((Nat.factorial n : Nat) : Real) * CA * CD ^ n, by positivity, ?_⟩
  intro σ j t η ht hηinner hηouter
  let s : Set (Euclidean 2) := ({0}ᶜ : Set (Euclidean 2))
  have hsopen : IsOpen s := by
    simpa only [s] using (isOpen_compl_singleton : IsOpen ({0}ᶜ : Set (Euclidean 2)))
  have hsunique : UniqueDiffOn Real s := hsopen.uniqueDiffOn
  have hηne : η ≠ 0 := by
    intro hzero
    subst η
    norm_num at hηinner
  have hηs : η ∈ s := by simpa [s] using hηne
  let g : Real → Complex := circleEndpointScaledRadialAmplitude σ j t
  let f : Euclidean 2 → Real := fun y => ‖y‖
  have hg : ContDiff Real n g := by
    dsimp [g]
    unfold circleEndpointScaledRadialAmplitude
    apply ContDiff.mul
    · fun_prop
    · apply (contDiff_circleEndpointAmplitude σ).of_le
        (show (n : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
          exact WithTop.coe_le_coe.mpr le_top)
        |>.comp
      fun_prop
  have hf : ContDiffOn Real n f s := by
    intro x hx
    exact (contDiffAt_norm Real (by simpa [s] using hx)).contDiffWithinAt
  have hgfAt : ContDiffAt Real n (g ∘ f) η :=
    hg.contDiffAt.comp η (contDiffAt_norm Real hηne)
  have hC : ∀ i, i ≤ n → ‖iteratedFDerivWithin Real i g Set.univ (f η)‖ ≤ CA := by
    intro i hi
    rw [iteratedFDerivWithin_univ]
    rw [norm_iteratedFDeriv_eq_norm_iteratedDeriv]
    have hbase := hAbound i σ j t (f η) ht (by simpa [f] using hηinner)
      (by simpa [f] using hηouter)
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : A i ≤ CA := by
      dsimp [CA]
      exact Finset.single_le_sum (fun l hl => (hApos l).le) hmem
    exact hbase.trans hle
  have hD : ∀ i, 1 ≤ i → i ≤ n → ‖iteratedFDerivWithin Real i f s η‖ ≤ CD ^ i := by
    intro i hi1 hi
    have hfeq : iteratedFDerivWithin Real i f s η = iteratedFDeriv Real i f η :=
      iteratedFDerivWithin_eq_iteratedFDeriv hsunique
        ((contDiffAt_norm Real hηne).of_le
          (show (i : WithTop ENat) ≤ ((⊤ : ENat) : WithTop ENat) by
            exact WithTop.coe_le_coe.mpr le_top)) hηs
    rw [hfeq]
    have hbase := hDbound i η hηinner hηouter
    have hmem : i ∈ Finset.range (n + 1) := Finset.mem_range.mpr (by omega)
    have hle : D i ≤ CD := by
      dsimp [CD]
      calc
        D i ≤ ∑ l ∈ Finset.range (n + 1), D l :=
          Finset.single_le_sum (fun l hl => (hDpos l).le) hmem
        _ ≤ (∑ l ∈ Finset.range (n + 1), D l) + 1 := by linarith
    have hpow : CD ≤ CD ^ i := by
      obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (Nat.ne_of_gt hi1)
      rw [pow_succ]
      calc
        CD = 1 * CD := (one_mul _).symm
        _ ≤ CD ^ m * CD :=
          mul_le_mul_of_nonneg_right (one_le_pow₀ hCDone) (le_trans (by norm_num) hCDone)
    exact hbase.trans (hle.trans hpow)
  have hcomp := norm_iteratedFDerivWithin_comp_le
    (g := g) (f := f) (s := s) (t := Set.univ)
    hg.contDiffOn hf (show (n : WithTop ENat) ≤ (n : WithTop ENat) by rfl)
    uniqueDiffOn_univ hsunique (by simp) hηs hC hD
  have hEq : iteratedFDerivWithin Real n (g ∘ f) s η =
      iteratedFDeriv Real n (g ∘ f) η :=
    iteratedFDerivWithin_eq_iteratedFDeriv hsunique hgfAt hηs
  change ‖iteratedFDeriv Real n (g ∘ f) η‖ ≤ _
  rw [← hEq]
  exact hcomp

/-- The unit-scale presentation of the annular endpoint multiplier.  Its
cutoff is the fixed Schwartz prototype from the Littlewood--Paley layer;
only the explicitly displayed stationary amplitude remains scale dependent. -/
noncomputable def circleAnnularEndpointScaledSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun η => circleAnnularEndpointMultiplier C σ j t ((2 : Real) ^ j • η)

/-- After radial dyadic rescaling, the fat cutoff in the annular endpoint
symbol is exactly the fixed compact Schwartz profile. -/
theorem circleAnnularEndpointScaledSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (η : Euclidean 2) :
    circleAnnularEndpointScaledSymbol C σ j t η =
      circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
        (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ
          ((2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η := by
  unfold circleAnnularEndpointScaledSymbol circleAnnularEndpointMultiplier
  rw [_root_.Auto.MikhlinHormander.fatDyadicBandpassMultiplier_eq_prototype_scale]
  have hpow : 0 ≤ (2 : Real) ^ j := by positivity
  have hpow_ne : (2 : Real) ^ j ≠ 0 := ne_of_gt (by positivity)
  rw [smul_smul, inv_mul_cancel₀ hpow_ne, one_smul]
  rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hpow]
  have harg : 2 * Real.pi * (t * ((2 : Real) ^ j * ‖η‖)) =
      (2 * Real.pi * t * (2 : Real) ^ j) * ‖η‖ := by ring
  rw [harg]

/-- The fat annular cutoff makes the endpoint multiplier identically zero
on a neighborhood of the frequency origin.  This is the removable-singularity
input needed to regard its radial amplitude as a smooth multiplier. -/
private theorem aux_circleAnnularEndpointMultiplier_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Filter.EventuallyEq (nhds (0 : Euclidean 2))
      (circleAnnularEndpointMultiplier C σ j t) (fun _ => 0) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) (lt_min hhigh hlow)] with ξ hξ
  have hξnorm : ‖ξ‖ < min rhigh rlow := by
    simpa only [Metric.mem_ball, dist_zero_right] using hξ
  have hright : ‖rhigh⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    exact (div_le_one₀ hhigh).mpr (hξnorm.le.trans (min_le_left _ _))
  have hleft : ‖rlow⁻¹ • ξ‖ ≤ 1 := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    exact (div_le_one₀ hlow).mpr (hξnorm.le.trans (min_le_right _ _))
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_one _ hright, C.cutoff_one _ hleft]
    ring
  simp [circleAnnularEndpointMultiplier, hfat]

/-- The same fat annular cutoff gives compact frequency support to the
endpoint multiplier. -/
theorem aux_hasCompactSupport_circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    HasCompactSupport (circleAnnularEndpointMultiplier C σ j t) := by
  let rhigh : Real := (2 : Real) ^ ((j : Int) + 3)
  let rlow : Real := (2 : Real) ^ ((j : Int) - 2)
  have hhigh : 0 < rhigh := by
    dsimp [rhigh]
    positivity
  have hlow : 0 < rlow := by
    dsimp [rlow]
    positivity
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) (2 * max rhigh rlow))
  intro ξ hξ
  have hξnorm : 2 * max rhigh rlow ≤ ‖ξ‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hξ
    exact le_of_not_ge hξ
  have hright : 2 ≤ ‖rhigh⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hhigh)]
    rw [show rhigh⁻¹ * ‖ξ‖ = ‖ξ‖ / rhigh by ring]
    apply (le_div_iff₀ hhigh).mpr
    calc
      2 * rhigh ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_left _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hleft : 2 ≤ ‖rlow⁻¹ • ξ‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hlow)]
    rw [show rlow⁻¹ * ‖ξ‖ = ‖ξ‖ / rlow by ring]
    apply (le_div_iff₀ hlow).mpr
    calc
      2 * rlow ≤ 2 * max rhigh rlow :=
        mul_le_mul_of_nonneg_left (le_max_right _ _) (by norm_num)
      _ ≤ ‖ξ‖ := hξnorm
  have hfat :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ = 0 := by
    rw [_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier_eq_shiftedFatMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply]
    simp only [sub_zero]
    change C.cutoff (rhigh⁻¹ • ξ) - C.cutoff (rlow⁻¹ • ξ) = 0
    rw [C.cutoff_zero _ hright, C.cutoff_zero _ hleft]
    ring
  simp [circleAnnularEndpointMultiplier, hfat]

/-- The annular endpoint multiplier is smooth: away from zero this follows
from smoothness of the norm and endpoint amplitude, and at zero the preceding
local vanishing lemma removes the radial singularity. -/
theorem aux_contDiff_circleAnnularEndpointMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞) (circleAnnularEndpointMultiplier C σ j t) := by
  rw [contDiff_iff_contDiffAt]
  intro ξ
  by_cases hξ : ξ = 0
  · subst ξ
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (aux_circleAnnularEndpointMultiplier_eventuallyEq_zero_at_zero C σ j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 => ‖η‖) ξ :=
      contDiffAt_norm Real hξ
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 =>
        2 * Real.pi * (t * ‖η‖)) ξ := by
      fun_prop
    have hamp : ContDiffAt Real (⊤ : ℕ∞) (fun η : Euclidean 2 =>
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖η‖))) ξ :=
      (contDiff_circleEndpointAmplitude σ).contDiffAt.comp ξ harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j) ξ :=
      ((_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold circleAnnularEndpointMultiplier
    exact (((contDiffAt_const.mul contDiffAt_const).mul contDiffAt_const).mul hamp).mul hcut

/-- The compact, smooth annular endpoint factor as a Schwartz multiplier.
This is the precise multiplier object to which a later uniform kernel or
Mikhlin estimate must be applied. -/
noncomputable def circleAnnularEndpointSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  (aux_hasCompactSupport_circleAnnularEndpointMultiplier C σ j t).toSchwartzMap
    (aux_contDiff_circleAnnularEndpointMultiplier C σ j t)

/-- Coercion from the Schwartz package recovers the literal fat annular
endpoint multiplier. -/
theorem circleAnnularEndpointSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    circleAnnularEndpointSchwartzSymbol C σ j t ξ =
      circleAnnularEndpointMultiplier C σ j t ξ := rfl

/-- The Schwartz-packaged annular endpoint symbol has the same exact
factorization through the dyadic MSS half-wave. -/
theorem circleAnnularEndpointSchwartzSymbol_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ j t ξ *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [circleAnnularEndpointSchwartzSymbol_apply]
  exact circleAnnularEndpointMultiplier_factorization C σ j t ξ

/-- The endpoint term obtained by applying `b_{j,±}` to the Fourier side of
the corresponding MSS dyadic half-wave. -/
noncomputable def circleEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (circleEndpointDyadicNormalization j)⁻¹ *
      circleEndpointMultiplier C σ j t xi *
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- Literal Fourier factorization of a circle endpoint through an MSS
dyadic half-wave. -/
theorem circleEndpointWaveContribution_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleEndpointWaveContribution C σ j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  unfold circleEndpointWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [circleEndpointMultiplier_factorization]

/-- The literal time derivative of the Fourier multiplier in one circle
endpoint contribution.  The two displayed terms differentiate respectively
the stationary amplitude and the half-wave phase. -/
noncomputable def circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun ξ =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (circleEndpointAmplitudeTimeDerivative σ t ξ *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ +
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ

/-- The literal endpoint multiplier has the product-rule time derivative
recorded above.  This is pointwise in frequency and makes no unproved
interchange of differentiation and Fourier inversion. -/
theorem hasDerivAt_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real) (ξ : Euclidean 2) :
    HasDerivAt
      (fun s : Real =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ s ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ)
      (circleEndpointBandpassMultiplierTimeDerivative C σ j t ξ) t := by
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ
  have hA := hasDerivAt_circleEndpointAmplitude_time σ t ξ
  have hH := _root_.Auto.Spherical.MSS.hasDerivAt_halfWaveMultiplier_time σ t ξ
  have hproduct := (hA.mul hH).const_mul c |>.mul_const b
  change HasDerivAt
    (fun s : Real => c *
      circleEndpointAmplitude σ (2 * Real.pi * (s * ‖ξ‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier σ s ξ * b)
    (c *
      (circleEndpointAmplitudeTimeDerivative σ t ξ *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t ξ +
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ) * b) t
  simpa only [Pi.mul_apply, mul_assoc] using hproduct

/-- The literal Fourier contribution of the nonstationary middle meridian
piece on one dyadic annulus. -/
noncomputable def circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The Fourier multiplier of the nonstationary middle meridian on one
dyadic block.  Separating it from the input Fourier transform makes the
extra full power of dyadic decay visible. -/
noncomputable def aux_circleMiddleBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex :=
  fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi

/-- The literal middle contribution is inverse Fourier transformation of its
separated dyadic multiplier. -/
theorem aux_circleMiddleWaveContribution_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    circleMiddleWaveContribution C j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  rfl

/-- On the active `j`th annulus at unit-scale time, the middle meridian has
one full inverse power of the dyadic frequency.  This is strictly better
than the stationary endpoint size and follows directly from the proved
nonstationary integration-by-parts estimate. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplier_le_dyadicInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      ‖aux_circleMiddleBandpassMultiplier C j t xi‖ ≤ B / dyadicScale j := by
  obtain ⟨A, hA, hdecay⟩ := exists_circleMiddleMeridianLocalizedIntegral_decay_one
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
    norm_pos_iff.mpr (inv_ne_zero hmass2)
  have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
  have hK : 0 < K := by
    dsimp only [K]
    positivity
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro j t xi ht _htop
  by_cases hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
  · rw [show aux_circleMiddleBandpassMultiplier C j t xi = 0 by
        simp [aux_circleMiddleBandpassMultiplier, hband]]
    simpa using (div_nonneg hB.le (dyadicScale_pos j).le)
  · have hfrequency : dyadicScale j ≤ 2 * Real.pi * (t * ‖xi‖) := by
      simpa only [dyadicScale] using
        aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
    have hscale_one : 1 ≤ dyadicScale j := by
      calc
        1 = dyadicScale 0 := by simp [dyadicScale]
        _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
    have hlambda : 1 ≤ 2 * Real.pi * (t * ‖xi‖) :=
      hscale_one.trans hfrequency
    have hlambda_nonneg : 0 ≤ 2 * Real.pi * (t * ‖xi‖) :=
      zero_le_one.trans hlambda
    have hmiddle_raw := hdecay (2 * Real.pi * (t * ‖xi‖)) (by
      rw [abs_of_nonneg hlambda_nonneg]
      exact hlambda)
    have hmiddle :
        ‖Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * (t * ‖xi‖))‖ ≤ A / (2 * Real.pi * (t * ‖xi‖)) := by
      simpa only [abs_of_nonneg hlambda_nonneg] using hmiddle_raw
    have hratio : A / (2 * Real.pi * (t * ‖xi‖)) ≤ A / dyadicScale j :=
      div_le_div_of_nonneg_left hA.le (dyadicScale_pos j) hfrequency
    have hcut :
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
      _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
    have hinner :
        ‖Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
            0 (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤
          (A / (2 * Real.pi * (t * ‖xi‖))) * 2 := by
      exact mul_le_mul hmiddle hcut (norm_nonneg _)
        (div_nonneg hA.le (by positivity))
    calc
      ‖aux_circleMiddleBandpassMultiplier C j t xi‖ =
          K *
            ‖Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
                0 (2 * Real.pi * (t * ‖xi‖))‖ *
              ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ := by
            unfold aux_circleMiddleBandpassMultiplier
            rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
              Real.norm_of_nonneg hmass1.le]
      _ = K *
          (‖Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
              0 (2 * Real.pi * (t * ‖xi‖))‖ *
            ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by
          ring
      _ ≤ K * ((A / (2 * Real.pi * (t * ‖xi‖))) * 2) := by
        exact mul_le_mul_of_nonneg_left hinner hK.le
      _ = (2 * K) * (A / (2 * Real.pi * (t * ‖xi‖))) := by ring
      _ ≤ (2 * K) * (A / dyadicScale j) := by
        exact mul_le_mul_of_nonneg_left hratio (by positivity)
      _ = B / dyadicScale j := by
        dsimp only [B]
        ring

/-- The ordinary dyadic band-pass has compact frequency support.  This local
version is used to turn the smooth full circle multiplier into a Schwartz
symbol before subtracting the two already-Schwartz endpoint pieces. -/
private theorem aux_hasCompactSupport_dyadicBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat) :
    HasCompactSupport
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j :
        Euclidean 2 → Complex) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  exact _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm

/-- The literal middle dyadic multiplier is Schwartz despite its original
oscillatory-integral presentation.  We obtain the package by subtracting the
two compact endpoint symbols from the smooth compactly localized full circle
multiplier; the exact coordinate-wave identity identifies the result with the
middle meridian. -/
theorem aux_exists_circleMiddleBandpassSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (ht : 0 ≤ t) :
    ∃ m : SchwartzMap (Euclidean 2) Complex, ∀ xi : Euclidean 2,
      m xi = aux_circleMiddleBandpassMultiplier C j t xi := by
  let psi : SchwartzMap (Euclidean 2) Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j
  obtain ⟨mfull, hmfull⟩ :=
    exists_schwartz_compactSupport_mul_surfaceFourier psi
      (aux_hasCompactSupport_dyadicBandpassMultiplier C j) t
  let m0 : SchwartzMap (Euclidean 2) Complex :=
    ((surfaceMass 2)⁻¹ : Complex) • mfull
  let qminus : SchwartzMap (Euclidean 2) Complex :=
    (circleEndpointDyadicNormalization j)⁻¹ •
      SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.minus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSS.WaveSign.minus j t)
  let qplus : SchwartzMap (Euclidean 2) Complex :=
    (circleEndpointDyadicNormalization j)⁻¹ •
      SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.plus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSS.WaveSign.plus j t)
  have hqminus (xi : Euclidean 2) :
      qminus xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier
            _root_.Auto.Spherical.MSS.WaveSign.minus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    dsimp only [qminus]
    change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.minus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSS.WaveSign.minus j t) xi) = _
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.minus j
          t).hasTemperateGrowth,
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol_apply]
    simpa only [smul_eq_mul, mul_assoc] using
      circleAnnularEndpointSchwartzSymbol_factorization C
        _root_.Auto.Spherical.MSS.WaveSign.minus j t xi
  have hqplus (xi : Euclidean 2) :
      qplus xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier
            _root_.Auto.Spherical.MSS.WaveSign.plus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    dsimp only [qplus]
    change (circleEndpointDyadicNormalization j)⁻¹ •
      (SchwartzMap.smulLeftCLM Complex
        (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.plus j t :
          Euclidean 2 → Complex)
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol C
          _root_.Auto.Spherical.MSS.WaveSign.plus j t) xi) = _
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C _root_.Auto.Spherical.MSS.WaveSign.plus j
          t).hasTemperateGrowth,
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSchwartzSymbol_apply]
    simpa only [smul_eq_mul, mul_assoc] using
      circleAnnularEndpointSchwartzSymbol_factorization C
        _root_.Auto.Spherical.MSS.WaveSign.plus j t xi
  refine ⟨m0 - qminus - qplus, ?_⟩
  intro xi
  have hsurface := circleSurfaceFourierCoordinateWaveDecomposition (-t • xi)
  have hnorm : ‖-t • xi‖ = t * ‖xi‖ := by
    rw [norm_smul, Real.norm_eq_abs, abs_neg, abs_of_nonneg ht]
  rw [hnorm] at hsurface
  change ((surfaceMass 2)⁻¹ : Complex) • mfull xi - qminus xi - qplus xi = _
  rw [hmfull xi, hqminus xi, hqplus xi]
  dsimp only [psi]
  change ((surfaceMass 2)⁻¹ : Complex) *
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        surfaceFourier 2 (-t • xi)) - _ - _ = _
  rw [hsurface]
  unfold aux_circleMiddleBandpassMultiplier
  have hminus :
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
          (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier
          _root_.Auto.Spherical.MSS.WaveSign.minus t xi =
        Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
          Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
            (2 * Real.pi * (t * ‖xi‖)) := by
    simp only [circleEndpointAmplitude,
      _root_.Auto.Spherical.MSS.halfWaveMultiplier,
      _root_.Auto.Spherical.MSS.WaveSign.toReal]
    rw [mul_comm]
    congr 1
    push_cast
    ring_nf
  have hplus :
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
          (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier
          _root_.Auto.Spherical.MSS.WaveSign.plus t xi =
        Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
          Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
            (-(2 * Real.pi * (t * ‖xi‖))) := by
    simp only [circleEndpointAmplitude,
      _root_.Auto.Spherical.MSS.halfWaveMultiplier,
      _root_.Auto.Spherical.MSS.WaveSign.toReal]
    rw [mul_comm]
    congr 1
    push_cast
    ring_nf
  have hminus' :
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier
            _root_.Auto.Spherical.MSS.WaveSign.minus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
            Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
              (2 * Real.pi * (t * ‖xi‖))) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by
    calc
      _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
              (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier
              _root_.Auto.Spherical.MSS.WaveSign.minus t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by ring
      _ = _ := by rw [hminus]
  have hplus' :
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
            (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier
            _root_.Auto.Spherical.MSS.WaveSign.plus t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi =
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
            Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
              (-(2 * Real.pi * (t * ‖xi‖))) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi) := by
    calc
      _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          (circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
              (2 * Real.pi * (t * ‖xi‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier
              _root_.Auto.Spherical.MSS.WaveSign.plus t xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi := by ring
      _ = _ := by rw [hplus]; ring
  rw [hminus', hplus']
  ring

/-- Plancherel upgrades the full inverse-frequency middle-multiplier bound
to a fixed-time dyadic `L²` gain.  No maximal estimate is hidden here: the
conclusion is explicitly for one time, which is the harmless-remainder input
available before the time-Sobolev/local-smoothing stage. -/
theorem aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j t f x‖ ^ 2) ≤
          (B / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplier_le_dyadicInverse C
  refine ⟨B, hB, ?_⟩
  intro j t ht htop f
  obtain ⟨m, hm⟩ := aux_exists_circleMiddleBandpassSchwartzSymbol C j t
    (zero_le_one.trans ht)
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B / dyadicScale j := by
    rw [hm xi]
    exact hpoint j t xi ht htop
  have hsymbol :
      (fun xi : Euclidean 2 => m xi * 𝓕 (f : Euclidean 2 → Complex) xi) =
        fun xi : Euclidean 2 => aux_circleMiddleBandpassMultiplier C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
    funext xi
    rw [hm xi]
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg hB.le (dyadicScale_pos j).le) hm_bound
  calc
    (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          aux_circleMiddleBandpassMultiplier C j t xi *
            𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          apply MeasureTheory.integral_congr_ae
          filter_upwards with x
          rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j t f x]
    _ = ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rw [hsymbol]
    _ ≤ (B / dyadicScale j) ^ 2 *
          ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = (B / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
          rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- The smooth coordinate middle cutoff is uniformly bounded.  The rough
constant `3` is sufficient for dominated differentiation and is obtained
directly from the two endpoint bump bounds. -/
private theorem aux_norm_coordinateMiddleMeridianCutoff_le_three (theta : Real) :
    ‖(Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex)‖ ≤ 3 := by
  let U : Real :=
    Auto.Spherical.OscillatoryIntegralAux.coordinateUpperMeridianCutoff theta
  let L : Real :=
    Auto.Spherical.OscillatoryIntegralAux.coordinateLowerMeridianCutoff theta
  have hU0 : 0 ≤ U := by
    dsimp only [U]
    unfold Auto.Spherical.OscillatoryIntegralAux.coordinateUpperMeridianCutoff
      Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
    exact ContDiffBump.nonneg' _ _
  have hU1 : U ≤ 1 := by
    dsimp only [U]
    unfold Auto.Spherical.OscillatoryIntegralAux.coordinateUpperMeridianCutoff
      Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
    exact ContDiffBump.le_one _
  have hL0 : 0 ≤ L := by
    dsimp only [L]
    unfold Auto.Spherical.OscillatoryIntegralAux.coordinateLowerMeridianCutoff
      Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
    exact ContDiffBump.nonneg' _ _
  have hL1 : L ≤ 1 := by
    dsimp only [L]
    unfold Auto.Spherical.OscillatoryIntegralAux.coordinateLowerMeridianCutoff
      Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
    exact ContDiffBump.le_one _
  rw [Complex.norm_real, Real.norm_eq_abs]
  change |1 - U - L| ≤ 3
  calc
    |1 - U - L| ≤ |1| + |U| + |L| := by
      rw [show 1 - U - L = 1 + (-U) + (-L) by ring]
      calc
        |1 + -U + -L| ≤ |1 + -U| + |-L| := abs_add_le _ _
        _ ≤ (|1| + |-U|) + |-L| := by gcongr; exact abs_add_le _ _
        _ = |1| + |U| + |L| := by rw [abs_neg, abs_neg]
    _ = 1 + U + L := by rw [abs_of_nonneg hU0, abs_of_nonneg hL0]; norm_num
    _ ≤ 3 := by linarith

/-- The frequency derivative of the literal middle meridian. -/
noncomputable def aux_circleMiddleMeridianFrequencyDerivative (l : Real) : Complex :=
  ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) *
        (((-Real.sin theta : Real) : Complex) * Complex.I)

open Auto.Spherical.OscillatoryIntegralAux in
/-- Differentiation under the compact meridian integral identifies the
frequency derivative of the middle term. -/
theorem aux_hasDerivAt_circleMiddleMeridianLocalizedIntegral_zero
    (l : Real) :
    HasDerivAt
      (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral 0)
      (aux_circleMiddleMeridianFrequencyDerivative l) l := by
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  let F : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)
  let F' : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) *
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I) *
        (((-Real.sin theta : Real) : Complex) * Complex.I)
  have hab : a ≤ b := by
    dsimp [a, b]
    linarith [Real.pi_pos]
  have hcutcont : Continuous (fun theta : Real =>
      (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
        theta : Complex)) :=
    Complex.continuous_ofReal.comp
      Auto.Spherical.OscillatoryIntegralAux.contDiff_coordinateMiddleMeridianCutoff.continuous
  have hmiddle_eq (u : Real) :
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral 0 u =
        ∫ theta in a..b, F u theta := by
    rw [coordinateMiddleMeridianLocalizedIntegral_eq_middle_cutoff]
    apply intervalIntegral.integral_congr
    intro theta _
    dsimp [a, b, F]
    simp
  have hmiddle_deriv_eq :
      aux_circleMiddleMeridianFrequencyDerivative l = ∫ theta in a..b, F' l theta := by
    rfl
  have hEcont (u : Real) : Continuous (fun theta : Real =>
      Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
    fun_prop
  have hFcont (u : Real) : Continuous (F u) := by
    dsimp [F]
    exact hcutcont.mul (hEcont u)
  have hF'cont (u : Real) : Continuous (F' u) := by
    dsimp [F']
    exact (hcutcont.mul (hEcont u)).mul (by fun_prop)
  have h := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict (Ioc a b)) (s := Set.univ) (x₀ := l)
    (bound := fun _ : Real => (3 : Real))
    (F := F) (F' := F') Filter.univ_mem ?_ ?_ ?_ ?_ ?_ ?_
  · rw [show Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral 0 =
        fun u : Real => ∫ theta in a..b, F u theta by
          funext u
          exact hmiddle_eq u,
      hmiddle_deriv_eq]
    simp_rw [intervalIntegral.integral_of_le hab]
    exact h.2
  · filter_upwards [] with u
    exact (hFcont u).aestronglyMeasurable
  · refine Integrable.of_bound ?_ 3 ?_
    · exact (hFcont l).aestronglyMeasurable
    · filter_upwards with theta
      dsimp [F]
      rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
      exact aux_norm_coordinateMiddleMeridianCutoff_le_three theta
  · exact (hF'cont l).aestronglyMeasurable
  · filter_upwards with theta
    intro u hu
    dsimp [F']
    have hsin : ‖(((-Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ 1 := by
      rw [norm_mul, Complex.norm_real, Real.norm_eq_abs, Complex.norm_I, mul_one]
      simpa using Real.abs_sin_le_one theta
    rw [norm_mul, norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
    calc
      ‖(Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex)‖ * ‖(((-Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ 3 * 1 :=
        mul_le_mul (aux_norm_coordinateMiddleMeridianCutoff_le_three theta)
          hsin (norm_nonneg _) (by norm_num)
      _ = 3 := by norm_num
  · exact integrableOn_const (hs := measure_Ioc_lt_top.ne)
  · filter_upwards with theta
    intro u hu
    dsimp [F, F']
    have harg : HasDerivAt
        (fun v : Real => ((-v * Real.sin theta : Real) : Complex) * Complex.I)
        (((-Real.sin theta : Real) : Complex) * Complex.I) u := by
      have hreal : HasDerivAt (fun v : Real => -v * Real.sin theta)
          (-Real.sin theta) u := by
        simpa [mul_comm] using (hasDerivAt_id u).mul_const (-Real.sin theta)
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    have hexp := harg.cexp
    simpa [mul_assoc, mul_left_comm, mul_comm] using
      hexp.const_mul
        (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex)

/-- The compact meridian sine moments used to record all parameter
derivatives of the literal middle factor. -/
noncomputable def aux_circleMiddleSineMoment (n : Nat) (l : Real) : Complex :=
  ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) *
      ((Real.sin theta ^ n : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)

open Auto.Spherical.OscillatoryIntegralAux in
private theorem aux_circleMiddleSineMoment_zero_eq_middle (l : Real) :
    aux_circleMiddleSineMoment 0 l =
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 l := by
  rw [coordinateMiddleMeridianLocalizedIntegral_eq_middle_cutoff]
  unfold aux_circleMiddleSineMoment
  apply intervalIntegral.integral_congr
  intro theta _
  simp

private theorem aux_exists_pos_norm_circleMiddleSineMomentAmplitude_le
    (n : Nat) :
    ∃ M : Real, 0 < M ∧ ∀ theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2),
      ‖(Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex) * ((Real.sin theta ^ n : Real) : Complex)‖ ≤ M := by
  let A : Real → Complex := fun theta =>
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) * ((Real.sin theta ^ n : Real) : Complex)
  have hcut : Continuous (fun theta : Real =>
      (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
        theta : Complex)) :=
    Complex.continuous_ofReal.comp
      Auto.Spherical.OscillatoryIntegralAux.contDiff_coordinateMiddleMeridianCutoff.continuous
  have hA : Continuous A := by
    dsimp [A]
    exact hcut.mul (by fun_prop)
  have hbounded : Bornology.IsBounded
      (A '' Icc (-(Real.pi / 2) : Real) (Real.pi / 2)) :=
    (isCompact_Icc.image_of_continuousOn hA.continuousOn).isBounded
  rcases hbounded.exists_pos_norm_le with ⟨M, hM, hbound⟩
  exact ⟨M, hM, fun theta htheta => hbound _ (mem_image_of_mem _ htheta)⟩

private theorem aux_hasDerivAt_circleMiddleSineMoment
    (n : Nat) (l : Real) :
    HasDerivAt (aux_circleMiddleSineMoment n)
      (-Complex.I * aux_circleMiddleSineMoment (n + 1) l) l := by
  obtain ⟨M, hM, hMbound⟩ :=
    aux_exists_pos_norm_circleMiddleSineMomentAmplitude_le (n + 1)
  let F : Real → Real → Complex := fun u theta =>
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
      theta : Complex) *
      ((Real.sin theta ^ n : Real) : Complex) *
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)
  let F' : Real → Real → Complex := fun u theta =>
    -Complex.I *
      ((Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
        theta : Complex) *
        ((Real.sin theta ^ (n + 1) : Real) : Complex) *
          Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I))
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  have hab : a ≤ b := by
    dsimp [a, b]
    linarith [Real.pi_pos]
  have hFcont (u : Real) : Continuous (F u) := by
    dsimp [F]
    have hcut : Continuous (fun theta : Real =>
        (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex)) :=
      Complex.continuous_ofReal.comp
        Auto.Spherical.OscillatoryIntegralAux.contDiff_coordinateMiddleMeridianCutoff.continuous
    have hsin : Continuous (fun theta : Real => ((Real.sin theta ^ n : Real) : Complex)) := by
      fun_prop
    have hexp : Continuous (fun theta : Real =>
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
      fun_prop
    exact (hcut.mul hsin).mul hexp
  have hF'cont (u : Real) : Continuous (F' u) := by
    dsimp [F']
    have hcut : Continuous (fun theta : Real =>
        (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex)) :=
      Complex.continuous_ofReal.comp
        Auto.Spherical.OscillatoryIntegralAux.contDiff_coordinateMiddleMeridianCutoff.continuous
    have hsin : Continuous (fun theta : Real =>
        ((Real.sin theta ^ (n + 1) : Real) : Complex)) := by
      fun_prop
    have hexp : Continuous (fun theta : Real =>
        Complex.exp (((-u * Real.sin theta : Real) : Complex) * Complex.I)) := by
      fun_prop
    exact continuous_const.mul ((hcut.mul hsin).mul hexp)
  change HasDerivAt (fun u : Real => ∫ theta in a..b, F u theta)
    (-Complex.I * aux_circleMiddleSineMoment (n + 1) l) l
  have hparam := intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume) (a := a) (b := b) (s := Set.univ) (x₀ := l)
    (bound := fun _ : Real => M) (F := F) (F' := F') Filter.univ_mem
    (by
      filter_upwards [] with u
      exact (hFcont u).aestronglyMeasurable)
    ((hFcont l).intervalIntegrable a b)
    ((hF'cont l).aestronglyMeasurable)
    (by
      filter_upwards with theta
      intro htheta u hu
      have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
        rw [uIoc_of_le hab] at htheta
        exact ⟨by simpa [a, b] using htheta.1.le,
          by simpa [a, b] using htheta.2⟩
      have hbase := hMbound theta htheta'
      dsimp [F']
      simpa only [norm_mul, norm_neg, Complex.norm_I, one_mul,
        Complex.norm_exp_ofReal_mul_I, mul_one] using hbase)
    ((by fun_prop : Continuous (fun _ : Real => M)).intervalIntegrable a b)
    (by
      filter_upwards with theta
      intro htheta u hu
      have hreal : HasDerivAt (fun v : Real => -v * Real.sin theta)
          (-Real.sin theta) u := by
        simpa [mul_comm] using (hasDerivAt_id u).const_mul (-Real.sin theta)
      have harg : HasDerivAt
          (fun v : Real => ((-v * Real.sin theta : Real) : Complex) * Complex.I)
          (((-Real.sin theta : Real) : Complex) * Complex.I) u := by
        simpa only [Complex.real_smul] using hreal.smul_const Complex.I
      dsimp [F, F']
      have h := (harg.cexp).const_mul
        ((Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex) * ((Real.sin theta ^ n : Real) : Complex))
      simpa [pow_succ, mul_assoc, mul_left_comm, mul_comm] using h)
  have hF'int :
      (∫ theta in a..b, F' l theta) =
        -Complex.I * aux_circleMiddleSineMoment (n + 1) l := by
    unfold aux_circleMiddleSineMoment
    rw [← intervalIntegral.integral_const_mul]
  rw [hF'int] at hparam
  exact hparam.2

private theorem aux_iteratedDeriv_circleMiddleSineMoment
    (n k : Nat) :
    iteratedDeriv k (aux_circleMiddleSineMoment n) =
      fun l => (-Complex.I) ^ k * aux_circleMiddleSineMoment (n + k) l := by
  induction k with
  | zero =>
      ext l
      simp [iteratedDeriv]
  | succ k ih =>
      rw [iteratedDeriv_succ, ih]
      funext l
      rw [deriv_const_mul_field,
        (aux_hasDerivAt_circleMiddleSineMoment (n + k) l).deriv]
      simp only [pow_succ]
      ring_nf

private theorem aux_contDiff_circleMiddleSineMoment
    (n : Nat) :
    ContDiff Real (⊤ : ℕ∞) (aux_circleMiddleSineMoment n) := by
  apply contDiff_of_differentiable_iteratedDeriv
  intro k _
  rw [aux_iteratedDeriv_circleMiddleSineMoment]
  have hd : Differentiable Real
      (fun l => aux_circleMiddleSineMoment (n + k) l) := fun l =>
    (aux_hasDerivAt_circleMiddleSineMoment (n + k) l).differentiableAt
  exact hd.const_mul ((-Complex.I) ^ k)

private theorem aux_circleMiddleMeridianFrequencyDerivative_eq_sineMoment
    (l : Real) :
    aux_circleMiddleMeridianFrequencyDerivative l =
      -Complex.I * aux_circleMiddleSineMoment 1 l := by
  unfold aux_circleMiddleMeridianFrequencyDerivative aux_circleMiddleSineMoment
  rw [← intervalIntegral.integral_const_mul]
  apply intervalIntegral.integral_congr
  intro theta _
  push_cast
  ring

private theorem aux_contDiff_circleMiddleMeridianFrequencyDerivative :
    ContDiff Real (⊤ : ℕ∞) aux_circleMiddleMeridianFrequencyDerivative := by
  rw [show aux_circleMiddleMeridianFrequencyDerivative =
      fun l => -Complex.I * aux_circleMiddleSineMoment 1 l by
        funext l
        exact aux_circleMiddleMeridianFrequencyDerivative_eq_sineMoment l]
  exact contDiff_const.mul (aux_contDiff_circleMiddleSineMoment 1)

/-- One nonstationary integration by parts on the meridian, stated for an
arbitrary smooth amplitude which vanishes at the two poles.  The phase
derivative vanishes at the poles, so the formulation deliberately puts the
cosine factor in the integrand rather than dividing there. -/
private theorem aux_meridian_nonstationary_ibp
    (A : Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hends : A (-(Real.pi / 2)) = 0 ∧ A (Real.pi / 2) = 0)
    {l : Real} (hl : l ≠ 0) :
    (∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
      A theta * ((Real.cos theta : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)) =
      -((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
  let a : Real := -(Real.pi / 2)
  let b : Real := Real.pi / 2
  let E : Real → Complex := fun theta =>
    Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)
  let q : Complex := ((-l : Real) : Complex) * Complex.I
  let s : Complex := q⁻¹
  let A' : Real → Complex := fun theta => deriv A theta
  have hq : q ≠ 0 := by
    dsimp [q]
    exact mul_ne_zero (Complex.ofReal_ne_zero.mpr (neg_ne_zero.mpr hl))
      Complex.I_ne_zero
  have hsq : s * q = 1 := by
    dsimp [s]
    exact inv_mul_cancel₀ hq
  have hAderiv : ∀ theta ∈ uIcc a b, HasDerivAt A (A' theta) theta := by
    intro theta _
    exact ((hA.differentiable (by simp) theta).hasDerivAt)
  have hE : ∀ theta ∈ uIcc a b,
      HasDerivAt E (E theta * (q * (Real.cos theta : Complex))) theta := by
    intro theta _
    dsimp [E, q]
    have hreal : HasDerivAt (fun x : Real => -l * Real.sin x)
        (-l * Real.cos theta) theta := by
      simpa [mul_comm] using (Real.hasDerivAt_sin theta).const_mul (-l)
    have harg : HasDerivAt
        (fun x : Real => ((-l * Real.sin x : Real) : Complex) * Complex.I)
        (((-l * Real.cos theta : Real) : Complex) * Complex.I) theta := by
      simpa only [Complex.real_smul] using hreal.smul_const Complex.I
    simpa [mul_assoc, mul_left_comm, mul_comm] using harg.cexp
  have hV : ∀ theta ∈ uIcc a b,
      HasDerivAt (fun x : Real => s * E x)
        (E theta * (Real.cos theta : Complex)) theta := by
    intro theta htheta
    have h := (hE theta htheta).const_mul s
    have hcancel : s * (E theta * (q * (Real.cos theta : Complex))) =
        E theta * (Real.cos theta : Complex) := by
      calc
        s * (E theta * (q * (Real.cos theta : Complex))) =
            (s * q) * (E theta * (Real.cos theta : Complex)) := by ring
        _ = E theta * (Real.cos theta : Complex) := by rw [hsq, one_mul]
    simpa only [hcancel] using h
  have hA'cont : Continuous A' := by
    dsimp [A']
    exact hA.continuous_deriv (by simp)
  have hV'cont : Continuous (fun theta : Real =>
      E theta * (Real.cos theta : Complex)) := by
    dsimp [E]
    fun_prop
  have hparts := intervalIntegral.integral_mul_deriv_eq_deriv_mul
    (u := A) (u' := A') (v := fun theta : Real => s * E theta)
    (v' := fun theta : Real => E theta * (Real.cos theta : Complex))
    hAderiv hV (hA'cont.intervalIntegrable a b) (hV'cont.intervalIntegrable a b)
  have hboundary :
      A b * (s * E b) - A a * (s * E a) = 0 := by
    dsimp [a, b]
    rw [hends.1, hends.2]
    ring
  have hright :
      (∫ theta in a..b, A' theta * (s * E theta)) =
        s * ∫ theta in a..b, A' theta * E theta := by
    rw [← intervalIntegral.integral_const_mul]
    refine intervalIntegral.integral_congr (fun theta _ => ?_)
    ring
  calc
    (∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
      A theta * ((Real.cos theta : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)) =
      ∫ theta in a..b, A theta * (E theta * (Real.cos theta : Complex)) := by
        apply intervalIntegral.integral_congr
        intro theta _
        dsimp [a, b, E]
        ring
    _ = A b * (s * E b) - A a * (s * E a) -
        ∫ theta in a..b, A' theta * (s * E theta) := hparts
    _ = -s * ∫ theta in a..b, A' theta * E theta := by
      rw [hboundary, hright]
      ring
    _ = -((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
      rfl

/-- A smooth pole-vanishing meridian amplitude has the basic `|l|⁻¹`
nonstationary bound. -/
private theorem aux_exists_meridian_nonstationary_decay
    (A : Real → Complex) (hA : ContDiff Real (⊤ : ℕ∞) A)
    (hends : A (-(Real.pi / 2)) = 0 ∧ A (Real.pi / 2) = 0) :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
        A theta * ((Real.cos theta : Real) : Complex) *
          Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤ C / |l| := by
  let A' : Real → Complex := fun theta => deriv A theta
  have hA'cont : Continuous A' := by
    dsimp [A']
    exact hA.continuous_deriv (by simp)
  have hcompact : IsCompact
      (A' '' Icc (-(Real.pi / 2) : Real) (Real.pi / 2)) :=
    isCompact_Icc.image_of_continuousOn hA'cont.continuousOn
  rcases hcompact.isBounded.exists_pos_norm_le with ⟨M, hM, hMbound⟩
  refine ⟨Real.pi * M, mul_pos Real.pi_pos hM, ?_⟩
  intro l hl
  have hlne : l ≠ 0 := by
    intro hzero
    rw [hzero, abs_zero] at hl
    norm_num at hl
  have hinv : ‖-((((-l : Real) : Complex) * Complex.I)⁻¹)‖ = 1 / |l| := by
    rw [norm_neg, norm_inv, norm_mul, Complex.norm_real, Complex.norm_I,
      mul_one, Real.norm_eq_abs, abs_neg]
    exact inv_eq_one_div _
  have hlength : |(Real.pi / 2 : Real) - -(Real.pi / 2)| = Real.pi := by
    rw [abs_of_nonneg]
    · ring
    · nlinarith [Real.pi_pos]
  have hint :
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤
        M * Real.pi := by
    calc
      ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ ≤
          M * |(Real.pi / 2 : Real) - -(Real.pi / 2)| := by
            apply intervalIntegral.norm_integral_le_of_norm_le_const
            intro theta htheta
            have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
              rw [uIoc_of_le (by linarith [Real.pi_pos])] at htheta
              exact ⟨htheta.1.le, htheta.2⟩
            rw [norm_mul, Complex.norm_exp_ofReal_mul_I, mul_one]
            exact hMbound _ (mem_image_of_mem _ htheta')
      _ = M * Real.pi := by rw [hlength]
  rw [aux_meridian_nonstationary_ibp A hA hends hlne]
  calc
    ‖-((((-l : Real) : Complex) * Complex.I)⁻¹) *
        ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ =
      ‖-((((-l : Real) : Complex) * Complex.I)⁻¹)‖ *
        ‖∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
          deriv A theta *
            Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I)‖ := by
        rw [norm_mul]
    _ ≤ (1 / |l|) * (M * Real.pi) := by
      rw [hinv]
      exact mul_le_mul_of_nonneg_left hint (by positivity)
    _ = (Real.pi * M) / |l| := by ring

open Auto.Spherical.OscillatoryIntegralAux in
/-- The frequency derivative of the middle meridian has the same
nonstationary `|l|⁻¹` decay as the middle meridian itself.  The key point is
that the derivative's sine factor is absorbed into the already guarded
cosine quotient before one more elementary meridian integration by parts. -/
theorem aux_exists_norm_circleMiddleMeridianFrequencyDerivative_decay_one :
    ∃ C : Real, 0 < C ∧ ∀ l : Real, 1 ≤ |l| →
      ‖aux_circleMiddleMeridianFrequencyDerivative l‖ ≤ C / |l| := by
  let A : Real → Complex :=
    Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleIBPAmplitude 0
  let B : Real → Complex := fun theta =>
    A theta * (((-Real.sin theta : Real) : Complex) * Complex.I)
  have hB : ContDiff Real (⊤ : ℕ∞) B := by
    dsimp [B, A]
    refine Auto.Spherical.OscillatoryIntegralAux.contDiff_coordinateMiddleIBPAmplitude 0 |>.mul ?_
    exact (Complex.ofRealCLM.contDiff.comp Real.contDiff_sin.neg).mul contDiff_const
  have hends : B (-(Real.pi / 2)) = 0 ∧ B (Real.pi / 2) = 0 := by
    rcases coordinateMiddleIBPAmplitude_eq_zero_at_meridian_endpoints
      0 with ⟨hleft, hright⟩
    constructor
    · simp [B, A, hleft]
    · simp [B, A, hright]
  obtain ⟨C, hC, hdecay⟩ := aux_exists_meridian_nonstationary_decay B hB hends
  refine ⟨C, hC, ?_⟩
  intro l hl
  have hidentity : aux_circleMiddleMeridianFrequencyDerivative l =
      ∫ theta in (-(Real.pi / 2) : Real)..(Real.pi / 2),
        B theta * ((Real.cos theta : Real) : Complex) *
          Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I) := by
    unfold aux_circleMiddleMeridianFrequencyDerivative
    apply intervalIntegral.integral_congr
    intro theta htheta
    have htheta' : theta ∈ Icc (-(Real.pi / 2) : Real) (Real.pi / 2) := by
      rw [uIcc_of_le (by linarith [Real.pi_pos])] at htheta
      exact htheta
    have hmiddle := coordinateMiddleIBPAmplitude_mul_cos_eq_middle
      0 htheta'
    have hmiddle' : A theta * ((Real.cos theta : Real) : Complex) =
        (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianCutoff
          theta : Complex) := by
      dsimp [A]
      simpa using hmiddle
    dsimp [B]
    rw [← hmiddle']
    ring
  rw [hidentity]
  exact hdecay l hl

/-- Chain rule for the middle meridian along the radial time-frequency
parameter. -/
theorem aux_hasDerivAt_circleMiddleMeridian_timeParameter
    (t : Real) (xi : Euclidean 2) :
    HasDerivAt
      (fun s : Real =>
        Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
          0 (2 * Real.pi * (s * ‖xi‖)))
      (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) t := by
  have harg : HasDerivAt (fun s : Real => 2 * Real.pi * (s * ‖xi‖))
      (2 * Real.pi * ‖xi‖) t := by
    simpa [mul_assoc] using
      ((hasDerivAt_id t).mul_const ‖xi‖).const_mul (2 * Real.pi)
  have hcomp :=
    (aux_hasDerivAt_circleMiddleMeridianLocalizedIntegral_zero
      (2 * Real.pi * (t * ‖xi‖))).scomp t harg
  change HasDerivAt
    (Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral 0 ∘
      fun s : Real => 2 * Real.pi * (s * ‖xi‖))
    (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
      aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) t
  exact hcomp

/-- On the high-frequency, unit-time range, the radial time derivative of
the scalar middle meridian is uniformly bounded.  Its factor `‖xi‖` is
cancelled by the proven `|l|⁻¹` nonstationary decay of the frequency
derivative. -/
theorem aux_exists_norm_circleMiddleMeridian_timeDerivative_le_one :
    ∃ C : Real, 0 < C ∧ ∀ (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ ≤ C := by
  obtain ⟨C, hC, hdecay⟩ :=
    aux_exists_norm_circleMiddleMeridianFrequencyDerivative_decay_one
  refine ⟨C, hC, ?_⟩
  intro t xi ht hlambda
  let R : Real := 2 * Real.pi * ‖xi‖
  let L : Real := 2 * Real.pi * (t * ‖xi‖)
  have htpos : 0 < t := lt_of_lt_of_le zero_lt_one ht
  have hLpos : 0 < L := lt_of_lt_of_le zero_lt_one hlambda
  have hnormpos : 0 < ‖xi‖ := by
    by_contra hnot
    have hnormzero : ‖xi‖ = 0 := le_antisymm (le_of_not_gt hnot) (norm_nonneg _)
    have hLzero : L = 0 := by
      dsimp [L]
      rw [hnormzero]
      ring
    linarith
  have hRpos : 0 < R := by
    dsimp [R]
    positivity
  have hRle : R ≤ L := by
    dsimp [R, L]
    have htnorm : ‖xi‖ ≤ t * ‖xi‖ :=
      le_mul_of_one_le_left (norm_nonneg xi) ht
    exact mul_le_mul_of_nonneg_left htnorm (by positivity)
  have hderiv : ‖aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ C / L := by
    have h := hdecay L (by rwa [abs_of_nonneg hLpos.le])
    simpa only [abs_of_nonneg hLpos.le] using h
  have hratio : R * (C / L) ≤ C := by
    calc
      R * (C / L) ≤ R * (C / R) :=
        mul_le_mul_of_nonneg_left
          (div_le_div_of_nonneg_left hC.le hRpos hRle) hRpos.le
      _ = C := by field_simp [hRpos.ne']
  change ‖(R : Complex) * aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ C
  rw [norm_mul, Complex.norm_real, Real.norm_of_nonneg hRpos.le]
  calc
    R * ‖aux_circleMiddleMeridianFrequencyDerivative L‖ ≤ R * (C / L) :=
      mul_le_mul_of_nonneg_left hderiv hRpos.le
    _ ≤ C := hratio

/-- The literal time derivative multiplier for the dyadic middle wave. -/
noncomputable def aux_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : Euclidean 2 → Complex :=
  fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
        aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi

/-- The preceding multiplier is the genuine time derivative of the literal
middle dyadic multiplier. -/
theorem aux_hasDerivAt_circleMiddleBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    HasDerivAt (fun s : Real => aux_circleMiddleBandpassMultiplier C j s xi)
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi) t := by
  let c : Complex := ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex)
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi
  have hscalar := aux_hasDerivAt_circleMiddleMeridian_timeParameter t xi
  have hproduct := (hscalar.const_mul c).mul_const b
  change HasDerivAt (fun s : Real => c *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (s * ‖xi‖)) * b)
    (c * (((2 * Real.pi * ‖xi‖ : Real) : Complex) *
      aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))) * b) t
  exact hproduct

/-- Uniform pointwise control of the literal time derivative multiplier once
the radial frequency is at least one. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_of_frequency
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2), 1 ≤ t →
      1 ≤ 2 * Real.pi * (t * ‖xi‖) →
      ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ ≤ B := by
  obtain ⟨A, hA, htime⟩ := aux_exists_norm_circleMiddleMeridian_timeDerivative_le_one
  let K : Real := ‖((surfaceMass 2)⁻¹ : Complex)‖ * surfaceMass 1
  let B : Real := 2 * K * A
  have hmass2 : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hK : 0 < K := by
    dsimp only [K]
    have hinv : 0 < ‖((surfaceMass 2)⁻¹ : Complex)‖ :=
      norm_pos_iff.mpr (inv_ne_zero hmass2)
    have hmass1 : 0 < surfaceMass 1 := surfaceMass_pos (by norm_num)
    positivity
  refine ⟨B, by dsimp only [B]; positivity, ?_⟩
  intro j t xi ht hlambda
  have hcut :
      ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ 2 :=
    _root_.Auto.LittlewoodPaley.norm_dyadicBandpassMultiplier_le_two C j xi
  have hscalar := htime t xi ht hlambda
  have hinner :
      ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
          aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
        ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ ≤ A * 2 :=
    mul_le_mul hscalar hcut (norm_nonneg _) (by positivity)
  have hmass1 : 0 ≤ surfaceMass 1 := (surfaceMass_pos (by norm_num)).le
  calc
    ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ =
        K *
          ‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
            aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖ := by
          unfold aux_circleMiddleBandpassMultiplierTimeDerivative
          rw [norm_mul, norm_mul, norm_mul, Complex.norm_real,
            Real.norm_of_nonneg hmass1]
    _ = K *
        (‖((2 * Real.pi * ‖xi‖ : Real) : Complex) *
            aux_circleMiddleMeridianFrequencyDerivative (2 * Real.pi * (t * ‖xi‖))‖ *
          ‖_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi‖) := by ring
    _ ≤ K * (A * 2) := mul_le_mul_of_nonneg_left hinner hK.le
    _ = B := by dsimp only [B]; ring

/-- On the active dyadic band at unit-scale time, the literal middle time
derivative multiplier has a uniform pointwise bound. -/
theorem aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_on_dyadicBandpass
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real) (xi : Euclidean 2),
      1 ≤ t → t ≤ 2 →
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi ≠ 0 →
      ‖aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi‖ ≤ B := by
  obtain ⟨B, hB, hbound⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_of_frequency C
  refine ⟨B, hB, ?_⟩
  intro j t xi ht htop hband
  apply hbound j t xi ht
  have hfrequency : dyadicScale j ≤ 2 * Real.pi * (t * ‖xi‖) :=
    aux_dyadicFrequency_le_circleEndpointFrequency C j t xi ht hband
  have hone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  exact hone.trans hfrequency

private theorem aux_circleMiddleBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    aux_circleMiddleBandpassMultiplierTimeDerivative C j t =ᶠ[nhds 0] fun _ => 0 := by
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) zero_lt_one] with xi hxi
  have hxinorm : ‖xi‖ < 1 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  have hone : 1 ≤ (2 : Real) ^ j :=
    one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
      (hxinorm.le.trans hone)
  simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband]

theorem aux_contDiff_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    ContDiff Real (⊤ : ℕ∞)
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j t) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (aux_circleMiddleBandpassMultiplierTimeDerivative_eventuallyEq_zero_at_zero C j t)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have hscale : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        ((2 * Real.pi * ‖eta‖ : Real) : Complex)) xi := by
      have hscaleReal : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
          2 * Real.pi * ‖eta‖) xi := by
        fun_prop
      exact Complex.ofRealCLM.contDiff.contDiffAt.comp xi hscaleReal
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        2 * Real.pi * (t * ‖eta‖)) xi := by
      fun_prop
    have hfrequency : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        aux_circleMiddleMeridianFrequencyDerivative
          (2 * Real.pi * (t * ‖eta‖))) xi :=
      aux_contDiff_circleMiddleMeridianFrequencyDerivative.contDiffAt.comp xi harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) xi :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt
    unfold aux_circleMiddleBandpassMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul
      (hscale.mul hfrequency)).mul hcut)

theorem aux_hasCompactSupport_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) :
    HasCompactSupport (aux_circleMiddleBandpassMultiplierTimeDerivative C j t) := by
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
  intro xi hxi
  have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hband :
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
    _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
  simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband]

/-- The compactly frequency-localized time derivative of the middle wave as
a genuine Schwartz multiplier. -/
noncomputable def aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) : SchwartzMap (Euclidean 2) Complex :=
  (aux_hasCompactSupport_circleMiddleBandpassMultiplierTimeDerivative C j t).toSchwartzMap
    (aux_contDiff_circleMiddleBandpassMultiplierTimeDerivative C j t)

theorem aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (xi : Euclidean 2) :
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t xi =
      aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi := rfl

/-- The inverse Fourier contribution associated to the literal time
derivative of the dyadic middle multiplier. -/
noncomputable def aux_circleMiddleWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

theorem aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    aux_circleMiddleWaveContributionTimeDerivative C j t f x =
      𝓕⁻ (fun xi : Euclidean 2 =>
        aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x := by
  unfold aux_circleMiddleWaveContributionTimeDerivative
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext xi
  rw [aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply]

/-- Plancherel gives a uniform fixed-time `L²` estimate for the derivative
middle contribution on the unit time interval. -/
theorem aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        (∫ x : Euclidean 2, ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤
          B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hpoint⟩ :=
    aux_exists_norm_circleMiddleBandpassMultiplierTimeDerivative_le_on_dyadicBandpass C
  refine ⟨B, hB, ?_⟩
  intro j t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t
  have hm_bound (xi : Euclidean 2) : ‖m xi‖ ≤ B := by
    rw [show m xi = aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi by
      exact aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply C j t xi]
    by_cases hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0
    · simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband, hB.le]
    · exact hpoint j t xi ht htop hband
  have hmult := _root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) hB.le hm_bound
  calc
    (∫ x : Euclidean 2, ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖𝓕⁻ (fun xi : Euclidean 2 =>
          m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
          rfl
    _ ≤ B ^ 2 * ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
      rw [_root_.Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

open Auto.Spherical.OscillatoryIntegralAux in
theorem aux_continuous_circleEndpointAmplitude
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real) :
    Continuous (fun xi : Euclidean 2 =>
      circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖))) := by
  have hA : Continuous (circleEndpointAmplitude σ) := by
    cases σ with
    | minus =>
        exact contDiff_planarEndpointQuadraticIntegral.continuous
    | plus =>
        exact contDiff_planarEndpointQuadraticIntegral.continuous.comp
          continuous_neg
  exact hA.comp (by fun_prop)

theorem aux_continuous_halfWaveMultiplier
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : Real) :
    Continuous (_root_.Auto.Spherical.MSS.halfWaveMultiplier σ t) := by
  unfold _root_.Auto.Spherical.MSS.halfWaveMultiplier
  apply Complex.continuous_exp.comp
  exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const

theorem aux_continuous_coordinateMiddleMeridianLocalizedIntegral_zero :
    Continuous (fun l : Real =>
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral 0 l) := by
  unfold Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
  have hcut : Continuous (fun u : Real =>
      (Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff u : Complex)) := by
    change Continuous (fun u : Real =>
      (Auto.Spherical.OscillatoryIntegralAux.endpointCoreBump u : Complex))
    have hcore : ContDiff Real (⊤ : ℕ∞)
        (Auto.Spherical.OscillatoryIntegralAux.endpointCoreBump : Real → Real) :=
      Auto.Spherical.OscillatoryIntegralAux.endpointCoreBump.contDiff
    exact Complex.continuous_ofReal.comp hcore.continuous
  have hupper : Continuous (Function.uncurry (fun (l : Real) (theta : Real) =>
      (Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
        (Real.sqrt (1 - Real.sin theta)) : Complex) *
        ((Real.cos theta ^ 0 : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I))) := by
    have hsqrt : Continuous (fun p : Real × Real => Real.sqrt (1 - Real.sin p.2)) :=
      Real.continuous_sqrt.comp (continuous_const.sub (Real.continuous_sin.comp continuous_snd))
    have hcos : Continuous (fun p : Real × Real => ((Real.cos p.2 ^ 0 : Real) : Complex)) :=
      Complex.continuous_ofReal.comp ((Real.continuous_cos.comp continuous_snd).pow 0)
    have hexp : Continuous (fun p : Real × Real =>
        Complex.exp (((-p.1 * Real.sin p.2 : Real) : Complex) * Complex.I)) := by
      apply Complex.continuous_exp.comp
      exact (Complex.continuous_ofReal.comp
        ((continuous_fst.neg).mul (Real.continuous_sin.comp continuous_snd))).mul continuous_const
    exact ((hcut.comp hsqrt).mul hcos).mul hexp
  have hlower : Continuous (Function.uncurry (fun (l : Real) (theta : Real) =>
      (Auto.Spherical.OscillatoryIntegralAux.endpointCoreCutoff
        (Real.sqrt (1 + Real.sin theta)) : Complex) *
        ((Real.cos theta ^ 0 : Real) : Complex) *
        Complex.exp (((-l * Real.sin theta : Real) : Complex) * Complex.I))) := by
    have hsqrt : Continuous (fun p : Real × Real => Real.sqrt (1 + Real.sin p.2)) :=
      Real.continuous_sqrt.comp (continuous_const.add (Real.continuous_sin.comp continuous_snd))
    have hcos : Continuous (fun p : Real × Real => ((Real.cos p.2 ^ 0 : Real) : Complex)) :=
      Complex.continuous_ofReal.comp ((Real.continuous_cos.comp continuous_snd).pow 0)
    have hexp : Continuous (fun p : Real × Real =>
        Complex.exp (((-p.1 * Real.sin p.2 : Real) : Complex) * Complex.I)) := by
      apply Complex.continuous_exp.comp
      exact (Complex.continuous_ofReal.comp
        ((continuous_fst.neg).mul (Real.continuous_sin.comp continuous_snd))).mul continuous_const
    exact ((hcut.comp hsqrt).mul hcos).mul hexp
  apply Continuous.sub
  · apply Continuous.sub
    · apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      fun_prop
    · apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      exact hupper
  · apply intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
    exact hlower

private theorem aux_contDiff_coordinateMiddleMeridianLocalizedIntegral_zero :
    ContDiff Real (⊤ : ℕ∞) (fun l : Real =>
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 l) := by
  rw [show (fun l : Real =>
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 l) = aux_circleMiddleSineMoment 0 by
    funext l
    exact (aux_circleMiddleSineMoment_zero_eq_middle l).symm]
  exact aux_contDiff_circleMiddleSineMoment 0

theorem aux_continuous_uncurry_circleMiddleBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat) :
    Continuous (Function.uncurry (fun t xi => aux_circleMiddleBandpassMultiplier C j t xi)) := by
  rw [continuous_iff_continuousAt]
  intro q
  by_cases hxi : q.2 = 0
  · have hnear : ∀ᶠ p : Real × Euclidean 2 in nhds q, p.2 ∈ Metric.ball q.2 1 :=
      (continuous_snd.tendsto q).eventually (Metric.ball_mem_nhds q.2 zero_lt_one)
    have hzero : (fun p : Real × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C j p.1 p.2) =ᶠ[nhds q] fun _ => 0 := by
      filter_upwards [hnear] with p hp
      have hpnorm : ‖p.2‖ < 1 := by
        simpa only [hxi, Metric.mem_ball, dist_zero_right] using hp
      have hone : 1 ≤ (2 : Real) ^ j :=
        one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
      have hband :
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j p.2 = 0 :=
        _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
          (hpnorm.le.trans hone)
      simp [aux_circleMiddleBandpassMultiplier, hband]
    have hconst : ContinuousAt (fun _ : Real × Euclidean 2 => (0 : Complex)) q :=
      continuousAt_const
    exact hconst.congr_of_eventuallyEq hzero
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 => ‖p.2‖) q :=
      (contDiffAt_norm Real hxi).comp q contDiff_snd.contDiffAt
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        2 * Real.pi * (p.1 * ‖p.2‖)) q := by
      fun_prop
    have hmiddle : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
          0 (2 * Real.pi * (p.1 * ‖p.2‖))) q :=
      aux_contDiff_coordinateMiddleMeridianLocalizedIntegral_zero.contDiffAt.comp q harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j p.2) q :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt.comp q contDiff_snd.contDiffAt
    unfold aux_circleMiddleBandpassMultiplier
    exact (((contDiffAt_const.mul contDiffAt_const).mul hmiddle).mul hcut).continuousAt

theorem aux_continuous_uncurry_circleMiddleBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat) :
    Continuous (Function.uncurry
      (fun t xi => aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi)) := by
  rw [continuous_iff_continuousAt]
  intro q
  by_cases hxi : q.2 = 0
  · have hnear : ∀ᶠ p : Real × Euclidean 2 in nhds q, p.2 ∈ Metric.ball q.2 1 :=
      (continuous_snd.tendsto q).eventually (Metric.ball_mem_nhds q.2 zero_lt_one)
    have hzero : (fun p : Real × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplierTimeDerivative C j p.1 p.2) =ᶠ[nhds q] fun _ => 0 := by
      filter_upwards [hnear] with p hp
      have hpnorm : ‖p.2‖ < 1 := by
        simpa only [hxi, Metric.mem_ball, dist_zero_right] using hp
      have hone : 1 ≤ (2 : Real) ^ j :=
        one_le_pow₀ (by norm_num : (1 : Real) ≤ 2)
      have hband :
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j p.2 = 0 :=
        _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_norm_le C
          (hpnorm.le.trans hone)
      simp [aux_circleMiddleBandpassMultiplierTimeDerivative, hband]
    have hconst : ContinuousAt (fun _ : Real × Euclidean 2 => (0 : Complex)) q :=
      continuousAt_const
    exact hconst.congr_of_eventuallyEq hzero
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 => ‖p.2‖) q :=
      (contDiffAt_norm Real hxi).comp q contDiff_snd.contDiffAt
    have hscaleReal : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        2 * Real.pi * ‖p.2‖) q := by
      fun_prop
    have hscale : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        ((2 * Real.pi * ‖p.2‖ : Real) : Complex)) q :=
      Complex.ofRealCLM.contDiff.contDiffAt.comp q hscaleReal
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        2 * Real.pi * (p.1 * ‖p.2‖)) q := by
      fun_prop
    have hfrequency : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        aux_circleMiddleMeridianFrequencyDerivative
          (2 * Real.pi * (p.1 * ‖p.2‖))) q :=
      aux_contDiff_circleMiddleMeridianFrequencyDerivative.contDiffAt.comp q harg
    have hcut : ContDiffAt Real (⊤ : ℕ∞) (fun p : Real × Euclidean 2 =>
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j p.2) q :=
      ((_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).smooth
        (⊤ : ℕ∞)).contDiffAt.comp q contDiff_snd.contDiffAt
    unfold aux_circleMiddleBandpassMultiplierTimeDerivative
    exact (((contDiffAt_const.mul contDiffAt_const).mul
      (hscale.mul hfrequency)).mul hcut).continuousAt

theorem aux_integrable_continuous_mul_dyadicBandpass_fourier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat)
    (a : Euclidean 2 → Complex) (ha : Continuous a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun xi : Euclidean 2 =>
      a xi * _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        𝓕 (f : Euclidean 2 → Complex) xi) := by
  apply Continuous.integrable_of_hasCompactSupport
  · exact (ha.mul
      (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).continuous).mul
        (𝓕 f).continuous
  · apply HasCompactSupport.intro
      (isCompact_closedBall (0 : Euclidean 2) ((2 : Real) ^ (j + 2)))
    intro xi hxi
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxi
      exact le_of_not_ge hxi
    have hband := _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    simp [hband]

/-- The literal middle dyadic wave and its literal time-derivative wave are
jointly continuous, and the latter is the pointwise derivative of the
former.  Compact frequency support makes differentiation under the inverse
Fourier integral legitimate without any unrecorded limiting argument. -/
theorem aux_continuous_and_hasDerivAt_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry (fun t x => circleMiddleWaveContribution C j t f x)) ∧
      Continuous (Function.uncurry
        (fun t x => aux_circleMiddleWaveContributionTimeDerivative C j t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => circleMiddleWaveContribution C j s f x)
        (aux_circleMiddleWaveContributionTimeDerivative C j t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleMiddleBandpassMultiplier C j q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleMiddleBandpassMultiplier C j q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (aux_continuous_uncurry_circleMiddleBandpassMultiplier C j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplier C j q.1.1 q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (aux_continuous_uncurry_circleMiddleBandpassMultiplierTimeDerivative C j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleMiddleBandpassMultiplierTimeDerivative C j q.1.1 q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, aux_circleMiddleBandpassMultiplier, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', aux_circleMiddleBandpassMultiplierTimeDerivative, hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) :
      F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp only [F, G]
      rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) :
      D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp only [D, G']
      rw [aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier C j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    have hmult := aux_hasDerivAt_circleMiddleBandpassMultiplier C j t xi
    have hproduct := hmult.mul_const (𝓕 (f : Euclidean 2 → Complex) xi)
    have hfull := hproduct.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa only [G, G'] using hfull
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘
      fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

/-- Each nonnegative-time middle wave slice has integrable squared norm. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (ht : 0 ≤ t)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖circleMiddleWaveContribution C j t f x‖ ^ 2)
      volume := by
  obtain ⟨m, hm⟩ := aux_exists_circleMiddleBandpassSchwartzSymbol C j t ht
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.integrable_norm_sq_fourierInv_schwartz_multiplier
      m (𝓕 f)
  have heq : (fun x : Euclidean 2 => circleMiddleWaveContribution C j t f x) =
      fun x : Euclidean 2 => 𝓕⁻ (fun xi : Euclidean 2 =>
        m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x := by
    funext x
    rw [aux_circleMiddleWaveContribution_eq_fourierInv_multiplier C j t f x]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    rw [hm xi]
  apply hsq.congr
  filter_upwards with x
  rw [congrFun heq x]
  rfl

/-- Each literal middle time-derivative slice has integrable squared norm. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : Real) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) volume := by
  let m : SchwartzMap (Euclidean 2) Complex :=
    aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol C j t
  have hsq :=
    _root_.Auto.Spherical.Auxiliary.integrable_norm_sq_fourierInv_schwartz_multiplier
      m (𝓕 f)
  have heq : (fun x : Euclidean 2 =>
      aux_circleMiddleWaveContributionTimeDerivative C j t f x) =
      fun x : Euclidean 2 => 𝓕⁻ (fun xi : Euclidean 2 =>
        m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x := by
    funext x
    rw [aux_circleMiddleWaveContributionTimeDerivative_eq_fourierInv_multiplier C j t f x]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    rw [show m xi = aux_circleMiddleBandpassMultiplierTimeDerivative C j t xi by
      exact aux_circleMiddleBandpassMultiplierTimeDerivativeSchwartzSymbol_apply C j t xi]
  apply hsq.congr
  filter_upwards with x
  rw [congrFun heq x]
  rfl

/-- The literal middle time derivative has integrable squared norm on the
unit time slab.  This is the Fubini hypothesis required by the spatial
time-Sobolev estimate. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖aux_circleMiddleWaveContributionTimeDerivative C j p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  obtain ⟨B, hB, hbound⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hDint (t : Real) : Integrable (fun x : Euclidean 2 => ‖D t x‖ ^ 2) volume := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative C j t f
  have hDbound (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [D, E] using hbound j t ht.1 ht.2 f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  change Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2) (ν.prod volume)
  have hmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖D p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hDcont.norm.pow 2).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hDint t
  · have houter_meas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν :=
      ((hDcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν := by
      apply Integrable.of_bound houter_meas (B ^ 2 * E)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
      exact hDbound t ht
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter

/-- The spatial time-Sobolev estimate applies to the literal middle wave on
the unit interval.  This records the exact integration point between the
dyadic multiplier bounds and the pre-existing Fubini/Sobolev infrastructure. -/
theorem aux_timeSobolevL2_spacetime_circleMiddleWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex)
    (r : Real) (hr : r ∈ Icc (1 : Real) 2) :
    (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j r f x‖ ^ 2) ≤
      2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
        2 * ((2 : Real) - 1) *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
            ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFrmeas : AEStronglyMeasurable (F r) volume := by
    have hslice : Continuous (F r) := by
      change Continuous ((Function.uncurry F) ∘ fun x : Euclidean 2 => (r, x))
      exact hFcont.comp
        ((continuous_const : Continuous fun _ : Euclidean 2 => r).prodMk continuous_id)
    exact hslice.aestronglyMeasurable
  have hDtime : ∀ x : Euclidean 2, Continuous (fun t => D t x) := by
    intro x
    change Continuous ((Function.uncurry D) ∘ fun t : Real => (t, x))
    exact hDcont.comp
      (continuous_id.prodMk (continuous_const : Continuous fun _ : Real => x))
  have hFone : Integrable (fun x : Euclidean 2 => ‖F 1 x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j 1 (by norm_num) f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  simpa only [F, D] using
    timeSobolevL2_spacetime (F := F) (F' := D) hr hFrmeas hDtime hderiv hFone hDprod

/-- A genuine short-time square maximal estimate for the literal middle
contribution.  Its right-hand side is the fully justified Sobolev energy
from the previous theorem, before any optional numerical simplification. -/
theorem aux_measurable_and_lintegral_iSup_circleMiddleWaveContribution_le_timeSobolev
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (fun x : Euclidean 2 =>
      ⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ∧
      (∫⁻ x : Euclidean 2,
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ≤
        ENNReal.ofReal
          (2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
            2 * ((2 : Real) - 1) *
              ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
                ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFone : Integrable (fun x : Euclidean 2 => ‖F 1 x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j 1 (by norm_num) f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  simpa only [F, D] using
    (measurable_and_lintegral_iSup_ennreal_norm_sq_le_radiusSobolev_of_hasDerivAt
      (F := F) (F' := D) (a := (1 : Real)) (b := 2) (by norm_num)
      hFcont hDcont hderiv hFone hDprod)

/-- The preceding square-maximal estimate yields an ordinary `L²` estimate
for the short-time supremum of the literal middle wave. -/
theorem aux_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_timeSobolev
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    MemLp (fun x : Euclidean 2 =>
      (⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
          2 * ((2 : Real) - 1) *
            ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
              ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2 := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let Q : Euclidean 2 → ENNReal := fun x =>
    ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal (‖F t.1 x‖ ^ 2)
  let K : Real :=
    2 * (∫ x : Euclidean 2, ‖F 1 x‖ ^ 2) +
      2 * ((2 : Real) - 1) *
        ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
          ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2
  obtain ⟨hQmeas, hQbound⟩ :=
    aux_measurable_and_lintegral_iSup_circleMiddleWaveContribution_le_timeSobolev C j f
  have hQmeas' : Measurable Q := by
    simpa only [F, Q] using hQmeas
  have hQbound' : (∫⁻ x : Euclidean 2, Q x) ≤ ENNReal.ofReal K := by
    simpa only [F, Q, K] using hQbound
  have hK : 0 ≤ K := by
    dsimp only [K]
    apply add_nonneg
    · positivity
    · apply mul_nonneg
      · positivity
      · exact intervalIntegral.integral_nonneg (by norm_num) fun t _ =>
          integral_nonneg fun _ => sq_nonneg _
  have hsq :=
    _root_.Auto.Spherical.SphericalMaximalL2.memLp_two_toReal_sqrt_of_measurable_lintegral
      Q hQmeas' hK hQbound'
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hordinary :=
    SphericalMaximalL2.memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
      (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hFcont hsq.1 hsq.2
  simpa only [F, K] using hordinary

/-- Integrating the fixed-time derivative estimate over the unit interval
gives the quantitative derivative-energy bound used by the middle maximal
term. -/
theorem aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContributionTimeDeriv_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤
        B ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContributionTimeDerivative_le C
  refine ⟨B, hB, ?_⟩
  intro j f
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [D, E] using hfixed j t ht.1 ht.2 f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
        ∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2 := rfl
    _ ≤ ∫ _t in (1 : Real)..2, B ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const
          hpoint
    _ = B ^ 2 * E := by norm_num

/- The nonstationary middle piece has a uniform literal short-time `L²`
maximal bound.  This is obtained solely from its proved dyadic fixed-time
bound, the derivative-energy bound, and the time-Sobolev estimate. -/
/-- The literal middle-wave square is integrable on the unit time slab.
The estimate uses the nonstationary fixed-time gain at each time and then
Fubini; it is the input-side energy needed for dyadic time sampling. -/
theorem aux_integrable_norm_sq_circleMiddleWaveContribution_prod
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖circleMiddleWaveContribution C j p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  obtain ⟨A, hA, hbound⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hFint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      Integrable (fun x : Euclidean 2 => ‖F t x‖ ^ 2) volume := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution C j t
        (zero_le_one.trans ht.1) f
  have hFbound (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hbound j t ht.1 ht.2 f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  change Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2) (ν.prod volume)
  have hmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hFcont.norm.pow 2).aestronglyMeasurable
  refine (integrable_prod_iff hmeas).2 ?_
  constructor
  · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
    exact hFint t ht
  · have houter_meas : AEStronglyMeasurable (fun t : Real =>
        ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν :=
      ((hFcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
    have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν := by
      apply Integrable.of_bound houter_meas ((A / dyadicScale j) ^ 2 * E)
      filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
      exact hFbound t ht
    simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter

/-- Integrating the nonstationary fixed-time middle-wave estimate over the
unit time interval preserves its full inverse dyadic-frequency gain. -/
theorem aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContribution_le_dyInverse
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖circleMiddleWaveContribution C j t f x‖ ^ 2) ≤
        (A / dyadicScale j) ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  refine ⟨A, hA, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hfixed j t ht.1 ht.2 f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
        ∫ _t in (1 : Real)..2, (A / dyadicScale j) ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const
          hpoint
    _ = (A / dyadicScale j) ^ 2 * E := by norm_num

private theorem aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ≤
          ENNReal.ofReal
            (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
              ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨A, hA, hFbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContribution_le_dyInverse C
  obtain ⟨B, hB, hDbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContributionTimeDeriv_le C
  let M : Real := 4 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated j
  obtain ⟨hmeas, hsampling⟩ :=
    measurable_and_lintegral_iSup_ennreal_norm_sq_le_timeSamplingL2
      (F := F) (F' := D) j T hT hFcont hDcont hderiv hFprod hDprod
  refine ⟨?_, hsampling.trans ?_⟩
  · simpa only [F] using hmeas
  · apply ENNReal.ofReal_le_ofReal
    have hF :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
      simpa only [F, E] using hFbound j f
    have hD :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          B ^ 2 * E := by
      simpa only [D, E] using hDbound j f
    let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
    let R : Real := dyadicScale j
    have hR : 0 < R := by
      dsimp only [R]
      exact dyadicScale_pos j
    have hδ : δ = R⁻¹ := by
      dsimp only [δ, R]
      simp [_root_.Auto.Spherical.MSS.dyadicTimeScale, dyadicScale, zpow_neg]
    have hδnonneg : 0 ≤ δ := by
      rw [hδ]
      exact inv_nonneg.mpr hR.le
    have hδinvnonneg : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδnonneg
    have hsamplebound :
        8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
          6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := by
      apply add_le_add
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hF)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 8) hδinvnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hD)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 6) hδnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
    have hformula :
        8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) =
          ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := by
      rw [hδ]
      field_simp [hR.ne']
    have hcoeff : 8 * A ^ 2 + 6 * B ^ 2 ≤ M ^ 2 := by
      dsimp only [M]
      nlinarith [sq_nonneg A, sq_nonneg B, mul_nonneg hA.le hB.le]
    have hfinal : ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤
        M ^ 2 * δ * E := by
      rw [hδ]
      calc
        ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤ (M ^ 2 / R) * E := by
          exact mul_le_mul_of_nonneg_right
            (div_le_div_of_nonneg_right hcoeff hR.le) hE
        _ = M ^ 2 * R⁻¹ * E := by ring
    calc
      8 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
        6 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
          8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
            6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) := by rfl
      _ ≤ 8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := hsamplebound
      _ = ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := hformula
      _ ≤ M ^ 2 * δ * E := hfinal
      _ = M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by rfl

/-- Dyadic-time sampling preserves a half-power of the nonstationary middle
gain: the continuous-time middle maximum has square energy `O(2⁻ʲ)`. -/
theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circMidWvContribution_le_dyGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
            ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let Q : Euclidean 2 → ENNReal := fun x =>
    ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal (‖F t.1 x‖ ^ 2)
  let K : Real := M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
    ∫ x : Euclidean 2, ‖f x‖ ^ 2
  obtain ⟨hQmeas, hQbound⟩ := hbound j f
  have hQmeas' : Measurable Q := by
    simpa only [F, Q] using hQmeas
  have hQbound' : (∫⁻ x : Euclidean 2, Q x) ≤ ENNReal.ofReal K := by
    simpa only [F, Q, K] using hQbound
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact mul_nonneg (mul_nonneg (sq_nonneg _) (by
      dsimp only [_root_.Auto.Spherical.MSS.dyadicTimeScale]
      exact zpow_nonneg (by norm_num) _))
      (integral_nonneg fun _ => sq_nonneg _)
  have hsq :=
    _root_.Auto.Spherical.SphericalMaximalL2.memLp_two_toReal_sqrt_of_measurable_lintegral
      Q hQmeas' hK hQbound'
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hordinary :=
    SphericalMaximalL2.memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
      (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hFcont hsq.1 hsq.2
  simpa only [F, K] using hordinary

/-- The literal continuous-time maximal function of the nonstationary middle
wave on one dyadic annulus and the unit time slab.  This contains neither
endpoint contribution, so its summability below is independent of the MSS
local-smoothing input. -/
noncomputable def circleMiddleWaveMaximal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => (⨆ t : Icc (1 : Real) 2,
    ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal

/-- The dyadic middle-wave maximal terms have a literal geometric `L²` rate.
This is just the square-root form of the preceding square-energy estimate;
the ratio is `2⁻¹ᐟ²`. -/
private theorem circleMiddleWaveMaximal_eLpNorm_geometric
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (circleMiddleWaveMaximal C j f) 2 volume ∧
        eLpNorm (circleMiddleWaveMaximal C j f) 2 volume ≤
          (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            eLpNorm (f : Euclidean 2 → Complex) 2 volume := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_memLp_two_and_integral_norm_sq_iSup_circMidWvContribution_le_dyGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let G : Euclidean 2 → Real := circleMiddleWaveMaximal C j f
  obtain ⟨hGmem, hGbound⟩ := hbound j f
  have hGmem' : MemLp G 2 volume := by
    change MemLp (fun x : Euclidean 2 =>
      (⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume
    exact hGmem
  have hfmem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  have hGeq :
      eLpNorm G 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hGmem'.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hfeq :
      eLpNorm (f : Euclidean 2 → Complex) 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hGint : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ≤
      M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E := by
    change (∫ x : Euclidean 2, ‖(⨆ t : Icc (1 : Real) 2,
      ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2
    exact hGbound
  have hbudget :
      (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) =
        (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    rw [show _root_.Auto.Spherical.MSS.dyadicTimeScale j = (1 / 2 : Real) ^ j by
      rw [dyadicTimeScale_eq_inv_natPow]
      rw [show (1 / 2 : Real) = (2 : Real)⁻¹ by norm_num, inv_pow]
      norm_num [Nat.cast_pow]]
    have hrho : 0 ≤ Real.sqrt (1 / 2 : Real) := Real.sqrt_nonneg _
    have hsquare : (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 =
        M ^ 2 * (1 / 2 : Real) ^ j := by
      rw [mul_pow, show (Real.sqrt (1 / 2 : Real) ^ j) ^ 2 =
        (1 / 2 : Real) ^ j by
          rw [← pow_mul, Nat.mul_comm, pow_mul, Real.sq_sqrt (by norm_num)]]
    rw [← hsquare]
    rw [show (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 * E =
      ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) * E by ring]
    rw [Real.mul_rpow (sq_nonneg _) hE]
    have hpow : ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) ^ ((2 : Real)⁻¹) =
        M * (Real.sqrt (1 / 2 : Real)) ^ j := by
      rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [Real.sqrt_sq_eq_abs]
      rw [abs_of_nonneg (mul_nonneg hM.le (pow_nonneg hrho _))]
    rw [hpow]
  have hroot : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
      (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    calc
      (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
          (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) :=
        Real.rpow_le_rpow (integral_nonneg fun _ => sq_nonneg _) hGint (by positivity)
      _ = _ := hbudget
  rw [hGeq, hfeq]
  refine ⟨?_, ?_⟩
  · simpa only [G] using hGmem'
  · calc
      ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) ≤
          ENNReal.ofReal ((M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹)) :=
        ENNReal.ofReal_le_ofReal hroot
      _ = (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            ENNReal.ofReal (E ^ ((2 : Real)⁻¹)) := by
        rw [ENNReal.ofReal_mul (mul_nonneg hM.le (pow_nonneg (Real.sqrt_nonneg _) _)),
          ENNReal.ofReal_mul hM.le,
          ENNReal.ofReal_pow (Real.sqrt_nonneg _)]

/-- The literal middle-wave maxima are summable over every finite collection
of dyadic annuli in `L²`.  The theorem is a concrete assembly for the
nonstationary term alone and makes no endpoint or local-smoothing assertion. -/
theorem exists_memLp_two_and_eLpNorm_sum_circleMiddleWaveMaximal_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 ∧
      ∀ (N : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (fun x : Euclidean 2 =>
          ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ∧
          eLpNorm (fun x : Euclidean 2 =>
            ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ≤
            (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
              (1 - ENNReal.ofReal (Real.sqrt (1 / 2 : Real)))⁻¹ := by
  obtain ⟨M, hM, hpiece⟩ := circleMiddleWaveMaximal_eLpNorm_geometric C
  have hrho_real : Real.sqrt (1 / 2 : Real) < 1 := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num
  have hrho : ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 := by
    rw [ENNReal.ofReal_lt_one]
    exact hrho_real
  refine ⟨M, hM, hrho, ?_⟩
  intro N f
  let T : Nat → Euclidean 2 → Real := fun j => circleMiddleWaveMaximal C j f
  have hTmem (j : Nat) : MemLp (T j) 2 volume := by
    dsimp only [T]
    exact (hpiece j f).1
  have hTmeas (j : Nat) : AEStronglyMeasurable (T j) volume := (hTmem j).aestronglyMeasurable
  have hsum_mem : MemLp (fun x : Euclidean 2 => ∑ j ∈ Finset.range N, T j x)
      2 volume := by
    induction N with
    | zero => simp
    | succ n ih =>
        have hadd := ih.add (hTmem n)
        convert hadd using 1
        funext x
        simp only [Finset.sum_range_succ, Pi.add_apply]
  refine ⟨?_, ?_⟩
  · simpa only [T] using hsum_mem
  · have hsum := Auto.Spherical.Auxiliary.eLpNorm_sum_range_le_geometric
      volume 2 (by norm_num) T hTmeas
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume)
        (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ?_ N
    · simpa only [T] using hsum
    · intro j
      have h := hpiece j f
      change eLpNorm (T j) 2 volume ≤
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
          ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) ^ j
      simpa only [T, mul_assoc, mul_left_comm, mul_comm] using h.2

theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hmiddle⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  obtain ⟨B, hB, hderiv⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContributionTimeDeriv_le C
  let M : Real := 2 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  obtain ⟨hmaxmem, hmaxsob⟩ :=
    aux_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_timeSobolev C j f
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hscale_pos : 0 < dyadicScale j := dyadicScale_pos j
  have hscale_one : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hratio_nonneg : 0 ≤ A / dyadicScale j :=
    div_nonneg hA.le hscale_pos.le
  have hratio_le : A / dyadicScale j ≤ A := by
    rw [div_le_iff₀ hscale_pos]
    exact le_mul_of_one_le_right hA.le hscale_one
  have hratio_sq : (A / dyadicScale j) ^ 2 ≤ A ^ 2 := by
    nlinarith [mul_self_le_mul_self hratio_nonneg hratio_le]
  have hinitial :
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤ A ^ 2 * E := by
    calc
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
            simpa only [E] using hmiddle j 1 (by norm_num) (by norm_num) f
      _ ≤ A ^ 2 * E := mul_le_mul_of_nonneg_right hratio_sq hE
  have hderivative :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [E] using hderiv j f
  have hmaxenergy :
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        (2 * A ^ 2 + 2 * B ^ 2) * E := by
    calc
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
            2 * ((2 : Real) - 1) *
              ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
                ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2 := hmaxsob
      _ ≤ 2 * (A ^ 2 * E) + 2 * (B ^ 2 * E) := by
        norm_num
        exact add_le_add
          (mul_le_mul_of_nonneg_left hinitial (by norm_num))
          (mul_le_mul_of_nonneg_left hderivative (by norm_num))
      _ = (2 * A ^ 2 + 2 * B ^ 2) * E := by ring
  have hAB : 0 ≤ A * B := mul_nonneg hA.le hB.le
  have hcoeff : 2 * A ^ 2 + 2 * B ^ 2 ≤ M ^ 2 := by
    dsimp only [M]
    nlinarith [sq_nonneg (A - B)]
  refine ⟨hmaxmem, ?_⟩
  exact hmaxenergy.trans (mul_le_mul_of_nonneg_right hcoeff hE)

theorem aux_fourierInv_add_of_integrable
    (g h : Euclidean 2 → Complex) (hg : Integrable g) (hh : Integrable h)
    (x : Euclidean 2) :
    𝓕⁻ (g + h) x = 𝓕⁻ g x + 𝓕⁻ h x := by
  have hgchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • g xi) := by
    refine Integrable.mono' hg.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hg.aestronglyMeasurable
    · filter_upwards with xi
      simp
  have hhchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • h xi) := by
    refine Integrable.mono' hh.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hh.aestronglyMeasurable
    · filter_upwards with xi
      simp
  rw [Real.fourierInv_eq, Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ v : Euclidean 2,
      Real.fourierChar (inner Real v x) • (g v + h v)) = _
  rw [show (fun v : Euclidean 2 =>
      Real.fourierChar (inner Real v x) • (g v + h v)) =
        (fun v : Euclidean 2 =>
          Real.fourierChar (inner Real v x) • g v +
            Real.fourierChar (inner Real v x) • h v) by
      funext v
      rw [smul_add], MeasureTheory.integral_add hgchar hhchar]

theorem aux_const_mul_fourierInv
    (a : Complex) (g : Euclidean 2 → Complex) (x : Euclidean 2) :
    a * 𝓕⁻ g x = 𝓕⁻ (fun xi => a * g xi) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with xi
  change a * (Real.fourierChar (inner Real xi x) • g xi) =
    Real.fourierChar (inner Real xi x) • (a * g xi)
  rw [show a * (Real.fourierChar (inner Real xi x) • g xi) =
      (Real.fourierChar (inner Real xi x) : Complex) * (a * g xi) by
        change a * ((Real.fourierChar (inner Real xi x) : Complex) * g xi) = _
        ring]
  rfl

theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t xi =
      Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSS.halfWaveMultiplier,
    _root_.Auto.Spherical.MSS.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring_nf

theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t xi =
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSS.halfWaveMultiplier,
    _root_.Auto.Spherical.MSS.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring_nf

/-- Exact three-wave decomposition of a dyadic circular average.  The two
endpoint terms are factored through the MSS dyadic half-waves, while the
middle term remains its literal compact frequency-localized Fourier integral. -/
theorem circleDyadicBandpassThreeWaveDecomposition
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t
        (dyadicBandpassProjection
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f :
          Euclidean 2 → Complex) x =
      circleEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.minus j t f x +
        circleEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.plus j t f x +
          circleMiddleWaveContribution C j t f x := by
  let qminus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qplus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qmiddle : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  have hqminus : Integrable qminus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t))
  have hqplus : Integrable qplus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t))
  have hqmiddle : Integrable qmiddle := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact ((continuous_const.mul continuous_const).mul
      (aux_continuous_coordinateMiddleMeridianLocalizedIntegral_zero.comp (by fun_prop)))
  rw [circleBandpassFourierCoordinateWaveNormalForm
    (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f ht x]
  rw [aux_const_mul_fourierInv]
  let core : Euclidean 2 → Complex := fun xi =>
    Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) +
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) +
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖))
  have hsymbol :
      (fun xi : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) *
          (((surfaceMass 1 : Complex) * core xi) *
            (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
              𝓕 (f : Euclidean 2 → Complex) xi))) = qminus + qplus + qmiddle := by
    funext xi
    change _ = qminus xi + qplus xi + qmiddle xi
    dsimp only [qminus, qplus, qmiddle, core]
    rw [← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus,
      ← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus]
    ring
  change 𝓕⁻ (fun xi : Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) *
      (((surfaceMass 1 : Complex) * core xi) *
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : Euclidean 2 → Complex) xi))) x = _
  calc
    _ = 𝓕⁻ (qminus + qplus + qmiddle) x :=
      congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x) hsymbol
    _ = 𝓕⁻ qminus x + 𝓕⁻ qplus x + 𝓕⁻ qmiddle x := by
      rw [aux_fourierInv_add_of_integrable (qminus + qplus) qmiddle
        (hqminus.add hqplus) hqmiddle,
        aux_fourierInv_add_of_integrable qminus qplus hqminus hqplus]
    _ = _ := by
      rw [circleEndpointWaveContribution_factorization,
        circleEndpointWaveContribution_factorization]
      rfl

/-- A direct short-time `L²` circular-maximal estimate for a smooth dyadic
bandpass.  The theorem is the already formalized radius-Sobolev consequence
of `circleStationaryPhase`; it is recorded here under the Bourgain namespace
because it is the low-level high-frequency input preceding local smoothing. -/
theorem circleBandpassShortIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2) :
    ∃ C0 C1 : Real, 0 < C0 ∧ 0 < C1 ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / dyadicScale j ^ ((1 : Real) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            (4 * C1 * dyadicScale j ^ ((1 : Real) / 2)) ^ 2) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  exact sphericalIntervalMaximalRaw_memLp_two_of_hasCircleSurfaceFourierSharpBounds
    circleStationaryPhase phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
    hab hinterval

/-- At the reciprocal frequency time scale, the sharp circle Fourier bounds
give the `2^{-j}` square-moment gain for one localized radius interval.  This
is the proved `L²` annular bridge that precedes the unavailable all-`p`
circle-wave/Mikhlin step in the blueprint. -/
theorem circleBandpassReciprocalIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2)
    (hlength : b - a ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases circleBandpassShortIntervalL2 phi f psi hphi_one hphi_zero hphi_norm j
    hpsi hpsi_compact hab hinterval with ⟨C0, C1, hC0, hC1, hmem, hbound⟩
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  refine ⟨8 * C0 ^ 2 + 32 * C1 ^ 2, by positivity, hmem, hbound.trans ?_⟩
  apply mul_le_mul_of_nonneg_right
    (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
      (dyadicScale_pos j) hRone (sub_nonneg.mpr hab) hlength)
  exact integral_nonneg fun _ => sq_nonneg _

/-- Assemble the sharp circle short-interval estimate over an arbitrary
finite cover of the unit radius block at reciprocal dyadic scale.  This is
the exact finite-cover step behind the observation that `O(2^j)` intervals
of length `2^{-j}` cancel the `2^{-j}` local `L²` factor. -/
theorem circleBandpassUnitIntervalL2_of_finiteCover
    {ι : Type*} (hcircle : HasCircleSurfaceFourierSharpBounds)
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → Real)
    (hcover : Icc (1 : Real) 2 ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Icc (1 : Real) 2)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength : ∀ i ∈ s, b i - a i ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases hcircle with ⟨C0, C1, hC0, hC1, hdecay, hderiv⟩
  let B : Real := 8 * C0 ^ 2 + 32 * C1 ^ 2
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  have hRpos : 0 < dyadicScale j := dyadicScale_pos j
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
    intro i hi
    rcases sphericalIntervalMaximalRaw_memLp_two_of_circle_sharp
      C0 C1 hC0 hC1 hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm j
      hpsi hpsi_compact (hab i hi) (hinterval i hi) with ⟨hmem, hbound⟩
    refine ⟨hmem, hbound.trans ?_⟩
    apply mul_le_mul_of_nonneg_right
      (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
        hRpos hRone (sub_nonneg.mpr (hab i hi)) (hlength i hi))
    exact integral_nonneg fun _ => sq_nonneg _
  obtain ⟨hmem, hbound⟩ :=
    unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
      (d := 2) (by norm_num) (Icc (1 : Real) 2) psi s hs a b hcover
      (by
        intro r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one hr.1) (by
        intro i hi r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one (hinterval i hi hr).1) hab f hlocal
  exact ⟨B, hB, hmem, hbound⟩

/-- The reciprocal-scale dyadic grid on `[1,2]` has bounded total
short-interval `L²` cost.  This packages the preceding finite-cover theorem
with the elementary grid, including the two clipped boundary cells. -/
theorem circleBandpassUnitIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        B * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  let s : Finset Int :=
    Auto.FractalDimensions.dyadicIndexRange j
  let a : Int → Real := fun k =>
    max 1 (Auto.FractalDimensions.dyadicLeft j k)
  let b : Int → Real := fun k =>
    min 2 (Auto.FractalDimensions.dyadicRight j k)
  have hdelta_pos : 0 < Auto.FractalDimensions.dyadicScale j :=
    Auto.FractalDimensions.dyadicScale_pos j
  have hscale_eq :
      Auto.FractalDimensions.dyadicScale j =
        (dyadicScale j)⁻¹ := by
    simp [Auto.FractalDimensions.dyadicScale,
      Auto.FractalDimensions.dyadicDenom, dyadicScale,
      Nat.cast_pow]
  have hs : s.Nonempty := by
    refine ⟨0, ?_⟩
    change (0 : Int) ∈ Auto.FractalDimensions.dyadicIndexRange j
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc]
    omega
  have hcover : Icc (1 : Real) 2 ⊆ ⋃ k ∈ s, Icc (a k) (b k) := by
    intro r hr
    rcases Set.mem_iUnion.mp
      (Auto.FractalDimensions.dyadicIndexRange_covers_Icc j hr)
      with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hks, hrk⟩
    refine Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨hks, ?_⟩⟩
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤ r ∧
      r ≤ min 2 (Auto.FractalDimensions.dyadicRight j k)
    exact ⟨max_le hr.1 hrk.1, le_min hr.2 hrk.2⟩
  have hinterval : ∀ k ∈ s, Icc (a k) (b k) ⊆ Icc (1 : Real) 2 := by
    intro k hk r hr
    exact ⟨(le_max_left _ _).trans hr.1, hr.2.trans (min_le_left _ _)⟩
  have hab : ∀ k ∈ s, a k ≤ b k := by
    intro k hk
    have hkrange : k ∈ Auto.FractalDimensions.dyadicIndexRange j := hk
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc] at hkrange
    have hkplus : 0 ≤ ((k + 1 : Int) : Real) := by
      exact_mod_cast (show 0 ≤ k + 1 by omega)
    have hkupper : (k : Real) ≤
        (Auto.FractalDimensions.dyadicDenom j : Real) := by
      exact_mod_cast hkrange.2
    have hright_one : 1 ≤
        Auto.FractalDimensions.dyadicRight j k := by
      rw [Auto.FractalDimensions.dyadicRight]
      nlinarith [mul_nonneg hkplus hdelta_pos.le]
    have hleft_two : Auto.FractalDimensions.dyadicLeft j k ≤ 2 := by
      have hmul : (k : Real) *
          Auto.FractalDimensions.dyadicScale j ≤
          (Auto.FractalDimensions.dyadicDenom j : Real) *
            Auto.FractalDimensions.dyadicScale j :=
        mul_le_mul_of_nonneg_right hkupper hdelta_pos.le
      rw [Auto.FractalDimensions.dyadicLeft]
      calc
        1 + (k : Real) *
            Auto.FractalDimensions.dyadicScale j ≤
            1 + (Auto.FractalDimensions.dyadicDenom j : Real) *
              Auto.FractalDimensions.dyadicScale j := by linarith
        _ = 2 := by
          rw [mul_comm,
            Auto.FractalDimensions.dyadicScale_mul_denom]
          norm_num
    have hleft_right : Auto.FractalDimensions.dyadicLeft j k ≤
        Auto.FractalDimensions.dyadicRight j k := by
      have hsub :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      linarith
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
      min 2 (Auto.FractalDimensions.dyadicRight j k)
    apply max_le
    · exact le_min (by norm_num) hright_one
    · exact le_min hleft_two hleft_right
  have hlength : ∀ k ∈ s, b k - a k ≤ (dyadicScale j)⁻¹ := by
    intro k hk
    change min 2 (Auto.FractalDimensions.dyadicRight j k) -
        max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          (dyadicScale j)⁻¹
    calc
      min 2 (Auto.FractalDimensions.dyadicRight j k) -
          max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          Auto.FractalDimensions.dyadicRight j k -
            Auto.FractalDimensions.dyadicLeft j k :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = Auto.FractalDimensions.dyadicScale j :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      _ = _ := hscale_eq
  obtain ⟨B, hB, hmem, hbound⟩ :=
    circleBandpassUnitIntervalL2_of_finiteCover circleStationaryPhase
      phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
      s hs a b hcover hinterval hab hlength
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hRinv : (dyadicScale j)⁻¹ ≤ 1 := by
    have h := one_div_le_one_div_of_le zero_lt_one hRone
    simpa [one_div] using h
  have hcard : (s.card : Real) * (dyadicScale j) ^ (-1 : Real) ≤ 3 := by
    rw [Real.rpow_neg_one]
    change ((Auto.FractalDimensions.dyadicIndexRange j).card : Real) *
        (dyadicScale j)⁻¹ ≤ 3
    rw [Auto.FractalDimensions.card_dyadicIndexRange]
    have hdenom : (Auto.FractalDimensions.dyadicDenom j : Real) =
        dyadicScale j := by
      simp [Auto.FractalDimensions.dyadicDenom, dyadicScale,
        Nat.cast_pow]
    rw [Nat.cast_add, Nat.cast_ofNat, hdenom]
    calc
      (dyadicScale j + 2) * (dyadicScale j)⁻¹ =
          1 + 2 * (dyadicScale j)⁻¹ := by
        rw [add_mul, mul_inv_cancel₀ (ne_of_gt (dyadicScale_pos j))]
      _ ≤ 1 + 2 * 1 := by gcongr
      _ = 3 := by norm_num
  refine ⟨3 * B, by positivity, hmem, hbound.trans ?_⟩
  have hI : 0 ≤ ∫ x : ℝ^2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
        ∫ x : ℝ^2, ‖f x‖ ^ 2 =
        ((s.card : Real) * (dyadicScale j) ^ (-1 : Real)) *
          (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) := by ring
    _ ≤ 3 * (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg hB.le hI)
    _ = (3 * B) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by ring

/-- The unit-radius dyadic circle estimate in `eLpNorm` form.  This merely
converts the already proved real square-moment estimate, retaining its
scale-uniform constant; it does not assert the geometric decay missing from
the Bourgain argument. -/
theorem aux_circleBandpassUnitIntervalL2_eLpNorm
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      eLpNorm (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
          2 volume ≤
        (ENNReal.ofReal B) ^ ((2 : Real)⁻¹) *
          eLpNorm (f : ℝ^2 → Complex) 2 volume := by
  obtain ⟨B, hB, hmem, hbound⟩ :=
    circleBandpassUnitIntervalL2 phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
  let U : Euclidean 2 → Real :=
    unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f
  have hUnonneg (x : Euclidean 2) : 0 ≤ U x := by
    exact unnormalizedFractalDyadicBandpassMaximal_nonneg (Icc (1 : Real) 2) psi f x
  refine ⟨B, hB, ?_⟩
  have hUmem : MemLp U 2 volume := by
    simpa only [U] using hmem
  have hfmem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  have hUeq :
      eLpNorm U 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hUmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hfeq :
      eLpNorm (f : Euclidean 2 → Complex) 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hIu : 0 ≤ ∫ x : Euclidean 2, ‖U x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hIf : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  have hroot :
      (∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
        B ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) := by
    calc
      (∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
          (B * ∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) :=
        Real.rpow_le_rpow hIu hbound (by positivity)
      _ = B ^ ((2 : Real)⁻¹) *
          (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹) :=
        Real.mul_rpow hB.le hIf
  rw [hUeq, hfeq]
  calc
    ENNReal.ofReal ((∫ x : Euclidean 2, ‖U x‖ ^ 2) ^ ((2 : Real)⁻¹)) ≤
        ENNReal.ofReal
          (B ^ ((2 : Real)⁻¹) *
            (∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) :=
      ENNReal.ofReal_le_ofReal hroot
    _ = ENNReal.ofReal B ^ ((2 : Real)⁻¹) *
          ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
      rw [ENNReal.ofReal_mul (Real.rpow_nonneg hB.le _),
        ← ENNReal.ofReal_rpow_of_nonneg hB.le (by positivity)]


