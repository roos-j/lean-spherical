    Continuous (spaceTimeFourierInv (jointSchwartzRaw P)) := by
  have heq : spaceTimeFourierInv (jointSchwartzRaw P) =
      fun o : WaveSpaceTime => (𝓕⁻ P : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 o) :=
        by
    funext o
