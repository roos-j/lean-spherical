    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ (A / dyadicScale j) ^ 2 * E := by
    simpa only [F, E] using hfixed j t ht.1 ht.2 f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
        ∫ _t in (1 : Real)..2, (A / dyadicScale j) ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const
          hpoint
    _ = (A / dyadicScale j) ^ 2 * E := by norm_num

private theorem aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal (‖circleMiddleWaveContribution C j t.1 f x‖ ^ 2)) ≤
          ENNReal.ofReal
            (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
              ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨A, hA, hFbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContribution_le_dyInverse C
  obtain ⟨B, hB, hDbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContributionTimeDeriv_le C
  let M : Real := 4 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleMiddleWaveContributionTimeDerivative C j t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      aux_integrable_norm_sq_circleMiddleWaveContribution_prod C j f
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      aux_integrable_norm_sq_circleMiddleWaveContributionTimeDerivative_prod C j f
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated j
  obtain ⟨hmeas, hsampling⟩ :=
    measurable_and_lintegral_iSup_ennreal_norm_sq_le_timeSamplingL2
      (F := F) (F' := D) j T hT hFcont hDcont hderiv hFprod hDprod
  refine ⟨?_, hsampling.trans ?_⟩
  · simpa only [F] using hmeas
  · apply ENNReal.ofReal_le_ofReal
    have hF :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
      simpa only [F, E] using hFbound j f
    have hD :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          B ^ 2 * E := by
      simpa only [D, E] using hDbound j f
    let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
    let R : Real := dyadicScale j
    have hR : 0 < R := by
      dsimp only [R]
      exact dyadicScale_pos j
    have hδ : δ = R⁻¹ := by
      dsimp only [δ, R]
      simp [_root_.Auto.Spherical.MSS.dyadicTimeScale, dyadicScale, zpow_neg]
    have hδnonneg : 0 ≤ δ := by
      rw [hδ]
      exact inv_nonneg.mpr hR.le
    have hδinvnonneg : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδnonneg
    have hsamplebound :
        8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
          6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := by
      apply add_le_add
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hF)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 8) hδinvnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
      · have h := mul_le_mul_of_nonneg_left
          (by simpa only [R] using hD)
          (mul_nonneg (by norm_num : (0 : Real) ≤ 6) hδnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
    have hformula :
        8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) =
          ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := by
      rw [hδ]
      field_simp [hR.ne']
    have hcoeff : 8 * A ^ 2 + 6 * B ^ 2 ≤ M ^ 2 := by
      dsimp only [M]
      nlinarith [sq_nonneg A, sq_nonneg B, mul_nonneg hA.le hB.le]
    have hfinal : ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤
        M ^ 2 * δ * E := by
      rw [hδ]
      calc
        ((8 * A ^ 2 + 6 * B ^ 2) / R) * E ≤ (M ^ 2 / R) * E := by
          exact mul_le_mul_of_nonneg_right
            (div_le_div_of_nonneg_right hcoeff hR.le) hE
        _ = M ^ 2 * R⁻¹ * E := by ring
    calc
      8 * (_root_.Auto.Spherical.MSS.dyadicTimeScale j)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
        6 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
          8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
            6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) := by rfl
      _ ≤ 8 * δ⁻¹ * ((A / R) ^ 2 * E) + 6 * δ * (B ^ 2 * E) := hsamplebound
      _ = ((8 * A ^ 2 + 6 * B ^ 2) / R) * E := hformula
      _ ≤ M ^ 2 * δ * E := hfinal
      _ = M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by rfl

/-- Dyadic-time sampling preserves a half-power of the nonstationary middle
gain: the continuous-time middle maximum has square energy `O(2⁻ʲ)`. -/
theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circMidWvContribution_le_dyGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
            ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_measurable_lintegral_iSup_circleMiddleWaveContribution_le_dyadicGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleMiddleWaveContribution C j t f x
  let Q : Euclidean 2 → ENNReal := fun x =>
    ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal (‖F t.1 x‖ ^ 2)
  let K : Real := M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
    ∫ x : Euclidean 2, ‖f x‖ ^ 2
  obtain ⟨hQmeas, hQbound⟩ := hbound j f
  have hQmeas' : Measurable Q := by
    simpa only [F, Q] using hQmeas
  have hQbound' : (∫⁻ x : Euclidean 2, Q x) ≤ ENNReal.ofReal K := by
    simpa only [F, Q, K] using hQbound
  have hK : 0 ≤ K := by
    dsimp only [K]
    exact mul_nonneg (mul_nonneg (sq_nonneg _) (by
      dsimp only [_root_.Auto.Spherical.MSS.dyadicTimeScale]
      exact zpow_nonneg (by norm_num) _))
      (integral_nonneg fun _ => sq_nonneg _)
  have hsq :=
    _root_.Auto.Spherical.SphericalMaximalL2.memLp_two_toReal_sqrt_of_measurable_lintegral
      Q hQmeas' hK hQbound'
  have hjoint := aux_continuous_and_hasDerivAt_circleMiddleWaveContribution C j f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hordinary :=
    SphericalMaximalL2.memLp_two_iSup_ennreal_norm_of_memLp_sqrt_iSup_ennreal_norm_sq
      (F := F) (a := (1 : Real)) (b := 2) (by norm_num) hFcont hsq.1 hsq.2
  simpa only [F, K] using hordinary

/-- The literal continuous-time maximal function of the nonstationary middle
wave on one dyadic annulus and the unit time slab.  This contains neither
endpoint contribution, so its summability below is independent of the MSS
local-smoothing input. -/
noncomputable def circleMiddleWaveMaximal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => (⨆ t : Icc (1 : Real) 2,
    ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal

/-- The dyadic middle-wave maximal terms have a literal geometric `L²` rate.
This is just the square-root form of the preceding square-energy estimate;
the ratio is `2⁻¹ᐟ²`. -/
private theorem circleMiddleWaveMaximal_eLpNorm_geometric
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (circleMiddleWaveMaximal C j f) 2 volume ∧
        eLpNorm (circleMiddleWaveMaximal C j f) 2 volume ≤
          (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            eLpNorm (f : Euclidean 2 → Complex) 2 volume := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_memLp_two_and_integral_norm_sq_iSup_circMidWvContribution_le_dyGain C
  refine ⟨M, hM, ?_⟩
  intro j f
  let G : Euclidean 2 → Real := circleMiddleWaveMaximal C j f
  obtain ⟨hGmem, hGbound⟩ := hbound j f
  have hGmem' : MemLp G 2 volume := by
    change MemLp (fun x : Euclidean 2 =>
      (⨆ t : Icc (1 : Real) 2,
        ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume
    exact hGmem
  have hfmem : MemLp (f : Euclidean 2 → Complex) 2 volume := f.memLp 2 volume
  have hGeq :
      eLpNorm G 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hGmem'.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  have hfeq :
      eLpNorm (f : Euclidean 2 → Complex) 2 volume =
        ENNReal.ofReal ((∫ x : Euclidean 2, ‖f x‖ ^ 2) ^ ((2 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)]
    norm_num
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hGint : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ≤
      M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E := by
    change (∫ x : Euclidean 2, ‖(⨆ t : Icc (1 : Real) 2,
      ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2
    exact hGbound
  have hbudget :
      (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) =
        (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    rw [show _root_.Auto.Spherical.MSS.dyadicTimeScale j = (1 / 2 : Real) ^ j by
      rw [dyadicTimeScale_eq_inv_natPow]
      rw [show (1 / 2 : Real) = (2 : Real)⁻¹ by norm_num, inv_pow]
      norm_num [Nat.cast_pow]]
    have hrho : 0 ≤ Real.sqrt (1 / 2 : Real) := Real.sqrt_nonneg _
    have hsquare : (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 =
        M ^ 2 * (1 / 2 : Real) ^ j := by
      rw [mul_pow, show (Real.sqrt (1 / 2 : Real) ^ j) ^ 2 =
        (1 / 2 : Real) ^ j by
          rw [← pow_mul, Nat.mul_comm, pow_mul, Real.sq_sqrt (by norm_num)]]
    rw [← hsquare]
    rw [show (M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2 * E =
      ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) * E by ring]
    rw [Real.mul_rpow (sq_nonneg _) hE]
    have hpow : ((M * (Real.sqrt (1 / 2 : Real)) ^ j) ^ 2) ^ ((2 : Real)⁻¹) =
        M * (Real.sqrt (1 / 2 : Real)) ^ j := by
      rw [show (2 : Real)⁻¹ = 1 / 2 by norm_num, ← Real.sqrt_eq_rpow]
      rw [Real.sqrt_sq_eq_abs]
      rw [abs_of_nonneg (mul_nonneg hM.le (pow_nonneg hrho _))]
    rw [hpow]
  have hroot : (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
      (M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹) := by
    calc
      (∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹) ≤
          (M ^ 2 * _root_.Auto.Spherical.MSS.dyadicTimeScale j * E) ^ ((2 : Real)⁻¹) :=
        Real.rpow_le_rpow (integral_nonneg fun _ => sq_nonneg _) hGint (by positivity)
      _ = _ := hbudget
  rw [hGeq, hfeq]
  refine ⟨?_, ?_⟩
  · simpa only [G] using hGmem'
  · calc
      ENNReal.ofReal ((∫ x : Euclidean 2, ‖G x‖ ^ 2) ^ ((2 : Real)⁻¹)) ≤
          ENNReal.ofReal ((M * (Real.sqrt (1 / 2 : Real)) ^ j) * E ^ ((2 : Real)⁻¹)) :=
        ENNReal.ofReal_le_ofReal hroot
      _ = (ENNReal.ofReal M * (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ^ j) *
            ENNReal.ofReal (E ^ ((2 : Real)⁻¹)) := by
        rw [ENNReal.ofReal_mul (mul_nonneg hM.le (pow_nonneg (Real.sqrt_nonneg _) _)),
          ENNReal.ofReal_mul hM.le,
          ENNReal.ofReal_pow (Real.sqrt_nonneg _)]

/-- The literal middle-wave maxima are summable over every finite collection
of dyadic annuli in `L²`.  The theorem is a concrete assembly for the
nonstationary term alone and makes no endpoint or local-smoothing assertion. -/
theorem exists_memLp_two_and_eLpNorm_sum_circleMiddleWaveMaximal_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 ∧
      ∀ (N : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (fun x : Euclidean 2 =>
          ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ∧
          eLpNorm (fun x : Euclidean 2 =>
            ∑ j ∈ Finset.range N, circleMiddleWaveMaximal C j f x) 2 volume ≤
            (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
              (1 - ENNReal.ofReal (Real.sqrt (1 / 2 : Real)))⁻¹ := by
  obtain ⟨M, hM, hpiece⟩ := circleMiddleWaveMaximal_eLpNorm_geometric C
  have hrho_real : Real.sqrt (1 / 2 : Real) < 1 := by
    rw [Real.sqrt_lt' (by norm_num)]
    norm_num
  have hrho : ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) < 1 := by
    rw [ENNReal.ofReal_lt_one]
    exact hrho_real
  refine ⟨M, hM, hrho, ?_⟩
  intro N f
  let T : Nat → Euclidean 2 → Real := fun j => circleMiddleWaveMaximal C j f
  have hTmem (j : Nat) : MemLp (T j) 2 volume := by
    dsimp only [T]
    exact (hpiece j f).1
  have hTmeas (j : Nat) : AEStronglyMeasurable (T j) volume := (hTmem j).1
  have hsum_mem : MemLp (fun x : Euclidean 2 => ∑ j ∈ Finset.range N, T j x)
      2 volume := by
    induction N with
    | zero => simp
    | succ n ih =>
        have hadd := ih.add (hTmem n)
        convert hadd using 1
        funext x
        simp only [Finset.sum_range_succ, Pi.add_apply]
  refine ⟨?_, ?_⟩
  · simpa only [T] using hsum_mem
  · have hsum := Auto.Spherical.Auxiliary.eLpNorm_sum_range_le_geometric
      volume 2 (by norm_num) T hTmeas
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume)
        (ENNReal.ofReal (Real.sqrt (1 / 2 : Real))) ?_ N
    · simpa only [T] using hsum
    · intro j
      have h := hpiece j f
      change eLpNorm (T j) 2 volume ≤
        (ENNReal.ofReal M * eLpNorm (f : Euclidean 2 → Complex) 2 volume) *
          ENNReal.ofReal (Real.sqrt (1 / 2 : Real)) ^ j
      simpa only [T, mul_assoc, mul_left_comm, mul_comm] using h.2

theorem aux_exists_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        (⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal) 2 volume ∧
        (∫ x : Euclidean 2,
          ‖(⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨A, hA, hmiddle⟩ :=
    aux_exists_integral_norm_sq_circleMiddleWaveContribution_le_dyadicInverse C
  obtain ⟨B, hB, hderiv⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circleMiddleWaveContributionTimeDeriv_le C
  let M : Real := 2 * (A + B)
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j f
  obtain ⟨hmaxmem, hmaxsob⟩ :=
    aux_memLp_two_and_integral_norm_sq_iSup_circleMiddleWaveContribution_le_timeSobolev C j f
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hscale_pos : 0 < dyadicScale j := dyadicScale_pos j
  have hscale_one : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hratio_nonneg : 0 ≤ A / dyadicScale j :=
    div_nonneg hA.le hscale_pos.le
  have hratio_le : A / dyadicScale j ≤ A := by
    rw [div_le_iff₀ hscale_pos]
    exact le_mul_of_one_le_right hA.le hscale_one
  have hratio_sq : (A / dyadicScale j) ^ 2 ≤ A ^ 2 := by
    nlinarith [mul_self_le_mul_self hratio_nonneg hratio_le]
  have hinitial :
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤ A ^ 2 * E := by
    calc
      (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) ≤
          (A / dyadicScale j) ^ 2 * E := by
            simpa only [E] using hmiddle j 1 (by norm_num) (by norm_num) f
      _ ≤ A ^ 2 * E := mul_le_mul_of_nonneg_right hratio_sq hE
  have hderivative :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2) ≤ B ^ 2 * E := by
    simpa only [E] using hderiv j f
  have hmaxenergy :
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
        (2 * A ^ 2 + 2 * B ^ 2) * E := by
    calc
      (∫ x : Euclidean 2,
        ‖(⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal ‖circleMiddleWaveContribution C j t.1 f x‖).toReal‖ ^ 2) ≤
          2 * (∫ x : Euclidean 2, ‖circleMiddleWaveContribution C j 1 f x‖ ^ 2) +
            2 * ((2 : Real) - 1) *
              ∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
                ‖aux_circleMiddleWaveContributionTimeDerivative C j t f x‖ ^ 2 := hmaxsob
      _ ≤ 2 * (A ^ 2 * E) + 2 * (B ^ 2 * E) := by
        norm_num
        exact add_le_add
          (mul_le_mul_of_nonneg_left hinitial (by norm_num))
          (mul_le_mul_of_nonneg_left hderivative (by norm_num))
      _ = (2 * A ^ 2 + 2 * B ^ 2) * E := by ring
  have hAB : 0 ≤ A * B := mul_nonneg hA.le hB.le
  have hcoeff : 2 * A ^ 2 + 2 * B ^ 2 ≤ M ^ 2 := by
    dsimp only [M]
    nlinarith [sq_nonneg (A - B)]
  refine ⟨hmaxmem, ?_⟩
  exact hmaxenergy.trans (mul_le_mul_of_nonneg_right hcoeff hE)

theorem aux_fourierInv_add_of_integrable
    (g h : Euclidean 2 → Complex) (hg : Integrable g) (hh : Integrable h)
    (x : Euclidean 2) :
    𝓕⁻ (g + h) x = 𝓕⁻ g x + 𝓕⁻ h x := by
  have hgchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • g xi) := by
    refine Integrable.mono' hg.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hg.aestronglyMeasurable
    · filter_upwards with xi
      simp
  have hhchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • h xi) := by
    refine Integrable.mono' hh.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hh.aestronglyMeasurable
    · filter_upwards with xi
      simp
  rw [Real.fourierInv_eq, Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ v : Euclidean 2,
      Real.fourierChar (inner Real v x) • (g v + h v)) = _
  rw [show (fun v : Euclidean 2 =>
      Real.fourierChar (inner Real v x) • (g v + h v)) =
        (fun v : Euclidean 2 =>
          Real.fourierChar (inner Real v x) • g v +
            Real.fourierChar (inner Real v x) • h v) by
      funext v
      rw [smul_add], MeasureTheory.integral_add hgchar hhchar]

theorem aux_const_mul_fourierInv
    (a : Complex) (g : Euclidean 2 → Complex) (x : Euclidean 2) :
    a * 𝓕⁻ g x = 𝓕⁻ (fun xi => a * g xi) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with xi
  change a * (Real.fourierChar (inner Real xi x) • g xi) =
    Real.fourierChar (inner Real xi x) • (a * g xi)
  rw [show a * (Real.fourierChar (inner Real xi x) • g xi) =
      (Real.fourierChar (inner Real xi x) : Complex) * (a * g xi) by
        change a * ((Real.fourierChar (inner Real xi x) : Complex) * g xi) = _
        ring]
  rfl

theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t xi =
      Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSS.halfWaveMultiplier,
    _root_.Auto.Spherical.MSS.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring

theorem aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus
    (t : Real) (xi : Euclidean 2) :
    circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t xi =
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) := by
  simp only [circleEndpointAmplitude,
    _root_.Auto.Spherical.MSS.halfWaveMultiplier,
    _root_.Auto.Spherical.MSS.WaveSign.toReal]
  rw [mul_comm]
  congr 1
  push_cast
  ring

/-- Exact three-wave decomposition of a dyadic circular average.  The two
endpoint terms are factored through the MSS dyadic half-waves, while the
middle term remains its literal compact frequency-localized Fourier integral. -/
theorem circleDyadicBandpassThreeWaveDecomposition
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) {t : Real} (ht : 0 ≤ t)
    (x : Euclidean 2) :
    circularAverage t
        (dyadicBandpassProjection
          (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f :
          Euclidean 2 → Complex) x =
      circleEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.minus j t f x +
        circleEndpointWaveContribution C _root_.Auto.Spherical.MSS.WaveSign.plus j t f x +
          circleMiddleWaveContribution C j t f x := by
  let qminus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qplus : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
        (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t xi *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qmiddle : Euclidean 2 → Complex := fun xi =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖)) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  have hqminus : Integrable qminus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t))
  have hqplus : Integrable qplus := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact (((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus t)).mul
      (aux_continuous_halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t))
  have hqmiddle : Integrable qmiddle := by
    apply aux_integrable_continuous_mul_dyadicBandpass_fourier C j
    exact ((continuous_const.mul continuous_const).mul
      (aux_continuous_coordinateMiddleMeridianLocalizedIntegral_zero.comp (by fun_prop)))
  rw [circleBandpassFourierCoordinateWaveNormalForm
    (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j) f ht x]
  rw [aux_const_mul_fourierInv]
  let core : Euclidean 2 → Complex := fun xi =>
    Complex.exp (((-(2 * Real.pi * (t * ‖xi‖)) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (2 * Real.pi * (t * ‖xi‖)) +
      Complex.exp (((2 * Real.pi * (t * ‖xi‖) : Real) : Complex) * Complex.I) *
        Auto.Spherical.OscillatoryIntegralAux.planarEndpointQuadraticIntegral
          (-(2 * Real.pi * (t * ‖xi‖))) +
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t * ‖xi‖))
  have hsymbol :
      (fun xi : Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) *
          (((surfaceMass 1 : Complex) * core xi) *
            (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
              𝓕 (f : Euclidean 2 → Complex) xi))) = qminus + qplus + qmiddle := by
    funext xi
    change _ = qminus xi + qplus xi + qmiddle xi
    dsimp only [qminus, qplus, qmiddle, core]
    rw [← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus,
      ← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus]
    ring
  change 𝓕⁻ (fun xi : Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) *
      (((surfaceMass 1 : Complex) * core xi) *
        (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
          𝓕 (f : Euclidean 2 → Complex) xi))) x = _
  calc
    _ = 𝓕⁻ (qminus + qplus + qmiddle) x :=
      congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x) hsymbol
    _ = 𝓕⁻ qminus x + 𝓕⁻ qplus x + 𝓕⁻ qmiddle x := by
      rw [aux_fourierInv_add_of_integrable (qminus + qplus) qmiddle
        (hqminus.add hqplus) hqmiddle,
        aux_fourierInv_add_of_integrable qminus qplus hqminus hqplus]
    _ = _ := by
      rw [circleEndpointWaveContribution_factorization,
        circleEndpointWaveContribution_factorization]
      rfl

/-- A direct short-time `L²` circular-maximal estimate for a smooth dyadic
bandpass.  The theorem is the already formalized radius-Sobolev consequence
of `circleStationaryPhase`; it is recorded here under the Bourgain namespace
because it is the low-level high-frequency input preceding local smoothing. -/
theorem circleBandpassShortIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2) :
    ∃ C0 C1 : Real, 0 < C0 ∧ 0 < C1 ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (2 * ((2 * C0) / dyadicScale j ^ ((1 : Real) / 2)) ^ 2 +
          2 * (b - a) ^ 2 *
            (4 * C1 * dyadicScale j ^ ((1 : Real) / 2)) ^ 2) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  exact sphericalIntervalMaximalRaw_memLp_two_of_hasCircleSurfaceFourierSharpBounds
    circleStationaryPhase phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
    hab hinterval

/-- At the reciprocal frequency time scale, the sharp circle Fourier bounds
give the `2^{-j}` square-moment gain for one localized radius interval.  This
is the proved `L²` annular bridge that precedes the unavailable all-`p`
circle-wave/Mikhlin step in the blueprint. -/
theorem circleBandpassReciprocalIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    {a b : Real} (hab : a ≤ b) (hinterval : Icc a b ⊆ Icc (1 : Real) 2)
    (hlength : b - a ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f))
        2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw a b (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases circleBandpassShortIntervalL2 phi f psi hphi_one hphi_zero hphi_norm j
    hpsi hpsi_compact hab hinterval with ⟨C0, C1, hC0, hC1, hmem, hbound⟩
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  refine ⟨8 * C0 ^ 2 + 32 * C1 ^ 2, by positivity, hmem, hbound.trans ?_⟩
  apply mul_le_mul_of_nonneg_right
    (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
      (dyadicScale_pos j) hRone (sub_nonneg.mpr hab) hlength)
  exact integral_nonneg fun _ => sq_nonneg _

/-- Assemble the sharp circle short-interval estimate over an arbitrary
finite cover of the unit radius block at reciprocal dyadic scale.  This is
the exact finite-cover step behind the observation that `O(2^j)` intervals
of length `2^{-j}` cancel the `2^{-j}` local `L²` factor. -/
theorem circleBandpassUnitIntervalL2_of_finiteCover
    {ι : Type*} (hcircle : HasCircleSurfaceFourierSharpBounds)
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex))
    (s : Finset ι) (hs : s.Nonempty) (a b : ι → Real)
    (hcover : Icc (1 : Real) 2 ⊆ ⋃ i ∈ s, Icc (a i) (b i))
    (hinterval : ∀ i ∈ s, Icc (a i) (b i) ⊆ Icc (1 : Real) 2)
    (hab : ∀ i ∈ s, a i ≤ b i)
    (hlength : ∀ i ∈ s, b i - a i ≤ (dyadicScale j)⁻¹) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
          ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  rcases hcircle with ⟨C0, C1, hC0, hC1, hdecay, hderiv⟩
  let B : Real := 8 * C0 ^ 2 + 32 * C1 ^ 2
  have hB : 0 < B := by
    dsimp only [B]
    positivity
  have hRpos : 0 < dyadicScale j := dyadicScale_pos j
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hlocal : ∀ i ∈ s,
      MemLp (sphericalIntervalMaximalRaw (a i) (b i)
        (dyadicBandpassProjection psi f)) 2 volume ∧
      (∫ x : ℝ^2,
        ‖sphericalIntervalMaximalRaw (a i) (b i)
          (dyadicBandpassProjection psi f) x‖ ^ 2) ≤
        (B * (dyadicScale j) ^ (-1 : Real)) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
    intro i hi
    rcases sphericalIntervalMaximalRaw_memLp_two_of_circle_sharp
      C0 C1 hC0 hC1 hdecay hderiv phi f psi hphi_one hphi_zero hphi_norm j
      hpsi hpsi_compact (hab i hi) (hinterval i hi) with ⟨hmem, hbound⟩
    refine ⟨hmem, hbound.trans ?_⟩
    apply mul_le_mul_of_nonneg_right
      (circle_short_interval_l2_coefficient_le_frequency_decay C0 C1 hC0.le hC1.le
        hRpos hRone (sub_nonneg.mpr (hab i hi)) (hlength i hi))
    exact integral_nonneg fun _ => sq_nonneg _
  obtain ⟨hmem, hbound⟩ :=
    unnormalizedFractalDyadicBandpass_memLp_two_of_finite_raw_cover
      (d := 2) (by norm_num) (Icc (1 : Real) 2) psi s hs a b hcover
      (by
        intro r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one hr.1) (by
        intro i hi r hr
        change 0 < r
        exact lt_of_lt_of_le zero_lt_one (hinterval i hi hr).1) hab f hlocal
  exact ⟨B, hB, hmem, hbound⟩

/-- The reciprocal-scale dyadic grid on `[1,2]` has bounded total
short-interval `L²` cost.  This packages the preceding finite-cover theorem
with the elementary grid, including the two clipped boundary cells. -/
theorem circleBandpassUnitIntervalL2
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      MemLp (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
        2 volume ∧
      (∫ x : ℝ^2,
        ‖unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f x‖ ^ 2) ≤
        B * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by
  let s : Finset Int :=
    Auto.FractalDimensions.dyadicIndexRange j
  let a : Int → Real := fun k =>
    max 1 (Auto.FractalDimensions.dyadicLeft j k)
  let b : Int → Real := fun k =>
    min 2 (Auto.FractalDimensions.dyadicRight j k)
  have hdelta_pos : 0 < Auto.FractalDimensions.dyadicScale j :=
    Auto.FractalDimensions.dyadicScale_pos j
  have hscale_eq :
      Auto.FractalDimensions.dyadicScale j =
        (dyadicScale j)⁻¹ := by
    simp [Auto.FractalDimensions.dyadicScale,
      Auto.FractalDimensions.dyadicDenom, dyadicScale,
      Nat.cast_pow]
  have hs : s.Nonempty := by
    refine ⟨0, ?_⟩
    change (0 : Int) ∈ Auto.FractalDimensions.dyadicIndexRange j
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc]
    omega
  have hcover : Icc (1 : Real) 2 ⊆ ⋃ k ∈ s, Icc (a k) (b k) := by
    intro r hr
    rcases Set.mem_iUnion.mp
      (Auto.FractalDimensions.dyadicIndexRange_covers_Icc j hr)
      with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hks, hrk⟩
    refine Set.mem_iUnion.mpr ⟨k, Set.mem_iUnion.mpr ⟨hks, ?_⟩⟩
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤ r ∧
      r ≤ min 2 (Auto.FractalDimensions.dyadicRight j k)
    exact ⟨max_le hr.1 hrk.1, le_min hr.2 hrk.2⟩
  have hinterval : ∀ k ∈ s, Icc (a k) (b k) ⊆ Icc (1 : Real) 2 := by
    intro k hk r hr
    exact ⟨(le_max_left _ _).trans hr.1, hr.2.trans (min_le_left _ _)⟩
  have hab : ∀ k ∈ s, a k ≤ b k := by
    intro k hk
    have hkrange : k ∈ Auto.FractalDimensions.dyadicIndexRange j := hk
    rw [Auto.FractalDimensions.dyadicIndexRange,
      Finset.mem_Icc] at hkrange
    have hkplus : 0 ≤ ((k + 1 : Int) : Real) := by
      exact_mod_cast (show 0 ≤ k + 1 by omega)
    have hkupper : (k : Real) ≤
        (Auto.FractalDimensions.dyadicDenom j : Real) := by
      exact_mod_cast hkrange.2
    have hright_one : 1 ≤
        Auto.FractalDimensions.dyadicRight j k := by
      rw [Auto.FractalDimensions.dyadicRight]
      nlinarith [mul_nonneg hkplus hdelta_pos.le]
    have hleft_two : Auto.FractalDimensions.dyadicLeft j k ≤ 2 := by
      have hmul : (k : Real) *
          Auto.FractalDimensions.dyadicScale j ≤
          (Auto.FractalDimensions.dyadicDenom j : Real) *
            Auto.FractalDimensions.dyadicScale j :=
        mul_le_mul_of_nonneg_right hkupper hdelta_pos.le
      rw [Auto.FractalDimensions.dyadicLeft]
      calc
        1 + (k : Real) *
            Auto.FractalDimensions.dyadicScale j ≤
            1 + (Auto.FractalDimensions.dyadicDenom j : Real) *
              Auto.FractalDimensions.dyadicScale j := by linarith
        _ = 2 := by
          rw [mul_comm,
            Auto.FractalDimensions.dyadicScale_mul_denom]
          norm_num
    have hleft_right : Auto.FractalDimensions.dyadicLeft j k ≤
        Auto.FractalDimensions.dyadicRight j k := by
      have hsub :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      linarith
    change max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
      min 2 (Auto.FractalDimensions.dyadicRight j k)
    apply max_le
    · exact le_min (by norm_num) hright_one
    · exact le_min hleft_two hleft_right
  have hlength : ∀ k ∈ s, b k - a k ≤ (dyadicScale j)⁻¹ := by
    intro k hk
    change min 2 (Auto.FractalDimensions.dyadicRight j k) -
        max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          (dyadicScale j)⁻¹
    calc
      min 2 (Auto.FractalDimensions.dyadicRight j k) -
          max 1 (Auto.FractalDimensions.dyadicLeft j k) ≤
          Auto.FractalDimensions.dyadicRight j k -
            Auto.FractalDimensions.dyadicLeft j k :=
        sub_le_sub (min_le_right _ _) (le_max_right _ _)
      _ = Auto.FractalDimensions.dyadicScale j :=
        Auto.FractalDimensions.dyadicRight_sub_dyadicLeft j k
      _ = _ := hscale_eq
  obtain ⟨B, hB, hmem, hbound⟩ :=
    circleBandpassUnitIntervalL2_of_finiteCover circleStationaryPhase
      phi f psi hphi_one hphi_zero hphi_norm j hpsi hpsi_compact
      s hs a b hcover hinterval hab hlength
  have hRone : 1 ≤ dyadicScale j := by
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale j := dyadicScale_mono (Nat.zero_le j)
  have hRinv : (dyadicScale j)⁻¹ ≤ 1 := by
    have h := one_div_le_one_div_of_le zero_lt_one hRone
    simpa [one_div] using h
  have hcard : (s.card : Real) * (dyadicScale j) ^ (-1 : Real) ≤ 3 := by
    rw [Real.rpow_neg_one]
    change ((Auto.FractalDimensions.dyadicIndexRange j).card : Real) *
        (dyadicScale j)⁻¹ ≤ 3
    rw [Auto.FractalDimensions.card_dyadicIndexRange]
    have hdenom : (Auto.FractalDimensions.dyadicDenom j : Real) =
        dyadicScale j := by
      simp [Auto.FractalDimensions.dyadicDenom, dyadicScale,
        Nat.cast_pow]
    rw [Nat.cast_add, Nat.cast_ofNat, hdenom]
    calc
      (dyadicScale j + 2) * (dyadicScale j)⁻¹ =
          1 + 2 * (dyadicScale j)⁻¹ := by
        rw [add_mul, mul_inv_cancel₀ (ne_of_gt (dyadicScale_pos j))]
      _ ≤ 1 + 2 * 1 := by gcongr
      _ = 3 := by norm_num
  refine ⟨3 * B, by positivity, hmem, hbound.trans ?_⟩
  have hI : 0 ≤ ∫ x : ℝ^2, ‖f x‖ ^ 2 :=
    integral_nonneg fun _ => sq_nonneg _
  calc
    (s.card : Real) * (B * (dyadicScale j) ^ (-1 : Real)) *
        ∫ x : ℝ^2, ‖f x‖ ^ 2 =
        ((s.card : Real) * (dyadicScale j) ^ (-1 : Real)) *
          (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) := by ring
    _ ≤ 3 * (B * ∫ x : ℝ^2, ‖f x‖ ^ 2) :=
      mul_le_mul_of_nonneg_right hcard (mul_nonneg hB.le hI)
    _ = (3 * B) * ∫ x : ℝ^2, ‖f x‖ ^ 2 := by ring

/-- The unit-radius dyadic circle estimate in `eLpNorm` form.  This merely
converts the already proved real square-moment estimate, retaining its
scale-uniform constant; it does not assert the geometric decay missing from
the Bourgain argument. -/
theorem aux_circleBandpassUnitIntervalL2_eLpNorm
    (phi f psi : SchwartzMap (ℝ^2) Complex)
    (hphi_one : ∀ xi, ‖xi‖ ≤ 1 → phi xi = 1)
    (hphi_zero : ∀ xi, 2 ≤ ‖xi‖ → phi xi = 0)
    (hphi_norm : ∀ xi, ‖phi xi‖ ≤ 1) (j : Nat)
    (hpsi : ∀ xi : ℝ^2,
      psi xi = phi (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        phi (((2 : Real) ^ j)⁻¹ • xi))
    (hpsi_compact : HasCompactSupport (psi : ℝ^2 → Complex)) :
    ∃ B : Real, 0 < B ∧
      eLpNorm (unnormalizedFractalDyadicBandpassMaximal 2 (Icc (1 : Real) 2) psi f)
          2 volume ≤
        (ENNReal.ofReal B) ^ ((2 : Real)⁻¹) *
