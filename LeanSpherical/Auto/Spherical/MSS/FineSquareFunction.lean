      ((D.spatialProfile scale n nu).contDiffAt (⊤ : ℕ∞)) |>.mul
        (halfWaveMultiplier_contDiffAt_of_ne_zero WaveSign.plus z.2 hxi)

/-- Compactness of the literal fine-cube multiplier is inherited from the
