    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
      exact regularity.energyWeighted hscale piece.1 hmem.1 piece.2 hmem.2 cube hcube)
    (by
      intro piece hpiece cube hcube
      have hmem := hpieceMem piece hpiece
