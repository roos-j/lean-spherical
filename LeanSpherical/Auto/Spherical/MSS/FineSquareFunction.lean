        ‖normalizedCircleFinePacketKernel χout χsrc b Γ q m ε δ ρ₀ hδ ζ η o y‖ ≤
      C * δ⁻¹ * δ ^ M := by
  have hs : ∀ z, χout z ≠ 0 → ‖z.1‖ ≤ 3 ∧ |z.2| ≤ 2 := by
