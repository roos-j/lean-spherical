  have hnorm_pos : 0 < ‖xi‖ := by
    nlinarith
  have hxi0 : xi ≠ 0 := norm_ne_zero_iff.mp (ne_of_gt hnorm_pos)
  have hrewrite :
      xi - ‖xi‖ • D.directions scale nu =
