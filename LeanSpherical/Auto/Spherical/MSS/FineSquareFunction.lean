  have hray : ∀ (omega y : Euclidean 2),
      Integrable (fun z : WaveSpaceTime =>
        lightRayKernel delta N omega y z * ‖g z‖) continuumLightRayMeasure := by
    intro omega y
    simpa only [delta, continuumLightRayMeasure, scratchLightRayMeasure] using
