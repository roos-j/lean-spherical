  change (∫ ξ : Euclidean 2,
      Real.fourierChar (inner Real ξ x) • (∑ i ∈ s, q i ξ)) = _
  rw [show (fun ξ : Euclidean 2 =>
      Real.fourierChar (inner Real ξ x) • (∑ i ∈ s, q i ξ)) =
        fun ξ => ∑ i ∈ s, Real.fourierChar (inner Real ξ x) • q i ξ by
      funext ξ
