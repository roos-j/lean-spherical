      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) vartheta
        (f : Euclidean 2 → Complex)) volume :=
  (measurable_conicOperator_dyadicBandpass C vartheta hvartheta j f).aestronglyMeasurable

/-- The local `[1,2]` space--time measure is dominated by full Lebesgue
measure, allowing a global conic estimate to control its local restriction. -/
theorem localSmoothingMeasure_le_volume :
    localSmoothingMeasure ≤ (volume : Measure WaveSpaceTime) := by
  rw [localSmoothingMeasure, Measure.volume_eq_prod]
  exact Measure.prod_mono le_rfl Measure.restrict_le_self

/-- The positive dyadic half-wave and the matched conic normal form agree
almost everywhere on the local time slab. -/
theorem ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_eq_dyadicHalfWaveSpaceTime_plus C ϑ j f z (hϑ z.2 hz)

/-- A global conic `L⁴` estimate transfers to the local positive dyadic
half-wave at the matching scale.  The negative orientation is intentionally
not folded into this lemma: it requires its own reflected conic input. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_plus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ t = 1) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.plus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  rw [← eLpNorm_congr_ae
    (ae_eq_conicOperator_dyadicHalfWaveSpaceTime_plus C ϑ j f hϑ)]
  exact eLpNorm_mono_measure _ localSmoothingMeasure_le_volume

/-- Time reflection in the space--time ambient space.  This is kept private:
its only use here is transporting the positive conic normal form to the
negative half-wave orientation. -/
def timeReflectWaveSpaceTime (z : WaveSpaceTime) : WaveSpaceTime :=
  (z.1, -z.2)

private theorem timeReflectWaveSpaceTime_measurePreserving :
    MeasurePreserving timeReflectWaveSpaceTime (volume : Measure WaveSpaceTime) volume := by
  rw [Measure.volume_eq_prod]
  change MeasurePreserving (Prod.map id Neg.neg)
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
    ((volume : Measure (Euclidean 2)).prod (volume : Measure Real))
  exact MeasurePreserving.prod (MeasurePreserving.id _) (Measure.measurePreserving_neg _)

private theorem halfWaveMultiplier_plus_neg_eq_minus
    (t : Real) (ξ : Euclidean 2) :
    halfWaveMultiplier WaveSign.plus (-t) ξ =
      halfWaveMultiplier WaveSign.minus t ξ := by
  simp only [halfWaveMultiplier, WaveSign.toReal]
  congr 2
  ring_nf

/-- Evaluating the positive conic normal form at reflected time gives the
negative dyadic half-wave at the matched dyadic scale. -/
theorem conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (z : WaveSpaceTime)
    (hϑ : ϑ (-z.2) = 1) :
    conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z) =
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f z := by
  rw [conicOperator, timeReflectWaveSpaceTime, dyadicHalfWaveSpaceTime, dyadicHalfWave,
    hϑ, one_mul]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g z.1)
  funext ξ
  change dyadicBandpassMultiplier C.cutoff 0 (((2 : Real) ^ j)⁻¹ • ξ) *
      halfWaveMultiplier WaveSign.plus (-z.2) ξ * 𝓕 (f : Euclidean 2 → Complex) ξ =
    halfWaveMultiplier WaveSign.minus z.2 ξ * dyadicBandpassMultiplier C.cutoff j ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ
  rw [← dyadicBandpassMultiplier_eq_levelZero_scaled C j ξ,
    halfWaveMultiplier_plus_neg_eq_minus]
  ring

/-- The reflected-time conic normal form and negative dyadic half-wave agree
almost everywhere on the local time slab when the conic time cutoff is one on
the reflected slab. -/
theorem ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1) :
    (fun z => conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex) (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
  have htime : ∀ᵐ t : Real ∂(volume.restrict (Icc (1 : Real) 2)),
      t ∈ Icc (1 : Real) 2 := ae_restrict_mem measurableSet_Icc
  have hslab : ∀ᵐ z : WaveSpaceTime ∂localSmoothingMeasure,
      z.2 ∈ Icc (1 : Real) 2 := by
    rw [localSmoothingMeasure]
    rw [Measure.ae_prod_iff_ae_ae]
    · filter_upwards with x
      exact htime
    · exact measurableSet_Icc.preimage measurable_snd
  filter_upwards [hslab] with z hz
  exact conicOperator_timeReflect_eq_dyadicHalfWaveSpaceTime_minus C ϑ j f z
    (hϑ z.2 hz)

/-- A global positive-conic `L⁴` norm controls the local negative half-wave
at the matching scale, after time reflection.  The explicit measurability
hypothesis is needed for the measure-preserving change of variables. -/
theorem eLpNorm_dyadicHalfWaveSpaceTime_minus_le_conicOperator
    (C : lpCutoffs 2) (ϑ : Real → Complex) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex)
    (hϑ : ∀ t ∈ Icc (1 : Real) 2, ϑ (-t) = 1)
    (hmeas : AEStronglyMeasurable
      (conicOperator ((2 : Real) ^ j) (dyadicBandpassMultiplier C.cutoff 0) ϑ
        (f : Euclidean 2 → Complex)) volume) :
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
        localSmoothingMeasure ≤
      eLpNorm (conicOperator ((2 : Real) ^ j)
        (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex))
        (4 : ENNReal) volume := by
  let g : WaveSpaceTime → Complex := conicOperator ((2 : Real) ^ j)
    (dyadicBandpassMultiplier C.cutoff 0) ϑ (f : Euclidean 2 → Complex)
  have hg : AEStronglyMeasurable g volume := hmeas
  have hae : (g ∘ timeReflectWaveSpaceTime) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f := by
    change (fun z => g (timeReflectWaveSpaceTime z)) =ᵐ[localSmoothingMeasure]
      dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f
    exact ae_eq_conicOperator_timeReflect_dyadicHalfWaveSpaceTime_minus C ϑ j f hϑ
  have hglobal : eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume =
      eLpNorm g (4 : ENNReal) volume :=
    eLpNorm_comp_measurePreserving hg timeReflectWaveSpaceTime_measurePreserving
  change eLpNorm (dyadicHalfWaveSpaceTime C.cutoff WaveSign.minus j f) (4 : ENNReal)
      localSmoothingMeasure ≤ eLpNorm g (4 : ENNReal) volume
  rw [← eLpNorm_congr_ae hae]
  calc
    eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) localSmoothingMeasure ≤
      eLpNorm (g ∘ timeReflectWaveSpaceTime) (4 : ENNReal) volume :=
      eLpNorm_mono_measure _ localSmoothingMeasure_le_volume
    _ = eLpNorm g (4 : ENNReal) volume := hglobal

/-- The set of radial indices relevant to a frequency annulus at scale
`scale`.  This is the direct formal spelling of the distance-to-interval
condition in the MSS decomposition. -/
def relevantRadialIndices (scale : Real) : Set Int :=
  {n | ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale),
    |(n : Real) - s| < 3}

/-- Membership in the set of relevant radial indices is precisely the
witnessed distance-to-interval condition. -/
theorem mem_relevantRadialIndices_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndices scale ↔
      ∃ s ∈ Icc (Real.sqrt scale / 2) (2 * Real.sqrt scale), |(n : Real) - s| < 3 :=
  Iff.rfl

/-- The support calculation behind the relevant-index lemma: a frequency in
the annulus, whose normalized radius is within three of an integer label,
has that label in the finite radial family. -/
theorem mem_relevantRadialIndices_of_mem_annulus_of_abs_sub_lt
    {scale : Real} (hscale : 0 < scale) {ξ : Euclidean 2} {n : Int}
    (hξ : ‖ξ‖ ∈ Icc (scale / 2) (2 * scale))
    (hn : |(n : Real) - (Real.sqrt scale)⁻¹ * ‖ξ‖| < 3) :
    n ∈ relevantRadialIndices scale := by
  have hsqrt : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hleft : Real.sqrt scale / 2 ≤ (Real.sqrt scale)⁻¹ * ‖ξ‖ := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (le_div_iff₀ hsqrt).2
    calc
      Real.sqrt scale / 2 * Real.sqrt scale = (Real.sqrt scale) ^ 2 / 2 := by
        ring
      _ = scale / 2 := by rw [Real.sq_sqrt hscale.le]
      _ ≤ ‖ξ‖ := hξ.1
  have hright : (Real.sqrt scale)⁻¹ * ‖ξ‖ ≤ 2 * Real.sqrt scale := by
    rw [show (Real.sqrt scale)⁻¹ * ‖ξ‖ = ‖ξ‖ / Real.sqrt scale by
      rw [div_eq_mul_inv, mul_comm]]
    apply (div_le_iff₀ hsqrt).2
    calc
      ‖ξ‖ ≤ 2 * scale := hξ.2
      _ = 2 * Real.sqrt scale * Real.sqrt scale := by
        nlinarith [Real.sq_sqrt hscale.le]
  exact ⟨(Real.sqrt scale)⁻¹ * ‖ξ‖, ⟨hleft, hright⟩, hn⟩

/-- A finite enumeration of the relevant radial indices at every scale.  Its
existence and cardinality estimate are part of the radial localization work;
this predicate records the exact interface needed by the reconstruction. -/
def HasRelevantRadialEnumeration (indices : Real → Finset Int) : Prop :=
  ∀ scale : Real, ∀ n : Int,
    n ∈ indices scale ↔ n ∈ relevantRadialIndices scale

/-- A concrete finite interval containing every radial index which can meet
the annulus at a given scale. -/
noncomputable def relevantRadialIndexBounds (scale : Real) : Finset Int :=
  Finset.Icc ⌊Real.sqrt scale / 2 - 3⌋ ⌈2 * Real.sqrt scale + 3⌉

/-- The exact finite enumeration of radial indices relevant to the annulus.
It is obtained by filtering the explicit integer interval of possible labels. -/
noncomputable def relevantRadialIndexEnumeration (scale : Real) : Finset Int := by
  classical
  exact (relevantRadialIndexBounds scale).filter
    (fun n => n ∈ relevantRadialIndices scale)

/-- Every relevant radial index lies in the explicit finite interval used for
the enumeration. -/
theorem mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices
    (scale : Real) (n : Int) (hn : n ∈ relevantRadialIndices scale) :
    n ∈ relevantRadialIndexBounds scale := by
  rcases hn with ⟨s, hs, hdist⟩
  rw [relevantRadialIndexBounds, Finset.mem_Icc]
  have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
  constructor
  · have hlower : Real.sqrt scale / 2 - 3 ≤ (n : Real) := by
      linarith [hs.1, hdist'.1]
    have hfloor := Int.floor_le_floor hlower
    simpa using hfloor
  · have hupper : (n : Real) ≤ 2 * Real.sqrt scale + 3 := by
      linarith [hs.2, hdist'.2]
    have hceil := Int.ceil_le_ceil hupper
    simpa using hceil

/-- Membership in the explicit enumeration is exactly relevance to the
frequency annulus. -/
theorem mem_relevantRadialIndexEnumeration_iff (scale : Real) (n : Int) :
    n ∈ relevantRadialIndexEnumeration scale ↔ n ∈ relevantRadialIndices scale := by
  classical
  simp only [relevantRadialIndexEnumeration, Finset.mem_filter]
  constructor
  · exact fun h => h.2
  · intro hn
    exact ⟨mem_relevantRadialIndexBounds_of_mem_relevantRadialIndices scale n hn, hn⟩

/-- The explicit radial-index family supplies the finite enumeration required
by the radial--time reconstruction. -/
theorem hasRelevantRadialEnumeration_relevantRadialIndexEnumeration :
    HasRelevantRadialEnumeration relevantRadialIndexEnumeration := by
  intro scale n
  exact mem_relevantRadialIndexEnumeration_iff scale n

/-- The explicit radial enumeration is a subfamily of its bounding integer
interval. -/
theorem relevantRadialIndexEnumeration_subset_bounds (scale : Real) :
    relevantRadialIndexEnumeration scale ⊆ relevantRadialIndexBounds scale := by
  classical
  rw [relevantRadialIndexEnumeration]
  exact Finset.filter_subset _ _

/-- Exact cardinality of the integer interval used to bound the radial labels. -/
theorem card_relevantRadialIndexBounds (scale : Real) :
    (relevantRadialIndexBounds scale).card =
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  simp [relevantRadialIndexBounds, Int.card_Icc]

/-- Exact finite cardinality bound for the relevant radial labels. -/
theorem card_relevantRadialIndexEnumeration_le (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat := by
  calc
    (relevantRadialIndexEnumeration scale).card ≤
        (relevantRadialIndexBounds scale).card :=
      Finset.card_le_card (relevantRadialIndexEnumeration_subset_bounds scale)
    _ = (⌈2 * Real.sqrt scale + 3⌉ + 1 - ⌊Real.sqrt scale / 2 - 3⌋).toNat :=
      card_relevantRadialIndexBounds scale

/-- A simple scale-explicit count of the relevant radial labels.  This is the
finite-index estimate used before vertical recombination. -/
theorem card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven
    (scale : Real) :
    (relevantRadialIndexEnumeration scale).card ≤
      2 * ⌈Real.sqrt scale⌉₊ + 7 := by
  let bounds : Finset Int :=
    Finset.Icc (-3) (2 * (⌈Real.sqrt scale⌉₊ : Int) + 3)
  have hsubset : relevantRadialIndexEnumeration scale ⊆ bounds := by
    intro n hn
    have hn' : n ∈ relevantRadialIndices scale :=
      (mem_relevantRadialIndexEnumeration_iff scale n).mp hn
    rcases hn' with ⟨s, hs, hdist⟩
    have hdist' : -3 < (n : Real) - s ∧ (n : Real) - s < 3 := abs_lt.mp hdist
    have hsnonneg : 0 ≤ s := by
      have hroot : 0 ≤ Real.sqrt scale / 2 := by positivity
      exact hroot.trans hs.1
    have hlower : (-3 : Real) ≤ (n : Real) := by
      linarith [hdist'.1]
    have hceil : Real.sqrt scale ≤ (⌈Real.sqrt scale⌉₊ : Real) := Nat.le_ceil _
    have hupper : (n : Real) ≤ 2 * (⌈Real.sqrt scale⌉₊ : Real) + 3 := by
      linarith [hs.2, hdist'.2]
    dsimp [bounds]
    rw [Finset.mem_Icc]
    constructor
    · exact_mod_cast hlower
    · exact_mod_cast hupper
  calc
    (relevantRadialIndexEnumeration scale).card ≤ bounds.card :=
      Finset.card_le_card hsubset
    _ = 2 * ⌈Real.sqrt scale⌉₊ + 7 := by
      dsimp [bounds]
      rw [Int.card_Icc]
      have hcast :
          2 * (⌈Real.sqrt scale⌉₊ : Int) + 3 + 1 + 3 =
            ((2 * ⌈Real.sqrt scale⌉₊ + 7 : Nat) : Int) := by
        push_cast
        ring
      simp only [sub_neg_eq_add]
      rw [hcast]
      rfl

/-- The relevant radial labels have cardinality `O(sqrt scale)` with an
explicit absolute constant on the scales used in the MSS argument. -/
theorem card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt
    {scale : Real} (hscale : 2 ≤ scale) :
    ((relevantRadialIndexEnumeration scale).card : Real) ≤ 11 * Real.sqrt scale := by
  have hcount :
      ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := by
    exact_mod_cast
      card_relevantRadialIndexEnumeration_le_two_mul_natCeil_sqrt_add_seven scale
  have hsqrt : 1 ≤ Real.sqrt scale := by
    exact Real.one_le_sqrt.mpr (by linarith)
  have hceil : (⌈Real.sqrt scale⌉₊ : Real) ≤ Real.sqrt scale + 1 :=
    (Nat.ceil_lt_add_one (Real.sqrt_nonneg _)).le
  calc
    ((relevantRadialIndexEnumeration scale).card : Real) ≤
        2 * (⌈Real.sqrt scale⌉₊ : Real) + 7 := hcount
    _ ≤ 11 * Real.sqrt scale := by linarith

/-- Blueprint-faithful cutoff data for radial--time localization.

The vertical cutoff has the squared integer-translate partition, while the
radial cutoff is one on an enlarged overlap region and supported in a
strictly smaller enlargement.  This harmless slack is a standard choice of
the blueprint cutoffs; it makes the radial norm profile smooth at the origin.
Both cutoffs and the physical time cutoff are Schwartz representatives;
compact support is kept explicit because the localization proof needs its
Fourier-side consequences. -/
structure MSSRadialTimeCutoffs where
  vertical : SchwartzMap Real Complex
  radial : SchwartzMap Real Complex
  amplitude : SchwartzMap (Euclidean 2) Complex
  time : SchwartzMap Real Complex
  /-- A smooth global representative of the radial phase on the active
  annulus.  It is auxiliary cutoff data, not a replacement for the literal
  norm in the statement of the residual. -/
  normalExtension : SchwartzMap (Euclidean 2) Real
  amplitude_compact : HasCompactSupport (amplitude : Euclidean 2 → Complex)
  amplitude_support_annulus : ∀ xi ∈ Function.support
      (amplitude : Euclidean 2 → Complex),
    ‖xi‖ ∈ Icc (1 / 2 : Real) 2
  normalExtension_eq_norm_on_amplitude : ∀ xi ∈ Function.support
      (amplitude : Euclidean 2 → Complex),
    normalExtension xi = ‖xi‖
  time_compact : HasCompactSupport (time : Real → Complex)
  time_one_on_unit_slab : ∀ t ∈ Icc (1 : Real) 2, time t = 1
  vertical_support : ∀ s : Real, vertical s ≠ 0 → |s| < 1
  vertical_square_partition : ∀ s : Real,
    ∑' n : Int, (vertical (s - n)) ^ 2 = 1
  radial_support : ∀ s : Real, radial s ≠ 0 → |s| < 11 / 4
  radial_one : ∀ s : Real, |s| ≤ 9 / 4 → radial s = 1

/-- A compactly supported vertical partition may be replaced by its finite
active subfamily once every omitted summand vanishes. -/
theorem MSSRadialTimeCutoffs.vertical_square_sum_eq_one_of_zero_off_indices
    (D : MSSRadialTimeCutoffs) (s : Real) (indices : Finset Int)
    (hzero : ∀ n : Int, n ∉ indices → D.vertical (s - n) ^ 2 = 0) :
    ∑ n ∈ indices, D.vertical (s - n) ^ 2 = 1 := by
  rw [← D.vertical_square_partition s]
  exact (tsum_eq_sum hzero).symm

/-- A vertical label which is active within one normal `sqrt scale` of the
cone is relevant, and its radial factor is identically one. -/
theorem relevantRadialIndex_and_radial_one_of_near_cone
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    {eta : Euclidean 2} (heta : ‖eta‖ ∈ Icc (scale / 2) (2 * scale))
    {tau : Real} {n : Int}
    (hnear : |tau - ‖eta‖| < Real.sqrt scale)
    (hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ≠ 0) :
    n ∈ relevantRadialIndices scale ∧
      D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) = 1 := by
  let root : Real := Real.sqrt scale
  let s : Real := root⁻¹ * tau
  let r : Real := root⁻¹ * ‖eta‖
  have hroot : 0 < root := by
    dsimp only [root]
    exact Real.sqrt_pos.2 hscale
  have hsr : |s - r| < 1 := by
    dsimp only [s, r]
    rw [← mul_sub]
    calc
      |root⁻¹ * (tau - ‖eta‖)| = |tau - ‖eta‖| / root := by
        rw [abs_mul, abs_inv, abs_of_pos hroot, div_eq_mul_inv, mul_comm]
      _ < 1 := (div_lt_one₀ hroot).mpr (by simpa only [root] using hnear)
  have hsn : |s - n| < 1 := by
    apply D.vertical_support
    simpa only [s] using hvertical
  have hrn : |r - n| < 2 := by
    calc
      |r - n| ≤ |r - s| + |s - n| := abs_sub_le r s n
      _ = |s - r| + |s - n| := by rw [abs_sub_comm r s]
      _ < 1 + 1 := add_lt_add hsr hsn
      _ = 2 := by norm_num
  have hnr : |(n : Real) - r| < 3 := by
    calc
      |(n : Real) - r| = |r - n| := abs_sub_comm _ _
      _ < 2 := hrn
      _ < 3 := by norm_num
  constructor
  · apply mem_relevantRadialIndices_of_mem_annulus_of_abs_sub_lt hscale heta
    simpa only [r] using hnr
  · apply D.radial_one
    exact hrn.le.trans (by norm_num)

/-- The finite radial--vertical partition is exactly one on an active annular
frequency within one normal `sqrt scale` of the cone. -/
theorem finite_vertical_radial_partition_eq_one_on_near_cone
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    {eta : Euclidean 2} (heta : ‖eta‖ ∈ Icc (scale / 2) (2 * scale))
    {tau : Real} (hnear : |tau - ‖eta‖| < Real.sqrt scale) :
    ∑ n ∈ relevantRadialIndexEnumeration scale,
      D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
        D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) = 1 := by
  have hzero : ∀ n : Int, n ∉ relevantRadialIndexEnumeration scale →
      D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 = 0 := by
    intro n hn
    by_cases hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) = 0
    · simp [hvertical]
    · exfalso
      exact hn ((mem_relevantRadialIndexEnumeration_iff scale n).mpr
        (relevantRadialIndex_and_radial_one_of_near_cone
          D hscale heta hnear hvertical).1)
  have hverticalsum := D.vertical_square_sum_eq_one_of_zero_off_indices
    ((Real.sqrt scale)⁻¹ * tau) (relevantRadialIndexEnumeration scale) hzero
  calc
    ∑ n ∈ relevantRadialIndexEnumeration scale,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖eta‖ - n) =
      ∑ n ∈ relevantRadialIndexEnumeration scale,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 := by
        apply Finset.sum_congr rfl
        intro n hn
        by_cases hvertical : D.vertical ((Real.sqrt scale)⁻¹ * tau - n) = 0
        · simp [hvertical]
        · rw [(relevantRadialIndex_and_radial_one_of_near_cone
            D hscale heta hnear hvertical).2]
          ring
    _ = 1 := hverticalsum

/-- The finite radial--vertical reconstruction from the MSS decomposition.
It has the blueprint's two vertical factors: the displayed outer projection
and the inner projection in each input packet. -/
noncomputable def radialTimeReconstruction (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => ∑ n ∈ indices scale,
    verticalProjection verticalCutoff scale n
      (verticalProjection verticalCutoff scale n
        (conicOperator scale a ϑ (radialPiece radialCutoff scale n f))) z

/-- The error remaining after the finite radial--vertical reconstruction. -/
noncomputable def radialTimeResidual (verticalCutoff radialCutoff : Real → Complex)
    (indices : Real → Finset Int) (scale : Real) (a : Euclidean 2 → Complex)
    (ϑ : Real → Complex) (f : Euclidean 2 → Complex) : WaveSpaceTime → Complex :=
  fun z => conicOperator scale a ϑ f z -
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f z

/-- The literal radial cutoff viewed as a planar multiplier.  The `9/4`--
`11/4` slack in `MSSRadialTimeCutoffs` makes this smooth even at the origin. -/
def scratchRawRadialMultiplier (D : MSSRadialTimeCutoffs) (scale : Real) (n : Int) :
    Euclidean 2 → Complex :=
  fun xi => D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)

private theorem scratchRawRadialMultiplier_apply (D : MSSRadialTimeCutoffs)
    (scale : Real) (n : Int) (xi : Euclidean 2) :
    scratchRawRadialMultiplier D scale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := rfl

private theorem scratch_int_abs_le_two_or_three_le (n : Int) :
    |(n : Real)| ≤ 2 ∨ 3 ≤ |(n : Real)| := by
  by_cases hn : |n| ≤ 2
  · left
    exact_mod_cast hn
  · right
    have hn' : 3 ≤ |n| := by omega
    exact_mod_cast hn'

private theorem scratch_scaled_norm_lt_quarter_of_mem_ball
    {scale : Real} (hscale : 0 < scale) {xi : Euclidean 2}
    (hxi : xi ∈ Metric.ball (0 : Euclidean 2) (Real.sqrt scale / 4)) :
    (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hxinorm : ‖xi‖ < Real.sqrt scale / 4 := by
    simpa only [Metric.mem_ball, dist_zero_right] using hxi
  rw [show (Real.sqrt scale)⁻¹ * ‖xi‖ = ‖xi‖ / Real.sqrt scale by ring]
  apply (div_lt_iff₀ hroot).mpr
  calc
    ‖xi‖ < Real.sqrt scale / 4 := hxinorm
    _ = (1 / 4 : Real) * Real.sqrt scale := by ring

private theorem scratchRawRadialMultiplier_eq_one_near_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int)
    (hn : |(n : Real)| ≤ 2) :
    scratchRawRadialMultiplier D scale n =ᶠ[nhds 0] fun _ => 1 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2)
      (by positivity : 0 < Real.sqrt scale / 4)] with xi hxi
  have hscaled : (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 :=
    scratch_scaled_norm_lt_quarter_of_mem_ball hscale hxi
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  apply D.radial_one
  calc
    |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| ≤
        |(Real.sqrt scale)⁻¹ * ‖xi‖| + |(n : Real)| := by
          calc
            |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| =
                |(Real.sqrt scale)⁻¹ * ‖xi‖ + -(n : Real)| := by
                  rw [sub_eq_add_neg]
            _ ≤ |(Real.sqrt scale)⁻¹ * ‖xi‖| + |-(n : Real)| := abs_add_le _ _
            _ = |(Real.sqrt scale)⁻¹ * ‖xi‖| + |(n : Real)| := by rw [abs_neg]
    _ = (Real.sqrt scale)⁻¹ * ‖xi‖ + |(n : Real)| := by rw [abs_of_nonneg hnonneg]
    _ ≤ 1 / 4 + 2 := add_le_add hscaled.le hn
    _ = 9 / 4 := by norm_num

private theorem scratchRawRadialMultiplier_eq_zero_near_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int)
    (hn : 3 ≤ |(n : Real)|) :
    scratchRawRadialMultiplier D scale n =ᶠ[nhds 0] fun _ => 0 := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2)
      (by positivity : 0 < Real.sqrt scale / 4)] with xi hxi
  have hscaled : (Real.sqrt scale)⁻¹ * ‖xi‖ < 1 / 4 :=
    scratch_scaled_norm_lt_quarter_of_mem_ball hscale hxi
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  by_contra hne
  have hsupport := D.radial_support
    ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) hne
  have hlower : |(n : Real)| - (Real.sqrt scale)⁻¹ * ‖xi‖ ≤
      |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := by
    calc
      |(n : Real)| - (Real.sqrt scale)⁻¹ * ‖xi‖ =
          |(n : Real)| - |(Real.sqrt scale)⁻¹ * ‖xi‖| := by
            rw [abs_of_nonneg hnonneg]
      _ ≤ |(n : Real) - (Real.sqrt scale)⁻¹ * ‖xi‖| :=
        abs_sub_abs_le_abs_sub _ _
      _ = |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := abs_sub_comm _ _
  linarith

theorem scratch_contDiff_rawRadialMultiplier
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (scratchRawRadialMultiplier D scale n) := by
  rw [contDiff_iff_contDiffAt]
  intro xi
  by_cases hxi : xi = 0
  · subst xi
    rcases scratch_int_abs_le_two_or_three_le n with hn | hn
    · exact (contDiffAt_const (c := (1 : Complex))).congr_of_eventuallyEq
        (scratchRawRadialMultiplier_eq_one_near_zero D hscale n hn)
    · exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
        (scratchRawRadialMultiplier_eq_zero_near_zero D hscale n hn)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 => ‖eta‖) xi :=
      contDiffAt_norm Real hxi
    have harg : ContDiffAt Real (⊤ : ℕ∞) (fun eta : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ * ‖eta‖ - (n : Real)) xi := by
      exact (contDiffAt_const.mul hnorm).sub contDiffAt_const

    exact (D.radial.smooth (⊤ : ℕ∞)).contDiffAt.comp xi harg

theorem scratch_hasCompactSupport_rawRadialMultiplier
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale) (n : Int) :
    HasCompactSupport (scratchRawRadialMultiplier D scale n) := by
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  apply HasCompactSupport.intro
    (isCompact_closedBall (0 : Euclidean 2)
      (Real.sqrt scale * (|(n : Real)| + 11 / 4)))
  intro xi hxi
  have hxinorm : Real.sqrt scale * (|(n : Real)| + 11 / 4) ≤ ‖xi‖ := by
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  have hscaled : |(n : Real)| + 11 / 4 ≤
      (Real.sqrt scale)⁻¹ * ‖xi‖ := by
    rw [show (Real.sqrt scale)⁻¹ * ‖xi‖ = ‖xi‖ / Real.sqrt scale by ring]
    apply (le_div_iff₀ hroot).mpr
    calc
      (|(n : Real)| + 11 / 4) * Real.sqrt scale =
          Real.sqrt scale * (|(n : Real)| + 11 / 4) := by ring
      _ ≤ ‖xi‖ := hxinorm
  have hnonneg : 0 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ := by positivity
  rw [scratchRawRadialMultiplier_apply]
  by_contra hne
  have hsupport := D.radial_support
    ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) hne
  have hlower : 11 / 4 ≤
      |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| := by
    calc
      11 / 4 ≤ (Real.sqrt scale)⁻¹ * ‖xi‖ - |(n : Real)| := by linarith
      _ = |(Real.sqrt scale)⁻¹ * ‖xi‖| - |(n : Real)| := by
        rw [abs_of_nonneg hnonneg]
      _ ≤ |(Real.sqrt scale)⁻¹ * ‖xi‖ - (n : Real)| :=
        abs_sub_abs_le_abs_sub _ _
  exact (not_lt_of_ge hlower) hsupport

/-- The actual global Schwartz representative of the raw radial multiplier.
Unlike the old abstract representative hypothesis, this is constructed from
the slack of `MSSRadialTimeCutoffs`. -/
noncomputable def scratchRadialSchwartzProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap (Euclidean 2) Complex :=
  (scratch_hasCompactSupport_rawRadialMultiplier D hscale n).toSchwartzMap
    (scratch_contDiff_rawRadialMultiplier D hscale n)

theorem scratchRadialSchwartzProfile_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (xi : Euclidean 2) :
    scratchRadialSchwartzProfile D scale hscale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := rfl

/-- A positive-scale raw radial packet profile is globally Schwartz.  This
is the reusable form of the origin-smoothing construction above: the slack
in the radial cutoff makes the literal norm expression smooth at the origin.
The positivity hypothesis is essential, since the normalized radial variable
is only meaningful at positive scale. -/
noncomputable def mssRawRadialSchwartzProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap (Euclidean 2) Complex :=
  scratchRadialSchwartzProfile D scale hscale n

theorem mssRawRadialSchwartzProfile_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (xi : Euclidean 2) :
    mssRawRadialSchwartzProfile D scale hscale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) :=
  scratchRadialSchwartzProfile_apply D scale hscale n xi

/-- Scale the supplied normal extension so that it agrees with `‖xi‖` on
the scaled amplitude annulus. -/
noncomputable def scratchScaledNormalExtension
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Real :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  scale • ((SchwartzMap.compCLMOfContinuousLinearEquiv Real A) D.normalExtension)

theorem scratchScaledNormalExtension_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    scratchScaledNormalExtension D scale hscale xi =
      scale * D.normalExtension (scale⁻¹ • xi) := by
  unfold scratchScaledNormalExtension
  dsimp
  change scale • D.normalExtension (scale⁻¹ • xi) = _
  rfl

private theorem scratch_scaledAmplitude_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) :
    (fun xi : Euclidean 2 => D.amplitude (scale⁻¹ • xi)).HasTemperateGrowth := by
  fun_prop

/-- The literal planar Fourier amplitude of the unprojected conic packet. -/
noncomputable def scratchRawConicBase
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (fun xi : Euclidean 2 => D.amplitude (scale⁻¹ • xi))
    (FourierTransform.fourier f)

private theorem scratchRawConicBase_apply
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchRawConicBase D scale f xi =
      D.amplitude (scale⁻¹ • xi) * FourierTransform.fourier
        (f : Euclidean 2 → Complex) xi := by
  unfold scratchRawConicBase
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratch_scaledAmplitude_hasTemperateGrowth D scale)]
  rw [SchwartzMap.fourier_coe]
  rfl

/-- The scaled normal extension is the literal norm wherever the raw conic
base can be nonzero. -/
private theorem scratchScaledNormalExtension_eq_norm_on_rawConicBase_support

    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    ∀ xi ∈ Function.support (scratchRawConicBase D scale f : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    intro hz
    apply hxi
    rw [scratchRawConicBase_apply, hz, zero_mul]
  have hnormal := D.normalExtension_eq_norm_on_amplitude
    (scale⁻¹ • xi) hamp
  rw [scratchScaledNormalExtension_apply, hnormal, norm_smul,
    Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- The joint-Schwartz spectral realization of the literal unprojected
conic packet. -/
noncomputable def scratchRawConicSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile (scratchRawConicBase D scale f) D.time
    (scratchScaledNormalExtension D scale hscale)

/-- This is a raw equality: the literal `conicOperator`, not a replacement
model, is the inverse joint Fourier transform of the displayed spectrum. -/
private theorem scratch_conicOperator_eq_inverse_rawConicSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    conicOperator scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchRawConicSpectrum D scale hscale f)) := by
  funext z
  unfold scratchRawConicSpectrum
  rw [spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
    (scratchRawConicBase D scale f) D.time (scratchScaledNormalExtension D scale hscale)
    (scratchScaledNormalExtension_eq_norm_on_rawConicBase_support D scale hscale f) z]
  unfold conicOperator
  apply congrArg (fun q : Euclidean 2 → Complex =>
    D.time z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [scratchRawConicBase_apply]
  ring

/-- The literal radial multiplier times the conic base, packaged as a
Schwartz spatial profile by the preceding slack construction. -/
noncomputable def scratchRawConicRadialBase
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratchRadialSchwartzProfile D scale hscale n : Euclidean 2 → Complex)
    (scratchRawConicBase D scale f)

private theorem scratchRawConicRadialBase_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    scratchRawConicRadialBase D scale hscale n f xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) *
        scratchRawConicBase D scale f xi := by
  unfold scratchRawConicRadialBase
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchRadialSchwartzProfile D scale hscale n).hasTemperateGrowth]
  rw [scratchRadialSchwartzProfile_apply]
  rfl

private theorem scratchRawConicRadialBase_support_subset_base
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Function.support (scratchRawConicRadialBase D scale hscale n f :
      Euclidean 2 → Complex) ⊆
      Function.support (scratchRawConicBase D scale f : Euclidean 2 → Complex) := by
  intro xi hxi
  change scratchRawConicRadialBase D scale hscale n f xi ≠ 0 at hxi
  change scratchRawConicBase D scale f xi ≠ 0
  intro hbase
  apply hxi
  rw [scratchRawConicRadialBase_apply, hbase, mul_zero]

private theorem scratchScaledNormalExtension_eq_norm_on_rawConicRadialBase_support
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    ∀ xi ∈ Function.support
        (scratchRawConicRadialBase D scale hscale n f : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  exact scratchScaledNormalExtension_eq_norm_on_rawConicBase_support D scale hscale f xi
    (scratchRawConicRadialBase_support_subset_base D scale hscale n f hxi)

noncomputable def scratchRawConicRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (scratchRawConicRadialBase D scale hscale n f) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem scratchRawConicRadialSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)

    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchRawConicRadialSpectrum D scale hscale n f (WithLp.toLp 2 zeta) =
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  unfold scratchRawConicRadialSpectrum scratchRawConicSpectrum
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, scratchRawConicRadialBase_apply]
  ring

/-- The requested masked radial bridge: the raw conic operator on the
literal `radialPiece` is exactly the inverse joint-Schwartz radial profile. -/
private theorem scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    conicOperator scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex)
        (radialPiece (D.radial : Real → Complex) scale n
          (f : Euclidean 2 → Complex)) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchRawConicRadialSpectrum D scale hscale n f)) := by
  funext z
  unfold scratchRawConicRadialSpectrum
  rw [spaceTimeFourierInv_jointSchwartzModulatedAnnularProfile_eq_halfWave_of_eq_norm_on_support
    (scratchRawConicRadialBase D scale hscale n f) D.time
    (scratchScaledNormalExtension D scale hscale)
    (scratchScaledNormalExtension_eq_norm_on_rawConicRadialBase_support
      D scale hscale n f) z]
  unfold conicOperator
  apply congrArg (fun q : Euclidean 2 → Complex =>
    D.time z.2 * FourierTransform.fourierInv q z.1)
  funext xi
  rw [fourier_radialPiece_eq_schwartzProfile_mul_fourier
    (D.radial : Real → Complex) scale n
    (scratchRadialSchwartzProfile D scale hscale n) f
    (scratchRadialSchwartzProfile_apply D scale hscale n) xi]
  rw [scratchRawConicRadialBase_apply, scratchRawConicBase_apply]
  rw [scratchRadialSchwartzProfile_apply]
  ring

/-- The shifted/dilated vertical window as a Schwartz temporal profile. -/
noncomputable def scratchMaskedVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem scratchMaskedVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    scratchMaskedVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold scratchMaskedVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

def scratchMaskedJointVerticalMultiplier
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem scratchMaskedJointVerticalMultiplier_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (scratchMaskedJointVerticalMultiplier m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

noncomputable def scratchMaskedApplyVerticalSpectrum
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex (scratchMaskedJointVerticalMultiplier m) Q

private theorem scratchMaskedApplyVerticalSpectrum_apply
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex) (zeta : WaveSpaceTime) :
    scratchMaskedApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta) =
      m zeta.2 * Q (WithLp.toLp 2 zeta) := by
  unfold scratchMaskedApplyVerticalSpectrum
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchMaskedJointVerticalMultiplier_hasTemperateGrowth m)]
  unfold scratchMaskedJointVerticalMultiplier
  rfl

private theorem scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (beta : Real → Complex) (scale : Real) (n : Int)
    (m : SchwartzMap Real Complex)
    (Q : SchwartzMap JointWaveSpaceTime Complex)
    (hprofile : ∀ tau : Real,
      m tau = beta ((Real.sqrt scale)⁻¹ * tau - n)) :
    verticalProjection beta scale n
        (spaceTimeFourierInv (jointSchwartzRaw Q)) =
      spaceTimeFourierInv

        (jointSchwartzRaw (scratchMaskedApplyVerticalSpectrum m Q)) := by
  have hmult :
      (fun zeta : WaveSpaceTime =>
        verticalMultiplier beta scale n zeta *
          spaceTimeFourier (spaceTimeFourierInv (jointSchwartzRaw Q)) zeta) =
        jointSchwartzRaw (scratchMaskedApplyVerticalSpectrum m Q) := by
    funext zeta
    rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw Q zeta]
    change verticalMultiplier beta scale n zeta * Q (WithLp.toLp 2 zeta) =
      scratchMaskedApplyVerticalSpectrum m Q (WithLp.toLp 2 zeta)
    rw [scratchMaskedApplyVerticalSpectrum_apply]
    rw [hprofile zeta.2]
    rfl
  unfold verticalProjection
  rw [hmult]

/-- The joint-Schwartz spectrum of the literal `V_n² T_lambda f_n` packet. -/
noncomputable def scratchMaskedDoubleVerticalRadialSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  let m := scratchMaskedVerticalProfile D.vertical scale n hscale
  scratchMaskedApplyVerticalSpectrum m
    (scratchMaskedApplyVerticalSpectrum m
      (scratchRawConicRadialSpectrum D scale hscale n f))

noncomputable def scratchMaskedDoubleVerticalReconstructionSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  ∑ n ∈ indices, scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f

noncomputable def scratchMaskedDoubleVerticalResidualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap JointWaveSpaceTime Complex :=
  scratchRawConicSpectrum D scale hscale f -
    scratchMaskedDoubleVerticalReconstructionSpectrum D scale hscale indices f

private theorem scratchMaskedDoubleVerticalRadialSpectrum_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
        (WithLp.toLp 2 zeta) =
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
          scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  unfold scratchMaskedDoubleVerticalRadialSpectrum
  dsimp
  rw [scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedApplyVerticalSpectrum_apply,
    scratchRawConicRadialSpectrum_apply,
    scratchMaskedVerticalProfile_apply D.vertical scale n hscale]
  rw [verticalMultiplier]
  ring

private theorem scratchMasked_doubleVerticalRadialPhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    verticalProjection (D.vertical : Real → Complex) scale n
        (verticalProjection (D.vertical : Real → Complex) scale n
          (conicOperator scale (D.amplitude : Euclidean 2 → Complex)
            (D.time : Real → Complex)
            (radialPiece (D.radial : Real → Complex) scale n
              (f : Euclidean 2 → Complex)))) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)) := by
  rw [scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale n f]
  unfold scratchMaskedDoubleVerticalRadialSpectrum
  dsimp
  rw [scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (D.vertical : Real → Complex) scale n
    (scratchMaskedVerticalProfile D.vertical scale n hscale)
    (scratchRawConicRadialSpectrum D scale hscale n f)
    (scratchMaskedVerticalProfile_apply D.vertical scale n hscale)]
  rw [scratchMasked_verticalProjection_eq_inverse_jointSpectrum
    (D.vertical : Real → Complex) scale n
    (scratchMaskedVerticalProfile D.vertical scale n hscale)
    (scratchMaskedApplyVerticalSpectrum
      (scratchMaskedVerticalProfile D.vertical scale n hscale)
      (scratchRawConicRadialSpectrum D scale hscale n f))
    (scratchMaskedVerticalProfile_apply D.vertical scale n hscale)]

private theorem scratchMasked_doubleVerticalRadialInversePhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    verticalProjection (D.vertical : Real → Complex) scale n
        (verticalProjection (D.vertical : Real → Complex) scale n
          (spaceTimeFourierInv (jointSchwartzRaw
            (scratchRawConicRadialSpectrum D scale hscale n f)))) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)) := by
  rw [← scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale n f]
  exact scratchMasked_doubleVerticalRadialPhysical_eq D scale hscale n f

/-- The inverse transform of the explicit residual spectrum is precisely the
finite physical double-projection error, before the raw conic bridge is
substituted. -/

private theorem scratchMasked_doubleVerticalResidualPhysical_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    spaceTimeFourierInv
        (jointSchwartzRaw
          (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f)) =
      fun z =>
        spaceTimeFourierInv (jointSchwartzRaw
          (scratchRawConicSpectrum D scale hscale f)) z -
          ∑ n ∈ indices,
            verticalProjection (D.vertical : Real → Complex) scale n
              (verticalProjection (D.vertical : Real → Complex) scale n
                (spaceTimeFourierInv (jointSchwartzRaw
                  (scratchRawConicRadialSpectrum D scale hscale n f)))) z := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  rw [← SchwartzMap.fourierInv_coe]
  rw [sub_eq_add_neg, FourierTransform.fourierInv_add,
    FourierTransform.fourierInv_neg, FourierTransform.fourierInv_sum]
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  have hterm (n : Int) :=
    scratchMasked_doubleVerticalRadialInversePhysical_eq D scale hscale n f
  simp_rw [hterm]
  simp_rw [spaceTimeFourierInv_jointSchwartzRaw]
  simp_rw [← SchwartzMap.fourierInv_coe]
  change
    (FourierTransform.fourierInv (scratchRawConicSpectrum D scale hscale f) :
        SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z) -
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
        (∑ n ∈ indices,
          FourierTransform.fourierInv
            (scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f))
          (WithLp.toLp 2 z) = _
  rw [map_sum, Finset.sum_apply]
  congr 1

/-- The literal source-level radial--time residual is exactly the inverse
joint Fourier transform of the explicit corrected double-projection profile. -/
private theorem scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f)) := by
  rw [scratchMasked_doubleVerticalResidualPhysical_eq D scale hscale indices f]
  funext z
  unfold radialTimeResidual radialTimeReconstruction
  rw [scratch_conicOperator_eq_inverse_rawConicSpectrum D scale hscale f]
  simp_rw [scratch_conicOperator_radialPiece_eq_inverse_rawConicRadialSpectrum
    D scale hscale]

/-- Exact Fourier-side error symbol for the finite corrected reconstruction. -/
private theorem scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (spaceTimeFourierInv (jointSchwartzRaw
          (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f))) zeta =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw]
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  have hsumapply :
      (∑ n ∈ indices,
        scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
            (WithLp.toLp 2 zeta) := by
    change (FunLike.coeAddMonoidHom
      (SchwartzMap JointWaveSpaceTime Complex)
      JointWaveSpaceTime Complex)
      (∑ n ∈ indices, scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
        (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    apply Finset.sum_congr rfl
    intro n hn
    rfl
  rw [sub_apply, hsumapply]
  have hterm (n : Int) :
      scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
          (WithLp.toLp 2 zeta) =
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
            scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) :=
    scratchMaskedDoubleVerticalRadialSpectrum_apply D scale hscale n f zeta
  simp_rw [hterm]
  rw [sub_mul, one_mul, Finset.sum_mul]

/-- The source-level corrected residual has the blueprint's exact finite

error multiplier. -/
private theorem scratchMasked_spaceTimeFourier_radialTimeResidual
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  exact scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    D scale hscale indices f zeta

/-- The preceding raw-to-joint bridge in the source API's natural form,
where the finite enumeration is allowed to depend on the scale. -/
theorem radialTimeResidual_eq_inverse_mssRadialTimeResidualSpectrum
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        indices scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale (indices scale) f)) := by
  change radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
      (fun _ => indices scale) scale (D.amplitude : Euclidean 2 → Complex)
      (D.time : Real → Complex) (f : Euclidean 2 → Complex) = _
  exact scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale (indices scale) f

theorem spaceTimeFourier_radialTimeResidual_mssRadialTime
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          indices scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      (1 - ∑ n ∈ indices scale,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) := by
  rw [radialTimeResidual_eq_inverse_mssRadialTimeResidualSpectrum
    D indices scale hscale f]
  exact scratchMasked_spaceTimeFourier_finiteDoubleVerticalResidual
    D scale hscale (indices scale) f zeta

/- The f-independent regular multiplier and exact residual factorization
used by the radial--time localization proof.  All declarations in this
block are private implementation details. -/
/-- The amplitude at the physical radial--time scale.  This is the spatial
Schwartz factor common to the raw conic spectrum and every projected term. -/
private noncomputable def mssRadialTimeScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.amplitude

private theorem mssRadialTimeScaledAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    mssRadialTimeScaledAmplitude D scale hscale xi =
      D.amplitude (scale⁻¹ • xi) := by
  unfold mssRadialTimeScaledAmplitude
  dsimp
  rfl

private theorem scaledNormal_eq_norm_on_scaledAmplitude_support
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    ∀ xi ∈ Function.support
      (mssRadialTimeScaledAmplitude D scale hscale : Euclidean 2 → Complex),
      scratchScaledNormalExtension D scale hscale xi = ‖xi‖ := by
  intro xi hxi
  change mssRadialTimeScaledAmplitude D scale hscale xi ≠ 0 at hxi
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    rwa [mssRadialTimeScaledAmplitude_apply] at hxi
  have hnormal := D.normalExtension_eq_norm_on_amplitude
    (scale⁻¹ • xi) hamp
  rw [scratchScaledNormalExtension_apply, hnormal, norm_smul,
    Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

/-- The f-independent joint conic spectrum before the radial and vertical
projections. -/
private noncomputable def mssRadialTimeBaseMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (mssRadialTimeScaledAmplitude D scale hscale) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem mssRadialTimeBaseMultiplier_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (zeta : WaveSpaceTime) :
    mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) =
      D.amplitude (scale⁻¹ • zeta.1) *
        FourierTransform.fourier (D.time : Real → Complex)
          (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1) := by
  unfold mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    mssRadialTimeScaledAmplitude_apply]

/-- The f-independent spatial radial piece of the residual multiplier. -/
private noncomputable def mssRadialTimeRadialAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap (Euclidean 2) Complex :=
  SchwartzMap.smulLeftCLM Complex
    (scratchRadialSchwartzProfile D scale hscale n : Euclidean 2 → Complex)
    (mssRadialTimeScaledAmplitude D scale hscale)

private theorem mssRadialTimeRadialAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (xi : Euclidean 2) :
    mssRadialTimeRadialAmplitude D scale hscale n xi =
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) *
        D.amplitude (scale⁻¹ • xi) := by
  unfold mssRadialTimeRadialAmplitude
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (scratchRadialSchwartzProfile D scale hscale n).hasTemperateGrowth,
    scratchRadialSchwartzProfile_apply, mssRadialTimeScaledAmplitude_apply]
  rfl

/-- The raw f-independent radial spectral term. -/
private noncomputable def mssRadialTimeRadialMultiplierTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  jointSchwartzModulatedAnnularProfile
    (mssRadialTimeRadialAmplitude D scale hscale n) D.time
    (scratchScaledNormalExtension D scale hscale)

private theorem mssRadialTimeRadialMultiplierTerm_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (zeta : WaveSpaceTime) :
    mssRadialTimeRadialMultiplierTerm D scale hscale n (WithLp.toLp 2 zeta) =
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) *
        mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) := by
  unfold mssRadialTimeRadialMultiplierTerm mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, mssRadialTimeRadialAmplitude_apply,
    mssRadialTimeScaledAmplitude_apply]
  ring

/-- Apply the two literal vertical projections to an f-independent radial
term. -/
private noncomputable def mssRadialTimeDoubleVerticalMultiplierTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  let m := scratchMaskedVerticalProfile D.vertical scale n hscale
  scratchMaskedApplyVerticalSpectrum m
    (scratchMaskedApplyVerticalSpectrum m
      (mssRadialTimeRadialMultiplierTerm D scale hscale n))

private theorem mssRadialTimeDoubleVerticalMultiplierTerm_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (zeta : WaveSpaceTime) :
    mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
        (WithLp.toLp 2 zeta) =
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        mssRadialTimeRadialMultiplierTerm D scale hscale n
          (WithLp.toLp 2 zeta) := by
  unfold mssRadialTimeDoubleVerticalMultiplierTerm
  dsimp
  rw [scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedApplyVerticalSpectrum_apply,
    scratchMaskedVerticalProfile_apply D.vertical scale n hscale]
  rw [verticalMultiplier]
  ring

/-- The f-independent exact finite double-projection residual multiplier. -/
private noncomputable def mssRadialTimeResidualMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    SchwartzMap JointWaveSpaceTime Complex :=
  mssRadialTimeBaseMultiplier D scale hscale -
    ∑ n ∈ indices, mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n

private theorem mssRadialTimeResidualMultiplier_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (zeta : WaveSpaceTime) :
    mssRadialTimeResidualMultiplier D scale hscale indices (WithLp.toLp 2 zeta) =
      (1 - ∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)) *
        (D.amplitude (scale⁻¹ • zeta.1) *
          FourierTransform.fourier (D.time : Real → Complex)
            (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1)) := by
  unfold mssRadialTimeResidualMultiplier
  have hsum :
      (∑ n ∈ indices,
        mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  rw [sub_apply, hsum, mssRadialTimeBaseMultiplier_apply]
  simp_rw [mssRadialTimeDoubleVerticalMultiplierTerm_apply,
    mssRadialTimeRadialMultiplierTerm_apply]
  rw [mssRadialTimeBaseMultiplier_apply]
  set B : Complex :=
    D.amplitude (scale⁻¹ • zeta.1) *
      FourierTransform.fourier (D.time : Real → Complex)
        (zeta.2 - scratchScaledNormalExtension D scale hscale zeta.1)
  let c : Int → Complex := fun n =>
    (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
      D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n)
  change B - ∑ n ∈ indices,
      (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
        (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B) =
    (1 - ∑ n ∈ indices, c n) * B
  have hsum_factor :
      (∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B)) =
        (∑ n ∈ indices, c n) * B := by
    calc
      (∑ n ∈ indices,
        (verticalMultiplier (D.vertical : Real → Complex) scale n zeta) ^ 2 *
          (D.radial ((Real.sqrt scale)⁻¹ * ‖zeta.1‖ - n) * B)) =
          ∑ n ∈ indices, c n * B := by
            apply Finset.sum_congr rfl
            intro n hn
            dsimp [c]
            ring
      _ = (∑ n ∈ indices, c n) * B := (Finset.sum_mul ..).symm
  rw [hsum_factor]
  ring

/-- The unprojected residual spectrum factors through the f-independent base
multiplier and the spatial Fourier transform of the input. -/
private theorem scratchRawConicSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchRawConicSpectrum D scale hscale f (WithLp.toLp 2 zeta) =
      mssRadialTimeBaseMultiplier D scale hscale (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  unfold scratchRawConicSpectrum mssRadialTimeBaseMultiplier
  rw [jointSchwartzModulatedAnnularProfile_apply,
    jointSchwartzModulatedAnnularProfile_apply, scratchRawConicBase_apply,
    mssRadialTimeScaledAmplitude_apply]
  ring

/-- Each f-dependent double-projected radial spectrum factors through its
f-independent double-projection multiplier. -/
private theorem scratchMaskedDoubleVerticalRadialSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  rw [scratchMaskedDoubleVerticalRadialSpectrum_apply,
    mssRadialTimeDoubleVerticalMultiplierTerm_apply,
    mssRadialTimeRadialMultiplierTerm_apply,
    scratchRawConicSpectrum_factor]
  ring

/-- Exact f-independent factorization of the corrected finite
double-projection residual spectrum. -/
private theorem scratchMaskedDoubleVerticalResidualSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  unfold scratchMaskedDoubleVerticalResidualSpectrum
    scratchMaskedDoubleVerticalReconstructionSpectrum
  have hsource_sum :
      (∑ n ∈ indices,
        scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            scratchMaskedDoubleVerticalRadialSpectrum D scale hscale n f)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  have hmultiplier_sum :
      (∑ n ∈ indices,
        mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) =
        ∑ n ∈ indices,
          mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n
            (WithLp.toLp 2 zeta) := by
    change
      (FunLike.coeAddMonoidHom
        (SchwartzMap JointWaveSpaceTime Complex)
        JointWaveSpaceTime Complex)
          (∑ n ∈ indices,
            mssRadialTimeDoubleVerticalMultiplierTerm D scale hscale n)
          (WithLp.toLp 2 zeta) = _
    rw [map_sum, Finset.sum_apply]
    congr 1
  rw [sub_apply, hsource_sum, scratchRawConicSpectrum_factor]
  simp_rw [scratchMaskedDoubleVerticalRadialSpectrum_factor]
  rw [← Finset.sum_mul]
  unfold mssRadialTimeResidualMultiplier
  rw [sub_apply, hmultiplier_sum]
  ring

/-- Raw-coordinate version of the residual factorization, tailored to the
joint inverse-Fourier/convolution bridge. -/
private theorem jointSchwartzRaw_residualSpectrum_factor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    jointSchwartzRaw
        (scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f) zeta =
      jointSchwartzRaw
          (mssRadialTimeResidualMultiplier D scale hscale indices) zeta *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  change
    scratchMaskedDoubleVerticalResidualSpectrum D scale hscale indices f
        (WithLp.toLp 2 zeta) =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1
  exact scratchMaskedDoubleVerticalResidualSpectrum_factor
    D scale hscale indices f zeta

/-- Literal source-level residual as the inverse joint transform of the
f-independent multiplier times the spatial Fourier data. -/
private theorem radialTimeResidual_eq_inverse_factorizedResidualSpectrum
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
      spaceTimeFourierInv (fun zeta : WaveSpaceTime =>
        jointSchwartzRaw
            (mssRadialTimeResidualMultiplier D scale hscale indices) zeta *
          FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1) := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  congr 1
  funext zeta
  exact jointSchwartzRaw_residualSpectrum_factor D scale hscale indices f zeta

/-- The literal residual Fourier transform has the exact f-independent
multiplier factorization. -/
private theorem spaceTimeFourier_radialTimeResidual_factorized
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (zeta : WaveSpaceTime) :
    spaceTimeFourier
        (radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex)) zeta =
      mssRadialTimeResidualMultiplier D scale hscale indices
          (WithLp.toLp 2 zeta) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1 := by
  rw [scratchMasked_radialTimeResidual_eq_inverse_residualSpectrum
    D scale hscale indices f]
  rw [spaceTimeFourier_spaceTimeFourierInv_jointSchwartzRaw]
  exact scratchMaskedDoubleVerticalResidualSpectrum_factor
    D scale hscale indices f zeta

/-- The blueprint's radial--time localization proposition.  The literal
double-projection residual is controlled for every `1 ≤ p ≤ ∞` from the
admissible compact cutoff data above. -/
def radialTimeLocalization (D : MSSRadialTimeCutoffs) : Prop :=
  ∀ (p : ENNReal) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
    ∀ scale : Real, 2 ≤ scale →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        eLpNorm
            (radialTimeResidual (D.vertical : Real → Complex)
              (D.radial : Real → Complex) relevantRadialIndexEnumeration
              scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
              (f : Euclidean 2 → Complex))
            p volume ≤
          ENNReal.ofReal (C * (scale⁻¹) ^ N) *
            eLpNorm (f : Euclidean 2 → Complex) p volume

/-- An exact finite enumeration of the relevant radial labels is unique. -/
theorem relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
    (indices : Real → Finset Int) (hindices : HasRelevantRadialEnumeration indices)
    (scale : Real) :
    relevantRadialIndexEnumeration scale = indices scale := by
  ext n
  rw [mem_relevantRadialIndexEnumeration_iff, hindices scale n]

/-- Radial--time reconstruction is independent of the chosen presentation of
the exact finite index enumeration. -/
theorem radialTimeReconstruction_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeReconstruction verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeReconstruction verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- The corresponding radial--time residual is likewise independent of an
exact presentation of the finite relevant-index family. -/
theorem radialTimeResidual_eq_of_hasRelevantRadialEnumeration
    (verticalCutoff radialCutoff : Real → Complex) (indices : Real → Finset Int)
    (hindices : HasRelevantRadialEnumeration indices) (scale : Real)
    (a : Euclidean 2 → Complex) (ϑ : Real → Complex) (f : Euclidean 2 → Complex) :
    radialTimeResidual verticalCutoff radialCutoff indices scale a ϑ f =
      radialTimeResidual verticalCutoff radialCutoff relevantRadialIndexEnumeration
        scale a ϑ f := by
  have hfun : indices = relevantRadialIndexEnumeration := by
    funext r
    exact (relevantRadialIndexEnumeration_eq_of_hasRelevantRadialEnumeration
      indices hindices r).symm
  rw [hfun]

/-- The corrected localization predicate unfolds to its single explicit
relevant-index estimate. -/
theorem radialTimeLocalization_iff_estimate (D : MSSRadialTimeCutoffs) :
    radialTimeLocalization D ↔
      ∀ (p : ENNReal) (N : Nat), 1 ≤ p → ∃ C : Real, 0 < C ∧
        ∀ scale : Real, 2 ≤ scale →
          ∀ f : SchwartzMap (Euclidean 2) Complex,
            eLpNorm
                (radialTimeResidual (D.vertical : Real → Complex)
                  (D.radial : Real → Complex) relevantRadialIndexEnumeration
                  scale (D.amplitude : Euclidean 2 → Complex) (D.time : Real → Complex)
                  (f : Euclidean 2 → Complex))
                p volume ≤
              ENNReal.ofReal (C * (scale⁻¹) ^ N) *
                eLpNorm (f : Euclidean 2 → Complex) p volume := Iff.rfl





section RadialTimeLocalizationAux

/- Private smooth normal-coordinate residual calculus for the active radial--time localization proof. -/

private noncomputable def rta_scratchRadialTimeResidualBracket
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (xi : Euclidean 2) (tau : Real) : Complex :=
  1 - ∑ n ∈ relevantRadialIndexEnumeration scale,
    D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
      D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)

/-- The smooth scaled normal coordinate supplied by `MSSRadialTimeCutoffs`.
It agrees with `‖xi‖` on the scaled amplitude support. -/
private noncomputable def rta_scratchScaledNormalCoordinate
    (D : MSSRadialTimeCutoffs) (scale : Real) (xi : Euclidean 2) : Real :=
  scale * D.normalExtension (scale⁻¹ • xi)

/-- The actual frequency-side residual multiplier before the spatial input
Fourier transform is attached. -/
private noncomputable def rta_scratchRadialTimeResidualMultiplier
    (D : MSSRadialTimeCutoffs) (scale : Real)
    (xi : Euclidean 2) (tau : Real) : Complex :=
  D.amplitude (scale⁻¹ • xi) *
    rta_scratchRadialTimeResidualBracket D scale xi tau *
    FourierTransform.fourier (D.time : Real → Complex)
      (tau - rta_scratchScaledNormalCoordinate D scale xi)

private theorem rta_scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    rta_scratchScaledNormalCoordinate D scale xi = ‖xi‖ := by
  unfold rta_scratchScaledNormalCoordinate
  rw [D.normalExtension_eq_norm_on_amplitude (scale⁻¹ • xi) hxi,
    norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)]
  field_simp [hscale.ne']

private theorem rta_scratch_norm_mem_scaled_annulus_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    ‖xi‖ ∈ Icc (scale / 2) (2 * scale) := by
  have h := D.amplitude_support_annulus (scale⁻¹ • xi) hxi
  rw [norm_smul, Real.norm_eq_abs, abs_of_pos (inv_pos.mpr hscale)] at h
  have hcancel : scale * (scale⁻¹ * ‖xi‖) = ‖xi‖ := by
    field_simp [hscale.ne']
  constructor
  · rw [show scale / 2 = scale * (1 / 2) by ring]
    calc
      scale * (1 / 2) ≤ scale * (scale⁻¹ * ‖xi‖) :=
        (mul_le_mul_iff_of_pos_left hscale).mpr h.1
      _ = ‖xi‖ := hcancel
  · rw [show 2 * scale = scale * 2 by ring]
    calc
      ‖xi‖ = scale * (scale⁻¹ * ‖xi‖) := hcancel.symm
      _ ≤ scale * 2 := (mul_le_mul_iff_of_pos_left hscale).mpr h.2

/-- The literal residual bracket vanishes in its `sqrt scale` normal tube.
This is the cancellation that supplies arbitrary scale decay from the fixed
Schwartz physical-time cutoff. -/
private theorem rta_scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0)
    (hnear : |tau - rta_scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    rta_scratchRadialTimeResidualBracket D scale xi tau = 0 := by
  unfold rta_scratchRadialTimeResidualBracket
  have hann := rta_scratch_norm_mem_scaled_annulus_of_amplitude_ne_zero D hscale xi hxi
  have hnormal := rta_scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero
    D hscale xi hxi
  rw [hnormal] at hnear
  rw [finite_vertical_radial_partition_eq_one_on_near_cone D hscale hann hnear]
  ring

/-- If the actual residual multiplier is nonzero, its normal frequency lies
outside the cancellation tube, unless the scaled amplitude itself vanishes
(in which case the conclusion is irrelevant). -/
private theorem rta_scratch_normal_gap_of_radialTimeResidualMultiplier_ne_zero
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hE : rta_scratchRadialTimeResidualMultiplier D scale xi tau ≠ 0) :
    Real.sqrt scale ≤ |tau - rta_scratchScaledNormalCoordinate D scale xi| := by
  by_contra hnot
  have hnear : |tau - rta_scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale :=
    lt_of_not_ge hnot
  have hamp : D.amplitude (scale⁻¹ • xi) ≠ 0 := by
    intro hz
    apply hE
    simp [rta_scratchRadialTimeResidualMultiplier, hz]
  have hbracket := rta_scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
    D hscale xi tau hamp hnear
  apply hE
  simp [rta_scratchRadialTimeResidualMultiplier, hbracket]

/-- The spatial dilation of the supplied compact Schwartz amplitude. -/
private noncomputable def rta_scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  (SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) D.amplitude

private theorem rta_scratchScaledAmplitude_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    rta_scratchScaledAmplitude D scale hscale xi = D.amplitude (scale⁻¹ • xi) := by
  unfold rta_scratchScaledAmplitude
  dsimp
  rfl

/-- A globally smooth scaled extension of the normal coordinate. -/
private noncomputable def rta_scratchScaledNormalExtension
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    SchwartzMap (Euclidean 2) Real :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 scale⁻¹ (inv_ne_zero hscale.ne'))
  scale • ((SchwartzMap.compCLMOfContinuousLinearEquiv Real A) D.normalExtension)

private theorem rta_scratchScaledNormalExtension_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) :
    rta_scratchScaledNormalExtension D scale hscale xi =
      rta_scratchScaledNormalCoordinate D scale xi := by
  unfold rta_scratchScaledNormalExtension rta_scratchScaledNormalCoordinate
  dsimp
  rfl

/-- The shifted/dilated vertical cutoff, packaged as a temporal Schwartz map. -/
private noncomputable def rta_scratchVerticalProfile
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) : SchwartzMap Real Complex :=
  let root : Real := Real.sqrt scale
  let A : Real ≃L[Real] Real :=
    ContinuousLinearEquiv.smulLeft
      (Units.mk0 root⁻¹ (by
        dsimp only [root]
        exact inv_ne_zero (Real.sqrt_ne_zero'.mpr hscale)))
  ((SchwartzMap.compCLMOfContinuousLinearEquiv Complex A) beta).compSubConstCLM
    Complex (root * n)

private theorem rta_scratchVerticalProfile_apply
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (tau : Real) :
    rta_scratchVerticalProfile beta scale n hscale tau =
      beta ((Real.sqrt scale)⁻¹ * tau - n) := by
  unfold rta_scratchVerticalProfile
  dsimp
  change beta ((Real.sqrt scale)⁻¹ * (tau - Real.sqrt scale * n)) = _
  have hroot : Real.sqrt scale ≠ 0 := Real.sqrt_ne_zero'.mpr hscale
  field_simp [hroot]

/-- The smooth normal-coordinate radial factor used only underneath the
scaled amplitude.  It agrees with the literal norm factor on that support. -/
private noncomputable def rta_scratchSmoothNormalRadialFactor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    Euclidean 2 → Complex :=
  fun xi => D.radial
    ((Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale xi - n)

private theorem rta_scratchSmoothNormalRadialFactor_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (xi : Euclidean 2) :
    rta_scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
      ((Real.sqrt scale)⁻¹ * rta_scratchScaledNormalCoordinate D scale xi - n) := by
  simp only [rta_scratchSmoothNormalRadialFactor, rta_scratchScaledNormalExtension_apply]

private theorem rta_scratchSmoothNormalRadialFactor_eq_literal_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (xi : Euclidean 2)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    rta_scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
      ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := by
  rw [rta_scratchSmoothNormalRadialFactor_apply,
    rta_scratchScaledNormalCoordinate_eq_norm_of_amplitude_ne_zero D hscale xi hxi]

private theorem rta_scratchSmoothNormalRadialFactor_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    (rta_scratchSmoothNormalRadialFactor D scale hscale n).HasTemperateGrowth := by
  unfold rta_scratchSmoothNormalRadialFactor
  fun_prop

/-- A temporal Schwartz factor viewed on joint frequency space. -/
private noncomputable def rta_scratchJointVerticalFactor
    (m : SchwartzMap Real Complex) : JointWaveSpaceTime → Complex :=
  fun z => m z.snd

private theorem rta_scratchJointVerticalFactor_hasTemperateGrowth
    (m : SchwartzMap Real Complex) :
    (rta_scratchJointVerticalFactor m).HasTemperateGrowth := by
  change (m ∘ WithLp.sndL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact m.hasTemperateGrowth.comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- A spatial smooth-normal factor viewed on joint frequency space. -/
private noncomputable def rta_scratchJointNormalRadialFactor
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    JointWaveSpaceTime → Complex :=
  fun z => rta_scratchSmoothNormalRadialFactor D scale hscale n z.fst

private theorem rta_scratchJointNormalRadialFactor_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    (rta_scratchJointNormalRadialFactor D scale hscale n).HasTemperateGrowth := by
  change (rta_scratchSmoothNormalRadialFactor D scale hscale n ∘
    WithLp.fstL 2 Real (Euclidean 2) Real).HasTemperateGrowth
  exact (rta_scratchSmoothNormalRadialFactor_hasTemperateGrowth D scale hscale n).comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).hasTemperateGrowth

/-- The globally smooth corrected double-projection bracket.  On the scaled
amplitude support it agrees with the literal bracket containing `‖xi‖`. -/
private noncomputable def rta_scratchSmoothResidualBracket
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) : JointWaveSpaceTime → Complex :=
  fun z => 1 - ∑ n ∈ indices,
    (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale) z) ^ 2 *
      rta_scratchJointNormalRadialFactor D scale hscale n z

private theorem rta_scratchSmoothResidualBracket_hasTemperateGrowth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    (rta_scratchSmoothResidualBracket D scale hscale indices).HasTemperateGrowth := by
  unfold rta_scratchSmoothResidualBracket
  apply Function.HasTemperateGrowth.sub (Function.HasTemperateGrowth.const 1)
  apply Function.HasTemperateGrowth.sum
  intro n hn
  exact
    ((rta_scratchJointVerticalFactor_hasTemperateGrowth
      (rta_scratchVerticalProfile D.vertical scale n hscale)).pow 2).mul
      (rta_scratchJointNormalRadialFactor_hasTemperateGrowth D scale hscale n)

/-- The f-independent globally smooth joint residual multiplier. -/
private noncomputable def rta_scratchSmoothResidualProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) : SchwartzMap JointWaveSpaceTime Complex :=
  SchwartzMap.smulLeftCLM Complex
    (rta_scratchSmoothResidualBracket D scale hscale indices)
    (jointSchwartzModulatedAnnularProfile
      (rta_scratchScaledAmplitude D scale hscale) D.time
      (rta_scratchScaledNormalExtension D scale hscale))

private theorem rta_scratchSmoothResidualProfile_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real) :
    rta_scratchSmoothResidualProfile D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      rta_scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) *
        (D.amplitude (scale⁻¹ • xi) *
          FourierTransform.fourier (D.time : Real → Complex)
            (tau - rta_scratchScaledNormalCoordinate D scale xi)) := by
  unfold rta_scratchSmoothResidualProfile
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (rta_scratchSmoothResidualBracket_hasTemperateGrowth D scale hscale indices)]
  rw [jointSchwartzModulatedAnnularProfile_apply,
    rta_scratchScaledAmplitude_apply, rta_scratchScaledNormalExtension_apply]
  change rta_scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) •
      (D.amplitude (scale⁻¹ • xi) *
        FourierTransform.fourier (D.time : Real → Complex)
          (tau - rta_scratchScaledNormalCoordinate D scale xi)) = _
  rw [smul_eq_mul]

private theorem rta_scratchSmoothResidualBracket_eq_literal_of_amplitude_ne_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real)
    (hxi : D.amplitude (scale⁻¹ • xi) ≠ 0) :
    rta_scratchSmoothResidualBracket D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      1 - ∑ n ∈ indices,
        D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
          D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) := by
  unfold rta_scratchSmoothResidualBracket rta_scratchJointVerticalFactor
    rta_scratchJointNormalRadialFactor
  change 1 - ∑ n ∈ indices,
      rta_scratchVerticalProfile D.vertical scale n hscale tau ^ 2 *
        rta_scratchSmoothNormalRadialFactor D scale hscale n xi = _
  have hrad (n : Int) :
      rta_scratchSmoothNormalRadialFactor D scale hscale n xi = D.radial
        ((Real.sqrt scale)⁻¹ * ‖xi‖ - n) :=
    rta_scratchSmoothNormalRadialFactor_eq_literal_of_amplitude_ne_zero
      D scale hscale n xi hxi
  simp_rw [rta_scratchVerticalProfile_apply, hrad]

private theorem rta_scratchSmoothResidualProfile_eq_literal_multiplier
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (xi : Euclidean 2) (tau : Real) :
    rta_scratchSmoothResidualProfile D scale hscale indices (WithLp.toLp 2 (xi, tau)) =
      D.amplitude (scale⁻¹ • xi) *
        (1 - ∑ n ∈ indices,
          D.vertical ((Real.sqrt scale)⁻¹ * tau - n) ^ 2 *
            D.radial ((Real.sqrt scale)⁻¹ * ‖xi‖ - n)) *
        FourierTransform.fourier (D.time : Real → Complex)
          (tau - rta_scratchScaledNormalCoordinate D scale xi) := by
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [rta_scratchSmoothResidualProfile_apply]
    simp [hxi]
  · rw [rta_scratchSmoothResidualProfile_apply,
      rta_scratchSmoothResidualBracket_eq_literal_of_amplitude_ne_zero
        D scale hscale indices xi tau hxi]
    ring

/-- The built-in normal guard.  It equals one on a strict sub-tube and is
supported inside the cancellation tube, using only the supplied radial
cutoff's `9/4`--`11/4` slack. -/
private noncomputable def rta_scratchNormalGuard
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime) : Complex :=
  D.radial (3 * ((Real.sqrt scale)⁻¹ *
    (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)))

private theorem rta_scratchNormalGuard_ne_zero_imp_normal_near
    (D : MSSRadialTimeCutoffs) {scale : Real} (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hguard : rta_scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) ≠ 0) :
    |tau - rta_scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale := by
  unfold rta_scratchNormalGuard at hguard
  simp only [WithLp.toLp_fst, WithLp.toLp_snd,
    rta_scratchScaledNormalExtension_apply] at hguard
  have hsupport := D.radial_support
    (3 * ((Real.sqrt scale)⁻¹ *
      (tau - rta_scratchScaledNormalCoordinate D scale xi))) hguard
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  have hscaled : (Real.sqrt scale)⁻¹ *
      |tau - rta_scratchScaledNormalCoordinate D scale xi| < 11 / 12 := by
    rw [abs_mul, abs_of_nonneg (by norm_num : (0 : Real) ≤ 3),
      abs_mul, abs_of_pos (inv_pos.mpr hroot)] at hsupport
    nlinarith
  have hltone : (Real.sqrt scale)⁻¹ *
      |tau - rta_scratchScaledNormalCoordinate D scale xi| < 1 :=
    hscaled.trans (by norm_num)
  rw [show (Real.sqrt scale)⁻¹ *
      |tau - rta_scratchScaledNormalCoordinate D scale xi| =
        |tau - rta_scratchScaledNormalCoordinate D scale xi| / Real.sqrt scale by ring] at hltone
  simpa using (div_lt_iff₀ hroot).mp hltone

private theorem rta_scratchNormalGuard_mul_scratchSmoothResidualProfile_eq_zero
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    rta_scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) *
      rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) = 0 := by
  by_cases hguard : rta_scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau)) = 0
  · simp [hguard]
  have hnear := rta_scratchNormalGuard_ne_zero_imp_normal_near D hscale xi tau hguard
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [rta_scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [hxi]
  · have hbracket := rta_scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
      D hscale xi tau hxi hnear
    rw [rta_scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [rta_scratchRadialTimeResidualBracket] at hbracket
    simp [hbracket]

private theorem rta_scratchSmoothResidualProfile_eq_one_sub_guard_mul
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
      (WithLp.toLp 2 (xi, tau)) =
      (1 - rta_scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau))) *
        rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
          (WithLp.toLp 2 (xi, tau)) := by
  have hzero := rta_scratchNormalGuard_mul_scratchSmoothResidualProfile_eq_zero
    D scale hscale xi tau
  calc
    rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) =
      1 * rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
        (WithLp.toLp 2 (xi, tau)) := by ring
    _ = (1 - rta_scratchNormalGuard D scale hscale (WithLp.toLp 2 (xi, tau))) *
        rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
          (WithLp.toLp 2 (xi, tau)) := by
      rw [sub_mul, one_mul, hzero, sub_zero]

/-- Every positive-order derivative of the scaled smooth normal extension is
uniformly bounded for `scale ≥ 1`.  This is the scale calculus behind the
normal-coordinate replacement; it is derived directly from the fixed
Schwartz cutoff data. -/
private theorem rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ xi : Euclidean 2,
        ‖iteratedFDeriv Real k
          (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := D.normalExtension.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone xi
  have hfun :
      (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) =
        fun y : Euclidean 2 => scale • D.normalExtension (scale⁻¹ • y) := by
    funext y
    rw [rta_scratchScaledNormalExtension_apply]
    rfl
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) := by
    exact (D.normalExtension.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y)) xi =
        scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.normalExtension : Euclidean 2 → Real) (scale⁻¹ • xi) := by
    simpa using congrFun
      (iteratedFDeriv_comp_const_smul scale⁻¹
        (D.normalExtension.smooth (k : ℕ∞))) xi
  rw [hfun]
  change ‖iteratedFDeriv Real k
      (scale • (fun y : Euclidean 2 => D.normalExtension (scale⁻¹ • y))) xi‖ ≤ C
  rw [iteratedFDeriv_const_smul_apply hsmooth.contDiffAt, hchain,
    norm_smul, norm_smul]
  simp only [Real.norm_eq_abs, abs_of_pos hscale,
    abs_pow, abs_of_nonneg (inv_nonneg.mpr hscale.le)]
  have hpow : scale * scale⁻¹ ^ k ≤ 1 := by
    have hinv : scale⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hscaleone
    have hinv0 : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
    have hinvpow : scale⁻¹ ^ (k - 1) ≤ 1 :=
      pow_le_one₀ hinv0 hinv
    have hk' : k = (k - 1) + 1 := (Nat.sub_add_cancel hk).symm
    calc
      scale * scale⁻¹ ^ k = scale * scale⁻¹ ^ ((k - 1) + 1) := by
        rw [congrArg (fun j : Nat => scale⁻¹ ^ j) hk']
      _ = scale * (scale⁻¹ ^ (k - 1) * scale⁻¹) := by rw [pow_succ]
      _ = (scale * scale⁻¹) * scale⁻¹ ^ (k - 1) := by ring
      _ = scale⁻¹ ^ (k - 1) := by field_simp [hscale.ne']
      _ ≤ 1 := hinvpow
  calc
    scale * (scale⁻¹ ^ k *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖) =
      (scale * scale⁻¹ ^ k) *
        ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
          (scale⁻¹ • xi)‖ := by ring
    _ ≤ 1 * ‖iteratedFDeriv Real k (D.normalExtension : Euclidean 2 → Real)
      (scale⁻¹ • xi)‖ := by
      gcongr
    _ ≤ C := by
      simpa using hC (scale⁻¹ • xi)

/-- The smooth normal displacement on joint frequency space. -/
private noncomputable def rta_scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    JointWaveSpaceTime → Real :=
  fun z => z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst

private theorem rta_scratchJointNormalDifference_apply
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real) :
    rta_scratchJointNormalDifference D scale hscale (WithLp.toLp 2 (xi, tau)) =
      tau - rta_scratchScaledNormalCoordinate D scale xi := by
  simp [rta_scratchJointNormalDifference, rta_scratchScaledNormalExtension_apply]

private theorem rta_continuous_scratchJointNormalDifference
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    Continuous (rta_scratchJointNormalDifference D scale hscale) := by
  unfold rta_scratchJointNormalDifference
  exact (WithLp.sndL 2 Real (Euclidean 2) Real).continuous.sub
    ((rta_scratchScaledNormalExtension D scale hscale).continuous.comp
      (WithLp.fstL 2 Real (Euclidean 2) Real).continuous)

private theorem rta_isOpen_scratchJointNormalTube
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) :
    IsOpen {z : JointWaveSpaceTime |
      |rta_scratchJointNormalDifference D scale hscale z| < Real.sqrt scale} := by
  exact isOpen_lt
    (continuous_abs.comp (rta_continuous_scratchJointNormalDifference D scale hscale))
    continuous_const

private theorem rta_scratchSmoothResidualProfile_eq_zero_of_normal_near
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (xi : Euclidean 2) (tau : Real)
    (hnear : |tau - rta_scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale)
      (WithLp.toLp 2 (xi, tau)) = 0 := by
  by_cases hxi : D.amplitude (scale⁻¹ • xi) = 0
  · rw [rta_scratchSmoothResidualProfile_eq_literal_multiplier]
    simp [hxi]
  · have hbracket := rta_scratchRadialTimeResidualBracket_eq_zero_of_amplitude_ne_zero_of_near
      D hscale xi tau hxi hnear
    rw [rta_scratchSmoothResidualProfile_eq_literal_multiplier]
    simpa [rta_scratchRadialTimeResidualBracket] using
      congrArg (fun q : Complex =>
        D.amplitude (scale⁻¹ • xi) * q *
          FourierTransform.fourier (D.time : Real → Complex)
            (tau - rta_scratchScaledNormalCoordinate D scale xi)) hbracket

private theorem rta_scratchSmoothResidualProfile_eq_zero_on_normalTube
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime)
    (hz : |rta_scratchJointNormalDifference D scale hscale z| < Real.sqrt scale) :
    rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z = 0 := by
  have hpair : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hpair]
  apply rta_scratchSmoothResidualProfile_eq_zero_of_normal_near D scale hscale z.fst z.snd
  simpa [rta_scratchJointNormalDifference, rta_scratchScaledNormalExtension_apply] using hz

private theorem rta_iteratedFDeriv_scratchSmoothResidualProfile_eq_zero_of_normal_near
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (xi : Euclidean 2) (tau : Real)
    (hnear : |tau - rta_scratchScaledNormalCoordinate D scale xi| < Real.sqrt scale) :
    iteratedFDeriv Real k
      (rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) :
        JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 (xi, tau)) = 0 := by
  let U : Set JointWaveSpaceTime := {z |
    |rta_scratchJointNormalDifference D scale hscale z| < Real.sqrt scale}
  let z0 : JointWaveSpaceTime := WithLp.toLp 2 (xi, tau)
  have hUopen : IsOpen U := rta_isOpen_scratchJointNormalTube D scale hscale
  have hz0 : z0 ∈ U := by
    simpa [U, z0, rta_scratchJointNormalDifference_apply] using hnear
  have hEq : ∀ z ∈ U,
      rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z = 0 := by
    intro z hz
    exact rta_scratchSmoothResidualProfile_eq_zero_on_normalTube D scale hscale z hz
  have hlocal :
      (rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) :
        JointWaveSpaceTime → Complex) =ᶠ[𝓝 z0] 0 :=
    by
      filter_upwards [hUopen.mem_nhds hz0] with z hz
      exact hEq z hz
  have hderiv := (hlocal.iteratedFDeriv Real k).self_of_nhds
  simpa [z0] using hderiv
/-- Exact `L¹` scaling for every derivative of the compact spatial amplitude.
This records the only spatial-volume loss in the residual multiplier proof. -/
private theorem rta_integral_norm_iteratedFDeriv_scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) :
    (∫ xi : Euclidean 2,
      ‖iteratedFDeriv Real k
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) =
      scale⁻¹ ^ k * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ eta : Euclidean 2,
          ‖iteratedFDeriv Real k
            (D.amplitude : Euclidean 2 → Complex) eta‖ := by
  have hfun :
      (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) =
        fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y) := by
    funext y
    exact rta_scratchScaledAmplitude_apply D scale hscale y
  have hsmooth : ContDiff Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) := by
    exact (D.amplitude.smooth (k : ℕ∞)).comp
      (contDiff_id.const_smul scale⁻¹)
  have hchain : iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) =
        fun xi => scale⁻¹ ^ k • iteratedFDeriv Real k
          (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi) := by
    exact iteratedFDeriv_comp_const_smul scale⁻¹
      (D.amplitude.smooth (k : ℕ∞))
  rw [hfun]
  change (∫ xi : Euclidean 2,
    ‖iteratedFDeriv Real k
      (fun y : Euclidean 2 => D.amplitude (scale⁻¹ • y)) xi‖) = _
  simp_rw [hchain]
  rw [show (fun xi : Euclidean 2 =>
      ‖scale⁻¹ ^ k • iteratedFDeriv Real k
        (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi)‖) =
      fun xi => scale⁻¹ ^ k * ‖iteratedFDeriv Real k
        (D.amplitude : Euclidean 2 → Complex) (scale⁻¹ • xi)‖ by
        funext xi
        rw [norm_smul, Real.norm_eq_abs,
          abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hscale.le) k)],
    integral_const_mul]
  rw [Auto.Spherical.SurfaceMeasureDecay.integral_norm_comp_smul_eq 2
    (iteratedFDeriv Real k (D.amplitude : Euclidean 2 → Complex))
    (inv_pos.mpr hscale)]
  ring

/-- Positive-order derivatives of the smooth normal radial argument have the
expected `sqrt scale` loss and no dependence on the translated label. -/
private theorem rta_iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (n : Int) (k : Nat) (hk : 1 ≤ k) (xi : Euclidean 2) :
    iteratedFDeriv Real k
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n) xi =
      (Real.sqrt scale)⁻¹ • iteratedFDeriv Real k
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi := by
  have hrho : ContDiff Real k
      (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) :=
    (rta_scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)
  have hscaled : ContDiffAt Real k
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ • rta_scratchScaledNormalExtension D scale hscale y) xi :=
    (hrho.const_smul (Real.sqrt scale)⁻¹).contDiffAt
  have hconst : ContDiffAt Real k (fun _ : Euclidean 2 => (n : Real)) xi :=
    contDiffAt_const
  rw [show (fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n) =
      (fun y : Euclidean 2 =>
        (Real.sqrt scale)⁻¹ • rta_scratchScaledNormalExtension D scale hscale y) -
        fun _ : Euclidean 2 => (n : Real) by
      funext y
      rfl,
    iteratedFDeriv_sub_apply hscaled hconst,
    ]
  change iteratedFDeriv Real k
      ((Real.sqrt scale)⁻¹ •
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real)) xi -
      iteratedFDeriv Real k (fun _ : Euclidean 2 => (n : Real)) xi = _
  rw [iteratedFDeriv_const_smul_apply hrho.contDiffAt]
  rw [iteratedFDeriv_const_of_ne (Nat.ne_of_gt (Nat.zero_lt_of_lt hk)) (n : Real)]
  simp

/-- Every fixed derivative order of the smooth normal-coordinate radial
factor is bounded uniformly in the scale and translated radial label.  This
is a finite-order consequence of the supplied Schwartz cutoffs, rather than
a new regularity hypothesis. -/
private theorem rta_exists_scratchSmoothNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (xi : Euclidean 2),
        ‖iteratedFDeriv Real k
          (rta_scratchSmoothNormalRadialFactor D scale hscale n) xi‖ ≤ C := by
  let Cr : Nat → Real := fun i => (D.radial.decay 0 i).choose
  have hCr_pos (i : Nat) : 0 < Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.1
  have hCr (i : Nat) (s : Real) :
      ‖iteratedFDeriv Real i (D.radial : Real → Complex) s‖ ≤ Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.2 s
  let Cg : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCg_nonneg : 0 ≤ Cg := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_pos i |>.le
  have hCg_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ Cg := by
    apply (Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_pos j |>.le))
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let Crho : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCrho_nonneg {i : Nat} (hi : 1 ≤ i) : 0 ≤ Crho i := by
    simp only [Crho, dif_pos hi]
    exact (rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.1
  have hCrho {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (xi : Euclidean 2) :
      ‖iteratedFDeriv Real i
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
        Crho i := by
    simpa only [Crho, dif_pos hi] using
      (rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone xi
  let Cf : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Crho i)
  have hCf_nonneg : 0 ≤ Cf := by
    apply Finset.sum_nonneg
    intro i hi
    exact le_trans zero_le_one (le_max_left _ _)
  have hCf_one : 1 ≤ Cf := by
    calc
      1 ≤ max 1 (Crho 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Crho i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Crho i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCf_bound {i : Nat} (hi : i ≤ k) : Crho i ≤ Cf := by
    calc
      Crho i ≤ max 1 (Crho i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Crho j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Crho j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cg * Cf ^ k, by positivity, ?_⟩
  intro scale hscale hscaleone n xi
  let q : Euclidean 2 → Real := fun y =>
    (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n
  have hq : ContDiff Real (k : ℕ∞) q := by
    exact (((rta_scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)).const_smul
      (Real.sqrt scale)⁻¹).sub contDiff_const
  have hq_eq : rta_scratchSmoothNormalRadialFactor D scale hscale n = D.radial ∘ q := by
    funext y
    simp only [rta_scratchSmoothNormalRadialFactor, q, Function.comp_apply]
  rw [hq_eq]
  apply norm_iteratedFDeriv_comp_le (D.radial.smooth (k : ℕ∞)) hq
    (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) xi
  · intro i hi
    exact (hCr i (q xi)).trans (hCg_bound hi)
  · intro i hi1 hi
    have harg := rta_iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
      D scale hscale n i hi1 xi
    change ‖iteratedFDeriv Real i q xi‖ ≤ Cf ^ i
    rw [show q = fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n by rfl,
      harg, norm_smul, Real.norm_eq_abs]
    have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
    rw [abs_of_pos (inv_pos.mpr hroot)]
    calc
      (Real.sqrt scale)⁻¹ *
          ‖iteratedFDeriv Real i
            (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
          1 * Crho i := by
        gcongr
        · exact inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone)
        · exact hCrho hi1 scale hscale hscaleone xi
      _ ≤ Cf := by simpa using hCf_bound hi
      _ ≤ Cf ^ i := le_self_pow₀ hCf_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))

/-- A fixed Schwartz temporal profile has arbitrary scale decay outside a
normal tube of width `sqrt scale`.  The weighted form avoids introducing any
non-Schwartz reciprocal envelope and is the basic tail estimate used for
the corrected residual multiplier. -/
private theorem rta_exists_weighted_normal_tail_iteratedFDeriv_bound
    (h : SchwartzMap Real Complex) (i N K : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale u : Real), 1 ≤ scale →
      Real.sqrt scale ≤ |u| →
      scale ^ N * (1 + u ^ 2) ^ K *
        ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := h.decay (2 * (N + K)) i
  refine ⟨(2 : Real) ^ K * C, mul_nonneg (pow_nonneg (by norm_num) _) hCpos.le, ?_⟩
  intro scale u hscale hu
  have hscale0 : 0 ≤ scale := zero_le_one.trans hscale
  have hroot : 1 ≤ Real.sqrt scale := Real.one_le_sqrt.mpr hscale
  have huone : 1 ≤ |u| := hroot.trans hu
  have huabs2 : 1 ≤ |u| ^ 2 := one_le_pow₀ huone
  have hu2plain : 1 ≤ u ^ 2 := by simpa [sq_abs] using huabs2
  have hu2 : 1 + u ^ 2 ≤ 2 * |u| ^ 2 := by
    rw [sq_abs]
    nlinarith
  have hscale_pow : scale ^ N ≤ |u| ^ (2 * N) := by
    calc
      scale ^ N = (Real.sqrt scale ^ 2) ^ N := by rw [Real.sq_sqrt hscale0]
      _ = (Real.sqrt scale) ^ (2 * N) := by rw [pow_mul]
      _ ≤ |u| ^ (2 * N) := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
  have hu2pow : (1 + u ^ 2) ^ K ≤ (2 : Real) ^ K * |u| ^ (2 * K) := by
    calc
      (1 + u ^ 2) ^ K ≤ (2 * |u| ^ 2) ^ K := by
        exact pow_le_pow_left₀ (by positivity) hu2 K
      _ = (2 : Real) ^ K * |u| ^ (2 * K) := by
        rw [mul_pow, pow_mul]
  have htail : |u| ^ (2 * (N + K)) *
      ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤ C := by
    simpa only [Real.norm_eq_abs] using hC u
  calc
    scale ^ N * (1 + u ^ 2) ^ K *
        ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
        (|u| ^ (2 * N) * ((2 : Real) ^ K * |u| ^ (2 * K))) *
          ‖iteratedFDeriv Real i (h : Real → Complex) u‖ := by
      gcongr
    _ = (2 : Real) ^ K *
        (|u| ^ (2 * (N + K)) *
          ‖iteratedFDeriv Real i (h : Real → Complex) u‖) := by
      ring_nf
    _ ≤ (2 : Real) ^ K * C := by
      gcongr
/-- The `i`-th ordinary derivative of a one-dimensional Schwartz profile,
kept as a Schwartz profile itself. -/
private noncomputable def rta_scratchTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i : Nat) : SchwartzMap Real Complex :=
  (SchwartzMap.derivCLM Complex Complex)^[i] h

private theorem rta_scratchTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i : Nat) (u : Real) :
    rta_scratchTemporalDerivativeProfile h i u =
      iteratedDeriv i (h : Real → Complex) u := by
  induction i generalizing u with
  | zero => simp [rta_scratchTemporalDerivativeProfile, iteratedDeriv_zero]
  | succ i ih =>
      rw [rta_scratchTemporalDerivativeProfile, Function.iterate_succ_apply',
        SchwartzMap.derivCLM_apply]
      change deriv (fun v : Real => rta_scratchTemporalDerivativeProfile h i v) u = _
      rw [show (fun v : Real => rta_scratchTemporalDerivativeProfile h i v) =
        iteratedDeriv i (h : Real → Complex) by
          funext v
          exact ih v,
        ← iteratedDeriv_succ]

/-- A polynomially weighted temporal derivative profile.  It is still
Schwartz and will provide an integrable envelope after normal shearing. -/
private noncomputable def rta_scratchWeightedTemporalDerivativeProfile
    (h : SchwartzMap Real Complex) (i N : Nat) : SchwartzMap Real Complex :=
  SchwartzMap.smulLeftCLM Complex (fun s : Real => (1 + s ^ 2) ^ N)
    (rta_scratchTemporalDerivativeProfile h i)

private theorem rta_scratchWeightedTemporalDerivativeProfile_apply
    (h : SchwartzMap Real Complex) (i N : Nat) (u : Real) :
    rta_scratchWeightedTemporalDerivativeProfile h i N u =
      ((1 + u ^ 2) ^ N : Real) • iteratedDeriv i (h : Real → Complex) u := by
  unfold rta_scratchWeightedTemporalDerivativeProfile
  rw [SchwartzMap.smulLeftCLM_apply
    (show (fun s : Real => (1 + s ^ 2) ^ N).HasTemperateGrowth by fun_prop)]
  change ((1 + u ^ 2) ^ N : Real) • rta_scratchTemporalDerivativeProfile h i u = _
  rw [rta_scratchTemporalDerivativeProfile_apply]

/-- Outside the normal tube, a fixed polynomially weighted Schwartz
derivative dominates the unweighted derivative with the desired scale gain. -/
private theorem rta_scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
    (h : SchwartzMap Real Complex) (i N : Nat) (scale u : Real)
    (hscale : 0 ≤ scale) (hu : Real.sqrt scale ≤ |u|) :
    scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) u‖ ≤
      ‖rta_scratchWeightedTemporalDerivativeProfile h i N u‖ := by
  rw [rta_scratchWeightedTemporalDerivativeProfile_apply, norm_smul,
    Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (by positivity) _),
    norm_iteratedFDeriv_eq_norm_iteratedDeriv]
  have hscale_le_u2 : scale ≤ u ^ 2 := by
    calc
      scale = Real.sqrt scale ^ 2 := by rw [Real.sq_sqrt hscale]
      _ ≤ |u| ^ 2 := by
        exact pow_le_pow_left₀ (Real.sqrt_nonneg _) hu _
      _ = u ^ 2 := by rw [sq_abs]
  have hscale_le : scale ≤ 1 + u ^ 2 := hscale_le_u2.trans (by linarith)
  have hpow : scale ^ N ≤ (1 + u ^ 2) ^ N := by
    exact pow_le_pow_left₀ hscale hscale_le N
  gcongr

private theorem rta_norm_iteratedFDeriv_continuousLinearMap_le_one
    (L : JointWaveSpaceTime →L[Real] Real) (hL : ‖L‖ ≤ 1)
    (k : Nat) (hk : 1 ≤ k) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k (L : JointWaveSpaceTime → Real) z‖ ≤ 1 := by
  obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, (Nat.sub_add_cancel hk).symm⟩
  rw [← norm_iteratedFDeriv_fderiv]
  have hf : fderiv Real (L : JointWaveSpaceTime → Real) = fun _ => L := by
    funext w
    exact L.fderiv
  rw [hf]
  cases j with
  | zero =>
      simpa [norm_iteratedFDeriv_zero] using hL
  | succ j =>
      rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero j) L]
      simp

private theorem rta_scratch_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem rta_scratch_joint_sndL_norm_le_one :
    ‖WithLp.sndL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_snd_le (p := 2) (Euclidean 2) z

private theorem rta_norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime =>
        rta_scratchScaledNormalExtension D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((rta_scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)) z
    le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact rta_scratch_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) z.fst‖ := by
      simp [L]

/-- The full joint normal difference has uniformly bounded positive-order
derivatives.  The temporal coordinate contributes only a norm-one linear
map; all other bounds come from the supplied smooth normal extension. -/
private theorem rta_exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) (hk : 1 ≤ k) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (rta_scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D k hk
  refine ⟨1 + C, by linarith, ?_⟩
  intro scale hscale hscaleone z
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := rta_scratchScaledNormalExtension D scale hscale
  have hsnd : ContDiffAt Real k (fun w : JointWaveSpaceTime => Ls w) z := by
    fun_prop
  have hrhofst : ContDiffAt Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z := by
    exact ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)).contDiffAt
  have hrepr : (rta_scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - rta_scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        rta_scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr,
    show (fun w : JointWaveSpaceTime => Ls w - rho (Lf w)) =
      (fun w => Ls w) - (fun w => rho (Lf w)) by rfl,
    iteratedFDeriv_sub_apply hsnd hrhofst]
  calc
    ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z -
        iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ ≤
        ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => Ls w) z‖ +
          ‖iteratedFDeriv Real k (fun w : JointWaveSpaceTime => rho (Lf w)) z‖ :=
      norm_sub_le _ _
    _ ≤ 1 + C := by
      gcongr
      · exact rta_norm_iteratedFDeriv_continuousLinearMap_le_one Ls
          (by simpa [Ls] using rta_scratch_joint_sndL_norm_le_one) k hk z
      · exact (rta_norm_iteratedFDeriv_scratchScaledNormalExtension_comp_fst_le
          D scale hscale k z).trans (hC scale hscale hscaleone z.fst)

private theorem rta_scratchJointNormalDifference_contDiff
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (k : Nat) :
    ContDiff Real (k : ℕ∞)
      (rta_scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) := by
  let Ls : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  let rho : SchwartzMap (Euclidean 2) Real := rta_scratchScaledNormalExtension D scale hscale
  have hrepr : (rta_scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) =
      fun w => Ls w - rho (Lf w) := by
    funext w
    change w.snd - rta_scratchScaledNormalExtension D scale hscale w.fst =
      WithLp.sndL 2 Real (Euclidean 2) Real w -
        rta_scratchScaledNormalExtension D scale hscale
          (WithLp.fstL 2 Real (Euclidean 2) Real w)
    rfl
  rw [hrepr]
  exact (Ls.contDiff.sub ((rho.smooth (k : ℕ∞)).comp_continuousLinearMap (g := Lf)))
/-- The `k`-th derivative of a temporal Schwartz profile composed with the
smooth joint normal coordinate has a finite weighted-Schwartz envelope on the
normal-gap region.  The constant is uniform in the scale; the finite sum is
intentional, retaining the individual temporal derivative envelopes needed
for the eventual `L¹` integration. -/
private theorem rta_exists_scale_pow_mul_norm_iteratedFDeriv_sheared_time_le_sum_weighted_profiles
    (D : MSSRadialTimeCutoffs) (h : SchwartzMap Real Complex) (k N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        Real.sqrt scale ≤ |rta_scratchJointNormalDifference D scale hscale z| →
        scale ^ N * ‖iteratedFDeriv Real k
          (fun w : JointWaveSpaceTime =>
            h (rta_scratchJointNormalDifference D scale hscale w)) z‖ ≤
          C * ∑ i ∈ Finset.range (k + 1),
            ‖rta_scratchWeightedTemporalDerivativeProfile h i N
              (rta_scratchJointNormalDifference D scale hscale z)‖ := by
  let Cq : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (rta_exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCq {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (rta_scratchJointNormalDifference D scale hscale : JointWaveSpaceTime → Real) z‖ ≤ Cq i := by
    simpa only [Cq, dif_pos hi] using
      (rta_exists_scratchJointNormalDifference_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone z
  let Cinner : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Cq i)
  have hCinner_one : 1 ≤ Cinner := by
    calc
      1 ≤ max 1 (Cq 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Cq i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Cq i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCinner {i : Nat} (hi : i ≤ k) : Cq i ≤ Cinner := by
    calc
      Cq i ≤ max 1 (Cq i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Cq j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Cq j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cinner ^ k,
    mul_nonneg (by positivity) (pow_nonneg (le_trans zero_le_one hCinner_one) _), ?_⟩
  intro scale hscale hscaleone z hgap
  let q : JointWaveSpaceTime → Real := rta_scratchJointNormalDifference D scale hscale
  let S : Real := ∑ i ∈ Finset.range (k + 1),
    ‖rta_scratchWeightedTemporalDerivativeProfile h i N (q z)‖
  have hSnonneg : 0 ≤ S := by
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hq : ContDiff Real (k : ℕ∞) q :=
    rta_scratchJointNormalDifference_contDiff D scale hscale k
  have houter {i : Nat} (hi : i ≤ k) :
      ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖ ≤ scale⁻¹ ^ N * S := by
    have htime := rta_scale_pow_mul_norm_iteratedFDeriv_time_le_weighted_profile
      h i N scale (q z) (zero_le_one.trans hscaleone) (by simpa [q] using hgap)
    have hscale_ne : scale ≠ 0 := hscale.ne'
    have hterm :
        ‖rta_scratchWeightedTemporalDerivativeProfile h i N (q z)‖ ≤ S := by
      exact Finset.single_le_sum (s := Finset.range (k + 1))
        (f := fun j => ‖rta_scratchWeightedTemporalDerivativeProfile h j N (q z)‖)
        (fun j hj => norm_nonneg _)
        (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
    calc
      ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖ =
          scale⁻¹ ^ N *
            (scale ^ N * ‖iteratedFDeriv Real i (h : Real → Complex) (q z)‖) := by
        rw [inv_pow]
        field_simp [pow_ne_zero N hscale_ne]
      _ ≤ scale⁻¹ ^ N *
          ‖rta_scratchWeightedTemporalDerivativeProfile h i N (q z)‖ := by
        exact mul_le_mul_of_nonneg_left htime
          (pow_nonneg (inv_nonneg.mpr hscale.le) _)
      _ ≤ scale⁻¹ ^ N * S := by
        exact mul_le_mul_of_nonneg_left hterm
          (pow_nonneg (inv_nonneg.mpr hscale.le) _)
  have hinner {i : Nat} (hi1 : 1 ≤ i) (hi : i ≤ k) :
      ‖iteratedFDeriv Real i q z‖ ≤ Cinner ^ i := by
    calc
      ‖iteratedFDeriv Real i q z‖ ≤ Cq i := hCq hi1 scale hscale hscaleone z
      _ ≤ Cinner := hCinner hi
      _ ≤ Cinner ^ i :=
        le_self_pow₀ hCinner_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))
  have hchain :
      ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤
        (k.factorial : Real) * (scale⁻¹ ^ N * S) * Cinner ^ k := by
    apply norm_iteratedFDeriv_comp_le (h.smooth (k : ℕ∞)) hq
      (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) z
    · intro i hi
      exact houter hi
    · intro i hi1 hi
      exact hinner hi1 hi
  change scale ^ N * ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤ _
  calc
    scale ^ N * ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ q) z‖ ≤
        scale ^ N * ((k.factorial : Real) * (scale⁻¹ ^ N * S) * Cinner ^ k) := by
      gcongr
    _ = ((k.factorial : Real) * Cinner ^ k) * S := by
      rw [inv_pow]
      field_simp [pow_ne_zero N hscale.ne']
    _ = ((k.factorial : Real) * Cinner ^ k) *
        ∑ i ∈ Finset.range (k + 1),
          ‖rta_scratchWeightedTemporalDerivativeProfile h i N (q z)‖ := by rfl

/-- Exact scale/translation derivative formula for the vertical profile. -/
private theorem rta_iteratedFDeriv_scratchVerticalProfile_eq
    (beta : SchwartzMap Real Complex) (scale : Real) (n : Int)
    (hscale : 0 < scale) (k : Nat) (tau : Real) :
    iteratedFDeriv Real k
      (rta_scratchVerticalProfile beta scale n hscale : Real → Complex) tau =
      (Real.sqrt scale)⁻¹ ^ k • iteratedFDeriv Real k
        (beta : Real → Complex) ((Real.sqrt scale)⁻¹ * tau - n) := by
  let root : Real := Real.sqrt scale
  let a : Real := root⁻¹
  let c : Real := root * n
  have hroot : root ≠ 0 := by
    exact Real.sqrt_ne_zero'.mpr hscale
  have hfun : (rta_scratchVerticalProfile beta scale n hscale : Real → Complex) =
      fun t : Real => (fun y : Real => beta (a • y)) (t - c) := by
    funext t
    rw [rta_scratchVerticalProfile_apply]
    change beta ((Real.sqrt scale)⁻¹ * t - n) = beta (a * (t - c))
    dsimp only [a, c, root]
    field_simp [hroot]
  rw [hfun]
  have hsub :
      iteratedFDeriv Real k
        (fun t : Real => (fun y : Real => beta (a • y)) (t - c)) tau =
      iteratedFDeriv Real k (fun y : Real => beta (a • y)) (tau - c) := by
    simpa using (iteratedFDeriv_comp_sub (𝕜 := Real)
      (f := fun y : Real => beta (a • y)) k c tau)
  rw [hsub]
  rw [iteratedFDeriv_comp_const_smul a (beta.smooth (k : ℕ∞))]
  simp only [smul_eq_mul, a, c, root]
  congr 1
  field_simp [hroot]

/-- Each fixed vertical derivative is uniformly bounded once `scale ≥ 1`. -/
private theorem rta_exists_scratchVerticalProfile_iteratedFDeriv_uniform_bound
    (beta : SchwartzMap Real Complex) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (tau : Real),
        ‖iteratedFDeriv Real k
          (rta_scratchVerticalProfile beta scale n hscale : Real → Complex) tau‖ ≤ C := by
  obtain ⟨C, hCpos, hC⟩ := beta.decay 0 k
  refine ⟨C, hCpos.le, ?_⟩
  intro scale hscale hscaleone n tau
  rw [rta_iteratedFDeriv_scratchVerticalProfile_eq]
  rw [norm_smul, Real.norm_eq_abs]
  have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
  rw [abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hroot.le) k)]
  calc
    (Real.sqrt scale)⁻¹ ^ k *
        ‖iteratedFDeriv Real k (beta : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ ≤
      1 * ‖iteratedFDeriv Real k (beta : Real → Complex)
          ((Real.sqrt scale)⁻¹ * tau - n)‖ := by
        gcongr
        exact pow_le_one₀ (inv_nonneg.mpr hroot.le)
          (inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone))
    _ ≤ C := by simpa using hC ((Real.sqrt scale)⁻¹ * tau - n)

/-- Coordinate projection does not enlarge a joint iterated derivative. -/
private theorem rta_scratch_norm_iteratedFDeriv_joint_snd_le
    (h : SchwartzMap Real Complex)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.sndL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) z.snd‖ := by
  let L : JointWaveSpaceTime →L[Real] Real :=
    WithLp.sndL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_snd_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k ((h : Real → Complex) ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖
  rw [L.iteratedFDeriv_comp_right (h.smooth (⊤ : ℕ∞)) z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k (h : Real → Complex) (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k (h : Real → Complex) (L z)‖ := by simp

/-- Uniform joint derivative bound for each vertical factor. -/
private theorem rta_exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound
    (beta : SchwartzMap Real Complex) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (z : JointWaveSpaceTime),
        ‖iteratedFDeriv Real k
          (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile beta scale n hscale)) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    rta_exists_scratchVerticalProfile_iteratedFDeriv_uniform_bound beta k
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale hscaleone n z
  exact (rta_scratch_norm_iteratedFDeriv_joint_snd_le
    (rta_scratchVerticalProfile beta scale n hscale) k z).trans
    (hC scale hscale hscaleone n z.snd)

/-- Coordinate projection does not enlarge a spatial factor's joint derivatives. -/
private theorem rta_scratch_norm_iteratedFDeriv_joint_fst_le
    (h : Euclidean 2 → Complex) (hsmooth : ContDiff Real (⊤ : ℕ∞) h)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
        (fun w : JointWaveSpaceTime => h (WithLp.fstL 2 Real (Euclidean 2) Real w)) z‖ ≤
      ‖iteratedFDeriv Real k h z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  have hL : ‖L‖ ≤ 1 := by
    refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
    intro w
    simpa [L] using WithLp.norm_fst_le (p := 2) (Euclidean 2) w
  change ‖iteratedFDeriv Real k (h ∘ L) z‖ ≤
    ‖iteratedFDeriv Real k h (L z)‖
  rw [L.iteratedFDeriv_comp_right hsmooth z (by exact_mod_cast le_top)]
  calc
    ‖(iteratedFDeriv Real k h (L z)).compContinuousLinearMap
        (fun _ => L)‖ ≤
      ‖iteratedFDeriv Real k h (L z)‖ * ∏ _ : Fin k, ‖L‖ :=
        ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k h (L z)‖ * ∏ _ : Fin k, (1 : Real) := by
      gcongr
    _ = ‖iteratedFDeriv Real k h (L z)‖ := by simp

private theorem rta_scratchSmoothNormalRadialFactor_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (rta_scratchSmoothNormalRadialFactor D scale hscale n) := by
  unfold rta_scratchSmoothNormalRadialFactor
  fun_prop

/-- The smooth-normal radial factor has a fixed-order uniform derivative
bound, derived from the cutoff data and the scaled normal-extension bound. -/
private theorem rta_scratchBracket_exists_smoothNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (xi : Euclidean 2),
        ‖iteratedFDeriv Real k
          (rta_scratchSmoothNormalRadialFactor D scale hscale n) xi‖ ≤ C := by
  let Cr : Nat → Real := fun i => (D.radial.decay 0 i).choose
  have hCr_pos (i : Nat) : 0 < Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.1
  have hCr (i : Nat) (s : Real) :
      ‖iteratedFDeriv Real i (D.radial : Real → Complex) s‖ ≤ Cr i := by
    simpa [Cr] using (D.radial.decay 0 i).choose_spec.2 s
  let Cg : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCg_nonneg : 0 ≤ Cg := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_pos i |>.le
  have hCg_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ Cg := by
    apply (Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_pos j |>.le))
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let Crho : Nat → Real := fun i =>
    if hi : 1 ≤ i then
      (rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose
    else 0
  have hCrho {i : Nat} (hi : 1 ≤ i) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (xi : Euclidean 2) :
      ‖iteratedFDeriv Real i
        (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
        Crho i := by
    simpa only [Crho, dif_pos hi] using
      (rta_exists_scratch_scaledNormalExtension_iteratedFDeriv_uniform_bound D i hi).choose_spec.2
        scale hscale hscaleone xi
  let Cf : Real := ∑ i ∈ Finset.range (k + 1), max 1 (Crho i)
  have hCf_nonneg : 0 ≤ Cf := by
    apply Finset.sum_nonneg
    intro i hi
    exact le_trans zero_le_one (le_max_left _ _)
  have hCf_one : 1 ≤ Cf := by
    calc
      1 ≤ max 1 (Crho 0) := le_max_left _ _
      _ ≤ ∑ i ∈ Finset.range (k + 1), max 1 (Crho i) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun i => max 1 (Crho i))
          (fun i hi => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.succ_pos k))
  have hCf_bound {i : Nat} (hi : i ≤ k) : Crho i ≤ Cf := by
    calc
      Crho i ≤ max 1 (Crho i) := le_max_right _ _
      _ ≤ ∑ j ∈ Finset.range (k + 1), max 1 (Crho j) := by
        exact Finset.single_le_sum (s := Finset.range (k + 1))
          (f := fun j => max 1 (Crho j))
          (fun j hj => le_trans zero_le_one (le_max_left _ _))
          (Finset.mem_range.mpr (Nat.lt_succ_of_le hi))
  refine ⟨(k.factorial : Real) * Cg * Cf ^ k, by positivity, ?_⟩
  intro scale hscale hscaleone n xi
  let q : Euclidean 2 → Real := fun y =>
    (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n
  have hq : ContDiff Real (k : ℕ∞) q := by
    exact (((rta_scratchScaledNormalExtension D scale hscale).smooth (k : ℕ∞)).const_smul
      (Real.sqrt scale)⁻¹).sub contDiff_const
  have hq_eq : rta_scratchSmoothNormalRadialFactor D scale hscale n = D.radial ∘ q := by
    funext y
    simp only [rta_scratchSmoothNormalRadialFactor, q, Function.comp_apply]
  rw [hq_eq]
  apply norm_iteratedFDeriv_comp_le (D.radial.smooth (k : ℕ∞)) hq
    (by simp : (k : WithTop ℕ∞) ≤ ((k : ℕ∞) : WithTop ℕ∞)) xi
  · intro i hi
    exact (hCr i (q xi)).trans (hCg_bound hi)
  · intro i hi1 hi
    have harg := rta_iteratedFDeriv_scratchSmoothNormalRadialArgument_eq
      D scale hscale n i hi1 xi
    change ‖iteratedFDeriv Real i q xi‖ ≤ Cf ^ i
    rw [show q = fun y : Euclidean 2 =>
      (Real.sqrt scale)⁻¹ * rta_scratchScaledNormalExtension D scale hscale y - n by rfl,
      harg, norm_smul, Real.norm_eq_abs]
    have hroot : 0 < Real.sqrt scale := Real.sqrt_pos.2 hscale
    rw [abs_of_pos (inv_pos.mpr hroot)]
    calc
      (Real.sqrt scale)⁻¹ *
          ‖iteratedFDeriv Real i
            (rta_scratchScaledNormalExtension D scale hscale : Euclidean 2 → Real) xi‖ ≤
          1 * Crho i := by
        gcongr
        · exact inv_le_one_of_one_le₀ (Real.one_le_sqrt.mpr hscaleone)
        · exact hCrho hi1 scale hscale hscaleone xi
      _ ≤ Cf := by simpa using hCf_bound hi
      _ ≤ Cf ^ i := le_self_pow₀ hCf_one (Nat.ne_of_gt (Nat.zero_lt_of_lt hi1))

/-- A finite-order product estimate with constants independent of the label.
The deliberately unsimplified finite sum keeps all combinatorics local. -/
private theorem rta_norm_iteratedFDeriv_sq_mul_le_of_uniform_bounds
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (v r : E → Complex) (hv_smooth : ContDiff Real (⊤ : ℕ∞) v)
    (hr_smooth : ContDiff Real (⊤ : ℕ∞) r)
    (k : Nat) (z : E) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (_hCr : 0 ≤ Cr)
    (hv : ∀ i : Nat, i ≤ k → ‖iteratedFDeriv Real i v z‖ ≤ Cv)
    (hr : ∀ i : Nat, i ≤ k → ‖iteratedFDeriv Real i r z‖ ≤ Cr) :
    ‖iteratedFDeriv Real k (fun y => v y ^ 2 * r y) z‖ ≤
      ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
        (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
  calc
    ‖iteratedFDeriv Real k (fun y => v y ^ 2 * r y) z‖ ≤
        ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ *
            ‖iteratedFDeriv Real (k - i) r z‖ := by
      simpa only using norm_iteratedFDeriv_mul_le
        (f := fun y => v y ^ 2) (g := r)
        (N := ((⊤ : ℕ∞) : WithTop ℕ∞))
        (hv_smooth.pow 2) hr_smooth z (by exact_mod_cast le_top)
    _ ≤ ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
        (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
      apply Finset.sum_le_sum
      intro i hi
      have hik : i ≤ k := Nat.lt_succ_iff.mp (Finset.mem_range.mp hi)
      have hsquare :
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ ≤
            ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv := by
        calc
          ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ ≤
              ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) *
                ‖iteratedFDeriv Real j v z‖ *
                  ‖iteratedFDeriv Real (i - j) v z‖ := by
            simpa only [pow_two] using norm_iteratedFDeriv_mul_le
              (f := v) (g := v) (N := ((⊤ : ℕ∞) : WithTop ℕ∞))
              hv_smooth hv_smooth z
                (by exact_mod_cast le_top : (i : WithTop ℕ∞) ≤ ((⊤ : ℕ∞) : WithTop ℕ∞))
          _ ≤ ∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv := by
            apply Finset.sum_le_sum
            intro j hj
            have hji : j ≤ i := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
            have hjk : j ≤ k := hji.trans hik
            have hsub : i - j ≤ k := (Nat.sub_le _ _).trans hik
            calc
              (i.choose j : Real) * ‖iteratedFDeriv Real j v z‖ *
                  ‖iteratedFDeriv Real (i - j) v z‖ ≤
                  (i.choose j : Real) * Cv *
                    ‖iteratedFDeriv Real (i - j) v z‖ := by
                      gcongr
                      exact hv j hjk
              _ ≤ (i.choose j : Real) * Cv * Cv := by
                    gcongr
                    exact hv (i - j) hsub
      have hrk : k - i ≤ k := Nat.sub_le _ _
      have hsq_nonneg : 0 ≤ ∑ j ∈ Finset.range (i + 1),
          (i.choose j : Real) * Cv * Cv := by
        apply Finset.sum_nonneg
        intro j hj
        positivity
      calc
        (k.choose i : Real) * ‖iteratedFDeriv Real i (fun y => v y ^ 2) z‖ *
            ‖iteratedFDeriv Real (k - i) r z‖ ≤
            (k.choose i : Real) *
              (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) *
                ‖iteratedFDeriv Real (k - i) r z‖ := by
              gcongr
        _ ≤ (k.choose i : Real) *
              (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr := by
              gcongr
              exact hr (k - i) hrk

/-- One double vertical/radial summand of the corrected residual bracket. -/
private noncomputable def rta_scratchDoubleProjectionTerm
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    JointWaveSpaceTime → Complex :=
  fun z =>
    rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale) z ^ 2 *
      rta_scratchJointNormalRadialFactor D scale hscale n z

private theorem rta_scratchJointVerticalFactor_smooth
    (m : SchwartzMap Real Complex) :
    ContDiff Real (⊤ : ℕ∞) (rta_scratchJointVerticalFactor m) := by
  unfold rta_scratchJointVerticalFactor
  change ContDiff Real (⊤ : ℕ∞)
    ((m : Real → Complex) ∘ WithLp.sndL 2 Real (Euclidean 2) Real)
  exact (m.smooth (⊤ : ℕ∞)).comp
    (WithLp.sndL 2 Real (Euclidean 2) Real).contDiff

private theorem rta_scratchJointNormalRadialFactor_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (rta_scratchJointNormalRadialFactor D scale hscale n) := by
  unfold rta_scratchJointNormalRadialFactor
  change ContDiff Real (⊤ : ℕ∞)
    (rta_scratchSmoothNormalRadialFactor D scale hscale n ∘
      WithLp.fstL 2 Real (Euclidean 2) Real)
  exact (rta_scratchSmoothNormalRadialFactor_smooth D scale hscale n).comp
    (WithLp.fstL 2 Real (Euclidean 2) Real).contDiff

private theorem rta_scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ (n : Int) (z : JointWaveSpaceTime),
        ‖iteratedFDeriv Real k
          (rta_scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ C := by
  obtain ⟨C, hCnonneg, hC⟩ :=
    rta_scratchBracket_exists_smoothNormalRadialFactor_iteratedFDeriv_uniform_bound D k
  refine ⟨C, hCnonneg, ?_⟩
  intro scale hscale hscaleone n z
  exact (rta_scratch_norm_iteratedFDeriv_joint_fst_le
    (rta_scratchSmoothNormalRadialFactor D scale hscale n)
    (rta_scratchSmoothNormalRadialFactor_smooth D scale hscale n) k z).trans
    (hC scale hscale hscaleone n z.fst)

private theorem rta_scratchDoubleProjectionTerm_smooth
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int) :
    ContDiff Real (⊤ : ℕ∞) (rta_scratchDoubleProjectionTerm D scale hscale n) := by
  unfold rta_scratchDoubleProjectionTerm
  exact ((rta_scratchJointVerticalFactor_smooth
    (rta_scratchVerticalProfile D.vertical scale n hscale)).pow 2).mul
      (rta_scratchJointNormalRadialFactor_smooth D scale hscale n)

private noncomputable def rta_scratchBracketTermDerivativeBound
    (k : Nat) (Cv Cr : Real) : Real :=
  ∑ i ∈ Finset.range (k + 1), (k.choose i : Real) *
    (∑ j ∈ Finset.range (i + 1), (i.choose j : Real) * Cv * Cv) * Cr

private theorem rta_scratchBracketTermDerivativeBound_nonneg
    (k : Nat) {Cv Cr : Real} (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr) :
    0 ≤ rta_scratchBracketTermDerivativeBound k Cv Cr := by
  unfold rta_scratchBracketTermDerivativeBound
  apply Finset.sum_nonneg
  intro i hi
  apply mul_nonneg
  · apply mul_nonneg
    · positivity
    · apply Finset.sum_nonneg
      intro j hj
      positivity
  · exact hCr

private theorem rta_norm_iteratedFDeriv_scratchDoubleProjectionTerm_le_of_factor_bounds
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale) (n : Int)
    (k : Nat) (z : JointWaveSpaceTime) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr)
    (hv : ∀ i : Nat, i ≤ k →
      ‖iteratedFDeriv Real i
        (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv)
    (hr : ∀ i : Nat, i ≤ k →
      ‖iteratedFDeriv Real i (rta_scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr) :
    ‖iteratedFDeriv Real k (rta_scratchDoubleProjectionTerm D scale hscale n) z‖ ≤
      rta_scratchBracketTermDerivativeBound k Cv Cr := by
  unfold rta_scratchDoubleProjectionTerm rta_scratchBracketTermDerivativeBound
  exact rta_norm_iteratedFDeriv_sq_mul_le_of_uniform_bounds
    (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale))
    (rta_scratchJointNormalRadialFactor D scale hscale n)
    (rta_scratchJointVerticalFactor_smooth _)
    (rta_scratchSmoothNormalRadialFactor_smooth D scale hscale n |>.comp
      (WithLp.fstL 2 Real (Euclidean 2) Real).contDiff)
    k z Cv Cr hCv hCr hv hr

private theorem rta_norm_iteratedFDeriv_finset_sum_le_card_mul_of_bound
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    {ι : Type*} (s : Finset ι) (f : ι → E → Complex) (k : Nat) (z : E)
    (hf : ∀ i ∈ s, ContDiff Real (⊤ : ℕ∞) (f i))
    {B : Real} (hB : ∀ i ∈ s, ‖iteratedFDeriv Real k (f i) z‖ ≤ B) :
    ‖iteratedFDeriv Real k (fun y => ∑ i ∈ s, f i y) z‖ ≤ s.card * B := by
  calc
    ‖iteratedFDeriv Real k (fun y => ∑ i ∈ s, f i y) z‖ =
        ‖∑ i ∈ s, iteratedFDeriv Real k (f i) z‖ := by
      rw [iteratedFDeriv_fun_sum_apply]
      intro i hi
      exact ((hf i hi).of_le (by exact_mod_cast le_top)).contDiffAt
    _ ≤ ∑ i ∈ s, ‖iteratedFDeriv Real k (f i) z‖ := norm_sum_le _ _
    _ ≤ ∑ _ ∈ s, B := by
      apply Finset.sum_le_sum
      intro i hi
      exact hB i hi
    _ = s.card * B := by simp [nsmul_eq_mul]

private theorem rta_norm_iteratedFDeriv_const_one_le_one
    {E : Type*} [NormedAddCommGroup E] [NormedSpace Real E]
    (k : Nat) (z : E) :
    ‖iteratedFDeriv Real k (fun _ : E => (1 : Complex)) z‖ ≤ 1 := by
  cases k with
  | zero => simp
  | succ k =>
    rw [iteratedFDeriv_const_of_ne (Nat.succ_ne_zero k) (1 : Complex)]
    norm_num

/-- The only growth in the finite corrected bracket is the `O(√scale)`
number of radial labels.  The hypotheses are exactly the fixed-order uniform
factor bounds supplied by the vertical and smooth-normal radial calculus. -/
private theorem rta_norm_iteratedFDeriv_scratchSmoothResidualBracket_le_sqrt_of_factor_bounds
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (hscale_two : 2 ≤ scale) (k : Nat) (Cv Cr : Real)
    (hCv : 0 ≤ Cv) (hCr : 0 ≤ Cr)
    (hv : ∀ (i : Nat), i ≤ k → ∀ (n : Int) (z : JointWaveSpaceTime),
      ‖iteratedFDeriv Real i
        (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv)
    (hr : ∀ (i : Nat), i ≤ k → ∀ (n : Int) (z : JointWaveSpaceTime),
      ‖iteratedFDeriv Real i (rta_scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr) :
    ∀ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real k
        (rta_scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale)) z‖ ≤
        (1 + 11 * rta_scratchBracketTermDerivativeBound k Cv Cr) * Real.sqrt scale := by
  let indices : Finset Int := relevantRadialIndexEnumeration scale
  let B : Real := rta_scratchBracketTermDerivativeBound k Cv Cr
  have hB : 0 ≤ B := rta_scratchBracketTermDerivativeBound_nonneg k hCv hCr
  have hscale_one : 1 ≤ scale := by linarith
  have hroot_one : 1 ≤ Real.sqrt scale :=
    Real.one_le_sqrt.mpr hscale_one
  have hcard : (indices.card : Real) ≤ 11 * Real.sqrt scale := by
    exact card_relevantRadialIndexEnumeration_le_eleven_mul_sqrt hscale_two
  intro z
  have hterm (n : Int) (hn : n ∈ indices) :
      ‖iteratedFDeriv Real k (rta_scratchDoubleProjectionTerm D scale hscale n) z‖ ≤ B := by
    exact rta_norm_iteratedFDeriv_scratchDoubleProjectionTerm_le_of_factor_bounds
      D scale hscale n k z Cv Cr hCv hCr
      (fun i hi => hv i hi n z) (fun i hi => hr i hi n z)
  have hsum :
      ‖iteratedFDeriv Real k
        (fun y => ∑ n ∈ indices, rta_scratchDoubleProjectionTerm D scale hscale n y) z‖ ≤
        indices.card * B :=
    rta_norm_iteratedFDeriv_finset_sum_le_card_mul_of_bound indices
      (rta_scratchDoubleProjectionTerm D scale hscale) k z
      (fun n hn => rta_scratchDoubleProjectionTerm_smooth D scale hscale n) hterm
  have hsumAt : ContDiffAt Real k
      (fun y => ∑ n ∈ indices, rta_scratchDoubleProjectionTerm D scale hscale n y) z := by
    apply ContDiffAt.sum
    intro n hn
    exact ((rta_scratchDoubleProjectionTerm_smooth D scale hscale n).of_le
      (by exact_mod_cast le_top)).contDiffAt
  have hconstAt : ContDiffAt Real k
      (fun _ : JointWaveSpaceTime => (1 : Complex)) z := contDiffAt_const
  have hbracket : rta_scratchSmoothResidualBracket D scale hscale indices =
      fun y => (1 : Complex) - ∑ n ∈ indices,
        rta_scratchDoubleProjectionTerm D scale hscale n y := by
    rfl
  have hbase :
      ‖iteratedFDeriv Real k
        (rta_scratchSmoothResidualBracket D scale hscale indices) z‖ ≤
        1 + indices.card * B := by
    rw [hbracket]
    change ‖iteratedFDeriv Real k
      ((fun _ : JointWaveSpaceTime => (1 : Complex)) -
        fun y => ∑ n ∈ indices, rta_scratchDoubleProjectionTerm D scale hscale n y) z‖ ≤ _
    rw [iteratedFDeriv_sub_apply hconstAt hsumAt]
    exact (norm_sub_le _ _).trans
      (add_le_add (rta_norm_iteratedFDeriv_const_one_le_one k z) hsum)
  calc
    ‖iteratedFDeriv Real k
        (rta_scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale)) z‖ =
        ‖iteratedFDeriv Real k
          (rta_scratchSmoothResidualBracket D scale hscale indices) z‖ := by rfl
    _ ≤ 1 + indices.card * B := hbase
    _ ≤ 1 + (11 * Real.sqrt scale) * B := by
      gcongr
    _ ≤ (1 + 11 * B) * Real.sqrt scale := by
      nlinarith

/-- Unconditional fixed-order `O(√scale)` pointwise derivative estimate for
the corrected smooth residual bracket.  All constants are manufactured from
the cutoff data; the square-root growth is solely the radial label count. -/
private theorem rta_exists_scratchSmoothResidualBracket_iteratedFDeriv_le_sqrt
    (D : MSSRadialTimeCutoffs) (k : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real k
          (rta_scratchSmoothResidualBracket D scale hscale
            (relevantRadialIndexEnumeration scale)) z‖ ≤ C * Real.sqrt scale := by
  let Cv : Nat → Real := fun i =>
    (rta_exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose
  have hCv_nonneg (i : Nat) : 0 ≤ Cv i := by
    simpa [Cv] using
      (rta_exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose_spec.1
  have hCv_apply (i : Nat) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (n : Int) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (rta_scratchJointVerticalFactor (rta_scratchVerticalProfile D.vertical scale n hscale)) z‖ ≤ Cv i := by
    simpa [Cv] using
      (rta_exists_scratchJointVerticalFactor_iteratedFDeriv_uniform_bound D.vertical i).choose_spec.2
        scale hscale hscaleone n z
  let Cr : Nat → Real := fun i =>
    (rta_scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose
  have hCr_nonneg (i : Nat) : 0 ≤ Cr i := by
    simpa [Cr] using
      (rta_scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose_spec.1
  have hCr_apply (i : Nat) (scale : Real) (hscale : 0 < scale)
      (hscaleone : 1 ≤ scale) (n : Int) (z : JointWaveSpaceTime) :
      ‖iteratedFDeriv Real i
        (rta_scratchJointNormalRadialFactor D scale hscale n) z‖ ≤ Cr i := by
    simpa [Cr] using
      (rta_scratchBracket_exists_jointNormalRadialFactor_iteratedFDeriv_uniform_bound D i).choose_spec.2
        scale hscale hscaleone n z
  let CvTot : Real := ∑ i ∈ Finset.range (k + 1), Cv i
  have hCvTot_nonneg : 0 ≤ CvTot := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCv_nonneg i
  have hCvTot_bound {i : Nat} (hi : i ≤ k) : Cv i ≤ CvTot := by
    apply Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cv) (fun j hj => hCv_nonneg j)
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let CrTot : Real := ∑ i ∈ Finset.range (k + 1), Cr i
  have hCrTot_nonneg : 0 ≤ CrTot := by
    apply Finset.sum_nonneg
    intro i hi
    exact hCr_nonneg i
  have hCrTot_bound {i : Nat} (hi : i ≤ k) : Cr i ≤ CrTot := by
    apply Finset.single_le_sum (s := Finset.range (k + 1))
      (f := Cr) (fun j hj => hCr_nonneg j)
    exact Finset.mem_range.mpr (Nat.lt_succ_of_le hi)
  let B : Real := rta_scratchBracketTermDerivativeBound k CvTot CrTot
  have hB_nonneg : 0 ≤ B :=
    rta_scratchBracketTermDerivativeBound_nonneg k hCvTot_nonneg hCrTot_nonneg
  refine ⟨1 + 11 * B, by positivity, ?_⟩
  intro scale hscale hscale_two z
  have hscale_one : 1 ≤ scale := by linarith
  exact rta_norm_iteratedFDeriv_scratchSmoothResidualBracket_le_sqrt_of_factor_bounds
    D scale hscale hscale_two k CvTot CrTot hCvTot_nonneg hCrTot_nonneg
    (fun i hi n w => (hCv_apply i scale hscale hscale_one n w).trans
      (hCvTot_bound hi))
    (fun i hi n w => (hCr_apply i scale hscale hscale_one n w).trans
      (hCrTot_bound hi)) z

private theorem rta_scratch_normal_shear_measurePreserving
    (rho : SchwartzMap (Euclidean 2) Real) :
    MeasurePreserving
      (fun z : WaveSpaceTime => (z.1, z.2 - rho z.1)) volume volume := by
  rw [Measure.volume_eq_prod]
  refine (MeasurePreserving.id (volume : Measure (Euclidean 2))).skew_product
    (g := fun xi (t : Real) => t - rho xi) ?_ ?_
  · exact measurable_snd.sub (rho.continuous.measurable.comp measurable_fst)
  · filter_upwards with xi
    simpa only [sub_eq_add_neg] using
      (measurePreserving_add_right (volume : Measure Real) (-rho xi)).map_eq

/-- The literal nonnegative spatial--normal product is integrable after a
normal shear whenever its spatial factor is integrable and its temporal
factor is Schwartz. -/
private theorem rta_integrable_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hP : Integrable P volume := by
    rw [Measure.volume_eq_prod]
    exact hA.norm.mul_prod H.integrable.norm
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using rta_scratch_normal_shear_measurePreserving rho
  have hcomp : Integrable (P ∘ shear) volume :=
    (hshear.integrable_comp hP.aestronglyMeasurable).mpr hP
  have heq : P ∘ shear = fun z : WaveSpaceTime =>
      ‖A z.1‖ * ‖H (z.2 - rho z.1)‖ := by
    funext z
    rfl
  rw [← heq]
  exact hcomp

/-- The same literal shear product on the joint Hilbert `WithLp` coordinate
model is integrable; this is transport through `WithLp.toLp`. -/
private theorem rta_integrable_joint_sheared_norm_mul_norm
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  change Integrable Q volume
  have hraw := rta_integrable_sheared_norm_mul_norm A hA H rho
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  rw [← hpres.integrable_comp_emb
    (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding]
  have heq : Q ∘ (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) =
      fun p : WaveSpaceTime => ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by
    funext p
    rfl
  rw [heq]
  exact hraw

/-- Literal Fubini-plus-shear identity for an arbitrary integrable spatial
factor and a Schwartz temporal profile. -/
private theorem rta_integral_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let shear : WaveSpaceTime → WaveSpaceTime :=
    fun z => (z.1, z.2 - rho z.1)
  let P : WaveSpaceTime → Real := fun z => ‖A z.1‖ * ‖H z.2‖
  have hPmeas : AEStronglyMeasurable P volume := by
    rw [Measure.volume_eq_prod]
    exact (hA.aestronglyMeasurable.norm.comp_fst).mul
      (H.continuous.aestronglyMeasurable.norm.comp_snd)
  have hshear : MeasurePreserving shear volume volume := by
    simpa only [shear] using rta_scratch_normal_shear_measurePreserving rho
  have hPmeas_map : AEStronglyMeasurable P (Measure.map shear volume) := by
    rw [hshear.map_eq]
    exact hPmeas
  have htransport : (∫ z : WaveSpaceTime, P (shear z)) = ∫ z : WaveSpaceTime, P z := by
    calc
      (∫ z : WaveSpaceTime, P (shear z)) =
          ∫ z : WaveSpaceTime, P z ∂Measure.map shear volume := by
            exact (integral_map hshear.measurable.aemeasurable hPmeas_map).symm
      _ = ∫ z : WaveSpaceTime, P z := by rw [hshear.map_eq]
  calc
    (∫ z : WaveSpaceTime, ‖A z.1‖ * ‖H (z.2 - rho z.1)‖) =
        ∫ z : WaveSpaceTime, P (shear z) := by rfl
    _ = ∫ z : WaveSpaceTime, P z := htransport
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
      rw [Measure.volume_eq_prod]
      exact integral_prod_mul (fun xi : Euclidean 2 => ‖A xi‖)
        (fun t : Real => ‖H t‖)

/-- `WithLp.volume_preserving_toLp` transports the raw Fubini formula to the
joint frequency Hilbert model without any extra regularity on `A`. -/
private theorem rta_integral_joint_sheared_norm_mul_norm_eq
    {E : Type*} [NormedAddCommGroup E]
    (A : Euclidean 2 → E) (hA : Integrable A)
    (H : SchwartzMap Real Complex)
    (rho : SchwartzMap (Euclidean 2) Real) :
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
      (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ := by
  let Q : JointWaveSpaceTime → Real := fun z =>
    ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖
  have hpres : MeasurePreserving
      (WithLp.toLp 2 : WaveSpaceTime → JointWaveSpaceTime) volume volume := by
    simpa only using (WithLp.volume_preserving_toLp (Euclidean 2) Real)
  have htransport :
      (∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p)) =
        ∫ z : JointWaveSpaceTime, Q z :=
    hpres.integral_comp
      (MeasurableEquiv.toLp 2 WaveSpaceTime).measurableEmbedding Q
  calc
    (∫ z : JointWaveSpaceTime, ‖A z.fst‖ * ‖H (z.snd - rho z.fst)‖) =
        ∫ z : JointWaveSpaceTime, Q z := by rfl
    _ = ∫ p : WaveSpaceTime, Q (WithLp.toLp 2 p) := htransport.symm
    _ = ∫ p : WaveSpaceTime, ‖A p.1‖ * ‖H (p.2 - rho p.1)‖ := by rfl
    _ = (∫ xi : Euclidean 2, ‖A xi‖) * ∫ t : Real, ‖H t‖ :=
      rta_integral_sheared_norm_mul_norm_eq A hA H rho
/-- Integrability of the scaled-amplitude derivative envelope in joint
coordinates. -/
private theorem rta_integrable_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (a : Nat) (H : SchwartzMap Real Complex) :
    Integrable (fun z : JointWaveSpaceTime =>
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)‖) := by
  have hA : Integrable (fun xi : Euclidean 2 =>
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (rta_scratchScaledAmplitude D scale hscale) 0 a
  simpa only [norm_norm] using
    (rta_integrable_joint_sheared_norm_mul_norm
      (fun xi : Euclidean 2 =>
        ‖iteratedFDeriv Real a
          (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖)
      hA H (rta_scratchScaledNormalExtension D scale hscale))

/-- Exact joint-coordinate version of the scaled-amplitude shear identity. -/
private theorem rta_integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_eq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (a : Nat) (H : SchwartzMap Real Complex) :
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)‖) =
      (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
  have hA : Integrable (fun xi : Euclidean 2 =>
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (rta_scratchScaledAmplitude D scale hscale) 0 a
  calc
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)‖) =
        (∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a
            (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖) *
          ∫ t : Real, ‖H t‖ := by
      simpa only [norm_norm] using
        (rta_integral_joint_sheared_norm_mul_norm_eq
          (fun xi : Euclidean 2 =>
            ‖iteratedFDeriv Real a
              (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) xi‖)
          hA H (rta_scratchScaledNormalExtension D scale hscale))
    _ = (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ *
        ∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
      rw [rta_integral_norm_iteratedFDeriv_scratchScaledAmplitude]

/-- The joint-coordinate envelope has at most the planar `scale²` volume
loss for `scale ≥ 1`. -/
private theorem rta_integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_le_scale_sq
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (hscaleone : 1 ≤ scale) (a : Nat) (H : SchwartzMap Real Complex) :
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)‖) ≤
      scale ^ 2 *
        (∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        ∫ t : Real, ‖H t‖ := by
  let IA : Real := ∫ xi : Euclidean 2,
    ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖
  let IH : Real := ∫ t : Real, ‖H t‖
  have hIA : 0 ≤ IA := integral_nonneg fun xi => norm_nonneg _
  have hIH : 0 ≤ IH := integral_nonneg fun t => norm_nonneg _
  have hscale_inv : 0 ≤ scale⁻¹ := inv_nonneg.mpr hscale.le
  have hinvpow : scale⁻¹ ^ a ≤ 1 :=
    pow_le_one₀ hscale_inv (inv_le_one_of_one_le₀ hscaleone)
  have hjac : ((scale⁻¹) ^ 2)⁻¹ = scale ^ 2 := by
    field_simp [hscale.ne']
  have hfactor : scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ ≤ scale ^ 2 := by
    rw [hjac]
    calc
      scale⁻¹ ^ a * scale ^ 2 ≤ 1 * scale ^ 2 := by gcongr
      _ = scale ^ 2 := one_mul _
  calc
    (∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖H (z.snd - rta_scratchScaledNormalExtension D scale hscale z.fst)‖) =
      (scale⁻¹ ^ a * ((scale⁻¹) ^ 2)⁻¹ * IA) * IH := by
        simpa only [IA, IH] using
          rta_integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_eq
            D scale hscale a H
    _ ≤ (scale ^ 2 * IA) * IH := by gcongr
    _ = scale ^ 2 * IA * IH := by ring
section ScratchResidualMultiplierL1

private theorem rta_joint_fstL_norm_le_one :
    ‖WithLp.fstL 2 Real (Euclidean 2) Real‖ ≤ 1 := by
  refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one ?_
  intro z
  simpa using WithLp.norm_fst_le (p := 2) (Euclidean 2) z

private theorem rta_norm_iteratedFDeriv_scaledAmplitude_comp_fst_le
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (k : Nat) (z : JointWaveSpaceTime) :
    ‖iteratedFDeriv Real k
      (fun w : JointWaveSpaceTime => rta_scratchScaledAmplitude D scale hscale w.fst) z‖ ≤
      ‖iteratedFDeriv Real k
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ := by
  let L : JointWaveSpaceTime →L[Real] Euclidean 2 :=
    WithLp.fstL 2 Real (Euclidean 2) Real
  change ‖iteratedFDeriv Real k
    ((rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) ∘ L) z‖ ≤ _
  rw [L.iteratedFDeriv_comp_right
    ((rta_scratchScaledAmplitude D scale hscale).smooth (k : ℕ∞)) z le_rfl]
  calc
    ‖(iteratedFDeriv Real k
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)).compContinuousLinearMap
          (fun _ => L)‖ ≤
        ‖iteratedFDeriv Real k
          (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin k, ‖L‖ :=
      ContinuousMultilinearMap.norm_compContinuousLinearMap_le _ _
    _ ≤ ‖iteratedFDeriv Real k
          (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) (L z)‖ *
          ∏ _ : Fin k, (1 : Real) := by
      gcongr
      exact rta_joint_fstL_norm_le_one
    _ = ‖iteratedFDeriv Real k
          (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ := by
      simp [L]

private theorem rta_scratchSmoothResidualProfile_eq_scaledAmplitude_mul_bracket_time
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (z : JointWaveSpaceTime) :
    rta_scratchSmoothResidualProfile D scale hscale (relevantRadialIndexEnumeration scale) z =
      rta_scratchScaledAmplitude D scale hscale z.fst *
        (rta_scratchSmoothResidualBracket D scale hscale
          (relevantRadialIndexEnumeration scale) z *
          FourierTransform.fourier (D.time : Real → Complex)
            (rta_scratchJointNormalDifference D scale hscale z)) := by
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz, rta_scratchSmoothResidualProfile_apply]
  simp only [rta_scratchScaledAmplitude_apply, rta_scratchScaledNormalExtension_apply,
    rta_scratchJointNormalDifference,
    WithLp.toLp_fst, WithLp.toLp_snd]
  ring


end ScratchResidualMultiplierL1
section ScratchResidualMultiplierL1

/-- The bracket times the sheared temporal Fourier profile has an arbitrary
normal-gap gain.  The only remaining scale growth is the `sqrt scale` count
of relevant radial labels. -/
private theorem rta_exists_scale_pow_mul_norm_iteratedFDeriv_bracket_mul_sheared_time_le
    (D : MSSRadialTimeCutoffs) (r L : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        Real.sqrt scale ≤ |rta_scratchJointNormalDifference D scale hscale z| →
        scale ^ L * ‖iteratedFDeriv Real r
          (fun w : JointWaveSpaceTime =>
            rta_scratchSmoothResidualBracket D scale hscale
                (relevantRadialIndexEnumeration scale) w *
              FourierTransform.fourier (D.time : Real → Complex)
                (rta_scratchJointNormalDifference D scale hscale w)) z‖ ≤
          C * Real.sqrt scale *
            ∑ i ∈ Finset.range (r + 1),
              ‖rta_scratchWeightedTemporalDerivativeProfile
                (FourierTransform.fourier D.time) i L
                (rta_scratchJointNormalDifference D scale hscale z)‖ := by
  let h : SchwartzMap Real Complex := FourierTransform.fourier D.time
  let CB : Nat → Real := fun j =>
    (rta_exists_scratchSmoothResidualBracket_iteratedFDeriv_le_sqrt D j).choose
  have hCBnonneg (j : Nat) : 0 ≤ CB j := by
    exact (rta_exists_scratchSmoothResidualBracket_iteratedFDeriv_le_sqrt D j).choose_spec.1
  have hCB (j : Nat) : ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real j
          (rta_scratchSmoothResidualBracket D scale hscale
            (relevantRadialIndexEnumeration scale)) z‖ ≤
          CB j * Real.sqrt scale := by
    simpa only [CB] using
      (rta_exists_scratchSmoothResidualBracket_iteratedFDeriv_le_sqrt D j).choose_spec.2
  let CT : Nat → Real := fun j =>
    (rta_exists_scale_pow_mul_norm_iteratedFDeriv_sheared_time_le_sum_weighted_profiles
      D h j L).choose
  have hCTnonneg (j : Nat) : 0 ≤ CT j := by
    exact (rta_exists_scale_pow_mul_norm_iteratedFDeriv_sheared_time_le_sum_weighted_profiles
      D h j L).choose_spec.1
  have hCT (j : Nat) : ∀ (scale : Real) (hscale : 0 < scale), 1 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        Real.sqrt scale ≤ |rta_scratchJointNormalDifference D scale hscale z| →
        scale ^ L * ‖iteratedFDeriv Real j
          (fun w : JointWaveSpaceTime =>
            h (rta_scratchJointNormalDifference D scale hscale w)) z‖ ≤
          CT j * ∑ i ∈ Finset.range (j + 1),
            ‖rta_scratchWeightedTemporalDerivativeProfile h i L
              (rta_scratchJointNormalDifference D scale hscale z)‖ := by
    simpa only [CT] using
      (rta_exists_scale_pow_mul_norm_iteratedFDeriv_sheared_time_le_sum_weighted_profiles
        D h j L).choose_spec.2
  let B0 : Real := ∑ j ∈ Finset.range (r + 1), CB j
  let T0 : Real := ∑ j ∈ Finset.range (r + 1), CT j
  have hB0nonneg : 0 ≤ B0 := by
    dsimp only [B0]
    exact Finset.sum_nonneg fun j hj => hCBnonneg j
  have hT0nonneg : 0 ≤ T0 := by
    dsimp only [T0]
    exact Finset.sum_nonneg fun j hj => hCTnonneg j
  have hCBle {j : Nat} (hj : j ≤ r) : CB j ≤ B0 := by
    dsimp only [B0]
    exact le_trans (le_refl _) (Finset.single_le_sum
      (s := Finset.range (r + 1)) (f := CB)
      (fun i hi => hCBnonneg i) (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)))
  have hCTle {j : Nat} (hj : j ≤ r) : CT j ≤ T0 := by
    dsimp only [T0]
    exact le_trans (le_refl _) (Finset.single_le_sum
      (s := Finset.range (r + 1)) (f := CT)
      (fun i hi => hCTnonneg i) (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)))
  let C : Real := ∑ j ∈ Finset.range (r + 1), (r.choose j : Real) * B0 * T0
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    apply Finset.sum_nonneg
    intro j hj
    positivity
  intro scale hscale hscale_two z hgap
  let q : JointWaveSpaceTime → Real := rta_scratchJointNormalDifference D scale hscale
  let B : JointWaveSpaceTime → Complex := rta_scratchSmoothResidualBracket D scale hscale
    (relevantRadialIndexEnumeration scale)
  let T : JointWaveSpaceTime → Complex := fun w => h (q w)
  let S : Real := ∑ i ∈ Finset.range (r + 1),
    ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖
  have hSnonneg : 0 ≤ S := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hB : ContDiff Real (r : ℕ∞) B := by
    dsimp only [B]
    exact (rta_scratchSmoothResidualBracket_hasTemperateGrowth D scale hscale
      (relevantRadialIndexEnumeration scale)).1.of_le (by exact_mod_cast le_top)
  have hq : ContDiff Real (r : ℕ∞) q := by
    let Ls : JointWaveSpaceTime →L[Real] Real :=
      WithLp.sndL 2 Real (Euclidean 2) Real
    let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
      WithLp.fstL 2 Real (Euclidean 2) Real
    let rho : SchwartzMap (Euclidean 2) Real := rta_scratchScaledNormalExtension D scale hscale
    change ContDiff Real (r : ℕ∞) (fun w : JointWaveSpaceTime => Ls w - rho (Lf w))
    exact Ls.contDiff.sub ((rho.smooth (r : ℕ∞)).comp_continuousLinearMap (g := Lf))
  have hT : ContDiff Real (r : ℕ∞) T := by
    dsimp only [T]
    exact (h.smooth (r : ℕ∞)).comp hq
  have hBbound {j : Nat} (hj : j ≤ r) :
      ‖iteratedFDeriv Real j B z‖ ≤ B0 * Real.sqrt scale := by
    exact (hCB j scale hscale hscale_two z).trans
      (mul_le_mul_of_nonneg_right (hCBle hj) (Real.sqrt_nonneg _))
  have hTbound {j : Nat} (hj : j ≤ r) :
      scale ^ L * ‖iteratedFDeriv Real j T z‖ ≤ T0 * S := by
    have hshort :
        ∑ i ∈ Finset.range (j + 1),
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ ≤ S := by
      dsimp only [S]
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · exact (Finset.range_subset_range).2 (Nat.succ_le_succ hj)
      · intro i hi hnot
        exact norm_nonneg _
    calc
      scale ^ L * ‖iteratedFDeriv Real j T z‖ ≤
          CT j * ∑ i ∈ Finset.range (j + 1),
            ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ :=
        hCT j scale hscale (by linarith) z (by simpa [q] using hgap)
      _ ≤ T0 * ∑ i ∈ Finset.range (j + 1),
            ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by
        exact mul_le_mul_of_nonneg_right (hCTle hj)
          (Finset.sum_nonneg fun i hi => norm_nonneg _)
      _ ≤ T0 * S := mul_le_mul_of_nonneg_left hshort hT0nonneg
  have hprod := norm_iteratedFDeriv_mul_le hB hT z
    le_rfl
  change scale ^ L * ‖iteratedFDeriv Real r (fun w => B w * T w) z‖ ≤ _
  calc
    scale ^ L * ‖iteratedFDeriv Real r (fun w => B w * T w) z‖ ≤
        scale ^ L * ∑ j ∈ Finset.range (r + 1),
          (r.choose j : Real) * ‖iteratedFDeriv Real j B z‖ *
            ‖iteratedFDeriv Real (r - j) T z‖ := by
      exact mul_le_mul_of_nonneg_left hprod (pow_nonneg (by linarith) _)
    _ = ∑ j ∈ Finset.range (r + 1),
          (r.choose j : Real) * ‖iteratedFDeriv Real j B z‖ *
            (scale ^ L * ‖iteratedFDeriv Real (r - j) T z‖) := by
      rw [Finset.mul_sum]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ ≤ ∑ j ∈ Finset.range (r + 1),
          (r.choose j : Real) * (B0 * Real.sqrt scale) * (T0 * S) := by
      apply Finset.sum_le_sum
      intro j hj
      have hjr : j ≤ r := Nat.lt_succ_iff.mp (Finset.mem_range.mp hj)
      have hsub : r - j ≤ r := Nat.sub_le _ _
      have hinner : ‖iteratedFDeriv Real j B z‖ *
          (scale ^ L * ‖iteratedFDeriv Real (r - j) T z‖) ≤
          (B0 * Real.sqrt scale) * (T0 * S) := by
        exact mul_le_mul (hBbound hjr) (hTbound hsub)
          (mul_nonneg (pow_nonneg (by linarith [hscale_two]) _) (norm_nonneg _))
          (mul_nonneg hB0nonneg (Real.sqrt_nonneg _))
      calc
        (r.choose j : Real) * ‖iteratedFDeriv Real j B z‖ *
            (scale ^ L * ‖iteratedFDeriv Real (r - j) T z‖) =
            (r.choose j : Real) *
              (‖iteratedFDeriv Real j B z‖ *
                (scale ^ L * ‖iteratedFDeriv Real (r - j) T z‖)) := by ring
        _ ≤ (r.choose j : Real) * ((B0 * Real.sqrt scale) * (T0 * S)) :=
          mul_le_mul_of_nonneg_left hinner (by positivity)
        _ = (r.choose j : Real) * (B0 * Real.sqrt scale) * (T0 * S) := by ring
    _ = C * Real.sqrt scale * S := by
      change _ = (∑ j ∈ Finset.range (r + 1),
        (r.choose j : Real) * B0 * T0) * Real.sqrt scale * S
      conv_rhs => rw [Finset.sum_mul, Finset.sum_mul]
      apply Finset.sum_congr rfl
      intro j hj
      ring
    _ = C * Real.sqrt scale *
        ∑ i ∈ Finset.range (r + 1),
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by rfl


end ScratchResidualMultiplierL1
section ScratchResidualMultiplierL1

/-- Every frequency derivative of the actual smooth residual multiplier has
the normal-gap gain needed to overcome both the planar dilation volume and
the finite `O(sqrt scale)` radial-label count. -/
private theorem rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_scratchSmoothResidualProfile_le
    (D : MSSRadialTimeCutoffs) (r N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ (N + 3) *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (rta_scratchSmoothResidualProfile D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ C * scale ^ 3 := by
  let L : Nat := N + 3
  let h : SchwartzMap Real Complex := FourierTransform.fourier D.time
  let CG : Nat → Real := fun j =>
    (rta_exists_scale_pow_mul_norm_iteratedFDeriv_bracket_mul_sheared_time_le
      D j L).choose
  have hCGnonneg (j : Nat) : 0 ≤ CG j := by
    exact (rta_exists_scale_pow_mul_norm_iteratedFDeriv_bracket_mul_sheared_time_le
      D j L).choose_spec.1
  have hCG (j : Nat) : ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ z : JointWaveSpaceTime,
        Real.sqrt scale ≤ |rta_scratchJointNormalDifference D scale hscale z| →
        scale ^ L * ‖iteratedFDeriv Real j
          (fun w : JointWaveSpaceTime =>
            rta_scratchSmoothResidualBracket D scale hscale
                (relevantRadialIndexEnumeration scale) w *
              h (rta_scratchJointNormalDifference D scale hscale w)) z‖ ≤
          CG j * Real.sqrt scale *
            ∑ i ∈ Finset.range (j + 1),
              ‖rta_scratchWeightedTemporalDerivativeProfile h i L
                (rta_scratchJointNormalDifference D scale hscale z)‖ := by
    intro scale hscale hscale_two z hgap
    dsimp only [h]
    exact (rta_exists_scale_pow_mul_norm_iteratedFDeriv_bracket_mul_sheared_time_le
      D j L).choose_spec.2 scale hscale hscale_two z hgap
  let G0 : Real := ∑ j ∈ Finset.range (r + 1), CG j
  have hG0nonneg : 0 ≤ G0 := by
    dsimp only [G0]
    exact Finset.sum_nonneg fun j hj => hCGnonneg j
  have hCGle {j : Nat} (hj : j ≤ r) : CG j ≤ G0 := by
    dsimp only [G0]
    exact le_trans (le_refl _) (Finset.single_le_sum
      (s := Finset.range (r + 1)) (f := CG)
      (fun i hi => hCGnonneg i) (Finset.mem_range.mpr (Nat.lt_succ_of_le hj)))
  let C : Real := ∑ a ∈ Finset.range (r + 1),
    ∑ i ∈ Finset.range (r + 1),
      (r.choose a : Real) * G0 *
        (∫ xi : Euclidean 2,
          ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
        (∫ t : Real, ‖rta_scratchWeightedTemporalDerivativeProfile h i L t‖)
  refine ⟨C, ?_, ?_⟩
  · dsimp only [C]
    apply Finset.sum_nonneg
    intro a ha
    apply Finset.sum_nonneg
    intro i hi
    positivity
  intro scale hscale hscale_two
  let q : JointWaveSpaceTime → Real := rta_scratchJointNormalDifference D scale hscale
  let A : JointWaveSpaceTime → Complex := fun w => rta_scratchScaledAmplitude D scale hscale w.fst
  let B : JointWaveSpaceTime → Complex := rta_scratchSmoothResidualBracket D scale hscale
    (relevantRadialIndexEnumeration scale)
  let T : JointWaveSpaceTime → Complex := fun w => h (q w)
  let G : JointWaveSpaceTime → Complex := fun w => B w * T w
  let S : JointWaveSpaceTime → Real := fun z =>
    ∑ i ∈ Finset.range (r + 1),
      ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖
  let M : JointWaveSpaceTime → Real := fun z =>
    ∑ a ∈ Finset.range (r + 1), ∑ i ∈ Finset.range (r + 1),
      (r.choose a : Real) * G0 * Real.sqrt scale *
        ‖iteratedFDeriv Real a
          (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
        ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖
  have hSnonneg (z : JointWaveSpaceTime) : 0 ≤ S z := by
    dsimp only [S]
    apply Finset.sum_nonneg
    intro i hi
    exact norm_nonneg _
  have hA : ContDiff Real (r : ℕ∞) A := by
    let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
      WithLp.fstL 2 Real (Euclidean 2) Real
    change ContDiff Real (r : ℕ∞)
      ((rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) ∘ Lf)
    exact ((rta_scratchScaledAmplitude D scale hscale).smooth (r : ℕ∞)).comp_continuousLinearMap (g := Lf)
  have hB : ContDiff Real (r : ℕ∞) B := by
    dsimp only [B]
    exact (rta_scratchSmoothResidualBracket_hasTemperateGrowth D scale hscale
      (relevantRadialIndexEnumeration scale)).1.of_le (by exact_mod_cast le_top)
  have hq : ContDiff Real (r : ℕ∞) q := by
    let Ls : JointWaveSpaceTime →L[Real] Real :=
      WithLp.sndL 2 Real (Euclidean 2) Real
    let Lf : JointWaveSpaceTime →L[Real] Euclidean 2 :=
      WithLp.fstL 2 Real (Euclidean 2) Real
    let rho : SchwartzMap (Euclidean 2) Real := rta_scratchScaledNormalExtension D scale hscale
    change ContDiff Real (r : ℕ∞) (fun w : JointWaveSpaceTime => Ls w - rho (Lf w))
    exact Ls.contDiff.sub ((rho.smooth (r : ℕ∞)).comp_continuousLinearMap (g := Lf))
  have hT : ContDiff Real (r : ℕ∞) T := by
    dsimp only [T]
    exact (h.smooth (r : ℕ∞)).comp hq
  have hG : ContDiff Real (r : ℕ∞) G := hB.mul hT
  have hCGleG0 {j : Nat} (hj : j ≤ r) : CG j * Real.sqrt scale ≤
      G0 * Real.sqrt scale :=
    mul_le_mul_of_nonneg_right (hCGle hj) (Real.sqrt_nonneg _)
  have hGbound {j : Nat} (hj : j ≤ r) (z : JointWaveSpaceTime)
      (hgap : Real.sqrt scale ≤ |q z|) :
      scale ^ L * ‖iteratedFDeriv Real j G z‖ ≤ G0 * Real.sqrt scale * S z := by
    have hshort :
        ∑ i ∈ Finset.range (j + 1),
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ ≤ S z := by
      dsimp only [S]
      apply Finset.sum_le_sum_of_subset_of_nonneg
      · exact (Finset.range_subset_range).2 (Nat.succ_le_succ hj)
      · intro i hi hnot
        exact norm_nonneg _
    calc
      scale ^ L * ‖iteratedFDeriv Real j G z‖ ≤
          CG j * Real.sqrt scale *
            ∑ i ∈ Finset.range (j + 1),
              ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ :=
        hCG j scale hscale hscale_two z (by simpa [G, T, B, q] using hgap)
      _ ≤ (G0 * Real.sqrt scale) *
            ∑ i ∈ Finset.range (j + 1),
              ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by
        exact mul_le_mul_of_nonneg_right (hCGleG0 hj)
          (Finset.sum_nonneg fun i hi => norm_nonneg _)
      _ ≤ G0 * Real.sqrt scale * S z := by
        exact mul_le_mul_of_nonneg_left hshort
          (mul_nonneg hG0nonneg (Real.sqrt_nonneg _))
  have hpoint (z : JointWaveSpaceTime) :
      scale ^ L * ‖iteratedFDeriv Real r
        (rta_scratchSmoothResidualProfile D scale hscale
          (relevantRadialIndexEnumeration scale) : JointWaveSpaceTime → Complex) z‖ ≤ M z := by
    by_cases hgap : Real.sqrt scale ≤ |q z|
    · have hfactor :
          (rta_scratchSmoothResidualProfile D scale hscale
            (relevantRadialIndexEnumeration scale) : JointWaveSpaceTime → Complex) =
            fun w => A w * G w := by
        funext w
        dsimp only [A, G, B, T, q]
        simpa [h, SchwartzMap.fourier_coe] using
          rta_scratchSmoothResidualProfile_eq_scaledAmplitude_mul_bracket_time
            D scale hscale w
      have hprod := norm_iteratedFDeriv_mul_le hA hG z le_rfl
      rw [hfactor]
      calc
        scale ^ L * ‖iteratedFDeriv Real r (fun w => A w * G w) z‖ ≤
            scale ^ L * ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) * ‖iteratedFDeriv Real a A z‖ *
                ‖iteratedFDeriv Real (r - a) G z‖ := by
          exact mul_le_mul_of_nonneg_left hprod
            (pow_nonneg (by linarith [hscale_two]) _)
        _ = ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) * ‖iteratedFDeriv Real a A z‖ *
                (scale ^ L * ‖iteratedFDeriv Real (r - a) G z‖) := by
          rw [Finset.mul_sum]
          apply Finset.sum_congr rfl
          intro a ha
          ring
        _ ≤ ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) * ‖iteratedFDeriv Real a A z‖ *
                (G0 * Real.sqrt scale * S z) := by
          apply Finset.sum_le_sum
          intro a ha
          have har : a ≤ r := Nat.lt_succ_iff.mp (Finset.mem_range.mp ha)
          exact mul_le_mul_of_nonneg_left
            (hGbound (Nat.sub_le _ _) z hgap) (by positivity)
        _ ≤ ∑ a ∈ Finset.range (r + 1),
              (r.choose a : Real) *
                ‖iteratedFDeriv Real a
                  (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                (G0 * Real.sqrt scale * S z) := by
          apply Finset.sum_le_sum
          intro a ha
          have haderiv := rta_norm_iteratedFDeriv_scaledAmplitude_comp_fst_le
            D scale hscale a z
          have hcoef : 0 ≤ G0 * Real.sqrt scale * S z := by
            exact mul_nonneg
              (mul_nonneg hG0nonneg (Real.sqrt_nonneg _)) (hSnonneg z)
          calc
            (r.choose a : Real) * ‖iteratedFDeriv Real a A z‖ *
                (G0 * Real.sqrt scale * S z) =
                (r.choose a : Real) *
                  (‖iteratedFDeriv Real a A z‖ *
                    (G0 * Real.sqrt scale * S z)) := by ring
            _ ≤ (r.choose a : Real) *
                (‖iteratedFDeriv Real a
                  (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                    (G0 * Real.sqrt scale * S z)) := by
              exact mul_le_mul_of_nonneg_left
                (mul_le_mul_of_nonneg_right haderiv hcoef) (by positivity)
            _ = (r.choose a : Real) *
                ‖iteratedFDeriv Real a
                  (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                (G0 * Real.sqrt scale * S z) := by ring
        _ = M z := by
          dsimp only [M, S]
          apply Finset.sum_congr rfl
          intro a ha
          rw [← Finset.mul_sum]
          ring
    · have hnear : |q z| < Real.sqrt scale := lt_of_not_ge hgap
      have hnear' : |z.snd - rta_scratchScaledNormalCoordinate D scale z.fst| <
          Real.sqrt scale := by
        simpa [q, rta_scratchJointNormalDifference, rta_scratchScaledNormalExtension_apply] using hnear
      have hzero := rta_iteratedFDeriv_scratchSmoothResidualProfile_eq_zero_of_normal_near
        D scale hscale r z.fst z.snd hnear'
      have hpair : WithLp.toLp 2 (z.fst, z.snd) = z := by
        apply (WithLp.ext_iff 2).2
        rfl
      rw [hpair] at hzero
      rw [hzero]
      simp only [norm_zero, mul_zero]
      dsimp only [M]
      apply Finset.sum_nonneg
      intro a ha
      apply Finset.sum_nonneg
      intro i hi
      positivity
  have hMterm (a i : Nat) :
      Integrable (fun z : JointWaveSpaceTime =>
        (r.choose a : Real) * G0 * Real.sqrt scale *
          ‖iteratedFDeriv Real a
            (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖) := by
    have hbase := rta_integrable_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude
      D scale hscale a (rta_scratchWeightedTemporalDerivativeProfile h i L)
    have hscaled := hbase.const_mul ((r.choose a : Real) * G0 * Real.sqrt scale)
    simpa only [q, rta_scratchJointNormalDifference, rta_scratchScaledNormalExtension_apply,
      mul_assoc] using hscaled
  have hMint : Integrable M := by
    dsimp only [M]
    apply integrable_finsetSum
    intro a ha
    apply integrable_finsetSum
    intro i hi
    exact hMterm a i
  have hleftBase : Integrable (fun z : JointWaveSpaceTime =>
      ‖iteratedFDeriv Real r
        (rta_scratchSmoothResidualProfile D scale hscale
          (relevantRadialIndexEnumeration scale) : JointWaveSpaceTime → Complex) z‖) := by
    simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume
      (rta_scratchSmoothResidualProfile D scale hscale
        (relevantRadialIndexEnumeration scale)) 0 r
  have hleft : Integrable (fun z : JointWaveSpaceTime =>
      scale ^ L * ‖iteratedFDeriv Real r
        (rta_scratchSmoothResidualProfile D scale hscale
          (relevantRadialIndexEnumeration scale) : JointWaveSpaceTime → Complex) z‖) := by
    simpa using hleftBase.const_mul (scale ^ L)
  have hInt : scale ^ L *
      (∫ z : JointWaveSpaceTime,
        ‖iteratedFDeriv Real r
          (rta_scratchSmoothResidualProfile D scale hscale
            (relevantRadialIndexEnumeration scale) : JointWaveSpaceTime → Complex) z‖) ≤
      ∫ z : JointWaveSpaceTime, M z := by
    rw [← integral_const_mul]
    exact integral_mono_of_nonneg
      (Filter.Eventually.of_forall fun z =>
        mul_nonneg (pow_nonneg (le_trans (by norm_num) hscale_two) _) (norm_nonneg _)) hMint
      (Filter.Eventually.of_forall hpoint)
  have hscaleone : 1 ≤ scale := le_trans (by norm_num) hscale_two
  have hsqrtle : Real.sqrt scale ≤ scale := by
    have hsquare : (Real.sqrt scale) ^ 2 = scale :=
      Real.sq_sqrt (le_trans (by norm_num) hscale_two)
    have hsqrtnonneg : 0 ≤ Real.sqrt scale := Real.sqrt_nonneg _
    nlinarith
  have htermBound (a i : Nat) :
      (∫ z : JointWaveSpaceTime,
        (r.choose a : Real) * G0 * Real.sqrt scale *
          ‖iteratedFDeriv Real a
            (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖) ≤
        ((r.choose a : Real) * G0 *
          (∫ xi : Euclidean 2,
            ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
          (∫ t : Real, ‖rta_scratchWeightedTemporalDerivativeProfile h i L t‖)) * scale ^ 3 := by
    let c : Real := (r.choose a : Real) * G0 * Real.sqrt scale
    let IA : Real := ∫ xi : Euclidean 2,
      ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖
    let IH : Real := ∫ t : Real,
      ‖rta_scratchWeightedTemporalDerivativeProfile h i L t‖
    let J : Real := ∫ z : JointWaveSpaceTime,
      ‖iteratedFDeriv Real a
        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
      ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖
    have hc : 0 ≤ c := by
      dsimp only [c]
      positivity
    have hIA : 0 ≤ IA := by
      dsimp only [IA]
      exact integral_nonneg fun xi => norm_nonneg _
    have hIH : 0 ≤ IH := by
      dsimp only [IH]
      exact integral_nonneg fun t => norm_nonneg _
    have hJ : J ≤ scale ^ 2 * IA * IH := by
      dsimp only [J, IA, IH, q]
      simpa only [rta_scratchJointNormalDifference, rta_scratchScaledNormalExtension_apply] using
        rta_integral_joint_sheared_norm_iteratedFDeriv_scratchScaledAmplitude_le_scale_sq
          D scale hscale hscaleone a
          (rta_scratchWeightedTemporalDerivativeProfile h i L)
    have hlast : c * (scale ^ 2 * IA * IH) ≤
        ((r.choose a : Real) * G0 * IA * IH) * scale ^ 3 := by
      have hcoef : 0 ≤ (r.choose a : Real) * G0 * IA * IH * scale ^ 2 := by
        positivity
      calc
        c * (scale ^ 2 * IA * IH) =
            ((r.choose a : Real) * G0 * IA * IH * scale ^ 2) * Real.sqrt scale := by
          dsimp only [c]
          ring
        _ ≤ ((r.choose a : Real) * G0 * IA * IH * scale ^ 2) * scale := by
          exact mul_le_mul_of_nonneg_left hsqrtle hcoef
        _ = ((r.choose a : Real) * G0 * IA * IH) * scale ^ 3 := by ring
    calc
      (∫ z : JointWaveSpaceTime,
        (r.choose a : Real) * G0 * Real.sqrt scale *
          ‖iteratedFDeriv Real a
            (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
          ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖) = c * J := by
          rw [← integral_const_mul]
          apply integral_congr_ae
          filter_upwards with z
          dsimp only [c, J]
          ring
      _ ≤ c * (scale ^ 2 * IA * IH) :=
        mul_le_mul_of_nonneg_left hJ hc
      _ ≤ ((r.choose a : Real) * G0 * IA * IH) * scale ^ 3 := hlast
      _ = ((r.choose a : Real) * G0 *
          (∫ xi : Euclidean 2,
            ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
          (∫ t : Real, ‖rta_scratchWeightedTemporalDerivativeProfile h i L t‖)) * scale ^ 3 := by
          rfl
  have hMbound : (∫ z : JointWaveSpaceTime, M z) ≤ C * scale ^ 3 := by
    calc
      (∫ z : JointWaveSpaceTime, M z) =
          ∑ a ∈ Finset.range (r + 1), ∑ i ∈ Finset.range (r + 1),
            ∫ z : JointWaveSpaceTime,
              (r.choose a : Real) * G0 * Real.sqrt scale *
                ‖iteratedFDeriv Real a
                  (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by
          dsimp only [M]
          calc
            (∫ z : JointWaveSpaceTime,
                ∑ a ∈ Finset.range (r + 1), ∑ i ∈ Finset.range (r + 1),
                  (r.choose a : Real) * G0 * Real.sqrt scale *
                    ‖iteratedFDeriv Real a
                      (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                    ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖) =
                ∑ a ∈ Finset.range (r + 1),
                  ∫ z : JointWaveSpaceTime, ∑ i ∈ Finset.range (r + 1),
                    (r.choose a : Real) * G0 * Real.sqrt scale *
                      ‖iteratedFDeriv Real a
                        (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                      ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by
                exact integral_finsetSum _ fun a ha =>
                  integrable_finsetSum _ fun i hi => hMterm a i
            _ = ∑ a ∈ Finset.range (r + 1), ∑ i ∈ Finset.range (r + 1),
                ∫ z : JointWaveSpaceTime,
                  (r.choose a : Real) * G0 * Real.sqrt scale *
                    ‖iteratedFDeriv Real a
                      (rta_scratchScaledAmplitude D scale hscale : Euclidean 2 → Complex) z.fst‖ *
                    ‖rta_scratchWeightedTemporalDerivativeProfile h i L (q z)‖ := by
                apply Finset.sum_congr rfl
                intro a ha
                exact integral_finsetSum _ fun i hi => hMterm a i
      _ ≤ ∑ a ∈ Finset.range (r + 1), ∑ i ∈ Finset.range (r + 1),
          ((r.choose a : Real) * G0 *
            (∫ xi : Euclidean 2,
              ‖iteratedFDeriv Real a (D.amplitude : Euclidean 2 → Complex) xi‖) *
            (∫ t : Real, ‖rta_scratchWeightedTemporalDerivativeProfile h i L t‖)) * scale ^ 3 := by
          apply Finset.sum_le_sum
          intro a ha
          apply Finset.sum_le_sum
          intro i hi
          exact htermBound a i
      _ = C * scale ^ 3 := by
          dsimp only [C]
          conv_rhs => rw [Finset.sum_mul]
          apply Finset.sum_congr rfl
          intro a ha
          conv_rhs => rw [Finset.sum_mul]
  simpa only [L] using hInt.trans hMbound

end ScratchResidualMultiplierL1
section ScratchResidualMultiplierL1

/-- The preceding finite Leibniz estimate, with the harmless planar volume
and radial-count powers cancelled, gives arbitrary rapid derivative-integral
decay for the regular residual multiplier. -/
private theorem rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_scratchSmoothResidualProfile_le_uniform
    (D : MSSRadialTimeCutoffs) (r N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (rta_scratchSmoothResidualProfile D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  rcases rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_scratchSmoothResidualProfile_le
    D r N with ⟨C, hC, hmain⟩
  refine ⟨C, hC, ?_⟩
  intro scale hscale hscale_two
  have hscale3pos : 0 < scale ^ 3 := pow_pos hscale 3
  apply le_of_mul_le_mul_left (a := scale ^ 3) ?_ hscale3pos
  calc
    scale ^ 3 *
        (scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (rta_scratchSmoothResidualProfile D scale hscale
                (relevantRadialIndexEnumeration scale) :
                  JointWaveSpaceTime → Complex) z‖)) =
        scale ^ (N + 3) *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real r
              (rta_scratchSmoothResidualProfile D scale hscale
                (relevantRadialIndexEnumeration scale) :
                  JointWaveSpaceTime → Complex) z‖) := by
          rw [pow_add]
          ring
    _ ≤ C * scale ^ 3 := hmain scale hscale hscale_two
    _ = scale ^ 3 * C := by ring


end ScratchResidualMultiplierL1
private theorem rta_scratch_jointSchwartzRaw_integrable_prod
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    Integrable (fun z : WaveSpaceTime => M (WithLp.toLp 2 z))
      (volume.prod volume) := by
  have hpres : MeasurePreserving
      (MeasurableEquiv.toLp 2 WaveSpaceTime) volume volume :=
    WithLp.volume_preserving_toLp (Euclidean 2) Real
  exact
    (hpres.integrable_comp_emb
      (MeasurableEquiv.toLp 2 (Euclidean 2 × Real)).measurableEmbedding).mpr
      M.integrable

/-- The physical kernel of a joint Schwartz multiplier is itself the raw
representative of the inverse-Fourier Schwartz map. -/
private theorem rta_scratch_spaceTimeFourierInv_jointSchwartzRaw_eq_raw_fourierInv
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourierInv (jointSchwartzRaw M) =
      jointSchwartzRaw (FourierTransform.fourierInv M) := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  change FourierTransform.fourierInv (M : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 z) =
    (FourierTransform.fourierInv M : SchwartzMap JointWaveSpaceTime Complex)
      (WithLp.toLp 2 z)
  exact (congrFun (SchwartzMap.fourierInv_coe M) (WithLp.toLp 2 z)).symm

private theorem rta_scratch_continuous_spaceTimeFourierInv_jointSchwartzRaw
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    Continuous (spaceTimeFourierInv (jointSchwartzRaw M)) := by
  rw [rta_scratch_spaceTimeFourierInv_jointSchwartzRaw_eq_raw_fourierInv M]
  change Continuous (fun z : WaveSpaceTime =>
    (FourierTransform.fourierInv M : SchwartzMap JointWaveSpaceTime Complex)
      (WithLp.toLp 2 z))
  exact (FourierTransform.fourierInv M).continuous.comp
    (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)

private theorem rta_scratch_source_kernel_triple_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      (Real.fourierChar (inner Real zy.1.2 t) : Complex) *
        (Real.fourierChar (inner Real zy.1.1 x) : Complex) *
          M (WithLp.toLp 2 zy.1) *
            (Real.fourierChar (-inner Real zy.2 zy.1.1) : Complex) * f zy.2)
      ((volume.prod volume).prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hbase : Integrable (fun zy : WaveSpaceTime × Euclidean 2 =>
      Mraw zy.1 * f zy.2) ((volume.prod volume).prod volume) :=
    (rta_scratch_jointSchwartzRaw_integrable_prod M).mul_prod f.integrable
  refine hbase.congr' ?_ ?_
  · fun_prop
  · filter_upwards with zy
    simp only [Mraw, norm_mul, Circle.norm_coe, one_mul]
    ring

/-- Fubini form of the literal iterated inverse transform.  This is kept at
the raw product-coordinate level so it can be applied both to the kernel and
to the multiplier times the spatial Fourier transform of the input. -/
private theorem rta_scratch_spaceTimeFourierInv_eq_productIntegral
    (G : WaveSpaceTime → Complex)
    (hG : Integrable G (volume.prod volume))
    (u : Euclidean 2) (t : Real) :
    spaceTimeFourierInv G (u, t) =
      ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
  let Q : Euclidean 2 → Real → Complex := fun xi tau =>
    (Real.fourierChar (inner Real tau t) : Complex) *
      (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau)
  have hQ : Integrable (Function.uncurry Q) (volume.prod volume) := by
    have hphaseT : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.2 t) : Complex)) := by
      fun_prop
    have hphaseU : Continuous (fun z : WaveSpaceTime =>
        (Real.fourierChar (inner Real z.1 u) : Complex)) := by
      fun_prop
    refine hG.congr' ?_ ?_
    · exact
        ((hphaseT.aestronglyMeasurable.mul hphaseU.aestronglyMeasurable).mul
          hG.aestronglyMeasurable)
    · filter_upwards with z
      simp only [Q, Function.uncurry, norm_mul, Circle.norm_coe, one_mul]
  have hleft :
      spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := by
    unfold spaceTimeFourierInv
    rw [Real.fourierInv_eq]
    apply integral_congr_ae
    filter_upwards with tau
    rw [Real.fourierInv_eq]
    change
      (Real.fourierChar (inner Real tau t) : Complex) *
          ∫ xi : Euclidean 2,
            (Real.fourierChar (inner Real xi u) : Complex) * G (xi, tau) =
        ∫ xi : Euclidean 2, Q xi tau
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with xi
    simp only [Q]
    ring
  have hQswap : Integrable
      (Function.uncurry (fun tau : Real => fun xi : Euclidean 2 => Q xi tau))
      (volume.prod volume) := by
    convert hQ.swap using 1
    ext z
    rcases z with ⟨tau, xi⟩
    rfl
  have hswap :
      (∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau) =
        ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau :=
    integral_integral_swap hQswap
  have hprod :
      (∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau) =
        ∫ z : WaveSpaceTime, Q z.1 z.2 := by
    rw [Measure.volume_eq_prod]
    exact (integral_prod (Function.uncurry Q) hQ).symm
  calc
    spaceTimeFourierInv G (u, t) = ∫ tau : Real, ∫ xi : Euclidean 2, Q xi tau := hleft
    _ = ∫ xi : Euclidean 2, ∫ tau : Real, Q xi tau := hswap
    _ = ∫ z : WaveSpaceTime, Q z.1 z.2 := hprod
    _ = ∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 u) : Complex) * G z := by
      rfl

private theorem rta_scratch_jointSchwartz_mul_spatialFourier_integrable
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : WaveSpaceTime =>
      M (WithLp.toLp 2 z) *
        FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hfhat_le (xi : Euclidean 2) :
      ‖FourierTransform.fourier (f : Euclidean 2 → Complex) xi‖ ≤
        ∫ y : Euclidean 2, ‖f y‖ := by
    rw [Real.fourier_eq]
    calc
      ‖∫ y : Euclidean 2,
          Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ ≤
          ∫ y : Euclidean 2,
            ‖Real.fourierChar (-inner Real y xi) • (f : Euclidean 2 → Complex) y‖ :=
        norm_integral_le_integral_norm _
      _ = ∫ y : Euclidean 2, ‖f y‖ := by
        simp only [Circle.norm_smul]
  refine Integrable.mono'
    ((rta_scratch_jointSchwartzRaw_integrable_prod M).norm.mul_const
      (∫ y : Euclidean 2, ‖f y‖)) ?_ ?_
  · exact
      (rta_scratch_jointSchwartzRaw_integrable_prod M).aestronglyMeasurable.mul
        (((FourierTransform.fourier f : SchwartzMap (Euclidean 2) Complex).continuous.comp
          continuous_fst).aestronglyMeasurable)
  · filter_upwards with z
    rw [norm_mul]
    exact mul_le_mul_of_nonneg_left (hfhat_le z.1)
      (norm_nonneg (M (WithLp.toLp 2 z)))

/-- A joint Schwartz multiplier acting on the spatial Fourier transform of a
Schwartz input is literally convolution in the spatial variable with its
inverse joint Fourier kernel. -/
private theorem rta_scratch_spaceTimeFourierInv_jointSchwartz_mul_spatialFourier_eq_sourceKernel
    (M : SchwartzMap JointWaveSpaceTime Complex)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
  let Mraw : WaveSpaceTime → Complex := fun z => M (WithLp.toLp 2 z)
  have hM : Integrable Mraw (volume.prod volume) :=
    rta_scratch_jointSchwartzRaw_integrable_prod M
  have hMfhat : Integrable (fun z : WaveSpaceTime =>
      Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
      (volume.prod volume) := by
    simpa only [Mraw] using rta_scratch_jointSchwartz_mul_spatialFourier_integrable M f
  have htriple := rta_scratch_source_kernel_triple_integrable M f x t
  have hfourier (z : WaveSpaceTime) :
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 =
        ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
    rw [Real.fourier_eq]
    change
      (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
          ∫ y : Euclidean 2,
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y = _
    rw [← integral_const_mul]
    apply integral_congr_ae
    filter_upwards with y
    ring
  have hphase (xi y : Euclidean 2) :
      (Real.fourierChar (inner Real xi x) : Complex) *
          (Real.fourierChar (-inner Real y xi) : Complex) =
        (Real.fourierChar (inner Real xi (x - y)) : Complex) := by
    have harg :
        inner Real xi x + -inner Real y xi = inner Real xi (x - y) := by
      rw [inner_sub_right, real_inner_comm y xi]
      ring
    rw [← Circle.coe_mul, ← Real.fourierChar.map_add_eq_mul, harg]
  have hinner (y : Euclidean 2) :
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
        spaceTimeFourierInv Mraw (x - y, t) * f y := by
    calc
      (∫ z : WaveSpaceTime,
        (Real.fourierChar (inner Real z.2 t) : Complex) *
          (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
            (Real.fourierChar (-inner Real y z.1) : Complex) * f y) =
          ∫ z : WaveSpaceTime,
            ((Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            apply integral_congr_ae
            filter_upwards with z
            rw [← hphase z.1 y]
            ring
      _ = (∫ z : WaveSpaceTime,
            (Real.fourierChar (inner Real z.2 t) : Complex) *
              (Real.fourierChar (inner Real z.1 (x - y)) : Complex) * Mraw z) * f y := by
            rw [integral_mul_const]
      _ = spaceTimeFourierInv Mraw (x - y, t) * f y := by
            rw [← rta_scratch_spaceTimeFourierInv_eq_productIntegral Mraw hM (x - y) t]
  calc
    spaceTimeFourierInv
        (fun zeta : WaveSpaceTime =>
          jointSchwartzRaw M zeta *
            FourierTransform.fourier (f : Euclidean 2 → Complex) zeta.1)
        (x, t) =
        ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              FourierTransform.fourier (f : Euclidean 2 → Complex) z.1 := by
          simpa only [Mraw, jointSchwartzRaw, mul_assoc] using
            (rta_scratch_spaceTimeFourierInv_eq_productIntegral
              (fun z : WaveSpaceTime =>
                Mraw z * FourierTransform.fourier (f : Euclidean 2 → Complex) z.1)
              hMfhat x t)
    _ = ∫ z : WaveSpaceTime, ∫ y : Euclidean 2,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y := by
          apply integral_congr_ae
          filter_upwards with z
          exact hfourier z
    _ = ∫ y : Euclidean 2, ∫ z : WaveSpaceTime,
          (Real.fourierChar (inner Real z.2 t) : Complex) *
            (Real.fourierChar (inner Real z.1 x) : Complex) * Mraw z *
              (Real.fourierChar (-inner Real y z.1) : Complex) * f y :=
          integral_integral_swap htriple
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv Mraw (x - y, t) * f y := by
          apply integral_congr_ae
          filter_upwards with y
          exact hinner y
    _ = ∫ y : Euclidean 2,
          spaceTimeFourierInv (jointSchwartzRaw M) (x - y, t) * f y := by
          rfl

private theorem rta_scratch_sourceKernel_convolution_orientation
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (x : Euclidean 2) (t : Real) :
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
      ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
  let H : Euclidean 2 → Complex := fun u => K (u, t) * f (x - u)
  calc
    (∫ y : Euclidean 2, K (x - y, t) * f y) =
        ∫ y : Euclidean 2, H (x - y) := by
          apply integral_congr_ae
          filter_upwards with y
          simp only [H]
          have hxy : x - (x - y) = y := by abel
          rw [hxy]
    _ = ∫ u : Euclidean 2, H u :=
      integral_sub_left_eq_self H volume x
    _ = ∫ y : Euclidean 2, K (y, t) * f (x - y) := by
      rfl
/-- Fourier integration by parts reduces a physical joint-Schwartz seminorm
to literal frequency-side derivative `L¹` norms.  This is dimension-agnostic;
the intended use is the corrected radial--time residual multiplier. -/
private theorem rta_fourierInv_jointSchwartz_seminorm_le_derivativeIntegrals
    (Q : SchwartzMap JointWaveSpaceTime Complex) (N : Nat) :
    SchwartzMap.seminorm Complex N 0
      (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex) ≤
      (2 : Real) ^ N * ∑ n ∈ Finset.range (N + 1),
        ∫ zeta : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n (Q : JointWaveSpaceTime → Complex) zeta‖ := by
  apply SchwartzMap.seminorm_le_bound Complex N 0
    (𝓕⁻ Q : SchwartzMap JointWaveSpaceTime Complex)
  · exact mul_nonneg (by positivity)
      (Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _)
  · intro x
    rw [norm_iteratedFDeriv_zero]
    rw [SchwartzMap.fourierInv_coe]
    change ‖x‖ ^ N * ‖𝓕⁻ (Q : JointWaveSpaceTime → Complex) x‖ ≤ _
    have h := Real.pow_mul_norm_iteratedFDeriv_fourier_le
      (f := (Q : JointWaveSpaceTime → Complex)) (K := 0) (N := N)
      (Q.smooth N)
      (fun k n hk hn => by
        have hk' : k = 0 := by simpa using hk
        subst k
        simpa using SchwartzMap.integrable_pow_mul_iteratedFDeriv volume Q 0 n)
      (k := 0) (n := N) (by simp) (by simp) (-x)
    simpa [Real.fourierInv_eq_fourier_neg] using h
/-- The literal active radial--time residual is the spatial convolution by
the inverse joint transform of its f-independent residual multiplier.  This
private source-local identity is consumed by the mixed Young estimate. -/
private theorem rta_radialTimeResidual_eq_spatialConvolution_factorized
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        (fun _ => indices) scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv
            (jointSchwartzRaw
              (mssRadialTimeResidualMultiplier D scale hscale indices)) (y, t) *
          f (x - y) := by
  rw [radialTimeResidual_eq_inverse_factorizedResidualSpectrum
    D scale hscale indices f]
  rw [rta_scratch_spaceTimeFourierInv_jointSchwartz_mul_spatialFourier_eq_sourceKernel]
  exact rta_scratch_sourceKernel_convolution_orientation
    (spaceTimeFourierInv
      (jointSchwartzRaw (mssRadialTimeResidualMultiplier D scale hscale indices)))
    (f : Euclidean 2 → Complex) x t

/-- The same literal kernel identity in the source API's scale-indexed
enumeration form. -/
private theorem rta_radialTimeResidual_eq_spatialConvolution_factorized_of_indices
    (D : MSSRadialTimeCutoffs) (indices : Real → Finset Int)
    (scale : Real) (hscale : 0 < scale)
    (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) (t : Real) :
    radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
        indices scale (D.amplitude : Euclidean 2 → Complex)
        (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) =
      ∫ y : Euclidean 2,
        spaceTimeFourierInv
            (jointSchwartzRaw
              (mssRadialTimeResidualMultiplier D scale hscale (indices scale))) (y, t) *
          f (x - y) := by
  change radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
      (fun _ => indices scale) scale (D.amplitude : Euclidean 2 → Complex)
      (D.time : Real → Complex) (f : Euclidean 2 → Complex) (x, t) = _
  exact rta_radialTimeResidual_eq_spatialConvolution_factorized
    D scale hscale (indices scale) f x t
/-- The exact finite residual multiplier is pointwise the globally smooth
profile used for the normal-gap derivative estimate.  This private bridge
only relates the equivalent regular realizations in the radial--time proof. -/
private theorem rta_mssRadialTimeResidualMultiplier_eq_scratchSmoothResidualProfile
    (D : MSSRadialTimeCutoffs) (scale : Real) (hscale : 0 < scale)
    (indices : Finset Int) :
    mssRadialTimeResidualMultiplier D scale hscale indices =
      rta_scratchSmoothResidualProfile D scale hscale indices := by
  ext z
  have hz : WithLp.toLp 2 (z.fst, z.snd) = z := by
    apply (WithLp.ext_iff 2).2
    rfl
  rw [← hz]
  rw [mssRadialTimeResidualMultiplier_apply,
    rta_scratchSmoothResidualProfile_eq_literal_multiplier]
  simp only [verticalMultiplier, WithLp.toLp_fst, WithLp.toLp_snd]
  rw [scratchScaledNormalExtension_apply]
  unfold rta_scratchScaledNormalCoordinate
  ring

private theorem rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (r N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real r
            (mssRadialTimeResidualMultiplier D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ C := by
  rcases rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_scratchSmoothResidualProfile_le_uniform
      D r N with ⟨C, hC, hbound⟩
  refine ⟨C, hC, ?_⟩
  intro scale hscale hscale_two
  rw [rta_mssRadialTimeResidualMultiplier_eq_scratchSmoothResidualProfile]
  exact hbound scale hscale hscale_two
/-- A finite `Iic (6,0)` physical Schwartz seminorm budget for the actual
residual multiplier.  This is the exact finite package consumed by the
spatial-slice kernel estimate at temporal decay order two. -/
private theorem rta_exists_scale_pow_mul_iic_schwartzSeminorm_fourierInv_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (N : Nat) :
    ∃ C : Real, 0 ≤ C ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        ((Finset.Iic (6, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2)
          (𝓕⁻ (mssRadialTimeResidualMultiplier D scale hscale
            (relevantRadialIndexEnumeration scale)) :
            SchwartzMap JointWaveSpaceTime Complex) ≤ C := by
  let c : Nat → Real := fun n =>
    (rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose
  have hc_nonneg (n : Nat) : 0 ≤ c n := by
    exact (rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose_spec.1
  have hc_bound (n : Nat) : ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      scale ^ N *
        (∫ z : JointWaveSpaceTime,
          ‖iteratedFDeriv Real n
            (mssRadialTimeResidualMultiplier D scale hscale
              (relevantRadialIndexEnumeration scale) :
                JointWaveSpaceTime → Complex) z‖) ≤ c n := by
    intro scale hscale hscale_two
    exact (rta_exists_scale_pow_mul_integral_norm_iteratedFDeriv_mssRadialTimeResidualMultiplier_le
      D n N).choose_spec.2 scale hscale hscale_two
  let CD : Real := ∑ n ∈ Finset.range 7, c n
  have hCD_nonneg : 0 ≤ CD := by
    dsimp only [CD]
    exact Finset.sum_nonneg fun n hn => hc_nonneg n
  refine ⟨(2 : Real) ^ 6 * CD, mul_nonneg (by positivity) hCD_nonneg, ?_⟩
  intro scale hscale hscale_two
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let J : Finset (Nat × Nat) := Finset.Iic (6, 0)
  let P : Nat × Nat → Seminorm Complex (SchwartzMap JointWaveSpaceTime Complex) :=
    fun m => SchwartzMap.seminorm Complex m.1 m.2
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hscaleNnonneg : 0 ≤ scale ^ N := hscaleNpos.le
  have hsum {k : Nat} (hk : k ≤ 6) :
      scale ^ N *
        (∑ n ∈ Finset.range (k + 1),
          ∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) ≤ CD := by
    rw [Finset.mul_sum]
    calc
      ∑ n ∈ Finset.range (k + 1), scale ^ N *
          (∫ z : JointWaveSpaceTime,
            ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) ≤
          ∑ n ∈ Finset.range (k + 1), c n := by
            apply Finset.sum_le_sum
            intro n hn
            simpa only [M] using hc_bound n scale hscale hscale_two
      _ ≤ CD := by
            dsimp only [CD]
            apply Finset.sum_le_sum_of_subset_of_nonneg
            · exact (Finset.range_subset_range).2 (by omega)
            · intro n hn hnot
              exact hc_nonneg n
  have hPscaled (m : Nat × Nat) (hm : m ∈ J) :
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := by
    have hmle : m ≤ (6, 0) := Finset.mem_Iic.mp (by simpa only [J] using hm)
    have hmone : m.1 ≤ 6 := hmle.1
    have hmtwo : m.2 = 0 := Nat.eq_zero_of_le_zero hmle.2
    change scale ^ N *
        SchwartzMap.seminorm Complex m.1 m.2
          (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) ≤
        (2 : Real) ^ 6 * CD
    rw [hmtwo]
    have hsemi :=
      rta_fourierInv_jointSchwartz_seminorm_le_derivativeIntegrals M m.1
    have hsum' := hsum hmone
    have hsum'_nonneg : 0 ≤
        scale ^ N *
          (∑ n ∈ Finset.range (m.1 + 1),
            ∫ z : JointWaveSpaceTime,
              ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by
      apply mul_nonneg hscaleNnonneg
      exact Finset.sum_nonneg fun _ _ => integral_nonneg fun _ => norm_nonneg _
    calc
      scale ^ N *
          (SchwartzMap.seminorm Complex m.1 0
            (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) : Real) ≤ scale ^ N *
          ((2 : Real) ^ m.1 *
            ∑ n ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by
            exact mul_le_mul_of_nonneg_left hsemi hscaleNnonneg
      _ = (2 : Real) ^ m.1 *
          (scale ^ N *
            ∑ n ∈ Finset.range (m.1 + 1),
              ∫ z : JointWaveSpaceTime,
                ‖iteratedFDeriv Real n (M : JointWaveSpaceTime → Complex) z‖) := by ring
      _ ≤ (2 : Real) ^ 6 * CD := by
            exact mul_le_mul (pow_le_pow_right₀ (by norm_num) hmone) hsum'
              hsum'_nonneg (by positivity)
  have hsup : J.sup P (𝓕⁻ M) ≤ ((2 : Real) ^ 6 * CD) / scale ^ N := by
    apply Seminorm.finset_sup_apply_le
    · exact div_nonneg (mul_nonneg (by positivity) hCD_nonneg) hscaleNnonneg
    intro m hm
    apply (mul_le_mul_iff_of_pos_left hscaleNpos).mp
    calc
      scale ^ N * P m (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD := hPscaled m hm
      _ = scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) := by
        field_simp [hscaleNpos.ne']
  change scale ^ N * J.sup P (𝓕⁻ M) ≤ (2 : Real) ^ 6 * CD
  calc
    scale ^ N * J.sup P (𝓕⁻ M) ≤
        scale ^ N * (((2 : Real) ^ 6 * CD) / scale ^ N) :=
      mul_le_mul_of_nonneg_left hsup hscaleNnonneg
    _ = (2 : Real) ^ 6 * CD := by field_simp [hscaleNpos.ne']

/-- A joint Schwartz profile has an integrable planar spatial slice.  This
is kept private because it only supplies the real-to-ENNReal conversion in
the radial--time localization proof. -/
private theorem rta_integrable_jointSchwartzRaw_slice
    (K : SchwartzMap JointWaveSpaceTime Complex) (t : Real) :
    Integrable (fun x : Euclidean 2 => jointSchwartzRaw K (x, t)) volume := by
  let S : Real := (2 : Real) ^ 4 *
    ((Finset.Iic (4, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  have hrawcont : Continuous (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) := by
    change Continuous (fun x : Euclidean 2 => K (WithLp.toLp 2 (x, t)))
    exact K.continuous.comp
      ((WithLp.prod_continuous_toLp 2 (Euclidean 2) Real).comp
        (continuous_id.prodMk continuous_const))
  have hmeas : AEStronglyMeasurable (fun x : Euclidean 2 =>
      jointSchwartzRaw K (x, t)) volume := hrawcont.aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      ‖jointSchwartzRaw K (x, t)‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real)) := by
    intro x
    let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
    have hx : ‖x‖ ≤ ‖z‖ := by
      dsimp only [z]
      simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
        (WithLp.toLp 2 (x, t)))
    have hweight : (1 + ‖x‖) ^ 4 ≤ (1 + ‖z‖) ^ 4 := by
      gcongr
    have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
      (m := (4, (0 : Nat))) (k := 4) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
    simp only [norm_iteratedFDeriv_zero] at hsemi
    change ‖K z‖ ≤ S * (1 + ‖x‖) ^ (-(4 : Real))
    have hbase_pos : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hsemi' : (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤ S := by
      calc
        (1 + ‖x‖) ^ (4 : Nat) * ‖K z‖ ≤
            (1 + ‖z‖) ^ (4 : Nat) * ‖K z‖ :=
          mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
        _ ≤ S := hsemi
    have hdiv : ‖K z‖ ≤ S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase_pos).2 (by simpa [mul_comm] using hsemi')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      ‖K z‖ ≤ S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * (1 + ‖x‖) ^ (-(4 : Real)) := by
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hweight : Integrable (fun x : Euclidean 2 =>
      S * (1 + ‖x‖) ^ (-(4 : Real))) volume := by
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact (integrable_one_add_norm hdim).const_mul S
  exact hweight.mono' hmeas (Eventually.of_forall hpoint)

/-- The ENNReal form of a real weighted slice estimate. -/
private theorem rta_lintegral_enorm_slice_le_of_weighted_integral_norm_le
    {E : Type*} [NormedAddCommGroup E]
    (K : Euclidean 2 → Real → E)
    (hK : ∀ t : Real, Integrable (fun x : Euclidean 2 => K x t) volume)
    (A scale : Real) (N : Nat)
    (hbound : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K x t‖) ≤ A * (scale⁻¹) ^ N) :
    ∀ t : Real,
      (∫⁻ x : Euclidean 2, ‖K x t‖₊) ≤
        ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) := by
  intro t
  have hbase_pos : 0 < 1 + |t| := by positivity
  have hweight_pos : 0 < (1 + |t|) ^ 2 := pow_pos hbase_pos _
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖K x t‖ :=
    integral_nonneg fun _ => norm_nonneg _
  have hBnonneg : 0 ≤ A * (scale⁻¹) ^ N := by
    exact (mul_nonneg hweight_pos.le hInonneg).trans (hbound t)
  have hreal :
      (∫ x : Euclidean 2, ‖K x t‖) ≤
        (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
    calc
      (∫ x : Euclidean 2, ‖K x t‖) ≤
          (A * (scale⁻¹) ^ N) / (1 + |t|) ^ 2 :=
        (le_div_iff₀ hweight_pos).2 (by simpa [mul_comm] using hbound t)
      _ = (A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2 := by
        rw [div_eq_mul_inv, ← inv_pow]
  change (∫⁻ x : Euclidean 2, ‖K x t‖ₑ) ≤ _
  rw [← ofReal_integral_norm_eq_lintegral_enorm (hK t)]
  calc
    ENNReal.ofReal (∫ x : Euclidean 2, ‖K x t‖) ≤
        ENNReal.ofReal
          ((A * (scale⁻¹) ^ N) * ((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal (A * (scale⁻¹) ^ N) *
        ENNReal.ofReal (((1 + |t|)⁻¹) ^ 2) :=
      ENNReal.ofReal_mul hBnonneg

/- Direct Schwartz slice control, kept private to avoid a Mikhlin dependency. -/
private theorem rta_scratch_jointSchwartzRaw_pointwise_product_decay
    (K : SchwartzMap JointWaveSpaceTime Complex) (a b : Nat)
    (x : Euclidean 2) (t : Real) :
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b *
        ‖jointSchwartzRaw K (x, t)‖ ≤
      (2 : Real) ^ (a + b) *
        ((Finset.Iic (a + b, 0)).sup fun m =>
          SchwartzMap.seminorm Complex m.1 m.2) K := by
  let z : JointWaveSpaceTime := WithLp.toLp 2 (x, t)
  have hx : ‖x‖ ≤ ‖z‖ := by
    dsimp only [z]
    simpa using (WithLp.norm_fst_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t)))
  have ht : |t| ≤ ‖z‖ := by
    dsimp only [z]
    have hraw := WithLp.norm_snd_le (p := 2) (Euclidean 2)
      (WithLp.toLp 2 (x, t))
    simpa only [WithLp.toLp_snd, Real.norm_eq_abs] using hraw
  have hweight : (1 + ‖x‖) ^ a * (1 + |t|) ^ b ≤
      (1 + ‖z‖) ^ (a + b) := by
    rw [pow_add]
    gcongr <;> linarith
  have hsemi := SchwartzMap.one_add_le_sup_seminorm_apply (𝕜 := Complex)
    (m := (a + b, (0 : Nat))) (k := a + b) (n := (0 : Nat))
      (le_refl _) (le_refl _) K z
  simp only [norm_iteratedFDeriv_zero, pow_zero, mul_one] at hsemi
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K (WithLp.toLp 2 (x, t))‖ ≤ _
  change (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤ _
  calc
    (1 + ‖x‖) ^ a * (1 + |t|) ^ b * ‖K z‖ ≤
        (1 + ‖z‖) ^ (a + b) * ‖K z‖ := by
      exact mul_le_mul_of_nonneg_right hweight (norm_nonneg _)
    _ ≤ _ := hsemi

private theorem rta_scratch_weighted_spatial_mass_jointSchwartzRaw_le
    (K : SchwartzMap JointWaveSpaceTime Complex) (b : Nat) (t : Real) :
    (1 + |t|) ^ b *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      (2 : Real) ^ 4 *
        ((2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K +
        (2 : Real) ^ (4 + b) *
          ((Finset.Iic (4 + b, 0)).sup fun m =>
            SchwartzMap.seminorm Complex m.1 m.2) K) *
        (∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))) := by
  let T : Real := (1 + |t|) ^ b
  let S : Real := (2 : Real) ^ (4 + b) *
    ((Finset.Iic (4 + b, 0)).sup fun m =>
      SchwartzMap.seminorm Complex m.1 m.2) K
  let W : Euclidean 2 → Real := fun x => (1 + ‖x‖) ^ (-(4 : Real))
  have hT : 0 ≤ T := by
    dsimp only [T]
    positivity
  have hS : 0 ≤ S := by
    dsimp only [S]
    positivity
  have hrawcont : Continuous (fun z : WaveSpaceTime => K (WithLp.toLp 2 z)) :=
    K.continuous.comp (WithLp.prod_continuous_toLp 2 _ _)
  have hmeas : AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume := by
    change AEStronglyMeasurable
      (fun x : Euclidean 2 => T * ‖K (WithLp.toLp 2 (x, t))‖) volume
    exact (continuous_const.mul
      ((hrawcont.comp (continuous_id.prodMk continuous_const)).norm)).aestronglyMeasurable
  have hpoint : ∀ x : Euclidean 2,
      T * ‖jointSchwartzRaw K (x, t)‖ ≤ S * W x := by
    intro x
    have hprod := rta_scratch_jointSchwartzRaw_pointwise_product_decay K 4 b x t
    have hprod' : (1 + ‖x‖) ^ (4 : Nat) *
        (T * ‖jointSchwartzRaw K (x, t)‖) ≤ S := by
      simpa only [T, mul_assoc] using hprod
    have hbase : 0 < (1 + ‖x‖) ^ (4 : Nat) := by positivity
    have hdiv : T * ‖jointSchwartzRaw K (x, t)‖ ≤
        S / (1 + ‖x‖) ^ (4 : Nat) :=
      (le_div_iff₀ hbase).2 (by simpa [mul_comm] using hprod')
    rw [div_eq_mul_inv, ← inv_pow] at hdiv
    calc
      T * ‖jointSchwartzRaw K (x, t)‖ ≤
          S * (1 + ‖x‖)⁻¹ ^ (4 : Nat) := hdiv
      _ = S * W x := by
        dsimp only [W]
        congr 1
        rw [Real.rpow_neg (by positivity)]
        norm_num [Real.rpow_natCast, inv_pow]
  have hW : Integrable W volume := by
    dsimp only [W]
    have hdim : (Module.finrank Real (Euclidean 2) : Real) < 4 := by norm_num
    exact integrable_one_add_norm hdim
  have hmajor : Integrable (fun x : Euclidean 2 => S * W x) volume :=
    hW.const_mul S
  have hleftInt : Integrable
      (fun x : Euclidean 2 => T * ‖jointSchwartzRaw K (x, t)‖) volume :=
    hmajor.mono' hmeas (Eventually.of_forall fun x => by
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hT (norm_nonneg _))]
      exact hpoint x)
  have hmain : T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
      S * (∫ x : Euclidean 2, W x) := by
    calc
      T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) =
          ∫ x : Euclidean 2, T * ‖jointSchwartzRaw K (x, t)‖ := by
            rw [← integral_const_mul]
      _ ≤ ∫ x : Euclidean 2, S * W x :=
          integral_mono hleftInt hmajor hpoint
      _ = S * (∫ x : Euclidean 2, W x) := by
          rw [integral_const_mul]
  have hWnonneg : 0 ≤ ∫ x : Euclidean 2, W x :=
    integral_nonneg fun _ => by
      dsimp only [W]
      positivity
  have hcoef : S ≤ (2 : Real) ^ 4 * (S + S) := by
    norm_num
    linarith
  change T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
    (2 : Real) ^ 4 * (S + S) * (∫ x : Euclidean 2, W x)
  calc
    T * (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        S * (∫ x : Euclidean 2, W x) := hmain
    _ ≤ ((2 : Real) ^ 4 * (S + S)) * (∫ x : Euclidean 2, W x) :=
      mul_le_mul_of_nonneg_right hcoef hWnonneg
/-- The actual residual multiplier has a scale-uniform weighted real
spatial-slice bound at temporal decay order two. -/
private theorem rta_exists_scale_pow_mul_weighted_sliceMass_mssRadialTimeResidualMultiplier_le
    (D : MSSRadialTimeCutoffs) (N : Nat) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (scale : Real) (hscale : 0 < scale), 2 ≤ scale →
      ∀ t : Real,
        (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2,
            ‖jointSchwartzRaw
              (𝓕⁻ (mssRadialTimeResidualMultiplier D scale hscale
                (relevantRadialIndexEnumeration scale)) :
                  SchwartzMap JointWaveSpaceTime Complex) (x, t)‖) ≤
          A * (scale⁻¹) ^ N := by
  rcases rta_exists_scale_pow_mul_iic_schwartzSeminorm_fourierInv_mssRadialTimeResidualMultiplier_le
      D N with ⟨C, hC, hCbound⟩
  let I : Real := ∫ x : Euclidean 2, (1 + ‖x‖) ^ (-(4 : Real))
  let L : Real := (2 : Real) ^ 4 * ((2 : Real) ^ 6 + (2 : Real) ^ 6) * I
  have hI : 0 ≤ I := by
    dsimp only [I]
    exact integral_nonneg fun _ => Real.rpow_nonneg (by positivity) _
  have hL : 0 ≤ L := by
    dsimp only [L]
    exact mul_nonneg (mul_nonneg (by positivity) (by positivity)) hI
  refine ⟨L * C, mul_nonneg hL hC, ?_⟩
  intro scale hscale hscale_two t
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let K : SchwartzMap JointWaveSpaceTime Complex := 𝓕⁻ M
  let S : Real := ((Finset.Iic (6, 0)).sup fun m =>
    SchwartzMap.seminorm Complex m.1 m.2) K
  have hscaleNpos : 0 < scale ^ N := pow_pos hscale N
  have hS : scale ^ N * S ≤ C := by
    simpa only [M, K, S] using hCbound scale hscale hscale_two
  have hSbound : S ≤ C * (scale⁻¹) ^ N := by
    calc
      S ≤ C / scale ^ N :=
        (le_div_iff₀ hscaleNpos).2 (by simpa [mul_comm] using hS)
      _ = C * (scale⁻¹) ^ N := by
        rw [div_eq_mul_inv, inv_pow]
  have hslice := rta_scratch_weighted_spatial_mass_jointSchwartzRaw_le K 2 t
  calc
    (1 + |t|) ^ 2 *
        (∫ x : Euclidean 2, ‖jointSchwartzRaw K (x, t)‖) ≤
        (2 : Real) ^ 4 * ((2 : Real) ^ 6 * S + (2 : Real) ^ 6 * S) * I := by
          simpa only [K, S] using hslice
    _ = L * S := by
      dsimp only [L]
      ring
    _ ≤ L * (C * (scale⁻¹) ^ N) :=
      mul_le_mul_of_nonneg_left hSbound hL
    _ = (L * C) * (scale⁻¹) ^ N := by ring
private def rta_scratch_tailWeight (t : Real) : Real := (1 + t ^ 2)⁻¹

private theorem rta_scratch_tailWeight_nonneg (t : Real) :
    0 ≤ rta_scratch_tailWeight t := by
  unfold rta_scratch_tailWeight
  positivity

private theorem rta_scratch_tailWeight_le_one (t : Real) :
    rta_scratch_tailWeight t ≤ 1 := by
  unfold rta_scratch_tailWeight
  have hbase : 1 ≤ 1 + t ^ 2 := by nlinarith [sq_nonneg t]
  exact (inv_le_one₀ (by positivity)).mpr hbase

private theorem rta_scratch_tailWeight_continuous :
    Continuous rta_scratch_tailWeight := by
  unfold rta_scratch_tailWeight
  exact (continuous_const.add (continuous_id.pow 2)).inv₀
    (fun t => by
      have : 0 < 1 + t ^ 2 := by nlinarith [sq_nonneg t]
      exact ne_of_gt this)

private theorem rta_scratch_tailWeight_integrable :
    Integrable rta_scratch_tailWeight := by
  exact integrable_inv_one_add_sq

private theorem rta_scratch_tailWeight_rpow_integrable
    (p : ENNReal) (hp : 1 ≤ p) (htop : p ≠ ∞) :
    Integrable (fun t : Real => rta_scratch_tailWeight t ^ p.toReal) := by
  refine rta_scratch_tailWeight_integrable.mono' ?_ ?_
  · exact (rta_scratch_tailWeight_continuous.rpow_const
      (fun _ => Or.inr ENNReal.toReal_nonneg)).aestronglyMeasurable
  · filter_upwards with t
    rw [Real.norm_eq_abs,
      abs_of_nonneg (Real.rpow_nonneg (rta_scratch_tailWeight_nonneg t) _)]
    have hpReal : 1 ≤ p.toReal := by
      simpa using ENNReal.toReal_mono htop hp
    exact Real.rpow_le_self_of_le_one
      (rta_scratch_tailWeight_nonneg t) (rta_scratch_tailWeight_le_one t) hpReal

private theorem rta_scratch_tailWeight_eLpNorm_lt_top
    (p : ENNReal) (hp : 1 ≤ p) :
    eLpNorm rta_scratch_tailWeight p volume < ∞ := by
  by_cases htop : p = ∞
  · rw [htop, eLpNorm_exponent_top]
    exact eLpNormEssSup_lt_top_of_ae_bound
      (Eventually.of_forall fun t => by
        rw [Real.norm_eq_abs, abs_of_nonneg (rta_scratch_tailWeight_nonneg t)]
        exact rta_scratch_tailWeight_le_one t)
  · have hp0 : p ≠ 0 := by
      exact ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
    apply (eLpNorm_lt_top_iff_lintegral_rpow_enorm_lt_top hp0 htop).mpr
    have hpow := rta_scratch_tailWeight_rpow_integrable p hp htop
    have hfin :
        (∫⁻ t : Real, ‖rta_scratch_tailWeight t ^ p.toReal‖ₑ) < ∞ :=
      hpow.hasFiniteIntegral
    convert hfin using 1
    apply lintegral_congr
    intro t
    exact (Real.enorm_rpow_of_nonneg (rta_scratch_tailWeight_nonneg t)
      ENNReal.toReal_nonneg).symm

/-- All-exponent coefficient extraction: no finite-exponent case split is
needed here, so this includes `p = ∞`. -/
private theorem rta_scratch_eLpNorm_sliceMass_le_tailWeight
    (p : ENNReal) (S : Real → ENNReal) (c : ENNReal)
    (hS : ∀ t : Real,
      S t ≤ c * ENNReal.ofReal (rta_scratch_tailWeight t)) :
    eLpNorm S p volume ≤ c * eLpNorm rta_scratch_tailWeight p volume := by
  apply eLpNorm_le_mul_eLpNorm_of_ae_le_mul'' p
    rta_scratch_tailWeight_continuous.aestronglyMeasurable
  filter_upwards with t
  simpa [Real.enorm_of_nonneg (rta_scratch_tailWeight_nonneg t)] using hS t

private theorem rta_scratch_absTail_le_tailWeight (t : Real) :
    ((1 + |t|)⁻¹) ^ (2 : Nat) ≤ rta_scratch_tailWeight t := by
  have hpos : 0 < (1 + t ^ 2 : Real) := by nlinarith [sq_nonneg t]
  have hden : 1 + t ^ 2 ≤ (1 + |t|) ^ (2 : Nat) := by
    nlinarith [sq_abs t, abs_nonneg t]
  unfold rta_scratch_tailWeight
  have hinv := one_div_le_one_div_of_le hpos hden
  simpa [one_div, inv_pow] using hinv

/-- The final time-coefficient step for the active theorem.  A pointwise
`(1 + |t|)⁻²` slice estimate produces the required scale decay in every
extended exponent, including `∞`. -/

private theorem rta_scratch_eLpNorm_sliceMass_decay_all_p_of_real_bound_uniform
    (p : ENNReal) (hp : 1 ≤ p) (A : Real) (N : Nat) (hA : 0 ≤ A) :
    ∃ C : Real, 0 < C ∧ ∀ scale : Real, 0 < scale →
      ∀ S : Real → ENNReal,
      (∀ t : Real,
        S t ≤ ENNReal.ofReal
          (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat))) →
      eLpNorm S p volume ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) := by
  let W : ENNReal := eLpNorm rta_scratch_tailWeight p volume
  let B : Real := W.toReal
  have hWlt : W < ∞ := rta_scratch_tailWeight_eLpNorm_lt_top p hp
  have hW : W ≠ ∞ := hWlt.ne
  refine ⟨A * B + 1, ?_, ?_⟩
  · have hAB : 0 ≤ A * B := mul_nonneg hA ENNReal.toReal_nonneg
    linarith
  · intro scale hscale S hS
    have hsnonneg : 0 ≤ (scale⁻¹) ^ N := by
      exact pow_nonneg (inv_nonneg.mpr hscale.le) _
    have hAsnonneg : 0 ≤ A * (scale⁻¹) ^ N :=
      mul_nonneg hA hsnonneg
    have htail : ∀ t : Real,
        S t ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) *
          ENNReal.ofReal (rta_scratch_tailWeight t) := by
      intro t
      have ht := hS t
      rw [ENNReal.ofReal_mul hAsnonneg] at ht
      refine ht.trans ?_
      gcongr
      exact rta_scratch_absTail_le_tailWeight t
    have hcoeff := rta_scratch_eLpNorm_sliceMass_le_tailWeight p S
      (ENNReal.ofReal (A * (scale⁻¹) ^ N)) htail
    calc
      eLpNorm S p volume ≤ ENNReal.ofReal (A * (scale⁻¹) ^ N) * W := hcoeff
      _ = ENNReal.ofReal ((A * B) * (scale⁻¹) ^ N) := by
        rw [← ENNReal.ofReal_toReal hW]
        rw [← ENNReal.ofReal_mul hAsnonneg]
        congr 1
        ring
      _ ≤ ENNReal.ofReal ((A * B + 1) * (scale⁻¹) ^ N) := by
        apply ENNReal.ofReal_le_ofReal
        calc
          (A * B) * (scale⁻¹) ^ N ≤
              (A * B) * (scale⁻¹) ^ N + 1 * (scale⁻¹) ^ N :=
            le_add_of_nonneg_right (by simpa using hsnonneg)
          _ = (A * B + 1) * (scale⁻¹) ^ N := by ring

private theorem rta_scratch_ennreal_weighted_factor_of_holder
    {p r : Real} (hpq : r.HolderConjugate p) (a b : ENNReal) :
    a * b = a ^ r⁻¹ * (a * b ^ p) ^ p⁻¹ := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  have hbinv : (b ^ p) ^ p⁻¹ = b := by
    calc
      (b ^ p) ^ p⁻¹ = b ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
      _ = b := by rw [mul_inv_cancel₀ hp0.ne', ENNReal.rpow_one]
  rw [ENNReal.mul_rpow_of_nonneg _ _ hpq.symm.inv_nonneg]
  rw [hbinv]
  calc
    a * b = a ^ (r⁻¹ + p⁻¹) * b := by rw [hpq.inv_add_inv_eq_one, ENNReal.rpow_one]
    _ = (a ^ r⁻¹ * a ^ p⁻¹) * b := by
      rw [ENNReal.rpow_add_of_nonneg _ _ hpq.inv_nonneg hpq.symm.inv_nonneg]
    _ = a ^ r⁻¹ * (a ^ p⁻¹ * b) := by ring

private theorem rta_scratch_lintegral_spatial_p_pointwise
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) (x : Euclidean 2) :
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hr0 : 0 < r := hpq.pos
  let a : Euclidean 2 → ENNReal := fun y => K y ^ r⁻¹
  let b : Euclidean 2 → ENNReal := fun y =>
    (K y * q (x - y) ^ p) ^ p⁻¹
  have ha : AEMeasurable a volume := by
    exact (hK.pow measurable_const).aemeasurable
  have hqx : Measurable (fun y : Euclidean 2 => q (x - y)) :=
    hq.comp (measurable_const.sub measurable_id)
  have hb : AEMeasurable b volume := by
    exact ((hK.mul (hqx.pow measurable_const)).pow measurable_const).aemeasurable
  have hholder := ENNReal.lintegral_mul_le_Lp_mul_Lq volume hpq ha hb
  have hleft : (∫⁻ y : Euclidean 2, (a * b) y) =
      ∫⁻ y : Euclidean 2, K y * q (x - y) := by
    apply lintegral_congr
    intro y
    simp only [a, b, Pi.mul_apply]
    exact (rta_scratch_ennreal_weighted_factor_of_holder hpq (K y) (q (x - y))).symm
  have hfirst :
      (∫⁻ y : Euclidean 2, a y ^ r) = ∫⁻ y : Euclidean 2, K y := by
    apply lintegral_congr
    intro y
    simp only [a]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hr0.ne', ENNReal.rpow_one]
  have hsecond :
      (∫⁻ y : Euclidean 2, b y ^ p) =
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
    apply lintegral_congr
    intro y
    simp only [b]
    rw [← ENNReal.rpow_mul, inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]
  have hholder' :
      (∫⁻ y : Euclidean 2, K y * q (x - y)) ≤
        (∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹ := by
    rw [hleft, hfirst, hsecond] at hholder
    simpa only [one_div] using hholder
  have hrp : r⁻¹ * p = p - 1 := by
    rw [← hpq.symm.one_sub_inv]
    field_simp [hp0.ne']
  have hpow := ENNReal.rpow_le_rpow hholder' hp0.le
  calc
    (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
        ((∫⁻ y : Euclidean 2, K y) ^ r⁻¹ *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) ^ p⁻¹) ^ p := hpow
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p := by
      rw [ENNReal.mul_rpow_of_nonneg _ _ hp0.le]
      rw [← ENNReal.rpow_mul, ← ENNReal.rpow_mul, hrp,
        inv_mul_cancel₀ hp0.ne', ENNReal.rpow_one]

private theorem rta_scratch_lintegral_spatial_p_young
    (p r : Real) (hpq : r.HolderConjugate p)
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p ≤
      (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
  have hp0 : 0 < p := hpq.symm.pos
  have hpone : 1 ≤ p := hpq.symm.lt.le
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2) ^ p
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      ((hq.comp (measurable_fst.sub measurable_snd)).pow measurable_const)
  have hinner : Measurable (fun x : Euclidean 2 =>
      ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
    exact hH.lintegral_prod_right
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y) ^ p) = ∫⁻ x : Euclidean 2, q x ^ p := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp
      (hq.pow measurable_const)
  have hdouble :
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
        (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
    calc
      (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) =
          ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) ^ p := by
        exact lintegral_lintegral_swap hH.aemeasurable
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y) ^ p) := by
        apply lintegral_congr
        intro y
        simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
          (lintegral_const_mul (K y)
            ((hq.comp (measurable_id.sub measurable_const)).pow measurable_const))
      _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x ^ p) := by
        apply lintegral_congr
        intro y
        rw [htranslate y]
      _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p :=
        lintegral_mul_const _ hK
  calc
    (∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y * q (x - y)) ^ p) ≤
        ∫⁻ x : Euclidean 2, (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
          (∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      apply lintegral_mono
      intro x
      exact rta_scratch_lintegral_spatial_p_pointwise p r hpq K q hK hq x
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y) ^ p) := by
      rw [lintegral_const_mul _ hinner]
    _ = (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
        ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) := by
      rw [hdouble]
    _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
      calc
        (∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
            ((∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p) =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              ∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x ^ p := by
          ring
        _ =
            ((∫⁻ y : Euclidean 2, K y) ^ (p - 1) *
              (∫⁻ y : Euclidean 2, K y) ^ (1 : Real)) *
              ∫⁻ x : Euclidean 2, q x ^ p := by rw [ENNReal.rpow_one]
        _ = (∫⁻ y : Euclidean 2, K y) ^ ((p - 1) + 1) *
              ∫⁻ x : Euclidean 2, q x ^ p := by
          rw [← ENNReal.rpow_add_of_nonneg _ _
            (sub_nonneg.mpr hpone) (by norm_num : (0 : Real) ≤ 1)]
        _ = (∫⁻ y : Euclidean 2, K y) ^ p * ∫⁻ x : Euclidean 2, q x ^ p := by
          congr 2
          ring

private theorem rta_scratch_complex_spatial_convolution_p_moment
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
  have hpq : p.conjExponent.HolderConjugate p :=
    (Real.HolderConjugate.conjExponent hp).symm
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤
        ∫⁻ x : Euclidean 2,
          (∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ) ^ p := by
      apply lintegral_mono
      intro x
      exact ENNReal.rpow_le_rpow (hpoint x) (by positivity)
    _ ≤ (∫⁻ y : Euclidean 2, ‖K y‖ₑ) ^ p *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p :=
      rta_scratch_lintegral_spatial_p_young p p.conjExponent hpq
        (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ) hK.enorm hf.enorm

private theorem rta_scratch_ennreal_rpow_inv_cancel
    (p : Real) (hp : 0 < p) (a : ENNReal) :
    (a ^ p) ^ p⁻¹ = a := by
  calc
    (a ^ p) ^ p⁻¹ = a ^ (p * p⁻¹) := (ENNReal.rpow_mul _ _ _).symm
    _ = a := by rw [mul_inv_cancel₀ hp.ne', ENNReal.rpow_one]

private theorem rta_scratch_complex_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (ENNReal.ofReal p) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (ENNReal.ofReal p) volume := by
  have hp0 : 0 < p := lt_trans zero_lt_one hp
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hmoment :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ≤ L ^ p * J := by
    simpa only [L, J] using rta_scratch_complex_spatial_convolution_p_moment p hp K f hK hf
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp0) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp0.le]
  have hroot :
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
        L * J ^ p⁻¹ := by
    calc
      (∫⁻ x : Euclidean 2,
          ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ^ p) ^ p⁻¹ ≤
          (L ^ p * J) ^ p⁻¹ := ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp0.le)
      _ = (L ^ p) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp0.le)
      _ = L * J ^ p⁻¹ := by rw [rta_scratch_ennreal_rpow_inv_cancel p hp0]
  convert hroot using 1 <;> simp only [L, J, one_div]

private theorem rta_scratch_lintegral_spatial_one_young
    (K q : Euclidean 2 → ENNReal)
    (hK : Measurable K) (hq : Measurable q) :
    (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y)) =
      (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x := by
  let H : Euclidean 2 × Euclidean 2 → ENNReal := fun z =>
    K z.2 * q (z.1 - z.2)
  have hH : Measurable H := by
    exact (hK.comp measurable_snd).mul
      (hq.comp (measurable_fst.sub measurable_snd))
  have htranslate (y : Euclidean 2) :
      (∫⁻ x : Euclidean 2, q (x - y)) = ∫⁻ x : Euclidean 2, q x := by
    exact (measurePreserving_sub_right (volume : Measure (Euclidean 2)) y).lintegral_comp hq
  calc
    (∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, K y * q (x - y)) =
        ∫⁻ y : Euclidean 2, ∫⁻ x : Euclidean 2, K y * q (x - y) := by
      exact lintegral_lintegral_swap hH.aemeasurable
    _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q (x - y)) := by
      apply lintegral_congr
      intro y
      simpa only [Function.comp_apply, Pi.sub_apply, id_eq] using
        (lintegral_const_mul (K y) (hq.comp (measurable_id.sub measurable_const)))
    _ = ∫⁻ y : Euclidean 2, K y * (∫⁻ x : Euclidean 2, q x) := by
      apply lintegral_congr
      intro y
      rw [htranslate y]
    _ = (∫⁻ y : Euclidean 2, K y) * ∫⁻ x : Euclidean 2, q x :=
      lintegral_mul_const _ hK

private theorem rta_scratch_complex_spatial_convolution_one_young
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) (1 : ENNReal) volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f (1 : ENNReal) volume := by
  rw [eLpNorm_one_eq_lintegral_enorm]
  rw [eLpNorm_one_eq_lintegral_enorm]
  have hpoint (x : Euclidean 2) :
      ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
    change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ _
    calc
      ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
        enorm_integral_le_lintegral_enorm _
      _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
        apply lintegral_congr
        intro y
        rw [enorm_mul]
  calc
    (∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ) ≤
        ∫⁻ x : Euclidean 2, ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      apply lintegral_mono
      intro x
      exact hpoint x
    _ = (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * ∫⁻ x : Euclidean 2, ‖f x‖ₑ :=
      rta_scratch_lintegral_spatial_one_young (fun y => ‖K y‖ₑ) (fun x => ‖f x‖ₑ)
        hK.enorm hf.enorm

private theorem rta_scratch_complex_spatial_convolution_top_young
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) :
    eLpNorm (K ⋆[ContinuousLinearMap.mul Complex Complex] f) ∞ volume ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) * eLpNorm f ∞ volume := by
  rw [eLpNorm_exponent_top]
  let L : ENNReal := ∫⁻ y : Euclidean 2, ‖K y‖ₑ
  let C : ENNReal := eLpNorm f ∞ volume
  have hfess : ∀ᵐ z : Euclidean 2 ∂volume, ‖f z‖ₑ ≤ C := by
    simpa only [C, eLpNorm_exponent_top] using
      (enorm_ae_le_eLpNormEssSup f volume)
  apply eLpNormEssSup_le_of_ae_enorm_bound
  apply Eventually.of_forall
  intro x
  have hshift : ∀ᵐ y : Euclidean 2 ∂volume, ‖f (x - y)‖ₑ ≤ C := by
    exact (volume.measurePreserving_sub_left x).quasiMeasurePreserving.ae hfess
  change ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤ L * C
  calc
    ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
        ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
      calc
        ‖∫ y : Euclidean 2, K y * f (x - y)‖ₑ ≤
            ∫⁻ y : Euclidean 2, ‖K y * f (x - y)‖ₑ :=
          enorm_integral_le_lintegral_enorm _
        _ = ∫⁻ y : Euclidean 2, ‖K y‖ₑ * ‖f (x - y)‖ₑ := by
          apply lintegral_congr
          intro y
          rw [enorm_mul]
    _ ≤ ∫⁻ y : Euclidean 2, ‖K y‖ₑ * C := by
      apply lintegral_mono_ae
      filter_upwards [hshift] with y hy
      gcongr
    _ = L * C := by
      exact lintegral_mul_const C hK.enorm

private theorem rta_scratch_mixed_p_lift_of_slice_moment
    (p : Real) (hp : 0 < p)
    (G : WaveSpaceTime → Complex) (A : Real → ENNReal)
    (f : Euclidean 2 → Complex)
    (hG : AEMeasurable G volume)
    (hA : Measurable A)
    (hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p) :
    eLpNorm G (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * eLpNorm f (ENNReal.ofReal p) volume := by
  let F : WaveSpaceTime → ENNReal := fun z => ‖G z‖ₑ ^ p
  let J : ENNReal := ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p
  have hF : AEMeasurable F volume := by
    exact hG.enorm.pow measurable_const.aemeasurable
  have hFprod : AEMeasurable F
      ((volume : Measure (Euclidean 2)).prod volume) := by
    rw [← Measure.volume_eq_prod (Euclidean 2) Real]
    exact hF
  have hFswap : AEMeasurable (fun z : Real × Euclidean 2 => F z.swap)
      (volume.prod volume) := by
    change AEMeasurable (F ∘ Prod.swap) (volume.prod volume)
    exact hFprod.comp_quasiMeasurePreserving
      ((Measure.measurePreserving_swap : MeasurePreserving Prod.swap
        (volume.prod volume) (volume.prod volume)).quasiMeasurePreserving)
  have hFubini :
      (∫⁻ z : WaveSpaceTime, F z) =
        ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    calc
      (∫⁻ z : Euclidean 2 × Real, F z ∂volume.prod volume) =
          ∫⁻ z : Real × Euclidean 2, F z.swap ∂volume.prod volume :=
        (lintegral_prod_swap F).symm
      _ = ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := by
        rw [lintegral_prod _ hFswap]
        rfl
  have hmoment :
      (∫⁻ z : WaveSpaceTime, F z) ≤ (∫⁻ t : Real, A t) * J := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) =
          ∫⁻ t : Real, ∫⁻ x : Euclidean 2, F (x, t) := hFubini
      _ ≤ ∫⁻ t : Real, A t * J := by
        apply lintegral_mono
        intro t
        simpa only [F, J] using hpoint t
      _ = (∫⁻ t : Real, A t) * J := lintegral_mul_const J hA
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  rw [eLpNorm_eq_lintegral_rpow_enorm_toReal
    (ENNReal.ofReal_ne_zero_iff.mpr hp) ENNReal.ofReal_ne_top]
  simp only [ENNReal.toReal_ofReal hp.le]
  have hroot : (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
      (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ := by
    calc
      (∫⁻ z : WaveSpaceTime, F z) ^ p⁻¹ ≤
          ((∫⁻ t : Real, A t) * J) ^ p⁻¹ :=
        ENNReal.rpow_le_rpow hmoment (inv_nonneg.mpr hp.le)
      _ = (∫⁻ t : Real, A t) ^ p⁻¹ * J ^ p⁻¹ :=
        ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le)
  convert hroot using 1 <;> simp only [F, J, one_div]

private theorem rta_scratch_complex_spatial_convolution_one_moment
    (K f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f) :
    ∫⁻ x : Euclidean 2,
        ‖(K ⋆[ContinuousLinearMap.mul Complex Complex] f) x‖ₑ ≤
      (∫⁻ y : Euclidean 2, ‖K y‖ₑ) *
        ∫⁻ x : Euclidean 2, ‖f x‖ₑ := by
  simpa only [eLpNorm_one_eq_lintegral_enorm] using
    rta_scratch_complex_spatial_convolution_one_young K f hK hf

private theorem rta_scratch_mixed_spatial_convolution_one_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        (1 : ENNReal) volume ≤
      (∫⁻ t : Real, ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) * eLpNorm f (1 : ENNReal) volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA : Measurable A := by
    exact hKswap.lintegral_prod_right
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ (1 : Real) ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ (1 : Real) := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply', ENNReal.rpow_one] using
      rta_scratch_complex_spatial_convolution_one_moment (fun x : Euclidean 2 => K (x, t)) f hKt hf
  simpa only [G, A, ENNReal.ofReal_one, inv_one, ENNReal.rpow_one] using
    rta_scratch_mixed_p_lift_of_slice_moment 1 (by norm_num) G A f
      (by simpa only [G] using hG) hA hpoint

private theorem rta_scratch_mixed_spatial_convolution_p_young
    (p : Real) (hp : 1 < p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        (ENNReal.ofReal p) volume ≤
      (∫⁻ t : Real, (∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ^ p) ^ p⁻¹ *
        eLpNorm f (ENNReal.ofReal p) volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t =>
    (∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ^ p
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA0 : Measurable (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) := by
    exact hKswap.lintegral_prod_right
  have hA : Measurable A := by
    exact hA0.pow measurable_const
  have hpoint : ∀ t : Real,
      ∫⁻ x : Euclidean 2, ‖G (x, t)‖ₑ ^ p ≤
        A t * ∫⁻ x : Euclidean 2, ‖f x‖ₑ ^ p := by
    intro t
    have hKt : Measurable (fun x : Euclidean 2 => K (x, t)) :=
      hK.comp (measurable_id.prodMk measurable_const)
    simpa only [G, A, convolution_def, ContinuousLinearMap.mul_apply'] using
      rta_scratch_complex_spatial_convolution_p_moment p hp
        (fun x : Euclidean 2 => K (x, t)) f hKt hf
  simpa only [G, A] using
    rta_scratch_mixed_p_lift_of_slice_moment p (lt_trans zero_lt_one hp) G A f
      (by simpa only [G] using hG) hA hpoint

private theorem rta_scratch_mixed_spatial_convolution_top_young
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        ∞ volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) ∞ volume *
        eLpNorm f ∞ volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  let B : ENNReal := eLpNorm A ∞ volume
  let C : ENNReal := eLpNorm f ∞ volume
  have hKswap : Measurable (fun z : Real × Euclidean 2 => ‖K z.swap‖ₑ) :=
    hK.enorm.comp measurable_swap
  have hA : Measurable A := by
    exact hKswap.lintegral_prod_right
  have hfess : ∀ᵐ y : Euclidean 2 ∂volume, ‖f y‖ₑ ≤ C := by
    simpa only [C, eLpNorm_exponent_top] using
      (enorm_ae_le_eLpNormEssSup f volume)
  have hAess : ∀ᵐ t : Real ∂volume, A t ≤ B := by
    simpa only [A, B, eLpNorm_exponent_top, enorm_eq_self] using
      (enorm_ae_le_eLpNormEssSup A volume)
  have hAprod : ∀ᵐ z : WaveSpaceTime ∂volume, A z.2 ≤ B := by
    rw [Measure.volume_eq_prod (Euclidean 2) Real]
    exact Measure.quasiMeasurePreserving_snd.ae hAess
  have hfixed (x : Euclidean 2) (t : Real) : ‖G (x, t)‖ₑ ≤ A t * C := by
    have hshift : ∀ᵐ y : Euclidean 2 ∂volume, ‖f (x - y)‖ₑ ≤ C := by
      exact (volume.measurePreserving_sub_left x).quasiMeasurePreserving.ae hfess
    change ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤ A t * C
    calc
      ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤
          ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * ‖f (x - y)‖ₑ := by
        calc
          ‖∫ y : Euclidean 2, K (y, t) * f (x - y)‖ₑ ≤
              ∫⁻ y : Euclidean 2, ‖K (y, t) * f (x - y)‖ₑ :=
            enorm_integral_le_lintegral_enorm _
          _ = ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * ‖f (x - y)‖ₑ := by
            apply lintegral_congr
            intro y
            rw [enorm_mul]
      _ ≤ ∫⁻ y : Euclidean 2, ‖K (y, t)‖ₑ * C := by
        apply lintegral_mono_ae
        filter_upwards [hshift] with y hy
        gcongr
      _ = A t * C := by
        exact lintegral_mul_const C
          ((hK.comp (measurable_id.prodMk measurable_const)).enorm)
  change eLpNorm G ∞ volume ≤ eLpNorm A ∞ volume * eLpNorm f ∞ volume
  rw [eLpNorm_exponent_top]
  change eLpNormEssSup G volume ≤ B * C
  apply eLpNormEssSup_le_of_ae_enorm_bound
  filter_upwards [hAprod] with z hz
  exact (hfixed z.1 z.2).trans (by gcongr)

private theorem rta_scratch_mixed_spatial_convolution_young
    (p : ENNReal) (hp : 1 ≤ p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Measurable K) (hf : Measurable f)
    (hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        p volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) p volume *
        eLpNorm f p volume := by
  let G : WaveSpaceTime → Complex :=
    fun z => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)
  let A : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  change eLpNorm G p volume ≤ eLpNorm A p volume * eLpNorm f p volume
  by_cases htop : p = ∞
  · subst p
    simpa only [G, A] using rta_scratch_mixed_spatial_convolution_top_young K f hK
  by_cases hone : p = 1
  · subst p
    simpa only [G, A, eLpNorm_one_eq_lintegral_enorm, enorm_eq_self] using
      rta_scratch_mixed_spatial_convolution_one_young K f hK hf hG
  have hpone : 1 < p := lt_of_le_of_ne hp (Ne.symm hone)
  have hpreal : 1 < p.toReal := by
    simpa using ENNReal.toReal_strict_mono htop hpone
  have hpzero : p ≠ 0 := ne_of_gt (lt_of_lt_of_le zero_lt_one hp)
  have hpof : ENNReal.ofReal p.toReal = p := ENNReal.ofReal_toReal htop
  have hcoef :
      (∫⁻ t : Real, A t ^ p.toReal) ^ p.toReal⁻¹ = eLpNorm A p volume := by
    rw [eLpNorm_eq_lintegral_rpow_enorm_toReal hpzero htop]
    simp only [enorm_eq_self, one_div]
  have hreal :
      eLpNorm G (ENNReal.ofReal p.toReal) volume ≤
        (∫⁻ t : Real, A t ^ p.toReal) ^ p.toReal⁻¹ *
          eLpNorm f (ENNReal.ofReal p.toReal) volume := by
    simpa only [G, A] using
      rta_scratch_mixed_spatial_convolution_p_young p.toReal hpreal K f hK hf hG
  simpa only [hpof, hcoef] using hreal
private theorem rta_scratch_mixed_spatial_convolution_young_of_continuous
    (p : ENNReal) (hp : 1 ≤ p)
    (K : WaveSpaceTime → Complex) (f : Euclidean 2 → Complex)
    (hK : Continuous K) (hf : Continuous f) :
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y))
        p volume ≤
      eLpNorm (fun t : Real => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ) p volume *
        eLpNorm f p volume := by
  have hjoint : Continuous (fun zy : WaveSpaceTime × Euclidean 2 =>
      K (zy.2, zy.1.2) * f (zy.1.1 - zy.2)) :=
    (hK.comp (continuous_snd.prodMk continuous_fst.snd)).mul
      (hf.comp (continuous_fst.fst.sub continuous_snd))
  have hG : AEMeasurable
      (fun z : WaveSpaceTime => ∫ y : Euclidean 2, K (y, z.2) * f (z.1 - y)) volume := by
    exact hjoint.stronglyMeasurable.integral_prod_right'.aemeasurable
  exact rta_scratch_mixed_spatial_convolution_young p hp K f hK.measurable hf.measurable hG
/-- The literal iterated inverse transform of a joint Schwartz multiplier is
the raw representative of its canonical inverse Fourier transform. -/
private theorem rta_spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv
    (M : SchwartzMap JointWaveSpaceTime Complex) :
    spaceTimeFourierInv (jointSchwartzRaw M) =
      jointSchwartzRaw (𝓕⁻ M) := by
  funext z
  rw [spaceTimeFourierInv_jointSchwartzRaw]
  change FourierTransform.fourierInv (M : JointWaveSpaceTime → Complex)
      (WithLp.toLp 2 z) =
    (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z)
  exact (congrFun (SchwartzMap.fourierInv_coe M) (WithLp.toLp 2 z)).symm
/-- Internal closure of the radial--time localization predicate.  Every
constant is extracted from the supplied compact cutoff data, rather than
assumed as a kernel or seminorm hypothesis. -/
private theorem rta_radialTimeLocalization_of_MSSRadialTimeCutoffs_aux
    (D : MSSRadialTimeCutoffs) : radialTimeLocalization D := by
  intro p N hp
  rcases rta_exists_scale_pow_mul_weighted_sliceMass_mssRadialTimeResidualMultiplier_le
      D N with ⟨A, hA, hAbound⟩
  rcases rta_scratch_eLpNorm_sliceMass_decay_all_p_of_real_bound_uniform
      p hp A N hA with ⟨C, hCpos, hCbound⟩
  refine ⟨C, hCpos, ?_⟩
  intro scale hscale_two f
  have hscale : 0 < scale := lt_of_lt_of_le (by norm_num) hscale_two
  let M : SchwartzMap JointWaveSpaceTime Complex :=
    mssRadialTimeResidualMultiplier D scale hscale
      (relevantRadialIndexEnumeration scale)
  let K : WaveSpaceTime → Complex :=
    spaceTimeFourierInv (jointSchwartzRaw M)
  have hKraw : K = jointSchwartzRaw (𝓕⁻ M) := by
    dsimp only [K]
    exact rta_spaceTimeFourierInv_jointSchwartzRaw_eq_jointSchwartzRaw_fourierInv M
  have hKcont : Continuous K := by
    rw [hKraw]
    change Continuous (fun z : WaveSpaceTime =>
      (𝓕⁻ M : SchwartzMap JointWaveSpaceTime Complex) (WithLp.toLp 2 z))
    exact (𝓕⁻ M).continuous.comp
      (WithLp.prod_continuous_toLp 2 (Euclidean 2) Real)
  have hKslice : ∀ t : Real,
      Integrable (fun x : Euclidean 2 => K (x, t)) volume := by
    intro t
    rw [hKraw]
    exact rta_integrable_jointSchwartzRaw_slice (𝓕⁻ M) t
  have hweighted : ∀ t : Real,
      (1 + |t|) ^ 2 *
          (∫ x : Euclidean 2, ‖K (x, t)‖) ≤ A * (scale⁻¹) ^ N := by
    intro t
    rw [hKraw]
    simpa only [M] using hAbound scale hscale hscale_two t
  let S : Real → ENNReal := fun t => ∫⁻ x : Euclidean 2, ‖K (x, t)‖ₑ
  have hS : ∀ t : Real,
      S t ≤ ENNReal.ofReal
        (A * (scale⁻¹) ^ N * ((1 + |t|)⁻¹) ^ (2 : Nat)) := by
    intro t
    dsimp only [S]
    have hslice := rta_lintegral_enorm_slice_le_of_weighted_integral_norm_le
      (fun x t => K (x, t)) hKslice A scale N hweighted t
    rw [ENNReal.ofReal_mul (mul_nonneg hA
      (pow_nonneg (inv_nonneg.mpr hscale.le) _))]
    exact hslice
  have hSbound := hCbound scale hscale S hS
  have hYoung := rta_scratch_mixed_spatial_convolution_young_of_continuous
    p hp K (f : Euclidean 2 → Complex) hKcont f.continuous
  have hres :
      radialTimeResidual (D.vertical : Real → Complex) (D.radial : Real → Complex)
          relevantRadialIndexEnumeration scale (D.amplitude : Euclidean 2 → Complex)
          (D.time : Real → Complex) (f : Euclidean 2 → Complex) =
        fun z : WaveSpaceTime => ∫ y : Euclidean 2,
          K (y, z.2) * f (z.1 - y) := by
    funext z
    exact rta_radialTimeResidual_eq_spatialConvolution_factorized_of_indices
      D relevantRadialIndexEnumeration scale hscale f z.1 z.2
  rw [hres]
  calc
    eLpNorm (fun z : WaveSpaceTime => ∫ y : Euclidean 2,
        K (y, z.2) * f (z.1 - y)) p volume ≤
        eLpNorm S p volume * eLpNorm (f : Euclidean 2 → Complex) p volume := by
          simpa only [S] using hYoung
    _ ≤ ENNReal.ofReal (C * (scale⁻¹) ^ N) *
        eLpNorm (f : Euclidean 2 → Complex) p volume :=
      mul_le_mul_left hSbound _
end RadialTimeLocalizationAux

/-- The corrected compact radial--time cutoff data satisfy the blueprint's
all-exponent localization estimate. -/
theorem radialTimeLocalization_of_MSSRadialTimeCutoffs
    (D : MSSRadialTimeCutoffs) : radialTimeLocalization D :=
  rta_radialTimeLocalization_of_MSSRadialTimeCutoffs_aux D


