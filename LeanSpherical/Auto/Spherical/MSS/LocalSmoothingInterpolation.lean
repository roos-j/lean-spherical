      (ENNReal.ofReal (t / 2)) ^ q * w t = wa t := by
    have htzero : ENNReal.ofReal t ≠ 0 := (ENNReal.ofReal_pos.mpr ht).ne'
    have httop : ENNReal.ofReal t ≠ ⊤ := ENNReal.ofReal_ne_top
    have hhalf : ENNReal.ofReal (t / 2) =
