    (u : α → Real) (hu : Measurable u) (hu_nonneg : ∀ x, 0 ≤ u x)
    (low : Real → α → E)
    {p q : Real} (hp : 0 < p) (hpq : p < q)
    (hlow_small : ∀ t x, 0 < t → t ≤ u x →
