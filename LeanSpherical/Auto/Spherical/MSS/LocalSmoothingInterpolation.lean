  let w : Real → ENNReal := fun t => (ENNReal.ofReal t) ^ (p - q - 1)
  let a : Real → α → ENNReal := fun t x =>
    ({x | t ≤ u x}).indicator (fun _ => (ENNReal.ofReal (t / 2)) ^ q) x
  let b : Real → α → ENNReal := fun t x =>
    ({x | u x < t}).indicator (fun x => (ENNReal.ofReal (u x)) ^ q) x
