      (∫⁻ t in Ioi (0 : Real), (∫⁻ x, a t x ∂μ) * w t) +
        ∫⁻ t in Ioi (0 : Real), (∫⁻ x, b t x ∂μ) * w t := by
    calc
      (∫⁻ t in Ioi (0 : Real),
          (∫⁻ x, a t x + b t x ∂μ) * w t) =
          ∫⁻ t in Ioi (0 : Real),
