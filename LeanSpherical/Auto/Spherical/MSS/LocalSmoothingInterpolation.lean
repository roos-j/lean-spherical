/-- The literal cutoff half-wave on the Schwartz core obeys the supplied-split
`L⁴`--`L∞` interpolation estimate.  The top endpoint is transported through
`localDyadicHalfWaveMagnitude`, so it is never asserted outside `[1,2]`. -/
theorem mss_four_top_coefficient
    (C : lpCutoffs 2) (σ : WaveSign) (j : Nat)
    {p : Real} (hp4 : 4 < p)
    (B4 : ENNReal)
    (hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume)
    (Btop : Real) (hBtop : 0 < Btop)
    (hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ Btop * a)
    (f : SchwartzMap (Euclidean 2) Complex) :
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure ≤
      ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
      eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
  letI : SFinite localSmoothingMeasure := by
    rw [localSmoothingMeasure]
    infer_instance
  let D : Set (SchwartzMap (Euclidean 2) Complex) := Set.univ
  let eval : SchwartzMap (Euclidean 2) Complex → Euclidean 2 → Complex := fun g => g
  let T : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g => localDyadicHalfWaveMagnitude C σ j g
  let S : SchwartzMap (Euclidean 2) Complex → Euclidean 2 × Real → Real :=
    fun g z => T g z / Btop
  have hSnonneg : ∀ g z, 0 ≤ S g z := by
    intro g z
    exact div_nonneg (localDyadicHalfWaveMagnitude_nonneg C σ j g z) hBtop.le
  have hSsub : ∀ ⦃g h : SchwartzMap (Euclidean 2) Complex⦄,
      g ∈ D → h ∈ D → ∀ z, S (g + h) z ≤ S g z + S h z := by
    intro g h _ _ z
    change T (g + h) z / Btop ≤ T g z / Btop + T h z / Btop
    rw [← add_div]
    exact div_le_div_of_nonneg_right
      (localDyadicHalfWaveMagnitude_add_le C σ j g h z) hBtop.le
  have hSmeas : ∀ g, g ∈ D → AEStronglyMeasurable (S g) localSmoothingMeasure := by
    intro g _
    exact ((measurable_localDyadicHalfWaveMagnitude C σ j g).div_const Btop).aestronglyMeasurable
  have hSstrong : ∀ g, g ∈ D →
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
    intro g _
    have hSeq : S g = (Btop⁻¹) • T g := by
      funext z
      change T g z / Btop = Btop⁻¹ * T g z
      field_simp [hBtop.ne']
    calc
      eLpNorm (S g) (ENNReal.ofReal 4) localSmoothingMeasure =
          ENNReal.ofReal (Btop⁻¹) * eLpNorm (T g) (ENNReal.ofReal 4)
            localSmoothingMeasure := by
            rw [hSeq, eLpNorm_const_smul]
            rw [Real.enorm_eq_ofReal (inv_nonneg.mpr hBtop.le)]
      _ ≤ ENNReal.ofReal (Btop⁻¹) *
          (B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume) := by
            apply mul_le_mul_right
            calc
              eLpNorm (T g) (ENNReal.ofReal 4) localSmoothingMeasure =
                  eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g)
                    (ENNReal.ofReal 4) localSmoothingMeasure := by
                    rw [eLpNorm_congr_ae
                      (localDyadicHalfWaveMagnitude_ae_eq C σ j g), eLpNorm_norm _ (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j g)]
              _ ≤ B4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume :=
                hstrong4 g
              _ = B4 * eLpNorm (eval g) (ENNReal.ofReal 4) volume := rfl
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume := by
            rw [ENNReal.ofReal_inv_of_pos hBtop]
            ac_rfl
  have hSweak : ∀ g, g ∈ D → ∀ {u : Real}, 0 < u →
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} ≤
        (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (∫⁻ x, (ENNReal.ofReal ‖eval g x‖) ^ (4 : Real)) := by
    intro g _ u hu
    have hcheb := sourceOutput_weak_distribution_of_eLpNorm (S g)
      (hSmeas g (by simp [D])) (by norm_num : (0 : Real) < 4) hu
      ((B4 * (ENNReal.ofReal Btop)⁻¹) *
        eLpNorm (eval g) (ENNReal.ofReal 4) volume) (hSstrong g (by simp [D]))
    calc
      (ENNReal.ofReal u) ^ (4 : Real) *
          localSmoothingMeasure {z | u < S g z} =
          localSmoothingMeasure {z | u < S g z} * (ENNReal.ofReal u) ^ (4 : Real) := by
            ac_rfl
      _ ≤ ((B4 * (ENNReal.ofReal Btop)⁻¹) *
          eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := hcheb
      _ = (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          (eLpNorm (eval g) (ENNReal.ofReal 4) volume) ^ (4 : Real) := by
            rw [ENNReal.mul_rpow_of_nonneg _ _ (by norm_num)]
      _ = _ := by
            rw [← lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (by norm_num) (eval g)
              g.continuous.aestronglyMeasurable]
  have hStop : ∀ g, g ∈ D → ∀ a : Real, 0 ≤ a →
      (∀ x, ‖eval g x‖ ≤ a) → ∀ z, S g z ≤ a := by
    intro g _ a ha hga z
    change T g z / Btop ≤ a
    rw [div_le_iff₀ hBtop]
    simpa [mul_comm] using hTop g a ha hga z
  rcases exists_schwartz_smooth_low_high_family f with
    ⟨low, high, hlow, hhigh, hsplit⟩
  have hhighI_meas : Measurable (fun t : Real => ∫⁻ x,
      (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) := by
    simpa only [eval] using
      (measurable_smooth_high_profile_lintegrals f low high hlow hhigh 4)
  have hhighTailRaw := smooth_bump_schwartz_high_q_weighted_tail f low high hlow hhigh
    (q := 4) (p := p) (by norm_num) hp4
  have hhigh_tail :
      (∫⁻ t in Ioi (0 : Real),
        (∫⁻ x, (ENNReal.ofReal ‖eval (high t) x‖) ^ (4 : Real)) *
          (ENNReal.ofReal t) ^ (p - 4 - 1)) ≤
        ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
          ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p := by
    simpa only [eval] using hhighTailRaw
  have hSmoment := sourceOutput_marcinkiewicz_weak_q_top_on_additive_split
    D eval S hSnonneg hSsub (4 : Real) (by norm_num)
    ((B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real)) hSweak hStop hp4 f
    (hSmeas f (by simp [D])).aemeasurable low high
    (fun _ => by simp [D]) (fun _ => by simp [D])
    (fun t => by ext x; exact hsplit t x)
    (fun t ht x => smooth_low_norm_le_half_height f (low t) ht (hlow t) x)
    hhighI_meas
    (((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)) *
      ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p)
    hhigh_tail
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
    (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) * H)
  have hSmoment' : (∫⁻ z, ENNReal.ofReal ((S f z) ^ p) ∂localSmoothingMeasure) ≤
      K * (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) := by
    dsimp only [K, H]
    simpa only [mul_assoc] using hSmoment
  have hSbound := sourceOutput_eLpNorm_le_of_nonnegative_moment S f
    (lt_trans (by norm_num) hp4) (hSnonneg f)
    (K * ∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) hSmoment' (hSmeas f (by simp [D]))
  have hin : (∫⁻ x, (ENNReal.ofReal ‖eval f x‖) ^ p) =
      (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p :=
    lintegral_ofReal_norm_rpow_eq_eLpNorm_rpow (lt_trans (by norm_num) hp4) (eval f)
      f.continuous.aestronglyMeasurable
  rw [hin] at hSbound
  have hSbound' : eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
      K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
    calc
      eLpNorm (S f) (ENNReal.ofReal p) localSmoothingMeasure ≤
          (K * (eLpNorm (eval f) (ENNReal.ofReal p) volume) ^ p) ^ p⁻¹ := hSbound
      _ = K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume := by
        rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr (lt_trans (by norm_num) hp4).le),
          ← ENNReal.rpow_mul]
        have hpp : p * p⁻¹ = (1 : Real) := by field_simp
        rw [hpp, ENNReal.rpow_one]
  have hTeq : T f = Btop • S f := by
    funext z
    change T f z = Btop * (T f z / Btop)
    field_simp [hBtop.ne']
  calc
    eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure = eLpNorm (T f) (ENNReal.ofReal p)
          localSmoothingMeasure := rfl
    _ = ENNReal.ofReal Btop * eLpNorm (S f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
          rw [hTeq, eLpNorm_const_smul, Real.enorm_eq_ofReal hBtop.le]
    _ ≤ ENNReal.ofReal Btop *
        (K ^ p⁻¹ * eLpNorm (eval f) (ENNReal.ofReal p) volume) :=
      mul_le_mul_right hSbound' _
    _ = ENNReal.ofReal Btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (B4 * (ENNReal.ofReal Btop)⁻¹) ^ (4 : Real) *
          ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
      dsimp only [K, H, eval]
      ac_rfl

/-- A finite extended-nonnegative constant can be absorbed into a positive
real coefficient.  This is used only to package scale-independent
interpolation constants in the exact `localSmoothing` format. -/
private theorem mss_ennreal_exists_pos_real_majorant
    {K : ENNReal} (hK : K ≠ ∞) :
    ∃ C : Real, 0 < C ∧ K ≤ ENNReal.ofReal C := by
  refine ⟨K.toReal + 1, by positivity, ?_⟩
  calc
    K = ENNReal.ofReal K.toReal := (ENNReal.ofReal_toReal hK).symm
    _ ≤ ENNReal.ofReal (K.toReal + 1) := by
      have hKnonneg : 0 ≤ K.toReal := ENNReal.toReal_nonneg
      exact ENNReal.ofReal_le_ofReal (by linarith)

/-- Algebraic normalization of the scale chosen for the two-pair
`L²`--`L⁴` source-output interpolation engine. -/
private theorem mss_two_four_coefficient_factor
    {p b : Real} (_hp : 0 < p) (hb : 0 < b)
    (H L : ENNReal) :
    sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
        ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
        ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
      (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))) *
        (ENNReal.ofReal b) ^ (2 * p - 4) := by
  let B : ENNReal := ENNReal.ofReal b
  let Q : ENNReal := ENNReal.ofReal 2
  have hB0 : B ≠ 0 := ENNReal.ofReal_ne_zero_iff.mpr hb
  have hBtop : B ≠ ∞ := ENNReal.ofReal_ne_top
  have hQ0 : Q ≠ 0 := by norm_num [Q]
  have hQtop : Q ≠ ∞ := ENNReal.ofReal_ne_top
  have hs : ENNReal.ofReal (b⁻¹ * b⁻¹) = B ^ (-2 : Real) := by
    rw [ENNReal.ofReal_mul (inv_nonneg.mpr hb.le), ENNReal.ofReal_inv_of_pos hb]
    dsimp only [B]
    rw [← ENNReal.rpow_neg_one]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  have hpow0 : (B ^ (-2 : Real)) ^ ((2 : Real) - p) = B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    congr 1
    ring
  have hpow1 : B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p) =
      B ^ (2 * p - 4) := by
    rw [← ENNReal.rpow_mul]
    rw [← ENNReal.rpow_add _ _ hB0 hBtop]
    congr 1
    ring
  change ENNReal.ofReal p *
      (Q ^ (2 : Real) * Q ^ (2 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((2 : Real) - p) * H) +
        Q ^ (4 : Real) * B ^ (4 : Real) *
          (ENNReal.ofReal (b⁻¹ * b⁻¹) ^ ((4 : Real) - p) * L)) = _
  rw [hs]
  rw [hpow0]
  have hQpow : Q ^ (2 : Real) * Q ^ (2 : Real) = Q ^ (4 : Real) := by
    rw [← ENNReal.rpow_add _ _ hQ0 hQtop]
    congr 1
    ring
  rw [hQpow]
  rw [show Q ^ (4 : Real) * B ^ (4 : Real) *
      ((B ^ (-2 : Real)) ^ ((4 : Real) - p) * L) =
      Q ^ (4 : Real) *
        (B ^ (4 : Real) * (B ^ (-2 : Real)) ^ ((4 : Real) - p)) * L by
      ac_rfl, hpow1]
  rw [show Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
      Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
      (Q ^ (4 : Real) * (H + L)) * B ^ (2 * p - 4) by
      calc
        Q ^ (4 : Real) * (B ^ (2 * p - 4) * H) +
            Q ^ (4 : Real) * B ^ (2 * p - 4) * L =
            (Q ^ (4 : Real) * H + Q ^ (4 : Real) * L) * B ^ (2 * p - 4) := by
              rw [add_mul]
              ac_rfl
        _ = _ := by rw [mul_add]]
  ac_rfl

private theorem mss_two_four_root_factor
    {p : Real} (hp : 0 < p) (K b : ENNReal) :
    (K * b ^ (2 * p - 4)) ^ p⁻¹ =
      K ^ p⁻¹ * b ^ (2 - 4 / p) := by
  rw [ENNReal.mul_rpow_of_nonneg _ _ (inv_nonneg.mpr hp.le),
    ← ENNReal.rpow_mul]
  congr 1
  field_simp

private theorem mss_ofReal_product_rpow
    {a r θ : Real} (ha : 0 < a) (hθ : 0 ≤ θ) (j : Nat) :
    (ENNReal.ofReal (a * (2 : Real) ^ ((j : Real) * r))) ^ θ =
      ENNReal.ofReal (a ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * (r * θ))) := by
  rw [ENNReal.ofReal_mul ha.le,
    ENNReal.mul_rpow_of_nonneg _ _ hθ]
  rw [ENNReal.ofReal_rpow_of_pos ha]
  congr 1
  rw [show (2 : Real) ^ ((j : Real) * (r * θ)) =
      ((2 : Real) ^ ((j : Real) * r)) ^ θ by
      rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
      congr 1
      ring]
  rw [ENNReal.ofReal_rpow_of_pos
    (Real.rpow_pos_of_pos (by norm_num) _)]

private theorem mss_two_four_theta_pos {p : Real} (hp2 : 2 < p) :
    0 < 2 - 4 / p := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  apply sub_pos.mpr
  rw [div_lt_iff₀ hp0]
  nlinarith

private theorem mss_two_four_rate
    {p η : Real} (hp : 0 < p) (hθ : 0 < 2 - 4 / p) :
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
      1 / 4 - 1 / (2 * p) + η := by
  calc
    (1 / 8 + η / (2 - 4 / p)) * (2 - 4 / p) =
        (1 / 8) * (2 - 4 / p) + (η / (2 - 4 / p)) * (2 - 4 / p) := by ring
    _ = (1 / 8) * (2 - 4 / p) + η := by
      rw [div_mul_cancel₀ _ hθ.ne']
    _ = 1 / 4 - 1 / (2 * p) + η := by
      field_simp [hp.ne']
      ring

private theorem mss_two_four_constant_finite
    {p : Real} (hp2 : 2 < p) (hp4 : p < 4) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2) +
        ((ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
          (ENNReal.ofReal (4 - p))⁻¹)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp2
  have hp2' : 0 < p - 2 := sub_pos.mpr hp2
  have hp4' : 0 < 4 - p := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  apply ENNReal.add_ne_top.mpr
  constructor
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp2')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.add_ne_top.mpr
    constructor
    · apply ENNReal.mul_ne_top
      · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
      · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp0)
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')

/-- The proved local `L²` endpoint and a literal Schwartz-core `p=4`
local-smoothing estimate interpolate to every `2 < p < 4`.  The proof uses
the radius-scaled two-pair source-output engine, so the gain has the exact
MSS exponent rather than an unscaled interpolation loss. -/
theorem p4LocalSmoothing_to_localSmoothing_two_four
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp2 : 2 < p) (hp4 : p < 4) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let θ : Real := 2 - 4 / p
  have hθ : 0 < θ := by
    dsimp only [θ]
    exact mss_two_four_theta_pos hp2
  let δ : Real := η / θ
  have hδ : 0 < δ := div_pos hη hθ
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  refine ⟨hp2, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 2))⁻¹ * (ENNReal.ofReal 4) ^ (p - 2)
  let L : ENNReal :=
    (ENNReal.ofReal 2) ^ (-(4 : Real)) * (ENNReal.ofReal p)⁻¹ +
      (ENNReal.ofReal (4 - p))⁻¹
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * (H + L))
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H, L]
    exact mss_two_four_constant_finite hp2 hp4
  let D : Real := (K ^ p⁻¹).toReal * A ^ θ + 1
  have hD : 0 < D := by
    dsimp only [D]
    positivity
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb : 0 < b := by
    dsimp only [b]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1;
      dsimp only [b]; rw [mssGain_four]; ring
  have hs : 0 < b⁻¹ * b⁻¹ := by positivity
  have hinterp := mss_two_four_coefficient C σ j hp2 hp4 (ENNReal.ofReal b)
    hstrong4 (b⁻¹ * b⁻¹) hs f
  have hcoef :
      sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L) =
        K * (ENNReal.ofReal b) ^ (2 * p - 4) := by
    dsimp only [K, H, L]
    exact mss_two_four_coefficient_factor (lt_trans (by norm_num) hp2) hb _ _
  have hroot := mss_two_four_root_factor (lt_trans (by norm_num) hp2) K
    (ENNReal.ofReal b)
  have hBpow : (ENNReal.ofReal b) ^ θ =
      ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ))) := by
    dsimp only [b]
    exact mss_ofReal_product_rpow hA hθ.le j
  have hrate : (1 / 8 + δ) * θ =
      1 / 4 - 1 / (2 * p) + η := by
    dsimp only [δ, θ]
    exact mss_two_four_rate (lt_trans (by norm_num) hp2)
      (mss_two_four_theta_pos hp2)
  have hstatic : K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) ≤ ENNReal.ofReal D := by
    calc
      K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) =
          ENNReal.ofReal ((K ^ p⁻¹).toReal) * ENNReal.ofReal (A ^ θ) := by
            rw [ENNReal.ofReal_toReal hKtop]
      _ =
          ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ) := by
            rw [← ENNReal.ofReal_mul ENNReal.toReal_nonneg]
      _ ≤ ENNReal.ofReal ((K ^ p⁻¹).toReal * A ^ θ + 1) := by
        apply ENNReal.ofReal_le_ofReal
        have hnon : 0 ≤ (K ^ p⁻¹).toReal * A ^ θ :=
          mul_nonneg ENNReal.toReal_nonneg (Real.rpow_nonneg hA.le _)
        linarith
      _ = ENNReal.ofReal D := rfl
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 4 - 1 / (2 * p) + η := by
    rw [mssGain_of_le_four hp4.le]
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm _ (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f)]
    _ ≤ (sourceOutputTwoPairMarcinkiewiczMomentCoefficient p 2 4
          ((ENNReal.ofReal 2) ^ (2 : Real)) ((ENNReal.ofReal b) ^ (4 : Real))
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((2 : Real) - p) * H)
          ((ENNReal.ofReal (b⁻¹ * b⁻¹)) ^ ((4 : Real) - p) * L)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K * (ENNReal.ofReal b) ^ (2 * p - 4)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by rw [hcoef]
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b) ^ θ) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hBpow]
          ac_rfl
    _ ≤ (ENNReal.ofReal D *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 4 - 1 / (2 * p) + η)))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hrate]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]

private theorem mss_four_top_root_factor
    {p : Real} (hp : 0 < p) (K b4 btop : ENNReal)
    (hbtop0 : btop ≠ 0) (hbtopT : btop ≠ ∞) :
    btop * (K * (b4 * btop⁻¹) ^ (4 : Real)) ^ p⁻¹ =
      K ^ p⁻¹ * b4 ^ (4 / p) * btop ^ (1 - 4 / p) := by
  have hinv : 0 ≤ p⁻¹ := inv_nonneg.mpr hp.le
  rw [ENNReal.mul_rpow_of_nonneg _ _ hinv]
  rw [← ENNReal.rpow_mul]
  have hfour : (4 : Real) * p⁻¹ = 4 / p := by field_simp
  rw [hfour]
  rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity : 0 ≤ 4 / p)]
  rw [ENNReal.inv_rpow]
  rw [← ENNReal.rpow_neg]
  rw [show btop * (K ^ p⁻¹ * (b4 ^ (4 / p) * btop ^ (-(4 / p)))) =
      (K ^ p⁻¹ * b4 ^ (4 / p)) * (btop * btop ^ (-(4 / p))) by ac_rfl]
  rw [show btop * btop ^ (-(4 / p)) = btop ^ (1 - 4 / p) by
    calc
      btop * btop ^ (-(4 / p)) = btop ^ (1 : Real) * btop ^ (-(4 / p)) := by
        rw [ENNReal.rpow_one]
      _ = btop ^ (1 + -(4 / p)) := (ENNReal.rpow_add _ _ hbtop0 hbtopT).symm
      _ = btop ^ (1 - 4 / p) := by congr 1]

private theorem mss_four_top_constant_finite
    {p : Real} (hp4 : 4 < p) :
    (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
      ((ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)))) ^ p⁻¹ ≠ ∞ := by
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hp4' : 0 < p - 4 := sub_pos.mpr hp4
  apply ENNReal.rpow_ne_top_of_nonneg (inv_nonneg.mpr hp0.le)
  apply ENNReal.mul_ne_top ENNReal.ofReal_ne_top
  apply ENNReal.mul_ne_top
  · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top
  · apply ENNReal.mul_ne_top
    · exact ENNReal.inv_ne_top.mpr (ENNReal.ofReal_ne_zero_iff.mpr hp4')
    · exact ENNReal.rpow_ne_top_of_ne_zero (by norm_num) ENNReal.ofReal_ne_top

private theorem mss_sqrt_two_rpow (j : Nat) :
    Real.sqrt ((2 : Real) ^ j) = (2 : Real) ^ ((j : Real) * (1 / 2)) := by
  calc
    Real.sqrt ((2 : Real) ^ j) = ((2 : Real) ^ j) ^ (1 / 2 : Real) :=
      Real.sqrt_eq_rpow _
    _ = ((2 : Real) ^ (j : Real)) ^ (1 / 2 : Real) := by
      rw [Real.rpow_natCast]
    _ = (2 : Real) ^ ((j : Real) * (1 / 2)) :=
      (Real.rpow_mul (by norm_num : (0 : Real) ≤ 2) _ _).symm

private theorem mss_four_top_rate
    {p η : Real} (hp : 0 < p) :
    (1 / 8 + p * η / 4) * (4 / p) +
      (1 / 2) * (1 - 4 / p) =
        1 / 2 - 3 / (2 * p) + η := by
  field_simp [hp.ne']
  ring

/-- A literal Schwartz-core `p=4` local-smoothing estimate and the proved
slab-local `L∞` endpoint interpolate to every `4 < p`.  The `L∞` assertion is
used only through `localDyadicHalfWaveMagnitude`, which is zero off the
physical time slab. -/
theorem p4LocalSmoothing_to_localSmoothing_four_top
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp4 : 4 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  let δ : Real := p * η / 4
  have hp0 : 0 < p := lt_trans (by norm_num) hp4
  have hδ : 0 < δ := by
    dsimp only [δ]
    positivity
  rcases h4 δ hδ with ⟨_, _, A, hA, hA_bound⟩
  rcases mssLInfinityEndpoint C with ⟨B, hB, hInfty⟩
  refine ⟨lt_trans (by norm_num) hp4, hη, ?_⟩
  let H : ENNReal := (ENNReal.ofReal (p - 4))⁻¹ * (ENNReal.ofReal 4) ^ (p - 4)
  let K : ENNReal := ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) * H)
  have hKtop : K ^ p⁻¹ ≠ ∞ := by
    dsimp only [K, H]
    exact mss_four_top_constant_finite hp4
  let θ4 : Real := 4 / p
  have hθ4 : 0 < θ4 := by
    dsimp only [θ4]
    positivity
  let θtop : Real := 1 - 4 / p
  have hθtop : 0 < θtop := by
    dsimp only [θtop]
    apply sub_pos.mpr
    rw [div_lt_iff₀ hp0]
    simpa using hp4
  let S : ENNReal := K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)
  have hStop : S ≠ ∞ := by
    dsimp only [S]
    apply ENNReal.mul_ne_top
    · apply ENNReal.mul_ne_top
      · exact hKtop
      · exact ENNReal.ofReal_ne_top
    · exact ENNReal.ofReal_ne_top
  rcases mss_ennreal_exists_pos_real_majorant hStop with ⟨D, hD, hSle⟩
  refine ⟨D, hD, ?_⟩
  intro j hj f σ
  let b4 : Real := A * (2 : Real) ^ ((j : Real) * (1 / 8 + δ))
  have hb4 : 0 < b4 := by
    dsimp only [b4]
    exact mul_pos hA (Real.rpow_pos_of_pos (by norm_num) _)
  let btop : Real := B * Real.sqrt ((2 : Real) ^ j)
  have hbtop : 0 < btop := by
    dsimp only [btop]
    apply mul_pos hB
    exact Real.sqrt_pos.2 (pow_pos (by norm_num) _)
  have hstrong4 : ∀ g : SchwartzMap (Euclidean 2) Complex,
      eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j g) (ENNReal.ofReal 4)
          localSmoothingMeasure ≤
        ENNReal.ofReal b4 * eLpNorm (g : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by
    intro g
    convert hA_bound j hj g σ using 1;
      dsimp only [b4]; rw [mssGain_four]; ring
  have hTop : ∀ (g : SchwartzMap (Euclidean 2) Complex) (a : Real), 0 ≤ a →
      (∀ x, ‖g x‖ ≤ a) → ∀ z,
        localDyadicHalfWaveMagnitude C σ j g z ≤ btop * a := by
    intro g a ha hga
    exact localDyadicHalfWaveMagnitude_top C hB hInfty σ j hj g hga
  have hinterp := mss_four_top_coefficient C σ j hp4 (ENNReal.ofReal b4) hstrong4
    btop hbtop hTop f
  have hcoef :
      ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H) =
        K * (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) := by
    dsimp only [K]
    ac_rfl
  have hroot := mss_four_top_root_factor hp0 K (ENNReal.ofReal b4)
    (ENNReal.ofReal btop) (ENNReal.ofReal_ne_zero_iff.mpr hbtop) ENNReal.ofReal_ne_top
  have hB4pow : (ENNReal.ofReal b4) ^ θ4 =
      ENNReal.ofReal (A ^ θ4) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) := by
    dsimp only [b4]
    exact mss_ofReal_product_rpow hA hθ4.le j
  have hBtoppow : (ENNReal.ofReal btop) ^ θtop =
      ENNReal.ofReal (B ^ θtop) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) := by
    dsimp only [btop]
    rw [mss_sqrt_two_rpow]
    exact mss_ofReal_product_rpow hB hθtop.le j
  have hrate : (1 / 8 + δ) * θ4 + (1 / 2) * θtop =
      1 / 2 - 3 / (2 * p) + η := by
    dsimp only [δ, θ4, θtop]
    exact mss_four_top_rate hp0
  have hscale :
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
        ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) =
      ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
        (1 / 2 - 3 / (2 * p) + η))) := by
    rw [← ENNReal.ofReal_mul (Real.rpow_nonneg (by norm_num) _)]
    rw [← Real.rpow_add (by norm_num : (0 : Real) < 2)]
    congr 1
    rw [← mul_add, hrate]
  have htargetrate : 1 / 2 - 1 / p - mssGain p + η =
      1 / 2 - 3 / (2 * p) + η := by
    rw [mssGain_of_four_lt hp4]
    field_simp [hp0.ne']
    ring
  calc
    eLpNorm (dyadicHalfWaveSpaceTime C.cutoff σ j f) (ENNReal.ofReal p)
        localSmoothingMeasure =
        eLpNorm (localDyadicHalfWaveMagnitude C σ j f) (ENNReal.ofReal p)
          localSmoothingMeasure := by
            rw [eLpNorm_congr_ae (localDyadicHalfWaveMagnitude_ae_eq C σ j f), eLpNorm_norm _ (aestronglyMeasurable_dyadicHalfWaveSpaceTime C σ j f)]
    _ ≤ ENNReal.ofReal btop *
        (ENNReal.ofReal p * ((ENNReal.ofReal 2) ^ (4 : Real) *
          (ENNReal.ofReal b4 * (ENNReal.ofReal btop)⁻¹) ^ (4 : Real) * H)) ^ p⁻¹ *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          exact hinterp
    _ = (K ^ p⁻¹ * (ENNReal.ofReal b4) ^ θ4 *
        (ENNReal.ofReal btop) ^ θtop) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [hcoef, hroot]
    _ = (K ^ p⁻¹ * ENNReal.ofReal (A ^ θ4) * ENNReal.ofReal (B ^ θtop)) *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hB4pow, hBtoppow]
          ac_rfl
    _ = S *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 8 + δ) * θ4))) *
          ENNReal.ofReal ((2 : Real) ^ ((j : Real) * ((1 / 2) * θtop))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rfl
    _ ≤ ENNReal.ofReal D *
        (ENNReal.ofReal ((2 : Real) ^ ((j : Real) *
          (1 / 2 - 3 / (2 * p) + η))) *
          eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume) := by
          rw [hscale]
          gcongr
    _ = ENNReal.ofReal (D * (2 : Real) ^
        ((j : Real) * (1 / 2 - 1 / p - mssGain p + η))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal p) volume := by
          rw [htargetrate]
          rw [ENNReal.ofReal_mul hD.le]
          ac_rfl

/-- A sharp local `p=4` estimate yields the complete real-exponent MSS
local-smoothing family.  The proof is direct at `p=4`, uses the proved local
`L²` endpoint below four, and uses the slab-local proved `L∞` endpoint above
four. -/
theorem p4LocalSmoothing_to_localSmoothing_all_p
    (C : lpCutoffs 2) (h4 : p4LocalSmoothing C.cutoff)
    {p η : Real} (hp : 2 < p) (hη : 0 < η) :
    localSmoothing C.cutoff p η := by
  by_cases hp4 : p ≤ 4
  · rcases lt_or_eq_of_le hp4 with hplt | rfl
    · exact p4LocalSmoothing_to_localSmoothing_two_four C h4 hp hplt hη
    · exact h4 η hη
  · exact p4LocalSmoothing_to_localSmoothing_four_top C h4 (lt_of_not_ge hp4) hη


end
