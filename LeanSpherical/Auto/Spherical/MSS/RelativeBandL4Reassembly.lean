/- The next private helper keeps the `ENNReal` raw supremum literal.  The
common kernel majorant makes it pointwise finite, so the strong bound for its
`toReal` presentation transfers back without losing any mass at top. -/
private theorem aux_raw_annular_four_of_kernel_bound
    {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean 2) Complex)
    (r : ι → Set.Ioi (0 : Real))
    {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
      (φ u) ≤ A) :
    ∃ D : Real, 0 < D ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      Measurable (fun x =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x) ∧
      (∫⁻ x, (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
        φ r f x) ^ (4 : Nat)) ≤
        ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (4 : Nat)) := by
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      φ hA hφ
  obtain ⟨D, hD, hstrong⟩ :=
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier_strong_type_of_kernel_bound
      (d := 2) (by norm_num) (p := 4) (by norm_num) φ r hA hφ
  refine ⟨D, hD, ?_⟩
  intro f
  let R : Euclidean 2 → ENNReal := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x
  let H : Euclidean 2 → Real := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier φ r f x
  have hRle (x : Euclidean 2) :
      R x ≤ ENNReal.ofReal (K *
        _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x) := by
    dsimp [R, _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw]
    apply iSup_le
    intro u
    exact ENNReal.ofReal_le_ofReal (hterm u f (r u) x)
  have hRfinite (x : Euclidean 2) : R x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hRle x)
  have hReq (x : Euclidean 2) : R x = ENNReal.ofReal (H x) := by
    dsimp [R, H, _root_.Auto.MikhlinHormander.annularSchwartzMultiplier]
    exact (ENNReal.ofReal_toReal (hRfinite x)).symm
  have hHmeas : Measurable H := by
    dsimp [H]
    apply ENNReal.measurable_toReal.comp
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro u
    exact (ENNReal.continuous_ofReal.comp
      (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
        (φ u) f (r u)).norm).lowerSemicontinuous
  have hRmeas : Measurable R := by
    rw [show R = fun x => ENNReal.ofReal (H x) by
      funext x
      exact hReq x]
    exact hHmeas.ennreal_ofReal
  have hHmem : MemLp H 4 volume := by
    convert (hstrong f).1 using 1; norm_num [H]
  have hHbound' : (∫ x, H x ^ (4 : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (4 : Real) := by
    simpa only [H] using (hstrong f).2
  change (∫ x, H x ^ (↑(4 : Nat) : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (↑(4 : Nat) : Real) at hHbound'
  have hHbound : (∫ x, H x ^ (4 : Nat)) ≤
      D * ∫ x, ‖f x‖ ^ (4 : Nat) := by
    simpa only [Real.rpow_natCast] using hHbound'
  have hHint : Integrable (fun x => H x ^ (4 : Nat)) volume := by
    rw [show (fun x => H x ^ (4 : Nat)) = fun x => ‖H x‖ ^ (4 : Nat) by
      funext x
      rw [Real.norm_eq_abs, abs_of_nonneg
        (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
          φ r f x) ]]
    exact hHmem.integrable_norm_pow (by norm_num)
  have hHnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ H x ^ (4 : Nat) :=
    Filter.Eventually.of_forall fun x => pow_nonneg
      (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg φ r f x) _
  refine ⟨?_, ?_⟩
  · simpa only [R] using hRmeas
  · calc
      (∫⁻ x, (R x) ^ (4 : Nat)) =
          ∫⁻ x, ENNReal.ofReal (H x ^ (4 : Nat)) := by
            apply lintegral_congr
            intro x
            rw [hReq x,
              ← ENNReal.ofReal_pow
                (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
                  φ r f x)]
      _ = ENNReal.ofReal (∫ x, H x ^ (4 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hHint hHnonneg).symm
      _ ≤ ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (4 : Nat)) :=
        ENNReal.ofReal_le_ofReal hHbound

/- The three low relative scales are a finite compact family.  Applying the
raw annular estimate separately and summing its three constants gives one
uniform low-frequency fourth-moment bound. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_fourth_moment_unprojected
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (4 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) := by
  obtain ⟨B, hB, hkernel⟩ :=
    aux_exists_relativeSchwartzMultiplierKernelSize_circleRelativeBandFatLowSymbol_le C
  choose D hDpos hD using fun a : Fin 3 =>
    aux_raw_annular_four_of_kernel_bound
      (fun t : CircleRelativeBandLocalTime => aux_circleRelativeBandFatLowSymbol C a.1 t)
      (fun _ : CircleRelativeBandLocalTime =>
        _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1)
      hB (fun t => hkernel a t)
  let A : Real := ∑ a : Fin 3, D a
  have hApos : 0 < A := by
    apply lt_of_lt_of_le (hDpos ⟨0, by norm_num⟩)
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ _)
  refine ⟨A, hApos, ?_⟩
  intro a f
  have hrawfun : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      fun x : Euclidean 2 =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
          (fun t : CircleRelativeBandLocalTime =>
            aux_circleRelativeBandFatLowSymbol C a.1 t)
          (fun _ : CircleRelativeBandLocalTime =>
            _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x := by
    funext x
    exact aux_circleRelativeBandFatUnitSlabMaximal_eq_lowSymbolRaw C a f x
  have hDle : D a ≤ A := by
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ a)
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  refine ⟨?_, ?_⟩
  · rw [hrawfun]
    exact (hD a f).1
  · rw [hrawfun]
    calc
      (∫⁻ x : Euclidean 2,
          (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
            (fun t : CircleRelativeBandLocalTime =>
              aux_circleRelativeBandFatLowSymbol C a.1 t)
            (fun _ : CircleRelativeBandLocalTime =>
              _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x) ^
              (4 : Nat)) ≤
          ENNReal.ofReal (D a * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) :=
        (hD a f).2
      _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hDle hInonneg)

/- Put the low compact-family bound into the same fat-projected physical
input form as the high packet.  The exact idempotence identity prevents a
second fat cutoff from appearing on the right. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_fourth_moment
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (4 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (4 : Nat)) := by
  obtain ⟨A, hA, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_fourth_moment_unprojected C
  refine ⟨A, hA, ?_⟩
  intro a f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C a.1 f
  have hmaxeq : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      circleRelativeBandFatUnitSlabMaximal C a.1 P := by
    funext x
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C a.1 t f x]
  obtain ⟨hmeas, hmoment⟩ := hlow a P
  refine ⟨?_, ?_⟩
  · rw [hmaxeq]
    exact hmeas
  · rw [hmaxeq]
    calc
      (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C a.1 P x) ^ (4 : Nat)) ≤
          ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖P x‖ ^ (4 : Nat)) := hmoment
      _ = ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (4 : Nat)) := by
        congr 2
        apply integral_congr_ae
        filter_upwards with x
        rw [show P x = circleRelativeBandFatInputProjection C a.1 f x by
          exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C a.1 f x]

private theorem aux_dyadicTimeScale_rpow_eq_geometric
    (j : Nat) (β : Real) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale j ^ β =
      ((2 : Real) ^ (-β)) ^ j := by
  rw [_root_.Auto.Spherical.MSS.dyadicTimeScale, ← Real.rpow_neg_natCast]
  rw [← Real.rpow_natCast ((2 : Real) ^ (-β)) j]
  rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  rw [← Real.rpow_mul (by norm_num : (0 : Real) ≤ 2)]
  congr 1
  ring

private theorem aux_lintegral_circleRelativeBandFatInputProjection_fourth_eq
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
      (‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  have hPint : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ (4 : Nat)) volume :=
    (P.memLp 4 volume).integrable_norm_pow (by norm_num)
  have hPnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖P x‖ ^ (4 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hlin : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (4 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (4 : Nat)) :=
    (ofReal_integral_eq_lintegral_ofReal hPint hPnonneg).symm
  calc
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat))) =
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (4 : Nat)) := by
          apply lintegral_congr
          intro x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
    _ = ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (4 : Nat)) := hlin
    _ = ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]

private theorem aux_exists_high_circleRelativeBandFatUnitSlab_geometric_fourth_moment
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat), 3 ≤ j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          ENNReal.ofReal
            (A * ((2 : Real) ^ (-(4 * min ρ ((3 : Real) / 4)))) ^ j *
              ∫ x : Euclidean 2,
                ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
  obtain ⟨A, hA, hhigh⟩ :=
    aux_exists_high_circleRelativeBandFatUnitSlab_fourth_moment C hgain
  refine ⟨A, hA, ?_⟩
  intro j hj f
  obtain ⟨hmeas, hmoment⟩ := hhigh j hj f
  refine ⟨hmeas, ?_⟩
  rw [aux_dyadicTimeScale_rpow_eq_geometric] at hmoment
  exact hmoment

private theorem aux_low_coefficient_le_geometric
    (a b q : Real) (j : Nat) (ha : 0 ≤ a) (hb : 0 ≤ b)
    (hqpos : 0 < q) (hqone : q ≤ 1) (hj : j < 3) :
    a ≤ (b + a / q ^ (2 : Nat)) * q ^ j := by
  have hq2pos : 0 < q ^ (2 : Nat) := pow_pos hqpos _
  have hq2le : q ^ (2 : Nat) ≤ 1 := pow_le_one₀ hqpos.le hqone
  have hdiv : a ≤ a / q ^ (2 : Nat) := by
    apply (le_div_iff₀ hq2pos).mpr
    exact mul_le_of_le_one_right ha hq2le
  interval_cases j
  · simp only [pow_zero, mul_one]
    calc
      a ≤ a / q ^ (2 : Nat) := hdiv
      _ ≤ b + a / q ^ (2 : Nat) := le_add_of_nonneg_left hb
  · simp only [pow_one]
    have hqne : q ≠ 0 := hqpos.ne'
    have hdivq : a ≤ a / q := by
      apply (le_div_iff₀ hqpos).mpr
      exact mul_le_of_le_one_right ha hqone
    rw [show (b + a / q ^ (2 : Nat)) * q = b * q + a / q by
      field_simp [hqne]]
    exact hdivq.trans (le_add_of_nonneg_left (mul_nonneg hb hqpos.le))
  · have hqne : q ≠ 0 := hqpos.ne'
    rw [show (b + a / q ^ (2 : Nat)) * q ^ (2 : Nat) = b * q ^ (2 : Nat) + a by
      field_simp [hqne]]
    exact le_add_of_nonneg_left (mul_nonneg hb (pow_nonneg hqpos.le _))

/- Combine the finite low block with the high packet while retaining the
literal unit-slab maximal function. -/
private theorem aux_exists_circleRelativeBandFatUnitSlab_geometric_fourth_moment_real
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A q : Real, 0 < A ∧ 0 < q ∧ q < 1 ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          ENNReal.ofReal (A * q ^ j * ∫ x : Euclidean 2,
            ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
  obtain ⟨Ah, hAh, hhigh⟩ :=
    aux_exists_high_circleRelativeBandFatUnitSlab_geometric_fourth_moment C hgain
  obtain ⟨Al, hAl, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_fourth_moment C
  let β : Real := 4 * min ρ ((3 : Real) / 4)
  have hβpos : 0 < β := by
    dsimp [β]
    apply mul_pos (by norm_num)
    exact lt_min hgain.2.1 (by norm_num)
  let q : Real := (2 : Real) ^ (-β)
  have hqpos : 0 < q := by
    dsimp [q]
    exact Real.rpow_pos_of_pos (by norm_num) _
  have hqlt : q < 1 := by
    dsimp [q]
    exact Real.rpow_lt_one_of_one_lt_of_neg (by norm_num)
      (neg_lt_zero.mpr hβpos)
  let A : Real := Ah + Al / q ^ (2 : Nat)
  have hAhle : Ah ≤ A := by
    dsimp [A]
    exact le_add_of_nonneg_right
      (div_nonneg hAl.le (pow_nonneg hqpos.le _))
  have hApos : 0 < A := hAh.trans_le hAhle
  refine ⟨A, q, hApos, hqpos, hqlt, ?_⟩
  intro j f
  have hInonneg : 0 ≤ ∫ x : Euclidean 2,
      ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat) := by
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  by_cases hj : 3 ≤ j
  · obtain ⟨hmeas, hmoment⟩ := hhigh j hj f
    refine ⟨hmeas, ?_⟩
    have hhigh' :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          ENNReal.ofReal (Ah * q ^ j * ∫ x : Euclidean 2,
            ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
      simpa only [q, β] using hmoment
    exact hhigh'.trans (ENNReal.ofReal_le_ofReal
      (mul_le_mul_of_nonneg_right
        (mul_le_mul_of_nonneg_right hAhle (pow_nonneg hqpos.le _)) hInonneg))
  · have hjlt : j < 3 := Nat.lt_of_not_ge hj
    have hlowj := hlow ⟨j, hjlt⟩ f
    have hcoef : Al ≤ A * q ^ j :=
      aux_low_coefficient_le_geometric Al Ah q j hAl.le hAh.le hqpos hqlt.le hjlt
    refine ⟨by simpa only using hlowj.1, ?_⟩
    have hlowmoment :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          ENNReal.ofReal (Al * ∫ x : Euclidean 2,
            ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
      simpa only using hlowj.2
    exact hlowmoment.trans
      (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hcoef hInonneg))

/-- The literal moving-fat unit-slab circular maximal function has a
geometrically decaying fourth moment under any positive planar local-smoothing
gain.  Its right-hand side remains the exact fat-projected physical input. -/
theorem exists_circRelBandFatUnitSlab_geometric_fourth_moment_of_posLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A theta : ENNReal, A ≠ ⊤ ∧ theta < 1 ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≠ ⊤ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
  obtain ⟨a, q, ha, hqpos, hqlt, hreal⟩ :=
    aux_exists_circleRelativeBandFatUnitSlab_geometric_fourth_moment_real C hgain
  let A : ENNReal := ENNReal.ofReal a
  let theta : ENNReal := ENNReal.ofReal q
  have hAtop : A ≠ ⊤ := by
    dsimp [A]
    exact ENNReal.ofReal_ne_top
  have htheta : theta < 1 := by
    dsimp [theta]
    calc
      ENNReal.ofReal q < ENNReal.ofReal (1 : Real) :=
        (ENNReal.ofReal_lt_ofReal_iff (by norm_num)).mpr hqlt
      _ = 1 := by norm_num
  refine ⟨A, theta, hAtop, htheta, ?_⟩
  intro j f
  obtain ⟨hmeas, hmoment⟩ := hreal j f
  let I : Real := ∫ x : Euclidean 2,
    ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)
  let J : ENNReal := ∫⁻ x : Euclidean 2, ENNReal.ofReal
    (‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat))
  have hJ : J = ENNReal.ofReal I := by
    dsimp [I, J]
    exact aux_lintegral_circleRelativeBandFatInputProjection_fourth_eq C j f
  have htarget : A * theta ^ j * J = ENNReal.ofReal (a * q ^ j * I) := by
    dsimp [A, theta]
    rw [hJ, ← ENNReal.ofReal_pow hqpos.le,
      ← ENNReal.ofReal_mul ha.le,
      ← ENNReal.ofReal_mul (mul_nonneg ha.le (pow_nonneg hqpos.le _))]
  have hJtop : J ≠ ⊤ := by
    rw [hJ]
    exact ENNReal.ofReal_ne_top
  have hthetaTop : theta ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.one_ne_top (le_of_lt htheta)
  have hrighttop : A * theta ^ j * J ≠ ⊤ :=
    ENNReal.mul_ne_top
      (ENNReal.mul_ne_top hAtop (ENNReal.pow_ne_top hthetaTop)) hJtop
  refine ⟨hmeas, ?_, ?_⟩
  · apply ne_top_of_le_ne_top hrighttop
    rw [htarget]
    exact hmoment
  · rw [htarget]
    exact hmoment

/-- A positive planar `L⁴` local-smoothing gain supplies the all-radius
relative circular-band geometric decay required by the Bourgain reassembly. -/
theorem hasRelativeCircularBandGeometricDecay_four_of_positiveLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    HasRelativeCircularBandGeometricDecay 4 C.cutoff := by
  obtain ⟨A, theta, hAtop, htheta, hunit⟩ :=
    exists_circRelBandFatUnitSlab_geometric_fourth_moment_of_posLocalSmoothingGain
      C hgain
  exact hasRelativeCircularBandGeometricDecay_four_of_circleRelativeBandFatUnitSlab
    C A theta hAtop htheta hunit

/-- The conditional planar circular maximal theorem at `p = 4`, obtained by
combining a positive local-smoothing gain with the literal relative-band
reassembly. -/
theorem hasCircularMaximalSchwartzBound_four_of_positiveLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    HasCircularMaximalSchwartzBound 4 := by
  apply conditionalCircularMaximal (p := 4) (by norm_num) C.cutoff
  · apply HasCompactSupport.intro (isCompact_closedBall (0 : Euclidean 2) (2 : Real))
    intro xi hxi
    apply C.cutoff_zero xi
    rw [Metric.mem_closedBall, dist_zero_right] at hxi
    exact le_of_not_ge hxi
  · exact C.cutoff_one
  · exact C.cutoff_zero
  · exact hasRelativeCircularBandGeometricDecay_four_of_positiveLocalSmoothingGain C hgain

/-- The planar change-of-variables factor for the square moment.  This is the
`L²` counterpart of the existing fourth-moment scaling identity. -/
private theorem aux_l2_lintegral_scaled_comp_smul_two
    (V : Euclidean 2 → ENNReal) (hV : Measurable V)
    (hVfinite : (∫⁻ x : Euclidean 2, V x) ≠ ∞) {R q : Real}
    (hR : 0 < R) (hq : q = R ^ (2 : Nat)) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (2 : Nat)) * V (R • x)) =
      ENNReal.ofReal q * ∫⁻ x : Euclidean 2, V x := by
  have hqnonneg : 0 ≤ q := by
    rw [hq]
    positivity
  have hVae : ∀ᵐ x : Euclidean 2 ∂volume, V x ≠ ∞ := by
    filter_upwards [ae_lt_top hV hVfinite] with x hx
    exact hx.ne
  have hVint : Integrable (fun x : Euclidean 2 => (V x).toReal) volume :=
    integrable_toReal_of_lintegral_ne_top hV.aemeasurable hVfinite
  have hVnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ (V x).toReal :=
    Filter.Eventually.of_forall fun _ => ENNReal.toReal_nonneg
  have hVlin : (∫⁻ x : Euclidean 2, V x) =
      ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) := by
    calc
      (∫⁻ x : Euclidean 2, V x) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (V x).toReal := by
            apply lintegral_congr_ae
            filter_upwards [hVae] with x hx
            exact (ENNReal.ofReal_toReal hx).symm
      _ = ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) :=
        (ofReal_integral_eq_lintegral_ofReal hVint hVnonneg).symm
  have hcompint : Integrable (fun x : Euclidean 2 => (V (R • x)).toReal)
      volume := hVint.comp_smul hR.ne'
  have hcompnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ (V (R • x)).toReal :=
    Filter.Eventually.of_forall fun _ => ENNReal.toReal_nonneg
  have hVcompae : ∀ᵐ x : Euclidean 2 ∂volume, V (R • x) ≠ ∞ :=
    (Measure.quasiMeasurePreserving_smul volume hR.ne').ae hVae
  have hcomplin : (∫⁻ x : Euclidean 2, V (R • x)) =
      ENNReal.ofReal (∫ x : Euclidean 2, (V (R • x)).toReal) := by
    calc
      (∫⁻ x : Euclidean 2, V (R • x)) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (V (R • x)).toReal := by
            apply lintegral_congr_ae
            filter_upwards [hVcompae] with x hx
            exact (ENNReal.ofReal_toReal hx).symm
      _ = ENNReal.ofReal (∫ x : Euclidean 2, (V (R • x)).toReal) :=
        (ofReal_integral_eq_lintegral_ofReal hcompint hcompnonneg).symm
  have hcompint_eq : (∫ x : Euclidean 2, (V (R • x)).toReal) =
      (R ^ (2 : Nat))⁻¹ * ∫ x : Euclidean 2, (V x).toReal := by
    simpa only [finrank_euclideanSpace_fin, smul_eq_mul] using
      (Measure.integral_comp_smul_of_nonneg volume
        (fun x : Euclidean 2 => (V x).toReal) R (hR := hR.le))
  calc
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (2 : Nat)) * V (R • x)) =
        ENNReal.ofReal (q ^ (2 : Nat)) * ∫⁻ x : Euclidean 2, V (R • x) :=
      lintegral_const_mul _ (hV.comp
        ((continuous_const : Continuous fun _ : Euclidean 2 => R).smul
          continuous_id).measurable)
    _ = ENNReal.ofReal (q ^ (2 : Nat)) *
        ENNReal.ofReal ((R ^ (2 : Nat))⁻¹ *
          ∫ x : Euclidean 2, (V x).toReal) := by
      rw [hcomplin, hcompint_eq]
    _ = ENNReal.ofReal q *
        ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) := by
      rw [← ENNReal.ofReal_mul (sq_nonneg q)]
      rw [show q ^ (2 : Nat) *
          ((R ^ (2 : Nat))⁻¹ * ∫ x : Euclidean 2, (V x).toReal) =
          (q ^ (2 : Nat) * (R ^ (2 : Nat))⁻¹) *
            ∫ x : Euclidean 2, (V x).toReal by ring]
      rw [ENNReal.ofReal_mul]
      · rw [show q ^ (2 : Nat) * (R ^ (2 : Nat))⁻¹ = q by
            rw [hq]
            field_simp [pow_ne_zero _ hR.ne']]
      · positivity
    _ = ENNReal.ofReal q * ∫⁻ x : Euclidean 2, V x := by
      rw [hVlin]

private theorem aux_l2_measurable_shiftedFatInputProjection_sq
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (fun x : Euclidean 2 => ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) := by
  let P := aux_shiftedFatInputProjectionSchwartz C j k f
  have hP : Continuous (fun x : Euclidean 2 =>
      aux_shiftedFatInputProjection C j k f x) := by
    have hPeq : (fun x : Euclidean 2 =>
        aux_shiftedFatInputProjection C j k f x) = fun x : Euclidean 2 => P x := by
      funext x
      exact (aux_shiftedFatInputProjectionSchwartz_apply C j k f x).symm
    rw [hPeq]
    exact P.continuous
  exact (ENNReal.continuous_ofReal.comp (hP.norm.pow 2)).measurable

private theorem aux_l2_lintegral_shiftedFatInputProjection_sq_ne_top
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) ≠ ∞ := by
  let P := aux_shiftedFatInputProjectionSchwartz C j k f
  have hPmem : MemLp P 2 volume := P.memLp 2 volume
  have hPint : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ (2 : Nat)) volume :=
    hPmem.integrable_norm_pow (by norm_num)
  have hPnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖P x‖ ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hlin : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (2 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) :=
    (ofReal_integral_eq_lintegral_ofReal hPint hPnonneg).symm
  rw [show (fun x : Euclidean 2 => ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) =
      fun x : Euclidean 2 => ENNReal.ofReal (‖P x‖ ^ (2 : Nat)) by
        funext x
        rw [show P x = aux_shiftedFatInputProjection C j k f x by
          exact aux_shiftedFatInputProjectionSchwartz_apply C j k f x]]
  rw [hlin]
  exact ENNReal.ofReal_ne_top

private theorem aux_l2_lintegral_unitFatInputProjection_sq_dilate_eq_shiftedFat
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ y : Euclidean 2, ENNReal.ofReal
      (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
        (2 : Nat))) =
      ENNReal.ofReal (((2 : Real) ^ k) ^ (2 : Nat)) *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) := by
  let a : Real := (2 : Real) ^ k
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  let V : Euclidean 2 → ENNReal := fun x => ENNReal.ofReal
    (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))
  have hVmeas : Measurable V := by
    simpa only [V] using aux_l2_measurable_shiftedFatInputProjection_sq C j k f
  have hVfinite : (∫⁻ x : Euclidean 2, V x) ≠ ∞ := by
    simpa only [V] using
      aux_l2_lintegral_shiftedFatInputProjection_sq_ne_top C j k f
  have hpoint (y : Euclidean 2) :
      ENNReal.ofReal
        (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
          (2 : Nat)) =
        ENNReal.ofReal ((a ^ (2 : Nat)) ^ (2 : Nat)) * V (a • y) := by
    rw [aux_unitFatInputProjection_dilate_eq_shiftedFat]
    change ENNReal.ofReal
        (‖(a ^ (2 : Nat)) • aux_shiftedFatInputProjection C j k f (a • y)‖ ^
          (2 : Nat)) =
        ENNReal.ofReal ((a ^ (2 : Nat)) ^ (2 : Nat)) * V (a • y)
    dsimp only [V]
    rw [norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg ha.le _), mul_pow]
    rw [ENNReal.ofReal_mul
      (pow_nonneg (pow_nonneg ha.le _) _)]
  calc
    (∫⁻ y : Euclidean 2, ENNReal.ofReal
      (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
        (2 : Nat))) =
        ∫⁻ y : Euclidean 2, ENNReal.ofReal ((a ^ (2 : Nat)) ^ (2 : Nat)) *
          V (a • y) := by
            apply lintegral_congr
            intro y
            exact hpoint y
    _ = ENNReal.ofReal (a ^ (2 : Nat)) * ∫⁻ x : Euclidean 2, V x :=
      aux_l2_lintegral_scaled_comp_smul_two V hVmeas hVfinite ha rfl
    _ = ENNReal.ofReal (((2 : Real) ^ k) ^ (2 : Nat)) *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) := by
      rfl

private theorem aux_l2_lintegral_restrictedRelativeBandpass_block_sq_le_of_unitFat
    (C : lpCutoffs 2) (A : ENNReal)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^
          (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^
          (2 : Nat)) ≤ A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (2 : Nat)))
    (j : Nat) (k : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (2 : Nat)) ≤
      A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) := by
  let a : Real := (2 : Real) ^ k
  let q : Real := (a⁻¹) ^ (2 : Nat)
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  have hq : 0 ≤ q := by
    dsimp only [q]
    positivity
  let U : Euclidean 2 → ENNReal :=
    aux_unitFatRelativeBandMax C j (aux_blockFrequencyData k f)
  obtain ⟨hUmeas, hUfinite, hUbound⟩ :=
    hunit j (aux_blockFrequencyData k f)
  have hUmeas' : Measurable U := by
    simpa only [U] using hUmeas
  have hUfinite' : (∫⁻ x : Euclidean 2, U x ^ (2 : Nat)) ≠ ∞ := by
    simpa only [U] using hUfinite
  have hUbound' : (∫⁻ x : Euclidean 2, U x ^ (2 : Nat)) ≤
      A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) x‖ ^
          (2 : Nat)) := by
    simpa only [U] using hUbound
  have hpoint (x : Euclidean 2) :
      restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x ≤
