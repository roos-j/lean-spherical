        (dyadicRadiusBlockUnion (Ioi (0 : Real)) K) C.cutoff j f x) ^ (2 : Nat)) ≤
      A * B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
  have hblockmeas (k : Int) :
      Measurable (fun x : Euclidean 2 =>
        (restrictedRelativeBandpassSphericalMaximal 2
          (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
          C.cutoff j f x) ^ (2 : Nat)) :=
    (Auto.Spherical.PowerWeights.measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
        C.cutoff f C.cutoff_one C.cutoff_zero j).pow_const 2
  have hblock (k : Int) :
      (∫⁻ x : Euclidean 2,
        (restrictedRelativeBandpassSphericalMaximal 2
          (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
          C.cutoff j f x) ^ (2 : Nat)) ≤
        A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) := by
    rw [aux_dyadicRadiusBlock_inter_pos_eq k]
    exact aux_l2_lintegral_restrictedRelativeBandpass_block_sq_le_of_unitFat
      C A hunit j k f
  have hPmeas (k : Int) :
      Measurable (fun x : Euclidean 2 => ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) :=
    aux_l2_measurable_shiftedFatInputProjection_sq C j k f
  calc
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (dyadicRadiusBlockUnion (Ioi (0 : Real)) K) C.cutoff j f x) ^ (2 : Nat)) ≤
        ∫⁻ x : Euclidean 2, ∑ k ∈ K,
          (restrictedRelativeBandpassSphericalMaximal 2
            (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
            C.cutoff j f x) ^ (2 : Nat) :=
      lintegral_mono (fun x =>
        aux_l2_restrictedRelativeBandpass_sq_le_sum_radius_blocks
          (Ioi (0 : Real)) K C j f x)
    _ = ∑ k ∈ K, ∫⁻ x : Euclidean 2,
          (restrictedRelativeBandpassSphericalMaximal 2
            (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
            C.cutoff j f x) ^ (2 : Nat) :=
      MeasureTheory.lintegral_finsetSum K (fun k hk => hblockmeas k)
    _ ≤ ∑ k ∈ K, A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) :=
      Finset.sum_le_sum fun k hk => hblock k
    _ = A * ∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)) := by
      rw [MeasureTheory.lintegral_finsetSum K (fun k hk => hPmeas k)]
      rw [← Finset.mul_sum]
    _ ≤ A *
        (B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat))) := by
      gcongr
      exact hLP j K f
    _ = A * B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
      ring

