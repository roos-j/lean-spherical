/-- A fixed homogeneous frequency packet can arise from at most five shifted
fat annuli.  This cardinality-free overlap is the finite combinatorial input
to the `L⁴` reassembly. -/
private theorem aux_sum_five_shifted_windows_le
    (a : Int) (K : Finset Int) (e : Int → Real)
    (he : ∀ n, 0 ≤ e n) :
    (∑ k ∈ K, ∑ i ∈ Finset.range 5, e (a - k + (i : Int))) ≤
      5 * ∑ n ∈ (K.product (Finset.range 5)).image
        (fun p : Int × Nat => a - p.1 + (p.2 : Int)), e n := by
  classical
  let S : Finset (Int × Nat) := K.product (Finset.range 5)
  let m : Int × Nat → Int := fun p => a - p.1 + (p.2 : Int)
  let T : Finset Int := S.image m
  have hmap : ∀ p ∈ S, m p ∈ T := by
    intro p hp
    exact Finset.mem_image.mpr ⟨p, hp, rfl⟩
  have hfiber_card (n : Int) : (S.filter fun p => m p = n).card ≤ 5 := by
    have hcard : (S.filter fun p => m p = n).card ≤ (Finset.range 5).card := by
      apply Finset.card_le_card_of_injOn Prod.snd
      · intro p hp
        have hp' := (Finset.mem_filter.mp hp).1
        exact (Finset.mem_product.mp hp').2
      · intro p hp q hq hpq
        have hp' : m p = n := (Finset.mem_filter.mp hp).2
        have hq' : m q = n := (Finset.mem_filter.mp hq).2
        dsimp only [m] at hp' hq'
        have hfirst : p.1 = q.1 := by omega
        exact Prod.ext hfirst hpq
    simpa using hcard
  have hfiber_bound (n : Int) (hn : n ∈ T) :
      (∑ p ∈ S with m p = n, e n) ≤ 5 * e n := by
    rw [Finset.sum_const, nsmul_eq_mul]
    exact mul_le_mul_of_nonneg_right (by exact_mod_cast hfiber_card n) (he n)
  have hfiber_sum :
      (∑ n ∈ T, ∑ p ∈ S with m p = n, e n) ≤
        ∑ n ∈ T, 5 * e n := by
    apply Finset.sum_le_sum
    intro n hn
    exact hfiber_bound n hn
  have hdouble :
      (∑ n ∈ T, ∑ p ∈ S with m p = n, e n) =
        ∑ p ∈ S, e (m p) := by
    exact Finset.sum_fiberwise_of_maps_to' hmap e
  calc
    (∑ k ∈ K, ∑ i ∈ Finset.range 5, e (a - k + (i : Int))) =
        ∑ p ∈ S, e (m p) := by
      change Finset.sum K (fun k => Finset.sum (Finset.range 5)
        (fun i => e (a - k + (i : Int)))) =
        Finset.sum (K.product (Finset.range 5))
          (fun p => e (a - p.1 + (p.2 : Int)))
      exact (Finset.sum_product K (Finset.range 5)
        (fun p : Int × Nat => e (a - p.1 + (p.2 : Int)))).symm
    _ = ∑ n ∈ T, ∑ p ∈ S with m p = n, e n := hdouble.symm
    _ ≤ ∑ n ∈ T, 5 * e n := hfiber_sum
    _ = 5 * ∑ n ∈ T, e n := by rw [Finset.mul_sum]
    _ = 5 * ∑ n ∈ (K.product (Finset.range 5)).image
        (fun p : Int × Nat => a - p.1 + (p.2 : Int)), e n := by rfl

