open Auto.MikhlinHormander

/-- A compact Schwartz realization of the literal `j`th dyadic annulus.
The choice is pinned down pointwise below, so it is only a packaging device
for subsequent multiplier composition. -/
private noncomputable def aux_dyadicBandpassSchwartz
    (C : lpCutoffs 2) (j : Nat) : SchwartzMap (Euclidean 2) Complex :=
  Classical.choose
    (Auto.Spherical.Auxiliary.exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      C.cutoff C.cutoff_one C.cutoff_zero j)

private theorem aux_dyadicBandpassSchwartz_apply
    (C : lpCutoffs 2) (j : Nat) (xi : Euclidean 2) :
    aux_dyadicBandpassSchwartz C j xi =
      C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • xi) -
        C.cutoff (((2 : Real) ^ j)⁻¹ • xi) := by
  exact (Classical.choose_spec
    (Auto.Spherical.Auxiliary.exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      C.cutoff C.cutoff_one C.cutoff_zero j)).1 xi

private theorem aux_dyadicBandpassSchwartz_eq_dyadicBandpassMultiplier
    (C : lpCutoffs 2) (j : Nat) (xi : Euclidean 2) :
    aux_dyadicBandpassSchwartz C j xi =
      dyadicBandpassMultiplier C.cutoff j xi := by
  rw [aux_dyadicBandpassSchwartz_apply, dyadicBandpassMultiplier_apply]

private theorem aux_dyadicBandpassSchwartz_compact
    (C : lpCutoffs 2) (j : Nat) :
    HasCompactSupport (aux_dyadicBandpassSchwartz C j : Euclidean 2 → Complex) := by
  exact (Classical.choose_spec
    (Auto.Spherical.Auxiliary.exists_compactlySupported_schwartzMap_smooth_dyadic_bandpass
      C.cutoff C.cutoff_one C.cutoff_zero j)).2.1

/-- Uniform fixed-time `L²` stability for the moving compact relative
multiplier.  The constant is independent of both the relative scale and the
ordinary circle scale. -/
private theorem aux_exists_integral_norm_sq_relativeBandFatUnit_apply_le
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀
      (t : CircleRelativeBandLocalTime)
      (r : Ioi (0 : Real)) (u : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t) r u x‖ ^ 2) ≤
        B * ∫ x : Euclidean 2, ‖u x‖ ^ 2 := by
  obtain ⟨A, hA, hkernel⟩ :=
    exists_circleRelativeBandFatUnit_uniformKernelBound C
  obtain ⟨K, hK, hmajorant⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (circleRelativeBandFatUnitFamily C) hA hkernel
  obtain ⟨H, hH, hhardy⟩ :=
    Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 2) (by norm_num)
  refine ⟨K ^ 2 * H, mul_pos (pow_pos hK _) hH, ?_⟩
  intro t r u
  let E : Euclidean 2 → Complex :=
    relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t) r u
  let M : Euclidean 2 → Real :=
    Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 2) := by
    have h := hM.1.integrable_norm_rpow
      (by norm_num : (ENNReal.ofReal (2 : Real)) ≠ 0) ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 2)]
    norm_num
  have hEcont : Continuous E := by
    exact continuous_relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t) u r
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 2 ≤ K ^ 2 * M x ^ 2 := by
    have h := hmajorant t u r x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 2 ≤ (K * M x) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h 2
      _ = K ^ 2 * M x ^ 2 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 => K ^ 2 * M x ^ 2) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 2) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 2).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (2 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  calc
    (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t) r u x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖E x‖ ^ 2 := rfl
    _ ≤ ∫ x : Euclidean 2, K ^ 2 * M x ^ 2 :=
      integral_mono hEpowInt hdomInt hpoint
    _ = K ^ 2 * ∫ x : Euclidean 2, M x ^ 2 := by rw [integral_const_mul]
    _ ≤ K ^ 2 * (H * ∫ x : Euclidean 2, ‖u x‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_left
        (show (∫ x : Euclidean 2, M x ^ 2) ≤ H * ∫ x : Euclidean 2, ‖u x‖ ^ 2 by
          convert hM.2 using 1
          · apply integral_congr_ae
            filter_upwards with x
            change M x ^ (2 : Nat) = M x ^ (2 : Real)
            exact (Real.rpow_natCast (M x) 2).symm
          · congr 1
            apply integral_congr_ae
            filter_upwards with x
            exact (Real.rpow_natCast ‖u x‖ 2).symm)
        (pow_nonneg hK.le _)
    _ = (K ^ 2 * H) * ∫ x : Euclidean 2, ‖u x‖ ^ 2 := by ring

/-- The same uniform fixed-time `L²` stability for the literal `qdot`
family. -/
private theorem aux_exists_integral_norm_sq_relativeBandFatUnitTimeDerivative_apply_le
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀
      (t : CircleRelativeBandLocalTime)
      (r : Ioi (0 : Real)) (u : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t) r u x‖ ^ 2) ≤
        B * ∫ x : Euclidean 2, ‖u x‖ ^ 2 := by
  obtain ⟨A, hA, hkernel⟩ :=
    exists_circleRelativeBandFatUnitTimeDerivative_uniformKernelBound C
  obtain ⟨K, hK, hmajorant⟩ :=
    uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (circleRelativeBandFatUnitTimeDerivative C) hA hkernel
  obtain ⟨H, hH, hhardy⟩ :=
    Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 2) (by norm_num)
  refine ⟨K ^ 2 * H, mul_pos (pow_pos hK _) hH, ?_⟩
  intro t r u
  let E : Euclidean 2 → Complex :=
    relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t) r u
  let M : Euclidean 2 → Real :=
    Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 2) := by
    have h := hM.1.integrable_norm_rpow
      (by norm_num : (ENNReal.ofReal (2 : Real)) ≠ 0) ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 2)]
    norm_num
  have hEcont : Continuous E := by
    exact continuous_relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t) u r
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 2 ≤ K ^ 2 * M x ^ 2 := by
    have h := hmajorant t u r x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 2 ≤ (K * M x) ^ 2 := pow_le_pow_left₀ (norm_nonneg _) h 2
      _ = K ^ 2 * M x ^ 2 := by ring
  have hdomInt : Integrable (fun x : Euclidean 2 => K ^ 2 * M x ^ 2) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 2) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 2).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (2 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  calc
    (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t) r u x‖ ^ 2) =
        ∫ x : Euclidean 2, ‖E x‖ ^ 2 := rfl
    _ ≤ ∫ x : Euclidean 2, K ^ 2 * M x ^ 2 :=
      integral_mono hEpowInt hdomInt hpoint
    _ = K ^ 2 * ∫ x : Euclidean 2, M x ^ 2 := by rw [integral_const_mul]
    _ ≤ K ^ 2 * (H * ∫ x : Euclidean 2, ‖u x‖ ^ 2) := by
      apply mul_le_mul_of_nonneg_left
        (show (∫ x : Euclidean 2, M x ^ 2) ≤ H * ∫ x : Euclidean 2, ‖u x‖ ^ 2 by
          convert hM.2 using 1
          · apply integral_congr_ae
            filter_upwards with x
            change M x ^ (2 : Nat) = M x ^ (2 : Real)
            exact (Real.rpow_natCast (M x) 2).symm
          · congr 1
            apply integral_congr_ae
            filter_upwards with x
            exact (Real.rpow_natCast ‖u x‖ 2).symm)
        (pow_nonneg hK.le _)
    _ = (K ^ 2 * H) * ∫ x : Euclidean 2, ‖u x‖ ^ 2 := by ring

/-- The planar replacement for the higher-dimensional moving-band surface
derivative estimate.  It uses the literal circle derivative bound after
absorbing the time scale into frequency; no `2 ≤ d` hypothesis is used. -/
private theorem aux_norm_deriv_circle_surfaceFourier_neg_smul_mul_relative_dyadic_bandpass_le
    (C₁ : Real) (hC₁ : 0 < C₁)
    (hderiv : ∀ xi : Euclidean 2, ∀ r : Real, 1 ≤ ‖xi‖ → r ∈ Icc (1 : Real) 2 →
      ‖deriv (fun s : Real => surfaceFourier 2 (s • xi)) r‖ ≤
        C₁ / ‖xi‖ ^ ((1 : Real) / 2 - 1))
    {φ : SchwartzMap (Euclidean 2) Complex}
    (hφone : ∀ xi, ‖xi‖ ≤ 1 → φ xi = 1)
    (hφzero : ∀ xi, 2 ≤ ‖xi‖ → φ xi = 0)
    (hφnorm : ∀ xi, ‖φ xi‖ ≤ 1)
    (j : Nat) (r : Real) (hr : r ∈ Icc (1 : Real) 2)
    (xi : Euclidean 2) :
    ‖deriv (fun s : Real => surfaceFourier 2 (-s • xi)) r *
      (φ (((2 : Real) ^ (j + 1))⁻¹ • (r • xi)) -
        φ (((2 : Real) ^ j)⁻¹ • (r • xi)))‖ ≤
      4 * C₁ * dyadicScale j ^ ((1 : Real) / 2) := by
  have hfixed := norm_deriv_circle_surfaceFourier_smul_mul_smooth_dyadic_bandpass_le_of_sharp
    C₁ hC₁ hderiv hφone hφzero hφnorm j (1 : Real) (by norm_num) (r • xi)
  have hrescale :=
    Auto.Spherical.Auxiliary.deriv_surfaceFourier_radial_rescale 2 xi r
  have hfun : (fun s : Real => surfaceFourier 2 (-s • xi)) =
      fun s : Real => surfaceFourier 2 (s • xi) := by
    funext s
    rw [show (-s : Real) • xi = -(s • xi) by rw [neg_smul], surfaceFourier_neg]
  rw [hrescale] at hfixed
  rw [hfun]
  calc
    ‖deriv (fun s : Real => surfaceFourier 2 (s • xi)) r *
        (φ (((2 : Real) ^ (j + 1))⁻¹ • (r • xi)) -
          φ (((2 : Real) ^ j)⁻¹ • (r • xi)))‖ ≤
        ‖r • deriv (fun s : Real => surfaceFourier 2 (s • xi)) r *
          (φ (((2 : Real) ^ (j + 1))⁻¹ • (r • xi)) -
            φ (((2 : Real) ^ j)⁻¹ • (r • xi)))‖ := by
      rw [smul_mul_assoc, norm_smul, Real.norm_eq_abs,
        abs_of_nonneg (zero_le_one.trans hr.1)]
      have hN : 0 ≤ ‖deriv (fun s : Real => surfaceFourier 2 (s • xi)) r *
          (φ (((2 : Real) ^ (j + 1))⁻¹ • (r • xi)) -
            φ (((2 : Real) ^ j)⁻¹ • (r • xi)))‖ := norm_nonneg _
      exact le_mul_of_one_le_left hN hr.1
    _ ≤ 4 * C₁ * dyadicScale j ^ ((1 : Real) / 2) := hfixed

/-- A compact Schwartz realization of the ordinary `k`th dyadic circle
multiplier.  This is deliberately separate from the moving `q` factor. -/
private noncomputable def aux_thinCircleSurfaceSymbol
    (C : lpCutoffs 2) (k : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  Classical.choose
    (Auto.Spherical.SurfaceMeasureDecay.exists_schwartz_compactSupport_mul_surfaceFourier
      (aux_dyadicBandpassSchwartz C k) (aux_dyadicBandpassSchwartz_compact C k) t)

private theorem aux_thinCircleSurfaceSymbol_apply
    (C : lpCutoffs 2) (k : Nat) (t : Real) (xi : Euclidean 2) :
    aux_thinCircleSurfaceSymbol C k t xi =
      aux_dyadicBandpassSchwartz C k xi * surfaceFourier 2 (-t • xi) := by
  exact Classical.choose_spec
    (Auto.Spherical.SurfaceMeasureDecay.exists_schwartz_compactSupport_mul_surfaceFourier
      (aux_dyadicBandpassSchwartz C k) (aux_dyadicBandpassSchwartz_compact C k) t) xi

/-- The matching compact Fourier symbol when the radius derivative lands on
the surface transform. -/
private noncomputable def aux_thinCircleSurfaceDerivativeSymbol
    (C : lpCutoffs 2) (k : Nat) (t : Real) :
    SchwartzMap (Euclidean 2) Complex :=
  Classical.choose
    (exists_schwartz_compactSupport_mul_surfaceFourier_radius_deriv
      (aux_dyadicBandpassSchwartz C k) (aux_dyadicBandpassSchwartz_compact C k) t)

private theorem aux_thinCircleSurfaceDerivativeSymbol_apply
    (C : lpCutoffs 2) (k : Nat) (t : Real) (xi : Euclidean 2) :
    aux_thinCircleSurfaceDerivativeSymbol C k t xi =
      aux_dyadicBandpassSchwartz C k xi *
        deriv (fun s : Real => surfaceFourier 2 (s • -xi)) t := by
  exact Classical.choose_spec
    (exists_schwartz_compactSupport_mul_surfaceFourier_radius_deriv
      (aux_dyadicBandpassSchwartz C k) (aux_dyadicBandpassSchwartz_compact C k) t) xi

private noncomputable def aux_thinCircleSchwartzOutput
    (C : lpCutoffs 2) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (aux_thinCircleSurfaceSymbol C k t : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_thinCircleSchwartzOutput_fourier
    (C : lpCutoffs 2) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    𝓕 (aux_thinCircleSchwartzOutput C k t f : Euclidean 2 → Complex) xi =
      aux_thinCircleSurfaceSymbol C k t xi * 𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold aux_thinCircleSchwartzOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (aux_thinCircleSurfaceSymbol C k t).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

private noncomputable def aux_thinCircleSchwartzOutputTimeDerivative
    (C : lpCutoffs 2) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (aux_thinCircleSurfaceDerivativeSymbol C k t : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_thinCircleSchwartzOutputTimeDerivative_fourier
    (C : lpCutoffs 2) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    𝓕 (aux_thinCircleSchwartzOutputTimeDerivative C k t f : Euclidean 2 → Complex) xi =
      aux_thinCircleSurfaceDerivativeSymbol C k t xi *
        𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold aux_thinCircleSchwartzOutputTimeDerivative
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [SchwartzMap.smulLeftCLM_apply
    (aux_thinCircleSurfaceDerivativeSymbol C k t).hasTemperateGrowth,
    smul_eq_mul, SchwartzMap.fourier_coe]

/-- The compact ordinary circle factor has the sharp fixed-time planar
`L²` gain.  This is the first energy input for the q/qdot sampler. -/
private theorem aux_exists_integral_norm_sq_thinCircleSchwartzOutput_le_dyadicSqrtInverse
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (k : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
      (∫ x : Euclidean 2, ‖aux_thinCircleSchwartzOutput C k t f x‖ ^ 2) ≤
        (B / Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  rcases circleStationaryPhase with
    ⟨C₀, C₁, hC₀, hC₁, hdecay, hderiv⟩
  refine ⟨2 * C₀, mul_pos (by norm_num) hC₀, ?_⟩
  intro k t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex := aux_thinCircleSurfaceSymbol C k t
  have hm_bound (xi : Euclidean 2) :
      ‖m xi‖ ≤ (2 * C₀) / Real.sqrt (dyadicScale k) := by
    rw [show m xi = aux_thinCircleSurfaceSymbol C k t xi by rfl,
      aux_thinCircleSurfaceSymbol_apply,
      aux_dyadicBandpassSchwartz_apply, norm_mul,
      show surfaceFourier 2 (-t • xi) = surfaceFourier 2 (t • xi) by
        rw [show (-t : Real) • xi = -(t • xi) by rw [neg_smul], surfaceFourier_neg]]
    rw [mul_comm]
    simpa only [norm_mul, Real.sqrt_eq_rpow] using
      (norm_circle_surfaceFourier_smul_mul_smooth_dyadic_bandpass_le_of_sharp
        C₀ hC₀ hdecay C.cutoff_one C.cutoff_zero C.norm_le_one k t ⟨ht, htop⟩ xi)
  have hmult := Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (div_nonneg (mul_nonneg (by norm_num) hC₀.le) (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2, ‖aux_thinCircleSchwartzOutput C k t f x‖ ^ 2) =
        ∫ x : Euclidean 2,
          ‖𝓕⁻ (fun xi : Euclidean 2 => m xi * 𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with x
            unfold aux_thinCircleSchwartzOutput
            rw [SchwartzMap.fourierInv_coe]
            congr 1
            apply congrArg norm
            apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
            funext xi
            rw [show m xi = aux_thinCircleSurfaceSymbol C k t xi by rfl,
              SchwartzMap.smulLeftCLM_apply_apply
                (aux_thinCircleSurfaceSymbol C k t).hasTemperateGrowth]
            simp only [smul_eq_mul, SchwartzMap.fourier_coe]
    _ ≤ ((2 * C₀) / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = ((2 * C₀) / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
          rw [Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- Differentiating the ordinary compact circle factor has the matching
square-root growth.  The equality of the two radial sign conventions is
spelled out here so the planar proof never reaches for a `d ≥ 3` result. -/
private theorem
    aux_exists_integral_norm_sq_thinCircleSchwartzOutputTimeDerivative_le_dyadicSqrt
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (k : Nat) (t : Real), 1 ≤ t → t ≤ 2 →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
      (∫ x : Euclidean 2,
        ‖aux_thinCircleSchwartzOutputTimeDerivative C k t f x‖ ^ 2) ≤
        (B * Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  rcases circleStationaryPhase with
    ⟨C₀, C₁, hC₀, hC₁, hdecay, hderiv⟩
  refine ⟨4 * C₁, mul_pos (by norm_num) hC₁, ?_⟩
  intro k t ht htop f
  let m : SchwartzMap (Euclidean 2) Complex :=
    aux_thinCircleSurfaceDerivativeSymbol C k t
  have hm_bound (xi : Euclidean 2) :
      ‖m xi‖ ≤ (4 * C₁) * Real.sqrt (dyadicScale k) := by
    have hsign :
        (fun s : Real => surfaceFourier 2 (s • -xi)) =
          fun s : Real => surfaceFourier 2 (s • xi) := by
      funext s
      rw [show s • -xi = -(s • xi) by rw [smul_neg], surfaceFourier_neg]
    rw [show m xi = aux_thinCircleSurfaceDerivativeSymbol C k t xi by rfl,
      aux_thinCircleSurfaceDerivativeSymbol_apply,
      aux_dyadicBandpassSchwartz_apply, hsign, norm_mul, mul_comm]
    simpa only [norm_mul, Real.sqrt_eq_rpow] using
      (norm_deriv_circle_surfaceFourier_smul_mul_smooth_dyadic_bandpass_le_of_sharp
        C₁ hC₁ hderiv C.cutoff_one C.cutoff_zero C.norm_le_one k t ⟨ht, htop⟩ xi)
  have hmult := Auto.Spherical.Auxiliary.integral_norm_sq_fourierInv_schwartz_multiplier_le
    m (𝓕 f) (mul_nonneg (mul_nonneg (by norm_num) hC₁.le) (Real.sqrt_nonneg _)) hm_bound
  calc
    (∫ x : Euclidean 2,
        ‖aux_thinCircleSchwartzOutputTimeDerivative C k t f x‖ ^ 2) =
        ∫ x : Euclidean 2,
          ‖𝓕⁻ (fun xi : Euclidean 2 => m xi *
            𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with x
            unfold aux_thinCircleSchwartzOutputTimeDerivative
            rw [SchwartzMap.fourierInv_coe]
            congr 1
            apply congrArg norm
            apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
            funext xi
            rw [show m xi = aux_thinCircleSurfaceDerivativeSymbol C k t xi by rfl,
              SchwartzMap.smulLeftCLM_apply_apply
                (aux_thinCircleSurfaceDerivativeSymbol C k t).hasTemperateGrowth]
            simp only [smul_eq_mul, SchwartzMap.fourier_coe]
    _ ≤ ((4 * C₁) * Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ xi : Euclidean 2, ‖𝓕 (f : Euclidean 2 → Complex) xi‖ ^ 2 := hmult
    _ = ((4 * C₁) * Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
          rw [Auto.Spherical.Auxiliary.integral_norm_sq_fourier_schwartz_eq]

/-- The public literal dyadic unit-slab output is exactly `q_j(t)` applied
to the compact ordinary circle factor.  The relative index is `j`; `k` is
the ordinary circle frequency. -/
private theorem aux_circleRelativeBandFatUnitSlabDyadicOutput_eq_relativeMultiplierAt
    (C : lpCutoffs 2) (j k : Nat)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabDyadicOutput C j k t f x =
      relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j) (aux_thinCircleSchwartzOutput C k t.1 f) x := by
  unfold circleRelativeBandFatUnitSlabDyadicOutput
  unfold relativeSchwartzMultiplierAt
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext xi
  change circleRelativeBandFatUnitFamily C t
      (((2 : Real) ^ j)⁻¹ • xi) *
        surfaceFourier 2 (-t.1 • xi) *
        dyadicBandpassMultiplier C.cutoff k xi *
        𝓕 (f : Euclidean 2 → Complex) xi = _
  rw [aux_thinCircleSchwartzOutput_fourier,
    aux_thinCircleSurfaceSymbol_apply,
    aux_dyadicBandpassSchwartz_eq_dyadicBandpassMultiplier]
  simp only [dyadicFrequencyScale]
  ring

/-- Fixed-time energy of the literal moving unit-slab dyadic output.  The
constant is uniform in the relative scale `j`; the ordinary circle scale is
the one carrying the sharp square-root gain. -/
private theorem
    aux_exists_integral_norm_sq_circleRelativeBandFatUnitSlabDyadicOutput_le
    (C : lpCutoffs 2) :
    ∃ Q A : Real, 0 < Q ∧ 0 < A ∧ ∀ (j k : Nat)
      (t : CircleRelativeBandLocalTime)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2) ≤
        Q * (A / Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨Q, hQ, hq⟩ := aux_exists_integral_norm_sq_relativeBandFatUnit_apply_le C
  obtain ⟨A, hA, hcircle⟩ :=
    aux_exists_integral_norm_sq_thinCircleSchwartzOutput_le_dyadicSqrtInverse C
  refine ⟨Q, A, hQ, hA, ?_⟩
  intro j k t f
  let H : SchwartzMap (Euclidean 2) Complex := aux_thinCircleSchwartzOutput C k t.1 f
  have hfac : ∀ x : Euclidean 2,
      circleRelativeBandFatUnitSlabDyadicOutput C j k t f x =
        relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (dyadicFrequencyScale j) H x := by
    intro x
    simpa only [H] using
      aux_circleRelativeBandFatUnitSlabDyadicOutput_eq_relativeMultiplierAt C j k t f x
  calc
    (∫ x : Euclidean 2,
        ‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2) =
        ∫ x : Euclidean 2,
          ‖relativeSchwartzMultiplierAt
            (circleRelativeBandFatUnitFamily C t)
            (dyadicFrequencyScale j) H x‖ ^ 2 := by
          apply integral_congr_ae
          filter_upwards with x
          rw [hfac x]
    _ ≤ Q * ∫ x : Euclidean 2,
          ‖H x‖ ^ 2 := hq t (dyadicFrequencyScale j) H
    _ ≤ Q * ((A / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left
            (by simpa only [H] using hcircle k t.1 t.2.1 t.2.2 f) hQ.le
    _ = Q * (A / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- The `qdot` part of the product rule has the same square-root gain as
the undifferentiated compact circle factor. -/
private theorem
    aux_exists_integral_norm_sq_relativeBandFatUnitTimeDerivative_thinCircle_le
    (C : lpCutoffs 2) :
    ∃ Q A : Real, 0 < Q ∧ 0 < A ∧ ∀ (j k : Nat)
      (t : CircleRelativeBandLocalTime)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t)
          (dyadicFrequencyScale j) (aux_thinCircleSchwartzOutput C k t.1 f) x‖ ^ 2) ≤
        Q * (A / Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨Q, hQ, hq⟩ :=
    aux_exists_integral_norm_sq_relativeBandFatUnitTimeDerivative_apply_le C
  obtain ⟨A, hA, hcircle⟩ :=
    aux_exists_integral_norm_sq_thinCircleSchwartzOutput_le_dyadicSqrtInverse C
  refine ⟨Q, A, hQ, hA, ?_⟩
  intro j k t f
  calc
    (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t)
          (dyadicFrequencyScale j) (aux_thinCircleSchwartzOutput C k t.1 f) x‖ ^ 2) ≤
        Q * ∫ x : Euclidean 2,
          ‖aux_thinCircleSchwartzOutput C k t.1 f x‖ ^ 2 :=
      hq t (dyadicFrequencyScale j) (aux_thinCircleSchwartzOutput C k t.1 f)
    _ ≤ Q * ((A / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left
            (hcircle k t.1 t.2.1 t.2.2 f) hQ.le
    _ = Q * (A / Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- The second product-rule summand: `q` applied to the compact ordinary
surface derivative. -/
private theorem
    aux_exists_integral_norm_sq_relativeBandFatUnit_thinCircleTimeDerivative_le
    (C : lpCutoffs 2) :
    ∃ Q A : Real, 0 < Q ∧ 0 < A ∧ ∀ (j k : Nat)
      (t : CircleRelativeBandLocalTime)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (dyadicFrequencyScale j)
          (aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f) x‖ ^ 2) ≤
        Q * (A * Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨Q, hQ, hq⟩ := aux_exists_integral_norm_sq_relativeBandFatUnit_apply_le C
  obtain ⟨A, hA, hcircle⟩ :=
    aux_exists_integral_norm_sq_thinCircleSchwartzOutputTimeDerivative_le_dyadicSqrt C
  refine ⟨Q, A, hQ, hA, ?_⟩
  intro j k t f
  calc
    (∫ x : Euclidean 2,
        ‖relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (dyadicFrequencyScale j)
          (aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f) x‖ ^ 2) ≤
        Q * ∫ x : Euclidean 2,
          ‖aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f x‖ ^ 2 :=
      hq t (dyadicFrequencyScale j)
        (aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f)
    _ ≤ Q * ((A * Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
          apply mul_le_mul_of_nonneg_left
            (hcircle k t.1 t.2.1 t.2.2 f) hQ.le
    _ = Q * (A * Real.sqrt (dyadicScale k)) ^ 2 *
        ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by ring

/-- The unscaled moving relative difference, extended to all real times so
the literal time sampler can use an honest derivative rather than only a
subtype-time identity. -/
private noncomputable def aux_relativeBandUnitDifferenceRaw
    (C : lpCutoffs 2) (t : Real) (eta : Euclidean 2) : Complex :=
  C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta)) -
    C.cutoff (((2 : Real) ^ 0)⁻¹ • (t • eta))

/-- Time derivative of `aux_relativeBandUnitDifferenceRaw`. -/
private noncomputable def aux_relativeBandUnitDifferenceRawTimeDerivative
    (C : lpCutoffs 2) (t : Real) (eta : Euclidean 2) : Complex :=
  fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ (0 + 1))⁻¹ • (t • eta))
      (((2 : Real) ^ (0 + 1))⁻¹ • eta) -
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
      (((2 : Real) ^ 0)⁻¹ • (t • eta))
      (((2 : Real) ^ 0)⁻¹ • eta)

private theorem aux_continuous_uncurry_relativeBandUnitDifferenceRaw
    (C : lpCutoffs 2) :
    Continuous (Function.uncurry (aux_relativeBandUnitDifferenceRaw C)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    C.cutoff (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2)) -
      C.cutoff (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2)))
  exact ((C.cutoff.smooth 0).continuous.comp (by fun_prop)).sub
    ((C.cutoff.smooth 0).continuous.comp (by fun_prop))

private theorem aux_continuous_uncurry_relativeBandUnitDifferenceRawTimeDerivative
    (C : lpCutoffs 2) :
    Continuous (Function.uncurry
      (aux_relativeBandUnitDifferenceRawTimeDerivative C)) := by
  have hderiv : Continuous (fderiv Real (C.cutoff : Euclidean 2 → Complex)) :=
    (C.cutoff.smooth 1).continuous_fderiv (by norm_num)
  change Continuous (fun q : Real × Euclidean 2 =>
    fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ (0 + 1))⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ (0 + 1))⁻¹ • q.2) -
      fderiv Real (C.cutoff : Euclidean 2 → Complex)
        (((2 : Real) ^ 0)⁻¹ • (q.1 • q.2))
        (((2 : Real) ^ 0)⁻¹ • q.2))
  apply Continuous.sub
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)
  · exact (hderiv.comp (by fun_prop)).clm_apply (by fun_prop)

private theorem aux_relativeBandUnitDifferenceRaw_mul_fat_eq_family
    (C : lpCutoffs 2) (t : CircleRelativeBandLocalTime)
    (eta : Euclidean 2) :
    aux_relativeBandUnitDifferenceRaw C t.1 eta *
        fatDyadicBandpassPrototype C.cutoff eta =
      circleRelativeBandFatUnitFamily C t eta := by
  rw [circleRelativeBandFatUnitFamily_apply]
  unfold aux_relativeBandUnitDifferenceRaw
  have hhalf : ((2 : Real) ^ (0 + 1))⁻¹ * t.1 = t.1 / 2 := by norm_num; ring
  have hone : ((2 : Real) ^ 0)⁻¹ * t.1 = t.1 := by norm_num
  simp only [smul_smul]
  rw [hhalf, hone]

private theorem aux_relativeBandUnitDifferenceRawTimeDerivative_mul_fat_eq_family
    (C : lpCutoffs 2) (t : CircleRelativeBandLocalTime)
    (eta : Euclidean 2) :
    aux_relativeBandUnitDifferenceRawTimeDerivative C t.1 eta *
        fatDyadicBandpassPrototype C.cutoff eta =
      circleRelativeBandFatUnitTimeDerivative C t eta := by
  rw [circleRelativeBandFatUnitTimeDerivative_apply]
  unfold aux_relativeBandUnitDifferenceRawTimeDerivative
  simp only [smul_smul]

/-- A jointly continuous concrete realization of the radial circle Fourier
derivative.  Writing the derivative integral explicitly is what keeps the
planar sampler independent of any higher-dimensional maximal theorem. -/
private noncomputable def aux_circleSurfaceFourierTimeDerivative
    (t : Real) (xi : Euclidean 2) : Complex :=
  ∫ omega : Metric.sphere (0 : Euclidean 2) 1,
    Complex.exp (surfacePhase 2 (t • -xi) omega) * surfacePhase 2 (-xi) omega
      ∂unitSurfaceMeasure 2

private theorem aux_circleSurfaceFourierTimeDerivative_eq_deriv
    (t : Real) (xi : Euclidean 2) :
    aux_circleSurfaceFourierTimeDerivative t xi =
      deriv (fun s : Real => surfaceFourier 2 (s • -xi)) t := by
  simpa only [aux_circleSurfaceFourierTimeDerivative] using
    (Auto.Spherical.Auxiliary.hasDerivAt_surfaceFourier_radial_at 2 (-xi) t).deriv.symm

private theorem aux_continuous_uncurry_circleSurfaceFourierTimeDerivative :
    Continuous (Function.uncurry aux_circleSurfaceFourierTimeDerivative) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    ∫ omega : Metric.sphere (0 : Euclidean 2) 1,
      Complex.exp (surfacePhase 2 (q.1 • -q.2) omega) * surfacePhase 2 (-q.2) omega
        ∂unitSurfaceMeasure 2)
  have hcont : Continuous (Function.uncurry
      (fun (q : Real × Euclidean 2) (omega : Metric.sphere (0 : Euclidean 2) 1) =>
        Complex.exp (surfacePhase 2 (q.1 • -q.2) omega) *
          surfacePhase 2 (-q.2) omega)) := by
    unfold surfacePhase
    fun_prop
  simpa only [Measure.restrict_univ] using
    (continuous_parametric_integral_of_continuous
      (μ := unitSurfaceMeasure 2) hcont isCompact_univ)

/-- The all-real-time extension of the literal moving-fat dyadic circle
piece.  Restricted to `[1,2]`, it is definitionally the public unit-slab
output after the compact multiplier is unfolded. -/
private noncomputable def aux_circleRelativeBandFatUnitSlabDyadicOutputExtended
    (C : lpCutoffs 2) (j k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_relativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
      fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
      surfaceFourier 2 (-t • xi) *
      dyadicBandpassMultiplier C.cutoff k xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

/-- The literal product-rule derivative of the extended moving-fat circle
piece.  The circle derivative is held in its continuous integral form. -/
private noncomputable def
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative
    (C : lpCutoffs 2) (j k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (aux_relativeBandUnitDifferenceRawTimeDerivative C t (((2 : Real) ^ j)⁻¹ • xi) *
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
        surfaceFourier 2 (-t • xi) *
        dyadicBandpassMultiplier C.cutoff k xi +
      aux_relativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
        aux_circleSurfaceFourierTimeDerivative t xi *
        dyadicBandpassMultiplier C.cutoff k xi) *
      𝓕 (f : Euclidean 2 → Complex) xi) x

private theorem aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal
    (C : lpCutoffs 2) (j k : Nat)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x =
      circleRelativeBandFatUnitSlabDyadicOutput C j k t f x := by
  unfold aux_circleRelativeBandFatUnitSlabDyadicOutputExtended
    circleRelativeBandFatUnitSlabDyadicOutput
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext xi
  rw [← aux_relativeBandUnitDifferenceRaw_mul_fat_eq_family C t]

private theorem aux_l2_fourierInv_add_of_integrable
    (g h : Euclidean 2 → Complex) (hg : Integrable g) (hh : Integrable h)
    (x : Euclidean 2) :
    𝓕⁻ (g + h) x = 𝓕⁻ g x + 𝓕⁻ h x := by
  have hgchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • g xi) := by
    refine Integrable.mono' hg.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hg.aestronglyMeasurable
    · filter_upwards with xi
      simp
  have hhchar : Integrable
      (fun xi : Euclidean 2 => Real.fourierChar (inner Real xi x) • h xi) := by
    refine Integrable.mono' hh.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun xi : Euclidean 2 =>
        Real.fourierChar (inner Real xi x))).aestronglyMeasurable).smul
          hh.aestronglyMeasurable
    · filter_upwards with xi
      simp
  rw [Real.fourierInv_eq, Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ v : Euclidean 2,
      Real.fourierChar (inner Real v x) • (g v + h v)) = _
  rw [show (fun v : Euclidean 2 =>
      Real.fourierChar (inner Real v x) • (g v + h v)) =
        (fun v : Euclidean 2 =>
          Real.fourierChar (inner Real v x) • g v +
            Real.fourierChar (inner Real v x) • h v) by
      funext v
      rw [smul_add], MeasureTheory.integral_add hgchar hhchar]

private theorem
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative_eq_productRule
    (C : lpCutoffs 2) (j k : Nat)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x =
      relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitTimeDerivative C t)
        (dyadicFrequencyScale j) (aux_thinCircleSchwartzOutput C k t.1 f) x +
      relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j)
        (aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f) x := by
  let U : SchwartzMap (Euclidean 2) Complex :=
    aux_thinCircleSchwartzOutput C k t.1 f
  let V : SchwartzMap (Euclidean 2) Complex :=
    aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f
  let q1 : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (dyadicFrequencyScale j) : Euclidean 2 → Complex)
      (𝓕 U)
  let q2 : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j) : Euclidean 2 → Complex)
      (𝓕 V)
  have hq1apply (xi : Euclidean 2) : q1 xi =
      circleRelativeBandFatUnitTimeDerivative C t
          (((2 : Real) ^ j)⁻¹ • xi) *
        𝓕 (U : Euclidean 2 → Complex) xi := by
    dsimp [q1]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      relativeSchwartzMultiplierSymbol_apply]
    change circleRelativeBandFatUnitTimeDerivative C t
        (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (U : Euclidean 2 → Complex) xi = _
    rfl
  have hq2apply (xi : Euclidean 2) : q2 xi =
      circleRelativeBandFatUnitFamily C t
          (((2 : Real) ^ j)⁻¹ • xi) *
        𝓕 (V : Euclidean 2 → Complex) xi := by
    dsimp [q2]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      relativeSchwartzMultiplierSymbol_apply]
    change circleRelativeBandFatUnitFamily C t
        (((2 : Real) ^ j)⁻¹ • xi) *
      𝓕 (V : Euclidean 2 → Complex) xi = _
    rfl
  have hq1inv :
      relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t)
          (dyadicFrequencyScale j) U x = 𝓕⁻ (q1 : Euclidean 2 → Complex) x := by
    rw [relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    exact (hq1apply xi).symm
  have hq2inv :
      relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (dyadicFrequencyScale j) V x = 𝓕⁻ (q2 : Euclidean 2 → Complex) x := by
    rw [relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    exact (hq2apply xi).symm
  have hsum := aux_l2_fourierInv_add_of_integrable
    (q1 : Euclidean 2 → Complex) (q2 : Euclidean 2 → Complex)
    q1.integrable q2.integrable x
  have hpoint (xi : Euclidean 2) :
      q1 xi + q2 xi =
        (aux_relativeBandUnitDifferenceRawTimeDerivative C t.1
            (((2 : Real) ^ j)⁻¹ • xi) *
          fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
          surfaceFourier 2 (-t.1 • xi) *
          dyadicBandpassMultiplier C.cutoff k xi +
        aux_relativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleSurfaceFourierTimeDerivative t.1 xi *
          dyadicBandpassMultiplier C.cutoff k xi) *
          𝓕 (f : Euclidean 2 → Complex) xi := by
    rw [hq1apply, hq2apply,
      ← aux_relativeBandUnitDifferenceRawTimeDerivative_mul_fat_eq_family C t,
      ← aux_relativeBandUnitDifferenceRaw_mul_fat_eq_family C t,
      aux_thinCircleSchwartzOutput_fourier,
      aux_thinCircleSchwartzOutputTimeDerivative_fourier,
      aux_thinCircleSurfaceSymbol_apply,
      aux_thinCircleSurfaceDerivativeSymbol_apply,
      aux_dyadicBandpassSchwartz_eq_dyadicBandpassMultiplier,
      aux_circleSurfaceFourierTimeDerivative_eq_deriv]
    ring
  calc
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x =
        𝓕⁻ (fun xi : Euclidean 2 => q1 xi + q2 xi) x := by
      unfold aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative
      apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
      funext xi
      exact (hpoint xi).symm
    _ = 𝓕⁻ (q1 : Euclidean 2 → Complex) x +
        𝓕⁻ (q2 : Euclidean 2 → Complex) x := hsum
    _ = _ := by
      rw [← hq1inv, ← hq2inv]

set_option maxHeartbeats 800000 in
-- the elaboration of this long proof exceeds the default heartbeat limit
/-- Joint regularity for the literal extended dyadic circle piece.  The
frequency integral is confined to the ordinary `k`-annulus, so compact
parameter differentiation applies without an ambient-dimension endpoint. -/
private theorem aux_continuous_and_hasDerivAt_circleRelativeBandFatUnitSlabDyadicOutputExtended
    (C : lpCutoffs 2) (j k : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry
      (fun t x => aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x)) ∧
      Continuous (Function.uncurry
        (fun t x =>
          aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k s f x)
        (aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (k + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    Real.fourierChar (inner Real xi q.2) •
      (aux_relativeBandUnitDifferenceRaw C q.1 (((2 : Real) ^ j)⁻¹ • xi) *
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
        surfaceFourier 2 (-q.1 • xi) *
        dyadicBandpassMultiplier C.cutoff k xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    Real.fourierChar (inner Real xi q.2) •
      ((aux_relativeBandUnitDifferenceRawTimeDerivative C q.1
          (((2 : Real) ^ j)⁻¹ • xi) *
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
        surfaceFourier 2 (-q.1 • xi) *
        dyadicBandpassMultiplier C.cutoff k xi +
        aux_relativeBandUnitDifferenceRaw C q.1 (((2 : Real) ^ j)⁻¹ • xi) *
          fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleSurfaceFourierTimeDerivative q.1 xi *
          dyadicBandpassMultiplier C.cutoff k xi) *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      Real.fourierChar (inner Real q.2 q.1.2) •
        (aux_relativeBandUnitDifferenceRaw C q.1.1
            (((2 : Real) ^ j)⁻¹ • q.2) *
          fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • q.2) *
          surfaceFourier 2 (-q.1.1 • q.2) *
          dyadicBandpassMultiplier C.cutoff k q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        Real.fourierChar (inner Real q.2 q.1.2)) := by fun_prop
    have hraw := aux_continuous_uncurry_relativeBandUnitDifferenceRaw C
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_relativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (fatDyadicBandpassPrototype C.cutoff).continuous.comp hscaled
    have hsurface : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        surfaceFourier 2 (-q.1.1 • q.2)) :=
      (continuous_surfaceFourier 2).comp (by fun_prop)
    have hband : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        dyadicBandpassMultiplier C.cutoff k q.2) :=
      (dyadicBandpassMultiplier C.cutoff k).continuous.comp continuous_snd
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.smul ((((hraw'.mul hfat).mul hsurface).mul hband).mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      Real.fourierChar (inner Real q.2 q.1.2) •
        ((aux_relativeBandUnitDifferenceRawTimeDerivative C q.1.1
            (((2 : Real) ^ j)⁻¹ • q.2) *
          fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • q.2) *
          surfaceFourier 2 (-q.1.1 • q.2) *
          dyadicBandpassMultiplier C.cutoff k q.2 +
          aux_relativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2) *
            fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • q.2) *
            aux_circleSurfaceFourierTimeDerivative q.1.1 q.2 *
            dyadicBandpassMultiplier C.cutoff k q.2) *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        Real.fourierChar (inner Real q.2 q.1.2)) := by fun_prop
    have hraw := aux_continuous_uncurry_relativeBandUnitDifferenceRaw C
    have hrawdot := aux_continuous_uncurry_relativeBandUnitDifferenceRawTimeDerivative C
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_relativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hrawdot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_relativeBandUnitDifferenceRawTimeDerivative C q.1.1
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hrawdot.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        fatDyadicBandpassPrototype C.cutoff (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (fatDyadicBandpassPrototype C.cutoff).continuous.comp hscaled
    have hsurface : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        surfaceFourier 2 (-q.1.1 • q.2)) :=
      (continuous_surfaceFourier 2).comp (by fun_prop)
    have hsurfacePair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hsurfaceDot : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleSurfaceFourierTimeDerivative q.1.1 q.2) := by
      change Continuous ((Function.uncurry aux_circleSurfaceFourierTimeDerivative) ∘
        fun q : (Real × Euclidean 2) × Euclidean 2 => (q.1.1, q.2))
      exact aux_continuous_uncurry_circleSurfaceFourierTimeDerivative.comp hsurfacePair
    have hband : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        dyadicBandpassMultiplier C.cutoff k q.2) :=
      (dyadicBandpassMultiplier C.cutoff k).continuous.comp continuous_snd
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.smul
      (((((hrawdot'.mul hfat).mul hsurface).mul hband).add
        (((hraw'.mul hfat).mul hsurfaceDot).mul hband)).mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband : dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (k + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband : dyadicBandpassMultiplier C.cutoff k xi = 0 :=
      dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) : F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp [F, G, aux_circleRelativeBandFatUnitSlabDyadicOutputExtended]
      rw [Real.fourierInv_eq]
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) : D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp [D, G', aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative]
      rw [Real.fourierInv_eq]
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    let eta : Euclidean 2 := ((2 : Real) ^ j)⁻¹ • xi
    have hq :=
      Auto.Spherical.Auxiliary.hasDerivAt_smooth_dyadic_bandpass_radial
        C.cutoff 0 t eta
    have hqfat := hq.mul_const (fatDyadicBandpassPrototype C.cutoff eta)
    have hsurface : HasDerivAt (fun r : Real => surfaceFourier 2 (-r • xi))
        (aux_circleSurfaceFourierTimeDerivative t xi) t := by
      simpa [smul_neg, neg_smul, aux_circleSurfaceFourierTimeDerivative] using
        Auto.Spherical.Auxiliary.hasDerivAt_surfaceFourier_radial_at 2 (-xi) t
    have hproduct := hqfat.mul hsurface
    have hfull := hproduct.mul_const
      (dyadicBandpassMultiplier C.cutoff k xi * 𝓕 (f : Euclidean 2 → Complex) xi)
    have hchar := hfull.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa [G, G', eta, aux_relativeBandUnitDifferenceRaw,
      aux_relativeBandUnitDifferenceRawTimeDerivative,
      aux_circleSurfaceFourierTimeDerivative, Circle.smul_def, smul_eq_mul,
      mul_add, add_mul, mul_assoc] using hchar
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘ fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

/-- A literal Schwartz packaging of a fixed relative multiplier output. -/
private noncomputable def aux_relativeSchwartzMultiplierAtSchwartz
    (φ : SchwartzMap (Euclidean 2) Complex) (r : Ioi (0 : Real))
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (relativeSchwartzMultiplierSymbol φ r : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_relativeSchwartzMultiplierAtSchwartz_apply
    (φ : SchwartzMap (Euclidean 2) Complex) (r : Ioi (0 : Real))
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_relativeSchwartzMultiplierAtSchwartz φ r f x =
      relativeSchwartzMultiplierAt φ r f x := by
  unfold aux_relativeSchwartzMultiplierAtSchwartz
  rw [SchwartzMap.fourierInv_coe, relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
  apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (relativeSchwartzMultiplierSymbol φ r).hasTemperateGrowth]
  simp only [smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_integrable_norm_sq_relativeSchwartzMultiplierAt
    (φ : SchwartzMap (Euclidean 2) Complex) (r : Ioi (0 : Real))
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 => ‖relativeSchwartzMultiplierAt φ r f x‖ ^ 2)
      volume := by
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_relativeSchwartzMultiplierAtSchwartz φ r f
  have hP : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ 2) volume :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  refine hP.congr ?_
  filter_upwards with x
  rw [show P x = relativeSchwartzMultiplierAt φ r f x by
    exact aux_relativeSchwartzMultiplierAtSchwartz_apply φ r f x]

/-- On the physical unit slab, both the literal extended dyadic output and
its literal product-rule derivative have integrable squared spatial norm. -/
private theorem aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended
    (C : lpCutoffs 2) (j k : Nat)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun x : Euclidean 2 =>
      ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x‖ ^ 2) volume ∧
    Integrable (fun x : Euclidean 2 =>
      ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x‖ ^ 2)
      volume := by
  let H : SchwartzMap (Euclidean 2) Complex := aux_thinCircleSchwartzOutput C k t.1 f
  let HD : SchwartzMap (Euclidean 2) Complex :=
    aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f
  let Q : SchwartzMap (Euclidean 2) Complex :=
    aux_relativeSchwartzMultiplierAtSchwartz
      (circleRelativeBandFatUnitFamily C t)
      (dyadicFrequencyScale j) H
  let QD : SchwartzMap (Euclidean 2) Complex :=
    aux_relativeSchwartzMultiplierAtSchwartz
      (circleRelativeBandFatUnitTimeDerivative C t)
      (dyadicFrequencyScale j) H
  let R : SchwartzMap (Euclidean 2) Complex :=
    aux_relativeSchwartzMultiplierAtSchwartz
      (circleRelativeBandFatUnitFamily C t)
      (dyadicFrequencyScale j) HD
  have hQ : ∀ x : Euclidean 2,
      Q x = relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j) H x := by
    intro x
    simpa only [Q] using aux_relativeSchwartzMultiplierAtSchwartz_apply
      (circleRelativeBandFatUnitFamily C t)
      (dyadicFrequencyScale j) H x
  have hQD : ∀ x : Euclidean 2,
      QD x = relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitTimeDerivative C t)
        (dyadicFrequencyScale j) H x := by
    intro x
    simpa only [QD] using aux_relativeSchwartzMultiplierAtSchwartz_apply
      (circleRelativeBandFatUnitTimeDerivative C t)
      (dyadicFrequencyScale j) H x
  have hR : ∀ x : Euclidean 2,
      R x = relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (dyadicFrequencyScale j) HD x := by
    intro x
    simpa only [R] using aux_relativeSchwartzMultiplierAtSchwartz_apply
      (circleRelativeBandFatUnitFamily C t)
      (dyadicFrequencyScale j) HD x
  have hQint : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ 2) volume :=
    (Q.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hsumint : Integrable (fun x : Euclidean 2 => ‖(QD + R) x‖ ^ 2) volume :=
    ((QD + R).memLp 2 volume).integrable_norm_pow (by norm_num)
  constructor
  · refine hQint.congr ?_
    filter_upwards with x
    rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal C j k t f x,
      aux_circleRelativeBandFatUnitSlabDyadicOutput_eq_relativeMultiplierAt C j k t f x,
      hQ x]
  · refine hsumint.congr ?_
    filter_upwards with x
    rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative_eq_productRule
      C j k t f x]
    change ‖QD x + R x‖ ^ 2 = _
    rw [hQD x, hR x]

private theorem aux_norm_add_sq_le (u v : Complex) :
    ‖u + v‖ ^ 2 ≤ 2 * (‖u‖ ^ 2 + ‖v‖ ^ 2) := by
  calc
    ‖u + v‖ ^ 2 ≤ (‖u‖ + ‖v‖) ^ 2 :=
      pow_le_pow_left₀ (norm_nonneg _) (norm_add_le _ _) 2
    _ ≤ 2 * (‖u‖ ^ 2 + ‖v‖ ^ 2) := by
      nlinarith [sq_nonneg (‖u‖ - ‖v‖)]

/-- Fixed-time L² energy for the product-rule derivative.  The ordinary
circle scale `k`, not the unrelated relative scale `j`, carries the factor
`dyadicScale k`. -/
private theorem
    aux_exists_integral_norm_sq_circRelBandFatUnitSlabDyOutputExtendedTimeDeriv_le
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j k : Nat)
      (t : CircleRelativeBandLocalTime)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2,
        ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x‖ ^ 2) ≤
        B * dyadicScale k * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨Q₀, A₀, hQ₀, hA₀, hdot⟩ :=
    aux_exists_integral_norm_sq_relativeBandFatUnitTimeDerivative_thinCircle_le C
  obtain ⟨Q₁, A₁, hQ₁, hA₁, hcircleDot⟩ :=
    aux_exists_integral_norm_sq_relativeBandFatUnit_thinCircleTimeDerivative_le C
  let B : Real := 2 * (Q₀ * A₀ ^ 2 + Q₁ * A₁ ^ 2)
  have hB : 0 < B := by
    dsimp [B]
    positivity
  refine ⟨B, hB, ?_⟩
  intro j k t f
  let H : SchwartzMap (Euclidean 2) Complex := aux_thinCircleSchwartzOutput C k t.1 f
  let HD : SchwartzMap (Euclidean 2) Complex :=
    aux_thinCircleSchwartzOutputTimeDerivative C k t.1 f
  let U : Euclidean 2 → Complex := relativeSchwartzMultiplierAt
    (circleRelativeBandFatUnitTimeDerivative C t)
    (dyadicFrequencyScale j) H
  let V : Euclidean 2 → Complex := relativeSchwartzMultiplierAt
    (circleRelativeBandFatUnitFamily C t)
    (dyadicFrequencyScale j) HD
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  let R : Real := dyadicScale k
  have hE : 0 ≤ E := by
    dsimp [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hRpos : 0 < R := by
    dsimp [R]
    exact dyadicScale_pos k
  have hRone : 1 ≤ R := by
    dsimp [R]
    calc
      1 = dyadicScale 0 := by simp [dyadicScale]
      _ ≤ dyadicScale k := dyadicScale_mono (Nat.zero_le k)
  have hsqrtpos : 0 < Real.sqrt R := Real.sqrt_pos.mpr hRpos
  have hsqrtone : 1 ≤ Real.sqrt R := by
    rw [← Real.sqrt_one]
    exact Real.sqrt_le_sqrt hRone
  have hUintegrable : Integrable (fun x : Euclidean 2 => ‖U x‖ ^ 2) volume := by
    simpa only [U] using aux_integrable_norm_sq_relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t)
      (dyadicFrequencyScale j) H
  have hVintegrable : Integrable (fun x : Euclidean 2 => ‖V x‖ ^ 2) volume := by
    simpa only [V] using aux_integrable_norm_sq_relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t)
      (dyadicFrequencyScale j) HD
  have hUbound : (∫ x : Euclidean 2, ‖U x‖ ^ 2) ≤
      Q₀ * (A₀ / Real.sqrt R) ^ 2 * E := by
    simpa only [U, H, E, R] using hdot j k t f
  have hVbound : (∫ x : Euclidean 2, ‖V x‖ ^ 2) ≤
      Q₁ * (A₁ * Real.sqrt R) ^ 2 * E := by
    simpa only [V, HD, E, R] using hcircleDot j k t f
  have hratio : A₀ / Real.sqrt R ≤ A₀ := by
    rw [div_le_iff₀ hsqrtpos]
    exact le_mul_of_one_le_right hA₀.le hsqrtone
  have hratioSq : (A₀ / Real.sqrt R) ^ 2 ≤ A₀ ^ 2 := by
    simpa only [pow_two] using
      (mul_self_le_mul_self (div_nonneg hA₀.le hsqrtpos.le) hratio)
  have hUscale : (∫ x : Euclidean 2, ‖U x‖ ^ 2) ≤ Q₀ * A₀ ^ 2 * R * E := by
    calc
      (∫ x : Euclidean 2, ‖U x‖ ^ 2) ≤ Q₀ * (A₀ / Real.sqrt R) ^ 2 * E := hUbound
      _ ≤ Q₀ * A₀ ^ 2 * E := by
        calc
          Q₀ * (A₀ / Real.sqrt R) ^ 2 * E = Q₀ * ((A₀ / Real.sqrt R) ^ 2 * E) := by ring
          _ ≤ Q₀ * (A₀ ^ 2 * E) :=
            mul_le_mul_of_nonneg_left
              (mul_le_mul_of_nonneg_right hratioSq hE) hQ₀.le
          _ = Q₀ * A₀ ^ 2 * E := by ring
      _ ≤ Q₀ * A₀ ^ 2 * R * E := by
        calc
          Q₀ * A₀ ^ 2 * E = (Q₀ * A₀ ^ 2 * E) * 1 := by ring
          _ ≤ (Q₀ * A₀ ^ 2 * E) * R :=
            mul_le_mul_of_nonneg_left hRone (by positivity)
          _ = Q₀ * A₀ ^ 2 * R * E := by ring
  have hVscale : (∫ x : Euclidean 2, ‖V x‖ ^ 2) ≤ Q₁ * A₁ ^ 2 * R * E := by
    calc
      (∫ x : Euclidean 2, ‖V x‖ ^ 2) ≤ Q₁ * (A₁ * Real.sqrt R) ^ 2 * E := hVbound
      _ = Q₁ * A₁ ^ 2 * R * E := by
        rw [mul_pow, Real.sq_sqrt hRpos.le]
        ring
  have hDint :=
    aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f |>.2
  have hpoint (x : Euclidean 2) :
      ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x‖ ^ 2 ≤
        2 * (‖U x‖ ^ 2 + ‖V x‖ ^ 2) := by
    rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative_eq_productRule
      C j k t f x]
    exact aux_norm_add_sq_le _ _
  calc
    (∫ x : Euclidean 2,
        ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t.1 f x‖ ^ 2) ≤
        ∫ x : Euclidean 2, 2 * (‖U x‖ ^ 2 + ‖V x‖ ^ 2) :=
      integral_mono hDint ((hUintegrable.add hVintegrable).const_mul 2) hpoint
    _ = 2 * (∫ x : Euclidean 2, ‖U x‖ ^ 2) +
        2 * (∫ x : Euclidean 2, ‖V x‖ ^ 2) := by
          rw [MeasureTheory.integral_const_mul,
            MeasureTheory.integral_add hUintegrable hVintegrable]
          ring
    _ ≤ 2 * (Q₀ * A₀ ^ 2 * R * E) + 2 * (Q₁ * A₁ ^ 2 * R * E) :=
      add_le_add
        (mul_le_mul_of_nonneg_left hUscale (by norm_num))
        (mul_le_mul_of_nonneg_left hVscale (by norm_num))
    _ = B * R * E := by
      dsimp [B]
      ring

/-- The extended literal output and derivative satisfy the exact product-space
integrability hypotheses required by the L² time sampler. -/
private theorem aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended_prod
    (C : lpCutoffs 2) (j k : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) ∧
    Integrable (fun p : Real × Euclidean 2 =>
      ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k p.1 f p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  obtain ⟨Q, A, hQ, hA, hFbound⟩ :=
    aux_exists_integral_norm_sq_circleRelativeBandFatUnitSlabDyadicOutput_le C
  obtain ⟨B, hB, hDbound⟩ :=
    aux_exists_integral_norm_sq_circRelBandFatUnitSlabDyOutputExtendedTimeDeriv_le C
  let F : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  let R : Real := dyadicScale k
  have hjoint :=
    aux_continuous_and_hasDerivAt_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hFint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      Integrable (fun x : Euclidean 2 => ‖F t x‖ ^ 2) volume := by
    simpa only [F] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k ⟨t, ht⟩ f).1
  have hDint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      Integrable (fun x : Euclidean 2 => ‖D t x‖ ^ 2) volume := by
    simpa only [D] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k ⟨t, ht⟩ f).2
  have hFslice (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤ Q * (A / Real.sqrt R) ^ 2 * E := by
    calc
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) =
          ∫ x : Euclidean 2,
            ‖circleRelativeBandFatUnitSlabDyadicOutput
              C j k ⟨t, ht⟩ f x‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with x
            change ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x‖ ^ 2 = _
            rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal C j k ⟨t, ht⟩ f x]
      _ ≤ Q * (A / Real.sqrt R) ^ 2 * E := by
        simpa only [E, R] using hFbound j k ⟨t, ht⟩ f
  have hDslice (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B * R * E := by
    simpa only [D, E, R] using hDbound j k ⟨t, ht⟩ f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  letI : IsFiniteMeasure ν := by
    dsimp only [ν]
    infer_instance
  have hFmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖F p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hFcont.norm.pow 2).aestronglyMeasurable
  have hDmeas : AEStronglyMeasurable (fun p : Real × Euclidean 2 =>
      ‖D p.1 p.2‖ ^ 2) (ν.prod volume) :=
    (hDcont.norm.pow 2).aestronglyMeasurable
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      (ν.prod volume) := by
    refine (integrable_prod_iff hFmeas).2 ?_
    constructor
    · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      exact hFint t ht
    · have houterMeas : AEStronglyMeasurable (fun t : Real =>
          ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν :=
        ((hFcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
      have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ν := by
        apply Integrable.of_bound houterMeas (Q * (A / Real.sqrt R) ^ 2 * E)
        filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
        rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
        exact hFslice t ht
      simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      (ν.prod volume) := by
    refine (integrable_prod_iff hDmeas).2 ?_
    constructor
    · filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
      exact hDint t ht
    · have houterMeas : AEStronglyMeasurable (fun t : Real =>
          ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν :=
        ((hDcont.norm.pow 2).stronglyMeasurable.integral_prod_right').aestronglyMeasurable
      have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ν := by
        apply Integrable.of_bound houterMeas (B * R * E)
        filter_upwards [ae_restrict_mem measurableSet_Icc] with t ht
        rw [Real.norm_of_nonneg (integral_nonneg fun _ => sq_nonneg _)]
        exact hDslice t ht
      simpa only [Real.norm_of_nonneg (sq_nonneg _)] using houter
  simpa only [F, D, ν] using ⟨hFprod, hDprod⟩

/-- The literal moving relative-band output has the expected inverse ordinary-
frequency square energy on the unit time slab. -/
private theorem aux_exists_ivlInteg_integral_norm_sq_circRelBandFatUnitSlabDyOutputExtended_le
    (C : lpCutoffs 2) :
    ∃ Q A : Real, 0 < Q ∧ 0 < A ∧ ∀ (j k : Nat)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x‖ ^ 2) ≤
        Q * (A / Real.sqrt (dyadicScale k)) ^ 2 *
          ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨Q, A, hQ, hA, hfixed⟩ :=
    aux_exists_integral_norm_sq_circleRelativeBandFatUnitSlabDyadicOutput_le C
  refine ⟨Q, A, hQ, hA, ?_⟩
  intro j k f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended_prod C j k f).1
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
        Q * (A / Real.sqrt (dyadicScale k)) ^ 2 * E := by
    calc
      (∫ x : Euclidean 2, ‖F t x‖ ^ 2) =
          ∫ x : Euclidean 2,
            ‖circleRelativeBandFatUnitSlabDyadicOutput
              C j k ⟨t, ht⟩ f x‖ ^ 2 := by
            apply integral_congr_ae
            filter_upwards with x
            change ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x‖ ^ 2 = _
            rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal C j k ⟨t, ht⟩ f x]
      _ ≤ Q * (A / Real.sqrt (dyadicScale k)) ^ 2 * E := by
        simpa only [E] using hfixed j k ⟨t, ht⟩ f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
        ∫ _t in (1 : Real)..2,
          Q * (A / Real.sqrt (dyadicScale k)) ^ 2 * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const
          hpoint
    _ = Q * (A / Real.sqrt (dyadicScale k)) ^ 2 * E := by norm_num

/-- The literal time derivative has ordinary-frequency square energy on the
unit time slab, uniformly in the relative-band scale. -/
private theorem aux_exists_ivlInteg_integral_norm_sq_circRelBdFtUnitSlabDyOutExtendedTmDeriv_le
    (C : lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (j k : Nat)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x‖ ^ 2) ≤
        B * dyadicScale k * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by
  obtain ⟨B, hB, hfixed⟩ :=
    aux_exists_integral_norm_sq_circRelBandFatUnitSlabDyOutputExtendedTimeDeriv_le C
  refine ⟨B, hB, ?_⟩
  intro j k f
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  have hprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended_prod C j k f).2
  have houter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      (volume.restrict (Icc (1 : Real) 2)) :=
    hprod.integral_prod_left
  have hinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 2)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact houter
  have hpoint (t : Real) (ht : t ∈ Icc (1 : Real) 2) :
      (∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤ B * dyadicScale k * E := by
    simpa only [D, E] using hfixed j k ⟨t, ht⟩ f
  calc
    (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
        ∫ _t in (1 : Real)..2, B * dyadicScale k * E := by
      exact intervalIntegral.integral_mono_on (by norm_num) hinterval intervalIntegrable_const
          hpoint
    _ = B * dyadicScale k * E := by norm_num

private theorem aux_sq_div_sqrt (A R : Real) (hR : 0 < R) :
    (A / Real.sqrt R) ^ 2 = A ^ 2 / R := by
  rw [div_pow, Real.sq_sqrt hR.le]

/-- The time-sampling mesh at ordinary scale `k` cancels the two slab-energy
rates for the moving relative-band dyadic output. -/
private theorem aux_exists_meas_lintegral_iSup_circleRelBandFatUnitSlabDyOutputExtended_le
    (C : lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j k : Nat)
      (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal
            (‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal
              (‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x‖ ^ 2)) ≤
          ENNReal.ofReal (M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨Q, A, hQ, hA, hFbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circRelBandFatUnitSlabDyOutputExtended_le C
  obtain ⟨B, hB, hDbound⟩ :=
    aux_exists_ivlInteg_integral_norm_sq_circRelBdFtUnitSlabDyOutExtendedTmDeriv_le C
  let S : Real := Q * A ^ 2 + B
  let M : Real := 4 * (1 + S)
  have hS : 0 ≤ S := by
    dsimp only [S]
    exact add_nonneg (mul_nonneg hQ.le (sq_nonneg A)) hB.le
  have hM : 0 < M := by
    dsimp only [M]
    positivity
  refine ⟨M, hM, ?_⟩
  intro j k f
  let F : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatUnitSlabDyadicOutputExtendedTimeDerivative C j k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 2
  let R : Real := dyadicScale k
  have hE : 0 ≤ E := by
    dsimp only [E]
    exact integral_nonneg fun _ => sq_nonneg _
  have hR : 0 < R := by
    dsimp only [R]
    exact dyadicScale_pos k
  have hjoint :=
    aux_continuous_and_hasDerivAt_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    simpa only [F, D] using hjoint.2.2
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [F] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended_prod C j k f).1
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 2)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
    simpa only [D] using
      (aux_integrable_norm_sq_circleRelativeBandFatUnitSlabDyadicOutputExtended_prod C j k f).2
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated k
  obtain ⟨hmeas, hsampling⟩ :=
    measurable_and_lintegral_iSup_ennreal_norm_sq_le_timeSamplingL2
      (F := F) (F' := D) k T hT hFcont hDcont hderiv hFprod hDprod
  refine ⟨?_, hsampling.trans ?_⟩
  · simpa only [F] using hmeas
  · apply ENNReal.ofReal_le_ofReal
    have hF :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
          Q * (A / Real.sqrt R) ^ 2 * E := by
      simpa only [F, R, E] using hFbound j k f
    have hF' :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
          (Q * A ^ 2 / R) * E := by
      calc
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) ≤
            Q * (A / Real.sqrt R) ^ 2 * E := hF
        _ = (Q * A ^ 2 / R) * E := by
          rw [aux_sq_div_sqrt A R hR]
          ring
    have hD :
        (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          B * R * E := by
      simpa only [D, R, E] using hDbound j k f
    let δ : Real := Auto.Spherical.MSS.dyadicTimeScale k
    have hδ : δ = R⁻¹ := by
      dsimp only [δ, R]
      simp [Auto.Spherical.MSS.dyadicTimeScale, dyadicScale, zpow_neg]
    have hδnonneg : 0 ≤ δ := by
      rw [hδ]
      exact inv_nonneg.mpr hR.le
    have hδinvnonneg : 0 ≤ δ⁻¹ := inv_nonneg.mpr hδnonneg
    have hsamplebound :
        8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
          6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) ≤
          8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) := by
      apply add_le_add
      · have h := mul_le_mul_of_nonneg_left hF'
          (mul_nonneg (by norm_num : (0 : Real) ≤ 8) hδinvnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
      · have h := mul_le_mul_of_nonneg_left hD
          (mul_nonneg (by norm_num : (0 : Real) ≤ 6) hδnonneg)
        simpa only [mul_assoc, mul_left_comm, mul_comm] using h
    have hformula :
        8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) =
          (8 * Q * A ^ 2 + 6 * B) * E := by
      rw [hδ]
      field_simp [hR.ne']
    have hlinear : 8 * Q * A ^ 2 + 6 * B ≤ 8 * S := by
      dsimp only [S]
      nlinarith
    have hSbound : 8 * S ≤ M ^ 2 := by
      dsimp only [M]
      nlinarith [sq_nonneg S]
    have hcoeff : 8 * Q * A ^ 2 + 6 * B ≤ M ^ 2 :=
      hlinear.trans hSbound
    have hfinal : (8 * Q * A ^ 2 + 6 * B) * E ≤ M ^ 2 * E := by
      exact mul_le_mul_of_nonneg_right hcoeff hE
    calc
      8 * (Auto.Spherical.MSS.dyadicTimeScale k)⁻¹ *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
        6 * Auto.Spherical.MSS.dyadicTimeScale k *
          (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) =
          8 * δ⁻¹ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 2) +
            6 * δ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 2) := by rfl
      _ ≤ 8 * δ⁻¹ * ((Q * A ^ 2 / R) * E) + 6 * δ * (B * R * E) :=
        hsamplebound
      _ = (8 * Q * A ^ 2 + 6 * B) * E := hformula
      _ ≤ M ^ 2 * E := hfinal
      _ = M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2 := by rfl

/-- A finite five-term `ENNReal` square estimate that remains valid at `∞`.
This avoids converting raw maximal functions to real-valued representatives
before the unit-slab fourth-moment-style bookkeeping. -/
private theorem aux_l2_sum_range_five_sq_le (u : Nat → ENNReal) :
    (∑ i ∈ Finset.range 5, u i) ^ 2 ≤
      25 * ∑ i ∈ Finset.range 5, (u i) ^ 2 := by
  let S : Finset ENNReal := (Finset.range 5).image u
  have hS : S.Nonempty := by
    refine ⟨u 0, ?_⟩
    exact Finset.mem_image.mpr ⟨0, Finset.mem_range.mpr (by norm_num), rfl⟩
  let m : ENNReal := S.max' hS
  have hterm (i : Nat) (hi : i ∈ Finset.range 5) : u i ≤ m := by
    exact Finset.le_max' S (u i) (Finset.mem_image.mpr ⟨i, hi, rfl⟩)
  have hsum : (∑ i ∈ Finset.range 5, u i) ≤ (Finset.range 5).card • m :=
    Finset.sum_le_card_nsmul (Finset.range 5) u m hterm
  have hsum' : (∑ i ∈ Finset.range 5, u i) ≤ 5 • m := by
    simpa using hsum
  have hsq : (∑ i ∈ Finset.range 5, u i) ^ 2 ≤ (5 • m) ^ 2 :=
    pow_le_pow_left₀ bot_le hsum' 2
  obtain ⟨i, hi, him⟩ := Finset.mem_image.mp (Finset.max'_mem S hS)
  have hm : m = u i := by
    exact him.symm
  have hmi : m ^ 2 ≤ ∑ i ∈ Finset.range 5, (u i) ^ 2 := by
    rw [hm]
    exact Finset.single_le_sum (f := fun i => (u i) ^ 2)
      (fun _ _ => by positivity) hi
  calc
    (∑ i ∈ Finset.range 5, u i) ^ 2 ≤ (5 • m) ^ 2 := hsq
    _ = 25 * m ^ 2 := by rw [nsmul_eq_mul]; ring
    _ ≤ 25 * ∑ i ∈ Finset.range 5, (u i) ^ 2 :=
      mul_le_mul_of_nonneg_left hmi (by norm_num)

/-- The sampler bound in raw form for one literal ordinary dyadic piece. -/
private theorem aux_exists_measurable_lintegral_iSup_circleRelativeBandFatUnitSlabDyadicOutput_le
    (C : lpCutoffs 2) :
    ∃ M : Real, 0 < M ∧ ∀ (j k : Nat)
      (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2)) ∧
        (∫⁻ x : Euclidean 2,
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal
              (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2)) ≤
          ENNReal.ofReal (M ^ 2 * ∫ x : Euclidean 2, ‖f x‖ ^ 2) := by
  obtain ⟨M, hM, hbound⟩ :=
    aux_exists_meas_lintegral_iSup_circleRelBandFatUnitSlabDyOutputExtended_le C
  refine ⟨M, hM, ?_⟩
  intro j k f
  obtain ⟨hmeas, hmoment⟩ := hbound j k f
  have hfun :
      (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ENNReal.ofReal
            (‖aux_circleRelativeBandFatUnitSlabDyadicOutputExtended C j k t.1 f x‖ ^ 2)) =
        fun x : Euclidean 2 =>
          ⨆ t : Icc (1 : Real) 2,
            ENNReal.ofReal
              (‖circleRelativeBandFatUnitSlabDyadicOutput C j k t f x‖ ^ 2) := by
    funext x
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabDyadicOutputExtended_eq_literal C j k t f x]
  rw [hfun] at hmeas hmoment
  exact ⟨hmeas, hmoment⟩

/- The exact five-piece identity is converted at the level of the literal
raw `ENNReal` maximal function.  This keeps the later local hypothesis in
the same form as the all-radius reassembly theorem. -/
private theorem aux_circleRelativeBandFatUnitSlabMaximal_sq_le_sum_five_dyadic_sq
    (C : lpCutoffs 2) (j : Nat) (hj : 2 ≤ j)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (circleRelativeBandFatUnitSlabMaximal C j f x) ^ 2 ≤
      25 * ∑ i ∈ Finset.range 5,
        (⨆ t : CircleRelativeBandLocalTime,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ^ 2)) := by
  classical
  letI : Nonempty CircleRelativeBandLocalTime :=
    ⟨⟨1, by norm_num⟩⟩
  let U : Nat → ENNReal := fun i =>
    ⨆ t : CircleRelativeBandLocalTime,
      ENNReal.ofReal
        ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖
  have hmax : circleRelativeBandFatUnitSlabMaximal C j f x ≤
      ∑ i ∈ Finset.range 5, U i := by
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_le
    intro t
    rw [circleRelativeBandFatUnitSlabOutput_eq_sum_five_dyadic C j hj t f x]
    calc
      ENNReal.ofReal
          ‖∑ i ∈ Finset.range 5,
            circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ≤
          ENNReal.ofReal (∑ i ∈ Finset.range 5,
            ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖) :=
        ENNReal.ofReal_le_ofReal (norm_sum_le _ _)
      _ = ∑ i ∈ Finset.range 5,
          ENNReal.ofReal
            ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ := by
          rw [ENNReal.ofReal_sum_of_nonneg]
          intro i hi
          exact norm_nonneg _
      _ ≤ ∑ i ∈ Finset.range 5, U i := by
          apply Finset.sum_le_sum
          intro i hi
          exact le_iSup (fun s : CircleRelativeBandLocalTime =>
            ENNReal.ofReal
              ‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) s f x‖) t
  calc
    (circleRelativeBandFatUnitSlabMaximal C j f x) ^ 2 ≤
        (∑ i ∈ Finset.range 5, U i) ^ 2 :=
      pow_le_pow_left' hmax 2
    _ ≤ 25 * ∑ i ∈ Finset.range 5, (U i) ^ 2 :=
      aux_l2_sum_range_five_sq_le U
    _ = 25 * ∑ i ∈ Finset.range 5,
        (⨆ t : CircleRelativeBandLocalTime,
          ENNReal.ofReal
            (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t f x‖ ^ 2)) := by
      apply congrArg (fun z : ENNReal => 25 * z)
      apply Finset.sum_congr rfl
      intro i hi
      dsimp [U]
      rw [ENNReal.iSup_pow]
      apply iSup_congr
      intro t
      rw [ENNReal.ofReal_pow (norm_nonneg _)]

private theorem aux_lintegral_circleRelativeBandFatInputProjection_sq_eq
    (C : lpCutoffs 2) (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
      (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  have hPint : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ (2 : Nat)) volume :=
    (P.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hPnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖P x‖ ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hlin : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (2 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) :=
    (ofReal_integral_eq_lintegral_ofReal hPint hPnonneg).symm
  calc
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) =
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (2 : Nat)) := by
          apply lintegral_congr
          intro x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
    _ = ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) := hlin
    _ = ENNReal.ofReal (∫ x : Euclidean 2,
        ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
          congr 1
          apply integral_congr_ae
          filter_upwards with x
          rw [show P x = circleRelativeBandFatInputProjection C j f x by
            exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]

/- The high relative scales are reassembled directly from the five literal
ordinary dyadic maxima.  The constant is uniform in the relative scale. -/
private theorem aux_exists_high_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : ENNReal, A ≠ ∞ ∧ ∀ (j : Nat), 2 ≤ j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  obtain ⟨M, hM, hdyadic⟩ :=
    aux_exists_measurable_lintegral_iSup_circleRelativeBandFatUnitSlabDyadicOutput_le C
  let A : ENNReal := ENNReal.ofReal (125 * M ^ (2 : Nat))
  have hAtop : A ≠ ∞ := by
    dsimp [A]
    exact ENNReal.ofReal_ne_top
  refine ⟨A, hAtop, ?_⟩
  intro j hj f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  let E : Real := ∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)
  let B : ENNReal := ENNReal.ofReal (M ^ (2 : Nat) * E)
  let Q : Nat → Euclidean 2 → ENNReal := fun i x =>
    ⨆ t : CircleRelativeBandLocalTime,
      ENNReal.ofReal
        (‖circleRelativeBandFatUnitSlabDyadicOutput C j (j - 2 + i) t P x‖ ^ 2)
  have hQ (i : Nat) : Measurable (Q i) ∧ (∫⁻ x : Euclidean 2, Q i x) ≤ B := by
    simpa only [Q, B, E] using hdyadic j (j - 2 + i) P
  have hsummeas : Measurable (fun x : Euclidean 2 =>
      ∑ i ∈ Finset.range 5, Q i x) :=
    Finset.measurable_sum _ (fun i hi => (hQ i).1)
  have hpieces : (∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x) ≤
      5 * B := by
    calc
      (∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x) ≤
          ∑ i ∈ Finset.range 5, B := by
            apply Finset.sum_le_sum
            intro i hi
            exact (hQ i).2
      _ = 5 * B := by norm_num
  have hmaxeq (x : Euclidean 2) :
      circleRelativeBandFatUnitSlabMaximal C j f x =
        circleRelativeBandFatUnitSlabMaximal C j P x := by
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C j t f x]
  have hmomentP :
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := by
    calc
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat)) ≤
          ∫⁻ x : Euclidean 2, 25 * ∑ i ∈ Finset.range 5, Q i x :=
        lintegral_mono fun x =>
          aux_circleRelativeBandFatUnitSlabMaximal_sq_le_sum_five_dyadic_sq
            C j hj P x
      _ = 25 * ∫⁻ x : Euclidean 2, ∑ i ∈ Finset.range 5, Q i x := by
        rw [lintegral_const_mul _ hsummeas]
      _ = 25 * ∑ i ∈ Finset.range 5, ∫⁻ x : Euclidean 2, Q i x := by
        rw [MeasureTheory.lintegral_finsetSum (Finset.range 5)
          (fun i hi => (hQ i).1)]
      _ ≤ 25 * (5 * B) :=
        mul_le_mul_of_nonneg_left hpieces (by norm_num)
      _ = ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := by
        dsimp only [B]
        rw [ENNReal.ofReal_mul (sq_nonneg M),
          ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 125)]
        norm_num
        ring
  have hEeq : E = ∫ x : Euclidean 2,
      ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat) := by
    dsimp only [E]
    apply integral_congr_ae
    filter_upwards with x
    rw [show P x = circleRelativeBandFatInputProjection C j f x by
      exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
  let J : ENNReal := ∫⁻ x : Euclidean 2, ENNReal.ofReal
    (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))
  have hJ : J = ENNReal.ofReal E := by
    dsimp only [J]
    rw [aux_lintegral_circleRelativeBandFatInputProjection_sq_eq C j f, ← hEeq]
  have hJtop : J ≠ ∞ := by
    rw [hJ]
    exact ENNReal.ofReal_ne_top
  have hrighttop : A * J ≠ ∞ := ENNReal.mul_ne_top hAtop hJtop
  have hbound :
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J := by
    calc
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) =
          ∫⁻ x : Euclidean 2,
            (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (2 : Nat) := by
              apply lintegral_congr
              intro x
              rw [hmaxeq x]
      _ ≤ ENNReal.ofReal (125 * M ^ (2 : Nat)) * ENNReal.ofReal E := hmomentP
      _ = A * J := by
        dsimp only [A]
        rw [hJ]
  refine ⟨?_, ne_top_of_le_ne_top hrighttop hbound, ?_⟩
  · rw [show circleRelativeBandFatUnitSlabMaximal C j f =
        circleRelativeBandFatUnitSlabMaximal C j P by
          funext x
          exact hmaxeq x]
    exact aux_measurable_circleRelativeBandFatUnitSlabMaximal_of_two_le C j hj P
  · simpa only [J] using hbound

/- The low compact-annular family needs a raw `ENNReal` version of the
standard multiplier estimate, since the literal local maximal function is
not its `toReal` presentation. -/
private theorem aux_raw_annular_two_of_kernel_bound
    {ι : Type*}
    (φ : ι → SchwartzMap (Euclidean 2) Complex)
    (r : ι → Set.Ioi (0 : Real))
    {A : Real} (hA : 0 ≤ A)
    (hφ : ∀ u, _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
      (φ u) ≤ A) :
    ∃ D : Real, 0 < D ∧ ∀ f : SchwartzMap (Euclidean 2) Complex,
      Measurable (fun x =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x) ∧
      (∫⁻ x, (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
        φ r f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (2 : Nat)) := by
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      φ hA hφ
  obtain ⟨D, hD, hstrong⟩ :=
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier_strong_type_of_kernel_bound
      (d := 2) (by norm_num) (p := 2) (by norm_num) φ r hA hφ
  refine ⟨D, hD, ?_⟩
  intro f
  let R : Euclidean 2 → ENNReal := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw φ r f x
  let H : Euclidean 2 → Real := fun x =>
    _root_.Auto.MikhlinHormander.annularSchwartzMultiplier φ r f x
  have hRle (x : Euclidean 2) :
      R x ≤ ENNReal.ofReal (K *
        _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
          (f : Euclidean 2 → Complex) x) := by
    dsimp [R, _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw]
    apply iSup_le
    intro u
    exact ENNReal.ofReal_le_ofReal (hterm u f (r u) x)
  have hRfinite (x : Euclidean 2) : R x ≠ ⊤ :=
    ne_top_of_le_ne_top ENNReal.ofReal_ne_top (hRle x)
  have hReq (x : Euclidean 2) : R x = ENNReal.ofReal (H x) := by
    dsimp [R, H, _root_.Auto.MikhlinHormander.annularSchwartzMultiplier]
    exact (ENNReal.ofReal_toReal (hRfinite x)).symm
  have hHmeas : Measurable H := by
    dsimp [H]
    apply ENNReal.measurable_toReal.comp
    apply LowerSemicontinuous.measurable
    apply lowerSemicontinuous_iSup
    intro u
    exact (ENNReal.continuous_ofReal.comp
      (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
        (φ u) f (r u)).norm).lowerSemicontinuous
  have hRmeas : Measurable R := by
    rw [show R = fun x => ENNReal.ofReal (H x) by
      funext x
      exact hReq x]
    exact hHmeas.ennreal_ofReal
  have hHmem : MemLp H 2 volume := by
    convert (hstrong f).1 using 1; norm_num [H]
  have hHbound' : (∫ x, H x ^ (2 : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (2 : Real) := by
    simpa only [H] using (hstrong f).2
  change (∫ x, H x ^ (↑(2 : Nat) : Real)) ≤
      D * ∫ x, ‖f x‖ ^ (↑(2 : Nat) : Real) at hHbound'
  have hHbound : (∫ x, H x ^ (2 : Nat)) ≤
      D * ∫ x, ‖f x‖ ^ (2 : Nat) := by
    simpa only [Real.rpow_natCast] using hHbound'
  have hHint : Integrable (fun x => H x ^ (2 : Nat)) volume := by
    rw [show (fun x => H x ^ (2 : Nat)) = fun x => ‖H x‖ ^ (2 : Nat) by
      funext x
      rw [Real.norm_eq_abs, abs_of_nonneg
        (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
          φ r f x)]]
    exact hHmem.integrable_norm_pow (by norm_num)
  have hHnonneg : ∀ᵐ x ∂volume, 0 ≤ H x ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun x => pow_nonneg
      (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg φ r f x) _
  refine ⟨?_, ?_⟩
  · simpa only [R] using hRmeas
  · calc
      (∫⁻ x, (R x) ^ (2 : Nat)) =
          ∫⁻ x, ENNReal.ofReal (H x ^ (2 : Nat)) := by
            apply lintegral_congr
            intro x
            rw [hReq x,
              ← ENNReal.ofReal_pow
                (_root_.Auto.MikhlinHormander.annularSchwartzMultiplier_nonneg
                  φ r f x)]
      _ = ENNReal.ofReal (∫ x, H x ^ (2 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hHint hHnonneg).symm
      _ ≤ ENNReal.ofReal (D * ∫ x, ‖f x‖ ^ (2 : Nat)) :=
        ENNReal.ofReal_le_ofReal hHbound

/- The finite compact family of low relative scales has a uniform raw
second-moment bound. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_second_moment_unprojected
    (C : lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) := by
  obtain ⟨B, hB, hkernel⟩ :=
    aux_exists_relativeSchwartzMultiplierKernelSize_circleRelativeBandFatLowSymbol_le C
  choose D hDpos hD using fun a : Fin 3 =>
    aux_raw_annular_two_of_kernel_bound
      (fun t : CircleRelativeBandLocalTime => aux_circleRelativeBandFatLowSymbol C a.1 t)
      (fun _ : CircleRelativeBandLocalTime =>
        _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1)
      hB (fun t => hkernel a t)
  let A : Real := ∑ a : Fin 3, D a
  have hApos : 0 < A := by
    apply lt_of_lt_of_le (hDpos ⟨0, by norm_num⟩)
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ _)
  refine ⟨A, hApos, ?_⟩
  intro a f
  have hrawfun : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      fun x : Euclidean 2 =>
        _root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
          (fun t : CircleRelativeBandLocalTime =>
            aux_circleRelativeBandFatLowSymbol C a.1 t)
          (fun _ : CircleRelativeBandLocalTime =>
            _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x := by
    funext x
    exact aux_circleRelativeBandFatUnitSlabMaximal_eq_lowSymbolRaw C a f x
  have hDle : D a ≤ A := by
    dsimp [A]
    exact Finset.single_le_sum (fun b _ => (hDpos b).le) (Finset.mem_univ a)
  have hInonneg : 0 ≤ ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat) := by
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  refine ⟨?_, ?_⟩
  · rw [hrawfun]
    exact (hD a f).1
  · rw [hrawfun]
    calc
      (∫⁻ x : Euclidean 2,
          (_root_.Auto.MikhlinHormander.annularSchwartzMultiplierRaw
            (fun t : CircleRelativeBandLocalTime =>
              aux_circleRelativeBandFatLowSymbol C a.1 t)
            (fun _ : CircleRelativeBandLocalTime =>
              _root_.Auto.MikhlinHormander.dyadicFrequencyScale a.1) f x) ^
              (2 : Nat)) ≤
          ENNReal.ofReal (D a * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
        (hD a f).2
      _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
        ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right hDle hInonneg)

/- The same low-scale bound with the exact physical fat projection on its
right-hand side. -/
private theorem aux_exists_low_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : Real, 0 < A ∧ ∀ (a : Fin 3) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C a.1 f) ∧
      (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C a.1 f x) ^ (2 : Nat)) ≤
        ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (2 : Nat)) := by
  obtain ⟨A, hA, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_second_moment_unprojected C
  refine ⟨A, hA, ?_⟩
  intro a f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C a.1 f
  have hmaxeq : circleRelativeBandFatUnitSlabMaximal C a.1 f =
      circleRelativeBandFatUnitSlabMaximal C a.1 P := by
    funext x
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C a.1 t f x]
  obtain ⟨hmeas, hmoment⟩ := hlow a P
  refine ⟨?_, ?_⟩
  · rw [hmaxeq]
    exact hmeas
  · rw [hmaxeq]
    calc
      (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C a.1 P x) ^ (2 : Nat)) ≤
          ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖P x‖ ^ (2 : Nat)) := hmoment
      _ = ENNReal.ofReal (A * ∫ x : Euclidean 2,
          ‖circleRelativeBandFatInputProjection C a.1 f x‖ ^ (2 : Nat)) := by
        congr 2
        apply integral_congr_ae
        filter_upwards with x
        rw [show P x = circleRelativeBandFatInputProjection C a.1 f x by
          exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C a.1 f x]

/- Combine the high five-dyadic sampler with the finite compact low family
in the exact local hypothesis consumed by the all-radius `L²` reassembly. -/
private theorem aux_exists_circleRelativeBandFatUnitSlab_second_moment
    (C : lpCutoffs 2) :
    ∃ A : ENNReal, A ≠ ∞ ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)) := by
  obtain ⟨Ah, hAhtop, hhigh⟩ :=
    aux_exists_high_circleRelativeBandFatUnitSlab_second_moment C
  obtain ⟨Al, hAl, hlow⟩ :=
    aux_exists_low_circleRelativeBandFatUnitSlab_second_moment C
  let A : ENNReal := Ah + ENNReal.ofReal Al
  have hAtop : A ≠ ∞ := by
    dsimp [A]
    exact ENNReal.add_ne_top.mpr ⟨hAhtop, ENNReal.ofReal_ne_top⟩
  have hAhle : Ah ≤ A := by
    dsimp [A]
    exact le_add_of_nonneg_right bot_le
  have hAlle : ENNReal.ofReal Al ≤ A := by
    dsimp [A]
    exact le_add_of_nonneg_left bot_le
  refine ⟨A, hAtop, ?_⟩
  intro j f
  let I : Real := ∫ x : Euclidean 2,
    ‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat)
  let J : ENNReal := ∫⁻ x : Euclidean 2, ENNReal.ofReal
    (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))
  have hJ : J = ENNReal.ofReal I := by
    dsimp only [I, J]
    exact aux_lintegral_circleRelativeBandFatInputProjection_sq_eq C j f
  have hJtop : J ≠ ∞ := by
    rw [hJ]
    exact ENNReal.ofReal_ne_top
  have hrighttop : A * J ≠ ∞ := ENNReal.mul_ne_top hAtop hJtop
  by_cases hj : 2 ≤ j
  · obtain ⟨hmeas, hfinite, hmoment⟩ := hhigh j hj f
    have hbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J := by
      calc
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ Ah * J := by
          simpa only [J] using hmoment
        _ ≤ A * J := mul_le_mul_of_nonneg_right hAhle bot_le
    exact ⟨hmeas, ne_top_of_le_ne_top hrighttop hbound, by simpa only [J] using hbound⟩
  · have hjlt : j < 2 := Nat.lt_of_not_ge hj
    let a : Fin 3 := ⟨j, lt_trans hjlt (by norm_num : 2 < 3)⟩
    obtain ⟨hmeas, hmoment⟩ := hlow a f
    have hI : 0 ≤ I := by
      dsimp only [I]
      exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
    have hlowbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          ENNReal.ofReal Al * J := by
      have hraw := hmoment
      have hraw' :
          (∫⁻ x : Euclidean 2,
            (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
            ENNReal.ofReal (Al * I) := by
        simpa only [a, I] using hraw
      calc
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
            ENNReal.ofReal (Al * I) := hraw'
        _ = ENNReal.ofReal Al * J := by
          rw [hJ, ENNReal.ofReal_mul hAl.le]
    have hbound :
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤ A * J :=
      hlowbound.trans (mul_le_mul_of_nonneg_right hAlle bot_le)
    refine ⟨?_, ne_top_of_le_ne_top hrighttop hbound, ?_⟩
    · simpa only [a] using hmeas
    · simpa only [J] using hbound

/-- The literal moving-fat relative circular maximal function is uniformly
bounded at planar `L²` over all positive radii.  The constant is independent
of the relative dyadic scale. -/
theorem exists_memLp_two_and_eLpNorm_restrictedRelativeBandpassSphericalMaximal
    (C : lpCutoffs 2) :
    ∃ L : Real, 0 < L ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ≤
          ENNReal.ofReal L *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
  obtain ⟨A, hAtop, hlocal⟩ := aux_exists_circleRelativeBandFatUnitSlab_second_moment C
  exact exists_memLp_two_and_eLpNorm_restrictedRelBpSphMax_of_circleRelBandFatUnitSlab
    C ⟨A, hAtop, hlocal⟩


