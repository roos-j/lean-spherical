private theorem aux_l2_exists_memLp_two_and_eLpNorm_restrictedRelativeBandpass_of_unitFat
    (C : lpCutoffs 2) (A : ENNReal) (hAtop : A ≠ ∞)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (2 : Nat))) :
    ∃ bandConst : ENNReal, bandConst ≠ ∞ ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ≤
          bandConst * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
  rcases aux_l2_exists_lintegral_sum_shiftedFatInputProjection_sq_le C with
    ⟨B, hBtop, hLP⟩
  let bandConst : ENNReal := (A * B) ^ ((2 : Real)⁻¹)
  refine ⟨bandConst, ?_, ?_⟩
  · exact ENNReal.rpow_ne_top_of_nonneg (by positivity)
      (ENNReal.mul_ne_top hAtop hBtop)
  · intro j f
    let M : Euclidean 2 → ENNReal :=
      restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f
    have hfint : Integrable (fun x : Euclidean 2 => ‖f x‖ ^ (2 : Nat)) volume :=
      (f.memLp 2 volume).integrable_norm_pow (by norm_num)
    have hfMem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume :=
      f.memLp _ volume
    have hf_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖f x‖ ^ (2 : Nat) :=
      Filter.Eventually.of_forall fun x => pow_nonneg (norm_nonneg _) _
    have hIfin :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat))) ≠ ∞ := by
      have hI : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat))) =
          ENNReal.ofReal (∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hfint hf_nonneg).symm
      rw [hI]
      exact ENNReal.ofReal_ne_top
    have hAout_top : A * B ≠ ∞ := ENNReal.mul_ne_top hAtop hBtop
    have hmoment :
        (∫⁻ x : Euclidean 2, M x ^ (2 : Real)) ≤
          A * B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
      simpa only [M] using
        aux_l2_lintegral_restrictedRelativeBandpass_all_radius_sq_le
          C A B hunit hLP j f
    have hmoment_fin : (∫⁻ x : Euclidean 2, M x ^ (2 : Real)) ≠ ∞ :=
      ne_top_of_le_ne_top
        (ENNReal.mul_ne_top hAout_top hIfin) hmoment
    have hMmeas : Measurable M := by
      dsimp only [M]
      exact Auto.Spherical.PowerWeights.measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j
    have hMpowmeas : Measurable (fun x : Euclidean 2 => M x ^ (2 : Real)) := by
      convert hMmeas.pow_const 2 using 1; norm_num [ENNReal.rpow_natCast]
    have hMfinite : ∀ᵐ x : Euclidean 2 ∂volume, M x ≠ ∞ := by
      filter_upwards [ae_lt_top hMpowmeas hmoment_fin] with x hx
      intro htop
      rw [htop, ENNReal.top_rpow_of_pos (by norm_num : (0 : Real) < 2)] at hx
      exact lt_irrefl _ hx
    have htoRealMoment :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal ((M x).toReal ^ (2 : Real))) =
          ∫⁻ x : Euclidean 2, M x ^ (2 : Real) := by
      apply lintegral_congr_ae
      filter_upwards [hMfinite] with x hx
      calc
        ENNReal.ofReal ((M x).toReal ^ (2 : Real)) =
            ENNReal.ofReal ((M x).toReal ^ (2 : Nat)) := by
              norm_num [Real.rpow_natCast]
        _ = (ENNReal.ofReal ((M x).toReal)) ^ (2 : Nat) := by
              rw [ENNReal.ofReal_pow
                (ENNReal.toReal_nonneg : 0 ≤ (M x).toReal) 2]
        _ = (M x) ^ (2 : Nat) := by rw [ENNReal.ofReal_toReal hx]
        _ = (M x) ^ (2 : Real) := by
              norm_num [ENNReal.rpow_natCast]
    have hinputMoment :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat))) =
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ (2 : Real) := by
      apply lintegral_congr
      intro x
      rw [ENNReal.ofReal_pow (norm_nonneg _) 2]
      norm_num [ENNReal.rpow_natCast]
    have hconvert :=
      memLp_and_eLpNorm_ennreal_of_toReal_lintegral_rpow_le_of_input_measure
          volume volume M hMmeas.aemeasurable hMfinite (by norm_num : (0 : Real) < 2)
          hAout_top (f : Euclidean 2 → Complex) hfMem (by
            calc
              (∫⁻ x : Euclidean 2, ENNReal.ofReal ((M x).toReal ^ (2 : Real))) =
                  ∫⁻ x : Euclidean 2, M x ^ (2 : Real) := htoRealMoment
              _ ≤ A * B * ∫⁻ x : Euclidean 2,
                  ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := hmoment
              _ = A * B * ∫⁻ x : Euclidean 2,
                  (ENNReal.ofReal ‖f x‖) ^ (2 : Real) := by
                    rw [hinputMoment])
    constructor
    · simpa only [M] using hconvert.1
    · calc
        eLpNorm M (ENNReal.ofReal (2 : Real)) volume ≤
            (A * B) ^ ((2 : Real)⁻¹) *
              eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume :=
          hconvert.2
        _ = bandConst *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
              rfl

private theorem aux_l2_exists_memLp_two_and_eLpNorm_restrRelBp_of_circleRelBandFatUnitSlab
    (C : lpCutoffs 2) (A : ENNReal) (hAtop : A ≠ ∞)
    (hunit : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) :
    ∃ bandConst : ENNReal, bandConst ≠ ∞ ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ≤
          bandConst * eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
  apply aux_l2_exists_memLp_two_and_eLpNorm_restrictedRelativeBandpass_of_unitFat
    C A hAtop
  intro j g
  have h := hunit j (𝓕⁻ g)
  rw [← aux_unitFatRelativeBandMax_eq_circleRelativeBandFatUnitSlabMaximal C j g,
    ← aux_unitFatInputProjection_eq_circleRelativeBandFatInputProjection C j g] at h
  exact h

private theorem aux_l2_exists_real_memLp_two_and_eLpNorm_restrRelBp_of_circRelBandFatUnitSlab
    (C : lpCutoffs 2) (A : ENNReal) (hAtop : A ≠ ∞)
    (hunit : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (2 : Nat)) ≤
          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖circleRelativeBandFatInputProjection C j f x‖ ^ (2 : Nat))) :
    ∃ L : Real, 0 < L ∧
      ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
        MemLp (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ∧
        eLpNorm (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f)
          (ENNReal.ofReal (2 : Real)) volume ≤
          ENNReal.ofReal L *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (2 : Real)) volume := by
  obtain ⟨bandConst, hbandtop, hband⟩ :=
    aux_l2_exists_memLp_two_and_eLpNorm_restrRelBp_of_circleRelBandFatUnitSlab
      C A hAtop hunit
  let L : Real := bandConst.toReal + 1
  have hL : 0 < L := by
    dsimp only [L]
    positivity
  refine ⟨L, hL, ?_⟩
  intro j f
  obtain ⟨hmem, hnorm⟩ := hband j f
  refine ⟨hmem, hnorm.trans ?_⟩
  apply mul_le_mul_of_nonneg_right
  · calc
      bandConst = ENNReal.ofReal bandConst.toReal :=
        (ENNReal.ofReal_toReal hbandtop).symm
      _ ≤ ENNReal.ofReal L := by
        apply ENNReal.ofReal_le_ofReal
        dsimp only [L]
        have hnonneg : 0 ≤ bandConst.toReal := ENNReal.toReal_nonneg
        linarith
  · exact bot_le

/-- Literal all-radius uniform planar `L²` reassembly.  The hypothesis is the
