          A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (2 : Nat)))
    (hLP : ∀ (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex),
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) ≤
        B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)))
