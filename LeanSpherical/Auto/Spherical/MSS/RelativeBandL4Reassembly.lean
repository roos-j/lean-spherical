  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

/-- Fixed-time `L⁴` control for the literal moving-fat endpoint packet and
its product-rule time derivative.  The constants depend only on the cutoff,
not on either dyadic scale. -/
private theorem aux_exists_fixed_circleRelativeBandFatEndpointOutput_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B B' : Real, 0 < B ∧ 0 < B' ∧ ∀ (j k : Nat)
      (σ : _root_.Auto.Spherical.MSS.WaveSign) (t : CircleRelativeBandLocalTime)
      (f : SchwartzMap (Euclidean 2) Complex),
      Integrable (fun x : Euclidean 2 =>
        ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖ ^ 4) volume ∧
      (∫ x : Euclidean 2,
        ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖ ^ 4) ≤
        B * (∫ x : Euclidean 2,
          ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) ∧
      Integrable (fun x : Euclidean 2 =>
        ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4)
        volume ∧
      (∫ x : Euclidean 2,
        ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) ≤
        8 * (B' * (∫ x : Euclidean 2,
          ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) +
          B * (∫ x : Euclidean 2,
            ‖circleEndpointWaveContributionTimeDerivative C σ k t.1 f x‖ ^ 4)) := by
  obtain ⟨AQ, hAQ, hQkernel⟩ := exists_circleRelativeBandFatUnit_uniformKernelBound C
  obtain ⟨AQD, hAQD, hQDkernel⟩ :=
    exists_circleRelativeBandFatUnitTimeDerivative_uniformKernelBound C
  obtain ⟨B, hB, hq⟩ :=
    aux_exists_integral_norm_pow_four_relativeMultiplierAt_le_of_uniformKernel
      (circleRelativeBandFatUnitFamily C) hAQ hQkernel
  obtain ⟨B', hB', hqdot⟩ :=
    aux_exists_integral_norm_pow_four_relativeMultiplierAt_le_of_uniformKernel
      (circleRelativeBandFatUnitTimeDerivative C) hAQD hQDkernel
  refine ⟨B, B', hB, hB', ?_⟩
  intro j k σ t f
  let E : SchwartzMap (Euclidean 2) Complex := aux_circleEndpointSchwartzOutput C σ k t.1 f
  let D : SchwartzMap (Euclidean 2) Complex :=
    aux_circleEndpointTimeDerivativeSchwartzOutput C σ k t.1 f
  let Q : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  let A : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitTimeDerivative C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  let R : Euclidean 2 → Complex :=
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
      (circleRelativeBandFatUnitFamily C t)
      (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) D
  have hE (x : Euclidean 2) : E x = circleEndpointWaveContribution C σ k t.1 f x := by
    dsimp [E]
    exact aux_circleEndpointSchwartzOutput_apply C σ k t.1 f x
  have hD (x : Euclidean 2) : D x =
      circleEndpointWaveContributionTimeDerivative C σ k t.1 f x := by
    dsimp [D]
    exact aux_circleEndpointTimeDerivativeSchwartzOutput_apply C σ k t.1 f x
  have hQ (x : Euclidean 2) : circleRelativeBandFatEndpointOutput C j k σ t.1 f x = Q x := by
    dsimp [Q, E]
    exact aux_circleRelativeBandFatEndpointOutput_eq_relativeMultiplierAt C j k σ t f x
  have hDR (x : Euclidean 2) :
      aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x = A x + R x := by
    dsimp [A, R, E, D]
    exact aux_circleRelativeBandFatEndpointOutputTimeDerivative_eq_relativeMultiplierAt C j k σ t f
        x
  have hQdata := hq t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  have hAdata := hqdot t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  have hRdata := hq t (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) D
  have hQint : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ 4) volume := by
    simpa only [Q] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitFamily C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  have hAint : Integrable (fun x : Euclidean 2 => ‖A x‖ ^ 4) volume := by
    simpa only [A] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitTimeDerivative C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E
  have hRint : Integrable (fun x : Euclidean 2 => ‖R x‖ ^ 4) volume := by
    simpa only [R] using
      aux_integrable_norm_pow_four_circleRelativeBandFatUnitFamily C t
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) D
  have hrawInt : Integrable (fun x : Euclidean 2 =>
      ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖ ^ 4) volume := by
    refine hQint.congr ?_
    filter_upwards with x
    exact congrArg (fun z : Complex => ‖z‖ ^ 4) (hQ x).symm
  have hrawBound : (∫ x : Euclidean 2,
      ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖ ^ 4) ≤
      B * (∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) := by
    calc
      (∫ x : Euclidean 2,
          ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖ ^ 4) =
          ∫ x : Euclidean 2, ‖Q x‖ ^ 4 := by
            apply integral_congr_ae
            filter_upwards with x
            exact congrArg (fun z : Complex => ‖z‖ ^ 4) (hQ x)
      _ ≤ B * (∫ x : Euclidean 2, ‖E x‖ ^ 4) := hQdata
      _ = B * (∫ x : Euclidean 2,
          ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) := by
            have hEint : (∫ x : Euclidean 2, ‖E x‖ ^ 4) =
                ∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4 := by
              apply integral_congr_ae
              filter_upwards with x
              exact congrArg (fun z : Complex => ‖z‖ ^ 4) (hE x)
            rw [hEint]
  have hright : Integrable (fun x : Euclidean 2 =>
      8 * (‖A x‖ ^ 4 + ‖R x‖ ^ 4)) volume :=
    (hAint.add hRint).const_mul 8
  have hrawDotCont : Continuous (fun x : Euclidean 2 =>
      aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x) := by
    have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput C j k σ f
    exact hjoint.2.1.curry_right (x := t.1)
  have hrawDotInt : Integrable (fun x : Euclidean 2 =>
      ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4)
      volume := by
    refine Integrable.mono' hright (hrawDotCont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^
      (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    rw [hDR x]
    exact aux_norm_add_pow_four_le _ _
  have hrawDotBound : (∫ x : Euclidean 2,
      ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) ≤
      8 * (B' * (∫ x : Euclidean 2,
        ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) +
        B * (∫ x : Euclidean 2,
          ‖circleEndpointWaveContributionTimeDerivative C σ k t.1 f x‖ ^ 4)) := by
    have hpoint (x : Euclidean 2) :
        ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4 ≤
          8 * (‖A x‖ ^ 4 + ‖R x‖ ^ 4) := by
      rw [hDR x]
      exact aux_norm_add_pow_four_le _ _
    calc
      (∫ x : Euclidean 2,
          ‖aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x‖ ^ 4) ≤
          ∫ x : Euclidean 2, 8 * (‖A x‖ ^ 4 + ‖R x‖ ^ 4) :=
        integral_mono hrawDotInt hright hpoint
      _ = 8 * (∫ x : Euclidean 2, ‖A x‖ ^ 4) +
          8 * (∫ x : Euclidean 2, ‖R x‖ ^ 4) := by
            rw [MeasureTheory.integral_const_mul,
              MeasureTheory.integral_add hAint hRint]
            ring
      _ ≤ 8 * (B' * (∫ x : Euclidean 2, ‖E x‖ ^ 4)) +
          8 * (B * (∫ x : Euclidean 2, ‖D x‖ ^ 4)) := by
            exact add_le_add
              (mul_le_mul_of_nonneg_left hAdata (by norm_num))
              (mul_le_mul_of_nonneg_left hRdata (by norm_num))
      _ = 8 * (B' * (∫ x : Euclidean 2, ‖E x‖ ^ 4) +
          B * (∫ x : Euclidean 2, ‖D x‖ ^ 4)) := by ring
      _ = 8 * (B' * (∫ x : Euclidean 2,
          ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4) +
          B * (∫ x : Euclidean 2,
            ‖circleEndpointWaveContributionTimeDerivative C σ k t.1 f x‖ ^ 4)) := by
            have hEint : (∫ x : Euclidean 2, ‖E x‖ ^ 4) =
                ∫ x : Euclidean 2, ‖circleEndpointWaveContribution C σ k t.1 f x‖ ^ 4 := by
              apply integral_congr_ae
              filter_upwards with x
              exact congrArg (fun z : Complex => ‖z‖ ^ 4) (hE x)
            have hDint : (∫ x : Euclidean 2, ‖D x‖ ^ 4) =
                ∫ x : Euclidean 2,
                  ‖circleEndpointWaveContributionTimeDerivative C σ k t.1 f x‖ ^ 4 := by
              apply integral_congr_ae
              filter_upwards with x
              exact congrArg (fun z : Complex => ‖z‖ ^ 4) (hD x)
            rw [hEint, hDint]
  exact ⟨hrawInt, hrawBound, hrawDotInt, hrawDotBound⟩

/-- A moving fat relative multiplier preserves the endpoint local-smoothing
maximal gain, uniformly in its unrelated relative-frequency scale. -/
theorem exists_memLp_four_and_eLpNorm_iSup_circRelBdFtEndptOut_of_posLocalSmoothingGain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ M : Real, 0 < M ∧ ∀ (j k : Nat), 1 ≤ k →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      MemLp (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖) 4 volume ∧
      eLpNorm (fun x : Euclidean 2 =>
        ⨆ t : Icc (1 : Real) 2,
          ‖circleRelativeBandFatEndpointOutput C j k σ t.1 f x‖) 4 volume ≤
        ENNReal.ofReal
          (M * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ ρ *
            (∫ x : Euclidean 2, ‖f x‖ ^ 4) ^ ((4 : Real)⁻¹)) := by
  obtain ⟨BQ, BQD, hBQ, hBQD, hfixed⟩ :=
    aux_exists_fixed_circleRelativeBandFatEndpointOutput_le C
  obtain ⟨AF, hAF, hFbase⟩ :=
    exists_ivlInteg_integral_norm_pow_four_circleEndpointWaveContribution_le_gain
      C hgain
  obtain ⟨AD, hAD, hDbase⟩ :=
    exists_ivlInteg_integral_norm_pow_four_circEndptWvContributionTmDeriv_le_gain
      C hgain
  let A : Real := BQ * AF
  let Dconst : Real := 8 * (BQD * AF + BQ * AD)
  let M : Real := (128 * A + 72 * Dconst) ^ ((4 : Real)⁻¹)
  have hA : 0 < A := mul_pos hBQ hAF
  have hDconst : 0 < Dconst := by
    dsimp [Dconst]
    positivity
  have hM : 0 < M := by
    dsimp [M]
    exact Real.rpow_pos_of_pos (by positivity) _
  refine ⟨M, hM, ?_⟩
  intro j k hk σ f
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatEndpointOutput C j k σ t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t f x
  let U : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContribution C σ k t f x
  let V : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContributionTimeDerivative C σ k t f x
  let E : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hjoint := aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput C j k σ f
  have hFcont : Continuous (Function.uncurry F) := by
    simpa only [F] using hjoint.1
  have hDcont : Continuous (Function.uncurry D) := by
    simpa only [D] using hjoint.2.1
  have hderiv : ∀ t x, HasDerivAt (fun s => F s x) (D t x) t := by
    intro t x
    simpa only [F, D] using hjoint.2.2 t x
  have hUprod : Integrable (fun p : Real × Euclidean 2 => ‖U p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    simpa only [ν, U] using
      integrable_norm_pow_four_circleEndpointWaveContribution_prod_of_gain
        C hgain k hk σ f
  have hVprod : Integrable (fun p : Real × Euclidean 2 => ‖V p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    simpa only [ν, V] using
      integrable_norm_pow_four_circleEndpointWaveContributionTimeDerivative_prod_of_gain
        C hgain k hk σ f
  have hUouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ν :=
    hUprod.integral_prod_left
  have hVouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖V t x‖ ^ 4) ν :=
    hVprod.integral_prod_left
  have hFspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖F t.1 x‖ ^ 4) volume := by
    intro t
    simpa only [F] using (hfixed j k σ t f).1
  have hDspatial : ∀ t : Icc (1 : Real) 2,
      Integrable (fun x : Euclidean 2 => ‖D t.1 x‖ ^ 4) volume := by
    intro t
    simpa only [D] using (hfixed j k σ t f).2.2.1
  have hFslice : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖F t.1 x‖ ^ 4) ≤
        BQ * (∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4) := by
    intro t
    simpa only [F, U] using (hfixed j k σ t f).2.1
  have hDslice : ∀ t : Icc (1 : Real) 2,
      (∫ x : Euclidean 2, ‖D t.1 x‖ ^ 4) ≤
        8 * (BQD * (∫ x : Euclidean 2, ‖U t.1 x‖ ^ 4) +
          BQ * (∫ x : Euclidean 2, ‖V t.1 x‖ ^ 4)) := by
    intro t
    simpa only [D, U, V] using (hfixed j k σ t f).2.2.2
  let gF : Real → Real := fun t => BQ * (∫ x : Euclidean 2, ‖U t x‖ ^ 4)
  have hgF : Integrable gF ν := by
    simpa only [gF] using hUouter.const_mul BQ
  have hFprod : Integrable (fun p : Real × Euclidean 2 => ‖F p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    apply integrable_norm_pow_four_prod_of_continuous_of_interval_integral_bound
      hFcont hFspatial hgF
    intro t
    simpa only [gF] using hFslice t
  let gD : Real → Real := fun t =>
    8 * (BQD * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
      BQ * (∫ x : Euclidean 2, ‖V t x‖ ^ 4))
  have hgD : Integrable gD ν := by
    change Integrable (fun t : Real =>
      8 * (BQD * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
        BQ * (∫ x : Euclidean 2, ‖V t x‖ ^ 4))) ν
    simpa only [Pi.add_apply] using
      ((hUouter.const_mul BQD).add (hVouter.const_mul BQ)).const_mul 8
  have hDprod : Integrable (fun p : Real × Euclidean 2 => ‖D p.1 p.2‖ ^ 4)
      (ν.prod volume) := by
    apply integrable_norm_pow_four_prod_of_continuous_of_interval_integral_bound
      hDcont hDspatial hgD
    intro t
    simpa only [gD] using hDslice t
  have hFouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ν :=
    hFprod.integral_prod_left
  have hDouter : Integrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ν :=
    hDprod.integral_prod_left
  have hFinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖F t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hFouter
  have hDinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖D t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hDouter
  have hUinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖U t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hUouter
  have hVinterval : IntervalIntegrable (fun t : Real => ∫ x : Euclidean 2, ‖V t x‖ ^ 4)
      volume 1 2 := by
    rw [intervalIntegrable_iff_integrableOn_Icc_of_le (by norm_num : (1 : Real) ≤ 2)]
    exact hVouter
  have hFtoU :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        BQ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
          ∫ t in (1 : Real)..2, BQ * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) := by
            exact intervalIntegral.integral_mono_on (by norm_num) hFinterval
              (hUinterval.const_mul _) (fun t ht => hFslice ⟨t, ht⟩)
      _ = BQ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) := by
            rw [intervalIntegral.integral_const_mul]
  have hDUVinterval : IntervalIntegrable (fun t : Real =>
      8 * (BQD * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
        BQ * (∫ x : Euclidean 2, ‖V t x‖ ^ 4))) volume 1 2 := by
      simpa only [Pi.add_apply] using
        ((hUinterval.const_mul BQD).add (hVinterval.const_mul BQ)).const_mul 8
  have hDtoUV :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ≤
        8 * (BQD * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
          BQ * (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖V t x‖ ^ 4)) := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ≤
          ∫ t in (1 : Real)..2,
            8 * (BQD * (∫ x : Euclidean 2, ‖U t x‖ ^ 4) +
              BQ * (∫ x : Euclidean 2, ‖V t x‖ ^ 4)) := by
            exact intervalIntegral.integral_mono_on (by norm_num) hDinterval hDUVinterval
              (fun t ht => hDslice ⟨t, ht⟩)
      _ = _ := by
            rw [intervalIntegral.integral_const_mul,
              intervalIntegral.integral_add (hUinterval.const_mul _)
                (hVinterval.const_mul _),
              intervalIntegral.integral_const_mul,
              intervalIntegral.integral_const_mul]
  have hUenergy := hFbase k hk σ f
  have hVenergy := hDbase k hk σ f
  have hUenergy' :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖U t x‖ ^ 4) ≤
        AF * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) * E := by
    simpa only [U, E] using hUenergy
  have hVenergy' :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖V t x‖ ^ 4) ≤
        AD * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by
    simpa only [V, E] using hVenergy
  have hFenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
        A * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) * E := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖F t x‖ ^ 4) ≤
          BQ * (AF * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) * E) :=
        hFtoU.trans (mul_le_mul_of_nonneg_left hUenergy' hBQ.le)
      _ = A * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) * E := by
        dsimp [A]
        ring
  have hshift := aux_dyadicTimeScale_rpow_shift_four_le k ρ
  have hE : 0 ≤ E := by
    dsimp [E]
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hfirst : BQD * (AF * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
      (1 + 4 * ρ) * E) ≤
      (BQD * AF) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by
    calc
      BQD * (AF * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) * E) =
          (BQD * AF * E) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (1 + 4 * ρ) := by ring
      _ ≤ (BQD * AF * E) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) :=
          mul_le_mul_of_nonneg_left hshift (by positivity)
      _ = (BQD * AF) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by ring
  have hsecond : BQ * (AD * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
      (-3 + 4 * ρ) * E) =
      (BQ * AD) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by ring
  have hDenergy :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ≤
        Dconst * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by
    calc
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2, ‖D t x‖ ^ 4) ≤
          8 * (BQD * (AF * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
            (1 + 4 * ρ) * E) +
            BQ * (AD * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
              (-3 + 4 * ρ) * E)) :=
        hDtoUV.trans (mul_le_mul_of_nonneg_left
          (add_le_add
            (mul_le_mul_of_nonneg_left hUenergy' hBQD.le)
            (mul_le_mul_of_nonneg_left hVenergy' hBQ.le))
          (by norm_num))
      _ ≤ 8 * ((BQD * AF) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
          (-3 + 4 * ρ) * E +
          (BQ * AD) * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^
            (-3 + 4 * ρ) * E) :=
        mul_le_mul_of_nonneg_left (add_le_add hfirst (le_of_eq hsecond)) (by norm_num)
      _ = Dconst * _root_.Auto.Spherical.MSS.dyadicTimeScale k ^ (-3 + 4 * ρ) * E := by
        dsimp [Dconst]
        ring
  obtain ⟨T, hT⟩ := exists_MSS_MaximalSeparated k
  have hmax := memLp_four_and_eLpNorm_iSup_timeSamplingL4_of_dyadic_energy
    (F := F) (F' := D) k T hT hFcont hDcont hderiv hFprod hDprod
      hA.le hDconst.le hE hFenergy hDenergy
  simpa only [F, E, M] using hmax

/-- Each literal dyadic summand of the unnormalized moving-fat circle output
is exactly the surface-mass multiple of its two endpoint packets and its
middle packet.  This records the normalization needed to pass from the
circle-average wave decomposition to the raw `surfaceFourier` multiplier. -/
theorem circleRelativeBandFatUnitSlabDyadicOutput_eq_surfaceMass_mul_threeWave
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabDyadicOutput C j k t f x =
      ((surfaceMass 2 : Real) : Complex) *
        (circleRelativeBandFatEndpointOutput C j k _root_.Auto.Spherical.MSS.WaveSign.minus
            t.1 f x +
          circleRelativeBandFatEndpointOutput C j k _root_.Auto.Spherical.MSS.WaveSign.plus
            t.1 f x +
          circleRelativeBandFatMiddleOutput C j k t.1 f x) := by
  let q : Euclidean 2 → Complex := fun xi =>
    circleRelativeBandFatUnitFamily C t (((2 : Real) ^ j)⁻¹ • xi)
  let aMinus : Euclidean 2 → Complex := fun xi =>
    q xi * (((surfaceMass 2 : Real) : Complex)⁻¹ * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus
        (2 * Real.pi * (t.1 * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.minus t.1 xi)
  let aPlus : Euclidean 2 → Complex := fun xi =>
    q xi * (((surfaceMass 2 : Real) : Complex)⁻¹ * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus
        (2 * Real.pi * (t.1 * ‖xi‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier
        _root_.Auto.Spherical.MSS.WaveSign.plus t.1 xi)
  let aMiddle : Euclidean 2 → Complex := fun xi =>
    q xi * (((surfaceMass 2 : Real) : Complex)⁻¹ * (surfaceMass 1 : Complex) *
      Auto.Spherical.OscillatoryIntegralAux.coordinateMiddleMeridianLocalizedIntegral
        0 (2 * Real.pi * (t.1 * ‖xi‖)))
  let qMinus : Euclidean 2 → Complex := fun xi =>
    aMinus xi * _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qPlus : Euclidean 2 → Complex := fun xi =>
    aPlus xi * _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  let qMiddle : Euclidean 2 → Complex := fun xi =>
    aMiddle xi * _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi *
      𝓕 (f : Euclidean 2 → Complex) xi
  have hscale : Continuous (fun xi : Euclidean 2 => ((2 : Real) ^ j)⁻¹ • xi) :=
    (continuous_const : Continuous fun _ : Euclidean 2 => ((2 : Real) ^ j)⁻¹).smul continuous_id
  have hq : Continuous q := by
    exact (circleRelativeBandFatUnitFamily C t).continuous.comp hscale
  have haMinus : Continuous aMinus := by
    dsimp [aMinus]
    exact hq.mul ((((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.minus t.1)).mul
        (aux_continuous_halfWaveMultiplier _root_.Auto.Spherical.MSS.WaveSign.minus t.1)))
  have haPlus : Continuous aPlus := by
    dsimp [aPlus]
    exact hq.mul ((((continuous_const.mul continuous_const).mul
      (aux_continuous_circleEndpointAmplitude _root_.Auto.Spherical.MSS.WaveSign.plus t.1)).mul
        (aux_continuous_halfWaveMultiplier _root_.Auto.Spherical.MSS.WaveSign.plus t.1)))
  have haMiddle : Continuous aMiddle := by
    dsimp [aMiddle]
    exact hq.mul ((continuous_const.mul continuous_const).mul
      (aux_continuous_coordinateMiddleMeridianLocalizedIntegral_zero.comp (by fun_prop)))
  have hqMinus : Integrable qMinus := by
    simpa only [qMinus] using
      (aux_integrable_continuous_mul_dyadicBandpass_fourier C k aMinus haMinus f)
  have hqPlus : Integrable qPlus := by
    simpa only [qPlus] using
      (aux_integrable_continuous_mul_dyadicBandpass_fourier C k aPlus haPlus f)
  have hqMiddle : Integrable qMiddle := by
    simpa only [qMiddle] using
      (aux_integrable_continuous_mul_dyadicBandpass_fourier C k aMiddle haMiddle f)
  have hMinus : circleRelativeBandFatEndpointOutput C j k
      _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x = 𝓕⁻ qMinus x := by
    unfold circleRelativeBandFatEndpointOutput
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    dsimp [qMinus, aMinus, q]
    rw [aux_circleRelativeBandFatUnitFamily_apply_raw]
    unfold aux_circleEndpointBandpassMultiplier
    ring
  have hPlus : circleRelativeBandFatEndpointOutput C j k
      _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x = 𝓕⁻ qPlus x := by
    unfold circleRelativeBandFatEndpointOutput
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    dsimp [qPlus, aPlus, q]
    rw [aux_circleRelativeBandFatUnitFamily_apply_raw]
    unfold aux_circleEndpointBandpassMultiplier
    ring
  have hMiddle : circleRelativeBandFatMiddleOutput C j k t.1 f x = 𝓕⁻ qMiddle x := by
    unfold circleRelativeBandFatMiddleOutput
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext xi
    dsimp [qMiddle, aMiddle, q]
    rw [aux_circleRelativeBandFatUnitFamily_apply_raw]
    unfold aux_circleMiddleBandpassMultiplier
    ring
  have hsymbol (xi : Euclidean 2) :
      q xi * surfaceFourier 2 (-t.1 • xi) *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi *
          𝓕 (f : Euclidean 2 → Complex) xi =
        ((surfaceMass 2 : Real) : Complex) *
          (qMinus xi + qPlus xi + qMiddle xi) := by
    have hnorm : ‖-t.1 • xi‖ = t.1 * ‖xi‖ := by
      rw [norm_smul, Real.norm_eq_abs, abs_neg,
        abs_of_nonneg (zero_le_one.trans t.2.1)]
    have hmass : ((surfaceMass 2 : Real) : Complex) ≠ 0 := by
      exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
    dsimp [qMinus, qPlus, qMiddle, aMinus, aPlus, aMiddle]
    rw [circleSurfaceFourierCoordinateWaveDecomposition (-t.1 • xi), hnorm,
      ← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_minus,
      ← aux_circleEndpointAmplitude_mul_halfWaveMultiplier_plus]
    field_simp [hmass]
  unfold circleRelativeBandFatUnitSlabDyadicOutput
  change 𝓕⁻ (fun xi : Euclidean 2 =>
    q xi * surfaceFourier 2 (-t.1 • xi) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x = _
  calc
    _ = 𝓕⁻ (fun xi : Euclidean 2 =>
        ((surfaceMass 2 : Real) : Complex) * (qMinus xi + qPlus xi + qMiddle xi)) x := by
          apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
          funext xi
          exact hsymbol xi
    _ = ((surfaceMass 2 : Real) : Complex) *
        𝓕⁻ (fun xi : Euclidean 2 => qMinus xi + qPlus xi + qMiddle xi) x := by
          rw [← aux_const_mul_fourierInv]
    _ = ((surfaceMass 2 : Real) : Complex) *
        (𝓕⁻ qMinus x + 𝓕⁻ qPlus x + 𝓕⁻ qMiddle x) := by
          change ((surfaceMass 2 : Real) : Complex) *
              𝓕⁻ ((qMinus + qPlus) + qMiddle) x = _
          rw [aux_fourierInv_add_of_integrable (qMinus + qPlus) qMiddle
            (hqMinus.add hqPlus) hqMiddle,
            aux_fourierInv_add_of_integrable qMinus qPlus hqMinus hqPlus]
    _ = _ := by rw [← hMinus, ← hPlus, ← hMiddle]

/-! ### Fat-projected local input and finite packet aggregation -/

/-- Schwartz packaging of the fixed fat projection appearing on the right
side of the literal unit-slab estimate. -/
private noncomputable def aux_circleRelativeBandFatInputProjectionSchwartz
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j :
      Euclidean 2 → Complex) (𝓕 f))

private theorem aux_circleRelativeBandFatInputProjectionSchwartz_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleRelativeBandFatInputProjectionSchwartz C j f x =
      circleRelativeBandFatInputProjection C j f x := by
  unfold aux_circleRelativeBandFatInputProjectionSchwartz
    circleRelativeBandFatInputProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).hasTemperateGrowth]
  simp only [smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_fourier_circleRelativeBandFatInputProjectionSchwartz
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    𝓕 (aux_circleRelativeBandFatInputProjectionSchwartz C j f :
      Euclidean 2 → Complex) xi =
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi *
        𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold aux_circleRelativeBandFatInputProjectionSchwartz
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply
    (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j).hasTemperateGrowth]
  simp only [smul_eq_mul, SchwartzMap.fourier_coe]

/-- The local moving band is idempotent under its fixed fat input projection:
the second fat factor is exactly one on the moving relative band. -/
private theorem aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabOutput C j t f x =
      circleRelativeBandFatUnitSlabOutput C j t
        (aux_circleRelativeBandFatInputProjectionSchwartz C j f) x := by
  rw [circleRelativeBandFatUnitSlabOutput_eq_compactMultiplier,
    circleRelativeBandFatUnitSlabOutput_eq_compactMultiplier]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [aux_fourier_circleRelativeBandFatInputProjectionSchwartz]
  let a : Complex := surfaceFourier 2 (-t.1 • xi)
  let d : Complex :=
    C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • xi)) -
      C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • xi))
  have hfat :=
    _root_.Auto.Spherical.Auxiliary.relative_dyadic_bandpass_mul_fat_cutoff
      (phi := C.cutoff) C.cutoff_one C.cutoff_zero (j := j) (k := (0 : Int))
      (r := t.1) (by
        convert t.2 using 1
        all_goals norm_num) xi (a := a)
      (𝓕 (f : Euclidean 2 → Complex))
  rw [circleRelativeBandFatUnitFamily_at_dyadicScale]
  let b : Complex :=
    _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j xi
  let g : Complex := 𝓕 (f : Euclidean 2 → Complex) xi
  change a * (d * b) * g = a * (d * b) * (b * g)
  have hfat' : a * d * g = a * d * b * g := by
    simpa only [a, d,
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier,
      _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply, b, g] using hfat
  calc
    a * (d * b) * g = a * d * b * g := by ring
    _ = a * d * g := hfat'.symm
    _ = a * d * b * g := hfat'
    _ = a * d * b * (b * g) := by
      have hfat2 :=
        _root_.Auto.Spherical.Auxiliary.relative_dyadic_bandpass_mul_fat_cutoff
          (phi := C.cutoff) C.cutoff_one C.cutoff_zero (j := j) (k := (0 : Int))
          (r := t.1) (by
            convert t.2 using 1
            all_goals norm_num) xi (a := a)
          (fun z : Euclidean 2 =>
            _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j z *
              𝓕 (f : Euclidean 2 → Complex) z)
      simpa only [a, d,
        _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier,
        _root_.Auto.LittlewoodPaley.shiftedFatMultiplier_apply, b, g,
        mul_assoc] using hfat2
    _ = a * (d * b) * (b * g) := by ring

private theorem aux_dyadicTimeScale_shift_le
    (j i : Nat) (hj : 2 ≤ j) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i) ≤
      4 * _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
  rw [dyadicTimeScale_eq_inv_natPow, dyadicTimeScale_eq_inv_natPow]
  have hj' : j - 2 + 2 = j := Nat.sub_add_cancel hj
  rw [← hj']
  let m : Nat := j - 2
  change ((2 ^ (m + i) : Nat) : Real)⁻¹ ≤
    4 * ((2 ^ (m + 2) : Nat) : Real)⁻¹
  have hmpos : 0 < ((2 ^ m : Nat) : Real) := by positivity
  have hmipos : 0 < ((2 ^ (m + i) : Nat) : Real) := by positivity
  have hden : ((2 ^ m : Nat) : Real) ≤ ((2 ^ (m + i) : Nat) : Real) := by
    have hdenNat : 2 ^ m ≤ 2 ^ (m + i) :=
      Nat.pow_le_pow_right (by norm_num) (Nat.le_add_right m i)
    exact_mod_cast hdenNat
  calc
    ((2 ^ (m + i) : Nat) : Real)⁻¹ ≤ ((2 ^ m : Nat) : Real)⁻¹ :=
      (inv_le_inv₀ hmipos hmpos).mpr hden
    _ = 4 * ((2 ^ (m + 2) : Nat) : Real)⁻¹ := by
      rw [Nat.pow_add]
      norm_num
      field_simp

private theorem aux_dyadicTimeScale_shift_rpow_le
    (j i : Nat) (hj : 2 ≤ j) {a : Real} (ha : 0 ≤ a) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i) ^ a ≤
      4 ^ a * _root_.Auto.Spherical.MSS.dyadicTimeScale j ^ a := by
  have hδ := aux_dyadicTimeScale_shift_le j i hj
  have hδleft : 0 ≤ _root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i) := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact (zpow_pos (by norm_num) _).le
  have hδright : 0 ≤ _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact (zpow_pos (by norm_num) _).le
  have hpow := Real.rpow_le_rpow hδleft hδ ha
  rw [Real.mul_rpow (by norm_num : (0 : Real) ≤ 4) hδright] at hpow
  exact hpow

private theorem aux_dyadicTimeScale_rpow_le_shift_min
    (j i : Nat) (hj : 2 ≤ j) {a b : Real}
    (ha : 0 ≤ a) (hba : b ≤ a) :
    _root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i) ^ a ≤
      4 ^ a * _root_.Auto.Spherical.MSS.dyadicTimeScale j ^ b := by
  have hshift := aux_dyadicTimeScale_shift_rpow_le j i hj ha
  have hδpos : 0 < _root_.Auto.Spherical.MSS.dyadicTimeScale j := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hδone : _root_.Auto.Spherical.MSS.dyadicTimeScale j ≤ 1 := by
    dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_le_one_of_nonpos₀ (by norm_num) (by omega)
  calc
    _ ≤ 4 ^ a * _root_.Auto.Spherical.MSS.dyadicTimeScale j ^ a := hshift
    _ ≤ 4 ^ a * _root_.Auto.Spherical.MSS.dyadicTimeScale j ^ b := by
      exact mul_le_mul_of_nonneg_left
        (Real.rpow_le_rpow_of_exponent_ge hδpos hδone hba)
        (Real.rpow_nonneg (by norm_num) _)

private theorem aux_memLp_and_eLpNorm_sum_range_le
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (F : Nat → α → Real) (hF : ∀ i, MemLp (F i) 4 μ) (n : Nat) :
    MemLp (fun x => ∑ i ∈ Finset.range n, F i x) 4 μ ∧
      eLpNorm (fun x => ∑ i ∈ Finset.range n, F i x) 4 μ ≤
        ∑ i ∈ Finset.range n, eLpNorm (F i) 4 μ := by
  induction n with
  | zero => simp
  | succ n hn =>
      have hmem : MemLp (fun x => ∑ i ∈ Finset.range n, F i x) 4 μ := hn.1
      have hmem' : MemLp (fun x => ∑ i ∈ Finset.range (n + 1), F i x) 4 μ := by
        have hfun : (fun x => ∑ i ∈ Finset.range (n + 1), F i x) =
            (fun x => ∑ i ∈ Finset.range n, F i x) + F n := by
          funext x
          rw [show n + 1 = Nat.succ n by omega, Finset.sum_range_succ]
          rfl
        rw [hfun]
        exact hmem.add (hF n)
      refine ⟨hmem', ?_⟩
      calc
        eLpNorm (fun x => ∑ i ∈ Finset.range (n + 1), F i x) 4 μ =
            eLpNorm ((fun x => ∑ i ∈ Finset.range n, F i x) + F n) 4 μ := by
              congr 1
              funext x
              simp only [Finset.sum_range_succ, Pi.add_apply]
        _ ≤ eLpNorm (fun x => ∑ i ∈ Finset.range n, F i x) 4 μ +
            eLpNorm (F n) 4 μ :=
              eLpNorm_add_le hmem.1 (hF n).1 (by norm_num)
        _ ≤ (∑ i ∈ Finset.range n, eLpNorm (F i) 4 μ) +
            eLpNorm (F n) 4 μ := add_le_add hn.2 le_rfl
        _ = ∑ i ∈ Finset.range (n + 1), eLpNorm (F i) 4 μ := by
              rw [Finset.sum_range_succ]

private theorem aux_memLp_and_eLpNorm_five_triples_le
    {α : Type*} [MeasurableSpace α] {μ : Measure α}
    (Eminus Eplus Middle : Nat → α → Real)
    {Ae Am : Real} (hAe : 0 ≤ Ae) (hAm : 0 ≤ Am)
    (hminus : ∀ i, MemLp (Eminus i) 4 μ ∧
      eLpNorm (Eminus i) 4 μ ≤ ENNReal.ofReal Ae)
    (hplus : ∀ i, MemLp (Eplus i) 4 μ ∧
      eLpNorm (Eplus i) 4 μ ≤ ENNReal.ofReal Ae)
    (hmiddle : ∀ i, MemLp (Middle i) 4 μ ∧
      eLpNorm (Middle i) 4 μ ≤ ENNReal.ofReal Am) :
    MemLp (fun x => ∑ i ∈ Finset.range 5,
      (Eminus i x + Eplus i x + Middle i x)) 4 μ ∧
      eLpNorm (fun x => ∑ i ∈ Finset.range 5,
        (Eminus i x + Eplus i x + Middle i x)) 4 μ ≤
        ENNReal.ofReal (5 * (2 * Ae + Am)) := by
  let H : Nat → α → Real := fun i x => Eminus i x + Eplus i x + Middle i x
  have hB : 0 ≤ 2 * Ae + Am := by positivity
  have hHmem (i : Nat) : MemLp (H i) 4 μ := by
    exact ((hminus i).1.add (hplus i).1).add (hmiddle i).1
  have hHnorm (i : Nat) : eLpNorm (H i) 4 μ ≤
      ENNReal.ofReal (2 * Ae + Am) := by
    calc
      eLpNorm (H i) 4 μ ≤
          eLpNorm (Eminus i + Eplus i) 4 μ + eLpNorm (Middle i) 4 μ := by
            dsimp [H]
            exact eLpNorm_add_le ((hminus i).1.add (hplus i).1).1
              (hmiddle i).1.1 (by norm_num)
      _ ≤ (eLpNorm (Eminus i) 4 μ + eLpNorm (Eplus i) 4 μ) +
          eLpNorm (Middle i) 4 μ := by
            exact add_le_add
              (eLpNorm_add_le (hminus i).1.1 (hplus i).1.1
                (show (1 : ENNReal) ≤ 4 by norm_num)) le_rfl
      _ ≤ (ENNReal.ofReal Ae + ENNReal.ofReal Ae) + ENNReal.ofReal Am := by
            exact add_le_add (add_le_add (hminus i).2 (hplus i).2) (hmiddle i).2
      _ = ENNReal.ofReal (2 * Ae + Am) := by
            rw [← ENNReal.ofReal_add hAe hAe,
              ← ENNReal.ofReal_add (by positivity) hAm]
            congr 1
            ring
  have hsum := aux_memLp_and_eLpNorm_sum_range_le H hHmem 5
  refine ⟨?_, ?_⟩
  · simpa only [H] using hsum.1
  · calc
      eLpNorm (fun x => ∑ i ∈ Finset.range 5,
          (Eminus i x + Eplus i x + Middle i x)) 4 μ =
          eLpNorm (fun x => ∑ i ∈ Finset.range 5, H i x) 4 μ := by rfl
      _ ≤ ∑ i ∈ Finset.range 5, eLpNorm (H i) 4 μ := hsum.2
      _ ≤ ∑ i ∈ Finset.range 5, ENNReal.ofReal (2 * Ae + Am) :=
          Finset.sum_le_sum fun i _ => hHnorm i
      _ = ENNReal.ofReal (5 * (2 * Ae + Am)) := by
          rw [← ENNReal.ofReal_sum_of_nonneg (fun i _ => hB),
            Finset.sum_const, Finset.card_range]
          simp only [nsmul_eq_mul]
          norm_num

private noncomputable def aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Real :=
  fun x => ∑ i ∈ Finset.range 5,
    ((⨆ t : Icc (1 : Real) 2,
        ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x‖) +
      (⨆ t : Icc (1 : Real) 2,
        ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x‖) +
      (⨆ t : Icc (1 : Real) 2,
        ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖))

private theorem aux_exists_memLp_and_eLpNorm_circleRelativeBandFatUnitSlabHighPacketMaximalSum
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ K : Real, 0 < K ∧ ∀ (j : Nat), 3 ≤ j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        MemLp (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume ∧
        eLpNorm (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume ≤
          ENNReal.ofReal
            (K * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
              (min ρ ((3 : Real) / 4)) *
              (∫ x : Euclidean 2, ‖f x‖ ^ 4) ^ ((4 : Real)⁻¹)) := by
  obtain ⟨Me, hMe, hendpoint⟩ :=
    exists_memLp_four_and_eLpNorm_iSup_circRelBdFtEndptOut_of_posLocalSmoothingGain
      C hgain
  obtain ⟨Mm, hMm, hmiddle⟩ :=
    exists_memLp_four_and_eLpNorm_iSup_circleRelBandFatMidOutput_le_rapid_dyDecay
      0 C
  let β : Real := min ρ ((3 : Real) / 4)
  let K : Real := 5 * (2 * Me * 4 ^ ρ + Mm * 4 ^ ((3 : Real) / 4))
  have hK : 0 < K := by
    dsimp [K]
    positivity
  refine ⟨K, hK, ?_⟩
  intro j hj f
  let E : Real := (∫ x : Euclidean 2, ‖f x‖ ^ 4) ^ ((4 : Real)⁻¹)
  let Ae : Real := Me * 4 ^ ρ *
    (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β * E
  let Am : Real := Mm * 4 ^ ((3 : Real) / 4) *
    (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β * E
  let Eminus : Nat → Euclidean 2 → Real := fun i x =>
    ⨆ t : Icc (1 : Real) 2,
      ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
        _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x‖
  let Eplus : Nat → Euclidean 2 → Real := fun i x =>
    ⨆ t : Icc (1 : Real) 2,
      ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
        _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x‖
  let Middle : Nat → Euclidean 2 → Real := fun i x =>
    ⨆ t : Icc (1 : Real) 2,
      ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖
  have hE : 0 ≤ E := by
    dsimp [E]
    exact Real.rpow_nonneg
      (integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _) _
  have hAe : 0 ≤ Ae := by
    dsimp [Ae]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg hMe.le (Real.rpow_nonneg (by norm_num) _))
        (Real.rpow_nonneg
          (by
            dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
            exact (zpow_pos (by norm_num) _).le) _)) hE
  have hAm : 0 ≤ Am := by
    dsimp [Am]
    exact mul_nonneg
      (mul_nonneg
        (mul_nonneg hMm.le (Real.rpow_nonneg (by norm_num) _))
        (Real.rpow_nonneg
          (by
            dsimp [_root_.Auto.Spherical.MSS.dyadicTimeScale]
            exact (zpow_pos (by norm_num) _).le) _)) hE
  have hβρ : β ≤ ρ := by
    dsimp [β]
    exact min_le_left _ _
  have hβmiddle : β ≤ (3 : Real) / 4 := by
    dsimp [β]
    exact min_le_right _ _
  have hminus (i : Nat) : MemLp (Eminus i) 4 volume ∧
      eLpNorm (Eminus i) 4 volume ≤ ENNReal.ofReal Ae := by
    have hterm := hendpoint j (j - 2 + i) (by omega)
      _root_.Auto.Spherical.MSS.WaveSign.minus f
    have hrate := aux_dyadicTimeScale_rpow_le_shift_min j i
      (le_trans (by norm_num : (2 : Nat) ≤ 3) hj)
      hgain.2.1.le hβρ
    refine ⟨by simpa only [Eminus] using hterm.1, ?_⟩
    calc
      eLpNorm (Eminus i) 4 volume ≤
          ENNReal.ofReal
            (Me * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^ ρ * E) := by
              simpa only [Eminus, E] using hterm.2
      _ ≤ ENNReal.ofReal Ae := by
        apply ENNReal.ofReal_le_ofReal
        calc
          Me * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^ ρ * E ≤
              (Me * (4 ^ ρ * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β)) * E :=
                mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_left hrate hMe.le) hE
          _ = Ae := by
                dsimp [Ae]
                ring
  have hplus (i : Nat) : MemLp (Eplus i) 4 volume ∧
      eLpNorm (Eplus i) 4 volume ≤ ENNReal.ofReal Ae := by
    have hterm := hendpoint j (j - 2 + i) (by omega)
      _root_.Auto.Spherical.MSS.WaveSign.plus f
    have hrate := aux_dyadicTimeScale_rpow_le_shift_min j i
      (le_trans (by norm_num : (2 : Nat) ≤ 3) hj)
      hgain.2.1.le hβρ
    refine ⟨by simpa only [Eplus] using hterm.1, ?_⟩
    calc
      eLpNorm (Eplus i) 4 volume ≤
          ENNReal.ofReal
            (Me * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^ ρ * E) := by
              simpa only [Eplus, E] using hterm.2
      _ ≤ ENNReal.ofReal Ae := by
        apply ENNReal.ofReal_le_ofReal
        calc
          Me * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^ ρ * E ≤
              (Me * (4 ^ ρ * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β)) * E :=
                mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_left hrate hMe.le) hE
          _ = Ae := by
                dsimp [Ae]
                ring
  have hmiddle' (i : Nat) : MemLp (Middle i) 4 volume ∧
      eLpNorm (Middle i) 4 volume ≤ ENNReal.ofReal Am := by
    have hterm := hmiddle j (j - 2 + i) f
    have hrate := aux_dyadicTimeScale_rpow_le_shift_min j i
      (le_trans (by norm_num : (2 : Nat) ≤ 3) hj)
      (by norm_num : 0 ≤ (3 : Real) / 4) hβmiddle
    refine ⟨by simpa only [Middle] using hterm.1, ?_⟩
    calc
      eLpNorm (Middle i) 4 volume ≤
          ENNReal.ofReal
            (Mm * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^
                ((3 : Real) / 4) * E) := by
              simpa [Middle, E] using hterm.2
      _ ≤ ENNReal.ofReal Am := by
        apply ENNReal.ofReal_le_ofReal
        calc
          Mm * (_root_.Auto.Spherical.MSS.dyadicTimeScale (j - 2 + i)) ^
              ((3 : Real) / 4) * E ≤
              (Mm * (4 ^ ((3 : Real) / 4) *
                (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β)) * E :=
                mul_le_mul_of_nonneg_right
                  (mul_le_mul_of_nonneg_left hrate hMm.le) hE
          _ = Am := by
                dsimp [Am]
                ring
  have hsum :
      MemLp (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume ∧
        eLpNorm (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume ≤
          ENNReal.ofReal (5 * (2 * Ae + Am)) := by
    change MemLp (fun x : Euclidean 2 => ∑ i ∈ Finset.range 5,
      (Eminus i x + Eplus i x + Middle i x)) 4 volume ∧
      eLpNorm (fun x : Euclidean 2 => ∑ i ∈ Finset.range 5,
        (Eminus i x + Eplus i x + Middle i x)) 4 volume ≤
        ENNReal.ofReal (5 * (2 * Ae + Am))
    exact aux_memLp_and_eLpNorm_five_triples_le
      Eminus Eplus Middle hAe hAm hminus hplus hmiddle'
  refine ⟨?_, ?_⟩
  · exact hsum.1
  · calc
      eLpNorm (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume ≤
          ENNReal.ofReal (5 * (2 * Ae + Am)) := hsum.2
      _ = ENNReal.ofReal
          (K * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^ β * E) := by
            congr 1
            dsimp [K, Ae, Am]
            ring
      _ = ENNReal.ofReal
          (K * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
            (min ρ ((3 : Real) / 4)) *
            (∫ x : Euclidean 2, ‖f x‖ ^ 4) ^ ((4 : Real)⁻¹)) := by
            rfl

private theorem aux_norm_le_iSup_norm_of_continuous
    {X E : Type*} [TopologicalSpace X] [NormedAddCommGroup E]
    {F : Real → X → E} (hF : Continuous (Function.uncurry F))
    (t : Icc (1 : Real) 2) (x : X) :
    ‖F t.1 x‖ ≤ ⨆ s : Icc (1 : Real) 2, ‖F s.1 x‖ := by
  have hnorm : Continuous (fun s : Real => ‖F s x‖) :=
    (hF.comp (continuous_id.prodMk (continuous_const : Continuous fun _ : Real => x))).norm
  obtain ⟨s0, hs0, hmax⟩ := isCompact_Icc.exists_isMaxOn
    (nonempty_Icc.mpr (by norm_num : (1 : Real) ≤ 2)) hnorm.continuousOn
  have hbdd : BddAbove (Set.range fun s : Icc (1 : Real) 2 => ‖F s.1 x‖) := by
    refine ⟨‖F s0 x‖, ?_⟩
    rintro _ ⟨s, rfl⟩
    exact hmax s.2
  exact le_ciSup hbdd t

private theorem aux_integral_norm_pow_four_le_of_eLpNorm_le
    {α : Type*} [MeasurableSpace α] {μ : Measure α} {G : α → Real}
    {B : Real} (hG : MemLp G 4 μ) (hB : 0 ≤ B)
    (hbound : eLpNorm G 4 μ ≤ ENNReal.ofReal B) :
    (∫ x, ‖G x‖ ^ 4 ∂μ) ≤ B ^ (4 : Nat) := by
  rw [hG.eLpNorm_eq_integral_rpow_norm (by norm_num) (by norm_num)] at hbound
  norm_num at hbound
  have hroot : (∫ x, ‖G x‖ ^ 4 ∂μ) ^ (1 / 4 : Real) ≤ B :=
    (ENNReal.ofReal_le_ofReal_iff hB).mp hbound
  have hI : 0 ≤ ∫ x, ‖G x‖ ^ 4 ∂μ :=
    integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  calc
    (∫ x, ‖G x‖ ^ 4 ∂μ) =
        ((∫ x, ‖G x‖ ^ 4 ∂μ) ^ (1 / 4 : Real)) ^ (4 : Nat) := by
          rw [← Real.rpow_natCast, ← Real.rpow_mul hI]
          norm_num
    _ ≤ B ^ (4 : Nat) := by
      rw [← Real.rpow_natCast ((∫ x, ‖G x‖ ^ 4 ∂μ) ^ (1 / 4 : Real)) 4,
        ← Real.rpow_natCast B 4]
      exact Real.rpow_le_rpow (Real.rpow_nonneg hI (1 / 4 : Real)) hroot
        (by norm_num : (0 : Real) ≤ 4)

/-- The finite endpoint/middle packet whose restriction to the unit time slab
is the full moving-fat relative-band circle output at high relative scale. -/
private noncomputable def aux_circleRelativeBandFatUnitSlabHighOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex)
    (t : Real) : Euclidean 2 → Complex :=
  fun x => ∑ i ∈ Finset.range 5,
    ((surfaceMass 2 : Real) : Complex) *
      (circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.minus t f x +
        circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.plus t f x +
        circleRelativeBandFatMiddleOutput C j (j - 2 + i) t f x)

private theorem aux_circleRelativeBandFatUnitSlabOutput_eq_highOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabOutput C j t f x =
      aux_circleRelativeBandFatUnitSlabHighOutput C j f t.1 x := by
  rw [circleRelativeBandFatUnitSlabOutput_eq_sum_five_dyadic C j hj t f x]
  unfold aux_circleRelativeBandFatUnitSlabHighOutput
  apply Finset.sum_congr rfl
  intro i hi
  exact circleRelativeBandFatUnitSlabDyadicOutput_eq_surfaceMass_mul_threeWave
    C j (j - 2 + i) t f x

private theorem aux_continuous_circleRelativeBandFatUnitSlabHighOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry
      (aux_circleRelativeBandFatUnitSlabHighOutput C j f)) := by
  change Continuous (fun p : Real × Euclidean 2 => ∑ i ∈ Finset.range 5,
    ((surfaceMass 2 : Real) : Complex) *
      (circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.minus p.1 f p.2 +
        circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.plus p.1 f p.2 +
        circleRelativeBandFatMiddleOutput C j (j - 2 + i) p.1 f p.2))
  apply continuous_finsetSum
  intro i hi
  convert (continuous_const (y := ((surfaceMass 2 : Real) : Complex))).mul
    (((aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
        C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.minus f).1.add
      (aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
        C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.plus f).1).add
      (aux_continuous_and_hasDerivAt_circleRelativeBandFatMiddleOutput
        C j (j - 2 + i) f).1) using 1
  funext p
  rfl

private theorem aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum_nonneg
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    0 ≤ aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f x := by
  unfold aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum
  apply Finset.sum_nonneg
  intro i hi
  apply add_nonneg
  · apply add_nonneg
    · calc
        0 ≤ ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.minus 1 f x‖ := norm_nonneg _
        _ ≤ ⨆ t : Icc (1 : Real) 2,
          ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
            _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x‖ :=
          aux_norm_le_iSup_norm_of_continuous
            (aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
              C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.minus f).1
            ⟨1, by norm_num⟩ x
    · calc
        0 ≤ ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
          _root_.Auto.Spherical.MSS.WaveSign.plus 1 f x‖ := norm_nonneg _
        _ ≤ ⨆ t : Icc (1 : Real) 2,
          ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
            _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x‖ :=
          aux_norm_le_iSup_norm_of_continuous
            (aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
              C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.plus f).1
            ⟨1, by norm_num⟩ x
  · calc
      0 ≤ ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) 1 f x‖ := norm_nonneg _
      _ ≤ ⨆ t : Icc (1 : Real) 2,
        ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖ :=
        aux_norm_le_iSup_norm_of_continuous
          (aux_continuous_and_hasDerivAt_circleRelativeBandFatMiddleOutput
            C j (j - 2 + i) f).1
          ⟨1, by norm_num⟩ x

private theorem aux_circleRelativeBandFatUnitSlabMaximal_le_highPacket
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (f : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabMaximal C j f x ≤
      ENNReal.ofReal
        (‖((surfaceMass 2 : Real) : Complex)‖ *
          aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f x) := by
  unfold circleRelativeBandFatUnitSlabMaximal
  apply iSup_le
  intro t
  rw [aux_circleRelativeBandFatUnitSlabOutput_eq_highOutput C j hj t f x]
  apply ENNReal.ofReal_le_ofReal
  unfold aux_circleRelativeBandFatUnitSlabHighOutput
  calc
    ‖∑ i ∈ Finset.range 5,
        ((surfaceMass 2 : Real) : Complex) *
          (circleRelativeBandFatEndpointOutput C j (j - 2 + i)
              _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x +
            circleRelativeBandFatEndpointOutput C j (j - 2 + i)
              _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x +
            circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x)‖ ≤
        ∑ i ∈ Finset.range 5,
          ‖((surfaceMass 2 : Real) : Complex) *
            (circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x +
              circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x +
              circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x)‖ :=
        norm_sum_le _ _
    _ ≤ ∑ i ∈ Finset.range 5,
        ‖((surfaceMass 2 : Real) : Complex)‖ *
          ((⨆ s : Icc (1 : Real) 2,
              ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.minus s.1 f x‖) +
            (⨆ s : Icc (1 : Real) 2,
              ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.plus s.1 f x‖) +
            (⨆ s : Icc (1 : Real) 2,
              ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) s.1 f x‖)) := by
      apply Finset.sum_le_sum
      intro i hi
      rw [norm_mul]
      apply mul_le_mul_of_nonneg_left
      · calc
          ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
              _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x +
            circleRelativeBandFatEndpointOutput C j (j - 2 + i)
              _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x +
            circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖ ≤
              ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x‖ +
              ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x‖ +
              ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖ := by
                calc
                  _ ≤ ‖circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                    _root_.Auto.Spherical.MSS.WaveSign.minus t.1 f x +
                    circleRelativeBandFatEndpointOutput C j (j - 2 + i)
                    _root_.Auto.Spherical.MSS.WaveSign.plus t.1 f x‖ +
                    ‖circleRelativeBandFatMiddleOutput C j (j - 2 + i) t.1 f x‖ :=
                      norm_add_le _ _
                  _ ≤ _ := add_le_add (norm_add_le _ _) le_rfl
          _ ≤ _ := add_le_add
            (add_le_add
              (aux_norm_le_iSup_norm_of_continuous
                (aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
                  C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.minus f).1 t x)
              (aux_norm_le_iSup_norm_of_continuous
                (aux_continuous_and_hasDerivAt_circleRelativeBandFatEndpointOutput
                  C j (j - 2 + i) _root_.Auto.Spherical.MSS.WaveSign.plus f).1 t x))
            (aux_norm_le_iSup_norm_of_continuous
              (aux_continuous_and_hasDerivAt_circleRelativeBandFatMiddleOutput
                C j (j - 2 + i) f).1 t x)
      · exact norm_nonneg _
    _ = ‖((surfaceMass 2 : Real) : Complex)‖ *
        aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f x := by
      unfold aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum
      rw [Finset.mul_sum]

private theorem aux_measurable_circleRelativeBandFatUnitSlabMaximal_of_two_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (circleRelativeBandFatUnitSlabMaximal C j f) := by
  let F : Real → Euclidean 2 → Complex :=
    aux_circleRelativeBandFatUnitSlabHighOutput C j f
  have hF : Continuous (Function.uncurry F) := by
    simpa only [F] using aux_continuous_circleRelativeBandFatUnitSlabHighOutput C j f
  have hG : Measurable (⨆ t : CircleRelativeBandLocalTime,
      fun x : Euclidean 2 => ENNReal.ofReal ‖F t.1 x‖) := by
    apply measurable_iSup_of_lowerSemicontinuous
    · intro t
      exact (ENNReal.continuous_ofReal.comp
        ((hF.comp (continuous_const.prodMk continuous_id)).norm)).measurable
    · intro x
      exact (ENNReal.continuous_ofReal.comp
        ((hF.comp (continuous_subtype_val.prodMk continuous_const)).norm)).lowerSemicontinuous
  have hmeas : Measurable (fun x : Euclidean 2 =>
      ⨆ t : CircleRelativeBandLocalTime, ENNReal.ofReal ‖F t.1 x‖) := by
    rw [show (fun x : Euclidean 2 =>
        ⨆ t : CircleRelativeBandLocalTime, ENNReal.ofReal ‖F t.1 x‖) =
        ⨆ t : CircleRelativeBandLocalTime,
          fun x : Euclidean 2 => ENNReal.ofReal ‖F t.1 x‖ by
          funext x
          exact (iSup_apply
            (f := fun t : CircleRelativeBandLocalTime =>
              fun x : Euclidean 2 => ENNReal.ofReal ‖F t.1 x‖) (a := x)).symm]
    exact hG
  rw [show circleRelativeBandFatUnitSlabMaximal C j f =
      (fun x : Euclidean 2 =>
        ⨆ t : CircleRelativeBandLocalTime, ENNReal.ofReal ‖F t.1 x‖) by
        funext x
        unfold circleRelativeBandFatUnitSlabMaximal
        apply iSup_congr
        intro t
        rw [aux_circleRelativeBandFatUnitSlabOutput_eq_highOutput C j hj t f x]]
  exact hmeas

private theorem aux_lintegral_circleRelativeBandFatUnitSlabMaximal_pow_four_le_highPacket
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (hj : 2 ≤ j) (f : SchwartzMap (Euclidean 2) Complex)
    (hS : MemLp (aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f) 4 volume) :
    (∫⁻ x : Euclidean 2, (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
      ENNReal.ofReal
        (‖((surfaceMass 2 : Real) : Complex)‖ ^ (4 : Nat) *
          ∫ x : Euclidean 2,
            ‖aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f x‖ ^ (4 : Nat)) := by
  let S : Euclidean 2 → Real :=
    aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f
  let m : Real := ‖((surfaceMass 2 : Real) : Complex)‖
  have hm : 0 ≤ m := norm_nonneg _
  have hSnonneg (x : Euclidean 2) : 0 ≤ S x := by
    simpa only [S] using
      aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum_nonneg C j f x
  have hmulmem : MemLp (fun x : Euclidean 2 => m * S x) 4 volume := by
    exact hS.const_mul m
  have hmulint : Integrable (fun x : Euclidean 2 => (m * S x) ^ (4 : Nat)) volume := by
    convert hmulmem.integrable_norm_pow (by norm_num) using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg hm (hSnonneg x))]
  have hmulnonneg : ∀ᵐ x : Euclidean 2 ∂volume,
      0 ≤ (m * S x) ^ (4 : Nat) :=
    Filter.Eventually.of_forall fun x => pow_nonneg (mul_nonneg hm (hSnonneg x)) _
  have hpoint (x : Euclidean 2) :
      (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat) ≤
        ENNReal.ofReal ((m * S x) ^ (4 : Nat)) := by
    calc
      (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat) ≤
          (ENNReal.ofReal (m * S x)) ^ (4 : Nat) :=
        pow_le_pow_left'
          (by simpa only [m, S] using
            aux_circleRelativeBandFatUnitSlabMaximal_le_highPacket C j hj f x) 4
      _ = ENNReal.ofReal ((m * S x) ^ (4 : Nat)) :=
        (ENNReal.ofReal_pow (mul_nonneg hm (hSnonneg x)) 4).symm
  calc
    (∫⁻ x : Euclidean 2, (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
        ∫⁻ x : Euclidean 2, ENNReal.ofReal ((m * S x) ^ (4 : Nat)) :=
      lintegral_mono hpoint
    _ = ENNReal.ofReal (∫ x : Euclidean 2, (m * S x) ^ (4 : Nat)) :=
      (ofReal_integral_eq_lintegral_ofReal hmulint hmulnonneg).symm
    _ = ENNReal.ofReal
        (m ^ (4 : Nat) * ∫ x : Euclidean 2, ‖S x‖ ^ (4 : Nat)) := by
      congr 1
      calc
        (∫ x : Euclidean 2, (m * S x) ^ (4 : Nat)) =
            ∫ x : Euclidean 2, m ^ (4 : Nat) * ‖S x‖ ^ (4 : Nat) := by
              apply integral_congr_ae
              filter_upwards with x
              rw [mul_pow, Real.norm_eq_abs, abs_of_nonneg (hSnonneg x)]
        _ = m ^ (4 : Nat) * ∫ x : Euclidean 2, ‖S x‖ ^ (4 : Nat) :=
          by rw [integral_const_mul]
    _ = ENNReal.ofReal
        (‖((surfaceMass 2 : Real) : Complex)‖ ^ (4 : Nat) *
          ∫ x : Euclidean 2,
            ‖aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j f x‖ ^ (4 : Nat)) := by
      rfl

private theorem aux_exists_high_circleRelativeBandFatUnitSlab_fourth_moment
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat), 3 ≤ j →
      ∀ f : SchwartzMap (Euclidean 2) Complex,
        Measurable (circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) ≤
          ENNReal.ofReal
            (A * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
              (4 * min ρ ((3 : Real) / 4)) *
              ∫ x : Euclidean 2,
                ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
  obtain ⟨K, hK, hpacket⟩ :=
    aux_exists_memLp_and_eLpNorm_circleRelativeBandFatUnitSlabHighPacketMaximalSum
      C hgain
  let m : Real := ‖((surfaceMass 2 : Real) : Complex)‖
  let A : Real := m ^ (4 : Nat) * K ^ (4 : Nat)
  have hm : 0 < m := by
    dsimp [m]
    apply norm_pos_iff.mpr
    exact_mod_cast surfaceMass_ne_zero (by norm_num : 0 < 2)
  have hA : 0 < A := by
    dsimp [A]
    positivity
  refine ⟨A, hA, ?_⟩
  intro j hj f
  let P : SchwartzMap (Euclidean 2) Complex :=
    aux_circleRelativeBandFatInputProjectionSchwartz C j f
  let S : Euclidean 2 → Real :=
    aux_circleRelativeBandFatUnitSlabHighPacketMaximalSum C j P
  let δ : Real := _root_.Auto.Spherical.MSS.dyadicTimeScale j
  let β : Real := min ρ ((3 : Real) / 4)
  let E : Real := ∫ x : Euclidean 2, ‖P x‖ ^ (4 : Nat)
  let B : Real := K * δ ^ β * E ^ ((4 : Real)⁻¹)
  have hδ : 0 < δ := by
    dsimp [δ, _root_.Auto.Spherical.MSS.dyadicTimeScale]
    exact zpow_pos (by norm_num) _
  have hE : 0 ≤ E := by
    dsimp [E]
    exact integral_nonneg fun _ => pow_nonneg (norm_nonneg _) _
  have hB : 0 ≤ B := by
    dsimp [B]
    positivity
  have hpacket' := hpacket j hj P
  have hpacketBound : eLpNorm S 4 volume ≤ ENNReal.ofReal B := by
    simpa only [S, B, δ, β, E] using hpacket'.2
  have hSpow : (∫ x : Euclidean 2, ‖S x‖ ^ (4 : Nat)) ≤ B ^ (4 : Nat) := by
    exact aux_integral_norm_pow_four_le_of_eLpNorm_le
      (by simpa only [S] using hpacket'.1) hB hpacketBound
  have hmaxeq (x : Euclidean 2) :
      circleRelativeBandFatUnitSlabMaximal C j f x =
        circleRelativeBandFatUnitSlabMaximal C j P x := by
    unfold circleRelativeBandFatUnitSlabMaximal
    apply iSup_congr
    intro t
    rw [aux_circleRelativeBandFatUnitSlabOutput_eq_projectedInput C j t f x]
  refine ⟨aux_measurable_circleRelativeBandFatUnitSlabMaximal_of_two_le C j
    (le_trans (by norm_num : (2 : Nat) ≤ 3) hj) f, ?_⟩
  have hpacketMoment :=
    aux_lintegral_circleRelativeBandFatUnitSlabMaximal_pow_four_le_highPacket
      C j (le_trans (by norm_num : (2 : Nat) ≤ 3) hj) P
      (by simpa only [S] using hpacket'.1)
  have hEr : (E ^ ((4 : Real)⁻¹)) ^ (4 : Nat) = E := by
    simpa using Real.rpow_inv_natCast_pow hE (by norm_num : (4 : Nat) ≠ 0)
  have hδr : (δ ^ β) ^ (4 : Nat) = δ ^ (4 * β) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hδ.le]
    congr 1
    ring
  have hIeq : E = ∫ x : Euclidean 2,
      ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat) := by
    dsimp [E]
    apply integral_congr_ae
    filter_upwards with x
    rw [show P x = circleRelativeBandFatInputProjection C j f x by
      exact aux_circleRelativeBandFatInputProjectionSchwartz_apply C j f x]
  calc
    (∫⁻ x : Euclidean 2,
        (circleRelativeBandFatUnitSlabMaximal C j f x) ^ (4 : Nat)) =
        ∫⁻ x : Euclidean 2,
          (circleRelativeBandFatUnitSlabMaximal C j P x) ^ (4 : Nat) := by
            apply lintegral_congr
            intro x
            rw [hmaxeq x]
    _ ≤ ENNReal.ofReal (m ^ (4 : Nat) * ∫ x : Euclidean 2,
        ‖S x‖ ^ (4 : Nat)) := by
          simpa only [m, S] using hpacketMoment
    _ ≤ ENNReal.ofReal (m ^ (4 : Nat) * B ^ (4 : Nat)) := by
          exact ENNReal.ofReal_le_ofReal
            (mul_le_mul_of_nonneg_left hSpow (pow_nonneg hm.le _))
    _ = ENNReal.ofReal
        (A * δ ^ (4 * β) * E) := by
          congr 1
          dsimp [A, B]
          calc
            m ^ (4 : Nat) * (K * δ ^ β * E ^ ((4 : Real)⁻¹)) ^ (4 : Nat) =
                (m ^ (4 : Nat) * K ^ (4 : Nat)) *
                  (δ ^ β) ^ (4 : Nat) * (E ^ ((4 : Real)⁻¹)) ^ (4 : Nat) := by ring
            _ = (m ^ (4 : Nat) * K ^ (4 : Nat)) * δ ^ (4 * β) * E := by
              rw [hδr, hEr]
    _ = ENNReal.ofReal
        (A * (_root_.Auto.Spherical.MSS.dyadicTimeScale j) ^
          (4 * min ρ ((3 : Real) / 4)) *
          ∫ x : Euclidean 2,
            ‖circleRelativeBandFatInputProjection C j f x‖ ^ (4 : Nat)) := by
          dsimp only [δ, β]
          rw [hIeq]

/-! ### Finite low-relative-scale compact multiplier fallback -/

/-- Joint normalized symbol for the finitely many low relative scales.  The
ordinary frequency dilation is placed in the relative multiplier scale, so
the compact symbol itself always lives on the fixed annulus. -/
private noncomputable def aux_circleRelativeBandFatLowSymbolJoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) (j : Nat) :
    Real × Euclidean 2 → Complex := fun z =>
  circleRelativeBandFatUnitJoint C z *
    surfaceFourier 2 (-(z.1 * (2 : Real) ^ j) • z.2)

private theorem aux_contDiff_circleRelativeBandFatLowSymbolJoint
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j n : Nat) :
    ContDiff Real n (aux_circleRelativeBandFatLowSymbolJoint C j) := by
  unfold aux_circleRelativeBandFatLowSymbolJoint
  apply ContDiff.mul
  · exact circleRelativeBandFatUnitJoint_contDiff C n
  · have harg : ContDiff Real (↑(⊤ : ℕ∞)) (fun z : Real × Euclidean 2 =>
        -(z.1 * (2 : Real) ^ j) • z.2) := by
      fun_prop
    exact ((contDiff_surfaceFourier 2).comp harg).of_le
      (show (↑(n : ℕ∞) : WithTop ℕ∞) ≤ (↑(⊤ : ℕ∞) : WithTop ℕ∞) from
        WithTop.coe_le_coe.mpr le_top)

private noncomputable def aux_circleRelativeBandFatLowSymbolFun
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : CircleRelativeBandLocalTime) : Euclidean 2 → Complex := fun eta =>
