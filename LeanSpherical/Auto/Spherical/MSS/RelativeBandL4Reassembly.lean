  have h := aux_integrable_norm_pow_four_of_schwartz
    (aux_integerDyadicProjectionSchwartz C n f)
  convert h using 1
  funext x
  rw [aux_integerDyadicProjectionSchwartz_apply]

private theorem aux_integrable_finiteIntegerDyadicSquareEnergy_sq
    {d : Nat} (C : lpCutoffs d) (T : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) :
    Integrable (fun x : Euclidean d =>
      (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)) volume := by
  classical
  let q : Int → SchwartzMap (Euclidean d) Complex := fun n =>
    aux_integerDyadicProjectionSchwartz C n f
  have hq (n : Int) (x : Euclidean d) :
      q n x = integerDyadicProjection C.cutoff n f x := by
    exact aux_integerDyadicProjectionSchwartz_apply C n f x
  have hq4 (n : Int) (hn : n ∈ T) :
      Integrable (fun x : Euclidean d =>
        ‖integerDyadicProjection C.cutoff n f x‖ ^ (4 : Nat)) volume :=
    aux_integrable_norm_pow_four_integerDyadicProjection C n f
  have hsum : Integrable (fun x : Euclidean d =>
      ∑ n ∈ T, ‖integerDyadicProjection C.cutoff n f x‖ ^ (4 : Nat)) volume :=
    integrable_finsetSum T hq4
  have hmajor : Integrable (fun x : Euclidean d =>
      (T.card : Real) *
        ∑ n ∈ T, ‖integerDyadicProjection C.cutoff n f x‖ ^ (4 : Nat)) volume :=
    hsum.const_mul _
  have hcont : Continuous (fun x : Euclidean d =>
      (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)) := by
    have heq : (fun x : Euclidean d =>
        (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)) =
        (fun x : Euclidean d =>
          (∑ n ∈ T, ‖q n x‖ ^ (2 : Nat)) ^ (2 : Nat)) := by
      funext x
      simp only [finiteIntegerDyadicSquareEnergy, finiteSquareEnergy]
      apply congrArg (fun u : Real => u ^ (2 : Nat))
      apply Finset.sum_congr rfl
      intro n hn
      rw [hq]
    rw [heq]
    fun_prop
  apply hmajor.mono'
  · exact hcont.aestronglyMeasurable
  · filter_upwards with x
    rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
    simpa only [finiteIntegerDyadicSquareEnergy] using
      finiteSquareEnergy_sq_le_card_mul_sum_norm_four T
        (fun n => integerDyadicProjection C.cutoff n f) x

private theorem aux_shiftedFatMultiplier_dilate_eq_fat
    {d : Nat} (C : lpCutoffs d) (j : Nat) (k : Int) (eta : Euclidean d) :
    shiftedFatMultiplier C.cutoff j k (((2 : Real) ^ k)⁻¹ • eta) =
      fatDyadicBandpassMultiplier C j eta := by
  have hscale (n : Int) :
      ((2 : Real) ^ (n - k))⁻¹ * ((2 : Real) ^ k)⁻¹ =
        ((2 : Real) ^ n)⁻¹ := by
    rw [← mul_inv_rev]
    rw [← zpow_add₀ (by norm_num : (2 : Real) ≠ 0)]
    have hindex : k + (n - k) = n := by omega
    rw [hindex]
  rw [shiftedFatMultiplier_apply, fatDyadicBandpassMultiplier,
    shiftedFatMultiplier_apply]
  simp only [sub_zero]
  congr 1
  · rw [smul_smul, hscale ((j : Int) + 3)]
  · rw [smul_smul, hscale ((j : Int) - 2)]

/-! A finite family of shifted fat multipliers has a fourth-moment
square-function bound with a cardinality-free constant.  Each multiplier is
five adjacent homogeneous projections, and a fixed projection occurs in at
most five blocks. -/
private theorem aux_sum_norm_four_shiftedFatProjection_le
    {d : Nat} (C : lpCutoffs d) (j : Nat) (K : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) (x : Euclidean d) :
    (∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
        (4 : Nat)) ≤
      625 *
        (finiteIntegerDyadicSquareEnergy C
          ((K.product (Finset.range 5)).image
            (fun p : Int × Nat => (j : Int) - 2 - p.1 + (p.2 : Int))) f x) ^
          (2 : Nat) := by
  classical
  let a : Int := (j : Int) - 2
  let T : Finset Int := (K.product (Finset.range 5)).image
    (fun p : Int × Nat => a - p.1 + (p.2 : Int))
  let e : Int → Real := fun n => ‖integerDyadicProjection C.cutoff n f x‖ ^ (2 : Nat)
  let S : Int → Real := fun k =>
    ∑ i ∈ Finset.range 5, e (a - k + (i : Int))
  change (∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
    shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
      (4 : Nat)) ≤
    625 * (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)
  have he (n : Int) : 0 ≤ e n := by
    dsimp only [e]
    positivity
  have hS_nonneg (k : Int) : 0 ≤ S k := by
    dsimp only [S]
    exact Finset.sum_nonneg fun i hi => he _
  have hterm (k : Int) :
      ‖𝓕⁻ (fun xi : Euclidean d =>
        shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
          (4 : Nat) ≤ 25 * (S k) ^ (2 : Nat) := by
    rw [aux_fourierInv_shiftedFatMultiplier_eq_sum_five_integerDyadicProjection]
    let z : Nat → Complex := fun i =>
      integerDyadicProjection C.cutoff (a - k + (i : Int)) f x
    change ‖∑ i ∈ Finset.range 5, z i‖ ^ (4 : Nat) ≤ 25 * (S k) ^ (2 : Nat)
    have hnorm : ‖∑ i ∈ Finset.range 5, z i‖ ≤
        ∑ i ∈ Finset.range 5, ‖z i‖ := norm_sum_le _ _
    have hsum_nonneg : 0 ≤ ∑ i ∈ Finset.range 5, ‖z i‖ :=
      Finset.sum_nonneg fun i hi => norm_nonneg _
    have hsq : ‖∑ i ∈ Finset.range 5, z i‖ ^ (2 : Nat) ≤
        (∑ i ∈ Finset.range 5, ‖z i‖) ^ (2 : Nat) :=
      (sq_le_sq₀ (norm_nonneg _) hsum_nonneg).mpr hnorm
    have hcs : (∑ i ∈ Finset.range 5, ‖z i‖) ^ (2 : Nat) ≤
        5 * ∑ i ∈ Finset.range 5, ‖z i‖ ^ (2 : Nat) := by
      simpa using
        (sq_sum_le_card_mul_sum_sq (s := Finset.range 5) (f := fun i => ‖z i‖))
    calc
      ‖∑ i ∈ Finset.range 5, z i‖ ^ (4 : Nat) =
          (‖∑ i ∈ Finset.range 5, z i‖ ^ (2 : Nat)) ^ (2 : Nat) := by ring
      _ ≤ ((∑ i ∈ Finset.range 5, ‖z i‖) ^ (2 : Nat)) ^ (2 : Nat) :=
        pow_le_pow_left₀ (sq_nonneg _) hsq _
      _ ≤ (5 * ∑ i ∈ Finset.range 5, ‖z i‖ ^ (2 : Nat)) ^ (2 : Nat) :=
        pow_le_pow_left₀ (sq_nonneg _) hcs _
      _ = 25 * (S k) ^ (2 : Nat) := by
        dsimp only [S, e, z]
        ring
  have hsum_sq : (∑ k ∈ K, (S k) ^ (2 : Nat)) ≤
      (∑ k ∈ K, S k) ^ (2 : Nat) :=
    Finset.sum_sq_le_sq_sum_of_nonneg fun k hk => hS_nonneg k
  have hoverlap : (∑ k ∈ K, S k) ≤ 5 * ∑ n ∈ T, e n := by
    simpa only [S, T] using aux_sum_five_shifted_windows_le a K e he
  have hoverlap_sq : (∑ k ∈ K, S k) ^ (2 : Nat) ≤
      (5 * ∑ n ∈ T, e n) ^ (2 : Nat) :=
    pow_le_pow_left₀ (Finset.sum_nonneg fun k hk => hS_nonneg k) hoverlap _
  calc
    (∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
        (4 : Nat)) ≤ ∑ k ∈ K, 25 * (S k) ^ (2 : Nat) := by
      apply Finset.sum_le_sum
      intro k hk
      exact hterm k
    _ = 25 * ∑ k ∈ K, (S k) ^ (2 : Nat) := by
      rw [Finset.mul_sum]
    _ ≤ 25 * (∑ k ∈ K, S k) ^ (2 : Nat) :=
      mul_le_mul_of_nonneg_left hsum_sq (by norm_num)
    _ ≤ 25 * (5 * ∑ n ∈ T, e n) ^ (2 : Nat) :=
      mul_le_mul_of_nonneg_left hoverlap_sq (by norm_num)
    _ = 625 * (∑ n ∈ T, e n) ^ (2 : Nat) := by ring
    _ = 625 * (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat) := by
      rfl

private theorem aux_integral_sum_norm_four_shiftedFatProjection_le
    {d : Nat} (C : lpCutoffs d) (j : Nat) (K : Finset Int)
    (f : SchwartzMap (Euclidean d) Complex) :
    (∫ x : Euclidean d, ∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
      (4 : Nat)) ≤
      625 * ∫ x : Euclidean d,
        (finiteIntegerDyadicSquareEnergy C
          ((K.product (Finset.range 5)).image
            (fun p : Int × Nat => (j : Int) - 2 - p.1 + (p.2 : Int))) f x) ^
          (2 : Nat) := by
  classical
  let T : Finset Int := (K.product (Finset.range 5)).image
    (fun p : Int × Nat => (j : Int) - 2 - p.1 + (p.2 : Int))
  change (∫ x : Euclidean d, ∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
    shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
      (4 : Nat)) ≤
    625 * ∫ x : Euclidean d,
      (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)
  have hint : Integrable (fun x : Euclidean d =>
      625 * (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat)) volume :=
    (aux_integrable_finiteIntegerDyadicSquareEnergy_sq C T f).const_mul _
  calc
    (∫ x : Euclidean d, ∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
        (4 : Nat)) ≤
      ∫ x : Euclidean d,
        625 * (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat) := by
          apply integral_mono_of_nonneg
          · exact Filter.Eventually.of_forall fun x =>
              Finset.sum_nonneg fun k hk => pow_nonneg (norm_nonneg _) _
          · exact hint
          · exact Filter.Eventually.of_forall fun x =>
              aux_sum_norm_four_shiftedFatProjection_le C j K f x
    _ = 625 * ∫ x : Euclidean d,
        (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat) := by
      rw [integral_const_mul]

/-- Uniform fourth-moment reassembly for every finite family of shifted fat
annuli. -/
private theorem aux_exists_integral_sum_norm_four_shiftedFatProjection_le
    {d : Nat} [NeZero d] (C : lpCutoffs d) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat) (K : Finset Int)
      (f : SchwartzMap (Euclidean d) Complex),
      (∫ x : Euclidean d, ∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
        shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
          (4 : Nat)) ≤ A * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by
  obtain ⟨A, hA, hLP⟩ :=
    Auto.MikhlinHormander.littlewoodPaley_of_mikhlin C 4 (by norm_num)
  refine ⟨625 * A, mul_pos (by norm_num) hA, ?_⟩
  intro j K f
  let T : Finset Int := (K.product (Finset.range 5)).image
    (fun p : Int × Nat => (j : Int) - 2 - p.1 + (p.2 : Int))
  have hsum := aux_integral_sum_norm_four_shiftedFatProjection_le C j K f
  have henergy := hLP T f
  norm_num [Real.rpow_two] at henergy
  calc
    (∫ x : Euclidean d, ∑ k ∈ K, ‖𝓕⁻ (fun xi : Euclidean d =>
      shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean d → Complex) xi) x‖ ^
        (4 : Nat)) ≤
      625 * ∫ x : Euclidean d,
        (finiteIntegerDyadicSquareEnergy C T f x) ^ (2 : Nat) := by
      simpa only [T] using hsum
    _ ≤ 625 * (A * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat)) := by
      exact mul_le_mul_of_nonneg_left henergy (by norm_num)
    _ = (625 * A) * ∫ x : Euclidean d, ‖f x‖ ^ (4 : Nat) := by ring

private noncomputable def aux_unitFatRelativeBandMax
    (C : lpCutoffs 2) (j : Nat) (g : SchwartzMap (Euclidean 2) Complex)
    (x : Euclidean 2) : ENNReal :=
  ⨆ t : Icc (1 : Real) 2, ENNReal.ofReal
    ‖𝓕⁻ (fun eta : Euclidean 2 =>
      surfaceFourier 2 (-t.1 • eta) *
        (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • eta)) -
          C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • eta))) *
        fatDyadicBandpassMultiplier C j eta * g eta) x‖

private noncomputable def aux_schwartzFrequencyDilation
    (a : Real) (ha : a ≠ 0) (g : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  let A : Euclidean 2 ≃L[Real] Euclidean 2 :=
    ContinuousLinearEquiv.smulLeft (Units.mk0 a⁻¹ (inv_ne_zero ha))
  SchwartzMap.compCLMOfContinuousLinearEquiv Complex A g

private theorem aux_schwartzFrequencyDilation_apply
    (a : Real) (ha : a ≠ 0) (g : SchwartzMap (Euclidean 2) Complex)
    (eta : Euclidean 2) :
    aux_schwartzFrequencyDilation a ha g eta = g (a⁻¹ • eta) := by
  simp [aux_schwartzFrequencyDilation]

private noncomputable def aux_blockFrequencyData
    (k : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  aux_schwartzFrequencyDilation ((2 : Real) ^ k)
    (ne_of_gt (zpow_pos (by norm_num) k)) (𝓕 f)

private theorem aux_blockFrequencyData_apply
    (k : Int) (f : SchwartzMap (Euclidean 2) Complex)
    (eta : Euclidean 2) :
    aux_blockFrequencyData k f eta =
      𝓕 (f : Euclidean 2 → Complex) (((2 : Real) ^ k)⁻¹ • eta) := by
  rw [aux_blockFrequencyData, aux_schwartzFrequencyDilation_apply]
  simp only [SchwartzMap.fourier_coe]

private theorem aux_mem_dilateRadiusSet_unit_of_mem_block
    {a r : Real} (ha : 0 < a) (hr : r ∈ Icc a (2 * a)) :
    r ∈ Auto.Spherical.LegendreAssouad.dilateRadiusSet a (Icc (1 : Real) 2) := by
  refine ⟨a⁻¹ * r, ?_, ?_⟩
  · constructor
    · calc
        1 = a⁻¹ * a := (inv_mul_cancel₀ ha.ne').symm
        _ ≤ a⁻¹ * r :=
          mul_le_mul_of_nonneg_left hr.1 (inv_nonneg.mpr ha.le)
    · calc
        a⁻¹ * r ≤ a⁻¹ * (2 * a) :=
          mul_le_mul_of_nonneg_left hr.2 (inv_nonneg.mpr ha.le)
        _ = 2 := by field_simp
  · field_simp

private theorem aux_restrictedRelativeBandpass_block_eq_shiftedFat
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2
      (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x =
      ⨆ r : ↥(Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k) ∩ Ioi (0 : Real)),
        ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
          surfaceFourier 2 (-r.1 • xi) *
            (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
            shiftedFatMultiplier C.cutoff j k xi *
            𝓕 (f : Euclidean 2 → Complex) xi) x‖ := by
  unfold restrictedRelativeBandpassSphericalMaximal
  apply iSup_congr
  intro r
  congr 2
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  have hrblock : r.1 ∈ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)) := by
    constructor
    · exact r.2.1.1
    · calc
        r.1 ≤ 2 * (2 : Real) ^ k := r.2.1.2
        _ = (2 : Real) ^ (k + 1) := by
          rw [zpow_add₀ (by norm_num : (2 : Real) ≠ 0)]
          ring
  have h := relative_dyadic_bandpass_mul_fat_cutoff
    (phi := C.cutoff) C.cutoff_one C.cutoff_zero (j := j) (k := k)
      (r := r.1) hrblock xi (surfaceFourier 2 (-r.1 • xi))
      (𝓕 (f : Euclidean 2 → Complex))
  simpa only [shiftedFatMultiplier_apply] using h

private theorem aux_restrictedRelativeBandpass_block_le_unitFat_dilate
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    restrictedRelativeBandpassSphericalMaximal 2
      (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x ≤
      ENNReal.ofReal ((((2 : Real) ^ k)⁻¹) ^ (2 : Nat)) *
        aux_unitFatRelativeBandMax C j (aux_blockFrequencyData k f)
          (((2 : Real) ^ k)⁻¹ • x) := by
  classical
  let a : Real := (2 : Real) ^ k
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  rw [aux_restrictedRelativeBandpass_block_eq_shiftedFat]
  have hblock_to_dilate :
      (⨆ r : ↥(Icc a (2 * a) ∩ Ioi (0 : Real)), ENNReal.ofReal
        ‖𝓕⁻ (fun xi : Euclidean 2 =>
          surfaceFourier 2 (-r.1 • xi) *
            (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
              C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
            shiftedFatMultiplier C.cutoff j k xi *
            𝓕 (f : Euclidean 2 → Complex) xi) x‖) ≤
        (⨆ r : ↥(Auto.Spherical.LegendreAssouad.dilateRadiusSet a (Icc (1 : Real) 2) ∩ Ioi
            (0 : Real)),
          ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              (shiftedFatMultiplier C.cutoff j k xi *
                𝓕 (f : Euclidean 2 → Complex) xi)) x‖) := by
    apply iSup_le
    intro r
    let r' : ↥(Auto.Spherical.LegendreAssouad.dilateRadiusSet a (Icc (1 : Real) 2) ∩ Ioi
        (0 : Real)) :=
      ⟨r.1, ⟨aux_mem_dilateRadiusSet_unit_of_mem_block ha r.2.1, r.2.2⟩⟩
    simpa only [r', mul_assoc] using
      (le_iSup (fun s :
          ↥(Auto.Spherical.LegendreAssouad.dilateRadiusSet a (Icc (1 : Real) 2) ∩ Ioi (0 : Real)) =>
        ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
          surfaceFourier 2 (-s.1 • xi) *
            (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (s.1 • xi)) -
              C.cutoff (((2 : Real) ^ j)⁻¹ • (s.1 • xi))) *
            (shiftedFatMultiplier C.cutoff j k xi *
              𝓕 (f : Euclidean 2 → Complex) xi)) x‖) r')
  have hdilate := iSup_relative_dyadic_bandpass_multiplier_dilate_le
    a ha (Icc (1 : Real) 2) C.cutoff j
      (fun xi : Euclidean 2 =>
        shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean 2 → Complex) xi) x
  have hunit :
      (⨆ s : ↥(Icc (1 : Real) 2 ∩ Ioi (0 : Real)), ENNReal.ofReal
        ‖𝓕⁻ (fun eta : Euclidean 2 =>
          surfaceFourier 2 (-s.1 • eta) *
            (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (s.1 • eta)) -
              C.cutoff (((2 : Real) ^ j)⁻¹ • (s.1 • eta))) *
            (shiftedFatMultiplier C.cutoff j k (a⁻¹ • eta) *
              𝓕 (f : Euclidean 2 → Complex) (a⁻¹ • eta)))
            (a⁻¹ • x)‖) =
        aux_unitFatRelativeBandMax C j (aux_blockFrequencyData k f) (a⁻¹ • x) := by
    have htime : Icc (1 : Real) 2 ∩ Ioi (0 : Real) = Icc (1 : Real) 2 := by
      ext t
      constructor
      · intro ht
        exact ht.1
      · intro ht
        exact ⟨ht, lt_of_lt_of_le (by norm_num) ht.1⟩
    rw [htime]
    unfold aux_unitFatRelativeBandMax
    apply iSup_congr
    intro s
    congr 2
    apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h (a⁻¹ • x))
    funext eta
    dsimp only [a]
    rw [aux_shiftedFatMultiplier_dilate_eq_fat,
      aux_blockFrequencyData_apply]
    ring
  calc
    (⨆ r : ↥(Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k) ∩ Ioi (0 : Real)),
      ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
        surfaceFourier 2 (-r.1 • xi) *
          (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
          shiftedFatMultiplier C.cutoff j k xi *
          𝓕 (f : Euclidean 2 → Complex) xi) x‖) =
        (⨆ r : ↥(Icc a (2 * a) ∩ Ioi (0 : Real)), ENNReal.ofReal
          ‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              shiftedFatMultiplier C.cutoff j k xi *
              𝓕 (f : Euclidean 2 → Complex) xi) x‖) := by rfl
    _ ≤ (⨆ r : ↥(Auto.Spherical.LegendreAssouad.dilateRadiusSet a (Icc (1 : Real) 2) ∩ Ioi
        (0 : Real)),
      ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
        surfaceFourier 2 (-r.1 • xi) *
          (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
            C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
          (shiftedFatMultiplier C.cutoff j k xi *
            𝓕 (f : Euclidean 2 → Complex) xi)) x‖) := hblock_to_dilate
    _ ≤ ENNReal.ofReal ((a⁻¹) ^ Module.finrank Real (Euclidean 2)) *
        (⨆ s : ↥(Icc (1 : Real) 2 ∩ Ioi (0 : Real)), ENNReal.ofReal
          ‖𝓕⁻ (fun eta : Euclidean 2 =>
            surfaceFourier 2 (-s.1 • eta) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (s.1 • eta)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (s.1 • eta))) *
              (shiftedFatMultiplier C.cutoff j k (a⁻¹ • eta) *
                𝓕 (f : Euclidean 2 → Complex) (a⁻¹ • eta)))
              (a⁻¹ • x)‖) := by
          simpa only [mul_assoc] using hdilate
    _ = ENNReal.ofReal ((((2 : Real) ^ k)⁻¹) ^ (2 : Nat)) *
        aux_unitFatRelativeBandMax C j (aux_blockFrequencyData k f)
          (((2 : Real) ^ k)⁻¹ • x) := by
      rw [hunit]
      simp only [a, finrank_euclideanSpace_fin]

private theorem aux_lintegral_scaled_comp_smul_four
    (V : Euclidean 2 → ENNReal) (hV : Measurable V)
    (hVfinite : (∫⁻ x : Euclidean 2, V x) ≠ ∞) {R q : Real}
    (hR : 0 < R) (hq : q = R ^ (2 : Nat)) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (4 : Nat)) * V (R • x)) =
      ENNReal.ofReal (q ^ (3 : Nat)) * ∫⁻ x : Euclidean 2, V x := by
  have hqnonneg : 0 ≤ q := by
    rw [hq]
    positivity
  have hVae : ∀ᵐ x : Euclidean 2 ∂volume, V x ≠ ∞ := by
    filter_upwards [ae_lt_top hV hVfinite] with x hx
    exact hx.ne
  have hVint : Integrable (fun x : Euclidean 2 => (V x).toReal) volume :=
    integrable_toReal_of_lintegral_ne_top hV.aemeasurable hVfinite
  have hVnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ (V x).toReal :=
    Filter.Eventually.of_forall fun _ => ENNReal.toReal_nonneg
  have hVlin : (∫⁻ x : Euclidean 2, V x) =
      ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) := by
    calc
      (∫⁻ x : Euclidean 2, V x) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (V x).toReal := by
            apply lintegral_congr_ae
            filter_upwards [hVae] with x hx
            exact (ENNReal.ofReal_toReal hx).symm
      _ = ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) :=
        (ofReal_integral_eq_lintegral_ofReal hVint hVnonneg).symm
  have hcompint : Integrable (fun x : Euclidean 2 => (V (R • x)).toReal)
      volume := hVint.comp_smul hR.ne'
  have hcompnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ (V (R • x)).toReal :=
    Filter.Eventually.of_forall fun _ => ENNReal.toReal_nonneg
  have hVcompae : ∀ᵐ x : Euclidean 2 ∂volume, V (R • x) ≠ ∞ :=
    (Measure.quasiMeasurePreserving_smul volume hR.ne').ae hVae
  have hcomplin : (∫⁻ x : Euclidean 2, V (R • x)) =
      ENNReal.ofReal (∫ x : Euclidean 2, (V (R • x)).toReal) := by
    calc
      (∫⁻ x : Euclidean 2, V (R • x)) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (V (R • x)).toReal := by
            apply lintegral_congr_ae
            filter_upwards [hVcompae] with x hx
            exact (ENNReal.ofReal_toReal hx).symm
      _ = ENNReal.ofReal (∫ x : Euclidean 2, (V (R • x)).toReal) :=
        (ofReal_integral_eq_lintegral_ofReal hcompint hcompnonneg).symm
  have hcompint_eq : (∫ x : Euclidean 2, (V (R • x)).toReal) =
      (R ^ (2 : Nat))⁻¹ * ∫ x : Euclidean 2, (V x).toReal := by
    simpa only [finrank_euclideanSpace_fin, smul_eq_mul] using
      (Measure.integral_comp_smul_of_nonneg volume
        (fun x : Euclidean 2 => (V x).toReal) R (hR := hR.le))
  calc
    (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (4 : Nat)) * V (R • x)) =
        ENNReal.ofReal (q ^ (4 : Nat)) * ∫⁻ x : Euclidean 2, V (R • x) :=
      lintegral_const_mul _ (hV.comp
        ((continuous_const : Continuous fun _ : Euclidean 2 => R).smul
          continuous_id).measurable)
    _ = ENNReal.ofReal (q ^ (4 : Nat)) *
        ENNReal.ofReal ((R ^ (2 : Nat))⁻¹ *
          ∫ x : Euclidean 2, (V x).toReal) := by
      rw [hcomplin, hcompint_eq]
    _ = ENNReal.ofReal (q ^ (3 : Nat)) *
        ENNReal.ofReal (∫ x : Euclidean 2, (V x).toReal) := by
      rw [← ENNReal.ofReal_mul (pow_nonneg hqnonneg _)]
      rw [show q ^ (4 : Nat) *
          ((R ^ (2 : Nat))⁻¹ * ∫ x : Euclidean 2, (V x).toReal) =
          (q ^ (4 : Nat) * (R ^ (2 : Nat))⁻¹) *
            ∫ x : Euclidean 2, (V x).toReal by ring]
      rw [ENNReal.ofReal_mul]
      · rw [show q ^ (4 : Nat) * (R ^ (2 : Nat))⁻¹ = q ^ (3 : Nat) by
            rw [hq]
            field_simp [pow_ne_zero _ hR.ne']]
      · positivity
    _ = ENNReal.ofReal (q ^ (3 : Nat)) * ∫⁻ x : Euclidean 2, V x := by
      rw [hVlin]

private noncomputable def aux_unitFatInputProjection
    (C : lpCutoffs 2) (j : Nat) (g : SchwartzMap (Euclidean 2) Complex) :
    Euclidean 2 → Complex := fun x =>
  𝓕⁻ (fun eta : Euclidean 2 => fatDyadicBandpassMultiplier C j eta * g eta) x

private noncomputable def aux_shiftedFatInputProjection
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex := fun x =>
  𝓕⁻ (fun xi : Euclidean 2 =>
    shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean 2 → Complex) xi) x

private theorem aux_unitFatInputProjection_dilate_eq_shiftedFat
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (y : Euclidean 2) :
    aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y =
      (((2 : Real) ^ k) ^ (2 : Nat)) •
        aux_shiftedFatInputProjection C j k f ((2 : Real) ^ k • y) := by
  let a : Real := (2 : Real) ^ k
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  have hfun : (fun eta : Euclidean 2 =>
      fatDyadicBandpassMultiplier C j eta * aux_blockFrequencyData k f eta) =
      fun eta : Euclidean 2 =>
        (shiftedFatMultiplier C.cutoff j k (a⁻¹ • eta) *
          𝓕 (f : Euclidean 2 → Complex) (a⁻¹ • eta)) := by
    funext eta
    dsimp only [a]
    rw [aux_shiftedFatMultiplier_dilate_eq_fat,
      aux_blockFrequencyData_apply]
  unfold aux_unitFatInputProjection aux_shiftedFatInputProjection
  rw [hfun]
  simpa only [a, finrank_euclideanSpace_fin] using
    (_root_.Auto.Spherical.Auxiliary.fourierInv_comp_inv_smul
      (fun xi : Euclidean 2 =>
        shiftedFatMultiplier C.cutoff j k xi * 𝓕 (f : Euclidean 2 → Complex) xi)
      ha y)

private noncomputable def aux_shiftedFatInputProjectionSchwartz
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    SchwartzMap (Euclidean 2) Complex :=
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex
    (shiftedFatMultiplier C.cutoff j k : Euclidean 2 → Complex) (𝓕 f))

private theorem aux_shiftedFatInputProjectionSchwartz_apply
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_shiftedFatInputProjectionSchwartz C j k f x =
      aux_shiftedFatInputProjection C j k f x := by
  unfold aux_shiftedFatInputProjectionSchwartz aux_shiftedFatInputProjection
  rw [SchwartzMap.fourierInv_coe]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (shiftedFatMultiplier C.cutoff j k).hasTemperateGrowth]
  simp only [smul_eq_mul, SchwartzMap.fourier_coe]

private theorem aux_measurable_shiftedFatInputProjection_fourth
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Measurable (fun x : Euclidean 2 => ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) := by
  let P := aux_shiftedFatInputProjectionSchwartz C j k f
  have hP : Continuous (fun x : Euclidean 2 =>
      aux_shiftedFatInputProjection C j k f x) := by
    have hPeq : (fun x : Euclidean 2 =>
        aux_shiftedFatInputProjection C j k f x) = fun x : Euclidean 2 => P x := by
      funext x
      exact (aux_shiftedFatInputProjectionSchwartz_apply C j k f x).symm
    rw [hPeq]
    exact P.continuous
  exact (ENNReal.continuous_ofReal.comp (hP.norm.pow 4)).measurable

private theorem aux_lintegral_shiftedFatInputProjection_fourth_ne_top
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2, ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) ≠ ∞ := by
  let P := aux_shiftedFatInputProjectionSchwartz C j k f
  have hPmem : MemLp P 4 volume := P.memLp 4 volume
  have hPint : Integrable (fun x : Euclidean 2 => ‖P x‖ ^ (4 : Nat)) volume :=
    hPmem.integrable_norm_pow (by norm_num)
  have hPnonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖P x‖ ^ (4 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hlin : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖P x‖ ^ (4 : Nat))) =
      ENNReal.ofReal (∫ x : Euclidean 2, ‖P x‖ ^ (4 : Nat)) :=
    (ofReal_integral_eq_lintegral_ofReal hPint hPnonneg).symm
  rw [show (fun x : Euclidean 2 => ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) =
      fun x : Euclidean 2 => ENNReal.ofReal (‖P x‖ ^ (4 : Nat)) by
        funext x
        rw [show P x = aux_shiftedFatInputProjection C j k f x by
          exact aux_shiftedFatInputProjectionSchwartz_apply C j k f x]]
  rw [hlin]
  exact ENNReal.ofReal_ne_top

private theorem aux_lintegral_unitFatInputProjection_fourth_dilate_eq_shiftedFat
    (C : lpCutoffs 2) (j : Nat) (k : Int)
    (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ y : Euclidean 2, ENNReal.ofReal
      (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
        (4 : Nat))) =
      ENNReal.ofReal ((((2 : Real) ^ k) ^ (2 : Nat)) ^ (3 : Nat)) *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
  let a : Real := (2 : Real) ^ k
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  let V : Euclidean 2 → ENNReal := fun x => ENNReal.ofReal
    (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))
  have hVmeas : Measurable V := by
    simpa only [V] using aux_measurable_shiftedFatInputProjection_fourth C j k f
  have hVfinite : (∫⁻ x : Euclidean 2, V x) ≠ ∞ := by
    simpa only [V] using
      aux_lintegral_shiftedFatInputProjection_fourth_ne_top C j k f
  have hpoint (y : Euclidean 2) :
      ENNReal.ofReal
        (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
          (4 : Nat)) =
        ENNReal.ofReal ((a ^ (2 : Nat)) ^ (4 : Nat)) * V (a • y) := by
    rw [aux_unitFatInputProjection_dilate_eq_shiftedFat]
    change ENNReal.ofReal
        (‖(a ^ (2 : Nat)) • aux_shiftedFatInputProjection C j k f (a • y)‖ ^
          (4 : Nat)) =
        ENNReal.ofReal ((a ^ (2 : Nat)) ^ (4 : Nat)) * V (a • y)
    dsimp only [V]
    rw [norm_smul, Real.norm_eq_abs,
      abs_of_nonneg (pow_nonneg ha.le _), mul_pow]
    rw [ENNReal.ofReal_mul
      (pow_nonneg (pow_nonneg ha.le _) _)]
  calc
    (∫⁻ y : Euclidean 2, ENNReal.ofReal
      (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) y‖ ^
        (4 : Nat))) =
        ∫⁻ y : Euclidean 2, ENNReal.ofReal ((a ^ (2 : Nat)) ^ (4 : Nat)) *
          V (a • y) := by
            apply lintegral_congr
            intro y
            exact hpoint y
    _ = ENNReal.ofReal ((a ^ (2 : Nat)) ^ (3 : Nat)) *
        ∫⁻ x : Euclidean 2, V x :=
      aux_lintegral_scaled_comp_smul_four V hVmeas hVfinite ha rfl
    _ = ENNReal.ofReal ((((2 : Real) ^ k) ^ (2 : Nat)) ^ (3 : Nat)) *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
      rfl

private theorem aux_lintegral_restrictedRelativeBandpass_block_fourth_le_of_unitFat
    (C : lpCutoffs 2) (A theta : ENNReal)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^
          (4 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^
          (4 : Nat)) ≤ A * theta ^ j *
          ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (4 : Nat)))
    (j : Nat) (k : Int) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (4 : Nat)) ≤
      A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
  let a : Real := (2 : Real) ^ k
  let q : Real := (a⁻¹) ^ (2 : Nat)
  have ha : 0 < a := by
    dsimp only [a]
    exact zpow_pos (by norm_num) k
  have hq : 0 ≤ q := by
    dsimp only [q]
    positivity
  let U : Euclidean 2 → ENNReal :=
    aux_unitFatRelativeBandMax C j (aux_blockFrequencyData k f)
  obtain ⟨hUmeas, hUfinite, hUbound⟩ :=
    hunit j (aux_blockFrequencyData k f)
  have hUmeas' : Measurable U := by
    simpa only [U] using hUmeas
  have hUfinite' : (∫⁻ x : Euclidean 2, U x ^ (4 : Nat)) ≠ ∞ := by
    simpa only [U] using hUfinite
  have hUbound' : (∫⁻ x : Euclidean 2, U x ^ (4 : Nat)) ≤
      A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) x‖ ^
          (4 : Nat)) := by
    simpa only [U] using hUbound
  have hpoint (x : Euclidean 2) :
      restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x ≤
        ENNReal.ofReal q * U (a⁻¹ • x) := by
    simpa only [a, q, U] using
      aux_restrictedRelativeBandpass_block_le_unitFat_dilate C j k f x
  have hpow (x : Euclidean 2) :
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (4 : Nat) ≤
        ENNReal.ofReal (q ^ (4 : Nat)) * (U (a⁻¹ • x)) ^ (4 : Nat) := by
    calc
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (4 : Nat) ≤ (ENNReal.ofReal q * U (a⁻¹ • x)) ^ (4 : Nat) :=
        pow_le_pow_left' (hpoint x) _
      _ = ENNReal.ofReal (q ^ (4 : Nat)) * (U (a⁻¹ • x)) ^ (4 : Nat) := by
        rw [mul_pow, ← ENNReal.ofReal_pow hq]
  have hscale :
      (∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (4 : Nat)) *
        (U (a⁻¹ • x)) ^ (4 : Nat)) =
        ENNReal.ofReal (q ^ (3 : Nat)) *
          ∫⁻ x : Euclidean 2, U x ^ (4 : Nat) := by
    exact aux_lintegral_scaled_comp_smul_four
      (fun y : Euclidean 2 => U y ^ (4 : Nat)) (hUmeas'.pow_const 4) hUfinite'
      (inv_pos.mpr ha) rfl
  have hPscale :=
    aux_lintegral_unitFatInputProjection_fourth_dilate_eq_shiftedFat C j k f
  have hcancel : ENNReal.ofReal (q ^ (3 : Nat)) *
      ENNReal.ofReal ((a ^ (2 : Nat)) ^ (3 : Nat)) = 1 := by
    rw [← ENNReal.ofReal_mul (pow_nonneg hq _)]
    rw [show q ^ (3 : Nat) * (a ^ (2 : Nat)) ^ (3 : Nat) = 1 by
      dsimp only [q]
      field_simp [ha.ne']]
    norm_num
  calc
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k)) C.cutoff j f x) ^
          (4 : Nat)) ≤
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (q ^ (4 : Nat)) *
          (U (a⁻¹ • x)) ^ (4 : Nat) := lintegral_mono hpow
    _ = ENNReal.ofReal (q ^ (3 : Nat)) *
        ∫⁻ x : Euclidean 2, U x ^ (4 : Nat) := hscale
    _ ≤ ENNReal.ofReal (q ^ (3 : Nat)) *
        (A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_unitFatInputProjection C j (aux_blockFrequencyData k f) x‖ ^
            (4 : Nat))) :=
      by
        simpa only [mul_comm] using
          (mul_le_mul_left hUbound' (ENNReal.ofReal (q ^ (3 : Nat))))
    _ = A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
      rw [hPscale]
      calc
        ENNReal.ofReal (q ^ (3 : Nat)) *
            (A * theta ^ j *
              (ENNReal.ofReal ((a ^ (2 : Nat)) ^ (3 : Nat)) *
                ∫⁻ x : Euclidean 2, ENNReal.ofReal
                  (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)))) =
            (ENNReal.ofReal (q ^ (3 : Nat)) *
              ENNReal.ofReal ((a ^ (2 : Nat)) ^ (3 : Nat))) *
              (A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
                (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) := by
              ring
        _ = _ := by rw [hcancel, one_mul]

private theorem aux_restrictedRelativeBandpass_pow_four_le_sum_radius_blocks
    (E : Set Real) (K : Finset Int)
    (C : lpCutoffs 2) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (restrictedRelativeBandpassSphericalMaximal 2
      (dyadicRadiusBlockUnion E K) C.cutoff j f x) ^ (4 : Nat) ≤
      ∑ k ∈ K,
        (restrictedRelativeBandpassSphericalMaximal 2
          (E ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1))) C.cutoff j f x) ^
          (4 : Nat) := by
  classical
  by_cases hnonempty : (dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)).Nonempty
  · letI : Nonempty ↥(dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)) :=
      hnonempty.to_subtype
    unfold restrictedRelativeBandpassSphericalMaximal
    rw [ENNReal.iSup_pow]
    apply iSup_le
    intro r
    rw [← ENNReal.ofReal_pow (norm_nonneg _)]
    have hr : r.1 ∈ dyadicRadiusBlockUnion E K := r.2.1
    rcases hr with ⟨hrE, hrBlocks⟩
    rcases Set.mem_iUnion.mp hrBlocks with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hkK, hrBlock⟩
    let k' : {k // k ∈ K} := ⟨k, by simpa only [Finset.mem_coe] using hkK⟩
    let s : ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩
      Ioi (0 : Real)) := ⟨r.1, ⟨⟨hrE, by simpa only [k'] using hrBlock⟩, r.2.2⟩⟩
    have hblock :
        ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ (4 : Nat)) ≤
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) C.cutoff j f x) ^
              (4 : Nat) := by
      rw [ENNReal.ofReal_pow (norm_nonneg _)]
      letI : Nonempty ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩
        Ioi (0 : Real)) := ⟨s⟩
      unfold restrictedRelativeBandpassSphericalMaximal
      rw [ENNReal.iSup_pow]
      simpa only [s] using
        (le_iSup (fun t :
          ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩ Ioi (0 : Real)) =>
            (ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
                surfaceFourier 2 (-t.1 • xi) *
                  (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • xi)) -
                    C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • xi))) *
                  𝓕 (f : Euclidean 2 → Complex) xi) x‖) ^ (4 : Nat)) s)
    calc
      ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ (4 : Nat)) ≤
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) C.cutoff j f x) ^
              (4 : Nat) := hblock
      _ ≤ ∑ ell ∈ K,
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ ell) ((2 : Real) ^ (ell + 1))) C.cutoff j f x) ^
              (4 : Nat) := by
        exact Finset.single_le_sum
          (s := K)
          (f := fun ell =>
            (restrictedRelativeBandpassSphericalMaximal 2
              (E ∩ Icc ((2 : Real) ^ ell) ((2 : Real) ^ (ell + 1))) C.cutoff j f x) ^
                (4 : Nat))
          (by intro ell hell; exact bot_le) k'.2
  · have hempty : dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real) = ∅ :=
      Set.not_nonempty_iff_eq_empty.mp hnonempty
    letI : IsEmpty ↥(dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)) :=
      ⟨fun r => by
        have hr : r.1 ∈ (∅ : Set Real) := by
          rw [← hempty]
          exact r.2
        simp only [Set.mem_empty_iff_false] at hr⟩
    simp [restrictedRelativeBandpassSphericalMaximal]

private theorem aux_exists_lintegral_sum_shiftedFatInputProjection_fourth_le
    (C : lpCutoffs 2) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex),
        (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) ≤
          B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by
  rcases aux_exists_integral_sum_norm_four_shiftedFatProjection_le C with
      ⟨A, hApos, hA⟩
  refine ⟨ENNReal.ofReal A, ENNReal.ofReal_ne_top, ?_⟩
  intro j K f
  let P : Int → Euclidean 2 → Real := fun k x =>
    ‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)
  have hPint (k : Int) (hk : k ∈ K) : Integrable (P k) volume := by
    let Q := aux_shiftedFatInputProjectionSchwartz C j k f
    have hQmem : MemLp Q 4 volume := Q.memLp 4 volume
    have hQint : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ (4 : Nat)) volume :=
      hQmem.integrable_norm_pow (by norm_num)
    simpa only [P, Q, aux_shiftedFatInputProjectionSchwartz_apply] using hQint
  have hsumint : Integrable (fun x : Euclidean 2 => ∑ k ∈ K, P k x) volume :=
    MeasureTheory.integrable_finsetSum K hPint
  have hsum_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ∑ k ∈ K, P k x :=
    Filter.Eventually.of_forall fun x =>
      Finset.sum_nonneg fun k hk => pow_nonneg (norm_nonneg _) _
  have hleft :
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal (P k x)) =
        ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) := by
    calc
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal (P k x)) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (∑ k ∈ K, P k x) := by
            apply lintegral_congr
            intro x
            rw [ENNReal.ofReal_sum_of_nonneg]
            intro k hk
            exact pow_nonneg (norm_nonneg _) _
      _ = ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) :=
        (ofReal_integral_eq_lintegral_ofReal hsumint hsum_nonneg).symm
  have hfint : Integrable (fun x : Euclidean 2 => ‖f x‖ ^ (4 : Nat)) volume :=
    (f.memLp 4 volume).integrable_norm_pow (by norm_num)
  have hf_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖f x‖ ^ (4 : Nat) :=
    Filter.Eventually.of_forall fun x => pow_nonneg (norm_nonneg _) _
  have hright :
      ENNReal.ofReal (∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) =
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) :=
    ofReal_integral_eq_lintegral_ofReal hfint hf_nonneg
  have hreal :
      (∫ x : Euclidean 2, ∑ k ∈ K, P k x) ≤
        A * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat) := by
    simpa only [P, aux_shiftedFatInputProjection] using hA j K f
  calc
    (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) =
        ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) := by
          simpa only [P] using hleft
    _ ≤ ENNReal.ofReal (A * ∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal A *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by
      rw [ENNReal.ofReal_mul hApos.le, hright]

private theorem aux_dyadicRadiusBlock_inter_pos_eq
    (k : Int) :
    Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)) =
      Icc ((2 : Real) ^ k) (2 * (2 : Real) ^ k) := by
  have hpos : 0 < (2 : Real) ^ k := zpow_pos (by norm_num) k
  have hend : (2 : Real) ^ (k + 1) = 2 * (2 : Real) ^ k := by
    rw [zpow_add₀ (by norm_num : (2 : Real) ≠ 0)]
    norm_num
    ring
  ext r
  constructor
  · rintro ⟨hrpos, hrlo, hrhi⟩
    exact ⟨hrlo, by simpa only [hend] using hrhi⟩
  · rintro ⟨hrlo, hrhi⟩
    exact ⟨lt_of_lt_of_le hpos hrlo, hrlo, by simpa only [hend] using hrhi⟩

private theorem aux_lintegral_restrictedRelativeBandpass_finite_blocks_fourth_le
    (C : lpCutoffs 2) (A theta B : ENNReal)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≤
          A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (4 : Nat)))
    (hLP : ∀ (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex),
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) ≤
        B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)))
    (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (dyadicRadiusBlockUnion (Ioi (0 : Real)) K) C.cutoff j f x) ^ (4 : Nat)) ≤
      A * theta ^ j * B *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by
  have hblockmeas (k : Int) :
      Measurable (fun x : Euclidean 2 =>
        (restrictedRelativeBandpassSphericalMaximal 2
          (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
          C.cutoff j f x) ^ (4 : Nat)) :=
    (Auto.Spherical.PowerWeights.measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
        C.cutoff f C.cutoff_one C.cutoff_zero j).pow_const 4
  have hblock (k : Int) :
      (∫⁻ x : Euclidean 2,
        (restrictedRelativeBandpassSphericalMaximal 2
          (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
          C.cutoff j f x) ^ (4 : Nat)) ≤
        A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
    rw [aux_dyadicRadiusBlock_inter_pos_eq k]
    exact aux_lintegral_restrictedRelativeBandpass_block_fourth_le_of_unitFat
      C A theta hunit j k f
  have hPmeas (k : Int) :
      Measurable (fun x : Euclidean 2 => ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) :=
    aux_measurable_shiftedFatInputProjection_fourth C j k f
  calc
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2
        (dyadicRadiusBlockUnion (Ioi (0 : Real)) K) C.cutoff j f x) ^ (4 : Nat)) ≤
        ∫⁻ x : Euclidean 2, ∑ k ∈ K,
          (restrictedRelativeBandpassSphericalMaximal 2
            (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
            C.cutoff j f x) ^ (4 : Nat) :=
      lintegral_mono (fun x =>
        aux_restrictedRelativeBandpass_pow_four_le_sum_radius_blocks
          (Ioi (0 : Real)) K C j f x)
    _ = ∑ k ∈ K, ∫⁻ x : Euclidean 2,
          (restrictedRelativeBandpassSphericalMaximal 2
            (Ioi (0 : Real) ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1)))
            C.cutoff j f x) ^ (4 : Nat) :=
      MeasureTheory.lintegral_finsetSum K (fun k hk => hblockmeas k)
    _ ≤ ∑ k ∈ K, A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) :=
      Finset.sum_le_sum fun k hk => hblock k
    _ = A * theta ^ j * ∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat)) := by
      rw [MeasureTheory.lintegral_finsetSum K (fun k hk => hPmeas k)]
      rw [← Finset.mul_sum]
    _ ≤ A * theta ^ j *
        (B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat))) := by
      gcongr
      exact hLP j K f
    _ = A * theta ^ j * B *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by ring

private theorem aux_lintegral_restrictedRelativeBandpass_all_radius_fourth_le
    (C : lpCutoffs 2) (A theta B : ENNReal)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≤
          A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (4 : Nat)))
    (hLP : ∀ (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex),
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
        (‖aux_shiftedFatInputProjection C j k f x‖ ^ (4 : Nat))) ≤
        B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)))
    (j : Nat) (f : SchwartzMap (Euclidean 2) Complex) :
    (∫⁻ x : Euclidean 2,
      (restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f x) ^
        (4 : Real)) ≤
      A * theta ^ j * B *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by
  apply lintegral_rpow_restrictedRelativeBpSphericalMaximal_of_dyRadBlockExhaustion
      C.cutoff f j (Ioi (0 : Real)) (by intro r hr; exact hr) (by norm_num)
  · intro m
    have hmeas := measurable_restrictedRelativeBandpassSphericalMaximal_global
      (dyadicRadiusBlockExhaustion (Ioi (0 : Real)) m) C.cutoff f
      C.cutoff_one C.cutoff_zero j
    convert hmeas.pow_const 4 using 1 ; norm_num [ENNReal.rpow_natCast]
  · intro m
    convert aux_lintegral_restrictedRelativeBandpass_finite_blocks_fourth_le
        C A theta B hunit hLP j
        (Finset.Icc (-((m : Int))) (m : Int)) f using 1 ;
      norm_num [dyadicRadiusBlockExhaustion, ENNReal.rpow_natCast]

private theorem aux_hasRelativeCircularBandGeometricDecay_four_of_unitFat
    (C : lpCutoffs 2) (A theta : ENNReal)
    (hAtop : A ≠ ∞) (htheta : theta < 1)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (4 : Nat)) ≤
          A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖aux_unitFatInputProjection C j g x‖ ^ (4 : Nat))) :
    Auto.Spherical.MSS.HasRelativeCircularBandGeometricDecay 4 C.cutoff := by
  rcases aux_exists_lintegral_sum_shiftedFatInputProjection_fourth_le C with
    ⟨B, hBtop, hLP⟩
  let rho : ENNReal := theta ^ ((4 : Real)⁻¹)
  let bandConst : ENNReal := (A * B) ^ ((4 : Real)⁻¹)
  refine ⟨bandConst, rho, ?_, ?_, ?_⟩
  · exact ENNReal.rpow_ne_top_of_nonneg (by positivity)
      (ENNReal.mul_ne_top hAtop hBtop)
  · dsimp only [rho]
    exact ENNReal.rpow_lt_one htheta (by positivity)
  · intro j f
    let M : Euclidean 2 → ENNReal :=
      restrictedRelativeBandpassSphericalMaximal 2 (Ioi (0 : Real)) C.cutoff j f
    have hfint : Integrable (fun x : Euclidean 2 => ‖f x‖ ^ (4 : Nat)) volume :=
      (f.memLp 4 volume).integrable_norm_pow (by norm_num)
    have hfMem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
      f.memLp _ volume
    have hf_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖f x‖ ^ (4 : Nat) :=
      Filter.Eventually.of_forall fun x => pow_nonneg (norm_nonneg _) _
    have hIfin :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat))) ≠ ∞ := by
      have hI : (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat))) =
          ENNReal.ofReal (∫ x : Euclidean 2, ‖f x‖ ^ (4 : Nat)) :=
        (ofReal_integral_eq_lintegral_ofReal hfint hf_nonneg).symm
      rw [hI]
      exact ENNReal.ofReal_ne_top
    have htheta_top : theta ≠ ∞ :=
      ne_top_of_le_ne_top ENNReal.one_ne_top (le_of_lt htheta)
    have hAout_top : A * theta ^ j * B ≠ ∞ :=
      ENNReal.mul_ne_top
        (ENNReal.mul_ne_top hAtop (ENNReal.pow_ne_top htheta_top)) hBtop
    have hmoment :
        (∫⁻ x : Euclidean 2, M x ^ (4 : Real)) ≤
          A * theta ^ j * B *
            ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := by
      simpa only [M] using
        aux_lintegral_restrictedRelativeBandpass_all_radius_fourth_le
          C A theta B hunit hLP j f
    have hmoment_fin : (∫⁻ x : Euclidean 2, M x ^ (4 : Real)) ≠ ∞ :=
      ne_top_of_le_ne_top
        (ENNReal.mul_ne_top hAout_top hIfin) hmoment
    have hMmeas : Measurable M := by
      dsimp only [M]
      exact Auto.Spherical.PowerWeights.measurable_restrictedRelativeBandpassSphericalMaximal_global
        (Ioi (0 : Real)) C.cutoff f C.cutoff_one C.cutoff_zero j
    have hMpowmeas : Measurable (fun x : Euclidean 2 => M x ^ (4 : Real)) := by
      convert hMmeas.pow_const 4 using 1 ; norm_num [ENNReal.rpow_natCast]
    have hMfinite : ∀ᵐ x : Euclidean 2 ∂volume, M x ≠ ∞ := by
      filter_upwards [ae_lt_top hMpowmeas hmoment_fin] with x hx
      intro htop
      rw [htop, ENNReal.top_rpow_of_pos (by norm_num : (0 : Real) < 4)] at hx
      exact lt_irrefl _ hx
    have htoRealMoment :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal ((M x).toReal ^ (4 : Real))) =
          ∫⁻ x : Euclidean 2, M x ^ (4 : Real) := by
      apply lintegral_congr_ae
      filter_upwards [hMfinite] with x hx
      calc
        ENNReal.ofReal ((M x).toReal ^ (4 : Real)) =
            ENNReal.ofReal ((M x).toReal ^ (4 : Nat)) := by
              norm_num [Real.rpow_natCast]
        _ = (ENNReal.ofReal ((M x).toReal)) ^ (4 : Nat) := by
              rw [ENNReal.ofReal_pow
                (ENNReal.toReal_nonneg : 0 ≤ (M x).toReal) 4]
        _ = (M x) ^ (4 : Nat) := by rw [ENNReal.ofReal_toReal hx]
        _ = (M x) ^ (4 : Real) := by
              norm_num [ENNReal.rpow_natCast]
    have hinputMoment :
        (∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat))) =
          ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ (4 : Real) := by
      apply lintegral_congr
      intro x
      rw [ENNReal.ofReal_pow (norm_nonneg _) 4]
      norm_num [ENNReal.rpow_natCast]
    have hconvert :=
      memLp_and_eLpNorm_ennreal_of_toReal_lintegral_rpow_le_of_input_measure
          volume volume M hMmeas.aemeasurable hMfinite (by norm_num : (0 : Real) < 4)
          hAout_top (f : Euclidean 2 → Complex) hfMem (by
            calc
              (∫⁻ x : Euclidean 2, ENNReal.ofReal ((M x).toReal ^ (4 : Real))) =
                  ∫⁻ x : Euclidean 2, M x ^ (4 : Real) := htoRealMoment
              _ ≤ A * theta ^ j * B *
                  ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (4 : Nat)) := hmoment
              _ = A * theta ^ j * B *
                  ∫⁻ x : Euclidean 2, (ENNReal.ofReal ‖f x‖) ^ (4 : Real) := by
                    rw [hinputMoment])
    constructor
    · simpa only [M] using hconvert.1
    · have hcoeff : (A * theta ^ j * B) ^ ((4 : Real)⁻¹) =
          bandConst * rho ^ j := by
        dsimp only [bandConst, rho]
        rw [show A * theta ^ j * B = (A * B) * theta ^ j by ring]
        rw [ENNReal.mul_rpow_of_nonneg _ _ (by positivity)]
        congr 1
        calc
          (theta ^ j) ^ ((4 : Real)⁻¹) =
              (theta ^ ((j : Nat) : Real)) ^ ((4 : Real)⁻¹) := by
                rw [ENNReal.rpow_natCast]
          _ = theta ^ (((j : Nat) : Real) * ((4 : Real)⁻¹)) :=
                (ENNReal.rpow_mul theta ((j : Nat) : Real) ((4 : Real)⁻¹)).symm
          _ = theta ^ (((4 : Real)⁻¹) * ((j : Nat) : Real)) := by
                rw [mul_comm]
          _ = (theta ^ ((4 : Real)⁻¹)) ^ ((j : Nat) : Real) :=
                ENNReal.rpow_mul theta ((4 : Real)⁻¹) ((j : Nat) : Real)
          _ = (theta ^ ((4 : Real)⁻¹)) ^ j := by
                rw [ENNReal.rpow_natCast]
      calc
        eLpNorm M (ENNReal.ofReal (4 : Real)) volume ≤
            (A * theta ^ j * B) ^ ((4 : Real)⁻¹) *
              eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
          hconvert.2
        _ = bandConst * rho ^ j *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume := by
              rw [hcoeff]
        _ = bandConst * rho ^ j *
            eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal 4) volume := by norm_num

/-- The frequency-data version used by the dilation proof is literally the
new physical unit-slab maximal function after inverse Fourier packaging. -/
private theorem aux_unitFatRelativeBandMax_eq_circleRelativeBandFatUnitSlabMaximal
    (C : lpCutoffs 2) (j : Nat) (g : SchwartzMap (Euclidean 2) Complex) :
    aux_unitFatRelativeBandMax C j g =
      Auto.Spherical.MSS.circleRelativeBandFatUnitSlabMaximal C j (𝓕⁻ g) := by
  funext x
  unfold aux_unitFatRelativeBandMax
    Auto.Spherical.MSS.circleRelativeBandFatUnitSlabMaximal
    Auto.Spherical.MSS.circleRelativeBandFatUnitSlabOutput
  apply iSup_congr
  intro t
  congr 2
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- The physical fat projection has the same inverse-Fourier packaging. -/
private theorem aux_unitFatInputProjection_eq_circleRelativeBandFatInputProjection
    (C : lpCutoffs 2) (j : Nat) (g : SchwartzMap (Euclidean 2) Complex) :
    aux_unitFatInputProjection C j g =
      Auto.Spherical.MSS.circleRelativeBandFatInputProjection C j (𝓕⁻ g) := by
  funext x
  unfold aux_unitFatInputProjection
    Auto.Spherical.MSS.circleRelativeBandFatInputProjection
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]

/-- Literal all-radius `p = 4` reassembly from a physical moving-fat
unit-slab fourth-moment estimate.  The local hypothesis is stated directly
in terms of the public output and fat-projected physical input. -/
theorem hasRelativeCircularBandGeometricDecay_four_of_circleRelativeBandFatUnitSlab
    (C : lpCutoffs 2) (A theta : ENNReal)
    (hAtop : A ≠ ∞) (htheta : theta < 1)
    (hunit : ∀ (j : Nat) (f : SchwartzMap (Euclidean 2) Complex),
      Measurable (Auto.Spherical.MSS.circleRelativeBandFatUnitSlabMaximal C j f) ∧
        (∫⁻ x : Euclidean 2,
          (Auto.Spherical.MSS.circleRelativeBandFatUnitSlabMaximal C j f x) ^
            (4 : Nat)) ≠ ∞ ∧
        (∫⁻ x : Euclidean 2,
          (Auto.Spherical.MSS.circleRelativeBandFatUnitSlabMaximal C j f x) ^
            (4 : Nat)) ≤
          A * theta ^ j * ∫⁻ x : Euclidean 2, ENNReal.ofReal
            (‖Auto.Spherical.MSS.circleRelativeBandFatInputProjection C j f x‖ ^
              (4 : Nat))) :
    Auto.Spherical.MSS.HasRelativeCircularBandGeometricDecay 4 C.cutoff := by
  apply aux_hasRelativeCircularBandGeometricDecay_four_of_unitFat C A theta hAtop htheta
  intro j g
  have h := hunit j (𝓕⁻ g)
  rw [← aux_unitFatRelativeBandMax_eq_circleRelativeBandFatUnitSlabMaximal C j g,
    ← aux_unitFatInputProjection_eq_circleRelativeBandFatInputProjection C j g] at h
  exact h

/-! ### Moving-fat endpoint packets

The endpoint packet is written with the moving relative multiplier on the
outside of the exact annular endpoint factor.  This is the literal form whose
time derivative has the two expected product-rule terms. -/

noncomputable def aux_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real) :
    Euclidean 2 → Complex :=
  fun xi => ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
    circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
    _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
    _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi

private theorem aux_circleEndpointBandpassMultiplier_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization k)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ k t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi =
      aux_circleEndpointBandpassMultiplier C σ k t xi := by
  unfold aux_circleEndpointBandpassMultiplier
  exact circleAnnularEndpointSchwartzSymbol_factorization C σ k t xi

private noncomputable def aux_circleEndpointSchwartzOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  let b : SchwartzMap (Euclidean 2) Complex :=
    (circleEndpointDyadicNormalization k)⁻¹ • circleAnnularEndpointSchwartzSymbol C σ k t
  𝓕⁻ (SchwartzMap.smulLeftCLM Complex (b : Euclidean 2 → Complex)
    (𝓕 (circleAnnularEndpointHalfWaveOutput C σ k t f)))

private theorem aux_fourier_circleEndpointSchwartzOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    𝓕 (aux_circleEndpointSchwartzOutput C σ k t f : Euclidean 2 → Complex) xi =
      (circleEndpointDyadicNormalization k)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ k t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
        𝓕 (f : Euclidean 2 → Complex) xi := by
  unfold aux_circleEndpointSchwartzOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  rw [SchwartzMap.smulLeftCLM_apply
    (((circleEndpointDyadicNormalization k)⁻¹ •
      circleAnnularEndpointSchwartzSymbol C σ k t).hasTemperateGrowth)]
  simp only [smul_apply, SchwartzMap.fourier_coe, smul_eq_mul]
  rw [circleAnnularEndpointHalfWaveOutput_fourier]
  ring

private theorem aux_circleEndpointSchwartzOutput_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleEndpointSchwartzOutput C σ k t f x =
      circleEndpointWaveContribution C σ k t f x := by
  unfold aux_circleEndpointSchwartzOutput
  rw [SchwartzMap.fourierInv_coe, circleEndpointWaveContribution_factorization]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [SchwartzMap.smulLeftCLM_apply
    (((circleEndpointDyadicNormalization k)⁻¹ •
      circleAnnularEndpointSchwartzSymbol C σ k t).hasTemperateGrowth)]
  simp only [smul_apply, SchwartzMap.fourier_coe, smul_eq_mul]
  rw [circleAnnularEndpointHalfWaveOutput_fourier]
  calc
    (circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointSchwartzSymbol C σ k t xi *
          (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
            𝓕 (f : Euclidean 2 → Complex) xi) =
        ((circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointSchwartzSymbol C σ k t xi *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi) *
            𝓕 (f : Euclidean 2 → Complex) xi := by ring
    _ = aux_circleEndpointBandpassMultiplier C σ k t xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
      rw [aux_circleEndpointBandpassMultiplier_factorization]
    _ = _ := by
      unfold aux_circleEndpointBandpassMultiplier
      ring

/-- The literal moving-fat relative multiplier applied to an endpoint
packet.  The two indices are respectively the moving relative scale and the
ordinary endpoint scale. -/
noncomputable def circleRelativeBandFatEndpointOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
        (((2 : Real) ^ j)⁻¹ • xi) *
      aux_circleEndpointBandpassMultiplier C σ k t xi *
      𝓕 (f : Euclidean 2 → Complex) xi) x

private theorem aux_circleRelativeBandFatEndpointOutput_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatEndpointOutput C j k σ t.1 f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (aux_circleEndpointSchwartzOutput C σ k t.1 f) x := by
  unfold circleRelativeBandFatEndpointOutput
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [aux_circleRelativeBandFatUnitFamily_apply_raw,
    aux_fourier_circleEndpointSchwartzOutput]
  simp only [_root_.Auto.MikhlinHormander.dyadicFrequencyScale]
  calc
    aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleEndpointBandpassMultiplier C σ k t.1 xi *
          𝓕 (f : Euclidean 2 → Complex) xi =
        aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          ((circleEndpointDyadicNormalization k)⁻¹ *
            circleAnnularEndpointSchwartzSymbol C σ k t.1 xi *
            _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi) *
          𝓕 (f : Euclidean 2 → Complex) xi := by
            rw [aux_circleEndpointBandpassMultiplier_factorization]
    _ = _ := by ring

private theorem aux_circleEndpointBandpassMultiplierTimeDerivative_factorization
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (xi : Euclidean 2) :
    (circleEndpointDyadicNormalization k)⁻¹ *
        circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi +
      (circleEndpointDyadicNormalization k)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ k t xi *
        ((((2 : Real) ^ k : Real) : Complex) *
          (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
            circleEndpointTimeDerivativeInputMultiplier C σ k xi)) =
      circleEndpointBandpassMultiplierTimeDerivative C σ k t xi := by
  have hfirst :=
    circleAnnularEndpointTimeDerivativeSchwartzSymbol_factorization C σ k t xi
  have hsecond :=
    circleAnnularEndpointSchwartzSymbol_factorization_timeDerivativeInput C σ k t xi
  unfold circleEndpointBandpassMultiplierTimeDerivative
  calc
    (circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t xi *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi +
        (circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointSchwartzSymbol C σ k t xi *
          ((((2 : Real) ^ k : Real) : Complex) *
            (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
              circleEndpointTimeDerivativeInputMultiplier C σ k xi)) =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi +
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi := by
        rw [hfirst, hsecond]
    _ = _ := by ring

private noncomputable def aux_circleEndpointTimeDerivativeSchwartzOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : SchwartzMap (Euclidean 2) Complex :=
  let U : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t f
  let P : SchwartzMap (Euclidean 2) Complex :=
    circleEndpointTimeDerivativeInput C σ k f
  let V : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ k t P
  let n : Complex := (circleEndpointDyadicNormalization k)⁻¹
  let d : Complex := (((2 : Real) ^ k : Real) : Complex)
  𝓕⁻ (n • SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t :
        Euclidean 2 → Complex) (𝓕 U) +
    (n * d) • SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointSchwartzSymbol C σ k t : Euclidean 2 → Complex) (𝓕 V))

private theorem aux_fourier_circleEndpointTimeDerivativeSchwartzOutput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (xi : Euclidean 2) :
    𝓕 (aux_circleEndpointTimeDerivativeSchwartzOutput C σ k t f :
      Euclidean 2 → Complex) xi =
      (circleEndpointDyadicNormalization k)⁻¹ *
        circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t xi *
        _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
        𝓕 (f : Euclidean 2 → Complex) xi +
      ((circleEndpointDyadicNormalization k)⁻¹ * (((2 : Real) ^ k : Real) : Complex)) *
        circleAnnularEndpointSchwartzSymbol C σ k t xi *
        (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
          circleEndpointTimeDerivativeInputMultiplier C σ k xi *
          𝓕 (f : Euclidean 2 → Complex) xi) := by
  unfold aux_circleEndpointTimeDerivativeSchwartzOutput
  rw [← SchwartzMap.fourier_coe, FourierTransform.fourier_fourierInv_eq]
  simp only [add_apply, smul_apply]
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t).hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C σ k t).hasTemperateGrowth]
  simp only [SchwartzMap.fourier_coe, smul_eq_mul]
  rw [circleAnnularEndpointHalfWaveOutput_fourier,
    circleAnnularEndpointHalfWaveOutput_fourier,
    circleEndpointTimeDerivativeInput_fourier]
  ring

private theorem aux_circleEndpointTimeDerivativeSchwartzOutput_apply
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleEndpointTimeDerivativeSchwartzOutput C σ k t f x =
      circleEndpointWaveContributionTimeDerivative C σ k t f x := by
  unfold aux_circleEndpointTimeDerivativeSchwartzOutput
  rw [SchwartzMap.fourierInv_coe,
    circleEndpointWaveContributionTimeDerivative_eq_fourierInv_multiplier]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  simp only [add_apply, smul_apply]
  rw [SchwartzMap.smulLeftCLM_apply_apply
    (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t).hasTemperateGrowth,
    SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C σ k t).hasTemperateGrowth]
  simp only [SchwartzMap.fourier_coe, smul_eq_mul]
  rw [circleAnnularEndpointHalfWaveOutput_fourier,
    circleAnnularEndpointHalfWaveOutput_fourier,
    circleEndpointTimeDerivativeInput_fourier]
  calc
    (circleEndpointDyadicNormalization k)⁻¹ *
          (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t xi *
            (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
              𝓕 (f : Euclidean 2 → Complex) xi)) +
        (circleEndpointDyadicNormalization k)⁻¹ * (((2 : Real) ^ k : Real) : Complex) *
          (circleAnnularEndpointSchwartzSymbol C σ k t xi *
            (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
              (circleEndpointTimeDerivativeInputMultiplier C σ k xi *
                𝓕 (f : Euclidean 2 → Complex) xi))) =
      (((circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t xi *
          _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi) +
        ((circleEndpointDyadicNormalization k)⁻¹ *
          circleAnnularEndpointSchwartzSymbol C σ k t xi *
          ((((2 : Real) ^ k : Real) : Complex) *
            (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t xi *
              circleEndpointTimeDerivativeInputMultiplier C σ k xi)))) *
        𝓕 (f : Euclidean 2 → Complex) xi := by ring
    _ = (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitudeTimeDerivative σ t xi *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi +
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t xi *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff k xi) *
        𝓕 (f : Euclidean 2 → Complex) xi := by
      rw [circleAnnularEndpointTimeDerivativeSchwartzSymbol_factorization,
        circleAnnularEndpointSchwartzSymbol_factorization_timeDerivativeInput]
    _ = circleEndpointBandpassMultiplierTimeDerivative C σ k t xi *
          𝓕 (f : Euclidean 2 → Complex) xi := by
      rw [show 2 * Real.pi * (t * ‖xi‖) = Real.pi * t * ‖xi‖ * 2 by ring]
      unfold circleEndpointBandpassMultiplierTimeDerivative
      ring

/-- The literal product-rule time derivative of the moving-fat endpoint
packet. -/
private noncomputable def aux_circleRelativeBandFatEndpointOutputTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : Real) (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun xi : Euclidean 2 =>
    (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t
        (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        aux_circleEndpointBandpassMultiplier C σ k t xi +
      aux_circleRelativeBandUnitDifferenceRaw C t (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        circleEndpointBandpassMultiplierTimeDerivative C σ k t xi) *
      𝓕 (f : Euclidean 2 → Complex) xi) x

private theorem aux_circleRelativeBandFatEndpointOutputTimeDerivative_eq_relativeMultiplierAt
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j k : Nat) (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t.1 f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (aux_circleEndpointSchwartzOutput C σ k t.1 f) x +
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)
        (aux_circleEndpointTimeDerivativeSchwartzOutput C σ k t.1 f) x := by
  let E : SchwartzMap (Euclidean 2) Complex := aux_circleEndpointSchwartzOutput C σ k t.1 f
  let D : SchwartzMap (Euclidean 2) Complex :=
    aux_circleEndpointTimeDerivativeSchwartzOutput C σ k t.1 f
  let q₁ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) :
          Euclidean 2 → Complex)
      (𝓕 E)
  let q₂ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) :
          Euclidean 2 → Complex)
      (𝓕 D)
  have hq₁apply (xi : Euclidean 2) : q₁ xi =
      circleRelativeBandFatUnitTimeDerivative C t
          ((_root_.Auto.MikhlinHormander.dyadicFrequencyScale j).1 • xi) *
        𝓕 (E : Euclidean 2 → Complex) xi := by
    dsimp [q₁]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitTimeDerivative C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol_apply]
  have hq₂apply (xi : Euclidean 2) : q₂ xi =
      circleRelativeBandFatUnitFamily C t
          ((_root_.Auto.MikhlinHormander.dyadicFrequencyScale j).1 • xi) *
        𝓕 (D : Euclidean 2 → Complex) xi := by
    dsimp [q₂]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol
        (circleRelativeBandFatUnitFamily C t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j)).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe,
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol_apply]
  have hq₁inv :
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitTimeDerivative C t)
          (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) E x =
        𝓕⁻ (q₁ : Euclidean 2 → Complex) x := by
    rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
    funext xi
    exact (hq₁apply xi).symm
  have hq₂inv :
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (circleRelativeBandFatUnitFamily C t)
          (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) D x =
        𝓕⁻ (q₂ : Euclidean 2 → Complex) x := by
    rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
    apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
    funext xi
    exact (hq₂apply xi).symm
  have hpoint (xi : Euclidean 2) : q₁ xi + q₂ xi =
      (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
          (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleEndpointBandpassMultiplier C σ k t.1 xi +
        aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          circleEndpointBandpassMultiplierTimeDerivative C σ k t.1 xi) *
        𝓕 (f : Euclidean 2 → Complex) xi := by
    have hbase := aux_circleEndpointBandpassMultiplier_factorization C σ k t.1 xi
    have hderiv :=
      aux_circleEndpointBandpassMultiplierTimeDerivative_factorization C σ k t.1 xi
    have hhalf : (2 : Real)⁻¹ = (1 / 2 : Real) := by norm_num
    have hscale : ((2 : Real) ^ j)⁻¹ = (1 / 2 : Real) ^ j := by
      rw [← inv_pow, hhalf]
    calc
      q₁ xi + q₂ xi =
          aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
              ((1 / 2 : Real) ^ j • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              ((1 / 2 : Real) ^ j • xi) *
            ((circleEndpointDyadicNormalization k)⁻¹ *
              circleAnnularEndpointSchwartzSymbol C σ k t.1 xi *
              _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi) *
            𝓕 (f : Euclidean 2 → Complex) xi +
          aux_circleRelativeBandUnitDifferenceRaw C t.1 ((1 / 2 : Real) ^ j • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              ((1 / 2 : Real) ^ j • xi) *
            (((circleEndpointDyadicNormalization k)⁻¹ *
                circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ k t.1 xi *
                _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi +
              (circleEndpointDyadicNormalization k)⁻¹ *
                circleAnnularEndpointSchwartzSymbol C σ k t.1 xi *
                ((((2 : Real) ^ k : Real) : Complex) *
                  (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ k t.1 xi *
                    circleEndpointTimeDerivativeInputMultiplier C σ k xi))) *
              𝓕 (f : Euclidean 2 → Complex) xi) := by
        rw [hq₁apply, hq₂apply, aux_fourier_circleEndpointSchwartzOutput,
          aux_fourier_circleEndpointTimeDerivativeSchwartzOutput,
          aux_circleRelativeBandFatUnitTimeDerivative_apply_raw,
          aux_circleRelativeBandFatUnitFamily_apply_raw]
        simp only [_root_.Auto.MikhlinHormander.dyadicFrequencyScale]
        rw [hscale]
        ring
      _ = aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
              ((1 / 2 : Real) ^ j • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              ((1 / 2 : Real) ^ j • xi) *
            (aux_circleEndpointBandpassMultiplier C σ k t.1 xi *
              𝓕 (f : Euclidean 2 → Complex) xi) +
          aux_circleRelativeBandUnitDifferenceRaw C t.1 ((1 / 2 : Real) ^ j • xi) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              ((1 / 2 : Real) ^ j • xi) *
            (circleEndpointBandpassMultiplierTimeDerivative C σ k t.1 xi *
              𝓕 (f : Euclidean 2 → Complex) xi) := by
        rw [hbase, hderiv]
        ring
      _ = _ := by
        rw [hscale]
        ring
  unfold aux_circleRelativeBandFatEndpointOutputTimeDerivative
  rw [show (fun xi : Euclidean 2 =>
      (aux_circleRelativeBandUnitDifferenceRawTimeDerivative C t.1
          (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleEndpointBandpassMultiplier C σ k t.1 xi +
        aux_circleRelativeBandUnitDifferenceRaw C t.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          circleEndpointBandpassMultiplierTimeDerivative C σ k t.1 xi) *
        𝓕 (f : Euclidean 2 → Complex) xi) =
      (q₁ : Euclidean 2 → Complex) + (q₂ : Euclidean 2 → Complex) by
        funext xi
        exact (hpoint xi).symm]
  rw [fourierInv_add_of_integrable (q₁ : Euclidean 2 → Complex)
    (q₂ : Euclidean 2 → Complex) q₁.integrable q₂.integrable,
    ← hq₁inv, ← hq₂inv]

private theorem aux_hasDerivAt_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) (t : Real)
    (xi : Euclidean 2) :
    HasDerivAt (fun s : Real => aux_circleEndpointBandpassMultiplier C σ k s xi)
      (circleEndpointBandpassMultiplierTimeDerivative C σ k t xi) t := by
  simpa only [aux_circleEndpointBandpassMultiplier] using
    hasDerivAt_circleEndpointBandpassMultiplier C σ k t xi

private theorem aux_continuous_uncurry_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (k : Nat) :
