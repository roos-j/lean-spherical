        (fun t x => aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => circleRelativeBandFatEndpointOutput C j k σ s f x)
        (aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleRelativeBandFatEndpointOutput C j k σ t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    aux_circleRelativeBandFatEndpointOutputTimeDerivative C j k σ t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (k + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (aux_circleRelativeBandUnitDifferenceRaw C q.1 (((2 : Real) ^ j)⁻¹ • xi) *
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • xi) *
        aux_circleEndpointBandpassMultiplier C σ k q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      ((aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1
          (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          aux_circleEndpointBandpassMultiplier C σ k q.1 xi +
        aux_circleRelativeBandUnitDifferenceRaw C q.1 (((2 : Real) ^ j)⁻¹ • xi) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • xi) *
          circleEndpointBandpassMultiplierTimeDerivative C σ k q.1 xi) *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2) *
          _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
            (((2 : Real) ^ j)⁻¹ • q.2) *
          aux_circleEndpointBandpassMultiplier C σ k q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by fun_prop
    have hraw := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw C
    have hendpoint := aux_continuous_uncurry_circleEndpointBandpassMultiplier C σ k
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hendpointpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).continuous.comp
        hscaled
    have hendpoint' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleEndpointBandpassMultiplier C σ k q.1.1 q.2) := by
      change Continuous ((fun p : Real × Euclidean 2 =>
        aux_circleEndpointBandpassMultiplier C σ k p.1 p.2) ∘
          (fun q : (Real × Euclidean 2) × Euclidean 2 => (q.1.1, q.2)))
      exact hendpoint.comp hendpointpair
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (((hraw'.mul hfat).mul hendpoint').mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        ((aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1.1
            (((2 : Real) ^ j)⁻¹ • q.2) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              (((2 : Real) ^ j)⁻¹ • q.2) *
            aux_circleEndpointBandpassMultiplier C σ k q.1.1 q.2 +
          aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2) *
            _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
              (((2 : Real) ^ j)⁻¹ • q.2) *
            circleEndpointBandpassMultiplierTimeDerivative C σ k q.1.1 q.2) *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by fun_prop
    have hraw := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRaw C
    have hrawdot := aux_continuous_uncurry_circleRelativeBandUnitDifferenceRawTimeDerivative C
    have hendpoint := aux_continuous_uncurry_circleEndpointBandpassMultiplier C σ k
    have hendpointdot :=
      aux_continuous_uncurry_circleEndpointBandpassMultiplierTimeDerivative C σ k
    have htime : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 => q.1.1) :=
      continuous_fst.comp continuous_fst
    have hscaled : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹ • q.2) :=
      (continuous_const : Continuous fun _ : (Real × Euclidean 2) × Euclidean 2 =>
        ((2 : Real) ^ j)⁻¹).smul continuous_snd
    have hrawpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, ((2 : Real) ^ j)⁻¹ • q.2)) := htime.prodMk hscaled
    have hendpointpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := htime.prodMk continuous_snd
    have hraw' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRaw C q.1.1 (((2 : Real) ^ j)⁻¹ • q.2)) :=
      hraw.comp hrawpair
    have hrawdot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleRelativeBandUnitDifferenceRawTimeDerivative C q.1.1
          (((2 : Real) ^ j)⁻¹ • q.2)) := hrawdot.comp hrawpair
    have hfat : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff
          (((2 : Real) ^ j)⁻¹ • q.2)) :=
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).continuous.comp
        hscaled
    have hendpoint' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        aux_circleEndpointBandpassMultiplier C σ k q.1.1 q.2) := by
      change Continuous ((fun p : Real × Euclidean 2 =>
        aux_circleEndpointBandpassMultiplier C σ k p.1 p.2) ∘
          (fun q : (Real × Euclidean 2) × Euclidean 2 => (q.1.1, q.2)))
      exact hendpoint.comp hendpointpair
    have hendpointdot' : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ k q.1.1 q.2) := by
      change Continuous ((fun p : Real × Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ k p.1 p.2) ∘
          (fun q : (Real × Euclidean 2) × Euclidean 2 => (q.1.1, q.2)))
      exact hendpointdot.comp hendpointpair
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
