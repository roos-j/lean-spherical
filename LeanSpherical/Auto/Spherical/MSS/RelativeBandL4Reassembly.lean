          (U (a⁻¹ • x)) ^ (2 : Nat) := lintegral_mono hpow
    _ = ENNReal.ofReal q * ∫⁻ x : Euclidean 2, U x ^ (2 : Nat) := hscale
    _ ≤ ENNReal.ofReal q *
        (A * ∫⁻ x : Euclidean 2, ENNReal.ofReal
