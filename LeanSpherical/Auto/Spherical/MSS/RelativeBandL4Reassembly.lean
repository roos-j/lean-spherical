private theorem aux_exists_uniform_norm_iteratedFDeriv_circleRelativeBandFatLowSymbol_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (t : CircleRelativeBandLocalTime) (eta : Euclidean 2),
      ‖iteratedFDeriv Real n
        (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex) eta‖ ≤ B := by
  obtain ⟨B, hB, hjoint⟩ := exists_uniform_spatial_iteratedFDeriv_of_joint n
    (aux_contDiff_circleRelativeBandFatLowSymbolJoint C j n)
  let K : Set (Euclidean 2) :=
    Metric.closedBall 0 (16 : Real) ∩ {eta : Euclidean 2 | (1 / 4 : Real) ≤ ‖eta‖}
  have hKclosed : IsClosed K := by
    dsimp [K]
    apply IsClosed.inter Metric.isClosed_closedBall
    exact isClosed_le continuous_const continuous_norm
  refine ⟨B, hB, ?_⟩
  intro t eta
  have htsupp : tsupport
      (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex) ⊆ K := by
    change closure (Function.support
      (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex)) ⊆ K
    exact closure_minimal
      (aux_circleRelativeBandFatLowSymbol_support_subset_annulus C j t) hKclosed
  by_cases hetaK : eta ∈ K
  · have hfamilyEq :
        (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex) =
          fun y => aux_circleRelativeBandFatLowSymbolJoint C j (t.1, y) := by
      funext y
      exact aux_circleRelativeBandFatLowSymbol_apply_eq_joint C j t y
    rw [hfamilyEq]
    exact hjoint t.1 eta t.2 hetaK.1
  · have hnot : eta ∉ Function.support (iteratedFDeriv Real n
        (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex)) := by
      intro hmem
      exact hetaK (htsupp (support_iteratedFDeriv_subset n hmem))
    have hzero : iteratedFDeriv Real n
        (aux_circleRelativeBandFatLowSymbol C j t : Euclidean 2 → Complex) eta = 0 := by
      by_contra hne
      exact hnot (Function.mem_support.mpr hne)
    rw [hzero]
    simpa using hB

private theorem aux_exists_uniform_norm_iteratedFDeriv_circleRelativeBandFatLowSymbol_fin_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (n : Nat) :
    ∃ B : Real, 0 ≤ B ∧ ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime)
      (eta : Euclidean 2),
      ‖iteratedFDeriv Real n
        (aux_circleRelativeBandFatLowSymbol C a.1 t : Euclidean 2 → Complex) eta‖ ≤ B := by
  choose B hB hderiv using fun a : Fin 3 =>
    aux_exists_uniform_norm_iteratedFDeriv_circleRelativeBandFatLowSymbol_le C a.1 n
  let A : Real := ∑ a : Fin 3, B a
  have hA : 0 ≤ A := by
    dsimp [A]
    exact Finset.sum_nonneg fun a _ => hB a
  refine ⟨A, hA, ?_⟩
  intro a t eta
  calc
    ‖iteratedFDeriv Real n
        (aux_circleRelativeBandFatLowSymbol C a.1 t : Euclidean 2 → Complex) eta‖ ≤ B a :=
      hderiv a t eta
    _ ≤ ∑ b : Fin 3, B b :=
      Finset.single_le_sum (fun b _ => hB b) (Finset.mem_univ a)
    _ = A := rfl

private theorem aux_exists_relativeSchwartzMultiplierKernelSize_finThreeFamily_le
    (S : Fin 3 → CircleRelativeBandLocalTime → SchwartzMap (Euclidean 2) Complex)
    (hsupport : ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime),
      Function.support (S a t : Euclidean 2 → Complex) ⊆ Metric.closedBall 0 (16 : Real))
    (hderivAll : ∀ n : Nat, ∃ B : Real, 0 ≤ B ∧ ∀ (a : Fin 3)
      (t : CircleRelativeBandLocalTime) (eta : Euclidean 2),
      ‖iteratedFDeriv Real n (S a t : Euclidean 2 → Complex) eta‖ ≤ B) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime),
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (S a t) ≤ A := by
  choose B hB hderiv using hderivAll
  let K : Set (Euclidean 2) := Metric.closedBall 0 (16 : Real)
  have hKmeas : MeasurableSet K := measurableSet_closedBall
  have hKfinite : volume K ≠ (⊤ : ENNReal) :=
    ne_of_lt MeasureTheory.measure_closedBall_lt_top
  let A0 : Real := B 0 * (volume K).toReal
  have hA0 : 0 ≤ A0 := mul_nonneg (hB 0) ENNReal.toReal_nonneg
  have hmass : ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime),
      (∫ eta : Euclidean 2, ‖S a t eta‖) ≤ A0 := by
    intro a t
    apply _root_.Auto.MikhlinHormander.integral_norm_le_of_support_subset_of_norm_le
      (S a t : Euclidean 2 → Complex) K hKmeas hKfinite
    · simpa using (S a t).integrable.norm
    · intro eta
      simpa using hderiv 0 a t eta
    · exact hsupport a t
  let A1 : Real := (2 : Real) ^ 4 * ∑ n ∈ Finset.range (4 + 1),
    B n * (volume K).toReal
  have hA1 : 0 ≤ A1 := by
    dsimp [A1]
    apply mul_nonneg (by positivity)
    apply Finset.sum_nonneg
    intro n hn
    exact mul_nonneg (hB n) ENNReal.toReal_nonneg
  have hibp : ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime),
      _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
        (S a t : Euclidean 2 → Complex) ≤ A1 := by
    intro a t
    have hmain :=
      Auto.MikhlinHormander.compactFourierIBPConstant_le_of_support_subset_of_uniform_deriv_bound
        (S a t : Euclidean 2 → Complex) ((S a t).smooth 4)
        (R := (16 : Real)) (hsupport a t) B
        (fun n hn eta => hderiv n a t eta)
    simpa [A1, K] using hmain
  refine ⟨A0 + A1, add_nonneg hA0 hA1, ?_⟩
  intro a t
  calc
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (S a t) ≤
        (∫ eta : Euclidean 2, ‖S a t eta‖) +
          _root_.Auto.MikhlinHormander.compactFourierIBPConstant (N := 4)
            (S a t : Euclidean 2 → Complex) :=
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize_le_compactFourierIBP
        (S a t)
    _ ≤ A0 + A1 := add_le_add (hmass a t) (hibp a t)

private theorem aux_exists_relativeSchwartzMultiplierKernelSize_circleRelativeBandFatLowSymbol_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ A : Real, 0 ≤ A ∧ ∀ (a : Fin 3) (t : CircleRelativeBandLocalTime),
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierKernelSize
        (aux_circleRelativeBandFatLowSymbol C a.1 t) ≤ A := by
  apply aux_exists_relativeSchwartzMultiplierKernelSize_finThreeFamily_le
    (fun a t => aux_circleRelativeBandFatLowSymbol C a.1 t)
  · intro a t
    exact (aux_circleRelativeBandFatLowSymbol_support_subset_annulus C a.1 t).trans
      inter_subset_left
  · intro n
    exact aux_exists_uniform_norm_iteratedFDeriv_circleRelativeBandFatLowSymbol_fin_le C n

private theorem aux_circleRelativeBandFatUnitSlabOutput_eq_relativeMultiplierAt_lowSymbol
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (j : Nat) (t : CircleRelativeBandLocalTime)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    circleRelativeBandFatUnitSlabOutput C j t f x =
      _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleRelativeBandFatLowSymbol C j t)
        (_root_.Auto.MikhlinHormander.dyadicFrequencyScale j) f x := by
  rw [circleRelativeBandFatUnitSlabOutput_eq_compactMultiplier,
    _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt_eq_fourierInv_symbol]
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext xi
  rw [_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierSymbol_apply]
  rw [aux_circleRelativeBandFatLowSymbol_apply,
    aux_circleRelativeBandFatLowSymbolFun]
  simp only [_root_.Auto.MikhlinHormander.dyadicFrequencyScale,
    smul_smul]
  have hpow : (2 : Real) ^ j ≠ 0 := pow_ne_zero _ (by norm_num)
  have hscalar : -(t.1 * (2 : Real) ^ j) * ((2 : Real) ^ j)⁻¹ = -t.1 := by
    field_simp [hpow]
  rw [hscalar]
  ring

private theorem aux_circleRelativeBandFatUnitSlabMaximal_eq_lowSymbolRaw
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
