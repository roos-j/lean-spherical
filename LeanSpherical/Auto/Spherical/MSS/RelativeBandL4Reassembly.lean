private theorem aux_l2_restrictedRelativeBandpass_sq_le_sum_radius_blocks
    (E : Set Real) (K : Finset Int)
    (C : lpCutoffs 2) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    (restrictedRelativeBandpassSphericalMaximal 2
      (dyadicRadiusBlockUnion E K) C.cutoff j f x) ^ (2 : Nat) ≤
      ∑ k ∈ K,
        (restrictedRelativeBandpassSphericalMaximal 2
          (E ∩ Icc ((2 : Real) ^ k) ((2 : Real) ^ (k + 1))) C.cutoff j f x) ^
          (2 : Nat) := by
  classical
  by_cases hnonempty : (dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)).Nonempty
  · letI : Nonempty ↥(dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)) :=
      hnonempty.to_subtype
    unfold restrictedRelativeBandpassSphericalMaximal
    rw [ENNReal.iSup_pow]
    apply iSup_le
    intro r
    rw [← ENNReal.ofReal_pow (norm_nonneg _)]
    have hr : r.1 ∈ dyadicRadiusBlockUnion E K := r.2.1
    rcases hr with ⟨hrE, hrBlocks⟩
    rcases Set.mem_iUnion.mp hrBlocks with ⟨k, hk⟩
    rcases Set.mem_iUnion.mp hk with ⟨hkK, hrBlock⟩
    let k' : {k // k ∈ K} := ⟨k, by simpa only [Finset.mem_coe] using hkK⟩
    let s : ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩
      Ioi (0 : Real)) := ⟨r.1, ⟨⟨hrE, by simpa only [k'] using hrBlock⟩, r.2.2⟩⟩
    have hblock :
        ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ (2 : Nat)) ≤
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) C.cutoff j f x) ^
              (2 : Nat) := by
      rw [ENNReal.ofReal_pow (norm_nonneg _)]
      letI : Nonempty ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩
        Ioi (0 : Real)) := ⟨s⟩
      unfold restrictedRelativeBandpassSphericalMaximal
      rw [ENNReal.iSup_pow]
      simpa only [s] using
        (le_iSup (fun t :
          ↥((E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) ∩
            Ioi (0 : Real)) =>
            (ENNReal.ofReal ‖𝓕⁻ (fun xi : Euclidean 2 =>
              surfaceFourier 2 (-t.1 • xi) *
                (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (t.1 • xi)) -
                  C.cutoff (((2 : Real) ^ j)⁻¹ • (t.1 • xi))) *
                𝓕 (f : Euclidean 2 → Complex) xi) x‖) ^ (2 : Nat)) s)
    calc
      ENNReal.ofReal
          (‖𝓕⁻ (fun xi : Euclidean 2 =>
            surfaceFourier 2 (-r.1 • xi) *
              (C.cutoff (((2 : Real) ^ (j + 1))⁻¹ • (r.1 • xi)) -
                C.cutoff (((2 : Real) ^ j)⁻¹ • (r.1 • xi))) *
              𝓕 (f : Euclidean 2 → Complex) xi) x‖ ^ (2 : Nat)) ≤
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ k'.1) ((2 : Real) ^ (k'.1 + 1))) C.cutoff j f x) ^
              (2 : Nat) := hblock
      _ ≤ ∑ ell ∈ K,
          (restrictedRelativeBandpassSphericalMaximal 2
            (E ∩ Icc ((2 : Real) ^ ell) ((2 : Real) ^ (ell + 1))) C.cutoff j f x) ^
              (2 : Nat) := by
        exact Finset.single_le_sum
          (s := K)
          (f := fun ell =>
            (restrictedRelativeBandpassSphericalMaximal 2
              (E ∩ Icc ((2 : Real) ^ ell) ((2 : Real) ^ (ell + 1))) C.cutoff j f x) ^
                (2 : Nat))
          (by intro ell hell; exact bot_le) k'.2
  · have hempty : dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real) = ∅ :=
      Set.not_nonempty_iff_eq_empty.mp hnonempty
    letI : IsEmpty ↥(dyadicRadiusBlockUnion E K ∩ Ioi (0 : Real)) :=
      ⟨fun r => by
        have hr : r.1 ∈ (∅ : Set Real) := by
          rw [← hempty]
          exact r.2
        simp only [Set.mem_empty_iff_false] at hr⟩
    simp [restrictedRelativeBandpassSphericalMaximal]

private theorem aux_l2_exists_lintegral_sum_shiftedFatInputProjection_sq_le
    (C : lpCutoffs 2) :
    ∃ B : ENNReal, B ≠ ∞ ∧
      ∀ (j : Nat) (K : Finset Int) (f : SchwartzMap (Euclidean 2) Complex),
        (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
          (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) ≤
          B * ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
  refine ⟨ENNReal.ofReal 24, ENNReal.ofReal_ne_top, ?_⟩
  intro j K f
  let P : Int → Euclidean 2 → Real := fun k x =>
    ‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat)
  have hPint (k : Int) (hk : k ∈ K) : Integrable (P k) volume := by
    let Q := aux_shiftedFatInputProjectionSchwartz C j k f
    have hQmem : MemLp Q 2 volume := Q.memLp 2 volume
    have hQint : Integrable (fun x : Euclidean 2 => ‖Q x‖ ^ (2 : Nat)) volume :=
      hQmem.integrable_norm_pow (by norm_num)
    simpa only [P, Q, aux_shiftedFatInputProjectionSchwartz_apply] using hQint
  have hsumint : Integrable (fun x : Euclidean 2 => ∑ k ∈ K, P k x) volume :=
    MeasureTheory.integrable_finsetSum K hPint
  have hsum_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ∑ k ∈ K, P k x :=
    Filter.Eventually.of_forall fun x =>
      Finset.sum_nonneg fun k hk => pow_nonneg (norm_nonneg _) _
  have hleft :
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal (P k x)) =
        ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) := by
    calc
      (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal (P k x)) =
          ∫⁻ x : Euclidean 2, ENNReal.ofReal (∑ k ∈ K, P k x) := by
            apply lintegral_congr
            intro x
            rw [ENNReal.ofReal_sum_of_nonneg]
            intro k hk
            exact pow_nonneg (norm_nonneg _) _
      _ = ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) :=
        (ofReal_integral_eq_lintegral_ofReal hsumint hsum_nonneg).symm
  have hfint : Integrable (fun x : Euclidean 2 => ‖f x‖ ^ (2 : Nat)) volume :=
    (f.memLp 2 volume).integrable_norm_pow (by norm_num)
  have hf_nonneg : ∀ᵐ x : Euclidean 2 ∂volume, 0 ≤ ‖f x‖ ^ (2 : Nat) :=
    Filter.Eventually.of_forall fun _ => pow_nonneg (norm_nonneg _) _
  have hright :
      ENNReal.ofReal (∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) =
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) :=
    ofReal_integral_eq_lintegral_ofReal hfint hf_nonneg
  have hreal :
      (∫ x : Euclidean 2, ∑ k ∈ K, P k x) ≤
        24 * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat) := by
    rw [MeasureTheory.integral_finsetSum K hPint]
    simpa only [P, aux_shiftedFatInputProjection] using
      (shiftedLittlewoodPaleyL2 C j K f)
  calc
    (∫⁻ x : Euclidean 2, ∑ k ∈ K, ENNReal.ofReal
      (‖aux_shiftedFatInputProjection C j k f x‖ ^ (2 : Nat))) =
        ENNReal.ofReal (∫ x : Euclidean 2, ∑ k ∈ K, P k x) := by
          simpa only [P] using hleft
    _ ≤ ENNReal.ofReal (24 * ∫ x : Euclidean 2, ‖f x‖ ^ (2 : Nat)) :=
      ENNReal.ofReal_le_ofReal hreal
    _ = ENNReal.ofReal 24 *
        ∫⁻ x : Euclidean 2, ENNReal.ofReal (‖f x‖ ^ (2 : Nat)) := by
      rw [ENNReal.ofReal_mul (by norm_num : (0 : Real) ≤ 24), hright]

private theorem aux_l2_lintegral_restrictedRelativeBandpass_finite_blocks_sq_le
    (C : lpCutoffs 2) (A B : ENNReal)
    (hunit : ∀ (j : Nat) (g : SchwartzMap (Euclidean 2) Complex),
      Measurable (aux_unitFatRelativeBandMax C j g) ∧
        (∫⁻ x : Euclidean 2, (aux_unitFatRelativeBandMax C j g x) ^ (2 : Nat)) ≠ ∞ ∧
