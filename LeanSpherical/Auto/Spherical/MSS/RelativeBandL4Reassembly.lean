  simpa only [aux_circleEndpointBandpassMultiplier] using
    continuous_uncurry_circleEndpointBandpassMultiplier C σ k

private theorem aux_continuous_uncurry_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
