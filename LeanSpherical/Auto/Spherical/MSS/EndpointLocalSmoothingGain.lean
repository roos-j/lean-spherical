theorem circleAnnularEndpointSchwartzSymbol_factorization_timeDerivativeInput
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (ξ : Euclidean 2) :
    (circleEndpointDyadicNormalization j)⁻¹ *
        circleAnnularEndpointSchwartzSymbol C σ j t ξ *
        ((((2 : Real) ^ j : Real) : Complex) *
          (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
            circleEndpointTimeDerivativeInputMultiplier C σ j ξ)) =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
  rw [circleAnnularEndpointSchwartzSymbol_apply]
  unfold circleAnnularEndpointMultiplier
  have hn : circleEndpointDyadicNormalization j ≠ 0 :=
    circleEndpointDyadicNormalization_ne_zero j
  have hinput : (((2 : Real) ^ j : Real) : Complex) *
      (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
        circleEndpointTimeDerivativeInputMultiplier C σ j ξ) =
      _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
    exact dyadicHalfWaveSymbol_mul_circleEndpointTimeDerivativeInputMultiplier C σ j t ξ
  have hband :
      _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ =
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
    rw [mul_comm]
    exact _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier_mul_fatDyadicBandpassMultiplier C j ξ
  calc
    (circleEndpointDyadicNormalization j)⁻¹ *
        (circleEndpointDyadicNormalization j * ((surfaceMass 2)⁻¹ : Complex) *
          (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
          _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ) *
        ((((2 : Real) ^ j : Real) : Complex) *
          (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
            circleEndpointTimeDerivativeInputMultiplier C σ j ξ)) =
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ *
        ((((2 : Real) ^ j : Real) : Complex) *
          (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
            circleEndpointTimeDerivativeInputMultiplier C σ j ξ)) := by
        field_simp [hn]
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ *
        (_root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ) := by
      rw [hinput]
    _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ := by
      calc
        _ = ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t * ‖ξ‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t ξ *
            (_root_.Auto.LittlewoodPaley.fatDyadicBandpassMultiplier C j ξ *
              _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ) := by ring
        _ = _ := by rw [hband]

theorem fourierInv_add_of_integrable
    (g h : Euclidean 2 → Complex) (hg : Integrable g) (hh : Integrable h)
    (x : Euclidean 2) :
    𝓕⁻ (g + h) x = 𝓕⁻ g x + 𝓕⁻ h x := by
  have hgchar : Integrable
      (fun ξ : Euclidean 2 => Real.fourierChar (inner Real ξ x) • g ξ) := by
    refine Integrable.mono' hg.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun ξ : Euclidean 2 =>
        Real.fourierChar (inner Real ξ x))).aestronglyMeasurable).smul
          hg.aestronglyMeasurable
    · filter_upwards with ξ
      simp
  have hhchar : Integrable
      (fun ξ : Euclidean 2 => Real.fourierChar (inner Real ξ x) • h ξ) := by
    refine Integrable.mono' hh.norm ?_ ?_
    · exact ((by fun_prop : Continuous (fun ξ : Euclidean 2 =>
        Real.fourierChar (inner Real ξ x))).aestronglyMeasurable).smul
          hh.aestronglyMeasurable
    · filter_upwards with ξ
      simp
  rw [Real.fourierInv_eq, Real.fourierInv_eq, Real.fourierInv_eq]
  change (∫ v : Euclidean 2,
      Real.fourierChar (inner Real v x) • (g v + h v)) = _
  rw [show (fun v : Euclidean 2 =>
      Real.fourierChar (inner Real v x) • (g v + h v)) =
        (fun v : Euclidean 2 =>
          Real.fourierChar (inner Real v x) • g v +
            Real.fourierChar (inner Real v x) • h v) by
      funext v
      rw [smul_add], MeasureTheory.integral_add hgchar hhchar]

private theorem const_mul_fourierInv
    (a : Complex) (g : Euclidean 2 → Complex) (x : Euclidean 2) :
    a * 𝓕⁻ g x = 𝓕⁻ (fun ξ => a * g ξ) x := by
  rw [Real.fourierInv_eq, Real.fourierInv_eq, ← MeasureTheory.integral_const_mul]
  apply MeasureTheory.integral_congr_ae
  filter_upwards with ξ
  change a * (Real.fourierChar (inner Real ξ x) • g ξ) =
    Real.fourierChar (inner Real ξ x) • (a * g ξ)
  rw [show a * (Real.fourierChar (inner Real ξ x) • g ξ) =
      (Real.fourierChar (inner Real ξ x) : Complex) * (a * g ξ) by
        change a * ((Real.fourierChar (inner Real ξ x) : Complex) * g ξ) = _
        ring]
  rfl

/-- Literal two-term relative-multiplier representation of the endpoint
time derivative.  The first family is the uniformly controlled derivative
annular factor, and the second uses the original uniformly controlled family
after `2^j` times a half-wave applied to a compact radial input multiplier. -/
noncomputable def circleEndpointWaveContributionTimeDerivativeFactored
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => (circleEndpointDyadicNormalization j)⁻¹ *
    (_root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
        (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
        (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
        (circleAnnularEndpointHalfWaveOutput C σ j t.1 f) x +
      (((2 : Real) ^ j : Real) : Complex) *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
          (circleAnnularEndpointHalfWaveOutput C σ j t.1
            (circleEndpointTimeDerivativeInput C σ j f)) x)

theorem circleEndpointWaveContributionTimeDerivativeFactored_eq_literal
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) :
    circleEndpointWaveContributionTimeDerivativeFactored C σ j t f =
      circleEndpointWaveContributionTimeDerivative C σ j t.1 f := by
  funext x
  let n : Complex := (circleEndpointDyadicNormalization j)⁻¹
  let d : Complex := (((2 : Real) ^ j : Real) : Complex)
  let U : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ j t.1 f
  let V : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ j t.1
      (circleEndpointTimeDerivativeInput C σ j f)
  let q₁ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1 :
        Euclidean 2 → Complex)
      (𝓕 U)
  let q₂ : SchwartzMap (Euclidean 2) Complex :=
    SchwartzMap.smulLeftCLM Complex
      (circleAnnularEndpointSchwartzSymbol C σ j t.1 : Euclidean 2 → Complex)
      (𝓕 V)
  have hq₁apply (ξ : Euclidean 2) : q₁ ξ =
      circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1 ξ *
        𝓕 (U : Euclidean 2 → Complex) ξ := by
    dsimp [q₁]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe]
  have hq₂apply (ξ : Euclidean 2) : q₂ ξ =
      circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
        𝓕 (V : Euclidean 2 → Complex) ξ := by
    dsimp [q₂]
    rw [SchwartzMap.smulLeftCLM_apply_apply
      (circleAnnularEndpointSchwartzSymbol C σ j t.1).hasTemperateGrowth]
    simp only [smul_eq_mul, SchwartzMap.fourier_coe]
  have hq₁inv :
      𝓕⁻ (fun ξ : Euclidean 2 =>
        circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1 ξ *
          𝓕 (U : Euclidean 2 → Complex) ξ) x =
        𝓕⁻ (q₁ : Euclidean 2 → Complex) x := by
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext ξ
    exact (hq₁apply ξ).symm
  have hq₂inv :
      𝓕⁻ (fun ξ : Euclidean 2 =>
        circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
          𝓕 (V : Euclidean 2 → Complex) ξ) x =
        𝓕⁻ (q₂ : Euclidean 2 → Complex) x := by
    apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
    funext ξ
    exact (hq₂apply ξ).symm
  have hfactored :
      circleEndpointWaveContributionTimeDerivativeFactored C σ j t f x =
        n * (𝓕⁻ (q₁ : Euclidean 2 → Complex) x +
          d * 𝓕⁻ (q₂ : Euclidean 2 → Complex) x) := by
    unfold circleEndpointWaveContributionTimeDerivativeFactored
    rw [aux_circleAnnularEndpointTimeDerivativeRelativeMultiplierAt_dyadicScale C σ j t U x,
      aux_circleAnnularEndpointRelativeMultiplierAt_dyadicScale C σ j t V x,
      hq₁inv, hq₂inv]
  have hsum := fourierInv_add_of_integrable
    (fun ξ : Euclidean 2 => n * q₁ ξ)
    (fun ξ : Euclidean 2 => n * d * q₂ ξ)
    (q₁.integrable.const_mul n)
    (q₂.integrable.const_mul (n * d)) x
  have hpoint (ξ : Euclidean 2) :
      n * q₁ ξ + n * d * q₂ ξ =
        circleEndpointBandpassMultiplierTimeDerivative C σ j t.1 ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ := by
    rw [hq₁apply, hq₂apply,
      circleAnnularEndpointHalfWaveOutput_fourier,
      circleAnnularEndpointHalfWaveOutput_fourier,
      circleEndpointTimeDerivativeInput_fourier]
    dsimp [U, V, n, d]
    have hfirst :=
      circleAnnularEndpointTimeDerivativeSchwartzSymbol_factorization C σ j t.1 ξ
    have hsecond :=
      circleAnnularEndpointSchwartzSymbol_factorization_timeDerivativeInput C σ j t.1 ξ
    calc
      (circleEndpointDyadicNormalization j)⁻¹ *
          (circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1 ξ *
            (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t.1 ξ *
              𝓕 (f : Euclidean 2 → Complex) ξ)) +
          (circleEndpointDyadicNormalization j)⁻¹ * (((2 : Real) ^ j : Real) : Complex) *
            (circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
              (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t.1 ξ *
                (circleEndpointTimeDerivativeInputMultiplier C σ j ξ *
                  𝓕 (f : Euclidean 2 → Complex) ξ))) =
        (((circleEndpointDyadicNormalization j)⁻¹ *
            circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t.1 ξ *
            _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t.1 ξ) +
          ((circleEndpointDyadicNormalization j)⁻¹ *
            circleAnnularEndpointSchwartzSymbol C σ j t.1 ξ *
            ((((2 : Real) ^ j : Real) : Complex) *
              (_root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t.1 ξ *
                circleEndpointTimeDerivativeInputMultiplier C σ j ξ)))) *
          𝓕 (f : Euclidean 2 → Complex) ξ := by ring
      _ = (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitudeTimeDerivative σ t.1 ξ *
            _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t.1 ξ *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ +
          ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
            circleEndpointAmplitude σ (2 * Real.pi * (t.1 * ‖ξ‖)) *
            _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ t.1 ξ *
            _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j ξ) *
          𝓕 (f : Euclidean 2 → Complex) ξ := by rw [hfirst, hsecond]
      _ = circleEndpointBandpassMultiplierTimeDerivative C σ j t.1 ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ := by
        unfold circleEndpointBandpassMultiplierTimeDerivative
        ring
  calc
    circleEndpointWaveContributionTimeDerivativeFactored C σ j t f x =
        n * (𝓕⁻ (q₁ : Euclidean 2 → Complex) x +
          d * 𝓕⁻ (q₂ : Euclidean 2 → Complex) x) := hfactored
    _ = n * 𝓕⁻ (q₁ : Euclidean 2 → Complex) x +
        (n * d) * 𝓕⁻ (q₂ : Euclidean 2 → Complex) x := by ring
    _ = 𝓕⁻ (fun ξ : Euclidean 2 => n * q₁ ξ) x +
        𝓕⁻ (fun ξ : Euclidean 2 => n * d * q₂ ξ) x := by
      rw [← const_mul_fourierInv n (q₁ : Euclidean 2 → Complex) x,
        ← const_mul_fourierInv (n * d) (q₂ : Euclidean 2 → Complex) x]
    _ = 𝓕⁻ ((fun ξ : Euclidean 2 => n * q₁ ξ) +
        (fun ξ : Euclidean 2 => n * d * q₂ ξ)) x := hsum.symm
    _ = 𝓕⁻ (fun ξ : Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ j t.1 ξ *
          𝓕 (f : Euclidean 2 → Complex) ξ) x := by
      apply congrArg (fun g : Euclidean 2 → Complex => 𝓕⁻ g x)
      funext ξ
      exact hpoint ξ
    _ = circleEndpointWaveContributionTimeDerivative C σ j t.1 f x := rfl

theorem continuous_uncurry_circleEndpointBandpassMultiplier
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    Continuous (Function.uncurry (fun t xi =>
      ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (t * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ t xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      circleEndpointAmplitude σ (2 * Real.pi * (q.1 * ‖q.2‖)) *
      _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1 q.2 *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2)
  have harg : Continuous (fun q : Real × Euclidean 2 =>
      2 * Real.pi * (q.1 * ‖q.2‖)) := by
    fun_prop
  have hamp : Continuous (fun q : Real × Euclidean 2 =>
      circleEndpointAmplitude σ (2 * Real.pi * (q.1 * ‖q.2‖))) :=
    (contDiff_circleEndpointAmplitude σ).continuous.comp harg
  have hhalf : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1 q.2) := by
    unfold _root_.Auto.Spherical.MSS.halfWaveMultiplier
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
  have hcut : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2) :=
    (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).continuous.comp
      continuous_snd
  exact ((((continuous_const.mul continuous_const).mul hamp).mul hhalf).mul hcut)

theorem continuous_uncurry_circleEndpointBandpassMultiplierTimeDerivative
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) :
    Continuous (Function.uncurry
      (fun t xi => circleEndpointBandpassMultiplierTimeDerivative C σ j t xi)) := by
  change Continuous (fun q : Real × Euclidean 2 =>
    ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
      (circleEndpointAmplitudeTimeDerivative σ q.1 q.2 *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1 q.2 +
        circleEndpointAmplitude σ (2 * Real.pi * (q.1 * ‖q.2‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ q.1 q.2) *
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2)
  have harg : Continuous (fun q : Real × Euclidean 2 =>
      2 * Real.pi * (q.1 * ‖q.2‖)) := by
    fun_prop
  have hscale : Continuous (fun q : Real × Euclidean 2 =>
      ((2 * Real.pi * ‖q.2‖ : Real) : Complex)) := by
    exact Complex.continuous_ofReal.comp (by fun_prop)
  have hderiv : Continuous (deriv (circleEndpointAmplitude σ)) :=
    (contDiff_circleEndpointAmplitude σ).continuous_deriv (by norm_num)
  have hampTime : Continuous (fun q : Real × Euclidean 2 =>
      circleEndpointAmplitudeTimeDerivative σ q.1 q.2) := by
    unfold circleEndpointAmplitudeTimeDerivative
    exact hscale.mul (hderiv.comp harg)
  have hamp : Continuous (fun q : Real × Euclidean 2 =>
      circleEndpointAmplitude σ (2 * Real.pi * (q.1 * ‖q.2‖))) :=
    (contDiff_circleEndpointAmplitude σ).continuous.comp harg
  have hhalf : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1 q.2) := by
    unfold _root_.Auto.Spherical.MSS.halfWaveMultiplier
    apply Complex.continuous_exp.comp
    exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
  have hhalfTime : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative σ q.1 q.2) := by
    unfold _root_.Auto.Spherical.MSS.halfWaveMultiplierTimeDerivative
    have hcoef : Continuous (fun q : Real × Euclidean 2 =>
        (((σ.toReal * (2 * Real.pi) * ‖q.2‖ : Real) : Complex) * Complex.I)) := by
      exact (Complex.continuous_ofReal.comp (by fun_prop)).mul continuous_const
    exact hcoef.mul hhalf
  have hcut : Continuous (fun q : Real × Euclidean 2 =>
      _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2) :=
    (_root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j).continuous.comp
      continuous_snd
  exact ((((continuous_const.mul continuous_const).mul
    (hampTime.mul hhalf |>.add (hamp.mul hhalfTime))).mul hcut))

/-- Scratch validation: the physical endpoint wave has the exact Fourier-inverse
time derivative and both functions are jointly continuous. -/
theorem continuous_and_hasDerivAt_circleEndpointWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Continuous (Function.uncurry (fun t x => circleEndpointWaveContribution C σ j t f x)) ∧
      Continuous (Function.uncurry
        (fun t x => circleEndpointWaveContributionTimeDerivative C σ j t f x)) ∧
      ∀ t x, HasDerivAt
        (fun s => circleEndpointWaveContribution C σ j s f x)
        (circleEndpointWaveContributionTimeDerivative C σ j t f x) t := by
  let F : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContribution C σ j t f x
  let D : Real → Euclidean 2 → Complex := fun t x =>
    circleEndpointWaveContributionTimeDerivative C σ j t f x
  change Continuous (Function.uncurry F) ∧ Continuous (Function.uncurry D) ∧
    ∀ t x, HasDerivAt (fun s => F s x) (D t x) t
  let K : Set (Euclidean 2) := Metric.closedBall 0 ((2 : Real) ^ (j + 2))
  have hK : IsCompact K := isCompact_closedBall _ _
  have hKmeas : MeasurableSet K := hK.measurableSet
  let G : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
        circleEndpointAmplitude σ (2 * Real.pi * (q.1 * ‖xi‖)) *
        _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1 xi *
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  let G' : (Real × Euclidean 2) → Euclidean 2 → Complex := fun q xi =>
    (Real.fourierChar (inner Real xi q.2) : Complex) *
      (circleEndpointBandpassMultiplierTimeDerivative C σ j q.1 xi *
        𝓕 (f : Euclidean 2 → Complex) xi)
  have hGcont : Continuous (Function.uncurry G) := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (q.1.1 * ‖q.2‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1.1 q.2 *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (continuous_uncurry_circleEndpointBandpassMultiplier C σ j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        ((surfaceMass 2)⁻¹ : Complex) * (surfaceMass 1 : Complex) *
          circleEndpointAmplitude σ (2 * Real.pi * (q.1.1 * ‖q.2‖)) *
          _root_.Auto.Spherical.MSS.halfWaveMultiplier σ q.1.1 q.2 *
          _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hG'cont : Continuous (Function.uncurry G') := by
    change Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
      (Real.fourierChar (inner Real q.2 q.1.2) : Complex) *
        (circleEndpointBandpassMultiplierTimeDerivative C σ j q.1.1 q.2 *
          𝓕 (f : Euclidean 2 → Complex) q.2))
    have hchar : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (Real.fourierChar (inner Real q.2 q.1.2) : Complex)) := by
      fun_prop
    have hpair : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        (q.1.1, q.2)) := by
      fun_prop
    have hmult' :=
      (continuous_uncurry_circleEndpointBandpassMultiplierTimeDerivative C σ j).comp hpair
    have hmult : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        circleEndpointBandpassMultiplierTimeDerivative C σ j q.1.1 q.2) := by
      exact hmult'.congr fun q => rfl
    have hfourier : Continuous (fun q : (Real × Euclidean 2) × Euclidean 2 =>
        𝓕 (f : Euclidean 2 → Complex) q.2) :=
      (𝓕 f).continuous.comp continuous_snd
    exact hchar.mul (hmult.mul hfourier)
  have hGsupport (q : Real × Euclidean 2) : Function.support (G q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G q xi ≠ 0 at hxi
    exact hxi (by simp [G, hband])
  have hG'support (q : Real × Euclidean 2) : Function.support (G' q) ⊆ K := by
    intro xi hxi
    by_contra hxiK
    have hnorm : (2 : Real) ^ (j + 2) ≤ ‖xi‖ := by
      rw [Metric.mem_closedBall, dist_zero_right] at hxiK
      exact le_of_not_ge hxiK
    have hband :
        _root_.Auto.LittlewoodPaley.dyadicBandpassMultiplier C.cutoff j xi = 0 :=
      _root_.Auto.LittlewoodPaley.dyadicBandpass_eq_zero_of_le_norm C hnorm
    change G' q xi ≠ 0 at hxi
    exact hxi (by simp [G', circleEndpointBandpassMultiplierTimeDerivative, hband])
  have hGintegral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G q xi) = ∫ xi in K, G q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hGsupport q)]
  have hG'integral (q : Real × Euclidean 2) :
      (∫ xi : Euclidean 2, G' q xi) = ∫ xi in K, G' q xi := by
    rw [← MeasureTheory.integral_indicator hKmeas]
    rw [Set.indicator_eq_self.mpr (hG'support q)]
  have hF_eq (q : Real × Euclidean 2) :
      F q.1 q.2 = ∫ xi in K, G q xi := by
    have hraw : F q.1 q.2 = ∫ xi : Euclidean 2, G q xi := by
      dsimp only [F, G]
      rw [circleEndpointWaveContribution_factorization C σ j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hGintegral q
  have hD_eq (q : Real × Euclidean 2) :
      D q.1 q.2 = ∫ xi in K, G' q xi := by
    have hraw : D q.1 q.2 = ∫ xi : Euclidean 2, G' q xi := by
      dsimp only [D, G']
      rw [circleEndpointWaveContributionTimeDerivative_eq_fourierInv_multiplier C σ j q.1 f q.2]
      rw [Real.fourierInv_eq]
      rfl
    rw [hraw]
    exact hG'integral q
  have hFcont : Continuous (Function.uncurry F) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hGcont hK
    rw [show Function.uncurry F = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G q xi by
        funext q
        exact hF_eq q]
    exact hcont
  have hDcont : Continuous (Function.uncurry D) := by
    have hcont := continuous_parametric_integral_of_continuous
      (μ := volume) hG'cont hK
    rw [show Function.uncurry D = fun q : Real × Euclidean 2 =>
      ∫ xi in K, G' q xi by
        funext q
        exact hD_eq q]
    exact hcont
  refine ⟨hFcont, hDcont, ?_⟩
  intro s x
  have hGderiv (t : Real) (xi : Euclidean 2) :
      HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t := by
    have hmult := hasDerivAt_circleEndpointBandpassMultiplier C σ j t xi
    have hproduct := hmult.mul_const (𝓕 (f : Euclidean 2 → Complex) xi)
    have hfull := hproduct.const_mul (Real.fourierChar (inner Real xi x) : Complex)
    simpa only [G, G'] using hfull
  have hFcurve : (fun t : Real => F t x) =
      fun t : Real => ∫ xi in K, G (t, x) xi := by
    funext t
    simpa only using hF_eq (t, x)
  have hDcurve : D s x = ∫ xi in K, G' (s, x) xi := by
    simpa only using hD_eq (s, x)
  have hGslice (t : Real) : Continuous (fun xi : Euclidean 2 => G (t, x) xi) := by
    change Continuous ((Function.uncurry G) ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hGcont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'slice (t : Real) : Continuous (fun xi : Euclidean 2 => G' (t, x) xi) := by
    change Continuous ((Function.uncurry G') ∘ fun xi : Euclidean 2 => ((t, x), xi))
    exact hG'cont.comp
      ((continuous_const : Continuous fun _ : Euclidean 2 => (t, x)).prodMk continuous_id)
  have hG'curve : Continuous (fun q : Real × Euclidean 2 => G' (q.1, x) q.2) := by
    change Continuous ((Function.uncurry G') ∘
      fun q : Real × Euclidean 2 => ((q.1, x), q.2))
    exact hG'cont.comp (by fun_prop)
  have hFmeas : ∀ᶠ t in nhds s,
      AEStronglyMeasurable (fun xi : Euclidean 2 => G (t, x) xi) (volume.restrict K) := by
    filter_upwards [] with t
    exact (hGslice t).aestronglyMeasurable.restrict
  have hFint : Integrable (fun xi : Euclidean 2 => G (s, x) xi) (volume.restrict K) := by
    have hcompact : HasCompactSupport (fun xi : Euclidean 2 => G (s, x) xi) := by
      apply HasCompactSupport.of_support_subset_isCompact hK
      exact hGsupport (s, x)
    exact ((hGslice s).integrable_of_hasCompactSupport hcompact).restrict
  have hF'meas : AEStronglyMeasurable (fun xi : Euclidean 2 => G' (s, x) xi)
      (volume.restrict K) :=
    (hG'slice s).aestronglyMeasurable.restrict
  obtain ⟨A, hA⟩ := (isCompact_Icc.prod hK).exists_bound_of_continuousOn
    hG'curve.continuousOn
  have hbound : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1), ‖G' (t, x) xi‖ ≤ A := by
    filter_upwards [ae_restrict_mem hKmeas] with xi hxi
    intro t ht
    exact hA (t, xi) ⟨ht, hxi⟩
  have hAint : Integrable (fun _ : Euclidean 2 => A) (volume.restrict K) := by
    simpa only [IntegrableOn] using
      (integrableOn_const (μ := volume) (s := K) hK.measure_ne_top :
        IntegrableOn (fun _ : Euclidean 2 => A) K volume)
  have hdiff : ∀ᵐ xi : Euclidean 2 ∂(volume.restrict K),
      ∀ t ∈ Icc (s - 1) (s + 1),
        HasDerivAt (fun u : Real => G (u, x) xi) (G' (t, x) xi) t :=
    Filter.Eventually.of_forall fun xi t _ => hGderiv t xi
  have hs : Icc (s - 1) (s + 1) ∈ nhds s :=
    Icc_mem_nhds (sub_lt_self s zero_lt_one) (lt_add_of_pos_right s zero_lt_one)
  have hparam := hasDerivAt_integral_of_dominated_loc_of_deriv_le
    (μ := volume.restrict K) (s := Icc (s - 1) (s + 1)) (x₀ := s)
    (bound := fun _ : Euclidean 2 => A)
    (F := fun t (xi : Euclidean 2) => G (t, x) xi)
    (F' := fun t (xi : Euclidean 2) => G' (t, x) xi)
    hs hFmeas hFint hF'meas hbound hAint hdiff
  rw [hFcurve, hDcurve]
  exact hparam.2

noncomputable def aux_circleAnnularEndpointTimeDerivativeWaveContribution
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Real)
    (f : SchwartzMap (Euclidean 2) Complex) : Euclidean 2 → Complex :=
  fun x => 𝓕⁻ (fun ξ : Euclidean 2 =>
    (circleEndpointDyadicNormalization j)⁻¹ *
      circleAnnularEndpointTimeDerivativeSchwartzSymbol C σ j t ξ *
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSymbol C.cutoff σ j t ξ *
      𝓕 (f : Euclidean 2 → Complex) ξ) x

/-- Each derivative-annular endpoint term is exactly one member of the proved
compact-annular relative multiplier family acting on the literal dyadic
half-wave output. -/
theorem aux_circleAnnularEndpointTimeDerivWaveContribution_eq_relativeMult_halfWave
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
    (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2) :
    aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x =
      (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)
          (circleAnnularEndpointHalfWaveOutput C σ j t.1 f) x := by
  rw [aux_circleAnnularEndpointTimeDerivativeRelativeMultiplierAt_dyadicScale]
  rw [aux_const_mul_fourierInv]
  unfold aux_circleAnnularEndpointTimeDerivativeWaveContribution
  apply congrArg (fun h : Euclidean 2 → Complex => 𝓕⁻ h x)
  funext ξ
  rw [circleAnnularEndpointHalfWaveOutput_fourier]
  ring

/-- Uniform annular stability of the literal derivative-annular contribution.  After
the stationary normalization, every local-time/sign/scale endpoint is a
compact relative multiplier applied to the actual dyadic half-wave output;
the proved kernel certificate therefore gives one dyadic
Hardy--Littlewood-maximal majorant for all of them. -/
theorem exists_circleAnnularEndpointTimeDerivativeWaveContribution_dyadicBall_stability
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ K : Real, 0 < K ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex) (x : Euclidean 2),
      ‖aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x‖ ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ *
          (K * _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
            (circleAnnularEndpointHalfWaveOutput C σ j t.1 f : Euclidean 2 → Complex) x) := by
  rcases hasCircleAnnularEndpointTimeDerivativeUniformKernelBound C with ⟨A, hA, hkernel⟩
  obtain ⟨K, hK, hterm⟩ :=
    _root_.Auto.MikhlinHormander.uniform_relativeSchwartzMultiplierAt_majorant_of_kernel_bound
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C) hA hkernel
  refine ⟨K, hK, ?_⟩
  intro σ j t f x
  rw [aux_circleAnnularEndpointTimeDerivWaveContribution_eq_relativeMult_halfWave]
  rw [norm_mul]
  exact mul_le_mul_of_nonneg_left
    (hterm ⟨σ, ⟨j, t⟩⟩ (circleAnnularEndpointHalfWaveOutput C σ j t.1 f)
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) x)
    (norm_nonneg _)

/-- Fixed-time `L⁴` stability of the literal derivative-annular endpoint contribution.
This is the spatial consequence of the uniform compact-annular multiplier
certificate: the local-time endpoint is controlled by the corresponding
literal dyadic half-wave output, uniformly in sign and dyadic scale. -/
theorem exists_integral_norm_pow_four_circleAnnularEndpointTimeDerivativeWaveContribution_le
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2) :
    ∃ B : Real, 0 < B ∧ ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
      (j : Nat) (t : Icc (1 : Real) 2)
      (f : SchwartzMap (Euclidean 2) Complex),
      (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x‖ ^
          4) ≤
        ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * B *
          ∫ x : Euclidean 2, ‖circleAnnularEndpointHalfWaveOutput C σ j t.1 f x‖ ^ 4 := by
  rcases exists_circleAnnularEndpointTimeDerivativeWaveContribution_dyadicBall_stability C with
    ⟨K, hK, hstability⟩
  obtain ⟨H, hH, hhardy⟩ :=
    _root_.Auto.HardyLittlewoodMaximal.dyadic_hardy_littlewood_maximal_strong_type_schwartz
      (d := 2) (by norm_num) (p := 4) (by norm_num)
  refine ⟨K ^ 4 * H, mul_pos (Real.rpow_pos_of_pos hK _) hH, ?_⟩
  intro σ j t f
  let u : SchwartzMap (Euclidean 2) Complex :=
    circleAnnularEndpointHalfWaveOutput C σ j t.1 f
  let E : Euclidean 2 → Complex := aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1
      f
  let M : Euclidean 2 → Real :=
    _root_.Auto.HardyLittlewoodMaximal.dyadicBallMaximal 2
      (u : Euclidean 2 → Complex)
  have hM := hhardy u
  have hMnonneg (x : Euclidean 2) : 0 ≤ M x := ENNReal.toReal_nonneg
  have hMpowInt : Integrable (fun x : Euclidean 2 => M x ^ 4) := by
    have h := hM.1.integrable_norm_rpow (by norm_num : (ENNReal.ofReal (4 : Real)) ≠ 0)
      ENNReal.ofReal_ne_top
    convert h using 1
    funext x
    rw [Real.norm_eq_abs, abs_of_nonneg (hMnonneg x),
      ENNReal.toReal_ofReal (by norm_num : (0 : Real) ≤ 4)]
    norm_num
  have hEcont : Continuous E := by
    rw [show E = fun x => (circleEndpointDyadicNormalization j)⁻¹ *
        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) u x by
      funext x
      exact aux_circleAnnularEndpointTimeDerivWaveContribution_eq_relativeMult_halfWave C
          σ j t f x]
    exact (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C ⟨σ, ⟨j, t⟩⟩) u
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)).const_mul _
  have hpoint (x : Euclidean 2) : ‖E x‖ ^ 4 ≤
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
    have h := hstability σ j t f x
    change ‖E x‖ ≤ _ at h
    calc
      ‖E x‖ ^ 4 ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ * (K * M x)) ^ 4 :=
        pow_le_pow_left₀ (norm_nonneg _) h 4
      _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 := by
        ring
  have hdomInt : Integrable (fun x : Euclidean 2 =>
      (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4) :=
    hMpowInt.const_mul _
  have hEpowInt : Integrable (fun x : Euclidean 2 => ‖E x‖ ^ 4) := by
    refine Integrable.mono' hdomInt (hEcont.norm.pow 4).aestronglyMeasurable ?_
    filter_upwards with x
    change ‖‖E x‖ ^ (4 : Nat)‖ ≤ _
    rw [Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)]
    exact hpoint x
  calc
    (∫ x : Euclidean 2, ‖aux_circleAnnularEndpointTimeDerivativeWaveContribution C σ j t.1 f x‖ ^ 4)
        =
        ∫ x : Euclidean 2, ‖E x‖ ^ 4 := rfl
    _ ≤ ∫ x : Euclidean 2, (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) * M x ^ 4 :=
      integral_mono hEpowInt hdomInt hpoint
    _ = (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        ∫ x : Euclidean 2, M x ^ 4 := by rw [integral_const_mul]
    _ ≤ (‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * K ^ 4) *
        (H * ∫ x : Euclidean 2, ‖u x‖ ^ 4) := by
      apply mul_le_mul_of_nonneg_left
        (show (∫ x : Euclidean 2, M x ^ 4) ≤ H * ∫ x : Euclidean 2, ‖u x‖ ^ 4 by
          convert hM.2 using 1
          · apply integral_congr_ae
            filter_upwards with x
            change M x ^ (4 : Nat) = M x ^ (4 : Real)
            exact (Real.rpow_natCast (M x) 4).symm
          · congr 1
            apply integral_congr_ae
            filter_upwards with x
            exact (Real.rpow_natCast ‖u x‖ 4).symm)
        (by positivity)
    _ = ‖(circleEndpointDyadicNormalization j)⁻¹‖ ^ 4 * (K ^ 4 * H) *
        ∫ x : Euclidean 2, ‖u x‖ ^ 4 := by ring
    _ = _ := by simp [u]





private theorem aux_memLp_four_dyadicHalfWaveSpaceTime_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j : Nat) (hj : 1 ≤ j)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    MemLp (_root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff σ j f)
      (ENNReal.ofReal (4 : Real))
      _root_.Auto.Spherical.MSS.localSmoothingMeasure := by
  rcases hgain with ⟨hp, hρ, A, hA, hbound⟩
  have hmain := hbound j hj f σ
  have hfmem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
    f.memLp (ENNReal.ofReal (4 : Real)) volume
  have hright :
      ENNReal.ofReal (A * (2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - ρ))) *
        eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume < ∞ :=
    ENNReal.mul_lt_top ENNReal.ofReal_lt_top hfmem.eLpNorm_lt_top
  exact hmain.trans_lt hright

private theorem aux_integrable_norm_pow_four_dyadicHalfWaveSpaceTime_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j : Nat) (hj : 1 ≤ j)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun z : Euclidean 2 × Real =>
      ‖_root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff σ j f z‖ ^ 4)
      _root_.Auto.Spherical.MSS.localSmoothingMeasure := by
  have hmem := aux_memLp_four_dyadicHalfWaveSpaceTime_of_gain C hgain j hj σ f
  have h := hmem.integrable_norm_rpow
    (by norm_num : ENNReal.ofReal (4 : Real) ≠ 0) ENNReal.ofReal_ne_top
  simpa using h

theorem aux_integrable_norm_pow_four_dyadicHalfWave_prod_of_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ)
    (j : Nat) (hj : 1 ≤ j)
    (σ : _root_.Auto.Spherical.MSS.WaveSign)
    (f : SchwartzMap (Euclidean 2) Complex) :
    Integrable (fun p : Real × Euclidean 2 =>
      ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j p.1 f p.2‖ ^ 4)
      ((volume.restrict (Icc (1 : Real) 2)).prod volume) := by
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let U : Euclidean 2 × Real → Complex :=
    _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff σ j f
  let G : Real × Euclidean 2 → Real := fun p =>
    ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j p.1 f p.2‖ ^ 4
  have hUint : Integrable (fun z : Euclidean 2 × Real => ‖U z‖ ^ 4)
      (volume.prod ν) := by
    simpa only [U, ν, _root_.Auto.Spherical.MSS.localSmoothingMeasure] using
      aux_integrable_norm_pow_four_dyadicHalfWaveSpaceTime_of_gain C hgain j hj σ f
  have hUmeas : AEStronglyMeasurable (fun z : Euclidean 2 × Real => ‖U z‖ ^ 4)
      (volume.prod ν) := hUint.aestronglyMeasurable
  have hUfac := (integrable_prod_iff' hUmeas).1 hUint
  have hGmeas : AEStronglyMeasurable G (ν.prod volume) := by
    have hcont : Continuous G := by
      exact ((_root_.Auto.Spherical.MSS.continuous_dyadicHalfWaveSpaceTime C σ j f).comp
        (continuous_snd.prodMk continuous_fst)).norm.pow 4
    exact hcont.aestronglyMeasurable
  change Integrable G (ν.prod volume)
  refine (integrable_prod_iff hGmeas).2 ?_
  constructor
  · filter_upwards [hUfac.1] with t ht
    simpa only [G, U, _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime] using ht
  · simpa only [G, U, _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime,
      Real.norm_eq_abs, abs_of_nonneg (pow_nonneg (norm_nonneg _) _)] using hUfac.2

/-- The continuous fourth moment of the raw planar dyadic half-wave is
controlled by any positive MSS local-smoothing gain.  This is the
Fourier-normalized half-wave itself (rather than an endpoint contribution to
a circular average), so it is available as a reusable local-smoothing input.

The estimate is continuous in time on `[1,2]`; sampling it at a
`2^{-j}`-separated set requires an additional time-regularity argument and
is therefore deliberately not folded into this statement. -/
theorem exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real}
    (hgain : _root_.Auto.Spherical.MSS.HasPositiveLocalSmoothingGain C.cutoff 4 ρ) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4) ≤
          A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  rcases hgain with ⟨hp, hρ, A, hA, hbound⟩
  refine ⟨A, hA, ?_⟩
  intro j hj σ f
  let μ : Measure (Euclidean 2 × Real) :=
    _root_.Auto.Spherical.MSS.localSmoothingMeasure
  let U : Euclidean 2 × Real → Complex :=
    _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime C.cutoff σ j f
  let Iu : Real := ∫ z : Euclidean 2 × Real, ‖U z‖ ^ 4 ∂μ
  let If : Real := ∫ x : Euclidean 2, ‖f x‖ ^ 4
  have hUmem : MemLp U (ENNReal.ofReal (4 : Real)) μ := by
    simpa only [U, μ] using
      aux_memLp_four_dyadicHalfWaveSpaceTime_of_gain C
        ⟨hp, hρ, A, hA, hbound⟩ j hj σ f
  have hfmem : MemLp (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume :=
    f.memLp (ENNReal.ofReal (4 : Real)) volume
  have hnormU : eLpNorm U (ENNReal.ofReal (4 : Real)) μ =
      ENNReal.ofReal (Iu ^ ((4 : Real)⁻¹)) := by
    rw [hUmem.eLpNorm_eq_integral_rpow_norm (by norm_num) ENNReal.ofReal_ne_top]
    norm_num [Iu]
  have hnormf : eLpNorm (f : Euclidean 2 → Complex) (ENNReal.ofReal (4 : Real)) volume =
      ENNReal.ofReal (If ^ ((4 : Real)⁻¹)) := by
    rw [hfmem.eLpNorm_eq_integral_rpow_norm (by norm_num) ENNReal.ofReal_ne_top]
    norm_num [If]
  have hraw := hbound j hj f σ
  rw [hnormU, hnormf] at hraw
  let a : Real := A * (2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - ρ))
  have ha : 0 ≤ a := by
    dsimp [a]
    positivity
  have hrootnonneg : 0 ≤ a * If ^ ((4 : Real)⁻¹) :=
    mul_nonneg ha (Real.rpow_nonneg (integral_nonneg fun x => pow_nonneg (norm_nonneg _) _) _)
  have hroot : Iu ^ ((4 : Real)⁻¹) ≤ a * If ^ ((4 : Real)⁻¹) := by
    rw [← ENNReal.ofReal_mul ha] at hraw
    exact (ENNReal.ofReal_le_ofReal_iff hrootnonneg).mp hraw
  have hIunonneg : 0 ≤ Iu := integral_nonneg fun z => pow_nonneg (norm_nonneg _) _
  have hIfnonneg : 0 ≤ If := integral_nonneg fun x => pow_nonneg (norm_nonneg _) _
  have hpow := pow_le_pow_left₀ (Real.rpow_nonneg hIunonneg _) hroot 4
  have hIu : (Iu ^ ((4 : Real)⁻¹)) ^ 4 = Iu := by
    simpa using Real.rpow_inv_natCast_pow hIunonneg (by norm_num : (4 : Nat) ≠ 0)
  have hIf : (If ^ ((4 : Real)⁻¹)) ^ 4 = If := by
    simpa using Real.rpow_inv_natCast_pow hIfnonneg (by norm_num : (4 : Nat) ≠ 0)
  have hpower : Iu ≤ a ^ 4 * If := by
    rw [hIu, mul_pow, hIf] at hpow
    exact hpow
  have ha4 : a ^ 4 = A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) := by
    dsimp [a]
    rw [mul_pow]
    congr 1
    calc
      ((2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - ρ))) ^ 4 =
          ((2 : Real) ^ ((j : Real) * (1 / 2 - 1 / 4 - ρ))) ^ (4 : Real) :=
        (Real.rpow_natCast _ 4).symm
      _ = (2 : Real) ^ (((j : Real) * (1 / 2 - 1 / 4 - ρ)) * 4) :=
        (Real.rpow_mul (by norm_num : (0 : Real) ≤ 2) _ _).symm
      _ = (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) := by
        congr 1
        ring
  let ν : Measure Real := volume.restrict (Icc (1 : Real) 2)
  let H : Euclidean 2 × Real → Real := fun z =>
    ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j z.2 f z.1‖ ^ 4
  have hUint : Integrable H (volume.prod ν) := by
    simpa only [H, ν, _root_.Auto.Spherical.MSS.localSmoothingMeasure,
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime] using
      aux_integrable_norm_pow_four_dyadicHalfWaveSpaceTime_of_gain C
        ⟨hp, hρ, A, hA, hbound⟩ j hj σ f
  have hIueq : Iu = ∫ t : Real, ∫ x : Euclidean 2,
      ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4 ∂volume ∂ν := by
    simpa only [Iu, U, μ, ν, H,
      _root_.Auto.Spherical.MSS.localSmoothingMeasure,
      _root_.Auto.Spherical.MSS.dyadicHalfWaveSpaceTime] using
      (integral_prod_symm H hUint)
  have hinterval :
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4) = Iu := by
    rw [intervalIntegral.integral_of_le (by norm_num), ← integral_Icc_eq_integral_Ioc]
    change (∫ t : Real, ∫ x : Euclidean 2,
      ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4 ∂volume ∂ν) = Iu
    exact hIueq.symm
  rw [hinterval]
  calc
    Iu ≤ a ^ 4 * If := hpower
    _ = A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) * If := by rw [ha4]

/-- The unconditional planar fourth-moment local-smoothing estimate for the
MSS dyadic half-wave.  Any gain strictly below `1 / 8` is available from the
proved `p = 4` MSS local-smoothing theorem. -/
theorem exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_mss
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    {ρ : Real} (hρ : 0 < ρ) (hρlt : ρ < (1 / 8 : Real)) :
    ∃ A : Real, 0 < A ∧ ∀ (j : Nat), 1 ≤ j →
      ∀ (σ : _root_.Auto.Spherical.MSS.WaveSign)
        (f : SchwartzMap (Euclidean 2) Complex),
      (∫ t in (1 : Real)..2, ∫ x : Euclidean 2,
        ‖_root_.Auto.Spherical.MSS.dyadicHalfWave C.cutoff σ j t f x‖ ^ 4) ≤
          A ^ 4 * (2 : Real) ^ ((j : Real) * (1 - 4 * ρ)) *
            ∫ x : Euclidean 2, ‖f x‖ ^ 4 := by
  apply exists_intervalIntegral_integral_norm_pow_four_dyadicHalfWave_le_gain C
  exact _root_.Auto.Spherical.MSS.p4LocalSmoothing_to_hasPositiveLocalSmoothingGain
    (_root_.Auto.Spherical.MSS.p4LocalSmoothing_of_lpCutoffs C) hρ hρlt

private noncomputable def aux_circleEndpointTimeDerivativeInputProfileFun
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) : Euclidean 2 → Complex :=
  fun η => ((σ.toReal * (2 * Real.pi) * ‖η‖ : Real) : Complex) * Complex.I *
    _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η

private theorem aux_circleEndpointTimeDerivativeInputProfile_eventuallyEq_zero_at_zero
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) :
    Filter.EventuallyEq (nhds (0 : Euclidean 2))
      (aux_circleEndpointTimeDerivativeInputProfileFun C σ) (fun _ => 0) := by
  let r : Real := (2 : Real) ^ (-2 : Int)
  have hr : 0 < r := by
    dsimp [r]
    positivity
  filter_upwards [Metric.ball_mem_nhds (0 : Euclidean 2) hr] with η hη
  have hnorm : ‖η‖ ≤ r := by
    rw [Metric.mem_ball, dist_zero_right] at hη
    exact hη.le
  have hfat :
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff η = 0 := by
    simpa only [r] using
      _root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype_eq_zero_of_norm_le C hnorm
  simp [aux_circleEndpointTimeDerivativeInputProfileFun, hfat]

private theorem aux_hasCompactSupport_circleEndpointTimeDerivativeInputProfileFun
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) :
    HasCompactSupport (aux_circleEndpointTimeDerivativeInputProfileFun C σ) := by
  unfold aux_circleEndpointTimeDerivativeInputProfileFun
  change HasCompactSupport
    ((fun η : Euclidean 2 => ((σ.toReal * (2 * Real.pi) * ‖η‖ : Real) : Complex) * Complex.I) *
      (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff :
        Euclidean 2 → Complex))
  exact _root_.Auto.MikhlinHormander.hasCompactSupport_fatDyadicBandpassPrototype C |>.mul_left

private theorem aux_contDiff_circleEndpointTimeDerivativeInputProfileFun
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) :
    ContDiff Real (⊤ : ℕ∞) (aux_circleEndpointTimeDerivativeInputProfileFun C σ) := by
  rw [contDiff_iff_contDiffAt]
  intro η
  by_cases hη : η = 0
  · subst η
    exact (contDiffAt_const (c := (0 : Complex))).congr_of_eventuallyEq
      (aux_circleEndpointTimeDerivativeInputProfile_eventuallyEq_zero_at_zero C σ)
  · have hnorm : ContDiffAt Real (⊤ : ℕ∞) (fun ζ : Euclidean 2 => ‖ζ‖) η :=
      contDiffAt_norm Real hη
    have hcoefReal : ContDiffAt Real (⊤ : ℕ∞)
        (fun ζ : Euclidean 2 => σ.toReal * (2 * Real.pi) * ‖ζ‖) η := by
      exact (contDiffAt_const.mul contDiffAt_const).mul hnorm
    have hcoef : ContDiffAt Real (⊤ : ℕ∞)
        (fun ζ : Euclidean 2 =>
          ((σ.toReal * (2 * Real.pi) * ‖ζ‖ : Real) : Complex) * Complex.I) η :=
      (Complex.ofRealCLM.contDiff.contDiffAt.comp η hcoefReal).mul contDiffAt_const
    have hcut : ContDiffAt Real (⊤ : ℕ∞)
        (_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff :
          Euclidean 2 → Complex) η :=
      ((_root_.Auto.MikhlinHormander.fatDyadicBandpassPrototype C.cutoff).smooth
        (⊤ : ℕ∞)).contDiffAt
    exact hcoef.mul hcut

private noncomputable def aux_circleEndpointTimeDerivativeInputProfile
