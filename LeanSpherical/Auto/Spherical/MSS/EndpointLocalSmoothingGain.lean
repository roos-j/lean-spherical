private theorem aux_circleAnnularEndpointTimeDerivativeRelativeMultiplierAt_dyadicScale
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (σ : _root_.Auto.Spherical.MSS.WaveSign) (j : Nat) (t : Icc (1 : Real) 2)
