        _root_.Auto.MikhlinHormander.relativeSchwartzMultiplierAt
          (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩)
          (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩) u x by
        funext x
        exact aux_circleAnnularEndpointWaveContribution_eq_relativeMultiplier_halfWave C σ j t f x]
    exact (_root_.Auto.MikhlinHormander.continuous_relativeSchwartzMultiplierAt
      (aux_circleAnnularEndpointSchwartzFamily C ⟨σ, ⟨j, t⟩⟩) u
      (aux_circleAnnularEndpointFrequencyScale ⟨σ, ⟨j, t⟩⟩)).const_mul _
  · intro x
    simpa only [G, u] using hstable σ j t f x

