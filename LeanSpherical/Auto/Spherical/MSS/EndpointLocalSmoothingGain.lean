private theorem circleAnnularEndpointTimeDerivativeSchwartzFamily_support_subset_annulus
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (u : aux_CircleAnnularEndpointLocalIndex) :
    Function.support
      (aux_circleAnnularEndpointTimeDerivativeSchwartzFamily C u : Euclidean 2 → Complex) ⊆
      Metric.closedBall 0 (16 : Real) ∩ {η : Euclidean 2 | (1 / 4 : Real) ≤ ‖η‖} := by
  intro η hη
