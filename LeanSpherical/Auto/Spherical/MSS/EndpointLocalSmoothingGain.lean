private theorem aux_hasCircleAnnularEndpointTimeDerivativeUniformKernelBound_of_uniform_fourierData
    (C : _root_.Auto.LittlewoodPaley.lpCutoffs 2)
    (A₀ A₁ : Real) (hA₀ : 0 ≤ A₀) (hA₁ : 0 ≤ A₁)
    (hmass : ∀ u : aux_CircleAnnularEndpointLocalIndex,
      ∫ η : Euclidean 2,
